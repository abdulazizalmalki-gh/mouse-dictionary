 "凹多角形": "مضلع مقعر (مضلع يوجد فيه خط مستقيم يقطعه في أربع نقاط أو أكثر)",
 "凹形": "تقعر (الخاصية التي يمتلكها الشكل المقعر) / انبعاج, تقعر (شكل ينحني أو يتقوس إلى الداخل)",
 "凹所": "تقعر (الخاصية التي يمتلكها الشكل المقعر) / انبعاج, تقعر (شكل ينحني أو يتقوس إلى الداخل)",
 "凹溜まり": "أَجْوَف",
 "凹版印刷": "طباعة غائرة, غرافور (عملية طباعة تستخدم لوحاً محفوراً أو منقوشاً؛ يُلطخ اللوح بالحبر ويُمسح لينظف، ثم يصنع الحبر المتبقي في التجاويف الطبعة)",
 "凹状": "تقعر (الخاصية التي يمتلكها الشكل المقعر) / انبعاج, تقعر (شكل ينحني أو يتقوس إلى الداخل)",
 "凹角": "داخل, منعكس ((للزوايا) تشير إلى الداخل)\nمثال: مضلع بزوايا منعكسة",
 "凹面": "تقعر (الخاصية التي يمتلكها الشكل المقعر) / انبعاج, تقعر (شكل ينحني أو يتقوس إلى الداخل) / مُقَعَّر, مُجَوَّف",
 "出": "تسرب, نضوح (خروج سائل من حاوية ما) / عين, نبع (تدفق طبيعي للمياه الجوفية) / تدفق خارجي (عملية التدفق إلى الخارج)\nمثال: حاولوا وقف تسرب الغاز من الأنبوب التالف / خادِم, مُعْتَنٍ (يُقَدِّم مُساعَدَة عَمَلِيَّة ورِعايَة) / حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / انتباه, تركيز (العملية التي يركز بها الشخص على بعض سمات البيئة مع استبعاد (نسبي) لسمات أخرى) / نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل / بَارِز, نَاشِئ (يظهر إلى الوجود؛ في طَوْر التكوُّن) / صَاعِد, نَاشِئ (يَبْلُغُ مَرْحَلَةَ النُّضْج)",
 "出あう": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري.",
 "出かける": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "出かした": "أَحْسَنْتَ, أَحْسَنْتِ",
 "出かす": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "出がらし": "تَافِه, سَخِيف (يفتقر إلى الأهمية أو التأثير) / تَافِه, عَدِيمُ الطَّعْم (يَفْتَقِرُ إِلَى الطَّعْمِ أَوِ النَّكْهَة)",
 "出くわす": "صَادَفَ (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ)\nمثال: صادف مشكلا صعبا.",
 "出し": "ذَرِيعَة, عُذْر",
 "出してくれる": "أَخْرَجَ",
 "出しぬけ": "فَجْأَةً",
 "出しゃばる": "تَطَفَّلَ, تَدَخَّلَ",
 "出し分け": "فَرَّقَ",
 "出し店": "كُشْك (هو الكِشْك في بعض اللهجات العربية؛ شبه رِوَاق بارز عن مساواة بقية البيت) / حُجَيْرَة, كَابِينَة",
 "出し惜しむ": "بُغْض, ضَغِينَة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "出し抜け": "فَجْأَةً",
 "出し殻": "باحة, ساحة (الأرض المسيجة المحيطة بمنزل أو مبنى آخر) / أساس, بينة (أساس الاعتقاد أو عدم التصديق؛ المعرفة التي يبنى عليها الاعتقاد) / سبب, مبرر (مبرر لوجود أو حدوث شيء ما) / أرض, ساحة (قطعة أرض تم تنظيفها لأغراض خاصة (مثل الترفيه أو الدفن إلخ))\nمثال: كان منزلاً صغيراً بلا فناء تقريباً",
 "出し汁": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَقَة، وهي أخص من المرَق)",
 "出し渋る": "بُغْض, ضَغِينَة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "出し物": "بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / بَرْمَجَ, وَضَعَ بَرْنَامَجًا / بَرْمَجَ\nمثال: نشط البرنامج الآن. / قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "出し見世": "كُشْك (هو الكِشْك في بعض اللهجات العربية؛ شبه رِوَاق بارز عن مساواة بقية البيت) / حُجَيْرَة, كَابِينَة",
 "出し遅れ": "مُتَأَخِّر, مُتَلَكِّئ (بعد الوقت المتوقّع أو المعتاد؛ مُؤَجَّل)",
 "出す": "أَخْرَجَ / أَنْتَجَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت) / نَشَرَ, أَصْدَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل. / أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "出ず": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / بَلَغَ / ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً؛ ويُعَدَّى فَيُقَالُ: حَضَرَه وحَضِرَه؛ حَضَرَ، كنَصَرَ وعلِمَ، حُضُورًا وحضارَةً: ضِدُّ غابَ)\nمثال: حضر كل شيئ لرحلتي.",
 "出だし": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "出っこみ引っこみ": "شذوذ, مخالفة (سلوك يخرق القاعدة أو الإتيكيت أو العرف أو الأخلاق) / اضْطِرَاب, شُذُوذ (عدم الاتصاف بمبدأ ثابت أو معدل ثابت؛ الحدوث على فترات غير منتظمة) / عدم انتظام, عدم انتظام هندسي (لا تناظر غير منتظم في الشكل؛ نمط مكاني غير منتظم) / إمساك (إخلاء الأمعاء بشكل غير منتظم وغير متكرر أو صعب؛ يمكن أن يكون عرضاً لانسداد معوي أو التهاب رتجي)",
 "出っぱり": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "出っぱる": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم.",
 "出っ張り": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "出っ張る": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم.",
 "出っ歯": "بروز الفك العلوي, تراكب العضة ((طب الأسنان) سوء إطباق تمتد فيه الأسنان العلوية بشكل غير طبيعي فوق الأسنان السفلية)",
 "出っ端": "استهلال, انطلاق (الوقت الذي يفترض أن يبدأ فيه شيء ما)\nمثال: بدأوا بداية مبكرة",
 "出っ鼻": "استهلال, انطلاق (الوقت الذي يفترض أن يبدأ فيه شيء ما)\nمثال: بدأوا بداية مبكرة",
 "出づ": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / بَلَغَ / ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً؛ ويُعَدَّى فَيُقَالُ: حَضَرَه وحَضِرَه؛ حَضَرَ، كنَصَرَ وعلِمَ، حُضُورًا وحضارَةً: ضِدُّ غابَ)\nمثال: حضر كل شيئ لرحلتي.",
 "出ていく": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "出ていけ": "اِبْتَعَدَ",
 "出てくる": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان) / غَادَرَ (تَرَكَ)\nمثال: خرج سامي ليحتفل.",
 "出てけ": "اِبْتَعَدَ",
 "出てゆく": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "出て来る": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان) / غَادَرَ (تَرَكَ)\nمثال: خرج سامي ليحتفل.",
 "出て行く": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "出て行け": "اِبْتَعَدَ",
 "出でる": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "出で湯": "يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "出で立ち": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / ثَوْب, لِبَاس (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء) / كَسْوَة, مَلْبَس\nمثال: لبس سروالا نظيفا.",
 "出で立つ": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "出どころ": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟ / خُرُوج / مَخْرَج / خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "出なおす": "عَفْواً! / مَاذَا قُلْتَ؟ (أداة استفهام) / مَاذَا قُلْتِ؟ (أداة استفهام) / هَلَّا أَعَدْتَ مَا قُلْتَ؟ / هَلَّا أَعَدْتِ مَا قُلْتِ؟\nمثال: ماذا تريد الآن؟",
 "出る": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / بَلَغَ / ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً؛ ويُعَدَّى فَيُقَالُ: حَضَرَه وحَضِرَه؛ حَضَرَ، كنَصَرَ وعلِمَ، حُضُورًا وحضارَةً: ضِدُّ غابَ)\nمثال: حضر كل شيئ لرحلتي.",
 "出不精": "بَيْتُوتِيّ (شخص نادراً ما يذهب إلى أي مكان؛ شخص لا يميل للتجول أو السفر)",
 "出世": "تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة\nمثال: もちろん私は自らの努力で出世するべきだという考えに賛成です。 — علنا، أنا مؤمن بأن عليك الارتقاء في حياتك بجهدك الشخصي.",
 "出世コース": "مسار سريع (وسيلة سريعة لتحقيق هدف)\nمثال: رأوا الاستقلال كمسار سريع للديمقراطية",
 "出世第一主義": "انتهازية وظيفية, وصولية (ممارسة تقديم مسيرتك المهنية على حساب نزاهتك الشخصية)",
 "出世間的": "غَيْرُ دُنْيَوِيّ, غَيْرُ مُتَحَضِّر (لا يعرف طرق العالم ولا يملك خبرة فيها) / زاهد, غير دنيوي (غير معني بالعالم الدنيوي أو لا يتأثر بالاعتبارات الدنيوية)\nمثال: كان زاهداً ولم يفتقد المكافآت الدنيوية كثيراً",
 "出仕": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "出会": "صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ) / مُلَاقَاة, مُقَابَلَة (لِقَاء)\nمثال: صادف مشكلا صعبا. / اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم. / احتشاد, تجمهر (تجمع الناس معاً) / التقاء, تلاق (التدفق معاً في مجرى واحد) / ملتقى النهرين, نقطة التقاء (مكان تندمج فيه الأشياء أو تتدفق معًا (خاصة الأنهار))\nمثال: تقع بيتسبرغ عند نقطة التقاء نهري أليغيني ومونونغاهيلا",
 "出会い": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم. / احتشاد, تجمهر (تجمع الناس معاً) / التقاء, تلاق (التدفق معاً في مجرى واحد) / ملتقى النهرين, نقطة التقاء (مكان تندمج فيه الأشياء أو تتدفق معًا (خاصة الأنهار))\nمثال: تقع بيتسبرغ عند نقطة التقاء نهري أليغيني ومونونغاهيلا",
 "出会う": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري.",
 "出先": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "出入": "تداعي حر (عملية تفكير تقترح فيها الأفكار (كلمات أو صور) أفكاراً أخرى في تسلسل)",
 "出入り": "مُتَكَرِّر / اِرْتَادَ (لأهله: ذهب أمامهم رائدًا ليجد النجعة والكلاء؛ المكانَ: كان من روّادِه، أي من الذين كانوا فيه منذ البدء) / تَذَبذُب, تَقَلُّب / عَارَكَ, قَاتَلَ / تَعَارَكَ, تَقَاتَلَ / نَاضَلَ, كَافَحَ / قِتَال (من قَتَلَ: كثير القَتْل) / مَعْرَكَة\nمثال: لن يحل القتال أي شيء. / تحزيز, تسنين (عملية القطع في حافة بشقوق تشبه الأسنان أو شقوق زاوية) / مسافة بادئة (المسافة المتروكة بين الهامش وبداية سطر تمت إزاحته) / تخشّن, تنقر (تشكل نقر صغيرة في سطح ما نتيجة للتآكل) / انبعاج, ثلمة (قطع مقعر في سطح أو حافة (كما في الخط الساحلي))",
 "出兵": "بعثة, حملة (رحلة منظمة لغرض معين) / رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة) / بعثة, حملة عسكرية (حملة عسكرية مصممة لتحقيق هدف محدد في بلد أجنبي) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "出典": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "出処": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟ / مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس / مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟ / خُرُوج / مَخْرَج / خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "出処進退": "مسار عمل, نهج (طريقة للعمل أو التصرف)\nمثال: إذا استمررت في هذا المسار فستفشل بالتأكيد",
 "出出し": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "出出虫": "حَلَزُون",
 "出初め": "إطلاق, تدشين (فعل البدء بشيء جديد) / ظهور أول (تقديم فتاة للمجتمع لأول مرة)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "出力": "مُخرَج / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة.",
 "出力デバイス": "جهاز إخراج (معدات إلكترونية أو كهروميكانيكية متصلة بجهاز كمبيوتر وتستخدم لنقل البيانات خارج الكمبيوتر في شكل نص أو صور أو أصوات أو وسائط أخرى)",
 "出力データ": "مُخرَج / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة.",
 "出力ファイル": "ملف الإخراج ((علوم الحاسوب) ملف حاسوبي يحتوي على بيانات تمثل مخرجات جهاز أو برنامج)",
 "出力機構": "جهاز إخراج (معدات إلكترونية أو كهروميكانيكية متصلة بجهاز كمبيوتر وتستخدم لنقل البيانات خارج الكمبيوتر في شكل نص أو صور أو أصوات أو وسائط أخرى)",
 "出力細胞": "عصبون حركي (عصبون ينقل النبضات من الدماغ أو الحبل الشوكي إلى الخارج)",
 "出力装置": "جهاز إخراج (معدات إلكترونية أو كهروميكانيكية متصلة بجهاز كمبيوتر وتستخدم لنقل البيانات خارج الكمبيوتر في شكل نص أو صور أو أصوات أو وسائط أخرى)",
 "出動": "تَعْبِئَة, تَجْنِيد",
 "出動命令": "أوامر التحرك, أوامر المسير (أمر من ضابط أعلى للقوات بالمغادرة) / إشعار بالطرد ((غير رسمي) إشعار بالفصل أو التسريح)",
 "出勤": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "出口": "خُرُوج / مَخْرَج / خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل. / تنفيس, مخرج (نشاط يحرر أو يعبر عن الطاقة الإبداعية أو العاطفة) / مخرج, منفذ (فتحة تسمح بالهروب أو الخروج) / متجر, محل تجاري (مكان عمل لبيع البضائع بالتجزئة) / مأخذ كهربائي, مِقبس جداري (مقبس يوفر مكاناً في نظام الأسلاك يمكن منه أخذ التيار لتشغيل الأجهزة الكهربائية)\nمثال: لم يكن لديها مخرج آخر لمشاعرها",
 "出口調査": "استطلاع الخروج (استطلاع للناخبين أثناء مغادرتهم مكان التصويت؛ عادة ما تجريه وسائل الإعلام للتنبؤ بنتيجة الانتخابات)",
 "出合": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم. / احتشاد, تجمهر (تجمع الناس معاً) / التقاء, تلاق (التدفق معاً في مجرى واحد) / ملتقى النهرين, نقطة التقاء (مكان تندمج فيه الأشياء أو تتدفق معًا (خاصة الأنهار))\nمثال: تقع بيتسبرغ عند نقطة التقاء نهري أليغيني ومونونغاهيلا",
 "出合い": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم. / احتشاد, تجمهر (تجمع الناس معاً) / التقاء, تلاق (التدفق معاً في مجرى واحد) / ملتقى النهرين, نقطة التقاء (مكان تندمج فيه الأشياء أو تتدفق معًا (خاصة الأنهار))\nمثال: تقع بيتسبرغ عند نقطة التقاء نهري أليغيني ومونونغاهيلا",
 "出合う": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري.",
 "出向": "إعارة, انتداب (فصل شخص عن منظمته العادية للتعيين المؤقت في مكان آخر) / تأييد, تثنية (حديث لتأييد أو تثنية اقتراح ما)\nمثال: هل أسمع تثنية للاقتراح؟",
 "出向く": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "出品": "مَعْرُوض",
 "出品人": "عارض (شخص ينظم معرضًا ليراه الآخرون)",
 "出品物": "مَعْرُوض",
 "出品者": "بَائِع, بَائِعَة",
 "出商い": "بيع متجول (فعل بيع البضائع لكسب العيش)",
 "出回り": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تَوْرِيد, تَزْوِيد / ذَخِيرَة",
 "出国税": "ضريبة المغادرة (ضريبة تفرض عند مغادرة بلد ما براً أو بحراً أو جواً)",
 "出土品": "صَنِيعَة, مَصْنُوعَة (شيء من صنع الإنسان يُؤخَذ ككلّ متكامل)",
 "出域": "ذهاب, رحيل (فعل المغادرة)",
 "出場": "مُسَاهَمَة, اِشْتِرَاك (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / خُرُوج / مَخْرَج / خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل. / مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "出場所": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "出場権": "مركز, منصب (وظيفة أو دور في منظمة ما) / سرير سفينة, سرير قطار (سرير على متن سفينة أو قطار؛ عادة ما يكون في طبقات) / مربط, مرسى (مكان يمكن فيه تثبيت القارب أو السفينة)\nمثال: شغل منصباً في وزارة الخزانة",
 "出場者": "مُشَارِك / مُشَارِكَة",
 "出外れ": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "出奔": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة) / تَحْلِيق / فِرَار, هُرُوب\nمثال: الطيران أسرع وسيلة سفر.",
 "出奔者": "آبِق",
 "出好き": "باحث عن المتعة, طوّاف (باحث قلق عن التسلية أو الرفقة الاجتماعية)",
 "出始め": "إطلاق, تدشين (فعل البدء بشيء جديد)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "出嫌い": "بَيْتُوتِيّ (شخص نادراً ما يذهب إلى أي مكان؛ شخص لا يميل للتجول أو السفر)",
 "出家": "كَاهِن, قِسِّيس",
 "出射": "مُخرَج / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة.",
 "出展": "مَعْرُوض",
 "出展者": "عارض (شخص ينظم معرضًا ليراه الآخرون)",
 "出州": "سَفُّود, سِيخ / بَصَقَ, بَزَقَ (بَصَقَ من باب نَصَرَ؛ لفظ مَا فِي فَمه) / بُزَاق",
 "出帆": "رَحِيل, مُغَادَرَة",
 "出師": "بعثة, حملة (رحلة منظمة لغرض معين) / رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة) / بعثة, حملة عسكرية (حملة عسكرية مصممة لتحقيق هدف محدد في بلد أجنبي) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "出席": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "出席者": "حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "出店": "فَرْع, غُصْن / مَعْلِف, مُرَاح / بَسْطة / مَعْرُوض",
 "出店者": "عارض (شخص ينظم معرضًا ليراه الآخرون)",
 "出庫": "شحن, نقل (المشروع التجاري لنقل البضائع والمواد) / شحن بحري, ملاحة تجارية (خدمات النقل التي توفرها السفن التابعة لبلد أو صناعة معينة)",
 "出張": "رِحْلَة عَمَل",
 "出張り": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "出張る": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم.",
 "出張員": "فَاعِل (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "出張所": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "出張旅費": "نفقات السفر ((غالباً بصيغة الجمع) نفقات يتكبدها الموظف في أداء الوظيفة وعادة ما يعوضها صاحب العمل)",
 "出張費": "نفقات السفر ((غالباً بصيغة الجمع) نفقات يتكبدها الموظف في أداء الوظيفة وعادة ما يعوضها صاحب العمل)",
 "出所": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟ / مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس / مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟ / خُرُوج / مَخْرَج / خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "出所進退": "مسار عمل, نهج (طريقة للعمل أو التصرف)\nمثال: إذا استمررت في هذا المسار فستفشل بالتأكيد",
 "出捐": "مُسَاهَمَة (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة.",
 "出掛ける": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "出撃": "طلعة جوية ((عسكرية) رحلة تشغيلية لطائرة واحدة (كما في عملية عسكرية)) / خروج للقوات المحاصرة, طلعة جوية (عمل عسكري تندفع فيه القوات المحاصرة من موقعها)",
 "出放題": "هُرَاء, لَغْو",
 "出方": "مَوْقِف, سُلُوك",
 "出時": "وقت المغادرة (الوقت المقرر لمغادرة وسيلة نقل عامة من نقطة انطلاق معينة)",
 "出札係": "بائع تذاكر, وكيل حجز (شخص يبيع التذاكر (مثل مقاعد المسرح أو حجوزات السفر))",
 "出札口": "شباك التذاكر (نافذة يتم من خلالها بيع التذاكر (كما في كشك التذاكر))",
 "出札所": "شباك التذاكر (المكتب الذي تباع فيه تذاكر الدخول)",
 "出札掛": "بائع تذاكر, وكيل حجز (شخص يبيع التذاكر (مثل مقاعد المسرح أو حجوزات السفر))",
 "出来": "حُدُوث / إتمام, إكمال (إجراء ختامي أو نهائي) / تمريرة ناجحة ((كرة القدم الأمريكية) تمريرة أمامية ناجحة في كرة القدم) / إتقان, حرفة (المهارة في مهنة أو تجارة) / دَرَجَة / نَوْعِيَّة, جَوْدَة / تعاملات (تبادل اجتماعي أو لفظي) / تعامل, صفقة (فعل التعامل داخل أو بين المجموعات (كالقيام بأنشطة تجارية)) / تَعَامُلَات, عَلَاقَات (تعاملات متبادلة أو اتصالات أو تواصل بين الأشخاص أو الجماعات)\nمثال: لا يمكن إجراء أي معاملات بدونه",
 "出来した": "أَحْسَنْتَ, أَحْسَنْتِ",
 "出来す": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "出来すぎ": "تجاوز الإنتاج, فرط الإنتاج (إنتاج مفرط أو أكثر من المتوقع)",
 "出来そこない": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا. / عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "出来た": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم.",
 "出来たて": "طَازَج, طَازَة / عَذْب",
 "出来ない相談": "مطلب صعب, مهمة شاقة (مهمة أو متطلب هائل)\nمثال: كان الانتهاء في الوقت المحدد مطلباً صعباً لكننا فعلنا ذلك",
 "出来る": "صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "出来るだけ": "قَدْر اَلْمُسْتَطَاع, قَدْر اَلْإِمْكَان (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "出来るだけ早く": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "出来る丈": "قَدْر اَلْمُسْتَطَاع, قَدْر اَلْإِمْكَان (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "出来る限り": "قَدْر اَلْمُسْتَطَاع, قَدْر اَلْإِمْكَان (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "出来る限り早く": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "出来る限り早期": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "出来レース": "مُدَبَّر سِرًّا (مخطط له في السر)",
 "出来上がり": "إتمام, إكمال (إجراء ختامي أو نهائي) / تمريرة ناجحة ((كرة القدم الأمريكية) تمريرة أمامية ناجحة في كرة القدم) / إتقان, حرفة (المهارة في مهنة أو تجارة)",
 "出来事": "حُدُوث",
 "出来値": "سعر البيع, سعر العرض (السعر الذي يُعرض به شيء للبيع)",
 "出来具合": "تَسَبَّب / نَتِيجَة",
 "出来合": "جاهز, معد مسبقاً (مصنوع للشراء والاستخدام الفوري) / جَاهِز, مُعَدٌّ تِجَارِيًّا (مُنتَج تجارياً وليس منزلي الصنع) / جَاهِز, نَمَطِيّ (يتكرر بانتظام دون تفكير أو أصالة) / غرض جاهز الصنع, منتج جاهز (منتج مصنّع (كملابس أو قطعة أثاث) يتم صنعه مسبقاً ويكون متاحاً للشراء)\nمثال: شقتهم كانت مؤثثة بأثاث جاهز",
 "出来合い": "جاهز, معد مسبقاً (مصنوع للشراء والاستخدام الفوري) / جَاهِز, مُعَدٌّ تِجَارِيًّا (مُنتَج تجارياً وليس منزلي الصنع) / جَاهِز, نَمَطِيّ (يتكرر بانتظام دون تفكير أو أصالة) / غرض جاهز الصنع, منتج جاهز (منتج مصنّع (كملابس أو قطعة أثاث) يتم صنعه مسبقاً ويكون متاحاً للشراء)\nمثال: شقتهم كانت مؤثثة بأثاث جاهز",
 "出来役": "كاناستا (شكل من أشكال الرومي يستخدم رزمتين من الأوراق وأربعة جوكر؛ الجوكر والاثنين هما أوراق حرة؛ الهدف هو تشكيل مجموعات من نفس الرتبة)",
 "出来損い": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا. / عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "出来損ない": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا. / عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "出来損なう": "أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "出来星": "كيب, نهوض بالركل (تمرين جمباز يبدأ من وضع تكون فيه الساقان فوق الجزء العلوي من الجسم والتحرك إلى وضع منتصب عن طريق تقويس الظهر وأرجحة الساقين للخارج وللأسفل مع دفع…) / حديث النعمة, متسلق طبقي (شخص صعد فجأة إلى وضع اقتصادي أعلى ولكنه لم ينل القبول الاجتماعي من الآخرين في تلك الطبقة) / متغطرس, مغرور (شخص متكبر أو وقح)",
 "出来映え": "تَسَبَّب / نَتِيجَة / إتقان, حرفة (المهارة في مهنة أو تجارة)",
 "出来栄え": "تَسَبَّب / نَتِيجَة / إتقان, حرفة (المهارة في مهنة أو تجارة)",
 "出来物": "ورم (كتلة نسيجية جديدة غير طبيعية لا تخدم أي غرض)",
 "出来立て": "طَازَج, طَازَة / عَذْب",
 "出来過ぎ": "تجاوز الإنتاج, فرط الإنتاج (إنتاج مفرط أو أكثر من المتوقع)",
 "出来高": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "出格": "اِسْم تَفْضِيل (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "出業者": "مُصَدِّر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "出様": "مَوْقِف, سُلُوك",
 "出欠": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "出欠席": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "出歩く": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "出歯": "بروز الفك العلوي, تراكب العضة ((طب الأسنان) سوء إطباق تمتد فيه الأسنان العلوية بشكل غير طبيعي فوق الأسنان السفلية)",
 "出歯亀": "مُتَلَصِّص",
 "出殻": "باحة, ساحة (الأرض المسيجة المحيطة بمنزل أو مبنى آخر) / أساس, بينة (أساس الاعتقاد أو عدم التصديق؛ المعرفة التي يبنى عليها الاعتقاد) / سبب, مبرر (مبرر لوجود أو حدوث شيء ما) / أرض, ساحة (قطعة أرض تم تنظيفها لأغراض خاصة (مثل الترفيه أو الدفن إلخ))\nمثال: كان منزلاً صغيراً بلا فناء تقريباً",
 "出水": "طُوفَان, فَيَضَان (عاصفة)",
 "出没自在": "متملص, مراوغ",
 "出洲": "سَفُّود, سِيخ / بَصَقَ, بَزَقَ (بَصَقَ من باب نَصَرَ؛ لفظ مَا فِي فَمه) / بُزَاق",
 "出涸し": "تَافِه, سَخِيف (يفتقر إلى الأهمية أو التأثير) / تَافِه, عَدِيمُ الطَّعْم (يَفْتَقِرُ إِلَى الطَّعْمِ أَوِ النَّكْهَة)",
 "出涸らし": "تَافِه, سَخِيف (يفتقر إلى الأهمية أو التأثير) / تَافِه, عَدِيمُ الطَّعْم (يَفْتَقِرُ إِلَى الطَّعْمِ أَوِ النَّكْهَة)",
 "出港停止": "حَصَار / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "出湯": "يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "出漁期": "موسم الصيد (الموسم الذي يكون فيه صيد الأسماك قانونيًا)",
 "出演": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "出演者": "عَازِف",
 "出潮": "ذروة المد, مد عالي (المد عندما يكون الماء في أعلى مستوياته)",
 "出無精": "بَيْتُوتِيّ (شخص نادراً ما يذهب إلى أي مكان؛ شخص لا يميل للتجول أو السفر)",
 "出版": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / مَنْشُور\nمثال: نشر توم الغسيل.",
 "出版の自由": "حُرِّيَّة اَلصِّحَافَة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "出版元": "دَار نَشْر, نَاشِر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "出版屋": "دَار نَشْر, نَشْر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "出版所": "دَار نَشْر, نَشْر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "出版業者": "دَار نَشْر, نَاشِر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "出版物": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / مَنْشُور\nمثال: نشر توم الغسيل.",
 "出版社": "دَار نَشْر, نَاشِر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "出版者": "دَار نَشْر, نَاشِر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "出版部数": "انتشار, تداول (انتشار أو نقل شيء ما (كالأخبار أو المال) إلى مجموعة أو منطقة أوسع) / توزيع, نشر (توزيع نسخ من الدوريات (مثل الصحف أو المجلات)) / دوران, سريان (حركة حرة أو مرور (كما في السيتوبلازم داخل الخلية أو النسغ عبر النبات)) / دوران, دورة دموية (الحركة عبر دائرة؛ وخاصة حركة الدم عبر القلب والأوعية الدموية)\nمثال: دوران المحيط جزء مهم من المناخ العالمي",
 "出物": "بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / بَرْمَجَ, وَضَعَ بَرْنَامَجًا / بَرْمَجَ\nمثال: نشط البرنامج الآن. / قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / طَفْح, طَفْح جِلْدِيّ / صَفْقَة (عَقْد، اتِّفَاق؛ ضرب اليدين عند العقد)\nمثال: إنها صفقة جيدة. / حَبَقَ, ضَرَطَ (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في النّاس : حَبَقَ يحبِق حبْقاً وحَبِقاً وحُباقاً؛ الحَبْق : ضُراط المَعِز ، وقد تستعمل في النّاس) / حَبْقَة, ضَرْطَة",
 "出獄": "أَطْلَقَ سَرَاح, حَرَّرَ",
 "出現": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "出現頻度": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "出生": "وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "出生前診断": "تشخيص ما قبل الولادة (أي من الإجراءات التشخيصية المستخدمة لتحديد ما إذا كان الجنين يعاني من خلل وراثي)",
 "出生地": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "出生地主義": "حق الإقليم, حق المولد (المبدأ القائل بأن جنسية الشخص عند الولادة تتحدد بمكان ولادته)",
 "出生年月日": "تَارِيخُ الْمِيلَادِ, تَارِيخُ مِيلَادِ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "出生率": "خُصُوبَة, مُعَدَّل المَوَالِيد (نسبة المواليد الأحياء في منطقة ما إلى سكان تلك المنطقة؛ يُعبر عنها لكل 1000 نسمة في السنة)",
 "出生証明書": "شَهَادَةُ مِيلَاد",
 "出産": "مَخَاض, وَضْع\nمثال: 彼女は健康な赤ん坊を出産しました。 — ولدَت صبيا في صحة جيدة. / إِنْتَاج",
 "出産予定日": "مَوْعِد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "出産後": "بَعْد الوِلَادَة (يحدث مباشرة بعد الولادة)\nمثال: نمو ما بعد الولادة",
 "出産率": "خُصُوبَة, مُعَدَّل المَوَالِيد (نسبة المواليد الأحياء في منطقة ما إلى سكان تلك المنطقة؛ يُعبر عنها لكل 1000 نسمة في السنة)",
 "出発": "رَحِيل, مُغَادَرَة",
 "出発予定時刻": "كشف أثر المتفجرات (نظام لفحص الأمتعة في المطارات؛ يمرر الوكيل مسحة حول الأمتعة أو داخلها ثم يمرر المسحة عبر جهاز يمكنه اكتشاف كميات ضئيلة من المتفجرات)",
 "出発便": "رَحِيل, مُغَادَرَة",
 "出発時刻": "وقت المغادرة (الوقت المقرر لمغادرة وسيلة نقل عامة من نقطة انطلاق معينة)",
 "出発時間": "وقت المغادرة (الوقت المقرر لمغادرة وسيلة نقل عامة من نقطة انطلاق معينة)",
 "出発点": "نقطة البداية (أقرب نقطة حدية)",
 "出盛り": "مَوْسِم / مَوْسِم, جُزْء\nمثال: スイカは今が出盛りだ。 — هذا موسم البطيخ.",
 "出盛る": "قَطِيع / تَهَافَتَ, تَقَاطَرَ / مِزْقَة",
 "出目金": "تِلِسْكُوب, مِقْرَاب",
 "出直す": "عَفْواً! / مَاذَا قُلْتَ؟ (أداة استفهام) / مَاذَا قُلْتِ؟ (أداة استفهام) / هَلَّا أَعَدْتَ مَا قُلْتَ؟ / هَلَّا أَعَدْتِ مَا قُلْتِ؟\nمثال: ماذا تريد الآن؟",
 "出稼ぎ": "عامل مهاجر, متشرد (عامل يتنقل ويعمل مؤقتاً في أماكن مختلفة)",
 "出稼ぎ労働者": "عامل مهاجر, متشرد (عامل يتنقل ويعمل مؤقتاً في أماكن مختلفة)",
 "出稿": "مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس",
 "出窓": "نافذة بارزة (نافذة تبرز من الجدار الخارجي للمنزل) / كرش (مصطلحات عامية للكرش أو البطن البارز)",
 "出立": "رَحِيل, مُغَادَرَة",
 "出端": "فُرْصَة / استهلال, انطلاق (الوقت الذي يفترض أن يبدأ فيه شيء ما)\nمثال: بدأوا بداية مبكرة",
 "出精": "اِجْتِهَاد",
 "出納係": "كَاشِير, صَرَّاف / أَمِينُ الصُّنْدُوقِ (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "出納係り": "كَاشِير, صَرَّاف / أَمِينُ الصُّنْدُوقِ (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "出納簿": "دَفْتَر حِسَابَات",
 "出群": "امْتِيَاز, بَرَاعَة (صفة التفوق؛ امتلاك صفات جيدة بدرجة عالية) / براعة, تفوق (ميزة بارزة؛ شيء يتفوق فيه شيء أو شخص ما)\nمثال: مركز للتميز الصناعي",
 "出自": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل / نُزُول",
 "出航": "رَحِيل, مُغَادَرَة",
 "出色": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ) / بَارِز, عَظِيم (ذو أهمّيّة أو دلالة كُبرى) / غَيْرُ مُسَدَّد, مُسْتَحَقّ (مُسْتَحَقٌّ كَدَيْن) / بَارِع, مُتَمَيِّز (يتميز عن غيره بالتفوق)",
 "出芽": "اِنْتَاش",
 "出荷": "شحن, نقل (المشروع التجاري لنقل البضائع والمواد) / شحن بحري, ملاحة تجارية (خدمات النقل التي توفرها السفن التابعة لبلد أو صناعة معينة)",
 "出荷人": "شركة شحن (شركة تعمل في مجال شحن البضائع) / شاحن (شخص يقوم بشحن البضائع)",
 "出荷元": "شركة شحن (شركة تعمل في مجال شحن البضائع) / شاحن (شخص يقوم بشحن البضائع)",
 "出荷先": "وِجْهَة, وُجْهَة",
 "出荷時": "مَصْنَع, مَعْمَل (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "出血": "نَزِيف, نَزْف / خسارة, عجز (المبلغ الذي تتجاوز به تكلفة العمل إيراداته)\nمثال: عملت الشركة بخسارة العام الماضي / خسائر, خسارة (نقصان في الأفراد أو المعدات العسكرية) / إصابة مميتة, حادث مميت (حادث يتسبب في موت شخص ما) / ضَحِيَّة حادِث, مُصاب (شخص أصيب أو قتل في حادث) / إِصابَة, خَسارَة بَشَرِيَّة (شخص أصيب أو قتل أو أسر أو فقد في اشتباك عسكري)",
 "出血大サービス": "بيع بضائع متضررة, تصفية حريق (بيع البضائع التي يُفترض أنها تضررت بسبب الحريق) / بيع اضطراري, بيع بخس (بيع الأصول بأسعار منخفضة جداً عادةً عندما يواجه البائع الإفلاس)",
 "出血性": "نزفي (مكون من أو متعلق بالنزيف)",
 "出血熱": "حمى نزفية (مجموعة من الأمراض التي تسببها عدوى فيروسية؛ تلي الحمى والأعراض المعوية نزيف شعيري)",
 "出訴期限法": "قانون التقادم (قانون يحدد الفترة الزمنية التي يمكن خلالها اتخاذ إجراء قانوني)",
 "出費": "صَرْف, مَصْرُوف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال وبمعنى الرَدّ والمَنْع)\nمثال: أيمكنك صرف خمسين؟",
 "出資": "اِسْتِثْمَار",
 "出資者": "مُسْتَثْمِر, مُسْتَثْمِرَة",
 "出資金": "رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "出足": "دوران للخارج ((باليه) الدوران الخارجي لساق الراقص من الورك) / إِقْبَال (الحضور لحدث أو غرض معين (كما في التصويت في الانتخابات)) / طقم ملابس, هندام (مجموعة متناسقة من الملابس (مع الإكسسوارات)) / إنتاج, مخرجات (ما يتم إنتاجه في فترة زمنية معينة)\nمثال: الإقبال على التجمع / نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / شَحْطَة / شَرْطَة",
 "出身校": "الجامعة الأم",
 "出身者": "طَالِب, طَلَبَة / خِرِّيج, خِرِّيجُون",
 "出軍": "بعثة, حملة (رحلة منظمة لغرض معين) / رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة) / بعثة, حملة عسكرية (حملة عسكرية مصممة لتحقيق هدف محدد في بلد أجنبي) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "出迎え": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "出迎える": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري.",
 "出逢い": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم. / احتشاد, تجمهر (تجمع الناس معاً) / التقاء, تلاق (التدفق معاً في مجرى واحد) / ملتقى النهرين, نقطة التقاء (مكان تندمج فيه الأشياء أو تتدفق معًا (خاصة الأنهار))\nمثال: تقع بيتسبرغ عند نقطة التقاء نهري أليغيني ومونونغاهيلا",
 "出逢う": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري.",
 "出遭い": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم. / احتشاد, تجمهر (تجمع الناس معاً) / التقاء, تلاق (التدفق معاً في مجرى واحد) / ملتقى النهرين, نقطة التقاء (مكان تندمج فيه الأشياء أو تتدفق معًا (خاصة الأنهار))\nمثال: تقع بيتسبرغ عند نقطة التقاء نهري أليغيني ومونونغاهيلا",
 "出遭う": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري.",
 "出金": "اِنْسِحَاب",
 "出金者": "كاتب مساهم, مساهم (كاتب يُنشر عمله في صحيفة أو مجلة أو كجزء من كتاب) / متبرع, مساهم (شخص يساهم (أو يعد بالمساهمة) بمبلغ من المال)",
 "出門": "ذهاب, رحيل (فعل المغادرة)",
 "出陣": "حُضُور, مُثُول (حضور رسمي (في المحكمة أو في جلسة استماع) لطرف في دعوى)",
 "出離": "انبيثاق, بزوغ (فعل الخروج أو الظهور للعيان) / بزوغ, خروج (الظهور للعيان) / بزوغ, خروج ((في علم الفلك) عودة ظهور جرم سماوي بعد الكسوف أو الاحتجاب)\nمثال: لا يوجد فرق يوم واحد بين ظهور النحل وتفتح أزهار الصفصاف",
 "出頭": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / اِسْتَسْلَمَ / اِسْتَسْلَام",
 "出頭命令": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له.",
 "出願": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "出願人": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "出願書類": "استمارة طلب, نموذج تقديم (نموذج يستخدم عند تقديم طلب)",
 "出願者": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "出馬": "رَكْض (عَدَا)\nمثال: إنها تحب الركض.",
 "出駕": "رَحِيل, مُغَادَرَة",
 "出鼻": "استهلال, انطلاق (الوقت الذي يفترض أن يبدأ فيه شيء ما)\nمثال: بدأوا بداية مبكرة",
 "函人": "صانع أسلحة (مُصنِّع للأسلحة النارية) / صانع أسلحة, مسؤول تسليح (جندي مجند مسؤول عن صيانة الأسلحة الصغيرة والمدافع الرشاشة وما إلى ذلك) / صانع الأسلحة, صانع الدروع (عامل ماهر في صنع الدروع أو الأسلحة)\nمثال: سيف صنعه صانع أسلحة إنجليزي شهير",
 "刀": "سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة) / سَيَّافٌ\nمثال: القلم أقوى من السيف. / مِشْرَط / إِزْمِيل",
 "刀剣": "سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة) / سَيَّافٌ\nمثال: القلم أقوى من السيف.",
 "刀匠": "سَيَّاف, سَلَّال",
 "刀圭": "دَوَاء / عِلَاج, شِفَاء / طِبّ (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "刀室": "غِمْد, غِلَاف",
 "刀工": "سَيَّاف, سَلَّال",
 "刀禰": "كَاهِن, قِسِّيس",
 "刀術": "مُبَارَزَة",
 "刀豆": "فاصوليا سيفية (نبات استوائي ملتف من العالم القديم يحمل قروناً طويلة عادة مع حبوب حمراء أو بنية؛ يزرع منذ فترة طويلة في الشرق للغذاء)",
 "刀身": "نصل السكين (شفرة السكين)",
 "刀鍛冶": "سَيَّاف, سَلَّال",
 "刃": "حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما) / حافة, طرف (الحد الخارجي لجسم أو منطقة أو سطح؛ مكان أبعد ما يكون عن مركز الشيء) / أَفْضَلِيَّة نِسْبِيَّة, تَفَوُّق بَسِيط (ميزة تنافسية طفيفة) / حدة (سمة الإلحاح في نبرة الصوت)\nمثال: قام بتدوير حواف الصندوق / سن, شوكة (نتوء مدبب) / نَصْل (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة الحادّة الجارحة)\nمثال: لن نصل إلى أي مكان. / حدة, خشونة (قسوة في الأسلوب) / تَمَايُز, حِدَّة (صفة كون الشيء حاداً وواضحاً) / حدة (رقة الحافة أو دقة الطرف) / حدة (صفة الشعور بالشيء بحدة وألم شديد)\nمثال: حدة خسارتها",
 "刃傷": "سَفْك الدَّم, إِرَاقَةُ الدَّم (أَسَاءَ، سَكَبَ الدم أو السائل؛ سَفَكَ الدم: أراقه وأهدره) / سَفَكَ الدَّمَ (أَسَاءَ، سَكَبَ الدم أو السائل؛ سَفَكَ الدم: أراقه وأهدره)",
 "刃傷沙汰": "سَفْك الدَّم, إِرَاقَةُ الدَّم (أَسَاءَ، سَكَبَ الدم أو السائل؛ سَفَكَ الدم: أراقه وأهدره) / سَفَكَ الدَّمَ (أَسَاءَ، سَكَبَ الدم أو السائل؛ سَفَكَ الدم: أراقه وأهدره)",
 "刃向かう": "شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه) / اِنْقَلَبَ عَلَى\nمثال: شغل بيل التلفاز.",
 "刃物": "سِكِّين, مُدْيَة (أَدَاةٌ حَادَةٌ تُسْتَخْدَمُ فِي تَقْطِيعِ مُخْتَلَفِ أَصْنَافِ الطَّعَامِ كَاللَّحْمِ وَالْخُضَرِ، وَلِذَبْحِ الْحَيَوَانَاتِ؛ أَدَاةٌ حَادَةٌ تُصْنَعُ غَالِباً مِنَ الْمَعْدِنِ، لِلدِّفَاعِ عَنِ النَّفْسِ وَاسْتِخْدَامِهَا أَثْنَاءَ الْقِتَالِ) / خَنْجَر, خنجر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين) / نَصْل, شَفْرَة (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة الحادّة الجارحة)\nمثال: أحتاج الى سكين.",
 "刃物師": "سَكَاكِينِيّ",
 "刃針": "مِفْصَد, فَاصِد",
 "分": "دَقِيقَة, دِقيقة (وِحْدَة زَمَنِيَّة تساوي ستين ثَانِيَة، وجزءًا من ستّين جزءًا من السَّاعَة؛ في : وحدة لقياس خطوط الطول والعرض) / لَحْظَة / دَقِيقٌ, تَافِهٌ (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: استأذنت لدقيقة. / مَرَح, تَرْفِيه / مَرِح, مُسَلٍّ / عُشْر (جزء من عشرة؛ جزء واحد من عشرة أجزاء متساوية) / رُبْع (واحد من أربعة أجزاء متساوية) / سَمَاكَة / جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟ / مَبْلَغ, مِقْدَار / بَلَغَ / شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / رَاضٍ, مُرْتَاح (رَاضَ (راضه)روضا ورياضا ورياضة: ذلله. يقال راض المهر وراض نفسه بالتقوى وراض القوافي الصعبة؛ (رَاضَ) الدر: ثقبه. فهو مروض وهي مروضة) / رَضَّى / مُحْتَوًى, مَضْمُون / كَمِّيَّة, نِسْبَة\nمثال: سامي غير راض بوظيفته.",
 "分かち": "تَمْيِيْز",
 "分かちあう": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "分かちあたえる": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "分かちがたい": "لَا يَنْفَصِل (غَيْر قَابِل لِلفَصْل)",
 "分かちもつ": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "分かち与える": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "分かち合う": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "分かち持つ": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "分かち難い": "لَا يَنْفَصِل (غَيْر قَابِل لِلفَصْل)",
 "分かつ": "قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم. / نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "分からず屋": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "分からん": "لَا أَعْلَمُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / لَا أَعْرِف (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / لَسْتُ أَدْرِي / لَا أَدْرِي (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "分かり": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "分かりきった": "بَدِيهِيّ, بَدَهِيّ",
 "分かりづらい": "مُرْبِك",
 "分かりにくい": "غامض, غير مفهوم (صعب الفهم) / عصي على الفهم, لا يمكن تفسيره (غير قادر على أن يفسر أو يعلل)\nمثال: الشيء الأكثر غموضاً (عدم قابلية للفهم) في الكون هو أنه قابل للفهم",
 "分かりみ": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "分かり切った": "بَدِيهِيّ, بَدَهِيّ",
 "分かり悪い": "غامض, غير مفهوم (صعب الفهم) / عصي على الفهم, لا يمكن تفسيره (غير قادر على أن يفسر أو يعلل)\nمثال: الشيء الأكثر غموضاً (عدم قابلية للفهم) في الكون هو أنه قابل للفهم",
 "分かり辛い": "مُرْبِك",
 "分かり難い": "غامض, غير مفهوم (صعب الفهم) / عصي على الفهم, لا يمكن تفسيره (غير قادر على أن يفسر أو يعلل)\nمثال: الشيء الأكثر غموضاً (عدم قابلية للفهم) في الكون هو أنه قابل للفهم",
 "分かる": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "分かれ": "فرع, نتاج طبيعي (عاقبة طبيعية للتطور)",
 "分かれる": "فَرْع, غُصْن / فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل. / نَثَرَ, تَفَرَّقَ",
 "分かれ出る": "شُعَاعِيّ (ذو أشعّة أو أجزاء شعاعيّة كما في رؤوس أزهار الأقحوان) / شُعَاعِيّ, نَجْمِيّ (مُرتَّب كالأشعة؛ ينبثق من مركز مشترك)",
 "分かれ目": "شَوْكَة, مِذْرَاة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم) / تَفَرَّعَ / تَشَعَّبَ\nمثال: هناك شوكة ناقصة. / نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "分かれ道": "فَرْع, غُصْن / مُفْتَرَق, تَقَاطُع",
 "分が薄い": "رَفِيع, رَقِيق / ضعيف, ضعيفة",
 "分け": "تَقْسِيم / قِسْمَة (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / قِسْمَةٌ (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / فِرْقَة / فُرْقَة\nمثال: الزواج قسمة و نصيب. / إِقْتِسَام, مُقَاسَمَة / دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
 "分けつ": "زَارِع",
 "分ける": "قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم. / نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم. / مَيَّزَ / بواسطة, غير مباشر (يعمل من خلال أو يعتمد على وكالة أو وسيط متدخل) / مُتَوَسِّط, وَسَطِيّ (لَيْسَ فِي البِدَايَةِ وَلَا فِي النِّهَايَةِ ضِمْنَ سِلْسِلَةٍ)\nمثال: انتشر المرض عن طريق الاتصال غير المباشر (بواسطة) وكذلك المباشر",
 "分け与える": "وَزَّعَ (كَفَّ ومَنَعَ وحَبَسَ؛ به: أَغْرَى)\nمثال: وزع علينا الورق.",
 "分け前": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "分け取り": "إِقْتِسَام, مُقَاسَمَة",
 "分け取る": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "分け合う": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "分け持つ": "نَصِيب, حِصَّة / سَهْم (سَهَمَ؛ سَهَّمَ) / شَارَكَ\nمثال: لم يصب السهم توم.",
 "分け目": "حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي)\nمثال: هناك خط رفيع بين العقل والجنون / أَزْمَة, بُحْرَان / أَزْمَة",
 "分け隔て": "تَمْيِيْز",
