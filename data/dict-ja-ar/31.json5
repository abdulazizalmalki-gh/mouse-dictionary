 "人口過多": "زيادة سكانية",
 "人台": "مِثَالَة / مَانِيكَان / مَانُوكَان",
 "人名簿": "دليل (قائمة أبجدية بالأسماء والعناوين) / دليل ((علوم الكمبيوتر) قائمة بالملفات المخزنة في الذاكرة (عادة على قرص صلب))",
 "人名録": "دليل (قائمة أبجدية بالأسماء والعناوين) / دليل ((علوم الكمبيوتر) قائمة بالملفات المخزنة في الذاكرة (عادة على قرص صلب))",
 "人君": "مُسْتَقِلّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره) / عَاهِل, مَلِك\nمثال: الجزائر مستقلة الآن.",
 "人命": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "人命救助": "إنقاذ الغرقى (إنقاذ حياة الغرقى)\nمثال: أخذ دورة في إنقاذ الغرقى",
 "人品": "شَخْصِيَّة / خُلْق (أَنْشَأَ، أَوْجَدَ) / حَرْف, رَمْز (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / مِحْرَف\nمثال: زيري سيء الخلق.",
 "人員": "إدارة الموارد البشرية, قسم شؤون الموظفين (القسم المسؤول عن تعيين وتدريب وتوزيع الموظفين ووضع سياسات إدارة الأفراد) / قوة (مجموعة من الناس مستعدة لإطاعة الأوامر)\nمثال: قوة عامة ضرورية لتوفير الأمن لحقوق المواطنين",
 "人喰": "أكل لحوم الجنس الواحد (ممارسة أكل لحم جنسك) / آكل للحوم البشر (مميز لآكلي لحوم البشر أو يظهر أكل لحوم البشر)\nمثال: سلوك أكل لحوم البشر",
 "人喰い": "أكل لحوم الجنس الواحد (ممارسة أكل لحم جنسك) / آكل للحوم البشر (مميز لآكلي لحوم البشر أو يظهر أكل لحوم البشر)\nمثال: سلوك أكل لحوم البشر",
 "人型ロボット": "أَنْدْرُويِد",
 "人士": "اَلسَّيِّد, سَيِّد / نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "人声": "بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه) / بكاء\nمثال: بكى زيري كثيرا.",
 "人売り": "تجارة الرقيق (الاتجار في العبيد؛ خاصة الأفارقة السود الذين تم نقلهم إلى أمريكا من القرن 16 إلى 19) / تاجر رقيق (شخص يعمل في تجارة الرقيق)",
 "人夫": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "人夫々": "كل شخص حرّ في ذوقه",
 "人好き": "جاذبية (جاذبية جنسية) / جَاذِبِيَّة (صفة إثارة الاهتمام؛ كون الشيء جذاباً أو شيئاً يجذب)\nمثال: حملت شخصيتها جاذبية غريبة بالنسبة له",
 "人妻": "امرأة متزوجة, زوجة (امرأة متزوجة؛ شريكة الرجل في الزواج)",
 "人嫌い": "بُغْض الْبَشَرِيَّة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "人孔": "فتحة صيانة, منهول (ثقب (عادة بغطاء مستو) يمكن للشخص من خلاله الوصول إلى هيكل تحت الأرض)",
 "人定": "تجسيد, تقمص (تمثيل دور شخصية على المسرح؛ تمثيل الشخصية بشكل درامي عن طريق الكلام والفعل والإشارة) / إقرار, سن (تمرير قانون من قبل هيئة تشريعية) / تشريع, قانون (وثيقة قانونية تدون نتيجة مداولات لجنة أو جمعية أو هيئة تشريعية)",
 "人定法": "تَرْكِيبِيّ, مَصْنُوع (ليس من أصل طبيعي؛ أُعِدّ أو صُنِع صناعيًّا)",
