 "佐渡": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "佐田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "佐竹": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "佐賀": "مَلحَمَة",
 "佐野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "佑助": "مُسَاعَدَة, إِمْدَاد",
 "体": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ…) / جِذْع, جِسْم (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر) / بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر…)\nمثال: بنى سامي منزلا. / صِحَّة, عَافِيَة (سَلَامَة؛ سَلَامَة الْجِسْم)\nمثال: أشك في صحة ذلك. / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ…) / شَكْل, أَشْكَال ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب.",
 "体が弱い": "رَقِيق, سَهْلُ الكَسْر (يَسْهُلُ كَسْرُهُ أَوْ إِتْلَافُهُ أَوْ تَدْمِيرُهُ)\nمثال: جسد المريض الواهن",
 "体ごと": "جَسَدِيّ, بَدَنِيّ",
 "体じゅう": "جَمِيع أَنْحَاء, كُلّ",
 "体たらく": "حالة, ظرف (الحالة العامة للأشياء؛ مجموعة الظروف في وقت معين)\nمثال: الوضع الدولي الحالي خطير",
 "体つき": "حركة فنية (مجموعة محددة مسبقاً من الحركات في الرقص أو التزلج)\nمثال: حققت أفضل درجة في الحركات الإلزامية",
 "体づくり": "كَمَال أَجْسَام",
 "体に悪い": "غَيْر صِحِّيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "体の不自由": "مُعَوَّق",
 "体の弱い": "رَقِيق, سَهْلُ الكَسْر (يَسْهُلُ كَسْرُهُ أَوْ إِتْلَافُهُ أَوْ تَدْمِيرُهُ)\nمثال: جسد المريض الواهن",
 "体よく": "بشكل صحيح, كما ينبغي (بالطريقة الصحيحة؛ بشكل لائق)\nمثال: أرجوك قم بعملك كما ينبغي!",
 "体をかわす": "تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "体を交える": "ضَاجَعَ, جَامَعَ",
 "体を起こす": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "体を躱す": "تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "体を開く": "تفادي, مراوغة (حركة مراوغة سريعة)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "体中": "جَمِيع أَنْحَاء, كُلّ",
 "体付き": "حركة فنية (مجموعة محددة مسبقاً من الحركات في الرقص أو التزلج)\nمثال: حققت أفضل درجة في الحركات الإلزامية",
 "体位": "بنية, قوام (تكوين الجسم البشري)\nمثال: درس ليوناردو جسم الإنسان / وَضْعِيَّة",
 "体作り": "كَمَال أَجْسَام",
 "体内時計": "سَاعَة بَيُولُوجِيَّة (آلية فطرية في الكائنات الحية تتحكم في دورية العديد من الوظائف الفسيولوجية)",
 "体刑": "عُقُوبَةٌ بَدَنِيَّة",
 "体制": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية. / تَأْسِيس / تَشْرِيح",
 "体制側": "تَأْسِيس",
 "体力": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة. / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة.",
 "体力測定": "لياقة بدنية (حالة بدنية جيدة؛ التمتع بلياقة عالية)",
 "体力的": "مَادِّيّ, مَلْمُوس",
 "体勢": "وَضْعِيَّة",
 "体型": "حركة فنية (مجموعة محددة مسبقاً من الحركات في الرقص أو التزلج)\nمثال: حققت أفضل درجة في الحركات الإلزامية / نمط الجسم (فئة من البنية الجسدية)",
 "体外受精": "في أنبوب اختبار, في المختبر (في بيئة اصطناعية خارج الكائن الحي)\nمثال: بويضة مخصبة في المختبر",
 "体外授精": "في أنبوب اختبار, في المختبر (في بيئة اصطناعية خارج الكائن الحي)",
 "体外離脱": "تجربة الخروج من الجسد (التجربة الانفصالية لمراقبة الذات من منظور خارجي كما لو أن العقل أو الروح قد…)",
 "体幹": "جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر)\nمثال: أين صندوق البريد؟",
 "体形": "حركة فنية (مجموعة محددة مسبقاً من الحركات في الرقص أو التزلج)\nمثال: حققت أفضل درجة في الحركات الإلزامية",
 "体得": "إخضاع, سيادة (فعل السيطرة على شخص ما أو إخضاعه)\nمثال: تمكن جيد من الفرنسية",
 "体循環": "دَوْرَة دَمَوِيَّة كُبْرَى (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه…)\nمثال: خضع زيد لدورة مكثفة",
 "体性感覚": "إحساس جسدي, حس جسدي (إدراك الأحاسيس اللمسية أو استقبال الحس العميق أو الأحاسيس الحشوية)\nمثال: اعتمد على الحس الجسدي لتحذيره من تغيرات الضغط",
 "体感": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "体感ゲーム": "لَعْبَةْ فِيدِيُو (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "体技": "فَنٌّ قِتَالِيّ, الفُنُون القِتَالِيَّة (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "体操": "جُمْبَاز / تَعْلِيم جَسَدِيّ, تَعْلِيم بَدَنِيّ (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على…)\nمثال: هو بارع في التعليم.",
 "体操場": "جمنازيوم, صالة ألعاب رياضية (منشأة رياضية مجهزة للرياضة أو التدريب البدني)",
 "体操選手": "لاعب جمباز (رياضي ماهر في الجمباز)",
 "体文": "صَامِت\nمثال: ألف هو الحرف الأول للألف باء.",
 "体格": "بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر…)\nمثال: بنى سامي منزلا.",
 "体格検査": "فَحْص طِبِّيّ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في :…)\nمثال: فحص الطبيب بطني.",
 "体様": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "体毛": "شَعْرُ الجِسْم (شعر قصير ينمو على جسم الإنسان)",
 "体況": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\"",
 "体液": "سائل جسدي, سوائل الجسم (الأجزاء السائلة من الجسم) / مَنِيّ",
 "体温": "درجة حرارة الجسم (درجة حرارة الجسم؛ عادة 37 درجة مئوية في البشر)\nمثال: 看護婦が彼の体温を計った。 — قاست الممرضة حرارته.",
 "体温器": "تِرْمُومِتْر, مِقْيَاسُ الْحَرَارَة",
 "体温計": "تِرْمُومِتْر, مِقْيَاسُ الْحَرَارَة",
 "体現": "تَجْسِيد",
 "体現者": "تَجَسَّد",
 "体積": "سِعَة",
