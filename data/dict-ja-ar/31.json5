 "到着駅": "وِجْهَة, وُجْهَة",
 "到達": "بلوغ, تحقيق الهدف (إنجاز هدف أو غاية) / مد, وصول (فعل المد الجسدي أو الدفع للخارج)",
 "刳り": "أَجْوَف",
 "刳り形": "سبك, صب (فعل إنشاء شيء ما عن طريق صبه في قالب) / تشكيل, نمذجة (نحت أولي من الشمع أو الطين يمكن نسخ العمل النهائي منه) / قولبة, نحت طيني (نحت يتم إنتاجه بالقولبة) / إفريز, قولبة (سطح زخرفي غائر أو بارز على الحافة)",
 "刳り抜く": "أَجْوَف",
 "刳り舟": "بيروج, زورق محفور (كانو مصنوع عن طريق حفر وتشكيل جذع شجرة كبير)",
 "刳り船": "بيروج, زورق محفور (كانو مصنوع عن طريق حفر وتشكيل جذع شجرة كبير)",
 "刳り貫く": "أَجْوَف",
 "刳る": "تجويف, نقر (فعل النقر أو التجويف بأداة) / إزميل مقعر, مِنْقَار (أداة ذات حد بشفرة تشبه الميزاب لقطع القنوات أو الأخاديد) / انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة)) / تَجَوَّفَ / مِغْرَفَة / رَعَشَة / يرتعش / يهز",
 "刳形": "سبك, صب (فعل إنشاء شيء ما عن طريق صبه في قالب) / تشكيل, نمذجة (نحت أولي من الشمع أو الطين يمكن نسخ العمل النهائي منه) / قولبة, نحت طيني (نحت يتم إنتاجه بالقولبة) / إفريز, قولبة (سطح زخرفي غائر أو بارز على الحافة)",
 "刳抜く": "أَجْوَف",
 "刳舟": "بيروج, زورق محفور (كانو مصنوع عن طريق حفر وتشكيل جذع شجرة كبير)",
 "刳船": "بيروج, زورق محفور (كانو مصنوع عن طريق حفر وتشكيل جذع شجرة كبير)",
 "刳貫く": "أَجْوَف",
 "制": "نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق) / جِهَاز\nمثال: ليس بنظام كامل.",
 "制がん": "مضاد للأورام, مضاد للسرطان (يستخدم في علاج السرطان)\nمثال: دواء مضاد للسرطان",
 "制す": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "制する": "لِجَام, صُرْع / سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "制令": "تَنْظِيم",
 "制作": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل. / إِنْتَاج",
 "制作室": "إِسْتُودِيُو",
 "制作者": "مُنْتِج",
 "制作費": "تكلفة الإنتاج (التكاليف المجمعة للمواد الخام والعمالة المتكبدة في إنتاج البضائع)",
 "制動": "فَرَمَلَة / مِكْبَح / فَرْمَلَ, َكَبَح / جَنَاحِيَّة / دَقَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه)\nمثال: واصل زيري دق الجرس.",
 "制動手": "عامل الفرامل (موظف سكة حديد ذكر مسؤول عن فرامل القطار)",
 "制動機": "فَرَمَلَة / مِكْبَح / فَرْمَلَ, َكَبَح / جَنَاحِيَّة / دَقَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه)\nمثال: واصل زيري دق الجرس.",
 "制動灯": "ضوء التوقف, ضوء الفرامل (ضوء أحمر في الجزء الخلفي من المركبة يشير إلى استخدام الفرامل للإبطاء أو التوقف)",
 "制勝": "اِنْتِصَار, نَصْر",
 "制吐薬": "مضاد للقيء (دواء يمنع أو يخفف الغثيان والقيء)",
 "制圧": "كبت, كبح ((علم النفس) الاستبعاد الواعي للأفكار أو الرغبات غير المقبولة) / إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة) / حظر, منع (فعل حجب أو سحب كتاب أو كتابة من النشر أو التداول) / قمع, كبت (فشل نمو جزء أو عضو ما)\nمثال: قمع الهرطقة",
 "制圧射撃": "نيران إخماد, نيران قمعية (نيران على أو حول نظام أسلحة لتقليل أدائه إلى ما دون المستوى المطلوب لتحقيق أهداف مهمته)",
 "制定": "تجسيد, تقمص (تمثيل دور شخصية على المسرح؛ تمثيل الشخصية بشكل درامي عن طريق الكلام والفعل والإشارة) / إقرار, سن (تمرير قانون من قبل هيئة تشريعية) / تشريع, قانون (وثيقة قانونية تدون نتيجة مداولات لجنة أو جمعية أو هيئة تشريعية)",
 "制定法": "تشريع, قانون تشريعي (قانون تم سنه من قبل هيئة تشريعية)",
 "制度": "نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق) / جِهَاز\nمثال: ليس بنظام كامل.",
 "制度化": "ترشيد, منهجة (تنظيم منهجي؛ فعل تنظيم شيء ما وفقاً لنظام أو منطق)",
 "制度的": "نِظَامِيّ",
 "制式": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "制御": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "制御システム": "نظام تحكم (نظام للتحكم في تشغيل نظام آخر)",
 "制御不能": "منفلت من عقاله",
 "制御卓": "وَاسَى, عَزَّى",
 "制御器": "تحكم, وحدة تحكم (آلية تتحكم في تشغيل آلة) / محاسب, مراقب مالي (شخص يقوم بمسك وتدقيق الحسابات التجارية) / ضابط, متحكم (شخص يوجه ويضبط)\nمثال: وحدة التحكم في السرعة في مشغل الأسطوانات لم تكن تعمل بشكل صحيح",
 "制御回路": "دائرة تحكم, دائرة تغذية راجعة سلبية (دائرة تغذية راجعة تطرح من المدخلات)",
 "制御室": "غرفة التحكم (غرفة تضم معدات التحكم (كما في استوديو التسجيل))",
 "制御工学": "هَنْدَسَة التَّكَكُّمَ (الحدُّ والقياس؛ في الرياضيات: هي العلم الذي يبحث في الأشكال وعلاقاتها من حيث الخطوط والأبعاد والسطوح وغيرها)\nمثال: هو ضليع في علم الهندسة .",
 "制御文字": "شَخْص (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "制御棒": "قضيب تحكُّم (قضيب من الفولاذ أو الألومنيوم يمكن تحريكه لأعلى أو لأسفل للتحكم في معدل التفاعل النووي)",
 "制御権": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "制御機": "تحكم, وحدة تحكم (آلية تتحكم في تشغيل آلة) / محاسب, مراقب مالي (شخص يقوم بمسك وتدقيق الحسابات التجارية) / ضابط, متحكم (شخص يوجه ويضبط)\nمثال: وحدة التحكم في السرعة في مشغل الأسطوانات لم تكن تعمل بشكل صحيح",
 "制御機能": "عملية تحكم (عملية تتحكم في تسجيل أو معالجة أو إرسال أو تفسير البيانات)\nمثال: بدأت عملية تحكم بمعالجة البيانات",
 "制御点": "سنتيمتر (وحدة مترية للطول تساوي واحداً من المائة من المتر) / كوريوم (عنصر فلزي مشع ما بعد اليورانيوم؛ ينتج بقصف البلوتونيوم بنوى الهيليوم)",
 "制御盤": "لَوْحَةُ التَّحَكُّم",
 "制御系": "نظام تحكم (نظام للتحكم في تشغيل نظام آخر)",
 "制御装置": "تحكم, وحدة تحكم (آلية تتحكم في تشغيل آلة) / محاسب, مراقب مالي (شخص يقوم بمسك وتدقيق الحسابات التجارية) / ضابط, متحكم (شخص يوجه ويضبط)\nمثال: وحدة التحكم في السرعة في مشغل الأسطوانات لم تكن تعمل بشكل صحيح",
 "制御言語": "لغة الأوامر, لغة الاستعلام (لغة مصدر تتكون من مشغلات إجرائية تستدعي وظائف ليتم تنفيذها)",
 "制御遺伝子": "جين تنظيمي (جين ينتج مادة كابتة تمنع الجين المشغل)",
 "制御部": "تحكم, وحدة تحكم (آلية تتحكم في تشغيل آلة) / محاسب, مراقب مالي (شخص يقوم بمسك وتدقيق الحسابات التجارية) / ضابط, متحكم (شخص يوجه ويضبط)\nمثال: وحدة التحكم في السرعة في مشغل الأسطوانات لم تكن تعمل بشكل صحيح",
 "制御領域": "كالسيوم (عنصر فلزي أبيض يحترق بضوء ساطع؛ خامس أكثر العناصر وفرة في القشرة الأرضية)",
 "制服": "زَيّ, زِي\nمثال: 私たちの学校では制服を着る。 — نحن ترتدي الزي الرسمي في مدرستنا.",
 "制止": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "制気口": "ناشر ضوء (جهاز بصري يوزع ضوء المصباح بالتساوي) / ناشر الصوت (حاجز يوزع الموجات الصوتية بالتساوي)",
 "制汗剤": "مضاد للتعرق (مادة قابضة توضع على الجلد لتقليل التعرق)",
 "制汗性": "مضاد للتعرق (مادة قابضة توضع على الجلد لتقليل التعرق)",
 "制球": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "制球力": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "制癌": "مضاد للأورام, مضاد للسرطان (يستخدم في علاج السرطان)\nمثال: دواء مضاد للسرطان",
 "制空権": "تفوق جوي",
 "制約": "تحديد, تقييد (فعل الحد أو التقييد (كما هو الحال عن طريق التنظيم)) / قصور, محدودية (صفة كون الشيء محدودًا أو مقيدًا) / تحديد, حصر (مبدأ يحد من مدى شيء ما) / حد, قيد (أكبر قدر ممكن أو مسموح به من شيء ما)\nمثال: إنها خطة جيدة لكن لها محدوديات خطيرة",
 "制約条件": "متطلب",
 "制肘": "تقييد, كبح (فعل السيطرة عن طريق تقييد شخص ما أو شيء ما) / رادع, قيد (جهاز يؤخر حركة شيء ما) / بساطة, تقشف فني (الخلو من الزخرفة) / تحفظ, كبح (الانضباط في الأنشطة الشخصية والاجتماعية)\nمثال: التقييد غير القانوني للتجارة",
 "制腐剤": "مُعَقِّمٌ",
 "制裁": "عِقَاب, إِسْتِحْسَان (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "制覇": "فَتْح, اِسْتِيلَاء (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين)\nمثال: فتح الباب آليا. / انتصار, فوز (النجاح بعد صعوبة كبيرة) / أَخَّاذ, خَلَّاب (بالغ الجاذبيّة؛ يستولي على الاهتمام) / فَائِز, مُنْتَصِر (حقق الفوز أو الانتصار)\nمثال: الفوز ليس كل شيء",
 "制輪子": "حذاء المكبح, قماش الفرامل (قيد يتم توفيره عندما يتم تحريك بطانات الفرامل هيدروليكياً ضد أسطوانة الفرامل لإبطاء دوران العجلة)",
 "制酸薬": "عامل قلوي, مضاد للحموضة (عامل يقاوم أو يعادل الحموضة (خاصة في المعدة))",
 "制限": "تَقْيِيد, اِقْتِصَار / قَيْد",
 "制限なし": "لَا يَنْضَب, لَا يُسْتَنْفَد (لَا يُمْكِنُ اسْتِهْلَاكُهُ أَوِ اسْتِنْفَادُهُ بِالكَامِلِ) / بلا حدود, غير محدود (ليس له حدود في المدى أو النطاق) / صَرِيح, مُطْلَق (بلا تحفّظ أو استثناء)\nمثال: البدء بنظرية الحرية غير المحدودة هو الانتهاء باستبداد غير محدود",
 "制限事項": "تَقْيِيد, اِقْتِصَار / قَيْد",
 "制限付き": "مَحْدُود",
 "制限戦争": "حرب محدودة (حرب هدفها أقل من الهزيمة غير المشروطة للعدو)",
 "制限時間": "حد زمني, مهلة (فترة زمنية يجب خلالها إنجاز شيء ما أو إكماله)",
 "制限用法": "تَقْيِيدِيّ",
 "制限速度": "حَدّ اَلسُّرْعَة اَلْأُقْصَى, حَدّ اَلسُّرْعَة (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "制限酵素": "إنزيم الاقتطاع, إنزيم القصر (أي من الإنزيمات التي تقطع الحمض النووي في مواقع اقتطاع محددة وتنتج شظايا اقتطاع؛ يتم الحصول عليها من البكتيريا (حيث تعطل الغزاة الفيروسيين)؛ تُستخدم…)",
 "刷": "طِبَاعَة",
 "刷く": "تلطيخ, رسم رديء (لوحة غير متقنة) / بقعة, تلطخ (عيب ناتج عن الأوساخ) / طيانة, ملاط طيني (مادة تستخدم لطلاء الجدران بالطين)\nمثال: كانت هناك لطخة على خده",
 "刷り": "طِبَاعَة",
 "刷りなおす": "طبعة منفصلة, مُستَلّة (مقال مطبوع بشكل منفصل ظهر أصلاً في منشور أكبر) / إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "刷り出す": "طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة!",
 "刷り損なう": "خطأ مطبعي, هفوة مطبعية (خطأ في المادة المطبوعة ناتج عن أعطال ميكانيكية من نوع ما)",
 "刷り直す": "طبعة منفصلة, مُستَلّة (مقال مطبوع بشكل منفصل ظهر أصلاً في منشور أكبر) / إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "刷り込み": "تطبّع, دمغ (عملية تعلم في مرحلة مبكرة من الحياة يتم بموجبها تأسيس أنماط سلوك خاصة بالنوع)",
 "刷り込む": "طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة! / بصمة, طبعة (أثر أو علامة تنتج عن الضغط على سطح ما) / أثر, بصمة (تأثير مميز) / بصمة, نقش بارز (انطباع ناتج عن الضغط أو الطباعة) / بصمة الناشر, بيان النشر (تعريف للناشر؛ اسم الناشر مع التاريخ والعنوان والطبعة المطبوعة في أسفل صفحة العنوان)\nمثال: لا تزال اللغة الإنجليزية تحمل بصمة الغزو النورماندي",
 "刷り違い": "خطأ مطبعي, هفوة مطبعية (خطأ في المادة المطبوعة ناتج عن أعطال ميكانيكية من نوع ما)",
 "刷る": "طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة!",
 "刷子": "فُرْشَاة / فَرَشَ / مَشَّطَ (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "刷新": "إِصْلَاح",
 "刷毛": "فُرْشَاة / فَرَشَ / مَشَّطَ (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "刷毛箒": "مِكْنَسَة صغيرة, مِكْنَسَة يدوية (مكنسة صغيرة ذات مقبض قصير تستخدم لتنظيف الملابس)",
 "刷込む": "طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة! / بصمة, طبعة (أثر أو علامة تنتج عن الضغط على سطح ما) / أثر, بصمة (تأثير مميز) / بصمة, نقش بارز (انطباع ناتج عن الضغط أو الطباعة) / بصمة الناشر, بيان النشر (تعريف للناشر؛ اسم الناشر مع التاريخ والعنوان والطبعة المطبوعة في أسفل صفحة العنوان)\nمثال: لا تزال اللغة الإنجليزية تحمل بصمة الغزو النورماندي",
 "券": "تَذْكِرَة / تذكرة",
 "券売所": "شباك التذاكر (المكتب الذي تباع فيه تذاكر الدخول)",
 "券文": "رباط, وصلة تثبيت (وصلة تثبت الأشياء ببعضها البعض) / صفد, قيد (قيد يحد أو يقيد الحرية (خاصة شيء يستخدم لربط أو تقييد سجين)) / التصاق, تلاصق (خاصية الالتصاق معاً (كالغراء والخشب) أو انضمام أسطح مختلفة التكوين) / رابطة, رابطة كيميائية (قوة كهربائية تربط الذرات)\nمثال: الالتصاق المتبادل للخلايا",
 "券面": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "券面額": "قيمة ظاهرية (القيمة الظاهرة مقابل القيمة الحقيقية) / قيمة اسمية (قيمة الورقة المالية التي تحددها الشركة المصدرة لها؛ ولا علاقة لها بالقيمة السوقية)",
 "刹": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع",
 "刹帝利": "كشاتريا (عضو في الطبقة الهندوسية الملكية أو المحاربة)",
 "刹那": "عَزْم / لَحْظَة, دَقِيقَة",
 "刹那的": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا) / كائن سريع الزوال (أي شيء قصير العمر، مثل حشرة تعيش ليوم واحد فقط في شكلها المجنح)",
 "刹鬼": "شَيْطَان, شيطان ((في الأديان الإبراهيمية) الرُّوح الشِّرِّير الَّذِي يَرْمِي بِكَ لِلتَّهْلُكَةِ لِبُعْدِهِ عَنِ الْخَيْرِ وَطَرِيقِ الْحَقِّ؛ (استعمال مجازي) كُلّ وَلَدٍ مُشَاكِسٍ أَوْ مُتَمَرِّدٍ)\nمثال: العجلة من الشيطان. / زوال, عدم الدوام (خاصية عدم الوجود لمدد طويلة غير محددة)",
 "刺": "بصمة, علامة مميزة (خاصية أو سلوك مميز) / بِطَاقَة زِيَارَة (تحية مطبوعة أو مكتوبة تترك للإشارة إلى أنك قمت بزيارة) / بطاقة هاتف (بطاقة تستخدم بدلاً من النقد لإجراء مكالمات هاتفية)\nمثال: القنابل هي بصمات الإرهابيين / أَسَلَة / شَوْكَة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم)\nمثال: هناك شوكة ناقصة. / شَظِيَّة",
 "刺々": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة عند الضغط على الوتر) / تعشيق هندسي, مفتاح إغريقي (نمط زخرفي يتكون من خطوط عمودية وأفقية متكررة (غالباً بشكل بارز)) / موضع تآكل (بقعة تآكلت بفعل الاحتكاك أو التعرية) / غمة, قلق (هياج ناتج عن قلق نشط)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران / بحدة, بعدوانية (بطريقة عدوانية) / بشكل حاد, بوضوح (بطريقة محددة بوضوح) / بشكل حاد, بشكل مفاجئ (بشكل مفاجئ جداً وبدرجة كبيرة) / بحدة, بزاوية حادة (تغير مفاجئ في الاتجاه والدرجة)\nمثال: كانت تُستجوب بحدة",
 "刺々しい": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة. / حَادّ الذُّرْوَة, مُدَبَّب النَّبْرَة (ذو نقاط عالية النبرة بشكل خاصّ أو كأنَّه كذلك)",
 "刺さる": "زُبّ, زُبْر (في : اللحية أو مقدمها؛ في : الأنف) / حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور.",
 "刺し": "سَاشِيمِي / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / جارِح, طاعِن (يُسَبِّب جِراحًا أو ألَمًا حادًّا)",
