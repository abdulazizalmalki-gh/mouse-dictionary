 "切り落し": "قُلَامَة",
 "切り落す": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "切り落とし": "قُلَامَة",
 "切り落とす": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "切り裂きジャック": "جَاك اَلسَّفَّاح",
 "切り裂く": "مُقَطَّعٌ إِلَى قِطَع (مقسَّم إلى قطع)",
 "切り解く": "أَطْلَقَ سَرَاح, حَرَّرَ",
 "切り詰め": "تقشف, تقليص النفقات (تخفيض النفقات من أجل الاستقرار المالي) / تحصين داخلي (خندق يتكون من تحصين داخلي إضافي لإطالة أمد الدفاع)",
 "切り詰める": "قَصَّرَ (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب. / قَلَّلَ",
 "切り調える": "شَذَّبَ, قَلَّمَ",
 "切り貼り": "ترقيع (فعل إصلاح ثقب في ثوب بخياطة رقعة عليه)",
 "切り賃": "بيت وساطة, شركة وساطة (المكان الذي يدير فيه الوسيط أعماله) / سمسرة, وساطة (عمل السمسار؛ يتقاضى رسوماً لترتيب عقد بين طرفين) / شركة سمسرة, شركة وساطة مالية (أعمال سمسار الأوراق المالية؛ تتقاضى رسوماً للعمل كوسيط بين البائع والمشتري)",
 "切り身": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "切り込み": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح. / مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "切り込み炭": "عَادِيّ, غَيْر مُمَيَّز (ليس مميزاً بأي شكل؛ يفتقر للتميز)",
 "切り込む": "مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "切り返し": "هجوم مضاد ((شطرنج) هجوم يهدف إلى مواجهة ميزة الخصم في جزء آخر من الرقعة) / هجوم مضاد (هجوم من قبل قوة مدافعة ضد قوة عدو مهاجمة لاستعادة أرض مفقودة أو قطع وحدات العدو المتقدمة)",
 "切り返す": "هجوم مضاد ((شطرنج) هجوم يهدف إلى مواجهة ميزة الخصم في جزء آخر من الرقعة) / هجوم مضاد (هجوم من قبل قوة مدافعة ضد قوة عدو مهاجمة لاستعادة أرض مفقودة أو قطع وحدات العدو المتقدمة) / معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "切り通し": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة",
 "切り進む": "شَقَّ, فَسَخَ ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو أشَقُّ، وهي شَقَّاءُ)\nمثال: اكشف عن الشق العلوي من الجسم.",
 "切り釘": "مسمار صغير (مسمار صغير)",
 "切り開き": "ترويق, تصفية (فعل إزالة الجزيئات الصلبة من سائل) / تبرئة (فعل التحرير من الشكوك) / فُرْجَة, فُسْحَة (قطعة أرض بها عدد قليل من الأشجار أو خالية منها تقع وسط منطقة حرجية)",
 "切り開く": "شَفَّاف / وَاضِح",
 "切り除ける": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "切り離す": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "切る": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح. / جَذَبَ, قَطَعَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: استعملت ريمة لجذب الانتباه. / عَلَّقَ / أَغْلَقَ الْخَطّ (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح)\nمثال: أغلق الباب بغضب / لَكْمَة / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة) / خَرَّامَة\nمثال: لكم اشتقت إليك!",
 "切れ": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / قُمَاش, أقمشة (النسيج الذي لم يُقَصّ أو يُخَاط) / مِمْسَحَة\nمثال: الورق و القماش يمتصان الماء. / حدة, خشونة (قسوة في الأسلوب) / تَمَايُز, حِدَّة (صفة كون الشيء حاداً وواضحاً) / حدة (رقة الحافة أو دقة الطرف) / حدة (صفة الشعور بالشيء بحدة وألم شديد)\nمثال: حدة خسارتها / خفة الحركة, مرونة (رشاقة شخص أو حيوان سريع وخفيف الحركة)",
 "切れが悪い": "سَمِيك, غَلِيظ / غَلِيظ",
 "切れっぱし": "قمامة, نفايات الطعام (طعام يتم التخلص منه (كما هو الحال من المطبخ))",
 "切れっ処": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "切れっ戸": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "切れっ端": "قمامة, نفايات الطعام (طعام يتم التخلص منه (كما هو الحال من المطبخ))",
 "切れはし": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "切れる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / نَفِدَ / نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته. / منحنى",
 "切れ切れ": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / مُبَعْثَر, مُشَوَّش (يفتقر إلى الاستمرارية المنظمة) / غَيْر مُوَصَّل, مَفْصُول (غير موصول بمصدر للطاقة) / ستاكاتو, متقطع ((موسيقى) يتميز بـ أو يتألف من أجزاء أو أصوات غير متصلة؛ مقطوعة بحدة) / مُتَقَطِّع, مُفَاجِئ (يتميز بتحولات مفاجئة في الموضوع وانتقالات حادة)\nمثال: تصفيق متقطع",
 "切れ口": "قِسْم, جُزْء (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَقْطَع\nمثال: أنا أزين القسم.",
 "切れ味": "حدة, خشونة (قسوة في الأسلوب) / تَمَايُز, حِدَّة (صفة كون الشيء حاداً وواضحاً) / حدة (رقة الحافة أو دقة الطرف) / حدة (صفة الشعور بالشيء بحدة وألم شديد)\nمثال: حدة خسارتها / سرعة (معدل سريع) / سرعة بديهة, سرعة ذهنية (الذكاء كما يكشف عنه القدرة على تقديم إجابات صحيحة دون تأخير) / براعة, حذق (أداء ماهر أو قدرة دون صعوبة)\nمثال: براعته السريعة كانت نتاج تصميم جيد / نشاط, همة (حيوية وطاقة)\nمثال: هذا المنشط مضمون لإعطائك مزيداً من النشاط",
 "切れ地": "قُمَاش, نَسِيج (النسيج الذي لم يُقَصّ أو يُخَاط)\nمثال: الورق و القماش يمتصان الماء.",
 "切れ物": "أدوات الأكل, أدوات المائدة القاطعة (أدوات المائدة لتقطيع وتناول الطعام) / أداة قطع, قاطعة (أداة للقطع)",
 "切れ痔": "بَاسُور",
 "切れ目": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية / تَوَقَّفَ / تَوَقُّف, وَقْف / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح. / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "切れ目のない": "سَلِس, مُتَنَاغِم (متسق ومتماسك تماماً بلا انقطاع) / بِلَا تَجَاعِيد, بِلَا خُطُوط (أملس وناعم خاصّة في وصف البشرة) / سلس, غير موصول بدرزة (ليس لديه درزة أو غير متصل بدرزات)\nمثال: جوارب بدون درزات",
 "切れ目を入れる": "إِصَابَة (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى) / دَرَجَة\nمثال: تعرض زيري لإصابة.",
 "切れ端": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "切れ込み": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "切れ間": "فَاصِل / مُدَّة, فَتْرَة / مَسَافَة",
 "切上げる": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "切上げ機能": "تَقْرِيب",
 "切倒す": "إسقاط, صرع (فعل إسقاط شيء ما (كشجرة)) / قَاسٍ, هَمَجِيّ ((عن الأشخاص أو أفعالهم) قادر على إلحاق الألم أو المعاناة أو مُيّال لذلك) / ثنية, درزة مسطحة (درزة تُصنع عن طريق ثني المواد الموصولة تحت بعضها أو طيها معاً وخياطتها لتجنب الحواف الخشنة) / إهاب, جلد مدبوغ (جلد الحيوان (وخاصة الحيوانات الكبيرة) بعد معالجته)",
 "切傷": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "切先": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "切処": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "切刃": "مَقْبَض",
 "切分法": "تزامن موسيقي, سينكوب (موسيقى (خاصة موسيقى الرقص) ذات إيقاع متزامن (منزاح النبر)) / ترخيم, سنكبة (إيقاع موسيقي يشدد على نبرة عادة ما تكون ضعيفة) / ترخيم, حذف ((علم الأصوات) فقدان الأصوات من داخل الكلمة)",
 "切切": "شَغُوف, مُتَحَمِّس / مُؤَثِّر, مُبَكٍّ (يثير المشاعر والعواطف)",
 "切削": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة",
 "切削工具": "أداة قطع, قاطعة (أداة للقطع)",
 "切割る": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "切取り": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة / سَطْو / لُصُوصِيَّة",
 "切取り線": "خط منقط (خط مكون من نقاط أو شرطات؛ يستخدم غالباً للإشارة إلى المكان الذي يجب التوقيع فيه على عقد (أو مستندات أخرى))\nمثال: فقط وقع على الخط المنقط",
 "切取線": "خط منقط (خط مكون من نقاط أو شرطات؛ يستخدم غالباً للإشارة إلى المكان الذي يجب التوقيع فيه على عقد (أو مستندات أخرى))\nمثال: فقط وقع على الخط المنقط",
 "切口": "قِسْم, جُزْء (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَقْطَع\nمثال: أنا أزين القسم. / وِجْهَة نَظَر, حَيْثِيَّة / وِجْهَة نَظَر",
 "切味": "حدة, خشونة (قسوة في الأسلوب) / تَمَايُز, حِدَّة (صفة كون الشيء حاداً وواضحاً) / حدة (رقة الحافة أو دقة الطرف) / حدة (صفة الشعور بالشيء بحدة وألم شديد)\nمثال: حدة خسارتها / سرعة (معدل سريع) / سرعة بديهة, سرعة ذهنية (الذكاء كما يكشف عنه القدرة على تقديم إجابات صحيحة دون تأخير) / براعة, حذق (أداء ماهر أو قدرة دون صعوبة)\nمثال: براعته السريعة كانت نتاج تصميم جيد / نشاط, همة (حيوية وطاقة)\nمثال: هذا المنشط مضمون لإعطائك مزيداً من النشاط",
 "切回し": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "切回す": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "切土": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة",
 "切地": "قُمَاش, نَسِيج (النسيج الذي لم يُقَصّ أو يُخَاط)\nمثال: الورق و القماش يمتصان الماء.",
 "切妻": "جملون (الجدار المثلث العمودي بين الأطراف المائلة لسقف الجملون)",
 "切子": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / جَانِب\nمثال: هناك ثقوب على السطح.",
 "切子ガラス": "زجاج محفور (زجاج مزخرف بقطع أو طحن جوانبه)",
 "切実": "جَدِّي, جَادّ / عَرْبُون / ضغط, كبس (فعل الضغط؛ بذل الضغط) / عَاجِل, مُلِحّ (يَسْتَوْجِبُ إِجْرَاءً فَوْرِيًّا) / قطعة مضغوطة (جزء معدني أو بلاستيكي مصنوع بواسطة مكبس ميكانيكي)\nمثال: ضغط على الزر / مُنَاسِب تَمَامًا, وَثِيق الصِّلَة (بالغ الملاءمة والصلة بالموضوع بشكل لافت) / فِي صَمِيمِ الْمَوْضُوعِ (ذو صلة دقيقة أو منطقية بالمسألة المطروحة)",
 "切店": "مِن الطَّبَقَة الدُّنْيَا (يحتل أدنى مكانة اجتماعية واقتصادية في المجتمع)",
 "切張り": "ترقيع (فعل إصلاح ثقب في ثوب بخياطة رقعة عليه)",
 "切戸": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "切戻し": "تقليم (عملية تشذيب النبات) / قُلامَة (ما تم تقليمه وقصه من النبات)",
 "切手": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "切手収集": "جمع الطوابع, فيلاتلي (جمع ودراسة الطوابع البريدية)",
 "切手収集家": "جامع طوابع, هاوي طوابع (جامع ودارس للطوابع البريدية)",
 "切手帳": "ألبوم طوابع (ألبوم للطوابع)",
 "切手蒐集": "جمع الطوابع, فيلاتلي (جمع ودراسة الطوابع البريدية)",
 "切手集め": "جمع الطوابع, فيلاتلي (جمع ودراسة الطوابع البريدية)",
 "切払う": "أَجَاص / عَوِينَة / عَوِينَة مُجَفَّفَة / خَوْخ مُجَفَّف / شَذَبَ, قَضَبَ",
 "切抜き": "قُلَامَة / مِشْبَك / كْلِيبْ",
 "切抜き細工": "جزء مقتطع, قُصاصة (جزء تم قصه أو المقصود قصه) / صورة مفرغة (صورة فوتوغرافية تم قص الخلفية منها) / قاطع تيار (مفتاح يقطع الدائرة الكهربائية في حالة الحمل الزائد)",
 "切抜く": "مَقْصُوص, مُقْتَطَع (تم قصه واستخراجه)",
 "切抜ける": "هَزَمَ, غَلَبَ",
 "切捨て": "تَضْحِيَة, قُرْبَان / ضَحَّى / إِغْفَال",
 "切捨てる": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا! / تخلص, رمي (التخلص من شيء يعتبر عديم الفائدة أو غير مرغوب فيه) / إلقاء الورق, طرح الورق ((في أوراق اللعب) فعل رمي بطاقة عديمة الفائدة) / شيء متروك, مُهملات (أي شيء يتم طرحه جانباً أو التخلص منه) / قَتَلَ, أَزْهَقَ رُوحَهُ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "切接ぎ": "لصقة, وصلة (نقطة اتصال حيث يتم ضم شيئين (مثل الورق أو الفيلم أو الشريط المغناطيسي) معاً)\nمثال: كان الانقطاع بسبب وصلة غير متقنة / تَطْعِيم (زرع غصن من نوع من الشجر على غصن من نوع آخر، مثلا زرع غصن من البرتقال في شجرة ليمون لتكون النتيجة أن شجرة الليمون تنتج ليمونا وبرتقالا؛ علاج طبي يستهدف إلى منع الأمراض التي تتسبب من الجراثيم أو الفيروسات. استخدام حديث)",
 "切換": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "切換え": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "切断": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة",
 "切断患者": "أَبْتَر, أَقْطَع ((أَبْتَرَه) بَتَرَه؛ (أَبْتَرَ) الله فلَاناً: أعقَمَه)",
 "切断機": "أداة قطع, قاطعة (أداة للقطع) / قارب قاطع, كتر (سفينة شراعية بصارية واحدة مثبتة في الخلف أكثر من صارية السلوب) / قارب توصيل, قارب خدمات (قارب للتواصل بين السفينة والشاطئ) / قاطع, قصاص (شخص عمله القص (مثل قص القماش للملابس))",
 "切断面": "قِسْم, جُزْء (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَقْطَع\nمثال: أنا أزين القسم.",
 "切替": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "切替え": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "切望": "شَوْق (نزوعُ النَّفْس إِلى الشيء، أو تَعَلُّقها به؛ مصدر الفعل شَاقَ)\nمثال: سأشعر بالشوق إليك.",
