 "乳飲み子": "حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / حَبِيبِي, عَزِيزِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي",
 "乳首": "حَلَمَة",
 "乳香": "لُبَان",
 "乾": "جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما. / باتجاه الشمال الغربي (إلى أو باتجاه أو في الشمال الغربي) / شَمَال غَرْبِيّ (يقع في الشمال الغربي أو موجَّه نحوه) / قَادِم مِنَ الشَّمَال الغَرْبِيّ (قادم من اتجاه الشمال الغربي) / شمال غرب (موقع في الجزء الشمالي الغربي من بلد أو منطقة أو مدينة)",
 "乾いた": "جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما.",
 "乾かす": "جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما.",
 "乾き": "جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما.",
 "乾し": "جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما.",
 "乾し肉": "قَدِيد",
 "乾し魚": "سمك مجفف (سمك محفوظ بشقه وتجفيفه بالهواء دون ملح)",
 "乾す": "هَوَاء (خَلِيط من الغَازَات يغلف الكرة الأرضية؛ فَارِغ) / جَوّ / نَغَم\nمثال: أخرجي الهواء من فمك. / بَالُوعَة",
 "乾せん": "صَدَفِيَّة",
 "乾る": "جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما. / انحسار, جزر (التدفق الخارجي للمد) / انحسار, تضاؤل (انخفاض تدريجي (في الحجم أو القوة أو السلطة أو العدد))",
 "乾ドック": "حوض جاف (حوض كبير يمكن ضخ المياه منه؛ يستخدم لبناء السفن أو لإصلاح السفينة أسفل خط الماء)",
 "乾パン": "مفرقعة حفلات (هدية حفلات تتكون من لفافة ورقية (تحتوي عادة على حلوى أو هدية صغيرة) تنفجر عند سحبها من كلا الطرفين) / مفرقعة, مفرقعة نارية (لعبة نارية تتكون من شحنة متفجرة صغيرة وفتيل داخل غلاف ورقي سميك) / بسكويت مملح, رقاقة مقرمشة (رقاقة رقيقة مقرمشة مصنوعة من الدقيق والماء مع أو بدون تخمير ودهن؛ غير محلاة أو شبه محلاة) / كراكر, مخترق خبيث (مبرمج يخترق الحواسيب (وصول غير مصرح به)، عادة للقيام بأمور خبيثة)\nمثال: غالباً ما يطلق على الكراكرز اسم هاكرز عن طريق الخطأ",
 "乾位": "باتجاه الشمال الغربي (إلى أو باتجاه أو في الشمال الغربي) / شَمَال غَرْبِيّ (يقع في الشمال الغربي أو موجَّه نحوه) / قَادِم مِنَ الشَّمَال الغَرْبِيّ (قادم من اتجاه الشمال الغربي) / شمال غرب (موقع في الجزء الشمالي الغربي من بلد أو منطقة أو مدينة)",
 "乾児": "ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب.",
 "乾分": "ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب.",
 "乾坤": "كَوْن, الْكَوْن",
 "乾季": "موسم الجفاف (أحد الموسمين في المناخات الاستوائية، فترة سنوية يقل فيها هطول الأمطار في المناطق الاستوائية)",
 "乾干し": "مُجَفَّف بِالشَّمْس (مُجَفَّف طَبِيعِيًّا بِأَشِعَّة الشَّمْس)",
 "乾式": "جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما.",
 "乾性": "جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما.",
 "乾性油": "زيت جاف (زيت يتصلب في الهواء بسبب الأكسدة ويُستخدم غالباً كأساس للطلاء أو الورنيش)",
 "乾所帯": "مُعْدَم, مُعْوِز (فقير لدرجة الحاجة إلى مساعدة الآخرين)",
 "乾期": "موسم الجفاف (أحد الموسمين في المناخات الاستوائية، فترة سنوية يقل فيها هطول الأمطار في المناطق الاستوائية)",
 "乾杯": "انشراح, بشاشة (صفة كون المرء مبتهجاً وطارداً للكآبة) / هتاف (صرخة أو صيحة استحسان)\nمثال: أضافت الزهور لمسة من البهجة للغرفة الكئيبة / توست, خبز محمص (شرائح من الخبز تم تحميصها) / نخب (شرب نخب تكريماً لشخص أو حدث أو للصحة) / مُنْتَهٍ, هالِك (شخص في مأزق يائس؛ شخص محكوم عليه بالهلاك) / نجم المجتمع (مشهور يتلقى الكثير من الإشادة والاهتمام)\nمثال: سأكون هالكاً إذا لم تنجح هذه الخطة",
 "乾板": "لوح جاف (طريقة تصوير سابقة استخدمت لوحاً زجاجياً مطلياً بمستحلب جيلاتيني حساس للضوء)",
 "乾果": "فَوَاكِه مُجَفَّفَة",
 "乾湿計": "سيكرومتر, مقياس الرطوبة النفسي (مقياس رطوبة يتكون من مقياس حرارة جاف البصلة ومقياس حرارة رطب البصلة؛ يشير الفرق بينهما إلى جفاف الهواء المحيط)",
 "乾燥": "تجرد, عدم تحيز (الموضوعية والانفصال عن الهوى) / رصانة, صحو (الاعتدال في أو الامتناع عن الكحول أو المخدرات الأخرى) / جفاف, يبوسة (حالة عدم احتواء سائل أو عدم التغطية به (خاصة الماء))\nمثال: اتخذ أسلوبها تجرداً وجفافاً مختلفاً جداً عن نبرتها المعتادة / تفاهة, رتابة طعم (الافتقار إلى أي خاصية تذوق مميزة أو مثيرة للاهتمام) / رَتَابَة, سَآمَة (الملل الشديد؛ الافتقار إلى الروح أو الاهتمام)",
 "乾燥剤": "عامل تجفيف, مادة مجففة (مادة تعزز الجفاف (مثل أكسيد الكالسيوم الذي يمتص الماء ويستخدم لإزالة الرطوبة))",
 "乾燥味噌": "مُجَفَّف بِالتَّجْمِيد (مَحْفُوظ بِالتَّجْمِيد ثُمَّ التَّجْفِيف فِي الفَرَاغ) / مُجَفَّف تَجْمِيدِيًّا ((عَنِ الأَنْسِجَة أَوِ الدَّم أَوِ الأَمْصَال) مُجَفَّف بِالتَّجْمِيد فِي فَرَاغ عَالٍ)",
 "乾燥器": "مجفف (جهاز يقوم بإزالة الرطوبة)",
 "乾燥地": "بَرّ, يَابِسَة (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "乾燥季": "موسم الجفاف (أحد الموسمين في المناخات الاستوائية، فترة سنوية يقل فيها هطول الأمطار في المناطق الاستوائية)",
 "乾燥期": "موسم الجفاف (أحد الموسمين في المناخات الاستوائية، فترة سنوية يقل فيها هطول الأمطار في المناطق الاستوائية)",
 "乾燥果": "فَوَاكِه مُجَفَّفَة",
 "乾燥機": "مجفف (جهاز يقوم بإزالة الرطوبة)",
 "乾燥洗濯": "تَنْظِيف جَافّ",
 "乾燥無味": "تجرد, عدم تحيز (الموضوعية والانفصال عن الهوى) / رصانة, صحو (الاعتدال في أو الامتناع عن الكحول أو المخدرات الأخرى) / جفاف, يبوسة (حالة عدم احتواء سائل أو عدم التغطية به (خاصة الماء))\nمثال: اتخذ أسلوبها تجرداً وجفافاً مختلفاً جداً عن نبرتها المعتادة",
 "乾燥牛乳": "حليب بودرة, حليب مجفف (حليب منزوع الماء (مجفف))",
 "乾燥肉": "قَدِيد",
 "乾燥腐朽": "عفن جاف (فطر يسبب العفن الجاف) / عفن جاف (تفتت وجفاف للأخشاب أو البصلات أو البطاطس أو الفاكهة بسبب فطر)",
 "乾物": "بقالة, مواد غذائية (سلع استهلاكية تباع عند البقال) / بقالة, متجر بقالة (سوق تباع فيه مواد البقالة)\nمثال: تضمن متجر البقالة سوقاً للحوم",
 "乾物屋": "بِقَالَة, حَانُوت بَقَّال",
 "乾球温度計": "مقياس حرارة جاف البصلة (مقياس حرارة عادي ببصلة جافة؛ يستخدم لقياس درجة حرارة الهواء)",
 "乾生姜": "زنجبيل, مسحوق الزنجبيل (جذر الزنجبيل المجفف والمطحون)",
 "乾生植物": "نبات جفافي, نبات صحراوي (نبات متكيف للحياة مع إمدادات محدودة من الماء؛ قارنه بالنبات المائي والنبات الوسطي)",
 "乾癬": "صَدَفِيَّة",
 "乾皮症": "جفاف الجلد (شكل خفيف من السماك يتميز بجفاف وخشونة الجلد غير الطبيعيين)",
 "乾眠": "حياة خفية, كمون حياتي (حالة تتوقف فيها الأنشطة الأيضية للحيوان بشكل قابل للعكس)",
 "乾竹": "خيزران الخشب العملاق, ماداكي (خيزران كبير له سيقان سميكة الجدران؛ موطنه الصين وربما اليابان؛ يُزرع على نطاق واسع في أماكن أخرى)",
 "乾肉": "قَدِيد",
 "乾船渠": "حوض جاف (حوض كبير يمكن ضخ المياه منه؛ يستخدم لبناء السفن أو لإصلاح السفينة أسفل خط الماء)",
 "乾芻": "تِبْن, جَفِيف (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "乾草": "تِبْن, جَفِيف (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "乾蝕": "عفن جاف (فطر يسبب العفن الجاف) / عفن جاف (تفتت وجفاف للأخشاب أو البصلات أو البطاطس أو الفاكهة بسبب فطر)",
 "乾酪": "جُبْن, جبنة (جَبَنَ يَجْبُن وجَبُنَ جُبْنًا وجُبُنًا وجَبانةً)\nمثال: قل جبنة يا زيري.",
 "乾酪素": "طلاء الكازين (طلاء مائي مصنوع من بروتين مترسب من الحليب) / كازين (بروتين الحليب يُستخدم في صنع البلاستيك والمواد اللاصقة)",
 "乾雪": "ثلج جاف (نوع من الثلج يحتوي على القليل من الماء السائل أو لا يحتوي عليه على الإطلاق، ويكون أقل كثافة من المتوسط وغير لزج)\nمثال: التزلج في ظروف الثلج الجاف أو المسحوق يمكن أن يكون تحدياً",
 "乾電池": "بطارية جافة, خلية جافة (خلية ليكلانشيه صغيرة لا تحتوي على سائل حر؛ الإلكتروليت عبارة عن عجينة وقطب الزنك السالب يشكل حاوية الخلية)",
 "乾食": "عفن جاف (فطر يسبب العفن الجاف) / عفن جاف (تفتت وجفاف للأخشاب أو البصلات أو البطاطس أو الفاكهة بسبب فطر)",
 "乾魚": "سمك مجفف (سمك محفوظ بشقه وتجفيفه بالهواء دون ملح)",
 "乾麺麭": "بقسماط السفينة, خبز البحارة (بسكويت أو خبز صلب جداً غير مملح؛ كان غذاءً أساسياً في السفن قديماً) / ماهوجني الجبل (نوع من الماهوجني الجبلي)",
 "亀": "سُلَحْفَاة",
 "亀の子縛り": "إرساء, ربط السفينة (فعل تأمين سفينة واصلة بالحبال)",
 "亀の手": "بَرْنَقِيل",
 "亀の甲": "حلقة البنزين (سلسلة مغلقة من 6 ذرات كربون مع ذرات هيدروجين مرتبطة بها)",
 "亀中": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "亀井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "亀山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "亀島": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "亀田": "اسم مكان (الاسم الذي يُعرف به مكان جغرافي) / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "亀甲": "قط ذبل, قط كاليكو (قط ذو علامات سوداء وكريمية وصفراء) / فراشة صدفة السلحفاة (زاهية الألوان؛ تتغذى اليرقات على نبات القراص) / ذبل, صدفة السلحفاة (المادة القرنية المبقعة لصدفة بعض السلاحف)",
 "亀裂": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)",
 "亀鑑": "نُمُوذَج, نَمَط",
 "亀頭": "حَشَفَة",
 "亀頭冠": "إِكْلِيل الْحَشَفَة",
 "亀頭包皮炎": "التهاب الحشفة والقلفة (التهاب كل من رأس القضيب والقلفة)",
 "亀頭炎": "التهاب الحشفة (التهاب رأس القضيب)",
 "亀頭球": "عُقْدَة / عَقَدَ (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "了": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "了い": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / إنهاء, خاتمة (فعل إنهاء شيء ما) / خاتمة, نهاية (نهاية الكلمة (لاحقة أو نهاية تصريفية أو مورفيم نهائي)) / خاتمة, نهاية (القسم الأخير من اتصال ما) / إنهاء, ختام (حدث ينهي وقوعه شيئاً ما)\nمثال: إنهاء الاتفاقية",
 "了する": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "了察": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "了承": "إِقْرَار, اعْتِرَاف (بيان يقر بشيء أو بشخص ما) / إقرار, اعتراف (حالة أو صفة كونه معترفاً به أو مقدراً)\nمثال: لا بد أنها رأته لكنها لم تبد أي علامة إقرار بذلك",
 "了承済み": "مُعْتَرَف بِه, مُقَرّ بِه (تم التعرف عليه أو الإعلان عنه أو الإقرار به) / مُعْتَرَفٌ بِهِ (مقبول ومُسَلَّمٌ به عمومًا)\nمثال: القائد المعترف به للمجتمع",
 "了然": "بَدِيهِيّ, بَدَهِيّ",
 "了知": "مُطَّلِع, وَاسِعُ الثَّقَافَة (على درجة عالية من التعليم؛ ذو معلومات أو فهم واسع) / خَبِير, عَارِف (يدل على امتلاك معلومات داخلية أو سرية) / مُدْرِك, وَاسِعُ الِاطِّلَاع (يقظ ومُلِمّ إلمامًا تامًّا) / مَقْصُود, مُتَعَمَّد (يتّسم بالتصميم الواعي والغرض المحدد)",
 "了簡": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة. / حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية) / تقدير, حرية الإرادة (القدرة على اتخاذ خيارات حرة دون قيود خارجية) / تحفظ, تكتم (معرفة كيفية تجنب الإحراج أو الضيق) / رقة, كياسة (ذوق رفيع؛ لباقة في التصرف)\nمثال: رجل ذو فطنة / مَغْفِرَة, غُفْرَان",
 "了簡違い": "خِدَاع, ضَلَالَة / غَرُور",
 "了見": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة. / حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية) / تقدير, حرية الإرادة (القدرة على اتخاذ خيارات حرة دون قيود خارجية) / تحفظ, تكتم (معرفة كيفية تجنب الإحراج أو الضيق) / رقة, كياسة (ذوق رفيع؛ لباقة في التصرف)\nمثال: رجل ذو فطنة / مَغْفِرَة, غُفْرَان",
 "了見違い": "خِدَاع, ضَلَالَة / غَرُور",
 "了解": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "了解事項": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "了解済み": "مَقْبُول, مُعْتَرَف بِه (حائز على القبول العامّ أو يفرض الاعتراف)",
 "予": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "予々": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "予て": "قَبْلًا, قَبْل",
 "予てから": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "予てより": "قَبْلًا, قَبْل",
 "予め": "سلفاً, مسبقاً (قبل الوقت؛ تحسباً)\nمثال: عندما تدفع مقدماً تحصل على خصم",
 "予予": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "予備": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا. / تَحْضِير, إِعْدَاد",
 "予備兵": "جندي احتياط (عضو في قوات الاحتياط العسكرية)",
 "予備品": "رَحِمَ (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام)\nمثال: رحمة الله عليه.",
 "予備工作": "أَوَّلِيّ, تَمْهِيدِيّ (يدلّ على فعل أو حدث يسبق أو يُمهِّد لشيء أهمّ) / استهلال, تمهيد (شيء يعمل كحدث سابق أو يقدم ما يلي) / تصفيات أولية, مباراة تمهيدية (مباراة ثانوية تسبق الحدث الرئيسي)\nمثال: التدريب مقدمة ضرورية للتوظيف",
 "予備座席": "مقعد خلفي قابل للطي (مقعد خارجي قابل للطي في الجزء الخلفي من بعض السيارات القديمة)",
 "予備役将校訓練課程": "فيلق تدريب ضباط الاحتياط (برنامج تدريبي لإعداد طلاب الجامعات ليصبحوا ضباطًا مفوضين)",
 "予備校": "مدرسة إعدادية, مدرسة تحضيرية (مدرسة ثانوية خاصة)",
 "予備的": "أَوَّلِيّ, تَمْهِيدِيّ (يدلّ على فعل أو حدث يسبق أو يُمهِّد لشيء أهمّ) / استهلال, تمهيد (شيء يعمل كحدث سابق أو يقدم ما يلي) / تصفيات أولية, مباراة تمهيدية (مباراة ثانوية تسبق الحدث الرئيسي)\nمثال: التدريب مقدمة ضرورية للتوظيف",
 "予備知識": "خلفية, معلومات أساسية (معلومات ضرورية لفهم موقف أو مشكلة)\nمثال: أطلعته السفارة على خلفية الحادث",
 "予備装置": "رَحِمَ (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام)\nمثال: رحمة الله عليه.",
 "予備試験": "امتحان تمهيدي (امتحان يؤديه طلاب الدراسات العليا لتحديد أهليتهم للاستمرار)",
 "予備費": "حساب احتياطي, صندوق احتياطي (أموال مقتطعة من الأرباح لتوفير المدفوعات المستقبلية المتوقعة)",
 "予備軍": "قوات احتياط, ميليشيا (مدنيون مدربون كجنود ولكنهم ليسوا جزءًا من الجيش النظامي) / طامح, طامع (شاب طموح ومتطلع)\nمثال: طامح رفيع المستوى",
 "予備選": "أَوَّلِيّ",
 "予備選挙": "أَوَّلِيّ",
 "予備部品": "قِطْعَة غَيَار (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "予備金": "حساب احتياطي, صندوق احتياطي (أموال مقتطعة من الأرباح لتوفير المدفوعات المستقبلية المتوقعة)",
 "予兆": "فَأل, نَذِيْر",
 "予参": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "予告": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ / مَقْطُورَة / تَشْوِيقَة",
 "予告篇": "مَقْطُورَة / تَشْوِيقَة",
 "予告編": "مَقْطُورَة / تَشْوِيقَة",
 "予報": "تَنَبَّأَ / تَوَقُّع",
 "予定": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "予定外": "مُفَاجِئ",
 "予定日": "مَوْعِد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "予定案": "بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / بَرْمَجَ, وَضَعَ بَرْنَامَجًا / بَرْمَجَ\nمثال: نشط البرنامج الآن.",
 "予定死": "اسْتِماتَة",
 "予定表": "جَدْوَل, جَدْوَل أَعْمَال",
 "予定説": "تعيين مسبق, قدرية ((اللاهوت) التحديد مسبقاً؛ وخاصة المذهب (المرتبط عادة بكالفن) القائل بأن الله قد قضى بكل حدث عبر الأبدية (بما في ذلك الخلاص النهائي للبشرية)) / جبرية, قضاء وقدر (تحديد مسبق كما لو كان عن طريق القدر أو المصير)",
 "予定調和": "مُؤْتَمَر / مُعَاهَدَة, تَوَافُق (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / مُعَاهَدَة, مُقَاوَلَة (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / عُرْف (عَلِمَ؛ سَكَنَ إلى الشيءِ، أَنَسَهُ وأَلِفَه)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "予審": "امتحان تمهيدي (امتحان يؤديه طلاب الدراسات العليا لتحديد أهليتهم للاستمرار)",
 "予後": "تنبؤ بسير المرض, مآل المرض (التنبؤ بمسار المرض) / تنبؤ, توقعات (تنبؤ حول كيفية تطور شيء ما (مثل الطقس)) / تعافي, فترة النقاهة (الشفاء التدريجي (من خلال الراحة) بعد المرض أو الإصابة)",
 "予後判定": "تكهن, نبوءة (معرفة المستقبل (يُقال عادة أنه يتم الحصول عليها من مصدر إلهي)) / تنبؤ, توقع (بيان يصدر حول المستقبل) / بشير, فأل (علامة على شيء على وشك الحدوث)\nمثال: بحث عن فأل قبل الذهاب إلى المعركة",
 "予想": "أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / توقع رياضي, قيمة متوقعة (مجموع قيم متغير عشوائي مقسوماً على عدد القيم) / توقع (الشعور بأن شيئاً ما على وشك الحدوث) / ترقب, توقع (الترقب مع الثقة بالتحقق)",
 "予想以上": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض",
 "予想外": "مُفَاجِئ",
 "予想屋": "مُخبر المراهنات (شخص يبيع النصائح حول المقامرة أو المضاربة (خاصة في سباق الخيل))",
 "予想高": "تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء",
 "予感": "بشيرة سوء, نذير شؤم (شعور بقدوم شر)\nمثال: شعور متزايد بنذير شؤم",
 "予断": "تَنَبُّؤ",
 "予期": "أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / توقع رياضي, قيمة متوقعة (مجموع قيم متغير عشوائي مقسوماً على عدد القيم) / توقع (الشعور بأن شيئاً ما على وشك الحدوث) / ترقب, توقع (الترقب مع الثقة بالتحقق)",
 "予期しない": "مُفَاجِئ",
 "予期せぬ": "مُفَاجِئ",
 "予測": "تَنَبُّؤ",
 "予測不能": "غَيْرُ مُتَوَقَّع, غَيْرُ مُنْتَظَم (لَا يَحْدُثُ بِمُعَدَّلٍ مُنْتَظَمٍ أَوْ فَتَرَاتٍ ثَابِتَة) / غَيْرُ مُتَوَقَّع (غَيْرُ مَعْرُوفٍ مُسْبَقًا) / غير متوقع, لا يمكن التنبؤ به (لا يمكن التنبؤ به)",
 "予熱": "اِسْتَدْفَأَ / دَفَّأَ, أَدْفَأَ (دَفَّأَ الَجريحَ: أَدْفَأَهُ)",
 "予知": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / استشراف, بصيرة (الرؤية المسبقة؛ المعرفة مسبقاً)",
 "予知能力": "تنبؤ, معرفة مسبقة (معرفة حدث قبل وقوعه)",
 "予稿": "مُلَخَّص, حاصِل / مَعْنَوِيّ, تَجْرِيدِيّ",
 "予等": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "予算": "تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء",
 "予算カット": "خفْض الميزانية (عملية تقليل النفقات المدرجة في الميزانية)",
 "予算上": "مالي, ميزاني (من أو يتعلق بالميزانية)\nمثال: اعتبارات الميزانية",
 "予算不足": "عجز الميزانية (زيادة النفقات على الإيرادات)",
 "予算削減": "خفْض الميزانية (عملية تقليل النفقات المدرجة في الميزانية)",
 "予算化": "مِيزَانِيَّة, مُوَازَنَة",
 "予約": "حَجْز (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا. / عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد. / بَرْمَجَة (فِي : هي عملية كتابة تعليمات وتوجيه أوامر لجهاز الحَاسُوبِ أو أي جهاز آخر مثل قارئات أقراص الدي في دي أو أجهزة استقبال الصوت والصورة في نظم الاتصالات…؛ اسم لفظي للفعل بَرْمَجَ)\nمثال: تسمح لغة البرمجة بكتابة البرامج الحاسوبية.",
 "予約受付": "حَجْز (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "予約待ちリスト": "قَائِمَة اَلْاِنْتِظَار",
 "予約済み": "مَحْجُوز",
 "予約者": "وكيل حجز (شخص يتعاقد مع شخص أو شركة لتقديم عروض)",
 "予約購読": "اِشْتِرَاك",
 "予約金": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "予納": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "予行": "بَرُوفَة",
 "予行演習": "بروفة, تدريب (جلسة تدريب تحضيراً لأداء عام (كمسرحية أو خطاب أو حفلة موسيقية))\nمثال: فوت الكثير من البروفات",
 "予行練習": "بروفة, تدريب (جلسة تدريب تحضيراً لأداء عام (كمسرحية أو خطاب أو حفلة موسيقية))\nمثال: فوت الكثير من البروفات",
 "予表": "تَمْهِيدِيّ, مُنْبِئ بِشَكْل غَامِض (نبوئيّ بشكل غامض وغير واضح) / إرهاص, تلميح مسبق (فعل تقديم مؤشرات غامضة مسبقة؛ التمثيل مسبقاً)",
 "予見": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / استشراف, بصيرة (الرؤية المسبقة؛ المعرفة مسبقاً)",
 "予覚": "تحَدُّب (عملية ثني نفسك في وضعية محدبة) / حدس, شعور غريزي (انطباع بأن شيئًا ما قد يكون هو الحال)\nمثال: كان لديه حدس بأن شيئًا ما قد حدث بشكل خاطئ",
 "予言": "تَنَبُّؤ / نُبُوءَة, تَنَبُّؤ / وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها.",
 "予言者": "نَبِيّ, نَبِيء (و من النبوة النبي لأنه أشرف خلق الله؛ ما إرتفع عن الأرض) / مُتَنَبِّئ, نَبِيء\nمثال: إلياس نبي من عند الله.",
 "予診": "سِيرَة مَرْضِيَة",
 "予謀": "سبق الإصرار والترصّد (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك.",
 "予輩": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "予選": "مُحَاكَمَة (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري. / فحص تحري, فرز (اختبار الأشياء أو الأشخاص لتحديد أولئك الذين لديهم خصائص معينة) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / شبكة غربلة, قماش شبكي (قماش من شبكة معدنية أو بلاستيكية) / عرض, عرض سينمائي (عرض صورة متحركة (فيلم))\nمثال: أخفى الغطاء بنادقهم عن طائرات العدو",
 "予選会": "أَوَّلِيّ, تَمْهِيدِيّ (يدلّ على فعل أو حدث يسبق أو يُمهِّد لشيء أهمّ) / استهلال, تمهيد (شيء يعمل كحدث سابق أو يقدم ما يلي) / تصفيات أولية, مباراة تمهيدية (مباراة ثانوية تسبق الحدث الرئيسي)\nمثال: التدريب مقدمة ضرورية للتوظيف",
 "予選通過": "مُؤَهِّل",
 "予選通過者": "مُقَيِّدٌ",
 "予鈴": "جرس الإنذار, ناقوس الخطر (جرس يستخدم لإطلاق إنذار)",
 "予防": "مَنْع (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "予防医学": "طب وقائي (فرع الطب المعني بالوقاية من الأمراض)\nمثال: المؤسسة الطبية لا تربح من الطب الوقائي",
 "予防医療": "طب وقائي (فرع الطب المعني بالوقاية من الأمراض)\nمثال: المؤسسة الطبية لا تربح من الطب الوقائي",
 "予防接種": "تَطْعِيم, تَلْقِيح (زرع غصن من نوع من الشجر على غصن من نوع آخر، مثلا زرع غصن من البرتقال في شجرة ليمون لتكون النتيجة أن شجرة الليمون تنتج ليمونا وبرتقالا؛ علاج طبي يستهدف إلى منع الأمراض التي تتسبب من الجراثيم أو الفيروسات. استخدام حديث)",
 "予防措置": "احتراز, تدبير وقائي (إجراء وقائي لدرء خطر وشيك أو ضرر أو إصابة) / احتراز, وقاية (سمة ممارسة الحذر مسبقاً) / احتراس, تروي (التعقل في تجنب الضرر أو الخطر)\nمثال: وضع كيس ثلج على الإصابة كإجراء وقائي",
 "予防攻撃": "ضربة وقائية, هجوم وقائي (ضربة تُنفذ من أجل ردع عدوان متوقع من قبل قوات معادية)",
 "予防注射": "تمنيع",
 "予防的": "اِحْتِرَازِيّ / رَدْعِيّ / وِقَائِيّ",
 "予防線": "إجراء دفاعي, دفاع (عمل عسكري أو موارد تحمي دولة ضد أعداء محتملين)\nمثال: ماتوا في الدفاع عن ستالينغراد / احتراز, تدبير وقائي (إجراء وقائي لدرء خطر وشيك أو ضرر أو إصابة) / احتراز, وقاية (سمة ممارسة الحذر مسبقاً) / احتراس, تروي (التعقل في تجنب الضرر أو الخطر)\nمثال: وضع كيس ثلج على الإصابة كإجراء وقائي",
 "予防薬": "اِحْتِرَازِيّ",
 "予饌会": "تَوْدِيع, حَفْل وَدَاع (تعبير منظم عن حسن النية عند بدء رحلة أو مشروع جديد) / انطلاق, ضربة البداية (بداية تعطى للمتسابقين)\nمثال: كنت هناك مع والدي عند الانطلاق",
 "争い": "عَارَكَ, قَاتَلَ / تَعَارَكَ, تَقَاتَلَ / نَاضَلَ, كَافَحَ / قِتَال (من قَتَلَ: كثير القَتْل) / مَعْرَكَة\nمثال: لن يحل القتال أي شيء. / مُنَافَسَة, مُبَارَاة / مُنَافَسَة, مُسَابَقَة",
 "争いごと": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول)\nمثال: شمال مالي منطقة نزاع.",
 "争い事": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول)\nمثال: شمال مالي منطقة نزاع.",
 "争い好き": "كَثِيرُ الخِصَام, مُشَاكِس (مَيَّالٌ إِلَى المُشَاجَرَةِ وَالخِصَام)",
 "争い訴える": "اِتَّهَمَ",
 "争う": "تَنَافَسَ, تَبَارَى\nمثال: １０チームが賞を得ようと争った。 — تنافس عشر فرق على الجائزة. / نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع. / نَفَى",
 "争うべからざる": "أَكِيد, لَا جِدَال فِيه (يستحيل الشكّ فيه أو الاعتراض عليه) / لَا جِدَال فِيه, لَا يُنَازَع (لَا يَقْبَلُ الطَّعْنَ أَوِ الشَّكّ؛ صَحِيحٌ بِوُضُوح)",
 "争えない": "أَكِيد, لَا جِدَال فِيه (يستحيل الشكّ فيه أو الاعتراض عليه) / لَا جِدَال فِيه, لَا يُنَازَع (لَا يَقْبَلُ الطَّعْنَ أَوِ الشَّكّ؛ صَحِيحٌ بِوُضُوح)",
 "争で": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "争われない": "أَكِيد, لَا جِدَال فِيه (يستحيل الشكّ فيه أو الاعتراض عليه) / لَا جِدَال فِيه, لَا يُنَازَع (لَا يَقْبَلُ الطَّعْنَ أَوِ الشَّكّ؛ صَحِيحٌ بِوُضُوح)",
 "争乱": "صِرَاع, نِزَاع",
 "争奪": "كِفَاح, نِضَال / كافح, جَاهَدَ",
 "争奪戦": "مُسَابَقَة",
 "争訟": "جدل, سجال (فعل كلامي جدلي؛ نزاع حيث يوجد اختلاف قوي في الرأي)\nمثال: انخرطوا في جدال عنيف",
 "争論": "جِدَال, مُجَادَلَة (مراء يتعلق بإظهار المذاهب وتقريرها، ذكره ابن الكمال (التوقيف)؛ فنّ الجِدال: ( والتصوف) ضربٌ خادعٌ من المناقشة أساسه استعمال الحجج السُّفسطائيّة…) / وَسِيط\nمثال: لا جدال في ذلك.",
 "争議": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول)\nمثال: شمال مالي منطقة نزاع.",
 "争議団": "ضارب, مطرقة (الجزء من جهاز ميكانيكي الذي يضرب شيئاً ما) / ضارب (شخص يضرب) / مُضرِب (موظف مضرب عن العمل ضد صاحب العمل) / متدرب بحري (شخص يتلقى تدريباً مكثفاً للحصول على تصنيف فني بحري)\nمثال: ضارب قوي",
 "争議行為": "عَمَل مُبَاشِر (عمل احتجاجي تقوم به مجموعات عمالية أو أقليات للحصول على مطالبهم)",
 "争闘": "فِتْنَة",
 "事": "شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما. / حَادِث, حَادِثَة / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة / عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل.",
 "事々": "كُلّ شَيْء",
 "事々しい": "طَنَّان, مُنْتَفِخ (مُتعالٍ ومُتكلَّف في الأسلوب بشكل استعراضي)",
 "事々物々": "كُلّ شَيْء",
 "事える": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "事がない": "هُنَاكَ, يُوجَدُ",
 "事ども": "أشياء, حوائج (أي حيازة منقولة (خاصة الملابس))\nمثال: حزمت أغراضها وغادرت",
 "事なく": "بهدوء, دون حوادث (بطريقة خالية من الأحداث)\nمثال: هبط مكوك الفضاء بهدوء",
 "事にすると": "رُبَّمَا / مِن اَلْمُمْكِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / لَعَلَّ (يفيد التوقع مع الترجي؛ يفيد التوقع مع الإشفاق والخوف)\nمثال: يا لها من جملة!",
 "事によって": "بِوَاسِطَة, عَن طَرِيق / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)",
 "事により": "بِجَانِب, جنب (بجانب) / عِنْدَ, فِي (يُفِيدُ الحضور أو وجود صلة أو علاقة مثل الانتماء والامتلاك. (ظرف مكان)؛ يُفِيدُ قُرْبَ الشيء. (ظرف مكان)) / مِن قِبَل, بِوَاسِطَّة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / بِوَاسِطَّة, لِـ\nمثال: زيري بجانب الحوض.",
 "事による": "بِسَبَب, مِنْ جَرَّاء",
 "事によると": "رُبَّمَا, لَعَلَّ (عن طريق الصدفة (أو الاحتمال)) / بِأَيّ حَال, بِإِمْكَان (إلى درجة يمكن تحقيقها أو بوسائل ممكنة)\nمثال: ربما ستتصل غداً",
 "事の次第": "أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "事の発端": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "事はない": "هُنَاكَ, يُوجَدُ",
 "事もなげに": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية) / بِشَكْل عَرَضِيّ, غَيْر مَنْهَجِيّ (ليس بشكل منهجي أو وفقاً لخطة)\nمثال: ألقى نظرة غير مبالية على العناوين",
 "事も無げに": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية) / بِشَكْل عَرَضِيّ, غَيْر مَنْهَجِيّ (ليس بشكل منهجي أو وفقاً لخطة)\nمثال: ألقى نظرة غير مبالية على العناوين",
 "事をなす": "شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز.",
 "事を成す": "شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز.",
 "事を運ぶ": "اِنْطَلَقَ / اِنْبَثَق",
 "事事": "كُلّ شَيْء",
 "事事しい": "طَنَّان, مُنْتَفِخ (مُتعالٍ ومُتكلَّف في الأسلوب بشكل استعراضي)",
 "事事物物": "كُلّ شَيْء",
 "事件": "وَاقِعَة, حَادِثَة (مؤنث الوَاقِع، اسم فاعل للشيء المؤنث الذي وَقَعَ؛ مؤنث وَاقِع، الأمر المؤنث الحاصل)\nمثال: الصخور الواقعة تشكل خطرا على المتسلقين.",
 "事件屋": "ميثادون (عقار مخدر صناعي مشابه للمورفين ولكنه أقل تسبباً في التعود؛ يستخدم في إزالة السموم من المخدرات والحفاظ على علاج إدمان الهيروين) / وسيط نفوذ (شخص يتدخل لدى السلطات لصالح شخص في ورطة (عادة باستخدام أساليب ملتوية أو غير قانونية مقابل رسوم)) / مرمّم, مصلّح (عامل ماهر يصلح أو يرمم الأشياء) / عامل تثبيت, مثبت (مركب كيميائي يقوم بتثبيت شيء ما (مثل الصبغة أو الصورة الفوتوغرافية))",
 "事件性": "إجرام (حالة كون الشخص مجرماً)",
 "事件表": "برنامج زمني, جدول أعمال (خطة منظمة زمنياً للأمور التي يجب الاهتمام بها) / سجل القضايا ((قانون) تقويم المحكمة؛ قائمة القضايا التي ستتم محاكمتها أو ملخص لأنشطة المحكمة)",
 "事例": "مِثَال, مَثَل / مِثَال",
 "事例研究": "دراسة حالة (تحليل مفصل لشخص أو مجموعة من وجهة نظر اجتماعية أو نفسية أو طبية) / دراسة حالة (دراسة دقيقة لوحدة اجتماعية (مثل شركة أو قسم داخل شركة) تحاول تحديد العوامل التي أدت إلى نجاحها أو فشلها)",
 "事例研究法": "دراسة حالة (تحليل مفصل لشخص أو مجموعة من وجهة نظر اجتماعية أو نفسية أو طبية) / دراسة حالة (دراسة دقيقة لوحدة اجتماعية (مثل شركة أو قسم داخل شركة) تحاول تحديد العوامل التي أدت إلى نجاحها أو فشلها)",
 "事例紹介": "دراسة حالة (تحليل مفصل لشخص أو مجموعة من وجهة نظر اجتماعية أو نفسية أو طبية) / دراسة حالة (دراسة دقيقة لوحدة اجتماعية (مثل شركة أو قسم داخل شركة) تحاول تحديد العوامل التي أدت إلى نجاحها أو فشلها)",
 "事共": "أشياء, حوائج (أي حيازة منقولة (خاصة الملابس))\nمثال: حزمت أغراضها وغادرت",
 "事典": "مَوْسُوعَة, دَائِرَة مَعَارِف (مُعْجَمٌ ضَخْمٌ يَضُمُّ مَعْلُومَاتٍ وَافِيَةً ومُرَكَّزَةً عَنِ الْمَعَارِفِ الإِنْسَانِيَّةِ مُرَتَّبَةً تَرْتِيباً أَبَجَدِيّاً أَوْ حَسَبَ…)\nمثال: موسوعة رحلات العرب والمسلمين.",
 "事切れる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "事前": "رئيس الدير (رئيس رهبنة دينية؛ في الدير يكون أقل رتبة من الأباتي)",
 "事前分布": "رئيس الدير (رئيس رهبنة دينية؛ في الدير يكون أقل رتبة من الأباتي)",
 "事前後": "بعد ذلك, فيما بعد (يحدث في وقت لاحق لوقت مرجعي)\nمثال: اعتذر لاحقاً",
 "事前従犯": "شريك قبل الواقعة (شخص يدبر أو ينصح أو يأمر بارتكاب جناية ولكنه لا يكون حاضراً عند ارتكابها)",
 "事前従犯人": "شريك قبل الواقعة (شخص يدبر أو ينصح أو يأمر بارتكاب جناية ولكنه لا يكون حاضراً عند ارتكابها)",
 "事前払い": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "事前支払い": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "事前条件": "شرط مسبق (شرط يعتبر متطلباً أساسياً) / مُسلّمة, مُعطى (افتراض يؤخذ كأمر مسلم به) / شرط, شرط مسبق (افتراض تعتمد عليه صحة أو تأثير شيء آخر)",
 "事務": "إِدَارَة, مُرَاقَبَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة) / إِدَارَة تَنْفِيذِيَّة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "事務処理": "أَوْرَاق",
 "事務員": "مُوَظَّف / مُوَظَّفَة",
 "事務官": "بيروقراطي, مسؤول إداري (مسؤول في بيروقراطية)",
 "事務室": "مَهَمَّة",
 "事務家": "رجل أعمال (رجل يعمل في الأعمال التجارية أو الصناعية)",
 "事務局": "أمانة عامة, سكرتارية (وحدة إدارية مسؤولة عن حفظ السجلات والواجبات الكتابية الأخرى؛ خاصة للمنظمات الدولية)",
 "事務局長": "مدير تنفيذي, مسؤول تنفيذي (شخص مسؤول عن إدارة عمل تجاري)",
 "事務屋": "مُوَظَّف / مُوَظَّفَة",
 "事務弁護士": "محامي استشاري (محامٍ بريطاني يقدم المشورة القانونية ويعد الوثائق القانونية) / جامع تبرعات, مستجدي (ملتمس يطلب مساهمات أو تجارة أو أصوات)",
 "事務引き継ぎ": "تولي, خلافة (اكتساب الممتلكات عن طريق النسب أو الوصية)",
 "事務所": "مَهَمَّة",
 "事務方": "موظفو المكتب (العاملون المهنيون أو المكتبيون في مكتب)\nمثال: تأخر المكتب بأكمله في صباح العاصفة الثلجية",
 "事務服": "ملابس عمل (ملابس تلبس للقيام بعمل يدوي)",
 "事務次官": "وكيل وزارة (وزير يتبع مباشرة رئيس قسم حكومي)",
 "事務用品": "قِرْطَاسِيَّة",
 "事務的": "إداري (متعلق بالإدارة أو مسؤول عنها) / غَيْر شَخْصِيّ, مُحَايِد (لا تفضيل شخصيّ لديه) / عام, غير شخصي (لا يتعلق بالأشخاص الفرديين أو لا يستجيب لهم)\nمثال: شركة غير شخصية",
