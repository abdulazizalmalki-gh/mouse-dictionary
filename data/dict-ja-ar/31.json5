 "些々": "تضييع الوقت, عبث (الفعل المتعمد للتأخير واللعب بدلاً من العمل) / زَهِيد, ضَئِيل (لَا يَسْتَحِقُّ الاِعْتِبَار)",
 "些か": "قَلِيلًا",
 "些事": "تفاهة, شيء تافه (شيء قليل الأهمية) / أمر تافه, تفاهة (تفصيل يعتبر غير مهم) / ترافل (بودينغ بارد مصنوع من طبقات من الكعك الاسفنجي المدهون بالفاكهة أو الجيلي؛ وقد يُزين بالمكسرات أو الكريمة أو الشوكولاتة)",
 "些些": "تضييع الوقت, عبث (الفعل المتعمد للتأخير واللعب بدلاً من العمل) / زَهِيد, ضَئِيل (لَا يَسْتَحِقُّ الاِعْتِبَار)",
 "些少": "تضييع الوقت, عبث (الفعل المتعمد للتأخير واللعب بدلاً من العمل) / زَهِيد, ضَئِيل (لَا يَسْتَحِقُّ الاِعْتِبَار)",
 "些末": "تافِه",
 "些細": "تافِه",
 "亜": "مُتَوَسِّط, مِنَ الدَّرَجَة الثَّانِيَة (متوسط إلى رديء في الجودة) / ـِيّ / آسِيَا, أسيا (إحدى القارات السبع؛ أكبرها مساحةً، وأكثرها سكانًا)\nمثال: على شعوب آسيا أن تتعاون. / الْأَرْجَنْتِين, الأرجنتين",
 "亜セレン酸": "حمض السيلينيوز (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: حمض السيلينيوز مشابه لحمض الكبريتوز، لكنه يعزل بسهولة أكبر (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)",
 "亜ヒ酸": "ثلاثي أكسيد الزرنيخ, زرنيخ (مسحوق أبيض سام من ثلاثي أكسيد الزرنيخ؛ يستخدم في صناعة الزجاج وكمبيد للآفات (سم الفئران) ومبيد للأعشاب)",
 "亜リン酸": "حمض الهيبوفوسفوروز (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "亜人": "دُونَ المُسْتَوَى البَشَرِيّ (غَيْرُ صَالِحٍ لِلْبَشَرِ) / أقل من البشر, دون المستوى البشري (أقل من البشر أو لا يليق بالإنسان)\nمثال: عامل السكان الأصليين كأنهم دون البشر / أرجنتيني (من أو يتعلق بالأرجنتين أو شعبها أو يميزهم) / أرجنتيني (مواطن أو ساكن في الأرجنتين)\nمثال: تانغو أرجنتيني / أَمْرِيكِيّ, أَمْرِيكِيَّة",
 "亜低木": "جنبة, شجيرة فرعية (شجيرة خشبية منخفضة النمو أو نبات معمر بقاعدة خشبية)",
 "亜原子粒子": "جُسَيْم (جسم له كتلة محدودة وهيكل داخلي ولكن أبعاده ضئيلة)",
 "亜国": "الْأَرْجَنْتِين, الأرجنتين",
 "亜城": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "亜塩素酸": "حمض الكلوروز (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "亜多良": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "亜大陸": "شِبْه قارَة",
 "亜媽港": "مَاكَاوْ, أَوْمِين",
 "亜属": "جنس فرعي, جنيس ((في الأحياء) مجموعة تصنيفية بين الجنس والنوع)",
 "亜州": "آسِيَا, أسيا (إحدى القارات السبع؛ أكبرها مساحةً، وأكثرها سكانًا)\nمثال: على شعوب آسيا أن تتعاون.",
 "亜急性": "تَحْت حَادّ, شِبْه حَادّ (أقلّ حِدّة من الحادّ؛ يتعلّق بمرض موجود لدى شخص بلا أعراض ظاهرة)",
 "亜急性硬化性全脳炎": "التهاب الدماغ المصلب تحت الحاد (التهاب دماغ مزمن نادر ومترقٍ يسببه فيروس الحصبة ويحدث بشكل أساسي عند الأطفال والشباب؛ تحدث الوفاة عادة في غضون ثلاث سنوات)",
 "亜族": "زمرة جزئية (مجموعة جزئية (غير خالية) من زمرة رياضية) / مجموعة فرعية (مجموعة مميزة وغالباً ما تكون تابعة داخل مجموعة)",
 "亜東関係協会": "شَرْق آسِيَا (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت)\nمثال: تشرق الشمس من الشرق.",
 "亜桜": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "亜欧": "أُورَاسِيَا",
 "亜流": "مُحَاكٍ, مُقَلِّد (شخص ينسخ كلمات أو سلوك شخص آخر) / منتحل شخصية (شخص ينتحل (عن طريق الاحتيال) مظهر شخص آخر) / تَابِع / مُتَابِع",
 "亜炭": "فحم بني",
 "亜熱帯": "المنطقة شبه الاستوائية (المناطق المتاخمة للمناطق الاستوائية)",
 "亜熱帯高圧帯": "عروض الخيل (أي من الحزامين أو المنطقتين بالقرب من 30 درجة شمالاً أو 30 درجة جنوباً؛ تتميز بهدوء ورياح خفيفة محيرة)",
 "亜燐酸": "حمض الهيبوفوسفوروز (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "亜界": "عويلم, مملكة فرعية ((في الأحياء) مجموعة تصنيفية تشكل قسماً رئيسياً من المملكة)",
 "亜目": "رتيبة ((في الأحياء) مجموعة تصنيفية تعد قسماً فرعياً من الرتبة)",
 "亜砒酸": "ثلاثي أكسيد الزرنيخ, زرنيخ (مسحوق أبيض سام من ثلاثي أكسيد الزرنيخ؛ يستخدم في صناعة الزجاج وكمبيد للآفات (سم الفئران) ومبيد للأعشاب)",
 "亜硝酸": "حمض النيتروز (حمض غير عضوي غير مستقر يُعرف فقط في المحلول وكأملاح النتريت)",
 "亜硝酸アミル": "نترات الأميل (موسع للأوعية الدموية يستخدم أحياناً لعلاج الذبحة الصدرية)",
 "亜硝酸ナトリウム": "نيتريت الصوديوم (نيتريت يستخدم لحفظ وتلوين الطعام خاصة في منتجات اللحوم والأسماك؛ متورط في تكوين مواد مسرطنة مشتبه بها)",
 "亜硝酸塩": "نيتريت",
 "亜硫酸ガス": "ثاني أكسيد الكبريت",
 "亜科": "أسرة, فصيلة فرعية ((في الأحياء) فئة تصنيفية تحت الفصيلة)",
 "亜種": "نُوَيْع",
 "亜空間": "فضاء جزئي (فضاء محتوى داخل فضاء آخر)",
 "亜節": "شعبة, قسم فرعي (قسم من قسم؛ جزء من جزء؛ أي جزء من شيء مقسم بالفعل)",
 "亜米利加鷲木菟": "بومة قرناء كبيرة (بومة قرناء بنية من أمريكا الشمالية)",
 "亜細亜": "آسِيَا, أسيا (إحدى القارات السبع؛ أكبرها مساحةً، وأكثرها سكانًا)",
 "亜綱": "طويئفة ((في الأحياء) فئة تصنيفية تحت الطائفة وفوق الرتبة)",
 "亜群": "زمرة جزئية (مجموعة جزئية (غير خالية) من زمرة رياضية) / مجموعة فرعية (مجموعة مميزة وغالباً ما تكون تابعة داخل مجموعة)",
 "亜脱臼": "خلع جزئي (إزاحة جزئية لمفصل أو عضو)",
 "亜酸化窒素": "أكسيد النيتروز, غاز الضحك (مخدر استنشاقي يستخدم كمخدر في طب الأسنان والجراحة)",
 "亜鈴": "دُمْبِل",
 "亜鉛": "خَارَصِين / تُوتِيَاء / زِنْك",
 "亜鉛凸版": "لوحة تظليل, نقش ضوئي (نقش يستخدم لإعادة إنتاج رسم توضيحي)",
 "亜鉛華": "أبيض الزنك, أبيض صيني (خضاب أبيض يستخدم في دهانات المنازل؛ يتكون من أكسيد الزنك)",
 "亜鉛華軟膏": "أكسيد الخارصين, أكسيد الزنك (أكسيد الزنك؛ مسحوق أبيض يستخدم كصبغة أو في مستحضرات التجميل أو الزجاج أو الأحبار وفي مرهم الزنك)",
 "亜鉛鉄": "حديد مجلفن (حديد مطلي بالزنك لحمايته من الصدأ)",
 "亜門": "شعيبة ((في الأحياء) مجموعة تصنيفية تقع بين الشعبة والطائفة)",
 "亜麻": "كَتّان",
 "亜麻仁": "بذور الكتان (بذرة الكتان المستخدمة كمصدر للزيت)",
 "亜麻仁油": "زيت بذر الكتان (زيت جاف يُستخرج من بذور الكتان ويُستخدم في صنع أشياء مثل الدهانات الزيتية)",
 "亜麻川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "亜麻布": "كَتَّان",
 "亜麻織物": "كَتَّان",
 "亜麻色": "بِيج",
 "亜麻製": "أَشْقَر رَمْلِيّ, كَتَّانِيّ (بلون شعر أصفر باهت إلى بني مصفر)",
 "亡": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / مُتَأَخِّر / مَرْحُوم / مُتَأَخِّرًا",
 "亡い": "مَيِّت",
 "亡き": "مَيِّت مَيْت, مُتَوَفًّى / مَرْحُوم",
 "亡き人": "مَيِّت مَيْت, مُتَوَفًّى / مَرْحُوم",
 "亡き者": "راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "亡き者にする": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "亡き骸": "جُثَّة, جُثْمَان (جسد إنسان ميت) / بقايا أثرية, لقى أثرية (أثر تم استخراجه من التربة عن طريق التنقيب) / بقايا (أي شيء يترك غير مستخدم أو لا يزال موجوداً)\nمثال: كانت الجثة مخصصة للتشريح",
 "亡き魂": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "亡くす": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته.",
 "亡くなす": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته.",
 "亡くなる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "亡びる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "亡ぶ": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "亡ぼす": "دَمَّرَ",
 "亡八": "يُوحَنَّا, يَحْيَى ((في المسيحية) أي من شخصيات الكتاب المقدس الذين تسموا بهذا الاسم، وأشهرهم: \"يُوحَنَّا الْمَعْمَدَان\"، و\"يُوحَنَّا الْإِنْجِيلِيّ\"…؛ (في المسيحية) إنجيل يوحنا، آخر الأناجيل القانونية الأربع) / إِنْجِيل يُوحَنَّا\nمثال: توم وماريا قالو ليوحنا, أنهم لا يعتقدون أن تكون ايلكا في الأسفل. / بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "亡卒": "هَارِب / مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر",
 "亡命": "انشقاق, خذلان (سحب الدعم أو المساعدة رغم الولاء أو المسؤولية) / انشقاق, تخلي (حالة نبذ المعتقدات الدينية أو الحزب السياسي أو قضية ما (غالباً لصالح معتقدات أو قضايا معارضة))\nمثال: تخليه عن زوجته وأطفاله تركهم مفلسين",
 "亡命希望者": "طَالِب لُجُوء, طَالِبَة لُجُوء",
 "亡命者": "لَاجِئ, لَاجِئَة",
 "亡失": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة",
 "亡状": "إساءة, فظاظة (نقص في التهذيب؛ الفشل في إظهار الاحترام للآخرين؛ جرح مشاعر الآخرين) / فجاجة, قلة أدب (أسلوب وقح ومهين) / قِلَّة احْتِرَام, وَقَاحَة (تعبير عن عدم الاحترام)",
 "亡者": "مَيِّت",
 "亡霊": "شَبَح, خَيَال",
 "亡骸": "جُثَّة, جُثْمَان (جسد إنسان ميت) / بقايا أثرية, لقى أثرية (أثر تم استخراجه من التربة عن طريق التنقيب) / بقايا (أي شيء يترك غير مستخدم أو لا يزال موجوداً)\nمثال: كانت الجثة مخصصة للتشريح",
 "亡魂": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "亢進": "اِنْتِفَاضَة, تَمَرُّد (معارضة منظمة للسلطة؛ صراع يحاول فيه فصيل انتزاع السيطرة من آخر) / بَازِغ, صَاعِد (برز حديثاً إلى الواجهة) / صَاعِد, نَاشِئ (يَبْلُغُ مَرْحَلَةَ النُّضْج) / طَالِع, مُنْحَدِرٌ صُعُودًا (مَائِلٌ نَحْوَ الأَعْلَى)",
 "交": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية. / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "交々": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب",
 "交える": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح. / تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ / صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "交し合う": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "交じり合う": "خَلَط (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "交じる": "فَائِدَة",
 "交ず": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "交ぜる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "交ぜ合せる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "交ぜ合わせる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "交わし合う": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "交わす": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ / تَقَاطَعَ",
 "交わり": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب. / جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس. / مُفْتَرَق, تَقَاطُع / تَقَاطُع",
 "交わる": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق. / جَامَعَ, ضَاجَعَ (اسم فاعل من الفعل جَمَعَ، الذي قام بالجَمع؛ قِدرٌ جامع: عظيمة. الجمع جُمْع)\nمثال: في أي جامعة تدرس؟",
 "交互": "متبادل (للأوراق والفروع ونحوها؛ تظهر أولاً على جانب ثم على الآخر في صفين على طول المحور؛ غير مزدوجة) / بَدِيل (يُستخدَم أو يَخدُم مكان شيء آخر) / بَدِيل, عِوَض (شخص يأخذ مكان شخص آخر)\nمثال: سيقان بأوراق متبادلة",
 "交互に": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب",
 "交互作用": "تَآثُر, تَفَاعُل / مُخَالَطَة, تَفَاعُل",
 "交互計算": "حساب مفتوح (طلب ائتماني غير مدفوع) / حساب ائتماني, حساب جاري مدين (ائتمان تمنحه شركة لعميل)",
 "交交": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب",
 "交付": "تَوْصِيل, تَسْلِيم / مَخَاض, وَضْع / إِلْقَاء (إِلْقَاءُ الشَّبَكَةِ فِي البَحْرِ : رَمْيُها؛ إِلْقاءُ مُحَاضَرَةٍ : إعْطَاؤُهُا، أَي الحَدِيثُ فِي مَوْضُوعٍ أَمَامَ جَمْهُورٍ)\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "交付者": "مُسَلِّم, مُوَصِّل (شخص يسلم أو ينقل أموالاً أو بضائع) / عامل توصيل, موصل طلبات (شخص يعمل لتوصيل الطلبات) / مُخَلِّص, مُنقِذ (شخص ينقذك من الأذى أو الخطر)",
 "交付金": "إِعَانَة مَالِيَّة",
 "交代": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "交代で": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب",
 "交代員": "نَوْبَة",
 "交代投手": "رامي الإغاثة, رامٍ بديل (رامٍ لا يبدأ المباراة بل يدخل كبديل)",
 "交代選手": "إحلال, استبدال (عملية وضع شيء أو شخص مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر)\nمثال: استبدال الدم المفقود بنقل دم المتبرع",
 "交信": "اتصالات سلكية ولاسلكية (فرع الهندسة الكهربائية المعني بتكنولوجيا الاتصالات الإلكترونية عن بعد) / اتصالات, اتصالات عن بعد ((غالباً بصيغة الجمع) الأنظمة المستخدمة في نقل الرسائل عبر مسافات إلكترونياً)",
 "交叉": "مَعْبَر (مكان العُبُور؛ مَعْبَر رَفَح: نقطة العبور الحدودية بين أراضي قطاع غَزَّة ومِصْر يقع عند مدينة رَفَح في غزة) / تصالب, عبور (تبادل الأجزاء بين الكروموسومات المتماثلة المقترنة أثناء الطور الأول من الانقسام المنصف)",
 "交叉路": "مُفْتَرَق, تَقَاطُع / تَقَاطُع",
 "交友": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "交合": "اقتران, تزاوج (عملية اقتران الذكر والأنثى لأغراض التكاثر)\nمثال: الاقتران العرضي للمراهقين",
 "交声曲": "أوراتوريو, كانتاتا (تأليف موسيقي للأصوات والأوركسترا مبني على نص ديني)",
 "交婚": "زواج الأقارب, زواج داخلي (الزواج داخل قبيلة أو مجموعة المرء كما يقتضي العرف أو القانون) / زواج خارجي, زواج مختلط (الزواج من شخص ينتمي إلى قبيلة أو مجموعة أخرى غير مجموعتك كما يقتضي العرف أو القانون)",
 "交媾": "اقتران, تزاوج (عملية اقتران الذكر والأنثى لأغراض التكاثر)\nمثال: الاقتران العرضي للمراهقين",
 "交宜": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "交尾": "مُضَاجَعَة, جِمَاع",
 "交尾む": "جَامَعَ, ضَاجَعَ (اسم فاعل من الفعل جَمَعَ، الذي قام بالجَمع؛ قِدرٌ جامع: عظيمة. الجمع جُمْع)\nمثال: في أي جامعة تدرس؟",
 "交尾期": "موسم التزاوج, موسم التكاثر (موسم التكاثر هو الموسم الأنسب، وعادة ما يكون بظروف مواتية ووفرة في الغذاء والماء، للتكاثر)",
 "交差": "مَعْبَر (مكان العُبُور؛ مَعْبَر رَفَح: نقطة العبور الحدودية بين أراضي قطاع غَزَّة ومِصْر يقع عند مدينة رَفَح في غزة) / تصالب, عبور (تبادل الأجزاء بين الكروموسومات المتماثلة المقترنة أثناء الطور الأول من الانقسام المنصف)",
 "交差点": "مَعْبَر (مكان العُبُور؛ مَعْبَر رَفَح: نقطة العبور الحدودية بين أراضي قطاع غَزَّة ومِصْر يقع عند مدينة رَفَح في غزة)",
 "交差路": "مُفْتَرَق, تَقَاطُع / تَقَاطُع",
 "交情": "أُلْفَة",
 "交感": "تَنَاغُم, وِئَام (علاقة تفاهم متبادل أو ثقة واتفاق بين الناس)",
 "交感神経系": "الجهاز العصبي السمبثاوي, الجهاز العصبي الودي (ينشأ في المناطق الصدرية من الحبل الشوكي؛ يعارض التأثيرات الفسيولوجية للجهاز الودي: يقلل من الإفرازات الهضمية؛ يسرع القلب؛ يقبض الأوعية الدموية)",
 "交戦": "حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / مُحَارَبَة / حرب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / حَارَبَ, شَنَّ حَرْبًا\nمثال: بوتين مجرم حرب.",
 "交戦国": "عُدْوَانِيّ, مُحَارِب (يتَّسم بطابع العداء أو التوق للقتال) / فِي حَالَةِ حَرْب, مُتَحَارِب (مُنْخَرِطٌ فِي الحَرْب) / محارب, مقاتل (شخص يقاتل (أو في حالة قتال))",
 "交戦者": "مُقَاتِل (مُقاتِل: اسم مذكر يجمع : يجمع جمعا سالما على مُقاتِلون وجمع تكسير على مُقاتِلة واسم فاعل من قَاتَل) / عُدْوَانِيّ, مُحَارِب (يتَّسم بطابع العداء أو التوق للقتال) / فِي حَالَةِ حَرْب, مُتَحَارِب (مُنْخَرِطٌ فِي الحَرْب) / محارب, مقاتل (شخص يقاتل (أو في حالة قتال))",
 "交接": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس. / مُضَاجَعَة, جِمَاع",
 "交換": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "交換レート": "سِعْر صَرْف (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: إتفقوا على سعر.",
 "交換可能": "قابل للاستبدال, قابل للتحويل (قادر على أن يتم استبداله أو مقايضته بشيء ذي قيمة مساوية) / قابل للاستبدال (مناسب للاستبدال) / قَابِلٌ لِلتَّبَادُلِ, مُعَيَّرٌ (يمكن أن يحل محل شيء آخر أو يتبادل معه دون فقدان الوظيفة)\nمثال: أوراق مالية قابلة للتحويل",
 "交換台": "لوحة مفاتيح, مقسم (مركز هاتف حيث يتم إكمال الدوائر بأسلاك التوصيل) / عامل هاتف, مأمور مقسم (شخص يساعد المتصلين في الوصول إلى الشخص الذي يتصلون به)",
 "交換品": "استبدال, مقايضة (عنصر من الممتلكات يتم تقديمه كجزء من الدفع مقابل عنصر جديد) / اِسْتَبْدَلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "交換器": "لوحة مفاتيح, مقسم (مركز هاتف حيث يتم إكمال الدوائر بأسلاك التوصيل)",
 "交換型": "مِقْلَاد",
 "交換嬢": "عامل هاتف, مأمور مقسم (شخص يساعد المتصلين في الوصول إلى الشخص الذي يتصلون به)",
 "交換子": "مبدل كهربائي (مفتاح لعكس اتجاه التيار الكهربائي)",
 "交換局": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "交換所": "غرفة المقاصة (مكان مركزي للتجميع حيث تتبادل البنوك الشيكات أو الحوالات؛ ويحتفظ المشاركون بحساب يتم فيه تسجيل الدائن والمدين) / تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "交換手": "داهية, محتال ذكي (شخص ذكي أو عديم المبادئ يعرف كيفية التحايل على الصعوبات لتحقيق أهدافه) / عامل تشغيل, مُشَغِّل (وكيل يقوم بتشغيل جهاز أو آلة) / مُشغِّل (شخص يمتلك أو يدير عملاً تجارياً) / مشغل, مضارب محترف (مضارب يتداول بقوة في أسواق الأسهم أو السلع)\nمثال: مشغل لوحة المفاتيح",
 "交換機": "مِقْلَاد",
 "交換留学": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "交易": "تِجَارَة",
 "交易品": "بِضَاعَة, سِلْعَة (مادّة خام تُباع بكمّيّات كبيرة، عادةً لشركات أخرى لأغراض التصنيع أو الإنتاج)",
 "交易船": "باخرة شحن, سفينة تجارية (سفينة شحن)\nمثال: قاموا بالكثير من تجارتهم الخارجية في سفن أجنبية",
 "交易路": "طريق ملاحي, ممر بحري (ممر في البحر يعتبر طريقاً منتظماً للسفن) / طريق تجاري (طريق يتبعه التجار (عادة في قوافل))",
 "交替": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "交歓": "مُؤَاخَاة",
 "交歓会": "اِسْتِقْبَال / اِسْتِقْبَال, حَفْلَة اِسْتِقْبَال",
 "交流": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ / تَيَّار مُتَرَدِّد",
 "交流会": "جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع",
 "交流回路": "تَيَّار مُتَرَدِّد",
 "交流委員会": "سياسة خارجية (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "交流戦": "مُبَارَاة وِدِّيَّة",
 "交流電源": "منوب, مولد تيار متردد (مصطلح قديم لمولد كهربائي ينتج تياراً متردداً (خاصة في السيارات))",
 "交渉": "مُفَاوَضَات, مُذَاكَرَات / صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "交渉ごと": "تَفَاوَضَ",
 "交渉カード": "وَرَقَة تَفَاوُض, وَرَقَة مُسَاوَمَة (نفوذ في شكل إغراء أو تنازل مفيد في المفاوضات الناجحة)",
 "交渉事": "تَفَاوَضَ",
 "交渉人": "مفاوض (شخص يتفاوض (يتشاور مع الآخرين للوصول إلى تسوية))",
 "交渉員": "مفاوض (شخص يتفاوض (يتشاور مع الآخرين للوصول إلى تسوية))",
 "交渉役": "مفاوض (شخص يتفاوض (يتشاور مع الآخرين للوصول إلى تسوية))",
 "交点": "تقاطع, نقطة تقاطع (نقطة تتقاطع فيها الخطوط)",
 "交番": "تناوب (تغيير متتالي من شيء أو حالة إلى أخرى والعودة مرة أخرى) / متردد, متناوب ((عن التيار الكهربائي) يعكس اتجاهه)\nمثال: تيار متردد",
 "交番電流": "تَيَّار مُتَرَدِّد",
 "交直": "تَيَّار مُتَرَدِّد",
 "交絡": "تَرَابُط, عَلَاقَة مُتَبَادَلَة (علاقة متبادلة أو ارتباط متبادل)\nمثال: العلاقات المتبادلة بين بنية الحيوان ووظيفته",
 "交誼": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "交譲": "امتياز (عقد يمنح الحق في تشغيل عمل فرعي) / إذعان, تنازل (فعل التنازل أو الإذعان) / تنازل (نقطة يتم التنازل عنها أو التسليم بها)\nمثال: حصل على امتياز البيرة في ملعب الكرة",
 "交趾": "دجاج كوشين (سلالة آسيوية من الدجاج الكبير ذو ريش كثيف وأرجل مغطاة بالريش)",
 "交通": "مُرُور / اِتِّصَالَات, اِتِّصَال / رِسَالَة, خَبَر / حِوَار / جِمَاع (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
