 "冒とく": "تَجْدِيف",
 "冒涜": "تَجْدِيف",
 "冒涜的": "سَابّ, كُفْرِيّ (يتّسم بالتجديف أو السبّ والشتم) / كَافِر, مُجَدِّف (شديد الاستخفاف بما يُعتبَر مقدّساً)",
 "冒険": "مُخَاطَرَة, مُغَامَرَة / مُغَامَرَة / مُجَازَفَة, مُغَامَرَة / مُجَازَفَة / خَطَر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "冒険家": "مُغَامِر, مُغَامِرَة",
 "冒険小説": "حكاية بطولية, قصة مغامرة (قصة تدور حول مغامرة)",
 "冒険的": "مُغَامِر",
 "冒険者": "مُغَامِر, مُغَامِرَة",
 "冒険資本": "رأس مال جريء, رأس مال مخاطر (ثروة متاحة للاستثمار في مشاريع جديدة أو مضاربة)",
 "冒頭": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "冗": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "冗句": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "冗員": "زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / كومبارس, ممثل إضافي (ممثل ثانوي يظهر في مشاهد الحشود) / زَائِد عَنِ الْحَاجَة, عَمَالَة فَائِضَة (شخص لا يؤدي وظيفة ظاهرة)",
 "冗多": "إفراط, فرط (كمية تزيد عما هو مناسب)\nمثال: الأطفال في سن الرابعة لديهم فرط في الطاقة",
 "冗文": "تكرار زائد, حشو (تكرار فعل ما بلا حاجة) / زيادة, فائض (سمة كون الشيء زائداً وغير مطلوب) / تكرار احتياطي ((إلكترونيات) تصميم نظام يكرر المكونات لتوفير بدائل في حالة فشل أحد المكونات) / تكرار زائد, حشو (تكرار الرسائل لتقليل احتمالية الأخطاء في الإرسال)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة",
 "冗漫": "إطناب, حشو (أسلوب تعبيري يستخدم كلمات مفرطة أو فارغة)",
 "冗物": "تكرار زائد, حشو (تكرار فعل ما بلا حاجة) / زيادة, فائض (سمة كون الشيء زائداً وغير مطلوب) / تكرار احتياطي ((إلكترونيات) تصميم نظام يكرر المكونات لتوفير بدائل في حالة فشل أحد المكونات) / تكرار زائد, حشو (تكرار الرسائل لتقليل احتمالية الأخطاء في الإرسال)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة",
 "冗舌": "ثرثرة (صفة الإطناب وكثرة الكلام)",
 "冗舌家": "ثَرْثَار",
 "冗言": "هَذَى",
 "冗語": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات) / إسهاب, كثرة الكلام (وفرة مفرطة من الكلمات)",
 "冗談": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "冗談めかして": "على سبيل المزاح, مازحاً (ليس بجدية) / على سبيل المزاح, مازحاً\nمثال: قصدت ذلك مازحاً (يفيد الاستعلاء؛ يفيد التعليل)",
 "冗談口": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "冗談抜きで": "بِجِدِّيَّة, بجد",
 "冗長": "إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي) / مُضْجِر, مُمِلّ (يفتقر إلى الإثارة لدرجة تسبب السأم الذهني) / تكرار زائد, حشو (تكرار فعل ما بلا حاجة) / زيادة, فائض (سمة كون الشيء زائداً وغير مطلوب) / تكرار احتياطي ((إلكترونيات) تصميم نظام يكرر المكونات لتوفير بدائل في حالة فشل أحد المكونات) / تكرار زائد, حشو (تكرار الرسائل لتقليل احتمالية الأخطاء في الإرسال)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة",
 "冗長化": "استنساخ, مضاعفة (فعل نسخ أو عمل نسخة (أو نسخ) من شيء ما) / تكرار, نسخة طبق الأصل (نسخة تتوافق مع الأصل تماماً)\nمثال: هذا النوع من الازدواجية هو هدر",
 "冗長度": "تكرار زائد, حشو (تكرار فعل ما بلا حاجة) / زيادة, فائض (سمة كون الشيء زائداً وغير مطلوب) / تكرار احتياطي ((إلكترونيات) تصميم نظام يكرر المكونات لتوفير بدائل في حالة فشل أحد المكونات) / تكرار زائد, حشو (تكرار الرسائل لتقليل احتمالية الأخطاء في الإرسال)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة",
 "冗長性": "تكرار زائد, حشو (تكرار فعل ما بلا حاجة) / زيادة, فائض (سمة كون الشيء زائداً وغير مطلوب) / تكرار احتياطي ((إلكترونيات) تصميم نظام يكرر المكونات لتوفير بدائل في حالة فشل أحد المكونات) / تكرار زائد, حشو (تكرار الرسائل لتقليل احتمالية الأخطاء في الإرسال)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة",
 "冗長検査": "فحص التكافؤ (نظام للتحقق من الأخطاء في عمل الكمبيوتر)",
 "冗長量": "تكرار زائد, حشو (تكرار فعل ما بلا حاجة) / زيادة, فائض (سمة كون الشيء زائداً وغير مطلوب) / تكرار احتياطي ((إلكترونيات) تصميم نظام يكرر المكونات لتوفير بدائل في حالة فشل أحد المكونات) / تكرار زائد, حشو (تكرار الرسائل لتقليل احتمالية الأخطاء في الإرسال)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة",
 "写し": "نُسْخَة / اِنْتَسَخَ, نَسَخَ / مِئَتَان (يَدُلُّ عَلَى العَدَد 200) / سنتيمتر مكعب, مليلتر (وحدة مترية للحجم تساوي واحداً من الألف من اللتر)",
 "写し出す": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم. / وَصَفَ / عَكَسَ",
 "写し取る": "نُسْخَة / اِنْتَسَخَ, نَسَخَ",
 "写し撮る": "تَسْجِيل, مُدَوَّنَة / سِجِلّ, دَفْتَر (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / رَقْم قِيَاسِيّ (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "写し絵": "رَسْم تَقْرِيبِيّ, رَسِيمَة (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / صورة شعاعية (صورة فوتوغرافية منتجة على سطح حساس للإشعاع بواسطة إشعاع غير الضوء المرئي (خاصة الأشعة السينية أو أشعة غاما)) / انْعِكَاس, صُورَة مِرْآتِيَّة (صورة مماثلة يكون فيها اليسار واليمين معكوسين)",
 "写す": "نُسْخَة / اِنْتَسَخَ, نَسَخَ / وَصَفَ / قَلَّدَ / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "写り": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها. / مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "写り込む": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "写像": "رسم الخرائط الجينية ((علم الوراثة) عملية تحديد مواقع الجينات على الكروموسوم) / تَابِع رِيَاضِيّ, دَالَّة ((الرياضيات) علاقة رياضية بحيث يرتبط كل عنصر من مجموعة معينة (مجال الدالة) بعنصر من مجموعة أخرى (مدى الدالة)) / رسم الخرائط (عملية صنع الخرائط)\nمثال: رسم خرائط مفصل لبنية الصخور",
 "写字": "نسخ (فعل النسخ)",
 "写字室": "غرفة النسخ (غرفة في دير مخصصة لكتابة أو نسخ المخطوطات)",
 "写実": "بَرَاغْمَاتِيَّة, وَاقِعِيَّة (سمة قبول حقائق الحياة وتفضيل العملية والحقيقة الحرفية) / أفلاطونية, واقعية ((فلسفة) المذهب الفلسفي القائل بأن المفاهيم المجردة توجد مستقلة عن أسمائها) / واقعية, واقعية ساذجة ((فلسفة) المذهب الفلسفي القائل بأن الأشياء المادية تستمر في الوجود عندما لا يتم إدراكها) / الطبيعية, الواقعية (حركة فنية في فرنسا في القرن التاسع عشر؛ سعى الفنانون والكتاب للحصول على وصف واقعي وواقعي مفصل)",
 "写実主義": "بَرَاغْمَاتِيَّة, وَاقِعِيَّة (سمة قبول حقائق الحياة وتفضيل العملية والحقيقة الحرفية) / أفلاطونية, واقعية ((فلسفة) المذهب الفلسفي القائل بأن المفاهيم المجردة توجد مستقلة عن أسمائها) / واقعية, واقعية ساذجة ((فلسفة) المذهب الفلسفي القائل بأن الأشياء المادية تستمر في الوجود عندما لا يتم إدراكها) / الطبيعية, الواقعية (حركة فنية في فرنسا في القرن التاسع عشر؛ سعى الفنانون والكتاب للحصول على وصف واقعي وواقعي مفصل)",
 "写実主義者": "وَاقِعِيّ",
 "写実性": "بَرَاغْمَاتِيَّة, وَاقِعِيَّة (سمة قبول حقائق الحياة وتفضيل العملية والحقيقة الحرفية) / أفلاطونية, واقعية ((فلسفة) المذهب الفلسفي القائل بأن المفاهيم المجردة توجد مستقلة عن أسمائها) / واقعية, واقعية ساذجة ((فلسفة) المذهب الفلسفي القائل بأن الأشياء المادية تستمر في الوجود عندما لا يتم إدراكها) / الطبيعية, الواقعية (حركة فنية في فرنسا في القرن التاسع عشر؛ سعى الفنانون والكتاب للحصول على وصف واقعي وواقعي مفصل)",
 "写実的": "واقعي (مدرك أو يعبر عن إدراك للأشياء كما هي حقاً) / طَبِيعِيّ, وَاقِعِيّ (يمثل الواقع كما هو؛ ليس تجريدياً أو مثالياً) / واقعي (مكون من أو متعلق بالمذهب الفلسفي للواقعية)\nمثال: وصف واقعي",
 "写本": "مَخْطُوطَة (مُؤَلَّف المكتوب باليد ، غير المطبوع؛ نُسْخة المؤلِّلف الأصليَّة المُعدَّة للطبع) / مَخْطُوطَة, مَخْطُوط (مُؤَلَّف المكتوب باليد ، غير المطبوع؛ نُسْخة المؤلِّلف الأصليَّة المُعدَّة للطبع)",
 "写生": "رَسْم تَقْرِيبِيّ, رَسِيمَة (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "写生帖": "دفتر رسم",
 "写生帳": "دفتر رسم",
 "写生文": "تشخيص, تصوير (وصف لفظي بياني أو حيوي)\nمثال: في كثير من الأحيان كانت الرواية تُقاطع بصور لفظية طويلة",
 "写真": "صُورَة, صُورَة شَمْسِيَّة / اِلْتَقَطَ صُورَة\nمثال: あなたに何枚かの写真を見せましょう。 — سأريك بعض الصور. / فيلم, فيلم سينمائي (شكل من أشكال الترفيه يجسد قصة بالصوت وتسلسل من الصور يعطي وهماً بالحركة المستمرة)\nمثال: ذهبوا لمشاهدة فيلم كل ليلة سبت",
 "写真をとる": "اِلْتَقَطَ صُورَةً",
 "写真を写す": "صُورَة, صُورَة شَمْسِيَّة / اِلْتَقَطَ صُورَة",
 "写真を撮る": "اِلْتَقَطَ صُورَةً",
 "写真フィルム": "فيلم, فيلم فوتوغرافي (مادة فوتوغرافية تتكون من قاعدة من السيلولويد مغطاة بمستحلب فوتوغرافي؛ تستخدم لعمل السلبيات أو الشفافيات)",
 "写真乳剤": "مستحلب, مستحلب فوتوغرافي (طلاء حساس للضوء على الورق أو الفيلم؛ يتكون من حبيبات دقيقة من بروميد الفضة معلقة في جيلاتين)",
 "写真乾板": "لوح جاف (طريقة تصوير سابقة استخدمت لوحاً زجاجياً مطلياً بمستحلب جيلاتيني حساس للضوء)",
 "写真判定決勝": "نهاية متقاربة جداً, نهاية مصورة (بشكل عام، أي نهاية متقاربة جداً؛ وتحديداً، نهاية سباق يكون فيه المتسابقون قريبين جداً من بعضهم البعض بحيث يجب تحديد الفائز من صورة التقطت لحظة النهاية)",
 "写真家": "مُصَوِّر, مُصَوِّرَة",
 "写真屋": "مُصَوِّر, مُصَوِّرَة",
 "写真師": "مُصَوِّر, مُصَوِّرَة",
 "写真帳": "ألبوم صور (ألبوم للصور الفوتوغرافية)",
 "写真撮影": "تَصْوِير, فُوتُوغْرَافِيَّا",
 "写真機": "كَمِرَة, كَامِيرَا",
 "写真濃度": "امتصاصية, كثافة ضوئية ((فيزياء) مقياس لمدى نقل المادة للضوء أو الإشعاع الكهرومغناطيسي الآخر)",
 "写真版": "جهاز تصوير, فوتوستات (آلة نسخ تقوم بعمل نسخ موجبة أو سالبة سريعة مباشرة على سطح ورق محضر) / فوتوستات (نسخة مصورة مصنوعة على جهاز فوتوستات)",
 "写真用紙": "ورق تصوير (ورق حساس للضوء يمكن طباعة صورة فوتوغرافية عليه)",
 "写真石版": "طباعة حجرية ضوئية, فوتو ليثوغرافيا (عملية طباعة مستوية تستخدم ألواحاً مصنوعة من صورة فوتوغرافية)",
 "写真術": "تَصْوِير, فُوتُوغْرَافِيَّا",
 "写真製版": "لوحة تظليل, نقش ضوئي (نقش يستخدم لإعادة إنتاج رسم توضيحي)",
 "写真複写機": "نَاسِخَة, نَاسِخَة ضَوْئِيَّة",
 "写真記者": "مصور صحفي (صحفي يقدم القصة بشكل أساسي من خلال استخدام الصور الفوتوغرافية)",
 "写真電送": "إبراق ضوئي, إرسال صور بالتلغراف (تقنية مبكرة لنقل النسخ المماثلة (الفاكس))\nمثال: وجه آيفز انتباهه بعد ذلك إلى التلفزيون، الذي اعتبره مجرد شكل مسرع من الإبراق الضوئي",
 "写象": "صُورَة / اِنْطِبَاع, سُمْعَة",
 "冠": "تَاج, إِكْلِيل / أَفْضَل / اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟ / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "冠す": "تَاج, إِكْلِيل / أصلاً, في المقام الأول (قبل الآن)\nمثال: لماذا لم تخبرني في المقام الأول؟",
 "冠する": "تَاج, إِكْلِيل / أصلاً, في المقام الأول (قبل الآن)\nمثال: لماذا لم تخبرني في المقام الأول؟",
 "冠たる": "أَفْضَل",
 "冠る": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / دُبّ / دُبَّة / اِحْتَمَلَ / تراكب, طية (لسان يقع فوق جزء آخر) / تداخل (خاصية التصادف الجزئي في الوقت) / التقاء, تداخل (تمثيل للأرضية المشتركة بين النظريات أو الظواهر)\nمثال: يجب أن يكون تراكب القرميد عشر بوصات على الأقل / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "冠不全": "قُصُور الشِّرْيَان التَّاجِيّ, قُصُور القَلْب (تدفق غير كافٍ للدم إلى عضلات القلب؛ يمكن أن يسبب ذبحة صدرية)",
 "冠動脈": "شريان تاجي (الشريان الذي يتفرع من الأبهر لتغذية القلب بالدم)",
 "冠動脈バイパス手術": "تحويل مسار الشريان التاجي, مجازة تاجية (جراحة قلب مفتوح يتم فيها فتح القفص الصدري وتطعيم قسم من وعاء دموي من الشريان الأورطي إلى الشريان التاجي لتجاوز القسم المسدود من الشريان التاجي وتحسين…)",
 "冠動脈疾患": "مَرَض الْقَلْب التَّاجِيّ, دَاء الشَّرْيَان التَّاجِيّ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "冠履転倒": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب",
 "冠履顚倒": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب",
 "冠帽": "قُبَّعَة, بُرْنَيْطَة (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس العَمَامَة التي لا يكون فيها خِيَاطَة. قُلُنْسُوَة)\nمثال: لقد اشترى قبعة.",
 "冠座": "التَّاج السَّمَالِيّ",
 "冠木": "عتبة علوية (عارضة أفقية تستخدم كقطعة تشطيب فوق باب أو نافذة)",
 "冠毛": "زغب الشوك (زغب نبات الشوك المكون من شعيرات حريرية تشبه الريش)",
 "冠水": "علاج بالغمر, علاج بالفيضان (تقنية تستخدم في العلاج السلوكي؛ يتم إغراق العميل بتجارب من نوع معين حتى يصبح كارهاً لها أو مخدراً تجاهها)",
 "冠状": "تاجي (يحيط كالتاج (خاصة الأوعية الدموية المحيطة بالقلب)) / تخثر تاجي (انسداد تدفق الدم في الشريان التاجي بجلطة دموية (خثرة))\nمثال: شرايين تاجية",
 "冠状動脈": "شريان تاجي (الشريان الذي يتفرع من الأبهر لتغذية القلب بالدم)",
 "冠状動脈疾患": "تصلب الشرايين (تصلب جدران الشرايين)",
 "冠状動脈血栓症": "خُثَار تَاجِيّ",
 "冠状静脈洞": "جيب تاجي (جيب قصير يستقبل معظم أوردة القلب؛ يصب في الأذين الأيمن)",
 "冠称": "اسم تجاري, علامة تجارية (اسم يُعطى لمنتج أو خدمة)",
 "冠絶": "فَرِيد, فَذّ",
 "冠者": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "冠詞": "مَقَال, مَقَالَة / أَدَاةُ تَعْرِيف, أَدَاةُ التَّعْرِيف / مادّةٌ, مَوَادُّ (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "冠雪": "غِطَاء ثَلْجِيّ, قَلَنْسُوَة ثَلْجِيَّة (غطاء من الثلج (كما على قمة الجبل))",
 "冠静脈洞": "جيب تاجي (جيب قصير يستقبل معظم أوردة القلب؛ يصب في الأذين الأيمن)",
 "冠頂": "تَاج, إِكْلِيل",
 "冠鳰": "غطاس متوج كبير (غطاس كبير من العالم القديم ذو خصلات أذن سوداء)",
 "冢": "بيشر, رامي (مركز في فريق البيسبول للاعب الذي يرمي الكرة للضارب ليحاول ضربها) / تل, رابية (هيكل يتكون من كومة صناعية أو ركام عادة من التراب أو الحجارة) / تل الرامي ((بيسبول) الارتفاع الطفيف الذي يقف عليه الرامي) / ركام, كدس (مجموعة من الأشياء مكدسة فوق بعضها البعض)\nمثال: لعب في كل مركز باستثناء الرامي / تل مدفني, رابية الدفن ((في علم الآثار) كومة من التراب توضع فوق مقابر ما قبل التاريخ) / قائمة حجرية, منهير (ميغاليث عمودي طويل؛ يوجد بشكل أساسي في إنجلترا وشمال فرنسا)",
 "冤罪": "تحريف, تزييف (تحريف متعمد للحقائق) / تضليل, خداع (كذب مضلل)",
