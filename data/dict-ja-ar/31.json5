 "交響楽団": "أُورْكِسْتْرَا سِّمْفُونِي",
 "交響詩": "قصيدة سيمفونية, قصيدة نغمية (تكوين أوركسترالي مبني على الأدب أو الحكايات الشعبية)",
 "亥": "خِنْزِير / باتجاه الشمال الشمالي الغربي (إلى أو باتجاه أو في الشمال الشمالي الغربي)",
 "亨通": "سَعِيد, مُبَارَك (ينبئ أو من المرجح أن يجلب الحظ الجيد أو نتيجة حسنة) / ذَهَبِيّ, زَاهِر (يتسم بالسلام والازدهار) / مَيْسُورُ الحَال, مُرْتَاحٌ مَادِّيًّا (في ظروف مالية ميسورة؛ غنيّ بشكل معتدل) / رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو)",
 "亨運": "حسن طالع, ضربة حظ (جَمِيل؛ مُبْهِج) / توفيق, حسن الحظ (حالة ميمونة ناتجة عن نتائج إيجابية)\nمثال: إيمي فتاة حسنة.",
 "享く": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "享ける": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / أَبْقَى / عَالَ, يَعُولُ (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "享受": "مُتْعَة, مِتْعَة",
 "享受者": "مُسْتَلِم, مُسْتَلِمَة",
 "享持": "آمن, مرتاح البال (خالٍ من الخوف أو الشك؛ مرتاح البال) / آمن, محصن (خالٍ من الخطر أو المجازفة) / ثابت, متين (ليس من المحتمل أن يفشل أو ينهار) / آمِن, مَضْمُون (آمن ماليًّا ويمكن الاعتماد عليه)\nمثال: كان مطمئناً بأنه لن يُحاسب على أي شيء",
 "享有": "مَسّ, تَلَبُّس / مُمْتَلَك / حَوْزَة, مُلْكِيّة / اِسْتِحْوَاذ / حِيَازَة",
 "享楽": "مُتْعَة, مِتْعَة",
 "享楽主義": "أبيقورية (مذهب المتعة الذي دافع عنه العديد من الفلاسفة اليونانيين القدماء)",
 "享楽的": "لَذَّوِيّ, مُتَمَتِّع (مُكرَّس للمُتعة واللذّة)",
 "京": "رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "京の都": "كِيُوتُو",
 "京城": "رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "京女鷸": "قنبرة الماء (قنبرة ماء قطبية شائعة تشتي في أمريكا الجنوبية وأستراليا)",
 "京師": "رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "京方": "نَبِيل, شريف (اَلذَّكِيُّ؛ اَلنَّجِيبُ) / كَرِيم, شَرِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: إنها امرأة نبيلة.",
 "京族": "فِيتْنَامِيّ",
 "京極": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "京洛": "رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "京烏": "مُطَّلِع",
 "京華": "رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "京都": "كِيُوتُو",
 "京都伝統工芸専門学校": "هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "京風": "تمدن, حضرية (صفة أو طابع الحياة في المدينة أو البلدة) / تحضر, لباقة (مجاملة مصقولة؛ أناقة في الأسلوب)\nمثال: هناك فرق مهم بين البداوة والتمدن",
 "亭": "عريشة (هيكل يدعم النباتات المتسلقة) / عمود دوران, مغزل (أي من الأعمدة الدوارة المختلفة التي تعمل كمحاور لأجزاء دوارة أكبر) / شجرة (شجرة (في مقابل شجيرة))\nمثال: وفرت العريشة مكاناً ظليلاً للراحة في الحديقة",
 "亭々": "شَاهِق",
 "亭主": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن. / زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة.",
 "亭亭": "شَاهِق",
 "亭午": "ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "亭子": "جَنَاح, سُرَادِق / كُشْك (هو الكِشْك في بعض اللهجات العربية؛ شبه رِوَاق بارز عن مساواة بقية البيت)",
 "亮察": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "亮然": "شَفَّاف / وَاضِح",
 "亮直": "أحقية, حق (أي شيء يتفق مع مبادئ العدالة)\nمثال: يشعر أنه على حق",
 "人": "مُـ / إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق. / أُقْنُوم / فَرْد / أُقْنُوم / فَرْد / بشرية, جنس بشري (جميع السكان البشريين الأحياء على الأرض)\nمثال: كل العالم يحب المحب / بَشَرِيّ, إنْسَانِيّ / آدْمِيّ, بَشَرِيّ / إِنْسَان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / إِنْس / إنسان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / بنيآدم\nمثال: أنا إنسان صادق. / نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "人々": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه. / اَلْجَمِيع, كُلّ شَخْص",
 "人あたり": "أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "人いきれ": "ثقل دم, جمود (وقار ممل ومتغطرس) / انعدام التهوية, كتمة (صفة انحباس الهواء وسوء التهوية) / انسداد (حالة انسداد أو توقف الهواء في الأنف أو الحلق)",
 "人がいい": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "人がましい": "مُحْتَرَم",
 "人が悪い": "سيء الطباع, فظ (ذو طبع سريع الغضب وغير سار)",
 "人が良い": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "人け": "بَشَرِيَّة, إِنْسَانِيَّة / إِنْسَانِيَّة, بَشَرِيَّة",
 "人さらい": "اِخْتِطَاف / مُخْتَطِف",
 "人それぞれ": "كل شخص حرّ في ذوقه",
 "人たち": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "人たらし": "اِحْتِيَال / اِحْتَالَ / مُحْتَال",
 "人だかり": "كَوْم",
 "人だま": "شِهَاب",
 "人っ子": "أُقْنُوم / فَرْد",
 "人っ子一人": "رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / سول\nمثال: كان سامي هو روح الحفلة.",
 "人づて": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً) / إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "人でなし": "حيوان, كائن حي (كائن حي يتميز بالحركة الإرادية) / همجي, وحش (شخص قاسي وجشع)",
 "人となり": "طَبْع (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة!",
 "人なつこい": "لَطِيف (ذو اللطف وذو اللطافة؛ من الكلام: هو عمض معناه وخفي)\nمثال: هي مدرسة لطيفة.",
 "人なつっこい": "لَطِيف (ذو اللطف وذو اللطافة؛ من الكلام: هو عمض معناه وخفي)\nمثال: هي مدرسة لطيفة.",
 "人のいい": "رَقِيق, شَفُوق (نحيف وخفيف الوزن؛ لين وناعم الملمس، يمكن ثنيه بسهولة)\nمثال: لدى بتي صوت رقيق.",
 "人のこといえない": "مَنْ أَنْتَ؟, مَنْ أَنْتِ؟ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "人のこと言えない": "مَنْ أَنْتَ؟, مَنْ أَنْتِ؟ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "人の事いえない": "مَنْ أَنْتَ؟, مَنْ أَنْتِ؟ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "人の事言えない": "مَنْ أَنْتَ؟, مَنْ أَنْتِ؟ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "人の口": "إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "人の子": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / اِبْنُ الإنْسان (الولد الذكر)\nمثال: هو له ابن صغير.",
 "人の常": "طبيعة بشرية (السمات النفسية المشتركة للبشرية التي يفترض أنها مشتركة بين جميع البشر)\nمثال: مراقب عظيم للطبيعة البشرية",
 "人の良い": "رَقِيق, شَفُوق (نحيف وخفيف الوزن؛ لين وناعم الملمس، يمكن ثنيه بسهولة)\nمثال: لدى بتي صوت رقيق.",
 "人の蠅を追うより己の蠅を追え": "تَوَخَّى اَلْحِذْر",
 "人の道": "أخلاق, مبدأ أخلاقي (مبادئ الصواب والخطأ التي يقبلها فرد أو مجموعة اجتماعية) / مَبْدَأ أَخْلَاقِيّ (المبدأ القائل بأن السلوك يجب أن يكون أخلاقياً)\nمثال: الأخلاق البيوريتانية",
 "人はパンのみにて生くるにあらず": "لَيْسَ بِٱلْخُبْزِ وَحْدَهُ يَحْيَا ٱلْإِنْسَانُ",
 "人はパンのみにて生くるに非ず": "لَيْسَ بِٱلْخُبْزِ وَحْدَهُ يَحْيَا ٱلْإِنْسَانُ",
 "人はパンのみにて生くるものに非ず": "لَيْسَ بِٱلْخُبْزِ وَحْدَهُ يَحْيَا ٱلْإِنْسَانُ",
 "人はパンのみにて生くる者に非ず": "لَيْسَ بِٱلْخُبْزِ وَحْدَهُ يَحْيَا ٱلْإِنْسَانُ",
 "人びと": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه. / اَلْجَمِيع, كُلّ شَخْص",
 "人まえ": "عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور",
 "人まね": "مُشَاكهَة",
 "人もなげ": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية.",
 "人も無げ": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية.",
 "人より": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض",
 "人らしい": "بَشَرِيّ, إنْسَانِيّ / آدْمِيّ, بَشَرِيّ / إِنْسَان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / إِنْس / إنسان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / بنيآدم\nمثال: أنا إنسان صادق.",
 "人を食った": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية.",
 "人マネ": "مُشَاكهَة",
 "人一倍": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض",
 "人世": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "人並": "عَادِيّ, مَأْلُوف",
 "人並み": "عَادِيّ, مَأْلُوف",
 "人並みはずれた": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو نوعه) / فَرِيد, نَادِر (يتميز بجودة غير مألوفة؛ خاصة من الدرجة العليا أو المتطرفة في نوعه)\nمثال: طيور غير شائعة",
 "人並み外れた": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو نوعه) / فَرِيد, نَادِر (يتميز بجودة غير مألوفة؛ خاصة من الدرجة العليا أو المتطرفة في نوعه)\nمثال: طيور غير شائعة",
 "人中": "مُجْتَمَع, جَمَاعَة (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية) / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع) / اِجْتِمَاعِيَّة\nمثال: سامي خطر للمجتمع. / نَثْرَة",
 "人乳頭腫ウイルス": "فيروس الورم الحليمي البشري (أي من مجموعة فيروسات بابوفا المرتبطة بالسرطانات التناسلية أو الفموية أو مجموعة مرتبطة بأورام تناسلية حميدة)",
 "人事": "ساعة (فترة زمنية تعادل 1/24 من اليوم)\nمثال: ستستغرق المهمة أكثر من ساعة",
 "人事不省": "فِقْدَان اَلْوَعْي, إِغْمَاء",
 "人事異動": "إعادة خلط, تعديل وزاري (الخلط مرة أخرى) / إعادة خلط, تعديل وزاري (إعادة توزيع لشيء ما)\nمثال: طلب المقامر إعادة خلط الأوراق",
 "人事部": "إدارة الموارد البشرية, قسم شؤون الموظفين (القسم المسؤول عن تعيين وتدريب وتوزيع الموظفين ووضع سياسات إدارة الأفراد)",
 "人人": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه. / اَلْجَمِيع, كُلّ شَخْص",
 "人付": "سُمْعَة, شُهْرَة",
 "人付き合い": "تَوَاصُل اِجْتِمَاعِيّ, مُخَالَطَة اِجْتِمَاعِيَّة (فعل الاجتماع لأغراض اجتماعية)\nمثال: كان هناك الكثير من المخالطة الاجتماعية مع الجنود المجندين",
 "人代名詞": "ضمير شخصي (ضمير يعبر عن تمييز الشخص (المتكلم، المخاطب، الغائب))",
 "人伝": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً) / إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "人似猿": "قرد شبيه بالإنسان, قرد عليا (أي قرد عديم الذيل من فصيلتي البونجيد والهيلوباتيد)",
 "人体": "جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "人体冷凍保存": "تجميد البشر, كريونيكس (تجميد شخص مريض بشكل خطير أو متوفى حديثاً لوقف تحلل الأنسجة؛ يتم الحفاظ على الجسم حتى يتم تطوير علاجات طبية جديدة قد تعيد الشخص إلى الحياة)\nمثال: تجميد البشر هو خيال علمي أكثر منه علم جاد",
 "人使い": "خَادِم, خَادِمَة",
 "人倫": "بَشَرِيَّة, إِنْسَانِيَّة / إِنْسَانِيَّة, بَشَرِيَّة",
 "人傑": "بَطَل, بَطَلَة",
 "人免疫不全ウイルス": "الإيدز, فيروس نقص المناعة البشرية (الفيروس الذي يسبب متلازمة نقص المناعة المكتسب (الإيدز)؛ يتكاثر في الخلايا التائية المساعدة ويقتلها)",
 "人其々": "كل شخص حرّ في ذوقه",
 "人出": "كَوْم",
 "人切り": "اِغْتِيَال (مصدر للفعل \"اغْتَالَ\"؛ قتل شخص على غفلة منه، ويكثر استعماله في القتل لأسباب سياسية أو لمنافع شخصية)\nمثال: لم يتمكن أحد من الاغتيال هتلر.",
 "人別改": "تَعْدَاد اَلسُّكَّان, إِحْصَاء اَلسُّكَّان",
 "人前": "عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور",
 "人前で": "جهراً, علناً (بطريقة يمكن للجمهور الوصول إليها أو ملاحظتها؛ بصراحة)\nمثال: اعترفت علناً بكونها شيوعية",
 "人力車": "رِيكْشَا",
 "人助け": "إِحْسَان",
 "人参": "جَزَر, جزر (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "人取り": "قاعدة الأسرى (لعبة أطفال؛ يقوم فريقان بأسر اللاعبين المعارضين عن طريق لمسهم وأخذهم إلى قاعدتهم الخاصة)",
 "人受け": "شَعْبِيَّة",
 "人口": "سُكَّان / سُكَّانِيَّة",
 "人口ピラミッド": "هَرَم سُكَّانِيّ ((في الهندسة) منشور كثير السطوح، قاعدته مضلع، وأوجهه الأخرى مثلثات، قواعدها أضلاع مضلع القاعدة، ورؤوسها مجتمعة في نقطة واحدة خارجة عنه؛ بناء أثري بناه الفراعنة في مصر بالحجارة الصلبة، ذو قاعدة مربعة، له أربع واجهات، وكل واجهة مثلثة الشكل، تلتقي رؤوسها فتكون رأسًا واحدًا هو قمة الهرم)",
 "人口増加": "نمو سكاني (زيادة في عدد الأشخاص الذين يسكنون منطقة أو دولة)",
 "人口増加率": "نمو سكاني (زيادة في عدد الأشخاص الذين يسكنون منطقة أو دولة)",
 "人口学": "دِيمُوغْرَافِيَا, دِمُوغْرَافِيَا",
 "人口密度": "كَثَافَة سُكَّانِيَّة (مصدر لكَثَفَ؛ اللغلظ والثخانة)\nمثال: هذه منطقة من الغابة أقل كثافة",
 "人口密集率": "كَثَافَة سُكَّانِيَّة (مصدر لكَثَفَ؛ اللغلظ والثخانة)\nمثال: هذه منطقة من الغابة أقل كثافة",
 "人口抑制": "تحديد النسل, ضبط السكان (السيطرة على نمو السكان؛ برنامج حكومي)",
 "人口減少": "انخفاض السكان, تفريغ سكاني (حالة انخفاض أعداد السكان (أو عدم وجود سكان على الإطلاق))",
 "人口統計": "ديموغرافي, سكاني (متعلق بعلم السكان (الديموغرافيا)) / إحصائية ديموغرافية, إحصائية سكانية (إحصائية تصف السكان البشريين (أو شرائح منهم مقسمة حسب العمر أو الجنس أو الدخل، إلخ))\nمثال: مسوحات ديموغرافية (سكانية)",
 "人口統計学": "دِيمُوغْرَافِيَا, دِمُوغْرَافِيَا",
 "人口統計学者": "ديموغرافي, عالم سكان (عالم يدرس نمو وكثافة السكان وإحصاءاتهم الحيوية)",
 "人口調査": "تَعْدَاد اَلسُّكَّان, إِحْصَاء اَلسُّكَّان",
