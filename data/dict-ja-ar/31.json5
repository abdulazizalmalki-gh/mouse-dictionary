 "介護保険法": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "介護士": "مُقَدِّم الرِّعايَة (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى…)\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "介護施設": "دار رعاية, مأوى (مؤسسة يتم فيها رعاية الناس)\nمثال: دار لرعاية المسنين",
 "介護殺人": "رعاية تمريضية (رعاية من قبل ممرض ماهر)",
 "介護者": "مُقَدِّم رِعَايَة (شخص مسؤول عن تلبية احتياجات طفل أو شخص بالغ معال)",
 "介護認定": "رعاية تمريضية (رعاية من قبل ممرض ماهر)",
 "介錯": "ضرب العنق, قطع الرأس (القتل بقطع الرأس) / مُسَاعَدَة, إِمْدَاد",
 "介錯人": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد…)\nمثال: علي مساعدة ماري.",
 "介音": "مُتَوَسِّط, وَسَطِيّ (يتعلّق بالوسط أو يقع فيه أو يمتدّ نحوه)",
 "仍りて": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "仏": "فَرَنْجَة\nمثال: نساء فرنسا جميلات. / بُوذَا, بُدّ / بُوذِيَّة, سَمَنِيَّة (المؤنث من \"بُوذِيّ\"؛ ديانة تتبع تعاليم مؤسسها غواتاما بوذا، نشأت في شبه قارة…) / بُوذَا, بُدّ / مَيِّت",
 "仏さま": "بُوذَا, بُدّ / راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "仏さん": "بُوذَا, بُدّ / راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "仏になる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "仏の座": "أذن القسيس, لاميون متموج (نبات أوراسي له أوراق مسننة وزهور صغيرة ثنائية الشفة بيضاء أو حمراء أرجوانية)",
 "仏トン": "طُنّ مِتْرِيّ",
 "仏人": "فرنسي (شخص يحمل الجنسية الفرنسية)",
 "仏典": "سوترا (قاعدة أو قول مأثور في الأدب السنسكريتي أو مجموعة من الملخصات العقائدية)",
 "仏図": "بُوذَا, بُدّ / سْتُوبَا",
 "仏国": "فَرَنْجَة\nمثال: نساء فرنسا جميلات.",
 "仏土": "جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط)\nمثال: هواوي جنة على الأرض.",
 "仏塔": "سْتُوبَا",
 "仏子": "بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها…) / بَشَرِيَّة, الْجِنْس الْبَشَرِيّ / بُودِيسَاتْفَا",
 "仏弟子": "بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها…)",
 "仏徒": "بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها…)",
 "仏心": "رَحْمَة, رَأْفَة",
 "仏心宗": "زَن, زِن ((زَنَّ) عصبه زنا: يبس واسترخت مفاصله؛ (زَنَّ) فلانا بخير أو شر زنا: اتهمه به)\nمثال: هل خسرت وزن مؤخرا؟",
 "仏性": "رأفة, رحمة (التساهل والرحمة التي يظهرها تجاه المخالفين شخص أو وكالة مكلفة بإقامة العدل)",
 "仏手柑": "يد بوذا (فاكهة كبيرة تشبه الليمون مقسمة إلى أقسام تشبه الأصابع؛ معظم الأصناف لا تحتوي…)",
 "仏教": "بُوذِيَّة, سَمَنِيَّة (المؤنث من \"بُوذِيّ\"؛ ديانة تتبع تعاليم مؤسسها غواتاما بوذا، نشأت في شبه قارة…)",
 "仏教家": "بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها…)",
 "仏教徒": "بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها…)",
 "仏文": "الفَرَنْسِيَّة, اللُّغَة الفَرَنْسِيَّة",
 "仏智": "إحاطة بكل شيء, علم مطلق (حالة العلم بكل شيء؛ امتلاك معرفة لا نهائية)",
 "仏果": "اَلنِّرْفَانَا",
 "仏桑花": "كركديه صيني, ورد صيني (شجيرة آسيوية كبيرة مبهرجة أو شجرة صغيرة ذات زهور حمراء إلى حمراء داكنة كبيرة…)",
 "仏桑華": "كركديه صيني, ورد صيني (شجيرة آسيوية كبيرة مبهرجة أو شجرة صغيرة ذات زهور حمراء إلى حمراء داكنة كبيرة…)",
 "仏様": "بُوذَا, بُدّ / راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "仏法": "بُوذِيَّة, سَمَنِيَّة (المؤنث من \"بُوذِيّ\"؛ ديانة تتبع تعاليم مؤسسها غواتاما بوذا، نشأت في شبه قارة…)",
 "仏法僧": "كرة متدحرجة (كرة أرضية تتدحرج على طول الملعب الداخلي)\nمثال: امرأة رأسها مليء بلفافات الشعر ليست منظراً جميلاً",
 "仏米": "أمريكي فرنسي (أمريكي ولد في فرنسا أو من أجداد فرنسيين)",
 "仏者": "بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها…)",
 "仏臭い": "مَا وَرَائِيّ, مُتَعَالٍ (يوجد خارج نطاق الطبيعة أو لا يتوافق معها)",
 "仏語": "الفَرَنْسِيَّة, اللُّغَة الفَرَنْسِيَّة",
 "仏貨": "فرنك فرنسي (سابقاً وحدة المال الأساسية في فرنسا)",
 "仏道": "بُوذِيَّة, سَمَنِيَّة (المؤنث من \"بُوذِيّ\"؛ ديانة تتبع تعاليم مؤسسها غواتاما بوذا، نشأت في شبه قارة…)",
 "仏門": "بُوذِيَّة, سَمَنِيَّة (المؤنث من \"بُوذِيّ\"؛ ديانة تتبع تعاليم مؤسسها غواتاما بوذا، نشأت في شبه قارة…)",
 "仏陀": "بُوذَا, بُدّ",
 "仏頂": "جفاء, غلظة (أسلوب فظ مفاجئ)",
 "仏頂面": "بوّز, بَرطَمَ",
 "仏領ギアナ": "غِيَانَا اَلْفَرَنْسِيَّة, غَيانا اَلْفَرَنْسِيَّة",
 "仔": "صَغِير, حَدَث",
 "仔牛": "عِجْل (أسرع في إنجاز شيء أو القيام به؛ قدم شيئًا قبل وقته المعتاد)\nمثال: أنا في عجلة من أمري.",
 "仔牛皮": "جلد العجل (جلد ناعم من جلد عجل)",
 "仔牛肉": "لَحْم عِجْل (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم…)\nمثال: أفضل لحم البقر.",
 "仔牛革": "جلد العجل (جلد ناعم من جلد عجل)",
 "仔犬": "جَرْو (الصَغير من كل نَبَات أو حَيَوَان؛ الصغير من الثَمَر كالبَطِّيخ والرُمَّان وغيره)\nمثال: كان الجرو يلحس خدها.",
 "仔猫": "قُطَيْط, قُطَيْطَة",
 "仔細": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل. / تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية / إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع)",
 "仔細に": "بِالتَّفْصِيل, تَفْصِيلًا",
 "仔細に及ばず": "هُنَاكَ, يُوجَدُ",
 "仔羊": "حَمَل, خَرُوف (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "仔虫": "يَرَقَة",
 "仔豚": "خِنَّوْص",
 "仔馬": "فَرَس قَزَم (أقوام تسكن شرق العِرَاق، يقال أنهم أقوام آرِيَّة)\nمثال: الفرس هي أنثى الحصان / مُهْر, فِلْو",
 "仔鳩": "زُغْلُول, جَوْزَل",
 "仔鹿": "شَادِن, رِيم",
 "仕": "مَسْؤُول\nمثال: كلكم راع وكلكم مسئول عن رعيته.",
 "仕える": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "仕え奉る": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "仕え女": "خادمة (عاملة منزلية)",
 "仕なおす": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "仕る": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "仕を致す": "اِسْتَقَالَ",
 "仕上": "فَرَغَ, أَنْهَى\nمثال: انتهى أمر زيري.",
 "仕上がり": "فَرَغَ, أَنْهَى\nمثال: انتهى أمر زيري.",
 "仕上げ": "فَرَغَ, أَنْهَى\nمثال: انتهى أمر زيري.",
 "仕上げる": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "仕上げ工": "منهي السباق (حيوان يفوز في مسابقة سرعة)",
 "仕上り": "فَرَغَ, أَنْهَى\nمثال: انتهى أمر زيري.",
 "仕上工": "منهي السباق (حيوان يفوز في مسابقة سرعة)",
 "仕事": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "仕事の虫": "مدمن عمل (شخص لديه حاجة قهرية للعمل)",
 "仕事をやめる": "اِسْتَقَالَ",
 "仕事を辞める": "اِسْتَقَالَ",
 "仕事バカ": "مدمن عمل (شخص لديه حاجة قهرية للعمل)",
 "仕事中": "فِي المُنْتَصَف تَمَامًا (الجزء أو النقطة الوسطى أو المركزية)\nمثال: في وسط الغابة",
 "仕事中毒": "إدمان العمل (قهرية تجاه العمل)",
 "仕事中毒者": "مدمن عمل (شخص لديه حاجة قهرية للعمل)",
 "仕事人": "مُحْتَرِف, مُحْتَرِفَة",
 "仕事人間": "مدمن عمل (شخص لديه حاجة قهرية للعمل)",
 "仕事台": "طَاوِلَة عَمَل (قِطْعَة أَثَاث توضع عليها الأشياء، ولها رِجْل أو أكثر. ( أحادي)؛ لُعْبَة مشهورة…)\nمثال: هذه ليست طاولة.",
 "仕事唄": "أغنية عمل (أغنية إيقاعية عادة لمصاحبة العمل المتكرر)",
 "仕事師": "عَامِل, شَغِّيل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة…)\nمثال: توم عامل نفايات.",
 "仕事帰り": "فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "仕事日": "يوم عمل (اليوم الذي يتم فيه إنجاز العمل)",
 "仕事歌": "أغنية عمل (أغنية إيقاعية عادة لمصاحبة العمل المتكرر)",
 "仕事率": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة.",
 "仕事着": "ملابس عمل (ملابس تلبس للقيام بعمل يدوي)",
 "仕事第一主義": "إدمان العمل (قهرية تجاه العمل)",
 "仕事箱": "سلة عمل, صندوق أدوات الخياطة (حاوية لحفظ أدوات ومواد العمل (خاصة للخياطة))",
 "仕事部屋": "غرفة عمل, مشغل (غرفة يتم فيها إنجاز العمل)",
 "仕事量": "حمل العمل, عبء العمل (العمل الذي يُتوقع من الشخص القيام به في وقت محدد)",
 "仕事馬鹿": "مدمن عمل (شخص لديه حاجة قهرية للعمل)",
 "仕付": "تغيير الوجهة ((ملاحة) عملية تغيير وجهة الشراع) / زراعة, غرس (وضع البذور أو النباتات الصغيرة في الأرض لتنمو)\nمثال: زراعة الذرة عمل شاق / تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "仕付け": "تغيير الوجهة ((ملاحة) عملية تغيير وجهة الشراع) / زراعة, غرس (وضع البذور أو النباتات الصغيرة في الأرض لتنمو)\nمثال: زراعة الذرة عمل شاق / تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "仕付ける": "ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو…)\nمثال: للبقرة ذيل طويل. / تغيير الوجهة (الإبحار في مسار متعرج) / نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره)\nمثال: هذا النبات مهدد بالانقراض.",
 "仕付け糸": "تغيير الوجهة ((ملاحة) عملية تغيير وجهة الشراع)",
 "仕似す": "قَلَّدَ",
 "仕儀": "حَالَة, وَضْع",
 "仕入": "شِرَاء, اِشْتِرَاء",
 "仕入れ": "شِرَاء, اِشْتِرَاء",
 "仕入れる": "اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض…)\nمثال: اشترى زيري ذلك. / اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
