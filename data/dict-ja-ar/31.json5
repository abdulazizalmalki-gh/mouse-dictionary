 "九寸五分": "خَنْجَر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين)",
 "九州": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)",
 "九工大": "جرو (صغير أي من حيوانات الفراء المختلفة) / طقم, عدة (معدات تتكون من مجموعة من المواد أو الأدوات لغرض محدد) / حقيبة عدة, طقم (حافظة لاحتواء مجموعة من الأدوات)\nمثال: جرو الثعلب",
 "九帯アルマジロ": "مدرع تساعي الأحزمة (له تسعة أحزمة مفصلية من الصفائح العظمية؛ يمتد نطاقه من تكساس إلى باراغواي)",
 "九拝": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "九時": "اَلسَّاعَة اَلتَّاسِعَة",
 "九月": "سِبْتِمْبِر, سِبْتَمْبِر (الشهر التاسع في السنة الروميّة)\nمثال: بدأ سامي عامه الجامعي في سبتمبر.",
 "九条": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "九柱戯": "سكتلز, لعبة التسعة دبابيس (لعبة بولينغ تُلعب بدحرجة كرة بولينغ في مسار نحو هدف مكون من تسعة دبابيس خشبية)",
 "九死に一生": "فوز بشق الأنفس, نجاة بأعجوبة (شيء تم تحقيقه (أو الهروب منه) بفارق ضئيل)",
 "九死一生": "فوز بشق الأنفس, نجاة بأعجوبة (شيء تم تحقيقه (أو الهروب منه) بفارق ضئيل)",
 "九泉": "هَادِيس",
 "九牛の一毛": "قَطْرَة فِي الْمُحِيط",
 "九牛一毛": "قَطْرَة فِي الْمُحِيط",
 "九献": "غاية, غَرَض",
 "九百": "تِسْعُمِئَة, تِسْعُمِائَة / مُغَفَّل, أَحْمَق",
 "九腸": "مِعًى / مَعْي / مِعَاء / أَمْصِرَة / مَصِير / مُصْرَان",
 "九角形": "تساعي الأضلاع, متسع (مضلع له تسعة أضلاع)",
 "九里": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "九重": "تسعة أضعاف (بمعامل تسعة) / تُسَاعِيّ (ذو تسع وحدات أو مكوّنات)\nمثال: زاد استثماري تسعة أضعاف / مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "九鬼": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "乞い": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "乞い受ける": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك",
 "乞い願う": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك",
 "乞う": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك / صَلَّى, دَعَا",
 "乞丐": "سَائِل / فَقِير",
 "乞児": "تَسَوُّل",
 "乞食": "سَائِل / فَقِير / تَسَوُّل",
 "乞食根性": "جَشَع, طَمَع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع.",
 "也": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / مبلغ, مقدار من المال (كمية من المال)\nمثال: اقترض مبلغاً كبيراً",
 "乱": "ثَارَ, تَمَرَّدَ (ثارَ يَثُورُ ثَوَرانًا، وثَوْرًا، وثَوْرَةً: هاج وانتَشَرَ؛ يُقال: ثارَ الدُّخانُ والغُبَرُ، وثار الدّم بفلان، وثارت به الحصْبَةُ، وثار به الشَّرُّ والغَضَبُ) / عِصْيَان, تَمَرُّد\nمثال: ثار الفلاحون على الحكومة.",
 "乱す": "مُرْتَشٍ, فَاسِد / أَفْسَدَ",
 "乱り": "أَنَانِيّ / مُتَهَوِّر / فَضْفَاض, واسِع / غير عقلاني, غير منطقي (غير متسق مع العقل أو لا يستخدمه) / أصم, غير نسبي (حقيقي ولكن لا يمكن التعبير عنه كحاصل قسمة عددين صحيحين) / عَدَد غَيْر نِسْبِيّ (عدد حقيقي لا يمكن التعبير عنه كعدد نسبي (كسر))\nمثال: مخاوف غير عقلانية",
 "乱り風": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "乱れ": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب",
 "乱交": "إباحية, علاقات متعددة (الانغماس في علاقات جنسية عشوائية وغير مميزة)",
 "乱交パーティー": "باخاناليا, حفلة مجون (تجمع جامح ينطوي على الإفراط في الشرب والانحلال الجنسي) / طقوس العربدة (طقس سري في عبادات الآلهة اليونانية أو الرومانية القديمة ينطوي على الغناء والرقص والشرب والنشاط الجنسي) / عربدة, نوبة إفراط (أي فعل من أفعال الانغماس غير المعتدل)\nمثال: نوبة إفراط في التسوق",
 "乱作": "تجاوز الإنتاج, فرط الإنتاج (إنتاج مفرط أو أكثر من المتوقع)",
 "乱倫": "فاسد, لا أخلاقي (ينتهك عمداً المبادئ المقبولة للصواب والخطأ) / فَاسِد, لَا أَخْلَاقِيّ (لا يلتزم بالمبادئ الأخلاقية أو القِيَمية)",
 "乱入": "تَطَفُّل, مُدَاخَلَة",
 "乱入者": "مُقْتَحِم, دَخِيل",
 "乱切法": "اختبار الخدش (اختبار لتحديد الحساسية لمواد مختلفة عن طريق تطبيقها على خدوش في الجلد)",
 "乱売": "بيع تصفية, تصفية (بيع لتقليل المخزون)",
 "乱売合戦": "حَرْب أَسْعَار, مُنَافَسَة سِعْرِيَّة (منافسة شديدة يقوم فيها المتنافسون بخفض أسعار التجزئة لكسب الأعمال)",
 "乱婚": "إباحية, علاقات متعددة (الانغماس في علاقات جنسية عشوائية وغير مميزة)",
 "乱心": "جُنُون",
 "乱心者": "مَسْلُوبُ العَقْل, مَمْسُوسٌ بِالقَمَر (مجنون ويُعتَقد أنّ جنونه مرتبط بأطوار القمر) / طائش, متهور (شخص متهور مندفع غير مسؤول) / مَجْنُون, مُخْتَلّ عَقْلِيّاً (شخص فاقد للعقل)",
 "乱戦": "شِجَار صَاخِب (قتال صاخب وسط حشد من الناس)",
 "乱打": "صدم, ضرب (فعل ملامسة شيء لآخر)\nمثال: أدى الضرب المتكرر إلى ظهور كدمة كبيرة",
 "乱数発生器": "مولد أرقام عشوائية (روتين مصمم لإنتاج رقم عشوائي)",
 "乱暴": "عُنْف, عَنْف / عُنْف / خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق. / اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "乱暴者": "بَلْطَجِيّ",
 "乱橋": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "乱歩": "سير عشوائي (عملية عشوائية تتكون من سلسلة من التغييرات التي يتم تحديد خصائص كل منها (مثل الحجم أو الاتجاه) عن طريق الصدفة)",
 "乱気流": "اِضْطِرَاب",
 "乱波": "بَلْطَجِيّ / جَاسُوس / تَجَسَّسَ",
 "乱流": "اِضْطِرَاب",
 "乱用": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "乱痴気騒ぎ": "مِضْرَب, مَضَارِب",
 "乱破": "بَلْطَجِيّ / جَاسُوس / تَجَسَّسَ",
 "乱筆": "خربشة",
 "乱筆乱文": "خربشة",
 "乱脈": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب",
 "乱臣": "خَائِن, خَائِنَة (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك!",
 "乱臣賊子": "خَائِن, خَائِنَة (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك!",
 "乱行": "إثم, سوء تصرف (نشاط ينتهك القانون الأخلاقي أو المدني) / سوء سلوك (إدارة سيئة أو غير نزيهة من قبل أشخاص يُفترض أنهم يتصرفون نيابة عن آخرين)\nمثال: نفي ارتكاب أي عمل غير مشروع",
 "乱視": "لَابُؤْرِيّة, اللَانُقَطِيَّة",
 "乱訴": "دعوى كيدية (تقاضي يتبين أنه تم رفعه بشكل كيدي ودون سبب محتمل)",
 "乱調": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "乱調子": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "乱費": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / انحلال, فجور (انغماس منحل في الملذات الحسية) / تبدد, تلاشي (التفكك والتشتت عن طريق التفرق)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "乱軍": "شجار",
 "乱逆": "ثَوْرَة, تَمَرُّد",
 "乱造": "تجاوز الإنتاج, فرط الإنتاج (إنتاج مفرط أو أكثر من المتوقع)",
 "乱闘": "شِجَار صَاخِب (قتال صاخب وسط حشد من الناس) / حفلة صاخبة (حفلة صاخبة أو مليئة بالضجيج والمرح)",
 "乱闘騒ぎ": "شِجَار صَاخِب (قتال صاخب وسط حشد من الناس) / حفلة صاخبة (حفلة صاخبة أو مليئة بالضجيج والمرح)",
 "乱雑": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب",
 "乱離": "مُتَفَرِّق, مُنْتَشِر (مُوَزَّعٌ أَوْ مُمْتَدٌّ عَلَى رُقْعَةٍ جُغْرَافِيَّةٍ وَاسِعَةٍ)",
 "乱雲": "مُزْنَة",
 "乱麻": "فَوْضَى, فَوْضَوِيَّة",
 "乳": "حَلِيب (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ) / لَبَن (سَقَاهُ اللَبَن؛ أكل كثيرا) / حَلَبَ (الشاةَ أو البقرةَ أو الناقةَ: استخرج ما في ضرعها من لبن؛ فلانٌ للرجل: أي حَلَب ماشية الرجل نيابة عنه)\nمثال: كنت أشرب الحليب / ثَدْي, بز / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر. / عُرْوَة, عُقْدَة",
 "乳がん": "سَرَطَان اَلثَّدْي",
 "乳しぼり": "حَلْب (الشاةَ أو البقرةَ أو الناقةَ: استخرج ما في ضرعها من لبن؛ فلانٌ للرجل: أي حَلَب ماشية الرجل نيابة عنه)\nمثال: أخرج زيري دلو الحلب. / أبقار حلوب, ماشية الحليب (الماشية التي تُربى من أجل حليبها)",
 "乳び": "كيلوس (سائل حليبي يتكون من اللمف والدهون المستحلبة؛ يتكون في الأمعاء الدقيقة أثناء هضم الدهون المبتلعة)",
 "乳りん": "هَالَة",
 "乳ガン": "سَرَطَان اَلثَّدْي",
 "乳バンド": "حمالة صدر (رداء داخلي ترتديه النساء لدعم الثديين)",
 "乳兄弟": "أخ بالتبني, أخ بالرضاعة (أخوك بالرضاعة هو ذكر ليس ابناً لوالديك ولكنه تربى عند والديك)",
 "乳児": "رَضِيع",
 "乳児期": "رضاعة, طفولة مبكرة (أبكر مراحل عدم النضج) / طفولة مبكرة, مهد (المرحلة المبكرة من النمو أو التطور)",
 "乳児死亡率": "مُعَدَّل وَفَيَات الرُّضَّع (معدل الوفيات خلال السنة الأولى من الحياة)",
 "乳児院": "رَوْضَة, حَضَانَة / مَشْتَلَة",
 "乳切り木": "مِدرس, مِدرَسة (أداة تتكون من مقبض وعصا حرة التأرجح في نهايته؛ تستخدم في درس الحبوب يدوياً)",
 "乳剤": "مُسْتَحْلَب",
 "乳化剤": "عامل استحلاب, مستحلب (مادة خافضة للتوتر السطحي تعزز تكوين المستحلب)",
 "乳嘴": "حَلَمَة",
 "乳姉妹": "أخت بالتبني, أخت بالرضاعة (أختك بالرضاعة هي أنثى ليست ابنة لوالديك ولكنها تربت عند والديك)",
 "乳幼児": "رَضِيع",
 "乳幼児突然死症候群": "متلازمة موت الرضيع المفاجئ (موت مفاجئ وغير متوقع لرضيع يبدو بصحة جيدة أثناء النوم)",
 "乳房": "ثَدْي, بز / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر.",
