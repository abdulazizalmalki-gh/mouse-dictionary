 "乾酪": "جُبْن, جبنة (جَبَنَ يَجْبُن وجَبُنَ جُبْنًا وجُبُنًا وجَبانةً)\nمثال: قل جبنة يا زيري.",
 "乾酪素": "طلاء الكازين (طلاء مائي مصنوع من بروتين مترسب من الحليب)",
 "乾雪": "ثلج جاف (نوع من الثلج يحتوي على القليل من الماء السائل أو لا يحتوي عليه على الإطلاق…)\nمثال: التزلج في ظروف الثلج الجاف أو المسحوق يمكن أن يكون تحدياً",
 "乾電池": "بطارية جافة, خلية جافة (خلية ليكلانشيه صغيرة لا تحتوي على سائل حر؛ الإلكتروليت عبارة عن عجينة وقطب…)",
 "乾食": "عفن جاف (فطر يسبب العفن الجاف)",
 "乾魚": "سمك مجفف (سمك محفوظ بشقه وتجفيفه بالهواء دون ملح)",
 "乾麺麭": "بقسماط السفينة, خبز البحارة (بسكويت أو خبز صلب جداً غير مملح؛ كان غذاءً أساسياً في السفن قديماً)",
 "亀": "سُلَحْفَاة",
 "亀の子縛り": "إرساء, ربط السفينة (فعل تأمين سفينة واصلة بالحبال)",
 "亀の手": "بَرْنَقِيل",
 "亀の甲": "حلقة البنزين (سلسلة مغلقة من 6 ذرات كربون مع ذرات هيدروجين مرتبطة بها)",
 "亀中": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "亀井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "亀山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "亀島": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "亀田": "اسم مكان (الاسم الذي يُعرف به مكان جغرافي) / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "亀甲": "قط ذبل, قط كاليكو (قط ذو علامات سوداء وكريمية وصفراء)",
 "亀裂": "صَدْع ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ)…)",
 "亀鑑": "نُمُوذَج, نَمَط",
 "亀頭": "حَشَفَة",
 "亀頭冠": "إِكْلِيل الْحَشَفَة",
 "亀頭包皮炎": "التهاب الحشفة والقلفة (التهاب كل من رأس القضيب والقلفة)",
 "亀頭炎": "التهاب الحشفة (التهاب رأس القضيب)",
 "亀頭球": "عُقْدَة\nمثال: أمضى زيري العقد.",
 "了": "فَرَغَ, أَنْهَى\nمثال: انتهى أمر زيري.",
 "了い": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري. / إنهاء, خاتمة (فعل إنهاء شيء ما)\nمثال: إنهاء الاتفاقية",
 "了する": "فَرَغَ, أَنْهَى\nمثال: انتهى أمر زيري. / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "了察": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "了承": "إِقْرَار, اعْتِرَاف (بيان يقر بشيء أو بشخص ما)\nمثال: لا بد أنها رأته لكنها لم تبد أي علامة إقرار بذلك",
 "了承済み": "مُعْتَرَف بِه, مُقَرّ بِه (تم التعرف عليه أو الإعلان عنه أو الإقرار به)\nمثال: القائد المعترف به للمجتمع",
 "了然": "بَدِيهِيّ, بَدَهِيّ",
 "了知": "مُطَّلِع, وَاسِعُ الثَّقَافَة (على درجة عالية من التعليم؛ ذو معلومات أو فهم واسع)",
 "了簡": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة. / حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية)\nمثال: رجل ذو فطنة / مَغْفِرَة, غُفْرَان",
 "了簡違い": "خِدَاع, ضَلَالَة",
 "了見": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة. / حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية)\nمثال: رجل ذو فطنة / مَغْفِرَة, غُفْرَان",
 "了見違い": "خِدَاع, ضَلَالَة",
 "了解": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "了解事項": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "了解済み": "مَقْبُول, مُعْتَرَف بِه (حائز على القبول العامّ أو يفرض الاعتراف)",
 "予": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "予々": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي))\nمثال: قد أثلجت كثيرا.",
 "予て": "قَبْلًا, قَبْل",
 "予てから": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي))\nمثال: قد أثلجت كثيرا.",
