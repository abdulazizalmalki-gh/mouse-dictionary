 "冷却": "تبريد, نظام تبريد (آلية للحفاظ على برودة شيء ما) / تبريد, خفض درجة الحرارة (عملية التحول إلى البرودة؛ انخفاض درجة الحرارة)\nمثال: كان التبريد عبارة عن مراوح سقفية",
 "冷却ファン": "مِرْوَحَة, مروحة / مِرْوَحَة, هَوَّايَة / مُشَجِّع, مُشَجِّعَة",
 "冷却剤": "مُبَرِّد",
 "冷却器": "ثَلَّاجَة",
 "冷却塔": "برج تبريد (نظام تبريد يستخدم في الصناعة لتبريد الماء الساخن (عن طريق التبخر الجزئي) قبل إعادة استخدامه كمبرد)",
 "冷却材": "مُبَرِّد",
 "冷却水": "مُبَرِّد",
 "冷却液": "مُبَرِّد",
 "冷却用": "ماص للحرارة ((عن تفاعل كيميائي أو مركب) يحدث أو يتشكل مع امتصاص للحرارة)",
 "冷厳": "بَشِع, مَكَابِرِيّ (منفّر بشكل صادم؛ يثير الرعب والاشمئزاز) / قَاتِم, كَئِيب (يبعث على الحزن والكآبة) / كَئِيب, مُكْتَئِب (مَمْلُوءٌ بِالكَآبَةِ وَالقُنُوط) / صَارِم, لَا يَرْحَم (لا يمكن استرضاؤه أو ثَنيه بالتوسّل)",
 "冷嘲": "تَكْشِيرَة سَاخِرَة, نَظْرَة ازْدِرَاء (تعبير وجهي يدل على الازدراء أو الاحتقار (برفع الشفة العليا)) / تَعْلِيق مُتَهَكِّم, مُلَاحَظَة سَاخِرَة (ملاحظة ازدرائية أو محتقرة)",
 "冷媒": "تَبْرِيدِيّ, مُبَرِّد (يُسبِّب التبريد أو التجميد) / مادة تبريد, وسيط تبريد (أي مادة تستخدم للتبريد (كما في الثلاجة))",
 "冷寒": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "冷床": "إطار بارد, دفيئة باردة (غطاء واقٍ يتكون من إطار خشبي ذي سطح زجاجي تُحمى فيه النباتات الصغيرة من البرد)",
 "冷徹": "رَشِيد, سَدِيدُ الرَّأْي (يمارس الحكم السليم أو يُظهِره)",
 "冷感症": "برود جنسي (تراجع أو غياب الرغبة الجنسية)",
 "冷戦": "الْحَرْب الْبَارِدَة / حَرْب بَارِدَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "冷房": "تَكْيِيف",
 "冷房器": "مُكَيِّف هَوَاء",
 "冷房完備": "مُكَيَّف (مُبرَّد بجهاز تكييف الهواء)",
 "冷房機": "مُكَيِّف هَوَاء",
 "冷房車": "مُكَيَّف (مُبرَّد بجهاز تكييف الهواء)",
 "冷気": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "冷水": "إِحْبَاط, تَثْبِيط (التقليل من شأن خطة أو أمل أو توقع)\nمثال: سكبت الماء البارد على فكرة الذهاب إلى أفريقيا بأكملها",
 "冷水器": "بَرَّاد",
 "冷水塔": "برج تبريد (نظام تبريد يستخدم في الصناعة لتبريد الماء الساخن (عن طريق التبخر الجزئي) قبل إعادة استخدامه كمبرد)",
 "冷水機": "بَرَّاد",
 "冷汗": "عرق بارد (الحالة الجسدية للتعرق المتزامن مع القشعريرة؛ مرتبطة بالخوف)",
 "冷涼": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا.",
 "冷淡": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا. / بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "冷淡無情": "قَاسٍ, مُتَحَجِّر المَشَاعِر (متصلّب عاطفيًّا؛ فاقد للرقّة الإنسانية) / سَمِيك الجِلْد, مُتَثَفِّن (عليه ثفن؛ ذو جلد أصبح سميكًا وخشنًا من كثرة الاستعمال)",
 "冷温": "انخفاض درجة الحرارة, برد (غياب الحرارة)\nمثال: جعلت البرودة أنفاسنا مرئية",
 "冷然": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "冷珈琲": "قَهْوَة مُثْلِجَة (مشروب يحضر بغلي مطحون البُنّ؛ المحل أو الدكان الذي تُقدَّم فيه القهوة وغيرها من المشروبات)\nمثال: لا أفضل القهوة.",
 "冷笑": "تَكْشِيرَة سَاخِرَة, نَظْرَة ازْدِرَاء (تعبير وجهي يدل على الازدراء أو الاحتقار (برفع الشفة العليا)) / تَعْلِيق مُتَهَكِّم, مُلَاحَظَة سَاخِرَة (ملاحظة ازدرائية أو محتقرة)",
 "冷笑的": "ساخر",
 "冷罵": "تَكْشِيرَة سَاخِرَة, نَظْرَة ازْدِرَاء (تعبير وجهي يدل على الازدراء أو الاحتقار (برفع الشفة العليا)) / تَعْلِيق مُتَهَكِّم, مُلَاحَظَة سَاخِرَة (ملاحظة ازدرائية أو محتقرة)",
 "冷菓": "تحلية مجمدة (أي من الحلويات المتنوعة التي تُحضر بالتجميد)",
 "冷蔵": "تخزين بارد, تخزين بالتبريد (تخزين مبرد للحفظ) / تجميد, حفظ بارد (في حالة تعليق أو تأجيل)",
 "冷蔵庫": "ثَلَّاجَة",
 "冷蔵法": "تبريد علاجي (خفض درجة حرارة الجسم عمداً لأغراض علاجية) / تبريد, تثليج (عملية تبريد أو تجميد (مثل الطعام) لأغراض الحفظ)\nمثال: التبريد عن طريق غمر جسم المريض في حمام بارد",
 "冷蔵車": "عربة تبريد (عربة شحن مجهزة بنظام تبريد)",
 "冷血": "غلظة, قسوة القلب (غياب الاهتمام برفاهية الآخرين) / بِدَم بَارِد",
 "冷血動物": "بَارِد الدَّم, عَدِيم الرَّحْمَة (بلا وخز ضمير أو إحساس إنساني) / ذوات الدم البارد (لديه دم بارد (في الحيوانات التي لا يتم تنظيم درجة حرارة جسمها داخليًا))",
 "冷血漢": "بَارِد الدَّم, عَدِيم الرَّحْمَة (بلا وخز ضمير أو إحساس إنساني) / ذوات الدم البارد (لديه دم بارد (في الحيوانات التي لا يتم تنظيم درجة حرارة جسمها داخليًا))",
 "冷評": "النقد الساخر, سُخْرِيَّة",
 "冷遇": "جَفَاء, سُوء الِاسْتِقْبَال (ترحيب غير لطيف وغير مراعٍ)\nمثال: لقد فوجئ بمثل هذا الجفاء",
 "冷酷": "قَسْوَة, وَحْشِيَّة",
 "冷酷無情": "عديم الرحمة, قاسٍ (ليس لديه أو لا يظهر أي رحمة)\nمثال: العدو عديم الرحمة",
 "冷酷無惨": "عديم الرحمة, قاسٍ (ليس لديه أو لا يظهر أي رحمة)\nمثال: العدو عديم الرحمة",
 "冷酷無慙": "عديم الرحمة, قاسٍ (ليس لديه أو لا يظهر أي رحمة)\nمثال: العدو عديم الرحمة",
 "冷酷無慚": "عديم الرحمة, قاسٍ (ليس لديه أو لا يظهر أي رحمة)\nمثال: العدو عديم الرحمة",
 "冷酷無残": "عديم الرحمة, قاسٍ (ليس لديه أو لا يظهر أي رحمة)\nمثال: العدو عديم الرحمة",
 "冷静": "هُدُوء",
 "冷風扇": "مبرد تبخيري, مكيف صحراوي (نظام تبريد يبرد عن طريق التبخر)",
 "冷食": "أغذية مجمدة, طعام مجمد (طعام محفوظ بالتجميد)",
 "冷飯": "مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "冷飯食い": "مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "凄い": "فَظِيع / مُرْعِب / فَظِيع, أَرْبَد / مُدْهِش, مُذْهِل / بثقل, بشكل كبير (بدرجة كبيرة)\nمثال: اعتمد بشكل كبير على بيانات الآخرين / بشكل رهيب, جداً (تستخدم للتوكيد) / بشكل سيء للغاية, بشكل فظيع (بطريقة فظيعة) / بشكل مروع, بفظاعة (من نوع مروع)\nمثال: مثير للاهتمام جداً",
 "凄く": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "凄まじい": "فَظِيع / مُرْعِب / فَظِيع, أَرْبَد / عَظِيم, هَائِل (كبير بشكل استثنائي في الحجم أو المدى أو الكمية أو القوة أو الدرجة) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف) / شَدِيد, مَهُول (بالغ في الدرجة أو المدى أو المقدار أو التأثير) / مُذْهِل, مُفْزِع (يسبب الذعر والفزع) / أمر مروع, فاجعة (تجربة تثير الفزع أو الروعة)\nمثال: هل من الأفضل رؤية الأمر المروع أم مجرد السماع عنه؟",
 "凄み": "بَشَاعَة, شَنَاعَة (صفة كون الشيء مروعاً أو بشعاً) / تَرْهِيب, تَخْوِيف",
 "凄みをきかせる": "هَدَّدَ / أَنْذَرَ",
 "凄みを利かす": "هَدَّدَ / أَنْذَرَ",
 "凄みを利かせる": "هَدَّدَ / أَنْذَرَ",
 "凄みを効かす": "هَدَّدَ / أَنْذَرَ",
 "凄みを効かせる": "هَدَّدَ / أَنْذَرَ",
 "凄む": "هَدَّدَ / أَنْذَرَ",
 "凄惨": "بَشِع, مَكَابِرِيّ (منفّر بشكل صادم؛ يثير الرعب والاشمئزاز) / قَبْرِيّ, مَشْؤُوم (يوحي بشكل مروّع بالموت أو الأموات)",
 "凄愴": "سَخِيف, مُثِير لِلشَّفَقَة (يُثِير شَفَقَةً مَشُوبَةً بِالاِزْدِرَاء) / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا)",
 "凄烈": "عَاصِف, مُضْطَرِب (شَدِيد الهَيَجَان والاضْطِرَاب) / شَرِس, ضَارٍ (عَدِيمُ الرَّحْمَةِ فِي المُنَافَسَة) / جَامِح, حَادّ (يَتَّسِمُ بِشِدَّةٍ مُتَطَرِّفَةٍ فِي المَشَاعِرِ أَوِ القَنَاعَات؛ يَمِيلُ إِلَى رَدِّ الفِعْلِ العَنِيف) / شَرِس, ضَارٍ (يَتَّسِمُ بِطَاقَةٍ بَالِغَةِ العُنْفِ وَالشِّدَّة)",
 "凄絶": "مُتَوَهِّج بِحُمْرَة (يَلْمَع بِتَوَهُّجٍ أَحْمَرَ غَيْرِ طَبِيعِيّ كَالنَّار خِلَال الدُّخَان) / كَامِد, مُصْفَرّ (ذو لون شاحب مريض ومُنفِّر) / صَادِم, فَظِيع (صارخ الوضوح والتصوير؛ يتسم بالإثارة المبالغ فيها) / فَظِيع, مُرَوِّع (مُرْعِبٌ فِي ضَرَاوَتِهِ أَوْ وَحْشِيَّتِه)",
 "凄腕": "إخضاع, سيادة (فعل السيطرة على شخص ما أو إخضاعه) / إتقان, تمكن (مهارة ومعرفة كبيرة بموضوع أو نشاط ما) / تفوق, سيادة (القدرة على الهيمنة أو الفوز)\nمثال: تمكن جيد من الفرنسية / طَمُوح, مُثَابِر (شخص يتقدم مساره المهني بسرعة؛ شخص ذو همة عالية)",
 "准士官": "مساعد (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "准将": "عميد بحري, كومودور (ضابط بحري مفوض رتبته أعلى من قبطان وأقل من لواء بحري؛ أدنى درجة من درجات الأدميرال)",
 "准尉": "مساعد (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "准教授": "أستاذ مشارك (معلم برتبة أقل من أستاذ كامل ولكن أعلى من أستاذ مساعد)",
 "准男爵": "بارونيت (عضو في رتبة الشرف البريطانية؛ رتبته أقل من بارون ولكن أعلى من فارس)",
 "准看": "ممرضة عملية مرخصة (ممرضة لديها تدريب كافٍ لترخيصها من قبل الدولة لتقديم الرعاية الروتينية للمرضى)",
 "准看護婦": "ممرضة عملية مرخصة (ممرضة لديها تدريب كافٍ لترخيصها من قبل الدولة لتقديم الرعاية الروتينية للمرضى)",
 "准看護師": "ممرضة عملية مرخصة (ممرضة لديها تدريب كافٍ لترخيصها من قبل الدولة لتقديم الرعاية الروتينية للمرضى)",
 "准空尉": "مساعد (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "准行": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "准許": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض.",
 "凋尽": "مُبِيد, مُدَمِّر (يَتَسَبَّبُ أَوْ يَقْدِرُ عَلَى التَّدْمِيرِ الكَامِلِ) / سَاحِقٌ, مَاحِقٌ (يستخف بالآخرين ويحقرهم) / ذبول, ضمور (أي ضعف أو تدهور (خاصة بسبب عدم الاستخدام))",
 "凋残": "خَرِب, مُنْتَهٍ (أُوصِلَ إِلَى الخَرَاب) / خَرِب, مُدَمَّر (مُدمَّر جسدياً أو أخلاقياً) / مُنْتَهٍ, هَالِك (محكوم عليه بالفناء والزوال)",
 "凋落": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "凌ぎ": "صَبُور, طَوِيلُ البَال (يَتَحَمَّلُ بِصَبْرٍ الظُّلْمَ أَوِ المَتَاعِبَ المُسْتَمِرَّة) / خَالِد, رَاسِخ (يبقى مدّة طويلة؛ لا يزول بسهولة)",
 "凌ぎ場": "مَلَاذ (مَلْجَأ، مَأْوَى) / مَخْلَص (الشخص الذي يفي ولا يخون)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "凌ぐ": "تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ / نَجَا / فَاقَ, تَجَاوَزَ",
 "凌波性": "صلاحية للإبحار (اللياقة لعبور البحار)",
 "凌虐": "إِذْلَال, ذِلَّة",
 "凌辱": "سَبَّ, شَتَمَ (تفاحة) / إهانة\nمثال: كتب سامي رواية تحتوى على أكثر من سب مئة صفحة. / اِعْتِدَاء جِنْسِيّ",
 "凌霄葉蓮": "كَبُوسِين",
 "凌駕": "فَائِق, هَائِل (يتجاوز بكثير ما هو معتاد في الحجم أو الدرجة) / فَائِق, مُتَعَالٍ (يتجاوز الحدود المعتادة لا سيما في التفوق)",
 "凍える": "تَجَمَّدَ",
 "凍つ": "تَجَمَّدَ",
 "凍てつく": "تَجَمَّدَ",
 "凍てる": "تَجَمَّدَ",
 "凍て付く": "تَجَمَّدَ",
 "凍みる": "تَجَمَّدَ",
 "凍らす": "تَجَمَّدَ",
 "凍り": "جَلِيد, ثَلْج",
 "凍りつく": "تَجَمَّدَ",
 "凍り付く": "تَجَمَّدَ",
 "凍る": "تَجَمَّدَ\nمثال: 道が凍っているから気を付けなさい。 — الطريق متجمد، لذا انتبه.",
 "凍れる": "تَجَمَّدَ",
 "凍上": "انتفاخ صقيعي, رفع صقيعي (ارتفاع في الأرض أو الرصيف ناتج عن تجمد التربة الرطبة)",
 "凍傷": "تَثْلِيج, قَضْمَة صَقِيع",
 "凍原": "تُنْدْرَا",
 "凍寒": "صَقِيع / صَقِيع, صَقْعَة",
 "凍瘡": "تورم بردي, شرى البرد (التهاب اليدين والقدمين الناتج عن التعرض للبرد والرطوبة)",
 "凍石": "حجر صابوني, ستيتيت (نوع مضغوط ثقيل وناعم من التلك ذو ملمس صابوني؛ يستخدم لصنع المواقد وأسطح الطاولات والزخارف)",
 "凍結": "تجمد, تجميد (سحب الحرارة لتحويل شيء من سائل إلى صلب)",
 "凍結乾燥": "تجفيد, تجفيف بالتجميد (طريقة لتجفيف الطعام أو بلازما الدم أو الأدوية أو الأنسجة دون تدمير بنيتها المادية؛ حيث يتم تجميد المادة ثم تدفئتها في فراغ ليتسامى الجليد)",
 "凍結器": "فريزر, مجمد (ثلاجة كهربائية يُجمد فيها الطعام ويُحفظ لفترات طويلة)",
 "凍結手術": "جراحة بالتبريد (استخدام البرودة الشديدة (عادة النيتروجين السائل) لتدمير الأنسجة غير المرغوب فيها (الثآليل أو إعتام عدسة العين أو سرطانات الجلد))",
 "凍結療法": "عِلَاج بِالتَّبْرِيد",
 "凍結防止剤": "مانع التجمد, مضاد التجمد (سائل يضاف إلى الماء في نظام التبريد لخفض نقطة تجمده)",
 "凍餒": "حرمان (فعل حرمان شخص ما من الطعام أو المال أو الحقوق) / حرمان, عوز (حالة من الفقر المدقع)",
 "凛": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا. / رزين, مهيب (يمتلك أو يعبر عن الكرامة؛ خاصة الرسمية أو الهيبة في السلوك أو المظهر) / مُعْتَزّ بِنَفْسِه, وَقُور (يمتلك أو يُظهِر تقديرًا واحترامًا للذات)\nمثال: سلوكها الوقور / صِيغَة, صِيغَةُ الْفِعْل / مُتَوَتِّر / شَفَّاف / وَاضِح",
 "凛々": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع) / عَضَّة / قَارِس / لَاذِع, جَارِح / عَقُور, لَاسِع",
 "凛々しい": "بَاسِل, صَنْدِيد (لَا يَتَرَاجَع فِي المَعْرَكَة أَوِ العَمَل) / فُرُوسِيّ, نَبِيل (يُبدي اهتماماً بالنساء كالفارس المثالي) / جَلِيل, شَامِخ (يتحلّى بالوقار والنُّبل الكبيرين أو يُظهرهما) / أَنِيق, جَرِيء (حيويّ ومفعم بالحماس والأناقة)",
 "凛乎": "مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله)",
 "凛冽": "عَضَّة / قَارِس / لَاذِع, جَارِح / عَقُور, لَاسِع",
 "凛凛": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع) / عَضَّة / قَارِس / لَاذِع, جَارِح / عَقُور, لَاسِع",
 "凛凛しい": "بَاسِل, صَنْدِيد (لَا يَتَرَاجَع فِي المَعْرَكَة أَوِ العَمَل) / فُرُوسِيّ, نَبِيل (يُبدي اهتماماً بالنساء كالفارس المثالي) / جَلِيل, شَامِخ (يتحلّى بالوقار والنُّبل الكبيرين أو يُظهرهما) / أَنِيق, جَرِيء (حيويّ ومفعم بالحماس والأناقة)",
 "凛烈": "عَضَّة / قَارِس / لَاذِع, جَارِح / عَقُور, لَاسِع",
 "凛然": "مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله) / مُرّ (فَاتَ ومَضَى؛ الحدثُ أو الأمرُ: حدث وانتهى) / أَلِيم / مَقِيت, مَمْقُوت (مَقيت: ( اسم )؛ مُقِيت: ( اسم ))\nمثال: مر زيري بجانبي.",
 "凜": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا. / رزين, مهيب (يمتلك أو يعبر عن الكرامة؛ خاصة الرسمية أو الهيبة في السلوك أو المظهر) / مُعْتَزّ بِنَفْسِه, وَقُور (يمتلك أو يُظهِر تقديرًا واحترامًا للذات)\nمثال: سلوكها الوقور / صِيغَة, صِيغَةُ الْفِعْل / مُتَوَتِّر / شَفَّاف / وَاضِح",
 "凜々": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع) / عَضَّة / قَارِس / لَاذِع, جَارِح / عَقُور, لَاسِع",
 "凜々しい": "بَاسِل, صَنْدِيد (لَا يَتَرَاجَع فِي المَعْرَكَة أَوِ العَمَل) / فُرُوسِيّ, نَبِيل (يُبدي اهتماماً بالنساء كالفارس المثالي) / جَلِيل, شَامِخ (يتحلّى بالوقار والنُّبل الكبيرين أو يُظهرهما) / أَنِيق, جَرِيء (حيويّ ومفعم بالحماس والأناقة)",
 "凜乎": "مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله)",
 "凜凜": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع) / عَضَّة / قَارِس / لَاذِع, جَارِح / عَقُور, لَاسِع",
 "凜凜しい": "بَاسِل, صَنْدِيد (لَا يَتَرَاجَع فِي المَعْرَكَة أَوِ العَمَل) / فُرُوسِيّ, نَبِيل (يُبدي اهتماماً بالنساء كالفارس المثالي) / جَلِيل, شَامِخ (يتحلّى بالوقار والنُّبل الكبيرين أو يُظهرهما) / أَنِيق, جَرِيء (حيويّ ومفعم بالحماس والأناقة)",
 "凜然": "مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله) / مُرّ (فَاتَ ومَضَى؛ الحدثُ أو الأمرُ: حدث وانتهى) / أَلِيم / مَقِيت, مَمْقُوت (مَقيت: ( اسم )؛ مُقِيت: ( اسم ))\nمثال: مر زيري بجانبي.",
 "凝": "كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم)\nمثال: السحابة هي كتلة بخار في السماء. / تململ, قلق (عدم القدرة على الراحة أو الاسترخاء أو السكون) / عدم ارتياح, قلق (سمة عدم الارتياح) / ارتباك, وعي مفرط بالذات (إحراج نابع من الشعور بأن الآخرين يراقبونك بشكل نقدي) / توتر, قلق (مشاعر القلق التي تجعلك متوتراً وسريع الانفعال)",
 "凝った": "مُفَصَّل",
 "凝らす": "تَجَمَّدَ / تَفَكَّرَ, فَكَّرَ / رَكَّزَ (وضع الشيء بثبات في مكانه؛ أثبت الشيء أو ثبّتَه، وخاصة في مكان محدد) / رَكَّزَ, تَرَكَّزَ (وضع الشيء بثبات في مكانه؛ أثبت الشيء أو ثبّتَه، وخاصة في مكان محدد) / مركز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: فقط ركز يا زيري. / جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو النَّمُوِّ)",
 "凝らせる": "تَجَمَّدَ",
 "凝り": "كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم)\nمثال: السحابة هي كتلة بخار في السماء. / تململ, قلق (عدم القدرة على الراحة أو الاسترخاء أو السكون) / عدم ارتياح, قلق (سمة عدم الارتياح) / ارتباك, وعي مفرط بالذات (إحراج نابع من الشعور بأن الآخرين يراقبونك بشكل نقدي) / توتر, قلق (مشاعر القلق التي تجعلك متوتراً وسريع الانفعال) / تجمّد, تخثر (عملية التجمد؛ التصلب عن طريق (أو كما لو كان عن طريق) التجميد)",
 "凝り固まる": "تَجَلَّطَ, تَخَثَّرَ / جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو النَّمُوِّ)",
 "凝り屋": "كَمَالِيّ",
 "凝り性": "استحواذ فكري, هوس أحادي (هوس يقتصر على شيء واحد أو فكرة واحدة)",
 "凝る": "جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو النَّمُوِّ)",
 "凝乳": "خُثَارَة, أَقِط",
 "凝固": "تجلط, تخثر (عملية تشكيل كتل شبه صلبة في سائل)",
 "凝固まり": "تجلط, تخثر (عملية تشكيل كتل شبه صلبة في سائل)",
 "凝固剤": "عامل تجلط, مخثر (عامل ينتج التخثر)",
 "凝固因子": "عامل التخثر (أي من العوامل في الدم التي تعد أفعالها ضرورية لتخثر الدم)",
 "凝固点": "نقطة الانصهار, نقطة التجمد (درجة الحرارة التي يتحول تحتها السائل إلى صلب)",
 "凝塊": "جلطة, خثرة (كتلة من مادة تشكلت من محتوى سائل)",
 "凝析": "تجلط, تخثر (عملية تشكيل كتل شبه صلبة في سائل)",
 "凝滞": "تَأْخِير, تَأَخَّر / أَجَّلَ, أَبْطَأَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "凝灰岩": "توف, طوفة بركانية (صخر بركاني صلب يتكون من رماد بركاني مضغوط)",
 "凝然": "بسكون تام, بلا حراك (بدون حركة أو إصدار صوت) / رَاسِخ, مُتَسَمِّر (ساكن تمامًا؛ لا يتحرك إطلاقًا)\nمثال: جلس بلا حراك كالتمثال",
 "凝然として": "بِهُدُوء",
 "凝着": "اِلْتِصَاق",
 "凝着力": "اِلْتِصَاق",
 "凝結": "تصلب, تصلد (عملية التحول إلى صلب أو قاسي عن طريق التبريد أو التجفيف أو التبلور)\nمثال: تصلب الخرسانة / تجلط, تخثر (عملية تشكيل كتل شبه صلبة في سائل) / تكثيف, تكميد (فعل زيادة كثافة شيء ما) / تكثيف ((التحليل النفسي) عملية لاواعية تتحد فيها فكرتان أو صورتان في رمز واحد؛ خاصة في الأحلام) / إيجاز, تهذيب (نسخة مختصرة من عمل مكتوب) / انضغاط, تقلص (عملية أو نتيجة أن يصبح الشيء أصغر أو مضغوطاً معاً)\nمثال: تقلص الغاز عند التبريد",
 "凝縮": "تكثيف, تكميد (فعل زيادة كثافة شيء ما) / تكثيف ((التحليل النفسي) عملية لاواعية تتحد فيها فكرتان أو صورتان في رمز واحد؛ خاصة في الأحلام) / إيجاز, تهذيب (نسخة مختصرة من عمل مكتوب) / انضغاط, تقلص (عملية أو نتيجة أن يصبح الشيء أصغر أو مضغوطاً معاً)\nمثال: تقلص الغاز عند التبريد",
 "凝縮熱": "حرارة التكثف (حرارة تتحرر بواسطة وحدة كتلة من الغاز عند نقطة غليانه عندما يتكثف إلى سائل)\nمثال: حرارة التكثف تساوي حرارة التبخر",
 "凝縮物": "تكثف, ندى (رطوبة جوية تكثفت بسبب البرودة) / مُتكاثف (ناتج عملية التكثيف)",
 "凝華": "خلع, عزل (فعل عزل شخص ما؛ إزالة شخص قوي من منصب أو وظيفة) / إيداع, وضع (عملية وضع شيء ما في مكان ما) / إفادة, شهادة خطية ((قانون) استجواب تمهيدي لشاهد قبل المحاكمة؛ عادة ما يتم في مكتب محام) / ترسب, رواسب (العملية الطبيعية لترسب شيء ما)",
 "凝血": "خُثْرَة, جُلْطَة",
 "凝視": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ فُلاناً: إِذا أَصَابَ حَدَقَتَه؛ حدَق به:أَحَاطَ به من كلّ جهة (حدَقت قوات الأمن بالقرية))\nمثال: حدق الجميع في وجهي.",
 "凝議": "تداول, تريث (سمة التفكير المتأني في العمل أو القرار) / بطء, تأنٍ (معدل يظهر غياب العجلة أو التسرع) / تداول, روية (تفكير متأنٍ وحذر) / تعمد, حساب (تخطيط شيء ما بعناية وعن قصد)\nمثال: كان رجلاً ذا تداول قضائي",
 "凝集": "تجميع كتلي, تكتل (فعل الجمع في كتلة) / تكتل, تكدس (مجموعة أو كتلة مختلطة بشكل عشوائي) / تماسك ((في الفيزياء) القوة بين الجزيئية التي تربط جزيئات مادة صلبة أو سائلة معاً) / التحام, تلاصق ((علم النبات) العملية في بعض النباتات حيث تنمو الأجزاء معًا والتي عادة ما تكون منفصلة (مثل البتلات)) / تلاحم, تماسك (حالة التماسك أو الالتصاق معاً) / تماسك نصي, سبك ((في اللغويات) الربط النحوي والمعجمي داخل نص أو جملة مما يربط النص ببعضه ويعطيه معنى) / تلبد (عملية التلبد؛ تشكيل تجمعات صوفية تشبه السحب) / إلصاق (بناء الكلمات من المورفيمات المكونة التي تحتفظ بشكلها ومعناها في عملية الجمع) / تراص, تلازن (تكتل البكتيريا أو الخلايا الحمراء عند ربطها معًا بواسطة الأجسام المضادة (الراصات)) / تراص, تلازن (التحام الجزيئات الصغيرة العالقة في محلول؛ مما يؤدي عادة إلى ترسب هذه الكتل الأكبر)",
 "凝集剤": "عامل تجلط, مخثر (عامل ينتج التخثر)",
 "凝集原": "مستضد ملزن, مولد التلزن (أي مادة تعمل كمستضد لتسبب إنتاج الراصة (الأجسام المضادة الملزنة))",
 "凝集塊": "إِجْمَالِيّ, مَجْمُوع / سْكَانْدَا",
 "凝集素": "راصة (جسم مضاد يسبب تراص مستضد معين)",
 "几": "مِرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق. / مَكْتَب, مِنْضَدَة (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب.",
 "几帳": "حِجَاب, سِتَارَة (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "几帳面": "مَنْهَجِيّ, مُنَظَّم (يتسم بالمنهجية والدقة في الترتيب)",
 "几案": "مَكْتَب, مِنْضَدَة (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب.",
 "凡": "عَادِيّ, مَأْلُوف",
 "凡々": "عَادِيّ, مَأْلُوف",
 "凡そ": "حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / عَلَى وَشَكِ (يفيد الاستعلاء؛ يفيد التعليل) / عَن (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى) / حَوَالِي\nمثال: رقصنا حول النار. / عُمُومًا / بِوَجْهٍ عَامّ / تَمَامًا / لَخَّصَ, اِخْتَصَرَ",
 "凡ての道はローマに通ず": "كُلُّ الطُّرُقِ تُؤَدِّي إِلَى رُومَا",
 "凡ならざる": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو نوعه) / فَرِيد, نَادِر (يتميز بجودة غير مألوفة؛ خاصة من الدرجة العليا أو المتطرفة في نوعه)\nمثال: طيور غير شائعة",
 "凡体": "تَوَسُّط, رَدَاءَة نِسْبِيَّة (العادية نتيجة لكون الشيء متوسطاً وغير متميز) / شَخْص مِنَ الدَّرَجَة الثَّانِيَة, مُتَوَسِّط الْمُسْتَوَى (شخص ذو قدرة أو قيمة من الدرجة الثانية)",
 "凡例": "أُسْطُورَة / مِفْتَاح خَرِيطَة (مفتاح)\nمثال: بحث عن المفتاح.",
 "凡俗": "تَوَسُّط, رَدَاءَة نِسْبِيَّة (العادية نتيجة لكون الشيء متوسطاً وغير متميز) / شَخْص مِنَ الدَّرَجَة الثَّانِيَة, مُتَوَسِّط الْمُسْتَوَى (شخص ذو قدرة أو قيمة من الدرجة الثانية)",
 "凡凡": "عَادِيّ, مَأْلُوف",
 "凡常": "عَادِيّ, مَأْلُوف",
 "凡庶": "عامة الناس, قوم (الناس بشكل عام (وغالباً ما تستخدم بصيغة الجمع))\nمثال: إنهم مجرد ناس ريفيين",
 "凡庸": "مُتَوَسِّط",
 "凡愚": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "凡才": "تَوَسُّط, رَدَاءَة نِسْبِيَّة (العادية نتيجة لكون الشيء متوسطاً وغير متميز) / شَخْص مِنَ الدَّرَجَة الثَّانِيَة, مُتَوَسِّط الْمُسْتَوَى (شخص ذو قدرة أو قيمة من الدرجة الثانية)",
 "凡百": "مُخْتَلِف, مُتَنَوَّع",
 "処": "مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس / خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم. / مِنْطَقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة. / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / مَطْعَم",
 "処々方々": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "処す": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع) / حَكَمَ, أَدَانَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "処する": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع) / حَكَمَ, أَدَانَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "処世訓": "مَبْدَأ (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه)",
 "処処方方": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "処分": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / إدارة, تصريف أمور (طريقة لرعاية أو إدارة شؤون مجموعة من الناس (خاصة الشؤون التجارية للمجموعة)) / طاحنة نفايات, فرامة مخلفات (جهاز مطبخ للتخلص من مخلفات الطعام) / تصرف (القدرة على استخدام شيء أو شخص (تحت التصرف))\nمثال: استخدم كل الموارد المتاحة تحت تصرفه / قِيَاس / فَاصِلَة / إِجْرَاء / قَاسَ (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "処分場": "محطة معالجة مياه الصرف الصحي (منشأة للتخلص من مياه الصرف الصحي)",
 "処刑": "تَنْفِيذ / إِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "処刑台": "سِقَالَة, إِسْقَالَة",
 "処女": "بتول, بِكْر (المنقطعه عن الرجال) / إطلاق, تدشين (فعل البدء بشيء جديد) / ظهور أول (تقديم فتاة للمجتمع لأول مرة)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "処女受胎": "ميلاد, ولادة عذرية (العقيدة اللاهوتية القائلة بأن يسوع المسيح لم يكن له أب بشري؛ يعتقد المسيحيون أن ولادة يسوع حققت نبوءات العهد القديم وحضرتها المعجزات؛ يُحتفل بالميلاد…) / توالد عذري, ولادة عذرية (حمل بشري دون إخصاب من قبل رجل)",
 "処女喪失": "تَصَرُّف",
 "処女宮": "بُرْج الْعَذْرَاء, الْعَذْرَاء (ظهر وارتفع) / بُرْج اَلْعَذْرَاء, العذراء (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "処女性": "بَكَارَة, بَتُولِيَّة",
 "処女懐胎": "ميلاد, ولادة عذرية (العقيدة اللاهوتية القائلة بأن يسوع المسيح لم يكن له أب بشري؛ يعتقد المسيحيون أن ولادة يسوع حققت نبوءات العهد القديم وحضرتها المعجزات؛ يُحتفل بالميلاد…) / توالد عذري, ولادة عذرية (حمل بشري دون إخصاب من قبل رجل)",
 "処女林": "غابة بكر, غابة قديمة النمو (غابة أو أرض حرجية ذات نظام بيئي ناضج أو مفرط النضج لم يتأثر تقريباً بالنشاط البشري)",
 "処女生殖": "توالد عذري (عملية تتطور فيها البويضة غير المخصبة إلى فرد جديد؛ شائعة بين الحشرات وبعض المفصليات الأخرى) / توالد عذري, ولادة عذرية (حمل بشري دون إخصاب من قبل رجل)",
 "処女膜": "غِشَاء اَلْبَكَارَة",
 "処女航海": "رحلة بحرية أولى (أول رحلة بحرية من نوعها)\nمثال: في عام 1912 غرقت سفينة تايتانيك في رحلتها الأولى",
 "処女降誕": "ميلاد, ولادة عذرية (العقيدة اللاهوتية القائلة بأن يسوع المسيح لم يكن له أب بشري؛ يعتقد المسيحيون أن ولادة يسوع حققت نبوءات العهد القديم وحضرتها المعجزات؛ يُحتفل بالميلاد…) / توالد عذري, ولادة عذرية (حمل بشري دون إخصاب من قبل رجل)",
 "処女飛行": "رحلة أولى, طلعة جوية أولى (أول رحلة من نوعها)\nمثال: قامت قاذفة الشبح برحلتها الأولى في عام 1989",
 "処断": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين",
 "処方": "وَصْفَة طِبِّيَّة, وَصْفَة / تَقَادُم",
 "処方せん": "وَصْفَة طِبِّيَّة, وَصْفَة / تَقَادُم",
 "処方箋": "وَصْفَة طِبِّيَّة, وَصْفَة / تَقَادُم",
 "処方箋医薬品": "دواء بوصفة طبية, وصفة طبية (دواء لا يتوفر إلا بتعليمات مكتوبة من طبيب أو طبيب أسنان للصيدلي)\nمثال: أخبر الطبيب أنه كان يتناول وصفته الطبية بانتظام",
 "処方薬": "دواء بوصفة طبية, وصفة طبية (دواء لا يتوفر إلا بتعليمات مكتوبة من طبيب أو طبيب أسنان للصيدلي)\nمثال: أخبر الطبيب أنه كان يتناول وصفته الطبية بانتظام",
 "処格": "حالة الظرفية المكانية, حالة المكان (حالة تستخدم للإشارة إلى المكان، أو المكان الذي يحدث فيه الشيء)",
 "処決": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "処理": "مُعَالَجَة",
 "処理機構": "مُعَالِج",
 "処理済み": "مُصَنَّع, مُعَالَج (خضع لعملية أو معالجة خاصة) / مصنع, معالج (محضر أو محول من حالة طبيعية عن طريق الإخضاع لعملية خاصة) / مكرر, منقى (منقى من الشوائب عن طريق المعالجة)\nمثال: خامات معالجة",
 "処理系": "تَنْفِيذ",
 "処理能力": "إنتاجية, معدل المعالجة (المخرجات بالنسبة للمدخلات؛ الكمية التي تمر عبر نظام من المدخلات إلى المخرجات (خاصة لبرنامج كمبيوتر خلال فترة زمنية))",
 "処理装置": "مُعَالِج",
 "処理過程": "عَمَلِيَّة / عِلْمِيَّة, مُعَالَجَة / جَهَّزَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ)\nمثال: جهز زيري حقائبه.",
 "処理部": "مُعَالِج",
 "処置": "قِيَاس / فَاصِلَة / إِجْرَاء / قَاسَ (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "処置なし": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "処置無し": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "処罰": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "処遇": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري.",
 "凧": "طَائِرَة وَرَقِيَّة, طيارة ورق (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر)\nمثال: لقد وصلت الطائرة.",
 "凪": "هَادِئ / طَمْأَنَ",
 "凭れ掛かる": "مَالَ (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا) / اِسْتَنَدَ, اِتَّكَأَ\nمثال: أريد بعض المال.",
 "凭れ椅子": "كرسي استلقاء, كرسي قابل للإمالة (كرسي بذراعين يمكن خفض ظهره ورفع مسند القدمين للسماح للجالس بالاستلقاء فيه)",
 "凱旋門": "قوس النصر (قوس تذكاري ضخم؛ يُبنى عادة لإحياء ذكرى انتصار بارز)",
 "凱歌": "اِنْتِصَار, نَصْر",
 "凶": "نَحْس, سُوءُ الحَظّ",
 "凶々しい": "مَشْؤُوم, نَذِير شُؤْم (ينذر بسوء الحظ والطالع) / مُتَوَعِّد, مُنْذِر بِالشَّرّ (يهدد أو ينذر بتطورات شريرة أو مأساوية) / مُزْعِج / قابل للتصديق, معقول (يبدو معقولاً وموثوقاً، وبالتالي مقنعاً) / مَعْسُول الكَلَام, مُقْنِع زَيْفًا (يَتَّسِم بِتَقْدِيم حُجَج خَادِعَة تَبْدُو مَقْبُولَة)\nمثال: عذر وجيه",
 "凶事": "بَلَاء, بُؤْس",
 "凶人": "وَغْد, نَذْل",
 "凶党": "عِصَابَة",
 "凶凶しい": "مَشْؤُوم, نَذِير شُؤْم (ينذر بسوء الحظ والطالع) / مُتَوَعِّد, مُنْذِر بِالشَّرّ (يهدد أو ينذر بتطورات شريرة أو مأساوية) / مُزْعِج / قابل للتصديق, معقول (يبدو معقولاً وموثوقاً، وبالتالي مقنعاً) / مَعْسُول الكَلَام, مُقْنِع زَيْفًا (يَتَّسِم بِتَقْدِيم حُجَج خَادِعَة تَبْدُو مَقْبُولَة)\nمثال: عذر وجيه",
 "凶変": "كَارِثَة, فَاجِعَة / نَكْبَة, فَاجِعَة",
 "凶害": "قَتْلٌ عَمْدٌ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتَلَ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "凶徒": "جانٍ, مجرم (شخص ارتكب جريمة أو تمت إدانته قانونياً بجريمة)",
 "凶悍": "شَنَاعَة, فَظَاعَة (صفة كون الفعل قاسياً بشكل مروع وغير إنساني)",
 "凶悪": "فَظِيع, مُرَوِّع (يثير الرعب والهلع) / بَشِع, شَنِيع (سيء أو مُزعج بشكل استثنائي) / شَنِيع, فَظِيع (بالغ الوحشية أو القسوة بشكل صادم)",
 "凶悪性": "بِشَاعَة, قَسْوَة",
 "凶手": "قَاتِل, سَفَّاح (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي يقتل بلا حَقّ. الجمع قتلة) / حَشَّاش\nمثال: بيتي قاتلة أمك.",
 "凶暴": "شَرِس ((شَرَسَ) الجِلْدَ يَشْرُسُ شَرْسًا: دَلكَهُ؛ (شَرَسَ) صاحبَه: أمَضَّهُ بالقول)\nمثال: احذر من الكلب الشرس",
 "凶暴性": "وحشية",
 "凶歉": "مَجَاعَة",
 "凶漢": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم أيضا بمعنى ذو الشَرّ وما تسبب بالشرّ)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
