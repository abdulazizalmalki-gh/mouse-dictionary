 "二つながら": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "二つ乍ら": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "二つ共": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "二つ割り": "نِصْف, نُصْف",
 "二つ名": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الدَّلَع (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "二つ折": "ضِعْفِيّ, مُضَاعَف (ضعف الكمية أو العدد)",
 "二つ折り": "ضِعْفِيّ, مُضَاعَف (ضعف الكمية أو العدد)",
 "二つ目": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "二つ結び": "ضَفِيرَة صَغِيرَة (جديلة من الشعر المضفر)",
 "二どと": "أبداً, ليس بعد الآن (في أي وقت فيما بعد)\nمثال: قال الغراب: أبداً!",
 "二の次": "ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة الأُُولى)\nمثال: ثانوية زيري ضخمة.",
 "二の町": "دُون المُسْتَوَى, نَاقِص (لا يرقى إلى المعيار المحدد؛ أقل من المستوى المطلوب) / أدنى, مرؤوس (من رتبة أو أهمية منخفضة أو يتسم بها) / دوني, رديء (ذو جودة منخفضة أو رديئة) / داخلي (كوكب) (له مدار بين الشمس ومدار الأرض)\nمثال: عطارد والزهرة كواكب داخلية",
 "二の糸": "فريق الاحتياط (فرقة من اللاعبين المتاحين إما بشكل فردي أو كفريق لإراحة أو استبدال اللاعبين الذين بدأوا المباراة)",
 "二の腕": "عَضُد (مُعِين؛ قُوَّة)",
 "二の膳": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له)",
 "二の足": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / تثاقل, تردد (درجة معينة من عدم الرغبة) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: كان هناك تردد في كلامه",
 "二の足を踏む": "تَرَدَّدَ (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "二カ国語": "ثُنَائِي اَللُّغَة",
 "二カ年": "ثنائي الحول, سنتوي (له دورة حياة تستمر لموسمين) / كُلَّ سَنَتَيْنِ (يحدث كل سنتين) / نبات ثنائي الحول ((علم النبات) نبات تستغرق دورة حياته عادة موسمين من الإنبات حتى الموت؛ عادة ما تزهر وتثمر النباتات ثنائية الحول في الموسم الثاني)\nمثال: دورة حياة ثنائية الحول",
 "二クロム酸": "حمض ثنائي الكروميك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "二クロム酸カリウム": "ثاني كرومات البوتاسيوم (ملح برتقالي محمر يستخدم في صنع الأصباغ وفي التصوير الفوتوغرافي)",
 "二クロム酸ナトリウム": "ثنائي كرومات الصوديوم (ملح برتقالي محمر يستخدم كمثبت للون)",
 "二ケ年": "ثنائي الحول, سنتوي (له دورة حياة تستمر لموسمين) / كُلَّ سَنَتَيْنِ (يحدث كل سنتين) / نبات ثنائي الحول ((علم النبات) نبات تستغرق دورة حياته عادة موسمين من الإنبات حتى الموت؛ عادة ما تزهر وتثمر النباتات ثنائية الحول في الموسم الثاني)\nمثال: دورة حياة ثنائية الحول",
 "二ノ宮": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "二ヵ国語": "ثُنَائِي اَللُّغَة",
 "二ヵ年": "ثنائي الحول, سنتوي (له دورة حياة تستمر لموسمين) / كُلَّ سَنَتَيْنِ (يحدث كل سنتين) / نبات ثنائي الحول ((علم النبات) نبات تستغرق دورة حياته عادة موسمين من الإنبات حتى الموت؛ عادة ما تزهر وتثمر النباتات ثنائية الحول في الموسم الثاني)\nمثال: دورة حياة ثنائية الحول",
 "二ヶ国語": "ثُنَائِي اَللُّغَة",
 "二ヶ年": "ثنائي الحول, سنتوي (له دورة حياة تستمر لموسمين) / كُلَّ سَنَتَيْنِ (يحدث كل سنتين) / نبات ثنائي الحول ((علم النبات) نبات تستغرق دورة حياته عادة موسمين من الإنبات حتى الموت؛ عادة ما تزهر وتثمر النباتات ثنائية الحول في الموسم الثاني)\nمثال: دورة حياة ثنائية الحول",
 "二七": "سَبْعَة وَعِشْرُونَ (يَدُلُّ عَلَى العَدَد 27) / سَبْعَة وَعِشْرُون (العدد الأصلي الذي هو مجموع ستة وعشرين وواحد)",
 "二世": "نيسي (شخص ولد في الولايات المتحدة لأبوين هاجرا من اليابان) / ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية. / اِبْن (الولد الذكر)\nمثال: هو له ابن صغير.",
 "二乗": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "二乗冪": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "二乗根": "جَذْر تَرْبِيعِيّ (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "二九": "ثَمَانِيَةَ عَشَرَ / تِسْعَة وَعِشْرُونَ (يَدُلُّ عَلَى العَدَد 29) / تِسْعَة وَعِشْرُون (العدد الأصلي الذي هو مجموع ثمانية وعشرين وواحد)",
 "二五": "خَمْسَة وَعِشْرُونَ (يَدُلُّ عَلَى العَدَد 25) / خَمْسَة وَعِشْرُون (العدد الأصلي الذي هو مجموع أربعة وعشرين وواحد)",
 "二交替": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "二人": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "二人して": "مَعًا, سَوِيًّا",
 "二人とも": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "二人三脚": "ثُلَاثِيّ الأَرْجُل (لَهُ ثَلاث أَرْجُل أَوْ ما يُشْبِهُها)",
 "二人共": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "二人目": "مُخَاطَب",
 "二人称": "مُخَاطَب / رتبة, لقب (تسمية تعريفية تدل على الوضع أو الوظيفة: مثل 'سيد' أو 'جنرال')",
 "二人種": "ثُنَائِيُّ العِرْق (يتألّف من عرقين أو يجمع بينهما)",
 "二人組": "ثنائي, زوجان (زوج من الأشخاص يرتبطون ببعضهم البعض) / ثُنَائِيّ, زَوْج (عنصران من نفس النوع)\nمثال: الخطيبان",
 "二人部屋": "غُرْفَة مُزْدَوِجَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "二代目": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "二伸": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية) / تذييل, ملاحظة لاحقة (ملاحظة تضاف إلى رسالة بعد التوقيع)",
 "二佐": "مقدّم (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه)\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "二価": "ثنائي التكافؤ (لديه تكافؤ اثنين أو لديه تكافؤين)",
 "二俣": "تشعب ثنائي, تفرع ثنائي (عملية الانقسام إلى فرعين) / تشعب (المكان الذي ينقسم فيه الشيء إلى فرعين) / تشعب (فرع متشعب (واحد أو كلاهما))",
 "二個": "اِثْنَانِ, اِثْنَتَانِ (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)",
 "二倍": "ثُنَائِيّ / ضِعْف\nمثال: 社長は私の歳の２倍です。 — رئيسي في العمل يكبرني عمراً بمرتين.",
 "二倍体": "ثنائي الصيغة الصبغية (لخلية أو كائن حي يحتوي على مجموعتين من الكروموسومات أو ضعف العدد الأحادي) / ثنائي الصيغة الصبغية ((في علم الوراثة) كائن أو خلية تحتوي على الكمية الطبيعية من الحمض النووي لكل خلية؛ أي مجموعتين من الكروموسومات أو ضعف العدد الأحادي)\nمثال: خلايا جسدية ثنائية الصيغة الصبغية",
 "二倍性": "ثنائية الصيغة الصبغية (حالة كون الكائن ثنائي الصيغة الصبغية)",
 "二値": "ثُنَائِيّ (يتكوّن من وحدتين أو مكوّنين أو عنصرين) / ثنائي (من أو متعلق بنظام أرقام أساسه 2) / برنامج ثنائي, ملف ثنائي (برنامج مسبق التجميع والربط جاهز للتشغيل تحت نظام تشغيل معين؛ الملف الثنائي لنظام تشغيل ما لن يعمل على نظام مختلف) / نَجْم ثُنَائِيّ, نَجْم مُزْدَوِج (نظام من نجمين يدوران حول بعضهما البعض تحت تأثير جاذبيتهما المتبادلة)\nمثال: رقم ثنائي",
 "二元": "ازْدِوَاجِيَّة, ثَنَوِيَّة ((في الهندسة) قابلية تبادل أدوار النقاط والمستويات في نظريات الهندسة الإسقاطية) / ازدواجية, ازدواجية الموجة والجسيم ((فيزياء) خاصية المادة والإشعاع الكهرومغناطيسي التي تتميز بحقيقة أن بعض الخصائص يمكن تفسيرها بشكل أفضل بنظرية الموجة والبعض الآخر بنظرية الجسيمات) / انقسام ثنائي, ثنائية (كون الشيء ثنائياً؛ تصنيف إلى جزأين أو فئتين فرعيتين متضادتين)\nمثال: الانقسام بين الثقافة الشرقية والغربية",
 "二元性": "ازْدِوَاجِيَّة, ثَنَوِيَّة ((في الهندسة) قابلية تبادل أدوار النقاط والمستويات في نظريات الهندسة الإسقاطية) / ازدواجية, ازدواجية الموجة والجسيم ((فيزياء) خاصية المادة والإشعاع الكهرومغناطيسي التي تتميز بحقيقة أن بعض الخصائص يمكن تفسيرها بشكل أفضل بنظرية الموجة والبعض الآخر بنظرية الجسيمات) / انقسام ثنائي, ثنائية (كون الشيء ثنائياً؛ تصنيف إلى جزأين أو فئتين فرعيتين متضادتين)\nمثال: الانقسام بين الثقافة الشرقية والغربية",
 "二元的": "مُثَنًّى / مُثَنَّى",
 "二元論": "ثَنَوِيَّة",
 "二八": "سِتَّةَ عَشَرَ / ثَمَانِيَة وَعِشْرُونَ (يَدُلُّ عَلَى العَدَد 28) / ثَمَانِيَة وَعِشْرُون (العدد الأصلي الذي هو مجموع سبعة وعشرين وواحد)",
 "二六": "سِتَّة وَعِشْرُونَ (يَدُلُّ عَلَى العَدَد 26) / سِتَّة وَعِشْرُون (العدد الأصلي الذي هو مجموع خمسة وعشرين وواحد)",
 "二六時中": "على مدار الوقت (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "二刀流": "ازدواجية الميول الجنسية (النشاط الجنسي مع كل من الرجال والنساء) / ازدواجية الجنس, خنوثة (إظهار خصائص كلا الجنسين)",
 "二分": "قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "二分の一": "نِصْف, نُصْف",
 "二分休符": "سكتة نصفية (سكتة موسيقية لها قيمة زمنية تعادل نصف سكتة كاملة أو مساوية في المدة لنبضتين في الزمن الشائع)",
 "二分探索": "بَحْث ثُنَائِيّ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "二分探索木": "بَحْث ثُنَائِيّ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "二分木": "شَجَرَة ثُنَائِيَّة (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "二分法": "انقسام ثنائي, ثنائية (كون الشيء ثنائياً؛ تصنيف إلى جزأين أو فئتين فرعيتين متضادتين)\nمثال: الانقسام بين الثقافة الشرقية والغربية",
 "二分脊椎": "السنسنة المشقوقة, الصلب المشقوق (عيب خلقي غير نادر تتشوه فيه فقرة؛ ما لم تتأثر عدة فقرات أو يكون هناك قيلة نخاعية سحائية، تكون الأعراض قليلة؛ يمكن تشخيصه عن طريق بزل السلى)",
 "二分脊椎症": "السنسنة المشقوقة, الصلب المشقوق (عيب خلقي غير نادر تتشوه فيه فقرة؛ ما لم تتأثر عدة فقرات أو يكون هناك قيلة نخاعية سحائية، تكون الأعراض قليلة؛ يمكن تشخيصه عن طريق بزل السلى)",
 "二分音符": "بيضاء, نوتة نصفية (نوتة موسيقية لها قيمة زمنية تعادل نصف نوتة كاملة)",
 "二十": "عِشْرُونَ",
 "二十一か条の要求": "وَاحِد وَعِشْرُون (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة.",
 "二十一カ条の要求": "وَاحِد وَعِشْرُون (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة.",
 "二十一代集": "وَاحِد وَعِشْرُون (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة.",
 "二十一日": "حَادِي وَعِشْرُونَ (العَدَد التَّرْتِيبِيّ 21)",
 "二十七": "سَبْعَة وَعِشْرُونَ (يَدُلُّ عَلَى العَدَد 27) / سَبْعَة وَعِشْرُون (العدد الأصلي الذي هو مجموع ستة وعشرين وواحد)",
 "二十七日": "سَابِع وَعِشْرُونَ (العَدَد التَّرْتِيبِيّ 27)",
 "二十三日": "ثَالِث وَعِشْرُونَ (العَدَد التَّرْتِيبِيّ 23)",
 "二十世紀": "القرن العشرون (القرن من 1901 إلى 2000)",
 "二十九": "تِسْعَة وَعِشْرُونَ (يَدُلُّ عَلَى العَدَد 29) / تِسْعَة وَعِشْرُون (العدد الأصلي الذي هو مجموع ثمانية وعشرين وواحد)",
 "二十九日": "تَاسِع وَعِشْرُونَ (العَدَد التَّرْتِيبِيّ 29) / تِسْعَة وَعِشْرُون",
 "二十二日": "ثَانِي وَعِشْرُونَ (العَدَد التَّرْتِيبِيّ 22)",
 "二十五": "خَمْسَة وَعِشْرُونَ (يَدُلُّ عَلَى العَدَد 25) / خَمْسَة وَعِشْرُون (العدد الأصلي الذي هو مجموع أربعة وعشرين وواحد)",
 "二十五史": "خَمْسَة وَعِشْرُون (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال.",
 "二十五日": "خَامِس وَعِشْرُونَ (العَدَد التَّرْتِيبِيّ 25)",
 "二十代": "عِشْرُونَ (يَدُلُّ عَلَى العَدَد 20) / عِشْرُون (العدد الأصلي الذي هو مجموع تسعة عشر وواحد)",
 "二十個": "عِشْرُونَ",
 "二十八": "ثَمَانِيَة وَعِشْرُونَ (يَدُلُّ عَلَى العَدَد 28) / ثَمَانِيَة وَعِشْرُون (العدد الأصلي الذي هو مجموع سبعة وعشرين وواحد)",
 "二十八日": "ثَامِن وَعِشْرُونَ (العَدَد التَّرْتِيبِيّ 28)",
 "二十六": "سِتَّة وَعِشْرُونَ (يَدُلُّ عَلَى العَدَد 26) / سِتَّة وَعِشْرُون (العدد الأصلي الذي هو مجموع خمسة وعشرين وواحد)",
 "二十六日": "سَادِس وَعِشْرُونَ (العَدَد التَّرْتِيبِيّ 26)",
 "二十四史": "أَرْبَعَة وَعِشْرُون (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "二十四日": "رَابِع وَعِشْرُونَ (العَدَد التَّرْتِيبِيّ 24)",
 "二十四時": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "二十四時間": "أربع وعشرون ساعة, يوم (الوقت الذي تستغرقه الأرض للقيام بدورة كاملة حول محورها)\nمثال: غادروا بعد يومين",
 "二十四時間制": "دُونَ تَوَقُّف, عَلَى مَدَارِ السَّاعَة (فِي جَمِيعِ الأَوْقَات؛ دُونَ انْقِطَاع)",
 "二十日兎": "بيكا (ثديي حفار صغير قصير الأذن من المرتفعات الصخرية في آسيا وغرب أمريكا الشمالية)",
 "二十日大根": "فُجْل (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة)",
 "二十日鼠": "فأر المنزل (فأر بني رمادي من العالم القديم أصبح الآن آفة منزلية شائعة في جميع أنحاء العالم)",
 "二十面体": "عشروني السطوح (أي متعدد سطوح له عشرون وجهاً مستوياً)",
 "二千": "أَلْفَان",
 "二卵性": "أَخَوِيّ",
 "二卵性双生児": "توأم غير متطابق (أحد توأمين تطورا من بويضتين مخصبتين منفصلتين)",
 "二原子": "ثنائي الذرة (متعلق بجزيء يتكون من ذرتين)\nمثال: جزيء ثنائي الذرة",
 "二又": "تشعب ثنائي, تفرع ثنائي (عملية الانقسام إلى فرعين) / تشعب (المكان الذي ينقسم فيه الشيء إلى فرعين) / تشعب (فرع متشعب (واحد أو كلاهما))",
 "二号": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "二号さん": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "二名法": "تَسْمِيَة ثُنَائِيَّة",
 "二周目": "تَنَاسُخُ الأَرْوَاحِ",
 "二命名法": "تَسْمِيَة ثُنَائِيَّة",
 "二回": "مَرَّتَيْن, مرتين",
 "二回生": "طالب سنة ثانية (طالب جامعي في السنة الثانية)",
 "二国間": "ثُنَائِيّ",
 "二国間主義": "تناظر ثنائي, تناظر جانبي (خاصية التناظر حول مستوى عمودي)",
 "二国間相互主義": "تناظر ثنائي, تناظر جانبي (خاصية التناظر حول مستوى عمودي)",
 "二型糖尿病": "السكري غير المعتمد على الأنسولين, السكري من النوع الثاني (شكل خفيف من داء السكري يتطور تدريجيًا لدى البالغين؛ يمكن أن يحدث بسبب السمنة أو الإجهاد الشديد أو انقطاع الطمث أو عوامل أخرى؛ يمكن السيطرة عليه عادة…)",
 "二塁": "القاعدة الثانية (مركز اللعب للاعب في فريق البيسبول المتمركز بالقرب من القاعدة الثانية في الملعب الداخلي) / القاعدة الثانية (القاعدة التي يجب أن يلمسها العداء ثانياً في لعبة البيسبول)",
 "二塁手": "لاعب القاعدة الثانية ((في البيسبول) رجل يلعب في القاعدة الثانية)",
 "二塁打": "ضربة ثنائية (ضربة قاعدة يتوقف عندها الضارب بأمان عند القاعدة الثانية)\nمثال: ضرب ضربة ثنائية إلى عمق وسط الملعب",
 "二塩化": "ثنائي كلوريد (مركب يحتوي على ذرتين من الكلور في كل جزيء)",
 "二塩基酸": "حمض ثنائي القاعدية (حمض يحتوي على ذرتين هيدروجين قابلتين للاستبدال في كل جزيء)",
 "二士": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك.",
 "二大政党主義": "ثُنَائِيُّ الحِزْبِيَّة (مَدْعُومٌ مِنْ كِلَا الجَانِبَيْن)",
 "二大政党制": "ثُنَائِيُّ الحِزْبِيَّة (مَدْعُومٌ مِنْ كِلَا الجَانِبَيْن)",
 "二子": "بلورات توأمية, توائم بلورية ((في علم المعادن) بلورتان متداخلتان تشكل كل منهما صورة مرآة للأخرى)",
 "二字": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟",
 "二宮": "اسم مكان (الاسم الذي يُعرف به مكان جغرافي) / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "二尉": "ملازم أوّل (مَن يُلازم الشيء أو المكان فيدوم فيه ولا يفارقه؛ في : المُلازِم رتبة في الجيش هي أدنى رتبة للظُبَّاط ودونه ما يعرفون بنُوَّاب الظباط أو ظُباط الصَفّ)",
 "二尖弁": "صمام تاجي, صمام ثنائي الشرف (صمام ذو شرفتين؛ يقع بين الأذين الأيسر والبطين الأيسر)",
 "二峰性": "ثُنَائِيّ المِنْوَال (للتوزيع؛ لديه أو يحدث بمنوالين)",
 "二年氷": "فِي السَّنَةِ الثَّانِيَة (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الثَّانِيَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ أَوِ الجَامِعَةِ الأَمْرِيكِيَّةِ)",
 "二年生": "فِي السَّنَةِ الثَّانِيَة (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الثَّانِيَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ أَوِ الجَامِعَةِ الأَمْرِيكِيَّةِ) / ثنائي الحول, سنتوي (له دورة حياة تستمر لموسمين) / كُلَّ سَنَتَيْنِ (يحدث كل سنتين) / نبات ثنائي الحول ((علم النبات) نبات تستغرق دورة حياته عادة موسمين من الإنبات حتى الموت؛ عادة ما تزهر وتثمر النباتات ثنائية الحول في الموسم الثاني)\nمثال: دورة حياة ثنائية الحول",
 "二年草": "ثنائي الحول, سنتوي (له دورة حياة تستمر لموسمين) / كُلَّ سَنَتَيْنِ (يحدث كل سنتين) / نبات ثنائي الحول ((علم النبات) نبات تستغرق دورة حياته عادة موسمين من الإنبات حتى الموت؛ عادة ما تزهر وتثمر النباتات ثنائية الحول في الموسم الثاني)\nمثال: دورة حياة ثنائية الحول",
 "二度": "مَرَّة أُخْرَى, ثَانِيَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟ / الضعف, مرتين (بمعامل اثنين)\nمثال: زاد السعر الضعف في العام الماضي",
 "二度と": "أبداً, ليس بعد الآن (في أي وقت فيما بعد)\nمثال: قال الغراب: أبداً!",
 "二度三度": "مِرَارًا وَتِكْرَارًا",
 "二度漬け": "دخل مزدوج (دخلان مستلمان من نفس المصدر (مثل شغل وظيفة حكومية وتلقي معاش تقاعدي حكومي))",
 "二度見": "إعادة نظر, نظرة ثانية (رد فعل متأخر يشير إلى المفاجأة)",
 "二度音程": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "二形": "خُنْثَى / خُنْثَوِيّ",
 "二律背反": "التضاد",
 "二従兄妹": "قريب من الدرجة الثانية (ابن ابن عم أو ابن خال أحد الوالدين)",
 "二従兄弟": "قريب من الدرجة الثانية (ابن ابن عم أو ابن خال أحد الوالدين)",
 "二従姉妹": "قريب من الدرجة الثانية (ابن ابن عم أو ابن خال أحد الوالدين)",
 "二従姉弟": "قريب من الدرجة الثانية (ابن ابن عم أو ابن خال أحد الوالدين)",
 "二心": "ازدواجية, تعامل بوجهين (التصرف بسوء نية؛ الخداع بالتظاهر بامتلاك مجموعة من النوايا بينما يتصرف تحت تأثير أخرى) / احتيال, ازدواجية (تمثيل احتيالي أو مزدوج)",
 "二成文系": "النظام الثنائي, نظام العد الثنائي (نظام عد موضعي يستخدم أرقاماً ثنائية وأساساً هو الاثنان)",
 "二戸建": "منزل شبه منفصل (مسكن متصل بشيء ما من جانب واحد فقط)",
 "二戸建て": "منزل شبه منفصل (مسكن متصل بشيء ما من جانب واحد فقط)",
 "二才": "بِعُمُر سَنَتَيْن (في عامه الثاني من العمر)",
 "二拍子": "وزن ثنائي (زمن موسيقي بنقرتين في كل مقياس)",
 "二指樹懶": "كسلان ثنائي الأصابع (كسلان صغير نسبياً وسريع الحركة يمتلك مخلبين طويلين في كل قدم أمامية) / كسلان هوفمان (كسلان من أمريكا الوسطى يمتلك مخلبين طويلين في كل قدم أمامية وثلاثة مخالب طويلة في كل قدم خلفية)",
 "二文字": "ثوم معمر صيني (أوراق مسطحة كبيرة تستخدم كما يستخدم الثوم المعمر) / ثوم معمر صيني, كراث صيني (نبات من شرق آسيا؛ أكبر من الثوم المعمر)",
 "二日酔い": "خُمَار (مَا تُغَطِّي الْمَرْأَةُ بِهِ شَعْرَهَا وَرَقَبَتَهَا؛ مَا تُغَطِّي الْمَرْأَةُ بِهِ وَجْهَهَا) / خُمَار اَلسُّكْر (مَا تُغَطِّي الْمَرْأَةُ بِهِ شَعْرَهَا وَرَقَبَتَهَا؛ مَا تُغَطِّي الْمَرْأَةُ بِهِ وَجْهَهَا) / صُدَاع الخَمْر\nمثال: اعتنقت ليلى الإسلام و بدأت ترتدي الخمار.",
 "二時": "اَلسَّاعَة اَلثَّانِيَة",
 "二曹": "رقيب أول (رقيب في الجيش أعلى من رقيب أركان وأقل من مساعد)",
 "二月": "فِبْرَايِر, شُبَاط (الشهر الثاني في السنة الميلادية الروميّة)\nمثال: سأكون قد درست الإنجليزية لخمس سنوات مع حلول فبراير المقبل.",
 "二月尽": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "二本": "اِثْنَانِ, اِثْنَتَانِ (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)\nمثال: واحد زائد اثنان يساوي ثلاثة.",
 "二本建て": "كَيْلٌ بِمِكْيالَيْنِ, اِزْدِوَاجِيَّة الْمَعَايِير",
 "二本棒": "مُغَفَّل, سَاذَج",
 "二本立て": "مباراتان متتاليتان (مباراتان بدلاً من واحدة (خاصة في البيسبول حين يلعب نفس الفريقين مباراتين في نفس اليوم))",
 "二本立て映画": "مباراتان متتاليتان (مباراتان بدلاً من واحدة (خاصة في البيسبول حين يلعب نفس الفريقين مباراتين في نفس اليوم))",
 "二村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "二束三文": "بَخْس الثَّمَن, رَخِيص جِدّاً (رخيص للغاية؛ شبه مجاني)",
 "二条": "اسم مكان (الاسم الذي يُعرف به مكان جغرافي) / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "二枚折り": "فوليو, كتاب من القطع الكبير (كتاب (أو مخطوطة) يتكون من أوراق كبيرة مطوية في المنتصف لتكوين ورقتين أو أربع صفحات) / صحيفة, ورقة (ورقة من أي مادة مكتوبة أو مطبوعة (خاصة في مخطوطة أو كتاب)) / تَرْقِيم, تَرْقِيم الصَّفَحَات (نظام ترقيم الصفحات)\nمثال: الفوليو الأول لمسرحيات شكسبير",
 "二枚舌": "ازدواجية, تعامل بوجهين (التصرف بسوء نية؛ الخداع بالتظاهر بامتلاك مجموعة من النوايا بينما يتصرف تحت تأثير أخرى) / ذُو وَجْهَيْن, مُرَاوِغ (يتَّسم بخداع متعمَّد خاصَّة بإظهار مشاعر والتصرُّف بمشاعر أخرى)",
 "二枚貝": "ذوات الصدفتين (رخويات بحرية أو مياه عذبة لها جسم رخو مع خياشيم تشبه الصفائح محاطة بصدفتين مفصليتين معاً) / ثنائي الصدفة (يستخدم للرخويات التي لها صدفتان (مثل المحار وغيرها))",
 "二枚貝類": "ذوات الصدفتين (رخويات بحرية أو مياه عذبة لها جسم رخو مع خياشيم تشبه الصفائح محاطة بصدفتين مفصليتين معاً) / ثنائي الصدفة (يستخدم للرخويات التي لها صدفتان (مثل المحار وغيرها))",
 "二核": "ثُنَائِيّ النَّوَاة (لديه نواتان)",
 "二極分化": "استقطاب (الظاهرة التي يتم فيها تقييد اتجاه اهتزاز موجات الضوء أو غيرها من الإشعاعات) / استقطاب (حالة امتلاك أو إعطاء قطبية)",
 "二極真空管": "صِمَام ثُنَائِيّ, ثَنَائِي دِيُود (الصِّمَامُ : السِّدَادُ؛ الصِّمام : جهاز لضبط السوائل والغازات في أَوعيتها وتنظيم انسيابها في اتِّجاه دون آخر)\nمثال: فتح سامر صمام المياه.",
 "二極管": "صِمَام ثُنَائِيّ, ثَنَائِي دِيُود (الصِّمَامُ : السِّدَادُ؛ الصِّمام : جهاز لضبط السوائل والغازات في أَوعيتها وتنظيم انسيابها في اتِّجاه دون آخر)",
 "二槽式": "ثُنَائِيّ, مِن جُزْأَيْن (يتضمن جزأين أو عنصرين)",
 "二次": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية. / ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة الأُُولى)\nمثال: ثانوية زيري ضخمة. / تربيعي (ينطوي على القوة الثانية ولا توجد قوة أعلى للكمية أو الدرجة) / كَثِيرَة حُدُود مِن الدَّرَجَة الثَّانِيَة, مُعَادَلَة تَرْبِيعِيَّة (كثيرة حدود من الدرجة الثانية) / معادلة تربيعية (معادلة تكون فيها أعلى قوة للكمية المجهولة هي المربع)\nمثال: معادلة تربيعية / خَيَالِيّ, مُتَخَيَّل",
 "二次コイル": "ملف ثانوي (ملف يُستحث فيه تيار عن طريق تمرير تيار عبر الملف الابتدائي)",
 "二次コン": "ثنائي الأبعاد, مستوٍ (ينطوي على أو له بعدان) / ثُنَائِيُّ الأَبْعَادِ, سَطْحِيّ (يفتقر إلى المدى أو العمق المتوقع؛ غير مُصمَّم لإعطاء إيهام بالعمق)",
 "二次元": "خَيَالِيّ, مُتَخَيَّل",
 "二次元配列": "ثنائي الأبعاد, مستوٍ (ينطوي على أو له بعدان) / ثُنَائِيُّ الأَبْعَادِ, سَطْحِيّ (يفتقر إلى المدى أو العمق المتوقع؛ غير مُصمَّم لإعطاء إيهام بالعمق)",
 "二次元高速フーリエ変換": "ثنائي الأبعاد, مستوٍ (ينطوي على أو له بعدان) / ثُنَائِيُّ الأَبْعَادِ, سَطْحِيّ (يفتقر إلى المدى أو العمق المتوقع؛ غير مُصمَّم لإعطاء إيهام بالعمق)",
 "二次性": "ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة الأُُولى)\nمثال: ثانوية زيري ضخمة.",
 "二次方程式": "معادلة تربيعية (معادلة تكون فيها أعلى قوة للكمية المجهولة هي المربع)",
 "二次曲面": "سطح تربيعي (منحنى أو سطح معادلته (في الإحداثيات الديكارتية) من الدرجة الثانية)",
 "二次的": "ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة الأُُولى)\nمثال: ثانوية زيري ضخمة.",
 "二次記憶装置": "تخزين خارجي, تخزين مساعد (جهاز تخزين بيانات ليس الذاكرة الرئيسية للحاسوب)",
 "二次配布": "إعادة توزيع (التوزيع مرة أخرى)\nمثال: أدت الثورة إلى إعادة توزيع الثروة",
 "二歳": "بِعُمُر سَنَتَيْن (في عامه الثاني من العمر)",
 "二段": "ثُنَائِيّ / ضِعْف",
 "二段ベッド": "سَرِير بِطَابَقَيْن (قطعة أثاث للنوم والاستلقاء والجلوس؛ مسطبة من الخشب المزيَّن يوضع عليه كرسي، يغلب على ما تحت عرش الملك)\nمثال: قاس طول السرير.",
 "二段階認証": "مُصَادَقَة ثُنَائِيَّة (إِخْلاَصٌ فِي الصَّدَاقَةِ؛ الإقرار والموافقة على الشيء)",
 "二流": "مُتَوَسِّط, مِنَ الدَّرَجَة الثَّانِيَة (متوسط إلى رديء في الجودة)",
 "二液": "ثُنَائِيّ, مِن جُزْأَيْن (يتضمن جزأين أو عنصرين)",
 "二瓶": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "二番": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "二番め": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "二番刈り": "أَعْقَاب",
 "二番抵当": "رهن عقاري ثانٍ (رهن عقاري تابع لرهن عقاري أول)",
 "二番煎じ": "اجترار, تكرار (مادة قديمة تم إعادة صياغتها قليلاً واستخدامها مرة أخرى)\nمثال: مجرد اجترار ممل لروايته الأولى",
 "二番目": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "二瘤駱駝": "فَالِج, جَمَل ذُو سَنَامَيْن",
 "二百": "مِئَتَان (يَدُلُّ عَلَى العَدَد 200)",
 "二直角": "زَاوِيَة مُسْتَقِيمَة",
 "二着": "وَصِيفَة",
 "二矢": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "二硫化炭素": "ثنائي كبريتيد الكربون",
 "二神": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "二種": "مِنَ الدَّرَجَة الثَّانِيَة (ذو مكانة أو جودة أدنى)",
 "二等": "بالدرجة الثانية (بواسطة وسائل نقل الدرجة الثانية) / درجة ثانية, درجة سياحية (فئة من أماكن الإقامة على متن سفينة أو قطار أو طائرة أقل تكلفة من أماكن الدرجة الأولى) / درجة ثانية (ليس أعلى جودة في التصنيف) / درجة ثانية (ليست أعلى رتبة في التصنيف)\nمثال: سافرنا بالدرجة الثانية",
 "二等兵": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك.",
 "二等兵曹": "ضابط صف بحري (ضابط صف في البحرية أو خفر السواحل برتبة تعادل رقيب في الجيش)",
 "二等分": "تنصيف (التقسيم إلى جزأين متساويين)",
 "二等分線": "مُنَصِّف, مُقَسِّم",
 "二等海佐": "آمِر, مُقَدَّم",
 "二等空曹": "رقيب فني (ضابط صف رتبته أقل من رقيب أول في القوات الجوية أو المارينز)",
 "二等車": "بالدرجة الثانية (بواسطة وسائل نقل الدرجة الثانية) / درجة ثانية, درجة سياحية (فئة من أماكن الإقامة على متن سفينة أو قطار أو طائرة أقل تكلفة من أماكن الدرجة الأولى) / درجة ثانية (ليس أعلى جودة في التصنيف) / درجة ثانية (ليست أعلى رتبة في التصنيف)\nمثال: سافرنا بالدرجة الثانية",
 "二等軍曹": "رقيب أركان (ضابط صف رتبته أعلى من عريف وأقل من رقيب أول في الجيش أو المارينز)",
 "二等辺三角形": "مثلث متساوي الساقين (مثلث له ضلعان متساويان)",
 "二等陸佐": "مقدّم (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه)\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "二等陸士": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك.",
 "二等陸尉": "ملازم أوّل (مَن يُلازم الشيء أو المكان فيدوم فيه ولا يفارقه؛ في : المُلازِم رتبة في الجيش هي أدنى رتبة للظُبَّاط ودونه ما يعرفون بنُوَّاب الظباط أو ظُباط الصَفّ)",
 "二等陸曹": "رقيب أول (رقيب في الجيش أعلى من رقيب أركان وأقل من مساعد)",
 "二筋道": "مُفْتَرَق, تَقَاطُع",
 "二箇国語": "ثُنَائِي اَللُّغَة",
 "二箇年": "ثنائي الحول, سنتوي (له دورة حياة تستمر لموسمين) / كُلَّ سَنَتَيْنِ (يحدث كل سنتين) / نبات ثنائي الحول ((علم النبات) نبات تستغرق دورة حياته عادة موسمين من الإنبات حتى الموت؛ عادة ما تزهر وتثمر النباتات ثنائية الحول في الموسم الثاني)\nمثال: دورة حياة ثنائية الحول",
 "二糖": "سكر ثنائي (أي من مجموعة متنوعة من الكربوهيدرات التي تنتج جزيئين من السكر الأحادي عند التحلل المائي الكامل)",
 "二糖類": "سكر ثنائي (أي من مجموعة متنوعة من الكربوهيدرات التي تنتج جزيئين من السكر الأحادي عند التحلل المائي الكامل)",
 "二級": "بالدرجة الثانية (بواسطة وسائل نقل الدرجة الثانية) / درجة ثانية, درجة سياحية (فئة من أماكن الإقامة على متن سفينة أو قطار أو طائرة أقل تكلفة من أماكن الدرجة الأولى) / درجة ثانية (ليس أعلى جودة في التصنيف) / درجة ثانية (ليست أعلى رتبة في التصنيف)\nمثال: سافرنا بالدرجة الثانية",
 "二組": "ثُنَائِيّ / ضِعْف",
 "二義的": "ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة الأُُولى)\nمثال: ثانوية زيري ضخمة.",
 "二股": "تشعب ثنائي, تفرع ثنائي (عملية الانقسام إلى فرعين) / تشعب (المكان الذي ينقسم فيه الشيء إلى فرعين) / تشعب (فرع متشعب (واحد أو كلاهما))",
