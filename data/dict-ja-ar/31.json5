 "人道主義者": "إِنْسَانَوِيّ (يتّسم بالقيم الإنسانويّة والتفاني في رعاية البشر)\nمثال: مساعدات إنسانية",
 "人道回廊": "مَمَرّ إِنْسَانِيّ (على مَمَرّ العصور: على طولها ومداها؛ على مَمَرّ الفصول: على تواليها وتعاقبها)\nمثال: الباب في نهاية الممر.",
 "人道橋": "جسر مشاة (جسر مصمم لعبور المشاة)",
 "人道犯罪": "جَرِيمَة ضِدَّ الْإِنْسَانِيَّةَ",
 "人道的": "إِنْسَانِيّ",
 "人達": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه.",
 "人里": "قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة…)\nمثال: هذه القرية مملة.",
 "人里はなれた": "وَحِيد, مُوحِش",
 "人里離れた": "وَحِيد, مُوحِش",
 "人長": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "人間": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق. / شَخْصِيَّة\nمثال: زيري سيء الخلق. / عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "人間のくず": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "人間のクズ": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "人間の堕落": "السقوط, الهبوط ((الميثولوجيا اليهودية المسيحية) عندما أكل آدم وحواء من ثمر شجرة معرفة الخير…)",
 "人間の屑": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "人間の盾": "دِرْع بَشَرِيّ, دُرُوع بَشَرِيَّة (الثَلَاثُ الدُرَع: الليلة السادسة عشر والسابعة عشر والثامنة عشر من كل شهر قمري…)\nمثال: اعطني هذا الدرع.",
 "人間らしい": "بَشَرِيّ, إنْسَانِيّ\nمثال: أنا إنسان صادق.",
 "人間不信": "بُغْض الْبَشَرِيَّة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)",
 "人間中心主義": "مركزية بشرية (الميل لتقييم الواقع حصرياً من حيث القيم البشرية)",
 "人間中心的": "متمركز حول الإنسان (يتمحور حول الإنسان)\nمثال: نظرتنا للعالم التي تتمركز حول الإنسان",
 "人間以上": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو…)\nمثال: مزيد من الأرض",
 "人間力": "حُسْن التَّصَرُّف, دَهَاء (صفة القدرة على التعامل مع المواقف الصعبة)\nمثال: رجل ذو دهاء عظيم",
 "人間化": "أَنْسَنَة",
 "人間同士": "بَشَرِيَّة, الْجِنْس الْبَشَرِيّ",
 "人間型": "أندرويد, روبوت بشري (إنسان آلي يشبه البشر)",
 "人間失格": "لم يعد (ليس الآن)\nمثال: لم تعد موجودة",
 "人間嫌い": "بُغْض الْبَشَرِيَّة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "人間工学": "الأرغونوميا, تكنولوجيا حيوية (فرع العلوم الهندسية الذي تُستخدم فيه العلوم البيولوجية لدراسة العلاقة بين…)",
 "人間工学的": "أرغونومي, هندسي بشري (مكون من أو متعلق ببيئة العمل (الأرغونوميا) وملائمتها للبشر)",
 "人間性": "بَشَرِيَّة, إِنْسَانِيَّة",
 "人間愛": "بَشَرِيَّة, إِنْسَانِيَّة",
 "人間拡張": "ههه",
 "人間活動": "عَمَل بَشَرِيّ, فِعْل (شيء يفعله الناس أو يتسبّبون في حدوثه)",
 "人間生態学": "ديموغرافيا, علم السكان (فرع علم الاجتماع الذي يدرس خصائص السكان البشريين)",
 "人間疎外": "التَّجْرِيد مِن الإنْسَانِيَّة",
 "人間的": "بَشَرِيّ, إنْسَانِيّ\nمثال: أنا إنسان صادق.",
 "人間道": "إِنْسَانِيَّة, رَأْفَة (صفة الرحمة أو مراعاة الآخرين (الناس أو الحيوانات))",
 "人間関係": "عَلَاقَة شَخْصِيَّة (علاقة بين الأشخاص)",
 "人集め": "جمهور, حشد كبير (تجمع كبير للناس)",
 "人集り": "كَوْم",
 "人非人": "الْأَلَدُّ الْخَصِم",
 "人面": "وجه, وجه بشري (مقدمة الرأس البشري من الجبهة إلى الذقن ومن الأذن للأذن)\nمثال: غسل وجهه",
 "人頭": "سُكَّان / رأس بشري (رأس كائن بشري) / جُمْجُمَة",
 "人頭税": "ضريبة الاقتراع (ضريبة بمبلغ ثابت لكل شخص وتدفع كشرط للحصول على حق التصويت)",
 "人類": "بَشَرِيَّة, الْجِنْس الْبَشَرِيّ",
 "人類学": "عِلْمُ الإِنْسَان, أَنْطْرُوبُولُوجْيَا (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "人類学者": "أنثروبولوجي, عالم أنثروبولوجيا (عالم اجتماعي متخصص في الأنثروبولوجيا)",
 "人類愛": "إِنْسَانِيَّة",
 "人類猿": "قرد شبيه بالإنسان, قرد عليا (أي قرد عديم الذيل من فصيلتي البونجيد والهيلوباتيد)",
 "人食い": "أكل لحوم الجنس الواحد (ممارسة أكل لحم جنسك) / آكل للحوم البشر (مميز لآكلي لحوم البشر أو يظهر أكل لحوم البشر)\nمثال: سلوك أكل لحوم البشر",
 "人食いザメ": "قرش أبيض, قرش أبيض كبير (قرش عدواني كبير واسع الانتشار في البحار الدافئة؛ معروف بمهاجمته للبشر)",
 "人食い人種": "غُول, آكِلُ لُحُوم البَشْر",
 "人食い馬": "عَاضّ (شخص يقوم بالعض)",
 "人食い鮫": "قرش أبيض, قرش أبيض كبير (قرش عدواني كبير واسع الانتشار في البحار الدافئة؛ معروف بمهاجمته للبشر)",
 "人馬": "قَنْطُور",
 "人馬宮": "بُرْج اَلْقَوْس, اَلْقَوْس (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "人騒がせ": "إنذار كاذب (تحذير يُعطى بشأن شيء يفشل في الحدوث)",
 "人騙し": "خِدَاع, خَدْع",
 "人魂": "شِهَاب",
 "人魚": "خَيَلَان, اِبْنَة الْبَحْر",
 "人鳥": "بِطْرِيق",
 "人鳥類": "بِطْرِيق",
 "什": "عَشَرَة, عَشْرَة",
 "什一": "عُشر (تقدمة تمثل عشر الدخل الشخصي)",
 "什一献金": "عُشر (تقدمة تمثل عشر الدخل الشخصي)",
 "什器": "آنية, أداة منزلية (أداة للاستخدام العملي (خاصة في المنزل))",
 "什物": "أَثَاث, مَفْرُوشَات (الرياش والمتاع وما يوضع للاستخدام للجلوس أو النوم أو حفظ المتاع أو غيره داخل…)\nمثال: يصنع قطعة أثاث خشبية.",
 "什麼": "يَا لَ (يستعمل لنِدَاء البعيد والقريب)",
 "仁": "النزعَة إلى الخير / بَشَرِيّ, إنْسَانِيّ\nمثال: أنا إنسان صادق. / نَوَاة / نوية",
 "仁人": "إِنْسَانَوِيّ (يتّسم بالقيم الإنسانويّة والتفاني في رعاية البشر)\nمثال: مساعدات إنسانية",
 "仁侠": "مُرُوءَة / يَاكُوزَا",
 "仁兄": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "仁川": "إِنْشْيُون",
 "仁徳": "النزعَة إلى الخير",
 "仁心": "النزعَة إلى الخير",
 "仁恕": "النزعَة إلى الخير",
 "仁恵": "دماثة, لطف (صفة كون الشخص طيباً ووديعاً)",
 "仁愛": "النزعَة إلى الخير",
 "仁慈": "حَنُون بِالفِطْرَة, طَيِّب القَلْب (ذو طبع فطري طيّب وحنون)",
 "仁村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "仁科": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "仁義": "فَضِيلَة / وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "仁者": "إِنْسَانَوِيّ (يتّسم بالقيم الإنسانويّة والتفاني في رعاية البشر)\nمثال: مساعدات إنسانية",
 "仁藤": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "仁輪加狂言": "فارس, مهزلة (كوميديا تتميز بالسخرية الواسعة والمواقف غير المحتملة)",
 "仄": "بشكل خافت, بضعف (بدرجة خافتة أو مدركة بضعف)\nمثال: بينه وبين الضوء الخافت تم تحديد شكل بشكل خافت",
 "仄々": "بشكل خافت, بشكل غامض (بطريقة خافتة غير واضحة)\nمثال: أدركنا التغيير بشكل غامض فقط / بحرارة, بقلب خالص (بطريقة قلبية)\nمثال: رحبنا بها بحرارة",
 "仄か": "إِغْمَاء",
 "仄めかし": "تَلْمِيح\nمثال: لمح سامي منزلا.",
 "仄めかす": "أَلِيف, وَدُود (ذو مصالح أو مودة مشتركة؛ على صداقة راسخة)",
 "仄めく": "إحساس مبهم, تلميح (اقتراح طفيف أو فهم غامض)\nمثال: لم يكن لديه أي فكرة عما كان على وشك الحدوث",
 "仄仄": "بشكل خافت, بشكل غامض (بطريقة خافتة غير واضحة)\nمثال: أدركنا التغيير بشكل غامض فقط / بحرارة, بقلب خالص (بطريقة قلبية)\nمثال: رحبنا بها بحرارة",
 "仄暗い": "خَافِت, مُعْتَدِل الإِضَاءَة (ضَعِيف الضَّوْء؛ غَيْر سَاطِعٍ أَوْ قَاسٍ)\nمثال: أضواء القاعة المخفتة جلبت صمتاً من الترقب",
 "仆る": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "仇": "عدو (خصم مسلح (خاصة عضو في قوة عسكرية معادية))\nمثال: يجب أن يكون الجندي مستعداً لقتل أعدائه / مرارة / ضَرَرٌ / مُنَافِس / ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر. / زَوْج, زَوْجَة (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)\nمثال: زوجة ماري طبيبة.",
 "仇する": "ضَرَرٌ / غَزَا, اِجْتاحَ / عَارَض (فلانٌ: أخذ في ناحية من الطريق؛ فلانا: باراه وأتى بمثل ما أتى به)\nمثال: جميع من حضر عارض تلك الخطة.",
 "仇となる": "نتيجة عكسية (سوء تقدير يرتد على صاحبه)",
 "仇なす": "اِنْتَقَمَ",
 "仇になる": "نتيجة عكسية (سوء تقدير يرتد على صاحبه)",
 "仇をなす": "اِنْتَقَمَ",
 "仇を取る": "اِنْتَقَمَ",
 "仇を成す": "اِنْتَقَمَ",
 "仇敵": "عَدُوّ, عَدُوَّة (ركض أو جري)",
 "仇討": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "仇討ち": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "仇讎": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر.",
 "今": "الْآنَ, حَالًا (في هذا الوقت الحالي)\nمثال: نحن بمأمن الآن. / آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر. / هَٰذَا, هَٰذِهِ",
 "今い": "تَيَّار\nمثال: لدي جارة مسلمة.",
 "今から": "من الآن, من الآن فصاعداً (من هذا الوقت فصاعداً؛ من الآن فصاعداً)\nمثال: من الآن فصاعداً ستعرف باسم السيدة سميث",
 "今か今か": "بشوق, بلهفة\nمثال: كانت الأخبار منتظرة بلهفة",
 "今が今": "آنِفاً",
 "今さっき": "آنِفاً",
 "今さら": "الْآنَ, حَالًا (في هذا الوقت الحالي)\nمثال: نحن بمأمن الآن. / مجدداً, من جديد (مرة أخرى ولكن بطريقة جديدة أو مختلفة)\nمثال: ابدأ من جديد",
 "今さらながら": "مجدداً, من جديد (مرة أخرى ولكن بطريقة جديدة أو مختلفة)\nمثال: ابدأ من جديد",
 "今しがた": "آنِفاً",
 "今しき": "الْآنَ, حَالًا (في هذا الوقت الحالي)\nمثال: نحن بمأمن الآن.",
 "今しも": "آنِفاً",
 "今し方": "آنِفاً",
 "今すぐ": "حَالاً (مباشرةً، فوراً، دون تأخير؛ في هذه الأثناء، في الوضع الحالي)\nمثال: سأكون معك حالا.",
 "今すぐにでも": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "今っぽい": "عَصْرِيّ, حَدِيث",
 "今でこそ": "الْآنَ, حَالًا (في هذا الوقت الحالي)\nمثال: نحن بمأمن الآن.",
 "今では": "الْآنَ, حَالًا (في هذا الوقت الحالي)\nمثال: نحن بمأمن الآن.",
 "今でも": "سَاكِن, ثَابِت\nمثال: لا أحب المدرسة.",
 "今となっては": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "今どき": "الآن, اليوم (في هذه الأوقات)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "今なお": "سَاكِن, ثَابِت\nمثال: لا أحب المدرسة.",
