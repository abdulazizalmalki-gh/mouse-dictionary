 "前駆": "راكِب الطَّلِيعَة, مُرافِق مُتَقَدِّم (مرافق يركب (عادة دراجة أو حصاناً) في مقدمة الموكب) / بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / تنبؤ, توقع (فعل التنبؤ (عن طريق التفكير في المستقبل)) / ترقب, توقع (شيء متوقع حدوثه (بناءً على معيار معين)) / ترقب, توقع (توقع حدوث شيء) / ترقب, توقع (الترقب مع الثقة بالتحقق)\nمثال: كان لكل منهم توقعاته الخاصة",
 "前駆体": "بشير, سلف (شيء يسبق ويشير إلى اقتراب شيء أو شخص ما) / رَائِد, سَابِق (شخص يسبق غيره أو يعلن عن قدوم آخر) / سلائف, مادة أولية (مادة تتكون منها مادة أخرى (خاصة عن طريق تفاعل استقلابي))",
 "前駆戦": "مُنَاوَشَة",
 "前駆期": "أعراض أولية, بادرة مرضية (عرض مبكر يشير إلى أن المرض يتطور أو أن نوبة على وشك الحدوث)",
 "前駆症状": "أعراض أولية, بادرة مرضية (عرض مبكر يشير إلى أن المرض يتطور أو أن نوبة على وشك الحدوث)",
 "前駆陣痛": "انقباض براكستون هيكس, مخاض كاذب (انقباضات غير مؤلمة لعضلات الرحم تستمر طوال فترة الحمل بتواتر متزايد)",
 "前髪": "نَاصِيَة (خصلة من شعر عرف الحصان تنمو للأمام بين الأذنين) / خُصْلَة أَمَامِيَّة, نَاصِيَة (خصلة شعر تنمو (أو تتدلى) فوق الجبهة)",
 "剔": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة",
 "剔る": "تجويف, نقر (فعل النقر أو التجويف بأداة) / إزميل مقعر, مِنْقَار (أداة ذات حد بشفرة تشبه الميزاب لقطع القنوات أو الأخاديد) / انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة))",
 "剔出": "استخراج, خلع (عملية إخراج شيء ما (خاصة باستخدام الجهد أو القوة)) / أصل, منشأ (الخصائص المنسوبة لأسلافك) / استخراج, استخلاص (عملية الحصول على شيء من خليط أو مركب بوسائل كيميائية أو فيزيائية أو ميكانيكية)\nمثال: أعطاها طبيب الأسنان تخديراً موضعياً قبل الخلع",
 "剔抉": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "剔除": "تنحية, عزل (الفصل من منصب رسمي) / إزالة, نزع (عملية الإزالة)\nمثال: أجرى عملية جراحية لإزالة ورم خبيث",
 "剖検": "تَشْرِيح",
 "剛": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "剛の者": "مُحَارِب قَدِيم",
 "剛健": "حيوية, طاقة (أسلوب حيوي خيالي (خاصة أسلوب الكتابة)) / حيوية, نشاط (قوة نشطة للجسد أو العقل) / حيوية, طاقة (بذل قوي للجهد)\nمثال: تنقل كتابته طاقة كبيرة",
 "剛勇": "شَجَاعَة",
 "剛強": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "剛性": "شدة, صرامة (صرامة مفرطة) / ارْتِبَاك, ثِقَل ظِلّ (عدم الأناقة لشخص متصلب وغير مسترخٍ (بسبب الحرج مثلاً)) / جمود, صلابة (حزم ثابت في الغرض أو الرأي أو العمل) / تشنج, تصلب (خاصية التحرك بألم أو صعوبة)\nمثال: صرامة الشخصية",
 "剛性率": "مُعَامِل الصَّلَابَة, مُعَامِل القَصّ (معامل المرونة لقوة القص)",
 "剛情張": "عِنَاد",
 "剛愎": "عِنَاد",
 "剛毅": "ثبات, جلد (قوة العقل التي تمكن المرء من تحمل المحن بشجاعة)",
 "剛毛": "شعرة خشنة, هلبه (شعرة صلبة) / شعرة خشنة, شعيرة (ألياف صلبة (شعر خشن أو خيط)؛ طبيعية أو اصطناعية)",
 "剛気": "جَرِيء, جَسُور",
 "剛球": "كرة سريعة ((بيسبول) رمية ترمى بأقصى سرعة)\nمثال: تأخر في ضرب الكرة السريعة",
 "剛直": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم.",
 "剛胆": "جَرِيء, جَسُور",
 "剛腹": "عِنَاد",
 "剝がれ": "تَقْشِير",
 "剝く": "قَشَّرَ / قِشْرَة, قِشْر / خَالٍ مِنَ الزَّخْرَفَة, سَادَة (يفتقر إلى التزيين أو الزخرفة) / عَارِي الجَسَد, عُرْيَان (لا يرتدي أي ملابس على الجسد) / عَارٍ, مُجَرَّد (أُزِيلَ مِنْهُ كُلّ شَيْء زَائِد بِمَا فِي ذَلِكَ المُحْتَوَيَات) / جَرْدَاء, قَاحِلَة (لا توفِّر مأوى ولا قوتاً)",
 "剝れる": "بوز, حرد (مزاج أو إظهار للترفع العبوس أو الانسحاب)\nمثال: بقي في المنزل في حالة حرد / قَشَّرَ / قِشْرَة, قِشْر",
 "剝奪": "تعرية, كشف (إزالة الغطاء)",
 "剝板": "جبيرة (جهاز ميكانيكي لتقويم العظام يستخدم لتثبيت وحماية جزء من الجسم (مثل الساق المكسورة)) / شَظِيَّة خشبية, شُقَاقَة (شظية رفيعة من الخشب)\nمثال: أشعل النار باستخدام شظية خشبية مشتعلة",
 "剝片": "رُقَاقة, شَظِيَّة صغيرة (شظية صغيرة من شيء انفصلت عن الكل) / غَرِيب الْأَطْوَار (شخص ذو شخصية غير عادية أو غريبة) / ندفة الثلج (بلورة من الثلج)\nمثال: أصابت عينه شظية صخرية صغيرة",
 "剝皮": "تقشير (إزالة الغطاء الخارجي لعضو أو جزء)",
 "剝落": "تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة)\nمثال: دخل الفريق في حالة ركود",
 "剝離": "فصل, فك الارتباط (عملية التحرير من مرفق أو اتصال) / انفصال, تفكك (التفرق أو الانقسام) / انسحاب, تجرد (تجنب التورط العاطفي) / مفرزة (وحدة صغيرة من القوات ذات تكوين خاص) / تَفْرِقَة",
 "剣": "سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة) / سَيَّافٌ\nمثال: القلم أقوى من السيف. / حَرْبَة, سُونْكِيّ (آلة للحَرْب تكون قصيرة مُحَدَّدة الرَأس تستخدم للطَعْن. غالبا ما تُرَكَّب على غيرها مثل الرُمْح أو البُنْدُقِيَّة. الجمع حِرَاب وحَرْبَات؛ رأس حَرْبَة: تعبير مجازيّ يقصد به شيء يستخدم لتهديد العَدُو) / مبارزة, مهارة استخدام السيف (المهارة في المبارزة) / ضربة لاذعة (ضربة حادة مؤلمة) / إبرة لاسعة (عضو حاد للهجوم أو الدفاع (كما في الدبور أو سمك الراي اللاسع أو العقرب) غالباً ما يكون متصلاً بغدة سم) / ستينغر (نظام صواريخ أرض-جو محمول منخفض الارتفاع يستخدم التوجيه بالأشعة تحت الحمراء وصمام تصادم؛ يطلق من الكتف) / طَعْنَة, كَلِمَة جَارِحَة (ملاحظة قادرة على الجرح معنوياً)\nمثال: الطعنة الأكثر قسوة على الإطلاق",
 "剣が峰": "حلبة المصارعة (حلبة مربعة يتنافس فيها المصارعون)",
 "剣の道": "مبارزة, مهارة استخدام السيف (المهارة في المبارزة)",
 "剣ケ峰": "حلبة المصارعة (حلبة مربعة يتنافس فيها المصارعون)",
 "剣ヶ峰": "حلبة المصارعة (حلبة مربعة يتنافس فيها المصارعون)",
 "剣匠": "سَيَّاف, سَلَّال",
 "剣呑": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "剣士": "سَيَّاف",
 "剣奴": "مُجَالِد, مُصَارِع",
 "剣山": "ضِفْدِع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضَفْدَع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضِفْدَع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضفدع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / بقرور\nمثال: الضفدع في البئر.",
 "剣微塵子": "سَايْكْلُوب",
 "剣戟": "سِلَاح, أَسْلِحَة",
 "剣技": "مبارزة, مهارة استخدام السيف (المهارة في المبارزة)",
 "剣歯虎": "نمر سيفي الأسنان (أي من العديد من القطط المنقرضة في العالم القديم والجديد ذات أنياب علوية طويلة تشبه السيف؛ من العصر الأوليغوسيني حتى البليستوسيني)",
 "剣法": "مُبَارَزَة",
 "剣状": "سَيْفِيّ الشَّكْل (على شكل نصل السيف)",
 "剣状突起": "زائدة سيفية, ناتئ رهابي (أصغر الأجزاء الثلاثة لعظم القص؛ يتمفصل مع جسم القص والضلع السابع)",
 "剣状軟骨": "زائدة سيفية, ناتئ رهابي (أصغر الأجزاء الثلاثة لعظم القص؛ يتمفصل مع جسم القص والضلع السابع)",
 "剣石": "حجر العقد (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "剣突": "تَقْرِيع شَدِيد, تَوْبِيخ لَاذِع (توبيخ شديد وقاسٍ)",
 "剣突く": "تَقْرِيع شَدِيد, تَوْبِيخ لَاذِع (توبيخ شديد وقاسٍ)",
 "剣突を食わせる": "ازدراء, تجاهل (رفض التعرف على شخص تعرفه) / أَفْطَس, قَصِير بِشَكْل غَيْر عَادِيّ (قَصير بِشَكْل غَيْر اعتِيادِيّ) / رفض, زجر (حالة من الإبعاد أو الصد)\nمثال: كان التجاهل متعمداً بوضوح",
 "剣竜": "ستيغوصور (ديناصور عاشب من رتبة طيريات الورك، يتميز بصف من الصفائح العظمية على ظهره وذيل شائك يُحتمل أنه استخدم كسلاح)",
 "剣筋": "مبارزة, مهارة استخدام السيف (المهارة في المبارزة)",
 "剣舞": "رقصة السيف (أي من الرقصات المختلفة التي يؤديها رجال يخطون برشاقة فوق السيوف أو يلوحون بها في الهواء)",
 "剣術": "مُبَارَزَة",
 "剣術使い": "مبارز (شخص ماهر في المبارزة بالسيف)",
 "剣術者": "مبارز (شخص ماهر في المبارزة بالسيف)",
 "剣闘士": "مُجَالِد, مُصَارِع",
 "剣龍": "ستيغوصور (ديناصور عاشب من رتبة طيريات الورك، يتميز بصف من الصفائح العظمية على ظهره وذيل شائك يُحتمل أنه استخدم كسلاح)",
 "剤": "دَوَاء / عِلَاج, شِفَاء / طِبّ (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "剥がれ": "تَقْشِير",
 "剥き出し": "عُرْيَان, عَارٍ / إِفْرَنْجِيّ",
 "剥き出す": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه.",
 "剥く": "قَشَّرَ / قِشْرَة, قِشْر / خَالٍ مِنَ الزَّخْرَفَة, سَادَة (يفتقر إلى التزيين أو الزخرفة) / عَارِي الجَسَد, عُرْيَان (لا يرتدي أي ملابس على الجسد) / عَارٍ, مُجَرَّد (أُزِيلَ مِنْهُ كُلّ شَيْء زَائِد بِمَا فِي ذَلِكَ المُحْتَوَيَات) / جَرْدَاء, قَاحِلَة (لا توفِّر مأوى ولا قوتاً)",
 "剥げる": "اختفاء, تلاشٍ (التوقف التدريجي عن الظهور) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة",
 "剥れる": "بوز, حرد (مزاج أو إظهار للترفع العبوس أو الانسحاب)\nمثال: بقي في المنزل في حالة حرد / قَشَّرَ / قِشْرَة, قِشْر",
 "剥奪": "تعرية, كشف (إزالة الغطاء)",
 "剥板": "جبيرة (جهاز ميكانيكي لتقويم العظام يستخدم لتثبيت وحماية جزء من الجسم (مثل الساق المكسورة)) / شَظِيَّة خشبية, شُقَاقَة (شظية رفيعة من الخشب)\nمثال: أشعل النار باستخدام شظية خشبية مشتعلة",
 "剥片": "رُقَاقة, شَظِيَّة صغيرة (شظية صغيرة من شيء انفصلت عن الكل) / غَرِيب الْأَطْوَار (شخص ذو شخصية غير عادية أو غريبة) / ندفة الثلج (بلورة من الثلج)\nمثال: أصابت عينه شظية صخرية صغيرة",
 "剥皮": "تقشير (إزالة الغطاء الخارجي لعضو أو جزء)",
 "剥脱性皮膚炎": "احمرار الجلد (أي اضطراب جلدي ينطوي على احمرار غير طبيعي)",
 "剥落": "تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة)\nمثال: دخل الفريق في حالة ركود",
 "剥製": "حشو (حشوة توضع في المراتب والوسائد والأثاث المنجد) / تتبيلة الحشو, حشوة (خليط من المكونات المتبلة يستخدم لحشو اللحوم والخضروات)",
 "剥製術": "تحنيط (فن تركيب جلود الحيوانات بحيث يكون لها مظهر نابض بالحياة)",
 "剥離": "فصل, فك الارتباط (عملية التحرير من مرفق أو اتصال) / انفصال, تفكك (التفرق أو الانقسام) / انسحاب, تجرد (تجنب التورط العاطفي) / مفرزة (وحدة صغيرة من القوات ذات تكوين خاص) / تَفْرِقَة",
 "剪み切る": "قصاصة, قُصاصة (عملية القص أو القصقصة) / قُصاصة, نتفة (قطعة صغيرة من أي شيء (خاصة قطعة تم قصها))",
 "剪む": "مِشْبَك / كْلِيبْ",
 "剪る": "جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح.",
 "剪刀": "مِقَصّ, مِقْرَاض",
 "剪定": "تقليم (عملية تشذيب النبات) / قُلامَة (ما تم تقليمه وقصه من النبات)",
 "剪定ばさみ": "مقص تقليم, مقص شجر (مقص بشفرات قوية يستخدم للتقليم الخفيف للنباتات الخشبية)",
 "剪定器": "مقص تقليم, مِنجل تقليم (منشار تقليم طويل المقبض بشفرة منحنية في النهاية وأحياناً مقص؛ يستخدم لتقليم الأشجار الصغيرة) / مقلّم الأشجار (عامل يخفف ويشذب الأشجار والشجيرات)\nمثال: لم يمسها فأس مقلّم الأشجار",
 "剪定鋏": "مقص تقليم, مقص شجر (مقص بشفرات قوية يستخدم للتقليم الخفيف للنباتات الخشبية)",
 "剪断": "جَزَّ, قَصَّ (جَزَّ النخلُ ونحوُه يَجُزُّ جَزًّا: حان أَن يُقطَعَ ثَمَرُهُ؛ جَزَّ النَّخلَةَ جَزًّا، وجِزَازاً: قَطعَ ثمَرَها)\nمثال: طلبت من توم جز عشبنا.",
 "剪断機": "جَزّاز, قاص الصوف (عامل ماهر يقوم بجز الصوف عن الأغنام أو الحيوانات الأخرى) / جزّاز (عامل يستخدم المقصات لقطع الجلد أو المعدن أو المنسوجات)",
 "剪枝": "تقليم (عملية تشذيب النبات) / قُلامَة (ما تم تقليمه وقصه من النبات)",
 "剪裁": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة",
 "剪除": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / استئصال, بتر (عملية قطع شيء ما)\nمثال: أعطاه الحلاق قصة جيدة",
 "副": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري. / تَوْأَمِيّ, مُتَمَاثِل (يكون اثنين متطابقين) / مُسْتَنْسَخ, مُكَرَّر (منسوخ بشكل مطابق عن الأصل) / تكرار, نسخة طبق الأصل (نسخة تتوافق مع الأصل تماماً) / بديل احتياطي, نسخة إضافية (شيء إضافي من نفس النوع)\nمثال: صنع نسخة للملفات / ظَرْف (ظَرْف: اسم؛ ظَرْف الشيء وعاءه. الجمع ظُرُوف؛ ظَرْف: اسم؛ كيس من الورق توضع فيه الرسائل وغيرها. \"وضعت الرسالة في الظرف\")\nمثال: أغلقت ذلك الظرف.",
 "副う": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري. / رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟ / تَزَوَّجَ / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "副え木": "جبيرة (جهاز ميكانيكي لتقويم العظام يستخدم لتثبيت وحماية جزء من الجسم (مثل الساق المكسورة)) / شَظِيَّة خشبية, شُقَاقَة (شظية رفيعة من الخشب)\nمثال: أشعل النار باستخدام شظية خشبية مشتعلة / وصلة تراكبية (وصلة تصنع عن طريق تداخل طرفين وربطهما معاً) / لصقة, وصلة (نقطة اتصال حيث يتم ضم شيئين (مثل الورق أو الفيلم أو الشريط المغناطيسي) معاً)\nمثال: كان الانقطاع بسبب وصلة غير متقنة",
 "副プログラム": "إجراء, دالة (تسلسل محدد من الخطوات، جزء من برنامج حاسوبي أكبر)",
 "副主席": "نَائِب رَئِيس, نَائِبَةُ رَئِيسَة",
 "副交感神経系": "الجهاز العصبي الباراسمبثاوي, الجهاز العصبي اللاودي (ينشأ في جذع الدماغ والجزء السفلي من الحبل الشوكي؛ يعارض التأثيرات الفسيولوجية للجهاز العصبي الودي: يحفز الإفرازات الهضمية؛ يبطئ القلب؛ يقبض حدقة…)",
 "副会長": "نَائِب رَئِيس, نَائِبَةُ رَئِيسَة",
 "副作用": "أَثَر جَانِبِيّ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "副反応": "أَثَر جَانِبِيّ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "副大統領": "نَائِب رَئِيس, نَائِبَةُ رَئِيسَة",
 "副大統領候補": "نائب رئاسي (يتعلق بنائب الرئيس أو بمنصب نائب الرئيس)\nمثال: مناظرات نواب الرئيس",
 "副子": "جبيرة (جهاز ميكانيكي لتقويم العظام يستخدم لتثبيت وحماية جزء من الجسم (مثل الساق المكسورة)) / شَظِيَّة خشبية, شُقَاقَة (شظية رفيعة من الخشب)\nمثال: أشعل النار باستخدام شظية خشبية مشتعلة",
 "副官": "لقلق مساعد (لقلق هندي كبير ذو مشية عسكرية) / مرافق عسكري, مساعد (ضابط يعمل كمساعد عسكري لضابط أعلى رتبة)",
 "副審": "حكم مساعد, مراقب الخط (حكم (في التنس، كرة القدم، إلخ) يساعد الحكم الرئيسي بطريقة ما (خاصة بمراقبة خروج الكرة أو التسلل))",
 "副専攻": "صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة) / أصغر, أقلية (أقل في العدد أو الحجم أو المقدار) / بسيط, ثانوي (أقل في النطاق أو التأثير) / قاصر (لم يبلغ السن القانونية)\nمثال: حصة صغيرة من الأرباح",
 "副将軍": "فريق (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد.",
 "副尺": "مقياس ورني, ورنية (مقياس صغير متحرك ينزلق على طول مقياس رئيسي؛ المقياس الصغير معاير للإشارة إلى الأقسام الكسرية للمقياس الرئيسي)",
 "副弐": "ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة الأُُولى)\nمثال: ثانوية زيري ضخمة.",
 "副手": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "副操縦士": "مساعد طيار (طيار مساعد على متن طائرة)",
 "副文": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية) / جملة تابعة, جملة ثانوية (جملة في جملة معقدة لا يمكن أن تقف وحدها كجملة كاملة وتعمل داخل الجملة كاسم أو صفة أو ظرف)",
 "副書": "نُسْخَة / اِنْتَسَخَ, نَسَخَ",
 "副木": "جبيرة (جهاز ميكانيكي لتقويم العظام يستخدم لتثبيت وحماية جزء من الجسم (مثل الساق المكسورة)) / شَظِيَّة خشبية, شُقَاقَة (شظية رفيعة من الخشب)\nمثال: أشعل النار باستخدام شظية خشبية مشتعلة",
 "副本": "تَوْأَمِيّ, مُتَمَاثِل (يكون اثنين متطابقين) / مُسْتَنْسَخ, مُكَرَّر (منسوخ بشكل مطابق عن الأصل) / تكرار, نسخة طبق الأصل (نسخة تتوافق مع الأصل تماماً) / بديل احتياطي, نسخة إضافية (شيء إضافي من نفس النوع)\nمثال: صنع نسخة للملفات",
 "副業": "هواية (نشاط إضافي أو جانبي) / خط جانبي, نشاط فرعي (خط بضائع إضافي أو مساعد) / خط التماس, خط الجانب (خط يحدد الحدود الجانبية لملعب اللعب)",
 "副次文化": "ثقافة فرعية (مجموعة اجتماعية داخل ثقافة وطنية لها أنماط مميزة من السلوك والمعتقدات)",
 "副次的": "ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة الأُُولى)\nمثال: ثانوية زيري ضخمة.",
 "副牧師": "راعي, قس (شخص مخول لإقامة الشعائر الدينية)\nمثال: يُطلق عادة على رجال الدين لقب قسيس في الكنائس البروتستانتية",
 "副王": "نَائِب",
 "副生": "منتج ثانوي (منتج تم صنعه أثناء تصنيع شيء آخر) / منتج ثانوي, ناتج عرضي (عاقبة ثانوية وغير متوقعة أحياناً)",
 "副生成物": "منتج ثانوي (منتج تم صنعه أثناء تصنيع شيء آخر) / منتج ثانوي, ناتج عرضي (عاقبة ثانوية وغير متوقعة أحياناً)",
 "副生物": "منتج ثانوي (منتج تم صنعه أثناء تصنيع شيء آخر) / منتج ثانوي, ناتج عرضي (عاقبة ثانوية وغير متوقعة أحياناً)",
 "副産物": "منتج ثانوي (منتج تم صنعه أثناء تصنيع شيء آخر) / منتج ثانوي, ناتج عرضي (عاقبة ثانوية وغير متوقعة أحياناً)",
 "副甲状腺": "غدة جار درقية, غدة جارات الدرقية (أي واحدة من أربع غدد صماء تقع فوق أو داخل الغدة الدرقية)",
 "副甲状腺ホルモン": "باراثورمون, هرمون الغدة الجار درقية (هرمون يتم تصنيعه وإطلاقه في مجرى الدم بواسطة الغدد الجار درقية؛ ينظم الفوسفور والكالسيوم في الجسم)",
 "副甲状腺機能亢進症": "فرط نشاط جارات الدرقية (إفراز مفرط لهرمون الغدة الجار درقية يؤدي إلى مستويات عالية غير طبيعية من الكالسيوم في الدم؛ يمكن أن يؤثر على العديد من أجهزة الجسم (خاصة التسبب في…)",
 "副甲状腺機能低下症": "قصور الدريقية, قصور جارات الدرقية (إفراز غير كافٍ لهرمون الغدة الجار درقية يؤدي إلى مستويات منخفضة غير طبيعية من الكالسيوم في الدم)",
 "副睾丸": "بَرْبَخ",
 "副睾丸炎": "التهاب البربخ (التهاب مؤلم في البربخ)",
 "副知事": "نائب الحاكم (مسؤول منتخب يعمل كنائب لحاكم ولاية أمريكية)",
 "副神経": "عصب إضافي, عصب قحفي حادي عشر (ينشأ من مجموعتين من الجذور (قحفية وشوكية) تتحد لتشكل العصب)",
 "副総裁": "نَائِب رَئِيس, نَائِبَةُ رَئِيسَة",
 "副署": "توقيع مصادقة (توقيع تأكيد ثانٍ يصادق على وثيقة موقعة بالفعل)",
 "副腎": "غُدَّة كَظَرِيَّة",
 "副腎皮質": "قشرة الغدة الكظرية (قشرة الغدة الكظرية؛ تفرز الكورتيكوستيرون والهرمونات الجنسية)",
 "副腎皮質刺激ホルモン": "هرمون موجه لقشر الكظر (هرمون تنتجه الغدة النخامية الأمامية يحفز قشرة الغدة الكظرية)",
 "副腎髄質": "نخاع الغدة الكظرية (نخاع الغدة الكظرية؛ يفرز الإبينفرين)",
 "副菜": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له)",
 "副見出し": "عنوان فرعي (عنوان لقسم فرعي من نص)",
 "副詞": "ظَرْف (ظَرْف: اسم؛ ظَرْف الشيء وعاءه. الجمع ظُرُوف؛ ظَرْف: اسم؛ كيس من الورق توضع فيه الرسائل وغيرها. \"وضعت الرسالة في الظرف\")\nمثال: أغلقت ذلك الظرف.",
 "副詞的": "ظَرْف (ظَرْف: اسم؛ ظَرْف الشيء وعاءه. الجمع ظُرُوف؛ ظَرْف: اسم؛ كيس من الورق توضع فيه الرسائل وغيرها. \"وضعت الرسالة في الظرف\")\nمثال: أغلقت ذلك الظرف.",
 "副長": "ضابط تنفيذي, نائب القائد (الضابط الثاني في القيادة)",
 "副題": "عَنَاوِين فَرْعِيَّة, عُنْوَان فَرْعِيّ / تَرْجَمَة, سَتْرَجَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون) / مثال: أنا مدرس للترجمة.",
 "副食": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له)"
}
