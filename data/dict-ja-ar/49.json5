 "誰彼構わず": "بشكل عشوائي, دون تمييز (بطريقة عشوائية)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "誰彼無しに": "مَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "誰得": "بدون جدوى",
 "誰誰": "فُلَان, فُلَانَة (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو…)\nمثال: سمعنا ذلك من فلان و فلان.",
 "課": "دَرْس, حِصَّة ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: أراك بعد الدرس. / قِسْم, جُزْء (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ…)\nمثال: أنا أزين القسم.",
 "課す": "تجنيد عام, نفير عام (فعل التجنيد في الخدمة العسكرية)",
 "課する": "تجنيد عام, نفير عام (فعل التجنيد في الخدمة العسكرية)",
 "課外": "خَارِج نِطَاق الزَّوَاج, زَانٍ (يتسم بالزنا أو العلاقات خارج إطار الزواج)",
 "課外活動": "نشاط لا صفي (أنشطة تعليمية لا تقع ضمن نطاق المناهج الدراسية العادية)",
 "課徴金": "تُهْمَة\nمثال: أقوم بشحن هاتفي",
 "課業": "عمل منزلي, واجب مدرسي (عمل، مثل العمل المدرسي أو العمل بالقطعة، يتم في المنزل)",
 "課目": "فَاعِل, مُبْتَدَأ (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / بَنْد",
 "課程": "طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ.",
 "課税": "جباية الضرائب, فرض الضرائب (فرض الضرائب؛ ممارسة الحكومة في جباية الضرائب على رعايا الدولة)",
 "課税率": "معدل الضريبة, نسبة الضريبة (المعدل المستخدم لحساب الالتزام الضريبي)",
 "課金": "تُهْمَة\nمثال: أقوم بشحن هاتفي",
 "課題": "فَاعِل, مُبْتَدَأ (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / وَاجِب, وَاجِب مَنْزِلِيّ (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / تَمْرِين / طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق.",
 "課題曲": "قطعة ديكور مستقلة (قطعة من المناظر تهدف إلى الوقوف بمفردها كجزء من إعداد المسرح)",
 "誹り": "لَامَ, اِسْتَنْكَرَ (لامَ يَلوم ، لُمْ ، لَوْمًا ، فهو لائم والجمع : لُوَّمٌ ، ولُيَّمٌ وهو أَيضاً…)\nمثال: لام سامي معلمه على فشله هو.",
 "誹る": "تَشْهِير, اِفْتِرَاء",
 "誹毀": "تَشْهِير, بُهْتَان",
 "誹謗": "تَشْهِير, اِفْتِرَاء",
 "誹謗中傷": "تَشْهِير, اِفْتِرَاء",
 "誹譏": "تَشْهِير, بُهْتَان",
 "誹議": "نَقْد, اِنْتِقَاد",
 "誼": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق…)\nمثال: الغيرة عدوة الصداقة.",
 "誼み": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق…)\nمثال: الغيرة عدوة الصداقة.",
 "調": "جِزْيَة / ضَرِيبَة / زِرّ / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / مِقْيَاس\nمثال: هبطت على البحر.",
 "調える": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة. / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه…)\nمثال: جهز زيري حقائبه. / ضَبَطَ",
 "調べ": "تَحْقِيق / لَحْن (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن.",
 "調べた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "調べなおす": "أَعَادَ الفحص, رَاجَعَ (نظر مرة أخرى؛ فحص مرة أخرى)\nمثال: لنراجع وضعك",
 "調べもの": "تَحْقِيق",
 "調べる": "فَحَصَ, اِمْتَحَنَ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في :…)\nمثال: فحص الطبيب بطني.",
 "調べ室": "صندوق تعريق (جهاز يسبب تعرق أوراق التبغ أو الفاكهة أو الجلود)",
 "調べ帯": "حِزَام, زُنَّار (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة…)\nمثال: هذا حزام من الجلد.",
 "調べ物": "تَحْقِيق",
 "調べ直す": "أَعَادَ الفحص, رَاجَعَ (نظر مرة أخرى؛ فحص مرة أخرى)\nمثال: لنراجع وضعك",
 "調伏": "رُقْيَة",
 "調停": "وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / ترضية, مصالحة (فعل الترضية والتغلب على عدم الثقة والعداء)\nمثال: كانت هناك فترة وجيزة من المصالحة لكن القتال سرعان ما استؤنف",
 "調停者": "حَكَم, مُحكِّم (شخص يتم اختياره للحكم والبت في قضية متنازع عليها)\nمثال: اعتُبر الناقد حكماً للأدب الحديث",
 "調光": "مخفت الإضاءة (مقاومة متغيرة تغير التيار عبر مصباح كهربائي للتحكم في مستوى الإضاءة)",
 "調光器": "مخفت الإضاءة (مقاومة متغيرة تغير التيار عبر مصباح كهربائي للتحكم في مستوى الإضاءة)",
 "調剤": "تركيب, جمع (عملية دمج الأشياء لتكوين كلٍ جديد)",
 "調剤師": "موزع (حاوية مصممة بحيث يمكن استخدام المحتويات بكميات محددة)",
 "調剤薬局": "مستوصف (عيادة يتم فيها صرف الأدوية والمستلزمات الطبية)",
 "調印": "تَوْقِيع, إِمْضَاء (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم.",
 "調印者": "مُوقّع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "調号": "توقيع المفتاح, دليل المفتاح (علامات الرفع (الدييز) أو الخفض (البيمول) التي تتبع المفتاح وتشير إلى السلم…)",
 "調合": "خلط, خليط (عملية خلط الأشياء معاً)\nمثال: عجينة مصنوعة من خليط الدقيق والماء",
 "調合剤": "خَلِيط",
 "調味": "بَهَار, تَابِل",
 "調味料": "بَهَار, تَابِل",
 "調和": "اِنْسِجَام, تَوَافُق",
 "調和平均": "وسط توافقي",
 "調和数列": "متتالية توافقية ((رياضيات) متتالية من الحدود تشكل مقلوباتُها متتالية حسابية)",
 "調和解析": "تحليل توافقي, تحليل فورييه (تحليل دالة دورية إلى مجموع مكونات جيبية بسيطة)",
 "調子": "لَحْن (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن. / وَرِيد, عِرْق / شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / دفعة, قوة دافعة مفاجئة (فعل تطبيق قوة فجأة)\nمثال: الدفعة المفاجئة أسقطته أرضاً",
 "調子がいい": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين)",
 "調子がよい": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين)",
 "調子が良い": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين)",
