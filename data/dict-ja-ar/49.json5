 "鼻ピー": "بُرَة",
 "鼻メガネ": "نظارة مشبك الأنف (نظارات تُثبت على الأنف بواسطة زنبرك)",
 "鼻中隔": "حَاجِز الأَنْف",
 "鼻中隔彎曲症": "انحراف الحاجز الأنفي (تحول غير طبيعي في موقع الحاجز الأنفي؛ حالة شائعة تسبب انسداد الممرات الأنفية وصعوبة في التنفس ونزيف متكرر للأنف)",
 "鼻中隔湾曲症": "انحراف الحاجز الأنفي (تحول غير طبيعي في موقع الحاجز الأنفي؛ حالة شائعة تسبب انسداد الممرات الأنفية وصعوبة في التنفس ونزيف متكرر للأنف)",
 "鼻元思案": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "鼻先": "أَمَامَ, قُدَّامَ / أَمَامَ / طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "鼻先分別": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "鼻先思案": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "鼻出血": "رُعَاف",
 "鼻口": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة / مَنْخَر",
 "鼻口部": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة",
 "鼻向け": "شم (فعل إدراك رائحة شيء ما)",
 "鼻周囲": "حول أنفي (يقع بالقرب من الأنف)",
 "鼻咽頭": "بلعوم أنفي (تجويف يشكل الجزء العلوي من البلعوم)",
 "鼻唄": "دندنة (فعل الغناء بشفاه مغلقة) / دندنة, همهمة (صوت همهمة)\nمثال: همهمة حركة المرور البعيدة",
 "鼻垂らし": "مُخَنْفِر (شخص يتنفس بصوت مسموع من خلال أنف محتقن) / ساذج, غر (شاب أخرق وقليل الخبرة)",
 "鼻垂れ": "مُخَنْفِر (شخص يتنفس بصوت مسموع من خلال أنف محتقن) / ساذج, غر (شاب أخرق وقليل الخبرة)",
 "鼻孔": "مَنْخَر",
 "鼻屎": "مُخَاط, مُخَاط أَنْف",
 "鼻嵐": "نخير, نفخ (فعل الزفير بقوة)",
 "鼻差": "نهاية متقاربة جداً, نهاية مصورة (بشكل عام، أي نهاية متقاربة جداً؛ وتحديداً، نهاية سباق يكون فيه المتسابقون قريبين جداً من بعضهم البعض بحيث يجب تحديد الفائز من صورة التقطت لحظة النهاية)",
 "鼻形成術": "تجميل الأنف (جراحة تجميلية لتحسين مظهر الأنف)",
 "鼻息": "اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً) / إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / إثارة, انتعاش (الشعور بفرح حيوي ومبهج) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم",
 "鼻息が荒い": "آمِر / ثَقِيل",
 "鼻息の荒い": "آمِر",
 "鼻拭き": "مِنْدِيل, مَحْرَمَة",
 "鼻持ちならない": "زَنِخ, مُنْتِن (ذُو رَائِحَةٍ كَرِيهَةٍ بِشَكْلٍ مُؤْذٍ) / غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "鼻持ちならぬ": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "鼻摘まみ": "إِزْعَاج",
 "鼻摘み": "إِزْعَاج",
 "鼻曲がり": "سيء المزاج, عبوس (شخص سيء الطباع)",
 "鼻曲り": "سيء المزاج, عبوس (شخص سيء الطباع)",
 "鼻木": "بُرَة",
 "鼻柱": "حاجز, وتيرة ((في التشريح) فاصل يقسم بين نسيجين أو تجويفين) / حاجز (فاصل أو جدار خاصة في المبيض)",
 "鼻栓": "إِسْفِين (عبارة عن وَتَد أو قطعة من الخَشَب أو الحَدِيد تستخدم في البِنَاء والنِجَارَة بلإبقاء على فُرْجَة بين الأجسام، خصوصا ألواح الخشب، أو لتكوين هذه الفرجة؛ دَقَّ بينهم إسفينا: فَرَّقَ بينهم) / وَتِد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / وَتَد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها)",
 "鼻根": "أَنْف, خَشَم (أنف:اشْتَكَى أَنفه فَهُوَ مأنوف؛ أنف الشَّيْء: حدد طرفه)\nمثال: أنت لديك أنف كبير.",
 "鼻歌": "دندنة (فعل الغناء بشفاه مغلقة) / دندنة, همهمة (صوت همهمة)\nمثال: همهمة حركة المرور البعيدة",
 "鼻母音": "صائت أنفي, غنة ((صوتيات) صائت يتم إنتاجه بخفض الحنك الرخو بحيث يخرج الهواء من خلال الأنف والفم)",
 "鼻毛": "مُغَفَّل, أَحْمَق",
 "鼻毛を抜く": "مُغَفَّل, أَحْمَق",
 "鼻気管炎": "التهاب الأنف والقصبة الهوائية (عدوى تنفسية في الأنف والحلق في الماشية)",
 "鼻水": "مُخَاط, مُخَاط أَنْف",
 "鼻汁": "مُخَاط, مُخَاط أَنْف",
 "鼻涙管": "قناة أنفية دمعية (قناة تحمل الدموع من الكيس الدمعي إلى التجويف الأنفي)",
 "鼻漏": "ثر أنفي, سيلان الأنف (إفراز مخاطي مائي مستمر من الأنف (كما في نزلات البرد))",
 "鼻炎": "التهاب الأنف, زكام (التهاب الغشاء المخاطي المبطن للأنف (يرتبط عادة بإفرازات أنفية))",
 "鼻熊": "قوطي (ثديي قارت من أمريكا الوسطى وأمريكا الجنوبية)",
 "鼻甲介": "قُرَيْن أَنْفِي, مَحَارَة أَنْفِيَّة (واحدة من عدة عظام قرينية الشكل في التجويف الأنفي)",
 "鼻疽": "رُعَام",
 "鼻瘤": "فيمة الأنف (تضخم الأنف مع توسع الجريبات واحمرار وبروز الأوعية الدموية في الجلد)",
 "鼻眼鏡": "نظارة مشبك الأنف (نظارات تُثبت على الأنف بواسطة زنبرك)",
 "鼻祖": "مُؤَسِّس, مُؤَسِّسَة",
 "鼻穴": "مَنْخَر",
 "鼻突き合い": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "鼻糞": "مُخَاط, مُخَاط أَنْف",
 "鼻紙": "ورق رقيق, ورق مناديل (ورق ناعم رقيق (شفاف عادة))",
 "鼻綱": "دبوس التوازن (أي من الأجنحة الخلفية الضامرة للحشرات ثنائية الأجنحة؛ تستخدم للحفاظ على التوازن أثناء الطيران) / بلوزة برباط عنق, هالتر توب (توب نسائي يربط خلف الظهر والرقبة ويترك الظهر والذراعين مكشوفين) / رسن, مقود (غطاء رأس من الحبل أو القماش للحصان، مع حبل للقيادة) / حبل المشنقة (حبل يستخدمه الجلاد لإعدام الأشخاص المحكوم عليهم بالموت شنقاً)",
 "鼻腔": "جوف الأنف ((جَوَّفَ) الشَّيْء: جعل لَهُ جوفا؛ (جَوَّفَ) الصَّيْد: طعنه فِي جَوْفه)",
 "鼻茸": "شبه غدي, غداني (يتعلق بـ أو يشبه الغدد الليمفاوية أو الأنسجة اللمفاوية) / لحمية, لوزة بلعومية (تجمع من الأنسجة اللمفاوية في الحلق خلف اللهاة (على الجدار الخلفي وسقف البلعوم الأنفي))\nمثال: تضخم اللوزتين البلعوميتين يسمى اللحمية",
 "鼻薬": "رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "鼻薬を嗅がせる": "رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "鼻血": "رُعَاف",
 "鼻輪": "بُرَة",
 "鼻面": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة",
 "鼻音": "أَنْفِي",
 "鼻音化": "غُنَّة",
 "鼻風": "زكام الرأس (زكام شائع يصيب الممرات الأنفية ويؤدي إلى احتقان وعطس وصداع) / نخير, نفخ (فعل الزفير بقوة)",
 "鼻風邪": "زكام الرأس (زكام شائع يصيب الممرات الأنفية ويؤدي إلى احتقان وعطس وصداع)",
 "鼻骨": "عظم أنفي (عظم مستطيل الشكل يشكل جسر الأنف)",
 "鼻高": "مَغْرُور, فَخُور",
 "鼻高々": "فَخُور",
 "鼻高高": "فَخُور",
 "鼻髭": "شَارِب",
 "鼾": "شخير (فعل الشخير أو إصدار صوت الشخير)",
 "鼾を掻く": "شَخَرَ / شَخِير",
 "齊": "طاقة تشي, كي (طاقة الحياة المتداولة التي يعتقد في الفلسفة الصينية أنها كامنة في كل شيء؛ في الطب الصيني التقليدي يعتبر توازن الأشكال السلبية والإيجابية في الجسم…)",
 "齒": "سِنّ, سن ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: هم في نفس السن. / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "齟齬": "تَنَاقُض, عَدَم اتِّسَاق (صفة عدم الاتساق وافتقار الانسجام بين الأشياء أو الأجزاء) / تَعَارُض, تَنَافُر (العلاقة بين القضايا التي لا يمكن أن تكون صحيحة في نفس الوقت)",
 "齢": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي. / انسلاخ, طور يرقِي (حشرة أو مفصلي آخر بين فترات الانسلاخ) / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "齢する": "دبلوم متوسط, درجة مشارك (درجة تمنحها كلية لمدة عامين عند إتمام الطالب بنجاح للدراسات الجامعية الأولية) / قرين, مرافق (أي حدث يصاحب عادة أو يرتبط ارتباطاً وثيقاً بآخر) / رَفِيق, زَمِيل (شخص ينضم للآخرين في نشاط أو مسعى) / زميل مشارك, شريك (شخص ذو عضوية تابعة في جمعية أو مؤسسة أو مؤسسة تجارية)\nمثال: أولاً كان البرق ثم قرينه الراعد",
 "齢を重ねる": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "齣": "أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ) / وَرَّطَ / لَقْطَة\nمثال: دهنت أطر النافذة بالأصفر. / مَنْظَر, مَشْهَد / مَشْهَد / عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / مَثَّلَ (الشَبَه؛ النَظِير) / تَصَرَّفَ\nمثال: المهم هو العمل. / فِقْرَة, بَنْد / قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "齧る": "نَخَرَ, قَضَمَ",
 "齧歯": "قَارِض, قَوَارِض",
 "齧歯動物": "قَارِض, قَوَارِض",
 "齧歯類": "قَارِض, قَوَارِض",
 "齲蝕": "تسوس, تسوس الأسنان (منطقة لينة متآكلة في السن؛ ويمكن أن يؤدي التسوس التدريجي إلى موت السن)",
 "齷齪": "بانشغال, بنشاط (بطريقة مشغولة)\nمثال: كانوا منشغلين بشراء الهدايا التذكارية",
 "龍": "تِنِّين / لغات ناغا (لغات كاماروبان يتم التحدث بها في شمال شرق الهند وغرب بورما)",
 "龍が如く": "يَاكُوزَا",
 "龍の落とし子": "حصان البحر (سمكة صغيرة برأس يشبه الحصان ينحني بحدة للأسفل وذيل ملتف؛ تسبح في وضع عمودي) / فظ (أي من ثدييين بحريين شماليين كبيرين لهما أنياب عاجية وجلد قوي فوق دهن سميك)",
 "龍吐水": "غَيْر آلِيّ, يَدَوِيّ التَّشْغِيل (يعمل باليد وبتشغيل يدوي) / رشاش ماء, مسدس مائي (لعبة تتكون من مسدس لعبة يرش الماء)",
 "龍宮の使い": "سمكة المجداف, ملك الرنجة (سمكة استوائية رفيعة تعيش في المياه العميقة يتراوح طولها بين 20 و 30 قدماً ولها زعنفة ظهرية حمراء)",
 "龍涎香": "عَنْبَر",
 "龍眼": "لونجان, لونغان (شجرة من جنوب شرق آسيا إلى أستراليا تزرع أساساً لفاكهتها الحلوة الصالحة للأكل التي تشبه مكسرات الليتشي)",
 "龍神": "لغات ناغا (لغات كاماروبان يتم التحدث بها في شمال شرق الهند وغرب بورما)",
 "龍胆": "جَنْطِيَانَا, كُوشَاد",
 "龍舌蘭": "أغاف, ألوة أمريكية (نباتات أمريكية استوائية ذات وريدات قاعدية من أوراق ليفية تشبه السيف وأزهار في سنابل طويلة؛ يزرع بعضها للزينة أو للألياف)",
 "龍頭蛇尾": "انحدار في الأسلوب, هبوط مفاجئ (تغيير من موضوع جاد إلى موضوع مخيب للآمال) / تراجع مخيب, خيبة أمل (تراجع مخيب للآمال بعد ارتفاع سابق)\nمثال: النهاية المخيبة لمهنة رائعة",
 "龍騎兵": "فارِس (اسم فاعل لفَرَسَ؛ راكب الفَرَس أو الحِصَان)\nمثال: فارس الظلام فيلم جيد.",
 "龍騎士": "فارِس (اسم فاعل لفَرَسَ؛ راكب الفَرَس أو الحِصَان)\nمثال: فارس الظلام فيلم جيد.",
 "龍骨": "صَالِب",
 "龕": "ركن, مقصورة (تجويف صغير يفتح على غرفة أكبر)",
 "龜の手": "بَرْنَقِيل",
 "龜鑑": "نُمُوذَج, نَمَط",
 "𠮟りつける": "تَأْنِيب, تَوْبِيخ (فعل أو تعبير عن النقد واللوم)\nمثال: اضطر لتلقي التوبيخ بابتسامة على وجهه",
 "𠮟り付ける": "تَأْنِيب, تَوْبِيخ (فعل أو تعبير عن النقد واللوم)\nمثال: اضطر لتلقي التوبيخ بابتسامة على وجهه",
 "𠮟り飛ばす": "وَبَّخَ (التأنيب بشدة)",
 "𠮟る": "اِمْرَأَة سَلِيطَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ) / وَبَّخَ (التأنيب بشدة)\nمثال: أنا امرأة قوية.",
 "𠮟咤": "تَعْنِيف, تَقْرِيع (توبيخ شخص ما بقسوة)",
 "𠮟正": "تَصْحِيح",
 "𠮟責": "عَزْر / توبيخ ;تقريع",
 "𡱖": "أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية)",
 "𣠽": "مَقْبَض",
 "𧐐": "ذبابة الحجر (حشرة مجنحة بدائية بجسم مسطح؛ تستخدم كطعم من قبل الصيادين؛ اليرقات المائية ذات الخياشيم لاحمة وتعيش تحت الحجارة)",
 "𨫤押し坑道": "نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم) / مرمى, مغزى (المعنى العام أو الفحوى السائد) / اتجاه, تيار (ميل عام للتغيير (كما في الرأي)) / رُكَام (كتلة كبيرة من المواد المتراكمة بفعل الرياح أو التيارات المائية)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني",
 "𨫤石": "غَثّ, شَوْب (الحيوان والإنسان: عجف وهزل، ضد سمن؛ غَثَّت الشاة، ق)",
 "𬵪": "إِسْقُمَرِيّ / مَاكْرِيل",
 "𰻞𰻞麺": "معكرونة بيانجبيانج",
 "﨑": "رَأْس (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ)\nمثال: قطع سامي رأس كلب.",
 "﨟纈染": "باتيك",
 "﨟纈染め": "باتيك",
 "＆": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "＋α": "وأكثر من ذلك (وأكثر بكثير بالإضافة إلى ذلك)\nمثال: كلفني راتب أسبوع وأكثر من ذلك",
 "０": "صِفْر, ٠ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / مثال: بدأ سامي من نقطة الصفر. / صِفْر, ٠ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / مثال: بدأ سامي من نقطة الصفر. / لَا شَيْء (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "０時": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "０番目": "صِفْرِيّ",
 "０空間": "فضاء صفري, فضاء فارغ (فضاء لا يحتوي على نقاط؛ وفضاء فارغ)",
 "０距離": "تقارب شديد, مكان ضيق (حالة التواجد بشكل قريب جداً وغير مريح من شخص أو شيء ما)",
 "０距離射撃": "بشكل مباشر, بصراحة تامة (بطريقة مباشرة ولا لبس فيها) / مِنْ مَسَافَةٍ قَرِيبَة (قَرِيب بِمَا يَكْفِي لِلإِصَابَة المُبَاشِرَة لِلهَدَف) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)\nمثال: سألته بصراحة تامة عما إذا كان يريد الوظيفة",
 "１": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة. / وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة. / أَفْضَل / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "１から": "من الصفر (من البداية، خاصة دون الاعتماد على موارد أو مزايا أخرى)\nمثال: خبز الكعكة من الصفر",
 "１こま": "جولة, طلقة (شحنة ذخيرة لطلقة واحدة)",
 "１つ": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة. / وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي. / مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس. / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "１つがい": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "１つ目": "أَعْوَر, عَوْرَاء / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة.",
 "１つ１つ": "بشكل فردي, على حدة (بمعزل عن الآخرين)\nمثال: إذا أخذناها بشكل فردي، الغرف كانت مربعة",
 "１つ２つ": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "１コマ": "جولة, طلقة (شحنة ذخيرة لطلقة واحدة)",
 "１ミリ": "بُوصَة, شِبْر",
 "１丁目１番地": "بَادِئَ ذِي بَدْءٍ",
 "１万": "عَشَرَة آلَاف",
 "１世紀": "قَرْن, عَصْر (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "１人": "لوحد / لحال / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "１人あたり": "لِلْفَرْد الوَاحِد (لكل شخص على حدة) / للفرد الواحد, للنسمة (لكل شخص؛ لكل فرد)\nمثال: ننفق 5000 دولار للفرد الواحد سنوياً للتعليم في هذه المنطقة",
 "１人で": "وَحِيد, مُنْفَرِد",
 "１人当たり": "لِلْفَرْد الوَاحِد (لكل شخص على حدة) / للفرد الواحد, للنسمة (لكل شخص؛ لكل فرد)\nمثال: ننفق 5000 دولار للفرد الواحد سنوياً للتعليم في هذه المنطقة",
 "１人残らず": "كُلّ, جَمِيع",
 "１人１人": "كُلّ",
 "１佐": "عَقِيد, زَعِيم",
 "１個": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "１個あたり": "كُلّ",
 "１個当たり": "كُلّ",
 "１個当り": "كُلّ",
 "１億": "مئة مليون",
 "１分": "جُزْء مِن مِائَة, وَاحِد بِالْمِائَة (جزء واحد من مائة جزء متساوي)",
 "１切れ": "شريحة / قَطَّعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "１列": "صَفّ (سَطْر مستقيم؛ مستوى تعليمي) / جَدَّفَ (معنى الفعل في سياقات متعددة تتراوح بين الطيران والسير، وحتى في الدلالات المجازية كالرمي والقطع؛ الفعل له معانٍ متعددة: رمي (كالسماء بالبرد)، الإسراع في المشي، كفر بالنعم وعدم الرضا بها، ودفع السفينة بالمجاديف) / تَجْدِيف\nمثال: صف كليتي وقلبي‎.",
 "１割": "عُشْر (جزء من عشرة؛ جزء واحد من عشرة أجزاء متساوية)",
 "１匹": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "１千": "أَلْف (يَدُلُّ عَلَى العَدَد 1000) / أَلْف (العدد الأصلي الذي هو حاصل ضرب 10 في 100)",
 "１号": "الذات, النفس (إشارة إلى النفس أو الذات؛ عبارة 'الاهتمام برقم واحد' تعني وضع مصالح المرء الشخصية أولاً) / الأول, رقم واحد (العنصر الأول في سلسلة قابلة للعد) / الأول, رقم واحد (الأول أو الأعلى في ترتيب أو سلسلة)\nمثال: الأول من الشهر",
 "１号園児": "طفل ما قبل المدرسة (طفل يرتاد حضانة أو روضة أطفال)",
 "１回": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "１回生": "فِي السَّنَةِ الأُولَى, مُسْتَجِدّ (يُوصَفُ بِهِ الشَّخْصُ فِي سَنَتِهِ الأُولَى مِنْ تَجْرِبَةٍ (خَاصَّةً فِي المَدْرَسَةِ أَوِ الجَامِعَةِ))",
 "１型糖尿病": "السكري المعتمد على الأنسولين, السكري من النوع الأول (داء سكري شديد يظهر مبكرًا؛ يتميز بكثرة التبول والعطش الشديد وزيادة الشهية وفقدان الوزن والحماض الكيتوني العرضي؛ يتطلب النظام الغذائي وحقن الأنسولين…)",
 "１塁": "قاعدة أولى, مرحلة أولى (المرحلة الأولية في إنجاز شيء ما) / القاعدة الأولى (مركز اللعب للاعب في فريق البيسبول المتمركز عند القاعدة الأولى في الملعب الداخلي) / القاعدة الأولى (القاعدة التي يجب أن يلمسها عداء القاعدة أولاً في البيسبول)\nمثال: لم نصل إلى المرحلة الأولى بهذا النهج / لاعب القاعدة الأولى ((بيسبول) رجل يلعب في القاعدة الأولى)",
 "１士": "جُنْدِيّ أَوَّل (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي.",
 "１対１": "وَاحِدٌ لِوَاحِد (يصف علاقة يرتبط فيها كل عنصر من مجموعة بعنصر واحد من مجموعة ثانية)",
 "１対１の通信": "وَاحِدٌ لِوَاحِد (يصف علاقة يرتبط فيها كل عنصر من مجموعة بعنصر واحد من مجموعة ثانية)",
 "１尉": "طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَقِيب, قُبْطَان / قَائِد, كَبْتِن\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "１年生": "فِي السَّنَةِ الأُولَى, مُسْتَجِدّ (يُوصَفُ بِهِ الشَّخْصُ فِي سَنَتِهِ الأُولَى مِنْ تَجْرِبَةٍ (خَاصَّةً فِي المَدْرَسَةِ أَوِ الجَامِعَةِ)) / مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ. / سَنَوِيّ",
 "１度": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟ / مُؤَقَّتًا",
 "１度も": "يَوْمًا",
 "１才": "بِعُمُر سَنَة وَاحِدَة (في عامه الأوّل من العمر)",
 "１打": "سكتة دِمَاغِيَّة / لَاطَفَ / مَلَّسَ",
 "１撃": "تزرير, صفيحة عزل (صفيحة معدنية مشكلة ومثبتة على سطح لتقويته وحمايته من العوامل الجوية) / بريق, ومضة (تجربة حية قصيرة)\nمثال: اجتاحته ومضة من المشاعر",
 "１日": "مَرَّةً, يَوْمًا (مؤنث مُرّ، صفة ما كان بها مرارة) / فِي يَوْمٍ مِنَ ٱلْأَيَّامِ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: كم من مرة ذهبت؟ / طُول اَلْيَوْم, طُول اَلنَّهَار (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "１日中": "طِوَال اليَوْم, نَهَارًا (خلال اليوم بأكمله)\nمثال: الضوء يتدفق طوال اليوم في الغرفة",
 "１時": "اَلسَّاعَة اَلْوَاحِدَة / مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟ / لبرهة, لفترة وجيزة (لفترة قصيرة)\nمثال: اجلس وابقى لبرهة / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "１曹": "رقيب أول, مساعد (ضابط صف كبير في الجيش أو المارينز)",
 "１月": "يَنَايِر, كَانُون اَلثَّانِي (الشهر الأول من السنة الروميّة)\nمثال: لتبدأ الاحتفالات بيناير.",
 "１服": "زفر, نفخ (زفير قوي عن طريق الأنف أو الفم) / سحبة, شفطة (استنشاق بطيء (كما في دخان التبغ)) / مُكَوَّر, مُنْتَفِخ (مجموع بحيث يبرز بامتلاء) / بف, مقعد عثماني (وسادة سميكة تستخدم كمقعد)\nمثال: أعطى أنفه نفخة قوية / رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / ركود, هدوء مؤقت (فترة من الطقس الهادئ) / فترة هدوء, هوداة (توقف تكون فيه الأمور هادئة أو الأنشطة متناقصة)\nمثال: كان هناك هدوء مؤقت في العاصفة",
 "１本": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ / غَيْشَا / أُحَادِيُّ الْهَدَفِ, مُصَمِّمٌ (مُصَمِّم ومُنصَبّ على هدف واحد)",
 "１杯": "كوب, ملء كوب (الكمية التي يستوعبها كوب)\nمثال: شرب كوباً من القهوة / مُمْتَلِئ, مَلِيء / شِبَع, شبعان / بالكامل, تماماً (إلى أقصى درجة أو مدى؛ بشكل كامل أو كلي) / بشكل واف, تماماً (بشكل كاف؛ أكثر من ملائم) / بالكامل (في إشارة إلى كمية)\nمثال: نمى بالكامل / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "１枚": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "１次": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / أَوَّلِيّ / تَنَاظُرِيّ, خَطِّيّ (لدائرة أو جهاز له مخرج يتناسب مع المدخل) / أحادي البعد, خطي (من أو في أو على طول أو يتعلق بخط؛ ينطوي على أو له بعد واحد) / خطي (يصف أو يتضمن معادلة تكون حدودها من الدرجة الأولى) / خَطِّيّ, طُولِيّ (يُقاس في اتِّجاه الطُّول)\nمثال: جهاز تناظري",
 "１次コイル": "ملف ابتدائي (ملف يشكل جزءاً من دائرة كهربائية بحيث يؤدي تغيير التيار فيه إلى حث تيار في دائرة مجاورة)\nمثال: التيار عبر الملف الابتدائي يحث تياراً في الملف الثانوي",
 "１歩": "خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة\nمثال: もう一歩も歩けないよ。 — لا يمكنني المشي خطوة أخرى. / مُسْتَوًى / مَرْحَلَة",
 "１歩１歩": "خُطْوَةً خُطْوَةً, خُطْوَةً بِخُطْوَةٍ",
 "１歳": "بِعُمُر سَنَة وَاحِدَة (في عامه الأوّل من العمر)",
 "１番": "الذات, النفس (إشارة إلى النفس أو الذات؛ عبارة 'الاهتمام برقم واحد' تعني وضع مصالح المرء الشخصية أولاً) / الأول, رقم واحد (العنصر الأول في سلسلة قابلة للعد) / الأول, رقم واحد (الأول أو الأعلى في ترتيب أو سلسلة)\nمثال: الأول من الشهر / أَفْضَل / لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / لَعْب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / طَرِيدَة\nمثال: لعب زيري التنس. / أُغْنِيَّة, أُغْنِيَة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر) / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: أنا أغني أغنية.",
 "１番手": "مُتَكَلِّم",
 "１番目": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة.",
 "１発": "جولة, طلقة (شحنة ذخيرة لطلقة واحدة) / إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه) / ركضة كاملة, هوم ران (ضربة تتيح للضارب الدوران حول القواعد وتسجيل نقطة (ركضة))\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "１等": "بالدرجة الأولى (بواسطة وسائل نقل من الدرجة الأولى؛ مع إقامة من الدرجة الأولى) / درجة أولى (أغلى أماكن الإقامة على متن سفينة أو قطار أو طائرة) / درجة أولى (أعلى رتبة في التصنيف) / بريد الدرجة الأولى (بريد يشمل الرسائل والبطاقات البريدية والطرود المختومة ضد التفتيش)\nمثال: نسافر دائماً بالدرجة الأولى / أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "１等兵": "جُنْدِيّ أَوَّل (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي.",
 "１等国": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "１等空佐": "عَقِيد, زَعِيم",
 "１等空曹": "رقيب أول, مساعد (ضابط صف كبير في الجيش أو المارينز)",
 "１等賞": "ميدالية ذهبية (كأس مصنوعة من الذهب (أو لها مظهر الذهب) تمنح عادة للفائز بالمركز الأول في المسابقة)",
 "１等車": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "１等陸佐": "عَقِيد, زَعِيم",
 "１等陸士": "جُنْدِيّ أَوَّل (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي.",
 "１等陸曹": "رقيب أول, مساعد (ضابط صف كبير في الجيش أو المارينز)",
 "１羽": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "１行": "خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "１足": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "１銭": "جُزْء مِن مِائَة, وَاحِد بِالْمِائَة (جزء واحد من مائة جزء متساوي)",
 "１錠": "صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: هذه شركة صينية.",
 "１限": "شوط أول, فترة أولى (القسم الأول الذي ينقسم إليه لعب المباراة)",
 "１限目": "شوط أول, فترة أولى (القسم الأول الذي ينقسم إليه لعب المباراة)",
 "１階": "الدور الأرضي, الطابق الأرضي (طابق المبنى الذي يكون عند مستوى الأرض المحيطة بالمبنى أو الأقرب إليه)",
 "１頭": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "１０": "عَشَرَة, عَشْرَة",
 "１０万": "مِائَة أَلْف",
 "１０代": "الأَعْدَاد بَيْن الثَّالِثَة عَشْرَة والتَّاسِعَة عَشْرَة / سن المراهقة (الفترة العمرية بين 13 و 19 سنة)",
 "１０分の１": "عَاشِر / عُشْر (الثَلَاثُ العُشَر: الليلة العاشرة والحادية عشر والثانية عشر من كل شهر قمري…)\nمثال: لدي عشرة أقلام.",
 "１０割": "كُلّ شَيْء",
 "１０時": "اَلسَّاعَة اَلْعَاشِرَة",
 "１０月": "أَكْتُوبَر, تِشْرِين الْأَوَّل (الشهر العاشر في السنة الميلادية الروميّة)\nمثال: أراك في شهر أكتوبر.",
 "１０進": "عَشْرِيّ",
 "１０進小数": "كَسْر عَشْرِيّ (كسر حقيقي مقامه قوة للعدد 10)",
 "１０進小数点": "فَاصِل عَشْرِيّ",
 "１０進数": "عَشْرِيّ",
 "１０進法": "النظام العشري, نظام العد العشري (نظام عد موضعي يستخدم أرقاماً عشرية وأساساً هو العشرة)",
 "１００": "مِٱئَة, مِئَة",
 "１００パー": "تَمَامًا",
 "１００万": "مِلْيُون, ١٠٠٠٠٠٠ / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "１００倍": "مائة ضعف (بمعامل مائة)\nمثال: زادت أموالهم مائة ضعف",
 "１００点満点": "كَمَال, إتقان",
 "１０００": "أَلْف (يَدُلُّ عَلَى العَدَد 1000) / أَلْف (العدد الأصلي الذي هو حاصل ضرب 10 في 100)",
 "１００００": "عَشَرَة آلَاف",
 "１０００００": "مِائَة أَلْف",
 "１００００００": "مِلْيُون, ١٠٠٠٠٠٠ / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "１１": "أَحَد عَشَر, إِحْدَى عَشْرَةَ (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد. / مِشْوَال, رَافِعَة / حِمَار (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة)\nمثال: هن بحاجة لحمار.",
 "１１時": "السَاعَة الحَادِيَة عَشَرَة",
 "１１月": "نُوفِمْبِر, نُوفَمْبِر (الشهر الحادي عشر في السنة الميلادية)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "１１０番": "مِئَة وَعَشَرَة (يَدُلُّ عَلَى العَدَد 110) / أُطْلُب الشُّرْطَة, نَاد الشُّرْطَة",
 "１２": "اِثْنَا عَشَرَ / مَلِكَة, ملكة (مؤنث مَلِك) / وَزِير, فرزان / تفرزن\nمثال: ليحفظ الله الملكة.",
 "１２時": "ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "１２月": "دِيسِمْبِر, دِيسَمْبِر (الشهر الثاني عشر في السنة الروميّة)\nمثال: أنا في إضراب من 8 إلى 12 ديسمبر.",
 "１２０パーセント": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ",
 "１２０％": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ",
 "１３": "ثَلَاثَةَ عَشَرَ (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب. / مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "１３月": "يَنَايِر, كَانُون اَلثَّانِي (الشهر الأول من السنة الروميّة)\nمثال: لتبدأ الاحتفالات بيناير.",
 "１４": "أَرْبَعَةَ عَشَرَ (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "１５": "خَمْسَةَ عَشَرَ (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال.",
 "１６": "سِتَّةَ عَشَرَ",
 "１６進": "ست عشري (مكون من أو متعلق بنظام عددي أساسه 16)",
 "１６進法": "ست عشري (مكون من أو متعلق بنظام عددي أساسه 16)",
 "１７": "سَبْعَةَ عَشَرَ",
 "１８": "ثَمَانِيَةَ عَشَرَ",
 "１８０度": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "１９": "تِسْعَةَ عَشَرَ",
 "１９日": "مُغَفَّل, أَحْمَق",
 "１Ｒ": "شقة استديو (شقة بمساحة معيشة وحمام ومطبخ صغير)",
 "１ｍｍ": "بُوصَة, شِبْر",
 "２": "اِثْنَانِ, اِثْنَتَانِ (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)\nمثال: واحد زائد اثنان يساوي ثلاثة.",
 "２か国語": "ثُنَائِي اَللُّغَة",
 "２か年": "ثنائي الحول, سنتوي (له دورة حياة تستمر لموسمين) / كُلَّ سَنَتَيْنِ (يحدث كل سنتين) / نبات ثنائي الحول ((علم النبات) نبات تستغرق دورة حياته عادة موسمين من الإنبات حتى الموت؛ عادة ما تزهر وتثمر النباتات ثنائية الحول في الموسم الثاني)\nمثال: دورة حياة ثنائية الحول",
 "２つ": "اِثْنَانِ, اِثْنَتَانِ (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)\nمثال: واحد زائد اثنان يساوي ثلاثة.",
 "２つとも": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "２つ目": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "２ウェイ": "ذُو اِتِّجَاهَيْن (يعمل أو يسمح بالعمل في أي من اتجاهين متعاكسين) / ثُنَائِيّ, مِن جُزْأَيْن (يتضمن جزأين أو عنصرين) / ثُنَائِيُّ الحِزْبِيَّة (مَدْعُومٌ مِنْ كِلَا الجَانِبَيْن)",
 "２ウエイ": "ذُو اِتِّجَاهَيْن (يعمل أو يسمح بالعمل في أي من اتجاهين متعاكسين) / ثُنَائِيّ, مِن جُزْأَيْن (يتضمن جزأين أو عنصرين) / ثُنَائِيُّ الحِزْبِيَّة (مَدْعُومٌ مِنْ كِلَا الجَانِبَيْن)",
 "２カ国語": "ثُنَائِي اَللُّغَة",
 "２カ年": "ثنائي الحول, سنتوي (له دورة حياة تستمر لموسمين) / كُلَّ سَنَتَيْنِ (يحدث كل سنتين) / نبات ثنائي الحول ((علم النبات) نبات تستغرق دورة حياته عادة موسمين من الإنبات حتى الموت؛ عادة ما تزهر وتثمر النباتات ثنائية الحول في الموسم الثاني)\nمثال: دورة حياة ثنائية الحول",
 "２ケ年": "ثنائي الحول, سنتوي (له دورة حياة تستمر لموسمين) / كُلَّ سَنَتَيْنِ (يحدث كل سنتين) / نبات ثنائي الحول ((علم النبات) نبات تستغرق دورة حياته عادة موسمين من الإنبات حتى الموت؛ عادة ما تزهر وتثمر النباتات ثنائية الحول في الموسم الثاني)\nمثال: دورة حياة ثنائية الحول",
 "２ルート化": "تكرار زائد, حشو (تكرار فعل ما بلا حاجة) / زيادة, فائض (سمة كون الشيء زائداً وغير مطلوب) / تكرار احتياطي ((إلكترونيات) تصميم نظام يكرر المكونات لتوفير بدائل في حالة فشل أحد المكونات) / تكرار زائد, حشو (تكرار الرسائل لتقليل احتمالية الأخطاء في الإرسال)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة",
 "２ヵ国語": "ثُنَائِي اَللُّغَة",
 "２ヵ年": "ثنائي الحول, سنتوي (له دورة حياة تستمر لموسمين) / كُلَّ سَنَتَيْنِ (يحدث كل سنتين) / نبات ثنائي الحول ((علم النبات) نبات تستغرق دورة حياته عادة موسمين من الإنبات حتى الموت؛ عادة ما تزهر وتثمر النباتات ثنائية الحول في الموسم الثاني)\nمثال: دورة حياة ثنائية الحول",
 "２ヶ国語": "ثُنَائِي اَللُّغَة",
 "２ヶ年": "ثنائي الحول, سنتوي (له دورة حياة تستمر لموسمين) / كُلَّ سَنَتَيْنِ (يحدث كل سنتين) / نبات ثنائي الحول ((علم النبات) نبات تستغرق دورة حياته عادة موسمين من الإنبات حتى الموت؛ عادة ما تزهر وتثمر النباتات ثنائية الحول في الموسم الثاني)\nمثال: دورة حياة ثنائية الحول",
 "２世": "نيسي (شخص ولد في الولايات المتحدة لأبوين هاجرا من اليابان) / ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية. / اِبْن (الولد الذكر)\nمثال: هو له ابن صغير.",
 "２乗": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "２人": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "２人して": "مَعًا, سَوِيًّا",
 "２人とも": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "２人共": "كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما",
 "２人組": "ثنائي, زوجان (زوج من الأشخاص يرتبطون ببعضهم البعض) / ثُنَائِيّ, زَوْج (عنصران من نفس النوع)\nمثال: الخطيبان",
 "２人部屋": "غُرْفَة مُزْدَوِجَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "２佐": "مقدّم (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه)\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "２倍": "ثُنَائِيّ / ضِعْف\nمثال: 社長は私の歳の２倍です。 — رئيسي في العمل يكبرني عمراً بمرتين.",
 "２周目": "تَنَاسُخُ الأَرْوَاحِ",
 "２回": "مَرَّتَيْن, مرتين",
 "２回生": "طالب سنة ثانية (طالب جامعي في السنة الثانية)",
 "２国間": "ثُنَائِيّ",
 "２型糖尿病": "السكري غير المعتمد على الأنسولين, السكري من النوع الثاني (شكل خفيف من داء السكري يتطور تدريجيًا لدى البالغين؛ يمكن أن يحدث بسبب السمنة أو الإجهاد الشديد أو انقطاع الطمث أو عوامل أخرى؛ يمكن السيطرة عليه عادة…)",
 "２塁": "القاعدة الثانية (مركز اللعب للاعب في فريق البيسبول المتمركز بالقرب من القاعدة الثانية في الملعب الداخلي) / القاعدة الثانية (القاعدة التي يجب أن يلمسها العداء ثانياً في لعبة البيسبول)",
 "２士": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك.",
 "２大政党制": "ثُنَائِيُّ الحِزْبِيَّة (مَدْعُومٌ مِنْ كِلَا الجَانِبَيْن)",
 "２尉": "ملازم أوّل (مَن يُلازم الشيء أو المكان فيدوم فيه ولا يفارقه؛ في : المُلازِم رتبة في الجيش هي أدنى رتبة للظُبَّاط ودونه ما يعرفون بنُوَّاب الظباط أو ظُباط الصَفّ)",
 "２年生": "فِي السَّنَةِ الثَّانِيَة (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الثَّانِيَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ أَوِ الجَامِعَةِ الأَمْرِيكِيَّةِ) / ثنائي الحول, سنتوي (له دورة حياة تستمر لموسمين) / كُلَّ سَنَتَيْنِ (يحدث كل سنتين) / نبات ثنائي الحول ((علم النبات) نبات تستغرق دورة حياته عادة موسمين من الإنبات حتى الموت؛ عادة ما تزهر وتثمر النباتات ثنائية الحول في الموسم الثاني)\nمثال: دورة حياة ثنائية الحول",
 "２度": "الضعف, مرتين (بمعامل اثنين)\nمثال: زاد السعر الضعف في العام الماضي",
 "２度と": "أبداً, ليس بعد الآن (في أي وقت فيما بعد)\nمثال: قال الغراب: أبداً!",
 "２才": "بِعُمُر سَنَتَيْن (في عامه الثاني من العمر)",
 "２時": "اَلسَّاعَة اَلثَّانِيَة",
 "２曹": "رقيب أول (رقيب في الجيش أعلى من رقيب أركان وأقل من مساعد)",
 "２月": "فِبْرَايِر, شُبَاط (الشهر الثاني في السنة الميلادية الروميّة)\nمثال: سأكون قد درست الإنجليزية لخمس سنوات مع حلول فبراير المقبل.",
 "２本": "اِثْنَانِ, اِثْنَتَانِ (في اِثْنان هو رقم مرتبته بين الواحد والثلاثة)\nمثال: واحد زائد اثنان يساوي ثلاثة.",
 "２本立て映画": "مباراتان متتاليتان (مباراتان بدلاً من واحدة (خاصة في البيسبول حين يلعب نفس الفريقين مباراتين في نفس اليوم))",
 "２次": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية. / ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة الأُُولى)\nمثال: ثانوية زيري ضخمة. / تربيعي (ينطوي على القوة الثانية ولا توجد قوة أعلى للكمية أو الدرجة) / كَثِيرَة حُدُود مِن الدَّرَجَة الثَّانِيَة, مُعَادَلَة تَرْبِيعِيَّة (كثيرة حدود من الدرجة الثانية) / معادلة تربيعية (معادلة تكون فيها أعلى قوة للكمية المجهولة هي المربع)\nمثال: معادلة تربيعية / خَيَالِيّ, مُتَخَيَّل",
 "２次元": "خَيَالِيّ, مُتَخَيَّل",
 "２歳": "بِعُمُر سَنَتَيْن (في عامه الثاني من العمر)",
 "２段階認証": "مُصَادَقَة ثُنَائِيَّة (إِخْلاَصٌ فِي الصَّدَاقَةِ؛ الإقرار والموافقة على الشيء)",
 "２液": "ثُنَائِيّ, مِن جُزْأَيْن (يتضمن جزأين أو عنصرين)",
 "２番": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "２番目": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "２百": "مِئَتَان (يَدُلُّ عَلَى العَدَد 200)",
 "２等": "بالدرجة الثانية (بواسطة وسائل نقل الدرجة الثانية) / درجة ثانية, درجة سياحية (فئة من أماكن الإقامة على متن سفينة أو قطار أو طائرة أقل تكلفة من أماكن الدرجة الأولى) / درجة ثانية (ليس أعلى جودة في التصنيف) / درجة ثانية (ليست أعلى رتبة في التصنيف)\nمثال: سافرنا بالدرجة الثانية",
 "２等兵": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك.",
 "２等分": "تنصيف (التقسيم إلى جزأين متساويين)",
 "２等分線": "مُنَصِّف, مُقَسِّم",
 "２等海佐": "آمِر, مُقَدَّم",
 "２等空曹": "رقيب فني (ضابط صف رتبته أقل من رقيب أول في القوات الجوية أو المارينز)",
 "２等軍曹": "رقيب أركان (ضابط صف رتبته أعلى من عريف وأقل من رقيب أول في الجيش أو المارينز)",
 "２等辺３角形": "مثلث متساوي الساقين (مثلث له ضلعان متساويان)",
 "２等陸佐": "مقدّم (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه)\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "２等陸士": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك.",
 "２等陸尉": "ملازم أوّل (مَن يُلازم الشيء أو المكان فيدوم فيه ولا يفارقه؛ في : المُلازِم رتبة في الجيش هي أدنى رتبة للظُبَّاط ودونه ما يعرفون بنُوَّاب الظباط أو ظُباط الصَفّ)",
 "２等陸曹": "رقيب أول (رقيب في الجيش أعلى من رقيب أركان وأقل من مساعد)",
 "２箇国語": "ثُنَائِي اَللُّغَة",
 "２箇年": "ثنائي الحول, سنتوي (له دورة حياة تستمر لموسمين) / كُلَّ سَنَتَيْنِ (يحدث كل سنتين) / نبات ثنائي الحول ((علم النبات) نبات تستغرق دورة حياته عادة موسمين من الإنبات حتى الموت؛ عادة ما تزهر وتثمر النباتات ثنائية الحول في الموسم الثاني)\nمثال: دورة حياة ثنائية الحول",
 "２組": "ثُنَائِيّ / ضِعْف",
 "２要素認証": "مُصَادَقَة ثُنَائِيَّة (إِخْلاَصٌ فِي الصَّدَاقَةِ؛ الإقرار والموافقة على الشيء)",
 "２週間": "أسبوعان, نصف شهر (فترة أربعة عشر يوماً متتالياً)",
 "２進数": "بِت, رَقَم ثُنَائِيّ (إما 0 أو 1 في التدوين الثنائي)",
 "２進数字": "بِت, رَقَم ثُنَائِيّ (إما 0 أو 1 في التدوين الثنائي)",
 "２進法": "النظام الثنائي, نظام العد الثنائي (نظام عد موضعي يستخدم أرقاماً ثنائية وأساساً هو الاثنان)",
 "２進演算": "عملية ثنائية, عملية منطقية (عملية تتبع قواعد الجبر البولياني؛ يأخذ كل معامل والنتيجة إحدى قيمتين)",
 "２重": "ثُنَائِيّ / ضِعْف / ذُو حَدَّيْن (قابل للتفسير بطريقتين عادة متناقضتين)",
 "２階": "أعلى الدرج, في الطابق العلوي (في طابق أعلى) / عقلياً, في الرأس (فيما يتعلق بالعقل) / علوي (طابق) (في أو من الطوابق العليا لمبنى) / طابق علوي (جزء المبنى الذي يقع فوق الطابق الأرضي)\nمثال: عاشوا في الطابق العلوي",
 "２項式": "ثُنَائِيّ الاِسْم, ذُو اسْمَيْن (يحمل اسمين أو يتّسم بهما، خاصّةً اسمَي الجنس والنوع في التصنيف الأحيائيّ) / ثنائي الحد, حداني (من أو متعلق أو مكون من حدين) / حدانية, ذو حدين ((رياضيات) كمية معبر عنها كمجموع أو فرق لحدين؛ متعدد حدود بحدين)\nمثال: تعبير ثنائي الحد",
 "２０": "عِشْرُونَ",
 "２０世紀": "القرن العشرون (القرن من 1901 إلى 2000)",
 "２０代": "عِشْرُونَ (يَدُلُّ عَلَى العَدَد 20) / عِشْرُون (العدد الأصلي الذي هو مجموع تسعة عشر وواحد)",
 "２０年代": "العشرينات (الفترة من العمر بين 20 و 30) / العشرينات (1920), عقد 1920 (العقد من 1920 إلى 1929)",
 "２００": "مِئَتَان (يَدُلُّ عَلَى العَدَد 200)",
 "２０００年問題対応": "مُتَوَافِق مَعَ عَام أَلْفَيْن (مُهيَّأ لمعالجة بيانات التاريخ والوقت بدقّة بين القرنين العشرين والحادي والعشرين وعبرهما)",
 "２０００年対応": "مُتَوَافِق مَعَ عَام أَلْفَيْن (مُهيَّأ لمعالجة بيانات التاريخ والوقت بدقّة بين القرنين العشرين والحادي والعشرين وعبرهما)",
 "２１か条の要求": "وَاحِد وَعِشْرُون (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة.",
 "２１カ条の要求": "وَاحِد وَعِشْرُون (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة.",
 "２４時": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "２４時間": "أربع وعشرون ساعة, يوم (الوقت الذي تستغرقه الأرض للقيام بدورة كاملة حول محورها)\nمثال: غادروا بعد يومين",
 "２５": "خَمْسَة وَعِشْرُونَ (يَدُلُّ عَلَى العَدَد 25) / خَمْسَة وَعِشْرُون (العدد الأصلي الذي هو مجموع أربعة وعشرين وواحد)",
 "２６": "سِتَّة وَعِشْرُونَ (يَدُلُّ عَلَى العَدَد 26) / سِتَّة وَعِشْرُون (العدد الأصلي الذي هو مجموع خمسة وعشرين وواحد)",
 "２７": "سَبْعَة وَعِشْرُونَ (يَدُلُّ عَلَى العَدَد 27) / سَبْعَة وَعِشْرُون (العدد الأصلي الذي هو مجموع ستة وعشرين وواحد)",
 "２８": "ثَمَانِيَة وَعِشْرُونَ (يَدُلُّ عَلَى العَدَد 28) / ثَمَانِيَة وَعِشْرُون (العدد الأصلي الذي هو مجموع سبعة وعشرين وواحد)",
 "２９": "تِسْعَة وَعِشْرُونَ (يَدُلُّ عَلَى العَدَد 29) / تِسْعَة وَعِشْرُون (العدد الأصلي الذي هو مجموع ثمانية وعشرين وواحد)",
 "２Ｄ": "ثَانٍ (العَدَد التَّرْتِيبِيّ 2)",
 "２ＦＡ": "مُصَادَقَة ثُنَائِيَّة (إِخْلاَصٌ فِي الصَّدَاقَةِ؛ الإقرار والموافقة على الشيء)",
 "２ＷＡＹ": "ذُو اِتِّجَاهَيْن (يعمل أو يسمح بالعمل في أي من اتجاهين متعاكسين) / ثُنَائِيّ, مِن جُزْأَيْن (يتضمن جزأين أو عنصرين) / ثُنَائِيُّ الحِزْبِيَّة (مَدْعُومٌ مِنْ كِلَا الجَانِبَيْن)",
 "３": "ثَلَاثَة, ثَلَاث (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "３か年": "كُلَّ ثَلَاثِ سَنَوَاتٍ (يحدث كل ثلاث سنوات أو يستمر ثلاث سنوات) / مئوية ثالثة (الذكرى 300 (أو الاحتفال بها))",
 "３つ": "ثَلَاثَة, ثَلَاث (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "３つ星": "نِطَاق الجَبَّار (الحزام المصنوع من القماش ليس له إبزيم ولا ما أشبه؛ قطعة من القماش تُلفّ على وسط الإنسان. الجمع نُطُق؛ في : هو جزء الدائرة كسطح (ليس قوس)؛ يقال أيضا قطاع. الجمع نطاقات)\nمثال: هل تمثل الزراعة على نطاق واسع النظام البيئي في الجزائر؟",
 "３ウェイ": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "３カードモンテ": "ثري كارد مونتي, مونتي (لعبة ورق قمار من أصل إسباني؛ يتم توزيع 3 أوراق مكشوفة ويراهن اللاعبون على أن إحداها ستطابق قبل الأخريات أثناء توزيع الأوراق من الحزمة واحدة تلو الأخرى)",
 "３カ年": "كُلَّ ثَلَاثِ سَنَوَاتٍ (يحدث كل ثلاث سنوات أو يستمر ثلاث سنوات) / مئوية ثالثة (الذكرى 300 (أو الاحتفال بها))",
 "３ケ年": "كُلَّ ثَلَاثِ سَنَوَاتٍ (يحدث كل ثلاث سنوات أو يستمر ثلاث سنوات) / مئوية ثالثة (الذكرى 300 (أو الاحتفال بها))",
 "３ヵ年": "كُلَّ ثَلَاثِ سَنَوَاتٍ (يحدث كل ثلاث سنوات أو يستمر ثلاث سنوات) / مئوية ثالثة (الذكرى 300 (أو الاحتفال بها))",
 "３ヶ年": "كُلَّ ثَلَاثِ سَنَوَاتٍ (يحدث كل ثلاث سنوات أو يستمر ثلاث سنوات) / مئوية ثالثة (الذكرى 300 (أو الاحتفال بها))",
 "３人婚": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "３人組": "تريو, ثلاثي (تأليف موسيقي لثلاثة مؤديين) / ثالثة, ثلاثي (ثلاثة أشخاص يُنظر إليهم كوحدة واحدة) / ثلاثي (مجموعة من ثلاثة أشياء متشابهة تُعتبر كوحدة واحدة) / ثلاثي (ثلاثة مؤدين أو مغنين يؤدون معاً)",
 "３佐": "رَائِد",
 "３倍": "ثلاثة أضعاف (بمعامل ثلاثة)\nمثال: زاد إيجارنا ثلاثة أضعاف في السنوات الخمس الماضية",
 "３千": "ثَلَاثَة آلَاف (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "３回": "ثلاثة أضعاف (بمعامل ثلاثة)\nمثال: زاد إيجارنا ثلاثة أضعاف في السنوات الخمس الماضية",
 "３回生": "لِلشَّبَاب, لِلنَّاشِئَة (يشمل الأشخاص اليافعين أو مُعَدّ لهم) / أدنى رتبة, أصغر سناً (أصغر سنًا؛ أدنى رتبة؛ أقصر في مدة الولاية أو الخدمة) / الأَصْغَر, الاِبْن (يُستخدم للأصغر سنًّا من شخصين يحملان الاسم ذاته؛ خاصة لتمييز الابن عن أبيه) / أَصْغَر سِنّاً (الشخص الأصغر سناً بين اثنين)\nمثال: هي أصغر مني بسنتين",
 "３塁": "القاعدة الثالثة (مركز اللعب للاعب في فريق البيسبول المتمركز بالقرب من القاعدة الثالثة في الملعب الداخلي) / القاعدة الثالثة (القاعدة التي يجب أن يلمسها العداء ثالثاً في لعبة البيسبول)\nمثال: هو يلعب في القاعدة الثالثة",
 "３士": "متطوع, مُجنّد (أي عضو أو مؤيد جديد (كما في القوات المسلحة)) / مجند جديد, مستجد (جندي تم تجنيده حديثاً)",
 "３尉": "ملازم ثان (ضابط مفوض في الجيش أو القوات الجوية أو المارينز يحمل أدنى رتبة)",
 "３年生": "فِي السَّنَةِ الثَّالِثَة (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الثَّالِثَةِ أَوْ مَا قَبْلَ الأَخِيرَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ أَوِ الجَامِعَةِ الأَمْرِيكِيَّةِ)",
 "３度": "ثلاثة أضعاف (بمعامل ثلاثة)\nمثال: زاد إيجارنا ثلاثة أضعاف في السنوات الخمس الماضية / ثَالِث, ثَالِثَة / ثُلْث (ثَلَثَ الحبل ونحوه يَثْلُثُ ثَلْثًا: فَتَلَهُ من ثلاث قُوى؛ ثَلَثَ العمل: عمله ثلات مرات)\nمثال: الساعة العاشرة والثلث.",
 "３才": "بِعُمُر ثَلَاث سَنَوَات (في عامه الثالث من العمر)",
 "３時": "ثَالِث, ثَالِثَة / ثُلْث (ثَلَثَ الحبل ونحوه يَثْلُثُ ثَلْثًا: فَتَلَهُ من ثلاث قُوى؛ ثَلَثَ العمل: عمله ثلات مرات)\nمثال: الساعة العاشرة والثلث. / ثَالِث (العَدَد التَّرْتِيبِيّ 3) / مُكَعَّب",
 "３時のおやつ": "شاي, شاي بعد الظهر (وجبة خفيفة بعد الظهر تتكون من الشاي والشطائر أو الكعك)",
 "３曹": "رَقِيب, عَرِيف (اَلرَّقِيبُ: من أسماء الله الحسنى، ومعناه: الْحَافِظُ الذي لا يغيب عنه شيء، ولا تخفى عليه خافية، والذي لا يغفل عمّا خلق…؛ فَاعِلٌ مِنْ رَقَبَ)",
 "３月": "مَسِيرَة / لَحْن السَّيْر, مَارْش (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز) / سَارَ (مَشَى)\nمثال: أنا أحب هذا اللحن.",
 "３本": "ثَلَاثَة, ثَلَاث (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "３次元": "ثلاثي الأبعاد (ذو شكل أو مظهر ثلاثي الأبعاد) / ثلاثي الأبعاد (فيلم بصور لها شكل أو مظهر ثلاثي الأبعاد)\nمثال: أليست الأحلام دائماً ثلاثية الأبعاد؟ / عَالَم وَاقِعِيّ (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "３歳": "بِعُمُر ثَلَاث سَنَوَات (في عامه الثالث من العمر)",
 "３百": "ثَلَاثُمِئَة (يَدُلُّ عَلَى العَدَد 300) / مراوغ (شخص (خاصة محامٍ أو سياسي) يستخدم أساليب عديمة الضمير أو غير أخلاقية)",
