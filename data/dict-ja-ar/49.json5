 "証言録取": "خلع, عزل (فعل عزل شخص ما؛ إزالة شخص قوي من منصب أو وظيفة) / إيداع, وضع (عملية وضع شيء ما في مكان ما) / إفادة, شهادة خطية ((قانون) استجواب تمهيدي لشاهد قبل المحاكمة؛ عادة ما يتم في مكتب محام) / ترسب, رواسب (العملية الطبيعية لترسب شيء ما)",
 "証跡": "بُرْهَان, دَلِيل",
 "詐偽": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "詐取": "غَشَّ, جَدَعَ",
 "詐害": "غِشّ, اِحْتِيال",
 "詐欺": "غِشّ, اِحْتِيال",
 "詐欺る": "اِحْتِيَال / اِحْتَالَ",
 "詐欺アプリ": "حِصَان طَرْوَادَة (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: لم يشفى الحصان.",
 "詐欺グループ": "جَرِيمة مُنَظَّمة",
 "詐欺師": "مُحْتَال",
 "詐欺罪": "غِشّ, اِحْتِيال",
 "詐病": "تخاذل, تمارض (التهرب من الواجب أو العمل بالتظاهر بالعجز)",
 "詐称": "تحريف, تزييف (تحريف متعمد للحقائق) / تضليل, خداع (كذب مضلل)",
 "詐術": "غَشَّ, جَدَعَ",
 "詐話師": "فنان احتيال (نصاب يستغل ثقة ضحيته)",
 "詔": "مرسوم إمبراطوري (مرسوم يصدره حاكم ذو سيادة)",
 "詔勅": "أَمْر, مَرْسُوم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "詔書": "أَمْر, مَرْسُوم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "評": "نَقْد, اِنْتِقَاد",
 "評価": "تثمين, تقدير (تقدير لقيمة شيء ما) / تقييم, سعر مقدر (السعر المقدر)\nمثال: وضع تقييماً عالياً للصداقة / تَقْدِير",
 "評価損": "خسارة غير محققة, خسارة ورقية (خسارة غير محققة في استثمار محسوبة بطرح سعر السوق الحالي من تكلفة المستثمر)",
 "評価替え": "إعادة تقييم, مراجعة (تقييم جديد أو تقدير جديد)",
 "評価減": "تخفيض القيمة, شطب ((محاسبة) تخفيض في القيمة الدفترية للأصل)",
 "評価益": "ربح غير محقق, ربح ورقي (ربح غير محقق في استثمار محسوب بطرح تكلفة المستثمر من سعر السوق الحالي)",
 "評価者": "حَكَم, مُقيِّم (سلطة قادرة على تقدير القيمة أو الجودة)",
 "評判": "سُمْعَة, شُهْرَة / إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي) / شُهْرَة",
 "評定": "تَقْيِيم / تَقْدِير, تَقْيِيم / مَجْلِس / مَجْمَع (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "評家": "نَقَّاد, نَاقِد / ناقد",
 "評決": "قَرَار, تَصْمِيم",
 "評注": "تَعْلِيق",
 "評点": "تقدير, تقييم (فعل التأكد من أو تحديد قيمة أو جدوى شيء ما) / تثمين, تقدير (تقدير لقيمة شيء ما) / تصنيف, تقييم (المكانة أو الموقع على مقياس) / رتبة عسكرية (الرتبة في منظمة عسكرية)\nمثال: وضع تقييماً عالياً للصداقة",
 "評者": "نَقَّاد, نَاقِد / ناقد",
 "評言": "تَعْلِيق, مَلْحُوظَة / عَلَّقَ",
 "評註": "تذييل, تعليق (عملية إضافة ملاحظات) / حاشية, ملاحظة (تعليق أو تعليمات (تضاف عادة))\nمثال: أضيفت ملاحظاته في نهاية المقال",
 "評語": "تَعْلِيق, مَلْحُوظَة / عَلَّقَ / دَرَجَة",
 "評説": "إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي) / تَعْلِيق, مَلْحُوظَة / عَلَّقَ",
 "評論": "نَقْد, اِنْتِقَاد",
 "評論家": "نَقَّاد, نَاقِد / ناقد",
 "評議": "مُؤْتَمَر",
 "評議会": "مَجْلِس / مَجْمَع (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "評議員": "عُضْو مَجْلِس أُمَناء, وَصِيّ (أعضاء في مجلس حاكم أو مجلس أمناء) / أمين, وصي قانوني (شخص (أو مؤسسة) يُعهد إليه بالملكية القانونية للممتلكات لاستخدامها لصالح شخص آخر)",
 "評釈": "تَعْلِيق",
 "詛い": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة",
 "詛う": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة",
 "詛呪": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة",
 "詞": "كلام, كلمات (اللغة التي يتم التحدث بها أو كتابتها) / حوار, كلام الممثل (كلمات تشكل حوار مسرحية) / كلمات الأغنية (نص أغنية شعبية أو رقم موسيقي كوميدي) / كلمات (الكلمات التي يتم نطقها)\nمثال: لديه موهبة في الكلام / مِئَة وَوَاحِد (يَدُلُّ عَلَى العَدَد 101) / كوري (وحدة للنشاط الإشعاعي تساوي كمية النظير المشع الذي يتحلل بمعدل 37 مليار تفكك في الثانية)",
 "詞書": "مُقَدِّمَة",
 "詞書き": "مُقَدِّمَة",
 "詞花集": "تَجْمِيعَة, دِيوَان",
 "詞華集": "تَجْمِيعَة, دِيوَان",
 "詠": "تِلَاوَة / مُؤَلَّف, مُصَنَّف",
 "詠う": "غَنَّى / تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه)",
 "詠じる": "أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك. / تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه)",
 "詠ずる": "أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك. / تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه)",
 "詠み人": "مُلَحِّن / مُؤَلِّف مُوسِيقِيّ",
 "詠み人知らず": "مَجْهُول",
 "詠み手": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "詠む": "أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك. / تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه)",
 "詠人": "مُلَحِّن / مُؤَلِّف مُوسِيقِيّ",
 "詠人知らず": "مَجْهُول",
 "詠叙唱": "أريوسو ((موسيقى) رسيتاتيف قصير لحني ولكنه ليس آريا كاملة)",
 "詠唱": "نَغَم / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: عادت إلى الغناء.",
 "詠嘆": "صِيَاح, صُرَاخ (مصدر الفعل صَاحَ؛ صوت الكائن الحي القوي)\nمثال: بدأنا في الصياح.",
 "詠手": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "詠歌": "قَصِيدَة, شِعْر",
 "詣で": "حَجّ (القَصْد والزِيَارَة على جهة التَعْظِيم؛ زيارة مكان مُقَدَّس بهدف ديني ويوجد عند معظم الديانات منها اليَهُودِيَّة والمَسِيحِيَّة والإسْلام)\nمثال: ذهب رجل للحج وترك خلفه خمس بنات وكلبة.",
 "詣り": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "試": "اختبار, امتحان (فعل إعطاء الطلاب أو المرشحين اختباراً (عن طريق الأسئلة) لتحديد ما يعرفونه أو ما تعلموه) / اختبار (فعل الإخضاع لاختبار تجريبي لتحديد مدى جودة عمل شيء ما) / اختبار, فحص (فحص خصائص شيء ما)\nمثال: وافقوا على إنهاء اختبار الأسلحة الذرية",
 "試し": "مُحَاكَمَة (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري.",
 "試す": "حَاوَلَ, سَعَى (طَلَبَ، رَامَ) / حَاكَمَ (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر) / مُحَاوَلَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: حاول توم قتلنا!",
 "試み": "حَاوَلَ (طَلَبَ، رَامَ) / مُحَاوَلَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: حاول توم قتلنا! / جهد, محاولة (نشاط جاد وواعي يهدف إلى فعل أو إنجاز شيء ما) / مسعى, مشروع (مشروع هادف أو كادح (خاصة المشروع الذي يتطلب جهداً أو جرأة))\nمثال: بذل جهدًا لتغطية جميع مواد القراءة",
 "試みる": "حَاوَلَ, سَعَى (طَلَبَ، رَامَ) / حَاكَمَ (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر) / مُحَاوَلَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: حاول توم قتلنا!",
 "試む": "حَاوَلَ (طَلَبَ، رَامَ) / مُحَاوَلَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: حاول توم قتلنا!",
 "試乗": "قيادة تجريبية (اختبار صلاحية مركبة يفكر المرء في شرائها)",
 "試作": "تَجْرِبَة, اِخْتِبَار / جَرَّبَ (أَصابَهُ الجَرَب؛ السَّيْفُ: صَدِئَ)\nمثال: جرب هذا الكسكس.",
 "試供品": "عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ",
 "試写": "عرض خاص, عرض مسبق (عرض لجمهور مختار قبل الإصدار للجمهور العام) / عَرْض تَرْوِيجِيّ, مَقْطَع دِعَائِيّ (إعلان يتكون من مشاهد قصيرة من فيلم سينمائي سيظهر في المستقبل القريب)",
 "試写会": "عرض خاص, عرض مسبق (عرض لجمهور مختار قبل الإصدار للجمهور العام) / عَرْض تَرْوِيجِيّ, مَقْطَع دِعَائِيّ (إعلان يتكون من مشاهد قصيرة من فيلم سينمائي سيظهر في المستقبل القريب)",
 "試合場": "دائرة الاختصاص المكاني, مكان الانعقاد (في القانون: الولاية القضائية التي ستُعقد فيها المحاكمة) / محل, مكان الانعقاد (مسرح أي حدث أو إجراء (خاصة مكان الاجتماع))",
 "試合開始": "ركلة البداية ((كرة القدم الأمريكية) ركلة من وسط الملعب لبدء مباراة كرة القدم أو استئنافها بعد تسجيل هدف) / انطلاق, ضربة البداية (بداية تعطى للمتسابقين) / استهلال, انطلاق (الوقت الذي يفترض أن يبدأ فيه شيء ما)\nمثال: كنت هناك مع والدي عند الانطلاق",
 "試問": "مُقَابَلَة",
 "試掘": "توقع, احتمال / تَنْقِيْب (نقّب إذا سار في البلاد طلباً للمهرب ، نقّب عن الأخبار وغيرها:بحث عنها،هو البحث عن كلّ شيء والتّفتيش مطلقاً؛ نقّب مبالغة في نَقَب ، نقّب عن الشيء :فحص عنه فحصاً بليغاً)",
 "試掘者": "منقّب (شخص يستكشف منطقة بحثاً عن رواسب معدنية)",
 "試料": "عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ",
 "試演": "بَرُوفَة",
 "試用": "مُحَاكَمَة (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري.",
 "試用期間": "فترة اختبار, فترة تجريبية (فترة زمنية يتم خلالها اختبار شخص أو شيء ما)",
