 "類同語": "تَنَاظُرِيّ, خَطِّيّ (لدائرة أو جهاز له مخرج يتناسب مع المدخل) / شَبِيه, مَثِيل (شيء يمتلك خاصية كونه مناظراً لشيء آخر)\nمثال: جهاز تناظري",
 "類型": "نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: انه نوع من الفطر.",
 "類型化": "تمثيل رمزي (فعل التمثيل بنوع أو رمز) / تجسيد, تمثيل نمطي (شكل أو نموذج تمثيلي أو نمطي)",
 "類型学": "تصنيف نمطي, نمذجة (التصنيف وفقاً للنوع العام)",
 "類型的": "مُكَرَّر, نَمَطِيّ (يَفْتَقِرُ إِلَى العَفْوِيَّةِ أَوِ الأَصَالَةِ أَوِ التَّفَرُّد)",
 "類型論": "تصنيف نمطي, نمذجة (التصنيف وفقاً للنوع العام)",
 "類推": "قِيَاس",
 "類推的": "تَمْثِيلِيّ, قِيَاسِيّ (يُعَبِّر عَن شَيْء بِالقِياس عَلى شَيْء آخَر أَوْ يَقوم عَلَيْه)",
 "類概念": "جِنْس (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا)\nمثال: أنا مثلي الجنس.",
 "類比": "قِيَاس / مُقَارَنَة / مُقَابَلَة / تَشْبِيه / مُقَايَسَة",
 "類洞": "جيبيات (ممرات دقيقة مبطنة ببطانة غشائية للدم في نسيج عضو ما) / منحنى الجيب",
 "類稀": "نَادِر",
 "類線維腫": "ورم ليفي (ورم حميد يحتوي على أنسجة ليفية (خاصة في الرحم))",
 "類縁": "أُلْفَة, انْجِذَاب (انجذاب طبيعي أو شعور بالقرابة) / أُلْفَة, تَجَانُس (تشابه متأصل بين الأشخاص أو الأشياء) / ألفة, انجذاب كيميائي (القوة التي تجذب الذرات لبعضها وتربطها معاً في جزيء) / ألفة ((في المناعة) الانجذاب بين مستضد وجسم مضاد)\nمثال: انجذاب للسياسة",
 "類縁体": "تَنَاظِرِيَّة",
 "類義": "تَرَادُف (العلاقة الدلالية التي تربط بين كلمتين يمكن (في سياق معين) أن تعبرا عن نفس المعنى)",
 "類義語": "مُرَادِف (اسم فاعل من الفعل \"رَادَفَ\"؛ (في علم دلالة الألفاظ) كلمة لها المعنى نفسه أو معنى قريب له لكلمة أخرى في اللغة)\nمثال: الانفصالي مرادف للعاهرة.",
 "類義語辞典": "مَكْنَز",
 "類肉腫症": "داء الساركويد (مرض مزمن غير معروف السبب يتميز بتكوين عقيدات في الرئتين والكبد والغدد الليمفاوية والغدد اللعابية)",
 "類脂質": "دهون, ليبيد (مركب عضوي زيتي غير قابل للذوبان في الماء ولكنه قابل للذوبان في المذيبات العضوية؛ مكون هيكلي أساسي للخلايا الحية (إلى جانب البروتينات والكربوهيدرات))",
 "類語辞典": "مَكْنَز",
 "類語辞書": "مَكْنَز",
 "類音": "ديافون (بوق ضباب يصدر إشارة تتكون من نغمتين)",
 "類韻": "سجع, قافية حروف العلة (تكرار حروف العلة المتشابهة في المقاطع المشددة للكلمات المتتالية)",
 "顧み": "عَاكِسٌ لِلضَّوْء (يُسبِّب الانعكاس أو يحتوي على جهاز عاكس) / اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "顧みられない": "مُتَجَاهَل, مُهْمَل (لم يُؤبَه له؛ أُهمِل عمداً)",
 "顧みる": "اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين) / عَدَّ\nمثال: اعتبر نفسك محظوظا",
 "顧る": "اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين) / عَدَّ\nمثال: اعتبر نفسك محظوظا",
