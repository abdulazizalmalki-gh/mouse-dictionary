 "誰得": "بدون جدوى",
 "誰誰": "فُلَان, فُلَانَة (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو شخص لا يريد المتحدث ذكره)\nمثال: سمعنا ذلك من فلان و فلان.",
 "課": "دَرْس, حِصَّة ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / عِبْرَة (الدَمْعَة قبل أن تفيض؛ المَشَاعِر العميقة الحزينة)\nمثال: أراك بعد الدرس. / قِسْم, جُزْء (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَقْطَع\nمثال: أنا أزين القسم.",
 "課す": "تجنيد عام, نفير عام (فعل التجنيد في الخدمة العسكرية) / جباية, رسم مفروض (رسم يفرض ويحصل)",
 "課する": "تجنيد عام, نفير عام (فعل التجنيد في الخدمة العسكرية) / جباية, رسم مفروض (رسم يفرض ويحصل)",
 "課外": "خَارِج نِطَاق الزَّوَاج, زَانٍ (يتسم بالزنا أو العلاقات خارج إطار الزواج) / خَارِج نِطَاق العَمَل (خارج المهام الاعتيادية للوظيفة أو المهنة) / خَارِج المِنْهَاج, لَا مَنْهَجِيّ (خارج المنهج الدراسي الأكاديمي المعتاد)",
 "課外活動": "نشاط لا صفي (أنشطة تعليمية لا تقع ضمن نطاق المناهج الدراسية العادية)",
 "課徴金": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي",
 "課業": "عمل منزلي, واجب مدرسي (عمل، مثل العمل المدرسي أو العمل بالقطعة، يتم في المنزل)",
 "課目": "فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / بَنْد",
 "課程": "طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / مَسار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا الطبق لذيذ.",
 "課税": "جباية الضرائب, فرض الضرائب (فرض الضرائب؛ ممارسة الحكومة في جباية الضرائب على رعايا الدولة) / إيرادات ضريبية (دخل الحكومة الناتج عن الضرائب) / جباية, ضريبة (رسم يفرض على شخص المواطن أو ممتلكاته أو نشاطه لدعم الحكومة)",
 "課税率": "معدل الضريبة, نسبة الضريبة (المعدل المستخدم لحساب الالتزام الضريبي)",
 "課金": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي",
 "課題": "فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / وَاجِب, وَاجِب مَنْزِلِيّ (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / تَمْرِين / مَسْأَلَة / طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "課題曲": "قطعة ديكور مستقلة (قطعة من المناظر تهدف إلى الوقوف بمفردها كجزء من إعداد المسرح)",
 "誹り": "لَامَ, اِسْتَنْكَرَ (لامَ يَلوم ، لُمْ ، لَوْمًا ، فهو لائم والجمع : لُوَّمٌ ، ولُيَّمٌ وهو أَيضاً لَوَّامٌ ، ولَوَّامةٌ ، ولْوَمةٌ وذاك مَلُومٌ ، ومَلِيمٌ…)\nمثال: لام سامي معلمه على فشله هو.",
 "誹る": "تَشْهِير, اِفْتِرَاء",
 "誹毀": "تَشْهِير, بُهْتَان",
 "誹謗": "تَشْهِير, اِفْتِرَاء",
 "誹謗中傷": "تَشْهِير, اِفْتِرَاء",
 "誹譏": "تَشْهِير, بُهْتَان",
 "誹議": "نَقْد, اِنْتِقَاد",
 "誼": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "誼み": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "調": "جِزْيَة / خَرَاج / ضَرِيبَة / زِرّ / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / مِنْوَال\nمثال: لقد أزمت الوضع. / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / مِقْيَاس / وَزْن / بَحْر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "調える": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة. / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه. / ضَبَطَ",
 "調べ": "تَحْقِيق / لَحْن (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن.",
 "調べた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "調べなおす": "أَعَادَ الفحص, رَاجَعَ (نظر مرة أخرى؛ فحص مرة أخرى)\nمثال: لنراجع وضعك",
 "調べもの": "تَحْقِيق",
 "調べる": "فَحَصَ, اِمْتَحَنَ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض)\nمثال: فحص الطبيب بطني.",
 "調べ室": "صندوق تعريق (جهاز يسبب تعرق أوراق التبغ أو الفاكهة أو الجلود) / زنزانة ضيقة (زنزانة صغيرة أو ضيقة)",
 "調べ帯": "حِزَام, زُنَّار (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر) / سَيْر (أسَارَ، أي جعله يَسِير والفرق بين الإثنين أن سَيَّرَ فيها تكرار وأسارَ لا تكرار فيها؛ فلان من بَلَده أو مَوْطِنه: أخْرَجَه وأجْلاه)\nمثال: هذا حزام من الجلد.",
 "調べ物": "تَحْقِيق",
 "調べ直す": "أَعَادَ الفحص, رَاجَعَ (نظر مرة أخرى؛ فحص مرة أخرى)\nمثال: لنراجع وضعك",
 "調伏": "رُقْيَة",
 "調停": "وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / وساطة (تفاوض لحل الخلافات يديره طرف محايد) / ترضية, مصالحة (فعل الترضية والتغلب على عدم الثقة والعداء) / توفيق, مصالحة (أي من أشكال الوساطة المختلفة التي يمكن من خلالها تسوية النزاعات قبل الوصول للتحكيم) / توفيق, مصالحة (حالة إظهار النوايا الحسنة والتعاون بعد التصالح)\nمثال: كانت هناك فترة وجيزة من المصالحة لكن القتال سرعان ما استؤنف",
 "調停者": "حَكَم, مُحكِّم (شخص يتم اختياره للحكم والبت في قضية متنازع عليها)\nمثال: اعتُبر الناقد حكماً للأدب الحديث",
 "調光": "مخفت الإضاءة (مقاومة متغيرة تغير التيار عبر مصباح كهربائي للتحكم في مستوى الإضاءة)",
 "調光器": "مخفت الإضاءة (مقاومة متغيرة تغير التيار عبر مصباح كهربائي للتحكم في مستوى الإضاءة)",
 "調剤": "تركيب, جمع (عملية دمج الأشياء لتكوين كلٍ جديد)",
 "調剤師": "موزع (حاوية مصممة بحيث يمكن استخدام المحتويات بكميات محددة) / صارف, موزّع (شخص يقوم بالتوزيع أو الصرف)",
 "調剤薬局": "مستوصف (عيادة يتم فيها صرف الأدوية والمستلزمات الطبية)",
 "調印": "تَوْقِيع, إِمْضَاء (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ) / تَوْقِيع (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم.",
 "調印者": "مُوقّع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "調号": "توقيع المفتاح, دليل المفتاح (علامات الرفع (الدييز) أو الخفض (البيمول) التي تتبع المفتاح وتشير إلى السلم الموسيقي)",
 "調合": "خلط, خليط (عملية خلط الأشياء معاً)\nمثال: عجينة مصنوعة من خليط الدقيق والماء",
 "調合剤": "خَلِيط",
 "調味": "بَهَار, تَابِل",
 "調味料": "بَهَار, تَابِل",
 "調和": "اِنْسِجَام, تَوَافُق",
 "調和平均": "وسط توافقي",
 "調和数列": "متتالية توافقية ((رياضيات) متتالية من الحدود تشكل مقلوباتُها متتالية حسابية)",
 "調和解析": "تحليل توافقي, تحليل فورييه (تحليل دالة دورية إلى مجموع مكونات جيبية بسيطة)",
 "調子": "لَحْن (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن. / وَرِيد, عِرْق / شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / دفعة, قوة دافعة مفاجئة (فعل تطبيق قوة فجأة) / اندفاع, حافز (قوة تحرك شيئاً ما للأمام)\nمثال: الدفعة المفاجئة أسقطته أرضاً",
 "調子がいい": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري) / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً)",
 "調子がよい": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري) / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً)",
 "調子が良い": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري) / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً)",
 "調子っぱずれ": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / تضارب, تنافر (خليط حاد ومزعج من الأصوات) / تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / خلاف, شقاق (عدم الاتفاق أو الانسجام)",
 "調子っ外れ": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / تضارب, تنافر (خليط حاد ومزعج من الأصوات) / تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / خلاف, شقاق (عدم الاتفاق أو الانسجام)",
 "調子のいい": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري) / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً)",
 "調子のよい": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري) / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً)",
 "調子の良い": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري) / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً)",
 "調子はずれ": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / تضارب, تنافر (خليط حاد ومزعج من الأصوات) / تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / خلاف, شقاق (عدم الاتفاق أو الانسجام)",
 "調子外れ": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / تضارب, تنافر (خليط حاد ومزعج من الأصوات) / تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / خلاف, شقاق (عدم الاتفاق أو الانسجام)",
 "調子笛": "أنبوب النغمة (أنبوب صغير يصدر نغمة بتردد قياسي؛ يستخدم لتحديد نغمة البداية للغناء غير المصحوب بآلات)",
 "調室": "صندوق تعريق (جهاز يسبب تعرق أوراق التبغ أو الفاكهة أو الجلود) / زنزانة ضيقة (زنزانة صغيرة أو ضيقة)",
 "調布": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "調帯": "حِزَام, زُنَّار (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر) / سَيْر (أسَارَ، أي جعله يَسِير والفرق بين الإثنين أن سَيَّرَ فيها تكرار وأسارَ لا تكرار فيها؛ فلان من بَلَده أو مَوْطِنه: أخْرَجَه وأجْلاه)\nمثال: هذا حزام من الجلد.",
 "調度": "أَثَاث, مَفْرُوشَات (الرياش والمتاع وما يوضع للاستخدام للجلوس أو النوم أو حفظ المتاع أو غيره داخل البيت أو خارجه؛ الرياش والمتاع بما فيها المال والملابس)\nمثال: يصنع قطعة أثاث خشبية. / قَوْس وَسَهْم",
 "調度品": "تأثيث (عملية تزويد منزل أو غرفة بالأثاث وغيرها من العناصر القابلة للإزالة مثل الرفوف والسجاد والأجهزة، إلخ) / أثاث منزلي, تجهيزات منزلية (الوسائل (الأثاث والأجهزة والملحقات المنقولة الأخرى بما في ذلك الستائر والسجاد) التي تجعل المنزل (أو أي منطقة أخرى) صالحة للعيش) / توابع ملابس, لوازم زينة ((عادة بصيغة الجمع) ملحقات الملابس الثانوية)",
 "調弦": "توليف, دوزنة ((موسيقى) معايرة شيء ما (آلة أو دائرة إلكترونية) لتردد قياسي)",
 "調律": "توليف, دوزنة ((موسيقى) معايرة شيء ما (آلة أو دائرة إلكترونية) لتردد قياسي)",
 "調律師": "مدوزن البيانو (شخص يضبط البيانو)",
 "調律異常": "اِضْطِرَاب نَظْم القَلْب",
 "調性": "سلم, مفتاح (أي من 24 سلماً دياتونياً كبيراً أو صغيراً توفر الإطار النغمي لمقطوعة موسيقية)",
 "調教": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب.",
 "調教師": "مدرب حيوانات (شخص يدرب الحيوانات أو يعرضها)",
 "調整": "ضَبْط",
 "調整剤": "مُسوي مطالبات, وكيل مطالبات (شخص يحقق في مطالبات التأمين أو المطالبات عن الأضرار ويوصي بتسوية فعالة)",
 "調整可能": "قَابِل لِلتَّعْدِيل, قَابِل لِلضَّبْط (يمكن تنظيمه أو ضبطه) / قَابِلٌ لِلتَّعْدِيل, قَابِلٌ لِلضَّبْط (يُمْكِنُ تَغْيِيرُهُ لِيُلَائِمَ أَوْ يُنَاسِبَ)",
 "調整役": "مُنَسِّق / مُنَظِّم",
 "調整池": "حوض احتباس (موقع تخزين مشابه لحوض الاحتجاز لكن المياه المخزنة تُمنع بشكل دائم من التدفق باتجاه المصب)",
 "調書": "بْرُوتُوكُول",
 "調査": "تَحْقِيق",
 "調査分析": "تَشْخِيص",
 "調査員": "مُحَقِّق, مُحَقِّقَة (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ الَّذِي يُحَقِّقُ مَعَ الْمُتَّهَمِ فِي قَضِيَّةٍ لِلْكَشْفِ عَنْ مَجْرَيَاتِهَا)\nمثال: تحدث ياني مع محقق.",
 "調査報告": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "調査官": "فاحص, مفتش (محقّق يراقب ويدقق بعناية) / مختبِر, ممتحِن (شخص يدير اختبارًا لتحديد مؤهلاتك)\nمثال: بحث الفاحص عن أدلة",
 "調査役": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "調査書": "نُسْخَة",
 "調査票": "اِسْتِبَانَة",
 "調査結果": "تَسَبَّب / نَتِيجَة",
 "調法": "مُنَاسِب, مُلَائِم",
 "調波": "مُتَوافِق, مُنْسَجِم (مُتَناغِم ومُتَّسِق في التَّوْليفَة الصَّوْتِيَّة) / تَوافُقِيّ, رَنّانِيّ (يَتَعَلَّق بِالتَّوافُقِيّات أو الرَّنين المُتَعاطِف) / توافقي, هارموني (مكون من أو متعلق بالتوافق (الهارموني) كتميز عن اللحن والإيقاع) / توافقي (مكون من أو متعلق بفرع الصوتيات الذي يدرس تركيب الأصوات الموسيقية)\nمثال: دقة التغيير التوافقي والنغمية",
 "調湿剤": "عامل تجفيف, مادة مجففة (مادة تعزز الجفاف (مثل أكسيد الكالسيوم الذي يمتص الماء ويستخدم لإزالة الرطوبة))",
 "調理": "طَبْخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ.",
 "調理人": "طَاهٍ, طَاهِي",
 "調理台": "طاولة المطبخ (طاولة توضع في المطبخ)",
 "調理器具": "أواني الطهي (أداة مطبخ مصنوعة من مادة لا تذوب بسهولة؛ تستخدم للطهي)",
 "調理場": "مَطْبَخ (المكان الذي يُطْبَخُ فيه، غُرْفَة أو مساحة في البناء مخصصة للطبخ؛ في : هو المَطْعَم)\nمثال: سامي في المطبخ.",
 "調理室": "قَادِس",
 "調理法": "وَصْفَة",
 "調理者": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر.",
 "調理道具": "آنية مطبخ, أداة مطبخ (أداة تستخدم في إعداد الطعام)",
 "調略": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "調節": "تَنْظِيم",
 "調節器": "مُنَظِّم",
 "調節遺伝子": "جين تنظيمي (جين ينتج مادة كابتة تمنع الجين المشغل)",
 "調節障害": "إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما) / شِجَار عَلَنِيّ, عِرَاك (قتال صاخب) / إزعاج, اضطراب (نشاط يمثل خللاً أو تطفلاً أو انقطاعاً) / تداخل, تشويش (نشاط كهربائي أو صوتي يمكن أن يزعج الاتصالات)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي",
 "調練": "تدريب عسكري (التدريب على المسير واستخدام الأسلحة)",
 "調色": "نَغْمَة, نَغْم",
 "調色板": "باليتة, لوحة ألوان (لوح يوفر سطحاً مستوياً يخلط عليه الفنانون الطلاء ومجموعة الألوان المستخدمة) / واقي الإبط (واحدة من الصفائح الدرعية المستديرة عند الإبطين في بدلة الدرع) / لوحة ألوان (نطاق الألوان المميز لفنان معين أو لوحة أو مدرسة فنية)",
 "調製": "ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود) / مستلزمات, مقومات ((عادة بصيغة الجمع) المكونات اللازمة لصنع أو فعل شيء ما) / كَفَاءَة, مُؤَهِّل (سمة يجب الوفاء بها أو الامتثال لها وتجعل الشخص مناسباً لشيء ما)\nمثال: ابتكار الخطط",
 "調貢": "جِزْيَة / خَرَاج",
 "調速機": "مُحَافِظ, حَاكِم",
 "調進": "تَحْضِير, إِعْدَاد",
 "調達": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تَوْرِيد, تَزْوِيد / ذَخِيرَة",
 "調達先": "مُزَوِّد, مُزَوِّدَة",
 "調音": "تمفصل (عملية ربط الأشياء بطريقة تجعل الحركة ممكنة) / مفصل ((في التشريح) نقطة الاتصال بين عظمين أو عناصر هيكل عظمي (خاصة إذا كانت تسمح بالحركة)) / تعبير, نطق (التعبير بشكل لفظي متماسك) / تلفظ, نطق مخارج الحروف (جانب النطق الذي يتضمن جمع أعضاء النطق معاً لتشكيل أصوات الكلام)\nمثال: التعبير عن مشاعري / توليف, دوزنة ((موسيقى) معايرة شيء ما (آلة أو دائرة إلكترونية) لتردد قياسي)",
 "調音位置": "مَخْرَج",
 "調音点": "مَخْرَج",
 "調音部位": "مَخْرَج",
 "調香師": "عَطَّار, عَطَّارَة",
 "調馬場": "بادوك, مضمار الاستعراض (حظيرة يتم فيها إسراج خيول السباق واستعراضها قبل السباق)",
 "調髪": "حَلَاقَة",
 "諂い": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "諂う": "تَمَلَّقَ, تَبَصْبَصَ",
 "諂媚": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "諄々": "بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "諄々しい": "إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي)",
 "諄諄": "بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "諄諄しい": "إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي)",
 "談": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب.",
 "談じる": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / تَفَاوَضَ",
 "談ずる": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / تَفَاوَضَ",
 "談判": "مُفَاوَضَات, مُذَاكَرَات",
 "談合": "تَوَاطُؤ / مُشَاوَرَة, اِسْتِشَارَة",
 "談林": "دَيْر (بيت يسكنه الرُهْبَان أو الرَاهِبَات ممن كان على دين المسيحية)\nمثال: سيداتي و سادتي ، رجاء قفوا للنشيد الوطني للاتحاد الروسي باداء جوقة دير سرتينسكي .",
 "談義": "مُنَاقَشَة, بَحْث / تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / تَحْذِير, تَنْبِيه (نصيحة تحذيرية حول شيء وشيك (خاصة خطر وشيك أو أمر غير سار)) / إِنْذَار, تَحْذِير (توبيخ حازم)\nمثال: خطاب تحذير حول مخاطر الفسق / مَوْعِظَة, خُطْبَة",
 "談話": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / اِرْتِجَالِيّ, عَفْوِيّ (بقليل من الإعداد أو التفكير المسبق أو بدونهما)",
 "談話会": "حلقة نقاش, ندوة (خطاب في اجتماع أكاديمي أو ندوة) / حَلَقَة نِقَاشِيَّة, مُؤْتَمَر عِلْمِيّ (اجتماع أكاديمي أو ندوة يقودها عادة محاضر مختلف وتتناول موضوعاً مختلفاً في كل اجتماع)",
 "談話室": "صَالَة, قَاعَة (مكان فسيح في وسط المسكن يُوصِلُ إلى سائر الحجرات، الرُدْهَة؛ غُرْفَةُ المَعِيْشَة سواء كانت توصل إلى سائر الحجرات أم لا وسواء كانت فسيحة أم لا)\nمثال: حجزت الصالة يوم الخميس.",
 "談語": "مُنَاقَشَة, بَحْث",
 "談論": "مُنَاقَشَة, بَحْث",
 "談議": "مُنَاقَشَة, بَحْث / تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / تَحْذِير, تَنْبِيه (نصيحة تحذيرية حول شيء وشيك (خاصة خطر وشيك أو أمر غير سار)) / إِنْذَار, تَحْذِير (توبيخ حازم)\nمثال: خطاب تحذير حول مخاطر الفسق / مَوْعِظَة, خُطْبَة",
 "請": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "請い": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "請い受ける": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك",
 "請い求める": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك",
 "請い願う": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك",
 "請う": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك / صَلَّى, دَعَا",
 "請く": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "請け": "شَعْبِيَّة / دِفَاع, حِمَايَة / دِفاع / اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة / قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما.",
 "請ける": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / أَبْقَى / عَالَ, يَعُولُ (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "請け人": "كَافِل",
 "請け合い": "ثقة, ثقة بالنفس (الخلو من الشك؛ الإيمان بالنفس وبالقدرات) / تأكيد, طمأنة (بيان يهدف إلى إلهام الثقة) / تَعَهُّد, ضَمَان (التزام ملزم بالقيام بشيء أو إعطائه أو الامتناع عنه) / تأمين (بريطاني) (مصطلح بريطاني لبعض أنواع التأمين)\nمثال: ثقته بتفوقه لم تجعله محبوباً",
 "請け合う": "قَامَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه. / أَكَّدَ (أكَّد الخبرَ ونحوه :صرّح بصحَّته؛ أَكَدَّ : قَرَّرَ، أَثْبَتَ، وثَّقَ)\nمثال: أكد صمته شكوكها",
 "請け戻し": "فِدَاء / خَلَاص",
 "請け戻す": "فِدْيَة / اِفْتَدَى, فَدَى",
 "請け書": "إِيصَال",
 "請け負い": "عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد.",
 "請け負う": "عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد.",
 "請じる": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "請ずる": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "請人": "كَافِل",
 "請合い": "ثقة, ثقة بالنفس (الخلو من الشك؛ الإيمان بالنفس وبالقدرات) / تأكيد, طمأنة (بيان يهدف إلى إلهام الثقة) / تَعَهُّد, ضَمَان (التزام ملزم بالقيام بشيء أو إعطائه أو الامتناع عنه) / تأمين (بريطاني) (مصطلح بريطاني لبعض أنواع التأمين)\nمثال: ثقته بتفوقه لم تجعله محبوباً",
 "請合う": "قَامَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه. / أَكَّدَ (أكَّد الخبرَ ونحوه :صرّح بصحَّته؛ أَكَدَّ : قَرَّرَ، أَثْبَتَ، وثَّقَ)\nمثال: أكد صمته شكوكها",
 "請戻し": "فِدَاء / خَلَاص",
 "請戻す": "فِدْيَة / اِفْتَدَى, فَدَى",
 "請書": "إِيصَال",
 "請求": "دَعْوَى, اِدِّعَاء (إدِّعَاء؛ دُعَاء) / مُطَالَبَة / ٱِدَّعَى, زَعَمَ\nمثال: رفضت الضحية إقامة دعوى قضائية.",
 "請求書": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه؛ قانون وافق عليه الكونجرس (البرلمان الأمريكي)) / فَاتُورَة, حِسَاب / مِنْقَار\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "請求記号": "رقم الاستدعاء, رقم الطلب (علامة تتكون من أحرف مكتوبة على كتاب؛ تستخدم للإشارة إلى موقعه على الرف)",
 "請求項": "دَعْوَى, اِدِّعَاء (إدِّعَاء؛ دُعَاء) / مُطَالَبَة / ٱِدَّعَى, زَعَمَ\nمثال: رفضت الضحية إقامة دعوى قضائية.",
 "請託": "إغواء للرذيلة, استدراج (فعل إغراء شخص للقيام بشيء خاطئ (مثل عرض الجنس مقابل المال)) / اسْتِجْدَاء, الْتِمَاس (طلب مبلغ من المال) / التماس (توسل موجه إلى شخص ذي مكانة أعلى)\nمثال: مناشدة لجمع المال للأطفال الجياع",
 "請謁": "ضارع, متوسل (يقوم بالتوسل أو الاستجداء)",
 "請負": "عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد.",
 "請負人": "مُقَاوِل",
 "請負契約": "عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد.",
 "請負師": "مُقَاوِل",
 "請願": "عَرِيضَة, طَلَب",
 "請願書": "عَرِيضَة, طَلَب",
 "請願者": "مستعطف, ملتمس (شخص يطلب شيئاً بتواضع) / طالب الانتصاف, مقدم الالتماس (شخص يلتمس من المحكمة رفع مظلمة أو استرداد حق)\nمثال: مستعطف لرضاها",
 "諌め": "اعتراض, معاتبة (فعل التعبير عن معارضة جادة أو احتجاج)",
 "諌止": "إقناع بالعدول, ثني (الإقناع بعدم القيام بشيء أو عدم تصديقه؛ إقناع شخص بالعدول عن معتقد أو مسار عمل مقصود) / إِثْنَاء, نُصْح بِالْعُدُول (تواصل يثنيك عن فعل شيء)",
 "諌言": "تَحْذِير, تَنْبِيه (نصيحة تحذيرية حول شيء وشيك (خاصة خطر وشيك أو أمر غير سار)) / إِنْذَار, تَحْذِير (توبيخ حازم)\nمثال: خطاب تحذير حول مخاطر الفسق",
 "諍い": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "諍う": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "諏訪": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "諏訪部": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "諒": "مَعْلُومَة, حَقِيقَة",
 "諒する": "شَكَرَ ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته.",
 "諒とする": "شَكَرَ ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته.",
 "諒察": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "諒恕": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "論": "جِدَال, مُجَادَلَة (مراء يتعلق بإظهار المذاهب وتقريرها، ذكره ابن الكمال (التوقيف)؛ فنّ الجِدال: ( والتصوف) ضربٌ خادعٌ من المناقشة أساسه استعمال الحجج السُّفسطائيّة…) / وَسِيط\nمثال: لا جدال في ذلك. / نَظَرِيَّة (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية. / مَقَالَة, بَحْث",
 "論い": "جدل, سجال (فعل كلامي جدلي؛ نزاع حيث يوجد اختلاف قوي في الرأي)\nمثال: انخرطوا في جدال عنيف",
 "論う": "نَاقَشَ, بَحَثَ / اِنْتَقَدَ / نَقَدَ",
 "論じる": "نَاقَشَ, بَحَثَ / جَادَلَ, حَاجَّ (حَاوَرَ، نَاقَشَ؛ خَاصَمَ) / أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "論じ合う": "مُنَاظَرَة, مُنَاقَشَة (مصدر من ناظَرَ)",
 "論ずる": "نَاقَشَ, بَحَثَ / جَادَلَ, حَاجَّ (حَاوَرَ، نَاقَشَ؛ خَاصَمَ) / أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "論をまたない": "مِن نَّافِلَةِ القَوْلِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "論を俟たない": "مِن نَّافِلَةِ القَوْلِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "論を待たない": "مِن نَّافِلَةِ القَوْلِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "論争": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول)\nمثال: شمال مالي منطقة نزاع.",
 "論争者": "مُجادِل, مُخاصِم (شخص يجادل؛ شخص يجيد أو يستمتع بالجدل)",
 "論判": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين / جِدَال, مُجَادَلَة (مراء يتعلق بإظهار المذاهب وتقريرها، ذكره ابن الكمال (التوقيف)؛ فنّ الجِدال: ( والتصوف) ضربٌ خادعٌ من المناقشة أساسه استعمال الحجج السُّفسطائيّة…) / وَسِيط\nمثال: لا جدال في ذلك.",
 "論及": "ذِكْر (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة) / ذَكَرَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "論壇": "خطم (نتوء يشبه المنقار للجزء الأمامي من رأس بعض الحشرات مثل السوس) / منبر, منصة الخطابة (منصة مرتفعة عن المستوى المحيط لإبراز الشخص الموجود عليها)",
 "論外": "غَيْرُ وَارِد, مُسْتَحِيل (مُسْتَبْعَدٌ تَمَامًا؛ لَا يُمْكِنُ تَصَوُّرُه) / عَرَضِيّ",
 "論客": "مُجادِل, مُخاصِم (شخص يجادل؛ شخص يجيد أو يستمتع بالجدل)",
 "論弁": "جِدَال, مُجَادَلَة (مراء يتعلق بإظهار المذاهب وتقريرها، ذكره ابن الكمال (التوقيف)؛ فنّ الجِدال: ( والتصوف) ضربٌ خادعٌ من المناقشة أساسه استعمال الحجج السُّفسطائيّة…) / وَسِيط\nمثال: لا جدال في ذلك.",
 "論弁的": "اِسْتِطْرَادِيّ, مُتَشَعِّب ((عَنِ الكَلَام وَالكِتَابَة) يَمِيل إِلَى الخُرُوج عَنِ المَوْضُوع الرَّئِيسِيّ) / اِسْتِدْلَالِيّ, خِطَابِيّ (يَصِل إلى نَتيجَة بِالحُجَّة وَالبُرْهان لا بِالحَدْس)",
 "論戦": "مُنَاظَرَة, مُنَاقَشَة (مصدر من ناظَرَ)",
 "論攷": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "論文": "أُطْرُوحَة",
 "論文誌": "رتك المحور, عنق المحور (جزء المحور المحتوي داخل المحمل) / دفتر يومية, سجل (كتاب سجل كشيء مادي) / مذكرات, يوميات (سجل كتابي يومي للتجارب والملاحظات (الشخصية عادة)) / دورية, مجلة علمية (دورية مخصصة لموضوع معين)\nمثال: يقرأ المجلات الطبية",
 "論断": "نَتِيجَة",
 "論決": "نَتِيجَة",
 "論法": "مَنْطِق (عِلْمُ المَنْطِق: هو عِلْم من العلوم البحتة هدفه البَحْث عن قواعد التفكير السَوِية البعيدة عن الخَطَأ. يسمى أيضا بالمِيزان؛ العقل والتفكير السويّ الحكيم)\nمثال: غزة منطقة مكشوفة.",
 "論点先取": "مُصَادَرَة عَلَى الْمَطْلُوب (دُفْعَة مالية منتزَعة عن طريق الحكومة في أوقات الحرب؛ عِقاب موضوعه اِسْتِصْفَاء مال المحكوم عليه واِسْتِيلَاء الدّولة عليه)",
 "論理": "مَنْطِق (عِلْمُ المَنْطِق: هو عِلْم من العلوم البحتة هدفه البَحْث عن قواعد التفكير السَوِية البعيدة عن الخَطَأ. يسمى أيضا بالمِيزان؛ العقل والتفكير السويّ الحكيم)\nمثال: غزة منطقة مكشوفة.",
