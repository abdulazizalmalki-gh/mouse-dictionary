 "足捌き": "خفة حركة, مناورة ذكية (مناورة أو تعامل ماهر)\nمثال: إنها بحاجة إلى بعض المناورة الذكية لتغطية كل تلك الأكاذيب",
 "足掛かり": "ركيزة, موطئ قدم (إنجاز أولي يفتح الطريق لتطورات لاحقة)\nمثال: أصبحت المدينة موطئ قدم في الحملة لحظر التدخين في الهواء الطلق",
 "足掛け": "ركيزة, موطئ قدم (إنجاز أولي يفتح الطريق لتطورات لاحقة)\nمثال: أصبحت المدينة موطئ قدم في الحملة لحظر التدخين في الهواء الطلق",
 "足掛り": "ركيزة, موطئ قدم (إنجاز أولي يفتح الطريق لتطورات لاحقة)\nمثال: أصبحت المدينة موطئ قدم في الحملة لحظر التدخين في الهواء الطلق",
 "足掻き": "مُكَافِح (منخرط في كفاح للتغلب خاصة على الفقر أو الغموض)",
 "足掻く": "كِفَاح, نِضَال\nمثال: 窮地から足掻き出る。 — سوف يتهرب من المأزق. / كِفَاح, نِضَال",
 "足日": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "足早": "عميق\nمثال: صام ياني رمضان. / سَرِيع\nمثال: ينبح كلب في الحي.",
 "足早に": "بخفَة",
 "足枷": "غُلّ, أَغْلال",
 "足根": "رسغي (من أو متعلق بـ أو بالقرب من رسغ القدم)\nمثال: عظام رسغ القدم",
 "足根骨": "رُصُغ",
 "足止め": "حبس, حجز (فعل تقييد حرية شخص ما عن طريق حبسه)\nمثال: حصر العدوى في منطقة بؤرية / تأريض (توصيل المعدات الكهربائية بالأرض)\nمثال: يفتقر إلى التأسيس اللازم للدراسة المتقدمة",
 "足浴": "مغطس قدمين (حوض استحمام صغير لتدفئة أو غسل أو تطهير القدمين)",
 "足湯": "مغطس قدمين (حوض استحمام صغير لتدفئة أو غسل أو تطهير القدمين)",
 "足溜まり": "قاعدة, قاعدة عمليات (منشأة تبدأ منها القوة العسكرية عملياتها)\nمثال: قضى الهجوم على قواعدنا الأمامية",
 "足溜り": "قاعدة, قاعدة عمليات (منشأة تبدأ منها القوة العسكرية عملياتها)\nمثال: قضى الهجوم على قواعدنا الأمامية",
 "足無し井守": "ضفدع ثعباني (أي من البرمائيات الصغيرة النحيلة عديمة الأطراف الحفارة التي تشبه الديدان؛ تعيش…)",
 "足無し蜥蜴": "سحلية عديمة الأرجل (سحلية ضامرة تشبه الدودة تحفر الجحور في كاليفورنيا قريبة الصلة بسحالي القاطور)",
 "足無井守": "ضفدع ثعباني (أي من البرمائيات الصغيرة النحيلة عديمة الأطراف الحفارة التي تشبه الديدان؛ تعيش…)",
 "足無蜥蜴": "سحلية عديمة الأرجل (سحلية ضامرة تشبه الدودة تحفر الجحور في كاليفورنيا قريبة الصلة بسحالي القاطور)",
 "足病医": "أخصائي أقدام, طبيب أقدام (أخصائي في العناية بالقدمين)",
 "足癖": "مشية (طريقة مشي الشخص)",
 "足白癬": "سِعْفَة القَدَم, القَدَم الرِيَاضِي",
 "足立": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "足糸": "بيسوس, خيوط التثبيت (خصلة من الخيوط القوية التي يثبت بها بلح البحر نفسه بسطح ثابت)",
 "足継ぎ": "مِقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "足繁く": "غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة",
 "足繁く通う": "مرتع, مزار (مكان يتردد عليه المرء كثيراً)",
 "足纏い": "حِمْل, عِبْء (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "足置き": "كرسي قدم, مسند للقدمين (مقعد منخفض أو كرسي صغير لراحة قدمي الجالس)",
 "足背": "مشط القدم (جزء الحذاء أو الجورب الذي يغطي قوس القدم)",
 "足腰": "إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\")\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟",
 "足萎え": "ركاكة, ضعف (نقص أو عيب (خاصة في الحجج أو الأعمال الأدبية))\nمثال: كاتب مشهور بركاكة حبكاته",
 "足袋": "تابي (جورب بفاصل لإصبع القدم الكبير؛ يرتديه اليابانيون مع الصنادل)",
 "足触り": "تحسس\nمثال: شعر ماريا طويل.",
 "足趾": "أَثَر قَدَم (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / رِجْل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول…)\nمثال: هذا الرجل تاجر.",
 "足跡": "أَثَر قَدَم (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "足踏み": "مَرْعَى, سْتِيب / توقف, جمود (انقطاع النشاط الطبيعي)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "足踏み状態": "توقف, جمود (انقطاع النشاط الطبيعي)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "足蹠": "وَحِيد\nمثال: سمكة ميناد ماتت",
 "足蹴": "رَفَسَ (رَفَسَهُ ضربه برجله وبابه ضرب؛ الرفْسُ: الصدْمَةُ بالرجْلِ في الصدْرِ…)\nمثال: فريد ركل الكرة.",
 "足蹴にする": "رَفَسَ (رَفَسَهُ ضربه برجله وبابه ضرب؛ الرفْسُ: الصدْمَةُ بالرجْلِ في الصدْرِ…)\nمثال: فريد ركل الكرة.",
 "足蹴り": "رفسة, ركلة (عملية توجيه ضربة بالقدم)\nمثال: وجه للكرة ركلة قوية",
 "足載": "كرسي قدم, مسند للقدمين (مقعد منخفض أو كرسي صغير لراحة قدمي الجالس)",
