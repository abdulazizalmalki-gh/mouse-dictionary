 "豊水": "ذروة المد, مد عالي (المد عندما يكون الماء في أعلى مستوياته)",
 "豊水期": "موسم الأمطار (أحد الموسمين في المناخات الاستوائية، وهي فترة سنوية يحدث فيها معظم هطول الأمطار في بلد ما)",
 "豊沃": "خُصُوبَة",
 "豊満": "بَادِن, مُمْتَلِئ الجِسْم (تَعْبِيرات مُلَطَّفَة لِلدَّلَالَة عَلَى البَدَانَة) / صَلْبٌ, وَفِيٌّ (يُعتمد عليه ولا يتراجع) / صُلْب, قَوِيُّ البُنْيَة (ذو قوة بدنية متينة؛ متمرّس على التعب والمشقّة) / بدين, ممتلئ (مقاس ملابس لشخص كبير أو ثقيل الوزن)",
 "豊潤": "وافِر, وَفِير",
 "豊田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "豊福": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "豊穣の角": "قرن الوفرة (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "豊臣": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "豊艶": "أَبِيقُورِيّ, مُتَرَفّ (يعرض الترف ويُمتِّع الحواسّ) / فَاتِن, مُغْرٍ جِنْسِيًّا (ذو جاذبية جنسية قوية) / ذَات قَوَام مُنْحَنٍ, مُمْتَلِئَة ((عن جسد المرأة) ذات صدر كبير وانحناءات جذّابة)",
 "豊葦原": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "豊葦原の瑞穂の国": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "豊葦原中国": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)",
 "豊葦原瑞穂国": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "豊饒": "خَصِب (خَصِبَ يَخْصَبُ خِصْبًا: كثر فيه العشب والكلأُ؛ فهو خَصِبٌ، وخَصِيبٌ)\nمثال: التربة في قريتنا جدا خصبة لزراعة كافة المحاصيل.",
 "豊饒の角": "قرن الوفرة (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "豊麗": "غَنِيّ",
 "豊麗線": "بيت القصيد, خاتمة النكتة (مغزى نكتة أو قصة فكاهية) / تجاعيد الضحك, قدم الغراب (تجعد في الجلد عند الزاوية الخارجية للعينين)",
 "豊齢線": "بيت القصيد, خاتمة النكتة (مغزى نكتة أو قصة فكاهية) / تجاعيد الضحك, قدم الغراب (تجعد في الجلد عند الزاوية الخارجية للعينين)",
 "豌豆": "بَازِلَّاء",
 "豎子": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / مراهق, يافع (حدث في المرحلة بين بداية البلوغ والنضج)",
 "豕": "خِنْزِير / خَنْزِير بَرِيّ / خِنْزِير / حَلُوف / خنزير / حلوف / خَنْزير",
 "豚": "خِنْزِير / حَلُوف / خنزير / حلوف / خَنْزير / لَحْم الْخِنْزِير (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر. / بدين, سمين (شخص مستدير الجسم)",
 "豚の饅頭": ":بخور مريم",
 "豚インフルエンザ": "إنفلونزا الخنازير (مرض تنفسي حاد وشديد العدوى يصيب الخنازير يسببه فيروس أورثوميكسو يُعتقد أنه نفس الفيروس الذي تسبب في جائحة الإنفلونزا عام 1918)",
 "豚コレラ": "كوليرا الخنازير (مرض فيروسي شديد العدوى يصيب الخنازير)",
 "豚フル": "إِنْفْلُوَنْزَا خَنَازِير",
 "豚ロース": "خاصرة خنزير (لحم من خاصرة الخنزير)",
 "豚児": "خِنَّوْص",
 "豚小屋": "زَرِيبَةُ خَنَازِير\nمثال: この部屋はまるで豚小屋だな。 — تبدو هذه الغرفة كحظيرة الخنازير.",
 "豚熱": "كوليرا الخنازير (مرض فيروسي شديد العدوى يصيب الخنازير)",
 "豚犬": "ثقيل الظل, شخص ممل (شخص يبعث على الملل) / أحمق, بليد (شخص ليس ذكياً جداً)\nمثال: إنه الاقتصاد يا غبي!",
 "豚箱": "إقفال, إيصاد (فعل قفل شيء ما لحمايته) / توقيف, حجز (سجن في مركز شرطة محلي)",
 "豚肉": "لَحْم الْخِنْزِير (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "豚肉商": "جزار لحم خنزير (بائع لحم الخنزير والمنتجات المصنوعة منه)",
 "豚脂": "شَحْم, دُهْن خِنْزِير",
 "豚舎": "خم خنازير, زريبة خنازير (حظيرة للخنازير)",
 "豚芋": "أرضي شوكي قدسي, خرشوف قدسي (درنة دوار الشمس تؤكل نيئة أو مسلوقة أو مقطعة إلى شرائح رقيقة ومقلية) / أرضي شوكي, خرشوف القدس (نبات معمر طويل بسيقان وأوراق مشعرة؛ يزرع على نطاق واسع لدرناته الكبيرة غير المنتظمة الصالحة للأكل) / خرشوف القدس, طرطوفة (درنة صالحة للأكل لخرشوف القدس)",
 "豚草": "أمبروزية, دمسيسة (أي من العديد من النباتات الضارة في أمريكا الشمالية التي تشكل جنس الأمبروزية والتي تنتج حبوب لقاح مسببة للحساسية الشديدة المسؤولة عن الكثير من حمى…) / شيخة متكاملة الأوراق, شيخة يعقوبية (عشب ضار أوروبي واسع الانتشار له أزهار صفراء تشبه الأقحوان؛ أحياناً يكون عشباً ضاراً بغيضاً وساماً للماشية إذا استهلك بكميات كبيرة)",
 "豚菜": "أذن القط, هندباء خنزيرية (عشب ضار أوروبي مستوطن على نطاق واسع في أمريكا الشمالية له رؤوس زهرية صفراء وأوراق تشبه أذن القط) / أذن القط (أي من النباتات العديدة من جنس كالوشورتوس ذات أزهار ببتلات على شكل آذان القطط)",
 "豚飼い": "راعي خنازير (راعي للخنازير)",
 "豚鼻蝙蝠": "الْعَالَم الْقَدِيم",
 "象": "صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / فِيل, فيل (حيوان ثديي آكل أعشاب، وهو أكبر الحيوانات الأرضية الحية؛ (في الشطرنج) قطعة من قطع الشطرنج تتحرك بشكل قطري، ورمزها \"♗\" أو \"♝\")\nمثال: لدى الفيل أنف طويل.",
 "象る": "مَثَّلَ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "象亀": "سلحفاة عملاقة (سلاحف كبيرة جداً من جزر غالاباغوس وسيشيل)",
 "象嵌": "ترصيع, تطعيم (زينة تُصنع عن طريق تركيب قطع من الخشب في فتحات مجهزة في سطح ما) / حشوة مصبوبة ((طب الأسنان) حشوة تتكون من مادة صلبة (مثل الذهب أو البورسلين) يتم تركيبها في تجويف في السن وتثبيتها في مكانها)",
 "象形": "هيروغليفي (مكتوب بـ أو ينتمي إلى نظام كتابة يستخدم رموزاً تصويرية) / هيروغليفي الشكل (يشبه الكتابة الهيروغليفية) / كتابة هيروغليفية, هيروغليفية (نظام كتابة يستخدم رموزاً صورية؛ استُخدم في مصر القديمة) / كتابة هيروغليفية (كتابة تشبه الهيروغليفية (عادة لكونها غير مقروءة)) / بيكتوغراف, رمز تصويري (رمز رسومي يُستخدم في الكتابة التصويرية)",
 "象形文字": "هِيرُوغْلِيفِيَّة",
 "象徴": "رَمْز, عَلَامَة (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "象徴主義": "رَمْزِيَّة",
 "象徴派": "رمزي, فنان رمزي (عضو في حركة فنية عبرت عن الأفكار بشكل غير مباشر عبر الرموز) / رمزياتي, مفسر الرموز (شخص ماهر في تفسير أو تمثيل الرموز)",
 "象徴的": "رَمْزِيّ, شِعَارِيّ (يعمل كرمز مرئي لشيء مجرد) / رمزي (متعلق بـ أو يستخدم أو يمضي عن طريق الرموز) / رمزي (يستخدم الرمزية)\nمثال: منطق رمزي",
 "象海豹": "فيل البحر (أي من نوعين من الفقمات الكبيرة عديمة الأذن في شمال المحيط الأطلسي لها خطم يشبه الخرطوم)",
 "象牙": "عَاج (مادة ثمينة تُصنع من أنياب الفيل، وتتواجد غالبًا في قارة إفريقيا، وبعض دول شرق آسيا؛ حاليًّا، يُمنع اصطياد الفيلة من أجل أنيابها في معظم الدول) / عَاجِيّ / عَاجِيَّة",
 "象牙の塔": "برج عاجي (حالة ذهنية تُناقش وكأنها مكان (منعزل عن الواقع))\nمثال: عاش في البرج العاجي للتأملات",
 "象牙椰子": "نخيل العاج (نخلة عديمة الساق من البرازيل وبيرو تحمل مكسرات العاج)",
 "象牙海岸": "كُوت دِيفْوَار, كُوت دِيڤْوَار",
 "象牙質": "عاج (عظم (نسيج متكلس) يحيط بتجويف لب السن) / دنتين, عاج الأسنان (مادة كلسية أصلب وأكثر كثافة من العظم تشكل الجزء الأكبر من السن)",
 "象牙鴎": "نورس عاجي (نورس قطبي أبيض؛ يهاجر جنوباً حتى إنجلترا ونيو برونزويك)",
 "象皮病": "داء الفيل (تضخم أجزاء معينة من الجسم (عادة الساقين وكيس الصفن)؛ المرحلة النهائية لمرض داء الفيلاريات)",
 "象眼": "ترصيع, تطعيم (زينة تُصنع عن طريق تركيب قطع من الخشب في فتحات مجهزة في سطح ما) / حشوة مصبوبة ((طب الأسنان) حشوة تتكون من مادة صلبة (مثل الذهب أو البورسلين) يتم تركيبها في تجويف في السن وتثبيتها في مكانها)",
 "象虫": "سوسة (أي من عدة فصائل من الخنافس الصغيرة غالباً التي تتغذى على النباتات والمنتجات النباتية؛ وخاصة خنافس الخطم وخنافس البذور)",
 "象貌": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "象限": "ربعية, مقياس الارتفاع (أداة قياس لقياس ارتفاع الأجرام السماوية) / ربع دائرة (المساحة المحصورة بين نصفي قطرين متعامدين لدائرة) / ربع (أي من المناطق الأربع التي ينقسم إليها المستوى بواسطة محوري إحداثيات متعامدين) / ربع دائرة (ربع محيط الدائرة)",
 "象限儀": "ربعية, مقياس الارتفاع (أداة قياس لقياس ارتفاع الأجرام السماوية) / ربع دائرة (المساحة المحصورة بين نصفي قطرين متعامدين لدائرة) / ربع (أي من المناطق الأربع التي ينقسم إليها المستوى بواسطة محوري إحداثيات متعامدين) / ربع دائرة (ربع محيط الدائرة)",
 "象鳥": "طائر الفيل (طائر ضخم (يصل إلى 9 أقدام) منقرض لا يطير من مدغشقر)",
 "豪": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة. / عَظِيم, هَائِل (كبير بشكل استثنائي في الحجم أو المدى أو الكمية أو القوة أو الدرجة) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف) / شَدِيد, مَهُول (بالغ في الدرجة أو المدى أو المقدار أو التأثير) / أُسْتُرَالِيَا, أستراليا (دولة في أوقيانوسيا؛ اسمها الرسمي كومنولث أستراليا؛ (في الجيولوجيا) قارة أستراليا-غينيا الجديدة؛ تُعتبر غينيا الجديدة أيضًا جزءًا من قارة أستراليا جيولوجيًّا بما أنها تقع على الصفيحة التكتونية…) / أُسْتُرَالِيَا, أُوسْتُرَالِيَا (دولة في أوقيانوسيا؛ اسمها الرسمي كومنولث أستراليا؛ (في الجيولوجيا) قارة أستراليا-غينيا الجديدة؛ تُعتبر غينيا الجديدة أيضًا جزءًا من قارة أستراليا جيولوجيًّا بما أنها تقع على الصفيحة التكتونية…)\nمثال: جين من أستراليا.",
 "豪の者": "مُحَارِب قَدِيم",
 "豪ドル": "دُولَار أُسْتْرَالِىّ",
 "豪健": "بَاسِل, جَسُور (لا يهاب الخوف أو الترهيب) / صُلْب, قَوِيُّ البُنْيَة (ذو قوة بدنية متينة؛ متمرّس على التعب والمشقّة) / مُتَحَمِّلٌ لِلظُّرُوف (قادر على البقاء في ظروف مناخية غير ملائمة)",
 "豪傑": "بَطَل, بَطَلَة",
 "豪儀": "رَائِع, عَظِيم / عَظِيم, كَبِير (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم. / مُتَعَنِّت, عَنِيد",
 "豪勇": "شَجَاعَة",
 "豪勢": "جَلِيل, فَخْم (يُوصَف بِهِ مَظْهَر الشَّخْص أَوْ سُلُوكه؛ يَلِيق بِشَخْصٍ بَارِز) / فَخْم, كَبِير (الأكثر أهمّيّة وفخامة في الزخرفة) / طَمُوح, وَاسِع النِّطَاق (من السلوك المُثير للإعجاب والطموح في الحجم أو النطاق) / عَظِيم, فَخْم (كبير ومثير للإعجاب في الحجم المادي أو الامتداد) / رَائِع, عَظِيم / عَظِيم, كَبِير (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم.",
 "豪壮": "أُبَّهَة, رَوْعَة (صفة كون الشيء رائعاً أو فاخراً أو عظيماً) / بهاء, تألق (جودة تتفوق في لمعانها على المعتاد)\nمثال: بالنسبة للفخامة والخدمة الشخصية",
 "豪奢": "فَخْم",
 "豪宕": "غير مكبوت, متحرر (غير مكبوت أو مقيد)\nمثال: حيوية غير مكبوتة",
 "豪州": "أُسْتُرَالِيَا, أستراليا (دولة في أوقيانوسيا؛ اسمها الرسمي كومنولث أستراليا؛ (في الجيولوجيا) قارة أستراليا-غينيا الجديدة؛ تُعتبر غينيا الجديدة أيضًا جزءًا من قارة أستراليا جيولوجيًّا بما أنها تقع على الصفيحة التكتونية…) / أُسْتُرَالِيَا, أُوسْتُرَالِيَا (دولة في أوقيانوسيا؛ اسمها الرسمي كومنولث أستراليا؛ (في الجيولوجيا) قارة أستراليا-غينيا الجديدة؛ تُعتبر غينيا الجديدة أيضًا جزءًا من قارة أستراليا جيولوجيًّا بما أنها تقع على الصفيحة التكتونية…)\nمثال: جين من أستراليا.",
 "豪州統計局": "أكريلونتريل بوتادين ستايرين, بلاستيك إيه بي إس (فئة من البلاستيك المركب تستخدم لصنع هياكل السيارات وحافظات الحواسيب والأجهزة الأخرى)",
 "豪快": "حَمِيم, عَمِيق (عميق الإحساس وصادق المشاعر) / جَلْد, قَوِيّ (ذو صِحَّة قَوِيَّة وطاقَة عالِيَة) / فَتِيّ, مِلْؤُه الحَيَوِيَّة (مَليء بِالقُوَّة والنَّشاط والحَيَوِيَّة الدَّمَوِيَّة) / حَارّ, صَادِق (يُظهر ودًّا حارًّا وصادقًا نابعًا من القلب)",
 "豪放": "إِفْرَنْجِيّ",
 "豪毅": "ثبات, جلد (قوة العقل التي تمكن المرء من تحمل المحن بشجاعة)",
 "豪気": "جَرِيء, جَسُور / رَائِع, عَظِيم / عَظِيم, كَبِير (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم. / مُتَعَنِّت, عَنِيد",
 "豪然": "مُتَعَالٍ, الْمُتَعَالِي",
 "豪球": "كرة سريعة ((بيسبول) رمية ترمى بأقصى سرعة)\nمثال: تأخر في ضرب الكرة السريعة",
 "豪的": "رَائِع, عَظِيم / عَظِيم, كَبِير (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم.",
 "豪盛": "جَلِيل, فَخْم (يُوصَف بِهِ مَظْهَر الشَّخْص أَوْ سُلُوكه؛ يَلِيق بِشَخْصٍ بَارِز) / فَخْم, كَبِير (الأكثر أهمّيّة وفخامة في الزخرفة) / طَمُوح, وَاسِع النِّطَاق (من السلوك المُثير للإعجاب والطموح في الحجم أو النطاق) / عَظِيم, فَخْم (كبير ومثير للإعجاب في الحجم المادي أو الامتداد) / رَائِع, عَظِيم / عَظِيم, كَبِير (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم.",
 "豪胆": "جَرِيء, جَسُور",
 "豪腹": "عِنَاد",
 "豪華": "مُسْرِف",
 "豪華客船": "سفينة فاخرة (سفينة ركاب مجهزة لحياة الترف)",
 "豪華絢爛": "عَظِيم, رَائِع (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم.",
 "豪華船": "سفينة فاخرة (سفينة ركاب مجهزة لحياة الترف)",
 "豪語": "تباهي, تفاخر (الحديث عن النفس بصيغ التفخيم) / اَلْإِنْجِلِيزِيَّة الْأُسْتُرَالِيَّة",
 "豪邁": "إقدام, جسارة (شجاعة حازمة)",
 "豪雨": "طوفان, هطول غزير (مطر غزير)",
 "豪飲": "خَمْرِيّ, عَرْبَدِيّ (يُوصَف بِهِ العَرْبَدَة وَالسُّكْر الصَّاخِب)",
 "豬": "خِنْزِير",
 "豹": "نِمْر (النّمر: حيوان مرقّط يُشبه الأَسَد؛ النّمر: لونه أنمر، وفيه نُمر حمراء أو بيضاء وسوداء) / نَمِر (النّمر: حيوان مرقّط يُشبه الأَسَد؛ النّمر: لونه أنمر، وفيه نُمر حمراء أو بيضاء وسوداء) / فَهْد\nمثال: دخل نمر مخيمنا.",
 "豺狼": "ذِئْب (حيوان مفترس من فصيلة الكلاب يعيش في جماعات وأكثر ما يصطاد في الليل؛ صفة تطلق على الرجل الذي يخدع النساء ليحصل على مراده منهن بالدهاء) / ديب / ذيب / اِلْتَهَمَ بِشَرَاهَة\nمثال: نظرة الذئب للشاة.",
 "貂": "دَلَق, خَزّ (صب وأراق؛ خرج سريعًا)",
 "貂熊": "شَرِه, وُلْفِيرِين ((شَرِهَ) إلى الطعام وغيره، وشَرِهَ عليه يَشْرَهَ شَرَهًا: اشتد حرصُه عليه واشتِهاؤه له؛ فهو شَرِهٌ وشَرْهَانُ، وهي شَرِهة وشَرْهَى)\nمثال: كانت صوفيا شرهة.",
 "貉": "غُرَيْر / كلب الراكون (كلب بري صغير من شرق آسيا له علامات وجه تشبه علامات الراكون)",
 "貒": "غُرَيْر / كلب الراكون (كلب بري صغير من شرق آسيا له علامات وجه تشبه علامات الراكون)",
 "貝": "مَحَار / صَدَفَة, صَدَفَة بَحْرِيَّة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة. / دُوَّامَة, بُلْبُل",
 "貝がら": "صَدَفَة, صَدَفَة بَحْرِيَّة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة.",
 "貝になる": "صَمَتَ, سَكَتَ",
 "貝ボタン": "عِرْق اللُّؤْلُؤ, زِلْف (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "貝合せ": "سحاق تداككي (شكل من أشكال السحاق يحاكي الجماع الغيري)",
 "貝合わせ": "سحاق تداككي (شكل من أشكال السحاق يحاكي الجماع الغيري)",
 "貝塚": "تلة نفايات أثرية ((علم الآثار) كومة من النفايات المنزلية تحتوي على أصداف وعظام حيوانات تحدد موقع مستوطنة ما قبل التاريخ)",
 "貝寄": "رياح غربية (رياح تهب من الغرب إلى الشرق)",
 "貝寄せ": "رياح غربية (رياح تهب من الغرب إلى الشرق)",
 "貝寄風": "رياح غربية (رياح تهب من الغرب إلى الشرق)",
 "貝本": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "貝柱": "عضلة مقربة (عضلة تسحب جزءاً من الجسم باتجاه الخط الناصف)",
 "貝殻": "صَدَفَة, صَدَفَة بَحْرِيَّة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة.",
 "貝殻虫": "حشرة قشرية (حشرة صغيرة من رتبة متشابهات الأجنحة تعيش وتتغذى عادة على النباتات وتفرز غطاء شمعياً واقياً)",
 "貝殻追放": "إقصاء, نبذ اجتماعي (فعل استبعاد شخص من المجتمع بإجماع عام) / إبعاد, نبذ (حالة النفي أو النبذ (الاستبعاد من المجتمع بموافقة عامة))\nمثال: يجب على الجمعية التخلص من أعضائها المسنين - ليس عن طريق القتل الرحيم بالطبع، ولكن عن طريق النبذ",
 "貝殻骨": "لَوْح اَلْكَتِف, عَظْم كَتِفِيّ",
 "貝殼": "صَدَفَة, صَدَفَة بَحْرِيَّة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة.",
 "貝母": "بُوقِيَّة, عَرَار",
 "貝紫": "أرجواني صوري (لون أحمر أرجواني زاهٍ؛ كان يرتديه الأباطرة في روما القديمة وبيزنطة) / أرجوان صور, أرجوان صوري (صبغة حمراء أرجوانية إلى أرجوانية عميقة يتم الحصول عليها من القواقع أو صنعها صناعياً)",
 "貝紫色": "أرجواني صوري (لون أحمر أرجواني زاهٍ؛ كان يرتديه الأباطرة في روما القديمة وبيزنطة) / أرجوان صور, أرجوان صوري (صبغة حمراء أرجوانية إلى أرجوانية عميقة يتم الحصول عليها من القواقع أو صنعها صناعياً)",
 "貝類": "مَحَار",
 "貝類学": "جمع الأصداف, علم الأصداف (جمع ودراسة أصداف الرخويات)",
 "貞": "عِفَّة, طَهَارَة",
 "貞実": "وَفِيّ, مُخْلِص / أَمِين (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "貞操": "عِفَّة, طَهَارَة",
 "貞操堅固": "عَفِيف, زَكِيّ",
 "貞操蹂躙": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "貞操蹂躪": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "貞本": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "貞淑": "عِفَّة, طَهَارَة",
 "貞潔": "عِفَّة, طَهَارَة",
 "貞節": "عِفَّة, طَهَارَة",
 "負": "سَلْبِيّ / سَلْبِيّ, سَالِب / مَنْفِيّ / سَالِب / صُورَة سَالِبَة",
 "負い": "إِضَافِيّ, زَائِد (أكثر من اللازم أو مُضاف إلى ما هو موجود) / بشكل إضافي, بشكل استثنائي (بشكل غير عادي أو استثنائي) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إِضَافِيّ, خَاصّ (مضاف إلى الجدول المنتظم)\nمثال: سيارة سريعة بشكل استثنائي",
 "負い目": "الْتِزَام, دَيْن (علاقة شخصية يكون فيها المرء مدينًا بخدمة أو معروف) / التزام مالي, دين (التزام بدفع المال لطرف آخر)",
 "負い革": "مِقْلَاع / حَمَّالَة",
 "負う": "دُبّ / دُبَّة / اِحْتَمَلَ / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي. / تَأَلَّمَ, عَانَى / عَانَى (قَاسَى وكابد؛ الشيءَ: ملابسته ومباشرته)\nمثال: لقد عانى جمال كثيرا.",
 "負かす": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "負け": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة / خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "負けぎらい": "عَنِيد, لا يَلِين (لا يَتَراخى ولا يَنْثَنِي تَحْت الضَّغْط) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)",
 "負けじと": "بِإِصْرَار, بِعَزْم (إظهار تصميم أو هدف حازم) / بِتَصْمِيم, بِحَزْم (بثبات الهدف)\nمثال: رفضت بحزم النظر إليه أو التحدث معه",
 "負けずぎらい": "عَنِيد, لا يَلِين (لا يَتَراخى ولا يَنْثَنِي تَحْت الضَّغْط) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)",
 "負けず劣らず": "بِالتَّسَاوِي",
 "負けず嫌い": "عَنِيد, لا يَلِين (لا يَتَراخى ولا يَنْثَنِي تَحْت الضَّغْط) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)",
 "負けないくらい": "قَدْر اَلْمُسْتَطَاع, قَدْر اَلْإِمْكَان (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "負けないぐらい": "قَدْر اَلْمُسْتَطَاع, قَدْر اَلْإِمْكَان (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "負けに不思議の負けなし": "هُنَاك, يُوجَد",
 "負ける": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته. / أَذْعَنَ ((أَذْعَنَ): انْقَادَ وسلس وَيُقَال: أذعن بِالْحَقِّ: أقرّ بِهِ)",
 "負け嫌い": "عَنِيد, لا يَلِين (لا يَتَراخى ولا يَنْثَنِي تَحْت الضَّغْط) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)",
 "負け惜しみ": "حِصْرِم",
 "負け犬": "خَاسِر / فَاشِل",
 "負け知らず": "لَا يُغْلَب, لَا يُقْهَر (لَا يُمْكِنُ هَزِيمَتُهُ أَوْ إِخْضَاعُهُ) / عَصِيٌّ عَلَى الهَزِيمَة, لَا يُقْهَر (يصعب التغلّب عليه أو هزيمته)",
 "負け組": "خَاسِر / فَاشِل",
 "負け組み": "خَاسِر / فَاشِل",
 "負のスパイラル": "حلقة مفرغة, دور منطقي (حجة تفترض صحة ما يراد إثباته) / حلقة مفرغة, دائرة خبيثة (مشكلة تؤدي إلى أخرى تفاقم الأولى)",
 "負の所得税": "صُغْبَة",
 "負の数": "عَدَد سَالِب (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "負の連鎖": "تأثير الدومينو",
 "負の電荷": "شحنة سالبة (وجود فائض من الإلكترونات؛ وجود جهد كهربائي أقل)",
 "負ぶい紐": "مِقْلَاع / حَمَّالَة",
 "負ぶう": "أبوش, حمل على الظهر (عملية حمل شخص أو شيء على الظهر) / أوباً, على الظهر (على الظهر أو الكتفين أو الركوب على الورك) / محمولاً (على عربة مسطحة للسكك الحديدية (شحن الحاويات))\nمثال: حملت طفلها على ظهرها",
 "負んぶ紐": "مِقْلَاع / حَمَّالَة",
 "負値性": "سلبية كهربائية ((كيمياء) ميل الذرة أو الجذر لجذب الإلكترونات في تكوين رابطة أيونية) / سلبية (كمية أقل من الصفر) / سلبية (صفة تتميز بالشك المعتاد والميل لإنكار أو معارضة أو مقاومة الاقتراحات أو الأوامر) / سَلْبِيَّة (طبيعة القطب الكهربائي السالب)",
 "負債": "دَيْن (العِبَادَة والتَقْدِيْس؛ المَذْهَب) / دَيْن, قَرْض (العِبَادَة والتَقْدِيْس؛ المَذْهَب)\nمثال: الإسلام دين حق.",
 "負債比率": "نِسْبَة الدَّيْن (مقياس لإجمالي ديون الشركة بالنسبة لإجمالي أصولها)\nمثال: تشير نسبة الدين إلى مدى خطورة قيام البنك بمنح قرض لشركة ما",
 "負債者": "مَدِين",
 "負傷": "جُرْح, إِصَابَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح.",
 "負動産": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "負号": "نَاقَص",
 "負担": "حِمْل, عِبْء (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه. / رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة) / رسم شعار النبالة, شحنة (شعار النبالة المتمثل في تصميم أو صورة مرسومة على درع) / سلوك, هيئة (أسلوب أو سلوك وقور) / قوام, هيئة (طريقة مميزة لحمل الجسم)\nمثال: وقف بوضعية جيدة",
 "負担をかける": "ضَرِيبَة",
 "負担を掛ける": "ضَرِيبَة",
 "負担増": "ارتفاع, زيادة (زيادة في التكلفة)\nمثال: طلبوا زيادة بنسبة 10% في الأسعار",
 "負担感": "حِمْل, عِبْء (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "負担重量": "حجر الارتكاز (أدنى حجر في القوس الذي يبدأ منه القوس) / جمارك, مكوس (الأموال المحصلة بموجب التعريفة الجمركية)",
 "負数": "عَدَد سَالِب (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "負極": "مِصْعَد / أَنُود",
 "負符号": "نَاقَص",
 "負組": "خَاسِر / فَاشِل",
 "負荷": "حِمْل, عِبْء (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه. / حِمْل (رَفَعَ، أَقَلَّ) / عَبَّأَ, شَحَنَ\nمثال: حمل سامي سلاحه. / اختبار الإجهاد (اختبار يقيس كيفية عمل نظام ما عند تعرضه لكميات محددة من الضغط)",
 "負荷テスト": "اختبار الإجهاد (اختبار يقيس كيفية عمل نظام ما عند تعرضه لكميات محددة من الضغط)",
