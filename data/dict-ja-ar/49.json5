 "譲渡担保": "رَهْن, رَهْن عَقَارِيّ ((رَهَنَ) الشيءُ يَرْهَنُ رهْنًا، ورُهُونا: ثَبَت ودامَ؛ يقال (رَهَنَ) بالمكان: أقامَ)\nمثال: رهن فاضل الحلي.",
 "譲渡益": "أرباح رأسمالية, مكاسب رأسمالية (المبلغ الذي يتجاوز به سعر بيع الأصل سعر الشراء؛ يتحقق الربح عند بيع الأصل)",
 "譲許": "امتياز (عقد يمنح الحق في تشغيل عمل فرعي) / إذعان, تنازل (فعل التنازل أو الإذعان) / تنازل (نقطة يتم التنازل عنها أو التسليم بها)\nمثال: حصل على امتياز البيرة في ملعب الكرة",
 "譴責": "عَزْر / توبيخ ;تقريع",
 "護り": "حِمَايَة / بروفيدنس / تَمِيمَة, أُخْذَة",
 "護り手": "وَلِي أَمْر, حَافِظ (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ) / حَارِس\nمثال: ولي العهد هو من يرث العرش. / سَاعَة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن) / حَارِس / رَصَدَ (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس) / حَذِرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: درست لمدة ساعة.",
 "護拳": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "護持": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "護教論": "دِفَاعِيَّات",
 "護民官": "مِنْبَر, مِنْصَّة",
 "護照": "جَوَاز سَفَر, إِجَازَة مُرُور",
 "護符": "طِلَسْم, طِلَّسْم",
 "護衛": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "護衛艦": "مُدَمِّر",
 "護衛駆逐艦": "مدمرة مرافقة (سفينة حربية أصغر من المدمرة؛ مصممة لمرافقة الأساطيل أو القوافل)",
 "護身": "دفاع عن النفس (فعل الدفاع عن نفسك)",
 "護身用": "دِفَاع عَنِ النَّفْسِ",
 "護身用スプレー": "دفاع عن النفس (فعل الدفاع عن نفسك)",
 "護送": "مُرَافَقَة",
 "護送船団": "قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها)\nمثال: الكلاب تنبح، والقافلة تسير.",
 "護送車": "بوكس الشرطة, عربة الشرطة (شاحنة مغلقة تستخدمها الشرطة لنقل السجناء)",
 "讃": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى / نَقْش (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "讃える": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "讃する": "صَدَّقَ, وَافَقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع) / اِسْتَحَسَنَ, وَافَقَ (عَدَّه حَسَنا بمعنى جميل؛ عدَّه حسنًا بمعنى جَيِّد) / وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: صدق سامي كل شيء. / مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "讃井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "讃嘆": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "讃岐": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "讃歌": "تَأْبِين, أُمْدُوحَة / ثَنَاء, أُمْدُوحَة",
 "讃歎": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى / مَوْعِظَة, خُطْبَة / مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى / إِشَاعَة, شَائِعَة",
 "讃美": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "讃美歌": "تَرْتِيلَة, تَرْنِيمَة",
 "讃談": "مَوْعِظَة, خُطْبَة / مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى / إِشَاعَة, شَائِعَة",
 "讃賞": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "讃辞": "تَأْبِين, أُمْدُوحَة / ثَنَاء, أُمْدُوحَة",
 "讎敵": "عدو لدود (عدو يريد قتلك)",
 "讐": "عدو (خصم مسلح (خاصة عضو في قوة عسكرية معادية)) / خصم, عدو (عدو شخصي)\nمثال: يجب أن يكون الجندي مستعداً لقتل أعدائه / مرارة / ضَرَرٌ / ضَرَّ أَضَرَّ",
 "讐敵": "عدو لدود (عدو يريد قتلك)",
 "讒": "تَشْهِير, اِفْتِرَاء",
 "讒する": "تَشْهِير, اِفْتِرَاء",
 "讒口": "تَشْهِير, اِفْتِرَاء",
