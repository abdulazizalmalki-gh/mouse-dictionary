 "魚族": "سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / سَمَك, سمك (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك) / صَادَ\nمثال: سمكة ميناد ماتت",
 "魚梯": "سلم الأسماك (سلسلة من الأحواض الصاعدة توفر ممرًا لسمك السلمون للسباحة عكس التيار متجاوزًا سدًا)",
 "魚油": "زَيْت السَّمَك (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن)\nمثال: خبأن ذلك الزيت.",
 "魚眼レンズ": "عدسة واسعة الزاوية (عدسة كاميرا ذات زاوية رؤية أوسع من المعتاد (وعادةً بعد بؤري قصير))",
 "魚種": "نوع سمكي (نوع من الأسماك)",
 "魚竜": "إكتيوصور (أي من الزواحف البحرية المتعددة من حقبة الحياة الوسطى لها جسم يشبه خنزير البحر مع زعانف ظهرية وذيلية وأطراف على شكل مجداف)",
 "魚籠": "سلة صيد السمك (سلة خوص يستخدمها الصيادون لحفظ السمك)",
 "魚粉": "مسحوق السمك (سمك مجفف مطحون يستخدم كسماد وعلف للماشية المنزلية)",
 "魚粕": "مسحوق السمك (سمك مجفف مطحون يستخدم كسماد وعلف للماشية المنزلية)",
 "魚精": "بطروح, مني السمك (السائل المنوي الذي تنتجه ذكور الأسماك) / سرء, مني السمك (حيوانات منوية للسمك أو غدة تناسلية ممتلئة بالحيوانات المنوية؛ لها قوام كريمي)",
 "魚綱": "بُرْج اَلْحُوت, اَلْحُوت (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "魚網": "شَبَكَة صَيْد",
 "魚膠": "ميكا (أي من المعادن المختلفة المكونة من سيليكات مائية للألمنيوم أو البوتاسيوم وغيرها والتي تتبلور في أشكال تسمح بانقسامها إلى أوراق رقيقة جداً)",
 "魚菜": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له)",
 "魚貝": "مَأْكُولَات بَحْرِيَّة, طَعَام الْبَحْر",
 "魚貝類": "مَأْكُولَات بَحْرِيَّة, طَعَام الْبَحْر",
 "魚道": "سلم الأسماك (سلسلة من الأحواض الصاعدة توفر ممرًا لسمك السلمون للسباحة عكس التيار متجاوزًا سدًا)",
 "魚醤": "صلصة السمك, صوص السمك",
 "魚醤油": "صلصة السمك, صوص السمك",
 "魚釣": "صَيْد سَمَك, صَيْد",
 "魚釣り": "صَيْد سَمَك, صَيْد",
 "魚雷": "طُرْبِيد",
 "魚雷発射管": "أنبوب طوربيد (أنبوب بالقرب من خط الماء للسفينة يتم من خلاله إطلاق الطوربيد)",
 "魚雷艇": "قارب طوربيد (سفينة حربية صغيرة عالية السرعة مصممة لهجمات الطوربيد في المياه الساحلية)",
 "魚類": "سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / سَمَك, سمك (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك) / صَادَ\nمثال: سمكة ميناد ماتت",
 "魚類学": "عِلْم اَلْأَسْمَاك (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "魚鱗": "فِلْس, قِشْرَة سَمَك (حرشفة من النوع الذي يغطي أجسام الأسماك)",
 "魚鱗癬": "سماك (أي من العديد من الأمراض الخلقية التي يكون فيها الجلد جافاً ومتقشراً مثل السمكة)",
 "魚龍": "إكتيوصور (أي من الزواحف البحرية المتعددة من حقبة الحياة الوسطى لها جسم يشبه خنزير البحر مع زعانف ظهرية وذيلية وأطراف على شكل مجداف)",
 "魞": "جِرَابِيُّ الشَّكْل, كِيسِيّ (على شكل جراب أو كيس)",
 "魣": "باراكودا, عقام",
 "魯": "رُوسِيَا (دولة يقع جزء منها في شمال شرق أوروبا، والجزء الأكبر في شمال آسيا؛ اسمها الرسمي الاتحاد الروسي، وعاصمتها موسكو، وهي أكبر دولة في العالم من حيث المساحة)\nمثال: زوجتي من روسيا. / لوتيشيوم (عنصر فلزي ثلاثي التكافؤ من مجموعة الأتربة النادرة)",
 "魯国": "رُوسِيَا (دولة يقع جزء منها في شمال شرق أوروبا، والجزء الأكبر في شمال آسيا؛ اسمها الرسمي الاتحاد الروسي، وعاصمتها موسكو، وهي أكبر دولة في العالم من حيث المساحة)\nمثال: زوجتي من روسيا.",
 "魯鈍": "حماقة, غباء (خطأ سخيف) / بلاهة (تخلف عقلي أشد من البله ولكن ليس بشدة العته)",
 "魳": "باراكودا, عقام",
 "魴鮄": "السمكة الطيارة, روبن البحر (غرنار أمريكي؛ يوجد غالباً في الخلجان ومصبات الأنهار)",
 "鮃": "فلاوندر (أي من الأسماك المفلطحة البحرية الأوروبية وغير الأوروبية المختلفة) / سمك الهلبوت (لحم أي من الأسماك المفلطحة الأمريكية والأوروبية المختلفة) / ذَيْل, ماسِح الجُوخ (شخص يحاول إرضاء شخص ما من أجل الحصول على ميزة شخصية)",
 "鮑": "أُذُن اَلْبَحْر (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً)\nمثال: من أذن لتوم باستعارة سيارتي?",
 "鮑魚": "مَحْفُوظ بِالمِلْح, مُمَلَّح ((خَاصَّةً عَنِ اللُّحُوم) مَحْفُوظ فِي المِلْح)",
 "鮒": "شبوط كروشي (شبوط أوروبي يشبه إلى حد كبير السمكة الذهبية البرية)",
 "鮟鱇": "سمكة الصنارة, سمكة الصياد (أسماك لها أفواه كبيرة مع خيط يشبه الدودة متصل بها لجذب الفريسة) / مُغَفَّل, أَحْمَق",
 "鮠": "منوة (سمكة مياه عذبة أوروبية صغيرة جداً شائعة في الجداول الحصوية)",
 "鮨": "سُوشِي",
 "鮨屋": "بار السوشي (حانة أو منصة يُقدم فيها السوشي)",
 "鮨詰め": "مَحْشُوّ, مُكْتَظّ (مُزْدَحِمٌ لِلغَايَةِ أَوْ مَمْلُوءٌ حَتَّى أَقْصَى طَاقَتِهِ)",
 "鮪": "تُونَة, تُنّ / نَجْمَةُ اَلْبَحْرِ",
 "鮪釣り": "تونة (سمكة مياه دافئة دهنية هامة من جنس التونة من فصيلة الإسقمريات؛ تقدم عادة كشرائح)",
 "鮫": "لُخْم / قِرْش / سَمَكَةُ الْقِرْش (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / ركان\nمثال: سمكة ميناد ماتت",
 "鮫皮": "جلد القرش (قماش ناعم هش الملمس)",
 "鮫肌井守": "سمندل خشن الجلد (سمندل من الساحل الرطب من ألاسكا إلى جنوب كاليفورنيا)",
 "鮭": "حُوت سُلَيْمَان, سَلَمُون (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟ / سلمون الكيتا (سلمون كبير من المحيط الهادئ ذو بقع صغيرة على ظهره؛ سمكة طعام مهمة)",
 "鮮": "كُورْيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة) / كُورِيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "鮮やか": "حَيّ اللَّوْن, زَاهٍ ((للألوان) ذو أعلى درجة تشبع لوني) / زَاهٍ, سَاطِع (ذو ألوان قويّة وزاهية) / حَيّ, نَابِض (ذو وضوح ونضارة كأنّه تجربة مباشرة) / حَيّ, نَابِض (يستحضر صورًا حيّة ونابضة في الذهن) / مَاهِر, حَاذِق",
 "鮮度": "جِدَّة, طَرَافَة (الأصالة بحكم كون الشيء جديداً ومنعشاً) / صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / طزاجة, نضارة (خاصية كون الشيء نقياً وطازجاً (كأنه صنع حديثاً)؛ غير بائت أو متدهور) / جدة, حداثة (الأصالة بحكم كونها جديدة ومفاجئة)\nمثال: أحبت طزاجة الخبز المخبوز حديثاً",
 "鮮明": "حَيّ اللَّوْن, زَاهٍ ((للألوان) ذو أعلى درجة تشبع لوني) / زَاهٍ, سَاطِع (ذو ألوان قويّة وزاهية) / حَيّ, نَابِض (ذو وضوح ونضارة كأنّه تجربة مباشرة) / حَيّ, نَابِض (يستحضر صورًا حيّة ونابضة في الذهن)",
 "鮮烈": "حَيّ اللَّوْن, زَاهٍ ((للألوان) ذو أعلى درجة تشبع لوني) / زَاهٍ, سَاطِع (ذو ألوان قويّة وزاهية) / حَيّ, نَابِض (ذو وضوح ونضارة كأنّه تجربة مباشرة) / حَيّ, نَابِض (يستحضر صورًا حيّة ونابضة في الذهن)",
 "鮮紅": "سِقِلَّاتِيّ, قِرْمِزِيّ / سِقِلَّاط, سِقِلَّات",
 "鮮鋭": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة.",
 "鮮鋭度": "حدة, خشونة (قسوة في الأسلوب) / تَمَايُز, حِدَّة (صفة كون الشيء حاداً وواضحاً) / حدة (رقة الحافة أو دقة الطرف) / حدة (صفة الشعور بالشيء بحدة وألم شديد)\nمثال: حدة خسارتها",
 "鮮魚": "وقود المدافع (جنود يُعتبرون قابلين للتضحية بهم في مواجهة نيران المدفعية)",
 "鮮魚店": "سَمَّاك, بَائِع سَمَك",
 "鮮麗": "حَيّ اللَّوْن, زَاهٍ ((للألوان) ذو أعلى درجة تشبع لوني) / زَاهٍ, سَاطِع (ذو ألوان قويّة وزاهية) / حَيّ, نَابِض (ذو وضوح ونضارة كأنّه تجربة مباشرة) / حَيّ, نَابِض (يستحضر صورًا حيّة ونابضة في الذهن)",
 "鮸": "طَبْل (الضَرْب على الطَبْل؛ آلة موسيقية تشبه الإسطوانة المغطاة فتحتها بالجلد تستخدم بأن يضرب وجهها إما باليد أو بعصا) / طَبْلَة / ميكا (أي من المعادن المختلفة المكونة من سيليكات مائية للألمنيوم أو البوتاسيوم وغيرها والتي تتبلور في أشكال تسمح بانقسامها إلى أوراق رقيقة جداً) / بشاشة, دماثة (الميل لكون المرء ودوداً ويسهل التعامل معه) / انشراح, روقان (مزاج مبتهج ومقبول)",
 "鮸膠": "ميكا (أي من المعادن المختلفة المكونة من سيليكات مائية للألمنيوم أو البوتاسيوم وغيرها والتي تتبلور في أشكال تسمح بانقسامها إلى أوراق رقيقة جداً) / بشاشة, دماثة (الميل لكون المرء ودوداً ويسهل التعامل معه) / انشراح, روقان (مزاج مبتهج ومقبول)",
 "鯒": "مسطحة الرأس (سمكة شاحبة تعيش في القاع مسطحة الرأس ذات عيون كبيرة وخطم يشبه البط) / مسطحة الرأس (سمكة غذائية في المنطقة الإندونيسية من المحيط الهادئ؛ تشبه الغرنار)",
 "鯔背": "بَاسِل, صَنْدِيد (لَا يَتَرَاجَع فِي المَعْرَكَة أَوِ العَمَل) / فُرُوسِيّ, نَبِيل (يُبدي اهتماماً بالنساء كالفارس المثالي) / جَلِيل, شَامِخ (يتحلّى بالوقار والنُّبل الكبيرين أو يُظهرهما) / أَنِيق, جَرِيء (حيويّ ومفعم بالحماس والأناقة)",
 "鯖": "إِسْقُمَرِيّ / مَاكْرِيل / خَادِم",
 "鯖雲": "ركام سمحاقي, سحاب قزعي (سحابة على ارتفاع عالٍ تتكون من سلسلة من السحب الصغيرة المرتبة بانتظام تشبه التموجات)",
 "鯛": "أسبور, دنيس / سمك الدنيس (لحم أي نوع من أسماك المياه المالحة المختلفة من فصيلة الأسبورية أو فصيلة البراميداي)",
 "鯡": "رنجة المحيط الهادئ (سمكة طعام مهمة في شمال المحيط الهادئ)",
 "鯢波": "شِعَار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "鯧": "جوني الصخر (سمكة طعام زلقة بلا حراشف في المياه الساحلية لشمال المحيط الأطلسي) / سمكة الزبدة (سمكة بحرية صغيرة ذات جسم مضغوط قصير وأشواك ضعيفة) / سمك الزبدة (أي من العديد من أسماك الطعام الصغيرة المفلطحة الأطلسية ذات الجلد الناعم)",
 "鯨": "حُوت (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "鯨ろう": "عنبرية (مادة شمعية بيضاء من زيت حوت العنبر)",
 "鯨取": "صَيْد اَلْحِيتَان",
 "鯨取り": "صَيْد اَلْحِيتَان",
 "鯨座": "حُوت (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "鯨油": "زيت الحوت (زيت أبيض إلى بني يتم الحصول عليه من شحم الحوت؛ كان يستخدم سابقاً للإضاءة)",
 "鯨波": "شِعَار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "鯨漁": "صَيْد اَلْحِيتَان",
 "鯨脂": "سمنة, شحم (وزن جسدي زائد) / شحم الحوت (طبقة عازلة من الدهون تحت جلد الحيتان والثدييات البحرية الكبيرة الأخرى؛ تُستخدم كمصدر للزيت)\nمثال: كانت تكره السمنة في نفسها وكذلك في الآخرين",
 "鯨脳油": "عنبرية (مادة شمعية بيضاء من زيت حوت العنبر)",
 "鯨蝋": "عنبرية (مادة شمعية بيضاء من زيت حوت العنبر)",
 "鯨銛": "حَرْبُون",
 "鯨類": "حوتيات (ثديي مائي كبير آكل للحوم ذو أطراف أمامية تشبه الزعانف ولا أطراف خلفية، يشمل: الحيتان، الدلافين، خنازير البحر، حريش البحر) / حوتياتي (من أو متعلق بالحيتان والدلافين وغيرها)",
 "鯨鬚": "بالين, عظم الحوت (مادة قرنية من الفك العلوي لبعض الحيتان؛ تستخدم كأضلاع للمراوح أو كدعامات في المشدات)",
 "鯨魚": "حُوت (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "鯨魚取": "صَيْد اَلْحِيتَان",
 "鯨魚取り": "صَيْد اَلْحِيتَان",
 "鯰": "سَلُّور / زَلْزَال, زِلْزال (فِي : ظاهرة طبيعية وهو اهتزاز أو سلسلة من الاهتزازات الارتجاجية المتتالية لسطح تحدث في وقت لا يتعدى ثواني معدودة…)\nمثال: دمر زلزال عيادة سامي.",
 "鯱": "حُوت قَاتِل (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "鯱鉾立ち": "وقوف على اليدين (فعل دعم النفس باليدين فقط في وضع مقلوب)",
 "鯵": "جاك ماكريل, ماكريل الحصان (سمكة طعام من كاليفورنيا) / ماكريل الحصان (سمكة طعام كبيرة ممدودة ومضغوطة تعيش في مياه المحيط الأطلسي لأوروبا) / تونة زرقاء الزعانف (أكبر أنواع التونة؛ تصل إلى 1500 رطل؛ تعيش غالباً في البحار المعتدلة: تتغذى في المناطق القطبية ولكن تتكاثر في المناطق الاستوائية)",
 "鯵フライ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "鯵刺": "خَرْشَنَة",
 "鯵刺し": "خَرْشَنَة",
 "鯽": "شبوط كروشي (شبوط أوروبي يشبه إلى حد كبير السمكة الذهبية البرية)",
 "鰈": "فلاوندر أيمن العين (فلاوندر تقع كلتا عينيه على الجانب الأيمن من الرأس)",
 "鰊": "رنجة المحيط الهادئ (سمكة طعام مهمة في شمال المحيط الهادئ)",
 "鰌": "لوتش (أسماك مياه عذبة نحيلة في أوراسيا وأفريقيا تشبه سمك السلور)",
 "鰍": "إسقلبين (أي من الأسماك العقربية العديدة الشائكة كبيرة الرأس وعديمة القشور عادة ذات أفواه عريضة)",
 "鰐": "تِمْسَاح (حَيَوَان زَاحِف كبير يعيش في المياه العذبة مثل الأنهار والبحيرات، وأحياناً في السواحل. يتميز بفكٍّ قوي مليء بالأسنان الحادة، وجسم مغطى بجلد خشن وسميك…؛ (عَامِّيَّة مِصْرِيَّة) أحد موديلات 1976–84 من سيارات مرسيدس بنز)\nمثال: هناك تمساح في البحر. / لُخْم / قِرْش / سَمَكَةُ الْقِرْش (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / ركان\nمثال: سمكة ميناد ماتت",
 "鰐亀": "سلحفاة القاطور النهاشة (نوع كبير له ثلاثة تلال على ظهره؛ يوجد في جنوب شرق الولايات المتحدة)",
 "鰐口": "قَاطُور, تِمْسَاح أَمْرِيكِيّ",
 "鰐口クリップ": "مشبك تمساح (مشبك بزمبرك يغلق الفكين المعدنيين)",
 "鰐梨": "أَفُوكَادُو",
 "鰐足": "أَفْحَج, مُقَوَّسُ السَّاقَيْن (ذُو سَاقَيْنِ تَنْحَنِيَانِ إِلَى الخَارِجِ عِنْدَ الرُّكْبَتَيْنِ) / ساق مقوسة, فحج (ساق منحنية للخارج عند الركبة (أو أسفل الركبة))",
 "鰐魚": "تِمْسَاح (حَيَوَان زَاحِف كبير يعيش في المياه العذبة مثل الأنهار والبحيرات، وأحياناً في السواحل. يتميز بفكٍّ قوي مليء بالأسنان الحادة، وجسم مغطى بجلد خشن وسميك…؛ (عَامِّيَّة مِصْرِيَّة) أحد موديلات 1976–84 من سيارات مرسيدس بنز)\nمثال: هناك تمساح في البحر.",
 "鰓": "خَيْشُوم, نَخْشُوش / ذَقْن, دقن (الجزء الناتىء البارز في أسفل الوجه تحت الفم، وهو منبت اللِحْيَة عند الرَجُل؛ كناية اللِحْيَة) / خَيْشُوم, نَخْشُوش",
 "鰓孔": "شَقّ خَيْشُومِيّ (واحدة من سلسلة فتحات شقية في بلعوم الأسماك والبرمائيات المائية يمر الماء من خلالها)",
 "鰓弓": "قَوْس خَيْشُومِيّ (أحد الأقواس العظمية أو الغضروفية على كل جانب من البلعوم والتي تدعم خياشيم الأسماك والبرمائيات المائية)",
 "鰓蓋": "غشاء الخيشوم, غطاء الخيشوم (سديلة صلبة تعمل كغطاء (أ) لشقوق الخياشيم في الأسماك أو (ب) لفتحة الصدفة في بعض بطنيات القدم عند انكماش الجسم)",
 "鰓裂": "شَقّ خَيْشُومِيّ (واحدة من سلسلة فتحات شقية في بلعوم الأسماك والبرمائيات المائية يمر الماء من خلالها)",
 "鰓骨": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم) / قَوْس خَيْشُومِيّ (أحد الأقواس العظمية أو الغضروفية على كل جانب من البلعوم والتي تدعم خياشيم الأسماك والبرمائيات المائية)",
 "鰔": "قد المحيط الهادئ (يرتبط ارتباطاً وثيقاً بالقد الأطلسي)",
 "鰥": "أَرْمَل ((أَرْمَلَ) المكان: صار ذا رمل؛ (أَرْمَلَ) فلان: نفد زاده وافتقر)\nمثال: هي أصبحت أرملة.",
 "鰥夫": "أَرْمَل ((أَرْمَلَ) المكان: صار ذا رمل؛ (أَرْمَلَ) فلان: نفد زاده وافتقر)\nمثال: هي أصبحت أرملة.",
 "鰧": "سمكة العقرب, عقرب البحر (أسماك بحرية لها جسم مستدق ورأس مدرع وأشواك سامة)",
 "鰭": "زِعْنِفَة (أشواك عظمية مغطاة بالجلد أو أشعة تبرز من جسم السمكة، يستعملها السمك في التوزان وللاندفاع إلى الأمام)",
 "鰭脚類": "زعنفيات الأقدام (ثديي مائي آكل للحوم له جسم انسيابي متخصص للسباحة مع أطراف متحورة كزعانف)",
 "鰭足鷸": "فلروب (طائر شاطئي صغير يشبه الطيطوي له أصابع مفصصة ويجيد السباحة؛ يتكاثر في القطب الشمالي ويشتي في المناطق الاستوائية)",
 "鰯": "بلشار, سردين (أسماك صغيرة توجد في أسراب كبيرة على طول سواحل أوروبا؛ أصغر وأكثر استدارة من الرنجة) / سردين (سمكة دهنية صغيرة تعلب عادة)",
 "鰯油": "زيت السردين (زيت يتم الحصول عليه من السردين ويُستخدم بشكل رئيسي كمزلق وفي الصابون)",
 "鰯滓": "كرة السمك, كعكة السمك (كرة مقلية أو قرص من السمك المفتت والبطاطس المهروسة)",
 "鰯粕": "كرة السمك, كعكة السمك (كرة مقلية أو قرص من السمك المفتت والبطاطس المهروسة)",
 "鰯雲": "ركام سمحاقي, سحاب قزعي (سحابة على ارتفاع عالٍ تتكون من سلسلة من السحب الصغيرة المرتبة بانتظام تشبه التموجات)",
 "鰯鯨": "حوت ساي (يشبه الحوت الزعنفي ولكنه أصغر حجماً)",
 "鰷": "منوة (سمكة مياه عذبة أوروبية صغيرة جداً شائعة في الجداول الحصوية)",
 "鰹": "تونا وثابة, وثابة (تونة محيطية تعيش في أسراب ذات قيمة كبيرة في المحيط الهادئ ولكن أقل في الأطلسي؛ تصل إلى 75 رطلاً؛ تشبه جداً بونيتو المحيط إن لم تكن هي نفسها)",
 "鰹の烏帽子": "رجل الحرب البرتغالي (سحاري كبير له عوامة تشبه المثانة ومجسات لاسعة)",
 "鰹鳥": "أطيش (أطيش استوائي صغير ذو منقار ساطع أو أقدام ساطعة أو كليهما) / أحمق, جاهل (شخص جاهل أو أحمق)",
 "鰻": "أَنْقَلِيس, أَنْكَلِيس",
 "鰻上り": "طيران شراعي (نشاط الطيران بطائرة شراعية) / بَاسِق, سَامِق (ذو ارتفاع مهيب؛ خاصَّة يبرز فوق غيره) / صَاعِد, مُتَصَاعِد (يصعد إلى مستوى أعلى بكثير من المعتاد)",
 "鰻登り": "طيران شراعي (نشاط الطيران بطائرة شراعية) / بَاسِق, سَامِق (ذو ارتفاع مهيب؛ خاصَّة يبرز فوق غيره) / صَاعِد, مُتَصَاعِد (يصعد إلى مستوى أعلى بكثير من المعتاد)",
 "鰾": "نَفَّاخَة الْعَوْم, مَثَانَة الْعَوْم",
 "鰾膠": "ميكا (أي من المعادن المختلفة المكونة من سيليكات مائية للألمنيوم أو البوتاسيوم وغيرها والتي تتبلور في أشكال تسمح بانقسامها إلى أوراق رقيقة جداً) / بشاشة, دماثة (الميل لكون المرء ودوداً ويسهل التعامل معه) / انشراح, روقان (مزاج مبتهج ومقبول)",
 "鱈": "قد المحيط الهادئ (يرتبط ارتباطاً وثيقاً بالقد الأطلسي)",
 "鱏": "شُعَاع / شِفْنِين, شِفْنِين بَحْرِيّ",
 "鱒": "تَرُوتَة, أُطْرُوط",
 "鱒の介": "سلمون شينوك, سلمون ملكي (سلمون كبير من المحيط الهادئ يُقدر كطعام؛ يموت البالغون بعد وضع البيض) / تشينوك, سلمون الملك (لحم وردي أو أبيض لسلمون المحيط الهادئ الكبير)",
 "鱒之介": "سلمون شينوك, سلمون ملكي (سلمون كبير من المحيط الهادئ يُقدر كطعام؛ يموت البالغون بعد وضع البيض) / تشينوك, سلمون الملك (لحم وردي أو أبيض لسلمون المحيط الهادئ الكبير)",
 "鱓": "أنقليس موراي, موراي (فصيلة من الأنقليس النهم زاهي الألوان يعيش في المياه الساحلية الدافئة؛ عموماً غير عدواني للبشر لكن الأنواع الكبيرة خطيرة إذا استُفزت)",
 "鱗": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "鱗介": "مَأْكُولَات بَحْرِيَّة, طَعَام الْبَحْر",
 "鱗屑": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "鱗形": "تداخل, تراكب (غطاء بتصميم يغطي فيه عنصر جزءاً من عنصر آخر (كما هو الحال في البلاط أو القرميد))",
 "鱗片": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "鱗片葉": "حرشفة (ورقة متخصصة أو قنابة تحمي برعماً أو نورة هرية)",
 "鱗状": "مُحَرْشَف, حَرْشَفِيّ",
 "鱗珪石": "تريديميت (شكل معدني من السيليكا)",
 "鱗甲目": "آكل النمل الحرشفي, بنغول (ثديي عديم الأسنان من جنوب أفريقيا وآسيا يغطي جسمه حراشف قرنية وله خطم طويل للتغذى على النمل والنمل الأبيض)",
 "鱗粉": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "鱗翅類": "حرشفيات الأجنحة (حشرة لها في حالة البلوغ أربعة أجنحة مغطاة بدرجة ما بحراشف صغيرة)",
 "鱗芽": "بصيلة (بصلة صغيرة أو نمو على شكل بصلة ينشأ من إبط الورقة أو في مكان الزهور)",
 "鱗茎": "انتفاخ, بصيلة (جزء مستدير من أداة أسطوانية (عادة في أحد الطرفين)) / لمبة, مصباح كهربائي (مصباح كهربائي يتكون من غلاف زجاجي شفاف أو نصف شفاف يحتوي على فتيل سلكي (عادة من التنجستن) يبعث الضوء عند تسخينه بالكهرباء) / بَصَلَة (اتساع أو تمدد مستدير في قناة أو وعاء أو عضو) / بصلة السيساء, نخاع مستطيل (الجزء السفلي أو الخلفي من الدماغ؛ متصل بالحبل الشوكي)\nمثال: بصيلة المحقنة",
 "鱗葉": "حرشفة (ورقة متخصصة أو قنابة تحمي برعماً أو نورة هرية)",
 "鱗鉄鉱": "ليبيدوكروشيت (معدن أحمر إلى بني محمر يتكون من هيدروكسيد أكسيد الحديد؛ يوجد غالباً في خامات الحديد مع الغوثيت)",
 "鱗雲": "ركام سمحاقي, سحاب قزعي (سحابة على ارتفاع عالٍ تتكون من سلسلة من السحب الصغيرة المرتبة بانتظام تشبه التموجات)",
 "鱗雲母": "ليبيدوليت (معدن من مجموعة الميكا؛ مصدر مهم لليثيوم)",
 "鱘魚": "حَفْش (دخل في شيءٍ بسرعة أو اقتحمَه بطريقة مفاجئة؛ عمل شيئًا بسرعة أو دون تدقيق)",
 "鱝": "شُعَاع / شِفْنِين, شِفْنِين بَحْرِيّ",
 "鱟": "سرطان حدوة الحصان, سلطعون حدوة الحصان (مفصلي بحري كبير من ساحل المحيط الأطلسي لأمريكا الشمالية له درقة مقببة تشبه حدوة الحصان وذيل مدبب صلب)",
 "鱟魚": "سرطان حدوة الحصان, سلطعون حدوة الحصان (مفصلي بحري كبير من ساحل المحيط الأطلسي لأمريكا الشمالية له درقة مقببة تشبه حدوة الحصان وذيل مدبب صلب)",
 "鱧": "أنقليس كونجر, كونجر (أنقليس بحري كبير داكن اللون عديم القشور يوجد في المياه الساحلية المعتدلة والاستوائية؛ يُستخدم بعضه كطعام)",
 "鱵": "سمك شائك الظهر (أسماك صغيرة (2-4 بوصات) عدوانية غالباً عديمة الحراشف وشائكة الظهر تعيش في المياه العذبة والساحلية الشمالية ولها طقوس تزاوج معقدة؛ موضوع لكثير من…)",
 "鱶": "لُخْم / قِرْش / سَمَكَةُ الْقِرْش (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / ركان\nمثال: سمكة ميناد ماتت",
 "鱷": "تِمْسَاح (حَيَوَان زَاحِف كبير يعيش في المياه العذبة مثل الأنهار والبحيرات، وأحياناً في السواحل. يتميز بفكٍّ قوي مليء بالأسنان الحادة، وجسم مغطى بجلد خشن وسميك…؛ (عَامِّيَّة مِصْرِيَّة) أحد موديلات 1976–84 من سيارات مرسيدس بنز)\nمثال: هناك تمساح في البحر. / لُخْم / قِرْش / سَمَكَةُ الْقِرْش (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / ركان\nمثال: سمكة ميناد ماتت",
 "鱷魚": "تِمْسَاح (حَيَوَان زَاحِف كبير يعيش في المياه العذبة مثل الأنهار والبحيرات، وأحياناً في السواحل. يتميز بفكٍّ قوي مليء بالأسنان الحادة، وجسم مغطى بجلد خشن وسميك…؛ (عَامِّيَّة مِصْرِيَّة) أحد موديلات 1976–84 من سيارات مرسيدس بنز)\nمثال: هناك تمساح في البحر.",
 "鳥": "مزة (مَزة (بفتح الميم) مجموعة من الأكلات الصغيرة مشهورة في شرق البحر المتوسط، عادة تؤكل مع المشروبات الكحولية؛ مُزة (بضم الميم) تستخدم في اللهجة المصرية للإشارة للمرأة الجميلة) / دجاج داجن (طائر داجن من الدجاجيات يعتقد أنه ينحدر من دجاج الأدغال الأحمر) / لحم دجاج, لحم طير (لحم طائر أو دجاجة (برية أو داجنة) يستخدم كطعام)",
 "鳥おどし": "فَزَّاعَة",
 "鳥かご": "قفص طيور (قفص يمكن حفظ طائر فيه)",
 "鳥から揚げ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
