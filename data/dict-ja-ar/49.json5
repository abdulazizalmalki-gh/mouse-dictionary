 "賓": "ضَيْف, زَائِر / زَبُون",
 "賓客": "ضيف الشرف (الشخص الذي يُعقد التجمع تكريماً له)",
 "賓格": "حالة النصب (حالة الأسماء التي تعمل كمفعول به مباشر للفعل)",
 "賓辞": "عُرْضَة, شَيْء / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَفْعُول بِهِ, مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به) / كَائِن\nمثال: لقد أخطأ الهدف. / خَبَر (بلاه وامتحنه ليعرف ما يُمكن عنه؛ عرفه على حقيقته بعد أن جربّه)\nمثال: زيري عنده خبرة.",
 "賛": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى / نَقْش (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "賛する": "صَدَّقَ, وَافَقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع) / اِسْتَحَسَنَ, وَافَقَ (عَدَّه حَسَنا بمعنى جميل؛ عدَّه حسنًا بمعنى جَيِّد) / وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: صدق سامي كل شيء. / مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "賛助": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "賛助員": "داعم مالي, ممول (شخص يقدم الدعم المالي لمشروع ما)",
 "賛同": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض.",
 "賛同者": "محامي, محامية / ناطق بلسان, لسان حال / أوصى ب / حامى, رافع",
 "賛否": "نَعْم وَلَا, بَلَى وَنَعْم (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: أنت نعم الطالب.",
 "賛否両論": "مَحَاسِن وَمَسَاوِئ",
 "賛嘆": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "賛意": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض.",
 "賛成": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض.",
 "賛成多数": "غَالِبِيَّة, أَغْلَبِيّة",
 "賛成者": "داعم رياضي (داعم للأعضاء التناسلية يرتديه الرجال الذين يمارسون تمارين شاقة) / رباط جورب, مشد (شريط (عادة مطاطي) يرتدى حول الساق لتثبيت الجورب (أو حول الذراع لتثبيت الكم)) / مساعد, معين (شخص يساهم في تلبية حاجة أو تعزيز جهد أو غرض) / داعم, راعٍ (شخص يدعم أو يناصر شيئاً ما)\nمثال: مساعدي الذي لا يقدر بثمن",
 "賛歌": "تَأْبِين, أُمْدُوحَة / ثَنَاء, أُمْدُوحَة",
 "賛美": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "賛美歌": "تَرْتِيلَة, تَرْنِيمَة",
 "賛辞": "تَأْبِين, أُمْدُوحَة / ثَنَاء, أُمْدُوحَة",
 "賛辞を贈る": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "賜": "هَدِيَّة, هدية / قَرِيحَة / أَهْدَى / تَسَبَّب / نَتِيجَة",
 "賜う": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "賜ふ": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "賜り物": "أَنِيس, رَفِيق (قريب جداً وأليف في العشرة) / بركة, منحة (حالة مرغوبة)\nمثال: استمتع بنعم السلام",
 "賜る": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "賜わる": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "賜暇": "إجازة عسكرية (إجازة مؤقتة من الخدمة العسكرية)",
 "賜物": "هَدِيَّة, هدية / قَرِيحَة / أَهْدَى / تَسَبَّب / نَتِيجَة",
 "賞": "سَلِيبَة / غَنِيمَة / جَائِزَة, مُكَافَأَة",
 "賞する": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى / قَدَّرَ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / عَلِمَ (أَدْرَكَ حقيقة الشيء) / رَفَعَ قِيمَة, زَادَ فِي قِيمَة (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: خذ قدر ما تريد.",
 "賞レース": "مُنَافَسَة, مُبَارَاة / مُنَافَسَة, مُسَابَقَة",
 "賞与": "عِلَاوَة / مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "賞与金": "تشجيع, حافز (تأثير تحفيزي إيجابي) / حافز, مكافأة (دفعة إضافية (أو مكافأة أخرى) للموظفين كوسيلة لزيادة الإنتاج)",
 "賞典": "سَلِيبَة / غَنِيمَة / جَائِزَة, مُكَافَأَة",
 "賞味": "مذاق, نكهة (تجربة التذوق عند وضع طعام متبل في الفم) / تلذذ, شغف (استمتاع قوي ومتحمس) / ريليش, مقبلات مخللة (تابل حار أو لذيذ)",
 "賞味期限": "تاريخ انهاء الصلاحية (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "賞品": "سَلِيبَة / غَنِيمَة / جَائِزَة, مُكَافَأَة",
 "賞嘆": "إشادة, استحسان (موافقة حماسية)\nمثال: لقي الكتاب استحساناً متواضعاً",
 "賞揚": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "賞杯": "غَنِيمَة",
 "賞歎": "إشادة, استحسان (موافقة حماسية)\nمثال: لقي الكتاب استحساناً متواضعاً",
 "賞牌": "مِيدَالِيَة, مِِيدَالْيَة",
 "賞状": "شهادتي (مكون من أو متعلق بـ أو يشكل شهادة) / تقديري, تكريمي (معبر عن الإعجاب أو التقدير) / شهادة (شيء يخدم كدليل) / تزكية, توصية (شيء يوصي (أو يعبر عن الثناء على) شخص أو شيء على أنه جدير أو مرغوب فيه)\nمثال: عشاء تكريمي",
 "賞玩": "تَقْدِير",
 "賞盃": "غَنِيمَة",
 "賞美": "إِعْجَاب",
 "賞翫": "تَقْدِير",
 "賞詞": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "賞賛": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "賞辞": "ثَنَاء",
 "賞金": "جائزة مالية (أي أموال تُعطى كجائزة)",
 "賞金稼ぎ": "صَائِدُ ٱلْجَوَائِز",
 "賠償": "تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / تعويض (شيء (مثل المال) يُعطى أو يُستلم كدفعة أو تعويض (كما هو الحال عن خدمة أو خسارة أو إصابة)) / تعويض ((في الطب النفسي) آلية دفاع تخفي عيوبك غير المرغوب فيها عن طريق المبالغة في السلوكيات المرغوبة)",
 "賠償命令": "أمر محكمة (أمر صادر عن محكمة قانونية يطالب شخصاً بفعل شيء ما أو الامتناع عن فعله)",
 "賠償責任保険": "تأمين المسؤولية (تأمين يوفر الحماية من المطالبات الناشئة عن الإصابات أو الأضرار التي تلحق بأشخاص آخرين أو ممتلكات)",
 "賠償金": "تعويضات, غرامة تعويضية (مبلغ من المال يُدفع كتعويض عن خسارة أو إصابة) / تعويض, ضمانة (إعفاء قانوني من المسؤولية عن الأضرار) / تأمين, ضمان (حماية ضد الخسارة المستقبلية)",
 "賠責": "تأمين المسؤولية (تأمين يوفر الحماية من المطالبات الناشئة عن الإصابات أو الأضرار التي تلحق بأشخاص آخرين أو ممتلكات)",
 "賢": "جِهَاز الْمُخَابَرَات, مُخَابَرَات / اَلْمُخْلِص",
 "賢い": "حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب)\nمثال: هذه كلمات حكيمة. / حَسَن السُّلُوك, مُؤَدَّب ((عادة عن الأطفال) يتصرف بالطريقة التي يراها المتحدث صحيحة)",
 "賢しい": "ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي. / قَلِيل الأَدَب, وَقِح (جريء بشكل مسيء وبذيء)",
 "賢しら": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق) / خَارِجِيّ, غَيْرُ جَوْهَرِيّ (لا يتعلق بالمسألة قيد البحث) / جَرِيءُ اللِّسَان, وَقِح (يتّسم بخفّة وقحة ومرح طافح)",
 "賢人": "حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب) / مَرْيَمِيَّة / شَاقِيَة\nمثال: هذه كلمات حكيمة.",
 "賢哲": "رجل حكيم (مرشد ومستشار ذكر حكيم وموثوق به)",
 "賢女": "امرأة حكيمة (مرشدة ومستشارة أنثى حكيمة وموثوق بها)",
 "賢察": "حسن تقدير, فطنة (سمة الحكم بحكمة وموضوعية) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات) / بصيرة, فطانة (إدراك ما هو غامض) / بصيرة, تذوق (تمييز دقيق (خاصة للقيم الجمالية))\nمثال: رجل ذو فطنة",
 "賢明": "حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب)\nمثال: هذه كلمات حكيمة.",
 "賢木": "دائم الخضرة ((عن النباتات والشجيرات) تحمل أوراق الشجر طوال العام) / نبات دائم الخضرة (نبات له أوراق تدوم وتظل خضراء طوال العام)",
 "賢者": "حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب) / مَرْيَمِيَّة / شَاقِيَة\nمثال: هذه كلمات حكيمة.",
 "賢者の石": "حَجَر اَلْفَلَاسِفَة (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "賢覧": "تمحيص, دراسة (القراءة بعناية بقصد التذكر)",
 "賤": "ضعة, مكانة متدنية (موقف ذو مكانة أدنى؛ منخفض في المقام أو الرتبة أو الثروة أو التقدير) / تواضع المكانة, خمول (حالة كونه متواضعاً وغير مهم) / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "賤しむ": "اِحْتَقَرَ, أَهَانَ",
 "賤しむべき": "حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار)",
 "賤しめる": "اِحْتَقَرَ, أَهَانَ",
 "賤人": "شَعْبِيّ, عَامِّيّ (مرتبط بعامة الناس أو ينتمي إليهم) / عامّي, من الدهماء (واحد من عامة الناس)",
 "賤業婦": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "賤民": "شَعْبِيّ, عَامِّيّ (مرتبط بعامة الناس أو ينتمي إليهم) / عامّي, من الدهماء (واحد من عامة الناس)",
 "賦": "قَصِيدَة, شِعْر / سَرْدِي / قِصَّة, حِكَايَة / سَرْدِيَّة, رِوَايَة",
 "賦する": "خَصَّصَ (خَصَّصَ الشيءَ: جعله خاصًّا؛ خَصَّصَ فلانًا بالشيءِ: خَصَّهُ به)\nمثال: حاول توفير بعض المال من ما خصص للسفر. / أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك.",
 "賦与": "منحة وقفية, وقف (فعل منح مصدر دخل دائم) / ملكة, موهبة (قدرات أو صفات طبيعية) / صندوق وقفي, وقف (رأس المال الذي يوفر الدخل لمؤسسة)\nمثال: جاء وقفه السخي للمختبر في الوقت المناسب تماماً",
 "賦存": "وُجُود, كَيْنُونَة (خِلاف العَدَم، وهي الحالة التي يكون الشيء أو الأمر أو الشخص فيها كَائِن ومَوْجُوْد؛ الوجود يقصد به كل ما هو كائن وموجود في الكَوْن)\nمثال: لا وجود للصدف !",
 "賦存量": "قوات احتياط, ميليشيا (مدنيون مدربون كجنود ولكنهم ليسوا جزءًا من الجيش النظامي)",
 "賦形剤": "حشوة (التبغ المستخدم لتشكيل لب السيجار) / تِكملة, حشو (أي شيء يضاف لإكمال الكل) / حشو, مادة لملء الفراغ (نسخة لملء الفراغ بين المقالات الأكثر أهمية في تخطيط مجلة أو صحيفة) / فيلر (100 فيلر تساوي 1 فورنت في المجر)\nمثال: بعض العناصر في المجموعة مجرد تكملة",
 "賦性": "طَبِيعَة, طبيعة",
 "賦活": "تفعيل, تنشيط (الجعل نشطاً وفعالاً (مثل القنبلة)) / تفعيل, تنشيط (نشاط التسبب في الحصول على طاقة ونشاط) / تنشيط (تحفيز النشاط في كائن حي أو مادة كيميائية)",
 "賦税": "جباية الضرائب, فرض الضرائب (فرض الضرائب؛ ممارسة الحكومة في جباية الضرائب على رعايا الدولة) / إيرادات ضريبية (دخل الحكومة الناتج عن الضرائب) / جباية, ضريبة (رسم يفرض على شخص المواطن أو ممتلكاته أو نشاطه لدعم الحكومة)",
 "賦詠": "قَصِيدَة, شِعْر",
 "賦課": "تجنيد عام, نفير عام (فعل التجنيد في الخدمة العسكرية) / جباية, رسم مفروض (رسم يفرض ويحصل)",
 "質": "نَوْعِيَّة, جَوْدَة / طَبِيعَة, طبيعة / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق) / بَيْدَق ((في الشطرنج) القطعة الأكثر انتشارًا على رقعة الشِطْرَنْج) / بيذق\nمثال: غادر ذلك الجندي. / تَعَهَّدَ / ضَمَان (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / تَعَهُّد\nمثال: لا أستطيع ضمان أي شيء.",
 "質がいい": "حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط",
 "質がわるい": "لَا أَخْلَاقِيّ, وَضِيع (غَيْرُ أَخْلَاقِيٍّ أَوْ غَيْرُ نَزِيه) / رَدِيء الصُّنْع, مُبْتَذَل (مصنوع بحرفية ومواد رديئة) / صوف مُعاد (ألياف صوف مستصلحة)",
 "質が悪い": "سيء الطباع, فظ (ذو طبع سريع الغضب وغير سار) / لَا أَخْلَاقِيّ, وَضِيع (غَيْرُ أَخْلَاقِيٍّ أَوْ غَيْرُ نَزِيه) / رَدِيء الصُّنْع, مُبْتَذَل (مصنوع بحرفية ومواد رديئة) / صوف مُعاد (ألياف صوف مستصلحة)",
