 "資金供給": "تمويل (عملية التمويل)",
 "資金手当": "تمويل (عملية التمويل) / تمويل, دعم مالي (الموارد المالية المقدمة لجعل مشروع ما ممكناً)\nمثال: قدمت المؤسسة الدعم للتجربة",
 "資金提供者": "مُسْتَثْمِر, مُسْتَثْمِرَة",
 "資金援助": "إعانة, دعم اقتصادي (هبة مالية أو مساعدة مادية أخرى لدعم شخص أو قضية)\nمثال: مساعدة اقتصادية للمناطق الكاسدة",
 "資金洗浄": "غَسِيل أَمْوَال, غَسْل أَمْوَال",
 "資金繰り": "تمويل (عملية التمويل)",
 "資金難": "تدفق نقدي (فائض الإيرادات النقدية عن المصروفات النقدية في فترة زمنية معينة (لا يشمل المصروفات غير النقدية))",
 "資金面": "مَالِيّ (مَالِي هي دولة تقع في وسط إفريقيا؛ مالي:نقودي، أموالي)\nمثال: زيري من المالي.",
 "賊": "عدو (خصم مسلح (خاصة عضو في قوة عسكرية معادية)) / خصم, عدو (عدو شخصي)\nمثال: يجب أن يكون الجندي مستعداً لقتل أعدائه / مرارة / ضَرَرٌ / ضَرَّ أَضَرَّ / لِصّ, لِصَّة / مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "賊子": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "賊害": "ضَرَرٌ / ضَرَّ أَضَرَّ",
 "賊徒": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "賊臣": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "賎業婦": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "賑々しい": "دَجِر",
 "賑あう": "ازدهر",
 "賑やか": "حَافِل بِالنَّشَاط, صَاخِب (مليء بالنشاط الحيويّ والصاخب) / دَجِر",
 "賑やかさ": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل.",
 "賑わい": "اِزْدِهَار, رَخَاء",
 "賑わう": "ازدهر",
 "賑わす": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "賑わせる": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
