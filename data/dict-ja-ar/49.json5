 "谷本": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "谷村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "谷水": "قناة صغيرة, مجرى صغير (قناة صغيرة (كتلك التي تكونت بفعل تعرية التربة)) / جدول صغير, ساقية (مجرى مائي صغير)",
 "谷沢": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "谷筋": "قَنَاة",
 "谷間": "وَادٍ, الْوَادِي (حوض أو منخفض طبيعي على سطح الأرض، يمتد بين السهول والهضاب والجبال)\nمثال: بإمكاني السباحة في الواد. / شطر, فلق (عملية الفلق أو الشق) / شق الصدر, فلق الصدر (الخط المتشكل من أخدود بين جزأين (خاصة الفاصل بين ثديي المرأة)) / تفلج, تقطع ((علم الأجنة) الانقسام المتكرر للبويضة المخصبة) / انشطار, انقسام (كسر رابطة كيميائية في جزيء مما يؤدي إلى جزيئات أصغر) / نُقْطَة عَمْيَاء (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "谿壑": "وَهْدَة",
 "谿澗": "وَادٍ, الْوَادِي (حوض أو منخفض طبيعي على سطح الأرض، يمتد بين السهول والهضاب والجبال)\nمثال: بإمكاني السباحة في الواد.",
 "谿谷": "وَادٍ, الْوَادِي (حوض أو منخفض طبيعي على سطح الأرض، يمتد بين السهول والهضاب والجبال)\nمثال: بإمكاني السباحة في الواد.",
 "谿間": "وَهْدَة",
 "豁然": "فَجْأَةً",
 "豆": "بقول, قرن (قرن البذور لنبات بقولي (مثل البازلاء أو الفاصولياء أو العدس)) / بقول, قرنية (نبات فول أو بازلاء قائم أو متسلق من الفصيلة البقولية) / بقل, ثمرة قرنية (فاكهة أو بذرة أي من نباتات الفاصوليا أو البازلاء المختلفة تتكون من علبة تنشق على طول كلا الجانبين عند النضج وتكون البذور ملتصقة بجانب واحد من العلبة) / صويا, فول الصويا (أكثر الخضراوات المعروفة احتواءً على البروتين؛ تستخدم ثمرة نبات الصويا في مجموعة متنوعة من الأطعمة وكعلف (خاصة كبديل للبروتين الحيواني)) / صويا, فول الصويا (عشب حولي منتصب كثيف الشعر له أوراق ثلاثية وزهور أرجوانية إلى وردية؛ يزرع على نطاق واسع للغذاء والعلف ولتحسين التربة، وخاصة لبذوره المغذية الغنية…) / فول الصويا (مصدر للزيت؛ يستخدم للعلف وتحسين التربة وكغذاء) / أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية) / كُلْيَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: في أي كلية تدرس؟",
 "豆がら茶": "أَزْرَق رَمَادِيّ (أزرق مع مسحة رمادية)",
 "豆テスト": "اِخْتِبَار (اختبر الشّيء:خبره)\nمثال: تم اختبار زيري.",
 "豆乳": "حَلِيب صُويَا (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "豆娘": "مقترنة الأجنحة, يعسوب صغير (حشرة نحيلة غير لاسعة تشبه اليعسوب ولكنها أصغر منه ولها أجنحة مطوية عند الراحة)",
 "豆料": "بقول, قرن (قرن البذور لنبات بقولي (مثل البازلاء أو الفاصولياء أو العدس)) / بقول, قرنية (نبات فول أو بازلاء قائم أو متسلق من الفصيلة البقولية) / بقل, ثمرة قرنية (فاكهة أو بذرة أي من نباتات الفاصوليا أو البازلاء المختلفة تتكون من علبة تنشق على طول كلا الجانبين عند النضج وتكون البذور ملتصقة بجانب واحد من العلبة)",
 "豆果": "بقول, قرن (قرن البذور لنبات بقولي (مثل البازلاء أو الفاصولياء أو العدس)) / بقول, قرنية (نبات فول أو بازلاء قائم أو متسلق من الفصيلة البقولية) / بقل, ثمرة قرنية (فاكهة أو بذرة أي من نباتات الفاصوليا أو البازلاء المختلفة تتكون من علبة تنشق على طول كلا الجانبين عند النضج وتكون البذور ملتصقة بجانب واحد من العلبة)",
 "豆桜": "كرز فوجي (شجرة كرز يابانية شجيرية لها أزهار وردية شاحبة)",
 "豆殻茶": "أَزْرَق رَمَادِيّ (أزرق مع مسحة رمادية)",
 "豆汁": "مَاش / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "豆油": "زيت فول الصويا (زيت مستخرج من فول الصويا) / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "豆漿": "حَلِيب صُويَا (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "豆状骨": "عظم حمصي (عظم رسغي صغير يتمفصل فقط مع العظم المثلثي)",
 "豆知識": "تفاهة, شيء تافه (شيء قليل الأهمية)",
 "豆粒": "فَاصُولِيَا, لُوبِيَا",
 "豆腐": "تُوفُو, توفو",
 "豆腐にかすがい": "هدر الجهد (جهد لا طائل منه)",
 "豆腐に鎹": "هدر الجهد (جهد لا طائل منه)",
 "豆蔦蘭": "وَرَق بَصَلِيّ, وَرَقَة بَصَلِيَّة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)",
 "豆豉醤": "فاصولياء سوداء (فاصولياء سوداء البذور من أمريكا الجنوبية؛ عادة ما تكون مجففة)",
 "豆象虫": "سوسة الفاصوليا (تعيش اليرقات وتتغذى في الفاصوليا النامية أو المخزنة)",
 "豆類": "نَبْض, نَبْضَة",
 "豆鹿": "طرغولية",
 "豆黄金": "خنفساء يابانية (خنفساء صغيرة خضراء وبنية معدنية موطنها شرق آسيا؛ آفة نباتية خطيرة في أمريكا الشمالية)",
 "豆鼓醤": "فاصولياء سوداء (فاصولياء سوداء البذور من أمريكا الجنوبية؛ عادة ما تكون مجففة)",
 "豇豆": "لوبياء, لوبياء سوداء العين (تؤكل طازجة كفاصولياء مقشرة أو مجففة) / بازلاء سوداء العين, لوبياء (نبات حولي متمدد من العالم القديم يزرع خاصة في جنوب الولايات المتحدة للغذاء والعلف وكسماد أخضر) / لوبياء (فاكهة أو بذرة نبات اللوبياء)",
 "豈": "أَبَدًا / لِمَاذَا / لِمَ (جَمَعَ، ضَمَّ) / علاش / علاه\nمثال: لم يساعدني أحد.",
 "豊": "وافِر, وَفِير / غَنِيّ / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا. / سمين",
 "豊か": "وافِر, وَفِير / غَنِيّ / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا. / سمين",
 "豊倉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "豊原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "豊口": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "豊富": "وافِر, وَفِير",
 "豊島": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "豊崎": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "豊川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
