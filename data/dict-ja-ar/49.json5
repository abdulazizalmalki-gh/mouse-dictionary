 "購買力": "قُدْرَة شِرائِيَّة",
 "購買力平価": "قُدْرَة شِرائِيَّة",
 "購買力平価説": "قُدْرَة شِرائِيَّة",
 "購買層": "مبتاع, مُشتَرٍ (شخص يقوم بالشراء)",
 "購買者": "مُشْتَرِي, مُشْتَرٍ (الذي قام بالشراء)\nمثال: كوكب المشتري متكون من الغاز.",
 "購買部": "تعاونية, جمعية تعاونية (مؤسسة تجارية مملوكة بشكل مشترك (ينظمها عادة المزارعون أو المستهلكون) تنتج وتوزع السلع والخدمات وتدار لصالح مالكيها)",
 "賽": "زهر, نرد (مكعب صغير به 1 إلى 6 نقاط على الأوجه الستة؛ يستخدم في المقامرة لتوليد أرقام عشوائية)",
 "賽の河原": "عَقِيم",
 "賽の目": "عَجَمَة / عَجَم (خلاف العُرْب والعَرَب، ويشمل كل الأقوام من غيرهم؛ عند البعض من أهل المشرق العربي هم الفُرْس تحديدا من باب إطلاق اسم الكل على البعض) / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "賽は投げられた": "سبق السيف العذل, حُصِّلَ مَا فِي الصُدُورِ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك.",
 "賽六": "طِفْل (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان منذ أن تلده أمه حتى يَبْلُغ) / جَدْي\nمثال: هو طفل العائلة.",
 "賽銭": "طقس التقدمة (جزء من القداس يتم فيه تقديم الخبز والنبيذ لله) / جمع التبرعات, عطاء المصلين (تقدمات المصلين في خدمة دينية)",
 "贄": "قُرْبَان / هَدِيَّة, هدية / قَرِيحَة / أَهْدَى / تَضْحِيَة, قُرْبَان / ضَحَّى",
 "贄田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "贅": "إِسْرَاف, تَبْذِير (إسراف؛ أَسْرَفَ: ( فعل ))\nمثال: ورأى أنه — إذا استمر على ذلك الإسراف — أضاع ما بقي من ثروته.",
 "贅沢": "رَفَاهِيَّة, تَرَف / تَرَف (تَرِفَ النَّبَاتُ، كفَرِح: تَرَوَّى؛ تَرِفَ النَّبَات تَرَفَا: كَثُرَ مَاؤُهُ ونَضُر) / كَمَالِيّ / بَاذِخ, مُسْرِف فِي العَطَاء (بالغ السخاء؛ يُعطي بإسراف ودون حساب) / بَاذِخ, سَخِيّ (يتميّز بالإسراف والوفرة) / مُفْرِط, زَائِد",
 "贅沢な悩み": "الْعَالَم الْأَوَّل",
 "贅肉": "دهن مترهل, شحم مرتخ (دهون الجسم المترهلة أو الرخوة)",
 "贅言": "إطناب, حشو (أسلوب تعبيري يستخدم كلمات مفرطة أو فارغة)",
 "贈り主": "مُرْسِل, مُرْسِلَة",
 "贈り物": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "贈る": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / أَفْضَلَ, مَنَحَ / تَآمَرَ\nمثال: 市長は彼に市の鍵を贈った。 — قدم له العمدة مفتاح المدينة.",
 "贈与": "تَبَرُّع, هِبَة",
 "贈与税": "ضريبة الهدايا (ضريبة تفرض على نقل الممتلكات عن طريق الهبة خلال حياة الواهب)",
 "贈与者": "مُتَبَرِّع",
 "贈与証書": "شهادتي (مكون من أو متعلق بـ أو يشكل شهادة) / تقديري, تكريمي (معبر عن الإعجاب أو التقدير) / شهادة (شيء يخدم كدليل) / تزكية, توصية (شيء يوصي (أو يعبر عن الثناء على) شخص أو شيء على أنه جدير أو مرغوب فيه)\nمثال: عشاء تكريمي",
 "贈主": "مُرْسِل, مُرْسِلَة",
 "贈収賄": "رَشْوَة / رشوة",
 "贈呈": "إِرَاءَة / إِهْدَاء, مَنْح",
 "贈呈品": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "贈呈者": "مُتَبَرِّع",
 "贈物": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
