 "趣味のいい": "أنيق, ذو ذوق رفيع (يمتلك أو يظهر أو يتوافق مع الذوق السليم)",
 "趣味のよい": "أنيق, ذو ذوق رفيع (يمتلك أو يظهر أو يتوافق مع الذوق السليم)",
 "趣味の悪い": "بَذِيء",
 "趣味の良い": "أنيق, ذو ذوق رفيع (يمتلك أو يظهر أو يتوافق مع الذوق السليم)",
 "趣味人": "هَاوٍ",
 "趣味家": "عَارِف, عَارِفَة",
 "趣味性": "دفء عاطفي, محبة (صفة نابعة من مشاعر المودة أو الحب) / هوى, ولع (استعداد للإعجاب بشيء ما) / عاطفة, محبة (شعور إيجابي بالإعجاب)\nمثال: كان لديه ولع بالويسكي",
 "趣意": "رَأْي, نَظَر",
 "趣意書": "دليل المقررات (كتالوج يسرد الدورات التي تقدمها كلية أو جامعة) / نَشْرَة إِصْدَار, نَشْرَة اكْتِتَاب (عرض مكتوب رسمي لبيع الأوراق المالية يحدد خطة لمؤسسة تجارية (مقترحة))\nمثال: يجب أن تحتوي نشرة الاكتتاب على الحقائق التي يحتاجها المستثمر لاتخاذ قرار مستنير",
 "趣旨": "مَعْنًى / الْمَعْنَى / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَرْمًى / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / سَجَّلَ هَدَفًا (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: لقد أخطأ الهدف.",
 "趣旨説明": "ترشيد, منهجة (تنظيم منهجي؛ فعل تنظيم شيء ما وفقاً لنظام أو منطق) / ترشيد, عقلنة (تنظيم العمل التجاري وفقاً لمبادئ الإدارة العلمية لزيادة الكفاءة) / إنطاق ((رياضيات) تبسيط تعبير أو معادلة عن طريق إزالة الجذور دون تغيير قيمة التعبير أو جذور المعادلة) / تبرير, عقلنة (العملية المعرفية لجعل شيء ما يبدو متسقاً مع العقل أو قائماً عليه)",
 "趣深い": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "趣致": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "趨勢": "مَيْل, نَزَعَة",
 "趨向": "مَيْل, نَزَعَة",
 "足": "رِجْل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / قَدَم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / قدم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / رجل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / ريل\nمثال: هذا الرجل تاجر. / رِجْل, سَاق (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر. / مشية (طريقة مشي الشخص) / مشية الحصان (طريقة تحرك الحصان) / سُرْعَة المَشْي, مِشْيَة (معدل الحركة (خاصة المشي أو الجري)) / خطوة, خطوة واسعة (خطوة في المشي أو الجري) / معدل, وتيرة (السرعة النسبية للتقدم أو التغيير) / ياردة (وحدة للطول تساوي 3 أقدام؛ محددة بـ 91.44 سنتيمتر) / خطوة (المسافة التي تغطيها خطوة)\nمثال: عاش بوتيرة سريعة",
 "足あと": "أَثَر قَدَم (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "足かけ": "ركيزة, موطئ قدم (إنجاز أولي يفتح الطريق لتطورات لاحقة) / موطئ قدم (مكان يوفر دعماً للقدم عند الوقوف أو التسلق) / رأس جسر, موطئ قدم (منطقة في أرض معادية تم الاستيلاء عليها والاحتفاظ بها بانتظار المزيد من القوات والإمدادات)\nمثال: أصبحت المدينة موطئ قدم في الحملة لحظر التدخين في الهواء الطلق",
 "足かせ": "غُلّ, أَغْلال",
 "足がかり": "ركيزة, موطئ قدم (إنجاز أولي يفتح الطريق لتطورات لاحقة) / موطئ قدم (مكان يوفر دعماً للقدم عند الوقوف أو التسلق) / رأس جسر, موطئ قدم (منطقة في أرض معادية تم الاستيلاء عليها والاحتفاظ بها بانتظار المزيد من القوات والإمدادات)\nمثال: أصبحت المدينة موطئ قدم في الحملة لحظر التدخين في الهواء الطلق",
 "足がすくむ": "تَجَمَّدَ",
 "足がもつれる": "هَذَيَان / هَذَى",
 "足が地につかない": "سعادة قصوى, غبطة (حالة من السعادة الغامرة)",
 "足が地に付かない": "سعادة قصوى, غبطة (حالة من السعادة الغامرة)",
 "足が地に着かない": "سعادة قصوى, غبطة (حالة من السعادة الغامرة)",
 "足が竦む": "تَجَمَّدَ",
 "足が縺れる": "هَذَيَان / هَذَى",
 "足が重い": "ثقيل الخطى ((للحركة) يفتقر إلى السهولة أو الخفة)\nمثال: مشيته المتعبة ثقيلة الخطى / مُتَرَدِّد, مُحْجِم (غير متحمّس؛ يتردّد في الإقدام) / مُتَرَدِّد, مُحْجِم (غير راغب في الانخراط أو المشاركة) / كَارِه, مُمَانِع (يأبى فعل شيء يخالف عادته أو طبعه)",
 "足げ": "رَفَسَ (رَفَسَهُ ضربه برجله وبابه ضرب؛ الرفْسُ: الصدْمَةُ بالرجْلِ في الصدْرِ. والرفَاسُ: الإبَاضُ الذي يُشَد به رِجْلا البَعِيرِ بارِكاً إلى وَرِكَيْه) / رَكَلَ (رَكَلَهُ، يَرْكُلُهُ، رَكْلًا، وَقيل: هُوَ الرَّكْضُ بالرِّجْلِ، وقيلِ: هُوَ الرَّفْسُ، وَقيل: الضَّرْبُ بالأرْجُلِ) / رَكْلَة\nمثال: فريد ركل الكرة.",
 "足げにする": "رَفَسَ (رَفَسَهُ ضربه برجله وبابه ضرب؛ الرفْسُ: الصدْمَةُ بالرجْلِ في الصدْرِ. والرفَاسُ: الإبَاضُ الذي يُشَد به رِجْلا البَعِيرِ بارِكاً إلى وَرِكَيْه) / رَكَلَ (رَكَلَهُ، يَرْكُلُهُ، رَكْلًا، وَقيل: هُوَ الرَّكْضُ بالرِّجْلِ، وقيلِ: هُوَ الرَّفْسُ، وَقيل: الضَّرْبُ بالأرْجُلِ) / رَكْلَة\nمثال: فريد ركل الكرة.",
 "足ごしらえ": "حِذَاء, مَشَّايَة (بمعنى الإزاء والجوار؛ النَعْل)\nمثال: أردت حذاء أحمر.",
 "足さばき": "خفة حركة, مناورة ذكية (مناورة أو تعامل ماهر) / حركة القدمين (طريقة استخدام القدمين)\nمثال: إنها بحاجة إلى بعض المناورة الذكية لتغطية كل تلك الأكاذيب",
 "足ざわり": "تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "足し": "ملحق / مُكَمِّل",
 "足しげく": "غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة",
 "足しげく通う": "مرتع, مزار (مكان يتردد عليه المرء كثيراً)",
 "足して二で割る": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل.",
 "足しにする": "ملحق / مُكَمِّل",
 "足し前": "ملحق / مُكَمِّل",
 "足し算": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "足す": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول.",
 "足だまり": "قاعدة, قاعدة عمليات (منشأة تبدأ منها القوة العسكرية عملياتها)\nمثال: قضى الهجوم على قواعدنا الأمامية",
 "足でまとい": "عَائِق, عَقَبَة",
 "足どり": "مشية (طريقة مشي الشخص) / مشية الحصان (طريقة تحرك الحصان) / سُرْعَة المَشْي, مِشْيَة (معدل الحركة (خاصة المشي أو الجري)) / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "足ならし": "إحماء, تحضير (ممارسة التمارين استعداداً لنشاط شاق)",
 "足のせ台": "كرسي قدم, مسند للقدمين (مقعد منخفض أو كرسي صغير لراحة قدمي الجالس)",
 "足の付け根": "مَفْصِل اَلْوَرْكِ",
 "足の便": "تيسر الوصول, سهولة المعشر (سمة كونه سهلاً للقاء أو التعامل معه) / إِتَاحَة, تَوَفُّر (صفة كون الشيء في المتناول عند الحاجة)",
 "足の指": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / إِصْبَع اَلْقَدَم (عضو مستطيل ينشعِب من طرف الكفّ أو القدم)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "足の甲": "مشط القدم (جزء الحذاء أو الجورب الذي يغطي قوس القدم) / قوس القدم, مشط القدم (قوس القدم)",
 "足の踏み場もない": "جَمِيع أَنْحَاء, كُلّ",
 "足の踏み場も無い": "جَمِيع أَنْحَاء, كُلّ",
 "足ひれ": "زِعْنِفَة (أشواك عظمية مغطاة بالجلد أو أشعة تبرز من جسم السمكة، يستعملها السمك في التوزان وللاندفاع إلى الأمام)",
 "足まとい": "حِمْل, عِبْء (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "足らず": "أَصْغَر مِن, صُغْرَى مِن / غير كافٍ, قاصر (كمية غير قادرة على تلبية حاجة أو متطلب)\nمثال: أموال غير كافية",
 "足らない": "غير كافٍ, قاصر (كمية غير قادرة على تلبية حاجة أو متطلب)\nمثال: أموال غير كافية / بَسِيط, سَاذَج (يفتقر إلى القدرة العقلية والفطنة)",
 "足りた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "足りとも": "مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "足りない": "غير كافٍ, قاصر (كمية غير قادرة على تلبية حاجة أو متطلب)\nمثال: أموال غير كافية / بَسِيط, سَاذَج (يفتقر إلى القدرة العقلية والفطنة)",
 "足りる": "اِسْتَحَقَّ / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "足る": "اِسْتَحَقَّ / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "足をとめる": "تَوَقَّفَ / تَوَقُّف, وَقْف",
 "足をひきずる": "عَرَجَ",
 "足をふみいれる": "أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "足を引きずる": "عَرَجَ",
 "足を引き摺る": "عَرَجَ",
 "足を引っ張る": "أَعْمَال تَخْرِيبِيَّة, تَخْرِيب (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما أشبه)\nمثال: أنا في رحلة أعمال.",
 "足を止める": "تَوَقَّفَ / تَوَقُّف, وَقْف",
 "足を洗う": "تَخَلَّى عَن, تَوَقَّفَ",
 "足を滑らす": "اِنْزَلَقَ",
 "足を滑らせる": "اِنْزَلَقَ",
 "足を踏みいれる": "أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "足を踏み入れる": "أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "足を運ぶ": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "足ヒレ": "زِعْنِفَة (أشواك عظمية مغطاة بالجلد أو أشعة تبرز من جسم السمكة، يستعملها السمك في التوزان وللاندفاع إلى الأمام)",
 "足下": "تَحْت الأَقْدَام (تحت القدمين) / فِي الطَّرِيق (في الطريق ويعيق التقدم)\nمثال: داس الفاصوليا تحت الأقدام / مشية (طريقة مشي الشخص) / مشية الحصان (طريقة تحرك الحصان) / سُرْعَة المَشْي, مِشْيَة (معدل الحركة (خاصة المشي أو الجري)) / تَيَّار / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم)\nمثال: لدي جارة مسلمة. / تَحْت الأَقْدَام (تحت القدمين) / فِي الطَّرِيق (في الطريق ويعيق التقدم)\nمثال: داس الفاصوليا تحت الأقدام / أَنْتَ, أَنْتِ (أنْتَ ضَميرُ رَفْعٍ مُنْفَصِلٌ لِلْمُخاطَبِ وَالْمُخاطَبَةِ)\nمثال: أنت لست صديقنا.",
 "足並み": "خطوة, خطوة واسعة (خطوة في المشي أو الجري) / معدل, وتيرة (السرعة النسبية للتقدم أو التغيير) / ياردة (وحدة للطول تساوي 3 أقدام؛ محددة بـ 91.44 سنتيمتر) / خطوة (المسافة التي تغطيها خطوة)\nمثال: عاش بوتيرة سريعة",
 "足乗": "كرسي قدم, مسند للقدمين (مقعد منخفض أو كرسي صغير لراحة قدمي الجالس)",
 "足乗せ": "كرسي قدم, مسند للقدمين (مقعد منخفض أو كرسي صغير لراحة قدمي الجالس)",
 "足乗せ台": "كرسي قدم, مسند للقدمين (مقعد منخفض أو كرسي صغير لراحة قدمي الجالس)",
 "足乳女": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "足代": "نفقات السفر ((غالباً بصيغة الجمع) نفقات يتكبدها الموظف في أداء الوظيفة وعادة ما يعوضها صاحب العمل)",
 "足任せ": "تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به",
 "足偏": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "足元": "تَحْت الأَقْدَام (تحت القدمين) / فِي الطَّرِيق (في الطريق ويعيق التقدم)\nمثال: داس الفاصوليا تحت الأقدام / مشية (طريقة مشي الشخص) / مشية الحصان (طريقة تحرك الحصان) / سُرْعَة المَشْي, مِشْيَة (معدل الحركة (خاصة المشي أو الجري)) / تَيَّار / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم)\nمثال: لدي جارة مسلمة.",
 "足元から鳥が立つ": "بغتة, على حين غرة (بسرعة وبدون سابق إنذار)\nمثال: توقف فجأة",
 "足利": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "足取り": "مشية (طريقة مشي الشخص) / مشية الحصان (طريقة تحرك الحصان) / سُرْعَة المَشْي, مِشْيَة (معدل الحركة (خاصة المشي أو الجري)) / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "足取り表": "مُخَطَّط بَيَانِيّ / مُخَطَط",
 "足取表": "مُخَطَّط بَيَانِيّ / مُخَطَط",
 "足台": "كرسي قدم, مسند للقدمين (مقعد منخفض أو كرسي صغير لراحة قدمي الجالس)",
 "足回り": "عفشة السيارة, نظام التعليق (نظام ميكانيكي من النوابض أو ممتصات الصدمات يربط العجلات والمحاور بهيكل المركبة ذات العجلات) / حِذَاء, مَشَّايَة (بمعنى الإزاء والجوار؛ النَعْل)\nمثال: أردت حذاء أحمر.",
 "足固め": "أساس, عمل تمهيدي (إعداد أولي كأساس أو قاعدة) / أساس (أدنى دعامة لهيكل ما) / أساس, حجر الزاوية (الافتراضات الأساسية التي يبدأ منها شيء ما أو يتطور أو يُحسب أو يُشرح)\nمثال: نحن مستعدون اليوم بسبب العمل التمهيدي الذي تم قبل عشر سنوات",
 "足垂れ星": "ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)",
 "足型": "أَثَر قَدَم (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "足場": "سِقَالَة, إِسْقَالَة / ركيزة, موطئ قدم (إنجاز أولي يفتح الطريق لتطورات لاحقة) / موطئ قدم (مكان يوفر دعماً للقدم عند الوقوف أو التسلق) / رأس جسر, موطئ قدم (منطقة في أرض معادية تم الاستيلاء عليها والاحتفاظ بها بانتظار المزيد من القوات والإمدادات)\nمثال: أصبحت المدينة موطئ قدم في الحملة لحظر التدخين في الهواء الطلق",
 "足底反射": "منعكس أخمصي (انثناء أصابع القدم عند حك باطن القدم بقوة على الجانب الخارجي من الكعب إلى الأمام في الأشخاص فوق سن عامين)",
 "足底疣贅": "ثؤلول أخمصي (ثؤلول يحدث على باطن القدم)\nمثال: الضغط يجعل الثآليل الأخمصية تطور مسماراً مؤلمًا حول المركز الناعم",
 "足底筋膜炎": "اِلْتِهَاب اللِّفَافَة الْأَخْمَصِيَّة",
 "足廻り": "عفشة السيارة, نظام التعليق (نظام ميكانيكي من النوابض أو ممتصات الصدمات يربط العجلات والمحاور بهيكل المركبة ذات العجلات) / حِذَاء, مَشَّايَة (بمعنى الإزاء والجوار؛ النَعْل)\nمثال: أردت حذاء أحمر.",
 "足形": "أَثَر قَدَم (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "足慣らし": "إحماء, تحضير (ممارسة التمارين استعداداً لنشاط شاق)",
 "足手がらみ": "عَائِق, عَقَبَة",
 "足手まとい": "عَائِق, عَقَبَة",
 "足手搦み": "عَائِق, عَقَبَة",
 "足手纏い": "عَائِق, عَقَبَة",
 "足手纒い": "عَائِق, عَقَبَة",
 "足技": "خفة حركة, مناورة ذكية (مناورة أو تعامل ماهر) / حركة القدمين (طريقة استخدام القدمين)\nمثال: إنها بحاجة إلى بعض المناورة الذكية لتغطية كل تلك الأكاذيب",
 "足抜け": "انقطاع, قطع مفاجئ (حالة من المقاطعة المفاجئة)",
 "足拵え": "حِذَاء, مَشَّايَة (بمعنى الإزاء والجوار؛ النَعْل)\nمثال: أردت حذاء أحمر.",
 "足指": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / إِصْبَع اَلْقَدَم (عضو مستطيل ينشعِب من طرف الكفّ أو القدم)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "足捌き": "خفة حركة, مناورة ذكية (مناورة أو تعامل ماهر) / حركة القدمين (طريقة استخدام القدمين)\nمثال: إنها بحاجة إلى بعض المناورة الذكية لتغطية كل تلك الأكاذيب",
 "足掛かり": "ركيزة, موطئ قدم (إنجاز أولي يفتح الطريق لتطورات لاحقة) / موطئ قدم (مكان يوفر دعماً للقدم عند الوقوف أو التسلق) / رأس جسر, موطئ قدم (منطقة في أرض معادية تم الاستيلاء عليها والاحتفاظ بها بانتظار المزيد من القوات والإمدادات)\nمثال: أصبحت المدينة موطئ قدم في الحملة لحظر التدخين في الهواء الطلق",
 "足掛け": "ركيزة, موطئ قدم (إنجاز أولي يفتح الطريق لتطورات لاحقة) / موطئ قدم (مكان يوفر دعماً للقدم عند الوقوف أو التسلق) / رأس جسر, موطئ قدم (منطقة في أرض معادية تم الاستيلاء عليها والاحتفاظ بها بانتظار المزيد من القوات والإمدادات)\nمثال: أصبحت المدينة موطئ قدم في الحملة لحظر التدخين في الهواء الطلق",
 "足掛り": "ركيزة, موطئ قدم (إنجاز أولي يفتح الطريق لتطورات لاحقة) / موطئ قدم (مكان يوفر دعماً للقدم عند الوقوف أو التسلق) / رأس جسر, موطئ قدم (منطقة في أرض معادية تم الاستيلاء عليها والاحتفاظ بها بانتظار المزيد من القوات والإمدادات)\nمثال: أصبحت المدينة موطئ قدم في الحملة لحظر التدخين في الهواء الطلق",
 "足掻き": "مُكَافِح (منخرط في كفاح للتغلب خاصة على الفقر أو الغموض)",
 "足掻く": "كِفَاح, نِضَال / كافح, جَاهَدَ\nمثال: 窮地から足掻き出る。 — سوف يتهرب من المأزق. / كافح, جَاهَدَ",
 "足日": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "足早": "عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان. / سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي.",
 "足早に": "بخفَة",
 "足枷": "غُلّ, أَغْلال",
 "足根": "رسغي (من أو متعلق بـ أو بالقرب من رسغ القدم) / عظم الرصغ, عظم رصغي (أي عظم من عظام الرصغ (في القدم))\nمثال: عظام رسغ القدم",
 "足根骨": "رُصُغ",
 "足止め": "حبس, حجز (فعل تقييد حرية شخص ما عن طريق حبسه) / تقييد, حصر (فعل إبقاء شيء ما ضمن حدود محددة) / احتجاز, حبس (حالة كونه محتجزاً) / طلق, مخاض (المرحلة الختامية للحمل؛ من بداية الانقباضات حتى ولادة الطفل)\nمثال: حصر العدوى في منطقة بؤرية / تأريض (توصيل المعدات الكهربائية بالأرض) / أساس, تأسيس (التعليم أو التوجيه في أساسيات مجال من مجالات المعرفة)\nمثال: يفتقر إلى التأسيس اللازم للدراسة المتقدمة",
 "足浴": "مغطس قدمين (حوض استحمام صغير لتدفئة أو غسل أو تطهير القدمين)",
 "足湯": "مغطس قدمين (حوض استحمام صغير لتدفئة أو غسل أو تطهير القدمين)",
 "足溜まり": "قاعدة, قاعدة عمليات (منشأة تبدأ منها القوة العسكرية عملياتها)\nمثال: قضى الهجوم على قواعدنا الأمامية",
 "足溜り": "قاعدة, قاعدة عمليات (منشأة تبدأ منها القوة العسكرية عملياتها)\nمثال: قضى الهجوم على قواعدنا الأمامية",
 "足無し井守": "ضفدع ثعباني (أي من البرمائيات الصغيرة النحيلة عديمة الأطراف الحفارة التي تشبه الديدان؛ تعيش في التربة الرطبة في المناطق الاستوائية) / ضفدعي ثعباني (من أو متعلق بـ أو ينتمي إلى فصيلة الضفادع الثعبانية)",
 "足無し蜥蜴": "سحلية عديمة الأرجل (سحلية ضامرة تشبه الدودة تحفر الجحور في كاليفورنيا قريبة الصلة بسحالي القاطور)",
 "足無井守": "ضفدع ثعباني (أي من البرمائيات الصغيرة النحيلة عديمة الأطراف الحفارة التي تشبه الديدان؛ تعيش في التربة الرطبة في المناطق الاستوائية) / ضفدعي ثعباني (من أو متعلق بـ أو ينتمي إلى فصيلة الضفادع الثعبانية)",
 "足無蜥蜴": "سحلية عديمة الأرجل (سحلية ضامرة تشبه الدودة تحفر الجحور في كاليفورنيا قريبة الصلة بسحالي القاطور)",
 "足病医": "أخصائي أقدام, طبيب أقدام (أخصائي في العناية بالقدمين)",
 "足癖": "مشية (طريقة مشي الشخص) / مشية الحصان (طريقة تحرك الحصان) / سُرْعَة المَشْي, مِشْيَة (معدل الحركة (خاصة المشي أو الجري))",
 "足白癬": "سِعْفَة القَدَم, القَدَم الرِيَاضِي",
 "足立": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "足糸": "بيسوس, خيوط التثبيت (خصلة من الخيوط القوية التي يثبت بها بلح البحر نفسه بسطح ثابت)",
 "足継ぎ": "مِقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَقْعَدَة / بِرَاز\nمثال: نام ياني على مقعد.",
 "足繁く": "غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة",
 "足繁く通う": "مرتع, مزار (مكان يتردد عليه المرء كثيراً)",
 "足纏い": "حِمْل, عِبْء (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "足置き": "كرسي قدم, مسند للقدمين (مقعد منخفض أو كرسي صغير لراحة قدمي الجالس)",
 "足背": "مشط القدم (جزء الحذاء أو الجورب الذي يغطي قوس القدم) / قوس القدم, مشط القدم (قوس القدم)",
 "足腰": "إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\") / أَسَاس, قَاعِدَة (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته) / مُؤَسَّسَة / أَسَاس (مبدأ عام تعتمد عليه طائفة من الظواهر أو القضايا؛ مُرتكز البناء وقاعدته)\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟",
 "足萎え": "ركاكة, ضعف (نقص أو عيب (خاصة في الحجج أو الأعمال الأدبية)) / عرج (إعاقة في المشي بسبب عجز في الساقين أو القدمين)\nمثال: كاتب مشهور بركاكة حبكاته",
 "足袋": "تابي (جورب بفاصل لإصبع القدم الكبير؛ يرتديه اليابانيون مع الصنادل)",
 "足触り": "تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "足趾": "أَثَر قَدَم (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / رِجْل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / قَدَم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / قدم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / رجل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / ريل\nمثال: هذا الرجل تاجر.",
 "足跡": "أَثَر قَدَم (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "足踏み": "مَرْعَى, سْتِيب / توقف, جمود (انقطاع النشاط الطبيعي) / جمود, طريق مسدود (وضع لا يمكن فيه إحراز تقدم أو لا يمكن فيه أي تقدم)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "足踏み状態": "توقف, جمود (انقطاع النشاط الطبيعي) / جمود, طريق مسدود (وضع لا يمكن فيه إحراز تقدم أو لا يمكن فيه أي تقدم)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "足蹠": "وَحِيد / عَزْب / أَخْمُص, بَاطِن القَدَم / نَعْل / سَمَك مُوسَى (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "足蹴": "رَفَسَ (رَفَسَهُ ضربه برجله وبابه ضرب؛ الرفْسُ: الصدْمَةُ بالرجْلِ في الصدْرِ. والرفَاسُ: الإبَاضُ الذي يُشَد به رِجْلا البَعِيرِ بارِكاً إلى وَرِكَيْه) / رَكَلَ (رَكَلَهُ، يَرْكُلُهُ، رَكْلًا، وَقيل: هُوَ الرَّكْضُ بالرِّجْلِ، وقيلِ: هُوَ الرَّفْسُ، وَقيل: الضَّرْبُ بالأرْجُلِ) / رَكْلَة\nمثال: فريد ركل الكرة.",
 "足蹴にする": "رَفَسَ (رَفَسَهُ ضربه برجله وبابه ضرب؛ الرفْسُ: الصدْمَةُ بالرجْلِ في الصدْرِ. والرفَاسُ: الإبَاضُ الذي يُشَد به رِجْلا البَعِيرِ بارِكاً إلى وَرِكَيْه) / رَكَلَ (رَكَلَهُ، يَرْكُلُهُ، رَكْلًا، وَقيل: هُوَ الرَّكْضُ بالرِّجْلِ، وقيلِ: هُوَ الرَّفْسُ، وَقيل: الضَّرْبُ بالأرْجُلِ) / رَكْلَة\nمثال: فريد ركل الكرة.",
 "足蹴り": "رفسة, ركلة (عملية توجيه ضربة بالقدم) / رفس, ركل (حركة دفع إيقاعية للساقين كما في السباحة أو التمارين الرياضية)\nمثال: وجه للكرة ركلة قوية",
 "足載": "كرسي قدم, مسند للقدمين (مقعد منخفض أو كرسي صغير لراحة قدمي الجالس)",
 "足載せ": "كرسي قدم, مسند للقدمين (مقعد منخفض أو كرسي صغير لراحة قدمي الجالس)",
 "足輪": "حَلْقَة / خَاتَم, خَاتِم / دَقَّ, رَنَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه) / رَنَّ ((رَنَّ) رنينا: صَوَّت وَصَاح؛ (رَنَّ) إِلَيْهِ: أصغى) / تَلْفَنَ, رَنَّ / مثال: واصل زيري دق الجرس.",
 "足速": "عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان. / سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي.",
 "足速い": "خَفِيفُ القَدَم, سَرِيعُ الخُطَى (ذُو أَقْدَامٍ سَرِيعَةِ الحَرَكَةِ)",
 "足運び": "مشية (طريقة مشي الشخص) / مشية الحصان (طريقة تحرك الحصان) / سُرْعَة المَشْي, مِشْيَة (معدل الحركة (خاصة المشي أو الجري))",
 "足長": "طَوِيل السَّاقَيْن (ذو ساقين طويلتين)",
 "足長蜂": "دبور الورق (أي من عدة دبابير اجتماعية تبني أعشاشاً من مادة تشبه الورق)",
 "足関節": "وصلة القدم (في الناي) (وصلة القدم هي القسم الأخير من الأقسام الثلاثة للناي الموسيقي الغربي)\nمثال: تحتوي آلة الناي الموسيقية على ثلاثة أجزاء: وصلة الرأس، والجسم، ووصلة القدم",
 "足音": "خطوة, موطئ قدم (فعل اتخاذ خطوة في المشي) / خطوة, وقع الأقدام (صوت خطوة شخص يمشي) / خطوة (المسافة التي تغطيها خطوة)\nمثال: سمع وقع أقدام على الشرفة",
 "足音をしのばせて": "بتسلل, خلسة (بطريقة خفية)\nمثال: تقدموا خلسة عكس التيار",
 "足音を忍ばせて": "بتسلل, خلسة (بطريقة خفية)\nمثال: تقدموا خلسة عكس التيار",
 "足首": "كَاحِل, كَعْب",
 "足馴らし": "إحماء, تحضير (ممارسة التمارين استعداداً لنشاط شاق)",
 "趾": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / إِصْبَع اَلْقَدَم (عضو مستطيل ينشعِب من طرف الكفّ أو القدم)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "趾行性": "إصبعي السير, مترجل على الأصابع ((عن الثدييات) السير على أصابع القدمين مع رفع الجزء الخلفي من القدم (كما تفعل القطط والكلاب والخيول)) / حيوان إصبعي السير (حيوان يمشي بحيث تلامس أصابع القدم فقط الأرض مثل الكلاب والقطط والخيول)",
 "趾蹠皮膚炎": "شاشة مسطحة (نوع من شاشات الفيديو رقيقة ومسطحة؛ تستخدم عادة في الحواسيب المحمولة)",
 "趾骨": "سُلَامَى, سُلَامِيَّة",
 "跂及": "حَاوَلَ (طَلَبَ، رَامَ) / مُحَاوَلَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: حاول توم قتلنا!",
 "跋": "خَاتِمَة",
 "跋扈": "اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: تساهم في انتشار الجهل والتضليل.",
 "跋扈柳": "صفصاف الماعز (صفصاف كثير التفرع من العالم القديم له نورات هرية كبيرة وأوراق عريضة كبيرة نسبياً)",
 "跋文": "خَاتِمَة",
 "跋渉": "تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به",
 "跑": "خبب (مشية أسرع من المشي؛ تضرب الأرجل المتقابلة قطرياً الأرض معاً) / هرولة (وتيرة جري بطيئة) / ترجمة حرفية مساعدة (ترجمة حرفية تُستخدم في دراسة لغة أجنبية (غالباً ما تُستخدم بشكل غير مشروع للغش)) / تروتسكي (راديكاليون يدعمون نظرية تروتسكي بأن الاشتراكية يجب أن تتأسس في جميع أنحاء العالم من خلال الثورة المستمرة)",
 "跑足": "خبب (مشية أسرع من المشي؛ تضرب الأرجل المتقابلة قطرياً الأرض معاً) / هرولة (وتيرة جري بطيئة) / ترجمة حرفية مساعدة (ترجمة حرفية تُستخدم في دراسة لغة أجنبية (غالباً ما تُستخدم بشكل غير مشروع للغش)) / تروتسكي (راديكاليون يدعمون نظرية تروتسكي بأن الاشتراكية يجب أن تتأسس في جميع أنحاء العالم من خلال الثورة المستمرة)",
 "跛": "ركاكة, ضعف (نقص أو عيب (خاصة في الحجج أو الأعمال الأدبية)) / عرج (إعاقة في المشي بسبب عجز في الساقين أو القدمين)\nمثال: كاتب مشهور بركاكة حبكاته",
 "跛を引く": "عَرَجَ",
 "跛者": "مُقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "跛行": "اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني / عَرَجَ",
 "距": "مِهْمَاز / رمكة (نتوء خلف وفوق حافر الحصان) / مفصل الرمكة (المفصل بين عظم المدفع والرسغ في الخيل)",
 "距爪": "شجرة مخالب الديك (شجرة شائكة صغيرة من جزر الهند الغربية) / إصبعية متكتلة, عشب البساتين (عشب قش ومرعى قوي من العالم القديم يُزرع على نطاق واسع)",
 "距離": "بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ / عَرُوضِيّ, مَوْزُون (يتعلّق بالتنظيم الإيقاعي للمقاطع اللفظية) / متري (قائم على المتر كمعيار للقياس) / نظام قياس (نظام من المقاييس المترابطة يسهل تحديد كمية خاصية معينة) / وحدة مترية (وحدة قياس عشرية للنظام المتري (تعتمد على المتر والكيلوغرام والثانية))\nمثال: النظام المتري",
 "距離標": "حجر الميل, معلم المسافة (عمود حجري بجانب الطريق لإظهار المسافات)",
 "距離空間": "فضاء متري (مجموعة من النقاط بحيث يوجد لكل زوج من النقاط عدد حقيقي غير سالب يسمى المسافة بينهما، ويكون متماثلاً ويحقق متباينة المثلث)",
 "距離計": "محدد المدى (أداة قياس (صوتية أو بصرية أو إلكترونية) للعثور على مسافة جسم ما)",
 "距骨": "عظم الكاحل, قعب (العظم الموجود في الكاحل الذي يتمفصل مع عظام الساق لتكوين مفصل الكاحل) / رواسب منحدرات, فتات صخري (كتلة مائلة من الصخور المفككة عند قاعدة جرف)",
 "跟骨": "عظم العقب, عظم الكعب (أكبر عظام الرصغ؛ يشكل كعب الإنسان)",
 "跡": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر. / مَوْضِع / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث. / نَدْبَة, نَدْب",
 "跡々": "مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل",
 "跡づける": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "跡をくらます": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "跡をつける": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "跡を暗ます": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "跡を継ぐ": "نَجَحَ",
 "跡を追う": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "跡付ける": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "跡切れ": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "跡取り": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "跡地": "مَوْضِع / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "跡形": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "跡白波": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "跡白浪": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "跡絶え": "تَوَقَّفَ / تَوَقُّف, وَقْف",
 "跡継": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى) / خَلِيف / وَارِث, وَارِثَة (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "跡継ぎ": "وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى) / خَلِيف / وَارِث, وَارِثَة (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "跡跡": "مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل",
 "跨ぐ": "شِبْر",
 "跨る": "رَكِبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا من الدواب)\nمثال: ركب ياني سفينة. / شِبْر\nمثال: 台風の被害は数県にまたがっていた。 — طالت الخسائر التي خلفها الإعصار الكثير من المحافظات.",
 "跨下": "أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي) / مفرق الساقين, منشعب (الزاوية التي تشكلها الجوانب الداخلية للساقين حيث تلتقي بجذع الإنسان) / شعبة, مفترق (منطقة الزاوية المتكونة من تقاطع فرعين)\nمثال: أخذوا المفترق الجنوبي",
 "跨線橋": "جسر علوي (جسر يتشكل من المستوى العلوي لتقاطع طريقين سريعين على مستويات مختلفة)",
 "跨道橋": "جسر علوي (جسر يتشكل من المستوى العلوي لتقاطع طريقين سريعين على مستويات مختلفة)",
 "跪く": "رَكَعَ, جَثَا ((رَكَعَ) رَكْعًا، ورُكوعًا: انحنى، سواءٌ؛ مَسّتْ ركبتاه الأرض أم لا)",
 "跫音": "خطوة, موطئ قدم (فعل اتخاذ خطوة في المشي) / خطوة, وقع الأقدام (صوت خطوة شخص يمشي) / خطوة (المسافة التي تغطيها خطوة)\nمثال: سمع وقع أقدام على الشرفة",
 "路": "طَرِيق, سِكَّة (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "路上": "على الطريق, في جولة (التجوال في الأرجاء)\nمثال: أخذوا العرض في جولة / فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "路上強盗": "سلب بالإكراه, نشل بالعنف (اعتداء بقصد السرقة)",
 "路上活動": "جانبي, في الشارع (على جوانب الشوارع)\nمثال: ممنوع وقوف السيارات في الشارع في ساعة الذروة",
 "路上生活": "تشرد (حالة أو وضع عدم امتلاك منزل (خاصة حالة العيش في الشوارع))",
 "路上駐車": "جانبي, في الشارع (على جوانب الشوارع)\nمثال: ممنوع وقوف السيارات في الشارع في ساعة الذروة",
 "路傍": "جانب الطريق (حافة طريق أو مسار)\nمثال: زهور على جانب الطريق",
 "路傍の人": "أجنبي, دخيل (شخص مستبعد أو ليس عضواً في مجموعة معينة) / متسابق غير مرشح (متسابق (إنسان أو حيوان) لا يُعتقد أن لديه فرصة جيدة للفوز)",
 "路地": "زُقَاق",
 "路地裏": "حارة, زقاق (شارع ضيق بجدران على كلا الجانبين)",
 "路導": "خُنْفُسَاء نَمِرِيَّة",
 "路床": "أساس الطريق (طبقة أساس تدعم طريقاً)",
 "路標": "عَلَامَةُ طَرِيق, لَافِتَةُ مُرُور (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "路次": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "路盤": "أساس الطريق (طبقة أساس تدعم طريقاً)",
 "路程": "بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "路線": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "路線変更": "انقلاب في الموقف, تحول تام (تغيير كبير في الموقف أو المبدأ أو وجهة النظر)\nمثال: تحول تام في السياسة الخارجية",
 "路線転換": "انقلاب في الموقف, تحول تام (تغيير كبير في الموقف أو المبدأ أو وجهة النظر)\nمثال: تحول تام في السياسة الخارجية",
 "路考茶": "بني مصفر, كراميل (لون أسمر متوسط إلى داكن)",
 "路肩": "كَتِف, كِتْف",
 "路面": "سطح الطريق (السطح المرصوف لطريق معبد)",
 "路面凍結": "سطح الطريق (السطح المرصوف لطريق معبد)",
 "路面電車": "تْرَام, تْرَامْوَاي",
 "路頭": "جانب الطريق (حافة طريق أو مسار)\nمثال: زهور على جانب الطريق",
 "路駐": "جانبي, في الشارع (على جوانب الشوارع)\nمثال: ممنوع وقوف السيارات في الشارع في ساعة الذروة",
 "跳ね": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة. / رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "跳ねかける": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "跳ねっ返り": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة. / استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / شِفَاء, تَعَافِي / أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "跳ねる": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة. / رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / انفجار (عملية الانفجار أو التفرقع) / فورة, نوبة (فورة مفاجئة من النشاط (غالباً لسبب غير واضح)) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: انفجار الألعاب النارية أيقظ الأطفال",
 "跳ね上がり": "قفز, وثب (فعل القفز؛ دفع النفس عن الأرض) / قفز (فعل المشاركة في منافسة رياضية يجب عليك فيها القفز)\nمثال: تقدم بسلسلة من القفزات / تهور, طيش (سمة إيلاء القليل من التفكير للخطر) / رعونة, طيش (سمة التصرف برعونة وبدون تعقل)",
 "跳ね上がり者": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "跳ね上がる": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة. / يتسرع",
 "跳ね上げ": "قَابِل لِلرَّفْع (مصمّم بحيث يمكن رفعه أو طيه جانباً)",
 "跳ね上げる": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / تنزه جبلي, سير طويل (مشي طويل عادة للرياضة أو المتعة) / زيادة الأجور, زيادة الراتب (المبلغ الذي يزاد به الراتب) / ارتفاع, زيادة (زيادة في التكلفة)\nمثال: تستمتع بنزهة جبلية في وقت فراغها",
 "跳ね上げ戸": "باب أرضي, باب سحري (باب مفصلي أو منزلق في أرضية أو سقف)",
 "跳ね上り": "قفز, وثب (فعل القفز؛ دفع النفس عن الأرض) / قفز (فعل المشاركة في منافسة رياضية يجب عليك فيها القفز)\nمثال: تقدم بسلسلة من القفزات / تهور, طيش (سمة إيلاء القليل من التفكير للخطر) / رعونة, طيش (سمة التصرف برعونة وبدون تعقل)",
 "跳ね掛ける": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "跳ね板": "منطلق",
 "跳ね橋": "جسر قلاب, جسر متحرك (جسر يمكن رفعه لقطع الطريق أو للسماح للقوارب أو السفن بالمرور تحته)",
 "跳ね返す": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / هجوم مضاد ((شطرنج) هجوم يهدف إلى مواجهة ميزة الخصم في جزء آخر من الرقعة) / هجوم مضاد (هجوم من قبل قوة مدافعة ضد قوة عدو مهاجمة لاستعادة أرض مفقودة أو قطع وحدات العدو المتقدمة)",
 "跳ね返り": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / شِفَاء, تَعَافِي / أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "跳ね返る": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "跳ね除ける": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "跳ね飛ばす": "تطاير, طرطشة (ضجيج شيء يتناثر أو يطرطش بشكل انفجاري) / رشة, لطخة (كمية صغيرة من شيء رطب أو سائل)\nمثال: سمع طرطشة نيران",
 "跳び": "طيران (حالة السفر جواً) / خَاطِف, عَابِر (سريع وقصير؛ على عجل) / سَرِيع الحَرَكَة, طَائِر (يتحرك بسرعة كبيرة)\nمثال: كان الطيران لا يزال مغامرة مثيرة بالنسبة له / صِفْر, ٠ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / مثال: بدأ سامي من نقطة الصفر. / سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي القصير) / قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "跳びはねる": "نَقْز / نَقَزَ",
 "跳び出る": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم.",
 "跳び板": "منطلق",
 "跳び箱": "حصان القفز, حصان طويل (حصان جمباز بدون مقابض وبطرف ممدود؛ يستخدم طولياً للقفز)",
 "跳び虫": "قافزات الذيل (أي من الحشرات البدائية الدقيقة عديمة الأجنحة العديدة التي تمتلك زائدة بطنية خاصة تسمح بنمط القفز المميز شبه الدائم؛ توجد في التربة الغنية بالحطام…)",
 "跳び跳ねる": "نَقْز / نَقَزَ",
 "跳び蹴り": "ركلة إسقاط ((كرة القدم الأمريكية) ركل (كما لهدف ميداني) حيث يتم إسقاط الكرة وركلها لحظة ملامستها للأرض)",
 "跳ぶ": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة. / قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة. / ترشيش, طرطشة / عَجَلَة / أَسْرَعَ, اِنْدَفَعَ (أَسْرَعَ: ( فعل )؛ أَسْرَعُ)\nمثال: أسرع و إلا تأخرت.",
 "跳弾": "ارتداد, وثبة (ارتداد جانبي)",
 "跳板": "منطلق",
 "跳梁": "هَيْمَنَة, سَيْطَرَة",
 "跳梁跋扈": "هَيْمَنَة, سَيْطَرَة",
 "跳箱": "حصان القفز, حصان طويل (حصان جمباز بدون مقابض وبطرف ممدود؛ يستخدم طولياً للقفز)",
 "跳虫": "قافزات الذيل (أي من الحشرات البدائية الدقيقة عديمة الأجنحة العديدة التي تمتلك زائدة بطنية خاصة تسمح بنمط القفز المميز شبه الدائم؛ توجد في التربة الغنية بالحطام…)",
 "跳躍": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "跳躍距離": "مسافة القفز (أقصر مسافة تسمح لإشارات الراديو (بتردد معين) بالانتقال من المرسل إلى المستقبل عن طريق الانعكاس من الأيونوسفير)",
 "跳開橋": "جسر قلاب, جسر متحرك (جسر يمكن رفعه لقطع الطريق أو للسماح للقوارب أو السفن بالمرور تحته)",
 "跳馬": "حصان القفز, حصان طويل (حصان جمباز بدون مقابض وبطرف ممدود؛ يستخدم طولياً للقفز)",
 "跳鯊": "سمكة الطين, نطاط الطين (توجد في المناطق الساحلية الاستوائية في أفريقيا وآسيا؛ قادرة على التحرك على اليابسة باستخدام زعانف صدرية قوية)",
 "践む": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا. / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان. / تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء",
 "践祚": "اعتلاء, تولي (فعل الوصول أو الحصول على منصب جديد أو حق (خاصة العرش)) / حق الدخول, دخول (الحق في الدخول) / إذعان, انضمام (الموافقة على أو القبول بـ (غالبًا على مضض)) / إضافة, مُقتنى جديد (شيء يضاف إلى ما تمتلكه بالفعل)\nمثال: اعتلاء إليزابيث العرش في عام 1558",
 "踈雨": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "踊": "رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / شطيح / رَقَصَ, رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)",
 "踊った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "踊らす": "أَضَلَّ",
 "踊らせる": "أَضَلَّ",
 "踊り": "رقص (القيام بسلسلة من الخطوات (والحركات) الإيقاعية المتناغمة مع الموسيقى) / مقتل, نقطة ضعف (مكان ذو قابلية خاصة للإصابة) / يافوخ (أي فجوة غشائية بين عظام الجمجمة عند الرضيع أو الجنين) / معزة خاصة, نقطة ضعف (عاطفة وجدانية)\nمثال: كانت لديها معزة خاصة لابنها الأصغر",
 "踊り場": "صَالَةُ رَقْص (مكان فسيح في وسط المسكن يُوصِلُ إلى سائر الحجرات، الرُدْهَة؛ غُرْفَةُ المَعِيْشَة سواء كانت توصل إلى سائر الحجرات أم لا وسواء كانت فسيحة أم لا)\nمثال: حجزت الصالة يوم الخميس. / هُبُوط / بَسْطَة / رُكُود / ركود اقتصادي",
 "踊り子": "رَاقِص, رَاقِصَة",
 "踊り子草": "قراص أبيض, لاميون أبيض (نبات قراص أوروبي ميت بزهور بيضاء)",
 "踊り字": "أيضاً, علامة التكرار (علامة تُستخدم للإشارة إلى تكرار الكلمة الموجودة أعلاها)",
 "踊り手": "رَاقِص, رَاقِصَة",
 "踊り歌": "بَالَاد",
 "踊る": "رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / شطيح / رَقَصَ, رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "踊場": "صَالَةُ رَقْص (مكان فسيح في وسط المسكن يُوصِلُ إلى سائر الحجرات، الرُدْهَة؛ غُرْفَةُ المَعِيْشَة سواء كانت توصل إلى سائر الحجرات أم لا وسواء كانت فسيحة أم لا)\nمثال: حجزت الصالة يوم الخميس. / هُبُوط / بَسْطَة / رُكُود / ركود اقتصادي",
 "踊子": "رَاقِص, رَاقِصَة",
 "踊子草": "قراص أبيض, لاميون أبيض (نبات قراص أوروبي ميت بزهور بيضاء)",
 "踊手": "رَاقِص, رَاقِصَة",
 "踊歌": "بَالَاد",
 "踏まえる": "أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "踏みあと": "أَثَر قَدَم (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "踏みあるく": "تنزه جبلي, سير طويل (مشي طويل عادة للرياضة أو المتعة) / سفينة شحن متجولة (باخرة تجارية للإيجار؛ ليس لها جدول زمني منتظم) / دوس, وقع أقدام ثقيلة (وقع أقدام ثقيل) / رحالة, متجول (مسافر على الأقدام؛ شخص يذهب في نزهة طويلة (للمتعة))\nمثال: تستمتع بنزهة جبلية في وقت فراغها",
 "踏みいれる": "دَخَلَ عَلَى (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "踏みこたえる": "تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ",
 "踏みしだく": "دَعَسَ, وَطِئَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ: شِدَّةُ الَوطْء)",
 "踏みつけ": "مَرْعَى, سْتِيب / بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "踏みつける": "تَجَاهَلَ, طَنَّش",
 "踏みつぶす": "دَعَسَ, وَطِئَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ: شِدَّةُ الَوطْء)",
 "踏みとどまる": "بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة كونه واجبَ الوجود لذاته ، فهو الأوّل بلا ابتداء ، والآخر بلا انتهاء؛ الباقي الثابتُ بعد غيره) / بَقِيَ, مَكَثَ (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: الباقي ليس مهم. / وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "踏み付け": "مَرْعَى, سْتِيب / بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "踏み付ける": "تَجَاهَلَ, طَنَّش",
 "踏み倒す": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "踏み入る": "أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "踏み入れる": "دَخَلَ عَلَى (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "踏み出す": "يقرب / نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "踏み切": "تقاطع سكة حديد, مزلقان (تقاطع سكة حديد وطريق على نفس المستوى؛ تغلق الحواجز الطريق عند مرور القطارات) / خط البداية (خط يشير إلى موقع بدء سباق أو لعبة) / عَزِيمَة",
 "踏み切り": "تقاطع سكة حديد, مزلقان (تقاطع سكة حديد وطريق على نفس المستوى؛ تغلق الحواجز الطريق عند مرور القطارات) / خط البداية (خط يشير إلى موقع بدء سباق أو لعبة) / عَزِيمَة",
 "踏み切り番": "بَوَّاب, حارِس الباب (شخص يحرس مدخلاً) / حَارِس الْبَوَّابَة, مُرَاقِب الدُّخُول (شخص يتحكم في الوصول إلى شيء ما)\nمثال: يوجد الكثير من مراقبي الدخول بين الضباط الميدانيين والرئيس",
 "踏み切る": "خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ) / أَقْلَعَ / اِزْدَهَرَ\nمثال: خلع سامي حذاءه. / قَرَّرَ, صَمَّمَ / قَرَّرَ",
 "踏み切遮断機": "تقاطع سكة حديد, مزلقان (تقاطع سكة حديد وطريق على نفس المستوى؛ تغلق الحواجز الطريق عند مرور القطارات)",
 "踏み台": "مِقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَقْعَدَة / بِرَاز\nمثال: نام ياني على مقعد. / حجر أساس, نقطة انطلاق (أي وسيلة للتقدم) / حَجَرُ عُبُور (حجر في مستنقع أو مياه ضحلة يمكن الوقوف عليه للعبور)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء",
 "踏み堪える": "تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ",
 "踏み外す": "نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)",
 "踏み拉く": "دَعَسَ, وَطِئَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ: شِدَّةُ الَوطْء)",
 "踏み板": "لَوْحَة, خَشَبَة / لَوْحَة, لَوْح / مَجْلِس, لَجْنَة / اِسْتَقَلَّ, صَعِدَ / خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة / دَوَّاسَة / قَدَمِيّ",
 "踏み止まる": "بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة كونه واجبَ الوجود لذاته ، فهو الأوّل بلا ابتداء ، والآخر بلا انتهاء؛ الباقي الثابتُ بعد غيره) / بَقِيَ, مَكَثَ (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: الباقي ليس مهم. / وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "踏み歩く": "تنزه جبلي, سير طويل (مشي طويل عادة للرياضة أو المتعة) / سفينة شحن متجولة (باخرة تجارية للإيجار؛ ليس لها جدول زمني منتظم) / دوس, وقع أقدام ثقيلة (وقع أقدام ثقيل) / رحالة, متجول (مسافر على الأقدام؛ شخص يذهب في نزهة طويلة (للمتعة))\nمثال: تستمتع بنزهة جبلية في وقت فراغها",
 "踏み段": "خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة",
 "踏み潰す": "دَعَسَ, وَطِئَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ: شِدَّةُ الَوطْء)",
 "踏み留まる": "بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة كونه واجبَ الوجود لذاته ، فهو الأوّل بلا ابتداء ، والآخر بلا انتهاء؛ الباقي الثابتُ بعد غيره) / بَقِيَ, مَكَثَ (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: الباقي ليس مهم. / وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "踏み石": "حجر أساس, نقطة انطلاق (أي وسيلة للتقدم) / حَجَرُ عُبُور (حجر في مستنقع أو مياه ضحلة يمكن الوقوف عليه للعبور)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء",
 "踏み破る": "دَعَسَ, وَطِئَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ: شِدَّةُ الَوطْء) / اِجْتَازَ, عَبَرَ",
 "踏み立てる": "خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة",
 "踏み継ぎ": "مِقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَقْعَدَة / بِرَاز\nمثال: نام ياني على مقعد.",
 "踏み荒す": "دَعَسَ, وَطِئَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ: شِدَّةُ الَوطْء)",
 "踏み荒らす": "دَعَسَ, وَطِئَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ: شِدَّةُ الَوطْء)",
 "踏み越える": "هَزَمَ, غَلَبَ",
 "踏み跡": "أَثَر قَدَم (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "踏み車": "طاحونة الدوس (طاحونة تعمل بقوة الرجال أو الحيوانات الذين يمشون على حزام دائري أو يتسلقون درجات)",
 "踏み込み": "ركن, مقصورة (تجويف صغير يفتح على غرفة أكبر)",
 "踏み込む": "مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "踏み迷う": "ضَلَّ",
 "踏み違える": "عثرة, كبوة (خطأ غير مقصود ولكنه محرج)\nمثال: تلا القصيدة كاملة دون عثرة واحدة",
 "踏み面": "دَعَسَ, دَاسَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ: شِدَّةُ الَوطْء)",
 "踏む": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا. / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان. / تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء",
 "踏ん切り": "عَزِيمَة",
 "踏ん切りがつく": "وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "踏ん切りが付く": "وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "踏ん張る": "ثَابَرَ",
 "踏付ける": "تَجَاهَلَ, طَنَّش",
 "踏倒す": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "踏切": "تقاطع سكة حديد, مزلقان (تقاطع سكة حديد وطريق على نفس المستوى؛ تغلق الحواجز الطريق عند مرور القطارات) / خط البداية (خط يشير إلى موقع بدء سباق أو لعبة) / عَزِيمَة",
 "踏切り": "تقاطع سكة حديد, مزلقان (تقاطع سكة حديد وطريق على نفس المستوى؛ تغلق الحواجز الطريق عند مرور القطارات) / خط البداية (خط يشير إلى موقع بدء سباق أو لعبة) / عَزِيمَة",
 "踏切る": "خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ) / أَقْلَعَ / اِزْدَهَرَ\nمثال: خلع سامي حذاءه. / قَرَّرَ, صَمَّمَ / قَرَّرَ",
 "踏切番": "بَوَّاب, حارِس الباب (شخص يحرس مدخلاً) / حَارِس الْبَوَّابَة, مُرَاقِب الدُّخُول (شخص يتحكم في الوصول إلى شيء ما)\nمثال: يوجد الكثير من مراقبي الدخول بين الضباط الميدانيين والرئيس",
 "踏切遮断機": "تقاطع سكة حديد, مزلقان (تقاطع سكة حديد وطريق على نفس المستوى؛ تغلق الحواجز الطريق عند مرور القطارات)",
 "踏台": "مِقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَقْعَدَة / بِرَاز\nمثال: نام ياني على مقعد. / حجر أساس, نقطة انطلاق (أي وسيلة للتقدم) / حَجَرُ عُبُور (حجر في مستنقع أو مياه ضحلة يمكن الوقوف عليه للعبور)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء",
 "踏板": "لَوْحَة, خَشَبَة / لَوْحَة, لَوْح / مَجْلِس, لَجْنَة / اِسْتَقَلَّ, صَعِدَ / خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة / دَوَّاسَة / قَدَمِيّ",
 "踏査": "اِسْتِبَانَة, اِسْتِطْلَاع",
 "踏段": "خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة",
 "踏石": "حجر أساس, نقطة انطلاق (أي وسيلة للتقدم) / حَجَرُ عُبُور (حجر في مستنقع أو مياه ضحلة يمكن الوقوف عليه للعبور)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء",
 "踏継ぎ": "مِقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَقْعَدَة / بِرَاز\nمثال: نام ياني على مقعد.",
 "踏荒らす": "دَعَسَ, وَطِئَ (الدَّعْسُ، كالمَنْعِ: حَشْوُ الوِعَاءِ، وَقد دَعَسَه: حَشَاهُ. والدَّعْسُ: شِدَّةُ الَوطْء)",
 "踏襲": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "踏車": "طاحونة الدوس (طاحونة تعمل بقوة الرجال أو الحيوانات الذين يمشون على حزام دائري أو يتسلقون درجات)",
 "踏鳴": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "踝": "كَاحِل, كَعْب",
 "踞う": "انحناء, جثوم (عملية الانحناء المنخفض مع ضم الأطراف للجسم)",
 "踪跡": "أَثَر قَدَم (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "踰越": "فَائِق, هَائِل (يتجاوز بكثير ما هو معتاد في الحجم أو الدرجة) / تصالب, عبور (تبادل الأجزاء بين الكروموسومات المتماثلة المقترنة أثناء الطور الأول من الانقسام المنصف)",
 "踵": "عَقِب, كَعْب / كَعْب",
 "踵を返す": "اِنْقَلَبَ عَلَى عَقِبَيْهِ نَكَصَ عَلَى عَقِبَيْهِ",
 "踵骨": "عظم العقب, عظم الكعب (أكبر عظام الرصغ؛ يشكل كعب الإنسان)",
 "蹁躚": "مُدْهِش, مُذْهِل (مُثير للإعجاب بشكل مُفاجئ لدرجة الذهول أو الإرباك)",
 "蹂躙": "مِسَاس",
 "蹂躪": "مِسَاس",
 "蹄": "حافِر, ظِلْف",
 "蹄叉": "ضِفْدِع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضَفْدَع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضِفْدَع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضفدع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / بقرور\nمثال: الضفدع في البئر.",
 "蹄球": "انتفاخ, بصيلة (جزء مستدير من أداة أسطوانية (عادة في أحد الطرفين)) / لمبة, مصباح كهربائي (مصباح كهربائي يتكون من غلاف زجاجي شفاف أو نصف شفاف يحتوي على فتيل سلكي (عادة من التنجستن) يبعث الضوء عند تسخينه بالكهرباء) / بَصَلَة (اتساع أو تمدد مستدير في قناة أو وعاء أو عضو) / بصلة السيساء, نخاع مستطيل (الجزء السفلي أو الخلفي من الدماغ؛ متصل بالحبل الشوكي)\nمثال: بصيلة المحقنة",
 "蹄葉炎": "التهاب الصفيحة (التهاب الأنسجة الصفائحية التي تربط الحافر بقدم الحصان)",
 "蹄鉄": "حَدْوَة, حِدْوَة",
 "蹄鉄工": "بَيْطَار",
 "蹇": "ركاكة, ضعف (نقص أو عيب (خاصة في الحجج أو الأعمال الأدبية)) / عرج (إعاقة في المشي بسبب عجز في الساقين أو القدمين)\nمثال: كاتب مشهور بركاكة حبكاته",
 "蹉だ": "نَكْسَة / بُؤْس, ضَنْك (الفُقْر والشِدَّة وضِيق الحال)\nمثال: عانى الكثيرون الظلم والبؤس ردحا من الزمن تحت حكم الإستعمار.",
 "蹉跌": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "蹉跎": "نَكْسَة / بُؤْس, ضَنْك (الفُقْر والشِدَّة وضِيق الحال)\nمثال: عانى الكثيرون الظلم والبؤس ردحا من الزمن تحت حكم الإستعمار.",
 "蹌々": "بشدة, بشكل هائل (بدرجة كبيرة جداً)\nمثال: كان محبوباً بشكل هائل",
 "蹌踉": "آيِل لِلسُّقُوط, مُتَدَاعٍ ((للهياكل أو المؤسسات) فقد استقراره؛ يتهاوى أو على وشك الانهيار) / مُتَخَاذِل, مُتَهَالِك (غير ثابت في مشيته بسبب الوهن أو الشيخوخة)",
 "蹌踉つく": "تَرَنُّح / تَرَنَّحَ",
 "蹌蹌": "بشدة, بشكل هائل (بدرجة كبيرة جداً)\nمثال: كان محبوباً بشكل هائل",
 "蹠球": "وِسَادَة (الجانب السفلي اللحمي الشبيه بالوسادة لقدم الحيوان أو إصبع الإنسان) / سكن مؤقت (أماكن معيشة مؤقتة) / منصة إطلاق (منصة تطلق منها الصواريخ أو المركبات الفضائية) / حشوة, لبادة (كتلة مسطحة من مادة ناعمة تستخدم للحماية أو الحشو أو الراحة)",
 "蹠行性": "أخمضي السير, مترجل على باطن القدم ((عن الثدييات) السير على كامل باطن القدم (كما تفعل الأرانب والراكون والدببة والبشر)) / حيوان أخمصي السير (حيوان يمشي بحيث يلامس باطن القدم بالكامل الأرض مثل الدببة والبشر)",
 "蹠骨": "مُشْط اَلْقَدَم (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "蹣跚": "مُدْهِش, مُذْهِل (مُثير للإعجاب بشكل مُفاجئ لدرجة الذهول أو الإرباك)",
 "蹲う": "انحناء, جثوم (عملية الانحناء المنخفض مع ضم الأطراف للجسم)",
 "蹲む": "صَغِير وَثَخِين / قُرْفُصَاء / جَثَمَ (وجَثَم فُلَانٌ بالأَرضَ يَجْثُم جُثومًا: لصِق بِهَا ولَزِمها؛ قَالَ النَّابِغَةُ يصِف رَكَبَ امرأَةٍ)",
 "蹲る": "انحناء, جثوم (عملية الانحناء المنخفض مع ضم الأطراف للجسم)",
 "蹲踞": "انحناء, جثوم (عملية الانحناء المنخفض مع ضم الأطراف للجسم)",
 "蹴り": "رَفَسَ (رَفَسَهُ ضربه برجله وبابه ضرب؛ الرفْسُ: الصدْمَةُ بالرجْلِ في الصدْرِ. والرفَاسُ: الإبَاضُ الذي يُشَد به رِجْلا البَعِيرِ بارِكاً إلى وَرِكَيْه) / رَكَلَ (رَكَلَهُ، يَرْكُلُهُ، رَكْلًا، وَقيل: هُوَ الرَّكْضُ بالرِّجْلِ، وقيلِ: هُوَ الرَّفْسُ، وَقيل: الضَّرْبُ بالأرْجُلِ) / رَكْلَة\nمثال: فريد ركل الكرة.",
 "蹴りあげる": "ركلة للأعلى (رفع القدمين للخلف مع وضع اليدين على الأرض؛ حركة أولى للقيام بالوقوف على اليدين)",
 "蹴りつける": "رَفَسَ (رَفَسَهُ ضربه برجله وبابه ضرب؛ الرفْسُ: الصدْمَةُ بالرجْلِ في الصدْرِ. والرفَاسُ: الإبَاضُ الذي يُشَد به رِجْلا البَعِيرِ بارِكاً إلى وَرِكَيْه) / رَكَلَ (رَكَلَهُ، يَرْكُلُهُ، رَكْلًا، وَقيل: هُوَ الرَّكْضُ بالرِّجْلِ، وقيلِ: هُوَ الرَّفْسُ، وَقيل: الضَّرْبُ بالأرْجُلِ) / رَكْلَة\nمثال: فريد ركل الكرة.",
 "蹴りを入れる": "رَفَسَ (رَفَسَهُ ضربه برجله وبابه ضرب؛ الرفْسُ: الصدْمَةُ بالرجْلِ في الصدْرِ. والرفَاسُ: الإبَاضُ الذي يُشَد به رِجْلا البَعِيرِ بارِكاً إلى وَرِكَيْه) / رَكَلَ (رَكَلَهُ، يَرْكُلُهُ، رَكْلًا، وَقيل: هُوَ الرَّكْضُ بالرِّجْلِ، وقيلِ: هُوَ الرَّفْسُ، وَقيل: الضَّرْبُ بالأرْجُلِ) / رَكْلَة\nمثال: فريد ركل الكرة.",
 "蹴り上げる": "ركلة للأعلى (رفع القدمين للخلف مع وضع اليدين على الأرض؛ حركة أولى للقيام بالوقوف على اليدين)",
 "蹴り付ける": "رَفَسَ (رَفَسَهُ ضربه برجله وبابه ضرب؛ الرفْسُ: الصدْمَةُ بالرجْلِ في الصدْرِ. والرفَاسُ: الإبَاضُ الذي يُشَد به رِجْلا البَعِيرِ بارِكاً إلى وَرِكَيْه) / رَكَلَ (رَكَلَهُ، يَرْكُلُهُ، رَكْلًا، وَقيل: هُوَ الرَّكْضُ بالرِّجْلِ، وقيلِ: هُوَ الرَّفْسُ، وَقيل: الضَّرْبُ بالأرْجُلِ) / رَكْلَة\nمثال: فريد ركل الكرة.",
 "蹴り入れる": "رَفَسَ (رَفَسَهُ ضربه برجله وبابه ضرب؛ الرفْسُ: الصدْمَةُ بالرجْلِ في الصدْرِ. والرفَاسُ: الإبَاضُ الذي يُشَد به رِجْلا البَعِيرِ بارِكاً إلى وَرِكَيْه) / رَكَلَ (رَكَلَهُ، يَرْكُلُهُ، رَكْلًا، وَقيل: هُوَ الرَّكْضُ بالرِّجْلِ، وقيلِ: هُوَ الرَّفْسُ، وَقيل: الضَّرْبُ بالأرْجُلِ) / رَكْلَة\nمثال: فريد ركل الكرة.",
 "蹴る": "رَفَسَ (رَفَسَهُ ضربه برجله وبابه ضرب؛ الرفْسُ: الصدْمَةُ بالرجْلِ في الصدْرِ. والرفَاسُ: الإبَاضُ الذي يُشَد به رِجْلا البَعِيرِ بارِكاً إلى وَرِكَيْه) / رَكَلَ (رَكَلَهُ، يَرْكُلُهُ، رَكْلًا، وَقيل: هُوَ الرَّكْضُ بالرِّجْلِ، وقيلِ: هُوَ الرَّفْسُ، وَقيل: الضَّرْبُ بالأرْجُلِ) / رَكْلَة\nمثال: فريد ركل الكرة. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "蹴上": "قائمة الدرجة (عضو هيكلي يتكون من الجزء الرأسي لدرج أو خطوة) / أنبوب صاعد (أنبوب رأسي في مبنى) / مُسْتَيْقِظ, نَاهِض (شخص ينهض (خاصة من الفراش))\nمثال: هو عادة ناهض متأخر",
 "蹴上がり": "رَفَسَ (رَفَسَهُ ضربه برجله وبابه ضرب؛ الرفْسُ: الصدْمَةُ بالرجْلِ في الصدْرِ. والرفَاسُ: الإبَاضُ الذي يُشَد به رِجْلا البَعِيرِ بارِكاً إلى وَرِكَيْه) / رَكَلَ (رَكَلَهُ، يَرْكُلُهُ، رَكْلًا، وَقيل: هُوَ الرَّكْضُ بالرِّجْلِ، وقيلِ: هُوَ الرَّفْسُ، وَقيل: الضَّرْبُ بالأرْجُلِ) / رَكْلَة\nمثال: فريد ركل الكرة.",
 "蹴上げ": "قائمة الدرجة (عضو هيكلي يتكون من الجزء الرأسي لدرج أو خطوة) / أنبوب صاعد (أنبوب رأسي في مبنى) / مُسْتَيْقِظ, نَاهِض (شخص ينهض (خاصة من الفراش))\nمثال: هو عادة ناهض متأخر",
 "蹴上げる": "ركلة للأعلى (رفع القدمين للخلف مع وضع اليدين على الأرض؛ حركة أولى للقيام بالوقوف على اليدين)",
 "蹴合い": "مصارعة الديوك (المشاركة في رياضة مطابقة ديوك المصارعة في قتال)",
 "蹴子": "لافظ الخرطوش (آلية في سلاح ناري تلفظ غلاف القذيفة الفارغ بعد الإطلاق) / طَارِد, مُقْصٍ (شخص يطرد شخصاً آخر أو يحل محله) / حاقن بخاري, ضاغط حراري (الحاقن أو اللافظ أو الحاقن البخاري أو المضخة النفاثة هو نوع من المضخات)\nمثال: بناءً على التطبيق المحدد، يمكن للحاقن أن يتخذ شكل مضخة نفاثة، أو قاذف مياه، أو قاذف تفريغ، أو قاذف بخار نفاث، أو شفاط",
 "蹴放し": "عَتَبَة / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "蹴散らす": "نَثَرَ, تَفَرَّقَ",
 "蹴爪": "مِهْمَاز / رمكة (نتوء خلف وفوق حافر الحصان) / مفصل الرمكة (المفصل بين عظم المدفع والرسغ في الخيل)",
 "蹴球": "كُرَة اَلْقَدَم",
 "蹴球場": "ملعب كرة قدم (ملعب رياضي ذو أبعاد محددة لممارسة كرة القدم)",
 "蹴破る": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / دحر, هزيمة منكرة (هزيمة ساحقة) / رعاع, غوغاء (حشد غير منظم من الناس)",
 "蹴立てる": "ركلة للأعلى (رفع القدمين للخلف مع وضع اليدين على الأرض؛ حركة أولى للقيام بالوقوف على اليدين)",
 "蹴躓く": "عَثْرَة / تَلَعْثَمَ (اضطرب في كلامه) / عَثَرَ / أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "蹴込み": "قائمة الدرجة (عضو هيكلي يتكون من الجزء الرأسي لدرج أو خطوة) / أنبوب صاعد (أنبوب رأسي في مبنى) / مُسْتَيْقِظ, نَاهِض (شخص ينهض (خاصة من الفراش))\nمثال: هو عادة ناهض متأخر",
 "蹴飛ばし": "لَحْم حِصَان (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)",
 "蹴飛ばした": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "蹴飛ばす": "رَفَسَ (رَفَسَهُ ضربه برجله وبابه ضرب؛ الرفْسُ: الصدْمَةُ بالرجْلِ في الصدْرِ. والرفَاسُ: الإبَاضُ الذي يُشَد به رِجْلا البَعِيرِ بارِكاً إلى وَرِكَيْه) / رَكَلَ (رَكَلَهُ، يَرْكُلُهُ، رَكْلًا، وَقيل: هُوَ الرَّكْضُ بالرِّجْلِ، وقيلِ: هُوَ الرَّفْسُ، وَقيل: الضَّرْبُ بالأرْجُلِ) / رَكْلَة\nمثال: فريد ركل الكرة.",
 "蹶然": "بِإِصْرَار, بِعَزْم (إظهار تصميم أو هدف حازم) / بِتَصْمِيم, بِحَزْم (بثبات الهدف)\nمثال: رفضت بحزم النظر إليه أو التحدث معه",
 "蹼": "ويب / مِضْرَب / جَدَّفَ (معنى الفعل في سياقات متعددة تتراوح بين الطيران والسير، وحتى في الدلالات المجازية كالرمي والقطع؛ الفعل له معانٍ متعددة: رمي (كالسماء بالبرد)، الإسراع في المشي، كفر بالنعم وعدم الرضا بها، ودفع السفينة بالمجاديف)",
 "躁": "شغف جنوني, هوس (دافع غير عقلاني ولكنه لا يُقاوم لمعتقد أو فعل ما) / اضطراب الهوس, هوس (اضطراب مزاجي؛ اضطراب وجداني يميل فيه المصاب إلى الاستجابة بشكل مفرط وعنيف أحياناً)",
 "躁うつ": "اضطراب ثنائي القطب, الهوس الاكتئابي (اضطراب عقلي يتميز بنوبات من الهوس والاكتئاب)",
 "躁うつ病": "اضطراب ثنائي القطب, الهوس الاكتئابي (اضطراب عقلي يتميز بنوبات من الهوس والاكتئاب)",
 "躁うつ質": "اضطراب المزاج الدوري, دوروية المزاج (اضطراب ثنائي القطب خفيف يستمر لفترة طويلة)",
 "躁狂": "نوبة جنون, هياج (حالة من الهياج العقلي العنيف) / شغف جنوني, هوس (دافع غير عقلاني ولكنه لا يُقاوم لمعتقد أو فعل ما) / اضطراب الهوس, هوس (اضطراب مزاجي؛ اضطراب وجداني يميل فيه المصاب إلى الاستجابة بشكل مفرط وعنيف أحياناً)",
 "躁病": "شغف جنوني, هوس (دافع غير عقلاني ولكنه لا يُقاوم لمعتقد أو فعل ما) / اضطراب الهوس, هوس (اضطراب مزاجي؛ اضطراب وجداني يميل فيه المصاب إلى الاستجابة بشكل مفرط وعنيف أحياناً)",
 "躁転": "دَوْر, دَوْرَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: في أي دور تسكن؟",
 "躁鬱": "اضطراب ثنائي القطب, الهوس الاكتئابي (اضطراب عقلي يتميز بنوبات من الهوس والاكتئاب)",
 "躁鬱病": "اضطراب ثنائي القطب, الهوس الاكتئابي (اضطراب عقلي يتميز بنوبات من الهوس والاكتئاب)",
 "躁鬱質": "اضطراب المزاج الدوري, دوروية المزاج (اضطراب ثنائي القطب خفيف يستمر لفترة طويلة)",
 "躄": "مُقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "躄る": "خَلَطَ (اختلط) / مَشَى يَجُرُّ قَدَمَيْهِ, رَسَفَ (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص))\nمثال: خلط توم بين السكر و الملح.",
 "躄魚": "سمكة الضفدع (سمكة لها فم يشبه فم الضفدع مع طُعم على الخطم)",
 "躊む": "صَغِير وَثَخِين / قُرْفُصَاء / جَثَمَ (وجَثَم فُلَانٌ بالأَرضَ يَجْثُم جُثومًا: لصِق بِهَا ولَزِمها؛ قَالَ النَّابِغَةُ يصِف رَكَبَ امرأَةٍ)",
 "躊躇": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / تثاقل, تردد (درجة معينة من عدم الرغبة) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: كان هناك تردد في كلامه",
 "躊躇い": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / مُتَرَدِّد, مُتَلَعْثِم (غير ثابت في الكلام أو الفعل)\nمثال: كان هناك تردد في كلامه",
 "躊躇いながら": "بتردد, بتلعثم (بطريقة مترددة)\nمثال: تحدث بتلعثم",
 "躊躇う": "تَرَدَّدَ (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "躍らす": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / تَحَرَّكَ (حَرُكَ)\nمثال: لا أستطيع التحرك.",
 "躍らせる": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / تَحَرَّكَ (حَرُكَ)\nمثال: لا أستطيع التحرك.",
 "躍り": "قفزة, وثبة (حركة خفيفة ذاتية الدفع لأعلى أو للأمام)",
 "躍り出る": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "躍る": "وَثَبَ (طَفَرَ أو قَفَزَ وهو يجري) / بَاوْنْد / رَطْل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ) / جُنَيْه",
 "躍動": "خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَ, نَبَضَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَان",
 "躍動感": "حيوية, طاقة (أسلوب حيوي خيالي (خاصة أسلوب الكتابة)) / حيوية, نشاط (قوة نشطة للجسد أو العقل) / حيوية, طاقة (بذل قوي للجهد)\nمثال: تنقل كتابته طاقة كبيرة",
 "躍如": "حَيّ اللَّوْن, زَاهٍ ((للألوان) ذو أعلى درجة تشبع لوني) / زَاهٍ, سَاطِع (ذو ألوان قويّة وزاهية) / حَيّ, نَابِض (ذو وضوح ونضارة كأنّه تجربة مباشرة) / حَيّ, نَابِض (يستحضر صورًا حيّة ونابضة في الذهن)",
 "躍度": "رَعَشَة / يرتعش / يهز",
 "躍起": "يَائِس, قَانِط / مَيْئُوس مِنْهُ",
 "躍進": "اِنْدَفَعَ, أَسْرَعَ / سَمَار",
 "躑躅": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / تثاقل, تردد (درجة معينة من عدم الرغبة) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: كان هناك تردد في كلامه / أزاليا (أي من شجيرات الزينة العديدة التي تُزرع لزهورها المبهرجة ذات الألوان المختلفة)",
 "躓き": "عَثْرَة / تَلَعْثَمَ (اضطرب في كلامه) / عَثَرَ / فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "躓く": "هَذَيَان / هَذَى / أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "身": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / لَحْم, لحمة (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر. / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "身がまえ": "وَضْعِيَّة",
 "身がる": "رَشِيق, خَفِيف اَلْحَرَكَة / سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / عَابِث, لَامُبَالٍ (يَتَّسِمُ بِعَدَمِ الِاكْتِرَاثِ وَالِاسْتِهْتَارِ) / بِلَا جُهْد, يَسِير (لَا يُظْهِر جُهْدًا أَوْ إِجْهَادًا) / عَادِيّ, يَوْمِيّ (مُنَاسِبٌ لِلْمُنَاسَبَاتِ العَادِيَّةِ أَوِ الرُّوتِينِيَّةِ) / مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ",
 "身が引き締まる": "دَاعٍ إِلَى الجِدِّيَّة, مُنَبِّه (يميل إلى جعل المرء أكثر جدّية ورصانة)",
 "身が引締まる": "دَاعٍ إِلَى الجِدِّيَّة, مُنَبِّه (يميل إلى جعل المرء أكثر جدّية ورصانة)",
 "身が細る": "فَقَدَ وَزْن",
 "身ぎれい": "دَقِيق, مُتْقَن (خالٍ من الخَرَق؛ مُنفَّذ بدقة ومهارة) / صِرْف, غَيْر مَمْزُوج ((عَنِ المَشْرُوب الكُحُولِيّ) بِدُون مَاء) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / أَنِيق ظَاهِرِيًّا, بَرَّاق (يبدو مؤثّرًا من السطح لكنّه يفتقر إلى العمق والدقّة)",
 "身ごしらえ": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / ثَوْب, لِبَاس (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء) / كَسْوَة, مَلْبَس\nمثال: لبس سروالا نظيفا.",
 "身ごなし": "خفة الحركة, مرونة (رشاقة شخص أو حيوان سريع وخفيف الحركة)",
 "身じろぎ": "تحريك, تقليب (تحريك سائل باستخدام أداة) / إلهام, تحريك المشاعر (الاستنهاض لعاطفة أو فعل معين) / مُثِير, مُحَرِّك لِلْمَشَاعِر (يثير مشاعر قوية لكنها غير مزعجة) / حَمَاسِيّ, مُلْهِم (قادر على إثارة الحماس أو الإثارة)\nمثال: التحريك المستمر يمنعه من الاحتراق في قاع المقلاة",
 "身じろぐ": "تَحَرَّكَ (حَرُكَ)\nمثال: لا أستطيع التحرك.",
 "身だしなみ": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "身ども": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى."
}
