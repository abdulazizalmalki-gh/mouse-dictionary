 "頻りと": "غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة / بشوق, بلهفة\nمثال: كانت الأخبار منتظرة بلهفة / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "頻りに": "غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة / بشوق, بلهفة\nمثال: كانت الأخبار منتظرة بلهفة / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "頻回": "مُتَكَرِّر / اِرْتَادَ (لأهله: ذهب أمامهم رائدًا ليجد النجعة والكلاء؛ المكانَ: كان من روّادِه، أي من الذين كانوا فيه منذ البدء)",
 "頻度": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "頻度分布": "توزيع تكراري (توزيع التكرارات المرصودة لقيم متغير)",
 "頻度数": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "頻拍": "تسرع القلب",
 "頻数": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "頻繁": "مُتَكَرِّر / اِرْتَادَ (لأهله: ذهب أمامهم رائدًا ليجد النجعة والكلاء؛ المكانَ: كان من روّادِه، أي من الذين كانوا فيه منذ البدء)",
 "頻脈": "تسرع القلب",
 "頻闇": "حلكة, سواد (الغياب التام للضوء)\nمثال: تحسسوا طريقهم في ظلام دامس",
 "頻頻": "غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة / باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل)\nمثال: العالم يتغير باستمرار",
 "頼み": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / اتكال, اعتماد (يقين مبني على الخبرة السابقة) / اتكال, اعتماد (حالة الاعتماد على شيء ما)\nمثال: كتب الورقة مع اعتماد كبير على عمل علماء آخرين",
 "頼みがい": "اعتمادية, موثوقية (جودة كون الشخص أو الشيء جديراً بالاعتماد أو الثقة)",
 "頼みごと": "تفضل, خدمة (عمل يتسم باللطف والتفضل) / هدية الحفل (تذكار عبارة عن هدية صغيرة تعطى للضيوف في حفلة) / تَأْيِيد, صَالِح (أفضلية تعود بالنفع على شخص أو شيء ما) / استحسان, قبول (الميل للموافقة والاستحسان)\nمثال: كانت النتيجة في صالحه",
 "頼み事": "تفضل, خدمة (عمل يتسم باللطف والتفضل) / هدية الحفل (تذكار عبارة عن هدية صغيرة تعطى للضيوف في حفلة) / تَأْيِيد, صَالِح (أفضلية تعود بالنفع على شخص أو شيء ما) / استحسان, قبول (الميل للموافقة والاستحسان)\nمثال: كانت النتيجة في صالحه",
 "頼み入る": "اِلْتَمَسَ, تَوَسَّلَ",
 "頼み少ない": "عَاجِز",
 "頼み甲斐": "اعتمادية, موثوقية (جودة كون الشخص أو الشيء جديراً بالاعتماد أو الثقة)",
 "頼む": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "頼むから": "لِوَجْهِ اللّٰهِ, مِنْ أَجْلِ اللّٰهِ",
 "頼もう": "عَفْوًا!, مَاذَا قُلْتَ؟",
 "頼もしい": "مَوْثُوق / مُشْرِق, وَاعِد (من المرجح أن يسير على نحو جيد في المستقبل) / متفائل, مفعم بالأمل (يمتلك أو يظهر أملاً) / طامح, طامع (شاب طموح ومتطلع)\nمثال: طابور من الناس يأملون في الحصول على تذاكر",
 "頼り": "اتكال, اعتماد (يقين مبني على الخبرة السابقة) / اتكال, اعتماد (حالة الاعتماد على شيء ما)\nمثال: كتب الورقة مع اعتماد كبير على عمل علماء آخرين",
 "頼りがい": "اعتمادية, موثوقية (جودة كون الشخص أو الشيء جديراً بالاعتماد أو الثقة)",
 "頼りない": "غير موثوق, لا يعول عليه (لا يستحق الاعتماد أو الثقة) / غَيْر مَوْثُوق, لَا يُعْتَمَد عَلَيْه (مُحْتَمَل أَنْ يَكُون خَاطِئًا أَوْ مُضَلِّلًا) / غَيْرُ مَوْثُوق (يفتقر إلى الإحساس بالمسؤولية) / غَدَّار, لَا يُوثَقُ بِهِ (غير مستقرّ وغير متوقَّع بشكل خطير)\nمثال: في أوائل الخمسينيات كانت الحواسيب كبيرة ومكلفة وغير موثوقة / عَاجِز / قَلِق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "頼り無い": "غير موثوق, لا يعول عليه (لا يستحق الاعتماد أو الثقة) / غَيْر مَوْثُوق, لَا يُعْتَمَد عَلَيْه (مُحْتَمَل أَنْ يَكُون خَاطِئًا أَوْ مُضَلِّلًا) / غَيْرُ مَوْثُوق (يفتقر إلى الإحساس بالمسؤولية) / غَدَّار, لَا يُوثَقُ بِهِ (غير مستقرّ وغير متوقَّع بشكل خطير)\nمثال: في أوائل الخمسينيات كانت الحواسيب كبيرة ومكلفة وغير موثوقة / عَاجِز / قَلِق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "頼り甲斐": "اعتمادية, موثوقية (جودة كون الشخص أو الشيء جديراً بالاعتماد أو الثقة)",
 "頽る": "اِنْقَرَضَ",
 "頽れる": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "頽勢": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "頽唐": "اضمحلال (نُقْصَان؛ انحطاط؛ عَجْز)",
 "頽廃": "نَخْر / اضمحل / تضعضع / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "顆": "لقمة (نتوء دائري على عظم حيث يشكل مفصلاً مع عظم آخر)",
 "顆粒": "حبيبة (حبة صغيرة جداً)",
 "顆粒剤": "حبيبة (حبة صغيرة جداً)",
 "顆粒層": "طبقة حبيبية (طبقة البشرة الواقعة تحت الطبقة المتقرنة مباشرة؛ تحتوي على خلايا (ذات حبيبات مرئية) تموت وتتحرك إلى السطح)",
 "顆粒性": "حُبَيْبِيّ, كُونْدِرِيتِيّ (لديه هيكل حبيبي مثل هيكل الكوندريت (النيازك الحجرية)) / حُبَيْبِيّ, مُحَبَّب (مؤلّف من جزيئات تشبه الدقيق في القوام أو مغطّى بها)",
 "顆粒状": "حُبَيْبِيّ, كُونْدِرِيتِيّ (لديه هيكل حبيبي مثل هيكل الكوندريت (النيازك الحجرية)) / حُبَيْبِيّ, مُحَبَّب (مؤلّف من جزيئات تشبه الدقيق في القوام أو مغطّى بها)",
 "顆粒球": "خلية محببة (خلية دم بيضاء تحتوي على حبيبات في السيتوبلازم)",
 "顆粒球減少症": "ندرة المحببات (اضطراب دموي حاد يتميز بانخفاض حاد في الخلايا المحببة)",
 "顆粒白血球": "خلية محببة (خلية دم بيضاء تحتوي على حبيبات في السيتوبلازم)",
 "題": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / عُنْوَان (عُنْوَان) / عِنْوَان (عُنْوَان) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة. / تَمْرِين / مَسْأَلَة",
 "題号": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / عُنْوَان (عُنْوَان) / عِنْوَان (عُنْوَان) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "題名": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / عُنْوَان (عُنْوَان) / عِنْوَان (عُنْوَان) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "題名なし": "بِلَا لَقَب, غَيْر نَبِيل (لا ينتمي إلى طبقة النبلاء)",
 "題名無し": "بِلَا لَقَب, غَيْر نَبِيل (لا ينتمي إلى طبقة النبلاء)",
 "題材": "فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "題目": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / عُنْوَان (عُنْوَان) / عِنْوَان (عُنْوَان) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة. / مَوْضُوع, مَوَاضِيع",
 "題言": "نقش أثري (نقش محفور) / عبارة استهلالية, نقش (اقتباس في بداية قطعة كتابية ما)",
 "題辞": "نقش أثري (نقش محفور) / عبارة استهلالية, نقش (اقتباس في بداية قطعة كتابية ما)",
 "額": "أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ) / وَرَّطَ / لَقْطَة\nمثال: دهنت أطر النافذة بالأصفر. / مَبْلَغ, مِقْدَار / بَلَغَ / جَبْهَة, جَبِين",
 "額が少ない": "غير كافٍ, قاصر (كمية غير قادرة على تلبية حاجة أو متطلب)\nمثال: أموال غير كافية",
 "額ずく": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "額づく": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "額を寄せ合う": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "額を集める": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "額付き": "داخل إطار, مؤطر (مزود بإطار)\nمثال: كانت هناك لقطات مؤطرة للعائلة والأصدقاء على مكتبها",
 "額入り": "داخل إطار, مؤطر (مزود بإطار)\nمثال: كانت هناك لقطات مؤطرة للعائلة والأصدقاء على مكتبها",
 "額突く": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "額突虫": "خنفساء مطقطقة (قادرة على تعديل وضعها عندما تكون على ظهرها عن طريق القفز في الهواء مع صوت طقطقة)",
 "額縁": "أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ) / وَرَّطَ / لَقْطَة\nمثال: دهنت أطر النافذة بالأصفر. / عارضة (الجزء السفلي من السطح المعمد؛ يرتكز مباشرة على تيجان الأعمدة) / إطار الباب (الإطار الزخرفي حول الباب أو النافذة)",
 "額衝く": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "額装": "تأطير, صياغة (صياغة الخطط والتفاصيل الهامة) / إطار صورة, برواز (إطار يدعم ويحمي صورة أو مرآة)\nمثال: صياغة المراسيم القضائية",
 "額角": "خطم (نتوء يشبه المنقار للجزء الأمامي من رأس بعض الحشرات مثل السوس) / منبر, منصة الخطابة (منصة مرتفعة عن المستوى المحيط لإبراز الشخص الموجود عليها)",
 "額際": "خط الشعر, منبت الشعر (الحد الطبيعي الذي يشكله الشعر على الرأس) / خط رفيع جداً, خط شعري (خط رفيع للغاية)",
 "額面": "قيمة ظاهرية (القيمة الظاهرة مقابل القيمة الحقيقية) / قيمة اسمية (قيمة الورقة المالية التي تحددها الشركة المصدرة لها؛ ولا علاقة لها بالقيمة السوقية)",
 "額面どおり": "قيمة ظاهرية (القيمة الظاهرة مقابل القيمة الحقيقية) / قيمة اسمية (قيمة الورقة المالية التي تحددها الشركة المصدرة لها؛ ولا علاقة لها بالقيمة السوقية) / حَرْفِيًّا, كَلِمَة بِكَلِمَة (باستخدام نفس الكلمات تماماً)\nمثال: كرر ملاحظاتها حرفياً",
 "額面価格": "قيمة ظاهرية (القيمة الظاهرة مقابل القيمة الحقيقية) / قيمة اسمية (قيمة الورقة المالية التي تحددها الشركة المصدرة لها؛ ولا علاقة لها بالقيمة السوقية)",
 "額面超過額": "إصدار مُكَلف / فاخر",
 "額面通り": "قيمة ظاهرية (القيمة الظاهرة مقابل القيمة الحقيقية) / قيمة اسمية (قيمة الورقة المالية التي تحددها الشركة المصدرة لها؛ ولا علاقة لها بالقيمة السوقية) / حَرْفِيًّا, كَلِمَة بِكَلِمَة (باستخدام نفس الكلمات تماماً)\nمثال: كرر ملاحظاتها حرفياً",
 "額髪": "نَاصِيَة (خصلة من شعر عرف الحصان تنمو للأمام بين الأذنين) / خُصْلَة أَمَامِيَّة, نَاصِيَة (خصلة شعر تنمو (أو تتدلى) فوق الجبهة)",
 "顎": "فَكّ / سفيف الريشة (واحدة من الشعيرات المتوازية التي تبرز من العمود الرئيسي للريشة) / حسك, شوكة (نقطة فرعية تواجه عكس النقطة الرئيسية تجعل من الصعب إزالة رأس السهم أو الرمح) / شوكة (الجزء المدبب من الأسلاك الشائكة) / تهكم, نقد لاذع (ملاحظة عدوانية موجهة لشخص مثل قذيفة وتهدف إلى إحداث تأثير قوي)\nمثال: كانت كلمته الأخيرة 'اذهب للجحيم' / ذَقْن, دقن (الجزء الناتىء البارز في أسفل الوجه تحت الفم، وهو منبت اللِحْيَة عند الرَجُل؛ كناية اللِحْيَة) / خَيْشُوم, نَخْشُوش",
 "顎で使う": "هَذَى",
 "顎の骨": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "顎下腺": "غدة تحت الفك السفلي (غدة لعابية داخل الفك السفلي على كلا الجانبين تنتج معظم اللعاب الليلي؛ تفرغ اللعاب في الفم تحت اللسان)",
 "顎割れ": "طَابَع اَلْحُسْن",
 "顎動脈": "شريان فكي علوي (أي من شريانين يتفرعان من الشريان السباتي الظاهر ويغذيان تراكيب الوجه)",
 "顎紐": "حزام الذقن (شريط متصل بقبعة؛ يمر تحت الذقن ويثبت القبعة في مكانها)",
 "顎脚": "رجل فكية, قدم فكية (واحدة من مجموعة من ثلاثة زوائد مزدوجة على صدر القشريات عشاريات الأرجل، تقع خلف الفك العلوي وتستخدم في التغذية)\nمثال: الزائدة المعدلة للمساعدة في التغذية تعرف بالرجل الفكية",
 "顎門": "ذَقْن, دقن (الجزء الناتىء البارز في أسفل الوجه تحت الفم، وهو منبت اللِحْيَة عند الرَجُل؛ كناية اللِحْيَة) / خَيْشُوم, نَخْشُوش",
 "顎関節": "مفصل صدغي فكي, مفصل فكي (المفصل بين رأس عظم الفك السفلي والعظم الصدغي)",
 "顎骨": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "顎髭": "لِحْيَة, ذَقْن (شعر الخدَّين والذَّقَن)\nمثال: لديه لحية صغيرة.",
 "顎鬚": "لِحْيَة, ذَقْن (شعر الخدَّين والذَّقَن)\nمثال: لديه لحية صغيرة.",
 "顎鬚海豹": "فقمة ملتحية (فقمة متوسطة الحجم رمادية إلى صفراء ذات شعيرات على جانبي الخطم؛ تعيش في المحيط المتجمد الشمالي)",
 "顏": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / شَرَف, عِزَّة (شَرَف) / شَرَف (شَرَف)\nمثال: لا أستحق هذا الشرف. / نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "顔": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / شَرَف, عِزَّة (شَرَف) / شَرَف (شَرَف)\nمثال: لا أستحق هذا الشرف. / نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / مَلَامِح / شَرَف, عِزَّة (شَرَف) / شَرَف (شَرَف)\nمثال: لا أستحق هذا الشرف.",
 "顔かたち": "مِيزَة / صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "顔がほころぶ": "خَشَبَة / كَمَرَة, جَائِز / شُعَاع",
 "顔が綻ぶ": "خَشَبَة / كَمَرَة, جَائِز / شُعَاع",
 "顔が見える": "قابل للتعرف عليه, ممكن تحديد هويته (يمكن التعرف عليه أو تحديده)",
 "顔きき": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "顔つき": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "顔つなぎ": "قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: قدم عمي لرؤيتي.",
 "顔ない": "مُحْرَج, بِٱلْحَرَج",
 "顔なじみ": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "顔に紅葉を散らす": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر) / رُوج (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها.",
 "顔ばせ": "مَلَامِح",
 "顔ぶれ": "إدارة الموارد البشرية, قسم شؤون الموظفين (القسم المسؤول عن تعيين وتدريب وتوزيع الموظفين ووضع سياسات إدارة الأفراد) / قوة (مجموعة من الناس مستعدة لإطاعة الأوامر)\nمثال: قوة عامة ضرورية لتوفير الأمن لحقوق المواطنين",
 "顔をしかめる": "تجهم, تكشيرة (تعبير وجهي ملتوي)\nمثال: قامت بتجهم عند التفكير في الأمر",
 "顔をたてる": "حَفِظَ مَاءَ الوَجْهِ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "顔をゆがめる": "تجهم, تكشيرة (تعبير وجهي ملتوي)\nمثال: قامت بتجهم عند التفكير في الأمر",
 "顔を合わす": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري. / شريك في البطولة, نجم مشارك (أحد ممثلين اثنين يتمتعان بوضع متساوٍ كنجوم في مسرحية أو فيلم)",
 "顔を合わせる": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري. / شريك في البطولة, نجم مشارك (أحد ممثلين اثنين يتمتعان بوضع متساوٍ كنجوم في مسرحية أو فيلم)",
 "顔を歪める": "تجهم, تكشيرة (تعبير وجهي ملتوي)\nمثال: قامت بتجهم عند التفكير في الأمر",
 "顔を立てる": "حَفِظَ مَاءَ الوَجْهِ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "顔を赤らめる": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر) / رُوج (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها.",
 "顔を顰める": "تجهم, تكشيرة (تعبير وجهي ملتوي)\nمثال: قامت بتجهم عند التفكير في الأمر",
 "顔アップ": "لقطة مقربة (صورة فوتوغرافية (أو غيرها) يظهر فيها الموضوع بمقياس كبير نسبياً، ويشغل معظم أو كل الإطار)",
 "顔パンツ": "قناع الوجه (قناع يوفر غطاءً واقياً للوجه في رياضات مثل البيسبول أو كرة القدم أو الهوكي)",
 "顔付き": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "顔写真": "صورة جنائية (صورة لوجه شخص ما (خاصة تلك التي تؤخذ لسجلات الشرطة))",
 "顔出し": "تَزَاوُر, زِيَارَة (نشاط القيام بالزيارات)\nمثال: كان الغرض هو الترويج للمنازل والنوادي والتزاور والخدمات الأخرى / حُضُور, مُثُول (حضور رسمي (في المحكمة أو في جلسة استماع) لطرف في دعوى)",
 "顔利き": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "顔合せ": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم. / اقتران, مزاوجة (فعل تجميع الأشياء أو الأشخاص في أزواج) / اقتران, تزاوج (عملية اقتران الذكر والأنثى لأغراض التكاثر)\nمثال: الاقتران العرضي للمراهقين / مباراة, مواجهة (المزاوجة بين الناس أو الأشياء للمقارنة أو المنافسة)\nمثال: كانت مباراة جيدة لكن الفريق المضيف فاز",
 "顔合わせ": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم. / اقتران, مزاوجة (فعل تجميع الأشياء أو الأشخاص في أزواج) / اقتران, تزاوج (عملية اقتران الذكر والأنثى لأغراض التكاثر)\nمثال: الاقتران العرضي للمراهقين / مباراة, مواجهة (المزاوجة بين الناس أو الأشياء للمقارنة أو المنافسة)\nمثال: كانت مباراة جيدة لكن الفريق المضيف فاز",
 "顔合わせる": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري. / شريك في البطولة, نجم مشارك (أحد ممثلين اثنين يتمتعان بوضع متساوٍ كنجوم في مسرحية أو فيلم)",
 "顔容": "مِيزَة / صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "顔射": "تنظيف بشرة, علاج الوجه (عناية بالوجه تتضمن عادةً التنظيف والتدليك ووضع الكريمات التجميلية) / سطحي, وجهي (مكون من أو يخص السطح الخارجي لشيء ما) / وجهي (متعلق بالوجه) / عصب قحفي سابع, عصب وجهي (عصب قحفي يغذي عضلات الوجه)\nمثال: تدليك وجهي",
 "顔形": "مِيزَة / صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "顔役": "رَئِيس, رَئِيسَة",
 "顔文字": "رمز تعبيري (تمثيل لتعبير وجهي (مثل الابتسامة أو العبوس) يتم إنشاؤه بكتابة سلسلة من الأحرف عند إرسال بريد إلكتروني)\nمثال: -( و :-) رموز تعبيرية",
 "顔料": "دهان, طلاء (مادة تستخدم كطلاء لحماية أو تزيين سطح (خاصة خليط من صبغة معلقة في سائل)؛ تجف لتشكل طبقة صلبة) / خضاب, صبغة (مادة تلوين جافة (خاصة مسحوق يخلط مع سائل لإنتاج الطلاء، إلخ)) / خضاب, صبغة (أي مادة ينتج عن وجودها في الأنسجة النباتية أو الحيوانية لون مميز) / دِهَان / لَوَّنَ (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد)\nمثال: ما هو لون شعرك؟",
 "顔本": "فَيْس بُوك, فِيس بُوك",
 "顔立ち": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "顔立て": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "顔筋": "عضلة وجهية (أي من العضلات الهيكلية للوجه)",
 "顔繋ぎ": "قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: قدم عمي لرؤيتي.",
 "顔色": "بَشْرَة / مَلَامِح",
 "顔見知り": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "顔触れ": "إدارة الموارد البشرية, قسم شؤون الموظفين (القسم المسؤول عن تعيين وتدريب وتوزيع الموظفين ووضع سياسات إدارة الأفراد) / قوة (مجموعة من الناس مستعدة لإطاعة الأوامر)\nمثال: قوة عامة ضرورية لتوفير الأمن لحقوق المواطنين",
 "顔認識": "التعرف على الوجه, التمييز الوجهي (تحديد هوية بيومتري عن طريق مسح وجه الشخص ومطابقته مع مكتبة من الوجوه المعروفة)\nمثال: استخدموا التعرف على الوجه لرصد الإرهابيين المعروفين",
 "顔貌": "مِيزَة / صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "顔面": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "顔面潮紅": "هِبَّة الْحَرَارَة, وَمْضَة سَاخِنَة",
 "顔面神経": "عصب قحفي سابع, عصب وجهي (عصب قحفي يغذي عضلات الوجه)",
 "顔面神経痛": "ألم العصب الثلاثي التوائم (ألم عصبي انتيابي شديد على طول العصب الثلاثي التوائم)",
 "顔面筋": "عضلة وجهية (أي من العضلات الهيكلية للوجه)",
 "顔馴染": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "顔馴染み": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "顕": "مَكْشُوف, مُعَرَّض / عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور / تعريض (فعل تعريض شخص ما لتجربة مؤثرة) / ترك في العراء, نبذ (التخلي دون مأوى أو حماية (مثل ترك رضيع في العراء)) / إظهار, كشف (العرض للمشاهدة بطريقة علنية أو عامة) / تعريض (فعل تعريض الفيلم للضوء)\nمثال: نددت بتعريض الأطفال للمواد الإباحية",
 "顕す": "مَثَّلَ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / كَشَفَ (كشَّف الأمرَ بالغ في كشْفِه وتوضيحه؛ أزال الغطاء أو جعل الشيء مكشوفًا) / أَوْحَى, أَنْزَلَ (بمعنى وَحَى، أَشَارَ؛ ألهم، يستخدم في الخير والشر، من الله أو من غيره)\nمثال: كشف كارل المزيد. / عَبَّرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "顕る": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "顕れ": "تَجَسَّد",
 "顕わ": "مَكْشُوف, مُعَرَّض / عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور",
 "顕在化": "صعود للسطح, طفو (الظهور على السطح والبروز للعيان)",
 "顕彰": "اِحْتِرَام, اِلْتِزَام (الامتثال للقانون أو العرف أو الممارسة وما إلى ذلك)",
 "顕微": "مِجْهَرِيّ, مِيكْرُوسْكُوبِيّ (صغير جداً لدرجة أنه لا يُرى بدون مجهر) / مِجْهَرِيّ الدِّقَّة (بالغ الدقة مع اهتمام شديد بأدق التفاصيل) / مِجْهَرِيّ (مَرْئِيٌّ تَحْتَ المِجْهَر؛ بِاسْتِخْدَامِ المِجْهَر) / مجهري (متعلق بالفحص المجهري أو مستخدم فيه)\nمثال: تحليل مجهري",
 "顕微鏡": "مِجْهَر",
 "顕微鏡写真": "صورة مجهرية (صورة ملتقطة بمساعدة المجهر)",
 "顕微鏡座": "مِجْهَر",
 "顕性": "جانبية, هيمنة جانبية (تطور متفوق لجانب واحد من الجسم) / تفويض, سلطة (القوة أو الحق في إصدار الأوامر أو اتخاذ القرارات) / سيادة (الظاهرة العضوية التي يتم فيها التعبير عن أحد أليلين موجودين في النمط الجيني في النمط الظاهري بينما لا يظهر الأليل الآخر) / تحكم, سيطرة (الحالة التي توجد عندما يكون لشخص أو مجموعة سلطة على أخرى)\nمثال: لديه السلطة لإصدار مذكرات التوقيف",
 "顕揚": "مُعَظِّم, مُمَجِّد (يميل إلى الرفعة والتعظيم)",
 "顕然": "شَفَّاف / وَاضِح",
 "顕現": "مُظَاهَرَة (عرض عام للمشاعر الجماعية (عادة ذات طابع سياسي)) / تجلي, مظهر (دلالة واضحة لوجود أو حضور أو طبيعة شخص أو شيء ما) / انعكاس, تعبير (تعبير بدون كلمات) / تجسد, تجلي (ظهور في شكل جسدي (كما في الروح غير المتجسدة))\nمثال: كانت هناك مظاهرات عنيفة ضد الحرب",
 "顕示": "مُظَاهَرَة (عرض عام للمشاعر الجماعية (عادة ذات طابع سياسي)) / تجلي, مظهر (دلالة واضحة لوجود أو حضور أو طبيعة شخص أو شيء ما) / انعكاس, تعبير (تعبير بدون كلمات) / تجسد, تجلي (ظهور في شكل جسدي (كما في الروح غير المتجسدة))\nمثال: كانت هناك مظاهرات عنيفة ضد الحرب",
 "顕示性": "إبراز ضوئي, منطقة مضيئة (منطقة من السطوع في الصورة)",
 "顕示的消費": "استهلاك تفاخري (شراء خدمات ومنتجات باهظة الثمن من أجل التباهي بالثروة)",
 "顕色": "إِعْمَار, تَعْمِير",
 "顕色剤": "مُطَوِّر (الشخص الذي يقوم بـ«تطوير» شيء ما، أي تحسينه أو تغييره للأفضل، كمنتج أو نظام أو مهارة؛ في الاستخدام المعاصر، يُقصد به غالبًا «مُطَوِّر البرمجيات» أو «مُطَوِّر التطبيقات» أي شخص يعمل على تصميم وتطوير البرمجيات)",
 "顕花植物": "ظاهرة التزاوج, نبات بذري (نبات يتكاثر عن طريق البذور وليس الأبواغ)",
 "顕著": "لافت للنظر",
 "顕露": "اِكْتِشَاف",
 "願": "رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب. / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / صَلَاة, دُعَاء / صَلَاة / مُصَلٍّ / تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "願い": "رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب. / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / صَلَاة, دُعَاء / صَلَاة / مُصَلٍّ / تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "願い下げ": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما) / إبطال, إلغاء (الفعل الكلامي للإلغاء أو الفسخ أو الإبطال) / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "願い主": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "願い事": "أُمْنِيَّة / رَغْبَة / مُنْيَة / تَمَنَّى",
 "願い出": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "願い出る": "سَأَلَ, طَلَبَ (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا.",
 "願い書": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "願い求める": "اِلْتَمَسَ, تَوَسَّلَ",
 "願う": "رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب. / اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك",
 "願ってもない": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "願っても無い": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "願わくは": "لَيْتَ, تَمَنَّى (يفيد التمني)\nمثال: ليت بحاجة لتعمل ساعات إضافية.",
 "願わくば": "لَيْتَ, تَمَنَّى (يفيد التمني)\nمثال: ليت بحاجة لتعمل ساعات إضافية.",
 "願わしい": "مرغوب فيه, مستحب (يستحق الامتلاك أو السعي إليه أو تحقيقه) / جَدِير, لَائِق (جدير بالاختيار خاصة كشريك زواج)\nمثال: وظيفة مرغوبة",
 "願をかける": "صَلَّى, دَعَا",
 "願をたてる": "صَلَّى, دَعَا",
