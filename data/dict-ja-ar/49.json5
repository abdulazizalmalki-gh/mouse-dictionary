 "誇示的消費": "استهلاك تفاخري (شراء خدمات ومنتجات باهظة الثمن من أجل التباهي بالثروة)",
 "誇称": "تباهي, تفاخر (الحديث عن النفس بصيغ التفخيم)",
 "誉む": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "誉むべき": "مُحَمَّد (مُفَعَّل من حَمَّدَ؛ الذي يُحْمَدُ كثيرا)\nمثال: محمد رسول الله.",
 "誉めたてる": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "誉めちぎる": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "誉める": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "誉め称える": "صَفَّقَ",
 "誉め立てる": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "誉め言葉": "تَأْبِين, أُمْدُوحَة / ثَنَاء, أُمْدُوحَة",
 "誉れ": "شرف, عفة (فضيلة المرأة أو عفتها) / شرف, كرامة (صفة كون الشخص شريفاً وذا سمعة طيبة) / تكريم, جائزة (رمز ملموس يدل على الاستحسان أو التميز) / تكريم, شرف (حالة كونه مكرماً)\nمثال: رجل شريف",
 "誉れ高い": "شَهِير, لَامِع (معروف على نطاق واسع ومُقدَّر)",
 "誉望": "شَرَف, عِزَّة (شَرَف) / شَرَف (شَرَف)\nمثال: لا أستحق هذا الشرف.",
 "誌": "خَزَّان الْبُنْدُقِيَّة, مَخْزَن طَلَقَاتِ السِّلَاحِ",
 "認む": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه.",
 "認め": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض. / ختم توقيع (ختم (خاصة الذي يستخدم لتمييز الوثائق رسمياً))",
 "認める": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه. / تَعَرَّفَ / حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / صَدَّقَ, وَافَقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع) / اِسْتَحَسَنَ, وَافَقَ (عَدَّه حَسَنا بمعنى جميل؛ عدَّه حسنًا بمعنى جَيِّد) / وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: صدق سامي كل شيء. / أَعْتَرَفَ",
 "認め合う": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "認印付き指輪": "خاتم الختم (خاتم يحمل ختماً)",
 "認可": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض.",
 "認可証": "رُخْصَة, تَصْرِيح / رُخْصَة",
 "認定": "إذن, تفيوض (فعل منح الشرعية أو الإقرار أو التفويض الرسمي) / تفويض, سلطة (إذن رسمي أو موافقة) / تفويض, سلطة (القوة أو الحق في إصدار الأوامر أو اتخاذ القرارات) / تفويض, توكيل (وثيقة تعطي تعليمات أو أمراً رسمياً)\nمثال: تم تجديد التفويض للبرنامج عدة مرات",
 "認定証": "شَهَادَة",
 "認容": "إِقْرَار, اعْتِرَاف (بيان يقر بشيء أو بشخص ما) / إقرار, اعتراف (حالة أو صفة كونه معترفاً به أو مقدراً)\nمثال: لا بد أنها رأته لكنها لم تبد أي علامة إقرار بذلك",
 "認知": "إِقْرَار, اعْتِرَاف (بيان يقر بشيء أو بشخص ما) / إقرار, اعتراف (حالة أو صفة كونه معترفاً به أو مقدراً)\nمثال: لا بد أنها رأته لكنها لم تبد أي علامة إقرار بذلك",
 "認知度": "رُؤْيَة",
 "認知心理学": "علم النفس المعرفي (نهج في علم النفس يؤكد على العمليات العقلية الداخلية)",
 "認知症": "خَرَف ((خَرُفَ) الرجل خرفا وخرافة: خرف)",
 "認知的不協和": "تَنَافُر مَعْرِفِيّ, اِنْفِصَام مَعْرِفِيّ",
 "認知科学": "علم الإدراك, علوم إدراكية (ميدان العلم المعني بالإدراك؛ يشمل أجزاء من علم النفس المعرفي واللسانيات وعلوم الحاسوب وعلم الأعصاب المعرفي وفلسفة العقل)",
 "認許": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا. / قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض.",
 "認証": "توثيق, مصادقة (التحقق من صحة أو أصالة شيء أو شخص ما) / توثيق, منح امتياز (فعل التصديق أو منح حق الامتياز لـ) / اعتماد, شهادة (وثيقة تشهد بصحة وقائع معينة مذكورة) / إثبات, تأييد (تأكيد صحة حقيقة أو بيان من خلال استخدام الأدلة الوثائقية)",
 "認証コード": "خبير توثيق, مُوثِّق (من يحدد الأصالة (كما في الأعمال الفنية) أو يضمن الصلاحية)",
 "認証トークン": "رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "認証書": "شَهَادَة",
 "認識": "إذن بالكلام (تعيين من قبل رئيس الجلسة يمنح الشخص الحق في التحدث في هيئة تداولية) / تحديد الهوية, تعرف (عملية التعرف على شيء ما أو شخص ما عن طريق التذكر) / إدراك, اعتراف (الوصول إلى فهم شيء ما بوضوح وتميز) / إقرار, اعتراف (قبول (مثل قبول ادعاء) على أنه حقيقي وصالح)\nمثال: لم يتمكن من تقديم اقتراحه لأنه لم يحصل على إذن بالكلام من الرئيس",
 "認識不能": "غَيْر مَعْرُوف, غَيْر مُعتَرَف بِه (لم يُتعرَّف عليه أو يُقَرّ به) / غَيْر مُعْتَرَف بِه (لا يتمتّع بسمعة راسخة)",
 "認識力": "وعي (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…)\nمثال: إنها فاقدة الوعي.",
 "認識票": "بطاقة تعريف الكلب (لوحة معدنية على طوق الكلب تحمل رقم تسجيله) / بطاقة تعريف عسكرية (بطاقة تعريف عسكرية تُلبس بسلسلة حول الرقبة)",
 "認識論": "إِبِسْتِمُولُوجِيَّا, نَظَرِيَّةْ اَلمَعْرِفَة",
 "認識違い": "سُوء فَهْم",
 "誑かす": "حِيلَة",
 "誑し込む": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "誑す": "تَمَلَّقَ / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "誓い": "قَسَم, حَلْف (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "誓い合う": "تَعَهَّدَ / ضَمَان (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / تَعَهُّد\nمثال: لا أستطيع ضمان أي شيء.",
 "誓う": "شَتَمَ, سَبَّ\nمثال: 君は聖書に手をのせて誓うべきだ。 — ينبغي أن تقسم ويدك على الإنجيل.",
 "誓って": "بِالتَّأْكِيد / أَبَدًا",
 "誓約": "قَسَم, حَلْف (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "誓約書": "مِيثَاق, عَهْد",
 "誓言": "قَسَم, حَلْف (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "誓詞": "نَذْر / نَذَرَ",
 "誓願": "نَذْر / نَذَرَ / صَلَاة, دُعَاء / صَلَاة / مُصَلٍّ",
 "誕プレ": "هدية عيد ميلاد (هدية تُقدم احتفالاً بعيد ميلاد شخص)",
 "誕生": "وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / خِلْقَة, خَلْق / اِبْتِكَار, خَلْق / خَلْق (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "誕生パーティー": "حَفْلَة عِيد مِيلَاد",
 "誕生会": "حَفْلَة عِيد مِيلَاد",
 "誕生日": "عِيد مِيلَاد / يَوْم مِيلَاد (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "誕生日おめでとう": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, عِيد مِيلَاد سَعِيد",
 "誕生日おめでとうございます": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, عِيد مِيلَاد سَعِيد",
 "誕生日ケーキ": "كَعْكَة عِيد مِيلَاد (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "誕生日パーティー": "حَفْلَة عِيد مِيلَاد",
 "誕生日プレゼント": "هدية عيد ميلاد (هدية تُقدم احتفالاً بعيد ميلاد شخص)",
 "誕生日会": "حَفْلَة عِيد مِيلَاد",
 "誕生死": "إجهاض تلقائي, إسقاط (فقدان طبيعي لنتاج الحمل)",
 "誕生石": "حجر البخت (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "誕辰": "عِيد مِيلَاد / يَوْم مِيلَاد (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "誘い": "دَعْوَة, عزيمة / إِغْرَاء / فِتْنَة, إِغْرَاء / فِتْنَة / فِتْنَة, تَجْرِبَة",
 "誘いかける": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا.",
 "誘いをかける": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "誘い出す": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, طعم (أي شيء يعمل كوسيلة للإغواء)",
 "誘い掛ける": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا.",
 "誘い水": "تحضير المضخة (إدخال الماء في المضخة لتحسين الختم وبدء تدفق المياه) / إنفاق بالعجز (إنفاق الأموال التي تم جمعها عن طريق الاقتراض؛ تستخدمه الحكومات لتحفيز اقتصادها) / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "誘い込む": "أَغْوَى, أَغْرَى / أَغْرَى",
 "誘う": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / أَغْوَى, أَغْرَى / أَغْرَى / اِسْتَفَزَّ",
 "誘き入れる": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, طعم (أي شيء يعمل كوسيلة للإغواء)",
 "誘き寄せる": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, طعم (أي شيء يعمل كوسيلة للإغواء)",
 "誘く": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, طعم (أي شيء يعمل كوسيلة للإغواء)",
 "誘因": "تشجيع, حافز (تأثير تحفيزي إيجابي) / حافز, مكافأة (دفعة إضافية (أو مكافأة أخرى) للموظفين كوسيلة لزيادة الإنتاج)",
 "誘宵": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "誘導": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد",
 "誘導コイル": "ملف حث (ملف لإنتاج جهد عالٍ من مصدر جهد منخفض)",
 "誘導ミサイル": "صاروخ موجه (صاروخ يعمل بالدفع الصاروخي يمكن التحكم في مساره أثناء الطيران إما عن طريق إشارات الراديو أو عن طريق أجهزة توجيه داخلية)",
 "誘導体": "مشتقّ",
 "誘導加熱": "تسخين بالحث (تسخين مادة موصلة ناتج عن تيار كهربائي مستحث فيها)",
 "誘導子": "محث (جهاز كهربائي (عادة ملف موصل) يدخل الحث في الدائرة)",
 "誘導尋問": "سؤال استدراجي (سؤال مصاغ بطريقة توحي بالإجابة المطلوبة؛ قد يطرح المحامي أسئلة استدراجية في الاستجواب المضاد)",
 "誘導弾": "صاروخ موجه (صاروخ يعمل بالدفع الصاروخي يمكن التحكم في مساره أثناء الطيران إما عن طريق إشارات الراديو أو عن طريق أجهزة توجيه داخلية)",
 "誘導性": "اسْتِقْرَائِيّ, تَحْرِيضِيّ (يحثّ أو يؤثّر؛ يقود إلى فعلٍ ما) / استقرائي (للاستدلال؛ الانتقال من حقائق جزئية إلى استنتاج عام) / حثي (ناشئ عن الحث (الكهربائي))\nمثال: تفكير استقرائي",
 "誘導灯": "مخرج طوارئ",
 "誘導路": "ممر تدريج (سطح مرصوف على شكل شريط؛ تستخدمه الطائرات للتحرك من وإلى المدرج في المطار)",
 "誘導電動機": "محرك تحريضي, محرك حثي (محرك كهربائي يعمل بالتيار المتردد يتم فيه الحصول على التيار الكهربائي في الجزء الدوار اللازم لإنتاج عزم الدوران عن طريق الحث الكهرومغناطيسي من المجال…)",
 "誘引": "إغراء, إغواء (فعل التأثير عن طريق إثارة الأمل أو الرغبة) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, فتنة (شيء يغوي أو لديه القدرة على الإغواء)\nمثال: كانت إغراءاته وقحة",
 "誘惑": "فِتْنَة, إِغْرَاء / فِتْنَة / فِتْنَة, تَجْرِبَة",
 "誘惑物": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, طعم (أي شيء يعمل كوسيلة للإغواء)",
 "誘惑的": "سَاحِر, فَتَّان (شديد الجاذبية وقادر على إثارة الأمل أو الرغبة)",
 "誘惑者": "زير نساء, مغوٍ (رجل يستغل النساء) / مغوي (شخص سيء يغري الآخرين بالوقوع في الخطأ أو المخالفة)",
 "誘拐": "اِخْتِطَاف",
 "誘拐事件": "اِخْتِطَاف",
 "誘拐犯": "مُخْتَطِف",
 "誘拐犯人": "مُخْتَطِف",
 "誘拐罪": "اِخْتِطَاف",
 "誘拐者": "مُخْتَطِف",
 "誘発": "استحثاث, تحفيز (فعل تحقيق نتيجة مرغوبة)\nمثال: استحثاث النوم",
 "誘発剤": "مُحَفِّز, حَاث",
 "誘発電位": "جهد مستثار (الاستجابة الكهربائية للجهاز العصبي المركزي الناتجة عن محفز خارجي)\nمثال: قاس الجهد المستثار بواسطة مخطط كهربية الدماغ",
 "誘致": "جَاذِبِيَّة (صفة إثارة الاهتمام؛ كون الشيء جذاباً أو شيئاً يجذب) / جاذبية, عنصر جذب (خاصية توفر المتعة وتجذب) / مَعلم ترفيهي, وسيلة جذب (ترفيه يُقدم للجمهور) / عامل جذب, مصدر جذب (فنان ترفيهي يجذب جماهير غفيرة)\nمثال: حملت شخصيتها جاذبية غريبة بالنسبة له",
 "誘起": "استحضار (إعادة خلق خيالية) / استثارة, استحثاث (تحفيز يستدعي (يستخرج) فئة معينة من السلوكيات) / استجلباب, استحضار (استدعاء قوى خارقة مفترضة عن طريق التعاويذ والرقى)\nمثال: لم يكن استخلاص شهادته سهلاً",
 "誘電": "إطلاق, استحثاث (فعل يحرك سلسلة من الأحداث) / استحثاث, تحريض (فعل التسبب في حدوث شيء ما (خاصة في وقت مبكر)) / استدلال استقرائي, استقراء (الاستدلال من الحقائق التفصيلية إلى المبادئ العامة) / استثارة, استحثاث (تحفيز يستدعي (يستخرج) فئة معينة من السلوكيات)\nمثال: استحثاث حالة التخدير / عازل, مادة عازلة (مادة مثل الزجاج أو الخزف ذات موصلية كهربائية أو حرارية مهملة)",
 "誘電体": "عازل, مادة عازلة (مادة مثل الزجاج أو الخزف ذات موصلية كهربائية أو حرارية مهملة)",
 "誘電加熱": "تسخين عازل (تسخين عازل بواسطة مجال كهربائي عالي التردد)",
 "誘電子": "محث (جهاز كهربائي (عادة ملف موصل) يدخل الحث في الدائرة)",
 "誘電率": "توصيل, موصلية (انتقال الحرارة أو الكهرباء أو الصوت)",
 "語": "كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة) / كَلِمَةُ اللهِ (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة. / لُغَة, لِسَان (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة) / لُغَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة. / حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث. / تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / حِكَايَة / مَوْضُوع, مَوَاضِيع",
 "語った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "語らい": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / عَهْد, مِيثَاق (تعهد رسمي بالوفاء والإخلاص) / خطبة, خطوبة (وعد متبادل بالزواج)",
 "語らう": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب.",
 "語り": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / حِكَايَة / مَوْضُوع, مَوَاضِيع",
 "語りかける": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "語りぐさ": "قِصَّة, حِكَايَة",
 "語りべ": "قَصَّاص, قَصَّاصَة",
 "語り句": "قِصَّة, حِكَايَة",
 "語り合った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "語り手": "رَاوٍ, رَاوِيَة",
 "語り掛ける": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "語り物": "سَرْدِي / قِصَّة, حِكَايَة / سَرْدِيَّة, رِوَايَة",
 "語り種": "قِصَّة, حِكَايَة",
 "語り草": "قِصَّة, حِكَايَة",
 "語り部": "قَصَّاص, قَصَّاصَة",
 "語る": "تَكَلَّمَ فِي, تَكَلَّمَ عَلَى (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب. / تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه) / دَلَّ عَلَى, رَمَزَ إِلَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: بدل سامي ملابسه.",
 "語中音": "مُتَوَسِّط, وَسَطِيّ (يتعلّق بالوسط أو يقع فيه أو يمتدّ نحوه) / مُتَوَسِّط, نَاصِف (يَقْسِم الحَيَوَان إِلَى نِصْفَيْن أَيْمَن وَأَيْسَر)",
 "語別": "جُزْء كَلَام, قَسْم كَلَام",
 "語勢": "تَرْكِيز",
 "語句": "كلام, كلمات (اللغة التي يتم التحدث بها أو كتابتها) / حوار, كلام الممثل (كلمات تشكل حوار مسرحية) / كلمات الأغنية (نص أغنية شعبية أو رقم موسيقي كوميدي) / كلمات (الكلمات التي يتم نطقها)\nمثال: لديه موهبة في الكلام",
 "語史": "قاموس اشتقاقي (قاموس يعطي الأصول التاريخية لكل كلمة)",
 "語呂": "سليم / صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّتَ, طَلَّع صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي. / تَلَاعُب لَفْظِيّ, تَوْرِيَة (تلاعب فكاهي بالكلمات)\nمثال: أفعل ذلك من أجل التلاعب اللفظي",
 "語呂のよさ": "موسيقى, نغم عذب (أي أصوات مقبولة (مستساغة ومتناغمة))\nمثال: غفا على وقع موسيقى أجراس الرياح",
 "語呂の良さ": "موسيقى, نغم عذب (أي أصوات مقبولة (مستساغة ومتناغمة))\nمثال: غفا على وقع موسيقى أجراس الرياح",
 "語呂合わせ": "تَلَاعُب لَفْظِيّ, تَوْرِيَة (تلاعب فكاهي بالكلمات)\nمثال: أفعل ذلك من أجل التلاعب اللفظي",
 "語基": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "語学": "لِسَانِيَّات, عِلْم اللُّغَة",
 "語学力": "تعلم اللغة (تعلم استخدام لغة ما)",
 "語学学校": "مَدْرَسَةُ لُغَات (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)",
 "語学学習": "تعلم اللغة (تعلم استخدام لغة ما)",
 "語学的": "لُغَوِيّ, لِسَانِيّ",
 "語学者": "لُغَوِيّ / عَالِم لُغَوِيّ (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / لِسَانِيّ\nمثال: هو عالم أحيائي.",
 "語尾": "إنهاء, خاتمة (فعل إنهاء شيء ما) / خاتمة, نهاية (نهاية الكلمة (لاحقة أو نهاية تصريفية أو مورفيم نهائي)) / خاتمة, نهاية (القسم الأخير من اتصال ما) / إنهاء, ختام (حدث ينهي وقوعه شيئاً ما)",
 "語尾変化": "تنغيم, عروض (أنماط الضغط والتنغيم في اللغة) / تعديل الصوت (طريقة في التحدث يتم فيها تعديل جهارة أو حدة أو نبرة الصوت) / انثناء, انعطاف (انحراف عن مسار مستقيم أو طبيعي) / إِعْرَاب, تَصْرِيف (تغيير في شكل الكلمة (عادة بإضافة لاحقة) للإشارة إلى تغيير في وظيفتها النحوية)",
 "語幹": "سَاق نَبَات / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أخشى أن أصل متأخرا.",
 "語幹形成母音": "حركة الجذر (حركة تنهي الجذر وتسبق التصريف)",
 "語序": "نَظَام كَلَم (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "語彙": "مُفْرَدَات, ذَخِيرَة لُغَوِيَّة / مَسْرَد, مَسارِد / مَفْرَدَات",
 "語彙的": "مُعْجَمِيّ, مُفْرَدَاتِيّ / قَامُوسِيّ",
 "語彙素": "لِكْسِيم / مُفْرَدَة",
 "語彙統計学": "إحصاء معجمي (تقنية إحصائية تستخدم لتقدير متى تطورت اللغات المختلفة من لغة مصدر مشتركة)",
 "語彙論": "علم المعجم, لكسيكولوجيا (فرع اللسانيات الذي يدرس المكون المعجمي للغة)",
 "語彙集": "مُفْرَدَات, ذَخِيرَة لُغَوِيَّة / مَسْرَد, مَسارِد / مَفْرَدَات",
 "語形": "شكل الكلمة, صيغة (المظهر الصوتي أو الكتابي للكلمة الذي يمكن استخدامه لوصف أو تحديد شيء ما)",
 "語形論": "صرف تصريفي (جزء القواعد الذي يتعامل مع تصريفات الكلمات)",
 "語志": "قاموس اشتقاقي (قاموس يعطي الأصول التاريخية لكل كلمة)",
 "語感": "تَفَاوُت دَقِيق, فَارِق بَسِيط (اختلاف دقيق في المعنى أو الرأي أو الموقف)\nمثال: بدون فهم الفروق الدقيقة لا يمكنك الاستمتاع بالفكاهة",
 "語族": "عائلة اللغات (اسم فاعل من الفعل عَالَ؛ مؤنث عَائِل؛ إحدى طبقات الأنساب وهي آخرها دون الفصيلة وتشمل ثلاث أجيال من جد واحد: الجد والأبناء وأبناء الأبناء)\nمثال: هو طفل العائلة.",
 "語末": "لَاحِقَة",
 "語根": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "語格": "اِسْتِخْدَام",
 "語気": "نَغْمَة, نَغْم",
 "語気を強める": "رَفَعَ صَوْتَهُ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "語法": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات) / بيان, نطق واضح (نطق الكلام من حيث وضوحه للجمهور)",
 "語派": "فَرْع, غُصْن",
 "語源": "اِشْتِقَاق, تَأْثِيل",
 "語源俗界": "تأثيل شعبي (تأثيل شائع ولكنه خاطئ)",
 "語源俗解": "تأثيل شعبي (تأثيل شائع ولكنه خاطئ)",
 "語源学": "اِشْتِقَاق, تَأْثِيل",
 "語源的": "إتيمولوجي, اشتقاقي (مبني على أو ينتمي إلى علم أصول الكلمات (الإتيمولوجيا))",
 "語源説": "اِشْتِقَاق, تَأْثِيل",
 "語用論": "براغماتية, تداولية (دراسة استخدام اللغة)",
 "語詞": "كلام, كلمات (اللغة التي يتم التحدث بها أو كتابتها) / حوار, كلام الممثل (كلمات تشكل حوار مسرحية) / كلمات الأغنية (نص أغنية شعبية أو رقم موسيقي كوميدي) / كلمات (الكلمات التي يتم نطقها)\nمثال: لديه موهبة في الكلام",
 "語誌": "قاموس اشتقاقي (قاموس يعطي الأصول التاريخية لكل كلمة)",
 "語調": "نَغْمَة, نَغْم / تَجْوِيد, تَرْتِيل (جوّد القارئ:أتى بـ التّلاوة على وجهها الحقّ وراعى أحكام التّجويد في القرآن (قرأ القرآن مُجوّداً):رتّله ترتيلاً؛ تجوّد في العمل:تأنّق فيه،والشيء:تخيّره وطلب أن يكون جيّداً)",
 "語部": "قَصَّاص, قَصَّاصَة",
 "語録": "مختارات أدبية, مقتطفات (مجموعة من المقتطفات من عمل أدبي)",
 "語音": "فُونِيم, صَوْت لُغَوِيّ",
 "語順": "نَظَام كَلَم (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "誠": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة. / إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…) / بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك) / بالفعل, جداً (في الحقيقة (غالباً ما تميل إلى التوكيد))\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "誠に": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا .",
 "誠にありがとうございます": "شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "誠にありがとう御座います": "شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "誠にもって": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "誠に有難うございます": "شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "誠に有難う御座います": "شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "誠実": "مُخْلِص (الشخص الذي يفي ولا يخون)\nمثال: الغيرة لا تجعل أحد مخلص",
 "誠心": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "誠心誠意": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "誠忠": "وَفَاء, إِخْلَاص",
 "誠恐": "خَوْف, وَهَل / خَافَ, خَشِيَ (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ) / خَافَ عَلَى, خَشِيَ عَلَى (ضد أَمِنَ، خَشِي على نفسه أو ماله؛ فَزَعَ وخَشِيَ)",
 "誠情": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "誠意": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "誡め": "حَذَر, حِيطَة (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَذَر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك. / حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر) / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما. / عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "誣いる": "تَشْهِير, اِفْتِرَاء",
