 "赧顔": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر)\nمثال: شعرت بالخجل و احمر وجهها.",
 "赫々": "باهِر",
 "赫う": "بريق, تلاعب الضوء (ضوء ضعيف ومرتعش)\nمثال: بريق الألوان على الريش المتقزح",
 "赫き": "سُطُوع",
 "赫奕": "لَامِع, نَيِّر",
 "赫怒": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق)",
 "赫灼": "لَامِع, نَيِّر",
 "赫然": "بَرَّاق, لَمَّاع (يَعْكِس الضَّوْء)\nمثال: وفر تلميع الأحذية عيشاً ضئيلاً",
 "赫赫": "باهِر",
 "赭面": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم…)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق.",
 "赭黒い": "أحمر داكن (لون أحمر يعكس القليل من الضوء)",
 "走": "رَكَضَ (عَدَا)\nمثال: إنها تحب الركض.",
 "走らす": "إرسال, إيفاد (فعل إرسال شيء ما)\nمثال: تم إنجازه بسرعة وكفاءة / قَادَ, سَاقَ / رَكَضَ (عَدَا)\nمثال: إنها تحب الركض. / دحر, هزيمة منكرة (هزيمة ساحقة)",
 "走らせる": "إرسال, إيفاد (فعل إرسال شيء ما)\nمثال: تم إنجازه بسرعة وكفاءة / قَادَ, سَاقَ / رَكَضَ (عَدَا)\nمثال: إنها تحب الركض. / دحر, هزيمة منكرة (هزيمة ساحقة)",
 "走り": "رَكْض (عَدَا)\nمثال: إنها تحب الركض. / طيران شراعي (نشاط الطيران بطائرة شراعية) / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة. / حوض المطبخ, مجلى (حوض في المطبخ)",
 "走りだす": "خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ)\nمثال: خلع سامي حذاءه.",
 "走り出す": "خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ)\nمثال: خلع سامي حذاءه.",
 "走り出る": "نَفِدَ",
 "走り去る": "هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "走り幅跳び": "قفز طويل, وثب طويل (فعل القفز لأبعد مسافة ممكنة من انطلاقة ركض)",
 "走り書": "خربشة",
 "走り書き": "خربشة",
 "走り読み": "مسح, مسح ضوئي (فعل تحريك شعاع ضوئي أو إلكتروني بؤري بدقة بشكل منهجي فوق سطح ما لإنتاج صورة له…)",
 "走り高跳び": "قفز عالي, وثب عالي (فعل القفز لأعلى ارتفاع ممكن فوق عارضة أفقية)",
 "走る": "رَكَضَ (عَدَا)\nمثال: إنها تحب الركض. / اِنْدَفَعَ, أَسْرَعَ / تَرَاجُع / هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "走化性": "انتحاء كيميائي (حركة خلية أو كائن حي كرد فعل لمحفز كيميائي)",
 "走向": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "走幅跳": "قفز طويل, وثب طويل (فعل القفز لأبعد مسافة ممكنة من انطلاقة ركض)",
 "走性": "رد (الإجراء الجراحي لإعادة جزء من الجسم النازح يدوياً (كالفتق))",
 "走時": "زمن الرحلة, وقت السفر (فترة زمنية تُقضى في السفر)",
 "走書き": "خربشة",
 "走査": "مَسَحَ ضَوْئِيًّا (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة.",
 "走査器": "مَاسِح, مَاسِح ضَوئِيّ",
 "走査装置": "مَاسِح, مَاسِح ضَوئِيّ",
 "走狗": "كَلْبُ صَيْد (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا…)\nمثال: كان الكلب ميتا. / يخدع",
 "走禽類": "عَدَّاء",
 "走者": "عَدَّاء / عداء القواعد (لاعب بيسبول من الفريق الضارب يتواجد على القاعدة (أو يحاول الوصول إلى قاعدة))",
 "走行": "رَكْض (عَدَا)\nمثال: إنها تحب الركض.",
 "走行会": "بطولة ألعاب قوى, ملتقى المضمار والميدان (مسابقة في ألعاب القوى بين فريقين أو أكثر)",
 "走行可能": "عَمَلِيّ, مُمْكِن التَّنْفِيذ (يمكن تنفيذه بالوسائل المتاحة وفي الظروف القائمة)",
 "走行時間": "زمن الرحلة, وقت السفر (فترة زمنية تُقضى في السفر)",
 "走行距離": "مَسَافَة بِالمِيل (المسافة المقاسة بالأميال)",
 "走行距離計": "عَدَّادُ المَسَافَات",
 "走路": "طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ.",
 "走馬灯": "دَائِمُ التَّغَيُّر, مُتَغَيِّر (يتميّز بالتغيّر المستمرّ أو الفعل المؤثّر)",
 "走馬燈": "دَائِمُ التَّغَيُّر, مُتَغَيِّر (يتميّز بالتغيّر المستمرّ أو الفعل المؤثّر)",
 "走高跳": "قفز عالي, وثب عالي (فعل القفز لأعلى ارتفاع ممكن فوق عارضة أفقية)",
 "走鳥類": "طيور مسطحة الصدر, نعاميات (طيور لا تطير لها عظام صدر مسطحة تفتقر إلى الجؤجؤ لربط عضلات الطيران: النعام…)",
 "赴く": "صَارَ, أَصْبَحَ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما. / اِلْتَزَمَ",
 "赴援": "قَوَّى",
 "起": "مَصْدَر, مَصَادِر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "起きかえる": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "起きる": "قَامَ, نَهَضَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه. / صَحَا, اِسْتَيْقَظَ (أَفَاقَ؛ اِسْتَيْقَظَ)\nمثال: أيقظ زيري السائق / حَدَثَ, وَقَعَ (وَقَعَ الأمر؛ نقيض قَدُمَ، كان حَدِيثا)\nمثال: لا أصدق ما حدث.",
 "起き上がりこぼし": "حمام قلاب (حمامة تقوم بشقلبات خلفية أثناء الطيران أو على الأرض)",
 "起き上がり小法師": "حمام قلاب (حمامة تقوم بشقلبات خلفية أثناء الطيران أو على الأرض)",
 "起き上がる": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "起き上り小法師": "حمام قلاب (حمامة تقوم بشقلبات خلفية أثناء الطيران أو على الأرض)",
 "起き伏し": "على مدار الوقت (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "起き臥し": "على مدار الوقت (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "起き返る": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "起く": "نَهَضَ, اِرْتَفْعَ (قَامَ)",
 "起こし": "إِعْمَار, تَعْمِير / استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً",
 "起こした": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "起こす": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية. / نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "起こり": "مَصْدَر, مَصَادِر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "起こる": "حَدَثَ, وَقَعَ (وَقَعَ الأمر؛ نقيض قَدُمَ، كان حَدِيثا)\nمثال: لا أصدق ما حدث.",
 "起し": "إِعْمَار, تَعْمِير / استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً",
 "起す": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية. / نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "起ち居": "حَرَكَة",
 "起つ": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "起り": "مَصْدَر, مَصَادِر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟ / حدبة, ميل العجلات (محاذاة عجلات السيارة لتكون أقرب لبعضها في الأسفل منها في الأعلى)",
 "起る": "حَدَثَ, وَقَعَ (وَقَعَ الأمر؛ نقيض قَدُمَ، كان حَدِيثا)\nمثال: لا أصدق ما حدث.",
 "起上小法師": "حمام قلاب (حمامة تقوم بشقلبات خلفية أثناء الطيران أو على الأرض)",
 "起伏": "تموج, موجة ((في الفيزياء) حركة صعود وهبوط أو جيئة وذهاباً)",
 "起伏し": "على مدار الوقت (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "起動": "افتتاح, بدء تشغيل (فعل بدء عملية أو ممارسة جديدة)\nمثال: عارض بدء تطبيق الفلورة",
 "起動側": "مُبَادِر",
 "起動力": "تَنَقُّل, قُوَّة مُحَرِّكَة (القوة أو القدرة على التحرك)",
 "起動機": "بادئ (مزرعة تحتوي على خميرة أو بكتيريا تستخدم لبدء عملية التخمير أو التحمض في صنع…)\nمثال: لصنع العجين المخمر تحتاج إلى بادئ",
 "起動相": "هَيْئَة الشُّرُوع (جهة الفعل التي تتعلق ببداية الحدث)",
 "起原": "مَنْشَأ",
 "起句": "سطر افتتاحي (السطر الأول من قطعة كتابية (مثل قصة صحفية))",
 "起因": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية.",
 "起坐呼吸": "ضيق النفس الاضطجاعي (شكل من أشكال ضيق التنفس حيث لا يستطيع الشخص التنفس براحة إلا عند الوقوف أو…)",
 "起始": "نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "起始点": "مَنْشَأ",
 "起居": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / حَرَكَة",
 "起居動作": "سُلُوك, تَصَرُّف",
 "起居挙動": "سُلُوك, تَصَرُّف",
 "起工式": "وضع حجر الأساس (الكسر الاحتفالي للأرض لبدء مشروع بناء رسميًا)",
 "起床": "اِنْتِفَاضَة, تَمَرُّد (معارضة منظمة للسلطة؛ صراع يحاول فيه فصيل انتزاع السيطرة من آخر)",
 "起床ラッパ": "بوق الصباح, نوبة الاستيقاظ (إشارة للنهوض في الصباح؛ في الجيش هي نداء بالبوق عند شروق الشمس)",
 "起座呼吸": "ضيق النفس الاضطجاعي (شكل من أشكال ضيق التنفس حيث لا يستطيع الشخص التنفس براحة إلا عند الوقوف أو…)",
 "起案": "رسم ميكانيكي, رسم هندسي (حرفة رسم المخططات الهندسية)\nمثال: تعلم الرسم من والده",
 "起案者": "صائغ مسودات, محرر مسودات (كاتب المسودة)",
 "起業家": "رَائِد أَعْمال مُتَعَهِّد",
 "起死回生": "اِنْعَاش",
 "起毛": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "起源": "مَنْشَأ",
 "起点": "نقطة البداية (أقرب نقطة حدية)",
 "起爆": "إشعال, إضرام (عملية إضرام النار في شيء ما)",
 "起爆剤": "صاعق, كبسولة تفجير (جهاز تفجير ميكانيكي أو كهربائي أو كمية صغيرة من المتفجرات؛ يمكن استخدامه لبدء…) / زِنَاد",
 "起爆装置": "صاعق, كبسولة تفجير (جهاز تفجير ميكانيكي أو كهربائي أو كمية صغيرة من المتفجرات؛ يمكن استخدامه لبدء…)",
 "起用": "مَوْعِد, مِيعَاد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "起磁力": "قوة دافعة مغناطيسية (القوة التي تنتج الفيض المغناطيسي)",
 "起稿": "رسم ميكانيكي, رسم هندسي (حرفة رسم المخططات الهندسية)\nمثال: تعلم الرسم من والده",
 "起立性": "اِنْتِصَابِيّ (متعلِّق بوضعيَّة الوقوف المنتصب)",
 "起立性低血圧": "انخفاض ضغط الدم الانتصابي (انخفاض ضغط الدم الذي يحدث لدى بعض الأشخاص عند الوقوف)",
 "起算": "إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي)",
 "起臥": "استيقاظ, صحوة (فعل الاستيقاظ)\nمثال: كان استيقاظاً مبكراً",
 "起草": "رسم ميكانيكي, رسم هندسي (حرفة رسم المخططات الهندسية)\nمثال: تعلم الرسم من والده",
 "起訴": "مُقَاضَاة, مُلَاحَقَة قَضَائِيَّة",
 "起訴状": "قرار اتهام, لائحة اتهام (وثيقة رسمية يكتبها مدع عام يتهم فيها شخصاً بجريمة ما)\nمثال: الكتاب هو لائحة اتهام للفلسفة الحديثة",
 "起請": "نَذْر",
 "起重機": "كُرْكِيّ, غُرْنُوق\nمثال: رفع سامي نظارته.",
 "起電力": "فولتية, قوة دافعة كهربائية (المعدل الذي يتم به سحب الطاقة من مصدر ينتج تدفقاً للكهرباء في دائرة؛ يعبر عنه…)",
 "起首": "نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "超": "الْأُقْصَى, الْأَبْعَد\nمثال: أنا غير متفاجئ. / بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً / طَبْعًا / فَوْقَ\nمثال: أجب على السؤال.",
 "超える": "صَلِيب\nمثال: عبر جرذ الطريق. / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "超がつく": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
