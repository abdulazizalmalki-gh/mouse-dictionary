 "足輪": "حَلْقَة",
 "足速": "عميق\nمثال: صام ياني رمضان. / سَرِيع\nمثال: ينبح كلب في الحي.",
 "足速い": "خَفِيفُ القَدَم, سَرِيعُ الخُطَى (ذُو أَقْدَامٍ سَرِيعَةِ الحَرَكَةِ)",
 "足運び": "مشية (طريقة مشي الشخص)",
 "足長": "طَوِيل السَّاقَيْن (ذو ساقين طويلتين)",
 "足長蜂": "دبور الورق (أي من عدة دبابير اجتماعية تبني أعشاشاً من مادة تشبه الورق)",
 "足関節": "وصلة القدم (في الناي) (وصلة القدم هي القسم الأخير من الأقسام الثلاثة للناي الموسيقي الغربي)\nمثال: تحتوي آلة الناي الموسيقية على ثلاثة أجزاء: وصلة الرأس، والجسم، ووصلة القدم",
 "足音": "خطوة, موطئ قدم (فعل اتخاذ خطوة في المشي)\nمثال: سمع وقع أقدام على الشرفة",
 "足音をしのばせて": "بتسلل, خلسة (بطريقة خفية)\nمثال: تقدموا خلسة عكس التيار",
 "足音を忍ばせて": "بتسلل, خلسة (بطريقة خفية)\nمثال: تقدموا خلسة عكس التيار",
 "足首": "كَاحِل, كَعْب",
 "足馴らし": "إحماء, تحضير (ممارسة التمارين استعداداً لنشاط شاق)",
 "趾": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "趾行性": "إصبعي السير, مترجل على الأصابع ((عن الثدييات) السير على أصابع القدمين مع رفع الجزء الخلفي من القدم (كما تفعل…)",
 "趾蹠皮膚炎": "شاشة مسطحة (نوع من شاشات الفيديو رقيقة ومسطحة؛ تستخدم عادة في الحواسيب المحمولة)",
 "趾骨": "سُلَامَى, سُلَامِيَّة",
 "跂及": "حَاوَلَ (طَلَبَ، رَامَ)\nمثال: حاول توم قتلنا!",
 "跋": "خَاتِمَة",
 "跋扈": "اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل…)\nمثال: تساهم في انتشار الجهل والتضليل.",
 "跋扈柳": "صفصاف الماعز (صفصاف كثير التفرع من العالم القديم له نورات هرية كبيرة وأوراق عريضة كبيرة نسبياً)",
