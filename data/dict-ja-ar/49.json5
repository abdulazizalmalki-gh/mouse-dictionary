 "風力": "طاقة الرياح (طاقة مستمدة من الرياح (كما في طواحين الهواء)) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "風力タービン": "توربين رياح, عنفة رياح (توربين يتم تشغيله بواسطة الرياح)",
 "風力原動機": "توربين رياح, عنفة رياح (توربين يتم تشغيله بواسطة الرياح)",
 "風力発電所": "مزرعة ريحية",
 "風力発電機": "طاحونة هوائية, مولد رياح (مولد يستخرج الطاقة القابلة للاستخدام من الرياح)",
 "風力計": "مِرْيَاح",
 "風化": "طَقْس, جَوّ / توهين, خفوت (ضعف في القوة أو الشدة)\nمثال: توهين في حجم الصوت / إزهار, تزهير (رواسب مسحوقية على سطح ما) / إزهار, تفتح الزهور (وقت وعملية تبرعم وتفتح الزهور) / طفح جلدي (أي طفح أحمر على الجلد) / أوج, إبان (فترة الازدهار أو الإنتاجية القصوى)",
 "風化作用": "طَقْس, جَوّ",
 "風合": "مَلْمَس",
 "風合い": "مَلْمَس",
 "風向き": "حَالَة, وَضْع / مَزَاج",
 "風呂": "حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / حَمَّام, مُغْتَسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / اِسْتِحْمَام, اِغْتِسَال\nمثال: هل الحمام جاهز؟ / حَمَّام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟ / قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "風呂る": "اِسْتَحَمَّ, اِغْتَسَلَ (اغتسل بالحميم؛ في : الاغتسال عموما سواء كان بالحميم أو بالماء البارد)\nمثال: استحم زيري هناك.",
 "風呂マット": "بساط حمام, دعاسة حمام (منشفة ثقيلة أو حصيرة للوقوف عليها أثناء تجفيف نفسك بعد الاستحمام)",
 "風呂場": "حَمَّام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "風呂桶": "بَانْيُو, مَغْسَل",
 "風味": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "風味豊か": "ذُو مَذَاقٍ زَاخِر, غَنِيُّ النَّكْهَة (مَلِيءٌ بِالنَّكْهَة)",
 "風商売": "بِغَاءٌ, دَعَارَة",
 "風土": "تضاريس, طوبوغرافيا (تكوين سطح ما والعلاقات بين معالمه الطبيعية والتي من صنع الإنسان) / طبوغرافيا (دراسة تفصيلية دقيقة لسمات سطح منطقة ما)",
 "風土病": "مرض متوطن (مرض موجود باستمرار بدرجة أكبر أو أقل في أشخاص من طبقة معينة أو في أشخاص يعيشون في موقع معين)",
 "風地観": "غوان (أي من عدة طيور طرائد كبيرة تشبه الديك الرومي من عائلة القرازيات؛ موطنها غابات أمريكا الاستوائية؛ تشبه القراز وتقدر كطعام)",
 "風変わり": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب",
 "風太郎": "عاطل عن العمل (شخص بلا وظيفة) / عامل مياومة (عامل يعمل باليومية؛ مقابل أجر يومي)",
 "風姿": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "風巻く": "هَبَّة",
 "風帯": "شُرَّابَة",
 "風度": "أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "風当たりが強い": "عَاصِف",
 "風当たりの強い": "عَاصِف",
 "風当りが強い": "عَاصِف",
 "風情": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "風成": "أيولي (من أو متعلق بأيولس أو شعبها اليوناني القديم) / ريحي, هوائي (متعلق بإله الرياح أيولوس؛ أو يتعلق بالرياح أو ناتج عنها) / الأيوليون (السكان اليونانيون القدماء في أيوليا) / إيولي (عضو في أحد الأقسام اللغوية الأربعة لليونانيين في عصور ما قبل التاريخ)",
 "風抜き": "ثقب تهوية (ثقب يسمح بمرور الهواء) / جيب هوائي, فجوة هوائية (منطقة محلية ذات ضغط منخفض أو هواء هابط تسبب فقدان الطائرة للارتفاع فجأة)",
 "風教": "أخلاق, دافع أخلاقي (دافع يستند إلى مبادئ الصواب والخطأ)",
 "風景": "مَشْهَد, مَنْظَر طَبِيعِيّ / مَنْظَر, مَشْهَد / مَشْهَد",
 "風景画": "فن المناظر الطبيعية (نوع فني يتعامل مع تصوير المناظر الطبيعية)",
 "風景画家": "منسق حدائق, مهندس مناظر طبيعية (شخص يقوم بترتيب ميزات المناظر الطبيعية أو الحديقة بشكل جذاب) / رسام مناظر طبيعية (شخص يرسم المناظر الطبيعية)",
 "風来": "خِفَّة, رُعُونَة",
 "風来人": "هَائِم",
 "風来坊": "هَائِم",
 "風格": "شَخْصِيَّة",
 "風水": "فِنْغ شُوي",
 "風水説": "فِنْغ شُوي",
 "風波": "عَاصِفَة / طُوفَان (عاصفة) / عَاصْفة / خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / تضارب, تنافر (خليط حاد ومزعج من الأصوات) / تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / خلاف, شقاق (عدم الاتفاق أو الانسجام) / مَشَقَّة, شِدَّة",
 "風洞": "نفق رياح, نفق هوائي (هيكل يشبه النفق حيث يتم نفخ الهواء بسرعات معروفة لاختبار أجزاء من الطائرات)",
 "風流": "أَنَاقَة",
 "風潮": "مَدّ وَجَزْر (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى. / مَيْل, نَزَعَة",
 "風炎": "رياح الفون, فون (رياح دافئة وجافة تهب أسفل المنحدرات الشمالية لجبال الألب)",
 "風物": "مَشْهَد, مَنْظَر طَبِيعِيّ",
 "風狂": "جُنُون / عَارِف, عَارِفَة",
 "風琴": "عُضْو, عِضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ) / جِهَاز, جَهَاز / أُرْغُن ((أَرْغَنَ): أطاع؛ (أَرْغَنَ) إليه: رغن)\nمثال: اذكر كل عضو باسمه.",
 "風疹": "حصبة ألمانية (مرض فيروسي معدٍ هو شكل أخف من الحصبة يستمر ثلاثة أو أربعة أيام؛ يمكن أن يضر بالجنين خلال الأشهر الثلاثة الأولى)",
 "風穴": "ثقب تهوية (ثقب يسمح بمرور الهواء) / جيب هوائي, فجوة هوائية (منطقة محلية ذات ضغط منخفض أو هواء هابط تسبب فقدان الطائرة للارتفاع فجأة)",
 "風窓": "ثقب تهوية (ثقب يسمح بمرور الهواء) / جيب هوائي, فجوة هوائية (منطقة محلية ذات ضغط منخفض أو هواء هابط تسبب فقدان الطائرة للارتفاع فجأة)",
 "風立つ": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ",
 "風笛": "مزمار القربة (آلة نفخ أنبوبية؛ ينفخ العازف الهواء في كيس ويخرجه عبر أنبوب النغمات المستمرة)",
 "風紀": "تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "風習": "عَادَة, عُرْف",
 "風聞": "إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "風致": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "風船": "نُفَّاخَة, بَالُون / مُنْطَاد",
 "風船爆弾": "قنبلة بالونية (قنبلة يحملها بالون)\nمثال: في الحرب العالمية الثانية أطلق اليابانيون قنابل بالونية ضد أمريكا الشمالية",
 "風船葛": "بازلاء القلب, كرمة البالون (نبات متسلق معمر خشبي ذو قرون بذور زينة كبيرة تشبه البالونات؛ الهند الاستوائية وإفريقيا وأمريكا)",
 "風草": "إراغروستيس, عشب الحب (أي من أعشاب مختلفة من جنس إراغروستيس؛ مفيدة بشكل خاص للعلف ومنع التعرية)",
 "風薬": "دواء البرد (دواء يهدف إلى تخفيف أعراض نزلات البرد الشائعة)",
 "風袋": "حمل حقيبة الظهر (حمل شيء ما في حقيبة على الظهر) / تحزيم, تعبئة (إحاطة شيء ما في طرد أو صندوق) / حشوة, مادة تعبئة (أي مادة تستخدم خاصة لحماية شيء ما)\nمثال: حمل الأكسجين في حقائب الظهر ضروري لرواد الفضاء",
 "風見": "دَوَّارَة رِيَاح (مؤنث دَوَّار، الجمع دَوَّارَات)",
 "風見鶏": "دَوَّارَة رِيَاح (مؤنث دَوَّار، الجمع دَوَّارَات) / مُتَذَبْذِب, مُحَايِد (شخص لا يتخذ موقفاً مع أي طرف في نزاع)",
 "風解": "إزهار, تزهير (رواسب مسحوقية على سطح ما) / إزهار, تفتح الزهور (وقت وعملية تبرعم وتفتح الزهور) / طفح جلدي (أي طفح أحمر على الجلد) / أوج, إبان (فترة الازدهار أو الإنتاجية القصوى)",
 "風評": "إِشَاعَة, شَائِعَة",
 "風説": "إِشَاعَة, شَائِعَة",
 "風諭": "تَلْمِيح / لَمَّحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه)\nمثال: لمح سامي منزلا.",
 "風貌": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "風趣": "أَنَاقَة",
 "風車": "طاحونة هوائية (آلةٌ يدوية يُطحن فيها الدَقِيْق؛ آلة ميكانيكية كبيرة تحرك بالحيوان أو الهواء أو الماء أو الكهرباء تستخدم لطحن الدقيق) / دولاب نار, عجلة كاثرين (لعبة نارية دائرية تدور حول نفسها وتطلق نيرانًا ملونة) / دولاب الهواء (لعبة تتكون من ريش من الورق الملون أو البلاستيك مثبتة بدبوس على عصا وتدور عندما توجه نحو الرياح) / عجلة الدبابيس (لعبة) (عجلة بها العديد من الدبابيس المثبتة بزوايا قائمة على حافتها) / أيونيم هاورثي, دولاب الهواء (شجيرة معمرة في تينيريفي ذات أوراق في وريدات تشبه دواليب الهواء)\nمثال: أدار عجلة الدبابيس وتوقفت والمؤشر على 'انطلق'",
 "風車小屋": "طاحونة هوائية (آلةٌ يدوية يُطحن فيها الدَقِيْق؛ آلة ميكانيكية كبيرة تحرك بالحيوان أو الهواء أو الماء أو الكهرباء تستخدم لطحن الدقيق)",
 "風通し": "تَهْوِيَة / اِتِّصَالَات, اِتِّصَال / رِسَالَة, خَبَر",
 "風速計": "مِرْيَاح",
 "風道": "خطوط جوية, شركة طيران (مؤسسة تجارية توفر رحلات مجدولة للركاب) / قناة تهوية, مجرى هواء (قناة توفر التهوية (كما في المناجم)) / مجرى التنفس, مسلك تنفسي (الممرات التي يدخل من خلالها الهواء ويخرج من الجسم) / مسار طيران, ممر جوي (طريق محدد تتبعه الطائرات في الطيران من مطار إلى آخر)",
 "風邪": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "風邪ひく": "أُصِيبَ بِبَرْدٍ",
 "風邪をひく": "أُصِيبَ بِبَرْدٍ",
 "風邪を引く": "أُصِيبَ بِبَرْدٍ",
 "風邪引く": "أُصِيبَ بِبَرْدٍ",
 "風邪薬": "دواء البرد (دواء يهدف إلى تخفيف أعراض نزلات البرد الشائعة)",
 "風配図": "وردة الرياح (خريطة طقس تظهر تردد وقوة الرياح من اتجاهات مختلفة)",
 "風采": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "風采があがらない": "غَيْر جَذَّاب, مُنَفِّر (يفتقر إلى الجمال أو السحر) / غَيْر مُسْتَمِيل (يفتقر إلى القدرة على إثارة الاهتمام) / غَيْر مُسْتَسَاغ, مُنَفِّر (لا يستهوي الحواس)\nمثال: غير جذاب مثل معظم مناطق التعدين",
 "風采が上がらない": "غَيْر جَذَّاب, مُنَفِّر (يفتقر إلى الجمال أو السحر) / غَيْر مُسْتَمِيل (يفتقر إلى القدرة على إثارة الاهتمام) / غَيْر مُسْتَسَاغ, مُنَفِّر (لا يستهوي الحواس)\nمثال: غير جذاب مثل معظم مناطق التعدين",
 "風量": "تدفق الهواء, تيار هوائي (سريان الهواء)\nمثال: عدلت المروحة بحيث يوجه تدفق الهواء نحوها مباشرة",
 "風鈴": "أجراس الرياح (ترتيب زخرفي لقطع من المعدن أو الزجاج أو الفخار تتدلى معاً بشكل فضفاض بحيث تسبب الرياح رنينها)",
 "風鈴草": "جريس متوسط, كأس وصحن (نبات أوروبي ثنائي الحول يزرع على نطاق واسع لأزهاره الزرقاء أو البنفسجية أو البيضاء) / جرس كانتربري, غلوكسينيا معمرة (عشب من كولومبيا إلى بيرو ذو أزهار أرجوانية شاحبة)",
 "風鐸": "أجراس الرياح (ترتيب زخرفي لقطع من المعدن أو الزجاج أو الفخار تتدلى معاً بشكل فضفاض بحيث تسبب الرياح رنينها)",
 "風防": "مصد رياح (سياج من الأشجار مصمم لتخفيف قوة الرياح وتقليل التعرية) / قَرِيس, قَرِيت",
 "風防ガラス": "زُجَاج السَيَّارَة الأَمَامِيّ",
 "風除け": "مصد رياح (سياج من الأشجار مصمم لتخفيف قوة الرياح وتقليل التعرية)",
 "風除室": "بهو, ردهة (مدخل كبير أو غرفة استقبال أو منطقة استقبال) / دهليز (أي من التجاويف الجسدية المختلفة المؤدية إلى تجويف آخر (كما في الأذن أو المهبل))",
 "風雅": "أَنَاقَة",
 "風雨": "عاصفة مطرية (عاصفة مصحوبة بمطر)",
 "風雪": "عاصفة ثلجية (عاصفة ذات تساقط ثلوج واسع النطاق مصحوبة برياح قوية) / مَشَقَّة, شِدَّة",
 "風雲": "طَبِيعَة, طبيعة / حَالَة, وَضْع",
 "風雲児": "جندي مرتزق, مرتزق (شخص يُستأجر للقتال لصالح دولة غير دولته)",
 "風雷益": "لغة يي, لولو (لغة لولو، يتحدث بها شعب يي أو لولو في الصين وفيتنام وتايلاند)",
 "風霜": "مَشَقَّة, شِدَّة",
 "風露草": "غُرْنُوق / جِيرَانِيُوم",
 "風靡": "غَالِب",
 "風韻": "أَنَاقَة",
 "風鳥": "طائر الجنة (أي من الطيور العديدة ذات الريش الملون ببراعة في منطقة غينيا الجديدة) / إستريلتزيا, عصفور الجنة (نبات زينة من جنوب أفريقيا الاستوائية وأمريكا الجنوبية له سيقان من الزهور البرتقالية والزرقاء الأرجوانية تشبه الطائر) / بوانسيانا, عصفور الجنة (شجيرة مزهرة استوائية لها زهور برتقالية زاهية أو حمراء؛ تصنف أحياناً في جنس بوانسيانا)",
 "颯々": "سرقة الماشية (سرقة الماشية) / حَفِيف, هَمْهَمِيّ (يتميز بأصوات ناعمة وخافتة) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "颯爽": "بَاسِل, صَنْدِيد (لَا يَتَرَاجَع فِي المَعْرَكَة أَوِ العَمَل) / فُرُوسِيّ, نَبِيل (يُبدي اهتماماً بالنساء كالفارس المثالي) / جَلِيل, شَامِخ (يتحلّى بالوقار والنُّبل الكبيرين أو يُظهرهما) / أَنِيق, جَرِيء (حيويّ ومفعم بالحماس والأناقة)",
 "颯颯": "سرقة الماشية (سرقة الماشية) / حَفِيف, هَمْهَمِيّ (يتميز بأصوات ناعمة وخافتة) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "颶風": "إِعْصَار (الرِيَاح التي تهب من الأرض وتثير الغبار فترتفع كالعمود إلى نحو السماء. زَوْبَعَة؛ دوّامات هوائيّة شديدة السرعة تدور حول مراكزٍ من الهواء عالي الضغط، سواء كانت فوق الأرض أو فوق الماء. [])\nمثال: السطح دمر من قبل الإعصار.",
 "颺言": "مِهْنَة / وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "飄々": "صفير (فعل الصفير بلحن) / تصفير, صفير (فعل الإشارة (مثل الاستدعاء) عن طريق التصفير أو النفخ في صافرة) / صفير (الصوت الناتج عن شيء يتحرك بسرعة أو بخار يخرج من فتحة صغيرة)\nمثال: أشار صفيره المبهج إلى أنه يستمتع بعمله / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / مُدْهِش, مُذْهِل (مُثير للإعجاب بشكل مُفاجئ لدرجة الذهول أو الإرباك) / مُتَسَاهِل, مُرِيح (مُسْتَرْخٍ وَغَيْرُ رَسْمِيٍّ فِي المَوْقِفِ أَوِ المَعَايِير) / مُرِيح, هَيِّن (لَيْسَ مُرْهِقًا أَوْ مُتَطَلِّبًا؛ يُنْجَز بِسُهُولَة وَبِدُون مَشَقَّة) / مُسْتَرْسِل, هَادِئ (غير مُتعجّل ولا قسريّ)",
 "飄然": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية) / بِشَكْل عَرَضِيّ, غَيْر مَنْهَجِيّ (ليس بشكل منهجي أو وفقاً لخطة)\nمثال: ألقى نظرة غير مبالية على العناوين / مُسْتَقِلّ, مُنْفَصِل (يستخدم للمباني؛ قائمة بمعزل عن غيرها) / غَيْرُ مُنْخَرِطٍ, مُنْفَصِلٌ عَاطِفِيًّا (يُظْهِرُ عَدَمَ انْخِرَاطٍ عَاطِفِيٍّ) / مَفْصُول, مُنْفَصِل (لَمْ يَعُدْ مُتَّصِلًا أَوْ مُلْتَحِمًا) / طَلِيق, مُنْفَصِل (غَيْر مُثَبَّت فِي مَوْضِعِه)\nمثال: منازل منفصلة",
 "飄逸": "مُتَسَاهِل, مُرِيح (مُسْتَرْخٍ وَغَيْرُ رَسْمِيٍّ فِي المَوْقِفِ أَوِ المَعَايِير) / مُرِيح, هَيِّن (لَيْسَ مُرْهِقًا أَوْ مُتَطَلِّبًا؛ يُنْجَز بِسُهُولَة وَبِدُون مَشَقَّة) / مُسْتَرْسِل, هَادِئ (غير مُتعجّل ولا قسريّ)",
 "飄零": "تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به",
 "飄飄": "صفير (فعل الصفير بلحن) / تصفير, صفير (فعل الإشارة (مثل الاستدعاء) عن طريق التصفير أو النفخ في صافرة) / صفير (الصوت الناتج عن شيء يتحرك بسرعة أو بخار يخرج من فتحة صغيرة)\nمثال: أشار صفيره المبهج إلى أنه يستمتع بعمله / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / مُدْهِش, مُذْهِل (مُثير للإعجاب بشكل مُفاجئ لدرجة الذهول أو الإرباك) / مُتَسَاهِل, مُرِيح (مُسْتَرْخٍ وَغَيْرُ رَسْمِيٍّ فِي المَوْقِفِ أَوِ المَعَايِير) / مُرِيح, هَيِّن (لَيْسَ مُرْهِقًا أَوْ مُتَطَلِّبًا؛ يُنْجَز بِسُهُولَة وَبِدُون مَشَقَّة) / مُسْتَرْسِل, هَادِئ (غير مُتعجّل ولا قسريّ)",
 "飛": "غُدَاف / قَلْعَة, رُخّ (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة. / فلاي بول, كرة طائرة ((بيسبول) ضربة تطير عالياً في الهواء)",
 "飛ばす": "قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه. / عدو (مشية سريعة للحصان؛ خطوة ثنائية الضربات تكون خلالها الأرجل الأربع مرتفعة عن الأرض في آن واحد) / مرذاذ (موزع يحول السائل (مثل العطر) إلى رذاذ ناعم) / غصن مزهر (تنسيق زهور يتكون من غصن واحد أو فرع يحمل أزهاراً وأوراقاً) / رذاذ (دفق من البخار أو قطرات السائل) / رذاذ, رشقة (كمية من الأجسام الصغيرة تتطاير في الهواء)\nمثال: رشقة من الرصاص / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "飛び": "طيران (حالة السفر جواً) / خَاطِف, عَابِر (سريع وقصير؛ على عجل) / سَرِيع الحَرَكَة, طَائِر (يتحرك بسرعة كبيرة)\nمثال: كان الطيران لا يزال مغامرة مثيرة بالنسبة له / صِفْر, ٠ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / مثال: بدأ سامي من نقطة الصفر. / سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي القصير) / قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "飛びっきり": "أَفْضَل / بشكل استثنائي (إلى درجة استثنائية)\nمثال: عمل بشكل جيد استثنائياً",
 "飛びっ切り": "أَفْضَل / بشكل استثنائي (إلى درجة استثنائية)\nمثال: عمل بشكل جيد استثنائياً",
 "飛びぬけて": "بامتياز, بشكل بارز (بطريقة بارزة أو إلى درجة بارزة)\nمثال: كانت ناجحة بشكل بارز في مهنتها",
 "飛びはねる": "نَقْز / نَقَزَ",
 "飛び上がる": "خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ) / أَقْلَعَ / اِزْدَهَرَ\nمثال: خلع سامي حذاءه.",
 "飛び入り": "فِي اللَّحْظَةِ الأَخِيرَة (قُبَيْل الموعد النهائي مباشرة)",
 "飛び出しナイフ": "سكين كبس, مِطواة زنبركية (سكين جيب بشفرة تفتح بالزنبرك عند الضغط على زر)",
 "飛び出す": "نَفِدَ / ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول) / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "飛び出す絵本": "كتاب مجسم, كتاب منبثق (كتاب (عادة للأطفال) يحتوي على صفحة أو أكثر بحيث يرتفع هيكل ثلاثي الأبعاد عند فتح الصفحة)",
 "飛び出る": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم.",
 "飛び切り": "أَفْضَل / بشكل استثنائي (إلى درجة استثنائية)\nمثال: عمل بشكل جيد استثنائياً",
 "飛び去る": "نَثَرَ, تَفَرَّقَ",
 "飛び地": "جيب, منطقة مكتنفة (إقليم محاط بأراضٍ أجنبية يختلف عنها ثقافياً)",
 "飛び将棋": "هالما (لعبة لوحية يحاول فيها اللاعبون تحريك قطعهم إلى قواعد خصمهم)",
 "飛び抜けて": "بامتياز, بشكل بارز (بطريقة بارزة أو إلى درجة بارزة)\nمثال: كانت ناجحة بشكل بارز في مهنتها",
 "飛び散る": "نَثَرَ, تَفَرَّقَ",
 "飛び板": "منطلق",
 "飛び石": "حجر أساس, نقطة انطلاق (أي وسيلة للتقدم) / حَجَرُ عُبُور (حجر في مستنقع أو مياه ضحلة يمكن الوقوف عليه للعبور)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء / وثب الحجارة (لعبة يتم فيها نط حجر مسطح على سطح ماء هادئ)",
 "飛び翔る": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة.",
 "飛び蝗虫": "جَرَادَة",
 "飛び越える": "شَفَّاف / وَاضِح / قفزة الضفدع, نط الحبل (لعبة ينحني فيها طفل ويقفز آخر من فوقه) / تجاوز, قفزة (التقدم كما في لعبة الأطفال، بالقفز فوق العقبات أو المنافسين)\nمثال: لا تزال الشركة تعتقد أن الرقاقة تمثل قفزة في التكامل وستحقق أرباحاً طائلة",
 "飛び越し": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "飛び跳ねる": "نَقْز / نَقَزَ",
 "飛び蹴り": "ركلة إسقاط ((كرة القدم الأمريكية) ركل (كما لهدف ميداني) حيث يتم إسقاط الكرة وركلها لحظة ملامستها للأرض)",
 "飛び込み": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "飛び込み台": "لوح الغطس (لوح قفز يمكن للسباحين الغطس منه)",
 "飛び込み営業": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت) / مِنْ بَابٍ لِبَاب ((عَنِ الرِّحْلَات أَوِ التَّوْصِيلَات) مُبَاشَرَة مِنْ نُقْطَة الأَصْل إِلَى الوِجْهَة)",
 "飛び込む": "غَاصَ / غَطْسَ, يقفز الى الماء",
 "飛び道具": "سِلَاح نَارِيّ",
 "飛び領土": "جيب, منطقة مكتنفة (إقليم محاط بأراضٍ أجنبية يختلف عنها ثقافياً)",
 "飛び飛び": "متفرق, متقطع (يتكرر في حالات متناثرة وغير منتظمة أو غير متوقعة)\nمثال: مدينة تتعرض لغارات قصف متقطعة",
 "飛び魚": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي القصير)",
 "飛ぶ": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة. / قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة. / ترشيش, طرطشة / عَجَلَة / أَسْرَعَ, اِنْدَفَعَ (أَسْرَعَ: ( فعل )؛ أَسْرَعُ)\nمثال: أسرع و إلا تأخرت.",
 "飛ぶ鳥": "طيور جؤجؤية, طيور طائرة (طيور لها عظام صدر جؤجؤية لربط عضلات الطيران)",
 "飛べない鳥": "طيور مسطحة الصدر, نعاميات (طيور لا تطير لها عظام صدر مسطحة تفتقر إلى الجؤجؤ لربط عضلات الطيران: النعام، الشبنم، الإيمو، الموا، الريا، الكيوي، طيور الفيل)",
 "飛んで": "صِفْر, ٠ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / مثال: بدأ سامي من نقطة الصفر. / طيران (حالة السفر جواً) / خَاطِف, عَابِر (سريع وقصير؛ على عجل) / سَرِيع الحَرَكَة, طَائِر (يتحرك بسرعة كبيرة)\nمثال: كان الطيران لا يزال مغامرة مثيرة بالنسبة له",
 "飛地": "جيب, منطقة مكتنفة (إقليم محاط بأراضٍ أجنبية يختلف عنها ثقافياً)",
 "飛将棋": "هالما (لعبة لوحية يحاول فيها اللاعبون تحريك قطعهم إلى قواعد خصمهم)",
 "飛揚": "طيران (حالة السفر جواً) / خَاطِف, عَابِر (سريع وقصير؛ على عجل) / سَرِيع الحَرَكَة, طَائِر (يتحرك بسرعة كبيرة)\nمثال: كان الطيران لا يزال مغامرة مثيرة بالنسبة له",
 "飛散": "بعثرة, نثر (عملية البعثرة) / تشتت, تفريق (الانتشار على نطاق واسع أو الطرد بعيداً) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة) / بعثرة, تشتت (العملية الفيزيائية التي تنحرف فيها الجسيمات عشوائياً نتيجة للتصادمات)",
 "飛散る": "نَثَرَ, تَفَرَّقَ",
 "飛散防止": "مُضَادٌّ لِلتَّشَظِّي, مُقَاوِمٌ لِلتَّحَطُّم (مُقَاوِمٌ لِلتَّحَطُّمِ أَوِ التَّشَظِّي)",
 "飛板": "منطلق",
 "飛沫": "مرذاذ (موزع يحول السائل (مثل العطر) إلى رذاذ ناعم) / غصن مزهر (تنسيق زهور يتكون من غصن واحد أو فرع يحمل أزهاراً وأوراقاً) / رذاذ (دفق من البخار أو قطرات السائل) / رذاذ, رشقة (كمية من الأجسام الصغيرة تتطاير في الهواء)\nمثال: رشقة من الرصاص / رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / قُطَيْرَة",
 "飛泉": "شَلَّال",
 "飛燕草": "عايق الحقل, عايق الصواريخ (عايق يزرع عادة في جنوب أوروبا له عناقيد غير متفرعة تشبه السنابل من الزهور الزرقاء أو الأرجوانية أو الوردية أحياناً؛ يوضع أحياناً في جنس دلفينيوم)",
 "飛球": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة.",
 "飛石": "حجر أساس, نقطة انطلاق (أي وسيلة للتقدم) / حَجَرُ عُبُور (حجر في مستنقع أو مياه ضحلة يمكن الوقوف عليه للعبور)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء / وثب الحجارة (لعبة يتم فيها نط حجر مسطح على سطح ماء هادئ)",
 "飛礫": "حَجَر, حجر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / حجر, حصى (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه) / نواة, عضم / رَجَمَ (رَجَمَ:تكلّم بالظنّ ويُقال:رجم بـ الغيب تكلّم بما لا يعلم ،والقبر :وضع عليه الرّجام،رجمه رَجْماً:رماه بالحجارة وقتله بها…؛ رجم الشخص:رماه بالحجارة ، أو قتله بها (رجم الشّعبُ القتلةَ)،رجمه بالقول:قذفه وشتمه،رجم بالغيب:تكلّم بما لا يعلم)\nمثال: عوقب زيري بالحجر.",
 "飛竜": "تنين طائر (أي من عدة سحالي آسيوية استوائية صغيرة قادرة على الانزلاق عن طريق نشر أغشية تشبه الأجنحة على جانبي الجسم)",
 "飛節": "عرقوب (المفصل الرصغي للساق الخلفية للثدييات ذوات الحوافر؛ يقابل الكاحل البشري) / نبيذ الراين, هوك (أي من أنواع النبيذ الأبيض المتعددة من وادي نهر الراين في ألمانيا)",
 "飛翔": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة) / تَحْلِيق / فِرَار, هُرُوب\nمثال: الطيران أسرع وسيلة سفر.",
 "飛翔体": "قَذْفِيّ, مَقْذُوف (يدفع أو يُدفَع إلى الأمام) / قذيفة, مقذوف (سلاح يُرمى أو يُقذف بقوة على الأهداف ولكنه ليس ذاتي الدفع) / صاروخ, مركبة صاروخية (أي مركبة ذاتية الدفع بواسطة محرك صاروخي)",
 "飛脚": "ساعي البريد (رجل يقوم بتوصيل البريد)",
 "飛蜥蜴": "تنين طائر (أي من عدة سحالي آسيوية استوائية صغيرة قادرة على الانزلاق عن طريق نشر أغشية تشبه الأجنحة على جانبي الجسم)",
 "飛蝗": "جَرَادَة",
 "飛螻蛄": "ذباب كاديس, ذبابة القمص (حشرة صغيرة تشبه العثة لها زوجان من الأجنحة الغشائية المشعرة ويرقات مائية)",
 "飛行": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة) / تَحْلِيق / فِرَار, هُرُوب\nمثال: الطيران أسرع وسيلة سفر.",
 "飛行の三鈷": "ثُلَاثِيُّ الشُّعَب (ذُو ثَلَاثِ شُعَب)",
 "飛行体": "طَائِرَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر)\nمثال: لقد وصلت الطائرة.",
 "飛行便": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة) / تَحْلِيق / فِرَار, هُرُوب\nمثال: الطيران أسرع وسيلة سفر.",
 "飛行場": "مَهْبِط, مَدْرَج",
 "飛行士": "طَيَّار, طَيَّارَة (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "飛行家": "طَيَّار (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "飛行機": "طَائِرَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر) / طَيَّارَة (هي الطَائِرَة؛ هي الطائرة الورقية)\nمثال: لقد وصلت الطائرة.",
 "飛行機酔い": "داء الجو, دوار الجو (دوار الحركة الذي يحدث أثناء السفر بالطائرة (خاصة أثناء الاضطرابات الجوية))",
 "飛行機雲": "أثر التكثف, ذيل بخاري (سحابة اصطناعية تصنعها طائرة؛ ناتجة إما عن التكثف بسبب انخفاض ضغط الهواء فوق سطح الجناح أو عن بخار الماء في عادم المحرك)",
 "飛行甲板": "سطح الطيران (السطح العلوي لحاملة طائرات؛ يستخدم كمدرج)",
 "飛行禁止空域": "مِنْطَقَةُ حَظْرِ الطَّيَرَان (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "飛行船": "سفينة هوائية, منطاد موجه (طائرة ذاتية الدفع قابلة للتوجيه)",
 "飛行艇": "قارب طائر (طائرة مائية كبيرة تطفو ببدنها في الماء بدلاً من استخدام عوامات)",
 "飛行隊": "سِلَاح طَيَرَان",
 "飛行雲": "أثر التكثف, ذيل بخاري (سحابة اصطناعية تصنعها طائرة؛ ناتجة إما عن التكثف بسبب انخفاض ضغط الهواء فوق سطح الجناح أو عن بخار الماء في عادم المحرك)",
 "飛語": "نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "飛越": "ترويق, تصفية (فعل إزالة الجزيئات الصلبة من سائل) / تبرئة (فعل التحرير من الشكوك) / فُرْجَة, فُسْحَة (قطعة أرض بها عدد قليل من الأشجار أو خالية منها تقع وسط منطقة حرجية)",
 "飛越し": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "飛距離": "بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "飛跡": "أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / مِضْمَار\nمثال: اختفى فلم ير له أثر.",
 "飛跳ねる": "نَقْز / نَقَزَ",
 "飛躍": "وَثَبَ (طَفَرَ أو قَفَزَ وهو يجري)",
 "飛躍的": "عَظِيم, هَائِل (كبير بشكل استثنائي في الحجم أو المدى أو الكمية أو القوة أو الدرجة) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف) / شَدِيد, مَهُول (بالغ في الدرجة أو المدى أو المقدار أو التأثير)",
 "飛車": "غُدَاف / قَلْعَة, رُخّ (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "飛輪": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس. / حَدَّافَة",
 "飛込み": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "飛道具": "سِلَاح نَارِيّ",
 "飛雪": "عَاصِفَة ثَلْجِيَّة, دَمَق",
 "飛魚": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي القصير)",
 "飛魚座": "سمك طائر (أسماك بحرية استوائية لها زعانف مكبرة تشبه الأجنحة تُستخدم للطيران الانزلاقي القصير)",
 "飛鳥": "طيور جؤجؤية, طيور طائرة (طيور لها عظام صدر جؤجؤية لربط عضلات الطيران)",
 "飛鼠": "وَطْوَاط, خُفَّاش / مِضْرَب, عَصًا",
 "飛龍": "تنين طائر (أي من عدة سحالي آسيوية استوائية صغيرة قادرة على الانزلاق عن طريق نشر أغشية تشبه الأجنحة على جانبي الجسم)",
 "飜": "أُسْرَة هَان / هَان, قَوْمِيَّة اَلْهَان",
 "飜って": "بالمقابل, عكسياً (مع عكس شروط العلاقة)\nمثال: بالمقابل، ليست كل النساء أمهات",
 "食": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام. / أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / وَجْبَة, أكلة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة. / كُسُوف, خُسُوف",
 "食あたり": "اضطراب معوي, تسمم غذائي (مرض ناتج عن طعام سام أو ملوث)",
 "食い": "أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "食いしばる": "إمساك, قبضة (فعل الإمساك) / عقدة تثبيت (أنشوطة صغيرة مصنوعة بالربط)\nمثال: أرخى قبضته عن ذراعي",
 "食いしん坊": "أَكَّال, شَرَه",
 "食いすぎ": "شراهة, نهم (الأكل بإفراط (تُشخص كإحدى الخطايا السبع المميتة))",
 "食いつき": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "食いつく": "قَضَمَ / تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "食いで": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر)",
 "食い下がる": "كَلْبُ صَيْد (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا خُرِز)\nمثال: كان الكلب ميتا.",
 "食い付き": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "食い付く": "قَضَمَ / تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "食い入るように": "بشوق, بلهفة\nمثال: كانت الأخبار منتظرة بلهفة",
 "食い出": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر)",
 "食い合わす": "إمساك, قبضة (فعل الإمساك) / عقدة تثبيت (أنشوطة صغيرة مصنوعة بالربط)\nمثال: أرخى قبضته عن ذراعي",
 "食い合わせ": "تَعْشِيقَة / عَشَّقَ (فرط الحب حتى لا يستطيع العاشق الابتعاد عن المعشوق) / اِنْسَجَمَ مَعَ, رَكَّبَ\nمثال: أغاني العشق تحرك مشاعري.",
 "食い尽くし系": "أَكَّال, شَرَه",
 "食い意地": "نَهَم, شَرَه",
 "食い戻し": "اجترار",
 "食い止める": "تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ",
 "食い残し": "الْبَقَايَا",
 "食い殺す": "اِلْتَهَمَ",
 "食い気": "شَهِيَّة",
 "食い気味": "قَاطَعَ",
 "食い物": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام. / فَرِيسَة / غَنِيمَة",
 "食い物屋": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "食い締める": "إمساك, قبضة (فعل الإمساك) / عقدة تثبيت (أنشوطة صغيرة مصنوعة بالربط)\nمثال: أرخى قبضته عن ذراعي",
 "食い縛る": "إمساك, قبضة (فعل الإمساك) / عقدة تثبيت (أنشوطة صغيرة مصنوعة بالربط)\nمثال: أرخى قبضته عن ذراعي",
 "食い荒す": "أَبْلَى, أَهْلَكَ (فعل بجهد ومشقة، أصلها إجتاز البلاء؛ قد تكون بمعنى بَلِي؛ قدم وأَخْلَقَ)\nمثال: أبلى في الامتحان بلاء حسنا. / سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "食い荒らす": "أَبْلَى, أَهْلَكَ (فعل بجهد ومشقة، أصلها إجتاز البلاء؛ قد تكون بمعنى بَلِي؛ قدم وأَخْلَقَ)\nمثال: أبلى في الامتحان بلاء حسنا. / سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "食い足りない": "غَيْرُ مُرْتَاح, قَلِق (مَشْغُول البَال وَغَيْر مُطْمَئِنّ) / غَيْرُ رَاضٍ, غَيْرُ مُشْبَع (لم يُشبَع أو لم يُلَبَّ له ما يطلب)",
 "食い込み": "توغل, غارة (تعدٍ أو اقتحام) / توغل, غارة (غزو أو هجوم عدائي)\nمثال: قاموا بتوغلات في سوق الولايات المتحدة / عَجْز / حذاء وتدي (حذاء بكعب وتدي متصل)",
 "食い込む": "اِخْتَلَسَ, أَزْعَجَ",
 "食い過ぎ": "شراهة, نهم (الأكل بإفراط (تُشخص كإحدى الخطايا السبع المميتة))",
 "食い道楽": "أكول, شرِه (شخص مفرط في الأكل والشرب)",
 "食い違い": "فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ",
 "食い違う": "اِخْتَلَفَ (ضد اِتَّفَقَ، كانوا على خِلاف مع بعض أو ذوو آراء مُخْتَلِفَة؛ إلى المكان: كرر الذهاب إلى إليه مرة بعد مرة)\nمثال: أنا اختلف معك في الرأي.",
 "食う": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي. / عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة / إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال) / مستفز, مشاكس (شخص يميل إلى المشاكسة (عن طريق السخرية أو إثارة الفضول))\nمثال: تجاهل تهكمهم",
 "食えない": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء. / غير صالح للأكل (غير مناسب كطعام)",
 "食す": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا. / حَكَمَ, تَحَكَّمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "食する": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "食ってかかる": "شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه) / اِنْقَلَبَ عَلَى\nمثال: شغل بيل التلفاز.",
 "食って掛かる": "شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه) / اِنْقَلَبَ عَلَى\nمثال: شغل بيل التلفاز.",
 "食べかす": "الْبَقَايَا",
 "食べごたえ": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر)",
 "食べすぎ": "شراهة, نهم (الأكل بإفراط (تُشخص كإحدى الخطايا السبع المميتة))",
 "食べで": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر)",
 "食べどころ": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "食べにくい": "غير مستساغ, كريه (غير لطيف أو غير مقبول للطعم أو للعقل)\nمثال: وجبة غير مستساغة",
 "食べる": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "食べカス": "الْبَقَايَا",
 "食べ処": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "食べ出": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر)",
 "食べ合わせ": "تركيب, جمع (عملية دمج الأشياء لتكوين كلٍ جديد) / توافيق, توليفة (فعل ترتيب العناصر في مجموعات محددة بغض النظر عن الترتيب) / تركيبة, توليفة (مجموعة من الأشياء التي تم دمجها؛ تجميع لأجزاء أو صفات منفصلة) / ائتلاف, تكتل (تحالف من الأشخاص أو الشركات أو البلدان لغرض خاص (سابقاً لتحقيق غاية معادية للمجتمع ولكن الآن لأغراض سياسية أو اقتصادية عامة))",
 "食べ応え": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر)",
 "食べ残し": "الْبَقَايَا",
 "食べ滓": "الْبَقَايَا",
 "食べ物": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "食べ物屋": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "食べ粕": "الْبَقَايَا",
 "食べ過ぎ": "شراهة, نهم (الأكل بإفراط (تُشخص كإحدى الخطايا السبع المميتة))",
 "食べ難い": "غير مستساغ, كريه (غير لطيف أو غير مقبول للطعم أو للعقل)\nمثال: وجبة غير مستساغة",
 "食み": "أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "食み出す": "نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول) / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "食み出る": "نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول) / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "食む": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "食らいつく": "قَضَمَ",
 "食らい付く": "قَضَمَ",
 "食らう": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "食らわす": "اِتِّفَاقِيَّة",
 "食らわせる": "اِتِّفَاقِيَّة",
 "食わす": "أَطْعَمَ, غَذَّى / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / اِتِّفَاقِيَّة / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "食わせる": "أَطْعَمَ, غَذَّى / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / اِتِّفَاقِيَّة / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "食わせ物": "مُزَيَّف / دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "食わせ者": "دجال, محتال (شخص يقدم ادعاءات خادعة)",
 "食を断つ": "عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان.",
 "食パン": "خُبْز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / عيش (مصدر للفعل عَاشَ؛ هو الحَيَاة) / خُبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / خبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / قرص / خَبَزَ (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب)\nمثال: هذا الخبز لذيذ.",
 "食中り": "اضطراب معوي, تسمم غذائي (مرض ناتج عن طعام سام أو ملوث)",
 "食中毒": "اضطراب معوي, تسمم غذائي (مرض ناتج عن طعام سام أو ملوث)",
 "食事": "وَجْبَة, أكلة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة. / حِمْيَة, حِمْيَة غِذَائِيَّة / حِمْيَة, نِظَام غِذَائِيّ / بَرْلَمَان, مَجْلِس",
 "食事会": "حفل عشاء, عزومة عشاء (حفلة يجتمع فيها الناس لتناول العشاء معاً)\nمثال: يجب ألا يتأخر الضيوف عن حفل العشاء أبداً",
 "食事処": "مَطْعَم",
 "食事券": "تذكرة طعام, قسيمة وجبة (قسيمة قابلة للاسترداد في مطعم وتخول حاملها الحصول على وجبة) / مصدر دخل (مصدر للدخل أو الرزق)",
 "食事時": "وقت الطعام, وقت الوجبة (الساعة التي تُؤكل فيها وجبة عادة أو عرفاً)",
 "食事療法学": "علم الحمية, نظام غذائي (الدراسة العلمية لإعداد الطعام وتناوله)",
 "食人": "أكل لحوم الجنس الواحد (ممارسة أكل لحم جنسك)",
 "食人族": "غُول, آكِلُ لُحُوم البَشْر",
 "食人種": "غُول, آكِلُ لُحُوم البَشْر",
 "食付き": "عَضَّ, قَضَمَ / عَضَّ / قَرْصة / لُقْمة",
 "食作用": "بلعمة (عملية تقوم فيها الخلايا البلعمية بابتلاع وهضم الكائنات الحية الدقيقة والحطام الخلوي؛ دفاع مهم ضد العدوى)",
 "食俸": "راتب, مخصص (مبلغ من المال يخصص بشكل منتظم؛ عادة لغرض محدد)",
 "食傷": "إفراط في الأكل, تخمة (الأكل حتى الامتلاء المفرط) / إغراق, تخمة (صفة الوفرة المفرطة لدرجة انخفاض الأسعار) / إفراط, تخمة (حالة الامتلاء بأكثر من اللازم) / اضطراب معوي, تسمم غذائي (مرض ناتج عن طعام سام أو ملوث)",
 "食処": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "食券": "تذكرة طعام, قسيمة وجبة (قسيمة قابلة للاسترداد في مطعم وتخول حاملها الحصول على وجبة) / مصدر دخل (مصدر للدخل أو الرزق)",
 "食刻": "حفر, نقش (عمل لوحات محفورة أو منقوشة وطباعة التصاميم منها) / لوحة محفورة (لوحة محفورة باستخدام الحمض) / تنميش, حفر كيميائي (طبعة مصنوعة من لوح محفور)",
 "食前酒": "أبيرتيف, فاتح للشهية (مشروب كحولي يؤخذ قبل الوجبة لفتح الشهية)",
 "食卓": "سُفْرَة (طَعَامُ الْمُسَافِرِ؛ مَائِدَةُ الطَّعَامِ)",
 "食卓塩": "ملح, ملح الطعام (شكل بلوري أبيض لكلوريد الصوديوم خاصة يستخدم لتتبيل وحفظ الطعام)",
 "食味": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "食品": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "食品メーカー": "شركة أغذية, شركة غذائية (شركة تقوم بمعالجة وبيع المواد الغذائية)",
 "食品ロス": "قمامة, نفايات الطعام (طعام يتم التخلص منه (كما هو الحال من المطبخ))",
 "食品中毒": "اضطراب معوي, تسمم غذائي (مرض ناتج عن طعام سام أو ملوث)",
 "食品会社": "شركة أغذية, شركة غذائية (شركة تقوم بمعالجة وبيع المواد الغذائية)",
 "食品医薬品局": "إدارة الغذاء والدواء (وكالة فيدرالية في وزارة الصحة والخدمات الإنسانية تأسست لتنظيم إصدار الأطعمة الجديدة والمنتجات المتعلقة بالصحة)",
 "食品店": "بِقَالَة, حَانُوت بَقَّال",
 "食品添加物": "مادة مضافة للطعام, مضاف غذائي (مادة تضاف للطعام لتحسين نكهته أو مظهره أو فترة صلاحيته)",
 "食器": "أواني المائدة (أدوات للاستخدام على المائدة (أطباق وأدوات فضية وأواني زجاجية))",
 "食器一揃い": "طقم مائدة (أدوات المائدة التي تتكون من مجموعة كاملة من الأصناف (الفضية أو الأطباق) للاستخدام على المائدة)",
 "食器室": "خزانة طعام, مخزن المؤن (مخزن صغير لتخزين الأطعمة أو المشروبات)",
 "食器棚": "خِزَانَة (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "食器洗い": "غسل الأطباق, غسل الصحون (فعل غسل الأطباق)",
 "食器洗い機": "غَسَّالَة صُحُون (صيغة مبالغة من غَسَلَ بمعنى الذي يغسل كثيرا. تجمع على غسّالات وغواسل؛ المرأة التي تتخذ من غسل الملابس مهنة لها. تجمع على غسّالات)\nمثال: تعطلت الغسالة مجددا.",
 "食器洗浄器": "غَسَّالَة صُحُون (صيغة مبالغة من غَسَلَ بمعنى الذي يغسل كثيرا. تجمع على غسّالات وغواسل؛ المرأة التي تتخذ من غسل الملابس مهنة لها. تجمع على غسّالات)\nمثال: تعطلت الغسالة مجددا.",
 "食器洗浄機": "غَسَّالَة صُحُون (صيغة مبالغة من غَسَلَ بمعنى الذي يغسل كثيرا. تجمع على غسّالات وغواسل؛ المرأة التي تتخذ من غسل الملابس مهنة لها. تجمع على غسّالات)\nمثال: تعطلت الغسالة مجددا.",
 "食器類": "أواني العشاء (أدوات المائدة (الأطباق وصحون التقديم والأوعية وغيرها) المستخدمة في تقديم الوجبة)",
 "食堂": "غَرْفَةْ الطَعَام, مَطْعَم (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة. / مَطْعَم",
 "食堂車": "حَافِلَة طَعَام (وسيلة نَقْل للركاب)\nمثال: لنذهب بالحافلة.",
 "食塩": "ملح, ملح الطعام (شكل بلوري أبيض لكلوريد الصوديوم خاصة يستخدم لتتبيل وحفظ الطعام)",
 "食塩不使用": "غَيْرُ مُتَبَّل, غَيْرُ مُمَلَّح (بِدُونِ مِلْحٍ أَوْ تَوَابِل)",
 "食奉": "راتب, مخصص (مبلغ من المال يخصص بشكل منتظم؛ عادة لغرض محدد)",
 "食客": "مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج)) / ضيف المنزل (ضيف يتم استقباله في منزلك)",
 "食屍鬼": "غُول",
 "食店": "مَطْعَم",
 "食当たり": "اضطراب معوي, تسمم غذائي (مرض ناتج عن طعام سام أو ملوث)",
 "食指": "سبابة (الإصبع المجاور للإبهام)",
 "食文化": "طَبْخ, طَبِيخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ.",
 "食料": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "食料品": "بقالة, مواد غذائية (سلع استهلاكية تباع عند البقال) / مادة غذائية, منتج غذائي (مادة يمكن استخدامها أو تحضيرها للاستخدام كطعام)",
 "食料品商": "بِقَالَة, حَانُوت بَقَّال",
 "食料品店": "بَقَّال, بَقَّالَة",
 "食料庫": "خزانة طعام, مخزن المؤن (مخزن صغير لتخزين الأطعمة أو المشروبات)",
 "食料貯蔵室": "خزانة طعام, مخزن المؤن (مخزن صغير لتخزين الأطعمة أو المشروبات) / بيت المؤونة, خزين البيت (إمدادات من الطعام خاصة للمنزل)",
 "食料雑貨店": "بقالة, مواد غذائية (سلع استهلاكية تباع عند البقال) / بقالة, متجر بقالة (سوق تباع فيه مواد البقالة)\nمثال: تضمن متجر البقالة سوقاً للحوم",
 "食時": "وقت الطعام, وقت الوجبة (الساعة التي تُؤكل فيها وجبة عادة أو عرفاً)",
 "食材": "بقالة, مواد غذائية (سلع استهلاكية تباع عند البقال) / مادة غذائية, منتج غذائي (مادة يمكن استخدامها أو تحضيرها للاستخدام كطعام)",
 "食欲": "شَهِيَّة",
 "食欲不振": "قَهَم",
 "食欲不振症": "قَهَم",
 "食欲低下": "قَهَم",
 "食欲旺盛": "قِرْشَبّ, أَكُول (الرجل المسن الضخم العظيم الخلق؛ السيد الشريف الذي له هيبة ووقار)",
 "食残し": "الْبَقَايَا",
 "食油": "زَيْت اَلْطَهِي (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن)\nمثال: خبأن ذلك الزيت.",
 "食洗機": "غَسَّالَة صُحُون (صيغة مبالغة من غَسَلَ بمعنى الذي يغسل كثيرا. تجمع على غسّالات وغواسل؛ المرأة التي تتخذ من غسل الملابس مهنة لها. تجمع على غسّالات)\nمثال: تعطلت الغسالة مجددا.",
 "食物": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام. / طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام. / فَرِيسَة / غَنِيمَة",
 "食物アレルギー": "حساسية الطعام (رد فعل تحسسي لمادة يتم تناولها في الطعام)",
 "食物連鎖": "سلسلة غذائية ((في البيئة) مجتمع من الكائنات الحية حيث يتم أكل كل عضو بدوره من قبل عضو آخر)",
 "食生活": "عَادَات اَلْأَكْل",
 "食用": "صَالِح لِلْأَكَل ((في الإسلام) نبي ورد ذكره في القرآن، أُرسل إلى قوم ثمود؛ اسم شخصي معطًى للذكور من العرب)\nمثال: قم بما هو صالح.",
 "食用ガエル": "ضفدع الثور (أكبر ضفدع في أمريكا الشمالية؛ مائي للغاية وله صوت عميق النبرة)",
 "食用油": "زَيْت اَلْطَهِي (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن)\nمثال: خبأن ذلك الزيت.",
 "食用色素": "صبغة غذائية, ملون غذائي (مادة قابلة للهضم تستخدم لإعطاء لون للطعام)\nمثال: ملون غذائي مصنوع من صبغات نباتية",
 "食用蛙": "ضفدع الثور (أكبر ضفدع في أمريكا الشمالية؛ مائي للغاية وله صوت عميق النبرة)",
 "食禄": "رَاتِب, أَجْر",
 "食糞": "أكل البراز (تناول البراز؛ يعد عرضًا لبعض أنواع الجنون عند البشر)",
 "食糧": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "食糧銀行": "بنك الطعام (مكان يتم فيه التبرع بالطعام وإتاحته للمحتاجين)\nمثال: أنشأوا بنك طعام لضحايا الفيضان",
 "食細胞": "بلعم, خلية بلعمية (خلية تبتلع وتهضم الحطام والكائنات الحية الدقيقة الغازية)",
 "食習慣": "عَادَات اَلْأَكْل",
 "食肉": "لَحْم, لحمة (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "食肉センター": "مذبح, مسلخ (مبنى يتم فيه ذبح الحيوانات)",
 "食肉加工": "تعبئة اللحوم (تعبئة اللحوم بالجملة للبيع المستقبلي (بما في ذلك الذبح والمعالجة والتوزيع لتجار التجزئة))",
 "食肉植物": "نبات آكل للحشرات, نبات لاحم (نباتات متكيفة لجذب والتقاط وهضم الحشرات بشكل أساسي ولكن أيضاً الحيوانات الصغيرة الأخرى)",
 "食肉解体": "قتل جماعي, مجزرة (القتل الوحشي والمفرط لعدد كبير من الناس) / جزارة (عمل الجزار) / مذبح, مسلخ (مبنى يتم فيه ذبح الحيوانات)",
 "食肉類": "لَاحِم (فِي حَيَوَانٌ لَاحِم هو الذي يتكون نظامه الغذائي أساسيا من اللُّحُومِ؛ النَّبَات اللََاجِم هو نبات يتغذى على اللحم؛غالباً الحشرات)",
 "食膳": "سُفْرَة (طَعَامُ الْمُسَافِرِ؛ مَائِدَةُ الطَّعَامِ)",
 "食荒らす": "أَبْلَى, أَهْلَكَ (فعل بجهد ومشقة، أصلها إجتاز البلاء؛ قد تكون بمعنى بَلِي؛ قدم وأَخْلَقَ)\nمثال: أبلى في الامتحان بلاء حسنا. / سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "食虫": "آكل الحشرات (أي كائن حي يتغذى بشكل أساسي على الحشرات) / آكل الحشرات (ثدييات صغيرة آكلة للحشرات ليلية بشكل رئيسي برية أو حفارة)",
 "食虫性": "آكِل لِلْحَشَرَات ((للحيوانات والنباتات) يتغذى على الحشرات)",
 "食虫植物": "نبات آكل للحشرات, نبات لاحم (نباتات متكيفة لجذب والتقاط وهضم الحشرات بشكل أساسي ولكن أيضاً الحيوانات الصغيرة الأخرى)",
 "食虫花": "نبات آكل للحشرات, نبات لاحم (نباتات متكيفة لجذب والتقاط وهضم الحشرات بشكل أساسي ولكن أيضاً الحيوانات الصغيرة الأخرى)",
 "食虫虻": "ذبابة سارقة (ذبابة مفترسة سريعة لها جسم قوي يشبه النحلة مع خرطوم صلب لامتصاص عصارة الحشرات الأخرى التي يتم اصطيادها أثناء الطيران)",
 "食込む": "اِخْتَلَسَ, أَزْعَجَ",
 "食通": "شره, نهم (طبع وعادات الأكول) / ذَوَّاق",
 "食道": "مريء (الممر بين البلعوم والمعدة)",
 "食道楽": "أكول, شرِه (شخص مفرط في الأكل والشرب)",
 "食道炎": "التهاب المريء (التهاب المريء؛ غالباً ما يكون سببه الارتجاع المعدي المريئي)",
 "食道鏡": "منظار المريء (أداة بصرية لفحص الجزء الداخلي من المريء)",
 "食違う": "اِخْتَلَفَ (ضد اِتَّفَقَ، كانوا على خِلاف مع بعض أو ذوو آراء مُخْتَلِفَة؛ إلى المكان: كرر الذهاب إلى إليه مرة بعد مرة)\nمثال: أنا اختلف معك في الرأي.",
 "食酢": "خَلّ ((خَلَّ) خلا وخلولا: صار فيه خلل؛ (خَلَّ) لحمه: قل ونحف)\nمثال: تذوق زيري ذلك الخل.",
 "食養": "علم الحمية, نظام غذائي (الدراسة العلمية لإعداد الطعام وتناوله) / ماكروبايوتيك (نظرية تعزيز الصحة وطول العمر عن طريق النظام الغذائي (خاصة الحبوب الكاملة والبقوليات))",
 "食餌": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "飢え": "رَغْبَة, تَعَطُّش / جَاعَ (أَصَابَهُ الجُوعُ؛ أَصَابَهُ الفَقْرُ الشَّديدُ)\nمثال: جاع الرجل العجوز حتى الموت.",
 "飢える": "تَضَوَّرَ",
 "飢え死": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "飢え死に": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "飢きん": "مَجَاعَة",
 "飢死": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "飢死に": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "飢渇": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "飢餓": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "飢餓感": "رَغْبَة, تَعَطُّش / جَاعَ (أَصَابَهُ الجُوعُ؛ أَصَابَهُ الفَقْرُ الشَّديدُ)\nمثال: جاع الرجل العجوز حتى الموت.",
 "飢饉": "مَجَاعَة",
 "飯": "وَجْبَة, أكلة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة. / مَعِيشَة, مَعَاش / طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "飯ごう": "أواني الطهي (أداة مطبخ مصنوعة من مادة لا تذوب بسهولة؛ تستخدم للطهي)",
 "飯の種": "قوت, مصدر رزق (الوسائل المالية التي يعيش بها المرء)\nمثال: لم يعد قادراً على كسب رزقه",
 "飯を喰う": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / اِرْتَزَقَ",
 "飯を食う": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / اِرْتَزَقَ",
 "飯ウマ": "شَمَاتَة",
 "飯切": "مُسَطَّح القَاع (ذو قاع مُسَطَّح ومُسْتَوٍ)",
 "飯切り": "مُسَطَّح القَاع (ذو قاع مُسَطَّح ومُسْتَوٍ)",
 "飯台": "سُفْرَة (طَعَامُ الْمُسَافِرِ؛ مَائِدَةُ الطَّعَامِ)",
 "飯屋": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "飯時": "وقت الطعام, وقت الوجبة (الساعة التي تُؤكل فيها وجبة عادة أو عرفاً)",
 "飯桐": "إديسيا (شجرة آسيوية مستديرة الرأس نفضية تزرع على نطاق واسع في المناخات المعتدلة كزينة لأوراقها القلبية وأزهارها الصفراء الخضراء العطرة تليها عناقيد متدلية من…)",
 "飯炊き": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر.",
 "飯盒": "أواني الطهي (أداة مطبخ مصنوعة من مادة لا تذوب بسهولة؛ تستخدم للطهي)",
 "飯盛り": "خادمة (عاملة منزلية)",
 "飯米": "أَرُزّ, رُزّ ((أَرَزَّت) الجرادةُ: رَزَّت)\nمثال: هكذا نطهي الأرز",
 "飲": "شُرْب (جَرَعَ)\nمثال: جلس وشرب قهوته.",
 "飲ます": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "飲ませる": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "飲み": "شَرِبَ, شرب (جَرَعَ) / شَرَاب, مَشْرُوب / شراب\nمثال: جلس وشرب قهوته. / حنفية, صنبور (منظم للتحكم في تدفق السائل من خزان) / سدادة حنفية, صنبور (سدادة لفتحة البرميل في برميل خشبي)",
 "飲みくだす": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو",
 "飲みにくい": "بَغِيض, غَيْر مَقْبُول (ليس على هواك) / غَيْرُ مُتَعَاطِفٍ, مُنَفِّر (لَا يَتَّفِقُ مَعَ أَذْوَاقِكَ أَوْ تَوَقُّعَاتِكَ) / بَغِيض, كَرِيه المُعَاشَرَة (غير سار في التعامل معه)\nمثال: موقف بغيض",
 "飲み下す": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو",
 "飲み助": "مُعَاقِر الخَمْر, شَارِب الخَمْر",
 "飲み口": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول. / تَنَصَّتَ",
 "飲み屋": "حَانَة, بَار",
 "飲み師": "كحولي, مدمن كحول (شخص يشرب الكحول بإفراط وبشكل اعتيادي)",
 "飲み干す": "بَالُوعَة",
 "飲み抜け": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "飲み歩き": "جولة حانات (جولة في الحانات (عادة مع تناول مشروب في كل محطة))",
 "飲み水": "مَاء شُرْب, مَاء صَالِح لِلشُّرْبِ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "飲み物": "شَرِبَ, شرب (جَرَعَ) / شَرَاب, مَشْرُوب / شراب\nمثال: جلس وشرب قهوته.",
 "飲み薬": "طب باطني, طب عام (فرع الطب الذي يتعامل مع تشخيص وعلاج (غير جراحي) لأمراض الأعضاء الداخلية (خاصة عند البالغين))",
 "飲み込み": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو / فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "飲み込みが悪い": "بَطِيء الفَهْم, ضَعِيف العَقْل (متأخر في التطور العقلي والذهني)",
 "飲み込みが早い": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "飲み込む": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / اِحْتَوَى, تَضَمَّنَ / اِحْتَوَى",
 "飲む": "شَرِبَ, شرب (جَرَعَ) / شَرَاب, مَشْرُوب / شراب\nمثال: جلس وشرب قهوته. / دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة. / جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل.",
 "飲めや歌え": "احتفال صاخب, سَمَر (مرح واحتفال غير مقيد)",
 "飲んだくれ": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "飲ん兵衛": "مُعَاقِر الخَمْر, شَارِب الخَمْر",
 "飲下す": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو",
 "飲兵衛": "مُعَاقِر الخَمْر, شَارِب الخَمْر",
 "飲助": "مُعَاقِر الخَمْر, شَارِب الخَمْر",
 "飲口": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول. / تَنَصَّتَ",
 "飲師": "كحولي, مدمن كحول (شخص يشرب الكحول بإفراط وبشكل اعتيادي)",
 "飲抜け": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "飲料": "شَرَاب, مَشْرُوب",
 "飲料水": "مَاء شُرْب, مَاء صَالِح لِلشُّرْبِ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "飲水": "مَاء شُرْب, مَاء صَالِح لِلشُّرْبِ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "飲物": "شَرِبَ, شرب (جَرَعَ) / شَرَاب, مَشْرُوب / شراب\nمثال: جلس وشرب قهوته.",
 "飲用": "شُرْب (جَرَعَ)\nمثال: جلس وشرب قهوته.",
 "飲薬": "طب باطني, طب عام (فرع الطب الذي يتعامل مع تشخيص وعلاج (غير جراحي) لأمراض الأعضاء الداخلية (خاصة عند البالغين))",
 "飲酒家": "شَارِب",
 "飲酒店": "حَانَة, بَار",
 "飲酒検知器": "جهاز فحص الكحول, مقياس الكحول بالنفس (جهاز يقيس المواد الكيميائية (خاصة محتوى الكحول) في زفير الشخص)",
 "飲酒癖": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو التساهل) / إفراط, عدم اعتدال (استهلاك المشروبات الكحولية) / إفراط, عدم اعتدال (جودة عدم الاعتدال)\nمثال: تطرف لغتهم",
 "飲食店": "مَطْعَم",
 "飴": "حَلْوَى, حَلْوَى سُكَّرِيَّة / كَهْرَمَان (عَلَك أُحْفُوْرِيّ افرزته اشجار من المخروطيات نبتت في عصور جيولوجية قديمة، وقد يقال قَهْرَمَان) / كَهْرَمَانِيّ",
 "飴ちゃん": "حَلْوَى, حَلْوَى سُكَّرِيَّة",
 "飴と鞭": "الْعَصَا وَٱلْجَزَرَة",
 "飴坊": "بق الماء المتزحلق (بق طويل الأرجل ينزلق على سطح الماء)",
 "飴玉": "حَلْوَى, حَلْوَى سُكَّرِيَّة",
 "飴細工": "نَمِر وَرَقِيّ (طبيعة شخص أو منظمة تبدو قوية ولكنها في الواقع عاجزة وغير فعالة)",
 "飴色": "كَهْرَمَان (عَلَك أُحْفُوْرِيّ افرزته اشجار من المخروطيات نبتت في عصور جيولوجية قديمة، وقد يقال قَهْرَمَان) / كَهْرَمَانِيّ",
 "飼い": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع) / مُتَزَايِد, مُرْتَفِع (يزداد في الكمّيّة أو القيمة) / تنشئة, رعاية (الخصائص المكتسبة نتيجة للطريقة التي عوملت بها كطفل) / ارتفاع, رفع (حدث رفع شيء ما إلى الأعلى)\nمثال: ارتفاع في درجة الحرارة بعد الظهر / أَلِيف",
 "飼いならし": "أَلِيف / رَوَّضَ, آلَفَ (رَوَّضَ المكانُ: أرَاضَ؛ رَوَّضَ فلانٌ: لَزِمَ الرِّياضَ)\nمثال: إلى أية روضة ذهبت؟",
 "飼いならす": "أَلِيف / رَوَّضَ, آلَفَ (رَوَّضَ المكانُ: أرَاضَ؛ رَوَّضَ فلانٌ: لَزِمَ الرِّياضَ)\nمثال: إلى أية روضة ذهبت؟",
 "飼いバト": "حمام مستأنس (حمام مستأنس يُربى للرياضة أو الطعام)",
 "飼い主": "مَالِك, مَالِكَة (اسم شخصي معطًى للذكور من العرب)\nمثال: من مالك هذا البيت؟",
 "飼い慣らし": "أَلِيف / رَوَّضَ, آلَفَ (رَوَّضَ المكانُ: أرَاضَ؛ رَوَّضَ فلانٌ: لَزِمَ الرِّياضَ)\nمثال: إلى أية روضة ذهبت؟",
 "飼い慣らす": "أَلِيف / رَوَّضَ, آلَفَ (رَوَّضَ المكانُ: أرَاضَ؛ رَوَّضَ فلانٌ: لَزِمَ الرِّياضَ)\nمثال: إلى أية روضة ذهبت؟",
 "飼い桶": "مذود, معلف (حاوية (عادة في الحظيرة أو الإسطبل) تتغذى منها الماشية أو الخيول)",
 "飼い葉": "عَلَف",
 "飼い葉おけ": "مذود, معلف (حاوية (عادة في الحظيرة أو الإسطبل) تتغذى منها الماشية أو الخيول)",
 "飼い葉桶": "مذود, معلف (حاوية (عادة في الحظيرة أو الإسطبل) تتغذى منها الماشية أو الخيول)",
 "飼い馴らし": "أَلِيف / رَوَّضَ, آلَفَ (رَوَّضَ المكانُ: أرَاضَ؛ رَوَّضَ فلانٌ: لَزِمَ الرِّياضَ)\nمثال: إلى أية روضة ذهبت؟",
 "飼い馴らす": "أَلِيف / رَوَّضَ, آلَفَ (رَوَّضَ المكانُ: أرَاضَ؛ رَوَّضَ فلانٌ: لَزِمَ الرِّياضَ)\nمثال: إلى أية روضة ذهبت؟",
 "飼い鳩": "حمام مستأنس (حمام مستأنس يُربى للرياضة أو الطعام)",
 "飼う": "اِحْتَفَظَ, أَبْقَى\nمثال: ナンシーは犬を飼いたがっていますか。 — أتريد نانسي اقتناء كلب.",
 "飼主": "مَالِك, مَالِكَة (اسم شخصي معطًى للذكور من العرب)\nمثال: من مالك هذا البيت؟",
 "飼料": "عَلَف",
 "飼育": "إنجاب, تكاثر (النشاط الجنسي للحمل وإنجاب النسل) / تربية (إنتاج الحيوانات أو النباتات عن طريق التزاوج أو التهجين) / مُتَكَاثِر, مُنَسِّل (يُنْتِجُ نَسْلًا أَوْ مُخَصَّص لِإِنْتَاج النَّسْل) / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "飼育員": "مُحَافِظ",
 "飼育場": "مرتع, مفقس (مكان تتكاثر فيه الحيوانات)",
 "飼葉": "عَلَف",
 "飼葉桶": "مذود, معلف (حاوية (عادة في الحظيرة أو الإسطبل) تتغذى منها الماشية أو الخيول)",
 "飼養": "إنجاب, تكاثر (النشاط الجنسي للحمل وإنجاب النسل) / تربية (إنتاج الحيوانات أو النباتات عن طريق التزاوج أو التهجين) / مُتَكَاثِر, مُنَسِّل (يُنْتِجُ نَسْلًا أَوْ مُخَصَّص لِإِنْتَاج النَّسْل) / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "飽かす": "أَمَلَّ ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل.",
 "飽かせる": "أَمَلَّ ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل.",
 "飽かぬ": "غَيْرُ مُتْعَب, لَا يَكِلّ (ذو طاقة غير منقوصة؛ لم يُصِبْهُ تعب)",
 "飽き": "إرهاق, إعياء (فقدان مؤقت للقوة والطاقة ناتج عن عمل بدني أو عقلي شاق)\nمثال: أدخل المستشفى بسبب الإعياء الشديد",
 "飽きっぽい": "مُتَقَلِّب, نَزَوِيّ (عرضة لتغيّرات مفاجئة وغير متوقّعة) / غَيْرُ مُسْتَقِرّ, مُتَقَلِّب (يَتَّسِمُ بِتَقَلُّبَاتٍ عَشْوَائِيَّةٍ فِي المَشَاعِرِ أَوِ الِارْتِبَاطَاتِ)",
 "飽きもせず": "بِإِصْرَار (مع الإصرار) / بإصرار, بشكل متواصل (بطريقة مستمرة ومصرة)\nمثال: كان يطرح أسئلة، أسئلة لا مفر منها، بإصرار",
 "飽きやすい": "مُتَقَلِّب, نَزَوِيّ (عرضة لتغيّرات مفاجئة وغير متوقّعة) / غَيْرُ مُسْتَقِرّ, مُتَقَلِّب (يَتَّسِمُ بِتَقَلُّبَاتٍ عَشْوَائِيَّةٍ فِي المَشَاعِرِ أَوِ الِارْتِبَاطَاتِ)",
 "飽き易い": "مُتَقَلِّب, نَزَوِيّ (عرضة لتغيّرات مفاجئة وغير متوقّعة) / غَيْرُ مُسْتَقِرّ, مُتَقَلِّب (يَتَّسِمُ بِتَقَلُّبَاتٍ عَشْوَائِيَّةٍ فِي المَشَاعِرِ أَوِ الِارْتِبَاطَاتِ)",
 "飽き足らない": "غَيْر مُتَحَقِّق, غَيْر مُنْجَز ((للأشخاص) يتميز بالفشل في تحقيق كامل إمكاناته)",
 "飽き足りない": "غير مُرضٍ (لا يبعث على الرضا)\nمثال: يجب أن تسترجع المتاجر البضائع غير المرضية",
 "飽くことを知らない": "شره, لا يشبع (يستحيل إشباعه أو إرضاؤه)\nمثال: شهية لا تشبع",
 "飽くなき": "شره, لا يشبع (يستحيل إشباعه أو إرضاؤه)\nمثال: شهية لا تشبع",
 "飽和": "إشباع, تشبيع (عملية النقع بالكامل بسائل) / تشبع, صفاء لوني (نقاء لوني: الخلو من التخفيف بالأبيض وبالتالي يكون حيوياً في الصبغة) / تشبع, تشرب (عملية إشباع شيء ما تماماً بمادة ما) / تشبع (حالة لا تستجيب فيها كمية ما لتأثير خارجي)\nمثال: تشريب الخشب بمادة حافظة",
 "飽和点": "نقطة التشبع ((كيمياء) المرحلة التي لن تستقبل فيها المادة المزيد من مادة أخرى في محلول أو بخار)",
 "飽和状態": "إشباع, تشبيع (عملية النقع بالكامل بسائل) / تشبع, صفاء لوني (نقاء لوني: الخلو من التخفيف بالأبيض وبالتالي يكون حيوياً في الصبغة) / تشبع, تشرب (عملية إشباع شيء ما تماماً بمادة ما) / تشبع (حالة لا تستجيب فيها كمية ما لتأثير خارجي)\nمثال: تشريب الخشب بمادة حافظة",
 "飽和脂肪酸": "حمض دهني مشبع (حمض دهني لا تستطيع سلسلة الكربون الخاصة به امتصاص أي ذرات هيدروجين أخرى؛ يوجد بشكل رئيسي في الدهون الحيوانية)",
 "飽満": "شَبَع",
 "飽足りない": "غير مُرضٍ (لا يبعث على الرضا)\nمثال: يجب أن تسترجع المتاجر البضائع غير المرضية",
 "飽食": "أُخْدُود (أخْدُودُ) / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "飾り": "زينة",
 "飾りけ": "تَصَنُّع, تَكَلُّف",
 "飾りっけ": "تَصَنُّع, تَكَلُّف",
 "飾りっ気": "تَصَنُّع, تَكَلُّف",
 "飾りつけ": "زينة",
 "飾りつける": "إِظْهَار, عَرْض / شَاشَة",
 "飾り付け": "زينة",
 "飾り付ける": "إِظْهَار, عَرْض / شَاشَة",
 "飾り書き": "جذل, فانفار ((موسيقى) لحن حيوي قصير يُعزف على الآلات النحاسية) / إشهار, تلويح (فعل التلويح) / زخرفة لفظية (عرض للكلام أو اللغة المنمقة) / حركة استعراضية (إيماءة مبهرجة)\nمثال: دخل على وقع نغمة احتفالية من الأبواق",
 "飾り棚": "خزانة عرض, فاترينة (حاوية زجاجية تستخدم لتخزين وعرض العناصر في متجر أو متحف أو منزل)",
 "飾り気": "تَصَنُّع, تَكَلُّف",
 "飾り気のない": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "飾り気の無い": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "飾り物": "حِلْيَة / تمثال مقدمة السفينة (تمثال على مقدمة بعض السفن الشراعية) / واجهة (شخص يستخدم كغطاء لنشاط مشكوك فيه)",
 "飾り石": "حجر شبه كريم (حجر كريم ذو قيمة أقل)",
 "飾り窓": "شُبَّاك, فَاتْرِينَة",
 "飾り立てる": "جَمَّلَ, زَخْرَفَ (حَسُنَ)\nمثال: يا لها من جملة!",
 "飾り羽": "رِيش, كِسْوَةُ الرِّيش (الهيكل القرني الخفيف المقاوم للماء الذي يشكل الغطاء الخارجي للطيور) / ريشة زينة (ريشة أو مجموعة ريش تلبس كحلية) / ريشة, عمود دخاني (أي شيء يشبه الريشة في الشكل أو الخفة)\nمثال: عمود من الدخان",
 "飾り羽根": "رِيش, كِسْوَةُ الرِّيش (الهيكل القرني الخفيف المقاوم للماء الذي يشكل الغطاء الخارجي للطيور) / ريشة زينة (ريشة أو مجموعة ريش تلبس كحلية) / ريشة, عمود دخاني (أي شيء يشبه الريشة في الشكل أو الخفة)\nمثال: عمود من الدخان",
 "飾る": "حِلْيَة / إِظْهَار, عَرْض / شَاشَة / دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "飾付": "زينة",
 "飾窓": "شُبَّاك, فَاتْرِينَة",
 "飾緒": "قيط, نوط الكتف (حبل أو جديلة زخرفية على كتف الزي الرسمي)",
 "餃子": "هِلَالِيُّ الشَّكْلِ, هِلَالِيّ (ذو شكل يشبه الهلال)",
 "餅": "موتْشِي",
 "餅つけ": "أَهْدَأَ, هَدَّأَ",
 "餅病": "لفحة الشاي التبثرية (مرض يصيب نباتات الشاي، يتميز بآفات تشبه البثور على الأوراق) / لفحة الصنوبر التبثرية (مرض يصيب الصنوبر الاسكتلندي)",
 "養い": "تَغْذِيَة (تَغْذِيَةُ الجِسْمِ: تَزْوِيدُهُ بِـالغِذَاءِ؛ في ركيزة أساسية للحياة، فهي تشمل جميع العمليات التي يُحصل من خلالها الكائن الحي على احتياجاته الغذائية. تُساهم هذه الاحتياجات في تشغيل الوظائف…) / غِذَاء / إِطْعَام / اِغْتِذَاء / طَعَام (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: لن نستمر في تغذية الانتقامات. / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "養い子": "طفل بالتبني (طفل يربيه آباء بالتبني)",
 "養い育てる": "بِالاِحْتِضَان, بِالكَفَالَة (يَتِمّ رِعايَتُه دونَ أَن يَكونَ ابْنًا بِيُولوجِيًّا)",
 "養い親": "عراب المعمودية (شخص يكفل شخصاً (الطفل الروحي) عند المعمودية)",
 "養う": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / تَبَنَّى / طَوَّرَ",
 "養分": "مُغَذٍّ, المُغَذِّي",
 "養女": "ابنة بالتبني (شخص يتم تربيته كابنة على الرغم من عدم وجود صلة قرابة بالولادة)",
 "養子": "زَوْج اَلاِبْنَة, صِهْر (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "養子縁組": "تَبَنٍّ (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "養子縁組み": "تَبَنٍّ (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "養成": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب.",
 "養成テープ": "شريط اخفاء, شريط ورقي لاصق (شريط لاصق يستخدم لتغطية جزء من السطح لا ينبغي طلائه)",
 "養成所": "إصلاحية, دار رعاية الأحداث (مؤسسة إصلاحية لاحتجاز وتأديب وتدريب الأحداث أو المجرمين لأول مرة) / مدرسة تدريب (مدرسة توفر تدريباً مهنياً وتقنياً عملياً)",
 "養成校": "إصلاحية, دار رعاية الأحداث (مؤسسة إصلاحية لاحتجاز وتأديب وتدريب الأحداث أو المجرمين لأول مرة) / مدرسة تدريب (مدرسة توفر تدريباً مهنياً وتقنياً عملياً)",
 "養方": "والد بالتبني (شخص يتبنى طفلاً من والدين آخرين كطفل له)",
 "養樹園": "رَوْضَة, حَضَانَة / مَشْتَلَة",
 "養殖": "استزراع مائي (تربية الحيوانات المائية أو زراعة النباتات المائية للغذاء)",
 "養殖場": "رَوْضَة, حَضَانَة / مَشْتَلَة",
 "養母": "أم بالتبني, أم حاضنة (امرأة تعمل كأم حاضنة وتربي طفل شخص آخر)",
 "養毛剤": "زيت شعر, مستحضر للشعر (مستحضر تجميلي للعناية بالشعر)",
 "養液土耕": "زراعة مائية (تقنية زراعة النباتات (بدون تربة) في ماء يحتوي على مغذيات مذابة)",
 "養液栽培": "زراعة مائية (تقنية زراعة النباتات (بدون تربة) في ماء يحتوي على مغذيات مذابة)",
 "養父": "أب بالتبني, أب حاضن (رجل هو والد حاضن)",
 "養父母": "والد بالتبني (شخص يتبنى طفلاً من والدين آخرين كطفل له)",
 "養生": "تعافي, فترة النقاهة (الشفاء التدريجي (من خلال الراحة) بعد المرض أو الإصابة) / تطبيق, طلاء (عمل وضع شيء (على سطح)) / تغطية (فعل حماية شيء ما بتغطيته) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / غِطَاء (مصنوعة تُغطّي شيئًا آخر عادةً لحمايته أو إيوائه أو إخفائه)\nمثال: وصف الطبيب وضعاً موضعياً لليود / تصلب, تصلد (عملية التحول إلى صلب أو قاسي عن طريق التبريد أو التجفيف أو التبلور)\nمثال: تصلب الخرسانة",
 "養生テープ": "شريط اخفاء, شريط ورقي لاصق (شريط لاصق يستخدم لتغطية جزء من السطح لا ينبغي طلائه)",
 "養生法": "حمية, نظام علاجي ((طب) خطة منهجية للعلاج (تشمل غالبًا النظام الغذائي))",
 "養老保険": "تأمين مختلط, تأمين وقفي (تأمين على الحياة بمبلغ محدد يُدفع للشخص المؤمن عليه عند انقضاء فترة زمنية معينة أو لمستفيد معين فور وفاة المؤمن عليه)",
 "養育": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)\nمثال: 医者は概して子供の養育の訓練を受けていない。 — الدكاترة ليسوا قاعدة اساسية في التدريب لتربية الاطفال .",
 "養蚕": "إنتاج الحرير من دودة القز",
 "養蚕家": "مربي دود القز (منتج للحرير الخام)",
 "養蜂": "تربية النحل (تربية النحل على نطاق تجاري لإنتاج العسل)",
 "養蜂場": "مَنْحَل",
 "養蜂家": "نَحَّال, عَسَّال",
 "養蜂箱": "خَلِيَّة, قَفِير",
 "養親": "والد بالتبني (شخص يتبنى طفلاً من والدين آخرين كطفل له)",
 "養護": "تَمْرِيض (تَمْرِيض: اعتنى بالمَرِيض أثناء مرضه؛ التَمْرِيض: المهنة التي يقوم أصحابها بالعناية بالمَرْضَى أثناء مرضهم) / مثال: كانت ليلى طالبة تمريض جميلة.",
 "養護ホーム": "دار رعاية, مأوى (مؤسسة يتم فيها رعاية الناس)\nمثال: دار لرعاية المسنين",
 "養護施設": "دَار الْأَيْتَام, مَيْتَم (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "養豚": "حظيرة خنازير, مزرعة خنازير (مزرعة يتم فيها تربية الخنازير أو الاحتفاظ بها)",
 "養豚場": "حظيرة خنازير, مزرعة خنازير (مزرعة يتم فيها تربية الخنازير أو الاحتفاظ بها)",
 "養鶏": "مدجنة, مزرعة دجاج (مزرعة يتم فيها تربية الدجاج للبيع)",
 "養鶏場": "مدجنة, مزرعة دجاج (مزرعة يتم فيها تربية الدجاج للبيع)",
 "餌": "أَطْعَمَ, غَذَّى / طُعْم (ذَاقَ)\nمثال: أحب طعم البطيخ.",
 "餌やり": "إِطْعَام",
 "餌付け": "تَمَلَّقَ",
 "餌袋": "قَانِصَة",
 "餌食": "فَرِيسَة / غَنِيمَة / ضَحِيَّة / أُضْحِيَّة",
 "餐": "تناول العشاء (فعل تناول وجبة العشاء)",
 "餓え": "رَغْبَة, تَعَطُّش / جَاعَ (أَصَابَهُ الجُوعُ؛ أَصَابَهُ الفَقْرُ الشَّديدُ)\nمثال: جاع الرجل العجوز حتى الموت.",
 "餓える": "تَضَوَّرَ",
 "餓え死に": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "餓死": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "餓莩": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "餓鬼": "براتوورست (سجق خنزير صغير) / طفل شقي (طفل مزعج جداً)",
 "餓鬼ども": "براتوورست (سجق خنزير صغير) / طفل شقي (طفل مزعج جداً)",
 "餓鬼共": "براتوورست (سجق خنزير صغير) / طفل شقي (طفل مزعج جداً)",
 "餘": "آخَر, أُخْرَى (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مثال: أرني مثالا آخر. / فَوْقَ / عَلَى (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "餘り": "بَقِيَّة / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / بإفراط, كثيراً جداً (أكثر مما يلزم)\nمثال: إنها تأكل كثيراً جداً / الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ.",
 "餘地": "فَرَاغ, مَكَان / فَضَاء (فَضَاء) / مَسَافَة\nمثال: الفضاء مليئ بالغموض. / فَضاء (فَضَاء) / غُرْفَة, حُجْرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الفضاء مليئ بالغموض.",
 "餝る": "حِلْيَة / إِظْهَار, عَرْض / شَاشَة / دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "餡": "تعبئة, ملء (عملية ملء شيء ما) / حشوة ((طب الأسنان) جهاز سني يتكون من أي من المواد المختلفة (مثل المعدن أو البلاستيك) يتم إدخالها في تجويف معد في السن) / لحمة (الخيط المنسوج عبر خيط السدى في النسيج) / حشوة (خليط طعام يستخدم لحشو المعجنات أو السندويشات وما إلى ذلك)\nمثال: عندما تثاءب استطعت رؤية الحشوات الذهبية في أسنانه",
 "餡こ": "تعبئة, ملء (عملية ملء شيء ما) / حشوة ((طب الأسنان) جهاز سني يتكون من أي من المواد المختلفة (مثل المعدن أو البلاستيك) يتم إدخالها في تجويف معد في السن) / لحمة (الخيط المنسوج عبر خيط السدى في النسيج) / حشوة (خليط طعام يستخدم لحشو المعجنات أو السندويشات وما إلى ذلك)\nمثال: عندما تثاءب استطعت رؤية الحشوات الذهبية في أسنانه / حشو (حشوة توضع في المراتب والوسائد والأثاث المنجد) / تتبيلة الحشو, حشوة (خليط من المكونات المتبلة يستخدم لحشو اللحوم والخضروات)",
 "餡子": "تعبئة, ملء (عملية ملء شيء ما) / حشوة ((طب الأسنان) جهاز سني يتكون من أي من المواد المختلفة (مثل المعدن أو البلاستيك) يتم إدخالها في تجويف معد في السن) / لحمة (الخيط المنسوج عبر خيط السدى في النسيج) / حشوة (خليط طعام يستخدم لحشو المعجنات أو السندويشات وما إلى ذلك)\nمثال: عندما تثاءب استطعت رؤية الحشوات الذهبية في أسنانه / حشو (حشوة توضع في المراتب والوسائد والأثاث المنجد) / تتبيلة الحشو, حشوة (خليط من المكونات المتبلة يستخدم لحشو اللحوم والخضروات)",
 "餢飳": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "館": "قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب. / نَبِيل (اَلذَّكِيُّ؛ اَلنَّجِيبُ)\nمثال: إنها امرأة نبيلة. / بِنَاء (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَبْنَى, بِنَاء (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: أنا وجدت البناء. / خَان, اِسْتِرَاحَة (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب. / قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "館主": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "館員": "إدارة الموارد البشرية, قسم شؤون الموظفين (القسم المسؤول عن تعيين وتدريب وتوزيع الموظفين ووضع سياسات إدارة الأفراد) / قوة (مجموعة من الناس مستعدة لإطاعة الأوامر)\nمثال: قوة عامة ضرورية لتوفير الأمن لحقوق المواطنين",
 "館長": "مشرف عام, ناظر (شخص يوجه ويدير منظمة) / مَسْؤُول العِمارَة, مُشْرِف المَبْنَى (حارس مبنى سكني يمثل المالك ويعمل كبواب وجامع للإيجار)",
 "饂飩": "وُونْتُون, وَانْتَان",
 "饋電線": "حيوان تسمين (حيوان يتم تسمينه أو مناسب للتسمين) / آكل, حيوان مقتات (حيوان يتغذى على مصدر معين للغذاء) / مِعْلف طيور, وحدة إطعام الطيور (جهاز خارجي يوفر الطعام للطيور البرية) / ملقم ذاتي (آلة توفر تلقائياً إمداداً من مادة ما)\nمثال: آكل اللحاء",
 "饐える": "أَفْسَدَ / دَلَّلَ, غَنَّجَ (دلل: أَدَلَّ عَلَيْهِ وتَدَلَّلَ: انْبَسَطَ؛ قالَ ابْنُ دُرَيْدٍ: أَدَلَّ عَلَيْهِ وَثِق بِمَحَبَّتِهِ فأَفْرَط عَلَيْهِ) / فَسَدَ, نَتِنَ\nمثال: دلل سامي صديقته.",
 "饑い": "جَائِع, جَوْعَان",
 "饑死": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "饑渇": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "饒舌": "ثرثرة (صفة الإطناب وكثرة الكلام)",
 "饒舌家": "ثَرْثَار",
 "饕餮": "بخل, جشع (رغبة مذمومة في التملك؛ رغبة لا تشبع في الثروة (تُشخص كإحدى الخطايا السبع المميتة)) / بخل, جشع (جشع شديد للثروة المادية) / اشتهاء, طمع (رغبة حسودة في الامتلاك)",
 "饗す": "عَالَجَ",
 "饗する": "عَالَجَ",
 "饗宴": "وَلِيمَة, مَأْدُبَة (طعام العُرْس؛ أي طعام صنع لدعوة ولجمع كبير من الناس)\nمثال: كانت الوليمة من أطيب ما ذقت. / سِمْبُوزِيُوم, نَدْوَة",
 "首": "رَقَبَة, عُنُق / رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ\nمثال: 鳥は首をひょいと水に浸した。 — الطائر غمس رأسه في الماء. / إِقَالَة / مَهَمَّة / شَيْخ, قَائِد / اَلْأَخ اَلْأَكْبَر",
 "首かせ": "مقطرة (أداة عقاب خشبية على عمود بفتحات للمعصمين والرقبة؛ كان المخالفون يُحبسون فيها ويتعرضون للسخرية العامة)",
 "首っ玉": "رَقَبَة, عُنُق",
 "首なし": "بلا رأس, مقطوع الرأس (ليس له رأس أو تشكل بدون رأس) / أَحْمَق, فَارِغُ الرَّأْس (لا يستخدم عقله أو ذكاءه)\nمثال: الفارس بلا رأس",
 "首にする": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "首ひも": "طوق, قلادة ضيقة (قلادة تلتف بإحكام حول عنق المرأة) / طوق الرقبة, ياقة (شريط يحيط بالرقبة وعادة ما يكون مطوياً) / شريط الياقة, طوق العنق (شريط حول ياقة الملابس)",
 "首をしめる": "خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته.",
 "首をすくめる": "زَغَبُ البَطّ (ريش البط الناعم)",
 "首をつる": "عَلِقَ, عِلِق / عَلَّقَ, عَلَّق / شَنَقَ, شَنَق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة.",
 "首をはねる": "ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "首を切る": "طَرَدَ, أَقَالَ / ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "首を刎ねる": "ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "首を吊る": "عَلِقَ, عِلِق / عَلَّقَ, عَلَّق / شَنَقَ, شَنَق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة.",
 "首を揃える": "اجتماع, تجمع (تجمع اجتماعي صغير غير رسمي)\nمثال: كان هناك اجتماع غير رسمي في غرفة معيشتي",
 "首を斬る": "طَرَدَ, أَقَالَ / ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "首を横に振る": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "首を竦める": "زَغَبُ البَطّ (ريش البط الناعم)",
 "首を絞める": "خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته.",
 "首を縦に振る": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "首を落とす": "ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "首上": "طوق, قلادة ضيقة (قلادة تلتف بإحكام حول عنق المرأة) / طوق الرقبة, ياقة (شريط يحيط بالرقبة وعادة ما يكون مطوياً) / شريط الياقة, طوق العنق (شريط حول ياقة الملابس)",
 "首切り": "قَطْعُ الرَّأَس (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب. / إطلاق نار (فعل إطلاق النار من بندقية) / إقالة, تسريح (إنهاء توظيف شخص ما (وتركه حراً للمغادرة)) / إشعال, إضرام (عملية إضرام النار في شيء ما) / إطلاق نار, رمي (فعل إطلاق الأسلحة أو المدفعية على عدو)\nمثال: تراجعوا في مواجهة نيران العدو الشديدة",
 "首切り役人": "جَلَّاد",
 "首切る": "ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
