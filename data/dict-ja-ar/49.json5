 "麺鉢": "زِبْدِيَّة / سُلْطَانِيَّة / زُبْدِيَّة",
 "麺類": "نُودَلْز, شَعْرِيَّة",
 "麺麭": "خُبْز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / عيش (مصدر للفعل عَاشَ؛ هو الحَيَاة) / خُبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / خبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / قرص / خَبَزَ (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب)\nمثال: هذا الخبز لذيذ.",
 "麻": "قِنَّب هِنْدِيّ / قِنَّب",
 "麻の実": "بذور القنب (بذرة نبات القنب؛ يمكن أن تؤكل نيئة أو مطحونة أو منبتة أو تحول إلى مسحوق براعم مجفف)",
 "麻呂": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "麻姑": "حكاكة ظهر (أداة حك ذات مقبض طويل لحك ظهرك) / متبادل المصالح, نفعي (شخص مستعد لتبادل الخدمات أو المعروف لتحقيق مصلحة متبادلة)",
 "麻子仁": "بذور القنب (بذرة نبات القنب؛ يمكن أن تؤكل نيئة أو مطحونة أو منبتة أو تحول إلى مسحوق براعم مجفف)",
 "麻実": "بذور القنب (بذرة نبات القنب؛ يمكن أن تؤكل نيئة أو مطحونة أو منبتة أو تحول إلى مسحوق براعم مجفف)",
 "麻屑": "مشاقة (ألياف قنب أو جوت فضفاضة يتم الحصول عليها عن طريق فك الحبال القديمة؛ عندما تُشبع بالقطران كانت تستخدم لسد الشقوق وحشو الوصلات في السفن الخشبية)",
 "麻布": "كَتَّان",
 "麻疹": "حَصْبَة\nمثال: はしかにかかると非常に危険なこともある。 — يمكن للحصبة أن تكون خطيرةً.",
 "麻痺": "شَلَل, فَالَج / فتور, لامبالاة (سمة الافتقار للحماس أو الاهتمام بالأشياء عموماً) / تنميل, خدر (فقدان جزئي أو كلي للإحساس في جزء من الجسم؛ عَرَض لتلف الأعصاب أو خلل وظيفي) / توقف, جمود (انقطاع النشاط الطبيعي) / جمود, طريق مسدود (وضع لا يمكن فيه إحراز تقدم أو لا يمكن فيه أي تقدم)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "麻種": "بذور القنب (بذرة نبات القنب؛ يمكن أن تؤكل نيئة أو مطحونة أو منبتة أو تحول إلى مسحوق براعم مجفف)",
 "麻薬": "مُخَدِّر",
 "麻薬カルテル": "عصابة مخدرات, كارتل مخدرات (كارتل غير مشروع تم تشكيله للسيطرة على إنتاج وتوزيع المخدرات)\nمثال: تقوم عصابات المخدرات أحياناً بتمويل المنظمات الإرهابية",
 "麻薬テロ": "إرهاب المخدرات (تمويل الأنشطة الإرهابية عن طريق المشاركة في تجارة المخدرات)",
 "麻薬中毒": "إدمان المخدرات (إدمان على مخدر (خاصة المخدرات الأفيونية))",
 "麻薬中毒者": "مُدْمِن, حَشَّاش",
 "麻薬取引": "اتجار بالمخدرات (الاتجار في المخدرات غير القانونية)",
 "麻薬取引き": "اتجار بالمخدرات (الاتجار في المخدرات غير القانونية)",
 "麻薬取締局": "إدارة مكافحة المخدرات (وكالة فيدرالية مسؤولة عن تطبيق القوانين واللوائح التي تحكم المخدرات والمواد الخاضعة للرقابة؛ هدفها هو شل حركة منظمات تهريب المخدرات)",
 "麻薬国家": "دولة مخدرات (منطقة استولت عليها وسيطرت عليها وأفسدتها عصابات المخدرات وحيث يكون إنفاذ القانون غير موجود فعلياً)",
 "麻薬密売": "اتجار بالمخدرات (الاتجار في المخدرات غير القانونية)",
 "麻薬密輸": "اتجار بالمخدرات (الاتجار في المخدرات غير القانونية)",
 "麻薬常習": "إدمان المخدرات (إدمان على مخدر (خاصة المخدرات الأفيونية))",
 "麻薬患者": "مُدْمِن, حَشَّاش",
 "麻薬王": "بارون مخدرات, زعيم عصابة مخدرات (شخص يسيطر على منظمة تتعامل في المخدرات غير المشروعة)",
 "麻薬組織": "عصابة مخدرات, كارتل مخدرات (كارتل غير مشروع تم تشكيله للسيطرة على إنتاج وتوزيع المخدرات)\nمثال: تقوم عصابات المخدرات أحياناً بتمويل المنظمات الإرهابية",
 "麻酔": "تخدير (فقدان الإحساس الجسدي مع أو بدون فقدان الوعي)",
 "麻酔剤": "مُخَدِّر, بَنْج",
 "麻酔医": "أخصائي تخدير, طبيب تخدير (أخصائي يقوم بإعطاء المخدر للمريض قبل العلاج)",
 "麻酔学": "علم التخدير (فرع العلوم الطبية الذي يدرس ويطبق مواد التخدير)",
 "麻酔科": "علم التخدير (فرع العلوم الطبية الذي يدرس ويطبق مواد التخدير)",
 "麻酔科医": "أخصائي تخدير, طبيب تخدير (أخصائي يقوم بإعطاء المخدر للمريض قبل العلاج)",
 "麻酔科学": "علم التخدير (فرع العلوم الطبية الذي يدرس ويطبق مواد التخدير)",
 "麻酔薬": "مُخَدِّر, بَنْج",
 "麻雀": "مَا جُونْغ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "麻黄": "إيفيدرا صينية, ماهوانغ (إيفيدرا صينية تنتج الإيفيدرين)",
 "麾下": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "麿": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "黄": "أَصْفَر (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع) / أَصْفَر, صَفْرَاء (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / اِصْفَرَّ, صَفَّرَ\nمثال: قلبي أخضر و أصفر.",
 "黄ばむ": "أَصْفَر (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع) / أَصْفَر, صَفْرَاء (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / اِصْفَرَّ, صَفَّرَ\nمثال: قلبي أخضر و أصفر.",
 "黄み": "أَصْفَر (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع) / أَصْفَر, صَفْرَاء (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / اِصْفَرَّ, صَفَّرَ\nمثال: قلبي أخضر و أصفر.",
 "黄みがかった": "أَصْفَر (بلون متوسط بين الأخضر والبرتقالي في الطيف اللوني؛ يشبه لون صفار البيض)",
 "黄人": "شَرْقِيّ",
 "黄体": "جسم أصفر (نسيج صم أصفر يتكون في جريب جراف الممزق بعد إطلاق البويضة؛ يضمر بعد بضعة أيام ما لم يبدأ الحمل)",
 "黄体ホルモン": "بروجستوجين, بروجستين (أي من مجموعة الهرمونات الستيرويدية التي لها تأثير البروجسترون)",
 "黄体形成ホルモン": "الهرمون الملوتن (هرمون موجه للغدد التناسلية تفرزه الغدة النخامية الأمامية؛ يحفز التبويض في إناث الثدييات ويحفز إطلاق الأندروجين في ذكور الثدييات)",
 "黄体期": "المرحلة الأصفرية, المرحلة الإفرازية (النصف الثاني من الدورة الشهرية بعد الإباضة؛ يفرز الجسم الأصفر البروجسترون الذي يجهز بطانة الرحم لزرع الجنين؛ إذا لم يحدث الإخصاب، يبدأ تدفق الحيض)",
 "黄信号": "ضوء أصفر (إشارة للمضي قدماً بحذر)",
 "黄化": "اصفرار, شحوب ((علم النبات) فعل جعل النبات ينمو بدون كلوروفيل عن طريق زراعته دون التعرض لأشعة الشمس) / إصفرار, شحوب (عملية الإضعاف عن طريق إعاقة نمو أو تطور شيء ما) / اصفرار, شحوب (مظهر شاحب ومريض)\nمثال: اصفرار الكرفس",
 "黄化病": "صفار, يرقان (اصفرار الجلد وبياض العينين الناتج عن تراكم صبغة الصفراء (البيليروبين) في الدم؛ يمكن أن يكون عرضاً لحصوات المرارة أو عدوى الكبد أو فقر الدم)",
 "黄口": "ساذج, غر (شاب أخرق وقليل الخبرة)",
 "黄味がかった": "أَصْفَر (بلون متوسط بين الأخضر والبرتقالي في الطيف اللوني؛ يشبه لون صفار البيض)",
 "黄土": "لوس (تراكم غير طبقي ناعم الحبيبات من الطين والغرين المترسب بفعل الرياح) / مغرة صفراء (صبغة تتكون من الليمونيت الممزوج بالطين والسيليكا) / هَادِيس",
 "黄土色": "مَغْرِيّ اللَّوْن (بلون برتقالي مصفر معتدل كلون المغرة) / أصفر ترابي, مغرة (لون أصفر برتقالي متوسط إلى برتقالي) / مغرة (أي من الأتربة المختلفة المحتوية على السيليكا والألومينا وأكسيد الحديديك؛ تستخدم كصبغة)",
 "黄塵": "غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تراب / غُبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تُراب / غبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم)\nمثال: أزل الغبار عن المرآة.",
 "黄壌": "لوس (تراكم غير طبقي ناعم الحبيبات من الطين والغرين المترسب بفعل الرياح) / هَادِيس",
 "黄変": "أَصْفَر (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع) / أَصْفَر, صَفْرَاء (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / اِصْفَرَّ, صَفَّرَ\nمثال: قلبي أخضر و أصفر.",
 "黄巴旦": "كوكاتو كبريتي العرف (كوكاتو أبيض ذو عرف أصفر قابل للانتصاب)",
 "黄帯矢毒蛙": "ذُو أَشْرِطَة صَفْرَاء (عليه أشرطة صفراء اللون)",
 "黄斑": "لطخة جلدية (رقعة من الجلد متغيرة اللون ولكنها غير مرتفعة عادة؛ تسببها أمراض مختلفة) / بقعة صفراء, لطخة (منطقة مركزية صفراء صغيرة في الشبكية غنية بالمخاريط وتتوسط الرؤية التفصيلية الواضحة) / بقعة شمسية, كلف الشمس (بقعة داكنة أكثر برودة تظهر بشكل دوري على الغلاف الضوئي للشمس؛ مرتبطة بمجال مغناطيسي قوي)",
 "黄旗": "سوسن أصفر, سوسن الماء الأصفر (سوسن أصفر الأزهار شائع في أوروبا وشمال أفريقيا، توطن في الولايات المتحدة ويزرع غالباً)",
 "黄昏": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / يَغْسِق, يَعْتِم\nمثال: هل العشاء جاهز؟ / سَوْدَاوِيَّة",
 "黄昏る": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "黄昏れる": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "黄昏時": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / يَغْسِق, يَعْتِم\nمثال: هل العشاء جاهز؟",
 "黄朽葉": "بُنِّيّ مُحْمَرّ دَاكِن (بني مع مسحة حمراء داكنة) / قماش خمري (قماش منزلي الغزل لونه بني محمر)",
 "黄枇": "بونتيديريا, عشبة البيكريل (نبات أمريكي له سنابل من الزهور الزرقاء وينمو في المياه الضحلة للجداول والبرك)",
 "黄梅": "ياسمين شتوي (شجيرة متسلقة متساقطة الأوراق تُزرع على نطاق واسع لزهورها الصفراء التي تتفتح في الشتاء)",
 "黄櫨蝋": "شمع نباتي (مادة شمعية يتم الحصول عليها من النباتات (خاصة من جذوع بعض أنواع النخيل))",
 "黄水": "صَفْرَاء (مؤنث أَصْفَر؛ صفة ما كان لونها الصفار؛ الغُدّة الصفراء: غدة في الكبد، تسمى أيضا الغدّة الصفراوية والمَرَارَة)\nمثال: هذه وردة صفراء.",
 "黄水仙": "جونكيل, نرجس مؤنث (نبات زينة يزرع على نطاق واسع موطنه جنوب أوروبا ولكنه متوطن في أماكن أخرى له أزهار عنقودية صفراء أو بيضاء عطرة) / نرجس (يستخدم غالباً بالعامية لأي نرجس أصفر)",
 "黄水晶": "سيترين (كوارتز أصفر شبه كريم يشبه التوباز)",
 "黄沙": "لوس (تراكم غير طبقي ناعم الحبيبات من الطين والغرين المترسب بفعل الرياح) / صَحْرَاء (الصَّحْرَاءُ : الفَضاءُ الواسِعُ لا نباتَ به، نادرة الماء مرتفعة درجات الحرارة ولا حياة فيها؛ الصَّحْرَاءُ : الأرضُ المُسْتَوِيةُ في لِينٍ وغِلَظٍ دُونَ القُفِّ) / صحرة / صحرا / بَرّ (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد) / فَرَّ / جَزاء\nمثال: عاد إلى الصحراء.",
 "黄河": "اَلنَّهْر اَلْأَصْفَر, خْوَانْغْخِي",
 "黄泉": "هَادِيس",
 "黄泉の国": "هَادِيس",
 "黄泉国": "هَادِيس",
 "黄泉路": "هَادِيس",
 "黄海": "الْبَحْر الْأَصْفَر",
 "黄熱": "حَمَّى صَفْرَاء (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "黄熱病": "حَمَّى صَفْرَاء (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "黄玉": "تُوبَاز",
 "黄玉石": "تُوبَاز",
 "黄疸": "صُفَار, يَرَقَان",
 "黄癬": "سففة, قرعة (عدوى فطرية معدية في فروة الرأس؛ تحدث بشكل رئيسي في أفريقيا والشرق الأوسط)",
 "黄白": "رَشْوَة / رشوة",
 "黄白色": "أَبْيَض مُصْفَرّ (أبيض مع مسحة صفراء)",
 "黄皮木": "بونتيديريا, عشبة البيكريل (نبات أمريكي له سنابل من الزهور الزرقاء وينمو في المياه الضحلة للجداول والبرك)",
 "黄砂": "لوس (تراكم غير طبقي ناعم الحبيبات من الطين والغرين المترسب بفعل الرياح) / صَحْرَاء (الصَّحْرَاءُ : الفَضاءُ الواسِعُ لا نباتَ به، نادرة الماء مرتفعة درجات الحرارة ولا حياة فيها؛ الصَّحْرَاءُ : الأرضُ المُسْتَوِيةُ في لِينٍ وغِلَظٍ دُونَ القُفِّ) / صحرة / صحرا / بَرّ (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد) / فَرَّ / جَزاء\nمثال: عاد إلى الصحراء.",
 "黄碧玉": "بيريل (المصدر الرئيسي للبريليوم؛ تُثَمّن أصنافه الشفافة الملونة كأحجار كريمة)",
 "黄禍": "الخطر الأصفر (التهديد للحضارة الغربية الذي يُقال إنه ينشأ من قوة الشعوب الآسيوية)",
 "黄禍論": "الخطر الأصفر (التهديد للحضارة الغربية الذي يُقال إنه ينشأ من قوة الشعوب الآسيوية)",
 "黄粱": "دخن إيطالي, دخن ذيل الثعلب (عشب حولي خشن مقاوم للجفاف يزرع للحبوب والتبن والعلف في أوروبا وآسيا وبشكل رئيسي للعلف والتبن في الولايات المتحدة)",
 "黄素馨": "ياسمين أصفر, ياسمين كارولينا (كرمة خشبية سامة دائمة الخضرة في جنوب شرق الولايات المتحدة لها أزهار صفراء قمعية الشكل وعطرة)",
 "黄経": "خط طول سماوي, مطلع مستقيم ((علم الفلك) الإحداثي الاستوائي الذي يحدد الزاوية، مقاسة شرقاً على طول خط الاستواء السماوي، من الاعتدال الربيعي إلى تقاطع دائرة الساعة التي تمر عبر…)\nمثال: ساعة واحدة من المطلع المستقيم تساوي خمس عشرة درجة",
 "黄緑": "أخضر ليموني, أخضر مصفر (درجة من الأخضر مشوبة بالأصفر)",
 "黄緑色": "أَخْضَر مُصْفَرّ (بلون متوسط بين الأصفر والأخضر)",
 "黄緯": "خط عرض سماوي, ميل ((علم الفلك) المسافة الزاوية لجرم سماوي شمال أو جنوب خط الاستواء السماوي؛ يعبر عنها بالدرجات؛ وتستخدم مع المطلع المستقيم لتحديد المواقع على الكرة…)",
 "黄肌": "تونة صفراء الزعانف (قد تصل إلى 400 رطل؛ توجد عالمياً في المناطق الاستوائية)",
 "黄肌鮪": "تونة صفراء الزعانف (قد تصل إلى 400 رطل؛ توجد عالمياً في المناطق الاستوائية)",
 "黄色": "أَصْفَر (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع) / أَصْفَر, صَفْرَاء (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / اِصْفَرَّ, صَفَّرَ\nمثال: قلبي أخضر و أصفر.",
 "黄色い": "أَصْفَر (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع) / أَصْفَر, صَفْرَاء (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / اِصْفَرَّ, صَفَّرَ\nمثال: قلبي أخضر و أصفر. / حاد, عالي النبرة (تستخدم للأصوات والأصوات البشرية؛ عالية في النغمة أو التردد) / شَدِيد المَيْل (مضبوط بزاوية حادَّة أو عالية)",
 "黄色がかった": "أَصْفَر (بلون متوسط بين الأخضر والبرتقالي في الطيف اللوني؛ يشبه لون صفار البيض)",
 "黄色っぽい": "أَصْفَر (بلون متوسط بين الأخضر والبرتقالي في الطيف اللوني؛ يشبه لون صفار البيض)",
 "黄色みがかった": "أَصْفَر (بلون متوسط بين الأخضر والبرتقالي في الطيف اللوني؛ يشبه لون صفار البيض)",
 "黄色人種": "العرق الأصفر, العرق المغولي (عرق آسيوي)",
 "黄色味がかった": "أَصْفَر (بلون متوسط بين الأخضر والبرتقالي في الطيف اللوني؛ يشبه لون صفار البيض)",
 "黄色組合": "نقابة تابعة للشركة (نقابة للعمال لشركة واحدة؛ نقابة غير تابعة لنقابة أكبر)",
 "黄色腫": "ورم أصفر (مشكلة جلدية تتميز بتطور عقيدات صفراء غير منتظمة)",
 "黄色雀蜂": "دبور أصفر, سترة صفراء (دبور اجتماعي صغير معلم بالأصفر يعشش عادة في الأرض)",
 "黄花": "أُقْحُوَان",
 "黄花清白": "صَارُوخ, قَذِيفَة (سهم له ساق من قصب و في أحد طرفيه أنبوبة صغيرة من المقوى تحشى بارودا و لها فتيل من فتحتها السفلى فإذا أُشعل الفتيل و احتُرق ما في مُؤخرتها من بارود…؛ سلاح حربي، و رُبما استُخدم في أمور غير حربية، وهو كناية على اسطوانة ضخمة مخروطية الشكل، ذات جناحين صغيرين يثبتانها في خط مجراها…)\nمثال: هبط الصاروخ بدون مشاكل.",
 "黄花蘿蔔": "صَارُوخ, قَذِيفَة (سهم له ساق من قصب و في أحد طرفيه أنبوبة صغيرة من المقوى تحشى بارودا و لها فتيل من فتحتها السفلى فإذا أُشعل الفتيل و احتُرق ما في مُؤخرتها من بارود…؛ سلاح حربي، و رُبما استُخدم في أمور غير حربية، وهو كناية على اسطوانة ضخمة مخروطية الشكل، ذات جناحين صغيرين يثبتانها في خط مجراها…)\nمثال: هبط الصاروخ بدون مشاكل.",
 "黄菖蒲": "سوسن أصفر, سوسن الماء الأصفر (سوسن أصفر الأزهار شائع في أوروبا وشمال أفريقيا، توطن في الولايات المتحدة ويزرع غالباً)",
 "黄葉": "قَيْقَب / لَحْم الْأَيِّل (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "黄蓮": "خيط الذهب, كوبتيس (نبات معمر منخفض النمو في غابات أمريكا الشمالية له أوراق ثلاثية وساق جذري أصفر وأزهار بيضاء)",
 "黄血塩": "فيروسيانيد البوتاسيوم (مركب سيانيد يتم تحضيره بتفاعل سيانيد البوتاسيوم مع أملاح الحديدوز؛ يستخدم عادة من قبل البستانيين)",
 "黄褐色": "بني مصفر, كراميل (لون أسمر متوسط إلى داكن)",
 "黄身": "صفار البيض, مح (الجزء الكروي الأصفر من البيضة الذي يحيط به الزلال)\nمثال: 私の娘は卵の黄身が好きです。 — ابنتي تحب صفار البيض.",
 "黄連": "خيط الذهب, كوبتيس (نبات معمر منخفض النمو في غابات أمريكا الشمالية له أوراق ثلاثية وساق جذري أصفر وأزهار بيضاء)",
 "黄連雀": "جناح الشمع البوهيمي (جناح شمع كبير من شمال أمريكا الشمالية؛ يشبه جناح الشمع العادي ولكنه أكبر)",
 "黄道": "مَسَارُ الشَّمْسِ (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة.",
 "黄道光": "اَلْفَجْر اَلْكَاذِب",
 "黄道帯": "أَبْرَاجُ السَّمَاء",
 "黄金": "ذَهَب, إِبْرِيز (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبِي\nمثال: ذهب إلى الدكان. / ذَهَبِيّ / نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال.",
 "黄金の山": "منجم ذهب (منجم يُعثر فيه على خام الذهب) / منجم ذهب (مصدر جيد لشيء مرغوب فيه)",
 "黄金世界": "طُوبَائِيَّة, مَدِينَةٌ فَاضِلَة",
 "黄金分割": "النِّسْبَة الذَّهَبِيَّة (العلاقة التناسبية بين قسمين من خط أو بُعدين لشكل مستوٍ بحيث تكون النسبة بين القصير والطويل كالنسبة بين الطويل ومجموعهما)",
 "黄金国": "إلدورادو (مكان خيالي للثروة العظيمة والفرص؛ بحث عنه المستكشفون في القرن السادس عشر في أمريكا الجنوبية)",
 "黄金律": "القاعدة الذهبية (أمر يستند إلى كلمات يسوع في الموعظة على الجبل) / قَاعِدَة ذَهَبِيَّة (أي قاعدة مهمة وأساسية)\nمثال: فكل ما تريدون أن يفعل الناس بكم افعلوا هكذا أنتم أيضاً بهم",
 "黄金時代": "عَصْر ذَهَبِيّ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "黄金期": "عَصْر ذَهَبِيّ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "黄金比": "الرَقْم الذَهَبِيّ",
 "黄金率": "الرَقْم الذَهَبِيّ",
 "黄金色": "ذَهَبِيّ",
 "黄金虫": "جعران (أي من الأنواع العديدة من الخنافس ممتلئة الجسم ذات رؤوس بقرون قرنية)",
 "黄金術": "اَلْخِيمِيَاء, خِيمِيَاء",
 "黄金郷": "إلدورادو (مكان خيالي للثروة العظيمة والفرص؛ بحث عنه المستكشفون في القرن السادس عشر في أمريكا الجنوبية)",
 "黄鉄鉱": "بايرايت الحديد, بايريت (معدن شائع (ثنائي كبريتيد الحديد) لونه أصفر شاحب)",
 "黄鉛": "أصفر الكروم (أي من الأصباغ الصفراء المتعددة التي تتكون من كرومات الرصاص العادية ومركبات الرصاص الأخرى)",
 "黄鉛鉱": "ولفينيت (معدن أصفر إلى برتقالي أو بني يستخدم كخام للموليبدينوم)",
 "黄銅": "شَبَه / صُفْر (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / صُفَّر (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
 "黄銅鉱": "بايريت النحاس, كالكوبيريت",
 "黄錫鉱": "بايريت القصدير, ستانيت (معدن رمادي غامق بلمعان معدني يعد مصدراً للقصدير)",
 "黄雀": "عصفور الشجر (عصفور شائع في الشتاء في شمال الولايات المتحدة) / عصفور الشجر (عصفور أوراسي أصغر من عصفور الدوري)",
 "黄鶏": "بُنِّيّ مُحْمَرّ (بني مع مسحة حمراء)",
 "黄麻": "جوت",
 "黄麻布": "خيش (قماش الجوت الخشن)",
 "黍": "دَخْن (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن) / ملَة, مل\nمثال: دخن زيري سيجارة.",
 "黎元": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "黎族": "وَاحِد وَخَمْسُونَ (يَدُلُّ عَلَى العَدَد 51) / لي (مقياس مسافة صيني؛ حوالي 0.5 كيلومتر) / ليثيوم (عنصر فضي أبيض ناعم أحادي التكافؤ من مجموعة الفلزات القلوية؛ أخف معدن معروف)",
 "黎明": "فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور)\nمثال: فجر توم البالونة. / فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "黎明期": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "黎民": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "黏稠": "لَزِج",
 "黐": "دبق (مادة لاصقة لزجة تدهن على الأغصان الصغيرة لاصطياد الطيور الصغيرة)",
 "黒": "أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / أَسْوَد (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / زِنْجِيّ, زَنْجِيّ / أَسْوَد, أسود (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن)\nمثال: لديه قميص أسود. / ذَنْب, خِطْء (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / نَدَم\nمثال: عذر أقبح من ذنب.",
 "黒い": "أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / أَسْوَد (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / زِنْجِيّ, زَنْجِيّ / أَسْوَد, أسود (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن)\nمثال: لديه قميص أسود. / غَامِق, دَاكِن / مُريب, مَشبوه / أَسْوَد حَالِك, أَسْوَد فَاحِم (بأشد درجات السواد؛ كلون الفحم الحجري أو القار) / مُسَخَّم, مُغَطًّى بِالسُّخَام (مُغطّى بالسُّخام أو ما يشبهه)",
 "黒いんげん豆": "فاصولياء سوداء (فاصولياء سوداء البذور من أمريكا الجنوبية؛ عادة ما تكون مجففة)",
 "黒くする": "سَوَّدَ / اِسْوَدَّ",
 "黒こげ": "شار",
 "黒こしょう": "فِلْفِل أَسْوَد (حَبّ حريف يوضع في الطعام أو يطحن يستخدم كتابل. يكون منه أسود أو أبيض، حرارته متوسطة؛ فُلْفُل حَارّ: نبات ثمره حريف لونه أخضر وقد يحمرّ شديد الحرارة. يؤكل كما هو أو يجفف ويطحن ويستخدم كتابل)\nمثال: نحب الفلفل الحار.",
 "黒すぐり": "كِشْمِش أَسْوَد, عِنَب الثَّعْلَب",
 "黒ずみ": "بُثُور سَوْدَاء, رُؤُوس سَوْدَاء / تسويد, تعتيم (التغيير إلى لون أغمق)",
 "黒ずむ": "سَوَّدَ / اِسْوَدَّ",
 "黒っぽい": "غَامِق, دَاكِن",
 "黒ばむ": "سَوَّدَ / اِسْوَدَّ",
 "黒ひょう": "نَمِر أَسْوَد (عضو في حزب الفهود السود السياسي)",
 "黒ぶち": "بقعة سوداء (أي من العديد من الأمراض الفطرية للنباتات التي تنتج بقعاً سوداء صغيرة على النبات)",
 "黒まる": "سَوَّدَ / اِسْوَدَّ",
 "黒みがかった": "مَائِل لِلسَّوَاد (مائل إلى السواد قليلاً)",
 "黒む": "سَوَّدَ / اِسْوَدَّ",
 "黒める": "سَوَّدَ / اِسْوَدَّ",
 "黒らか": "سَوَاد",
 "黒んぼ": "شخص أسود (شخص ذو بشرة داكنة ينحدر من أفريقيا (أو كان أسلافه من أفريقيا)) / أدب مكشوف, إباحية (نشاط إبداعي (كتابة أو صور أو أفلام وغيرها) ليس له قيمة أدبية أو فنية سوى إثارة الرغبة الجنسية) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة) / تفحم, فطر التفحم (أي فطر من رتبة أوستيلاجيناليس) / تفحم (أمراض مدمرة للنباتات (خاصة الحبوب) تسببها فطريات تنتج كتل مسحوقية سوداء من الجراثيم) / عامل مسرح (موظف في المسرح يؤدي الأعمال المتعلقة بإقامة عرض مسرحي)",
 "黒ん坊": "شخص أسود (شخص ذو بشرة داكنة ينحدر من أفريقيا (أو كان أسلافه من أفريقيا)) / أدب مكشوف, إباحية (نشاط إبداعي (كتابة أو صور أو أفلام وغيرها) ليس له قيمة أدبية أو فنية سوى إثارة الرغبة الجنسية) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة) / تفحم, فطر التفحم (أي فطر من رتبة أوستيلاجيناليس) / تفحم (أمراض مدمرة للنباتات (خاصة الحبوب) تسببها فطريات تنتج كتل مسحوقية سوداء من الجراثيم) / عامل مسرح (موظف في المسرح يؤدي الأعمال المتعلقة بإقامة عرض مسرحي)",
 "黒インゲン豆": "فاصولياء سوداء (فاصولياء سوداء البذور من أمريكا الجنوبية؛ عادة ما تكون مجففة)",
 "黒コショウ": "فِلْفِل أَسْوَد (حَبّ حريف يوضع في الطعام أو يطحن يستخدم كتابل. يكون منه أسود أو أبيض، حرارته متوسطة؛ فُلْفُل حَارّ: نبات ثمره حريف لونه أخضر وقد يحمرّ شديد الحرارة. يؤكل كما هو أو يجفف ويطحن ويستخدم كتابل)\nمثال: نحب الفلفل الحار.",
 "黒シャツ": "صاحب القميص الأسود (عضو في الحزب الفاشي الإيطالي قبل الحرب العالمية الثانية)",
 "黒シャツ党": "صاحب القميص الأسود (عضو في الحزب الفاشي الإيطالي قبل الحرب العالمية الثانية)",
 "黒シャツ隊": "صاحب القميص الأسود (عضو في الحزب الفاشي الإيطالي قبل الحرب العالمية الثانية)",
 "黒スグリ": "كِشْمِش أَسْوَد, عِنَب الثَّعْلَب",
 "黒ダイヤ": "ألماس أسود, كربونادو (ألماس داكن أقل جودة يستخدم صناعياً للحفر والتلميع)",
 "黒ネコ": "القطة السوداء",
 "黒パン": "خُبْز أَسْمَر (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب)\nمثال: هذا الخبز لذيذ.",
 "黒ヒョウ": "نَمِر أَسْوَد (عضو في حزب الفهود السود السياسي)",
 "黒ビール": "بَادِن, مُمْتَلِئ الجِسْم (تَعْبِيرات مُلَطَّفَة لِلدَّلَالَة عَلَى البَدَانَة) / صَلْبٌ, وَفِيٌّ (يُعتمد عليه ولا يتراجع) / صُلْب, قَوِيُّ البُنْيَة (ذو قوة بدنية متينة؛ متمرّس على التعب والمشقّة) / بدين, ممتلئ (مقاس ملابس لشخص كبير أو ثقيل الوزن)",
 "黒丸": "بقعة سوداء (أي من العديد من الأمراض الفطرية للنباتات التي تنتج بقعاً سوداء صغيرة على النبات)",
 "黒人": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير. / بائعة هوى / شخص أسود (شخص ذو بشرة داكنة ينحدر من أفريقيا (أو كان أسلافه من أفريقيا)) / بائعة هوى",
 "黒人参": "جزر بري, دانتيل الملكة آن (عشب أوراسي مستوطن على نطاق واسع بأوراق مقطعة بدقة وخيمات مركبة بيضاء من الزهور الصغيرة البيضاء أو الصفراء وجذور صفراء رفيعة)",
 "黒人歴史月間": "أمريكي إفريقي, أمريكية إفريقية",
 "黒人英語": "إيبونيكس, الإنجليزية الأمريكية الأفريقية (شكل غير قياسي من الإنجليزية الأمريكية يتحدث به بشكل مميز الأمريكيون من أصل أفريقي في الولايات المتحدة)",
 "黒人霊歌": "أغنية روحية, سبيرتشوال (نوع من الأغاني الدينية نشأ عن السود في جنوب الولايات المتحدة)",
 "黒体": "جِسْم أَسْوَد (جسم افتراضي قادر على امتصاص كل الإشعاع الكهرومغناطيسي الساقط عليه)\nمثال: الجسم الأسود المحافظ على درجة حرارة ثابتة هو مشع كامل عند تلك الدرجة لأن الإشعاع الواصل إليه والمغادر له يجب أن يكون في توازن",
 "黒体放射": "إشعاع الجسم الأسود (الإشعاع الكهرومغناطيسي الذي يشع من جسم أسود مثالي؛ يعتمد توزيع الطاقة في الطيف المشع للجسم الأسود فقط على درجة الحرارة ويحدده قانون بلانك للإشعاع)",
 "黒体輻射": "إشعاع الجسم الأسود (الإشعاع الكهرومغناطيسي الذي يشع من جسم أسود مثالي؛ يعتمد توزيع الطاقة في الطيف المشع للجسم الأسود فقط على درجة الحرارة ويحدده قانون بلانك للإشعاع)",
 "黒内障": "كُمْنَة",
 "黒円": "بقعة سوداء (أي من العديد من الأمراض الفطرية للنباتات التي تنتج بقعاً سوداء صغيرة على النبات)",
 "黒化": "تسويد, تعتيم (التغيير إلى لون أغمق)",
 "黒呪術": "سِحْر أَسْوَد (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية)\nمثال: هذا هو سحر الجزائر.",
 "黒味がかった": "مَائِل لِلسَّوَاد (مائل إلى السواد قليلاً)",
 "黒塗": "مُسْوَدّ ((للوجه) أسود خاصة من احتقان الدم) / مُدَخَّن, مُسْوَدّ (أصبح داكنًا بفعل الدخان)",
 "黒塗り": "مُسْوَدّ ((للوجه) أسود خاصة من احتقان الدم) / مُدَخَّن, مُسْوَدّ (أصبح داكنًا بفعل الدخان)",
 "黒塗りメイク": "مكياج الوجه الأسود (المكياج (عادة من الفلين المحروق) الذي يستخدمه المؤدي لتقليد ذوي البشرة السوداء)",
 "黒壇": "آبَنُوس",
 "黒変": "تسويد, تعتيم (التغيير إلى لون أغمق)",
 "黒太刀梭子魚": "ماكريل الثعبان (أسماك استوائية مفترسة ذات فكوك بارزة وأسنان قوية)",
 "黒太刀梭魚": "ماكريل الثعبان (أسماك استوائية مفترسة ذات فكوك بارزة وأسنان قوية)",
 "黒太刀魣": "ماكريل الثعبان (أسماك استوائية مفترسة ذات فكوك بارزة وأسنان قوية)",
 "黒太刀魳": "ماكريل الثعبان (أسماك استوائية مفترسة ذات فكوك بارزة وأسنان قوية)",
 "黒奴": "شخص أسود (شخص ذو بشرة داكنة ينحدر من أفريقيا (أو كان أسلافه من أفريقيا))",
 "黒子": "عامل مسرح (موظف في المسرح يؤدي الأعمال المتعلقة بإقامة عرض مسرحي) / خَلْفَ الكَوَالِيس, سِرِّيّ (مُصَمَّمٌ وَمُنَفَّذٌ بِسِرِّيَّةٍ أَوْ بِشَكْلٍ سِرِّيّ) / نمش (بقعة بنية صغيرة (من صبغة الميلانين) على الجلد)",
 "黒字": "أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / أَسْوَد (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / زِنْجِيّ, زَنْجِيّ / أَسْوَد, أسود (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن)\nمثال: لديه قميص أسود. / حروف سوداء, قوطي (نمط خط ثقيل استخدم من القرن الخامس عشر إلى الثامن عشر)",
 "黒字転換": "ارتداد, انعكاس (التحول في الاتجاه المعاكس) / تجهيز للرحلة العودة, وقت الدوران (عمل أو عملية تفريغ وتحميل وخدمة سفينة أو طائرة لرحلة العودة) / منطقة دوران (منطقة كبيرة بما يكفي لتدور المركبة فيها) / انقلاب, تراجع (قرار بعكس قرار سابق)",
 "黒山": "كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم) / قُدَّاس\nمثال: السحابة هي كتلة بخار في السماء.",
 "黒帯": "حِزَام أَسْوَد (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر)\nمثال: هذا حزام من الجلد.",
 "黒幕": "عبقري, فذ (شخص لديه قدرة فكرية استثنائية وأصالة في التفكير) / العقل المدبر, مُبْتَكِر (شخص يبتكر أو ينشئ أشياء جديدة)\nمثال: كان موزارت طفلاً عبقرياً",
 "黒影": "خَيَال, سَوَاد (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "黒慈姑": "كستناء الماء, كستناء الماء الصينية (سعد صيني ينتج درنات صالحة للأكل على شكل بصيلة)",
 "黒房すぐり": "كِشْمِش أَسْوَد, عِنَب الثَّعْلَب",
 "黒揚羽": "بَرْق, ترتر (زينة تتكون من قطعة صغيرة من مادة لامعة تُستخدم لتزيين الملابس)",
 "黒揚羽蝶": "بَرْق, ترتر (زينة تتكون من قطعة صغيرة من مادة لامعة تُستخدم لتزيين الملابس)",
 "黒文字": "عُود تَخْلِيل أَسْنَان, خِلَال (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "黒斑": "بقعة سوداء (أي من العديد من الأمراض الفطرية للنباتات التي تنتج بقعاً سوداء صغيرة على النبات)",
 "黒星": "بقعة سوداء (أي من العديد من الأمراض الفطرية للنباتات التي تنتج بقعاً سوداء صغيرة على النبات) / خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة",
 "黒暗": "ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما يشع ليُرَى)\nمثال: لدي خوف من الظلام.",
 "黒曜岩": "سَبَج",
 "黒曜石": "سَبَج",
 "黒松": "صنوبر أسود (صنوبر خشب كبير ثنائي الإبر من جنوب شرق أوروبا) / صنوبر أسود, صنوبر جيفري (صنوبر متناظر طويل من غرب أمريكا الشمالية له إبر زرقاء خضراء طويلة في حزم من 3 ومخاريط ممدودة على فروع منتشرة متدلية نوعاً ما؛ يصنف أحياناً كصنف من…) / صنوبر أسود ياباني (نبات زينة ياباني كبير له إبر طويلة في حزم من 2؛ يزرع على نطاق واسع في الولايات المتحدة لمقاومته للملح والضباب الدخاني) / صنوبر أسود, ميرو (صنوبرية نيوزيلندية تستخدم للأخشاب؛ يستخدم الخشب الداكن للنجارة الداخلية)",
 "黒板": "سَبُّورَة, لَوْح",
 "黒板拭き": "طلاّسة, ممحاة السبورة (ممحاة تزيل علامات الطباشير من السبورة)",
 "黒板消し": "طلاّسة, ممحاة السبورة (ممحاة تزيل علامات الطباشير من السبورة)",
 "黒樫": "بلوط أسود, بلوط أصفر (شجرة أخشاب متساقطة الأوراق متوسطة إلى كبيرة من شرق الولايات المتحدة وجنوب شرق كندا لها لحاء خارجي داكن ولحاء داخلي أصفر يستخدم للدباغة؛ الأوراق…)",
 "黒橿": "بلوط أسود, بلوط أصفر (شجرة أخشاب متساقطة الأوراق متوسطة إلى كبيرة من شرق الولايات المتحدة وجنوب شرق كندا لها لحاء خارجي داكن ولحاء داخلي أصفر يستخدم للدباغة؛ الأوراق…)",
 "黒檀": "آبَنُوس",
 "黒歌鳥": "شُحْرُور",
 "黒死病": "طَاعُون",
 "黒毛": "دَاكِن الشَّعْر (ذو شعر بلون داكن)",
 "黒水引": "أَبْيَض وَأَسْوَد (ليس لديه أو غير قادر على إنتاج الألوان) / أَبْيَض وَأَسْوَد, حَدِّيّ ((يوصف به الموقف) منقسم بحدة إلى فئتين متعارضتين لا وسط بينهما) / أبيض وأسود (يفتقر إلى تدرجات الألوان أو الظلال الرمادية؛ جزء منه أبيض وجزء أسود)\nمثال: فيلم أبيض وأسود",
 "黒水引き": "أَبْيَض وَأَسْوَد (ليس لديه أو غير قادر على إنتاج الألوان) / أَبْيَض وَأَسْوَد, حَدِّيّ ((يوصف به الموقف) منقسم بحدة إلى فئتين متعارضتين لا وسط بينهما) / أبيض وأسود (يفتقر إلى تدرجات الألوان أو الظلال الرمادية؛ جزء منه أبيض وجزء أسود)\nمثال: فيلم أبيض وأسود",
 "黒水晶": "خوذة موريون (خوذة معدنية كان يرتديها الجنود العاديون في القرن السادس عشر)",
 "黒水熱": "حمى البول الأسود (ملاريا شديدة وغالباً مميتة تتميز بتلف الكلى مما يؤدي إلى بول داكن)",
 "黒海": "الْبَحْر الْأَسْوَد, بَحْرُ نِيطَش",
 "黒漆": "أبنوسي, أسود حالك (أسود داكن جداً)",
 "黒潮": "تيار اليابان, تيار كوروشيو (تيار محيطي دافئ يتدفق باتجاه الشمال الشرقي قبالة ساحل اليابان إلى شمال المحيط الهادئ)",
 "黒潮大蛇行": "تيار اليابان, تيار كوروشيو (تيار محيطي دافئ يتدفق باتجاه الشمال الشرقي قبالة ساحل اليابان إلى شمال المحيط الهادئ)",
 "黒炭": "فحم بتوميني, فحم قاري (فحم غني بالهيدروكربونات القطرانية؛ يحترق بسهولة بلهب أصفر مدخن)",
 "黒点": "بقعة سوداء (أي من العديد من الأمراض الفطرية للنباتات التي تنتج بقعاً سوداء صغيرة على النبات) / بقعة شمسية, كلف الشمس (بقعة داكنة أكثر برودة تظهر بشكل دوري على الغلاف الضوئي للشمس؛ مرتبطة بمجال مغناطيسي قوي)",
 "黒焦げ": "شار",
 "黒焼": "شار",
 "黒焼き": "شار",
 "黒焼け": "شار",
 "黒熊": "دب أسود أمريكي (دب بني إلى أسود من أمريكا الشمالية؛ أصغر وأقل شراسة من الدب البني) / دب أسود آسيوي (دب ذو معطف أسود يعيش في وسط وشرق آسيا)",
 "黒熱病": "داء الليشمانيات (تقرحات ناتجة عن عدوى استوائية بطفيليات من جنس الليشمانيا) / كالا أزار, ليشمانيا حشوية (ليشمانيا تصيب الأحشاء)",
 "黒犀": "وحيد القرن الأسود",
 "黒猩々": "شِمْبَانْزِي",
 "黒猩猩": "شِمْبَانْزِي",
 "黒猫": "القطة السوداء",
 "黒玉": "تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ / مُحَرِّك نَفَّاث (اسم فاعل من حَرَّكَ؛ اسم آلة) / دفق (دَفَقَ: صَبَّهُ، وَهُوَ ماءٌ دافِقٌ، دَفَقَ اللهُ رُوحَه أَي: أَماتَهُ، ودَفَقَ الكُوزَ: بَدَّدَ مَا فِيه بمَرَّةِ)\nمثال: المحرك لا يعمل.",
 "黒白": "صورة أبيض وأسود, صورة أحادية اللون (صورة فوتوغرافية أو شريحة بالأبيض والأسود) / تَوَاصُل كِتَابِيّ, لُغَة مَكْتُوبَة (التواصل بوساطة رموز مكتوبة، سواء أكانت مطبوعة أم مخطوطة)",
 "黒皮症": "تصبغ, قتام (حالة تتميز برواسب غير طبيعية من الميلانين)",
 "黒盗賊鴎": "كركر طفيلي, كركر قطبي (نوع من الكركر)",
 "黒目豆": "لُوبِيَاء, لُوبِيَا",
 "黒眼鏡": "نَظَّارَة شَمْسِيَّة, نَظَّارَة شَمْس",
 "黒石": "أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / أَسْوَد (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / زِنْجِيّ, زَنْجِيّ / أَسْوَد, أسود (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن)\nمثال: لديه قميص أسود.",
 "黒砂糖": "سكر بني (سكر غير مكرر أو مكرر جزئياً فقط)",
 "黒種子草": "حب في الضباب, حبة البركة الدمشقية (نبات حديقة أوروبي ذو أوراق مقطوعة بدقة وزهور بيضاء أو زرقاء شاحبة) / ثلج في الصيف (عشبة الطيور ذات أوراق رمادية فضية مشعرة وأزهار بيضاء كبيرة نوعاً ما) / حب في الضباب, ليمون الماء البري (زهرة العاطفة الاستوائية الأمريكية ذات قنابات مقسمة بدقة؛ السيقان كريهة الرائحة عند سحقها)",
 "黒種草": "حب في الضباب, حبة البركة الدمشقية (نبات حديقة أوروبي ذو أوراق مقطوعة بدقة وزهور بيضاء أو زرقاء شاحبة) / ثلج في الصيف (عشبة الطيور ذات أوراق رمادية فضية مشعرة وأزهار بيضاء كبيرة نوعاً ما) / حب في الضباب, ليمون الماء البري (زهرة العاطفة الاستوائية الأمريكية ذات قنابات مقسمة بدقة؛ السيقان كريهة الرائحة عند سحقها)",
 "黒穂": "أدب مكشوف, إباحية (نشاط إبداعي (كتابة أو صور أو أفلام وغيرها) ليس له قيمة أدبية أو فنية سوى إثارة الرغبة الجنسية) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة) / تفحم, فطر التفحم (أي فطر من رتبة أوستيلاجيناليس) / تفحم (أمراض مدمرة للنباتات (خاصة الحبوب) تسببها فطريات تنتج كتل مسحوقية سوداء من الجراثيم)",
 "黒穂病": "أدب مكشوف, إباحية (نشاط إبداعي (كتابة أو صور أو أفلام وغيرها) ليس له قيمة أدبية أو فنية سوى إثارة الرغبة الجنسية) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة) / تفحم, فطر التفحم (أي فطر من رتبة أوستيلاجيناليس) / تفحم (أمراض مدمرة للنباتات (خاصة الحبوب) تسببها فطريات تنتج كتل مسحوقية سوداء من الجراثيم)",
 "黒穂菌": "تفحم, فطر التفحم (أي فطر من رتبة أوستيلاجيناليس)",
 "黒竹": "خيزران أسود (خيزران صغير له سيقان خضراء رقيقة تتحول إلى اللون الأسود اللامع)",
 "黒米": "أرز أسمر, أرز بني (أرز غير مصقول يحتفظ بالطبقة الخارجية ذات اللون البني المصفر)",
 "黒糖": "سكر بني (سكر غير مكرر أو مكرر جزئياً فقط)",
 "黒翳": "خَيَال, سَوَاد (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "黒胡椒": "فِلْفِل أَسْوَد (حَبّ حريف يوضع في الطعام أو يطحن يستخدم كتابل. يكون منه أسود أو أبيض، حرارته متوسطة؛ فُلْفُل حَارّ: نبات ثمره حريف لونه أخضر وقد يحمرّ شديد الحرارة. يؤكل كما هو أو يجفف ويطحن ويستخدم كتابل)\nمثال: نحب الفلفل الحار.",
 "黒色": "أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / أَسْوَد (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / زِنْجِيّ, زَنْجِيّ / أَسْوَد, أسود (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن)\nمثال: لديه قميص أسود.",
 "黒色人種": "العرق الأسود, زنوج (عرق ذو بشرة داكنة)",
 "黒色火薬": "بارود أسود (شكل بسيط من البارود، يتكون من خليط من نترات البوتاسيوم والفحم والكبريت؛ اختُرع في القرن التاسع في الصين)\nمثال: يُعزى انتشار البارود الأسود عبر آسيا من الصين على نطاق واسع إلى المغول",
 "黒色腫": "ميلانوما, ورم ميلانيني (أي من الأورام الخبيثة المتعددة (عادة في الجلد) التي تتكون من الخلايا الصبغية (الميلانينية))",
 "黒色表皮腫": "شواك أسود (مرض جلدي يتميز ببقع داكنة تشبه الثآليل في ثنايا الجسم)",
 "黒芥子": "خردل أسود (نبات حولي أوراسي واسع الانتشار يزرع لبذوره النفاذة؛ مصدر رئيسي لخردل المائدة)",
 "黒茶": "بني قهوة, بني محروق (لون بني متوسط إلى بني داكن)",
 "黒茶色": "بني قهوة, بني محروق (لون بني متوسط إلى بني داكن)",
 "黒葦毛": "رمادي فولاذي (رمادي داكن يميل قليلاً للأرجواني أو الأزرق)",
 "黒藻": "هيدريلا (نبات مغمور بأوراق رمحية محيطية وأزهار إبطية منعزلة؛ نبات من العالم القديم استوطن في جنوب الولايات المتحدة ويسد الممرات المائية في فلوريدا)",
 "黒虫": "دودة الرمل (ديدان بحرية لها صف من الخياشيم المعنقدة على طول كل جانب من الظهر؛ تستخدم غالباً كطعم للصيد)",
 "黒蛇": "ثعبان أسود, متسابق أسود (ثعبان متسابق مسود من شرق الولايات المتحدة ينمو حتى ستة أقدام) / ثعبان أسود, ثعبان الجرذ الأسود (ثعبان أسود لامع كبير غير سام من أمريكا الشمالية)",
 "黒蠅": "ذبابة الزجاجة (ذبابة كبيرة عادة ما تكون مشعرة ذات لون أزرق أو أخضر معدني؛ تضع البيض في الجيف أو الروث أو الجروح)",
 "黒衣": "عامل مسرح (موظف في المسرح يؤدي الأعمال المتعلقة بإقامة عرض مسرحي) / خَلْفَ الكَوَالِيس, سِرِّيّ (مُصَمَّمٌ وَمُنَفَّذٌ بِسِرِّيَّةٍ أَوْ بِشَكْلٍ سِرِّيّ)",
 "黒豆の木": "عنب المستنقعات (شجيرة دائمة الخضرة بأوراق جلدية)",
 "黒豆木": "عنب المستنقعات (شجيرة دائمة الخضرة بأوراق جلدية)",
 "黒豹": "نَمِر أَسْوَد (عضو في حزب الفهود السود السياسي)",
 "黒貂": "سَمُّور",
 "黒質": "مَادَّة سَوْدَاء (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "黒足信天翁": "قطرس أسود الرجلين (نوع من القطرس ذو أقدام سوداء)",
 "黒足鼬": "نمس أسود الأقدام (ثديي من العرسيات في مناطق البراري بالولايات المتحدة؛ مهدد بالانقراض تقريباً)",
 "黒金": "حَدِيد (مَعْدِن صَلْب قَوِيّ يستخرج من الأرض له ألوان تتراوح بين الرَمَاديّ والأسْوَد) / حَدِيدِيّ / كَوَى\nمثال: حملت الحديد فلم أجد أثقل من الدين.",
 "黒金剛石": "ألماس أسود, كربونادو (ألماس داكن أقل جودة يستخدم صناعياً للحفر والتلميع)",
 "黒鉛": "غَرَافِيت",
 "黒闇": "ظَلَام, ظُلْمَة (مصدر للفعل ظَلِمَ بمعنى ذهب نوره؛ ضد النُور، هو ذهاب النور والضوء فلا يوجد ما يشع ليُرَى)\nمثال: لدي خوف من الظلام.",
 "黒隠元豆": "فاصولياء سوداء (فاصولياء سوداء البذور من أمريكا الجنوبية؛ عادة ما تكون مجففة)",
 "黒雁": "إوز أسود, برنت (إوز داكن صغير يتكاثر في الشمال ويهاجر جنوباً)",
 "黒雲母": "بيوتيت (ميكا بنية داكنة إلى سوداء توجد في الصخور النارية والمتحولة)",
 "黒雷鳥": "طيهوج أسود (طيهوج يكون الذكر فيه أسود مزرق)",
 "黒電気石": "شورل (تورمالين أسود)",
 "黒駁": "بقعة سوداء (أي من العديد من الأمراض الفطرية للنباتات التي تنتج بقعاً سوداء صغيرة على النبات)",
 "黒魔法": "سِحْر أَسْوَد (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية)\nمثال: هذا هو سحر الجزائر.",
 "黒魔術": "سِحْر أَسْوَد (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية)\nمثال: هذا هو سحر الجزائر.",
 "黒鳥": "تَمّ أَسْوَد",
 "黒鳳蝶": "بَرْق, ترتر (زينة تتكون من قطعة صغيرة من مادة لامعة تُستخدم لتزيين الملابس)",
 "黒鴨": "بط أسود شائع (نوع من البط الأسود)",
 "黒麦": "سُلْت, شَيْلَم",
 "黔首": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "黔黎": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "黙々": "صَامِت, سَاكِت",
 "黙す": "صَمَتَ, سَكَتَ / إِهْمال",
 "黙する": "صَمَتَ, سَكَتَ",
 "黙り": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "黙る": "صَمَتَ, سَكَتَ",
 "黙劇": "بانتوميم, تمثيل صامت (أداء يستخدم الإيماءات وحركات الجسم بدون كلمات)",
 "黙坊": "أبكم, صامت (شخص لا يتكلم)",
 "黙従": "إذعان, قبول (الموافقة على بيان أو اقتراح للقيام بشيء ما) / إذعان, رضوخ (القبول دون احتجاج)\nمثال: أبدى موافقته بحماس",
 "黙想": "تأمل, مضاربة فكرية (تأمل مستمر وعميق في موضوع أو سلسلة من الموضوعات ذات طبيعة عميقة أو غامضة) / تأمل روحي ((دين) التأمل في الأمور الروحية (عادة في مواضيع دينية أو فلسفية))\nمثال: عادة التأمل هي الأساس لكل معرفة حقيقية",
 "黙殺": "تَجَاهَلَ, طَنَّش",
 "黙然": "بدون كلام, بصمت (بدون التحدث)\nمثال: جلس بصمت بجوارها",
 "黙示": "اِنْطَوَى / وَحْي, تَنْزِيل (الإعلام في الخفاء، وهذا أصل الكلمة؛ الإلهام، سواء كان غريزيّ أو فطريّ أو فنيّ أو غيره وسواء كان من الله أو من غيره)\nمثال: يا رسول الله، كيف يأتيك الوحي ؟",
 "黙示的": "ضِمْنِيّ, مُطْلَق (بلا شكّ أو تحفُّظ) / ضمني, مفهوم ضمناً (مفهوم ضمناً وإن لم يتم التعبير عنه مباشرة؛ متأصل في طبيعة الشيء)\nمثال: اتفاق ضمني بعدم إثارة الموضوع",
 "黙示録": "وَحْي, تَنْزِيل (الإعلام في الخفاء، وهذا أصل الكلمة؛ الإلهام، سواء كان غريزيّ أو فطريّ أو فنيّ أو غيره وسواء كان من الله أو من غيره)\nمثال: يا رسول الله، كيف يأتيك الوحي ؟",
 "黙約": "تَخَلُّف, تَغَيُّب (خسارة بسبب عدم الحضور) / خيار افتراضي (خيار يتم تحديده تلقائياً ما لم يتم تحديد بديل) / تخلف عن الدفع, عدم السداد (خسارة ناتجة عن عدم سداد دين) / تخلف عن السداد, تعثر (فعل الفشل في الوفاء بالتزام مالي)\nمثال: خسر المباراة بالتغيب",
 "黙考": "تَفَكُّر",
 "黙許": "تواطؤ, غض الطرف ((قانون) موافقة ضمنية على مخالفات شخص ما)",
 "黙認": "تواطؤ, غض الطرف ((قانون) موافقة ضمنية على مخالفات شخص ما) / تآمر, تواطؤ (الاتفاق على مؤامرة سرية)",
 "黙諾": "تواطؤ, غض الطرف ((قانون) موافقة ضمنية على مخالفات شخص ما)",
 "黙黙": "صَامِت, سَاكِت",
 "黛": "قلم حواجب (مكياج يوفره قلم تجميلي يستخدم لتغميق الحواجب)",
 "黝い": "أَسْوَد مُزْرَقّ (أسود مع مسحة زرقاء)",
 "黝輝石": "سبودومين (معدن بيروكسين يتكون من سيليكات الليثيوم والألمنيوم؛ مصدر لليثيوم)",
 "點穴": "نقطة ضغط (منطقة على الجلد حساسة للغاية للضغط) / نقطة ضغط (حيث يحتمل حدوث مشاكل أو صعوبات) / نقطة ضغط (أي من عدة نقاط في الجسم حيث يمكن الشعور بالنبض وحيث يؤدي الضغط على شريان تحتي إلى السيطرة على النزيف من ذلك الشريان في نقطة أبعد)\nمثال: يجب أن تعرف نقاط الضغط لكي تمارس شياتسو",
 "黥": "وَشْم / وَشَمَ, وَشَّمَ",
 "黯然": "غَامِق, دَاكِن / أَسِيف, حَزِين (مليء بالحزن أو يثيره)",
 "黴": "قَالِب / سَنَّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين) / تَعَفُّن, عُفُونَة\nمثال: هم في نفس السن.",
 "黴臭い": "رَاكِد, عَفِن (ذُو رَائِحَةٍ عَتِيقَةٍ وَغَيْرِ نَظِيفَةٍ) / مُتَعَفِّن, مُكَلَّف (مُغَطًّى بِالعَفَن أَوْ ذُو رَائِحَة عَفَن) / عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "黴菌": "جُرْثُومَة / خَشَاش, هَامَّة",
 "黽勉": "صِنَاعَة (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "黿": "سلحفاة خضراء (سلحفاة استوائية كبيرة ذات لحم مخضر يُستخدم في حساء السلاحف)",
 "鼈": "سلحفاة لينة الصدفة (سلحفاة مائية شرهة ذات صدفة مرنة مسطحة مغطاة بجلد جلدي؛ يمكن أن تسبب عضات مؤلمة) / مضخة الآسن (مضخة لإزالة مياه الآسن (المياه المتجمعة في قاع السفينة))",
 "鼈甲": "قط ذبل, قط كاليكو (قط ذو علامات سوداء وكريمية وصفراء) / فراشة صدفة السلحفاة (زاهية الألوان؛ تتغذى اليرقات على نبات القراص) / ذبل, صدفة السلحفاة (المادة القرنية المبقعة لصدفة بعض السلاحف)",
 "鼈甲色": "كَهْرَمَان (عَلَك أُحْفُوْرِيّ افرزته اشجار من المخروطيات نبتت في عصور جيولوجية قديمة، وقد يقال قَهْرَمَان) / كَهْرَمَانِيّ",
 "鼈甲飴": "مُلَبَّسَة",
 "鼈茸": "فطر القرن النتن الشائع (فطر شائع كان يستخدم سابقاً في تحضير مرهم للروماتيزم)",
 "鼎": "ثُلَاثِيّ الأَرْجُل (لَهُ ثَلاث أَرْجُل أَوْ ما يُشْبِهُها)",
 "鼎立": "ثُلَاثِيّ (يشمل مجموعة أو ثلاثة أطراف) / ثُلَاثِيُّ الأَرْكَانِ (ذو ثلاثة أركان أو زوايا)",
 "鼎立戦": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "鼓": "سَاعَاتِيّ الشَّكْل (على شكل ساعة رمليّة) / طَبْل (الضَرْب على الطَبْل؛ آلة موسيقية تشبه الإسطوانة المغطاة فتحتها بالجلد تستخدم بأن يضرب وجهها إما باليد أو بعصا) / طَبْلَة",
 "鼓す": "نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته.",
 "鼓する": "نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته.",
 "鼓動": "نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته.",
 "鼓吹": "إثارة, إيقاظ (فعل الإثارة أو الاستنهاض) / حَمَاسِيّ, مُحَفِّز (يحثّ على النشاط أو يُصَعِّد الفعل كأنّه يَحْفِز ويَدْفَع) / حَمَاسِيّ, مُلْهِم (قادر على إثارة الحماس أو الإثارة)\nمثال: الهدف من الفن هو إثارة العواطف / محاماة / تَأْييد / مُنَاصَرَة",
 "鼓吹者": "محامي, محامية / ناطق بلسان, لسان حال / أوصى ب / حامى, رافع",
 "鼓室": "أذن وسطى, تجويف طبلي (التجويف الرئيسي للأذن؛ بين طبلة الأذن والأذن الداخلية)",
 "鼓手": "طبال (شخص يعزف على الطبل)",
 "鼓手長": "عصوي, قائد فرقة استعراضية (قائد فرقة موسيقية استعراضية أو فرقة طبول)",
 "鼓脹": "نَفْخ, نَفْخَة (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة)\nمثال: يداك أوكتا وفوك نفخ",
 "鼓腸": "نَفْخ, نَفْخَة (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة)\nمثال: يداك أوكتا وفوك نفخ",
 "鼓腹": "سَعَادَة, فَرَح",
 "鼓膜": "طَبْلَة اَلْأُذْن",
 "鼓膜炎": "التهاب الأذن الداخلية, التهاب الطبلة (التهاب الأذن الداخلية)",
 "鼓舞": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "鼓舞激励": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "鼕々": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / استعجال, اندفاع (فعل التحرك بعجلة وبطريقة غير مبالية) / اندفاع, هجوم ((كرة القدم الأمريكية) محاولة لتقديم الكرة عن طريق الركض في الخط)\nمثال: في عجلته للمغادرة نسي كتابه",
 "鼕鼕": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / استعجال, اندفاع (فعل التحرك بعجلة وبطريقة غير مبالية) / اندفاع, هجوم ((كرة القدم الأمريكية) محاولة لتقديم الكرة عن طريق الركض في الخط)\nمثال: في عجلته للمغادرة نسي كتابه",
 "鼠": "فَأْرَة, فَأْر",
 "鼠カンガルー": "كنغر جرذي (أي من عدة كنغر أسترالي يشبه الجرذ بحجم الأرنب)",
 "鼠チフス菌": "سالمونيلا تيفيموريوم (شكل من أشكال السالمونيلا يسبب التسمم الغذائي لدى البشر)",
 "鼠坊": "سمكة التنين الصغيرة (أسماك بحرية صغيرة غالباً ما تكون زاهية الألوان وعديمة القشور تعيش في القاع؛ توجد في المياه الاستوائية والمعتدلة الدافئة في أوروبا وأمريكا)",
 "鼠径": "أُرْبِيَّة, مَغْبَن",
 "鼠径ヘルニア": "فتق إربي (فتق تدخل فيه حلقة من الأمعاء القناة الإربية؛ وهو النوع الأكثر شيوعاً من الفتق عند الذكور)",
 "鼠径リンパ肉芽腫": "ورم حبيبي لمفي منقول جنسيا (مرض معد تسببه فصيلة من بكتيريا الكلاميديا؛ ينتقل عن طريق الاتصال الجنسي؛ يتميز بآفات تناسلية وتورم الغدد اللمفاوية في الفخذ)",
 "鼠径管": "قناة أربية (ممر مائل عبر جدار البطن السفلي؛ في الذكور هو الممر الذي تنزل عبره الخصيتان إلى كيس الصفن ويحتوي على الحبل المنوي؛ وفي الإناث ينقل الرباط المستدير…)",
 "鼠径部": "أُرْبِيَّة, مَغْبَن",
 "鼠族": "قَارِض, قَوَارِض",
 "鼠毒": "حمى عضة الجرذ, سودوكو (شكل من أشكال حمى عضة الجرذ يحدث في الشرق الأقصى)",
 "鼠毛": "أَسْمَر رَمَادِيّ (بلون بني رمادي باهت إلى رمادي مائل للبني) / حصان أشهب (حصان ذو لون رمادي بني باهت) / أشهب, بني رمادي (لون أو صبغة تتراوح حول لون بني رمادي فاتح)\nمثال: ارتدت لوناً أشهب",
 "鼠海豚": "خنزير البحر المينائي (خنزير البحر الشائع في شمال المحيط الأطلسي والمحيط الهادئ)",
 "鼠疫": "طَاعُون",
 "鼠穴": "جحر, غرفة قذرة (غرفة صغيرة قذرة وغير مريحة) / جحر جرذ (حفرة (كما في جدار مبنى) صنعتها الجرذان)",
 "鼠算": "مُتَتَالِيَة هَنْدَسِيَّة / تكاثر, توالد (النمو عن طريق التضاعف السريع للأجزاء) / انتشار, تكاثر (زيادة سريعة في العدد (خاصة الزيادة السريعة في عدد الأسلحة الفتاكة))\nمثال: انتشار الأسلحة النووية",
 "鼠算式": "مُتَتَالِيَة هَنْدَسِيَّة",
 "鼠花火": "دولاب نار, عجلة كاثرين (لعبة نارية دائرية تدور حول نفسها وتطلق نيرانًا ملونة)",
 "鼠落し": "مصيدة جرذان (فخ لصيد الجرذان) / مسكن متهالك (سكن قذر متداعي) / مصيدة, ورطة شائكة (وضع صعب ومعقد)",
 "鼠賊": "لص متسلل (لص يسرق دون استخدام العنف)",
 "鼠蹊": "أُرْبِيَّة, مَغْبَن",
 "鼠蹊リンパ肉芽腫": "ورم حبيبي لمفي منقول جنسيا (مرض معد تسببه فصيلة من بكتيريا الكلاميديا؛ ينتقل عن طريق الاتصال الجنسي؛ يتميز بآفات تناسلية وتورم الغدد اللمفاوية في الفخذ)",
 "鼠蹊管": "قناة أربية (ممر مائل عبر جدار البطن السفلي؛ في الذكور هو الممر الذي تنزل عبره الخصيتان إلى كيس الصفن ويحتوي على الحبل المنوي؛ وفي الإناث ينقل الرباط المستدير…)",
 "鼠蹊部": "أُرْبِيَّة, مَغْبَن",
 "鼠輩": "صغير, طفل (شخص صغير السن من أي من الجنسين) / إمّعة, تافه (شخص صغير وغير مهم)\nمثال: هي تكتب كتباً للأطفال",
 "鼠鮫": "قرش السلمون",
 "鼠鹿": "طرغولية",
 "鼠黐": "تمرحنة يابانية (شجيرة دائمة الخضرة من اليابان وكوريا لها أوراق داكنة صغيرة وزهور في عناقيد فضفاضة؛ مرتبطة بالتمرحنة الصينية ولكنها أصغر)",
 "鼬": "اِبْن عِرْس, عِرْسَة (الولد الذكر)\nمثال: هو له ابن صغير. / عرسيات, فصيلة العرسيات (ثدييات آكلة للحوم ذات فراء وأقدام مشقوقة)",
 "鼬穴熊": "غرير النمس (غرير صغير يشبه النمس من جنوب شرق آسيا)",
 "鼬萩": "نيلة كاذبة, نيلة كاليفورنية (شجيرة مشعرة قائمة إلى منتشرة من ساحل المحيط الهادئ للولايات المتحدة لها عناقيد من الزهور الحمراء إلى النيلية) / نيلة شجيرية, نيلة كاذبة (شجيرة كثيفة على ضفاف الأنهار الرطبة والسهول الفيضية في شرق الولايات المتحدة لها أوراق عطرة جذابة وعناقيد كثيفة من الزهور الأرجوانية الداكنة) / نيلة برية, نيلة كاذبة",
 "鼬鮫": "قرش النمر, قرش ببري (قرش كبير خطير يعيش في المياه الدافئة ذو جسم مخطط أو مرقط)",
 "鼯鼠": "بوسوم طائر, سنجاب طائر (بوسوم ليلي يتحرك بقفزات انزلاقية باستخدام طيات جلدية تشبه المظلة على طول جانبي الجسم)",
 "鼴鼠": "خَال, شَامَة (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث) / طَوْبِين, طُوبِين / مُول\nمثال: عندي ابنا خالة.",
 "鼹鼠": "خَال, شَامَة (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث) / طَوْبِين, طُوبِين / مُول\nمثال: عندي ابنا خالة.",
 "鼻": "أَنْف, خَشَم (أنف:اشْتَكَى أَنفه فَهُوَ مأنوف؛ أنف الشَّيْء: حدد طرفه)\nمثال: أنت لديك أنف كبير.",
 "鼻かぜ": "زكام الرأس (زكام شائع يصيب الممرات الأنفية ويؤدي إلى احتقان وعطس وصداع)",
 "鼻がたかい": "فَخُور",
 "鼻が高い": "فَخُور",
 "鼻くそ": "مُخَاط, مُخَاط أَنْف",
 "鼻たれ": "مُخَنْفِر (شخص يتنفس بصوت مسموع من خلال أنف محتقن) / ساذج, غر (شاب أخرق وقليل الخبرة)",
 "鼻っぱし": "عدوانية, ولع بالقتال (ميل طبيعي للعداء) / إقدام, هجومية (صفة كون المرء جريئاً ومبادراً) / عدوانية (شعور بالعداء يثير أفكار الهجوم)",
 "鼻っぱしが強い": "بَرَاغْمَاتِيّ, عَمَلِيّ (يسترشد بالخبرة العملية والملاحظة لا بالنظرية)",
 "鼻っぱしら": "عدوانية, ولع بالقتال (ميل طبيعي للعداء) / إقدام, هجومية (صفة كون المرء جريئاً ومبادراً) / عدوانية (شعور بالعداء يثير أفكار الهجوم)",
 "鼻っぱり": "عدوانية, ولع بالقتال (ميل طبيعي للعداء) / إقدام, هجومية (صفة كون المرء جريئاً ومبادراً) / عدوانية (شعور بالعداء يثير أفكار الهجوم)",
 "鼻っ張り": "عدوانية, ولع بالقتال (ميل طبيعي للعداء) / إقدام, هجومية (صفة كون المرء جريئاً ومبادراً) / عدوانية (شعور بالعداء يثير أفكار الهجوم)",
 "鼻っ柱": "عدوانية, ولع بالقتال (ميل طبيعي للعداء) / إقدام, هجومية (صفة كون المرء جريئاً ومبادراً) / عدوانية (شعور بالعداء يثير أفكار الهجوم)",
 "鼻っ柱が強い": "بَرَاغْمَاتِيّ, عَمَلِيّ (يسترشد بالخبرة العملية والملاحظة لا بالنظرية)",
 "鼻っ柱の強い": "بَرَاغْمَاتِيّ, عَمَلِيّ (يسترشد بالخبرة العملية والملاحظة لا بالنظرية)",
 "鼻っ面": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة",
 "鼻つまみ": "إِزْعَاج",
 "鼻づら": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة",
 "鼻であしらう": "ازدراء, تجاهل (رفض التعرف على شخص تعرفه) / أَفْطَس, قَصِير بِشَكْل غَيْر عَادِيّ (قَصير بِشَكْل غَيْر اعتِيادِيّ) / رفض, زجر (حالة من الإبعاد أو الصد)\nمثال: كان التجاهل متعمداً بوضوح",
 "鼻にかかった": "أَنْفِي",
 "鼻につく": "نَتُنَ, نَتِنَ",
 "鼻に付く": "نَتُنَ, نَتِنَ",
 "鼻に掛かった": "أَنْفِي",
 "鼻のたかい": "فَخُور",
 "鼻の下": "نَثْرَة / فَم, بق",
 "鼻の差": "نهاية متقاربة جداً, نهاية مصورة (بشكل عام، أي نهاية متقاربة جداً؛ وتحديداً، نهاية سباق يكون فيه المتسابقون قريبين جداً من بعضهم البعض بحيث يجب تحديد الفائز من صورة التقطت لحظة النهاية)",
 "鼻の穴": "مَنْخَر",
