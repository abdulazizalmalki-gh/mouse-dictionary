 "賃貸料金": "أُجْرَة, اِسْتَأْجَر / اِسْتَأْجَرَ / أجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: ركبت سيارة أجرة.",
 "賃金": "جزاء, عاقبة (تعويض عن أعمال جديرة بالتقدير أو عقاب على مخالفات)\nمثال: أجرة الخطيئة هي الموت",
 "賃金凍結": "تجميد الأجور (تجميد الأجور عند مستوى معين)",
 "賃金労働者": "كاسب, متكسب (شخص يكسب أجراً مقابل عمله)",
 "賃金率": "معدل الأجر (مبلغ المال المستلم لكل وحدة زمنية)\nمثال: معدل أجور النساء أقل من الرجال",
 "賃銭": "جزاء, عاقبة (تعويض عن أعمال جديرة بالتقدير أو عقاب على مخالفات)\nمثال: أجرة الخطيئة هي الموت",
 "賄": "رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا. / قُرْبَان",
 "賄い": "ركوب, صعود (فعل صعود الركاب والطاقم على متن سفينة أو طائرة) / ألواح خشبية, كسوة خشبية (هيكل من الألواح) / لَوْحَة, خَشَبَة / لَوْحَة, لَوْح / مَجْلِس, لَجْنَة / اِسْتَقَلَّ, صَعِدَ / طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر.",
 "賄い方": "طَاهٍ, طَاهِي",
 "賄う": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تَوْرِيد, تَزْوِيد / ذَخِيرَة",
 "賄方": "طَاهٍ, طَاهِي",
 "賄賂": "رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "賄賂罪": "رَشْوَة / رشوة",
 "資": "أموال, موارد مالية (أصول في شكل مال) / مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / شَخْصِيَّة / خُلْق (أَنْشَأَ، أَوْجَدَ) / حَرْف, رَمْز (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / مِحْرَف\nمثال: زيري سيء الخلق.",
 "資す": "سَاهَمَ / تَمْوِيل, مَالِيَّة / مَوَّل",
 "資する": "سَاهَمَ / تَمْوِيل, مَالِيَّة / مَوَّل",
 "資力": "طريقة, واسطة (امتلاك القدرة على إنتاج تأثير معين أو تحقيق غاية) / أَدَاة, وَسِيلَة (مصنوعة تُستخدَم وسيلة لإنجاز غاية ما) / ثراء, سعة (رأس مال كبير (ثروة أو دخل))\nمثال: وسيلة للسيطرة",
 "資料": "مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "資料館": "مَتْحَف (مكان تُجمع وتُعْرَض فيه الآثار التاريخيَّة أو الفنيَّة أو العِلْميَّة وغيرها)\nمثال: عاد إلى المتحف.",
 "資本": "أموال, موارد مالية (أصول في شكل مال)",
 "資本コスト": "تكلفة رأس المال (تكلفة الفرصة البديلة للأموال المستخدمة نتيجة لقرار استثماري؛ معدل العائد الذي يمكن أن تكسبه الشركة إذا اختارت استثماراً آخر بمخاطر معادلة)",
 "資本主": "مُسْتَثْمِر, مُسْتَثْمِرَة",
 "資本主義": "رَأْسْمَالِيَّة (الرَّسُمالبَّة : نظامٌ اقتصاديّ تكون فيه وسائل الانتاج مُلْكً لأَصحاب ِ الأَموال المُوَظَّفة؛ مجْموعُ الرَّأْسماايِّين أو البلدان الرَّأْسماليَّة)\nمثال: 共産主義が崩壊したことにより、今や資本主義が「世界を支配」しようとしているという非難を浴びている。 — بعد سقوط الشيوعية, الرأسماليون متهمون في محاولة \"السيطرة على العالم\".",
 "資本主義的": "رَأْسُمَالِيّ (يفضل أو يمارس الرأسمالية) / رأسمالي (من أو يتعلق بالرأسمالية أو الرأسماليين)",
 "資本主義者": "رَأْسُمَالِيّ (يفضل أو يمارس الرأسمالية) / رأسمالي (من أو يتعلق بالرأسمالية أو الرأسماليين) / رأسمالي (شخص يستثمر رأس المال في مشروع تجاري (خاصة المشاريع الكبيرة)) / رأسمالي (مدافع محافظ عن الرأسمالية)\nمثال: أمة رأسمالية",
 "資本利得": "أرباح رأسمالية, مكاسب رأسمالية (المبلغ الذي يتجاوز به سعر بيع الأصل سعر الشراء؛ يتحقق الربح عند بيع الأصل)",
 "資本利得税": "ضريبة الأرباح الرأسمالية (ضريبة تفرض على الأرباح الرأسمالية)\nمثال: لقد تجنب ضريبة الأرباح الرأسمالية عن طريق البيع على المكشوف",
 "資本勘定": "حساب رأس المال ((في المالية) حساب لصافي قيمة شركة في تاريخ محدد) / حساب رأس المال ((في الاقتصاد) ذلك الجزء من ميزان المدفوعات الذي يسجل تدفق الأوراق المالية من وإلى الدولة)",
 "資本収支": "حساب رأس المال ((في المالية) حساب لصافي قيمة شركة في تاريخ محدد) / حساب رأس المال ((في الاقتصاد) ذلك الجزء من ميزان المدفوعات الذي يسجل تدفق الأوراق المالية من وإلى الدولة)",
 "資本家": "رَأْسُمَالِيّ (يفضل أو يمارس الرأسمالية) / رأسمالي (من أو يتعلق بالرأسمالية أو الرأسماليين) / رأسمالي (شخص يستثمر رأس المال في مشروع تجاري (خاصة المشاريع الكبيرة)) / رأسمالي (مدافع محافظ عن الرأسمالية)\nمثال: أمة رأسمالية",
 "資本市場": "سُوق رَأْس الْمَال (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "資本損失": "خسارة رأسمالية (المبلغ الذي يتجاوز به سعر شراء الأصل سعر البيع؛ تتحقق الخسارة عند بيع الأصل)",
 "資本金": "رأس مال الأسهم (القيمة الدفترية للأسهم القائمة لشركة ما) / أسهم مصرح بها, رأس المال المصرح به (الحد الأقصى لعدد الأسهم المصرح بها بموجب شروط عقد تأسيس الشركة)",
 "資材": "مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "資格": "مُؤَهِّل",
 "資格がない": "غير مؤهل, غير مختص قانونياً (غير مؤهل أو غير كافٍ قانونياً) / بِلَا حَقّ, غَيْرُ مُسْتَحِقّ (لا يملك حقاً أو استحقاقاً) / غير مؤهل (غير مستوف للمعايير والمتطلبات والتدريب المناسب) / غير مشروط, مطلق (غير محدود أو مقيد)\nمثال: تعتبر الزوجة عادة غير مؤهلة للشهادة ضد زوجها",
 "資格のない": "غير مؤهل, غير مختص قانونياً (غير مؤهل أو غير كافٍ قانونياً) / بِلَا حَقّ, غَيْرُ مُسْتَحِقّ (لا يملك حقاً أو استحقاقاً) / غير مؤهل (غير مستوف للمعايير والمتطلبات والتدريب المناسب) / غير مشروط, مطلق (غير محدود أو مقيد)\nمثال: تعتبر الزوجة عادة غير مؤهلة للشهادة ضد زوجها",
 "資源": "مَوْرِد",
 "資産": "مُلْك, مَال (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / خَاصَّة / خَاصِّيَّة\nمثال: زيري ملك لنفسه.",
 "資産売却益": "أرباح رأسمالية, مكاسب رأسمالية (المبلغ الذي يتجاوز به سعر بيع الأصل سعر الشراء؛ يتحقق الربح عند بيع الأصل)",
 "資産家": "ثري, غني (شخص يمتلك ثروة مادية كبيرة)",
 "資産担保証券": "أكريلونتريل بوتادين ستايرين, بلاستيك إيه بي إس (فئة من البلاستيك المركب تستخدم لصنع هياكل السيارات وحافظات الحواسيب والأجهزة الأخرى)",
 "資産税": "ضريبة الأراضي, ضريبة الأملاك (ضريبة رأسمالية تفرضها البلديات على الممتلكات؛ وتعتمد على القيمة المقدرة للعقار)",
 "資産負債表": "بَيَان مَالِيّ (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل)\nمثال: وأوضح البيان ذاته، أن الوزارة وجهت تعليمات من أجل تسخير كافة الإمكانيات البشرية والمادية للتسريع من وتيرة سير العملية.",
 "資益": "مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري.",
 "資財": "مُلْك, مَال (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / خَاصَّة / خَاصِّيَّة\nمثال: زيري ملك لنفسه.",
 "資質": "طَبِيعَة, طبيعة",
 "資金": "أموال, موارد مالية (أصول في شكل مال)",
