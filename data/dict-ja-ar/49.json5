 "訣辞": "وَدَاع / فِرَاق, وَدَاع / وَدَاعًا (تقال للمسافر؛ تقال قبل الانصراف. (تعميم))\nمثال: قال زيري وداعا.",
 "訥々": "مُتَعَثِّر, مُتَلَعْثِم (مُتَقَطِّع أَوْ مُتَرَدِّد بِسَبَب الانْفِعَال) / أَعْرَج, مُقْعَد (مُصَابٌ بِعَجْزٍ فِي القَدَمَيْنِ أَوِ السَّاقَيْنِ)",
 "訥訥": "مُتَعَثِّر, مُتَلَعْثِم (مُتَقَطِّع أَوْ مُتَرَدِّد بِسَبَب الانْفِعَال) / أَعْرَج, مُقْعَد (مُصَابٌ بِعَجْزٍ فِي القَدَمَيْنِ أَوِ السَّاقَيْنِ)",
 "訪い": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "訪う": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا. / لَاحَقَ / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع)\nمثال: اتبع قلبك فحسب. / شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شَكّ, شُبْهَة ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شُبْهَة\nمثال: إنها بلا شك محقة. / زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "訪ねる": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "訪れ": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا. / وُصُول, وِفَادَة / أَخْبَار, أَنْبَاء (أنباء ما قد حدث؛ نشرة الأخبار أو عرض الأخبار: ما يعرضه التلفاز أو الراديو من أخبار سياسة واقتصادية ورياضية تهم عامة الناس)\nمثال: هذه أخبار طيبة.",
 "訪れる": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا. / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر.",
 "訪問": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر",
 "訪問ナース": "ممرضة زائرة (ممرضة تتقاضى أجراً لزيارة المرضى في منازلهم)",
 "訪問先": "وِجْهَة, وُجْهَة",
 "訪問地": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "訪問客": "طَازَج (طَازَج وَجَدِيد) / بَارِد عَلِيل, مُنْعِش ((عامّيّة اسكتلنديّة) يمنح البرودة والانتعاش) / زائر, ضيف (زائر اجتماعي أو للعمل) / متصل (الشخص الذي يبدأ مكالمة هاتفية)\nمثال: كانت الغرفة فوضوية لأنه لم يكن يتوقع ضيوفاً",
 "訪問看護": "الرِعَايَة المَنْزِلِيَّة",
 "訪問着": "شِبْهُ رَسْمِيّ (رَسْمِيٌّ بِشَكْلٍ مُعْتَدِلٍ؛ يَسْتَلْزِمُ ارْتِدَاءَ بَدْلَةِ عَشَاءٍ)",
 "訪問者": "زَائِر / زَائِر, سَائِح",
 "訪問販売": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت) / مِنْ بَابٍ لِبَاب ((عَنِ الرِّحْلَات أَوِ التَّوْصِيلَات) مُبَاشَرَة مِنْ نُقْطَة الأَصْل إِلَى الوِجْهَة)",
 "訪客": "زَائِر / زَائِر, سَائِح",
 "設い": "مُعَدَّات, تَجْهِيزَات",
 "設え": "مُعَدَّات, تَجْهِيزَات",
 "設える": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)",
 "設け": "تَحْضِير, إِعْدَاد",
 "設ける": "جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه. / نَظَّمَ (نَظَّمَه تَنْظِيمًا:أَلَّفَه وجَمَعَه فِي سِلْكٍ فانْتَظَمَ وتَنَظَّمَ ، وَمِنْه:نَظَمْتُ الشِّعْرَ ونَظَّمْتُه؛ نَظّم الأشياء :نظمها ،رتّبها،وضمّ بعضها إلى بعض في صورة منسّقة)\nمثال: نظم سامي كل شيء.",
 "設備": "مُعَدَّات, تَجْهِيزَات",
 "設備投資": "نفقات رأسمالية (تكلفة التحسينات طويلة الأجل)",
 "設問": "سُؤَال, سؤال (سُؤَال) / مَسْأَلَة / استفهم\nمثال: أجب على السؤال.",
 "設営": "بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "設定": "تَأْسِيس / مُؤَسَّسَة / تَهايُؤ",
 "設立": "تَأْسِيس / مُؤَسَّسَة\nمثال: わが校は１９００年に設立されました。 — تأسست مدرستنا عام ۱۹۹۰م. / إدماج, دمج (التضمين عن طريق الدمج) / تأسيس, دمج (دمج شيئين أو أكثر؛ الاتحاد في (أو ضمن) هيئة واحدة) / استدماج, تذويت (التعلم (للقيم أو المواقف وما إلى ذلك) الذي يتم دمجها داخل الذات)",
 "設立者": "مُؤَسِّس, مُؤَسِّسَة",
 "設立趣意書": "دليل المقررات (كتالوج يسرد الدورات التي تقدمها كلية أو جامعة) / نَشْرَة إِصْدَار, نَشْرَة اكْتِتَاب (عرض مكتوب رسمي لبيع الأوراق المالية يحدد خطة لمؤسسة تجارية (مقترحة))\nمثال: يجب أن تحتوي نشرة الاكتتاب على الحقائق التي يحتاجها المستثمر لاتخاذ قرار مستنير",
 "設置": "تَأْسِيس / مُؤَسَّسَة / تثبيت, تركيب (فعل تثبيت شيء ما (مثل المعدات)) / مرفق, منشأة (مبنى أو مكان يوفر خدمة معينة أو يستخدم لصناعة معينة) / انضمام, تعيين (الدخول الرسمي في منظمة أو منصب أو وظيفة)\nمثال: استغرق تركيب الهاتف بضع دقائق فقط",
 "設計": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "設計図": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "設計明細書": "نظارة ((جمع) أداة بصرية تتكون من إطار يحمل زوجاً من العدسات لتصحيح الرؤية المعيبة)",
 "設計者": "مُصَمِّم, مُصَمِّمَة",
 "設題": "سُؤَال, سؤال (سُؤَال) / مَسْأَلَة / استفهم\nمثال: أجب على السؤال.",
 "許": "تَحْتَ (أَقَلَّ)\nمثال: أنا تحت الشجرة. / مَعَ (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع) / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)\nمثال: جئت مع أصدقائي. / جَانِب / صَفْحَة",
 "許し": "إِبْرَاء, إِعْفَاء / عَفْو, صَفْح / عَفَا (عَفَا شَعَرُ البَعِيرِ: كَثُرَ، وطَالَ فَغَطَّى دُبُرَهُ؛ عَفَا أثَرُهُ عفاءً: هَلَكَ) / عَفْواً!, مَاذَا قُلْتَ؟",
 "許しがたい": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "許し難い": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "許す": "أَذِنَ, سَمَحَ (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / رُخْصَة / رُخُصَة\nمثال: من أذن لتوم باستعارة سيارتي? / سَامَحَ / غَفَرَ / إحالة الدعوى ((قانون) فعل الإحالة (خاصة إحالة قضية قانونية إلى محكمة أخرى)) / اختصاص, صلاحية (الموضوع الذي يُتوقع من شخص أو لجنة أو بحث التعامل معه أو لديه سلطة التعامل معه)\nمثال: شكلوا مجموعة باختصاص اقتراح طرق لتعزيز الحياة الأسرية / شَكَرَ ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته.",
 "許すまじ": "لَا يُغْتَفَرُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "許可": "تَصْرِيح, سَمَاح",
 "許可された人": "حامل الترخيص, مرخص له (شخص مُنح ترخيصاً)",
 "許可書": "أَذِنَ, سَمَحَ (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / رُخْصَة / رُخُصَة\nمثال: من أذن لتوم باستعارة سيارتي?",
 "許可証": "أَذِنَ, سَمَحَ (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / رُخْصَة / رُخُصَة\nمثال: من أذن لتوم باستعارة سيارتي?",
 "許婚": "خَطِيب",
 "許嫁": "خَطِيب",
 "許容": "تَصْرِيح, سَمَاح",
 "許容差": "تَحَمُّل / تَسَامُح",
 "許斐": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "許状": "إذن, تصريح (وثيقة قانونية تعطي إذناً رسمياً للقيام بشيء ما) / خروج عن المألوف, رخصة (حرية الانحراف عمداً عن القواعد أو الممارسات المطبقة عادة (خاصة في السلوك أو الكلام)) / إباحية, تحرر مفرط (حرية مفرطة؛ انعدام القيود الواجبة)\nمثال: عندما تصبح الحرية إباحية، تكون الديكتاتورية قريبة / إِبْرَاء, إِعْفَاء / عَفْو, صَفْح / عَفَا (عَفَا شَعَرُ البَعِيرِ: كَثُرَ، وطَالَ فَغَطَّى دُبُرَهُ؛ عَفَا أثَرُهُ عفاءً: هَلَكَ) / عَفْواً!, مَاذَا قُلْتَ؟",
 "許認可": "تَصْرِيح, سَمَاح",
 "許諾": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "訳": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / مَعْنًى / الْمَعْنَى / حَاسَّة / إِحْسَاس, شُعُور / مَعْنَى, دَلَالَة / مَوْهِبَة, قُدْرَة طَبِيعِيَّة / حَسَّ (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ النّارَ:رددْتُها بالعصا على خُبْزِ المَلّةِ؛ حَسَّ فلاناً:قتله قتلاً ذريعاً مستأصلاً رأسه.(حسَسْتُ اليهوديََ لما أظهر عداوته لله ودينه))\nمثال: لديهم حس الفكاهة. / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة / تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة.",
 "訳あり": "ناقص-غير كامل",
 "訳あり物件": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار. الجمع عَقَارات)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "訳がない": "هُنَاكَ, يُوجَدُ / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
