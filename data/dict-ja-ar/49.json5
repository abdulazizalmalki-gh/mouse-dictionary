 "言う成り": "إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل)",
 "言う所の": "في الواقع, كما هو الحال (في الحالة الفعلية للأمور وغالباً ما تكون عكس التوقعات)\nمثال: كان من الممكن أن يُقتل؛ ولكن في الواقع، أصيب بجروح خطيرة",
 "言う迄もない": "بَدِيهِيّ, بَدَهِيّ",
 "言う迄もなく": "بُوضُوح",
 "言う迄も無い": "بَدِيهِيّ, بَدَهِيّ",
 "言う迄も無く": "بُوضُوح",
 "言える": "السَّابِقُ ذِكْرُهُ",
 "言った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "言ったもん勝ち": "الْمُخْتَار, الْمُخْتَارَة",
 "言った者勝ち": "الْمُخْتَار, الْمُخْتَارَة",
 "言った言わない": "قِيل وَقال",
 "言ってのける": "حَذَّرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك.",
 "言ってみれば": "إذا جاز التعبير, إن صح التعبير (كما لو كان الأمر كذلك حقاً)\nمثال: تعيش هنا، إن صح التعبير",
 "言って退ける": "حَذَّرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك.",
 "言っとくけど": "لمعلوماتك",
 "言づて": "رِسَالَة, خَبَر",
 "言の葉": "كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ:…)\nمثال: كلمة السر طويلة.",
 "言ふ方無し": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "言わずと知れた": "بَدِيهِيّ, بَدَهِيّ",
 "言わないことではない": "قُلْتُ لَكَ ذٰلِكَ, قُلْتُ لَكِ ذٰلِكَ",
 "言わぬが花": "اَلسُّكُوتُ مِن ذَهَبٍ",
 "言わぬは言うにまさる": "إِنْ كَانَ الْكَلَامُ مِنْ فِضَّةٍ فَالسُّكُوتُ مِنْ ذَهَبٍ (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "言わぬは言うに優る": "إِنْ كَانَ الْكَلَامُ مِنْ فِضَّةٍ فَالسُّكُوتُ مِنْ ذَهَبٍ (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "言わば": "إن جازَ التَعْبِير (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "言われてみれば": "بِمَا أَنّ, أَمَا وَأَنّ",
 "言わんこっちゃない": "قُلْتُ لَكَ ذٰلِكَ, قُلْتُ لَكِ ذٰلِكَ",
 "言わんばかり": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "言わん方無し": "هُنَاك, يُوجَد",
 "言をまたない": "مِن نَّافِلَةِ القَوْلِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "言を俟たない": "مِن نَّافِلَةِ القَوْلِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "言を左右にする": "لَفَّ وَدَارَ",
 "言を待たない": "مِن نَّافِلَةِ القَوْلِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "言上": "بَلِيغ, مُؤَثِّر (يُنتج أثراً قويّاً)",
 "言下": "بسرعة, على الفور (بطريقة دقيقة في المواعيد)\nمثال: أدى واجبه المنزلي بسرعة",
 "言争い": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل…)\nمثال: شمال مالي منطقة نزاع.",
 "言争う": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل…)\nمثال: شمال مالي منطقة نزاع.",
 "言交す": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به)\nمثال: وعد بأن يتزوجها.",
 "言交わす": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به)\nمثال: وعد بأن يتزوجها.",
 "言付け": "رِسَالَة, خَبَر / عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر. / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "言付ける": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "言伝": "رِسَالَة, خَبَر",
 "言伝える": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "言伝て": "رِسَالَة, خَبَر",
 "言値": "سِعْر طَلَب (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو…)\nمثال: إتفقوا على سعر.",
 "言切り": "تَأْكِيد, تَوْكِيد",
 "言動": "سُلُوك, تَصَرُّف\nمثال: 彼の言動は一致していない。 — كلامه وأعماله متناقضان.",
 "言及": "مَرْجِع",
 "言及ぶ": "ذِكْر (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "言句": "كلام, كلمات (اللغة التي يتم التحدث بها أو كتابتها)\nمثال: لديه موهبة في الكلام",
 "言合い": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل…)\nمثال: شمال مالي منطقة نزاع.",
 "言合う": "تَبْدِيل, تَبَادُل / نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل…)\nمثال: شمال مالي منطقة نزاع.",
 "言合わせる": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "言囃す": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "言外": "غَيْر مُعَبَّر عَنْه, مَسْكُوت عَنْه (لم يُصَرَّح به أو يُفْصَح عنه)",
 "言外に": "ضمناً (بدون التعبير عن ذلك بوضوح)\nمثال: يفترض ضمناً أنك تعرف الإجابة",
 "言外にほのめかす": "اِنْطَوَى",
 "言外に仄めかす": "اِنْطَوَى",
 "言外の意味": "تَلَازُم",
 "言広める": "بُوق (فَسَد؛ باق الرجل: كَذَب)\nمثال: كان سامي ينبه بالبوق.",
 "言成り": "إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل)",
 "言抜け": "تملص, مراوغة (فعل الهروب جسدياً من شيء ما (خصم أو مطارد أو موقف غير سار) عن طريق مناورة بارعة)\nمثال: كان تهربه من واجبه الواضح أمراً مستهجناً",
 "言挙げ": "إِعْلَان, بَيَان",
 "言振り": "إلقاء, طريقة التحدث (أسلوبك أو طريقتك المميزة في التعبير عن نفسك شفهياً)\nمثال: كانت طريقته في الكلام فظة للغاية",
 "言掛ける": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "言揚げ": "إِعْلَان, بَيَان",
 "言換え": "إعادة صياغة (تغيير كلمة أو عبارة معينة)",
 "言損ない": "زلة لسان (خطأ عرضي وتافه عادة في التحدث)",
 "言散らす": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "言明": "إِعْلَان, بَيَان",
 "言替え": "إعادة صياغة (تغيير كلمة أو عبارة معينة)",
 "言替えるなら": "وَبِعِبَارَة أُخْرَى",
 "言条": "رَغْم أَنَّ, مَعَ أَنَّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال…)\nمثال: إنه سعيد رغم فقره.",
 "言様がない": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)\nمثال: 何とも言いようがないなあ。 — لا أعرف ماذا أقول.",
 "言止す": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "言添える": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "言渡し": "حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "言渡す": "أَعْلَنَ (أَظْهَرَ الأَمْرَ، جَهَرَ بِهِ)\nمثال: أعلن توم عن تقاعده.",
 "言直し": "إعادة صياغة (بيان منقح)",
 "言祝ぎ": "مُبَارَك, مَبْرُوك",
 "言祝ぐ": "هَنَّأَ, يُهَنِّئُ",
 "言習わし": "اِصْطِلَاح, مُصْطَلَح",
 "言聞かせる": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه.",
 "言草": "التفات, ملاحظة (انتباه صريح)\nمثال: مر الأمر دون ملاحظة / عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر. / مَوْضُوع, مَوَاضِيع",
 "言葉": "لُغَة, لِسَان (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل…)\nمثال: الأمازيغية لغة. / كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ:…)\nمثال: كلمة السر طويلة. / حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث. / كلام, كلمات (اللغة التي يتم التحدث بها أو كتابتها)\nمثال: لديه موهبة في الكلام",
 "言葉がみつからない": "بِخَسَارَة (أقل من التكلفة)\nمثال: باع السيارة بخسارة",
 "言葉が見つからない": "بِخَسَارَة (أقل من التكلفة)\nمثال: باع السيارة بخسارة",
 "言葉が見付からない": "بِخَسَارَة (أقل من التكلفة)\nمثال: باع السيارة بخسارة",
 "言葉たくみ": "زلاقة لسان, لباقة سطحية (نوع من السطحية السلسة والطلقة)\nمثال: زلاقة لسان بائع لحوح",
 "言葉つき": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "言葉どおり": "حَرْفًا بِحَرْفٍ, حَرْفِيًّا",
 "言葉にする": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "言葉に表せない": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "言葉のあや": "صورة بلاغية, مجاز (اللغة المستخدمة بمعنى مجازي أو غير حرفي)",
 "言葉のアヤ": "صورة بلاغية, مجاز (اللغة المستخدمة بمعنى مجازي أو غير حرفي)",
 "言葉のサラダ": "سَلَطَة كَلِمَات (خليط من الكلام غير المترابط كما يُسمع أحياناً في الفصام)",
 "言葉の壁": "حاجز لغوي (حاجز أمام التواصل ناتج عن التحدث بلغات مختلفة)",
 "言葉の海": "جموع, حشد (كمية كبيرة غير محددة)\nمثال: حشد من النمل",
 "言葉の綾": "صورة بلاغية, مجاز (اللغة المستخدمة بمعنى مجازي أو غير حرفي)",
 "言葉をかける": "تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "言葉をのむ": "صَمَتَ",
 "言葉を切る": "تَوَقَّفَ",
 "言葉を吐く": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "言葉を吞む": "صَمَتَ",
 "言葉を呑む": "صَمَتَ",
 "言葉を掛ける": "تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "言葉を残す": "قَالَ, قال (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "言葉を継ぐ": "تَابَعَ, اِسْتَمَرَّ",
 "言葉を返す": "أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا. / معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة)\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "言葉付き": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "言葉使い": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
