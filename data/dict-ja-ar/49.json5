 "諫言": "تَحْذِير, تَنْبِيه (نصيحة تحذيرية حول شيء وشيك (خاصة خطر وشيك أو أمر غير سار)) / إِنْذَار, تَحْذِير (توبيخ حازم)\nمثال: خطاب تحذير حول مخاطر الفسق",
 "諭し": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد",
 "諭す": "نَصَحَ (نصحه: أَرْشَدَه وأَشَارَ عليه) / بَلَّغَ, أَبْلَغَ\nمثال: نصح مناد بباية.",
 "諭告": "تَحْذِير, تَنْبِيه (نصيحة تحذيرية حول شيء وشيك (خاصة خطر وشيك أو أمر غير سار)) / إِنْذَار, تَحْذِير (توبيخ حازم)\nمثال: خطاب تحذير حول مخاطر الفسق",
 "諭示": "تَحْذِير, تَنْبِيه (نصيحة تحذيرية حول شيء وشيك (خاصة خطر وشيك أو أمر غير سار)) / إِنْذَار, تَحْذِير (توبيخ حازم)\nمثال: خطاب تحذير حول مخاطر الفسق",
 "諮る": "نَاقَشَ, بَحَثَ",
 "諮問": "مُشَاوَرَة, اِسْتِشَارَة",
 "諮詢": "سُؤَال, سؤال (سُؤَال) / مَسْأَلَة / استفهم\nمثال: أجب على السؤال.",
 "諮議": "مُشَاوَرَة, اِسْتِشَارَة",
 "諱む": "تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "諳んじる": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "諳んずる": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "諳厄利亜": "إِنْجِلْتِرَا (منطقة في بِرِيطَانِيَا الْعُظْمَى، تقع بشرق وِيلْز، وجنوب إِسْكُتْلَنْدَا؛ عاصمتها لُنْدُن؛ وهي إحدى الدول المكونة للمملكة المتحدة) / إِنْقِلْتِرَا / إِنْكِلْتِرَا / إِنْكِلْتِرَة",
 "諷する": "تَلْمِيح / لَمَّحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه)\nمثال: لمح سامي منزلا.",
 "諷刺": "هِجَاء, هَجْو",
 "諷喩": "تَلْمِيح / لَمَّحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه)\nمثال: لمح سامي منزلا.",
 "諷誦": "تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه)",
 "諸": "مُخْتَلِف, مُتَنَوَّع / جموع, حشد (كمية كبيرة غير محددة)\nمثال: حشد من النمل / كِلَا (بمعنى إنته ولا تفعل، ليست بحاجة إلى جملة كاملة؛ تأتي بمعنى لا الجوابية) / كل من ؛ و ؛\nمثال: انا احب كلا منهما / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / مَعًا, سَوِيًّا",
 "諸々": "جموع, حشد (كمية كبيرة غير محددة)\nمثال: حشد من النمل",
 "諸事": "كُلّ شَيْء",
 "諸事万端": "كُلّ شَيْء",
 "諸人": "الْجَمِيع, كُلّ شَخْص",
 "諸侯": "إقطاعي, سيد إقطاعي (رجل ذو رتبة في النظام القديم)",
 "諸元": "مُوَاصَفَة",
 "諸兄姉": "سَيِّدَاتِي وَسَادَتِي",
 "諸公": "عَالِيّ الرُتْبَة / سَيِّدَاتِي وَسَادَتِي",
 "諸共": "مَعًا, سَوِيًّا",
 "諸処": "هُنَا وَهُنَاكَ",
 "諸刃": "ذُو حَدَّيْن (قابل للتفسير بطريقتين عادة متناقضتين)",
 "諸刃の剣": "سَيْفٌ ذُو حَدَّيْنِ (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة)\nمثال: القلم أقوى من السيف.",
 "諸力": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "諸口": "متفرقات (أشياء متنوعة عديدة جداً أو صغيرة جداً بحيث لا يمكن تحديدها)",
 "諸君": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / سَيِّدَاتِي وَسَادَتِي\nمثال: 諸君、ちょっと御挨拶申し上げます。 — أيها السادة، اسمحوا لي أن أحييكم.",
 "諸味": "خشن, غير مهذب ((للأشخاص وسلوكهم) غير مهذب؛ فظ) / خام, غير مكرر (غير مكرر أو معالج)\nمثال: كيف يمكن لفتاة مهذبة أن تنجذب لرجل خشن كهذا؟",
 "諸姉": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "諸子": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / جودجون (سمكة مياه عذبة أوروبية نحيلة صغيرة غالباً ما يستخدمها الصيادون كطعم) / قوبيون (سمكة صغيرة شائكة الزعانف تعيش في المياه الساحلية أو قليلة الملوحة لها رأس كبير وجسم مستدق ممدود وتتحور الزعانف البطنية لتعمل كممص)",
 "諸岡": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "諸島": "أَرْخَبِيل",
 "諸式": "ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان) / ثَمَن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن.",
 "諸所": "هُنَا وَهُنَاكَ",
 "諸手をあげて": "قَلْبًا وَقَالَبًا",
 "諸手を挙げて": "قَلْبًا وَقَالَبًا",
 "諸手当": "فَائِدَة, جَدْوَى",
 "諸教混交": "توفيق صيغي (دمج الأشكال المصرفة التي كانت مختلفة أصلاً (مما يؤدي إلى تقليل استخدام التصريفات)) / تلفيقية, توفيقية (اتحاد (أو محاولة دمج) أنظمة فكرية أو معتقدات مختلفة (خاصة في الدين أو الفلسفة))\nمثال: توفيقية بين النظريات المادية وغير المادية",
 "諸教混淆": "توفيق صيغي (دمج الأشكال المصرفة التي كانت مختلفة أصلاً (مما يؤدي إلى تقليل استخدام التصريفات)) / تلفيقية, توفيقية (اتحاد (أو محاولة دمج) أنظمة فكرية أو معتقدات مختلفة (خاصة في الدين أو الفلسفة))\nمثال: توفيقية بين النظريات المادية وغير المادية",
 "諸料金": "رسم إضافي (رسم إضافي (كما هو الحال بالنسبة للعناصر التي تم حذفها سابقاً أو كعقوبة لعدم ممارسة الحذر العام أو المهارة العامة))",
 "諸星": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "諸江": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "諸注意": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "諸物": "هَوَس, وَلَع مَرَضِيّ (تفاني مفرط أو غير عقلاني لنشاط ما) / تميمة سحرية, سحر (تميمة يُعتقد بخرافة أنها تجسد قوى سحرية) / صنمية جنسية, فتيشية (شكل من أشكال الرغبة الجنسية يعتمد فيه الإشباع بدرجة غير طبيعية على كائن أو قطعة ملابس أو جزء من الجسم)\nمثال: جعل من النظافة هوساً",
 "諸王": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلِك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)",
 "諸症状": "عَرَض, عَلَامَة (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / عَرَض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "諸神": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "諸積": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "諸般": "مُخْتَلِف, مُتَنَوَّع",
 "諸色": "ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان) / ثَمَن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن.",
 "諸芸": "تَنْفِيذ",
 "諸葛": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "諸藤": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "諸見里": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "諸訳": "تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية",
 "諸語": "لُغَة, لِسَان (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة) / لُغَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "諸説紛々": "هُنَاك, يُوجَد",
 "諸説紛紛": "هُنَاك, يُوجَد",
 "諸諸": "جموع, حشد (كمية كبيرة غير محددة)\nمثال: حشد من النمل",
 "諸道": "تَنْفِيذ",
 "諺": "مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "諺文": "هَانْغُول / هَانْغُول / مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "諺語": "عَامِّيَّة, دَارِجَة / مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "諾": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة / النُّرْوِيج (دولة تغطي مساحتُها الشطرين الشمالي والغربي من شبه الجزيرة الإسكندنافية التي تقع في شمال قارة أوروبا؛ اسمها الرسمي مملكة النرويج، وعاصمتها أوسلو)\nمثال: أنا من النرويج. / بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "諾々": "مُطِيع, مُذْعِن",
 "諾う": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "諾約者": "واعد (شخص يقطع وعدًا)",
 "諾諾": "مُطِيع, مُذْعِن",
 "諾足": "خبب (مشية أسرع من المشي؛ تضرب الأرجل المتقابلة قطرياً الأرض معاً) / هرولة (وتيرة جري بطيئة) / ترجمة حرفية مساعدة (ترجمة حرفية تُستخدم في دراسة لغة أجنبية (غالباً ما تُستخدم بشكل غير مشروع للغش)) / تروتسكي (راديكاليون يدعمون نظرية تروتسكي بأن الاشتراكية يجب أن تتأسس في جميع أنحاء العالم من خلال الثورة المستمرة)",
 "謀": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "謀る": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه. / حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة. / مَكِيدَة / نَاقَشَ, بَحَثَ",
