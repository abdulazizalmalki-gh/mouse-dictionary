{
 "触法精神障害者": "مَجْنُون, مَخْبُول",
 "触球": "زَقِيطَة",
 "触発": "زِنَاد",
 "触腕": "مِجَس, لامِس",
 "触覚": "حاسة اللمس, لمس (الملكة التي تدرك بها الأشياء أو القوى الخارجية من خلال الاتصال بالجسم (وخاصة…)\nمثال: فقط البصر واللمس يمكننا من تحديد مواقع الأشياء في الفضاء حولنا / لَمْسِيّ (يُنْتِجُ إِحْسَاسًا بِاللَّمْس)\nمثال: بيانات لمسية / تَسْرِيحَة شَعْر, تَصْفِيفَة شَعْر (ترتيب الشعر (خاصة شعر المرأة))",
 "触角": "قرن استشعار, ملمس (واحدة من زوج من الزوائد المتحركة على رأس الحشرات والقشريات؛ حساسة عادة للمس…)\nمثال: كان لديه استشعار خاص للعلاقات العامة",
 "触診": "جس (طريقة للفحص يشعر فيها الفاحص بحجم أو شكل أو صلابة أو موقع شيء ما (أو أجزاء…)",
 "触鬚": "بربيس, زائدة استشعارية (نتوء لمسي رفيع على فكي السمكة)",
 "言": "كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ:…)\nمثال: كلمة السر طويلة.",
 "言いかける": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "言いがかり": "ذَرِيعَة, عُذْر",
 "言いがたい": "لا يمكن التعبير عنه, لا يوصف (يتحدى التعبير) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا)",
 "言いきかせる": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه.",
 "言いくるめる": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "言いさす": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "言いすぎ": "مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "言いすぎる": "بَالَغَ",
 "言いそこない": "زلة لسان (خطأ عرضي وتافه عادة في التحدث)",
 "言いたす": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "言いだしっぺ": "مُتَكَلِّم",
 "言いつけ": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "言いつける": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه.",
 "言いなり": "إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل)",
 "言いにくい": "لا يمكن التعبير عنه, لا يوصف (يتحدى التعبير) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا)",
 "言いのける": "تجاهل, صد (فعل غير مهذب متعمد (عادة كتعبير عن الغضب أو الرفض))",
 "言いはやす": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "言いふらす": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "言いぶり": "إلقاء, طريقة التحدث (أسلوبك أو طريقتك المميزة في التعبير عن نفسك شفهياً)\nمثال: كانت طريقته في الكلام فظة للغاية",
 "言いよう": "إلقاء, طريقة التحدث (أسلوبك أو طريقتك المميزة في التعبير عن نفسك شفهياً)\nمثال: كانت طريقته في الكلام فظة للغاية / فِي نَفْس اَلْوَقْت (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "言いようがない": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)\nمثال: 何とも言いようがないなあ。 — لا أعرف ماذا أقول.",
 "言いようのない": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "言いよる": "مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "言い争い": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل…)\nمثال: شمال مالي منطقة نزاع.",
 "言い争う": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل…)\nمثال: شمال مالي منطقة نزاع.",
 "言い交す": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به)\nمثال: وعد بأن يتزوجها.",
 "言い交わす": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به)\nمثال: وعد بأن يتزوجها.",
 "言い付け": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "言い付ける": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه.",
 "言い伝え": "تَقْلِيد / رِسَالَة, خَبَر",
 "言い伝える": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "言い値": "سِعْر طَلَب (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو…)\nمثال: إتفقوا على سعر.",
 "言い出しっぺ": "مُتَكَلِّم",
 "言い出しべ": "مُتَكَلِّم",
 "言い出し屁": "مُتَكَلِّم",
 "言い出す": "فَاتَحَ (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه)\nمثال: شعري لونه بني فاتح. / اِقْتَرَحَ, أَوْصَى (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ)\nمثال: اقترح سامي المساعدة.",
 "言い分": "شِكَايَة, شَكْوَى",
 "言い切り": "تَأْكِيد, تَوْكِيد",
 "言い包める": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "言い及ぶ": "ذِكْر (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "言い合い": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل…)\nمثال: شمال مالي منطقة نزاع.",
 "言い合う": "تَبْدِيل, تَبَادُل / نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل…)\nمثال: شمال مالي منطقة نزاع.",
 "言い合わせる": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "言い囃す": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "言い回し": "تَعْبِير",
 "言い寄る": "مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "言い広める": "بُوق (فَسَد؛ باق الرجل: كَذَب)\nمثال: كان سامي ينبه بالبوق.",
 "言い張る": "أَصَرَّ (لواه وشدّه وربطه؛ أَصَرَ الشيءَ: كَسَرَهُ وعَطَفه)\nمثال: أصر على الأفضل.",
 "言い成り": "إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل)",
 "言い抜け": "تملص, مراوغة (فعل الهروب جسدياً من شيء ما (خصم أو مطارد أو موقف غير سار) عن طريق مناورة بارعة)\nمثال: كان تهربه من واجبه الواضح أمراً مستهجناً",
 "言い振り": "إلقاء, طريقة التحدث (أسلوبك أو طريقتك المميزة في التعبير عن نفسك شفهياً)\nمثال: كانت طريقته في الكلام فظة للغاية",
 "言い掛かり": "ذَرِيعَة, عُذْر",
 "言い掛ける": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "言い換え": "إعادة صياغة (تغيير كلمة أو عبارة معينة)",
 "言い損ない": "زلة لسان (خطأ عرضي وتافه عادة في التحدث)",
 "言い散らす": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "言い方": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات)",
 "言い替え": "إعادة صياغة (تغيير كلمة أو عبارة معينة)",
 "言い替えるなら": "وَبِعِبَارَة أُخْرَى",
 "言い条": "رَغْم أَنَّ, مَعَ أَنَّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال…)\nمثال: إنه سعيد رغم فقره.",
 "言い様": "إلقاء, طريقة التحدث (أسلوبك أو طريقتك المميزة في التعبير عن نفسك شفهياً)\nمثال: كانت طريقته في الكلام فظة للغاية / فِي نَفْس اَلْوَقْت (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "言い様がない": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)\nمثال: 何とも言いようがないなあ。 — لا أعرف ماذا أقول.",
 "言い様のない": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "言い止す": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "言い添える": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "言い渡し": "حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "言い渡す": "أَعْلَنَ (أَظْهَرَ الأَمْرَ، جَهَرَ بِهِ)\nمثال: أعلن توم عن تقاعده.",
 "言い直し": "إعادة صياغة (بيان منقح)",
 "言い知れない": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "言い知れぬ": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "言い種": "التفات, ملاحظة (انتباه صريح)\nمثال: مر الأمر دون ملاحظة / عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر. / مَوْضُوع, مَوَاضِيع",
 "言い立てる": "دَعْوَى, اِدِّعَاء (إدِّعَاء؛ دُعَاء)\nمثال: رفضت الضحية إقامة دعوى قضائية. / قَائِمَة, قائمة",
 "言い習わし": "اِصْطِلَاح, مُصْطَلَح",
 "言い聞かす": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه.",
 "言い聞かせる": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه.",
 "言い草": "التفات, ملاحظة (انتباه صريح)\nمثال: مر الأمر دون ملاحظة / عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر. / مَوْضُوع, مَوَاضِيع",
 "言い表す": "عَبَّرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق. / اِعْتَرَفَ, أَقَرَّ",
 "言い表わす": "عَبَّرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق. / اِعْتَرَفَ, أَقَرَّ",
 "言い触らす": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "言い訳": "عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر. / تَفْسِير, شَرْح",
 "言い訳がましい": "دفاعي (مخصص أو مناسب للدفاع ضد العدوان أو الهجوم أو لردعه)\nمثال: أسلحة دفاعية",
 "言い負かす": "دَحَضَ, أَدْحَضَ (أبطلَ الحُجّة أو دفعها بالحُجّة المضادة؛ زلَّ أو انزلق)\nمثال: اتهمتني بالكذب.",
 "言い足す": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "言い返し": "أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا.",
 "言い返す": "معوجة (وعاء يتم فيه تقطير المواد أو تحللها بالحرارة)\nمثال: استدعى ذلك رداً حاداً من المعلم / كَرَّرَ, أَعَادَ (أَعَادَ)\nمثال: كرر الشهادة بعدي.",
 "言い逃がれ": "تملص, مراوغة (فعل الهروب جسدياً من شيء ما (خصم أو مطارد أو موقف غير سار) عن طريق مناورة بارعة)\nمثال: كان تهربه من واجبه الواضح أمراً مستهجناً",
 "言い逃れ": "تملص, مراوغة (فعل الهروب جسدياً من شيء ما (خصم أو مطارد أو موقف غير سار) عن طريق مناورة بارعة)\nمثال: كان تهربه من واجبه الواضح أمراً مستهجناً",
 "言い過ぎ": "مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "言い過ぎる": "بَالَغَ",
 "言い過ごす": "بَالَغَ",
 "言い違い": "زلة لسان (خطأ عرضي وتافه عادة في التحدث)",
 "言い開き": "عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر.",
 "言い開く": "بَرَّرَ (بَرَّرَ عملَه: زكّاه، وذكر من الأسباب ما يبيحه والتمس له من الأسباب ما يجعله…)",
 "言い間違い": "زلة لسان (خطأ عرضي وتافه عادة في التحدث)",
 "言い間違え": "زلة لسان (خطأ عرضي وتافه عادة في التحدث)",
 "言い難い": "لا يمكن التعبير عنه, لا يوصف (يتحدى التعبير) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا)",
 "言う": "قَالَ, قال (نَطَقَ بالكلام)\nمثال: قال زيري وداعا. / اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه…)\nمثال: ما اسم حصان توم؟ / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ…)\nمثال: ذهب إلى الدكان.",
 "言うことを聞く": "أَطَاعَ",
 "言うところの": "في الواقع, كما هو الحال (في الحالة الفعلية للأمور وغالباً ما تكون عكس التوقعات)\nمثال: كان من الممكن أن يُقتل؛ ولكن في الواقع، أصيب بجروح خطيرة",
 "言うなり": "إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل)",
 "言うなれば": "إن جازَ التَعْبِير (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "言うに言われぬ": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "言うまでもない": "بَدِيهِيّ, بَدَهِيّ",
 "言うまでもなく": "بُوضُوح",
 "言うまでも無い": "بَدِيهِيّ, بَدَهِيّ",
 "言うまでも無く": "بُوضُوح",
