 "諦め": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "諦めがつく": "قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل.",
 "諦めが付く": "قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل.",
 "諦めつく": "قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل.",
 "諦める": "تَنَازَلَ / تَخَلَّى / اِسْتَسْلَمَ",
 "諦めモード": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "諦め付く": "قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل.",
 "諦念": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "諦観": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "諧和": "اِنْسِجَام, تَوَافُق",
 "諧調": "اِنْسِجَام, تَوَافُق",
 "諧謔": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "諫め": "اِعْتَرَضَ, اِحْتَجَّ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ: حَالَ بينه وبين ما يريد، أو وقف في طريقه) / اِعْتِرَاض, اِحْتِجَاج\nمثال: اعترض ديما: \"لكن هذا سخيف! الكوبيكات لم تعد تستخدم منذ عصور! و0.99 ليس رقما طبيعيا حتى!\"",
 "諭し": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد",
 "諭す": "نَصَحَ (نصحه: أَرْشَدَه وأَشَارَ عليه) / بَلَّغَ, أَبْلَغَ\nمثال: نصح مناد بباية.",
 "諭示": "تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: هو بارع في التعليم.",
 "諮る": "نَاقَشَ, بَحَثَ",
 "諮問": "مُشَاوَرَة, اِسْتِشَارَة",
 "諮詢": "سُؤَال, سؤال (سُؤَال) / مَسْأَلَة / استفهم\nمثال: أجب على السؤال.",
 "諮議": "مُشَاوَرَة, اِسْتِشَارَة",
 "諱む": "تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "諳んじる": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "諳んずる": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "諷する": "تَلْمِيح / لَمَّحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه)\nمثال: لمح سامي منزلا.",
 "諷刺": "هِجَاء, هَجْو",
 "諷喩": "تَلْمِيح / لَمَّحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه)\nمثال: لمح سامي منزلا.",
 "諷誦": "تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه)",
 "諸": "مُخْتَلِف, مُتَنَوَّع",
 "諸事": "كُلّ شَيْء",
 "諸事万端": "كُلّ شَيْء",
 "諸人": "الْجَمِيع, كُلّ شَخْص",
 "諸侯": "بارون",
 "諸兄姉": "سَيِّدَاتِي وَسَادَتِي",
 "諸公": "قِسِّيس, دَاعِيَة (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ) / وَزِير, وَزِيرَة / سَيِّدَاتِي وَسَادَتِي",
 "諸共": "مَعًا, سَوِيًّا",
 "諸処": "هُنَا وَهُنَاكَ",
 "諸刃の剣": "سَيْفٌ ذُو حَدَّيْنِ (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة)\nمثال: القلم أقوى من السيف.",
 "諸力": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "諸口": "مُتَنَوِّع",
 "諸君": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / سَيِّدَاتِي وَسَادَتِي\nمثال: 諸君、ちょっと御挨拶申し上げます。 — أيها السادة، اسمحوا لي أن أحييكم.",
 "諸味": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "諸姉": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "諸子": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "諸島": "أَرْخَبِيل",
 "諸式": "ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان) / ثَمَن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن.",
 "諸所": "هُنَا وَهُنَاكَ",
 "諸手をあげて": "قَلْبًا وَقَالَبًا",
 "諸手を挙げて": "قَلْبًا وَقَالَبًا",
 "諸手当": "فَائِدَة, جَدْوَى",
 "諸注意": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "諸症状": "عَرَض, عَلَامَة (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / عَرَض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "諸神": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "諸般": "مُخْتَلِف, مُتَنَوَّع",
 "諸色": "ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان) / ثَمَن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن.",
 "諸芸": "تَنْفِيذ",
 "諸訳": "تَفْصِيل, تَفَاصِيل / فَصَّلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل.",
 "諸語": "لُغَة, لِسَان (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة) / لُغَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "諸道": "تَنْفِيذ",
 "諺": "مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "諺文": "هَانْغُول",
 "諺語": "عَامِّيَّة, دَارِجَة / مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "諾": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة / النُّرْوِيج (دولة تغطي مساحتُها الشطرين الشمالي والغربي من شبه الجزيرة الإسكندنافية التي تقع في شمال قارة أوروبا؛ اسمها الرسمي مملكة النرويج، وعاصمتها أوسلو)\nمثال: أنا من النرويج.",
 "諾々": "مُطِيع, مُذْعِن",
 "諾う": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "諾諾": "مُطِيع, مُذْعِن",
 "謀": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "謀る": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه. / حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "謀反": "ثَوْرَة, تَمَرُّد",
 "謀反人": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "謀叛": "ثَوْرَة, تَمَرُّد",
 "謀略": "مَكِيدَة",
 "謀略論": "نَظَرِيَّة مُؤَامَرَة (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية.",
 "謀計": "دَسِيسَة / مُؤَامِرَة, مُوَاطَأَة",
 "謀議": "حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ",
 "謁": "جُمْهُور, نَظَّارَة",
 "謁見": "جُمْهُور, نَظَّارَة",
 "謂う所の": "مَا يُسَمَّى (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "謂えらく": "الْمُفْتَرَض مِنْ",
 "謂れ": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مَحْفُوظَات\nمثال: ما تاريخ اليوم؟",
 "謂れ因縁": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل",
 "謂われ": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مَحْفُوظَات\nمثال: ما تاريخ اليوم؟",
 "謄写": "نُسْخَة / اِنْتَسَخَ, نَسَخَ",
 "謄本": "نُسْخَة",
 "謎": "لُغْز, أُحْجِيَّة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة رمزية أو غير مباشرة)\nمثال: لم يحل أبدا لغز وفاتها. / غَامِض",
 "謎々": "لُغْز, أُحْجِيَّة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة رمزية أو غير مباشرة)\nمثال: لم يحل أبدا لغز وفاتها.",
 "謎い": "لُغْز, مُعْضِلَة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة رمزية أو غير مباشرة) / بَازْل, لُغْز / حَيَّرَ ((حَيَّرَه): أَوْقَعَه فِي حيرة)\nمثال: لم يحل أبدا لغز وفاتها.",
 "謎めいた": "لُغْز, مُعْضِلَة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة رمزية أو غير مباشرة) / بَازْل, لُغْز / حَيَّرَ ((حَيَّرَه): أَوْقَعَه فِي حيرة)\nمثال: لم يحل أبدا لغز وفاتها.",
 "謎をかける": "تَلْمِيح / لَمَّحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه)\nمثال: لمح سامي منزلا.",
 "謎を掛ける": "تَلْمِيح / لَمَّحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه)\nمثال: لمح سامي منزلا.",
 "謎謎": "لُغْز, أُحْجِيَّة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة رمزية أو غير مباشرة)\nمثال: لم يحل أبدا لغز وفاتها.",
 "謗り": "لَامَ, اِسْتَنْكَرَ (لامَ يَلوم ، لُمْ ، لَوْمًا ، فهو لائم والجمع : لُوَّمٌ ، ولُيَّمٌ وهو أَيضاً لَوَّامٌ ، ولَوَّامةٌ ، ولْوَمةٌ وذاك مَلُومٌ ، ومَلِيمٌ…)\nمثال: لام سامي معلمه على فشله هو.",
 "謗る": "تَشْهِير, اِفْتِرَاء",
 "謙虚": "مُتْوَاضِع / مُحْتَشِم",
 "謙譲": "تَوَاضُع / حِشْمَة",
 "謙遜": "تَوَاضُع / حِشْمَة",
 "講じる": "مُحَاضَرَة / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي. / أَفْضَلَ, مَنَحَ / تَآمَرَ / سَالَمَ, صَالَحَ",
 "講ずる": "مُحَاضَرَة / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي. / سَالَمَ, صَالَحَ",
 "講会": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم.",
 "講和": "صُلْح, مُصَالَحَة",
 "講和条約": "مُعَاهَدَة سَلَام (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "講学": "ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "講師": "خَطِيب, مُتَكَلِّم / سَمَاعَة / مُحَاضِر, مُحَاضِرَة",
 "講師陣": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "講座": "طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / مَسار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا الطبق لذيذ.",
 "講演": "مُحَاضَرَة",
