 "ヤスリがけ": "بُرَادَة",
 "ヤスリめ": "أسنان, نظام الأسنان (نوع وعدد وترتيب الأسنان (مجتمعة) في شخص أو حيوان)",
 "ヤスリ掛け": "بُرَادَة",
 "ヤスリ目": "أسنان, نظام الأسنان (نوع وعدد وترتيب الأسنان (مجتمعة) في شخص أو حيوان)",
 "ヤズィーディーきょう": "الإيزيدية",
 "ヤズィーディー教": "الإيزيدية",
 "ヤズディきょう": "الإيزيدية",
 "ヤズディ教": "الإيزيدية",
 "ヤセの大食い": "نحيل, هزيل (شخص نحيف وهزيل بشكل غير عادي)",
 "ヤセザル": "لانغور (قرد آسيوي نحيل طويل الذيل)",
 "ヤソ": "عِيسَى ((في الإسلام) عيسى بن مريم، نبي أُرسل إلى بني إسرائيل؛ آتاه الله الإنجيل، وورد ذكره في القرآن ٢٥ مرة، وهو أحد أولي العزم؛ اسم شخصي معطى للذكور من المسلمين العرب)\nمثال: كان عيسى يهوديا. / مَسِيحِيَّة, نَصْرَانِيَّة (مؤنث المَسِيْحِيّ؛ المنسوبة إلى المَسِيْح؛ هي الدِيْن الذي يدين به المَسِيْحِيُّوْن؛ النَصْرَانِيَّة)\nمثال: اعتنق المسيحية.",
 "ヤソかい": "الرَهْبَنة اليَسُوعِيّة, جَماعة يَسُوع",
 "ヤソきょう": "مَسِيحِيَّة, نَصْرَانِيَّة (مؤنث المَسِيْحِيّ؛ المنسوبة إلى المَسِيْح؛ هي الدِيْن الذي يدين به المَسِيْحِيُّوْن؛ النَصْرَانِيَّة)\nمثال: اعتنق المسيحية.",
 "ヤソ会": "الرَهْبَنة اليَسُوعِيّة, جَماعة يَسُوع",
 "ヤソ教": "مَسِيحِيَّة, نَصْرَانِيَّة (مؤنث المَسِيْحِيّ؛ المنسوبة إلى المَسِيْح؛ هي الدِيْن الذي يدين به المَسِيْحِيُّوْن؛ النَصْرَانِيَّة)\nمثال: اعتنق المسيحية.",
 "ヤタガラス": "ثُلَاثِيّ الأَرْجُل (لَهُ ثَلاث أَرْجُل أَوْ ما يُشْبِهُها)",
 "ヤタガン": "سيف تركي, ياتاجان (سكين تركي طويل ذو نصل منحني وحافة واحدة)",
 "ヤダ": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / نَعَم (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…) / لَا, لَاءَان (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة. / يَع",
 "ヤッケ": "باركا, سترة واقية (نوع من السترات الثقيلة)",
 "ヤッタ": "مرحى, هتاف النصر (هتاف النصر)\nمثال: دعونا نعطي الفريق هتافاً كبيراً",
 "ヤッター": "مرحى, هتاف النصر (هتاف النصر)\nمثال: دعونا نعطي الفريق هتافاً كبيراً",
 "ヤッピー": "شاب مهني طموح, يابي (شاب محترف صاعد اجتماعياً؛ مهني من الطبقة المتوسطة يتقاضى أجراً جيداً ويعمل في المدينة ولديه أسلوب حياة فاخر)",
 "ヤップ州": "بوز, فم (مصطلحات عامية للفم)",
 "ヤッホー": "صيحة تنبيه (صيحة لجذب الانتباه)\nمثال: أطلق صيحة عالية لكن لم يسمعه أحد",
 "ヤツ": "حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة) / رجل, رفيق (صبي أو رجل) / زَمِيل (شخص عضو في نفس مهنة أو طبقة الشخص الآخر) / رفيق, زميل (صديق يتواجد كثيراً بصحبة آخر)\nمثال: لو علمت أنه حبيبها لما سألت / شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما. / هُوَ",
 "ヤツら": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم\nمثال: هن يحببن الجاز.",
 "ヤツバキクイムシ": "خنفساء لحاء التنوب (خنفساء صغيرة تحب الحفر عبر لحاء أشجار التنوب وأكل الكامبيوم مما يقتل الشجرة في النهاية)",
 "ヤツメウナギ": "جلكى (دائريات فم بدائية تشبه الثعبان تعيش في المياه العذبة أو مهاجرة لها فم ماص مستدير بلسان كاشط)",
 "ヤドカリ": "سرطان ناسك (قشريات بحرية صغيرة ناعمة الجسم تعيش في أصداف بطنيات القدم المهجورة) / مُسْتَأْجِر",
 "ヤドリギツグミ": "سمنة الدبق (سمنة أوروبية كبيرة تتغذى على توت الدبق)",
 "ヤドリバエ": "ذبابة تاشينا (ذبابة شائكة تعيش يرقاتها بشكل طفيلي في اليرقات والحشرات الأخرى؛ مهمة في مكافحة الحشرات الضارة)",
 "ヤナギ": "صَفْصَاف, غَرَب / صفصاف بابلي, صفصاف باكي (صفصاف ذو فروع طويلة متدلية وأوراق رفيعة موطنه الصين؛ يزرع على نطاق واسع كنبات زينة)",
 "ヤナギラン": "دفلية, ردندرة عظمى (ردندرة تزهر في أواخر الربيع من شرق أمريكا الشمالية لها زهور وردية إلى وردية أرجوانية)",
 "ヤニ": "رَاتِينَج, صُرْع / قَطْرَان (قَطِرَان: مادة سوداء سائلة لزجة القوام) / نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة.",
 "ヤニる": "دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة.",
 "ヤニサシガメ": "بق قاتل (بق حقيقي: بق مفترس طويل الأرجل يعيش غالباً على الحشرات الأخرى؛ وعدد قليل منها يمتص دماء الثدييات)",
 "ヤヌス": "يَانُوس",
 "ヤハウェ": "يَهْوَه",
 "ヤハズエンドウ": "وَزْن فَارِغ",
 "ヤバい": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / فَظِيع, أَرْبَد / مُرْعِب, مُفْزِع (يسبب رعباً شديداً بالغاً) / رَهِيب, هَائِل (عَظِيمٌ جِدًّا أَوْ بَالِغُ الشِّدَّة) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف) / مَجْنُون, مَخْبُول",
 "ヤバめ": "بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "ヤバイ": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / فَظِيع, أَرْبَد / مُرْعِب, مُفْزِع (يسبب رعباً شديداً بالغاً) / رَهِيب, هَائِل (عَظِيمٌ جِدًّا أَوْ بَالِغُ الشِّدَّة) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف) / مَجْنُون, مَخْبُول",
 "ヤバス": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / فَظِيع, أَرْبَد / مُرْعِب, مُفْزِع (يسبب رعباً شديداً بالغاً) / رَهِيب, هَائِل (عَظِيمٌ جِدًّا أَوْ بَالِغُ الشِّدَّة) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف)",
 "ヤフる": "طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا.",
 "ヤフー": "يَاهُو!, يَاهُو",
 "ヤブ": "بَطْبَطَة, زَبْط / زَبَطَ",
 "ヤブノウサギ": "أرنب بري أوروبي (أرنب بري كبير أُدخل في أمريكا الشمالية؛ لا يتحول إلى الأبيض في الشتاء)",
 "ヤブラン": "بيج بلو (قنبلة متشظية موثوقة وفتاكة تزن 15000 رطل تنفجر فوق الأرض مباشرة بنصف قطر كبير؛ وهي أكبر قنبلة تقليدية موجودة؛ استخدمت في أفغانستان)",
 "ヤブ医者": "بَطْبَطَة, زَبْط / زَبَطَ",
 "ヤベー": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "ヤペテ": "يَافَث",
 "ヤボ": "غَلِيظٌ, فَظٌّ (سيئ السلوك وخشن ومحتقر في التصرف أو المظهر)",
 "ヤポンスキー": "يَابَانِيّ",
 "ヤマ": "جَبَل (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين) / طُور\nمثال: منزلي في الجبل. / لِي, لي / مَنْجَم, لَغَم / لَغْم, لَغَم / لَغَمَ / غَابَة, غابة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة / كَوْمَة",
 "ヤマアラシ": "نَيْص, دُلْدُل",
 "ヤマアリ": "نمل الخشب (نمل أوروبي بني محمر يعيش عادة في تلال النمل في الغابات)",
 "ヤマイタチ": "قاقم (حيوان القاقم في معطفه الصيفي البني مع ذيل أسود الطرف)",
 "ヤマイヌ": "كلب بري (أي من ثدييات متنوعة غير مستأنسة من فصيلة الكلبيات يُعتقد أنها تشبه الكلاب المستأنسة لتمييزها عن ابن آوى أو الذئاب)",
 "ヤマウズラ": "حَجَل, قبج (طَائِرٌ مِنْ فَصيلَةِ التَّدْرُجِيَّاتِ، مِنْ رُتْبَةِ الدَّجاجِيّاتِ، رَمادِيُّ اللَّوْنِ، أَحْمَرُ المِنْقارِ والسَّاقَيْنِ…؛ حَجَلُ: الذَّكَرُ من القَبَجِ، الواحدةُ: حَجَلَةٌ)\nمثال: إن الإسم \"سكورة\" مشتق من كلمة \"تاسكورت\" الذي يعني حجلة بالأمازيغية.",
 "ヤマウルシ": "شجرة اللك, شجرة الورنيش (شجرة آسيوية صغيرة تفرز مادة سامة يتم الحصول منها على اللك (الورنيش))",
 "ヤマカン": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "ヤマグルマ": "شجرة العجلة, شجرة عجلة النار (شجرة من شرق أستراليا تزرع على نطاق واسع كشجرة ظل ولأوراقها اللامعة وعناقيدها الدائرية من الزهور الحمراء إلى البرتقالية القرمزية المبهرجة)",
 "ヤマゲラ": "أَشْيَب, شَائِب (يُظهِر علامات الشيخوخة خاصّة الشعر الأبيض أو الرماديّ)",
 "ヤマシギ": "دجاجة الأرض الأوراسية (دجاجة أرض مهاجرة من العالم القديم قصيرة الساقين وطويلة المنقار)",
 "ヤマシマウマ": "حمار الزرد الجبلي (حمار زرد ضيق الخطوط شبه منقرض يعيش في جنوب أفريقيا)",
 "ヤマナシ": "يَامَانَاشِي",
 "ヤマニレ": "دردار صيني (شجرة صغيرة سريعة النمو موطنها آسيا؛ تزرع على نطاق واسع كمصدات رياح وتحوطات) / دردار سيبيري (شجرة آسيوية شجيرية سريعة النمو توطنت في الولايات المتحدة للمأوى أو الزينة)",
 "ヤマネコ": "ضَيْوَن",
 "ヤマネズミ": "جرذ الأرض, مرموط خنزيري (مرموط بني محمر من أمريكا الشمالية)",
 "ヤマハハコ": "أناغاليس لؤلؤي (نبات خالد أمريكي له أوراق بشعيرات صوفية ناعمة ورؤوس عذقية بقنابات بيضاء لؤلؤية)",
 "ヤマビーバー": "قندس الجبل (قارض ليلي ضخم يحفر الجحور في مرتفعات ساحل المحيط الهادئ لأمريكا الشمالية؛ وهو أكثر القوارض الحية بدائية)",
 "ヤマフジ": "ستارية حريرية, ويستيريا حريرية (ستارية من الصين لها زهور بيضاء)",
 "ヤマブキ": "كَهْرَمَان (عَلَك أُحْفُوْرِيّ افرزته اشجار من المخروطيات نبتت في عصور جيولوجية قديمة، وقد يقال قَهْرَمَان) / كَهْرَمَانِيّ",
 "ヤマブキベラ": "أَصْفَر بُنِّيّ, كَهْرَمَانِيّ (ذو لون أصفر بنّيّ متوسّط إلى داكن)",
 "ヤママユ": "بلوط ياباني (شجرة صغيرة دائمة الخضرة من الصين والياباني) / بلوط منغولي, بلوط ياباني (بلوط بخشب ناعم الحبيبات خفيف معتدلاً؛ اليابان)",
 "ヤママユガ": "بلوط ياباني (شجرة صغيرة دائمة الخضرة من الصين والياباني) / بلوط منغولي, بلوط ياباني (بلوط بخشب ناعم الحبيبات خفيف معتدلاً؛ اليابان)",
 "ヤマモモ": "آس شمعي (نوع نباتي من جنس الآس من الفَصِيلَة الآسيّة. وهو شجر دائم الخُضْرَة، بيضيّ الورق، أبيض الزَّهْر أو ورديُّه، يُزرع للتزيين ولرائحته العِطْريّة…؛ ورقة من أوراق اللعب ذات نقطة أو علامة واحدة)\nمثال: لدي الآس الكوبا.",
 "ヤマ場": "ذروة جنسية, رعشة الجماع (لحظة أقصى متعة أثناء الاتصال الجنسي) / تتويج, ذروة (اللحظة الحاسمة في رواية أو مسرحية) / تصاعد, ذروة (ترتيب الجمل بترتيب تصاعدي من حيث القوة) / ذروة, قمة (أعلى نقطة لأي شيء يتصور أنه ينمو أو يتطور أو يتكشف)\nمثال: مشهد فراش الموت هو ذروة المسرحية",
 "ヤミきん": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "ヤミきんゆう": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "ヤミ市": "سُوق سَوْدَاء (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "ヤミ米": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "ヤミ金": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "ヤミ金融": "مُحَرَّم, مُهَرَّب (مُنْتَج أَوْ مُتاجَر بِهِ بِشَكْل غَيْر قانونِيّ)",
 "ヤム": "يَام",
 "ヤムスクロ": "يَامُوسُوكْرُو",
 "ヤモリ": "وَزَغَة",
 "ヤリだま": "ضَحِيَّة / أُضْحِيَّة",
 "ヤリコン": "لقاء مع غريب, موعد مدبر (موعد غرامي مع شخص غريب) / رفيق موعد أعمى (مشارك في موعد أعمى (شخص تقابله لأول مرة في موعد))\nمثال: هي لا تذهب أبداً في مواعيد مدبرة",
 "ヤリチン": "مُسْتَهْتَر",
 "ヤリマン": "عَاهِرَة (امرأة تتاجر بجسدها؛ امرأة تقدم خدمات جنسية بمقابل مادي)\nمثال: قتل سامي عاهرة.",
 "ヤリ捨て": "انقطاع, قطع مفاجئ (حالة من المقاطعة المفاجئة)",
 "ヤリ玉": "ضَحِيَّة / أُضْحِيَّة",
 "ヤリ逃げ": "انقطاع, قطع مفاجئ (حالة من المقاطعة المفاجئة)",
 "ヤル気": "إرَادَة / رَغْبَة, إرَادَة",
 "ヤレ": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة. / إفساد, تخريب (فعل إفساد الشيء عن طريق إلحاق الضرر به) / تلف, فساد (عملية التحول إلى شيء تالف أو فاسد) / الفاسد, تلف (الكمية التي فسدت)\nمثال: كان إفسادها لثوبي متعمداً",
 "ヤロスラヴリ": "يَارُوسْلَافْل",
 "ヤワ": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "ヤワヤワ": "بصوت خافت, بهدوء (بحجم صوت منخفض) / بخفة, برفق (بقليل من الوزن أو القوة) / بشكل خافت, بنعومة (توجيه في الموسيقى؛ للعزف بنعومة وهدوء نسبي) / برقة, بنعومة (بطريقة ترضي الحواس)\nمثال: تحدث بهدوء ولكن احمل عصا غليظة / بلطف, تدريجياً (بشكل تدريجي) / برفق, بلطف (بطريقة لطيفة)\nمثال: قبلته بخفة على جبينه",
 "ヤンキー": "مُتَأَخِّر, مُنْقَضِي الأَجَل (تجاوز موعد استحقاقه ولم يُسدَّد في الوقت المحدّد) / مُقَصِّر, مُهْمِل (يُخِلّ بِمَا يَقْتَضِيه الوَاجِب) / جَانِح, مُخَالِف (مذنب بارتكاب مخالفة أو جُنحة) / جانح, حدث جانح (مذنب شاب) / يَانْكِي",
 "ヤンキーすわり": "قرفصاء (فعل اتخاذ أو الحفاظ على وضعية الانحناء مع ثني الركبتين والأرداف بالقرب من الكعبين) / القرفصاء, سكوات (تمرين عن طريق اتخاذ وضعية الانحناء مع ثني الركبتين بشكل متكرر؛ يقوي عضلات الساق)",
 "ヤンキーずわり": "قرفصاء (فعل اتخاذ أو الحفاظ على وضعية الانحناء مع ثني الركبتين والأرداف بالقرب من الكعبين) / القرفصاء, سكوات (تمرين عن طريق اتخاذ وضعية الانحناء مع ثني الركبتين بشكل متكرر؛ يقوي عضلات الساق)",
 "ヤンキース": "يَانْكِي",
 "ヤンキー座り": "قرفصاء (فعل اتخاذ أو الحفاظ على وضعية الانحناء مع ثني الركبتين والأرداف بالقرب من الكعبين) / القرفصاء, سكوات (تمرين عن طريق اتخاذ وضعية الانحناء مع ثني الركبتين بشكل متكرر؛ يقوي عضلات الساق)",
 "ヤング": "صَغِير, حَدَث / شَبَاب / شَبَاب, صِبًا / شَابّ",
 "ヤングりつ": "مُعَامِل يُونْغ (معامل مرونة ينطبق على تمدد سلك)",
 "ヤングスタ": "صغير, طفل (شخص صغير السن من أي من الجنسين)\nمثال: هي تكتب كتباً للأطفال",
 "ヤングスター": "صغير, طفل (شخص صغير السن من أي من الجنسين)\nمثال: هي تكتب كتباً للأطفال",
 "ヤングマン": "شاب (مراهق أو شاب بالغ ذكر)",
 "ヤングレディー": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "ヤング・マン": "شاب (مراهق أو شاب بالغ ذكر)",
 "ヤング・レディー": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "ヤング率": "مُعَامِل يُونْغ (معامل مرونة ينطبق على تمدد سلك)",
 "ヤンゴン": "يَانْغُون, يَانْجُون",
 "ヤンチャ": "غَيْر مُطِيع, شَقِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / مُشَاغِب / انحراف الأحداث, جنوح (سلوك معاد للمجتمع ينتهك القانون يرتكبه قاصر) / إهمال, جنوح (الميل للإهمال وعدم الاكتراث) / تأخر في السداد, جنحة مالية (عدم سداد دين عند استحقاقه)\nمثال: ورث جنوحه عن أبيه / جَرِيء, جَسُور",
 "ヤンチョ": "رِيكْشَا",
 "ヤンデレ": "يَانْدِرِي",
 "ヤンピー": "حَوَر (حَوَّرَ (الدقيقَ أو الثوبَ): بيَّضَه؛ حَوَّرَ (الأديمَ): صبغه بحُمرة)",
 "ヤンマ": "عَوِيل, نَائِح (يعبّر بصوته عن الحزن والأسى أو يشبه هذا التعبير) / رتّاء (شخص يصلح (الملابس) بالرتق) / يَعْسُوب",
 "ヤンマー": "جهاز تشويش (جهاز إرسال يستخدم لبث التشويش الإلكتروني)",
 "ヤー": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "ヤーこう": "يَاكُوزَا",
 "ヤーさん": "يَاكُوزَا",
 "ヤーイ": "يَاه, اسمع / هَلَا",
 "ヤーウェ": "يَهْوَه",
 "ヤーダ": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / نَعَم (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…) / لَا, لَاءَان (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة. / يَع",
 "ヤーデージ": "مَسَافَة بِاليَارْدَة (المسافة المقاسة بالعدد الإجمالي للياردات)\nمثال: ما هي المسافة بالياردة لملعب الغولف هذا؟",
 "ヤード": "حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / يَارْدَة / يَارْد\nمثال: ليس لدينا حديقة. / حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / يَارْدَة / يَارْد\nمثال: ليس لدينا حديقة. / ساحة تجميع القطارات (ساحة سكة حديد يتم فيها تجميع القطارات وتحميل البضائع)",
 "ヤードスティック": "مسطرة ياردة (مسطرة أو شريط قياس طوله ثلاثة أقدام) / معيار, مقياس (مقياس أو معيار يستخدم للمقارنة)\nمثال: على أي نوع من المقاييس يبني حكمه؟",
 "ヤードセール": "بيع المرآب, بيع منزلي (بيع في الهواء الطلق للأغراض الشخصية أو المنزلية المستعملة يقام في مبنى البائع)",
 "ヤード・セール": "بيع المرآب, بيع منزلي (بيع في الهواء الطلق للأغراض الشخصية أو المنزلية المستعملة يقام في مبنى البائع)",
 "ヤーヌス": "يَانُوس",
 "ヤーパン": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "ヤーヤー": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات. / يَاه, اسمع / هَلَا / وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة!",
 "ヤール": "حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / يَارْدَة / يَارْد\nمثال: ليس لدينا حديقة.",
 "ヤールド": "حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / يَارْدَة / يَارْد\nمثال: ليس لدينا حديقة.",
 "ヤーン": "خَيْط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه)\nمثال: حل الصرة تلقى خيط.",
 "ヤーヴェ": "يَهْوَه",
 "ヤー公": "يَاكُوزَا",
 "ユアセルフ": "نفسكَ, نفسكِ",
 "ユアン": "يُوَان",
 "ユウガオ": "قرع القنينة, يقطين (نبات متسلق من العالم القديم ذو ثمار قرعية صلبة القشرة تشبه الزجاجة) / أثمان أبيض, زهرة القمر (متسلق استوائي شامل له زهور ليلية بيضاء عطرة)",
 "ユウゼン": "حديد مطاوع (حديد يحتوي على نسبة منخفضة من الكربون وهو متين وقابل للطرق وبالتالي يمكن تشكيله ولحامه)",
 "ユウダ": "ثعبان الماء (أي من ثعابين متنوعة غير ضارة في الغالب تعيش في الماء أو بالقرب منه)",
 "ユウティアオ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "ユウトピア": "طُوبَائِيَّة, مَدِينَةٌ فَاضِلَة",
 "ユウル": "الكريسماس, عيد الميلاد (الفترة الممتدة من 24 ديسمبر إلى 6 يناير)",
 "ユウレイグモ": "أوبليون, حاصد (عنكبوتي يشبه العنكبوت بجسم مستدير صغير وأرجل رفيعة طويلة جداً)",
 "ユウロピウム": "يُورُوبِّيُوم / أُورُوبِّيُوم",
 "ユカタン州": "وِلَايَة يُوكَاتَان (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى)",
 "ユカン": "برقوق كرزي, ميروبالان (شجرة آسيوية صغيرة تحمل فاكهة حمراء أو صفراء صالحة للأكل)",
 "ユキダルマ": "إِنْسَان ثَلْجِيّ, تِمْثَال ثَلْجِيّ (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق.",
 "ユキノシタ": "غرنوقي الفراولة, كاسر الحجر المتدلي (كاسر حجر آسيوي شرقي بعناقيد من الزهور الحمراء والبيضاء الصغيرة؛ ينتشر عن طريق العديد من السيقان الزاحفة)",
 "ユキヒョウ": "نِمْر اَلثُّلُوج (النّمر: حيوان مرقّط يُشبه الأَسَد؛ النّمر: لونه أنمر، وفيه نُمر حمراء أو بيضاء وسوداء)\nمثال: دخل نمر مخيمنا.",
 "ユキホオジロ": "درسة الثلج (طائر درسة قطبي أبيض)",
 "ユキワリソウ": "ماركانتيا بوليمورفا, هيباتيكا (حشيشة كبد شائعة) / حشيشة الكبد, هيباتيكا (أي من عدة نباتات من جنس هيباتيكا ذات أوراق ثلاثية الفصوص وأزهار بيضاء أو وردية في أوائل الربيع؛ توجد في مناطق الغابات الرطبة والمغطاة بالطحالب في…) / بَانُورَامِيّ, مِنْ عَلُوّ (كما يُرى من ارتفاع أو مسافة بعيدة)",
 "ユジノサハリンスク": "يوجنو-ساخالينسك",
