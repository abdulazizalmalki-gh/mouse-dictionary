 "ラーニング・ディスアビリティー": "اضطراب التعلم, صعوبات التعلم (اضطراب يوجد لدى الأطفال ذوي الذكاء الطبيعي الذين يواجهون صعوبات في تعلم مهارات محددة)",
 "ラーバ": "حُمَم بُرْكَانِيَّة, لَابَة (الماء: سَخَّنَه؛ الغلام: بدت لحيته)",
 "ラーメン": "رَامِن, رَامَن",
 "ラ式蹴球": "رَغْبِي, رَجْبِي",
 "ラ米": "أَمْرِيكَا اَللَّاتِينِيَّة",
 "ラ語": "لَاتِينِيّ, الرُّومِيَّة (المنسوب إلى لَاتِيْن، وهي المنطقة المحيطة بمدينة روما والتي كان الروم يسمونها لاتين وأصبح اسمها الآن لَازِيَوْ؛ المنسوب إلى اللاتين، وهم دول أمريكا الجنوبية والوسطى الذين يتحدثون لغات من أصل لاتيني، خصوصا الإسبانية والبرتغالية) / لَاتِينِيّ, الرُّومِيّ (المنسوب إلى لَاتِيْن، وهي المنطقة المحيطة بمدينة روما والتي كان الروم يسمونها لاتين وأصبح اسمها الآن لَازِيَوْ؛ المنسوب إلى اللاتين، وهم دول أمريكا الجنوبية والوسطى الذين يتحدثون لغات من أصل لاتيني، خصوصا الإسبانية والبرتغالية)\nمثال: العديد من الكلمات الإنجليزية أصلها لاتيني.",
 "ラ音": "كراكر",
 "リア": "خَلْفِيّ",
 "リアウインドー": "نافذة خلفية (نافذة سيارة تسمح بالرؤية من الجزء الخلفي للسيارة)",
 "リアクション": "رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / تَفَاعُل (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)\nمثال: اليوم هناك برد.",
 "リアクションをとる": "أَجَابَ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا.",
 "リアクションを取る": "أَجَابَ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا.",
 "リアクタンス": "مفاعلة (ممانعة لتدفق التيار الكهربائي ناتجة عن الحث والسعة (بدلاً من المقاومة))",
 "リアクター": "مُفَاعِل",
 "リアクトル": "مُفَاعِل",
 "リアタイ": "زَمَن حَقِيقِيّ",
 "リアトリス": "ريشة غاي, ليآتريس (أي من نباتات أمريكا الشمالية المتنوعة من جنس ليآتريس ذات نورات عنقودية أو عثكولية من رؤوس الزهور القرصية الصغيرة) / نجمة ساطعة (نبات ثنائي الحول من جنوب غرب الولايات المتحدة له سيقان بيضاء وأوراق مسننة يُزرع لزهوره الصفراء الشاحبة الكبيرة التي تتفتح في الصباح الباكر)",
 "リアライズ": "حَقَّقَ (حَقَّقَ (الأمرَ): أثبتَه وصدَّقَه؛ ويقال: حَقَّقَ الظنَّ، وحَقَّقَ القولَ والقضيّةَ؛ حَقَّقَ (الشيءَ والأمرَ): أحكمه؛ ويقال: حَقَّقَ الثوبَ: أحكم نَسْجَه)\nمثال: و أخيرا حقق هدفه.",
 "リアリスティック": "واقعي (مدرك أو يعبر عن إدراك للأشياء كما هي حقاً) / طَبِيعِيّ, وَاقِعِيّ (يمثل الواقع كما هو؛ ليس تجريدياً أو مثالياً) / واقعي (مكون من أو متعلق بالمذهب الفلسفي للواقعية)\nمثال: وصف واقعي",
 "リアリスト": "وَاقِعِيّ",
 "リアリズム": "بَرَاغْمَاتِيَّة, وَاقِعِيَّة (سمة قبول حقائق الحياة وتفضيل العملية والحقيقة الحرفية) / أفلاطونية, واقعية ((فلسفة) المذهب الفلسفي القائل بأن المفاهيم المجردة توجد مستقلة عن أسمائها) / واقعية, واقعية ساذجة ((فلسفة) المذهب الفلسفي القائل بأن الأشياء المادية تستمر في الوجود عندما لا يتم إدراكها) / الطبيعية, الواقعية (حركة فنية في فرنسا في القرن التاسع عشر؛ سعى الفنانون والكتاب للحصول على وصف واقعي وواقعي مفصل)",
 "リアリティ": "وَاقِع, حَقِيقَة (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة) / وَاقِع (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة)\nمثال: أنا واقع في حبك",
 "リアリティばんぐみ": "تِلِفِزْيُون الْوَاقِع (تِلْفَاز)\nمثال: لنشاهد التلفزيون.",
