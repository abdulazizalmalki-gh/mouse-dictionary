 "リース": "عقد إيجار (عقد يمنح استخدام أو شغل الممتلكات خلال وقت محدد مقابل مبلغ محدد) / عين مؤجرة, مأجور (الممتلكات التي يتم تأجيرها أو إكراؤها) / مدة الإيجار, مدة العقد (الفترة الزمنية التي يكون خلالها عقد نقل الممتلكات إلى شخص ما ساري المفعول) / إِكْلِيل",
 "リースナブル": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "リースリング": "ريسلينغ (نبيذ أبيض جاف عطري أو حلو من وادي الراين أو نبيذ مماثل من كاليفورنيا) / ريسلينغ (عنب أبيض يزرع في أوروبا وكاليفورنيا)",
 "リーズナブル": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "リーズン": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "リーゼント": "تَسْرِيحَة بُومْبَادُور (تصفيفة شعر يسرح فيها الشعر الأمامي للأعلى بعيداً عن الجبهة)",
 "リーダ": "قَائِد, زَعِيم\nمثال: 日本は世界のハイテク産業のリーダーだ。 — تعتبر اليابان الدولة الرائدة عالميا في صناعة التكنولوجيا المتقدمة. / قادة, قيادة (هيئة الأشخاص الذين يقودون مجموعة)\nمثال: تبنت القيادة الوطنية خطته / قَارِئ, قَارِئَة / قَارِئ",
 "リーダビリティ": "مَقْرُوئِيَّة, وُضُوح الخَطّ (صفة الكتابة (المطبوعة أو اليدوية) التي يمكن قراءتها بسهولة) / سَلَاسَة القِرَاءَة, سُهُولَة القِرَاءَة (صفة اللغة المكتوبة التي تجعلها سهلة القراءة والفهم)",
 "リーダビリティー": "مَقْرُوئِيَّة, وُضُوح الخَطّ (صفة الكتابة (المطبوعة أو اليدوية) التي يمكن قراءتها بسهولة) / سَلَاسَة القِرَاءَة, سُهُولَة القِرَاءَة (صفة اللغة المكتوبة التي تجعلها سهلة القراءة والفهم)",
 "リーダブル": "قَابِل لِلْقِرَاءَة, مَقْرُوء (يُمْكِن قِراءَتُهُ وَفَهْمُه بِسُهولَة)",
 "リーダー": "قَائِد, زَعِيم\nمثال: 日本は世界のハイテク産業のリーダーだ。 — تعتبر اليابان الدولة الرائدة عالميا في صناعة التكنولوجيا المتقدمة. / قادة, قيادة (هيئة الأشخاص الذين يقودون مجموعة)\nمثال: تبنت القيادة الوطنية خطته / قَارِئ, قَارِئَة / قَارِئ",
 "リーダーかく": "قَائِد, زَعِيم",
 "リーダーシップ": "قِيَادَة",
 "リーダー格": "قَائِد, زَعِيم",
 "リーチ": "بَلَغَ / عَلَق",
 "リーチャブル": "سَهْل المُقَارَبَة, يَسْهُل الوُصُول إِلَيْه (يسهل الاقتراب منه أو الوصول إليه)",
 "リーディング": "قِرَاءَة / رَائِد, قِيَادِيّ (يذهب أو يتقدم في المقدمة؛ يظهر الطريق) / قيادة (نشاط القيادة) / فِي المُقَدِّمَة, مُتَصَدِّر (يَحْتَلُّ المَرْكَزَ الأَوَّلَ أَوْ لَدَيْهِ النَّتِيجَةُ الأَعْلَى فِي مُنَافَسَة) / شريحة رصاص, فاصد (شريط رفيع من المعدن يستخدم لفصل خطوط الحروف في الطباعة)\nمثال: ركبنا في السيارة المتقدمة",
 "リート": "ليد (أغنية فنية ألمانية من القرن التاسع عشر للصوت والبيانو) / ريت, صندوق الاستثمار العقاري (صندوق استثمار يمتلك ويدير مجموعة من العقارات التجارية والرهون العقارية وأصول عقارية أخرى؛ ويمكن شراء وبيع أسهمه في سوق الأوراق المالية)",
 "リード": "ليد (أغنية فنية ألمانية من القرن التاسع عشر للصوت والبيانو) / رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه) / رَائِد, قِيَادِيّ (يذهب أو يتقدم في المقدمة؛ يظهر الطريق) / قيادة (نشاط القيادة) / فِي المُقَدِّمَة, مُتَصَدِّر (يَحْتَلُّ المَرْكَزَ الأَوَّلَ أَوْ لَدَيْهِ النَّتِيجَةُ الأَعْلَى فِي مُنَافَسَة) / شريحة رصاص, فاصد (شريط رفيع من المعدن يستخدم لفصل خطوط الحروف في الطباعة)\nمثال: ركبنا في السيارة المتقدمة / رِبَاط / قَصَبَة, بُوصَة / قِرَاءَة",
 "リードがっき": "آلة ذات ريشة, آلة قصبية (آلة موسيقية تصدر صوتاً عن طريق قصبة مهتزة)",
 "リードせん": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
 "リードイン": "سلك التوصيل (سلك يربط هوائياً بجهاز استقبال أو جهاز إرسال بخط نقل) / استهلال, مقدمة (القسم التمهيدي لقصة (صحفية))\nمثال: كانت مقدمة مسلية لموضوع خطير للغاية",
 "リードオルガン": "أرغن القصب, هارمونيوم (آلة ذات قصبات حرة مع لوحة مفاتيح بيانو يتم فيها دفع الهواء عبر القصبات بواسطة منفاخ)",
