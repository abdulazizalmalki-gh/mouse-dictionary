 "ヤスリ目": "أسنان, نظام الأسنان (نوع وعدد وترتيب الأسنان (مجتمعة) في شخص أو حيوان)",
 "ヤズィーディーきょう": "الإيزيدية",
 "ヤズィーディー教": "الإيزيدية",
 "ヤズディきょう": "الإيزيدية",
 "ヤズディ教": "الإيزيدية",
 "ヤセの大食い": "نحيل, هزيل (شخص نحيف وهزيل بشكل غير عادي)",
 "ヤセザル": "لانغور (قرد آسيوي نحيل طويل الذيل)",
 "ヤソ": "عِيسَى ((في الإسلام) عيسى بن مريم، نبي أُرسل إلى بني إسرائيل؛ آتاه الله الإنجيل، وورد…)\nمثال: كان عيسى يهوديا. / مَسِيحِيَّة, نَصْرَانِيَّة (مؤنث المَسِيْحِيّ؛ المنسوبة إلى المَسِيْح؛ هي الدِيْن الذي يدين به…)\nمثال: اعتنق المسيحية.",
 "ヤソかい": "الرَهْبَنة اليَسُوعِيّة, جَماعة يَسُوع",
 "ヤソきょう": "مَسِيحِيَّة, نَصْرَانِيَّة (مؤنث المَسِيْحِيّ؛ المنسوبة إلى المَسِيْح؛ هي الدِيْن الذي يدين به…)\nمثال: اعتنق المسيحية.",
 "ヤソ会": "الرَهْبَنة اليَسُوعِيّة, جَماعة يَسُوع",
 "ヤソ教": "مَسِيحِيَّة, نَصْرَانِيَّة (مؤنث المَسِيْحِيّ؛ المنسوبة إلى المَسِيْح؛ هي الدِيْن الذي يدين به…)\nمثال: اعتنق المسيحية.",
 "ヤタガラス": "ثُلَاثِيّ الأَرْجُل (لَهُ ثَلاث أَرْجُل أَوْ ما يُشْبِهُها)",
 "ヤタガン": "سيف تركي, ياتاجان (سكين تركي طويل ذو نصل منحني وحافة واحدة)",
 "ヤダ": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة. / يَع",
 "ヤッケ": "باركا, سترة واقية (نوع من السترات الثقيلة)",
 "ヤッタ": "مرحى, هتاف النصر (هتاف النصر)\nمثال: دعونا نعطي الفريق هتافاً كبيراً",
 "ヤッター": "مرحى, هتاف النصر (هتاف النصر)\nمثال: دعونا نعطي الفريق هتافاً كبيراً",
 "ヤッピー": "شاب مهني طموح, يابي (شاب محترف صاعد اجتماعياً؛ مهني من الطبقة المتوسطة يتقاضى أجراً جيداً ويعمل في…)",
 "ヤップ州": "بوز, فم (مصطلحات عامية للفم)",
 "ヤッホー": "صيحة تنبيه (صيحة لجذب الانتباه)\nمثال: أطلق صيحة عالية لكن لم يسمعه أحد",
 "ヤツ": "حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة)\nمثال: لو علمت أنه حبيبها لما سألت / شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء…)\nمثال: في يدها شيء ما. / هُوَ",
 "ヤツら": "هُمَا\nمثال: هن يحببن الجاز.",
 "ヤツバキクイムシ": "خنفساء لحاء التنوب (خنفساء صغيرة تحب الحفر عبر لحاء أشجار التنوب وأكل الكامبيوم مما يقتل الشجرة في…)",
 "ヤツメウナギ": "جلكى (دائريات فم بدائية تشبه الثعبان تعيش في المياه العذبة أو مهاجرة لها فم ماص…)",
 "ヤドカリ": "سرطان ناسك (قشريات بحرية صغيرة ناعمة الجسم تعيش في أصداف بطنيات القدم المهجورة) / مُسْتَأْجِر",
 "ヤドリギツグミ": "سمنة الدبق (سمنة أوروبية كبيرة تتغذى على توت الدبق)",
 "ヤドリバエ": "ذبابة تاشينا (ذبابة شائكة تعيش يرقاتها بشكل طفيلي في اليرقات والحشرات الأخرى؛ مهمة في مكافحة…)",
 "ヤナギ": "صَفْصَاف, غَرَب / صفصاف بابلي, صفصاف باكي (صفصاف ذو فروع طويلة متدلية وأوراق رفيعة موطنه الصين؛ يزرع على نطاق واسع كنبات…)",
 "ヤナギラン": "دفلية, ردندرة عظمى (ردندرة تزهر في أواخر الربيع من شرق أمريكا الشمالية لها زهور وردية إلى وردية…)",
 "ヤニ": "رَاتِينَج, صُرْع / قَطْرَان (قَطِرَان: مادة سوداء سائلة لزجة القوام) / نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة.",
 "ヤニる": "دُخَان, دخان\nمثال: دخن زيري سيجارة.",
 "ヤニサシガメ": "بق قاتل (بق حقيقي: بق مفترس طويل الأرجل يعيش غالباً على الحشرات الأخرى؛ وعدد قليل منها…)",
 "ヤヌス": "يَانُوس",
 "ヤハウェ": "يَهْوَه",
 "ヤハズエンドウ": "وَزْن فَارِغ",
 "ヤバい": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / فَظِيع, أَرْبَد / مُرْعِب, مُفْزِع (يسبب رعباً شديداً بالغاً) / مَجْنُون, مَخْبُول",
 "ヤバめ": "بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "ヤバイ": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / فَظِيع, أَرْبَد / مُرْعِب, مُفْزِع (يسبب رعباً شديداً بالغاً) / مَجْنُون, مَخْبُول",
 "ヤバス": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / فَظِيع, أَرْبَد / مُرْعِب, مُفْزِع (يسبب رعباً شديداً بالغاً)",
 "ヤフる": "طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا.",
 "ヤフー": "يَاهُو!, يَاهُو",
 "ヤブ": "بَطْبَطَة, زَبْط",
 "ヤブノウサギ": "أرنب بري أوروبي (أرنب بري كبير أُدخل في أمريكا الشمالية؛ لا يتحول إلى الأبيض في الشتاء)",
 "ヤブラン": "بيج بلو (قنبلة متشظية موثوقة وفتاكة تزن 15000 رطل تنفجر فوق الأرض مباشرة بنصف قطر كبير…)",
 "ヤブ医者": "بَطْبَطَة, زَبْط",
 "ヤベー": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "ヤペテ": "يَافَث",
 "ヤボ": "غَلِيظٌ, فَظٌّ (سيئ السلوك وخشن ومحتقر في التصرف أو المظهر)",
 "ヤポンスキー": "يَابَانِيّ",
 "ヤマ": "جَبَل (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين)\nمثال: منزلي في الجبل. / لِي, لي / غَابَة, غابة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا…)\nمثال: مشينا في الغابة / كَوْمَة",
 "ヤマアラシ": "نَيْص, دُلْدُل",
 "ヤマアリ": "نمل الخشب (نمل أوروبي بني محمر يعيش عادة في تلال النمل في الغابات)",
 "ヤマイタチ": "قاقم (حيوان القاقم في معطفه الصيفي البني مع ذيل أسود الطرف)",
 "ヤマイヌ": "كلب بري (أي من ثدييات متنوعة غير مستأنسة من فصيلة الكلبيات يُعتقد أنها تشبه الكلاب…)",
 "ヤマウズラ": "حَجَل, قبج (طَائِرٌ مِنْ فَصيلَةِ التَّدْرُجِيَّاتِ، مِنْ رُتْبَةِ الدَّجاجِيّاتِ…)\nمثال: إن الإسم \"سكورة\" مشتق من كلمة \"تاسكورت\" الذي يعني حجلة بالأمازيغية.",
 "ヤマウルシ": "شجرة اللك, شجرة الورنيش (شجرة آسيوية صغيرة تفرز مادة سامة يتم الحصول منها على اللك (الورنيش))",
 "ヤマカン": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "ヤマグルマ": "شجرة العجلة, شجرة عجلة النار (شجرة من شرق أستراليا تزرع على نطاق واسع كشجرة ظل ولأوراقها اللامعة وعناقيدها…)",
 "ヤマゲラ": "أَشْيَب, شَائِب (يُظهِر علامات الشيخوخة خاصّة الشعر الأبيض أو الرماديّ)",
 "ヤマシギ": "دجاجة الأرض الأوراسية (دجاجة أرض مهاجرة من العالم القديم قصيرة الساقين وطويلة المنقار)",
