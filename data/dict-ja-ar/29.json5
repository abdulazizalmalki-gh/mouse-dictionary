 "二輪車": "ثنائي العجلات, ذو عجلتين (متعلق بالمركبات ذات العجلتين)\nمثال: عربة ذات عجلتين",
 "二通り": "زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "二連": "ثُنَائِيّ, مِن جُزْأَيْن (يتضمن جزأين أو عنصرين) / ثُنَائِيّ الِانْقِسَام (مُنقسم إلى جزأين يكاد يصل إلى القاعدة)",
 "二連式": "ثُنَائِيّ الاِتِّصَال, مُزْدَوَج (يسمح بالاتصال في اتجاهين متعاكسين في آن واحد) / مُزْدَوَج ((يُستخدم تقنيًّا) ذو جزأين أو مكوّنين) / شقة دوبلكس, شقة طابقين (شقة تحتوي على غرف في طابقين متصلة بواسطة درج) / دوبلكس, منزل مزدوج (منزل بوحدتين تشتركان في جدار مشترك)",
 "二連発": "مُزْدَوَج الغَرَض (له غرضان؛ ذو طبيعة مزدوجة) / ثنائي الماسورة, مزدوج الماسورة (له ماسورتان مثبتتان جنباً إلى جنب)\nمثال: بندقية صيد مزدوجة الماسورة",
 "二連銃": "مُزْدَوَج الغَرَض (له غرضان؛ ذو طبيعة مزدوجة) / ثنائي الماسورة, مزدوج الماسورة (له ماسورتان مثبتتان جنباً إلى جنب)\nمثال: بندقية صيد مزدوجة الماسورة",
 "二週間": "أسبوعان, نصف شهر (فترة أربعة عشر يوماً متتالياً)",
 "二進": "ثُنَائِيّ (يتكوّن من وحدتين أو مكوّنين أو عنصرين) / ثنائي (من أو متعلق بنظام أرقام أساسه 2) / برنامج ثنائي, ملف ثنائي (برنامج مسبق التجميع والربط جاهز للتشغيل تحت نظام تشغيل معين؛ الملف الثنائي لنظام تشغيل ما لن يعمل على نظام مختلف) / نَجْم ثُنَائِيّ, نَجْم مُزْدَوِج (نظام من نجمين يدوران حول بعضهما البعض تحت تأثير جاذبيتهما المتبادلة)\nمثال: رقم ثنائي",
 "二進数": "بِت, رَقَم ثُنَائِيّ (إما 0 أو 1 في التدوين الثنائي)",
 "二進木": "شَجَرَة ثُنَائِيَّة (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "二進法": "النظام الثنائي, نظام العد الثنائي (نظام عد موضعي يستخدم أرقاماً ثنائية وأساساً هو الاثنان)",
 "二遊間": "مُنْتَصَف, وَسَط / وَسَط, مُتَوَسْط",
 "二道": "مُفْتَرَق, تَقَاطُع",
 "二遺伝子雑種": "هجين ثنائي (هجين ناتج عن أبوين يختلفان فقط في موقعين جينيين لهما أليلان لكل منهما)",
 "二部作": "ثُنَائِيّ, مِن جُزْأَيْن (يتضمن جزأين أو عنصرين)",
 "二部合唱": "ثُنَائِيّ, مِن جُزْأَيْن (يتضمن جزأين أو عنصرين)",
 "二部合奏": "ثُنَائِيّ, مِن جُزْأَيْن (يتضمن جزأين أو عنصرين)",
 "二酸化": "ثاني أكسيد (أكسيد يحتوي على ذرتين من الأكسجين في الجزيء)",
 "二酸化ケイ素": "ثاني أكسيد السيليكون, سيليكا",
 "二酸化チタン": "ثاني أكسيد التيتانيوم (مسحوق أبيض يستخدم كصبغة لقدرته العالية على التغطية وقوة تحمله)",
 "二酸化塩素": "ثاني أكسيد الكلور",
 "二酸化炭素": "ثَانِي أُكْسِيد الْكَرْبُون",
 "二酸化珪素": "ثاني أكسيد السيليكون, سيليكا",
 "二酸化硫黄": "ثاني أكسيد الكبريت",
 "二酸化窒素": "ثاني أكسيد النيتروجين",
 "二重": "ثُنَائِيّ / ضِعْف / ذُو حَدَّيْن (قابل للتفسير بطريقتين عادة متناقضتين)",
 "二重あご": "ذِقْن مُزْدَوِج, لُغْد (الجزء الناتىء البارز في أسفل الوجه تحت الفم، وهو منبت اللِحْيَة عند الرَجُل؛ كناية اللِحْيَة)",
 "二重の危険": "خطر مزدوج (محاكمة مدعى عليه لجريمة جنائية سبق محاكمته عليها؛ محظور في التعديل الخامس لدستور الولايات المتحدة)",
 "二重まぶた": "ذُو حَدَّيْن (قابل للتفسير بطريقتين عادة متناقضتين)",
 "二重らせん": "لولب مزدوج (زوج من الحلزونات المتوازية المتشابكة حول محور مشترك)\nمثال: شكل جزيء الحمض النووي هو لولب مزدوج",
 "二重ガラス": "زجاج مزدوج (نافذة بها لوحان من الزجاج ومساحة بينهما؛ تقلل انتقال الحرارة والضوضاء عبر النافذة)",
 "二重スパイ": "عَمِيل مُزْدَوِج (من تُعَامِله ويعاملك في التِجَارَة؛ وكيل التَاجِر في الجِهَات)\nمثال: سامي عميل فدرالي.",
 "二重人格": "انفصام الشخصية, تعدد الشخصيات (اضطراب انشقاقي نادر نسبياً ينهار فيه التكامل المعتاد للشخصية وتظهر شخصيتان مستقلتان أو أكثر)",
 "二重処罰": "خطر مزدوج (محاكمة مدعى عليه لجريمة جنائية سبق محاكمته عليها؛ محظور في التعديل الخامس لدستور الولايات المتحدة)",
 "二重化": "استنساخ, مضاعفة (فعل نسخ أو عمل نسخة (أو نسخ) من شيء ما) / تكرار, نسخة طبق الأصل (نسخة تتوافق مع الأصل تماماً)\nمثال: هذا النوع من الازدواجية هو هدر",
 "二重否定": "نفي مزدوج (نفي غير قياسي نحوياً ولكنه مؤكد) / نفي النفي (إيجاب مبني من نفيين)",
 "二重基準": "كَيْلٌ بِمِكْيالَيْنِ, اِزْدِوَاجِيَّة الْمَعَايِير",
 "二重帝国": "النَّمْسَا وَٱلْمَجَر (دولة في أوروبا الوسطى؛ اسمها الرسمي جمهورية النمسا، وعاصمتها فيينا)\nمثال: النمسا بلد الكناغر.",
 "二重底": "قاع زائف (هيكل أفقي يقسم سفينة أو صندوقاً (خاصةً ذلك المبني بالقرب من القاع الفعلي))",
 "二重引用符": "علامات اقتباس مزدوجة (زوج من علامات الاقتباس)",
 "二重性": "ازْدِوَاجِيَّة, ثَنَوِيَّة ((في الهندسة) قابلية تبادل أدوار النقاط والمستويات في نظريات الهندسة الإسقاطية) / ازدواجية, ازدواجية الموجة والجسيم ((فيزياء) خاصية المادة والإشعاع الكهرومغناطيسي التي تتميز بحقيقة أن بعض الخصائص يمكن تفسيرها بشكل أفضل بنظرية الموجة والبعض الآخر بنظرية الجسيمات) / انقسام ثنائي, ثنائية (كون الشيء ثنائياً؛ تصنيف إلى جزأين أو فئتين فرعيتين متضادتين)\nمثال: الانقسام بين الثقافة الشرقية والغربية",
 "二重抵当": "رهن عقاري ثانٍ (رهن عقاري تابع لرهن عقاري أول)",
 "二重拘束": "مأزق مزدوج, ورطة مزدوجة ((علم النفس) معضلة غير قابلة للحل؛ وضع يتلقى فيه الشخص رسائل متناقضة من شخص ذي نفوذ قوي)",
 "二重整形": "ذُو حَدَّيْن (قابل للتفسير بطريقتين عادة متناقضتين)",
 "二重星": "نَجْم ثُنَائِيّ, نَجْم مُزْدَوِج (نظام من نجمين يدوران حول بعضهما البعض تحت تأثير جاذبيتهما المتبادلة)",
 "二重標準": "كَيْلٌ بِمِكْيالَيْنِ, اِزْدِوَاجِيَّة الْمَعَايِير",
 "二重母音": "مُصَوِّت مُزْدَوِج",
 "二重水素": "ديوتيريوم, هيدروجين ثقيل (نظير للهيدروجين يحتوي على نيوترون واحد (مقارنة بعدم وجود نيوترونات في الهيدروجين العادي))",
 "二重焦点": "ثُنَائِيّ البُؤْرَة (ذو بؤرتين اثنتين)",
 "二重瞼": "ذُو حَدَّيْن (قابل للتفسير بطريقتين عادة متناقضتين)",
 "二重窓": "نافذة واقية (نافذة خارج نافذة عادية للحماية من الطقس القاسي أو الشتاء)",
 "二重窓ガラス": "زجاج مزدوج (نافذة بها لوحان من الزجاج ومساحة بينهما؛ تقلل انتقال الحرارة والضوضاء عبر النافذة)",
 "二重結合": "رابطة ثنائية, رابطة مزدوجة (رابطة تساهمية يتم فيها مشاركة زوجين من الإلكترونات بين ذرتين)",
 "二重結婚": "تَعَدُّد اَلْأَزْوَاج, تَعَدُّد اَلزَّوْجَات",
 "二重螺旋": "لولب مزدوج (زوج من الحلزونات المتوازية المتشابكة حول محور مشترك)\nمثال: شكل جزيء الحمض النووي هو لولب مزدوج",
 "二重規範": "كَيْلٌ بِمِكْيالَيْنِ, اِزْدِوَاجِيَّة الْمَعَايِير",
 "二重身": "شَبِيه",
 "二重通信": "ثُنَائِيّ الاِتِّصَال, مُزْدَوَج (يسمح بالاتصال في اتجاهين متعاكسين في آن واحد) / مُزْدَوَج ((يُستخدم تقنيًّا) ذو جزأين أو مكوّنين) / شقة دوبلكس, شقة طابقين (شقة تحتوي على غرف في طابقين متصلة بواسطة درج) / دوبلكس, منزل مزدوج (منزل بوحدتين تشتركان في جدار مشترك)",
 "二重釜": "حمّام مائي, غلاية مزدوجة (قدران، أحدهما يوضع داخل الآخر)",
 "二重関節": "مُزْدَوَجُ المَفَاصِل (ذُو مَفَاصِلَ مَرِنَةٍ بِشَكْلٍ غَيْرِ اعْتِيَادِيٍّ خَاصَّةً فِي الأَطْرَافِ أَوِ الأَصَابِعِ)",
 "二重音字": "ثنائي الحرف (حرفان متتاليان (خاصة حرفين يستخدمان لتمثيل صوت واحد))",
 "二重顎": "ذِقْن مُزْدَوِج, لُغْد (الجزء الناتىء البارز في أسفل الوجه تحت الفم، وهو منبت اللِحْيَة عند الرَجُل؛ كناية اللِحْيَة)",
 "二量体": "ثنائي الوحدات, دايمر (مركب تتكون جزيئاته من اثنين من المونومرات المتطابقة)",
 "二階": "أعلى الدرج, في الطابق العلوي (في طابق أعلى) / عقلياً, في الرأس (فيما يتعلق بالعقل) / علوي (طابق) (في أو من الطوابق العليا لمبنى) / طابق علوي (جزء المبنى الذي يقع فوق الطابق الأرضي)\nمثال: عاشوا في الطابق العلوي",
 "二階建てバス": "حافلة بطابقين, حافلة ذات طابقين (وسيلة نَقْل للركاب)\nمثال: لنذهب بالحافلة.",
 "二項": "ثُنَائِيّ الاِسْم, ذُو اسْمَيْن (يحمل اسمين أو يتّسم بهما، خاصّةً اسمَي الجنس والنوع في التصنيف الأحيائيّ) / ثنائي الحد, حداني (من أو متعلق أو مكون من حدين) / حدانية, ذو حدين ((رياضيات) كمية معبر عنها كمجموع أو فرق لحدين؛ متعدد حدود بحدين)\nمثال: تعبير ثنائي الحد",
 "二項分布": "توزيع برنولي, توزيع ثنائي الحدين (توزيع نظري لعدد النجاحات في مجموعة محدودة من المحاولات المستقلة باحتمال نجاح ثابت)",
 "二項定理": "نَظَرِيَّةُ ذَاتِ الْحَدَّيْنِ, مُبَرْهَنَةُ ذَاتِ الْحَدَّيْنِ (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية.",
 "二項式": "ثُنَائِيّ الاِسْم, ذُو اسْمَيْن (يحمل اسمين أو يتّسم بهما، خاصّةً اسمَي الجنس والنوع في التصنيف الأحيائيّ) / ثنائي الحد, حداني (من أو متعلق أو مكون من حدين) / حدانية, ذو حدين ((رياضيات) كمية معبر عنها كمجموع أو فرق لحدين؛ متعدد حدود بحدين)\nمثال: تعبير ثنائي الحد",
 "二項演算": "عملية ثنائية, عملية منطقية (عملية تتبع قواعد الجبر البولياني؛ يأخذ كل معامل والنتيجة إحدى قيمتين)",
 "二頭筋": "ذَات اَلرَّأْسَيْن / ذَات اَلرَّأْسَيْن اَلْعَضُدِيَّة",
 "云々": "إلخ, وما إلى ذلك (الاستمرار بنفس الطريقة) / تَعْلِيق, مَلْحُوظَة / عَلَّقَ",
 "云々かんぬん": "إلخ, وما إلى ذلك (الاستمرار بنفس الطريقة)",
 "云える": "السَّابِقُ ذِكْرُهُ",
 "云云": "إلخ, وما إلى ذلك (الاستمرار بنفس الطريقة) / تَعْلِيق, مَلْحُوظَة / عَلَّقَ",
 "云云かんぬん": "إلخ, وما إلى ذلك (الاستمرار بنفس الطريقة)",
 "云爾": "هَكَذَا",
 "互い": "بَعْضُهُ الْبَعْض",
 "互いに": "بشكل متبادل (بطريقة متبادلة أو مشتركة)\nمثال: كان الاتفاق مرضياً بشكل متبادل",
 "互いに素": "لَا تَقَاطُعَ بَيْنَهُمَا, مُنْفَصِل (ليس بينهما عناصر مشتركة)",
 "互い違い": "متبادل (للأوراق والفروع ونحوها؛ تظهر أولاً على جانب ثم على الآخر في صفين على طول المحور؛ غير مزدوجة) / بَدِيل (يُستخدَم أو يَخدُم مكان شيء آخر) / بَدِيل, عِوَض (شخص يأخذ مكان شخص آخر)\nمثال: سيقان بأوراق متبادلة",
 "互い違いに": "متبادل (للأوراق والفروع ونحوها؛ تظهر أولاً على جانب ثم على الآخر في صفين على طول المحور؛ غير مزدوجة) / بَدِيل (يُستخدَم أو يَخدُم مكان شيء آخر) / بَدِيل, عِوَض (شخص يأخذ مكان شخص آخر)\nمثال: سيقان بأوراق متبادلة",
 "互に": "بشكل متبادل (بطريقة متبادلة أو مشتركة)\nمثال: كان الاتفاق مرضياً بشكل متبادل",
 "互助": "دعم لوجستي دولي, عون متبادل (ترتيبات بين الدول لمساعدة بعضها البعض)",
 "互助的": "لَطِيف (ذو اللطف وذو اللطافة؛ من الكلام: هو عمض معناه وخفي)\nمثال: هي مدرسة لطيفة.",
 "互市": "تِجَارَة",
 "互恵": "معاملة بالمثل (تبادل متبادل لامتيازات تجارية أو غيرها) / تَبَادُلِيَّة (علاقة اعتماد أو عمل أو تأثير متبادل)",
 "互恵主義": "معاملة بالمثل (تبادل متبادل لامتيازات تجارية أو غيرها) / تَبَادُلِيَّة (علاقة اعتماد أو عمل أو تأثير متبادل)",
 "互恵的": "مُتَبَادَل / مَقْلُوب",
 "互換": "أخذ وعطاء, تبادل (تفاعل متبادل؛ نشاط المبادلة (خاصة المعلومات)) / تبادل عملات, صرافة (تحويل متبادل لمبالغ مالية متكافئة (خاصة عملات الدول المختلفة)) / تَبَادُل (فعل تغيير شيء بشيء آخر) / تقاطع طرق, محول طرق (تقاطع طرق سريعة على مستويات مختلفة يسمح بحركة المرور من طريق إلى آخر دون عبور مسارات المرور)\nمثال: يكسب عيشه من تبادل العملات / تغيير المقام, نقل موسيقي ((موسيقى) العزف بمقام مختلف عن المقام المقصود؛ تحريك طبقة الصوت لمقطوعة موسيقية لأعلى أو لأسفل) / عكس, قلب (فعل عكس الترتيب أو المكان) / تبادل المواقع ((كهرباء) إعادة ترتيب المواقع النسبية لخطوط الطاقة لتقليل تأثيرات السعة والحث المتبادل) / نقل ((رياضيات) نقل كمية من أحد جانبي المعادلة إلى الجانب الآخر مع تغيير الإشارة)\nمثال: كتب كتابًا دراسيًا عن التأثيرات الكهربائية لتبادل المواقع / متوافق, منسجم (قادر على الوجود والأداء في مزيج متناغم أو مقبول) / متوافق ((تقنياً) قابل للاستخدام مع أو الاتصال بأجهزة أو مكونات أخرى دون تعديل) / قَابِلٌ لِلمَزْج, مُتَجَانِس (قادر على تكوين خليط متجانس لا ينفصل ولا يتغيّر بالتفاعل الكيميائي)\nمثال: زوجان متوافقان",
 "互換性": "انسجام, توافق (القدرة على الوجود أو الأداء في مزيج متناغم) / توافق (شعور بالفهم المتعاطف)",
 "互換機": "كْلُون / مُسْتَنْسَخ",
 "互生": "تناوب (تغيير متتالي من شيء أو حالة إلى أخرى والعودة مرة أخرى)",
 "互角": "عِدْل (عَدْل) / مُسَاوٍ, الْمُسَاوِي / سَاوَى\nمثال: هل يعاملون بالعدل",
 "互譲": "ترضية, مصالحة (فعل الترضية والتغلب على عدم الثقة والعداء) / توفيق, مصالحة (أي من أشكال الوساطة المختلفة التي يمكن من خلالها تسوية النزاعات قبل الوصول للتحكيم) / توفيق, مصالحة (حالة إظهار النوايا الحسنة والتعاون بعد التصالح)\nمثال: كانت هناك فترة وجيزة من المصالحة لكن القتال سرعان ما استؤنف",
 "互譲的": "تصالحي, توحيقي (يهدف إلى الاسترضاء أو التهدئة) / توفيقي, مرن (يقدم أو مستعد لتقديم تنازلات)\nمثال: تحدث بنبرة تصالحية",
 "互酬": "معاملة بالمثل (تبادل متبادل لامتيازات تجارية أو غيرها) / تَبَادُلِيَّة (علاقة اعتماد أو عمل أو تأثير متبادل)",
 "互酬性": "معاملة بالمثل (تبادل متبادل لامتيازات تجارية أو غيرها) / تَبَادُلِيَّة (علاقة اعتماد أو عمل أو تأثير متبادل)",
 "五": "خَمْسَة, خمسة (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال.",
 "五〇": "خَمْسِينَ, خَمْسُونَ",
 "五〇〇": "خَمْسُمِئَة (يَدُلُّ عَلَى العَدَد 500) / خَمْسمِائَة (العدد الأصلي الذي هو حاصل ضرب مائة في خمسة) / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "五つ": "خَمْسَة, خمسة (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال. / اَلسَّاعَة اَلثَّامِنَة",
 "五つ子": "خماسي (مجموعة من خمسة أشياء متشابهة تُعتبر كوحدة واحدة) / توأم خماسي (واحد من خمسة أطفال ولدوا في نفس الوقت من نفس الحمل) / خَمْسَة, خُمَاسِيّ (العدد الأصلي الذي هو مجموع أربعة وواحد)",
 "五世": "خَامِس, خَامِسَة / خُمْس ((خَمَسَ) المَال خمْسا: أَخذ خمسه؛ (خَمَسَ) فُلَانًا أَخذ خمس مَاله)\nمثال: رأيت خمسة رجال.",
 "五人組": "خماسي, كوينتيت (تأليف موسيقي لخمسة مؤديين) / خماسي, مجموعة خماسية (خمسة أشخاص يُنظر إليهم كوحدة واحدة) / خماسي (مجموعة من خمسة أشياء متشابهة تُعتبر كوحدة واحدة) / خماسي (خمسة مؤدين أو مغنين يؤدون معاً)",
 "五位": "غُرَاب اللَيْل أَسْوَد التَاج",
 "五位鷺": "غُرَاب اللَيْل أَسْوَد التَاج",
 "五体投地": "سُجُود",
 "五倍": "خُمَاسِيّ (ذو خمس وحدات أو مكوّنات) / خماسي (مجموعة من خمسة أشياء متشابهة تُعتبر كوحدة واحدة)",
 "五倍子蜂": "دبور العفص (دبور منعزل صغير ينتج العفص على البلوط والنباتات الأخرى)",
 "五分": "نِصْف, نُصْف / مُسَاوَاة / تَسَاوٍ",
 "五分五分": "مُنَاصَفَةً, بِالنِّصْف",
 "五割": "خَمْسُون بِالْمِائَة (النصف معبراً عنه كنسبة مئوية)",
 "五十": "خَمْسِينَ, خَمْسُونَ",
 "五十三次": "ثَلَاثَة وَخَمْسُون (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "五十代": "خَمْسُونَ (يَدُلُّ عَلَى العَدَد 50) / خَمْسُون (العدد الأصلي الذي هو حاصل ضرب عشرة في خمسة)",
 "五十年祭": "يُوبِيل",
 "五十集": "سَمَّاك, بَائِع سَمَك",
 "五寸くぎ": "سنبلة",
 "五寸釘": "سنبلة",
 "五度": "خَامِس, خَامِسَة / خُمْس ((خَمَسَ) المَال خمْسا: أَخذ خمسه؛ (خَمَسَ) فُلَانًا أَخذ خمس مَاله)\nمثال: رأيت خمسة رجال.",
 "五徳": "حامل ثلاثي القوائم (رف بثلاثة أرجل يستخدم للدعم)",
 "五感": "ٱَلْحَوَاسُّ ٱلْخَمْسُ",
 "五才": "بِعُمُر خَمْس سَنَوَات (في عامه الخامس من العمر)",
 "五日熱": "حمى الخنادق (تتميز بألم في العضلات والمفاصل وينقلها القمل)",
 "五旬祭": "شافوت, عيد الأسابيع ((اليهودية) يوم مقدس يهودي يُحتفل به في السادس من سيفان للاحتفال بتلقي موسى للوصايا العشر) / أحد العنصرة, عيد العنصرة (الأحد السابع بعد عيد الفصح؛ يحيي ذكرى حلول الروح القدس على الرسل؛ يوم ربع سنوي في اسكتلندا)",
 "五旬節": "شافوت, عيد الأسابيع ((اليهودية) يوم مقدس يهودي يُحتفل به في السادس من سيفان للاحتفال بتلقي موسى للوصايا العشر) / أحد العنصرة, عيد العنصرة (الأحد السابع بعد عيد الفصح؛ يحيي ذكرى حلول الروح القدس على الرسل؛ يوم ربع سنوي في اسكتلندا)",
 "五時": "اَلسَّاعَة اَلْخَامِسَة",
 "五書": "تَوْرَاة",
 "五月": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "五月祭": "يَوْم العُمَّال العَالَمِيّ, يَوْم العُمَّال (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "五本": "خَمْسَة, خمسة (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال.",
 "五歳": "بِعُمُر خَمْس سَنَوَات (في عامه الخامس من العمر)",
 "五炭糖": "بنتوز, سكر خماسي (أي سكر أحادي يحتوي على خمس ذرات كربون في الجزيء)",
 "五百": "خَمْسُمِئَة (يَدُلُّ عَلَى العَدَد 500) / خَمْسمِائَة (العدد الأصلي الذي هو حاصل ضرب مائة في خمسة) / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "五百万": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "五稜堡": "خُمَاسِيّ الأَضْلَاع (ذو خمسة أضلاع) / مُخَمَّس, خُمَاسِيّ أَضْلَاع",
 "五稜郭": "خُمَاسِيّ الأَضْلَاع (ذو خمسة أضلاع)",
 "五種競技": "الخماسي, مسابقة الخماسي (مسابقة رياضية تتكون من خمس فعاليات مختلفة)",
 "五線": "طَاقَم, طَاقِم",
 "五線紙": "ورق موسيقي (ورق مسطر بخطوط مناسبة لكتابة الموسيقى)",
 "五色": "مُتَبَايِن, مُتَنَوِّع (خرج عن التماثل أو التطابق أو التكرار) / مُتَنَوِّع, وَاسِع النِّطَاق (مُخْتَلِف اخْتِلَافًا كَبِيرًا) / متعدد, متنوع (يتميز بالتنوع)\nمثال: التقاليد العرقية والدينية المتنوعة للمهاجرين / شَمَّام",
 "五色鳥": "بَرْبِيت",
 "五芒": "شكل خماسي, نجمة خماسية (نجمة لها 5 رؤوس؛ تتكون من 5 خطوط مستقيمة بين رؤوس مخمس وتحيط بمخمس آخر)",
 "五芒星": "شكل خماسي, نجمة خماسية (نجمة لها 5 رؤوس؛ تتكون من 5 خطوط مستقيمة بين رؤوس مخمس وتحيط بمخمس آخر)",
 "五角": "مُخَمَّس, خُمَاسِيّ أَضْلَاع",
 "五角形": "مُخَمَّس, خُمَاسِيّ أَضْلَاع",
 "五車星": "سائق العربة الحربية (سائق العربة)",
 "五輪": "أَلْعَاب أُولِمْبِيَّة, أُولِمْبِيَّة",
 "五輪大会": "أَلْعَاب أُولِمْبِيَّة, أُولِمْبِيَّة",
 "五辺形": "مُخَمَّس, خُمَاسِيّ أَضْلَاع",
 "五重": "خُمَاسِيّ",
 "五面体": "خماسي السطوح (أي متعدد سطوح له خمسة أوجه مستوية)",
 "五音": "سلم خماسي (سلم ناقص مكون من خمس نغمات؛ عادة ما تُحذف النغمتان الرابعة والسابعة من السلم الدياتوني)",
 "五音音階": "سلم خماسي (سلم ناقص مكون من خمس نغمات؛ عادة ما تُحذف النغمتان الرابعة والسابعة من السلم الدياتوني)",
 "井": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق.",
 "井々": "حَسَنُ التَّنْظِيمِ, مُرَتَّبٌ (منظم ومرتب ترتيباً جيداً)",
 "井井": "حَسَنُ التَّنْظِيمِ, مُرَتَّبٌ (منظم ومرتب ترتيباً جيداً)",
 "井堰": "سَدّ, سد (أغلق الخلل ورَدَمَ الثلم فلائم الردمُ الثلم؛ الطريق: أغلقه وأعاق السير فيه)",
 "井守": "سَمَنْدَل",
 "井戸水": "مياه جوفية (مياه تحت الأرض محتجزة في التربة وفي الصخور المنفذة)",
 "井桁": "شُبَّاك / حَشِيش",
 "井水": "مياه جوفية (مياه تحت الأرض محتجزة في التربة وفي الصخور المنفذة)",
 "井泉": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق. / مياه جوفية (مياه تحت الأرض محتجزة في التربة وفي الصخور المنفذة)",
 "井然": "منضبط, منظم (خالٍ من العنف أو الاضطراب) / مُنَظَّم, نَظِيف (نَظِيفٌ أَوْ مُنَظَّمٌ بِشَكْلٍ جَيِّد) / تمرجي, ساعي المستشفى (مرافق مستشفى ذكر لديه واجبات عامة لا تشمل العلاج الطبي للمرضى) / جندي مراسلة, مراسل (جندي يعمل كمساعد لضابط أعلى رتبة)\nمثال: حشد منظم واجه الرئيس",
 "些": "قَلِيلًا / صَغِير, صغير",
 "些々": "تضييع الوقت, عبث (الفعل المتعمد للتأخير واللعب بدلاً من العمل) / زَهِيد, ضَئِيل (لَا يَسْتَحِقُّ الاِعْتِبَار)",
 "些か": "قَلِيلًا",
 "些事": "تفاهة, شيء تافه (شيء قليل الأهمية) / أمر تافه, تفاهة (تفصيل يعتبر غير مهم) / ترافل (بودينغ بارد مصنوع من طبقات من الكعك الاسفنجي المدهون بالفاكهة أو الجيلي؛ وقد يُزين بالمكسرات أو الكريمة أو الشوكولاتة)",
 "些些": "تضييع الوقت, عبث (الفعل المتعمد للتأخير واللعب بدلاً من العمل) / زَهِيد, ضَئِيل (لَا يَسْتَحِقُّ الاِعْتِبَار)",
 "些少": "تضييع الوقت, عبث (الفعل المتعمد للتأخير واللعب بدلاً من العمل) / زَهِيد, ضَئِيل (لَا يَسْتَحِقُّ الاِعْتِبَار)",
 "些末": "تافِه",
 "些細": "تافِه",
 "亜": "مُتَوَسِّط, مِنَ الدَّرَجَة الثَّانِيَة (متوسط إلى رديء في الجودة) / ـِيّ / آسِيَا, أسيا (إحدى القارات السبع؛ أكبرها مساحةً، وأكثرها سكانًا)\nمثال: على شعوب آسيا أن تتعاون. / الْأَرْجَنْتِين, الأرجنتين",
 "亜セレン酸": "حمض السيلينيوز (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: حمض السيلينيوز مشابه لحمض الكبريتوز، لكنه يعزل بسهولة أكبر (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)",
 "亜ヒ酸": "ثلاثي أكسيد الزرنيخ, زرنيخ (مسحوق أبيض سام من ثلاثي أكسيد الزرنيخ؛ يستخدم في صناعة الزجاج وكمبيد للآفات (سم الفئران) ومبيد للأعشاب)",
 "亜リン酸": "حمض الهيبوفوسفوروز (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "亜人": "دُونَ المُسْتَوَى البَشَرِيّ (غَيْرُ صَالِحٍ لِلْبَشَرِ) / أقل من البشر, دون المستوى البشري (أقل من البشر أو لا يليق بالإنسان)\nمثال: عامل السكان الأصليين كأنهم دون البشر / أرجنتيني (من أو يتعلق بالأرجنتين أو شعبها أو يميزهم) / أرجنتيني (مواطن أو ساكن في الأرجنتين)\nمثال: تانغو أرجنتيني / أَمْرِيكِيّ, أَمْرِيكِيَّة",
 "亜低木": "جنبة, شجيرة فرعية (شجيرة خشبية منخفضة النمو أو نبات معمر بقاعدة خشبية)",
 "亜原子粒子": "جُسَيْم (جسم له كتلة محدودة وهيكل داخلي ولكن أبعاده ضئيلة)",
 "亜国": "الْأَرْجَنْتِين, الأرجنتين",
 "亜塩素酸": "حمض الكلوروز (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "亜大陸": "شِبْه قارَة",
 "亜媽港": "مَاكَاوْ, أَوْمِين",
 "亜属": "جنس فرعي, جنيس ((في الأحياء) مجموعة تصنيفية بين الجنس والنوع)",
 "亜州": "آسِيَا, أسيا (إحدى القارات السبع؛ أكبرها مساحةً، وأكثرها سكانًا)\nمثال: على شعوب آسيا أن تتعاون.",
 "亜急性": "تَحْت حَادّ, شِبْه حَادّ (أقلّ حِدّة من الحادّ؛ يتعلّق بمرض موجود لدى شخص بلا أعراض ظاهرة)",
 "亜急性硬化性全脳炎": "التهاب الدماغ المصلب تحت الحاد (التهاب دماغ مزمن نادر ومترقٍ يسببه فيروس الحصبة ويحدث بشكل أساسي عند الأطفال والشباب؛ تحدث الوفاة عادة في غضون ثلاث سنوات)",
 "亜族": "زمرة جزئية (مجموعة جزئية (غير خالية) من زمرة رياضية) / مجموعة فرعية (مجموعة مميزة وغالباً ما تكون تابعة داخل مجموعة)",
 "亜欧": "أُورَاسِيَا",
 "亜流": "مُحَاكٍ, مُقَلِّد (شخص ينسخ كلمات أو سلوك شخص آخر) / منتحل شخصية (شخص ينتحل (عن طريق الاحتيال) مظهر شخص آخر) / تَابِع / مُتَابِع",
 "亜炭": "فحم بني",
 "亜熱帯": "المنطقة شبه الاستوائية (المناطق المتاخمة للمناطق الاستوائية)",
 "亜熱帯高圧帯": "عروض الخيل (أي من الحزامين أو المنطقتين بالقرب من 30 درجة شمالاً أو 30 درجة جنوباً؛ تتميز بهدوء ورياح خفيفة محيرة)",
 "亜燐酸": "حمض الهيبوفوسفوروز (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "亜界": "عويلم, مملكة فرعية ((في الأحياء) مجموعة تصنيفية تشكل قسماً رئيسياً من المملكة)",
 "亜目": "رتيبة ((في الأحياء) مجموعة تصنيفية تعد قسماً فرعياً من الرتبة)",
 "亜砒酸": "ثلاثي أكسيد الزرنيخ, زرنيخ (مسحوق أبيض سام من ثلاثي أكسيد الزرنيخ؛ يستخدم في صناعة الزجاج وكمبيد للآفات (سم الفئران) ومبيد للأعشاب)",
 "亜硝酸": "حمض النيتروز (حمض غير عضوي غير مستقر يُعرف فقط في المحلول وكأملاح النتريت)",
 "亜硝酸アミル": "نترات الأميل (موسع للأوعية الدموية يستخدم أحياناً لعلاج الذبحة الصدرية)",
 "亜硝酸ナトリウム": "نيتريت الصوديوم (نيتريت يستخدم لحفظ وتلوين الطعام خاصة في منتجات اللحوم والأسماك؛ متورط في تكوين مواد مسرطنة مشتبه بها)",
 "亜硝酸塩": "نيتريت",
 "亜科": "أسرة, فصيلة فرعية ((في الأحياء) فئة تصنيفية تحت الفصيلة)",
 "亜種": "نُوَيْع",
 "亜空間": "فضاء جزئي (فضاء محتوى داخل فضاء آخر)",
 "亜節": "شعبة, قسم فرعي (قسم من قسم؛ جزء من جزء؛ أي جزء من شيء مقسم بالفعل)",
 "亜綱": "طويئفة ((في الأحياء) فئة تصنيفية تحت الطائفة وفوق الرتبة)",
 "亜群": "زمرة جزئية (مجموعة جزئية (غير خالية) من زمرة رياضية) / مجموعة فرعية (مجموعة مميزة وغالباً ما تكون تابعة داخل مجموعة)",
 "亜脱臼": "خلع جزئي (إزاحة جزئية لمفصل أو عضو)",
 "亜酸化窒素": "أكسيد النيتروز, غاز الضحك (مخدر استنشاقي يستخدم كمخدر في طب الأسنان والجراحة)",
 "亜鈴": "دُمْبِل",
 "亜鉛": "خَارَصِين / تُوتِيَاء / زِنْك",
 "亜鉛凸版": "لوحة تظليل, نقش ضوئي (نقش يستخدم لإعادة إنتاج رسم توضيحي)",
 "亜鉛華": "أبيض الزنك, أبيض صيني (خضاب أبيض يستخدم في دهانات المنازل؛ يتكون من أكسيد الزنك)",
 "亜鉛鉄": "حديد مجلفن (حديد مطلي بالزنك لحمايته من الصدأ)",
 "亜門": "شعيبة ((في الأحياء) مجموعة تصنيفية تقع بين الشعبة والطائفة)",
 "亜麻": "كَتّان",
 "亜麻仁": "بذور الكتان (بذرة الكتان المستخدمة كمصدر للزيت)",
 "亜麻仁油": "زيت بذر الكتان (زيت جاف يُستخرج من بذور الكتان ويُستخدم في صنع أشياء مثل الدهانات الزيتية)",
 "亜麻布": "كَتَّان",
 "亜麻織物": "كَتَّان",
 "亜麻色": "بِيج",
 "亜麻製": "أَشْقَر رَمْلِيّ, كَتَّانِيّ (بلون شعر أصفر باهت إلى بني مصفر)",
 "亡": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / مُتَأَخِّر / مَرْحُوم / مُتَأَخِّرًا",
 "亡い": "مَيِّت",
 "亡き": "مَيِّت مَيْت, مُتَوَفًّى / مَرْحُوم",
 "亡き人": "مَيِّت مَيْت, مُتَوَفًّى / مَرْحُوم",
 "亡き者": "راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "亡き者にする": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "亡き骸": "جُثَّة, جُثْمَان (جسد إنسان ميت) / بقايا أثرية, لقى أثرية (أثر تم استخراجه من التربة عن طريق التنقيب) / بقايا (أي شيء يترك غير مستخدم أو لا يزال موجوداً)\nمثال: كانت الجثة مخصصة للتشريح",
 "亡き魂": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "亡くす": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته.",
 "亡くなす": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته.",
 "亡くなる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "亡びる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "亡ぶ": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "亡ぼす": "دَمَّرَ",
 "亡八": "يُوحَنَّا, يَحْيَى ((في المسيحية) أي من شخصيات الكتاب المقدس الذين تسموا بهذا الاسم، وأشهرهم: \"يُوحَنَّا الْمَعْمَدَان\"، و\"يُوحَنَّا الْإِنْجِيلِيّ\"…؛ (في المسيحية) إنجيل يوحنا، آخر الأناجيل القانونية الأربع) / إِنْجِيل يُوحَنَّا\nمثال: توم وماريا قالو ليوحنا, أنهم لا يعتقدون أن تكون ايلكا في الأسفل. / بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "亡卒": "هَارِب / مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر",
 "亡命": "انشقاق, خذلان (سحب الدعم أو المساعدة رغم الولاء أو المسؤولية) / انشقاق, تخلي (حالة نبذ المعتقدات الدينية أو الحزب السياسي أو قضية ما (غالباً لصالح معتقدات أو قضايا معارضة))\nمثال: تخليه عن زوجته وأطفاله تركهم مفلسين",
 "亡命希望者": "طَالِب لُجُوء, طَالِبَة لُجُوء",
 "亡命者": "لَاجِئ, لَاجِئَة",
 "亡失": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة",
 "亡状": "إساءة, فظاظة (نقص في التهذيب؛ الفشل في إظهار الاحترام للآخرين؛ جرح مشاعر الآخرين) / فجاجة, قلة أدب (أسلوب وقح ومهين) / قِلَّة احْتِرَام, وَقَاحَة (تعبير عن عدم الاحترام)",
 "亡者": "مَيِّت",
 "亡霊": "شَبَح, خَيَال",
 "亡骸": "جُثَّة, جُثْمَان (جسد إنسان ميت) / بقايا أثرية, لقى أثرية (أثر تم استخراجه من التربة عن طريق التنقيب) / بقايا (أي شيء يترك غير مستخدم أو لا يزال موجوداً)\nمثال: كانت الجثة مخصصة للتشريح",
 "亡魂": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "亢進": "اِنْتِفَاضَة, تَمَرُّد (معارضة منظمة للسلطة؛ صراع يحاول فيه فصيل انتزاع السيطرة من آخر) / بَازِغ, صَاعِد (برز حديثاً إلى الواجهة) / صَاعِد, نَاشِئ (يَبْلُغُ مَرْحَلَةَ النُّضْج) / طَالِع, مُنْحَدِرٌ صُعُودًا (مَائِلٌ نَحْوَ الأَعْلَى)",
 "交": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية. / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "交々": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب"
}
