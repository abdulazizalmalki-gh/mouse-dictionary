 "メーンディッシュ": "شراع رئيسي مربع (شراع رئيسي مربع الشكل) / الطبق الرئيسي (الطبق الأساسي في الوجبة)",
 "メーンデッキ": "السطح الرئيسي (أعلى سطح مغطى يمتد على طول السفينة الكبيرة بالكامل)",
 "メーンフレーム": "المعالج, المعالج المركزي ((علوم الحاسوب) جزء من الحاسوب (شريحة المعالج الدقيق) يقوم بمعظم معالجة البيانات) / حاسوب مركزي (حاسوب رقمي كبير يخدم 100-400 مستخدم ويشغل غرفة خاصة مكيفة الهواء)\nمثال: تشكل وحدة المعالجة المركزية والذاكرة الجزء المركزي من الكمبيوتر الذي يتم توصيل الأجهزة الطرفية به",
 "メーンボード": "اللَّوْحَةُ الأُمّ",
 "メーンマスト": "الصاري الرئيسي (الصاري الرئيسي لسفينة شراعية ذات صاريين أو أكثر)",
 "メーン・スタンド": "مُدَرَّج مُغَطَّى, مِنَصَّة رَئِيسِيَّة (موقف في مضمار سباق أو ملعب يتكون من طبقات بها صفوف من المقاعد الفردية تحت سقف واقٍ) / المنصة الرئيسية, جمهور المدرجات (الجمهور في ملعب أو مضمار سباق)",
 "メーン・ストリート": "جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم الذي يجمع الطُّرق أو الطريق الكبير الذي يجمع كل الطريق)\nمثال: كانت ماري جادة.",
 "メーン・ディッシュ": "شراع رئيسي مربع (شراع رئيسي مربع الشكل) / الطبق الرئيسي (الطبق الأساسي في الوجبة)",
 "メー・クイン": "ملكة مايو (الفتاة المختارة كملكة لمهرجان يوم مايو)",
 "メー・クイーン": "ملكة مايو (الفتاة المختارة كملكة لمهرجان يوم مايو)",
 "メー・デー": "يَوْم العُمَّال العَالَمِيّ, يَوْم العُمَّال (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "モア": "مُوَّا",
 "モアゲージ": "رَهْن, رَهْن عَقَارِيّ ((رَهَنَ) الشيءُ يَرْهَنُ رهْنًا، ورُهُونا: ثَبَت ودامَ؛ يقال (رَهَنَ) بالمكان: أقامَ)\nمثال: رهن فاضل الحلي.",
 "モアレ": "مُمَوَّج, مُمَوَّه ((في الحرير) ذو نقش موجيّ متماوج) / حرير متموج, مواريه (قماش حريري بنمط سطح متموج)",
 "モイ": "مَرْحَبًا, سَلَام (تَحِيَّة تقال للضيف؛ تَحِيَّة تقال عند لقاء شخص ما أو لبدء المُحَادَثَة)\nمثال: مرحبا يا فتيات.",
 "モイスチャー": "رُطُوبَة",
 "モイスト": "رَطِب, بَلّ (يحتوي على الماء أو الرطوبة، غير جاف؛ لين أو طري الملمس بسبب وجود الرطوبة)\nمثال: ملابسي رطبة ومليئة في التراب علي تبديلها.",
 "モイライ": "مويراي (أي من إلهات القدر أو المصير الثلاث اليونانيات؛ يتماهين مع باركاي الرومانية ويشبهن نورن الإسكندنافية)",
 "モウカザメ": "لِيَّاءٌ",
 "モウコノウマ": "حصان برزوالسكي (حصان بري في وسط آسيا يشبه الحمار؛ مهدد بالانقراض الآن)",
 "モウマンタイ": "عَفْوًا",
 "モウメンタム": "زَخَم حَرَكَة (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…) / زَخَم (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…)\nمثال: يمكنك أن تتعلم بنفس الزخم في المكتبة كما في المدرسة.",
 "モウモウ": "خُوَار / خَارَ (صوت حيوان البقر خاصة؛ في : نطقٌ يحدث من الحلق، أي الصوت الذي يصدر من الحلق بشكل مستمر) / مُو\nمثال: السحابة هي كتلة بخار في السماء. / بقرة (أنثى الماشية المستأنسة)",
 "モカ": "مُوكَا",
 "モカシン": "خف, موكسان (حذاء جلدي ناعم؛ ارتداه السكان الأصليون لأمريكا في الأصل)",
 "モガ": "فتاة متحررة (شابة في العشرينيات من القرن الماضي كانت تتباهى بسلوكها وملابسها غير التقليدية)",
 "モガジシオ": "مَقَدِيشُو, مَقْدِيشُو (مدينة في الصومال، وهي عاصمتها، وتقع في محافظة بنادر)",
 "モガディシオ": "مَقَدِيشُو, مَقْدِيشُو (مدينة في الصومال، وهي عاصمتها، وتقع في محافظة بنادر)",
 "モガディシュ": "مَقَدِيشُو, مَقْدِيشُو (مدينة في الصومال، وهي عاصمتها، وتقع في محافظة بنادر)",
 "モギリ": "جامِع التَّذاكِر, قاطِع التَّذاكِر (شخص يتقاضى أجراً للسماح بدخول من اشتروا التذاكر فقط)",
 "モク": "سِيجَارَة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض التدخين)\nمثال: دخن زيري سيجارة.",
 "モクキリン": "عنب الثعلب البربادوسي (فاكهة صغيرة صفراء إلى برتقالية لصبار عنب الثعلب البربادوسي) / بيرسكية شائكة, عنب الثعلب البربادوسي (متسلق خشبي من جزر الهند الغربية ذو سيقان شائكة والعديد من الزهور البيضاء العطرة في نورات عنقودية تليها ثمار صفراء إلى برتقالية صغيرة)",
 "モクセイソウ": "خزامى, ريزيدا عطرة (نبات حولي خشبي متوسطي يزرع على نطاق واسع لعناقيده الطرفية الكثيفة التي تشبه السنابل من الزهور البيضاء المخضرة أو الصفراء ذات الرائحة الحارة القوية)",
 "モクマオウ": "خشب اللحم (شجرة تنتج خشباً محمراً ثقيلاً صلباً) / خشب البقر المقشر (شجرة أو شجيرة طويلة ذات أوراق لامعة وخيمات من الزهور البيضاء الكريمية العطرة؛ تنتج خشباً محمراً ثقيلاً صلباً) / خشب البقر (أي من عدة أشجار أسترالية من جنس كزوارينا تنتج خشباً أحمر صلباً ثقيلاً يستخدم في النجارة) / خشب اللحم (أي من العديد من الأخشاب المحمرة الصلبة الثقيلة الاستوائية بشكل رئيسي؛ يستخدم بعضها للخزائن)",
 "モクモク": "اِنْتِفَاضَة, تَمَرُّد (معارضة منظمة للسلطة؛ صراع يحاول فيه فصيل انتزاع السيطرة من آخر) / بَازِغ, صَاعِد (برز حديثاً إلى الواجهة) / صَاعِد, نَاشِئ (يَبْلُغُ مَرْحَلَةَ النُّضْج) / طَالِع, مُنْحَدِرٌ صُعُودًا (مَائِلٌ نَحْوَ الأَعْلَى)",
 "モグモグ": "مجمجة, مضغ بلا أسنان (مضغ غير فعال (كما لو كان بدون أسنان)) / تمتمة, نطق غير واضح (بيان غير واضح للكلام) / مضغ (عض وطحن الطعام في فمك ليصبح ناعماً بما يكفي للبلع) / تلوّي, تململ (عملية التلوّي أو التململ)",
 "モグラ": "خَال, شَامَة (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث) / طَوْبِين, طُوبِين / مُول\nمثال: عندي ابنا خالة.",
 "モグラづか": "تلة الخلد (كومة من التراب يصنعها الخلد أثناء الحفر)",
 "モグラモチ": "خَال, شَامَة (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث) / طَوْبِين, طُوبِين / مُول\nمثال: عندي ابنا خالة.",
 "モグラ塚": "تلة الخلد (كومة من التراب يصنعها الخلد أثناء الحفر)",
 "モグリウミツバメ": "نوء غواص (أي من عدة طيور غوص صغيرة في بحار نصف الكرة الجنوبي؛ تشبه طيور الأوك إلى حد ما)",
 "モケット": "موكيت (قماش صناعي مخملي سميك يستخدم للسجاد والمفروشات الناعمة)",
 "モケモケ": "حَبَّة دَوَاء (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / قُرْص / حَبّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / حَبَّة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة)\nمثال: أكلت حبة طماطم.",
 "モコモコ": "رَقِيق كَالزَّغَب, زَغَبِيّ (ناعِم وخَفيف كالرِّيش أو الزَّغَب) / مُتَكَتِّل",
 "モゴモゴ": "مجمجة, مضغ بلا أسنان (مضغ غير فعال (كما لو كان بدون أسنان)) / تمتمة, نطق غير واضح (بيان غير واضح للكلام) / مضغ (عض وطحن الطعام في فمك ليصبح ناعماً بما يكفي للبلع) / تلوّي, تململ (عملية التلوّي أو التململ)",
 "モサ": "بلطجي, رجل قوي (رجل يتنمر على الأشخاص الأضعف) / مُحَارِب قَدِيم / نَشَّال",
 "モサッと": "بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود",
 "モサド": "الْمُوسَاد",
 "モザイク": "فُسَيْفِسَاء (قطَِعٌ صَغِيرَةٌ مُلَوَّنَةٌ مِنَ الزَّلِّيجِ)",
 "モザイクが": "فُسَيْفِسَاء (قطَِعٌ صَغِيرَةٌ مُلَوَّنَةٌ مِنَ الزَّلِّيجِ)",
 "モザイクじょう": "مُرَصَّع بِالفُسَيْفِسَاء (مزين بقطع صغيرة من الزجاج أو الحجر الملون مُجمَّعة في فسيفساء) / مُتَرَصِّع, مُفَسْفَس (ذو مظهر مربّعات أو رقع ملوّنة كالفسيفساء)",
 "モザイクびょう": "فيروس تبرقش التبغ, فيروس فسيفساء التبغ (فيروس نباتي مدروس على نطاق واسع يسبب تبرقش التبغ؛ وكان أول فيروس تم اكتشافه (1892))",
 "モザイク状": "مُرَصَّع بِالفُسَيْفِسَاء (مزين بقطع صغيرة من الزجاج أو الحجر الملون مُجمَّعة في فسيفساء) / مُتَرَصِّع, مُفَسْفَس (ذو مظهر مربّعات أو رقع ملوّنة كالفسيفساء)",
 "モザイク画": "فُسَيْفِسَاء (قطَِعٌ صَغِيرَةٌ مُلَوَّنَةٌ مِنَ الزَّلِّيجِ)",
 "モザイク病": "فيروس تبرقش التبغ, فيروس فسيفساء التبغ (فيروس نباتي مدروس على نطاق واسع يسبب تبرقش التبغ؛ وكان أول فيروس تم اكتشافه (1892))",
 "モザレラ": "مُوزَارِيلَا",
 "モザンビーク": "مُوزَمْبِيق, مُوزَامْبِيق",
 "モシャモシャ": "أَشْعَث, مُنَكَّش (فِي حَالَةِ فَوْضَى شَدِيدَة)",
 "モジモジ": "بِاسْتِحْيَاء, بِخَجَل (بطريقة تتسم بالخجل أو التردد)\nمثال: ابتسم بخجل",
 "モジャモジャ": "أَشْعَث, مُنَكَّش (فِي حَالَةِ فَوْضَى شَدِيدَة)",
 "モジュラ": "تَرْكِيبِيّ, وَحْدَوِيّ (مُصمَّم بوحدات أو أبعاد موحدة تتيح المرونة والتنوع في الاستخدام)",
 "モジュラー": "تَرْكِيبِيّ, وَحْدَوِيّ (مُصمَّم بوحدات أو أبعاد موحدة تتيح المرونة والتنوع في الاستخدام)",
 "モジュレーション": "تحوير",
 "モジュール": "وَحْدَة",
 "モス": "أُشْنَة, طُحْلُب",
 "モスキート": "بَعُوضَة, نَامُوسَة",
 "モスク": "مَسْجِد, جَامِع (هو مكان السُجُوْد، بناء كان أم لا، عاما كان أم خاصا؛ المُصَلَّى)\nمثال: دخل إلى المسجد.",
 "モスクワ": "مُوسْكُو",
 "モスグリーン": "أَخْضَر طُحْلُبِيّ (بلون أخضر مصفر معتدل باهت نوعاً ما)",
 "モスコー": "مُوسْكُو",
 "モスリム": "مُسْلِم, مُسْلِمَة ((للأشخاص) متبع دين الإِسْلَام)\nمثال: سامي مسلم سابق.",
 "モスリン": "مَوْصِلِيّ",
 "モスレム": "مُسْلِم, مُسْلِمَة ((للأشخاص) متبع دين الإِسْلَام)\nمثال: سامي مسلم سابق.",
 "モス・グリーン": "أَخْضَر طُحْلُبِيّ (بلون أخضر مصفر معتدل باهت نوعاً ما)",
 "モズ": "صرد (أي من الطيور العديدة في العالم القديم ذات منقار قوي معقوف تتغذى على الحيوانات الأصغر)",
 "モソモソ": "زحف (طريقة تنقل بطيئة على اليدين والركبتين أو بجر الجسم)\nمثال: كان الزحف هو كل ما استطاع الرجل المصاب القيام به / بتململ, بقلق (بطريقة متململة)\nمثال: طقطق مفاصل أصابعه بتململ / بتردد (مع تردد؛ بطريقة مترددة)\nمثال: قبل أخيراً بتردد",
 "モソリ": "بِبُطْء",
 "モゾモゾ": "زحف (طريقة تنقل بطيئة على اليدين والركبتين أو بجر الجسم)\nمثال: كان الزحف هو كل ما استطاع الرجل المصاب القيام به / بتململ, بقلق (بطريقة متململة)\nمثال: طقطق مفاصل أصابعه بتململ / بتردد (مع تردد؛ بطريقة مترددة)\nمثال: قبل أخيراً بتردد",
 "モタモタ": "بِبُطْء",
 "モダニスト": "حداثي, فنان حداثي (فنان يُحدث قطيعة متعمدة مع الأنماط السابقة)",
 "モダニズム": "حداثة, عصرنة (ممارسات نموذجية للحياة أو الفكر المعاصر) / حداثة (نوع من الفن والأدب يُحدث قطيعة واعية مع الأنواع السابقة) / حداثة, عصرية (صفة كونه حالياً أو من الحاضر)\nمثال: مركز تسوق سيغرس روح الحداثة في هذه القرية",
 "モダニティー": "حَدَاثَة",
 "モダリティ": "نمط علاجي, وسيلة علاجية (طريقة للعلاج تتضمن علاجاً علاجياً فيزيائياً أو كهربائياً) / نمط حسي (حاسة معينة) / أُسْلُوب, صِيغَة الفِعْل (تصريفات الفعل التي تعبر عن كيفية تصور المتحدث للفعل أو الحالة) / جِهَة, مُوَجِّه (تصنيف للقضايا على أساس ما إذا كانت تدعي الضرورة أو الإمكانية أو الاستحالة)",
 "モダリティー": "نمط علاجي, وسيلة علاجية (طريقة للعلاج تتضمن علاجاً علاجياً فيزيائياً أو كهربائياً) / نمط حسي (حاسة معينة) / أُسْلُوب, صِيغَة الفِعْل (تصريفات الفعل التي تعبر عن كيفية تصور المتحدث للفعل أو الحالة) / جِهَة, مُوَجِّه (تصنيف للقضايا على أساس ما إذا كانت تدعي الضرورة أو الإمكانية أو الاستحالة)",
 "モダン": "عَصْرِيّ, حَدِيث",
 "モダンジャズ": "جاز جديد, جاز حديث (أي من أساليب الجاز المختلفة التي ظهرت بعد عام 1940)",
 "モダンダンス": "رقص حديث (أسلوب من الرقص المسرحي ليس مقيداً مثل الباليه الكلاسيكي؛ حيث تكون الحركات معبرة عن المشاعر)",
 "モダンバレエ": "باليه حديث (أسلوب من الباليه يسمح بمجموعة أوسع من الحركات)",
 "モダン・ジャズ": "جاز جديد, جاز حديث (أي من أساليب الجاز المختلفة التي ظهرت بعد عام 1940)",
