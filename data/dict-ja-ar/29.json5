 "中辺": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "中途": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط",
 "中途半端": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط",
 "中道": "وَسَطِيَّة / مُنْتَصَف, وَسَط / وَسَط, مُتَوَسْط",
 "中道左派": "يَسَارِيّ (يؤمن بمبادئ اليسار السياسي أو يدعمها)",
 "中道政党": "وَسَطِيُّ الاتِّجَاه (لَيْسَ مُتَطَرِّفًا خَاصَّةً فِي الآرَاءِ السِّيَاسِيَّة) / مُعْتَدِل, وَسَطِيّ (يدعم أو ينتهج مساراً ليس ليبرالياً ولا محافظاً بشكل مفرط)",
 "中道政治": "وَسَطِيَّة",
 "中道派": "مُحَايِد / نُقْطَة الْعَطَالَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "中道路線": "وَسَطِيُّ الاتِّجَاه (لَيْسَ مُتَطَرِّفًا خَاصَّةً فِي الآرَاءِ السِّيَاسِيَّة) / مُعْتَدِل, وَسَطِيّ (يدعم أو ينتهج مساراً ليس ليبرالياً ولا محافظاً بشكل مفرط)",
 "中部": "مَرْكَز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "中部アメリカ": "أمريكا الوسطى (دول أمريكا الوسطى مجتمعة)",
 "中部時間": "توقيت المنطقة الوسطى (التوقيت القياسي في المنطقة الزمنية السادسة غرب غرينتش، يحسب عند خط الطول 90؛ يستخدم في وسط الولايات المتحدة)",
 "中部標準時": "توقيت المنطقة الوسطى (التوقيت القياسي في المنطقة الزمنية السادسة غرب غرينتش، يحسب عند خط الطول 90؛ يستخدم في وسط الولايات المتحدة)",
 "中都市": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "中銀": "بَنْك مَرْكَزِيّ ((بَنَّكَ) الخدم: تحدَّثُوا بأسرار الْبيُوت)\nمثال: هي تعمل في بنك.",
 "中間": "مُنْتَصَف, وَسَط / وَسَط, مُتَوَسْط / وَسَطِيُّ الاتِّجَاه (لَيْسَ مُتَطَرِّفًا خَاصَّةً فِي الآرَاءِ السِّيَاسِيَّة) / مُعْتَدِل, وَسَطِيّ (يدعم أو ينتهج مساراً ليس ليبرالياً ولا محافظاً بشكل مفرط) / انْتِقَالِيّ, مَرْحَلِيّ (يخدم خلال فترة زمنيّة وسيطة) / أثناء ذلك, فترة مؤقتة (الوقت بين حدث أو عملية أو فترة وأخرى)\nمثال: في غضون ذلك، يدير الاشتراكيون الحكومة / خادم (رجل يعمل كخادم في مؤسسة كبيرة (مثل قصر) لقضاء المهمات والقيام بالأعمال المنزلية)",
 "中間システム": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "中間体": "بيني, متوسط (الواقع بين نقيضين أو طرفين في الزمان أو المكان أو الحالة) / مُتَوَسِّط, وَسَط (فِي حُدُودِ الوَسَطِ عَلَى مِقْيَاسِ التَّقْيِيم) / مركب وسيط, وسيط كيميائي (مادة تتشكل أثناء عملية كيميائية قبل الحصول على المنتج المطلوب)\nمثال: الانتقال من الجلوس إلى الوقوف دون دفعات وسيطة باليدين",
 "中間周波数": "إِنْ (يفيد التوكيد) / لَوْ / إِذَا\nمثال: إن شاء الله ؛",
 "中間商人": "وسيط تجاري (رجل يشتري كميات كبيرة من البضائع ويعيد بيعها للتجار بدلاً من العملاء النهائيين) / مؤدي الوسط (مؤدٍ ذكر في وسط صف المنشدين يشارك الآخرين في الحديث) / وسيط (شخص ذكر في وضع يسمح له بتقديم مساعدة خاصة لك)",
 "中間国": "دولة حاجزة, دولة عازلة (دولة محايدة صغيرة تقع بين قوتين متناحرتين)",
 "中間圏": "غلاف أوسط, ميزوسفير (طبقة الغلاف الجوي بين الستراتوسفير والثيرموسفير)",
 "中間子": "مِيزُون (جسيم أولي مسؤول عن القوى في النواة الذرية؛ هادرون ذو عدد باريوني 0)",
 "中間宿主": "عائل وسيط (عائل يستخدمه الطفيلي في سياق دورة حياته)",
 "中間層": "طَبَقَة وُسْطَى",
 "中間成果物": "صَنِيعَة, مَصْنُوعَة (شيء من صنع الإنسان يُؤخَذ ككلّ متكامل)",
 "中間搾取": "رشوة تجارية, عمولة غير مشروعة (رشوة تجارية يدفعها البائع لوكيل الشراء لحث الوكيل على الدخول في المعاملة)",
 "中間業者": "وسيط تجاري (رجل يشتري كميات كبيرة من البضائع ويعيد بيعها للتجار بدلاً من العملاء النهائيين) / مؤدي الوسط (مؤدٍ ذكر في وسط صف المنشدين يشارك الآخرين في الحديث) / وسيط (شخص ذكر في وضع يسمح له بتقديم مساعدة خاصة لك)",
 "中間派": "محايد (مدافع عن الحياد في الشؤون الدولية)",
 "中間線": "حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي)\nمثال: هناك خط رفيع بين العقل والجنون",
 "中間考査": "امتحان نصفي (امتحان يجرى في منتصف الفصل الدراسي)",
 "中間言語": "لغة تفاهم مشترك, لغة مشتركة (لغة مشتركة يستخدمها متحدثو لغات مختلفة)\nمثال: كانت لغة الكوينيه لهجة من اليونانية القديمة التي كانت اللغة المشتركة لإمبراطورية الإسكندر الأكبر",
 "中間試験": "امتحان نصفي (امتحان يجرى في منتصف الفصل الدراسي)",
 "中間部": "تريو, ثلاثي (تأليف موسيقي لثلاثة مؤديين) / ثالثة, ثلاثي (ثلاثة أشخاص يُنظر إليهم كوحدة واحدة) / ثلاثي (مجموعة من ثلاثة أشياء متشابهة تُعتبر كوحدة واحدة) / ثلاثي (ثلاثة مؤدين أو مغنين يؤدون معاً)",
 "中間配線盤": "الْجَيْش الْإِسْرَائِيلِيّ, الْجَيْش الدِّفَاع الْإِسْرَائِيلِيّ",
 "中間駅": "محطة توقف صغيرة (محطة سكة حديد صغيرة بين المحطات الرئيسية أو محطة يتوقف فيها القطار فقط عند الإشارة) / استراحة, محطة توقف (مكان توقف في رحلة)\nمثال: هناك توقف لتغيير الطائرات في شيكاغو",
 "中隊": "سَرِيَّة / شَرِكَة",
 "中隔": "حاجز, وتيرة ((في التشريح) فاصل يقسم بين نسيجين أو تجويفين) / حاجز (فاصل أو جدار خاصة في المبيض)",
 "中音": "وسطى ((موسيقى) النغمة الثالثة في سلم دياتوني؛ تقع في المنتصف بين نغمة الأساس والنغمة المهيمنة) / بَارِيتُون (أخفض من مدى التينور وأعلى من الباص) / باريتون (ثاني أدنى آلة نفخ نحاسية) / باريتون (ثاني أدنى صوت غنائي للذكور البالغين) / باريتون (مغنٍ ذكر بطبقة صوتية متوسطة)",
 "中項": "عَنَى, قَصَدَ / لَئِيم, خَسِيس / مُتَوَسِّط",
 "中風": "شَلَل, كَسَح",
 "中食": "جاهز, معد مسبقاً (مصنوع للشراء والاستخدام الفوري) / جَاهِز, مُعَدٌّ تِجَارِيًّا (مُنتَج تجارياً وليس منزلي الصنع) / جَاهِز, نَمَطِيّ (يتكرر بانتظام دون تفكير أو أصالة) / غرض جاهز الصنع, منتج جاهز (منتج مصنّع (كملابس أو قطعة أثاث) يتم صنعه مسبقاً ويكون متاحاً للشراء)\nمثال: شقتهم كانت مؤثثة بأثاث جاهز / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: إنه وقت الغداء.",
 "中骨": "عَمُود فَقْرِيّ / دِعَامَة / شَجَاعَة",
 "中高": "مُحَدَّب",
 "中高ドイツ語": "الألمانية العليا الوسطى (الألمانية العليا من 1100 إلى 1500)",
 "中高音": "ألتو",
 "中高音部": "ميزو سوبرانو (الصوت الغنائي النسائي بين الكونترالتو والسوبرانو) / ميزو سوبرانو (سوبرانو بصوت يقع بين السوبرانو والكونترالتو)",
 "中﨟": "وصيفة الشرف (سيدة تُعين لخدمة ملكة أو أميرة)",
 "中１": "فِي السَّنَةِ الأُولَى, مُسْتَجِدّ (يُوصَفُ بِهِ الشَّخْصُ فِي سَنَتِهِ الأُولَى مِنْ تَجْرِبَةٍ (خَاصَّةً فِي المَدْرَسَةِ أَوِ الجَامِعَةِ))",
 "中２": "فِي السَّنَةِ الثَّانِيَة (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الثَّانِيَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ أَوِ الجَامِعَةِ الأَمْرِيكِيَّةِ)",
 "中３": "فِي السَّنَةِ الثَّالِثَة (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الثَّالِثَةِ أَوْ مَا قَبْلَ الأَخِيرَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ أَوِ الجَامِعَةِ الأَمْرِيكِيَّةِ)",
 "串": "سَفُّود, سِيخ / بَصَقَ, بَزَقَ (بَصَقَ من باب نَصَرَ؛ لفظ مَا فِي فَمه) / بُزَاق / إِنَابَة, اِسْتِنَابَة (عند السالكين: الرجوع عن الغَفْلَة إلى الذِّكْر)",
 "串かつ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "串カツ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "串刺": "سيخ (دبوس طويل لتثبيت اللحم في موضعه أثناء شيه) / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / ثَاقِب, حَادّ (لَدَيْهِ القُدْرَةُ عَلَى التَّمْيِيزِ الدَّقِيقِ وَالإِدْرَاكِ العَمِيق)",
 "串刺し": "سيخ (دبوس طويل لتثبيت اللحم في موضعه أثناء شيه) / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / ثَاقِب, حَادّ (لَدَيْهِ القُدْرَةُ عَلَى التَّمْيِيزِ الدَّقِيقِ وَالإِدْرَاكِ العَمِيق)",
 "串打ち": "سيخ (دبوس طويل لتثبيت اللحم في موضعه أثناء شيه)",
 "串揚": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "串揚げ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "丸": "دَوَائِر تَحْتَ ٱلْعَيْنَيْن (بمعنى الشكل الذي لا بداية له ولا نهاية بشكل قوس مستمر؛ بمعنى الهيئة أو الجهة الحكومية التي تدير أمرا ما) / كَافَّة, تَمَام / نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال. / سلحفاة لينة الصدفة (سلحفاة مائية شرهة ذات صدفة مرنة مسطحة مغطاة بجلد جلدي؛ يمكن أن تسبب عضات مؤلمة) / كُرَات اللَحْم / حَبَّة دَوَاء (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / قُرْص / حَبّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / حَبَّة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة)\nمثال: أكلت حبة طماطم.",
 "丸々": "سمين / بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان مقتنعاً كلياً",
 "丸々と太った": "بَدِين جِدًّا, سَمِين مُفْرِطًا (مُفْرِط فِي السِّمْنَة والبَدَانَة) / فَخْم, مُسْتَدِير ((للأصوات) ممتلئ وغني) / كُرَوِيّ, مُكَوَّر (كرويّ الشكل؛ مستدير تمامًا)",
 "丸々太った": "بَدِين جِدًّا, سَمِين مُفْرِطًا (مُفْرِط فِي السِّمْنَة والبَدَانَة) / فَخْم, مُسْتَدِير ((للأصوات) ممتلئ وغني) / كُرَوِيّ, مُكَوَّر (كرويّ الشكل؛ مستدير تمامًا)",
 "丸い": "مُسْتَدِير, مُدَوَّر (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / مُسْتَدِير, كُرَوِيّ (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما) / جَوْلَة, مَرْحَلَة / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / مُنْثَنٍ / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً)",
 "丸かっこ": "أَقْوَاس, قَوْس",
 "丸がかえ": "رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر.",
 "丸がっこ": "أَقْوَاس, قَوْس",
 "丸きし": "تَمَامًا",
