 "三ヶ年": "كُلَّ ثَلَاثِ سَنَوَاتٍ (يحدث كل ثلاث سنوات أو يستمر ثلاث سنوات) / مئوية ثالثة (الذكرى 300 (أو الاحتفال بها))",
 "三下": "صغير, طفل (شخص صغير السن من أي من الجنسين) / إمّعة, تافه (شخص صغير وغير مهم)\nمثال: هي تكتب كتباً للأطفال",
 "三下り半": "تَفْرِقَة",
 "三下奴": "صغير, طفل (شخص صغير السن من أي من الجنسين) / إمّعة, تافه (شخص صغير وغير مهم)\nمثال: هي تكتب كتباً للأطفال",
 "三世": "ثَالِث, ثَالِثَة / ثُلْث (ثَلَثَ الحبل ونحوه يَثْلُثُ ثَلْثًا: فَتَلَهُ من ثلاث قُوى؛ ثَلَثَ العمل: عمله ثلات مرات)\nمثال: الساعة العاشرة والثلث.",
 "三乗": "كَعْبَة, مُكَعَّب (بيت مربع الجوانب؛ (حديثًا) مُتَّجَه) / كَعْبَة (بيت مربع الجوانب؛ (حديثًا) مُتَّجَه)\nمثال: الكعبة بيت الله.",
 "三乗根": "الجذر التكعيبي",
 "三人婚": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "三人称": "غَائِب",
 "三人組": "تريو, ثلاثي (تأليف موسيقي لثلاثة مؤديين) / ثالثة, ثلاثي (ثلاثة أشخاص يُنظر إليهم كوحدة واحدة) / ثلاثي (مجموعة من ثلاثة أشياء متشابهة تُعتبر كوحدة واحدة) / ثلاثي (ثلاثة مؤدين أو مغنين يؤدون معاً)",
 "三位": "ثَالُوث",
 "三位一体": "ثَالُوث",
 "三佐": "رَائِد",
 "三倍": "ثلاثة أضعاف (بمعامل ثلاثة)\nمثال: زاد إيجارنا ثلاثة أضعاف في السنوات الخمس الماضية",
 "三倍体": "ثُلَاثِيّ الصِّيغَة الصِّبْغِيَّة (لخلية أو كائن حي يحتوي على ثلاث مجموعات كاملة من الكروموسومات)",
 "三元": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة) / 1 يناير, عيد مريم والدة الله ((الكنيسة الكاثوليكية) يوم مقدس واجب) / 1 يناير, عيد الختان ((الكنيسة الكاثوليكية والكنيسة الأنجليكانية) عيد يحتفل بختان يسوع؛ يُحتفل به في الأول من يناير) / ثُلَاثِيّ (ذو ثلاث وحدات أو مكوّنات أو عناصر) / ثَلَاثَة, ثُلَاثِيّ (العدد الأصلي الذي هو مجموع واحد وواحد وواحد)",
 "三分法": "انقسام ثلاثي (كون الشيء ثلاثياً؛ تصنيف إلى ثلاثة أجزاء أو فئات فرعية)",
 "三十": "ثَلَاثِينَ, ثَلَاثُونَ",
 "三十一文字": "شعب تانكا (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: الجيش يوحد الشعب.",
 "三十三所": "ثَلَاثَة وَثَلَاثُون (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "三十二分音符": "ذات الثلاثة أسن, نوتة اثنين وثلاثين (نوتة موسيقية لها قيمة زمنية تعادل واحد على اثنين وثلاثين من نوتة كاملة)",
 "三十代": "ثَلَاثُونَ (يَدُلُّ عَلَى العَدَد 30) / ثَلَاثُون (العدد الأصلي الذي هو حاصل ضرب عشرة في ثلاثة)",
 "三十年戦争": "حَرْب الثَّلَاثِين عَامًا (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "三十日月": "مُحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…) / مَحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…) / مِحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…)",
 "三千": "ثَلَاثَة آلَاف (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب. / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "三半規管": "قناة هلالية (إحدى ثلاث حلقات أنبوبية مملوءة بسائل وفي مستويات متعامدة تقريباً مع بعضها البعض؛ معنية بالتوازن)",
 "三博士": "مَجُوس",
 "三又槍": "رمح ثلاثي الشعب (رمح له ثلاثة رؤوس مدببة)",
 "三叉戟": "رمح ثلاثي الشعب (رمح له ثلاثة رؤوس مدببة)",
 "三叉槍": "رمح ثلاثي الشعب (رمح له ثلاثة رؤوس مدببة)",
 "三叉神経": "عصب ثلاثي التوائم, عصب قحفي خامس (العصب الحسي الرئيسي للوجه والعصب الحركي لعضلات المضغ)",
 "三叉神経痛": "ألم العصب الثلاثي التوائم (ألم عصبي انتيابي شديد على طول العصب الثلاثي التوائم)",
 "三叉路": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "三号雑誌": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا)",
 "三合会": "ثالوث, كورد ثلاثي (كورد ثلاثي النوتات كبير أو صغير؛ نوتة وثالثتها وخامستها) / ثالثة, ثلاثي (ثلاثة أشخاص يُنظر إليهم كوحدة واحدة) / ثلاثي (مجموعة من ثلاثة أشياء متشابهة تُعتبر كوحدة واحدة) / ثَلَاثَة, ثُلَاثِيّ (العدد الأصلي الذي هو مجموع واحد وواحد وواحد)",
 "三味線": "شَامِيسِين",
 "三和音": "ثالوث, كورد ثلاثي (كورد ثلاثي النوتات كبير أو صغير؛ نوتة وثالثتها وخامستها) / ثالثة, ثلاثي (ثلاثة أشخاص يُنظر إليهم كوحدة واحدة) / ثلاثي (مجموعة من ثلاثة أشياء متشابهة تُعتبر كوحدة واحدة) / ثَلَاثَة, ثُلَاثِيّ (العدد الأصلي الذي هو مجموع واحد وواحد وواحد)",
 "三回": "ثلاثة أضعاف (بمعامل ثلاثة)\nمثال: زاد إيجارنا ثلاثة أضعاف في السنوات الخمس الماضية",
 "三回生": "لِلشَّبَاب, لِلنَّاشِئَة (يشمل الأشخاص اليافعين أو مُعَدّ لهم) / أدنى رتبة, أصغر سناً (أصغر سنًا؛ أدنى رتبة؛ أقصر في مدة الولاية أو الخدمة) / الأَصْغَر, الاِبْن (يُستخدم للأصغر سنًّا من شخصين يحملان الاسم ذاته؛ خاصة لتمييز الابن عن أبيه) / أَصْغَر سِنّاً (الشخص الأصغر سناً بين اثنين)\nمثال: هي أصغر مني بسنتين",
 "三塁": "القاعدة الثالثة (مركز اللعب للاعب في فريق البيسبول المتمركز بالقرب من القاعدة الثالثة في الملعب الداخلي) / القاعدة الثالثة (القاعدة التي يجب أن يلمسها العداء ثالثاً في لعبة البيسبول)\nمثال: هو يلعب في القاعدة الثالثة",
 "三塁手": "لاعب القاعدة الثالثة ((في البيسبول) شخص ذكر يلعب في القاعدة الثالثة)",
 "三塁打": "ضربة ثلاثية (ضربة قاعدة يتوقف عندها الضارب بأمان عند القاعدة الثالثة)",
 "三塩基酸": "حمض ثلاثي القاعدية (حمض يحتوي على ثلاث ذرات هيدروجين قابلة للاستبدال في كل جزيء)",
 "三士": "متطوع, مُجنّد (أي عضو أو مؤيد جديد (كما في القوات المسلحة)) / مجند جديد, مستجد (جندي تم تجنيده حديثاً)",
 "三寸": "بائع متجول لبضائع رديئة (بائع لبضائع رديئة) / كاتب إعلانات (شخص يكتب إعلانات الراديو أو التلفزيون)",
 "三尉": "ملازم ثان (ضابط مفوض في الجيش أو القوات الجوية أو المارينز يحمل أدنى رتبة)",
 "三尖弁": "صمام ثلاثي الشرف (صمام ذو ثلاث شرفات؛ يقع بين الأذين الأيمن والبطين الأيمن؛ يسمح للدم بالمرور من الأذين إلى البطين ويغلق لمنع التدفق العكسي عند انقباض البطين)",
 "三尺": "تِكَّة, حِزَام (في و: هو الشُقَف)",
 "三尺帯": "تِكَّة, حِزَام (في و: هو الشُقَف)",
 "三差路": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "三平方の定理": "مُبَرْهَنَةْ فِيثَاغُورَس",
 "三年生": "فِي السَّنَةِ الثَّالِثَة (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الثَّالِثَةِ أَوْ مَا قَبْلَ الأَخِيرَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ أَوِ الجَامِعَةِ الأَمْرِيكِيَّةِ)",
 "三度": "ثلاثة أضعاف (بمعامل ثلاثة)\nمثال: زاد إيجارنا ثلاثة أضعاف في السنوات الخمس الماضية / ثَالِث, ثَالِثَة / ثُلْث (ثَلَثَ الحبل ونحوه يَثْلُثُ ثَلْثًا: فَتَلَهُ من ثلاث قُوى؛ ثَلَثَ العمل: عمله ثلات مرات)\nمثال: الساعة العاشرة والثلث. / ثلاثة أضعاف (بمعامل ثلاثة)\nمثال: زاد إيجارنا ثلاثة أضعاف في السنوات الخمس الماضية / مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "三度の和音": "ثالوث, كورد ثلاثي (كورد ثلاثي النوتات كبير أو صغير؛ نوتة وثالثتها وخامستها)",
 "三度入り": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "三度豆": "فاصولياء شائعة (أي من أنواع الفاصولياء العديدة التي تؤكل طازجة أو مجففة) / فاصولياء شائعة (نبات الفاصولياء الحولي المتسلق أو الشجيري الشائع الذي يزرع لبذوره أو قرونه الصالحة للأكل) / بازلاء ثلجية, بازلاء سكرية (بازلاء خضراء ذات قرون مسطحة صالحة للأكل) / بازلاء ثلجية, بازلاء سكرية (صنف من نبات البازلاء ينتج بازلاء ذات قرون مسطحة رقيقة صالحة للأكل)",
 "三弦": "شَامِيسِين",
 "三従兄弟": "قريب من الدرجة الثانية (ابن ابن عم أو ابن خال أحد الوالدين)",
 "三徳包丁": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "三才": "بِعُمُر ثَلَاث سَنَوَات (في عامه الثالث من العمر)",
 "三拍子": "وزن ثلاثي (زمن موسيقي بثلاث نقرات في كل مقياس)",
 "三拝九拝": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "三指樹懶": "كسلان ثلاثي الأصابع (حيوان الكسلان الذي يمتلك ثلاثة مخالب طويلة في كل قدم أمامية وخلفية)",
 "三振": "خروج بالضربات, سترايك آوت (خروج ناتج عن حصول الضارب على ثلاث ضربات (سترايك))",
 "三摩耶": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم.",
 "三擦り半": "سرعة القذف, قذف مبكر (القذف خلال المراحل المبكرة من الإثارة الجنسية أو بعد فترة وجيزة من إيلاج القضيب في المهبل)",
 "三文": "رُخْص (رَخُصَ يَرْخُصُ رَخاصةً ورُخوصةً ورُخْصانًا: نَعُم ولان؛ فهو رَخْص ورَخِيص)\nمثال: هل تملك رخصة قيادة؟",
 "三文判": "جاهز, معد مسبقاً (مصنوع للشراء والاستخدام الفوري) / جَاهِز, مُعَدٌّ تِجَارِيًّا (مُنتَج تجارياً وليس منزلي الصنع) / جَاهِز, نَمَطِيّ (يتكرر بانتظام دون تفكير أو أصالة) / غرض جاهز الصنع, منتج جاهز (منتج مصنّع (كملابس أو قطعة أثاث) يتم صنعه مسبقاً ويكون متاحاً للشراء)\nمثال: شقتهم كانت مؤثثة بأثاث جاهز",
 "三文小説": "رواية تجارية, رواية رخيصة (رواية ورقية ميلودرامية رخيصة الثمن)",
 "三文役者": "مِنَ الدَّرَجَة الثَّالِثَة (أقل جودة من الدرجة الثانية)",
 "三文文士": "كاتب مأجور (كاتب متواضع المستوى ومحتقر (يكتب من أجل المال فقط دون اهتمام بالجودة))",
 "三文芝居": "رَقِيقٌ كَالغَزْل, شَفَّاف (بَالِغُ الرِّقَّةِ بِحَيْثُ يَنْفُذُ مِنْهُ الضَّوْء)",
 "三方": "مُياوِم",
 "三方よし": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "三方良し": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "三日とあげず": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: العالم يتغير باستمرار",
 "三日と上げず": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: العالم يتغير باستمرار",
 "三日にあげず": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: العالم يتغير باستمرار",
 "三日に上げず": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: العالم يتغير باستمرار",
 "三日はしか": "حصبة ألمانية (مرض فيروسي معدٍ هو شكل أخف من الحصبة يستمر ثلاثة أو أربعة أيام؛ يمكن أن يضر بالجنين خلال الأشهر الثلاثة الأولى)",
 "三日ばしか": "حصبة ألمانية (مرض فيروسي معدٍ هو شكل أخف من الحصبة يستمر ثلاثة أو أربعة أيام؛ يمكن أن يضر بالجنين خلال الأشهر الثلاثة الأولى)",
 "三日コロリ": "كُولِيرَا, هَيْضَة",
 "三日天下": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا)",
 "三日月": "هِلَال",
 "三日月湖": "بحيرة متروكة, بحيرة هلالية (بحيرة على شكل هلال (مؤقتة غالباً) تتشكل عندما ينفصل تعرج للنهر عن القناة الرئيسية)",
 "三日麻疹": "حصبة ألمانية (مرض فيروسي معدٍ هو شكل أخف من الحصبة يستمر ثلاثة أو أربعة أيام؛ يمكن أن يضر بالجنين خلال الأشهر الثلاثة الأولى)",
 "三昧耶": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم.",
 "三時のおやつ": "شاي, شاي بعد الظهر (وجبة خفيفة بعد الظهر تتكون من الشاي والشطائر أو الكعك)",
 "三時のお八つ": "شاي, شاي بعد الظهر (وجبة خفيفة بعد الظهر تتكون من الشاي والشطائر أو الكعك)",
 "三曹": "رَقِيب, عَرِيف (اَلرَّقِيبُ: من أسماء الله الحسنى، ومعناه: الْحَافِظُ الذي لا يغيب عنه شيء، ولا تخفى عليه خافية، والذي لا يغفل عمّا خلق…؛ فَاعِلٌ مِنْ رَقَبَ)",
 "三月": "مَسِيرَة / لَحْن السَّيْر, مَارْش (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز) / سَارَ (مَشَى)\nمثال: أنا أحب هذا اللحن.",
 "三本": "ثَلَاثَة, ثَلَاث (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "三板": "سامبان (قارب آسيوي صغير يُدفع عادة بمجدافين)",
 "三枚つづき": "تريبتيك, لوحة ثلاثية (فن يتكون من لوحة أو نحت (خاصة كقطعة مذبح) على ثلاثة ألواح (عادة ما تكون مفصلية معاً))",
 "三枚目": "كُومِيدْيَان / أُضْحُوكَة, مَضْحَكَة",
 "三枚絵": "تريبتيك, لوحة ثلاثية (فن يتكون من لوحة أو نحت (خاصة كقطعة مذبح) على ثلاثة ألواح (عادة ما تكون مفصلية معاً))",
 "三枚続": "تريبتيك, لوحة ثلاثية (فن يتكون من لوحة أو نحت (خاصة كقطعة مذبح) على ثلاثة ألواح (عادة ما تكون مفصلية معاً))",
 "三枚続き": "تريبتيك, لوحة ثلاثية (فن يتكون من لوحة أو نحت (خاصة كقطعة مذبح) على ثلاثة ألواح (عادة ما تكون مفصلية معاً))",
 "三柱門": "خَوْخَة",
 "三次": "ثَالِث, ثَالِثَة / ثُلْث (ثَلَثَ الحبل ونحوه يَثْلُثُ ثَلْثًا: فَتَلَهُ من ثلاث قُوى؛ ثَلَثَ العمل: عمله ثلات مرات)\nمثال: الساعة العاشرة والثلث. / ثَالِث (العَدَد التَّرْتِيبِيّ 3) / مُكَعَّب",
 "三次元": "ثلاثي الأبعاد (ذو شكل أو مظهر ثلاثي الأبعاد) / ثلاثي الأبعاد (فيلم بصور لها شكل أو مظهر ثلاثي الأبعاد)\nمثال: أليست الأحلام دائماً ثلاثية الأبعاد؟ / عَالَم وَاقِعِيّ (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "三次元プリンタ": "طَابِعَة ثَلَاثِيّة الأَبْعَاد",
 "三次元プリンター": "طَابِعَة ثَلَاثِيّة الأَبْعَاد",
 "三歩下がって": "بتواضع (بطريقة متواضعة) / ببخل, بتقتير (بطريقة بخيلة)\nمثال: خفض رأسه بتواضع",
 "三歳": "بِعُمُر ثَلَاث سَنَوَات (في عامه الثالث من العمر)",
 "三段構え": "ثُلَاثِيّ",
 "三段腹": "مدفأة كرشية, موقد منتفخ (موقد منتفخ الشكل يتم فيه حرق الحطب أو الفحم) / كرش (مصطلحات عامية للكرش أو البطن البارز)",
 "三段論法": "قياس منطقي (استدلال استنتاجي يتم فيه استخلاص نتيجة من مقدمتين)",
 "三段跳": "القفز الثلاثي, الوثب الثلاثي (مسابقة رياضية يجب على المنافس فيها أداء قفزة وخطوة وقفزة بشكل متواصل)",
 "三段跳び": "القفز الثلاثي, الوثب الثلاثي (مسابقة رياضية يجب على المنافس فيها أداء قفزة وخطوة وقفزة بشكل متواصل)",
 "三毛": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً) / كاليكو, منقط (مصنوع من الكاليكو (قماش قطني) أو يشبه الكاليكو في كونه منقوشاً) / كاليكو (قماش خشن ذو طباعة زاهية)\nمثال: فساتين كاليكو / قط ذبل, قط كاليكو (قط ذو علامات سوداء وكريمية وصفراء)",
 "三毛猫": "قط ذبل, قط كاليكو (قط ذو علامات سوداء وكريمية وصفراء)",
 "三水": "فَسَاد / كُحُول, مَشْرُوب كُحُولِيّ (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول.",
 "三流": "مِنَ الدَّرَجَة الثَّالِثَة (أقل جودة من الدرجة الثانية)",
 "三温糖": "سكر بني (سكر غير مكرر أو مكرر جزئياً فقط)",
 "三点リーダ": "حَذْف, إِضْمَار (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ؛ حَذَفَهُ بِالعَصَا: ضَرَبَهُ ، ورَمَاهُ بِها)\nمثال: حذف ياني حسابه.",
 "三点リーダー": "حَذْف, إِضْمَار (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ؛ حَذَفَهُ بِالعَصَا: ضَرَبَهُ ، ورَمَاهُ بِها)\nمثال: حذف ياني حسابه.",
 "三環系抗うつ剤": "مضاد اكتئاب ثلاثي الحلقات (دواء مضاد للاكتئاب يعمل عن طريق منع استرداد النوربينفرين والسيروتونين وبالتالي إتاحة المزيد من هذه المواد للعمل على المستقبلات في الدماغ)",
 "三環系抗うつ薬": "مضاد اكتئاب ثلاثي الحلقات (دواء مضاد للاكتئاب يعمل عن طريق منع استرداد النوربينفرين والسيروتونين وبالتالي إتاحة المزيد من هذه المواد للعمل على المستقبلات في الدماغ)",
 "三界": "قَصِيّ, نَائٍ جِدًّا (بعيد جدّاً في المكان أو الزمان)",
 "三番": "ثَالِث, ثَالِثَة / ثُلْث (ثَلَثَ الحبل ونحوه يَثْلُثُ ثَلْثًا: فَتَلَهُ من ثلاث قُوى؛ ثَلَثَ العمل: عمله ثلات مرات)\nمثال: الساعة العاشرة والثلث.",
 "三番勝負": "مَطَّاط",
 "三百": "ثَلَاثُمِئَة (يَدُلُّ عَلَى العَدَد 300) / مراوغ (شخص (خاصة محامٍ أو سياسي) يستخدم أساليب عديمة الضمير أو غير أخلاقية)",
 "三百代言": "مراوغ (شخص (خاصة محامٍ أو سياسي) يستخدم أساليب عديمة الضمير أو غير أخلاقية) / سفسطائي (شخص يكون استدلاله دقيقاً وغالباً ما يكون خادعاً)",
 "三目並べ": "إكس أو, تيك تاك تو (لعبة يضع فيها لاعبان بالتناوب صلباناً ودوائر في أحد أقسام شبكة مربعة من تسع مساحات؛ الهدف هو الحصول على صف من ثلاثة صلبان أو ثلاث دوائر قبل الخصم)",
 "三稜鏡": "مَنْشُور / مَوْشُور",
 "三竦み": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "三等": "درجة سياحية (أماكن إقامة غير مكلفة على متن سفينة أو قطار) / بريد الدرجة الثالثة (بريد يتكون من مواد مطبوعة مؤهلة لأسعار بريدية مخفضة)",
 "三等分": "ثَلَّثَ الزَاوِيَة (ثَلَثَ الحبل ونحوه يَثْلُثُ ثَلْثًا: فَتَلَهُ من ثلاث قُوى؛ ثَلَثَ العمل: عمله ثلات مرات)\nمثال: الساعة العاشرة والثلث.",
 "三等空曹": "رقيب أركان (ضابط صف رتبته أعلى من عريف وأقل من رقيب أول في الجيش أو المارينز)",
 "三等軍曹": "رَقِيب, عَرِيف (اَلرَّقِيبُ: من أسماء الله الحسنى، ومعناه: الْحَافِظُ الذي لا يغيب عنه شيء، ولا تخفى عليه خافية، والذي لا يغفل عمّا خلق…؛ فَاعِلٌ مِنْ رَقَبَ)",
 "三等重役": "مِنَ الدَّرَجَة الثَّالِثَة (أقل جودة من الدرجة الثانية)",
 "三等陸佐": "رَائِد",
 "三等陸尉": "ملازم ثان (ضابط مفوض في الجيش أو القوات الجوية أو المارينز يحمل أدنى رتبة)",
 "三等陸曹": "رَقِيب, عَرِيف (اَلرَّقِيبُ: من أسماء الله الحسنى، ومعناه: الْحَافِظُ الذي لا يغيب عنه شيء، ولا تخفى عليه خافية، والذي لا يغفل عمّا خلق…؛ فَاعِلٌ مِنْ رَقَبَ)",
 "三筋": "شَامِيسِين",
 "三箇年": "كُلَّ ثَلَاثِ سَنَوَاتٍ (يحدث كل ثلاث سنوات أو يستمر ثلاث سنوات) / مئوية ثالثة (الذكرى 300 (أو الاحتفال بها))",
 "三糖": "سكر ثلاثي (أي من مجموعة متنوعة من الكربوهيدرات التي تنتج ثلاثة جزيئات من السكر الأحادي عند التحلل المائي الكامل)",
 "三糖類": "سكر ثلاثي (أي من مجموعة متنوعة من الكربوهيدرات التي تنتج ثلاثة جزيئات من السكر الأحادي عند التحلل المائي الكامل)",
 "三級": "درجة سياحية (أماكن إقامة غير مكلفة على متن سفينة أو قطار) / بريد الدرجة الثالثة (بريد يتكون من مواد مطبوعة مؤهلة لأسعار بريدية مخفضة)",
 "三絃": "شَامِيسِين",
 "三線": "شَامِيسِين",
 "三羽がらす": "تريو, ثلاثي (تأليف موسيقي لثلاثة مؤديين) / ثالثة, ثلاثي (ثلاثة أشخاص يُنظر إليهم كوحدة واحدة) / ثلاثي (مجموعة من ثلاثة أشياء متشابهة تُعتبر كوحدة واحدة) / ثلاثي (ثلاثة مؤدين أو مغنين يؤدون معاً)",
 "三羽ガラス": "تريو, ثلاثي (تأليف موسيقي لثلاثة مؤديين) / ثالثة, ثلاثي (ثلاثة أشخاص يُنظر إليهم كوحدة واحدة) / ثلاثي (مجموعة من ثلاثة أشياء متشابهة تُعتبر كوحدة واحدة) / ثلاثي (ثلاثة مؤدين أو مغنين يؤدون معاً)",
 "三羽烏": "تريو, ثلاثي (تأليف موسيقي لثلاثة مؤديين) / ثالثة, ثلاثي (ثلاثة أشخاص يُنظر إليهم كوحدة واحدة) / ثلاثي (مجموعة من ثلاثة أشياء متشابهة تُعتبر كوحدة واحدة) / ثلاثي (ثلاثة مؤدين أو مغنين يؤدون معاً)",
 "三者会談": "ثُلَاثِيّ (يشمل مجموعة أو ثلاثة أطراف) / ثُلَاثِيُّ الأَرْكَانِ (ذو ثلاثة أركان أو زوايا)",
 "三者対立": "ثُلَاثِيّ (يشمل مجموعة أو ثلاثة أطراف) / ثُلَاثِيُّ الأَرْكَانِ (ذو ثلاثة أركان أو زوايا)",
 "三者鼎立": "ثُلَاثِيّ (يشمل مجموعة أو ثلاثة أطراف) / ثُلَاثِيُّ الأَرْكَانِ (ذو ثلاثة أركان أو زوايا)",
 "三脚": "حامل ثلاثي القوائم (رف بثلاثة أرجل يستخدم للدعم)",
 "三脚椅子": "ثُلَاثِيّ الأَرْجُل (لَهُ ثَلاث أَرْجُل أَوْ ما يُشْبِهُها)",
 "三色すみれ": "شاذ (مصطلح مهين لرجل مثلي الجنس) / جبان, مخنث (رجل أو صبي خجول يعتبر طفولياً أو غير حازم) / بانسي, زهرة الثالوث (نبات حديقة كبير الزهر مشتق أساساً من البانسي البري في أوروبا وله بتلات مخملية بألوان مختلفة) / بانسي بري, زهرة الثالوث البرية (عشبة أوروبية شائعة ومزروعة منذ فترة طويلة تشتق منها معظم زهور البانسي الشائعة في الحدائق)",
 "三色スミレ": "شاذ (مصطلح مهين لرجل مثلي الجنس) / جبان, مخنث (رجل أو صبي خجول يعتبر طفولياً أو غير حازم) / بانسي, زهرة الثالوث (نبات حديقة كبير الزهر مشتق أساساً من البانسي البري في أوروبا وله بتلات مخملية بألوان مختلفة) / بانسي بري, زهرة الثالوث البرية (عشبة أوروبية شائعة ومزروعة منذ فترة طويلة تشتق منها معظم زهور البانسي الشائعة في الحدائق)",
 "三色菫": "شاذ (مصطلح مهين لرجل مثلي الجنس) / جبان, مخنث (رجل أو صبي خجول يعتبر طفولياً أو غير حازم) / بانسي, زهرة الثالوث (نبات حديقة كبير الزهر مشتق أساساً من البانسي البري في أوروبا وله بتلات مخملية بألوان مختلفة) / بانسي بري, زهرة الثالوث البرية (عشبة أوروبية شائعة ومزروعة منذ فترة طويلة تشتق منها معظم زهور البانسي الشائعة في الحدائق)",
 "三葉": "نَفَل (الثَلَاثُ النُفَل: الليلة الرابعة والخامسة والسادسة من كل شهر قمري…)",
 "三葉虫": "ثلاثي الفصوص (مفصلي منقرض كان وفيراً في عصور حقب الحياة القديمة؛ كان له هيكل خارجي مقسم إلى ثلاثة أجزاء)",
 "三行半": "تَفْرِقَة",
 "三行広告欄": "إِعْلَان مُبَوَّب (إعلان قصير في صحيفة أو مجلة (عادة بخط صغير) ويظهر مع إعلانات أخرى من نفس النوع)",
 "三角": "مُثَلَّث",
 "三角バラ": "ضلوع قصيرة من الكتف (تقع بين منطقة التشاك (الكتف) والبريسكت (الصدر))",
 "三角函数": "دَالَّة دَائِرِيَّة, دَالَّة مُثَلَّثِيَّة (دالة لزاوية معبر عنها كنسبة لطول أضلاع مثلث قائم الزاوية يحتوي على الزاوية)",
 "三角定規": "مُثَلَّث",
 "三角州": "دِلْتَا (مثلث كحرف الدال اليوناني)",
 "三角巾": "حمالة الذراع, وشاح طبي (ضمادة لدعم الساعد المصاب؛ تتكون من قطعة قماش مثلثة عريضة تتدلى حول الرقبة) / عِصَابَة, عِصَابَةُ رَأْس",
 "三角帽": "ثُلَاثِيّ (يشمل مجموعة أو ثلاثة أطراف) / ثُلَاثِيُّ الأَرْكَانِ (ذو ثلاثة أركان أو زوايا)",
 "三角帽子": "ثُلَاثِيّ (يشمل مجموعة أو ثلاثة أطراف) / ثُلَاثِيُّ الأَرْكَانِ (ذو ثلاثة أركان أو زوايا)",
 "三角座": "مُثَلَّث",
 "三角形": "مُثَلَّث",
 "三角柱": "منشور مثلثي (منشور قاعدتاه مثلثات)",
 "三角江": "مَصَبّ, فُغْرَة",
 "三角法": "عِلْم اَلْمُثَلَثَات, عِلْم حِسَاب اَلْمُثَلَثَات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "三角洲": "دِلْتَا (مثلث كحرف الدال اليوناني)",
 "三角測量": "تثليث, حساب المثلثات (طريقة للمسح؛ يتم تقسيم المنطقة إلى مثلثات ويتم قياس طول جانب واحد وزواياه مع الجانبين الآخرين، ثم يمكن حساب أطوال الجوانب الأخرى) / تثليث, حساب المثلثات (طريقة مثلثية لتحديد موقع نقطة ثابتة من الزوايا إليها من نقطتين ثابتتين بمسافة معروفة)",
 "三角琴": "قيثارة مثلثة (قيثارة مثلثة الشكل من اليونان وروما القديمة) / مثلث ((في التنجيم) واحدة من أربع مجموعات من الأبراج، حيث تتكون كل مجموعة من ثلاثة أبراج تفصل بينها 120 درجة) / مثلث (مضلع له ثلاثة أضلاع)",
 "三角竜": "تَرَيْسِيرَاتُوپْس",
 "三角筋": "دَالِيّ الشَّكْل, مُثَلَّثِيّ (مُثلَّث أو يُوحي بشكل مُثلَّث مع نقطة في القمّة) / عضلة دالية (عضلة مثلثة كبيرة تغطي مفصل الكتف وتعمل على إبعاد وثني ومد وتدوير الذراع)",
 "三角翼": "جناح دلتا, طائرة بجناح دلتا (طائرة ذات أجنحة تمنحها مظهر مثلث متساوي الساقين)",
 "三角草": "ماركانتيا بوليمورفا, هيباتيكا (حشيشة كبد شائعة) / حشيشة الكبد, هيباتيكا (أي من عدة نباتات من جنس هيباتيكا ذات أوراق ثلاثية الفصوص وأزهار بيضاء أو وردية في أوائل الربيع؛ توجد في مناطق الغابات الرطبة والمغطاة بالطحالب في…)",
 "三角関係": "مُثَلَّث حُبّ, ثُلَاثِيَّة حُبّ",
 "三角関数": "دَالَّة دَائِرِيَّة, دَالَّة مُثَلَّثِيَّة (دالة لزاوية معبر عنها كنسبة لطول أضلاع مثلث قائم الزاوية يحتوي على الزاوية)",
 "三角闘争": "ثُلَاثِيّ (يشمل مجموعة أو ثلاثة أطراف) / ثُلَاثِيُّ الأَرْكَانِ (ذو ثلاثة أركان أو زوايا)",
 "三角骨": "عظم مثلثي (عظم رسغي يتمفصل مع العظام الحمصية والكلابية والهلالية)",
 "三足": "حامل ثلاثي القوائم (رف بثلاثة أرجل يستخدم للدعم)",
 "三路スイッチ": "ذُو اِتِّجَاهَيْن (يعمل أو يسمح بالعمل في أي من اتجاهين متعاكسين) / ثُنَائِيّ, مِن جُزْأَيْن (يتضمن جزأين أو عنصرين) / ثُنَائِيُّ الحِزْبِيَّة (مَدْعُومٌ مِنْ كِلَا الجَانِبَيْن)",
 "三連符": "ثلاثي (مجموعة من ثلاثة أشياء متشابهة تُعتبر كوحدة واحدة) / توأم ثلاثي (واحد من ثلاثة أبناء ولدوا في نفس الوقت من نفس الحمل) / ثَلَاثَة, ثُلَاثِيّ (العدد الأصلي الذي هو مجموع واحد وواحد وواحد)",
 "三連音符": "ثلاثي (مجموعة من ثلاثة أشياء متشابهة تُعتبر كوحدة واحدة) / توأم ثلاثي (واحد من ثلاثة أبناء ولدوا في نفس الوقت من نفس الحمل) / ثَلَاثَة, ثُلَاثِيّ (العدد الأصلي الذي هو مجموع واحد وواحد وواحد)",
 "三遊間": "ثَقْب, حُفْرة (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / تقب\nمثال: انه ثقب الاسود.",
 "三遍": "ثلاثة أضعاف (بمعامل ثلاثة)\nمثال: زاد إيجارنا ثلاثة أضعاف في السنوات الخمس الماضية",
 "三部会": "المجلس العمومي الفرنسي, الولايات العامة الفرنسية (جمعية تمثل فئات فرنسا بأكملها؛ كان آخر اجتماع لها في عام 1789)",
 "三部作": "ثُلَاثِيَّة",
 "三重": "ثُلَاثِيّ / مِيِه",
 "三重殺": "إخراج ثلاثي, لعبة ثلاثية (فعل إخراج ثلاثة لاعبين في لعبة واحدة)",
 "三重母音": "تْرِفْثُنْغ",
 "三重水素": "تريتيوم (نظير مشع للهيدروجين؛ ذرات التريتيوم لها ثلاثة أضعاف كتلة ذرات الهيدروجين العادي)",
 "三重結び": "عقدة ماغنوس (عقدة انزلاقية تشبه العقدة الوتدية)",
 "三重陽子": "تْرَايْتُون",
 "三量体": "تريمر, ثلاثي الوحدات (بوليمر (أو جزيء من بوليمر) يتكون من ثلاثة مونومرات متطابقة)",
 "三面六臂": "تعدد المهارات, موسوعية (امتلاك مجموعة واسعة من المهارات)",
 "三面鏡": "ثُلَاثِيّ الأَضْلَاع (ذو ثلاثة أضلاع)",
 "三頭政治": "حكم ثلاثي, مجلس ثلاثي (مجموعة من ثلاثة رجال مسؤولين عن الإدارة العامة أو السلطة المدنية)",
 "三頭筋": "ذَات اَلثَّلَاث رُؤُوسّ, مُثَلَّثَة اَلرُّؤُوس",
 "上": "أَعْلَى (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / فَوقَ / شَمَالِيّ / على (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذها إلى الأعلى. / قِمَّة / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو / أَعْلَى, عُلْيَا (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / عُلْوِيّ, فَوْقَانِيّ\nمثال: خذها إلى الأعلى. / قِمَّة / قَدِيماً / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة. / بِخُصُوص, فِيمَا يَتَعَلَّقُ بِـ / عَلَى (يفيد الاستعلاء؛ يفيد التعليل) / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / عَلَى حِسَابِهِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / أَفْضَل",
 "上々": "مُمْتَاز, فَاخِر",
 "上あご": "فك علوي (الفك في الفقاريات الذي يندمج مع القحف)",
 "上から": "مُتَعَال, اِسْتِعْلَائِيّ",
 "上がったり": "محكوم, مَحْكُوم (خاضِع إِدَارَةحُكُوْمَة؛ الَّذي صَدَرَحُكْمٌ بحقِّه)",
 "上がり": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه. / دَخْل, إِيرَاد (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى. / إتمام, إكمال (إجراء ختامي أو نهائي) / تمريرة ناجحة ((كرة القدم الأمريكية) تمريرة أمامية ناجحة في كرة القدم) / فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "上がりこむ": "أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "上がり下がり": "تَذَبذُب, تَقَلُّب",
 "上がり口": "دُخُول / مَدْخَل",
 "上がり場": "رصيف إنزال, مرسى (هيكل يوفر مكاناً يمكن للقوارب فيه إنزال الأشخاص أو البضائع) / غُرْفَة الْمَلَابِس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "上がり段": "بَيْتُ الدَّرَج, دَرَج (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "上がり物": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "上がり症": "الرهاب الاجتماعي (أي رهاب (بخلاف رهاب الخلاء) يرتبط بمواقف تكون فيها عرضة لانتقاد الآخرين (مثل الخوف من الأكل في الأماكن العامة أو التحدث أمام الجمهور وغيرها))",
 "上がり端": "دُخُول / مَدْخَل",
 "上がり花": "شَايْ أَخْضَر (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة)\nمثال: صب الشاي لضيفك.",
 "上がり込む": "أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "上がり高": "إِيرَاد",
 "上がる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه. / أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى. / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا. / حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "上くちびる": "جَاضِم",
 "上げ": "سيف ذو حدين (سيف مستقيم بنصل ضيق وحدين) / ثنية مخيطة (طية ضيقة مسطحة مثبتة بالخياطة) / انثناء, تكور ((في الرياضة) وضعية جسدية تُتخذ في بعض الرياضات (مثل الغوص أو التزلج) حيث يتم ثني الركبتين وسحب الفخذين بالقرب من الصدر) / تسالي, حلويات (مأكولات (خاصة الحلويات)) / نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا. / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "上げ下げ": "تَذَبذُب, تَقَلُّب / تحوير",
 "上げ下げ窓": "نافذة مزدوجة الرفع (نافذة لها درفتان تنزلقان لأعلى ولأسفل)",
 "上げ底": "قاع زائف (هيكل أفقي يقسم سفينة أو صندوقاً (خاصةً ذلك المبني بالقرب من القاع الفعلي)) / مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "上げ弓": "سحبة قوس لأعلى (ضربة لأعلى من طرف القوس إلى كعبه)",
 "上げ板": "باب أرضي, باب سحري (باب مفصلي أو منزلق في أرضية أو سقف)",
 "上げ潮": "فيضان, مد صاعد (حدوث تدفق المياه للداخل (بين الجزر والمد العالي التالي))\nمثال: مد في شؤون البشر، إذا أُخذ في ذروته، يقود إلى الثروة / طفرة, فورة (زيادة قوية مفاجئة) / تلاطم, موجة عارمة (موجة بحرية كبيرة) / اندفاع, فورة (تدفق قوي مفاجئ)\nمثال: حفزت طفرة من المضاربة",
 "上げ相場": "سوق صاعدة (سوق يتميز بارتفاع أسعار الأوراق المالية)",
 "上げ窓": "تَمْرِين اَلضَّغَط",
 "上げ蓋": "باب أرضي, باب سحري (باب مفصلي أو منزلق في أرضية أو سقف)",
 "上げ足": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "上げ銭": "عُمُولَة",
 "上げ離す": "قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "上げ頚": "طوق, قلادة ضيقة (قلادة تلتف بإحكام حول عنق المرأة) / طوق الرقبة, ياقة (شريط يحيط بالرقبة وعادة ما يكون مطوياً) / شريط الياقة, طوق العنق (شريط حول ياقة الملابس)",
 "上げ頸": "طوق, قلادة ضيقة (قلادة تلتف بإحكام حول عنق المرأة) / طوق الرقبة, ياقة (شريط يحيط بالرقبة وعادة ما يكون مطوياً) / شريط الياقة, طوق العنق (شريط حول ياقة الملابس)",
 "上さん": "زَوْجَة, اِمْرَأَة / مالكة العقار (مالك عقار أنثى)",
 "上す": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "上すべり": "سَطْحِيّ / تافه, طائش (غير جاد في المحتوى أو الموقف أو السلوك)\nمثال: رواية تافهة",
 "上せる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "上っ側": "أعلى, قمة (الجانب الأعلى أو الأرفع لأي شيء)\nمثال: ضع كتبك على سطح المكتب",
 "上っ張り": "إِجْمَالِيّ, شَامِل (يتناول السمات الرئيسية فقط) / إِجْمَالِيّ, شَامِل (يشمل كل شيء بلا استثناء) / أفرول, سروال عمل ((عادة جمع) ملابس عمل تتكون من سراويل دنيم (عادة بمريلة وحمالات كتف)) / أفرول, بدلة عمل (رداء واقٍ فضفاض أو مريول يرتدى فوق الملابس العادية للعمل المتسخ)",
 "上っ皮": "بُشَيْرَة",
 "上っ調子": "خَفِيف العَقْل, مُسْتَخِفّ (يُظهر خفّة غير لائقة في موضع يستدعي الجدّية)",
 "上っ面": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح.",
 "上つき": "علوي, مرتفع (نص) (مكتوب أو مطبوع فوق وإلى جانب حرف آخر) / حرف علوي, نص مرتفع (حرف أو رمز يوضع أو يُطبع أو يُكتب فوق وإلى جانب حرف آخر مباشرة)",
 "上つ方": "نَبِيل, شريف (اَلذَّكِيُّ؛ اَلنَّجِيبُ) / كَرِيم, شَرِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: إنها امرأة نبيلة.",
 "上では": "طِبْقًا لِـ, وَفْقًا لِـ / بِالنِّسْبَة لِـ",
 "上の人": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو / ـهُم / ـهُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / ـهُمَا / إِيَّاهُم / إِيَّاهُنَّ / إيَّاهُمَا\nمثال: هن يحببن الجاز.",
 "上の名前": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "上の空": "شرود, عدم انتباه (قلة الانتباه أو عدم التركيز)",
 "上は": "بِمَا أَنّ, أَمَا وَأَنّ",
 "上り": "صُعُود, تَسَلُّق / مُتَّجِهٌ لِلْأَعْلَى (يَسِيرُ فِي اتِّجَاهٍ يُعْتَبَرُ تَقْلِيدِيًّا صُعُودًا) / ضد التيار, نحو المنبع (نحو المصدر أو عكس التيار) / ضد التيار, عكس التيار (في الاتجاه المعاكس لتيار النهر)",
 "上りリンク": "إرسال صاعد, وصلة صاعدة (إرسال من الأرض إلى مركبة فضائية أو مسار مثل هذا الإرسال)",
 "上り勾配": "تَرْقِيَة",
 "上り口": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "上り坂": "صُعُود, تَسَلُّق / انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "上り段": "عَتَبَةُ الْبَابِ",
 "上り端": "دُخُول / مَدْخَل",
 "上り調子": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "上る": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه. / أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى. / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا. / حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة. / صَعِد / يقرب / طَلَعَ",
 "上を下へ": "اِحْتَارَ / تَشَوَّش / اِرْتَبَكَ, تَشَوَّش",
 "上を向いて歩こう": "سوكيياكي",
 "上を行く": "فَاقَ, تَجَاوَزَ",
 "上上": "مُمْتَاز, فَاخِر",
 "上下": "ذهاباً وإياباً, صعوداً وهبوطاً (التحرك للخلف وللأمام على طول مسار معين) / صُعُودًا وَهُبُوطًا, مِنْ أَعْلَى إلى أَسْفَل (بالتبادل بين الاتجاهين العلوي والسفلي)\nمثال: مشى ذهاباً وإياباً في غرفة تبديل الملابس / رَأْسًا عَلَى عَقِب, مَقْلُوب (في وضع انعكس فيه الأعلى والأسفل) / في كل حدب وصوب, في كل مكان (في كل مكان (عالياً ومنخفضاً))\nمثال: بحث في كل مكان / مُتَذَبْذِب, مُتَقَلِّب (يشهد صعودًا وهبوطًا غير قابلَيْن للتنبؤ) / قطعتان ((للملابس) مصنوع من أو يتكون من جزأين أو قطعتين) / بيكيني (ملابس سباحة نسائية قصيرة جداً) / بدلة من قطعتين (بدلة عمل تتكون من سترة وتنورة أو بنطال متطابقين)\nمثال: ملابس سباحة من قطعتين",
 "上下さかさま": "رأساً على عقب, مقلوباً (في وضع مقلوب)\nمثال: كان الصندوق ملقى على الأرض مقلوباً",
 "上下列": "سِلْسِلَة",
 "上下逆さま": "رأساً على عقب, مقلوباً (في وضع مقلوب)\nمثال: كان الصندوق ملقى على الأرض مقلوباً",
 "上下逆様": "رأساً على عقب, مقلوباً (في وضع مقلوب)\nمثال: كان الصندوق ملقى على الأرض مقلوباً",
 "上下関係": "تسلسل هرمي, هرمية (تنظيم الأشخاص في مراتب ودرجات مختلفة داخل هيئة إدارية)",
 "上下限": "حد, حدود (الخط أو المستوى الذي يشير إلى حد أو مدى شيء ما)",
 "上世": "تَارِيخ قَدِيم (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "上乗": "مُمْتَاز, فَاخِر",
 "上乗せ": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول.",
 "上乗り": "مشرف الشحن (ضابط على سفينة تجارية مسؤول عن البضائع وبيعها وشرائها)",
 "上人": "حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى) / زعيم روحي, كاهن أعظم (سلطة بارزة أو مؤيد رئيسي لحركة أو مذهب ما)\nمثال: إنه الكاهن الأعظم لموسيقى الجاز المعاصرة / جَلِيل, سَامٍ (جدير بالإجلال والتبجيل) / المبجل, قس (لقب احترام لرجل دين) / قسيس, مُبَجَّل (عضو في سلك رجال الدين وقائد روحي في الكنيسة المسيحية)",
 "上付き文字": "علوي, مرتفع (نص) (مكتوب أو مطبوع فوق وإلى جانب حرف آخر) / حرف علوي, نص مرتفع (حرف أو رمز يوضع أو يُطبع أو يُكتب فوق وإلى جانب حرف آخر مباشرة)",
 "上付き添え字": "علوي, مرتفع (نص) (مكتوب أو مطبوع فوق وإلى جانب حرف آخر) / حرف علوي, نص مرتفع (حرف أو رمز يوضع أو يُطبع أو يُكتب فوق وإلى جانب حرف آخر مباشرة)",
 "上付き添字": "علوي, مرتفع (نص) (مكتوب أو مطبوع فوق وإلى جانب حرف آخر) / حرف علوي, نص مرتفع (حرف أو رمز يوضع أو يُطبع أو يُكتب فوق وإلى جانب حرف آخر مباشرة)",
 "上代": "سعر التجزئة (السعر الإجمالي المفروض على منتج يُباع للعميل، ويشمل تكلفة المصنع بالإضافة إلى هامش ربح التجزئة)",
 "上位": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو",
 "上位グループ": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "上位互換性": "توافقية مستقبلية",
 "上位語": "اسم شامل, لفظ أعم (كلمة أكثر شمولاً وعمومية من كلمة أخرى)",
 "上位陣": "قادة, قيادة (هيئة الأشخاص الذين يقودون مجموعة)\nمثال: تبنت القيادة الوطنية خطته",
 "上体起こし": "تمرين الجلوس من الرقود (تمرين للبطن يجلس فيه الشخص من وضع الاستلقاء دون استخدام الذراعين للرافعة)",
 "上作": "تُحْفَة, رَائِعَة",
 "上使": "مَبْعُوث",
 "上側": "أعلى, قمة (الجانب الأعلى أو الأرفع لأي شيء)\nمثال: ضع كتبك على سطح المكتب",
 "上働き": "خادمة (عاملة منزلية)",
 "上前": "النِّسْبَة الْمِئَوِيَّة",
 "上包": "غِطَاء / غِلَاف / غَطَّى",
 "上包み": "غِطَاء / غِلَاف / غَطَّى",
 "上半": "شوط أول (الأول من شوطين للعب)",
 "上古史": "تاريخ قديم (معرفة حقيقة أو حدث حديث أصبح معروفاً لدرجة أنه فقد أهميته الأصلية) / التاريخ القديم (تاريخ العالم القديم)",
 "上司": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو",
 "上合": "اقتران علوي ((في علم الفلك) محاذاة الأرض وكوكب على الجانب المقابل من الشمس)",
 "上向": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "上向き": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "上向く": "حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "上品": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة. / رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "上唇": "جَاضِم",
 "上噛合わせ": "بروز الفك العلوي, تراكب العضة ((طب الأسنان) سوء إطباق تمتد فيه الأسنان العلوية بشكل غير طبيعي فوق الأسنان السفلية)",
 "上回る": "كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "上場": "إدراج, سرد (فعل عمل قائمة بالعناصر) / قائمة (قاعدة بيانات تحتوي على مصفوفة مرتبة من العناصر (أسماء أو موضوعات)) / أَدَاء / مَسْرَحِيَّة",
 "上場投信": "صندوق متداول في البورصة (صندوق استثمار مشترك يتم تداوله في سوق الأوراق المالية)",
 "上塗": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "上塗り": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "上士": "عَالِيّ الرُتْبَة / بُودِيسَاتْفَا",
 "上大静脈": "وريد أجوف علوي (يتلقى الدم من الرأس والذراعين والصدر ويصب في الأذين الأيمن للقلب؛ يتكون من الوريد الفرد وكلا الوريدين العضديين الرأسيين)",
 "上天": "سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب. / صُعُود, اِرْتِقَاء",
 "上客": "ضيف الشرف (الشخص الذي يُعقد التجمع تكريماً له)",
 "上家": "سَقِيفَة",
 "上宿": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "上屋": "سَقِيفَة",
 "上層土": "تربة سطحية (طبقة التربة الموجودة على السطح)",
 "上層建築": "بنية فوقية (هيكل يتكون من جزء السفينة الموجود فوق السطح الرئيسي)",
 "上層語": "لغة فوقية (لغة شعب غازٍ لاحق تُفرض على السكان الأصليين وتساهم بخصائص في لغتهم) / طبقة علوية, طبقة فوقية (أي طبقة توضع فوق أخرى)",
 "上層部": "القيادة العليا, كبار المسؤولين (أهم الأشخاص في هيئة حاكمة)",
 "上層階級": "الطَّبَقَة الْعُلْيَا",
 "上層雲": "عَالِي الارْتِفَاع (يحدث عند ارتفاع عالٍ نسبيّاً أو منه) / رَفِيع المُسْتَوَى (في مستوى مرتفع من الرتبة أو الأهمية)",
 "上帝": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "上席": "أقدمية, طول العمر (خاصية العيش طويلاً) / أقدمية (رتبة أعلى من الآخرين خاصة بسبب الخدمة الأطول)",
 "上底": "قاع زائف (هيكل أفقي يقسم سفينة أو صندوقاً (خاصةً ذلك المبني بالقرب من القاع الفعلي)) / مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "上座部仏教": "بوذية التيرافادا, تيرافادا (واحدة من مدرستين عظيمتين للعقيدة البوذية تؤكدان على الخلاص الشخصي من خلال الجهود الذاتية؛ شكل محافظ من البوذية يلتزم بنصوص بالي والمثل غير الإلهي…)",
 "上張り": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "上役": "أعلى مرتبة, رئيس (شخص ذو رتبة أو مكانة أو جودة أعلى)",
 "上御一人": "قَيْصَر, إِمْبْرَاطُور",
 "上意": "إرَادَة / رَغْبَة, إرَادَة",
 "上意下達": "من أعلى لأسفل (لنهج في حل المشكلات يبدأ من أعلى مستوى مفاهيمي ويعمل نزولاً إلى التفاصيل)\nمثال: تحليل من أعلى لأسفل قد يبدأ بالنظر في اتجاهات الاقتصاد الكلي",
 "上意討ち": "تَنْفِيذ / إِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "上戸": "شَارِب / مِرْوَحَة, مروحة / مِرْوَحَة, هَوَّايَة / مُشَجِّع, مُشَجِّعَة",
 "上手": "مَاهِر, حَاذِق / تملق, نفاق (ثناء مفرط أو غير صادق) / يسار المسرح (جزء المسرح الواقع على يسار الممثل عندما يواجه الجمهور) / مَاهِر, حَاذِق",
 "上手い": "مَاهِر, حَاذِق / لَذِيذ / شَهِيّ / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "上手い具合に": "لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "上手く": "ببراعة, بمهارة (بمهارة وحذق)\nمثال: شظايا إبريق شبه كامل، تم ترميمها بمهارة في معهد الآثار / بِنَجَاحٍ / بِشَكْل مُبْهِج, بِلَذَّة (بطريقة ممتعة للغاية) / بشكل شهي, بلذة (بطريقة تنتج طعماً لذيذاً)\nمثال: كانا يمشيان على الشاطئ ببطء ومتعة",
 "上手をいく": "فَاقَ, تَجَاوَزَ",
 "上手を行く": "فَاقَ, تَجَاوَزَ",
 "上手者": "مُتَمَلِّق, مُداهِن (شخص يستخدم الإطراء والتملق)",
 "上拍": "مُبْتَهِج, مُتَفَائِل بِسَذَاجَة (متفائل بشكل لطيف وربما غير واقعي) / نبرة صاعدة, نقر ضعيف (نقر غير مشدد (خاصة النقر الأخير في المقياس)) / رفاهية, سعادة (حالة قناعة وسعادة وصحة وازدهار)\nمثال: كانت المدينة أخيراً في حالة تحسن (رفاهية) بعد مشاكلنا الأخيرة",
 "上振れ": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "上掛": "لحاف (مفرش سرير مصنوع من طبقتين من القماش محشوتين ومخيطتين معاً) / غِطَاء / غِلَاف / غَطَّى / مِعْطَف فَضْفَاض",
 "上掛け": "لحاف (مفرش سرير مصنوع من طبقتين من القماش محشوتين ومخيطتين معاً) / غِطَاء / غِلَاف / غَطَّى / مِعْطَف فَضْفَاض / مِنَ الدَّرَجَة الأُولَى (ممتاز؛ أفضل ما يمكن) / زينة علوية, طبقة علوية (إضافة ذات نكهة توضع فوق طبق الطعام)",
 "上掲": "الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "上提": "قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: قدم عمي لرؤيتي.",
 "上敷": "سَجَّادَة / حلس, دثار السرج (من معدات الإسطبل يتكون من بطانية توضع تحت السرج)",
 "上敷き": "سَجَّادَة / حلس, دثار السرج (من معدات الإسطبل يتكون من بطانية توضع تحت السرج)",
 "上文": "تخلٍّ, تنازل (فعل التنازل؛ التضحية أو التخلي عن (ممتلكات أو حق أو لقب أو امتياز، إلخ))",
 "上新粉": "عَالِي الجَوْدَة, مُمْتَاز (يتفوق في الجودة)",
 "上昇": "اِنْتِفَاضَة, تَمَرُّد (معارضة منظمة للسلطة؛ صراع يحاول فيه فصيل انتزاع السيطرة من آخر) / بَازِغ, صَاعِد (برز حديثاً إلى الواجهة) / صَاعِد, نَاشِئ (يَبْلُغُ مَرْحَلَةَ النُّضْج) / طَالِع, مُنْحَدِرٌ صُعُودًا (مَائِلٌ نَحْوَ الأَعْلَى)",
 "上昇期": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "上昇気流": "تيار صاعد (تيار هوائي صاعد قوي)",
 "上昇限度": "سَقْف ((سَقَفَ) البيت ونحوه سقفا: عمل له سقفا)\nمثال: نظرت إلى السقف.",
 "上映": "فحص تحري, فرز (اختبار الأشياء أو الأشخاص لتحديد أولئك الذين لديهم خصائص معينة) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / شبكة غربلة, قماش شبكي (قماش من شبكة معدنية أو بلاستيكية) / عرض, عرض سينمائي (عرض صورة متحركة (فيلم))\nمثال: أخفى الغطاء بنادقهم عن طائرات العدو",
 "上映時間": "مدة العرض, وقت التشغيل (طول الوقت الذي يستمر فيه فيلم أو عرض تلفزيوني)",
 "上景気": "ذراع التطويل, عوارضة (أي من الصواري أو الأعمدة الأفقية المتنوعة المستخدمة لتمديد أسفل الشراع أو لمناولة البضائع أو في الإرساء) / بوم, ذراع الميكروفون (عمود يحمل ميكروفوناً علوياً مسلطاً فوق موقع تصوير فيلم أو تلفزيون) / دوي, رعد (ضجيج عميق طويل وعالٍ) / رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال))\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "上書": "كتابة فوقية (نشاط الكتابة فوق شيء ما) / كتابة فوقية (نص مكتوب فوق شيء آخر)",
 "上書き": "كتابة فوقية (نشاط الكتابة فوق شيء ما) / كتابة فوقية (نص مكتوب فوق شيء آخر)",
 "上服": "رداء خارجي, ملابس خارجية (رداء يلبس فوق ملابس أخرى)",
 "上木": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / مَنْشُور\nمثال: نشر توم الغسيل. / سقفية, ظلة (غطاء (عادة من القماش) يعمل كسقف لحماية منطقة ما من الطقس) / مظلة (الجزء الذي يشبه المظلة في الباراشوت والذي يمتلئ بالهواء) / قبة الطائرة (الغطاء الشفاف لمقصورة الطائرة)",
 "上板": "باب أرضي, باب سحري (باب مفصلي أو منزلق في أرضية أو سقف)",
 "上梓": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / مَنْشُور\nمثال: نشر توم الغسيل.",
 "上様": "قَيْصَر, إِمْبْرَاطُور / زَوْجَة, اِمْرَأَة",
 "上機嫌": "انشراح, روقان (مزاج مبتهج ومقبول)",
 "上段": "سطح علوي (سطح مرتفع) / منبر, منصة الخطابة (منصة مرتفعة عن المستوى المحيط لإبراز الشخص الموجود عليها)",
 "上気": "شطف (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن أن تعني إزالة ما علق بالشيء من أوساخ أو شوائب) / جنس خارج إطار الزواج, حب حر (الجماع الجنسي بين أفراد غير متزوجين من بعضهم البعض) / خِيَانَة / كُفْر, زَنْدَقَة (مصدر للفعل \"كَفَرَ\")",
 "上気道": "المسلك التنفسي العلوي (الأنف والحلق والقصبة الهوائية)",
 "上水": "إمدادات المياه, نظام مياه (منشأة توفر مصدراً للمياه)\nمثال: ناقشت المدينة تنقية إمدادات المياه",
 "上水道": "كُلْوَة, كُلْيَة",
 "上波": "لَوَّحَ, رَفْرَفَ / مَوْج, مَوْجَة",
 "上流": "ضد التيار, نحو المنبع (نحو المصدر أو عكس التيار) / ضد التيار, عكس التيار (في الاتجاه المعاكس لتيار النهر) / الطَّبَقَة الْعُلْيَا",
 "上流社会": "الطَّبَقَة الْعُلْيَا",
 "上流階級": "الطَّبَقَة الْعُلْيَا",
 "上海": "شَانْغْهَاي, شَانْغْخَاي\nمثال: この前中国へ行ったとき、上海を訪れた。 — زرتُ شانغهاي لَمَّا زرتُ الصين المرة الأخيرة.",
 "上海証券取引所": "الجَنُوب الجَنُوبِيّ الشَّرْقِيّ, جَنُوب جَنُوب شَرْق (نقطة البوصلة في منتصف المسافة بين الجنوب والجنوب الشرقي)",
 "上海語": "لغة وو, لهجة شنغهاي (لهجة صينية يتم التحدث بها في دلتا اليانغتسي)",
 "上清": "رَائِق, طَافٍ ((للسوائل) يطفو على السطح فوق الراسب أو الرُّسابة) / سائل طافٍ (السائل الصافي الذي يطفو فوق الرواسب أو المواد المترسبة)",
 "上湯": "عَالِي الجَوْدَة, مُمْتَاز (يتفوق في الجودة)",
 "上滑り": "سَطْحِيّ / تافه, طائش (غير جاد في المحتوى أو الموقف أو السلوك)\nمثال: رواية تافهة",
 "上演": "أَدَاء / مَسْرَحِيَّة",
 "上潮": "فيضان, مد صاعد (حدوث تدفق المياه للداخل (بين الجزر والمد العالي التالي))\nمثال: مد في شؤون البشر، إذا أُخذ في ذروته، يقود إلى الثروة / طفرة, فورة (زيادة قوية مفاجئة) / تلاطم, موجة عارمة (موجة بحرية كبيرة) / اندفاع, فورة (تدفق قوي مفاجئ)\nمثال: حفزت طفرة من المضاربة",
 "上物": "إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / تجهيزات, تركيبات (جسم مثبت بإحكام في مكانه (خاصة في المنزل)) / ثَبَات, رُسُوخ (صفة التثبيت في المكان كما لو كان بملحق قوي) / زبون معتاد, مرتاد دائم (راعٍ منتظم لمكان ما)\nمثال: مرتاد دائم لمضمار السباق",
 "上玉": "جَمَال, زَيْن / حَسْنَاء, جَمِيلَة",
 "上生菓子": "مُرْتَفِع الدَّرَجَة",
 "上甲板": "سطح علوي (سطح مرتفع)",
 "上申書": "تقرير, تقرير مكتوب (وثيقة مكتوبة تصف نتائج فرد أو مجموعة ما)\nمثال: هذا يتفق مع الدراسة الحديثة التي أجراها هيل وديل",
 "上界": "حد أعلى ((رياضيات) عدد يساوي أو أكبر من أي عدد آخر في مجموعة معطاة)",
 "上白": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "上白糖": "سكر ناعم الحبيبات (سكر ناعم الحبيبات جداً كان يرش قديماً من وعاء خاص)",
 "上皮": "بُشَيْرَة / نَسِيج طِلَائِيّ",
 "上皮細胞": "خلية طلائية, خلية ظهارية (واحدة من الخلايا المتراصة التي تشكل النسيج الطلائي)",
 "上皮組織": "ظهارة, نسيج طلائي (نسيج غشائي يغطي الأعضاء الداخلية والأسطح الداخلية الأخرى للجسم)",
 "上盤": "الجدار المعلق (الجدار العلوي لصدع مائل)",
 "上目": "فوق رتبة ((في الأحياء) مجموعة تصنيفية تقع فوق الرتبة وتحت الطائفة أو الطويئفة)",
 "上着": "مِعْطَف / قِمَّة",
 "上祭服": "رداء القداس (رداء طويل بلا أكمام يرتديه الكاهن عند الاحتفال بالقداس)",
 "上科": "فوق فصيلة ((في الأحياء) مجموعة تصنيفية تقع تحت الرتبة ولكن فوق الفصيلة)",
 "上程": "قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: قدم عمي لرؤيتي.",
 "上積み": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول.",
 "上空": "سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات",
 "上端": "قِمَّة",
 "上等": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو",
 "上等兵": "عريف رمح, وكيل عريف (جندي في سلاح مشاة البحرية رتبته أعلى من جندي درجة أولى وأقل من عريف)",
 "上等兵曹": "رئيس ضباط الصف (شخص يحمل أعلى رتبة لضابط صف بحري)",
 "上等品": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "上米": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة) / عُمُولَة / ضريبة الإنتاج, ضريبة الاستهلاك (ضريبة تقاس بحجم الأعمال المنجزة (وليس على الممتلكات أو الدخل العقاري))",
 "上糝粉": "عَالِي الجَوْدَة, مُمْتَاز (يتفوق في الجودة)",
 "上納": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / ضريبة الأراضي, ضريبة الأملاك (ضريبة رأسمالية تفرضها البلديات على الممتلكات؛ وتعتمد على القيمة المقدرة للعقار)",
 "上紙": "غِلَاف",
 "上級副社長": "نائب رئيس أول (نائب الرئيس الأعلى رتبة في شركة لديها أكثر من نائب رئيس)",
 "上級国民": "نُخْبَة",
 "上級曹長": "سمكة الرقيب, سمكة العريف (سمكة قعيسية كبيرة زرقاء رمادية مخططة بالأسود؛ توجد في جميع أنحاء العالم تقريباً) / رقيب ميجر, مساعد أول (ضابط صف يعمل ككبير المسؤولين الإداريين لوحدة مقر الجيش)",
 "上級裁判所": "محكمة عليا (أي محكمة لها اختصاص أعلى من محكمة أدنى)",
 "上綱": "فوق طائفة ((في الأحياء) فئة تصنيفية تحت الشعبة وفوق الطائفة)",
 "上肢": "درع النبالة, شعار النبالة (الرموز الرسمية لعائلة أو دولة، إلخ) / أسلحة, تسليح (الأسلحة مجتمعة)",
 "上肢帯": "حزام صدري (دعامة هيكلية ترتبط بها الأطراف الأمامية للفقاريات)",
 "上背": "طول, قامة ((لشخص واقف) المسافة من الرأس إلى القدم) / قامة, منزلة رفيعة (مستوى عالٍ من الاحترام يتم اكتسابه من خلال التطور أو الإنجاز المثير للإعجاب)\nمثال: رجل ذو قامة عظيمة",
 "上腕": "عَضُد (مُعِين؛ قُوَّة)",
 "上腕動脈": "شريان عضدي (الشريان الرئيسي للذراع العلوي؛ استمرار للشريان الإبطي؛ يتفرع إلى الشرايين الكعبرية والزندية عند المرفق)",
 "上腕骨": "عَضُد (مُعِين؛ قُوَّة)",
 "上腹部": "شرسوف, منطقة فوق المعدة (المنطقة الواقعة على أو فوق المعدة (أسفل عظم القص مباشرة))",
 "上腹部圧迫法": "ضَغْطَات البَطْن, مُناوَرَة هَيْمْلِيك",
 "上腿": "فَخِذ, فَخْذ",
 "上膊": "عَضُد (مُعِين؛ قُوَّة)",
 "上臈": "سيدة نبيلة, ليدي (امرأة من طبقة النبلاء في بريطانيا)",
 "上草履": "خُفّ, نَعْل (قدم البعير والنعام وهو بمثابة الحافر لغيرهما. الجمع أخفاف ويجوز قول خفاف؛ الحذاء الخفيف المصنوع من الجلد الطري أو القماش ونعله طريّ ويغطي الكعب، سميّ بالخُفّ لخفة وزنه. الجمع خِفَاف) / خُفّ (قدم البعير والنعام وهو بمثابة الحافر لغيرهما. الجمع أخفاف ويجوز قول خفاف؛ الحذاء الخفيف المصنوع من الجلد الطري أو القماش ونعله طريّ ويغطي الكعب، سميّ بالخُفّ لخفة وزنه. الجمع خِفَاف)\nمثال: لا تخف من الغريب، خف من الذي تعرفه.",
 "上荷船": "قَدَّاحَة, وَلَّاعَة",
 "上蓋": "باب أرضي, باب سحري (باب مفصلي أو منزلق في أرضية أو سقف) / غِطَاء",
 "上薬": "صقل, طلاء زجاجي (طلاء للسيراميك والمعدن وما إلى ذلك) / تلميع, صقل (طبقة نهائية لامعة على القماش) / طبقة تلميع, طلاء لامع (أي من التغطيات الرقيقة اللامعة (المالحة أو الحلوة) التي توضع على الأطعمة)",
 "上行大動脈": "أبهر صاعد (الجزء الصاعد من الأبهر عند خروجه من البطين الأيسر)",
 "上行結腸": "قولون صاعد (جزء الأمعاء الغليظة الذي يصعد من الأعور إلى القولون المستعرض)",
 "上衣": "مِعْطَف / قِمَّة",
 "上表紙": "غِطَاء / غِلَاف / غَطَّى",
 "上覆": "غِطَاء / غِلَاف / غَطَّى",
 "上記": "الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "上訴": "اِلْتِمَاس, اِسْتِئْنَاف / اِسْتَأْنَفَ",
 "上調子": "تردد عالي, طبقة عالية (طبقة صوتية تُدرك على أنها أعلى من غيرها)",
 "上足": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "上辺": "خارجي (يقع في أو مناسب للأماكن الخارجية أو خارج مبنى) / خارج, سطح خارجي (الجانب الخارجي أو السطح الخارجي لشيء ما) / خارج, محيط خارجي (المنطقة الموجودة خارج شيء ما)\nمثال: مشهد خارجي / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / أعلى, قمة (الجانب الأعلى أو الأرفع لأي شيء)\nمثال: ضع كتبك على سطح المكتب",
 "上辺を飾る": "اِدَّعَى / زَعَمَ / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب.",
 "上述": "الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "上進": "تَقَدُّم",
 "上達": "تَحْسِين\nمثال: 君の英語は上達している。 — إنجليزيتك تتحسن.",
 "上達部": "نُبْل, نَبَالَة / فَخَامَة, شَهَامَة",
 "上部": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح.",
 "上部字幕": "ترجمة علوية (ترجمة كلمات أوبرا أجنبية (أو عمل كورالي) تُعرض على شاشة فوق المسرح)",
 "上部構造": "بنية فوقية (هيكل يتكون من جزء السفينة الموجود فوق السطح الرئيسي)",
 "上酒": "رَاقٍ بِتَصَنُّع (أنيق بشكل مُتَظَاهَر)",
 "上長": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / أرفع مقاماً, أقدم (أكبر سنًا؛ أعلى رتبة؛ أطول في مدة الولاية أو الخدمة) / أَكْبَر سِنّاً, مُسِنّ (شخص أكبر منك سناً) / طالب سنة نهائية (طالب جامعي خلال السنة التي تسبق التخرج)\nمثال: ضابط كبير",
 "上門": "فوق شعبة ((في الأحياء) مجموعة تصنيفية تقع بين الشعبة وتحت الطائفة أو الطويئفة)",
 "上限": "حد شمالي, حد علوي (الحد الموجود على الجانب العلوي (أو الشمالي) لشيء ما) / حد أقصى, ذروة (أكبر كمية ممكنة)",
 "上限値": "حد أعلى ((رياضيات) عدد يساوي أو أكبر من أي عدد آخر في مجموعة معطاة)",
 "上院": "مَجْلِس عُلْوِيّ",
 "上院議会": "مَجْلِس الشُّيُوخ",
 "上院議員": "سِنَاتُور, سِنَاتُورَة",
 "上陸": "هُبُوط / بَسْطَة",
 "上陸休暇": "إجازة الشاطئ (إجازة تُمنح لبحار أو ضابط بحري)",
 "上陸用舟艇": "سفينة إنزال, مركبة إنزال (مركبة بحرية مصممة لإنزال القوات والمعدات على الشاطئ)",
 "上陸許可": "إجازة الشاطئ (إجازة تُمنح لبحار أو ضابط بحري)",
 "上面": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / قِمَّة",
