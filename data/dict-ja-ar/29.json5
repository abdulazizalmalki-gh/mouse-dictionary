 "評議会": "مَجْلِس / مَجْمَع (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "評釈": "تَعْلِيق",
 "詛い": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة",
 "詛う": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة",
 "詛呪": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة",
 "詞": "كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة) / كَلِمَةُ اللهِ (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "詞書": "مُقَدِّمَة",
 "詞書き": "مُقَدِّمَة",
 "詞花集": "تَجْمِيعَة, دِيوَان",
 "詞華集": "تَجْمِيعَة, دِيوَان",
 "詠": "تِلَاوَة / مُؤَلَّف, مُصَنَّف",
 "詠う": "غَنَّى / تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه)",
 "詠じる": "أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك. / تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه)",
 "詠ずる": "أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك. / تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه)",
 "詠み人": "مُلَحِّن / مُؤَلِّف مُوسِيقِيّ",
 "詠み人知らず": "مَجْهُول",
 "詠み手": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "詠む": "أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك. / تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه)",
 "詠人": "مُلَحِّن / مُؤَلِّف مُوسِيقِيّ",
 "詠人知らず": "مَجْهُول",
 "詠唱": "نَغَم / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: عادت إلى الغناء.",
 "詠嘆": "صِيَاح, صُرَاخ (مصدر الفعل صَاحَ؛ صوت الكائن الحي القوي)\nمثال: بدأنا في الصياح.",
 "詠手": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "詠歌": "قَصِيدَة, شِعْر",
 "詣で": "حَجّ (القَصْد والزِيَارَة على جهة التَعْظِيم؛ زيارة مكان مُقَدَّس بهدف ديني ويوجد عند معظم الديانات منها اليَهُودِيَّة والمَسِيحِيَّة والإسْلام)\nمثال: ذهب رجل للحج وترك خلفه خمس بنات وكلبة.",
 "詣り": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "試": "اِمْتِحَان, اِخْتِبَار (اِمْتِحَان) / اِمْتَحَنَ (وضع الشخص في محنه ليعرف كم يستطيع أن يحتمل وما سيكون رد فعله؛ اختبر وفحص؛ أن يسأل الملعلم الطلاب عن الدرس ليعلم كم تعلّموا) / اِمْتَحَنَ, اِخْتَبَرَ (وضع الشخص في محنه ليعرف كم يستطيع أن يحتمل وما سيكون رد فعله؛ اختبر وفحص؛ أن يسأل الملعلم الطلاب عن الدرس ليعلم كم تعلّموا)\nمثال: لدي امتحان غدا.",
 "試し": "مُحَاكَمَة (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري.",
 "試す": "حَاوَلَ, سَعَى (طَلَبَ، رَامَ) / حَاكَمَ (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر) / مُحَاوَلَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: حاول توم قتلنا!",
 "試み": "حَاوَلَ (طَلَبَ، رَامَ) / مُحَاوَلَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: حاول توم قتلنا! / جَهْد, جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد .",
 "試みる": "حَاوَلَ, سَعَى (طَلَبَ، رَامَ) / حَاكَمَ (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر) / مُحَاوَلَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: حاول توم قتلنا!",
 "試む": "حَاوَلَ (طَلَبَ، رَامَ) / مُحَاوَلَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: حاول توم قتلنا!",
 "試作": "تَجْرِبَة, اِخْتِبَار / جَرَّبَ (أَصابَهُ الجَرَب؛ السَّيْفُ: صَدِئَ)\nمثال: جرب هذا الكسكس.",
 "試供品": "عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ",
 "試合場": "حَلْقَة / خَاتَم, خَاتِم / دَقَّ, رَنَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه) / رَنَّ ((رَنَّ) رنينا: صَوَّت وَصَاح؛ (رَنَّ) إِلَيْهِ: أصغى) / تَلْفَنَ, رَنَّ / مثال: واصل زيري دق الجرس.",
 "試問": "مُقَابَلَة",
 "試掘": "توقع, احتمال / تَنْقِيْب (نقّب إذا سار في البلاد طلباً للمهرب ، نقّب عن الأخبار وغيرها:بحث عنها،هو البحث عن كلّ شيء والتّفتيش مطلقاً؛ نقّب مبالغة في نَقَب ، نقّب عن الشيء :فحص عنه فحصاً بليغاً)",
 "試料": "عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ",
 "試演": "بَرُوفَة",
 "試用": "مُحَاكَمَة (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري.",
 "試着室": "مَنْزَع / غُرْفَة الْمَلَابِس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "試筋": "راعي; حامي; وصي; سيد; و / حريف; زبون",
 "試練": "اِمْتِحَان, اِخْتِبَار (اِمْتِحَان) / اِمْتَحَنَ (وضع الشخص في محنه ليعرف كم يستطيع أن يحتمل وما سيكون رد فعله؛ اختبر وفحص؛ أن يسأل الملعلم الطلاب عن الدرس ليعلم كم تعلّموا) / اِمْتَحَنَ, اِخْتَبَرَ (وضع الشخص في محنه ليعرف كم يستطيع أن يحتمل وما سيكون رد فعله؛ اختبر وفحص؛ أن يسأل الملعلم الطلاب عن الدرس ليعلم كم تعلّموا)\nمثال: لدي امتحان غدا.",
 "試聴": "تَجْرِبة أَدَاء",
 "試行錯誤": "التَّجْرِبَة وَالْخَطَأ",
 "試論": "مَقَالَة, بَحْث",
 "試金石": "مِحَكّ (محك الشّخص:أكثر من الجدل بالباطل ، لَجَّ في المنازعة؛ محَكَ ، يَمْحَكُ مَحْكًا: لَجَّ فِي الأَمْرِ، وقِيلَ:المَحْكُ: التَّمادِي فِي اللَّجاجَةِ عِنْد المُساوَمَةِ والغَضَب ونَحْوِ ذَلِك)\nمثال: مستقبلنا على المحك.",
 "試錐": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "試錐機": "ثَقَبَ, نَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / مِثْقَاب, بريمة / نِظام مُنْضَمّ, تَدْرِيْبات (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: انه ثقب الاسود.",
 "試鑽": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "試食": "مَذَاق (مَا تُدْرِكُهُ حَاسَّةُ الذَّوْق)\nمثال: التين حلو المذاق.",
 "試飲": "مَذَاق (مَا تُدْرِكُهُ حَاسَّةُ الذَّوْق)\nمثال: التين حلو المذاق.",
 "試験": "اِخْتِبَار, اِمْتِحَان (اختبر الشّيء:خبره) / فَحْص (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض) / اِمْتِحَان, اِخْتِبَار (اِمْتِحَان)\nمثال: تم اختبار زيري. / مُحَاكَمَة (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري.",
 "試験場": "مَعْمَل, مُخْتَبَر (موضع العَمَل. المَبْنَى الذي يعمل فيه العُمَّال؛ قد يقصد به الوَرْشَة) / مُخْتَبَر, مَعْمَل",
 "試験室": "مَعْمَل, مُخْتَبَر (موضع العَمَل. المَبْنَى الذي يعمل فيه العُمَّال؛ قد يقصد به الوَرْشَة) / مُخْتَبَر, مَعْمَل",
 "試験済み": "اِمْتِحَان, اِخْتِبَار (اِمْتِحَان) / اِمْتَحَنَ (وضع الشخص في محنه ليعرف كم يستطيع أن يحتمل وما سيكون رد فعله؛ اختبر وفحص؛ أن يسأل الملعلم الطلاب عن الدرس ليعلم كم تعلّموا) / اِمْتَحَنَ, اِخْتَبَرَ (وضع الشخص في محنه ليعرف كم يستطيع أن يحتمل وما سيكون رد فعله؛ اختبر وفحص؛ أن يسأل الملعلم الطلاب عن الدرس ليعلم كم تعلّموا)\nمثال: لدي امتحان غدا.",
 "試験用": "اِمْتِحَان, اِخْتِبَار (اِمْتِحَان) / اِمْتَحَنَ (وضع الشخص في محنه ليعرف كم يستطيع أن يحتمل وما سيكون رد فعله؛ اختبر وفحص؛ أن يسأل الملعلم الطلاب عن الدرس ليعلم كم تعلّموا) / اِمْتَحَنَ, اِخْتَبَرَ (وضع الشخص في محنه ليعرف كم يستطيع أن يحتمل وما سيكون رد فعله؛ اختبر وفحص؛ أن يسأل الملعلم الطلاب عن الدرس ليعلم كم تعلّموا)\nمثال: لدي امتحان غدا.",
 "試験的": "مُؤَقَّت, مَشْرُوط",
 "試験監督": "مُرَاقِب",
 "試験管": "أُنْبُوب اِخْتِبَار",
 "詩": "قَصِيدَة, شِعْر\nمثال: この詩は誰が書いたのですか。 — من كتب هذه القصيدة؟",
 "詩人": "شَاعِر, شَاعِرَة",
 "詩句": "نَظْم (نَظَّمَه تَنْظِيمًا:أَلَّفَه وجَمَعَه فِي سِلْكٍ فانْتَظَمَ وتَنَظَّمَ ، وَمِنْه:نَظَمْتُ الشِّعْرَ ونَظَّمْتُه؛ نَظّم الأشياء :نظمها ،رتّبها،وضمّ بعضها إلى بعض في صورة منسّقة) / بَيْت (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت) / آيَة, عَدَد (العَلامَة أو الأمَارَة؛ المُعْجِزَة)\nمثال: نظم سامي كل شيء.",
 "詩学": "شِعْرِيّ",
 "詩客": "شَاعِر, شَاعِرَة",
 "詩家": "شَاعِر, شَاعِرَة",
 "詩抄": "تَجْمِيعَة, دِيوَان",
 "詩文": "أَدَب, أَدَبِيَّات (هو الظُرْف وحسن التَنَاوُل أو التَصَرُّف، أو هو مَلَكَة تعصم من كانت به عما يشينه؛ تطلق على المُسْتَظْرف من المعارف والعلوم)\nمثال: زيري يحب الأدب.",
 "詩歌": "شِعْر (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "詩的": "شِعْرِيّ",
 "詩的正義": "عدالة شعرية (مصدر للفعل عَدَلَ بمعنى أقْسَطَ ولم يجر؛ العَدْل، هو التعامل مع الناس بالقِسْط والإنْصَاف)\nمثال: يريدون العدالة.",
 "詩篇": "الْمَزَامِير, الزَّبُور",
 "詩編": "الْمَزَامِير, الزَّبُور",
 "詩趣": "شِعْرِيّ",
 "詫び": "اِعْتِذَار, عُذْر / دِفَاع, تَبْرِير",
 "詫びる": "اِعْتَذَرَ, اِسْتَعْذَرَ",
 "詫び言": "اِعْتِذَار, عُذْر / دِفَاع, تَبْرِير",
 "詫ぶ": "اِعْتَذَرَ, اِسْتَعْذَرَ",
 "詫言": "اِعْتِذَار, عُذْر / دِفَاع, تَبْرِير",
 "詭弁": "سَفْسَطَة, مُغَالَطَة",
 "詭弁学派": "سَفْسَطِيّ, سَفْسَطَائِيّ",
 "詭弁家": "سَفْسَطِيّ, سَفْسَطَائِيّ",
 "詭激": "الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ.",
 "詭策": "حِيلَة",
 "詭計": "حِيلَة",
 "詭謀": "حِيلَة",
 "詭辯": "سَفْسَطَة, مُغَالَطَة",
 "詮ずるところ": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "詮ずる所": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "詮ない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "詮無い": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "詮索": "تَحْقِيق",
 "詮索好き": "فُضُول / فُضُولِيّ",
 "詮議": "مُنَاقَشَة, بَحْث / تَحْقِيق",
 "詰": "حُزْمَة, عُبُوَّة / وَضَّبَ / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: حزم ياني أمتعته. / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "詰ます": "زَاوِيَة, رُكْن",
 "詰まらせる": "قُبْقَاب, قَبْقَاب (الجمل الهدّار ذو الصوت العالي؛ الكذاب الكثير الكلام والكذب والهذر)",
 "詰まらない": "كَلِيل / تافِه / عَبَثِيّ, سَخِيف / عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "詰まらなさそう": "مَلُول, ضَجِر",
 "詰まらなそう": "مَلُول, ضَجِر",
 "詰まらぬ": "كَلِيل / تافِه / عَبَثِيّ, سَخِيف / عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "詰まらん": "كَلِيل / تافِه / عَبَثِيّ, سَخِيف / عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "詰まり": "يَعْنِي, أَي / بِاخْتِصَار / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / طَرِيق مَسْدُود, طَرِيق غَيْر نَافِذ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / طَرِيق مَسْدُود (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "詰まる": "قَلَّصَ (جعل الشيء أصغر حجمًا أو أقل مقدارًا؛ اختصر أو قلل من شيء معين) / تَقَلَّصَ, أَحْجَمَ",
 "詰まるところ": "بِاخْتِصَار",
 "詰まる所": "بِاخْتِصَار",
 "詰み": "شَاهْ مَات, مَات ((تاريخيًّا) لقب أعطي لحُكَّام إيران (بلاد فارس) منذ القرن السادس قبل الهجرة وحتى القرن العشرين الميلادي؛ (في الشطرنج) أهم قطع رقعة الشطرنج) / شَاه مَات ((تاريخيًّا) لقب أعطي لحُكَّام إيران (بلاد فارس) منذ القرن السادس قبل الهجرة وحتى القرن العشرين الميلادي؛ (في الشطرنج) أهم قطع رقعة الشطرنج)\nمثال: أسست امبراطورية الدراني في أفغانستان من طرف أحمد شاه دراني عام 1747.",
 "詰め": "حُزْمَة, عُبُوَّة / وَضَّبَ / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: حزم ياني أمتعته. / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "詰めかける": "كَوْم",
 "詰める": "مُرَبًّى / شَوَّشَ / قَصَّرَ (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب. / قَلَّلَ / زَاوِيَة, رُكْن",
 "詰め合わせる": "حُزْمَة, عُبُوَّة / وَضَّبَ / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: حزم ياني أمتعته.",
 "詰め寄る": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة.",
 "詰め所": "إِذَاعَة, مَحَطَّة إِذَاعِيَّة",
 "詰め手": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "詰め掛ける": "كَوْم",
 "詰め物": "مَلَأَ",
 "詰め込む": "مُرَبًّى / شَوَّشَ",
 "詰め開き": "صَفْقَة (عَقْد، اتِّفَاق؛ ضرب اليدين عند العقد)\nمثال: إنها صفقة جيدة.",
 "詰らない": "كَلِيل / تافِه / عَبَثِيّ, سَخِيف / عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "詰らぬ": "كَلِيل / تافِه / عَبَثِيّ, سَخِيف / عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "詰らん": "كَلِيل / تافِه / عَبَثِيّ, سَخِيف / عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "詰り": "يَعْنِي, أَي / بِاخْتِصَار / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / طَرِيق مَسْدُود, طَرِيق غَيْر نَافِذ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / طَرِيق مَسْدُود (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "詰る": "اِمْرَأَة سَلِيطَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ) / وَبَّخَ (التأنيب بشدة)\nمثال: أنا امرأة قوية.",
 "詰寄る": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة.",
 "詰屈": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / كُرْسُوع, أَبُو الْمَغَازِل",
 "詰所": "إِذَاعَة, مَحَطَّة إِذَاعِيَّة",
 "詰手": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "詰物": "مَلَأَ",
 "詰責": "تَأْنِيب, عَذَل / أَنَّبَ, أَلَامَ (أَنَّبَهُ: وبَّخهُ وعنَّفَهُ ولامه، أو بالغ في ذلك؛ يقال فلان لا ينفع فيه تأنيب ولا تأديب)",
 "詰開き": "صَفْقَة (عَقْد، اتِّفَاق؛ ضرب اليدين عند العقد)\nمثال: إنها صفقة جيدة.",
 "話": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / مَوْضُوع, مَوَاضِيع / مُنَاقَشَة, بَحْث / إِشَاعَة, شَائِعَة",
 "話々": "كَلَام خَفِيف, مُحَادَثَة خَفِيفَة",
 "話がわかる": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "話が分かる": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "話が早い": "عَفْوًا",
 "話し": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / مَوْضُوع, مَوَاضِيع / مُنَاقَشَة, بَحْث / إِشَاعَة, شَائِعَة",
 "話しあう": "نَاقَشَ, بَحَثَ",
 "話しかける": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "話し中": "مَشْغُول",
 "話し合い": "مُنَاقَشَة, بَحْث",
 "話し合う": "نَاقَشَ, بَحَثَ",
 "話し好き": "نَمِيمَة, إِشَاعَة / اِغْتَابَ\nمثال: ジョージはとても話好きだ。 — جورج ثرثار جداً.",
 "話し手": "خَطِيب, مُتَكَلِّم / سَمَاعَة",
 "話し掛ける": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "話し相手": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "話す": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه. / تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "話のわかる": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "話の分かる": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "話は早い": "عَفْوًا",
 "話を付ける": "تَفَاوَضَ",
 "話を盛る": "بَالَغَ",
 "話を遮る": "قَاطَعَ",
 "話中": "مَشْغُول",
 "話合い": "مُنَاقَشَة, بَحْث",
 "話合う": "نَاقَشَ, بَحَثَ",
 "話変わって": "أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ) / إِلَى حِينِ ذَلِكَ الوَقْتِ فِي الأَثْنَاءِ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / فِي حِينِ أَنَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: أما زلت تذكرني؟",
 "話変わるけど": "بِالْمُنَاسَبَةِ, عَلَى فِكْرَةٍ",
 "話好": "نَمِيمَة, إِشَاعَة / اِغْتَابَ\nمثال: ジョージはとても話好きだ。 — جورج ثرثار جداً.",
 "話好き": "نَمِيمَة, إِشَاعَة / اِغْتَابَ\nمثال: ジョージはとても話好きだ。 — جورج ثرثار جداً.",
 "話柄": "مَوْضُوع, مَوَاضِيع",
 "話法": "حِكَايَة",
 "話相手": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "話者": "خَطِيب, مُتَكَلِّم / سَمَاعَة",
 "話話": "كَلَام خَفِيف, مُحَادَثَة خَفِيفَة",
 "話頭": "مَوْضُوع, مَوَاضِيع",
 "話題": "مَوْضُوع, مَوَاضِيع / حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم.",
 "話題性": "شَعْبِيَّة",
 "該": "السَّابِقُ ذِكْرُهُ",
 "該当なし": "لَا ينطبق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "該当無し": "لَا ينطبق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "該当者": "طَرَف / حَفْلَة, اِحْتِفَال",
 "該氏": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "詳しい": "مُفَصَّل / عَارِف / عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "詳しく": "بِالتَّفْصِيل, تَفْصِيلًا",
 "詳らか": "مُفَصَّل",
 "詳らかでない": "مَجْهُول, مُبْهَم / مُتَغَيِّر / غَامِض, غَوَامِض",
 "詳報": "تَفْصِيل, تَفَاصِيل / فَصَّلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل.",
 "詳密": "دَقِيقَة, دِقيقة (وِحْدَة زَمَنِيَّة تساوي ستين ثَانِيَة، وجزءًا من ستّين جزءًا من السَّاعَة؛ في : وحدة لقياس خطوط الطول والعرض) / لَحْظَة / دَقِيقٌ, تَافِهٌ (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: استأذنت لدقيقة.",
 "詳細": "تَفْصِيل, تَفَاصِيل / فَصَّلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل. / مُفَصَّل",
 "誂え": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "誂え向き": "كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه)",
 "誅": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "誅戮": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "誇らか": "فَخُور",
 "誇らしい": "فَخُور",
 "誇らしげ": "فَخُور",
 "誇らし気": "فَخُور",
 "誇り": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "誇り高い": "فَخُور",
 "誇り高き": "فَخُور",
 "誇大": "مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "誇張": "مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "誇張法": "مُبَالَغَةٌ (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "誇示": "إِظْهَار, عَرْض / شَاشَة",
 "誇称": "تَبَاهَى",
 "誉む": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "誉むべき": "مُحَمَّد (مُفَعَّل من حَمَّدَ؛ الذي يُحْمَدُ كثيرا)\nمثال: محمد رسول الله.",
 "誉めたてる": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "誉めちぎる": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "誉める": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "誉め称える": "صَفَّقَ",
 "誉め立てる": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "誉め言葉": "تَأْبِين, أُمْدُوحَة / ثَنَاء, أُمْدُوحَة",
 "誉れ": "شَرَف, عِزَّة (شَرَف) / شَرَف (شَرَف)\nمثال: لا أستحق هذا الشرف.",
 "誉れ高い": "شُهْرة",
 "誉望": "شَرَف, عِزَّة (شَرَف) / شَرَف (شَرَف)\nمثال: لا أستحق هذا الشرف.",
 "誌": "خَزَّان الْبُنْدُقِيَّة, مَخْزَن طَلَقَاتِ السِّلَاحِ",
 "認む": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه.",
 "認め": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض.",
 "認める": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه.",
 "認め合う": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "認可": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض.",
 "認可証": "رُخْصَة, تَصْرِيح / رُخْصَة",
 "認定証": "شَهَادَة",
 "認知度": "رُؤْيَة",
 "認知症": "خَرَف ((خَرُفَ) الرجل خرفا وخرافة: خرف)",
 "認知的不協和": "تَنَافُر مَعْرِفِيّ, اِنْفِصَام مَعْرِفِيّ",
 "認許": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا. / قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض.",
 "認証": "مُصَادَقَة, اِسْتِيثَاق (إِخْلاَصٌ فِي الصَّدَاقَةِ؛ الإقرار والموافقة على الشيء)",
 "認証トークン": "رَمْز (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "認証書": "شَهَادَة",
 "認識": "وعي (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…)\nمثال: إنها فاقدة الوعي.",
 "認識力": "وعي (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…)\nمثال: إنها فاقدة الوعي.",
 "認識論": "إِبِسْتِمُولُوجِيَّا, نَظَرِيَّةْ اَلمَعْرِفَة",
 "認識違い": "سُوء فَهْم",
 "誑かす": "حِيلَة",
 "誑し込む": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "誑す": "تَمَلَّقَ / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "誓い": "قَسَم, حَلْف (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "誓い合う": "تَعَهَّدَ / ضَمَان (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / تَعَهُّد\nمثال: لا أستطيع ضمان أي شيء.",
 "誓う": "شَتَمَ, سَبَّ\nمثال: 君は聖書に手をのせて誓うべきだ。 — ينبغي أن تقسم ويدك على الإنجيل.",
 "誓って": "بِالتَّأْكِيد / أَبَدًا",
 "誓約": "قَسَم, حَلْف (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "誓約書": "مِيثَاق, عَهْد",
 "誓言": "قَسَم, حَلْف (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "誓詞": "نَذْر / نَذَرَ",
 "誓願": "نَذْر / نَذَرَ / صَلَاة, دُعَاء / صَلَاة / مُصَلٍّ",
 "誕生": "وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / خِلْقَة, خَلْق / اِبْتِكَار, خَلْق / خَلْق (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "誕生パーティー": "حَفْلَة عِيد مِيلَاد",
 "誕生会": "حَفْلَة عِيد مِيلَاد",
 "誕生日": "عِيد مِيلَاد / يَوْم مِيلَاد (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "誕生日おめでとうございます": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, عِيد مِيلَاد سَعِيد",
 "誕生日ケーキ": "كَعْكَة عِيد مِيلَاد (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "誕生日パーティー": "حَفْلَة عِيد مِيلَاد",
 "誕生日会": "حَفْلَة عِيد مِيلَاد",
 "誕生石": "حجر البخت (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "誕辰": "عِيد مِيلَاد / يَوْم مِيلَاد (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "誘い": "دَعْوَة, عزيمة / إِغْرَاء / فِتْنَة, إِغْرَاء / فِتْنَة / فِتْنَة, تَجْرِبَة",
 "誘いかける": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا.",
 "誘いをかける": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "誘い掛ける": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا.",
 "誘い水": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "誘い込む": "أَغْوَى, أَغْرَى / أَغْرَى",
 "誘う": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / أَغْوَى, أَغْرَى / أَغْرَى / اِسْتَفَزَّ",
 "誘因": "حَافِز",
 "誘導": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد",
 "誘導体": "مشتقّ",
 "誘惑": "فِتْنَة, إِغْرَاء / فِتْنَة / فِتْنَة, تَجْرِبَة",
 "誘惑的": "أَغْوَى, أَغْرَى / أَغْرَى",
 "誘拐": "اِخْتِطَاف",
 "誘拐事件": "اِخْتِطَاف",
 "誘拐犯": "مُخْتَطِف",
