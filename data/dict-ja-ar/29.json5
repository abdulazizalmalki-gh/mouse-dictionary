 "轟々": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد",
 "轟かす": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَ, نَبَضَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَان",
 "轟き": "أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟ / ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "轟き渡る": "أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟",
 "轟く": "أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟ / بَاوْنْد / رَطْل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ) / جُنَيْه",
 "轟然": "أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟",
 "轟轟": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد",
 "轡": "بِت (انقطع؛ قَطَع)",
 "轡を並べて": "مَعًا, سَوِيًّا",
 "轡屋": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "轡銜": "بِت (انقطع؛ قَطَع)",
 "轢く": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "轢る": "زَيَّقَ, صَرَّ ((زيق) القميص ونحوه: جعل له زيقا)",
 "辛々": "بِٱلْكَاد",
 "辛い": "حَار, حَرَّاق (ساخن من نفسه بدون تسخين) / حِرِّيف, حَارّ\nمثال: الجو حار اليوم. / مَالِح / مِلْحِيّ / صَارِم / أَلِيم, مُؤْلِم\nمثال: 彼女は多くの辛い思いを経験してきた。 — لقد واجهَت الكثير من الصعوبات.",
 "辛うじて": "بِٱلْكَاد",
 "辛くも": "بِٱلْكَاد",
 "辛さ": "أَلَمٌ (الوَجَع) / آلَمَ, يُؤْلِمُ (سبَّبَ أَلَمًا حسّيًّا أو وجعًا في الجسد؛ سَبَّبَ له الألَم)\nمثال: ألم أقل لك ذلك؟",
 "辛め": "مَالِح / مِلْحِيّ / صَارِم",
 "辛らつ": "مُرّ (فَاتَ ومَضَى؛ الحدثُ أو الأمرُ: حدث وانتهى) / أَلِيم / مَقِيت, مَمْقُوت (مَقيت: ( اسم )؛ مُقِيت: ( اسم ))\nمثال: مر زيري بجانبي.",
 "辛党": "شَارِب",
 "辛労": "مَشَقَّة, شِدَّة",
 "辛口": "مَالِح / مِلْحِيّ",
 "辛塩": "مِلْح, ملح / مَلَّحَ / مَاء مِلْح (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "辛子": "خَرْدَل",
 "辛子色": "خَرْدَل",
 "辛抱": "صَبْر, تَحَمُّل ((صَبَرَ) يَصْبِرُ صَبْرًا: تجلَّد ولم يَجْزَع؛ (صَبَرَ): انتظر في هدوء واطمئنان)\nمثال: الصبر أم العلوم.",
 "辛抱強い": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء الحسنى) / مَرِيض, مَرِيضَة (من به مَرَض، أي السَقِيْم المَعْلُوْل. يقال لما يصاب به الجَسَد والنَفَس والرُوْح أو أحدهم) / مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به)\nمثال: أظن أنها مريضة.",
 "辛気": "عَقْلِيَّة",
 "辛気くさい": "غَامِق, دَاكِن / مُزْعِج",
 "辛気臭い": "غَامِق, دَاكِن / مُزْعِج",
 "辛物": "فِجْل (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة) / دَايْكُون",
 "辛目": "مَالِح / مِلْحِيّ / صَارِم",
 "辛苦": "مَشَقَّة, شِدَّة",
 "辛苦艱難": "بُؤْس, ضَنْك (الفُقْر والشِدَّة وضِيق الحال)\nمثال: عانى الكثيرون الظلم والبؤس ردحا من الزمن تحت حكم الإستعمار.",
 "辛辛": "بِٱلْكَاد",
 "辛辣": "مُرّ (فَاتَ ومَضَى؛ الحدثُ أو الأمرُ: حدث وانتهى) / أَلِيم / مَقِيت, مَمْقُوت (مَقيت: ( اسم )؛ مُقِيت: ( اسم ))\nمثال: مر زيري بجانبي.",
 "辛酒": "خَلّ ((خَلَّ) خلا وخلولا: صار فيه خلل؛ (خَلَّ) لحمه: قل ونحف)\nمثال: تذوق زيري ذلك الخل.",
 "辛酸": "مَشَقَّة, شِدَّة",
 "辞": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "辞す": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / اِسْتَقَالَ / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "辞する": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / اِسْتَقَالَ / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "辞めさせる": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "辞める": "اِسْتَقَالَ",
 "辞世": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "辞令": "كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة) / كَلِمَةُ اللهِ (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "辞任": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "辞儀": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "辞典": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه) / مُعْجَم (المُنَقَّط بالسواد؛ أن تلوكه للأكل أو للخبرة) / قاموس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه)\nمثال: أي قاموس تعنيه؟",
 "辞去": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "辞彙": "مَسْرَد",
 "辞書": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه) / مُعْجَم (المُنَقَّط بالسواد؛ أن تلوكه للأكل أو للخبرة) / قاموس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه)\nمثال: أي قاموس تعنيه؟",
 "辞書形": "لَيمَّا ((في علم اللسانيات) الشكل المعجمي القانوني للكلمات التي تتشارك في المعنى عينه…)",
