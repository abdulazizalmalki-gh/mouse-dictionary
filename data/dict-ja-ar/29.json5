 "追越し": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "追跡": "طَارَدَ / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "追蹤": "طَارَدَ",
 "追込み": "مَعْرِض, صَالَةُ عَرْض / سِيَاقَة, قِيَادَة",
 "追追": "شَيْئاً فَشَيْئاً, خُطْوةً فَخُطْوةً",
 "追随": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "追随者": "تَابِع / مُتَابِع",
 "退かす": "نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا.",
 "退く": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور. / اِسْتَقَالَ",
 "退ける": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / دَفَعَ, صَدَّ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / طَرَدَ",
 "退っ引き": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "退っ引きならぬ": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "退任": "تَقَاعُد",
 "退任展": "متعلِّق بالماضي, رَجْعِيّ",
 "退会": "اِنْسِحَاب",
 "退修会": "تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "退出": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
