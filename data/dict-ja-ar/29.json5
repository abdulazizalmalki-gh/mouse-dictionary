 "身びいき": "تَفْضِيل",
 "身ふたつになる": "وَلَدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه) / أَنْجَبَ\nمثال: أعرف ذلك الولد.",
 "身ぶり手ぶり": "لَفْتَة, إِشَارَة",
 "身ぶり言語": "لُغَةُ الْجَسَدِ (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "身も世もあらぬ": "يَائِس, قَانِط / مَيْئُوس مِنْهُ",
 "身も世もない": "يَائِس, قَانِط / مَيْئُوس مِنْهُ",
 "身も世も在らぬ": "يَائِس, قَانِط / مَيْئُوس مِنْهُ",
 "身も世も無い": "يَائِس, قَانِط / مَيْئُوس مِنْهُ",
 "身も蓋もない": "كَلِيل",
 "身より": "نِسْبِيّ / قَرِيب, قَرِيبَة",
 "身をおどらせる": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "身をもって": "شَخْصِيًّا / بِٱلْكَاد",
