 "乗換": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار. / مِقْلَاد / تبديل, تحول (عملية تغيير شيء أو منصب بآخر)\nمثال: تحوله بشأن الإجهاض كلفه الانتخابات / تصالب, عبور (تبادل الأجزاء بين الكروموسومات المتماثلة المقترنة أثناء الطور الأول من الانقسام المنصف)",
 "乗換え": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار. / مِقْلَاد / تبديل, تحول (عملية تغيير شيء أو منصب بآخر)\nمثال: تحوله بشأن الإجهاض كلفه الانتخابات / تصالب, عبور (تبادل الأجزاء بين الكروموسومات المتماثلة المقترنة أثناء الطور الأول من الانقسام المنصف)",
 "乗数": "مَضْرُوب فِيه, مُعَامِل ضَرْب (العدد الذي يضرب به المضروب)",
 "乗根": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "乗機": "طَائِرَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر) / طَيَّارَة (هي الطَائِرَة؛ هي الطائرة الورقية)\nمثال: لقد وصلت الطائرة. / ركوب, صعود (فعل صعود الركاب والطاقم على متن سفينة أو طائرة) / ألواح خشبية, كسوة خشبية (هيكل من الألواح)",
 "乗気": "فَائِدَة",
 "乗法": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "乗物": "وَاسِطَة, وَسِيلَة / رَكِبَ, اِمْتَطَى (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا من الدواب) / رَكِبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا من الدواب) / رُكُوب / آليَّة\nمثال: ركب ياني سفينة.",
 "乗物酔い": "دُوَار اَلْبَحْر (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "乗用自動車": "أوتوبيس, باص (مركبة تحمل العديد من الركاب؛ تستخدم للنقل العام)\nمثال: كان دائماً يركب الحافلة للعمل",
 "乗用車": "سَيَّارَة, عَرَبِيَّة (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "乗移る": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "乗積": "مُنْتَج / سِلْعَة / حَاصِل (الشيء :حصل عليه) / مَحْصُول / حَاصِل ضَرْب (الشيء :حصل عليه) / جَدَاء",
 "乗算": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "乗算器": "مَضْرُوب فِيه, مُعَامِل ضَرْب (العدد الذي يضرب به المضروب)",
 "乗組": "طَاقَم, طَاقِم",
 "乗組員": "طَاقَم, طَاقِم",
 "乗継": "مُرُور / عُبُور",
 "乗継ぎ地": "توقف, محطة استراحة (إقامة قصيرة أثناء رحلة) / استراحة, محطة توقف (مكان توقف في رحلة)\nمثال: توقفوا لزيارة أصدقائهم",
 "乗継便": "رحلة ترانزيت, رحلة مواصلة (رحلة مع توقف وسيط وتغيير الطائرة (وربما تغيير شركة الطيران))",
 "乗継地": "توقف, محطة استراحة (إقامة قصيرة أثناء رحلة) / استراحة, محطة توقف (مكان توقف في رحلة)\nمثال: توقفوا لزيارة أصدقائهم",
 "乗羃": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة, طَاقَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / طَاقَة كَهْرَبَائِيَّة, طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: توم شعر بالقوة.",
 "乗船": "صَعِدَ / سَفِينَة, سَفينة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ) / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة)\nمثال: غادروا السفينة.",
 "乗船者": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "乗越す": "إلغاء الهبوط, تجاوز الهدف (اقتراب يفشل ويفسح المجال لمحاولة أخرى) / سَبَقَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك.",
 "乗車": "ركوب, صعود (فعل صعود الركاب والطاقم على متن سفينة أو طائرة) / ألواح خشبية, كسوة خشبية (هيكل من الألواح)",
 "乗車券": "تَذْكِرَة / تذكرة",
 "乗車口": "دُخُول / مَدْخَل",
 "乗車定員": "سعة المقاعد (عدد الأشخاص الذين يمكن جلوسهم في مركبة أو قاعة أو ملعب وما إلى ذلك)",
 "乗込み": "ركوب, صعود (فعل صعود الركاب والطاقم على متن سفينة أو طائرة)",
 "乗遅れる": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "乗降場": "مِنَصَّة / رَصِيف, مِنَصَّة",
 "乗馬": "ركوب الخيل (السفر محمولاً على ظهر الخيل) / ركوب الخيل, فروسية (رياضة الجلوس على ظهر الحصان مع التحكم في تحركاته) / رَكِبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا من الدواب)\nمثال: ركب ياني سفينة.",
 "乗馬ズボン": "بنطال ركوب الخيل, جودبور ((تستخدم بصيغة الجمع) سراويل واسعة تنتهي عند الساق؛ تلبس مع أحذية الركوب)",
 "乗馬服": "بدلة ركوب الخيل (الملابس التي يرتديها عادة راكب الخيل (وخاصة زي المرأة))",
 "乗馬隊": "مَوْكِب خَيَّالَة (موكب من الناس يسافرون على ظهور الخيل)",
 "乗馬靴": "حذاء ركوب الخيل (حذاء بدون أربطة يرتدى لركوب الخيل؛ جزء من زي الركوب)",
 "乗駕": "قاعدة تثبيت (هيكل يستخدم للدعم أو العرض) / تسلق, تصاعد (حدث ينطوي على الارتفاع إلى نقطة أعلى (كما في الارتفاع أو درجة الحرارة أو الشدة، وما إلى ذلك))",
 "乙": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية. / أنيق, عصري (كائن أو متوافق مع الموضات الاجتماعية الحالية) / أنيق, عصري (لديه أناقة أو ذوق أو رقي في الأخلاق أو الملبس)\nمثال: ملابس عصرية / غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب / شُكْرًا, تِسْلَم / أَخ الْأَصْغَر, أَخ الصَّغِير / صَغِير, حَدَث / فَاتِن, قَشِيب",
 "乙卯": "أرنب قطني الذيل (أرنب صغير شائع في أمريكا الشمالية ذو فرو رمادي أو بني وذيل بجانب سفلي أبيض؛ مضيف لقراد داء لايم)",
 "乙女": "بِنْت / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة) / طِفْلة / بنت / فتاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "乙女チック": "بَنَاتِيّ",
 "乙女子": "بِنْت / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة) / طِفْلة / بنت / فتاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "乙女座": "بُرْج الْعَذْرَاء, الْعَذْرَاء (ظهر وارتفع) / بُرْج اَلْعَذْرَاء, العذراء (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "乙女畦菜": "الخط البراهمي (خط (من المحتمل أنه مقتبس من الآرامية حوالي القرن السابع قبل الميلاد) تطورت منه الخطوط الهندية اللاحقة)",
 "乙巡": "مِنَ الدَّرَجَة الثَّانِيَة (ذو مكانة أو جودة أدنى)",
 "乙種": "مِنَ الدَّرَجَة الثَّانِيَة (ذو مكانة أو جودة أدنى)",
 "九": "تِسْعَة, تسعة",
 "九々": "جَدْوَل ضَرْب",
 "九々の表": "جَدْوَل ضَرْب",
 "九〇": "تِسْعِينَ, تِسْعُونَ",
 "九〇〇": "تِسْعُمِئَة, تِسْعُمِائَة",
 "九つ": "تِسْعَة, تسعة",
 "九つ時": "ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "九九": "جَدْوَل ضَرْب",
 "九九の表": "جَدْوَل ضَرْب",
 "九分": "إلى حد كبير, بشكل رئيسي (في جزء كبير؛ بشكل رئيسي أو أساسي) / بشكل عام, في الغالب (عادة؛ كقاعدة)\nمثال: هذه الحسابات غير نشطة إلى حد كبير",
 "九分九厘": "على الأرجح, غالباً (بدرجة كبيرة من اليقين؛ دون شك كبير)\nمثال: من المحتمل أنه خارج البلاد / تِسْعَة وَتِسْعُيون",
 "九分通り": "تَقْرِيبًا / على الأرجح, غالباً (بدرجة كبيرة من اليقين؛ دون شك كبير)\nمثال: من المحتمل أنه خارج البلاد",
 "九十": "تِسْعِينَ, تِسْعُونَ",
 "九十九折": "تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "九十九折り": "تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "九十代": "تِسْعُونَ (يَدُلُّ عَلَى العَدَد 90) / تِسْعُون (العدد الأصلي الذي هو حاصل ضرب عشرة في تسعة)",
 "九卿": "عَالِيّ الرُتْبَة",
 "九回": "تسعة أضعاف (بمعامل تسعة)\nمثال: زاد استثماري تسعة أضعاف",
 "九夏": "صَيْف, صيف (فصل من فصول السنة الأربعة، يلي الرَّبِيع ويأتي بعده الخَرِيف، يتميز بشدة الحَرّ)\nمثال: نأتي هنا كل صيف.",
 "九天": "سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات",
 "九天直下": "مِطْمَار, مِطْمَر",
 "九官鳥": "مينة التل (زرزور آسيوي أسود لامع غالباً ما يُعلم تقليد الكلام)",
 "九寸五分": "خَنْجَر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين)",
 "九工大": "جرو (صغير أي من حيوانات الفراء المختلفة) / طقم, عدة (معدات تتكون من مجموعة من المواد أو الأدوات لغرض محدد) / حقيبة عدة, طقم (حافظة لاحتواء مجموعة من الأدوات)\nمثال: جرو الثعلب",
 "九帯アルマジロ": "مدرع تساعي الأحزمة (له تسعة أحزمة مفصلية من الصفائح العظمية؛ يمتد نطاقه من تكساس إلى باراغواي)",
 "九拝": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "九時": "اَلسَّاعَة اَلتَّاسِعَة",
 "九月": "سِبْتِمْبِر, سِبْتَمْبِر (الشهر التاسع في السنة الروميّة)\nمثال: بدأ سامي عامه الجامعي في سبتمبر.",
 "九柱戯": "سكتلز, لعبة التسعة دبابيس (لعبة بولينغ تُلعب بدحرجة كرة بولينغ في مسار نحو هدف مكون من تسعة دبابيس خشبية)",
 "九泉": "هَادِيس",
 "九牛の一毛": "قَطْرَة فِي الْمُحِيط",
 "九牛一毛": "قَطْرَة فِي الْمُحِيط",
 "九献": "غاية, غَرَض",
 "九百": "تِسْعُمِئَة, تِسْعُمِائَة / مُغَفَّل, أَحْمَق",
 "九腸": "مِعًى / مَعْي / مِعَاء / أَمْصِرَة / مَصِير / مُصْرَان",
 "九角形": "تساعي الأضلاع, متسع (مضلع له تسعة أضلاع)",
 "九重": "تسعة أضعاف (بمعامل تسعة) / تُسَاعِيّ (ذو تسع وحدات أو مكوّنات)\nمثال: زاد استثماري تسعة أضعاف / مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "乞い": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "乞い受ける": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك",
 "乞い願う": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك",
 "乞う": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك / صَلَّى, دَعَا",
 "乞丐": "سَائِل / فَقِير",
 "乞児": "تَسَوُّل",
 "乞食": "سَائِل / فَقِير / تَسَوُّل",
 "乞食根性": "جَشَع, طَمَع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع.",
 "也": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / مبلغ, مقدار من المال (كمية من المال)\nمثال: اقترض مبلغاً كبيراً",
 "乱": "ثَارَ, تَمَرَّدَ (ثارَ يَثُورُ ثَوَرانًا، وثَوْرًا، وثَوْرَةً: هاج وانتَشَرَ؛ يُقال: ثارَ الدُّخانُ والغُبَرُ، وثار الدّم بفلان، وثارت به الحصْبَةُ، وثار به الشَّرُّ والغَضَبُ) / عِصْيَان, تَمَرُّد\nمثال: ثار الفلاحون على الحكومة.",
 "乱す": "مُرْتَشٍ, فَاسِد / أَفْسَدَ",
 "乱り": "أَنَانِيّ / مُتَهَوِّر / فَضْفَاض, واسِع / غير عقلاني, غير منطقي (غير متسق مع العقل أو لا يستخدمه) / أصم, غير نسبي (حقيقي ولكن لا يمكن التعبير عنه كحاصل قسمة عددين صحيحين) / عَدَد غَيْر نِسْبِيّ (عدد حقيقي لا يمكن التعبير عنه كعدد نسبي (كسر))\nمثال: مخاوف غير عقلانية",
 "乱り風": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "乱れ": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب",
 "乱交": "إباحية, علاقات متعددة (الانغماس في علاقات جنسية عشوائية وغير مميزة)",
 "乱交パーティー": "باخاناليا, حفلة مجون (تجمع جامح ينطوي على الإفراط في الشرب والانحلال الجنسي) / طقوس العربدة (طقس سري في عبادات الآلهة اليونانية أو الرومانية القديمة ينطوي على الغناء والرقص والشرب والنشاط الجنسي) / عربدة, نوبة إفراط (أي فعل من أفعال الانغماس غير المعتدل)\nمثال: نوبة إفراط في التسوق",
 "乱作": "تجاوز الإنتاج, فرط الإنتاج (إنتاج مفرط أو أكثر من المتوقع)",
 "乱倫": "فاسد, لا أخلاقي (ينتهك عمداً المبادئ المقبولة للصواب والخطأ) / فَاسِد, لَا أَخْلَاقِيّ (لا يلتزم بالمبادئ الأخلاقية أو القِيَمية)",
 "乱入": "تَطَفُّل, مُدَاخَلَة",
 "乱入者": "مُقْتَحِم, دَخِيل",
 "乱切法": "اختبار الخدش (اختبار لتحديد الحساسية لمواد مختلفة عن طريق تطبيقها على خدوش في الجلد)",
 "乱売": "بيع تصفية, تصفية (بيع لتقليل المخزون)",
 "乱売合戦": "حَرْب أَسْعَار, مُنَافَسَة سِعْرِيَّة (منافسة شديدة يقوم فيها المتنافسون بخفض أسعار التجزئة لكسب الأعمال)",
 "乱婚": "إباحية, علاقات متعددة (الانغماس في علاقات جنسية عشوائية وغير مميزة)",
 "乱心": "جُنُون",
 "乱心者": "مَسْلُوبُ العَقْل, مَمْسُوسٌ بِالقَمَر (مجنون ويُعتَقد أنّ جنونه مرتبط بأطوار القمر) / طائش, متهور (شخص متهور مندفع غير مسؤول) / مَجْنُون, مُخْتَلّ عَقْلِيّاً (شخص فاقد للعقل)",
 "乱戦": "شِجَار صَاخِب (قتال صاخب وسط حشد من الناس)",
 "乱打": "صدم, ضرب (فعل ملامسة شيء لآخر)\nمثال: أدى الضرب المتكرر إلى ظهور كدمة كبيرة",
 "乱数発生器": "مولد أرقام عشوائية (روتين مصمم لإنتاج رقم عشوائي)",
 "乱暴": "عُنْف, عَنْف / عُنْف / خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق. / اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "乱暴者": "بَلْطَجِيّ",
 "乱歩": "سير عشوائي (عملية عشوائية تتكون من سلسلة من التغييرات التي يتم تحديد خصائص كل منها (مثل الحجم أو الاتجاه) عن طريق الصدفة)",
 "乱気流": "اِضْطِرَاب",
 "乱波": "بَلْطَجِيّ / جَاسُوس / تَجَسَّسَ",
 "乱流": "اِضْطِرَاب",
 "乱用": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "乱痴気騒ぎ": "مِضْرَب, مَضَارِب",
 "乱破": "بَلْطَجِيّ / جَاسُوس / تَجَسَّسَ",
 "乱筆": "خربشة",
 "乱筆乱文": "خربشة",
 "乱脈": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب",
 "乱臣": "خَائِن, خَائِنَة (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك!",
 "乱臣賊子": "خَائِن, خَائِنَة (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك!",
 "乱行": "إثم, سوء تصرف (نشاط ينتهك القانون الأخلاقي أو المدني) / سوء سلوك (إدارة سيئة أو غير نزيهة من قبل أشخاص يُفترض أنهم يتصرفون نيابة عن آخرين)\nمثال: نفي ارتكاب أي عمل غير مشروع",
 "乱視": "لَابُؤْرِيّة, اللَانُقَطِيَّة",
 "乱訴": "دعوى كيدية (تقاضي يتبين أنه تم رفعه بشكل كيدي ودون سبب محتمل)",
 "乱調": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "乱調子": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "乱費": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / انحلال, فجور (انغماس منحل في الملذات الحسية) / تبدد, تلاشي (التفكك والتشتت عن طريق التفرق)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "乱軍": "شجار",
 "乱逆": "ثَوْرَة, تَمَرُّد",
 "乱造": "تجاوز الإنتاج, فرط الإنتاج (إنتاج مفرط أو أكثر من المتوقع)",
 "乱闘": "شِجَار صَاخِب (قتال صاخب وسط حشد من الناس) / حفلة صاخبة (حفلة صاخبة أو مليئة بالضجيج والمرح)",
 "乱闘騒ぎ": "شِجَار صَاخِب (قتال صاخب وسط حشد من الناس) / حفلة صاخبة (حفلة صاخبة أو مليئة بالضجيج والمرح)",
 "乱雑": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب",
 "乱離": "مُتَفَرِّق, مُنْتَشِر (مُوَزَّعٌ أَوْ مُمْتَدٌّ عَلَى رُقْعَةٍ جُغْرَافِيَّةٍ وَاسِعَةٍ)",
 "乱雲": "مُزْنَة",
 "乱麻": "فَوْضَى, فَوْضَوِيَّة",
 "乳": "حَلِيب (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ) / لَبَن (سَقَاهُ اللَبَن؛ أكل كثيرا) / حَلَبَ (الشاةَ أو البقرةَ أو الناقةَ: استخرج ما في ضرعها من لبن؛ فلانٌ للرجل: أي حَلَب ماشية الرجل نيابة عنه)\nمثال: كنت أشرب الحليب / ثَدْي, بز / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر. / عُرْوَة, عُقْدَة",
 "乳がん": "سَرَطَان اَلثَّدْي",
 "乳しぼり": "حَلْب (الشاةَ أو البقرةَ أو الناقةَ: استخرج ما في ضرعها من لبن؛ فلانٌ للرجل: أي حَلَب ماشية الرجل نيابة عنه)\nمثال: أخرج زيري دلو الحلب. / أبقار حلوب, ماشية الحليب (الماشية التي تُربى من أجل حليبها)",
 "乳び": "كيلوس (سائل حليبي يتكون من اللمف والدهون المستحلبة؛ يتكون في الأمعاء الدقيقة أثناء هضم الدهون المبتلعة)",
 "乳りん": "هَالَة",
 "乳ガン": "سَرَطَان اَلثَّدْي",
 "乳兄弟": "أخ بالتبني, أخ بالرضاعة (أخوك بالرضاعة هو ذكر ليس ابناً لوالديك ولكنه تربى عند والديك)",
 "乳児": "رَضِيع",
 "乳児期": "رضاعة, طفولة مبكرة (أبكر مراحل عدم النضج) / طفولة مبكرة, مهد (المرحلة المبكرة من النمو أو التطور)",
 "乳児死亡率": "مُعَدَّل وَفَيَات الرُّضَّع (معدل الوفيات خلال السنة الأولى من الحياة)",
 "乳児院": "رَوْضَة, حَضَانَة / مَشْتَلَة",
