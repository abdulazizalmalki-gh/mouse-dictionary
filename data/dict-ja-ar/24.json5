 "条件付け": "تَكْيِيف",
 "条件文": "جُمْلَة شَرْطِيَّة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة!",
 "条件検索": "مِصْفَايَة / فِلْتَر",
 "条件節": "شَرْطِيّ (أحد المنتسبين إلى الشُرْطَة)\nمثال: تبدو وكأنك شرطي.",
 "条例": "تَنْظِيم",
 "条播": "ثَقَبَ, نَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / مِثْقَاب, بريمة / نِظام مُنْضَمّ, تَدْرِيْبات (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: انه ثقب الاسود.",
 "条播き": "ثَقَبَ, نَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / مِثْقَاب, بريمة / نِظام مُنْضَمّ, تَدْرِيْبات (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: انه ثقب الاسود.",
 "条文": "رِسَالَة, مِيسِيج",
 "条款": "مَقَال, مَقَالَة / أَدَاةُ تَعْرِيف, أَدَاةُ التَّعْرِيف / مادّةٌ, مَوَادُّ (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "条片": "شَرِيط / قِطَاع / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "条理": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "条痕": "اِنْجِرَاف",
 "条目": "مَقَال, مَقَالَة / أَدَاةُ تَعْرِيف, أَدَاةُ التَّعْرِيف / مادّةٌ, مَوَادُّ (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "条章": "مَقَال, مَقَالَة / أَدَاةُ تَعْرِيف, أَدَاةُ التَّعْرِيف / مادّةٌ, مَوَادُّ (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "条約": "مُعَاهَدَة, مُقَاوَلَة (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "条約加盟国": "مُوقّع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "条項": "جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع) / بَنْد\nمثال: يا لها من جملة!",
 "杢目": "حَبَة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / حُبُوب / تَجْزِيع, تَعْرِيق\nمثال: أكلت حبة طماطم.",
 "杣人": "حَطَّاب",
 "来": "قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض. / مُنْذُ / لِأَنَّ",
 "来し方": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "来す": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "来た": "جَيِّد (بَيِّن الجَوْدَة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / مثال: إنها فكرة جيدة.",
 "来たる": "قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض. / جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء",
 "来る": "جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء / عَادَ, رَجَعَ (رَجَعَ)\nمثال: هل عاد توم حقا؟ / صَارَ, أَصْبَحَ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما.",
