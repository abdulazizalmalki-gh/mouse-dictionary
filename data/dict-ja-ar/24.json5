 "槓杆": "مُخْل / مُحْل (الهدي: الوقت الذي ينحر فيه؛ الدين: أجله والوقت الذي يوفى فيه) / عَتَلَة / رَافِعَة\nمثال: أغلق دان المحل.",
 "槓桿": "مُخْل / مُحْل (الهدي: الوقت الذي ينحر فيه؛ الدين: أجله والوقت الذي يوفى فيه) / عَتَلَة / رَافِعَة\nمثال: أغلق دان المحل.",
 "様": "فَوْضَى, اِخْتِلَاط / ـًا، ـاً, لـ (الْأَلِفُ بِدُونِ هَمْزَةٍ ؛ تُسْتَخْدَمُ فِي آخِرِ أَوْ وَسَطِ الكلام لمد الصوت بحركة الفتحة؛ تبتدئ بها بعض الأسماء في اللغة العربية وهي)",
 "様々": "مُخْتَلِف, مُتَنَوَّع",
 "様な": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال. / فَكَرَ, فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فَكَّرَ (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / ظَنَّ (عَلِمَ بغير يقين؛ عَلِمَ بيقين)\nمثال: إنها فكرة جيدة.",
 "様に": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال. / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس. / اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "様体": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\"",
 "様変わり": "تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "様変わる": "تَحَوَّلَ, مَسَخَ (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "様子": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "様子見": "مِسْبَار",
 "様式": "أُسْلُوب (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "様態": "صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "様方": "عِنَايَة, رِعَايَة",
 "様様": "مُخْتَلِف, مُتَنَوَّع",
 "様相": "مَرْحَلَة",
 "槭樹": "قَيْقَب",
 "槽": "فِنْطَاس, صِهْرِيج / خَزَّان / دَبَّابَة",
 "樋": "فِنْطَاس",
 "樋川": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / يَاي, زُنْبُرُك\nمثال: كان عين ليلى مسودة.",
 "樋殿": "مِرْحَاض, تواليت",
 "樓": "بُرْج (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر. / نَاطُور / بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "樗材": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "標": "دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / رَمْز, عَلَامَة (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا. / شَارَة / دَلِيل, بُرْهَان / دَلِيل",
 "標す": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "標徴": "رَمْز, عَلَامَة (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "標数": "صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "標旗": "بِطَاقَة هُوِيَّة",
 "標本": "عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ / مِثَال, مَثَل / مِثَال",
 "標本化": "عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ",
 "標本室": "مَعْشَبَة",
 "標本抽出": "عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ",
 "標榜": "محامي, محامية / ناطق بلسان, لسان حال / أوصى ب / حامى, رافع",
 "標準": "مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء) / مُتَوَسِّط, مُعَدَّل",
 "標準偏差": "انحراف معياري",
 "標準入出力": "مُخرَج / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة.",
 "標準的": "مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء) / مُتَوَسِّط, مُعَدَّل",
 "標準規格": "مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "標準語": "معيرة لغة",
 "標的": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "標示": "دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين.",
 "標示板": "لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "標章": "شِعَار, رَمْز (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "標記": "دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "標語": "شِعَار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "標識": "لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "標題": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / عُنْوَان (عُنْوَان) / عِنْوَان (عُنْوَان) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "標高": "منسوب",
 "樟脳": "كَافُور",
 "模す": "قَلَّدَ / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "模する": "قَلَّدَ / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / لِوْحَة دَارَاتُ مَطَبُوعَة\nمثال: اختفى فلم ير له أثر.",
 "模る": "مَثَّلَ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "模作": "تَقْلِيد",
 "模倣": "تَقْلِيد",
 "模倣品": "تَقْلِيد",
 "模写": "نُسْخَة / اِنْتَسَخَ, نَسَخَ",
 "模刻": "نُشْخَة",
 "模型": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "模型化": "عارضة أزياء, نمذجة",
 "模式": "مَكِيدَة / نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: انه نوع من الفطر.",
 "模擬": "تَقْلِيد",
 "模擬実験": "مُحَاكَاة (تقليد أو محاولة إعادة عملية أو نظام موجود في الواقع بطريقة اصطناعية أو نموذجية)\nمثال: ويتم الآن طرح التساؤل التالي: هل يفهم الذكاء الصناعي اللغة الصينية حقيقة أم أنه يتم فقط محاكاة هذه المقدرة.",
 "模擬店": "مَطْعَم التَّصَابِير, كُشْك التَّصَابِير",
 "模擬戦": "مُنَاوَرَة عَسْكَرِيَّة",
 "模様": "نُمُوذَج, نَمَط / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "模範": "أُسْوَة (أُسْوَةٌ)",
 "模範演技": "مَعْرِض",
 "模範的": "نَمُوذَجِيّ / نَمُوذَجِيّ, مِثَالِيّ",
 "模糊": "إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "模索": "طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا.",
 "模製": "نُسْخَة / اِنْتَسَخَ, نَسَخَ",
 "模造": "تَقْلِيد",
 "模造品": "تَقْلِيد",
 "権": "يَمِين, يمين / صَحِيح, صَوَاب / قَائِم / عَلَى اَلْيَمِين (يفيد الاستعلاء؛ يفيد التعليل) / إِلَى اَلْيَمِين (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / صحيح, تمام / حَقّ, حُقُوق (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له) / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: أجب على السؤال. / سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ)\nمثال: هو متعطش للسلطة.",
 "権兵衛": "فُلان, فُلان الْفُلانِيّ (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو شخص لا يريد المتحدث ذكره)\nمثال: سمعنا ذلك من فلان و فلان. / شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "権利": "يَمِين, يمين / صَحِيح, صَوَاب / قَائِم / عَلَى اَلْيَمِين (يفيد الاستعلاء؛ يفيد التعليل) / إِلَى اَلْيَمِين (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / صحيح, تمام / حَقّ, حُقُوق (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له) / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: أجب على السؤال.",
 "権利放棄": "تَنَازُل, وَثِيقَةُ تَنَازُل",
 "権利者": "مُسْتَفِيد",
 "権利金": "إصدار مُكَلف / فاخر",
 "権力": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة, طَاقَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / طَاقَة كَهْرَبَائِيَّة, طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: توم شعر بالقوة.",
