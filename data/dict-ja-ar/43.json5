 "熱力学第１法則": "حفظ الطاقة, قانون حفظ الطاقة (المبدأ الأساسي في الفيزياء القائل بأن الطاقة الكلية لنظام معزول ثابتة على الرغم من التغيرات الداخلية)",
 "熱力学第２法則": "القانون الثاني للديناميكا الحرارية (قانون ينص على أنه لا يمكن استخلاص شغل ميكانيكي من جسم إلا عندما يتفاعل ذلك الجسم مع جسم آخر عند درجة حرارة أقل؛ أي عملية تلقائية تؤدي إلى زيادة في…)",
 "熱力学第３法則": "القانون الثالث للديناميكا الحرارية (قانون ينص على أن إنتروبيا مادة ما تقترب من الصفر مع اقتراب درجة حرارتها من الصفر المطلق)",
 "熱化学": "كيمياء حرارية (فرع الكيمياء الذي يدرس العلاقة بين العمل الكيميائي وكمية الحرارة الممتصة أو المتولدة)",
 "熱可塑": "لدائني الحرارة, لدن بالحرارة (له خاصية الليونة أو الانصهار عند التسخين والتصلب مرة أخرى عند التبريد) / بلاستيك حراري, لدائن حرارية (مادة تلين عند تسخينها وتتصلب مرة أخرى عند تبريدها)\nمثال: المواد اللدائنية الحرارية يمكن إعادة صهرها وتبريدها مرارًا دون الخضوع لأي تغيير كيميائي ملحوظ",
 "熱可塑性樹脂": "بلاستيك حراري, لدائن حرارية (مادة تلين عند تسخينها وتتصلب مرة أخرى عند تبريدها)",
 "熱可塑樹脂": "بلاستيك حراري, لدائن حرارية (مادة تلين عند تسخينها وتتصلب مرة أخرى عند تبريدها)",
 "熱器具": "مِدْفَأَة",
 "熱圏": "ثِيرْمُوسْفِير",
 "熱射病": "ضربة شمس, فرط الحرارة (انهيار ناتج عن التعرض للحرارة المفرطة)",
 "熱帯": "مَدَار (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير)\nمثال: انتشرت الشائعة على مدار الدولة.",
 "熱帯医学": "طب المناطق الحارة (فرع الطب الذي يتعامل مع تشخيص وعلاج الأمراض الموجودة غالباً في المناطق الاستوائية)",
 "熱帯多雨林": "غَابَة مَطِيرَة مَدَارِيَّة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "熱帯縞蚊": "حَمَّى صَفْرَاء (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "熱帯雨林": "غَابَة مَطِيرَة مَدَارِيَّة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "熱帯雨林気候": "غَابَة مَطِيرَة مَدَارِيَّة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "熱度": "دَرَجَةْ الْحَرَارَة / حُمَّى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "熱心": "مُتَحَمِّس, حَمَاسِيّ",
 "熱情": "اتقاد, حرارة (مشاعر الدفء والحدة الكبيرة) / شغف, وله (شعور مكثف بالحب) / اتقاد, اندفاع (شعور بتوق قوي (عادة لصالح شخص أو قضية))\nمثال: تحدث بحماسة كبيرة",
 "熱情的": "مُتَوَهِّج",
 "熱意": "حَمَاس / جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد .",
 "熱愛": "تَفَرُّغ",
 "熱愛者": "عَاشِق, عَاشِقَة / مُغْرَم",
 "熱戦": "حَرْب سَاخِنَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)",
 "熱暴走": "تسخين مفرط, فرط السخونة (تسخين مفرط)",
 "熱核反応": "تفاعل نووي حراري (تفاعل اندماج نووي يحدث في درجات حرارة عالية جداً (كما في الشمس))",
 "熱機関": "محرك حراري (أي محرك يستخدم الحرارة للقيام بعمل)",
 "熱気": "حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد. / حَمَاس, حَمَاسَة / حُمَّة, حُمَّى / حمى, سخونة (ارتفاع في درجة حرارة الجسم؛ غالباً ما يكون عرضاً للعدوى) / محمومية, هياج (حالة من النشاط أو العاطفة المثارة بشدة)",
 "熱気球": "مُنْطَاد, بَالُون",
 "熱氣球": "مُنْطَاد, بَالُون",
 "熱水": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "熱水泉": "يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "熱汚染": "تلوث حراري (ضرر يلحق بالبحيرات والأنهار ناتج عن إطلاق حرارة زائدة فيها)",
 "熱波": "مَوْجَة اَلْحَرّ",
 "熱湯": "ماء مغلي (ماء تم تسخينه إلى درجة الغليان أو تجاوزها)\nمثال: هناك غلاية ماء مغلي على الموقد",
 "熱烈": "مُتَوَهِّج كَالنَّار, مُتَّقِد (يَتَوَهَّج أَوْ يَلْمَع كَالنَّار) / حَارّ, مُتَوَقِّد (يتّسم بحماسة شديدة وقويّة) / حَمَاسِيّ, مُتَحَمِّس (يَتَّسِمُ بِعَاطِفَةٍ شَدِيدَة)",
 "熱熱": "حرق بالسوائل, سلق (عملية الحرق بالبخار أو الماء الساخن) / سلق (حرق ناتج عن سائل ساخن أو بخار)",
 "熱狂ぶり": "تشقق دقيق (شق دقيق في الطلاء أو أي سطح آخر) / بدعة, صرعة (اهتمام يُتبع بحماس مبالغ فيه) / نوبة جنون, هياج (حالة من الهياج العقلي العنيف)\nمثال: يتبع دائماً أحدث الصرعات",
 "熱狂振り": "تشقق دقيق (شق دقيق في الطلاء أو أي سطح آخر) / بدعة, صرعة (اهتمام يُتبع بحماس مبالغ فيه) / نوبة جنون, هياج (حالة من الهياج العقلي العنيف)\nمثال: يتبع دائماً أحدث الصرعات",
 "熱狂的": "مَجْنُون, مَخْبُول",
 "熱狂的信者": "مُتَعَصِّب / مُتَعَصِّب, غَيُور",
 "熱狂者": "متحمس, نصير (مؤيد قوي ومتحمس لشخص أو نشاط ما) / مولع, هاوٍ (شخص لديه إعجاب قوي بشيء ما)",
 "熱疲労": "إنهاك حراري (حالة تتميز بالدوخة والغثيان والضعف الناجم عن استنزاف سوائل الجسم والشوارد)",
 "熱疲憊": "إنهاك حراري (حالة تتميز بالدوخة والغثيان والضعف الناجم عن استنزاف سوائل الجسم والشوارد)",
 "熱病": "حُمَّة, حُمَّى",
 "熱発": "حُمَّة, حُمَّى",
 "熱盛": "مُثِير",
 "熱盛り": "مُثِير",
 "熱硬化": "تصلبي الحرارة, صلد بالحرارة (له خاصية التصلب الدائم عند التسخين أو المعالجة)\nمثال: كانت راتنجات الفينول والبلاستيك هي المواد الاصطناعية الأصلية المتصلبة بالحرارة",
 "熱硬化剤": "مصلب, مقسي (مادة تزيد الصلابة، خاصة مادة تضاف إلى الورنيش أو الطلاء لمنحه سطحاً أو طبقة أكثر صلابة)",
 "熱硬化性樹脂": "راتينج تصلب بالحرارة, لدائن تصلب بالحرارة (مادة تتصلب عند تسخينها ولا يمكن إعادة تشكيلها)",
 "熱線": "شعاع تحت أحمر (شعاع من الأشعة تحت الحمراء؛ ينتج تأثيراً حرارياً (كما من مصباح الأشعة تحت الحمراء))",
 "熱臭い": "دَافِئ / دَفِيء",
 "熱血": "حَمَاس / جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد .",
 "熱血漢": "حَمِيّ الطَّبْع, مُتَّقِدُ المَشَاعِر (ميّال إلى الانفعال والعاطفة الشديدة)",
 "熱血男児": "حَمِيّ الطَّبْع, مُتَّقِدُ المَشَاعِر (ميّال إلى الانفعال والعاطفة الشديدة)",
 "熱誠": "جدية, رزانة (سمة كون المرء جاداً) / إخلاص, جدية (شعور جاد وصادق)\nمثال: نقص الوقار ليس بالضرورة نقصاً في الجدية",
 "熱量": "حَمَاس, حَمَاسَة",
 "熱量計": "مسعر, مقياس الحرارة (أداة قياس تحدد كميات الحرارة)",
 "熱電子": "أَيُون حَرَارِيّ (جسيم مشحون كهربائياً (إلكترون أو أيون) ينبعث من مادة عند درجة حرارة عالية)",
 "熱電対": "مزدوجة حرارية (نوع من مقاييس الحرارة يتكون من سلكين من معدنين مختلفين متصلين في كلا الطرفين؛ حيث يولد التيار في الدائرة بما يتناسب مع فرق درجات الحرارة)",
 "熾": "جَمْرَة",
 "熾す": "بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر والآجَر والخَرَسَانَة وغيرها؛ جعل الشيء يحدث خطوة بعد خطوة كأنه بناء وإن لم يكن شيئا ملموسا)\nمثال: بنى سامي منزلا.",
 "熾る": "اِشْتَعَلَ",
 "熾天使": "سَرَافِيم",
 "熾烈": "عَاصِف, مُضْطَرِب (شَدِيد الهَيَجَان والاضْطِرَاب) / شَرِس, ضَارٍ (عَدِيمُ الرَّحْمَةِ فِي المُنَافَسَة) / جَامِح, حَادّ (يَتَّسِمُ بِشِدَّةٍ مُتَطَرِّفَةٍ فِي المَشَاعِرِ أَوِ القَنَاعَات؛ يَمِيلُ إِلَى رَدِّ الفِعْلِ العَنِيف) / شَرِس, ضَارٍ (يَتَّسِمُ بِطَاقَةٍ بَالِغَةِ العُنْفِ وَالشِّدَّة)",
 "熾盛": "حيوية, طاقة (أسلوب حيوي خيالي (خاصة أسلوب الكتابة)) / حيوية, نشاط (قوة نشطة للجسد أو العقل) / حيوية, طاقة (بذل قوي للجهد)\nمثال: تنقل كتابته طاقة كبيرة",
 "燃えあがる": "اِنْدَلَعَ",
 "燃えかす": "جَمْرُ مُنْطَفِيّ ((جمر) الْفرس جمرا وثب فِي الْقَيْد وَفُلَانًا أعطَاهُ جمرا ونحاه؛ جَمَرَ: الجَمْر: النَّارُ الْمُتَّقِدَةُ، وَاحِدَتُهُ جَمْرَةٌ. فإِذا بَرَدَ فَهُوَ فَحْمٌ)\nمثال: أنا أنتظر قرارك على أحر من الجمر.",
 "燃えがら": "جَمْرَة",
 "燃えさかる": "سَعِيرَا",
 "燃えさし": "جَمْرَة",
 "燃えつく": "اِشْتَعَلَ",
 "燃えないごみ": "غَيْر قَابِل لِلاِشْتِعَال (يستحيل إشعاله)",
 "燃えないゴミ": "غَيْر قَابِل لِلاِشْتِعَال (يستحيل إشعاله)",
 "燃える": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "燃えカス": "جَمْرُ مُنْطَفِيّ ((جمر) الْفرس جمرا وثب فِي الْقَيْد وَفُلَانًا أعطَاهُ جمرا ونحاه؛ جَمَرَ: الجَمْر: النَّارُ الْمُتَّقِدَةُ، وَاحِدَتُهُ جَمْرَةٌ. فإِذا بَرَدَ فَهُوَ فَحْمٌ)\nمثال: أنا أنتظر قرارك على أحر من الجمر.",
 "燃え上がる": "اِنْدَلَعَ",
 "燃え付く": "اِشْتَعَلَ",
 "燃え出す": "اِشْتَعَلَ",
 "燃え差し": "جَمْرَة",
 "燃え広がる": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "燃え止し": "جَمْرَة",
 "燃え残り": "جَمْرَة",
 "燃え殻": "جَمْرَة",
 "燃え盛る": "سَعِيرَا",
 "燃え移る": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "燃え種": "إشعال, إضرام (عملية إضرام النار في شيء ما) / صوفان, قشاشة (مادة لبدء إشعال النار)",
 "燃す": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "燃やす": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "燃ゆる土": "فَحْم حَجَرِيّ / فَحْم / فحم / فَحَم",
 "燃ゆる水": "بترول, نفط خام (زيت داكن يتكون أساساً من الهيدروكربونات)",
 "燃料": "وَقُود",
 "燃料噴射": "حقن الوقود (نظام ميكانيكي لحقن الوقود المذرى مباشرة في أسطوانات محرك الاحتراق الداخلي؛ يغني عن الحاجة للمكربن (الكربياتير))",
 "燃料気化爆弾": "متفجرات الوقود الهوائي (جهاز يتكون من حاوية وقود وشحنتين متفجرتين؛ الشحنة الأولى تفتح حاوية الوقود عند ارتفاع محدد وتنشر الوقود في سحابة تختلط بالأكسجين الجوي؛ الشحنة…)",
 "燃料油": "زيت الوقود, مازوت (منتج بترولي يُستخدم كوقود)",
 "燃料計": "عَدَّاد الوَقُود",
 "燃料電池": "خلية وقود (خلية تنتج الكهرباء عن طريق أكسدة الوقود (الهيدروجين والأكسجين أو الزنك والهواء)؛ تستخدم غالباً في السيارات الكهربائية)",
 "燃料電池実用化推進協議会": "خلية وقود (خلية تنتج الكهرباء عن طريق أكسدة الوقود (الهيدروجين والأكسجين أو الزنك والهواء)؛ تستخدم غالباً في السيارات الكهربائية)",
 "燃料電池自動車": "خلية وقود (خلية تنتج الكهرباء عن طريق أكسدة الوقود (الهيدروجين والأكسجين أو الزنك والهواء)؛ تستخدم غالباً في السيارات الكهربائية)",
 "燃料電池車": "خلية وقود (خلية تنتج الكهرباء عن طريق أكسدة الوقود (الهيدروجين والأكسجين أو الزنك والهواء)؛ تستخدم غالباً في السيارات الكهربائية)",
 "燃木": "حَطَب (حَطَبَ فُلَانًا حَطَباً يَحْطِبُه واحْتَطَبَ لَهُ: جَمَعَه لَهُ وأَتاهُ بِهِ؛ حَطَبُوه: قَطَعُوه)\nمثال: بحث زيري عن الحطب.",
 "燃油": "زيت الوقود, مازوت (منتج بترولي يُستخدم كوقود)",
 "燃焼": "احتراق, حرق (عملية حرق شيء ما) / حرق (شكل من أشكال التعذيب تستخدم فيه السجائر أو السيجار أو أدوات ساخنة أخرى لحرق جلد الضحية) / حرق, حرق على الخازوق (الإعدام بالنار) / صعق كهربائي (الإعدام بالكهرباء)\nمثال: حرق الأوراق كان ممنوعاً بموجب مرسوم المدينة",
 "燃焼器": "حَرَّاق, موقد (جهاز لحرق الوقود (أو النفايات)) / شعلة, عين الموقد (عناصر التسخين في الموقد التي توضع عليها الأواني والمقالي للطهي)\nمثال: محرك الديزل هو حراق زيت",
 "燃焼室": "حجرة احتراق (الغُرْفَة أو القَاعَة. تطلق على القَبْر والحَضِيرَة من باب التشبيه؛ ما يشبه الغرفة من الأرض، المكان المحمي أو المحاط بما يجعله شبيها بالمنعى الأول. استخدام مجازي وقديم)",
 "燃素": "فلوجستون (مادة افتراضية كان يعتقد سابقاً بوجودها في جميع المواد القابلة للاحتراق ويتم إطلاقها أثناء الاحتراق)",
 "燃費": "اِسْتِهْلَاك الوَقُود (نسبة عدد الأميال المقطوعة إلى عدد جالونات البنزين المحروقة)\nمثال: あなたの車は本当に燃費が悪いんですね。 — سيارتك تستهلك البنزين بكثرة.",
 "燈": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور.",
 "燈台": "مَنَارَة, مَنَار (أسم، محجَّة الطريق وما يُوضَع بين الشيئَين من الحدود؛ اسم، البرج عند البحر يوضع فيه نور لتهتدي به السفن) / عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "燈台草": "حليب الشيطان, فربيون الشمس (عشبة أوروبية غير جذابة تتحول زهورها نحو الشمس)",
 "燈心": "فَتِيل, فَتِيلَة",
 "燈火": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور.",
 "燈芯": "فَتِيل, فَتِيلَة",
 "燎原の火": "حَرِيق هَائِل (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "燐": "فُسْفُور",
 "燐光": "تالق فسفوري, فسفرة (فلورة تستمر بعد توقف الإشعاع القاصف)",
 "燐化水素": "فوسفين (غاز عديم اللون له رائحة سمكية قوية؛ يستخدم كمبيد للآفات)",
 "燐火": "سراب, وهم خادع (وهم يضلل) / مصباح العفريت, نار هائمة (ضوء باهت يُرى أحياناً في الليل فوق الأرض المستنقعية)",
 "燐灰石": "أباتيت",
 "燐礬石": "أمبليغونيت (معدن أبيض أو رمادي يتكون من فوسفات الليثيوم والألمنيوم؛ وهو مصدر لليثيوم)",
 "燐脂質": "دُهْن فُوسْفُورِيّ, لِيبِيد مُفَسْفَر (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق)\nمثال: توم بدهن غرفته.",
 "燐蛋白質": "بروتين فوسفوري (يحتوي على حمض الفوسفوريك المرتبط كيميائياً)",
 "燐酸": "حمض الفوسفوريك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "燐酸カルシウム": "فوسفات الكالسيوم (فوسفات للكالسيوم؛ مكون رئيسي لعظام الحيوانات)",
 "燐酸ナトリウム": "فوسفات الصوديوم (فوسفات للصوديوم؛ يستخدم كملين لتنظيف الأمعاء)",
 "燐酸化": "فسفرَة",
 "燐酸塩": "شراب الفوسفات (مشروب غازي مع شراب الفاكهة وقليل من حمض الفوسفوريك) / فوسفات (ملح لحمض الفوسفوريك)",
 "燐青銅": "برونز فوسفوري (برونز مقاوم للتآكل يحتوي على الفوسفور؛ يستخدم في المحامل والتروس)",
 "燕": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو / خطاف المخازن",
 "燕子": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو",
 "燕尾": "بدلة ذيل, معطف ذيل السنونو (سترة رسمية للرجال بذيلين طويلين مدببين في الخلف)",
 "燕尾服": "بدلة بذيول, بدلة رسمية كاملة (ملابس رسمية تتكون من زي سهرة كامل للرجال)",
 "燕支": "أحمر خدود (مكياج يتكون من مسحوق وردي أو أحمر يوضع على الخدين) / أحمر داكن (لون أحمر يعكس القليل من الضوء) / دودة قرمزية",
