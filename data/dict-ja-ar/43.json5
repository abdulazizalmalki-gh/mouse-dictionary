 "縦続": "ربط تسلسلي, سَلسَلة (عملية الربط معاً كما هو الحال في سلسلة أو تعاقب) / تسلسل مترابط, سلسلة (سلسلة من الأشياء تعتمد على بعضها البعض وكأنها مرتبطة معاً) / تَرَابُط, تَسَلْسُل (ربط سلسلة متتالية من الرموز أو الأحداث أو الأفكار معاً) / تسلسل, تعاقب (حالة الترابط معاً كما في سلسلة؛ الاتحاد في سلسلة مترابطة)\nمثال: تسلسل القيادة",
 "縦線": "خط البار, خط المقياس (خط عمودي قبل النبضة المشددة يحدد الحدود بين المقاييس الموسيقية)",
 "縦視野移動": "تحريك بالعجلات, دحرجة (دفع شيء على عجلات) / سلب العاجز, نشل السكارى (فعل سرقة شخص عاجز) / مُرَجَّع, مُكَرَّر (يُنطَق بترجيع أو ترعيد) / جلجلة, قصف (صوت عميق طويل (كما في الرعد أو الأجراس الكبيرة))\nمثال: اتُهم بسلب السكارى في الحديقة",
 "縦覧": "تَفَقُّد",
 "縦貫": "اجتياز, عبور (السفر عبر) / اجتياز متعرج (اتخاذ مسار متعرج على الزلاجات)",
 "縦走": "رَكْض (عَدَا)\nمثال: إنها تحب الركض.",
 "縦軸": "مِغْزَل",
 "縦長": "مُسْتَطِيل (مُنْحَرِف عَن شَكْل المُرَبَّع أَوْ الدَّائِرَة بِاسْتِطالَتِه في اتِّجاه واحِد) / مُسْتَطِيل الوَرَقَة ((عن شكل الورقة) ذو شكل مُستطيل بعض الشيء بجوانب شبه متوازية) / شكل مستطيل, مستطيل (شكل مستوٍ ينحرف عن المربع أو الدائرة بسبب الاستطالة)",
 "縦陣": "عَمُود / خَانَة",
 "縦隊": "عَمُود / خَانَة",
 "縦隔": "منصف (جزء التجويف الصدري بين الرئتين الذي يحتوي على القلب والأبهر والمريء والرغامى والتوتة)",
 "縫い": "تَطْرِيز",
 "縫いなおす": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "縫いもの": "خِيَاطَة, حِيَاكَة",
 "縫い取り": "تَطْرِيز",
 "縫い揚げ": "سيف ذو حدين (سيف مستقيم بنصل ضيق وحدين) / ثنية مخيطة (طية ضيقة مسطحة مثبتة بالخياطة) / انثناء, تكور ((في الرياضة) وضعية جسدية تُتخذ في بعض الرياضات (مثل الغوص أو التزلج) حيث يتم ثني الركبتين وسحب الفخذين بالقرب من الصدر) / تسالي, حلويات (مأكولات (خاصة الحلويات))",
 "縫い方": "بَالُوعَة / خَيَّاط",
 "縫い物": "خِيَاطَة, حِيَاكَة",
 "縫い目": "دَرْز (درز:درزا تمكن من درز الدُّنْيَا؛ دَرِزَ الرجلُ، كفَرِح، وَكَذَلِكَ ذَرِزَ، بالدّالِ والذّالِ، إِذا تمَكَّن مِنْهَا أَي من نَعيمِها)",
 "縫い直す": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "縫い糸": "خيط جراحي, قطبة (خيط من الأمعاء أو الحرير أو السلك يستخدمه الجراحون لخياطة الأنسجة معاً) / غرزة, قطبة جراحية (درزة أو وصلة تستخدم في الجراحة) / درز (مفصل غير متحرك (خاصة بين عظام الجمجمة))",
 "縫い込み": "سيف ذو حدين (سيف مستقيم بنصل ضيق وحدين) / ثنية مخيطة (طية ضيقة مسطحة مثبتة بالخياطة) / انثناء, تكور ((في الرياضة) وضعية جسدية تُتخذ في بعض الرياضات (مثل الغوص أو التزلج) حيث يتم ثني الركبتين وسحب الفخذين بالقرب من الصدر) / تسالي, حلويات (مأكولات (خاصة الحلويات))",
 "縫い針": "يعسوب (حشرة نحيلة الجسم غير لاسعة ذات أجنحة قزحية الألوان تكون مفرودة عند الراحة؛ تتغذى البالغات والحوريات على البعوض وما إلى ذلك) / إبرة خياطة (إبرة تستخدم في الخياطة لسحب الخيط عبر القماش)",
 "縫う": "خَاطَ (خَطَّ، خَيطَ في إبرة أو آلة؛ وَصَلَ أو أَصَّلَ أجزاء معًا باستخدام الخيط) / خَيَّطَ ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه)\nمثال: خاط سامي جيبه المثقوب.",
 "縫取り": "تَطْرِيز",
 "縫合": "خيط جراحي, قطبة (خيط من الأمعاء أو الحرير أو السلك يستخدمه الجراحون لخياطة الأنسجة معاً) / غرزة, قطبة جراحية (درزة أو وصلة تستخدم في الجراحة) / درز (مفصل غير متحرك (خاصة بين عظام الجمجمة))",
 "縫合糸": "خيط جراحي, قطبة (خيط من الأمعاء أو الحرير أو السلك يستخدمه الجراحون لخياطة الأنسجة معاً) / غرزة, قطبة جراحية (درزة أو وصلة تستخدم في الجراحة) / درز (مفصل غير متحرك (خاصة بين عظام الجمجمة))",
 "縫工": "خَيَّاط, خَيَّاطَة",
 "縫工筋": "عضلة خياطية (عضلة في الفخذ تساعد على تدوير الساق في وضع الجلوس الذي يتخذه الخياط؛ أطول عضلة في جسم الإنسان)",
 "縫成": "خِيَاطَة, حِيَاكَة",
