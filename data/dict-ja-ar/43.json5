 "紙やすり": "وَرَق زُجَاج (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "紙コップ": "كُوب وَرَقِيّ (إناء للشرب لا عروة له؛ كل إناء للشرب. (تعميم)(غير معياري))\nمثال: الكوب مليء بالحليب.",
 "紙テープ": "شريط ورقي (شريط طويل ضيق من الورق)",
 "紙パック": "كَرْتُون, كَرْتُونَة / عَرُوسَة",
 "紙ヒコーキ": "طَائِرَة وَرَقِيَّة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر)\nمثال: لقد وصلت الطائرة.",
 "紙マッチ": "علبة كبريت ورقية (حافظة صغيرة من أعواد الثقاب الورقية الآمنة)",
 "紙ヤスリ": "وَرَق زُجَاج (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "紙上": "على الورق, نظرياً (في النظرية؛ وفقاً للحقائق المفترضة) / عَلَى الوَرَق, نَظَرِيًّا (كما هو مكتوب أو مطبوع)\nمثال: على الورق يبدو المرشح واعداً",
 "紙人形": "دمية ورقية (قطعة من الورق مقصوصة أو مطوية على شكل إنسان)",
 "紙入": "مِحْفَظَة, حَافِظَة",
 "紙入れ": "مِحْفَظَة, حَافِظَة",
 "紙切り": "سكين ورق, فتاحة رسائل (سكين غير حاد يستخدم لفتح الأظرف التي تُرسل فيها الرسائل أو لشق صفحات الكتب غير المقطوعة)",
 "紙切りナイフ": "قطاعة الورق, مقص الورق (أداة قطع لقطع أوراق الورق للحجم المطلوب)",
 "紙切れ": "وَرَقَة",
 "紙吹雪": "نِثَار",
 "紙型": "رَوْسَم",
 "紙屋": "صناعة الورق (حرفة صنع الورق)",
 "紙屑かご": "سلة أوراق, سلة مهملات (حاوية مفتوحة من الأعلى؛ للأوراق المرمية وغيرها من القمامة)",
 "紙屑拾い": "جامع القمامة, نبّاش (شخص غير ماهر يجمع الخرق من القمامة العامة كوسيلة للعيش)",
 "紙屑籠": "سلة أوراق, سلة مهملات (حاوية مفتوحة من الأعلى؛ للأوراق المرمية وغيرها من القمامة)",
 "紙巻": "سِيجَارَة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض التدخين)\nمثال: دخن زيري سيجارة.",
 "紙巻き": "سِيجَارَة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض التدخين)\nمثال: دخن زيري سيجارة.",
 "紙巻きたばこ": "سِيجَارَة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض التدخين)\nمثال: دخن زيري سيجارة.",
 "紙巻きタバコ": "سِيجَارَة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض التدخين)\nمثال: دخن زيري سيجارة.",
 "紙巻たばこ": "سِيجَارَة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض التدخين)\nمثال: دخن زيري سيجارة.",
 "紙巻タバコ": "سِيجَارَة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض التدخين)\nمثال: دخن زيري سيجارة.",
 "紙幣": "بنكنوت, نقود ورقية (عملة تصدرها حكومة أو بنك مركزي وتتكون من ورق مطبوع يمكن تداوله كبديل للنقود المعدنية)",
 "紙挟み": "مِشْبَك وَرَق",
 "紙漉き": "صناعة الورق (حرفة صنع الورق)",
 "紙皿": "طبق ورقي (طبق مصنوع من الورق المقوى يستخدم لمرة واحدة)",
 "紙礫": "كرة ملعوبة (رمية غير قانونية يتم فيها وضع مادة غريبة (لعاب أو فازلين) على الكرة من قبل الرامي قبل رميها) / كرة ورقية ممضوغة (قذيفة تصنع عن طريق مضغ قطعة من الورق وتشكيلها في كرة)",
 "紙筆": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "紙綴器": "دَبَّاسَة",
 "紙花": "جهنمية ملساء, زهرة الورق (كرمة برازيلية تميل للإزهار بشكل مستمر)",
 "紙表紙": "وَرَقِيّ الغِلَاف ((للكتب) ذو غلاف مرن) / كتاب غلاف ورقي (كتاب بأغلفة ورقية)",
 "紙袋": "كيس, كيس ورقي (كيس مصنوع من الورق أو البلاستيك لحمل مشتريات الزبائن)",
 "紙送り": "جهاز تغذية الورق, ملقم الورق (جهاز لإدخال أوراق في طابعة أو آلة كاتبة)\nمثال: تأخرت المهمة بسبب انسداد ملقم الورق",
 "紙鉄砲": "مسدس الفلين, مسدس لعبة (لعبة تتكون من مسدس لعبة يصدر صوت فرقعة)",
 "紙鑢": "وَرَق زُجَاج (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "紙面": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "紙飛行機": "طَائِرَة وَرَقِيَّة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر)\nمثال: لقد وصلت الطائرة.",
 "級": "دَرَجَة\nمثال: 彼は１０年級に在学中だ。 — هو في الصف العاشر. / صِنْف, صَنْف / طَبَقَة / فَصْل, صَفّ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)\nمثال: اقرأ هذا الفصل.",
 "級の木": "زيزفون ياباني (شجرة متوسطة الحجم من اليابان تستخدم للزينة)",
 "級別": "تصحيح, وضع الدرجات (تقييم الأداء عن طريق تعيين درجة أو نتيجة) / تسوية الأرض, تمهيد (تغيير مستوى الأرض إلى سطح أفقي أملس أو منحدر بلطف) / تدرج, تصنيف (فعل الترتيب في سلسلة متدرجة)\nمثال: ما كرهه في التدريس هو كل التصحيح الذي كان عليه القيام به",
 "級友": "زَمِيل دِرَاسَة, رَفِيق صَفّ",
 "級数": "سِلْسِلَة, مَجْمُوعَة / مُسَلْسَلَات تِلِفِزْيُونِيَّة, مُسَلْسِلَات / مُتَسَلْسِلَة, سِلْسِلَة",
 "紛々": "اِحْتَارَ / تَشَوَّش / اِرْتَبَكَ, تَشَوَّش",
 "紛い": "تَقْلِيد",
