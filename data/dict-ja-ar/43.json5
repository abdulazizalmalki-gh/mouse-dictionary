 "測度": "قِيَاس / فَاصِلَة / إِجْرَاء / قَاسَ (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "測微計": "ميكرومتر",
 "測深": "ذُو صَوْت, مُصَوِّت (يُصدر صوتاً أو ذو صوت محدد؛ يُستخدم كلاحقة تركيبية) / سبر الغور (فعل قياس عمق الماء (عادة باستخدام حبل السبر)) / رَنَّان, مُصَوِّت (ذو حجم صوتي أو عمق) / ذُو صَوْت, ذُو مَظْهَر (يبدو كما يُوصَف؛ يُستخدَم عادةً في التراكيب المركّبة)",
 "測深器": "مسبار الأعماق, مقياس العمق (أداة ملاحية تستخدم لقياس عمق مسطح مائي (بواسطة الموجات فوق الصوتية أو الرادار))",
 "測深機": "مسبار الأعماق, مقياس العمق (أداة ملاحية تستخدم لقياس عمق مسطح مائي (بواسطة الموجات فوق الصوتية أو الرادار))",
 "測程儀": "خَشَبَة",
 "測程器": "خَشَبَة",
 "測色": "تحليل لوني, قياس اللون (التحليل الكيميائي الكمي عن طريق اللون باستخدام مقياس اللون)",
 "測色計": "مقياس الألوان (أداة قياس تستخدم في التحليل اللوني لتحديد كمية مادة ما من اللون الذي تنتجه مع كواشف محددة)",
 "測距": "جائل, طائف (يتجول بحرية)\nمثال: في الليل في السرير؛ واجهتها أفكاره الجائلة ببطء",
 "測距儀": "محدد المدى (أداة قياس (صوتية أو بصرية أو إلكترونية) للعثور على مسافة جسم ما)",
 "測量": "قياس (فعل أو عملية تعيين أرقام للظواهر وفقًا لقاعدة)\nمثال: تمت القياسات بعناية",
 "測量器": "أداة مسح (أداة يستخدمها المساحون)",
 "測量学": "مساحة, مسح الأراضي (ممارسة قياس الزوايا والمسافات على الأرض بحيث يمكن رسمها بدقة على خريطة)\nمثال: درس المساحة في الكلية",
 "測量家": "مساح, مهندس مساحة (مهندس يحدد حدود وارتفاعات الأراضي أو الهياكل) / ماسح إحصائي (شخص يجري مسحًا إحصائيًا)",
 "測量技師": "مساح, مهندس مساحة (مهندس يحدد حدود وارتفاعات الأراضي أو الهياكل) / ماسح إحصائي (شخص يجري مسحًا إحصائيًا)",
 "測量機械": "أداة مسح (أداة يستخدمها المساحون)",
 "測鉛": "ثقل السبر (ثقل معدني في نهاية خيط السبر)",
 "測高器": "مقياس الارتفاع بالغليان (مقياس ارتفاع يستخدم نقطة غليان الماء لتحديد ارتفاع الأرض)",
 "港": "مرفأ, ملاذ (مكان للملجأ والراحة والأمان) / مرفأ, ميناء بحري (ميناء محمي حيث يمكن للسفن شحن أو تفريغ البضائع)",
 "港津": "مرفأ, ملاذ (مكان للملجأ والراحة والأمان) / مرفأ, ميناء بحري (ميناء محمي حيث يمكن للسفن شحن أو تفريغ البضائع)",
 "港湾": "مرفأ, ملاذ (مكان للملجأ والراحة والأمان) / مرفأ, ميناء بحري (ميناء محمي حيث يمكن للسفن شحن أو تفريغ البضائع)",
 "港湾労働者": "عامل ميناء (عامل ذكر يقوم بتحميل وتفريغ السفن في الميناء)",
 "港都": "مرفأ, ميناء بحري (ميناء محمي حيث يمكن للسفن شحن أو تفريغ البضائع)",
 "游ぎ": "سِبَاحَة",
 "游士": "هَائِم",
 "游子": "هَائِم",
 "游撃": "مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ / التوقف القصير, شورت ستوب (مركز اللعب للاعب في فريق البيسبول المتمركز بين القاعدة الثانية والثالثة) / لاعب التوقف القصير",
 "游蛇": "ثعبان الماء (أي من ثعابين متنوعة غير ضارة في الغالب تعيش في الماء أو بالقرب منه)",
 "渺": "بِلَا حُدُود, لَامَحْدُود (يَبْدُو بِلَا حُدُودٍ فِي الكَمِّيَّةِ أَوِ العَدَدِ أَوِ الدَّرَجَةِ أَوِ المَدَى)",
 "渺々": "بِلَا حُدُود, لَامَحْدُود (يَبْدُو بِلَا حُدُودٍ فِي الكَمِّيَّةِ أَوِ العَدَدِ أَوِ الدَّرَجَةِ أَوِ المَدَى)",
 "渺渺": "بِلَا حُدُود, لَامَحْدُود (يَبْدُو بِلَا حُدُودٍ فِي الكَمِّيَّةِ أَوِ العَدَدِ أَوِ الدَّرَجَةِ أَوِ المَدَى)",
 "渺茫": "شَاسِع, وَاسِع",
 "渾名": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الدَّلَع (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "渾天儀": "الإسطرلاب الكروي, ذات الحلق (كرة سماوية تتكون من أطواق معدنية؛ استخدمها علماء الفلك الأوائل لتحديد مواقع النجوم)",
 "渾然": "كَامِل / كُلّ",
 "湊": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "湊元": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "湊川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "湊本": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "湊谷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "湍": "ضَحِل / سَرِيع / مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث. / فُرْصَة",
 "湖": "بُحَيْرَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / بحيرة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / بُحيرَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / ضاية / لَكّ\nمثال: سبحنا في البحيرة.",
 "湖北": "خُوبِي, هُوبِي",
 "湖南": "خُونَان, هُونَان",
 "湖岸": "شاطئ البحيرة (شاطئ بحيرة)",
 "湖水": "بُحَيْرَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / بحيرة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / بُحيرَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / ضاية / لَكّ\nمثال: سبحنا في البحيرة.",
 "湖沼": "بُحَيْرَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / بحيرة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / بُحيرَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / ضاية / لَكّ\nمثال: سبحنا في البحيرة.",
 "湖沼学": "علم المسطحات المائية الداخلية (الدراسة العلمية للمسطحات المائية العذبة لخصائصها البيولوجية والفيزيائية والجيولوجية)",
 "湖畔": "شاطئ البحيرة (شاطئ بحيرة)",
 "湛える": "مَلَأَ / عَبَّرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "湛山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "湛水": "علاج بالغمر, علاج بالفيضان (تقنية تستخدم في العلاج السلوكي؛ يتم إغراق العميل بتجارب من نوع معين حتى يصبح كارهاً لها أو مخدراً تجاهها)",
 "湧かす": "رَبَّى",
 "湧き": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق. / حُضُور, مُثُول (حضور رسمي (في المحكمة أو في جلسة استماع) لطرف في دعوى)",
 "湧き上がる": "هَاجَ, غَلَى / نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "湧き出る": "تَدَفُّق / تَدَفَّقَ, سَالَ / ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "湧き水": "مياه الينابيع (مياه من نبع طبيعي) / مياه جوفية (مياه تحت الأرض محتجزة في التربة وفي الصخور المنفذة)",
 "湧き起こる": "انفجار (عملية الانفجار أو التفرقع) / فورة, نوبة (فورة مفاجئة من النشاط (غالباً لسبب غير واضح)) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: انفجار الألعاب النارية أيقظ الأطفال",
 "湧く": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق. / ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه. / حَضَنَ (مَا دُونُ الإِبْط إِلى الكَشح؛ الصَّدْرُ والعَضُدان وَمَا بَيْنَهُمَا)\nمثال: كان زيري يعيش في حضن الرفاهية.",
 "湧出量": "مُخرَج / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة.",
 "湧川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "湧水": "مياه الينابيع (مياه من نبع طبيعي) / مياه جوفية (مياه تحت الأرض محتجزة في التربة وفي الصخور المنفذة)",
 "湧泉": "نَافُورَة, فَوَّارَة",
 "湫": "أرض رطبة (منطقة منخفضة تكون الأرض فيها مشبعة بالماء)",
 "湮滅": "تَدْمِير, هَدْم",
 "湯": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية / يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي. / شُورَبَة (في : هي الحَسَاء) / شُرْبَة / حَسَاء\nمثال: هل مذاق الشوربة جيد؟",
 "湯あか": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "湯あみ": "حَمَّام, مُغْسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / حَمَّام, مُغْتَسَل (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / اِسْتِحْمَام, اِغْتِسَال\nمثال: هل الحمام جاهز؟",
 "湯がく": "حرق بالسوائل, سلق (عملية الحرق بالبخار أو الماء الساخن) / سلق (حرق ناتج عن سائل ساخن أو بخار)",
 "湯くみ": "مِغْرَفَة",
 "湯けむり": "بُخَار (كلُّ رَائِحَةٍ سَطَعَتْ مِنْ نَتْنٍ أَو غَيْرِهِ؛ كل مَا يصعد كالدخان من السوائل الحارة والرائحة)\nمثال: السحابة هي كتلة بخار في السماء.",
 "湯たんぽ": "قربة ماء ساخن (وعاء ذو سدادة (عادة من المطاط) يملأ بالماء الساخن لتدفئة السرير أو الجسم)",
 "湯のし": "مكواة بخار (مكواة ضغط يمكنها نفث البخار)",
 "湯のみ": "فنجان شاي (كوب يشرب منه الشاي) / ملء فنجان شاي (بقدر ما يستوعبه فنجان شاي)",
