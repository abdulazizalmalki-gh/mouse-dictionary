 "第３": "ثَالِث, ثَالِثَة / ثُلْث (ثَلَثَ الحبل ونحوه يَثْلُثُ ثَلْثًا: فَتَلَهُ من ثلاث قُوى؛ ثَلَثَ العمل: عمله ثلات مرات)\nمثال: الساعة العاشرة والثلث.",
 "第３債務者": "محجوز لديه (كاسب أجر يتم إبلاغه بأمر حجز على الراتب)",
 "第３次世界大戦": "اَلْحَرْبُ اَلْعَالَمِيَّةُ اَلثَّالِثَة",
 "第３種郵便物": "بريد الدرجة الثالثة (بريد يتكون من مواد مطبوعة مؤهلة لأسعار بريدية مخفضة)",
 "第３脳室": "بطين ثالث (بطين ضيق في المستوى المتوسط أسفل الجسم الثفني؛ يتصل بالبطين الرابع عبر قناة سيلفيان)",
 "第４": "رَابِع, رَابِعَة (رابعوا الحمِلَ مرابعة: أدخلوا المِربَعة تحتهُ)\nمثال: زيري هو الرابع.",
 "第５": "خَامِس, خَامِسَة / خُمْس ((خَمَسَ) المَال خمْسا: أَخذ خمسه؛ (خَمَسَ) فُلَانًا أَخذ خمس مَاله)\nمثال: رأيت خمسة رجال.",
 "第６": "سَادِس, سَادِسَة / سُدْس",
 "第７": "سَابِع, سَابِعَة / سُبْع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: عمره سبع سنوات.",
 "第８": "ثَامِن, ثَامِنَة / ثُمْن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن.",
 "第９": "تَاسِع, تَاسِعَة / تُسْع (الثَلَاثُ التُسَع: الليلة السابعة والثامنة والتاسعة من كل شهر قمري…)\nمثال: عمري تسعة عشر سنة",
 "笳": "أنبوب قصبي (أنبوب أرغن بقصبة مهتزة)",
 "笹がき": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "笹掻き": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "笹蟹": "عَنْكَبُوت, شَبَث",
 "筆": "فُرْشَاة الطِلَاء / الخط, فن الخط (الكتابة اليدوية الجميلة) / كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة. / لُوط",
 "筆つき": "أسلوب الرسم, ضربة الفرشاة (التقنية المميزة للفنان في تطبيق الطلاء بفرشاة)",
 "筆を執る": "زَرِيبَة, حَظِيرَة / قَلَم, قَلَم حِبْر (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "筆を擱く": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "筆を置く": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "筆付き": "أسلوب الرسم, ضربة الفرشاة (التقنية المميزة للفنان في تطبيق الطلاء بفرشاة)",
 "筆使い": "أسلوب الرسم, ضربة الفرشاة (التقنية المميزة للفنان في تطبيق الطلاء بفرشاة)",
 "筆入れ": "مِقْلَمَة",
 "筆写": "نسخ (فعل النسخ)",
 "筆勢": "أسلوب الرسم, ضربة الفرشاة (التقنية المميزة للفنان في تطبيق الطلاء بفرشاة)",
 "筆名": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "筆墨": "قِرْطَاسِيَّة",
 "筆屋": "صَانِعُ الْفُرَش (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "筆意": "أسلوب الرسم, ضربة الفرشاة (التقنية المميزة للفنان في تطبيق الطلاء بفرشاة)",
 "筆札": "خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "筆生": "ناسخ, ورّاق (شخص يعمل لعمل نسخ مكتوبة من الوثائق والمخطوطات)",
 "筆界": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "筆研": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "筆硯": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "筆端": "أسلوب الكتابة, نوع أدبي (نمط للتعبير عن النفس في الكتابة)",
 "筆箱": "مِقْلَمَة",
 "筆者": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "筆致": "لَمَسَ (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما) / لَمْسَة, مُلَامَسَة / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي!",
 "筆舌": "وَصْف, تَوْصِيف",
 "筆記": "نسخ (فعل النسخ) / مُلَاحَظَة, مَلْحُوظَة / مُذَكَّرَة / دَرَجَة",
 "筆記帳": "دَفْتَر, مُذَكِّرَة / كَمْبْيُوتَر مَحْمُول, حَاسُوب مَحْمُول",
 "筆記用具": "أداة كتابة (أداة تستخدم للكتابة)",
 "筆記者": "ناسخ, ورّاق (شخص يعمل لعمل نسخ مكتوبة من الوثائق والمخطوطات)",
 "筆跡": "خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / صورة ثلاثية الأبعاد, هولوغرام (الصورة الوسيطة (أو السجل الفوتوغرافي) التي تحتوي على معلومات لإعادة إنتاج صورة ثلاثية الأبعاد عن طريق التصوير المجسم) / مخطوطة (كتاب أو وثيقة مكتوبة بخط اليد)",
 "筆跡学": "جرافولوجي, علم الخط (دراسة خط اليد (خاصة كمؤشر على شخصية الكاتب أو مزاجه))",
 "筆遣い": "أسلوب الرسم, ضربة الفرشاة (التقنية المميزة للفنان في تطبيق الطلاء بفرشاة)",
 "筆録": "تدوين, سجل مكتوب (وثيقة مكتوبة تحفظ المعرفة بوقائع أو أحداث)",
 "筆頭": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "筈": "يَنْبَغِي أَنْ / مِنْ اَلْمَفْرُوض أَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / مِنْ اَلْمُفْتَرَض أَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "等": "وَهٰكَذَا, وَهَلُمَّ جَرًّا / أشباه, أمثال (نوع مماثل)\nمثال: الكلاب والثعالب وما شابه ذلك / مَثَلاً, عَلَى سَبِيل الْمِثَال / صِنْف, صَنْف / طَبَقَة / فَصْل, صَفّ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)\nمثال: اقرأ هذا الفصل. / عِدْل (عَدْل) / مُسَاوٍ, الْمُسَاوِي / سَاوَى\nمثال: هل يعاملون بالعدل / تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة",
 "等々": "إلخ, وما إلى ذلك (الاستمرار بنفس الطريقة)",
 "等しい": "عِدْل (عَدْل) / مُسَاوٍ, الْمُسَاوِي / سَاوَى\nمثال: هل يعاملون بالعدل / مُعَادِل",
 "等しく": "بِالتَّسَاوِي",
 "等など": "وَهٰكَذَا, وَهَلُمَّ جَرًّا",
 "等を分ける": "دَرَجَة",
 "等伏角線": "خط تساوي الميل (خط تساوي يربط نقاط الميل المغناطيسي المتساوي)",
 "等位": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "等位接続詞": "حَرْف عَطْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "等価": "قَابِلِيَّة لِلْمُقَارَنَة, مُضَاهَاة (السمات التي يمكن مقارنتها) / تَعَادُل, تَكَافُؤ (مساواة جوهرية وقابلية للتبادل) / تكافؤ, مساواة (حالة من التساوي أو التكافؤ الجوهري؛ التوازن المتساوي)\nمثال: لا توجد مقارنة بين الكتابين",
 "等価値": "قَابِلِيَّة لِلْمُقَارَنَة, مُضَاهَاة (السمات التي يمكن مقارنتها) / تَعَادُل, تَكَافُؤ (مساواة جوهرية وقابلية للتبادل) / تكافؤ, مساواة (حالة من التساوي أو التكافؤ الجوهري؛ التوازن المتساوي)\nمثال: لا توجد مقارنة بين الكتابين",
 "等値": "قَابِلِيَّة لِلْمُقَارَنَة, مُضَاهَاة (السمات التي يمكن مقارنتها) / تَعَادُل, تَكَافُؤ (مساواة جوهرية وقابلية للتبادل) / تكافؤ, مساواة (حالة من التساوي أو التكافؤ الجوهري؛ التوازن المتساوي)\nمثال: لا توجد مقارنة بين الكتابين",
 "等値線": "خط التساوي, خط الكنتور (خط مرسوم على خريطة يربط بين النقاط التي لها نفس القيمة العددية لمتغير ما)",
 "等偏角線": "خط تساوي الانحراف (خط وهمي يربط بين النقاط على سطح الأرض حيث يكون الانحراف المغناطيسي متساوياً)",
 "等化": "تسوية, مساواة (فعل جعل الأشياء متساوية أو موحدة)",
 "等化器": "هدف التعادل (تسجيل يجعل النتيجة متساوية) / ثقل موازن (وزن يوازن وزناً آخر) / إيكولايزر, معادل الصوت (معدات إلكترونية تقلل من تشويه التردد)",
 "等圧式": "خط تساوي الضغط ((أرصاد جوية) خط تساوي يربط النقاط ذات الضغط الجوي المتساوي في وقت معين)",
 "等圧線": "خط تساوي الضغط ((أرصاد جوية) خط تساوي يربط النقاط ذات الضغط الجوي المتساوي في وقت معين)",
 "等外": "خاسر, منهزم (متسابق يخسر المسابقة)",
 "等寒線": "خط تساوي حرارة الشتاء (خط على خريطة يربط الأماكن التي لها نفس متوسط درجة حرارة الشتاء)",
 "等差": "فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ",
 "等差数列": "مُتَتَالِيَةٌ حِسَابِيَّة",
 "等幅フォント": "خط الآلة الكاتبة, خط ثابت العرض (نمط خط يتم فيه إعطاء كل حرف نفس العرض (كما في الآلة الكاتبة))",
 "等式": "مُسَاوَاة / تَسَاوٍ",
 "等張": "مُتَسَاوِي التَّوَتُّر (يتعلق بـ أو ينطوي على تقلص عضلي يكون فيه التوتر ثابتاً بينما يتغير الطول) / متساوي التوتر, متساوي الضغط الأسموزي ((يستخدم للمحاليل) لها نفس الضغط الأسموزي أو ضغط متساوٍ) / مُتَسَاوِي التَّوَتُّر ((لِعَضَلَتَيْنِ أَوْ أَكْثَرَ) ذَوَاتُ تَوَتُّرٍ مُتَسَاوٍ) / متساوي النغمة (متعلق بالفواصل المتساوية للسلم الموسيقي أو يتميز بها)\nمثال: دوزان متساوي النغمة",
 "等張液": "محلول متساوي التوتر (محلول له نفس الضغط الاسموزي للدم)",
 "等方": "مُتَمَاثِل المَنَاحِي, مُتَنَاحٍِ",
 "等方性": "تماثل الخواص, توحد الخواص ((فيزياء) خاصية كون الشيء متماثل الخواص؛ له نفس القيمة عند قياسه في اتجاهات مختلفة)",
 "等方的": "مُتَمَاثِل المَنَاحِي, مُتَنَاحٍِ",
 "等時": "مُتَسَاوِي الزَّمَن (متساوٍ في المدّة أو الفاصل الزمني)",
 "等時性": "إيزوكرونية, تساوي الزمن (خاصية الحدوث بانتظام في فترات زمنية متساوية، والحفاظ على فترة أو فاصل زمني ثابت، على الرغم من الاختلافات في العوامل الأخرى القابلة للقياس في نفس…)\nمثال: كان اكتشاف غاليليو هو أن فترة تأرجح البندول مستقلة عن سعته — قوس التأرجح — تساوي زمن البندول",
 "等比数列": "مُتَتَالِيَة هَنْدَسِيَّة",
 "等比級数": "مُتَسَلْسِلَة هَنْدَسِيَّة (متتالية هندسية مكتوبة كمجموع)",
 "等温": "مُتَسَاوِي الحَرَارَة ((عن عملية أو تغيّر) يحدث عند درجة حرارة ثابتة)",
 "等温式": "خط تساوي الحرارة ((أرصاد جوية) خط تساوي يربط النقاط التي لها نفس درجة الحرارة في وقت معين)",
 "等温線": "خط تساوي الحرارة ((أرصاد جوية) خط تساوي يربط النقاط التي لها نفس درجة الحرارة في وقت معين)",
 "等生化": "تطبيع, تقييس (فرض المعايير أو اللوائح)",
 "等等": "إلخ, وما إلى ذلك (الاستمرار بنفس الطريقة)",
 "等級": "دَرَجَة / حجم, عِظَم (خاصية الحجم النسبي أو المدى (سواء كان كبيراً أو صغيراً)) / أهمية, جسامة (الأهمية النسبية) / أُسّ عَشْرِيّ, رُتْبَة مِقْدَارِيَّة (رقم مخصص لنسبة كميتين؛ تكون كميتان من نفس الرتبة المقدارية إذا كانت إحداهما أقل من 10 أضعاف الأخرى)\nمثال: حاولوا التنبؤ بمقدار الانفجار",
 "等脚類": "متماثلات الأرجل (أي من القشريات البرية أو المائية الصغيرة المختلفة بسبعة أزواج من الأرجل المتكيفة للزحف)",
 "等角": "مُتَسَاوِي الزَّوَايَا (ذو زوايا متساوية جميعها)",
 "等角三角形": "مثلث متساوي الأضلاع (مضلع منتظم ثلاثي الأضلاع)",
 "等語線": "حد لغوي, خط تساوي اللغة (الحدود المكانية لميزة لغوية معينة، مثل نطق حرف متحرك، أو معنى كلمة، أو استخدام ميزة نحوية)",
 "等質": "متجانس (كله من نفس النوع أو الطبيعة أو متشابه)\nمثال: مجموعة متجانسة متماسكة",
 "等距離": "مُتَسَاوِي البُعْد (على نفس المسافة عند كلّ نقطة)",
 "等身大": "بِالحَجْم الطَّبِيعِيّ (بنفس حجم الأصل) / وَفِيّ, مُخْلِص / أَمِين (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "等辺三角形": "مثلث متساوي الأضلاع (مضلع منتظم ثلاثي الأضلاع)",
 "等閑": "أَهْمَلَ / إِهْمَال",
 "等閑に付す": "أَهْمَلَ / إِهْمَال",
 "等高線": "خط الكنتور, خط المناسيب (خط مرسوم على خريطة يربط بين النقاط المتساوية الارتفاع)",
 "等高線図": "خريطة تضاريس, خريطة كنتورية (خريطة تحتوي على خطوط كنتور تمر عبر نقاط متساوية الارتفاع)",
 "等高線地図": "خريطة تضاريس, خريطة كنتورية (خريطة تحتوي على خطوط كنتور تمر عبر نقاط متساوية الارتفاع)",
 "筋": "عَضَلَة / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة. / وَرِيد, عِرْق / ليف مقوى (مادة تشبه الجلد مصنوعة بضغط طبقات من الورق أو القماش) / سجية, شخصية (مجموعة السمات المتأصلة المعقدة التي تحدد التصرفات وردود الأفعال الأخلاقية والأدبية للشخص) / ليف, ليفة (أي من الخلايا المتطاولة الخيطية المتعددة (خاصة الليف العضلي أو الليف العصبي)) / ألياف, ألياف غذائية (طعام نباتي خشن عسر الهضم منخفض العناصر الغذائية؛ كتلته تحفز التمعج المعوي)\nمثال: يهدف التعليم إلى تكوين الشخصية / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "筋けいれん": "تشنج, تقلص عضلي (انقباض عضلي مؤلم وغير إرادي)",
 "筋の通った": "عَقْلَانِيّ",
 "筋の通らない": "مُبَعْثَر, مُشَوَّش (يفتقر إلى الاستمرارية المنظمة) / غير منطقي (يفتقر إلى العلاقة المنطقية الصحيحة)",
 "筋ジストロフィー": "حثل عضلي, ضمور العضلات (أي من العديد من الأمراض الوراثية للجهاز العضلي التي تتميز بضعف وهزال العضلات الهيكلية)",
 "筋交い": "مَائِل, قُطْرِيّ",
 "筋原線維": "لييفة عضلية (واحدة من العديد من الخيوط المتقلصة التي تشكل الألياف العضلية المخططة)",
 "筋原繊維": "لييفة عضلية (واحدة من العديد من الخيوط المتقلصة التي تشكل الألياف العضلية المخططة)",
 "筋収縮": "انقباض, تقلص عضلي ((فسيولوجيا) تقصير أو توتر جزء أو عضو (خاصة العضلة أو الألياف العضلية))",
 "筋合": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "筋合い": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "筋弛緩薬": "مرخي عضلات (عقار يقلل من انقباض العضلات عن طريق منع انتقال النبضات العصبية أو عن طريق تقليل استثارة الصفيحة الانتهائية الحركية أو عن طريق إجراءات أخرى)",
 "筋張った": "قَوِيّ البُنْيَة, مَفْتُول العَضَلَات ((للشخص) يمتلك قوة بدنية ووزنًا؛ متين وجبار)",
 "筋形質": "ساركوبلازم, هيولى عضلية (سيتوبلازم الليفة العضلية المخططة)",
 "筋押し": "تصحيح, وضع الدرجات (تقييم الأداء عن طريق تعيين درجة أو نتيجة)\nمثال: ما كرهه في التدريس هو كل التصحيح الذي كان عليه القيام به",
 "筋播き": "إنتاج النفط, تنقيب (فعل حفر ثقب في الأرض على أمل إنتاج البترول) / تثقيب, حفر (فعل التثقيب أو الحفر)",
 "筋書き": "مُلَخَّص / خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "筋注": "حقن عضلي (حقنة في العضلة)",
 "筋炎": "التهاب العضلات (التهاب الأنسجة العضلية)",
 "筋無力症": "وهن عضلي (أي ضعف في العضلات) / وهن عضلي وبيل (مرض تدريجي مزمن يتميز بالتعب المزمن والضعف العضلي)",
 "筋状": "شريط, نطاق (زينة تتكون من شريط بلون أو مادة مغايرة) / تقليم, خط (علامة ضيقة بلون أو ملمس مختلف عن الخلفية) / صنف, طينة (نوع أو فئة (من الناس أو التوجهات)) / شارة الرتبة, شريط رتبة\nمثال: ضفدع أخضر بخطوط سوداء صغيرة",
 "筋疾患": "اعتلال عضلي (أي حالة مرضية تصيب العضلات ولا تعزى إلى خلل وظيفي عصبي)",
 "筋痙攣": "تشنج, تقلص عضلي (انقباض عضلي مؤلم وغير إرادي)",
 "筋痛": "ألم العضلات (ألم في عضلة أو مجموعة من العضلات)",
 "筋痛性脳脊髄炎": "ـنِي, ـنِيَ / ـِي, ـِيَ",
 "筋目": "طَوَى / طَيَّة / أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم) / أصل, سلالة (الاشتقاق الوراثي للفرد) / أجرة الكتابة, سعر السطر (معدل الدفع للمواد المكتوبة التي تقاس وفقاً لعدد الأسطر المقدمة) / عَدَد الأَسْطُر (عدد الأسطر في مادة مطبوعة)\nمثال: كل سلالته كانت محاربين / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / عَلَاقَة",
 "筋立て": "حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ",
 "筋節": "ساركومير, قُسَيْم عضلِي (وحدة من الوحدات التي ينقسم إليها اللييف العضلي)",
 "筋細胞": "خلية عضلية, ليف عضلي (خلية متطاولة قابلة للانقباض تشكل عضلات الجسم)",
 "筋組織": "نسيج عضلي (نسيج حيواني يتكون بشكل رئيسي من خلايا منقبضة)",
 "筋緊張": "توتر العضلات (التوترية الطبيعية للعضلات)\nمثال: الرياضة تحسن توتر العضلات / تأتر, تشنج عضلي (تقلصات عضلية طويلة بشكل غير طبيعي؛ استرخاء بطيء للعضلة بعد التقلص)",
 "筋緊張性ジストロフィー症": "حثل عضلي توتري (شكل حاد من الحثل العضلي يتميز بضعف عام وهزال عضلي يؤثر على الوجه والقدمين واليدين والرقبة؛ وصعوبة في الكلام وصعوبة في اليدين تمتد إلى الذراعين…)",
 "筋緊張性頭痛": "صداع توتري (صداع يقع في مؤخرة الرأس؛ عادة ما يكون ناتجاً عن توتر الجسم الناتج عن الإرهاق أو الضغط النفسي)",
 "筋緊張症": "تأتر, تشنج عضلي (تقلصات عضلية طويلة بشكل غير طبيعي؛ استرخاء بطيء للعضلة بعد التقلص)",
 "筋線維": "خلية عضلية, ليف عضلي (خلية متطاولة قابلة للانقباض تشكل عضلات الجسم)",
 "筋縄": "أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم) / أصل, سلالة (الاشتقاق الوراثي للفرد) / أجرة الكتابة, سعر السطر (معدل الدفع للمواد المكتوبة التي تقاس وفقاً لعدد الأسطر المقدمة) / عَدَد الأَسْطُر (عدد الأسطر في مادة مطبوعة)\nمثال: كل سلالته كانت محاربين",
 "筋繊維": "خلية عضلية, ليف عضلي (خلية متطاولة قابلة للانقباض تشكل عضلات الجسم)",
 "筋者": "يَاكُوزَا",
 "筋肉": "عَضَلَة / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "筋肉だるま": "مُتَصَلِّبُ العَضَلَات (ذُو عَضَلَاتٍ مُتَصَلِّبَةٍ نَتِيجَةَ الإِفْرَاطِ فِي التَّمَارِينِ)",
 "筋肉ダルマ": "مُتَصَلِّبُ العَضَلَات (ذُو عَضَلَاتٍ مُتَصَلِّبَةٍ نَتِيجَةَ الإِفْرَاطِ فِي التَّمَارِينِ)",
 "筋肉内": "داخل العضل (داخل العضلة)\nمثال: حقنة في العضل",
 "筋肉内注射": "حقن عضلي (حقنة في العضلة)",
 "筋肉弛緩剤": "مرخي عضلات (عقار يقلل من انقباض العضلات عن طريق منع انتقال النبضات العصبية أو عن طريق تقليل استثارة الصفيحة الانتهائية الحركية أو عن طريق إجراءات أخرى)",
 "筋肉注射": "حقن عضلي (حقنة في العضلة)",
 "筋肉痛": "ألم العضلات (ألم في عضلة أو مجموعة من العضلات)",
 "筋肉細胞": "خلية عضلية, ليف عضلي (خلية متطاولة قابلة للانقباض تشكل عضلات الجسم)",
 "筋肉線維": "خلية عضلية, ليف عضلي (خلية متطاولة قابلة للانقباض تشكل عضلات الجسم)",
 "筋肉繊維": "خلية عضلية, ليف عضلي (خلية متطاولة قابلة للانقباض تشكل عضلات الجسم)",
 "筋肉質": "عَضَلِيّ / مَالَ (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا) / اِسْتَنَدَ, اِتَّكَأَ\nمثال: أريد بعض المال.",
 "筋肉達磨": "مُتَصَلِّبُ العَضَلَات (ذُو عَضَلَاتٍ مُتَصَلِّبَةٍ نَتِيجَةَ الإِفْرَاطِ فِي التَّمَارِينِ)",
 "筋肉隆々": "عَضَلِيّ",
 "筋腫": "ورم عضلي (ورم حميد يتكون من أنسجة عضلية)",
 "筋膜": "لوحة القيادة (لوحة العدادات في السيارة أو الطائرة تحتوي على أقراص وأدوات تحكم) / لفافة (صفيحة أو شريط من النسيج الضام الليفي يفصل أو يربط العضلات والأعضاء معاً)",
 "筋萎縮": "ضمور عضلي (هزال تدريجي للأنسجة العضلية)",
 "筋萎縮性側索硬化症": "التَّصَلُّب الضُّمُورِي الْجَانِبِي",
 "筋萎縮症": "ضمور عضلي (هزال تدريجي للأنسجة العضلية)",
 "筋覚": "إحساس حركي, حاسة العضلات (القدرة على الشعور بحركات الأطراف والجسم)",
 "筋道": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / طَرِيقَة, مِنْهَج",
 "筋道の通った": "مُتَّسِقٌ ذَاتِيًّا (لَا يُنَاقِضُ نَفْسَهُ)",
 "筋違い": "تَشَنُّج, شَدٌّ عَضَلِيّ / سَخَافَة / مُبَعْثَر, مُشَوَّش (يفتقر إلى الاستمرارية المنظمة) / غير منطقي (يفتقر إلى العلاقة المنطقية الصحيحة) / فِي غَيْر مَوْضِعِه (ضائِع مُؤَقَّتًا؛ وُضِع في مَكان غَيْر مُعْتاد) / فِي غَيْر مَوْضِعِه (موضوع في المكان أو الموضع الخاطئ) / مَائِل, قُطْرِيّ",
 "筋金入り": "رَاسِخ, صَامِد (ثَابِتٌ وَمَوْثُوقٌ خَاصَّةً فِي الوَلَاءِ)",
 "筋雲": "سحاب رقيق, سمحاق (سحابة بيضاء رقيقة (عادة من بلورات جليدية دقيقة) على ارتفاع عالٍ (4 إلى 8 أميال))",
 "筋電図": "تخطيط العضلات, مخطط كهربية العضل (سجل بياني للتيارات الكهربائية المرتبطة بتقلصات العضلات)",
 "筋電図検査": "تخطيط كهربائية العضل (تشخيص الاضطرابات العصبية العضلية باستخدام جهاز تخطيط كهربائية العضل)",
 "筋電計": "جهاز تخطيط كهربائية العضل (أداة طبية تسجل الموجات الكهربائية المرتبطة بنشاط العضلات الهيكلية)",
 "筋骨": "بنية, قوام (تكوين الجسم البشري) / جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان / غُضْرُوف (مادة قاسية مرنة تُكوِّن هياكل أو أجزاء من هياكل الفقاريات. تُشكل غالبية هياكل الأجنة في معظم الفقاريات…)",
 "筋骨型": "بنية رياضية, عضلية البنية (عضلي وعريض العظام)",
 "筋骨隆々": "عَضَلِيّ",
 "筋骨隆隆": "عَضَلِيّ",
 "筍": "برعم الخيزران (براعم الخيزران الصغيرة الصالحة للأكل)",
 "筏": "طَوْف / رَمَث (رَمَّثَ على كذا: زاد؛ يقال: رَمَّثَ على الخمسين، ورَمَّثَتْ غَنَمُهُ على المئةِ) / قَارِب مَطَّاطِيّ (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير",
 "筏乗り": "طواف, قائد طوف (رجل يسافر بواسطة الطوف)",
 "筏師": "طواف, قائد طوف (رجل يسافر بواسطة الطوف)",
 "筐体": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / عُلْبَة / حَالَات / دَعْوَى (إدِّعَاء؛ دُعَاء) / عُلَب\nمثال: سأرفع عليك قضية.",
 "筑摩薄荷": "قَطْرَمْ",
 "筑波大学電子図書館": "لَعْلَع / تُولِيب",
 "筒": "أُنْبُوبَة / سبطانة, ماسورة البندقية (أنبوب تمر من خلاله الرصاصة عند إطلاق النار من السلاح) / مُسَدَّس, طَبَنْجَة (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ) / مِدْفَع (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)\nمثال: كان عند زيري مسدس.",
 "筒元": "مَصْرَفِيّ, بَنْكِيّ / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "筒先": "بزبوز, فوهة (فوهة بارزة يتم تصريف السائل منها) / أنف, منقار (مصطلحات غير رسمية للأنف)",
 "筒型": "أُنْبُوبِيّ (يشكّل أنبوبًا أو يحتوي على أنابيب مجوّفة لمرور السوائل)",
 "筒形": "أُنْبُوبِيّ (يشكّل أنبوبًا أو يحتوي على أنابيب مجوّفة لمرور السوائل)",
 "筒状": "أُسْطُوَانِيّ (ذو شكل الأسطوانة)",
 "筒親": "مَصْرَفِيّ, بَنْكِيّ",
 "答": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: اليوم هناك برد.",
 "答え": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: اليوم هناك برد. / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ) / إِجَابَة, جَوَاب\nمثال: أجاب ياني فورا.",
 "答える": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: اليوم هناك برد.",
 "答ふ": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: اليوم هناك برد.",
 "答弁": "استجابة, رد فعل (عملية جسدية تحدث نتيجة تأثير منبه أو عامل سابق) / استجابة (الطريقة التي يستجيب بها جهاز كهربائي أو ميكانيكي لإشارة دخل أو نطاق من إشارات الدخل) / استجابة (عبارة يتلوها أو يغنيها المصلون بعد آية من الكاهن أو القس) / اسْتِقْبَال, تَلَقِّي (الطريقة التي يتم بها استقبال شخص أو شيء ما)\nمثال: رد فعل سيء للدواء",
 "答弁書": "أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ) / إِجَابَة, جَوَاب\nمثال: أجاب ياني فورا.",
 "答弁者": "رَادّ, مُجِيب (يقوم بالرد أو الإجابة) / مجيب (شخص يستجيب) / المدعى عليه (المتهم المشارك (خاصة في إجراءات الطلاق) المتهم بالزنا مع الشريك في الزنا)",
 "答案": "ورقة امتحان (امتحان تحريري) / رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: اليوم هناك برد.",
 "答案用紙": "ورقة امتحان (امتحان تحريري)",
 "答申": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "答申書": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "答辯": "استجابة, رد فعل (عملية جسدية تحدث نتيجة تأثير منبه أو عامل سابق) / استجابة (الطريقة التي يستجيب بها جهاز كهربائي أو ميكانيكي لإشارة دخل أو نطاق من إشارات الدخل) / استجابة (عبارة يتلوها أو يغنيها المصلون بعد آية من الكاهن أو القس) / اسْتِقْبَال, تَلَقِّي (الطريقة التي يتم بها استقبال شخص أو شيء ما)\nمثال: رد فعل سيء للدواء",
 "策": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "策励": "استعجال, حث (فعل الدعم أو التشجيع بجدية) / إلحاح (طلب وتوسل بإصرار) / تحفيز, حث (لفظ يشجعك على محاولة شيء ما)\nمثال: لم يترك لي إلحاحه بديلاً سوى الموافقة",
 "策動": "مُنَاوَرَة, تَدْرِيب عَسْكَرِيّ",
 "策士": "تكتيكي (شخص ماهر في تخطيط التكتيكات)",
 "策定": "تصوّر, صياغة مفاهيمية (ابتكار أو تدبير فكرة أو تفسير وصياغته ذهنيًا) / تعبير, صياغة (أسلوب التعبير عن النفس) / تركيبة, مستحضر (مادة محضرة وفقاً لصيغة محددة)\nمثال: وصف الطبيب مستحضراً تجارياً للدواء",
 "策応": "تَوَاطُؤ",
 "策戦": "تَكْتِيك (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك برلماني أو سياسي) / تَكْتِيك, تَخْطِيط (فن وضع خطط حربية؛ وسائل وخطط وطرق تنفيذية تتخد للنجاح في أمر ما. مثال: تكتيك برلماني أو سياسي) / عملية, عملية عسكرية (نشاط تقوم به قوة عسكرية أو بحرية (كمناورة أو حملة))\nمثال: كانت عملية مشتركة بين القوات البحرية والجوية",
 "策略": "حيلة, مناورة (مناورة في لعبة أو محادثة) / حيلة, خديعة (مخطط مفصل أو خادع تم تدبيره للخداع أو التهرب)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "策略家": "تكتيكي (شخص ماهر في تخطيط التكتيكات)",
 "策謀": "إِسْتْرَاتِيجِيَّة (الإستراتيجية فن وعلم وضع خُطط الحرب وإدارة العمليَّات الحربيَّة: إستراتيجيَّة القوَّات المسلَّحة؛ خُطَّة شاملة في أي مجال من المجالات: وضعت الحكومة إستراتيجيَّة مستقبليَّة للنهوض بالاقتصاد القوميّ)\nمثال: ستحمي روسيا مصالحها الإستراتيجية كما تفعل الولايات المتحدة.",
 "筝": "كوتو (آلة وترية يابانية تشبه الزيثير؛ لها لوحة صوت خشبية مستطيلة وعادة 13 وتراً حريرياً يتم نقرها بالأصابع) / آلة وترية (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "筧": "أنبوب, قناة (ممر (أنبوب أو نفق) يمكن أن تمر عبره المياه أو الأسلاك الكهربائية)\nمثال: تم توصيل الحواسيب من خلال نظام من القنوات",
 "筬": "قَصَبَة, بُوصَة",
 "筬打ち": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "筬通し": "انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة)) / تأثير ملحوظ, نقص (عاقبة ملحوظة (خاصة التقليل)) / حز, خدش (انخفاض مخدوش أو محفور في سطح)\nمثال: أحدث نقصاً في حسابي المصرفي",
 "筵": "مَقْعَد, مَقْعَدَة (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "箆": "مِلْعَقَةُ الصَيْدَلِيِّ, محراك (أداة للأكل والاحتساء والطبخ وتقديم الطعام) / قصبة الريشة (العمود الفقري المجوف للريشة) / عمود دوار, عمود نقل الحركة (قضيب دوار ينقل الطاقة أو الحركة) / سارية, عمود (قضيب أو عمود طويل (خاصة مقبض أداة أو جسم سلاح مثل الرمح أو السهم)) / بئر, عمود (ممر رأسي طويل محفور في الأرض، كما لمنجم أو نفق)",
 "箆鷺": "أبو ملعقة الشائع (أبو ملعقة أبيض نقي ذو عرف من جنوب أوراسيا وشمال شرق أفريقيا)",
 "箇々": "فَرْد, شَخْص",
 "箇所": "مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس",
 "箇条": "بَنْد",
 "箇条書": "إدراج, سرد (فعل عمل قائمة بالعناصر)",
 "箇条書き": "إدراج, سرد (فعل عمل قائمة بالعناصر)",
 "箇箇": "فَرْد, شَخْص",
 "箋": "اِنْزَلَقَ / زَقِيطَة",
 "箍": "طَارَة (في و: هو اسم آخر للمِقْوَد، وخصوصاً مقوَد السَيَّارَة؛ في و: الشخص الماهر في قيادة السيارات) / تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "箍を嵌める": "طَارَة (في و: هو اسم آخر للمِقْوَد، وخصوصاً مقوَد السَيَّارَة؛ في و: الشخص الماهر في قيادة السيارات)",
 "箏": "كوتو (آلة وترية يابانية تشبه الزيثير؛ لها لوحة صوت خشبية مستطيلة وعادة 13 وتراً حريرياً يتم نقرها بالأصابع) / آلة وترية (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "箏の琴": "كوتو (آلة وترية يابانية تشبه الزيثير؛ لها لوحة صوت خشبية مستطيلة وعادة 13 وتراً حريرياً يتم نقرها بالأصابع)",
 "箏曲家": "عازف كوتو (موسيقي يعزف على الكوتو (آلة يابانية))",
 "箒": "مِكْنَسَة, مِقْشَة",
 "箒星": "مُذَنَّب",
 "箒木": "سرو صيفي, شجيرة النار (نبات أوراسي كثيف التفرع؛ تتحول أوراقه إلى اللون الأحمر الأرجواني في الخريف) / ديكتامنيوس, شجيرة محترقة (عشب معمر أوراسي بأزهار بيضاء تبعث بخاراً قابلاً للاشتعال في الطقس الحار) / شجيرة محترقة, غدب أرجواني (شجيرة نفضية لها كبسولات أرجوانية تحيط ببذور قرمزية) / العليقة المشتعلة ((العهد القديم) الشجيرة التي اشتعلت دون أن تحترق والتي كلم الله موسى منها)",
 "箒茸": "وَرْدِيُّ الطَّرَف ((لِلوَرَقَةِ) ذَاتُ طَرَفٍ وَرْدِيِّ اللَّوْن)",
 "箒草": "سرو صيفي, شجيرة النار (نبات أوراسي كثيف التفرع؛ تتحول أوراقه إلى اللون الأحمر الأرجواني في الخريف) / ديكتامنيوس, شجيرة محترقة (عشب معمر أوراسي بأزهار بيضاء تبعث بخاراً قابلاً للاشتعال في الطقس الحار) / شجيرة محترقة, غدب أرجواني (شجيرة نفضية لها كبسولات أرجوانية تحيط ببذور قرمزية) / العليقة المشتعلة ((العهد القديم) الشجيرة التي اشتعلت دون أن تحترق والتي كلم الله موسى منها)",
 "箒虫": "دودة حدوية (حيوان خنثوي يشبه الدودة يعيش في طين قاع البحر)",
 "箔": "فَشَّلَ, أحبط (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل)\nمثال: فشل ياني مجددا. / سُمْعَة / كَرَامَة (الكرامة هي حق الفرد في أن يكون له قيمة وأن يُحترم لذاته، وأن يُعامل بطريقة أخلاقية) / اِعْتِبَار (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به)\nمثال: لا يعرض أي إنسان للتعذيب ولا للعقوبات أو المعاملات القاسية أو الوحشية أو الحاطة بالكرامة.",
 "箕": "ذَرَّى, نَسَفَ (ذَرَتِ الريحُ التُّرابَ: فَرَّقَتْهُ وَأَطَارَتْهُ؛ ذَرَى القمحَ: نَقَّاهُ فِي الرِّيحِ) / ذَرَّايَة, مِذْرَاة",
 "算": "إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي)\nمثال: استمر العد لعدة ساعات",
 "算を置く": "حَسَبَ (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "算体": "عُرْضَة, شَيْء / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَفْعُول بِهِ, مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به) / كَائِن\nمثال: لقد أخطأ الهدف.",
 "算入": "شَامِل",
 "算出": "حَسْب, مُحَاسَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "算定": "حَسْب, مُحَاسَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "算数": "حساب, العدّ (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت. / حَسْب, مُحَاسَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "算数障害": "عسر الحساب (ضعف القدرة على تعلم الرياضيات المناسبة للصف الدراسي)",
 "算木": "عصا التكهن, عصا الكشف عن المياه (عصا متشعبة يُزعم أنها تنحني لأسفل للإشارة إلى وجود مياه جوفية أو نفط)",
 "算段": "إسهاب, بلورة (التطوير بتفاصيل معقدة ومضنية) / أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "算法": "حساب, العدّ (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "算法言語": "لغة خوارزمية (لغة مصطنعة مصممة للتعبير عن الخوارزميات)",
 "算用": "تحسيب",
 "算用数字": "رَقْم عَرَبِيّ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: سجلت رقم هاتفه.",
 "算盤": "مِعَد, مِعْدَاد / نَاصِيَة (منبت شعر الغرّة الذي يقع فوق الجبهة مباشرة؛ عن شعر الغرّة) / حَسْب, مُحَاسَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "算盤が合う": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "算盤ずく": "مُرْتَزِق, مُؤْجِر",
 "算盤づく": "مُرْتَزِق, مُؤْجِر",
 "算盤尽": "مُرْتَزِق, مُؤْجِر",
 "算盤尽く": "مُرْتَزِق, مُؤْجِر",
 "算盤高い": "داهِيَة, مُتَآمِر (حاذِق في التَّدْبير والتَّخْطيط بِمَكْر وحِيلَة)",
 "算程": "عَمَلِيَّة / عِلْمِيَّة, مُعَالَجَة / جَهَّزَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ)\nمثال: جهز زيري حقائبه.",
 "算術": "حساب, العدّ (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "算術平均": "المتوسط الحسابي",
 "算術演算": "عملية حسابية (عملية رياضية تتضمن أرقاماً)",
 "算譜": "برنامج, برنامج حاسوبي ((علم الحاسوب) تسلسل من التعليمات التي يمكن للحاسوب تفسيرها وتنفيذها)\nمثال: تطلب البرنامج عدة مئات من سطور الكود",
 "箙": "جَعْبَة",
 "箚青": "وَشْم / وَشَمَ, وَشَّمَ",
 "箝げる": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل.",
 "箝する": "فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان. / صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "箝口": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ! / خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة",
 "箝口令": "أمر حظر النشر (أمر محكمة يقيد المعلومات أو التعليقات من قبل المشاركين في دعوى قضائية)\nمثال: فرض أمر حظر النشر على أعضاء الصحافة ينتهك التعديل الأول للدستور",
 "管": "أُنْبُوبَة / آلَةِ الْفَم (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة. / وِعَاء (الوِعَاءُ : الظَّرْفُ يوعَى فيه الشيءُ، ما يُجْمَعُ فيه الشّيءُ ويُحْفظ؛ الوِعَاءُ : إناء منزليّ يُصنع من الخزف أو المعدن أو الزُّجاج كوعاء الطَّبخ الذي له يد وغطاء أو وعاء دائريّ لتقديم الطَّعام أو إناء حفظ القهوة والشَّاي)\nمثال: وعاء السکر فارغ. / أُنْبُوبَة / بَكَرَة",
 "管きょ": "أُنْبُوبَة",
 "管する": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "管クラゲ": "سحاريات (مستعمرة محيطية عائمة أو سابحة من السلائل غالباً ما تكون شفافة أو زاهية الألوان)",
 "管制": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "管制塔": "بُرْج مُرَاقَبَة (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "管制官": "تحكم, وحدة تحكم (آلية تتحكم في تشغيل آلة) / محاسب, مراقب مالي (شخص يقوم بمسك وتدقيق الحسابات التجارية) / ضابط, متحكم (شخص يوجه ويضبط)\nمثال: وحدة التحكم في السرعة في مشغل الأسطوانات لم تكن تعمل بشكل صحيح",
 "管制室": "غرفة التحكم (غرفة تضم معدات التحكم (كما في استوديو التسجيل))",
 "管区": "قَضَاء / اِخْتِصَاص",
 "管弦楽団": "أُورْكِسْتْرَا",
 "管弦楽法": "توزيع أوركسترالي (فعل ترتيب قطعة موسيقية للأوركسترا وتعيين أجزاء للآلات الموسيقية المختلفة) / تنسيق, تنظيم دقيق (ترتيب للأحداث يحاول تحقيق أقصى قدر من التأثير) / أوركَستْرَة, توزيع للأوركسترا (توزيع لقطعة موسيقية للأداء بواسطة أوركسترا أو فرقة)\nمثال: التنسيق الماهر لحملته السياسية",
 "管掌": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "管束": "حزمة وعائية, ضفيرة وعائية (خيط وحدة من النظام الوعائي في سيقان وأوراق النباتات العليا يتكون أساسًا من الخشب واللحاء)",
 "管楽器": "آلَةِ الْفَم (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "管水母": "سحاريات (مستعمرة محيطية عائمة أو سابحة من السلائل غالباً ما تكون شفافة أو زاهية الألوان)",
 "管渠": "أُنْبُوبَة",
 "管状": "أُنْبُوبِيّ (يشكّل أنبوبًا أو يحتوي على أنابيب مجوّفة لمرور السوائل)",
 "管状骨": "عظم طويل (في أطراف الفقاريات: عظم أسطواني طويل يحتوي على نخاع)",
 "管狐": "قاقم (حيوان القاقم في معطفه الصيفي البني مع ذيل أسود الطرف)",
 "管球": "أنبوب إلكتروني, صمام مفرغ (جهاز إلكتروني يتكون من نظام من الأقطاب الكهربائية مرتبة في غلاف زجاجي أو معدني مفرغ)",
 "管理": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "管理システム": "نِظَامْ إِدَارَةْ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "管理上": "إداري (متعلق بالإدارة أو مسؤول عنها)",
 "管理人": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير. / أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات)",
 "管理体制": "نِظَامْ إِدَارَةْ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "管理価格": "سعر إداري, سعر مُدار (سعر تمليه أي هيئة غير قوى السوق)",
 "管理員": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "管理士": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "管理売春": "قِوَادَة",
 "管理官": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "管理権": "وكالة تنظيمية (وكالة حكومية تنظم الأعمال التجارية من أجل المصلحة العامة)",
 "管理機": "غَيْر آلِيّ, يَدَوِيّ التَّشْغِيل (يعمل باليد وبتشغيل يدوي)",
 "管理監督者": "مُشْرِف, مُشْرِفَة",
 "管理者": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير. / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "管理職": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "管理責任": "كَفَاءَة (مصدر؛ المماثلة والمساواة في القُوَّة والشَرَف، وقد يكون في المَال والعِلْم والثَقَافَة. لا جمع له؛ اسم؛ التقارب في القُوَّة والشَرَف. لا جمع له)\nمثال: ياني لديه الكفاءة لذلك.",
 "管理領域": "دكتور في الطب (درجة الدكتوراه في الطب) / طبيب (ممارس طبي مرخص) / مندليفيوم (عنصر مشع ما بعد اليورانيوم يتم تصنيعه بقصف الأينشتاينيوم بجسيمات ألفا)\nمثال: شعرت بسوء شديد فذهبت لرؤية طبيبي",
 "管籥": "زِرّ",
 "管継手": "تركيبات أنابيب, وصلة أنابيب (تجهيزة تتكون من قطع أنابيب مسننة لربط الأنابيب ببعضها)",
 "管腔": "لُومِن",
 "管財": "حراسة, وصاية (منصب الحارس أو الوصي)",
 "管財人": "عُضْو مَجْلِس أُمَناء, وَصِيّ (أعضاء في مجلس حاكم أو مجلس أمناء) / أمين, وصي قانوني (شخص (أو مؤسسة) يُعهد إليه بالملكية القانونية للممتلكات لاستخدامها لصالح شخص آخر)",
 "管足": "قدم أنبوبية (ناتئ أنبوبي ذو مجسات لمعظم شوكيات الجلد (نجم البحر وقنفذ البحر وخيار البحر) له ممص في النهاية ويستخدم مثلاً للحركة والتنفس)",
 "管路": "خَطّ أَنَابِيب (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "管轄": "قَضَاء / اِخْتِصَاص",
 "管鑰": "زِرّ",
 "管領": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "箪笥": "كُمُودِينُو, أَدْرَاجِيَّة",
 "箱": "صُنْدُوق, صَنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / شَمْشَاد / شَمْشِير / شَمْشَار / عَثَق / بُقْس / لَكْمَة, بُكس / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة)\nمثال: أين صندوق البريد؟ / سَيَّارَة, عَرَبِيَّة (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة. / شَامِيسِين / بِرَاز, سَلْح",
 "箱亀": "سلحفاة صندوقية (سلحفاة برية بشكل رئيسي من أمريكا الشمالية؛ يمكن إغلاق صدفتها بإحكام)",
 "箱企業": "شركة صورية, شركة وهمية (شركة مؤسسة ولكن ليس لديها أصول أو عمليات)",
 "箱入り": "فِي عُلْبَة, مُغَلَّف (محاط بغلاف أو علبة) / مُحَاط بِغِلَاف, مُغَلَّف (مُغطّى أو محميّ بغلاف أو ما يُشبهه) / ثَمِين",
 "箱型": "شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته)",
 "箱形": "شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته)",
 "箱河豚": "سمكة الصندوق (أي من الأسماك الاستوائية الصغيرة العديدة التي يكون جسمها ورأسها مغلفين بصفائح عظمية)",
 "箱物": "شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته)",
 "箱眼鏡": "ساعة مائية, كليبسيدرا (ساعة تقيس الوقت عن طريق تدفق الماء) / مقياس مستوى الماء (مقياس للإشارة إلى مستوى الماء في خزان أو مرجل أو مستودع) / كوب ماء (كوب لشرب الماء) / زجاج مائي, سيليكات الصوديوم (زجاج لزج يتكون من سيليكات الصوديوم في محلول؛ يستخدم كمادة لاصقة أو طلاء واقي وحفظ البيض)",
 "箱舟": "سَفِينَة, فُلْك (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "箱船": "سَفِينَة, فُلْك (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "箱詰": "مُلَاكَمَة",
 "箱詰め": "مُلَاكَمَة",
 "箱馬車": "شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته)",
 "箴": "تَحْذِير, إِنْذار / مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "箴言": "مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / اَلْأَمْثَال",
 "箶簏": "جَعْبَة",
 "箶籙": "جَعْبَة",
 "箸": "أَعْوَاد الْأَكْل, هَاشِي",
 "箸がすすむ": "مُشَهٍّ (يجذب أو يحفز الشهية خاصة في المظهر أو الرائحة)",
 "箸が進む": "مُشَهٍّ (يجذب أو يحفز الشهية خاصة في المظهر أو الرائحة)",
 "箸にも棒にもかからない": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "箸にも棒にも引っかからない": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "箸にも棒にも引っ掛からない": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "箸にも棒にも掛からない": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "箸を取る": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "箸休め": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له)",
 "節": "فُرْصَة, مُنَاسَبَة / مُنَاسَبَة (مؤنث مُنَاسَب؛ اسم مفعول من نَاسَبَ؛ التي نُوسِبَتْ أي اتُّخِذَتْ نَسِيبَة؛ الحَدَث الذي يكون مناسِبًا لفعل شيئا ما، غالبا ما يُقصد به حَدَثًا سعيدا وما يُراد فعله هو الاحتفال ويجوز استخدامها في الاحداث غير سعيدة)\nمثال: أرى مرآة مناسبة / قِسْم, جُزْء (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَقْطَع\nمثال: أنا أزين القسم. / جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع) / بَنْد\nمثال: يا لها من جملة! / مَوْسِم / مَوْسِم, جُزْء / مُشْتَرَك / مِفْصَل / لَحْن (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن. / عُقْدَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "節々": "مُشْتَرَك / مِفْصَل\nمثال: 体の節々が痛いです。 — مفاصلي تؤلمني. / مَفْصِل, مِفْتَاح",
 "節する": "أَنْقَذَ, أَنْجَى / اِدَّخَرَ / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "節介": "تدخل, تلاعب (فعل تغيير شيء ما سراً أو بشكل غير لائق) / فُضُولِيّ, مُتَدَخِّل (يتدخل في شؤون الآخرين بطريقة مزعجة)",
 "節付け": "مُؤَلَّف, مُصَنَّف",
 "節倹": "اِقْتِصَاد (بمعنى واصل عمل القصائد؛ بمعنى تَوَسَّط في الانفاق فلم يسرف ولم يقتر)\nمثال: ابني يدرس الاقتصاد.",
 "節制": "اِعْتِدَال (الوَسَطِيَّة، يقابله التَطَرُّف؛ التَنَاسُب وأن يكون الأمر عَدْلا، يقابله الاِنْقِلاب) / إِشْرَاف\nمثال: الاعتدال هو اليوم الذي يتساوى به الليل و النهار بنفس المدة.",
 "節回し": "لَحْن, أُغْنِيَّة (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن.",
 "節奏": "إِيقَاع",
 "節季払い": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "節度": "اِعْتِدَال (الوَسَطِيَّة، يقابله التَطَرُّف؛ التَنَاسُب وأن يكون الأمر عَدْلا، يقابله الاِنْقِلاب) / إِشْرَاف\nمثال: الاعتدال هو اليوم الذي يتساوى به الليل و النهار بنفس المدة.",
 "節慾": "امتناع, تعفف (فعل أو ممارسة الامتناع عن الانغماس في شهوة ما) / امتناع, عفة (سمة الامتناع (خاصة عن الكحول))",
 "節操": "أَمَانَة, نَزَاهَة / سَلَامَة",
 "節操がない": "عَدِيم المَبَادِئ (يفتقر إلى النزاهة أو المبادئ الأخلاقيَّة) / غير مبدئي, مجرد من المبادئ (يفتقر للمبادئ أو الوازع الأخلاقي)\nمثال: التحرر من الافتراء الفظ غير المبدئي",
 "節操が無い": "عَدِيم المَبَادِئ (يفتقر إلى النزاهة أو المبادئ الأخلاقيَّة) / غير مبدئي, مجرد من المبادئ (يفتقر للمبادئ أو الوازع الأخلاقي)\nمثال: التحرر من الافتراء الفظ غير المبدئي",
 "節果": "ثمرة قرنية مقسمة, خريدلة (قرون بذور متضيقة بين البذور وتتفكك عند النضج إلى شرائح أحادية البذرة)",
 "節欲": "امتناع, تعفف (فعل أو ممارسة الامتناع عن الانغماس في شهوة ما) / امتناع, عفة (سمة الامتناع (خاصة عن الكحول))",
 "節水": "حفظ المياه (الحفاظ على موارد المياه)",
 "節減": "تقشف, تقليص النفقات (تخفيض النفقات من أجل الاستقرار المالي) / تحصين داخلي (خندق يتكون من تحصين داخلي إضافي لإطالة أمد الدفاع)",
 "節点": "عُقْدَة / مُشْتَرَك / مِفْصَل",
 "節理": "مُشْتَرَك / مِفْصَل / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "節目": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه. / عُقْدَة / عَقَدَ (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "節税": "تجنب ضريبي (تقليل المسؤولية الضريبية إلى الحد الأدنى بطرق قانونية)",
 "節穴": "ثقب العقدة (ثقب في لوح خشبي حيث سقطت منه عقدة) / رؤية نفقية (ضعف بصري ينطوي على فقدان الرؤية المحيطية)",
 "節節": "مُشْتَرَك / مِفْصَل\nمثال: 体の節々が痛いです。 — مفاصلي تؤلمني. / مَفْصِل, مِفْتَاح",
 "節約": "خَصْم, حَسْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة) / مُدَخَرَات",
 "節約家": "مُخَلِّص, مُنْقِذ (شخص ينقذ شيئاً أو شخصاً من خطر أو عنف) / مُدَّخِر (شخص يدخر (وخاصة المال))",
 "節足動物": "مفصلي, مفصلي الأرجل (حيوان لا فقاري له أطراف مفصلية وجسم مقسم مع هيكل خارجي مصنوع من الكيتين)",
 "節酒": "تعديل, تلطيف (عملية التلطيف أو المزج المعتدل) / اعتدال, رصانة (الامتناع عن الإفراط) / اعتدال, عفة (سمة تجنب التجاوزات والإفراط)",
 "節間": "سُلَامِيَّة (جزء من ساق النبات يقع بين عقدتين)",
 "範": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون. / نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به) / مُنْحَدَر / مَيْل / مِثَال, مَثَل / مِثَال",
 "範例": "مِثَال, مَثَل / مِثَال",
 "範列": "نَمَط / نُمُوذَج, مِثَال / قِيَاس",
 "範囲": "اِتِّسَاع, مَدَّى",
 "範式": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به) / صِيغَة",
 "範疇": "فِئَة (هي الجماعة المُتَظَاهِرَة التي يرجع بعضها إلى بعض في التعاضد؛ هي الطائفة المقيمة وراء الجيش للاتجاء إليهم عند الهزيمة)\nمثال: سأقدم طلبي في إطار فئة أخرى.",
 "篇": "تأليف, تجميع (فعل التجميع (كما في كتاب واحد أو ملف أو قائمة)) / تجميع, مصنف (شيء تم تجميعه (كما في كتاب واحد أو ملف))\nمثال: استغرقت وظيفة تجميع المخزون عدة ساعات / حَجْم (حجّم الشّيء:وضع حجماً محدّداً له ، قَلَّلَ دوره وهَمَّشَه، قلّل تأثيره؛ حجّم: نَظَرَ نظراً شديداً،ويُقال حجّم إليه) / جَهَارَة / مُجَلَّد, جُزْء\nمثال: ما حجم البالون؟",
 "篇章": "مُؤَلَّف, مُصَنَّف",
 "築き上げる": "بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر والآجَر والخَرَسَانَة وغيرها؛ جعل الشيء يحدث خطوة بعد خطوة كأنه بناء وإن لم يكن شيئا ملموسا)\nمثال: بنى سامي منزلا. / خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "築く": "بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر والآجَر والخَرَسَانَة وغيرها؛ جعل الشيء يحدث خطوة بعد خطوة كأنه بناء وإن لم يكن شيئا ملموسا)\nمثال: بنى سامي منزلا. / وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "築城": "مَعْقِل (الملجأ والجبل المرتفع)\nمثال: رغم أن إيران مشهورة بأنها معقل الفكر الشيعي في عصرنا، إلا أن معظم أهلها كانوا من السنة حتى القرن الخامس عشر.",
 "築堤": "جسر ترابي, ساتر ترابي (كومة اصطناعية طويلة من الحجر أو التراب؛ تبنى لحجز المياه أو لدعم طريق أو للحماية)",
 "築庭": "تنسيق الحدائق (العمل كبستاني مناظر طبيعية)",
 "築港": "تَرْكِيبِيّ, مَصْنُوع (ليس من أصل طبيعي؛ أُعِدّ أو صُنِع صناعيًّا)",
 "築造": "بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "篗": "بَكَرَة",
 "篝": "مَجْمَرَة, مَنْقَل / مَشْعَل",
 "篝火": "مَشْعَل",
 "篠": "قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما) / دَقِيقَة, شَظِيَّة (قطعة صغيرة رفيعة وحادة من الخشب أو الزجاج أو المعدن)\nمثال: دخلت شظية في إصبعه",
 "篠を突く": "صَبَّ, سَكَبَ (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون)\nمثال: صب الشاي لضيفك.",
 "篠突く": "صَبَّ, سَكَبَ (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون)\nمثال: صب الشاي لضيفك.",
 "篠突く雨": "وَابِل, مَطَر غَزِير",
 "篠竹": "خَيْزَرَان, خَيْزُرَان",
 "篠笹": "خَيْزَرَان, خَيْزُرَان",
 "篤い": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر. / جِدِّيّ / جَدِّيّ, جَادّ",
 "篤と": "بِعِنَايَة",
 "篤信": "تبتل, تدين (التقوى بحكم كون الشخص متعبداً ومخلصاً دينياً)",
 "篤実": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "篤志": "مُنَظَّمَة خَيْرِيَّة / صَدَقَة / إِحْسَان / فَائِدَة",
 "篤志家": "سَخِيّ ((سَخِيَ) سَخاً: كَانَ جوادًا كَرِيمًا؛ (سَخِيَت) نَفسه عَن الشَّيْء: تركته)\nمثال: هو سخي بأمواله.",
 "篤行": "فَضِيلَة / عِفَّة, طَهَارَة",
 "篦": "مِلْعَقَةُ الصَيْدَلِيِّ, محراك (أداة للأكل والاحتساء والطبخ وتقديم الطعام) / قصبة الريشة (العمود الفقري المجوف للريشة) / عمود دوار, عمود نقل الحركة (قضيب دوار ينقل الطاقة أو الحركة) / سارية, عمود (قضيب أو عمود طويل (خاصة مقبض أداة أو جسم سلاح مثل الرمح أو السهم)) / بئر, عمود (ممر رأسي طويل محفور في الأرض، كما لمنجم أو نفق)",
 "篩": "غِرْبَال, مِصْفاة / صَفَّى, غَرْبَلَ / فحص تحري, فرز (اختبار الأشياء أو الأشخاص لتحديد أولئك الذين لديهم خصائص معينة) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / شبكة غربلة, قماش شبكي (قماش من شبكة معدنية أو بلاستيكية) / عرض, عرض سينمائي (عرض صورة متحركة (فيلم))\nمثال: أخفى الغطاء بنادقهم عن طائرات العدو",
 "篩い": "غِرْبَال, مِصْفاة / صَفَّى, غَرْبَلَ / فحص تحري, فرز (اختبار الأشياء أو الأشخاص لتحديد أولئك الذين لديهم خصائص معينة) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / شبكة غربلة, قماش شبكي (قماش من شبكة معدنية أو بلاستيكية) / عرض, عرض سينمائي (عرض صورة متحركة (فيلم))\nمثال: أخفى الغطاء بنادقهم عن طائرات العدو",
 "篩いにかける": "غِرْبَال, مِصْفاة / صَفَّى, غَرْبَلَ / حِجَاب, سِتَارَة (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "篩い分ける": "حِجَاب, سِتَارَة (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "篩う": "غِرْبَال, مِصْفاة / صَفَّى, غَرْبَلَ / اِخْتَارَ",
 "篩にかける": "غِرْبَال, مِصْفاة / صَفَّى, غَرْبَلَ / حِجَاب, سِتَارَة (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "篩に掛ける": "غِرْبَال, مِصْفاة / صَفَّى, غَرْبَلَ / حِجَاب, سِتَارَة (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "篩管": "أنبوب غربالي (أنبوب يتكون من خلايا متصلة من طرف لآخر تتدفق من خلالها العناصر الغذائية في النباتات الزهرية والطحالب البنية)",
 "篩部": "لحاء ((علم النبات) نسيج يوصل المواد الغذائية المصنعة (مثل من الأوراق) إلى الأجزاء التي تحتاج إليها؛ يتكون أساسًا من الأنابيب الغربالية)",
 "篩骨": "عظم غربالي (أحد عظام القحف الثمانية؛ عظم صغير مليء بجيوب هوائية يشكل جزءاً من محجر العين والتجويف الأنفي)",
 "篭": "سَلَّة / سِجْن (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن. / بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم",
 "篭もる": "مَسَكَ, مسك",
 "篭る": "مَسَكَ, مسك",
 "篭城": "حبس, حجز (فعل تقييد حرية شخص ما عن طريق حبسه) / تقييد, حصر (فعل إبقاء شيء ما ضمن حدود محددة) / احتجاز, حبس (حالة كونه محتجزاً) / طلق, مخاض (المرحلة الختامية للحمل؛ من بداية الانقباضات حتى ولادة الطفل)\nمثال: حصر العدوى في منطقة بؤرية",
 "篭手": "مشروب مقوي, منشط (مقوي أو منشط (خاصة مشروب كحولي)) / حامي الساعد, واقي الذراع (غطاء واقٍ للمعصم أو الذراع يستخدم في الرماية والمبارزة ورياضات أخرى) / عقاب الممر (شكل من أشكال العقاب يُجبر فيه الشخص على الركض بين صفين من الرجال يواجهون بعضهم البعض ومسلحين بهراوات أو سياط لضرب الضحية) / قفاز طويل (قفاز بكم طويل) / قفاز مدرع (قفاز من الجلد المدرع؛ يحمي اليد) / تحدي, قفاز التحدي (عرض أو قبول تحد)\nمثال: رمى قفاز التحدي / قُفَّاز, كَفّ",
 "篭絡": "تملق, مداهنة (فعل الحث عن طريق الملاطفة أو الإطراء)",
 "簀": "حَصِيرَة",
 "簀の子": "لوح تجفيف (لوح بجانب حوض المطبخ ومائل لتصريف المياه في الحوض)",
 "簀子": "لوح تجفيف (لوح بجانب حوض المطبخ ومائل لتصريف المياه في الحوض)",
 "簇": "جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع",
 "簇々": "جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع",
 "簇簇": "جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع",
 "簎": "رُمح ثلاثي الشعب (رمح ذو ثلاث شوكات أو أكثر؛ يستخدم لصيد الأسماك بالرمح (خاصة السلمون))",
 "簒位": "غَصْب",
 "簒奪": "غَصْب",
 "簒奪者": "غَاصِب, مُبْتَزّ",
 "簗": "هَدَّار (\"صَوْتٌ هَدَّارٌ\" : مُجَلْجِلٌ قَوِيٌّ؛ \"مَطَرٌ هَدَّارٌ\" : هَاطِلٌ بِقُوَّةٍ)",
 "簞笥": "كُمُودِينُو, أَدْرَاجِيَّة",
 "簡": "تَذْكِرَة / تذكرة / مُلْصَق, بِطَاقَة / لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب. / وَرَقَة لَعْب, وَرَقَة / بَسَاطَة / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "簡便": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "簡勁": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ)",
 "簡単": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق. / وَجِيز, قَصِير / وَجِيز, مُوجَز",
 "簡単に言えば": "بِاخْتِصَار",
 "簡抜": "اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "簡明": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ)",
