 "糊付け": "نَشَاء / أَلْصَقَ",
 "糊代": "تَفَاوُت مَسْمُوح, سَمَاحِيَّة (فرق مسموح به؛ السماح ببعض الحرية للحركة ضمن حدود) / انحراف جانبي ((لسفينة أو طائرة) انحراف جانبي)",
 "糊剤": "أَلْصَقَ",
 "糊口": "كَفَاف",
 "糊張り": "غِرَاء, لِزَاق / لَصَّقَ / نَشَاء",
 "糊着": "تَمَسَّكَ",
 "糊精": "ديكسترين (أي من السكريات المتعددة المختلفة التي يتم الحصول عليها عن طريق التحلل المائي للنشا؛ مادة صمغية عديمة الطعم والرائحة تُستخدم كعامل تكثيف وفي المواد…)",
 "糊貼り": "غِرَاء, لِزَاق / لَصَّقَ / نَشَاء",
 "糖": "سُكَّر (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام)\nمثال: حرمني من السكر.",
 "糖たんぱく質": "بروتين سكري (بروتين مقترن يحتوي على مكون كربوهيدراتي)",
 "糖タンパク質": "بروتين سكري (بروتين مقترن يحتوي على مكون كربوهيدراتي)",
 "糖乳": "حَلِيب مَكْثِف (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "糖原": "غليكوجين, نشا حيواني (أحد الأشكال التي يُخزن بها وقود الجسم؛ يُخزن بشكل أساسي في الكبد ويتحلل إلى جلوكوز عند حاجة الجسم)",
 "糖原質": "غليكوجين, نشا حيواني (أحد الأشكال التي يُخزن بها وقود الجسم؛ يُخزن بشكل أساسي في الكبد ويتحلل إلى جلوكوز عند حاجة الجسم)",
 "糖尿": "بيلة سكرية (وجود مستويات عالية بشكل غير طبيعي من السكر في البول)",
 "糖尿病": "سُكَّرِيّ, دِيَابِيطَا",
 "糖尿病性網膜症": "اعتلال الشبكية السكري (اعتلال شبكية ينطوي على تلف الأوعية الدموية الصغيرة في الشبكية؛ ينتج عن ارتفاع مستويات السكر في الدم بشكل مزمن لدى مرضى السكري غير المنضبط)",
 "糖尿病患者": "سُكَّرِيّ, مُصَاب بِالسُّكَّرِيّ (مصاب بداء السكّريّ) / سكري (من أو متعلق بداء السكري أو مسبب له) / مَرِيض سُكَّرِيّ (شخص مصاب بمرض السكري)",
 "糖尿病網膜症": "اعتلال الشبكية السكري (اعتلال شبكية ينطوي على تلف الأوعية الدموية الصغيرة في الشبكية؛ ينتج عن ارتفاع مستويات السكر في الدم بشكل مزمن لدى مرضى السكري غير المنضبط)",
 "糖菓": "حَلْوَيَات",
 "糖蛋白質": "بروتين سكري (بروتين مقترن يحتوي على مكون كربوهيدراتي)",
 "糖蜜": "دِبْس, عَسَل أَسْوَد (دبسه:ستره وواراه.1؛ الخف: رقعه.1) / شَرَاب, قَطْر",
 "糖衣構文": "التَّجْمِيل اللُّغَوِيّ",
 "糖衣錠": "مُسَكَّر, مُغَلَّف بِالسُّكَّر (مُغَطّى بطبقة من السكر أو الشراب المركز)",
 "糖質": "حلاوة السكر, سكرية (حلاوة السكر) / حلاوة, طعم حلو (تجربة التذوق عند ذوبان السكر في الفم) / فُصَام, الْفِصَام الذُّهَانِيّ",
 "糖質コルチコイド": "قشرانيات سكرية (هرمون ستيرويدي تنتجه قشرة الغدة الكظرية للحيوانات؛ يؤثر على عمل الغدد التناسلية وله نشاط مضاد للالتهابات)",
 "糖類": "سكريات, كربوهيدرات (مكون هيكلي أساسي للخلايا الحية ومصدر للطاقة للحيوانات؛ تشمل السكريات البسيطة ذات الجزيئات الصغيرة وكذلك المواد الجزيئية الكبيرة)",
 "糜汁": "كَيْمُوس",
 "糜爛": "مُوجِع, مُؤْلِم / سَعْفَة / فَسَاد",
 "糜爛剤": "كَاوٍ, مُنَفِّط (يسبّب ظهور البثور والنفطات على الجلد) / عامل مسبب للبثور, مادة منفطة (عامل كيميائي يسبب التقرحات أو البثور (خاصة غاز الخردل))",
 "糜爛性": "أَكَّال, كَاوٍ ((عَنْ مَادَّةٍ، خَاصَّةً حَمْضٍ قَوِيٍّ) قَادِرٌ عَلَى إِتْلَافِ المَوَادِّ أَوْ تَآكُلِهَا) / تَآكُلِيّ, حَاتّ (يُزِيلُ المَوَادَّ بِالِاحْتِكَاكِ التَّدْرِيجِيِّ)",
 "糜爛性ガス": "كَاوٍ, مُنَفِّط (يسبّب ظهور البثور والنفطات على الجلد) / عامل مسبب للبثور, مادة منفطة (عامل كيميائي يسبب التقرحات أو البثور (خاصة غاز الخردل))",
 "糜粥": "كَيْمُوس",
 "糞": "خَرَاء, خِرَاء / خَرِئَ / بَرَّزَ, تَغَوَّطَ (خَرَجَ؛ نَبُه بعد خُمول) / بُرَاز, كَاكَا / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / اللَّعْنَة / بِرَاز, سَلْح / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / فَظِيع / مُرْعِب / فَظِيع, أَرْبَد",
 "糞たわけ": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "糞ったれ": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما) / اللعين, جداً (أداة توكيد، عامية جداً وغير مهذبة) / مضاجعة, نكاح (مصطلحات عامية للجماع الجنسي)\nمثال: لماذا تأخرت وقتاً طويلاً؟",
 "糞ほど": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "糞まじめ": "جاف, جامد (يفتقر إلى الفكاهة)\nمثال: كانت غمزة خالية من الدعابة؛ غمزة تحذير",
 "糞まる": "طَرَدَ, نَفَى",
 "糞ガキ": "اِبْن كَلْب (الولد الذكر) / اِبْن الشَّرْمُوطَة (الولد الذكر) / اِبْن الْعَاهِرَة (الولد الذكر) / اِبْن زِنَا (الولد الذكر)\nمثال: هو له ابن صغير.",
 "糞スレ": "منشور تافه, منشور مسيء (منشور إنترنت ذو جودة رديئة ومثير للجدل)",
 "糞ババア": "عَجُوز",
 "糞ビッチ": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع) / قَحْبَة, سَلِيطَة",
 "糞マジメ": "جاف, جامد (يفتقر إلى الفكاهة)\nمثال: كانت غمزة خالية من الدعابة؛ غمزة تحذير",
 "糞便": "بِرَاز, سَلْح",
 "糞化石": "روث متحجر, كوبروليت (براز أحفوري؛ روث متحجر) / جوانو, ذرق الطيور (فضلات الطيور البحرية؛ تستخدم كسماد)",
 "糞味噌": "بشدة, بشكل بالغ (لدرجة شديدة أو خطيرة) / بشدة, بقسوة (مسبباً ضرراً كبيراً أو معاناة) / بِحَزْم, بِصَرَامَة (بصرامة؛ بطريقة شديدة)\nمثال: أصابع متجمدة بشدة لدرجة أنه كان لا بد من بترها",
 "糞嚢": "مَعِدَة, مِعْدَة / إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق. / كيس بقايا الطعام (كيس للطعام الذي لم يأكله الزبون في المطعم ليأخذه معه)",
 "糞垂れ": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "糞塊": "حَصَاة بَرَازِيَّة (كتلة صلبة من المواد البرازية)",
 "糞女": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع) / قَحْبَة, سَلِيطَة",
 "糞婆": "عَجُوز",
 "糞尿": "إفرازات, فضلات الجسم (نفايات (مثل البول أو العرق ولكن خاصة البراز) يتم تصريفها من الجسم)",
 "糞度胸": "تهور, طيش (سمة إيلاء القليل من التفكير للخطر)",
 "糞戯け": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "糞放る": "طَرَدَ, نَفَى",
 "糞爺": "شَيْخ, عَجُوز",
 "糞男": "زُب, زُبْر (في : اللحية أو مقدمها؛ في : الأنف)",
 "糞真面目": "جاف, جامد (يفتقر إلى الفكاهة)\nمثال: كانت غمزة خالية من الدعابة؛ غمزة تحذير",
 "糞石": "روث متحجر, كوبروليت (براز أحفوري؛ روث متحجر)",
 "糞程": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "糞腸": "مَعِدَة, مِعْدَة",
 "糞虫": "جَعْل الرَوْث, جِعْرَان (صَيَّرَ؛ أَنْشَأَ)\nمثال: جعل الأمور أسوء.",
 "糞蛙": "ضِفْدِع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضَفْدَع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضِفْدَع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضفدع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / بقرور\nمثال: الضفدع في البئر.",
 "糞蝿": "ذباب أخضر (ذباب ذو جسم أخضر نحاسي لامع)",
 "糞蠅": "ذباب أخضر (ذباب ذو جسم أخضر نحاسي لامع)",
 "糞袋": "مَعِدَة, مِعْدَة / إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق. / كيس بقايا الطعام (كيس للطعام الذي لم يأكله الزبون في المطعم ليأخذه معه)",
 "糞詰まり": "إِمْسَاك",
