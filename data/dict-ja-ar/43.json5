 "糞転がし": "جَعْل الرَوْث, جِعْرَان (صَيَّرَ؛ أَنْشَأَ)\nمثال: جعل الأمور أسوء.",
 "糞野郎": "اِبْن كَلْب (الولد الذكر) / اِبْن الشَّرْمُوطَة (الولد الذكر) / اِبْن الْعَاهِرَة (الولد الذكر) / اِبْن زِنَا (الولد الذكر)\nمثال: هو له ابن صغير.",
 "糞餓鬼": "اِبْن كَلْب (الولد الذكر) / اِبْن الشَّرْمُوطَة (الولد الذكر) / اِبْن الْعَاهِرَة (الولد الذكر) / اِبْن زِنَا (الولد الذكر)\nمثال: هو له ابن صغير.",
 "糟": "تُفْل / حُثالَة / ثفل الخمر, عكر (الرواسب الناتجة عن تخمير المشروبات الكحولية) / الْبَقَايَا / جُنْك",
 "糟糠": "تفاهة, شيء تافه (شيء قليل الأهمية) / أمر تافه, تفاهة (تفصيل يعتبر غير مهم) / ترافل (بودينغ بارد مصنوع من طبقات من الكعك الاسفنجي المدهون بالفاكهة أو الجيلي؛ وقد يُزين بالمكسرات أو الكريمة أو الشوكولاتة)",
 "糠に釘": "هدر الجهد (جهد لا طائل منه)",
 "糠喜び": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا)",
 "糠子": "هاموش (حشرة دقيقة ذات جناحين تمتص دماء الثدييات والطيور والحشرات الأخرى)",
 "糠蚊": "هاموش (حشرة دقيقة ذات جناحين تمتص دماء الثدييات والطيور والحشرات الأخرى)",
 "糠蝦": "روبيان الأبوسوم (قشريات تشبه الروبيان تحمل إناثها البيض والصغار في كيس بين الأرجل)",
 "糠蝿": "هاموش (حشرة دقيقة ذات جناحين تمتص دماء الثدييات والطيور والحشرات الأخرى) / نطاط النبات (قريب من نطاطات الأوراق وحشرات البصاق ولكنه نادراً ما يضر بالنباتات المزروعة)",
 "糠蠅": "هاموش (حشرة دقيقة ذات جناحين تمتص دماء الثدييات والطيور والحشرات الأخرى) / نطاط النبات (قريب من نطاطات الأوراق وحشرات البصاق ولكنه نادراً ما يضر بالنباتات المزروعة)",
 "糠雨": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "糧": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام. / تغذية (فعل التغذية) / طعام, غذاء (مصدر للمواد التي تغذي الجسم)\nمثال: أنقذت تغذيتها للأيتام العديد من الأرواح",
 "糧米": "أَرُزّ, رُزّ ((أَرَزَّت) الجرادةُ: رَزَّت)\nمثال: هكذا نطهي الأرز",
 "糧道": "خط إمداد, طريق إمداد (طريق يمكن من خلاله توصيل الإمدادات)",
 "糧食": "إمدادات غذائية, تموين (مخزون أو إمدادات من الأطعمة)",
 "糯": "موتْشِي",
 "糵す": "نَبْتَة",
 "糶り売買": "مَزَاد, مُزَايَدَة",
 "糶る": "تَنَافَسَ, تَبَارَى / عَرْض, عَطَاء (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "糶糴売買": "مَزَاد, مُزَايَدَة",
 "糸": "خَيْط, خيط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه) / خَيْط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه) / مَوْضُوع\nمثال: حل الصرة تلقى خيط.",
 "糸くず": "قماش للكشط, نسالة (قماش قطني أو كتاني ذو وبر مرتفع على جانب واحد؛ يستخدم لتضميد الجروح) / نسالة, وبر (نسائل دقيقة من ألياف القطن أو الكتان)",
 "糸とんぼ": "مقترنة الأجنحة, يعسوب صغير (حشرة نحيلة غير لاسعة تشبه اليعسوب ولكنها أصغر منه ولها أجنحة مطوية عند الراحة)",
 "糸のこ": "منشار أركت, منشار منحنيات (منشار آلي دقيق الأسنان بشفرة ضيقة؛ يستخدم لقطع الخطوط المنحنية)",
 "糸のこ盤": "منشار أركت, منشار منحنيات (منشار آلي دقيق الأسنان بشفرة ضيقة؛ يستخدم لقطع الخطوط المنحنية)",
 "糸まき": "بَكَرَة",
 "糸ようじ": "خَيْط أَسْنَان, خَيْط سِنِّيّ ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه)\nمثال: حل الصرة تلقى خيط.",
 "糸を垂れる": "سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / سَمَك, سمك (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك) / صَادَ\nمثال: سمكة ميناد ماتت",
 "糸を引く": "مَدَّدَ / اِمْتَدَّ",
 "糸を通す": "خَيْط, خيط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه) / خَيْط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه) / مَوْضُوع\nمثال: حل الصرة تلقى خيط.",
 "糸ノコ": "منشار أركت, منشار منحنيات (منشار آلي دقيق الأسنان بشفرة ضيقة؛ يستخدم لقطع الخطوط المنحنية)",
 "糸ノコ盤": "منشار أركت, منشار منحنيات (منشار آلي دقيق الأسنان بشفرة ضيقة؛ يستخدم لقطع الخطوط المنحنية)",
 "糸冬": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "糸切り歯": "ناب (واحدة من الأسنان المخروطية الأربعة المدببة (اثنتان في كل فك) تقع بين القواطع والضواحك)",
 "糸切歯": "ناب (واحدة من الأسنان المخروطية الأربعة المدببة (اثنتان في كل فك) تقع بين القواطع والضواحك)",
 "糸取り": "بكرة غزل الحرير (بكرة تستخدم في غزل الحرير إلى خيوط)",
 "糸口": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / خيط دليل, قرينة (دليل يساعد على حل مشكلة) / تلميح, دليل (إشارة طفيفة)",
 "糸屑": "قماش للكشط, نسالة (قماش قطني أو كتاني ذو وبر مرتفع على جانب واحد؛ يستخدم لتضميد الجروح) / نسالة, وبر (نسائل دقيقة من ألياف القطن أو الكتان)",
 "糸巻": "بَكَرَة",
 "糸巻き": "بَكَرَة",
 "糸引き": "بكرة غزل الحرير (بكرة تستخدم في غزل الحرير إلى خيوط) / حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ معلومةٍ كلَّ شهر؛ أعراض ما قبل الحيض (في ): أعراض تشمل انتفاخ البطن وألم الصدر والصداع والشعور بالتّعب وحدَّة الطبع والتهيّج العصبيّ والاكتئاب…)",
 "糸杉": "سَرْوَة, سَرْو",
 "糸枠": "بَكَرَة",
 "糸柳": "صفصاف بابلي, صفصاف باكي (صفصاف ذو فروع طويلة متدلية وأوراق رفيعة موطنه الصين؛ يزرع على نطاق واسع كنبات زينة)",
 "糸楊枝": "خَيْط أَسْنَان, خَيْط سِنِّيّ ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه)\nمثال: حل الصرة تلقى خيط.",
 "糸沙参": "جريس, جريس مستدير الأوراق (نبات معمر من نصف الكرة الشمالي ذو سيقان نحيلة وأزهار زرقاء على شكل جرس) / جريس, ياسنت الخشب (يصنف أحياناً في جنس سيلا)",
 "糸状": "خَيْطِيّ (رَقِيقُ القُطْرِ؛ يُشْبِهُ الخَيْط) / لَزِجٌ خَيْطِيّ (يُشَكِّلُ خُيُوطًا لَزِجَةً أَوْ غَرَوِيَّة)",
 "糸状体": "فتيل (سلك رفيع (عادة من التنجستن) يسخن حتى التوهج الأبيض بمرور تيار كهربائي) / خيط, خييط (بنية تشبه الخيط (كسلسلة من الخلايا تشبه السلسلة)) / خيط (ساق السداة) / خيط دقيق, لييفة (ليفة طبيعية أو اصطناعية رفيعة جداً)",
 "糸状虫": "فيلاريا (ديدان أسطوانية رفيعة تشبه الخيط تعيش في دم وأنسجة الفقاريات؛ تنتقل كيرقات عن طريق الحشرات اللادغة) / رقمة شوكرانية, منقار اللقلق أحمر الساق (عشب ضار أوروبي توطن في جنوب غرب الولايات المتحدة والمكسيك له سيقان منبطحة محمرة بأوراق صغيرة تشبه السرخس وزهور صغيرة خزامية حمراء عميقة تليها ثمار…)",
 "糸玉": "خيط دليل, قرينة (دليل يساعد على حل مشكلة) / كبة, كرة خيط (كرة من الغزل أو الحبل أو الخيط)",
 "糸球体": "كبيبة (مجموعة صغيرة متشابكة من الشعيرات الدموية في جسم ملبيغي؛ تقوم بتصفية الدم أثناء تكوين البول)",
 "糸球体嚢": "محفظة بومان, محفظة كبيبية (غشاء مزدوج رقيق يحيط بكبيبة النفرون)",
 "糸球体腎炎": "التهاب كبيبات الكلى (التهاب الكلية يتميز بالتهاب كبيبات الكلى)",
 "糸瓜": "لوف, ليفة (أي من عدة نباتات متسلقة حولية استوائية لها أزهار صفراء كبيرة وثمار صغيرة صالحة للأكل؛ تُزرع تجارياً للحصول على اللب الليفي المجفف للثمار الناضجة الذي…) / لِيف, لُوف",
 "糸竹": "آلَة مُوسِيقِيَّة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "糸繰り": "بَكَرَة",
 "糸繰り車": "عَجَلَة الْمِغْزَل",
 "糸繰車": "عَجَلَة الْمِغْزَل",
 "糸蘭": "عشب الدب (يوكا من جنوب الولايات المتحدة لها كتلة من الأوراق القاعدية التي تشبه العشب وساق مركزي بعنقود طرفي من الزهور البيضاء الصغيرة)",
 "糸蜻蛉": "مقترنة الأجنحة, يعسوب صغير (حشرة نحيلة غير لاسعة تشبه اليعسوب ولكنها أصغر منه ولها أجنحة مطوية عند الراحة)",
 "糸車": "عَجَلَة الْمِغْزَل",
 "糸鋸": "منشار أركت, منشار منحنيات (منشار آلي دقيق الأسنان بشفرة ضيقة؛ يستخدم لقطع الخطوط المنحنية)",
 "糸鋸盤": "منشار أركت, منشار منحنيات (منشار آلي دقيق الأسنان بشفرة ضيقة؛ يستخدم لقطع الخطوط المنحنية)",
 "糸雨": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "糸魚": "شائكة الظهر ثلاثية الأشواك (تعيش في الأنهار والمناطق الساحلية)",
 "糺す": "تَيَقَّنَ, تَثَبَّتَ",
 "糺問": "استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام) / بحث, تحقيق (بحث عن المعرفة) / استجواب, استفسار (حالة من السؤال أو الاستفسار)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته",
 "系": "نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق) / جِهَاز\nمثال: ليس بنظام كامل. / لازمة, نتيجة مباشرة ((منطق) استدلال يتبع مباشرة من إثبات اقتراح آخر) / لازمة, نتيجة طبيعية (عاقبة عملية تتبع بشكل طبيعي)\nمثال: الغيرة العمياء لازمة متكررة للحب العاطفي / سِلْسِلَة, مَجْمُوعَة / مُسَلْسَلَات تِلِفِزْيُونِيَّة, مُسَلْسِلَات / مُتَسَلْسِلَة, سِلْسِلَة / ـِيّ",
 "系列": "سِلْسِلَة, مَجْمُوعَة / مُسَلْسَلَات تِلِفِزْيُونِيَّة, مُسَلْسِلَات / مُتَسَلْسِلَة, سِلْسِلَة / تَابِعٌ, مُلْحَقٌ (مُنْضَمّ في ارتباط وثيق)",
 "系列的": "استبدالي, نسقي (مرتبط كأعضاء في فئة استبدال (في اللسانيات)) / نموذجي (من أو يتعلق بمثال نموذجي) / استبدالي, نموذجي (من أو يتعلق بالنموذج الصرفي النحوي)\nمثال: ارتباطات الكلمات النسقية (الاستبدالية)",
 "系図": "شَجَرَة النَّسَب (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "系図学": "علم الأنساب (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "系図買い": "سُور / سِيَاج",
 "系外惑星": "كَوْكَب خَارِج الْمَجْمُوعَة الشَّمْسِيَّة ((قديمًا) جرم سماوي من البلازما مضيئ بذاته متماسك بفعل الجاذبية؛ جرم سماوي يدور حول الشمس)\nمثال: كوكب الأرض جميل.",
 "系統": "نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق) / جِهَاز\nمثال: ليس بنظام كامل. / أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم) / أصل, سلالة (الاشتقاق الوراثي للفرد) / أجرة الكتابة, سعر السطر (معدل الدفع للمواد المكتوبة التي تقاس وفقاً لعدد الأسطر المقدمة) / عَدَد الأَسْطُر (عدد الأسطر في مادة مطبوعة)\nمثال: كل سلالته كانت محاربين / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / سُلَالَة",
 "系統だった": "مُمَنْهَج",
 "系統だてる": "نَظَّمَ (نَظَّمَه تَنْظِيمًا:أَلَّفَه وجَمَعَه فِي سِلْكٍ فانْتَظَمَ وتَنَظَّمَ ، وَمِنْه:نَظَمْتُ الشِّعْرَ ونَظَّمْتُه؛ نَظّم الأشياء :نظمها ،رتّبها،وضمّ بعضها إلى بعض في صورة منسّقة)\nمثال: نظم سامي كل شيء.",
 "系統分類学": "علم التصنيف (علم التصنيف المنهجي)",
 "系統学": "تطوري سلالي, فيلوجيني (من أو يتعلق بالتطور السلالي للكائنات الحية)\nمثال: تطور سلالي",
 "系統樹": "شَجَرَة النَّسَب (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "系統発生": "تطور, تطور عضوي ((علم الأحياء) تسلسل الأحداث المتضمنة في التطور التطوري لنوع أو مجموعة تصنيفية من الكائنات الحية)",
 "系統的": "مُمَنْهَج",
 "系統的脱感作": "إزالة التحسس, إزالة الحساسية المنهجية (تقنية تستخدم في العلاج السلوكي لعلاج الرهاب ومشاكل السلوك الأخرى التي تنطوي على القلق؛ يتعرض العميل للموقف المهدد تحت ظروف استرخاء حتى يتم إطفاء رد…)",
 "系統立った": "مُمَنْهَج",
 "系統立てる": "نَظَّمَ (نَظَّمَه تَنْظِيمًا:أَلَّفَه وجَمَعَه فِي سِلْكٍ فانْتَظَمَ وتَنَظَّمَ ، وَمِنْه:نَظَمْتُ الشِّعْرَ ونَظَّمْتُه؛ نَظّم الأشياء :نظمها ،رتّبها،وضمّ بعضها إلى بعض في صورة منسّقة)\nمثال: نظم سامي كل شيء.",
 "系統群": "زمرة, فَرْع حَيَوِي (مجموعة من الأصناف البيولوجية أو الأنواع التي تشترك في سمات موروثة من سلف مشترك)",
 "系譜": "علم الأنساب (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "系譜学": "علم الأنساب (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "糾す": "تَيَقَّنَ, تَثَبَّتَ",
 "糾合": "تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب.",
 "糾問": "استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام) / بحث, تحقيق (بحث عن المعرفة) / استجواب, استفسار (حالة من السؤال أو الاستفسار)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته",
 "糾弾": "لَامَ, اِسْتَنْكَرَ (لامَ يَلوم ، لُمْ ، لَوْمًا ، فهو لائم والجمع : لُوَّمٌ ، ولُيَّمٌ وهو أَيضاً لَوَّامٌ ، ولَوَّامةٌ ، ولْوَمةٌ وذاك مَلُومٌ ، ومَلِيمٌ…)\nمثال: لام سامي معلمه على فشله هو.",
 "紀": "نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / حِصَّةٌ / عَصْر (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: هذه هي نقطة ضعفه.",
 "紀伝": "سِيرَة, تَرْجَمَةُ ٱلْحَيَاةِ",
 "紀元": "حِقْبَة (مدة من الزمان تُقَدَّرُ بطولٍ غير محدد، وقد تكون قصيرة أو طويلة بحسب السياق؛ فترة تاريخية مميزة بسمات أو أحداث معينة)\nمثال: لقد بدأت حقبة جديدة في الجزائر. / الحقبة العامة, العصر الحالي (في الفترة المتزامنة مع العصر المسيحي؛ يفضل استخدامها بعض الكتاب غير المسيحيين) / سيريوم (عنصر فلزي رمادي قابل للسحب من سلسلة اللنثانيدات)\nمثال: في عام 200 من الحقبة العامة",
 "紀元前": "ق. م, قَبْلَ الْمِيلَاد",
 "紀元節": "24 مايو, يوم الكومنولث (بريطاني، ذكرى ميلاد الملكة فيكتوريا)",
 "紀年": "أيام, سنوات (الوقت الذي تستمر فيه حياة شخص ما) / أرذل العمر, شيخوخة (مرحلة متأخرة من الحياة) / دهر, سنوات (فترة زمنية طويلة)\nمثال: أيام الملك الأخيرة",
 "紀行": "فيلم سياحي, محاضرة عن الرحلات (فيلم أو محاضرة مصورة عن السفر)",
 "紀要": "بيان, موجز (تقرير موجز (خاصة بيان رسمي يصدر للنشر أو البث الفوري))",
 "約": "حَوَالَيْ, تَقْرِيبًا / وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها. / تقصير (عملية الإنقاص في الطول) / دهن المعجنات, سمن نباتي (دهن مثل الزبدة أو الشحم يُستخدم في المخبوزات)\nمثال: الفستان يحتاج إلى تقصير / انكماش, تقلص (عملية إنقاص (شيء ما) في الحجم أو الكثافة أو الكمية أو النطاق) / انقباض, تقلص عضلي ((فسيولوجيا) تقصير أو توتر جزء أو عضو (خاصة العضلة أو الألياف العضلية)) / إدغام, اختصار لفظي (كلمة تتكون من كلمتين أو أكثر عن طريق حذف أو دمج بعض الأصوات) / انضغاط, تقلص (عملية أو نتيجة أن يصبح الشيء أصغر أو مضغوطاً معاً)\nمثال: تقلص الغاز عند التبريد",
 "約する": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها. / قَصَّر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب. / قَلَّلَ",
 "約まる": "كِمادة (وسادة قماشية أو ضمادة (مع دواء أو بدونه) توضع بإحكام على جزء من الجسم (لتخفيف الانزعاج أو خفض الحرارة))",
 "約める": "قَصَّر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "約やか": "وَجِيز, مُوجَز / مُتَوَاضِع / وضع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / مُتْوَاضِع / مُحْتَشِم",
 "約分": "نَقْص",
 "約因": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "約定": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "約定済み": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها.",
 "約手": "سند إذني, كمبيالة (وعد بدفع مبلغ محدد عند الطلب أو في وقت معين)\nمثال: كان علي توقيع سنده في البنك ككفيل",
 "約数": "قَاسِم, مَقْسُوم عَلَيْهِ",
 "約束": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها. / مَوْعِد, مِيعَاد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد. / مُؤْتَمَر / مُعَاهَدَة, تَوَافُق (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / مُعَاهَدَة, مُقَاوَلَة (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / عُرْف (عَلِمَ؛ سَكَنَ إلى الشيءِ، أَنَسَهُ وأَلِفَه)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903. / قدر, مصير (حدث (أو مسار أحداث) سيحدث حتماً في المستقبل) / قضاء, قَدَر (القوة النهائية التي يُنظر إليها على أنها تحدد مسار الأحداث مسبقاً) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: نحن عاجزون أمام القدر",
 "約束ごと": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها. / مُؤْتَمَر / مُعَاهَدَة, تَوَافُق (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / مُعَاهَدَة, مُقَاوَلَة (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / عُرْف (عَلِمَ؛ سَكَنَ إلى الشيءِ، أَنَسَهُ وأَلِفَه)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "約束された": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها. / ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء.",
 "約束の地": "أَرْض الْمِيعَاد (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "約束やぶる": "مخالفة اللعب (خطأ عدم اتباع نفس نوع الورقة عند القدرة على ذلك)",
 "約束をやぶる": "مخالفة اللعب (خطأ عدم اتباع نفس نوع الورقة عند القدرة على ذلك)",
 "約束を破る": "مخالفة اللعب (خطأ عدم اتباع نفس نوع الورقة عند القدرة على ذلك)",
 "約束事": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها. / مُؤْتَمَر / مُعَاهَدَة, تَوَافُق (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / مُعَاهَدَة, مُقَاوَلَة (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة) / عُرْف (عَلِمَ؛ سَكَنَ إلى الشيءِ، أَنَسَهُ وأَلِفَه)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "約束手形": "سند إذني, كمبيالة (وعد بدفع مبلغ محدد عند الطلب أو في وقت معين)\nمثال: كان علي توقيع سنده في البنك ككفيل",
 "約束破る": "مخالفة اللعب (خطأ عدم اتباع نفس نوع الورقة عند القدرة على ذلك)",
 "約款": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "約言": "خُلَاصَة, مُلَخَّص",
 "約諾": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "約転": "انكماش, تقلص (عملية إنقاص (شيء ما) في الحجم أو الكثافة أو الكمية أو النطاق) / انقباض, تقلص عضلي ((فسيولوجيا) تقصير أو توتر جزء أو عضو (خاصة العضلة أو الألياف العضلية)) / إدغام, اختصار لفظي (كلمة تتكون من كلمتين أو أكثر عن طريق حذف أو دمج بعض الأصوات) / انضغاط, تقلص (عملية أو نتيجة أن يصبح الشيء أصغر أو مضغوطاً معاً)\nمثال: تقلص الغاز عند التبريد",
 "約音": "انكماش, تقلص (عملية إنقاص (شيء ما) في الحجم أو الكثافة أو الكمية أو النطاق) / انقباض, تقلص عضلي ((فسيولوجيا) تقصير أو توتر جزء أو عضو (خاصة العضلة أو الألياف العضلية)) / إدغام, اختصار لفظي (كلمة تتكون من كلمتين أو أكثر عن طريق حذف أو دمج بعض الأصوات) / انضغاط, تقلص (عملية أو نتيجة أن يصبح الشيء أصغر أو مضغوطاً معاً)\nمثال: تقلص الغاز عند التبريد",
 "紅": "قرمزي, ياقوتي (لون أحمر عميق وزاهٍ) / أحمر خدود (مكياج يتكون من مسحوق وردي أو أحمر يوضع على الخدين) / أَحْمَر, حُمْرَة (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا) / حَمْرَاء (مؤنث أَحْمَر؛ صفة لما كان لونها الحَمَار؛ ذوات الرايات الحمراء أو الحُمُر: عن المومسات) / أحمر (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا)\nمثال: أردت حذاء أحمر. / ضَوْء أَحْمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف. / خسارة, عجز (المبلغ الذي تتجاوز به تكلفة العمل إيراداته)\nمثال: عملت الشركة بخسارة العام الماضي / اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "紅い": "أَحْمَر, حُمْرَة (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا) / حَمْرَاء (مؤنث أَحْمَر؛ صفة لما كان لونها الحَمَار؛ ذوات الرايات الحمراء أو الحُمُر: عن المومسات) / أحمر (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا)\nمثال: أردت حذاء أحمر.",
 "紅いも": "يام أبيض, يام الماء (يزرع في أسترالاسيا وبولينيزيا لجذره الكبير ذو اللحم الأبيض الناعم الصالح للأكل)",
 "紅うちわ": "أنتوريوم, زهرة الفلامنغو (أي من النباتات الأمريكية الاستوائية المتنوعة التي تُزرع لأوراقها وأزهارها المبهرجة)",
 "紅はこべ": "أناغالس حقلي, زهرة الطقس (عشبة ذات أزهار قرمزية أو بيضاء أو أرجوانية تغلق عند اقتراب الطقس الممطر)",
 "紅冠鳥": "كارْدِينال, كَرْدِينَال / كَرْدِينَال",
 "紅団扇": "أنتوريوم, زهرة الفلامنغو (أي من النباتات الأمريكية الاستوائية المتنوعة التي تُزرع لأوراقها وأزهارها المبهرجة)",
 "紅土": "لاتريت (تربة حمراء ناتجة عن تحلل الصخور؛ تحتوي على رواسب غير قابلة للذوبان من أكاسيد الحديديك والألومنيوم)",
 "紅天狗茸": "أمانيت مسكاري, فطر الذباب (فطر غابات سام (ولكن نادراً ما يكون قاتلاً) له قبعة قرمزية مع ثآليل بيضاء وخياشيم بيضاء)",
 "紅差し指": "بِنْصِر",
 "紅斑": "حمامي (احمرار غير طبيعي في الجلد ناتج عن توسع الأوعية الدموية (كما في حروق الشمس أو الالتهاب))",
 "紅斑性狼瘡": "ذئبة حمامية (مرض كولاجين التهابي مزمن يصيب الأنسجة الضامة)",
 "紅旗": "راية حمراء, نذير خطر (شيء يثير الغضب أو يتطلب إجراءً فوريًا) / راية حمراء, علم أحمر (شعار الثورة الاشتراكية) / علم أحمر (علم يعمل كإشارة تحذير)\nمثال: القيام بذلك يشبه التلويح بخرقة حمراء أمام ثور",
 "紅榴石": "ألمندين (عقيق أحمر غامق يتكون من سيليكات الحديد والألمنيوم) / ألمندين (نوع أرجواني من ياقوت الإسبنيل)",
 "紅樹": "المنغروف",
 "紅毛": "غَرْبِيّ",
 "紅毛人": "غَرْبِيّ",
 "紅毛碧眼": "غَرْبِيّ",
 "紅海": "البَحْرُ الأَحْمَر, بَحْرُ القُلْزُم",
 "紅潮": "شطف (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن أن تعني إزالة ما علق بالشيء من أوساخ أو شوائب)",
 "紅灯": "ضَوْء أَحْمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "紅炎": "بروز, شهرة (الأهمية النسبية أو الشهرة) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / بروز, شهرة (حالة كونه بارزاً: معروفاً على نطاق واسع أو مرموقاً)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "紅焔": "بروز, شهرة (الأهمية النسبية أو الشهرة) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / بروز, شهرة (حالة كونه بارزاً: معروفاً على نطاق واسع أو مرموقاً)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "紅玉": "يَاقُوت",
 "紅玉髄": "عقيق أحمر, كارنيليان (نوع أحمر أو برتقالي نصف شفاف من الكالسيدوني)",
 "紅白粉": "مَاكْيَاج, بُنْيَة",
 "紅皮症": "احمرار الجلد (أي اضطراب جلدي ينطوي على احمرار غير طبيعي)",
 "紅紫": "أُرْجُوَانِيّ مُحْمَرّ (أرجواني مع مسحة حمراء)",
 "紅色": "أَحْمَر, حُمْرَة (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا) / حَمْرَاء (مؤنث أَحْمَر؛ صفة لما كان لونها الحَمَار؛ ذوات الرايات الحمراء أو الحُمُر: عن المومسات) / أحمر (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا)\nمثال: أردت حذاء أحمر.",
 "紅色植物": "طحالب حمراء (طحالب بحرية يحجب الكلوروفيل فيها صبغة حمراء أو أرجوانية؛ مصدر للأجار والكاراجينان)",
 "紅芋": "يام أبيض, يام الماء (يزرع في أسترالاسيا وبولينيزيا لجذره الكبير ذو اللحم الأبيض الناعم الصالح للأكل)",
 "紅花": "مُرِّيق, مُرَّيْق",
 "紅花油": "زيت العصفر (زيت مستخرج من بذور نبات العصفر) / زيت العصفر (زيت من بذور العصفر يُستخدم كغذاء وكذلك في الأدوية والدهانات)",
 "紅花隠元": "فاصولياء قرمزية (قرون فاصولياء طويلة تقطع عادةً؛ مفضلة في بريطانيا) / فاصولياء العداء القرمزي, فاصولياء قرمزية (فاصولياء استوائية أمريكية ذات زهور حمراء وفاصولياء سوداء مرقطة تشبه الفاصولياء الشائعة ولكنها معمرة؛ وهي فاصولياء مفضلة للأكل في بريطانيا العظمى)",
 "紅茶": "شَاي أَسْوَد (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة)\nمثال: صب الشاي لضيفك.",
 "紅茶道具一式": "طقم الشاي (مجموعة من الخزف أو الفضيات لتقديم الشاي)",
 "紅葉": "قَيْقَب / لَحْم الْأَيِّل (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "紅葉鳥": "أَيِّل",
 "紅藻": "طحالب حمراء (طحالب بحرية يحجب الكلوروفيل فيها صبغة حمراء أو أرجوانية؛ مصدر للأجار والكاراجينان)",
 "紅藻類": "طحالب حمراء (طحالب بحرية يحجب الكلوروفيل فيها صبغة حمراء أو أرجوانية؛ مصدر للأجار والكاراجينان)",
 "紅血": "دَم, دم (فِي وَ: سائل أحمر في جسم الكائنات الحية يقوم بنقل المواد الغذائية والأكسجين إلى الخلايا والفضلات وثاني أكسيد الكربون منها)\nمثال: تبرع توم بالدم.",
 "紅衛兵": "الحرس الأحمر (حركة سياسية راديكالية للشباب الصينيين الذين تبنوا المبادئ الماوية)",
 "紅褐色": "كَسْتَنَائِيّ دَاكِن, نَبِيذِيّ (بلون بني داكن إلى أحمر أرجواني)",
 "紅貝": "فَتِيّ, مِلْؤُه الحَيَوِيَّة (مَليء بِالقُوَّة والنَّشاط والحَيَوِيَّة الدَّمَوِيَّة) / كَامِلُ الدَّم, نَقِيُّ السُّلَالَة (من نسب غير مختلط؛ خالص الأصل)",
 "紅軍": "الْجَيْش الْأَحْمَر",
 "紅輪蒲公英": "حشيشة الغراب البرتقالية (حشيشة غراب أوروبية لها رؤوس زهرية بأشعة حمراء برتقالية زاهية؛ عشب ضار مزعج خاصة في شمال شرق أمريكا الشمالية؛ توضع أحياناً في جنس هيراسيوم)",
 "紅鉛鉱": "كروكوليت (معدن كرومات الرصاص النادر الذي يشكل بلورات برتقالية زاهية)",
 "紅鏡": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس.",
 "紅顔可憐": "مُتَوَرِّد, وَرْدِيّ الخَدَّيْن (ذو بَشَرَة مُتَوَرِّدَة تَدُلّ عَلى الصِّحَّة)",
 "紅鮭": "سلمون أحمر, سلمون سوكي (سلمون صغير ذو لحم أحمر؛ يوجد في الأنهار وروافد شمال المحيط الهادئ ويُقدر كطعام؛ يموت البالغون بعد وضع البيض) / سلمون أحمر (لحم أحمر دهني لسلمون ساحل المحيط الهادئ والأنهار)",
 "紅鱒": "سلمون أحمر, سلمون سوكي (سلمون صغير ذو لحم أحمر؛ يوجد في الأنهار وروافد شمال المحيط الهادئ ويُقدر كطعام؛ يموت البالغون بعد وضع البيض) / سلمون أحمر (لحم أحمر دهني لسلمون ساحل المحيط الهادئ والأنهار)",
 "紅鶴": "بَشْرُوش, نُحَام",
 "紆余": "تَعَرَّجَ",
 "紆余曲折": "تَعَرَّجَ",
 "紆曲": "تَعَرَّجَ",
 "紊乱": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب",
 "紋": "عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / عرف الخوذة ((شعارات النبالة) في العصور الوسطى، شعار يستخدم لتزيين الخوذة) / تحدب الطريق, ظهر الطريق (منتصف طريق محدب) / ذروة, قمة (الخط العلوي لتل أو جبل أو موجة) / نُمُوذَج, نَمَط",
 "紋々": "وَشْم / وَشَمَ, وَشَّمَ / نُمُوذَج, نَمَط",
 "紋切り型": "قَالَبِيّ, نَمَطِيّ (يَتَّسِمُ بِاتِّبَاعِ صِيغَةٍ أَوْ قَالَبٍ مُعَيَّن)",
 "紋切型": "قَالَبِيّ, نَمَطِيّ (يَتَّسِمُ بِاتِّبَاعِ صِيغَةٍ أَوْ قَالَبٍ مُعَيَّن)",
 "紋日": "عِيد / عُطْل, عُطْلَة (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام) / إِجَازَة, عُطْلَة\nمثال: ذهب سامي في عطلة.",
 "紋様": "نُمُوذَج, نَمَط",
 "紋標": "عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / عرف الخوذة ((شعارات النبالة) في العصور الوسطى، شعار يستخدم لتزيين الخوذة) / تحدب الطريق, ظهر الطريق (منتصف طريق محدب) / ذروة, قمة (الخط العلوي لتل أو جبل أو موجة)",
 "紋章": "عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / عرف الخوذة ((شعارات النبالة) في العصور الوسطى، شعار يستخدم لتزيين الخوذة) / تحدب الطريق, ظهر الطريق (منتصف طريق محدب) / ذروة, قمة (الخط العلوي لتل أو جبل أو موجة)",
 "紋章学": "عِلْم شِعَارات النَبَالَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "紋紋": "وَشْم / وَشَمَ, وَشَّمَ / نُمُوذَج, نَمَط",
 "納まらない": "غَيْرُ مُرْتَاح, قَلِق (مَشْغُول البَال وَغَيْر مُطْمَئِنّ) / غَيْرُ رَاضٍ, غَيْرُ مُشْبَع (لم يُشبَع أو لم يُلَبَّ له ما يطلب)",
 "納まり": "نَتِيجَة / رَصِيد",
 "納まる": "هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته. / اِحْتَلَّ (الموضعَ: نزل به وكان لغيره قبله؛ الجيشُ البلدَ: فتحها ثم نزل بها غصبا عن أهلها وبلا رضاهم، استولى عليها) / رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "納む": "كَرَّسَ, قَدَّمَ / توفر / زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تَوْرِيد, تَزْوِيد / ذَخِيرَة / خَزَنَ (حفظ، إدخر، أودع في مخزن) / فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "納め": "النِهاية",
 "納める": "وَضَعَ, حَطَّ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن. / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل. / اِحْتَفَظَ, أَبْقَى",
 "納付": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "納付者": "دَافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو وجدانيّ، ولا شعوريّ في حين أنّ الباعث عقليّ وشعوريّ)\nمثال: دافع عن الضعفاء.",
 "納付金": "مُسَاهَمَة (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة.",
 "納会": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "納入": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تَوْرِيد, تَزْوِيد / ذَخِيرَة",
