 "細流": "جدول صغير, ساقية (مجرى مائي صغير)",
 "細片": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "細目": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "細目に": "قَلِيلًا",
 "細石": "حَصَاة",
 "細管": "ماصة (أداة قياس تتكون من أنبوب زجاجي مدرج يستخدم لقياس أو نقل كميات دقيقة من السائل عن طريق سحب السائل إلى الأنبوب)",
 "細糸": "فتيل (سلك رفيع (عادة من التنجستن) يسخن حتى التوهج الأبيض بمرور تيار كهربائي) / خيط, خييط (بنية تشبه الخيط (كسلسلة من الخلايا تشبه السلسلة)) / خيط (ساق السداة) / خيط دقيق, لييفة (ليفة طبيعية أو اصطناعية رفيعة جداً)",
 "細糸期": "طور قلادي, لبتوتين (المرحلة الأولى من الطور التمهيدي للانقسام المنصف)",
 "細細": "بتفصيل دقيق, بدقة متناهية (بتفاصيل دقيقة)\nمثال: عجزنا عن رؤية كل شيء بدقة متناهية ووضوح يرجع فقط إلى ضعف حواسنا / فَقِير / مِسْكِين / فُقَرَاء",
 "細細しい": "دَقِيقَة, دِقيقة (وِحْدَة زَمَنِيَّة تساوي ستين ثَانِيَة، وجزءًا من ستّين جزءًا من السَّاعَة؛ في : وحدة لقياس خطوط الطول والعرض) / لَحْظَة / دَقِيقٌ, تَافِهٌ (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: استأذنت لدقيقة. / مُزْعِج / مُفَصَّل",
 "細細した": "مُخْتَلِف, مُتَنَوَّع",
 "細細とした": "مُخْتَلِف, مُتَنَوَّع",
 "細結び": "عقدة اليد, عقدة مربعة (عقدة مربعة تستخدم في حبل تقليص الشراع)",
 "細編み": "غرزة حشو, غرزة كروشيه مفردة (غرزة الكروشيه الأساسية)",
 "細緻": "دَقِيقَة, دِقيقة (وِحْدَة زَمَنِيَّة تساوي ستين ثَانِيَة، وجزءًا من ستّين جزءًا من السَّاعَة؛ في : وحدة لقياس خطوط الطول والعرض) / لَحْظَة / دَقِيقٌ, تَافِهٌ (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: استأذنت لدقيقة.",
 "細縄": "خَيْط, حَبْل ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه)\nمثال: حل الصرة تلقى خيط.",
 "細縞": "مُخَطَّط بِخُطُوط رَفِيعَة (ذو خطوط رفيعة جدًّا)",
 "細胞": "صَوْمَعَة, كِرْح / خَلِيَّة / خَلَوِيّ",
 "細胞内": "داخل الخلية (يقع أو يحدث داخل الخلية أو الخلايا)\nمثال: سائل داخل الخلية",
 "細胞内器官": "عضية (جزء متخصص من الخلية؛ يماثل العضو)\nمثال: أول عضية تم تحديدها كانت النواة",
 "細胞内小器官": "عضية (جزء متخصص من الخلية؛ يماثل العضو)\nمثال: أول عضية تم تحديدها كانت النواة",
 "細胞内液": "سائل داخل خلوي (سائل موجود داخل أغشية الخلايا (يحتوي عادة على مواد مذابة))",
 "細胞分裂": "انقسام الخلية, انقسام خلوي (العملية في التكاثر والنمو التي تنقسم بها الخلية لتكوين خلايا وليدة)",
 "細胞口": "فم خلوي (فم الحيوان الأولي)",
 "細胞器官": "عضية (جزء متخصص من الخلية؛ يماثل العضو)\nمثال: أول عضية تم تحديدها كانت النواة",
 "細胞壁": "جدار الخلية (طبقة صلبة من السكريات المتعددة تحيط بغشاء الخلايا النباتية وبدائية النواة؛ تحافظ على شكل الخلية وتعمل كحاجز وقائي)",
 "細胞外": "خارج الخلية (يقع أو يحدث خارج الخلية أو الخلايا)\nمثال: سائل خارج الخلية",
 "細胞外マトリックス": "إجراءات إلكترونية مضادة (حرب إلكترونية يتم القيام بها لمنع أو تقليل الاستخدام الفعال للعدو للطيف الكهرومغناطيسي)",
 "細胞外液": "سائل خارج خلوي (سائل يحتوي على بروتينات وإلكتروليتات بما في ذلك السائل في بلازما الدم والسائل الخلالي)\nمثال: يحتوي الجسم عادة على حوالي 15 لتراً من السائل خارج الخلوي",
 "細胞学": "علم الخلية (فرع علم الأحياء الذي يدرس بنية ووظيفة الخلايا)",
 "細胞小器官": "عضية (جزء متخصص من الخلية؛ يماثل العضو)\nمثال: أول عضية تم تحديدها كانت النواة",
 "細胞崩壊": "اِنْحِلَال خَلَوِيّ",
 "細胞性粘菌": "عفن غروي خلوي (يختلف عن العفن الغروي الحقيقي في كونه خلوياً وذو نواة طوال دورة حياته)",
 "細胞核": "نَوَاة",
 "細胞死": "تنكس حيوي, موت الخلية ((في علم وظائف الأعضاء) الانحلال الطبيعي وموت الخلايا الحية (كما في الخلايا الظهارية المختلفة))",
 "細胞毒": "ذيفان خلوي, سم خلوي (أي مادة لها تأثير سام على الخلايا)",
 "細胞状": "خَلَوِيّ",
 "細胞発生": "تكون الخلايا, نشوء الخلية (أصل وتطور واختلاف الخلايا)",
 "細胞膜": "الغشاء البلازمي",
 "細胞説": "نظرية الخلية ((أحياء) النظرية القائلة بأن الخلايا تشكل الوحدات الهيكلية والوظيفية الأساسية لجميع الكائنات الحية)",
 "細胞質": "سيتوبلازم, هيولى (بروتوبلازم الخلية باستثناء النواة؛ مليء بالبروتينات التي تتحكم في استقلاب الخلية)",
 "細胞質分裂": "انقسام السيتوبلازم, حركية خلوية (عملية عضوية تتكون من انقسام سيتوبلازم الخلية بعد انقسام النواة مما يؤدي إلى الانفصال لخليتين وليدتين)",
 "細胞遺伝学": "وراثة خلوية (فرع علم الأحياء الذي يدرس الجوانب الخلوية للوراثة (خاصة الكروموسومات))",
 "細胞間": "بين خلوي (يقع بين الخلايا)",
 "細胞間物質": "مادة خلالية, مصفوفة (مادة الجسم التي تنغمس فيها خلايا الأنسجة)",
 "細胞骨格": "هَيْكَل خَلَوِيّ",
 "細菌": "جُرْثُومَة",
 "細菌学": "علم البكتيريا (فرع العلوم الطبية الذي يدرس البكتيريا وعلاقتها بالمرض)",
 "細菌学者": "عالم بكتيريا (عالم أحياء يدرس البكتيريا)",
 "細菌性": "بكتيري, جرثومي (متعلق بالبكتيريا أو ناتج عنها)\nمثال: عدوى بكتيرية",
 "細菌性赤痢": "داء الشيغيلات, زحار عصوي (عدوى حادة في الأمعاء ببكتيريا الشيغيلا؛ تتميز بالإسهال والحمى وآلام البطن)",
 "細菌戦": "حرب بيولوجية, هجوم بيولوجي (استخدام البكتيريا أو الفيروسات أو السموم لتدمير البشر والحيوانات أو الغذاء)",
 "細菌毒素": "ذيفان بكتيري (أي ذيفان داخلي أو خارجي يتكون في الخلايا البكتيرية أو تفرزه)",
 "細菌類": "بكتيريا, جرثومة ((في علم الأحياء الدقيقة) كائنات وحيدة الخلية أو غير خلوية كروية أو حلزونية أو عصوية الشكل تفتقر إلى الكلوروفيل وتتكاثر بالانشطار؛ مهمة كمسببات…)",
 "細蟹": "عَنْكَبُوت, شَبَث",
 "細見": "تَدْقِيق",
 "細身": "ضَيِّق / نَحِيف, أَهْيَف",
 "細部": "تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية",
 "細隙": "قَطَعَ, شَطَبَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "細雨": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "細頸芥虫": "خنفساء قاذفة (خنفساء تطلق بخاراً لاذعاً بصوت مسموع عند إزعاجها)",
 "細魚": "سمك شائك الظهر (أسماك صغيرة (2-4 بوصات) عدوانية غالباً عديمة الحراشف وشائكة الظهر تعيش في المياه العذبة والساحلية الشمالية ولها طقوس تزاوج معقدة؛ موضوع لكثير من…)",
 "細麦": "زوان إنجليزي, زوان معمر (عشبة أوروبية معمرة تزرع على نطاق واسع للمراعي والتبن وكعشبة مروج)",
 "紳士": "اَلسَّيِّد, سَيِّد",
 "紳士協定": "اتفاق السادة, اتفاق شرف (اتفاق شخصي قائم على الشرف وغير ملزم قانوناً)",
 "紳士淑女": "سَيِّدَاتِي وَسَادَتِي",
 "紳士用装身具商人": "بائع ملابس رجالية, تاجر ملابس (تاجر يبيع الملابس الرجالية)",
 "紳士的": "نَبِيلُ السُّلُوكِ (يليق برجل حسن التربية)",
