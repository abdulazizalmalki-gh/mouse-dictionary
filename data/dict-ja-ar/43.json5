 "独居監房": "حَبْس اِنْفِرَادِيّ (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "独得": "تحفة, شيء نادر (شيء غير عادي - ربما يستحق الجمع)",
 "独我論": "وَحْدَة الْأَنَا",
 "独房": "حَبْس اِنْفِرَادِيّ (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "独房監禁": "حَبْس اِنْفِرَادِيّ (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "独断": "عَقِيدِيَّة, عَقَائِدِيَّة",
 "独断的": "عَقَائِدِي",
 "独断論": "عَقِيدِيَّة, عَقَائِدِيَّة",
 "独木舟": "بيروج, زورق محفور (كانو مصنوع عن طريق حفر وتشكيل جذع شجرة كبير)",
 "独楽": "دُوَّامَة, بُلْبُل",
 "独歩": "استقلالية, اعتماد على النفس (الاستقلال الشخصي) / فَرِيد, فَذّ",
 "独活の大木": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "独演": "منفرداً, وحده (دون أي شخص أو شيء آخر)\nمثال: بقي الطفل في المنزل وحده",
 "独特": "تحفة, شيء نادر (شيء غير عادي - ربما يستحق الجمع)",
 "独男": "خَاسِر",
 "独白": "مُونُولُوج, حَدِيث النَّفْس",
 "独眼": "أَعْوَر, عَوْرَاء",
 "独眼竜": "أَعْوَر, عَوْرَاء",
 "独眼龍": "أَعْوَر, عَوْرَاء",
 "独禁": "مُضَادّ لِلاحْتِكَار (عَنِ القَوَانِين وَالأَنْظِمَة؛ مُصَمَّم لِحِمَايَة التِّجَارَة مِنَ…)",
 "独禁法": "قانون مكافحة الاحتكار (قانون يهدف إلى تعزيز المنافسة الحرة في السوق عن طريق حظر الاحتكارات)",
 "独立": "اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع…)\nمثال: الصحراويون يريدون الاستقلال. / تَفْرِقَة",
 "独立の法則": "قانون التوزيع المستقل (ينفصل كل عضو من زوج الكروموسومات المتماثلة بشكل مستقل عن أعضاء الأزواج الأخرى…)",
 "独立国家共同体": "اِتِّحَاد اَلدُّوَل اَلْمُسْتَقِلَّة (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى…)\nمثال: عاش الاتحاد السوفيتي!",
 "独立型": "قَائِم بِذَاتِه, مُسْتَقِلّ (يقف منفردًا دون أن يكون مُثبَّتًا أو مسنودًا بشيء آخر)",
 "独立変数": "متغير تجريبي, متغير مستقل ((إحصاء) متغير تكون قيمه مستقلة عن التغيرات في قيم المتغيرات الأخرى)",
 "独立性": "اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع…)\nمثال: الصحراويون يريدون الاستقلال.",
 "独立機関": "وكالة مستقلة (وكالة تابعة لحكومة الولايات المتحدة يتم إنشاؤها بموجب قانون من الكونغرس وتكون…)",
 "独立独歩": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "独立独行": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "独立班": "فصل, فك الارتباط (عملية التحرير من مرفق أو اتصال)",
 "独立祭": "يَوْم الاِسْتِقْلَال, عِيد الاِسْتِقْلَال (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل…)\nمثال: طقس اليوم جميل.",
 "独立系": "مُسْتَقِل, حُرّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
 "独立記念日": "يَوْم الاِسْتِقْلَال, عِيد الاِسْتِقْلَال (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل…)\nمثال: طقس اليوم جميل.",
 "独自": "أَصْلِيّ / مُسْتَقِل, حُرّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
 "独自性": "أَصَالَة, ابْتِكَار (صفة كون الشيء جديداً وأصلياً (غير مشتق من شيء آخر))",
 "独自色": "تميز, فرادة (صفة كون الشيء فريداً من نوعه)\nمثال: ميزه ذلك التفرد عن جميع رفاقه",
 "独自開発": "ذي ملكية خاصة, مملوك (محمي بعلامة تجارية أو براءة اختراع أو حقوق نشر؛ مصنوع أو منتج أو موزع بواسطة من…)\nمثال: تايلينول هو دواء مملوك وشكله العام هو أسيتامينوفين",
 "独行": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "独裁": "دِكْتَاتُورِيَّة, دِيكْتَاتُورِيَّة"
}
