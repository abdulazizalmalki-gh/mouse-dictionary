 "火に油を注ぐ": "صَبَّ اَلزَّيْت عَلَى اَلنَّار, زَادَ اَلنَّار حَطَباً (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو…)\nمثال: صب الشاي لضيفك.",
 "火のないところに煙は立たない": "لَا دُخَانَ بِلَا نَار, أَيْنَمَا يُوجَدُ دُخَانٌ، تُوجَدُ نَار (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)",
 "火の手": "لَهَب, شُعْلَة / حَمْلَة",
 "火の気": "حَرَارَة (السخونة والحماوة؛ شدة العَطَش)\nمثال: حرارة الطقس تتزايد.",
 "火の玉": "كُرَة نَارِيَّة / سراب, وهم خادع (وهم يضلل)",
 "火の番": "النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً))",
 "火の粉": "شَرَارَة",
 "火の精": "سَمَنْدَل",
 "火の見": "برج مراقبة الحرائق (برج مراقبة حيث يتمركز حارس لمراقبة نشوب الحرائق)",
 "火の見やぐら": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "火の見櫓": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "火の車": "ضائقة شديدة, ظروف يائسة (حالة من الضيق الشديد)",
 "火の鳥": "فِينِيكْس, فُقْنُس",
 "火ばさみ": "ملقط فحم, ملقط نار (ملقط للإمساك بالفحم المشتعل)",
 "火ぶくれ": "بَطْبَاطَة, نَفْطَة",
 "火ぶたが切られる": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "火ぶたを切る": "نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "火をかける": "أَحَرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه)\nمثال: من أحرق الكيكة؟",
 "火をつける": "شَرَارَة",
 "火を付ける": "شَرَارَة",
 "火を吹く": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "火を噴く": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "火を掛ける": "أَحَرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه)\nمثال: من أحرق الكيكة؟",
 "火を点ける": "شَرَارَة",
 "火を通す": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ)\nمثال: زوجي طباخ ماهر.",
 "火中": "احتراق, حرق (عملية حرق شيء ما)\nمثال: حرق الأوراق كان ممنوعاً بموجب مرسوم المدينة",
 "火事": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "火事どろ": "سالب, ناهب (شخص يأخذ الغنائم أو الأسلاب (كما في الحرب))",
