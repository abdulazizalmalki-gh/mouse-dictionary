 "犬食い": "قِتَال الكِلَاب (قتال عنيف بين الكلاب (ينظم أحياناً بشكل غير قانوني للترفيه والمقامرة)) / اشتباك جوي, معركة جوية قريبة (اشتباك جوي بين الطائرات المقاتلة) / تَشَابُك بِالأَيْدِي, عِرَاك (قتال غير منظم) / صراع عنيف, قتال شرس (منافسة متنازع عليها بضراوة)\nمثال: ضغينة تعود لقتال سياسي شرس بينهما",
 "犬飼": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "犬養": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "犬鷲": "عُقَاب ذَهَبِيّ (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "犯": "جَرِيمَة, جِنَايَة / جَرِيمَة\nمثال: ハイジャック犯達は飛行機の後部に移った。 — تحركوا خاطفو الطائرة الى مؤخرة الطائرة .",
 "犯しがたい": "رزين, مهيب (يمتلك أو يعبر عن الكرامة؛ خاصة الرسمية أو الهيبة في السلوك أو المظهر) / مُعْتَزّ بِنَفْسِه, وَقُور (يمتلك أو يُظهِر تقديرًا واحترامًا للذات)\nمثال: سلوكها الوقور",
 "犯し難い": "رزين, مهيب (يمتلك أو يعبر عن الكرامة؛ خاصة الرسمية أو الهيبة في السلوك أو المظهر) / مُعْتَزّ بِنَفْسِه, وَقُور (يمتلك أو يُظهِر تقديرًا واحترامًا للذات)\nمثال: سلوكها الوقور",
 "犯す": "اِرْتَكَبَ\nمثال: ビルはその罪を犯していなかった。 — لم يرتكب بيل الجريمة. / اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "犯る": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "犯人": "جَانٍ ((جَانَ) جونا وجونة: اسود)",
 "犯則": "اِنْتِهَاك",
 "犯意": "حِقْد (حقد:أَمْسَكَ عَداوتَهُ فِي قَلْبهِ وتَرَبَّصَ لفُرْصَتِها؛ حقد على فلان:أَضْمَرَ له العداوة وتربّص فرصة الإيقاع به ، كَرِهَه وبَغِضَه)\nمثال: احس سامي بالحقد.",
 "犯歴": "سَجَّل اَلْجِنَائِيَّة (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "犯罪": "جَرِيمَة, جِنَايَة / جَرِيمَة",
 "犯罪グループ": "جَرِيمة مُنَظَّمة",
 "犯罪人": "جِنَائِيّ, إِجْرَامِيّ / مُجْرِم, مُجْرِمَة",
 "犯罪場所": "مَسْرَح جَرِيمَة",
 "犯罪学": "علم الجريمَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "犯罪学者": "عالم إجرام (متخصص في علم الجريمة)",
 "犯罪容疑者": "اِشْتَبَهَ بِ / مُشْتَبَه بِهِ, مَشْبُوه",
 "犯罪性": "إجرام (حالة كون الشخص مجرماً)",
 "犯罪歴": "سَجَّل اَلْجِنَائِيَّة (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "犯罪死": "موت خاطئ, وفاة غير مشروعة (وفاة ناتجة عن فعل خاطئ أو إهمال؛ وفاة يمكن أن تكون أساساً لدعوى مدنية للحصول على تعويضات نيابة عن عائلة المتوفى أو ورثته)",
 "犯罪率": "مُعَدَّل الجَرِيمَة (نسبة الجرائم في منطقة ما إلى سكان تلك المنطقة؛ يُعبر عنها لكل 1000 نسمة في السنة)",
 "犯罪発生率": "مُعَدَّل الجَرِيمَة (نسبة الجرائم في منطقة ما إلى سكان تلك المنطقة؛ يُعبر عنها لكل 1000 نسمة في السنة)",
 "犯罪的": "جِنَائِيّ, إِجْرَامِيّ / مُجْرِم, مُجْرِمَة",
 "犯罪組織": "عصابة, نقابة الجريمة (تحالف فضفاض من رجال العصابات المسؤولين عن الأنشطة الإجرامية المنظمة)",
 "犯罪者": "جِنَائِيّ, إِجْرَامِيّ / مُجْرِم, مُجْرِمَة",
 "犯罪記録": "سَجَّل اَلْجِنَائِيَّة (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "犯罪集団": "جَرِيمة مُنَظَّمة",
 "犯行": "جَرِيمَة, جِنَايَة / جَرِيمَة",
 "犯行現場": "مَسْرَح جَرِيمَة",
 "犰狳": "مُدَرَّع",
 "状": "صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "状態": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع.",
 "状態変化": "تحول الطور, تغير الطور (تغير من حالة (صلبة أو سائلة أو غازية) إلى أخرى دون تغيير في التركيب الكيميائي) / تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "状態遷移": "تحول الطور, تغير الطور (تغير من حالة (صلبة أو سائلة أو غازية) إلى أخرى دون تغيير في التركيب الكيميائي)",
 "状況": "حالة, ظرف (الحالة العامة للأشياء؛ مجموعة الظروف في وقت معين)\nمثال: الوضع الدولي الحالي خطير",
 "状況報告": "تقرير سير العمل, تقرير مرحلي (تقرير عن العمل المنجز خلال فترة زمنية محددة)",
 "状況証拠": "دليل ظرفي, قرينة (دليل يوفر فقط أساساً للاستنتاج حول الواقعة المتنازع عليها)",
 "状況説明": "إيجاز, تعليمات موجزة (تعليمات مفصلة، كما هو الحال لعملية عسكرية)",
 "状箱": "حافظة رسائل (حافظة لحمل الرسائل)",
 "状袋": "مُغَلَّف, لِفَافَة / غِلَاف",
 "犾守": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "狂": "مَهْوُوس, مَهْوُوسَة / شغف جنوني, هوس (دافع غير عقلاني ولكنه لا يُقاوم لمعتقد أو فعل ما) / اضطراب الهوس, هوس (اضطراب مزاجي؛ اضطراب وجداني يميل فيه المصاب إلى الاستجابة بشكل مفرط وعنيف أحياناً)",
 "狂い": "جُنُون / شذوذ, مخالفة (سلوك يخرق القاعدة أو الإتيكيت أو العرف أو الأخلاق) / اضْطِرَاب, شُذُوذ (عدم الاتصاف بمبدأ ثابت أو معدل ثابت؛ الحدوث على فترات غير منتظمة) / عدم انتظام, عدم انتظام هندسي (لا تناظر غير منتظم في الشكل؛ نمط مكاني غير منتظم) / إمساك (إخلاء الأمعاء بشكل غير منتظم وغير متكرر أو صعب؛ يمكن أن يكون عرضاً لانسداد معوي أو التهاب رتجي) / تَعَصُّب",
 "狂い咲き": "خارج الموسم, موسم الركود (الموسم الذي يكون فيه السفر أقل نشاطًا والأسعار أقل)",
 "狂い花": "خارج الموسم, موسم الركود (الموسم الذي يكون فيه السفر أقل نشاطًا والأسعار أقل)",
 "狂う": "خلل وظيفي, عطل (فشل في العمل بشكل طبيعي)",
 "狂おしい": "مَجْنُون",
 "狂った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "狂わせる": "مُسْتَاء, مُمْتَعِض / إخْلَال / أَسْخَطَ ((أأَسْخَطَه): أغضَبَهُ) / أَخَلَّ ((أَخَلَّ): رعت إبله الخلة؛ (أَخَلَّ) بالمكان وبمركزه وغيره: غاب عنه وتركه)",
 "狂乱": "حَنَق, غَيْظ ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / حَنِق, مُغْتَاظ ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق)",
 "狂人": "مَسْلُوبُ العَقْل, مَمْسُوسٌ بِالقَمَر (مجنون ويُعتَقد أنّ جنونه مرتبط بأطوار القمر) / طائش, متهور (شخص متهور مندفع غير مسؤول) / مَجْنُون, مُخْتَلّ عَقْلِيّاً (شخص فاقد للعقل)",
 "狂信": "تَعَصُّب",
 "狂信的": "مُتَعَصِّب / مُتَعَصِّب, غَيُور",
 "狂信者": "مُتَعَصِّب / مُتَعَصِّب, غَيُور",
 "狂喜": "نَشْوَة",
 "狂女": "مجنونة (امرأة مجنونة)",
 "狂妄": "لامتراكز, منحرف المركز (ليس له مركز مشترك؛ غير متحد المركز) / شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر) / شخصية, غريب الأطوار (شخص من نوع محدد (عادة ما يكون لديه العديد من الغرابة)) / غَرِيب الْأَطْوَار (شخص ذو شخصية غير عادية أو غريبة)\nمثال: دوائر لامتراكزة",
 "狂宴": "احتفال صاخب, سَمَر (مرح واحتفال غير مقيد)",
 "狂想曲": "كابريتشيو (مقطوعة آلية لا تلتزم بقواعد أي شكل موسيقي محدد وتُعزف بارتجال) / شغف جنوني, هوس (دافع غير عقلاني ولكنه لا يُقاوم لمعتقد أو فعل ما) / اضطراب الهوس, هوس (اضطراب مزاجي؛ اضطراب وجداني يميل فيه المصاب إلى الاستجابة بشكل مفرط وعنيف أحياناً)",
 "狂戦士": "بيرسيركر, هائج (أحد المحاربين النورديين القدماء الأسطوريين المعروفين بدخولهم في حالة من الهيجان قبل المعركة والقتال بوحشية متهورة وغضب مجنون)",
 "狂暴": "حَنَق ((حَنِقَ) عَلَيْهِ حنقا: اشْتَدَّ غيظه فَهُوَ حنق وحنيق) / غَضِبَ, اِنْدَلَعَ",
 "狂気": "جُنُون",
 "狂瀾怒涛": "دردور, دوامة مائية (تيار دائري قوي من الماء (عادة نتيجة لتعارض المد والجزر))",
 "狂瀾怒濤": "دردور, دوامة مائية (تيار دائري قوي من الماء (عادة نتيجة لتعارض المد والجزر))",
 "狂牛病": "جُنُون البَقَر",
 "狂犬": "سَگِ دِيوانَہ",
 "狂犬病": "كَلَب, دَاء اَلْكَلَب (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا خُرِز)\nمثال: كان الكلب ميتا.",
 "狂疾": "مرض نفسي (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "狂的": "مَجْنُون, مَخْبُول",
 "狂者": "مُتَعَصِّب / مُتَعَصِّب, غَيُور",
 "狂言": "تخيل, تمثيل (تجسيد للتظاهر) / تَمْثِيلِيّ, مُتَظَاهِر (مُتَخَيَّل كما في اللعب أو التمثيل) / تظاهر, لعب تخيلي (لعب فكري خيالي)\nمثال: كان مجرد تمثيل",
 "狂言綺語": "تخيل, تمثيل (تجسيد للتظاهر) / تَمْثِيلِيّ, مُتَظَاهِر (مُتَخَيَّل كما في اللعب أو التمثيل) / تظاهر, لعب تخيلي (لعب فكري خيالي)\nمثال: كان مجرد تمثيل",
 "狂詩曲": "رابسودية, ملحمة غنائية ((في اليونان القديمة) قصيدة ملحمية معدة للإلقاء) / راپسودي, ملحمة موسيقية ((موسيقى) تكوين آلي حر في حركة ممتدة واحدة؛ عادة ما يكون عاطفياً أو حماسياً في طابعه) / حماسة مفرطة, نشوة (تعبير متحمس عن العاطفة)\nمثال: أهازيج الفرح",
 "狂躁": "شغف جنوني, هوس (دافع غير عقلاني ولكنه لا يُقاوم لمعتقد أو فعل ما) / اضطراب الهوس, هوس (اضطراب مزاجي؛ اضطراب وجداني يميل فيه المصاب إلى الاستجابة بشكل مفرط وعنيف أحياناً)",
 "狂騒": "شغف جنوني, هوس (دافع غير عقلاني ولكنه لا يُقاوم لمعتقد أو فعل ما) / اضطراب الهوس, هوس (اضطراب مزاجي؛ اضطراب وجداني يميل فيه المصاب إلى الاستجابة بشكل مفرط وعنيف أحياناً)",
 "狂騒曲": "شغف جنوني, هوس (دافع غير عقلاني ولكنه لا يُقاوم لمعتقد أو فعل ما) / اضطراب الهوس, هوس (اضطراب مزاجي؛ اضطراب وجداني يميل فيه المصاب إلى الاستجابة بشكل مفرط وعنيف أحياناً)",
 "狆": "سبانييل ياباني (سلالة من كلاب الزينة نشأت في اليابان لها معطف حريري أسود وأبيض أو أحمر وأبيض)",
 "狆くしゃ": "أَفْطَس, قَصِير الأَنْف (ذو أنف قصير وأفطس)",
 "狐": "ثَعْلَب (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر) / تعلب / ثعلب (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر)\nمثال: أردى الصياد الثعلب. / بني فاتح (بني فاتح ولكنه غير مشبع)",
 "狐の嫁入り": "ديمة, زخات مطر (فترة قصيرة من الهطول)\nمثال: توقفت المباراة بسبب زخة مطر قصيرة / قرعة مضيئة",
 "狐の子は頬白": "الْوَلَدُ سُرّ أَبِيهِ",
 "狐の手袋": "أصابع العذراء, ديجيتاليس / ديجيتاليس, قمعية (منشط قوي للقلب يُستخرج من نبات القمعية)",
 "狐の牡丹": "حوذان, زهرة الزبدة",
 "狐塚": "حفرة فردية (خندق صغير به حفرة للمأوى الفردي ضد نيران العدو)",
 "狐火": "سراب, وهم خادع (وهم يضلل) / مصباح العفريت, نار هائمة (ضوء باهت يُرى أحياناً في الليل فوق الأرض المستنقعية)",
 "狐狩り": "صيد الثعالب (صيادون على الخيول يتبعون كلاب الصيد في مطاردة ثعلب)",
 "狐狸": "غَشَّاش, خَدَّاع",
 "狐狸妖怪": "المخادع (كائن خارق للطبيعة مؤذٍ موجود في فلكلور العديد من الشعوب البدائية؛ يتميز أحياناً بدوافع بيولوجية هائلة وأجزاء جسدية مبالغ فيها) / غشاش, محتال (شخص يجعلك تعتقد شيئاً غير حقيقي) / صاحب مقالب, مخادع مازح (شخص يقوم بتدبير المقالب والمزاح العملي ضد الآخرين)",
 "狐猿": "لَيْمُور",
 "狐疑": "شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شَكّ, شُبْهَة ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شُبْهَة\nمثال: إنها بلا شك محقة.",
 "狐臭": "رائحة الجسم (نتانة ناتجة عن عدم الاستحمام)",
 "狐色": "بني فاتح (بني فاتح ولكنه غير مشبع)",
 "狐茄子": "عُشَر (الثَلَاثُ العُشَر: الليلة العاشرة والحادية عشر والثانية عشر من كل شهر قمري…)\nمثال: لدي عشرة أقلام.",
 "狐裘": "معطف فرو (معطف مصنوع من الفرو)",
 "狒々": "رُبَّاح, بَابُون / شهواني, فاسق (رجل لديه رغبات جنسية قوية)",
 "狒狒": "رُبَّاح, بَابُون / شهواني, فاسق (رجل لديه رغبات جنسية قوية)",
 "狗": "كَلْبِيّ / خنزير (خنزير مستأنس) / مخبر, واشٍ (من يكشف معلومات سرية للشرطة أو سلطة أخرى) / خَاسِر / فَاشِل / مزيف, مقلد (غير حقيقي؛ يقلد شيئاً متفوقاً) / تزوير, تزييف (نسخة يتم تقديمها على أنها الأصل)\nمثال: عاطفة مزيفة / جَرْو (الصَغير من كل نَبَات أو حَيَوَان؛ الصغير من الثَمَر كالبَطِّيخ والرُمَّان وغيره)\nمثال: كان الجرو يلحس خدها.",
 "狗児": "جَرْو (الصَغير من كل نَبَات أو حَيَوَان؛ الصغير من الثَمَر كالبَطِّيخ والرُمَّان وغيره)\nمثال: كان الجرو يلحس خدها.",
 "狗尾草": "ذيل الثعلب الأخضر (ذيل ثعلب أوروبي متوطن في أمريكا الشمالية؛ غالباً ما يكون عشبة ضارة مزعجة)",
 "狗母魚": "سمكة السحلية (أسماك استوائية ذات أفواه كبيرة في رؤوس تشبه السحالي؛ توجد في جميع أنحاء العالم)",
 "狙い": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "狙いどころ": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "狙い所": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "狙い打ち": "رِمَايَة",
 "狙い撃ち": "رِمَايَة",
 "狙い目": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "狙う": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / بَحَثَ, طَلَبَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)",
 "狙撃": "رِمَايَة",
 "狙撃兵": "قَنَّاص (صيغة مبالغة من قَنَصَ. وقد تستخدم بمعنى قَانِص؛ الذي مهنته القَنْص، أي صيد الغِزْلان وغيرها من حيوان البَرِّيَّة)",
 "狙撃手": "قَنَّاص (صيغة مبالغة من قَنَصَ. وقد تستخدم بمعنى قَانِص؛ الذي مهنته القَنْص، أي صيد الغِزْلان وغيرها من حيوان البَرِّيَّة)",
 "狙撃銃": "قَنَّاصَة",
 "狛": "كُورِيّ",
 "狛枝": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "狡ける": "تَسَرَّبَ",
 "狡っ辛い": "خَبِيث, مَاكِر",
 "狡智": "حِرْفَة, صَنْعَة",
 "狡猾": "خَبِيث, مَاكِر",
 "狡知": "حِرْفَة, صَنْعَة",
 "狡賢い": "غَيْر مُبَاشِر, مُلْتَوٍ (يَنْحَرِف عَنِ المَسَار المُسْتَقِيم) / مُخَاتِل, مُضَلِّل (غَيْر مُبَاشِر بِالِانْحِرَاف عَنِ الطَّرِيق المَقْبُول أَوِ الصَّحِيح؛ مُضَلِّل) / مُخَاتِل, مُرَاوِغ (يتسم بالرياء أو الخداع؛ مراوغ ومتملص)\nمثال: 彼はとてもずる賢いので私は嫌いだ。 — لا أحبه لأنه ماكر كالثعلب.",
 "狡辛い": "خَبِيث, مَاكِر",
 "狢": "غُرَيْر / كلب الراكون (كلب بري صغير من شرق آسيا له علامات وجه تشبه علامات الراكون)",
 "狢藻": "الدرواندة, نبات طاحونة الماء (نبات مائي آكل للحوم معمر وطافٍ من وسط وجنوب أوروبا وإفريقيا وآسيا وأستراليا، له دوارات من 6 إلى 9 أوراق تنتهي بفصوص مفصلية لاصطياد براغيث الماء مثلاً)",
 "狩": "صَيْد / جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع / مُطَارَدَةُ السَّاحِرَاتِ",
 "狩った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "狩り": "صَيْد / جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع / مُطَارَدَةُ السَّاحِرَاتِ",
 "狩り場": "منطقة صيد (منطقة يتم فيها صيد الطرائد) / مجال خصب, ميدان للصيد (مكان تكثر فيه الفرص)",
 "狩り子": "مِخْفَقة, مِضْرَب (أداة للخفق أو الضرب) / مطارد الصيد (عامل يثير الطرائد البرية من مخبئها للصياد)",
 "狩り小屋": "كوخ الصيد (منزل صغير (ريفي) يستخدم كمأوى مؤقت)",
 "狩り込み": "تجميع المشتبه بهم, حملة اعتقالات (التجميع المنهجي للمشتبه بهم من قبل الشرطة) / تجميع الماشية (نشاط جمع الماشية معاً لعدها أو وسمها أو بيعها) / جولة ملخصة, حصاد (قائمة ملخصة؛ كما في 'حصاد الأخبار')\nمثال: حملة اعتقالات جماعية للمشتبه بهم",
 "狩り集める": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "狩る": "اِصْطَادَ, صَادَ / صَيْد, مُطارَدَة / طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا. / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "狩人": "صَيَّاد, صَائِد (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "狩倉": "منطقة صيد (منطقة يتم فيها صيد الطرائد) / مجال خصب, ميدان للصيد (مكان تكثر فيه الفرص)",
 "狩場": "منطقة صيد (منطقة يتم فيها صيد الطرائد) / مجال خصب, ميدان للصيد (مكان تكثر فيه الفرص)",
 "狩子": "مِخْفَقة, مِضْرَب (أداة للخفق أو الضرب) / مطارد الصيد (عامل يثير الطرائد البرية من مخبئها للصياد)",
 "狩座": "منطقة صيد (منطقة يتم فيها صيد الطرائد) / مجال خصب, ميدان للصيد (مكان تكثر فيه الفرص)",
 "狩猟": "صَيْد",
 "狩猟免許": "تصريح صيد بري, رخصة صيد (رخصة تخول حاملها قتل نوع معين من الحيوانات خلال فترة زمنية محددة)",
 "狩猟小屋": "كوخ الصيد (منزل صغير (ريفي) يستخدم كمأوى مؤقت)",
 "狩猟旅行": "سَفَارِي, سَفَرِيَّة",
 "狩猟期": "موسم الصيد (الموسم الذي يكون فيه قتل نوع معين قانونيًا)",
 "狩猟犬": "كلب صيد (كلب يستخدم في صيد الطرائد)",
 "狩猟者": "صَيَّاد, صَائِد (اِسْمٌ وَصِفَةٌ لِلْأَسَد)",
 "狩猟豹": "فَهْد, شِيتَه",
 "狩猟隊": "سَفَارِي, سَفَرِيَّة",
 "狩猟鳥": "طائر صيد, طائر طريدة (أي طائر (مثل الطيهوج أو التدرج) يتم صيده كرياضة)",
 "狩競": "منطقة صيد (منطقة يتم فيها صيد الطرائد) / مجال خصب, ميدان للصيد (مكان تكثر فيه الفرص)",
 "狩野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "独": "أَلْمَانْيَا (دولة أوروبية في وسط أوروبا)\nمثال: ستعجبك ألمانيا.",
 "独り": "لوحد / لحال / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "独りごちる": "غَمْغَمَة, تَمْتَمة / تَمْتَمَ, هَمْهَمَ",
 "独りごつ": "غَمْغَمَة, تَمْتَمة / تَمْتَمَ, هَمْهَمَ",
 "独りごと": "مناجاة النفس (خطاب درامي (طويل عادة) يهدف إلى إعطاء وهم بتأملات غير منطوقة) / مناجاة النفس, مونولوج داخلي (حديث توجهه لنفسك)",
 "独りで": "وَحِيد, مُنْفَرِد",
 "独りでに": "آلياً, تلقائياً (بطريقة انعكاسية لا إرادية) / تلقائياً, ميكانيكياً (بطريقة ميكانيكية؛ بواسطة آلية)\nمثال: أجاب تلقائياً",
 "独りぼっち": "انطواء, عزلة (ميل نحو البقاء وحيداً)",
 "独りぽっち": "انطواء, عزلة (ميل نحو البقاء وحيداً)",
 "独りよがり": "رضا عن الذات, غرور (الشعور الذي ينتابك عندما تكون راضياً عن نفسك)\nمثال: كان رضاه عن نفسه مثيراً للاشمئزاز تماماً",
 "独り占め": "خروف حولي (خروف يصل عمره إلى سنة واحدة؛ لم يتم جزه بعد)",
 "独り善がり": "رضا عن الذات, غرور (الشعور الذي ينتابك عندما تكون راضياً عن نفسك)\nمثال: كان رضاه عن نفسه مثيراً للاشمئزاز تماماً",
 "独り天狗": "مَغْرُور, مُعْجَب بِنَفْسِه (يتّسم بكبرياء زائف؛ لديه شعور مبالَغ فيه بأهمية الذات)",
 "独り女": "امرأة غير متزوجة, عزباء (امرأة ليست متزوجة)",
 "独り決め": "مُتَطَاوِل, مُفْتَرِض (مفرط في الجرأة والتطاول؛ يتجاوز حدوده)",
 "独り法師": "انطواء, عزلة (ميل نحو البقاء وحيداً)",
 "独り言": "مناجاة النفس (خطاب درامي (طويل عادة) يهدف إلى إعطاء وهم بتأملات غير منطوقة) / مناجاة النفس, مونولوج داخلي (حديث توجهه لنفسك)",
 "独り言ちる": "غَمْغَمَة, تَمْتَمة / تَمْتَمَ, هَمْهَمَ",
 "独り言つ": "غَمْغَمَة, تَمْتَمة / تَمْتَمَ, هَمْهَمَ",
 "独り身": "عزوبية (حالة كون الرجل غير متزوج) / عزوبية (فترة حياة الرجل قبل الزواج)",
 "独修": "تثقيف ذاتي, تعليم ذاتي (عملية تعليم النفس)",
 "独創": "أَصَالَة, ابْتِكَار (صفة كون الشيء جديداً وأصلياً (غير مشتق من شيء آخر)) / أصالة (القدرة على التفكير والتصرف بشكل مستقل)",
 "独創性": "إِبْدَاع (ابْتِكَار؛ إيجاد الشيء من لا شيء)\nمثال: يحتاج اكتساب اللغة إلى الإبداع.",
 "独創的": "إِبْداعِيّ, خَلَّاق\nمثال: 彼は独創的な考えをたくさん持っています。 — عنده كثيرٌ من الأفكار الإبداعية.",
 "独占": "اِحْتِكَار, اِنْحِصَار / خروف حولي (خروف يصل عمره إلى سنة واحدة؛ لم يتم جزه بعد)",
 "独占事業": "اِحْتِكَار, اِنْحِصَار",
 "独占権": "امتياز, حق حصري (حق محفوظ حصريًا لشخص أو مجموعة معينة (خاصة حق وراثي أو رسمي))\nمثال: كان التصويت امتيازًا للذكور البالغين البيض",
 "独占欲": "تملك, حب التملك (رغبة مفرطة في الامتلاك أو السيطرة)",
 "独占的": "اِحْتِكَارِيّ (يملك سيطرة حصرية على نشاط تجاريّ بالحيازة أو بمنحة قانونية)",
 "独占禁止": "مُضَادّ لِلاحْتِكَار (عَنِ القَوَانِين وَالأَنْظِمَة؛ مُصَمَّم لِحِمَايَة التِّجَارَة مِنَ المُمَارَسَات التِّجَارِيَّة غَيْر العَادِلَة)",
 "独占禁止法": "قانون مكافحة الاحتكار (قانون يهدف إلى تعزيز المنافسة الحرة في السوق عن طريق حظر الاحتكارات)",
 "独善的": "مُتَظَاهِر بِالتَّقْوَى, مُرَائِي (مُفرِط في إظهار التقوى بشكل نفاقيّ)",
 "独国": "أَلْمَانْيَا (دولة أوروبية في وسط أوروبا)\nمثال: ستعجبك ألمانيا.",
 "独奏": "منفرداً, وحده (دون أي شخص أو شيء آخر) / طيران منفرد (رحلة طيران يكون فيها الطيار غير مصحوب بأحد) / أداء منفرد, انفراد (أي نشاط يتم أداؤه بمفرده دون مساعدة) / فَرْدِيّ, مُنْفَرِد (مؤلَّف أو مُؤَدّى بصوت واحد أو آلة واحدة)\nمثال: بقي الطفل في المنزل وحده",
 "独奏曲": "منفرداً, وحده (دون أي شخص أو شيء آخر) / طيران منفرد (رحلة طيران يكون فيها الطيار غير مصحوب بأحد) / أداء منفرد, انفراد (أي نشاط يتم أداؤه بمفرده دون مساعدة) / فَرْدِيّ, مُنْفَرِد (مؤلَّف أو مُؤَدّى بصوت واحد أو آلة واحدة)\nمثال: بقي الطفل في المنزل وحده",
 "独奏者": "عازف منفرد (موسيقي يؤدي عزفاً منفرداً)",
 "独女": "امرأة غير متزوجة, عزباء (امرأة ليست متزوجة)",
 "独学": "تثقيف ذاتي, تعليم ذاتي (عملية تعليم النفس)",
 "独学者": "عَصَامِيّ, مُعَلِّم نَفْسَه (شخص علم نفسه بنفسه)",
 "独尊": "تباهي, تفاخر (غرور صريح)",
 "独居": "عُزْلَة",
 "独居室": "صَوْمَعَة, كِرْح / خَلِيَّة / خَلَوِيّ",
 "独居房": "حَبْس اِنْفِرَادِيّ (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "独居監房": "حَبْس اِنْفِرَادِيّ (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "独得": "تحفة, شيء نادر (شيء غير عادي - ربما يستحق الجمع) / خاصية, سمة مميزة (سمة مميزة) / خاصية فارقة, سمة مميزة (خاصية غريبة أو غير عادية)",
 "独我論": "وَحْدَة الْأَنَا",
 "独房": "حَبْس اِنْفِرَادِيّ (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "独房監禁": "حَبْس اِنْفِرَادِيّ (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "独断": "عَقِيدِيَّة, عَقَائِدِيَّة",
 "独断的": "عَقَائِدِي",
 "独断論": "عَقِيدِيَّة, عَقَائِدِيَّة",
 "独木舟": "بيروج, زورق محفور (كانو مصنوع عن طريق حفر وتشكيل جذع شجرة كبير)",
 "独楽": "دُوَّامَة, بُلْبُل",
 "独歩": "استقلالية, اعتماد على النفس (الاستقلال الشخصي) / فَرِيد, فَذّ",
 "独活の大木": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "独演": "منفرداً, وحده (دون أي شخص أو شيء آخر) / طيران منفرد (رحلة طيران يكون فيها الطيار غير مصحوب بأحد) / أداء منفرد, انفراد (أي نشاط يتم أداؤه بمفرده دون مساعدة) / فَرْدِيّ, مُنْفَرِد (مؤلَّف أو مُؤَدّى بصوت واحد أو آلة واحدة)\nمثال: بقي الطفل في المنزل وحده",
 "独特": "تحفة, شيء نادر (شيء غير عادي - ربما يستحق الجمع) / خاصية, سمة مميزة (سمة مميزة) / خاصية فارقة, سمة مميزة (خاصية غريبة أو غير عادية)",
 "独男": "خَاسِر / فَاشِل",
 "独白": "مُونُولُوج, حَدِيث النَّفْس",
 "独眼": "أَعْوَر, عَوْرَاء",
 "独眼竜": "أَعْوَر, عَوْرَاء",
 "独眼龍": "أَعْوَر, عَوْرَاء",
 "独禁": "مُضَادّ لِلاحْتِكَار (عَنِ القَوَانِين وَالأَنْظِمَة؛ مُصَمَّم لِحِمَايَة التِّجَارَة مِنَ المُمَارَسَات التِّجَارِيَّة غَيْر العَادِلَة)",
 "独禁法": "قانون مكافحة الاحتكار (قانون يهدف إلى تعزيز المنافسة الحرة في السوق عن طريق حظر الاحتكارات)",
 "独立": "اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع بالاكتفاء الذاتي والقدرة على اتخاذ القرارات دون تدخل خارجي)\nمثال: الصحراويون يريدون الاستقلال. / تَفْرِقَة",
 "独立の法則": "قانون التوزيع المستقل (ينفصل كل عضو من زوج الكروموسومات المتماثلة بشكل مستقل عن أعضاء الأزواج الأخرى، لذا تكون النتائج عشوائية)",
 "独立国家共同体": "اِتِّحَاد اَلدُّوَل اَلْمُسْتَقِلَّة (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى معاهدة ماستريخت في عام 1993 م…)\nمثال: عاش الاتحاد السوفيتي!",
 "独立型": "قَائِم بِذَاتِه, مُسْتَقِلّ (يقف منفردًا دون أن يكون مُثبَّتًا أو مسنودًا بشيء آخر)",
 "独立変数": "متغير تجريبي, متغير مستقل ((إحصاء) متغير تكون قيمه مستقلة عن التغيرات في قيم المتغيرات الأخرى)",
 "独立性": "اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع بالاكتفاء الذاتي والقدرة على اتخاذ القرارات دون تدخل خارجي)\nمثال: الصحراويون يريدون الاستقلال.",
 "独立機関": "وكالة مستقلة (وكالة تابعة لحكومة الولايات المتحدة يتم إنشاؤها بموجب قانون من الكونغرس وتكون مستقلة عن الإدارات التنفيذية)",
 "独立独歩": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "独立独行": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "独立班": "فصل, فك الارتباط (عملية التحرير من مرفق أو اتصال) / انفصال, تفكك (التفرق أو الانقسام) / انسحاب, تجرد (تجنب التورط العاطفي) / مفرزة (وحدة صغيرة من القوات ذات تكوين خاص)",
 "独立祭": "يَوْم الاِسْتِقْلَال, عِيد الاِسْتِقْلَال (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "独立系": "مُسْتَقِل, حُرّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
 "独立記念日": "يَوْم الاِسْتِقْلَال, عِيد الاِسْتِقْلَال (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "独自": "أَصْلِيّ / مُسْتَقِل, حُرّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
 "独自性": "أَصَالَة, ابْتِكَار (صفة كون الشيء جديداً وأصلياً (غير مشتق من شيء آخر)) / أصالة (القدرة على التفكير والتصرف بشكل مستقل)",
 "独自色": "تميز, فرادة (صفة كون الشيء فريداً من نوعه)\nمثال: ميزه ذلك التفرد عن جميع رفاقه",
 "独自開発": "ذي ملكية خاصة, مملوك (محمي بعلامة تجارية أو براءة اختراع أو حقوق نشر؛ مصنوع أو منتج أو موزع بواسطة من يمتلك حقوقاً حصرية) / مُؤَسَّسَة فَرْدِيَّة, مِلْكِيَّة فَرْدِيَّة (عمل تجاري غير مدمج يمتلكه شخص واحد يكون مسؤولاً عن التزاماته ويحق له أرباحه)\nمثال: تايلينول هو دواء مملوك وشكله العام هو أسيتامينوفين",
 "独行": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "独裁": "دِكْتَاتُورِيَّة, دِيكْتَاتُورِيَّة"
}
