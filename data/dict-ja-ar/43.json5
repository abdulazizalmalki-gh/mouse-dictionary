 "紛うこと無き": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "紛う事なき": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "紛う事無き": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "紛う方なき": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "紛う方なく": "بلا شك, من دون شك (بدون شك؛ بالتأكيد)\nمثال: إنه بلا شك جميل جداً",
 "紛える": "قَلَّدَ",
 "紛らす": "أَلْهَى / أَخْفَى",
 "紛らせる": "أَلْهَى / أَخْفَى",
 "紛らわしい": "مُرْبِك",
 "紛らわす": "أَلْهَى / أَخْفَى",
 "紛れ": "تريماتودا, مثقوبات (ديدان مفلطحة طفيلية لها ممصات خارجية للالتصاق بالمضيف) / فلق (أي من فصي ذيل الحيتان) / سن المرساة, مخلب المرساة (نتوء مسطح يشبه النصل على ذراع المرساة) / سن الخطاف (شوكة في حربة أو سهم) / اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك. / لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "紛れもない": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "紛れも無い": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "紛れ当たり": "تريماتودا, مثقوبات (ديدان مفلطحة طفيلية لها ممصات خارجية للالتصاق بالمضيف) / فلق (أي من فصي ذيل الحيتان) / سن المرساة, مخلب المرساة (نتوء مسطح يشبه النصل على ذراع المرساة) / سن الخطاف (شوكة في حربة أو سهم)",
 "紛乱": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "紛争": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول)\nمثال: شمال مالي منطقة نزاع.",
 "紛争国": "مُمَزَّقٌ بِالحَرْب (خَرَّبَتْهُ الحَرْبُ وَدَمَّرَتْه)",
 "紛争地": "بؤرة توتر, نقطة ساخنة (مكان للاضطرابات السياسية والعنف المحتمل) / بؤرة توتر, نقطة اضطراب (مكان توجد فيه المشاكل أو تحدث بانتظام)\nمثال: لا تستطيع الولايات المتحدة مراقبة جميع النقاط الساخنة في العالم",
 "紛失": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة",
 "紛擾": "إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما) / شِجَار عَلَنِيّ, عِرَاك (قتال صاخب) / إزعاج, اضطراب (نشاط يمثل خللاً أو تطفلاً أو انقطاعاً) / تداخل, تشويش (نشاط كهربائي أو صوتي يمكن أن يزعج الاتصالات)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي",
 "紛然": "اِحْتَارَ / تَشَوَّش / اِرْتَبَكَ, تَشَوَّش",
 "紛糾": "تَعْقِيد / مُضَاعَفَة",
 "紛紛": "اِحْتَارَ / تَشَوَّش / اِرْتَبَكَ, تَشَوَّش",
 "紛議": "تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / تنافر, خلاف (صراع في آراء الناس أو أفعالهم أو طباعهم)",
 "素": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل / قَاعِدَة, أَسَاس / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية. / مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / مُمْتَاز, فَاخِر / مَبْدَأ, قاعِدَة (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه) / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / بحيرة صغيرة, بركة (بركة صغيرة من المياه الراكدة) / بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "素っ": "أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "素っ気ない": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "素っ気無い": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "素っ破": "جَاسُوس / تَجَسَّسَ / لِصّ, لِصَّة / ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "素っ裸": "عُرْي / عَارٍ تَمَاماً ((غير رسمي) عارٍ تماماً بلا أي ملابس) / فقير",
 "素っ頓狂": "مُتَوَحِّش / بَرِّيّ",
 "素っ飛ぶ": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة. / اِحْتَجَبَ, إخْتَفَى (وضع أمامه حجابا فلم يُعَد يُرى؛ وضع له حاجبا)",
 "素っ首": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "素で": "بصدق, حقاً (وفقاً للحقيقة أو الواقع) / بِأَصَالَة, بِحَقّ (بشكل حقيقي؛ بسلطة)\nمثال: أصبحت الآن أمريكية حقاً",
 "素もぐり": "غطس, غوص حر (السباحة تحت الماء دون أي معدات تنفس أكثر من أنبوب التنفس)",
 "素人": "هَاوٍ, هَاوِيَة",
 "素人下宿": "بنزيون, نزل داخلي (منزل خاص يوفر الإقامة والوجبات للضيوف مقابل أجر)",
 "素人臭い": "غَيْر مَاهِر, هَاوٍ (يفتقر إلى المهارة أو الخبرة المهنية)",
