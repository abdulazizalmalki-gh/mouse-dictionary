 "焚きつけ": "إشعال, إضرام (عملية إضرام النار في شيء ما)",
 "焚きつける": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة\nمثال: نسي أن يطفئ النور. / حَرَّضَ, حَضَّ (حرّضه على الأمر: حضّه ، شدّد الرّغبة فيه؛ حَرَّضَهُ تَحْرِيضاً: حَثَّه على…)\nمثال: هو حرض على الشغب.",
 "焚き付け": "إشعال, إضرام (عملية إضرام النار في شيء ما)",
 "焚き付ける": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة\nمثال: نسي أن يطفئ النور. / حَرَّضَ, حَضَّ (حرّضه على الأمر: حضّه ، شدّد الرّغبة فيه؛ حَرَّضَهُ تَحْرِيضاً: حَثَّه على…)\nمثال: هو حرض على الشغب.",
 "焚き口": "أَبْوَاب, بَاب",
 "焚き木": "إشعال, إضرام (عملية إضرام النار في شيء ما)\nمثال: もう少し火にまきをくべなさい。 — زد بعض الحطب إلى النار.",
 "焚き火": "مَشْعَل",
 "焚き火台": "حفرة نار (حفرة أرضيتها من الحمم المتوهجة)\nمثال: حفرة النار في الفوهة",
 "焚き物": "حَطَب (حَطَبَ فُلَانًا حَطَباً يَحْطِبُه واحْتَطَبَ لَهُ: جَمَعَه لَهُ وأَتاهُ بِهِ…)\nمثال: بحث زيري عن الحطب.",
 "焚き落とし": "جَمْرَة",
 "焚く": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف…)\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري. / شَوَى, صَلَى / حَرَارَة (السخونة والحماوة؛ شدة العَطَش)\nمثال: حرارة الطقس تتزايد. / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف…)\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري. / حَرَارَة (السخونة والحماوة؛ شدة العَطَش)\nمثال: حرارة الطقس تتزايد. / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال)\nمثال: أيمكنني استعمال هاتفك؟",
 "焚付": "إشعال, إضرام (عملية إضرام النار في شيء ما)",
 "焚刑": "حرق, حرق على الخازوق (الإعدام بالنار)",
 "焚口": "أَبْوَاب, بَاب",
 "焚火": "مَشْعَل",
 "焚火台": "حفرة نار (حفرة أرضيتها من الحمم المتوهجة)\nمثال: حفرة النار في الفوهة",
 "焚物": "حَطَب (حَطَبَ فُلَانًا حَطَباً يَحْطِبُه واحْتَطَبَ لَهُ: جَمَعَه لَهُ وأَتاهُ بِهِ…)\nمثال: بحث زيري عن الحطب.",
 "焚落し": "جَمْرَة",
 "無": "لَا شَيْء (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "無い": "مَعْدُوم / سَائِب, غَيْر مَمْلُوك (ليس لديه مالك) / فَرِيد, فَذّ / لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)",
 "無いことには": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "無い事には": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "無い内に": "قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "無い物は無い": "مَعْدُوم",
 "無うなる": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل.",
 "無かったことにする": "سَامَحَ",
 "無かった事にする": "سَامَحَ",
 "無き": "بِلَا, غَيْر",
 "無きにしもあらず": "هُنَاكَ, يُوجَدُ",
 "無きにしも非ず": "هُنَاكَ, يُوجَدُ",
 "無きゃ": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "無きゃいけない": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "無きゃならない": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "無き者": "راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "無くした": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "無くして": "بِدُونِ, بِلَا\nمثال: 労なくして益なし。 — كل شيء وله ثمن",
 "無くしては": "بِدُونِ, بِلَا",
 "無くす": "فَقَدَ\nمثال: خسر توم وظيفته. / تَخَلَّصَ ؛ مِن",
 "無くちゃ": "بِدُونِ, بِلَا",
 "無くちゃいけない": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "無くては": "بِدُونِ, بِلَا",
 "無くてはいけない": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "無くてはいけません": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "無くてはならない": "حَتْمِيّ, لَا مَفَرَّ مِنْه (لا يمكن تجنّبه أو الاستغناء عنه)\nمثال: أطعمة لا غنى عنها للتغذية الجيدة",
 "無くても良い": "يَضْطَر",
 "無くなす": "فَقَدَ\nمثال: خسر توم وظيفته.",
 "無くなる": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل.",
 "無くもがな": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "無ければ": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "無げ": "سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل)",
 "無さそう": "مِنْ غَيْرِ المُرَجَّحِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "無し": "بِدُونِ, بِلَا / غَيْر مَقْبُول, مَرْفُوض (غير مقبول؛ غير مرحب به)\nمثال: كلمة غير مقبولة في المجتمع المهذب / مَعْدُوم",
 "無しで": "بِدُونِ, بِلَا",
 "無しで済ます": "اِسْتَغْنَى",
 "無しに": "بِدُونِ, بِلَا",
 "無しには": "بِدُونِ, بِلَا",
 "無にする": "تَعَسُّف, طُغْيَان\nمثال: أهان سامي ليلى بقص شعرها. / فَارِغ",
 "無みする": "تَجَاهَلَ, طَنَّش",
 "無リスク金利": "بِلَا مُخَاطَرَة, خَالٍ مِنَ المَخَاطِر (يُعتَقد أنّه خالٍ من المخاطر)",
 "無一文": "فقير",
 "無上": "أَعْلَى, سَيِّد (الأَعْظَم مَكَانَةً أَوْ سُلْطَةً أَوْ قُوَّةً)",
 "無上命法": "أَمْر مُطْلَق, وَاجِب قَطْعِيّ (المبدأ الأخلاقي القائل بأن السلوك يجب أن يتحدد بالواجب)",
 "無下に": "بِصَرَاحَة فَجَّة, بِفَظَاظَة (بطريقة مباشرة فظة)\nمثال: تحدث بفظاظة",
 "無下にする": "إِهْمال",
 "無主": "سَائِب, غَيْر مَمْلُوك (ليس لديه مالك)",
 "無乳": "انقطاع اللبن, عوز اللبن (حالة عدم إفراز الحليب في ثدي الأم بعد الولادة)",
 "無乳房症": "انعدام الثدي (غياب الغدد الثديية (إما عن طريق الجراحة أو عيب في النمو))",
 "無乳症": "انقطاع اللبن, عوز اللبن (حالة عدم إفراز الحليب في ثدي الأم بعد الولادة)",
 "無事": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن. / بِسَلَام, بِأَمَان / صحة جيدة, عافية (حالة التمتع بالنشاط والخلو من الأمراض الجسدية أو العقلية) / جمود, خمول (حالة عدم النشاط)",
 "無事に": "بِسَلَام, بِأَمَان / بسلام, بهدوء (بطريقة سلمية)\nمثال: استقرت الدجاجة على العش بسلام تام",
 "無二": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "無二無三": "بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه / فَرِيد, فَذّ",
 "無人": "غير مأهول, مُسير عن بعد (يفتقر إلى طاقم)\nمثال: قمر صناعي غير مأهول إلى المريخ",
 "無人機": "يَعْسُوب, يَمْخُور",
 "無人爆撃機": "يَعْسُوب, يَمْخُور",
 "無人航空機": "يَعْسُوب, يَمْخُور",
 "無人販売所": "آلَة بَيْع, آلَة بَيْع ذَاتِيّ (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "無人飛行機": "يَعْسُوب, يَمْخُور",
 "無代": "مَجَّانِيّ, مَجَّانًا",
 "無休": "رحلة بدون توقف (رحلة تتم دون توقفات وسيطة بين المصدر والوجهة)\nمثال: كم عدد الرحلات بدون توقف إلى دالاس؟",
 "無伴奏": "منفرداً, وحده (دون أي شخص أو شيء آخر)\nمثال: بقي الطفل في المنزل وحده",
 "無体": "غَيْر مَلْمُوس, مَعْنَوِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة)",
 "無体物": "غَيْر مَلْمُوس, مَعْنَوِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "無体財産権": "مِلْكِيَّة فِكْرِيَّة",
 "無体資産": "أصل غير ملموس, أصول معنوية (أصول قابلة للبيع وإن لم كانت مادية أو فيزيائية)",
 "無何有の郷": "طُوبَائِيَّة, مَدِينَةٌ فَاضِلَة",
 "無作法": "سَيِّئُ الأَدَبِ, وَقِح (غير صحيح السلوك اجتماعياً)",
 "無作法者": "سَيِّئُ الأَدَبِ, وَقِح (غير صحيح السلوك اجتماعياً)",
 "無作為": "عَشْوَائِيّ",
 "無作為化": "تعشية, عشوائية (ترتيب عشوائي متعمد للملاحظات لمحاكاة الصدفة)",
 "無作為抽出": "أخذ عينات عشوائي (اختيار عينة عشوائية؛ حيث يكون لكل عنصر من عناصر المجتمع فرصة متساوية في الاختيار)",
 "無価": "لَا يُقَدَّرُ بِثَمَن, نَفِيس (ذُو قِيمَةٍ مَادِّيَّةٍ أَوْ فِكْرِيَّةٍ أَوْ رُوحِيَّةٍ لَا تُحْصَى)",
 "無価値": "انْعِدَام القِيمَة, لَا جَدْوَى (عدم امتلاك أي صفات تجعل الشيء قيماً أو مفيداً)\nمثال: كان هدف رقيب التدريب إقناع المجندين بانعدام قيمتهم",
 "無信": "لَادِينِيَّة",
 "無信仰": "لَادِينِيَّة",
 "無信心": "لَادِينِيَّة",
 "無修正": "غَيْر مُغَيَّر (باقٍ في حالة أصلية)\nمثال: استمر غير متغير عبر الزمن",
 "無個性": "انْعِدَام المَلَامِح, بَهْتَان (حالة أو شرط الخلو من الميزات المميزة)",
 "無偏": "موضوعية (الحكم القائم على الظواهر القابلة للملاحظة وغير المتأثر بالعواطف أو التحيزات…)",
 "無停電電源": "فَوْقَ, فَوْق",
 "無停電電源装置": "فَوْقَ, فَوْق",
 "無傷": "سَالِم, مُعَافًى (لم يُصَب بأذى أو ضرر) / بِلَا عَيْب, خَالٍ مِنَ العُيُوب (خالٍ من أيّ عيب أو شائبة) / بِلَا شَائِبَة, نَاصِع (بالغ النظافة وخالٍ من أيّ بقعة أو لطخة)",
 "無償": "حُرّ (ضد البَرْد)\nمثال: أنا حر كالطائر.",
 "無償行為": "مُتَطَوِّع, مُتَطَوِّعَة",
 "無光": "بِلَا إِضَاءَة, غَيْر مُنَار (بِدُون إِنَارَة أَوْ إِضَاءَة)\nمثال: كانت الطاولة عارية، والشموع غير مضاءة",
 "無光沢": "غَيْر لَامِع, مَطْفِيّ (لَا يَعْكِس الضَّوْء؛ غَيْر بَرَّاق)",
 "無党派層": "ناخب متأرجح (ناخب ليس لديه ولاء لأي حزب سياسي ويمكن لقراراته غير المتوقعة أن ترجح كفة…)",
 "無公害": "نَظِيف",
 "無冠": "بلا تاج, غير متوج (غير مزود (خاصة ليس بعد) بتاج)\nمثال: الملك غير المتوج",
 "無冠の帝王": "صَحَفِيّ, صَحَفِيَّة\nمثال: لن أنس مراسلة أمي.",
 "無分別": "طيش, عدم اكتراث (سمة عدم التفكير بعناية قبل التصرف)",
 "無制限": "لَا يَنْضَب, لَا يُسْتَنْفَد (لَا يُمْكِنُ اسْتِهْلَاكُهُ أَوِ اسْتِنْفَادُهُ بِالكَامِلِ)\nمثال: البدء بنظرية الحرية غير المحدودة هو الانتهاء باستبداد غير محدود",
 "無削除": "غَيْر مُختَصَر, كَامِل (كامل بلا حذف أو اختصار)\nمثال: كتاب أوراقه لا تزال غير مفصولة",
 "無力": "ضَعْف, عَجْز (صفة الافتقار إلى القوة أو القدرة؛ الضعف والوهن)",
 "無効": "بَاطِل, غَيْر صَالِح (لم يعد ساري المفعول)\nمثال: استدلال باطل",
 "無効にする": "إبطال, إلغاء المفعول (فعل الإبطال؛ جعل الشيء لاغياً وباطلاً؛ أو تجاوز تأثير أو قوة شيء ما)",
 "無効化": "مُعَطِّل, مُقْعِد (يُسَبِّب عَجْزًا أو إعاقَة جَسَدِيَّة)\nمثال: بعض القيود المبطلة للأهلية حرمته من الجنسية / إبطال, إفساد (الإبطال عن طريق تدمير القوة القانونية)\nمثال: إبطال العقد",
 "無化": "إبطال, إلغاء المفعول (فعل الإبطال؛ جعل الشيء لاغياً وباطلاً؛ أو تجاوز تأثير أو قوة شيء ما)",
 "無印": "غير معنون, غير موسوم (يفتقر إلى ملصق أو وسم)\nمثال: الأمتعة غير المعنونة معرضة للضياع",
 "無原罪": "خلو من العيب, طهارة (سمة عدم وجود وصمة أو شائبة؛ كونه نظيفاً، غير مدنس، صافياً، نقياً)\nمثال: للأسف لم يحافظ على نقائه بل استسلم لشهواته",
 "無原罪の宿り": "الحَمْل بِلَا دَنَس",
 "無原罪の御宿り": "الحَمْل بِلَا دَنَس",
 "無双": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "無反応": "غير متجاوب, غير مستجيب (لا يستجيب لتأثير أو محفز ما)",
 "無口": "قليل الكلام, كتوم (متحفظ عادة وغير متحدث) / لا فموي (ليس له فم أو فتحة تشبه الفم)",
 "無名": "غَيْر مُعَرَّف, مَجْهُول الهُوِيَّة (ذو مصدر مجهول أو غير مُسمَّى) / مُظْلِم / اتِّفَاقِيّ, بِلَا سَبَب (ليس له سبب أو سبب ظاهر)",
 "無名動脈": "الجذع العضدي الرأسي, شريان لا اسم له (شريان كبير ينشأ من قوس الأبهر وينقسم إلى الشريان تحت الترقوة الأيمن والشريان…)",
 "無名戦士": "الجندي المجهول (جندي غير محدد الهوية يتم تكريم جثمانه كنصب تذكاري)",
 "無名指": "بِنْصِر",
 "無名氏": "شخص غير مهم, لا أحد (شخص ليس له تأثير أو نفوذ)",
 "無名骨": "عظم الحوض, عظم الورك (عظم كبير واسع يشكل نصف الحوض؛ يتكون من الحرقفة والإسك والعانة)",
 "無向グラフ": "رسم بياني غير موجه (في الرياضيات، رسم بياني لا يكون للحواف فيه اتجاه)",
 "無告": "عَاجِز",
 "無味": "عديم الذوق, مبتذل (يفتقر إلى الذوق الجمالي أو الاجتماعي) / مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "無味乾燥": "كَلِيل",
 "無味無臭": "دَمِث, لَبِق (مُجَامِل بِسَلَاسَة وَأَدَب مَعَ قَدْرٍ مِنَ الرُّقِيّ)",
 "無呼吸": "اِنْقِطَاع النَّفَس أَثْنَاء النَّوْم",
 "無問題": "عَفْوًا",
 "無嗅覚": "خشم, فقد الشم (غياب حاسة الشم)",
 "無嗅覚症": "خشم, فقد الشم (غياب حاسة الشم)",
 "無器用": "أَخْرَق / عَاجِز, غَيْر مُؤَهَّل (لا يستوفي المتطلّبات اللازمة)\nمثال: جهاز مخابرات غير كفء",
 "無器量": "قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح. / عَاجِز, غَيْر مُؤَهَّل (لا يستوفي المتطلّبات اللازمة)\nمثال: جهاز مخابرات غير كفء",
 "無国籍者": "شخص بلا جنسية, نازح (شخص أجبر على الفرار من منزله أو بلده)",
 "無地": "بَسِيط\nمثال: هذا الشعور سهل.",
 "無垢": "صَافٍ, اَلصَّافِي",
 "無垢清浄": "مُنَزَّه",
 "無報酬": "بلا أجر, غير مدفوع (لم يتم الدفع له)\nمثال: أجور غير مدفوعة",
 "無塩": "غَيْرُ مُتَبَّل, غَيْرُ مُمَلَّح (بِدُونِ مِلْحٍ أَوْ تَوَابِل) / وقود المدافع (جنود يُعتبرون قابلين للتضحية بهم في مواجهة نيران المدفعية) / شرف, عفة (فضيلة المرأة أو عفتها)",
 "無塩食": "حمية خالية من الملح, حمية قليلة الصوديوم (نظام غذائي يحد من تناول الملح (كلوريد الصوديوم)؛ يستخدم غالباً في علاج ارتفاع…)",
 "無塵室": "غرفة معقمة, غرفة نظيفة (غرفة خالية تقريباً من الغبار أو البكتيريا؛ تستخدم في العمل المخبري وفي تجميع أو…)",
 "無境界": "احتشاد, تجمهر (تجمع الناس معاً)\nمثال: تقع بيتسبرغ عند نقطة التقاء نهري أليغيني ومونونغاهيلا",
 "無声": "صَمْت, سُكُوت / افْتِقَار لِلصَّوْت, تَهْمِيش (عدم وجود صوت أو رأي في إدارة أو السيطرة على الشؤون)",
 "無声子音": "صوت مهموس (صامت يُنتج بدون صوت من الحبال الصوتية)",
 "無声映画": "سِينِمَا صَامِتَة (مصطلح يشير إلى التصوير المتحرك الذي يعرض للجمهور و يعتبر التصوير السينمائي من…)\nمثال: كان في السينما.",
 "無妻": "أعزب (رجل لم يتزوج قط)",
 "無始曠劫": "زمن سحيق, قديم الزمان (الماضي البعيد وراء الذاكرة)",
 "無始無終": "أبدية, بقاء (خاصية الاستمرار إلى الأبد)",
 "無媒介": "فورية, مباشرة (عدم وجود وسيط أو وكالة متداخلة)\nمثال: فورية التغطية التلفزيونية",
 "無学": "جاهل, غير متعلم (لا يمتلك تعليماً جيداً) / بوذا (الشخص الذي حقق حالة من الاستنارة الكاملة)",
 "無宗教": "لَادِينِيَّة",
 "無定形": "عَدِيم الشَّكْل, لَابَلُّورِيّ (بِدُون شَكْلٍ بَلُّورِيٍّ حَقِيقِيٍّ أَوْ ظَاهِر)",
 "無定見": "مُتَعَارِض, مُتَنَاقِض (غَيْرُ مُتَّسِقٍ أَوْ مُتَوَافِقٍ)\nمثال: التصريحات المتناقضة لا يمكن أن تكون صحيحة في نفس الوقت",
 "無実": "بَرَاءَة / لَا جَوْهَرِيَّة, وَهْن (الافتقار إلى الجوهر أو الواقع) / رياء, زيف (صفة عدم الصراحة أو الصدق؛ الخداع أو النفاق)",
 "無害": "غير ضار, مسالم (لا يسبب أو غير قادر على التسبب في ضرر)\nمثال: بكتيريا غير ضارة",
 "無害化": "إزالة السموم (علاج للتسمم عن طريق تحييد الخصائص السامة (عادة وظيفة الكبد)) / تَعْقِيم ((وعَقَّمَهُ تَعْقيمًا: أسْكَتَه)؛ عقّم يعقِّم تعقيماً،فهو معقِّم،والمفعول…)",
 "無家賃": "دُونَ إِيجَار, مَجَّانًا (بدون دفع إيجار)\nمثال: يمكنني العيش هنا مجاناً",
 "無宿": "تشرد (حالة أو وضع عدم امتلاك منزل (خاصة حالة العيش في الشوارع))",
 "無宿者": "بِلا مَأْوَى, مُشَرَّد (شخص سيء الحظ بدون سكن)\nمثال: عُثر على مشرد مقتولاً في سنترال بارك",
 "無審査": "غَيْر مُجَرَّب, غَيْر مُخْتَبَر (لم يُخْتَبَر أو يُجَرَّب بالتجربة العملية)",
 "無尽": "ديمومة, عدم القابلية للنفاذ (حالة أو شرط استحالة الاستنفاد أو النفاذ؛ كون الشيء غير محدود)\nمثال: يجب على الاقتصاديين التصالح مع عدم قابلية المعرفة للنفاذ، وحقيقة أن استخدام المعرفة لا يستنزفها",
 "無尽会社": "دعم لوجستي دولي, عون متبادل (ترتيبات بين الدول لمساعدة بعضها البعض)",
 "無尾類": "ضفدع, علجوم (أي من البرمائيات المختلفة عديمة الذيل ممتلئة الجسم ذات أطراف خلفية طويلة للقفز…)",
 "無尿": "انحباس البول, انقطاع البول (عدم القدرة على التبول)",
 "無届": "غَيْر مُسَجَّل ((عَنِ القَارِب أَوِ السَّفِينَة) غَيْر مُزَوَّد بِالوَثَائِق الرَّسْمِيَّة)\nمثال: مواطن غير مسجل",
 "無届け": "غَيْر مُسَجَّل ((عَنِ القَارِب أَوِ السَّفِينَة) غَيْر مُزَوَّد بِالوَثَائِق الرَّسْمِيَّة)\nمثال: مواطن غير مسجل",
 "無差別": "اعتباطي, عشوائي (لا يتميز بتمييزات دقيقة (يخلط الحابل بالنابل))\nمثال: عادات قراءة عشوائية",
 "無差別曲線": "منحنى السواء (في نظرية الاقتصاد الجزئي، رسم بياني يوضح مجموعات مختلفة من السلع التي يكون…)",
 "無常": "زوال, عدم الدوام (خاصية عدم الوجود لمدد طويلة غير محددة) / قَابِل لِلطَّفْرَة (يميل إلى الخضوع لطفرة جينيّة)\nمثال: مادة قابلة للتحول",
 "無帽": "غَيْر مُغَطًّى, مَكْشُوف (غير مغطى بالملابس)",
 "無干渉": "عدم التدخل (سياسة خارجية للبقاء خارج نزاعات الدول الأخرى)",
 "無弓類": "لا ثقوبيات (زاحف بدائي ليس له فتحة في المنطقة الصدغية من الجمجمة؛ جميعها منقرضة باستثناء…)",
 "無形": "عَدِيمُ الشَّكْل (لَيْسَ لَهُ شَكْلٌ مَادِّيٌّ مُحَدَّد)",
 "無形文化遺産": "تراث ثقافي غير مادي",
 "無形財産": "أصل غير ملموس, أصول معنوية (أصول قابلة للبيع وإن لم كانت مادية أو فيزيائية)",
 "無彩色": "لَالَوْنِيّ, مُحَايِد (ليس له تدرج لوني)\nمثال: ألوان محايدة مثل الأسود أو الأبيض",
 "無役": "مُعْفًى مِنَ الرُّسُوم (مُعْفًى مِنَ الرُّسُومِ الجُمْرُكِيَّة)",
 "無徒": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "無得点": "بِلَا أَهْدَاف, بِلَا نِقَاط (لم يُسجَّل فيه أي نقاط أو أهداف)",
 "無徳": "فَقِير",
 "無心": "بَرَاءَة / فصل, فك الارتباط (عملية التحرير من مرفق أو اتصال) / بِلَا شُعُور, جَامِد (خالٍ من الشعور والوعي والحيوية)\nمثال: حجر جامد / مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "無念": "نَدِمَ\nمثال: للأسف ذلك صحيح.",
 "無念がる": "نَدِمَ\nمثال: للأسف ذلك صحيح.",
 "無念をはらす": "اِنْتَقَمَ",
 "無念を晴らす": "اِنْتَقَمَ",
 "無思慮": "طيش, عدم اكتراث (سمة عدم التفكير بعناية قبل التصرف)",
 "無性": "بِلَا جَاذِبِيَّة جِنْسِيَّة (غير جذّاب جنسيًّا) / لَاجِنْسِيّ, لَاجِنْسِيَّة",
 "無性に": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً)\nمثال: شعروا بالخسارة بعمق",
 "無性愛": "لَاجِنْسِيَّة",
 "無性生殖": "تَكَاثُر لَاجِنْسِيّ",
 "無性繁殖": "تَكَاثُر لَاجِنْسِيّ",
 "無性芽": "برعم تكاثري, جيمة (بنية تكاثرية لا جنسية صغيرة في حشيشة الكبد والحزازيات تنفصل عن الأصل وتتطور إلى…)",
 "無恥": "وَقِح, صَفِيق",
 "無情": "غلظة, قسوة القلب (غياب الاهتمام برفاهية الآخرين) / بِلَا شُعُور, جَامِد (خالٍ من الشعور والوعي والحيوية)\nمثال: حجر جامد",
 "無惨": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة)",
 "無意味": "هُرَاء, لَغْو",
 "無意志": "قسري, لا إرادي (غير خاضع لسيطرة الإرادة)\nمثال: قتل غير عمد (لا إرادي)",
 "無意気": "بَذِيء",
 "無意義": "بلا معنى, عبثي (ليس له معنى أو اتجاه أو غرض)\nمثال: مسعى بلا معنى",
 "無意識": "فِقْدَان اَلْوَعْي, إِغْمَاء / فاقد الوعي, لاواعٍ (غير واعٍ؛ يفتقر إلى الوعي والقدرة على الإدراك الحسي كما لو كان نائماً أو ميتاً)\nمثال: مستلقٍ فاقداً للوعي على الأرض",
 "無意識的": "فاقد الوعي, لاواعٍ (غير واعٍ؛ يفتقر إلى الوعي والقدرة على الإدراك الحسي كما لو كان نائماً أو ميتاً)\nمثال: مستلقٍ فاقداً للوعي على الأرض",
 "無愛嬌": "فَظّ, مُقْتَضَب (يتسم بالقصور الوقح أو الاستعلائي في الكلام)",
 "無愛想": "انطوائي, غير اجتماعي (لا يميل إلى المجتمع أو الرفقة)\nمثال: طبيعة غير اجتماعية؛ خجول ومتحفظ",
 "無愛敬": "فَظّ, مُقْتَضَب (يتسم بالقصور الوقح أو الاستعلائي في الكلام)",
 "無感動": "عادي, غير مثير للإعجاب (غير قادر على إثارة الإعجاب)",
 "無感情": "لَامُبَالَاة, عَدَم اِكْتِرَاث",
 "無感覚": "خَدِر (استتر؛ خدر بالمكان: أقام)\nمثال: خفف زيري السرعة. / لَا مُبَالٍ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "無愧": "وَقِح, صَفِيق",
 "無慈悲": "عديم الرحمة, قاسٍ (ليس لديه أو لا يظهر أي رحمة)\nمثال: العدو عديم الرحمة",
 "無慙": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة)",
 "無慚": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة)",
 "無慮": "حَوَالَيْ, تَقْرِيبًا",
 "無我": "إِيثَار, غَيْرِيَّة",
 "無我の境": "ترانس",
 "無所属": "مُسْتَقِل, حُرّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
 "無手": "فَارِغ اليَدَيْن (لَا يَحْمِلُ شَيْئًا فِي يَدَيْه)",
 "無才": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات)",
 "無批判": "أعمى (في الاتباع), غير انتقادي (غير ناقد؛ لا يميل إلى البحث عن الأخطاء أو لفت…)\nمثال: معجب مخلص وتقريباً غير انتقادي (أعمى)",
 "無技巧": "بَسِيط, سَاذَج (بسيط وطبيعي؛ بدون مكر أو خداع)\nمثال: أسلوب بسيط",
 "無抵抗": "عَدَم المُقَاوَمَة (رفض جماعي للجوء إلى العنف حتى في الدفاع ضد العنف)",
 "無抵抗主義": "عَدَم المُقَاوَمَة (رفض جماعي للجوء إلى العنف حتى في الدفاع ضد العنف)",
 "無担保": "بِلَا ضَمَان, غَيْر مَضْمُون (بدون ضمان ماليّ)",
 "無挨拶": "خشونة, قلة ذوق (قلة أدب متعمدة)",
 "無援": "عَاجِز",
 "無政府": "فَوْضَى, فَوْضَوِيَّة",
 "無政府主義": "لَاسُلْطَوِيَّة",
 "無政府主義者": "فَوْضَوِيّ, فَوْضَوِيَّة",
 "無政府共産主義": "شيوعية لاسلطوية (نظرية لاسلطوية تدعو إلى إلغاء الدولة والرأسمالية والأجور والملكية الخاصة، وتؤيد…)\nمثال: في الوقت نفسه، كان يتطور من اللاسلطوية الجماعية لباكونين إلى مذهب الشيوعية اللاسلطوية",
 "無政府状態": "فَوْضَى, فَوْضَوِيَّة",
 "無政府資本主義": "لاسلطوية رأسمالية",
 "無敗": "بلا هزيمة, غير مهزوم (منتصر (لم يهزم))\nمثال: غير مهزوم في المعركة",
 "無教育": "جاهل, غير متعلم (لا يمتلك تعليماً جيداً)",
 "無教養": "جاهل, غير متعلم (لا يمتلك تعليماً جيداً)",
 "無数": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "無敵": "مَنِيع",
 "無文": "سادة, غير منقوش (يفتقر للنقوش خاصة في اللون)",
 "無料": "حُرّ (ضد البَرْد)\nمثال: أنا حر كالطائر.",
 "無料通話": "مجاني (لا تفرض عليه رسوم استخدام)\nمثال: طريق مجاني",
 "無断借用": "اختلاس, سوء استخدام (استعارة غير مشروعة)\nمثال: كان تفسيره سوء استخدام للنظرية الاجتماعية",
 "無断居住者": "محتل للمكان, واضع اليد (شخص يستقر في أرض أو مسكن دون حق أو سند قانوني)",
 "無断欠席": "تَمَلُّص, هُرُوب مِن المَدْرَسَة (الفشل في الحضور (خاصة المدرسة))",
 "無方針": "انعدام الهدف, عبثية (صفة الافتقار إلى أي غرض محدد)",
 "無智": "جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام.",
 "無暗に": "بشكل غير معقول, بشكل مفرط (لدرجة تتجاوز حدود العقل أو الاعتدال)",
 "無月": "مُحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة…)",
 "無月経": "انقطاع الطمث (غياب أو قمع تدفق الطمث الطبيعي)",
 "無期": "نَكِرَة / سَجْن مُؤَبَّد (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "無期刑": "سَجْن مُؤَبَّد (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "無期懲役": "سَجْن مُؤَبَّد (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "無期禁固": "سَجْن مُؤَبَّد (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "無期禁錮": "سَجْن مُؤَبَّد (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "無期限": "نَكِرَة",
 "無条件": "غَيْر مَشْرُوط (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "無条件反射": "رد فعل منعكس, منعكس (رد فعل تلقائي غريزي غير متعلم لمحفز)",
 "無条件降伏": "استسلام غير مشروط",
 "無東西": "حَاجّ, حَجِّيّ (افتقر)\nمثال: لا أرى لذلك حاجة.",
 "無柄": "جَالِس, عَدِيم السُّوَيْقَة (متصل مباشرة بالقاعدة؛ ليس له ساق وسيطة)\nمثال: زهور لاطئة",
 "無根": "لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "無根拠": "لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "無極": "بِلَا حُدُود, لَامَحْدُود (يَبْدُو بِلَا حُدُودٍ فِي الكَمِّيَّةِ أَوِ العَدَدِ أَوِ الدَّرَجَةِ أَوِ…)\nمثال: البدء بنظرية الحرية غير المحدودة هو الانتهاء باستبداد غير محدود",
 "無様": "كَرِيه المَنْظَر (غير سار للنظر)",
 "無標": "غير موسوم, غير مُميز (ليس لديه علامة تعريف)\nمثال: أوراق لعب غير معلمة",
 "無機": "غير عضوي (متعلق أو منتمي لفئة المركبات التي ليس أساسها الكربون)\nمثال: أحماض الهيدروكلوريك والكبريتيك تسمى مواد غير عضوية / كيمياء اللاعضوية (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما…)\nمثال: هو يحب الكيمياء. / مركب غير عضوي (أي مركب لا يحتوي على الكربون)",
 "無機化合物": "مركب غير عضوي (أي مركب لا يحتوي على الكربون)",
 "無機化学": "كيمياء اللاعضوية (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما…)\nمثال: هو يحب الكيمياء.",
 "無機物": "مركب غير عضوي (أي مركب لا يحتوي على الكربون)",
 "無機的": "غير عضوي (متعلق أو منتمي لفئة المركبات التي ليس أساسها الكربون)\nمثال: أحماض الهيدروكلوريك والكبريتيك تسمى مواد غير عضوية",
 "無機質": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك…)\nمثال: الماء بارد حقا.",
 "無機質肥料": "سماد معدني (سماد غير عضوي يحتوي على معادن نادرة)",
 "無欠": "بِلَا عَيْب, خَالٍ مِنَ العُيُوب (خالٍ من أيّ عيب أو شائبة)",
 "無欲": "غَيْر أَنَانِيّ, نَزِيه (ليس جشعاً أو طمّاعاً)",
 "無残": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة)",
 "無段": "غَيْر مُدَرَّج, غَيْر مُرَتَّب (غير منظَّم ترتيباً هرميّاً) / مُتَوَاصِل, مُتَّصِل",
 "無段階": "مُتَوَاصِل, مُتَّصِل",
 "無毒": "غَيْرُ سَامّ (آمن للأكل)",
 "無毒化": "إزالة السموم (علاج للتسمم عن طريق تحييد الخصائص السامة (عادة وظيفة الكبد))",
 "無比": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "無毛": "أَجْرَد",
 "無気": "تَمَامًا / شَقَاوَة, تَعَاسَة",
 "無気力": "لَامُبَالَاة, عَدَم اِكْتِرَاث",
 "無気力状態": "لَامُبَالَاة, عَدَم اِكْتِرَاث",
 "無気味": "عَجِيب, غَرِيب",
 "無気肺": "انخماص الرئة (انهيار رئة متمددة (خاصة عند الرضع)؛ أو فشل الحويصلات الهوائية الرئوية في التوسع…)",
 "無水": "لامائي (بدون ماء؛ خاصة بدون ماء التبلور) / جَدْب, قَاحِل (يفتقر إلى ما يكفي من الماء أو الأمطار)",
 "無水アルコール": "كحول مطلق (كحول إيثيلي نقي (يحتوي على ما لا يزيد عن 1% ماء))",
 "無水ケイ酸": "ثاني أكسيد السيليكون, سيليكا",
 "無水フタル酸": "أنهيدريد الفثاليك (أنهيدريد حلقي أبيض)",
 "無水亜ヒ酸": "ثلاثي أكسيد الزرنيخ, زرنيخ (مسحوق أبيض سام من ثلاثي أكسيد الزرنيخ؛ يستخدم في صناعة الزجاج وكمبيد للآفات (سم…)",
 "無水亜砒酸": "ثلاثي أكسيد الزرنيخ, زرنيخ (مسحوق أبيض سام من ثلاثي أكسيد الزرنيخ؛ يستخدم في صناعة الزجاج وكمبيد للآفات (سم…)",
 "無水物": "أنهيدريد (مركب يتكون من مركب آخر أو أكثر في تفاعل يؤدي إلى إزالة الماء)",
 "無水珪酸": "ثاني أكسيد السيليكون, سيليكا",
 "無水酢酸": "أنهيدريد الأسيتيك (مركب ضروري لتكرير الأفيون وتحويله إلى هيروين)",
 "無汗症": "انحباس العرق, لا تعرق (فشل الغدد العرقية في العمل)",
 "無法": "عَدَم وُجُود قَوَانِين (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف. / بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير)",
 "無法国家": "دولة مارقة (دولة لا تحترم الدول الأخرى في أعمالها الدولية)",
 "無法状態": "عَدَم وُجُود قَوَانِين (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "無法者": "جانٍ, مجرم (شخص ارتكب جريمة أو تمت إدانته قانونياً بجريمة)",
 "無漂白": "غَيْر مَصْبُوغ, غَيْر مُبَيَّض (لم يُلوَّن أو يُبيَّض صناعيًّا)",
 "無点": "بلا معنى, عبثي (ليس له معنى أو اتجاه أو غرض)\nمثال: مسعى بلا معنى",
 "無為": "بطالة, تسكع (عدم القيام بعمل أو وظيفة)\nمثال: تم التعرف بسرعة على بطلان تقريرهم",
 "無為無聊": "مَلَل, ضَجَر",
 "無煙": "بلا دخان, غير مدخن (ينبعث منه القليل من الدخان أو لا ينبعث منه على الإطلاق)\nمثال: مداخن مصانع بلا دخان",
 "無煙火薬": "بارود عديم الدخان, باليستيت (مادة متفجرة (الاسم التجاري باليستيت) تحترق بدخان قليل نسبيًا؛ تحتوي على…)",
 "無煙炭": "أنتراسيت, فحم حجري صلب (فحم طبيعي صلب يحترق ببطء ويعطي حرارة شديدة)",
 "無現": "لَا مُتَنَاهٍ (كلّيّ وشامل لكلّ شيء)\nمثال: اختبروا قدرته على تحديد مواقع الأشياء في الفضاء",
 "無理": "غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / مُسْتَحِيل / بِالقُوَّة, قَسْرِيّ (مدفوع بالقوّة الجسدية خاصة ضدّ المقاومة) / مُفْرِط, زَائِد",
 "無理からぬ": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "無理くり": "بالإكراه, بالقوة (بطريقة تتضمن استخدام القوة)\nمثال: تذكر مخاطر فرض قيمنا وتحيزاتنا بالقوة",
 "無理じい": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة.",
 "無理ない": "طَبِيعِيّ",
 "無理なく": "بِشَكْل مَنْطِقِيّ",
 "無理のない": "طَبِيعِيّ",
 "無理はない": "طَبِيعِيّ",
 "無理もない": "طَبِيعِيّ",
 "無理やり": "بالإكراه, بالقوة (بطريقة تتضمن استخدام القوة)\nمثال: تذكر مخاطر فرض قيمنا وتحيزاتنا بالقوة",
 "無理圧状": "قَهْر, قَسْر (غَلَبَ وانْتَصَرَ ولم يقدر عليه أحد)",
 "無理強い": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة.",
 "無理往生": "قَهْر, قَسْر (غَلَبَ وانْتَصَرَ ولم يقدر عليه أحد)",
 "無理押し": "جَرَّفَ (أخذ شيئًا وجرفه بعيدًا، أو سحب شيئًا بقوة؛ في : في بعض الحالات، قد تستخدم…)\nمثال: وقف على حافة الجرف.",
 "無理数": "عَدَد غَيْر نِسْبِيّ (عدد حقيقي لا يمكن التعبير عنه كعدد نسبي (كسر))",
 "無理無い": "طَبِيعِيّ",
 "無理無く": "بِشَكْل مَنْطِقِيّ",
 "無理非道": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير)",
 "無産者": "بْرُولِيتَارِيّ",
 "無用": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة. / غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / لا تربطه قرابة, ليس قريباً (غير متصل بقرابة) / مَحْظُور, مَمْنُوع (غَيْر مَسْموح بِهِ بِمُوجَب القانون)",
 "無用の長物": "زيادة لا لزوم لها, عجلة خامسة (شخص أو شيء غير مرغوب فيه وغير مطلوب)",
 "無用心": "خطر, خطير (ينطوي على خطر أو يسببه؛ عرضة للتسبب في الأذى أو الضرر)\nمثال: مجرم خطير",
 "無畏": "انتفاء الخوف, جسارة (سمة عدم الشعور بالخوف)",
 "無病息災": "صحة جيدة, عافية (حالة التمتع بالنشاط والخلو من الأمراض الجسدية أو العقلية)",
 "無症候": "دون السريري (متعلق بمرحلة تطور المرض قبل ظهور الأعراض)",
 "無症状": "دون السريري (متعلق بمرحلة تطور المرض قبل ظهور الأعراض)",
 "無痛": "غَيْر مُؤْلِم (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "無痛症": "تسكين الألم, فقدان الإحساس بالألم (غياب الإحساس بالألم دون فقدان الوعي)",
 "無発酵パン": "خبز الفطير, ماتزو (خبز مسطح هش يؤكل في عيد الفصح اليهودي)",
 "無益": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "無目": "رافدة, عارضة النافذة (قطعة عرضية أفقية عبر نافذة أو تفصل باباً عن نافذة فوقه)",
 "無目的": "بلا هدف, عبثي (لا يظهر أي غرض أو هدف)",
 "無着陸": "رحلة بدون توقف (رحلة تتم دون توقفات وسيطة بين المصدر والوجهة)\nمثال: كم عدد الرحلات بدون توقف إلى دالاس؟",
 "無着陸飛行": "رحلة بدون توقف (رحلة تتم دون توقفات وسيطة بين المصدر والوجهة)\nمثال: كم عدد الرحلات بدون توقف إلى دالاس؟",
 "無矛盾性": "اِتِّسَاق",
 "無知": "جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام.",
 "無知は幸福": "الْجَهْل نَعِيمَهُ, الْجَهْل نِعْمَة",
 "無知は至福である": "الْجَهْل نَعِيمَهُ, الْجَهْل نِعْمَة",
 "無知愚昧": "جاهل, غير مستنير (ليس مستنيراً؛ جاهل)\nمثال: الوسائل التي حفظ بها الرجال غير المستنيرين النظام الاجتماعي غير العادل",
 "無知蒙昧": "جاهل, غير مستنير (ليس مستنيراً؛ جاهل)\nمثال: الوسائل التي حفظ بها الرجال غير المستنيرين النظام الاجتماعي غير العادل",
 "無礼": "فجاجة, قلة أدب (أسلوب وقح ومهين) / فَظّ",
 "無神経": "غير حساس, متبلد الحس (غير مستجيب للمحفزات الجسدية)\nمثال: غير حساس للإشعاع",
 "無神者": "مُلْحِد, مُلْحِدَة",
 "無神論": "إِلْحَاد",
 "無神論者": "مُلْحِد, مُلْحِدَة",
 "無私": "غَيْر أَنَانِيّ, نَزِيه (ليس جشعاً أو طمّاعاً)",
 "無私無欲": "إِيثَار, غَيْرِيَّة",
 "無秩序": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل)",
 "無税": "مُعْفًى مِنَ الرُّسُوم (مُعْفًى مِنَ الرُّسُومِ الجُمْرُكِيَّة)",
 "無税品": "مُعْفًى مِنَ الرُّسُوم (مُعْفًى مِنَ الرُّسُومِ الجُمْرُكِيَّة)",
 "無稽": "لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "無窮": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ…)\nمثال: سأحبك إلى الأبد.",
 "無窮動": "حركة أبدية (حركة تستمر إلى أجل غير مسمى دون أي مصدر خارجي للطاقة؛ مستحيلة عملياً بسبب…)",
 "無窮花": "ختمية سورية, ورد شارون (شجيرة آسيوية أو شجرة شجيرية صغيرة ذات زهور وردية أو أرجوانية أو بيضاء مبهرجة…)",
 "無筆": "أُمِّيَّة",
 "無節操": "عَدِيم المَبَادِئ (يفتقر إلى النزاهة أو المبادئ الأخلاقيَّة)\nمثال: التحرر من الافتراء الفظ غير المبدئي",
 "無籍者": "تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر)",
 "無粋": "بَذِيء / غَلِيظٌ, فَظٌّ (سيئ السلوك وخشن ومحتقر في التصرف أو المظهر)",
 "無精": "بُطْء",
 "無精ひげ": "شُعَيْرَات اللِّحْيَة",
 "無精者": "انحناء, ترهل (انحناء القامة عند الوقوف والمشي)\nمثال: إنه ليس متكاسلاً عندما يتعلق الأمر بالبيسبول",
 "無精髭": "شُعَيْرَات اللِّحْيَة",
 "無糖": "خال من السكر (لا يحتوي على السكر)",
 "無糸分裂": "انقسام مباشر, لا تفتلي (الطريقة المباشرة لانقسام الخلية التي تتميز بالانقسام البسيط للنواة دون تكوين…)",
 "無終": "ديمومة, لا نهائية (خاصية كونه (أو يبدو أنه) بلا نهاية)",
 "無給": "بلا أجر, غير مدفوع (لم يتم الدفع له)\nمثال: أجور غير مدفوعة",
 "無統制": "خارج عن السيطرة, غير منضبط (غير خاضع للسيطرة؛ خارج السيطرة)\nمثال: أكبر مشكلة صحية غير مسيطر عليها هي الإيدز",
 "無線": "رَادْيُو, رَادِيُو / لَاسِلْكِيّ",
 "無線ラン": "شبكة محلية لاسلكية, واي فاي (شبكة محلية تستخدم إشارات راديو عالية التردد لإرسال واستقبال البيانات عبر مسافات…)",
 "無線周波": "تَرَدُّد رَادْيَوِيّ (تردد موجة كهرومغناطيسية بين الصوتية والأشعة تحت الحمراء)",
 "無線周波数": "تَرَدُّد رَادْيَوِيّ (تردد موجة كهرومغناطيسية بين الصوتية والأشعة تحت الحمراء)",
 "無線家": "عامل لاسلكي, مشغل راديو (شخص يقوم بتشغيل جهاز إرسال لاسلكي)",
 "無線局": "مَحَطَّة إِذَاعِيَّة",
 "無線標識": "منارة لاسلكية (محطة إذاعية تبث إشارة توجيهية لأغراض الملاحة)",
 "無線機": "رَادْيُو, رَادِيُو",
 "無線電話": "هاتف راديوي, هاتف لاسلكي (هاتف يتصل عبر موجات الراديو بدلاً من الكابلات)",
 "無線ＬＡＮ": "شبكة محلية لاسلكية, واي فاي (شبكة محلية تستخدم إشارات راديو عالية التردد لإرسال واستقبال البيانات عبر مسافات…)",
 "無縁": "لا تربطه قرابة, ليس قريباً (غير متصل بقرابة)",
 "無縁墓地": "مقبرة الغرباء (مقبرة للأشخاص المجهولين أو المعوزين)",
 "無罪": "بَرَاءَة",
 "無罪判決": "تَبْرِئَة",
 "無罪放免": "تَبْرِئَة",
 "無署名": "غير موقع (يفتقر إلى التوقيع)\nمثال: الرسالة كانت مطبوعة وغير موقعة",
 "無義道": "وحشية",
 "無考え": "غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين)\nمثال: تحول النقاش إلى مشاحنات طائشة",
 "無聊": "مَلَل, ضَجَر / ساخط, غير راضٍ (يظهر أو يمر بعدم الرضا أو الشوق القلق)\nمثال: رأى العديد من الوجوه الساخطة في الغرفة",
 "無職": "مُتَبَطِّل, مُتَبَطِّلَة",
 "無職者": "عاطل عن العمل (شخص بلا وظيفة)",
 "無能": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات) / عاجز, غير كفء (شخص ليس لديه الكفاءة لاتخاذ إجراءات فعالة)",
 "無能力": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات)",
 "無能力者": "عاجز, غير كفء (شخص ليس لديه الكفاءة لاتخاذ إجراءات فعالة)",
 "無能者": "عَاجِز, غَيْر مُؤَهَّل (لا يستوفي المتطلّبات اللازمة)\nمثال: جهاز مخابرات غير كفء",
 "無脂肪": "خالٍ من الدسم, منزوع الدسم (بدون دهون أو مواد صلبة دهنية)\nمثال: حليب خالٍ من الدسم",
 "無脂肪乳": "حَلِيب خَالِي الدَسَم (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب…)\nمثال: كنت أشرب الحليب",
 "無脂肪牛乳": "حَلِيب خَالِي الدَسَم (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب…)\nمثال: كنت أشرب الحليب",
 "無脊椎動物": "لَا فَقَارِيّ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "無脚": "عَدِيمُ القَوَائِم ((عَنِ الأَفَاعِي وَالأَنْقَلَيْسِ) بِلَا أَقْدَامٍ بِطَبِيعَتِهِ)",
 "無脾症": "اِنْعِْدَام الطِحَال",
 "無脾症候群": "اِنْعِْدَام الطِحَال",
 "無腕症": "انعدام الذراعين (حالة عدم وجود أذرع)",
 "無腰": "أَعْزَل",
 "無自覚": "غَافِل, غَيْر مُدْرِك ((غالباً يتبعه 'بـ') غير مدرك)\nمثال: بدا غافلاً عن التدقيق",
 "無臭": "عديم الرائحة (ليس له رائحة)\nمثال: غاز عديم الرائحة",
 "無色": "بَاهِت, عَدِيم اللَّوْن (ضعيف في اللون؛ غير زاهي الألوان)\nمثال: شخص باهت وغير خيالي / مُحَايِد\nمثال: هذه هي نقطة ضعفه.",
 "無花果": "تين, تين شائع (شجرة متوسطية تُزرع على نطاق واسع لثمارها الصالحة للأكل) / تِين, بَلَس",
 "無花果果": "تِين, بَلَس",
 "無花果状果": "تِين, بَلَس",
 "無茶無茶": "بشكل رهيب, جداً (تستخدم للتوكيد)\nمثال: مثير للاهتمام جداً",
 "無菌": "مُعَقَّم (جُعِلَ عَقِيمًا بِإِجْرَاء طِبِّيّ)",
 "無菌性": "خَالٍ مِنَ الجَرَاثِيم, مُعَقَّم (خالٍ من الكائنات الدقيقة المُمرضة أو يستخدم طرقًا لمنعها)",
 "無菌法": "تطهير, تعقيم (عملية تثبيط نمو وتكاثر الكائنات الحية الدقيقة)",
 "無蓋": "مَفْتُوح\nمثال: فتح الباب آليا.",
 "無血": "أَبْيَض كَالمَوْت, فَاقِد الدَّم (خالٍ من الدم أو يبدو كذلك)\nمثال: جراحة غير دموية",
 "無表情": "جَامِدُ المَلَامِح, عَدِيمُ التَّعْبِير (متعمّد عدم إظهار أيّ تعبير أو انفعال على وجهه)",
 "無規律": "غَيْرُ مُنْضَبِط, فَاقِدُ الانْضِبَاط (يَفْتَقِرُ إِلَى الانْضِبَاطِ أَوِ السَّيْطَرَة)",
 "無視": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "無観客": "خلف الأبواب المغلقة (بَدَلَ، أَعْقَبَ؛ أَتَى بعده أو جاء مكانه)\nمثال: دار زيري للخلف.",
 "無角": "أَجْلَح",
 "無角類": "حَيَوَان عَنْكَبُوتِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي…)\nمثال: هذا حيوان أليف.",
 "無言": "صَمْت, سُكُوت",
 "無言劇": "بانتوميم, تمثيل صامت (أداء يستخدم الإيماءات وحركات الجسم بدون كلمات)",
 "無言症": "بكم, خرس (حالة عدم القدرة أو عدم الرغبة في التحدث)\nمثال: كان خرسه نتيجة لصممه",
 "無計画": "غَيْر مُتْقَن, مُرْتَجَل (يَتَّسِم بِالإِهْمَال الشَّدِيد وعَدَم الدِّقَّة)\nمثال: كان رئيس الوزراء يرتدي بدلة رمادية وقميصاً أبيض بياقة ناعمة، لكن رقبته أصبحت أنحف والياقة تبتعد عنها كما لو تم شراؤها عشوائياً",
 "無記名": "غير موقع (يفتقر إلى التوقيع)\nمثال: الرسالة كانت مطبوعة وغير موقعة",
 "無記名投票": "اقتراع سري (تصويت يكون فيه اختيار كل شخص سريًا ولكن إجمالي الأصوات علني)",
 "無記名株": "سهم لحامله (سهم لا يحتوي على معلومات الملكية ويفترض أن حامله المادي هو المالك)\nمثال: الأسهم لحاملها محظورة في بعض البلدان بسبب احتمال إساءة استخدامها",
 "無許可": "غَيْر مُخَوَّل, غَيْر مُصَرَّح بِه (غير ممنوح السلطة)",
 "無認識": "غَيْر مَعْرُوف, غَيْر مُعتَرَف بِه (لم يُتعرَّف عليه أو يُقَرّ به)",
 "無調": "لا نغمية (غياب السلم الموسيقي؛ بديل للنظام الدياتوني)",
 "無調整": "غَيْر مَضْبُوط, غَيْر مُعَدَّل (لم يتم تغييره ليتناسب مع متطلبات معينة)\nمثال: رقم غير معدل بنسبة 8.5 في المائة",
 "無調整豆乳": "حَلِيب صُويَا (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب…)\nمثال: كنت أشرب الحليب",
 "無調法": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / خطأ فادح, زلة (خطأ محرج)",
 "無論": "طَبْعًا",
 "無謀": "مُتَهَوِّر",
 "無謬": "عِصْمَة",
 "無警察": "فَوْضَى, فَوْضَوِيَّة",
 "無責任": "اِنْعِدام مَسْؤُولِيَّة",
 "無賃": "مَجَّانِيّ, مَجَّانًا",
 "無資格": "غير مؤهل, غير مختص قانونياً (غير مؤهل أو غير كافٍ قانونياً)\nمثال: تعتبر الزوجة عادة غير مؤهلة للشهادة ضد زوجها",
 "無資格者": "عَاجِز, غَيْر مُؤَهَّل (لا يستوفي المتطلّبات اللازمة)\nمثال: جهاز مخابرات غير كفء",
 "無趣味": "رَتِيب, مُمِلّ (مكرّر بشكل مملّ أو يفتقر إلى التنوّع)\nمثال: لم يعتد أبداً على رتابة عمله / عديم الذوق, مبتذل (يفتقر إلى الذوق الجمالي أو الاجتماعي)",
 "無足類": "ضفدع ثعباني (أي من البرمائيات الصغيرة النحيلة عديمة الأطراف الحفارة التي تشبه الديدان؛ تعيش…)",
 "無軌条電車": "ترولي باص, حافلة كهربائية (حافلة ركاب بمحرك كهربائي تستمد الطاقة من أسلاك علوية)",
 "無軌道": "بِلَا مَسَالِك, وَعْر (يفتقر إلى الممرّات والطرق المعبَّدة)\nمثال: حافلة ترولي بلا مسار (سكة) / مُتَهَوِّر",
 "無辜": "بَرِيء, بَرِيئَة",
 "無農薬": "عُضْوِيّ",
 "無辺": "لَا مُتَنَاهٍ (كلّيّ وشامل لكلّ شيء)\nمثال: اختبروا قدرته على تحديد مواقع الأشياء في الفضاء",
 "無辺際": "لَا مُتَنَاهٍ (كلّيّ وشامل لكلّ شيء)\nمثال: اختبروا قدرته على تحديد مواقع الأشياء في الفضاء",
 "無造作": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل)",
 "無過失": "تنزه عن الخطأ, عصمة (صفة الإعفاء من الخطيئة أو عدم القدرة على ارتكابها)",
 "無道": "غَيْر إِنْسَانِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "無遠慮": "فَظّ",
 "無邪気": "بَرِيء, بَرِيئَة / بَرِيء, شَفَّاف (خالٍ من المكر والخداع) / غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين)\nمثال: تحول النقاش إلى مشاحنات طائشة",
 "無配慮": "غير مراعٍ, مستهتر (يفتقر إلى الاهتمام بحقوق أو مشاعر الآخرين)\nمثال: سلوك مستهتر بشكل صادم",
 "無酸素": "لَا هَوَائِيّ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "無酸素運動": "بناء العضلات, تمرين لاهوائي (تمرين يبني العضلات من خلال التوتر والمقاومة)",
 "無釉": "غير لامع, غير مصقول (ليس له طبقة لامعة)\nمثال: ورق غير مصقول",
 "無重力": "انعدام الوزن, خفة (خاصية كون الشيء صغير الوزن نسبياً)\nمثال: خفة خشب البالسا",
 "無重力状態": "انعدام الوزن, خفة (خاصية كون الشيء صغير الوزن نسبياً)\nمثال: خفة خشب البالسا",
 "無重量": "انعدام الوزن, خفة (خاصية كون الشيء صغير الوزن نسبياً)\nمثال: خفة خشب البالسا",
 "無量": "لَا يُقَاسُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "無鉛": "خالٍ من الرصاص (غير معالج بالرصاص)\nمثال: بنزين خالٍ من الرصاص",
 "無銘": "غير موقع (يفتقر إلى التوقيع)\nمثال: الرسالة كانت مطبوعة وغير موقعة",
 "無錫": "وُوشِي",
 "無間": "استمرارية, تواصل (صفة الشيء الذي يستمر بلا نهاية أو انقطاع)",
 "無関係": "لا تربطه قرابة, ليس قريباً (غير متصل بقرابة)",
 "無関心": "لَا مُبَالٍ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "無闇": "إفراط, عدم اعتدال (جودة كون الشيء مفرطاً ومفتقراً للاعتدال)",
 "無防備": "أَعْزَل",
 "無降水": "جَفَاف",
 "無限": "أبدية, خلود (زمن بلا نهاية) / لَا مُتَنَاهٍ (كلّيّ وشامل لكلّ شيء)\nمثال: اختبروا قدرته على تحديد مواقع الأشياء في الفضاء",
 "無限ループ": "حلقة مغلقة, نظام الحلقة المغلقة (نظام تحكم ذو حلقة تغذية مرتدة نشطة)",
 "無限大": "أبدية, خلود (زمن بلا نهاية)",
 "無限定": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)",
 "無限小": "مُتَنَاهٍ فِي الصِّغَر (صغير بشكل لا نهائي أو لا يُقاس)",
 "無限数列": "متتالية لا نهائية (تتابع غير محدود لعناصر مرتبة بترتيب معين)",
 "無限軌道": "جنزير, مسار كاتربيلر (حزام معدني لا نهائي تتحرك عليه المركبات المجنزرة فوق الأرض)",
 "無限連鎖講": "مخطط هرمي (مخطط احتيالي يتم فيه تجنيد أشخاص لدفع مدفوعات للشخص الذي جندهم بينما يتوقعون…)",
 "無雑": "صَافٍ, اَلصَّافِي",
 "無難": "أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين. / مَقْبُول, مُرْضٍ (جدير بالقبول أو مرضٍ)\nمثال: مستويات مقبولة من الإشعاع",
 "無電": "لَاسِلْكِيّ",
 "無音": "صَمْت, سُكُوت",
 "無韻詩": "شعر مرسل (شعر غير مقفى (عادة في البحر الخماسي اليامبي))",
 "無響室": "غرفة عديمة الصدى (غرفة ذات صدى ضئيل جداً)",
 "無頓着": "غَيْرُ آبِهٍ, لَامُبَالٍ (لَا يُظْهِرُ أَيَّ اهْتِمَامٍ أَوْ عِنَايَةٍ فِي مَوْقِفِهِ أَوْ تَصَرُّفِهِ)",
 "無頼": "شِرِّير (الكَثير الشَرّ بمعنى اسم جامع للرذائل، قد يستعمل كاسم فاعل؛ ضد الخَيِّر؛ يستخدم…)\nمثال: لقد وصف سامي ليلى كشخص شرير إلى حد يكاد لا يصدق. / مُسْتَقِل, حُرّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
 "無頼漢": "بلطجي, فتوة (رجل قاسٍ ووحشي)",
 "無顆粒球症": "ندرة المحببات (اضطراب دموي حاد يتميز بانخفاض حاد في الخلايا المحببة)",
 "無題": "بِلَا لَقَب, غَيْر نَبِيل (لا ينتمي إلى طبقة النبلاء)",
 "無額面株": "أسهم بدون قيمة اسمية (أسهم ليس لها قيمة اسمية محددة في ميثاق الشركة أو على شهادة الأسهم)",
 "無額面株式": "أسهم بدون قيمة اسمية (أسهم ليس لها قيمة اسمية محددة في ميثاق الشركة أو على شهادة الأسهم)",
 "無顎類": "لا فكيات (فقاري يشبه الثعبان بدون فكوك أو زوائد مزدوجة بما في ذلك دائريات الفم وبعض…)",
 "無類": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "無風": "بِلَا رِيَاح, سَاكِن الرِّيح (بِدُون رِيَاح أَوْ بِرِيَاحٍ شِبْه مَعْدُومَة) / صَامِت, هَادِئ",
 "無風流": "خشن, غير مهذب ((للأشخاص وسلوكهم) غير مهذب؛ فظ)\nمثال: كيف يمكن لفتاة مهذبة أن تنجذب لرجل خشن كهذا؟",
 "無食": "تعذر البلع, لا بلع (فقدان القدرة على البلع)",
 "無食欲": "قَهَم",
 "無香料": "غَيْرُ مُنَكَّه (بِدُونِ إِضَافَةِ مُنَكِّهَات)",
 "無駄": "مُبَدِّد, مُخَرِّب (يُحْدِثُ الخَرَابَ وَالدَّمَارَ)",
 "無駄にする": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "無駄のない": "اقْتِصَادِيّ, مُوَفِّر (يستخدم الحدّ الأدنى من الوقت أو الموارد اللازمة للفاعلية)\nمثال: نمو اقتصادي",
 "無駄の無い": "اقْتِصَادِيّ, مُوَفِّر (يستخدم الحدّ الأدنى من الوقت أو الموارد اللازمة للفاعلية)\nمثال: نمو اقتصادي",
 "無駄口": "هَذَى",
 "無駄言": "هَذَى",
 "無駄話": "ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة)",
 "無駄遣い": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "無駄飯喰い": "شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "無駄飯喰らい": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "無駄飯食い": "شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "無駄飯食らい": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "無骨": "غَلِيظٌ, فَظٌّ (سيئ السلوك وخشن ومحتقر في التصرف أو المظهر)",
 "無骨一徹": "رَيْفِيّ, قَرَوِيّ",
 "無骨者": "عديم التربية, فظ (شخص فظ غير مهذب يفتقر للثقافة أو الرقي)",
 "無髯": "أَمْرَد",
 "焦がす": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف…)\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "焦がれる": "طَوِيل",
 "焦げ": "بشكل حارق, بلهيب (قادر على إحداث حروق (تستخدم عادة لوصف شدة الحرارة))\nمثال: كان الجو حاراً بشكل حارق",
 "焦げる": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف…)\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "焦げ付き": "ديون معدومة, ديون هالكة (دين من غير المرجح سداده)",
 "焦げ目": "أثر حرق, حرق (مكان أو منطقة تم حرقها (خاصة على جسم الشخص))",
 "焦げ茶": "بني زيتوني (درجة من البني مشوبة بالأخضر)",
 "焦げ茶色": "بني زيتوني (درجة من البني مشوبة بالأخضر)\nمثال: 彼はこげ茶色の髪をしていた。 — كانَ لديه شعرٌ بُنِّيٌّ غامق.",
 "焦げ跡": "أثر حرق, حرق (مكان أو منطقة تم حرقها (خاصة على جسم الشخص))",
 "焦らす": "إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات…)\nمثال: تجاهل تهكمهم",
 "焦り": "نَفَاد صَبْر",
 "焦る": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة…)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران / ذُعْر, رُعْب ((ذَعَرَه) ذعرا: خَوّفه وأفزعه)\nمثال: أصيب سامي بالذعر.",
 "焦れったい": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "焦れる": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة…)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران",
 "焦土": "سِيَاسَةُ الأَرْضِ المَحْرُوقَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب…)\nمثال: عاد إلى السياسة.",
 "焦心": "نَفَاد صَبْر",
 "焦心苦慮": "تَمَلْمَلَ",
 "焦思": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)",
 "焦性葡萄酸": "حمض البيروفيك (حمض عديم اللون يتكون كمركب وسيط مهم في التمثيل الغذائي أو التخمير)",
 "焦慮": "نَفَاد صَبْر",
 "焦点": "بُؤْرَة",
 "焦点をあてる": "بُؤْرَة",
 "焦点を合わせる": "بُؤْرَة",
 "焦点を当てる": "بُؤْرَة",
 "焦点を絞る": "رَكَّزَ (وضع الشيء بثبات في مكانه؛ أثبت الشيء أو ثبّتَه، وخاصة في مكان محدد)\nمثال: فقط ركز يا زيري.",
 "焦点距離": "بُعْد بُؤْرِيّ, مَسَافَة بُؤْرِيَّة (المسافة من العدسة إلى بؤرتها)",
 "焦熱地獄": "جَحِيم, جَهَنَّم",
 "焦燥": "نَفَاد صَبْر",
 "焦燥感": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "焦眉": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "焦茶": "بني زيتوني (درجة من البني مشوبة بالأخضر)",
 "焦電気": "كهرباء حرارية (توليد شحنة كهربائية على بلورات معينة (مثل التورمالين) نتيجة لتغير في درجة…)",
 "焮衝": "اِلْتِهَاب",
 "然": "كَـ / فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / هَٰكَذَا, كَذَا / بل, نعم (ليس ذلك فحسب، بل)\nمثال: أنا بذلك أفرح، بل وسأفرح",
 "然あらぬ": "سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل)",
 "然こそ": "بِالتَّأْكِيد",
 "然したる": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "然して": "بشكل خاص, تحديداً (بدرجة أكبر بوضوح مما هو شائع)\nمثال: كان دقيقاً بشكل خاص حول التهجئة",
 "然しも": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "然せる": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "然のみ": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "然のみならず": "أَيْضًا, كَذٰلِكَ",
 "然も": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه…)\nمثال: هو اغضبني حقا . / فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "然もあらばあれ": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "然もないと": "خِلَافَ, خِلَافَ ذَلِك",
 "然もなくば": "خِلَافَ, خِلَافَ ذَلِك",
 "然もなければ": "خِلَافَ, خِلَافَ ذَلِك\nمثال: 急ぎなさい、さもなければ遅れますよ。 — أسرع، وإلا فإنك ستتأخر.",
 "然も無いと": "خِلَافَ, خِلَافَ ذَلِك",
 "然も無くば": "خِلَافَ, خِلَافَ ذَلِك",
 "然も無ければ": "خِلَافَ, خِلَافَ ذَلِك\nمثال: 急ぎなさい、さもなければ遅れますよ。 — أسرع، وإلا فإنك ستتأخر.",
 "然らずとも": "بِالرَغْم مِن",
 "然らずば": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "然らずんば": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "然らば": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "然り": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "然りげ": "هَٰكَذَا, كَذَا",
 "然りげに": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية)\nمثال: ألقى نظرة غير مبالية على العناوين",
 "然りながら": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "然り乍ら": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "然り気": "هَٰكَذَا, كَذَا",
 "然る": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "然るに": "بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال",
 "然るべき": "سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته)\nمثال: علاج طبي مناسب",
 "然るべく": "بشكل لائق, بشكل مناسب (بما يتوافق مع ما هو مناسب أو ملائم للظروف)\nمثال: كان يرتدي ملابس مناسبة",
 "然るを": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "然る上は": "بِمَا أَنّ, أَمَا وَأَنّ",
 "然る可き": "سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته)\nمثال: علاج طبي مناسب",
 "然る可く": "بشكل لائق, بشكل مناسب (بما يتوافق مع ما هو مناسب أو ملائم للظروف)\nمثال: كان يرتدي ملابس مناسبة",
 "然る後": "بعد ذلك, منذ ذلك الحين (من ذلك الوقت فصاعداً)\nمثال: بعد ذلك لم يتصل أبداً مرة أخرى",
 "然る者": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "然れど": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)",
 "然れども": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "然れば": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي. / بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك)\nمثال: يريد الزواج من رئيس الخدم؟ حقاً! / إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي. / بِالْمُنَاسَبَةِ, عَلَى فِكْرَةٍ",
 "然ればこそ": "يَعْنِي, أَي / بالتأكيد, حتماً (بشكل قاطع أو إيجابي)\nمثال: النتائج مشجعة بالتأكيد",
 "然上は": "بِمَا أَنّ, أَمَا وَأَنّ",
 "然有らぬ": "سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل)",
 "然様": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك)\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "然然": "إلخ, وما إلى ذلك (الاستمرار بنفس الطريقة)",
 "然程": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب)",
 "然諾": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع)\nمثال: السكوت علامة الرضا.",
 "焼": "تحميص, شوي (طهي (اللحم) بحرارة جافة في فرن (عادة مع إضافة دهن))\nمثال: استغرق التحميص البطيء عدة ساعات / تطبيع, تلدين (تقسية شيء ما بالمعالجة الحرارية) / خَزَف (خَزَفَ في مَشْيه يَخْزِفُ خَزْفًا: رفع يدَه ووَضعها؛ خَزَفَ الثوبَ: خَرَقه…)",
 "焼い弾": "قنبلة حارقة (قنبلة مصممة لإشعال الحرائق؛ وهي أكثر فعالية ضد الأهداف القابلة للاشتعال (مثل…)",
 "焼き": "تحميص, شوي (طهي (اللحم) بحرارة جافة في فرن (عادة مع إضافة دهن))\nمثال: استغرق التحميص البطيء عدة ساعات / تطبيع, تلدين (تقسية شيء ما بالمعالجة الحرارية)",
 "焼きあげる": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف…)\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "焼きごて": "مِكْوَاةُ اللَّحَّام, كاوِيَةُ اللَّحَّام / عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "焼きすぎる": "طباعة فوقية (شيء مضاف عن طريق الطباعة الفوقية)",
 "焼きつき": "إمساك, قبض (فعل الإمساك بشيء بإحكام باليدين)",
 "焼きつける": "خَبَزَ (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو…)\nمثال: هذا الخبز لذيذ. / تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة! / عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "焼きなおす": "اجترار, تكرار (مادة قديمة تم إعادة صياغتها قليلاً واستخدامها مرة أخرى)\nمثال: مجرد اجترار ممل لروايته الأولى",
 "焼きなまし": "تطبيع, تلدين (تقسية شيء ما بالمعالجة الحرارية)",
 "焼きふ": "غلوتين القمح (غلوتين محضر من القمح)",
 "焼きもち": "حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "焼きを入れる": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "焼き上げる": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف…)\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "焼き串": "سيخ (دبوس طويل لتثبيت اللحم في موضعه أثناء شيه)",
 "焼き付き": "إمساك, قبض (فعل الإمساك بشيء بإحكام باليدين)",
 "焼き付け": "طِبَاعَة / صقل, طلاء زجاجي (طلاء للسيراميك والمعدن وما إلى ذلك)",
 "焼き付ける": "خَبَزَ (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو…)\nمثال: هذا الخبز لذيذ. / تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية) / طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة! / عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "焼き入れ": "إخماد, إطفاء (فعل الإطفاء؛ التسبب في توقف الاحتراق)\nمثال: إطفاء الأنوار",
 "焼き印": "عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "焼き印を押す": "عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "焼き型": "قَالِب\nمثال: هم في نفس السن.",
 "焼き場": "محرقة الجثث (فرن حيث يمكن حرق الجثة وتحويلها إلى رماد)",
 "焼き戻し": "تطبيع, تلدين (تقسية شيء ما بالمعالجة الحرارية)",
 "焼き物": "فَخَّار, خَزَف\nمثال: هذا البلد مدعوم بالصناعة.",
 "焼き目": "حَارِق, لَاذِع (شديد القسوة في النقد)",
 "焼き目をつける": "بُنِّيّ (هو لون ينتمي لمجموعة الألوان الحارة. وكلمة بني نسبة للبن (قهوة))\nمثال: توم من بني البشر.",
 "焼き目を付ける": "بُنِّيّ (هو لون ينتمي لمجموعة الألوان الحارة. وكلمة بني نسبة للبن (قهوة))\nمثال: توم من بني البشر.",
 "焼き直し": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "焼き直す": "اجترار, تكرار (مادة قديمة تم إعادة صياغتها قليلاً واستخدامها مرة أخرى)\nمثال: مجرد اجترار ممل لروايته الأولى",
 "焼き石膏": "جص, جص باريس (أي من أسمنتات الجبس المختلفة؛ مسحوق أبيض (شكل من أشكال كبريتات الكالسيوم) يشكل…)",
 "焼き窯": "فُرْن, تَنُّور",
 "焼き絵": "رسم بالحرق (تصميم يتم إنتاجه عن طريق الحرق على الخشب أو الجلد)",
 "焼き網": "ملعب كرة قدم أمريكية (ملعب اللعب الذي تُلعب عليه كرة القدم الأمريكية)",
 "焼き肉": "شواية",
 "焼き芋屋": "بَطَاطَا حُلْوَة",
 "焼き豚": "شواء خنزير (قطعة من لحم الخنزير مناسبة للتحمير)",
 "焼き過ぎる": "طباعة فوقية (شيء مضاف عن طريق الطباعة الفوقية)",
 "焼き金": "مِيسَم",
 "焼き鈍し": "تطبيع, تلدين (تقسية شيء ما بالمعالجة الحرارية)",
 "焼き鍋": "قِدْر, طَنْجَرَة (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "焼き鏝": "مِكْوَاةُ اللَّحَّام, كاوِيَةُ اللَّحَّام / عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "焼き飯": "أرز صيني مقلي, أرز مقلي (أرز مسلوق مخلوط بالبصل الأخضر ولحم الخنزير المفروم أو الجمبري ومخفوق بسرعة مع…)",
 "焼き餅": "حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "焼き麩": "غلوتين القمح (غلوتين محضر من القمح)",
 "焼き麸": "غلوتين القمح (غلوتين محضر من القمح)",
 "焼く": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف…)\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري. / شَوَى, صَلَى / حَرَارَة (السخونة والحماوة؛ شدة العَطَش)\nمثال: حرارة الطقس تتزايد. / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "焼けこげ": "حرق سطحي, شياط (تغير في اللون ناتج عن الحرارة)",
