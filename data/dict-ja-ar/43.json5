 "編集者": "مُحَرِّر (مُعْتِق؛ مُطْلِق الحُرِّيَّات ، المُنْقِد من احْتِلال أجْنبي ، من اسْتِعباد) / مُحَرِّر, مُحَرِّرَة (مُعْتِق؛ مُطْلِق الحُرِّيَّات ، المُنْقِد من احْتِلال أجْنبي ، من اسْتِعباد)\nمثال: محرر هذا المقال ناقد مشهور.",
 "編集部": "قسم التحرير (قسم في دار نشر يقوم بتحرير المواد للنشر)",
 "緩い": "فَضْفَاض, واسِع / لَيِّن, مُتَسَاهِل (يتّسم بالتسامح والرحمة في التعامل) / لَيِّن, مُتَسَاهِل (غَيْرُ صَارِمٍ فِي تَطْبِيقِ القَوَاعِد) / لَيِّن, مُتَسَامِح (متسامح ورحيم في المعاملة) / مُؤَدَّب / بَطِيء / أَبْطَأَ, بَطَّأَ",
 "緩か": "فَضْفَاض, واسِع / مُؤَدَّب / لَيِّن, مُتَسَاهِل (يتّسم بالتسامح والرحمة في التعامل) / لَيِّن, مُتَسَاهِل (غَيْرُ صَارِمٍ فِي تَطْبِيقِ القَوَاعِد) / لَيِّن, مُتَسَامِح (متسامح ورحيم في المعاملة)",
 "緩み": "مُتَرَاخٍ, مُتَسَاهِل (يَفْتَقِر إِلَى الصَّرَامَة أَوِ الدِّقَّة) / بَطِيء الجَرَيَان (يسيل بسرعة ضئيلة كما عند تحوُّل المدّ) / فَضْفَاض, مُرْتَخٍ (غَيْرُ مَشْدُودٍ وَلَا مُتَوَتِّر) / الجزء المرتخي (حبل أو خيط أو كابل يتدلى باسترخاء)\nمثال: قام بسحب الجزء المرتخي",
 "緩む": "اِسْتَرْخَى / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "緩める": "أَرْخَى, حَلَّ / اِسْتَرْخَى / قَلَّلَ",
 "緩やか": "فَضْفَاض, واسِع / مُؤَدَّب / لَيِّن, مُتَسَاهِل (يتّسم بالتسامح والرحمة في التعامل) / لَيِّن, مُتَسَاهِل (غَيْرُ صَارِمٍ فِي تَطْبِيقِ القَوَاعِد) / لَيِّن, مُتَسَامِح (متسامح ورحيم في المعاملة)",
 "緩り": "بتأن, بدون عجلة (بدون تسرع)\nمثال: مضت بتأن",
 "緩下剤": "مُلَيّن",
 "緩下薬": "مُلَيّن",
 "緩叙法": "إثبات بالنفي, تورية (تهوين للتأثير البلاغي (خاصة عند التعبير عن الإيجاب بنفي ضده))\nمثال: قول 'لم أكن منزعجاً قليلاً' عندما تقصد 'كنت منزعجاً جداً' هو مثال على الإثبات بالنفي",
 "緩和": "رَاحَة, تَخْفِيف / نَقْش نَافِر (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "緩和ケア": "رِعَايَة تَلْطِيفِيَّة",
 "緩和剤": "مُلَطِّف, مُخَفِّف",
 "緩和医療": "رِعَايَة تَلْطِيفِيَّة",
 "緩和時間": "وقت الاسترخاء (ثابت الزمن لعودة النظام الأسية إلى التوازن بعد حدوث اضطراب)",
 "緩和法": "طريقة الاسترخاء (طريقة لحل المعادلات الآنية عن طريق تخمين حل ثم تقليل الأخطاء الناتجة عن طريق التقريبات المتتالية)",
 "緩徐曲": "بِبُطْء / أداجيو (جزء بطيء من رقصة ثنائية (با دو دو) يتطلب مهارة وقوة كبيرة من الراقصين) / أَدَاجْيُو ((في الإيقاع الموسيقيّ) مُتَمَهِّل وَهَادِئ) / أداجيو, حركة بطيئة ((موسيقى) تكوين يُعزف بإيقاع أداجيو (ببطء ورشاقة))\nمثال: هنا يجب أن تعزف ببطء",
 "緩怠": "تراخ, تسيب (صفة التراخي والإهمال) / ارتخاء, رخاوة (حالة الارتخاء الفسيولوجي)\nمثال: يمكن للحمامات أن تساعد في تخفيف رخاوة الأمعاء",
 "緩急": "خطوة, خطوة واسعة (خطوة في المشي أو الجري) / معدل, وتيرة (السرعة النسبية للتقدم أو التغيير) / ياردة (وحدة للطول تساوي 3 أقدام؛ محددة بـ 91.44 سنتيمتر) / خطوة (المسافة التي تغطيها خطوة)\nمثال: عاش بوتيرة سريعة / طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "緩急記号": "تمبو, سرعة الإيقاع ((موسيقى) السرعة التي ستُعزف بها المقطوعة) / إِيقَاع, وُتَيْرَة (معدل حدث متكرر)",
 "緩急車": "عربة الحارس (العربة في القطار التي يشغلها الحارس)",
 "緩慢": "بَطِيء / أَبْطَأَ, بَطَّأَ / رَخْو, مُرْتَخٍ (يُفَرَّغ بسهولة أو بإفراط) / مُتَرَاخٍ, مُتَسَاهِل (يَفْتَقِر إِلَى الصَّرَامَة أَوِ الدِّقَّة) / رخو, مرتخٍ (يفتقر إلى الحزم أو الشد؛ غير مشدود) / رخو (صوتياً) (يُنطق بعضلات لسان وفك مرتخية نسبيًا)",
 "緩歩動物": "بطيء الخطو, دب الماء (مفصلي من شعبة بطيئات الخطو)",
 "緩衝": "بطانة, حشوة (قطعة مصنوعة من مادة ناعمة أو مرنة تستخدم للملء أو إعطاء الشكل أو الحماية أو إضافة الراحة)",
 "緩衝器": "مُمْتَصّ صَدَمَات",
 "緩衝国": "دولة حاجزة, دولة عازلة (دولة محايدة صغيرة تقع بين قوتين متناحرتين)",
 "緩衝地帯": "منطقة عازلة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "緩衝材": "بطانة, حشوة (قطعة مصنوعة من مادة ناعمة أو مرنة تستخدم للملء أو إعطاء الشكل أو الحماية أو إضافة الراحة)",
 "緩衝液": "محلول منظم, محلول واق (محلول يحتوي على مادة منظمة (بفر))",
 "緩衝緑地": "حزام أخضر (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر)\nمثال: هذا حزام من الجلد.",
 "緩衝装置": "أداة تلميع, صاقلة (أداة تتكون من مادة ناعمة مثبتة على كتلة؛ تستخدم للتلميع (كما في تجميل الأظافر)) / مخمّد صدمات, مصدّ (جهاز يشبه الوسادة يقلل من الصدمة الناتجة عن الارتطام) / آلة تلميع, ملمّع (أداة كهربائية تستخدم لتلميع الأسطح) / ذاكرة مؤقتة, مخزن مؤقت ((علم الحاسوب) جزء من ذاكرة الوصول العشوائي يستخدم للتخزين المؤقت للبيانات التي تنتظر إرسالها إلى جهاز؛ يستخدم لتعويض الاختلافات في معدل تدفق البيانات…)",
 "緩衝記憶": "ذاكرة مؤقتة, مخزن مؤقت ((علم الحاسوب) جزء من ذاكرة الوصول العشوائي يستخدم للتخزين المؤقت للبيانات التي تنتظر إرسالها إلى جهاز؛ يستخدم لتعويض الاختلافات في معدل تدفق البيانات…)",
 "緩衝領域": "منطقة عازلة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
