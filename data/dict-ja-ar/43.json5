 "爵": "اللوردات, النبلاء (أقران المملكة (اللوردات) يُعتبرون كمجموعة)",
 "爵位": "اللوردات, النبلاء (أقران المملكة (اللوردات) يُعتبرون كمجموعة)",
 "父": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة. / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب. / بَابَا",
 "父さん": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "父じゃ人": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "父ちゃん": "بَابَا",
 "父なし子": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "父の命": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "父の日": "عِيدُ الْأَب",
 "父上": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "父兄": "وَلِي أَمْر, حَافِظ (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "父君": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "父子草": "شيح لويزيانا, مريمية بيضاء (عشب معمر أبيض قطني من جنوب غرب الولايات المتحدة)",
 "父御": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "父性": "أبوة الفكرة, تأليف (فعل إطلاق فكرة أو نظرية أو كتابة جديدة)\nمثال: تأليف النظرية محل نزاع",
 "父方": "أَبَوِيّ",
 "父権制": "نِظَام أَبَوِيّ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "父殺し": "قتل الأب (قتل الشخص لأبيه)",
 "父母": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في…)\nمثال: ألست والدة توم؟",
 "父無し子": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "父祖": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "父祖伝来": "أَبَوِيّ, مَوْرُوث (مُتوارَث وفق قواعد راسخة (عادة قانونية) للإرث)",
 "父称": "أبوي الاسم, كنيوي (من أو مشتق من اسم شخصي أو عائلي (اسم الأب))",
 "父老": "كَابِر",
 "父親": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "父親らしい": "أَبَوِيّ",
 "父親殺し": "قتل الأب (قتل الشخص لأبيه)",
 "父音": "صَامِت\nمثال: ألف هو الحرف الأول للألف باء.",
 "父馬": "أب, فحل (الوالد الذكر لحيوان، خاصة الحيوانات الأليفة مثل الحصان)\nمثال: حافظوا على إيمان أجدادنا",
 "爺": "شَيْخ, عَجُوز / عجوز, مخضرم",
 "爺が背": "خيتون, عديد الأصداف (رخوي بحري بدائي ممدود متناظر ثنائياً له عباءة مغطاة بثماني صفائح جيرية)",
 "爺さん": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم…)\nمثال: عليك العمل بجد.",
 "爺ちゃん": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم…)\nمثال: عليك العمل بجد.",
 "爺むさい": "خَرِف, هَرِم (ضعيف عقلياً أو جسدياً بسبب الشيخوخة)",
 "爺婆": "مُسِنّ, مُسِنَّة / جَدّ, جَدَّة (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم…)",
 "爻辞": "تَعْلِيق",
 "爽やか": "طَازَج, طَازَة / شَفَّاف",
 "爽快": "مُنْعِش",
 "爾": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / هَٰكَذَا, كَذَا / بل, نعم (ليس ذلك فحسب، بل)\nمثال: أنا بذلك أفرح، بل وسأفرح",
 "爾ら": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "爾今": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "爾余": "آخَرُون",
 "爾前": "رئيس الدير (رئيس رهبنة دينية؛ في الدير يكون أقل رتبة من الأباتي)",
 "爾後": "بعد ذلك, منذ ذلك الحين (من ذلك الوقت فصاعداً)\nمثال: بعد ذلك لم يتصل أبداً مرة أخرى",
 "爾汝": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "爾等": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "牀": "أَرْضِيَّة, أَرْض (ما يقابل السَقْف من الغرفة؛ قاع الشيء)\nمثال: انهارت الأرضية. / مَرْحَلَة",
 "牀榻": "قَاع, حَوْض (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر)\nمثال: نمت في قاعة السينما.",
 "片": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة. / غير مكتمل, ناقص (غير كامل أو غير كلي؛ لم يتم إنجازه)\nمثال: سرد غير مكتمل لحياته / قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / بَعِيد, نَاءٍ (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "片々": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / شِظْوِيّ, مُتَشَظٍّ (يتألّف من أجزاء صغيرة غير مترابطة) / تَافِه, حَقِير (صغير ولا يلفت الانتباه)",
 "片がつく": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها…)\nمثال: استقر زيري في خيمته.",
 "片が付く": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها…)\nمثال: استقر زيري في خيمته.",
 "片す": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ…)\nمثال: لقد أوقفنا حركة المرور. / مُنَظَّم, نَظِيف",
 "片すみ": "زَاوِيَة, رُكْن",
 "片ちんば": "أَعْرَج / غَيْرُ مُتَكَافِئ ((عن مسابقة أو متنافسين) غير متكافئ كخصوم)",
 "片っぽ": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة.",
 "片っ方": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة.",
 "片っ端から": "بشكل منتظم, بشكل منهجي (بطريقة منهجية أو متسقة)\nمثال: استبعدوا النساء بشكل منهجي",
 "片つけ": "إنهاء, تشطيب (فعل الإنهاء)\nمثال: كان أفضل إنهاء له في بطولة كبرى هو المركز الثالث",
 "片づけ": "إنهاء, تشطيب (فعل الإنهاء)\nمثال: كان أفضل إنهاء له في بطولة كبرى هو المركز الثالث",
 "片づける": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها…)\nمثال: استقر زيري في خيمته. / فَرَغَ, أَنْهَى\nمثال: انتهى أمر زيري. / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)\nمثال: زوجة ماري طبيبة. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "片めがね": "نظارة أحادية (عدسة لتصحيح الرؤية المعيبة في عين واحدة؛ تثبت في مكانها بواسطة عضلات الوجه)",
 "片や": "من جهة, من ناحية (من وجهة نظر واحدة)\nمثال: من ناحية، هي كيميائية موهوبة",
 "片われ月": "هِلَال",
 "片をつける": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها…)\nمثال: استقر زيري في خيمته.",
 "片を付ける": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها…)\nمثال: استقر زيري في خيمته.",
 "片一方": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة.",
 "片付け": "إنهاء, تشطيب (فعل الإنهاء)\nمثال: كان أفضل إنهاء له في بطولة كبرى هو المركز الثالث",
 "片付ける": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها…)\nمثال: استقر زيري في خيمته. / فَرَغَ, أَنْهَى\nمثال: انتهى أمر زيري. / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)\nمثال: زوجة ماري طبيبة. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "片仮名": "كَاتَاكَانَا (ٱلْأَحْرُفَ ٱلْمُشَابِهَةَ لِلْهِيرَاغَانَا، ٱلَّتِي تُسْتَخْدَمُ لِكِتَابَةِ…)",
 "片切スイッチ": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "片利共生": "تَعَايُش سِلْمِيّ, مُعَايَشَة (العلاقة بين نوعين مختلفين من الكائنات الحية عندما يحصل أحدهما على فوائد من…)",
 "片前": "أحادي الصدر ((عن الملابس) يغلق بتداخل ضيق ويُثبت بصف واحد من الأزرار)\nمثال: سترة أحادية الصدر",
 "片割れ": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية. / شَرِيك فِي جَرِيمَة / نَظِير",
 "片割れ月": "هِلَال",
 "片割月": "هِلَال",
 "片務": "أحادية الجانب (حالة أو صفة كون الشيء أحادي الجانب)\nمثال: تأملت في أحادية الجانب لعلاقة السيد بالعبد",
 "片務契約": "عقد أحادي الجانب (اتفاق من جانب واحد تعد فيه بالقيام (أو الامتناع عن القيام) بشيء ما مقابل أداء…)",
 "片子": "حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي / بنفسج سن الكلب (نبات غابات معمر يزهر في الربيع؛ يزرع على نطاق واسع)",
 "片寄り": "إِنْحِرَاف / استقطاب (الظاهرة التي يتم فيها تقييد اتجاه اهتزاز موجات الضوء أو غيرها من الإشعاعات)",
 "片寄る": "مَالَ (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل…)\nمثال: أريد بعض المال.",
 "片山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "片岡": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "片岩": "شيست (أي صخر متحول يمكن شقه إلى طبقات رقيقة)",
 "片帆": "بَلَغَ",
 "片影": "ذرة, نقطة صغيرة (بقعة صغيرة جداً)\nمثال: كانت الطائرة مجرد نقطة في السماء",
 "片思い": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط)\nمثال: شلل أحادي الجانب",
 "片恋": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط)\nمثال: شلل أحادي الجانب",
 "片恋い": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط)\nمثال: شلل أحادي الجانب",
 "片恨み": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط)\nمثال: شلل أحادي الجانب",
 "片息": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "片想い": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط)\nمثال: شلل أحادي الجانب",
 "片意地": "عِنَاد",
