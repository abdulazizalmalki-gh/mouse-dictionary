 "素面": "اعتدال, رصانة (الامتناع عن الإفراط) / رصانة, وقار (أسلوب جاد ورزين) / رصانة, صحو (الاعتدال في أو الامتناع عن الكحول أو المخدرات الأخرى) / رزانة, صحو (حالة كونه صاحياً وغير مسكر بالكحول)",
 "素顔": "اعتدال, رصانة (الامتناع عن الإفراط) / رصانة, وقار (أسلوب جاد ورزين) / رصانة, صحو (الاعتدال في أو الامتناع عن الكحول أو المخدرات الأخرى) / رزانة, صحو (حالة كونه صاحياً وغير مسكر بالكحول)",
 "素養": "تأريض (توصيل المعدات الكهربائية بالأرض) / أساس, تأسيس (التعليم أو التوجيه في أساسيات مجال من مجالات المعرفة)\nمثال: يفتقر إلى التأسيس اللازم للدراسة المتقدمة",
 "素麺南瓜": "قرع السباغيتي (قرع بيضاوي متوسط الحجم ذو لب على شكل خيوط تشبه السباغيتي) / قرع السباغيتي (نبات قرع يحمل ثماراً بيضاوية بقشرة صفراء ناعمة ولب طري خيطي يشبه السباغيتي)",
 "紡ぎ糸": "خيط مغزول ((مصطلح بحري) حبال صغيرة تتكون من حبل خفيف الوزن مصنوع من عدة خيوط حبال ملفوفة معاً برخاوة)",
 "紡ぐ": "رَدَنَ, غَزَلَ (رَدَنَ رَدْنًا: غزل الرَّدَن أو غزل بالمِردَن؛ ويقال: رَدَنَ الثوبَ: نسجه بالغزل المردون)",
 "紡機": "آلة غزل (آلة نسيج لغزل الخيوط والخيوط)",
 "紡糸": "غزل (صنع الخيوط)",
 "紡績": "غزل (صنع الخيوط) / خيط مغزول ((مصطلح بحري) حبال صغيرة تتكون من حبل خفيف الوزن مصنوع من عدة خيوط حبال ملفوفة معاً برخاوة)",
 "紡績工": "طعم دوار (طعم للصياد؛ يدور عند سحبه عبر الماء) / دوارة, قرص دوار (من معدات ألعاب الطاولة تتكون من قرص وسهم يتم تدويره لتحديد الحركة التالية في اللعبة) / غزّال (شخص يغزل (يبرم الألياف لتصبح خيوطاً))",
 "紡績工場": "محلج قطن, مصنع قطن (مصنع نسيج لصنع المنسوجات القطنية)",
 "紡績機": "آلة غزل (آلة نسيج لغزل الخيوط والخيوط)",
 "紡績機械": "آلة غزل (آلة نسيج لغزل الخيوط والخيوط)",
 "紡績糸": "خيط مغزول ((مصطلح بحري) حبال صغيرة تتكون من حبل خفيف الوزن مصنوع من عدة خيوط حبال ملفوفة معاً برخاوة)",
 "紡績絹糸": "حرير مغزول (خيط مصنوع من نفايات الحرير)\nمثال: عمل الغازل هو تقويم هذه الألياف بمساعدة الآلات، ثم ضمها معاً لتصبح خيطاً يُعرف بالحرير المغزول",
 "紡車": "عَجَلَة الْمِغْزَل",
 "紡錘": "مِغْزَل",
 "紡錘体": "مِغْزَل",
 "紡錘形": "سِيجَارِيّ الشَّكْل, مِغْزَلِيّ (مستدق من كلا الطرفين)",
 "索": "حَبْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "索具": "تَجْهِيزَات السَّفِينَة, صَوَارِي وَشِرَاع (تشكيل الصواري والعوارض والأشرعة وغيرها على السفينة) / تجهيزات الصاري, حبال السفينة (معدات تتكون من حبال وما إلى ذلك تدعم سواري السفينة وأشرعتها)",
 "索寞": "قَاتِم, كَئِيب (يبعث على الحزن والكآبة) / رَتِيب, كَئِيب (يفتقر إلى الحيوية أو السحر أو المفاجأة)",
 "索引": "دَلِيل, فِهْرِس / فِهْرِس (كِتَاب تجمع فيه أسماء الكتب بترتيب يسهل منه إجاد العنوان المراد البحث عنه؛ فَصْل أو بَاب في أول أو آخر الكتاب ترتب فيه الأبواب والفصول ومواضعها ليسهل منه إيجاد المطلوب)",
 "索引付け": "فهرسة (فعل تصنيف وتوفير فهرس لجعل العناصر أسهل في الاسترجاع)",
 "索引作業": "فهرسة (فعل تصنيف وتوفير فهرس لجعل العناصر أسهل في الاسترجاع)",
 "索条": "كَابْل",
 "索条鉄道": "سكة حديد بالكابلات, قطار جبلي مائل (سكة حديد صاعدة على جانب جبل يتم سحبها بواسطة كابل متحرك ولها عربات صاعدة وهابطة متوازنة)",
 "索梯": "سلم حبال (سلم ذو جوانب مصنوعة من الحبال)",
 "索漠": "قَاتِم, كَئِيب (يبعث على الحزن والكآبة) / رَتِيب, كَئِيب (يفتقر إلى الحيوية أو السحر أو المفاجأة)",
 "索然": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "索莫": "قَاتِم, كَئِيب (يبعث على الحزن والكآبة) / رَتِيب, كَئِيب (يفتقر إلى الحيوية أو السحر أو المفاجأة)",
 "索道": "ترامواي, تلفريك (وسيلة نقل تنقل الركاب أو البضائع في عربات معلقة بكابلات ومحمولة بواسطة سلسلة من الأبراج)",
 "索道鉄道": "سكة حديد بالكابلات, قطار جبلي مائل (سكة حديد صاعدة على جانب جبل يتم سحبها بواسطة كابل متحرك ولها عربات صاعدة وهابطة متوازنة)",
 "索餌": "بحث عن الطعام (فعل البحث عن الطعام والمؤن)",
 "紫": "بَنَفْسَجِيّ / أُرْجُوَانِيّ / صَلْصَةْ اَلصُّويَا",
 "紫がかった": "أُرْجُوَانِيّ, بَنَفْسَجِيّ (بلون متوسط بين الأحمر والأزرق)",
 "紫っぽい": "أُرْجُوَانِيّ, بَنَفْسَجِيّ (بلون متوسط بين الأحمر والأزرق)",
 "紫はしどい": "لَيْلَك / لَيْلَكِيّ",
 "紫丁香花": "لَيْلَك / لَيْلَكِيّ",
 "紫君子蘭": "أغابانثوس, زنبق أفريقي (نبات أفريقي بأوراق خضراء زاهية دائمة الخضرة ومظلات من العديد من الزهور البنفسجية الزرقاء العميقة عادة)",
 "紫外": "فَوْقَ البَنَفْسَجِيّ (ذُو أَطْوَالٍ مَوْجِيَّةٍ أَقْصَرَ مِنَ الضَّوْءِ المَرْئِيِّ وَأَطْوَلَ مِنَ الأَشِعَّةِ السِّينِيَّة) / أشعة فوق بنفسجية (إشعاع يقع في النطاق فوق البنفسجي؛ أطوال موجية أقصر من الضوء ولكن أطول من الأشعة السينية)",
 "紫外光": "أشعة فوق بنفسجية (إشعاع يقع في النطاق فوق البنفسجي؛ أطوال موجية أقصر من الضوء ولكن أطول من الأشعة السينية)",
 "紫外線": "أشعة فوق بنفسجية (إشعاع يقع في النطاق فوق البنفسجي؛ أطوال موجية أقصر من الضوء ولكن أطول من الأشعة السينية)",
 "紫弁慶草": "أوربين, سدم تليفيوم (نبات معمر شمالي معتدل بأوراق مسننة ورؤوس من الزهور البيضاء الأرجوانية الصغيرة)",
 "紫御殿": "اليهودي التائه (يهودي أسطوري حُكم عليه بالتجوال في العالم لسخريته من المسيح عند الصلب)",
 "紫斑": "فرفرية (أي من عدة أمراض دموية تسبب نزيفاً تحت الجلد)",
 "紫斑病": "فرفرية (أي من عدة أمراض دموية تسبب نزيفاً تحت الجلد)",
 "紫檀": "خشب الورد, شجرة خشب الورد (أي من تلك الأشجار الخشبية الصلبة من جنس دالبيرجيا التي تنتج خشب الورد - أخشاب خزائن قيمة ذات لون أحمر داكن أو أرجواني مخطط ومبرقش بالأسود) / خشب الورد (خشب محمر داكن صلب لشجرة خشب الورد له عروق مميزة بقوة؛ يستخدم في الخزائن)",
 "紫水晶": "جَمَشْت",
 "紫煙": "دخان التبغ (الدخان الناتج عن حرق المنتجات المصنوعة من أوراق التبغ المجففة، مثل السجائر)\nمثال: يجب أن تقلع عن التدخين، ألا تعلم أن دخان التبغ يحتوي على مواد ضارة؟",
 "紫燕": "سنونو أرجواني (سنونو كبير من أمريكا الشمالية يتميز الذكر منه بلون أزرق مسود)",
 "紫猿子": "عصفور أرجواني (عصفور من أمريكا الشمالية له رأس وصدر وردي محمر)",
 "紫石英": "جَمَشْت",
 "紫色": "بَنَفْسَجِيّ / أُرْجُوَانِيّ",
 "紫花豆": "فاصولياء قرمزية (قرون فاصولياء طويلة تقطع عادةً؛ مفضلة في بريطانيا) / فاصولياء العداء القرمزي, فاصولياء قرمزية (فاصولياء استوائية أمريكية ذات زهور حمراء وفاصولياء سوداء مرقطة تشبه الفاصولياء الشائعة ولكنها معمرة؛ وهي فاصولياء مفضلة للأكل في بريطانيا العظمى)",
 "紫苑": "النَّجْم, قَسِيم نَجْمِيّ (بنية نجمية الشكل تتشكل في سيتوبلازم الخلية لها ألياف تشبه الأشعة تحيط بالجسيم المركزي أثناء الانقسام المتساوي) / أستر, نجمة (أي من أعشاب مختلفة تزهر غالباً في الخريف من جنس أستر ذات زهور مبهرجة تشبه الأقحوان)",
 "紫菀": "النَّجْم, قَسِيم نَجْمِيّ (بنية نجمية الشكل تتشكل في سيتوبلازم الخلية لها ألياف تشبه الأشعة تحيط بالجسيم المركزي أثناء الانقسام المتساوي) / أستر, نجمة (أي من أعشاب مختلفة تزهر غالباً في الخريف من جنس أستر ذات زهور مبهرجة تشبه الأقحوان)",
 "紫菜": "نُورِي\nمثال: うちの猫は大変海苔が好きである。 — قطة منزلنا تحب النوري كثيرًا.",
 "紫蘇": "إيريسين, نبات شريحة اللحم (نبات أمريكي جنوبي ذو فروع خضراء إلى أرجوانية أو حمراء بأوراق زينة خضراء إلى أرجوانية وسنابل من زهور صوفية غير مهمة بقنابات غشائية جافة) / بريلا, نبات شريحة اللحم (نبات يزرع لأوراقه الحمراء أو الأرجوانية الزخرفية)",
 "紫蘭": "بليتيلا مخططة (أوركيد ياباني بأوراق مخططة بالأبيض وعناقيد منتصبة نحيلة من الزهور الوردية إلى الأرجوانية؛ يزرع غالباً؛ يوضع أحياناً في جنس بليتيا)",
 "紫衣": "عَالِيّ الرُتْبَة",
 "紫電": "البَرْق",
 "紫馬肥": "فَصْفَص",
 "紬": "بونجي (قماش رقيق ناعم منسوج من الحرير الخام (أو تقليد له))",
 "紮げる": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
 "累": "مُشْكِلَة, مَتاعِب",
 "累乗": "أسس, رفع لقوة (عملية رفع كمية إلى قوة معينة)",
 "累加": "تَسَارُع (عَجَلَة، تزايُد السرعة بالنسبة إلى الزمن في جسم من الأَجسام المتحرِّكة؛ إِسْرَاعٍ وَتَسَابُقٍ فِي الجَرْيِ)\nمثال: تسارع السائق بسيارته.",
 "累加的": "تَرَاكُمِيّ, تَصَاعُدِيّ (يزداد بالإضافة المتتالية)",
 "累囚": "سَجِين, سَجِينَة",
 "累次": "مُتَتَابِع, مُتَتَالٍ",
 "累減": "رجعي, نكوصي (يعارض التقدم؛ يعود إلى حالة سابقة أقل تقدماً) / تنازلي ((للضرائب) معدلة بحيث ينخفض المعدل مع زيادة الدخل)",
 "累犯": "عَوْد (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "累積": "تجميع, تراكم (عملية التراكم) / تجميع, تشكيلة (أشياء عديدة مجمعة معًا أو تعتبر ككل) / أرباح محتجزة, تراكم الأرباح ((تمويل) الأرباح التي لا تُدفع كتوزيعات أرباح ولكن تضاف إلى القاعدة الرأسمالية للشركة) / تراكم, تكدس (زيادة عن طريق النمو الطبيعي أو الإضافة) / تَرَاكُمِيّ, تَصَاعُدِيّ (يزداد بالإضافة المتتالية)",
 "累積投票": "تصويت تراكمي (انتخاب يمتلك فيه كل شخص عددًا من الأصوات يساوي عدد المناصب التي سيتم شغلها، ويمكنه إعطاؤها جميعًا لمرشح واحد أو توزيعها)",
 "累積的": "تَرَاكُمِيّ, تَصَاعُدِيّ (يزداد بالإضافة المتتالية)",
 "累算": "مَجْمُوع",
 "累算器": "سجل المركم, مركم ((علم الحاسوب) سجل يحتوي على جامع مدمج يضيف رقم إدخال إلى محتويات السجل) / بطارية تخزين, مركم (بطارية فولتية تخزن الشحنة الكهربائية) / جابي, حصل (شخص يعمل لتحصيل المدفوعات (مثل الإيجار أو الضرائب))",
 "累進的": "تَقَدُّمِيّ, مُتَرَقٍّ",
 "累進税": "ضريبة تصاعدية (أي ضريبة يزداد معدلها مع زيادة المبلغ الخاضع للضريبة)",
 "細": "تَفْصِيل, تَفَاصِيل / فَصَّلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل. / صَغِير, صغير / صَغِير, صغير / حَصَاة / نَحِيف, أَهْيَف / ضَيْق",
 "細々": "بتفصيل دقيق, بدقة متناهية (بتفاصيل دقيقة)\nمثال: عجزنا عن رؤية كل شيء بدقة متناهية ووضوح يرجع فقط إلى ضعف حواسنا / فَقِير / مِسْكِين / فُقَرَاء",
 "細々しい": "دَقِيقَة, دِقيقة (وِحْدَة زَمَنِيَّة تساوي ستين ثَانِيَة، وجزءًا من ستّين جزءًا من السَّاعَة؛ في : وحدة لقياس خطوط الطول والعرض) / لَحْظَة / دَقِيقٌ, تَافِهٌ (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: استأذنت لدقيقة. / مُزْعِج / مُفَصَّل",
 "細々した": "مُخْتَلِف, مُتَنَوَّع",
 "細々とした": "مُخْتَلِف, مُتَنَوَّع",
 "細い": "رَفِيع, رَقِيق / ضعيف, ضعيفة / سَيِّئُ الطَّالِع, مَنْحُوس (يَتَّسِمُ بِسُوءِ الحَظِّ أَوْ يُنْذِرُ بِهِ) / سيء الحظ, نحس (لديه أو يجلب سوء الحظ)\nمثال: الجمعة الثالث عشر تاريخ منحوس / صَغِير, صغير / بَخِيل (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ؛ شَحِيْح، مُقْتِر)\nمثال: بئس الرجل البخيل.",
 "細か": "صَغِير, صغير",
 "細かい": "صَغِير, صغير / غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل) / صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة) / أصغر, أقلية (أقل في العدد أو الحجم أو المقدار) / بسيط, ثانوي (أقل في النطاق أو التأثير) / قاصر (لم يبلغ السن القانونية)\nمثال: حصة صغيرة من الأرباح / ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "細かいお金": "فُرَاطَة",
 "細かいこと": "تفاهة, شيء تافه (شيء قليل الأهمية) / أمر تافه, تفاهة (تفصيل يعتبر غير مهم) / ترافل (بودينغ بارد مصنوع من طبقات من الكعك الاسفنجي المدهون بالفاكهة أو الجيلي؛ وقد يُزين بالمكسرات أو الكريمة أو الشوكولاتة)",
 "細かい事": "تفاهة, شيء تافه (شيء قليل الأهمية) / أمر تافه, تفاهة (تفصيل يعتبر غير مهم) / ترافل (بودينغ بارد مصنوع من طبقات من الكعك الاسفنجي المدهون بالفاكهة أو الجيلي؛ وقد يُزين بالمكسرات أو الكريمة أو الشوكولاتة)",
 "細かい金": "فُرَاطَة",
 "細かく": "بتفصيل دقيق, بدقة متناهية (بتفاصيل دقيقة)\nمثال: عجزنا عن رؤية كل شيء بدقة متناهية ووضوح يرجع فقط إلى ضعف حواسنا",
 "細っこい": "رَفِيع, رَقِيق / ضعيف, ضعيفة",
 "細まる": "ضَيِّق",
 "細めに": "قَلِيلًا",
 "細やか": "طَرِيّ, غَضّ ((عَنِ النَّبَاتَاتِ) غَيْرُ مُقَاوِم؛ يَسْهُلُ أَنْ يَمُوتَ بِظُرُوفِ النُّمُوِّ السَّيِّئَة) / حَنُون, وَدُود (يتحلّى بالدفء العاطفي والمودة أو يُظهرهما) / طَرِيّ, غَضّ (صغير السنّ وغير ناضج) / حَسَّاس, مُؤْلِم (يُؤْلِمُ عِنْدَ اللَّمْس) / دَقِيق لِلغَايَة, مُتَأَنٍّ (يَتَّسِم بِعِنَايَة فَائِقَة فِي مُعَالَجَة التَّفَاصِيل) / حَرِيص, دَقِيق جِدًّا (يتميز بالتزام دقيق بالتفاصيل) / عَمِيق, غَوِيط / صَغِير, صغير",
 "細ら": "صَغِير, صغير / حَصَاة",
 "細れ": "صَغِير, صغير / حَصَاة",
 "細れ波": "تموج صغير, مويجة (موجة صغيرة على سطح سائل) / تموج ((في الإلكترونيات) تذبذب ذو سعة صغيرة مفروض فوق قيمة ثابتة)",
 "細れ石": "حَصَاة",
 "細事": "تفاهة, شيء تافه (شيء قليل الأهمية) / أمر تافه, تفاهة (تفصيل يعتبر غير مهم) / ترافل (بودينغ بارد مصنوع من طبقات من الكعك الاسفنجي المدهون بالفاكهة أو الجيلي؛ وقد يُزين بالمكسرات أو الكريمة أو الشوكولاتة)",
 "細作": "جَاسُوس / تَجَسَّسَ",
 "細分": "تقسيم فرعي (عملية التقسيم الفرعي؛ تقسيم شيء مقسم سابقاً) / شعبة, قسم فرعي (قسم من قسم؛ جزء من جزء؛ أي جزء من شيء مقسم بالفعل) / جزء, فرع (جزء قائم بذاته من عمل أكبر (مكتوب أو موسيقي)) / شُعبة, فرع (قسم من منظمة أكبر أو أكثر تعقيدًا)\nمثال: يتجه دائماً أولاً إلى قسم الأعمال",
 "細分化": "تقسيم فرعي (عملية التقسيم الفرعي؛ تقسيم شيء مقسم سابقاً) / شعبة, قسم فرعي (قسم من قسم؛ جزء من جزء؛ أي جزء من شيء مقسم بالفعل) / جزء, فرع (جزء قائم بذاته من عمل أكبر (مكتوب أو موسيقي)) / شُعبة, فرع (قسم من منظمة أكبر أو أكثر تعقيدًا)\nمثال: يتجه دائماً أولاً إلى قسم الأعمال",
 "細切れ": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / قمامة, نفايات الطعام (طعام يتم التخلص منه (كما هو الحال من المطبخ))",
 "細別": "تقسيم فرعي (عملية التقسيم الفرعي؛ تقسيم شيء مقسم سابقاً) / شعبة, قسم فرعي (قسم من قسم؛ جزء من جزء؛ أي جزء من شيء مقسم بالفعل) / جزء, فرع (جزء قائم بذاته من عمل أكبر (مكتوب أو موسيقي)) / شُعبة, فرع (قسم من منظمة أكبر أو أكثر تعقيدًا)\nمثال: يتجه دائماً أولاً إلى قسم الأعمال",
 "細則": "قَانُون دَاخِلِيّ, لَائِحَة دَاخِلِيَّة (قاعدة تعتمدها منظمة لتنظيم شؤونها الخاصة وسلوك أعضائها)",
 "細動": "تليف (عملية أو إجراء تشكيل ليفيات) / رجفان (ارتعاش عضلي يشمل ألياف عضلية فردية تعمل دون تنسيق)",
 "細動脈": "شريان شعري, شُرَيْن (أحد الشرايين الصغيرة رقيقة الجدران التي تنتهي في الشعيرات الدموية)",
