 "総合指数": "مِئَة وَوَاحِد (يَدُلُّ عَلَى العَدَد 101) / كوري (وحدة للنشاط الإشعاعي تساوي كمية النظير المشع الذي يتحلل بمعدل 37 مليار تفكك في الثانية)",
 "総合施設": "مَعْقِد / عُقْدَة",
 "総合格闘技": "فُنُونٌ القِتَالِ الْمُخْتَلِطَة (بمعنى الضرب من الشيء والنوع؛ بمعنى بعض الصناعات الراقية التي تحتاج إلى مهارة يحكمها الذوق والمواهب)\nمثال: زيري يحب الفنون.",
 "総合的": "شَامِل, شَامِلَة",
 "総合的言語": "لغة تركيبية (لغة تصريفية، أو لغة تتميز بالنهايات النحوية)\nمثال: اللغة الإنجليزية لغة تركيبية بشكل طفيف، في حين أن اللغات الهندوأوروبية القديمة، مثل اللاتينية واليونانية والسنسكريتية، هي لغات عالية التركيب",
 "総合者": "رجل نهضة حديث, عالم شمولي (عالم حديث في وضع يسمح له باكتساب أكثر من مجرد معرفة سطحية حول العديد من الاهتمامات المختلفة)\nمثال: يجب أن يكون الإحصائي ملماً بمجالات متعددة",
 "総合診療医": "طَبِيب عَامّ (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "総合馬術": "وَاقِعَة, حَادِثَة (مؤنث الوَاقِع، اسم فاعل للشيء المؤنث الذي وَقَعَ؛ مؤنث وَاقِع، الأمر المؤنث الحاصل)\nمثال: الصخور الواقعة تشكل خطرا على المتسلقين.",
 "総同盟罷業": "إضراب عام",
 "総和": "إجمالي, مجموع (الإجمالي النهائي أو الكلي)\nمثال: مجموع كل مشاكلنا لم يعادل البؤس الذي عانوه / جمع (العملية الحسابية للجمع؛ حساب مجموع رقمين أو أكثر) / بيان ختامي, خلاصة نهائية (ملخص ختامي (كما في عرض قضية أمام محكمة قانونية)) / إجمالي, مجموع (الإجمالي النهائي أو الكلي) / تجميع, جمع ((علم وظائف الأعضاء) العملية التي يمكن من خلالها لمحفزات متعددة إنتاج استجابة (في عضلة أو عصب أو جزء آخر) لا ينتجها محفز واحد بمفرده)\nمثال: جمع أربعة وثلاثة يعطي سبعة",
 "総天然色": "تكنيكولور (طريقة ذات علامة تجارية لصنع صور متحركة ملونة)",
 "総嫁": "عاهرة شوارع (عاهرة تجذب الزبائن بالمشي في الشوارع)",
 "総崩れ": "دحر, هزيمة منكرة (هزيمة ساحقة) / رعاع, غوغاء (حشد غير منظم من الناس)",
 "総帥": "رَئِيس أَرْكَان",
 "総当たり": "رسالة جماعية, عريضة دائرية (رسالة موقعة من قبل عدد من الأشخاص) / دورة روبن, دوري الكل ضد الكل (بطولة يلعب فيها كل متسابق ضد كل متسابق آخر)",
 "総当り": "رسالة جماعية, عريضة دائرية (رسالة موقعة من قبل عدد من الأشخاص) / دورة روبن, دوري الكل ضد الكل (بطولة يلعب فيها كل متسابق ضد كل متسابق آخر)",
 "総意": "إِجْمَاع, تَوَافُق",
 "総括": "تَلْخِيص / فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق) / تفتيش, معاينة (فحص رسمي أو حكومي) / تنشيط, مراجعة (ممارسة تهدف إلى صقل الأداء أو إنعاش الذاكرة) / مراجعة ((قانون) إعادة فحص قضائي لإجراءات محكمة (خاصة من قبل محكمة استئناف))\nمثال: وقفت الفصيلة جاهزة للتفتيش",
 "総括的": "شَامِل كُلّ شَيْء",
 "総排出腔": "بالوعة, مجرور (أنبوب نفايات ينقل مياه الصرف الصحي أو المياه السطحية) / مذرق ((في علم الحيوان) التجويف (في الطيور والزواحف والبرمائيات ومعظم الأسماك ووحيدات المسلك ولكن ليس في الثدييات الأخرى) في نهاية الجهاز الهضمي الذي تفتح…)",
 "総排泄腔": "بالوعة, مجرور (أنبوب نفايات ينقل مياه الصرف الصحي أو المياه السطحية) / مذرق ((في علم الحيوان) التجويف (في الطيور والزواحف والبرمائيات ومعظم الأسماك ووحيدات المسلك ولكن ليس في الثدييات الأخرى) في نهاية الجهاز الهضمي الذي تفتح…)",
 "総攬": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "総支配人": "مدير عام (المدير الأعلى رتبة)",
 "総攻": "شَامِل, كَامِلُ النِّطَاق (يستخدم جميع الموارد المتاحة)",
 "総攻め": "شَامِل, كَامِلُ النِّطَاق (يستخدم جميع الموارد المتاحة)",
 "総攻撃": "شَامِل, كَامِلُ النِّطَاق (يستخدم جميع الموارد المتاحة)",
 "総数": "مَجْمُوع",
 "総書記": "أَمِين عَامّ (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "総本山": "الْقِيَادَة الْعَامَّة / مَقَرّ",
 "総毛立つ": "ارتجاف, رعشة (اهتزاز لا إرادي (كما لو كان بسبب المرض أو الخوف)) / رجفة, رعشة (إحساس بالخوف يكاد يكون ممتعاً)\nمثال: سرت فيه رعشة مفاجئة",
 "総決算": "بيان ختامي, خلاصة نهائية (ملخص ختامي (كما في عرض قضية أمام محكمة قانونية))",
 "総浚い": "بروفة بالملابس, بروفة نهائية (بروفة كاملة غير منقطعة بالأزياء قبل العرض الأول بوقت قصير)",
 "総状花序": "عنقود, نورة عنقودية (عادة ما يكون عنقودًا ممدودًا من الزهور على طول الساق الرئيسية حيث تفتح الزهور في القاعدة أولاً)",
 "総理": "رَئِيس وُزَرَاء, رَئِيسَة وُزَرَاء / رَائِد, قِيَادِيّ (يذهب أو يتقدم في المقدمة؛ يظهر الطريق) / قيادة (نشاط القيادة) / فِي المُقَدِّمَة, مُتَصَدِّر (يَحْتَلُّ المَرْكَزَ الأَوَّلَ أَوْ لَدَيْهِ النَّتِيجَةُ الأَعْلَى فِي مُنَافَسَة) / شريحة رصاص, فاصد (شريط رفيع من المعدن يستخدم لفصل خطوط الحروف في الطباعة)\nمثال: ركبنا في السيارة المتقدمة",
 "総理大臣": "رَئِيس وُزَرَاء, رَئِيسَة وُزَرَاء",
 "総理府": "مكتب إدارة المشاريع (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب.",
 "総監": "مفتش عام (ضابط عسكري مسؤول عن التحقيقات)",
 "総監督": "مدير عام (المدير الأعلى رتبة)",
 "総目録": "دَلِيل, فِهْرِس / فِهْرِس (كِتَاب تجمع فيه أسماء الكتب بترتيب يسهل منه إجاد العنوان المراد البحث عنه؛ فَصْل أو بَاب في أول أو آخر الكتاب ترتب فيه الأبواب والفصول ومواضعها ليسهل منه إيجاد المطلوب)",
 "総督": "مُحَافِظ, حَاكِم",
 "総秘書": "أَمِين عَامّ (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "総統": "قائد أعلى, قائد عام (الضابط الذي يتولى القيادة العليا)\nمثال: في الولايات المتحدة، الرئيس هو القائد الأعلى للقوات المسلحة / رَئِيس, رَئِيسَة / دَلِيل, فِيرَر",
 "総締め": "مَجْمُوع",
 "総纏め": "تجميع المشتبه بهم, حملة اعتقالات (التجميع المنهجي للمشتبه بهم من قبل الشرطة) / تجميع الماشية (نشاط جمع الماشية معاً لعدها أو وسمها أو بيعها) / جولة ملخصة, حصاد (قائمة ملخصة؛ كما في 'حصاد الأخبار')\nمثال: حملة اعتقالات جماعية للمشتبه بهم",
 "総罷業": "إضراب عام",
 "総胆管": "قناة صفراوية مشتركة (قناة تتكون من القناتين الكبدية والمرارية؛ تفتح في الاثني عشر)",
 "総花": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)",
 "総花式": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)",
 "総苞": "غِلافُ الزَّهْرَة, قُلَافَة (قنابة بارزة للغاية أو زوج قنابات أو حلقة من القنابات عند قاعدة النورة الزهرية)",
 "総菜": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له)",
 "総裁": "رَئِيس, رَئِيسَة",
 "総裏": "بِطَانَة",
 "総覧": "مختصر شامل, موجز واف (ملخص موجز ولكنه شامل لعمل أكبر) / مجموعة (منشور يحتوي على مجموعة متنوعة من الأعمال)",
 "総計": "مَجْمُوع",
 "総説": "مراجعة, مقالة نقدية (مقالة تعطي تقييماً نقدياً (لكتاب أو مسرحية))",
 "総選挙": "انتخابات عامة / مُسَابَقَة شَعْبِيَّة (منافسة (حقيقية أو مجازية) للحصول على الدعم الشعبي)",
 "総重量": "وزن إجمالي, وزن قائم (الوزن الإجمالي للمنتج وعبوته)\nمثال: الآن بعد ملء الزجاجات، نحتاج لوزنها مرة أخرى لتحديد وزنها القائم",
 "総長": "رَئِيس, رَئِيسَة / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير. / قَائِد, زَعِيم",
 "総集編": "إبراز ضوئي, منطقة مضيئة (منطقة من السطوع في الصورة) / الجزء الأبرز, علامة مميزة (الجزء الأكثر إثارة للاهتمام أو الذي لا يُنسى)\nمثال: كان الجزء الأبرز في الجولة زيارتنا للفاتيكان",
 "総需要": "طلب عالمي, طلب كلي (في الاقتصاد الكلي، إجمالي الطلب على السلع والخدمات النهائية في الاقتصاد في وقت ومستوى سعر معينين)",
 "総頸動脈": "شريان سباتي مشترك (يمتد صعوداً في الرقبة وينقسم إلى الشرايين السباتية الظاهرة والباطنة)",
 "総額": "إجمالي, مجموع (الإجمالي النهائي أو الكلي)\nمثال: مجموع كل مشاكلنا لم يعادل البؤس الذي عانوه",
 "緑": "أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات؛ صفة ما كان لونه أخضرا) / خُضْر (خَضَر الرجلُ النَّخْلَ خَضَر ُ خَضْرًا: قطعه)\nمثال: ذلك الضوء أخضر. / خضرة (أوراق خضراء)",
 "緑がかった": "أَخْضَر (بلون بين الأزرق والأصفر في الطيف اللوني؛ مشابه للون العشب الطازج)",
 "緑のおばさん": "حارِس عُبُور (شخص يساعد الناس (خاصة الأطفال) عند معبر المرور)",
 "緑の党": "حزب الخضر (حزب سياسي بيئي)",
 "緑の指": "مَهَارَة زِرَاعِيَّة, يَد خَضْرَاء (قدرة خاصة على جعل النباتات تنمو)",
 "緑の革命": "ثورة خضراء (إدخال المبيدات الحشرية والحبوب عالية الغلة والإدارة الأفضل خلال الستينيات والسبعينيات مما زاد بشكل كبير من الإنتاجية الزراعية)",
 "緑内障": "زَرَق, المَاء الأَزْرَق",
 "緑化": "استعادة الشباب, تجدد (ظاهرة استعادة الحيوية والنضارة)\nمثال: التجدد السنوي للمناظر الطبيعية",
 "緑化屋根": "حديقة سطح (حديقة على سطح مبنى مسطح)",
 "緑地帯": "حزام أخضر (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر)\nمثال: هذا حزام من الجلد.",
 "緑林": "غابة خضراء (أراضي حرجية مكتملة الأوراق)",
 "緑柱石": "بيريل (المصدر الرئيسي للبريليوم؛ تُثَمّن أصنافه الشفافة الملونة كأحجار كريمة)",
 "緑泥石": "كلوريت (معدن أخضر أو أسود بشكل عام؛ يوجد كمكون للعديد من الصخور عادة في شكل بلورة مسطحة)",
 "緑燕": "سنونو الشجر (من أستراليا وبولينيزيا؛ يعشش في تجاويف الأشجار) / سنونو أبيض البطن (سنونو أخضر مزرق وأبيض من أمريكا الشمالية؛ يعشش في تجاويف الأشجار)",
 "緑猿": "سعدان أخضر (قرد سافانا شائع ذو ظهر رمادي مخضر وذيل أصفر)",
 "緑玉": "زُمُرُّد / أَخْضَر زُمُرُّدِيّ, خَضْرَاء زُمُرُّدِيَّة (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات؛ صفة ما كان لونه أخضرا)\nمثال: ذلك الضوء أخضر.",
 "緑玉石": "زُمُرُّد / أَخْضَر زُمُرُّدِيّ, خَضْرَاء زُمُرُّدِيَّة (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات؛ صفة ما كان لونه أخضرا)\nمثال: ذلك الضوء أخضر.",
 "緑玉髄": "كريسوبراز (نوع أخضر من الكالسيدوني يُثمّن كحجر كريم)",
 "緑石鹸": "صابون طري (صابون طري (أو سائل) مصنوع من زيوت نباتية؛ يستخدم في بعض الأمراض الجلدية)",
 "緑砂": "رمل أخضر (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة تتكوّن غالباً على الشاطئ أو في الصحارى)\nمثال: وصلت شاحنة الرمل.",
 "緑肥": "سماد أخضر (محصول نامٍ يتم حرثه في التربة لإغنائها)",
 "緑色": "أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات؛ صفة ما كان لونه أخضرا) / خُضْر (خَضَر الرجلُ النَّخْلَ خَضَر ُ خَضْرًا: قطعه)\nمثال: ذلك الضوء أخضر.",
 "緑茶": "شَايْ أَخْضَر (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة)\nمثال: صب الشاي لضيفك.",
 "緑草": "خضرة, نضارة (المظهر الغزير للنباتات المزدهرة) / خضرة (أوراق خضراء)",
 "緑葉甘藍": "كُرْنُب أَجْعَد",
 "緑藻": "طحالب خضراء (طحالب ذات لون أخضر صافٍ؛ تنمو غالباً على الصخور الرطبة أو الخشب الرطب أو سطح المياه الراكدة)",
 "緑藻植物": "طحالب خضراء (طحالب ذات لون أخضر صافٍ؛ تنمو غالباً على الصخور الرطبة أو الخشب الرطب أو سطح المياه الراكدة)",
 "緑藻植物門": "الطحالب الخضراء, قسم الطحالب الخضراء (قسم كبير من الطحالب حقيقية النواة التي تعيش بشكل رئيسي في المياه العذبة وتمتلك الكلوروفيل أ وب وتخزن الغذاء على شكل نشا ولها جدران خلوية سيليلوزية)",
 "緑藻類": "طحالب خضراء (طحالب ذات لون أخضر صافٍ؛ تنمو غالباً على الصخور الرطبة أو الخشب الرطب أو سطح المياه الراكدة)",
 "緑虫": "يوجلينا (كائن دقيق أخضر وحيد الخلية يعيش في المياه العذبة وله سوط واحد؛ يصنف غالباً كطحالب)",
 "緑豆": "مَاش",
 "緑豊か": "أَخْضَر, مُخْضَرّ (يتّسم بوَفْرة الخُضْرة والنبات)",
 "緑道": "حزام أخضر (حزام من المتنزهات أو الأراضي الريفية المحيطة ببلدة أو مدينة)",
 "緑閃石": "أكتينوليت (معدن أخضر من مجموعة الأمفيبول؛ سيليكات الكالسيوم والمغنيسيوم والحديد)",
 "緑陰樹": "شجرة ظل (شجرة تزرع أو تقدر قيمتها بشكل رئيسي لظلها من أشعة الشمس)",
 "緑青": "زِنْجَار / زِنْجَارِيّ",
 "緑黄色": "أصفر مخضر (درجة من الأصفر مشوبة بالأخضر)",
 "緒": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / خيط دليل, قرينة (دليل يساعد على حل مشكلة) / تلميح, دليل (إشارة طفيفة) / خَيْط, حَبْل ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه)\nمثال: حل الصرة تلقى خيط. / وَتَر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس)",
 "緒言": "توطئة, ديباجة (مقال تمهيدي قصير يسبق نص كتاب)",
 "緒論": "مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "緘": "دَرْز (درز:درزا تمكن من درز الدُّنْيَا؛ دَرِزَ الرجلُ، كفَرِح، وَكَذَلِكَ ذَرِزَ، بالدّالِ والذّالِ، إِذا تمَكَّن مِنْهَا أَي من نَعيمِها)",
 "緘する": "فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان. / صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "緘口": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ! / خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة",
 "緘口令": "أمر حظر النشر (أمر محكمة يقيد المعلومات أو التعليقات من قبل المشاركين في دعوى قضائية)\nمثال: فرض أمر حظر النشر على أعضاء الصحافة ينتهك التعديل الأول للدستور",
 "緘黙症": "بكم, خرس (حالة عدم القدرة أو عدم الرغبة في التحدث)\nمثال: كان خرسه نتيجة لصممه",
 "線": "خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / شُعَاع / شِفْنِين, شِفْنِين بَحْرِيّ / لَخَّصَ, اِخْتَصَرَ / مُسْتَوًى / مَرْحَلَة",
 "線が太い": "بَلِيغ, مُؤَثِّر (يُنتج أثراً قويّاً) / مؤثر, مثير للإعجاب (يترك انطباعاً قوياً أو حياً)\nمثال: احتفال مثير للإعجاب",
 "線が細い": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "線の太い": "حاسم, حاسمة",
 "線スペクトル": "طيف خطي (طيف تتركز فيه الطاقة عند أطوال موجية معينة؛ ينتج عن الذرات والأيونات المثارة عند عودتها إلى مستوى طاقة أقل)",
 "線ファスナー": "سَحَّاب, زِمَام مُنْزَلِق (الغيوم المتحركة؛ غُيُوم، دَيْم)\nمثال: القمر موجود خلف السحاب.",
 "線区": "خط حافلات (منظمة مسؤولة عن تشغيل نظام نقل بالحافلات)",
 "線図": "مُخَطَط, رَسْم إِيضَاحِيّ / رَسْم بَيَانِيّ, مُخَطَط (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "線型": "تَنَاظُرِيّ, خَطِّيّ (لدائرة أو جهاز له مخرج يتناسب مع المدخل) / أحادي البعد, خطي (من أو في أو على طول أو يتعلق بخط؛ ينطوي على أو له بعد واحد) / خطي (يصف أو يتضمن معادلة تكون حدودها من الدرجة الأولى) / خَطِّيّ, طُولِيّ (يُقاس في اتِّجاه الطُّول)\nمثال: جهاز تناظري",
 "線型代数学": "جبر خطي (جزء الجبر الذي يتعامل مع نظرية المعادلات الخطية والتحويل الخطي)",
 "線型作用素": "مُؤَثِّر خَطِّيّ (مؤثر يطيع قانون التوزيع)",
 "線型性": "أحادية البعد, خطية (خاصية امتلاك بعد واحد)",
 "線審": "حكم الخط (حكم كرة قدم يساعد الحكم الرئيسي من خلال تتبع الوقت الرسمي خلال المباراة)",
 "線引き": "تصوير, رسم (التمثيل عن طريق الرسم أو التلوين وما إلى ذلك) / تخطيط, رسم خطي (رسم لخطوط خارجية لأشكال أو أشياء) / تشخيص, تصوير (وصف لفظي بياني أو حيوي)\nمثال: في كثير من الأحيان كانت الرواية تُقاطع بصور لفظية طويلة / مِسْطَرَة (أداة تستخدم لقياس الأطوال أو رسم الخطوط المستقيمة؛ خط مستقيم تحدده مِسطَرة أو بُعد محدد) / حَاكِم (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر)\nمثال: استعارت المسطرة.",
 "線形": "تَنَاظُرِيّ, خَطِّيّ (لدائرة أو جهاز له مخرج يتناسب مع المدخل) / أحادي البعد, خطي (من أو في أو على طول أو يتعلق بخط؛ ينطوي على أو له بعد واحد) / خطي (يصف أو يتضمن معادلة تكون حدودها من الدرجة الأولى) / خَطِّيّ, طُولِيّ (يُقاس في اتِّجاه الطُّول)\nمثال: جهاز تناظري",
 "線形代数": "جبر خطي (جزء الجبر الذي يتعامل مع نظرية المعادلات الخطية والتحويل الخطي)",
 "線形代数学": "جبر خطي (جزء الجبر الذي يتعامل مع نظرية المعادلات الخطية والتحويل الخطي)",
 "線形動物": "نِيمَاتُودَا, دودَة اِسْطِوَانِيَّة",
 "線形回帰": "انحدار خطي (العلاقة بين المتغيرات عندما تكون معادلة الانحدار خطية)",
 "線形性": "أحادية البعد, خطية (خاصية امتلاك بعد واحد)",
 "線形方程式": "معادلة خطية (معادلة متعددة الحدود من الدرجة الأولى)",
 "線形計画法": "برمجة خطية (تقنية رياضية تستخدم في الاقتصاد؛ تجد الحد الأقصى أو الأدنى للدوال الخطية في العديد من المتغيرات الخاضعة لقيود)",
 "線形関数": "دَالَّة خَطِّيَّة (دالة رياضية يكون رسمها البياني (في الإحداثيات الديكارتية بمقاييس موحدة) خطاً مستوياً)",
 "線形順序": "أسطوانة طويلة التشغيل (أسطوانة فونوغراف طويلة التشغيل؛ مصممة للتشغيل بسرعة 33.3 دورة في الدقيقة)",
 "線描": "تخطيط, رسم خطي (رسم لخطوط خارجية لأشكال أو أشياء)",
 "線描画": "تخطيط, رسم خطي (رسم لخطوط خارجية لأشكال أو أشياء)",
 "線材": "سِلْك (السِّلْكُ : الخيطُ الذي ينظَم فيه الخرز ونحوه، أَو الذي يخاط به؛ السِّلْكُ : خيط من معدن تسري فيه الكهرباء)\nمثال: هذا السلك ساخن.",
 "線条": "خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "線条体": "جسم مخطط (كتلة مخططة من المادة البيضاء والرمادية تقع أمام المهاد في كل نصف كرة مخية؛ تتكون من النواة المذنبة والنواة العدسية)",
 "線毛": "شعيرة (بنية تشبه الشعر خاصة على سطح خلية أو كائن دقيق) / شعر, شعرة (أي من الخيوط الأسطوانية التي تنمو بشكل مميز من بشرة الثدييات)\nمثال: توجد شعرة في حسائي",
 "線状": "تَنَاظُرِيّ, خَطِّيّ (لدائرة أو جهاز له مخرج يتناسب مع المدخل) / أحادي البعد, خطي (من أو في أو على طول أو يتعلق بخط؛ ينطوي على أو له بعد واحد) / خطي (يصف أو يتضمن معادلة تكون حدودها من الدرجة الأولى) / خَطِّيّ, طُولِيّ (يُقاس في اتِّجاه الطُّول)\nمثال: جهاز تناظري",
 "線画": "تخطيط, رسم خطي (رسم لخطوط خارجية لأشكال أو أشياء)",
 "線番": "مقياس الأسلاك (مقياس لقياس قطر السلك)",
 "線維": "لِيف",
 "線維束": "حزمة ألياف, حزمة عصبية (حزمة من الألياف (خاصة الألياف العصبية)) / كراسة, ملزمة (جزء من عمل مطبوع)",
 "線維症": "تليف (تطور النسيج الضام الليفي الزائد في عضو ما)",
 "線維素": "سِلْيُولُوز / فيبرين (بروتين ليفي أبيض غير قابل للذوبان يتكون بفعل الثرومبين على الفيبرينوجين عند تخثر الدم)",
 "線維組織": "نسيج ليفي (نسيج يتكون من أو يحتوي على ألياف في كل من الحيوانات والنباتات)",
 "線維腫": "ورم ليفي (ورم غير خبيث من النسيج الضام)",
 "線維腺腫": "ورم غدي ليفي (ورم حميد ومتحرك وصلب وغير مؤلم في الثدي؛ شائع لدى الشابات ويسببه ارتفاع مستويات هرمون الاستروجين)",
 "線維芽細胞": "أرومة ليفية (خلية يتطور منها النسيج الضام)",
 "線織面": "سطح مسطر (سطح يتولد عن طريق خط مستقيم متحرك بحيث يمكن رسم خط يقع بالكامل في السطح من خلال كل نقطة على السطح)\nمثال: في الهندسة الجبرية، تم تعريف الأسطح المسطرة في الأصل على أنها أسطح إسقاطية في الفضاء الإسقاطي تحتوي على خط مستقيم يمر عبر أي نقطة معطاة",
 "線虫": "نِيمَاتُودَا, دودَة اِسْطِوَانِيَّة",
 "線虫類": "نِيمَاتُودَا, دودَة اِسْطِوَانِيَّة",
 "線路": "خط سكة حديد (الطريق المكون من مسار السكة الحديدية وأرضية الطريق) / خط سكة حديد, سكة حديد (الخط الذي يمثل المنظمة التجارية المسؤولة عن تشغيل نظام نقل للقطارات التي تسحب الركاب أو البضائع)",
 "線速度一定": "مِئَة وَخَمْسَة وَخَمْسُونَ (يَدُلُّ عَلَى العَدَد 155)",
 "線量": "جُرْعَة",
 "線量測定": "قياس الجرعات (قياس جرعة الإشعاع المنبعثة من مصدر مشع)",
 "線量計": "مقياس الجرعة الإشعاعية (أداة لقياس جرعات الإشعاع المؤين (الأشعة السينية أو النشاط الإشعاعي))",
 "線香花火": "سلك شرار, شمعة شرارة (لعبة نارية تحترق ببطء وتطلق وابلًا من الشرر) / ألماس (قطع الألماس (مصطلح عامي))\nمثال: انظر إلى الألماس الذي ترتديه تلك السيدة!",
 "緞帳": "ستارة خلفية, ستارة منسدلة (ستارة يمكن إنزالها ورفعها على المسرح من الأعلى؛ غالباً ما تستخدم كمنظر خلفي)",
 "緞帳役者": "مِن الطَّبَقَة الدُّنْيَا (يحتل أدنى مكانة اجتماعية واقتصادية في المجتمع)",
 "緞帳芝居": "مِن الطَّبَقَة الدُّنْيَا (يحتل أدنى مكانة اجتماعية واقتصادية في المجتمع)",
 "締まらない": "فَضْفَاض, واسِع",
 "締まり": "إتمام, إكمال (إجراء ختامي أو نهائي) / إغلاق, إقفال (إنهاء العمليات) / اقتراب, تضييق المسافة (الاقتراب من وجهة معينة؛ تضييق الفجوة) / إغلاق (عملية إغلاق شيء ما)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية / ثَبَات / حذر, حرص (صفة كون المرء حذراً ومجتهداً) / حذر, حيطة (سمة كون المرء حذراً؛ الانتباه للخطر المحتمل)\nمثال: أعجبت بحرصه في عمله / نَتِيجَة",
 "締まりがない": "مسترخٍ, هادئ (بدون إجهاد أو قلق)\nمثال: أعطى انطباعاً بأنه مسترخٍ تماماً",
 "締まりが無い": "مسترخٍ, هادئ (بدون إجهاد أو قلق)\nمثال: أعطى انطباعاً بأنه مسترخٍ تماماً",
 "締まりのない": "مُتَرَاخٍ, مُتَسَاهِل (يَفْتَقِر إِلَى الصَّرَامَة أَوِ الدِّقَّة) / بَطِيء الجَرَيَان (يسيل بسرعة ضئيلة كما عند تحوُّل المدّ) / فَضْفَاض, مُرْتَخٍ (غَيْرُ مَشْدُودٍ وَلَا مُتَوَتِّر) / الجزء المرتخي (حبل أو خيط أو كابل يتدلى باسترخاء)\nمثال: قام بسحب الجزء المرتخي",
 "締まりの無い": "مُتَرَاخٍ, مُتَسَاهِل (يَفْتَقِر إِلَى الصَّرَامَة أَوِ الدِّقَّة) / بَطِيء الجَرَيَان (يسيل بسرعة ضئيلة كما عند تحوُّل المدّ) / فَضْفَاض, مُرْتَخٍ (غَيْرُ مَشْدُودٍ وَلَا مُتَوَتِّر) / الجزء المرتخي (حبل أو خيط أو كابل يتدلى باسترخاء)\nمثال: قام بسحب الجزء المرتخي",
 "締まる": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب / شَدَّ, ضَيَّقَ",
 "締め": "إرساء, ربط السفينة (فعل تأمين سفينة واصلة بالحبال) / مَجْمُوع / نَتِيجَة / أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "締めくくり": "نَتِيجَة / إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة)",
 "締めくくりをつける": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "締めしろ": "تَدَاخُل",
 "締めつけ": "ضَغْط",
 "締めつける": "شَدَّ, ضَيَّقَ / عَصَرَ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "締めて": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "締めひも": "مشروب مقوي, منشط (مقوي أو منشط (خاصة مشروب كحولي)) / حامي الساعد, واقي الذراع (غطاء واقٍ للمعصم أو الذراع يستخدم في الرماية والمبارزة ورياضات أخرى)",
 "締める": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل. / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا. / مَجْمُوع / اِقْتَصَدَ, اِدَّخَرَ",
 "締め上げる": "عَصَرَ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "締め付け": "ضَغْط",
 "締め付ける": "شَدَّ, ضَيَّقَ / عَصَرَ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "締め代": "تَدَاخُل",
 "締め具": "مَشْبَك",
 "締め出し": "تبييض, فوز نظيف (هزيمة في لعبة يفشل فيها أحد الجانبين في التسجيل)",
 "締め出す": "حَانَة, بَار",
 "締め切り": "أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري. / إتمام, إكمال (إجراء ختامي أو نهائي) / إغلاق, إقفال (إنهاء العمليات) / اقتراب, تضييق المسافة (الاقتراب من وجهة معينة؛ تضييق الفجوة) / إغلاق (عملية إغلاق شيء ما)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية / صندوق غاطس, قيسون (حجرة كبيرة مانعة لتسرب الماء تستخدم للبناء تحت الماء)",
 "締め切り日": "حد زمني, مهلة (فترة زمنية يجب خلالها إنجاز شيء ما أو إكماله)",
 "締め切る": "بمدى قريب, عن قرب (قريب جداً)\nمثال: بدون نظارة القراءة لا أستطيع رؤية الأشياء عن قرب / قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "締め固める": "كثيف, متراص (متحد بشكل وثيق وثابت أو معبأ معاً) / جَامِع, مُلَخَّص (يُقَدِّمُ خُلَاصَةَ الشَّيْءِ بِإِيجَازٍ) / مَتِين البُنْيَة, مُمْتَلِئ الجِسْم (ذو بنية قصيرة وصلبة) / علبة بودرة, مضغوطة تجميل (علبة مستحضرات تجميل صغيرة بمرآة؛ لتحمل في حقيبة المرأة)\nمثال: تربة متراصة",
 "締め括り": "نَتِيجَة / إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة)",
 "締め括りをつける": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "締め日": "أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "締め木": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة.",
 "締め焼き": "بيسك, حساء القشطة البحرية (حساء كريمي كثيف مصنوع من المحار)",
 "締め紐": "مشروب مقوي, منشط (مقوي أو منشط (خاصة مشروب كحولي)) / حامي الساعد, واقي الذراع (غطاء واقٍ للمعصم أو الذراع يستخدم في الرماية والمبارزة ورياضات أخرى)",
 "締め金": "إِبْزِيم (حديدة الحزام)\nمثال: ذهبت لشراء إبزيم.",
 "締め高": "مَجْمُوع / مَبْلَغ",
