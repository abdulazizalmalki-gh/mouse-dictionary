 "経済封鎖": "حَصَار\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "経済性": "اِقْتِصَاد (بمعنى واصل عمل القصائد؛ بمعنى تَوَسَّط في الانفاق فلم يسرف ولم يقتر)\nمثال: ابني يدرس الاقتصاد.",
 "経済恐慌": "أزمة اقتصادية, كساد (حالة اقتصادية طويلة الأمد تتميز بالبطالة وانخفاض الأسعار ومستويات منخفضة من…)",
 "経済成長": "نمو اقتصادي (نمو مطرد في القدرة الإنتاجية للاقتصاد (وبالتالي نمو الدخل القومي))",
 "経済成長予測": "نمو اقتصادي (نمو مطرد في القدرة الإنتاجية للاقتصاد (وبالتالي نمو الدخل القومي))",
 "経済援助": "إعانة, دعم اقتصادي (هبة مالية أو مساعدة مادية أخرى لدعم شخص أو قضية)\nمثال: مساعدة اقتصادية للمناطق الكاسدة",
 "経済政策": "سياسة اقتصادية (سياسة حكومية للحفاظ على النمو الاقتصادي والإيرادات الضريبية)",
 "経済状態": "حالة اقتصادية, وضع اقتصادي (حالة الاقتصاد)",
 "経済状況": "حالة اقتصادية, وضع اقتصادي (حالة الاقتصاد)",
 "経済界": "رجال الأعمال, مجتمع الأعمال (مجموعة الأفراد الذين يديرون الأعمال التجارية)",
 "経済発展": "تنمية اقتصادية (الإجراءات المستمرة والمتضافرة لصانعي السياسات والمجتمعات التي تعزز مستوى…)\nمثال: استراتيجية التنمية الاقتصادية الخمسية هي أول خارطة طريق استراتيجية للمقاطعة لتحقيق تنمية اقتصادية مستدامة",
 "経済的": "اِقْتِصَادِيّ / اقْتِصَادِيّ, مُوَفِّر (يستخدم الحدّ الأدنى من الوقت أو الموارد اللازمة للفاعلية)\nمثال: نمو اقتصادي",
 "経済的自立": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "経済相": "وزير المالية (الوزير المسؤول عن مالية الدولة)",
 "経済破綻": "إِفْلَاس",
 "経済通貨同盟": "دُرْمِيس أُسْتُرَالِيّ",
 "経済連携協定": "وكالة حماية البيئة (وكالة فيدرالية مستقلة تأسست لتنسيق البرامج التي تهدف إلى الحد من التلوث وحماية…)",
 "経理": "مُحَاسِبَة (المُحَاسَبَة: المهنة التي يقوم أصحابها بحساب الأرباح والخسائر وغيرها في…)\nمثال: محاسبة النفس صفة حميدة.",
 "経産": "تَكَافُؤ, تَمَاثُل (مساواة وظيفية) / سبق لها الولادة, ولود (التي أنجبت طفلاً واحداً أو أكثر قابلاً للحياة)",
 "経界": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "経略": "إِدَارَة, مُرَاقَبَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة…)\nمثال: والدتي تنتظرني في الإدارة.",
 "経皮": "عبر الجلد (عبر الجلد السليم؛ يشير إلى الأدوية التي توضع مباشرة على الجلد (كريمات أو مراهم)…)\nمثال: إستروجين عبر الجلد",
 "経皮内視鏡的胃瘻造設術": "وَتَد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها)",
 "経皮治療システム": "التوقيت الأرضي, توقيت التقويم الفلكي ((علم الفلك) مقياس للوقت محدد بحركة الأرض المدارية؛ التوقيت الأرضي هو التوقيت…)",
 "経皮的": "عبر الجلد (عبر الجلد السليم؛ يشير إلى الأدوية التي توضع مباشرة على الجلد (كريمات أو مراهم)…)\nمثال: إستروجين عبر الجلد",
 "経管栄養": "تغذية أنبوبية, تغذية قسرية (تغذية تتكون من إيصال محلول مغذ (كما عبر أنبوب أنفي) لشخص لا يستطيع أو لا يريد…)",
 "経糸": "سدى (الخيط المرتب طولياً على النول ويقطعه اللحمة)",
 "経絡": "خَطّ الطُّول (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "経綸": "حَاكِم (مَسْؤُول عَنْ وَضْع القَوَانِين وَإِنْفَاذِهَا)\nمثال: لوائح لحكم سجون الولاية",
 "経線": "خَطّ الطُّول (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "経緯": "تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية / لُحْمَة وَسَدَاة (هو اللَحْم، واللحمة أخصُّ من اللحم؛ قطعة من اللحم) / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "経緯儀": "ثيودوليت, مزواة (أداة مسح لقياس الزوايا الأفقية والعمودية، تتكون من تلسكوب صغير مثبت على حامل…)",
 "経緯線網": "غْرَاتِيكُول",
 "経緯縮緬": "جورجيت (مادة حريرية رقيقة للفساتين)",
 "経血": "حيض, طمث (تدفق الدم من الرحم؛ يحدث على فترات شهرية تقريباً خلال سنوات الإنجاب للمرأة)",
 "経費": "صَرْف, مَصْرُوف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال…)\nمثال: أيمكنك صرف خمسين؟",
 "経距": "رَحِيل, مُغَادَرَة",
 "経路": "طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ. / عَمَلِيَّة\nمثال: جهز زيري حقائبه.",
 "経路選択": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق.",
 "経過": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية. / تَقَدُّم / مُرُور",
 "経過時間": "الوقت المنقضي (الوقت الذي يمر أثناء حدوث حدث ما)",
 "経過観察": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق)\nمثال: برنامجه الجديد هو متابعة للبرامج التي بدؤوا بها",
 "経頭蓋磁気刺激": "ثوليوم (عنصر فلزي فضي ناعم من مجموعة الأتربة النادرة)",
 "経験": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "経験の浅い": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "経験上": "إمبيريقياً, تجريبياً (بطريقة تجريبية)\nمثال: يمكن اختبار هذا تجريبياً",
 "経験主義": "دجل, شعوذة طبية (ممارسة طبية ومشورة قائمة على الملاحظة والخبرة مع الجهل بالنتائج العلمية)",
 "経験人数": "حَصِيلَة الْقَتْلَى, عَدَد الضَّحَايَا (إحصاء للجنود القتلى في عملية أو فترة زمنية)",
 "経験則": "قَاعِدَة عَامَّة",
 "経験度": "خلفية",
 "経験済み": "خبير, ذو خبرة (لديه خبرة؛ لديه معرفة أو مهارة من الملاحظة أو المشاركة)",
 "経験的": "خِبْرَاتِيّ, وُجُودِيّ (مُستمَدّ من الخبرة أو تجربة الوجود)\nمثال: واقع شخصي وتجريبي",
 "経験論": "دجل, شعوذة طبية (ممارسة طبية ومشورة قائمة على الملاحظة والخبرة مع الجهل بالنتائج العلمية)",
 "経験豊富": "خبير, ذو خبرة (لديه خبرة؛ لديه معرفة أو مهارة من الملاحظة أو المشاركة)",
 "結い方": "تَسْرِيحَة شَعْر, تَصْفِيفَة شَعْر (ترتيب الشعر (خاصة شعر المرأة))",
 "結い目": "عُقْدَة\nمثال: أمضى زيري العقد.",
 "結い髪": "تَسْرِيحَة شَعْر, تَصْفِيفَة شَعْر (ترتيب الشعر (خاصة شعر المرأة))",
 "結う": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / تَعَادُل (تَسَاوَى؛ تَمَاثَلَ)\nمثال: انتهت المباراة بالتعادل.",
 "結び": "إنهاء, خاتمة (فعل إنهاء شيء ما)\nمثال: إنهاء الاتفاقية / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر. / عُقْدَة\nمثال: أمضى زيري العقد. / أُونِيجِيرِي",
 "結びつき": "صِلَة, صُلَة",
 "結びつける": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ)\nمثال: انتهت المباراة بالتعادل. / رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه…)\nمثال: ربط يديه و قدميه.",
 "結びの神": "كْيُوبِيد",
 "結び付き": "صِلَة, صُلَة",
 "結び付ける": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ)\nمثال: انتهت المباراة بالتعادل. / رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه…)\nمثال: ربط يديه و قدميه.",
 "結び合す": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ)\nمثال: انتهت المباراة بالتعادل.",
 "結び合せる": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ)\nمثال: انتهت المباراة بالتعادل.",
 "結び合わす": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ)\nمثال: انتهت المباراة بالتعادل.",
 "結び合わせる": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ)\nمثال: انتهت المباراة بالتعادل.",
 "結び目": "عُقْدَة\nمثال: أمضى زيري العقد.",
 "結ぶ": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ)\nمثال: انتهت المباراة بالتعادل. / دُبّ / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا…)\nمثال: أغلق الباب بغضب / رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه…)\nمثال: ربط يديه و قدميه.",
 "結ぶ便": "رحلة ترانزيت, رحلة مواصلة (رحلة مع توقف وسيط وتغيير الطائرة (وربما تغيير شركة الطيران))",
 "結わえつける": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ)\nمثال: انتهت المباراة بالتعادل.",
 "結わえる": "أَسَرَ, رَبَطَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة.",
 "結わえ付ける": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ)\nمثال: انتهت المباراة بالتعادل.",
 "結んだ": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "結了": "إتمام, إكمال (إجراء ختامي أو نهائي)",
 "結像": "تصوير طبي, تصوير مقطعي ((طب) الحصول على صور لداخل الجسم)\nمثال: كان لا يزال يسمعها في خياله",
 "結句": "أَخِيراً",
 "結合": "تركيب, جمع (عملية دمج الأشياء لتكوين كلٍ جديد) / رباط, وصلة تثبيت (وصلة تثبت الأشياء ببعضها البعض)\nمثال: الالتصاق المتبادل للخلايا / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر.",
 "結合エネルギー": "طاقة الترابط (الطاقة اللازمة لفصل الجسيمات عن جزيء أو ذرة أو نواة؛ تساوي نقص الكتلة)",
 "結合価": "تكافؤ",
 "結合剤": "رابط, موثق (شيء يستخدم للربط أو التوثيق)",
 "結合双生児": "توأم سيامي, توأم ملتصق (أحد زوجي توأم متطابق يولد وجسماهما متصلان في نقطة ما)",
 "結合子": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح…)\nمثال: أنشؤوا جمعية سينمائية.",
 "結合性": "اتصال, ترابط (خاصية كون الشيء متصلاً أو الدرجة التي يمتلك بها الشيء اتصالات)",
 "結合確率": "احتمال مشترك (احتمال وقوع حدثين معاً)",
 "結合組織": "نسيج ضام",
 "結合組織炎": "التهاب ليفي (التهاب الأنسجة الليفية البيضاء (خاصة أغلفة العضلات))",
 "結城": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "結婚": "زَوَاج, نِكَاح",
 "結婚式": "زفاف, زواج (فعل الزواج؛ مراسم النكاح)\nمثال: تم زواجهم في الكنيسة",
 "結婚披露宴": "استقبال زفاف, حفل زفاف (حفل استقبال لضيوف الزفاف يُقام بعد مراسم الزواج)",
 "結婚指輪": "خَاتَم زَوَاج",
 "結婚相手": "زَوْج, زَوْجَة (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)\nمثال: زوجة ماري طبيبة. / خَطِيبَة",
 "結婚相談": "اسْتِشَارَة زَوْجِيَّة (تقديم المشورة بشأن المشاكل والخلافات الزوجية)",
 "結婚相談所": "وَكَالَة زَوَاج",
 "結婚祝": "هدية زفاف (هدية تُقدم لشخص مقبل على الزواج)",
 "結婚祝い": "هدية زفاف (هدية تُقدم لشخص مقبل على الزواج)",
 "結婚行進曲": "مارش الزفاف (مارش يُعزف لموكب الزفاف)",
 "結婚記念日": "ذكرى الزواج, عيد زواج (الذكرى السنوية لليوم الذي تزوجت فيه)",
 "結実": "إنجاز, تحقق (جعل الشيء حقيقياً أو ملموساً)\nمثال: كان النصر تحقيقاً لعمل سنة كاملة",
 "結尾": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري.",
 "結局": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / نَتِيجَة",
 "結局のところ": "أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية)\nمثال: في النهاية كان عليه الاستسلام",
 "結局の所": "أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية)\nمثال: في النهاية كان عليه الاستسلام",
 "結川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "結成": "تَشَكُّل",
