 "老体": "عجوز, كبير السن (شخص متقدم في السن)",
 "老功": "خبير, ذو خبرة (لديه خبرة؛ لديه معرفة أو مهارة من الملاحظة أو المشاركة)",
 "老化": "آخِذ فِي الشَّيْخُوخَة, شَائِخ (في طور التقدّم في السنّ والشيخوخة)",
 "老化防止剤": "مضاد للأكسدة (مادة تمنع الأكسدة أو تمنع التفاعلات التي يعززها الأكسجين أو البيروكسيدات)",
 "老友": "رفيق, زميل (صديق مقرب يرافق رفاقه في أنشطتهم)",
 "老境": "شَيْخُوخَة, عُجُوز",
 "老大": "عجوز, كبير السن (شخص متقدم في السن)",
 "老夫": "شَيْخ, عَجُوز",
