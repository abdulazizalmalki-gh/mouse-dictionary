 "系外惑星": "كَوْكَب خَارِج الْمَجْمُوعَة الشَّمْسِيَّة ((قديمًا) جرم سماوي من البلازما مضيئ بذاته متماسك بفعل الجاذبية؛ جرم سماوي يدور…)\nمثال: كوكب الأرض جميل.",
 "系統": "نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل. / أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم)\nمثال: كل سلالته كانت محاربين / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / سُلَالَة",
 "系統だった": "مُمَنْهَج",
 "系統だてる": "نَظَّمَ (نَظَّمَه تَنْظِيمًا:أَلَّفَه وجَمَعَه فِي سِلْكٍ فانْتَظَمَ وتَنَظَّمَ…)\nمثال: نظم سامي كل شيء.",
 "系統分類学": "علم التصنيف (علم التصنيف المنهجي)",
 "系統学": "تطوري سلالي, فيلوجيني (من أو يتعلق بالتطور السلالي للكائنات الحية)\nمثال: تطور سلالي",
 "系統樹": "شَجَرَة النَّسَب (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "系統発生": "تطور, تطور عضوي ((علم الأحياء) تسلسل الأحداث المتضمنة في التطور التطوري لنوع أو مجموعة تصنيفية…)",
 "系統的": "مُمَنْهَج",
 "系統的脱感作": "إزالة التحسس, إزالة الحساسية المنهجية (تقنية تستخدم في العلاج السلوكي لعلاج الرهاب ومشاكل السلوك الأخرى التي تنطوي على…)",
 "系統立った": "مُمَنْهَج",
 "系統立てる": "نَظَّمَ (نَظَّمَه تَنْظِيمًا:أَلَّفَه وجَمَعَه فِي سِلْكٍ فانْتَظَمَ وتَنَظَّمَ…)\nمثال: نظم سامي كل شيء.",
 "系統群": "زمرة, فَرْع حَيَوِي (مجموعة من الأصناف البيولوجية أو الأنواع التي تشترك في سمات موروثة من سلف مشترك)",
 "系譜": "علم الأنساب (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "系譜学": "علم الأنساب (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "糾う": "لَوَى, بَرَمَ",
 "糾す": "تَيَقَّنَ, تَثَبَّتَ",
 "糾合": "تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب.",
 "糾問": "استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته",
 "糾弾": "لَامَ, اِسْتَنْكَرَ (لامَ يَلوم ، لُمْ ، لَوْمًا ، فهو لائم والجمع : لُوَّمٌ ، ولُيَّمٌ وهو أَيضاً…)\nمثال: لام سامي معلمه على فشله هو.",
 "紀": "نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "紀伝": "سِيرَة, تَرْجَمَةُ ٱلْحَيَاةِ",
 "紀元": "حِقْبَة (مدة من الزمان تُقَدَّرُ بطولٍ غير محدد، وقد تكون قصيرة أو طويلة بحسب السياق…)\nمثال: لقد بدأت حقبة جديدة في الجزائر. / الحقبة العامة, العصر الحالي (في الفترة المتزامنة مع العصر المسيحي؛ يفضل استخدامها بعض الكتاب غير المسيحيين)\nمثال: في عام 200 من الحقبة العامة",
 "紀元前": "ق. م, قَبْلَ الْمِيلَاد",
 "紀元節": "24 مايو, يوم الكومنولث (بريطاني، ذكرى ميلاد الملكة فيكتوريا)",
 "紀年": "أيام, سنوات (الوقت الذي تستمر فيه حياة شخص ما)\nمثال: أيام الملك الأخيرة",
 "紀行": "فيلم سياحي, محاضرة عن الرحلات (فيلم أو محاضرة مصورة عن السفر)",
 "紀要": "بيان, موجز (تقرير موجز (خاصة بيان رسمي يصدر للنشر أو البث الفوري))",
 "約": "حَوَالَيْ, تَقْرِيبًا / وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به)\nمثال: وعد بأن يتزوجها. / تقصير (عملية الإنقاص في الطول)\nمثال: الفستان يحتاج إلى تقصير / انكماش, تقلص (عملية إنقاص (شيء ما) في الحجم أو الكثافة أو الكمية أو النطاق)\nمثال: تقلص الغاز عند التبريد",
 "約する": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به)\nمثال: وعد بأن يتزوجها. / قَصَّر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب. / قَلَّلَ",
 "約まる": "كِمادة (وسادة قماشية أو ضمادة (مع دواء أو بدونه) توضع بإحكام على جزء من الجسم (لتخفيف…)",
 "約める": "قَصَّر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "約やか": "وَجِيز, مُوجَز / مُتَوَاضِع\nمثال: لقد أزمت الوضع. / مُتْوَاضِع",
 "約分": "نَقْص",
 "約因": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "約定": "اِتِّفَاق, تَوَافُق",
 "約定済み": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به)\nمثال: وعد بأن يتزوجها.",
 "約手": "سند إذني, كمبيالة (وعد بدفع مبلغ محدد عند الطلب أو في وقت معين)\nمثال: كان علي توقيع سنده في البنك ككفيل",
 "約数": "قَاسِم, مَقْسُوم عَلَيْهِ",
 "約束": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به)\nمثال: وعد بأن يتزوجها. / مَوْعِد, مِيعَاد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد. / مُؤْتَمَر\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903. / قدر, مصير (حدث (أو مسار أحداث) سيحدث حتماً في المستقبل)\nمثال: نحن عاجزون أمام القدر",
 "約束ごと": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به)\nمثال: وعد بأن يتزوجها. / مُؤْتَمَر\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "約束された": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به)\nمثال: وعد بأن يتزوجها. / ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "約束の地": "أَرْض الْمِيعَاد (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "約束やぶる": "مخالفة اللعب (خطأ عدم اتباع نفس نوع الورقة عند القدرة على ذلك)",
 "約束をやぶる": "مخالفة اللعب (خطأ عدم اتباع نفس نوع الورقة عند القدرة على ذلك)",
 "約束を破る": "مخالفة اللعب (خطأ عدم اتباع نفس نوع الورقة عند القدرة على ذلك)",
 "約束事": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به)\nمثال: وعد بأن يتزوجها. / مُؤْتَمَر\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "約束手形": "سند إذني, كمبيالة (وعد بدفع مبلغ محدد عند الطلب أو في وقت معين)\nمثال: كان علي توقيع سنده في البنك ككفيل",
 "約束破る": "مخالفة اللعب (خطأ عدم اتباع نفس نوع الورقة عند القدرة على ذلك)",
 "約款": "اِتِّفَاق, تَوَافُق",
 "約物": "عَلَامَة تَرْقِيم (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)",
 "約言": "خُلَاصَة, مُلَخَّص",
 "約諾": "اِتِّفَاق, تَوَافُق",
 "約転": "انكماش, تقلص (عملية إنقاص (شيء ما) في الحجم أو الكثافة أو الكمية أو النطاق)\nمثال: تقلص الغاز عند التبريد",
 "約音": "انكماش, تقلص (عملية إنقاص (شيء ما) في الحجم أو الكثافة أو الكمية أو النطاق)\nمثال: تقلص الغاز عند التبريد",
 "紅": "قرمزي, ياقوتي (لون أحمر عميق وزاهٍ) / أحمر خدود (مكياج يتكون من مسحوق وردي أو أحمر يوضع على الخدين) / أَحْمَر, حُمْرَة (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون…)\nمثال: أردت حذاء أحمر. / ضَوْء أَحْمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف. / خسارة, عجز (المبلغ الذي تتجاوز به تكلفة العمل إيراداته)\nمثال: عملت الشركة بخسارة العام الماضي / اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "紅い": "أَحْمَر, حُمْرَة (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون…)\nمثال: أردت حذاء أحمر.",
 "紅いも": "يام أبيض, يام الماء (يزرع في أسترالاسيا وبولينيزيا لجذره الكبير ذو اللحم الأبيض الناعم الصالح للأكل)",
 "紅うちわ": "أنتوريوم, زهرة الفلامنغو (أي من النباتات الأمريكية الاستوائية المتنوعة التي تُزرع لأوراقها وأزهارها…)",
 "紅はこべ": "أناغالس حقلي, زهرة الطقس (عشبة ذات أزهار قرمزية أو بيضاء أو أرجوانية تغلق عند اقتراب الطقس الممطر)",
 "紅冠鳥": "كارْدِينال, كَرْدِينَال",
 "紅団扇": "أنتوريوم, زهرة الفلامنغو (أي من النباتات الأمريكية الاستوائية المتنوعة التي تُزرع لأوراقها وأزهارها…)",
 "紅土": "لاتريت (تربة حمراء ناتجة عن تحلل الصخور؛ تحتوي على رواسب غير قابلة للذوبان من أكاسيد…)",
 "紅天狗茸": "أمانيت مسكاري, فطر الذباب (فطر غابات سام (ولكن نادراً ما يكون قاتلاً) له قبعة قرمزية مع ثآليل بيضاء…)",
 "紅妙蓮寺": "جابونيكا, كاميليا يابانية (شجيرة دفيئة ذات أوراق خضراء لامعة وزهور مبهرجة عطرة تشبه الورد؛ تزرع في العديد…)",
 "紅差し指": "بِنْصِر",
 "紅斑": "حمامي (احمرار غير طبيعي في الجلد ناتج عن توسع الأوعية الدموية (كما في حروق الشمس أو…)",
 "紅斑性狼瘡": "ذئبة حمامية (مرض كولاجين التهابي مزمن يصيب الأنسجة الضامة)",
 "紅旗": "راية حمراء, نذير خطر (شيء يثير الغضب أو يتطلب إجراءً فوريًا)\nمثال: القيام بذلك يشبه التلويح بخرقة حمراء أمام ثور",
 "紅榴石": "ألمندين (عقيق أحمر غامق يتكون من سيليكات الحديد والألمنيوم)",
 "紅樹": "المنغروف",
 "紅毛": "غَرْبِيّ",
 "紅毛人": "غَرْبِيّ",
 "紅毛碧眼": "غَرْبِيّ",
 "紅海": "البَحْرُ الأَحْمَر, بَحْرُ القُلْزُم",
 "紅潮": "شطف (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن…)",
 "紅灯": "ضَوْء أَحْمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "紅炎": "بروز, شهرة (الأهمية النسبية أو الشهرة)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "紅焔": "بروز, شهرة (الأهمية النسبية أو الشهرة)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "紅玉": "يَاقُوت",
 "紅玉髄": "عقيق أحمر, كارنيليان (نوع أحمر أو برتقالي نصف شفاف من الكالسيدوني)",
 "紅白粉": "مَاكْيَاج, بُنْيَة",
 "紅白試合": "مباراة استعراضية, مباراة ودية (مباراة لا يتم تسجيل نتيجتها في الترتيب الرسمي للموسم)",
 "紅皮症": "احمرار الجلد (أي اضطراب جلدي ينطوي على احمرار غير طبيعي)",
 "紅篦鷺": "أبو ملعقة الوردي (أبو ملعقة استوائي وردي اللون من العالم الجديد)",
 "紅紫": "أُرْجُوَانِيّ مُحْمَرّ (أرجواني مع مسحة حمراء)",
 "紅色": "أَحْمَر, حُمْرَة (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون…)\nمثال: أردت حذاء أحمر.",
 "紅色植物": "طحالب حمراء (طحالب بحرية يحجب الكلوروفيل فيها صبغة حمراء أو أرجوانية؛ مصدر للأجار…)",
 "紅芋": "يام أبيض, يام الماء (يزرع في أسترالاسيا وبولينيزيا لجذره الكبير ذو اللحم الأبيض الناعم الصالح للأكل)",
 "紅花": "مُرِّيق, مُرَّيْق",
 "紅花油": "زيت العصفر (زيت مستخرج من بذور نبات العصفر)",
 "紅花隠元": "فاصولياء قرمزية (قرون فاصولياء طويلة تقطع عادةً؛ مفضلة في بريطانيا)",
 "紅茶": "شَاي أَسْوَد (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي…)\nمثال: صب الشاي لضيفك.",
 "紅茶道具一式": "طقم الشاي (مجموعة من الخزف أو الفضيات لتقديم الشاي)",
 "紅莉栖": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "紅葉": "قَيْقَب / لَحْم الْأَيِّل (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم…)\nمثال: أفضل لحم البقر.",
 "紅葉李": "برقوق كرزي, ميروبالان (شجرة آسيوية صغيرة تحمل فاكهة حمراء أو صفراء صالحة للأكل)",
 "紅葉鳥": "أَيِّل",
 "紅蓮": "قِرْمِز (القِرْمِزُ: صِبْغ أرمني أَحمر يقال إِنه من عُصارة دود يكون في آجامهم (في…)",
 "紅藻": "طحالب حمراء (طحالب بحرية يحجب الكلوروفيل فيها صبغة حمراء أو أرجوانية؛ مصدر للأجار…)",
 "紅藻類": "طحالب حمراء (طحالب بحرية يحجب الكلوروفيل فيها صبغة حمراء أو أرجوانية؛ مصدر للأجار…)",
 "紅血": "دَم, دم (فِي وَ: سائل أحمر في جسم الكائنات الحية يقوم بنقل المواد الغذائية والأكسجين إلى…)\nمثال: تبرع توم بالدم.",
 "紅衛兵": "الحرس الأحمر (حركة سياسية راديكالية للشباب الصينيين الذين تبنوا المبادئ الماوية)",
 "紅褐色": "كَسْتَنَائِيّ دَاكِن, نَبِيذِيّ (بلون بني داكن إلى أحمر أرجواني)",
 "紅貝": "فَتِيّ, مِلْؤُه الحَيَوِيَّة (مَليء بِالقُوَّة والنَّشاط والحَيَوِيَّة الدَّمَوِيَّة)",
 "紅軍": "الْجَيْش الْأَحْمَر",
 "紅輪蒲公英": "حشيشة الغراب البرتقالية (حشيشة غراب أوروبية لها رؤوس زهرية بأشعة حمراء برتقالية زاهية؛ عشب ضار مزعج خاصة…)",
 "紅野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "紅鉛鉱": "كروكوليت (معدن كرومات الرصاص النادر الذي يشكل بلورات برتقالية زاهية)",
 "紅鏡": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة…)",
 "紅顔可憐": "مُتَوَرِّد, وَرْدِيّ الخَدَّيْن (ذو بَشَرَة مُتَوَرِّدَة تَدُلّ عَلى الصِّحَّة)",
 "紅鮭": "سلمون أحمر, سلمون سوكي (سلمون صغير ذو لحم أحمر؛ يوجد في الأنهار وروافد شمال المحيط الهادئ ويُقدر كطعام…)",
 "紅鱒": "سلمون أحمر, سلمون سوكي (سلمون صغير ذو لحم أحمر؛ يوجد في الأنهار وروافد شمال المحيط الهادئ ويُقدر كطعام…)",
 "紅鶴": "بَشْرُوش, نُحَام",
 "紆": "دَوَّار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)",
 "紆余": "تَعَرَّجَ",
 "紆余曲折": "تَعَرَّجَ",
 "紆曲": "تَعَرَّجَ",
 "紊乱": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل)",
 "紋": "عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / نُمُوذَج, نَمَط / وَرَقَة لَعْب, وَرَقَة",
 "紋々": "وَشْم / نُمُوذَج, نَمَط",
 "紋切り型": "قَالَبِيّ, نَمَطِيّ (يَتَّسِمُ بِاتِّبَاعِ صِيغَةٍ أَوْ قَالَبٍ مُعَيَّن)",
 "紋切型": "قَالَبِيّ, نَمَطِيّ (يَتَّسِمُ بِاتِّبَاعِ صِيغَةٍ أَوْ قَالَبٍ مُعَيَّن)",
 "紋日": "عِيد\nمثال: ذهب سامي في عطلة.",
 "紋様": "نُمُوذَج, نَمَط",
 "紋標": "عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / وَرَقَة لَعْب, وَرَقَة",
 "紋章": "عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر)",
 "紋章学": "عِلْم شِعَارات النَبَالَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "紋紋": "وَشْم / نُمُوذَج, نَمَط",
 "納まらない": "غَيْرُ مُرْتَاح, قَلِق (مَشْغُول البَال وَغَيْر مُطْمَئِنّ)",
 "納まり": "نَتِيجَة / رَصِيد",
 "納まる": "هَدَأَ\nمثال: استقر زيري في خيمته. / اِحْتَلَّ (الموضعَ: نزل به وكان لغيره قبله؛ الجيشُ البلدَ: فتحها ثم نزل بها غصبا عن أهلها…) / رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع)\nمثال: السكوت علامة الرضا.",
 "納む": "كَرَّسَ, قَدَّمَ / زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / خَزَنَ (حفظ، إدخر، أودع في مخزن) / فَرَغَ, أَنْهَى\nمثال: انتهى أمر زيري.",
 "納め": "النِهاية",
 "納める": "وَضَعَ, حَطَّ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن. / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل. / اِحْتَفَظَ, أَبْقَى",
 "納付": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن.",
 "納付者": "دَافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو…)\nمثال: دافع عن الضعفاء.",
 "納付金": "مُسَاهَمَة (المُساهَمَة : المُشاركة والاشتراك في الشيء)\nمثال: ويستطيع الجميع المساهمة.",
 "納会": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
