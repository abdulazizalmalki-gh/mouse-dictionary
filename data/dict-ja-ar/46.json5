 "繁殖地": "مرتع, مفقس (مكان تتكاثر فيه الحيوانات)",
 "繁殖期": "موسم التزاوج, موسم التكاثر (موسم التكاثر هو الموسم الأنسب، وعادة ما يكون بظروف مواتية ووفرة في الغذاء والماء، للتكاثر)",
 "繁殖牝馬": "فرس ولود (أنثى حصان تستخدم للتربية)",
 "繁殖用": "حِضْنَة, صغار (صغار حيوان يتم رعايتهم في وقت واحد)",
 "繁用": "انشغال, دبيب (حالة الوجود أو الظهور بمظهر المنشغل بنشاط ما)\nمثال: أظهروا كل نشاط مجموعة من القنادس",
 "繁盛": "اِزْدِهَار, رَخَاء",
 "繁縷": "أذن الفأر, حشيشة القزاز (أي من النباتات المتنوعة المرتبطة بحشيشة القزاز الشائعة) / حشيشة القزاز, ستيلاريا",
 "繁苛": "صَارِم",
 "繁茂": "رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو)",
 "繁華": "صخب, ضجة (اضطراب نشط وسريع) / إطار التنورة, بستل (هيكل يُلبس في الخلف أسفل الخصر لإعطاء امتلاء لتنورة المرأة)",
 "繁華街": "المنطقة التجارية, حي تجاري (المنطقة المركزية أو المركز التجاري لبلدة أو مدينة)\nمثال: قلب وسط مدينة برمنغهام",
 "繁里": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "繁雑": "مَعْقِد / عُقْدَة",
 "繊六本": "جوليان (حساء صافي مزين بخضروات مقطعة شرائح رفيعة (جوليان)) / جوليان, خضار مقطع شرائح (خضار مقطع إلى شرائح رفيعة)",
 "繊度": "جودة ممتازة, دقة (جودة كون الشيء جيداً جداً بالفعل) / دَمَاثَة, رِقَّة (صفة الجمال والرقة في المظهر) / دقة, نعومة (امتلاك ملمس دقيق جداً) / دِقّة, رِقّة (خاصية كون الشيء ضيقاً جداً أو رقيقاً)\nمثال: يتميز النزل بدقة مأكولاته",
 "繊弱": "دقيق, رقيق (ناعم ولطيف وممتع بشكل رائع؛ عرضة للتلف) / رَقِيق, سَهْلُ الكَسْر (يَسْهُلُ كَسْرُهُ أَوْ إِتْلَافُهُ أَوْ تَدْمِيرُهُ) / حَسَّاس, دَقِيق (صَعْب المُعَالَجَة؛ يَسْتَلْزِم لَبَاقَةً كَبِيرَة) / دَقِيقٌ, رَقِيقٌ (بالغ الدقة والرهافة في التطوير)\nمثال: مقطع كمان رقيق",
 "繊月": "هِلَال",
 "繊条": "فتيل (سلك رفيع (عادة من التنجستن) يسخن حتى التوهج الأبيض بمرور تيار كهربائي) / خيط, خييط (بنية تشبه الخيط (كسلسلة من الخلايا تشبه السلسلة)) / خيط (ساق السداة) / خيط دقيق, لييفة (ليفة طبيعية أو اصطناعية رفيعة جداً)",
 "繊毛": "هدب (نتوء يشبه الشعر من سطح الخلية؛ يوفر الحركة في الكائنات وحيدة الخلية حرة السباحة) / رِمْش, هُدْب (أي من الشعيرات القصيرة المنحنية التي تنمو من حواف الجفون)",
 "繊毛虫": "أوالي هدبية, هدبيات (أوالي له زوائد مجهرية تمتد من سطح الخلية) / ذُو أَهْدَاب, مُهَدَّب (ذو حافة أو هُدب من نتوءات شعريّة دقيقة) / هدبي (متعلق بالرموش البشرية) / هدبي (متعلق بالأهداب البارزة من سطح الخلية)",
 "繊細": "أَنِيق, بَدِيع (ذُو جَمَالٍ رَقِيقٍ وَدَقِيق) / مُتَقَزِّز, مُتَنَطِّع (مُفْرِط فِي التَّدْقِيق وَسَرِيع الاشْمِئْزَاز) / شَهِيّ, لَطِيفُ المَذَاق (مُمْتِعٌ لِلذَّوْقِ بِشَكْلٍ خَاصّ) / أطايب, طعام شهي (شيء يُعتبر فاخراً أو لذيذاً للأكل) / ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "繊維": "لِيف",
 "繊維がん": "ورم ليفي (ورم غير خبيث من النسيج الضام)",
 "繊維ガラス": "ألياف زجاجية (مادة تغطية مصنوعة من ألياف زجاجية في راتنجات)",
 "繊維光学": "ألياف بصرية (نقل الإشارات الضوئية عبر ألياف زجاجية)",
 "繊維工場": "مصنع نسيج (مصنع لصنع المنسوجات)",
 "繊維性": "عَصَبِيّ, لِيفِيّ ((يوصف به اللحم) مليء بالأوتار؛ خاصة يستحيل مضغه) / قِنَّبِيّ, لِيفِيّ (ذو ألياف أو يشبه الألياف خاصة تلك المستخدمة في صناعة الحبال)",
 "繊維束": "حزمة ألياف, حزمة عصبية (حزمة من الألياف (خاصة الألياف العصبية)) / كراسة, ملزمة (جزء من عمل مطبوع)",
 "繊維板": "فايبر بورد, لوح حبيبي (لوح جداري يتكون من رقائق الخشب أو النشارة المترابطة مع الراتنج والمضغوطة في أوراق صلبة)",
 "繊維状": "عَصَبِيّ, لِيفِيّ ((يوصف به اللحم) مليء بالأوتار؛ خاصة يستحيل مضغه) / قِنَّبِيّ, لِيفِيّ (ذو ألياف أو يشبه الألياف خاصة تلك المستخدمة في صناعة الحبال)",
 "繊維症": "تليف (تطور النسيج الضام الليفي الزائد في عضو ما)",
 "繊維癌": "ورم ليفي (ورم غير خبيث من النسيج الضام)",
 "繊維素": "سِلْيُولُوز / فيبرين (بروتين ليفي أبيض غير قابل للذوبان يتكون بفعل الثرومبين على الفيبرينوجين عند تخثر الدم)",
 "繊維素原": "فيبرينوجين (بروتين موجود في بلازما الدم؛ يتحول إلى فيبرين عندما يتجلط الدم)",
 "繊維組織": "نسيج ليفي (نسيج يتكون من أو يحتوي على ألياف في كل من الحيوانات والنباتات)",
 "繊維腫": "ورم ليفي (ورم غير خبيث من النسيج الضام)",
 "繋がり": "صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "繋がる": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه. / رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه) / مَدَّدَ / اِمْتَدَّ",
 "繋ぎ": "وَصْلَة / حشوة (التبغ المستخدم لتشكيل لب السيجار) / تِكملة, حشو (أي شيء يضاف لإكمال الكل) / حشو, مادة لملء الفراغ (نسخة لملء الفراغ بين المقالات الأكثر أهمية في تخطيط مجلة أو صحيفة) / فيلر (100 فيلر تساوي 1 فورنت في المجر)\nمثال: بعض العناصر في المجموعة مجرد تكملة / مادة مكثفة, مكثف (أي مادة تستخدم للتثخين)\nمثال: يستخدم النشا في الطهي كمكثف / تحوط, مراوغة (بيان غير ملزم أو غامض عمداً) / تحوط (أي تقنية مصممة لتقليل أو القضاء على المخاطر المالية؛ على سبيل المثال، اتخاذ موقفين يعوض كل منهما الآخر إذا تغيرت الأسعار)\nمثال: عندما تقول 'ربما' فأنت تتحوط فقط",
 "繋ぎあわせる": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
 "繋ぎ合わせる": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
 "繋ぎ売り": "تحوط, مراوغة (بيان غير ملزم أو غامض عمداً) / تحوط (أي تقنية مصممة لتقليل أو القضاء على المخاطر المالية؛ على سبيل المثال، اتخاذ موقفين يعوض كل منهما الآخر إذا تغيرت الأسعار)\nمثال: عندما تقول 'ربما' فأنت تتحوط فقط",
 "繋ぎ服": "إِجْمَالِيّ, شَامِل (يتناول السمات الرئيسية فقط) / إِجْمَالِيّ, شَامِل (يشمل كل شيء بلا استثناء) / أفرول, سروال عمل ((عادة جمع) ملابس عمل تتكون من سراويل دنيم (عادة بمريلة وحمالات كتف)) / أفرول, بدلة عمل (رداء واقٍ فضفاض أو مريول يرتدى فوق الملابس العادية للعمل المتسخ)",
 "繋ぎ止める": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل. / آمن, مرتاح البال (خالٍ من الخوف أو الشك؛ مرتاح البال) / آمن, محصن (خالٍ من الخطر أو المجازفة) / ثابت, متين (ليس من المحتمل أن يفشل أو ينهار) / آمِن, مَضْمُون (آمن ماليًّا ويمكن الاعتماد عليه)\nمثال: كان مطمئناً بأنه لن يُحاسب على أي شيء",
 "繋ぎ留める": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل. / آمن, مرتاح البال (خالٍ من الخوف أو الشك؛ مرتاح البال) / آمن, محصن (خالٍ من الخطر أو المجازفة) / ثابت, متين (ليس من المحتمل أن يفشل أو ينهار) / آمِن, مَضْمُون (آمن ماليًّا ويمكن الاعتماد عليه)\nمثال: كان مطمئناً بأنه لن يُحاسب على أي شيء",
 "繋ぎ目": "مُشْتَرَك / مِفْصَل",
 "繋ぐ": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه. / تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل. / حَافَظَ / حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "繋げる": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه. / تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل. / حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "繋留": "حبل إرساء ((مصطلح بحري) حبل يثبت جسماً (خاصة القارب) في مكانه) / مربط, مرسى (مكان يمكن فيه تثبيت القارب أو السفينة)",
 "繋縛": "متطلب",
 "繋船柱": "عمود حاجز, مربط (عمود قوي (كما في رصيف الميناء أو السفينة لربط حبال الإرساء))\nمثال: أغلق الطريق أمام حركة المركبات باستخدام الأعمدة الحاجزة",
 "繋辞": "رَابِطَة, رَابِط",
 "繋駕": "عِنان",
 "繋駕競走": "سباق التروت, سباق العربات الخفيفة (سباق خيل بين أشخاص يركبون عربات خفيفة خلف خيول تهرول أو تسير بخطى سريعة)",
 "繋駕速歩競走": "سباق التروت, سباق العربات الخفيفة (سباق خيل بين أشخاص يركبون عربات خفيفة خلف خيول تهرول أو تسير بخطى سريعة)",
 "繍匠": "مُطَرِّز, طَرَّاز",
 "織": "نَسَجَ",
 "織り": "نَسَجَ",
 "織り地": "مَلْمَس / قُمَاش, نَسِيج (النسيج الذي لم يُقَصّ أو يُخَاط)\nمثال: الورق و القماش يمتصان الماء.",
 "織り女": "اَلنَّسْر اَلْوَاقِع",
 "織り姫": "اَلنَّسْر اَلْوَاقِع",
 "織り子": "نَسَّاج, نَسَّاجَة / تَنَوُّط",
 "織り工": "نَسَّاج, نَسَّاجَة / تَنَوُّط",
 "織り機": "مِنْسَج",
 "織り目": "مَلْمَس",
 "織り糸": "خيط, سلسلة (قلادة مصنوعة من ربط أشياء ببعضها) / جديلة, خصلة (خيط يتكون من مجموعة معقدة من الألياف أو الشعيرات المجدولة معاً لتشكيل خيط أو حبل أو كابل) / خيط (نمط يشكل وحدة داخل كل هيكلي أكبر) / ساحل, شاطئ (مصطلح شعري للشاطئ (كمنطقة تغطيها وتكشفها المد والجزر بشكل دوري))\nمثال: خيط من الخرز",
 "織り込み": "إدماج, دمج (التضمين عن طريق الدمج) / تأسيس, دمج (دمج شيئين أو أكثر؛ الاتحاد في (أو ضمن) هيئة واحدة) / استدماج, تذويت (التعلم (للقيم أو المواقف وما إلى ذلك) الذي يتم دمجها داخل الذات)",
 "織り込み済み": "خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "織り込む": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة.",
 "織る": "نَسَجَ",
 "織地": "مَلْمَس / قُمَاش, نَسِيج (النسيج الذي لم يُقَصّ أو يُخَاط)\nمثال: الورق و القماش يمتصان الماء.",
 "織女": "اَلنَّسْر اَلْوَاقِع",
 "織女星": "اَلنَّسْر اَلْوَاقِع",
 "織姫": "اَلنَّسْر اَلْوَاقِع",
 "織工": "نَسَّاج, نَسَّاجَة / تَنَوُّط",
 "織機": "مِنْسَج",
 "織物": "نسيجي (من أو متعلق بالأقمشة أو صناعة النسيج) / قماش, مادة (مادة مصنوعة عن طريق نسج أو تلبيد أو حياكة أو حبك ألياف طبيعية أو صناعية)\nمثال: بحث نسيجي",
 "織物の耳": "برسل, حاشية القماش (حافة القماش المنسوجة بحيث لا تنسل أو تتآكل) / حاشية السجاد (حد يتكون من هدب زخرفي في أحد طرفي السجادة الشرقية)",
 "織物商": "بَزَّاز",
 "織田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "織目": "مَلْمَس",
 "織込み": "إدماج, دمج (التضمين عن طريق الدمج) / تأسيس, دمج (دمج شيئين أو أكثر؛ الاتحاد في (أو ضمن) هيئة واحدة) / استدماج, تذويت (التعلم (للقيم أو المواقف وما إلى ذلك) الذي يتم دمجها داخل الذات)",
 "繕い": "إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / ملابس للرتق (الملابس التي يجب إصلاحها)",
 "繕う": "أَصْلَحَ / صَلَّحَ / عَالَجَ",
 "繖形花序": "خيمة, نورة خيمية (نورة مسطحة القمة أو مستديرة تميز الفصيلة الخيمية حيث تنشأ سيقان الزهور الفردية من نفس النقطة تقريبًا؛ الزهور الأصغر سنًا تكون في المركز)",
 "繖房花序": "عذق, نورة عذقية (نورة مسطحة القمة أو محدبة تنمو فيها سيقان الزهور الفردية للأعلى من نقاط مختلفة على الساق الرئيسية لتصل إلى نفس الارتفاع تقريبًا؛ الزهور الخارجية تفتح…)",
 "繚乱": "بغزارة, بوفرة (بطريقة وفيرة)\nمثال: تم تزويدهم بالطعام بوفرة",
 "繞": "حَرْف صِينِيّ, طَابِع صِينِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)",
 "繞く": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه)",
 "繞る": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه)",
 "繡匠": "مُطَرِّز, طَرَّاز",
 "繩": "حَبْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "繩目": "عُقْدَة / عَقَدَ (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد. / تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "繫げる": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه. / تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل. / حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "繭": "شَرْنَقَة (غشاء واق من خيوط دقيقة تنسجه بعض الحشرات حولها كدودة القز، لتحتمي به في طَوْر من أطوار حياتها)",
 "繭玉": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "繭糸": "حرير الذرة, شواشي الذرة (كل من الأقلام الخيطية الطويلة التي تنمو كخصلة حريرية عند طرف كوز الذرة)",
 "繭紬": "بونجي (قماش رقيق ناعم منسوج من الحرير الخام (أو تقليد له))",
 "繰り上げ": "يقرب",
 "繰り上げる": "يقرب",
 "繰り下がる": "اِسْتَعَارَ (مجازي)",
 "繰り下げ": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق) / انتظار, تأجيل (الوقت الذي يتم فيه انتظار إجراء ما)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً",
 "繰り下げる": "أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "繰り入れる": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "繰り出しはしご": "سلم قابل للتمديد (سلم يمكن تمديد طوله)",
 "繰り出しばしご": "سلم قابل للتمديد (سلم يمكن تمديد طوله)",
 "繰り出し梯子": "سلم قابل للتمديد (سلم يمكن تمديد طوله)",
 "繰り出す": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / قَطِيع / تَهَافَتَ, تَقَاطَرَ / مِزْقَة / إرسال, إيفاد (فعل إرسال شيء ما) / إجهاز, قتل (قتل شخص أو حيوان (بسرعة)) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً) / برقية, بلاغ (تقرير رسمي (يرسل عادة على عجل))\nمثال: تم إنجازه بسرعة وكفاءة / اندفاع (فعل التحرك للأمام فجأة) / اندفاعة ((مبارزة) طعنة هجومية تتم بقدم واحدة للأمام والساق الخلفية مستقيمة وذراع السيف ممدودة للأمام)",
 "繰り回す": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "繰り広げる": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "繰り延べ": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق) / انتظار, تأجيل (الوقت الذي يتم فيه انتظار إجراء ما)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً",
 "繰り延べる": "أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "繰り形": "سبك, صب (فعل إنشاء شيء ما عن طريق صبه في قالب) / تشكيل, نمذجة (نحت أولي من الشمع أو الطين يمكن نسخ العمل النهائي منه) / قولبة, نحت طيني (نحت يتم إنتاجه بالقولبة) / إفريز, قولبة (سطح زخرفي غائر أو بارز على الحافة)",
 "繰り戸": "باب منزلق (باب يفتح عن طريق الانزلاق بدلاً من التأرجح)",
 "繰り替える": "تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ",
 "繰り糸": "بَكَرَة",
 "繰り言": "تَكْرَار, إِعَادَة / تَنَافُر",
 "繰り越し": "نقل التدريب, نقل التعلم (تطبيق مهارة تم تعلمها في موقف ما على موقف مختلف ولكنه مشابه) / أَرْبَاح مُرَحَّلَة, فَائِض مُرَحَّل (الأرباح المتراكمة وغير الموزعة لشركة ما بعد رصد مخصصات للأرباح الموزعة والاحتياطيات)",
 "繰り越す": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "繰り込む": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة. / إرسال, إيفاد (فعل إرسال شيء ما) / إجهاز, قتل (قتل شخص أو حيوان (بسرعة)) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً) / برقية, بلاغ (تقرير رسمي (يرسل عادة على عجل))\nمثال: تم إنجازه بسرعة وكفاءة",
 "繰り返し": "تَكْرَار, إِعَادَة / مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "繰り返す": "كَرَّرَ, أَعَادَ (أَعَادَ)\nمثال: كرر الشهادة بعدي.",
 "繰る": "بَكَرَة / دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار. / عَدَّ / كُونْت",
 "繰上": "يقرب",
 "繰上げ": "يقرب",
 "繰上げる": "يقرب",
 "繰下げ": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق) / انتظار, تأجيل (الوقت الذي يتم فيه انتظار إجراء ما)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً",
 "繰下げる": "أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "繰入れる": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
