 "管理上": "إداري (متعلق بالإدارة أو مسؤول عنها)",
 "管理人": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير. / أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات)",
 "管理体制": "نِظَامْ إِدَارَةْ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "管理価格": "سعر إداري, سعر مُدار (سعر تمليه أي هيئة غير قوى السوق)",
 "管理員": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير.",
 "管理士": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير.",
 "管理売春": "قِوَادَة",
 "管理官": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير.",
 "管理権": "وكالة تنظيمية (وكالة حكومية تنظم الأعمال التجارية من أجل المصلحة العامة)",
 "管理機": "غَيْر آلِيّ, يَدَوِيّ التَّشْغِيل (يعمل باليد وبتشغيل يدوي)",
 "管理監督者": "مُشْرِف, مُشْرِفَة",
 "管理者": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير. / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "管理職": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة…)\nمثال: والدتي تنتظرني في الإدارة.",
 "管理責任": "كَفَاءَة (مصدر؛ المماثلة والمساواة في القُوَّة والشَرَف، وقد يكون في المَال والعِلْم…)\nمثال: ياني لديه الكفاءة لذلك.",
 "管理領域": "دكتور في الطب (درجة الدكتوراه في الطب)\nمثال: شعرت بسوء شديد فذهبت لرؤية طبيبي",
 "管籥": "زِرّ",
 "管継手": "تركيبات أنابيب, وصلة أنابيب (تجهيزة تتكون من قطع أنابيب مسننة لربط الأنابيب ببعضها)",
 "管腔": "لُومِن",
 "管財": "حراسة, وصاية (منصب الحارس أو الوصي)",
 "管財人": "عُضْو مَجْلِس أُمَناء, وَصِيّ (أعضاء في مجلس حاكم أو مجلس أمناء)",
 "管足": "قدم أنبوبية (ناتئ أنبوبي ذو مجسات لمعظم شوكيات الجلد (نجم البحر وقنفذ البحر وخيار البحر) له…)",
 "管路": "خَطّ أَنَابِيب (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "管轄": "قَضَاء",
 "管鑰": "زِرّ",
 "管領": "سَيْطَرَ\nمثال: من أنت لتحكم علي؟",
 "箪笥": "كُمُودِينُو, أَدْرَاجِيَّة",
 "箱": "صُنْدُوق, صَنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها…)\nمثال: أين صندوق البريد؟ / سَيَّارَة, عَرَبِيَّة (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة. / شَامِيسِين / بِرَاز, سَلْح",
 "箱亀": "سلحفاة صندوقية (سلحفاة برية بشكل رئيسي من أمريكا الشمالية؛ يمكن إغلاق صدفتها بإحكام)",
 "箱企業": "شركة صورية, شركة وهمية (شركة مؤسسة ولكن ليس لديها أصول أو عمليات)",
 "箱入り": "فِي عُلْبَة, مُغَلَّف (محاط بغلاف أو علبة) / ثَمِين",
 "箱型": "شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته)",
 "箱形": "شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته)",
 "箱河豚": "سمكة الصندوق (أي من الأسماك الاستوائية الصغيرة العديدة التي يكون جسمها ورأسها مغلفين بصفائح…)",
 "箱物": "شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته)",
 "箱眼鏡": "ساعة مائية, كليبسيدرا (ساعة تقيس الوقت عن طريق تدفق الماء)",
 "箱舟": "سَفِينَة, فُلْك (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "箱船": "سَفِينَة, فُلْك (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "箱詰": "مُلَاكَمَة",
 "箱詰め": "مُلَاكَمَة",
 "箱馬車": "شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته)",
 "箴": "تَحْذِير, إِنْذار / مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "箴言": "مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / اَلْأَمْثَال",
 "箶簏": "جَعْبَة",
 "箶籙": "جَعْبَة",
 "箸": "أَعْوَاد الْأَكْل, هَاشِي",
 "箸がすすむ": "مُشَهٍّ (يجذب أو يحفز الشهية خاصة في المظهر أو الرائحة)",
 "箸が進む": "مُشَهٍّ (يجذب أو يحفز الشهية خاصة في المظهر أو الرائحة)",
 "箸にも棒にもかからない": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "箸にも棒にも引っかからない": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "箸にも棒にも引っ掛からない": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "箸にも棒にも掛からない": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "箸を取る": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ.",
 "箸休め": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له)",
 "箸尾": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "節": "فُرْصَة, مُنَاسَبَة\nمثال: أرى مرآة مناسبة / قِسْم, جُزْء (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ…)\nمثال: أنا أزين القسم. / جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة! / مَوْسِم / مُشْتَرَك / لَحْن (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن. / عُقْدَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "節々": "مُشْتَرَك\nمثال: 体の節々が痛いです。 — مفاصلي تؤلمني. / مَفْصِل, مِفْتَاح",
 "節する": "أَنْقَذَ, أَنْجَى\nمثال: حفظ رقم هاتفها.",
 "節介": "تدخل, تلاعب (فعل تغيير شيء ما سراً أو بشكل غير لائق)",
 "節付け": "مُؤَلَّف, مُصَنَّف",
 "節倹": "اِقْتِصَاد (بمعنى واصل عمل القصائد؛ بمعنى تَوَسَّط في الانفاق فلم يسرف ولم يقتر)\nمثال: ابني يدرس الاقتصاد.",
 "節分": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "節制": "اِعْتِدَال (الوَسَطِيَّة، يقابله التَطَرُّف؛ التَنَاسُب وأن يكون الأمر عَدْلا، يقابله…)\nمثال: الاعتدال هو اليوم الذي يتساوى به الليل و النهار بنفس المدة.",
 "節回し": "لَحْن, أُغْنِيَّة (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن.",
 "節奏": "إِيقَاع",
 "節季": "النِهاية",
 "節季払い": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "節度": "اِعْتِدَال (الوَسَطِيَّة، يقابله التَطَرُّف؛ التَنَاسُب وأن يكون الأمر عَدْلا، يقابله…)\nمثال: الاعتدال هو اليوم الذي يتساوى به الليل و النهار بنفس المدة.",
 "節慾": "امتناع, تعفف (فعل أو ممارسة الامتناع عن الانغماس في شهوة ما)",
 "節振る舞い": "السَّنَة الْجَدِيدَة",
 "節振舞": "السَّنَة الْجَدِيدَة",
 "節振舞い": "السَّنَة الْجَدِيدَة",
 "節操": "أَمَانَة, نَزَاهَة",
 "節操がない": "عَدِيم المَبَادِئ (يفتقر إلى النزاهة أو المبادئ الأخلاقيَّة)\nمثال: التحرر من الافتراء الفظ غير المبدئي",
 "節操が無い": "عَدِيم المَبَادِئ (يفتقر إلى النزاهة أو المبادئ الأخلاقيَّة)\nمثال: التحرر من الافتراء الفظ غير المبدئي",
 "節果": "ثمرة قرنية مقسمة, خريدلة (قرون بذور متضيقة بين البذور وتتفكك عند النضج إلى شرائح أحادية البذرة)",
 "節欲": "امتناع, تعفف (فعل أو ممارسة الامتناع عن الانغماس في شهوة ما)",
 "節水": "حفظ المياه (الحفاظ على موارد المياه)",
 "節減": "تقشف, تقليص النفقات (تخفيض النفقات من أجل الاستقرار المالي)",
 "節点": "عُقْدَة / مُشْتَرَك",
 "節理": "مُشْتَرَك / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل.",
 "節目": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه. / عُقْدَة\nمثال: أمضى زيري العقد.",
 "節税": "تجنب ضريبي (تقليل المسؤولية الضريبية إلى الحد الأدنى بطرق قانونية)",
 "節穴": "ثقب العقدة (ثقب في لوح خشبي حيث سقطت منه عقدة) / رؤية نفقية (ضعف بصري ينطوي على فقدان الرؤية المحيطية)",
 "節節": "مُشْتَرَك\nمثال: 体の節々が痛いです。 — مفاصلي تؤلمني. / مَفْصِل, مِفْتَاح",
 "節約": "خَصْم, حَسْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه…)",
 "節約家": "مُخَلِّص, مُنْقِذ (شخص ينقذ شيئاً أو شخصاً من خطر أو عنف)",
 "節足動物": "مفصلي, مفصلي الأرجل (حيوان لا فقاري له أطراف مفصلية وجسم مقسم مع هيكل خارجي مصنوع من الكيتين)",
 "節酒": "تعديل, تلطيف (عملية التلطيف أو المزج المعتدل)",
 "節間": "سُلَامِيَّة (جزء من ساق النبات يقع بين عقدتين)",
 "篁": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "範": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون. / نَمُوذَج / مُنْحَدَر / مِثَال, مَثَل",
 "範例": "مِثَال, مَثَل",
 "範列": "نَمَط",
 "範囲": "اِتِّسَاع, مَدَّى",
 "範式": "نَمُوذَج / صِيغَة",
 "範疇": "فِئَة (هي الجماعة المُتَظَاهِرَة التي يرجع بعضها إلى بعض في التعاضد؛ هي الطائفة…)\nمثال: سأقدم طلبي في إطار فئة أخرى.",
 "篇": "تأليف, تجميع (فعل التجميع (كما في كتاب واحد أو ملف أو قائمة))\nمثال: استغرقت وظيفة تجميع المخزون عدة ساعات / حَجْم (حجّم الشّيء:وضع حجماً محدّداً له ، قَلَّلَ دوره وهَمَّشَه، قلّل تأثيره؛ حجّم:…)\nمثال: ما حجم البالون؟",
 "篇章": "مُؤَلَّف, مُصَنَّف",
 "築き上げる": "بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر…)\nمثال: بنى سامي منزلا. / خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "築く": "بَنَى (أَقَامَ شيئا مثل الجدران و السفن باستخدام مواد مثل الخشب والطَّابُوق والحَجَر…)\nمثال: بنى سامي منزلا. / وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "築城": "مَعْقِل (الملجأ والجبل المرتفع)\nمثال: رغم أن إيران مشهورة بأنها معقل الفكر الشيعي في عصرنا، إلا أن معظم أهلها كانوا من السنة حتى القرن الخامس عشر.",
 "築堤": "جسر ترابي, ساتر ترابي (كومة اصطناعية طويلة من الحجر أو التراب؛ تبنى لحجز المياه أو لدعم طريق أو للحماية)",
 "築庭": "تنسيق الحدائق (العمل كبستاني مناظر طبيعية)",
 "築港": "تَرْكِيبِيّ, مَصْنُوع (ليس من أصل طبيعي؛ أُعِدّ أو صُنِع صناعيًّا)",
 "築造": "بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "篗": "بَكَرَة",
 "篝": "مَجْمَرَة, مَنْقَل / مَشْعَل",
 "篝火": "مَشْعَل",
 "篝火草": ":بخور مريم",
 "篠": "قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)\nمثال: دخلت شظية في إصبعه",
