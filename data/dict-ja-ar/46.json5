 "紙鑢": "وَرَق زُجَاج (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "紙面": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "紙飛行機": "طَائِرَة وَرَقِيَّة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر)\nمثال: لقد وصلت الطائرة.",
 "紙鳶": "طَائِرَة وَرَقِيَّة, طيارة ورق (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر)",
 "級": "دَرَجَة\nمثال: 彼は１０年級に在学中だ。 — هو في الصف العاشر. / صِنْف, صَنْف / طَبَقَة / فَصْل, صَفّ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)\nمثال: اقرأ هذا الفصل.",
 "級の木": "زيزفون ياباني (شجرة متوسطة الحجم من اليابان تستخدم للزينة)",
 "級別": "تصحيح, وضع الدرجات (تقييم الأداء عن طريق تعيين درجة أو نتيجة) / تسوية الأرض, تمهيد (تغيير مستوى الأرض إلى سطح أفقي أملس أو منحدر بلطف) / تدرج, تصنيف (فعل الترتيب في سلسلة متدرجة)\nمثال: ما كرهه في التدريس هو كل التصحيح الذي كان عليه القيام به",
 "級友": "زَمِيل دِرَاسَة, رَفِيق صَفّ",
 "級数": "سِلْسِلَة, مَجْمُوعَة / مُسَلْسَلَات تِلِفِزْيُونِيَّة, مُسَلْسِلَات / مُتَسَلْسِلَة, سِلْسِلَة",
 "紛々": "اِحْتَارَ / تَشَوَّش / اِرْتَبَكَ, تَشَوَّش",
 "紛い": "تَقْلِيد",
 "紛いもない": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "紛い物": "تَقْلِيد",
 "紛うことなき": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "紛うこと無き": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "紛う事なき": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "紛う事無き": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "紛う方なき": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "紛う方なく": "بلا شك, من دون شك (بدون شك؛ بالتأكيد)\nمثال: إنه بلا شك جميل جداً",
 "紛える": "قَلَّدَ",
 "紛らす": "أَلْهَى / أَخْفَى",
 "紛らせる": "أَلْهَى / أَخْفَى",
 "紛らわしい": "مُرْبِك",
 "紛らわす": "أَلْهَى / أَخْفَى",
 "紛れ": "تريماتودا, مثقوبات (ديدان مفلطحة طفيلية لها ممصات خارجية للالتصاق بالمضيف) / فلق (أي من فصي ذيل الحيتان) / سن المرساة, مخلب المرساة (نتوء مسطح يشبه النصل على ذراع المرساة) / سن الخطاف (شوكة في حربة أو سهم) / اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك. / لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "紛れもない": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "紛れも無い": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "紛れ当たり": "تريماتودا, مثقوبات (ديدان مفلطحة طفيلية لها ممصات خارجية للالتصاق بالمضيف) / فلق (أي من فصي ذيل الحيتان) / سن المرساة, مخلب المرساة (نتوء مسطح يشبه النصل على ذراع المرساة) / سن الخطاف (شوكة في حربة أو سهم)",
 "紛乱": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "紛争": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول)\nمثال: شمال مالي منطقة نزاع.",
 "紛争国": "مُمَزَّقٌ بِالحَرْب (خَرَّبَتْهُ الحَرْبُ وَدَمَّرَتْه)",
 "紛争地": "بؤرة توتر, نقطة ساخنة (مكان للاضطرابات السياسية والعنف المحتمل) / بؤرة توتر, نقطة اضطراب (مكان توجد فيه المشاكل أو تحدث بانتظام)\nمثال: لا تستطيع الولايات المتحدة مراقبة جميع النقاط الساخنة في العالم",
 "紛失": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة",
 "紛擾": "إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما) / شِجَار عَلَنِيّ, عِرَاك (قتال صاخب) / إزعاج, اضطراب (نشاط يمثل خللاً أو تطفلاً أو انقطاعاً) / تداخل, تشويش (نشاط كهربائي أو صوتي يمكن أن يزعج الاتصالات)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي",
 "紛然": "اِحْتَارَ / تَشَوَّش / اِرْتَبَكَ, تَشَوَّش",
 "紛糾": "تَعْقِيد / مُضَاعَفَة",
 "紛紛": "اِحْتَارَ / تَشَوَّش / اِرْتَبَكَ, تَشَوَّش",
 "紛議": "تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / تنافر, خلاف (صراع في آراء الناس أو أفعالهم أو طباعهم)",
 "素": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل / قَاعِدَة, أَسَاس / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية. / مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / مُمْتَاز, فَاخِر / مَبْدَأ, قاعِدَة (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه) / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / بحيرة صغيرة, بركة (بركة صغيرة من المياه الراكدة) / بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "素っ": "أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "素っぴん": "اعتدال, رصانة (الامتناع عن الإفراط) / رصانة, وقار (أسلوب جاد ورزين) / رصانة, صحو (الاعتدال في أو الامتناع عن الكحول أو المخدرات الأخرى) / رزانة, صحو (حالة كونه صاحياً وغير مسكر بالكحول)",
 "素っ気ない": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "素っ気無い": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "素っ破": "جَاسُوس / تَجَسَّسَ / لِصّ, لِصَّة / ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "素っ裸": "عُرْي / عَارٍ تَمَاماً ((غير رسمي) عارٍ تماماً بلا أي ملابس) / فقير",
 "素っ頓狂": "مُتَوَحِّش / بَرِّيّ",
 "素っ飛ぶ": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة. / اِحْتَجَبَ, إخْتَفَى (وضع أمامه حجابا فلم يُعَد يُرى؛ وضع له حاجبا)",
 "素っ首": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "素で": "بصدق, حقاً (وفقاً للحقيقة أو الواقع) / بِأَصَالَة, بِحَقّ (بشكل حقيقي؛ بسلطة)\nمثال: أصبحت الآن أمريكية حقاً",
 "素もぐり": "غطس, غوص حر (السباحة تحت الماء دون أي معدات تنفس أكثر من أنبوب التنفس)",
 "素人": "هَاوٍ, هَاوِيَة",
 "素人下宿": "بنزيون, نزل داخلي (منزل خاص يوفر الإقامة والوجبات للضيوف مقابل أجر)",
 "素人臭い": "غَيْر مَاهِر, هَاوٍ (يفتقر إلى المهارة أو الخبرة المهنية)",
 "素体": "بيبلو, تمثال صغير (تمثال صغير منحوت أو مقولب)",
 "素囊": "مَحْصُول / حَوْصَلة",
 "素因": "استعداد مسبق, تأهب (استعداد مسبق للتفاعل بطريقة معينة) / استعداد مسبق, تهيؤ (ميل مسبق لتفسير الأمور بطريقة معينة) / حساسية, قابلية الإصابة (القابلية للإصابة بمسببات الأمراض)",
 "素因数": "عَامِل أَوَّلِيّ (العوامل الأولية لكمية ما هي جميع الكميات الأولية التي تقسم الكمية المعطاة بالتمام)",
 "素地": "قُمَاش, أقمشة (النسيج الذي لم يُقَصّ أو يُخَاط) / مِمْسَحَة\nمثال: الورق و القماش يمتصان الماء. / عَجِين, عَجِينَة / ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود) / مستلزمات, مقومات ((عادة بصيغة الجمع) المكونات اللازمة لصنع أو فعل شيء ما) / كَفَاءَة, مُؤَهِّل (سمة يجب الوفاء بها أو الامتثال لها وتجعل الشخص مناسباً لشيء ما)\nمثال: ابتكار الخطط / أساس, عمل تمهيدي (إعداد أولي كأساس أو قاعدة) / أساس (أدنى دعامة لهيكل ما) / أساس, حجر الزاوية (الافتراضات الأساسية التي يبدأ منها شيء ما أو يتطور أو يُحسب أو يُشرح)\nمثال: نحن مستعدون اليوم بسبب العمل التمهيدي الذي تم قبل عشر سنوات",
 "素姓": "وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / مُطَابَقَة / هُوِيَّة / مسقط الرأس, منشأ (المكان الذي نشأ فيه شيء ما أو تمت رعايته في بداية وجوده)\nمثال: مهد الحضارة",
 "素子": "عُنْصُر كِيمِيَائِيّ, عُنْصُر (الْأَصْل؛ الجِنْس)\nمثال: المغنيزيوم عنصر كيميائي. / بَيَانَات, مَعْلُومَات",
 "素封家": "ثري, غني (شخص يمتلك ثروة مادية كبيرة)",
 "素志": "عَرِيق, قَدِيم العَهْد (مَوْجود مُنْذُ فَتْرَة طَويلَة)",
 "素性": "وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / مُطَابَقَة / هُوِيَّة / مسقط الرأس, منشأ (المكان الذي نشأ فيه شيء ما أو تمت رعايته في بداية وجوده)\nمثال: مهد الحضارة / مِيزَة / صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "素意": "عَرِيق, قَدِيم العَهْد (مَوْجود مُنْذُ فَتْرَة طَويلَة)",
 "素手で": "فَارِغ اليَدَيْن (لَا يَحْمِلُ شَيْئًا فِي يَدَيْه) / خَالِي الوِفَاض, صِفْر اليَدَيْن (لم يكتسب أو يحصل على شيء)",
 "素拍子": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "素振": "سُلُوك, تَصَرُّف",
 "素振り": "سُلُوك, تَصَرُّف",
 "素描": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / لَخَّصَ, اِخْتَصَرَ",
 "素数": "عَدَد أَوَّلِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "素敵": "جَمِيل, مَحْبُوب (يخاطب العواطف والعين معاً) / جَذَّاب, فَاتِن (محبوب خاصة بطريقة طفولية أو ساذجة) / فتاة الغلاف (فتاة جميلة جداً تعمل كعارضة للمصورين)",
 "素早い": "سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي.",
 "素晴らしき": "عَظِيم, رَائِع (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم.",
 "素晴らしさ": "مَجْد (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد به)\nمثال: المجد لأوكرانيا",
 "素朴": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "素朴実在論": "واقعية, واقعية ساذجة ((فلسفة) المذهب الفلسفي القائل بأن الأشياء المادية تستمر في الوجود عندما لا يتم إدراكها)",
 "素材": "مُقَوِّم / الموضوع، مادة البحث",
 "素案": "مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "素気ない": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "素気無い": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "素湯": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "素潜り": "غطس, غوص حر (السباحة تحت الماء دون أي معدات تنفس أكثر من أنبوب التنفس)",
 "素焼": "بيسك, حساء القشطة البحرية (حساء كريمي كثيف مصنوع من المحار)",
 "素焼き": "بيسك, حساء القشطة البحرية (حساء كريمي كثيف مصنوع من المحار)",
 "素片": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "素牛": "عِجْل (أسرع في إنجاز شيء أو القيام به؛ قدم شيئًا قبل وقته المعتاد) / دَغْفَل, حُوَار / بَطَّة, رَبْلَةُ (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق) / بَطْن اَلسَّاق (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: أنا في عجلة من أمري.",
 "素生": "وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / مُطَابَقَة / هُوِيَّة / مسقط الرأس, منشأ (المكان الذي نشأ فيه شيء ما أو تمت رعايته في بداية وجوده)\nمثال: مهد الحضارة",
 "素直": "مُطِيع, مُذْعِن / نَزِيه, صَادِق\nمثال: 思っていることを素直に言うのは悪いことではありません。 — قول ما تفكر فيه بصراحة ليس أمرًا سيئًا. / مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم. / مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "素知らぬ": "مُتَصَنَّع, مُصْطَنَع (غَيْر حَقِيقِيّ؛ مُفْتَعَل)",
 "素粒子": "جُسَيْم أَوَّلِيّ (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى مستحدث))\nمثال: نحن نعيش بعض اللحظات الحزينة حقا لأن بلادنا عانت من خسارة جسيمة. وسوف يستغرق وقتا طويلا قبل أن تعود إلى مجدها السابق.",
 "素粒子の相互作用": "تفاعل, تفاعل أساسي ((في الفيزياء) نقل الطاقة بين الجسيمات الأولية أو بين جسيم أولي ومجال أو بين المجالات؛ يتوسطه بوزونات قياس)",
 "素粒子加速器": "مُعَجِّل جُسَيْمَات",
 "素粒子物理学": "فيزياء الجسيمات (علم الطَّبيعة أو علم الطَّبيعيَّات)\nمثال: تدرس الفيزياء النووية.",
 "素行": "تصرف, سلوك (طريقة التصرف أو التحكم بالنفس) / سلوك ((علم النفس) مجموع الاستجابات أو ردود الفعل أو الحركات التي يقوم بها الكائن الحي في أي موقف) / تصرف, سلوك ((السمات السلوكية) الطريقة التي يتصرف بها الشخص تجاه الآخرين) / أداء, تصرف (فعل أو رد فعل شيء ما (مثل آلة أو مادة) تحت ظروف محددة)\nمثال: يمكن دراسة سلوك الجسيمات الصغيرة في التجارب",
 "素行が修まらない": "فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف)",
 "素行不良": "سوء تصرف, سوء سلوك (سلوك غير لائق أو شرير أو غير أخلاقي)",
 "素行障害": "سِي دِي",
 "素裸": "عُرْي / عَارٍ تَمَاماً ((غير رسمي) عارٍ تماماً بلا أي ملابس) / فقير",
 "素裸足": "حَافٍ, حَافِي (مال أو انحرف عن الشيء؛ سار على حافة الشيء أو حام حوله) / حافي القدمين (حَفِيَ، الذي لا يرتدي حِذَاء أو نَعَال أو غيره من لباس القَدَمَيْن)\nمثال: وقف على حافة الجرف.",
 "素見": "مُدَاعَبَة, مُمَازَحَة (ردود خفيفة مازحة) / رعي, قضم الأوراق (فعل التغذية عن طريق القضم المستمر) / تصفح (القراءة بشكل سطحي أو عشوائي)",
 "素見す": "مُدَاعَبَة, مُمَازَحَة (ردود خفيفة مازحة) / بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا.",
 "素質": "ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود) / مستلزمات, مقومات ((عادة بصيغة الجمع) المكونات اللازمة لصنع أو فعل شيء ما) / كَفَاءَة, مُؤَهِّل (سمة يجب الوفاء بها أو الامتثال لها وتجعل الشخص مناسباً لشيء ما)\nمثال: ابتكار الخطط / طَبِيعَة, طبيعة",
 "素跣": "حَافٍ, حَافِي (مال أو انحرف عن الشيء؛ سار على حافة الشيء أو حام حوله) / حافي القدمين (حَفِيَ، الذي لا يرتدي حِذَاء أو نَعَال أو غيره من لباس القَدَمَيْن)\nمثال: وقف على حافة الجرف.",
 "素跣足": "حَافٍ, حَافِي (مال أو انحرف عن الشيء؛ سار على حافة الشيء أو حام حوله) / حافي القدمين (حَفِيَ، الذي لا يرتدي حِذَاء أو نَعَال أو غيره من لباس القَدَمَيْن)\nمثال: وقف على حافة الجرف.",
 "素通し": "شَفَّاف",
 "素面": "اعتدال, رصانة (الامتناع عن الإفراط) / رصانة, وقار (أسلوب جاد ورزين) / رصانة, صحو (الاعتدال في أو الامتناع عن الكحول أو المخدرات الأخرى) / رزانة, صحو (حالة كونه صاحياً وغير مسكر بالكحول)",
 "素顔": "اعتدال, رصانة (الامتناع عن الإفراط) / رصانة, وقار (أسلوب جاد ورزين) / رصانة, صحو (الاعتدال في أو الامتناع عن الكحول أو المخدرات الأخرى) / رزانة, صحو (حالة كونه صاحياً وغير مسكر بالكحول)",
 "素養": "تأريض (توصيل المعدات الكهربائية بالأرض) / أساس, تأسيس (التعليم أو التوجيه في أساسيات مجال من مجالات المعرفة)\nمثال: يفتقر إلى التأسيس اللازم للدراسة المتقدمة",
 "素麺南瓜": "قرع السباغيتي (قرع بيضاوي متوسط الحجم ذو لب على شكل خيوط تشبه السباغيتي) / قرع السباغيتي (نبات قرع يحمل ثماراً بيضاوية بقشرة صفراء ناعمة ولب طري خيطي يشبه السباغيتي)",
 "紡ぎ糸": "خيط مغزول ((مصطلح بحري) حبال صغيرة تتكون من حبل خفيف الوزن مصنوع من عدة خيوط حبال ملفوفة معاً برخاوة)",
 "紡ぐ": "رَدَنَ, غَزَلَ (رَدَنَ رَدْنًا: غزل الرَّدَن أو غزل بالمِردَن؛ ويقال: رَدَنَ الثوبَ: نسجه بالغزل المردون)",
 "紡機": "آلة غزل (آلة نسيج لغزل الخيوط والخيوط)",
 "紡糸": "غزل (صنع الخيوط)",
 "紡績": "غزل (صنع الخيوط) / خيط مغزول ((مصطلح بحري) حبال صغيرة تتكون من حبل خفيف الوزن مصنوع من عدة خيوط حبال ملفوفة معاً برخاوة)",
 "紡績工": "طعم دوار (طعم للصياد؛ يدور عند سحبه عبر الماء) / دوارة, قرص دوار (من معدات ألعاب الطاولة تتكون من قرص وسهم يتم تدويره لتحديد الحركة التالية في اللعبة) / غزّال (شخص يغزل (يبرم الألياف لتصبح خيوطاً))",
 "紡績工場": "محلج قطن, مصنع قطن (مصنع نسيج لصنع المنسوجات القطنية)",
 "紡績機": "آلة غزل (آلة نسيج لغزل الخيوط والخيوط)",
 "紡績機械": "آلة غزل (آلة نسيج لغزل الخيوط والخيوط)",
 "紡績糸": "خيط مغزول ((مصطلح بحري) حبال صغيرة تتكون من حبل خفيف الوزن مصنوع من عدة خيوط حبال ملفوفة معاً برخاوة)",
 "紡績絹糸": "حرير مغزول (خيط مصنوع من نفايات الحرير)\nمثال: عمل الغازل هو تقويم هذه الألياف بمساعدة الآلات، ثم ضمها معاً لتصبح خيطاً يُعرف بالحرير المغزول",
 "紡車": "عَجَلَة الْمِغْزَل",
 "紡錘": "مِغْزَل",
 "紡錘体": "مِغْزَل",
 "紡錘形": "سِيجَارِيّ الشَّكْل, مِغْزَلِيّ (مستدق من كلا الطرفين)",
 "索": "حَبْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "索具": "تَجْهِيزَات السَّفِينَة, صَوَارِي وَشِرَاع (تشكيل الصواري والعوارض والأشرعة وغيرها على السفينة) / تجهيزات الصاري, حبال السفينة (معدات تتكون من حبال وما إلى ذلك تدعم سواري السفينة وأشرعتها)",
 "索寞": "قَاتِم, كَئِيب (يبعث على الحزن والكآبة) / رَتِيب, كَئِيب (يفتقر إلى الحيوية أو السحر أو المفاجأة)",
 "索引": "دَلِيل, فِهْرِس / فِهْرِس (كِتَاب تجمع فيه أسماء الكتب بترتيب يسهل منه إجاد العنوان المراد البحث عنه؛ فَصْل أو بَاب في أول أو آخر الكتاب ترتب فيه الأبواب والفصول ومواضعها ليسهل منه إيجاد المطلوب)",
 "索引付け": "فهرسة (فعل تصنيف وتوفير فهرس لجعل العناصر أسهل في الاسترجاع)",
 "索引作業": "فهرسة (فعل تصنيف وتوفير فهرس لجعل العناصر أسهل في الاسترجاع)",
 "索条": "كَابْل",
 "索条鉄道": "سكة حديد بالكابلات, قطار جبلي مائل (سكة حديد صاعدة على جانب جبل يتم سحبها بواسطة كابل متحرك ولها عربات صاعدة وهابطة متوازنة)",
 "索梯": "سلم حبال (سلم ذو جوانب مصنوعة من الحبال)",
 "索漠": "قَاتِم, كَئِيب (يبعث على الحزن والكآبة) / رَتِيب, كَئِيب (يفتقر إلى الحيوية أو السحر أو المفاجأة)",
 "索然": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "索莫": "قَاتِم, كَئِيب (يبعث على الحزن والكآبة) / رَتِيب, كَئِيب (يفتقر إلى الحيوية أو السحر أو المفاجأة)",
 "索道": "ترامواي, تلفريك (وسيلة نقل تنقل الركاب أو البضائع في عربات معلقة بكابلات ومحمولة بواسطة سلسلة من الأبراج)",
 "索道鉄道": "سكة حديد بالكابلات, قطار جبلي مائل (سكة حديد صاعدة على جانب جبل يتم سحبها بواسطة كابل متحرك ولها عربات صاعدة وهابطة متوازنة)",
 "索餌": "بحث عن الطعام (فعل البحث عن الطعام والمؤن)",
 "紫": "بَنَفْسَجِيّ / أُرْجُوَانِيّ / صَلْصَةْ اَلصُّويَا",
 "紫がかった": "أُرْجُوَانِيّ, بَنَفْسَجِيّ (بلون متوسط بين الأحمر والأزرق)",
 "紫っぽい": "أُرْجُوَانِيّ, بَنَفْسَجِيّ (بلون متوسط بين الأحمر والأزرق)",
 "紫はしどい": "لَيْلَك / لَيْلَكِيّ",
 "紫丁香花": "لَيْلَك / لَيْلَكِيّ",
 "紫君子蘭": "أغابانثوس, زنبق أفريقي (نبات أفريقي بأوراق خضراء زاهية دائمة الخضرة ومظلات من العديد من الزهور البنفسجية الزرقاء العميقة عادة)",
 "紫外": "فَوْقَ البَنَفْسَجِيّ (ذُو أَطْوَالٍ مَوْجِيَّةٍ أَقْصَرَ مِنَ الضَّوْءِ المَرْئِيِّ وَأَطْوَلَ مِنَ الأَشِعَّةِ السِّينِيَّة) / أشعة فوق بنفسجية (إشعاع يقع في النطاق فوق البنفسجي؛ أطوال موجية أقصر من الضوء ولكن أطول من الأشعة السينية)",
 "紫外光": "أشعة فوق بنفسجية (إشعاع يقع في النطاق فوق البنفسجي؛ أطوال موجية أقصر من الضوء ولكن أطول من الأشعة السينية)",
 "紫外線": "أشعة فوق بنفسجية (إشعاع يقع في النطاق فوق البنفسجي؛ أطوال موجية أقصر من الضوء ولكن أطول من الأشعة السينية)",
 "紫外線療法": "أشعة فوق بنفسجية (إشعاع يقع في النطاق فوق البنفسجي؛ أطوال موجية أقصر من الضوء ولكن أطول من الأشعة السينية)",
 "紫弁慶草": "أوربين, سدم تليفيوم (نبات معمر شمالي معتدل بأوراق مسننة ورؤوس من الزهور البيضاء الأرجوانية الصغيرة)",
 "紫御殿": "اليهودي التائه (يهودي أسطوري حُكم عليه بالتجوال في العالم لسخريته من المسيح عند الصلب)",
 "紫斑": "فرفرية (أي من عدة أمراض دموية تسبب نزيفاً تحت الجلد)",
 "紫斑病": "فرفرية (أي من عدة أمراض دموية تسبب نزيفاً تحت الجلد)",
 "紫檀": "خشب الورد, شجرة خشب الورد (أي من تلك الأشجار الخشبية الصلبة من جنس دالبيرجيا التي تنتج خشب الورد - أخشاب خزائن قيمة ذات لون أحمر داكن أو أرجواني مخطط ومبرقش بالأسود) / خشب الورد (خشب محمر داكن صلب لشجرة خشب الورد له عروق مميزة بقوة؛ يستخدم في الخزائن)",
 "紫水晶": "جَمَشْت",
 "紫煙": "دخان التبغ (الدخان الناتج عن حرق المنتجات المصنوعة من أوراق التبغ المجففة، مثل السجائر)\nمثال: يجب أن تقلع عن التدخين، ألا تعلم أن دخان التبغ يحتوي على مواد ضارة؟",
 "紫燕": "سنونو أرجواني (سنونو كبير من أمريكا الشمالية يتميز الذكر منه بلون أزرق مسود)",
 "紫猿子": "عصفور أرجواني (عصفور من أمريكا الشمالية له رأس وصدر وردي محمر)",
 "紫石英": "جَمَشْت",
 "紫綬褒章": "ميدالية الشرف, وسام الشرف (أعلى وسام عسكري أمريكي يُمنح للشجاعة والإقدام في العمليات 'فوق وخارج نداء الواجب')",
 "紫色": "بَنَفْسَجِيّ / أُرْجُوَانِيّ",
 "紫花豆": "فاصولياء قرمزية (قرون فاصولياء طويلة تقطع عادةً؛ مفضلة في بريطانيا) / فاصولياء العداء القرمزي, فاصولياء قرمزية (فاصولياء استوائية أمريكية ذات زهور حمراء وفاصولياء سوداء مرقطة تشبه الفاصولياء الشائعة ولكنها معمرة؛ وهي فاصولياء مفضلة للأكل في بريطانيا العظمى)",
 "紫苑": "النَّجْم, قَسِيم نَجْمِيّ (بنية نجمية الشكل تتشكل في سيتوبلازم الخلية لها ألياف تشبه الأشعة تحيط بالجسيم المركزي أثناء الانقسام المتساوي) / أستر, نجمة (أي من أعشاب مختلفة تزهر غالباً في الخريف من جنس أستر ذات زهور مبهرجة تشبه الأقحوان)",
 "紫菀": "النَّجْم, قَسِيم نَجْمِيّ (بنية نجمية الشكل تتشكل في سيتوبلازم الخلية لها ألياف تشبه الأشعة تحيط بالجسيم المركزي أثناء الانقسام المتساوي) / أستر, نجمة (أي من أعشاب مختلفة تزهر غالباً في الخريف من جنس أستر ذات زهور مبهرجة تشبه الأقحوان)",
 "紫菜": "نُورِي\nمثال: うちの猫は大変海苔が好きである。 — قطة منزلنا تحب النوري كثيرًا.",
 "紫蘇": "إيريسين, نبات شريحة اللحم (نبات أمريكي جنوبي ذو فروع خضراء إلى أرجوانية أو حمراء بأوراق زينة خضراء إلى أرجوانية وسنابل من زهور صوفية غير مهمة بقنابات غشائية جافة) / بريلا, نبات شريحة اللحم (نبات يزرع لأوراقه الحمراء أو الأرجوانية الزخرفية)",
 "紫蘭": "بليتيلا مخططة (أوركيد ياباني بأوراق مخططة بالأبيض وعناقيد منتصبة نحيلة من الزهور الوردية إلى الأرجوانية؛ يزرع غالباً؛ يوضع أحياناً في جنس بليتيا)",
 "紫衣": "عَالِيّ الرُتْبَة",
 "紫詰草": "نفل المروج, نفل بنفسجي (نبات معمر قصير العمر، منتصب إلى منبطح، ذو أزهار حمراء أرجوانية إلى وردية؛ أكثر أنواع نفل العلف زراعة)",
 "紫陽花": "كوبية, هيدرانجيا (أي من الشجيرات النفضية أو دائمة الخضرة المتنوعة من جنس كوبية)",
 "紫雲": "الزي الأرجواني ((الكنيسة الكاثوليكية) الزي الرسمي للكاردينال؛ سمي بذلك نسبة للون الأرجواني للرداء) / الأرجوان, المنصب الإمبراطوري ((في روما القديمة) منصب ذو وضع إمبراطوري)",
 "紫電": "البَرْق",
 "紫馬肥": "فَصْفَص",
 "紬": "بونجي (قماش رقيق ناعم منسوج من الحرير الخام (أو تقليد له))",
 "紮げる": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
 "累": "مُشْكِلَة, مَتاعِب",
 "累乗": "أسس, رفع لقوة (عملية رفع كمية إلى قوة معينة)",
 "累代": "أيون, دهر ((الغنوصية) قوة إلهية أو طبيعة تنبثق من الكائن الأسمى وتلعب أدواراً مختلفة في عمل الكون) / حقب, دهر (فترة زمنية طويلة لا يمكن قياسها) / دهر (أطول قسم في الزمن الجيولوجي)",
 "累加": "تَسَارُع (عَجَلَة، تزايُد السرعة بالنسبة إلى الزمن في جسم من الأَجسام المتحرِّكة؛ إِسْرَاعٍ وَتَسَابُقٍ فِي الجَرْيِ)\nمثال: تسارع السائق بسيارته.",
 "累加的": "تَرَاكُمِيّ, تَصَاعُدِيّ (يزداد بالإضافة المتتالية)",
 "累囚": "سَجِين, سَجِينَة",
 "累次": "مُتَتَابِع, مُتَتَالٍ",
 "累沢": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "累減": "رجعي, نكوصي (يعارض التقدم؛ يعود إلى حالة سابقة أقل تقدماً) / تنازلي ((للضرائب) معدلة بحيث ينخفض المعدل مع زيادة الدخل)",
 "累犯": "عَوْد (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "累積": "تجميع, تراكم (عملية التراكم) / تجميع, تشكيلة (أشياء عديدة مجمعة معًا أو تعتبر ككل) / أرباح محتجزة, تراكم الأرباح ((تمويل) الأرباح التي لا تُدفع كتوزيعات أرباح ولكن تضاف إلى القاعدة الرأسمالية للشركة) / تراكم, تكدس (زيادة عن طريق النمو الطبيعي أو الإضافة) / تَرَاكُمِيّ, تَصَاعُدِيّ (يزداد بالإضافة المتتالية)",
 "累積投票": "تصويت تراكمي (انتخاب يمتلك فيه كل شخص عددًا من الأصوات يساوي عدد المناصب التي سيتم شغلها، ويمكنه إعطاؤها جميعًا لمرشح واحد أو توزيعها)",
 "累積的": "تَرَاكُمِيّ, تَصَاعُدِيّ (يزداد بالإضافة المتتالية)",
 "累算": "مَجْمُوع",
 "累算器": "سجل المركم, مركم ((علم الحاسوب) سجل يحتوي على جامع مدمج يضيف رقم إدخال إلى محتويات السجل) / بطارية تخزين, مركم (بطارية فولتية تخزن الشحنة الكهربائية) / جابي, حصل (شخص يعمل لتحصيل المدفوعات (مثل الإيجار أو الضرائب))",
