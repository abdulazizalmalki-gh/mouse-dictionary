 "縮みあがる": "تَجَمَّدَ / قَلَّصَ (جعل الشيء أصغر حجمًا أو أقل مقدارًا؛ اختصر أو قلل من شيء معين) / تَقَلَّصَ, أَحْجَمَ",
 "縮みこむ": "قَلَّصَ (جعل الشيء أصغر حجمًا أو أقل مقدارًا؛ اختصر أو قلل من شيء معين) / تَقَلَّصَ, أَحْجَمَ",
 "縮み上がる": "تَجَمَّدَ / قَلَّصَ (جعل الشيء أصغر حجمًا أو أقل مقدارًا؛ اختصر أو قلل من شيء معين) / تَقَلَّصَ, أَحْجَمَ",
 "縮み込む": "قَلَّصَ (جعل الشيء أصغر حجمًا أو أقل مقدارًا؛ اختصر أو قلل من شيء معين) / تَقَلَّصَ, أَحْجَمَ",
 "縮む": "قَلَّصَ (جعل الشيء أصغر حجمًا أو أقل مقدارًا؛ اختصر أو قلل من شيء معين) / تَقَلَّصَ, أَحْجَمَ",
 "縮める": "قَصَّرَ (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب. / جَعْدَة / تَجَعُّد, جَعْدَة / بَطَّة, بط (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق) / بَطَّة (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق)\nمثال: إني أصوب على تلك البطة.",
 "縮らす": "جَعْدَة",
 "縮らせる": "جَعْدَة",
 "縮れ": "تَجْعِيْد",
 "縮合": "تكثيف, تكميد (فعل زيادة كثافة شيء ما) / تكثيف ((التحليل النفسي) عملية لاواعية تتحد فيها فكرتان أو صورتان في رمز واحد؛ خاصة في الأحلام) / إيجاز, تهذيب (نسخة مختصرة من عمل مكتوب) / انضغاط, تقلص (عملية أو نتيجة أن يصبح الشيء أصغر أو مضغوطاً معاً)\nمثال: تقلص الغاز عند التبريد",
 "縮図": "صورة مصغرة, كون مصغر (نموذج مصغر لشيء ما)",
 "縮図器": "مِنْسَاخ / سَنْجَة تَوْصِيل",
 "縮小": "نَقْص",
 "縮小命令セットコンピュータ": "حاسوب بمجموعة تعليمات مقلصة, ريسك ((علم الحاسوب) نوع من معمارية الحاسوب يحتوي على مجموعة صغيرة نسبياً من تعليمات الحاسوب التي يمكنه تنفيذها)",
 "縮尺": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف",
 "縮帆": "شَعَاب",
 "縮減": "نَقْص",
 "縮瞳": "تقبض الحدقة, منعكس الضوء (انكماش انعكاسي للعضلة العاصرة للقزحية استجابة لضوء ساطع (أو أدوية معينة) مما يسبب صغر حجم الحدقة) / انقسام اختزالي, انقسام منصف ((علم الوراثة) انقسام الخلية الذي ينتج خلايا تناسلية في الكائنات التي تتكاثر جنسيًا؛ تنقسم النواة إلى أربع نوى تحتوي كل منها على نصف عدد الكروموسومات)",
 "縮約": "إيجاز, تهذيب (نسخة مختصرة من عمل مكتوب) / انكماش, تقلص (عملية إنقاص (شيء ما) في الحجم أو الكثافة أو الكمية أو النطاق) / انقباض, تقلص عضلي ((فسيولوجيا) تقصير أو توتر جزء أو عضو (خاصة العضلة أو الألياف العضلية)) / إدغام, اختصار لفظي (كلمة تتكون من كلمتين أو أكثر عن طريق حذف أو دمج بعض الأصوات) / انضغاط, تقلص (عملية أو نتيجة أن يصبح الشيء أصغر أو مضغوطاً معاً)\nمثال: تقلص الغاز عند التبريد",
 "縮約版": "إيجاز, تهذيب (نسخة مختصرة من عمل مكتوب)",
 "縮絨": "مُمْتَلِئ, مَلِيء / شِبَع, شبعان",
 "縮絨工": "قَصَّار",
 "縮緬": "كريب (قماش خفيف ناعم ورقيق ذو سطح مجعد) / فطيرة فرنسية رقيقة, كريب (فطيرة صغيرة رقيقة جداً) / ورق كريب, ورق مكشكش (ورق ذو ملمس مجعد؛ عادة ما يكون ملوناً ويستخدم للزينة)",
 "縮緬紙": "ورق كريب, ورق مكشكش (ورق ذو ملمس مجعد؛ عادة ما يكون ملوناً ويستخدم للزينة)",
 "縮退": "انحطاط أخلاقي, انحلال (انحراف أخلاقي؛ إفساد للفضيلة والمبادئ الأخلاقية) / انحلال, تدهور (حالة كونه منحطاً في الصفات العقلية أو الأخلاقية)\nمثال: الرفاهية والفساد بين الطبقات العليا / انحطاط, تحقير (التغيير إلى حالة أدنى (حالة أقل احتراماً)) / اتضاع, انحطاط (حالة متدنية أو منكسرة)\nمثال: كل اعتراف جلبها إلى حالة من الانحطاط",
 "縮重": "انحطاط أخلاقي, انحلال (انحراف أخلاقي؛ إفساد للفضيلة والمبادئ الأخلاقية) / انحلال, تدهور (حالة كونه منحطاً في الصفات العقلية أو الأخلاقية)\nمثال: الرفاهية والفساد بين الطبقات العليا",
 "縲囚": "سَجِين, سَجِينَة",
 "縷々": "بِالتَّفْصِيل, تَفْصِيلًا / دَائِم, لَا يَنْقَطِع (غَيْرُ مُنْقَطِعٍ فِي الزَّمَنِ وَمُسْتَمِرٌّ إِلَى أَجَلٍ غَيْرِ مُسَمًّى) / أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى)",
 "縷紅草": "أثمان ريشي, كرمة السرو (متسلق حولي أمريكي استوائي له زهور حمراء (وأحياناً بيضاء) وأوراق مقطعة بدقة؛ تم توطينه في الولايات المتحدة وأماكن أخرى)",
 "縷縷": "بِالتَّفْصِيل, تَفْصِيلًا / دَائِم, لَا يَنْقَطِع (غَيْرُ مُنْقَطِعٍ فِي الزَّمَنِ وَمُسْتَمِرٌّ إِلَى أَجَلٍ غَيْرِ مُسَمًّى) / أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى)",
 "縹": "سَمَاوِيّ, لَبَنِيّ",
 "縹渺": "بِلَا حُدُود, لَامَحْدُود (يَبْدُو بِلَا حُدُودٍ فِي الكَمِّيَّةِ أَوِ العَدَدِ أَوِ الدَّرَجَةِ أَوِ المَدَى) / إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "縹眇": "بِلَا حُدُود, لَامَحْدُود (يَبْدُو بِلَا حُدُودٍ فِي الكَمِّيَّةِ أَوِ العَدَدِ أَوِ الدَّرَجَةِ أَوِ المَدَى) / إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "縹緲": "بِلَا حُدُود, لَامَحْدُود (يَبْدُو بِلَا حُدُودٍ فِي الكَمِّيَّةِ أَوِ العَدَدِ أَوِ الدَّرَجَةِ أَوِ المَدَى) / إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "縺れ": "تشابك, متاهة (شيء مختلط أو مشوش) / كُتْلَة مُتَشَابِكَة (كتلة ملتوية ومتشابكة ومتداخلة للغاية)\nمثال: تشابك من اللوائح الحكومية / تَعْقِيد / مُضَاعَفَة",
 "縺れる": "تشابك, متاهة (شيء مختلط أو مشوش) / كُتْلَة مُتَشَابِكَة (كتلة ملتوية ومتشابكة ومتداخلة للغاية)\nمثال: تشابك من اللوائح الحكومية",
 "績む": "رَدَنَ, غَزَلَ (رَدَنَ رَدْنًا: غزل الرَّدَن أو غزل بالمِردَن؛ ويقال: رَدَنَ الثوبَ: نسجه بالغزل المردون)",
 "繁": "تَعْقِيد / حُرُوف صِينِيَّة تَقْلِيدِيَّة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟",
 "繁い": "مُتَكَرِّر / اِرْتَادَ (لأهله: ذهب أمامهم رائدًا ليجد النجعة والكلاء؛ المكانَ: كان من روّادِه، أي من الذين كانوا فيه منذ البدء) / سَمِيك, غَلِيظ / غَلِيظ",
 "繁く": "غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة",
