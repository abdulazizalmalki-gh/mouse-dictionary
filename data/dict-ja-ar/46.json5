 "粘液水腫": "وذمة مخاطية (قصور الغدة الدرقية يتميز بجفاف الجلد وتورمات حول الشفتين والأنف بالإضافة إلى التدهور العقلي)",
 "粘液細菌": "بكتيريا مخاطية, ميكسوبكتيريا (بكتيريا تشكل مستعمرات في مادة لزجة تنتجها ذاتياً؛ تعيش في التربة الرطبة أو المواد النباتية المتحللة أو فضلات الحيوانات)",
 "粘液腫": "ورم مخاطي (ورم حميد في النسيج الضام يحتوي على مادة تشبه الهلام)",
 "粘液酸": "حمض الميوسيك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "粘滑": "دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة)",
 "粘漿剤": "ملطف",
 "粘漿薬": "ملطف",
 "粘着": "تماسك ((في الفيزياء) القوة بين الجزيئية التي تربط جزيئات مادة صلبة أو سائلة معاً) / التحام, تلاصق ((علم النبات) العملية في بعض النباتات حيث تنمو الأجزاء معًا والتي عادة ما تكون منفصلة (مثل البتلات)) / تلاحم, تماسك (حالة التماسك أو الالتصاق معاً) / تماسك نصي, سبك ((في اللغويات) الربط النحوي والمعجمي داخل نص أو جملة مما يربط النص ببعضه ويعطيه معنى)",
 "粘着テープ": "شَرِيط لَاصِق",
 "粘着剤": "لَاصِق, مُلْتَصِق (يميل إلى الالتصاق) / مادة لاصقة (مادة توحد أو تربط الأسطح ببعضها البعض)",
 "粘着力": "لُزُوجَة (مصدر الفعل \"لَزِجَ\"؛ (في الفيزياء) تماسكُ أجزاء المادّة السَّائلة بعضِها ببعض تماسكًا يقاوم سيولتَها بحيث لا يتغيّر شكلها بسهولة، كالقطران والعسل وغيرهما)",
 "粘着性": "اِلْتِصَاق",
 "粘着質": "حَثِيث, دَائِم (لَا يَتَوَقَّفُ أَبَدًا) / مُلَازِمٌ لِلذِّهْن, مُلِحّ (يَعُودُ إِلَى الذِّهْنِ بِاسْتِمْرَارٍ) / دائم, مستديم (باقٍ؛ لا يسقط) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: الأوراق المستديمة تبقى ملتصقة بعد النضج / دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة) / لَاصِق, لَزِق (مُغطّى بمادّة لاصقة) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج)",
 "粘稠": "لَزِج",
 "粘結": "كَعْكَة (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "粘結剤": "رابط, موثق (شيء يستخدم للربط أو التوثيق) / حافظة ملفات, مجلد (أداة لحفظ الأوراق السائبة أو المجلات) / آلة حصاد وربط (آلة تقطع الحبوب وتربطها في حزم) / رابط, مادة رابطة (شيء يستخدم لربط الجسيمات المنفصلة ببعضها البعض أو تسهيل الالتصاق بسطح ما)",
 "粘膜": "غشاء مخاطي, مخاطية (غشاء يفرز المخاط يبطن جميع تجاويف الجسم أو الممرات التي تتصل بالخارج)",
 "粘膜下層": "تحت المخاطية (النسيج الضام الموجود تحت الغشاء المخاطي)",
 "粘菌": "عفن غروي حقيقي, ميكسوميسيت (عفن غروي من طائفة الميكسوميسيت)",
 "粘質": "لَزِج",
 "粛": "جَادّ, صَادِق (يتّسم بإيمان ثابت وجادّ بأهمية الشيء ذاته) / رَزِين, وَقُور (يتّسم بالوقار والرصانة في الطبع والسلوك) / صَامِت, سَاكِت",
 "粛々": "صَامِت, سَاكِت",
 "粛として": "برصانة, بمهابة (بطريقة جادة ورصينة)\nمثال: جلس القاضي هناك بمهابة / بِهُدُوء",
 "粛啓": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "粛殺": "مُبِيد, مُدَمِّر (يَتَسَبَّبُ أَوْ يَقْدِرُ عَلَى التَّدْمِيرِ الكَامِلِ) / سَاحِقٌ, مَاحِقٌ (يستخف بالآخرين ويحقرهم) / ذبول, ضمور (أي ضعف أو تدهور (خاصة بسبب عدم الاستخدام))",
 "粛清": "تطهير (إزالة مفاجئة لشخص أو مجموعة من منظمة أو مكان) / تطهير, تنقية (فعل الإزالة عن طريق التنظيف؛ التخلص من الرواسب أو العناصر الأخرى غير المرغوب فيها) / تبرئة, تطهير (فعل تبرئة نفسك (أو شخص آخر) من وصمة عار أو تهمة)\nمثال: مات في حملة تطهير قام بها ستالين",
 "粛然": "صَامِت, سَاكِت / بصوت خافت, بهدوء (بحجم صوت منخفض) / بخفة, برفق (بقليل من الوزن أو القوة) / بشكل خافت, بنعومة (توجيه في الموسيقى؛ للعزف بنعومة وهدوء نسبي) / برقة, بنعومة (بطريقة ترضي الحواس)\nمثال: تحدث بهدوء ولكن احمل عصا غليظة",
 "粛粛": "صَامِت, سَاكِت",
 "粟": "دخن إيطالي, دخن ذيل الثعلب (عشب حولي خشن مقاوم للجفاف يزرع للحبوب والتبن والعلف في أوروبا وآسيا وبشكل رئيسي للعلف والتبن في الولايات المتحدة) / دَخْن (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن) / ملَة, مل\nمثال: دخن زيري سيجارة.",
 "粟粒熱": "مرض التعرق (وباء انتشر في القرنين الخامس عشر والسادس عشر وتميز بالتعرق الغزير والوفيات المرتفعة)",
 "粟粒結核": "سل دخني (سل حاد يتميز بظهور درنات صغيرة جدًا على عضو واحد أو أكثر من الجسم (يُفترض أنه ناتج عن انتشار عصيات السل في مجرى الدم))",
 "粤": "الكانتونية, لغة يوي (لهجة صينية يتم التحدث بها في كانتون والمقاطعات المجاورة وفي هونغ كونغ وأماكن أخرى خارج الصين) / كانتون, مقاطعة (تقسيم إداري صغير في دولة ما (كما في سويسرا))",
 "粤拼": "يُتْبِنْغ",
 "粤語": "كَانْتُونِيّ, كَنْتُونِيّ / كَانْتُونِيَّة, كَنْتُونِيَّة",
 "粥": "إذن بالانصراف, طرد مفاجئ (فصل مفاجئ وبدون مراسم) / إذن انصراف (إذن رسمي بالمغادرة) / إطار مقعر ((العمارة) إطار زخرفي مقعر) / كونغي (عصيدة أرز صينية تؤكل في الإفطار) / إِفْطَار, فَطُور / فَطَرَ ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر.",
 "粥川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "粥状": "عصيدي (من أو يتعلق بالعصيدة (تراكم دهني) أو يشبهها)\nمثال: تنكس عصيدي في الشرايين",
 "粥状硬化": "تَصَلُّب عَصِيدِيّ",
 "粥腫": "عَصِيدَة (طعام يصنع من دقيق يُلَت بالسمن ويطبخ)",
 "粧う": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / ثَوْب, لِبَاس (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء) / كَسْوَة, مَلْبَس\nمثال: لبس سروالا نظيفا.",
 "粧し屋": "رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / يول (سفينة شراعية بصاريتين؛ صارية خلفية صغيرة تقع خلف عمود الدفة) / متأنق (رجل يهتم كثيراً بملابسه ومظهره)",
 "粧鏡": "تبرج, مكياج (مستحضرات تجميل توضع على الوجه لتحسين أو تغيير المظهر) / بنية, تركيب (الطريقة التي يتكون بها شخص أو شيء ما) / اختبار تعويضي, حدث تعويضي (حدث يتم استبداله بحدث تم إلغاؤه مسبقاً)\nمثال: فاتته الاختبار واضطر لإجراء اختبار تعويضي",
 "粮": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام. / تغذية (فعل التغذية) / طعام, غذاء (مصدر للمواد التي تغذي الجسم)\nمثال: أنقذت تغذيتها للأيتام العديد من الأرواح",
 "粲爛": "باهِر",
 "粽": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "精": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة. / طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد. / مَنِيّ",
 "精々": "على الأكثر, كحد أقصى (ليس أكثر من)\nمثال: أنفق 20 دولاراً على الغداء كحد أقصى / قَدْر اَلْمُسْتَطَاع, قَدْر اَلْإِمْكَان (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "精げる": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل",
 "精しい": "مُفَصَّل / عَارِف / عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "精一": "شرف, عفة (فضيلة المرأة أو عفتها) / براءة, طهارة (حالة الخلو من الخطيئة أو الخطأ الأخلاقي؛ الافتقار إلى معرفة الشر) / صفاء, نقاء (كون الشيء غير مخفف أو غير مخلوط بمواد غريبة)",
 "精上皮腫": "سرطان الخصية, ورم منوي (ورم خبيث في الخصية؛ يحدث عادة عند الرجال الأكبر سنًا)",
 "精到": "دَقِيق لِلغَايَة, مُتَأَنٍّ (يَتَّسِم بِعِنَايَة فَائِقَة فِي مُعَالَجَة التَّفَاصِيل) / حَرِيص, دَقِيق جِدًّا (يتميز بالتزام دقيق بالتفاصيل)",
 "精力": "طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد.",
 "精力剤": "مثير للشهوة, مقو للباه (محفز للرغبة الجنسية) / منشط جنسي (عقار أو عامل آخر يحفز الرغبة الجنسية)",
 "精力的": "نَشِيط",
 "精励": "اِجْتِهَاد",
 "精励恪勤": "اجتهاد, انكباب (اجتهاد وانتباه عظيم ومستمر)",
 "精勤": "اِجْتِهَاد",
 "精嚢": "حُوَيْصِلَة مَنَوِيَّة",
 "精妙": "بَدِيع, رَائِع (بالغ الجمال؛ فائق الحُسن) / أَنِيق, بَدِيع (ذُو جَمَالٍ رَقِيقٍ وَدَقِيق) / بَالِغُ الأَنَاقَة, رَائِع (أنيق ومصقول بشكل بالغ) / حَادّ, لَاذِع (شَدِيدُ الحِدَّةِ وَالوَطْأَة)",
 "精子": "نُطْفَة, حَيَوَان مَنَوِيّ (نُطَفْة:خليّة جنسيّة ذكريّة موجودة في المَنيّ، وهي متعددة الأشكال؛ الجمع: نُطْفَ) / نُطْفَة, مَنْي (نُطَفْة:خليّة جنسيّة ذكريّة موجودة في المَنيّ، وهي متعددة الأشكال؛ الجمع: نُطْفَ)",
 "精子バンク": "بَنْكُ الْمَنِيّ ((بَنَّكَ) الخدم: تحدَّثُوا بأسرار الْبيُوت)\nمثال: هي تعمل في بنك.",
 "精子形成": "تَكَوُّن اَلْحَيَوَانَات اَلْمَنَوِّيَّة",
 "精子数": "تعداد الحيوانات المنوية (عملية تقدير عدد الحيوانات المنوية في القذف) / تَعْدَاد الحَيَوَانَات المَنَوِيَّة, عَدّ النِّطَاف (عدد الحيوانات المنوية في القذف)\nمثال: يستخدم تعداد الحيوانات المنوية كمؤشر لخصوبة الذكر",
 "精子細胞": "أرومة نطفية, طليعة منوية (مشيج غير ناضج تنتجه الخلية المنوية؛ يتطور إلى حيوان منوي)",
 "精密": "مَضْبُوط, دَقِيق",
 "精巣": "بَيْضَة, خُصْيَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان)\nمثال: هذه بيضة مقلية.",
 "精巣上体": "بَرْبَخ",
 "精巣上体炎": "التهاب البربخ (التهاب مؤلم في البربخ)",
 "精巣炎": "التهاب الخصية (التهاب إحدى الخصيتين أو كلتيهما؛ يتميز بالألم والتورم)",
 "精巣腫瘍": "سرطان الخصية, ورم منوي (ورم خبيث في الخصية؛ يحدث عادة عند الرجال الأكبر سنًا)",
 "精巧": "مُفَصَّل",
 "精度": "إِحْكَام, دِقَّة (صفة القابلية للتكرار في الكمية أو الأداء)\nمثال: تعامل معها بدقة آلة أوتوماتيكية",
 "精度管理": "مُرَاقَبَةُ الْجَوْدَة",
 "精強": "قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية.",
 "精彩": "أُبَّهَة, رَوْعَة (صفة كون الشيء رائعاً أو فاخراً أو عظيماً) / بريق, توهج (ضوء داخل مجال الرؤية يكون أكثر سطوعاً من السطوع الذي تتكيف معه العينان) / عبقرية, نبوغ (قدرة عقلية غير عادية)\nمثال: بالنسبة للفخامة والخدمة الشخصية / تشبع, صفاء لوني (نقاء لوني: الخلو من التخفيف بالأبيض وبالتالي يكون حيوياً في الصبغة) / تنوع, حيوية (الاهتمام والتنوع والشدة في الطابع)\nمثال: كانت الحقبة البيوريتانية تفتقر إلى الحيوية",
 "精微": "مُفَصَّل",
 "精悍": "رَجُولِيّ, فُحُولِيّ (من سمات الرجل وصفاته) / فحل, قوي جنسياً ((للذكر) قادر على الجماع) / فَتِيّ, مَلِيء بِالحَيَوِيَّة (يتسم بالطاقة والحيوية والنشاط)",
 "精査": "تَدْقِيق",
 "精根": "طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد.",
 "精母細胞": "خلية منوية (خلية مشيجية ذكرية تتطور إلى أربع طلائع منوية)",
 "精気": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "精油": "زيت طيار, زيت عطري (زيت له رائحة أو نكهة النبات المستخرج منه؛ يُستخدم في العطور والمنكهات)",
 "精油所": "مِصْفَاة نِفْط, مِصْفَاة نَفْط",
 "精液": "مَنِيّ",
 "精留": "تَكْرِير",
 "精白": "تكرير, تنقية (عملية إزالة الشوائب (كما هو الحال من الزيت أو المعادن أو السكر، إلخ))",
 "精白米": "أرز أبيض (أرز تمت إزالة القشرة أو الطبقات البنية الخارجية منه)",
 "精白糖": "سكر (كربوهيدرات بلورية بيضاء تستخدم كمحلي ومادة حافظة)",
 "精確": "دَقِيق لِلغَايَة, مُتَأَنٍّ (يَتَّسِم بِعِنَايَة فَائِقَة فِي مُعَالَجَة التَّفَاصِيل) / حَرِيص, دَقِيق جِدًّا (يتميز بالتزام دقيق بالتفاصيل)",
 "精神": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / مَوْقِف, سُلُوك / رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "精神世界": "العالم الروحي, عالم الغيب (اعتقاد بوجود عالم تسيطر عليه روح إلهية)",
 "精神主義": "روحانية (الاهتمام بأمور الروح) / تحضير الأرواح, روحانية (الاعتقاد بأن أرواح الموتى يمكن أن تتواصل مع الأحياء (خاصة عبر وسيط)) / روحانية ((اللاهوت) أي مذهب يؤكد الوجود المنفصل لله)",
 "精神主義者": "روحاني (متعلق بالروحانية أو متصل بها) / وسيط روحي (شخص يعمل كوسيط بين الأحياء والأموات)\nمثال: استشار العديد من الوسطاء",
