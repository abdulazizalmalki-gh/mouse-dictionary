 "緑色": "أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات…)\nمثال: ذلك الضوء أخضر.",
 "緑茶": "شَايْ أَخْضَر (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي…)\nمثال: صب الشاي لضيفك.",
 "緑草": "خضرة, نضارة (المظهر الغزير للنباتات المزدهرة)",
 "緑葉甘藍": "كُرْنُب أَجْعَد",
 "緑藻": "طحالب خضراء (طحالب ذات لون أخضر صافٍ؛ تنمو غالباً على الصخور الرطبة أو الخشب الرطب أو سطح…)",
 "緑藻植物": "طحالب خضراء (طحالب ذات لون أخضر صافٍ؛ تنمو غالباً على الصخور الرطبة أو الخشب الرطب أو سطح…)",
 "緑藻植物門": "الطحالب الخضراء, قسم الطحالب الخضراء (قسم كبير من الطحالب حقيقية النواة التي تعيش بشكل رئيسي في المياه العذبة وتمتلك…)",
 "緑藻類": "طحالب خضراء (طحالب ذات لون أخضر صافٍ؛ تنمو غالباً على الصخور الرطبة أو الخشب الرطب أو سطح…)",
 "緑虫": "يوجلينا (كائن دقيق أخضر وحيد الخلية يعيش في المياه العذبة وله سوط واحد؛ يصنف غالباً…)",
 "緑豆": "مَاش",
 "緑豊か": "أَخْضَر, مُخْضَرّ (يتّسم بوَفْرة الخُضْرة والنبات)",
 "緑道": "حزام أخضر (حزام من المتنزهات أو الأراضي الريفية المحيطة ببلدة أو مدينة)",
 "緑閃石": "أكتينوليت (معدن أخضر من مجموعة الأمفيبول؛ سيليكات الكالسيوم والمغنيسيوم والحديد)",
 "緑陰樹": "شجرة ظل (شجرة تزرع أو تقدر قيمتها بشكل رئيسي لظلها من أشعة الشمس)",
 "緑青": "زِنْجَار",
 "緑黄色": "أصفر مخضر (درجة من الأصفر مشوبة بالأخضر)",
 "緒": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة. / خيط دليل, قرينة (دليل يساعد على حل مشكلة) / خَيْط, حَبْل ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ…)\nمثال: حل الصرة تلقى خيط. / وَتَر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه…)",
 "緒方": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "緒言": "توطئة, ديباجة (مقال تمهيدي قصير يسبق نص كتاب)",
 "緒論": "مُقَدَّمَة\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "緘": "دَرْز (درز:درزا تمكن من درز الدُّنْيَا؛ دَرِزَ الرجلُ، كفَرِح، وَكَذَلِكَ ذَرِزَ…)",
 "緘する": "فُقْمَة\nمثال: ختم سامي القرآن في شهر رمضان. / صَمْت, سُكُوت",
 "緘口": "صَمْت, سُكُوت / خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة)",
 "緘口令": "أمر حظر النشر (أمر محكمة يقيد المعلومات أو التعليقات من قبل المشاركين في دعوى قضائية)\nمثال: فرض أمر حظر النشر على أعضاء الصحافة ينتهك التعديل الأول للدستور",
 "緘口令を敷く": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب",
 "緘黙症": "بكم, خرس (حالة عدم القدرة أو عدم الرغبة في التحدث)\nمثال: كان خرسه نتيجة لصممه",
 "線": "خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / شُعَاع / لَخَّصَ, اِخْتَصَرَ / مُسْتَوًى",
 "線が太い": "بَلِيغ, مُؤَثِّر (يُنتج أثراً قويّاً)\nمثال: احتفال مثير للإعجاب",
 "線が細い": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "線の太い": "حاسم, حاسمة",
 "線スペクトル": "طيف خطي (طيف تتركز فيه الطاقة عند أطوال موجية معينة؛ ينتج عن الذرات والأيونات المثارة…)",
 "線ファスナー": "سَحَّاب, زِمَام مُنْزَلِق (الغيوم المتحركة؛ غُيُوم، دَيْم)\nمثال: القمر موجود خلف السحاب.",
 "線区": "خط حافلات (منظمة مسؤولة عن تشغيل نظام نقل بالحافلات)",
 "線図": "مُخَطَط, رَسْم إِيضَاحِيّ\nمثال: واصل زيري الرسم.",
 "線型": "تَنَاظُرِيّ, خَطِّيّ (لدائرة أو جهاز له مخرج يتناسب مع المدخل)\nمثال: جهاز تناظري",
 "線型代数学": "جبر خطي (جزء الجبر الذي يتعامل مع نظرية المعادلات الخطية والتحويل الخطي)",
 "線型作用素": "مُؤَثِّر خَطِّيّ (مؤثر يطيع قانون التوزيع)",
 "線型性": "أحادية البعد, خطية (خاصية امتلاك بعد واحد)",
 "線審": "حكم الخط (حكم كرة قدم يساعد الحكم الرئيسي من خلال تتبع الوقت الرسمي خلال المباراة)",
 "線引き": "تصوير, رسم (التمثيل عن طريق الرسم أو التلوين وما إلى ذلك)\nمثال: في كثير من الأحيان كانت الرواية تُقاطع بصور لفظية طويلة / مِسْطَرَة (أداة تستخدم لقياس الأطوال أو رسم الخطوط المستقيمة؛ خط مستقيم تحدده مِسطَرة أو…)\nمثال: استعارت المسطرة.",
 "線形": "تَنَاظُرِيّ, خَطِّيّ (لدائرة أو جهاز له مخرج يتناسب مع المدخل)\nمثال: جهاز تناظري",
 "線形代数": "جبر خطي (جزء الجبر الذي يتعامل مع نظرية المعادلات الخطية والتحويل الخطي)",
 "線形代数学": "جبر خطي (جزء الجبر الذي يتعامل مع نظرية المعادلات الخطية والتحويل الخطي)",
 "線形動物": "نِيمَاتُودَا, دودَة اِسْطِوَانِيَّة",
 "線形回帰": "انحدار خطي (العلاقة بين المتغيرات عندما تكون معادلة الانحدار خطية)",
 "線形性": "أحادية البعد, خطية (خاصية امتلاك بعد واحد)",
 "線形方程式": "معادلة خطية (معادلة متعددة الحدود من الدرجة الأولى)",
 "線形計画法": "برمجة خطية (تقنية رياضية تستخدم في الاقتصاد؛ تجد الحد الأقصى أو الأدنى للدوال الخطية في…)",
 "線形関数": "دَالَّة خَطِّيَّة (دالة رياضية يكون رسمها البياني (في الإحداثيات الديكارتية بمقاييس موحدة) خطاً…)",
 "線形順序": "أسطوانة طويلة التشغيل (أسطوانة فونوغراف طويلة التشغيل؛ مصممة للتشغيل بسرعة 33.3 دورة في الدقيقة)",
 "線描": "تخطيط, رسم خطي (رسم لخطوط خارجية لأشكال أو أشياء)",
 "線描画": "تخطيط, رسم خطي (رسم لخطوط خارجية لأشكال أو أشياء)",
 "線材": "سِلْك (السِّلْكُ : الخيطُ الذي ينظَم فيه الخرز ونحوه، أَو الذي يخاط به؛ السِّلْكُ :…)\nمثال: هذا السلك ساخن.",
 "線条": "خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "線条体": "جسم مخطط (كتلة مخططة من المادة البيضاء والرمادية تقع أمام المهاد في كل نصف كرة مخية…)",
 "線毛": "شعيرة (بنية تشبه الشعر خاصة على سطح خلية أو كائن دقيق)\nمثال: توجد شعرة في حسائي",
 "線状": "تَنَاظُرِيّ, خَطِّيّ (لدائرة أو جهاز له مخرج يتناسب مع المدخل)\nمثال: جهاز تناظري",
 "線画": "تخطيط, رسم خطي (رسم لخطوط خارجية لأشكال أو أشياء)",
 "線番": "مقياس الأسلاك (مقياس لقياس قطر السلك)",
 "線維": "لِيف",
 "線維束": "حزمة ألياف, حزمة عصبية (حزمة من الألياف (خاصة الألياف العصبية))",
 "線維症": "تليف (تطور النسيج الضام الليفي الزائد في عضو ما)",
 "線維素": "سِلْيُولُوز / فيبرين (بروتين ليفي أبيض غير قابل للذوبان يتكون بفعل الثرومبين على الفيبرينوجين عند…)",
 "線維組織": "نسيج ليفي (نسيج يتكون من أو يحتوي على ألياف في كل من الحيوانات والنباتات)",
 "線維腫": "ورم ليفي (ورم غير خبيث من النسيج الضام)",
 "線維腺腫": "ورم غدي ليفي (ورم حميد ومتحرك وصلب وغير مؤلم في الثدي؛ شائع لدى الشابات ويسببه ارتفاع مستويات…)",
 "線維芽細胞": "أرومة ليفية (خلية يتطور منها النسيج الضام)",
 "線織面": "سطح مسطر (سطح يتولد عن طريق خط مستقيم متحرك بحيث يمكن رسم خط يقع بالكامل في السطح من خلال…)\nمثال: في الهندسة الجبرية، تم تعريف الأسطح المسطرة في الأصل على أنها أسطح إسقاطية في الفضاء الإسقاطي تحتوي على خط مستقيم يمر عبر أي نقطة معطاة",
 "線虫": "نِيمَاتُودَا, دودَة اِسْطِوَانِيَّة",
 "線虫類": "نِيمَاتُودَا, دودَة اِسْطِوَانِيَّة",
 "線路": "خط سكة حديد (الطريق المكون من مسار السكة الحديدية وأرضية الطريق)",
 "線速度一定": "مِئَة وَخَمْسَة وَخَمْسُونَ (يَدُلُّ عَلَى العَدَد 155)",
 "線量": "جُرْعَة",
 "線量測定": "قياس الجرعات (قياس جرعة الإشعاع المنبعثة من مصدر مشع)",
 "線量計": "مقياس الجرعة الإشعاعية (أداة لقياس جرعات الإشعاع المؤين (الأشعة السينية أو النشاط الإشعاعي))",
 "線香花火": "سلك شرار, شمعة شرارة (لعبة نارية تحترق ببطء وتطلق وابلًا من الشرر)\nمثال: انظر إلى الألماس الذي ترتديه تلك السيدة!",
 "緞帳": "ستارة خلفية, ستارة منسدلة (ستارة يمكن إنزالها ورفعها على المسرح من الأعلى؛ غالباً ما تستخدم كمنظر خلفي)",
 "緞帳役者": "مِن الطَّبَقَة الدُّنْيَا (يحتل أدنى مكانة اجتماعية واقتصادية في المجتمع)",
 "緞帳芝居": "مِن الطَّبَقَة الدُّنْيَا (يحتل أدنى مكانة اجتماعية واقتصادية في المجتمع)",
 "締まらない": "فَضْفَاض, واسِع",
 "締まり": "إتمام, إكمال (إجراء ختامي أو نهائي)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية / ثَبَات / حذر, حرص (صفة كون المرء حذراً ومجتهداً)\nمثال: أعجبت بحرصه في عمله / نَتِيجَة",
 "締まりがない": "عَفْوًا, عَلَى الرُحْب وَالسَّعَة",
 "締まりが無い": "عَفْوًا, عَلَى الرُحْب وَالسَّعَة",
 "締まりのない": "مُتَرَاخٍ, مُتَسَاهِل (يَفْتَقِر إِلَى الصَّرَامَة أَوِ الدِّقَّة)\nمثال: قام بسحب الجزء المرتخي",
 "締まりの無い": "مُتَرَاخٍ, مُتَسَاهِل (يَفْتَقِر إِلَى الصَّرَامَة أَوِ الدِّقَّة)\nمثال: قام بسحب الجزء المرتخي",
 "締まる": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا…)\nمثال: أغلق الباب بغضب / شَدَّ, ضَيَّقَ",
 "締め": "إرساء, ربط السفينة (فعل تأمين سفينة واصلة بالحبال) / مَجْمُوع / نَتِيجَة / أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "締めくくり": "نَتِيجَة / إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة)",
 "締めくくりをつける": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "締めしろ": "تَدَاخُل",
 "締めつけ": "ضَغْط",
 "締めつける": "شَدَّ, ضَيَّقَ / عَصَرَ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "締めて": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "締めひも": "مشروب مقوي, منشط (مقوي أو منشط (خاصة مشروب كحولي))",
 "締める": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ)\nمثال: انتهت المباراة بالتعادل. / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / مَجْمُوع / اِقْتَصَدَ, اِدَّخَرَ",
 "締め上げる": "عَصَرَ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "締め付け": "ضَغْط",
 "締め付ける": "شَدَّ, ضَيَّقَ / عَصَرَ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "締め代": "تَدَاخُل",
 "締め具": "مَشْبَك",
 "締め出し": "تبييض, فوز نظيف (هزيمة في لعبة يفشل فيها أحد الجانبين في التسجيل)",
 "締め出す": "حَانَة, بَار",
 "締め切り": "أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري. / إتمام, إكمال (إجراء ختامي أو نهائي)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية / صندوق غاطس, قيسون (حجرة كبيرة مانعة لتسرب الماء تستخدم للبناء تحت الماء)",
 "締め切り日": "حد زمني, مهلة (فترة زمنية يجب خلالها إنجاز شيء ما أو إكماله)",
 "締め切る": "بمدى قريب, عن قرب (قريب جداً)\nمثال: بدون نظارة القراءة لا أستطيع رؤية الأشياء عن قرب / قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "締め固める": "كثيف, متراص (متحد بشكل وثيق وثابت أو معبأ معاً)\nمثال: تربة متراصة",
 "締め括り": "نَتِيجَة / إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة)",
 "締め括りをつける": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "締め日": "أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "締め木": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
