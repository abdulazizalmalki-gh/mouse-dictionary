 "絡ます": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
 "絡ませる": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
 "絡まり": "شبكة عنكبوتية, فخ (فخ معقد يوقع ضحيته أو يوقعها في شرك)",
 "絡み": "ربط, صلة (عملية ربط الأشياء ببعضها البعض) / ترابط, وصلة ميكانيكية (نظام ميكانيكي من القضبان أو النوابض أو المحاور ينقل الطاقة أو الحركة) / ارتباط, ارتباط جيني ((وراثة) السمات التي تميل إلى أن تورث معاً نتيجة لارتباط بين جيناتها؛ جميع جينات كروموسوم معين مرتبطة (أينما يذهب أحدها تذهب جميعاً)) / تَرَابُط, رَبْط (علاقة ارتباطية) / حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / عَلَى وَشَكِ (يفيد الاستعلاء؛ يفيد التعليل) / عَن (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى) / حَوَالِي\nمثال: رقصنا حول النار.",
 "絡みつく": "تَشَابُك بِالأَيْدِي, عِرَاك (قتال غير منظم) / إزعاج, جلبة (اضطراب غاضب)\nمثال: لم يرد إثارة جلبة",
 "絡み付く": "تَشَابُك بِالأَيْدِي, عِرَاك (قتال غير منظم) / إزعاج, جلبة (اضطراب غاضب)\nمثال: لم يرد إثارة جلبة",
 "絡み合う": "اِنْضَفَرَ, تَدَاخَلَ",
 "絡む": "خيط, دوبارة (حبل خفيف الوزن) / تَشَابُك بِالأَيْدِي, عِرَاك (قتال غير منظم) / إزعاج, جلبة (اضطراب غاضب)\nمثال: لم يرد إثارة جلبة",
 "絡めあう": "اِنْضَفَرَ, تَدَاخَلَ",
 "絡めとる": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / فَخّ, مِصْيَدَة / مُقْتَطَف / خلاصة",
 "絡める": "تَنْسِيق, إِحْدَاثِيّ (ترتيب وتنظيم الأشياء أو العناصر بشكل متناسق ومتناسب؛ العمل على توحيد الجهود بين جهات متعددة لتحقيق هدف مشترك) / تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "絡め取る": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / فَخّ, مِصْيَدَة / مُقْتَطَف / خلاصة",
 "絡め合う": "اِنْضَفَرَ, تَدَاخَلَ",
 "絡糸嬢": "جُدْجُد / صُرْصُر / صُرْصُور / كْرِيكِت",
 "絡繰り": "حِيلَة",
 "絡繰り人形": "آلَة ذَاتِيَّة تَشْغِيل, أُوتُومَاتُون (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "絡繰人形": "آلَة ذَاتِيَّة تَشْغِيل, أُوتُومَاتُون (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "絡繹": "ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "絡車": "عَجَلَة الْمِغْزَل",
 "絢爛": "خَلَّاب, سَاحِر (جميل بشكل مُبْهِر)",
 "絢爛華麗": "بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين) / بَهِيّ, رَائِع (يتّسم بالعظمة والفخامة) / رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "絢爛豪華": "بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين) / بَهِيّ, رَائِع (يتّسم بالعظمة والفخامة) / رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "絢緞子": "فِرِنْد",
 "絢辻": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "給": "أَجْر, رَاتِب (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / شَنَّ ((شَنَّ) يَشُنُّ شَنًّا: يَبس، وأخْلَق؛ يقال (شنَّت) القِرْبَةُ، وشنَّ الجملُ من العطَشِ ونحوه)\nمثال: ركبت سيارة أجرة.",
 "給う": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "給する": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)",
 "給ふ": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "給わる": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "給与": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن. / سماح (فعل السماح) / تَفَاوُت مَسْمُوح, سَمَاحِيَّة (فرق مسموح به؛ السماح ببعض الحرية للحركة ضمن حدود) / بدل, تعديل (مبلغ يضاف أو يخصم بناءً على ظروف مؤهلة) / بدل, مخصص (مبلغ مسموح به أو ممنوح (كما خلال فترة معينة))\nمثال: اعترض على السماح بالتدخين في غرفة الطعام",
 "給与明細": "قسيمة راتب (قصاصة ورقية مرفقة مع راتبك تسجل مقدار المال الذي كسبته ومقدار الضرائب أو التأمين وما إلى ذلك الذي تم استقطاعه)",
 "給仕": "إعلان قضائي, تبليغ (عملية تسليم أمر قضائي أو استدعاء لشخص ما) / حصة, مقدار (كمية فردية من الطعام أو الشراب يتم تناولها كجزء من وجبة)\nمثال: قبل تبليغ الاستدعاء / نَادِل, نَادِلَة / راش ((رَاشَ) الطَّائِرُ يَرِيشُ رَيْشًا: نبَتَ رِيشُهُ؛ (رَاشَ) فلانٌ: استَغْنَى)",
 "給仕人": "نَادِل, نَادِلَة",
 "給付": "إمداد, تزويد (نشاط توريد أو توفير شيء ما) / إعداد, تحضير (العملية المعرفية للتفكير فيما ستفعله في حالة حدوث شيء ما) / بند, شرط (شرط منصوص عليه) / إمدادات, مؤونة (مخزون أو إمداد من شيء ما (خاصة الطعام أو الملابس أو الأسلحة))\nمثال: أعيق تخطيطه للتقاعد بسبب العديد من الشكوك",
 "給付金": "فَائِدَة, جَدْوَى",
 "給排水": "إمدادات المياه, نظام مياه (منشأة توفر مصدراً للمياه)\nمثال: ناقشت المدينة تنقية إمدادات المياه",
 "給料": "رَاتِب, أَجْر",
 "給料ドロボー": "متخاذل, متهرب (شخص يتهرب من عمله أو واجبه (خاصة من يحاول التهرب من الخدمة العسكرية في وقت الحرب))",
 "給料支払小切手": "شيك الراتب (شيك يصدر لدفع الأجور أو الرواتب)",
 "給料日": "يوم الدفع, يوم الراتب (اليوم الذي تتلقى فيه أجراً عن عملك)",
 "給料明細": "قسيمة راتب (قصاصة ورقية مرفقة مع راتبك تسجل مقدار المال الذي كسبته ومقدار الضرائب أو التأمين وما إلى ذلك الذي تم استقطاعه)",
 "給料明細表": "قسيمة راتب (قصاصة ورقية مرفقة مع راتبك تسجل مقدار المال الذي كسبته ومقدار الضرائب أو التأمين وما إلى ذلك الذي تم استقطاعه)",
 "給料泥棒": "متخاذل, متهرب (شخص يتهرب من عمله أو واجبه (خاصة من يحاول التهرب من الخدمة العسكرية في وقت الحرب))",
 "給料袋": "ظرف الراتب (أجور موضوعة في ظرف لتوزيعها على صاحب الأجر)",
 "給気": "تَهْوِيَة",
 "給気口": "نَفَّسَ, هَوَّى (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…) / نَفَّسَ عَن (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "給水": "إمدادات المياه, نظام مياه (منشأة توفر مصدراً للمياه)\nمثال: ناقشت المدينة تنقية إمدادات المياه",
 "給水タンク": "خزان المرحاض, سيفون (خزان يحمل الماء المستخدم في شطف المرحاض)",
 "給水制限": "إمدادات المياه, نظام مياه (منشأة توفر مصدراً للمياه)\nمثال: ناقشت المدينة تنقية إمدادات المياه",
 "給水塔": "خَزَّانُ مَاء",
 "給水栓": "حنفية إطفاء, صنبور (أنبوب تصريف مزود بصمام وفوهة يمكن من خلاله سحب المياه من شبكة المياه الرئيسية) / حنفية, صنبور المياه (صنبور لسحب الماء من أنبوب أو برميل)",
 "給水池": "حَوْض, جَابِيَة (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه) / فِنْطَاس\nمثال: ملأت الحوض ماءا.",
 "給水管": "شِيشَة, أرجيلة",
 "給水車": "عربة مياه (عربة تحمل الماء (للقوات أو فرق العمل أو لرش الطرق الترابية المغبرة في الصيف))",
 "給油": "تزويد بالوقود (نشاط توفير أو أخذ الوقود) / زَيْت, زيت (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن) / نَفْط, زَيْت (سَائِل أسود قابل للاحتراق يوجد في باطن الأرض تستخدم مشتقاته كوقود وفي الصناعة. يعتبر حاليا أهم مصادر الطاقة في العالم)\nمثال: خبأن ذلك الزيت.",
 "給油所": "مَحَطَّة بَنْزِين, مَحَطَّة وَقُود",
 "給油機": "مضخة بنزين (مضخة في محطة خدمة تسحب البنزين من صهاريج التخزين تحت الأرض)",
 "給油船": "ناقلة نفط (سفينة شحن مصممة لحمل النفط الخام بكميات كبيرة) / بئر نفط (بئر ينتج أو أنتج النفط) / مزيّت (عامل يزيت المحركات أو الآلات)",
 "給油艦": "نَاقِلة",
 "給湯器": "سخان مياه (سخان وخزان تخزين لتوفير المياه الساخنة)",
 "給紙": "جهاز تغذية الورق, ملقم الورق (جهاز لإدخال أوراق في طابعة أو آلة كاتبة)\nمثال: تأخرت المهمة بسبب انسداد ملقم الورق",
 "給紙トレイ": "جهاز تغذية الورق, ملقم الورق (جهاز لإدخال أوراق في طابعة أو آلة كاتبة)\nمثال: تأخرت المهمة بسبب انسداد ملقم الورق",
 "給血者": "متبرع بالدم (شخص يتبرع بالدم لاستخدامه في عمليات نقل الدم)",
 "給費": "مِنْحَة دِرَاسِيَّة, إِعَانَة دِرَاسِيَّة",
 "給送": "أَطْعَمَ, غَذَّى",
 "給金": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "給電線": "حيوان تسمين (حيوان يتم تسمينه أو مناسب للتسمين) / آكل, حيوان مقتات (حيوان يتغذى على مصدر معين للغذاء) / مِعْلف طيور, وحدة إطعام الطيور (جهاز خارجي يوفر الطعام للطيور البرية) / ملقم ذاتي (آلة توفر تلقائياً إمداداً من مادة ما)\nمثال: آكل اللحاء",
 "給養": "حَافَظَ / أَبْقَى / عَالَ, يَعُولُ (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال",
 "給餌": "إِطْعَام",
 "絨毛": "زُغابَة, زَغْبَة",
 "絨毛性": "مشيمائي (متعلق بالمشيماء (غشاء الجنين الخارجي))\nمثال: الزغابة المشيمائية هي نتوء وعائي دقيق على مشيماء الجنين",
 "絨毛検査": "فحص الزغابات المشيمية (اختبار قبل الولادة للكشف عن العيوب الخلقية في مرحلة مبكرة من الحمل)",
 "絨毛穿刺": "فحص الزغابات المشيمية (اختبار قبل الولادة للكشف عن العيوب الخلقية في مرحلة مبكرة من الحمل)",
 "絨毛膜": "كوريون, مشيمة (الكيس الغشائي الخارجي الذي يحيط بالجنين في الفقاريات العليا (الزواحف والطيور والثدييات))",
 "絨毛膜絨毛": "زغابة مشيمية (واحدة من الزغابات الدقيقة التي تبرز من المشيمة الجنينية وتتحد مع أنسجة رحم الأم لتكوين المشيمة)",
 "絨毛診断": "فحص الزغابات المشيمية (اختبار قبل الولادة للكشف عن العيوب الخلقية في مرحلة مبكرة من الحمل)",
 "絨毯": "سَجَّادَة, بِسَاط",
 "絨毯爆撃": "قصف بساطي",
 "統べる": "حَكَمَ, تَحَكَّمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / اِتَّحَدَ, أَلَّفَ",
 "統べ合わせる": "اِتَّحَدَ, أَلَّفَ",
 "統一": "وَحْدَة, اِتِّحَاد / كنيسة التوحيد (كنيسة مسيحية (بها بعض العناصر البوذية) أسسها صن ميونغ مون عام 1954 وتشتهر بإقامة حفلات زفاف جماعية وأنشطة مجتمعية أخرى)",
 "統一化": "تَوْحِيد",
 "統一協会": "كنيسة التوحيد (كنيسة مسيحية (بها بعض العناصر البوذية) أسسها صن ميونغ مون عام 1954 وتشتهر بإقامة حفلات زفاف جماعية وأنشطة مجتمعية أخرى)",
 "統一性": "اطِّرَاد, انْتِظَام (صفة الافتقار إلى التنوع أو التباين (حتى درجة الملل)) / اتِّسَاق, انْتِظَام (حالة يكون فيها كل شيء منتظماً وغير متغير)",
 "統一戦線": "التحالف الشمالي, الجبهة المتحدة (تحالف متعدد الأعراق في أفغانستان يمارسون شكلاً معتدلاً من الإسلام ومتحدون في معارضتهم لطالبان)",
 "統一教会": "كنيسة التوحيد (كنيسة مسيحية (بها بعض العناصر البوذية) أسسها صن ميونغ مون عام 1954 وتشتهر بإقامة حفلات زفاف جماعية وأنشطة مجتمعية أخرى)",
 "統一的": "مُتَّحِد",
 "統一見解": "إِجْمَاع, تَوَافُق",
 "統一資源位置指定子": "رابط, عنوان ويب (عنوان صفحة ويب على الشبكة العنكبوتية العالمية)",
 "統制": "تَنْظِيم\nمثال: その国では政府が物価を統制している。 — في تلك الدولة الحكومة تتحكم بالاسعار.",
 "統合": "مُكَامَلَة",
 "統合体": "تَرْكِيب (اسم للشيء الذي يُرَّكبُ بالعادة) / اِصْطِنَاع, اِصْطِنَاع كِيمِيَائِيّ",
 "統合化": "مُكَامَلَة",
 "統合参謀本部": "هيئة الأركان المشتركة (الوكالة التنفيذية التي تقدم المشورة للرئيس بشأن المسائل العسكرية؛ تتألف من رؤساء الجيش الأمريكي والبحرية الأمريكية والقوات الجوية الأمريكية وقائد…)",
 "統合型リゾート": "إدارة الإيرادات الداخلية, مصلحة الضرائب (مجلس تابع للحكومة البريطانية يدير ويجمع الضرائب المباشرة الرئيسية) / إيريديوم (عنصر فلزي ثقيل هش من مجموعة البلاتين)",
 "統合失調症": "فُصَام, الْفِصَام الذُّهَانِيّ",
 "統合失調症患者": "فُصَامِيّ (مصاب بنوع من أنواع الفصام) / شيزودي, فصامي (من أو متعلق بـ أو مميز للفصام) / فُصامِيّ, مُصاب بِالفُصام (شخص مصاب بالفصام (شيزوفرينيا))",
 "統合性": "أَمَانَة, نَزَاهَة / سَلَامَة",
 "統合者": "مؤلف, مركّب (مثقف يقوم بالتوليف أو يستخدم أساليب تركيبية)",
 "統失": "فُصَام, الْفِصَام الذُّهَانِيّ",
 "統帥": "قيادة عليا, مقر القيادة العليا (أعلى القادة في منظمة (مثل القائد العام وكبار ضباط الجيش))",
 "統幕": "هيئة الأركان العامة (ضباط عسكريون معينون لمساعدة ضابط كبير في تخطيط السياسة العسكرية)",
 "統廃合": "إعادة تنظيم, إعادة هيكلة (تغيير واسع النطاق لهيكل شركة أو حكومة) / إعادة تنظيم (فرض تنظيم جديد؛ التنظيم بشكل مختلف (غالباً ما ينطوي على تغييرات واسعة وجذرية))\nمثال: بعد الاستحواذ كان هناك إعادة تنظيم شاملة",
 "統御": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "統括": "تَوْحِيد / سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "統括団体": "إدارة, المؤسسة (الأشخاص (أو اللجان أو الأقسام وما إلى ذلك) الذين يشكلون هيئة لغرض إدارة شيء ما)\nمثال: يدعي أن الإدارة الحالية فاسدة",
 "統括本部": "المقر العام, مركز القيادة (مقر عسكري يسيطر منه القائد العسكري وينظم القوات)",
 "統治": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "統治権": "سِيَادَة, حَاكِمِيَّة (السِّيَادةُ : الشرفُ؛سادَ يَسُودُ سِيَادَةً، والاسمُ السُّؤدُد، وَهُوَ المَجْدُ و الشَّرفُ؛ ساد يسود سيادةً وسُودَداً وسؤْدُداً :عظُم ومجُد وشرُف)\nمثال: أوكرانيا دولة ذات سيادة.",
 "統治者": "مِسْطَرَة (أداة تستخدم لقياس الأطوال أو رسم الخطوط المستقيمة؛ خط مستقيم تحدده مِسطَرة أو بُعد محدد) / حَاكِم (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر)\nمثال: استعارت المسطرة.",
 "統率": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "統率力": "قِيَادَة",
 "統率者": "قَائِد, زَعِيم",
 "統理": "إِدَارَة, مُرَاقَبَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة) / إِدَارَة تَنْفِيذِيَّة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "統監": "إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة)",
 "統覚": "إدراك ترابطي, استيعاب (العملية التي يتم من خلالها ربط الصفات المدركة لشيء ما بالتجارب السابقة)",
 "統計": "عِلْم اَلْإِحْصَاء, إِحْصَائِيَّات (أَدْرَكَ حقيقة الشيء) / إِحْصَائِيَّة, إِحْصَاء\nمثال: أدرس علم النفس.",
 "統計上": "إِحْصَائِيّ",
 "統計値": "اِحْصَائِيَّة",
 "統計力学": "ميكانيكا إحصائية (فرع الفيزياء الذي يقدم تنبؤات نظرية حول سلوك الأنظمة الماكروسكوبية بناءً على القوانين الإحصائية التي تحكم جسيماتها المكونة)",
 "統計学": "عِلْم اَلْإِحْصَاء, إِحْصَائِيَّات (أَدْرَكَ حقيقة الشيء) / إِحْصَائِيَّة, إِحْصَاء\nمثال: أدرس علم النفس.",
 "統計学者": "إحصائي, خبير اكتواري (شخص متمكن من جمع وتفسير البيانات الرقمية (خاصة من يستخدم الإحصاء لحساب أقساط التأمين)) / إحصائي, عالم إحصاء (عالم رياضيات يتخصص في الإحصاء)",
 "統計情報": "عِلْم اَلْإِحْصَاء, إِحْصَائِيَّات (أَدْرَكَ حقيقة الشيء) / إِحْصَائِيَّة, إِحْصَاء\nمثال: أدرس علم النفس.",
 "統計的": "إِحْصَائِيّ",
 "統計表": "جدول إحصائي, جدول إكتواري (جدول للبيانات الإحصائية)",
 "統計量": "اِحْصَائِيَّة",
 "統語": "تركيبي, نحوي (متعلق بقواعد بناء الجملة (النحو) أو متوافق معها)\nمثال: القواعد التركيبية للغة",
 "統語法": "بِنَاء جُمْلَة, نَحْو (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "統語範疇": "فئة نحوية, مقولة نحوية ((نحو) فئة من الكلمات لها نفس الخصائص النحوية)",
 "統語論": "بِنَاء جُمْلَة, نَحْو (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "統轄": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "統轄者": "مُشْرِف, مُشْرِفَة",
 "統辞論": "بِنَاء جُمْلَة, نَحْو (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "統領": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون. / قُنْصُل",
 "統馭": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟",
 "絲": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "絲口": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / خيط دليل, قرينة (دليل يساعد على حل مشكلة) / تلميح, دليل (إشارة طفيفة)",
 "絵": "صُورَة, تَصْوِير / صُورَة, صُورَة شَمْسِيَّة / صُورَة / اِنْطِبَاع, سُمْعَة",
 "絵かき": "رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ) / دَهَّان, دَهَّانَة\nمثال: إنه رسام مشهور. / خربشة, شخبطة (رسم بلا هدف)",
 "絵とき": "تَفْسِير, شَرْح",
 "絵になる": "بَدِيع المَنْظَر, خَلَّاب (يوحي بأنه مناسب لصورة؛ جميل كاللوحة) / بَدِيع, خَلَّاب (جذّاب بصريّاً بألوانه وتفاصيله الحيّة)",
 "絵にもかけない": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "絵にも描けない": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "絵の具": "دِهَان / لَوَّنَ (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد)\nمثال: ما هو لون شعرك؟",
 "絵はがき": "بطاقة بريدية مصورة (بطاقة بريدية تحمل صورة على أحد جانبيها)",
 "絵グラフ": "بيكتوغراف, رمز تصويري (رمز رسومي يُستخدم في الكتابة التصويرية)",
 "絵像": "صُورَة / بُورْتْرِيَّة",
 "絵入り": "حَيّ, نَابِض (يستحضر صورًا حيّة ونابضة في الذهن) / تصويري (متعلق بالصور أو يتكون منها) / مجلة مصورة (دورية (مجلة أو صحيفة) تحتوي على العديد من الصور)\nمثال: منظور تصويري",
 "絵具": "دِهَان / لَوَّنَ (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد)\nمثال: ما هو لون شعرك؟",
 "絵取る": "لَوْن, لون (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد) / لَوَّنَ (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد)\nمثال: ما هو لون شعرك؟",
 "絵図": "رسم توضيحي (تمثيل مرئي (صورة أو مخطط) يستخدم لجعل موضوع ما أكثر متعة أو أسهل للفهم) / عينة, مثال (عنصر من المعلومات يعتبر نموذجياً لفئة أو مجموعة) / تمثيل, توضيح بالمثال (الإظهار عن طريق المثال) / رسم توضيحي (عمل فني يساعد على جعل شيء ما واضحاً أو جذاباً)\nمثال: يقدم هذا المريض مثالاً نموذجياً للمتلازمة",
 "絵図面": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "絵姿": "صُورَة / بُورْتْرِيَّة",
 "絵師": "رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ) / دَهَّان, دَهَّانَة\nمثال: إنه رسام مشهور. / مُصَوِّر",
 "絵描": "رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ) / دَهَّان, دَهَّانَة\nمثال: إنه رسام مشهور. / خربشة, شخبطة (رسم بلا هدف)",
 "絵描き": "رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ) / دَهَّان, دَهَّانَة\nمثال: إنه رسام مشهور. / خربشة, شخبطة (رسم بلا هدف)",
 "絵文字": "إِيمُوجِي / بيكتوغراف, رمز تصويري (رمز رسومي يُستخدم في الكتابة التصويرية)",
 "絵本": "كتاب مصور (كتاب يتكون بشكل رئيسي من الصور)",
 "絵札": "ورقة صورة, ورقة وجه (واحدة من اثنتي عشرة ورقة في الحزمة تحمل صورة وجه)",
 "絵柄": "نُمُوذَج, نَمَط",
 "絵様": "تَخْطِيط, تصميم (مصدر من خَطَّطَ؛ في : فكرةٌ مُثبتة بالرسم، أو الكتابة في حالة الخطّ. تدلّ دلالةً تامَّة على ما يُقصد في الصُّورة أو الرسم أَو اللَّوح المكتوب من المعنى والموضوع…) / تَصْمِيم, ديزاين\nمثال: يعمل في قسم التخطيط.",
 "絵画": "لَوْحَة, صُورَة / طِلَاء, دِهَان",
 "絵画展": "معرض فني (معرض للأعمال الفنية (لوحات أو تماثيل))",
 "絵画的": "بَدِيع المَنْظَر, خَلَّاب (يوحي بأنه مناسب لصورة؛ جميل كاللوحة) / بَدِيع, خَلَّاب (جذّاب بصريّاً بألوانه وتفاصيله الحيّة) / حَيّ, نَابِض (يستحضر صورًا حيّة ونابضة في الذهن) / تصويري (متعلق بالصور أو يتكون منها) / مجلة مصورة (دورية (مجلة أو صحيفة) تحتوي على العديد من الصور)\nمثال: منظور تصويري",
 "絵皿": "باليتة, لوحة ألوان (لوح يوفر سطحاً مستوياً يخلط عليه الفنانون الطلاء ومجموعة الألوان المستخدمة) / واقي الإبط (واحدة من الصفائح الدرعية المستديرة عند الإبطين في بدلة الدرع) / لوحة ألوان (نطاق الألوان المميز لفنان معين أو لوحة أو مدرسة فنية)",
 "絵空事": "فَبْرَكَة",
 "絵筆": "فُرْشَاة الطِلَاء",
 "絵素": "بِكْسِل",
 "絵羽": "ذُو رُسُوم, مُوَشًّى ((في الأقمشة ونحوها) مزيَّن بنقوش وأشكال)",
 "絵葉書": "بطاقة بريدية مصورة (بطاقة بريدية تحمل صورة على أحد جانبيها)",
 "絵解き": "تَفْسِير, شَرْح",
 "絵記号": "بيكتوغراف, رمز تصويري (رمز رسومي يُستخدم في الكتابة التصويرية)",
 "絶えざる": "ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "絶えず": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: العالم يتغير باستمرار",
 "絶えない": "دَائِم, لَا يَنْقَطِع (غَيْرُ مُنْقَطِعٍ فِي الزَّمَنِ وَمُسْتَمِرٌّ إِلَى أَجَلٍ غَيْرِ مُسَمًّى) / أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى)",
 "絶えま": "فَاصِل / مُدَّة, فَتْرَة / مَسَافَة / انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "絶える": "اِنْقَرَضَ\nمثال: いまはもうこの種のちょうは絶えてしまっている。 — الفراشات من هذا النوع قد انقرضت. / زَالَ (زَالَ يَزُولُ زَوَالاً، وزَوَلاَنًا: تحوَّلَ وانتقل؛ يقال: زَالَ من مكانه وعنه)\nمثال: توم لا زال يبكي",
 "絶えることなく": "دَائِم, لَا يَنْقَطِع (غَيْرُ مُنْقَطِعٍ فِي الزَّمَنِ وَمُسْتَمِرٌّ إِلَى أَجَلٍ غَيْرِ مُسَمًّى) / أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى)",
 "絶え入る": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "絶え絶え": "خَائِر القُوَى, ضَعِيف (يفتقر إلى القوة والعزيمة) / ضَعِيف, وَاهِن (يفتقر إلى القوة البدنية أو العضلية أو الحيوية) / خَافِت, وَاهِن (ضعيف في قوته أو حيويته) / سَقِيم, وَاهٍ (يفتقر بشكل مُثير للشفقة إلى القوة أو الفاعلية)",
 "絶え間": "فَاصِل / مُدَّة, فَتْرَة / مَسَافَة / انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "絶え間ない": "مُسْتَمِرّ, مُتَوَاصِل",
 "絶え間なく": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل)\nمثال: العالم يتغير باستمرار",
 "絶え間無い": "مُسْتَمِرّ, مُتَوَاصِل",
 "絶する": "كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟ / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "絶つ": "جَذَبَ, قَطَعَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: استعملت ريمة لجذب الانتباه. / اِمْتَنَعَ (مَنَعَ نفسه؛ كان مَنِيْعًا يصعب الوصول إليه)",
 "絶世": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "絶交": "انقطاع, قطع مفاجئ (حالة من المقاطعة المفاجئة)",
 "絶佳": "رَفِيع, فَائِق (فائق الجودة بشكل استثنائي) / بَاهِر, رَائِع (ذو تميز يفوق الوصف)",
 "絶倫": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "絶入る": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "絶勝": "مَجْد (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد به)\nمثال: المجد لأوكرانيا",
 "絶叫": "صرخة / صَرَخَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "絶命": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "絶品": "تُحْفَة, رَائِعَة",
 "絶壁": "جرف شديد الانحدار, هاوية (جرف شديد الانحدار جداً)",
 "絶大": "عَظِيم, هَائِل (كبير بشكل استثنائي في الحجم أو المدى أو الكمية أو القوة أو الدرجة) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف) / شَدِيد, مَهُول (بالغ في الدرجة أو المدى أو المقدار أو التأثير)",
 "絶好": "أَفْضَل",
 "絶妙": "بَدِيع, رَائِع (بالغ الجمال؛ فائق الحُسن) / أَنِيق, بَدِيع (ذُو جَمَالٍ رَقِيقٍ وَدَقِيق) / بَالِغُ الأَنَاقَة, رَائِع (أنيق ومصقول بشكل بالغ) / حَادّ, لَاذِع (شَدِيدُ الحِدَّةِ وَالوَطْأَة)",
 "絶対": "مطلقا, على الإطلاق / مُطْلَق (المُطْلَق ؛ ضد المُقَيَّد، من يتحرك بلا قَيْد أو مَانِع؛ صفة: تركت الشرطة البريء مُطْلَق السراح) / مثال: \"متزوج؟\" \"مطلق.\" / إِطْلَاق, قَطْعِيَّة (صفة كون الشيء مطلقاً) / حدة, صرامة (صفة كون الشيء كاملاً أو مطلقاً أو متطرفاً)\nمثال: لا يمكن الطعن في قطعية مرسوم البابا",
 "絶対に": "مطلقا, على الإطلاق",
 "絶対上昇限度": "سَقْف الطَّيَرَان المُطْلَق (الحد الأقصى للارتفاع الذي يمكن للطائرة فيه الحفاظ على الطيران الأفقي)",
 "絶対主義": "مطلقية (عقيدة الكائن المطلق، وترتبط غالباً بالمثالية في الفلسفة) / حكم مطلق, شمولية (معتقد أيديولوجي في السلطة الكاملة وغير المقيدة للحكومة) / استبدادية, دكتاتورية (شكل من أشكال الحكم يكون فيه الحاكم دكتاتوراً مطلقاً (غير مقيد بدستور أو قوانين أو معارضة وما إلى ذلك)) / استبداد, حكم مطلق (الهيمنة من خلال التهديد بالعقاب والعنف)",
 "絶対主義者": "استبدادي, مطلق (متعلق بمبدأ الشمولية) / مُؤَيِّد لِلحُكْم المُطْلَق (من يدعو إلى الحكم المطلق (الاستبدادي))",
 "絶対値": "قِيمَة مُطْلَقَة",
 "絶対君主制": "مَلَكِيَّة مُطْلَقَة",
 "絶対命令": "أَمْر مُطْلَق, وَاجِب قَطْعِيّ (المبدأ الأخلاقي القائل بأن السلوك يجب أن يتحدد بالواجب)",
 "絶対多数": "أغلبية, أغلبية مطلقة ((انتخابات) أكثر من نصف الأصوات)",
 "絶対奪格": "مطلق الجر (مكون في قواعد اللغة اللاتينية؛ يمكن لاسم ومعدله أن يعملا كمعدل للجملة)",
 "絶対安全": "ذَاتِيُّ الأَمَان (يزيل الخطر بالتعويض التلقائيّ عن أيّ عطل أو خلل) / مَأْمُون الفَشَل, مَضْمُون النَّتِيجَة (مضمون عدم فشله؛ آمن من الإخفاق) / آلية أمان ضد الفشل (آلية قادرة على العودة إلى حالة آمنة في حالة حدوث فشل أو عطل)",
 "絶対数": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟",
 "絶対温度": "درجة حرارة مطلقة (درجة الحرارة المقاسة على المقياس المطلق)",
 "絶対王制": "مَلَكِيَّة مُطْلَقَة",
 "絶対王政": "مَلَكِيَّة مُطْلَقَة",
 "絶対的": "مُطْلَق (المُطْلَق ؛ ضد المُقَيَّد، من يتحرك بلا قَيْد أو مَانِع؛ صفة: تركت الشرطة البريء مُطْلَق السراح) / مثال: \"متزوج؟\" \"مطلق.\"",
 "絶対空間": "فضاء مطلق (الفضاء المادي المستقل عما يشغله)",
 "絶対等級": "قدر مطلق ((في علم الفلك) المقدار الذي سيكون للنجم إذا شوهد من مسافة 10 فراسخ فلكية (32.62 سنة ضوئية) من الأرض)",
 "絶対者": "مُطْلَق (المُطْلَق ؛ ضد المُقَيَّد، من يتحرك بلا قَيْد أو مَانِع؛ صفة: تركت الشرطة البريء مُطْلَق السراح) / مثال: \"متزوج؟\" \"مطلق.\"",
 "絶対菜食主義": "خُضْرِيَّة, نَبَاتِيَّة صِرْفَة",
 "絶対菜食主義者": "خُضْرِيّ",
 "絶対論": "مطلقية (عقيدة الكائن المطلق، وترتبط غالباً بالمثالية في الفلسفة) / حكم مطلق, شمولية (معتقد أيديولوجي في السلطة الكاملة وغير المقيدة للحكومة) / استبدادية, دكتاتورية (شكل من أشكال الحكم يكون فيه الحاكم دكتاتوراً مطلقاً (غير مقيد بدستور أو قوانين أو معارضة وما إلى ذلك)) / استبداد, حكم مطلق (الهيمنة من خلال التهديد بالعقاب والعنف)",
 "絶対過半数": "أغلبية, أغلبية مطلقة ((انتخابات) أكثر من نصف الأصوات)",
 "絶対零度": "صِفْر مُطَلِّق, دَرَجَة الصُّغَر الْمُطْلَق (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
 "絶対音感": "سمع مطلق, طبقة صوتية مطلقة (القدرة على تحديد طبقة النغمة)",
 "絶対音楽": "موسيقى مطلقة (موسيقى آلية، مثل الكونشرتو أو الرباعية الوترية، لا تستمد أي إلهام أو لا تشير إلى نص أو برنامج أو صورة بصرية أو عنوان، وتوجد فقط من حيث شكلها الموسيقي…)",
 "絶待": "إِطْلَاق, قَطْعِيَّة (صفة كون الشيء مطلقاً) / حدة, صرامة (صفة كون الشيء كاملاً أو مطلقاً أو متطرفاً)\nمثال: لا يمكن الطعن في قطعية مرسوم البابا",
 "絶念": "ترك, هجران (فعل الهجر أو التخلي) / إذعان, استسلام (فعل لفظي للاعتراف بالهزيمة)",
 "絶息": "منية, موت (حدث الوفاة أو الرحيل عن الحياة) / انتهاء, انقضاء (وصول فترة العقد إلى نهايتها)\nمثال: جاء موتها كصدمة مروعة",
 "絶望": "يَئِسَ / يَأْس",
 "絶望的": "يَائِس, قَانِط / مَيْئُوس مِنْهُ",
 "絶滅": "اِنْقِرَاض / استئصال, طمس (التدمير الكامل لكل أثر لشيء ما)",
 "絶滅危惧": "مُهَدَّد ((عن النباتات أو الحيوانات) مُرَجَّحٌ أَنْ يُصْبِحَ مُهَدَّدًا بِالاِنْقِرَاضِ قَرِيبًا)",
 "絶滅危惧種": "نوع مهدد بالانقراض (نوع تكون أعداده صغيرة جداً بحيث يكون معرضاً لخطر الانقراض)",
 "絶滅危機": "خطر, مجازفة (مصدر للخطر؛ احتمالية تكبد خسارة أو مصيبة)\nمثال: شرب الكحول خطر صحي",
 "絶滅危険種": "نوع مهدد بالانقراض (نوع تكون أعداده صغيرة جداً بحيث يكون معرضاً لخطر الانقراض)",
 "絶滅収容所": "مُعَسْكَر إِبَادَة, مُعَسْكَر مَوْت",
 "絶滅寸前": "الحقبة العامة, العصر الحالي (في الفترة المتزامنة مع العصر المسيحي؛ يفضل استخدامها بعض الكتاب غير المسيحيين) / سيريوم (عنصر فلزي رمادي قابل للسحب من سلسلة اللنثانيدات)\nمثال: في عام 200 من الحقبة العامة",
 "絶無": "لَا شَيْء (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "絶版": "غَيْرُ مُتَاح, نَافِدُ الطَّبْع ((عَنِ الكُتُب) لَمْ يَعُدِ النَّاشِرُ يَعْرِضُهُ لِلبَيْع)",
 "絶筆": "ترك, هجران (فعل الهجر أو التخلي) / إذعان, استسلام (فعل لفظي للاعتراف بالهزيمة)",
 "絶縁": "انقطاع, قطع مفاجئ (حالة من المقاطعة المفاجئة) / عزل (فعل حماية شيء ما عن طريق إحاطته بمادة تقلل أو تمنع انتقال الصوت أو الحرارة أو الكهرباء) / انعزال, تقوقع (حالة العزلة أو الانفصال) / عازل, مادة عازلة (مادة عازلة تقلل أو تمنع انتقال الحرارة أو الصوت أو الكهرباء)\nمثال: حافظت القناة الإنجليزية على انعزال إنجلترا",
 "絶縁テープ": "شريط عازل (شريط لاصق مقاوم للماء يستخدم لعزل الموصلات الكهربائية المكشوفة)",
 "絶縁体": "عازل, مادة عازلة (مادة مثل الزجاج أو الخزف ذات موصلية كهربائية أو حرارية مهملة)",
 "絶美": "خَلَّاب, سَاحِر (جميل بشكل مُبْهِر)",
 "絶賛": "إشادة, استحسان (موافقة حماسية)\nمثال: لقي الكتاب استحساناً متواضعاً / حَالِيًّا",
 "絶頂": "قِمَّة / أَوْجٌ, ذُرْوَةٌ / نَشْوَة, هِزَّة اَلْجِمَاع",
 "絶頂期": "قِمَّة / يضع شيء على قمة عالية",
 "絶食": "صَوْم, صِيَام",
 "絶飲食": "صَوْم, صِيَام",
 "絹": "حَرِير, إبْرِيسِم",
 "絹さや": "بازلاء ثلجية, بازلاء سكرية (بازلاء خضراء ذات قرون مسطحة صالحة للأكل) / بازلاء ثلجية, بازلاء سكرية (صنف من نبات البازلاء ينتج بازلاء ذات قرون مسطحة رقيقة صالحة للأكل)",
 "絹の道": "طَرِيق اَلْحَرِير (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "絹を裂くよう": "حَادّ, صَارِخ (ذو لون ساطع بشكل مفرط وصارخ) / حَادّ, صَاخِب (يُصِرُّ بِحِدَّةٍ عَلَى أَنْ يُسْمَع) / حَادّ, صَرِير (ذو نبرة عالية وحادَّة أو يُصدر نغمات كذلك)",
 "絹モスリン": "شيفون (قماش شفاف من الحرير أو الرايون)",
 "絹層雲": "سمحاق طبقي (طبقة رقيقة موحدة من السحب الضبابية على ارتفاع عالٍ)",
 "絹布": "حَرِير, إبْرِيسِم",
 "絹村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "絹毛鼠": "قَدَاد / هَامِسْتَر",
 "絹積雲": "ركام سمحاقي, سحاب قزعي (سحابة على ارتفاع عالٍ تتكون من سلسلة من السحب الصغيرة المرتبة بانتظام تشبه التموجات)",
 "絹糸": "حرير الذرة, شواشي الذرة (كل من الأقلام الخيطية الطويلة التي تنمو كخصلة حريرية عند طرف كوز الذرة)",
 "絹糸腺": "غدة الحرير (غدة منتجة للحرير في الحشرات (خاصة دودة القز) أو العناكب)",
 "絹紡": "حرير مغزول (خيط مصنوع من نفايات الحرير)\nمثال: عمل الغازل هو تقويم هذه الألياف بمساعدة الآلات، ثم ضمها معاً لتصبح خيطاً يُعرف بالحرير المغزول",
 "絹紡糸": "حرير مغزول (خيط مصنوع من نفايات الحرير)\nمثال: عمل الغازل هو تقويم هذه الألياف بمساعدة الآلات، ثم ضمها معاً لتصبح خيطاً يُعرف بالحرير المغزول",
 "絹紬": "بونجي (قماش رقيق ناعم منسوج من الحرير الخام (أو تقليد له))",
 "絹莢": "بازلاء ثلجية, بازلاء سكرية (بازلاء خضراء ذات قرون مسطحة صالحة للأكل) / بازلاء ثلجية, بازلاء سكرية (صنف من نبات البازلاء ينتج بازلاء ذات قرون مسطحة رقيقة صالحة للأكل)",
 "絹雲": "ذُؤَابَة / طَخَاء",
 "絽織": "شَاش",
 "絽織り": "شَاش",
 "經文": "أسفار مقدسة, كتاب مقدس (أي كتابة تعتبر مقدسة من قبل جماعة دينية) / الإنجيل, الكتاب المقدس (الكتابات المقدسة للديانات المسيحية)\nمثال: ذهب ليحمل كلمة الله (الإنجيل) إلى الوثنيين",
 "継ぎ": "مُصَحِّح / رَقَّعَ ((رَقَعَ) الشيخُ ونحوُه رَقْعًا: اعْتَمَد على راحَتَيْه عند القيام؛ (رَقَعَ) في سَيْرِه: أسْرَع) / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر. / خَلِيف / وَارِث, وَارِثَة (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى) / صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "継ぎ切れ": "مُصَحِّح / رَقَّعَ ((رَقَعَ) الشيخُ ونحوُه رَقْعًا: اعْتَمَد على راحَتَيْه عند القيام؛ (رَقَعَ) في سَيْرِه: أسْرَع)",
 "継ぎ台": "مِقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَقْعَدَة / بِرَاز\nمثال: نام ياني على مقعد. / جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل.",
 "継ぎ当て": "باتشوورك, ترقيع (خياطة تتكون من قطع من مواد مختلفة مخيطة معاً في نمط) / لحاف مرقع (لحاف مصنوع عن طريق خياطة رقع من خامات مختلفة معاً) / خليط, مزيج غير متجانس (نظرية أو حجة مكونة من أفكار متنوعة أو غير متناغمة)",
 "継ぎ手": "قارنة, وصلة (جهاز ميكانيكي يعمل على توصيل نهايات الأجسام المتجاورة) / خَلِيف / وَارِث, وَارِثَة (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "継ぎ接ぎ": "ترقيع (فعل إصلاح ثقب في ثوب بخياطة رقعة عليه) / جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع",
 "継ぎ木": "تَطْعِيم (زرع غصن من نوع من الشجر على غصن من نوع آخر، مثلا زرع غصن من البرتقال في شجرة ليمون لتكون النتيجة أن شجرة الليمون تنتج ليمونا وبرتقالا؛ علاج طبي يستهدف إلى منع الأمراض التي تتسبب من الجراثيم أو الفيروسات. استخدام حديث)",
 "継ぎ歯": "تَاج, إِكْلِيل",
 "継ぎ目": "مُشْتَرَك / مِفْصَل",
 "継ぎ目なし": "سَلِس, مُتَنَاغِم (متسق ومتماسك تماماً بلا انقطاع) / بِلَا تَجَاعِيد, بِلَا خُطُوط (أملس وناعم خاصّة في وصف البشرة) / سلس, غير موصول بدرزة (ليس لديه درزة أو غير متصل بدرزات)\nمثال: جوارب بدون درزات",
 "継ぎ目無し": "سَلِس, مُتَنَاغِم (متسق ومتماسك تماماً بلا انقطاع) / بِلَا تَجَاعِيد, بِلَا خُطُوط (أملس وناعم خاصّة في وصف البشرة) / سلس, غير موصول بدرزة (ليس لديه درزة أو غير متصل بدرزات)\nمثال: جوارب بدون درزات",
 "継ぎ穂": "سليل (حفيد أو وريث)\nمثال: سليل أصل ملكي",
 "継ぎ立て": "سِبَاق تَتَابُع",
 "継ぎ足し": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "継ぐ": "نَجَحَ / مُصَحِّح / رَقَّعَ ((رَقَعَ) الشيخُ ونحوُه رَقْعًا: اعْتَمَد على راحَتَيْه عند القيام؛ (رَقَعَ) في سَيْرِه: أسْرَع) / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول. / رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
