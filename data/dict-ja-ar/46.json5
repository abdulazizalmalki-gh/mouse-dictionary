 "紙漉き": "صناعة الورق (حرفة صنع الورق)",
 "紙皿": "طبق ورقي (طبق مصنوع من الورق المقوى يستخدم لمرة واحدة)",
 "紙礫": "كرة ملعوبة (رمية غير قانونية يتم فيها وضع مادة غريبة (لعاب أو فازلين) على الكرة من قبل…)",
 "紙筆": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما)\nمثال: تعبت من الكتابة.",
 "紙綴器": "دَبَّاسَة",
 "紙纏頭": "وَرَقَة",
 "紙花": "جهنمية ملساء, زهرة الورق (كرمة برازيلية تميل للإزهار بشكل مستمر) / وَرَقَة",
 "紙花花": "جهنمية ملساء, زهرة الورق (كرمة برازيلية تميل للإزهار بشكل مستمر)",
 "紙蚊帳釣": "بَرْدِيّ, كُولَان",
 "紙表紙": "وَرَقِيّ الغِلَاف ((للكتب) ذو غلاف مرن)",
 "紙袋": "كيس, كيس ورقي (كيس مصنوع من الورق أو البلاستيك لحمل مشتريات الزبائن)",
 "紙製": "وَرَق, قِرْطَاس (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)",
 "紙送り": "جهاز تغذية الورق, ملقم الورق (جهاز لإدخال أوراق في طابعة أو آلة كاتبة)\nمثال: تأخرت المهمة بسبب انسداد ملقم الورق",
 "紙鉄砲": "مسدس الفلين, مسدس لعبة (لعبة تتكون من مسدس لعبة يصدر صوت فرقعة)",
 "紙鍋": "هوت بوت (يخنة من اللحم والبطاطس مطبوخة في قدر محكم الغطاء)",
 "紙鑢": "وَرَق زُجَاج (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "紙面": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
 "紙飛行機": "طَائِرَة وَرَقِيَّة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير…)\nمثال: لقد وصلت الطائرة.",
 "紙鳶": "طَائِرَة وَرَقِيَّة, طيارة ورق (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير…)",
 "級": "دَرَجَة\nمثال: 彼は１０年級に在学中だ。 — هو في الصف العاشر. / صِنْف, صَنْف\nمثال: اقرأ هذا الفصل.",
 "級の木": "زيزفون ياباني (شجرة متوسطة الحجم من اليابان تستخدم للزينة)",
 "級別": "تصحيح, وضع الدرجات (تقييم الأداء عن طريق تعيين درجة أو نتيجة)\nمثال: ما كرهه في التدريس هو كل التصحيح الذي كان عليه القيام به",
 "級友": "زَمِيل دِرَاسَة, رَفِيق صَفّ",
 "級数": "سِلْسِلَة, مَجْمُوعَة",
