 "紛らわす": "أَلْهَى / أَخْفَى",
 "紛れ": "تريماتودا, مثقوبات (ديدان مفلطحة طفيلية لها ممصات خارجية للالتصاق بالمضيف) / اِلْتِبَاس\nمثال: لا داعي لارتباك. / لَاقَ (مَنْ يَلْقَى غَيْرَهُ)",
 "紛れもない": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس)",
 "紛れも無い": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس)",
 "紛れ当たり": "تريماتودا, مثقوبات (ديدان مفلطحة طفيلية لها ممصات خارجية للالتصاق بالمضيف)",
 "紛乱": "اِلْتِبَاس\nمثال: لا داعي لارتباك.",
 "紛争": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل…)\nمثال: شمال مالي منطقة نزاع.",
 "紛争国": "مُمَزَّقٌ بِالحَرْب (خَرَّبَتْهُ الحَرْبُ وَدَمَّرَتْه)",
 "紛争地": "بؤرة توتر, نقطة ساخنة (مكان للاضطرابات السياسية والعنف المحتمل)\nمثال: لا تستطيع الولايات المتحدة مراقبة جميع النقاط الساخنة في العالم",
 "紛失": "خَسَارَة, فِقْدَان",
 "紛擾": "إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي",
 "紛然": "اِحْتَارَ",
 "紛糾": "تَعْقِيد",
 "紛紛": "اِحْتَارَ",
 "紛議": "تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون)",
 "素": "مَنْشَأ / قَاعِدَة, أَسَاس / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي)\nمثال: سأرفع عليك قضية. / مَادِّيّ\nمثال: لا أحب مادة العلوم. / مُمْتَاز, فَاخِر / مَبْدَأ, قاعِدَة (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه) / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن. / بَسِيط\nمثال: هذا الشعور سهل. / بحيرة صغيرة, بركة (بركة صغيرة من المياه الراكدة) / بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "素っ": "أَكْثَر, أَغْلَب\nمثال: إنها غالية جدا!",
 "素っぴん": "اعتدال, رصانة (الامتناع عن الإفراط)",
 "素っ気ない": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك…)\nمثال: الماء بارد حقا.",
 "素っ気無い": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك…)\nمثال: الماء بارد حقا.",
 "素っ破": "جَاسُوس / لِصّ, لِصَّة / ضَجَعَ, تَمَدَّدَ\nمثال: اتهمتني بالكذب.",
 "素っ裸": "عُرْي / عَارٍ تَمَاماً ((غير رسمي) عارٍ تماماً بلا أي ملابس) / فقير",
 "素っ頓狂": "مُتَوَحِّش",
 "素っ飛ぶ": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة)\nمثال: أمسك بتلك الذبابة. / اِحْتَجَبَ, إخْتَفَى (وضع أمامه حجابا فلم يُعَد يُرى؛ وضع له حاجبا)",
 "素っ首": "رَئِيس, رَئِيسَة",
 "素で": "بصدق, حقاً (وفقاً للحقيقة أو الواقع)\nمثال: أصبحت الآن أمريكية حقاً",
 "素もぐり": "غطس, غوص حر (السباحة تحت الماء دون أي معدات تنفس أكثر من أنبوب التنفس)",
 "素人": "هَاوٍ, هَاوِيَة",
 "素人下宿": "بنزيون, نزل داخلي (منزل خاص يوفر الإقامة والوجبات للضيوف مقابل أجر)",
 "素人臭い": "غَيْر مَاهِر, هَاوٍ (يفتقر إلى المهارة أو الخبرة المهنية)",
 "素体": "بيبلو, تمثال صغير (تمثال صغير منحوت أو مقولب)",
 "素囊": "مَحْصُول",
 "素因": "استعداد مسبق, تأهب (استعداد مسبق للتفاعل بطريقة معينة)",
 "素因数": "عَامِل أَوَّلِيّ (العوامل الأولية لكمية ما هي جميع الكميات الأولية التي تقسم الكمية المعطاة…)",
 "素地": "قُمَاش, أقمشة (النسيج الذي لم يُقَصّ أو يُخَاط)\nمثال: الورق و القماش يمتصان الماء. / عَجِين, عَجِينَة / ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود)\nمثال: ابتكار الخطط / أساس, عمل تمهيدي (إعداد أولي كأساس أو قاعدة)\nمثال: نحن مستعدون اليوم بسبب العمل التمهيدي الذي تم قبل عشر سنوات",
 "素姓": "وِلَادَة, مَوْلِد\nمثال: أعرف ذلك الولد. / مُطَابَقَة / مسقط الرأس, منشأ (المكان الذي نشأ فيه شيء ما أو تمت رعايته في بداية وجوده)\nمثال: مهد الحضارة",
 "素子": "عُنْصُر كِيمِيَائِيّ, عُنْصُر (الْأَصْل؛ الجِنْس)\nمثال: المغنيزيوم عنصر كيميائي. / بَيَانَات, مَعْلُومَات",
 "素封家": "ثري, غني (شخص يمتلك ثروة مادية كبيرة)",
 "素志": "عَرِيق, قَدِيم العَهْد (مَوْجود مُنْذُ فَتْرَة طَويلَة)",
 "素性": "وِلَادَة, مَوْلِد\nمثال: أعرف ذلك الولد. / مُطَابَقَة / مسقط الرأس, منشأ (المكان الذي نشأ فيه شيء ما أو تمت رعايته في بداية وجوده)\nمثال: مهد الحضارة / مِيزَة\nمثال: محاسبة النفس صفة حميدة.",
 "素意": "عَرِيق, قَدِيم العَهْد (مَوْجود مُنْذُ فَتْرَة طَويلَة)",
 "素手で": "فَارِغ اليَدَيْن (لَا يَحْمِلُ شَيْئًا فِي يَدَيْه)",
 "素拍子": "دَاعِرَة, بَغِيَّة",
 "素振": "سُلُوك, تَصَرُّف",
 "素振り": "سُلُوك, تَصَرُّف",
 "素描": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / لَخَّصَ, اِخْتَصَرَ",
 "素数": "عَدَد أَوَّلِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "素敵": "جَمِيل, مَحْبُوب (يخاطب العواطف والعين معاً)",
 "素早い": "سَرِيع\nمثال: ينبح كلب في الحي.",
 "素晴らしき": "عَظِيم, رَائِع (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم.",
 "素晴らしさ": "مَجْد (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد…)\nمثال: المجد لأوكرانيا",
 "素朴": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "素朴実在論": "واقعية, واقعية ساذجة ((فلسفة) المذهب الفلسفي القائل بأن الأشياء المادية تستمر في الوجود عندما لا يتم…)",
 "素材": "مُقَوِّم / الموضوع، مادة البحث",
 "素案": "مُسْوَدَّة",
 "素気ない": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك…)\nمثال: الماء بارد حقا.",
 "素気無い": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك…)\nمثال: الماء بارد حقا.",
 "素湯": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "素潜り": "غطس, غوص حر (السباحة تحت الماء دون أي معدات تنفس أكثر من أنبوب التنفس)",
 "素焼": "بيسك, حساء القشطة البحرية (حساء كريمي كثيف مصنوع من المحار)",
 "素焼き": "بيسك, حساء القشطة البحرية (حساء كريمي كثيف مصنوع من المحار)",
 "素片": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية.",
 "素牛": "عِجْل (أسرع في إنجاز شيء أو القيام به؛ قدم شيئًا قبل وقته المعتاد)\nمثال: أنا في عجلة من أمري.",
 "素生": "وِلَادَة, مَوْلِد\nمثال: أعرف ذلك الولد. / مُطَابَقَة / مسقط الرأس, منشأ (المكان الذي نشأ فيه شيء ما أو تمت رعايته في بداية وجوده)\nمثال: مهد الحضارة",
 "素直": "مُطِيع, مُذْعِن / نَزِيه, صَادِق\nمثال: 思っていることを素直に言うのは悪いことではありません。 — قول ما تفكر فيه بصراحة ليس أمرًا سيئًا. / مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم. / مِعْيَارِيّ",
 "素知らぬ": "مُتَصَنَّع, مُصْطَنَع (غَيْر حَقِيقِيّ؛ مُفْتَعَل)",
 "素粒子": "جُسَيْم أَوَّلِيّ (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى…)\nمثال: نحن نعيش بعض اللحظات الحزينة حقا لأن بلادنا عانت من خسارة جسيمة. وسوف يستغرق وقتا طويلا قبل أن تعود إلى مجدها السابق.",
 "素粒子の相互作用": "تفاعل, تفاعل أساسي ((في الفيزياء) نقل الطاقة بين الجسيمات الأولية أو بين جسيم أولي ومجال أو بين…)",
 "素粒子加速器": "مُعَجِّل جُسَيْمَات",
 "素粒子物理学": "فيزياء الجسيمات (علم الطَّبيعة أو علم الطَّبيعيَّات)\nمثال: تدرس الفيزياء النووية.",
 "素行": "تصرف, سلوك (طريقة التصرف أو التحكم بالنفس)\nمثال: يمكن دراسة سلوك الجسيمات الصغيرة في التجارب",
 "素行が修まらない": "فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف)",
 "素行不良": "سوء تصرف, سوء سلوك (سلوك غير لائق أو شرير أو غير أخلاقي)",
 "素行障害": "سِي دِي",
 "素裸": "عُرْي / عَارٍ تَمَاماً ((غير رسمي) عارٍ تماماً بلا أي ملابس) / فقير",
 "素裸足": "حَافٍ, حَافِي (مال أو انحرف عن الشيء؛ سار على حافة الشيء أو حام حوله)\nمثال: وقف على حافة الجرف.",
