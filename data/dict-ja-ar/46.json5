 "縁起がよい": "مَيْمُون, مُبَشِّر (يبشر بظروف مواتية وحظ جيد)\nمثال: بداية مبشرة للحملة",
 "縁起が良い": "مَيْمُون, مُبَشِّر (يبشر بظروف مواتية وحظ جيد)\nمثال: بداية مبشرة للحملة",
 "縁起でもない": "سَيِّئُ الطَّالِع, مَنْحُوس (يَتَّسِمُ بِسُوءِ الحَظِّ أَوْ يُنْذِرُ بِهِ)",
 "縁起のいい": "مَيْمُون, مُبَشِّر (يبشر بظروف مواتية وحظ جيد)\nمثال: بداية مبشرة للحملة",
 "縁起のよい": "مَيْمُون, مُبَشِّر (يبشر بظروف مواتية وحظ جيد)\nمثال: بداية مبشرة للحملة",
 "縁起の悪い": "مَشْؤُوم, نَذِير شُؤْم (ينذر بسوء الحظ والطالع) / مُتَوَعِّد, مُنْذِر بِالشَّرّ (يهدد أو ينذر بتطورات شريرة أو مأساوية)",
 "縁起の良い": "مَيْمُون, مُبَشِّر (يبشر بظروف مواتية وحظ جيد)\nمثال: بداية مبشرة للحملة",
 "縁起もの": "طِلَسْم, طِلَّسْم",
 "縁起物": "طِلَسْم, طِلَّسْم",
 "縁辺": "حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما) / حافة, طرف (الحد الخارجي لجسم أو منطقة أو سطح؛ مكان أبعد ما يكون عن مركز الشيء) / أَفْضَلِيَّة نِسْبِيَّة, تَفَوُّق بَسِيط (ميزة تنافسية طفيفة) / حدة (سمة الإلحاح في نبرة الصوت)\nمثال: قام بتدوير حواف الصندوق",
 "縁遠い": "مُبَعْثَر, مُشَوَّش (يفتقر إلى الاستمرارية المنظمة) / غير متصل, منفصل (غير مربوط أو غير مرتبط معاً) / غَيْرُ مُتَّصِلٍ (ليست له صلة بالولادة أو العائلة)",
 "縁飾り": "تزيين الحواف, حاشية (حدود تتكون من أي شيء يوضع على الحافة لإنهاء شيء ما (مثل الأهداب على الملابس أو السجاد))",
 "縄": "حَبْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "縄のれん": "حَانَة, بَار",
 "縄ばしご": "سلم حبال (سلم ذو جوانب مصنوعة من الحبال)",
 "縄をかける": "تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "縄を掛ける": "تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "縄付き": "جِنَائِيّ, إِجْرَامِيّ / مُجْرِم, مُجْرِمَة",
 "縄墨": "مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "縄張": "حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي) / تخم, حد (حدود منطقة معينة)\nمثال: هناك خط رفيع بين العقل والجنون / مَجَال إِنْتَرْنَت / نِطَاق (الحزام المصنوع من القماش ليس له إبزيم ولا ما أشبه؛ قطعة من القماش تُلفّ على وسط الإنسان. الجمع نُطُق؛ في : هو جزء الدائرة كسطح (ليس قوس)؛ يقال أيضا قطاع. الجمع نطاقات)\nمثال: هل تمثل الزراعة على نطاق واسع النظام البيئي في الجزائر؟ / إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما)",
 "縄張り": "حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي) / تخم, حد (حدود منطقة معينة)\nمثال: هناك خط رفيع بين العقل والجنون / مَجَال إِنْتَرْنَت / نِطَاق (الحزام المصنوع من القماش ليس له إبزيم ولا ما أشبه؛ قطعة من القماش تُلفّ على وسط الإنسان. الجمع نُطُق؛ في : هو جزء الدائرة كسطح (ليس قوس)؛ يقال أيضا قطاع. الجمع نطاقات)\nمثال: هل تمثل الزراعة على نطاق واسع النظام البيئي في الجزائر؟ / إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما)",
 "縄張り争い": "حَرْب نُفُوذ, صِرَاع سَيْطَرَة (صراع مرير على الأرض أو السلطة أو السيطرة أو الحقوق)\nمثال: اندلعت حرب نفوذ بين عصابات الشوارع",
 "縄抜け": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "縄文字": "كيبو (آلة حاسبة تتكون من حبل بحبال ملحقة؛ استخدمها البيروفيون القدماء للحساب وحفظ السجلات)",
 "縄暖簾": "حَانَة, بَار",
 "縄梯子": "سلم حبال (سلم ذو جوانب مصنوعة من الحبال)",
 "縄目": "عُقْدَة / عَقَدَ (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد. / تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "縄跳び": "نَط اَلْحَبْل",
 "縊く": "خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته.",
 "縋りつく": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "縋り付く": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "縋る": "رَجَا (رَجَا يرْجُو رَجْوًا ورَجاءً ورَجاةً ورَجاءةً ورَجاوةً ومَرْجاةً: رجاه أملًا به؛ ورَجَاه: ناشده وتوسّل إليه)",
 "縒り": "لَوَى, بَرَمَ",
 "縒り合わせる": "اِنْضَفَرَ, تَدَاخَلَ",
 "縒り糸": "برم, دوران سريع (عملية الدوران بسرعة) / تشويه, لوي الحقائق (فعل تشويه الشيء ليبدو وكأنه يعني شيئاً لم يكن يقصده) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: أدار الكرنك بقوة",
 "縒る": "لَوَى, بَرَمَ",
 "縒糸": "برم, دوران سريع (عملية الدوران بسرعة) / تشويه, لوي الحقائق (فعل تشويه الشيء ليبدو وكأنه يعني شيئاً لم يكن يقصده) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: أدار الكرنك بقوة",
 "縛": "إرساء, ربط السفينة (فعل تأمين سفينة واصلة بالحبال)",
 "縛する": "أَسَرَ, رَبَطَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: إن توم لا يملك أسرة.",
 "縛め": "رباط, وصلة تثبيت (وصلة تثبت الأشياء ببعضها البعض) / صفد, قيد (قيد يحد أو يقيد الحرية (خاصة شيء يستخدم لربط أو تقييد سجين)) / التصاق, تلاصق (خاصية الالتصاق معاً (كالغراء والخشب) أو انضمام أسطح مختلفة التكوين) / رابطة, رابطة كيميائية (قوة كهربائية تربط الذرات)\nمثال: الالتصاق المتبادل للخلايا",
 "縛める": "أَسَرَ, رَبَطَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: إن توم لا يملك أسرة.",
 "縛り": "تضميد, تضميد الجراح (عمل وضع ضمادة) / مُلْزِم (مُنَفَّذٌ بِسُلْطَةٍ قَانُونِيَّةٍ صَحِيحَة) / تجليد, غلاف الكتاب (الغطاء الواقي لمقدمة الكتاب ومؤخرته وكعبه) / حاشية, شريط ربط (شريط مخيط فوق أو على طول حافة لتقويتها أو تزيينها)\nمثال: كان للكتاب تجليد جلدي / تَنْظِيم",
 "縛りあげる": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
 "縛りつける": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل.",
 "縛りプレイ": "تقييد جنسي (ممارسة جنسية تتضمن تقييد أحد الشريكين جسديًا (بالحبال أو الأصفاد)) / رق, عبودية (حالة الخضوع لسيطرة شخص آخر) / استرقاق, عبودية (حالة الخضوع لسيطرة قوة أو تأثير أو قوة مجردة)\nمثال: كان في عبودية للخوف",
 "縛りプレー": "تقييد جنسي (ممارسة جنسية تتضمن تقييد أحد الشريكين جسديًا (بالحبال أو الأصفاد)) / رق, عبودية (حالة الخضوع لسيطرة شخص آخر) / استرقاق, عبودية (حالة الخضوع لسيطرة قوة أو تأثير أو قوة مجردة)\nمثال: كان في عبودية للخوف",
 "縛り上げる": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
 "縛り付ける": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل.",
 "縛り首": "شَنْق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة.",
 "縛る": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل. / حَدَّ, حَدَّدَ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "縛帯": "ضِمَادَة, عِصَابَة / عِنان",
 "縞": "شريط, نطاق (زينة تتكون من شريط بلون أو مادة مغايرة) / تقليم, خط (علامة ضيقة بلون أو ملمس مختلف عن الخلفية) / صنف, طينة (نوع أو فئة (من الناس أو التوجهات)) / شارة الرتبة, شريط رتبة\nمثال: ضفدع أخضر بخطوط سوداء صغيرة",
 "縞々": "مُخَطَّط",
 "縞スカンク": "ظربان مخطط (أكثر أنواع الظربان شيوعاً وانتشاراً في أمريكا الشمالية)",
 "縞味": "شَرْشِير صَيْفِيّ",
 "縞栗鼠": "صيدناني (سنجاب أرضي يحفر الجحور من غرب أمريكا وآسيا؛ له جيوب خدية وشريط فاتح وداكن يمتد أسفل الجسم)",
 "縞瑪瑙": "جَزْع (قَطَعَ الشَّيءَ؛ قَطَعَ النَّهْرَ عَرْضًا)",
 "縞縞": "مُخَطَّط",
 "縞蝿": "ذبابة اللحم (ذبابة تتغذى يرقاتها على الجيف أو لحم الحيوانات الحية)",
 "縞蠅": "ذبابة اللحم (ذبابة تتغذى يرقاتها على الجيف أو لحم الحيوانات الحية)",
 "縞馬": "حِمَار وَحْشِيّ, حِمَار وَحْشِيّ مُخَطَّط (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة)\nمثال: هن بحاجة لحمار.",
 "縡": "شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما. / حَادِث, حَادِثَة / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة / عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل.",
 "縢": "خَيْط, خيط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه) / خَيْط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه) / مَوْضُوع",
 "縢がり": "رفو (فعل إصلاح ثقب في ثوب بخيوط متقاطعة)",
 "縢がる": "غَرَزَة",
 "縢り": "رفو (فعل إصلاح ثقب في ثوب بخيوط متقاطعة)",
 "縢る": "غَرَزَة",
 "縣": "مَبْنَى الْوِلَايَة (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص)) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى)\nمثال: دخل توم المبنى. / إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما) / رِيف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة)\nمثال: الريف بلد كبير.",
 "縦": "عَمُودِيّ / رَأْسِيّ / طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير. / سدى (الخيط المرتب طولياً على النول ويقطعه اللحمة) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / اعوجاج, انبعاج (شكل مشوه باللي أو الطي) / انحراف (التواء أو شذوذ؛ خاصة طريقة منحرفة أو غير طبيعية في الحكم أو التصرف) / أَنَانِيّ",
 "縦と横": "لُحْمَة وَسَدَاة (هو اللَحْم، واللحمة أخصُّ من اللحم؛ قطعة من اللحم)",
 "縦にする": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "縦ひき": "منشار شق طولي (منشار يدوي للقطع مع اتجاه ألياف الخشب)",
 "縦びき": "منشار شق طولي (منشار يدوي للقطع مع اتجاه ألياف الخشب)",
 "縦パス": "تمريرة أمامية (تمريرة إلى مستقبل في الملعب بعيدًا عن الممرر)",
 "縦ロール": "فراشة الحلقات (حشرة صغيرة رقيقة ذات أجنحة كبيرة قد تكون ملونة أو غير ملونة) / حلقة صغيرة, خاتم صغير (خاتم صغير) / تجعيد, حلقة (شكل مستدير يتكون من سلسلة من الدوائر متحدة المركز (كما تشكلها الأوراق أو بتلات الزهور)) / حَلَقَة شَعْر, خُصْلَة لَوْلَبِيَّة (خصلة شعر على شكل لولب أو تجعيدة)\nمثال: آه ، هناك فراشة!",
 "縦列": "عَمُود / خَانَة",
 "縦割り行政": "إقليمية, مناطقية (التحيز لمكان أو منطقة معينة)",
