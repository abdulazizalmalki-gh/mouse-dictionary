 "ぬれごとし": "زير نساء (رجل يحب العديد من النساء ويقيم علاقات جنسية قصيرة معهن)",
 "ぬれすけ": "رَقِيقٌ كَالغَزْل, شَفَّاف (بَالِغُ الرِّقَّةِ بِحَيْثُ يَنْفُذُ مِنْهُ الضَّوْء)",
 "ぬれぬれ": "بِتَبَلُّل, بِرُطُوبَة (بطريقة رطبة)\nمثال: كان هناك وشاح مربوط حول رأسها لكن الخصلة المتمردة هربت وتدلت برطوبة فوق عينها اليسرى / دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة)",
 "ぬればいろ": "أبنوسي, أسود حالك (أسود داكن جداً)",
 "ね": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة. / شَعَاب / جُرَذ, فَأْر ((جَرَذَت) القرحة جرذا: تعقدت كالجُرَذِ)\nمثال: عبر جرذ الطريق. / شَمَال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد. / نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة. / يَاه, اسمع / يَعْنِي / أَرْضَى, أَعْجَبَ\nمثال: يا لها من جملة! / ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن. / قِيمَة / مَعْدُوم / لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…) / سليم\nمثال: اقرأ بصوت عالي.",
 "ねあか": "طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة)",
 "ねあがり": "ارتفاع السعر, زيادة السعر (زيادة في السعر)",
 "ねあがりえき": "أرباح رأسمالية, مكاسب رأسمالية (المبلغ الذي يتجاوز به سعر بيع الأصل سعر الشراء؛ يتحقق الربح عند بيع الأصل)",
 "ねあげ": "ارتفاع السعر, زيادة السعر (زيادة في السعر)",
 "ねあせ": "فَرْط التَّعَرُّق اللَّيْلِيّ",
 "ねい": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "ねいあく": "انحراف, شذوذ (الانحراف المتعمد عما هو خير وصواب)\nمثال: سيكون هناك دائمًا قلة من الناس يجدون متعة في التنمر والإرهاب بدافع الانحراف",
 "ねいかん": "خَؤُون, غَادِر (يَمِيل إِلَى الخِيَانَة؛ خَاصَّةً ذُو طَبِيعَة غَادِرَة)",
 "ねいしん": "خَائِن, خَائِنَة (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك!",
 "ねいじん": "مُتَمَلِّق, مُداهِن (شخص يستخدم الإطراء والتملق)",
 "ねいす": "أَرِيكَة, كَنَبَة (قطعة أثاث مُنَجَّدَة يُقْعَدُ عليها، مَقْعَد مُنَجَّد)\nمثال: إنها على الأريكة.",
 "ねいせい": "هَادِئ",
 "ねいち": "خديعة, دهاء (صفة الدهاء والمكر)",
 "ねいは": "نِينْغْبُو",
 "ねいべん": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "ねいもう": "شَرِس ((شَرَسَ) الجِلْدَ يَشْرُسُ شَرْسًا: دَلكَهُ؛ (شَرَسَ) صاحبَه: أمَضَّهُ بالقول)\nمثال: احذر من الكلب الشرس",
 "ねいる": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)\nمثال: その赤ちゃんは泣き疲れて寝入った。 — بكى الطفل حتى نام.",
 "ねいろ": "جرس الصوت, خامة الصوت ((موسيقى) الخاصية المميزة لصوت مركب (صوت بشري أو ضجيج أو صوت موسيقي))\nمثال: كان جرس صوت السوبرانو الخاص بها غنياً وجميلاً",
 "ねうち": "قِيمَة / تثمين, تقدير (حكم على صفات شيء أو شخص ما)\nمثال: في تقديري الصبي بريء / صَفْقَة (عَقْد، اتِّفَاق؛ ضرب اليدين عند العقد)\nمثال: إنها صفقة جيدة.",
 "ねぇ": "يَاه, اسمع / يَعْنِي / أَرْضَى, أَعْجَبَ\nمثال: يا لها من جملة! / مَعْدُوم / لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)",
 "ねえ": "يَاه, اسمع / يَعْنِي / أَرْضَى, أَعْجَبَ\nمثال: يا لها من جملة! / الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى / مَعْدُوم / لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)",
 "ねえさま": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى",
 "ねえさん": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى / آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ. / سيدة (امرأة راقية)\nمثال: فتح السائق باب الليموزين للسيدة الكبيرة",
 "ねえちゃん": "الْأُخْت الْكُبْرَى, الشَّقِيقَة الْكُبْرَى / بِنْت\nمثال: أنا أري الفتاة.",
 "ねえねえ": "يَاه, اسمع",
 "ねえや": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "ねおき": "وَاعٍ, يَقِظ (يتسم بالوعي الكامل والانتباه)\nمثال: أيام الخطر وليالي اليقظة / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "ねかしつける": "نَوَّمَ, أَنَامَ (بكافة معانيه)\nمثال: لم أستطع النوم.",
 "ねかた": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "ねかぶ": "جُذْمُور, كُنَّاشَة",
 "ねから": "مطلقا, على الإطلاق",
 "ねからはから": "مطلقا, على الإطلاق",
 "ねかん": "تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل)",
 "ねがい": "رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي)\nمثال: يمكن لتوم البقاء إن رغب. / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا. / صَلَاة, دُعَاء / تَطْبِيق\nمثال: هذا الكتاب جديد",
 "ねがいごと": "أُمْنِيَّة",
 "ねがいさげ": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما) / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "ねがいしょ": "تَطْبِيق\nمثال: هذا الكتاب جديد",
 "ねがいで": "تَطْبِيق\nمثال: هذا الكتاب جديد",
 "ねがいでる": "سَأَلَ, طَلَبَ (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا.",
 "ねがいぬし": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى…)\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "ねがいもとめる": "اِلْتَمَسَ, تَوَسَّلَ",
 "ねがう": "رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي)\nمثال: يمكن لتوم البقاء إن رغب. / اِسْتَجْدَى, تَسَوَّلَ",
 "ねがえり": "خيانة, غدر (فعل خيانة متعمد)",
 "ねがえりをうつ": "قَلَبَ / خانَ (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة.",
 "ねがえる": "خانَ (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / قَلَبَ",
 "ねがかり": "عقبة خفية, عقدة (عقبة غير متوقعة)",
 "ねがさかぶ": "ثَمِين, غَالٍ (ذو سعر مرتفع)",
 "ねがた": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "ねがってもない": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة)\nمثال: أهلا يا أصدقاء.",
 "ねがふかい": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "ねがわくは": "لَيْتَ, تَمَنَّى (يفيد التمني)\nمثال: ليت بحاجة لتعمل ساعات إضافية.",
 "ねがわくば": "لَيْتَ, تَمَنَّى (يفيد التمني)\nمثال: ليت بحاجة لتعمل ساعات إضافية.",
 "ねがわしい": "مرغوب فيه, مستحب (يستحق الامتلاك أو السعي إليه أو تحقيقه)\nمثال: وظيفة مرغوبة",
 "ねき": "جَانِب",
 "ねきり": "إبادة",
 "ねきりむし": "دودة قارضة (عثة أمريكية شمالية تتغذى يرقاتها على سيقان النباتات الصغيرة وتقطعها عند مستوى…)",
 "ねぎ": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر) / كَاهِن, قِسِّيس / جُنْدُب, جَرَادَة",
 "ねぎらい": "شُكْرًا",
 "ねぎり": "استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون",
 "ねぎる": "سَاوَمَ (بالسلعة وعليها: غالى بها وفاوض عليها، أي عرضها بثمن ودفع له المشتري أقل منه…)",
 "ねぎパイ": "بصل أخضر (بصل صغير قبل تضخم البصلة؛ يؤكل في السلطات)",
 "ねくいはむし": "خنفساء الأوراق (خنفساء زاهية الألوان تتغذى على أوراق النباتات؛ وتغزو يرقاتها الجذور والسيقان)",
 "ねくら": "كَئِيب, مُوحِش",
 "ねぐされ": "عفن الجذور (مرض يتميز بتعفن الجذور؛ تسببه فطريات مختلفة)",
 "ねぐら": "مجثم (مجثم تستريح عليه أو تنام عليه الطيور الداجنة) / وِسَادَة (الجانب السفلي اللحمي الشبيه بالوسادة لقدم الحيوان أو إصبع الإنسان)",
 "ねこ": "قِطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط. / شَامِيسِين / غَيْشَا / عَرَبَة يَدَوِيَّة, عَجَلَة يَد",
 "ねこいたち": "نِمْس",
 "ねこかぶり": "دُعابة, مَقلَب (فعل مضحك أو غريب يتم القيام به للمرح والتسلية)\nمثال: 猫かぶりしてもお前の正体は分かっているよ。 — أنت ذئب في ثياب خروف.",
 "ねこかわいがり": "مُتَيَّم, مُدَلِّل (محب بإفراط أو بحماقة ومُتسامح بلا حدود)",
 "ねこぐるま": "عَرَبَة يَدَوِيَّة, عَجَلَة يَد",
 "ねこじゃらし": "ذيل الثعلب الأخضر (ذيل ثعلب أوروبي متوطن في أمريكا الشمالية؛ غالباً ما يكون عشبة ضارة مزعجة)",
 "ねこすな": "رمل فضلات القطط (طين محبب يوضع في حاوية حيث يمتص فضلات القطط أو الكلاب)",
 "ねこずな": "رمل فضلات القطط (طين محبب يوضع في حاوية حيث يمتص فضلات القطط أو الكلاب)",
 "ねこぜ": "أحدب (شخص ظهره مقوس بسبب انحناء غير طبيعي في العمود الفقري العلوي)",
 "ねこそぎ": "كُلّ, جَمِيع",
 "ねこっかわいがり": "مُتَيَّم, مُدَلِّل (محب بإفراط أو بحماقة ومُتسامح بلا حدود)",
 "ねこのてもかりたい": "قَلِيل المَوْظَّفِين, نَاقِص العَدَد (يفتقر إلى العدد الكافي من العاملين أو المساعدين)",
 "ねこのみ": "برغوث القط (برغوث يتكاثر بشكل رئيسي على القطط والكلاب والجرذان)",
 "ねこのめ": "مُتَقَلِّب, نَزَوِيّ (عرضة لتغيّرات مفاجئة وغير متوقّعة)",
 "ねこばば": "اِخْتِلَاس (الخَلَسُ: الأخذ نُهْزَةومخاتلة، والاختلاس كالخَلَسِ؛ أخذه خُِلْسَةً أي اختلاسا)\nمثال: لقد اتهم باختلاس الأموال العامة.",
 "ねこふんじゃった": "أَعْوَاد الْأَكْل, هَاشِي",
 "ねこま": "قِطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط.",
 "ねこまんま": "القط الغذاء",
 "ねこみ": "نَائِم",
 "ねこめ": "مُتَقَلِّب, نَزَوِيّ (عرضة لتغيّرات مفاجئة وغير متوقّعة)",
 "ねこめし": "القط الغذاء",
 "ねこようトイレ": "صُنْدُوق فَضَلَات, صُنْدُوق رَمْل (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها…)\nمثال: أين صندوق البريد؟",
 "ねころがる": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة)\nمثال: استلقى على السرير.",
 "ねころぶ": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة)\nمثال: استلقى على السرير.",
 "ねこトイレ": "صُنْدُوق فَضَلَات, صُنْدُوق رَمْل (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها…)\nمثال: أين صندوق البريد؟",
 "ねごこち": "تحسس\nمثال: شعر ماريا طويل.",
 "ねごと": "حديث أثناء النوم (نطق الكلام أثناء النوم) / هُرَاء, لَغْو",
 "ねごみ": "نَائِم",
 "ねごろ": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "ねさげ": "تخفيض السعر, خصم (عملية تخفيض سعر بيع البضائع)",
 "ねざけ": "المباراة الختامية (المباراة الأخيرة في سلسلة من مباراتين متتاليتين)",
 "ねざめ": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "ねざめる": "صَحَا, اِسْتَيْقَظَ (أَفَاقَ؛ اِسْتَيْقَظَ)\nمثال: أيقظ زيري السائق",
