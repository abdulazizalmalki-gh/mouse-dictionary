 "にちうん": "حلقة شمسية, هالة شمسية (هالة مضيئة موازية للأفق عند ارتفاع الشمس؛ تسببها بلورات الجليد في الغلاف الجوي)",
 "にちがい": "ذات مرة, سابقاً (في وقت سابق)\nمثال: في وقت ما أحبها",
 "にちぎん": "بنك اليابان (البنك المركزي لليابان)",
 "にちぎんたんかん": "قَصِير الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة مَحْدودَة أَوْ مُمْتَدّ عَلَيْها)",
 "にちぎんほう": "بنك اليابان (البنك المركزي لليابان)",
 "にちげつ": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب.",
 "にちご": "يَابَانِيّ / ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "にちごこう": "اللغة اليابانية (اللغة (التي تعتبر عادة ألطية) التي يتحدث بها اليابانيون)",
 "にちじ": "يَوْمِيّ",
 "にちじょう": "اعْتِيَادِيّ, يَوْمِيّ (شَائِع وَعَادِيّ؛ مِنَ الحَيَاة اليَوْمِيَّة)",
 "にちじょうかいわ": "يَوْمِيّ (يتعلق بكل يوم أو يحدث كل يوم)",
