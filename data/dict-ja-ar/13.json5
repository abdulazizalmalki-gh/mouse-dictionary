 "にたにた": "إِهْلَاس",
 "にたまご": "بَيْضَة مَسْلُوقَة, بَيْض مَسْلُوق (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان)",
 "にたものどうし": "قريب بعيد (قريب بعيد نوعاً ما؛ مألوف بما يكفي ليتم تحيته بقبلة)",
 "にたものふうふ": "رجل وزوجته, زواج (شخصان متزوجان من بعضهما البعض)\nمثال: كان زواجه الثاني أكثر سعادة من الأول",
 "にたり": "مُزَيَّف / صندل, طوافة (قارب مسطح القاع لحمل الأحمال الثقيلة (خاصة في القنوات)) / بزهو, بغرور (بطريقة الرضا المفرط عن النفس)\nمثال: شرح البيروقراطيون بزهو أن الحقائق المقدمة من خبرائهم لا تظهر أي داع للقلق",
 "にたりぶね": "صندل, طوافة (قارب مسطح القاع لحمل الأحمال الثقيلة (خاصة في القنوات))",
 "にだ": "حُزْمَة, عُبُوَّة / وَضَّبَ / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: حزم ياني أمتعته.",
 "にだい": "حامل أمتعة (حامل (كما خلف مقعد الدراجة) للأمتعة)",
 "にだいせいとうしゅぎ": "ثُنَائِيُّ الحِزْبِيَّة (مَدْعُومٌ مِنْ كِلَا الجَانِبَيْن)",
 "にだいせいとうせい": "ثُنَائِيُّ الحِزْبِيَّة (مَدْعُومٌ مِنْ كِلَا الجَانِبَيْن)",
 "にだいめ": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "にだしじる": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل.",
 "にだな": "رف أمتعة, رف سقف (حامل لحمل الأمتعة فوق مقاعد القطار أو فوق السيارة)",
 "にだん": "ثُنَائِيّ / ضِعْف",
 "にだんかいにんしょう": "مُصَادَقَة ثُنَائِيَّة (إِخْلاَصٌ فِي الصَّدَاقَةِ؛ الإقرار والموافقة على الشيء)",
 "にだんベッド": "سَرِير بِطَابَقَيْن (قطعة أثاث للنوم والاستلقاء والجلوس؛ مسطبة من الخشب المزيَّن يوضع عليه كرسي، يغلب على ما تحت عرش الملك)\nمثال: قاس طول السرير.",
 "にち": "الْأَحَد, يَوْم الْأَحَد / الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان. / ثُنَائِيّ (يتكوّن من وحدتين أو مكوّنين أو عنصرين) / ثنائي (من أو متعلق بنظام أرقام أساسه 2) / برنامج ثنائي, ملف ثنائي (برنامج مسبق التجميع والربط جاهز للتشغيل تحت نظام تشغيل معين؛ الملف الثنائي لنظام تشغيل ما لن يعمل على نظام مختلف) / نَجْم ثُنَائِيّ, نَجْم مُزْدَوِج (نظام من نجمين يدوران حول بعضهما البعض تحت تأثير جاذبيتهما المتبادلة)\nمثال: رقم ثنائي",
 "にちうん": "حلقة شمسية, هالة شمسية (هالة مضيئة موازية للأفق عند ارتفاع الشمس؛ تسببها بلورات الجليد في الغلاف الجوي)",
 "にちがい": "ذات مرة, سابقاً (في وقت سابق) / في آن واحد, في المرة الواحدة (بشكل متزامن)\nمثال: في وقت ما أحبها",
 "にちぎん": "بنك اليابان (البنك المركزي لليابان)",
 "にちぎんたんかん": "قَصِير الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة مَحْدودَة أَوْ مُمْتَدّ عَلَيْها)",
 "にちぎんほう": "بنك اليابان (البنك المركزي لليابان)",
 "にちげつ": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "にちご": "يَابَانِيّ / ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "にちごこう": "اللغة اليابانية (اللغة (التي تعتبر عادة ألطية) التي يتحدث بها اليابانيون)",
 "にちじ": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "にちじょう": "اعْتِيَادِيّ, يَوْمِيّ (شَائِع وَعَادِيّ؛ مِنَ الحَيَاة اليَوْمِيَّة) / عَادِيّ, يَوْمِيّ (مُنَاسِبٌ لِلْمُنَاسَبَاتِ العَادِيَّةِ أَوِ الرُّوتِينِيَّةِ) / رُوتِينِيّ, يَوْمِيّ (يوجد في المجرى العادي للأحداث)",
 "にちじょうかいわ": "يَوْمِيّ (يتعلق بكل يوم أو يحدث كل يوم)",
 "にちじょうご": "دَارِج, عَامِّيّ (خَاصٌّ بِاللُّغَةِ اليَوْمِيَّةِ أَوْ مُنَاسِبٌ لَهَا) / لغة دارجة (الكلام اليومي للناس (تمييزاً عن اللغة الأدبية)) / رطانة, عامية خاصة (لغة مميزة لمجموعة معينة (كما بين اللصوص))\nمثال: هم لا يتحدثون لغتنا",
 "にちじょうせい": "اعْتِيَادِيَّة, عَادِيَّة (صفة كون الشيء مألوفاً وعادياً)",
 "にちじょうせいかつ": "حَيَاة يَوْمِيَّة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "にちじょうせいかつどうさ": "أنشطة الحياة اليومية",
 "にちじょうてき": "دُنْيَوِيّ / عَادِيّ / مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "にちにち": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ / أَيَّام / يَوْمًا بَعْدَ يَوْم",
 "にちにちそう": "عناقية, عين البزون (عشب خشبي من العالم القديم يزرع عادة وله أزهار كبيرة وردية إلى حمراء)",
 "にちへんか": "تغير نهاري (تقلبات تحدث خلال اليوم الواحد)",
 "にちべつ": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "にちぼつ": "غُرُوب, مَغْرِب (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / غُرُوب اَلشَّمْس (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / خَاتِمَة, قَيَامَة\nمثال: نحب غروب الشمس.",
 "にちゃく": "وَصِيفَة",
 "にちゃにちゃ": "حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار) / لَزِج, مُغَطًّى بِالْوَحْلِ (مغطّى بمادة لزجة أو يشبهها)",
 "にちや": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "にちょっかく": "زَاوِيَة مُسْتَقِيمَة",
 "にちよう": "الْأَحَد, يَوْم الْأَحَد\nمثال: 銀行は日曜にはやってません。 — لا يكون المصرف مفتوحاً أيام الأحد.",
 "にちようがっこう": "مدرسة الأحد (مدرسة تجتمع أيام الأحد للتعليم الديني)",
 "にちようだいく": "افْعَلْهَا بِنَفْسِكَ (يُنجَز بنفسك دون الاستعانة بمتخصص)",
 "にちようび": "الْأَحَد, يَوْم الْأَحَد",
 "にちりん": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس.",
 "にちりんそう": "زَهْرَة اَلشَّمْس, دَوَّار اَلشَّمْس",
 "にちろく": "رتك المحور, عنق المحور (جزء المحور المحتوي داخل المحمل) / دفتر يومية, سجل (كتاب سجل كشيء مادي) / مذكرات, يوميات (سجل كتابي يومي للتجارب والملاحظات (الشخصية عادة)) / دورية, مجلة علمية (دورية مخصصة لموضوع معين)\nمثال: يقرأ المجلات الطبية",
 "にちわ": "آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "にちわー": "آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "にっかい": "جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان",
 "にっかん": "نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر إلى غروب الشَمْس. ضد اللَيْل)\nمثال: نهار اليوم ممل! / مُشْط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مِشْط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مِمْشَط / مشط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مُشط (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة) / مشطة / مَشَطَ, مَشَّطَ (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "にっかんてき": "شَهْوَانِيّ",
 "にっき": "قِرْفَة / دَفْتَرُ يَوْمِيّاتٍ, يَوْمِيَّات",
 "にっきちょう": "دَفْتَرُ يَوْمِيّاتٍ, يَوْمِيَّات",
 "にっきん": "وردية نهارية (عمال يعملون أثناء النهار (مثل من 8 صباحًا إلى 4 مساءً)) / وردية نهارية (نوبة العمل أثناء النهار (مثل 8 صباحاً إلى 4 مساءً))",
 "にっくき": "مَحْكُومٌ بِلَعْنَة, مَلْعُون (تحت لعنة)",
 "にっけい": "قِرْفَة / سُوَيْق, سُوَيْقَة / زُب, زُبْر (في : اللحية أو مقدمها؛ في : الأنف) / عُقُوبَةٌ بَدَنِيَّة",
 "にっけいいろ": "قِرْفَة",
 "にっこう": "ضَوْء شَمْس, نُور شَمْس (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف. / جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "にっこうかくかしょう": "تقران سفعي/تقرن سفعي",
 "にっこうきすげ": "زنبق النهار (أي من النباتات المعمرة المتعددة ذات جذور درنية وأوراق طويلة ضيقة تشبه النصل وزهور تشبه الزنبق صفراء عادة تتفتح ليوم واحد فقط) / زنبق لسان الحمل, هوستا (أي من النباتات المعمرة العديدة التي تتميز بكتل من الأوراق المضلعة العريضة الفخمة وعناقيد من الزهور البيضاء أو الزرقاء أو الليلكية؛ تستخدم كغطاء أرضي)",
 "にっこうせいこくし": "بقعة كبدية (نوع من الأمراض الجلدية يسبب بقعاً بنية على الجلد)",
 "にっこうはんしゃしんごう": "رسالة شمسية (رسالة ترسل عن طريق أشعة الشمس)",
 "にっこうよく": "حَمَّام شَمْس (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "にっこうよくしつ": "غرفة مشمسة, مقصورة شمسية (غرفة محاطة بالزجاج بشكل كبير وتوفر التعرض للشمس)",
 "にっこうりょうほう": "علاج شمسي (التعرض العلاجي لأشعة الشمس)",
 "にっこり": "برقة, بعذوبة (بطريقة حنونة أو محبة)\nمثال: تؤدي سوزان هيوار دور الزوجة بحدة وعذوبة",
 "にっさん": "نيسان (الشهر السابع من السنة المدنية؛ الشهر الأول من السنة الدينية (في مارس وأبريل))",
 "にっし": "رتك المحور, عنق المحور (جزء المحور المحتوي داخل المحمل) / دفتر يومية, سجل (كتاب سجل كشيء مادي) / مذكرات, يوميات (سجل كتابي يومي للتجارب والملاحظات (الشخصية عادة)) / دورية, مجلة علمية (دورية مخصصة لموضوع معين)\nمثال: يقرأ المجلات الطبية / أَيَّام",
 "にっしゃ": "إشعاع شمسي (إشعاع صادر من الشمس)",
 "にっしゃびょう": "ضربة شمس, فرط الحرارة (انهيار ناتج عن التعرض للحرارة المفرطة)",
 "にっしゅう": "نَهَارِيّ",
 "にっしゅうしさ": "تزيح أرضي المركز, تزيح نهاري (تزيح جرم سماوي باستخدام نقطتين على سطح الأرض أثناء دوران الأرض)",
 "にっしゅつ": "شُرُوق, شُرُوق الشَّمْس (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, صَحْوَة (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: شروق الشمس جميل هذا الصباح.",
 "にっしゅつこく": "أَرْضُ الشَّمْسِ الْمُشْرِقَةِ (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "にっしょう": "ضَوْء شَمْس, نُور شَمْس (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "にっしょうき": "علم وطني (شعار يُرفع كرمز للجنسية)",
 "にっしょうけい": "مرآة الإشارة الشمسية, هيليوجراف (جهاز لإرسال رسائل التلغراف باستخدام مرآة لقطع أشعة الشمس وتشغيلها)",
 "にっしょく": "كُسُوف اَلشَّمْس",
 "にっしん": "يَوْمِيّ (يتعلق بكل يوم أو يحدث كل يوم)",
 "にっしんしさ": "تزيح سنوي, تزيح شمسي المركز (تزيح جرم سماوي باستخدام نقطتين في مدار الأرض حول الشمس كخط أساس)",
 "にっせき": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "にっちゅう": "نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر إلى غروب الشَمْس. ضد اللَيْل)\nمثال: نهار اليوم ممل!",
