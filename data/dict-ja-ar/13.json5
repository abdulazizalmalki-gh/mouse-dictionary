 "はなしをもる": "بَالَغَ",
 "はなじ": "رُعَاف",
 "はなじる": "مُخَاط, مُخَاط أَنْف",
 "はなす": "أَطْلَقَ سَرَاح, حَرَّرَ / فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل. / تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه. / تَحَدَّثَ, تَكَلَّمَ (كَلَّمَ، حَدَّثَ، تَكَلَّمَ)\nمثال: يمكنكما التحدث.",
 "はなせん": "إِسْفِين (عبارة عن وَتَد أو قطعة من الخَشَب أو الحَدِيد تستخدم في البِنَاء والنِجَارَة بلإبقاء على فُرْجَة بين الأجسام، خصوصا ألواح الخشب، أو لتكوين هذه الفرجة؛ دَقَّ بينهم إسفينا: فَرَّقَ بينهم) / وَتِد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / وَتَد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها)",
 "はなぞの": "حَدِيقَة أَزْهَار (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة.",
 "はなたか": "مَغْرُور, فَخُور",
 "はなたかだか": "فَخُور",
 "はなたけ": "شبه غدي, غداني (يتعلق بـ أو يشبه الغدد الليمفاوية أو الأنسجة اللمفاوية) / لحمية, لوزة بلعومية (تجمع من الأنسجة اللمفاوية في الحلق خلف اللهاة (على الجدار الخلفي وسقف البلعوم الأنفي))\nمثال: تضخم اللوزتين البلعوميتين يسمى اللحمية",
 "はなたて": "زَهْرِيَّة",
 "はなたば": "شَذًى, شَذًا",
 "はなたらし": "مُخَنْفِر (شخص يتنفس بصوت مسموع من خلال أنف محتقن) / ساذج, غر (شاب أخرق وقليل الخبرة)",
 "はなたれ": "مُخَنْفِر (شخص يتنفس بصوت مسموع من خلال أنف محتقن) / ساذج, غر (شاب أخرق وقليل الخبرة)",
 "はなたれこぞう": "سَائِل الأَنْف, مُتَمَخِّط (متّسخ بإفرازات الأنف) / مَغْرُور, مُتَعَالٍ ((غير رسمي) مفرط في الغرور والتعالي)",
 "はなだいこん": "منثور دمشقي, هيسبيرس (عشب مزروع منذ فترة طويلة له زهور تكون رائحتها أكثر وضوحاً في المساء؛ تم توطينه في جميع أنحاء أوروبا إلى سيبيريا وإلى أمريكا الشمالية)",
 "はなだか": "مَغْرُور, فَخُور",
 "はなぢ": "رُعَاف",
 "はなっつら": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة",
 "はなっぱし": "عدوانية, ولع بالقتال (ميل طبيعي للعداء) / إقدام, هجومية (صفة كون المرء جريئاً ومبادراً) / عدوانية (شعور بالعداء يثير أفكار الهجوم)",
 "はなっぱしがつよい": "بَرَاغْمَاتِيّ, عَمَلِيّ (يسترشد بالخبرة العملية والملاحظة لا بالنظرية)",
 "はなっぱしら": "عدوانية, ولع بالقتال (ميل طبيعي للعداء) / إقدام, هجومية (صفة كون المرء جريئاً ومبادراً) / عدوانية (شعور بالعداء يثير أفكار الهجوم)",
 "はなっぱしらがつよい": "بَرَاغْمَاتِيّ, عَمَلِيّ (يسترشد بالخبرة العملية والملاحظة لا بالنظرية)",
 "はなっぱしらのつよい": "بَرَاغْمَاتِيّ, عَمَلِيّ (يسترشد بالخبرة العملية والملاحظة لا بالنظرية)",
 "はなっぱり": "عدوانية, ولع بالقتال (ميل طبيعي للعداء) / إقدام, هجومية (صفة كون المرء جريئاً ومبادراً) / عدوانية (شعور بالعداء يثير أفكار الهجوم)",
 "はなつ": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار. / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: هو,البارحة حرر من الحبس. / نَفَثَ, أَصْدَرَ\nمثال: そのごみ箱は悪臭を放っていた。 — أطلق صندوق القمامة رائحةً كريهة.",
 "はなつき": "مُزهر (عندما يكون النبات في حالة امتلاك زهرة واحدة أو متعددة و/أو براعم) / إزهار, تفتح الزهور (وقت وعملية تبرعم وتفتح الزهور) / ازدهار, تفتح (عملية تنموية)\nمثال: نبات مزهر",
 "はなつきあい": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "はなつくり": "زراعة الزهور (زراعة النباتات المزهرة)",
 "はなつまみ": "إِزْعَاج",
 "はなづくり": "زراعة الزهور (زراعة النباتات المزهرة)",
 "はなづな": "دبوس التوازن (أي من الأجنحة الخلفية الضامرة للحشرات ثنائية الأجنحة؛ تستخدم للحفاظ على التوازن أثناء الطيران) / بلوزة برباط عنق, هالتر توب (توب نسائي يربط خلف الظهر والرقبة ويترك الظهر والذراعين مكشوفين) / رسن, مقود (غطاء رأس من الحبل أو القماش للحصان، مع حبل للقيادة) / حبل المشنقة (حبل يستخدمه الجلاد لإعدام الأشخاص المحكوم عليهم بالموت شنقاً) / إكليل (تنسيق زهور يتكون من شريط دائري من أوراق الشجر أو الزهور لأغراض الزينة) / مقتطفات أدبية (أنثولوجيا من القطع الأدبية القصيرة والقصائد والبالاد وما إلى ذلك)",
 "はなづら": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة",
 "はなであしらう": "ازدراء, تجاهل (رفض التعرف على شخص تعرفه) / أَفْطَس, قَصِير بِشَكْل غَيْر عَادِيّ (قَصير بِشَكْل غَيْر اعتِيادِيّ) / رفض, زجر (حالة من الإبعاد أو الصد)\nمثال: كان التجاهل متعمداً بوضوح",
 "はなとらのお": "رأس التنين الكاذب, فيزوستيغيا (نبات أمريكي شمالي له سنبلة من الزهور الوردية أو البيضاء ثنائية الشفة)",
 "はなにかかった": "أَنْفِي",
 "はなにつく": "نَتُنَ, نَتِنَ",
 "はなのあな": "مَنْخَر",
 "はなのき": "شجرة كاسية البذور, شجرة مزهرة (أي شجرة تحتوي على بذور وبويضات داخل المبيض)",
 "はなのさ": "نهاية متقاربة جداً, نهاية مصورة (بشكل عام، أي نهاية متقاربة جداً؛ وتحديداً، نهاية سباق يكون فيه المتسابقون قريبين جداً من بعضهم البعض بحيث يجب تحديد الفائز من صورة التقطت لحظة النهاية)",
 "はなのした": "نَثْرَة / فَم, بق",
 "はなのしたひも": "برعم زهري (برعم تتطور منه زهرة أو زهور فقط)",
 "はなのたかい": "فَخُور",
 "はなはだ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "はなはだしい": "الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ.",
 "はなはだもって": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "はなはだ以て": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "はなはっか": "مَرْدَقُوش, مَرْدَقُوش بَرِّيّ",
 "はなばしら": "حاجز, وتيرة ((في التشريح) فاصل يقسم بين نسيجين أو تجويفين) / حاجز (فاصل أو جدار خاصة في المبيض)",
 "はなばたけ": "حَدِيقَة أَزْهَار (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة.",
 "はなばち": "نَحْلَة / نَحْل / نحل / نحلة / بِي",
 "はなばな": "زَهْرَة, زُهُور / أَزْهَرَ, إِزْدَهَرَ (أزْهَرَ النَّبَات أو الشجرُ: طلَع زهرهُ؛ أزْهَرَ النارَ وغيرَها: أضاءَها)\nمثال: إنني أدرك بحكم دارستي للتاريخ أن الحضارة مدينة للإسلام الذي حمل معه في أماكن مثل جامعة الأزهر نور العلم عبر قرون عدة الأمر الذي مهد الطريق أمام النهضة الأوروبية وعصر التنوير / جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل.",
 "はなばなしい": "باهِر",
 "はなひげ": "شَارِب",
 "はなひらく": "زَهْرَة / زَهَرَ ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: أرى زهرة على المكتب. / زَهْرَة, زُهُور / أَزْهَرَ, إِزْدَهَرَ (أزْهَرَ النَّبَات أو الشجرُ: طلَع زهرهُ؛ أزْهَرَ النارَ وغيرَها: أضاءَها)\nمثال: إنني أدرك بحكم دارستي للتاريخ أن الحضارة مدينة للإسلام الذي حمل معه في أماكن مثل جامعة الأزهر نور العلم عبر قرون عدة الأمر الذي مهد الطريق أمام النهضة الأوروبية وعصر التنوير",
 "はなひる": "عَطَسَ / عُطَاس, عَطْسَة",
 "はなび": "مُفَرْقِعَات, أَلْعَاب نَارِيَّة\nمثال: すごい花火だ！ — هذه الألعاب النارية رائعة!",
 "はなびしそう": "إيشولتسية, خشخاش كاليفورنيا (من ساحل المحيط الهادئ لأمريكا الشمالية؛ يزرع على نطاق واسع لزهوره الصفراء إلى الحمراء)",
 "はなびせんこう": "سلك شرار, شمعة شرارة (لعبة نارية تحترق ببطء وتطلق وابلًا من الشرر) / ألماس (قطع الألماس (مصطلح عامي))\nمثال: انظر إلى الألماس الذي ترتديه تلك السيدة!",
 "はなびら": "بَتَلَة, تُوَيْجَة",
 "はなふき": "مِنْدِيل, مَحْرَمَة",
 "はなふだや": "نينتندو",
 "はなぶさ": "كأس الزهرة ((نبات) دوارة السبلات للزهرة التي تشكل الغلاف الخارجي)",
 "はなまがり": "سيء المزاج, عبوس (شخص سيء الطباع)",
 "はなまち": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "はなまめ": "فاصولياء قرمزية (قرون فاصولياء طويلة تقطع عادةً؛ مفضلة في بريطانيا) / فاصولياء العداء القرمزي, فاصولياء قرمزية (فاصولياء استوائية أمريكية ذات زهور حمراء وفاصولياء سوداء مرقطة تشبه الفاصولياء الشائعة ولكنها معمرة؛ وهي فاصولياء مفضلة للأكل في بريطانيا العظمى)",
 "はなみ": "أسنان, نظام الأسنان (نوع وعدد وترتيب الأسنان (مجتمعة) في شخص أو حيوان) / بزوغ الأسنان, تسنين (بزوغ أسنان الطفل عبر اللثة) / رَخْت",
 "はなみず": "مُخَاط, مُخَاط أَنْف",
 "はなむけ": "شم (فعل إدراك رائحة شيء ما)",
 "はなむこ": "عَرِيس (اِسْمٌ لِمَاْوَى الأَسَد)",
 "はなむすび": "شارة وردية, وردة شريطية (حلية أو نمط يشبه الوردة يُلبس كشارة منصب أو اعترافاً بالفوز بشرف ما) / نافذة وردية (نافذة دائرية مليئة بالزخارف) / وريدة (مجموعة من الأوراق تنمو في دوائر مزدحمة من مركز مشترك أو تاج (عادة عند الأرض أو بالقرب منها)) / البطاطس الصغيرة, تقرح الساق (مرض الريزوكتونيا الذي يصيب البطاطس)",
 "はなめ": "برعم زهري (برعم تتطور منه زهرة أو زهور فقط)",
 "はなめがね": "نظارة مشبك الأنف (نظارات تُثبت على الأنف بواسطة زنبرك)",
 "はなもじ": "حَرْف كَبِير (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "はなもちならない": "زَنِخ, مُنْتِن (ذُو رَائِحَةٍ كَرِيهَةٍ بِشَكْلٍ مُؤْذٍ) / غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "はなもちならぬ": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "はなもとしあん": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "はなもとじあん": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "はなもの": "كاسيات البذور, نباتات مزهرة (نباتات توجد بذورها داخل مبيض مغلق)",
 "はなや": "متجر بيع الورد, محل زهور (متجر تباع فيه الزهور والنباتات للزينة) / بائع زهور, منسق زهور (شخص يزرع الزهور ويتاجر بها)\nمثال: صنع بائع الزهور باقة جذابة",
 "はなやか": "خَلَّاب, سَاحِر (جميل بشكل مُبْهِر) / سَعِيد, مُبَارَك (ينبئ أو من المرجح أن يجلب الحظ الجيد أو نتيجة حسنة) / ذَهَبِيّ, زَاهِر (يتسم بالسلام والازدهار) / مَيْسُورُ الحَال, مُرْتَاحٌ مَادِّيًّا (في ظروف مالية ميسورة؛ غنيّ بشكل معتدل) / رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو)",
 "はなやさい": "قَرْنَبِيط, قُنَّبِيط",
 "はなやすり": "سرخس لسان الأفعى (سراخس بسنابل خصبة تشبه لسان الأفعى)",
 "はなよめ": "عَرُوس",
 "はなよめいしょう": "فستان زفاف (ثوب ترتديه العروس في حفل الزفاف)",
 "はなよめかいぞえにん": "وصيفة العروس (امرأة غير متزوجة ترافق العروس في حفل الزفاف)",
 "はなよめがっこう": "مدرسة إتيكيت (مدرسة خاصة للفتيات تركز على التدريب في الأنشطة الثقافية والاجتماعية)",
 "はなよめごりょう": "عَرُوس",
 "はならび": "أسنان, نظام الأسنان (نوع وعدد وترتيب الأسنان (مجتمعة) في شخص أو حيوان) / بزوغ الأسنان, تسنين (بزوغ أسنان الطفل عبر اللثة)",
 "はなる": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "はなれさる": "تَخَلَّى عَن, تَوَقَّفَ",
 "はなればなれ": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل.",
 "はなれる": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "はなれわざ": "حيلة مثيرة, مجازفة (عمل صعب أو غير عادي أو خطير؛ يتم عادة لجذب الانتباه) / حيوان متقزم (مخلوق (خاصة الحوت) تم منعه من بلوغ النمو الكامل)",
 "はなれ技": "حيلة مثيرة, مجازفة (عمل صعب أو غير عادي أو خطير؛ يتم عادة لجذب الانتباه) / حيوان متقزم (مخلوق (خاصة الحوت) تم منعه من بلوغ النمو الكامل)",
 "はなれ業": "حيلة مثيرة, مجازفة (عمل صعب أو غير عادي أو خطير؛ يتم عادة لجذب الانتباه) / حيوان متقزم (مخلوق (خاصة الحوت) تم منعه من بلوغ النمو الكامل)",
 "はなろくしょう": "أخضر ليموني, أخضر مصفر (درجة من الأخضر مشوبة بالأصفر) / أخضر باريس (ملح مزدوج سام من زرنيخات النحاس وخلات النحاس)",
 "はなわ": "إِكْلِيل / بُرَة",
 "はなをかむ": "اِمْتَخَطَ, مَخَطَ",
 "はなをさかせる": "حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "はなをすする": "خنخنة, خنين (فعل التنفس بصوت مسموع عبر الأنف (كما هو الحال عند احتقان الأنف))",
 "はなをそえる": "غريس",
 "はなをならす": "استهجان, سخرية (صيحة أو ضجيج يصنع للتعبير عن الاستياء أو الازدراء) / ضحكة ساخرة (ضحكة غير محترمة)",
 "はなキャベツ": "قَرْنَبِيط, قُنَّبِيط",
 "はなクソ": "مُخَاط, مُخَاط أَنْف",
 "はなピ": "بُرَة",
 "はなピアス": "بُرَة",
 "はなピー": "بُرَة",
 "はな垂らし": "مُخَنْفِر (شخص يتنفس بصوت مسموع من خلال أنف محتقن) / ساذج, غر (شاب أخرق وقليل الخبرة)",
 "はな垂れ": "مُخَنْفِر (شخص يتنفس بصوت مسموع من خلال أنف محتقن) / ساذج, غر (شاب أخرق وقليل الخبرة)",
 "はな垂れ小僧": "سَائِل الأَنْف, مُتَمَخِّط (متّسخ بإفرازات الأنف) / مَغْرُور, مُتَعَالٍ ((غير رسمي) مفرط في الغرور والتعالي)",
 "はな水": "مُخَاط, مُخَاط أَنْف",
 "はにかみ": "خَجَل, حَيَاء (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق)\nمثال: توم لص بلا خجل.",
 "はにきぬきせない": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "はにきぬきせぬ": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "はにきぬをきせない": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "はにきぬをきせぬ": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "はにく": "لِثَة, لَثَة / صَمْغ / عِلْكَة",
 "はにゅうのやど": "عشة, كوخ (مأوى صغير بدائي يستخدم كمسكن)",
 "はぬけ": "خلو الفم من الأسنان, درد (حالة أو وضعية عدم وجود أسنان)\nمثال: بشكل غير متوقع، استحضر صورة طبيب الأسنان المسؤول عن خلو فمه من الأسنان / انسلاخ, طرح الريش (الانسلاخ الدوري للبشرة في المفصليات أو الجلد الخارجي في الزواحف)",
 "はね": "رِيش, رِيشَة (رَيَّشَ السَّهْمَ: راشهُ؛ رَيَّشَ الثَّوْبَ: زَيَّنَهُ بِصُوَرِ الرِّيش)\nمثال: هل عنده ريشة رسم؟ / جَنَاح / نَصْل (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة الحادّة الجارحة)\nمثال: لن نصل إلى أي مكان. / رِيشَة / قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة. / رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "はねあがり": "قفز, وثب (فعل القفز؛ دفع النفس عن الأرض) / قفز (فعل المشاركة في منافسة رياضية يجب عليك فيها القفز)\nمثال: تقدم بسلسلة من القفزات / تهور, طيش (سمة إيلاء القليل من التفكير للخطر) / رعونة, طيش (سمة التصرف برعونة وبدون تعقل)",
 "はねあがりもの": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "はねあがる": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة. / يتسرع",
 "はねあげ": "قَابِل لِلرَّفْع (مصمّم بحيث يمكن رفعه أو طيه جانباً)",
 "はねあげど": "باب أرضي, باب سحري (باب مفصلي أو منزلق في أرضية أو سقف)",
 "はねあげる": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / تنزه جبلي, سير طويل (مشي طويل عادة للرياضة أو المتعة) / زيادة الأجور, زيادة الراتب (المبلغ الذي يزاد به الراتب) / ارتفاع, زيادة (زيادة في التكلفة)\nمثال: تستمتع بنزهة جبلية في وقت فراغها",
 "はねいた": "منطلق",
 "はねおと": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / بارع, جهبذ (شخص يتمتع بمهارة مذهلة في أي مجال)",
 "はねかえす": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / هجوم مضاد ((شطرنج) هجوم يهدف إلى مواجهة ميزة الخصم في جزء آخر من الرقعة) / هجوم مضاد (هجوم من قبل قوة مدافعة ضد قوة عدو مهاجمة لاستعادة أرض مفقودة أو قطع وحدات العدو المتقدمة)",
 "はねかえり": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / شِفَاء, تَعَافِي / أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "はねかえる": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "はねかくし": "خنفساء رواغة (خنفساء نشطة عادة ما تكون لها عادات افتراسية أو رمية (تتغذى على الجيف))",
 "はねかける": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "はねかざり": "رِيش, كِسْوَةُ الرِّيش (الهيكل القرني الخفيف المقاوم للماء الذي يشكل الغطاء الخارجي للطيور) / ريشة زينة (ريشة أو مجموعة ريش تلبس كحلية) / ريشة, عمود دخاني (أي شيء يشبه الريشة في الشكل أو الخفة)\nمثال: عمود من الدخان",
 "はねかす": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "はねぐるま": "دافعة (شفرة الدوار (كما في ضاغط المحرك النفاث))",
 "はねっかえり": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة. / استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / شِفَاء, تَعَافِي / أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "はねっ返り": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة. / استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / شِفَاء, تَعَافِي / أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "はねつき": "باتلدور (لعبة مضرب قديمة)",
 "はねつける": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "はねとばす": "تطاير, طرطشة (ضجيج شيء يتناثر أو يطرطش بشكل انفجاري) / رشة, لطخة (كمية صغيرة من شيء رطب أو سائل)\nمثال: سمع طرطشة نيران",
 "はねのける": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "はねばし": "جسر قلاب, جسر متحرك (جسر يمكن رفعه لقطع الطريق أو للسماح للقوارب أو السفن بالمرور تحته)",
 "はねる": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة. / رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان / انفجار (عملية الانفجار أو التفرقع) / فورة, نوبة (فورة مفاجئة من النشاط (غالباً لسبب غير واضح)) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: انفجار الألعاب النارية أيقظ الأطفال / أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / قَلَبَ / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي. / قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "はねペン": "إِبْرَة, شَوْكَة",
