 "ねんだいもの": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير.",
 "ねんちゃく": "تماسك ((في الفيزياء) القوة بين الجزيئية التي تربط جزيئات مادة صلبة أو سائلة معاً)",
 "ねんちゃくざい": "لَاصِق, مُلْتَصِق (يميل إلى الالتصاق)",
 "ねんちゃくしつ": "حَثِيث, دَائِم (لَا يَتَوَقَّفُ أَبَدًا)\nمثال: الأوراق المستديمة تبقى ملتصقة بعد النضج / دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة)",
 "ねんちゃくせい": "اِلْتِصَاق",
 "ねんちゃくりょく": "لُزُوجَة (مصدر الفعل \"لَزِجَ\"؛ (في الفيزياء) تماسكُ أجزاء المادّة السَّائلة بعضِها ببعض…)",
 "ねんちゃくテープ": "شَرِيط لَاصِق",
 "ねんちゅう": "فِي السَّنَةِ الثَّانِيَة (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الثَّانِيَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ…) / لَزِج",
 "ねんちゅうぐみ": "طَبَقَة وُسْطَى",
 "ねんちゅうはつじょうき": "على مدار السنة (يعمل أو يستمر طوال العام)\nمثال: منتجع يعمل على مدار السنة",
 "ねんちょう": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر)\nمثال: ضابط كبير / فِي السَّنَةِ الثَّالِثَة (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الثَّالِثَةِ أَوْ مَا قَبْلَ الأَخِيرَةِ فِي…)",
 "ねんちょうぐみ": "السنة الأخيرة, الصف النهائي (الصف أو السنة النهائية في المدرسة الثانوية أو الكلية)",
 "ねんちょうしゃ": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر)\nمثال: ضابط كبير",
 "ねんぢゅう": "دَائِمًا, أَبَدًا",
 "ねんてん": "برم, دوران سريع (عملية الدوران بسرعة)\nمثال: أدار الكرنك بقوة",
 "ねんとう": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل.",
 "ねんとうあいさつ": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ねんとうきょうしょ": "خُطْبَة حَالَةِ الاِتِّحَاد",
 "ねんとうにいれる": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "ねんとうにおく": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "ねんとうのあいさつ": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ねんとうのちかい": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ねんど": "سَنَة مَالِيَّة (مقدارُ قطع الشمس البروجَ الاثني عشر ، وهي السنة الشمسيَّة، و السَّنَةُ تمامُ…)\nمثال: في عمره 24 سنة. / سنة دراسية, عام أكاديمي (الفترة الزمنية من كل عام التي تكون فيها المدرسة مفتوحة والناس يدرسون) / لُزُوجَة (مصدر الفعل \"لَزِجَ\"؛ (في الفيزياء) تماسكُ أجزاء المادّة السَّائلة بعضِها ببعض…) / طِين, صَلْصَال",
 "ねんどう": "تحريك عن بعد, تحريك نفسي (القدرة على تحريك شيء ما عن طريق التفكير فيه دون تطبيق قوة فيزيائية)",
 "ねんどけい": "مقياس اللزوجة (أداة قياس تستخدم لقياس اللزوجة)",
 "ねんどしつ": "صَلْصَالِيّ, طِينِيّ (يشبه أو يحتوي على الطين)\nمثال: صخور طينية",
 "ねんなし": "مُفَاجِئ / مُؤْسِف, يُؤْسَفُ لَهُ (يَسْتَحِقُّ الأَسَفَ أَوِ النَّدَمَ) / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "ねんね": "نوم (توقف الوعي وانخفاض معدل الأيض) / حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي",
 "ねんねえ": "نوم (توقف الوعي وانخفاض معدل الأيض) / حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي",
 "ねんねこ": "نوم (توقف الوعي وانخفاض معدل الأيض)",
 "ねんねん": "سنوياً, كل سنة (دون تفويت سنة)\nمثال: يسافرون إلى الصين سنوياً / نوم (توقف الوعي وانخفاض معدل الأيض) / حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي",
 "ねんねんさいさい": "سنوياً, كل سنة (دون تفويت سنة)\nمثال: يسافرون إلى الصين سنوياً",
 "ねんねタオル": "بطانية الأمان (بطانية (أو لعبة) يحملها الطفل معه لتقليل القلق)",
 "ねんのため": "تَحَسُبًا",
