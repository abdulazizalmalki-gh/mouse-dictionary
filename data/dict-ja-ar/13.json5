 "のたまう": "قَالَ, قال (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "のたもう": "قَالَ, قال (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "のたり": "على مهل, في وقت الفراغ (بطريقة غير متسرعة أو في الوقت المناسب)\nمثال: اقرأ الدليل في وقت فراغك",
 "のたりのたり": "بِبُطْء",
 "のち": "فِيمَا بَعْد, بعدين / مُسْتَقْبَل / سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "のちざん": "مَشِيمَة, خَلَاص (محلُّ الولد تخرج معهُ عند الولادة. ومنهُ قولهم ليس بمفطومٍ عن شيمة مفطورٌ عليها…)",
 "のちじて": "بَطَل, بَطَلَة",
 "のちに": "بعد ذلك, فيما بعد (يحدث في وقت لاحق لوقت مرجعي)\nمثال: اعتذر لاحقاً",
 "のちになって": "أَخِير, بَعْدَ ذٰلِك",
 "のちのち": "مُسْتَقْبَل",
 "のちのよ": "الأجيال القادمة, الخَلَف (جميع الأجيال المستقبلية)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا",
 "のちほど": "بعد ذلك, فيما بعد (يحدث في وقت لاحق لوقت مرجعي)\nمثال: اعتذر لاحقاً",
 "のぢさ": "خَسّ النَّعْجَة, خَسّ الضَأْن (خَسَّ الرجُلُ يَخِسُّ خِسَّةً، وخَسَاسَةً: حَقُرَ؛ يقال: خَسَّ فِعْلُهُ وقولُه…)\nمثال: بيع المنزل بثمن بخس.",
 "のぢしゃ": "خَسّ النَّعْجَة, خَسّ الضَأْن (خَسَّ الرجُلُ يَخِسُّ خِسَّةً، وخَسَاسَةً: حَقُرَ؛ يقال: خَسَّ فِعْلُهُ وقولُه…)\nمثال: بيع المنزل بثمن بخس.",
 "のっかかる": "نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "のっかる": "رَكِبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا…)\nمثال: ركب ياني سفينة.",
 "のっきる": "هَزَمَ, غَلَبَ",
 "のっける": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ…)\nمثال: أحب قطف الورود.",
 "のっしのっし": "تجارة الأخشاب, قطع الأخشاب (تجارة قطع أو تجهيز أو بيع الأخشاب)",
 "のっしのっしとあるく": "خَشَب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع…)\nمثال: نحن نقطع الخشب.",
 "のっしのっしと歩く": "خَشَب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع…)\nمثال: نحن نقطع الخشب.",
 "のっそり": "ببطء, بكسل (بطريقة بطيئة)\nمثال: تصاعد الدخان ببطء / ببلادة, بفتور (بطريقة بليدة)\nمثال: قال 'لا' ببلادة",
 "のっと": "فَجْأَةً",
 "のっとり": "استحواذ (تغيير في مصلحة السيطرة على شركة عن طريق البيع أو الاندماج) / اِخْتِطَاف",
 "のっとりじけん": "اِخْتِطَاف",
 "のっとりはんにん": "قاطع طريق (شخص يوقف مركبة ويسرق منها)",
 "のっとる": "أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة. / خَطَفَ (كلمة \"خَطِفَ\" تعني سرق أو أخذ بسرعة و فجأة. يُمكن استخدامها بمعنى \"خَطَفَ…) / تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه)\nمثال: تبع المشتبه محققان.",
 "のっぴき": "هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "のっぴきならない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "のっぴきならぬ": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "のっぺらぼう": "سَاكِن, مُسْتَقِرّ (لا يُظهر تغيّرًا يُذكر إن وُجد)",
 "のっぺらぼー": "سَاكِن, مُسْتَقِرّ (لا يُظهر تغيّرًا يُذكر إن وُجد)",
 "のっぺらぽう": "سَاكِن, مُسْتَقِرّ (لا يُظهر تغيّرًا يُذكر إن وُجد)",
 "のっぺら坊": "سَاكِن, مُسْتَقِرّ (لا يُظهر تغيّرًا يُذكر إن وُجد)",
 "のっぺり": "بِلَا مَعَالِم (يفتقر إلى سمات أو خصائص مميّزة) / مُسَطَّح",
 "のっぽ": "عَمُود مِصْبَاح, عَمُود إِنَارَة / طَوِيل وَنَحِيف, فَارِع وَنَحِيل (طَوِيل القَامَة وَنَحِيف الجِسْم)",
 "のづら": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "のてん": "خلاء, عراء (حيث يكون الهواء غير محصور)\nمثال: أراد الخروج للهواء الطلق قليلاً",
 "ので": "لِأَنَّ / إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "のとなれやまとなれ": "لَا يَهُمُّنِي (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "のど": "حَلْق, حُلْقُوم (أصاب حَلْقه أو ضربه في حلقه؛ أزال شعر رأسه أو ذقنه كله بالمُوسَى)\nمثال: حلق زيري لحيته. / صوت غنائي (الجودة الموسيقية للصوت أثناء الغناء) / مِزْراب (قناة صرف لمياه الأمطار والثلوج؛ نظام يحدّ من جريان المياه على الأسطح الخارجية…) / رَاكِد, سَاجٍ ((عَنْ جِسْمٍ مَائِيّ) خَالٍ مِنَ الاضْطِرَاب بِسَبَب الأَمْوَاج الكَبِيرَة)",
 "のどあめ": "حلوى الحلق, قرص السعال (قرص طبي يستخدم لتهدئة الحلق)",
 "のどかぜ": "زُكَام",
 "のどくび": "رَقَبَة, عُنُق / نقطة ضعف (صفة غير كافية أو ناقصة)",
 "のどちんこ": "لَهَاة",
 "のどならし": "خَرْخَرَ, هَرْهَرَ",
 "のどのいたみ": "اِلْتِهَاب حَلْق",
 "のどの痛み": "اِلْتِهَاب حَلْق",
 "のどぶえ": "رُغَامَى, قَصَبَة هَوَائِيَّة",
 "のどぶくろ": "غَبَب, لُغْد",
 "のどぼとけ": "تُفَّاحَة آدَم, حَرْقَدَة",
 "のどもと": "حَلْق, حُلْقُوم (أصاب حَلْقه أو ضربه في حلقه؛ أزال شعر رأسه أو ذقنه كله بالمُوسَى)\nمثال: حلق زيري لحيته.",
 "のどやか": "رَاكِد, سَاجٍ ((عَنْ جِسْمٍ مَائِيّ) خَالٍ مِنَ الاضْطِرَاب بِسَبَب الأَمْوَاج الكَبِيرَة)",
 "のどをならす": "خَرْخَرَ, هَرْهَرَ",
 "のどを鳴らす": "خَرْخَرَ, هَرْهَرَ",
 "のど仏": "تُفَّاحَة آدَم, حَرْقَدَة",
 "のど笛": "رُغَامَى, قَصَبَة هَوَائِيَّة",
 "のど袋": "غَبَب, لُغْد",
 "のど風邪": "زُكَام",
 "のど飴": "حلوى الحلق, قرص السعال (قرص طبي يستخدم لتهدئة الحلق)",
 "のど鳴らし": "خَرْخَرَ, هَرْهَرَ",
 "のに": "رَغْم أَنَّ, مَعَ أَنَّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال…)\nمثال: إنه سعيد رغم فقره. / عِنْدَمَا / لَيْتَ, تَمَنَّى (يفيد التمني)\nمثال: ليت بحاجة لتعمل ساعات إضافية. / لِكَي, لِ",
 "のねずみ": "فأر الحقل (أي فأر ليلي من العالم القديم من جنس أبوديموس يعيش في الغابات والحقول والحدائق)",
 "のの": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "ののさま": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "ののしり": "تَعَسُّف, طُغْيَان\nمثال: أهان سامي ليلى بقص شعرها.",
 "ののしりことば": "سبة, شتيمة (تعبير دنس أو فاحش عادة للتعبير عن المفاجأة أو الغضب)\nمثال: تم حذف الشتائم",
 "ののしり言葉": "سبة, شتيمة (تعبير دنس أو فاحش عادة للتعبير عن المفاجأة أو الغضب)\nمثال: تم حذف الشتائم",
 "ののしる": "تَعَسُّف, طُغْيَان\nمثال: أهان سامي ليلى بقص شعرها.",
 "ののじ": "عُرْوَة, عُقْدَة",
 "ののはな": "زهرة برية (نبات زهري بري أو غير مزروع)",
 "のの字": "عُرْوَة, عُقْدَة",
 "のはら": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "のばしぼう": "مِرْقَاق, فَرَّادَة",
 "のばし棒": "مِرْقَاق, فَرَّادَة",
 "のばす": "طَوَّلَ, أَطَالَ (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير. / اِسْتَقَامَ (أَقَامَ نفسه) / خَفَّفَ (قلل شيئًا أو نقص من حدته؛ هون أو لطف من شدة أمر)\nمثال: خفف زيري السرعة. / أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "のばな": "زهرة برية (نبات زهري بري أو غير مزروع) / جهنمية ملساء, زهرة الورق (كرمة برازيلية تميل للإزهار بشكل مستمر)",
 "のばなし": "مَرْعًى, مَسْرَح",
 "のばら": "غليون الخلنج (غليون مصنوع من جذر شجيرة الخلنج) / ورد متعدد الأزهار, ورد ياباني (ورد قوي النمو له عناقيد من الزهور الصغيرة العديدة؛ يستخدم للأسيجة وكأصل للتطعيم)",
 "のび": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها. / تَمَدُّد, مط (عملية التوسع عن طريق الإطالة أو التوسيع) / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل. / إطالة (عملية تطويل شيء ما)",
 "のびあがる": "تَمَدَّدَ",
 "のびしろ": "كَامِن, مُحْتَمَل (موجود في حيز الإمكانية)\nمثال: مشكلة محتملة",
 "のびちぢみ": "مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته",
 "のびのび": "بارتياح, برغد (في راحة مالية)\nمثال: يعيشون برغد / بِسُرْعَة, عَاجِلًا",
 "のびひろがる": "مَدَّدَ",
 "のびやか": "مُرِيح, وَثِير",
 "のびりつ": "مُعَدَّل النُّمُوّ (معدل الزيادة في الحجم لكل وحدة زمنية)",
 "のびる": "تَمَدَّدَ / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل. / مَدَّدَ / طَوَّرَ",
 "のびをする": "تَمَدَّدَ",
 "のふうぞ": "مُشَاغِب",
 "のふうぞう": "مُشَاغِب",
 "のぶし": "جندي مرتزق, مرتزق (شخص يُستأجر للقتال لصالح دولة غير دولته) / رَاهِب (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس…)",
 "のぶせり": "قاطع طريق, لص مسلح (لص مسلح يكون (عادة) عضواً في عصابة)",
 "のぶとい": "جَرِيء, مُجَازِف (مُستعد لخوض المخاطر والمجازفة) / حَلْقِيّ (يبدو كأنَّه يُنطَق من أعماق الحلق)",
 "のべ": "مُسْتَقْبَل / اِئْتِمَان / تَمَدُّد, مط (عملية التوسع عن طريق الإطالة أو التوسيع) / مَجْمُوع / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "のべあう": "قَارَنَ",
 "のべおくり": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\"",
 "のべがね": "صاج, صفيحة معدنية (ورقة من المعدن مشكلة في لوحة رقيقة)",
 "のべざお": "قَصْبَة صَيْد / قطعة واحدة ((للملابس) يتكون من أو مصمم كقطعة واحدة كاملة)\nمثال: رداء من قطعة واحدة",
 "のべつ": "بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل)\nمثال: الرقص يلهمه بلا توقف للسعي أعلى وأعلى نحو قمة الكمال المشرقة",
 "のべつまくなし": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير)\nمثال: العالم يتغير باستمرار",
 "のべつ幕なし": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير)\nمثال: العالم يتغير باستمرار",
 "のべつ幕無し": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير)\nمثال: العالم يتغير باستمرار",
 "のべのおくり": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\"",
 "のべばらい": "ائتمان, دفع مؤجل (ترتيب للدفع المؤجل للسلع والخدمات)",
 "のべひろげる": "مَدَّدَ",
 "のべぼう": "حَانَة, بَار / مِرْقَاق, فَرَّادَة",
 "のべる": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري. / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "のべ竿": "قَصْبَة صَيْد / قطعة واحدة ((للملابس) يتكون من أو مصمم كقطعة واحدة كاملة)\nمثال: رداء من قطعة واحدة",
 "のほうず": "مُتَوَحِّش / حَلَقِيّ, لَا نِهَائِيّ (مُتَّصِلُ الأَطْرَافِ بِحَيْثُ يُشَكِّلُ كُلًّا مُتَّصِلًا)",
 "のほほん": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية)\nمثال: ألقى نظرة غير مبالية على العناوين",
 "のぼす": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "のぼせ": "هبة ساخنة (إحساس مفاجئ وقصير بالحرارة (يرتبط بانقطاع الطمث وبعض الاضطرابات العقلية))",
 "のぼせる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "のぼり": "صُعُود, تَسَلُّق / مُتَّجِهٌ لِلْأَعْلَى (يَسِيرُ فِي اتِّجَاهٍ يُعْتَبَرُ تَقْلِيدِيًّا صُعُودًا) / ضد التيار, نحو المنبع (نحو المصدر أو عكس التيار)",
 "のぼりきる": "مِقْيَاس\nمثال: هم يريدون السلم.",
