 "ねんべつ": "سَنَوِيّ",
 "ねんぽう": "كتاب سنوي (كتاب مرجعي ينشر بانتظام مرة كل عام)",
 "ねんまく": "غشاء مخاطي, مخاطية (غشاء يفرز المخاط يبطن جميع تجاويف الجسم أو الممرات التي تتصل بالخارج)",
 "ねんまくかそう": "تحت المخاطية (النسيج الضام الموجود تحت الغشاء المخاطي)",
 "ねんまつ": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "ねんまつしょうせん": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "ねんまつしょうよ": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "ねんまつちょうせい": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "ねんまつねんし": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "ねんゆ": "زيت الوقود, مازوت (منتج بترولي يُستخدم كوقود)",
 "ねんよ": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو…)\nمثال: مزيد من الأرض",
 "ねんりき": "ضبط النفس (سمة التحكم الحازم في سلوك المرء) / تحريك عن بعد, تحريك نفسي (القدرة على تحريك شيء ما عن طريق التفكير فيه دون تطبيق قوة فيزيائية)",
 "ねんりょう": "وَقُود",
 "ねんりょうきかばくだん": "متفجرات الوقود الهوائي (جهاز يتكون من حاوية وقود وشحنتين متفجرتين؛ الشحنة الأولى تفتح حاوية الوقود عند…)",
 "ねんりょうけい": "عَدَّاد الوَقُود",
 "ねんりょうでんち": "خلية وقود (خلية تنتج الكهرباء عن طريق أكسدة الوقود (الهيدروجين والأكسجين أو الزنك والهواء)…)",
 "ねんりょうでんちしゃ": "خلية وقود (خلية تنتج الكهرباء عن طريق أكسدة الوقود (الهيدروجين والأكسجين أو الزنك والهواء)…)",
 "ねんりょうでんちじつようかすいしんきょうぎかい": "خلية وقود (خلية تنتج الكهرباء عن طريق أكسدة الوقود (الهيدروجين والأكسجين أو الزنك والهواء)…)",
 "ねんりょうでんちじどうしゃ": "خلية وقود (خلية تنتج الكهرباء عن طريق أكسدة الوقود (الهيدروجين والأكسجين أو الزنك والهواء)…)",
 "ねんりょうふんしゃ": "حقن الوقود (نظام ميكانيكي لحقن الوقود المذرى مباشرة في أسطوانات محرك الاحتراق الداخلي؛ يغني…)",
 "ねんりょうゆ": "زيت الوقود, مازوت (منتج بترولي يُستخدم كوقود)",
 "ねんりん": "حلقة النمو, حلقة سنوية (تشكل سنوي للخشب في النباتات أثناء نموها)",
 "ねんりんねんだいがく": "علم تحديد أعمار الأشجار (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "ねんりんねんだいほう": "علم تحديد أعمار الأشجار (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "ねんれい": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة) / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في…)\nمثال: جون في عمر أخي.",
 "ねんれいさべつ": "تمييز عمري (التمييز على أساس عمر الشخص)",
 "ねんれいせいげん": "حَدّ السِّنّ, شَرْط السِّنّ (لائحة تحدد الحد الأقصى (أو الأدنى) للسن للقيام بشيء ما أو شغل منصب ما)",
 "ねんれいそう": "شريحة عمرية, فئة عمرية (مجموعة من الناس لديهم نفس العمر تقريباً)",
 "ねんをいれる": "أَعَارَ اِنْتِبَاه",
 "ねんをおす": "ذَكَّرَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "ねセロリ": "جذر الكرفس (جذر عطري صالح للأكل وسميك لنوع من نبات الكرفس)",
 "ねー": "يَاه, اسمع / يَعْنِي / أَرْضَى, أَعْجَبَ\nمثال: يا لها من جملة! / مَعْدُوم / لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)",
 "ねーねー": "يَاه, اسمع",
 "の": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل. / مُتَوَحِّش / قصبة الريشة (العمود الفقري المجوف للريشة) / وَحْدَة قِيَاس (أيّ قسمة للكمّيّة مقبولة معيارًا للقياس أو التبادل)\nمثال: この川の幅が１マイルある。 — عرض هذا النهر ميل.",
 "のあそび": "رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "のあまり": "اِسْتَبَدَّ (حزم ولم يتردد في اتخاذ القرار وتنفيذه؛ (في السياسة) حكم بنظام استبدادي)",
 "のいちご": "فراولة الغابات, فراولة برية (موطنها أوروبا)",
 "のいばら": "ورد متعدد الأزهار, ورد ياباني (ورد قوي النمو له عناقيد من الزهور الصغيرة العديدة؛ يستخدم للأسيجة وكأصل للتطعيم)",
 "のう": "مَوْهِبَة / دِمَاغ / قَيْح, صَدِيد / زراعة, عمل في الأرض (الزراعة باعتبارها مهنة أو أسلوب حياة)\nمثال: الزراعة حياة شاقة / غَامِق, دَاكِن / مركز, مكثف (متجمع معاً أو أقل تشتتاً)\nمثال: جهودهم المركزة",
 "のういっけつ": "نزيف دماغي (نزيف من وعاء دموي ممزق في الدماغ)",
 "のうえん": "التهاب الدماغ (التهاب الدماغ عادة ما يسببه فيروس؛ تشمل الأعراض الصداع وألم الرقبة والنعاس…) / مَزْرَعَة / سِحْرِيّ, شَعْوَذِيّ (يمتلك أو يستخدم قوى خارقة للطبيعة أو يتسم بها)",
 "のうえんしゅ": "صاحب المزرعة (مالك أو مدير لمزرعة كبيرة (خاصة المزارع الاستعمارية أو الاستثمارية))",
 "のうおん": "توتر, شد عصبي ((علم النفس) حالة من الإجهاد العقلي أو العاطفي أو الترقب)\nمثال: عانى من التعب والتوتر العاطفي",
 "のうか": "فَلَّاح, فَلَّاحَة / بيت المزرعة (منزل لمزارع وعائلته) / غَلَّظَ\nمثال: أمضى زيري العقد.",
 "のうかい": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام / تلفيف (طية محدبة أو ارتفاع في سطح الدماغ)",
 "のうかがく": "علوم الدماغ (فرع علم الأعصاب المعني بالدماغ)",
 "のうかがくしゃ": "عالم أعصاب (عالم أحياء عصبية يتخصص في دراسة الدماغ)",
 "のうかしん": "قوباء (عدوى جلدية معدية للغاية)",
 "のうかすいたい": "الغُدَّة النُخَامِيَّة",
 "のうかすいたいぜんよう": "غدة نخامية أمامية, نخامية أمامية (الفص الأمامي للغدة النخامية؛ ذو طبيعة غدية في المقام الأول)",
 "のうかん": "جِذْع الدِمَاغ (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر)",
 "のうかんし": "حفار قبور, متعهد دفن الموتى (شخص عمله إدارة الجنازات)",
 "のうがいこつ": "قحف (جزء الجمجمة الذي يغلف الدماغ)",
 "のうがき": "تباهي, تفاخر (الحديث عن النفس بصيغ التفخيم)",
 "のうがきをたれる": "تَبَاهَى",
 "のうがきをならべる": "تَبَاهَى",
 "のうがく": "زِرَاعَة, فِلَاحَة",
 "のうがくしゃ": "خبير زراعي, مهندس زراعي (خبير في إدارة التربة وإنتاج المحاصيل الحقلية)",
 "のうがくぶ": "وزارة الزراعة, وزارة الزراعة الأمريكية (الإدارة الفيدرالية التي تدير البرامج التي تقدم الخدمات للمزارعين (بما في ذلك…)",
 "のうがない": "عَاجِز, غَيْر مُؤَهَّل (لا يستوفي المتطلّبات اللازمة)\nمثال: جهاز مخابرات غير كفء",
 "のうき": "مَوْعِد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد. / شكل الكلمة, صيغة (المظهر الصوتي أو الكتابي للكلمة الذي يمكن استخدامه لوصف أو تحديد شيء ما)",
 "のうきかいとう": "أدينوسين ثلاثي الفوسفات (نيوكليوتيد مشتق من الأدينوسين يوجد في الأنسجة العضلية؛ المصدر الرئيسي للطاقة…)",
 "のうきげん": "مَوْعِد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "のうきゅう": "قبو (حزمة مقوسة من الألياف البيضاء في قاعدة الدماغ من خلالها يسقط الحصين في كل نصف…)",
 "のうきょう": "جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "のうきん": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن. / حَمِيّ الطَّبْع, مُتَّقِدُ المَشَاعِر (ميّال إلى الانفعال والعاطفة الشديدة)",
 "のうきんしょう": "التهاب الدماغ (التهاب الدماغ عادة ما يسببه فيروس؛ تشمل الأعراض الصداع وألم الرقبة والنعاس…)",
 "のうぎょう": "زِرَاعَة, فِلَاحَة",
 "のうぎょうか": "فَلَّاح, فَلَّاحَة",
 "のうぎょうかがく": "كِيمِيَاء زِرَاعِيّة (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما…)\nمثال: هو يحب الكيمياء.",
 "のうぎょうけいざいがく": "زراعي, فلاحي (من أو متعلق بعلم المحاصيل وإدارة التربة)",
 "のうぎょうじゅうじしゃ": "فَلَّاح, فَلَّاحَة",
 "のうぎょうせんもんがっこう": "مدرسة صناعية, مدرسة مهنية (مدرسة ثانوية تُعلّم الحرف الماهرة)",
 "のうけっかん": "دماغي وعائي (من أو متعلق بالدماغ والأوعية الدموية التي تغذيه)\nمثال: حادث وعائي دماغي",
 "のうけっせん": "تخثر دماغي (جلطة دموية في شريان أو وريد دماغي)",
 "のうけつしょう": "تقيح الدم (إنتان ناتج عن إطلاق البكتيريا المكونة للقيح من خراج)",
 "のうげいかがく": "كيمياء زراعية (دراسة كل من الكيمياء والكيمياء الحيوية المهمة في الإنتاج الزراعي، ومعالجة…)",
