 "にょうどうきゅうせんえき": "مَذْي",
 "にょうどくしょう": "تبولن الدم, يوريميا (تراكم الفضلات النيتروجينية (اليوريا) في الدم والتي تفرز عادة في البول)",
 "にょうのけんさ": "تحليل بول ((طب) التحليل الكيميائي للبول (للتشخيص الطبي))",
 "にょうへい": "احتباس البول (احتجاز البول في المثانة البولية)\nمثال: لديه مشكلة في احتباس البول",
 "にょうほうしょう": "بيلة تفهة, سكري كاذب (شكل نادر من السكري ناتج عن نقص في الفازوبريسين (هرمون الغدة النخامية الذي ينظم الكلى)؛ يتميز بإفراز مزمن لكميات كبيرة من البول المخفف الشاحب مما يؤدي…)",
 "にょうぼ": "زَوْجَة, اِمْرَأَة",
 "にょうぼう": "زَوْجَة, اِمْرَأَة / اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "にょうぼうこうこう": "خَاضِعٌ لِزَوْجَتِه, زَوْجِيّ (مولع بزوجته بحماقة أو خاضع لها)",
 "にょうぼうもち": "زوج (رجل متزوج؛ شريك المرأة في الزواج)",
 "にょうぼうやく": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري. / ملتقط (مركز في فريق البيسبول للاعب الذي يتمركز خلف القاعدة الرئيسية ويلتقط الكرات التي يرميها الرامي) / ماسك, ملتقط ((في البيسبول) الشخص الذي يلعب في مركز الماسك خلف الضارب)",
 "にょうまく": "سِقَاء",
 "にょうもれ": "بوال, سلس البول (عدم القدرة على التحكم في تدفق البول والتبول اللاإرادي)",
 "にょうろ": "السبيل البولي, مسلك بولي (الأعضاء والأنابيب المشاركة في إنتاج وإخراج البول)",
 "にょうろかんせんしょう": "عَدْوَى الجِهَاز البَوْلِيّ",
 "にょうろけっせき": "حَصَاةُ الكُلْيَة (حصاة تتكون في الكلية)",
 "にょかん": "وصيفة الشرف (سيدة تُعين لخدمة ملكة أو أميرة)",
 "にょきにょき": "وَاحِدًا تِلْوَ الآخَرِ / بسرعة, سريعاً\nمثال: يعمل بسرعة",
 "にょけい": "أُمُومِيّ الخَطّ (قائِم عَلى تَتَبُّع النَّسَب عَبْرَ خَطّ الأُمّ)",
 "にょしょ": "كتابة مقطعية, نظام مقطعي (نظام كتابة تمثل رموزه مقاطع صوتية)",
 "にょしょう": "مالكة (امرأة مالكة) / اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "にょしょく": "عَلَاقَة غَرَامِيَّة",
 "にょじつ": "وَاقِع, حَقِيقَة (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة) / وَاقِع (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة)\nمثال: أنا واقع في حبك",
 "にょじつに": "واقعياً (بطريقة تشبه الشيء الأصلي بدقة) / بواقعية (بطريقة واقعية)\nمثال: التمثال مرسوم واقعياً",
 "にょぞく": "اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
