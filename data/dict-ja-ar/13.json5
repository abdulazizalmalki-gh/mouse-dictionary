 "ははご": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "ははじゃ": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "ははじゃひと": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "ははとじ": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "ははなる": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "ははのひ": "عِيد اَلْأُمّ",
 "ははのみこと": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "はば": "عَرْض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض. / حُرِّيَّة, حرية (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…) / حُرِّيَّة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين. / انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "はばかり": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / تثاقل, تردد (درجة معينة من عدم الرغبة) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: كان هناك تردد في كلامه / إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم) / دورة مياه, مغسلة (مرحاض (خاصة مرحاض في مكان عام))",
 "はばかる": "تَرَدَّدَ (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "はばき": "طماق, غطاء ساق (رداء يغطي الساق (يمتد عادة من الركبة إلى الكاحل)) / إزار الحائط, وزرة (إطار يغطي المفصل المكون من الجدار والأرضية)",
 "はばきき": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "はばたき": "رَفْرَف",
 "はばたく": "رَفْرَف",
 "はばち": "دبور المنشار, ذبابة المنشار (حشرة تمتلك أنثاها آلة وضع بيض تشبه المنشار لإدخال البيض في أنسجة أوراق أو سيقان النبات العائل)",
 "はばったい": "عَرِيض / مُتَطَاوِل, مُفْتَرِض (مفرط في الجرأة والتطاول؛ يتجاوز حدوده)",
 "はばつ": "طُغْمَة, عُصْبَة",
 "はばとび": "قفز طويل, وثب طويل (فعل القفز لأبعد مسافة ممكنة من انطلاقة ركض) / القفز الطويل, الوثب الطويل (مسابقة تتضمن القفز لأبعد مسافة ممكنة انطلاقاً من الجري)",
 "はばにする": "تَجَاهَلَ, طَنَّش / تَبَاهَى",
 "はばのせまい": "ضَيِّق",
 "はばのひろい": "عَرِيض",
 "はばひろ": "عَرِيض",
 "はばひろい": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة) / مُمْتَدّ, وَاسِع النِّطَاق (كبير في الامتداد المكاني أو النطاق أو الكمية) / توسعي, واسع النطاق (للزراعة؛ زيادة الإنتاجية باستخدام مناطق واسعة بحد أدنى من النفقات والعمالة)\nمثال: إنتاج القمح في ظل ظروف واسعة النطاق",
 "はばびろ": "عَرِيض",
 "はばむ": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "はばり": "مِفْصَد, فَاصِد",
 "はびこる": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "はふ": "جملون (الجدار المثلث العمودي بين الأطراف المائلة لسقف الجملون) / عجلة تلميع (عجلة مغطاة بمادة ناعمة)",
 "はふく": "بطن الموجة, نقطة التضاد ((في الفيزياء) نقطة الإزاحة القصوى في نظام دوري)",
 "はふらす": "تَجَاهَلَ, طَنَّش",
 "はぶ": "ذُو بُقَع صَفْرَاء (عليه بقع صفراء اللون)",
 "はぶく": "أَنْقَذَ, أَنْجَى / اِدَّخَرَ / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "はぶそう": "سنا القهوة, عشبة منتنة (شجيرة استوائية مورقة جداً كريهة الرائحة استخدمت بذورها كمغشوش للقهوة؛ تصنف أحياناً في جنس كاسيا)",
 "はぶにする": "تَجَاهَلَ, طَنَّش",
 "はぶり": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "はぶりがいい": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "はぶりがよい": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "はぶりのいい": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "はぶりのよい": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "はぶりの良い": "ذو نفوذ, مؤثر (لديه أو يمارس تأثيراً أو سلطة)\nمثال: صحيفة مؤثرة",
 "はへい": "مَقْبَض / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "はへん": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "はべらす": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "はべり": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "はべる": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "はぼね": "سِنّ, سن ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: هم في نفس السن.",
 "はま": "شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة) المنطقة اليابسة على طول حافة النهر. ضِفَّة، جَانِب، شَطّ) / سَاحِل\nمثال: عاد إلى الشاطئ. / يُوكُوهَامَا / ضفة النهر / رُقْيَة",
 "はまうつぼ": "هَالُوك, جَعْفِيل",
 "はまかぜ": "نسيم البحر (نسيم منعش من البحر (خلال النهار))",
 "はまかんざし": "بخل, تقتير (الحرص الشديد في إنفاق المال؛ التردد في إنفاق المال بلا ضرورة) / أرميريا, زهرة الثريفت (أي من العديد من النباتات دائمة الخضرة المحبة للشمس ومنخفضة النمو من جنس أرميريا لها رؤوس مستديرة من الزهور الوردية أو البيضاء)",
 "はまき": "سِيجَار, سِيكَار",
 "はまきタバコ": "سِيجَار, سِيكَار",
 "はますげ": "سعد الحمار, سعد مستدير (سعد معمر واسع الانتشار له درنات صغيرة صالحة للأكل تشبه الجوز)",
 "はまとびむし": "برغوث الشاطئ (قشريات صغيرة من مزدوجات الأرجل تقفز مثل البراغيث؛ شائعة على شواطئ المحيط)",
 "はまな": "كرامبي, كرنب بحري (نبات معمر في الرمال الساحلية والحصى لشمال أوروبا وبحر البلطيق والبحر الأسود له عناقيد من الزهور البيضاء الصغيرة وأوراق زرقاء خضراء لحمية كبيرة تستخدم…)",
 "はまなし": "ورد متعدد الأزهار, ورد ياباني (ورد قوي النمو له عناقيد من الزهور الصغيرة العديدة؛ يستخدم للأسيجة وكأصل للتطعيم)",
 "はまなす": "ورد متعدد الأزهار, ورد ياباني (ورد قوي النمو له عناقيد من الزهور الصغيرة العديدة؛ يستخدم للأسيجة وكأصل للتطعيم)",
 "はまひばり": "قبرة مقرنة",
 "はまびし": "حَسَك ((حَسِكَ) الْمَكَان حسكا: كثر حسكه؛ (حَسِكَ) رَأسه: اشتدت جعودته)",
 "はまべ": "شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة) المنطقة اليابسة على طول حافة النهر. ضِفَّة، جَانِب، شَطّ) / سَاحِل\nمثال: عاد إلى الشاطئ.",
 "はまる": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ / رَضَّى",
 "はみ": "أفعى الحفر (أفاعي العالم الجديد ذات أنياب مجوفة وحفرة حساسة للحرارة على كل جانب من الرأس) / بِت (انقطع؛ قَطَع) / أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "はみがき": "معجون أسنان, منظف أسنان (مادة لتنظيف الأسنان؛ توضع بفرشاة الأسنان)",
 "はみがきこ": "مسحوق الأسنان (مستحضر لتنظيف الأسنان في شكل مسحوق)\nمثال: 歯磨き粉はどこにありますか？ — أين معجون الأسنان؟",
 "はみがきざい": "معجون أسنان, منظف أسنان (مادة لتنظيف الأسنان؛ توضع بفرشاة الأسنان)",
 "はみがきようじ": "فُرْشَاة أَسْنَان",
 "はみだし": "بَارِز, مُمْتَدّ (يمتد للخارج فوق سطح أو حدّ أو ما وراءهما)",
 "はみだしもの": "مَنْبُوذ, مَنْبُوذَة",
 "はみだしもん": "مَنْبُوذ, مَنْبُوذَة",
 "はみだし者": "مَنْبُوذ, مَنْبُوذَة",
 "はみだす": "نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول) / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "はみでる": "نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول) / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "はみ出し": "بَارِز, مُمْتَدّ (يمتد للخارج فوق سطح أو حدّ أو ما وراءهما)",
 "はみ出し者": "مَنْبُوذ, مَنْبُوذَة",
 "はみ出す": "نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول) / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "はみ出る": "نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول) / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "はむ": "أنقليس كونجر, كونجر (أنقليس بحري كبير داكن اللون عديم القشور يوجد في المياه الساحلية المعتدلة والاستوائية؛ يُستخدم بعضه كطعام) / أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "はむかう": "شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه) / اِنْقَلَبَ عَلَى\nمثال: شغل بيل التلفاز.",
 "はむし": "قمل الطيور, قمل قارض (حشرة عديمة الأجنحة بأجزاء فم مهيأة للعض؛ تتطفل غالباً على الطيور) / خنفساء الأوراق (خنفساء زاهية الألوان تتغذى على أوراق النباتات؛ وتغزو يرقاتها الجذور والسيقان)",
 "はむしゃ": "جندي (جندي مجند من أدنى رتبة في الجيش أو مشاة البحرية)\nمثال: كان سجيننا مجرد جندي ولم يكن يعرف شيئاً ذا قيمة",
 "はむら": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "はめ": "لَجْنَة, لَجْنَة تَحْكِيم / عَهْد, مِيثَاق (تعهد رسمي بالوفاء والإخلاص) / مأزق, ورطة (موقف يصعب الخلاص منه، خاصة إذا كان مزعجاً أو شاقاً)\nمثال: وجد نفسه في مأزق محرج للغاية / برعم ورقي (برعم تتطور منه الأوراق (ولكن ليس الزهور)) / بِت (انقطع؛ قَطَع)",
 "はめあい": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "はめいた": "تكسية خشبية (ألواح خشبية يمكن استخدامها لتبطين جدران الغرفة) / تلبيسة خشبية, وزرة جدارية (جدار مغطى بألواح (عادة خشبية) في جزئه السفلي)",
 "はめこみ": "إدخال, إيلاج (عملية وضع شيء داخل شيء آخر) / إِدْرَاج, إِضَافَة (رسالة (منطوقة أو مكتوبة) يتم تقديمها أو إدراجها)\nمثال: بمساعدة إضافات صديقه تم سرد قصته في النهاية / تغطيس, غمر (فعل تبليل شيء بغمره) / تغطيس (شكل من أشكال المعمودية يغمر فيه جزء أو كل جسم الشخص) / استغراق, انهماك (انتباه كامل؛ جهد عقلي مكثف) / احتجاب, دخول ((في علم الفلك) اختفاء جرم سماوي قبل الكسوف)",
 "はめこむ": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "はめたおす": "ضَاجَعَ, جَامَعَ",
 "はめつ": "خَرَاب, خَرَابَة / دَمَّرَ",
 "はめつてき": "مدمر, هدام (يسبب دماراً أو ضرراً كبيراً)\nمثال: سياسة هدامة للاقتصاد",
 "はめはめ": "اللعين, جداً (أداة توكيد، عامية جداً وغير مهذبة) / مضاجعة, نكاح (مصطلحات عامية للجماع الجنسي)\nمثال: لماذا تأخرت وقتاً طويلاً؟",
 "はめる": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / حجيرة, رف رسائل (حجرة صغيرة) / تصنيف نمطي, خانة (فئة محددة (غالبًا ما تكون مبسطة)) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "はめん": "كَسْر, اِنْكِسَار / كَسْر / يكسر, ينكسر",
 "はめ倒す": "ضَاجَعَ, جَامَعَ",
 "はめ合い": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "はめ込み": "إدخال, إيلاج (عملية وضع شيء داخل شيء آخر) / إِدْرَاج, إِضَافَة (رسالة (منطوقة أو مكتوبة) يتم تقديمها أو إدراجها)\nمثال: بمساعدة إضافات صديقه تم سرد قصته في النهاية / تغطيس, غمر (فعل تبليل شيء بغمره) / تغطيس (شكل من أشكال المعمودية يغمر فيه جزء أو كل جسم الشخص) / استغراق, انهماك (انتباه كامل؛ جهد عقلي مكثف) / احتجاب, دخول ((في علم الفلك) اختفاء جرم سماوي قبل الكسوف)",
 "はめ込む": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "はも": "أنقليس كونجر, كونجر (أنقليس بحري كبير داكن اللون عديم القشور يوجد في المياه الساحلية المعتدلة والاستوائية؛ يُستخدم بعضه كطعام)",
 "はもじい": "مُحْرَج, بِٱلْحَرَج",
 "はもと": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "はもの": "سِكِّين, مُدْيَة (أَدَاةٌ حَادَةٌ تُسْتَخْدَمُ فِي تَقْطِيعِ مُخْتَلَفِ أَصْنَافِ الطَّعَامِ كَاللَّحْمِ وَالْخُضَرِ، وَلِذَبْحِ الْحَيَوَانَاتِ؛ أَدَاةٌ حَادَةٌ تُصْنَعُ غَالِباً مِنَ الْمَعْدِنِ، لِلدِّفَاعِ عَنِ النَّفْسِ وَاسْتِخْدَامِهَا أَثْنَاءَ الْقِتَالِ) / خَنْجَر, خنجر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين) / نَصْل, شَفْرَة (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة الحادّة الجارحة)\nمثال: أحتاج الى سكين. / أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء)",
 "はものし": "سَكَاكِينِيّ",
 "はもん": "تموج صغير, مويجة (موجة صغيرة على سطح سائل) / تموج ((في الإلكترونيات) تذبذب ذو سعة صغيرة مفروض فوق قيمة ثابتة) / أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / إِبْعَاد ((في السياسية) عقوبة جنائية تقضي بإخراج المحكوم عليه من البلاد) / حِرْمَان كَنَسِيّ",
 "はや": "منوة (سمكة مياه عذبة أوروبية صغيرة جداً شائعة في الجداول الحصوية) / قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا. / سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي.",
 "はやあし": "سير سريع (المسير بتوقيت سريع) / خبب (مشية أسرع من المشي؛ تضرب الأرجل المتقابلة قطرياً الأرض معاً) / هرولة (وتيرة جري بطيئة) / ترجمة حرفية مساعدة (ترجمة حرفية تُستخدم في دراسة لغة أجنبية (غالباً ما تُستخدم بشكل غير مشروع للغش)) / تروتسكي (راديكاليون يدعمون نظرية تروتسكي بأن الاشتراكية يجب أن تتأسس في جميع أنحاء العالم من خلال الثورة المستمرة)",
 "はやい": "عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان. / بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر. / سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع) / مُتَسَرِّع, مُسْتَعْجَل (أبكر ممّا ينبغي أو أكثر تسرّعاً من اللازم) / سابق لأوانه, مبتسر (ولد بعد فترة حمل أقل من الوقت الطبيعي)\nمثال: رضيع مبتسر / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "はやいこと": "بِسُرْعَة, عَاجِلًا",
 "はやいとこ": "بسرعة, على الفور (بطريقة دقيقة في المواعيد) / على الفور, فوراً (في الحال (عادة ما تعدل حدثاً غير مرغوب فيه)) / بسرعة, فوراً (مع تأخير قليل أو بدون تأخير)\nمثال: أدى واجبه المنزلي بسرعة",
 "はやいところ": "بسرعة, على الفور (بطريقة دقيقة في المواعيد) / على الفور, فوراً (في الحال (عادة ما تعدل حدثاً غير مرغوب فيه)) / بسرعة, فوراً (مع تأخير قليل أو بدون تأخير)\nمثال: أدى واجبه المنزلي بسرعة",
 "はやいはなしが": "بِاخْتِصَار",
 "はやいもので": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "はやうま": "حصان البريد (حصان يُحفظ في نزل أو مركز بريد لاستخدامه من قبل سعاة البريد أو لتأجيره للمسافرين)",
 "はやおき": "مُبَكِّر (شخص يستيقظ مبكراً جداً في الصباح) / باكور, مبكر (شخص يصل مبكرًا قبل الآخرين)",
 "はやおきはさんもんのとく": "مِنْ سَبَق أَكْل النَبْق, مِنْ سَبَقْ شَمْ الحَبْقْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "はやかれおそかれ": "عَاجِلاً أَم آجِلاً, عَاجِلاً أَو آجِلاً",
 "はやかろうわるかろう": "فِي الْعَجَلَة اَلنَّدَامَة, العجلة من الشيطان (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "はやがね": "جرس الإنذار, ناقوس الخطر (صوت إنذار (عادة جرس))",
 "はやがねをうつ": "مِطْرَقَة, شَاكُوش (أداة رأسها من حَدِيد ولها ذراع غالبا ما تكون من خَشَب تستخدم لضرب المِسْمَار في الخشب أو الحائط أو نحوه؛ أدَاة من حديد يطرق بها الحديد لتطويعه) / مِطْرَقَة (أداة رأسها من حَدِيد ولها ذراع غالبا ما تكون من خَشَب تستخدم لضرب المِسْمَار في الخشب أو الحائط أو نحوه؛ أدَاة من حديد يطرق بها الحديد لتطويعه)\nمثال: سأشتري له مطرقة.",
 "はやがわり": "مَسْخ",
 "はやく": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر. / بِسُرْعَة, عَاجِلًا / دور ثانوي, دور صغير (دور صغير) / تحطيم, كسر (عملية كسر شيء ما)\nمثال: كان الكسر لا مفر منه",
 "はやくから": "في وقت مبكر, مبكراً (خلال مرحلة مبكرة)\nمثال: في وقت مبكر من مسيرتها المهنية",
 "はやくちことば": "جملة صعبة النطق, عقدة لسان (تعبير يصعب نطقه بوضوح)",
 "はやくも": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "はやけ": "احتراق الأوراق, لفحة الأوراق (مرض نباتي يسبب مظهرًا محترقًا أو ملفوحاً للأوراق)",
 "はやさ": "سُرْعَة / تبكير (صفة المجيء مبكراً أو في وقت أسبق)",
 "はやさい": "خضراوات ورقية (أي من النباتات الورقية المختلفة أو أوراقها وسيقانها التي تؤكل كخضروات)",
 "はやざき": "مُزْهِر فِي الرَّبِيع (من النباتات التي تُزهر خلال فصل الربيع)",
 "はやし": "خَشَب, خشب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب. / حُزْمَة, عُنْقُود / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / حُزْمَة / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: شكرا لإضافتي للمجموعة. / أُورْكِسْتْرَا / حِلْيَة",
 "はやしたてる": "انشراح, بشاشة (صفة كون المرء مبتهجاً وطارداً للكآبة) / هتاف (صرخة أو صيحة استحسان)\nمثال: أضافت الزهور لمسة من البهجة للغرفة الكئيبة / اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "はやし立てる": "انشراح, بشاشة (صفة كون المرء مبتهجاً وطارداً للكآبة) / هتاف (صرخة أو صيحة استحسان)\nمثال: أضافت الزهور لمسة من البهجة للغرفة الكئيبة / اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "はやす": "نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟ / انشراح, بشاشة (صفة كون المرء مبتهجاً وطارداً للكآبة) / هتاف (صرخة أو صيحة استحسان)\nمثال: أضافت الزهور لمسة من البهجة للغرفة الكئيبة / اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "はやすぎる": "سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع) / مُتَسَرِّع, مُسْتَعْجَل (أبكر ممّا ينبغي أو أكثر تسرّعاً من اللازم) / سابق لأوانه, مبتسر (ولد بعد فترة حمل أقل من الوقت الطبيعي)\nمثال: رضيع مبتسر",
 "はやせ": "سَرِيع",
 "はやつけぎ": "مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "はやて": "ريح عاتية, عاصفة (رياح قوية تتحرك بسرعة 45-90 عقدة؛ قوة 7 إلى 10 على مقياس بوفورت)",
 "はやとうり": "شَايُوت",
 "はやはや": "بِسُرْعَة, عَاجِلًا",
 "はやばや": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "はやぶさ": "صَقْر, شَاهِين",
 "はやま": "سَفْح (لها معانٍ متعددة تتعلق بالانصباب والسكب؛ أراقَ دمًا أو ماءً)\nمثال: كان ذلك الحوض في سفح الجبل.",
 "はやまる": "أَحْيَا / سَرَّعَ (سَرُعَ يَسْرُعُ سَراعَة، وسُراعَة، وَسِرْعًا: سَرِع؛ فهو سَريعٌ. والجمع: سِراعٌ، وسُرْعَانٌ)\nمثال: اركض بأقصى سرعة.",
 "はやまわし": "مسح, مسح ضوئي (فعل تحريك شعاع ضوئي أو إلكتروني بؤري بدقة بشكل منهجي فوق سطح ما لإنتاج صورة له للتحليل أو الإرسال) / مسح ضوئي (عملية ترجمة الصور إلى شكل رقمي يمكن للكمبيوتر التعرف عليه)",
 "はやみ": "مُخَطَّط بَيَانِيّ / مُخَطَط",
 "はやみち": "اختصار, طريق مختصر (طريق أقصر من الطريق المعتاد)",
 "はやみみ": "حَادُّ السَّمْعِ, مُرْهَفُ الأُذُنِ (ذو سمع حادّ ومُرهَف)",
 "はやめ": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "はやめに": "قبل الأوان, مبكراً (قبل الوقت المعتاد أو المتوقع)\nمثال: تخرجت مبكراً",
 "はやめる": "يقرب / أَحْيَا / سَرَّعَ (سَرُعَ يَسْرُعُ سَراعَة، وسُراعَة، وَسِرْعًا: سَرِع؛ فهو سَريعٌ. والجمع: سِراعٌ، وسُرْعَانٌ)\nمثال: اركض بأقصى سرعة.",
 "はやり": "مُودَة, مُوضَة / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: تساهم في انتشار الجهل والتضليل.",
 "はやりかぜ": "إِنْفْلُوَنْزَا",
 "はやりぎ": "نَفَاد صَبْر",
 "はやりことば": "كَلِمَة طَنَّانَة, مُصْطَلَح رَائِج (عبارات مخزنة أصبحت بلا معنى بسبب التكرار اللامتناهي)",
 "はやりっこ": "إِجَّامَة / نَجْمَة",
 "はやりっ子": "إِجَّامَة / نَجْمَة",
 "はやりめ": "التهاب الملتحمة, الرمد (التهاب ملتحمة العين)",
 "はやりもの": "تشقق دقيق (شق دقيق في الطلاء أو أي سطح آخر) / بدعة, صرعة (اهتمام يُتبع بحماس مبالغ فيه) / نوبة جنون, هياج (حالة من الهياج العقلي العنيف)\nمثال: يتبع دائماً أحدث الصرعات",
 "はやりやまい": "وَبَاء, أَوْبِئَة (المرض العام الذي ينتشر بين الناس)\nمثال: على السلطات أن توقف انتشار الوباء.",
 "はやり病": "وَبَاء, أَوْبِئَة (المرض العام الذي ينتشر بين الناس)\nمثال: على السلطات أن توقف انتشار الوباء.",
 "はやり目": "التهاب الملتحمة, الرمد (التهاب ملتحمة العين)",
 "はやり眼": "التهاب الملتحمة, الرمد (التهاب ملتحمة العين)",
 "はやり風邪": "إِنْفْلُوَنْزَا",
 "はやるきもち": "حَمَاس, حَمَاسَة",
 "はやる気持ち": "حَمَاس, حَمَاسَة",
 "はやわかり": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "はやわざ": "مَأْثَرَة",
 "はやーい": "عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان. / بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر. / سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع) / مُتَسَرِّع, مُسْتَعْجَل (أبكر ممّا ينبغي أو أكثر تسرّعاً من اللازم) / سابق لأوانه, مبتسر (ولد بعد فترة حمل أقل من الوقت الطبيعي)\nمثال: رضيع مبتسر / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "はよ": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "はよう": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "はら": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل. / بَطْن, جَوْف (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء) / بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة. / رَحِم, بَيْت الْوَلِد (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام) / مَنشَأ, رَحِم\nمثال: رحمة الله عليه. / شَجَاعَة, جَسَارَة / كَرَم, سَخَاء",
 "はらあか": "تَرُوتَة, أُطْرُوط",
 "はらあて": "حزام البطن (حزام حول بطن حيوان الجر يحمل أعمدة العربة) / حزام البطن, مشد البطن (حزام قماشي يُرتدى حول الخصر (كما في الأطفال الرضع حتى تلتئم السرة)) / لَبَب",
 "はらい": "تَطْهِير (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير. / دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / كنس (فعل التنظيف بالمكنسة) / شَامِل, عَشْوَائِيّ (يَتَجَاهَل الفُرُوقَات وَالتَّمَايُزَات) / شَامِل, وَاسِع النِّطَاق (يشمل مساحة واسعة أو يتحرّك عبرها)",
 "はらいおとす": "اِنْتَفَضَ",
 "はらいきよめる": "صَفَّى",
 "はらいこみ": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "はらいこむ": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "はらいさげ": "بَيْع / تخفيض (تَنْقِيص ، حَسْم ،تَقْلِيل؛ تَنْزِيل) / مُزَايَدَة\nمثال: هل يمكن ان تعطيني تخفيض",
 "はらいし": "رَاقٍ, رَاقِية (صَفَا وحَسُنَ؛ الشيُ فلانًا: أعْجَبَه)\nمثال: أخذ زيري ريمة إلى مطعم راق.",
 "はらいすぎ": "دفع زائد (فعل دفع أكثر من اللازم) / دفعة زائدة (دفعة أكبر مما هو مطلوب أو متوقع)",
 "はらいせ": "اِنْتِقَام",
 "はらいた": "ألم المعدة, مغص (وجع موضعي في المعدة أو منطقة البطن)",
 "はらいだし": "إصدار, إطلاق (فعل توفير عنصر للاستخدام العام أو لأغراض رسمية (عادة بكميات))\nمثال: إصدار جديد من الطوابع",
 "はらいだす": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "はらいど": "بيرليت (خليط صفائحي من السمنتيت والفيريت يتشكل أثناء تبريد الأوستنيت؛ أحد مكونات الفولاذ والحديد الزهر)",
 "はらいのける": "يَدْرَأ",
 "はらいのこし": "متأخرات (دين غير مدفوع تجاوز موعد استحقاقه) / متأخرات (حالة التأخر في الدفع)\nمثال: حساب عليه متأخرات",
 "はらいのこり": "متأخرات (دين غير مدفوع تجاوز موعد استحقاقه) / متأخرات (حالة التأخر في الدفع)\nمثال: حساب عليه متأخرات",
 "はらいもどし": "استرداد, سداد (عملية إعادة الأموال المستلمة سابقاً) / إبراء ذمة, تسديد (دفع دين أو التزام)",
 "はらいもどしきん": "إِعَادَة مَال",
 "はらいもどす": "جَازَى",
 "はらいわたす": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "はらう": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن. / طَرَدَ / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / أخْلَا / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / أبْطَلَ, نَحّى\nمثال: لقد ترك لك هذا.",
 "はらえ": "تَطْهِير (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير.",
 "はらおち": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "はらおび": "حزام البطن (حزام حول بطن حيوان الجر يحمل أعمدة العربة) / حزام البطن, مشد البطن (حزام قماشي يُرتدى حول الخصر (كما في الأطفال الرضع حتى تلتئم السرة)) / حزام البطن, حزام السرج (معدات اسطبل تتكون من حزام حول بطن الحصان يثبت السرج في مكانه) / خَصْر, مُحِيط الجسم (المسافة حول جسم الشخص)",
 "はらか": "تَرُوتَة, أُطْرُوط",
 "はらがいる": "أَهْدَأَ, هَدَّأَ",
 "はらがきまる": "وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "はらがくろい": "مُحْتَال, مُدَبِّر (يُخفي خططًا ماكرة لتحقيق مصلحته الشخصيّة) / داهِيَة, مُتَآمِر (حاذِق في التَّدْبير والتَّخْطيط بِمَكْر وحِيلَة)",
 "はらがけ": "مِرْيَلَة",
 "はらがふとい": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "はらきり": "سيبوكو, هاراكيري (انتحار شعائري بقر البطن بالسيف؛ كان يمارسه الساموراي في المجتمع الياباني التقليدي)",
 "はらぎたない": "قَذِر جِدًّا, مُقْرِف (بالغ القذارة بشكل مثير للاشمئزاز؛ ملطّخ بمواد كريهة) / بَذِيء, سَافِل (يتّسم بالفحش وخدش الحياء) / ضَيِّق, عَصِيب (صَعْب التَّعَامُل مَعَهُ أَوْ تَجَاوُزِهِ إِلَى حَدِّ الإِحْبَاط) / بغيض, فظيع (مسيء أو حتى (للأشخاص) خبيث)\nمثال: في مزاج سيء",
 "はらくだし": "مُلَيّن / إِسْهَال",
 "はらくだり": "إِسْهَال",
