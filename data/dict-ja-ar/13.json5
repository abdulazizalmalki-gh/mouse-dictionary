 "はっしゃとう": "قاذفة إقلاع, منجنيق (جهاز يطلق الطائرات من على متن سفينة حربية)",
 "はっしゃやく": "دَافِع, دَفْعِيّ (يميل إلى الدفع أو قادر عليه)",
 "はっしゅう": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "はっしゅつ": "عَدَد (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "はっしょう": "مَنْشَأ",
 "はっしょうち": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "はっしょうのち": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "はっしょく": "تلوين, صباغة (عملية تغيير لون شيء ما)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء",
 "はっしょくだん": "حامل اللون, كروموفور (المجموعة الكيميائية التي تمنح اللون للجزيء)",
 "はっしん": "إرسال, إيفاد (فعل إرسال شيء ما)\nمثال: تم إنجازه بسرعة وكفاءة / إخبار, إعلام (فعل كلامي ينقل معلومات) / تَذَبْذُب / طَفْح, طَفْح جِلْدِيّ / رَحِيل, مُغَادَرَة / بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية))\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى",
 "はっしんおん": "نَغْمَة, نَغْم",
 "はっしんがわ": "مُرْسِل, مُرْسِلَة",
 "はっしんき": "مذبذب (مولد ينتج ذبذبات صوتية أو تياراً متردداً) / نَاقِل",
 "はっしんげん": "مَصْدَر, مَصَادِر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "はっしんしゃ": "العقل المدبر, مُبْتَكِر (شخص يبتكر أو ينشئ أشياء جديدة)",
 "はっしんじこくひょうじ": "سيدة (صيغة خطاب للمرأة (دون تحديد الحالة الاجتماعية))",
 "はっしんち": "مسقط الرأس, منشأ (المكان الذي نشأ فيه شيء ما أو تمت رعايته في بداية وجوده)\nمثال: مهد الحضارة",
 "はっしんねつ": "تيفوس الفئران, تيفوس متوطن (عدوى حادة تسببها الريكتسيا وتنتقل عن طريق لدغة برغوث مصاب؛ تتميز بالحمى…)",
 "はっしんほう": "تدوين ثماني (أي تدوين رياضي يستخدم 8 أحرف مختلفة (عادة الأرقام من 0 إلى 7))",
 "はっしんもと": "العقل المدبر, مُبْتَكِر (شخص يبتكر أو ينشئ أشياء جديدة)",
 "はっする": "نَطَقَ بِ (بمعنى الحزام؛ تحريف نُطْق. )\nمثال: يسهل نطق اسم توم / عَدَد (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟ / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا. / حَدَثَ, وَقَعَ (وَقَعَ الأمر؛ نقيض قَدُمَ، كان حَدِيثا)\nمثال: لا أصدق ما حدث.",
 "はっせい": "حُدُوث / جِيل, نَسْل / تطور, نشوء ((علم الأحياء) عملية نمو الكائن الفردي عضويًا؛ تكشف بيولوجي بحت للأحداث المتضمنة…)\nمثال: اقترح مؤشرًا للتطور العظمي عند الأطفال / تصويت, تلفظ (استخدام الأصوات المنطوقة للاتصال السمعي) / تصدأ, صدأ (تكوّن أكاسيد الحديد ذات اللون البني المحمر على الحديد عن طريق الأكسدة في درجات…)",
 "はっせいがく": "علم الأجنة (فرع علم الأحياء الذي يدرس تكوين وتطور الكائنات الحية في مراحلها المبكرة)",
 "はっせいがくしゃ": "أخصائي علم الأجنة (طبيب متخصص في علم الأجنة)",
 "はっせいきかん": "عضو نطق (أي من الأعضاء المشاركة في إنتاج الكلام)",
 "はっせいげん": "مَصْدَر, مَصَادِر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "はっせいじゅん": "مُرَتَّب زَمَنِيَّا (المَوْضوع في مَرْتبتِه؛ ما بدا عليه التَّرتيب)\nمثال: شعر توم ممشوط و مرتب.",
 "はっせいほう": "لَفْظ, نَطْق (نَطَقَ، تَكَلَّمَ؛ أَخْرَجَ، رَمَى)\nمثال: هذه الكلمة صعبة اللفظ.",
 "はっせいりつ": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي…)\nمثال: قبل ماثيو بتردد.",
 "はっせきやく": "دواء محمر للجلد (دواء للاستخدام الخارجي ينتج احمراراً في الجلد)",
 "はっせん": "ثَمَانِيَة آلَاف / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "はっせんねん": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ…)\nمثال: سأحبك إلى الأبد.",
 "はっそう": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة. / اِقْتَرَبَ\nمثال: هو واصل الاقتراب مني. / تَعْبِير / إرسال, بعث (فعل التسبب في ذهاب شيء ما (خاصة الرسائل)) / نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "はっそうさき": "وِجْهَة, وُجْهَة",
 "はっそうしゃ": "شركة شحن (شركة تعمل في مجال شحن البضائع)",
 "はっそうでん": "استطاعة كهربائية, قدرة كهربائية (حاصل ضرب الجهد في التيار)",
 "はっそうりょく": "إبداع, عبقرية (قوة الخيال الإبداعي)",
 "はっそく": "بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية))\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى",
 "はったおす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "はったつ": "إِعْمَار, تَعْمِير / تَقَدُّم / تَمَدُّد",
 "はったつしんりがく": "علم النفس النمائي, علم نفس الطفل (فرع علم النفس الذي يدرس التطور الاجتماعي والعقلي للأطفال)",
 "はったつでこぼこ": "تَنَوُّع عَصَبِيّ",
 "はったと": "فَجْأَةً / بحدة, بعدوانية (بطريقة عدوانية)\nمثال: كانت تُستجوب بحدة / تَمَامًا",
 "はったり": "خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك)\nمثال: نجحت مخادعته في قبوله",
 "はっちゃ": "صيحة ابتهاج (صيحة عالية تعبر عن الابتهاج أو الإثارة)",
 "はっちゃくえき": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "はっちゃくじょ": "رصيف إنزال, مرسى (هيكل يوفر مكاناً يمكن للقوارب فيه إنزال الأشخاص أو البضائع)",
 "はっちゅう": "ترتيب, نظم (فعل وضع الأشياء في ترتيب تسلسلي)\nمثال: كانت هناك أخطاء في ترتيب العناصر في القائمة",
 "はっちゅうしゃ": "منظم, منهجي (منظم يضع الأشياء في ترتيب)\nمثال: كان أرسطو منظماً عظيماً للأفكار",
 "はっちゅうしょ": "أمر شراء, طلب شراء (وثيقة تجارية تستخدم لطلب توريد شيء ما من شخص مقابل الدفع وتوفر المواصفات…)\nمثال: تلقت شركة آي بي إم طلباً لمائة حاسوب",
 "はっちょう": "براعة, مهارة (حالة كونه ماهراً معرفياً)",
 "はっつけ": "صَلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "はっつけばしら": "صَلِيب\nمثال: عبر جرذ الطريق.",
 "はっていく": "زحف (طريقة تنقل بطيئة على اليدين والركبتين أو بجر الجسم)\nمثال: كان الزحف هو كل ما استطاع الرجل المصاب القيام به",
 "はってん": "إِعْمَار, تَعْمِير",
 "はってんか": "مُسْتَهْتَر",
 "はってんけい": "اِخْتِلَاف",
 "はってんせい": "اِحْتِمَال (ما يكمن توقع حدوثه. يقول الجرجاني: «الاحتمال ما لا يكون تصور طرفيه كافيًا، بل…)\nمثال: هناك احتمال أن لا ينجح.",
 "はってんてき": "مُتَخَلِّف, نَامٍ (يتعلق بمجتمعات يشحّ فيها رأس المال اللازم للتصنيع)\nمثال: استغرق تحميض وطباعة صوره ساعتين فقط",
 "はってんとじょう": "مُتَخَلِّف, نَامٍ (يتعلق بمجتمعات يشحّ فيها رأس المال اللازم للتصنيع)\nمثال: استغرق تحميض وطباعة صوره ساعتين فقط",
 "はってんとじょうこく": "دَوْلَة نَامِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من…)\nمثال: لبنان دولة صغيرة.",
 "はって行く": "زحف (طريقة تنقل بطيئة على اليدين والركبتين أو بجر الجسم)\nمثال: كان الزحف هو كل ما استطاع الرجل المصاب القيام به",
 "はっと": "فَجْأَةً / نخير, نفخ (فعل الزفير بقوة)\nمثال: لقد ملأوا الغرفة بالدخان بنفثهم المستمر / حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ)\nمثال: حرم الإسلام الترويع / قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "はっとう": "تَفَشٍّ",
 "はっはっ": "هَاهَا, هِهِهِهِ / لهاث (التنفس بصعوبة وثقل (كما يحدث بعد المجهود))",
 "はっぱ": "كَارِثِيّ, مُهْلِك (يُسَبِّبُ الأَذَى أَوِ الآفَةَ؛ يُصِيبُ بِعُنْفٍ مُفَاجِئٍ أَوْ وَبَاءٍ) / وَرَقَة, وَرَقة / مَارِهْوَانَا, حَشِيش",
 "はっぴゃく": "ثَمَانِيمِئَة, ثَمَانِيمِا۟ئَة / جماهير, جموع (عامة الناس بشكل عام)\nمثال: افصل المحاربين عن الجموع",
 "はっぴょう": "إِعْلَان, بَلَاغ",
 "はっぴょうかい": "حَيْثِيَّة / إِرَاءَة",
 "はっぴょうしゃ": "مُذِيع, مُذِيعَة",
 "はっぷ": "مَنْسُور, مُنَادَاة / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ…)",
 "はっぽう": "رَغْوِيّ, مُزْبِد (يُنْتِج أو يُغَطّى بِرَغْوَة مِن العَرَق أو اللُّعاب بِسَبَب الإرْهاق أو المَرَض) / إطلاق نار (فعل إطلاق النار من بندقية)\nمثال: تراجعوا في مواجهة نيران العدو الشديدة",
 "はっぽうおん": "إطلاق نار, نيران (فعل إطلاق النار من سلاح)\nمثال: عرض إطلاق النار المارة الأبرياء للخطر",
 "はっぽうしゅ": "نبيذ فوار (نبيذ ذو فوران غازي)",
 "はっぽうせい": "رغوية, فوران (خاصية إطلاق فقاعات)",
 "はっぽうびじん": "إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل)"
}
