 "のま": "حصان بري (حصان منزلي غير مروض أو وحشي)",
 "のます": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "のませる": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "のみ": "وَحِيد / بُرْغُوث / إِزْمِيل / شَرِبَ, شرب (جَرَعَ)\nمثال: جلس وشرب قهوته. / حنفية, صنبور (منظم للتحكم في تدفق السائل من خزان) / سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ, بُورْصَة (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ…)\nمثال: ذهبت إلى السوق.",
 "のみあるき": "جولة حانات (جولة في الحانات (عادة مع تناول مشروب في كل محطة))",
 "のみくだす": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه)",
 "のみくち": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ…)\nمثال: أكره ذوق الكحول. / تَنَصَّتَ",
 "のみぐすり": "طب باطني, طب عام (فرع الطب الذي يتعامل مع تشخيص وعلاج (غير جراحي) لأمراض الأعضاء الداخلية (خاصة…)",
 "のみぐち": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ…)\nمثال: أكره ذوق الكحول. / تَنَصَّتَ",
 "のみこうい": "دَلْو, سَطْل",
 "のみこみ": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "のみこみがはやい": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "のみこみがわるい": "بَطِيء الفَهْم, ضَعِيف العَقْل (متأخر في التطور العقلي والذهني)",
 "のみこむ": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / اِحْتَوَى, تَضَمَّنَ",
 "のみし": "كحولي, مدمن كحول (شخص يشرب الكحول بإفراط وبشكل اعتيادي)",
 "のみすけ": "مُعَاقِر الخَمْر, شَارِب الخَمْر",
 "のみで": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو…)\nمثال: مزيد من الأرض",
 "のみならず": "بِالْإِضَافَة إِلَى / عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك",
 "のみにくい": "بَغِيض, غَيْر مَقْبُول (ليس على هواك)\nمثال: موقف بغيض",
 "のみぬけ": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "のみのいち": "سوق البراغيث, سوق السلع المستعملة (سوق شوارع مفتوح للسلع الرخيصة أو المستعملة)",
 "のみのしんぞう": "تهيب, جبن (الخوف عند الخوض في أماكن أو أنشطة جديدة ومجهولة)",
 "のみの市": "سوق البراغيث, سوق السلع المستعملة (سوق شوارع مفتوح للسلع الرخيصة أو المستعملة)",
 "のみほす": "بَالُوعَة",
 "のみみず": "مَاء شُرْب, مَاء صَالِح لِلشُّرْبِ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما…)\nمثال: أنا أشرب الماء.",
 "のみむし": "قافزات الذيل (أي من الحشرات البدائية الدقيقة عديمة الأجنحة العديدة التي تمتلك زائدة بطنية…)",
 "のみもの": "شَرِبَ, شرب (جَرَعَ)\nمثال: جلس وشرب قهوته.",
 "のみや": "حَانَة, بَار / مُؤَلِّف, كَتَّاب / حانة رخيصة ((سابقاً) صالون رخيص يبيع الخمور بالدلو)",
 "のみ込みが悪い": "بَطِيء الفَهْم, ضَعِيف العَقْل (متأخر في التطور العقلي والذهني)",
 "のみ込みが早い": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "のむ": "شَرِبَ, شرب (جَرَعَ)\nمثال: جلس وشرب قهوته. / دُخَان, دخان\nمثال: دخن زيري سيجارة. / جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل. / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي.",
 "のめのめ": "بلا خجل, بوقاحة (بدون خجل)\nمثال: تخلى بلا خجل عن المشروع",
 "のめやうたえ": "احتفال صاخب, سَمَر (مرح واحتفال غير مقيد)",
 "のめりこむ": "اِنْخَدَعَ بِـ",
 "のめり込む": "اِنْخَدَعَ بِـ",
 "のように": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "のら": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل. / ضَلَّ / غَرِيب, غَرِيبَة",
 "のらくら": "باسترخاء, بكسل (بطريقة خاملة)\nمثال: هذا ما كنت أتخيل نفسي أفعله دائماً في جنوب فرنسا، الجلوس باسترخاء، وشرب القهوة، ومراقبة الناس / بتهرب, بمراوغة (مع تهرب؛ بأسلوب مراوغ)\nمثال: بدا أن زوجها يعرف الكثير من الأشخاص المذكورين، لكنه أجاب بمراوغة عندما سُئل عن هويتهم / كَسَل",
 "のらくらもの": "كَسُول, مِكْسَال",
