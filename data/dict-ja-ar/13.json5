 "はけんだん": "تَفْوِيض",
 "はけんろうどうしゃ": "موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "はけ口": "تنفيس, مخرج (نشاط يحرر أو يعبر عن الطاقة الإبداعية أو العاطفة)\nمثال: لم يكن لديها مخرج آخر لمشاعرها / سُوق (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ…)\nمثال: ذهبت إلى السوق.",
 "はけ場": "تنفيس, مخرج (نشاط يحرر أو يعبر عن الطاقة الإبداعية أو العاطفة)\nمثال: لم يكن لديها مخرج آخر لمشاعرها",
 "はげ": "صَلَع / أَصْلَع حَلِيق / أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "はげあたま": "صَلَع",
 "はげいとう": "سجاد, كوليوس",
 "はげしい": "عَنِيف / الْأُقْصَى, الْأَبْعَد\nمثال: أنا غير متفاجئ. / مُتَّقِد, مُلْتَهِب ((قديم) شديد الحرارة؛ مشتعل أو متوهِّج) / مُسْتَمِرّ, مُتَوَاصِل",
 "はげたか": "نَسْر (الكشط والجرح والنقب؛ طَيْر من الجَوَارِح أكبرها حجما يقتات الجِيَف وله منقار…)\nمثال: الصغر أسرع من النسر",
 "はげまし": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما)",
 "はげます": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك. / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "はげみ": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما)",
 "はげみあい": "مُنَافَسَة, مُبَارَاة",
 "はげむ": "كَافَحَ, اِجْتَهَدَ",
 "はげる": "اختفاء, تلاشٍ (التوقف التدريجي عن الظهور)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة",
 "はげわし": "نسر (العالم القديم) (أي من النسور الكبيرة المتعددة في أفريقيا وأوراسيا)",
 "はげ頭": "صَلَع",
 "はこ": "صُنْدُوق, صَنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها…)\nمثال: أين صندوق البريد؟ / سَيَّارَة, عَرَبِيَّة (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة. / شَامِيسِين / بِرَاز, سَلْح",
 "はこいり": "فِي عُلْبَة, مُغَلَّف (محاط بغلاف أو علبة) / ثَمِين",
 "はこう": "اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء)\nمثال: اختلال هرموني / عَرَجَ / زحف (طريقة تنقل بطيئة على اليدين والركبتين أو بجر الجسم)\nمثال: كان الزحف هو كل ما استطاع الرجل المصاب القيام به",
 "はこうせい": "تراخ, سبات (خمول؛ إظهار نقص غير عادي في الطاقة)\nمثال: أقلق المظهر العام للسبات أصدقاءه",
 "はこがた": "شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته)",
 "はこがめ": "سلحفاة صندوقية (سلحفاة برية بشكل رئيسي من أمريكا الشمالية؛ يمكن إغلاق صدفتها بإحكام)",
 "はこきぎょう": "شركة صورية, شركة وهمية (شركة مؤسسة ولكن ليس لديها أصول أو عمليات)",
 "はこつさいぼう": "خلية هادمة للعظم, ناقضة العظم (خلية تعمل على تكسير وامتصاص النسيج العظمي)",
 "はこづめ": "مُلَاكَمَة",
 "はこばしゃ": "شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته)",
 "はこび": "تَقَدُّم",
 "はこびだす": "شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ…)\nمثال: شغل بيل التلفاز.",
 "はこびて": "نَاقِل\nمثال: يبدو أنني حامل.",
 "はこびや": "رسول, ساعي (شخص يحمل رسالة)",
 "はこふぐ": "سمكة الصندوق (أي من الأسماك الاستوائية الصغيرة العديدة التي يكون جسمها ورأسها مغلفين بصفائح…)",
 "はこぶ": "حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه. / جَاءَ (أَتَى؛ حَدَثَ)\nمثال: تقريبا الكل جاء / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال)\nمثال: أيمكنني استعمال هاتفك؟ / شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ…)\nمثال: شغل بيل التلفاز.",
 "はこぶね": "سَفِينَة, فُلْك (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "はこべ": "أذن الفأر, حشيشة القزاز (أي من النباتات المتنوعة المرتبطة بحشيشة القزاز الشائعة)",
 "はこべら": "أذن الفأر, حشيشة القزاز (أي من النباتات المتنوعة المرتبطة بحشيشة القزاز الشائعة)",
 "はこめがね": "ساعة مائية, كليبسيدرا (ساعة تقيس الوقت عن طريق تدفق الماء)",
 "はこもの": "شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته)",
 "はこん": "طَلَاق, تَطْلِيق\nمثال: طلق زيري زوجته.",
 "はご": "رِيشَة",
 "はごいた": "مِدَقّ, مِدَقَّة (ما يدق او يطرق به ويسمى كذلك مطرقة)",
 "はごたえ": "ثَبَات / تَحَدٍّ, التَّحَدِّي",
 "はごろもかんらん": "كُرْنُب أَجْعَد",
 "はごろもがらす": "شحرور أحمر الجناح (شحرور من أمريكا الشمالية ذو بقع قرمزية على الأجنحة)",
 "はごろもむしくい": "حميراء أمريكية (طائر مغرد صائد للذباب يعيش في شرق أمريكا الشمالية، يتميز الذكر بلون برتقالي…)",
 "はさい": "سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي…)\nمثال: قمع الهرطقة",
 "はさいき": "ساحقة, كسارة (جهاز يقوم بسحق شيء ما)",
 "はさいせい": "قابل للكسر, هش (قادر على أن ينكسر أو يتلف)\nمثال: الفخار الخزفي قابل للكسر",
 "はさいせいばくだん": "ضربة أرضية زاحفة (كرة مضروبة أو مرسلة تنزلق قريباً من الأرض)",
 "はさつおん": "صَامِت مَوْقُوف اِحْتِكَاكِيّ, صَامِت مَزْجِيّ",
 "はさま": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية)\nمثال: تم عرضه بدون فواصل إعلانية / وَادٍ, الْوَادِي (حوض أو منخفض طبيعي على سطح الأرض، يمتد بين السهول والهضاب والجبال)\nمثال: بإمكاني السباحة في الواد. / فتحة الرمي, مزغل (ثقب صغير في جدار محصن؛ للمراقبة أو إطلاق الأسلحة) / فَاصِل",
 "はさみ": "مِقَصّ, مِقْرَاض / خَرَّامَة, خَرَّامَة وَرَق / كَلْبَتَان / مِشْبَك / كلاب, مخلب (هيكل للإمساك على طرف القشريات أو مفصليات الأرجل الأخرى)",
 "はさみあげる": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ…)\nمثال: أحب قطف الورود.",
 "はさみきる": "قصاصة, قُصاصة (عملية القص أو القصقصة)",
 "はさみこむ": "أَدْخَلَ",
 "はさみつけ": "مَشْبَك",
 "はさみむし": "أَبُو مِقَصّ",
 "はさみをいれる": "شَذَّبَ, قَلَّمَ / لَكْمَة\nمثال: لكم اشتقت إليك!",
 "はさみを入れる": "شَذَّبَ, قَلَّمَ / لَكْمَة\nمثال: لكم اشتقت إليك!",
 "はさみ切る": "قصاصة, قُصاصة (عملية القص أو القصقصة)",
 "はさむ": "مَقْبِض / أَدْخَلَ / لُقْطَة\nمثال: كنت أمسك بالكرة. / مرفأ, ملاذ (مكان للملجأ والراحة والأمان) / مِشْبَك",
 "はさん": "إِفْلَاس / اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا!",
 "はさんすんぜん": "مُتَرَاصّ, مُتَلَاصِق ((عَنْ حَرَكَة المُرُور) مُتَلَاصِق سَيَّارَة بِسَيَّارَة بِسَبَب الازْدِحَام)",
 "はざくら": "شجرة الكرز, كرز (أي من العديد من الأشجار والشجيرات التي تنتج فاكهة مستديرة لحمية صغيرة بنواة…)",
 "はざま": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية)\nمثال: تم عرضه بدون فواصل إعلانية / وَادٍ, الْوَادِي (حوض أو منخفض طبيعي على سطح الأرض، يمتد بين السهول والهضاب والجبال)\nمثال: بإمكاني السباحة في الواد. / فتحة الرمي, مزغل (ثقب صغير في جدار محصن؛ للمراقبة أو إطلاق الأسلحة) / فَاصِل",
 "はし": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر. / أَعْوَاد الْأَكْل, هَاشِي / مِنْقَار / نِهَايَة, غَايَة\nمثال: انتهى أمر زيري. / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة. / أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء) / سَلَالِم / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم. / جَمِيل, مَحْبُوب (يخاطب العواطف والعين معاً) / فَارِس (اسم فاعل لفَرَسَ؛ راكب الفَرَس أو الحِصَان)\nمثال: فارس الظلام فيلم جيد.",
 "はしおる": "قَصَّر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "はしかけ": "تشابك, رابطة مستعرضة (رابطة جانبية تربط سلسلتين متجاورتين من الذرات في جزيء معقد)",
 "はしから": "مِنَ الأَلِف إِلَى اليَاء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "はしからはしまで": "باستفاضة, بدقة (بطريقة شاملة)\nمثال: بحثنا في الملفات بدقة",
 "はしがかり": "جسر مسقوف (جسر يكون ممره محمياً بسقف وجوانب مغلقة)",
 "はしがき": "توطئة, ديباجة (مقال تمهيدي قصير يسبق نص كتاب) / إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية)",
 "はしがすすむ": "مُشَهٍّ (يجذب أو يحفز الشهية خاصة في المظهر أو الرائحة)",
 "はしくれ": "خُرْدَة / تافه, غير مهم (ليس مهماً)\nمثال: ميزة غير مهمة نسبياً للنظام",
 "はしけ": "قَدَّاحَة, وَلَّاعَة",
