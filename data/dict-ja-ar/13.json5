 "ねつかくはんのう": "تفاعل نووي حراري (تفاعل اندماج نووي يحدث في درجات حرارة عالية جداً (كما في الشمس))",
 "ねつかそ": "لدائني الحرارة, لدن بالحرارة (له خاصية الليونة أو الانصهار عند التسخين والتصلب مرة أخرى عند التبريد)\nمثال: المواد اللدائنية الحرارية يمكن إعادة صهرها وتبريدها مرارًا دون الخضوع لأي تغيير كيميائي ملحوظ",
 "ねつかそじゅし": "بلاستيك حراري, لدائن حرارية (مادة تلين عند تسخينها وتتصلب مرة أخرى عند تبريدها)",
 "ねつかそせいじゅし": "بلاستيك حراري, لدائن حرارية (مادة تلين عند تسخينها وتتصلب مرة أخرى عند تبريدها)",
 "ねつきかん": "محرك حراري (أي محرك يستخدم الحرارة للقيام بعمل)",
 "ねつききゅう": "مُنْطَاد, بَالُون",
 "ねつきぐ": "مِدْفَأَة",
 "ねつぎ": "لصقة, وصلة (نقطة اتصال حيث يتم ضم شيئين (مثل الورق أو الفيلم أو الشريط المغناطيسي) معاً)\nمثال: كان الانقطاع بسبب وصلة غير متقنة",
 "ねつく": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "ねつくさい": "دَافِئ",
 "ねつけ": "حمى, سخونة (ارتفاع في درجة حرارة الجسم؛ غالباً ما يكون عرضاً للعدوى)",
 "ねつけん": "ثِيرْمُوسْفِير",
 "ねつこうか": "تصلبي الحرارة, صلد بالحرارة (له خاصية التصلب الدائم عند التسخين أو المعالجة)\nمثال: كانت راتنجات الفينول والبلاستيك هي المواد الاصطناعية الأصلية المتصلبة بالحرارة",
 "ねつこうかざい": "مصلب, مقسي (مادة تزيد الصلابة، خاصة مادة تضاف إلى الورنيش أو الطلاء لمنحه سطحاً أو طبقة…)",
 "ねつこうかせいじゅし": "راتينج تصلب بالحرارة, لدائن تصلب بالحرارة (مادة تتصلب عند تسخينها ولا يمكن إعادة تشكيلها)",
 "ねつこうかんき": "مبادل حراري (جهاز ينقل الحرارة من سائل إلى آخر دون السماح باختلاطهما)",
 "ねつさまし": "خافض للحرارة",
 "ねつじょう": "اتقاد, حرارة (مشاعر الدفء والحدة الكبيرة)\nمثال: تحدث بحماسة كبيرة",
 "ねつじょうてき": "مُتَوَهِّج",
 "ねつぞう": "فَبْرَكَة",
 "ねつっぽい": "مَحْمُوم, مُحْتَدِم (يتسم باضطراب أو انفعال شديد)\nمثال: تفاعل حمي ناتج عن مادة مسببة للحساسية / مُتَحَمِّس",
 "ねつでんし": "أَيُون حَرَارِيّ (جسيم مشحون كهربائياً (إلكترون أو أيون) ينبعث من مادة عند درجة حرارة عالية)",
 "ねつでんつい": "مزدوجة حرارية (نوع من مقاييس الحرارة يتكون من سلكين من معدنين مختلفين متصلين في كلا الطرفين…)",
 "ねつでんどうりつ": "موصلية حرارية (في الفيزياء، خاصية المادة لتوصيل الحرارة)\nمثال: عندما تخضع مادة لتغير في الطور من صلب إلى سائل أو من سائل إلى غاز، قد تتغير الموصلية الحرارية",
 "ねつど": "دَرَجَةْ الْحَرَارَة\nمثال: ليس لديك أي حمى.",
 "ねつのかべ": "حاجز حراري (حد لسرعة الطيران العالية يفرضه التسخين الديناميكي الهوائي)",
 "ねつのこもった": "مُسَخَّن (جُعِل دافئاً أو ساخناً)",
 "ねつばて": "إنهاك حراري (حالة تتميز بالدوخة والغثيان والضعف الناجم عن استنزاف سوائل الجسم والشوارد)",
 "ねつひはい": "إنهاك حراري (حالة تتميز بالدوخة والغثيان والضعف الناجم عن استنزاف سوائل الجسم والشوارد)",
 "ねつひろう": "إنهاك حراري (حالة تتميز بالدوخة والغثيان والضعف الناجم عن استنزاف سوائل الجسم والشوارد)",
 "ねつびょう": "حُمَّة, حُمَّى",
 "ねつぶんかい": "تحلل حراري (تحول مادة ناتج عن تأثير الحرارة)",
 "ねつぼうそう": "تسخين مفرط, فرط السخونة (تسخين مفرط)",
 "ねつりきがく": "دِينَامِيكَا حَرَارِيَّة",
 "ねつりきがくだいいちほうそく": "حفظ الطاقة, قانون حفظ الطاقة (المبدأ الأساسي في الفيزياء القائل بأن الطاقة الكلية لنظام معزول ثابتة على الرغم…)",
 "ねつりきがくだいさんほうそく": "القانون الثالث للديناميكا الحرارية (قانون ينص على أن إنتروبيا مادة ما تقترب من الصفر مع اقتراب درجة حرارتها من…)",
 "ねつりきがくだいにほうそく": "القانون الثاني للديناميكا الحرارية (قانون ينص على أنه لا يمكن استخلاص شغل ميكانيكي من جسم إلا عندما يتفاعل ذلك…)",
 "ねつりきがくてき": "ترموديناميكي, ديناميكي حراري (متعلق بالديناميكا الحرارية)\nمثال: الحد الديناميكي الحراري",
 "ねつりきがくのだいいちほうそく": "حفظ الطاقة, قانون حفظ الطاقة (المبدأ الأساسي في الفيزياء القائل بأن الطاقة الكلية لنظام معزول ثابتة على الرغم…)",
 "ねつりきがくのだいさんほうそく": "القانون الثالث للديناميكا الحرارية (قانون ينص على أن إنتروبيا مادة ما تقترب من الصفر مع اقتراب درجة حرارتها من…)",
 "ねつりきがくのだいにほうそく": "القانون الثاني للديناميكا الحرارية (قانون ينص على أنه لا يمكن استخلاص شغل ميكانيكي من جسم إلا عندما يتفاعل ذلك…)",
 "ねつりきがくのだいゼロほうそく": "القانون الصفري للديناميكا الحرارية (القانون الذي ينص على أنه إذا كان جسمان في توازن حراري مع جسم ثالث، فإن الجسمين…)",
 "ねつりきがくのほうそく": "قانون الديناميكا الحرارية ((فيزياء) قانون يحكم العلاقات بين حالات الطاقة في نظام مغلق)",
 "ねつりきがくほうそく": "قانون الديناميكا الحرارية ((فيزياء) قانون يحكم العلاقات بين حالات الطاقة في نظام مغلق)",
 "ねつりょう": "حَمَاس, حَمَاسَة",
 "ねつりょうけい": "مسعر, مقياس الحرارة (أداة قياس تحدد كميات الحرارة)",
 "ねつれつ": "مُتَوَهِّج كَالنَّار, مُتَّقِد (يَتَوَهَّج أَوْ يَلْمَع كَالنَّار)",
 "ねつエネルギー": "حرارة, طاقة حرارية (شكل من أشكال الطاقة يتم نقله عن طريق اختلاف في درجة الحرارة)",
 "ねつポンプ": "مضخة حرارية (جهاز يستخرج الحرارة من سائل ذي درجة حرارة أعلى من محيطه؛ يمكن استخدامه لنقل…)",
 "ねつ造": "فَبْرَكَة",
 "ねづく": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "ねづけ": "تسعير (تقييم شيء ما من حيث سعره)",
 "ねづもり": "تثمين, تقدير (حكم على صفات شيء أو شخص ما)\nمثال: في تقديري الصبي بريء",
 "ねづよい": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "ねてもさめても": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير)\nمثال: العالم يتغير باستمرار",
 "ねとねと": "بلزوجة (بطريقة لزجة ودبقة)\nمثال: شعر بالدم يتحرك بلزوجة من فروة رأسه المشقوقة ويسيل على جبهته",
 "ねとまり": "إِقَامَة",
 "ねとられ": "دياثة (فعل جنسي يمارس فيه شخص متزوج الجنس مع شخص آخر بينما يشاهد الزوج ذلك)",
 "ねどい": "تطفل, فضول (حالة من الفضول النشط)\nمثال: أزعجتني نظرة الاختراق وحب الاستطلاع لديه: شعرت بالحرج والذنب في وجوده",
 "ねどうぐ": "أغطية السرير, مفروشات السرير (الأغطية التي تستخدم على السرير)",
 "ねどこ": "قَاع, حَوْض (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر)\nمثال: نمت في قاعة السينما. / مَخْدَع, غُرْفَةُ نَوْم",
 "ねどころ": "مَخْدَع, غُرْفَةُ نَوْم / مجثم (مجثم تستريح عليه أو تنام عليه الطيور الداجنة)",
 "ねなし": "صُعْلُوك, مُقْتَلَع الجُذُور (يتشرّد بلا هدف ودون روابط بمكان أو مجتمع)",
 "ねなしぐさ": "عدس الماء (عَدَس)\nمثال: أعدت سلطة العدس. / هَائِم",
 "ねぬき": "الجماع المقطوع, العزل (طريقة لتحديد النسل يتم فيها بدء الجماع ولكن يتم سحب القضيب عمداً قبل القذف) / ابْنُ البَلَد, مَوْلُودٌ فِي البَلَد (يَنْتَمِي إِلَى مَكَانٍ بِحُكْمِ الوِلَادَةِ فِيهِ)",
 "ねね": "يَاه, اسمع",
 "ねのかたすくに": "سِجِّين, عَالَم سُفْلِيّ",
 "ねのくに": "سِجِّين, عَالَم سُفْلِيّ",
 "ねのとき": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل",
 "ねはん": "اَلنِّرْفَانَا / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "ねば": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا. / دبق, لزوجة (خاصية الالتصاق بسطح ما) / طِين, صَلْصَال",
 "ねばい": "دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة)",
 "ねばっこい": "دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة) / مُتَمَاسِك (ملتصق ببعضه ومتماسك)\nمثال: عقل حافظ",
 "ねばつち": "طِين, صَلْصَال",
 "ねばならない": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب))\nمثال: وجب عليك إيقافه.",
 "ねばならぬ": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب))\nمثال: وجب عليك إيقافه.",
 "ねばなりません": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب))\nمثال: وجب عليك إيقافه.",
 "ねばなるまい": "يَنْبَغِي أَنْ\nمثال: يا لها من جملة!",
 "ねばねば": "دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة) / دبق, لزوجة (خاصية الالتصاق بسطح ما)",
 "ねばり": "دبق, لزوجة (خاصية الالتصاق بسطح ما) / إصرار, دأب (تصميم مستمر)",
 "ねばりがち": "عَنِيف المُنَافَسَة (يَتَطَلَّب جُهْدًا كَبِيرًا)",
 "ねばりけ": "دبق, لزوجة (خاصية الالتصاق بسطح ما)",
 "ねばりづよい": "مُتَمَاسِك (ملتصق ببعضه ومتماسك)\nمثال: عقل حافظ / دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة)",
 "ねばり強い": "مُتَمَاسِك (ملتصق ببعضه ومتماسك)\nمثال: عقل حافظ / دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة)",
 "ねばる": "ثَابَرَ",
 "ねびき": "تخفيض السعر, خصم (عملية تخفيض سعر بيع البضائع)",
 "ねびきりつ": "خصم مصرفي, سعر الخصم (فائدة على أساس سنوي تُخصم مقدماً على قرض)",
 "ねふだ": "عَلَامَةُ سِعْر, بِطَاقَةُ سِعْر (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "ねぶか": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "ねぶかい": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "ねぶかじる": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "ねぶくろ": "حَقِيبَةُ النَّوْم",
 "ねぶと": "دُمَّل, خُرَاج",
 "ねぶみ": "تثمين, تخمين (تقدير خبير للجودة والكمية والخصائص الأخرى لشخص أو شيء ما)",
 "ねぶり": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة. / خمول, ركود (حالة عدم النشاط أو قلة النشاط)\nمثال: كان عليه التغلب على عطالته والعودة للعمل / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "ねぶる": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات. / لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان)",
 "ねべや": "مَخْدَع, غُرْفَةُ نَوْم",
 "ねほしょう": "ائتمان متجدد, ائتمان مفتوح (خط ائتمان استهلاكي يمكن استخدامه حتى حد معين أو سداده في أي وقت)",
 "ねほりはほり": "بتساؤل, بفضول\nمثال: نظر الطفل حوله بفضول",
 "ねぼう": "اِسْتَغْرَقَ فِي النَّوْم / نَؤُوم, نَعْسَان (شخص يشعر بالنعاس)",
 "ねぼすけ": "نَؤُوم, نَعْسَان (شخص يشعر بالنعاس)",
 "ねま": "مَخْدَع, غُرْفَةُ نَوْم",
 "ねまき": "ملابس نوم (ملابس مصممة للارتداء في السرير)",
 "ねまわし": "خَلْفَ الكَوَالِيس, سِرِّيّ (مُصَمَّمٌ وَمُنَفَّذٌ بِسِرِّيَّةٍ أَوْ بِشَكْلٍ سِرِّيّ)",
 "ねむい": "نَعْسَان, نَاعِس",
 "ねむけ": "نُعَاس, سِنَة",
 "ねむたい": "نَعْسَان, نَاعِس",
 "ねむのき": "ألبيزيا زهرة الحرير, شجرة الحرير (شجرة آسيوية جذابة مقببة أو مسطحة القمة لها أوراق ريشية مزدوجة وزهور بأسدية…)",
 "ねむらす": "نَوَّمَ, أَنَامَ (بكافة معانيه)\nمثال: لم أستطع النوم. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "ねむらせる": "نَوَّمَ, أَنَامَ (بكافة معانيه)\nمثال: لم أستطع النوم. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "ねむり": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة. / خمول, ركود (حالة عدم النشاط أو قلة النشاط)\nمثال: كان عليه التغلب على عطالته والعودة للعمل / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "ねむりぐさ": "ميموزا (مشروب مخلوط يحتوي على الشمبانيا وعصير البرتقال)",
 "ねむりぐすり": "مُخَدِّر",
 "ねむりこむ": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "ねむりにおちる": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "ねむりにつく": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "ねむりひめ": "الْجَمِيلَة الْنَائِمَة",
 "ねむりびょう": "التهاب الدماغ السباتي, مرض النوم (التهاب دماغ كان وبائياً بين عامي 1915 و1926؛ تشمل الأعراض شلل عضلة العين…)",
 "ねむる": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "ねむれる": "نوم (توقف الوعي وانخفاض معدل الأيض)",
 "ねむれるもりのびじょ": "الْجَمِيلَة الْنَائِمَة",
 "ねめた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "ねもころ": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر. / أَلِيف, وَدُود (ذو مصالح أو مودة مشتركة؛ على صداقة راسخة)",
 "ねもと": "قَاعِدَة / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "ねもの": "خضراوات جذرية (أي من الجذور أو الدرنات الصالحة للأكل اللحمية المختلفة تحت الأرض)",
 "ねものがたり": "حديث الوسادة (محادثة حميمة بين العشاق (تحدث عادة في السرير)) / قِصَّةٌ قَبْلَ النَوْمِ",
 "ねもはもない": "لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "ねや": "مَخْدَع, غُرْفَةُ نَوْم / رأس السهم, نصل (الرأس المدبب أو الطرف الضارب للسهم)",
 "ねやごと": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "ねやす": "رَخِيص",
 "ねらい": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "ねらいうち": "رِمَايَة",
 "ねらいどころ": "دَرِيئَة, نِيشَان\nمثال: لقد أخطأ الهدف.",
 "ねらいめ": "دَرِيئَة, نِيشَان\nمثال: لقد أخطأ الهدف.",
 "ねらい撃ち": "رِمَايَة",
 "ねらい目": "دَرِيئَة, نِيشَان\nمثال: لقد أخطأ الهدف.",
 "ねり": "اِعْتِجَان / أَلْصَقَ",
 "ねりあげる": "بُولَنْدِيّ",
 "ねりあるく": "اِسْتِعْرَاض, مَوْكِب",
 "ねりかえす": "ريمكس, ريميكس",
 "ねりこ": "عَجِين, عَجِينَة",
 "ねりこう": "قرص طبي محلى",
 "ねりつち": "أَلْصَقَ",
 "ねりなおす": "تنقيح, مراجعة (فعل إعادة كتابة شيء ما)",
 "ねりはみがき": "مَعْجُون الأَسْنَان",
 "ねりもの": "تقدم, زحف (فعل التحرك للأمام (نحو هدف))\nمثال: كانت المواكب محظورة",
 "ねり粉": "عَجِين, عَجِينَة",
 "ねる": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة. / اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة)\nمثال: استلقى على السرير. / خَمَرَ (شَرَابُ الْعِنَبِ إِذَا اخْتَمَرَ؛ كُلُّ مُسْكِرٍ مُخَامِرٍ لِلْعَقْلِ، إِذَا…)\nمثال: أنت تشرب الخمر. / عَجَنَ, دَلَكَ (عَجَنْتُ، أَعْجُنُ، اُعْجُنْ، مصدر عَجْنٌ، عجن فلان الدقيق، أي خلطه بالماء و…)\nمثال: واصل زيري العجن. / بُولَنْدِيّ / ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو…)\nمثال: للبقرة ذيل طويل. / بَرِيق / حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه / اِسْتِعْرَاض, مَوْكِب",
 "ねるじかん": "وقت النوم (الوقت الذي تذهب فيه إلى الفراش)",
 "ねるほどらくはなかりけり": "هُنَاكَ, يُوجَدُ",
 "ねわすれる": "اِسْتَغْرَقَ فِي النَّوْم",
 "ねわら": "مِحَفَّة",
 "ねをあげる": "تَنَازَلَ",
 "ねをはる": "هَدَأَ\nمثال: استقر زيري في خيمته.",
 "ねをもどす": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته",
 "ねん": "حَاسَّة\nمثال: لديهم حس الفكاهة. / رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي)\nمثال: يمكن لتوم البقاء إن رغب. / اِهْتِمَام, اِنْتِبَاه / صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎.",
 "ねんいり": "حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك.",
 "ねんいれ": "اِهْتِمَام",
 "ねんえき": "مُخَاط, نُخَاعَة",
 "ねんえきさいきん": "بكتيريا مخاطية, ميكسوبكتيريا (بكتيريا تشكل مستعمرات في مادة لزجة تنتجها ذاتياً؛ تعيش في التربة الرطبة أو…)",
 "ねんえきさん": "حمض الميوسيك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في…)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "ねんえきしゅ": "ورم مخاطي (ورم حميد في النسيج الضام يحتوي على مادة تشبه الهلام)",
 "ねんえきすいしゅ": "وذمة مخاطية (قصور الغدة الدرقية يتميز بجفاف الجلد وتورمات حول الشفتين والأنف بالإضافة إلى…)",
 "ねんおし": "منبه للذاكرة, مُذكّر (تجربة تجعلك تتذكر شيئاً ما)\nمثال: تجاهل تذكيرات زوجته",
 "ねんかい": "مُؤْتَمَر",
 "ねんかつ": "دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة)",
 "ねんかん": "كتاب سنوي (كتاب مرجعي ينشر بانتظام مرة كل عام) / صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎.",
 "ねんかんけいかく": "حولي, سنوي (يكمل دورة حياته في غضون عام)\nمثال: حدود من النباتات المزهرة الحولية",
 "ねんが": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ねんがじょう": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ねんがた": "نَمُوذَج",
 "ねんがっぴ": "تَمْرَة, تَمْر\nمثال: ما تاريخ اليوم؟",
 "ねんがはがき": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ねんがゆうびん": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ねんがらねんじゅう": "على مدار الوقت (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "ねんき": "تدريب مهني, تلمذة مهنية (منصب المتدرب المهني) / حولي, سنوي (يكمل دورة حياته في غضون عام)\nمثال: حدود من النباتات المزهرة الحولية / صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎. / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في…)\nمثال: جون في عمر أخي.",
 "ねんきぼうこう": "تدريب مهني, تلمذة مهنية (منصب المتدرب المهني)",
 "ねんきもの": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "ねんきん": "دخل سنوي, دفعات سنوية (دخل من الاستثمار الرأسمالي يُدفع في سلسلة من المدفوعات المنتظمة)\nمثال: تم إنشاء صندوق تقاعده ليُدفع كدخل سنوي / عفن غروي حقيقي, ميكسوميسيت (عفن غروي من طائفة الميكسوميسيت)",
 "ねんきんがく": "دخل سنوي, دفعات سنوية (دخل من الاستثمار الرأسمالي يُدفع في سلسلة من المدفوعات المنتظمة)\nمثال: تم إنشاء صندوق تقاعده ليُدفع كدخل سنوي",
 "ねんきんききん": "صندوق تقاعد, صندوق معاشات (مؤسسة مالية تجمع مساهمات منتظمة من أصحاب العمل لتوفير دخل التقاعد للموظفين)",
 "ねんきんじゅきゅうしゃ": "مُتَقَاعِد",
 "ねんきんせいかつ": "مَعَاش",
 "ねんきんせいかつしゃ": "مُتَقَاعِد",
 "ねんきんほけんりょう": "قسط التأمين (الدفع مقابل التأمين)",
 "ねんぐ": "ضريبة الأراضي, ضريبة الأملاك (ضريبة رأسمالية تفرضها البلديات على الممتلكات؛ وتعتمد على القيمة المقدرة للعقار)",
 "ねんけつ": "كَعْكَة (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز…)\nمثال: خبزت كعكة لتوم.",
 "ねんけつざい": "رابط, موثق (شيء يستخدم للربط أو التوثيق)",
 "ねんげみしょう": "صَرِيح, مُبَاشِر (صريح ومباشر بلا تحفظ أو مواربة)\nمثال: أخذني جانباً لحديث من القلب للقلب",
 "ねんげん": "اِصْطِلَاح, مُصْطَلَح",
 "ねんごろ": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر. / أَلِيف, وَدُود (ذو مصالح أو مودة مشتركة؛ على صداقة راسخة)",
 "ねんさい": "عِيد سَنَوِيّ",
 "ねんざ": "اِلْتِوَاء",
 "ねんし": "السَّنَة الْجَدِيدَة / أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة) / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في…)\nمثال: جون في عمر أخي.",
 "ねんしぎ": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ねんしじょう": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ねんしつ": "لَزِج",
 "ねんしまわり": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ねんしゅうしさ": "تزيح سنوي, تزيح شمسي المركز (تزيح جرم سماوي باستخدام نقطتين في مدار الأرض حول الشمس كخط أساس)",
 "ねんしゅつ": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / إسهاب, بلورة (التطوير بتفاصيل معقدة ومضنية)",
