 "にえき": "ثُنَائِيّ, مِن جُزْأَيْن (يتضمن جزأين أو عنصرين)",
 "にえきらない": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "にえくりかえる": "دُمَّل, خُرَاج / غَلَيَان, غَلْي / غَلَّى",
 "にえたぎる": "دُمَّل, خُرَاج / غَلَيَان, غَلْي / غَلَّى",
 "にえたつ": "دُمَّل, خُرَاج / غَلَيَان, غَلْي / غَلَّى / هَاجَ, غَلَى",
 "にえゆ": "ماء مغلي (ماء تم تسخينه إلى درجة الغليان أو تجاوزها)\nمثال: هناك غلاية ماء مغلي على الموقد",
 "にえんか": "ثنائي كلوريد (مركب يحتوي على ذرتين من الكلور في كل جزيء)",
 "にえんきさん": "حمض ثنائي القاعدية (حمض يحتوي على ذرتين هيدروجين قابلتين للاستبدال في كل جزيء)",
 "にお": "غطاس صغير (غطاس أوروبي صغير)",
 "におい": "رَائِحَة, رِيحة (الخاصية التي تمتلكها بعض المركبات الكيميائية المتطايرة في الهواء على الأرجح بتركيز منخفض جدًا…) / شَمّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / اِشْتَمَّ (اجتذب الرائحة، قَرَبَّ الشيء أو اقترب منه ليشمه) / شم ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّمَ\nمثال: شم تلك الرائحة. / جَوّ, هَالَة (صفة مميزة ولكن غير ملموسة تحيط بشخص أو شيء) / إكليل, نطاق (مؤشر لضوء مشع يُرسم حول رأس قديس) / أورة, نسمة (إحساس (مثل نسيم بارد أو ضوء ساطع) يسبق بداية اضطرابات معينة مثل نوبة الصداع النصفي أو نوبة الصرع)\nمثال: جو من الغموض",
 "においがする": "رَائِحَة, رِيحة (الخاصية التي تمتلكها بعض المركبات الكيميائية المتطايرة في الهواء على الأرجح بتركيز منخفض جدًا…) / شَمّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / اِشْتَمَّ (اجتذب الرائحة، قَرَبَّ الشيء أو اقترب منه ليشمه) / شم ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّمَ\nمثال: شم تلك الرائحة.",
 "においけし": "مُزِيل اَلْعَرَق, مُزِيل اَلرَّائِحَة",
 "においざくら": "شجرة الكرز, كرز (أي من العديد من الأشجار والشجيرات التي تنتج فاكهة مستديرة لحمية صغيرة بنواة صلبة واحدة؛ ينتج الكثير منها أيضاً خشباً صلباً قيماً)",
 "においしょうぶ": "وَجّ, ذَرِيرَة",
 "においすみれ": "بنفسج الحديقة, بنفسج عطري (بنفسج أوروبي يتميز عادة بزهور أرجوانية إلى بيضاء؛ متوطن على نطاق واسع)",
 "において": "صَوْب, ناحية (أحد جانبي المدينة التي يقسمها نهر، ومن ذلك صوب الكرخ وصوب الرصافة في بغداد؛ نُزول المَطَر)\nمثال: صوب الرجل مسدسا نحو المحققين. / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: جون في عمر أخي. / بِٱسْمِ",
 "においねずみ": "فَأْرُ المِسْك",
 "においぶくろ": "كيس عطر, وسادة معطرة (كيس ناعم صغير يحتوي على مسحوق معطر؛ يستخدم لتعطير الأشياء في الدرج أو الصندوق)",
 "においやか": "عَبِق, فَوَّاح (ذُو عُطْرٍ طَبِيعِيٍّ)",
 "におい菖蒲": "وَجّ, ذَرِيرَة",
 "におう": "رَائِحَة, رِيحة (الخاصية التي تمتلكها بعض المركبات الكيميائية المتطايرة في الهواء على الأرجح بتركيز منخفض جدًا…) / شَمّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّ ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / اِشْتَمَّ (اجتذب الرائحة، قَرَبَّ الشيء أو اقترب منه ليشمه) / شم ((شَمَّ) البناءُ أو الجبلُ يَشُمُّ شَمَمًا: ارتفَعَ أعلاهُ؛ (شَمَّ) الأنفُ: ارتفعت قَصَبَتُهُ قليلاً في استواء) / شَمَّمَ\nمثال: شم تلك الرائحة. / نَتُنَ, نَتِنَ / أَشَعَّ ((أَشَعَّتِ) الشمسُ: نَشَرَتْ شْعاعها؛ أَشَعَّتِ النارُ: أَرسلت ضوءها وحرارتها)\nمثال: أشع الإسبرانتو!",
 "におくり": "إرسالية, شحنة (تسليم البضائع للبيع أو التصرف فيها) / إيداع (الفعل الرسمي لإرسال شخص للحبس (كما في سجن أو مستشفى للأمراض العقلية)) / بضاعة منقولة, حمولة (بضائع تحملها مركبة كبيرة)",
 "におくりにん": "المرسل, مرسل البضاعة (الشخص الذي يسلم أو يرسل البضائع)",
 "における": "فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: جون في عمر أخي.",
 "におどり": "غطاس صغير (غطاس أوروبي صغير)",
 "におやか": "عَبِق, فَوَّاح (ذُو عُطْرٍ طَبِيعِيٍّ)",
 "におろし": "تفريغ (عمل إخراج حمولة من شيء ما من مركبة أو سفينة أو حاوية، إلخ)",
 "におわす": "أَرِيج, عَبِير / عَطَّرَ (جعل شيئًا مُعَطَّرًا بإضافة العطر إليه؛ أضفى على شيء أو مكان شعورًا جميلًا أو انطباعًا مميزًا)\nمثال: هذا العطر يجعلني أشعر بالمرض. / اِقْتَرَحَ, أَوْصَى (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ)\nمثال: اقترح سامي المساعدة.",
 "におわせる": "أَرِيج, عَبِير / عَطَّرَ (جعل شيئًا مُعَطَّرًا بإضافة العطر إليه؛ أضفى على شيء أو مكان شعورًا جميلًا أو انطباعًا مميزًا)\nمثال: هذا العطر يجعلني أشعر بالمرض. / اِقْتَرَحَ, أَوْصَى (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ)\nمثال: اقترح سامي المساعدة.",
 "にか": "ثنائي التكافؤ (لديه تكافؤ اثنين أو لديه تكافؤين)",
 "にかい": "مَرَّتَيْن, مرتين / أعلى الدرج, في الطابق العلوي (في طابق أعلى) / عقلياً, في الرأس (فيما يتعلق بالعقل) / علوي (طابق) (في أو من الطوابق العليا لمبنى) / طابق علوي (جزء المبنى الذي يقع فوق الطابق الأرضي)\nمثال: عاشوا في الطابق العلوي",
 "にかいせい": "طالب سنة ثانية (طالب جامعي في السنة الثانية)",
 "にかいだてバス": "حافلة بطابقين, حافلة ذات طابقين (وسيلة نَقْل للركاب)\nمثال: لنذهب بالحافلة.",
 "にかぎって": "بشكل خاص, تحديداً (بدرجة أكبر بوضوح مما هو شائع) / بِتَمَيُّز, بِشَكْل خَاصّ (بشكل فريد أو مميز) / تَحْدِيدًا, عَلَى وَجْه الخُصُوص (مميز بشكل خاص عن الآخرين)\nمثال: كان دقيقاً بشكل خاص حول التهجئة",
 "にかく": "ثُنَائِيّ النَّوَاة (لديه نواتان)",
 "にかけて": "حَتَّى, إِلَى أَنّ (يفيد انتهاء الغاية؛ يفيد الغاية) / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: انتظر حتى أجلس. / فِي مَا يَتَعَلَق بِـ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "にかけては": "فِي مَا يَتَعَلَق بِـ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "にかこくご": "ثُنَائِي اَللُّغَة",
 "にかた": "طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر.",
 "にかっと": "بشكل واسع, بمعنى واسع (دون النظر إلى تفاصيل محددة أو استثناءات) / بشكل عريض (بطريقة واسعة)\nمثال: يفسر القانون بشكل واسع",
 "にかねん": "ثنائي الحول, سنتوي (له دورة حياة تستمر لموسمين) / كُلَّ سَنَتَيْنِ (يحدث كل سنتين) / نبات ثنائي الحول ((علم النبات) نبات تستغرق دورة حياته عادة موسمين من الإنبات حتى الموت؛ عادة ما تزهر وتثمر النباتات ثنائية الحول في الموسم الثاني)\nمثال: دورة حياة ثنائية الحول",
 "にかわしつ": "غرواني, مادة غروية (خليط له خصائص بين المحلول والمعلق الدقيق)",
 "にかわって": "بَدَلًا مِن / بِاسْم, بِالنِّيَابَة عَن",
 "にかわづけ": "غِرَاء, لِزَاق / لَصَّقَ",
 "にかわり": "بَدَلًا مِن / بِاسْم, بِالنِّيَابَة عَن",
 "にかんし": "ذو صلة, متعلق بـ (متصل منطقياً أو سببياً أو بخصائص مشتركة)\nمثال: الرسم والفنون ذات الصلة",
 "にかんするかぎり": "حَتَّى الْآنَ (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "にがい": "مُرّ (فَاتَ ومَضَى؛ الحدثُ أو الأمرُ: حدث وانتهى) / أَلِيم / مَقِيت, مَمْقُوت (مَقيت: ( اسم )؛ مُقِيت: ( اسم ))\nمثال: مر زيري بجانبي. / حَامِض",
 "にがうり": "قَاوُون",
 "にがお": "صُورَة / بُورْتْرِيَّة",
 "にがおえ": "صُورَة / بُورْتْرِيَّة",
 "にがおがき": "رسام بورتريه, مصور وجوه (رسام أو راسم للصور الشخصية (البورتريه))",
 "にがさ": "مَرَارَة",
 "にがさみ": "إغراق, تخمة (صفة الوفرة المفرطة لدرجة انخفاض الأسعار)",
 "にがしお": "واق (بلشون صغير نسبياً مدمج الجسم بني أسمر ذو عادات ليلية وصرخة مدوية؛ يوجد في المستنقعات)",
 "にがしべん": "صمام أمان, صمام تنفيس (صمام في حاوية يمكن أن يتراكم فيها الضغط (مثل غلاية البخار)؛ يفتح تلقائياً عندما يصل الضغط إلى مستوى خطير)",
 "にがす": "حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: هو,البارحة حرر من الحبس. / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "にがたけ": "خيزران الخشب العملاق, ماداكي (خيزران كبير له سيقان سميكة الجدران؛ موطنه الصين وربما اليابان؛ يُزرع على نطاق واسع في أماكن أخرى)",
 "にがたとうにょうびょう": "السكري غير المعتمد على الأنسولين, السكري من النوع الثاني (شكل خفيف من داء السكري يتطور تدريجيًا لدى البالغين؛ يمكن أن يحدث بسبب السمنة أو الإجهاد الشديد أو انقطاع الطمث أو عوامل أخرى؛ يمكن السيطرة عليه عادة…)",
 "にがっぽい": "لَاذِع, مَائِلٌ لِلمَرَارَة (مُرٌّ بَعْضَ الشَّيْء)",
 "にがつ": "فِبْرَايِر, شُبَاط (الشهر الثاني في السنة الميلادية الروميّة)\nمثال: سأكون قد درست الإنجليزية لخمس سنوات مع حلول فبراير المقبل.",
 "にがつじん": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "にがて": "فَقِير / مِسْكِين / فُقَرَاء",
 "にがにがしい": "بغيض, غير سار (مسيء أو غير مقبول؛ يسبب عدم الراحة أو التعاسة)\nمثال: شخصية بغيضة",
 "にがみ": "مَرَارَة",
 "にがみばしった": "رُجُولِيّ",
 "にがむしをかみつぶしたよう": "حَامِض",
 "にがよもぎ": "حَبَق اَلرَّاعِيّ (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في النّاس : حَبَقَ يحبِق حبْقاً وحَبِقاً وحُباقاً؛ الحَبْق : ضُراط المَعِز ، وقد تستعمل في النّاس)",
 "にがり": "واق (بلشون صغير نسبياً مدمج الجسم بني أسمر ذو عادات ليلية وصرخة مدوية؛ يوجد في المستنقعات)",
 "にがりきる": "عُبُوس / عَبَسَ",
 "にがる": "عُبُوس / عَبَسَ",
 "にがわせ": "حوالة مالية, سفتجة (وثيقة تأمر بدفع المال؛ يسحبها شخص أو بنك على آخر)",
 "にきびあと": "أثر بثرة, ندبة جدري (ندبة أو حفرة على الجلد تتركها بثرة جدري أو حب شباب أو مرض طفح جلدي آخر)",
 "にきび痕": "أثر بثرة, ندبة جدري (ندبة أو حفرة على الجلد تتركها بثرة جدري أو حب شباب أو مرض طفح جلدي آخر)",
 "にきび跡": "أثر بثرة, ندبة جدري (ندبة أو حفرة على الجلد تتركها بثرة جدري أو حب شباب أو مرض طفح جلدي آخر)",
 "にきゅう": "بالدرجة الثانية (بواسطة وسائل نقل الدرجة الثانية) / درجة ثانية, درجة سياحية (فئة من أماكن الإقامة على متن سفينة أو قطار أو طائرة أقل تكلفة من أماكن الدرجة الأولى) / درجة ثانية (ليس أعلى جودة في التصنيف) / درجة ثانية (ليست أعلى رتبة في التصنيف)\nمثال: سافرنا بالدرجة الثانية",
 "にきょくしんくうかん": "صِمَام ثُنَائِيّ, ثَنَائِي دِيُود (الصِّمَامُ : السِّدَادُ؛ الصِّمام : جهاز لضبط السوائل والغازات في أَوعيتها وتنظيم انسيابها في اتِّجاه دون آخر)\nمثال: فتح سامر صمام المياه.",
 "にきょくぶんか": "استقطاب (الظاهرة التي يتم فيها تقييد اتجاه اهتزاز موجات الضوء أو غيرها من الإشعاعات) / استقطاب (حالة امتلاك أو إعطاء قطبية)",
 "にぎあう": "ازدهر",
 "にぎてき": "ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة الأُُولى)\nمثال: ثانوية زيري ضخمة.",
 "にぎにぎ": "اعتصار, عصر (فعل الإمساك والضغط بقوة)\nمثال: عصر خدها بمرح / أُونِيجِيرِي / رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "にぎにぎしい": "دَجِر",
 "にぎやか": "حَافِل بِالنَّشَاط, صَاخِب (مليء بالنشاط الحيويّ والصاخب) / دَجِر",
 "にぎやかさ": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل.",
 "にぎり": "جَشِع, حَرِيص (شديد الرغبة بشكل مفرط في اكتساب الثروة وغيرها) / إمساك, قبض (فعل الإمساك بشيء بإحكام باليدين) / محاولة الفهم (الفهم بصعوبة)\nمثال: كانت المحاضرة تتجاوز أقصى محاولاته للفهم / حَفْنَة / مِقْبَض / أُونِيجِيرِي",
 "にぎりぎんたま": "بطالة, تسكع (عدم القيام بعمل أو وظيفة)",
 "にぎりこぶし": "قبضة (يد مضمومة الأصابع في راحة اليد (كما في حالة الضرب))",
 "にぎりこむ": "مَقْبِض",
 "にぎりつぶし": "تجميع, تصنيف (نظام لتصنيف الأشياء إلى مجموعات) / خنق (فعل خنق (شخص ما) عن طريق الضغط على القصبة الهوائية)\nمثال: لا يوجد دليل على أن الخنق تم بواسطة المتهم",
 "にぎりつぶす": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا) / جَدْوَل",
 "にぎりて": "بَخِيل, بَخِيلَة (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ؛ شَحِيْح، مُقْتِر)\nمثال: بئس الرجل البخيل. / مِقْبَض",
 "にぎりばさみ": "جلم, مقص كبير (مقص كبير بشفرات قوية)",
