 "のこり": "بَقِيَّة",
 "のこりおおい": "آسف, نادم (الشعور بـأو التعبير عن الأسف أو الحزن أو الشعور بالخسارة لشيء تم فعله أو تركه)\nمثال: شعر بالندم على شبابه الضائع",
 "のこりおしい": "مُؤْسِف, يُؤْسَفُ لَهُ (يَسْتَحِقُّ الأَسَفَ أَوِ النَّدَمَ)",
 "のこりかす": "باقي, بقية (شيء متبقٍ بعد إزالة أجزاء أخرى) / بقية, ثمالة (المادة التي تتبقى بعد إزالة شيء ما)\nمثال: لم يكن هناك بقية",
 "のこりび": "جَمْرَة",
 "のこりもの": "الْبَقَايَا",
 "のこりものにはふくがある": "هُنَاكَ, يُوجَدُ",
 "のこりものにふくあり": "هُنَاكَ, يُوجَدُ",
 "のこりものにふくがある": "هُنَاكَ, يُوجَدُ",
 "のこりカス": "باقي, بقية (شيء متبقٍ بعد إزالة أجزاء أخرى) / بقية, ثمالة (المادة التي تتبقى بعد إزالة شيء ما)\nمثال: لم يكن هناك بقية",
 "のこる": "بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة كونه واجبَ الوجود لذاته ، فهو الأوّل بلا ابتداء ، والآخر بلا انتهاء؛ الباقي الثابتُ بعد غيره) / بَقِيَ, مَكَثَ (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: الباقي ليس مهم.",
 "のこんの": "فَائِض, مُتَبَقٍّ (لم يُسْتَهْلَك بعد)",
 "のざらし": "مُتَجَعِّد مِنَ الطَّقْس (اسمرّ وخشن جلده من التعرض للعوامل الجوية في الهواء الطلق) / مُتَآكِلٌ بِالعَوَامِلِ الجَوِّيَّةِ, مُتَجَوٍّ (بَالٍ بِسَبَبِ التَّعَرُّضِ لِلْعَوَامِلِ الجَوِّيَّةِ)",
 "のざわな": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "のし": "تَمَدُّد, مط (عملية التوسع عن طريق الإطالة أو التوسيع) / إطالة, تمدد (تمرين مصمم لمد الأطراف والعضلات إلى أقصى حد لها) / سباحة جانبية (طريقة سباحة تتحرك فيها الذراعان للأمام والخلف بينما تقوم الساقان بركلة المقص) / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "のしあがる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "のしあげる": "رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء وفتحها): عوَّذَه؛ يقال: باسم الله أَرقِيك واللهُ يَشفيك) / رَوَّجَ (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ)",
 "のしあるく": "تَبَخْتَر",
 "のしいた": "لوح العجن, لوح المعجنات (لوح خشبي كبير يستخدم لعجن العجين)",
 "のしがみ": "وَرَق تَغْلِيف (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "のしだい": "لوح العجن, لوح المعجنات (لوح خشبي كبير يستخدم لعجن العجين)",
 "のしのし": "تجارة الأخشاب, قطع الأخشاب (تجارة قطع أو تجهيز أو بيع الأخشاب) / بَطيء, ثَقيل الحَرَكَة (بَطيء ومُتَثاقِل بِسَبَب الوَزْن)",
 "のしのしとあるく": "خَشَب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "のしのしと歩く": "خَشَب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "のしぶくろ": "كيس, كيس ورقي (كيس مصنوع من الورق أو البلاستيك لحمل مشتريات الزبائن)",
 "のしぼう": "مِرْقَاق, فَرَّادَة",
 "のしめこくが": "دقيق الذرة (ذرة مطحونة بشكل خشن)",
 "のしめまだらめいが": "دقيق الذرة (ذرة مطحونة بشكل خشن)",
 "のし上がる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "のし上げる": "رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء وفتحها): عوَّذَه؛ يقال: باسم الله أَرقِيك واللهُ يَشفيك) / رَوَّجَ (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ)",
 "のし板": "لوح العجن, لوح المعجنات (لوح خشبي كبير يستخدم لعجن العجين)",
 "のし棒": "مِرْقَاق, فَرَّادَة",
 "のし歩く": "تَبَخْتَر",
 "のし紙": "وَرَق تَغْلِيف (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "のし袋": "كيس, كيس ورقي (كيس مصنوع من الورق أو البلاستيك لحمل مشتريات الزبائن)",
 "のじうんどう": "زِيكْزَاكِيّ, مُتَعَرِّج (ذو منعطفات حادة وقصيرة أو زوايا متتالية)",
 "のじゅく": "تَخْيِيم",
 "のじゅくしゃ": "بِلا مَأْوَى, مُشَرَّد (شخص سيء الحظ بدون سكن)\nمثال: عُثر على مشرد مقتولاً في سنترال بارك",
 "のす": "تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا. / نَشَرَ, وَزَّعَ (وزّع بشكل منهجي أو استراتيجي (مثل القوات أو المنتجات)) / إطلاق, طرح (عملية التوزيع الرسمي لمنتج أو خدمة جديدة للجمهور) / أطلق, طرح (توزيع منتج أو خدمة جديدة رسمياً للجمهور)\nمثال: تنشر الولايات المتحدة أسلحتها في الشرق الأوسط / صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "のせいで": "بِسَبَب, بِحُكْم",
 "のせこみ": "تحميل (عمل وضع حمولة من شيء ما على أو في مركبة أو سفينة أو حاوية، إلخ) / بضاعة منقولة, حمولة (بضائع تحملها مركبة كبيرة) / حمل, عبء (وزن يجب تحمله أو نقله) / حمل, حمولة (كمية يمكن معالجتها أو نقلها في وقت واحد)\nمثال: استغرق التحميل ساعتين / حَمّل (رَفَعَ، أَقَلَّ) / تَحْمٍيْل\nمثال: حمل سامي سلاحه.",
 "のせる": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود. / حِمْل (رَفَعَ، أَقَلَّ) / عَبَّأَ, شَحَنَ\nمثال: حمل سامي سلاحه. / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة. / نَشَرَ, أَصْدَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "のそだち": "غَيْرُ مُتَمَدْرِس (يفتقر إلى التعليم المدرسي)",
 "のそのそ": "بِبُطْء",
 "のそりのそり": "بِبُطْء",
 "のぞいて": "اِسْتَثْنَى (أن يشمل الكُلّ إلا جزء، ولا يكون إلا إذا كان الجزءُ جزءًا من الكل) / إِلَّا, بِاسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / مثال: لا أعرف إلا هذا.",
 "のぞかせる": "البَرْق",
 "のぞき": "اختلاس النظر, تلصص (نظرة سرية) / زقزقة, صوصوة (الصوت الضعيف القصير لطائر صغير)",
 "のぞきあな": "مَنْوَر, كُوَّة",
 "のぞきかがみ": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "のぞきさる": "نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا.",
 "のぞきしゅみ": "تلصص, تلصصية (انحراف يحصل فيه الشخص على إشباع جنسي من رؤية الأعضاء التناسلية للآخرين أو مشاهدة السلوك الجنسي للآخرين)",
 "のぞきま": "مُتَلَصِّص",
 "のぞきまど": "مَنْوَر, كُوَّة",
 "のぞきみ": "اختلاس النظر, تلصص (نظرة سرية)",
 "のぞきみる": "اختلاس النظر, تلصص (نظرة سرية)",
 "のぞきめがね": "ساعة مائية, كليبسيدرا (ساعة تقيس الوقت عن طريق تدفق الماء) / مقياس مستوى الماء (مقياس للإشارة إلى مستوى الماء في خزان أو مرجل أو مستودع) / كوب ماء (كوب لشرب الماء) / زجاج مائي, سيليكات الصوديوم (زجاج لزج يتكون من سيليكات الصوديوم في محلول؛ يستخدم كمادة لاصقة أو طلاء واقي وحفظ البيض)",
 "のぞき眼鏡": "ساعة مائية, كليبسيدرا (ساعة تقيس الوقت عن طريق تدفق الماء) / مقياس مستوى الماء (مقياس للإشارة إلى مستوى الماء في خزان أو مرجل أو مستودع) / كوب ماء (كوب لشرب الماء) / زجاج مائي, سيليكات الصوديوم (زجاج لزج يتكون من سيليكات الصوديوم في محلول؛ يستخدم كمادة لاصقة أو طلاء واقي وحفظ البيض)",
 "のぞき穴": "مَنْوَر, كُوَّة",
 "のぞき窓": "مَنْوَر, كُوَّة",
 "のぞき見": "اختلاس النظر, تلصص (نظرة سرية)",
 "のぞき見る": "اختلاس النظر, تلصص (نظرة سرية)",
 "のぞき趣味": "تلصص, تلصصية (انحراف يحصل فيه الشخص على إشباع جنسي من رؤية الأعضاء التناسلية للآخرين أو مشاهدة السلوك الجنسي للآخرين)",
 "のぞき鏡": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "のぞき魔": "مُتَلَصِّص",
 "のぞく": "نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا. / اِسْتَثْنَى (أن يشمل الكُلّ إلا جزء، ولا يكون إلا إذا كان الجزءُ جزءًا من الكل) / إِلَّا, بِاسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / مثال: لا أعرف إلا هذا. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا. / اختلاس النظر, تلصص (نظرة سرية) / زقزقة, صوصوة (الصوت الضعيف القصير لطائر صغير) / فَحَصَ, اِمْتَحَنَ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض)\nمثال: فحص الطبيب بطني. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "のぞのぞ": "بِبُطْء",
 "のぞましい": "مرغوب فيه, مستحب (يستحق الامتلاك أو السعي إليه أو تحقيقه) / جَدِير, لَائِق (جدير بالاختيار خاصة كشريك زواج)\nمثال: وظيفة مرغوبة",
 "のぞみ": "أُمْنِيَّة / رَغْبَة / مُنْيَة / تَمَنَّى / توقع, احتمال / تَنْقِيْب (نقّب إذا سار في البلاد طلباً للمهرب ، نقّب عن الأخبار وغيرها:بحث عنها،هو البحث عن كلّ شيء والتّفتيش مطلقاً؛ نقّب مبالغة في نَقَب ، نقّب عن الشيء :فحص عنه فحصاً بليغاً) / تَحَدٍّ, التَّحَدِّي",
 "のぞみうす": "مِنْ غَيْرِ المُرَجَّحِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "のぞむ": "رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب. / تَوَقَّعَ / رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا. / صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً؛ ويُعَدَّى فَيُقَالُ: حَضَرَه وحَضِرَه؛ حَضَرَ، كنَصَرَ وعلِمَ، حُضُورًا وحضارَةً: ضِدُّ غابَ)\nمثال: حضر كل شيئ لرحلتي.",
 "のぞむらくは": "لَيْتَ, تَمَنَّى (يفيد التمني)\nمثال: ليت بحاجة لتعمل ساعات إضافية.",
 "のたうつ": "تلوّي, تململ (عملية التلوّي أو التململ)",
 "のたくる": "تلوّي, تململ (عملية التلوّي أو التململ) / خربشة, شخبطة (كتابة يدوية رديئة)",
 "のたのた": "بشكل غير منتج, بلا جدوى (بطريقة غير منتجة) / بِبُطْء",
 "のたまう": "قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "のたもう": "قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "のたり": "على مهل, في وقت الفراغ (بطريقة غير متسرعة أو في الوقت المناسب) / مُسْتَرْسِل, هَادِئ (غير مُتعجّل ولا قسريّ)\nمثال: اقرأ الدليل في وقت فراغك",
 "のたりのたり": "بِبُطْء",
 "のち": "فِيمَا بَعْد, بعدين / لَاحِقًا / فِيمَا بَعْد, فِيمَا بَعْدُ / مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل / سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "のちざん": "مَشِيمَة, خَلَاص (محلُّ الولد تخرج معهُ عند الولادة. ومنهُ قولهم ليس بمفطومٍ عن شيمة مفطورٌ عليها في المشيمة أي أن من كان مخلوقًا على طبيعةٍ وهو في بطن أمهِ لا ينقطع…)",
 "のちじて": "بَطَل, بَطَلَة / مُتَصَدِّر",
 "のちに": "بعد ذلك, فيما بعد (يحدث في وقت لاحق لوقت مرجعي)\nمثال: اعتذر لاحقاً",
 "のちになって": "أَخِير, بَعْدَ ذٰلِك",
 "のちのち": "مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل",
 "のちのよ": "الأجيال القادمة, الخَلَف (جميع الأجيال المستقبلية) / أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا",
 "のちほど": "بعد ذلك, فيما بعد (يحدث في وقت لاحق لوقت مرجعي)\nمثال: اعتذر لاحقاً",
 "のぢさ": "خَسّ النَّعْجَة, خَسّ الضَأْن (خَسَّ الرجُلُ يَخِسُّ خِسَّةً، وخَسَاسَةً: حَقُرَ؛ يقال: خَسَّ فِعْلُهُ وقولُه ورأْيُه)\nمثال: بيع المنزل بثمن بخس.",
 "のぢしゃ": "خَسّ النَّعْجَة, خَسّ الضَأْن (خَسَّ الرجُلُ يَخِسُّ خِسَّةً، وخَسَاسَةً: حَقُرَ؛ يقال: خَسَّ فِعْلُهُ وقولُه ورأْيُه)\nمثال: بيع المنزل بثمن بخس.",
 "のっかかる": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "のっかる": "رَكِبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا من الدواب)\nمثال: ركب ياني سفينة.",
 "のっきる": "هَزَمَ, غَلَبَ",
 "のっける": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود.",
 "のっしのっし": "تجارة الأخشاب, قطع الأخشاب (تجارة قطع أو تجهيز أو بيع الأخشاب) / بَطيء, ثَقيل الحَرَكَة (بَطيء ومُتَثاقِل بِسَبَب الوَزْن)",
 "のっしのっしとあるく": "خَشَب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "のっしのっしと歩く": "خَشَب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "のっそり": "ببطء, بكسل (بطريقة بطيئة)\nمثال: تصاعد الدخان ببطء / ببلادة, بفتور (بطريقة بليدة)\nمثال: قال 'لا' ببلادة",
 "のっと": "فَجْأَةً",
 "のっとり": "استحواذ (تغيير في مصلحة السيطرة على شركة عن طريق البيع أو الاندماج) / اِنْقِلَاب, اِنْقِلَاب عَسْكَرِيّ (تغيير مفاجئ وحاسم للحكومة بشكل غير قانوني أو بالقوة) / اِخْتِطَاف",
 "のっとりじけん": "اِخْتِطَاف",
 "のっとりはんにん": "قاطع طريق (شخص يوقف مركبة ويسرق منها) / خاطف الطائرة (شخص يستخدم القوة للاستيلاء على مركبة (خاصة طائرة) للوصول إلى وجهة بديلة)",
 "のっとる": "أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / أَسَرَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة. / خَطَفَ (كلمة \"خَطِفَ\" تعني سرق أو أخذ بسرعة و فجأة. يُمكن استخدامها بمعنى \"خَطَفَ الشيءَ\" أي سرقه؛ يدل على سرعةٍ وفجائيةٍ في الأثر، سواء كان ذلك على العقل أو البصر أو حتى على قدرة الاستماع) / إِخْتِطَاف / تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "のっぴき": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "のっぴきならない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "のっぴきならぬ": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "のっぺらぼう": "سَاكِن, مُسْتَقِرّ (لا يُظهر تغيّرًا يُذكر إن وُجد) / ثَابِت, مُطَّرِد (يَلْتَزِمُ بِالمَبَادِئِ أَوِ المَسَارِ ذَاتِهِ عَبْرَ الزَّمَنِ)",
 "のっぺらぼー": "سَاكِن, مُسْتَقِرّ (لا يُظهر تغيّرًا يُذكر إن وُجد) / ثَابِت, مُطَّرِد (يَلْتَزِمُ بِالمَبَادِئِ أَوِ المَسَارِ ذَاتِهِ عَبْرَ الزَّمَنِ)",
 "のっぺらぽう": "سَاكِن, مُسْتَقِرّ (لا يُظهر تغيّرًا يُذكر إن وُجد) / ثَابِت, مُطَّرِد (يَلْتَزِمُ بِالمَبَادِئِ أَوِ المَسَارِ ذَاتِهِ عَبْرَ الزَّمَنِ)",
 "のっぺら坊": "سَاكِن, مُسْتَقِرّ (لا يُظهر تغيّرًا يُذكر إن وُجد) / ثَابِت, مُطَّرِد (يَلْتَزِمُ بِالمَبَادِئِ أَوِ المَسَارِ ذَاتِهِ عَبْرَ الزَّمَنِ)",
 "のっぺり": "بِلَا مَعَالِم (يفتقر إلى سمات أو خصائص مميّزة) / مُسَطَّح",
 "のっぽ": "عَمُود مِصْبَاح, عَمُود إِنَارَة / طَوِيل وَنَحِيف, فَارِع وَنَحِيل (طَوِيل القَامَة وَنَحِيف الجِسْم) / فَارِع, نَحِيل طَوِيل (طويل ونحيف ذو أطراف طويلة رفيعة)",
 "のづら": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "のてん": "خلاء, عراء (حيث يكون الهواء غير محصور)\nمثال: أراد الخروج للهواء الطلق قليلاً",
 "ので": "لِأَنَّ / هكذا, بلا سبب / إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "のとなれやまとなれ": "لَا يَهُمُّنِي (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "のど": "حَلْق, حُلْقُوم (أصاب حَلْقه أو ضربه في حلقه؛ أزال شعر رأسه أو ذقنه كله بالمُوسَى)\nمثال: حلق زيري لحيته. / صوت غنائي (الجودة الموسيقية للصوت أثناء الغناء) / مِزْراب (قناة صرف لمياه الأمطار والثلوج؛ نظام يحدّ من جريان المياه على الأسطح الخارجية للمبنى) / رَاكِد, سَاجٍ ((عَنْ جِسْمٍ مَائِيّ) خَالٍ مِنَ الاضْطِرَاب بِسَبَب الأَمْوَاج الكَبِيرَة) / سَاكِن, هَادِئ (غير مضطرب؛ يحافظ على ضبط النفس)",
 "のどあめ": "حلوى الحلق, قرص السعال (قرص طبي يستخدم لتهدئة الحلق)",
 "のどかぜ": "زُكَام",
 "のどくび": "رَقَبَة, عُنُق / نقطة ضعف (صفة غير كافية أو ناقصة)",
 "のどちんこ": "لَهَاة",
 "のどならし": "خَرْخَرَ, هَرْهَرَ / خَرْخَرَة",
 "のどのいたみ": "اِلْتِهَاب حَلْق",
 "のどの痛み": "اِلْتِهَاب حَلْق",
 "のどぶえ": "رُغَامَى, قَصَبَة هَوَائِيَّة",
 "のどぶくろ": "غَبَب, لُغْد",
 "のどぼとけ": "تُفَّاحَة آدَم, حَرْقَدَة",
 "のどもと": "حَلْق, حُلْقُوم (أصاب حَلْقه أو ضربه في حلقه؛ أزال شعر رأسه أو ذقنه كله بالمُوسَى)\nمثال: حلق زيري لحيته.",
 "のどやか": "رَاكِد, سَاجٍ ((عَنْ جِسْمٍ مَائِيّ) خَالٍ مِنَ الاضْطِرَاب بِسَبَب الأَمْوَاج الكَبِيرَة) / سَاكِن, هَادِئ (غير مضطرب؛ يحافظ على ضبط النفس)",
 "のどをならす": "خَرْخَرَ, هَرْهَرَ / خَرْخَرَة",
 "のどを鳴らす": "خَرْخَرَ, هَرْهَرَ / خَرْخَرَة",
 "のど仏": "تُفَّاحَة آدَم, حَرْقَدَة",
 "のど笛": "رُغَامَى, قَصَبَة هَوَائِيَّة",
 "のど袋": "غَبَب, لُغْد",
 "のど風邪": "زُكَام",
 "のど飴": "حلوى الحلق, قرص السعال (قرص طبي يستخدم لتهدئة الحلق)",
 "のど鳴らし": "خَرْخَرَ, هَرْهَرَ / خَرْخَرَة",
 "のに": "رَغْم أَنَّ, مَعَ أَنَّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره. / عِنْدَمَا / لَيْتَ, تَمَنَّى (يفيد التمني)\nمثال: ليت بحاجة لتعمل ساعات إضافية. / لِكَي, لِ",
 "のねずみ": "فأر الحقل (أي فأر ليلي من العالم القديم من جنس أبوديموس يعيش في الغابات والحقول والحدائق) / فأر الحقل, فول (أي من قوارض صغيرة تشبه الفأر من فصيلة القداديات (خاصة من جنس ميكروتوس) ذات جسم ممتلئ قصير الذيل وآذان غير بارزة وتعيش في الحقول أو المروج)",
 "のの": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "ののさま": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "ののしり": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "ののしりことば": "سبة, شتيمة (تعبير دنس أو فاحش عادة للتعبير عن المفاجأة أو الغضب) / حشو, زيادة لفظية (كلمة أو عبارة لا تحمل معنى مستقلاً ولكنها تضاف لإكمال جملة أو سطر شعري)\nمثال: تم حذف الشتائم",
 "ののしり言葉": "سبة, شتيمة (تعبير دنس أو فاحش عادة للتعبير عن المفاجأة أو الغضب) / حشو, زيادة لفظية (كلمة أو عبارة لا تحمل معنى مستقلاً ولكنها تضاف لإكمال جملة أو سطر شعري)\nمثال: تم حذف الشتائم",
 "ののしる": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "ののじ": "عُرْوَة, عُقْدَة",
 "ののはな": "زهرة برية (نبات زهري بري أو غير مزروع)",
 "のの字": "عُرْوَة, عُقْدَة",
 "のはら": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "のばしぼう": "مِرْقَاق, فَرَّادَة",
 "のばし棒": "مِرْقَاق, فَرَّادَة",
 "のばす": "طَوَّلَ, أَطَالَ (قُدرة؛ غنى أو فضل) / طَالَ\nمثال: قاس طول السرير. / اِسْتَقَامَ (أَقَامَ نفسه) / خَفَّفَ (قلل شيئًا أو نقص من حدته؛ هون أو لطف من شدة أمر)\nمثال: خفف زيري السرعة. / أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "のばな": "زهرة برية (نبات زهري بري أو غير مزروع) / جهنمية ملساء, زهرة الورق (كرمة برازيلية تميل للإزهار بشكل مستمر)",
 "のばなし": "مَرْعًى, مَسْرَح",
 "のばら": "غليون الخلنج (غليون مصنوع من جذر شجيرة الخلنج) / خلنج, خلنج شجري (شجيرة متوسطية دائمة الخضرة تشبه الشجرة ذات زهور بيضاء عطرة في عناقيد طرفية كبيرة وجذور خشبية صلبة تستخدم لصنع غليون التبغ) / عشبة الثور, فصة مستديرة الأوراق (كرمة خشبية شائكة جداً في شرق الولايات المتحدة تنمو في كتل متشابكة ولها سيقان مستديرة قوية بأوراق جلدية لامعة وأزهار خضراء صغيرة تليها عناقيد من التوت…) / نسرين, ورد ياقوتي (ورد أوراسي ذو سيقان شائكة وأوراق عطرة وزهور وردية زاهية تليها ثمار قرمزية) / ورد متعدد الأزهار, ورد ياباني (ورد قوي النمو له عناقيد من الزهور الصغيرة العديدة؛ يستخدم للأسيجة وكأصل للتطعيم)",
 "のび": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها. / تَمَدُّد, مط (عملية التوسع عن طريق الإطالة أو التوسيع) / إطالة, تمدد (تمرين مصمم لمد الأطراف والعضلات إلى أقصى حد لها) / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل. / إطالة (عملية تطويل شيء ما) / إطالة, تمديد (إضافة إلى طول شيء ما) / استطالة (صفة كون الشيء مستطيلاً أو ممدوداً)",
 "のびあがる": "تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ",
 "のびしろ": "كَامِن, مُحْتَمَل (موجود في حيز الإمكانية) / مُتَوَقَّع, مُحْتَمَل (يُتوقَّع أن يصبح أو يكون؛ في الأفق) / جهد كهربائي, فرق الجهد (الفرق في الشحنة الكهربائية بين نقطتين في دائرة معبراً عنه بالفولت) / إمكانية, قدرة كامنة (القدرة الكامنة على التحقق في الوجود)\nمثال: مشكلة محتملة",
 "のびちぢみ": "مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته",
 "のびのび": "بارتياح, برغد (في راحة مالية) / بارتياح (براحة نفسية؛ دون توتر) / براحة (براحة جسدية)\nمثال: يعيشون برغد / بِسُرْعَة, عَاجِلًا",
 "のびひろがる": "مَدَّدَ / اِمْتَدَّ",
 "のびやか": "مُرِيح, وَثِير / مُرْتَاح / مُرِيح",
 "のびりつ": "مُعَدَّل النُّمُوّ (معدل الزيادة في الحجم لكل وحدة زمنية)",
 "のびる": "تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل. / مَدَّدَ / اِمْتَدَّ / طَوَّرَ",
 "のびをする": "تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ",
 "のふうぞ": "مُشَاغِب",
 "のふうぞう": "مُشَاغِب",
 "のぶし": "جندي مرتزق, مرتزق (شخص يُستأجر للقتال لصالح دولة غير دولته) / رَاهِب (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "のぶせり": "قاطع طريق, لص مسلح (لص مسلح يكون (عادة) عضواً في عصابة)",
 "のぶとい": "جَرِيء, مُجَازِف (مُستعد لخوض المخاطر والمجازفة) / صَفِيق, وَقِح (لا يتقيّد بالأعراف أو اللياقة؛ جريء بشكل فظّ) / بَاسِل, جَسُور (لا يهاب الخوف أو الترهيب) / حَلْقِيّ (يبدو كأنَّه يُنطَق من أعماق الحلق)",
 "のべ": "مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل / اِئْتِمَان / تَمَدُّد, مط (عملية التوسع عن طريق الإطالة أو التوسيع) / إطالة, تمدد (تمرين مصمم لمد الأطراف والعضلات إلى أقصى حد لها) / مَجْمُوع / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "のべあう": "قَارَنَ / شَبَّهَ",
 "のべおくり": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\"",
 "のべがね": "صاج, صفيحة معدنية (ورقة من المعدن مشكلة في لوحة رقيقة)",
 "のべざお": "قَصْبَة صَيْد / قطعة واحدة ((للملابس) يتكون من أو مصمم كقطعة واحدة كاملة)\nمثال: رداء من قطعة واحدة",
 "のべつ": "بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل)\nمثال: الرقص يلهمه بلا توقف للسعي أعلى وأعلى نحو قمة الكمال المشرقة",
 "のべつまくなし": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل)\nمثال: العالم يتغير باستمرار",
 "のべつ幕なし": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل)\nمثال: العالم يتغير باستمرار",
 "のべつ幕無し": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل)\nمثال: العالم يتغير باستمرار",
 "のべのおくり": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\"",
 "のべばらい": "ائتمان, دفع مؤجل (ترتيب للدفع المؤجل للسلع والخدمات)",
 "のべひろげる": "مَدَّدَ / اِمْتَدَّ",
 "のべぼう": "حَانَة, بَار / مِرْقَاق, فَرَّادَة",
 "のべる": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري. / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع.",
 "のべ竿": "قَصْبَة صَيْد / قطعة واحدة ((للملابس) يتكون من أو مصمم كقطعة واحدة كاملة)\nمثال: رداء من قطعة واحدة",
 "のほうず": "مُتَوَحِّش / بَرِّيّ / حَلَقِيّ, لَا نِهَائِيّ (مُتَّصِلُ الأَطْرَافِ بِحَيْثُ يُشَكِّلُ كُلًّا مُتَّصِلًا) / أَبَدِيّ, سَرْمَدِيّ (لَيْسَ لَهُ بِدَايَةٌ مَعْرُوفَةٌ وَلَا نِهَايَةٌ مُفْتَرَضَةٌ) / لَا نِهَائِيّ, لَا يُحْصَى (عَظِيمٌ بِلَا حُدُودٍ فِي العَدَدِ) / لَا نِهَائِيّ, لَا يَنْتَهِي (طَويل بِشَكْل مُمِلّ؛ يَبْدو بِلا نِهايَة)",
 "のほほん": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية) / بِبُرُود, بِرَبَاطَة جَأْش (بطريقة هادئة وغير مبالية)\nمثال: ألقى نظرة غير مبالية على العناوين",
 "のぼす": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "のぼせ": "هبة ساخنة (إحساس مفاجئ وقصير بالحرارة (يرتبط بانقطاع الطمث وبعض الاضطرابات العقلية))",
 "のぼせる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "のぼり": "صُعُود, تَسَلُّق / مُتَّجِهٌ لِلْأَعْلَى (يَسِيرُ فِي اتِّجَاهٍ يُعْتَبَرُ تَقْلِيدِيًّا صُعُودًا) / ضد التيار, نحو المنبع (نحو المصدر أو عكس التيار) / ضد التيار, عكس التيار (في الاتجاه المعاكس لتيار النهر)",
 "のぼりきる": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "のぼりくち": "نقطة البداية (أقرب نقطة حدية)",
 "のぼりぐち": "نقطة البداية (أقرب نقطة حدية)",
 "のぼりこうばい": "تَرْقِيَة",
 "のぼりざか": "صُعُود, تَسَلُّق / انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "のぼりだん": "عَتَبَةُ الْبَابِ",
 "のぼりちょうし": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "のぼりぢょうし": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "のぼりふじ": "ذِئْبِيّ",
 "のぼりリンク": "إرسال صاعد, وصلة صاعدة (إرسال من الأرض إلى مركبة فضائية أو مسار مثل هذا الإرسال)",
 "のぼり口": "نقطة البداية (أقرب نقطة حدية)",
 "のぼる": "صَعِد / يقرب / طَلَعَ",
 "のま": "حصان بري (حصان منزلي غير مروض أو وحشي)",
 "のます": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "のませる": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "のみ": "وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي. / بُرْغُوث / إِزْمِيل / شَرِبَ, شرب (جَرَعَ) / شَرَاب, مَشْرُوب / شراب\nمثال: جلس وشرب قهوته. / حنفية, صنبور (منظم للتحكم في تدفق السائل من خزان) / سدادة حنفية, صنبور (سدادة لفتحة البرميل في برميل خشبي) / سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ, بُورْصَة (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "のみあるき": "جولة حانات (جولة في الحانات (عادة مع تناول مشروب في كل محطة))",
 "のみくだす": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو",
 "のみくち": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول. / تَنَصَّتَ",
 "のみぐすり": "طب باطني, طب عام (فرع الطب الذي يتعامل مع تشخيص وعلاج (غير جراحي) لأمراض الأعضاء الداخلية (خاصة عند البالغين))",
 "のみぐち": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول. / تَنَصَّتَ",
 "のみこうい": "دَلْو, سَطْل",
 "のみこみ": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو / فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "のみこみがはやい": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "のみこみがわるい": "بَطِيء الفَهْم, ضَعِيف العَقْل (متأخر في التطور العقلي والذهني)",
 "のみこむ": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / اِحْتَوَى, تَضَمَّنَ / اِحْتَوَى",
 "のみし": "كحولي, مدمن كحول (شخص يشرب الكحول بإفراط وبشكل اعتيادي)",
 "のみすけ": "مُعَاقِر الخَمْر, شَارِب الخَمْر",
 "のみで": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض",
 "のみならず": "بِالْإِضَافَة إِلَى / عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك",
 "のみにくい": "بَغِيض, غَيْر مَقْبُول (ليس على هواك) / غَيْرُ مُتَعَاطِفٍ, مُنَفِّر (لَا يَتَّفِقُ مَعَ أَذْوَاقِكَ أَوْ تَوَقُّعَاتِكَ) / بَغِيض, كَرِيه المُعَاشَرَة (غير سار في التعامل معه)\nمثال: موقف بغيض",
 "のみぬけ": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "のみのいち": "سوق البراغيث, سوق السلع المستعملة (سوق شوارع مفتوح للسلع الرخيصة أو المستعملة)",
 "のみのしんぞう": "تهيب, جبن (الخوف عند الخوض في أماكن أو أنشطة جديدة ومجهولة) / جبن, خجل (الخوف من المجهول أو غير المألوف أو الخوف من اتخاذ القرارات)",
 "のみの市": "سوق البراغيث, سوق السلع المستعملة (سوق شوارع مفتوح للسلع الرخيصة أو المستعملة)",
 "のみほす": "بَالُوعَة",
 "のみみず": "مَاء شُرْب, مَاء صَالِح لِلشُّرْبِ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "のみむし": "قافزات الذيل (أي من الحشرات البدائية الدقيقة عديمة الأجنحة العديدة التي تمتلك زائدة بطنية خاصة تسمح بنمط القفز المميز شبه الدائم؛ توجد في التربة الغنية بالحطام…)",
 "のみもの": "شَرِبَ, شرب (جَرَعَ) / شَرَاب, مَشْرُوب / شراب\nمثال: جلس وشرب قهوته.",
 "のみや": "حَانَة, بَار / مُؤَلِّف, كَتَّاب / مُرَاهِن / حانة رخيصة ((سابقاً) صالون رخيص يبيع الخمور بالدلو) / شركة وساطة وهمية, مكتب مراهنات غير قانوني (شركة وساطة غير أخلاقية أو عدوانية بشكل مفرط)",
 "のみ込みが悪い": "بَطِيء الفَهْم, ضَعِيف العَقْل (متأخر في التطور العقلي والذهني)",
 "のみ込みが早い": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "のむ": "شَرِبَ, شرب (جَرَعَ) / شَرَاب, مَشْرُوب / شراب\nمثال: جلس وشرب قهوته. / دُخَان, دخان / دَخَّنَ (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن)\nمثال: دخن زيري سيجارة. / جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل. / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "のめのめ": "بلا خجل, بوقاحة (بدون خجل)\nمثال: تخلى بلا خجل عن المشروع",
 "のめやうたえ": "احتفال صاخب, سَمَر (مرح واحتفال غير مقيد)",
 "のめりこむ": "اِنْخَدَعَ بِـ / تَهَافَتَ عَلَى",
 "のめり込む": "اِنْخَدَعَ بِـ / تَهَافَتَ عَلَى",
 "のように": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال.",
 "のら": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل. / ضَلَّ / غَرِيب, غَرِيبَة / أَجْنَبِيّ",
 "のらくら": "باسترخاء, بكسل (بطريقة خاملة)\nمثال: هذا ما كنت أتخيل نفسي أفعله دائماً في جنوب فرنسا، الجلوس باسترخاء، وشرب القهوة، ومراقبة الناس / بتهرب, بمراوغة (مع تهرب؛ بأسلوب مراوغ)\nمثال: بدا أن زوجها يعرف الكثير من الأشخاص المذكورين، لكنه أجاب بمراوغة عندما سُئل عن هويتهم / كَسَل",
 "のらくらもの": "كَسُول, مِكْسَال",
 "のらくら者": "كَسُول, مِكْسَال",
 "のらねこ": "قط شوارع (قط بلا مأوى)",
 "のらりくらり": "باسترخاء, بكسل (بطريقة خاملة)\nمثال: هذا ما كنت أتخيل نفسي أفعله دائماً في جنوب فرنسا، الجلوس باسترخاء، وشرب القهوة، ومراقبة الناس / بتهرب, بمراوغة (مع تهرب؛ بأسلوب مراوغ)\nمثال: بدا أن زوجها يعرف الكثير من الأشخاص المذكورين، لكنه أجاب بمراوغة عندما سُئل عن هويتهم",
 "のり": "أَلْصَقَ / ركوب الخيل (السفر محمولاً على ظهر الخيل) / ركوب الخيل, فروسية (رياضة الجلوس على ظهر الحصان مع التحكم في تحركاته) / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل. / مَزَاج / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون. / نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به) / مُنْحَدَر / مَيْل",
 "のりあいじどうしゃ": "حَافِلَة, بَاص (وسيلة نَقْل للركاب) / نَاقِل\nمثال: لنذهب بالحافلة.",
 "のりあいせん": "عبّارة, معدية (قارب ينقل الناس أو المركبات عبر مسطح مائي ويعمل وفق جدول منتظم)",
 "のりあいばしゃ": "ستيج كوتش, عربة البريد والركاب (عربة كبيرة تجرها أربعة خيول كانت تستخدم سابقاً لنقل الركاب والبريد على طرق منتظمة بين المدن)\nمثال: خرجنا من المدينة معاً في عربة البريد لحوالي عشرة أو اثني عشر ميلاً",
 "のりあいぶね": "عبّارة, معدية (قارب ينقل الناس أو المركبات عبر مسطح مائي ويعمل وفق جدول منتظم)",
 "のりあいバス": "حَافِلَة, بَاص (وسيلة نَقْل للركاب) / نَاقِل\nمثال: لنذهب بالحافلة.",
 "のりうつす": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "のりうつる": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "のりうま": "حصان ركوب (حصان خفيف الوزن يُربى للركوب فقط)",
 "のりおくれる": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "のりかえ": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار. / مِقْلَاد / تبديل, تحول (عملية تغيير شيء أو منصب بآخر)\nمثال: تحوله بشأن الإجهاض كلفه الانتخابات / تصالب, عبور (تبادل الأجزاء بين الكروموسومات المتماثلة المقترنة أثناء الطور الأول من الانقسام المنصف)",
 "のりかえる": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار. / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "のりかかる": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "のりがいい": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ / ارتفاع, انقشاع (ارتفاع شيء ما)\nمثال: كشف انقشاع السحب عن زرقة سماء الصيف",
 "のりがよい": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ / ارتفاع, انقشاع (ارتفاع شيء ما)\nمثال: كشف انقشاع السحب عن زرقة سماء الصيف",
 "のりが良い": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ / ارتفاع, انقشاع (ارتفاع شيء ما)\nمثال: كشف انقشاع السحب عن زرقة سماء الصيف",
 "のりき": "فَائِدَة",
 "のりきる": "طَقْس, جَوّ",
 "のりくち": "دُخُول / مَدْخَل",
 "のりくみ": "طَاقَم, طَاقِم",
 "のりくみいん": "طَاقَم, طَاقِم",
 "のりぐち": "دُخُول / مَدْخَل",
 "のりこえる": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق. / هَزَمَ, غَلَبَ / فَاقَ, تَجَاوَزَ",
 "のりこす": "إلغاء الهبوط, تجاوز الهدف (اقتراب يفشل ويفسح المجال لمحاولة أخرى) / سَبَقَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك.",
 "のりこなす": "مناورة (إجراء يهدف إلى مراوغة الخصم) / مناورة (خطوة تُتخذ لتحقيق غاية تكتيكية) / لعبة, مناورة (حركة منسقة متعمدة تتطلب البراعة والمهارة) / مناورة (تدريب عسكري)\nمثال: قام بمناورة رائعة",
 "のりこみ": "ركوب, صعود (فعل صعود الركاب والطاقم على متن سفينة أو طائرة)",
 "のりこむ": "لَوْحَة, خَشَبَة / لَوْحَة, لَوْح / مَجْلِس, لَجْنَة / اِسْتَقَلَّ, صَعِدَ / أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "のりごこち": "رَاحَة / جابر / وَاسَى, عَزَّى",
 "のりしろ": "تَفَاوُت مَسْمُوح, سَمَاحِيَّة (فرق مسموح به؛ السماح ببعض الحرية للحركة ضمن حدود) / انحراف جانبي ((لسفينة أو طائرة) انحراف جانبي)",
 "のりすてりょうきん": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "のりすてる": "نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف.",
 "のりする": "أَلْصَقَ",
 "のりそこなう": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "のりつきテープ": "شَرِيط لَاصِق",
 "のりつぎ": "مُرُور / عُبُور",
 "のりつぎち": "توقف, محطة استراحة (إقامة قصيرة أثناء رحلة) / استراحة, محطة توقف (مكان توقف في رحلة)\nمثال: توقفوا لزيارة أصدقائهم",
 "のりつぎびん": "رحلة ترانزيت, رحلة مواصلة (رحلة مع توقف وسيط وتغيير الطائرة (وربما تغيير شركة الطيران))",
 "のりつぐ": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
 "のりつけ": "نَشَاء / أَلْصَقَ",
 "のりつける": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر.",
 "のりづけ": "نَشَاء / أَلْصَقَ",
 "のりて": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "のりとる": "أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / أَسَرَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة.",
 "のりにがす": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "のりのがす": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "のりのこり": "شَرِيط لَاصِق",
 "のりのり": "فِي نَشْوَة, مُفْعَمٌ بِالحَيَوِيَّة (سَعِيدٌ وَمُتَحَمِّسٌ وَنَشِيط)",
 "のりはぐれる": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "のりば": "مَوْقِف لِلْحَافِلَات, مَوْقِف بَاص",
 "のりばり": "غِرَاء, لِزَاق / لَصَّقَ / نَشَاء",
 "のりめん": "مُنْحَدَر / مَيْل",
 "のりもの": "وَاسِطَة, وَسِيلَة / رَكِبَ, اِمْتَطَى (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا من الدواب) / رَكِبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا من الدواب) / رُكُوب / آليَّة\nمثال: ركب ياني سفينة. / رِهَان, مُرَاهَنَة",
 "のりものよい": "دُوَار اَلْبَحْر (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "のり張り": "غِرَاء, لِزَاق / لَصَّقَ / نَشَاء",
 "のり残り": "شَرِيط لَاصِق",
 "のり貼り": "غِرَاء, لِزَاق / لَصَّقَ / نَشَاء",
 "のり面": "مُنْحَدَر / مَيْل",
 "のる": "رَكِبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا من الدواب)\nمثال: ركب ياني سفينة. / بَلَغَ / تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان. / شَارَكَ, سَاهَمَ / ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "のれん": "سُمْعَة, شُهْرَة / حسن نية, كياسة (الميل إلى اللطف والتعاطف) / حسن نية (الأمل الودي في نجاح شيء ما) / سمعة تجارية, شهرى المحل ((محاسبة) أصل غير ملموس يُقيم وفقاً للميزة أو السمعة التي اكتسبتها الشركة (فوق أصولها الملموسة))\nمثال: كياسة المنتصر في معاملة المهزوم",
 "のれんだい": "حسن نية, كياسة (الميل إلى اللطف والتعاطف) / حسن نية (الأمل الودي في نجاح شيء ما) / سمعة تجارية, شهرى المحل ((محاسبة) أصل غير ملموس يُقيم وفقاً للميزة أو السمعة التي اكتسبتها الشركة (فوق أصولها الملموسة))\nمثال: كياسة المنتصر في معاملة المهزوم",
 "のれんにうでおし": "هدر الجهد (جهد لا طائل منه)",
 "のれんに腕押し": "هدر الجهد (جهد لا طائل منه)",
 "のれん代": "حسن نية, كياسة (الميل إلى اللطف والتعاطف) / حسن نية (الأمل الودي في نجاح شيء ما) / سمعة تجارية, شهرى المحل ((محاسبة) أصل غير ملموس يُقيم وفقاً للميزة أو السمعة التي اكتسبتها الشركة (فوق أصولها الملموسة))\nمثال: كياسة المنتصر في معاملة المهزوم",
 "のろ": "كَلِيل / يَحْمُور, يَأْمُور / خابث, خباث / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "のろい": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة / بَلِيد, غَلِيظ الفَهْم ((غير رسمي) غبيّ وبطيء الفهم) / بَطِيء / أَبْطَأَ, بَطَّأَ / مُتَسَامِح, مُتَسَاهِل (مَيَّال إِلَى التَّسَاهُل والقَبُول) / متسامح, متساهل (يتميز بـأو يميل إلى الاستجابة لرغبات شخص ما) / لَيِّن, مُتَسَامِح (متسامح ورحيم في المعاملة)\nمثال: أجداد متساهلون",
 "のろう": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة",
 "のろくさ": "بِبُطْء",
 "のろじか": "يَحْمُور, يَأْمُور",
 "のろのろ": "بِبُطْء",
 "のろま": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "のろり": "بِبُطْء",
 "のろわしい": "بغيض, كريه (يثير أو يستحق الكراهية) / حَقُود, خَبِيث (يتسم بالحقد والخبث)\nمثال: لا توجد رذيلة بغيضة عالمياً مثل الجحود",
 "のろ鹿": "يَحْمُور, يَأْمُور",
 "のんき": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "のんきもの": "طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة)",
 "のんき者": "طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة)",
 "のんだ": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "のんだくれ": "سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "のんでかかる": "اِسْتَخَفَّ, اِسْتَهَانَ / اِسْتَبَدَّ (حزم ولم يتردد في اتخاذ القرار وتنفيذه؛ (في السياسة) حكم بنظام استبدادي)",
 "のんど": "حَلْق, حُلْقُوم (أصاب حَلْقه أو ضربه في حلقه؛ أزال شعر رأسه أو ذقنه كله بالمُوسَى)\nمثال: حلق زيري لحيته. / صوت غنائي (الجودة الموسيقية للصوت أثناء الغناء) / مِزْراب (قناة صرف لمياه الأمطار والثلوج؛ نظام يحدّ من جريان المياه على الأسطح الخارجية للمبنى)",
 "のんどり": "رَاكِد, سَاجٍ ((عَنْ جِسْمٍ مَائِيّ) خَالٍ مِنَ الاضْطِرَاب بِسَبَب الأَمْوَاج الكَبِيرَة) / سَاكِن, هَادِئ (غير مضطرب؛ يحافظ على ضبط النفس)",
 "のんの": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "のんのん": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "のんびり": "على مهل, في وقت الفراغ (بطريقة غير متسرعة أو في الوقت المناسب)\nمثال: اقرأ الدليل في وقت فراغك / اِسْتَرْخَى",
 "のんべえ": "مُعَاقِر الخَمْر, شَارِب الخَمْر",
 "のんべんだらり": "باسترخاء, بكسل (بطريقة خاملة)\nمثال: هذا ما كنت أتخيل نفسي أفعله دائماً في جنوب فرنسا، الجلوس باسترخاء، وشرب القهوة، ومراقبة الناس",
 "のんれん": "سُمْعَة, شُهْرَة / حسن نية, كياسة (الميل إلى اللطف والتعاطف) / حسن نية (الأمل الودي في نجاح شيء ما) / سمعة تجارية, شهرى المحل ((محاسبة) أصل غير ملموس يُقيم وفقاً للميزة أو السمعة التي اكتسبتها الشركة (فوق أصولها الملموسة))\nمثال: كياسة المنتصر في معاملة المهزوم",
 "のバラ": "غليون الخلنج (غليون مصنوع من جذر شجيرة الخلنج) / خلنج, خلنج شجري (شجيرة متوسطية دائمة الخضرة تشبه الشجرة ذات زهور بيضاء عطرة في عناقيد طرفية كبيرة وجذور خشبية صلبة تستخدم لصنع غليون التبغ) / عشبة الثور, فصة مستديرة الأوراق (كرمة خشبية شائكة جداً في شرق الولايات المتحدة تنمو في كتل متشابكة ولها سيقان مستديرة قوية بأوراق جلدية لامعة وأزهار خضراء صغيرة تليها عناقيد من التوت…) / نسرين, ورد ياقوتي (ورد أوراسي ذو سيقان شائكة وأوراق عطرة وزهور وردية زاهية تليها ثمار قرمزية) / ورد متعدد الأزهار, ورد ياباني (ورد قوي النمو له عناقيد من الزهور الصغيرة العديدة؛ يستخدم للأسيجة وكأصل للتطعيم)",
 "の余り": "اِسْتَبَدَّ (حزم ولم يتردد في اتخاذ القرار وتنفيذه؛ (في السياسة) حكم بنظام استبدادي)",
 "の様に": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال.",
 "は": "رِيش, رِيشَة (رَيَّشَ السَّهْمَ: راشهُ؛ رَيَّشَ الثَّوْبَ: زَيَّنَهُ بِصُوَرِ الرِّيش)\nمثال: هل عنده ريشة رسم؟ / جَنَاح / نَصْل (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة الحادّة الجارحة)\nمثال: لن نصل إلى أي مكان. / رِيشَة / سِنّ, سن ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: هم في نفس السن. / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما) / حافة, طرف (الحد الخارجي لجسم أو منطقة أو سطح؛ مكان أبعد ما يكون عن مركز الشيء) / أَفْضَلِيَّة نِسْبِيَّة, تَفَوُّق بَسِيط (ميزة تنافسية طفيفة) / حدة (سمة الإلحاح في نبرة الصوت)\nمثال: قام بتدوير حواف الصندوق / سن, شوكة (نتوء مدبب) / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / فَرِيق, زَمْرَة (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد. / مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة. / فِرْقَة / مَذْهَب (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب: المُعْتَقَد الديني الذي يُذهب إليه) / طائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه) / نِحْلَة\nمثال: الوجودية مذهب إنساني. / وَرَقَة, وَرَقة / صَحِيفَة / بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد / تَفَوُّق / دعم, مؤازرة (فعل تقديم الموافقة والدعم) / بطولة (مسابقة يتم فيها اختيار البطل) / بطولة (مكانة كونه بطلاً)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "はぁ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はぁっ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はぁはぁ": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "はぁー": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はぁーっ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はあ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はあく": "قَبْضَة",
 "はあっ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はあはあ": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "はあー": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はあーっ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はい": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / مَفْهُوم / حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن. / رَمَاد, سَكَن / دَرْدَار / رِئَة, سَحَر / منوة (سمكة مياه عذبة أوروبية صغيرة جداً شائعة في الجداول الحصوية) / عِبَادَة / عَبَدَ, سَجَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / سَجَدَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة / كَأْس, كُوب (إناء الشرب إذا كان فيه شراب؛ الشراب الذي في الإناء) / فِنْجَان (إناء صغير لشرب أو احتساء شراب ساخن عادة، مثل القهوة والشاي)\nمثال: هل لي بكأس ماء؟ / جَنِين / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / مِيدَالِيَة, مِِيدَالْيَة / لوحة إعلانات (لوحة تُعلق على الحائط؛ تعرض الإعلانات) / قِرْمِيدَة, قِرْمِيد / قَرْمَدَ / ضِدّ, مُضَادّ / مَهْجُورّ, مَتْرُوك",
 "はい、はい": "أَيّ, أَيَّمَا (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / مَهْمَا مَا / طُز\nمثال: لم تقصد أي أذى. / بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "はいあがる": "هَزَمَ, غَلَبَ",
 "はいい": "خلع, عزل (فعل عزل شخص ما؛ إزالة شخص قوي من منصب أو وظيفة) / تحديق, نظرة ثابتة (نظرة ثابتة وطويلة) / اكتراث, اهتمام (إيلاء اهتمام خاص (كما هو الحال مع الأطفال أو العاجزين)) / جانب, صدد ((عادة تسبقها 'في') تفصيل أو نقطة معينة) / احترام, تقدير (موقف يتسم بالإعجاب والتقدير)\nمثال: ثبت نظرته الأبوية علي",
 "はいいかごうぶつ": "مركب تناسقي, معقد (مركب يوصف من حيث الذرة المركزية التي ترتبط بها أو تتناسق معها ذرات أخرى)",
 "はいいけつごう": "رابطة تناسقية (رابطة تساهمية يتم فيها توفير كلا الإلكترونين من قبل إحدى الذرات)",
 "はいいし": "ربيطة",
 "はいいつしんきょう": "تفريد العبادة (عبادة إله واحد دون الادعاء بأنه الإله الوحيد الموجود)",
 "はいいろ": "رَمَادِيّ (بلون لا لوني متوسط بين الأبيض والأسود) / رَمَادِيّ, ضَبَابِيّ (وَسَطٌ فِي الطَّبِيعَةِ أَوِ المَوْقِعِ؛ غَيْرُ وَاضِحِ المَعَالِمِ) / رَمَادِيّ (يُستخدم للدلالة على قوات الكونفدرالية في الحرب الأهلية الأمريكية (الذين ارتدوا زيّاً رمادياً)) / أَشْيَب, شَائِب (يُظهِر علامات الشيخوخة خاصّة الشعر الأبيض أو الرماديّ)",
 "はいいろおおかみ": "ذئب الغياض, ذئب رمادي (ذئب ذو معطف رمادي مبقع يعيش في المناطق الشمالية المشجرة في أمريكا الشمالية)",
 "はいいろぎつね": "ثعلب رمادي (ثعلب أمريكي رمادي داكن؛ من أمريكا الوسطى عبر جنوب الولايات المتحدة)",
 "はいいろぐま": "دُبّ أَشْهَب, دُبَّة شَهْبَاء",
 "はいいろちゅうひ": "مرزة الدجاج (مرزة شائعة في أمريكا الشمالية وأوروبا؛ تعشش في المستنقعات والأراضي المفتوحة)",
 "はいいろののうさいぼう": "عَقْل, فِطْنَة (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "はいいろひれあししぎ": "فلروب أحمر (فلروب من المحيطات والبحيرات الشمالية)",
 "はいいろほしがらす": "كسار بندق كلارك (كسار بندق من غرب الولايات المتحدة)",
 "はいうっけつ": "احتقان رئوي (احتقان في الرئتين)",
 "はいえい": "سباحة الظهر (طريقة سباحة تشبه الزحف (السباحة الحرة) إلا أن السباح يستلقي على ظهره)",
