 "にじゅうきはん": "كَيْلٌ بِمِكْيالَيْنِ, اِزْدِوَاجِيَّة الْمَعَايِير",
 "にじゅうきゅう": "تِسْعَة وَعِشْرُونَ (يَدُلُّ عَلَى العَدَد 29) / تِسْعَة وَعِشْرُون (العدد الأصلي الذي هو مجموع ثمانية وعشرين وواحد)",
 "にじゅうけっこん": "تَعَدُّد اَلْأَزْوَاج, تَعَدُّد اَلزَّوْجَات",
 "にじゅうけつごう": "رابطة ثنائية, رابطة مزدوجة (رابطة تساهمية يتم فيها مشاركة زوجين من الإلكترونات بين ذرتين)",
 "にじゅうこうそく": "مأزق مزدوج, ورطة مزدوجة ((علم النفس) معضلة غير قابلة للحل؛ وضع يتلقى فيه الشخص رسائل متناقضة من شخص ذي نفوذ قوي)",
 "にじゅうご": "خَمْسَة وَعِشْرُونَ (يَدُلُّ عَلَى العَدَد 25) / خَمْسَة وَعِشْرُون (العدد الأصلي الذي هو مجموع أربعة وعشرين وواحد)",
 "にじゅうごし": "خَمْسَة وَعِشْرُون (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال.",
 "にじゅうしし": "أَرْبَعَة وَعِشْرُون (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "にじゅうしち": "سَبْعَة وَعِشْرُونَ (يَدُلُّ عَلَى العَدَد 27) / سَبْعَة وَعِشْرُون (العدد الأصلي الذي هو مجموع ستة وعشرين وواحد)",
