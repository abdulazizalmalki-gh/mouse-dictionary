 "はすわ": "بَذِيء",
 "はす交い": "بِانْحِرَاف, بِمَيْل (بزاوية مائلة)\nمثال: سطعت الشمس بميل على وجهه",
 "はす向い": "مَائِلٌ قُطْرِيًّا عَبْرَ الزَّاوِيَة (مُنْحَرِفٌ عَبْرَ مُضَلَّعٍ عَلَى خَطٍّ قُطْرِيّ)",
 "はす向かい": "مَائِلٌ قُطْرِيًّا عَبْرَ الزَّاوِيَة (مُنْحَرِفٌ عَبْرَ مُضَلَّعٍ عَلَى خَطٍّ قُطْرِيّ)",
 "はず": "يَنْبَغِي أَنْ\nمثال: يا لها من جملة!",
 "はずい": "حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا)",
 "はずかしい": "حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / فَاضِح, مُخْزٍ ((للسلوك أو الشخصيَّة) يستحقّ العار أو يجلبه)",
 "はずかしがりや": "انطوائي, خجول (شخص ينكمش من الألفة مع الآخرين)",
 "はずかしがる": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر)\nمثال: شعرت بالخجل و احمر وجهها.",
 "はずかしげ": "مُحْرَج, بِٱلْحَرَج",
 "はずかしげもなく": "بجرأة, بوقاحة (بطريقة وقحة)\nمثال: تحدث بوقاحة",
 "はずかしながら": "بِشَكْل مُحْرِج (مسبباً للإحراج)\nمثال: كان الرجل العظيم متواضعاً ونكراً للذات بشكل محرج",
 "はずかしめ": "خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة…)\nمثال: توم لص بلا خجل. / اِنْتِهَاك",
 "はずかしめる": "أَخْزَى, اِسْتَذَلَّ (أَخْزَى: (فعل) أخزَى يُخزي ، أخْزِ ، إخزاءً ، فهو مُخْزٍ ، والمفعول مُخزًى) / اِنْتَهَكَ",
 "はずす": "نَقَلَ\nمثال: لا أزال عطشانا. / قَطْرَة\nمثال: هذه هي نقطة ضعفه. / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا. / تفادي, مراوغة (حركة مراوغة سريعة)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "はずのない": "يَعْنِي, أَي",
 "はずべき": "فَاضِح, مُخْزٍ ((للسلوك أو الشخصيَّة) يستحقّ العار أو يجلبه)",
 "はずみ": "قفزة, وثبة (حركة خفيفة ذاتية الدفع لأعلى أو للأمام) / زَخَم حَرَكَة (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من…)\nمثال: يمكنك أن تتعلم بنفس الزخم في المكتبة كما في المدرسة. / عَزْم",
 "はずみぐるま": "حَدَّافَة",
 "はずみをつける": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "はずむ": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره…)\nمثال: كان عين ليلى مسودة. / عربدة, نوبة إفراط (أي فعل من أفعال الانغماس غير المعتدل)\nمثال: نوبة إفراط في التسوق / شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها",
 "はずめますて": "لهجة بصرية (استخدام الأخطاء الإملائية لتحديد متحدث عامي أو غير متعلم (في الكتابة))",
 "はずゆ": "زيت كروتون (زيت لزج أصفر مائل للبني من بذور كروتون تيغليوم له تأثير مسهل عنيف)",
 "はずれ": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري. / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "はずれち": "قيمة شاذة, قيمة متطرفة (انحراف شديد عن المتوسط)",
 "はせい": "استمداد, اشتقاق (فعل اشتقاق شيء أو الحصول عليه من مصدر أو أصل)",
 "はせいご": "مشتقّ",
 "はせいさくひん": "منتج ثانوي (منتج تم صنعه أثناء تصنيع شيء آخر)",
 "はせいてき": "مشتقّ",
 "はせつ": "كَسْر, اِنْكِسَار",
 "はせる": "رَكَضَ (عَدَا)\nمثال: إنها تحب الركض. / رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ…)\nمثال: ربح زيري المال.",
 "はせん": "حُطَام سَفِينَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد) / فُرَاطَة / تفرع نهري (فرع من نهر يتدفق بعيداً عن المجرى الرئيسي ولا يعود إليه)",
 "はせんふごう": "تِلْدَة",
 "はぜ": "قوبيون (سمكة صغيرة شائكة الزعانف تعيش في المياه الساحلية أو قليلة الملوحة لها رأس كبير…)",
 "はぜる": "بُوب, مُوسِيقَى شَعْبِيَّة",
 "はぜろう": "شمع نباتي (مادة شمعية يتم الحصول عليها من النباتات (خاصة من جذوع بعض أنواع النخيل))",
 "はそく": "جَشِع, حَرِيص (شديد الرغبة بشكل مفرط في اكتساب الثروة وغيرها)\nمثال: كانت المحاضرة تتجاوز أقصى محاولاته للفهم / قطار أمواج (تتابع من الأمواج المتباعدة بفترات منتظمة)",
 "はそん": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام…)\nمثال: ذهب سامي في عطلة.",
 "はた": "قاروس, قاروص / عَلَم, رَايَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / رَايَة, عَلَم / مِنْسَج / عِشْرُونَ / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل. / زِعْنِفَة (أشواك عظمية مغطاة بالجلد أو أشعة تبرز من جسم السمكة، يستعملها السمك في التوزان…) / طَائِرَة وَرَقِيَّة, طيارة ورق (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير…)\nمثال: لقد وصلت الطائرة. / أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟ / عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك / رُبَّمَا\nمثال: يا لها من جملة! / بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال / أجنبي, دخيل (شخص مستبعد أو ليس عضواً في مجموعة معينة)",
 "はたいろ": "حَالَة, وَضْع / تَبَعِيَّة, اِنْتِمَاء (التَّبَعيَّة : كَوْن الشخص أو الشيْ تابعاً لغيره؛ مصدر صناعيّ من تَبَعَ:…)",
 "はたうち": "حَرْث (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: حرث المزارع أرضه.",
 "はたおり": "حياكة, نسيج (صنع القماش)",
 "はたおりどり": "حباك (طيور استعمارية أفريقية وآسيوية تشبه الشرشور تشتهر بأعشاشها المنسوجة بإتقان)",
 "はたおりむし": "جُنْدُب, جَرَادَة",
 "はたがしら": "قَائِد, زَعِيم",
 "はたき": "مِمْسَحَة, مِمْسَح / غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي…)\nمثال: أزل الغبار عن المرآة.",
 "はたきをかける": "غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي…)\nمثال: أزل الغبار عن المرآة.",
 "はたく": "غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي…)\nمثال: أزل الغبار عن المرآة. / صَفْعَة, لَطْمَة\nمثال: صفع المدرس مؤخرتي.",
 "はたけ": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل. / رَحِم, بَيْت الْوَلِد (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى…)\nمثال: رحمة الله عليه.",
 "はたけしめじ": "دَجَاج مَقْلِيّ",
 "はたけのにく": "صويا, فول الصويا (أكثر الخضراوات المعروفة احتواءً على البروتين؛ تستخدم ثمرة نبات الصويا في مجموعة…)",
 "はたけをつくる": "مَزْرَعَة",
 "はたご": "خَان, اِسْتِرَاحَة (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة.",
 "はたざお": "سارية العلم (عمود طويل أو سارية يرفع عليها العلم) / أرابيس, رشاد الصخر (أي من عدة نباتات رشاد محبة للصخور من جنس أرابيس)",
 "はたしあい": "مُبَارَزَة",
 "はたしあう": "مُبَارَزَة",
 "はたして": "بالتأكيد, حتماً (بشكل قاطع أو إيجابي)\nمثال: النتائج مشجعة بالتأكيد / حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه…)\nمثال: هو اغضبني حقا .",
 "はたしん": "تشين, سلالة تشين (السلالة الصينية (من 246 قبل الميلاد إلى 206 قبل الميلاد) التي أسست أول حكومة…)",
 "はたじるし": "تَخْطِيط, تصميم (مصدر من خَطَّطَ؛ في : فكرةٌ مُثبتة بالرسم، أو الكتابة في حالة الخطّ. تدلّ…)\nمثال: يعمل في قسم التخطيط. / رَايَة, عَلَم",
 "はたす": "أَدَّى\nمثال: 君はその義務を果たすべきである。 — عليك أن تقوم بالواجب.",
 "はたち": "أَرْض زِرَاعِيَّة (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة. / عِشْرُونَ",
 "はたて": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري.",
 "はたと": "فَجْأَةً / بحدة, بعدوانية (بطريقة عدوانية)\nمثال: كانت تُستجوب بحدة / تَمَامًا",
 "はたのものたち": "متفرج (شخص ينظر ويراقب)",
 "はたはた": "تمايل, رفرفة (فعل التحرك ذهاباً وإياباً)\nمثال: لقد ذهلوا من الاضطراب العنيف الذي سببوه",
 "はたび": "عطلة رسمية, عطلة قانونية (عطلة مصرح بها قانوناً ويتم فيها تقليص العمل أو الأعمال الرسمية)",
 "はたふり": "بادئ (مزرعة تحتوي على خميرة أو بكتيريا تستخدم لبدء عملية التخمير أو التحمض في صنع…)\nمثال: لصنع العجين المخمر تحتاج إلى بادئ",
 "はたふりやく": "مُبَادِر",
 "はたほこ": "ذُو مِقْبَض طَوِيل (لَهُ مِقْبَض أَوْ يَد طَويلَة)",
 "はたぼこ": "ذُو مِقْبَض طَوِيل (لَهُ مِقْبَض أَوْ يَد طَويلَة)",
 "はたまた": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "はためく": "تمايل, رفرفة (فعل التحرك ذهاباً وإياباً)\nمثال: لقد ذهلوا من الاضطراب العنيف الذي سببوه",
 "はたもち": "حامل الراية, حامل العلم (الجندي الذي يحمل راية الوحدة في العروض العسكرية أو في المعركة)",
 "はたもと": "الْقِيَادَة الْعَامَّة",
 "はたや": "نَسَّاج, نَسَّاجَة",
 "はたらかせる": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال)\nمثال: أيمكنني استعمال هاتفك؟",
 "はたらき": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل. / إِنْجَاز / رَاتِب, أَجْر / عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "はたらきあり": "عامل كادح (شخص يعمل بجد مثل العبد)",
 "はたらきかけ": "ضَغْط",
 "はたらきかける": "ضَغْط",
 "はたらきぐち": "مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "はたらきすぎ": "فرط النشاط (نشاط مفرط)\nمثال: فرط نشاط الغدد الدهنية يجعل الجلد دهنيًا",
 "はたらきすぎる": "إرهاق في العمل, عمل مفرط (فعل العمل كثيراً جداً أو لفترة طويلة جداً)\nمثال: أصيب بالمرض من الإرهاق في العمل",
 "はたらきちゅうどく": "مدمن عمل (شخص لديه حاجة قهرية للعمل)",
 "はたらきて": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة…)\nمثال: توم عامل نفايات.",
 "はたらきばち": "شغالة, نحلة عاملة (نحلة عقيمة متخصصة في جمع الطعام وصيانة الخلية) / عامل كادح (شخص يعمل بجد مثل العبد)",
 "はたらきびと": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة…)\nمثال: توم عامل نفايات.",
 "はたらきもの": "عامل كادح (شخص يعمل بجد مثل العبد)\nمثال: 若いときは、彼は働き者であった。 — عندما كان شاباً، كان عاملاً مثابراً.",
 "はたらく": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل. / وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟ / اِرْتَكَبَ",
 "はたりす": "سنجاب الأرض (أي من قوارض أرضية متنوعة تحفر الجحور في العالمين القديم والجديد؛ غالباً ما تدمر…)",
 "はたをおる": "نَسَجَ",
 "はたん": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة…)\nمثال: فشل ياني مجددا. / مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو…)\nمثال: مزق سامي الرسالة.",
 "はたんきょう": "بَرْقُوق",
 "はたんをきたす": "أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "はだ": "هدورة, جلدة\nمثال: سلخ زيري ذلك الغزال. / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ…) / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)\nمثال: هناك ثقوب على السطح. / تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما)\nمثال: لديه مزاج سعيد",
 "はだあい": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما)\nمثال: لديه مزاج سعيد",
 "はだいろ": "بشرة, لون البشرة (لون وجه الشخص)",
 "はだうま": "فرس ولود (أنثى حصان تستخدم للتربية)",
 "はだえ": "هدورة, جلدة\nمثال: سلخ زيري ذلك الغزال. / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ…) / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)\nمثال: هناك ثقوب على السطح. / تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما)\nمثال: لديه مزاج سعيد",
 "はだか": "انفتاح, شفافية (يتسم بموقف يسهل الوصول إليه (خاصة فيما يتعلق بأفعال المرء أو مقاصده)؛ بدون…)\nمثال: عراء المنظر الطبيعي / خلو من الزينة, عري (نقص شديد في المفروشات أو الزخرفة)\nمثال: لقد أذهلني خلو غرفة أبي من الزينة / انفتاح, تقبل (الاستعداد أو الجاهزية للتلقي (خاصة الانطباعات أو الأفكار))\nمثال: كان يختبر تقبل الحكومة للإصلاح",
 "はだかおどり": "رَقْص تَعَرِيّ, اِسْتْرِبْتِيز (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع…)\nمثال: كنت تجيد الرقص.",
 "はだかでばねずみ": "خُلْد أَمْرَط, خُلْد عَارٍ (الثَبَات المَدِيد والبَقَاء لفترة طويلة؛ دَوَام البَقَاء، يختلف عن السَرْمَد في…)\nمثال: خلد ياني إلى النوم.",
 "はだかになる": "تَعَرَّى, اِنْجَرَدَ",
 "はだかへび": "ضفدع ثعباني (أي من البرمائيات الصغيرة النحيلة عديمة الأطراف الحفارة التي تشبه الديدان؛ تعيش…)",
 "はだかむし": "يَرَقَة, دُودَة الْفَرَاشَة",
 "はだかんかく": "إحساس جلدي, حس لمسي (إحساس موضعي على الجلد)",
 "はだぎ": "مَلَابِس دَاخِلِيَّة, لِبَاس دَاخِلِيّ",
 "はだぎぬ": "مَلَابِس دَاخِلِيَّة, لِبَاس دَاخِلِيّ",
 "はだける": "مَفْتُوح\nمثال: فتح الباب آليا. / تَمَدَّدَ",
 "はださむ": "برودة شديدة, صقيع (برودة ناتجة عن بيئة باردة)\nمثال: سرت فيه رعشة مفاجئة",
 "はださむい": "بَارِد, فَاتِرُ المَشَاعِر (لا يتّسم بالعاطفة)",
 "はだざむい": "بَارِد, فَاتِرُ المَشَاعِر (لا يتّسم بالعاطفة)",
 "はだざわり": "تحسس\nمثال: شعر ماريا طويل. / أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو…)\nمثال: هو يحب أسلوب معطوب.",
