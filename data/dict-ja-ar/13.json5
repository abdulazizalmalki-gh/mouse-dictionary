 "はつひこう": "رحلة أولى, طلعة جوية أولى (أول رحلة من نوعها)\nمثال: قامت قاذفة الشبح برحلتها الأولى في عام 1989",
 "はつぶたい": "إطلاق, تدشين (فعل البدء بشيء جديد) / ظهور أول (تقديم فتاة للمجتمع لأول مرة)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "はつほ": "قُرْبَان",
 "はつみつ": "عَسَل, شَهْد (عَسَل) / حَبِيبِي, عَزِيزَتِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / عَسَل, عَسُّولَة (عَسَل) / عَسَلِيّ\nمثال: يصنع النحل العسل.",
 "はつめい": "اِخْتِرَاع / ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي.",
 "はつめいか": "مُخْتَرِع, مُبْتَكِر",
 "はつめいしゃ": "مُخْتَرِع, مُبْتَكِر",
 "はつめいひん": "اِخْتِرَاع",
 "はつもの": "بتول, بِكْر (المنقطعه عن الرجال)",
 "はつもん": "اسْتِفْهَامِيّ, مُتَسَائِل (يُظهِر الفضول والتساؤل) / مُتَسَائِل, مُسْتَفْهِم (في حيرة كأنّه يُتوقَّع منه معرفة ما لا يعرفه) / شَكَّاك, مُتَشَكِّك (يتسم بالشك أو يميل إليه) / استعلام, استفسار (طلب معلومات)",
 "はつよう": "تأليه, تعظيم (رفع شخص ما (إلى مرتبة إله)) / سرب قُبَّرَات (سرب من طيور القُبَّرَة (خاصة أثناء الطيران)) / شرف (موقع كوكب في دائرة البروج يُعتقد أنه يمارس فيه أقصى تأثير له) / انخطاف, طرب (حالة من الانجراف وراء عاطفة غامرة)\nمثال: الاستماع إلى الموسيقى العذبة في نشوة تامة",
 "はつらい": "هجمة, هجوم ((عسكري) هجوم ضد عدو (باستخدام الأسلحة)) / بداية, مستهل (البداية أو المراحل المبكرة)\nمثال: بدأ الهجوم عند الفجر",
 "はつらつ": "دَجِر",
 "はつり": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / حلاقة (فعل إزالة الشعر بالموس) / قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما)",
 "はつれい": "مَنْسُور, مُنَادَاة",
 "はつろ": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "はつわ": "تصويت, تلفظ (استخدام الأصوات المنطوقة للاتصال السمعي)",
 "はつわしゃ": "خَطِيب, مُتَكَلِّم / سَمَاعَة",
 "はつガンせいぶっしつ": "مادة مسرطنة, مسبب للسرطان (أي مادة تسبب السرطان)",
 "はつガンぶっしつ": "مادة مسرطنة, مسبب للسرطان (أي مادة تسبب السرطان)",
 "はつ恋": "اَلْحُبّ اَلْأَوَّل",
 "はづな": "دبوس التوازن (أي من الأجنحة الخلفية الضامرة للحشرات ثنائية الأجنحة؛ تستخدم للحفاظ على التوازن أثناء الطيران) / بلوزة برباط عنق, هالتر توب (توب نسائي يربط خلف الظهر والرقبة ويترك الظهر والذراعين مكشوفين) / رسن, مقود (غطاء رأس من الحبل أو القماش للحصان، مع حبل للقيادة) / حبل المشنقة (حبل يستخدمه الجلاد لإعدام الأشخاص المحكوم عليهم بالموت شنقاً)",
 "はて": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / تَسَبَّب / نَتِيجَة / حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق.",
 "はてし": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "はてしがない": "حَلَقِيّ, لَا نِهَائِيّ (مُتَّصِلُ الأَطْرَافِ بِحَيْثُ يُشَكِّلُ كُلًّا مُتَّصِلًا) / أَبَدِيّ, سَرْمَدِيّ (لَيْسَ لَهُ بِدَايَةٌ مَعْرُوفَةٌ وَلَا نِهَايَةٌ مُفْتَرَضَةٌ) / لَا نِهَائِيّ, لَا يُحْصَى (عَظِيمٌ بِلَا حُدُودٍ فِي العَدَدِ) / لَا نِهَائِيّ, لَا يَنْتَهِي (طَويل بِشَكْل مُمِلّ؛ يَبْدو بِلا نِهايَة)",
 "はてしない": "حَلَقِيّ, لَا نِهَائِيّ (مُتَّصِلُ الأَطْرَافِ بِحَيْثُ يُشَكِّلُ كُلًّا مُتَّصِلًا) / أَبَدِيّ, سَرْمَدِيّ (لَيْسَ لَهُ بِدَايَةٌ مَعْرُوفَةٌ وَلَا نِهَايَةٌ مُفْتَرَضَةٌ) / لَا نِهَائِيّ, لَا يُحْصَى (عَظِيمٌ بِلَا حُدُودٍ فِي العَدَدِ) / لَا نِهَائِيّ, لَا يَنْتَهِي (طَويل بِشَكْل مُمِلّ؛ يَبْدو بِلا نِهايَة)",
 "はてしなく": "أبدياً, إلى الأبد (لوقت غير محدود)\nمثال: لا أحد يستطيع العيش إلى الأبد",
 "はてしのない": "لَا نِهَائِيّ, لَا يَنْتَهِي (طَويل بِشَكْل مُمِلّ؛ يَبْدو بِلا نِهايَة)",
 "はてな": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق. / عَلَامَة اِسْتِفْهَام, ؟ (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "はてなマーク": "عَلَامَة اِسْتِفْهَام, ؟ (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "はては": "أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية) / في النهاية (في نهاية المطاف أو بعد فترة طويلة)\nمثال: في النهاية كان عليه الاستسلام",
 "はてる": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "はてんこう": "غَيْر مَسْبُوق, لَمْ يُسْمَع بِهِ (لم يكن معروفاً من قبل) / جَرِيء, جَسُور",
 "はで": "بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة) / صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط) / بَرَّاق, مُتَأَلِّق (يَعْرِض بَرَاعَةً وَتَأَلُّقًا) / بَرَّاق, صَارِخ (يتّسم بالتباهي لكنّه غالبًا عديم الذوق)",
 "はでごのみ": "مُبَالَغ فِي زَخْرَفَتِهِ, مُتَنَمِّق (مزخرف بإفراط وتكلّف) / بَرَّاق, صَارِخ (يتّسم بالتباهي لكنّه غالبًا عديم الذوق) / بوانسيانا ملكية, زهرة الطاووس (شجرة استوائية مبهرجة أو شجيرة موطنها مدغشقر؛ تزرع على نطاق واسع في المناطق الاستوائية لعناقيدها الضخمة من الزهور القرمزية والبرتقالية؛ تصنف أحياناً…)",
 "はでずき": "مُبَالَغ فِي زَخْرَفَتِهِ, مُتَنَمِّق (مزخرف بإفراط وتكلّف) / بَرَّاق, صَارِخ (يتّسم بالتباهي لكنّه غالبًا عديم الذوق) / بوانسيانا ملكية, زهرة الطاووس (شجرة استوائية مبهرجة أو شجيرة موطنها مدغشقر؛ تزرع على نطاق واسع في المناطق الاستوائية لعناقيدها الضخمة من الزهور القرمزية والبرتقالية؛ تصنف أحياناً…)",
 "はではでしい": "صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط) / صَارِخ, مُبَهْرَج (بَرَّاقٌ وَلَافِتٌ بِطَرِيقَةٍ تَفْتَقِرُ إِلَى الذَّوْق)",
 "はでやか": "بَرَّاق, مُبْهِر (جذّاب وأنيق ظاهريًّا؛ يوحي بالثراء أو الفخامة) / صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط) / بَرَّاق, مُتَأَلِّق (يَعْرِض بَرَاعَةً وَتَأَلُّقًا) / بَرَّاق, صَارِخ (يتّسم بالتباهي لكنّه غالبًا عديم الذوق)",
 "はと": "حَمَامَة / كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ)",
 "はとう": "رغوة الموج, زبد الموج (موجة تهب عليها الرياح فينكسر عرفها ويظهر أبيض اللون)",
 "はとこ": "قريب من الدرجة الثانية (ابن ابن عم أو ابن خال أحد الوالدين)",
 "はとごや": "برج الحمام (بيت لطيور الحمام)",
 "はとざ": "الْحَمَامة",
 "はとどけい": "ساعة الوقواق (ساعة تعلن عن الساعات بصوت يشبه نداء طائر الوقواق)",
 "はとは": "يَمَام, حَمَام",
 "はとば": "رَصِيف",
 "はとばいろ": "أَسْوَد مُزْرَقّ (أسود مع مسحة زرقاء)",
 "はとぽっぽ": "حَمَامَة",
 "はとむぎ": "دَمْع أَيُّوب (فعل ثلاثي؛ سال دمعه)\nمثال: شكرت جميل صنعكم بدمعي، ودمع العين مقياس الشعور.",
 "はとむね": "صدر حمامي (بروز غير طبيعي لعظم القص بسبب الكساح)",
 "はとめ": "حلقة معدنية, عروة (مثبت يتكون من حلقة معدنية لتبطين ثقب صغير للسماح بربط الحبال أو الخيوط) / ثقب صغير, عيينة (ثقب صغير (عادة ما يكون مستديراً ومنتهياً حول الحواف) في القماش أو الجلد لمرور حبل أو خطاف أو قضيب) / أيلت, قماش مخرم (قماش مزين بثقوب صغيرة ذات حواف مخيطة بدقة تشكل نمطاً زخرفياً)",
 "はともく": "حَمَامِيّ / حَمَامِيَّة",
 "はと座": "الْحَمَامة",
 "はと時計": "ساعة الوقواق (ساعة تعلن عن الساعات بصوت يشبه نداء طائر الوقواق)",
 "はと目": "حلقة معدنية, عروة (مثبت يتكون من حلقة معدنية لتبطين ثقب صغير للسماح بربط الحبال أو الخيوط) / ثقب صغير, عيينة (ثقب صغير (عادة ما يكون مستديراً ومنتهياً حول الحواف) في القماش أو الجلد لمرور حبل أو خطاف أو قضيب) / أيلت, قماش مخرم (قماش مزين بثقوب صغيرة ذات حواف مخيطة بدقة تشكل نمطاً زخرفياً)",
 "はと胸": "صدر حمامي (بروز غير طبيعي لعظم القص بسبب الكساح)",
 "はと麦": "دَمْع أَيُّوب (فعل ثلاثي؛ سال دمعه)\nمثال: شكرت جميل صنعكم بدمعي، ودمع العين مقياس الشعور.",
 "はどう": "تموج, موجة ((في الفيزياء) حركة صعود وهبوط أو جيئة وذهاباً) / تموج (حركة تشبه الموج؛ ارتفاع وانخفاض لطيف بطريقة الأمواج) / تموج, موجة (منحنى متموج) / لَوَّحَ, رَفْرَفَ / مَوْج, مَوْجَة / غَازٍ",
 "はどうせつ": "نظرية موجية ((فيزياء) النظرية القائلة بأن الضوء ينتقل كموجات)",
 "はどうほうていしき": "معادلة موجية (معادلة تفاضلية تصف مرور الموجات التوافقية عبر وسط ما)",
 "はどめ": "فَرَمَلَة / مِكْبَح / فَرْمَلَ, َكَبَح / جَنَاحِيَّة / دَقَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه)\nمثال: واصل زيري دق الجرس.",
 "はどめがかからない": "جامح, لا يمكن إيقافه (غير قابل للإيقاف)\nمثال: لا يمكن إيقافه كالرياح",
 "はどめをかける": "ضبط, كبح (فعل تقييد القوة أو العمل أو الحد من التجاوز) / حافة الرصيف (حافة بين الرصيف والطريق تتكون من خط من أحجار الرصيف (عادة ما تشكل جزءاً من المزراب)) / شكيمة كبح, لجام بالسلسلة (شكيمة حصان بسلسلة أو حزام ملحق لكبح الحصان)\nمثال: حسه السليم هو لجام لمزاجه السريع",
 "はな": "زَهْرَة, زُهُور / أَزْهَرَ, إِزْدَهَرَ (أزْهَرَ النَّبَات أو الشجرُ: طلَع زهرهُ؛ أزْهَرَ النارَ وغيرَها: أضاءَها)\nمثال: إنني أدرك بحكم دارستي للتاريخ أن الحضارة مدينة للإسلام الذي حمل معه في أماكن مثل جامعة الأزهر نور العلم عبر قرون عدة الأمر الذي مهد الطريق أمام النهضة الأوروبية وعصر التنوير / زَهْرَة كَرَز / جَمَال, زَيْن / حَسْنَاء, جَمِيلَة / إزهار, تفتح (العملية العضوية لحمل الزهور)\nمثال: سوف توقف كل الإزهار إذا تركت الزهور تنتج البذور / أَنْف, خَشَم (أنف:اشْتَكَى أَنفه فَهُوَ مأنوف؛ أنف الشَّيْء: حدد طرفه)\nمثال: أنت لديك أنف كبير. / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء) / خنخنة, خنين (فعل التنفس بصوت مسموع عبر الأنف (كما هو الحال عند احتقان الأنف)) / تخنع, نشيج (الأنين بطريقة باكية)",
 "はなあおい": "ختمية (أي من نباتات طويلة متنوعة من جنس ألسيا؛ موطنها الشرق الأوسط ولكنها توطنت وزرعت على نطاق واسع لزهورها الكبيرة جداً والمتنوعة الألوان) / ألثيا, ختمية (أي من نباتات متنوعة من جنس ألثيا؛ تشبه ولكن بزهور أصغر من جنس ألسيا)",
 "はなあぶ": "ذُبَاب حَوَّام, ذُبَاب الزُّهُور",
 "はなあやめ": "سوسن دموي",
 "はなあらし": "نخير, نفخ (فعل الزفير بقوة)",
 "はないき": "اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً) / إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / إثارة, انتعاش (الشعور بفرح حيوي ومبهج) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم",
 "はないきがあらい": "آمِر / ثَقِيل",
 "はないきのあらい": "آمِر",
 "はないけ": "زَهْرِيَّة",
 "はないれ": "زَهْرِيَّة",
 "はないろ": "سَمَاوِيّ, لَبَنِيّ",
 "はなうた": "دندنة (فعل الغناء بشفاه مغلقة) / دندنة, همهمة (صوت همهمة)\nمثال: همهمة حركة المرور البعيدة",
 "はなうらない": "عَرَافَة",
 "はなうりむすめ": "فتاة الزهور (فتاة صغيرة تحمل الزهور في موكب (الزفاف)) / بائعة الزهور (امرأة تبيع الزهور في الشارع)",
 "はなえんどう": "بَازِلَّاء الزُهُور",
 "はなおこぜ": "سمكة السرجس (أسماك صغيرة ذات أشكال وألوان عجيبة توجد بين كتل طحالب السرجس)",
 "はなかぜ": "زكام الرأس (زكام شائع يصيب الممرات الأنفية ويؤدي إلى احتقان وعطس وصداع) / زكام الرأس (زكام شائع يصيب الممرات الأنفية ويؤدي إلى احتقان وعطس وصداع) / نخير, نفخ (فعل الزفير بقوة)",
 "はなから": "مُنْذُ البِدَايَة",
 "はながさく": "إزهار, تزهير (رواسب مسحوقية على سطح ما) / زهرة (العضو التكاثري للنباتات كاسيات البذور خاصة تلك التي لها أجزاء مبهرجة أو ملونة) / إزهار, تفتح (العملية العضوية لحمل الزهور) / تورد, نضارة (لون وردي (خاصة في الخدين) يؤخذ كعلامة على الصحة الجيدة)\nمثال: سوف توقف كل الإزهار إذا تركت الزهور تنتج البذور",
 "はながた": "جذل, فانفار ((موسيقى) لحن حيوي قصير يُعزف على الآلات النحاسية) / إشهار, تلويح (فعل التلويح) / زخرفة لفظية (عرض للكلام أو اللغة المنمقة) / حركة استعراضية (إيماءة مبهرجة)\nمثال: دخل على وقع نغمة احتفالية من الأبواق / إِجَّامَة / نَجْمَة",
 "はながたかい": "فَخُور",
 "はながない": "غَيْر جَذَّاب, غَيْر مُغْرٍ (غير قادر على جذب الانتباه الإيجابي) / بغيض, غير محبوب ((للشخصيات في الأدب أو الدراما) تميل إلى إثارة مشاعر النفور)\nمثال: جعلوا المكان غير جذاب قدر الإمكان",
 "はながみ": "ورق رقيق, ورق مناديل (ورق ناعم رقيق (شفاف عادة))",
 "はながめ": "زَهْرِيَّة",
 "はなきん": "الْجُمُعَة, الجُمْعَة",
 "はなぎ": "بُرَة",
 "はなぎれ": "طَوْق شَعَر (وَضَعَ عليه طَوْقا؛ تَحَلَّقَ الناس أو الحيوانات أو غيرها حوله كالطوق، يستخدم تحلق إذا كان الأمر برضاه وطوّق إذا كان ذلك كرها)\nمثال: كلب زيري يحب ارتداء ذلك الطوق.",
 "はなくそ": "مُخَاط, مُخَاط أَنْف",
 "はなぐすり": "رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "はなぐすりをかがせる": "رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "はなぐま": "قوطي (ثديي قارت من أمريكا الوسطى وأمريكا الجنوبية)",
 "はなげ": "مُغَفَّل, أَحْمَق",
 "はなげをぬく": "مُغَفَّل, أَحْمَق",
 "はなごけ": "طحلب الرنة (أشنة متفرعة رمادية منتصبة في القطب الشمالي وحتى بعض المناطق المعتدلة الشمالية تشكل الغذاء الرئيسي للرنة والكاريبو وأحياناً يأكلها البشر)",
 "はなごんどう": "دلفين ريسو (دلفين رمادي أردوازي غير حاد الأنف شائع في البحار الشمالية) / أوركا, حوت قاتل (حوت مسنن مفترس أسود وأبيض ذو زعنفة ظهرية كبيرة؛ شائع في البحار الباردة)",
 "はなさ": "نهاية متقاربة جداً, نهاية مصورة (بشكل عام، أي نهاية متقاربة جداً؛ وتحديداً، نهاية سباق يكون فيه المتسابقون قريبين جداً من بعضهم البعض بحيث يجب تحديد الفائز من صورة التقطت لحظة النهاية)",
 "はなさき": "أَمَامَ, قُدَّامَ / أَمَامَ / طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "はなさきしあん": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "はなさきじあん": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "はなさきふんべつ": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "はなさく": "إزهار, تزهير (رواسب مسحوقية على سطح ما) / زهرة (العضو التكاثري للنباتات كاسيات البذور خاصة تلك التي لها أجزاء مبهرجة أو ملونة) / إزهار, تفتح (العملية العضوية لحمل الزهور) / تورد, نضارة (لون وردي (خاصة في الخدين) يؤخذ كعلامة على الصحة الجيدة)\nمثال: سوف توقف كل الإزهار إذا تركت الزهور تنتج البذور",
 "はなし": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / مَوْضُوع, مَوَاضِيع / مُنَاقَشَة, بَحْث / إِشَاعَة, شَائِعَة / ذهاب, رحيل (فعل المغادرة) / باستمرار",
 "はなしあい": "مُنَاقَشَة, بَحْث",
 "はなしあいて": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "はなしあう": "نَاقَشَ, بَحَثَ",
 "はなしかける": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "はなしかわって": "أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ) / إِلَى حِينِ ذَلِكَ الوَقْتِ فِي الأَثْنَاءِ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / فِي حِينِ أَنَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: أما زلت تذكرني؟",
 "はなしかわるけど": "بِالْمُنَاسَبَةِ, عَلَى فِكْرَةٍ",
 "はなしがい": "حُرُّ المَرْعَى, طَلِيق ((عَنِ المَوَاشِي وَالدَّوَاجِنِ) مَسْمُوحٌ لَهُ بِالرَّعْيِ الحُرِّ بَدَلًا مِنَ الحَبْسِ)",
 "はなしがはやい": "عَفْوًا",
 "はなしがわかる": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "はなしことば": "حديث, كلام ((لغة) التواصل عن طريق الكلام الشفهي)\nمثال: كان كلامه مشوشاً",
 "はなしじょうず": "بارع في الحديث, محاور (شخص ماهر في المحادثة)",
 "はなしずき": "نَمِيمَة, إِشَاعَة / اِغْتَابَ\nمثال: ジョージはとても話好きだ。 — جورج ثرثار جداً.",
 "はなしちゅう": "مَشْغُول",
 "はなして": "خَطِيب, مُتَكَلِّم / سَمَاعَة",
 "はなしにならない": "غَيْرُ وَارِد, مُسْتَحِيل (مُسْتَبْعَدٌ تَمَامًا؛ لَا يُمْكِنُ تَصَوُّرُه)",
 "はなしのわかる": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "はなしははやい": "عَفْوًا",
 "はなしばなし": "كَلَام خَفِيف, مُحَادَثَة خَفِيفَة",
 "はなしぶり": "إلقاء, طريقة التحدث (أسلوبك أو طريقتك المميزة في التعبير عن نفسك شفهياً)\nمثال: كانت طريقته في الكلام فظة للغاية",
 "はなしょうぶ": "سوسن دموي",
 "はなしる": "مُخَاط, مُخَاط أَنْف",
