 "ねち": "حُمَّة, حُمَّى",
 "ねちこい": "حَثِيث, دَائِم (لَا يَتَوَقَّفُ أَبَدًا) / مُلَازِمٌ لِلذِّهْن, مُلِحّ (يَعُودُ إِلَى الذِّهْنِ بِاسْتِمْرَارٍ) / دائم, مستديم (باقٍ؛ لا يسقط) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: الأوراق المستديمة تبقى ملتصقة بعد النضج",
 "ねちっこい": "حَثِيث, دَائِم (لَا يَتَوَقَّفُ أَبَدًا) / مُلَازِمٌ لِلذِّهْن, مُلِحّ (يَعُودُ إِلَى الذِّهْنِ بِاسْتِمْرَارٍ) / دائم, مستديم (باقٍ؛ لا يسقط) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: الأوراق المستديمة تبقى ملتصقة بعد النضج",
 "ねちねち": "بلزوجة (بطريقة لزجة ودبقة)\nمثال: شعر بالدم يتحرك بلزوجة من فروة رأسه المشقوقة ويسيل على جبهته / بِإِصْرَار (مع الإصرار) / بإصرار, بشكل متواصل (بطريقة مستمرة ومصرة)\nمثال: كان يطرح أسئلة، أسئلة لا مفر منها، بإصرار",
 "ねちゃねちゃ": "لَيِّن وَلَزِج (طريّ ولزج الملمس)",
 "ねっから": "بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: كان كسولاً بطبعه / مطلقا, على الإطلاق",
 "ねっからはっから": "مطلقا, على الإطلاق",
 "ねっき": "حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد. / حَمَاس, حَمَاسَة / حُمَّة, حُمَّى",
 "ねっききゅう": "مُنْطَاد, بَالُون",
 "ねっきょうしゃ": "متحمس, نصير (مؤيد قوي ومتحمس لشخص أو نشاط ما) / مولع, هاوٍ (شخص لديه إعجاب قوي بشيء ما)",
 "ねっきょうてき": "مَجْنُون, مَخْبُول",
 "ねっきょうてきしんじゃ": "مُتَعَصِّب / مُتَعَصِّب, غَيُور",
 "ねっきょうぶり": "تشقق دقيق (شق دقيق في الطلاء أو أي سطح آخر) / بدعة, صرعة (اهتمام يُتبع بحماس مبالغ فيه) / نوبة جنون, هياج (حالة من الهياج العقلي العنيف)\nمثال: يتبع دائماً أحدث الصرعات",
 "ねっけつ": "حَمَاس / جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد .",
 "ねっけつかん": "حَمِيّ الطَّبْع, مُتَّقِدُ المَشَاعِر (ميّال إلى الانفعال والعاطفة الشديدة)",
 "ねっけつだんじ": "حَمِيّ الطَّبْع, مُتَّقِدُ المَشَاعِر (ميّال إلى الانفعال والعاطفة الشديدة)",
 "ねっこ": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة. / جُذْمُور, كُنَّاشَة",
 "ねっころがる": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير.",
 "ねっしゃびょう": "ضربة شمس, فرط الحرارة (انهيار ناتج عن التعرض للحرارة المفرطة)",
 "ねっしやすい": "سريع الانفعال, قابل للإثارة (يسهل إثارته) / سَرِيع الاسْتِثَارَة, قَابِل لِلتَّهَيُّج (قادر على الاستجابة للمحفّزات)",
 "ねっしょう": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "ねっしん": "مُتَحَمِّس, حَمَاسِيّ",
 "ねっすい": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "ねっすいせん": "يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "ねっする": "حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد.",
 "ねっせい": "جدية, رزانة (سمة كون المرء جاداً) / إخلاص, جدية (شعور جاد وصادق)\nمثال: نقص الوقار ليس بالضرورة نقصاً في الجدية",
 "ねっせん": "شعاع تحت أحمر (شعاع من الأشعة تحت الحمراء؛ ينتج تأثيراً حرارياً (كما من مصباح الأشعة تحت الحمراء))",
 "ねったい": "مَدَار (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير)\nمثال: انتشرت الشائعة على مدار الدولة.",
 "ねったいいがく": "طب المناطق الحارة (فرع الطب الذي يتعامل مع تشخيص وعلاج الأمراض الموجودة غالباً في المناطق الاستوائية)",
 "ねったいうりん": "غَابَة مَطِيرَة مَدَارِيَّة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "ねったいうりんきこう": "غَابَة مَطِيرَة مَدَارِيَّة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "ねったいしまか": "حَمَّى صَفْرَاء (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "ねったいたうりん": "غَابَة مَطِيرَة مَدَارِيَّة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "ねっちゅうしょう": "ضربة شمس, فرط الحرارة (انهيار ناتج عن التعرض للحرارة المفرطة)",
 "ねっちり": "بلزوجة (بطريقة لزجة ودبقة)\nمثال: شعر بالدم يتحرك بلزوجة من فروة رأسه المشقوقة ويسيل على جبهته / بِإِصْرَار (مع الإصرار) / بإصرار, بشكل متواصل (بطريقة مستمرة ومصرة)\nمثال: كان يطرح أسئلة، أسئلة لا مفر منها، بإصرار",
 "ねっとう": "ماء مغلي (ماء تم تسخينه إلى درجة الغليان أو تجاوزها)\nمثال: هناك غلاية ماء مغلي على الموقد",
 "ねっとり": "بلزوجة (بطريقة لزجة ودبقة)\nمثال: شعر بالدم يتحرك بلزوجة من فروة رأسه المشقوقة ويسيل على جبهته",
 "ねっぱ": "مَوْجَة اَلْحَرّ",
 "ねっぱつ": "حُمَّة, حُمَّى",
 "ねつ": "حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد. / حُمَّة, حُمَّى / حَمَاس / جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد .",
 "ねつあい": "تَفَرُّغ",
 "ねつあいしゃ": "عَاشِق, عَاشِقَة / مُغْرَم",
 "ねつい": "حَمَاس / جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد .",
 "ねつおせん": "تلوث حراري (ضرر يلحق بالبحيرات والأنهار ناتج عن إطلاق حرارة زائدة فيها)",
 "ねつかがく": "كيمياء حرارية (فرع الكيمياء الذي يدرس العلاقة بين العمل الكيميائي وكمية الحرارة الممتصة أو المتولدة)",
 "ねつかくはんのう": "تفاعل نووي حراري (تفاعل اندماج نووي يحدث في درجات حرارة عالية جداً (كما في الشمس))",
 "ねつかそ": "لدائني الحرارة, لدن بالحرارة (له خاصية الليونة أو الانصهار عند التسخين والتصلب مرة أخرى عند التبريد) / بلاستيك حراري, لدائن حرارية (مادة تلين عند تسخينها وتتصلب مرة أخرى عند تبريدها)\nمثال: المواد اللدائنية الحرارية يمكن إعادة صهرها وتبريدها مرارًا دون الخضوع لأي تغيير كيميائي ملحوظ",
 "ねつかそじゅし": "بلاستيك حراري, لدائن حرارية (مادة تلين عند تسخينها وتتصلب مرة أخرى عند تبريدها)",
 "ねつかそせいじゅし": "بلاستيك حراري, لدائن حرارية (مادة تلين عند تسخينها وتتصلب مرة أخرى عند تبريدها)",
 "ねつきかん": "محرك حراري (أي محرك يستخدم الحرارة للقيام بعمل)",
 "ねつききゅう": "مُنْطَاد, بَالُون",
 "ねつきぐ": "مِدْفَأَة",
 "ねつぎ": "لصقة, وصلة (نقطة اتصال حيث يتم ضم شيئين (مثل الورق أو الفيلم أو الشريط المغناطيسي) معاً)\nمثال: كان الانقطاع بسبب وصلة غير متقنة",
 "ねつく": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "ねつくさい": "دَافِئ / دَفِيء",
 "ねつけ": "حمى, سخونة (ارتفاع في درجة حرارة الجسم؛ غالباً ما يكون عرضاً للعدوى) / محمومية, هياج (حالة من النشاط أو العاطفة المثارة بشدة)",
 "ねつけん": "ثِيرْمُوسْفِير",
 "ねつこうか": "تصلبي الحرارة, صلد بالحرارة (له خاصية التصلب الدائم عند التسخين أو المعالجة)\nمثال: كانت راتنجات الفينول والبلاستيك هي المواد الاصطناعية الأصلية المتصلبة بالحرارة",
 "ねつこうかざい": "مصلب, مقسي (مادة تزيد الصلابة، خاصة مادة تضاف إلى الورنيش أو الطلاء لمنحه سطحاً أو طبقة أكثر صلابة)",
 "ねつこうかせいじゅし": "راتينج تصلب بالحرارة, لدائن تصلب بالحرارة (مادة تتصلب عند تسخينها ولا يمكن إعادة تشكيلها)",
 "ねつこうかんき": "مبادل حراري (جهاز ينقل الحرارة من سائل إلى آخر دون السماح باختلاطهما)",
 "ねつさまし": "خافض للحرارة",
 "ねつじょう": "اتقاد, حرارة (مشاعر الدفء والحدة الكبيرة) / شغف, وله (شعور مكثف بالحب) / اتقاد, اندفاع (شعور بتوق قوي (عادة لصالح شخص أو قضية))\nمثال: تحدث بحماسة كبيرة",
 "ねつじょうてき": "مُتَوَهِّج",
 "ねつぞう": "فَبْرَكَة",
 "ねつっぽい": "مَحْمُوم, مُحْتَدِم (يتسم باضطراب أو انفعال شديد) / مَحْمُوم, مُصَاب بِالحُمَّى (يعاني من الحمّى أو متأثّر بها) / حمي, محموم (مكون من أو متعلق بـ أو يتميز بالحمى)\nمثال: تفاعل حمي ناتج عن مادة مسببة للحساسية / مُتَحَمِّس",
 "ねつでんし": "أَيُون حَرَارِيّ (جسيم مشحون كهربائياً (إلكترون أو أيون) ينبعث من مادة عند درجة حرارة عالية)",
 "ねつでんつい": "مزدوجة حرارية (نوع من مقاييس الحرارة يتكون من سلكين من معدنين مختلفين متصلين في كلا الطرفين؛ حيث يولد التيار في الدائرة بما يتناسب مع فرق درجات الحرارة)",
 "ねつでんどうりつ": "موصلية حرارية (في الفيزياء، خاصية المادة لتوصيل الحرارة)\nمثال: عندما تخضع مادة لتغير في الطور من صلب إلى سائل أو من سائل إلى غاز، قد تتغير الموصلية الحرارية",
 "ねつど": "دَرَجَةْ الْحَرَارَة / حُمَّى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "ねつのかべ": "حاجز حراري (حد لسرعة الطيران العالية يفرضه التسخين الديناميكي الهوائي)",
 "ねつのこもった": "مُسَخَّن (جُعِل دافئاً أو ساخناً) / حَامٍ, مُحْتَدِم (يتّسم بالحدّة العاطفيّة؛ عنيف)",
 "ねつばて": "إنهاك حراري (حالة تتميز بالدوخة والغثيان والضعف الناجم عن استنزاف سوائل الجسم والشوارد)",
 "ねつひはい": "إنهاك حراري (حالة تتميز بالدوخة والغثيان والضعف الناجم عن استنزاف سوائل الجسم والشوارد)",
 "ねつひろう": "إنهاك حراري (حالة تتميز بالدوخة والغثيان والضعف الناجم عن استنزاف سوائل الجسم والشوارد)",
 "ねつびょう": "حُمَّة, حُمَّى",
 "ねつぶんかい": "تحلل حراري (تحول مادة ناتج عن تأثير الحرارة)",
 "ねつぼうそう": "تسخين مفرط, فرط السخونة (تسخين مفرط)",
 "ねつりきがく": "دِينَامِيكَا حَرَارِيَّة",
 "ねつりきがくだいいちほうそく": "حفظ الطاقة, قانون حفظ الطاقة (المبدأ الأساسي في الفيزياء القائل بأن الطاقة الكلية لنظام معزول ثابتة على الرغم من التغيرات الداخلية)",
 "ねつりきがくだいさんほうそく": "القانون الثالث للديناميكا الحرارية (قانون ينص على أن إنتروبيا مادة ما تقترب من الصفر مع اقتراب درجة حرارتها من الصفر المطلق)",
 "ねつりきがくだいにほうそく": "القانون الثاني للديناميكا الحرارية (قانون ينص على أنه لا يمكن استخلاص شغل ميكانيكي من جسم إلا عندما يتفاعل ذلك الجسم مع جسم آخر عند درجة حرارة أقل؛ أي عملية تلقائية تؤدي إلى زيادة في…)",
 "ねつりきがくてき": "ترموديناميكي, ديناميكي حراري (متعلق بالديناميكا الحرارية)\nمثال: الحد الديناميكي الحراري",
 "ねつりきがくのだいいちほうそく": "حفظ الطاقة, قانون حفظ الطاقة (المبدأ الأساسي في الفيزياء القائل بأن الطاقة الكلية لنظام معزول ثابتة على الرغم من التغيرات الداخلية)",
 "ねつりきがくのだいさんほうそく": "القانون الثالث للديناميكا الحرارية (قانون ينص على أن إنتروبيا مادة ما تقترب من الصفر مع اقتراب درجة حرارتها من الصفر المطلق)",
 "ねつりきがくのだいにほうそく": "القانون الثاني للديناميكا الحرارية (قانون ينص على أنه لا يمكن استخلاص شغل ميكانيكي من جسم إلا عندما يتفاعل ذلك الجسم مع جسم آخر عند درجة حرارة أقل؛ أي عملية تلقائية تؤدي إلى زيادة في…)",
 "ねつりきがくのだいゼロほうそく": "القانون الصفري للديناميكا الحرارية (القانون الذي ينص على أنه إذا كان جسمان في توازن حراري مع جسم ثالث، فإن الجسمين الأولين يكونان في توازن حراري مع بعضهما البعض)",
 "ねつりきがくのほうそく": "قانون الديناميكا الحرارية ((فيزياء) قانون يحكم العلاقات بين حالات الطاقة في نظام مغلق)",
 "ねつりきがくほうそく": "قانون الديناميكا الحرارية ((فيزياء) قانون يحكم العلاقات بين حالات الطاقة في نظام مغلق)",
 "ねつりょう": "حَمَاس, حَمَاسَة",
 "ねつりょうけい": "مسعر, مقياس الحرارة (أداة قياس تحدد كميات الحرارة)",
 "ねつれつ": "مُتَوَهِّج كَالنَّار, مُتَّقِد (يَتَوَهَّج أَوْ يَلْمَع كَالنَّار) / حَارّ, مُتَوَقِّد (يتّسم بحماسة شديدة وقويّة) / حَمَاسِيّ, مُتَحَمِّس (يَتَّسِمُ بِعَاطِفَةٍ شَدِيدَة)",
 "ねつエネルギー": "حرارة, طاقة حرارية (شكل من أشكال الطاقة يتم نقله عن طريق اختلاف في درجة الحرارة)",
 "ねつポンプ": "مضخة حرارية (جهاز يستخرج الحرارة من سائل ذي درجة حرارة أعلى من محيطه؛ يمكن استخدامه لنقل الحرارة من خزان خارجي لتدفئة مبنى)",
 "ねつ造": "فَبْرَكَة",
 "ねづく": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "ねづけ": "تسعير (تقييم شيء ما من حيث سعره)",
 "ねづもり": "تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء",
 "ねづよい": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "ねてもさめても": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: العالم يتغير باستمرار",
 "ねとねと": "بلزوجة (بطريقة لزجة ودبقة)\nمثال: شعر بالدم يتحرك بلزوجة من فروة رأسه المشقوقة ويسيل على جبهته",
 "ねとまり": "إِقَامَة",
 "ねとられ": "دياثة (فعل جنسي يمارس فيه شخص متزوج الجنس مع شخص آخر بينما يشاهد الزوج ذلك)",
 "ねどい": "تطفل, فضول (حالة من الفضول النشط) / حب الاستطلاع, فضول (صفة الفضول والاهتمام)\nمثال: أزعجتني نظرة الاختراق وحب الاستطلاع لديه: شعرت بالحرج والذنب في وجوده",
 "ねどうぐ": "أغطية السرير, مفروشات السرير (الأغطية التي تستخدم على السرير) / فَرْشَة, فِرَاش (مادة تُستخدم لتهيئة فراش أو مرقد للحيوانات)",
 "ねどこ": "قَاع, حَوْض (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / مَشَارَة, حَوْض\nمثال: نمت في قاعة السينما. / مَخْدَع, غُرْفَةُ نَوْم",
 "ねどころ": "مَخْدَع, غُرْفَةُ نَوْم / مجثم (مجثم تستريح عليه أو تنام عليه الطيور الداجنة) / مَجثَم (مأوى به عوارض لجلوس الدواجن أو الطيور الأخرى)",
 "ねなし": "صُعْلُوك, مُقْتَلَع الجُذُور (يتشرّد بلا هدف ودون روابط بمكان أو مجتمع)",
 "ねなしぐさ": "عدس الماء (عَدَس)\nمثال: أعدت سلطة العدس. / هَائِم",
 "ねぬき": "الجماع المقطوع, العزل (طريقة لتحديد النسل يتم فيها بدء الجماع ولكن يتم سحب القضيب عمداً قبل القذف) / ابْنُ البَلَد, مَوْلُودٌ فِي البَلَد (يَنْتَمِي إِلَى مَكَانٍ بِحُكْمِ الوِلَادَةِ فِيهِ)",
 "ねね": "يَاه, اسمع / هَلَا",
 "ねのかたすくに": "سِجِّين, عَالَم سُفْلِيّ",
 "ねのくに": "سِجِّين, عَالَم سُفْلِيّ",
 "ねのとき": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "ねはん": "اَلنِّرْفَانَا / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "ねば": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا. / دبق, لزوجة (خاصية الالتصاق بسطح ما) / طِين, صَلْصَال",
 "ねばい": "دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة) / لَاصِق, لَزِق (مُغطّى بمادّة لاصقة) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج)",
 "ねばっこい": "دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة) / لَاصِق, لَزِق (مُغطّى بمادّة لاصقة) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج) / مُتَمَاسِك (ملتصق ببعضه ومتماسك) / حافظ, قوي الذاكرة (جيد في التذكر) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: عقل حافظ",
 "ねばつち": "طِين, صَلْصَال",
 "ねばならない": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب)) / لَابُدَّ / عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: وجب عليك إيقافه.",
 "ねばならぬ": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب)) / لَابُدَّ / عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: وجب عليك إيقافه.",
 "ねばなりません": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب)) / لَابُدَّ / عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: وجب عليك إيقافه.",
 "ねばなるまい": "يَنْبَغِي أَنْ / مِنْ اَلْمَفْرُوض أَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / مِنْ اَلْمُفْتَرَض أَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "ねばねば": "دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة) / لَاصِق, لَزِق (مُغطّى بمادّة لاصقة) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج) / دبق, لزوجة (خاصية الالتصاق بسطح ما)",
 "ねばり": "دبق, لزوجة (خاصية الالتصاق بسطح ما) / إصرار, دأب (تصميم مستمر)",
 "ねばりがち": "عَنِيف المُنَافَسَة (يَتَطَلَّب جُهْدًا كَبِيرًا)",
 "ねばりけ": "دبق, لزوجة (خاصية الالتصاق بسطح ما)",
 "ねばりづよい": "مُتَمَاسِك (ملتصق ببعضه ومتماسك) / حافظ, قوي الذاكرة (جيد في التذكر) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: عقل حافظ / دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة) / لَاصِق, لَزِق (مُغطّى بمادّة لاصقة) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج)",
 "ねばり強い": "مُتَمَاسِك (ملتصق ببعضه ومتماسك) / حافظ, قوي الذاكرة (جيد في التذكر) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: عقل حافظ / دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة) / لَاصِق, لَزِق (مُغطّى بمادّة لاصقة) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج)",
 "ねばる": "ثَابَرَ",
 "ねびき": "تخفيض السعر, خصم (عملية تخفيض سعر بيع البضائع)",
 "ねびきりつ": "خصم مصرفي, سعر الخصم (فائدة على أساس سنوي تُخصم مقدماً على قرض) / سعر الخصم الفيدرالي (سعر الفائدة الذي يحدده الاحتياطي الفيدرالي والذي يُفرض على البنوك الأعضاء عند اقتراض الأموال من خلال نظام الاحتياطي الفيدرالي)",
 "ねふだ": "عَلَامَةُ سِعْر, بِطَاقَةُ سِعْر (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "ねぶか": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "ねぶかい": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "ねぶかじる": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "ねぶくろ": "حَقِيبَةُ النَّوْم",
 "ねぶと": "دُمَّل, خُرَاج / غَلَيَان, غَلْي / غَلَّى",
 "ねぶみ": "تثمين, تخمين (تقدير خبير للجودة والكمية والخصائص الأخرى لشخص أو شيء ما) / تقدير, تقييم (تصنيف شخص أو شيء ما فيما يتعلق بقيمته) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))",
 "ねぶり": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / خمول, ركود (حالة عدم النشاط أو قلة النشاط) / خمول, عطالة (الميل للبقاء غير نشط أو خامل) / جمود, خمول (حالة عدم النشاط)\nمثال: كان عليه التغلب على عطالته والعودة للعمل / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "ねぶる": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات. / لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان)",
 "ねべや": "مَخْدَع, غُرْفَةُ نَوْم",
 "ねほしょう": "ائتمان متجدد, ائتمان مفتوح (خط ائتمان استهلاكي يمكن استخدامه حتى حد معين أو سداده في أي وقت)",
 "ねほりはほり": "بتساؤل, بفضول\nمثال: نظر الطفل حوله بفضول",
 "ねぼう": "اِسْتَغْرَقَ فِي النَّوْم / نَؤُوم, نَعْسَان (شخص يشعر بالنعاس)",
 "ねぼすけ": "نَؤُوم, نَعْسَان (شخص يشعر بالنعاس)",
 "ねま": "مَخْدَع, غُرْفَةُ نَوْم",
 "ねまき": "ملابس نوم (ملابس مصممة للارتداء في السرير)",
 "ねまわし": "خَلْفَ الكَوَالِيس, سِرِّيّ (مُصَمَّمٌ وَمُنَفَّذٌ بِسِرِّيَّةٍ أَوْ بِشَكْلٍ سِرِّيّ)",
 "ねむい": "نَعْسَان, نَاعِس",
 "ねむけ": "نُعَاس, سِنَة",
 "ねむたい": "نَعْسَان, نَاعِس",
 "ねむのき": "ألبيزيا زهرة الحرير, شجرة الحرير (شجرة آسيوية جذابة مقببة أو مسطحة القمة لها أوراق ريشية مزدوجة وزهور بأسدية حريرية طويلة)",
 "ねむらす": "نَوَّمَ, أَنَامَ (بكافة معانيه)\nمثال: لم أستطع النوم. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "ねむらせる": "نَوَّمَ, أَنَامَ (بكافة معانيه)\nمثال: لم أستطع النوم. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "ねむり": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / خمول, ركود (حالة عدم النشاط أو قلة النشاط) / خمول, عطالة (الميل للبقاء غير نشط أو خامل) / جمود, خمول (حالة عدم النشاط)\nمثال: كان عليه التغلب على عطالته والعودة للعمل / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "ねむりぐさ": "ميموزا (مشروب مخلوط يحتوي على الشمبانيا وعصير البرتقال) / ست الحسن, ميموزا (أي من الشجيرات أو الأشجار الاستوائية المختلفة من جنس الميموزا ذات أزهار صفراء عادة وأوراق مركبة) / سنط فضي, ميموزا (شجرة أسترالية دائمة الخضرة ذات لحاء وأوراق صغيرة بيضاء أو فضية وزهور صفراء)",
 "ねむりぐすり": "مُخَدِّر",
 "ねむりこむ": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "ねむりにおちる": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "ねむりにつく": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "ねむりひめ": "الْجَمِيلَة الْنَائِمَة",
 "ねむりびょう": "التهاب الدماغ السباتي, مرض النوم (التهاب دماغ كان وبائياً بين عامي 1915 و1926؛ تشمل الأعراض شلل عضلة العين الخارجية وضعف عضلي شديد)",
 "ねむる": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "ねむれる": "نوم (توقف الوعي وانخفاض معدل الأيض) / سكون, كمون (حالة من الراحة الهادئة وغير النشطة) / رَاقِد, نَائِم (مستلقٍ ورأسه على كفَّيه كأنَّه نائم) / استغراق في النوم (حالة كون الشخص نائماً)",
 "ねむれるもりのびじょ": "الْجَمِيلَة الْنَائِمَة",
 "ねめた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "ねもころ": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر. / أَلِيف, وَدُود (ذو مصالح أو مودة مشتركة؛ على صداقة راسخة) / حَمِيم, وَثِيق (يتميز بالمعرفة أو الصحبة أو الألفة الوثيقة) / ضَلِيع, مُطَّلِع (على دراية تامة عبر الدراسة أو التجربة) / أَلِيف, حَمِيمِيّ (يُوَفِّرُ جَوًّا دَافِئًا وَوُدِّيًّا وَغَيْر رَسْمِيّ)",
 "ねもと": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "ねもの": "خضراوات جذرية (أي من الجذور أو الدرنات الصالحة للأكل اللحمية المختلفة تحت الأرض)",
 "ねものがたり": "حديث الوسادة (محادثة حميمة بين العشاق (تحدث عادة في السرير)) / قِصَّةٌ قَبْلَ النَوْمِ",
 "ねもはもない": "لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "ねや": "مَخْدَع, غُرْفَةُ نَوْم / رأس السهم, نصل (الرأس المدبب أو الطرف الضارب للسهم)",
 "ねやごと": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "ねやす": "رَخِيص",
 "ねらい": "هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "ねらいうち": "رِمَايَة",
 "ねらいどころ": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "ねらいめ": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "ねらい撃ち": "رِمَايَة",
 "ねらい目": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "ねり": "اِعْتِجَان / أَلْصَقَ",
 "ねりあげる": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل",
 "ねりあるく": "اِسْتِعْرَاض, مَوْكِب",
 "ねりかえす": "ريمكس, ريميكس",
 "ねりこ": "عَجِين, عَجِينَة",
 "ねりこう": "قرص طبي محلى",
 "ねりつち": "أَلْصَقَ",
 "ねりなおす": "تنقيح, مراجعة (فعل إعادة كتابة شيء ما)",
 "ねりはみがき": "مَعْجُون الأَسْنَان",
 "ねりもの": "تقدم, زحف (فعل التحرك للأمام (نحو هدف)) / مَسِيرَة, مَوْكِب (العمل الجماعي لمجموعة من الناس أو الحيوانات أو المركبات التي تتحرك للأمام في تشكيل منتظم إلى حد ما) / انبثاق, فيض ((اللاهوت) انبثاق الروح القدس في العنصرة)\nمثال: كانت المواكب محظورة",
 "ねり粉": "عَجِين, عَجِينَة",
 "ねる": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة) / اِضْطَجَعَ\nمثال: استلقى على السرير. / خَمَرَ (شَرَابُ الْعِنَبِ إِذَا اخْتَمَرَ؛ كُلُّ مُسْكِرٍ مُخَامِرٍ لِلْعَقْلِ، إِذَا كَانَ شَرَاباً كُحُولِيّاً أَوْ غَيْرَهُ)\nمثال: أنت تشرب الخمر. / عَجَنَ, دَلَكَ (عَجَنْتُ، أَعْجُنُ، اُعْجُنْ، مصدر عَجْنٌ، عجن فلان الدقيق، أي خلطه بالماء و لاَكَهُ بيد أو آلة وعَجَنَ فلانٌ: عَجْنًا: نهضَ معتمدا بيديه على الأرض…)\nمثال: واصل زيري العجن. / بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل / ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل. / بَرِيق / حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط) / صلابة, متانة (مرونة وصلابة جسم معدني؛ قدرته على امتصاص طاقة كبيرة قبل التشقق) / فورة غضب, هيجان (نوبة مفاجئة من الغضب) / مزاج (حالة شعورية مميزة (عادة أو مؤقتة نسبياً))\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه / اِسْتِعْرَاض, مَوْكِب",
 "ねるじかん": "وقت النوم (الوقت الذي تذهب فيه إلى الفراش)",
 "ねるほどらくはなかりけり": "هُنَاكَ, يُوجَدُ",
 "ねわすれる": "اِسْتَغْرَقَ فِي النَّوْم",
 "ねわら": "مِحَفَّة / بَعْثَرَ",
 "ねをあげる": "تَنَازَلَ / تَخَلَّى / اِسْتَسْلَمَ",
 "ねをはる": "هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "ねをもどす": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته",
 "ねん": "حَاسَّة / إِحْسَاس, شُعُور / مَعْنَى, دَلَالَة / مَوْهِبَة, قُدْرَة طَبِيعِيَّة / حَسَّ (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ النّارَ:رددْتُها بالعصا على خُبْزِ المَلّةِ؛ حَسَّ فلاناً:قتله قتلاً ذريعاً مستأصلاً رأسه.(حسَسْتُ اليهوديََ لما أظهر عداوته لله ودينه))\nمثال: لديهم حس الفكاهة. / رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب. / اِهْتِمَام, اِنْتِبَاه / صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎.",
 "ねんいり": "حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: قد بحذر من فضلك.",
 "ねんいれ": "اِهْتِمَام / عِنَايَة, رِعَايَة / اِهْتَمَّ بِـ",
 "ねんえき": "مُخَاط, نُخَاعَة",
 "ねんえきさいきん": "بكتيريا مخاطية, ميكسوبكتيريا (بكتيريا تشكل مستعمرات في مادة لزجة تنتجها ذاتياً؛ تعيش في التربة الرطبة أو المواد النباتية المتحللة أو فضلات الحيوانات)",
 "ねんえきさん": "حمض الميوسيك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "ねんえきしゅ": "ورم مخاطي (ورم حميد في النسيج الضام يحتوي على مادة تشبه الهلام)",
 "ねんえきすいしゅ": "وذمة مخاطية (قصور الغدة الدرقية يتميز بجفاف الجلد وتورمات حول الشفتين والأنف بالإضافة إلى التدهور العقلي)",
 "ねんおし": "منبه للذاكرة, مُذكّر (تجربة تجعلك تتذكر شيئاً ما) / تَذْكِير (رسالة تساعدك على تذكر شيء ما) / مُذكِّر, مُنذِر (شخص يقدم تحذيراً لتجنب وقوع خطأ)\nمثال: تجاهل تذكيرات زوجته",
 "ねんかい": "مُؤْتَمَر",
 "ねんかつ": "دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة)",
 "ねんかん": "كتاب سنوي (كتاب مرجعي ينشر بانتظام مرة كل عام) / كتاب سنوي (كتاب تنشره سنوياً دفعة التخرج في مدرسة ثانوية أو كلية يحتوي عادة على صور أعضاء هيئة التدريس والطلاب المتخرجين) / صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎.",
 "ねんかんけいかく": "حولي, سنوي (يكمل دورة حياته في غضون عام)\nمثال: حدود من النباتات المزهرة الحولية",
 "ねんが": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ねんがじょう": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ねんがた": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "ねんがっぴ": "تَمْرَة, تَمْر / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مُوَاعَدَة, مَوْعِد / لِقَاء الْحُبّ, مَوْعِد (وجود اثنين أو أكثر معًا، صدفةً أو تدبيرًا) / أَرَّخَ (أَرَخَّ الشيءَ: بالغ فيه؛ وأَرَخَّ العجينَ: أكثر ماءه)\nمثال: ما تاريخ اليوم؟",
 "ねんがはがき": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ねんがゆうびん": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ねんがらねんじゅう": "على مدار الوقت (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "ねんき": "تدريب مهني, تلمذة مهنية (منصب المتدرب المهني) / حولي, سنوي (يكمل دورة حياته في غضون عام)\nمثال: حدود من النباتات المزهرة الحولية / صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎. / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "ねんきぼうこう": "تدريب مهني, تلمذة مهنية (منصب المتدرب المهني)",
 "ねんきもの": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "ねんきん": "دخل سنوي, دفعات سنوية (دخل من الاستثمار الرأسمالي يُدفع في سلسلة من المدفوعات المنتظمة)\nمثال: تم إنشاء صندوق تقاعده ليُدفع كدخل سنوي / عفن غروي حقيقي, ميكسوميسيت (عفن غروي من طائفة الميكسوميسيت)",
 "ねんきんがく": "دخل سنوي, دفعات سنوية (دخل من الاستثمار الرأسمالي يُدفع في سلسلة من المدفوعات المنتظمة)\nمثال: تم إنشاء صندوق تقاعده ليُدفع كدخل سنوي",
 "ねんきんききん": "صندوق تقاعد, صندوق معاشات (مؤسسة مالية تجمع مساهمات منتظمة من أصحاب العمل لتوفير دخل التقاعد للموظفين) / صندوق تقاعد (صندوق مخصص لدفع رواتب التقاعد للعمال عند تقاعدهم من الخدمة)",
 "ねんきんじゅきゅうしゃ": "مُتَقَاعِد",
 "ねんきんせいかつ": "مَعَاش / بَنْسِيُون",
 "ねんきんせいかつしゃ": "مُتَقَاعِد",
 "ねんきんほけんりょう": "قسط التأمين (الدفع مقابل التأمين)",
 "ねんぐ": "ضريبة الأراضي, ضريبة الأملاك (ضريبة رأسمالية تفرضها البلديات على الممتلكات؛ وتعتمد على القيمة المقدرة للعقار)",
 "ねんけつ": "كَعْكَة (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم.",
 "ねんけつざい": "رابط, موثق (شيء يستخدم للربط أو التوثيق) / حافظة ملفات, مجلد (أداة لحفظ الأوراق السائبة أو المجلات) / آلة حصاد وربط (آلة تقطع الحبوب وتربطها في حزم) / رابط, مادة رابطة (شيء يستخدم لربط الجسيمات المنفصلة ببعضها البعض أو تسهيل الالتصاق بسطح ما)",
 "ねんげみしょう": "صَرِيح, مُبَاشِر (صريح ومباشر بلا تحفظ أو مواربة) / حديث من القلب للقلب, مصارحة (حديث حميم على انفراد)\nمثال: أخذني جانباً لحديث من القلب للقلب",
 "ねんげん": "اِصْطِلَاح, مُصْطَلَح",
 "ねんごろ": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر. / أَلِيف, وَدُود (ذو مصالح أو مودة مشتركة؛ على صداقة راسخة) / حَمِيم, وَثِيق (يتميز بالمعرفة أو الصحبة أو الألفة الوثيقة) / ضَلِيع, مُطَّلِع (على دراية تامة عبر الدراسة أو التجربة) / أَلِيف, حَمِيمِيّ (يُوَفِّرُ جَوًّا دَافِئًا وَوُدِّيًّا وَغَيْر رَسْمِيّ)",
 "ねんさい": "عِيد سَنَوِيّ / يُوبِيل",
 "ねんざ": "اِلْتِوَاء",
 "ねんし": "السَّنَة الْجَدِيدَة / أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة) / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "ねんしぎ": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ねんしじょう": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ねんしつ": "لَزِج",
 "ねんしまわり": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ねんしゅうしさ": "تزيح سنوي, تزيح شمسي المركز (تزيح جرم سماوي باستخدام نقطتين في مدار الأرض حول الشمس كخط أساس)",
 "ねんしゅつ": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / إسهاب, بلورة (التطوير بتفاصيل معقدة ومضنية)",
 "ねんしょ": "مُذَكِرَة",
 "ねんしょう": "صَغِير, حَدَث / احتراق, حرق (عملية حرق شيء ما) / حرق (شكل من أشكال التعذيب تستخدم فيه السجائر أو السيجار أو أدوات ساخنة أخرى لحرق جلد الضحية) / حرق, حرق على الخازوق (الإعدام بالنار) / صعق كهربائي (الإعدام بالكهرباء)\nمثال: حرق الأوراق كان ممنوعاً بموجب مرسوم المدينة",
 "ねんしょうき": "حَرَّاق, موقد (جهاز لحرق الوقود (أو النفايات)) / شعلة, عين الموقد (عناصر التسخين في الموقد التي توضع عليها الأواني والمقالي للطهي)\nمثال: محرك الديزل هو حراق زيت",
 "ねんしょうぐみ": "السنة الثالثة جامعية, الصف قبل النهائي (الصف قبل الأخير في المدرسة الثانوية أو الكلية)",
 "ねんしょうざい": "ملطف",
 "ねんしょうしゃ": "شَبَاب / شَبَاب, صِبًا / شَابّ",
 "ねんしょうやく": "ملطف",
 "ねんじ": "سَنَوِيّ / صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎.",
 "ねんじゅ": "مِسْبَحَة, سُبْحَة / استحضار, مناشدة (فعل طلب المساعدة أو الاستعانة) / استحضار, تحضير الأرواح (عملية استدعاء روح أو شيطان) / استدعاء (تعويذة تستخدم في استحضار أو استدعاء شيطان) / ابتهال, دعاء (صلاة لطلب عون الله كجزء من خدمة دينية)",
 "ねんじゅう": "دَائِمًا, أَبَدًا",
 "ねんじゅも": "نوستوك (يوجد في الأماكن الرطبة كمستعمرات هلامية مستديرة)",
 "ねんじる": "أُمْنِيَّة / رَغْبَة / مُنْيَة / تَمَنَّى / أُهْزُوجَة, أَهَازِيج",
 "ねんず": "مِسْبَحَة, سُبْحَة",
 "ねんずる": "أُمْنِيَّة / رَغْبَة / مُنْيَة / تَمَنَّى / أُهْزُوجَة, أَهَازِيج",
 "ねんせい": "لَزِج / لُزُوجَة (مصدر الفعل \"لَزِجَ\"؛ (في الفيزياء) تماسكُ أجزاء المادّة السَّائلة بعضِها ببعض تماسكًا يقاوم سيولتَها بحيث لا يتغيّر شكلها بسهولة، كالقطران والعسل وغيرهما) / خُصُوبَة",
 "ねんせいりつ": "لُزُوجَة (مصدر الفعل \"لَزِجَ\"؛ (في الفيزياء) تماسكُ أجزاء المادّة السَّائلة بعضِها ببعض تماسكًا يقاوم سيولتَها بحيث لا يتغيّر شكلها بسهولة، كالقطران والعسل وغيرهما)",
 "ねんそ": "فلوجستون (مادة افتراضية كان يعتقد سابقاً بوجودها في جميع المواد القابلة للاحتراق ويتم إطلاقها أثناء الاحتراق)",
 "ねんそう": "شريحة عمرية, فئة عمرية (مجموعة من الناس لديهم نفس العمر تقريباً)",
 "ねんだい": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "ねんだいき": "حَوْلِيَّات",
 "ねんだいそくてい": "تأريخ (تَسْجِيْل التَارِيْخ)",
 "ねんだいもの": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير.",
 "ねんちゃく": "تماسك ((في الفيزياء) القوة بين الجزيئية التي تربط جزيئات مادة صلبة أو سائلة معاً) / التحام, تلاصق ((علم النبات) العملية في بعض النباتات حيث تنمو الأجزاء معًا والتي عادة ما تكون منفصلة (مثل البتلات)) / تلاحم, تماسك (حالة التماسك أو الالتصاق معاً) / تماسك نصي, سبك ((في اللغويات) الربط النحوي والمعجمي داخل نص أو جملة مما يربط النص ببعضه ويعطيه معنى)",
 "ねんちゃくざい": "لَاصِق, مُلْتَصِق (يميل إلى الالتصاق) / مادة لاصقة (مادة توحد أو تربط الأسطح ببعضها البعض)",
 "ねんちゃくしつ": "حَثِيث, دَائِم (لَا يَتَوَقَّفُ أَبَدًا) / مُلَازِمٌ لِلذِّهْن, مُلِحّ (يَعُودُ إِلَى الذِّهْنِ بِاسْتِمْرَارٍ) / دائم, مستديم (باقٍ؛ لا يسقط) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: الأوراق المستديمة تبقى ملتصقة بعد النضج / دَبِق, صَمْغِيّ (له خصائص اللصق اللزجة كالمواد اللاصقة) / لَاصِق, لَزِق (مُغطّى بمادّة لاصقة) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج)",
 "ねんちゃくせい": "اِلْتِصَاق",
 "ねんちゃくりょく": "لُزُوجَة (مصدر الفعل \"لَزِجَ\"؛ (في الفيزياء) تماسكُ أجزاء المادّة السَّائلة بعضِها ببعض تماسكًا يقاوم سيولتَها بحيث لا يتغيّر شكلها بسهولة، كالقطران والعسل وغيرهما)",
 "ねんちゃくテープ": "شَرِيط لَاصِق",
 "ねんちゅう": "فِي السَّنَةِ الثَّانِيَة (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الثَّانِيَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ أَوِ الجَامِعَةِ الأَمْرِيكِيَّةِ) / لَزِج",
 "ねんちゅうぐみ": "طَبَقَة وُسْطَى",
 "ねんちゅうはつじょうき": "على مدار السنة (يعمل أو يستمر طوال العام)\nمثال: منتجع يعمل على مدار السنة",
 "ねんちょう": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / أرفع مقاماً, أقدم (أكبر سنًا؛ أعلى رتبة؛ أطول في مدة الولاية أو الخدمة) / أَكْبَر سِنّاً, مُسِنّ (شخص أكبر منك سناً) / طالب سنة نهائية (طالب جامعي خلال السنة التي تسبق التخرج)\nمثال: ضابط كبير / فِي السَّنَةِ الثَّالِثَة (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الثَّالِثَةِ أَوْ مَا قَبْلَ الأَخِيرَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ أَوِ الجَامِعَةِ الأَمْرِيكِيَّةِ)",
 "ねんちょうぐみ": "السنة الأخيرة, الصف النهائي (الصف أو السنة النهائية في المدرسة الثانوية أو الكلية)",
 "ねんちょうしゃ": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / أرفع مقاماً, أقدم (أكبر سنًا؛ أعلى رتبة؛ أطول في مدة الولاية أو الخدمة) / أَكْبَر سِنّاً, مُسِنّ (شخص أكبر منك سناً) / طالب سنة نهائية (طالب جامعي خلال السنة التي تسبق التخرج)\nمثال: ضابط كبير",
 "ねんぢゅう": "دَائِمًا, أَبَدًا",
 "ねんてん": "برم, دوران سريع (عملية الدوران بسرعة) / تشويه, لوي الحقائق (فعل تشويه الشيء ليبدو وكأنه يعني شيئاً لم يكن يقصده) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: أدار الكرنك بقوة",
 "ねんとう": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "ねんとうあいさつ": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ねんとうきょうしょ": "خُطْبَة حَالَةِ الاِتِّحَاد",
 "ねんとうにいれる": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "ねんとうにおく": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "ねんとうのあいさつ": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ねんとうのちかい": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "ねんど": "سَنَة مَالِيَّة (مقدارُ قطع الشمس البروجَ الاثني عشر ، وهي السنة الشمسيَّة، و السَّنَةُ تمامُ اثنتَيْ عشرةَ دَورةً للقمر ، وهي السنة القمرية…)\nمثال: في عمره 24 سنة. / سنة دراسية, عام أكاديمي (الفترة الزمنية من كل عام التي تكون فيها المدرسة مفتوحة والناس يدرسون) / لُزُوجَة (مصدر الفعل \"لَزِجَ\"؛ (في الفيزياء) تماسكُ أجزاء المادّة السَّائلة بعضِها ببعض تماسكًا يقاوم سيولتَها بحيث لا يتغيّر شكلها بسهولة، كالقطران والعسل وغيرهما) / طِين, صَلْصَال",
 "ねんどう": "تحريك عن بعد, تحريك نفسي (القدرة على تحريك شيء ما عن طريق التفكير فيه دون تطبيق قوة فيزيائية)",
 "ねんどけい": "مقياس اللزوجة (أداة قياس تستخدم لقياس اللزوجة)",
 "ねんどしつ": "صَلْصَالِيّ, طِينِيّ (يشبه أو يحتوي على الطين) / ثَقِيل, طِينِيّ ((يُقال عن التربة) متراصّ ودقيق الحبيبات)\nمثال: صخور طينية",
 "ねんなし": "مُفَاجِئ / مُؤْسِف, يُؤْسَفُ لَهُ (يَسْتَحِقُّ الأَسَفَ أَوِ النَّدَمَ) / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "ねんね": "نوم (توقف الوعي وانخفاض معدل الأيض) / سكون, كمون (حالة من الراحة الهادئة وغير النشطة) / رَاقِد, نَائِم (مستلقٍ ورأسه على كفَّيه كأنَّه نائم) / استغراق في النوم (حالة كون الشخص نائماً) / حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / حَبِيبِي, عَزِيزِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي",
 "ねんねえ": "نوم (توقف الوعي وانخفاض معدل الأيض) / سكون, كمون (حالة من الراحة الهادئة وغير النشطة) / رَاقِد, نَائِم (مستلقٍ ورأسه على كفَّيه كأنَّه نائم) / استغراق في النوم (حالة كون الشخص نائماً) / حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / حَبِيبِي, عَزِيزِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي",
 "ねんねこ": "نوم (توقف الوعي وانخفاض معدل الأيض) / سكون, كمون (حالة من الراحة الهادئة وغير النشطة) / رَاقِد, نَائِم (مستلقٍ ورأسه على كفَّيه كأنَّه نائم) / استغراق في النوم (حالة كون الشخص نائماً)",
 "ねんねん": "سنوياً, كل سنة (دون تفويت سنة) / سَنَوِيًّا (في السنة؛ كل سنة (عادة مع الإشارة إلى مبلغ من المال يدفع أو يُستلم))\nمثال: يسافرون إلى الصين سنوياً / نوم (توقف الوعي وانخفاض معدل الأيض) / سكون, كمون (حالة من الراحة الهادئة وغير النشطة) / رَاقِد, نَائِم (مستلقٍ ورأسه على كفَّيه كأنَّه نائم) / استغراق في النوم (حالة كون الشخص نائماً) / حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / حَبِيبِي, عَزِيزِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي",
 "ねんねんさいさい": "سنوياً, كل سنة (دون تفويت سنة) / سَنَوِيًّا (في السنة؛ كل سنة (عادة مع الإشارة إلى مبلغ من المال يدفع أو يُستلم))\nمثال: يسافرون إلى الصين سنوياً",
 "ねんねタオル": "بطانية الأمان (بطانية (أو لعبة) يحملها الطفل معه لتقليل القلق) / مصدر أمان, ملاذ نفسي (أي شيء يستخدمه الشخص البالغ للحد من القلق والتوتر)",
 "ねんのため": "تَحَسُبًا",
 "ねんばんがん": "أَرْدْوَاز",
 "ねんぱ": "تَخَاطُر",
 "ねんぱい": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي. / مُسِنّ, مُسِنَّة / قَدِيم, مُخَضْرَم (ماهر من خلال خبرة طويلة) / طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / الأَبّ, الأَكْبَر (يُستخدم للأكبر سنًّا من شخصين يحملان الاسم ذاته؛ خاصة لتمييز الأب عن ابنه)",
 "ねんぱつおん": "طقطقة, فرقعة (الصوت الحاد لأصوات الانكسار)",
 "ねんびゃくねんじゅう": "دَائِمًا, أَبَدًا",
 "ねんぴ": "اِسْتِهْلَاك الوَقُود (نسبة عدد الأميال المقطوعة إلى عدد جالونات البنزين المحروقة)\nمثال: あなたの車は本当に燃費が悪いんですね。 — سيارتك تستهلك البنزين بكثرة.",
 "ねんぷ": "حوليات, سجل كرونولوجي (وصف زمني للأحداث في سنوات متتالية)",
 "ねんべつ": "سَنَوِيّ",
 "ねんぽう": "كتاب سنوي (كتاب مرجعي ينشر بانتظام مرة كل عام) / كتاب سنوي (كتاب تنشره سنوياً دفعة التخرج في مدرسة ثانوية أو كلية يحتوي عادة على صور أعضاء هيئة التدريس والطلاب المتخرجين)",
 "ねんまく": "غشاء مخاطي, مخاطية (غشاء يفرز المخاط يبطن جميع تجاويف الجسم أو الممرات التي تتصل بالخارج)",
 "ねんまくかそう": "تحت المخاطية (النسيج الضام الموجود تحت الغشاء المخاطي)",
 "ねんまつ": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "ねんまつしょうせん": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "ねんまつしょうよ": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "ねんまつちょうせい": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "ねんまつねんし": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "ねんゆ": "زيت الوقود, مازوت (منتج بترولي يُستخدم كوقود)",
 "ねんよ": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض",
 "ねんりき": "ضبط النفس (سمة التحكم الحازم في سلوك المرء) / تحريك عن بعد, تحريك نفسي (القدرة على تحريك شيء ما عن طريق التفكير فيه دون تطبيق قوة فيزيائية)",
 "ねんりょう": "وَقُود",
 "ねんりょうきかばくだん": "متفجرات الوقود الهوائي (جهاز يتكون من حاوية وقود وشحنتين متفجرتين؛ الشحنة الأولى تفتح حاوية الوقود عند ارتفاع محدد وتنشر الوقود في سحابة تختلط بالأكسجين الجوي؛ الشحنة…)",
 "ねんりょうけい": "عَدَّاد الوَقُود",
 "ねんりょうでんち": "خلية وقود (خلية تنتج الكهرباء عن طريق أكسدة الوقود (الهيدروجين والأكسجين أو الزنك والهواء)؛ تستخدم غالباً في السيارات الكهربائية)",
 "ねんりょうでんちしゃ": "خلية وقود (خلية تنتج الكهرباء عن طريق أكسدة الوقود (الهيدروجين والأكسجين أو الزنك والهواء)؛ تستخدم غالباً في السيارات الكهربائية)",
 "ねんりょうでんちじつようかすいしんきょうぎかい": "خلية وقود (خلية تنتج الكهرباء عن طريق أكسدة الوقود (الهيدروجين والأكسجين أو الزنك والهواء)؛ تستخدم غالباً في السيارات الكهربائية)",
 "ねんりょうでんちじどうしゃ": "خلية وقود (خلية تنتج الكهرباء عن طريق أكسدة الوقود (الهيدروجين والأكسجين أو الزنك والهواء)؛ تستخدم غالباً في السيارات الكهربائية)",
 "ねんりょうふんしゃ": "حقن الوقود (نظام ميكانيكي لحقن الوقود المذرى مباشرة في أسطوانات محرك الاحتراق الداخلي؛ يغني عن الحاجة للمكربن (الكربياتير))",
 "ねんりょうゆ": "زيت الوقود, مازوت (منتج بترولي يُستخدم كوقود)",
 "ねんりん": "حلقة النمو, حلقة سنوية (تشكل سنوي للخشب في النباتات أثناء نموها)",
 "ねんりんねんだいがく": "علم تحديد أعمار الأشجار (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "ねんりんねんだいほう": "علم تحديد أعمار الأشجار (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "ねんれい": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة) / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "ねんれいさべつ": "تمييز عمري (التمييز على أساس عمر الشخص)",
 "ねんれいせいげん": "حَدّ السِّنّ, شَرْط السِّنّ (لائحة تحدد الحد الأقصى (أو الأدنى) للسن للقيام بشيء ما أو شغل منصب ما)",
 "ねんれいそう": "شريحة عمرية, فئة عمرية (مجموعة من الناس لديهم نفس العمر تقريباً)",
 "ねんをいれる": "أَعَارَ اِنْتِبَاه",
 "ねんをおす": "ذَكَّرَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "ねセロリ": "جذر الكرفس (جذر عطري صالح للأكل وسميك لنوع من نبات الكرفس) / كرفس جذري, كرفس لفتي (يزرع لجذره العطري السميك الصالح للأكل)",
 "ねー": "يَاه, اسمع / هَلَا / يَعْنِي / أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة! / مَعْدُوم / لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة.",
 "ねーねー": "يَاه, اسمع / هَلَا",
 "の": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل. / مُتَوَحِّش / بَرِّيّ / قصبة الريشة (العمود الفقري المجوف للريشة) / عمود دوار, عمود نقل الحركة (قضيب دوار ينقل الطاقة أو الحركة) / سارية, عمود (قضيب أو عمود طويل (خاصة مقبض أداة أو جسم سلاح مثل الرمح أو السهم)) / بئر, عمود (ممر رأسي طويل محفور في الأرض، كما لمنجم أو نفق) / وَحْدَة قِيَاس (أيّ قسمة للكمّيّة مقبولة معيارًا للقياس أو التبادل)\nمثال: この川の幅が１マイルある。 — عرض هذا النهر ميل.",
 "のあそび": "رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة) / رحلة خلوية, نزهة خلوية (يوم مخصص لتجمع اجتماعي في الهواء الطلق)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "のあまり": "اِسْتَبَدَّ (حزم ولم يتردد في اتخاذ القرار وتنفيذه؛ (في السياسة) حكم بنظام استبدادي)",
 "のいちご": "فراولة الغابات, فراولة برية (موطنها أوروبا)",
 "のいばら": "ورد متعدد الأزهار, ورد ياباني (ورد قوي النمو له عناقيد من الزهور الصغيرة العديدة؛ يستخدم للأسيجة وكأصل للتطعيم)",
 "のう": "مَوْهِبَة / دِمَاغ / مخ (دِمَاغ) / نفوخ / دِماغ / مُخ (دِمَاغ) / قَيْح, صَدِيد / زراعة, عمل في الأرض (الزراعة باعتبارها مهنة أو أسلوب حياة) / زراعة, فلاحة (ممارسة زراعة الأرض أو تربية الماشية)\nمثال: الزراعة حياة شاقة / غَامِق, دَاكِن / مركز, مكثف (متجمع معاً أو أقل تشتتاً) / مُرَكَّز (يَتَعَلَّق بِمَحْلُول تَمَّ تَقْلِيل تَخْفِيفِه) / مركز, مشبع (كونه المحلول الأكثر تركيزاً ممكناً عند درجة حرارة معينة؛ غير قادر على إذابة المزيد من المادة) / حاد, مباشر ((للضوء) ينتقل مباشرة من مصدر ضوء نقطي)\nمثال: جهودهم المركزة",
 "のういっけつ": "نزيف دماغي (نزيف من وعاء دموي ممزق في الدماغ)",
 "のうえん": "التهاب الدماغ (التهاب الدماغ عادة ما يسببه فيروس؛ تشمل الأعراض الصداع وألم الرقبة والنعاس والغثيان والحمى) / مَزْرَعَة / سِحْرِيّ, شَعْوَذِيّ (يمتلك أو يستخدم قوى خارقة للطبيعة أو يتسم بها) / سَاحِر, فَاتِن (يُسعد أو يَسحر من حوله)",
 "のうえんしゅ": "صاحب المزرعة (مالك أو مدير لمزرعة كبيرة (خاصة المزارع الاستعمارية أو الاستثمارية))",
 "のうおん": "توتر, شد عصبي ((علم النفس) حالة من الإجهاد العقلي أو العاطفي أو الترقب) / توتر, شد (الحالة الفيزيائية للتمدد أو الشد)\nمثال: عانى من التعب والتوتر العاطفي",
 "のうか": "فَلَّاح, فَلَّاحَة / بيت المزرعة (منزل لمزارع وعائلته) / غَلَّظَ / عَقَّدَ (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "のうかい": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام / تلفيف (طية محدبة أو ارتفاع في سطح الدماغ)",
 "のうかがく": "علوم الدماغ (فرع علم الأعصاب المعني بالدماغ)",
 "のうかがくしゃ": "عالم أعصاب (عالم أحياء عصبية يتخصص في دراسة الدماغ)",
 "のうかしん": "قوباء (عدوى جلدية معدية للغاية)",
 "のうかすいたい": "الغُدَّة النُخَامِيَّة",
 "のうかすいたいぜんよう": "غدة نخامية أمامية, نخامية أمامية (الفص الأمامي للغدة النخامية؛ ذو طبيعة غدية في المقام الأول)",
 "のうかん": "جِذْع الدِمَاغ (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر)",
 "のうかんし": "حفار قبور, متعهد دفن الموتى (شخص عمله إدارة الجنازات)",
 "のうがいこつ": "قحف (جزء الجمجمة الذي يغلف الدماغ)",
 "のうがき": "تباهي, تفاخر (الحديث عن النفس بصيغ التفخيم)",
 "のうがきをたれる": "تَبَاهَى",
 "のうがきをならべる": "تَبَاهَى",
 "のうがく": "زِرَاعَة, فِلَاحَة",
 "のうがくしゃ": "خبير زراعي, مهندس زراعي (خبير في إدارة التربة وإنتاج المحاصيل الحقلية)",
 "のうがくぶ": "وزارة الزراعة, وزارة الزراعة الأمريكية (الإدارة الفيدرالية التي تدير البرامج التي تقدم الخدمات للمزارعين (بما في ذلك البحوث وحفظ التربة وجهود تثبيت الاقتصاد الزراعي)؛ أنشئت عام 1862)",
 "のうがない": "عَاجِز, غَيْر مُؤَهَّل (لا يستوفي المتطلّبات اللازمة) / عاجز, غير كفء (غير مؤهل أو غير مناسب لغرض ما) / غير مؤهل, غير مختص قانونياً (غير مؤهل أو غير كافٍ قانونياً) / عَدِيم المَهَارَة, غَيْر كُفْء (لا يؤدي العمل بشكل جيد؛ يفتقر إلى الكفاءة)\nمثال: جهاز مخابرات غير كفء",
 "のうき": "مَوْعِد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد. / شكل الكلمة, صيغة (المظهر الصوتي أو الكتابي للكلمة الذي يمكن استخدامه لوصف أو تحديد شيء ما)",
 "のうきかいとう": "أدينوسين ثلاثي الفوسفات (نيوكليوتيد مشتق من الأدينوسين يوجد في الأنسجة العضلية؛ المصدر الرئيسي للطاقة للتفاعلات الخلوية)",
 "のうきげん": "مَوْعِد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "のうきゅう": "قبو (حزمة مقوسة من الألياف البيضاء في قاعدة الدماغ من خلالها يسقط الحصين في كل نصف كرة مخية إلى الحصين المقابل وإلى المهاد والأجسام الحلمية) / قبو (عموماً أي هيكل مقوس (لكن غالباً ما يشير إلى السقف المقوس لمساحة تشريحية))",
 "のうきょう": "جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "のうきん": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / حَمِيّ الطَّبْع, مُتَّقِدُ المَشَاعِر (ميّال إلى الانفعال والعاطفة الشديدة)",
 "のうきんしょう": "التهاب الدماغ (التهاب الدماغ عادة ما يسببه فيروس؛ تشمل الأعراض الصداع وألم الرقبة والنعاس والغثيان والحمى)",
