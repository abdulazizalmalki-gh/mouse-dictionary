 "なまめかしい": "سِحْرِيّ, شَعْوَذِيّ (يمتلك أو يستخدم قوى خارقة للطبيعة أو يتسم بها)",
 "なまもの": "فان, قابل للتلف (عرضة للهلاك؛ خاضع للدمار أو الموت أو التحلل)\nمثال: هذا الكوكب الدقيق والفاني",
 "なまやけ": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي)",
 "なまやさしい": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "なまゆで": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي)",
 "なまよい": "سكران قليلاً (من شرب الخمر حتى سَكِرَ)\nمثال: تبدو كأنها سكرانة.",
 "なまら": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه…)\nمثال: هو اغضبني حقا .",
 "なまり": "رَصَاص\nمثال: 鉛と金とでは、どちらが重いんですか。 — أيهما أثقل، الذهب أم الرصاص؟ / نَبْر, تَأْكِيد\nمثال: اجلس بشكل مريح. / لَهْجَة, الْعَامِّيَّة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية. / لحن, نطق خاطئ (نطق غير صحيح)",
 "なまりちくでんち": "بطارية الرصاص الحمضية (بطارية ذات أقطاب من الرصاص مع حمض الكبريتيك المخفف كإلكتروليت؛ كل خلية تولد…)",
 "なまりちゅうどく": "تسمم بالرصاص (حالة سامة تنتج عن امتصاص كمية زائدة من الرصاص في الجسم)",
 "なまりガラス": "زجاج رصاصي, كريستال رصاصي (زجاج يحتوي على أكسيد الرصاص؛ يمتاز بمعامل انكسار عالٍ)",
 "なまる": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد)\nمثال: كان هناك تردد في كلامه / أَخْفَى, خَبَأَ\nمثال: أين اختبأ ياني؟",
 "なまデータ": "بيانات خام (بيانات غير محللة؛ بيانات لم تخضع بعد للتحليل)",
 "なまビール": "بيرة البرميل, جعة مسكوبة (بيرة مسحوبة من برميل)",
 "なまライブ": "حَيِيَ, عَاشَ\nمثال: ينبح كلب في الحي.",
 "なみ": "لَوَّحَ, رَفْرَفَ / مَيْل, نَزَعَة / مُتَوَسِّط, مُعَدَّل / كُلّ",
 "なみうちぎわ": "شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة)…)\nمثال: عاد إلى الشاطئ.",
 "なみうつ": "تلاطم, موجة عارمة (موجة بحرية كبيرة) / لَوَّحَ, رَفْرَفَ\nمثال: 彼女は胸を波打たせた。 — رفعت صدرها.",
 "なみかぜ": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / مَشَقَّة, شِدَّة",
 "なみがしら": "رغوة الموج, زبد الموج (موجة تهب عليها الرياح فينكسر عرفها ويظهر أبيض اللون)",
 "なみがた": "مُمَوَّج (ذو تموّجات وتعرّجات متوازية على السطح)",
 "なみきじ": "شَارِع",
 "なみきどおり": "شَارِع",
 "なみきみち": "شَارِع",
 "なみけしブロック": "رباعي الأطراف (حيوان فقاري له أربعة أقدام أو أرجل أو زوائد تشبه الأرجل)",
 "なみしぶき": "رذاذ البحر (رذاذ من أمواج المحيط)",
 "なみする": "تَجَاهَلَ, طَنَّش",
 "なみた": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو…)\nمثال: مزق سامي الرسالة. / تَعَاطُف",
 "なみたいてい": "عَادِيّ, مَأْلُوف",
 "なみだ": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو…)\nمثال: مزق سامي الرسالة. / تَعَاطُف",
 "なみだぐましい": "مُؤَثِّر\nمثال: إياك ولمس شطيرتي!",
 "なみだする": "بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا.",
 "なみだつ": "تلاطم, موجة عارمة (موجة بحرية كبيرة) / لَوَّحَ, رَفْرَفَ",
 "なみだながら": "باكياً, والدموع في عينيه (مع الدموع؛ بطريقة دامعة)\nمثال: اعترف الرجل باكياً بضرب زوجته",
 "なみだもろい": "بكّاء",
 "なみなみ": "عَادِيّ, مَأْلُوف",
 "なみなみならぬ": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "なみのはな": "مِلْح, ملح",
 "なみのり": "رَكْمَجَة, رَكُوب أَمْوَاج",
 "なみのりいた": "لوح ركوب الأمواج (لوح ضيق طافٍ لركوب الأمواج)",
 "なみはずれ": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "なみはずれて": "بشكل استثنائي, بشكل غير مألوف (بشكل استثنائي)\nمثال: من الصعب بشكل استثنائي العثور على علاج شائع",
 "なみひととおり": "عَادِيّ, مَأْلُوف",
 "なみもり": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "なみよけ": "كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ)",
 "なみダッシュ": "تِلْدَة",
 "なむ": "آمْيْن (اسم فعل أمر مبن على الفتح بمعنى \"اسْتَجِبْ\"، تأتي في خاتمة الدعاء)\nمثال: اتصل زيري بالأمن.",
 "なむさん": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "なむさんぼう": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "なむたち": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "なむだち": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "なむち": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "なむなむ": "بَيْنَ بَيْنَ (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "なめ": "لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان) / فَظّ",
 "なめかける": "شَرِيط\nمثال: إرسم خط مستقيم.",
 "なめくさる": "تَرَفَّعَ",
 "なめくじうお": "رميح, سهيم (حيوان بحري صغير شفاف يشبه المشرط يحفر في الرمل؛ سلف بدائي للفقاريات)",
 "なめくじにしお": "خَائِبُ الأَمَل, مُنْكَسِر (مُنْخَفِضُ الرُّوحِ المَعْنَوِيَّة؛ مَكْسُورُ الخَاطِر)",
 "なめこ": "ناميكو (أحد أهم الفطريات المزروعة في اليابان)",
 "なめし": "دِبَاغَة",
 "なめしがわ": "جِلْد (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد.",
 "なめし皮": "جِلْد (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد.",
 "なめし革": "جِلْد (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد.",
 "なめす": "حِنْطِيّ",
 "なめて": "كُلّ, جَمِيع",
 "なめてかかる": "تَرَفَّعَ",
 "なめなめ": "جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة)\nمثال: كانت هزيمة بفارق ضئيل",
 "なめらか": "نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "なめる": "لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان)\nمثال: その子犬は彼女の頬を舐めた。 — الكلب لعق خدها. / حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو…)\nمثال: حسب سامي المال. / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / اِسْتَخَفَّ, اِسْتَهَانَ\nمثال: 俺をなめるな。 — لا تستخف بمقدرتي.",
 "なめプレイ": "جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة)\nمثال: كانت هزيمة بفارق ضئيل",
 "なめ腐る": "تَرَفَّعَ",
 "なも": "آمْيْن (اسم فعل أمر مبن على الفتح بمعنى \"اسْتَجِبْ\"، تأتي في خاتمة الدعاء)\nمثال: اتصل زيري بالأمن.",
 "なもない": "مَجْهُول, مُبْهَم",
 "なもなき": "غَيْر مُعَرَّف, مَجْهُول الهُوِيَّة (ذو مصدر مجهول أو غير مُسمَّى)",
 "なや": "حَظِيرَة, زَرِيبَة",
 "なやす": "وَرْشَة حِدَادَة",
 "なやましい": "جذاب, فاتن (يميل إلى إغراء شخص للقيام بعمل أو حالة مرغوبة) / مُزْعِج, مُقْلِق (يُسَبِّب القَلَق أو الانْزِعاج أو الكَرْب) / قَلِق, قَلِقَة (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "なやましげ": "قَلِق, قَلِقَة (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / شَوْق (نزوعُ النَّفْس إِلى الشيء، أو تَعَلُّقها به؛ مصدر الفعل شَاقَ)\nمثال: سأشعر بالشوق إليك.",
 "なやます": "عَذَاب",
 "なやみ": "مُشْكِلَة, مَتاعِب",
 "なやめる": "قَلِق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / عَذَاب",
 "なよっちい": "ضَعِيف",
 "なよなよ": "بدقة, برقة (بطريقة دقيقة)\nمثال: ملامح مشكلة بدقة",
 "なよやか": "رَشِيق, لَدْن ((عَنْ أَجْسَادِ الأَشْخَاصِ) قَادِرٌ عَلَى الحَرَكَةِ أَوِ الِانْثِنَاءِ…)",
 "なら": "إِنْ (يفيد التوكيد)\nمثال: إن شاء الله ؛ / أَمَّا ؛ فَـ (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ)\nمثال: أما زلت تذكرني؟ / بَلُّوط, سِنْدِيَان / نَارَا",
 "ならい": "كَمَا هُوَ, كَمَا هِيَ",
 "ならいごと": "تَنْفِيذ",
 "ならいしょう": "طبيعة ثانية (سلوك مكتسب تمت ممارسته لفترة طويلة لدرجة أنه يبدو فطريًا)",
 "ならう": "تَعَلَّمَ (اكتسب معرفة أو خبرة أو مهارة)\nمثال: هو سريع التعلم. / قَلَّدَ",
 "ならく": "جَهَنَّم, جَحِيم / النِهاية",
 "ならくのそこ": "هَاوِيَة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة)\nمثال: وصل سامي إلى قاع الهاوية ماليا.",
 "ならし": "مُتَوَسِّط, مُعَدَّل",
 "ならして": "مُرَوِّض",
 "ならす": "ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو…)\nمثال: للبقرة ذيل طويل. / أَلِيف\nمثال: إلى أية روضة ذهبت؟ / سَطَّح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)\nمثال: هناك ثقوب على السطح. / مُتَوَسِّط, مُعَدَّل / حَلْقَة / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / حَبَقَ, ضَرَطَ (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في…)",
 "ならずもの": "بلطجي, فتوة (رجل قاسٍ ووحشي)",
 "ならずものこっか": "دولة مارقة (دولة لا تحترم الدول الأخرى في أعمالها الدولية)",
 "ならず者": "بلطجي, فتوة (رجل قاسٍ ووحشي)",
 "ならず者国家": "دولة مارقة (دولة لا تحترم الدول الأخرى في أعمالها الدولية)",
 "ならたけ": "فطر العسل (فطر صالح للأكل بلون العسل يرتبط عادة بجذور الأشجار في أواخر الصيف والخريف؛ لا…)",
 "ならでは": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "ならない": "بِشَكْلٍ لَا يُطَاقُ / عَجَزَ, لَا يَسْتَطِيع / لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)",
 "ならぬ": "بِشَكْلٍ لَا يُطَاقُ / عَجَزَ, لَا يَسْتَطِيع / لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…) / بَعِيد المَنَال, مُسْتَحِيل التَّحْقِيق (يستحيل تحقيقه أو بلوغه)",
 "ならば": "إِنْ (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "ならび": "خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "ならびしょうされる": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "ならびしょうする": "صِنْف, صَنْف\nمثال: اقرأ هذا الفصل.",
 "ならびじゅん": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "ならびない": "فَرِيدٌ مِنْ نَوْعِه, لَا يُضَاهَى (مُتميّز جذريًّا وليس له مثيل أو نظير)",
 "ならびなき": "فَرِيدٌ مِنْ نَوْعِه, لَا يُضَاهَى (مُتميّز جذريًّا وليس له مثيل أو نظير)",
 "ならびに": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "ならぶ": "مُنَافِس",
 "ならべかえ": "نَوْع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر.",
 "ならべかえる": "إعادة طلب, طلب متكرر (طلب متكرر لنفس البضائع)\nمثال: هو الشخص الذي يرسل جميع الطلبات الجديدة وإعادة الطلب",
 "ならべかた": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "ならべたてる": "أَحْصَى (أَحْصَى: (فعل) أحصى يُحصي ، أحْصِ ، إحصاءً ، فهو مُحصٍ ، والمفعول مُحصًى)",
 "ならべる": "أَحْصَى (أَحْصَى: (فعل) أحصى يُحصي ، أحْصِ ، إحصاءً ، فهو مُحصٍ ، والمفعول مُحصًى)",
 "ならわし": "عَادَة, عُرْف",
 "ならん": "بِشَكْلٍ لَا يُطَاقُ / عَجَزَ, لَا يَسْتَطِيع / لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)",
 "ならんで": "تَزَامُنًا",
 "なり": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / مبلغ, مقدار من المال (كمية من المال)\nمثال: اقترض مبلغاً كبيراً / جهارة, دوي (امتلاك طابع صوت عميق وعالٍ؛ خاصية الرنين)\nمثال: الرنين المميز لجرس الكنيسة / رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة)\nمثال: وقف بوضعية جيدة / على سبيل المثال, مثلاً (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذ الثعابين الشريطية على سبيل المثال (يفيد الاستعلاء؛ يفيد التعليل) / مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟ / أُسْلُوب (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو…)\nمثال: هو يحب أسلوب معطوب. / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء…)",
 "なりあがり": "كيب, نهوض بالركل (تمرين جمباز يبدأ من وضع تكون فيه الساقان فوق الجزء العلوي من الجسم والتحرك إلى…)",
 "なりあがりもの": "كيب, نهوض بالركل (تمرين جمباز يبدأ من وضع تكون فيه الساقان فوق الجزء العلوي من الجسم والتحرك إلى…)",
 "なりかわる": "اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ. / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "なりきん": "كيب, نهوض بالركل (تمرين جمباز يبدأ من وضع تكون فيه الساقان فوق الجزء العلوي من الجسم والتحرك إلى…)",
 "なりくせ": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما)\nمثال: لديه مزاج سعيد",
 "なりけり": "فعل مساعد (فعل يندمج مع فعل آخر في عبارة فعلية للمساعدة في تشكيل الزمن أو الصيغة أو البناء…)",
 "なりこむ": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة.",
 "なりすがた": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب.",
 "なりすまし": "تَنَكَّرَ / بَارُودِيَا, مُحَاكَاة سَاخِرَة (تكوين يقلد أو يحرف أسلوب شخص ما، عادة بطريقة فكاهية)",
 "なりすます": "اِنْتَحَلَ",
 "なりたち": "مَنْشَأ / هَيْكَل",
 "なりと": "مُسَطَّح, مُنبَسِط\nمثال: انتظر حتى أجلس.",
 "なりとどろく": "صَدًى",
 "なりとも": "مُسَطَّح, مُنبَسِط\nمثال: انتظر حتى أجلس.",
 "なりなんとす": "اِقْتَرَبَ\nمثال: هو واصل الاقتراب مني.",
 "なりはためく": "صَدًى",
 "なりひびく": "صَدًى",
 "なりふり": "مَلَابِس, ثِيَاب",
 "なりません": "بِشَكْلٍ لَا يُطَاقُ / عَجَزَ, لَا يَسْتَطِيع / لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)",
 "なりもの": "آلَة مُوسِيقِيَّة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة. / حِصَاد\nمثال: حصد الفلاح القمح. / فَاكِهَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها)\nمثال: التفاح فاكهة لذيذة.",
 "なりものいり": "جذل, فانفار ((موسيقى) لحن حيوي قصير يُعزف على الآلات النحاسية)\nمثال: دخل على وقع نغمة احتفالية من الأبواق",
 "なりゆき": "طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ. / أمر بسعر السوق (أمر لوسيط ببيع أو شراء أسهم أو سلع بسعر السوق السائد)",
 "なりゆきちゅうもん": "أمر بسعر السوق (أمر لوسيط ببيع أو شراء أسهم أو سلع بسعر السوق السائد)",
 "なりゆきまかせ": "انجراف, تسكع (تجوال بلا هدف من مكان لآخر)",
 "なりをしずめる": "تَوَارَى عَنْ الْأَنْظَار",
 "なりをひそめる": "تَوَارَى عَنْ الْأَنْظَار",
 "なりを潜める": "تَوَارَى عَنْ الْأَنْظَار",
 "なり代わる": "اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "なり物": "حِصَاد\nمثال: حصد الفلاح القمح. / فَاكِهَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها)\nمثال: التفاح فاكهة لذيذة.",
 "なる": "صَارَ, أَصْبَحَ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما. / بَرْهَنَ, أَثْبَتَ / نَجَحَ / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / سليم\nمثال: اقرأ بصوت عالي. / يَعْنِي, أَي",
 "なるい": "خضراوات ورقية (أي من النباتات الورقية المختلفة أو أوراقها وسيقانها التي تؤكل كخضروات)",
 "なるかみ": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو…)\nمثال: البرق يسبق الرعد",
 "なるこ": "للسان الجرس, مصفق (مطرقة معدنية تتدلى داخل الجرس وتصدر صوتاً بضرب الجانب)",
 "なるこゆり": "خاتم سليمان, نجمة داود (نجمة سداسية مكونة من مثلثين متساويي الأضلاع)",
 "なると": "دَوَّامَة / نَارُوتُو",
 "なるときんとき": "بَطَاطَا حُلْوَة",
 "なると金時": "بَطَاطَا حُلْوَة",
 "なるはや": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "なるへそ": "بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك)\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "なるべくなら": "بالأحرى, يفضل (بشكل أكثر استعداداً أو رغبة)\nمثال: نظفه جيداً، يفضل بالماء الدافئ",
 "なるべくはやく": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "なるべく早く": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "なるほど": "بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك)\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "なる早": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "なれ": "تَدْرِيب (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة…)\nمثال: واصل زيري التدريب. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / مُلْصَق, بِطَاقَة",
 "なれあい": "تَوَاطُؤ / زواج عرفي, مساكنة (علاقة زواج تنشأ عن طريق الاتفاق والمساكنة بدلاً من المراسم)",
 "なれあう": "تَآمَرَ, اِئْتَمَرَ",
 "なれた": "أَلِيف / خبير, ذو خبرة (لديه خبرة؛ لديه معرفة أو مهارة من الملاحظة أو المشاركة)",
 "なれど": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "なれども": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "なれなれしい": "مُتَجَاوِز لِلحُدُود (يأخذ حريات غير لائقة في التعامل مع الآخرين)",
 "なればこそ": "وَحِيد",
 "なれる": "نَاضِج, رَاشِد / أَفْسَدَ, فَسَدَ",
 "なれ合い": "تَوَاطُؤ / زواج عرفي, مساكنة (علاقة زواج تنشأ عن طريق الاتفاق والمساكنة بدلاً من المراسم)",
 "なれ合う": "تَآمَرَ, اِئْتَمَرَ",
 "なわ": "حَبْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده…)\nمثال: حبل الكذب قصير.",
 "なわつき": "جِنَائِيّ, إِجْرَامِيّ",
 "なわとび": "نَط اَلْحَبْل",
 "なわぬけ": "هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "なわのれん": "حَانَة, بَار",
 "なわはしご": "سلم حبال (سلم ذو جوانب مصنوعة من الحبال)",
 "なわばしご": "سلم حبال (سلم ذو جوانب مصنوعة من الحبال)",
 "なわばり": "حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي)\nمثال: هناك خط رفيع بين العقل والجنون / مَجَال إِنْتَرْنَت\nمثال: هل تمثل الزراعة على نطاق واسع النظام البيئي في الجزائر؟ / إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو…)",
 "なわばりあらそい": "حَرْب نُفُوذ, صِرَاع سَيْطَرَة (صراع مرير على الأرض أو السلطة أو السيطرة أو الحقوق)\nمثال: اندلعت حرب نفوذ بين عصابات الشوارع",
 "なわめ": "عُقْدَة\nمثال: أمضى زيري العقد. / تَوْقِيف, اِعْتِقَال\nمثال: اعتقل لقيادته و هو سكران.",
 "なわもじ": "كيبو (آلة حاسبة تتكون من حبل بحبال ملحقة؛ استخدمها البيروفيون القدماء للحساب وحفظ…)",
 "なわをかける": "تَوْقِيف, اِعْتِقَال\nمثال: اعتقل لقيادته و هو سكران.",
 "なをん": "اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "なん": "صُعُوبَة / حَادِث\nمثال: لا تدعها للصدفة. / خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة…)\nمثال: كان خطأ حاسوبي. / نَقْد, اِنْتِقَاد / نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / اِبْن (الولد الذكر)\nمثال: هو له ابن صغير. / يَا لَ (يستعمل لنِدَاء البعيد والقريب)\nمثال: يا لها من جملة! / كَم\nمثال: ここの家、何匹猫がいるの？ — كم عدد القطط الموجودة في هذا المنزل ؟ / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / بَعْض, عِدَّة ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما)\nمثال: لديك بعض الكتب. / جَنُوبِيّ",
 "なんあり": "تالف, متضرر (تعرض للأذى أو الإصابة أو التلف)\nمثال: لن أشتري بضائع تالفة",
 "なんい": "صُعُوبَة",
 "なんおう": "أُورُوبَّا اَلْجَنُوبِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته…)\nمثال: ذهبت إلى أوروبا مرة.",
 "なんか": "شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء…)\nمثال: في يدها شيء ما. / بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما / مُلَطِّف, مُلَيِّن (يُنَعِّم ويُلَيِّن البَشَرَة أو الأنْسِجَة)\nمثال: أخر التبريد تليين الفاكهة / إضعاف (عملية تقليل قوة شيء ما) / قَرْع, يَقْطِين (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت…)\nمثال: توقف ذلك القرع. / بَنْكْنُوت, وَرَقَة نَقْدِيَّة",
 "なんかい": "كَم / غَيْرُ مَفْهُوم, مُعْتِم (صعب أو مستحيل الفهم والاستيعاب)\nمثال: كلام غير مفهوم",
 "なんかいか": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "なんかいでも": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "なんかいも": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "なんかげつ": "كَم",
 "なんかげつか": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "なんかげつも": "شَهْر (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر…)\nمثال: رمضان شهر حرام.",
 "なんかざい": "ملين, منعم (مادة تضاف إلى مادة أخرى لجعلها أقل صلابة)",
 "なんかしょう": "تلين (حالة من التلين غير الطبيعي للأنسجة)",
 "なんかなしに": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية)\nمثال: ألقى نظرة غير مبالية على العناوين",
 "なんかん": "حَاجِز",
 "なんきつ": "عَزْر",
 "なんきょう": "نَارَا",
 "なんきょく": "اَلْقُطْب اَلْجَنُوبِيّ / أَنْتَارْكْتِيكِيّ, قُطْبِيّ جَنُوبِيّ (عند القطب الجنوبي أو بالقرب منه)",
 "なんきょくかい": "اَلْمُحِيط اَلْمُتَجَمِّد اَلْجَنُوبِيّ, اَلْمُحِيط اَلْجَنُوبِيّ",
 "なんきょくけん": "الدَائِرَة القُطْبِيَّة الجَنُوبِيَّة",
 "なんきょくこう": "شفق قطبي جنوبي (الشفق القطبي في نصف الكرة الجنوبي)",
 "なんきょくせん": "الدَائِرَة القُطْبِيَّة الجَنُوبِيَّة",
 "なんきょくたいりく": "أَنْتَارْكِتِيكَا, الْقُطْبُ الْجَنُوبِيّ (القارة الأقصى جنوبًا؛ تقع جنوب المحيط المتجمد الجنوبي، وتحوي القطب الجنوبي)\nمثال: تكس هو طائر من أنتاركتيكا.",
 "なんきょくちほう": "أَنْتَارْكْتِيكِيّ, قُطْبِيّ جَنُوبِيّ (عند القطب الجنوبي أو بالقرب منه)",
 "なんきょくてん": "اَلْقُطْب اَلْجَنُوبِيّ",
 "なんきん": "إِقَامَة جَبْرِيَّة",
 "なんきんじょうたい": "إِقَامَة جَبْرِيَّة",
 "なんぎ": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا) / مُعَانَاة / الْتِبَاس, خَفَاء (صفة كون الشيء غير واضح أو عويصاً وصعب الفهم)\nمثال: أعجب عالم الأنثروبولوجيا بعمق الأمثال المحلية",
 "なんぎょう": "كَفَّارَة\nمثال: السر سيبقى سرا.",
 "なんぎょうくぎょう": "كَفَّارَة\nمثال: السر سيبقى سرا.",
 "なんぎょく": "نيفرِيت, يشم نيفريت (معدن أمفيبولي يتكون من سيليكات الكالسيوم والمغنيسيوم في شكل بلوري أحادي الميل…)",
 "なんくせ": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة…)\nمثال: كان خطأ حاسوبي.",
 "なんくせつける": "لَوْم, مَلَامَة",
 "なんくせをつける": "لَوْم, مَلَامَة",
 "なんけん": "تذكرة قطار (تذكرة صالحة لركوب القطار)",
 "なんこ": "كَم",
 "なんこう": "شفق قطبي جنوبي (الشفق القطبي في نصف الكرة الجنوبي) / مُتَّجِه جَنُوبًا (يتحرك باتجاه الجنوب) / مَرْهَم, دَهُون / صلب طري, فولاذ لين (فولاذ يحتوي على أقل من 0.15% كربون)",
 "なんこうがい": "حَنَك رَخُو ((حَنَكَت) الْأُم الصَّبِي حنكا: دلكت حنكه؛ (حَنَكَ) فُلَان الدَّابَّة: جعل…)",
 "なんこうがいおん": "طَبَقِيّ",
 "なんこうざい": "مَرْهَم, دَهُون",
 "なんこうふらく": "لَا يُقْهَر, مَنِيع (لَا يُمْكِنُ التَّغَلُّبُ عَلَيْهِ أَوْ تَحَدِّيهِ أَوْ دَحْضُهُ)",
 "なんこつ": "غُضْرُوف (مادة قاسية مرنة تُكوِّن هياكل أو أجزاء من هياكل الفقاريات. تُشكل غالبية هياكل…) / غضروف (نسيج مرن قوي؛ يتحول معظمه إلى عظم عند البالغين)",
 "なんこつぎょるい": "سمكة غضروفية (أسماك قد يكون هيكلها متكلسًا ولكنه غير متعظم)",
 "なんこつけいせいふぜんしょう": "الودانة, لاتصنع غضروفي (اضطراب هيكلي وراثي يبدأ قبل الولادة حيث يتحول الغضروف إلى عظم مما يؤدي إلى…)",
 "なんこつしゅ": "ورم غضروفي (ورم حميد شائع يتكون من خلايا غضروفية)",
 "なんこつむけいせいしょう": "الودانة, لاتصنع غضروفي (اضطراب هيكلي وراثي يبدأ قبل الولادة حيث يتحول الغضروف إلى عظم مما يؤدي إلى…)",
 "なんご": "كلمات معسولة, همسات الحب (تعبيرات عاطفية غير مهمة المضمون)\nمثال: همس بكلمات معسولة في أذنها / ثَرْثَرَة, مُنَاغَاة (رطانة تشبه أصوات الطفل) / كَم",
 "なんごしゅう": "مَسْرَد",
 "なんざ": "وَهٰكَذَا, وَهَلُمَّ جَرًّا / أشباه, أمثال (نوع مماثل)\nمثال: الكلاب والثعالب وما شابه ذلك",
 "なんざあ": "وَهٰكَذَا, وَهَلُمَّ جَرًّا / أشباه, أمثال (نوع مماثل)\nمثال: الكلاب والثعالب وما شابه ذلك",
 "なんざい": "خشب لين (خشب يسهل نشره (من الصنوبريات مثل الصنوبر أو التنوب))",
 "なんざんのじゅ": "أقدمية, طول العمر (خاصية العيش طويلاً)\nمثال: طول بقائها كنجمة",
 "なんし": "جَنُوب الصِّين (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "なんしき": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "なんしきひこうせん": "مُنْطَاد ذُو مُحَرِّك",
 "なんしつ": "نُعُومَة",
 "なんしつこむぎ": "قمح طري (قمح ذو حبات نشوية طرية يستخدم في المعجنات وحبوب الإفطار)",
 "なんしつガラス": "زجاج لين (زجاج ذو نقطة تليين منخفضة نسبياً)",
 "なんしゅ": "كَم",
 "なんしょう": "نَانْتْشَانْغ",
 "なんしょうかせい": "عسير الهضم, غير قابل للهضم (يتم هضمه بصعوبة)",
 "なんしょく": "لِوَاط / إدانة, استهجان (فعل الاستهجان أو الإدانة) / كَم",
 "なんじ": "صعب المراس, عنيد (غير طيع؛ صعب الإدارة أو التشكيل)\nمثال: طبع عنيد / عَاصٍ / صُعُوبَة / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "なんじかん": "كَم",
 "なんじじしんをしれ": "رحم الله امرَأً عرف قدر نفسه (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى…)\nمثال: رحمة الله عليه.",
 "なんじなんぷん": "مَتَى",
 "なんじみずからをしれ": "رحم الله امرَأً عرف قدر نفسه (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى…)\nمثال: رحمة الله عليه.",
 "なんじゃ": "يَا لَ (يستعمل لنِدَاء البعيد والقريب)\nمثال: يا لها من جملة!",
 "なんじゃく": "ضَعِيف / عَدِيم الأَشْوَاك (خالٍ من الأشواك أو الإبر)\nمثال: كان دودة صفراء عديمة الشجاعة",
 "なんじゃくがいこう": "خَوَّارُ الْعَزِيمَةِ (يفتقر إلى قوة الإرادة والعزيمة)",
 "なんじゃくもの": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "なんじゅう": "مُعَانَاة / عَشَرَة, عَشْرَة",
 "なんじょう": "هُنَاكَ, يُوجَدُ",
 "なんじる": "اِنْتَقَدَ",
 "なんす": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "なんすい": "ماء يسر (ماء ليس عسراً (لا يحتوي على أملاح معدنية تتداخل مع تكوين الرغوة مع الصابون))",
 "なんずる": "اِنْتَقَدَ",
 "なんせ": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "なんせい": "نُعُومَة / باتجاه الجنوب الغربي (إلى أو نحو أو في الجنوب الغربي) / حملة, حملة عسكرية (عدة عمليات مترابطة تهدف إلى تحقيق هدف معين (عادة ضمن قيود جغرافية وزمنية))",
 "なんせいぶ": "باتجاه الجنوب الغربي (إلى أو نحو أو في الجنوب الغربي)",
 "なんせっけん": "صابون طري (صابون طري (أو سائل) مصنوع من زيوت نباتية؛ يستخدم في بعض الأمراض الجلدية)",
 "なんせん": "حُطَام سَفِينَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد) / كُورِيَا الْجَنُوبِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة…)\nمثال: أريد أن أزور كوريا.",
 "なんぞ": "وَهٰكَذَا, وَهَلُمَّ جَرًّا / شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء…)\nمثال: في يدها شيء ما. / يَا لَ (يستعمل لنِدَاء البعيد والقريب)\nمثال: يا لها من جملة! / لِمَاذَا\nمثال: لم يساعدني أحد.",
 "なんぞや": "يَا لَ (يستعمل لنِدَاء البعيد والقريب)\nمثال: يا لها من جملة! / لِمَاذَا\nمثال: لم يساعدني أحد.",
 "なんたいせいぶつ": "رِخْوِيّ",
 "なんたいどうぶつ": "رِخْوِيّ",
 "なんたいどうぶつがく": "علم الرخويات (فرع علم الحيوان الذي يدرس بنية وسلوك الرخويات)",
 "なんたって": "مَهْمَا",
 "なんたる": "يَا لَ (يستعمل لنِدَاء البعيد والقريب)\nمثال: يا لها من جملة!",
 "なんたん": "فحم بتوميني, فحم قاري (فحم غني بالهيدروكربونات القطرانية؛ يحترق بسهولة بلهب أصفر مدخن)",
 "なんだ": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو…)\nمثال: مزق سامي الرسالة. / تَعَاطُف / وَا, يَا يَاه\nمثال: آه ، هناك فراشة! / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ)",
 "なんだい": "تَحَدٍّ, التَّحَدِّي",
 "なんだか": "صَغِير, صغير",
 "なんだかんだいっても": "مَهْمَا",
 "なんだかんだ言っても": "مَهْمَا",
 "なんだって": "أَيُّ شَيْءٍ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "なんち": "صعب المراس, عنيد (غير طيع؛ صعب الإدارة أو التشكيل)\nمثال: طبع عنيد / عَاصٍ",
 "なんちせい": "استعصاء, جموح (سمة صعوبة التأثير أو السيطرة)",
 "なんちゃって": "بَدِيل, رَدِيء (اصطناعي ورديء الجودة؛ بديل أقل قيمة)",
 "なんちゃら": "شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء…)\nمثال: في يدها شيء ما.",
 "なんちゅう": "إتمام, إكمال (إجراء ختامي أو نهائي)\nمثال: مشهد فراش الموت هو ذروة المسرحية / كَيْف, ازاي",
 "なんちょう": "صَمَم / ضَعِيف / نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / بِلْيُون (مَلْيُونُ مَلْيُونٍ (بريطانيا)؛ الف مِلْيون أي مِلْيار (الولايات المتحدة…)\nمثال: الشركة عانت من خسارة واحد بليون ين السنة الماضية.",
