{
 "なにやら": "شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما.",
 "なにゆえ": "لِمَاذَا / لِمَ (جَمَعَ، ضَمَّ) / علاش / علاه\nمثال: لم يساعدني أحد.",
 "なにゆえに": "لِمَاذَا / لِمَ (جَمَعَ، ضَمَّ) / علاش / علاه\nمثال: لم يساعدني أحد.",
 "なにより": "الأهم, قبل كل شيء (فوق كل اعتبار آخر) / أولاً وأخيراً, قبل كل شيء (بأخذ كل شيء معاً)\nمثال: قبل كل شيء، يجب أن تكون مستقلاً / أَفْضَل",
 "なによりも": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض",
 "なによりもまず": "بَادِئَ ذِي بَدْءٍ",
 "なにら": "أبداً",
 "なにわいばら": "ورد شيروكي (ورد متسلق صيني ذو أزهار بيضاء عطرة)",
 "なにを": "لِمَاذَا / لِمَ (جَمَعَ، ضَمَّ) / علاش / علاه\nمثال: لم يساعدني أحد.",
 "なにをいうてんねん": "مَاذَا بِحَقّ اَلسَّمَاء (أداة استفهام)\nمثال: ماذا تريد الآن؟",
 "なにをいうとんねん": "مَاذَا بِحَقّ اَلسَّمَاء (أداة استفهام)\nمثال: ماذا تريد الآن؟",
 "なにをいってんねん": "مَاذَا بِحَقّ اَلسَّمَاء (أداة استفهام)\nمثال: ماذا تريد الآن؟",
 "なにをするにも": "مَهْمَا",
 "なにをゆうてんねん": "مَاذَا بِحَقّ اَلسَّمَاء (أداة استفهام)\nمثال: ماذا تريد الآن؟",
 "なの": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "なのしれた": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "なので": "لِأَنَّ / هكذا, بلا سبب / إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "なのとおった": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "なのめ": "قُطْرِيّ, مَائِل (ذو اتِّجاه مائل أو منحرف عن الأفق) / مُحَرَّف, مُشَوَّه (تم تغيير معناه المقصود أو تشويهه) / مَعِيب الشَّكْل, مُشَوَّه (سيّئ التكوين إلى حدّ القبح)",
 "なのめならず": "بشكل غير عادي, بشكل لافت (لدرجة أو مدى ملحوظ)\nمثال: كانت طويلة بشكل غير عادي",
 "なのる": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "なは": "نَاهَا",
 "なはる": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "なばかり": "اسمياً فقط, بالاسم (باللقب أو السمعة ولكن ليس في الواقع)\nمثال: هو طبيب بالاسم فقط",
 "なびかす": "أَغْرَى, أَغْوَى",
 "なびかせる": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة.",
 "なびく": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / أَطَاعَ",
 "なふだ": "بطاقة الاسم (بطاقة تظهر اسم الشخص الذي يرتديها)",
 "なぶりもの": "أضحوكة, هدف السخرية (ضحية للسخرية أو المقالب)",
 "なぶり者": "أضحوكة, هدف السخرية (ضحية للسخرية أو المقالب)",
 "なぶる": "إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات مستمرة) / غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال) / مستفز, مشاكس (شخص يميل إلى المشاكسة (عن طريق السخرية أو إثارة الفضول))\nمثال: تجاهل تهكمهم / تَهَكَّمَ, سَخِرَ (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى عَلَيْهِ، عَبَثَ بِهِ. تَهَكَّمَ صَاحِبَهُ)",
 "なへに": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)",
 "なへん": "أَيْن, فين / حَيْثُ",
 "なべ": "مِقْلَاة (وعاء قلي الطعام) / ينتقد بشدَة / يَخْنَة",
 "なべかま": "آنية مطبخ, أداة مطبخ (أداة تستخدم في إعداد الطعام)",
 "なべこう": "لقلق أسود (لقلق من العالم القديم أسود لامع من الأعلى وأبيض من الأسفل)",
 "なべて": "بشكل عام, عموماً (دون تمييز واحد عن الآخرين)\nمثال: هو مهتم بالثعابين بشكل عام",
 "なべに": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)",
 "なべもの": "يَخْنَة",
 "なべりょうり": "هوت بوت (يخنة من اللحم والبطاطس مطبوخة في قدر محكم الغطاء)",
 "なべパ": "هوت بوت (يخنة من اللحم والبطاطس مطبوخة في قدر محكم الغطاء)",
 "なべパーティ": "هوت بوت (يخنة من اللحم والبطاطس مطبوخة في قدر محكم الغطاء)",
 "なべパーティー": "هوت بوت (يخنة من اللحم والبطاطس مطبوخة في قدر محكم الغطاء)",
 "なべ物": "يَخْنَة",
 "なま": "خَام (وَخُمَ أو وَبِئَ؛ أقام في المكان أو استقر فيه)\nمثال: تنقل السفن المواد الخام من أندونيسيا. / طَبِيعِيّ / غير محمي, مكشوف (يفتقر للحماية أو الدفاع) / حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي.",
 "なまあげ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "なまあたたか": "فَاتِر (الفَاتِرُ : ما بينَ الحارِّ والبارِد؛ \" اُسْتُقْبِلَ اسْتِقْبَالاً فَاتِراً \": بَارِداً لاَحَرَارَةَ فِيهِ)",
 "なまあたたかい": "فَاتِر (الفَاتِرُ : ما بينَ الحارِّ والبارِد؛ \" اُسْتُقْبِلَ اسْتِقْبَالاً فَاتِراً \": بَارِداً لاَحَرَارَةَ فِيهِ)",
 "なまいき": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق) / خَارِجِيّ, غَيْرُ جَوْهَرِيّ (لا يتعلق بالمسألة قيد البحث) / جَرِيءُ اللِّسَان, وَقِح (يتّسم بخفّة وقحة ومرح طافح)",
 "なまいきざかり": "قَلِيل الأَدَب, وَقِح (جريء بشكل مسيء وبذيء)",
 "なまうお": "وقود المدافع (جنود يُعتبرون قابلين للتضحية بهم في مواجهة نيران المدفعية)",
 "なまえ": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟ / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "なまえくうかん": "نِطَاقُ الْأَسْمَاء (الحزام المصنوع من القماش ليس له إبزيم ولا ما أشبه؛ قطعة من القماش تُلفّ على وسط الإنسان. الجمع نُطُق؛ في : هو جزء الدائرة كسطح (ليس قوس)؛ يقال أيضا قطاع. الجمع نطاقات)\nمثال: هل تمثل الزراعة على نطاق واسع النظام البيئي في الجزائر؟",
 "なまえだけ": "اسمياً فقط, بالاسم (باللقب أو السمعة ولكن ليس في الواقع)\nمثال: هو طبيب بالاسم فقط",
 "なまえつき": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟",
 "なまえをつける": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟",
 "なまかじり": "إلمام بسيط, معرفة سطحية (فهم طفيف أو سطحي لموضوع ما) / حفنة, قلة (عدد أو كمية صغيرة)\nمثال: تم تلقي حفنة فقط من الردود / بط مخوض (أي من العديد من بط المياه الضحلة الذي يتغذى عن طريق قلب جسمه والخوض في الماء) / متطفل, هاوٍ غير جدي (هاوٍ ينخرط في نشاط دون نوايا جادة ويدعي المعرفة)",
 "なまかわ": "جلد خام (جلد غير مدبوغ خاصة للماشية؛ يقطع إلى شرائط ويستخدم للسياط والحبال)",
 "なまくら": "كَلِيل / كَسْلَان",
 "なまぐさい": "مُثِيرٌ لِلشُّبْهَة, مُرِيب (ليس كما هو متوقّع؛ يبعث على الريبة) / زفر, سمكي (مكون من أو متعلق بـ أو يشبه السمك)\nمثال: كان للحساء رائحة سمكية / فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف) / منحرف (شخص ينحرف سلوكه عما هو مقبول خاصة في السلوك الجنسي) / دُنْيَوِيّ",
 "なまけぐせ": "بُطْء",
 "なまけぐま": "دب الكسلان (دب شائع خشن الشعر طويل الخطم من جنوب وسط آسيا)",
 "なまける": "مُتَرَاخٍ, مُتَسَاهِل (يَفْتَقِر إِلَى الصَّرَامَة أَوِ الدِّقَّة) / بَطِيء الجَرَيَان (يسيل بسرعة ضئيلة كما عند تحوُّل المدّ) / فَضْفَاض, مُرْتَخٍ (غَيْرُ مَشْدُودٍ وَلَا مُتَوَتِّر) / الجزء المرتخي (حبل أو خيط أو كابل يتدلى باسترخاء)\nمثال: قام بسحب الجزء المرتخي / أَهْمَلَ / إِهْمَال",
 "なまこいた": "حديد مموج, صاج معرج (عادة ما يكون صفائح حديد أو صلب مجلفنة مشكلة في تلال وتجاويف متوازية مستقيمة)",
 "なまこうり": "خيار البحر (الإسم من الإختيار ، وهو إنتقاء شيء فيكون خير من غيره؛ صيغة جمع لخير ، بمعنى أفضل)\nمثال: لم يكن لدي خيار.",
 "なまこばん": "حديد مموج, صاج معرج (عادة ما يكون صفائح حديد أو صلب مجلفنة مشكلة في تلال وتجاويف متوازية مستقيمة)",
 "なまこ板": "حديد مموج, صاج معرج (عادة ما يكون صفائح حديد أو صلب مجلفنة مشكلة في تلال وتجاويف متوازية مستقيمة)",
 "なまごみしょりき": "طاحنة نفايات, فرامة مخلفات (جهاز مطبخ للتخلص من مخلفات الطعام)",
 "なまごろし": "الليمبو ((اللاهوت) في الكاثوليكية الرومانية، مكان الأرواح غير المعمدة ولكن البريئة أو الصالحة (مثل الرضع والأفراد الفاضلين)) / إهمال, نسيان (مكان خيالي للأشياء المفقودة أو المهملة) / طي الكتمان, نسيان (حالة كونه مهملاً أو منسياً)",
 "なまざかな": "وقود المدافع (جنود يُعتبرون قابلين للتضحية بهم في مواجهة نيران المدفعية)",
 "なまじ": "باستهتار, بلا تفكير (إظهار عدم التفكير) / دون تفكير (بطريقة خالية من التفكير)\nمثال: عامل والديه باستهتار / فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط",
 "なまじい": "باستهتار, بلا تفكير (إظهار عدم التفكير) / دون تفكير (بطريقة خالية من التفكير)\nمثال: عامل والديه باستهتار / فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط",
 "なまじっか": "باستهتار, بلا تفكير (إظهار عدم التفكير) / دون تفكير (بطريقة خالية من التفكير)\nمثال: عامل والديه باستهتار / فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط",
 "なまじろい": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "なまず": "سَلُّور / زَلْزَال, زِلْزال (فِي : ظاهرة طبيعية وهو اهتزاز أو سلسلة من الاهتزازات الارتجاجية المتتالية لسطح تحدث في وقت لا يتعدى ثواني معدودة…)\nمثال: دمر زلزال عيادة سامي.",
 "なまぜん": "مُتَسَمٍّ, مُدَّعٍ (كما يدّعيه المرء لنفسه في كثير من الأحيان دون مبرّر)",
 "なまち": "شريان الحياة, عصب الحياة (قوة أساسية أو مانحة للحياة) / دم الحياة, شريان الحياة (الدم باعتباره قوام الحياة والحيوية)\nمثال: الماء هو شريان الحياة في الهند",
 "なまちゅう": "مُتَوَسِّطُ الْحَجْمِ (متوسط في الحجم)",
 "なまっちょろい": "فَاتِرُ الهِمَّة, مُتَرَدِّد (يشعر أو يُظهِر اهتماماً أو حماسة قليلة)",
 "なまっちろい": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "なまつば": "لُعَاب, رِيق",
 "なまづめ": "ظُفْر (الجزء المتقرن الميت على طرف الأصبع من الإنْسَان وبعض الحَيْوَانَات)\nمثال: نبت ظفر أصبع رجلي الكبير.",
 "なまなか": "مُتَوَسِّط / بفتور, بقلب غير حاضر (بدون حماس؛ بطريقة فاترة)\nمثال: حاولت بفتور",
 "なまなましい": "حَيّ اللَّوْن, زَاهٍ ((للألوان) ذو أعلى درجة تشبع لوني) / زَاهٍ, سَاطِع (ذو ألوان قويّة وزاهية) / حَيّ, نَابِض (ذو وضوح ونضارة كأنّه تجربة مباشرة) / حَيّ, نَابِض (يستحضر صورًا حيّة ونابضة في الذهن) / طَازَج, طَازَة / عَذْب",
 "なまなり": "غير مكتمل, غير منتهٍ (لم يتم الانتهاء منه أو اختتامه) / غير تام الصنع, غير جاهز (لم يتم إيصاله للحالة النهائية المطلوبة) / خَامّ, غَيْرُ مَطْلِيّ (يَفْتَقِرُ إِلَى تَشْطِيبٍ سَطْحِيٍّ كَالطِّلَاء)\nمثال: أعمال غير منتهية",
 "なまなれ": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "なまにえ": "نَادِر / غَامِض / غير مكسو بالريش, غير ناضج ((عن الطيور) لم تطور ريشاً بعد) / غير ناضج (لم ينضج بعد) / طفولي, غير ناضج (من سمات الافتقار إلى النضج) / غير ناضج, فج (غير مكتمل النمو أو النضج؛ غير يانع)\nمثال: عصفور صغير غير مكسو بالريش على حافة النافذة",
 "なまにく": "لحم نيء (لحم غير مطبوخ)",
 "なまぬるい": "فَاتِر (الفَاتِرُ : ما بينَ الحارِّ والبارِد؛ \" اُسْتُقْبِلَ اسْتِقْبَالاً فَاتِراً \": بَارِداً لاَحَرَارَةَ فِيهِ) / فَاتِرُ الهِمَّة, مُتَرَدِّد (يشعر أو يُظهِر اهتماماً أو حماسة قليلة) / لَيِّن, مُتَسَاهِل (يتّسم بالتسامح والرحمة في التعامل) / لَيِّن, مُتَسَاهِل (غَيْرُ صَارِمٍ فِي تَطْبِيقِ القَوَاعِد) / لَيِّن, مُتَسَامِح (متسامح ورحيم في المعاملة)",
 "なまのみこみ": "سَطْحِيّ",
 "なまはいしん": "بَثّ مُبَاشِر (نشر أو أذاع خبرًا أو معلومة؛ أرسل إشارات أو موجات عبر وسيط معين)\nمثال: لبث ياني مكانه.",
 "なまはいしんライブ": "بَثّ مُبَاشِر (نشر أو أذاع خبرًا أو معلومة؛ أرسل إشارات أو موجات عبر وسيط معين)\nمثال: لبث ياني مكانه.",
 "なまはんか": "سَطْحِيّ",
 "なまびょうほうはおおけがのもと": "قَلِيلًا",
 "なまふ": "غلوتين القمح (غلوتين محضر من القمح)",
 "なまへんじ": "فَاتِرُ الهِمَّة, مُتَرَدِّد (يشعر أو يُظهِر اهتماماً أو حماسة قليلة)",
 "なまぽ": "رعاية اجتماعية, رفاه اجتماعي (توفير حكومي للمساعدة الاقتصادية للأشخاص المحتاجين)\nمثال: هي تعيش على الإعانة الاجتماعية",
 "なまみ": "حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي. / خَام (وَخُمَ أو وَبِئَ؛ أقام في المكان أو استقر فيه)\nمثال: تنقل السفن المواد الخام من أندونيسيا.",
 "なまめかしい": "سِحْرِيّ, شَعْوَذِيّ (يمتلك أو يستخدم قوى خارقة للطبيعة أو يتسم بها) / سَاحِر, فَاتِن (يُسعد أو يَسحر من حوله)",
 "なまもの": "فان, قابل للتلف (عرضة للهلاك؛ خاضع للدمار أو الموت أو التحلل) / طعام قابل للتلف (طعام سيفسد بسرعة إذا لم يبرد)\nمثال: هذا الكوكب الدقيق والفاني",
 "なまやけ": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "なまやさしい": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "なまゆで": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي)",
 "なまよい": "سكران قليلاً (من شرب الخمر حتى سَكِرَ)\nمثال: تبدو كأنها سكرانة.",
 "なまら": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا .",
 "なまり": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)\nمثال: 鉛と金とでは、どちらが重いんですか。 — أيهما أثقل، الذهب أم الرصاص؟ / نَبْر, تَأْكِيد / شَكْل, شَكْلَة ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ) / نَبْر\nمثال: اجلس بشكل مريح. / لَهْجَة, الْعَامِّيَّة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية. / لحن, نطق خاطئ (نطق غير صحيح)",
 "なまりちくでんち": "بطارية الرصاص الحمضية (بطارية ذات أقطاب من الرصاص مع حمض الكبريتيك المخفف كإلكتروليت؛ كل خلية تولد حوالي 2 فولت)",
 "なまりちゅうどく": "تسمم بالرصاص (حالة سامة تنتج عن امتصاص كمية زائدة من الرصاص في الجسم)",
 "なまりガラス": "زجاج رصاصي, كريستال رصاصي (زجاج يحتوي على أكسيد الرصاص؛ يمتاز بمعامل انكسار عالٍ)",
 "なまる": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد)\nمثال: كان هناك تردد في كلامه / أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟",
 "なまデータ": "بيانات خام (بيانات غير محللة؛ بيانات لم تخضع بعد للتحليل)",
 "なまビール": "بيرة البرميل, جعة مسكوبة (بيرة مسحوبة من برميل)",
 "なまライブ": "حَيِيَ, عَاشَ / يَنْجُو / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مُباشِر\nمثال: ينبح كلب في الحي.",
 "なみ": "لَوَّحَ, رَفْرَفَ / مَوْج, مَوْجَة / مَيْل, نَزَعَة / مُتَوَسِّط, مُعَدَّل / كُلّ",
 "なみうちぎわ": "شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة) المنطقة اليابسة على طول حافة النهر. ضِفَّة، جَانِب، شَطّ) / سَاحِل\nمثال: عاد إلى الشاطئ.",
 "なみうつ": "تلاطم, موجة عارمة (موجة بحرية كبيرة) / لَوَّحَ, رَفْرَفَ / مَوْج, مَوْجَة\nمثال: 彼女は胸を波打たせた。 — رفعت صدرها.",
 "なみかぜ": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / تضارب, تنافر (خليط حاد ومزعج من الأصوات) / تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / خلاف, شقاق (عدم الاتفاق أو الانسجام) / مَشَقَّة, شِدَّة",
 "なみがしら": "رغوة الموج, زبد الموج (موجة تهب عليها الرياح فينكسر عرفها ويظهر أبيض اللون)",
 "なみがた": "مُمَوَّج (ذو تموّجات وتعرّجات متوازية على السطح)",
 "なみきじ": "شَارِع",
 "なみきどおり": "شَارِع",
 "なみきみち": "شَارِع",
 "なみけしブロック": "رباعي الأطراف (حيوان فقاري له أربعة أقدام أو أرجل أو زوائد تشبه الأرجل)",
 "なみしぶき": "رذاذ البحر (رذاذ من أمواج المحيط)",
 "なみする": "تَجَاهَلَ, طَنَّش",
 "なみた": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة. / تَعَاطُف / عَطْف (عِطْف: عُنُق، رَقبة؛ الجمع: أَعْطَافٌ، و عِطَافٌ، و عُطُوفٌ) / حُنُو",
 "なみたいてい": "عَادِيّ, مَأْلُوف",
 "なみだ": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة. / تَعَاطُف / عَطْف (عِطْف: عُنُق، رَقبة؛ الجمع: أَعْطَافٌ، و عِطَافٌ، و عُطُوفٌ) / حُنُو",
 "なみだぐましい": "مُؤَثِّر / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي!",
 "なみだする": "بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه) / بكاء\nمثال: بكى زيري كثيرا.",
 "なみだつ": "تلاطم, موجة عارمة (موجة بحرية كبيرة) / لَوَّحَ, رَفْرَفَ / مَوْج, مَوْجَة",
 "なみだながら": "باكياً, والدموع في عينيه (مع الدموع؛ بطريقة دامعة)\nمثال: اعترف الرجل باكياً بضرب زوجته",
 "なみだもろい": "بكّاء",
 "なみなみ": "عَادِيّ, مَأْلُوف",
 "なみなみならぬ": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "なみのはな": "مِلْح, ملح / مَلَّحَ",
 "なみのり": "رَكْمَجَة, رَكُوب أَمْوَاج",
 "なみのりいた": "لوح ركوب الأمواج (لوح ضيق طافٍ لركوب الأمواج)",
 "なみはずれ": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "なみはずれて": "بشكل استثنائي, بشكل غير مألوف (بشكل استثنائي)\nمثال: من الصعب بشكل استثنائي العثور على علاج شائع",
 "なみひととおり": "عَادِيّ, مَأْلُوف",
 "なみもり": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "なみよけ": "كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ)",
 "なみダッシュ": "تِلْدَة",
 "なむ": "آمْيْن (اسم فعل أمر مبن على الفتح بمعنى \"اسْتَجِبْ\"، تأتي في خاتمة الدعاء) / آمِين (اسم فعل أمر مبن على الفتح بمعنى \"اسْتَجِبْ\"، تأتي في خاتمة الدعاء) / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن.",
 "なむさん": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "なむさんぼう": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "なむたち": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "なむだち": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "なむち": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "なむなむ": "بَيْنَ بَيْنَ (ظرف مكان بمعنى وَسْط) / نِصْف نِصْف, نُصّ نُصّ\nمثال: مصيري بين يديك.",
 "なめ": "لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان) / فَظّ",
 "なめかける": "شَرِيط / قِطَاع / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "なめくさる": "تَرَفَّعَ",
 "なめくじうお": "رميح, سهيم (حيوان بحري صغير شفاف يشبه المشرط يحفر في الرمل؛ سلف بدائي للفقاريات)",
 "なめくじにしお": "خَائِبُ الأَمَل, مُنْكَسِر (مُنْخَفِضُ الرُّوحِ المَعْنَوِيَّة؛ مَكْسُورُ الخَاطِر)",
 "なめこ": "ناميكو (أحد أهم الفطريات المزروعة في اليابان)",
 "なめし": "دِبَاغَة",
 "なめしがわ": "جِلْد (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة) / جِلْدِيّ\nمثال: هذا حزام من الجلد.",
 "なめし皮": "جِلْد (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة) / جِلْدِيّ\nمثال: هذا حزام من الجلد.",
 "なめし革": "جِلْد (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة) / جِلْدِيّ\nمثال: هذا حزام من الجلد.",
 "なめす": "حِنْطِيّ / قَمْحِيُّ اللَّوْن / اِسْمَرَّ / دَبَغَ (عالجه بمادة ليلين وَيَزُول مَا بِهِ من رُطُوبَة ونتن؛ دبغ الْمَطَر الأَرْض بمائه فَهُوَ دابغ ودبوغ وَالْمَفْعُول مدبوغ ودبيغ)",
 "なめて": "كُلّ, جَمِيع",
 "なめてかかる": "تَرَفَّعَ",
 "なめなめ": "جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة) / خسارة, هزيمة (نهاية غير ناجحة لصراع أو مسابقة)\nمثال: كانت هزيمة بفارق ضئيل",
 "なめらか": "نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "なめる": "لَحَسَ, لَعِقَ (مرّر اللسان على الشيء لأخذ طعمه أو لتنظيفه؛ أزال الشيء بلعقه باللسان)\nمثال: その子犬は彼女の頬を舐めた。 — الكلب لعق خدها. / حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال. / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة. / اِسْتَخَفَّ, اِسْتَهَانَ\nمثال: 俺をなめるな。 — لا تستخف بمقدرتي.",
 "なめプレイ": "جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة) / خسارة, هزيمة (نهاية غير ناجحة لصراع أو مسابقة)\nمثال: كانت هزيمة بفارق ضئيل",
 "なめ腐る": "تَرَفَّعَ",
 "なも": "آمْيْن (اسم فعل أمر مبن على الفتح بمعنى \"اسْتَجِبْ\"، تأتي في خاتمة الدعاء) / آمِين (اسم فعل أمر مبن على الفتح بمعنى \"اسْتَجِبْ\"، تأتي في خاتمة الدعاء) / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن.",
 "なもない": "مَجْهُول, مُبْهَم / مُتَغَيِّر / غَامِض, غَوَامِض",
 "なもなき": "غَيْر مُعَرَّف, مَجْهُول الهُوِيَّة (ذو مصدر مجهول أو غير مُسمَّى)",
 "なや": "حَظِيرَة, زَرِيبَة",
 "なやす": "وَرْشَة حِدَادَة",
 "なやましい": "جذاب, فاتن (يميل إلى إغراء شخص للقيام بعمل أو حالة مرغوبة) / مُزْعِج, مُقْلِق (يُسَبِّب القَلَق أو الانْزِعاج أو الكَرْب) / قَلِق, قَلِقَة (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "なやましげ": "قَلِق, قَلِقَة (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / شَوْق (نزوعُ النَّفْس إِلى الشيء، أو تَعَلُّقها به؛ مصدر الفعل شَاقَ)\nمثال: سأشعر بالشوق إليك.",
 "なやます": "عَذَاب / عَذَّبَ",
 "なやみ": "مُشْكِلَة, مَتاعِب",
 "なやめる": "قَلِق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / عَذَاب / عَذَّبَ",
 "なよっちい": "ضَعِيف",
 "なよなよ": "بدقة, برقة (بطريقة دقيقة)\nمثال: ملامح مشكلة بدقة",
 "なよやか": "رَشِيق, لَدْن ((عَنْ أَجْسَادِ الأَشْخَاصِ) قَادِرٌ عَلَى الحَرَكَةِ أَوِ الِانْثِنَاءِ بِحُرِّيَّةٍ) / سَلِس, طَيِّع ((عَنْ سِمَاتِ الشَّخْصِيَّةِ) سَرِيعُ التَّكَيُّفِ) / رَشِيق, لَدِن (نحيل بأناقة ويتحرك وينثني بسهولة ويُسر)",
 "なら": "إِنْ (يفيد التوكيد) / لَوْ / إِذَا\nمثال: إن شاء الله ؛ / أَمَّا ؛ فَـ (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ)\nمثال: أما زلت تذكرني؟ / بَلُّوط, سِنْدِيَان / نَارَا",
 "ならい": "كَمَا هُوَ, كَمَا هِيَ",
 "ならいごと": "تَنْفِيذ",
 "ならいしょう": "طبيعة ثانية (سلوك مكتسب تمت ممارسته لفترة طويلة لدرجة أنه يبدو فطريًا)",
 "ならう": "تَعَلَّمَ (اكتسب معرفة أو خبرة أو مهارة) / اِعْتَبَرَ, اِتَّعَظَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين)\nمثال: هو سريع التعلم. / قَلَّدَ",
 "ならく": "جَهَنَّم, جَحِيم / جَحِيم, جَهَنَّم / النِهاية",
 "ならくのそこ": "هَاوِيَة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة) / هَاوِيَة, هُوَّة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة)\nمثال: وصل سامي إلى قاع الهاوية ماليا.",
 "ならし": "مُتَوَسِّط, مُعَدَّل",
 "ならして": "مُرَوِّض",
 "ならす": "ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل. / أَلِيف / رَوَّضَ, آلَفَ (رَوَّضَ المكانُ: أرَاضَ؛ رَوَّضَ فلانٌ: لَزِمَ الرِّياضَ)\nمثال: إلى أية روضة ذهبت؟ / سَطَّح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)\nمثال: هناك ثقوب على السطح. / مُتَوَسِّط, مُعَدَّل / حَلْقَة / خَاتَم, خَاتِم / دَقَّ, رَنَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه) / رَنَّ ((رَنَّ) رنينا: صَوَّت وَصَاح؛ (رَنَّ) إِلَيْهِ: أصغى) / تَلْفَنَ, رَنَّ / مثال: واصل زيري دق الجرس. / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / حَبَقَ, ضَرَطَ (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في النّاس : حَبَقَ يحبِق حبْقاً وحَبِقاً وحُباقاً؛ الحَبْق : ضُراط المَعِز ، وقد تستعمل في النّاس) / حَبْقَة, ضَرْطَة",
 "ならずもの": "بلطجي, فتوة (رجل قاسٍ ووحشي)",
 "ならずものこっか": "دولة مارقة (دولة لا تحترم الدول الأخرى في أعمالها الدولية)",
 "ならず者": "بلطجي, فتوة (رجل قاسٍ ووحشي)",
 "ならず者国家": "دولة مارقة (دولة لا تحترم الدول الأخرى في أعمالها الدولية)",
 "ならたけ": "فطر العسل (فطر صالح للأكل بلون العسل يرتبط عادة بجذور الأشجار في أواخر الصيف والخريف؛ لا يؤكل نيئاً)",
 "ならでは": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / لٰكِن, وَلٰكِنْ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / إِلَّا, سِوًى (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / إلَّا, غَيْرَ (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لكن لديك أطفال.",
 "ならない": "بِشَكْلٍ لَا يُطَاقُ / عَجَزَ, لَا يَسْتَطِيع / لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة.",
 "ならぬ": "بِشَكْلٍ لَا يُطَاقُ / عَجَزَ, لَا يَسْتَطِيع / لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة. / بَعِيد المَنَال, مُسْتَحِيل التَّحْقِيق (يستحيل تحقيقه أو بلوغه)",
 "ならば": "إِنْ (يفيد التوكيد) / لَوْ / إِذَا\nمثال: إن شاء الله ؛",
 "ならび": "خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "ならびしょうされる": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "ならびしょうする": "صِنْف, صَنْف / طَبَقَة / فَصْل, صَفّ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)\nمثال: اقرأ هذا الفصل.",
 "ならびじゅん": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "ならびない": "فَرِيدٌ مِنْ نَوْعِه, لَا يُضَاهَى (مُتميّز جذريًّا وليس له مثيل أو نظير)",
 "ならびなき": "فَرِيدٌ مِنْ نَوْعِه, لَا يُضَاهَى (مُتميّز جذريًّا وليس له مثيل أو نظير)",
 "ならびに": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "ならぶ": "مُنَافِس",
 "ならべかえ": "نَوْع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / فَرَزَ\nمثال: انه نوع من الفطر.",
 "ならべかえる": "إعادة طلب, طلب متكرر (طلب متكرر لنفس البضائع)\nمثال: هو الشخص الذي يرسل جميع الطلبات الجديدة وإعادة الطلب",
 "ならべかた": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "ならべたてる": "أَحْصَى (أَحْصَى: (فعل) أحصى يُحصي ، أحْصِ ، إحصاءً ، فهو مُحصٍ ، والمفعول مُحصًى)",
 "ならべる": "أَحْصَى (أَحْصَى: (فعل) أحصى يُحصي ، أحْصِ ، إحصاءً ، فهو مُحصٍ ، والمفعول مُحصًى)",
 "ならわし": "عَادَة, عُرْف",
 "ならん": "بِشَكْلٍ لَا يُطَاقُ / عَجَزَ, لَا يَسْتَطِيع / لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة.",
 "ならんで": "تَزَامُنًا",
 "なり": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / مبلغ, مقدار من المال (كمية من المال)\nمثال: اقترض مبلغاً كبيراً / جهارة, دوي (امتلاك طابع صوت عميق وعالٍ؛ خاصية الرنين) / تقديم الخاتم (إعطاء خاتم كرمز للخطوبة) / دق الجرس, رنين (صوت رنين الجرس)\nمثال: الرنين المميز لجرس الكنيسة / رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة) / رسم شعار النبالة, شحنة (شعار النبالة المتمثل في تصميم أو صورة مرسومة على درع) / سلوك, هيئة (أسلوب أو سلوك وقور) / قوام, هيئة (طريقة مميزة لحمل الجسم)\nمثال: وقف بوضعية جيدة / على سبيل المثال, مثلاً (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذ الثعابين الشريطية على سبيل المثال (يفيد الاستعلاء؛ يفيد التعليل) / مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟ / أُسْلُوب (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب. / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / ثَوْب, لِبَاس (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء) / كَسْوَة, مَلْبَس\nمثال: لبس سروالا نظيفا. / رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء وفتحها): عوَّذَه؛ يقال: باسم الله أَرقِيك واللهُ يَشفيك) / رَوَّجَ (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ)",
 "なりあがり": "كيب, نهوض بالركل (تمرين جمباز يبدأ من وضع تكون فيه الساقان فوق الجزء العلوي من الجسم والتحرك إلى وضع منتصب عن طريق تقويس الظهر وأرجحة الساقين للخارج وللأسفل مع دفع…) / حديث النعمة, متسلق طبقي (شخص صعد فجأة إلى وضع اقتصادي أعلى ولكنه لم ينل القبول الاجتماعي من الآخرين في تلك الطبقة) / متغطرس, مغرور (شخص متكبر أو وقح)",
 "なりあがりもの": "كيب, نهوض بالركل (تمرين جمباز يبدأ من وضع تكون فيه الساقان فوق الجزء العلوي من الجسم والتحرك إلى وضع منتصب عن طريق تقويس الظهر وأرجحة الساقين للخارج وللأسفل مع دفع…) / حديث النعمة, متسلق طبقي (شخص صعد فجأة إلى وضع اقتصادي أعلى ولكنه لم ينل القبول الاجتماعي من الآخرين في تلك الطبقة) / متغطرس, مغرور (شخص متكبر أو وقح)",
 "なりかわる": "اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ. / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "なりきん": "كيب, نهوض بالركل (تمرين جمباز يبدأ من وضع تكون فيه الساقان فوق الجزء العلوي من الجسم والتحرك إلى وضع منتصب عن طريق تقويس الظهر وأرجحة الساقين للخارج وللأسفل مع دفع…) / حديث النعمة, متسلق طبقي (شخص صعد فجأة إلى وضع اقتصادي أعلى ولكنه لم ينل القبول الاجتماعي من الآخرين في تلك الطبقة) / متغطرس, مغرور (شخص متكبر أو وقح)",
 "なりくせ": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / طبع, مزاج (الحالة المزاجية المعتادة) / استعداد, ميل (عادة طبيعية أو مكتسبة أو ميل مميز في شخص أو شيء) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: لديه مزاج سعيد",
 "なりけり": "فعل مساعد (فعل يندمج مع فعل آخر في عبارة فعلية للمساعدة في تشكيل الزمن أو الصيغة أو البناء أو الشرط للفعل الذي يندمج معه)",
 "なりこむ": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة.",
 "なりすがた": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "なりすまし": "تَنَكَّرَ / بَارُودِيَا, مُحَاكَاة سَاخِرَة (تكوين يقلد أو يحرف أسلوب شخص ما، عادة بطريقة فكاهية)",
 "なりすます": "اِنْتَحَلَ",
 "なりたち": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل / هَيْكَل",
 "なりと": "مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "なりとどろく": "صَدًى",
 "なりとも": "مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "なりなんとす": "اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني.",
 "なりはためく": "صَدًى",
 "なりひびく": "صَدًى",
 "なりふり": "مَلَابِس, ثِيَاب",
 "なりません": "بِشَكْلٍ لَا يُطَاقُ / عَجَزَ, لَا يَسْتَطِيع / لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة.",
 "なりもの": "آلَة مُوسِيقِيَّة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة. / حِصَاد / مَحْصُول, غَلَّة / حَصَدَ (قَطَعَ الزَّرْعَ وغيره من النبات بالمِنْجَل أو آلة الحصاد)\nمثال: حصد الفلاح القمح. / فَاكِهَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها) / ثَمَرَة, شَاذّ جِنْسِيًّا / أَثْمَرَ (أثمر الشجر: صار فيه الثمر؛ أثمر الشجر: طلع ثمره قبل أن ينضج)\nمثال: التفاح فاكهة لذيذة.",
 "なりものいり": "جذل, فانفار ((موسيقى) لحن حيوي قصير يُعزف على الآلات النحاسية) / بهرجة, تباهي (عرض خارجي مبهرج)\nمثال: دخل على وقع نغمة احتفالية من الأبواق",
 "なりゆき": "طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / مَسار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا الطبق لذيذ. / أمر بسعر السوق (أمر لوسيط ببيع أو شراء أسهم أو سلع بسعر السوق السائد)",
 "なりゆきちゅうもん": "أمر بسعر السوق (أمر لوسيط ببيع أو شراء أسهم أو سلع بسعر السوق السائد)",
 "なりゆきまかせ": "انجراف, تسكع (تجوال بلا هدف من مكان لآخر) / تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر)",
 "なりをしずめる": "تَوَارَى عَنْ الْأَنْظَار",
 "なりをひそめる": "تَوَارَى عَنْ الْأَنْظَار",
 "なりを潜める": "تَوَارَى عَنْ الْأَنْظَار",
 "なり代わる": "اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "なり物": "حِصَاد / مَحْصُول, غَلَّة / حَصَدَ (قَطَعَ الزَّرْعَ وغيره من النبات بالمِنْجَل أو آلة الحصاد)\nمثال: حصد الفلاح القمح. / فَاكِهَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها) / ثَمَرَة, شَاذّ جِنْسِيًّا / أَثْمَرَ (أثمر الشجر: صار فيه الثمر؛ أثمر الشجر: طلع ثمره قبل أن ينضج)\nمثال: التفاح فاكهة لذيذة.",
 "なる": "صَارَ, أَصْبَحَ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما. / بَرْهَنَ, أَثْبَتَ / نَجَحَ / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / سليم / صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّتَ, طَلَّع صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي. / يَعْنِي, أَي",
 "なるい": "خضراوات ورقية (أي من النباتات الورقية المختلفة أو أوراقها وسيقانها التي تؤكل كخضروات)",
 "なるかみ": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد",
 "なるこ": "للسان الجرس, مصفق (مطرقة معدنية تتدلى داخل الجرس وتصدر صوتاً بضرب الجانب) / لسان (كتلة متحركة من الأنسجة العضلية مغطاة بغشاء مخاطي وتقع في التجويف الفموي) / مصفق (شخص يصفق)",
 "なるこゆり": "خاتم سليمان, نجمة داود (نجمة سداسية مكونة من مثلثين متساويي الأضلاع)",
 "なると": "دَوَّامَة / نَارُوتُو",
 "なるときんとき": "بَطَاطَا حُلْوَة",
 "なると金時": "بَطَاطَا حُلْوَة",
 "なるはや": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "なるへそ": "بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك) / بالفعل, جداً (في الحقيقة (غالباً ما تميل إلى التوكيد))\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "なるべくなら": "بالأحرى, يفضل (بشكل أكثر استعداداً أو رغبة)\nمثال: نظفه جيداً، يفضل بالماء الدافئ",
 "なるべくはやく": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "なるべく早く": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "なるほど": "بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك) / بالفعل, جداً (في الحقيقة (غالباً ما تميل إلى التوكيد))\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "なる早": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "なれ": "تَدْرِيب (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة) / مُمَارَسَة\nمثال: واصل زيري التدريب. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / مُلْصَق, بِطَاقَة",
 "なれあい": "تَوَاطُؤ / زواج عرفي, مساكنة (علاقة زواج تنشأ عن طريق الاتفاق والمساكنة بدلاً من المراسم)",
 "なれあう": "تَآمَرَ, اِئْتَمَرَ",
 "なれた": "أَلِيف / خبير, ذو خبرة (لديه خبرة؛ لديه معرفة أو مهارة من الملاحظة أو المشاركة)",
 "なれど": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / لٰكِن, وَلٰكِنْ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / إِلَّا, سِوًى (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / إلَّا, غَيْرَ (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لكن لديك أطفال.",
 "なれども": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / لٰكِن, وَلٰكِنْ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / إِلَّا, سِوًى (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / إلَّا, غَيْرَ (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لكن لديك أطفال.",
 "なれなれしい": "مُتَجَاوِز لِلحُدُود (يأخذ حريات غير لائقة في التعامل مع الآخرين)",
 "なればこそ": "وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي.",
 "なれる": "نَاضِج, رَاشِد / أَفْسَدَ, فَسَدَ",
 "なれ合い": "تَوَاطُؤ / زواج عرفي, مساكنة (علاقة زواج تنشأ عن طريق الاتفاق والمساكنة بدلاً من المراسم)",
 "なれ合う": "تَآمَرَ, اِئْتَمَرَ",
 "なわ": "حَبْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "なわつき": "جِنَائِيّ, إِجْرَامِيّ / مُجْرِم, مُجْرِمَة",
 "なわとび": "نَط اَلْحَبْل",
 "なわぬけ": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "なわのれん": "حَانَة, بَار",
 "なわはしご": "سلم حبال (سلم ذو جوانب مصنوعة من الحبال)",
 "なわばしご": "سلم حبال (سلم ذو جوانب مصنوعة من الحبال)",
 "なわばり": "حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي) / تخم, حد (حدود منطقة معينة)\nمثال: هناك خط رفيع بين العقل والجنون / مَجَال إِنْتَرْنَت / نِطَاق (الحزام المصنوع من القماش ليس له إبزيم ولا ما أشبه؛ قطعة من القماش تُلفّ على وسط الإنسان. الجمع نُطُق؛ في : هو جزء الدائرة كسطح (ليس قوس)؛ يقال أيضا قطاع. الجمع نطاقات)\nمثال: هل تمثل الزراعة على نطاق واسع النظام البيئي في الجزائر؟ / إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما)",
 "なわばりあらそい": "حَرْب نُفُوذ, صِرَاع سَيْطَرَة (صراع مرير على الأرض أو السلطة أو السيطرة أو الحقوق)\nمثال: اندلعت حرب نفوذ بين عصابات الشوارع",
 "なわめ": "عُقْدَة / عَقَدَ (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد. / تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "なわもじ": "كيبو (آلة حاسبة تتكون من حبل بحبال ملحقة؛ استخدمها البيروفيون القدماء للحساب وحفظ السجلات)",
 "なわをかける": "تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "なをん": "اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "なん": "صُعُوبَة / حَادِث / مُصَادَفَة, صُدْفَة / صُدْفَة, صِدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة. / خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي. / نَقْد, اِنْتِقَاد / نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / اِبْن (الولد الذكر)\nمثال: هو له ابن صغير. / يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة! / كَم / كَمْ\nمثال: ここの家、何匹猫がいるの？ — كم عدد القطط الموجودة في هذا المنزل ؟ / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / بَعْض, عِدَّة ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما)\nمثال: لديك بعض الكتب. / جَنُوبِيّ",
 "なんあり": "تالف, متضرر (تعرض للأذى أو الإصابة أو التلف) / فَاقِدُ الْمِصْدَاقِيَّةِ, مُتَضَرِّرُ السُّمْعَةِ (فقد سمعته أو مصداقيته ظلماً)\nمثال: لن أشتري بضائع تالفة",
 "なんい": "صُعُوبَة",
 "なんおう": "أُورُوبَّا اَلْجَنُوبِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة.",
 "なんか": "شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما. / بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما / مُلَطِّف, مُلَيِّن (يُنَعِّم ويُلَيِّن البَشَرَة أو الأنْسِجَة) / تليين (عملية التحول إلى شيء أكثر ليونة)\nمثال: أخر التبريد تليين الفاكهة / إضعاف (عملية تقليل قوة شيء ما) / مُضَعِّف, مُوَهِّن (يُخفّف عن طريق إضعاف حدة الألم أو الحزن) / مُضْعِف, مُوهِن (يسبب الوهن والضعف) / إضعاف, وهن (أن يصبح الشيء أضعف) / قَرْع, يَقْطِين (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع. / بَنْكْنُوت, وَرَقَة نَقْدِيَّة",
 "なんかい": "كَم / كَمْ / غَيْرُ مَفْهُوم, مُعْتِم (صعب أو مستحيل الفهم والاستيعاب) / غير مفهوم, مبهم (ملفوظ أو منطوق بشكل سيء، أو طغت عليه الضوضاء)\nمثال: كلام غير مفهوم",
 "なんかいか": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "なんかいでも": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "なんかいも": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "なんかげつ": "كَم / كَمْ",
 "なんかげつか": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "なんかげつも": "شَهْر (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر جزئا من السَنَة…)\nمثال: رمضان شهر حرام.",
 "なんかざい": "ملين, منعم (مادة تضاف إلى مادة أخرى لجعلها أقل صلابة)",
 "なんかしょう": "تلين (حالة من التلين غير الطبيعي للأنسجة)",
 "なんかなしに": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية) / بِشَكْل عَرَضِيّ, غَيْر مَنْهَجِيّ (ليس بشكل منهجي أو وفقاً لخطة)\nمثال: ألقى نظرة غير مبالية على العناوين",
 "なんかん": "حَاجِز / عَقَبَة, حَاجِز",
 "なんきつ": "عَزْر / توبيخ ;تقريع",
 "なんきょう": "نَارَا",
 "なんきょく": "اَلْقُطْب اَلْجَنُوبِيّ / أَنْتَارْكْتِيكِيّ, قُطْبِيّ جَنُوبِيّ (عند القطب الجنوبي أو بالقرب منه)",
 "なんきょくかい": "اَلْمُحِيط اَلْمُتَجَمِّد اَلْجَنُوبِيّ, اَلْمُحِيط اَلْجَنُوبِيّ",
 "なんきょくけん": "الدَائِرَة القُطْبِيَّة الجَنُوبِيَّة",
 "なんきょくこう": "شفق قطبي جنوبي (الشفق القطبي في نصف الكرة الجنوبي)",
 "なんきょくせん": "الدَائِرَة القُطْبِيَّة الجَنُوبِيَّة",
 "なんきょくたいりく": "أَنْتَارْكِتِيكَا, الْقُطْبُ الْجَنُوبِيّ (القارة الأقصى جنوبًا؛ تقع جنوب المحيط المتجمد الجنوبي، وتحوي القطب الجنوبي)\nمثال: تكس هو طائر من أنتاركتيكا.",
 "なんきょくちほう": "أَنْتَارْكْتِيكِيّ, قُطْبِيّ جَنُوبِيّ (عند القطب الجنوبي أو بالقرب منه)",
 "なんきょくてん": "اَلْقُطْب اَلْجَنُوبِيّ",
 "なんきん": "إِقَامَة جَبْرِيَّة",
 "なんきんじょうたい": "إِقَامَة جَبْرِيَّة",
 "なんぎ": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا) / مُعَانَاة / الْتِبَاس, خَفَاء (صفة كون الشيء غير واضح أو عويصاً وصعب الفهم) / عمق, عوص (الحكمة التي تتسم بالغموض والصعوبة والعمق)\nمثال: أعجب عالم الأنثروبولوجيا بعمق الأمثال المحلية",
 "なんぎょう": "كَفَّارَة / سِرّ التَوْبَة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "なんぎょうくぎょう": "كَفَّارَة / سِرّ التَوْبَة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "なんぎょく": "نيفرِيت, يشم نيفريت (معدن أمفيبولي يتكون من سيليكات الكالسيوم والمغنيسيوم في شكل بلوري أحادي الميل؛ مصدر لليشم (أقل قيمة من الجاديت)؛ كان يعتقد قديماً أنه يعالج اضطرابات…)",
 "なんくせ": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي.",
 "なんくせつける": "لَوْم, مَلَامَة",
 "なんくせをつける": "لَوْم, مَلَامَة",
 "なんけん": "تذكرة قطار (تذكرة صالحة لركوب القطار)",
 "なんこ": "كَم / كَمْ",
 "なんこう": "شفق قطبي جنوبي (الشفق القطبي في نصف الكرة الجنوبي) / مُتَّجِه جَنُوبًا (يتحرك باتجاه الجنوب) / مَرْهَم, دَهُون / صلب طري, فولاذ لين (فولاذ يحتوي على أقل من 0.15% كربون)",
 "なんこうがい": "حَنَك رَخُو ((حَنَكَت) الْأُم الصَّبِي حنكا: دلكت حنكه؛ (حَنَكَ) فُلَان الدَّابَّة: جعل الرسن فِي فمها)",
 "なんこうがいおん": "طَبَقِيّ",
 "なんこうざい": "مَرْهَم, دَهُون",
 "なんこうふらく": "لَا يُقْهَر, مَنِيع (لَا يُمْكِنُ التَّغَلُّبُ عَلَيْهِ أَوْ تَحَدِّيهِ أَوْ دَحْضُهُ) / قَابِل لِلحَمْل, قَادِر عَلَى الإِنْجَاب (قَادِر عَلَى الحَمْل والإِخْصَاب) / لَا يُقْهَر, مَنِيع (مُحَصَّنٌ ضِدَّ الهُجُوم؛ لَا يُمْكِنُ العَبَثُ بِه)",
 "なんこつ": "غُضْرُوف (مادة قاسية مرنة تُكوِّن هياكل أو أجزاء من هياكل الفقاريات. تُشكل غالبية هياكل الأجنة في معظم الفقاريات…) / غضروف (نسيج مرن قوي؛ يتحول معظمه إلى عظم عند البالغين)",
 "なんこつぎょるい": "سمكة غضروفية (أسماك قد يكون هيكلها متكلسًا ولكنه غير متعظم)",
 "なんこつけいせいふぜんしょう": "الودانة, لاتصنع غضروفي (اضطراب هيكلي وراثي يبدأ قبل الولادة حيث يتحول الغضروف إلى عظم مما يؤدي إلى التقزم)",
 "なんこつしゅ": "ورم غضروفي (ورم حميد شائع يتكون من خلايا غضروفية)",
 "なんこつむけいせいしょう": "الودانة, لاتصنع غضروفي (اضطراب هيكلي وراثي يبدأ قبل الولادة حيث يتحول الغضروف إلى عظم مما يؤدي إلى التقزم)",
 "なんご": "كلمات معسولة, همسات الحب (تعبيرات عاطفية غير مهمة المضمون)\nمثال: همس بكلمات معسولة في أذنها / ثَرْثَرَة, مُنَاغَاة (رطانة تشبه أصوات الطفل) / كَم / كَمْ",
 "なんごしゅう": "مَسْرَد",
 "なんざ": "وَهٰكَذَا, وَهَلُمَّ جَرًّا / أشباه, أمثال (نوع مماثل)\nمثال: الكلاب والثعالب وما شابه ذلك",
 "なんざあ": "وَهٰكَذَا, وَهَلُمَّ جَرًّا / أشباه, أمثال (نوع مماثل)\nمثال: الكلاب والثعالب وما شابه ذلك",
 "なんざい": "خشب لين (خشب يسهل نشره (من الصنوبريات مثل الصنوبر أو التنوب))",
 "なんざんのじゅ": "أقدمية, طول العمر (خاصية العيش طويلاً) / تعمير, طول الخدمة (مدة الخدمة أو البقاء)\nمثال: طول بقائها كنجمة",
 "なんし": "جَنُوب الصِّين (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب) / جَنُوب الصِّين, سَاوْث تَشَايْنَا (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "なんしき": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "なんしきひこうせん": "مُنْطَاد ذُو مُحَرِّك",
 "なんしつ": "نُعُومَة",
 "なんしつこむぎ": "قمح طري (قمح ذو حبات نشوية طرية يستخدم في المعجنات وحبوب الإفطار)",
 "なんしつガラス": "زجاج لين (زجاج ذو نقطة تليين منخفضة نسبياً)",
 "なんしゅ": "كَم / كَمْ",
 "なんしょう": "نَانْتْشَانْغ",
 "なんしょうかせい": "عسير الهضم, غير قابل للهضم (يتم هضمه بصعوبة)",
 "なんしょく": "لِوَاط / إدانة, استهجان (فعل الاستهجان أو الإدانة) / استهجان, عدم رضا (الميل لعدم منح الموافقة أو الرضا عن شخص أو مجموعة) / اسْتِنْكَار, اسْتِهْجَان (التعبير عن عدم الموافقة أو الاستهجان) / استهجان, عدم استحسان (شعور بعدم الإعجاب بشيء أو بما يفعله شخص ما) / كَم / كَمْ",
 "なんじ": "صعب المراس, عنيد (غير طيع؛ صعب الإدارة أو التشكيل)\nمثال: طبع عنيد / عَاصٍ / صُعُوبَة / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "なんじかん": "كَم / كَمْ",
 "なんじじしんをしれ": "رحم الله امرَأً عرف قدر نفسه (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام)\nمثال: رحمة الله عليه.",
 "なんじなんぷん": "مَتَى / إمتى / متى / امتى / فوقتاش / حِينَمَا, عِنْدَمَا",
 "なんじみずからをしれ": "رحم الله امرَأً عرف قدر نفسه (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام)\nمثال: رحمة الله عليه.",
 "なんじゃ": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة!",
 "なんじゃく": "ضَعِيف / عَدِيم الأَشْوَاك (خالٍ من الأشواك أو الإبر) / جَبَان, ضَعِيف الشَّخْصِيَّة (يفتقر إلى الشجاعة أو الحيوية) / أملس, غير شوكي (يفتقر إلى النتوءات الشوكية) / لافقاري (يفتقر إلى عمود فقري)\nمثال: كان دودة صفراء عديمة الشجاعة",
 "なんじゃくがいこう": "خَوَّارُ الْعَزِيمَةِ (يفتقر إلى قوة الإرادة والعزيمة)",
 "なんじゃくもの": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "なんじゅう": "مُعَانَاة / عَشَرَة, عَشْرَة",
 "なんじょう": "هُنَاكَ, يُوجَدُ",
 "なんじる": "اِنْتَقَدَ / نَقَدَ",
 "なんす": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "なんすい": "ماء يسر (ماء ليس عسراً (لا يحتوي على أملاح معدنية تتداخل مع تكوين الرغوة مع الصابون))",
 "なんずる": "اِنْتَقَدَ / نَقَدَ",
 "なんせ": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "なんせい": "نُعُومَة / باتجاه الجنوب الغربي (إلى أو نحو أو في الجنوب الغربي) / جَنُوب غَرْبِيّ (يقع في الجنوب الغربي أو موجَّه نحوه) / قَادِم مِنَ الجَنُوب الغَرْبِيّ (قادم من اتجاه الجنوب الغربي) / جنوب غرب (موقع في الجزء الجنوبي الغربي من بلد أو منطقة أو مدينة) / حملة, حملة عسكرية (عدة عمليات مترابطة تهدف إلى تحقيق هدف معين (عادة ضمن قيود جغرافية وزمنية))",
 "なんせいぶ": "باتجاه الجنوب الغربي (إلى أو نحو أو في الجنوب الغربي) / جَنُوب غَرْبِيّ (يقع في الجنوب الغربي أو موجَّه نحوه) / قَادِم مِنَ الجَنُوب الغَرْبِيّ (قادم من اتجاه الجنوب الغربي) / جنوب غرب (موقع في الجزء الجنوبي الغربي من بلد أو منطقة أو مدينة)",
 "なんせっけん": "صابون طري (صابون طري (أو سائل) مصنوع من زيوت نباتية؛ يستخدم في بعض الأمراض الجلدية) / كلام معسول, ملاطفة (تملق مصمم لكسب الرضا)",
 "なんせん": "حُطَام سَفِينَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد) / كُورِيَا الْجَنُوبِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "なんぞ": "وَهٰكَذَا, وَهَلُمَّ جَرًّا / شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما. / يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة! / لِمَاذَا / لِمَ (جَمَعَ، ضَمَّ) / علاش / علاه\nمثال: لم يساعدني أحد.",
 "なんぞや": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة! / لِمَاذَا / لِمَ (جَمَعَ، ضَمَّ) / علاش / علاه\nمثال: لم يساعدني أحد.",
 "なんたいせいぶつ": "رِخْوِيّ",
 "なんたいどうぶつ": "رِخْوِيّ",
 "なんたいどうぶつがく": "علم الرخويات (فرع علم الحيوان الذي يدرس بنية وسلوك الرخويات)",
 "なんたって": "مَهْمَا",
 "なんたる": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة!",
 "なんたん": "فحم بتوميني, فحم قاري (فحم غني بالهيدروكربونات القطرانية؛ يحترق بسهولة بلهب أصفر مدخن)",
 "なんだ": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة. / تَعَاطُف / عَطْف (عِطْف: عُنُق، رَقبة؛ الجمع: أَعْطَافٌ، و عِطَافٌ، و عُطُوفٌ) / حُنُو / وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة! / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / اللَّعْنَة",
 "なんだい": "تَحَدٍّ, التَّحَدِّي",
 "なんだか": "صَغِير, صغير / قَلِيلاً, قَلِيل",
 "なんだかんだいっても": "مَهْمَا",
 "なんだかんだ言っても": "مَهْمَا",
 "なんだって": "أَيُّ شَيْءٍ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "なんち": "صعب المراس, عنيد (غير طيع؛ صعب الإدارة أو التشكيل)\nمثال: طبع عنيد / عَاصٍ",
 "なんちせい": "استعصاء, جموح (سمة صعوبة التأثير أو السيطرة)",
 "なんちゃって": "بَدِيل, رَدِيء (اصطناعي ورديء الجودة؛ بديل أقل قيمة) / بديل رديء, زائف (بديل أو تقليد مصطنع أو رديء)",
 "なんちゃら": "شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما.",
 "なんちゅう": "إتمام, إكمال (إجراء ختامي أو نهائي) / تتويج, ذروة (اللحظة الحاسمة في رواية أو مسرحية) / بلوغ القمة, عبور الزوال ((في الفلك) أعلى نقطة سماوية لجرم سماوي فوق أفق المراقب) / أوج, ذروة (مرحلة الذروة النهائية)\nمثال: مشهد فراش الموت هو ذروة المسرحية / كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "なんちょう": "صَمَم / ضَعِيف / نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / بِلْيُون (مَلْيُونُ مَلْيُونٍ (بريطانيا)؛ الف مِلْيون أي مِلْيار (الولايات المتحدة الأمريكية)) / تِرِيلِيُون / تِرِيلِْيُون\nمثال: الشركة عانت من خسارة واحد بليون ين السنة الماضية.",
 "なんちょうしゃ": "أَصَمّ",
 "なんつう": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "なんつったって": "مَهْمَا",
 "なんつって": "بَدِيل, رَدِيء (اصطناعي ورديء الجودة؛ بديل أقل قيمة) / بديل رديء, زائف (بديل أو تقليد مصطنع أو رديء)",
 "なんつー": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "なんて": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)",
 "なんていっても": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "なんてこった": "مَاذَا بِحَقّ اَلسَّمَاء (أداة استفهام)\nمثال: ماذا تريد الآن؟",
 "なんてことない": "عَادِيّ, مَأْلُوف",
 "なんてことのない": "عَادِيّ, مَأْلُوف",
 "なんてったって": "مَهْمَا",
 "なんてん": "كَم / كَمْ / خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي. / مَرْبِط الْفَرَس",
 "なんて言っても": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "なんで": "لِأَنَّ / هكذا, بلا سبب / إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "なんであれ": "أَيّ, أَيَّمَا (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / مَهْمَا مَا / طُز\nمثال: لم تقصد أي أذى.",
 "なんでい": "حَمَأ, حَمأَة ((حَمَأَ) الْبِئْر حَمَأً: أخرج حمأتها) / رُسَابَة",
 "なんでかというと": "لِأَنَّ / هكذا, بلا سبب",
 "なんでも": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / أَيّ, كُلّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "なんでもかでも": "كُلّ شَيْء / بكل الوسائل, بكل تأكيد (بالتأكيد أو يقيناً)\nمثال: زرنا بكل تأكيد",
 "なんでもかんでも": "كُلّ شَيْء / بكل الوسائل, بكل تأكيد (بالتأكيد أو يقيناً)\nمثال: زرنا بكل تأكيد",
 "なんでもない": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / عَفْوًا, عَلَى الرُحْب وَالسَّعَة",
 "なんでもや": "شخص شامل, متعدد المواهب (شخص متعدد الجوانب يتقن أشياء كثيرة)\nمثال: إنها أفضل شخص شامل رأوه منذ سنوات / متجر ريفي, متجر عام (متجر بيع بالتجزئة يخدم منطقة ذات كثافة سكانية منخفضة؛ عادة ما يكون مخزناً بمجموعة واسعة من البضائع)",
 "なんでも屋": "شخص شامل, متعدد المواهب (شخص متعدد الجوانب يتقن أشياء كثيرة)\nمثال: إنها أفضل شخص شامل رأوه منذ سنوات / متجر ريفي, متجر عام (متجر بيع بالتجزئة يخدم منطقة ذات كثافة سكانية منخفضة؛ عادة ما يكون مخزناً بمجموعة واسعة من البضائع)",
 "なんでやねん": "مَاذَا بِحَقّ اَلسَّمَاء (أداة استفهام)\nمثال: ماذا تريد الآن؟",
 "なんでんぶっきょう": "بوذية التيرافادا, تيرافادا (واحدة من مدرستين عظيمتين للعقيدة البوذية تؤكدان على الخلاص الشخصي من خلال الجهود الذاتية؛ شكل محافظ من البوذية يلتزم بنصوص بالي والمثل غير الإلهي…)",
 "なんと": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة! / بشكل مفاجئ, للمفاجأة (بطريقة مفاجئة) / بشكل مذهل, للمفاجأة (بطريقة مذهلة؛ لمفاجأة الجميع)\nمثال: كان ودوداً بشكل مفاجئ / عَجَبًا / سُبْحَانَ الله (مصدر للفعل سَبَحَ؛ تُقال حصرًا للَّٰه، كما في العبارة \"سُبْحَانَ اللَّٰهِ\")\nمثال: سبحان الله عما يشركون. / نَارَا",
 "なんという": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "なんというか": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال.",
 "なんといったって": "مَهْمَا",
 "なんといっても": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "なんとう": "باتجاه الجنوب الشرقي (إلى أو نحو أو في الجنوب الشرقي) / جَنُوب شَرْقِيّ (يقع في الجنوب الشرقي أو موجَّه نحوه) / قَادِم مِنَ الجَنُوب الشَّرْقِيّ (قادم من اتجاه الجنوب الشرقي) / جنوب شرق (موقع في الجزء الجنوبي الشرقي من بلد أو منطقة أو مدينة)",
 "なんとうごぞく": "اللغات الأسترونيزية (عائلة اللغات التي يتم التحدث بها في أستراليا وفورموزا وماليزيا وبولينيزيا)",
 "なんとうぶ": "باتجاه الجنوب الشرقي (إلى أو نحو أو في الجنوب الشرقي) / جَنُوب شَرْقِيّ (يقع في الجنوب الشرقي أو موجَّه نحوه) / قَادِم مِنَ الجَنُوب الشَّرْقِيّ (قادم من اتجاه الجنوب الشرقي) / جنوب شرق (موقع في الجزء الجنوبي الشرقي من بلد أو منطقة أو مدينة)",
 "なんとか": "شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما. / بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "なんとかかんとか": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "なんとかして": "بِطَرِيقَةٍ أَو بِأُخرَى",
 "なんとしてでも": "مَهْمَا",
 "なんとしても": "مَهْمَا",
 "なんとでも": "أَيّ, أَيَّمَا (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / مَهْمَا مَا / طُز\nمثال: لم تقصد أي أذى.",
 "なんとなく": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "なんとなし": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "なんとなれば": "لِأَنَّ / هكذا, بلا سبب",
 "なんとも": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا . / أَيُّ شَيْءٍ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "なんともいえない": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "なんともない": "أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ) / خَزْنَة حَدِيدِيَّة, خَزْنَة\nمثال: هو غبي وغير أمين.",
 "なんともはや": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا .",
 "なんとも言えない": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "なんとやら": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما / إلخ, وما إلى ذلك (الاستمرار بنفس الطريقة)",
 "なんとゆう": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "なんと言うか": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال.",
 "なんと言っても": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "なんど": "كَم / كَمْ / غرفة تخزين, مخزن (غرفة تُخزن فيها الأشياء) / وَهٰكَذَا, وَهَلُمَّ جَرًّا",
 "なんどき": "مَتَى / إمتى / متى / امتى / فوقتاش / حِينَمَا, عِنْدَمَا",
 "なんどきでも": "دَائِمًا, أَبَدًا / مَتَى, مَتَى مَا / كُلَّمَا",
 "なんどくか": "تَعْتِيم",
 "なんどとなく": "طورا بعد طور",
 "なんども": "كَثِيرًا, غَالِبًا",
 "なんなく": "بِسُهُولَة",
 "なんなら": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك / آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "なんなり": "أَيُّ شَيْءٍ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "なんなりと": "أَيُّ شَيْءٍ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "なんなりとも": "أَيُّ شَيْءٍ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "なんなんせい": "باتجاه الجنوب الجنوب الغربي (إلى أو نحو أو في الجنوب الجنوب الغربي)",
 "なんなんとう": "باتجاه الجنوب الجنوب الشرقي (إلى أو نحو أو في الجنوب الجنوب الشرقي)",
 "なんなんとす": "اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني.",
 "なんなんとする": "اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني.",
 "なんにしても": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "なんにしろ": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً) / على أي حال, على الأقل (إن لم يكن أي شيء آخر)\nمثال: على أي حال، هو ميت الآن",
 "なんにせよ": "بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً) / على أي حال, على الأقل (إن لم يكن أي شيء آخر)\nمثال: على أي حال، هو ميت الآن",
 "なんにち": "كَم / كَمْ",
 "なんにでも": "كُلّ شَيْء",
 "なんにも": "أَيُّ شَيْءٍ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "なんにもならない": "عَقِيم",
 "なんにん": "كَم / كَمْ",
 "なんにんか": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "なんねい": "نَانِّينْغ, ناننينغ",
 "なんねん": "كَم / كَمْ",
 "なんねんかこう": "مُقَاوِم لِلْحَرِيق (لا تؤثر فيه النار)",
 "なんの": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة! / أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / أَيّ, كُلّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / نَعَم (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…) / لَا, لَاءَان (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "なんのきなしに": "عَنْ غَفْلَةٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "なんのこった": "مَاذَا بِحَقّ اَلسَّمَاء (أداة استفهام)\nمثال: ماذا تريد الآن؟",
 "なんのこと": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة!",
 "なんのことはない": "تافِه",
 "なんのへんてつもない": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "なんのやくにもたたない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "なんの変哲もない": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "なんの役にも立たない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "なんば": "مأزق, ورطة (موقف يصعب الخلاص منه، خاصة إذا كان مزعجاً أو شاقاً)\nمثال: وجد نفسه في مأزق محرج للغاية",
 "なんばきび": "غَلَّة",
 "なんばん": "باتجاه الجنوب الشرقي (إلى أو نحو أو في الجنوب الشرقي) / أُورُوبَّا الْغَرْبِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة. / أَجْنَبِيّ / غَرِيب, أَجْنَبِيّ / شَطَّة",
 "なんばんがらし": "شَطَّة",
 "なんばんきび": "غَلَّة",
 "なんばんしゅう": "مَسِيحِيَّة, نَصْرَانِيَّة (مؤنث المَسِيْحِيّ؛ المنسوبة إلى المَسِيْح؛ هي الدِيْن الذي يدين به المَسِيْحِيُّوْن؛ النَصْرَانِيَّة)\nمثال: اعتنق المسيحية.",
 "なんぱ": "زير نساء, مغوٍ (رجل يستغل النساء) / مغوي (شخص سيء يغري الآخرين بالوقوع في الخطأ أو المخالفة) / مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا. / دُبّ / دُبَّة / اِحْتَمَلَ / حُطَام سَفِينَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)",
 "なんぱし": "هراسة (أداة مطبخ تستخدم للهرس (مثل البطاطس)) / زير نساء, ملاحق النساء (رجل عدواني في التودد للنساء وملاحقتهن)",
