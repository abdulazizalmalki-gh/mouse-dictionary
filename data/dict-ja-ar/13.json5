 "はいがいてき": "حَصْرِيّ",
 "はいがら": "رَمَاد, سَكَن",
 "はいがん": "سَرَطَان اَلرِّئَة / اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم.",
 "はいき": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما)\nمثال: استخدم كل الموارد المتاحة تحت تصرفه / إلغاء, فسخ (فعل النسخ؛ إلغاء رسمي أو قانوني) / اِسْتَهْلَكَ, اِسْتَنْفَدَ / إِبْعَاد ((في السياسية) عقوبة جنائية تقضي بإخراج المحكوم عليه من البلاد)",
 "はいきかん": "أُنْبُوبُ ٱلْعَادِمِ",
 "はいききょう": "استرواح الصدر (وجود غير طبيعي للهواء في التجويف الجنبي مما يؤدي إلى انخماص الرئة؛ قد يكون…)",
 "はいきこう": "نَفَّسَ, هَوَّى (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن.",
 "はいきしゅ": "انتفاخ الرئة (حالة غير طبيعية للرئتين تتميز بانخفاض وظيفة الجهاز التنفسي)",
 "はいきしょぶん": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما)\nمثال: استخدم كل الموارد المتاحة تحت تصرفه",
 "はいきとう": "مَدْخَنَة",
 "はいきぶつ": "مخلفات, نفايات (أي مواد غير مستخدمة ومرفوضة على أنها عديمة القيمة أو غير مرغوب فيها)\nمثال: يجمعون النفايات مرة واحدة في الأسبوع",
 "はいきべん": "صمام العادم (صمام تخرج من خلاله الغازات المحترقة من الأسطوانة إلى مجمع العادم)",
 "はいきゃく": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما)\nمثال: استخدم كل الموارد المتاحة تحت تصرفه",
 "はいきゅう": "تَوْزِيع / تقنين, توزيع بالحصص (فعل التقنين (تحديد حصص))\nمثال: خلال الحرب فرضت الحكومة تقنين الغذاء والبنزين / الكُرَةُ اَلْطَّائِرَة",
 "はいきゅうせい": "تقنين, توزيع بالحصص (فعل التقنين (تحديد حصص))\nمثال: خلال الحرب فرضت الحكومة تقنين الغذاء والبنزين",
 "はいきょ": "خَرَاب, خَرَابَة",
 "はいきょう": "رِدَّة, اِرْتِدَاد / إخراج, طرد (فعل الطرد أو القذف أو الإخراج)\nمثال: طرد مثيري الشغب من قبل الشرطة",
 "はいきょうしゃ": "مُرْتَدّ",
 "はいきりょう": "إِزَاحَة, نُزُوح",
 "はいきガス": "أبخرة العادم, عادم (غازات منبعثة من محرك كمنتجات نفايات)",
 "はいぎょ": "سمكة رئوية (سمكة تتنفس الهواء ولها جسم ممدود وزعانف مزدوجة لحمية؛ تبني بعض الأنواع أغطية…)",
 "はいぎょう": "إيقاف, انقطاع (فعل الإيقاف أو القطع؛ انقطاع (مؤقت أو دائم))",
 "はいく": "هَايْكُو",
 "はいくつ": "ثني ظهري (عملية الثني للخلف (للجسم أو لجزء من الجسم))",
 "はいぐう": "تركيب, جمع (عملية دمج الأشياء لتكوين كلٍ جديد) / زَوْج, زَوْجَة (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)\nمثال: زوجة ماري طبيبة. / رجل وزوجته, زواج (شخصان متزوجان من بعضهما البعض)\nمثال: كان زواجه الثاني أكثر سعادة من الأول",
 "はいぐうし": "جاميت, مشيج (خلية تناسلية جنسية ناضجة تحتوي على مجموعة واحدة من الكروموسومات غير المزدوجة)",
 "はいぐうしけいせい": "تكون الأمشاج (تطور ونضج الخلايا الجنسية من خلال الانقسام المنصف)",
 "はいぐうしのう": "حاوية الأمشاج, محفظة مشيجية (خلية أو عضو تتطور فيه الأمشاج)",
 "はいぐうしゃ": "زَوْج, زَوْجَة (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)\nمثال: زوجة ماري طبيبة.",
 "はいぐうしゃかんじんこうじゅせい": "تلقيح صناعي (إدخال السائل المنوي إلى قناة فالوب أو الرحم بوسيلة غير الجماع الجنسي)",
 "はいぐうたい": "طور مشيجي, نابت عروسي (الفرد أو الطور الحامل للأمشاج في دورة حياة النبات الذي يمر بتبادل الأجيال)",
 "はいぐん": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "はいけい": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة)\nمثال: هذه رسالة من شخص عزيز. / خلفية / دعم, مؤازرة (فعل تقديم الموافقة والدعم)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "はいけいせつめい": "إحاطة إعلامية (مؤتمر صحفي أو مقابلة يشرح فيه مسؤول حكومي للمراسلين خلفية إجراء أو سياسة ما)\nمثال: أعطانا الوزير إحاطة عن قضايا الصحة العامة",
 "はいけいほうしゃ": "إشعاع الخلفية (إشعاع قادم من مصادر أخرى غير تلك التي يتم رصدها)",
 "はいけいまく": "خلفية المسرح, ستارة خلفية (مناظر معلقة في الجزء الخلفي من المسرح)",
 "はいけっかく": "تدرن رئوي, سل رئوي (يشمل الرئتين مع هزال تدريجي للجسم)",
 "はいけっしょうせい": "إنتاني, متقيح (يحتوي على كائنات مسببة للأمراض أو ناتج عنها)\nمثال: التهاب حلق إنتاني",
 "はいけつしょう": "تَلَوُّث اَلْدَم (تَلَطُّخ، تَكَدُّر، قذارة ودنس يصيبان الجو أو الماء أو البيئة ويؤديان إلى تسمم…)\nمثال: التلوث يضر كوكبنا.",
 "はいけん": "بَصِير, مُبْصِر (بَصير؛ بَصُرَ: (فعل) بصُرَ\nمثال: パスポートを拝見できますか。 — هل لي أن أرى جواز سفرك؟",
 "はいげき": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "はいこう": "توجيه, دورة توجيهية (دورة تقدم موقفاً أو بيئة جديدة)\nمثال: تفضيل للسيارات الباهظة / دِرْع, صَدَفَة (غطاء خارجي صلب لبعض الكائنات الحية مثل المفصليات والسلاحف)",
 "はいこうせい": "توجيه, دورة توجيهية (دورة تقدم موقفاً أو بيئة جديدة)\nمثال: تفضيل للسيارات الباهظة",
 "はいご": "خَلْفِيّ\nمثال: عنده حقيبة ظهر. / خلفية",
 "はいごう": "تركيب, جمع (عملية دمج الأشياء لتكوين كلٍ جديد)",
 "はいごうきんき": "تعارض, تنافر (صفة عدم القدرة على الوجود أو العمل معًا بانسجام)",
 "はいごうせいり": "إعادة تنظيم, إعادة هيكلة (تغيير واسع النطاق لهيكل شركة أو حكومة)\nمثال: بعد الاستحواذ كان هناك إعادة تنظيم شاملة",
 "はいごうど": "دبال, سماد عضوي (خليط من النباتات المتحللة والروث؛ يستخدم كسماد)",
 "はいごかんけい": "خلفية",
 "はいごれい": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة.",
 "はいさい": "آلُو, آلُوْ",
 "はいさく": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق.",
 "はいさつ": "افْتِرَاض, تَخْمِين (رسالة تعبر عن رأي يستند إلى أدلة غير كاملة)",
 "はいざ": "اِمْتِثَال, تَوَافُق (التصرف وفقاً لمعايير معينة مقبولة)\nمثال: بياناتهم المالية متوافقة مع الممارسات المحاسبية المقبولة عموماً",
 "はいざい": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر / تَحِلَّة",
 "はいざら": "مِنْفَضَة, طَفَّايَة",
 "はいざん": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / مُعْدَم, مُفْلِس (يفتقر إلى الموارد أو أي احتمال للحصول عليها)\nمثال: حاول مساعدة البائسين",
 "はいし": "إِلْغَاء, اِبْطَال / جَنِين / خَرَاب, خَرَابَة",
 "はいしつ": "إعاقة, عجز (حالة عدم القدرة على الأداء نتيجة لعدم اللياقة البدنية أو العقلية)\nمثال: إعاقة القراءة",
 "はいしゃ": "طَبِيب أَسْنَان, طَبِيبَة أَسْنَان (العالم بالطب)\nمثال: سوف تصبح طبيبة. / خَاسِر",
 "はいしゃく": "استعارة, اقتباس (الاستيلاء (على الأفكار أو الكلمات، إلخ) من مصدر آخر)\nمثال: كان اقتباس الزخارف القديمة واضحاً جداً",
 "はいしゃふっかつ": "رِيمُونْتَادَا / جولة الفرصة الثانية, سباق الترضية (سباق (خاصة في التجديف) يتنافس فيه الخاسرون في التصفيات من أجل مكان في السباق…)",
 "はいしゃふっかつせん": "جولة الفرصة الثانية, سباق الترضية (سباق (خاصة في التجديف) يتنافس فيه الخاسرون في التصفيات من أجل مكان في السباق…)",
 "はいしゅ": "بويضة صغيرة (بويضة صغيرة أو غير ناضجة) / جُرْثُومَة",
 "はいしゅつ": "إطلاق نار (فعل إطلاق النار من بندقية)",
 "はいしゅつぶつ": "إطلاق نار (فعل إطلاق النار من بندقية)",
 "はいしゅつべん": "صمام العادم (صمام تخرج من خلاله الغازات المحترقة من الأسطوانة إلى مجمع العادم)",
 "はいしょ": "رئة كتابية (عضو في العديد من العناكب يحتوي على العديد من الطيات الغشائية الرقيقة التي تشبه…)",
 "はいしょう": "سَمِيع (سَميع: (اسم)؛ سميع: (اسم))\nمثال: سمع سامي صريرا.",
 "はいしょく": "مخطط ألوان, نسق لوني (مزيج مخطط من الألوان)\nمثال: تم تحديد النسق اللوني لهذه الغرفة بواسطة مصمم داخلي / تنسيق الحدائق (العمل كبستاني مناظر طبيعية)\nمثال: أنفقوا قدراً كبيراً من المال على تنسيق الحدائق",
 "はいしよてい": "آيِلٌ لِلتَّقَادُمِ (في طريقه إلى أن يصبح متقادماً وعتيقاً)",
 "はいしん": "خيانة, غدر (فعل خيانة متعمد) / تَوْزِيع",
 "はいしんこうい": "خيانة الأمانة (انتهاك (إما عن طريق الاحتيال أو الإهمال) من قبل وصي لواجب يفرضه عليه الانصاف)",
 "はいしんしゃ": "خَائِن, خَائِنَة (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك! / قَاسِم / بَثَّاث",
 "はいじ": "اِسْتَقَالَ",
 "はいじく": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "はいじゅ": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "はいじゅんかん": "دَوْرَة دَمَوِيَّة صُغْرَى (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه…)\nمثال: خضع زيد لدورة مكثفة",
 "はいじょ": "إقْصَاء, اِسْتِثْنَاء / حرمان من الميراث (فعل من قبل المورث ينهي حق الشخص في الميراث)",
 "はいじょうみゃく": "وريد رئوي (أي من أربعة أوردة تحمل الدم الشرياني من الرئتين إلى الأذين الأيسر للقلب)",
 "はいじょそちめいれい": "أمر قضائي زجري, أمر منع ((في القانون) تدبير قضائي يصدر لمنع طرف من القيام بنشاط معين أو الاستمرار فيه)\nمثال: كان يتم الحصول على الأوامر القضائية سابقاً بموجب مذكرة ولكن الآن بموجب أمر قضائي",
 "はいじょようそ": "إقْصَاء, اِسْتِثْنَاء",
 "はいじん": "مُقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد. / مُدْمِن, مُدْمِنَة",
 "はいす": "هَزَمَ, غَلَبَ / أَبْطَلَ, أَلْغَى / وَزَّعَ (كَفَّ ومَنَعَ وحَبَسَ؛ به: أَغْرَى)\nمثال: وزع علينا الورق. / رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة. / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)\nمثال: زوجة ماري طبيبة. / نَفْي, تَبْعِيد / قَوْس, قوس / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا.",
 "はいすい": "تَصْرِيف / إِزَاحَة, نُزُوح / إمدادات المياه, نظام مياه (منشأة توفر مصدراً للمياه)\nمثال: ناقشت المدينة تنقية إمدادات المياه / مياه عادمة, مياه مبتذلة (ماء مخلوط بمواد النفايات) / مكان معزول, منطقة راكدة (مكان أو حالة لا يحدث فيها أي تطور أو تقدم)\nمثال: البلد في حالة ركود اقتصادي",
 "はいすいかん": "أنبوب صرف, أنبوب نفايات (أنبوب يتم من خلاله نقل السوائل بعيداً) / أنبوب, قناة (ممر (أنبوب أو نفق) يمكن أن تمر عبره المياه أو الأسلاك الكهربائية)\nمثال: تم توصيل الحواسيب من خلال نظام من القنوات",
 "はいすいこう": "تَصْرِيف / ثقب التصريف, ميزاب السفينة (مصرف يسمح بتدفق المياه الموجودة على سطح السفينة إلى الخارج) / بَالُوعَة",
 "はいすいのじん": "كَمَلْجَأ أَخِير (يُفعل كملاذ أخير خاصة لمنع أزمة أو كارثة)",
 "はいすいりょう": "إِزَاحَة, نُزُوح",
 "はいすう": "زَارَ (زيارة شخص ما، عادة لفترة قصيرة)",
 "はいする": "هَزَمَ, غَلَبَ / أَبْطَلَ, أَلْغَى / وَزَّعَ (كَفَّ ومَنَعَ وحَبَسَ؛ به: أَغْرَى)\nمثال: وزع علينا الورق. / رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة. / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)\nمثال: زوجة ماري طبيبة. / نَفْي, تَبْعِيد / قَوْس, قوس / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا.",
