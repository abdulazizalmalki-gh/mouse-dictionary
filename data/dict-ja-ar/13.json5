 "はいがいてき": "حَصْرِيّ",
 "はいがら": "رَمَاد, سَكَن / دَرْدَار",
 "はいがん": "سَرَطَان اَلرِّئَة / اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم.",
 "はいき": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / إدارة, تصريف أمور (طريقة لرعاية أو إدارة شؤون مجموعة من الناس (خاصة الشؤون التجارية للمجموعة)) / طاحنة نفايات, فرامة مخلفات (جهاز مطبخ للتخلص من مخلفات الطعام) / تصرف (القدرة على استخدام شيء أو شخص (تحت التصرف))\nمثال: استخدم كل الموارد المتاحة تحت تصرفه / إلغاء, فسخ (فعل النسخ؛ إلغاء رسمي أو قانوني) / إبطال, فسخ ((في القانون) إنهاء رسمي (لعلاقة أو إجراء قضائي ونحوه)) / إبطال, إلغاء (حالة كونه ملغى أو مبطلاً) / اِسْتَهْلَكَ, اِسْتَنْفَدَ / إِبْعَاد ((في السياسية) عقوبة جنائية تقضي بإخراج المحكوم عليه من البلاد)",
 "はいきかん": "أُنْبُوبُ ٱلْعَادِمِ",
 "はいききょう": "استرواح الصدر (وجود غير طبيعي للهواء في التجويف الجنبي مما يؤدي إلى انخماص الرئة؛ قد يكون تلقائياً (بسبب إصابة في الصدر) أو مستحثاً (كعلاج لمرض السل))",
 "はいきこう": "نَفَّسَ, هَوَّى (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…) / نَفَّسَ عَن (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "はいきしゅ": "انتفاخ الرئة (حالة غير طبيعية للرئتين تتميز بانخفاض وظيفة الجهاز التنفسي)",
 "はいきしょぶん": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / إدارة, تصريف أمور (طريقة لرعاية أو إدارة شؤون مجموعة من الناس (خاصة الشؤون التجارية للمجموعة)) / طاحنة نفايات, فرامة مخلفات (جهاز مطبخ للتخلص من مخلفات الطعام) / تصرف (القدرة على استخدام شيء أو شخص (تحت التصرف))\nمثال: استخدم كل الموارد المتاحة تحت تصرفه",
 "はいきとう": "مَدْخَنَة",
 "はいきぶつ": "مخلفات, نفايات (أي مواد غير مستخدمة ومرفوضة على أنها عديمة القيمة أو غير مرغوب فيها)\nمثال: يجمعون النفايات مرة واحدة في الأسبوع",
 "はいきべん": "صمام العادم (صمام تخرج من خلاله الغازات المحترقة من الأسطوانة إلى مجمع العادم)",
 "はいきゃく": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / إدارة, تصريف أمور (طريقة لرعاية أو إدارة شؤون مجموعة من الناس (خاصة الشؤون التجارية للمجموعة)) / طاحنة نفايات, فرامة مخلفات (جهاز مطبخ للتخلص من مخلفات الطعام) / تصرف (القدرة على استخدام شيء أو شخص (تحت التصرف))\nمثال: استخدم كل الموارد المتاحة تحت تصرفه",
 "はいきゅう": "تَوْزِيع / تقنين, توزيع بالحصص (فعل التقنين (تحديد حصص))\nمثال: خلال الحرب فرضت الحكومة تقنين الغذاء والبنزين / الكُرَةُ اَلْطَّائِرَة",
 "はいきゅうせい": "تقنين, توزيع بالحصص (فعل التقنين (تحديد حصص))\nمثال: خلال الحرب فرضت الحكومة تقنين الغذاء والبنزين",
 "はいきょ": "خَرَاب, خَرَابَة / دَمَّرَ",
 "はいきょう": "رِدَّة, اِرْتِدَاد / إخراج, طرد (فعل الطرد أو القذف أو الإخراج) / إخراج, إقصاء (فعل إجبار شخص أو شيء على الخروج)\nمثال: طرد مثيري الشغب من قبل الشرطة",
 "はいきょうしゃ": "مُرْتَدّ",
 "はいきりょう": "إِزَاحَة, نُزُوح / إِزَاحَة",
 "はいきガス": "أبخرة العادم, عادم (غازات منبعثة من محرك كمنتجات نفايات)",
 "はいぎょ": "سمكة رئوية (سمكة تتنفس الهواء ولها جسم ممدود وزعانف مزدوجة لحمية؛ تبني بعض الأنواع أغطية طينية مبطنة بالمخاط للنجاة من الجفاف)",
 "はいぎょう": "إيقاف, انقطاع (فعل الإيقاف أو القطع؛ انقطاع (مؤقت أو دائم))",
 "はいく": "هَايْكُو",
 "はいくつ": "ثني ظهري (عملية الثني للخلف (للجسم أو لجزء من الجسم))",
 "はいぐう": "تركيب, جمع (عملية دمج الأشياء لتكوين كلٍ جديد) / توافيق, توليفة (فعل ترتيب العناصر في مجموعات محددة بغض النظر عن الترتيب) / تركيبة, توليفة (مجموعة من الأشياء التي تم دمجها؛ تجميع لأجزاء أو صفات منفصلة) / ائتلاف, تكتل (تحالف من الأشخاص أو الشركات أو البلدان لغرض خاص (سابقاً لتحقيق غاية معادية للمجتمع ولكن الآن لأغراض سياسية أو اقتصادية عامة)) / زَوْج, زَوْجَة (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة. / رجل وزوجته, زواج (شخصان متزوجان من بعضهما البعض)\nمثال: كان زواجه الثاني أكثر سعادة من الأول",
 "はいぐうし": "جاميت, مشيج (خلية تناسلية جنسية ناضجة تحتوي على مجموعة واحدة من الكروموسومات غير المزدوجة)",
 "はいぐうしけいせい": "تكون الأمشاج (تطور ونضج الخلايا الجنسية من خلال الانقسام المنصف)",
 "はいぐうしのう": "حاوية الأمشاج, محفظة مشيجية (خلية أو عضو تتطور فيه الأمشاج)",
 "はいぐうしゃ": "زَوْج, زَوْجَة (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "はいぐうしゃかんじんこうじゅせい": "تلقيح صناعي (إدخال السائل المنوي إلى قناة فالوب أو الرحم بوسيلة غير الجماع الجنسي)",
 "はいぐうたい": "طور مشيجي, نابت عروسي (الفرد أو الطور الحامل للأمشاج في دورة حياة النبات الذي يمر بتبادل الأجيال)",
 "はいぐん": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "はいけい": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز. / خلفية / دعم, مؤازرة (فعل تقديم الموافقة والدعم) / بطانة, دعامة خلفية (شيء يشكل ظهراً يضاف للتقوية) / تمويل, دعم مالي (الموارد المالية المقدمة لجعل مشروع ما ممكناً)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "はいけいせつめい": "إحاطة إعلامية (مؤتمر صحفي أو مقابلة يشرح فيه مسؤول حكومي للمراسلين خلفية إجراء أو سياسة ما)\nمثال: أعطانا الوزير إحاطة عن قضايا الصحة العامة",
 "はいけいほうしゃ": "إشعاع الخلفية (إشعاع قادم من مصادر أخرى غير تلك التي يتم رصدها)",
 "はいけいまく": "خلفية المسرح, ستارة خلفية (مناظر معلقة في الجزء الخلفي من المسرح)",
 "はいけっかく": "تدرن رئوي, سل رئوي (يشمل الرئتين مع هزال تدريجي للجسم)",
 "はいけっしょうせい": "إنتاني, متقيح (يحتوي على كائنات مسببة للأمراض أو ناتج عنها) / إنتاني, تعفني (من أو يتعلق بالتعفن أو ناتج عنه)\nمثال: التهاب حلق إنتاني",
 "はいけつしょう": "تَلَوُّث اَلْدَم (تَلَطُّخ، تَكَدُّر، قذارة ودنس يصيبان الجو أو الماء أو البيئة ويؤديان إلى تسمم أو أمراض؛ تَشَوُّه)\nمثال: التلوث يضر كوكبنا.",
 "はいけん": "بَصِير, مُبْصِر (بَصير؛ بَصُرَ: (فعل) بصُرَ / بصُرَ بـ يَبصُر ، بَصَرًا و بَصارَةً ، فهو بَصير ، والمفعول مبصور به) / رُؤْيَة\nمثال: パスポートを拝見できますか。 — هل لي أن أرى جواز سفرك؟",
 "はいげき": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "はいこう": "توجيه, دورة توجيهية (دورة تقدم موقفاً أو بيئة جديدة) / توجيه (فعل التوجيه) / إدراك الموقف, توجيه (وعي الشخص بنفسه فيما يتعلق بالموقع والزمان والمكان والعلاقات الشخصية) / إيثار, تفضيل (استعداد مسبق لتفضيل شيء ما)\nمثال: تفضيل للسيارات الباهظة / دِرْع, صَدَفَة (غطاء خارجي صلب لبعض الكائنات الحية مثل المفصليات والسلاحف)",
 "はいこうせい": "توجيه, دورة توجيهية (دورة تقدم موقفاً أو بيئة جديدة) / توجيه (فعل التوجيه) / إدراك الموقف, توجيه (وعي الشخص بنفسه فيما يتعلق بالموقع والزمان والمكان والعلاقات الشخصية) / إيثار, تفضيل (استعداد مسبق لتفضيل شيء ما)\nمثال: تفضيل للسيارات الباهظة",
 "はいご": "خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / خلفية",
 "はいごう": "تركيب, جمع (عملية دمج الأشياء لتكوين كلٍ جديد) / توافيق, توليفة (فعل ترتيب العناصر في مجموعات محددة بغض النظر عن الترتيب) / تركيبة, توليفة (مجموعة من الأشياء التي تم دمجها؛ تجميع لأجزاء أو صفات منفصلة) / ائتلاف, تكتل (تحالف من الأشخاص أو الشركات أو البلدان لغرض خاص (سابقاً لتحقيق غاية معادية للمجتمع ولكن الآن لأغراض سياسية أو اقتصادية عامة))",
 "はいごうきんき": "تعارض, تنافر (صفة عدم القدرة على الوجود أو العمل معًا بانسجام) / تَعَارُض, تَنَافُر (العلاقة بين القضايا التي لا يمكن أن تكون صحيحة في نفس الوقت) / عدم توافق ((علم المناعة) الدرجة التي سيحاول بها الجهاز المناعي للجسم رفض المواد الغريبة (كالدم المنقول أو الأنسجة المزروعة))",
 "はいごうせいり": "إعادة تنظيم, إعادة هيكلة (تغيير واسع النطاق لهيكل شركة أو حكومة) / إعادة تنظيم (فرض تنظيم جديد؛ التنظيم بشكل مختلف (غالباً ما ينطوي على تغييرات واسعة وجذرية))\nمثال: بعد الاستحواذ كان هناك إعادة تنظيم شاملة",
 "はいごうど": "دبال, سماد عضوي (خليط من النباتات المتحللة والروث؛ يستخدم كسماد)",
 "はいごかんけい": "خلفية",
 "はいごれい": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "はいさい": "آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "はいさく": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "はいさつ": "افْتِرَاض, تَخْمِين (رسالة تعبر عن رأي يستند إلى أدلة غير كاملة)",
 "はいざ": "اِمْتِثَال, تَوَافُق (التصرف وفقاً لمعايير معينة مقبولة) / بنية, تكوين (أي سمات مكانية (خاصة كما يحددها المخطط الخارجي)) / بنية, تشكيل (ترتيب متماثل لأجزاء الشيء)\nمثال: بياناتهم المالية متوافقة مع الممارسات المحاسبية المقبولة عموماً",
 "はいざい": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر / تَحِلَّة",
 "はいざら": "مِنْفَضَة, طَفَّايَة",
 "はいざん": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / مُعْدَم, مُفْلِس (يفتقر إلى الموارد أو أي احتمال للحصول عليها) / بائِس, مُعْدَم (شخص يعيش في فقر مدقع)\nمثال: حاول مساعدة البائسين",
 "はいし": "إِلْغَاء, اِبْطَال / جَنِين / خَرَاب, خَرَابَة / دَمَّرَ",
 "はいしつ": "إعاقة, عجز (حالة عدم القدرة على الأداء نتيجة لعدم اللياقة البدنية أو العقلية)\nمثال: إعاقة القراءة",
 "はいしゃ": "طَبِيب أَسْنَان, طَبِيبَة أَسْنَان (العالم بالطب)\nمثال: سوف تصبح طبيبة. / خَاسِر / فَاشِل",
 "はいしゃく": "استعارة, اقتباس (الاستيلاء (على الأفكار أو الكلمات، إلخ) من مصدر آخر) / اقتراض (الحصول على أموال من مقرض)\nمثال: كان اقتباس الزخارف القديمة واضحاً جداً",
 "はいしゃふっかつ": "رِيمُونْتَادَا / جولة الفرصة الثانية, سباق الترضية (سباق (خاصة في التجديف) يتنافس فيه الخاسرون في التصفيات من أجل مكان في السباق النهائي)",
 "はいしゃふっかつせん": "جولة الفرصة الثانية, سباق الترضية (سباق (خاصة في التجديف) يتنافس فيه الخاسرون في التصفيات من أجل مكان في السباق النهائي)",
 "はいしゅ": "بويضة صغيرة (بويضة صغيرة أو غير ناضجة) / بويضة (جسم صغير يحتوي على الخلية الجرثومية الأنثوية للنبات؛ يتطور إلى بذرة بعد الإخصاب) / جُرْثُومَة",
 "はいしゅつ": "إطلاق نار (فعل إطلاق النار من بندقية) / إبراء ذمة, إخلاء طرف (بيان مكتوب رسمي بالتنازل أو الإبراء) / إقالة, تسريح (إنهاء توظيف شخص ما (وتركه حراً للمغادرة)) / تصريف, تنفيس (فعل التنفيس أو الإخراج)",
 "はいしゅつぶつ": "إطلاق نار (فعل إطلاق النار من بندقية) / إبراء ذمة, إخلاء طرف (بيان مكتوب رسمي بالتنازل أو الإبراء) / إقالة, تسريح (إنهاء توظيف شخص ما (وتركه حراً للمغادرة)) / تصريف, تنفيس (فعل التنفيس أو الإخراج)",
 "はいしゅつべん": "صمام العادم (صمام تخرج من خلاله الغازات المحترقة من الأسطوانة إلى مجمع العادم)",
 "はいしょ": "رئة كتابية (عضو في العديد من العناكب يحتوي على العديد من الطيات الغشائية الرقيقة التي تشبه أوراق الكتاب)",
 "はいしょう": "سَمِيع (سَميع: (اسم)؛ سميع: (اسم)) / سَمْع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى)) / جَلْسَة\nمثال: سمع سامي صريرا.",
 "はいしょく": "مخطط ألوان, نسق لوني (مزيج مخطط من الألوان)\nمثال: تم تحديد النسق اللوني لهذه الغرفة بواسطة مصمم داخلي / تنسيق الحدائق (العمل كبستاني مناظر طبيعية) / تنسيق حدائق (حديقة مصممة لتأثير جمالي)\nمثال: أنفقوا قدراً كبيراً من المال على تنسيق الحدائق",
 "はいしよてい": "آيِلٌ لِلتَّقَادُمِ (في طريقه إلى أن يصبح متقادماً وعتيقاً)",
 "はいしん": "خيانة, غدر (فعل خيانة متعمد) / خِيَانَة (صفة مساعدة العدو) / تَوْزِيع",
 "はいしんこうい": "خيانة الأمانة (انتهاك (إما عن طريق الاحتيال أو الإهمال) من قبل وصي لواجب يفرضه عليه الانصاف)",
 "はいしんしゃ": "خَائِن, خَائِنَة (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك! / قَاسِم / بَثَّاث",
 "はいじ": "اِسْتَقَالَ",
 "はいじく": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "はいじゅ": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "はいじゅんかん": "دَوْرَة دَمَوِيَّة صُغْرَى (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "はいじょ": "إقْصَاء, اِسْتِثْنَاء / حرمان من الميراث (فعل من قبل المورث ينهي حق الشخص في الميراث)",
 "はいじょうみゃく": "وريد رئوي (أي من أربعة أوردة تحمل الدم الشرياني من الرئتين إلى الأذين الأيسر للقلب)",
 "はいじょそちめいれい": "أمر قضائي زجري, أمر منع ((في القانون) تدبير قضائي يصدر لمنع طرف من القيام بنشاط معين أو الاستمرار فيه)\nمثال: كان يتم الحصول على الأوامر القضائية سابقاً بموجب مذكرة ولكن الآن بموجب أمر قضائي",
 "はいじょようそ": "إقْصَاء, اِسْتِثْنَاء",
 "はいじん": "مُقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد. / مُدْمِن, مُدْمِنَة",
 "はいす": "هَزَمَ, غَلَبَ / أَبْطَلَ, أَلْغَى / دَمَر / وَزَّعَ (كَفَّ ومَنَعَ وحَبَسَ؛ به: أَغْرَى)\nمثال: وزع علينا الورق. / رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة. / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة. / نَفْي, تَبْعِيد / نَفَى / قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "はいすい": "تَصْرِيف / إِزَاحَة, نُزُوح / إِزَاحَة / إمدادات المياه, نظام مياه (منشأة توفر مصدراً للمياه)\nمثال: ناقشت المدينة تنقية إمدادات المياه / مياه عادمة, مياه مبتذلة (ماء مخلوط بمواد النفايات) / مكان معزول, منطقة راكدة (مكان أو حالة لا يحدث فيها أي تطور أو تقدم) / مسطح مائي راكد, مياه راكدة (مسطح مائي نشأ عن فيضان أو مد أو بسبب حجزه بواسطة سد)\nمثال: البلد في حالة ركود اقتصادي",
 "はいすいかん": "أنبوب صرف, أنبوب نفايات (أنبوب يتم من خلاله نقل السوائل بعيداً) / أنبوب, قناة (ممر (أنبوب أو نفق) يمكن أن تمر عبره المياه أو الأسلاك الكهربائية)\nمثال: تم توصيل الحواسيب من خلال نظام من القنوات",
 "はいすいこう": "تَصْرِيف / ثقب التصريف, ميزاب السفينة (مصرف يسمح بتدفق المياه الموجودة على سطح السفينة إلى الخارج) / بَالُوعَة",
 "はいすいのじん": "كَمَلْجَأ أَخِير (يُفعل كملاذ أخير خاصة لمنع أزمة أو كارثة)",
 "はいすいりょう": "إِزَاحَة, نُزُوح / إِزَاحَة",
 "はいすう": "زَارَ (زيارة شخص ما، عادة لفترة قصيرة)",
 "はいする": "هَزَمَ, غَلَبَ / أَبْطَلَ, أَلْغَى / دَمَر / وَزَّعَ (كَفَّ ومَنَعَ وحَبَسَ؛ به: أَغْرَى)\nمثال: وزع علينا الورق. / رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة. / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة. / نَفْي, تَبْعِيد / نَفَى / قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "はいずる": "زحف (طريقة تنقل بطيئة على اليدين والركبتين أو بجر الجسم) / حظيرة صغار الحيوانات (حظيرة مسيجة بحيث يمكن لصغار الحيوانات دخولها ولكن لا يمكن للكبار ذلك) / زحف (حركة طولية بطيئة أو تشوه بطيء) / شخص منفر, غريب الأطوار (شخص غريب بشكل مزعج أو شاذ)\nمثال: كان الزحف هو كل ما استطاع الرجل المصاب القيام به",
 "はいせい": "جَنِينِيّ, فِي طَوْرِ التَّكَوُّن (في مرحلة مبكّرة من التطوّر) / جَنِينِيّ (يتعلق بالكائن الحي قبل الولادة أو الفقس)",
 "はいせいかんさいぼう": "أينشتاينيوم (عنصر مشع ما بعد اليورانيوم يتم إنتاجه بقصف البلوتونيوم بالنيوترونات)",
 "はいせいしん": "قلب رئوي (تضخم البطين الأيمن للقلب بسبب مرض في الرئتين أو الأوعية الدموية الرئوية)",
 "はいせき": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / روث, زبل (فضلات الحيوانات) / حمأة, طين لزج (أي مادة سميكة ولزجة)",
 "はいせきうんどう": "قَاطَعَ / مُقَاطَعَة",
 "はいせつ": "إبراز, إخراج (العملية الجسدية لتصريف الفضلات) / إفرازات, فضلات الجسم (نفايات (مثل البول أو العرق ولكن خاصة البراز) يتم تصريفها من الجسم)",
 "はいせつきかん": "عضو إخراجي (عضو يفصل مواد النفايات عن الدم ويطرحها)",
 "はいせつくんれん": "تدريب على المرحاض (تدريب الطفل الصغير على استخدام المرحاض)",
 "はいせつじょ": "استئصال الرئة (إزالة جراحية لرئة (عادة لعلاج سرطان الرئة))",
 "はいせつじょじゅつ": "استئصال الرئة (إزالة جراحية لرئة (عادة لعلاج سرطان الرئة))",
 "はいせつぶつ": "إبراز, إخراج (العملية الجسدية لتصريف الفضلات) / إفرازات, فضلات الجسم (نفايات (مثل البول أو العرق ولكن خاصة البراز) يتم تصريفها من الجسم)",
 "はいせん": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة / تسليك, تمديد الأسلاك (عمل تركيب الأسلاك لنظام أو جهاز كهربائي) / أسلاك, تمديدات كهربائية (دائرة من الأسلاك لتوزيع الكهرباء) / حطام سفينة, هيكل سفينة (سفينة تحطمت وهُجرت) / ضخم, عملاق (شخص كبير جداً؛ مثير للإعجاب في الحجم أو الصفات) / مُسْتَنْزَف الْمَاء, نَاضِب (نضب ماؤه واستُنزف) / ذَابِل, يَابِس ((يُوصف به النبات خاصّةً) فَقَد كلّ رطوبته وذبل)",
 "はいせんがん": "سَرَطَان اَلرِّئَة",
 "はいせんこうじ": "تسليك, تمديد الأسلاك (عمل تركيب الأسلاك لنظام أو جهاز كهربائي) / أسلاك, تمديدات كهربائية (دائرة من الأسلاك لتوزيع الكهرباء)",
 "はいせんず": "مخطط الأسلاك (رسم تخطيطي لأسلاك نظام كهربائي)",
 "はいせんばん": "لوحة مفاتيح, مقسم (مركز هاتف حيث يتم إكمال الدوائر بأسلاك التوصيل)",
 "はいぜつ": "إِلْغَاء, اِبْطَال / اِنْقِرَاض",
 "はいぜん": "جَارِف, سَيْلِيّ (ينهمر بغزارة شديدة) / جَارِف, عَارِم (يُشْبِهُ السَّيْلَ فِي قُوَّتِهِ وَوَفْرَتِه) / جارف, سيلي (متعلق بالسيل أو ناتج عن تدفق قوي للمياه)\nمثال: تعرية سيلية",
 "はいぜんしつ": "خزانة طعام, مخزن المؤن (مخزن صغير لتخزين الأطعمة أو المشروبات)",
 "はいぜんにん": "نَادِل, نَادِلَة",
 "はいそう": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة) / تَحْلِيق / فِرَار, هُرُوب\nمثال: الطيران أسرع وسيلة سفر. / تَوْصِيل, تَسْلِيم / مَخَاض, وَضْع / إِلْقَاء (إِلْقَاءُ الشَّبَكَةِ فِي البَحْرِ : رَمْيُها؛ إِلْقاءُ مُحَاضَرَةٍ : إعْطَاؤُهُا، أَي الحَدِيثُ فِي مَوْضُوعٍ أَمَامَ جَمْهُورٍ)\nمثال: مروا بسرعة و بدون إلقاء نظرة. / مُرَافَقَة / إرسال, بعث (فعل التسبب في ذهاب شيء ما (خاصة الرسائل))",
 "はいそうぎょうしゃ": "شركة شحن (شركة تعمل في مجال شحن البضائع) / شاحن (شخص يقوم بشحن البضائع)",
 "はいそうてん": "مُسَلِّم, مُوَصِّل (شخص يسلم أو ينقل أموالاً أو بضائع) / عامل توصيل, موصل طلبات (شخص يعمل لتوصيل الطلبات) / مُخَلِّص, مُنقِذ (شخص ينقذك من الأذى أو الخطر)",
 "はいそく": "ظَهْرِيّ",
 "はいそくせん": "انصمام رئوي (انسداد الشريان الرئوي بمادة غريبة أو بجلطة دموية)",
 "はいそくせんしょう": "انصمام رئوي (انسداد الشريان الرئوي بمادة غريبة أو بجلطة دموية)",
 "はいそん": "مَدِينَة أَشْبَاح, مَدِينَة الْأَشْبَاح",
 "はいぞう": "رِئَة, سَحَر",
 "はいぞく": "تسمية, تعيين (فعل وضع شخص في منصب غير انتخابي) / تخصيص, تعيين (فعل توزيع شيء ما على أماكن أو أشخاص معينين) / تكليف, مهمة (واجب تكلف بأدائه (خاصة في القوات المسلحة)) / تكليف, واجب منزلي (مشروع تم تكليفك بالقيام به (كما من قبل مدرب أو معلم))\nمثال: كان يجب الموافقة على التعيين من قبل اللجنة بأكملها",
 "はいぞくしょうこう": "ضابط مفوض, ضابط نظامي (ضابط عسكري يحمل تكليفاً رسمياً (مرسوماً))",
 "はいた": "إقْصَاء, اِسْتِثْنَاء / أَلَمُ أَسْنَان, أَلَمُ الْأَسْنَان (الوَجَع)\nمثال: ألم أقل لك ذلك؟",
 "はいたい": "اِنْتَاش / نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه. / نَخْر / اضمحل / تضعضع / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "はいたえんざん": "إقْصَاء, اِسْتِثْنَاء",
 "はいたか": "بَاشِق",
 "はいたげんり": "مبدأ استبعاد باولي (لا يمكن لأي إلكترونين أو بروتونين أو نيوترونين في نظام معين أن يكونا في حالات تتميز بنفس مجموعة الأعداد الكمية)",
 "はいたつ": "تَوْصِيل, تَسْلِيم / مَخَاض, وَضْع / إِلْقَاء (إِلْقَاءُ الشَّبَكَةِ فِي البَحْرِ : رَمْيُها؛ إِلْقاءُ مُحَاضَرَةٍ : إعْطَاؤُهُا، أَي الحَدِيثُ فِي مَوْضُوعٍ أَمَامَ جَمْهُورٍ)\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "はいたついん": "مُسَلِّم, مُوَصِّل (شخص يسلم أو ينقل أموالاً أو بضائع) / عامل توصيل, موصل طلبات (شخص يعمل لتوصيل الطلبات) / مُخَلِّص, مُنقِذ (شخص ينقذك من الأذى أو الخطر)",
 "はいたつさき": "وِجْهَة, وُجْهَة",
 "はいたてき": "حَصْرِيّ",
 "はいたりつ": "مبدأ استبعاد باولي (لا يمكن لأي إلكترونين أو بروتونين أو نيوترونين في نظام معين أن يكونا في حالات تتميز بنفس مجموعة الأعداد الكمية)",
 "はいたんそ": "جمرة خبيثة رئوية (شكل من أشكال عدوى الجمرة الخبيثة المكتسبة عن طريق استنشاق الغبار المحتوي على البكتيريا)",
 "はいだつ": "تَوْصِيل, تَسْلِيم / مَخَاض, وَضْع / إِلْقَاء (إِلْقَاءُ الشَّبَكَةِ فِي البَحْرِ : رَمْيُها؛ إِلْقاءُ مُحَاضَرَةٍ : إعْطَاؤُهُا، أَي الحَدِيثُ فِي مَوْضُوعٍ أَمَامَ جَمْهُورٍ)\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "はいち": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية. / تَنَاقُض, عَدَم اتِّسَاق (صفة عدم الاتساق وافتقار الانسجام بين الأشياء أو الأجزاء) / تَعَارُض, تَنَافُر (العلاقة بين القضايا التي لا يمكن أن تكون صحيحة في نفس الوقت)",
 "はいちてんかん": "إعادة خلط, تعديل وزاري (الخلط مرة أخرى)\nمثال: طلب المقامر إعادة خلط الأوراق",
 "はいちゃく": "حرمان من الميراث (فعل من قبل المورث ينهي حق الشخص في الميراث)",
 "はいちょうきん": "عضلة الساق التوأمية (العضلة الموجودة في الجزء الخلفي من الساق التي تشكل الجزء الأكبر من ربلة الساق؛ مسؤولة عن الثني الأخمصي للقدم)",
 "はいつう": "ألم الظهر (وجع موضعي في الظهر)",
 "はいてい": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "はいてつザクロいし": "أندراديت (عقيق يتكون من سيليكات الكالسيوم والحديد وتتراوح ألوانه من الأصفر والأخضر إلى البني والأسود؛ يستخدم كحجر كريم)",
 "はいてん": "إعادة خلط, تعديل وزاري (الخلط مرة أخرى)\nمثال: طلب المقامر إعادة خلط الأوراق / نقيض الأوج الشمسي (النقطة المعاكسة في الاتجاه للأوج الشمسي؛ النقطة التي يبتعد عنها النظام الشمسي)",
 "はいでんしょ": "مَحَطَّة طَاقَة",
 "はいでんせん": "خَطّ اَلْكَهْرَبَاء, خَطّ اَلطَّاقَة (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "はいでんばん": "لوحة مفاتيح, مقسم (مركز هاتف حيث يتم إكمال الدوائر بأسلاك التوصيل)",
 "はいでんもう": "شبكة الكهرباء, نظام الطاقة (نظام من الكابلات عالية الجهد يتم من خلاله توزيع الطاقة الكهربائية عبر منطقة ما)",
 "はいと": "مَجْمُوعَة إثْنِيَّة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "はいとう": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة) / تخصيص, مخصص (حصة مخصصة لغرض محدد)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية / حِصَّة / مَقْسُوم / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ) / إِجَابَة, جَوَاب\nمثال: أجاب ياني فورا.",
 "はいとうきん": "حِصَّة / مَقْسُوم",
 "はいとうごう": "تكامل, توحيد (عملية الدمج في كلٍ متكامل) / تصلب, تماسك (التجمع في كتلة صلبة) / كُتْلَة مُتَصَلِّبَة (شيء تصلب ليصبح كتلة مدمجة)\nمثال: دمج شركتين",
 "はいとうたい": "غليكوزيد (مجموعة من المركبات المشتقة من السكريات الأحادية)",
 "はいとうひょう": "قائمة التوزيع (قائمة بأسماء الأشخاص الذين يجب إرسال رسالة إليهم)",
 "はいとうみつ": "دِبْس, عَسَل أَسْوَد (دبسه:ستره وواراه.1؛ الخف: رقعه.1)",
 "はいとく": "فَسَاد",
 "はいとくてき": "فاسد, لا أخلاقي (ينتهك عمداً المبادئ المقبولة للصواب والخطأ) / فَاسِد, لَا أَخْلَاقِيّ (لا يلتزم بالمبادئ الأخلاقية أو القِيَمية)",
 "はいとこ": "قريب من الدرجة الثانية (ابن ابن عم أو ابن خال أحد الوالدين)",
 "はいとり": "مصيدة ذباب (فخ لصيد الذباب)",
 "はいどうみゃく": "شريان رئوي (واحد من شريانين (فرعي الجذع الرئوي) يحملان الدم الوريدي من القلب إلى الرئتين)",
 "はいどうみゃくべん": "صمام رئوي (صمام هلالي بين البطين الأيمن والشريان الرئوي؛ يمنع الدم من التدفق من الشريان عائداً إلى القلب)",
 "はいどうみゃくべんきょうさくしょう": "صمام رئوي (صمام هلالي بين البطين الأيمن والشريان الرئوي؛ يمنع الدم من التدفق من الشريان عائداً إلى القلب)",
 "はいどく": "قِرَاءَة",
 "はいにく": "جِيفة, فَطِيسَة",
 "はいにゅう": "بياض البيض, زلال (الجزء الأبيض من البيضة؛ المادة الهلامية المغذية والواقية المحيطة بالصفار وتتكون أساساً من الألبومين المذاب في الماء) / ألبومين, زلال (بروتين بسيط قابل للذوبان في الماء يوجد في العديد من الأنسجة والسوائل الحيوانية)",
 "はいにょう": "تبول (إخراج البول)",
 "はいにょうこんなん": "عسر التبول (تبول مؤلم أو صعب)",
 "はいにょうしょうがい": "عسر التبول (تبول مؤلم أو صعب)",
 "はいにん": "خيانة الأمانة (انتهاك (إما عن طريق الاحتيال أو الإهمال) من قبل وصي لواجب يفرضه عليه الانصاف)",
 "はいにんざい": "خيانة الأمانة (انتهاك (إما عن طريق الاحتيال أو الإهمال) من قبل وصي لواجب يفرضه عليه الانصاف)",
 "はいのう": "حقيبة ظهر, حقيبة محمولة على الظهر (حقيبة تُحمل بحزام على الظهر أو الكتف)",
 "はいのすいようび": "أربعاء الرماد (سابع أربعاء قبل عيد الفصح؛ اليوم الأول من الصوم الكبير؛ اليوم التالي لماردي غرا ('الثلاثاء البدين')؛ يوم للصيام والتوبة)",
 "はいのぼる": "تسلق بصعوبة (تسلق محرج أو صعب)\nمثال: كان الوصول إلى القمة تسلقاً صعباً",
 "はいのり": "سرقة الهوية (الاستيلاء على المعلومات الشخصية لشخص آخر (مثل الاسم، رقم الضمان الاجتماعي، رقم بطاقة الائتمان، جواز السفر) دون علم ذلك الشخص والاستخدام الاحتيالي…)",
 "はいはい": "زحف (طريقة تنقل بطيئة على اليدين والركبتين أو بجر الجسم)\nمثال: كان الزحف هو كل ما استطاع الرجل المصاب القيام به / أَيّ, أَيَّمَا (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / مَهْمَا مَا / طُز\nمثال: لم تقصد أي أذى. / بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "はいはん": "مُثِير لِلاشْمِئْزَاز, مُقْرِف (بالغ الكراهة؛ يثير النفور والاشمئزاز) / تَنَاقُضٌ / مُتَعَارِضٌ تَمَامًا, مُتَنَاقِض (لا يمكن أن يوجدا أو يصدقا في الوقت نفسه)",
 "はいはんこうい": "اِنْتِهَاك",
 "はいばいようし": "أخصائي علم الأجنة (طبيب متخصص في علم الأجنة)",
 "はいばん": "أدمة الأريمة, قرص جرثومي (طبقة من الخلايا في الجزء الداخلي للأريمة) / لوح إسناد, لوح ظهر (لوح يستخدم لدعم ظهر شخص أو شيء ما) / لوحة السلة (لوحة رأسية مرتفعة مثبت بها سلة؛ تستخدم للعب كرة السلة)\nمثال: ارتدت الكرة من اللوحة / إيقاف, انقطاع (فعل الإيقاف أو القطع؛ انقطاع (مؤقت أو دائم))",
 "はいばんほう": "كيسة أريمية (أريمة الثدييات المشيمية التي حدث فيها بعض تمايز الخلايا)",
 "はいひん": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "はいひんかいしゅう": "إنقاذ السفن, انتشال (فعل إنقاذ سفينة أو طاقمها أو شحنتها من غرق أو حريق) / إنقاذ الممتلكات (فعل إنقاذ البضائع أو الممتلكات التي كانت معرضة لخطر التلف أو الدمار) / بضائع مستنقذة (ممتلكات أو بضائع تم إنقاذها من التلف أو الدمار)",
 "はいひんかいしゅうぎょう": "جمع القمامة, رفع النفايات (جمع وإزالة القمامة)",
 "はいひんかいしゅうぎょうしゃ": "جامع قمامة, عامل نظافة (رجل موظف لجمع والتخلص من النفايات)",
 "はいび": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "はいびょう": "تدرن رئوي, سل رئوي (يشمل الرئتين مع هزال تدريجي للجسم)",
 "はいふ": "تَوْزِيع / وَزَّعَ (كَفَّ ومَنَعَ وحَبَسَ؛ به: أَغْرَى)\nمثال: وزع علينا الورق. / رِئَة, سَحَر / تَخْصِيص",
 "はいふく": "سُجُود",
 "はいふさきひょう": "قائمة التوزيع (قائمة بأسماء الأشخاص الذين يجب إرسال رسالة إليهم)",
 "はいふさきひょうてんかい": "قائمة التوزيع (قائمة بأسماء الأشخاص الذين يجب إرسال رسالة إليهم)",
 "はいふさきひょうめい": "قائمة التوزيع (قائمة بأسماء الأشخاص الذين يجب إرسال رسالة إليهم)",
 "はいふしりょう": "كُرَّاسَة / نَشْرَة",
 "はいふぶつ": "كُرَّاسَة / نَشْرَة / تَوْزِيع",
 "はいぶ": "خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "はいぶつ": "مخلفات, نفايات (أي مواد غير مستخدمة ومرفوضة على أنها عديمة القيمة أو غير مرغوب فيها)\nمثال: يجمعون النفايات مرة واحدة في الأسبوع",
 "はいぶつあい": "صنمية جنسية, فيتيشية (الإثارة الجنسية أو الإشباع الناتج عن التعامل مع صنم (أو جزء معين من الجسم غير الأعضاء التناسلية)) / تقديس الأشياء, فيتيشية (الاعتقاد بالقوة السحرية للأشياء المادية (أو عبادة التمائم))",
 "はいぶつきょう": "صنمية جنسية, فيتيشية (الإثارة الجنسية أو الإشباع الناتج عن التعامل مع صنم (أو جزء معين من الجسم غير الأعضاء التناسلية)) / تقديس الأشياء, فيتيشية (الاعتقاد بالقوة السحرية للأشياء المادية (أو عبادة التمائم))",
 "はいぶつりよう": "إِعَادَةْ تَدْوِير",
 "はいぶん": "تَوْزِيع / سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا.",
 "はいぶんほう": "تَخْصِيص",
 "はいべん": "تبرز, تغوط (إخراج الفضلات البرازية عبر فتحة الشرج)",
 "はいほう": "حويصلة هوائية, سنخ (كيس صغير جداً لحمل الهواء في الرئتين؛ يتكون من التوسع النهائي للممرات الهوائية الدقيقة)",
 "はいほうえん": "التهاب الأسناخ (التهاب الأسناخ في الرئتين الناتج عن استنشاق الغبار؛ مع التعرض المتكرر قد تصبح الحالة مزمنة) / التهاب السنخ الجاف (التهاب في سنخ السن؛ يحدث أحياناً بعد قلع السن وفشل تكون جلطة دموية)",
 "はいぼう": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "はいぼく": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "はいぼくしゃ": "خَاسِر / فَاشِل",
 "はいぼくしゅぎ": "انهزامية (قبول حتمية الهزيمة)",
 "はいぼくしゅぎしゃ": "انهزامي, سلبي (شخص يستسلم للهزيمة دون تقديم اقتراحات إيجابية)",
 "はいまく": "برقع, غشاء جنيني (الغشاء الداخلي للأجنة في الفقاريات العليا (خاصة عندما يغطي الرأس عند الولادة))",
 "はいめつ": "نَخْر / اضمحل / تضعضع",
 "はいめん": "خَلْفِيّ",
 "はいめんとび": "قفزة فوسبري (القفز فوق العارضة للخلف والرأس أولاً)",
 "はいやく": "اختيار الممثلين, توزيع الأدوار (اختيار الممثلين للعب أدوار معينة في مسرحية أو فيلم) / رمي الصنارة (فعل رمي خيط الصيد فوق الماء بواسطة صنارة وبكرة) / سبك, صب (فعل إنشاء شيء ما عن طريق صبه في قالب) / قالب, مصبوب (شيء تم تشكيله بواسطة قالب)",
 "はいやま": "حَائِط, جِدَار / سُور, سور / جِدَار, حيط",
 "はいゆう": "مُمَثِّل, مُمَثِّلَة",
 "はいよ": "مَغْلُوب / بشكل حسن, على ما يرام (بطريقة مرضية أو كافية) / حَسَن, عَلَى مَا يُرَام (مُرْضٍ أو في حالة مُرْضِية) / إشارة القبول, موافقة (تأييد أو موافقة)\nمثال: ستبلي حسناً بمفردها",
 "はいよう": "فص الرئة (أي من الفصوص الثلاثة للرئة اليمنى أو الفصين للرئة اليسرى) / ارتداء, لبس (فعل وضع شيء على الجسم كغطاء أو زينة) / مُتْعِب, مُرْهِق (يُسبّب الإنهاك والإعياء) / تعرية, نحت ((في الجيولوجيا) العملية الميكانيكية لتآكل أو طحن شيء ما (كما يحدث عند غسل الجسيمات له)، وتستخدم مجازياً أيضاً)\nمثال: اشترته للارتداء اليومي / طبقة جرثومية, طبقة منتشة ((في علم الأجنة) أي من طبقات الخلايا الثلاث التي تتمايز في الأجنة بعد عملية المعيدة)",
 "はいようそ": "آيِلٌ لِلتَّقَادُمِ (في طريقه إلى أن يصبح متقادماً وعتيقاً)",
 "はいらん": "إباضة, تبويض (طرد البويضة من المبيض (عادة في منتصف الدورة الشهرية))",
 "はいり": "اغتراب, جفاء (الشعور بالغربة عن الآخرين) / اغتراب, نفرة (الانفصال الناتج عن العداء) / سَخَافَة",
 "はいりきる": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "はいりくち": "دُخُول / مَدْخَل",
 "はいりぐち": "دُخُول / مَدْخَل",
 "はいりこむ": "اِخْتَرَقَ",
 "はいりほう": "الإثبات بالخلف, برهان الخلف (دحض عن طريق إظهار أن عواقب الاقتراح سخيفة؛ أو إثبات اقتراح عن طريق إظهار أن نفيها يؤدي إلى تناقض)",
 "はいりょ": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "はいりょう": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "はいる": "أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى. / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر. / شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه) / اِنْقَلَبَ عَلَى\nمثال: شغل بيل التلفاز. / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / نَفْي, تَبْعِيد / نَفَى",
 "はいれい": "عَصَى / عِبَادَة / عَبَدَ, سَجَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / سَجَدَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "はいれつ": "توزيع موسيقي (فعل ترتيب وتكييف قطعة موسيقية) / مُتَتَالِيَة, مُتَوَالِيَة / مَصْفُوفَة",
 "はいろ": "يَلٰجَأَ",
 "はいろう": "رواق الكنيسة, نارثكس (دهليز يؤدي إلى صحن الكنيسة) / الرواق الخارجي, رواق الكنيسة (رواق عند الطرف الغربي للكنيسة أو البازيليكا المسيحية المبكرة)",
 "はいガス": "أبخرة العادم, عادم (غازات منبعثة من محرك كمنتجات نفايات)",
 "はい上がる": "هَزَمَ, غَلَبَ",
 "はい芽": "جُرْثُومَة",
 "はう": "زَحَفَ, دَبَّ (تَقَدَّمَ على الأرضِ معتمداً على بطنه دون استخدامٍ للأطراف؛ الشيءُ: تَقَدَّمَ ببطءٍ نحو الأمامِ)\nمثال: زحف سامي عبر نافذته. / تلوّي, تململ (عملية التلوّي أو التململ) / جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال) / أَثَر (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع) / مَسْلَك (المَسْلَك: الطريقُ سلكنا مَسْلكًا لم يسلكه أحد من قبل ، - مسالك الجبال ، - هذا مَسْلك وعر؛ المَسْلَك: سلوك، تصرُّف)\nمثال: اضطررت إلى جر سامي.",
 "はうちわかえで": "قيقب البدر, قيقب ياباني (أوراق محززة بعمق وحمراء زاهية في الخريف؛ اليابان) / قيقب ياباني كفي (شجيرة زينة أو شجرة صغيرة من اليابان وكوريا بأوراق محززة بعمق؛ تزرع في العديد من الأصناف)",
 "はえ": "رياح جنوبية (رياح تهب من الجنوب) / صَيْف, صيف (فصل من فصول السنة الأربعة، يلي الرَّبِيع ويأتي بعده الخَرِيف، يتميز بشدة الحَرّ)\nمثال: نأتي هنا كل صيف. / ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة. / جلي, دعك (فعل تنظيف سطح بفركه بفرشاة وصابون وماء) / غَيْر مُنْتَقًى ((عن الحيوانات الداجنة) لم تتمّ تربيتها بشكل انتقائيّ) / أدغال, شجيرات قصيرة (نباتات كثيفة تتكون من أشجار متقزمة أو شجيرات) / منوة (سمكة مياه عذبة أوروبية صغيرة جداً شائعة في الجداول الحصوية) / مَجْد, جَلَال (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد به) / مَجْد, شَرَف (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد به)\nمثال: المجد لأوكرانيا",
 "はえある": "بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين) / عظيم, مجيد (ذو مجد أو يستحق المجد أو يمنحه) / بَهِيّ, رَائِع (يتّسم بالعظمة والفخامة)\nمثال: مسيرة مهنية طويلة ومجيدة",
 "はえき": "رافدة سقف (واحدة من عدة عوارض مائلة متوازية تدعم السقف) / راكب الطوافة (شخص يسافر بواسطة طوافة (رمث))",
 "はえぎわ": "خط الشعر, منبت الشعر (الحد الطبيعي الذي يشكله الشعر على الرأس) / خط رفيع جداً, خط شعري (خط رفيع للغاية)",
 "はえざ": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة.",
 "はえたたき": "مضرب الذباب, منشة ذباب (أداة ذات جزء مسطح (من شبكة أو بلاستيك) ومقبض طويل؛ تستخدم لقتل الحشرات)",
 "はえでる": "نَبْتَة",
 "はえとり": "مصيدة ذباب (فخ لصيد الذباب)",
 "はえとりがみ": "ورق صائد الذباب (ورق مسمم أو مطلي بمادة لزجة لقتل الذباب)",
 "はえとりぐさ": "خناق الذباب, ديونية (نبات آكل للحوم من السهول الساحلية في كارولينا له نصال أوراق حساسة ذات مفصلات وحواف خشنة تنغلق وتحتجز الحشرات)",
 "はえとりそう": "خناق الذباب, ديونية (نبات آكل للحوم من السهول الساحلية في كارولينا له نصال أوراق حساسة ذات مفصلات وحواف خشنة تنغلق وتحتجز الحشرات)",
 "はえぬき": "ابْنُ البَلَد, مَوْلُودٌ فِي البَلَد (يَنْتَمِي إِلَى مَكَانٍ بِحُكْمِ الوِلَادَةِ فِيهِ) / مُنْذُ البِدَايَة",
 "はえる": "نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟ / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / قَصَّ\nمثال: ذلك سيهيج الجرح. / لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "はえー": "عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان. / بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر. / سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع) / مُتَسَرِّع, مُسْتَعْجَل (أبكر ممّا ينبغي أو أكثر تسرّعاً من اللازم) / سابق لأوانه, مبتسر (ولد بعد فترة حمل أقل من الوقت الطبيعي)\nمثال: رضيع مبتسر / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "はえ出る": "نَبْتَة",
 "はえ座": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة.",
 "はおう": "مُسْتَبِدّ, جَبَّار",
 "はおうじゅ": "صَبَّار",
 "はおうりゅう": "تيرانوصور, تيرانوصور ريكس (ديناصور لاحم كبير ثنائي الأرجل له أسنان ضخمة ذات حواف مسننة تشبه السكاكين؛ ربما كان قمّاماً (آكل جيف) بدلاً من مفترس نشط؛ من أواخر العصر الطباشيري في…)",
 "はおと": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / بارع, جهبذ (شخص يتمتع بمهارة مذهلة في أي مجال)",
 "はおる": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "はか": "بلوغ (وقت الحياة الذي تصبح فيه الغدد الجنسية وظيفية) / اِفْتَضَّ, تَصَرُّف / نَعْنَاع, نعناع / قَبْر, ضَرِيح (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: زار توم قبر ماري. / تَقَدُّم / اِخْتِرَاق (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "はかあな": "قَبْر, ضَرِيح (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: زار توم قبر ماري.",
 "はかい": "تَدْمِير, هَدْم / حَادِث إِصْطِدَام / اِنْهِيَار, اِنْهِيَار نِظَام (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل) / تَحَطَّمَ\nمثال: يوشك الجسر على الانهيار.",
 "はかいかつどう": "تخريب, تقويض (فعل التقويض؛ مثل الإطاحة بحكومة شرعية أو تدميرها)",
 "はかいこうさく": "أَعْمَال تَخْرِيبِيَّة, تَخْرِيب (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما أشبه)\nمثال: أنا في رحلة أعمال.",
 "はかいし": "شاهد القبر (حجر يستخدم لتحديد مكان القبر)",
 "はかいしゃ": "مُدَمِّر",
 "はかいそちめいれい": "إرداء بالرصاص (القتل بإطلاق النار على شخص بدم بارد)",
 "はかいてき": "مدمر, هدام (يسبب دماراً أو ضرراً كبيراً)\nمثال: سياسة هدامة للاقتصاد",
 "はかいぶんし": "تَخْرِيبِيّ, مُتَمَرِّد (مُعَارِض لِسُلْطَة مَدَنِيَّة أَوْ حُكُومَة) / ثوري (مؤيد راديكالي للثورة السياسية أو الاجتماعية)",
 "はかがいく": "يقرب",
 "はかがゆく": "يقرب",
 "はかが行く": "يقرب",
 "はかき": "بُلُوغ",
 "はかく": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ / شَاذّ, غَيْر مُنْتَظِم",
 "はかしょ": "مَقْبَرَة, مَقْبُرَة",
 "はかじるし": "شاهد القبر (حجر يستخدم لتحديد مكان القبر)",
 "はかす": "لوحة تذكارية نحاسية, لوحة معدنية (نصب تذكاري مصنوع من النحاس الأصفر) / لويحة ((علم الأمراض) رقعة غير طبيعية صغيرة على أو داخل الجسم)",
 "はかせごう": "درجة الدكتوراه, دكتوراه (واحدة من أعلى الدرجات الأكاديمية التي تمنحها الجامعة)",
 "はかせろんぶん": "أطروحة الدكتوراه (بحث رسمي طويل يكتبه المرشح لدرجة الدكتوراه في الجامعة)",
 "はかち": "جبانة, مدفن (قطعة أرض تستخدم للدفن)",
 "はかどころ": "مَقْبَرَة, مَقْبُرَة",
 "はかどる": "يقرب",
 "はかない": "خَاطِف, عَابِر (يَدوم لِفَتْرَة قَصيرَة جِدًّا) / فَارِغ / فَرَغَ",
 "はかなくなる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "はかば": "مَقْبَرَة, مَقْبُرَة",
 "はかばかしい": "سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي.",
 "はかびょう": "فصام غير منتظم, فصام مراهقة (شكل من أشكال الفصام يتميز بتفكك شديد للشخصية، بما في ذلك الكلام المضطرب والتصرفات الطفولية والسلوك الغريب؛ وعادة ما يتضح خلال فترة البلوغ؛ وهو الفئة…)",
 "はかほり": "حفار القبور (شخص يكسب عيشه من حفر القبور)",
 "はかま": "فستان سهرة قصير, فستان كوكتيل (فستان مناسب للمناسبات الرسمية) / جراب, غمد (غطاء واقٍ (لسكين أو سيف)) / غِلاف, غِمْد (هيكل مغلف أو غطاء يحيط بعضو أو جزء حيواني أو نباتي) / وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "はかまじ": "تَنُّورَة, جُوب",
 "はからい": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "はからう": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / نَصَحَ (نصحه: أَرْشَدَه وأَشَارَ عليه) / اِسْتَشَارَ\nمثال: نصح مناد بباية.",
 "はからずも": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة",
 "はかり": "مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / قياس (فعل أو عملية تعيين أرقام للظواهر وفقًا لقاعدة)\nمثال: تمت القياسات بعناية",
 "はかりごと": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "はかりしる": "فَرَضِيَّة, اِفْتِرَاض (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة) / تَخْمِين\nمثال: الحقائق تؤكد هذه الفرضية.",
 "はかりしれない": "غَيْرُ قَابِلٍ لِلسَّبْر (يستحيل فهمه واستيعابه بالكامل) / سَحِيق, لَا قَرَار لَهُ (يُشْبِهُ الهَاوِيَةَ فِي عُمْقِهِ؛ عَمِيقٌ جِدًّا لَا يُمْكِنُ قِيَاسُهُ) / عميق جداً, لا يسبر غوره (عن العمق؛ غير قادر على أن يسبر أو يقاس)",
 "はかりめ": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "はかり知る": "فَرَضِيَّة, اِفْتِرَاض (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة) / تَخْمِين\nمثال: الحقائق تؤكد هذه الفرضية.",
 "はかり知れない": "غَيْرُ قَابِلٍ لِلسَّبْر (يستحيل فهمه واستيعابه بالكامل) / سَحِيق, لَا قَرَار لَهُ (يُشْبِهُ الهَاوِيَةَ فِي عُمْقِهِ؛ عَمِيقٌ جِدًّا لَا يُمْكِنُ قِيَاسُهُ) / عميق جداً, لا يسبر غوره (عن العمق؛ غير قادر على أن يسبر أو يقاس)",
 "はかる": "نَاقَشَ, بَحَثَ / قِيَاس / فَاصِلَة / إِجْرَاء / قَاسَ (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / فَرَضِيَّة, اِفْتِرَاض (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة) / تَخْمِين\nمثال: الحقائق تؤكد هذه الفرضية. / خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه. / حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ / بَحَثَ, طَلَبَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث. / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "はがい": "أجنحة (وسيلة للطيران أو الصعود (مجازياً)) / أجنحة (أجنحة طيور منمقة يرتديها الطيارون المؤهلون أو أفراد طاقم الطائرة كشارة)\nمثال: الضرورة تعطي أجنحة للإلهام",
 "はがいじめ": "نيلسون كامل (مسكة مصارعة يضع فيها الحامل كلا ذراعيه تحت ذراعي الخصم ويضغط على الرقبة)",
 "はがき": "كَرْت بَرِيدِيّ / مذكرة, مذكرة داخلية (اقتراح أو تذكير مكتوب)",
 "はがため": "عضاضة, لهاية (أداة تستخدم ليمصها الرضيع أو يعض عليها لتهدئته) / أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "はがね": "فُولَاذ / سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة) / سَيَّافٌ\nمثال: القلم أقوى من السيف.",
 "はがねいろ": "أزرق فولاذي (لون أزرق رمادي)",
 "はがま": "عَرِيض الحَافَّة ((عن القبّعات) ذو حافّة عريضة)",
 "はがみ": "صرير الأسنان",
 "はがゆい": "ضجر, عجول (قلق أو سريع الغضب تحت التأخير أو المعارضة)\nمثال: نافذ الصبر مع الطلاب الأبطاء",
 "はがれ": "تَقْشِير",
 "はき": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة. / مَطْمَح / تَدْمِير, هَدْم / إلغاء, فسخ (فعل النسخ؛ إلغاء رسمي أو قانوني) / إبطال, فسخ ((في القانون) إنهاء رسمي (لعلاقة أو إجراء قضائي ونحوه)) / إبطال, إلغاء (حالة كونه ملغى أو مبطلاً) / انقلاب في الموقف, تحول تام (تغيير كبير في الموقف أو المبدأ أو وجهة النظر) / ارتداد, عكس (تغيير من حالة إلى الحالة المعاكسة) / عكس, قلب (فعل عكس الترتيب أو المكان) / ارتداد, انعكاس (التحول في الاتجاه المعاكس)\nمثال: تحول تام في السياسة الخارجية",
 "はきかえる": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "はきかける": "سَفُّود, سِيخ / بَصَقَ, بَزَقَ (بَصَقَ من باب نَصَرَ؛ لفظ مَا فِي فَمه) / بُزَاق",
 "はきぐすり": "دواء مقيئ, مقيئ (دواء يحفز الغثيان والقيء)",
 "はきぐち": "تنفيس, مخرج (نشاط يحرر أو يعبر عن الطاقة الإبداعية أو العاطفة) / مخرج, منفذ (فتحة تسمح بالهروب أو الخروج) / متجر, محل تجاري (مكان عمل لبيع البضائع بالتجزئة) / مأخذ كهربائي, مِقبس جداري (مقبس يوفر مكاناً في نظام الأسلاك يمكن منه أخذ التيار لتشغيل الأجهزة الكهربائية)\nمثال: لم يكن لديها مخرج آخر لمشاعرها",
 "はきけ": "غَثْيَان (جاشت النفس واضطربت واستعدت للقَيء؛ الاِشْمِئْزَاز والقَرَف)\nمثال: كنت أشعر بالغثيان.",
 "はきげ": "غَثْيَان (جاشت النفس واضطربت واستعدت للقَيء؛ الاِشْمِئْزَاز والقَرَف)\nمثال: كنت أشعر بالغثيان.",
 "はきすてる": "قَذَفَ نَفْسَهُ (بمعنى رَمَى؛ قذَف بالحقّ: أمر به وأبانه)",
 "はきだす": "تَقَيَّأَ, قَاءَ / تَقَيُّؤ / زَفَرَ (زفَر الشَّخصُ : أخرج نفَسه من رئتيه بعد مدِّه إيّاه؛ أظهر تعبيرًا عن الحزن أو الألم من خلال تنهد أو صوت عميق) / أَنْفَقَ, صَرَفَ / قَضَى / مُخرَج / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة.",
 "はきだめ": "كومة خردة, كومة قمامة (تراكم للنفايات والمواد المهملة)",
 "はきちがえる": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "はきつわり": "غَثَيَان الحَمْل (جاشت النفس واضطربت واستعدت للقَيء؛ الاِشْمِئْزَاز والقَرَف)\nمثال: كنت أشعر بالغثيان.",
 "はきづわり": "غَثَيَان الحَمْل (جاشت النفس واضطربت واستعدت للقَيء؛ الاِشْمِئْزَاز والقَرَف)\nمثال: كنت أشعر بالغثيان.",
 "はきはき": "بخفَة",
 "はきふるし": "بَالٍ",
 "はきもどし": "استفراغ, تقيؤ (الفعل الانعكاسي لقذف محتويات المعدة عبر الفم) / اجترار, ترديد (الاستدعاء بعد الحفظ عن ظهر قلب) / ارتجاع, قلس (تدفق عكسي للدم من خلال صمام قلب معيب)\nمثال: اشتكى من أن المدرسة كانت مجرد حفظ وترديد",
 "はきもどす": "تَقَيَّأَ, قَاءَ / تَقَيُّؤ",
 "はきもの": "حِذَاء, مَشَّايَة (بمعنى الإزاء والجوار؛ النَعْل)\nمثال: أردت حذاء أحمر.",
 "はきゃく": "هَدْم (الثوبُ ٱلْخَلَقُ المُرَقَّعُ؛ الكِساءُ الذي ضُوعِفت رِقَاعُهُ)\nمثال: توم يرسم خطة لهدم المنزل.",
 "はきゅう": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "はきょう": "طَلَاق, تَطْلِيق / طَلَّقَ (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ) / أَطْلَقَ\nمثال: طلق زيري زوجته.",
 "はきょく": "كَارِثَة, فَاجِعَة / نَكْبَة, فَاجِعَة / اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "はき口": "تنفيس, مخرج (نشاط يحرر أو يعبر عن الطاقة الإبداعية أو العاطفة) / مخرج, منفذ (فتحة تسمح بالهروب أو الخروج) / متجر, محل تجاري (مكان عمل لبيع البضائع بالتجزئة) / مأخذ كهربائي, مِقبس جداري (مقبس يوفر مكاناً في نظام الأسلاك يمكن منه أخذ التيار لتشغيل الأجهزة الكهربائية)\nمثال: لم يكن لديها مخرج آخر لمشاعرها",
 "はき違える": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "はぎ": "برسيم الشجيرة, ليسبيديزا (نباتات شجيرية أو عشبية تستخدم على نطاق واسع للعلف وتحسين التربة وخاصة التبن في جنوب الولايات المتحدة) / أحمر داكن (لون أحمر يعكس القليل من الضوء) / قَصَبَة / شِين",
 "はぎごと": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "はぎしり": "صرير الأسنان",
 "はぎぞく": "برسيم الشجيرة, ليسبيديزا (نباتات شجيرية أو عشبية تستخدم على نطاق واسع للعلف وتحسين التربة وخاصة التبن في جنوب الولايات المتحدة)",
 "はぎめ": "دَرْز (درز:درزا تمكن من درز الدُّنْيَا؛ دَرِزَ الرجلُ، كفَرِح، وَكَذَلِكَ ذَرِزَ، بالدّالِ والذّالِ، إِذا تمَكَّن مِنْهَا أَي من نَعيمِها)",
 "はぎょう": "هَيْمَنَة, سَيْطَرَة",
 "はぎれ": "أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء)",
 "はぎれいい": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ)",
 "はぎれがいい": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ)",
 "はぎれがよい": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ)",
 "はぎれがわるい": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "はぎれのいい": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ)",
 "はぎれのよい": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ)",
 "はぎれのわるい": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "はぎれよい": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ)",
 "はく": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة. / عَدَّ / كُونْت / الْبَرَازِيل / مِٱئَة, مِئَة / دكتوراه (دكتوراه تعتمد عادةً على 3 سنوات على الأقل من الدراسات العليا وأطروحة؛ وهي أعلى درجة تمنح في الدراسات العليا) / مَعْرِض / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / أَفِكْس / إِقَامَة / فَشَّلَ, أحبط (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل)\nمثال: فشل ياني مجددا. / سُمْعَة / كَرَامَة (الكرامة هي حق الفرد في أن يكون له قيمة وأن يُحترم لذاته، وأن يُعامل بطريقة أخلاقية) / اِعْتِبَار (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به)\nمثال: لا يعرض أي إنسان للتعذيب ولا للعقوبات أو المعاملات القاسية أو الوحشية أو الحاطة بالكرامة. / رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة. / نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته. / حَرِير, إبْرِيسِم / تَقَيَّأَ, قَاءَ / تَقَيُّؤ / نَفَثَ, أَصْدَرَ / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / اِعْتَرَفَ, أَقَرَّ / أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض. / بوري مخطط (أهم أنواع البوري التجارية في شرق الولايات المتحدة) / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / بِلْجِيكَا / تلطيخ, رسم رديء (لوحة غير متقنة) / بقعة, تلطخ (عيب ناتج عن الأوساخ) / طيانة, ملاط طيني (مادة تستخدم لطلاء الجدران بالطين)\nمثال: كانت هناك لطخة على خده",
 "はくあ": "طَبْشُورَة",
 "はくあい": "مُنَظَّمَة خَيْرِيَّة / صَدَقَة / إِحْسَان",
 "はくあいか": "سَخِيّ ((سَخِيَ) سَخاً: كَانَ جوادًا كَرِيمًا؛ (سَخِيَت) نَفسه عَن الشَّيْء: تركته)\nمثال: هو سخي بأمواله.",
 "はくあいしゅぎしゃ": "سَخِيّ ((سَخِيَ) سَخاً: كَانَ جوادًا كَرِيمًا؛ (سَخِيَت) نَفسه عَن الشَّيْء: تركته)\nمثال: هو سخي بأمواله.",
 "はくあかん": "الْبَيْت الْأَبْيَض / بَيْت أَبْيَض (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "はくあしつ": "ملاط, ملاط الأسنان (مادة عظمية متخصصة تغطي جذر السن) / طَبَاشِيرِيّ اللَّوْن (بلون الطباشير الأبيض) / جيري, طباشيري (مكون من أو يحتوي على أو يشبه كربونات الكالسيوم أو الكالسيت أو الطباشير)",
 "はくいのてんし": "مُمَرِّض / مُمَرِّضَة / ممرض / أَرْضَعَ ((أَرْضَعَت) الْأُم: كَانَ لَهَا ولد تُرْضِعه؛ (أَرْضَعَت) الْولد: جعلته يرضع فَهِيَ مرضع ومرضعة (ج) مراضع) / مَرَّضَ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "はくう": "ديمة, زخات مطر (فترة قصيرة من الهطول)\nمثال: توقفت المباراة بسبب زخة مطر قصيرة",
 "はくうんせき": "دولوميت (معدن فاتح اللون يتكون من كربونات الكالسيوم والمغنيسيوم؛ مصدر للمغنيسيوم؛ يستخدم كخزف وكسماد) / دولوميت (نوع من الصخور الرسوبية يشبه الرخام أو الحجر الجيري ولكنه غني بكربونات المغنيسيوم)",
 "はくうんも": "مُوسْكُوفِيّ",
 "はくえ": "شخص عادي, علماني (شخص ليس رجل دين وليس متخصصاً مهنياً)",
 "はくえんこう": "خام الرصاص الأبيض, سيروسيت (معدن يتكون من كربونات الرصاص وهو مصدر مهم للرصاص)",
 "はくか": "مَادَّة تَبْيِيض (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / بَيَّضَ (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: لا أحب مادة العلوم. / برص, مهق (غياب خلقي للتصبغ في العينين والجلد والشعر)",
 "はくかげんしょう": "برص, مهق (غياب خلقي للتصبغ في العينين والجلد والشعر)",
 "はくかこたい": "أَمْهَق",
 "はくが": "تبحر, سعة اطلاع (معرفة علمية عميقة)",
 "はくがい": "اِضْطِهَاد",
 "はくがいしゃ": "مضطهد, معذب (شخص يقوم بتعذيب الآخرين أو التنكيل بهم)",
 "はくがく": "تبحر, سعة اطلاع (معرفة علمية عميقة)",
 "はくがくしゃ": "وَاسِع الاطلاع (واسِع: (اسم)؛ واسع: (اسم))\nمثال: أرض الله واسعة.",
 "はくがん": "إوز الثلج (الإوز الأزرق في الطور اللوني الأبيض)",
 "はくぎ": "لعبة حظ, لعبة قمار (لعبة تنطوي على المقامرة)",
 "はくぎょくろうちゅうのひととなる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "はくぎん": "فِضَّة (فِي : فِلِزّ أَبْيَض قَابِلٌ لِلسَّحب والطَّرْق والصَّقْل، من أكثر المواد توصيلاً للحَرَارَة والكَهْرَبَاء…) / فِضِّيّ, لُجَيْن\nمثال: يقدر القبايل الفضة أكثر من الذهب. / ثَلْج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / تلج / ثلج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / أَثْلَجَ (أثلج يومُنا: دخل في الثلج؛ أثلجت الأرض: أصابها الثلج)\nمثال: سامي يحب الثلج.",
 "はくげきほう": "مِلَاط / مِهْرَاس, هَاوُن / هَاوُن, مِدْفَعُ الهَاوُن / هَاوُن",
 "はくげんがく": "لِسَانِيَّات, عِلْم اللُّغَة",
 "はくこく": "الْبَرَازِيل / كونتِيّة / مُحَافَظَة, مُقَاطَعَة (تقسيم إداري في أرض دولة؛ المؤنث من \"مُحَافَظ\")\nمثال: نشأت ليلى في بلدة محافظة.",
 "はくさ": "أَثِيرِيّ, شَفَّاف (يَتَّسِمُ بِخِفَّةٍ وَرِقَّةٍ غَيْرِ مَعْهُودَة) / رَقِيقٌ كَالغَزْل, شَفَّاف (بَالِغُ الرِّقَّةِ بِحَيْثُ يَنْفُذُ مِنْهُ الضَّوْء) / خيط العنكبوت, نسيج العنكبوت (خيوط من شبكة نسجها عنكبوت) / جوسامر, قماش شفاف (قماش شاش ذو نسيج ناعم للغاية)",
 "はくさい": "ملفوف صيني (رأس ممدود من سيقان مقرمشة تشبه الكرفس وأوراق خضراء فاتحة) / كرنب صيني, ملفوف صيني (نبات ذو رأس ممدود من أوراق عريضة معنقة تشبه الكرفس؛ يستخدم كخضروات في شرق آسيا) / استيراد (النشاط التجاري لشراء وجلب البضائع من دولة أجنبية) / استيراد, واردات (سلع (بضائع أو خدمات) يتم شراؤها من دولة أجنبية)",
 "はくし": "كتاب أبيض, ورقة بيضاء (تقرير حكومي؛ يغلف عادة بغلاف أبيض) / بداية جديدة, صفحة بيضاء (فرصة للبدء من جديد دون أحكام مسبقة) / خَرْبَشَ / دكتوراه (دكتوراه تعتمد عادةً على 3 سنوات على الأقل من الدراسات العليا وأطروحة؛ وهي أعلى درجة تمنح في الدراسات العليا)",
 "はくしいにん": "تَفْوِيض مُطْلَق, ضَوْء أَخْضَر",
 "はくしいにんじょう": "تَفْوِيض مُطْلَق, ضَوْء أَخْضَر",
 "はくしかくめい": "كتاب أبيض, ورقة بيضاء (تقرير حكومي؛ يغلف عادة بغلاف أبيض)",
 "はくしき": "تبحر, سعة اطلاع (معرفة علمية عميقة) / مُطَّلِع, وَاسِعُ الثَّقَافَة (على درجة عالية من التعليم؛ ذو معلومات أو فهم واسع) / شرطي, متعلم (تم تثبيته عن طريق الاشتراط أو التعلم) / مُتَبَحِّر, وَاسِعُ الاِطِّلَاع (ذو معرفة عميقة وواسعة أو يُظهرها)\nمثال: استجابة شرطية",
 "はくしけんきゅういん": "باحث ما بعد الدكتوراه (باحث يشارك في دراسة أكاديمية تتجاوز مستوى درجة الدكتوراه) / منحة ما بعد الدكتوراه (منحة تمول دراسة أو بحث ما بعد الدكتوراه)",
 "はくしごう": "درجة الدكتوراه, دكتوراه (واحدة من أعلى الدرجات الأكاديمية التي تمنحها الجامعة)",
 "はくしじょうたい": "صَفْحَة بَيْضَاء",
 "はくしつ": "مادة بيضاء (نسيج عصبي أبيض للجهاز العصبي المركزي يتكون من عصبونات وأغمادها المايلينية)",
 "はくしゃ": "مِهْمَاز / تَسَارُع (عَجَلَة، تزايُد السرعة بالنسبة إلى الزمن في جسم من الأَجسام المتحرِّكة؛ إِسْرَاعٍ وَتَسَابُقٍ فِي الجَرْيِ)\nمثال: تسارع السائق بسيارته.",
 "はくしゃがかかる": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "はくしゃく": "عَدَّ / كُونْت",
 "はくしゃくふじん": "كونتيسة (المكافئ الأنثوي للكونت أو الإيرل)",
 "はくしゃをかける": "مِهْمَاز",
 "はくしゅ": "تَصْفِيق",
 "はくしゅう": "خَرِيف, خريف (فصل من فصول السَّنَة الأربعة، بعد الصَّيْف وقبل الشِّتَاء؛ سَنَة)\nمثال: نحن في الخريف الآن.",
 "はくしゅかっさい": "تَصْفِيق",
 "はくしゅく": "أَخ / شَقِيق (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب) / إخوات / أخ / أخو\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "はくしゅつ": "إخراج, طرد (فعل الطرد أو القذف أو الإخراج) / إخراج, إقصاء (فعل إجبار شخص أو شيء على الخروج)\nمثال: طرد مثيري الشغب من قبل الشرطة",
 "はくしゅをおくる": "صَفَّقَ",
 "はくしょ": "كتاب أبيض, ورقة بيضاء (تقرير حكومي؛ يغلف عادة بغلاف أبيض)",
 "はくしょく": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض.",
 "はくしょくざつおん": "ضوضاء بيضاء (ضوضاء ناتجة عن محفز يحتوي على جميع ترددات الاهتزاز المسموعة)\nمثال: الضوضاء البيضاء عامل حجب جيد",
 "はくしょくじんしゅ": "العرق الأبيض, قوقازيون (عرق ذو بشرة فاتحة)",
 "はくしょくわいせい": "قَزْم أَبْيَض",
 "はくしょん": "أَتْشُو",
 "はくしろんぶん": "أطروحة الدكتوراه (بحث رسمي طويل يكتبه المرشح لدرجة الدكتوراه في الجامعة)",
 "はくしん": "واقعي (مدرك أو يعبر عن إدراك للأشياء كما هي حقاً) / طَبِيعِيّ, وَاقِعِيّ (يمثل الواقع كما هو؛ ليس تجريدياً أو مثالياً) / واقعي (مكون من أو متعلق بالمذهب الفلسفي للواقعية)\nمثال: وصف واقعي",
 "はくじつのもとにさらす": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "はくじつむ": "حُلْم يَقَظَة (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "はくじゃく": "رقة, وهن (جودة الافتقار للشدة أو الجوهر) / ضعف, عجز (حالة الضعف في الصحة أو الجسم (خاصة بسبب الشيخوخة))\nمثال: رقة صوت حادة ولكنها عذبة",
 "はくじょう": "إِقْرَار, اِعْتِرَاف / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه) / عَدِيم الإِحْسَاس, فَاقِد الشُّعُور (خالٍ من الشعور أو الإحساس الجسديّ) / عَدِيمُ الإِحْسَاس, قَاسِي القَلْب (خالٍ من الشعور بالآخرين والتعاطف معهم)",
 "はくじら": "حوت مسنن (أي من عدة حيتان لها أسنان مخروطية بسيطة وتتغذى على الأسماك وما إلى ذلك)",
 "はくじん": "أبيض, قوقازي (شخص من أصل أوروبي ذو بشرة فاتحة أو شاحبة) / مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ. / بَرَازِيلِيّ",
 "はくじんしじょうしゅぎ": "تفوق العرق الأبيض (التحيز القائل بأن أفراد العرق الأبيض متفوقون على أفراد الأعراق الأخرى)",
 "はくじんしじょうしゅぎしゃ": "مؤمن بتفوق البيض (شخص يعتقد أن العرق الأبيض هو الأسمى أو يجب أن يكون كذلك)",
 "はくじんしゅ": "العرق الأبيض, قوقازيون (عرق ذو بشرة فاتحة)",
 "はくじんコンプレックス": "أبيض, قوقازي (شخص من أصل أوروبي ذو بشرة فاتحة أو شاحبة)",
 "はくす": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال. / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "はくすいろう": "صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "はくする": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال. / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "はくせい": "حشو (حشوة توضع في المراتب والوسائد والأثاث المنجد) / تتبيلة الحشو, حشوة (خليط من المكونات المتبلة يستخدم لحشو اللحوم والخضروات)",
 "はくせいじゅつ": "تحنيط (فن تركيب جلود الحيوانات بحيث يكون لها مظهر نابض بالحياة)",
 "はくせき": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض.",
 "はくせつ": "نَبْض, نَبْضَة",
 "はくせん": "خط أبيض (شريط أبيض في منتصف الطريق لتحديد مسارات المرور) / سَعْفَة, قَرَع",
 "はくそ": "لوحة تذكارية نحاسية, لوحة معدنية (نصب تذكاري مصنوع من النحاس الأصفر) / لويحة ((علم الأمراض) رقعة غير طبيعية صغيرة على أو داخل الجسم)",
 "はくそう": "صفيحة رقيقة (لوحة رقيقة) / صفيحة (غشاء رقيق هو إحدى الطبقات المتكلسة التي تشكل العظام) / خيشوم, صفيحة (أي من الهياكل المشعة الشبيهة بالأوراق المنتجة للأبواغ على الجانب السفلي من غطاء الفطر أو فطريات مماثلة)",
 "はくぞう": "فيل أبيض (فيل هندي أمهق؛ نادر ومقدس أحياناً في شرق آسيا) / الفيل الأبيض (ممتلكات قيمة تكون تكاليف صيانتها باهظة للغاية)",
 "はくたい": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "はくたいげ": "ثر أبيض, سيلان مهبلي أبيض (إفرازات مخاطية بيضاء من المهبل؛ غالباً ما تكون مؤشراً على وجود عدوى)",
 "はくだく": "تَغَيُّم, كُدْرَة (صفة كون الشيء غائماً) / تلبد الغيوم, غائم (شبه ظلام كئيب ناتج عن غطاء سحابي) / تغيم, غطاء سحابي (حالة السماء عندما تكون مغطاة بالسحب) / مَنِيّ",
 "はくだくえき": "مَنِيّ",
 "はくだつ": "تعرية, كشف (إزالة الغطاء)",
 "はくだつせいひふえん": "احمرار الجلد (أي اضطراب جلدي ينطوي على احمرار غير طبيعي)",
 "はくち": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق. / أَنْكُورِيج",
 "はくちび": "حمقاء جميلة (شابة مدللة من قبل رجال أكبر سناً وأثرياء وأقوياء)",
 "はくちゅう": "نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر إلى غروب الشَمْس. ضد اللَيْل)\nمثال: نهار اليوم ممل!",
 "はくちゅうむ": "حُلْم يَقَظَة (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "はくちょう": "تَمّ, قُقْنُس\nمثال: 白鳥は当地からフロリダに移動する。 — يهاجر البجع من هنا إلى فلوريدا. / شاب (مراهق أو شاب بالغ ذكر) / شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "はくちょうざ": "الدَّجَاجَة",
 "はくちょうのうた": "أغنية البجعة, العمل الأخير (أداء أو جهد أخير (خاصة قبل التقاعد))",
 "はくちょう座": "الدَّجَاجَة",
 "はくてい": "شاب (مراهق أو شاب بالغ ذكر) / شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "はくてっこう": "مَرْقَشِيتَا",
 "はくでん": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "はくとう": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "はくとうおう": "زهرة الرياح, شقائق النعمان / أَشْيَب",
 "はくとうゆ": "كِيرُوسِين",
 "はくとうわし": "عقاب رخماء (عقاب كبيرة من أمريكا الشمالية لها رأس أبيض وأجنحة وجسم داكن)",
 "はくとうワシ": "عقاب رخماء (عقاب كبيرة من أمريكا الشمالية لها رأس أبيض وأجنحة وجسم داكن)",
 "はくど": "طين صيني, كاولين (طين ناعم عادة ما يكون أبيض ناتج عن تجوية المعادن الألومينية (مثل الفلسبار)؛ يستخدم في السيراميك وكمادة ماصة وكمادة مالئة (على سبيل المثال، في الورق)) / بَيَاض",
 "はくどう": "نَبْض, نَبْضُ القَلْب",
 "はくないしょう": "شلالات قوية, مسقط مائي ضخم (شلال كبير؛ تدفق عنيف للمياه فوق جرف) / إعتام عدسة العين, الماء الأبيض (مرض عيني ينطوي على تغيم أو عتامة في العدسة الطبيعية للعين)",
 "はくにく": "كرشة",
 "はくねつ": "احتدام, توهج أبيض (سخونة شيء يتم تسخينه حتى يتحول إلى اللون الأبيض)",
 "はくねつてき": "مُسَخَّن (جُعِل دافئاً أو ساخناً) / حَامٍ, مُحْتَدِم (يتّسم بالحدّة العاطفيّة؛ عنيف)",
 "はくねつでんきゅう": "لَمْبَة, مِصْبَاح",
 "はくねつとう": "لمبة, مصباح كهربائي (مصباح كهربائي يتكون من غلاف زجاجي شفاف أو نصف شفاف يحتوي على فتيل سلكي (عادة من التنجستن) يبعث الضوء عند تسخينه بالكهرباء)",
 "はくねんど": "طين صيني, كاولين (طين ناعم عادة ما يكون أبيض ناتج عن تجوية المعادن الألومينية (مثل الفلسبار)؛ يستخدم في السيراميك وكمادة ماصة وكمادة مالئة (على سبيل المثال، في الورق))",
 "はくはく": "شَفَّاف / وَاضِح / أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض.",
 "はくはん": "صَيْخَد / بُهَاق",
 "はくば": "رغوة الموج, زبد الموج (موجة تهب عليها الرياح فينكسر عرفها ويظهر أبيض اللون)",
 "はくばのおうじ": "فتى الأحلام, فارس الأحلام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم)\nمثال: ترى الفتاة الفتى.",
 "はくばのきし": "الفارس الأبيض (شركة تكون مستحوذاً ودوداً في عملية استحواذ)",
 "はくばひば": "سفسطة (حجة غير صحيحة عمدًا تظهر البراعة في التفكير على أمل خداع شخص ما)",
 "はくばん": "سَبُورَة بَيْضَاء",
 "はくひ": "تقشير (إزالة الغطاء الخارجي لعضو أو جزء)",
 "はくひしょう": "برص, مهق (غياب خلقي للتصبغ في العينين والجلد والشعر)",
 "はくひょうをふむおもい": "توجس, نذير شؤم (فأل غير مواتٍ) / بشيرة سوء, نذير شؤم (شعور بقدوم شر)\nمثال: شعور متزايد بنذير شؤم",
 "はくび": "أَفْضَل",
 "はくふ": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير عن الحاضر المستمر)\nمثال: أنا وهو أولاد عم.",
 "はくふじん": "كونتيسة (المكافئ الأنثوي للكونت أو الإيرل)",
 "はくぶつ": "تاريخ طبيعي (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "はくぶつかん": "مَتْحَف (مكان تُجمع وتُعْرَض فيه الآثار التاريخيَّة أو الفنيَّة أو العِلْميَّة وغيرها)\nمثال: عاد إلى المتحف.",
 "はくぶつがく": "تاريخ طبيعي (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "はくぶつがくしゃ": "عالم تاريخ طبيعي, عالم طبيعة (عالم أحياء مطلع على التاريخ الطبيعي (خاصة علم النبات وعلم الحيوان)) / طبيعاني, فيلسوف الطبيعة (مدافع عن العقيدة القائلة بأن العالم يمكن فهمه بالمصطلحات العلمية)",
 "はくぶつし": "تاريخ طبيعي (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "はくぶつひょうほん": "تاريخ طبيعي (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "はくぶん": "مُطَّلِع",
 "はくへいせん": "مُلْتَحِم, وَجْهاً لِوَجْه (على مسافة قريبة جداً؛ في قتال مباشر)",
 "はくへん": "رُقَاقة, شَظِيَّة صغيرة (شظية صغيرة من شيء انفصلت عن الكل) / غَرِيب الْأَطْوَار (شخص ذو شخصية غير عادية أو غريبة) / ندفة الثلج (بلورة من الثلج)\nمثال: أصابت عينه شظية صخرية صغيرة",
 "はくぼ": "عَمَّة, خَالَة (هي أُخْت الأَبّ)\nمثال: سامي و ليلى أبناء عمة. / عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / يَغْسِق, يَعْتِم\nمثال: هل العشاء جاهز؟",
 "はくぼく": "طَبْشُورَة",
 "はくまい": "أرز أبيض (أرز تمت إزالة القشرة أو الطبقات البنية الخارجية منه)",
 "はくめい": "شَفَق ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري. / مُصِيبَة, شَقْوَة",
 "はくめいこうせん": "شعاع الشمس (شعاع من ضوء الشمس)",
 "はくめいはくぼせい": "شَفَقِيّ, غَسَقِيّ (كَالشَّفَق؛ خَافِت الإِضَاءَة)",
 "はくめん": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ / عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "はくよう": "بَحْرِيّ",
 "はくようきゅう": "بُرْج اَلْحَمَل, اَلْحَمَل (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "はくらい": "مُسْتَوْرَد (يُسْتَخْدَمُ خَاصَّةً لِلْبَضَائِعِ المَجْلُوبَةِ مِنْ مَصْدَرٍ أَجْنَبِيٍّ)",
 "はくらく": "تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة)\nمثال: دخل الفريق في حالة ركود",
 "はくらんかい": "مَعْرِض",
 "はくり": "فصل, فك الارتباط (عملية التحرير من مرفق أو اتصال) / انفصال, تفكك (التفرق أو الانقسام) / انسحاب, تجرد (تجنب التورط العاطفي) / مفرزة (وحدة صغيرة من القوات ذات تكوين خاص) / تَفْرِقَة",
 "はくりょく": "إبهار, تأثير قوي (صفة ترك انطباع قوي أو حيوي في الذهن) / عَظَمَة, فَخَامَة (الروعة أو الهيبة في الحجم أو المظهر)\nمثال: عظمة العمارة",
 "はくろう": "بيوتر, سبيكة القصدير والرصاص (أي من سبائك القصدير المختلفة مع كميات صغيرة من معادن أخرى (خاصة الرصاص))",
 "はくロシア": "بِيلَارُوسِيَا, رُوسْيَا الْبَيْضَاء",
 "はくロシアご": "بِيلَارُوسِيّ",
 "はぐ": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر.",
 "はぐき": "لِثَة, لَثَة / صَمْغ / عِلْكَة",
 "はぐきおん": "صامت سني, صامت لثوي (صامت يُنطق بطرف اللسان بالقرب من حافة اللثة)",
 "はぐくむ": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / بِالاِحْتِضَان, بِالكَفَالَة (يَتِمّ رِعايَتُه دونَ أَن يَكونَ ابْنًا بِيُولوجِيًّا)",
 "はぐらかす": "تفادي, مراوغة (حركة مراوغة سريعة) / حيلة, خديعة (مخطط مفصل أو خادع تم تدبيره للخداع أو التهرب) / تملص, مراوغة (بيان يتهرب من السؤال بذكاء أو حيلة)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "はぐる": "قَلَبَ / اُغْرُب عَن وَجْهِي!, إِبْتَعِد عَنِّي! / ضَلَّ الطَّرِيق",
 "はぐるま": "ترس, عجلة مسننة (عجلة مسننة تتعشق مع آلية مسننة أخرى لتغيير سرعة أو اتجاه الحركة المنقولة) / تجهيزات, عُدَّة (معدات تتكون من مواد متنوعة لازمة لعملية معينة أو رياضة وما إلى ذلك) / آلية تروس, ترس (آلية لنقل الحركة لغرض محدد (مثل ترس التوجيه في السيارة)) / مجموعة تروس, نظام نقل الحركة (آلية عجلات تتكون من مجموعة متصلة من التروس الدوارة التي يتم من خلالها نقل القوة أو تغيير الحركة أو عزم الدوران)\nمثال: علق ربطة عنق الأحمق في مجموعة التروس / سن الترس (سن على حافة عجلة مسننة) / ترس في آلة (مرؤوس يؤدي وظيفة مهمة ولكنها روتينية)\nمثال: كان ترساً صغيراً في آلة كبيرة",
 "はぐるまがかみあう": "شَبَكَة",
 "はぐれもの": "ضَلَّ / مَنْبُوذ, مَنْبُوذَة",
 "はぐれる": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "はぐれ者": "ضَلَّ / مَنْبُوذ, مَنْبُوذَة",
 "はけ": "فُرْشَاة / فَرَشَ / مَشَّطَ (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج. / تَصْرِيف / إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة)",
 "はけい": "شَكْل مَوْجِيّ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "はけいこうばん": "حديد مموج, صاج معرج (عادة ما يكون صفائح حديد أو صلب مجلفنة مشكلة في تلال وتجاويف متوازية مستقيمة)",
 "はけくち": "تنفيس, مخرج (نشاط يحرر أو يعبر عن الطاقة الإبداعية أو العاطفة) / مخرج, منفذ (فتحة تسمح بالهروب أو الخروج) / متجر, محل تجاري (مكان عمل لبيع البضائع بالتجزئة) / مأخذ كهربائي, مِقبس جداري (مقبس يوفر مكاناً في نظام الأسلاك يمكن منه أخذ التيار لتشغيل الأجهزة الكهربائية)\nمثال: لم يكن لديها مخرج آخر لمشاعرها / سُوق (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "はけぐち": "تنفيس, مخرج (نشاط يحرر أو يعبر عن الطاقة الإبداعية أو العاطفة) / مخرج, منفذ (فتحة تسمح بالهروب أو الخروج) / متجر, محل تجاري (مكان عمل لبيع البضائع بالتجزئة) / مأخذ كهربائي, مِقبس جداري (مقبس يوفر مكاناً في نظام الأسلاك يمكن منه أخذ التيار لتشغيل الأجهزة الكهربائية)\nمثال: لم يكن لديها مخرج آخر لمشاعرها / سُوق (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "はけば": "تنفيس, مخرج (نشاط يحرر أو يعبر عن الطاقة الإبداعية أو العاطفة) / مخرج, منفذ (فتحة تسمح بالهروب أو الخروج) / متجر, محل تجاري (مكان عمل لبيع البضائع بالتجزئة) / مأخذ كهربائي, مِقبس جداري (مقبس يوفر مكاناً في نظام الأسلاك يمكن منه أخذ التيار لتشغيل الأجهزة الكهربائية)\nمثال: لم يكن لديها مخرج آخر لمشاعرها",
 "はけほうき": "مِكْنَسَة صغيرة, مِكْنَسَة يدوية (مكنسة صغيرة ذات مقبض قصير تستخدم لتنظيف الملابس)",
 "はけぼうき": "مِكْنَسَة صغيرة, مِكْنَسَة يدوية (مكنسة صغيرة ذات مقبض قصير تستخدم لتنظيف الملابس)",
 "はける": "بَالُوعَة",
 "はけん": "هَيْمَنَة, سَيْطَرَة / إرسال, إيفاد (فعل إرسال شيء ما) / إجهاز, قتل (قتل شخص أو حيوان (بسرعة)) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً) / برقية, بلاغ (تقرير رسمي (يرسل عادة على عجل))\nمثال: تم إنجازه بسرعة وكفاءة / موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "はけんあらそい": "صِرَاع عَلَى ٱلسُّلْطَة",
 "はけんかいしゃ": "وَكَالَة تَوْظِيف",
 "はけんがいしゃ": "وَكَالَة تَوْظِيف",
 "はけんしゃいん": "موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "はけんじゅうぎょういん": "موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "はけんたい": "مَشْرُوْط",
 "はけんだん": "تَفْوِيض / بِعْثَة, وَفْد",
 "はけんろうどうしゃ": "موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "はけ口": "تنفيس, مخرج (نشاط يحرر أو يعبر عن الطاقة الإبداعية أو العاطفة) / مخرج, منفذ (فتحة تسمح بالهروب أو الخروج) / متجر, محل تجاري (مكان عمل لبيع البضائع بالتجزئة) / مأخذ كهربائي, مِقبس جداري (مقبس يوفر مكاناً في نظام الأسلاك يمكن منه أخذ التيار لتشغيل الأجهزة الكهربائية)\nمثال: لم يكن لديها مخرج آخر لمشاعرها / سُوق (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "はけ場": "تنفيس, مخرج (نشاط يحرر أو يعبر عن الطاقة الإبداعية أو العاطفة) / مخرج, منفذ (فتحة تسمح بالهروب أو الخروج) / متجر, محل تجاري (مكان عمل لبيع البضائع بالتجزئة) / مأخذ كهربائي, مِقبس جداري (مقبس يوفر مكاناً في نظام الأسلاك يمكن منه أخذ التيار لتشغيل الأجهزة الكهربائية)\nمثال: لم يكن لديها مخرج آخر لمشاعرها",
 "はげ": "صَلَع / أَصْلَع حَلِيق / أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "はげあたま": "صَلَع",
 "はげいとう": "سجاد, كوليوس",
 "はげしい": "عَنِيف / الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ. / مُتَّقِد, مُلْتَهِب ((قديم) شديد الحرارة؛ مشتعل أو متوهِّج) / حَمَاسِيّ, مُتَحَمِّس (يَتَّسِمُ بِعَاطِفَةٍ شَدِيدَة) / مُسْتَمِرّ, مُتَوَاصِل",
 "はげたか": "نَسْر (الكشط والجرح والنقب؛ طَيْر من الجَوَارِح أكبرها حجما يقتات الجِيَف وله منقار معقوف)\nمثال: الصغر أسرع من النسر",
 "はげまし": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "はげます": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك. / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "はげみ": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "はげみあい": "مُنَافَسَة, مُبَارَاة / مُنَافَسَة, مُسَابَقَة",
 "はげむ": "كَافَحَ, اِجْتَهَدَ / جَاهَدَ",
 "はげる": "اختفاء, تلاشٍ (التوقف التدريجي عن الظهور) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة",
 "はげわし": "نسر (العالم القديم) (أي من النسور الكبيرة المتعددة في أفريقيا وأوراسيا)",
 "はげ頭": "صَلَع",
 "はこ": "صُنْدُوق, صَنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / شَمْشَاد / شَمْشِير / شَمْشَار / عَثَق / بُقْس / لَكْمَة, بُكس / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة)\nمثال: أين صندوق البريد؟ / سَيَّارَة, عَرَبِيَّة (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة. / شَامِيسِين / بِرَاز, سَلْح",
 "はこいり": "فِي عُلْبَة, مُغَلَّف (محاط بغلاف أو علبة) / مُحَاط بِغِلَاف, مُغَلَّف (مُغطّى أو محميّ بغلاف أو ما يُشبهه) / ثَمِين",
 "はこう": "اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني / عَرَجَ / زحف (طريقة تنقل بطيئة على اليدين والركبتين أو بجر الجسم)\nمثال: كان الزحف هو كل ما استطاع الرجل المصاب القيام به",
 "はこうせい": "تراخ, سبات (خمول؛ إظهار نقص غير عادي في الطاقة) / خمول, ركود (وتيرة الأشياء التي تتحرك ببطء نسبي) / خمول مرضي, وسن (حالة من السبات تشبه الغيبوبة (كما توجد في مرض النوم))\nمثال: أقلق المظهر العام للسبات أصدقاءه",
 "はこがた": "شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته)",
 "はこがめ": "سلحفاة صندوقية (سلحفاة برية بشكل رئيسي من أمريكا الشمالية؛ يمكن إغلاق صدفتها بإحكام)",
 "はこきぎょう": "شركة صورية, شركة وهمية (شركة مؤسسة ولكن ليس لديها أصول أو عمليات)",
 "はこつさいぼう": "خلية هادمة للعظم, ناقضة العظم (خلية تعمل على تكسير وامتصاص النسيج العظمي)",
 "はこづめ": "مُلَاكَمَة",
 "はこばしゃ": "شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته)",
 "はこび": "تَقَدُّم",
 "はこびだす": "شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز.",
 "はこびて": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "はこびや": "رسول, ساعي (شخص يحمل رسالة)",
 "はこふぐ": "سمكة الصندوق (أي من الأسماك الاستوائية الصغيرة العديدة التي يكون جسمها ورأسها مغلفين بصفائح عظمية)",
 "はこぶ": "حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه. / جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟ / شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز.",
 "はこぶね": "سَفِينَة, فُلْك (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "はこべ": "أذن الفأر, حشيشة القزاز (أي من النباتات المتنوعة المرتبطة بحشيشة القزاز الشائعة) / حشيشة القزاز, ستيلاريا",
 "はこべら": "أذن الفأر, حشيشة القزاز (أي من النباتات المتنوعة المرتبطة بحشيشة القزاز الشائعة) / حشيشة القزاز, ستيلاريا",
 "はこめがね": "ساعة مائية, كليبسيدرا (ساعة تقيس الوقت عن طريق تدفق الماء) / مقياس مستوى الماء (مقياس للإشارة إلى مستوى الماء في خزان أو مرجل أو مستودع) / كوب ماء (كوب لشرب الماء) / زجاج مائي, سيليكات الصوديوم (زجاج لزج يتكون من سيليكات الصوديوم في محلول؛ يستخدم كمادة لاصقة أو طلاء واقي وحفظ البيض)",
 "はこもの": "شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته)",
 "はこん": "طَلَاق, تَطْلِيق / طَلَّقَ (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ) / أَطْلَقَ\nمثال: طلق زيري زوجته.",
 "はご": "رِيشَة",
 "はごいた": "مِدَقّ, مِدَقَّة (ما يدق او يطرق به ويسمى كذلك مطرقة)",
 "はごたえ": "ثَبَات / تَحَدٍّ, التَّحَدِّي",
 "はごろもかんらん": "كُرْنُب أَجْعَد",
 "はごろもがらす": "شحرور أحمر الجناح (شحرور من أمريكا الشمالية ذو بقع قرمزية على الأجنحة)",
 "はごろもむしくい": "حميراء أمريكية (طائر مغرد صائد للذباب يعيش في شرق أمريكا الشمالية، يتميز الذكر بلون برتقالي ساطع على الجوانب والأجنحة والذيل)",
 "はさい": "سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي التَّرْكِيبَاتِ) / إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة)\nمثال: قمع الهرطقة",
 "はさいき": "ساحقة, كسارة (جهاز يقوم بسحق شيء ما)",
 "はさいせい": "قابل للكسر, هش (قادر على أن ينكسر أو يتلف) / قابل للكسر (صنف هش وسهل الكسر)\nمثال: الفخار الخزفي قابل للكسر",
 "はさいせいばくだん": "ضربة أرضية زاحفة (كرة مضروبة أو مرسلة تنزلق قريباً من الأرض) / قنبلة شظية, قنبلة مضادة للأفراد (قنبلة تحتوي على 10 إلى 20 في المائة فقط من المواد المتفجرة والباقي يتكون من أغلفة مصممة لتتفتت إلى العديد من الشظايا الصغيرة عالية السرعة؛ وهي الأكثر…)",
 "はさつおん": "صَامِت مَوْقُوف اِحْتِكَاكِيّ, صَامِت مَزْجِيّ",
 "はさま": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية / وَادٍ, الْوَادِي (حوض أو منخفض طبيعي على سطح الأرض، يمتد بين السهول والهضاب والجبال)\nمثال: بإمكاني السباحة في الواد. / فتحة الرمي, مزغل (ثقب صغير في جدار محصن؛ للمراقبة أو إطلاق الأسلحة) / ثغرة (غموض (خاصة في نص قانون أو عقد) يجعل من الممكن التهرب من صعوبة أو التزام) / فَاصِل / مُدَّة, فَتْرَة / مَسَافَة",
 "はさみ": "مِقَصّ, مِقْرَاض / خَرَّامَة, خَرَّامَة وَرَق / كَلْبَتَان / مِشْبَك / كْلِيبْ / كلاب, مخلب (هيكل للإمساك على طرف القشريات أو مفصليات الأرجل الأخرى) / كماشة, ملقط (أداة يدوية للإمساك تتكون من رافعة مركبة للقبض)",
 "はさみあげる": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود.",
 "はさみきる": "قصاصة, قُصاصة (عملية القص أو القصقصة) / قُصاصة, نتفة (قطعة صغيرة من أي شيء (خاصة قطعة تم قصها))",
 "はさみこむ": "أَدْخَلَ",
 "はさみつけ": "مَشْبَك",
 "はさみむし": "أَبُو مِقَصّ",
 "はさみをいれる": "شَذَّبَ, قَلَّمَ / لَكْمَة / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة) / خَرَّامَة\nمثال: لكم اشتقت إليك!",
 "はさみを入れる": "شَذَّبَ, قَلَّمَ / لَكْمَة / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة) / خَرَّامَة\nمثال: لكم اشتقت إليك!",
 "はさみ切る": "قصاصة, قُصاصة (عملية القص أو القصقصة) / قُصاصة, نتفة (قطعة صغيرة من أي شيء (خاصة قطعة تم قصها))",
 "はさむ": "مَقْبِض / أَدْخَلَ / لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / مرفأ, ملاذ (مكان للملجأ والراحة والأمان) / مرفأ, ميناء بحري (ميناء محمي حيث يمكن للسفن شحن أو تفريغ البضائع) / مِشْبَك / كْلِيبْ",
 "はさん": "إِفْلَاس / اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "はさんすんぜん": "مُتَرَاصّ, مُتَلَاصِق ((عَنْ حَرَكَة المُرُور) مُتَلَاصِق سَيَّارَة بِسَيَّارَة بِسَبَب الازْدِحَام)",
 "はざくら": "شجرة الكرز, كرز (أي من العديد من الأشجار والشجيرات التي تنتج فاكهة مستديرة لحمية صغيرة بنواة صلبة واحدة؛ ينتج الكثير منها أيضاً خشباً صلباً قيماً)",
 "はざま": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية / وَادٍ, الْوَادِي (حوض أو منخفض طبيعي على سطح الأرض، يمتد بين السهول والهضاب والجبال)\nمثال: بإمكاني السباحة في الواد. / فتحة الرمي, مزغل (ثقب صغير في جدار محصن؛ للمراقبة أو إطلاق الأسلحة) / ثغرة (غموض (خاصة في نص قانون أو عقد) يجعل من الممكن التهرب من صعوبة أو التزام) / فَاصِل / مُدَّة, فَتْرَة / مَسَافَة",
 "はし": "جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قَنْطَرَة / كوبري / جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قنطرة / بْرِيدْج\nمثال: اذهب إلى الجسر. / أَعْوَاد الْأَكْل, هَاشِي / مِنْقَار / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء) / سَلَالِم / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم. / جَمِيل, مَحْبُوب (يخاطب العواطف والعين معاً) / جَذَّاب, فَاتِن (محبوب خاصة بطريقة طفولية أو ساذجة) / فتاة الغلاف (فتاة جميلة جداً تعمل كعارضة للمصورين) / فَارِس (اسم فاعل لفَرَسَ؛ راكب الفَرَس أو الحِصَان)\nمثال: فارس الظلام فيلم جيد.",
 "はしおる": "قَصَّر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "はしかけ": "تشابك, رابطة مستعرضة (رابطة جانبية تربط سلسلتين متجاورتين من الذرات في جزيء معقد)",
 "はしから": "مِنَ الأَلِف إِلَى اليَاء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "はしからはしまで": "باستفاضة, بدقة (بطريقة شاملة) / بشكل جيد, بقوة (كلياً وبالكامل)\nمثال: بحثنا في الملفات بدقة",
 "はしがかり": "جسر مسقوف (جسر يكون ممره محمياً بسقف وجوانب مغلقة)",
 "はしがき": "توطئة, ديباجة (مقال تمهيدي قصير يسبق نص كتاب) / إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية) / تذييل, ملاحظة لاحقة (ملاحظة تضاف إلى رسالة بعد التوقيع)",
 "はしがすすむ": "مُشَهٍّ (يجذب أو يحفز الشهية خاصة في المظهر أو الرائحة)",
 "はしくれ": "خُرْدَة / يتخلى, نبذ / شجار / تافه, غير مهم (ليس مهماً) / تافه, ضئيل الشأن (خالٍ من الأهمية أو المعنى أو القوة)\nمثال: ميزة غير مهمة نسبياً للنظام",
 "はしけ": "قَدَّاحَة, وَلَّاعَة",
 "はしけぶね": "قَدَّاحَة, وَلَّاعَة",
 "はしけ船": "قَدَّاحَة, وَلَّاعَة",
 "はしこい": "شَاطِر (بمعنى قطع إلى نصفين متساويين، الجمع شاطرون وشاطرات؛ مَن أعيا أهلهُ خبثًا، ومن هذا القبيل الابن الشّاطر المذكور في الإنجيل. الجمع شُطَّار) / ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي. / رَشِيق, خَفِيف اَلْحَرَكَة",
 "はしご": "سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم. / سَلَالِم",
 "はしござけ": "جولة حانات (جولة في الحانات (عادة مع تناول مشروب في كل محطة))",
 "はしごしゃ": "سيارة إطفاء بسلم (سيارة إطفاء تحمل سلالم)",
 "はしごだん": "خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة",
 "はしごのみ": "جولة حانات (جولة في الحانات (عادة مع تناول مشروب في كل محطة))",
 "はしご段": "خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة",
 "はしご車": "سيارة إطفاء بسلم (سيارة إطفاء تحمل سلالم)",
 "はしご酒": "جولة حانات (جولة في الحانات (عادة مع تناول مشروب في كل محطة))",
 "はしご飲み": "جولة حانات (جولة في الحانات (عادة مع تناول مشروب في كل محطة))",
 "はした": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب) / كَسْر, كُسُور\nمثال: يصنع قطعة أثاث خشبية. / فُرَاطَة",
 "はしたか": "بَاشِق",
 "はしたがね": "فُرَاطَة",
 "はしたない": "خَاطِئ, غَيْر صَحِيح (غير ملائم لغرض أو مناسبة معيّنة) / غير لائق, غير مناسب (غير ملائم أو غير صحيح أو غير مناسب) / غَيْرُ تَقْلِيدِيّ, غَيْرُ مَشْرُوعٍ (لا يتوافق مع القانون أو الأعراف الاجتماعية)\nمثال: من غير اللائق قليلاً تناول العشاء بمفردها مع رجل متزوج",
 "はしため": "خادمة (عاملة منزلية)",
 "はした金": "فُرَاطَة",
 "はしっこ": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "はしっこい": "شَاطِر (بمعنى قطع إلى نصفين متساويين، الجمع شاطرون وشاطرات؛ مَن أعيا أهلهُ خبثًا، ومن هذا القبيل الابن الشّاطر المذكور في الإنجيل. الجمع شُطَّار) / ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي. / رَشِيق, خَفِيف اَلْحَرَكَة",
 "はしどい": "ليلك ياباني شجري (شجرة صغيرة من اليابان لها أوراق مدببة ضيقة وزهور بيضاء كريمية)",
 "はしなくも": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة",
 "はしにもぼうにもかからない": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "はしにもぼうにもひっかからない": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "はしばし": "أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء)",
 "はしばみ": "بَاشِق",
 "はしばみのみ": "بُنْدُق, بُنْدُقَة (نوع من الثَمَر صلب ينمو محاطا بغلاف صلب كالجَوْز يكثر في الشَام. الحبة الواحدة بُنْدُقَة ولا يُجْمَع؛ الشجر الذي يُثمِرُ بُنْدُقًا، يُجمع على بُنْدُقَات)",
 "はしびろこう": "أبو مركوب",
 "はしぶとうみがらす": "مور غليظ المنقار (نوع من طائر المور)",
 "はしぼそがらす": "نسر أسود أمريكي (نسر أمريكي أصغر من النسر الرومي)",
 "はしもとびょう": "داء هاشيموتو (اضطراب مناعي ذاتي في الغدة الدرقية)",
 "はしゃ": "غَازٍ / نَصِير, نَصِيرَة / مُقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "はしゃぐ": "لهو, مرح (نشاط ترفيهي مبهج أو خفيف الظل للتسلية)\nمثال: كل ذلك تم من باب المزاح",
 "はしやすめ": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له)",
 "はしゅ": "مِقْبَض / خِنْزِيرَة / زَرَعَ, بَذَرَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت.",
 "はしゅつ": "إرسال, إيفاد (فعل إرسال شيء ما) / إجهاز, قتل (قتل شخص أو حيوان (بسرعة)) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً) / برقية, بلاغ (تقرير رسمي (يرسل عادة على عجل))\nمثال: تم إنجازه بسرعة وكفاءة",
 "はしゅどこ": "مشتل, مهاد البذور (حوض تُزرع فيه الشتلات قبل نقلها)",
 "はしょうふう": "كُزَاز, كُزَّاز",
 "はしょうふうこうどくそ": "مضاد ذيفان التيتانوس (مضاد ذيفان يُعطى للتحصين قصير المدى ضد التيتانوس في حالات التعرض المحتمل لعصيات التيتانوس)",
 "はしょる": "قَصَّر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "はしら": "عمود / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "はしらあな": "حفرة العمود (حفرة محفورة في الأرض لتثبيت عمود السياج)",
 "はしらがき": "قبعة (غطاء رأس يحمي الرأس من الطقس السيء؛ له تاج مشكّل وعادة حافة)",
 "はしらす": "إرسال, إيفاد (فعل إرسال شيء ما) / إجهاز, قتل (قتل شخص أو حيوان (بسرعة)) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً) / برقية, بلاغ (تقرير رسمي (يرسل عادة على عجل))\nمثال: تم إنجازه بسرعة وكفاءة / قَادَ, سَاقَ / سَاقَ / رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض. / دحر, هزيمة منكرة (هزيمة ساحقة) / رعاع, غوغاء (حشد غير منظم من الناس)",
 "はしらせる": "إرسال, إيفاد (فعل إرسال شيء ما) / إجهاز, قتل (قتل شخص أو حيوان (بسرعة)) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً) / برقية, بلاغ (تقرير رسمي (يرسل عادة على عجل))\nمثال: تم إنجازه بسرعة وكفاءة / قَادَ, سَاقَ / سَاقَ / رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض. / دحر, هزيمة منكرة (هزيمة ساحقة) / رعاع, غوغاء (حشد غير منظم من الناس)",
 "はしらどけい": "ساعة حائط (ساعة مثبتة على الحائط)",
 "はしらま": "خَلِيج, شَرْم",
 "はしり": "رَكْض (عَدَا)\nمثال: إنها تحب الركض. / طيران شراعي (نشاط الطيران بطائرة شراعية) / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / حوض المطبخ, مجلى (حوض في المطبخ)",
 "はしりがき": "خربشة",
 "はしりさる": "هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "はしりたかとび": "قفز عالي, وثب عالي (فعل القفز لأعلى ارتفاع ممكن فوق عارضة أفقية) / القفز العالي, الوثب العالي (مسابقة تتضمن القفز لأعلى ارتفاع ممكن فوق عارضة أفقية)",
 "はしりだす": "خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ) / أَقْلَعَ / اِزْدَهَرَ\nمثال: خلع سامي حذاءه.",
 "はしりでる": "نَفِدَ",
 "はしりはばとび": "قفز طويل, وثب طويل (فعل القفز لأبعد مسافة ممكنة من انطلاقة ركض) / القفز الطويل, الوثب الطويل (مسابقة تتضمن القفز لأبعد مسافة ممكنة انطلاقاً من الجري)",
 "はしりよみ": "مسح, مسح ضوئي (فعل تحريك شعاع ضوئي أو إلكتروني بؤري بدقة بشكل منهجي فوق سطح ما لإنتاج صورة له للتحليل أو الإرسال) / مسح ضوئي (عملية ترجمة الصور إلى شكل رقمي يمكن للكمبيوتر التعرف عليه)",
 "はしる": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض. / اِنْدَفَعَ, أَسْرَعَ / سَمَار / تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ / هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "はしわたし": "وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / وساطة (تفاوض لحل الخلافات يديره طرف محايد)",
 "はしをとる": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "はじ": "خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق) / عَار\nمثال: توم لص بلا خجل. / قَبْضَة / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء)",
 "はじお": "قَلَح, قَلْح",
 "はじかみ": "زَنْجَبِيل / أَصْهَب",
 "はじき": "مُسَدَّس, طَبَنْجَة (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ) / مِدْفَع (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)\nمثال: كان عند زيري مسدس.",
 "はじきおん": "رَفْرَف",
 "はじきかえす": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "はじきだす": "دَفَعَ, صَدَّ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / حَسَبَ (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال. / طَرَدَ, نَفَى",
 "はじきだま": "كُرَيَّات",
 "はじきとばす": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "はじき出す": "دَفَعَ, صَدَّ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / حَسَبَ (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال. / طَرَدَ, نَفَى",
 "はじき音": "رَفْرَف",
 "はじき飛ばす": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "はじく": "قَلَبَ / دَفَعَ, صَدَّ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟ / دندنة, عزف (صوت العزف على الأوتار)\nمثال: عزف الغيتار",
 "はじけとぶ": "برز, ظهر فجأة (ظهر أو حدث بشكل مفاجئ أو غير متوقع)\nمثال: ظهرت المزرعة فجأة عندما انعطفنا",
 "はじける": "بُوب, مُوسِيقَى شَعْبِيَّة / قفزة, وثبة (حركة خفيفة ذاتية الدفع لأعلى أو للأمام) / ارتداد (جودة المادة القادرة على الارتداد) / ارتداد, نط (الارتداد من ارتطام (أو سلسلة من الارتطامات))",
 "はじけ飛ぶ": "برز, ظهر فجأة (ظهر أو حدث بشكل مفاجئ أو غير متوقع)\nمثال: ظهرت المزرعة فجأة عندما انعطفنا",
 "はじさらし": "عَار, خِزْي",
 "はじしらず": "وَقِح, صَفِيق",
 "はじぞめ": "بني مصفر, كراميل (لون أسمر متوسط إلى داكن)",
 "はじっこ": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "はじとみ": "ثُنَائِيّ, مِن جُزْأَيْن (يتضمن جزأين أو عنصرين)",
 "はじまり": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل",
 "はじまる": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / حَدَثَ, جَرَى (وَقَعَ الأمر؛ نقيض قَدُمَ، كان حَدِيثا)\nمثال: لا أصدق ما حدث. / حتّى الآن (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "はじむ": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "はじめ": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل / نَاهِيكَ عَن, هٰذَا عَدَا عَنْ",
 "はじめて": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة.",
 "はじめとする": "شَامِل",
 "はじめに": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "はじめにことばありき": "أصلاً, في المقام الأول (قبل الآن) / أصلاً, في البداية (فيما يتعلق بالأصل أو البداية)\nمثال: لماذا لم تخبرني في المقام الأول؟",
 "はじめのうち": "أول الأمر, في البداية (في البدء)\nمثال: في البداية لم يلاحظ أي شيء غريب",
 "はじめは": "أول الأمر, في البداية (في البدء)\nمثال: في البداية لم يلاحظ أي شيء غريب",
 "はじめる": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "はじもがいぶんも": "حياء, شعور بالمسؤولية (وعي دافع بالمسؤولية الأخلاقية)",
 "はじょう": "مُتَمَوِّج, مُجَعَّد (غير مستوٍ بسبب وجود تجاعيد أو موجات)",
 "はじょうつい": "كبش ضارب (كبش يستخدم لكسر أبواب المباني المحصنة)",
 "はじょうねつ": "حمى مالطية, حمى متموجة (مرض بكتيري معد يصيب البشر ينتقل عن طريق الاتصال بالحيوانات المصابة أو اللحوم أو منتجات الألبان المصابة؛ يتميز بالحمى والصداع) / إجهاض معدي, حمى مالطية (مرض معد يصيب الحيوانات الأليفة يؤدي غالبًا إلى الإجهاض التلقائي؛ يمكن أن ينتقل إلى البشر)",
 "はじらい": "حياء, خجل (شعور بالخوف من الإحراج)",
 "はじらう": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر) / رُوج (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها.",
 "はじらみ": "قمل الطيور, قمل قارض (حشرة عديمة الأجنحة بأجزاء فم مهيأة للعض؛ تتطفل غالباً على الطيور)",
 "はじろう": "شمع نباتي (مادة شمعية يتم الحصول عليها من النباتات (خاصة من جذوع بعض أنواع النخيل))",
 "はじろうみばと": "غلموت أسود, مور أسود (غلموت شمال الأطلسي)",
 "はじをしる": "اِسْتَحَى\nمثال: 恥を知れ！ — عار عليك!",
 "はじん": "فلاح ساذج, قروي بسيط (شخص ليس ذكياً جداً أو غير مهتم بالثقافة)",
 "はす": "لوتس, لوتس مقدس (موطنه شرق آسيا؛ يزرع على نطاق واسع لأزهاره الكبيرة الوردية أو البيضاء) / مَائِل, قُطْرِيّ",
 "はすう": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب) / كَسْر, كُسُور\nمثال: يصنع قطعة أثاث خشبية. / عَدَد مَوْجِيّ (مقلوب الطول الموجي للموجة)",
 "はすかい": "بِانْحِرَاف, بِمَيْل (بزاوية مائلة) / بِمَيْل (فوق أو عبر في اتجاه مائل) / قُطْرِيّ, مَائِل (ذو اتِّجاه مائل أو منحرف عن الأفق)\nمثال: سطعت الشمس بميل على وجهه",
 "はすっぱ": "بَذِيء",
 "はすにかまえる": "فِرَاش, أَرِيكَة",
 "はすは": "بَذِيء",
 "はすば": "بَذِيء",
 "はすむかい": "مَائِلٌ قُطْرِيًّا عَبْرَ الزَّاوِيَة (مُنْحَرِفٌ عَبْرَ مُضَلَّعٍ عَلَى خَطٍّ قُطْرِيّ)",
 "はすわ": "بَذِيء",
 "はす交い": "بِانْحِرَاف, بِمَيْل (بزاوية مائلة) / بِمَيْل (فوق أو عبر في اتجاه مائل) / قُطْرِيّ, مَائِل (ذو اتِّجاه مائل أو منحرف عن الأفق)\nمثال: سطعت الشمس بميل على وجهه",
 "はす向い": "مَائِلٌ قُطْرِيًّا عَبْرَ الزَّاوِيَة (مُنْحَرِفٌ عَبْرَ مُضَلَّعٍ عَلَى خَطٍّ قُطْرِيّ)",
 "はす向かい": "مَائِلٌ قُطْرِيًّا عَبْرَ الزَّاوِيَة (مُنْحَرِفٌ عَبْرَ مُضَلَّعٍ عَلَى خَطٍّ قُطْرِيّ)",
 "はず": "يَنْبَغِي أَنْ / مِنْ اَلْمَفْرُوض أَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / مِنْ اَلْمُفْتَرَض أَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "はずい": "حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / مُحْرِج, مُخْجِل (يسبب الشعور بالخجل أو الانزعاج أو الضيق)",
 "はずかしい": "حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / مُحْرِج, مُخْجِل (يسبب الشعور بالخجل أو الانزعاج أو الضيق) / فَاضِح, مُخْزٍ ((للسلوك أو الشخصيَّة) يستحقّ العار أو يجلبه) / فَاضِح, مُخْزٍ (يُسِيءُ إِلَى الحِسِّ الأَخْلَاقِيِّ وَيَضُرُّ بِالسُّمْعَة)",
 "はずかしがりや": "انطوائي, خجول (شخص ينكمش من الألفة مع الآخرين)",
 "はずかしがる": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر) / رُوج (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها.",
 "はずかしげ": "مُحْرَج, بِٱلْحَرَج",
 "はずかしげもなく": "بجرأة, بوقاحة (بطريقة وقحة)\nمثال: تحدث بوقاحة",
 "はずかしながら": "بِشَكْل مُحْرِج (مسبباً للإحراج)\nمثال: كان الرجل العظيم متواضعاً ونكراً للذات بشكل محرج",
 "はずかしめ": "خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق) / عَار\nمثال: توم لص بلا خجل. / اِنْتِهَاك",
 "はずかしめる": "أَخْزَى, اِسْتَذَلَّ (أَخْزَى: (فعل) أخزَى يُخزي ، أخْزِ ، إخزاءً ، فهو مُخْزٍ ، والمفعول مُخزًى) / اِنْتَهَكَ",
 "はずす": "نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا. / قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه. / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / تفادي, مراوغة (حركة مراوغة سريعة) / حيلة, خديعة (مخطط مفصل أو خادع تم تدبيره للخداع أو التهرب) / تملص, مراوغة (بيان يتهرب من السؤال بذكاء أو حيلة)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "はずのない": "يَعْنِي, أَي",
 "はずべき": "فَاضِح, مُخْزٍ ((للسلوك أو الشخصيَّة) يستحقّ العار أو يجلبه) / فَاضِح, مُخْزٍ (يُسِيءُ إِلَى الحِسِّ الأَخْلَاقِيِّ وَيَضُرُّ بِالسُّمْعَة)",
 "はずみ": "قفزة, وثبة (حركة خفيفة ذاتية الدفع لأعلى أو للأمام) / ارتداد (جودة المادة القادرة على الارتداد) / ارتداد, نط (الارتداد من ارتطام (أو سلسلة من الارتطامات)) / زَخَم حَرَكَة (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…) / زَخَم (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…)\nمثال: يمكنك أن تتعلم بنفس الزخم في المكتبة كما في المدرسة. / عَزْم / لَحْظَة, دَقِيقَة",
 "はずみぐるま": "حَدَّافَة",
 "はずみをつける": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "はずむ": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / يَاي, زُنْبُرُك\nمثال: كان عين ليلى مسودة. / عربدة, نوبة إفراط (أي فعل من أفعال الانغماس غير المعتدل) / إسراف استعراضي (عرض متباه (للجهد أو الإسراف، إلخ.))\nمثال: نوبة إفراط في التسوق / شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم) / بنطال, سروال ((عادة بصيغة الجمع) رداء يمتد من الخصر إلى الركبة أو الكاحل، ويغطي كل ساق على حدة) / لهث, نفث (الضجيج الناتج عن نفثة قصيرة من البخار (كما من محرك))\nمثال: أطلقت شهقة وأغمي عليها",
 "はずめますて": "لهجة بصرية (استخدام الأخطاء الإملائية لتحديد متحدث عامي أو غير متعلم (في الكتابة))",
 "はずゆ": "زيت كروتون (زيت لزج أصفر مائل للبني من بذور كروتون تيغليوم له تأثير مسهل عنيف)",
 "はずれ": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "はずれち": "قيمة شاذة, قيمة متطرفة (انحراف شديد عن المتوسط) / ساكن الضواحي البعيدة (شخص يعيش بعيداً عن مكان عمله)",
 "はせい": "استمداد, اشتقاق (فعل اشتقاق شيء أو الحصول عليه من مصدر أو أصل) / تحويل المسار, سحب (سحب المياه من قناتها الرئيسية كما للري) / اشتقاق, سحب (سحب السوائل أو الالتهاب بعيداً عن جزء مريض من الجسم) / أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم)",
 "はせいご": "مشتقّ",
 "はせいさくひん": "منتج ثانوي (منتج تم صنعه أثناء تصنيع شيء آخر)",
 "はせいてき": "مشتقّ",
 "はせつ": "كَسْر, اِنْكِسَار / كَسْر / يكسر, ينكسر",
 "はせる": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض. / رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "はせん": "حُطَام سَفِينَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد) / فُرَاطَة / تفرع نهري (فرع من نهر يتدفق بعيداً عن المجرى الرئيسي ولا يعود إليه)",
 "はせんふごう": "تِلْدَة",
 "はぜ": "قوبيون (سمكة صغيرة شائكة الزعانف تعيش في المياه الساحلية أو قليلة الملوحة لها رأس كبير وجسم مستدق ممدود وتتحور الزعانف البطنية لتعمل كممص)",
 "はぜる": "بُوب, مُوسِيقَى شَعْبِيَّة",
 "はぜろう": "شمع نباتي (مادة شمعية يتم الحصول عليها من النباتات (خاصة من جذوع بعض أنواع النخيل))",
 "はそく": "جَشِع, حَرِيص (شديد الرغبة بشكل مفرط في اكتساب الثروة وغيرها) / إمساك, قبض (فعل الإمساك بشيء بإحكام باليدين) / محاولة الفهم (الفهم بصعوبة)\nمثال: كانت المحاضرة تتجاوز أقصى محاولاته للفهم / قطار أمواج (تتابع من الأمواج المتباعدة بفترات منتظمة)",
 "はそん": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة.",
 "はた": "قاروس, قاروص / عَلَم, رَايَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / رَايَة, عَلَم / لَافِتَة / مُلْصَق / إِعْلَان / مُمْتَاز / مِنْسَج / عِشْرُونَ / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل. / زِعْنِفَة (أشواك عظمية مغطاة بالجلد أو أشعة تبرز من جسم السمكة، يستعملها السمك في التوزان وللاندفاع إلى الأمام) / طَائِرَة وَرَقِيَّة, طيارة ورق (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر)\nمثال: لقد وصلت الطائرة. / أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟ / عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك / رُبَّمَا / مِن اَلْمُمْكِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / لَعَلَّ (يفيد التوقع مع الترجي؛ يفيد التوقع مع الإشفاق والخوف)\nمثال: يا لها من جملة! / بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال / أجنبي, دخيل (شخص مستبعد أو ليس عضواً في مجموعة معينة) / متسابق غير مرشح (متسابق (إنسان أو حيوان) لا يُعتقد أن لديه فرصة جيدة للفوز)",
 "はたいろ": "حَالَة, وَضْع / تَبَعِيَّة, اِنْتِمَاء (التَّبَعيَّة : كَوْن الشخص أو الشيْ تابعاً لغيره؛ مصدر صناعيّ من تَبَعَ: جِنْسِيَّة ومُواطَنَة أو انتماء إلى دولة ما، يكون للمواطن فيها حقوق وامتيازات، وبالمقابل عليه واجبات)",
 "はたうち": "حَرْث (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: حرث المزارع أرضه.",
 "はたおり": "حياكة, نسيج (صنع القماش)",
 "はたおりどり": "حباك (طيور استعمارية أفريقية وآسيوية تشبه الشرشور تشتهر بأعشاشها المنسوجة بإتقان)",
 "はたおりむし": "جُنْدُب, جَرَادَة",
 "はたがしら": "قَائِد, زَعِيم",
 "はたき": "مِمْسَحَة, مِمْسَح / غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تراب / غُبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تُراب / غبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم)\nمثال: أزل الغبار عن المرآة.",
 "はたきをかける": "غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تراب / غُبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تُراب / غبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم)\nمثال: أزل الغبار عن المرآة.",
 "はたく": "غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تراب / غُبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تُراب / غبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم)\nمثال: أزل الغبار عن المرآة. / صَفْعَة, لَطْمَة / صَفَعَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين) / لَطَمَ (ضربَ بباطن الكفّ على الوجه أو على شيءٍ آخر؛ أصابَ الشيءَ بقوة أو صدمه)\nمثال: صفع المدرس مؤخرتي.",
 "はたけ": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل. / رَحِم, بَيْت الْوَلِد (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام) / مَنشَأ, رَحِم\nمثال: رحمة الله عليه.",
 "はたけしめじ": "دَجَاج مَقْلِيّ",
 "はたけのにく": "صويا, فول الصويا (أكثر الخضراوات المعروفة احتواءً على البروتين؛ تستخدم ثمرة نبات الصويا في مجموعة متنوعة من الأطعمة وكعلف (خاصة كبديل للبروتين الحيواني)) / صويا, فول الصويا (عشب حولي منتصب كثيف الشعر له أوراق ثلاثية وزهور أرجوانية إلى وردية؛ يزرع على نطاق واسع للغذاء والعلف ولتحسين التربة، وخاصة لبذوره المغذية الغنية…) / فول الصويا (مصدر للزيت؛ يستخدم للعلف وتحسين التربة وكغذاء)",
 "はたけをつくる": "مَزْرَعَة",
 "はたご": "خَان, اِسْتِرَاحَة (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة.",
 "はたざお": "سارية العلم (عمود طويل أو سارية يرفع عليها العلم) / أرابيس, رشاد الصخر (أي من عدة نباتات رشاد محبة للصخور من جنس أرابيس)",
 "はたしあい": "مُبَارَزَة",
 "はたしあう": "مُبَارَزَة",
 "はたして": "بالتأكيد, حتماً (بشكل قاطع أو إيجابي) / كما كان متوقعاً, وفعلاً (كما هو مفترض أو متوقع)\nمثال: النتائج مشجعة بالتأكيد / حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا .",
 "はたしん": "تشين, سلالة تشين (السلالة الصينية (من 246 قبل الميلاد إلى 206 قبل الميلاد) التي أسست أول حكومة إمبراطورية مركزية وبنت جزءاً كبيراً من سور الصين العظيم)",
 "はたじるし": "تَخْطِيط, تصميم (مصدر من خَطَّطَ؛ في : فكرةٌ مُثبتة بالرسم، أو الكتابة في حالة الخطّ. تدلّ دلالةً تامَّة على ما يُقصد في الصُّورة أو الرسم أَو اللَّوح المكتوب من المعنى والموضوع…) / تَصْمِيم, ديزاين\nمثال: يعمل في قسم التخطيط. / رَايَة, عَلَم / لَافِتَة / مُلْصَق / إِعْلَان / مُمْتَاز",
 "はたす": "أَدَّى\nمثال: 君はその義務を果たすべきである。 — عليك أن تقوم بالواجب.",
 "はたち": "أَرْض زِرَاعِيَّة (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة. / عِشْرُونَ",
 "はたて": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "はたと": "فَجْأَةً / بحدة, بعدوانية (بطريقة عدوانية) / بشكل حاد, بوضوح (بطريقة محددة بوضوح) / بشكل حاد, بشكل مفاجئ (بشكل مفاجئ جداً وبدرجة كبيرة) / بحدة, بزاوية حادة (تغير مفاجئ في الاتجاه والدرجة)\nمثال: كانت تُستجوب بحدة / تَمَامًا",
 "はたのものたち": "متفرج (شخص ينظر ويراقب)",
 "はたはた": "تمايل, رفرفة (فعل التحرك ذهاباً وإياباً) / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / اضطراب, قلاقل (ثوران أو صخب غير منظم) / رفرفة (خفقان سريع غير طبيعي للأذينين في القلب (خاصة بنظم منتظم)؛ يمكن أن يؤدي إلى حصار القلب)\nمثال: لقد ذهلوا من الاضطراب العنيف الذي سببوه",
 "はたび": "عطلة رسمية, عطلة قانونية (عطلة مصرح بها قانوناً ويتم فيها تقليص العمل أو الأعمال الرسمية)",
 "はたふり": "بادئ (مزرعة تحتوي على خميرة أو بكتيريا تستخدم لبدء عملية التخمير أو التحمض في صنع الزبدة أو الجبن أو العجين) / ذراع تدوير, مرفق تدوير (أداة يدوية تتكون من عمود دوار بمقبض مواز) / بادئ التشغيل, مارش (محرك كهربائي لبدء تشغيل المحرك) / فاتح للشهية, مقبلات (طعام أو شراب لتحفيز الشهية (يُقدم عادة قبل الوجبة أو كطبق أول))\nمثال: لصنع العجين المخمر تحتاج إلى بادئ",
 "はたふりやく": "مُبَادِر",
 "はたほこ": "ذُو مِقْبَض طَوِيل (لَهُ مِقْبَض أَوْ يَد طَويلَة)",
 "はたぼこ": "ذُو مِقْبَض طَوِيل (لَهُ مِقْبَض أَوْ يَد طَويلَة)",
 "はたまた": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "はためく": "تمايل, رفرفة (فعل التحرك ذهاباً وإياباً) / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / اضطراب, قلاقل (ثوران أو صخب غير منظم) / رفرفة (خفقان سريع غير طبيعي للأذينين في القلب (خاصة بنظم منتظم)؛ يمكن أن يؤدي إلى حصار القلب)\nمثال: لقد ذهلوا من الاضطراب العنيف الذي سببوه",
 "はたもち": "حامل الراية, حامل العلم (الجندي الذي يحمل راية الوحدة في العروض العسكرية أو في المعركة) / حامل اللواء (قائد بارز لحركة سياسية)",
 "はたもと": "الْقِيَادَة الْعَامَّة / مَقَرّ",
 "はたや": "نَسَّاج, نَسَّاجَة / تَنَوُّط",
 "はたらかせる": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "はたらき": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل. / إِنْجَاز / رَاتِب, أَجْر / عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "はたらきあり": "عامل كادح (شخص يعمل بجد مثل العبد)",
 "はたらきかけ": "ضَغْط",
 "はたらきかける": "ضَغْط",
 "はたらきぐち": "مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث.",
 "はたらきすぎ": "فرط النشاط (نشاط مفرط)\nمثال: فرط نشاط الغدد الدهنية يجعل الجلد دهنيًا",
 "はたらきすぎる": "إرهاق في العمل, عمل مفرط (فعل العمل كثيراً جداً أو لفترة طويلة جداً)\nمثال: أصيب بالمرض من الإرهاق في العمل",
 "はたらきちゅうどく": "مدمن عمل (شخص لديه حاجة قهرية للعمل)",
 "はたらきて": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "はたらきばち": "شغالة, نحلة عاملة (نحلة عقيمة متخصصة في جمع الطعام وصيانة الخلية) / عامل كادح (شخص يعمل بجد مثل العبد)",
 "はたらきびと": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "はたらきもの": "عامل كادح (شخص يعمل بجد مثل العبد)\nمثال: 若いときは、彼は働き者であった。 — عندما كان شاباً، كان عاملاً مثابراً.",
 "はたらく": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل. / وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / مَهَمَّة / دَالَّة, تَابِع / وَظِيفَة, دَالَّة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟ / اِرْتَكَبَ",
 "はたりす": "سنجاب الأرض (أي من قوارض أرضية متنوعة تحفر الجحور في العالمين القديم والجديد؛ غالباً ما تدمر المحاصيل) / صيدناني شرقي (سنجاب أمريكي شرقي صغير مخطط شبه أرضي ذو جيوب خدية)",
 "はたをおる": "نَسَجَ",
 "はたん": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا. / مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة.",
 "はたんきょう": "بَرْقُوق",
 "はたんをきたす": "أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "はだ": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال. / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ)) / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / طبع, مزاج (الحالة المزاجية المعتادة) / استعداد, ميل (عادة طبيعية أو مكتسبة أو ميل مميز في شخص أو شيء) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: لديه مزاج سعيد",
 "はだあい": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / طبع, مزاج (الحالة المزاجية المعتادة) / استعداد, ميل (عادة طبيعية أو مكتسبة أو ميل مميز في شخص أو شيء) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: لديه مزاج سعيد",
 "はだいろ": "بشرة, لون البشرة (لون وجه الشخص)",
 "はだうま": "فرس ولود (أنثى حصان تستخدم للتربية)",
 "はだえ": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال. / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ)) / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / طبع, مزاج (الحالة المزاجية المعتادة) / استعداد, ميل (عادة طبيعية أو مكتسبة أو ميل مميز في شخص أو شيء) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: لديه مزاج سعيد",
 "はだか": "انفتاح, شفافية (يتسم بموقف يسهل الوصول إليه (خاصة فيما يتعلق بأفعال المرء أو مقاصده)؛ بدون إخفاء؛ غير كتوم) / عري (حالة عدم وجود ملابس أو غطاء من أي نوع) / عراء, قفار (جو موحش ومقفر)\nمثال: عراء المنظر الطبيعي / خلو من الزينة, عري (نقص شديد في المفروشات أو الزخرفة) / انكشاف, عري (حالة كونه غير مكسو ومكشوفاً (خاصة لجزء من الجسم)) / عراء, قفار (جو موحش ومقفر)\nمثال: لقد أذهلني خلو غرفة أبي من الزينة / انفتاح, تقبل (الاستعداد أو الجاهزية للتلقي (خاصة الانطباعات أو الأفكار)) / اِتِّسَاع, اِنْفِتَاح (الخلو من العوائق أمام المرور أو الرؤية)\nمثال: كان يختبر تقبل الحكومة للإصلاح",
 "はだかおどり": "رَقْص تَعَرِيّ, اِسْتْرِبْتِيز (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "はだかでばねずみ": "خُلْد أَمْرَط, خُلْد عَارٍ (الثَبَات المَدِيد والبَقَاء لفترة طويلة؛ دَوَام البَقَاء، يختلف عن السَرْمَد في أن السرمد مختص بالزمان تحديدا والخلد في غير ذلك)\nمثال: خلد ياني إلى النوم.",
 "はだかになる": "تَعَرَّى, اِنْجَرَدَ / تَعَرَّى",
 "はだかへび": "ضفدع ثعباني (أي من البرمائيات الصغيرة النحيلة عديمة الأطراف الحفارة التي تشبه الديدان؛ تعيش في التربة الرطبة في المناطق الاستوائية) / ضفدعي ثعباني (من أو متعلق بـ أو ينتمي إلى فصيلة الضفادع الثعبانية)",
 "はだかむし": "يَرَقَة, دُودَة الْفَرَاشَة",
 "はだかんかく": "إحساس جلدي, حس لمسي (إحساس موضعي على الجلد)",
 "はだぎ": "مَلَابِس دَاخِلِيَّة, لِبَاس دَاخِلِيّ",
 "はだぎぬ": "مَلَابِس دَاخِلِيَّة, لِبَاس دَاخِلِيّ",
 "はだける": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا. / تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ",
 "はださむ": "برودة شديدة, صقيع (برودة ناتجة عن بيئة باردة) / رجفة, رعشة (إحساس بالخوف يكاد يكون ممتعاً) / انقباض, وجوم (رهبة مفاجئة تسبب الشلل) / رجفة, قشعريرة (إحساس بالبرد غالباً ما يشير إلى بداية عدوى وتطور حمى)\nمثال: سرت فيه رعشة مفاجئة",
 "はださむい": "بَارِد, فَاتِرُ المَشَاعِر (لا يتّسم بالعاطفة) / بَارِد, جَافّ المُعَامَلَة (يَفْتَقِرُ إِلَى دِفْء المَشَاعِر) / بَارِد نَوْعًا مَا (بارد بشكل ملحوظ أو مُزعج) / فلفل تشيلي, فلفل حار (فلفل حار جداً ودقيق الاستدقاق ذو طعم لاذع خاص)",
 "はだざむい": "بَارِد, فَاتِرُ المَشَاعِر (لا يتّسم بالعاطفة) / بَارِد, جَافّ المُعَامَلَة (يَفْتَقِرُ إِلَى دِفْء المَشَاعِر) / بَارِد نَوْعًا مَا (بارد بشكل ملحوظ أو مُزعج) / فلفل تشيلي, فلفل حار (فلفل حار جداً ودقيق الاستدقاق ذو طعم لاذع خاص)",
 "はだざわり": "تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "はだし": "حَافٍ, حَافِي (مال أو انحرف عن الشيء؛ سار على حافة الشيء أو حام حوله) / حافي القدمين (حَفِيَ، الذي لا يرتدي حِذَاء أو نَعَال أو غيره من لباس القَدَمَيْن)\nمثال: وقف على حافة الجرف.",
 "はだしつ": "مَلْمَس",
 "はだに": "سوس عنكبوتي (سوس غازل للشبك يهاجم نباتات الحدائق وأشجار الفاكهة)",
 "はだのいろ": "بشرة, لون البشرة (لون وجه الشخص)",
 "はだへ": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)",
 "はだみ": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "はだん": "انقطاع, قطع مفاجئ (حالة من المقاطعة المفاجئة) / تَمَزُّق",
 "はち": "زِبْدِيَّة / سُلْطَانِيَّة / زُبْدِيَّة / قِدْر (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / إِنَاء / طَنْجَرَة / حَلَّة (المرة الواحدة من الحُلول، أي النزول؛ الزنبيل الكبير من القصب) / قِدِر (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / حلَّة (المرة الواحدة من الحُلول، أي النزول؛ الزنبيل الكبير من القصب)\nمثال: خذ قدر ما تريد. / تَاج, إِكْلِيل / نَحْلَة / نَحْل / نحل / نحلة / بِي\nمثال: 蜂は花から花に飛ぶ。 — تطير النحلات من زهرة إلى زهرة. / ثَمَانِيَة, تمانية / ثَمَانِيَةٌ",
 "はちあわせ": "صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ) / مُلَاقَاة, مُقَابَلَة (لِقَاء)\nمثال: صادف مشكلا صعبا.",
 "はちあわせる": "صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ) / مُلَاقَاة, مُقَابَلَة (لِقَاء)\nمثال: صادف مشكلا صعبا.",
 "はちがつ": "أَغُسْطُس, آب (الشهر الثامن في السنة الروميّة)\nمثال: غادر فاضل البلد في الثالث و العشرين من أغسطس.",
 "はちきれる": "انفجار (عملية الانفجار أو التفرقع) / فورة, نوبة (فورة مفاجئة من النشاط (غالباً لسبب غير واضح)) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: انفجار الألعاب النارية أيقظ الأطفال",
 "はちく": "لَا يُقَاوَم (بالغ الجاذبيّة إلى حدّ لا يمكن مقاومته) / ساحق, لا يقاوم (مستحيل مقاومته؛ غلاب)\nمثال: دوافع لا تقاوم",
 "はちしんすう": "ثماني (متعلق بنظام عددي أساسه 8)\nمثال: رقم ثماني",
 "はちじ": "اَلسَّاعَة اَلثَّامِنَة",
 "はちじゅう": "ثَمَانِينَ, ثَمَانُونَ",
 "はちじゅうだい": "ثَمَانُونَ (يَدُلُّ عَلَى العَدَد 80) / ثَمَانُون (العدد الأصلي الذي هو حاصل ضرب عشرة في ثمانية)",
 "はちじゅうねんだい": "الثمانينات (الفترة من العمر بين 80 و 90) / الثمانينات (1980), عقد 1980 (العقد من 1980 إلى 1989) / عقد 1880 (العقد من 1880 إلى 1889)",
 "はちじゅうのてならい": "لَيْسَ هُنَاكَ سِنٌ مُتَأَخِّرَةٌ لِلتَعَلُّمِ",
 "はちじゅうまん": "ثَمَانِيمِئَة, ثَمَانِيمِا۟ئَة",
 "はちじょう": "مَنْسُوجٌ نَسْجًا سَادَةً ((لِلْقُمَاشِ) مَصْنُوعٌ بِالنَّسْجِ السَّادَةِ)",
 "はちじょうぎぬ": "مَنْسُوجٌ نَسْجًا سَادَةً ((لِلْقُمَاشِ) مَصْنُوعٌ بِالنَّسْجِ السَّادَةِ)",
 "はちす": "لوتس, لوتس مقدس (موطنه شرق آسيا؛ يزرع على نطاق واسع لأزهاره الكبيرة الوردية أو البيضاء) / ختمية سورية, ورد شارون (شجيرة آسيوية أو شجرة شجيرية صغيرة ذات زهور وردية أو أرجوانية أو بيضاء مبهرجة على شكل جرس وأوراق ثلاثية الفصوص عادة؛ تزرع على نطاق واسع في أمريكا…) / خلية نحل, قفير (وعاء من صنع الإنسان يأوي سرباً من النحل) / حشد مزدحم, خلية (حشد يعج بالنشاط) / خَلِيَّةُ نَحْل (هيكل يوفر مسكناً طبيعياً للنحل؛ كما في شجرة مجوفة)",
 "はちすずめ": "طَنَّان, طَنَان",
 "はちすは": "بَذِيء",
 "はちすば": "بَذِيء",
 "はちどり": "طَنَّان, طَنَان",
 "はちのじ": "حركة الرقم ثمانية (شكل تزلج يرسم رقم 8 على الجليد) / عقدة الرقم ثمانية (عقدة لها شكل الرقم 8؛ تُربط في حبل تم تمريره عبر ثقب أو بكرة وتمنع الحبل من الانفلات) / شكل الرقم ثمانية (شكل ثنائي الأبعاد يشبه الرقم ثمانية)",
 "はちのす": "خَلِيَّة, قَفِير / جبنة سويسرية / القلنسوة, كرشة العسل (بطانة المعدة الثانية (الشبكية) للحيوانات المجترة تستخدم كطعام) / قالب التشكيل (كتلة حديدية مقطوعة بثقوب وأخاديد للمساعدة في تشكيل المعادن على البارد)",
 "はちのすい": "قَلَنْسُوَة (القُلُنْسُوَة: لباس داخلي للرأس يُلبس غالبا داخليا تحت العَمَامَة أو الكُوفِيَّة أو غيره من أغطية الرأس للرجال والنساء، يسمى أيضا الطَاقِيَّة؛ القُلُنْسُوَة: لباس للرأس يشبه الداخلي إلا أنه يلبس لوحده، قد يكون أبيضا وقد يكون مطرزا، يسمى أيضا الطَاقِيَّة)\nمثال: كان زيري يرتدي قلنسوة.",
 "はちぶ": "إقصاء, نبذ اجتماعي (فعل استبعاد شخص من المجتمع بإجماع عام) / إبعاد, نبذ (حالة النفي أو النبذ (الاستبعاد من المجتمع بموافقة عامة))\nمثال: يجب على الجمعية التخلص من أعضائها المسنين - ليس عن طريق القتل الرحيم بالطبع، ولكن عن طريق النبذ",
 "はちぶおんぷ": "ذات السن, نوتة ثمنية (نوتة موسيقية لها قيمة زمنية تعادل ثمن نوتة كاملة)",
 "はちぶんぎ": "ثُمْن, ثُمُن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن.",
 "はちぶんぎざ": "الثُّمْن, الثُّمُن",
 "はちぶんぎ座": "الثُّمْن, الثُّمُن",
 "はちへんけい": "مثمن",
 "はちほん": "ثَمَانِيَة, تمانية / ثَمَانِيَةٌ",
 "はちまき": "طَوْق شَعَر (وَضَعَ عليه طَوْقا؛ تَحَلَّقَ الناس أو الحيوانات أو غيرها حوله كالطوق، يستخدم تحلق إذا كان الأمر برضاه وطوّق إذا كان ذلك كرها)\nمثال: كلب زيري يحب ارتداء ذلك الطوق.",
 "はちまん": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "はちまんしせん": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "はちみつ": "عَسَل, شَهْد (عَسَل) / حَبِيبِي, عَزِيزَتِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / عَسَل, عَسُّولَة (عَسَل) / عَسَلِيّ\nمثال: يصنع النحل العسل.",
 "はちみついろ": "عَسَلِيّ اللَّوْن (ذو لون العسل)",
 "はちみつしゅ": "بِتْع (تباعد؛ صيّرَ)",
 "はちみつ色": "عَسَلِيّ اللَّوْن (ذو لون العسل)",
 "はちみつ酒": "بِتْع (تباعد؛ صيّرَ)",
 "はちめんたい": "ثماني السطوح (أي متعدد سطوح له ثمانية أوجه مستوية)",
 "はちめんれいろう": "بشاشة, دماثة (الميل لكون المرء ودوداً ويسهل التعامل معه)",
 "はちめんろっぴ": "جاك لجميع المهن",
 "はちもの": "بُونْسَاي",
 "はちゃめちゃ": "عَبَثِيّ, سَخِيف / الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ. / غير منضبط, فوضوي (غير منضبط ومشاكس) / عَشْوَائِيّ, فَوْضَوِيّ (غَيْرُ مُنَظَّمٍ تَمَامًا وَغَيْرُ مُتَوَقَّعٍ وَمُرْبِك) / مَقْلُوبٌ رَأْسًا عَلَى عَقِب, مُبَعْثَر (فِي فَوْضَى عَارِمَة)\nمثال: شباب مشاغبون",
 "はちゅう": "زَحَّافَة",
 "はちゅうりょうせいるいがく": "علم الزواحف والبرمائيات (فرع علم الحيوان المعني الزواحف والبرمائيات)",
 "はちゅうるい": "زَحَّافَة",
 "はちゅうるいがく": "علم الزواحف والبرمائيات (فرع علم الحيوان المعني الزواحف والبرمائيات)",
 "はちゅうるいがくしゃ": "عالم زواحف وبرمائيات (عالم حيوان يدرس الزواحف والبرمائيات)",
 "はちょう": "طُول مَوْج (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "はちろう": "شَمْع الْعَسَل ((شَمَعَ) يَشْمُعُ شَمْعًا، وشُمُوعًا: مَزَحَ وطَرِبَ)\nمثال: أشعل كين الشمع.",
 "はちわりがた": "إلى حد كبير, بشكل رئيسي (في جزء كبير؛ بشكل رئيسي أو أساسي) / بشكل عام, في الغالب (عادة؛ كقاعدة)\nمثال: هذه الحسابات غير نشطة إلى حد كبير",
 "はちわんるい": "أخطبوطيات (رأسيات الأرجل بثمانية أذرع ولكن تفتقر إلى صدفة داخلية)",
 "はち切れる": "انفجار (عملية الانفجار أو التفرقع) / فورة, نوبة (فورة مفاجئة من النشاط (غالباً لسبب غير واضح)) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: انفجار الألعاب النارية أيقظ الأطفال",
 "はち合わせる": "صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ) / مُلَاقَاة, مُقَابَلَة (لِقَاء)\nمثال: صادف مشكلا صعبا.",
 "はち蜜": "عَسَل, شَهْد (عَسَل) / حَبِيبِي, عَزِيزَتِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / عَسَل, عَسُّولَة (عَسَل) / عَسَلِيّ\nمثال: يصنع النحل العسل.",
 "はっ": "وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة! / بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "はっか": "نَعْنَاع, نعناع / تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة) / نبوءة (تنبؤ ينطق به تحت إلهام إلهي) / حَدْس صَائِب, فِرَاسَة (تخمين ناجح عن طريق بصيرة غير عادية أو حظ جيد) / إشعال, إضرام (عملية إضرام النار في شيء ما) / نظام إشعال (الآلية التي تشعل الوقود في محرك الاحتراق الداخلي) / إشعال, اتقاد (عملية بدء الاحتراق أو اشتعال النار) / إطلاق نار (فعل إطلاق النار من بندقية) / إقالة, تسريح (إنهاء توظيف شخص ما (وتركه حراً للمغادرة)) / إطلاق نار, رمي (فعل إطلاق الأسلحة أو المدفعية على عدو)\nمثال: تراجعوا في مواجهة نيران العدو الشديدة / مَادَّة تَبْيِيض (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / بَيَّضَ (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: لا أحب مادة العلوم. / برص, مهق (غياب خلقي للتصبغ في العينين والجلد والشعر)",
 "はっかく": "اكتشاف, رصد (فعل اكتشاف شيء ما؛ أو ملاحظة شيء ما) / تحري, كشف الجرائم (تحقيق للشرطة لتحديد الجاني) / استشعار, رصد (الإدراك بأن شيئاً ما قد حدث أو أن حالة ما موجودة) / كشف الإشارة (الكشف عن استقبال إشارة)\nمثال: التحري صعب على القدمين (يتطلب مشياً كثيراً) / مثمن / ليسوم حقيقي, ينسون نجمي",
 "はっかくういきょう": "ليسوم حقيقي, ينسون نجمي",
 "はっかくけい": "مثمن",
 "はっかげんしょう": "برص, مهق (غياب خلقي للتصبغ في العينين والجلد والشعر)",
 "はっかちょう": "مينة متوجة (طائر متوج بني داكن من جنوب شرق آسيا)",
 "はっかっけい": "مثمن",
 "はっかてん": "نقطة الوميض (أدنى درجة حرارة يمكن عندها إشعال بخار سائل قابل للاشتعال في الهواء) / نقطة الانفجار, نقطة الوميض (النقطة التي يكون عندها الشيء جاهزاً للانفجار)",
 "はっかとう": "نَعْنَاع فِلْفِلِيّ",
 "はっかのう": "منثول (غسول يحتوي على المنثول مما يعطيه رائحة النعناع) / منثول (مركب بلوري له طعم ورائحة النعناع الباردة ويوجد بشكل طبيعي في زيت النعناع الفلفلي؛ يستخدم كمنكه وفي الطب لتخفيف الحكة والألم واحتقان الأنف)",
 "はっかゆ": "زيت النعناع (زيت من نبات النعناع يستخدم للتنكيه)",
 "はっかん": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / مَنْشُور\nمثال: نشر توم الغسيل. / عَرَق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "はっかんざい": "مدر للعرق, معرق (محفز للتعرق) / معرق (يستخدم لإنتاج العرق)",
 "はっか糖": "نَعْنَاع فِلْفِلِيّ",
 "はっき": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه. / راية الهدنة, علم أبيض (علم يتكون من قطعة قماش بيضاء تُرفع للإشارة إلى الاستسلام أو لطلب الهدنة) / بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية)) / ابْتِدَائِيّ, انْطِلَاقِيّ (مُنَاسِبٌ لِبِدَايَةِ حَدَثٍ أَوِ انْطِلَاقَتِهِ) / جَاحِظ ((خاصة العيون) منتفخ أو بارز كما في حالة الخوف)\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى / عَزْم, عُزْم / دِقَّة",
 "はっきゅう": "إصدار, إطلاق (فعل توفير عنصر للاستخدام العام أو لأغراض رسمية (عادة بكميات))\nمثال: إصدار جديد من الطوابع",
 "はっきゅうをおう": "لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس.",
 "はっきょう": "جُنُون",
 "はっきり": "بوضوح (بدون شك أو تساؤل) / بشكل متميز, بوضوح (واضح للعقل؛ بتمييز عقلي واضح) / بشكل مفهوم, بوضوح (بطريقة يمكن فهمها) / بِوُضُوح (بطريقة يسهل إدراكها)\nمثال: كانوا تائهين بوضوح",
 "はっきん": "بَلَاتِين / بَلَاتِينُوم",
 "はっきんこく": "أسود البلاتين (مسحوق أسود ناعم من البلاتين؛ يستخدم كمحفز في التفاعلات الكيميائية)",
 "はっくしょん": "أَتْشُو",
 "はっくつ": "استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض) / تنيقب, حفر (فعل الحفر) / حفر, حفرية (حفرة في الأرض ناتجة عن الحفر) / حفرية, موقع أثري (موقع الاستكشاف الأثري)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون / اِكْتِشَاف",
 "はっくつちょうさ": "استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض) / تنيقب, حفر (فعل الحفر) / حفر, حفرية (حفرة في الأرض ناتجة عن الحفر) / حفرية, موقع أثري (موقع الاستكشاف الأثري)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون",
 "はっくのげきをすぐるがごとし": "الْوَقْتُ يَمْضِي",
 "はっくぶ": "تَقْرِيبًا",
 "はっけ": "تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة) / نبوءة (تنبؤ ينطق به تحت إلهام إلهي) / حَدْس صَائِب, فِرَاسَة (تخمين ناجح عن طريق بصيرة غير عادية أو حظ جيد)",
 "はっけいろじん": "الروسية البيضاء, اللغة البيلاروسية (اللغة السلافية التي يتم التحدث بها في بيلاروسيا) / وايت راشن (كوكتيل مصنوع من الفودكا وليكير القهوة والحليب أو الكريمة) / بيلاروسي, روسي أبيض (مواطن أو ساكن في بيلاروسيا)",
 "はっけいロシアじん": "الروسية البيضاء, اللغة البيلاروسية (اللغة السلافية التي يتم التحدث بها في بيلاروسيا) / وايت راشن (كوكتيل مصنوع من الفودكا وليكير القهوة والحليب أو الكريمة) / بيلاروسي, روسي أبيض (مواطن أو ساكن في بيلاروسيا)",
 "はっけっきゅう": "كُرَيَّةُ دَمٍ بَيْضَاءُ, خَلِيَّةُ دَمٍ بَيْضَاءُ",
 "はっけっきゅうげんしょう": "نقص الكريات البيض (انخفاض غير طبيعي في عدد خلايا الدم البيضاء)",
 "はっけっきゅうげんしょうしょう": "نقص الكريات البيض (انخفاض غير طبيعي في عدد خلايا الدم البيضاء)",
 "はっけっきゅうぞうか": "كثرة الكريات البيض (زيادة غير طبيعية في عدد خلايا الدم البيضاء في الدم نتيجة للعدوى)",
 "はっけっきゅうぞうかしょう": "كثرة الكريات البيض (زيادة غير طبيعية في عدد خلايا الدم البيضاء في الدم نتيجة للعدوى)",
 "はっけつびょう": "سَرَطَان دَم",
 "はっけん": "إصدار, إطلاق (فعل توفير عنصر للاستخدام العام أو لأغراض رسمية (عادة بكميات))\nمثال: إصدار جديد من الطوابع / اِكْتِشَاف",
 "はっけんき": "حساس, كاشف (أي جهاز يستقبل إشارة أو محفزاً (مثل الحرارة أو الضغط أو الضوء أو الحركة) ويستجيب له بطريقة مميزة) / كاشف (معدات إلكترونية تكشف عن وجود إشارات راديو أو نشاط إشعاعي) / كاشف, مزيل التعديل (مقوم يستخرج التعديل من موجة حاملة لاسلكية)",
 "はっけんしゃ": "مُكْتَشِف",
 "はっけんてき": "إرشادي",
 "はっけんりょう": "رسم الإيجاد, عمولة الوساطة (رسم يُدفع لشخص يجد مصدراً للدعم المالي أو لشخص يجمع الناس معاً لأغراض العمل)\nمثال: حصلت الوكالة على عمولة وساطة عندما تم تعيين مرشحهم كرئيس تنفيذي جديد",
 "はっこう": "إصدار, انبعاث (فعل الإصدار؛ التسبب في التدفق للخارج) / انبعاث, خروج (حدوث تدفق للماء (كما من أنبوب)) / إفراز, انبعاث (أي من العمليات الجسدية العديدة التي تخرج بموجبها المواد من الجسم) / انبعاث (إطلاق الإلكترونات من الذرات الأم)\nمثال: خروج الصديد / نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / مَنْشُور\nمثال: نشر توم الغسيل. / عَدَد (مِقْدَار مَا يُعَدّ) / مُشْكِل, مَسْأَلَة\nمثال: كم عدد سكان الجزائر؟ / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع) / مُتَزَايِد, مُرْتَفِع (يزداد في الكمّيّة أو القيمة) / تنشئة, رعاية (الخصائص المكتسبة نتيجة للطريقة التي عوملت بها كطفل) / ارتفاع, رفع (حدث رفع شيء ما إلى الأعلى)\nمثال: ارتفاع في درجة الحرارة بعد الظهر / تخمر (عملية يسبب فيها عامل ما تحلل مادة عضوية إلى مواد أبسط؛ وخاصة التحلل اللاهوائي للسكر إلى كحول) / غليان, قلق (حالة من الهياج أو التغيير المضطرب أو التطور)\nمثال: أنتج الغليان السياسي قيادة جديدة / غَيْر مُبَشِّر, مَشْؤُوم (غير مبشر؛ ينذر بالسوء) / غَيْر مُلَائِم, مُؤْسِف (غَيْر مُنَاسِب أَوْ مُؤْسِف الاخْتِيَار) / سيء الحظ, مؤسف (غير مفضل من قبل الحظ؛ يتسم أو يرافقه أو ينتج عنه سوء طالع) / بائِس, سَيِّئ الحَظّ (شخص يعاني من سوء الحظ أو المصائب)\nمثال: تحول مؤسف للأحداث / رَحِيل, مُغَادَرَة / كورونا (سيجار طويل بنهايات غير حادة) / إِكْلِيل ((في التشريح) أي بنية تشبه التاج في شكلها) / إكليل الشمس, هالة شمسية (المنطقة الخارجية لغلاف الشمس الجوي؛ مرئية كهالة بيضاء أثناء الكسوف الشمسي) / هالة (دائرة واحدة أو أكثر من الضوء تُرى حول جسم مضيء)",
 "はっこうがく": "علم التخمير (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "はっこうしゃ": "جهة إصدار, مُصدِر (مؤسسة تصدر شيئاً ما (أوراق مالية أو منشورات أو عملة وما إلى ذلك))",
 "はっこうしゅ": "خَمِيرَة",
 "はっこうしょ": "دَار نَشْر, نَشْر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "はっこうじょ": "دَار نَشْر, نَشْر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "はっこうずみ": "عَدَد (مِقْدَار مَا يُعَدّ) / مُشْكِل, مَسْأَلَة\nمثال: كم عدد سكان الجزائر؟",
 "はっこうそ": "خَمَرَ (شَرَابُ الْعِنَبِ إِذَا اخْتَمَرَ؛ كُلُّ مُسْكِرٍ مُخَامِرٍ لِلْعَقْلِ، إِذَا كَانَ شَرَاباً كُحُولِيّاً أَوْ غَيْرَهُ)\nمثال: أنت تشرب الخمر.",
 "はっこうにん": "جهة إصدار, مُصدِر (مؤسسة تصدر شيئاً ما (أوراق مالية أو منشورات أو عملة وما إلى ذلك))",
 "はっこうぶすう": "انتشار, تداول (انتشار أو نقل شيء ما (كالأخبار أو المال) إلى مجموعة أو منطقة أوسع) / توزيع, نشر (توزيع نسخ من الدوريات (مثل الصحف أو المجلات)) / دوران, سريان (حركة حرة أو مرور (كما في السيتوبلازم داخل الخلية أو النسغ عبر النبات)) / دوران, دورة دموية (الحركة عبر دائرة؛ وخاصة حركة الدم عبر القلب والأوعية الدموية)\nمثال: دوران المحيط جزء مهم من المناخ العالمي",
 "はっこうダイオード": "صمام ثنائي باعث للضوء, ليد (الصِّمَامُ : السِّدَادُ؛ الصِّمام : جهاز لضبط السوائل والغازات في أَوعيتها وتنظيم انسيابها في اتِّجاه دون آخر)\nمثال: فتح سامر صمام المياه.",
 "はっこく": "الْبَرَازِيل / كونتِيّة / مُحَافَظَة, مُقَاطَعَة (تقسيم إداري في أرض دولة؛ المؤنث من \"مُحَافَظ\")\nمثال: نشأت ليلى في بلدة محافظة.",
 "はっこつ": "هَيْكَل عَظْمِيّ, هَيْكَل",
 "はっこん": "تجذير (عملية إخراج الجذور والبدء في النمو)",
 "はっさい": "تَفَشٍّ",
 "はっさん": "إصدار, انبعاث (فعل الإصدار؛ التسبب في التدفق للخارج) / انبعاث, خروج (حدوث تدفق للماء (كما من أنبوب)) / إفراز, انبعاث (أي من العمليات الجسدية العديدة التي تخرج بموجبها المواد من الجسم) / انبعاث (إطلاق الإلكترونات من الذرات الأم)\nمثال: خروج الصديد / تصريف, تنفيس (فعل التنفيس أو الإخراج) / تباعد, تشعب (عملية الابتعاد في اتجاهات مختلفة عن نقطة مشتركة) / تَبَايُن, تَضَارُب (اختلاف بين حقائق أو ادعاءات أو آراء متعارضة) / تَبَاعُد (متسلسلة لا نهائية ليس لها حد) / اختلاف, انحراف (اختلاف ينحرف عن المعيار أو القاعدة)\nمثال: تتشكل الزاوية من تباعد خطين مستقيمين",
 "はっしゃ": "إطلاق نار (فعل إطلاق النار من بندقية) / إقالة, تسريح (إنهاء توظيف شخص ما (وتركه حراً للمغادرة)) / إشعال, إضرام (عملية إضرام النار في شيء ما) / إطلاق نار, رمي (فعل إطلاق الأسلحة أو المدفعية على عدو)\nمثال: تراجعوا في مواجهة نيران العدو الشديدة / قَذْف (بمعنى رَمَى؛ قذَف بالحقّ: أمر به وأبانه) / رَحِيل, مُغَادَرَة\nمثال: バスは五分後に発車します。 — ستنطلق الحافلة بعد خمس دقائق.",
 "はっしゃじょう": "موقع إطلاق (مكان لمنصات الإطلاق)",
 "はっしゃだい": "منصة إطلاق (منصة تطلق منها الصواريخ أو المركبات الفضائية)",
 "はっしゃとう": "قاذفة إقلاع, منجنيق (جهاز يطلق الطائرات من على متن سفينة حربية) / قاذفة, منصة إطلاق (تسليح على شكل جهاز قادر على إطلاق صاروخ)",
 "はっしゃやく": "دَافِع, دَفْعِيّ (يميل إلى الدفع أو قادر عليه) / مادة دافعة, وقود دافع (أي مادة تقوم بالدفع)",
 "はっしゅう": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "はっしゅつ": "عَدَد (مِقْدَار مَا يُعَدّ) / مُشْكِل, مَسْأَلَة\nمثال: كم عدد سكان الجزائر؟",
 "はっしょう": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل",
 "はっしょうち": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "はっしょうのち": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "はっしょく": "تلوين, صباغة (عملية تغيير لون شيء ما) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه) / صبغة غذائية, ملون غذائي (مادة قابلة للهضم تستخدم لإعطاء لون للطعام)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء",
 "はっしょくだん": "حامل اللون, كروموفور (المجموعة الكيميائية التي تمنح اللون للجزيء)",
 "はっしん": "إرسال, إيفاد (فعل إرسال شيء ما) / إجهاز, قتل (قتل شخص أو حيوان (بسرعة)) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً) / برقية, بلاغ (تقرير رسمي (يرسل عادة على عجل))\nمثال: تم إنجازه بسرعة وكفاءة / إخبار, إعلام (فعل كلامي ينقل معلومات) / إبلاغ, وشاية (تقديم أدلة تدين شخصاً إلى ضابط القانون (عادة مقابل خدمات)) / تَذَبْذُب / طَفْح, طَفْح جِلْدِيّ / رَحِيل, مُغَادَرَة / بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية)) / ابْتِدَائِيّ, انْطِلَاقِيّ (مُنَاسِبٌ لِبِدَايَةِ حَدَثٍ أَوِ انْطِلَاقَتِهِ) / جَاحِظ ((خاصة العيون) منتفخ أو بارز كما في حالة الخوف)\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى",
 "はっしんおん": "نَغْمَة, نَغْم",
 "はっしんがわ": "مُرْسِل, مُرْسِلَة",
 "はっしんき": "مذبذب (مولد ينتج ذبذبات صوتية أو تياراً متردداً) / نَاقِل",
 "はっしんげん": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "はっしんしゃ": "العقل المدبر, مُبْتَكِر (شخص يبتكر أو ينشئ أشياء جديدة)",
 "はっしんじこくひょうじ": "سيدة (صيغة خطاب للمرأة (دون تحديد الحالة الاجتماعية)) / مخطوطة (شكل العمل الأدبي المقدم للنشر) / ماجستير العلوم (درجة الماجستير في العلوم) / تصلب متعدد (اضطراب عصبي تدريجي مزمن ينطوي على فقدان غمد المايلين حول ألياف عصبية معينة)",
 "はっしんち": "مسقط الرأس, منشأ (المكان الذي نشأ فيه شيء ما أو تمت رعايته في بداية وجوده)\nمثال: مهد الحضارة",
 "はっしんねつ": "تيفوس الفئران, تيفوس متوطن (عدوى حادة تسببها الريكتسيا وتنتقل عن طريق لدغة برغوث مصاب؛ تتميز بالحمى والقشعريرة وآلام العضلات والطفح الجلدي)",
 "はっしんほう": "تدوين ثماني (أي تدوين رياضي يستخدم 8 أحرف مختلفة (عادة الأرقام من 0 إلى 7))",
 "はっしんもと": "العقل المدبر, مُبْتَكِر (شخص يبتكر أو ينشئ أشياء جديدة)",
 "はっする": "نَطَقَ بِ (بمعنى الحزام؛ تحريف نُطْق. )\nمثال: يسهل نطق اسم توم / عَدَد (مِقْدَار مَا يُعَدّ) / مُشْكِل, مَسْأَلَة\nمثال: كم عدد سكان الجزائر؟ / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / حَدَثَ, وَقَعَ (وَقَعَ الأمر؛ نقيض قَدُمَ، كان حَدِيثا)\nمثال: لا أصدق ما حدث.",
 "はっせい": "حُدُوث / جِيل, نَسْل / جِيل / تطور, نشوء ((علم الأحياء) عملية نمو الكائن الفردي عضويًا؛ تكشف بيولوجي بحت للأحداث المتضمنة في تغير الكائن الحي تدريجيًا من مستوى بسيط إلى مستوى أكثر تعقيدًا)\nمثال: اقترح مؤشرًا للتطور العظمي عند الأطفال / تصويت, تلفظ (استخدام الأصوات المنطوقة للاتصال السمعي) / تصدأ, صدأ (تكوّن أكاسيد الحديد ذات اللون البني المحمر على الحديد عن طريق الأكسدة في درجات حرارة منخفضة بوجود الماء)",
 "はっせいがく": "علم الأجنة (فرع علم الأحياء الذي يدرس تكوين وتطور الكائنات الحية في مراحلها المبكرة)",
 "はっせいがくしゃ": "أخصائي علم الأجنة (طبيب متخصص في علم الأجنة)",
 "はっせいきかん": "عضو نطق (أي من الأعضاء المشاركة في إنتاج الكلام)",
 "はっせいげん": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "はっせいじゅん": "مُرَتَّب زَمَنِيَّا (المَوْضوع في مَرْتبتِه؛ ما بدا عليه التَّرتيب)\nمثال: شعر توم ممشوط و مرتب.",
 "はっせいほう": "لَفْظ, نَطْق (نَطَقَ، تَكَلَّمَ؛ أَخْرَجَ، رَمَى) / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية) / تَشْكِيل\nمثال: هذه الكلمة صعبة اللفظ.",
 "はっせいりつ": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "はっせきやく": "دواء محمر للجلد (دواء للاستخدام الخارجي ينتج احمراراً في الجلد)",
 "はっせん": "ثَمَانِيَة آلَاف / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "はっせんねん": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "はっそう": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة. / اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني. / تَعْبِير / تَعْبِير, عِبَارَة / سِيمَاء / إرسال, بعث (فعل التسبب في ذهاب شيء ما (خاصة الرسائل)) / نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "はっそうさき": "وِجْهَة, وُجْهَة",
 "はっそうしゃ": "شركة شحن (شركة تعمل في مجال شحن البضائع) / شاحن (شخص يقوم بشحن البضائع)",
 "はっそうでん": "استطاعة كهربائية, قدرة كهربائية (حاصل ضرب الجهد في التيار)",
 "はっそうりょく": "إبداع, عبقرية (قوة الخيال الإبداعي)",
 "はっそく": "بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية)) / ابْتِدَائِيّ, انْطِلَاقِيّ (مُنَاسِبٌ لِبِدَايَةِ حَدَثٍ أَوِ انْطِلَاقَتِهِ) / جَاحِظ ((خاصة العيون) منتفخ أو بارز كما في حالة الخوف)\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى",
 "はったおす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "はったつ": "إِعْمَار, تَعْمِير / تَقَدُّم / تَمَدُّد / تَوَسُّع",
 "はったつしんりがく": "علم النفس النمائي, علم نفس الطفل (فرع علم النفس الذي يدرس التطور الاجتماعي والعقلي للأطفال)",
 "はったつでこぼこ": "تَنَوُّع عَصَبِيّ",
 "はったと": "فَجْأَةً / بحدة, بعدوانية (بطريقة عدوانية) / بشكل حاد, بوضوح (بطريقة محددة بوضوح) / بشكل حاد, بشكل مفاجئ (بشكل مفاجئ جداً وبدرجة كبيرة) / بحدة, بزاوية حادة (تغير مفاجئ في الاتجاه والدرجة)\nمثال: كانت تُستجوب بحدة / تَمَامًا",
 "はったり": "خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك) / صَرِيح, طَيِّب القَلْب (مُبَاشِر وَصَرِيح فِي الكَلَام لَكِنْ بِطِيبَة قَلْب) / شَاهِق, عَمُودِيّ تَقْرِيبًا (شديد الانحدار؛ ذو واجهة بارزة وشبه عمودية) / خداع, مخادعة (تظاهر بأن موقفك أقوى مما هو عليه في الواقع)\nمثال: نجحت مخادعته في قبوله",
 "はっちゃ": "صيحة ابتهاج (صيحة عالية تعبر عن الابتهاج أو الإثارة)",
 "はっちゃくえき": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "はっちゃくじょ": "رصيف إنزال, مرسى (هيكل يوفر مكاناً يمكن للقوارب فيه إنزال الأشخاص أو البضائع)",
 "はっちゅう": "ترتيب, نظم (فعل وضع الأشياء في ترتيب تسلسلي) / ترتيب, نظام (ترتيب منطقي أو مفهوم لعناصر منفصلة)\nمثال: كانت هناك أخطاء في ترتيب العناصر في القائمة",
 "はっちゅうしゃ": "منظم, منهجي (منظم يضع الأشياء في ترتيب) / طالب بضاعة, مقدم الطلب (شخص يقدم طلباً للشراء)\nمثال: كان أرسطو منظماً عظيماً للأفكار",
 "はっちゅうしょ": "أمر شراء, طلب شراء (وثيقة تجارية تستخدم لطلب توريد شيء ما من شخص مقابل الدفع وتوفر المواصفات والكميات)\nمثال: تلقت شركة آي بي إم طلباً لمائة حاسوب",
 "はっちょう": "براعة, مهارة (حالة كونه ماهراً معرفياً)",
 "はっつけ": "صَلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "はっつけばしら": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "はっていく": "زحف (طريقة تنقل بطيئة على اليدين والركبتين أو بجر الجسم) / حظيرة صغار الحيوانات (حظيرة مسيجة بحيث يمكن لصغار الحيوانات دخولها ولكن لا يمكن للكبار ذلك) / زحف (حركة طولية بطيئة أو تشوه بطيء) / شخص منفر, غريب الأطوار (شخص غريب بشكل مزعج أو شاذ)\nمثال: كان الزحف هو كل ما استطاع الرجل المصاب القيام به",
 "はってん": "إِعْمَار, تَعْمِير",
 "はってんか": "مُسْتَهْتَر",
 "はってんけい": "اِخْتِلَاف",
 "はってんせい": "اِحْتِمَال (ما يكمن توقع حدوثه. يقول الجرجاني: «الاحتمال ما لا يكون تصور طرفيه كافيًا، بل يتردد في النسبة بينهما، ويراد به الإمكان الذهني») / إِمْكَانِيَّة\nمثال: هناك احتمال أن لا ينجح.",
 "はってんてき": "مُتَخَلِّف, نَامٍ (يتعلق بمجتمعات يشحّ فيها رأس المال اللازم للتصنيع) / تحميض, تظهير (معالجة مادة حساسة للضوء لجعل الصورة مرئية)\nمثال: استغرق تحميض وطباعة صوره ساعتين فقط",
 "はってんとじょう": "مُتَخَلِّف, نَامٍ (يتعلق بمجتمعات يشحّ فيها رأس المال اللازم للتصنيع) / تحميض, تظهير (معالجة مادة حساسة للضوء لجعل الصورة مرئية)\nمثال: استغرق تحميض وطباعة صوره ساعتين فقط",
 "はってんとじょうこく": "دَوْلَة نَامِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "はって行く": "زحف (طريقة تنقل بطيئة على اليدين والركبتين أو بجر الجسم) / حظيرة صغار الحيوانات (حظيرة مسيجة بحيث يمكن لصغار الحيوانات دخولها ولكن لا يمكن للكبار ذلك) / زحف (حركة طولية بطيئة أو تشوه بطيء) / شخص منفر, غريب الأطوار (شخص غريب بشكل مزعج أو شاذ)\nمثال: كان الزحف هو كل ما استطاع الرجل المصاب القيام به",
 "はっと": "فَجْأَةً / نخير, نفخ (فعل الزفير بقوة) / نفث الدخان (نفخ دخان التبغ في الهواء)\nمثال: لقد ملأوا الغرفة بالدخان بنفثهم المستمر / حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ) / حَظْر ((حَظَّرَ): بالغ في الحظر) / مَنْع (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: حرم الإسلام الترويع / قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "はっとう": "تَفَشٍّ",
 "はっはっ": "هَاهَا, هِهِهِهِ / لهاث (التنفس بصعوبة وثقل (كما يحدث بعد المجهود)) / قماش البناطيل (أي قماش يستخدم لصنع السراويل)",
 "はっぱ": "كَارِثِيّ, مُهْلِك (يُسَبِّبُ الأَذَى أَوِ الآفَةَ؛ يُصِيبُ بِعُنْفٍ مُفَاجِئٍ أَوْ وَبَاءٍ) / زَاعِق, صَاخِب (عالٍ بشكل مزعج ونافذ) / وَرَقَة, وَرَقة / صَحِيفَة / مَارِهْوَانَا, حَشِيش",
 "はっぴゃく": "ثَمَانِيمِئَة, ثَمَانِيمِا۟ئَة / جماهير, جموع (عامة الناس بشكل عام) / جمهور, حشد كبير (تجمع كبير للناس) / جموع, حشد (كمية كبيرة غير محددة)\nمثال: افصل المحاربين عن الجموع",
 "はっぴょう": "إِعْلَان, بَلَاغ",
 "はっぴょうかい": "حَيْثِيَّة / إِرَاءَة / إِهْدَاء, مَنْح",
 "はっぴょうしゃ": "مُذِيع, مُذِيعَة",
 "はっぷ": "مَنْسُور, مُنَادَاة / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "はっぽう": "رَغْوِيّ, مُزْبِد (يُنْتِج أو يُغَطّى بِرَغْوَة مِن العَرَق أو اللُّعاب بِسَبَب الإرْهاق أو المَرَض) / رَغْوِيّ, فَقَّاعِيّ (يُصدر فقاعات أو مليء بها كما في المشروبات الغازيّة أو التخمير) / إطلاق نار (فعل إطلاق النار من بندقية) / إقالة, تسريح (إنهاء توظيف شخص ما (وتركه حراً للمغادرة)) / إشعال, إضرام (عملية إضرام النار في شيء ما) / إطلاق نار, رمي (فعل إطلاق الأسلحة أو المدفعية على عدو)\nمثال: تراجعوا في مواجهة نيران العدو الشديدة",
 "はっぽうおん": "إطلاق نار, نيران (فعل إطلاق النار من سلاح)\nمثال: عرض إطلاق النار المارة الأبرياء للخطر",
 "はっぽうしゅ": "نبيذ فوار (نبيذ ذو فوران غازي)",
 "はっぽうせい": "رغوية, فوران (خاصية إطلاق فقاعات) / فوران (عملية ظهور فقاعات أثناء خروج الغاز)",
 "はっぽうびじん": "إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل) / تابع, خادم ذكر (خادم ذكر (خاصة تابع))"
}
