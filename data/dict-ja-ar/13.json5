 "はいほう": "حويصلة هوائية, سنخ (كيس صغير جداً لحمل الهواء في الرئتين؛ يتكون من التوسع النهائي للممرات الهوائية…)",
 "はいほうえん": "التهاب الأسناخ (التهاب الأسناخ في الرئتين الناتج عن استنشاق الغبار؛ مع التعرض المتكرر قد تصبح…)",
 "はいぼう": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "はいぼく": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "はいぼくしゃ": "خَاسِر",
 "はいぼくしゅぎ": "انهزامية (قبول حتمية الهزيمة)",
 "はいぼくしゅぎしゃ": "انهزامي, سلبي (شخص يستسلم للهزيمة دون تقديم اقتراحات إيجابية)",
 "はいまく": "برقع, غشاء جنيني (الغشاء الداخلي للأجنة في الفقاريات العليا (خاصة عندما يغطي الرأس عند الولادة))",
 "はいめつ": "نَخْر",
 "はいめん": "خَلْفِيّ",
 "はいめんとび": "قفزة فوسبري (القفز فوق العارضة للخلف والرأس أولاً)",
 "はいやく": "اختيار الممثلين, توزيع الأدوار (اختيار الممثلين للعب أدوار معينة في مسرحية أو فيلم)",
 "はいやま": "حَائِط, جِدَار",
 "はいゆう": "مُمَثِّل, مُمَثِّلَة",
 "はいよ": "مَغْلُوب / بشكل حسن, على ما يرام (بطريقة مرضية أو كافية)\nمثال: ستبلي حسناً بمفردها",
 "はいよう": "فص الرئة (أي من الفصوص الثلاثة للرئة اليمنى أو الفصين للرئة اليسرى) / ارتداء, لبس (فعل وضع شيء على الجسم كغطاء أو زينة)\nمثال: اشترته للارتداء اليومي / طبقة جرثومية, طبقة منتشة ((في علم الأجنة) أي من طبقات الخلايا الثلاث التي تتمايز في الأجنة بعد عملية…)",
 "はいようそ": "آيِلٌ لِلتَّقَادُمِ (في طريقه إلى أن يصبح متقادماً وعتيقاً)",
 "はいらん": "إباضة, تبويض (طرد البويضة من المبيض (عادة في منتصف الدورة الشهرية))",
 "はいり": "اغتراب, جفاء (الشعور بالغربة عن الآخرين) / سَخَافَة",
 "はいりきる": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ)",
 "はいりくち": "دُخُول",
 "はいりぐち": "دُخُول",
 "はいりこむ": "اِخْتَرَقَ",
 "はいりほう": "الإثبات بالخلف, برهان الخلف (دحض عن طريق إظهار أن عواقب الاقتراح سخيفة؛ أو إثبات اقتراح عن طريق إظهار أن…)",
 "はいりょ": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "はいりょう": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "はいる": "أَدْخَلَ\nمثال: دخل توم المبنى. / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر. / شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ…)\nمثال: شغل بيل التلفاز. / صُورَة, شَكْل\nمثال: اجلس بشكل مريح. / نَفْي, تَبْعِيد",
 "はいれい": "عَصَى / عِبَادَة\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "はいれつ": "توزيع موسيقي (فعل ترتيب وتكييف قطعة موسيقية) / مُتَتَالِيَة, مُتَوَالِيَة / مَصْفُوفَة",
 "はいろ": "يَلٰجَأَ",
 "はいろう": "رواق الكنيسة, نارثكس (دهليز يؤدي إلى صحن الكنيسة)",
 "はいガス": "أبخرة العادم, عادم (غازات منبعثة من محرك كمنتجات نفايات)",
 "はい上がる": "هَزَمَ, غَلَبَ",
 "はい芽": "جُرْثُومَة",
 "はう": "زَحَفَ, دَبَّ (تَقَدَّمَ على الأرضِ معتمداً على بطنه دون استخدامٍ للأطراف؛ الشيءُ: تَقَدَّمَ…)\nمثال: زحف سامي عبر نافذته. / تلوّي, تململ (عملية التلوّي أو التململ) / جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي.",
 "はうちわかえで": "قيقب البدر, قيقب ياباني (أوراق محززة بعمق وحمراء زاهية في الخريف؛ اليابان)",
 "はえ": "رياح جنوبية (رياح تهب من الجنوب) / صَيْف, صيف (فصل من فصول السنة الأربعة، يلي الرَّبِيع ويأتي بعده الخَرِيف، يتميز بشدة الحَرّ)\nمثال: نأتي هنا كل صيف. / ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة)\nمثال: أمسك بتلك الذبابة. / جلي, دعك (فعل تنظيف سطح بفركه بفرشاة وصابون وماء) / منوة (سمكة مياه عذبة أوروبية صغيرة جداً شائعة في الجداول الحصوية) / مَجْد, جَلَال (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد…)\nمثال: المجد لأوكرانيا",
 "はえある": "بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين)\nمثال: مسيرة مهنية طويلة ومجيدة",
 "はえき": "رافدة سقف (واحدة من عدة عوارض مائلة متوازية تدعم السقف)",
 "はえぎわ": "خط الشعر, منبت الشعر (الحد الطبيعي الذي يشكله الشعر على الرأس)",
 "はえざ": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة)\nمثال: أمسك بتلك الذبابة.",
 "はえたたき": "مضرب الذباب, منشة ذباب (أداة ذات جزء مسطح (من شبكة أو بلاستيك) ومقبض طويل؛ تستخدم لقتل الحشرات)",
 "はえでる": "نَبْتَة",
 "はえとり": "مصيدة ذباب (فخ لصيد الذباب)",
 "はえとりがみ": "ورق صائد الذباب (ورق مسمم أو مطلي بمادة لزجة لقتل الذباب)",
 "はえとりぐさ": "خناق الذباب, ديونية (نبات آكل للحوم من السهول الساحلية في كارولينا له نصال أوراق حساسة ذات مفصلات…)",
 "はえとりそう": "خناق الذباب, ديونية (نبات آكل للحوم من السهول الساحلية في كارولينا له نصال أوراق حساسة ذات مفصلات…)",
 "はえぬき": "ابْنُ البَلَد, مَوْلُودٌ فِي البَلَد (يَنْتَمِي إِلَى مَكَانٍ بِحُكْمِ الوِلَادَةِ فِيهِ) / مُنْذُ البِدَايَة",
 "はえる": "نَمَى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟ / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح. / لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "はえー": "عميق\nمثال: صام ياني رمضان. / بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ)\nمثال: وصل السيد باكر. / سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع)\nمثال: رضيع مبتسر / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "はえ出る": "نَبْتَة",
 "はえ座": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة)\nمثال: أمسك بتلك الذبابة.",
 "はおう": "مُسْتَبِدّ, جَبَّار",
 "はおうじゅ": "صَبَّار",
 "はおうりゅう": "تيرانوصور, تيرانوصور ريكس (ديناصور لاحم كبير ثنائي الأرجل له أسنان ضخمة ذات حواف مسننة تشبه السكاكين؛ ربما…)",
 "はおと": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / بارع, جهبذ (شخص يتمتع بمهارة مذهلة في أي مجال)",
 "はおる": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "はか": "بلوغ (وقت الحياة الذي تصبح فيه الغدد الجنسية وظيفية) / اِفْتَضَّ, تَصَرُّف / نَعْنَاع, نعناع / قَبْر, ضَرِيح (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: زار توم قبر ماري. / تَقَدُّم / اِخْتِرَاق (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "はかあな": "قَبْر, ضَرِيح (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: زار توم قبر ماري.",
 "はかい": "تَدْمِير, هَدْم / حَادِث إِصْطِدَام\nمثال: يوشك الجسر على الانهيار.",
 "はかいかつどう": "تخريب, تقويض (فعل التقويض؛ مثل الإطاحة بحكومة شرعية أو تدميرها)",
 "はかいこうさく": "أَعْمَال تَخْرِيبِيَّة, تَخْرِيب (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما…)\nمثال: أنا في رحلة أعمال.",
 "はかいし": "شاهد القبر (حجر يستخدم لتحديد مكان القبر)",
 "はかいしゃ": "مُدَمِّر",
 "はかいそちめいれい": "إرداء بالرصاص (القتل بإطلاق النار على شخص بدم بارد)",
 "はかいてき": "مدمر, هدام (يسبب دماراً أو ضرراً كبيراً)\nمثال: سياسة هدامة للاقتصاد",
 "はかいぶんし": "تَخْرِيبِيّ, مُتَمَرِّد (مُعَارِض لِسُلْطَة مَدَنِيَّة أَوْ حُكُومَة)",
 "はかがいく": "يقرب",
 "はかがゆく": "يقرب",
 "はかが行く": "يقرب",
 "はかき": "بُلُوغ",
 "はかく": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ / شَاذّ, غَيْر مُنْتَظِم",
 "はかしょ": "مَقْبَرَة, مَقْبُرَة",
 "はかじるし": "شاهد القبر (حجر يستخدم لتحديد مكان القبر)",
 "はかす": "لوحة تذكارية نحاسية, لوحة معدنية (نصب تذكاري مصنوع من النحاس الأصفر)",
 "はかせごう": "درجة الدكتوراه, دكتوراه (واحدة من أعلى الدرجات الأكاديمية التي تمنحها الجامعة)",
 "はかせろんぶん": "أطروحة الدكتوراه (بحث رسمي طويل يكتبه المرشح لدرجة الدكتوراه في الجامعة)",
 "はかち": "جبانة, مدفن (قطعة أرض تستخدم للدفن)",
 "はかどころ": "مَقْبَرَة, مَقْبُرَة",
 "はかどる": "يقرب",
 "はかない": "خَاطِف, عَابِر (يَدوم لِفَتْرَة قَصيرَة جِدًّا) / فَارِغ",
 "はかなくなる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "はかば": "مَقْبَرَة, مَقْبُرَة",
 "はかばかしい": "سَرِيع\nمثال: ينبح كلب في الحي.",
 "はかびょう": "فصام غير منتظم, فصام مراهقة (شكل من أشكال الفصام يتميز بتفكك شديد للشخصية، بما في ذلك الكلام المضطرب…)",
 "はかほり": "حفار القبور (شخص يكسب عيشه من حفر القبور)",
 "はかま": "فستان سهرة قصير, فستان كوكتيل (فستان مناسب للمناسبات الرسمية) / وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "はかまじ": "تَنُّورَة, جُوب",
 "はからい": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "はからう": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / نَصَحَ (نصحه: أَرْشَدَه وأَشَارَ عليه)\nمثال: نصح مناد بباية.",
 "はからずも": "بالصدفة, عرضياً (بدون تخطيط مسبق)\nمثال: التقيا بالصدفة",
 "はかり": "مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / قياس (فعل أو عملية تعيين أرقام للظواهر وفقًا لقاعدة)\nمثال: تمت القياسات بعناية",
 "はかりごと": "خِطَّة, خُطَّة\nمثال: خطط زيري لهجومه.",
 "はかりしる": "فَرَضِيَّة, اِفْتِرَاض (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف…)\nمثال: الحقائق تؤكد هذه الفرضية.",
 "はかりしれない": "غَيْرُ قَابِلٍ لِلسَّبْر (يستحيل فهمه واستيعابه بالكامل)",
 "はかりめ": "وَزْن\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "はかり知る": "فَرَضِيَّة, اِفْتِرَاض (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف…)\nمثال: الحقائق تؤكد هذه الفرضية.",
 "はかり知れない": "غَيْرُ قَابِلٍ لِلسَّبْر (يستحيل فهمه واستيعابه بالكامل)",
 "はかる": "نَاقَشَ, بَحَثَ / قِيَاس\nمثال: قاس طول السرير. / فَرَضِيَّة, اِفْتِرَاض (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف…)\nمثال: الحقائق تؤكد هذه الفرضية. / خِطَّة, خُطَّة\nمثال: خطط زيري لهجومه. / حَبْكَة / بَحَثَ, طَلَبَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث. / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "はがい": "أجنحة (وسيلة للطيران أو الصعود (مجازياً))\nمثال: الضرورة تعطي أجنحة للإلهام",
 "はがいじめ": "نيلسون كامل (مسكة مصارعة يضع فيها الحامل كلا ذراعيه تحت ذراعي الخصم ويضغط على الرقبة)",
 "はがき": "كَرْت بَرِيدِيّ / مذكرة, مذكرة داخلية (اقتراح أو تذكير مكتوب)",
 "はがため": "عضاضة, لهاية (أداة تستخدم ليمصها الرضيع أو يعض عليها لتهدئته) / أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "はがね": "فُولَاذ / سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها…)\nمثال: القلم أقوى من السيف.",
 "はがねいろ": "أزرق فولاذي (لون أزرق رمادي)",
 "はがま": "عَرِيض الحَافَّة ((عن القبّعات) ذو حافّة عريضة)",
 "はがみ": "صرير الأسنان",
 "はがゆい": "ضجر, عجول (قلق أو سريع الغضب تحت التأخير أو المعارضة)\nمثال: نافذ الصبر مع الطلاب الأبطاء",
 "はがれ": "تَقْشِير",
 "はき": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة. / مَطْمَح / تَدْمِير, هَدْم / إلغاء, فسخ (فعل النسخ؛ إلغاء رسمي أو قانوني) / انقلاب في الموقف, تحول تام (تغيير كبير في الموقف أو المبدأ أو وجهة النظر)\nمثال: تحول تام في السياسة الخارجية",
 "はきかえる": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "はきかける": "سَفُّود, سِيخ",
 "はきぐすり": "دواء مقيئ, مقيئ (دواء يحفز الغثيان والقيء)",
 "はきぐち": "تنفيس, مخرج (نشاط يحرر أو يعبر عن الطاقة الإبداعية أو العاطفة)\nمثال: لم يكن لديها مخرج آخر لمشاعرها",
 "はきけ": "غَثْيَان (جاشت النفس واضطربت واستعدت للقَيء؛ الاِشْمِئْزَاز والقَرَف)\nمثال: كنت أشعر بالغثيان.",
 "はきげ": "غَثْيَان (جاشت النفس واضطربت واستعدت للقَيء؛ الاِشْمِئْزَاز والقَرَف)\nمثال: كنت أشعر بالغثيان.",
 "はきすてる": "قَذَفَ نَفْسَهُ (بمعنى رَمَى؛ قذَف بالحقّ: أمر به وأبانه)",
 "はきだす": "تَقَيَّأَ, قَاءَ / زَفَرَ (زفَر الشَّخصُ : أخرج نفَسه من رئتيه بعد مدِّه إيّاه؛ أظهر تعبيرًا عن الحزن أو…) / أَنْفَقَ, صَرَفَ / مُخرَج\nمثال: لا تنس إخراج القمامة.",
 "はきだめ": "كومة خردة, كومة قمامة (تراكم للنفايات والمواد المهملة)",
 "はきちがえる": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / أَسَاء اَلْفَهْم, أَخْطَأَ\nمثال: كان خطأ حاسوبي.",
 "はきつわり": "غَثَيَان الحَمْل (جاشت النفس واضطربت واستعدت للقَيء؛ الاِشْمِئْزَاز والقَرَف)\nمثال: كنت أشعر بالغثيان.",
 "はきづわり": "غَثَيَان الحَمْل (جاشت النفس واضطربت واستعدت للقَيء؛ الاِشْمِئْزَاز والقَرَف)\nمثال: كنت أشعر بالغثيان.",
 "はきはき": "بخفَة",
 "はきふるし": "بَالٍ",
 "はきもどし": "استفراغ, تقيؤ (الفعل الانعكاسي لقذف محتويات المعدة عبر الفم)\nمثال: اشتكى من أن المدرسة كانت مجرد حفظ وترديد",
 "はきもどす": "تَقَيَّأَ, قَاءَ",
 "はきもの": "حِذَاء, مَشَّايَة (بمعنى الإزاء والجوار؛ النَعْل)\nمثال: أردت حذاء أحمر.",
 "はきゃく": "هَدْم (الثوبُ ٱلْخَلَقُ المُرَقَّعُ؛ الكِساءُ الذي ضُوعِفت رِقَاعُهُ)\nمثال: توم يرسم خطة لهدم المنزل.",
 "はきゅう": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "はきょう": "طَلَاق, تَطْلِيق\nمثال: طلق زيري زوجته.",
 "はきょく": "كَارِثَة, فَاجِعَة / اِنْهَار\nمثال: يوشك الجسر على الانهيار.",
 "はき口": "تنفيس, مخرج (نشاط يحرر أو يعبر عن الطاقة الإبداعية أو العاطفة)\nمثال: لم يكن لديها مخرج آخر لمشاعرها",
 "はき違える": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / أَسَاء اَلْفَهْم, أَخْطَأَ\nمثال: كان خطأ حاسوبي.",
 "はぎ": "برسيم الشجيرة, ليسبيديزا (نباتات شجيرية أو عشبية تستخدم على نطاق واسع للعلف وتحسين التربة وخاصة التبن في…) / أحمر داكن (لون أحمر يعكس القليل من الضوء) / قَصَبَة",
 "はぎごと": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "はぎしり": "صرير الأسنان",
 "はぎぞく": "برسيم الشجيرة, ليسبيديزا (نباتات شجيرية أو عشبية تستخدم على نطاق واسع للعلف وتحسين التربة وخاصة التبن في…)",
 "はぎめ": "دَرْز (درز:درزا تمكن من درز الدُّنْيَا؛ دَرِزَ الرجلُ، كفَرِح، وَكَذَلِكَ ذَرِزَ…)",
 "はぎょう": "هَيْمَنَة, سَيْطَرَة",
 "はぎれ": "أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء)",
 "はぎれいい": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ)",
 "はぎれがいい": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ)",
 "はぎれがよい": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ)",
 "はぎれがわるい": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "はぎれのいい": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ)",
 "はぎれのよい": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ)",
 "はぎれのわるい": "أَعْجَم, عَاجِز عَن التَّعْبِير (بدون أو محروم من استخدام الكلام أو الكلمات)\nمثال: بهائم عجماء",
 "はぎれよい": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ)",
 "はく": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة. / عَدَّ / الْبَرَازِيل / مِٱئَة, مِئَة / دكتوراه (دكتوراه تعتمد عادةً على 3 سنوات على الأقل من الدراسات العليا وأطروحة؛ وهي أعلى…) / مَعْرِض / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / أَفِكْس / إِقَامَة / فَشَّلَ, أحبط (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة…)\nمثال: فشل ياني مجددا. / سُمْعَة\nمثال: لا يعرض أي إنسان للتعذيب ولا للعقوبات أو المعاملات القاسية أو الوحشية أو الحاطة بالكرامة. / رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة. / نَبْض\nمثال: ضرب سامي زوجته. / حَرِير, إبْرِيسِم / تَقَيَّأَ, قَاءَ / نَفَثَ, أَصْدَرَ / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / اِعْتَرَفَ, أَقَرَّ / أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون…)\nمثال: هذا الكلب أبيض. / بوري مخطط (أهم أنواع البوري التجارية في شرق الولايات المتحدة) / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / بِلْجِيكَا / تلطيخ, رسم رديء (لوحة غير متقنة)\nمثال: كانت هناك لطخة على خده",
 "はくあ": "طَبْشُورَة",
 "はくあい": "مُنَظَّمَة خَيْرِيَّة",
 "はくあいか": "سَخِيّ ((سَخِيَ) سَخاً: كَانَ جوادًا كَرِيمًا؛ (سَخِيَت) نَفسه عَن الشَّيْء: تركته)\nمثال: هو سخي بأمواله.",
 "はくあいしゅぎしゃ": "سَخِيّ ((سَخِيَ) سَخاً: كَانَ جوادًا كَرِيمًا؛ (سَخِيَت) نَفسه عَن الشَّيْء: تركته)\nمثال: هو سخي بأمواله.",
 "はくあかん": "الْبَيْت الْأَبْيَض\nمثال: لنعد إلى البيت.",
 "はくあしつ": "ملاط, ملاط الأسنان (مادة عظمية متخصصة تغطي جذر السن) / طَبَاشِيرِيّ اللَّوْن (بلون الطباشير الأبيض)",
 "はくいのてんし": "مُمَرِّض\nمثال: هذا المرض قلبي.",
 "はくう": "ديمة, زخات مطر (فترة قصيرة من الهطول)\nمثال: توقفت المباراة بسبب زخة مطر قصيرة",
 "はくうんせき": "دولوميت (معدن فاتح اللون يتكون من كربونات الكالسيوم والمغنيسيوم؛ مصدر للمغنيسيوم؛ يستخدم…)",
 "はくうんも": "مُوسْكُوفِيّ",
 "はくえ": "شخص عادي, علماني (شخص ليس رجل دين وليس متخصصاً مهنياً)",
 "はくえんこう": "خام الرصاص الأبيض, سيروسيت (معدن يتكون من كربونات الرصاص وهو مصدر مهم للرصاص)",
 "はくか": "مَادَّة تَبْيِيض (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / برص, مهق (غياب خلقي للتصبغ في العينين والجلد والشعر)",
 "はくかげんしょう": "برص, مهق (غياب خلقي للتصبغ في العينين والجلد والشعر)",
 "はくかこたい": "أَمْهَق",
 "はくが": "تبحر, سعة اطلاع (معرفة علمية عميقة)",
 "はくがい": "اِضْطِهَاد",
 "はくがいしゃ": "مضطهد, معذب (شخص يقوم بتعذيب الآخرين أو التنكيل بهم)",
 "はくがく": "تبحر, سعة اطلاع (معرفة علمية عميقة)",
 "はくがくしゃ": "وَاسِع الاطلاع (واسِع: (اسم)؛ واسع: (اسم))\nمثال: أرض الله واسعة.",
 "はくがん": "إوز الثلج (الإوز الأزرق في الطور اللوني الأبيض)",
 "はくぎ": "لعبة حظ, لعبة قمار (لعبة تنطوي على المقامرة)",
 "はくぎょくろうちゅうのひととなる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "はくぎん": "فِضَّة (فِي : فِلِزّ أَبْيَض قَابِلٌ لِلسَّحب والطَّرْق والصَّقْل، من أكثر المواد…)\nمثال: يقدر القبايل الفضة أكثر من الذهب. / ثَلْج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه)\nمثال: سامي يحب الثلج.",
 "はくげきほう": "مِلَاط",
 "はくげんがく": "لِسَانِيَّات, عِلْم اللُّغَة",
 "はくこく": "الْبَرَازِيل / كونتِيّة\nمثال: نشأت ليلى في بلدة محافظة.",
 "はくさ": "أَثِيرِيّ, شَفَّاف (يَتَّسِمُ بِخِفَّةٍ وَرِقَّةٍ غَيْرِ مَعْهُودَة)",
 "はくさい": "ملفوف صيني (رأس ممدود من سيقان مقرمشة تشبه الكرفس وأوراق خضراء فاتحة) / استيراد (النشاط التجاري لشراء وجلب البضائع من دولة أجنبية)",
 "はくし": "كتاب أبيض, ورقة بيضاء (تقرير حكومي؛ يغلف عادة بغلاف أبيض) / بداية جديدة, صفحة بيضاء (فرصة للبدء من جديد دون أحكام مسبقة) / خَرْبَشَ / دكتوراه (دكتوراه تعتمد عادةً على 3 سنوات على الأقل من الدراسات العليا وأطروحة؛ وهي أعلى…)",
 "はくしいにん": "تَفْوِيض مُطْلَق, ضَوْء أَخْضَر",
 "はくしいにんじょう": "تَفْوِيض مُطْلَق, ضَوْء أَخْضَر",
 "はくしかくめい": "كتاب أبيض, ورقة بيضاء (تقرير حكومي؛ يغلف عادة بغلاف أبيض)",
 "はくしき": "تبحر, سعة اطلاع (معرفة علمية عميقة) / مُطَّلِع, وَاسِعُ الثَّقَافَة (على درجة عالية من التعليم؛ ذو معلومات أو فهم واسع)\nمثال: استجابة شرطية",
 "はくしけんきゅういん": "باحث ما بعد الدكتوراه (باحث يشارك في دراسة أكاديمية تتجاوز مستوى درجة الدكتوراه)",
 "はくしごう": "درجة الدكتوراه, دكتوراه (واحدة من أعلى الدرجات الأكاديمية التي تمنحها الجامعة)",
 "はくしじょうたい": "صَفْحَة بَيْضَاء",
 "はくしつ": "مادة بيضاء (نسيج عصبي أبيض للجهاز العصبي المركزي يتكون من عصبونات وأغمادها المايلينية)",
 "はくしゃ": "مِهْمَاز / تَسَارُع (عَجَلَة، تزايُد السرعة بالنسبة إلى الزمن في جسم من الأَجسام المتحرِّكة…)\nمثال: تسارع السائق بسيارته.",
 "はくしゃがかかる": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "はくしゃく": "عَدَّ",
 "はくしゃくふじん": "كونتيسة (المكافئ الأنثوي للكونت أو الإيرل)",
 "はくしゃをかける": "مِهْمَاز",
 "はくしゅ": "تَصْفِيق",
 "はくしゅう": "خَرِيف, خريف (فصل من فصول السَّنَة الأربعة، بعد الصَّيْف وقبل الشِّتَاء؛ سَنَة)\nمثال: نحن في الخريف الآن.",
 "はくしゅかっさい": "تَصْفِيق",
 "はくしゅく": "أَخ\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "はくしゅつ": "إخراج, طرد (فعل الطرد أو القذف أو الإخراج)\nمثال: طرد مثيري الشغب من قبل الشرطة",
 "はくしゅをおくる": "صَفَّقَ",
 "はくしょ": "كتاب أبيض, ورقة بيضاء (تقرير حكومي؛ يغلف عادة بغلاف أبيض)",
 "はくしょく": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون…)\nمثال: هذا الكلب أبيض.",
 "はくしょくざつおん": "ضوضاء بيضاء (ضوضاء ناتجة عن محفز يحتوي على جميع ترددات الاهتزاز المسموعة)\nمثال: الضوضاء البيضاء عامل حجب جيد",
 "はくしょくじんしゅ": "العرق الأبيض, قوقازيون (عرق ذو بشرة فاتحة)",
 "はくしょくわいせい": "قَزْم أَبْيَض",
 "はくしょん": "أَتْشُو",
 "はくしろんぶん": "أطروحة الدكتوراه (بحث رسمي طويل يكتبه المرشح لدرجة الدكتوراه في الجامعة)",
 "はくしん": "واقعي (مدرك أو يعبر عن إدراك للأشياء كما هي حقاً)\nمثال: وصف واقعي",
 "はくじつのもとにさらす": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "はくじつむ": "حُلْم يَقَظَة (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "はくじゃく": "رقة, وهن (جودة الافتقار للشدة أو الجوهر)\nمثال: رقة صوت حادة ولكنها عذبة",
 "はくじょう": "إِقْرَار, اِعْتِرَاف / عَدِيم الإِحْسَاس, فَاقِد الشُّعُور (خالٍ من الشعور أو الإحساس الجسديّ)",
 "はくじら": "حوت مسنن (أي من عدة حيتان لها أسنان مخروطية بسيطة وتتغذى على الأسماك وما إلى ذلك)",
 "はくじん": "أبيض, قوقازي (شخص من أصل أوروبي ذو بشرة فاتحة أو شاحبة) / مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ. / بَرَازِيلِيّ",
 "はくじんしじょうしゅぎ": "تفوق العرق الأبيض (التحيز القائل بأن أفراد العرق الأبيض متفوقون على أفراد الأعراق الأخرى)",
 "はくじんしじょうしゅぎしゃ": "مؤمن بتفوق البيض (شخص يعتقد أن العرق الأبيض هو الأسمى أو يجب أن يكون كذلك)",
 "はくじんしゅ": "العرق الأبيض, قوقازيون (عرق ذو بشرة فاتحة)",
 "はくじんコンプレックス": "أبيض, قوقازي (شخص من أصل أوروبي ذو بشرة فاتحة أو شاحبة)",
 "はくす": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ…)\nمثال: ربح زيري المال. / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "はくすいろう": "صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "はくする": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ…)\nمثال: ربح زيري المال. / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "はくせい": "حشو (حشوة توضع في المراتب والوسائد والأثاث المنجد)",
 "はくせいじゅつ": "تحنيط (فن تركيب جلود الحيوانات بحيث يكون لها مظهر نابض بالحياة)",
 "はくせき": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون…)\nمثال: هذا الكلب أبيض.",
 "はくせつ": "نَبْض, نَبْضَة",
 "はくせん": "خط أبيض (شريط أبيض في منتصف الطريق لتحديد مسارات المرور) / سَعْفَة, قَرَع",
 "はくそ": "لوحة تذكارية نحاسية, لوحة معدنية (نصب تذكاري مصنوع من النحاس الأصفر)",
 "はくそう": "صفيحة رقيقة (لوحة رقيقة)",
 "はくぞう": "فيل أبيض (فيل هندي أمهق؛ نادر ومقدس أحياناً في شرق آسيا)",
 "はくたい": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في…)\nمثال: جون في عمر أخي.",
 "はくたいげ": "ثر أبيض, سيلان مهبلي أبيض (إفرازات مخاطية بيضاء من المهبل؛ غالباً ما تكون مؤشراً على وجود عدوى)",
 "はくだく": "تَغَيُّم, كُدْرَة (صفة كون الشيء غائماً) / مَنِيّ",
 "はくだくえき": "مَنِيّ",
 "はくだつ": "تعرية, كشف (إزالة الغطاء)",
 "はくだつせいひふえん": "احمرار الجلد (أي اضطراب جلدي ينطوي على احمرار غير طبيعي)",
 "はくち": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق. / أَنْكُورِيج",
 "はくちび": "حمقاء جميلة (شابة مدللة من قبل رجال أكبر سناً وأثرياء وأقوياء)",
 "はくちゅう": "نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر…)\nمثال: نهار اليوم ممل!",
 "はくちゅうむ": "حُلْم يَقَظَة (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "はくちょう": "تَمّ, قُقْنُس\nمثال: 白鳥は当地からフロリダに移動する。 — يهاجر البجع من هنا إلى فلوريدا. / شاب (مراهق أو شاب بالغ ذكر) / شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "はくちょうざ": "الدَّجَاجَة",
 "はくちょうのうた": "أغنية البجعة, العمل الأخير (أداء أو جهد أخير (خاصة قبل التقاعد))",
 "はくちょう座": "الدَّجَاجَة",
 "はくてい": "شاب (مراهق أو شاب بالغ ذكر) / شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "はくてっこう": "مَرْقَشِيتَا",
 "はくでん": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "はくとう": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "はくとうおう": "زهرة الرياح, شقائق النعمان / أَشْيَب",
 "はくとうゆ": "كِيرُوسِين",
 "はくとうわし": "عقاب رخماء (عقاب كبيرة من أمريكا الشمالية لها رأس أبيض وأجنحة وجسم داكن)",
 "はくとうワシ": "عقاب رخماء (عقاب كبيرة من أمريكا الشمالية لها رأس أبيض وأجنحة وجسم داكن)",
 "はくど": "طين صيني, كاولين (طين ناعم عادة ما يكون أبيض ناتج عن تجوية المعادن الألومينية (مثل الفلسبار)…) / بَيَاض",
 "はくどう": "نَبْض, نَبْضُ القَلْب",
 "はくないしょう": "شلالات قوية, مسقط مائي ضخم (شلال كبير؛ تدفق عنيف للمياه فوق جرف)",
 "はくにく": "كرشة",
 "はくねつ": "احتدام, توهج أبيض (سخونة شيء يتم تسخينه حتى يتحول إلى اللون الأبيض)",
 "はくねつてき": "مُسَخَّن (جُعِل دافئاً أو ساخناً)",
 "はくねつでんきゅう": "لَمْبَة, مِصْبَاح",
 "はくねつとう": "لمبة, مصباح كهربائي (مصباح كهربائي يتكون من غلاف زجاجي شفاف أو نصف شفاف يحتوي على فتيل سلكي (عادة من…)",
 "はくねんど": "طين صيني, كاولين (طين ناعم عادة ما يكون أبيض ناتج عن تجوية المعادن الألومينية (مثل الفلسبار)…)",
 "はくはく": "شَفَّاف / أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون…)\nمثال: هذا الكلب أبيض.",
 "はくはん": "صَيْخَد / بُهَاق",
 "はくば": "رغوة الموج, زبد الموج (موجة تهب عليها الرياح فينكسر عرفها ويظهر أبيض اللون)",
 "はくばのおうじ": "فتى الأحلام, فارس الأحلام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم)\nمثال: ترى الفتاة الفتى.",
 "はくばのきし": "الفارس الأبيض (شركة تكون مستحوذاً ودوداً في عملية استحواذ)",
 "はくばひば": "سفسطة (حجة غير صحيحة عمدًا تظهر البراعة في التفكير على أمل خداع شخص ما)",
 "はくばん": "سَبُورَة بَيْضَاء",
 "はくひ": "تقشير (إزالة الغطاء الخارجي لعضو أو جزء)",
 "はくひしょう": "برص, مهق (غياب خلقي للتصبغ في العينين والجلد والشعر)",
 "はくひょうをふむおもい": "توجس, نذير شؤم (فأل غير مواتٍ)\nمثال: شعور متزايد بنذير شؤم",
 "はくび": "أَفْضَل",
 "はくふ": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير…)\nمثال: أنا وهو أولاد عم.",
 "はくふじん": "كونتيسة (المكافئ الأنثوي للكونت أو الإيرل)",
 "はくぶつ": "تاريخ طبيعي (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟",
 "はくぶつかん": "مَتْحَف (مكان تُجمع وتُعْرَض فيه الآثار التاريخيَّة أو الفنيَّة أو العِلْميَّة وغيرها)\nمثال: عاد إلى المتحف.",
 "はくぶつがく": "تاريخ طبيعي (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟",
 "はくぶつがくしゃ": "عالم تاريخ طبيعي, عالم طبيعة (عالم أحياء مطلع على التاريخ الطبيعي (خاصة علم النبات وعلم الحيوان))",
 "はくぶつし": "تاريخ طبيعي (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟",
 "はくぶつひょうほん": "تاريخ طبيعي (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟",
 "はくぶん": "مُطَّلِع",
 "はくへいせん": "مُلْتَحِم, وَجْهاً لِوَجْه (على مسافة قريبة جداً؛ في قتال مباشر)",
 "はくへん": "رُقَاقة, شَظِيَّة صغيرة (شظية صغيرة من شيء انفصلت عن الكل)\nمثال: أصابت عينه شظية صخرية صغيرة",
 "はくぼ": "عَمَّة, خَالَة (هي أُخْت الأَبّ)\nمثال: سامي و ليلى أبناء عمة. / عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء)\nمثال: هل العشاء جاهز؟",
 "はくぼく": "طَبْشُورَة",
 "はくまい": "أرز أبيض (أرز تمت إزالة القشرة أو الطبقات البنية الخارجية منه)",
 "はくめい": "شَفَق ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه:…)\nمثال: أثارت تلك السلحفاة شفقة زيري. / مُصِيبَة, شَقْوَة",
 "はくめいこうせん": "شعاع الشمس (شعاع من ضوء الشمس)",
 "はくめいはくぼせい": "شَفَقِيّ, غَسَقِيّ (كَالشَّفَق؛ خَافِت الإِضَاءَة)",
 "はくめん": "بَاهِت, شَاحِب / عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "はくよう": "بَحْرِيّ",
 "はくようきゅう": "بُرْج اَلْحَمَل, اَلْحَمَل (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "はくらい": "مُسْتَوْرَد (يُسْتَخْدَمُ خَاصَّةً لِلْبَضَائِعِ المَجْلُوبَةِ مِنْ مَصْدَرٍ أَجْنَبِيٍّ)",
 "はくらく": "تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة)\nمثال: دخل الفريق في حالة ركود",
 "はくらんかい": "مَعْرِض",
 "はくり": "فصل, فك الارتباط (عملية التحرير من مرفق أو اتصال) / تَفْرِقَة",
 "はくりょく": "إبهار, تأثير قوي (صفة ترك انطباع قوي أو حيوي في الذهن)\nمثال: عظمة العمارة",
 "はくろう": "بيوتر, سبيكة القصدير والرصاص (أي من سبائك القصدير المختلفة مع كميات صغيرة من معادن أخرى (خاصة الرصاص))",
 "はくロシア": "بِيلَارُوسِيَا, رُوسْيَا الْبَيْضَاء",
 "はくロシアご": "بِيلَارُوسِيّ",
 "はぐ": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر.",
 "はぐき": "لِثَة, لَثَة",
 "はぐきおん": "صامت سني, صامت لثوي (صامت يُنطق بطرف اللسان بالقرب من حافة اللثة)",
 "はぐくむ": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / بِالاِحْتِضَان, بِالكَفَالَة (يَتِمّ رِعايَتُه دونَ أَن يَكونَ ابْنًا بِيُولوجِيًّا)",
 "はぐらかす": "تفادي, مراوغة (حركة مراوغة سريعة)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "はぐる": "قَلَبَ / اُغْرُب عَن وَجْهِي!, إِبْتَعِد عَنِّي!",
 "はぐるま": "ترس, عجلة مسننة (عجلة مسننة تتعشق مع آلية مسننة أخرى لتغيير سرعة أو اتجاه الحركة المنقولة)\nمثال: علق ربطة عنق الأحمق في مجموعة التروس / سن الترس (سن على حافة عجلة مسننة)\nمثال: كان ترساً صغيراً في آلة كبيرة",
 "はぐるまがかみあう": "شَبَكَة",
 "はぐれもの": "ضَلَّ / مَنْبُوذ, مَنْبُوذَة",
 "はぐれる": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "はぐれ者": "ضَلَّ / مَنْبُوذ, مَنْبُوذَة",
 "はけ": "فُرْشَاة\nمثال: مشط شعرك قبل أن تخرج. / تَصْرِيف / إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة)",
 "はけい": "شَكْل مَوْجِيّ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "はけいこうばん": "حديد مموج, صاج معرج (عادة ما يكون صفائح حديد أو صلب مجلفنة مشكلة في تلال وتجاويف متوازية مستقيمة)",
 "はけくち": "تنفيس, مخرج (نشاط يحرر أو يعبر عن الطاقة الإبداعية أو العاطفة)\nمثال: لم يكن لديها مخرج آخر لمشاعرها / سُوق (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ…)\nمثال: ذهبت إلى السوق.",
 "はけぐち": "تنفيس, مخرج (نشاط يحرر أو يعبر عن الطاقة الإبداعية أو العاطفة)\nمثال: لم يكن لديها مخرج آخر لمشاعرها / سُوق (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ…)\nمثال: ذهبت إلى السوق.",
 "はけば": "تنفيس, مخرج (نشاط يحرر أو يعبر عن الطاقة الإبداعية أو العاطفة)\nمثال: لم يكن لديها مخرج آخر لمشاعرها",
 "はけほうき": "مِكْنَسَة صغيرة, مِكْنَسَة يدوية (مكنسة صغيرة ذات مقبض قصير تستخدم لتنظيف الملابس)",
 "はけぼうき": "مِكْنَسَة صغيرة, مِكْنَسَة يدوية (مكنسة صغيرة ذات مقبض قصير تستخدم لتنظيف الملابس)",
 "はける": "بَالُوعَة",
 "はけん": "هَيْمَنَة, سَيْطَرَة / إرسال, إيفاد (فعل إرسال شيء ما)\nمثال: تم إنجازه بسرعة وكفاءة / موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "はけんあらそい": "صِرَاع عَلَى ٱلسُّلْطَة",
