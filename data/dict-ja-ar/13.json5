 "なんつったって": "مَهْمَا",
 "なんつって": "بَدِيل, رَدِيء (اصطناعي ورديء الجودة؛ بديل أقل قيمة)",
 "なんつー": "كَيْف, ازاي",
 "なんて": "يَا لَ (يستعمل لنِدَاء البعيد والقريب)",
 "なんていっても": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "なんてこった": "مَاذَا بِحَقّ اَلسَّمَاء (أداة استفهام)\nمثال: ماذا تريد الآن؟",
 "なんてことない": "عَادِيّ, مَأْلُوف",
 "なんてことのない": "عَادِيّ, مَأْلُوف",
 "なんてったって": "مَهْمَا",
 "なんてん": "كَم / خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة…)\nمثال: كان خطأ حاسوبي. / مَرْبِط الْفَرَس",
 "なんて言っても": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "なんで": "لِأَنَّ / إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "なんであれ": "أَيّ, أَيَّمَا (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "なんでい": "حَمَأ, حَمأَة ((حَمَأَ) الْبِئْر حَمَأً: أخرج حمأتها)",
 "なんでかというと": "لِأَنَّ",
 "なんでも": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "なんでもかでも": "كُلّ شَيْء / بكل الوسائل, بكل تأكيد (بالتأكيد أو يقيناً)\nمثال: زرنا بكل تأكيد",
 "なんでもかんでも": "كُلّ شَيْء / بكل الوسائل, بكل تأكيد (بالتأكيد أو يقيناً)\nمثال: زرنا بكل تأكيد",
 "なんでもない": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / عَفْوًا, عَلَى الرُحْب وَالسَّعَة",
 "なんでもや": "شخص شامل, متعدد المواهب (شخص متعدد الجوانب يتقن أشياء كثيرة)\nمثال: إنها أفضل شخص شامل رأوه منذ سنوات / متجر ريفي, متجر عام (متجر بيع بالتجزئة يخدم منطقة ذات كثافة سكانية منخفضة؛ عادة ما يكون مخزناً…)",
 "なんでも屋": "شخص شامل, متعدد المواهب (شخص متعدد الجوانب يتقن أشياء كثيرة)\nمثال: إنها أفضل شخص شامل رأوه منذ سنوات / متجر ريفي, متجر عام (متجر بيع بالتجزئة يخدم منطقة ذات كثافة سكانية منخفضة؛ عادة ما يكون مخزناً…)",
 "なんでやねん": "مَاذَا بِحَقّ اَلسَّمَاء (أداة استفهام)\nمثال: ماذا تريد الآن؟",
 "なんでんぶっきょう": "بوذية التيرافادا, تيرافادا (واحدة من مدرستين عظيمتين للعقيدة البوذية تؤكدان على الخلاص الشخصي من خلال…)",
 "なんと": "يَا لَ (يستعمل لنِدَاء البعيد والقريب)\nمثال: يا لها من جملة! / بشكل مفاجئ, للمفاجأة (بطريقة مفاجئة)\nمثال: كان ودوداً بشكل مفاجئ / عَجَبًا\nمثال: سبحان الله عما يشركون. / نَارَا",
 "なんという": "كَيْف, ازاي",
 "なんというか": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "なんといったって": "مَهْمَا",
 "なんといっても": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "なんとう": "باتجاه الجنوب الشرقي (إلى أو نحو أو في الجنوب الشرقي)",
 "なんとうごぞく": "اللغات الأسترونيزية (عائلة اللغات التي يتم التحدث بها في أستراليا وفورموزا وماليزيا وبولينيزيا)",
 "なんとうぶ": "باتجاه الجنوب الشرقي (إلى أو نحو أو في الجنوب الشرقي)",
 "なんとか": "شَيْء (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء…)\nمثال: في يدها شيء ما. / بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "なんとかかんとか": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
