 "はんちょくせん": "شُعَاع / شِفْنِين, شِفْنِين بَحْرِيّ",
 "はんつや": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "はんてい": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين",
 "はんていきじゅん": "مِعْيَار (العِيَار الذي يُقَاس به غيره، اسم آلة؛ قد يقصد به العِيَار)",
 "はんていし": "مُحَدِّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: حضر الجميع إلى الصف في الوقت المحدد",
 "はんていりつ": "تضاد, طباق (تجاور كلمات أو أفكار متناقضة لإعطاء شعور بالتوازن) / ضِدّ, عَكْس (المقابل التام)\nمثال: نظريته هي عكس نظريتي تماماً",
 "はんてん": "جَوّ / انقلاب في الموقف, تحول تام (تغيير كبير في الموقف أو المبدأ أو وجهة النظر) / ارتداد, عكس (تغيير من حالة إلى الحالة المعاكسة) / عكس, قلب (فعل عكس الترتيب أو المكان) / ارتداد, انعكاس (التحول في الاتجاه المعاكس)\nمثال: تحول تام في السياسة الخارجية / أجسام طافية, ذباب طائر (بقع أمام العينين تسببها شظايا خلايا معتمة في الجسم الزجاجي والعدسة)\nمثال: تبدو الأجسام الطافية وكأنها تنجرف عبر مجال الرؤية",
 "はんてんこうせい": "هجوم مضاد شامل (هجوم واسع النطاق (أكثر من مجرد هجوم مضاد) تقوم به قوة مدافعة لانتزاع المبادرة من قوة مهاجمة)",
 "はんてんぼく": "حور أصفر, شجرة الزنبق (شجرة خشب نفضية طويلة في أمريكا الشمالية لها زهور صفراء مخضرة كبيرة تشبه الزنبق وثمار تشبه المخروط؛ تنتج أخشاباً بيضاء ناعمة تستخدم خاصة لأعمال الخزائن)",
 "はんでおしたみたいに": "باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: لطيف وكريم دائماً",
 "はんでおしたよう": "مُكَرَّر, نَمَطِيّ (يَفْتَقِرُ إِلَى العَفْوِيَّةِ أَوِ الأَصَالَةِ أَوِ التَّفَرُّد)",
 "はんと": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط / مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ / إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما)",
 "はんとう": "شِبْه جَزِيرَة / كُورْيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة) / كُورِيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "はんとうじん": "كُورِيّ",
 "はんとうまく": "غشاء شبه منفذ (غشاء (مثل غشاء الخلية) يسمح لبعض الجزيئات بالمرور من خلاله دون غيرها)",
 "はんとうめい": "شِبْه شَفَّاف (يسمح بمرور الضوء بشكل منتشر دون أن يكون شفّافاً تماماً)",
 "はんとき": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب.",
 "はんとけいまわり": "عَكْس عَقَارِب السَّاعَة (في اتجاه معاكس لاتجاه حركة عقارب الساعة) / عَكْس اتِّجَاه عَقَارِب السَّاعَة (في الاتجاه المعاكس لدوران عقارب الساعة)\nمثال: الرجاء التحرك عكس اتجاه عقارب الساعة في دائرة!",
 "はんとしごとに": "مَرَّتَيْن فِي السَّنَة, نِصْف سَنَوِيًّا (مرتين في السنة)",
 "はんどう": "رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / تَفَاعُل (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)\nمثال: اليوم هناك برد.",
 "はんどういるか": "دلفين قاروري الأنف (أي من عدة دلافين ذات جبهة مستديرة ومنقار متطور؛ تعيش بشكل رئيسي في شمال المحيط الأطلسي والبحر الأبيض المتوسط)",
 "はんどうか": "رجعي",
 "はんどうかくめい": "ثَوْرَة مُضَادَّة (ثورة تهدف إلى عكس التغييرات التي أدخلتها ثورة سابقة)",
 "はんどうけいせい": "تكوين عكسي ((في الطب النفسي) آلية دفاع يطور فيها الشخص بغير وعي مواقف وسلوكاً معاكساً للرغبات والدوافع المكبوتة غير المقبولة وتعمل على إخفائها)\nمثال: أخلاقه الصارمة هي مجرد تكوين عكسي لإخفاء دافعه الجنسي",
 "はんどうげん": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "はんどうこう": "بورنيت, خام الطاووس (معدن يتكون من كبريتيدات النحاس والحديد ويوجد في رواسب النحاس)",
 "はんどうしゅぎ": "رجعية (التوجه السياسي للرجعيين)",
 "はんどうしゅぎしゃ": "رجعي",
 "はんどうたい": "شِبْه مُوَصِّل",
 "はんどうたいけんしゅつき": "حَالَةٌ صُلْبَة (يتألّف من موادّ وعناصر أشباه الموصلات والأجهزة المتّصلة بها) / خَاصٌّ بِالحَالَةِ الصُّلْبَة (يتعلّق بالخصائص الفيزيائيّة للموادّ الصلبة؛ خاصّةً التوصيل الكهربائيّ)",
 "はんどうたいそし": "جهاز شبه موصل, نبيطة شبه موصلة (موصل مصنوع من مادة شبه موصلة)",
 "はんどうてき": "رجعي",
 "はんどうタービン": "توربين تفاعلي, عنفة رد الفعل (توربين بشفرات مرتبة لتوليد عزم الدوران من الانخفاض التدريجي لضغط البخار من المدخل إلى المخرج)",
 "はんどく": "فك الترميز, فك التشفير (نشاط توضيح أو تحويل من رمز إلى نص عادي)\nمثال: مطلوب مفتاح سري أو كلمة مرور لفك التشفير",
 "はんどくしがたい": "غير مقروء ((لخط اليد، الطباعة، إلخ) لا يمكن قراءته)\nمثال: خط يد غير مقروء",
 "はんどん": "نصف يوم عطلة (يوم يكون نصفه خالياً من العمل أو الواجب)",
 "はんながぐつ": "جَزْمَة (الأكلة الواحدة ليلا ونهارا؛ هي السُكُون بمعنى علامة الجزم من الحركات) / بسطار",
 "はんなま": "نَادِر / شِبْه جَافّ (جافّ إلى حدٍّ ما) / غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "はんなり": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "はんにゃとう": "غاية, غَرَض",
 "はんにゅうぐち": "باب الخدمة, مدخل الخدمة (مدخل مخصص لاستخدام الخدم أو لتسليم البضائع وإزالة القمامة)",
 "はんにん": "جَانٍ ((جَانَ) جونا وجونة: اسود) / عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "はんにんそく": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "はんにんまえ": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "はんのう": "وَظِيفَة بِدَوَامٍ جُزْئِيّ, عَمَل جُزْئِيّ (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟ / رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / تَفَاعُل (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)\nمثال: اليوم هناك برد.",
 "はんのうじかん": "كمون, وقت الاستجابة (الوقت الذي ينقضي بين المثير والاستجابة له)",
 "はんのうせい": "استجابة, تفاعلية (الاستجابة للتحفيز) / تفاعلية, نشاط كيميائي (القابلية السريعة للتغير الكيميائي)",
 "はんのうちゅうかんたい": "بيني, متوسط (الواقع بين نقيضين أو طرفين في الزمان أو المكان أو الحالة) / مُتَوَسِّط, وَسَط (فِي حُدُودِ الوَسَطِ عَلَى مِقْيَاسِ التَّقْيِيم) / مركب وسيط, وسيط كيميائي (مادة تتشكل أثناء عملية كيميائية قبل الحصول على المنتج المطلوب)\nمثال: الانتقال من الجلوس إلى الوقوف دون دفعات وسيطة باليدين",
 "はんのうろ": "مُفَاعِل",
 "はんはん": "مُنَاصَفَةً, بِالنِّصْف",
 "はんばい": "بَيْع / تخفيض (تَنْقِيص ، حَسْم ،تَقْلِيل؛ تَنْزِيل) / مُزَايَدَة\nمثال: هل يمكن ان تعطيني تخفيض",
 "はんばいいん": "طاقم المبيعات (أولئك في شركة المسؤولون عن المبيعات)",
 "はんばいかかく": "سعر البيع, سعر العرض (السعر الذي يُعرض به شيء للبيع)",
 "はんばいがいしゃ": "قَاسِم",
 "はんばいき": "آلَة بَيْع, آلَة بَيْع ذَاتِيّ (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "はんばいぎょうしゃ": "تَاجِر, تَاجِرَة",
 "はんばいしゃ": "بَائِع, بَائِعَة",
 "はんばいじてん": "مكتب البريد الأمريكي (وكالة مستقلة تابعة للحكومة الفيدرالية مسؤولة عن تسليم البريد (وأحيانًا الاتصالات) بين الأفراد والشركات في الولايات المتحدة) / ضابط صف بحري (ضابط صف في البحرية أو خفر السواحل برتبة تعادل رقيب في الجيش) / بولونيوم (عنصر فلزي مشع يشبه التيلوريوم والبزموت)",
 "はんばいじてんかんり": "مكتب البريد الأمريكي (وكالة مستقلة تابعة للحكومة الفيدرالية مسؤولة عن تسليم البريد (وأحيانًا الاتصالات) بين الأفراد والشركات في الولايات المتحدة) / ضابط صف بحري (ضابط صف في البحرية أو خفر السواحل برتبة تعادل رقيب في الجيش) / بولونيوم (عنصر فلزي مشع يشبه التيلوريوم والبزموت)",
 "はんばいじてんじょうほうかんりシステム": "عند نقطة البيع (من أو متعلق بـ أو كونه الموقع الذي يتم فيه شراء شيء ما)",
 "はんばいじゅつ": "فن البيع, مهارة البيع (المهارة في البيع؛ المهارة في إقناع الناس بالشراء)\nمثال: قرأ كتابًا عن فن البيع لكنه لم يساعده",
 "はんばいすいしん": "تَرْوِيج الْمَبِيعَات (الترويج الذي يكمل أو ينسق الإعلانات)",
 "はんばいそくしん": "تَرْوِيج الْمَبِيعَات (الترويج الذي يكمل أو ينسق الإعلانات)",
 "はんばいてん": "خَزَنَ (حفظ، إدخر، أودع في مخزن)",
 "はんばいにん": "بَائِع, بَائِعَة",
 "はんばいねだん": "سعر البيع, سعر العرض (السعر الذي يُعرض به شيء للبيع)",
 "はんばいひ": "تكلفة التوزيع (أي تكلفة يتكبدها منتج أو تاجر جملة أو تاجر تجزئة أو موزع (كما للإعلان والشحن وما إلى ذلك))",
 "はんばいぶ": "إدارة المبيعات, قسم المبيعات (قسم في مؤسسة تجارية مسؤول عن بيع المنتجات أو الخدمات)",
 "はんばいぶもん": "إدارة المبيعات, قسم المبيعات (قسم في مؤسسة تجارية مسؤول عن بيع المنتجات أو الخدمات)",
 "はんばいめい": "اسم تجاري, علامة تجارية (اسم يُعطى لمنتج أو خدمة)",
 "はんばいもと": "بَائِع, بَائِعَة",
 "はんばく": "تفنيد, تكذيب (فعل تحديد أن شيئاً ما زائف) / تفنيد, دحض (أي دليل يساعد على إثبات زيف شيء ما) / دحض, دفاع (الفعل الكلامي للرد على هجوم على تأكيداتك)\nمثال: كان دحضه للتهم قصيراً ومقنعاً",
 "はんばり": "نصف نعل (نعل حذاء يمتد من القوس إلى إصبع القدم)",
 "はんぱ": "بقايا قماش, فضلة قماش (قطعة قماش متبقية بعد استخدام الباقي أو بيعه) / بقايا (جزء صغير أو حصة تتبقى بعد زوال الجزء الرئيسي) / قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب) / كَسْر, كُسُور\nمثال: يصنع قطعة أثاث خشبية. / فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط / غير مسؤول, مستهتر (يظهر عدم الاكتراث بالعواقب)\nمثال: تصرف كأحمق غير مسؤول",
 "はんぱく": "تفنيد, تكذيب (فعل تحديد أن شيئاً ما زائف) / تفنيد, دحض (أي دليل يساعد على إثبات زيف شيء ما) / دحض, دفاع (الفعل الكلامي للرد على هجوم على تأكيداتك)\nمثال: كان دحضه للتهم قصيراً ومقنعاً",
 "はんぱじゃない": "كبير, معتبر (كبير أو كبير نسبياً في العدد أو الكمية أو المدى أو الدرجة)\nمثال: كمية معتبرة",
 "はんぱつ": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة. / استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته / تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب. / جَائِحَة",
 "はんぱつさよう": "ردع, صد (فعل صد أو دفع الهجوم؛ موقف دفاعي ناجح) / استهجان, نفور شديد (نفور شديد) / تنافر, قوة تنافر (القوة التي تتنافر بها الأجسام عن بعضها البعض)",
 "はんぱつりょく": "رجوعية, مرونة (الخاصية الفيزيائية للمادة التي تمكنها من العودة إلى شكلها أو موضعها الأصلي بعد تشوه لا يتجاوز حد المرونة) / رجوعية, مرونة (حدوث ارتداد أو رجوع للخلف)",
 "はんぱない": "بثقل, بشكل كبير (بدرجة كبيرة)\nمثال: اعتمد بشكل كبير على بيانات الآخرين",
 "はんぱもの": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما) / أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء)",
 "はんぱもん": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "はんぴゃく": "مُخْتَلِف, مُتَنَوَّع",
 "はんぶっしつ": "مَادَّة مُضَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "はんぶん": "نِصْف, نُصْف",
 "はんぶんすう": "كَسْر مُرَكَّب (كسر يحتوي على كسور في بسطه أو مقامه)",
 "はんぷ": "تَوْزِيع / قماش الأشرعة (قماش قوي (مثل قماش القنب القطني) يستخدم لصنع الأشرعة والخيام)",
 "はんぷく": "تَكْرَار, إِعَادَة / إعادة إنتاج, استنساخ (فعل عمل نسخ) / تكرار التجربة (تكرار تجربة لاختبار صحة استنتاجها) / مجسم, نسخة مطابقة (نسخة ليست الأصل؛ شيء تم نسخه) / تردد الصدى, صدى (تكرار الصوت الناتج عن انعكاس الموجات الصوتية)\nمثال: كان استنساخ غوتنبرغ للنصوص المقدسة أكثر كفاءة بكثير / عَوْدِيَّة / خانَ (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / عَكَسَ / تَكْرَار, إِعَادَة",
 "はんぷくせい": "تكرار (إطناب ناتج عن التكرار المفرط) / مُتَكَرِّر, مُلِحّ (يَتَكَرَّرُ بِإِلْحَاحٍ وَمُثَابَرَة) / تكراري (يتسم بالتكرار)\nمثال: حركة تكرارية",
 "はんぷくてき": "مُتَكَرِّر, مُلِحّ (يَتَكَرَّرُ بِإِلْحَاحٍ وَمُثَابَرَة) / تكراري (يتسم بالتكرار)\nمثال: حركة تكرارية",
 "はんべい": "معاد لأمريكا (يعارض الولايات المتحدة وسياساتها) / مُعَادٍ لِأَمْرِيكَا (شخص يعارض الولايات المتحدة وسياساتها)",
 "はんべつ": "تَمْيِيْز",
 "はんべつがつく": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه.",
 "はんべり": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "はんぺい": "كَعْب التَّذْكِرَة (جزء ممزق من التذكرة يُعاد إلى حاملها كإيصال) / سُور / سِيَاج",
 "はんぺら": "بِنِصْف الحَجْم (نصف الحجم المعتاد أو العادي)",
 "はんぺん": "كَعْب التَّذْكِرَة (جزء ممزق من التذكرة يُعاد إلى حاملها كإيصال)",
 "はんぼいん": "أَشْبَاهُ العِلَلِ",
 "はんぼう": "مَشْغُول",
 "はんぽ": "نصف بعد, نصف نغمة (الفاصل الموسيقي بين المفاتيح المتجاورة على آلة لوحة المفاتيح)",
 "はんま": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "はんまい": "أَرُزّ, رُزّ ((أَرَزَّت) الجرادةُ: رَزَّت)\nمثال: هكذا نطهي الأرز",
 "はんみち": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط",
 "はんみょう": "خُنْفُسَاء نَمِرِيَّة / خنفساء محرقة, ذراح (خنفساء تنتج إفرازاً يسبب تقرحات في الجلد)",
 "はんめん": "مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / فِي نَفْس اَلْوَقْت (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / حُدُود خَارِجِيَّة / صُورَة جَانِبِيَّة / سِيرَة / شُهْرَة / بُرُوز / نِصْف, نُصْف / مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / عَكَسَ",
 "はんめんに": "من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "はんも": "رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو)",
 "はんもうしょう": "عَمًى",
 "はんもく": "عَدَاوَة",
 "はんもと": "دَار نَشْر, نَاشِر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "はんももひき": "يصل للركبة (يمتد إلى الركبة) / مُختَصَر إِلَى النِّصْف (اختُصِرَ إلى نصف طوله الأصلي) / لِلنِّصْف العُلْوِيّ, نِصْفِيّ (يُمثل النصف العلوي فقط من الجسم) / صورة نصفية (بورتريه يظهر الجسم من الخصر لأعلى فقط)",
 "はんもん": "استجواب مضاد ((قانون) استجواب دقيق لشاهد معادٍ في محكمة قانونية لتشويه سمعته أو إلقاء ضوء جديد على الشهادة المقدمة بالفعل في الاستجواب المباشر) / قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / أجسام طافية, ذباب طائر (بقع أمام العينين تسببها شظايا خلايا معتمة في الجسم الزجاجي والعدسة)\nمثال: تبدو الأجسام الطافية وكأنها تنجرف عبر مجال الرؤية",
 "はんもんおうのう": "عذاب, غم (ضيق عقلي شديد) / ألم شديد, كمد (ضيق شديد في الجسم أو العقل)",
 "はんや": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "はんやく": "تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة. / كَرْشَنَة, نَقْصَوَة",
 "はんやけ": "غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "はんよう": "إِجْمالِيّ, جامِع / انشغال, دبيب (حالة الوجود أو الظهور بمظهر المنشغل بنشاط ما)\nمثال: أظهروا كل نشاط مجموعة من القنادس",
 "はんようがたコンピュータ": "حاسوب مركزي (حاسوب رقمي كبير يخدم 100-400 مستخدم ويشغل غرفة خاصة مكيفة الهواء)",
 "はんようき": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "はんようし": "نَقِيض البُرُوتُون (بروتون غير مستقر سالب الشحنة؛ الجسيم المضاد للبروتون)",
 "はんようせい": "تعدد المهارات, موسوعية (امتلاك مجموعة واسعة من المهارات)",
 "はんようてき": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "はんようひん": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "はんらたい": "شِبْه عَارٍ (مكسوّ جزئياً فقط)",
 "はんらん": "انتفاضة / غَارِق, مَغْمُور (مُغَطًّى بِالمَاء) / إغراق, تخمة (صفة الوفرة المفرطة لدرجة انخفاض الأسعار)",
 "はんらんげん": "سهل فيضي (سهل منخفض مجاور لنهر يتكون بشكل رئيسي من رواسب النهر وعرضة للفيضانات)",
 "はんらんしゃ": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "はんらんぶんし": "مُتَمَرِّد, مُتَمَرِّدَة / تَمَرَّدَ, يَتَمَرَّدُ",
 "はんりゅう": "تَيَّار مُعَاكِس (أفعال معاكسة لنشاط المجموعة الرئيسي) / تيار ساحب, تيار عنيف (امتداد من المياه المضطربة في نهر أو في البحر ناتج عن تدفق تيار في تيار آخر أو عبره)\nمثال: عطلت التيارات السياسية المعاكسة المؤتمر",
 "はんりゅうし": "جُسَيْم مُضَادّ (جسيم له نفس كتلة جسيم آخر ولكن له قيم معاكسة لخصائصه الأخرى؛ يؤدي تفاعل الجسيم وجسيمه المضاد إلى الفناء وإنتاج طاقة إشعاعية)",
 "はんりゅうどうたい": "شِبْهُ سَائِل (سائل إلى حدّ ما؛ بين الصلب والسائل)",
 "はんりょ": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "はんりょく": "رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / تَفَاعُل (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)\nمثال: اليوم هناك برد.",
 "はんりょどうぶつ": "حَيَوَان مَنْزَلِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط) / حَيَوَان أَلِيف (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "はんりん": "نصف دائرة (شكل مستوٍ له شكل نصف دائرة)",
 "はんるい": "مُشْكِلَة, مَتاعِب",
 "はんれい": "مِثَال, مَثَل / مِثَال / أُسْطُورَة / مِفْتَاح خَرِيطَة (مفتاح)\nمثال: بحث عن المفتاح. / مِثَال مُعَاكِس, مِثَال مُضَادّ",
 "はんれいがん": "جابرو (واحد من عائلة الصخور المتطفلة الحبيبية)",
 "はんれいしゅう": "كِتَابِيّ, نَمُوذَجِيّ (وفقًا لما هو مذكور في الكتب المرجعية أو يتسم بخصائصها؛ نموذجي) / سجل القضايا, مدونة القضايا (كتاب يُحتفظ فيه بسجلات مكتوبة مفصلة لقضية ما ويعد مصدراً للمعلومات للعمل اللاحق)",
 "はんれい岩": "جابرو (واحد من عائلة الصخور المتطفلة الحبيبية)",
 "はんれき": "سَجَّل اَلْجِنَائِيَّة (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "はんれつ": "نَمَط / نُمُوذَج, مِثَال / قِيَاس",
 "はんろ": "سُوق (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق. / منحدر (سطح مائل يربط بين مستويين) / سلم الطائرة, منحدر (درج متحرك يستخدمه الركاب للصعود إلى الطائرة أو النزول منها) / رامب, كراث بري (نبات معمر من أمريكا الشمالية له بصلة رفيعة وزهور بيضاء)",
 "はんろう": "مُشْكِلَة, مَتاعِب",
 "はんろん": "اِعْتَرَاض / اِعْتِرَاض / لَخَّصَ, اِخْتَصَرَ",
 "はんキリスト": "ضِدّ الْمَسِيح, الدَّجَّال",
 "はんゲルマンしゅぎ": "جامعة جرمانية (حركة كان هدفها التوحيد السياسي لجميع الشعوب التي تتحدث الألمانية أو اللغات الجرمانية)",
 "はんスラブしゅぎ": "قَوْمِيَّة سِلَافِيَّة (ما يجمع أمة ذات تاريخ وأمانٍ مشتركة)\nمثال: اللغة اليابانية لغتي القومية.",
 "はんスラヴしゅぎ": "قَوْمِيَّة سِلَافِيَّة (ما يجمع أمة ذات تاريخ وأمانٍ مشتركة)\nمثال: اللغة اليابانية لغتي القومية.",
 "はんズボン": "شُورْت",
 "はんセム": "مُعَادَاة السَّامِيَّة",
 "はんセムしゅぎ": "مُعَادَاة السَّامِيَّة",
 "はんダース": "سِتَّة (يَدُلُّ عَلَى العَدَد 6)",
 "はんトラストほう": "قانون مكافحة الاحتكار (قانون يهدف إلى تعزيز المنافسة الحرة في السوق عن طريق حظر الاحتكارات)",
 "はんドン": "نصف يوم عطلة (يوم يكون نصفه خالياً من العمل أو الواجب)",
 "はんパン": "شُورْت",
 "はんファシズム": "مُعَادَاة الْفَاشِيَّة",
 "はんユダヤしゅぎ": "مُعَادَاة السَّامِيَّة",
 "はんユダヤしゅぎしゃ": "مُعَادٍ لِلسَّامِيَّةِ",
 "はん濫": "غَارِق, مَغْمُور (مُغَطًّى بِالمَاء) / إغراق, تخمة (صفة الوفرة المفرطة لدرجة انخفاض الأسعار)",
 "はブラシ": "فُرْشَاة أَسْنَان\nمثال: この歯ブラシを使っているのは母ではない。 — الشخص الذي يستخدم فرشاة الأسنان هذه ليس أمي.",
 "はレタス": "خس مفكك الأوراق, خس ورقي (خس ذو أوراق مجعدة بشكل فضفاض لا تشكل رأساً مضغوطاً) / خس ورقي (يتميز بأوراق مجعدة أو محززة تشكل وريدة فضفاضة لا تتطور إلى رأس مدمج)",
 "はー": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はーあ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はーい": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / مَفْهُوم / حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "はーっ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はーッ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はーーい": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / مَفْهُوم / حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "は文字い": "مُحْرَج, بِٱلْحَرَج",
 "は種": "خِنْزِيرَة / زَرَعَ, بَذَرَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت.",
 "は種床": "مشتل, مهاد البذور (حوض تُزرع فيه الشتلات قبل نقلها)",
 "ば": "مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل. / فُرْصَة, مُنَاسَبَة / مُنَاسَبَة (مؤنث مُنَاسَب؛ اسم مفعول من نَاسَبَ؛ التي نُوسِبَتْ أي اتُّخِذَتْ نَسِيبَة؛ الحَدَث الذي يكون مناسِبًا لفعل شيئا ما، غالبا ما يُقصد به حَدَثًا سعيدا وما يُراد فعله هو الاحتفال ويجوز استخدامها في الاحداث غير سعيدة)\nمثال: أرى مرآة مناسبة / مَنْظَر, مَشْهَد / مَشْهَد / مَتَى / إمتى / متى / امتى / فوقتاش / حِينَمَا, عِنْدَمَا / وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / أَكْثَر / لِأَنَّ / هكذا, بلا سبب",
 "ばぁちゃん": "جِدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم) / تِيتَة\nمثال: كان لزيري جد و جدة. / زوجة (زوجتك الخاصة (مصطلح عامي))\nمثال: قابل زوجتي",
 "ばぁば": "جَدَّة, تِيتَة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة.",
 "ばあい": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / عُلْبَة / حَالَات / دَعْوَى (إدِّعَاء؛ دُعَاء) / عُلَب\nمثال: سأرفع عليك قضية.",
 "ばあいわけ": "تَجَمُّع, مَجْمُوعَة (أيّ عدد من الكيانات (الأعضاء) يُعتبَر وحدة واحدة) / تجميع, تصنيف (نشاط جمع الأشياء معاً في مجموعات) / تجميع, تصنيف (نظام لتصنيف الأشياء إلى مجموعات)",
 "ばあさん": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة. / عَجُوز",
 "ばあたり": "مُدَرَّج مُغَطَّى, مِنَصَّة رَئِيسِيَّة (موقف في مضمار سباق أو ملعب يتكون من طبقات بها صفوف من المقاعد الفردية تحت سقف واقٍ) / المنصة الرئيسية, جمهور المدرجات (الجمهور في ملعب أو مضمار سباق) / خِصِّيصًا لِهَذَا الغَرَض (لغرض محدد) / لِغَرَض بِعَيْنِه, مَخْصُوص (مُخصَّص لغرض واحد معين أو معنيّ به) / مَخْصُوص, مُرْتَجَل (غالباً ما يكون مرتجلاً أو مخصصاً لغرض آني)\nمثال: تم تعيينهم لهذا الغرض / بروفة بالملابس, بروفة نهائية (بروفة كاملة غير منقطعة بالأزياء قبل العرض الأول بوقت قصير)",
 "ばあたりけいこ": "بروفة بالملابس, بروفة نهائية (بروفة كاملة غير منقطعة بالأزياء قبل العرض الأول بوقت قصير)",
 "ばあちゃん": "جِدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم) / تِيتَة\nمثال: كان لزيري جد و جدة. / زوجة (زوجتك الخاصة (مصطلح عامي))\nمثال: قابل زوجتي",
 "ばあば": "جَدَّة, تِيتَة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة.",
 "ばあや": "ظِئْر, دَايَة (العاطفة على غير ولدها المرضعة له من الناس والإبل وغيرها. الذكر والأنثى في ذلك سواء)",
 "ばい": "ثُنَائِيّ / ضِعْف / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / دُوَّامَة, بُلْبُل / لوس (تراكم غير طبقي ناعم الحبيبات من الطين والغرين المترسب بفعل الرياح) / طبيب خيول (طبيب بيطري يعالج الخيول)",
 "ばいいん": "بِغَاءٌ, دَعَارَة",
 "ばいう": "موسم الأمطار (أحد الموسمين في المناخات الاستوائية، وهي فترة سنوية يحدث فيها معظم هطول الأمطار في بلد ما)",
 "ばいうき": "موسم الأمطار (أحد الموسمين في المناخات الاستوائية، وهي فترة سنوية يحدث فيها معظم هطول الأمطار في بلد ما)",
 "ばいおん": "نغمة تابعة, نغمة فوقية (نغمة توافقية ذات تردد يمثل مضاعفاً للتردد الأساسي) / إِيحَاء, نَبْرَة خَفِيَّة ((عادة الجمع) معنى أو جودة ضمنية خفية)\nمثال: إيحاءات اليأس",
 "ばいか": "مضاعفة (زيادة الرهان في لعبة ورق بمعامل 2) / مضاعفة (زيادة بمقدار الضعف)\nمثال: قررت أن مضاعفته كانت خدعة / ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / زَهْرَة بَرْقُوق / سعر البيع, سعر العرض (السعر الذي يُعرض به شيء للبيع)",
 "ばいかい": "وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / وساطة (تفاوض لحل الخلافات يديره طرف محايد) / حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه. / مَعْبَر (مكان العُبُور؛ مَعْبَر رَفَح: نقطة العبور الحدودية بين أراضي قطاع غَزَّة ومِصْر يقع عند مدينة رَفَح في غزة)",
 "ばいかいご": "لُغَة تَوَاصُل مُشْتَرَك (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "ばいかいしゃ": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف) / مُتَّجِهٌ / مُتَّجِهاتٌ / شُعاعٌ / أَشِعَّةٌ / ناقِلٌ / نَواقِلُ",
 "ばいかいぶつ": "مُتَوَسِّط / نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "ばいかいへんすう": "وَسِيط, بَارَامِتِر / مَعْلَم, وَسِيط (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "ばいきゃく": "بَيْع / تخفيض (تَنْقِيص ، حَسْم ،تَقْلِيل؛ تَنْزِيل) / مُزَايَدَة\nمثال: هل يمكن ان تعطيني تخفيض",
 "ばいきゃくかかく": "سعر البيع, سعر العرض (السعر الذي يُعرض به شيء للبيع)",
 "ばいきゃくだいきん": "إيراد إجمالي, مقبوضات (المبلغ الكامل للدخل قبل إجراء أي خصومات)",
 "ばいきゅう": "مُضَاعَف (ازداد كثيراً في الشدّة أو الحجم أو الكمّية)",
 "ばいきん": "جُرْثُومَة / خَشَاش, هَامَّة",
 "ばいこく": "خِيَانَة",
 "ばいこくど": "خَائِن, خَائِنَة (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك!",
 "ばいごま": "دُوَّامَة, بُلْبُل",
 "ばいさん": "العشاء الأخير (عشاء الفصح التقليدي ليسوع مع تلاميذه عشية صلبه) / الإفخارستيا, القربان المقدس (سر مسيحي يحيي ذكرى العشاء الأخير بتكريس الخبز والنبيذ)",
 "ばいしつ": "مُتَوَسِّط",
 "ばいしゃく": "تَدْبِير الزِيجَات (الوساطة من أجل تحقيق زواج بين الآخرين)",
 "ばいしゃくにん": "خَاطِب, خَاطِبَة",
 "ばいしゅう": "اِكْتِسَاب / رَشْوَة / رشوة",
 "ばいしゅん": "بِغَاءٌ, دَعَارَة",
 "ばいしゅんがい": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "ばいしゅんふ": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "ばいしゅんやど": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "ばいしょう": "تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / تعويض (شيء (مثل المال) يُعطى أو يُستلم كدفعة أو تعويض (كما هو الحال عن خدمة أو خسارة أو إصابة)) / تعويض ((في الطب النفسي) آلية دفاع تخفي عيوبك غير المرغوب فيها عن طريق المبالغة في السلوكيات المرغوبة) / بِغَاءٌ, دَعَارَة / تحميص, شوي (طهي (اللحم) بحرارة جافة في فرن (عادة مع إضافة دهن))\nمثال: استغرق التحميص البطيء عدة ساعات",
 "ばいしょうきん": "تعويضات, غرامة تعويضية (مبلغ من المال يُدفع كتعويض عن خسارة أو إصابة) / تعويض, ضمانة (إعفاء قانوني من المسؤولية عن الأضرار) / تأمين, ضمان (حماية ضد الخسارة المستقبلية)",
 "ばいしょうせきにんほけん": "تأمين المسؤولية (تأمين يوفر الحماية من المطالبات الناشئة عن الإصابات أو الأضرار التي تلحق بأشخاص آخرين أو ممتلكات)",
 "ばいしょうふ": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "ばいしょく": "بِغَاءٌ, دَعَارَة / تَهْذِيب",
 "ばいしん": "مُحَلَّفِين, هَيْئَةُ مُحَلَّفِين / لَجْنَة",
 "ばいしんいん": "مُحَلَّف",
 "ばいしんいんせき": "مقصورة المحلفين (منطقة مسيجة داخل قاعة المحكمة لهيئة المحلفين)",
 "ばいしんせい": "نظام هيئة المحلفين (نظام قانوني لتحديد الحقائق في دعوى قضائية)",
 "ばいしんせいど": "نظام هيئة المحلفين (نظام قانوني لتحديد الحقائق في دعوى قضائية)",
 "ばいじ": "مثبت أسنان (جهاز سني يثبت الأسنان (أو طرف صناعي) في موضعها بعد علاج تقويم الأسنان) / خادم (شخص يعمل في خدمة شخص آخر (خاصة في المنزل)) / عربون استعانة, مقدم أتعاب (رسم يُفرض مقدماً للاحتفاظ بخدمات شخص ما (مثل المحامي))",
 "ばいじゅう": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)",
 "ばいじょ": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "ばいじん": "جسيمات, مادة جسيمية (كتلة صغيرة منفصلة من مادة صلبة أو سائلة تبقى منتشرة بشكل فردي في انبعاثات الغاز أو السائل (تعتبر عادة ملوثاً للغلاف الجوي))",
 "ばいすう": "متعدد / مُضَاعَف",
 "ばいすうせい": "تعدد الصيغة الصبغية (حالة كون الكائن متعدد الصيغة الصبغية)",
 "ばいすうたい": "متعدد الصيغة الصبغية (لخلية أو كائن حي يحتوي على أكثر من ضعف العدد الأحادي من الكروموسومات) / متعدد الصيغة الصبغية ((في علم الوراثة) كائن أو خلية تحتوي على أكثر من ضعف العدد الأحادي من الكروموسومات)\nمثال: خلية متعددة الصيغة الصبغية",
 "ばいすうひれいのほうそく": "قانون النسب المتضاعفة ((كيمياء) قانون ينص على أنه عندما يمكن لعنصرين أن يتحدوا لتكوين أكثر من مركب واحد، فإن كميات أحدهما التي تتحد مع كمية ثابتة من الآخر ستظهر علاقة…)",
 "ばいする": "ثُنَائِيّ / ضِعْف / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
 "ばいせき": "تأمين المسؤولية (تأمين يوفر الحماية من المطالبات الناشئة عن الإصابات أو الأضرار التي تلحق بأشخاص آخرين أو ممتلكات)",
 "ばいせん": "تحميص, شوي (طهي (اللحم) بحرارة جافة في فرن (عادة مع إضافة دهن))\nمثال: استغرق التحميص البطيء عدة ساعات",
 "ばいせんざい": "أَكَّال, كَاوٍ ((عَنْ مَادَّةٍ، خَاصَّةً حَمْضٍ قَوِيٍّ) قَادِرٌ عَلَى إِتْلَافِ المَوَادِّ أَوْ تَآكُلِهَا) / سَوْدَاوِيّ, قَاتِم (ساخر بقسوة؛ ذو طابع مُشؤوم) / مادة لاذعة, مثبت لون (مادة تستخدم لمعالجة الجلود أو المواد الأخرى قبل الصباغة؛ تساعد في عملية الصباغة)",
 "ばいぞう": "مضاعفة (زيادة الرهان في لعبة ورق بمعامل 2) / مضاعفة (زيادة بمقدار الضعف)\nمثال: قررت أن مضاعفته كانت خدعة",
 "ばいたい": "مُتَوَسِّط",
 "ばいたいしゅうたん": "إِم",
 "ばいたいアクセスせいぎょ": "معطف ماكنتوش (معطف واق من المطر مصنوع من قماش معالج بالمطاط)",
 "ばいたいインタフェースコネクタ": "ميكروفون (جهاز لتحويل الموجات الصوتية إلى طاقة كهربائية)",
 "ばいち": "وسط استنبات, وسط زرع ((علم الجراثيم) مادة مغذية (صلبة أو سائلة) تستخدم لزراعة الكائنات الحية الدقيقة)",
 "ばいちょう": "شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / طُعم, مستدرج (مخادع يقود شخصاً ما إلى الخطر (عادة كجزء من مؤامرة))",
 "ばいてん": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "ばいどく": "زُهَرِيّ, مَرَض فِرَنْجِيّ",
 "ばいなら": "إِلَى اللِّقَاء, مَعَ السَّلَامَة (عبارة وداع)\nمثال: تبادلوا عبارات الوداع",
 "ばいにする": "ثُنَائِيّ / ضِعْف",
 "ばいにん": "بَائِع, تَاجِر",
 "ばいばい": "تِجَارَة / مضاعفة (زيادة الرهان في لعبة ورق بمعامل 2) / مضاعفة (زيادة بمقدار الضعف)\nمثال: قررت أن مضاعفته كانت خدعة",
 "ばいばいかかく": "سعر البيع, سعر العرض (السعر الذي يُعرض به شيء للبيع)",
 "ばいぶん": "كاتب مأجور (كاتب متواضع المستوى ومحتقر (يكتب من أجل المال فقط دون اهتمام بالجودة))",
 "ばいぼく": "عرافة, قراءة الطالع (ممارسة التنبؤ بمستقبل الناس (عادة مقابل أجر))",
 "ばいまし": "مضاعفة (زيادة الرهان في لعبة ورق بمعامل 2) / مضاعفة (زيادة بمقدار الضعف)\nمثال: قررت أن مضاعفته كانت خدعة",
 "ばいも": "بُوقِيَّة, عَرَار",
 "ばいやく": "دواء مسجل براءة اختراع (دواء محمي ببراءة اختراع ومتاح بدون وصفة طبية من الطبيب)",
 "ばいやくしょう": "صيدلي (مهني صحي مدرب في فن تحضير وصرف الأدوية)",
 "ばいやくずみ": "مباع (تم التصرف فيه لمشتري)\nمثال: هذه البضاعة مباعة",
 "ばいやくてん": "صيدلية (متجر تجزئة تباع فيه الأدوية وسلع أخرى)",
 "ばいよう": "ثَقَافَة (بمعنى صار حَاذقا فطنا؛ المعرفة الواسعة والإطلاع على الكثير من المعلومات)\nمثال: توم لا يهتم بالثقافة. / تَهْذِيب",
 "ばいようえき": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَقَة، وهي أخص من المرَق)",
 "ばいようき": "مُتَوَسِّط",
 "ばいようし": "أخصائي علم الأجنة (طبيب متخصص في علم الأجنة)",
 "ばいようど": "دبال, سماد عضوي (خليط من النباتات المتحللة والروث؛ يستخدم كسماد)",
 "ばいりつ": "تكبير (عملية توسيع شيء ما في الحجم الظاهري) / تكبير, صورة مكبرة (مطبوعة فوتوغرافية تم تكبيرها) / تهويل, مبالغة (جعل الشيء يبدو أكثر أهمية مما هو عليه في الواقع) / تَكْبِير (نسبة حجم الصورة إلى حجم الشيء)",
 "ばいりょく": "مؤازر آلي (من أو ينطوي على آليات مؤازرة (سيرفو)) / آلية مؤازرة, سيرفو (نظام تحكم يحول حركة ميكانيكية صغيرة إلى حركة تتطلب طاقة أكبر بكثير؛ قد يتضمن نظام تغذية مرتدة سلبية)",
 "ばいりん": "موسم الأمطار (أحد الموسمين في المناخات الاستوائية، وهي فترة سنوية يحدث فيها معظم هطول الأمطار في بلد ما)",
 "ばいをふくむ": "كمامة (قيد يوضع في فم الشخص لمنعه من التحدث أو الصراخ) / طُرْفَة, مَزْحَة (حكاية فكاهية أو ملاحظة تهدف إلى إثارة الضحك)\nمثال: روى نكتة مضحكة جداً",
 "ばい菌": "جُرْثُومَة / خَشَاش, هَامَّة",
 "ばえ": "جَذَّاب, مُغْرٍ (قادر على جذب الاهتمام أو لفت الانتباه الإيجابي) / جذاب, محبوب ((للشخصيات في الأدب أو الدراما) تثير مشاعر التعاطف أو الإعجاب)\nمثال: أضاف شخصية جذابة لا تُنسى إلى الأساطير الأمريكية الشعبية",
 "ばおくれ": "رَهَاب المَسْرَح",
 "ばか": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق. / غَبِيّ / غَبِيّ, أَحْمَق / تافِه / متعطل, مختل وظيفياً (لا يؤدي أو غير قادر على أداء وظيفته العادية)\nمثال: صمام متعطل",
 "ばかあたり": "بلوك باستر, عمل ضخم النجاح (نجاح غير عادي مع شعبية واسعة ومبيعات ضخمة (خاصة لفيلم أو مسرحية أو تسجيل أو رواية))",
 "ばかく": "جلد الحصان (جلد مصنوع من إهاب الحصان)",
 "ばかくさい": "عَبَثِيّ, سَخِيف",
 "ばかげた": "عَبَثِيّ, سَخِيف",
 "ばかさわぎ": "مزاح خشن (لعب صاخب أو خشن)",
 "ばかざめ": "قرش متشمس (قرش شمالي كبير غير ضار يتغذى على العوالق؛ غالباً ما يسبح ببطء أو يطفو على سطح البحر)",
 "ばかし": "حَوَالَيْ, تَقْرِيبًا / وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي. / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "ばかじん": "أحمق, بليد (شخص ليس ذكياً جداً)\nمثال: إنه الاقتصاد يا غبي!",
 "ばかす": "أَرْبَكَ",
 "ばかすか": "بقوة, بنشاط (بنشاط وحيوية)\nمثال: دافع عن أفكاره بقوة",
 "ばかず": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "ばかたれ": "أحمق, غبي (شخص غبي وغير كفء)",
 "ばかちん": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "ばかっぽい": "غَبِيّ / غَبِيّ, أَحْمَق",
 "ばかでかい": "ضَخْم, هَائِل",
 "ばかでもチョンでも": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "ばかどり": "قَطْرَس (طائر بحري كبير)",
 "ばかなまね": "حماقة, طيش (سلوك أحمق أو لا معنى له)",
 "ばかに": "بشكل مضحك, بشكل يثير السخرية (بشكل يثير الضحك أو يستحقه)\nمثال: كان دخلها صغيراً بشكل مضحك، لكنها تمكنت من العيش بشكل جيد",
 "ばかにする": "سَخِرَ, اِسْتَهْزَأَ (سَخَرَ(سخرت) السفينة سخرا: أطاعت وجرت وطابت لها الريح؛ (سَخَرَ) فلانا سخريا: كلفه ما لا يريده وقهره)\nمثال: سخر المدرس من جسمي.",
 "ばかはっけんき": "تَغْرِيد",
 "ばかばかしい": "عَبَثِيّ, سَخِيف",
 "ばかばなし": "ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة)",
 "ばかみたい": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "ばかもの": "مُغَفَّل, أَحْمَق",
 "ばかもん": "مُغَفَّل, أَحْمَق",
 "ばかやろう": "أبله, متخلف عقلياً (شخص ذو ذكاء دون الطبيعي)\nمثال: 俺は人事課の馬鹿野郎にあごで指図されるつもりはない。 — لن يحكمني غبي من قسم الموارد البشرية.",
 "ばかよけ": "مُحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "ばからしい": "عَبَثِيّ, سَخِيف",
 "ばかり": "وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي. / حَوَالَيْ, تَقْرِيبًا / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل / عَلَى وَشْك (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "ばかりに": "لِأَنَّ / هكذا, بلا سبب / عَلَى وَشْك (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "ばかわらい": "جلجلة, ضحكة عميقة (انفجار من الضحك العميق العالي القلبي)",
 "ばかチョンカメラ": "كاميرا صوّب والتقط, كاميرا مدمجة (كاميرا تصوير خفيفة الوزن ذات تركيز تلقائي)",
 "ばがいしじょう": "سوق التداول المباشر, سوق خارج البورصة (بورصة أسهم تتم فيها معاملات الأوراق المالية عبر الهاتف والكمبيوتر بدلاً من قاعة البورصة)",
 "ばがいとりひき": "خَارِج البُورْصَة ((في الأوراق المالية) لا يُتَداوَل في سوق الأَوْراق المالِيَّة الرَّسْمِيّ)",
 "ばがば": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "ばがぼん": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "ばぎゃば": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "ばく": "دكتوراه (دكتوراه تعتمد عادةً على 3 سنوات على الأقل من الدراسات العليا وأطروحة؛ وهي أعلى درجة تمنح في الدراسات العليا) / مَعْرِض / تَابِير / موليبدنوم (عنصر فلزي متعدد التكافؤ يشبه الكروم والتنجستن في خصائصه) / دقيقة, لحظة (وقت قصير غير محدد)\nمثال: انتظر لحظة فقط / إرساء, ربط السفينة (فعل تأمين سفينة واصلة بالحبال) / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم) / شَاسِع, وَاسِع",
 "ばくあつ": "موجة صادمة",
 "ばくえい": "مُخَيِّم",
 "ばくえき": "قِمَار, مُقَامَرَة",
 "ばくおん": "أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟",
 "ばくか": "مَحَلَّة, مُخَيَّم (ما دون الحَيّ وفوق المَنْزِل. قيل قرابة مئة بيت ومجلس ومسجد؛ تقسيم إداري للمناطق السكنية في المدن. أصغر من الحيّ وأكبر من الزُقَاق) / تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة) / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / تابع, خاضع (خاضع أو مستسلم للسلطة أو لسيطرة شخص آخر) / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة / شُوغُون",
 "ばくが": "مَلْت",
 "ばくがとう": "سكر الشعير, مالتوز (سكر بلوري أبيض يتكون أثناء هضم النشويات)",
 "ばくぎ": "لعبة حظ, لعبة قمار (لعبة تنطوي على المقامرة)",
 "ばくぐい": "اِلْتَهَمَ",
 "ばくげき": "تَفْجِير, قَصْف / حَمْلَة / هَاجَمَ",
 "ばくげきき": "قَاذِفَة قَنَابِل",
 "ばくごう": "تَفْجِير",
 "ばくさい": "كَارِثِيّ, مُهْلِك (يُسَبِّبُ الأَذَى أَوِ الآفَةَ؛ يُصِيبُ بِعُنْفٍ مُفَاجِئٍ أَوْ وَبَاءٍ) / زَاعِق, صَاخِب (عالٍ بشكل مزعج ونافذ)",
 "ばくし": "تَفْجِير, قَصْف",
 "ばくしゃ": "مُخَيِّم",
 "ばくしゅ": "بِيرَة, جِعَة",
 "ばくしゅく": "انحباس صوتي, انطباق (المرحلة الانحباسية الأولية للصامت الانفجاري) / انفجار داخلي, انكماش (انهيار مفاجئ نحو الداخل)\nمثال: انفجار المصباح الكهربائي نحو الداخل",
 "ばくしょく": "اِلْتَهَمَ",
 "ばくしん": "شَحْطَة / شَرْطَة",
 "ばくじゅう": "نقيع الشعير (مالت غير مخمر أو قيد التخمير) / عشبة (تستخدم عادة في التركيب: 'عشبة الكبد'، 'عشبة الحليب'، 'عشبة الدوامة')",
 "ばくじゅうろか": "رش, نثر (فعل رش أو طرطشة الماء)",
 "ばくする": "دَحَضَ, أَدْحَضَ (أبطلَ الحُجّة أو دفعها بالحُجّة المضادة؛ زلَّ أو انزلق) / كَذَّبَ (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة)\nمثال: اتهمتني بالكذب. / أَسَرَ, رَبَطَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: إن توم لا يملك أسرة.",
 "ばくせい": "استبدادية, دكتاتورية (شكل من أشكال الحكم يكون فيه الحاكم دكتاتوراً مطلقاً (غير مقيد بدستور أو قوانين أو معارضة وما إلى ذلك))",
 "ばくぜん": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "ばくそう": "بشدة, للغاية (بدرجة قصوى (تستخدم غالباً لوصف السُكر)) / رَائِج, مُزْدَهِر (حيوي ومربح للغاية؛ في حالة ازدهار ونمو) / خوار, زئير (تلفظ عالٍ جداً (مثل صوت حيوان)) / دوي, رعد (ضجيج عميق طويل وعالٍ)\nمثال: ثمل بشدة",
 "ばくたい": "ضِمَادَة, عِصَابَة / عِنان",
 "ばくだい": "شَاسِع, وَاسِع\nمثال: ジョンは莫大な財産を相続した。 — ورث جون ثروة كبيرة.",
 "ばくだん": "قُنْبُلَة / قَنْبَلَ",
 "ばくだんマーク": "قُنْبُلَة / قَنْبَلَ",
 "ばくち": "قِمَار, مُقَامَرَة / تَكَهُّنٌ / مُضَارَبَة / مُبَاغِت, مُفَاجِئ",
 "ばくちく": "مفرقعة, مفرقعة نارية (لعبة نارية تتكون من شحنة متفجرة صغيرة وفتيل داخل غلاف ورقي سميك)",
 "ばくちやど": "بيت قمار, وكر قمار (مبنى عام يمكن فيه لعب مجموعة متنوعة من ألعاب الحظ (يُدار كعمل تجاري))",
 "ばくと": "مُقَامِر / مُغَامِر",
 "ばくとした": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "ばくなき": "صراخ, عويل (صرخات عالية أثناء البكاء)",
 "ばくねん": "اشتعال سريع, تفرقع (احتراق ينتشر عبر غاز أو على سطح مادة متفجرة بمعدل سريع مدفوعاً بنقل الحرارة) / طرق, قرع (صوت الطرق (كما على باب أو في محرك أو محمل))\nمثال: ازداد الطرق ارتفاعاً",
 "ばくは": "تَعْنِيف, تَوْبِيخ شَدِيد (توبيخ شديد)\nمثال: استحق التوبيخ الشديد الذي وجهه له المدرب",
 "ばくはつ": "اِنْفِجَار, تَفْجِير / فورة, نوبة (اضطراب عنيف مفاجئ) / انفجار, تدفق عاطفي (تعبير غير مقيد عن العاطفة) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: اندلاع أمطار غزيرة",
 "ばくはつかん": "صاعق, كبسولة تفجير (جهاز تفجير ميكانيكي أو كهربائي أو كمية صغيرة من المتفجرات؛ يمكن استخدامه لبدء تفاعل متفجر مدمر)",
 "ばくはつじこ": "اِنْفِجَار, تَفْجِير",
 "ばくはつてき": "اِنْفِجَارِيّ, مُتَفَجِّر / مُتَفَجِّرَة, مَادَّة مُتَفَجِّرَة",
 "ばくはつぶつ": "اِنْفِجَارِيّ, مُتَفَجِّر / مُتَفَجِّرَة, مَادَّة مُتَفَجِّرَة",
 "ばくはつガス": "غاز المناجم, فايردامب (خليط من الغازات (معظمها الميثان) يتشكل في مناجم الفحم ويصبح متفجراً عند اختلاطه بالهواء)",
 "ばくばく": "شَاسِع, وَاسِع / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم) / دك, طرق (فعل الطرق (توجيه ضربات ثقيلة متكررة)) / خفقان, نبض قوي (حالة من النبض القوي والسريع (للقلب)) / ضرب متكرر, قصف (ضربات ثقيلة متكررة)\nمثال: فاجأه طرق القبضات المفاجئ / بحماس, بقلب قوي (بمتعة ودون تحفظ) / بحرارة, بقلب خالص (بطريقة قلبية)\nمثال: ألقى الصبي بنفسه بحماس في عمله",
 "ばくふ": "استبدادية, دكتاتورية (شكل من أشكال الحكم يكون فيه الحاكم دكتاتوراً مطلقاً (غير مقيد بدستور أو قوانين أو معارضة وما إلى ذلك)) / شَلَّال",
 "ばくふう": "انفجار قنبلة (انفجار قنبلة)",
 "ばくやく": "اِنْفِجَارِيّ, مُتَفَجِّر / مُتَفَجِّرَة, مَادَّة مُتَفَجِّرَة",
 "ばくよう": "قِمَار, مُقَامَرَة",
 "ばくらい": "قنبلة أعماق (قنبلة تنفجر عند عمق محدد مسبقاً تحت الماء؛ جهاز مضاد للغواصات)",
 "ばくりゅうしゅ": "خم خنازير, زريبة خنازير (حظيرة للخنازير) / جنجل, شحاذ العين (عدوى في الغدة الدهنية للجفن)",
 "ばくりょう": "طَاقَم, طَاقِم",
 "ばくりょうちょう": "رئيس أركان الجيش",
 "ばくれつ": "اِنْفَجَرَ / تَفْرَقَعَ",
 "ばくれつだん": "قُنْبُلَة / قَنْبَلَ",
 "ばくろ": "إفشاء, كشف (الفعل الكلامي لجعل الشيء واضحاً)",
 "ばくろん": "تفنيد, تكذيب (فعل تحديد أن شيئاً ما زائف) / تفنيد, دحض (أي دليل يساعد على إثبات زيف شيء ما) / دحض, دفاع (الفعل الكلامي للرد على هجوم على تأكيداتك)\nمثال: كان دحضه للتهم قصيراً ومقنعاً",
 "ばく然": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "ばく進": "شَحْطَة / شَرْطَة",
 "ばぐ": "عِنان",
 "ばけがく": "كِيمِيَاء (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما إلى الذهب؛ علم من علوم الطبيعة يتناول خواص العناصر والمركبات والقوانين التي تحكم تفاعلاتها) / كِيمِيَائِيّ, كِيمِيَاوِيّ\nمثال: هو يحب الكيمياء.",
 "ばけのかわ": "قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "ばけもの": "جني, عفريت ((فلكلور) مخلوق خارق صغير بشع يسبب المشاكل للبشر)",
 "ばけものやしき": "بَيْت أَشْبَاح (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "ばけもん": "جني, عفريت ((فلكلور) مخلوق خارق صغير بشع يسبب المشاكل للبشر)",
 "ばける": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / تَحَوَّلَ, مَسَخَ (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "ばけチェック": "فحص التكافؤ (نظام للتحقق من الأخطاء في عمل الكمبيوتر)",
 "ばげん": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "ばさばさ": "سرقة الماشية (سرقة الماشية) / حَفِيف, هَمْهَمِيّ (يتميز بأصوات ناعمة وخافتة) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح) / غَيْرُ مَصُون, مُهْمَل (لَا يُعْتَنَى بِهِ أَوْ يُصَانُ بِشَكْلٍ صَحِيح) / أَشْعَث (لَمْ يُمَشَّطْ بِعِنَايَة) / جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما. / بِشَكْل حَاسِم, بِشَكْل قَاطِع (بدرجة لا تقبل الجدل) / بِتَبْت, بِشَكْل نِهَائِيّ (مع النهائية؛ بشكل قاطع) / بِتَصْمِيم, بِحَزْم (بثبات الهدف)\nمثال: قانون فيشر لعام 1918 رفع بشكل حاسم وضعهم وأجورهم",
 "ばさま": "جِدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم) / تِيتَة\nمثال: كان لزيري جد و جدة.",
 "ばさら": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو التساهل) / استرسال, انغماس (عدم القدرة على مقاومة إشباع النزوات والرغبات)\nمثال: تطرف لغتهم / تأنق مفرط (أسلوب وملابس المتأنق أو المغرور)",
 "ばした": "اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "ばしっと": "مُبَاشَرَةً",
 "ばしばし": "بِعُنْف / بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم",
 "ばしゃ": "عَرَبَة / مُدَرِّب, مُدَرِّبَة / حافلة السفر, حافلة النقل الخارجي (وسيلة نَقْل للركاب)\nمثال: لنذهب بالحافلة.",
 "ばしゃら": "إفراط, شره (الإفراط في العمل والانغماس غير المعتدل في الشهوات الجسدية، خاصة في العاطفة أو التساهل) / استرسال, انغماس (عدم القدرة على مقاومة إشباع النزوات والرغبات)\nمثال: تطرف لغتهم / تأنق مفرط (أسلوب وملابس المتأنق أو المغرور)",
 "ばしゅ": "سَائِس / هَندَم",
 "ばしょ": "مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس / فَضاء (فَضَاء) / غُرْفَة, حُجْرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الفضاء مليئ بالغموض.",
 "ばしょがら": "حَالَة, وَضْع",
 "ばしょふさぎ": "إعاقة (الوقوف في طريق شخص ما) / اعتراض, سد (فعل الاعتراض أو العرقلة) / عائق, مانع (أي هيكل يجعل التقدم صعباً) / عائق, عقبة (شيء غير مادي يقف في الطريق ويجب تجاوزه أو التغلب عليه)\nمثال: عرقلة سير العدالة",
 "ばじゅつ": "فروسية (المهارة في التعامل مع الخيول وركوبها)",
 "ばじょう": "على ظهر الخيل, ممتطياً جواداً (على ظهر حصان) / صهوة, ظهر الحصان (ظهر الحصان) / ظهر الخنزير, هوتباك (سلسلة ضيقة من التلال)\nمثال: ركب على ظهر الخيل إلى المدينة",
 "ばじょうやりじあい": "مبارزة بالرماح (قتال بين فارسين يتبارزان بالرماح غير الحادة)",
 "ばすえ": "أطراف, ضواحي (المناطق الخارجية (كما في مدينة أو بلدة))\nمثال: عاشوا في ضواحي هيوستن",
 "ばせい": "اسْتِهْزَاء, تَهَكُّم (إظهار الازدراء عن طريق السخرية)",
 "ばせん": "تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول) / وَتِد, خَازُوق (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / مِحْرَقَة / حِصَّة / رِهَان",
 "ばそり": "مجرور بالخيول (يسحب بواسطة حصان)\nمثال: عربة تجرها الخيول",
 "ばたあし": "ركلة رفرفة (ركلة سباحة؛ يتم تحريك الساقين بسرعة صعوداً وهبوطاً دون ثني الركبتين)",
 "ばたっと": "فَجْأَةً",
 "ばたつかせる": "رَفْرَف",
 "ばたつく": "قَعْقَعَ",
 "ばたばた": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب / وَاحِدًا تِلْوَ الآخَرِ / بانشغال, بنشاط (بطريقة مشغولة)\nمثال: كانوا منشغلين بشراء الهدايا التذكارية",
 "ばたり": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة / فَجْأَةً",
 "ばたん": "فَرْقَعَة / كوكاتو (ببغاء ذو عرف أبيض أو فاتح اللون من المنطقة الأسترالية؛ غالباً ما يتم الاحتفاظ به كطيور أقفاص)",
 "ばた脚": "ركلة رفرفة (ركلة سباحة؛ يتم تحريك الساقين بسرعة صعوداً وهبوطاً دون ثني الركبتين)",
 "ばた足": "ركلة رفرفة (ركلة سباحة؛ يتم تحريك الساقين بسرعة صعوداً وهبوطاً دون ثني الركبتين)",
 "ばだい": "أُجْرَة, اِسْتَأْجَر / اِسْتَأْجَرَ / أجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: ركبت سيارة أجرة.",
 "ばち": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر. / ريشة / عصا الطبل (عصا تستخدم للقرع على الطبل) / ساق الطائر (الجزء السفلي من ساق الطائر)",
 "ばちあたり": "بِشَكْل بَغِيض, بِشَكْل لَعِين (بطريقة بغيضة) / لَعِين, مَلْعُون ((غير رسمي) شتائم تُستخدَم للتوكيد والتأثير) / مَحْكُومٌ عَلَيْه, مَلْعُون (مُعرَّض لعذاب جهنم الأبدي) / ملعونون, هالكون (الناس المحكوم عليهم بالعقاب الأبدي)\nمثال: آرثر اللطيف - مثابر بشكل لعين، وبأدب، وبلا نهاية!",
 "ばちがい": "غَيْر مُلَائِم, غَيْر مُنَاسِب (غير مناسب لمناسبة معينة إلخ) / غَيْرُ لَائِقٍ, غَيْرُ مُنَاسِبٍ (لَا يَتَّسِقُ مَعَ مَا هُوَ صَحِيحٌ أَوْ لَائِقٌ)\nمثال: تبدو الضوضاء غير مناسبة في وقت الحزن",
 "ばちくそ": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "ばちこり": "بِإِتْقَان, تَمَامًا",
 "ばちこーん": "صفعة (فعل صفع شيء ما؛ ضربة توجه بكف مفتوحة) / قبلة حارة (قبلة مفعمة بالحماس) / ارْتِطَامًا, مُبَاشَرَةً / إتش, سم (أسماء دارجة للهيروين)\nمثال: اصطدم مباشرة بالعمود",
 "ばちばち": "طقطقة, فرقعة (الصوت الحاد لأصوات الانكسار) / بقايا الشحم (البقايا التي تتبقى بعد إذابة الدهون الحيوانية) / عَارَكَ, قَاتَلَ / تَعَارَكَ, تَقَاتَلَ / نَاضَلَ, كَافَحَ / قِتَال (من قَتَلَ: كثير القَتْل) / مَعْرَكَة\nمثال: لن يحل القتال أي شيء.",
 "ばちゃく": "لَبَّادَة, لُبَّادَة",
 "ばちん": "صفعة (فعل صفع شيء ما؛ ضربة توجه بكف مفتوحة) / قبلة حارة (قبلة مفعمة بالحماس) / ارْتِطَامًا, مُبَاشَرَةً / إتش, سم (أسماء دارجة للهيروين)\nمثال: اصطدم مباشرة بالعمود / دفعة طاقة, صدمة مفاجئة (حدث مفاجئ يمنح طاقة أو إثارة، عادةً بتأثير درامي)\nمثال: أعطوها دفعة أخرى من الإشعاع",
 "ばっか": "وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي. / مَحَلَّة, مُخَيَّم (ما دون الحَيّ وفوق المَنْزِل. قيل قرابة مئة بيت ومجلس ومسجد؛ تقسيم إداري للمناطق السكنية في المدن. أصغر من الحيّ وأكبر من الزُقَاق) / تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة) / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / تابع, خاضع (خاضع أو مستسلم للسلطة أو لسيطرة شخص آخر) / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة / شُوغُون",
 "ばっかく": "إرغوت, دابرة (فطر يصيب نباتات الحبوب المختلفة مكوناً كتلاً سوداء مدمجة من خيوط متفرعة تحل محل العديد من حبوب النبات؛ مصدر لقلويدات مهمة طبياً ولحمض الليسرجيك) / إرغوت (مرض نباتي يسببه فطر الإرغوت)",
 "ばっかし": "حَوَالَيْ, تَقْرِيبًا / وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي. / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "ばっかり": "وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي. / حَوَالَيْ, تَقْرِيبًا / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل / عَلَى وَشْك (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "ばっかん": "قداحة, مشعل (جهاز لإشعال الوقود أو الشحنات أو الحرائق) / مادة إشعال, مشعل (مادة تستخدم لإشعال النار أو إضرامها)\nمثال: هل لديك ولاعة؟",
 "ばっき": "تَهْوِيَة",
 "ばっきょ": "استخراج, خلع (عملية إخراج شيء ما (خاصة باستخدام الجهد أو القوة)) / أصل, منشأ (الخصائص المنسوبة لأسلافك) / استخراج, استخلاص (عملية الحصول على شيء من خليط أو مركب بوسائل كيميائية أو فيزيائية أو ميكانيكية)\nمثال: أعطاها طبيب الأسنان تخديراً موضعياً قبل الخلع",
 "ばっきん": "غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل)",
 "ばっきんけい": "غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل)",
 "ばっくり": "فَاغِر الفَم, مَفْتُوح الفَم (مفتوح الفم على وسعه كما في حالة الدهشة أو الذهول)",
 "ばっくん": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ) / بَارِز, عَظِيم (ذو أهمّيّة أو دلالة كُبرى) / غَيْرُ مُسَدَّد, مُسْتَحَقّ (مُسْتَحَقٌّ كَدَيْن) / بَارِع, مُتَمَيِّز (يتميز عن غيره بالتفوق)",
 "ばっこ": "اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: تساهم في انتشار الجهل والتضليل.",
 "ばっこやなぎ": "صفصاف الماعز (صفصاف كثير التفرع من العالم القديم له نورات هرية كبيرة وأوراق عريضة كبيرة نسبياً)",
 "ばっこんき": "مشجع رياضي (مؤيد متحمس للرياضة)",
 "ばっさい": "حطابة, قطع الأشجار (عمل قطع الأشجار للحصول على الأخشاب)",
 "ばっさばっさ": "وَاحِدًا تِلْوَ الآخَرِ / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً)",
 "ばっさり": "قَصِير, قصير (ضد الطويل) / قَصِير (ضد الطويل)\nمثال: حبل الكذب قصير. / بشكل جذري (بطريقة جذرية)",
 "ばっしょう": "تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به",
 "ばっすい": "مُقْتَطَف / خلاصة",
 "ばっする": "عَاقَبَ, قَاصَصَ\nمثال: どうしてあなたは彼らを罰しているのですか。 — ما الذي تعاقبهم عليه؟",
 "ばっせき": "قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما.",
 "ばっせん": "فَجْوَة عَمِيقَة, هُوَّة (تفاوت لا يمكن جسره (بسبب فشل في الفهم مثلاً))\nمثال: شعر بهوة بينه وبين أصدقائه السابقين",
 "ばっそう": "قلع الأظافر (شكل من أشكال التعذيب يتم فيه نزع أظافر اليدين أو القدمين)",
 "ばっそく": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر. / قانون العقوبات (المدونة القانونية التي تحكم الجرائم وعقوباتها)",
 "ばっそん": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "ばった": "جُنْدُب, جَرَادَة",
 "ばったく": "اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "ばったもの": "تقليد, نسخة غير مرخصة (نسخة غير مصرح بها أو تقليد)",
 "ばったもん": "تقليد, نسخة غير مرخصة (نسخة غير مصرح بها أو تقليد)",
 "ばったり": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة / فَجْأَةً",
 "ばったん": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة / فَجْأَةً",
 "ばった物": "تقليد, نسخة غير مرخصة (نسخة غير مصرح بها أو تقليد)",
 "ばっちぃ": "قَذِر, وَسِخ / وَسَّخَ (مادة غير نظيفة، خاصة عند ملامستها لملابس الشخص أو جلده أو ممتلكاته. في مثل هذه الحالة يقال أنها أصبحت مُتّسخة)\nمثال: أنت من وسخ الأرض.",
 "ばっちい": "قَذِر, وَسِخ / وَسَّخَ (مادة غير نظيفة، خاصة عند ملامستها لملابس الشخص أو جلده أو ممتلكاته. في مثل هذه الحالة يقال أنها أصبحت مُتّسخة)\nمثال: أنت من وسخ الأرض.",
 "ばっちし": "بِإِتْقَان, تَمَامًا / كَافٍ (كِفَايَة، يَكْفِي، كَافِ؛ مَه، كَفَى) / تَمَامًا / مَه, كَفَى (اسم فعل بمعنى إنْكَفِفْ أو تَوَقَّفْ، ويقال مَهٍ أيضاً)\nمثال: خسر كافة ممتلكاته.",
 "ばっちり": "بِإِتْقَان, تَمَامًا / كَافٍ (كِفَايَة، يَكْفِي، كَافِ؛ مَه، كَفَى) / تَمَامًا / مَه, كَفَى (اسم فعل بمعنى إنْكَفِفْ أو تَوَقَّفْ، ويقال مَهٍ أيضاً)\nمثال: خسر كافة ممتلكاته.",
 "ばっちー": "قَذِر, وَسِخ / وَسَّخَ (مادة غير نظيفة، خاصة عند ملامستها لملابس الشخص أو جلده أو ممتلكاته. في مثل هذه الحالة يقال أنها أصبحت مُتّسخة)\nمثال: أنت من وسخ الأرض.",
 "ばってき": "اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "ばってん": "س (السِّين هو الحرف الخامس عشر من حروف الهجاء العربية بالترتيب الأبجدي للحروف العربية يسبقه حرف النُوْن ويلية حرف العَيْن وهو الحرف الثاني عشر بالترتيب…؛ تنقل المضارع من الحال إلى الاستقبال) / لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / لٰكِن, وَلٰكِنْ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / إِلَّا, سِوًى (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / إلَّا, غَيْرَ (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لكن لديك أطفال.",
 "ばっと": "فَجْأَةً",
 "ばっとう": "إسقاط, صرع (فعل إسقاط شيء ما (كشجرة)) / قَاسٍ, هَمَجِيّ ((عن الأشخاص أو أفعالهم) قادر على إلحاق الألم أو المعاناة أو مُيّال لذلك) / ثنية, درزة مسطحة (درزة تُصنع عن طريق ثني المواد الموصولة تحت بعضها أو طيها معاً وخياطتها لتجنب الحواف الخشنة) / إهاب, جلد مدبوغ (جلد الحيوان (وخاصة الحيوانات الكبيرة) بعد معالجته)",
 "ばっぽん": "استئصال, طمس (التدمير الكامل لكل أثر لشيء ما) / جَذْرِيّ, صَارِم (قويّ وحازم وصارم)",
 "ばっぽんてき": "جَذْرِيّ, صَارِم (قويّ وحازم وصارم)",
 "ばっ気": "تَهْوِيَة",
 "ばつ": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر. / طُغْمَة, عُصْبَة / س (السِّين هو الحرف الخامس عشر من حروف الهجاء العربية بالترتيب الأبجدي للحروف العربية يسبقه حرف النُوْن ويلية حرف العَيْن وهو الحرف الثاني عشر بالترتيب…؛ تنقل المضارع من الحال إلى الاستقبال) / إكستاسي, إم دي إم إيه (عقار منشط مرتبط كيميائياً بالميسكالين والأمفيتامين ويستخدم بشكل غير مشروع لتأثيراته المبهجة والمهلوسة؛ كان يستخدم سابقاً في العلاج النفسي ولكن في عام…)\nمثال: غالباً ما يستخدم الإكستاسي في الحفلات لأنه يمكن رواد الحفلات من البقاء نشطين لفترات طويلة من الزمن / اتِّسَاق, تَرَابُط (العلاقة المنطقية والمنظمة والمتسقة بين الأجزاء) / تلاحم, تماسك (حالة التماسك أو الالتصاق معاً) / خَاتِمَة",
 "ばつえい": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "ばつがわるい": "غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غَيْرُ مُنَاسِب, مُحْرِج (يُسَبِّبُ الإِزْعَاجَ أَوْ عَدَمَ الارْتِيَاح) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / ثَقِيل الأُسْلُوب, رَكِيك (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الرَّشَاقَة فِي التَّعْبِير)",
 "ばつが悪い": "غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غَيْرُ مُنَاسِب, مُحْرِج (يُسَبِّبُ الإِزْعَاجَ أَوْ عَدَمَ الارْتِيَاح) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / ثَقِيل الأُسْلُوب, رَكِيك (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الرَّشَاقَة فِي التَّعْبِير)",
 "ばつぐん": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ) / بَارِز, عَظِيم (ذو أهمّيّة أو دلالة كُبرى) / غَيْرُ مُسَدَّد, مُسْتَحَقّ (مُسْتَحَقٌّ كَدَيْن) / بَارِع, مُتَمَيِّز (يتميز عن غيره بالتفوق)",
 "ばつぞう": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "ばつぞく": "عَشِيرَة (مؤنث العَشِيْر؛ التي تعاشرها. الجمع عَشِيرَات؛ إحدى طبقات الأنساب دون الفخذ وفوق الفصيلة. الجمع عَشَائِر)",
 "ばつだ": "جَزَاء",
 "ばつなぎ": "نَادِرَة / أُطْرُوفَة / أُفْكُوهَة / طُرْفَة / فُكَاهَة / لَطِيفَة (مؤنث لَطِيْف؛ ذات اللطف والطافة؛ يقصد بها أحيانا جميلة بدون أن تكون ملفتة للنظر)\nمثال: هي مدرسة لطيفة.",
 "ばつのわるい": "غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غَيْرُ مُنَاسِب, مُحْرِج (يُسَبِّبُ الإِزْعَاجَ أَوْ عَدَمَ الارْتِيَاح) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / ثَقِيل الأُسْلُوب, رَكِيك (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الرَّشَاقَة فِي التَّعْبِير)",
 "ばつの悪い": "غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غَيْرُ مُنَاسِب, مُحْرِج (يُسَبِّبُ الإِزْعَاجَ أَوْ عَدَمَ الارْتِيَاح) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / ثَقِيل الأُسْلُوب, رَكِيك (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الرَّشَاقَة فِي التَّعْبِير)",
 "ばつぶん": "خَاتِمَة",
 "ばつぼく": "إسقاط, صرع (فعل إسقاط شيء ما (كشجرة)) / قَاسٍ, هَمَجِيّ ((عن الأشخاص أو أفعالهم) قادر على إلحاق الألم أو المعاناة أو مُيّال لذلك) / ثنية, درزة مسطحة (درزة تُصنع عن طريق ثني المواد الموصولة تحت بعضها أو طيها معاً وخياطتها لتجنب الحواف الخشنة) / إهاب, جلد مدبوغ (جلد الحيوان (وخاصة الحيوانات الكبيرة) بعد معالجته)",
 "ばつもう": "هوس نتف الشعر",
 "ばつもうしょう": "هوس نتف الشعر",
 "ばつもうへき": "هوس نتف الشعر",
 "ばつよう": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "ばつりゅう": "أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا",
 "ばつろ": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "ばつをあたえる": "عَاقَبَ, قَاصَصَ",
 "ばてい": "سَائِس / هَندَم",
 "ばていけいアーチ": "قوس حدوة الحصان, قوس مغاربي (قوس مستدير يتسع قبل أن يدور)",
 "ばていせき": "سَبَج",
 "ばとう": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "ばなれ": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "ばにく": "لَحْم حِصَان (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "ばにゅうしゅ": "كوميس (مشروب كحولي مصنوع من حليب الفرس المخمر؛ صنعه أصلاً بدو آسيا الوسطى)",
 "ばねじかけ": "آلية الساعة (أي آلية من عجلات مسننة يتم تشغيلها بواسطة زنبرك ملفوف؛ تشبه أعمال الساعة الميكانيكية)",
 "ばねはかり": "ميزان زنبركي (ميزان يقيس الوزن عن طريق الشد في زنبرك حلزوني)",
 "ばねばかり": "ميزان زنبركي (ميزان يقيس الوزن عن طريق الشد في زنبرك حلزوني)",
 "ばね仕掛け": "آلية الساعة (أي آلية من عجلات مسننة يتم تشغيلها بواسطة زنبرك ملفوف؛ تشبه أعمال الساعة الميكانيكية)",
 "ばね秤": "ميزان زنبركي (ميزان يقيس الوزن عن طريق الشد في زنبرك حلزوني)",
 "ばのりょうしろん": "نظرية الحقل الكمومي (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية.",
 "ばのりろん": "نظرية المجال ((فيزياء) نظرية تشرح ظاهرة فيزيائية من حيث مجال وطريقة تفاعله مع المادة أو مع مجالات أخرى)",
 "ばば": "خَرَاء, خِرَاء / خَرِئَ / بَرَّزَ, تَغَوَّطَ (خَرَجَ؛ نَبُه بعد خُمول) / بُرَاز, كَاكَا / جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة. / عَجُوز / جُوكَر / مضمار سباق (مسار تقام عليه السباقات)",
 "ばばあ": "عَجُوز / شَمْطَاء",
 "ばばくさい": "مُتَزَمِّت, وَسْوَاسِيّ (شَدِيد التَّدْقِيق بِشَكْلٍ مُتَزَمِّت)",
 "ばばこみ": "مَضْغُوط, مَكْبُوس (مضغوط معًا أو مكبوس بإحكام) / مَحْشُوّ, مُكْتَظّ (مُزْدَحِمٌ لِلغَايَةِ أَوْ مَمْلُوءٌ حَتَّى أَقْصَى طَاقَتِهِ)",
 "ばばっちい": "قَذِر, وَسِخ / وَسَّخَ (مادة غير نظيفة، خاصة عند ملامستها لملابس الشخص أو جلده أو ممتلكاته. في مثل هذه الحالة يقال أنها أصبحت مُتّسخة)\nمثال: أنت من وسخ الأرض.",
 "ばばぬき": "أولد ميد, العانس (لعبة ورق تستخدم حزمة أوراق أزيلت منها ملكة واحدة؛ يطابق اللاعبون الأوراق واللاعب الذي يحمل الملكة غير المطابقة في نهاية اللعبة هو الخاسر) / خاسر في لعبة العانس / عانس (امرأة مسنة غير متزوجة) / عناقية, عين البزون (عشب خشبي من العالم القديم يزرع عادة وله أزهار كبيرة وردية إلى حمراء)",
 "ばばばじゅつ": "ترويض الخيول, دريساج (مناورات الحصان استجابة لإشارات جسدية من الفارس)",
 "ばばー": "عَجُوز / شَمْطَاء",
 "ばば抜き": "أولد ميد, العانس (لعبة ورق تستخدم حزمة أوراق أزيلت منها ملكة واحدة؛ يطابق اللاعبون الأوراق واللاعب الذي يحمل الملكة غير المطابقة في نهاية اللعبة هو الخاسر) / خاسر في لعبة العانس / عانس (امرأة مسنة غير متزوجة) / عناقية, عين البزون (عشب خشبي من العالم القديم يزرع عادة وله أزهار كبيرة وردية إلى حمراء)",
 "ばひつ": "حِصَان, فَرَس (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: لم يشفى الحصان.",
 "ばひふう": "خُنَاق",
 "ばびそ": "رُعَام",
 "ばふんし": "مُنْخَفِض الدَّرَجَة",
 "ばふんづか": "كومة روث, مزبلة (كومة من الروث أو القمامة) / مزبلة (حالة قذرة أو متدهورة)",
 "ばぼう": "مَعْلِف, مُرَاح / بَسْطة",
 "ばむ": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "ばめん": "مَنْظَر, مَشْهَد / مَشْهَد",
 "ばめんてんかん": "معطف ذيل, معطف مشطوف (معطف رجالي مقصوص بشكل قطري من الخصر إلى خلف الركبتين) / رسم مقطعي (تمثيل (رسم أو نموذج) لشيء ما يتم فيه حذف الجزء الخارجي للكشف عن الأجزاء الداخلية)",
 "ばやい": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / عُلْبَة / حَالَات / دَعْوَى (إدِّعَاء؛ دُعَاء) / عُلَب\nمثال: سأرفع عليك قضية.",
 "ばやく": "كاناستا (شكل من أشكال الرومي يستخدم رزمتين من الأوراق وأربعة جوكر؛ الجوكر والاثنين هما أوراق حرة؛ الهدف هو تشكيل مجموعات من نفس الرتبة)",
 "ばら": "قِرْش, عُمْلَة",
 "ばらいろ": "لَامِع, نَيِّر / مُسْتَنِير",
 "ばらえん": "حديقة ورود (حديقة لزراعة الورود)",
 "ばらきせき": "رودونيت (معدن وردي أو أحمر يتكون من سيليكات المنغنيز البلورية؛ يستخدم كحجر زينة)",
 "ばらけつ": "جانح, حدث جانح (مذنب شاب)",
 "ばらしん": "طفح جلدي (أي طفح أحمر على الجلد)",
 "ばらじゅうじだん": "صليبي وردي (من أو متعلق بالصليب الوردي (روزيكروشيان)) / صَلِيبِيّ وَرْدِيّ (عضو في جمعية سرية في القرن السابع عشر للفلاسفة والعلماء) / عُضْو جَمْعِيَّة الصَّلِيب الوَرْدِيّ (عضو في أي من المنظمات المختلفة التي اشتقت لاحقاً من جمعية القرن السابع عشر)",
 "ばらす": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا. / بَاعَ (أَعْطَى الشيءَ بِثَمَن؛ اِشْتَرَى) / اِنْبَاعَ, بِيعَ\nمثال: باع زيري منزله.",
 "ばらせん": "سِلْك شَائِك (السِّلْكُ : الخيطُ الذي ينظَم فيه الخرز ونحوه، أَو الذي يخاط به؛ السِّلْكُ : خيط من معدن تسري فيه الكهرباء)\nمثال: هذا السلك ساخن. / قِرْش, عُمْلَة",
 "ばらつき": "تَفَاوُت, عَدَم اسْتِوَاء (صفة عدم التوازن) / تَبَايُن, تَفَاوُت (صفة كون الشيء غير مستوٍ وتنقصه الوحدة) / تَشَتُّت",
 "ばらつく": "مَطَر, مطر (السماء: أنزلت مَطَرًا) / أَمْطَرَ, مَطَرَ / أَمْطَرَ\nمثال: فجأة هطل المطر.",
 "ばらづみ": "جسامة, ضخامة (الخاصية التي تمتلكها كتلة كبيرة) / حجم, كتلة (خاصية الشيء الذي يكون كبيراً في المقدار) / أغلبية, أكثرية (الخاصية الناتجة عن كون الجزء هو الأكبر عدداً بين جزأين؛ الجزء الرئيسي)\nمثال: شراؤها بالجملة أرخص",
 "ばらのつぼみ": "فتاة يافعة ((إشارة أدبية إلى) فتاة شابة جميلة) / برعم الورد (برعم زهرة الورد)",
 "ばらばら": "مُتَفَرِّق",
 "ばらばらになる": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "ばらまき": "إِذَاعَة",
 "ばらまく": "نَثَرَ, تَفَرَّقَ",
 "ばらまど": "نافذة وردية (نافذة دائرية مليئة بالزخارف)",
 "ばらむつ": "السمكة الزيتية (ماكريل ثعباني كبير جداً يعيش في المياه العميقة)",
 "ばらもん": "بِرَهْمَن / براهمانية (المعتقدات الدينية للهند القديمة كما هو محدد في الكتب المقدسة الفيدا والبراهمانا والأوبنشاد) / البراهمية (النظام الديني والاجتماعي للهندوسية الأرثوذكسية)",
 "ばらもんきょう": "براهمانية (المعتقدات الدينية للهند القديمة كما هو محدد في الكتب المقدسة الفيدا والبراهمانا والأوبنشاد) / البراهمية (النظام الديني والاجتماعي للهندوسية الأرثوذكسية)",
 "ばらゆ": "زيت الورد (زيت عطري متطاير يتم الحصول عليه من الورود الطازجة بالتقطير بالبخار)",
 "ばらり": "مُتَفَرِّق / تحطيم, كسر (عملية كسر شيء ما)\nمثال: كان الكسر لا مفر منه",
 "ばら撒き": "إِذَاعَة",
 "ばら撒く": "نَثَرَ, تَفَرَّقَ",
 "ばら積": "جسامة, ضخامة (الخاصية التي تمتلكها كتلة كبيرة) / حجم, كتلة (خاصية الشيء الذي يكون كبيراً في المقدار) / أغلبية, أكثرية (الخاصية الناتجة عن كون الجزء هو الأكبر عدداً بين جزأين؛ الجزء الرئيسي)\nمثال: شراؤها بالجملة أرخص",
 "ばら積み": "جسامة, ضخامة (الخاصية التي تمتلكها كتلة كبيرة) / حجم, كتلة (خاصية الشيء الذي يكون كبيراً في المقدار) / أغلبية, أكثرية (الخاصية الناتجة عن كون الجزء هو الأكبر عدداً بين جزأين؛ الجزء الرئيسي)\nمثال: شراؤها بالجملة أرخص",
 "ばら色": "لَامِع, نَيِّر / مُسْتَنِير",
 "ばら蒔き": "إِذَاعَة",
 "ばら輝石": "رودونيت (معدن وردي أو أحمر يتكون من سيليكات المنغنيز البلورية؛ يستخدم كحجر زينة)",
 "ばら銭": "قِرْش, عُمْلَة",
 "ばり": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها. / ريشة حفر صغيرة, سنبُك حفر (ريشة صغيرة تستخدم في طب الأسنان أو الجراحة) / رايش, نتوء خشن (نتوء خشن يتبقى على قطعة العمل بعد الحفر أو القطع) / ريشة حفر, مبرد دوار (مبرد دوار لتنعيم الحواف الخشنة المتبقية على قطعة العمل) / ثَمَرَة شَائِكَة, حَسَك (وعاء بذور يحتوي على خطافات أو أشواك) / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / بَوْل",
 "ばりき": "حِصَان (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: لم يشفى الحصان. / طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد. / مجرور بالخيول (يسحب بواسطة حصان)\nمثال: عربة تجرها الخيول",
 "ばりきかじゅう": "حِمْل القُدْرَة (نسبة وزن الطائرة إلى قدرة محركها)",
 "ばりざんぼう": "إِهَانَة, سَبّ (تعبير وقح يهدف إلى الإساءة أو الأذى) / تَشْوِيه السُّمْعَة, تَلْطِيخ السُّمْعَة (تشهير افترائي)\nمثال: عندما ارتكب الطالب خطأ غبياً لم يوفر له أي شتيمة",
 "ばりっと": "أنيق, عصري (كائن أو متوافق مع الموضات الاجتماعية الحالية) / أنيق, عصري (لديه أناقة أو ذوق أو رقي في الأخلاق أو الملبس)\nمثال: ملابس عصرية",
 "ばりばり": "بقوة, بنشاط (بنشاط وحيوية)\nمثال: دافع عن أفكاره بقوة / بتصلب, بجمود (بطريقة متصلبة) / بشدة, حتى التجمد (لدرجة كبيرة (غالباً مع الخوف أو الملل)) / ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد) / جَامِد, مُتَصَلِّب (غَيْرُ قَابِلٍ لِلِانْثِنَاءِ أَوْ مُقَاوِمٌ لَهُ)\nمثال: استقرت يداه بتصلب / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "ばれい": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "ばれいしょ": "بَطَاطَا / بَطَاطِس",
 "ばればれ": "بَدِيهِيّ, بَدَهِيّ",
 "ばれる": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان) / غَادَرَ (تَرَكَ)\nمثال: خرج سامي ليحتفل.",
 "ばれん": "قُرْصِيّ, مُسَطَّحٌ دَائِرِيّ (ذو شكل دائري مسطّح كالقرص)",
 "ばろく": "لِجَام, صُرْع",
 "ばわい": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / عُلْبَة / حَالَات / دَعْوَى (إدِّعَاء؛ دُعَاء) / عُلَب\nمثال: سأرفع عليك قضية.",
 "ばをはなれる": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "ばん": "مَقَاس, قِيَاس / طَبْعَة / طَبَق, صَحْن (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ. / مَسَاء / عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: هل العشاء جاهز؟ / لَوْحَة, خَشَبَة / لَوْحَة, لَوْح / مَجْلِس, لَجْنَة / اِسْتَقَلَّ, صَعِدَ / تَسْجِيل, مُدَوَّنَة / سِجِلّ, دَفْتَر (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / رَقْم قِيَاسِيّ (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله. / تَمَامًا / عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟ / دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار. / سَاعَة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن) / حَارِس / رَصَدَ (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس) / حَذِرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: درست لمدة ساعة. / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / دجاجة الماء (أنثى طائر الطيهوج الأحمر) / دجاجة الماء (دجاجة ماء سوداء تسكن البرك والبحيرات)",
 "ばんい": "مُتَوَحِّش / هَمَجِيّ / مُتَوَحِّش, هَمَجِيّ",
 "ばんいち": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "ばんいつ": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "ばんか": "رِثَاء, مَرْثِيَة / طَمَاطِم / بَنَدُورَة / بَنْدُورَة",
 "ばんかい": "شِفَاء, تَعَافِي",
 "ばんかきょう": "مِشْكَال, مِنْظَارُ التَّهَاوِيل",
 "ばんから": "رَثّ, مُهْمَل المَظْهَرِ (بَالٍ وَغَيْرُ مُرَتَّبٍ)",
 "ばんかん": "مُتَأَخِّر النُّضْج (من النباتات التي تنضج في الخريف)",
 "ばんかんじょうみゃく": "وريد ضعفاني (واحد من الأوردة التي تخدم الجزء الإسفنجي من عظام القحف)",
 "ばんがい": "اِسْتِثْنَاء / اِسْتِثْنَاء, خَطَأ / إِضَافِيّ, زَائِد (أكثر من اللازم أو مُضاف إلى ما هو موجود) / بشكل إضافي, بشكل استثنائي (بشكل غير عادي أو استثنائي) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إِضَافِيّ, خَاصّ (مضاف إلى الجدول المنتظم)\nمثال: سيارة سريعة بشكل استثنائي / أَكْبَر مِن المُعْتَاد, مُفْرِط الحَجْم (أكبر من الحجم الطبيعي لنوعه) / حجم ضخم, مقاس استثنائي (مقاس ملابس غير عادي (خاصة المقاس الكبير جداً))",
 "ばんがん": "تَجْمِيعِيّ, مُتَكَتِّل (مؤلف من عناصر متباينة مجتمعة في كتلة واحدة) / تكتل شركات, مجموعة شركات (مجموعة من الشركات المتنوعة تحت ملكية مشتركة وتدار كمنظمة واحدة) / تكتلات صخرية, كونغلوميريت (صخر مركب يتكون من جزيئات متفاوتة الحجم)",
 "ばんき": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "ばんきん": "صاج, صفيحة معدنية (ورقة من المعدن مشكلة في لوحة رقيقة) / حديثاً, في الآونة الأخيرة (في الماضي القريب)\nمثال: كان في باريس مؤخراً",
 "ばんきんよろい": "تصفيح, درع صفيحي (صفيحة فولاذية مقواة خصيصاً تستخدم لحماية التحصينات أو المركبات من نيران العدو) / درع صفائحي, درع صفيحي (نوع تاريخي من الدروع الشخصية المصنوعة من صفائح الحديد أو الصلب، حلت محل الزرد خلال القرن الرابع عشر)\nمثال: أدت القوة المتزايدة للأسلحة النارية وتوفرها إلى التخلي عن أجزاء من الدرع الصفائحي لصالح قوات أرخص وأكثر قدرة على الحركة",
 "ばんぎく": "مُزْهِر فِي الخَرِيف (من النباتات التي تُزهر خلال فصل الخريف)",
 "ばんくるわせ": "مُسْتَاء, مُمْتَعِض / إخْلَال / أَسْخَطَ ((أأَسْخَطَه): أغضَبَهُ) / أَخَلَّ ((أَخَلَّ): رعت إبله الخلة؛ (أَخَلَّ) بالمكان وبمركزه وغيره: غاب عنه وتركه)",
 "ばんぐせつ": "يَوْم كَذْبَة أَبْرِيل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "ばんぐみ": "بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / بَرْمَجَ, وَضَعَ بَرْنَامَجًا / بَرْمَجَ\nمثال: نشط البرنامج الآن.",
 "ばんぐみへんせい": "بَرْمَجَة (فِي : هي عملية كتابة تعليمات وتوجيه أوامر لجهاز الحَاسُوبِ أو أي جهاز آخر مثل قارئات أقراص الدي في دي أو أجهزة استقبال الصوت والصورة في نظم الاتصالات…؛ اسم لفظي للفعل بَرْمَجَ)\nمثال: تسمح لغة البرمجة بكتابة البرامج الحاسوبية.",
 "ばんぐん": "مُضِيف (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم) / مُضِيف, آدِب (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم) / جُنْد, جَيْش (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)\nمثال: الجزائر العاصمة مدينة مضيفة جدا.",
 "ばんけん": "كلب حراسة (كلب مدرب لحراسة الممتلكات) / جِهَة رَقابِيَّة, حارِس (وصي أو مدافع ضد السرقة أو الممارسات غير القانونية أو الهدر)\nمثال: هي الرقيب العالمي على انتهاكات حقوق الإنسان",
 "ばんげい": "تعدد المهارات, موسوعية (امتلاك مجموعة واسعة من المهارات)",
 "ばんこ": "خُلْد (الثَبَات المَدِيد والبَقَاء لفترة طويلة؛ دَوَام البَقَاء، يختلف عن السَرْمَد في أن السرمد مختص بالزمان تحديدا والخلد في غير ذلك)\nمثال: خلد ياني إلى النوم.",
 "ばんこう": "بربرية",
 "ばんこく": "كُلِّيَّة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: في أي كلية تدرس؟ / سَخِيّ, غَزِير (يُوفِّر إمدادًا وافرًا وغزيرًا) / ضَخْم, غَزِير (كبير في العدد أو الكمّ، خاصّة في الكلام أو الكتابة) / بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "ばんこくおんぴょうもじ": "اَلْأَبْجَدِيَّة الصَّوْتِيَّة الدُّوَلِيَّة, الْأَلِفْبَائِيَّة الصَّوْتِيَّة الدُّوَلِيَّة",
 "ばんこくきょうつう": "عَالَمِيّ الاِنْتِشَار, عَالَمِيّ",
 "ばんこくこうほう": "قَانُون دُوَلِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "ばんこくこくさいおんぴょうもじ": "اَلْأَبْجَدِيَّة الصَّوْتِيَّة الدُّوَلِيَّة, الْأَلِفْبَائِيَّة الصَّوْتِيَّة الدُّوَلِيَّة",
 "ばんこくひょうじゅんじ": "التوقيت العالمي, توقيت غرينتش (التوقيت المحلي عند خط الصفر المار عبر غرينتش، إنجلترا؛ وهو نفسه في كل مكان)",
 "ばんこつ": "تَهَوُّر (التسرع والاندفاع لفعل شيء دون التفكير بالنتائج)\nمثال: إنه خطر أن تقود بتهور.",
 "ばんご": "لُغَة أَجْنَبِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "ばんごう": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟ / أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "ばんごうきごう": "جنيه, علامة الجنيه (رمز لوحدة العملة (خاصة للجنيه الإسترليني في بريطانيا العظمى))",
 "ばんごはん": "عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: هل العشاء جاهز؟",
 "ばんさい": "شَيْخُوخَة, عُجُوز",
 "ばんさいるい": "أسماك غضروفية, صفيحية الخياشيم (أي من الأسماك العديدة من طائفة الأسماك الغضروفية التي تتميز بهيكل غضروفي وحراشف درعية: أسماك القرش، الشفنينيات، الزلاجات)",
 "ばんさん": "عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: هل العشاء جاهز؟",
 "ばんさんかい": "وَلِيمَة, مَأْدُبَة (طعام العُرْس؛ أي طعام صنع لدعوة ولجمع كبير من الناس)\nمثال: كانت الوليمة من أطيب ما ذقت.",
 "ばんざい": "بانزاي (هتاف ياباني للحماس أو النصر) / ترك, هجران (فعل الهجر أو التخلي) / إذعان, استسلام (فعل لفظي للاعتراف بالهزيمة)",
 "ばんしゃ": "شُكْرًا, شُكْرًا جَزِيلًا",
 "ばんしゅ": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "ばんしゅう": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "ばんしょ": "سجن عسكري, مركز حراسة (منشأة عسكرية تعمل كمقر للشرطة العسكرية ويمكن فيها احتجاز السجناء العسكريين) / حَاجِز, نُقْطَة تَفْتِيش / بَطَاطَا حُلْوَة",
 "ばんしょう": "غُرُوب, مَغْرِب (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / غُرُوب اَلشَّمْس (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / خَاتِمَة, قَيَامَة\nمثال: نحب غروب الشمس. / مَنْعُ التَّجَوُّل, حَظْرُ التَّجَوُّل (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه) / مَوْعِد الحَظْر (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة. / نَبَات فُلْفُل (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / فُلَيْفِلَة\nمثال: هذا النبات مهدد بالانقراض.",
 "ばんしょく": "عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / تَعَشَّى (تَنَاوَلَ العَشَاء)\nمثال: هل العشاء جاهز؟",
 "ばんじ": "كُلّ, جَمِيع",
 "ばんじばんたん": "كُلّ شَيْء",
 "ばんじゃく": "ثَبَات",
 "ばんじゅ": "أقدمية, طول العمر (خاصية العيش طويلاً) / تعمير, طول الخدمة (مدة الخدمة أو البقاء)\nمثال: طول بقائها كنجمة",
 "ばんじゅう": "حيوان جر (حيوان يستخدم لسحب الأحمال الثقيلة)",
 "ばんじょう": "مُبَارَك, مَبْرُوك / سِيَادَة, حَاكِمِيَّة (السِّيَادةُ : الشرفُ؛سادَ يَسُودُ سِيَادَةً، والاسمُ السُّؤدُد، وَهُوَ المَجْدُ و الشَّرفُ؛ ساد يسود سيادةً وسُودَداً وسؤْدُداً :عظُم ومجُد وشرُف)\nمثال: أوكرانيا دولة ذات سيادة. / تَنْوِيع",
 "ばんじん": "اَلْجَمِيع, كُلّ شَخْص / مُتَوَحِّش / هَمَجِيّ / مُتَوَحِّش, هَمَجِيّ",
 "ばんじんのたに": "هَاوِيَة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة) / هَاوِيَة, هُوَّة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة)\nمثال: وصل سامي إلى قاع الهاوية ماليا.",
 "ばんせい": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "ばんせいせい": "عاجِز عِنْد الفَقْس ((للفراخ) عارية وعمياء ومعتمدة على الوالدين في الغذاء)",
 "ばんせいせつ": "عِيدُ جَمِيعِ اَلْقِدِّيسِين",
 "ばんせいふえき": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "ばんせん": "مقياس الأسلاك (مقياس لقياس قطر السلك) / إِعْلَان, تَرْوِيج (رسالة تصدر لصالح منتج أو قضية أو فكرة أو شخص أو مؤسسة)\nمثال: تغليف الأفكار الجديدة",
 "ばんぜん": "كَمَال, إتقان",
 "ばんそう": "مُصَاحَبَة / مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / مِقْلَاة (وعاء قلي الطعام) / ينتقد بشدَة",
 "ばんそうこう": "ضمادة لاصقة (ضمادة تتكون من قطعة شاش ماص مثبتة بشريط بلاستيكي أو قماشي مطلي بمادة لاصقة)",
 "ばんそうしゃ": "مصاحب موسيقي (شخص يقدم مصاحبة موسيقية (عادة على البيانو))",
 "ばんそうぶ": "مُصَاحَبَة",
 "ばんそつ": "حارِس, خَفِير (شخص يتم توظيفه للمراقبة تحسباً لحدث متوقع)",
 "ばんた": "حَارِس",
 "ばんたろう": "حَارِس",
 "ばんたん": "كُلّ, جَمِيع",
 "ばんだい": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "ばんだいそう": "حَيّ الْعَالَم (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "ばんだいふえき": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "ばんち": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "ばんづけ": "بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / بَرْمَجَ, وَضَعَ بَرْنَامَجًا / بَرْمَجَ\nمثال: نشط البرنامج الآن.",
 "ばんて": "عَدَّ / كُونْت",
 "ばんてき": "مُتَوَحِّش / هَمَجِيّ / مُتَوَحِّش, هَمَجِيّ",
 "ばんとう": "صلاة الغروب, صلاة المساء (السادسة من الساعات القانونية السبع للمكتب الإلهي؛ في وقت مبكر من المساء)",
 "ばんど": "أكسيد الألمنيوم, ألومينا (أي من أشكال أكسيد الألمنيوم المختلفة التي توجد بشكل طبيعي مثل الكورندوم)",
 "ばんどういるか": "دلفين قاروري الأنف (أي من عدة دلافين ذات جبهة مستديرة ومنقار متطور؛ تعيش بشكل رئيسي في شمال المحيط الأطلسي والبحر الأبيض المتوسط)",
 "ばんどうさんじゅうさんしょ": "ثَلَاثَة وَثَلَاثُون (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "ばんどころ": "سجن عسكري, مركز حراسة (منشأة عسكرية تعمل كمقر للشرطة العسكرية ويمكن فيها احتجاز السجناء العسكريين)",
 "ばんなんをはいして": "بِأَيِّ ثَمَنٍ",
 "ばんにん": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي. / اَلْجَمِيع, كُلّ شَخْص",
 "ばんにんむき": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "ばんのう": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة) / قَدِير, كُلِّيّ القُدْرَة (يمتلك قدرة غير محدودة)",
 "ばんのうきょうけつしゃ": "متبرع عام",
 "ばんのうほうちょう": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "ばんのうやく": "ترياق عام, دواء لكل داء (علاج افتراضي لجميع العلل أو الأمراض؛ كان يسعى إليه الخيميائيون)",
 "ばんのうよごれおとし": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "ばんのうナイフ": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "ばんば": "حصان الجر (حصان متكيف لجر الأحمال الثقيلة)",
 "ばんばん": "بالكامل, تماماً (إلى أقصى درجة أو مدى؛ بشكل كامل أو كلي) / بشكل واف, تماماً (بشكل كاف؛ أكثر من ملائم) / بالكامل (في إشارة إلى كمية)\nمثال: نمى بالكامل / أَبَدًا",
 "ばんぴぎょるい": "لوحيات الأدمة (فقاري يشبه السمكة بصفائح عظمية على الرأس والجزء العلوي من الجسم؛ ساد في البحار والأنهار خلال العصر الديفوني؛ يعتبر أقدم الفقاريات ذات الفكوك)",
 "ばんぴるい": "لوحيات الأدمة (فقاري يشبه السمكة بصفائح عظمية على الرأس والجزء العلوي من الجسم؛ ساد في البحار والأنهار خلال العصر الديفوني؛ يعتبر أقدم الفقاريات ذات الفكوك)",
 "ばんぶつのれいちょう": "إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق.",
 "ばんぺい": "حارِس, خَفِير (شخص يتم توظيفه للمراقبة تحسباً لحدث متوقع)",
 "ばんめし": "عَشَاء (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: هل العشاء جاهز؟",
 "ばんめん": "لَوْحَة, خَشَبَة / لَوْحَة, لَوْح / مَجْلِس, لَجْنَة / اِسْتَقَلَّ, صَعِدَ",
 "ばんや": "كشك الحراسة (مأوى صغير مفتوح من الأمام لحماية الحارس من الطقس)",
 "ばんゆう": "تهور, طيش (سمة إيلاء القليل من التفكير للخطر) / كُلِّيَّة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: في أي كلية تدرس؟",
 "ばんゆういんりょくていすう": "ثَابِت الْجَاذِبِيَّة, ثَابِت الْجَذْب الْعَامّ ((في الفيزياء) الثابت العام الذي يربط القوة بالكتلة والمسافة في قانون نيوتن للجاذبية)",
 "ばんゆうざいしんろん": "الكل في الله, وحدة الشهود (الاعتقاد بأن الله موجود في جزء من الكون وظواهره ويتجاوز الكون أيضاً ويتدخل في عملياته)",
 "ばんゆうしんきょう": "وَحْدَة اَلْوُجُود",
 "ばんゆうないざいしんろん": "الكل في الله, وحدة الشهود (الاعتقاد بأن الله موجود في جزء من الكون وظواهره ويتجاوز الكون أيضاً ويتدخل في عملياته)",
 "ばんりのちょうじょう": "سُور اَلصِّين اَلْعَظِيم",
 "ばんりゅうるい": "بيليكوصور (زاحف بدائي كبير له شراع شوكي طويل؛ من العصر البرمي أو أواخر العصر القديم في أوروبا وأمريكا الشمالية)",
 "ばんりょ": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "ばんれいさい": "2 نوفمبر, عيد جميع الموتى (يوم للتضرع من أجل جميع الأرواح في المطهر)",
 "ばんれいし": "تفاح السكر, قشطة سكرية (فاكهة استوائية لبية حلوة ذات قشرة حرشفية سميكة وبذور سوداء لامعة) / سكر التفاح, قشطة حرشفية (شجرة استوائية أمريكية تحمل فاكهة لبية حلوة بقشرة حرشفية سميكة وبذور سوداء لامعة)",
 "ばんれいせつ": "2 نوفمبر, عيد جميع الموتى (يوم للتضرع من أجل جميع الأرواح في المطهر)",
 "ばんカラ": "رَثّ, مُهْمَل المَظْهَرِ (بَالٍ وَغَيْرُ مُرَتَّبٍ)",
 "ばん馬": "حصان الجر (حصان متكيف لجر الأحمال الثقيلة)",
 "ばーさん": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة. / عَجُوز",
 "ばーちゃん": "جِدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم) / تِيتَة\nمثال: كان لزيري جد و جدة. / زوجة (زوجتك الخاصة (مصطلح عامي))\nمثال: قابل زوجتي",
 "ばーば": "جَدَّة, تِيتَة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة.",
 "ぱ": "لِكُلّ وَاحِد (لكل فرد من اثنين أو أكثر (يعتبرون بشكل فردي))\nمثال: حصل كل واحد منهم على 10 دولارات",
 "ぱあ": "وَرَق, قِرْطَاس (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها) / وَرَقَة / وَرَقِيّ\nمثال: هات ورقة بيضاء. / حَمَاقَة (خطأ سخيف)",
 "ぱあっと": "بحماس / بإطراء شديد, بحماس بالغ (بطريقة مسرفة أو متحمسة)\nمثال: ناقشوا السؤال بحماس",
 "ぱあん": "فَرْقَعَة",
 "ぱいおつ": "ثَدْي",
 "ぱいせん": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / أرفع مقاماً, أقدم (أكبر سنًا؛ أعلى رتبة؛ أطول في مدة الولاية أو الخدمة) / أَكْبَر سِنّاً, مُسِنّ (شخص أكبر منك سناً) / طالب سنة نهائية (طالب جامعي خلال السنة التي تسبق التخرج)\nمثال: ضابط كبير",
 "ぱいぱい": "أطيش (أطيش استوائي صغير ذو منقار ساطع أو أقدام ساطعة أو كليهما) / أحمق, جاهل (شخص جاهل أو أحمق) / حَلِيب (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ) / لَبَن (سَقَاهُ اللَبَن؛ أكل كثيرا) / حَلَبَ (الشاةَ أو البقرةَ أو الناقةَ: استخرج ما في ضرعها من لبن؛ فلانٌ للرجل: أي حَلَب ماشية الرجل نيابة عنه)\nمثال: كنت أشرب الحليب",
 "ぱかぱか": "حَبَطَقْطَقْ",
 "ぱからっぱからっ": "حَبَطَقْطَقْ",
 "ぱかん": "بذهول, بفراغ (بطريقة خالية من التعبير)\nمثال: كانت تحدق بذهول في الغرفة / جَاحِظ العَيْنَيْن, فَاغِر الفَم (مفتوح العينين أو الفم من شدة الدهشة)",
 "ぱくっ": "بعيداً, على نطاق واسع (إلى أو على مدى أو نطاق كبير؛ بعيداً) / بتباعد (بحيث تترك مساحة كبيرة أو مسافة بين الأشياء)\nمثال: تجول بعيداً عبر العديد من الأراضي",
 "ぱくぱく": "شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / بحماس, بقلب قوي (بمتعة ودون تحفظ) / بحرارة, بقلب خالص (بطريقة قلبية)\nمثال: ألقى الصبي بنفسه بحماس في عمله",
 "ぱくり": "فَاغِر الفَم, مَفْتُوح الفَم (مفتوح الفم على وسعه كما في حالة الدهشة أو الذهول) / اِنْتِحال",
 "ぱくりや": "محتال, مخادع (محتال ذكر يستغل ثقة ضحيته)",
 "ぱくる": "إمساك, التقاط (فعل التقاط شيء باليدين) / خطف (رفعة أوزان يتم فيها رفع البار فوق الرأس في حركة واحدة سريعة) / اختطاف, خطف ((قانون) العمل غير القانوني المتمثل في القبض على شخص وحمله بعيداً رغماً عنه واحتجازه في سجن زائف) / فرج (مصطلحات بذيئة للأعضاء التناسلية الأنثوية)\nمثال: أمسك ميس بالكرة وظهره للوحة / سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟ / تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "ぱくんちょ": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "ぱぐれる": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "ぱこる": "فَرْقَعَة",
 "ぱさぱさ": "مُجَفَّف كُلِّيًّا (جُفِّف بالكامل ونُزعت منه كلّ الرطوبة)",
 "ぱしっ": "قَتَلَ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "ぱしゃん": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "ぱしり": "ساعي, مرسال (موظف تشمل واجباته قضاء المهمات الصغيرة والمشاوير)",
 "ぱたっと": "فَجْأَةً",
 "ぱたぱた": "خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / خفقاً, دقا (وصف لضربات إيقاعية (مثل القلب)) / بخطوات خفيفة, طقطقة (كما في صوت الخطوات الخفيفة) / طقطقة, نقر سريع (سلسلة من أصوات النقر السريعة)\nمثال: قلبه كان يخفق / بِسُرْعَة, عَاجِلًا",
 "ぱたり": "فَجْأَةً",
 "ぱたん": "فَجْأَةً",
 "ぱちくり": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة) / رَامِش, طَارِف (يُغلق العينين بشكل متقطع وسريع)",
 "ぱちこく": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "ぱちっ": "جَاحِظ, وَاسِع العَيْنَيْن ((يوصف به العينان) مفتوحتان بالكامل أو متّسعتان) / سَاذَج, طِفْلِيُّ البَرَاءَة (يُظهر بساطة طفوليّة وسذاجة في التصديق)",
 "ぱちぱち": "طقطقة, فرقعة (الصوت الحاد لأصوات الانكسار) / بقايا الشحم (البقايا التي تتبقى بعد إذابة الدهون الحيوانية) / تصفيق (إظهار الموافقة عن طريق ضرب اليدين ببعضهما البعض) / باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل)\nمثال: العالم يتغير باستمرار",
 "ぱちもの": "تزوير (التزييف الجنائي عن طريق صنع أو تغيير مستند بنية الاحتيال) / تزوير, تزييف (نسخة يتم تقديمها على أنها الأصل)",
 "ぱちもん": "تزوير (التزييف الجنائي عن طريق صنع أو تغيير مستند بنية الاحتيال) / تزوير, تزييف (نسخة يتم تقديمها على أنها الأصل)",
 "ぱちる": "سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "ぱちんこ": "باتشينكو (لعبة بينبول يابانية تُلعب على لوحة عمودية) / مِقْلَاع / مُسَدَّس (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ) / فَرْد / طَبَنْجَة / غَدَّارَة\nمثال: كان عند زيري مسدس.",
 "ぱち物": "تزوير (التزييف الجنائي عن طريق صنع أو تغيير مستند بنية الاحتيال) / تزوير, تزييف (نسخة يتم تقديمها على أنها الأصل)",
 "ぱっくり": "فَاغِر الفَم, مَفْتُوح الفَم (مفتوح الفم على وسعه كما في حالة الدهشة أو الذهول)",
 "ぱっくんちょ": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "ぱったり": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة / فَجْأَةً",
