 "せいはんしょ": "مَنْشَرَة",
 "せいはんのう": "رَدّ فِعْل, تَفَاعُل (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / تَفَاعُل (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به)\nمثال: اليوم هناك برد.",
 "せいばい": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر. / قَطْعُ الرَّأَس (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "せいばつ": "فَتْح, اِسْتِيلَاء (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين)\nمثال: فتح الباب آليا. / تأنيب, توبيخ (عقاب لفظي) / تَأْدِيب, تَقْوِيم (توبيخ لارتكاب خطأ)",
 "せいばんじょ": "مَنْشَرَة",
 "せいばんもろこし": "عشب جونسون, عشب حلب (عشب معمر طويل ينتشر عن طريق الجذامير الزاحفة ويزرع للعلف؛ متوطن في جنوب الولايات المتحدة حيث يعتبر آفة خطيرة في الأراضي المزروعة)",
 "せいひ": "نَتِيجَة / ملكة قرينة (زوجة الملك الحاكم)",
 "せいひがい": "إِسَاءَة جِنْسِيَّة",
 "せいひつ": "إِغْفَال / سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام. / تَابُوت اَلْعَهْد (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل) / كنيس, معبد يهودي ((اليهودية) مكان العبادة لجماعة يهودية) / المسكن, خيمة الاجتماع ((اليهودية) مزار محمول حمل فيه اليهود تابوت العهد أثناء خروجهم)",
 "せいひょうき": "صانعة ثلج (جهاز مُدمج في بعض الثلاجات الكهربائية لصنع مكعبات الثلج) / عداد (آلة حاسبة تحتفظ بسجل لعدد المرات التي يحدث فيها شيء ما) / آلة جدولة (آلة كهروميكانيكية مصممة للمساعدة في تلخيص المعلومات، ولاحقاً، المحاسبة)",
 "せいひょうげん": "تَعْبِير جَنْدَرِي",
 "せいひょうしゃ": "زامبوني (العلامة التجارية لآلة تسوي الجليد في حلبة التزلج على الجليد)",
 "せいひょうじょ": "نبات الثلج, نبات الجليد (نبات سنوي من العالم القديم متوطن على نطاق واسع في المناطق الدافئة ذو زهور بيضاء وأوراق لحمية مغطاة بشعيرات تشبه الجليد)",
 "せいひん": "ضيف الشرف (الشخص الذي يُعقد التجمع تكريماً له) / مُنْتَج / سِلْعَة / حَاصِل (الشيء :حصل عليه) / مَحْصُول / حَاصِل ضَرْب (الشيء :حصل عليه) / جَدَاء",
 "せいひんかいしゅう": "ٱسْتَدْعى / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / سَحْبٌ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: ليلى تذكر سامي.",
 "せいひんぐん": "تشكيلة منتجات, خط إنتاج (نوع معين من المنتجات أو البضائع)\nمثال: تشكيلة جميلة من الأحذية",
 "せいひんライン": "تشكيلة منتجات, خط إنتاج (نوع معين من المنتجات أو البضائع)\nمثال: تشكيلة جميلة من الأحذية",
 "せいび": "صِيَانَة / إِعْمَار, تَعْمِير / تكامل, توحيد (عملية الدمج في كلٍ متكامل) / تصلب, تماسك (التجمع في كتلة صلبة) / كُتْلَة مُتَصَلِّبَة (شيء تصلب ليصبح كتلة مدمجة)\nمثال: دمج شركتين / إتقان, جمال فائق (جمال فائق من نوع دقيق) / مُفَصَّل",
 "せいびいん": "حارس الحديقة, مسؤول الملاعب (شخص يحافظ على الأراضي (في عقار أو حديقة أو ملعب رياضي))",
 "せいびき": "بحث (عملية تحدد ما إذا كان عنصر واحد أو أكثر من مجموعة عناصر يمتلك خاصية محددة)\nمثال: كتبوا برنامجاً للبحث في الجدول",
 "せいびこう": "مِيكَانِيكِيّ",
 "せいびこうじょう": "ورشة إصلاح (محل متخصص في الإصلاح والصيانة)",
 "せいびし": "مِيكَانِيكِيّ",
 "せいびしつ": "مَهَمَّة",
 "せいびせい": "صَلَاحِيَّة الخِدْمَة, قَابِلِيَّة الاسْتِخْدَام (صفة القدرة على تقديم خدمة جيدة)",
 "せいびへい": "طاقم أرضي (طاقم الفنيين والميكانيكيين الذين يخدمون الطائرات على الأرض)",
 "せいびょう": "دَاء مَنْقُول جِنْسِيًّا",
 "せいふ": "حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة.",
 "せいふう": "رياح غربية (رياح تهب من الغرب إلى الشرق) / متنفس, نسمة هواء عليل (ارتياح مرحب به)\nمثال: كانت الإدارة الجديدة بمثابة نسمة هواء عليل / تقويم المنحنى (تحديد طول منحنى؛ إيجاد خط مستقيم مساوٍ في الطول لمنحنى معين) / تصحيح, تعديل (فعل تقديم تحسين لاستبدال خطأ؛ تقويم) / تقويم (تحويل التيار المتردد إلى تيار مباشر) / تقطير, تكرير ((في الكيمياء) عملية تكرير أو تنقية مادة ما عن طريق التقطير)",
 "せいふうぞく": "بِغَاءٌ, دَعَارَة",
 "せいふうぞくてん": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "せいふきかん": "مكتب, هيئة (وحدة إدارية حكومية)\nمثال: وكالة الاستخبارات المركزية",
 "せいふく": "زَيّ, زِي\nمثال: 私たちの学校では制服を着る。 — نحن ترتدي الزي الرسمي في مدرستنا. / فَتْح, اِسْتِيلَاء (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين)\nمثال: فتح الباب آليا. / هَزَمَ, غَلَبَ / شَرْعِيَّة / سَعَادَة, فَرَح / إيداع, تخزين (الإيداع في مستودع)\nمثال: قرروا إيداع أثاثهم في مستودع موصى به في بروكلين",
 "せいふくし": "أخصائي في العلاج الطبيعي, أخصائية في العلاج الطبيعي",
 "せいふくしゃ": "غَازٍ",
 "せいふごう": "عَلَامَة زَائِد, عَلَامَةُ جَمْع (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "せいふざい": "مُعَقِّمٌ",
 "せいふん": "تخريش الحافة (الحافة المموجة لعملة معدنية)",
 "せいふんき": "آلة تفريز (أداة آلية يتم فيها تغذية المعدن المثبت على عربة ضد قواطع دوارة تشكله)",
 "せいふんしょ": "طاحونة دقيق (طاحونة لطحن الحبوب وتحويلها إلى دقيق)",
 "せいふんじょ": "طاحونة دقيق (طاحونة لطحن الحبوب وتحويلها إلى دقيق)",
 "せいぶ": "غَرْب (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَغْرِب (مَكَان غُرُوب الشَمْس، ويقصد به الغَرْب مجَازًا؛ زَمَان غروب الشمس) / غرب (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم)\nمثال: تغرب الشمس في الغرب.",
 "せいぶげき": "غَرْبِيّ / وِيسْتَرْن, الْغَرْب",
 "せいぶつ": "شَيْء حَيّ, كَائِن حَيّ (كيان حيّ أو كان حيًّا في وقت ما) / عِلْم اَلْأَحْيَاء, بِيُولُوجِيَا (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / طبيعة صامتة (لوحة لأشياء جامدة مثل الفاكهة أو الزهور)",
 "せいぶつかい": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "せいぶつかいようがく": "علم الأحياء البحرية (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "せいぶつかがく": "كِيمِيَاء حَيَوِيَّة (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما إلى الذهب؛ علم من علوم الطبيعة يتناول خواص العناصر والمركبات والقوانين التي تحكم تفاعلاتها)\nمثال: هو يحب الكيمياء.",
 "せいぶつかがくてきさんそようきゅうりょう": "جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان",
 "せいぶつが": "طبيعة صامتة (لوحة لأشياء جامدة مثل الفاكهة أو الزهور)",
 "せいぶつがく": "عِلْم اَلْأَحْيَاء, بِيُولُوجِيَا (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "せいぶつがくしゃ": "أَحْيَائِي (إلى أَحْيَاء؛ الأحيائي أو عالم الأحياء هو الشخص المتخصص في علم الأحياء، والذي يدرس تركيب وآلية عمل المتعضيات والأنظمة الحية أو علاقتها بالبيئة)\nمثال: هو عالم أحيائي.",
 "せいぶつがくしゅぎ": "بيولوجية, تفسير بيولوجي (استخدام المبادئ البيولوجية في تفسير السلوك البشري وخاصة الاجتماعي)",
 "せいぶつがくてき": "بِيُولُوجِيّ, أَحْيَائِي",
 "せいぶつがくてきせいざい": "بِيُولُوجِيّ, أَحْيَائِي",
 "せいぶつがくてきたようせい": "تَنَوُّع البِيُولُوجِيّ",
 "せいぶつぐんしゅう": "مجتمع حيوي ((في علم البيئة) مجموعة من الكائنات الحية المترابطة التي تسكن نفس المنطقة وتتفاعل مع بعضها البعض)",
 "せいぶつけい": "بِيُولُوجِيّ, أَحْيَائِي",
 "せいぶつけん": "غلاف حيوي, محيط حيوي (مناطق سطح الأرض وغلافها الجوي (أو كوكب آخر) حيث توجد الكائنات الحية)",
 "せいぶつけんてい": "مقايسة حيوية (تقييم النشاط البيولوجي لمادة ما عن طريق اختبار تأثيرها على كائن حي ومقارنة النتيجة ببعض المعايير المتفق عليها)",
 "せいぶつこうがく": "الأرغونوميا, تكنولوجيا حيوية (فرع العلوم الهندسية الذي تُستخدم فيه العلوم البيولوجية لدراسة العلاقة بين العمال وبيئاتهم) / تكنولوجيا حيوية (فرع البيولوجيا الجزيئية الذي يدرس استخدام الكائنات الحية الدقيقة لأداء عمليات صناعية محددة)\nمثال: أنتجت التكنولوجيا الحيوية بكتيريا معدلة وراثياً حلت المشكلة",
 "せいぶつざい": "خطر بيولوجي, عامل بيولوجي (أي بكتيريا أو فيروس أو سم يمكن استخدامه في الحرب البيولوجية)",
 "せいぶつせん": "حرب بيولوجية, هجوم بيولوجي (استخدام البكتيريا أو الفيروسات أو السموم لتدمير البشر والحيوانات أو الغذاء)",
 "せいぶつそう": "الحياة البيولوجية, كائنات حية (جميع الكائنات الحية النباتية والحيوانية في منطقة معينة)",
 "せいぶつそくていがく": "إحصاء حيوي, قياسات حيوية (فرع من علم الأحياء يدرس الظواهر والملاحظات البيولوجية عن طريق التحليل الإحصائي)"
}
