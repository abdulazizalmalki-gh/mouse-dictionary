 "すうきけい": "كارْدِينال, كَرْدِينَال",
 "すうけい": "تبجيل, تعظيم (عمل يظهر الاحترام (خاصة الانحناء))\nمثال: خشية الله",
 "すうこ": "بَعْض, عِدَّة ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما)\nمثال: لديك بعض الكتب.",
 "すうこう": "شَاهِق / رَفِيع, سَامٍ (مَرْفُوعُ الشَّأْنِ؛ فِي حَالَةِ سُمُوٍّ رُوحِيّ) / مَيْل, نَزَعَة",
 "すうこく": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "すうし": "عَدَد, رَقْم (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "すうしゅうかん": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "すうしゅん": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "すうじ": "عَدَد, رَقْم (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟ / حركة فنية (مجموعة محددة مسبقاً من الحركات في الرقص أو التزلج)\nمثال: حققت أفضل درجة في الحركات الإلزامية / قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "すうじあそび": "لعبة الأرقام (يانصيب يومي غير قانوني)",
 "すうじかん": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "すうじく": "إكس, مِحْوَر (عمود تدور عليه العجلة) / مَرْكَز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟ / مِحْوَر",
 "すうじくこく": "قوة التحلف (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة.",
 "すうじゅう": "أطنان, أكوام (عدد أو كمية كبيرة)\nمثال: كون الكثير من الصداقات الجديدة",
 "すうすう": "أَزْمِيّ, رَبْوِيّ (مُتَعَلِّق بِالتَّنَفُّس بِصَوْت صَفير)",
 "すうせい": "مَيْل, نَزَعَة",
 "すうせき": "بَعْض, عِدَّة ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما)\nمثال: لديك بعض الكتب.",
 "すうせん": "أَلْف, ١٠٠٠ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن…)\nمثال: ألف شكر على لطفك.",
 "すうた": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "すうたいけい": "نظام أعداد, نظام عد (أي تدوين لتمثيل الأعداد)",
 "すうだん": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "すうち": "قِيمَة عَدَدِيَّة, قِيمَة مُطْلَقَة (عدد حقيقي بغض النظر عن إشارته) / حركة فنية (مجموعة محددة مسبقاً من الحركات في الرقص أو التزلج)\nمثال: حققت أفضل درجة في الحركات الإلزامية",
 "すうちか": "تكميم, قياس كمي (فعل اكتشاف أو التعبير عن كمية شيء ما)",
 "すうちかいせき": "تحليل عددي ((رياضيات) فرع الرياضيات الذي يدرس خوارزميات لتقريب حلول لمشاكل في التفاضل…)",
 "すうちてき": "رَقْمِيّ, عَدَدِيّ (مُقَاس أو مُعَبَّر عنه بالأرقام)\nمثال: صفة عددية",
 "すうちょくせん": "عَدَد حَقِيقِيّ (أي عدد نسبي أو غير نسبي)",
 "すうっと": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم. / بِهُدُوء",
 "すうてき": "عَدَدِيّ, رَقْمِيّ",
 "すうとう": "إلى حد بعيد, بكثير (بفارق كبير)\nمثال: كانت الطالبة الأذكى بمراحل / قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "すうど": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "すうどく": "سُودُوكُو",
 "すうにん": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "すうねん": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "すうねんご": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "すうねんまえ": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "すうはい": "عِبَادَة\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "すうはいしゃ": "عَابِد\nمثال: アンには崇拝者が多い。 — آن لديها الكثير من المعجبين.",
 "すうひがく": "علم الأرقام (دراسة التأثير الخفي المفترض للأرقام على الشؤون الإنسانية)",
 "すうひじゅつ": "علم الأرقام (دراسة التأثير الخفي المفترض للأرقام على الشؤون الإنسانية)",
 "すうひゃく": "مِٱئَة, مِئَة",
 "すうひゃくまん": "مِلْيُون, ١٠٠٠٠٠٠",
 "すうひょうげん": "إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي)\nمثال: استمر العد لعدة ساعات",
 "すうひょうじ": "عَدَد, رَقْم (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "すうびょう": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "すうふん": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "すうふんかん": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "すうふんご": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "すうみつ": "سِرّ دَوْلَة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "すうみついん": "المجلس الخاص (مجلس استشاري للحاكم (خاصة للتاج البريطاني))",
 "すうめい": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)",
 "すうよう": "مُهِمّ",
 "すうり": "رِيَاضَة, رِيَاضِيَّات / حساب, العدّ (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن…)\nمثال: الحساب لو سمحت.",
 "すうりけいかくシステム": "نظام البلعميات وحيدة النواة (نظام واسع الانتشار من البلاعم الحرة والثابتة المشتقة من نخاع العظم)",
 "すうりしゃかいがっかい": "مُرَبًّى",
 "すうりょう": "كَمِّيَّة, مِقْدَار",
 "すうりょうし": "مُحَدِدْ الْكَمِيَّةْ (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد…)\nمثال: حضر الجميع إلى الصف في الوقت المحدد",
 "すうりょうてき": "كمي (يمكن التعبير عنه ككمية أو يتعلق بـ أو قابل للقياس)\nمثال: تصدير القمح دون قيود كمية",
 "すうりろんりがく": "منطق رمزي, منطق رياضي (أي نظام منطقي يجرد شكل العبارات بعيدًا عن محتواها لتأسيس معايير مجردة للاتساق…)",
 "すうれつ": "مُتَتَالِيَة, مُتَوَالِيَة",
 "すえ": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري. / أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا / مُسْتَقْبَل / بعد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / فَخَّار, خَزَف\nمثال: هذا البلد مدعوم بالصناعة.",
 "すえおき": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق) / مَحْكُومٌ عَلَيْه, مَلْعُون (مُعرَّض لعذاب جهنم الأبدي)",
 "すえおきがた": "سَطْح الْمَكْتَب (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)\nمثال: هناك ثقوب على السطح.",
 "すえおききかん": "فترة السماح",
 "すえおそろしい": "مُجَفِّل, مُخِيف",
 "すえきち": "بِالتَّوْفِيق!, حَظًّا سَعِيدًا!",
 "すえしじゅう": "إِلَى الْأَبَد (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "すえずえ": "أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا / الطَّبَقَاتُ الدُّنْيَا",
 "すえたのもしい": "مُشْرِق, وَاعِد (من المرجح أن يسير على نحو جيد في المستقبل)"
}
