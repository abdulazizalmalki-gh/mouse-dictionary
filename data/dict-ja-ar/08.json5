 "しんじゅこうたく": "تقزح, تلاعب لوني (الخاصية البصرية لشيء له سطوع حليبي وتلاعب بالألوان من السطح)",
 "しんじゅさん": "عثة سينثيا (عثة آسيوية كبيرة أُدخلت إلى الولايات المتحدة؛ تتغذى اليرقات على شجرة السماء)",
 "しんじゅしつ": "عِرْق اللُّؤْلُؤ, زِلْف (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء…)\nمثال: هذا القميص مبلل بالعرق.",
 "しんじゅそう": "عِرْق اللُّؤْلُؤ, زِلْف (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء…)\nمثال: هذا القميص مبلل بالعرق.",
 "しんじゅつ": "الوَخْز بِالْإِبْر / تَصْرِيح, بَيَان / طَبِيعَة, طبيعة",
 "しんじゅとり": "غواص لؤلؤ (غواص يبحث عن الرخويات التي تحتوي على اللؤلؤ)",
 "しんじゅぼ": "عِرْق اللُّؤْلُؤ, زِلْف (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء…)\nمثال: هذا القميص مبلل بالعرق.",
 "しんじゅわんせいぞんしゃきょうかい": "بِيرْل هَارْبَر",
 "しんじゅん": "تسلل (عملية يخترق فيها أفراد (أو مجموعات صغيرة) منطقة (خاصة الاختراق العسكري لمواقع…)\nمثال: تخلل مياه الأمطار عبر التربة / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "しんじゆうしゅぎ": "نِيُولِيبِرَالِيَّة",
 "しんじゆうしゅぎしゃ": "نِيُولِيبْرَالِيّ (يُؤْمِنُ بِضَرُورَةِ النُّمُوِّ الِاقْتِصَادِيِّ إِضَافَةً إِلَى الأَهْدَافِ…)",
 "しんじょ": "كرة السمك, كعكة السمك (كرة مقلية أو قرص من السمك المفتت والبطاطس المهروسة) / مَخْدَع, غُرْفَةُ نَوْم / حالة عقلية, حالة نفسية ((علم النفس) حالة عقلية تكون فيها صفات الحالة ثابتة نسبيًا على الرغم من أن…)\nمثال: الإجهاد ليس الحالة العاطفية أو العقلية الوحيدة التي يمكن أن تستفيد من التأمل المنتظم",
 "しんじょう": "عَقِيدَة (المُعَاقِدَة، بمعنى اسم الفاعل؛ المعقودة، بمعنى اسم المفعول) / عَاطِفَة / رَصِيد, مَكْسَب (صفة مفيدة أو ذات قيمة) / إِبْرِيّ, إِبْرِيّ الشَّكْل (ضيّق وطويل ومُدبَّب؛ كأوراق الصَّنَوْبَر) / مِعْطَاء",
 "しんじょうてき": "رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق)",
 "しんじょうもの": "هَدِيَّة, هدية",
 "しんじょうろん": "انفعالية, عاطفية (طبيعة أو صفة عاطفية)",
 "しんじようとしんじまいと": "صدق أو لا تصدق (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع)\nمثال: صدق سامي كل شيء.",
 "しんじられない": "غير معقول, لا يصدق (يتجاوز التصديق أو الفهم)\nمثال: بسرعة لا تصدق",
 "しんじる": "صَدَّقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع)\nمثال: صدق سامي كل شيء.",
 "しんじん": "إِيمَان, مُعْتَقَد / قادم جديد, مستجد (أي مشارك جديد في نشاط ما)\nمثال: هو وافد جديد إلى بوسطن / إنسان عاقل (شبيه البشر الوحيد الباقي؛ النوع الذي ينتمي إليه الإنسان الحديث؛ رئيسيات تسير…) / سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / سَمِيع (سَميع: (اسم)؛ سميع: (اسم))\nمثال: سمع سامي صريرا.",
 "しんじんか": "متعصب ديني, مهووس بالدين (شخص مدمن على الدين أو متعصب ديني)",
 "しんじんけんしゅう": "توجيه, دورة توجيهية (دورة تقدم موقفاً أو بيئة جديدة)",
 "しんじんなる": "سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ)",
 "しんじんぶかい": "مُتَدَيِّن",
 "しんすい": "توقير, عبادة (العبادة المقدمة لله وحده) / تَفَرُّغ / فيضان / أَعْمَال مَنْزِل, أَعْمَال الْمَنْزِل (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما…)\nمثال: أنا في رحلة أعمال. / إطلاق, قذف (فعل الدفع بقوة)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد / أليف للماء, محب للماء (لديه ألفة قوية للماء؛ يميل للذوبان في الماء أو الامتزاج به أو التبلل به)",
 "しんすいせい": "أليف للماء, محب للماء (لديه ألفة قوية للماء؛ يميل للذوبان في الماء أو الامتزاج به أو التبلل به)",
 "しんすう": "قَاعِدَة",
 "しんずい": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر / نِقْيُ ٱلْعَظْم, مُخُّ ٱلْعَظْم / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف)\nمثال: مسؤولية السنتر هي إيصال الكرة إلى الكوارترباك",
 "しんずべき": "ثِقَةٌ",
 "しんずる": "صَدَّقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع)\nمثال: صدق سامي كل شيء. / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "しんせい": "مُسْتَعِر / اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / تَطْبِيق\nمثال: هذا الكتاب جديد / أَصْلِيّ / إِلَٰهِيَّة / قُدْسِيَّة / ثِيُقْرَاطِيَّة / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل. / بعثة, حملة عسكرية (حملة عسكرية مصممة لتحقيق هدف محدد في بلد أجنبي) / جِرْم سَمَاوِيّ, جِرْم فَلَكِيّ (جَرَم الشَّخْصُ: أَذْنَبَ وَاكتَسَبَ الإِثْمَ؛ جَرَم نفسَه\nمثال: الإهمال هو نوع من الضرر أو الجرم / زِئْبَق, زَاؤُوق / حَقٌّ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل…)\nمثال: الأستاذ على حق.",
 "しんせいか": "تقديس (حفل ديني يتم فيه جعل شيء مقدسًا)",
 "しんせいかつ": "بداية جديدة, صفحة بيضاء (فرصة للبدء من جديد دون أحكام مسبقة)",
 "しんせいがん": "باثوليت, صخر بلوتوني (كتلة كبيرة من الصخور النارية المتطفلة يعتقد أنها تصلبت في أعماق الأرض)",
 "しんせいきせだい": "ألفي (متعلق بألفية أو فترة تمتد لألف عام)",
 "しんせいこうこう": "مَدْرَسَة ثَانَوِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح…)\nمثال: لا أحب المدرسة.",
 "しんせいさいきん": "بكتيريا, جرثومة ((في علم الأحياء الدقيقة) كائنات وحيدة الخلية أو غير خلوية كروية أو حلزونية أو…)",
 "しんせいし": "تأليه, تعظيم (رفع شخص ما (إلى مرتبة إله))",
 "しんせいしゃ": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى…)\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "しんせいじしぼう": "وفاة حديثي الولادة (وفاة رضيع ولد حياً خلال أول 28 يوماً من الحياة)",
 "しんせいじとうぶひふえん": "قبعة المهد (التهاب جلد فروة الرأس الشائع عند الرضع)",
 "しんせいじようけつせいしっかん": "كثرة الأرومات الحمر الجنينية",
 "しんせいすいへいは": "حَفَّار",
 "しんせいせい": "قُدْسِيَّة (صفة كون الشيء مقدساً)",
 "しんせいせんそう": "حَرْب مُقَدَّسَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "しんせいだいがく": "جَامِعَة (مؤنث الجَامِع، اسم فاعل من جَمَعَ، التي تَجْمَع؛ الغُلّ يجمع اليدين إِلى العُنُق)\nمثال: هكذا دخل الجامعة.",
 "しんせいちゅうがく": "مدرسة إعدادية, مدرسة متوسطة (مدرسة ثانوية تشمل عادة الصفين السابع والثامن)",
 "しんせいとつぜんへんい": "من البداية (من البداية)",
 "しんせいにん": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى…)\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "しんせいぶつ": "ورم (كتلة نسيجية جديدة غير طبيعية لا تخدم أي غرض)",
 "しんせいもじ": "هِيرُوغْلِيفِيَّة",
 "しんせいコレラ": "كوليرا (عدوى معوية حادة ناجمة عن تناول مياه أو طعام ملوث)",
 "しんせいローマこうてい": "إمبراطور روماني مقدس (عاهل الإمبراطورية الرومانية المقدسة)",
 "しんせいローマていこく": "اَلْإِمْبَرَاطُورِيَّة اَلرُّومَانِيَّة اَلْمُقَدَّسَة",
 "しんせかい": "الْعَالَم الْجَدِيد",
 "しんせかいざる": "قرد العالم الجديد (قرود شجرية ذات وجوه مشعرة ولها فتحتا أنف متباعدتان وذيول طويلة عادة ما تكون…)",
 "しんせかいちつじょ": "الْعَالَم الْجَدِيد",
 "しんせき": "نقع (غسل شيء عن طريق تركه منقعاً في سائل)\nمثال: نقعه بالماء نقعاً / نِسْبِيّ",
 "しんせきかんけい": "تَعَامُلَات, عَلَاقَات (تعاملات متبادلة أو اتصالات أو تواصل بين الأشخاص أو الجماعات)",
 "しんせっきじだい": "حجري حديث, نيوليثي (من أو متعلق بأحدث فترة من العصر الحجري (تلي العصر الحجري المتوسط))\nمثال: أدلة على مستوطنات من العصر الحجري الحديث",
 "しんせつ": "إنشاء, ابتداء (فعل بدء شيء ما لأول مرة؛ تقديم شيء جديد)\nمثال: تطلعت إلى بدايتها كشخص بالغ / نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر.",
 "しんせつがっぺい": "تكامل, توحيد (عملية الدمج في كلٍ متكامل)\nمثال: دمج شركتين",
 "しんせつぎ": "طيبة قلب (تعاطف نابع من قلب طيب)",
 "しんせつごかし": "تمجيد الذات, غرور (عمل يتم لزيادة قوتك ونفوذك أو لجذب الانتباه لأهميتك الخاصة)",
 "しんせつしん": "إِحْسَان",
 "しんせん": "طَازَج, طَازَة / عَمْق / كائن خارق للطبيعة, كيان روحي (كائن غير مادي يُعتقد أن له قوى تؤثر على مسار الأحداث البشرية) / ارتجاف, رعشة (اهتزاز لا إرادي (كما لو كان بسبب المرض أو الخوف)) / شِينْتْشِين, شِينْجِين / قَائِدُ فِرْقَاتٍ مُوسِيقِيَّةٍ / تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة)",
 "しんせんせんもう": "هذيان ارتعاشي (هذيان حاد ناجم عن التسمم الكحولي)",
 "しんせんそくりょう": "قِيَاس الْأَعْمَاق, مِعْمَاقِيَّة",
 "しんせんまひ": "الشلل الرعاش, داء باركنسون (اضطراب تنكسي في الجهاز العصبي المركزي يتميز بالرعاش وضعف التنسيق العضلي)",
 "しんせんみ": "جِدَّة, طَرَافَة (الأصالة بحكم كون الشيء جديداً ومنعشاً)\nمثال: أحبت طزاجة الخبز المخبوز حديثاً",
 "しんぜる": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "しんぜん": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق…)\nمثال: الغيرة عدوة الصداقة.",
 "しんぜんじあい": "لَطِيف (ذو اللطف وذو اللطافة؛ من الكلام: هو عمض معناه وخفي)\nمثال: هي مدرسة لطيفة.",
 "しんそ": "اتحاد ائتماني, جمعية تعاونية للتسليف (مؤسسة مالية إيداعية تعاونية يمكن لأعضائها الحصول على قروض من مدخراتهم المشتركة)",
 "しんそう": "أعماق, أغوار ((الجمع) الجزء الأعمق والأكثر بعداً)\nمثال: من أعماق أفريقيا المظلمة / حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة. / تجديد, ترميم (حالة الاستعادة إلى الحالة الجيدة السابقة)\nمثال: كان النزل تجديداً لمنزل استعماري",
 "しんそうきゅうめいいいんかい": "تقصي الحقائق",
 "しんそうしんり": "عقل لاواعي, لاوعي (ذلك الجزء من العقل الذي يحدث فيه النشاط النفسي الذي لا يدركه الشخص)",
 "しんそうしんりがく": "تحليل نفسي, علم نفس الأعماق (مجموعة من التقنيات لاستكشاف الدوافع الكامنة وطريقة لعلاج الاضطرابات العقلية…)\nمثال: أوصى طبيبه بالتحليل النفسي",
 "しんそうすい": "مشكلة عويصة, مياه عميقة (مشكلة خطيرة)",
 "しんそうちょうさ": "تقصي الحقائق",
 "しんそうほうかい": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "しんそく": "سرعة (معدل (عادة سريع) يحدث به شيء ما)\nمثال: تقدم المشروع بسرعة مرضية",
 "しんそこ": "قَلْبًا وَقَالَبًا",
 "しんそつ": "أمانة, صدق (صفة كون الشخص صادقاً)",
 "しんぞ": "بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء. / زَوْجَة, اِمْرَأَة",
 "しんぞう": "قَلْب, فُؤَاد / أَحْشَاء / صورة, صورة ذهنية (تمثيل عقلي أيقوني (يشبه الصورة المرئية))\nمثال: فرض خيالها عليها صوراً مروعة جداً لا يمكن تأملها / بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء. / زَوْجَة, اِمْرَأَة / صَنَم, وَثَن (الصَّنَم: نَحْتٌ من خَشَبٍ ويُصَاغُ من نُحاسٍ، وغيره يُصنع لعبادته. ويُسمى…)",
 "しんぞうえん": "التهاب القلب (التهاب القلب)",
 "しんぞうがく": "طِبّ اَلْقَلْب (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "しんぞうけい": "قلبي, منحنى قلبي (دويري خارجي تتساوى فيه الدائرة المتدحرجة مع الدائرة الثابتة) / قَلْبِيّ الشَّكْل ((عن الورقة) على شكل قلب)",
 "しんぞうげか": "جراحة القلب (أي إجراء جراحي يتعلق بالقلب)",
 "しんぞうご": "مُوَلَّدَة",
 "しんぞうしゅじゅつ": "جراحة القلب (أي إجراء جراحي يتعلق بالقلب)",
 "しんぞうせんもんい": "أخصائي قلب, جراح قلب (أخصائي في طب القلب؛ متخصص في بنية ووظيفة واضطرابات القلب)",
 "しんぞうちょうおんぱけんさ": "تخطيط صدى القلب (إجراء تشخيصي غير جراحي يستخدم الموجات فوق الصوتية لدراسة بنية وحركات القلب)",
 "しんぞうていし": "سَكْتَة قَلْبِيَّة",
 "しんぞうにけがはえた": "صَفِيق, وَقِح (لا يتقيّد بالأعراف أو اللياقة؛ جريء بشكل فظّ)",
 "しんぞうびょう": "اعتلال القلب, مرض القلب (مرض يصيب القلب)",
 "しんぞうびょうがく": "طِبّ اَلْقَلْب (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "しんぞうぶ": "قَلْب, فُؤَاد",
 "しんぞうべん": "صمام قلب (زرعة تحل محل صمام قلبي طبيعي)",
 "しんぞうべんまく": "صمام قلب (زرعة تحل محل صمام قلبي طبيعي)",
 "しんぞうべんまくしょう": "مرض صمام القلب (مرض قلبي ناجم عن تضيق صمامات القلب وانسداد تدفق الدم أو ناجم عن التنكس وارتجاع…)",
 "しんぞうほっさ": "اِحْتِشَاء قَلْبِيّ, احتشاء عضلة القلب",
 "しんぞうまひ": "قُصُور القَلْب, فَشَل القَلْب",
 "しんぞうマッサージ": "تدليك القلب (إجراء طارئ يستخدم الضغط الإيقاعي للقلب (إما من خلال جدار الصدر أو مباشرة على…)",
 "しんぞく": "نِسْبِيّ",
 "しんぞくかんけい": "قَرَابَة",
 "しんたい": "حَرَكَة / مسار عمل, نهج (طريقة للعمل أو التصرف)\nمثال: إذا استمررت في هذا المسار فستفشل بالتأكيد / جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ…)",
 "しんたいけい": "عُقُوبَةٌ بَدَنِيَّة",
 "しんたいけんさ": "فَحْص طِبِّيّ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في :…)\nمثال: فحص الطبيب بطني. / تفتيش جسدي (فعل تفتيش شخص ما بحثاً عن أسلحة مخفية أو مخدرات غير قانونية)\nمثال: أجرى للمشتبه به تفتيشاً سريعاً",
 "しんたいげんご": "لُغَةُ الْجَسَدِ (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل…)\nمثال: الأمازيغية لغة.",
 "しんたいしょうがい": "تَكَافُؤ الفُرَص, مِيزَة تَعْوِيضِيَّة (أفضلية تُمنح لمنافس لمساواة فرص الفوز)\nمثال: إعاقة القراءة",
 "しんたいじょう": "مَادِّيّ, مَلْمُوس",
 "しんたいせい": "تَجَسَّد",
 "しんたいてき": "مَادِّيّ, مَلْمُوس",
 "しんたいのうりょく": "قدرة بدنية (القدرة على أداء فعل بدني ما)",
 "しんたいはっぷ": "بكل معنى الكلمة, تماماً (بكل الطرق؛ كلياً)\nمثال: كان رجل دولة بكل معنى الكلمة",
 "しんたいはっぷこれをふぼにうくあえてきしょうせざるはこうのはじめなり": "بِرّ اَلْوَالِدَيْن (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "しんたいりく": "الْعَالَم الْجَدِيد",
 "しんたく": "ثِقَة\nمثال: وثق سامي بليلى ثقة عمياء. / كَاهِن, عَرَّاف",
 "しんたくがいしゃ": "شركة أمينة, شركة ائتمان (منظمة (عادة مع بنك تجاري) تعمل كوصي أو وكيل ائتماني في التعامل مع صناديق…)",
 "しんたくききん": "صندوق ائتمان (صندوق يُحفظ في أمانة)",
 "しんたくしきん": "صندوق ائتمان (صندوق يُحفظ في أمانة)",
 "しんたくしょうしょ": "سند الوصاية, صك الائتمان (صك مكتوب ينقل الملكية قانوناً إلى وصي يستخدم غالباً لتأمين التزام مثل الرهن…)",
 "しんたくとうち": "أمانة, وصاية (منصب الوصي أو عضو مجلس الأمناء)",
 "しんたくとうちりじかい": "مجلس الوصاية (مجلس دائم للأمم المتحدة يكلف دولة (أو دول) بتولي إدارة إقليم ما)",
 "しんたつ": "إِشْعَار, إِخْطَار / إعادة توجيه, تحويل (فعل الإرسال إلى وجهة أخرى)\nمثال: تتم إعادة توجيه البريد إلى العنوان الجديد تلقائياً / يقرب",
 "しんたん": "وَقُود / هَاوِيَة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة)\nمثال: وصل سامي إلى قاع الهاوية ماليا. / قَلْب, فُؤَاد / الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها…)\nمثال: الصين بلد عظيم.",
 "しんだい": "حَرَكَة / مسار عمل, نهج (طريقة للعمل أو التصرف)\nمثال: إذا استمررت في هذا المسار فستفشل بالتأكيد / قَاع, حَوْض (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر)\nمثال: نمت في قاعة السينما. / ثَرْوَة / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ…) / تشينغ, سلالة تشينغ (آخر سلالة إمبراطورية للصين (من 1644 إلى 1912) والتي أطاح بها الثوار؛ خلال سلالة…)",
 "しんだいけん": "تَذْكِرَة",
 "しんだいしゃ": "عربة نوم (عربة ركاب تحتوي على أسرّة للنوم)",
 "しんだいむし": "بَقّ ((بَقَّ) الرجل بقا: أَكثر القَوْل فِي صَوَاب أَو خطأ؛ (بَقَّ) الْمَرْأَة: كثر…)\nمثال: قد غزا بق الفراش فرنسا.",
 "しんだし": "سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "しんだつ": "غَصْب",
 "しんだん": "تَشْخِيص / الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها…)\nمثال: الصين بلد عظيم. / مَذْبَح, هَيْكَل",
 "しんだんい": "أخصائي علم الأمراض, مُشخِّص (طبيب متخصص في التشخيص الطبي)",
 "しんだんがく": "علم التشخيص, علم تصنيف الأمراض (فرع العلوم الطبية المعني بتصنيف الأمراض)",
 "しんだんけんさ": "اختبار تشخيصي, فحص تشخيصي (فحص يتم لأغراض التشخيص)",
 "しんだんし": "مُسْتَشَار, مُسْتَشَارَة (المُسْتشار : مَنْ تطلب مشورته || رتبة في القضاء : « مُسْتشار في محكمة الاستئناف…)",
 "しんだんプログラム": "برنامج تشخيص (برنامج يتعرف على الأعطال في المعدات أو الأخطاء في برنامج حاسوبي ويشرحها)",
 "しんち": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "しんちがく": "الحكمة الإلهية, ثيوصوفيا (نظام عقائدي يقوم على البصيرة الصوفية في طبيعة الله والروح)",
 "しんちくいわい": "حفل تدشين المنزل, حفل نزالة (حفلة يجتمع فيها الناس للاحتفال بالانتقال إلى منزل جديد)",
 "しんちしき": "حتى الآن, عصري (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "しんちゅう": "شَبَه\nمثال: بدأ سامي من نقطة الصفر. / وَظِيفَة, مِهْنَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟ / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل.",
 "しんちゅうおだやかでない": "مُتَوَتِّر جَسَدِيّاً (متعلق بقلق جسدي يسبب عدم الارتياح)\nمثال: كان المزارعون قلقين حتى نزل المطر أخيراً",
 "しんちょ": "عَاطِفَة, عَوَاطِف",
 "しんちょう": "حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك. / ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود)\nمثال: ابتكار الخطط / اِرْتِفَاع\nمثال: 息子はもう私と同じ身長だ。 — إبني بنفس طولي حالياً. / تَمَدُّد / تشينغ, سلالة تشينغ (آخر سلالة إمبراطورية للصين (من 1644 إلى 1912) والتي أطاح بها الثوار؛ خلال سلالة…) / سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ)",
 "しんちょうぎんみ": "تَدْقِيق",
 "しんちょく": "تَقَدُّم / كَاهِن, عَرَّاف / غيرية جنسية (انجذاب جنسي (أو علاقات جنسية) لأشخاص من الجنس الآخر)\nمثال: تصرف بحسن نية",
 "しんちょくほうこく": "تقرير سير العمل, تقرير مرحلي (تقرير عن العمل المنجز خلال فترة زمنية محددة)",
 "しんちん": "هَادِئ / بدون كلام, بصمت (بدون التحدث)\nمثال: جلس بصمت بجوارها",
 "しんちんたいしゃ": "تَجْدِيد / أَيْض ( تَحَوُّل غذائيّ في الخلايا، أو قوّة التجدُّد والبناء والهدم في الكائن الحيّ)",
 "しんつう": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "しんてい": "إِرَاءَة / جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ…)",
 "しんていし": "سَكْتَة قَلْبِيَّة",
 "しんてき": "عَقْلِيّ / إِلٰهِيّ\nمثال: هذا الرجل تاجر.",
 "しんてきがいしょう": "صدمة, صدمة نفسية (جرح أو صدمة عاطفية غالباً ما يكون لها آثار طويلة الأمد)",
 "しんてきがいしょうごストレスしょうがい": "اِضْطِرَاب الْكَرْب التَّالِيّ لِلصَّدْمَة النَّفْسِيَّة",
 "しんてきひょうじ": "تصور داخلي, تمثيل (عرض للأمور في العقل على شكل فكرة أو صورة)",
 "しんてっこう": "غوثيت (معدن أحمر أو أصفر أو بني؛ أكسيد الحديد ومكون شائع للصدأ)",
 "しんてん": "تَمَدُّد / سَرِّيّ, خُصُوصِيّ / تَقَدُّم",
 "しんてんおう": "قَطْرَس (طائر بحري كبير)",
 "しんてんかきとめゆうびん": "بَرِيد مُسَجِّل",
 "しんてんち": "الْعَالَم الْجَدِيد",
 "しんでしけんさ": "فحص طبي, كشف طبي (فحص بدني شامل؛ يتضمن مجموعة متنوعة من الاختبارات حسب العمر والجنس وصحة الشخص)",
 "しんでも": "بِأَيِّ ثَمَنٍ",
 "しんでもいいわ": "أُحِبُّكَ, أُحِبُّكِ",
 "しんでん": "مَعْبَد\nمثال: この神殿は建てるのに４６年かかりました。 — في ست وأربعين سنة بني هذا الهيكل. / عَصْرِيّ, حَدِيث",
 "しんでんけい": "جهاز تخطيط القلب, مخطط القلب (أداة طبية تسجل التيارات الكهربائية المرتبطة بانقباضات القلب)",
 "しんでんず": "مُخَطَط كَهْرَبِيَّة اَلْقَلْب, إِلِكْتْرُوكَارْدِيُوغْرَام",
 "しんと": "شخص عادي, علماني (رجل ليس رجل دين أو شخصاً محترفاً) / صَامِت, سَاكِت",
 "しんといて": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "しんとう": "صَدْمَة / تداخل, تغلغل متبادل (اختراق متبادل؛ انتشار كل طرف خلال الآخر) / خَاصِّيَّة أُسْمُوزِيَّة, تَنَاضُح / شِنْتَوِيَّة, شِنْتُو / قَلْب, فُؤَاد",
 "しんとうあつ": "ضغط أسموزي, ضغط تناضحي ((في الكيمياء الفيزيائية) الضغط الذي يمارسه محلول واللازم لمنع التناضح إلى ذلك…)",
 "しんとうか": "شنتوي (متعلق بالشنتوية أو مميز لها)\nمثال: معابد شنتوية",
 "しんとうき": "أصل الآلهة, ثيوغونيا (دراسة أصول وأنساب الآلهة)",
 "しんとうしんじゃ": "شنتوي (متعلق بالشنتوية أو مميز لها)\nمثال: معابد شنتوية",
 "しんとうじょう": "إطلاق, تدشين (فعل البدء بشيء جديد)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "しんとうせい": "خَاصِّيَّة أُسْمُوزِيَّة, تَنَاضُح",
 "しんとうたんしょうけんさ": "بِي, پِي",
 "しんとき": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "しんど": "مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته / عَمْق / تَقَدُّم / تربة تحتية, طبقة تحت التربة (طبقة التربة بين التربة السطحية والصخر الأساس)",
 "しんどい": "مُتْعَب, تَعْبَان / مُضْجِر, مُمِلّ (يفتقر إلى الإثارة لدرجة تسبب السأم الذهني)",
 "しんどう": "تَذَبْذُب / طفل عبقري (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان…)\nمثال: هو طفل العائلة. / شِنْتَوِيَّة, شِنْتُو / صَدْمَة",
 "しんどうし": "مذبذب (مولد ينتج ذبذبات صوتية أو تياراً متردداً)",
 "しんどうすう": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي…)\nمثال: قبل ماثيو بتردد.",
 "しんどうばん": "حِجَاب حَاجِز (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب. / مرتجف (من يرتجف ويهتز خوفاً)",
 "しんどく": "الْهِنْد, الهند (في جنوب قارة آسيا؛ اسمها الرسمي جمهورية الهند، وعاصمتها نيودلهي)\nمثال: يبدو أنك من الهند.",
 "しんないまく": "شُغاف",
 "しんないまくえん": "التهاب الشغاف (التهاب الشغاف وصمامات القلب)",
 "しんなり": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "しんに": "غَضَب / بصدق, حقاً (وفقاً للحقيقة أو الواقع)\nمثال: أصبحت الآن أمريكية حقاً",
 "しんにゅう": "غَزْو, إِغَارَة (أَغَارَ عَلَى العَدُوِّ غَزْواً : سَارَ إِلَى مُحَارَبَتِهِ وَقِتَالِهِ فِي…)\nمثال: الصين مستعدة لغزو تايوان. / قادم جديد, مستجد (أي مشارك جديد في نشاط ما)\nمثال: هو وافد جديد إلى بوسطن / إِدْخَال / تداخل, تغلغل متبادل (اختراق متبادل؛ انتشار كل طرف خلال الآخر) / تسلل (عملية يخترق فيها أفراد (أو مجموعات صغيرة) منطقة (خاصة الاختراق العسكري لمواقع…)\nمثال: تخلل مياه الأمطار عبر التربة",
 "しんにゅうきんし": "مَمْنُوع الدُّخُولُ",
 "しんにゅうしゃ": "مُقْتَحِم, دَخِيل",
 "しんにゅうしゅ": "نَوْعٌ مُجْتَاحٍ (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر.",
 "しんにゅうせい": "فِي السَّنَةِ الأُولَى, مُسْتَجِدّ (يُوصَفُ بِهِ الشَّخْصُ فِي سَنَتِهِ الأُولَى مِنْ تَجْرِبَةٍ (خَاصَّةً فِي…)",
 "しんにゅうせいぶつ": "نَوْعٌ مُجْتَاحٍ (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر.",
 "しんにゅうろ": "طريق فرعي, مدخل طريق (طريق قصير يتيح الوصول إلى طريق سريع) / مسار الاقتراب, مسار الانزلاق (المسار النهائي الذي تتبعه الطائرة أثناء هبوطها)",
 "しんにゅうをかける": "بَالَغَ",
 "しんにょ": "مُؤْمِن, مُؤْمِنَة (هو الشخص الذي يُؤْمِنُ بالشيء ويصدقه؛ من دخل في قلبه الإِيْمَان، وهو يطلق على…)\nمثال: المؤمن لا يلدغ مرتين من جحر واحد. / إِلَاهَة, إِلٰهَة",
 "しんにん": "ثِقَة\nمثال: وثق سامي بليلى ثقة عمياء. / شَكَرَ ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ:…)\nمثال: شكر ياني أسرته. / تدشين, تنصيب (التنصيب الاحتفالي في منصب ما)\nمثال: استمتع الرئيس الجديد بوضوح بحفل تنصيبه",
 "しんにんじょう": "اعتماد, شهادة (وثيقة تشهد بصحة وقائع معينة مذكورة)",
 "しんにんとうひょう": "تصويت بالثقة, منح الثقة (تعبير عن الموافقة والتشجيع)\nمثال: أعطوا الرئيس تصويتاً بالثقة",
 "しんにんひょう": "تصويت بالثقة, منح الثقة (تعبير عن الموافقة والتشجيع)\nمثال: أعطوا الرئيس تصويتاً بالثقة",
 "しんぬきき": "أداة إزالة اللب, مقوّر (أداة لإزالة اللب من التفاح)",
 "しんね": "غَضَب",
 "しんねり": "بِإِصْرَار (مع الإصرار)\nمثال: كان يطرح أسئلة، أسئلة لا مفر منها، بإصرار / بِبُطْء",
 "しんねん": "اِعْتِقَاد / السَّنَة الْجَدِيدَة",
 "しんねんあけましておめでとうございます": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "しんねんえんかい": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "しんねんおめでとう": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "しんねんおめでとうございます": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "しんねんかい": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "しんねんごう": "السَّنَة الْجَدِيدَة",
 "しんねんのほうふ": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "しんの": "حَقٌّ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل…)\nمثال: الأستاذ على حق.",
 "しんのう": "تَأْمُور",
 "しんのぞう": "قَلْب, فُؤَاد",
 "しんはくしゅつりょう": "النِّتَاج القَلْبِيّ (كمية الدم التي يضخها البطينان في فترة زمنية معينة)\nمثال: يبلغ النتاج القلبي للبالغ في حالة الراحة حوالي ثلاثة لترات في الدقيقة",
 "しんはつばい": "أَطْلَقَ, قَذَفَ",
 "しんば": "حصان بديل (حصان جديد خاصة (سابقاً) ليحل محل حصان قُتل أو أصيب في المعركة)",
 "しんばりぼう": "حَانَة, بَار",
 "しんばり棒": "حَانَة, بَار",
 "しんばん": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث)\nمثال: انتقدوا حكمي على المتسابقين / تحكيم (فعل التحكيم (في الرياضة))\nمثال: كان التحكيم ممتازاً / حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "しんばんいん": "حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "しんぱい": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / اِهْتِمَام / جهاز القلب والرئة (مضخة للحفاظ على الدورة الدموية أثناء جراحة القلب؛ تحول الدم من القلب وتؤكسده ثم…)",
 "しんぱいごと": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "しんぱいごむよう": "هُنَاكَ, يُوجَدُ",
 "しんぱいそせいほう": "إنعاش قلبي رئوي (إجراء طوارئ يتكون من تدليك القلب الخارجي والتنفس الاصطناعي)",
 "しんぱいていし": "توقف الانقباض, توقف قلبي رئوي (غياب الانقباض القلبي؛ فشل بطينات القلب في الانقباض (عادة بسبب الرجفان البطيني)…)",
 "しんぱいむよう": "هُنَاكَ, يُوجَدُ",
 "しんぱく": "نَبْض, نَبْضُ القَلْب",
 "しんぱくきろく": "تخطيط القلب, تخطيط كهربائية القلب (إجراء تشخيصي يتمثل في تسجيل نشاط القلب إلكترونياً باستخدام جهاز تخطيط القلب)",
 "しんぱくけい": "مُعَدَّل النَّبْض, مُعَدَّل ضَرَبَات القَلْب (المعدل الذي ينبض به القلب؛ يقاس عادة للحصول على تقييم سريع لصحة الشخص)",
 "しんぱくすう": "مُعَدَّل النَّبْض, مُعَدَّل ضَرَبَات القَلْب (المعدل الذي ينبض به القلب؛ يقاس عادة للحصول على تقييم سريع لصحة الشخص)",
 "しんぱつ": "نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "しんぱん": "اِنْتِهَاك / تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث)\nمثال: انتقدوا حكمي على المتسابقين / تحكيم (فعل التحكيم (في الرياضة))\nمثال: كان التحكيم ممتازاً / حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت. / طبعة جديدة (منشور (مثل كتاب) تم تعديله أو تحديثه وعرضه للبيع مرة أخرى) / محاكمة بالتعذيب, محنة (طريقة بدائية لتحديد ذنب أو براءة الشخص عن طريق تعريض المتهم لاختبارات خطيرة أو…)",
 "しんぱんいん": "حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "しんぱんかん": "قانون إداري (مجموعة القواعد واللوائح والأوامر والقرارات التي تنشئها الوكالات الإدارية…)",
 "しんぱんしゃ": "قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت.",
 "しんぱんのひ": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "しんぱんやく": "حكم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "しんひしつ": "قشرة حديثة (الجزء القشري من الدماغ الحديث)",
 "しんびがく": "عِلْم الْجَمَال, فَلْسَفَةُ الْجَمَال (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "しんびしか": "طب الأسنان التجميلي (فرع طب الأسنان الذي يتعامل مع مظهر الأسنان)",
 "しんびてき": "جَمَالِيّ, فَنِّيّ (يتعلق بـ أو يتميز بتقدير الجمال أو الذوق الرفيع)\nمثال: الملكات الجمالية",
 "しんびょう": "خَنُوع, مُسْتَكِين (يُظْهِر قِلَّة فِي الشَّجَاعَة؛ مُفْرِط فِي الِامْتِثَال) / غَامِض",
 "しんぴ": "سِرّ (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا. / كربلة (مدقة بسيطة أو عنصر واحد من مدقة مركبة) / أَدَمة",
 "しんぴがく": "تنجيم, علوم خفية (اعتقاد بوجود قوى خارقة للطبيعة وإمكانية إخضاعها للسيطرة البشرية)",
 "しんぴげき": "مسرحية الأسرار (مسرحية من القرون الوسطى تمثل حلقات من حياة المسيح)",
 "しんぴしゅぎ": "تصوف, غموضية (فكر غامض أو غير عقلاني)",
 "しんぴせい": "جَاذِبِيَّة غَامِضَة, سِحْر غَامِض (هالة من القيمة العالية أو الاهتمام أو المعنى تحيط بشخص أو شيء)",
 "しんぴつ": "تَوْقِيع, أُوتُوجْرَاف (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم. / خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "しんぴてき": "غَامِض",
 "しんぴてきふんいき": "جَاذِبِيَّة غَامِضَة, سِحْر غَامِض (هالة من القيمة العالية أو الاهتمام أو المعنى تحيط بشخص أو شيء)",
 "しんぴょう": "ثِقَة\nمثال: وثق سامي بليلى ثقة عمياء.",
 "しんぴょうせい": "أَصَالَة, شَرْعِيَّة (مصداقية غير متنازع عليها)",
 "しんぴん": "جَدِيد تَمَامًا, لَامِع (جديد بشكل لافت للنظر) / تُحْفَة, رَائِعَة",
 "しんふぜん": "قُصُور القَلْب, فَشَل القَلْب",
 "しんぶ": "أعماق, أغوار ((الجمع) الجزء الأعمق والأكثر بعداً)\nمثال: من أعماق أفريقيا المظلمة / أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "しんぶん": "جَرِيدَة",
 "しんぶんうり": "بائع صحف (صبي يوزع الصحف)",
 "しんぶんがみ": "ورق جرائد (ورق رخيص مصنوع من لب الخشب ويستخدم لطباعة الصحف)\nمثال: استخدموا رزمًا من ورق الجرائد كل يوم",
 "しんぶんこうこく": "إِعْلَان صُحُفِيّ (إعلان مطبوع ينشر في صحيفة)",
 "しんぶんし": "ورق جرائد (ورق رخيص مصنوع من لب الخشب ويستخدم لطباعة الصحف)\nمثال: استخدموا رزمًا من ورق الجرائد كل يوم / جَرِيدَة",
 "しんぶんしじょう": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "しんぶんすう": "كَسْر حَقِيقِيّ (كسر يكون بسطه أصغر من مقامه)",
 "しんぶんはいたつ": "نَاقِل\nمثال: يبدو أنني حامل.",
 "しんぶんはっぴょう": "بَيَان صَحَفِيّ (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء…)\nمثال: وأوضح البيان ذاته، أن الوزارة وجهت تعليمات من أجل تسخير كافة الإمكانيات البشرية والمادية للتسريع من وتيرة سير العملية.",
 "しんぶんばいてん": "كُشْك صُحُف (هو الكِشْك في بعض اللهجات العربية؛ شبه رِوَاق بارز عن مساواة بقية البيت)",
 "しんぷ": "عَرُوس / رئيس دير (رئيس دير فرنسي) / تَمِيمَة, أُخْذَة / أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء…)\nمثال: الأب في الغرفة.",
 "しんぷく": "سعة, مدى (عِظَم المقدار) / عبودية الأرض, قنانة (حالة القن (عبد الأرض))",
 "しんぷくへんちょう": "تضمين السعة (تضمين سعة الموجة الحاملة (للراديو))",
 "しんべい": "موال لأمريكا (يدعم الولايات المتحدة وسياساتها)",
 "しんべん": "شَفَة, شفة / حنك رخو (سديلة عضلية تغلق البلعوم الأنفي أثناء البلع أو الكلام)",
 "しんぺい": "مُجَنَّد",
 "しんぺん": "مُعْجِزَة, أُعْجُوبَة / طبعة جديدة (منشور (مثل كتاب) تم تعديله أو تحديثه وعرضه للبيع مرة أخرى)",
 "しんほしゅしゅぎ": "محافظة جديدة (نهج في السياسة أو اللاهوت يمثل عودة إلى وجهة نظر تقليدية (على عكس المدارس…)",
 "しんぼう": "ثِقَة / قصبة الريشة (العمود الفقري المجوف للريشة) / عمود دوران, مغزل (أي من الأعمدة الدوارة المختلفة التي تعمل كمحاور لأجزاء دوارة أكبر) / صَبْر, تَحَمُّل ((صَبَرَ) يَصْبِرُ صَبْرًا: تجلَّد ولم يَجْزَع؛ (صَبَرَ): انتظر في هدوء واطمئنان)\nمثال: الصبر أم العلوم. / اِئْتَمَرَ / أُذَيْن",
 "しんぼうさいどう": "رَجَفَان أُذَيْنِيّ",
 "しんぼうちゅうかくけっそん": "عيب الحاجز الأذيني (فتحة غير طبيعية بين الأذينين الأيسر والأيمن للقلب)",
 "しんぼうづよい": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء…)\nمثال: أظن أنها مريضة.",
 "しんぼく": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق…)\nمثال: الغيرة عدوة الصداقة.",
 "しんぼち": "حديث العهد بالإيمان, موعوظ (معتنق جديد يتم تعليمه مبادئ المسيحية)",
 "しんぼっち": "حديث العهد بالإيمان, موعوظ (معتنق جديد يتم تعليمه مبادئ المسيحية)",
 "しんぽ": "تَقَدُّم",
 "しんぽう": "اِعْتِقَاد\nمثال: 開拓民たちはキリスト教を信奉した。 — أعتنق المستوطنون الديانة المسيحيّىة. / أَخْبَار, أَنْبَاء (أنباء ما قد حدث؛ نشرة الأخبار أو عرض الأخبار: ما يعرضه التلفاز أو الراديو من…)\nمثال: هذه أخبار طيبة.",
 "しんぽうしゃ": "لَاصِق, مُلْتَصِق (ملتصق بإحكام)",
 "しんぽしゅぎ": "تقدمية (التوجه السياسي لمن يفضلون التقدم نحو ظروف أفضل في الحكومة والمجتمع)",
 "しんぽせい": "اِخْتِرَاع",
 "しんぽてき": "تَقَدُّمِيّ, مُتَرَقٍّ",
 "しんぽとう": "الحزب التقدمي, حزب بول موس (حزب سياسي سابق في الولايات المتحدة؛ أسسه ثيودور روزفلت خلال الحملة الرئاسية…)",
 "しんまい": "مبتدئ, مستجد (شخص جديد في مجال أو نشاط ما)",
 "しんまく": "تَأْمُور",
 "しんまくえん": "اِلْتِهَاب التَّأْمُور",
 "しんまくこう": "تجويف التامور (الحيز بين طبقات التامور الذي يحتوي على سائل يزيت أسطح الغشاء ويسمح بحركة القلب…)",
 "しんみ": "حلي رخيصة, حلية مبهرجة (مجوهرات رخيصة ومبهرجة أو زينة على الملابس) / عَلَاقَة / نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر.",
 "しんみつ": "أُلْفَة",
 "しんみつか": "تضليل, تعمية (نشاط حجب فهم الناس وتركهم في حيرة أو ارتباك)",
 "しんみつかん": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق…)\nمثال: الغيرة عدوة الصداقة.",
 "しんみになって": "بحرارة, بقلب خالص (بطريقة قلبية)\nمثال: رحبنا بها بحرارة",
 "しんみょう": "خَنُوع, مُسْتَكِين (يُظْهِر قِلَّة فِي الشَّجَاعَة؛ مُفْرِط فِي الِامْتِثَال) / غَامِض",
 "しんみり": "بِهُدُوء / برصانة, بمهابة (بطريقة جادة ورصينة)\nمثال: جلس القاضي هناك بمهابة",
 "しんみん": "فَاعِل, مُبْتَدَأ (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "しんめ": "نَبْتَة",
 "しんめい": "إِلٰه, مَعْبُود (كل ما اتُّخِذَ معبودًا)\nمثال: يؤمن فاضل بإله الإسلام. / أَمَاتِيرَاسُو",
 "しんめいき": "سِفْر التَثْنِيَة, سِفْر تَثْنِيَةِ الاِشْتِرَاع (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد)\nمثال: صاحبته في السفر.",
 "しんめいさいばん": "محاكمة بالتعذيب, محنة (طريقة بدائية لتحديد ذنب أو براءة الشخص عن طريق تعريض المتهم لاختبارات خطيرة أو…)",
 "しんめんぼく": "جِدِّيّ / مظهر جديد, نيو لوك (نمط من الملابس النسائية ابتكره كريستيان ديور عام 1947؛ تضمن صدراً ضيقاً وخصراً…)",
 "しんめんもく": "جِدِّيّ / مظهر جديد, نيو لوك (نمط من الملابس النسائية ابتكره كريستيان ديور عام 1947؛ تضمن صدراً ضيقاً وخصراً…)",
 "しんもつ": "هَدِيَّة, هدية",
 "しんもつどころ": "مَطْبَخ (المكان الذي يُطْبَخُ فيه، غُرْفَة أو مساحة في البناء مخصصة للطبخ؛ في : هو…)\nمثال: سامي في المطبخ.",
 "しんもん": "مُحَاكَمَة (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري.",
 "しんもんかん": "مُحَقِّق, مُحَقِّقَة (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ…)\nمثال: تحدث ياني مع محقق.",
 "しんやく": "نَذْر / اَلْعَهْد اَلْجَدِيد",
 "しんやくせいしょ": "اَلْعَهْد اَلْجَدِيد",
 "しんやくぜんしょ": "اَلْعَهْد اَلْجَدِيد",
 "しんゆ": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "しんゆう": "رفيق, زميل (صديق مقرب يرافق رفاقه في أنشطتهم)",
 "しんゆせい": "أليف للزيت, أوليوفيلي (لديه ألفة قوية للزيوت بدلاً من الماء)",
 "しんよ": "حَمَّالَة, مِحَفَّة",
 "しんよう": "ثِقَة / اِئْتِمَان / إِبْرَة, مِخْيَط / شِنْيَانْغ, شِينْيَانْغ",
 "しんようかくづけ": "تصنيف ائتماني, جدارة ائتمانية (تقدير، بناءً على تعاملات سابقة، لقدرة شخص أو منظمة على الوفاء بالتزاماتهم…)",
 "しんようかくづけきかん": "تصنيف ائتماني, جدارة ائتمانية (تقدير، بناءً على تعاملات سابقة، لقدرة شخص أو منظمة على الوفاء بالتزاماتهم…)",
 "しんようがり": "دين شرف (التزام، خاصة ديون المقامرة القائمة على وعد شفهي، لا يكون ملزماً قانونياً ولكنه…)\nمثال: يجب أن أوفر له المال - إنه دين شرف",
 "しんようきき": "أزمة ائتمان, أزمة سيولة (حالة يوجد فيها نقص في النقد لإقراض الشركات والمستهلكين وتكون أسعار الفائدة…)",
 "しんようきんこ": "اتحاد ائتماني, جمعية تعاونية للتسليف (مؤسسة مالية إيداعية تعاونية يمكن لأعضائها الحصول على قروض من مدخراتهم المشتركة)",
 "しんようくみあい": "اتحاد ائتماني, جمعية تعاونية للتسليف (مؤسسة مالية إيداعية تعاونية يمكن لأعضائها الحصول على قروض من مدخراتهم المشتركة)",
 "しんようくみあいぜんこくきょうかい": "اتحاد ائتماني, جمعية تعاونية للتسليف (مؤسسة مالية إيداعية تعاونية يمكن لأعضائها الحصول على قروض من مدخراتهم المشتركة)",
 "しんようさぎ": "احتيال, خديعة الثقة (عملية نصب تغش فيها في القمار أو تقنع شخصاً بشراء ممتلكات لا قيمة لها)",
 "しんようしゅうしゅく": "أزمة ائتمان, أزمة سيولة (حالة يوجد فيها نقص في النقد لإقراض الشركات والمستهلكين وتكون أسعار الفائدة…)",
 "しんようじゅ": "شجرة مخروطية, صنوبريات (أي شجرة أو شجيرة عارية البذور تحمل مخاريط)",
 "しんようじょう": "خطاب اعتماد (وثيقة يصدرها بنك تضمن دفع حوالة العميل؛ تستبدل ائتمان البنك بائتمان العميل)",
 "しんようせい": "مِصْدَاقِيّة",
 "しんようリスク": "مَخَاطِر الاِئْتِمَان",
 "しんらい": "ثِقَة\nمثال: وثق سامي بليلى ثقة عمياء. / جَدِيد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد",
 "しんらいかん": "ثِقَة\nمثال: وثق سامي بليلى ثقة عمياء.",
 "しんらいかんけい": "عَلَاقَة اِئْتِمَانِيَّة (العلاقة القانونية التي توجد عندما يعتمد شخص بشكل مبرر على شخص آخر يُطلب منه…)",
 "しんらいしゃ": "قادم جديد, مستجد (أي مشارك جديد في نشاط ما)\nمثال: هو وافد جديد إلى بوسطن",
 "しんらいせい": "مِصْدَاقِيّة",
 "しんらいど": "اعتمادية, موثوقية (جودة كون الشخص أو الشيء جديراً بالاعتماد أو الثقة)",
 "しんらいにたる": "أَصِيل, مَوْثُوق (غير مُزيَّف أو منسوخ؛ حقيقي لا شك فيه)",
 "しんらいのおける": "مَوْثُوق",
 "しんらつ": "مُرّ (فَاتَ ومَضَى؛ الحدثُ أو الأمرُ: حدث وانتهى)\nمثال: مر زيري بجانبي.",
 "しんり": "مُحَاكَمَة (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري. / حالة إدراكية, حالة معرفية (حالة العمليات المعرفية للشخص) / حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "しんりがく": "سَيْكُولُوجْيَا, عِلْم النَّفْس",
 "しんりがくしゃ": "نَفْسَانِيّ, عَالِم النَّفْس",
 "しんりがくてき": "سَيْكُولُوجِيّ, نَفْسَانِيّ (عقليّ أو عاطفيّ بطبيعته لا جسديّ)\nمثال: نظريات نفسية",
 "しんりげんごがく": "لسانيات نفسية (فرع علم النفس المعرفي الذي يدرس الأساس النفسي للكفاءة والأداء اللغوي)",
