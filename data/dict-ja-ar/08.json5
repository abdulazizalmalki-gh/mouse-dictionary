 "じようぶつ": "تغذية (فعل التغذية)\nمثال: أنقذت تغذيتها للأيتام العديد من الأرواح",
 "じようぶん": "مُغَذٍّ, المُغَذِّي",
 "じよく": "صيوان الأذن (البنية الغضروفية المرئية خارجياً للأذن الخارجية)",
 "じらい": "لَغْم, لَغْم أَرْضِيّ / زِنَاد / شَرَك, فَخّ ((شَرِكَتِ) النَّعْلُ تَشْرَكُ شَرَكًا: انقطَعَ شِراكُها؛ (شَرِكَتْ) فُلانًا في…)\nمثال: هذه شركة صينية.",
 "じらいか": "لِي, لي",
 "じらいげん": "حَقْلُ أَلْغَام (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "じらす": "إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات…)\nمثال: تجاهل تهكمهم",
 "じり": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل.",
 "じりききゅうさい": "اعتماد على النفس, مساعدة ذاتية (فعل مساعدة أو تحسين المرء لنفسه دون الاعتماد على أي شخص آخر)",
 "じりきこうせい": "إسهاب, بلورة (التطوير بتفاصيل معقدة ومضنية)",
 "じりきほんがん": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "じりじり": "بِبُطْء / بفارغ الصبر, بنافذ الصبر (مع نفاد صبر؛ بطريقة غير صبورة)\nمثال: أجابها بفارغ الصبر / أَزِيزِيّ (ساخن بما يكفي للاحتراق مع صوت أزيز أو كأنَّه كذلك)",
 "じりす": "سنجاب الأرض (أي من قوارض أرضية متنوعة تحفر الجحور في العالمين القديم والجديد؛ غالباً ما تدمر…)",
 "じりっ": "بِبُطْء / احتراق, حرق (عملية حرق شيء ما)\nمثال: حرق الأوراق كان ممنوعاً بموجب مرسوم المدينة",
 "じりつ": "تمريرة حاسمة, مساعدة ((رياضة) فعل تمكين لاعب آخر من القيام بلعبة جيدة)\nمثال: قدم لي مساعدة في الأعمال المنزلية / اِسْتِقْلال, تَحَرُّر (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع…)\nمثال: الصحراويون يريدون الاستقلال. / اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع…)\nمثال: الصحراويون يريدون الاستقلال.",
 "じりつがた": "قَائِمٌ بِذَاتِه, مُسْتَقِلّ (قادر على العمل بشكل مستقلّ دون الاعتماد على غيره)",
 "じりつくんれんほう": "تدريب التحفيز الذاتي, علاج ذاتي المنشأ (تدريب المرضى على الاسترخاء الذاتي)",
 "じりつしんけいけい": "جهاز عصبي ذاتي (جزء الجهاز العصبي للفقاريات الذي يتحكم في الأفعال اللاإرادية للعضلات الملساء…)",
 "じりつしんけいせつ": "عقدة ذاتية (أي من عقد الجهاز العصبي الذاتي التي تغذي أليافها غير الميالينية الأعضاء الداخلية)",
 "じりつてき": "اِسْتِقْلَالِيّ",
 "じりつシステム": "كَـ, مِثْل\nمثال: قصدته مثل نكتة.",
 "じりゅう": "طب الأعشاب (استخدام الأعشاب الطبية للوقاية من الأمراض أو علاجها أو تعزيز الصحة)",
 "じりゅうてっこう": "بايريت مغناطيسي, بيروتيت",
 "じりょう": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على…)\nمثال: أساء توم معاملة ماري.",
 "じりょく": "مِغْنَاطِيسِيَّة, مَغْنَاطِيسِيَّة",
 "じりょくきゅうさい": "اعتماد على النفس, مساعدة ذاتية (فعل مساعدة أو تحسين المرء لنفسه دون الاعتماد على أي شخص آخر)",
 "じりょくけい": "مقياس المغناطيسية (مقياس لمقارنة قوة المجالات المغناطيسية)",
 "じりょくせん": "حقل مغناطيسي (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "じりん": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق…)\nمثال: أي قاموس تعنيه؟",
 "じるい": "جنس فرعي, جنيس ((في الأحياء) مجموعة تصنيفية بين الجنس والنوع)",
 "じれい": "مِثَال, مَثَل / ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات)",
 "じれいけんきゅう": "دراسة حالة (تحليل مفصل لشخص أو مجموعة من وجهة نظر اجتماعية أو نفسية أو طبية)",
 "じれいけんきゅうほう": "دراسة حالة (تحليل مفصل لشخص أو مجموعة من وجهة نظر اجتماعية أو نفسية أو طبية)",
 "じれいしょうかい": "دراسة حالة (تحليل مفصل لشخص أو مجموعة من وجهة نظر اجتماعية أو نفسية أو طبية)",
 "じれきせい": "أَسْفَلْت, زِفْت",
 "じれったい": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "じれつ": "ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة…)\nمثال: ثانوية زيري ضخمة.",
 "じれる": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة…)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران",
 "じれん": "مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "じろう": "ثر أذني, سيلان الأذن (إفرازات من الأذن الخارجية) / زِنْزَانَة, دَيْمَاس",
 "じろっと": "لمحة, نظرة خاطفة (نظرة سريعة)",
 "じろり": "لمحة, نظرة خاطفة (نظرة سريعة)",
 "じわじわ": "بِبُطْء",
 "じわり": "تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية / شَيْئاً فَشَيْئاً, خُطْوةً فَخُطْوةً",
 "じわりじわり": "شَيْئاً فَشَيْئاً, خُطْوةً فَخُطْوةً",
 "じん": "مُـ / إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق. / النزعَة إلى الخير / بَشَرِيّ, إنْسَانِيّ\nمثال: أنا إنسان صادق. / نَوَاة / نوية / مُخَيِّم / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب. / قامة / تلوث, تنجيس (حالة كونه ملوثاً) / عُرْضَة, شَيْء\nمثال: لقد أخطأ الهدف. / يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم) / رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة. / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب. / كُلْيَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: في أي كلية تدرس؟",
 "じんあい": "النزعَة إلى الخير / غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي…)\nمثال: أزل الغبار عن المرآة.",
 "じんい": "فَنّ, فُنُون (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "じんいさいがい": "تَرْكِيبِيّ, مَصْنُوع (ليس من أصل طبيعي؛ أُعِدّ أو صُنِع صناعيًّا)",
 "じんいせんたく": "اِنْتِخَاب اِصْطِنَاعِيّ",
 "じんいてき": "مُتَصَنَّع, صِنَاعِيّ",
 "じんいとうた": "اِنْتِخَاب اِصْطِنَاعِيّ",
 "じんいん": "إدارة الموارد البشرية, قسم شؤون الموظفين (القسم المسؤول عن تعيين وتدريب وتوزيع الموظفين ووضع سياسات إدارة الأفراد)\nمثال: قوة عامة ضرورية لتوفير الأمن لحقوق المواطنين",
 "じんう": "حوض الكلية (بنية تشبه القمع في مخرج الكلية يفرغ فيها البول قبل مروره إلى الحالب)",
 "じんうえん": "التهاب الحويضة (التهاب حوض الكلية)",
 "じんうじんえん": "التهاب الحويضة والكلية (التهاب الكلى وحوضها الناجم عن عدوى بكتيرية)",
 "じんえい": "مُخَيِّم / مَحَلَّة, مُخَيَّم (ما دون الحَيّ وفوق المَنْزِل. قيل قرابة مئة بيت ومجلس ومسجد؛ تقسيم إداري…)",
 "じんえん": "التهاب الكلية, مرض برايت (التهاب في الكلى)",
 "じんか": "مَجْلِس",
 "じんかい": "تُرَّهَات, كَلَام تَافِه (حديث أو كتابة لا معنى لها)",
 "じんかいしゃ": "شاحنة القمامة (شاحنة لجمع النفايات المنزلية)",
 "じんかく": "شَخْصِيَّة",
 "じんかくか": "انتحال شخصية, تقمص (تقليد سلوكيات شخص آخر)",
 "じんかくこうげき": "شَخْصَنَة",
 "じんかくしょうがい": "اضطراب الشخصية (أنماط سلوكية غير مرنة وغير متكيفة)",
 "じんかくしんろん": "ألوهية, إيمان بوجود إله (العقيدة أو الإيمان بوجود إله أو آلهة)",
 "じんかくてき": "شَخْصِيّ",
 "じんかん": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "じんがさ": "جندي (جندي مجند من أدنى رتبة في الجيش أو مشاة البحرية)\nمثال: كان سجيننا مجرد جندي ولم يكن يعرف شيئاً ذا قيمة / الأفراد, الجنود العاديون (الأعضاء العاديون في منظمة (مثل الجنود المجندين في الجيش))\nمثال: تم دعم الإضراب من قبل أفراد النقابة",
 "じんがさぎいん": "نائب خلفي (عضو في مجلس العموم ليس قائداً حزبياً)",
 "じんがされん": "جندي (جندي مجند من أدنى رتبة في الجيش أو مشاة البحرية)\nمثال: كان سجيننا مجرد جندي ولم يكن يعرف شيئاً ذا قيمة / الأفراد, الجنود العاديون (الأعضاء العاديون في منظمة (مثل الجنود المجندين في الجيش))\nمثال: تم دعم الإضراب من قبل أفراد النقابة",
 "じんきょう": "مُرُوءَة / يَاكُوزَا",
 "じんぎ": "فَضِيلَة / وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / قَوْس, قوس / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "じんくん": "مُسْتَقِلّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
