 "しんりテスト": "اختبار شخصية (أي اختبار يهدف إلى تقييم الشخصية)",
 "しんるい": "نِسْبِيّ / يقرب",
 "しんるいがき": "تدوين, سجل مكتوب (وثيقة مكتوبة تحفظ المعرفة بوقائع أو أحداث)",
 "しんれい": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة. / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب. / رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة.",
 "しんれいがく": "رُوحَانِيّ, نَفْسَانِيّ (خارج نطاق العلوم الفيزيائية)",
 "しんれいきょうかい": "الكنيسة المعمدانية, المعمدانيون (أي من مختلف الكنائس البروتستانتية الإنجيلية التي تؤمن بمعمودية المؤمنين الطوعيين)",
 "しんれいげんしょう": "باراسيكولوجيا, ظواهر نفسية خارقة (ظواهر تبدو وكأنها تتناقض مع القوانين الفيزيائية وتشير إلى إمكانية السببية عن…)",
 "しんれいしゅぎ": "روحانية (الاهتمام بأمور الروح)",
 "しんれいしょり": "تَحْتَ الصِّفْر (أَقَلَّ)\nمثال: أنا تحت الشجرة.",
 "しんれいじゅつ": "روحانية (الاهتمام بأمور الروح)",
 "しんれいちりょう": "شفاء بالإيمان (الرعاية المقدمة من خلال الصلاة والإيمان بالله)",
 "しんれいろん": "روحانية (الاهتمام بأمور الروح)",
 "しんれいろんしゃ": "روحاني (متعلق بالروحانية أو متصل بها)\nمثال: استشار العديد من الوسطاء",
 "しんれき": "تقويم شمسي (تقويم يعتمد على الدورات الشمسية)",
 "しんれつ": "شفة أرنبية, شفة مشقوقة (شق خلقي في منتصف الشفة العليا)",
 "しんろ": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق. / طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ.",
 "しんろう": "قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / عَرِيس (اِسْمٌ لِمَاْوَى الأَسَد) / مَشَقَّة, شِدَّة / صَحْن (ساحة وسط الدَار. الجمع صحون؛ المستوي من الأرض)\nمثال: توم يلعب الصحن الطائر.",
 "しんろうまんしゅぎ": "الرومانسية الجديدة (حركة فنية تستند إلى إحياء الرومانسية في الفن والأدب)",
 "しんろへんこう": "تغيير المسار (تغيير في الاتجاه الذي تتحرك فيه)",
 "しんわ": "خُرَافَة / صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق…)\nمثال: الغيرة عدوة الصداقة.",
 "しんわがく": "عِلْم اَلْأَسَاطِير (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "しんわせい": "أُلْفَة, انْجِذَاب (انجذاب طبيعي أو شعور بالقرابة)\nمثال: انجذاب للسياسة",
 "しんわてき": "أُسْطُورِيّ, مِيثُولُوجِيّ (مبنيّ على القصص التقليدية أو مرويّ فيها؛ يفتقر إلى أساس واقعي) / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / متوافق, منسجم (قادر على الوجود والأداء في مزيج متناغم أو مقبول)\nمثال: زوجان متوافقان",
 "しんわりょく": "أُلْفَة, انْجِذَاب (انجذاب طبيعي أو شعور بالقرابة)\nمثال: انجذاب للسياسة",
 "しんエコー": "تخطيط صدى القلب (إجراء تشخيصي غير جراحي يستخدم الموجات فوق الصوتية لدراسة بنية وحركات القلب)",
 "しんエコーしんだん": "تخطيط صدى القلب (إجراء تشخيصي غير جراحي يستخدم الموجات فوق الصوتية لدراسة بنية وحركات القلب)",
 "しんエコーず": "مخطط صدى القلب (صورة بيانية للقلب منتجة بواسطة جهاز تخطيط صدى القلب)",
 "しんエネ": "طاقة بديلة (طاقة مستمدة من مصادر لا تستنفد الموارد الطبيعية أو تضر بالبيئة)",
 "しんエネルギー": "طاقة بديلة (طاقة مستمدة من مصادر لا تستنفد الموارد الطبيعية أو تضر بالبيئة)",
 "しんケース": "رصاص القلم, سن قلم الرصاص (خليط من الجرافيت مع الطين بدرجات صلابة مختلفة؛ مادة التحديد في قلم الرصاص)",
 "しんタンポナーデ": "اندكاك قلبي, سطام قلبي (ضغط ميكانيكي على القلب ناتج عن تجمع كميات كبيرة من السوائل في حيز التامور مما…)",
 "しんニッケルこう": "ميليريت (معدن أصفر يتكون من كبريتيد النيكل؛ مصدر ثانوي للنيكل)",
 "しんプラトンしゅぎ": "أفلاطونية محدثة (نظام من العقائد الفلسفية واللاهوتية يتألف من عناصر الأفلاطونية والأرسطية…)\nمثال: كانت الأفلاطونية المحدثة سائدة في أوروبا الوثنية حتى القرن السادس",
 "しんマ": "تدليك القلب (إجراء طارئ يستخدم الضغط الإيقاعي للقلب (إما من خلال جدار الصدر أو مباشرة على…)",
 "しんロマンしゅぎ": "الرومانسية الجديدة (حركة فنية تستند إلى إحياء الرومانسية في الفن والأدب)",
 "しんローマンしゅぎ": "الرومانسية الجديدة (حركة فنية تستند إلى إحياء الرومانسية في الفن والأدب)",
 "しん酌": "اِحْتِيَاط\nمثال: حجز مناد موعدا.",
 "しーん": "بدون كلام, بصمت (بدون التحدث)\nمثال: جلس بصمت بجوارها",
 "し出し": "تَمْوِين / صَامِت, غَيْر نَاطِق (غير قادر على أو لا ينطوي بشكل خاص على الكلام أو السطور المنطوقة)\nمثال: كان له دور صامت في المسرحية",
 "し向ける": "أَغْوَى, أَغْرَى / مِقْبَض / أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "し始める": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "し尿": "إفرازات, فضلات الجسم (نفايات (مثل البول أو العرق ولكن خاصة البراز) يتم تصريفها من الجسم)",
 "し損じ": "خطأ فادح, زلة (خطأ محرج)",
 "し損じる": "خطأ فادح, زلة (خطأ محرج)",
 "し損ずる": "خطأ فادح, زلة (خطأ محرج)",
 "し損ない": "خطأ فادح, زلة (خطأ محرج)",
 "し損なう": "خطأ فادح, زلة (خطأ محرج)",
 "し損ねる": "خطأ فادح, زلة (خطأ محرج)",
 "し烈": "عَاصِف, مُضْطَرِب (شَدِيد الهَيَجَان والاضْطِرَاب)",
 "し直す": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "し終える": "فَرَغَ, أَنْهَى\nمثال: انتهى أمر زيري.",
 "し腐る": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "し遂げる": "أَدَّى",
 "じ": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / شَخْصِيَّة\nمثال: زيري سيء الخلق. / خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / قَادِم\nمثال: زيري بجانب الحوض. / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية. / بَاسُور / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم. / مِئَة وَوَاحِد (يَدُلُّ عَلَى العَدَد 101) / طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق. / مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / أَرْض (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة. / هدورة, جلدة\nمثال: سلخ زيري ذلك الغزال. / مَلْمَس / قَاعِدَة / جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر. / دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم.",
 "じあい": "عاطفة, محبة (شعور إيجابي بالإعجاب)\nمثال: وجد صعوبة في التعبير عن المودة التي شعر بها / عشق الذات, نرجسية (اهتمام وإعجاب استثنائي بالنفس)\nمثال: عشق للذات حجب كل شخص آخر / مَلْمَس / لون خفي, مسحة (لون شاحب أو هادئ)",
 "じあえんそさん": "حمض الهيبوكلوروز (حمض ضعيف غير مستقر يعرف فقط في المحلول وفي أملاحه؛ يستخدم كعامل تبييض ومؤكسد)",
 "じあえんそさんえん": "هيبوكلوريت (أي ملح أو إستر لحمض الهيبوكلوروز)",
 "じあえんそさんナトリウム": "هيبوكلوريت الصوديوم",
 "じあたま": "جِهَاز الْمُخَابَرَات, مُخَابَرَات",
 "じあつ": "سَمِيك, غَلِيظ",
 "じありんさん": "حمض الهيبوفوسفوروز (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في…)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "じあん": "خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة)\nمثال: لخص التقرير في صفحة.",
 "じあリンさん": "حمض الهيبوفوسفوروز (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في…)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "じぃじ": "جَدِّي",
 "じぃちゃん": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم…)\nمثال: عليك العمل بجد.",
 "じい": "عَادَة سِرِّيَّة / جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم…)\nمثال: عليك العمل بجد. / شَيْخ, عَجُوز / عجوز, مخضرم / مُظَاهَرَة, تَظَاهُر (مُظَاهَرَة من أجل تحقيق هدف معين ٠)\nمثال: قرابة الألف شاركوا في المظاهرة. / مَسْرَد",
 "じいうんどう": "مُظَاهَرَة, تَظَاهُر (مُظَاهَرَة من أجل تحقيق هدف معين ٠)\nمثال: قرابة الألف شاركوا في المظاهرة.",
 "じいがせ": "خيتون, عديد الأصداف (رخوي بحري بدائي ممدود متناظر ثنائياً له عباءة مغطاة بثماني صفائح جيرية)",
 "じいこうい": "عَادَة سِرِّيَّة / مُظَاهَرَة, تَظَاهُر (مُظَاهَرَة من أجل تحقيق هدف معين ٠)\nمثال: قرابة الألف شاركوا في المظاهرة.",
 "じいさん": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم…)\nمثال: عليك العمل بجد.",
 "じいしき": "ارتباك ذاتي, وعي ذاتي (وعي بالذات بالإضافة إلى الإدراك الإضافي بأن الآخرين يدركونك بالمثل)",
 "じいじ": "جَدِّي",
 "じいじい": "أَزِيزِيّ (ساخن بما يكفي للاحتراق مع صوت أزيز أو كأنَّه كذلك) / صفير حاد, صياح (ضجيج حاد مستمر)\nمثال: صليل السيوف وصفير الأبواق / طَنِين",
 "じいちゃん": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم…)\nمثال: عليك العمل بجد.",
 "じいっと": "بلا حراك (بدون حركة؛ بطريقة ساكنة)\nمثال: رأى الرجل ذا الشعر الأسود ينتظر بلا حراك خلف الجانب الآخر من المنصة / بتركيز, بثبات (بطريقة ثابتة ومركزة)\nمثال: حدق بي بثبات / بصبر (مع صبر؛ بطريقة صبورة)\nمثال: لعب بصبر مع الطفل / بإصرار, بثبات (بتصميم حازم)\nمثال: صدقنا ذلك بحزم",
 "じいろ": "أَرْض (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "じいん": "كَنِيسَة, كَنَائِس (محلّ العبادة عند المسيحيين؛ جماعة المؤمنين بدين المسيح)\nمثال: أين أقرب كنيسة ؟",
 "じいんと": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً)\nمثال: شعروا بالخسارة بعمق / جَارِح, لَاذِع ((في الكلام) حادّ أو مؤذٍ في النبرة أو الطابع)\nمثال: لسعة الموت",
 "じう": "ديمة, زخات مطر (فترة قصيرة من الهطول)\nمثال: توقفت المباراة بسبب زخة مطر قصيرة",
 "じうす": "رَفِيع, رَقِيق",
 "じうた": "أُغْنِيَّةٌ شَعْبِيَّة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة…)\nمثال: أنا أغني أغنية.",
 "じうたいざまえ": "يسار المسرح (جزء المسرح الواقع على يسار الممثل عندما يواجه الجمهور)",
 "じうたいまえ": "يسار المسرح (جزء المسرح الواقع على يسار الممثل عندما يواجه الجمهور)",
 "じぇじぇじぇ": "وَا, يَا يَاه\nمثال: آه ، هناك فراشة!",
 "じぇんこ": "نُقُود, مَال\nمثال: أريد بعض المال.",
 "じえい": "حَرَس خَاصّ, حَرَس (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً…)\nمثال: كان لدى سامي حرس شخصي. / دِفَاع عَنِ النَّفْسِ",
 "じえいかん": "دِفَاع عَنِ النَّفْسِ",
 "じえいかんたい": "دِفَاع عَنِ النَّفْسِ",
 "じえいぎょうしゃ": "عامل مستقل, فريلانسر (كاتب أو فنان يبيع خدماته لأصحاب عمل مختلفين دون عقد طويل الأجل مع أي منهم)",
 "じえいしょうぼうたい": "دفاع عن النفس (فعل الدفاع عن نفسك)",
 "じえいたい": "دفاع عن النفس (فعل الدفاع عن نفسك)",
 "じえいたいはけん": "دِفَاع عَنِ النَّفْسِ",
 "じえいたいほう": "دِفَاع عَنِ النَّفْسِ",
 "じえいだん": "دفاع عن النفس (فعل الدفاع عن نفسك)",
 "じえき": "وَبَاء, أَوْبِئَة (المرض العام الذي ينتشر بين الناس)\nمثال: على السلطات أن توقف انتشار الوباء.",
 "じえん": "التهاب الأذن (التهاب الأذن)",
 "じか": "الآن, اليوم (في هذه الأوقات)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام / ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن. / مَغْنَطَة / مِلْك, نَفْس (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه. / مُبَاشِر\nمثال: تبدو شاحب الوجه. / طب الأذن (فرع الطب المعني بالأذن)",
 "じかい": "حقل مغناطيسي (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل. / إبادة, محق (تدمير شامل)\nمثال: أدت تجارب القنابل إلى إبادة الجزيرة المرجانية / انتحار, تدمير الذات (فعل قتل النفس)\nمثال: الانتحار جريمة (في بعض القوانين) / صيوان الأذن (البنية الغضروفية المرئية خارجياً للأذن الخارجية)",
 "じかいきょうど": "حقل مغناطيسي (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "じかいさく": "تكملة, جزء تالٍ (جزء يضاف إلى كتاب أو مسرحية يكملها ويوسعها)",
 "じかいさよう": "إبادة, محق (تدمير شامل)\nمثال: أدت تجارب القنابل إلى إبادة الجزيرة المرجانية",
 "じかいしょく": "طعم ذاتي (نسيج يؤخذ من موقع ويُطعم في موقع آخر على نفس الشخص)\nمثال: عندما تفشل الكسور في الالتئام، يمكن أن تكون الطعوم الذاتية من العظام قيمة للغاية في مساعدة العظم على الشفاء",
 "じかく": "بَاسُور / وَعْي بِالذَّات (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني…)\nمثال: إنها فاقدة الوعي. / أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد…)\nمثال: لم أدرك أبدا أنه يحبني. / ارتباك ذاتي, وعي ذاتي (وعي بالذات بالإضافة إلى الإدراك الإضافي بأن الآخرين يدركونك بالمثل) / صيوان الأذن (البنية الغضروفية المرئية خارجياً للأذن الخارجية) / الزَّاوِيَة السَّاعِيَّة (المسافة الزاوية على طول خط الاستواء السماوي من خط زوال الراصد إلى الدائرة…)",
 "じかくてき": "خَجُول, مُرْتَبِك مِنْ ذَاتِهِ (واعٍ بشكل مفرط وغير مريح بمظهره أو سلوكه)",
 "じかけいこう": "فلورة ذاتية (فلورة مستحثة ذاتياً)",
 "じかしゅぎ": "سعر السوق, قيمة سوقية (السعر الذي يتبادل به المشترون والبائعون السلعة في سوق مفتوح)",
 "じかじゅせい": "إخصاب ذاتي (إخصاب عن طريق اتحاد الأمشاج الذكرية والأنثوية من نفس الفرد)",
 "じかじゅふん": "تلقيح ذاتي (إخصاب عن طريق نقل حبوب اللقاح من المئبر إلى الميسم في نفس الزهرة)",
 "じかじょうぞう": "مُخَمَّرٌ مَنْزِلِيًّا (مُخمَّر أو مُختمَر في المنزل)",
 "じかせい": "مَنْزِلِيّ",
 "じかせいしょく": "تزاوج ذاتي (الإخصاب الذاتي في النباتات)",
 "じかせん": "غدة نكفية (غدة لعابية كبيرة تنتج 50% من اللعاب أثناء النهار؛ توجد في البشر أمام وأسفل كل…)",
 "じかせんえん": "نُكَاف",
 "じかそうがく": "القيمة السوقية, رسملة السوق (تقدير لقيمة شركة يتم الحصول عليه بضرب عدد الأسهم القائمة في السعر الحالي للسهم)",
 "じかた": "سَاحِل, شَاطِئ / دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من…)\nمثال: لبنان دولة صغيرة.",
 "じかどうちゃく": "تناقض ذاتي (مناقضة النفس)",
 "じかに": "مُبَاشَرَةً",
 "じかはつでん": "عَادَة سِرِّيَّة",
 "じかほけん": "تأمين ذاتي (تأمين نفسك عن طريق تخصيص أموال لتغطية الخسائر المحتملة بدلاً من شراء بوليصة…)",
 "じかほんい": "أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة)",
 "じかん": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه. / وكيل وزارة (وزير يتبع مباشرة رئيس قسم حكومي) / الأنبوب السمعي, النفير (أي من الأنبوبين المزدوجين اللذين يربطان الأذن الوسطى بالبلعوم الأنفي؛ يعمل على…)",
 "じかんかんり": "الوقَة",
 "じかんがい": "وَقْت إِضَافِيّ (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب.",
 "じかんがいきんむ": "وَقْت إِضَافِيّ (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب.",
 "じかんぎれ": "وَقْت مُسْتَقْطَع (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب.",
 "じかんげんしゅ": "انضباط, دقة المواعيد (صفة أو عادة الالتزام بالوقت المحدد)",
 "じかんさ": "فَارِق اَلتَّوْقِيت",
 "じかんじく": "جدول زمني, خط زمني (تسلسل لأحداث مترابطة مرتبة زمنياً ومعروضة على طول خط (عادة ما يُرسم من اليسار…)",
 "じかんずれ": "انتظار, تأجيل (الوقت الذي يتم فيه انتظار إجراء ما)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً",
 "じかんせい": "ممتلكات زمنية (الممتلكات الدنيوية للكنيسة (غير الروحية))",
 "じかんせいげん": "حد زمني, مهلة (فترة زمنية يجب خلالها إنجاز شيء ما أو إكماله)",
 "じかんたい": "فترة, فترة زمنية (مقدار من الزمن)\nمثال: فترة زمنية تمتد لثلاثين عاماً / مِنْطَقَة زَمَنِيَّة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "じかんつぶし": "مضيعة للوقت, هدر الوقت (تكريس الوقت لنشاط غير مجد)\nمثال: قد يكون هدر الوقت قاتلاً",
 "じかんてき": "دُنْيَوِيّ, زَمَنِيّ (مُتَعَلِّق بِالحَياة الدُّنْيا والوُجود الزَّمَنِيّ)\nمثال: متاع الدنيا والتقدم",
 "じかんどおり": "عَلَى الْمَوْعَدِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "じかんにおくれる": "تَأَخَّرَ\nمثال: 約束の時間に遅れた。 — تأخرتُ على الموعد.",
 "じかんのむだ": "مضيعة للوقت, هدر الوقت (تكريس الوقت لنشاط غير مجد)\nمثال: قد يكون هدر الوقت قاتلاً",
 "じかんのムダ": "مضيعة للوقت, هدر الوقت (تكريس الوقت لنشاط غير مجد)\nمثال: قد يكون هدر الوقت قاتلاً",
 "じかんひょう": "جَدْوَل مَوَاعِيد, جَدْوَل",
 "じかんへんかんけいすう": "مقياس زمني (ترتيب للأحداث يُستخدم كمقياس للمدة)\nمثال: على المقياس الزمني الجيولوجي، وجد البشر للحظة وجيزة فقط",
 "じかんめ": "نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "じかんわり": "جَدْوَل مَوَاعِيد, جَدْوَل",
 "じかんをかける": "قَضَى وَقْت",
 "じかんをさく": "وقت الفراغ, وقت حر (الوقت الخالي من الواجبات أو المسؤوليات)",
 "じかんをむだにする": "ضَيَّعَ اَلْوَقْت",
 "じが": "اَلْأَنَا / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن. / بورتريه ذاتي (صورة لنفسك قمت بإنشائها بنفسك)",
 "じがい": "مُنْتَحِر, مُنْتَحِرَة",
 "じがいしき": "ارتباك ذاتي, وعي ذاتي (وعي بالذات بالإضافة إلى الإدراك الإضافي بأن الآخرين يدركونك بالمثل)",
 "じがく": "مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "じがじつげん": "تحقيق الذات (تحقيق قدرات الفرد وإمكاناته)",
 "じがぞう": "بورتريه ذاتي (صورة لنفسك قمت بإنشائها بنفسك)",
 "じがため": "الدور الأرضي, الطابق الأرضي (طابق المبنى الذي يكون عند مستوى الأرض المحيطة بالمبنى أو الأقرب إليه)\nمثال: كانت قاعدة البرج تحت منسوب الأرض",
 "じがね": "سبيكة / معدن خسيس, معدن رخيص (معدن شائع ولا يعتبر ثميناً)\nمثال: الرصاص والحديد والنحاس والقصدير والزنك هي معادن خسيسة",
 "じき": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / خَزَف (خَزَفَ في مَشْيه يَخْزِفُ خَزْفًا: رفع يدَه ووَضعها؛ خَزَفَ الثوبَ: خَرَقه…) / مِغْنَاطِيسِيَّة, مَغْنَاطِيسِيَّة / قَرِيبًا, سَرْعَانَ مَا / بالقرب, في مكان قريب (ليس بعيداً بالمصطلحات النسبية)\nمثال: هي تعمل في مكان قريب / مُبَاشِر\nمثال: تبدو شاحب الوجه. / فُرْصَة / مَوْسِم / طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام. / استماتة, يأس (تهور يائس)\nمثال: كانت سياسة يائسة",
 "じきあらし": "عاصفة مغناطيسية (اضطراب مفاجئ في المجال المغناطيسي للأرض؛ ناتج عن انبعاث جسيمات من الشمس)",
 "じきおんどけい": "مقياس حرارة ذاتي التسجيل (مقياس حرارة يسجل درجة الحرارة تلقائياً)",
 "じきがく": "علم المغناطيسية, مغناطيسية (فرع العلوم الذي يدرس المغناطيسية)",
 "じききあつけい": "باروجراف, مسجل الضغط الجوي (بارومتر مسجل؛ يسجل تلقائياً التغيرات في الضغط الجوي على الورق)",
 "じききおくそうち": "تخزين مغناطيسي, وسيط تخزين مغناطيسي (أي وسيط تخزين تُستخدم فيه أنماط مختلفة من المغنطة لتمثيل البتات أو البايتات…)\nمثال: القرص الصلب في جهاز الكمبيوتر الخاص بك هو تخزين مغناطيسي",
 "じききょうめい": "رنين مغناطيسي (رنين الإلكترونات أو الذرات أو الجزيئات أو الأنوية لترددات الإشعاع نتيجة لتكميم…)",
 "じききょうめいえいぞうほう": "تصوير بالرنين المغناطيسي (استخدام الرنين المغناطيسي النووي للبروتونات لإنتاج صور كثافة البروتون)",
 "じききょうめいがぞう": "تصوير بالرنين المغناطيسي (استخدام الرنين المغناطيسي النووي للبروتونات لإنتاج صور كثافة البروتون)",
 "じききょうめいけっかんさつえい": "رنين مغناطيسي (رنين الإلكترونات أو الذرات أو الجزيئات أو الأنوية لترددات الإشعاع نتيجة لتكميم…)",
 "じききょうめいけっかんぞうえい": "رنين مغناطيسي (رنين الإلكترونات أو الذرات أو الجزيئات أو الأنوية لترددات الإشعاع نتيجة لتكميم…)",
 "じききょうめいしんだんそうち": "تصوير بالرنين المغناطيسي (استخدام الرنين المغناطيسي النووي للبروتونات لإنتاج صور كثافة البروتون)",
 "じききょうめいだんそうさつえい": "رنين مغناطيسي (رنين الإلكترونات أو الذرات أو الجزيئات أو الأنوية لترددات الإشعاع نتيجة لتكميم…)",
 "じききらい": "لغم مغناطيسي ((بحري) لغم بحري يتم تفجيره بواسطة آلية تستجيب للمواد المغناطيسية (مثل الهيكل…)",
 "じきけん": "غلاف مغناطيسي (المجال المغناطيسي لكوكب؛ الحجم حول الكوكب الذي تخضع فيه الجسيمات المشحونة…)",
 "じきさま": "فَوْرًا, حَالًا",
 "じきざま": "فَوْرًا, حَالًا",
 "じきしごせん": "خط الزوال المغناطيسي (خط وهمي يمر عبر كلا القطبين المغناطيسيين للأرض)",
 "じきしょうそう": "سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع)\nمثال: رضيع مبتسر",
 "じきじき": "بالذات, شخصياً (بالحضور الجسدي المباشر؛ دون وسيط)\nمثال: ذهبت إلى هناك شخصياً",
 "じきせいひん": "خَزَف (خَزَفَ في مَشْيه يَخْزِفُ خَزْفًا: رفع يدَه ووَضعها؛ خَزَفَ الثوبَ: خَرَقه…)",
 "じきそうきょくし": "ثنائي قطب مغناطيسي (ثنائي قطب بأقطاب مغناطيسية متضادة)",
 "じきそうしょう": "سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع)\nمثال: رضيع مبتسر",
 "じきそうそう": "سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع)\nمثال: رضيع مبتسر",
 "じきたんきょくし": "أُحَادِيّ القُطْب المِغْنَاطِيسِيّ (جسيم افتراضي له قطب مغناطيسي واحد بدلاً من القطبين المعتادين)",
 "じきていこうりつ": "ممانعة مغناطيسية ((في الفيزياء) مقاومة المادة لإنشاء مجال مغناطيسي فيها)",
 "じきてき": "موسمي (يحدث في أو يعتمد على موسم معين)\nمثال: عمالة موسمية",
 "じきでん": "انْتِقَال مُبَاشِر (آلية انتقال ينتقل فيها العامل المعدي مباشرة إلى الجسم عن طريق اللمس أو العض أو…)",
 "じきに": "فَوْرًا, حَالًا / بِسُهُولَة",
 "じきのうりつ": "عَزْم مَغْنَاطِيسِيّ",
 "じきひ": "شَخْصِيّ",
 "じきひつ": "تَوْقِيع, أُوتُوجْرَاف (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم.",
 "じきふじょう": "رفع مغناطيسي, ماجليف (تكنولوجيا سكك حديدية عالية السرعة؛ حيث يُعلق القطار على وسادة مغناطيسية فوق…)",
 "じきへんさ": "اختلاف مغناطيسي, انحراف مغناطيسي (الزاوية (في موقع معين) بين الشمال المغناطيسي والشمال الحقيقي)",
 "じきものしじょう": "السوق الفورية, سوق السلع الحاضرة (سوق يتم فيها شراء أو بيع سلعة للتسليم الفوري أو التسليم في المستقبل القريب جدًا)",
 "じきゅう": "تحمل, جلد (القدرة على تحمل المشقة أو التوتر)\nمثال: يختبر الماراثون قدرة تحمل العداء / استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "じきゅうじそく": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "じきゅうせん": "حَرْب اِسْتِنْزاف (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "じきゅうりつ": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "じきゅうりょく": "تَحَمُّل, قُوَّةُ تَحَمُّل",
 "じきゆうどう": "شدة المجال المغناطيسي, كثافة التدفق المغناطيسي (كمية التدفق المغناطيسي في وحدة مساحة عمودية على اتجاه التدفق المغناطيسي)",
 "じきょ": "ذهاب, رحيل (فعل المغادرة)",
 "じきょう": "إِقْرَار, اِعْتِرَاف / منظار الأذن (أداة طبية تتكون من عدسة مكبرة وضوء؛ تستخدم لفحص الأذن الخارجية (القناة السمعية…)",
 "じきょく": "أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً))\nمثال: وجد نفسه في ظروف مالية صعبة / حَالَة, وَضْع",
 "じきょくがら": "عَلَى مَرْأَى, فِي مَرْمَى البَصَر (عَلَى مَسَافَةٍ مَعْقُولَةٍ لِلرُّؤْيَة)",
 "じきりゅうたいりきがく": "ديناميكا الموائع المغناطيسية (دراسة تفاعل المجالات المغناطيسية والموائع الموصلة للكهرباء (مثل البلازما أو…)",
 "じきりょく": "جذب مغناطيسي, مغناطيسية (الانجذاب للحديد؛ يرتبط بالتيارات الكهربائية وكذلك المغناطيسات؛ ويتميز بمجالات…)",
 "じきりょくせん": "حقل مغناطيسي (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "じきん": "سبيكة / معدن خسيس, معدن رخيص (معدن شائع ولا يعتبر ثميناً)\nمثال: الرصاص والحديد والنحاس والقصدير والزنك هي معادن خسيسة",
 "じきインク": "حبر مغناطيسي (حبر يحتوي على جزيئات من مادة مغناطيسية يمكن الكشف عن وجودها بواسطة أجهزة…)",
 "じきインクもじ": "حبر مغناطيسي (حبر يحتوي على جزيئات من مادة مغناطيسية يمكن الكشف عن وجودها بواسطة أجهزة…)",
 "じきインクもじにんしき": "حبر مغناطيسي (حبر يحتوي على جزيئات من مادة مغناطيسية يمكن الكشف عن وجودها بواسطة أجهزة…)",
 "じきインクもじよみとりそうち": "حبر مغناطيسي (حبر يحتوي على جزيئات من مادة مغناطيسية يمكن الكشف عن وجودها بواسطة أجهزة…)",
 "じきコアメモリ": "ذاكرة القلب المغناطيسي (ذاكرة كمبيوتر تتكون من مصفوفة من القلوب المغناطيسية؛ تم استبدالها الآن بذواكر…)",
 "じきコンパス": "بوصلة مغناطيسية (بوصلة تعتمد على مؤشر (مثل إبرة مغناطيسية) يشير إلى الشمال المغناطيسي)",
 "じきストライプ": "شريط مغناطيسي (شريط قصير من الشريط المغناطيسي ملحق ببطاقة ائتمان أو بطاقة خصم؛ يحتوي على…)",
 "じきテープ": "شريط مغناطيسي (جهاز ذاكرة يتكون من شريط بلاستيكي رفيع طويل مطلي بأكسيد الحديد؛ يستخدم لتسجيل…)\nمثال: أخذ معه دزينة من الأشرطة لتسجيل المقابلة",
 "じきテープきおくそうち": "شريط مغناطيسي (جهاز ذاكرة يتكون من شريط بلاستيكي رفيع طويل مطلي بأكسيد الحديد؛ يستخدم لتسجيل…)\nمثال: أخذ معه دزينة من الأشرطة لتسجيل المقابلة",
 "じきディスク": "قرص مغناطيسي ((علم الحاسوب) جهاز ذاكرة يتكون من قرص مسطح مغطى بطبقة مغناطيسية يتم تخزين…)",
 "じきドラム": "أسطوانة مغناطيسية (أسطوانة مطلية بمادة مغناطيسية، لتخزين بيانات وبرامج الحاسوب)",
 "じきドラムきおくそうち": "أسطوانة مغناطيسية (أسطوانة مطلية بمادة مغناطيسية، لتخزين بيانات وبرامج الحاسوب)",
 "じきヘッド": "رأس مغناطيسي (مغناطيس كهربائي (كما في مسجل الشريط) يحول التغيرات الكهربائية إلى تغيرات…)",
 "じきモーメント": "عَزْم مَغْنَاطِيسِيّ",
 "じぎ": "قَوْس, قوس / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "じぎどおり": "لَفْظِيّ, حَرْفِيّ",
 "じぎゃく": "تعذيب النفس, جلد الذات (ضيق مفروض ذاتياً)",
 "じぎゃくてき": "تعذيب النفس, جلد الذات (ضيق مفروض ذاتياً)",
 "じぎゃくネタ": "مُتَوَاضِع, مُنْتَقِص مِنْ ذَاتِه (واعٍ بعيوبه وقصوره الشخصيّة)",
 "じぎょう": "شَرِكَة\nمثال: المهم هو العمل. / مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء…)\nمثال: هذا مشروع عظيم. / مِنْطَقَة, أَرْض (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "じぎょうか": "تَصْنِيع, تَحَوُّل صِنَاعِيّ / إضفاء الطابع التجاري, تسويق تجاري (فعل جعل الشيء تجارياً؛ إدخال شيء ما في التجارة)\nمثال: اعتبر والدي تحويل عيد الميلاد إلى مناسبة تجارية تدنيساً للمقدسات / رَجُل أَعْمَال, تَاجِر (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول…)\nمثال: هذا الرجل تاجر.",
 "じぎょうかつどう": "نشاط تجاري (نشاط يتم القيام به كجزء من مؤسسة تجارية)",
 "じぎょうがいしゃ": "شركة, مؤسسة تجارية (أعضاء منظمة تجارية تمتلك أو تدير مؤسسة واحدة أو أكثر)\nمثال: عمل في شركة وساطة",
 "じぎょうけいかく": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء…)\nمثال: هذا مشروع عظيم.",
 "じぎょうしゅ": "رَائِد أَعْمال مُتَعَهِّد / رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "じぎょうしょ": "تَأْسِيس",
 "じぎょうじょう": "مَكَان عَمَل (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "じぎょうせい": "إِعْلَان تِجَارِيّ",
 "じぎょうだん": "كرش (مصطلحات عامية للكرش أو البطن البارز)",
 "じぎょうぬし": "رَائِد أَعْمال مُتَعَهِّد / رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "じぎょうねんど": "سَنَة مَالِيَّة (مقدارُ قطع الشمس البروجَ الاثني عشر ، وهي السنة الشمسيَّة، و السَّنَةُ تمامُ…)\nمثال: في عمره 24 سنة.",
 "じぎょうぶ": "تَقْسِيم\nمثال: الزواج قسمة و نصيب.",
 "じぎょうほんぶ": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "じぎわ": "قَاعِدَة",
 "じく": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات) / مِحْوَر / مَرْكَز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟ / سَاق / قَوْس, قوس",
 "じくあし": "تَرْكِيز",
 "じくう": "زمكان, متصل مكاني زماني (نظام الإحداثيات رباعي الأبعاد (3 أبعاد للمكان و1 للزمان) الذي تقع فيه الأحداث…)",
 "じくうかん": "زمكان, متصل مكاني زماني (نظام الإحداثيات رباعي الأبعاد (3 أبعاد للمكان و1 للزمان) الذي تقع فيه الأحداث…)",
 "じくうけ": "رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة)\nمثال: وقف بوضعية جيدة",
 "じくうせかい": "زمكان, متصل مكاني زماني (نظام الإحداثيات رباعي الأبعاد (3 أبعاد للمكان و1 للزمان) الذي تقع فيه الأحداث…)",
 "じくうれんぞくたい": "زمكان, متصل مكاني زماني (نظام الإحداثيات رباعي الأبعاد (3 أبعاد للمكان و1 للزمان) الذي تقع فيه الأحداث…)",
 "じくきょ": "قَاعِدَة العَجَلَات (المسافة من مركز العجلة الأمامية للسيارة إلى المحور الخلفي)",
 "じくぎ": "حُطَام خشب, عِيدَان (شظايا أو فتات من الخشب)\nمثال: تَحَطَّم إلى شظايا خشبية صغيرة",
 "じくぐみ": "إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي",
 "じくさく": "محور عصبي (ليف عصبي طويل ينقل الإشارات بعيداً عن جسم الخلية العصبية)",
 "じくじ": "خَجُول",
 "じくじく": "رَاشِح, نَازِّ (يتسرّب ببطء)",
 "じくせい": "مِحْوَرِيّ (واقِع عَلى المِحْوَر أَوْ في اتِّجاهِه)\nمثال: زاوية محورية",
 "じくせん": "مِحْوَر",
 "じくつい": "مِحْوَر",
 "じくぼう": "قصبة الريشة (العمود الفقري المجوف للريشة)",
 "じくもの": "طُومَار",
 "じくりゅうすいしゃ": "توربين محوري التدفق, عنفة محورية (توربين يعمل بتدفق محوري عكس الضاغط المحوري تماماً)\nمثال: بينما يصطدم تدفق الهواء بالدوار في التوربين المحوري، يتم توجيه التدفق بسلاسة بزاوية 90 درجة في التوربين الشعاعي",
 "じぐち": "لُعْبَة اَلْكَلِمَات, جِنَاس (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "じぐるま": "رباعي العجلات (مكون من أو متعلق بالمركبات ذات العجلات الأربع)\nمثال: دفع رباعي العجلات",
 "じけい": "اقتصاص ذاتي, الأمن الأهلي (أفعال لجنة أمن أهلي في محاولة لإنفاذ القوانين) / إدارة محلية, حكومة محلية (حكومة منطقة محلية) / مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء…)\nمثال: هذا مشروع عظيم.",
 "じけいいりょうかがくだいがくいんだいがく": "كلية الدراسات العليا (مدرسة في جامعة تقدم دراسة تؤدي إلى درجات علمية تتجاوز درجة البكالوريوس)",
 "じけいだん": "دِفَاع عَنِ النَّفْسِ",
 "じけいだんいん": "عضو لجنة الأمن الأهلية (عضو في لجنة الأمن الأهلية)",
 "じけいれつ": "سلسلة زمنية (سلسلة من قيم متغير في أوقات متتالية) / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟",
 "じけいれつぶんせき": "سلسلة زمنية (سلسلة من قيم متغير في أوقات متتالية)",
 "じけし": "مِمْحَاة",
 "じけっしゅ": "أذن قرنبيطية (صيوان أذن مشوه بسبب إصابة؛ شائع بين الملاكمين)",
 "じけつ": "تَقْرِيرُ المَصِير / مُنْتَحِر, مُنْتَحِرَة",
 "じけん": "وَاقِعَة, حَادِثَة (مؤنث الوَاقِع، اسم فاعل للشيء المؤنث الذي وَقَعَ؛ مؤنث وَاقِع، الأمر المؤنث…)\nمثال: الصخور الواقعة تشكل خطرا على المتسلقين. / دائرة الساعة (دائرة عظمى على الكرة السماوية تمر عبر كلا القطبين السماويين)",
 "じけんせい": "إجرام (حالة كون الشخص مجرماً)",
 "じけんひょう": "برنامج زمني, جدول أعمال (خطة منظمة زمنياً للأمور التي يجب الاهتمام بها)",
 "じけんや": "ميثادون (عقار مخدر صناعي مشابه للمورفين ولكنه أقل تسبباً في التعود؛ يستخدم في إزالة…)",
 "じげ": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "じげん": "حَرْف صِينِيّ, طَابِع صِينِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء. / نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه. / حد زمني, مهلة (فترة زمنية يجب خلالها إنجاز شيء ما أو إكماله) / بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / مَنْظُور, نَظْرَة / مُظَاهَرَة (عرض عام للمشاعر الجماعية (عادة ذات طابع سياسي))\nمثال: كانت هناك مظاهرات عنيفة ضد الحرب",
 "じげんすう": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "じげんばくだん": "قُنْبُلَةٌ مَوْقُوتَةٌ",
 "じこ": "حَادِث\nمثال: لا تدعها للصدفة. / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً))\nمثال: وجد نفسه في ظروف مالية صعبة / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن.",
 "じこあい": "نَرْجِسِيَّة (حُبُّ المرء ذاته وعِشْقُهُ إِيَّاهَا دون سواها)",
 "じこあいせいじんかくしょうがい": "اِضْطِرَاب الشَخْصِيَّة النَرْجِسِيَّة",
 "じこあいせいパーソナリティしょうがい": "اِضْطِرَاب الشَخْصِيَّة النَرْجِسِيَّة",
 "じこあんじ": "إيحاء ذاتي (نظام لتطوير الذات طوره إميل كوي وكان شائعاً في العشرينيات والثلاثينيات)",
 "じこいしき": "ارتباك ذاتي, وعي ذاتي (وعي بالذات بالإضافة إلى الإدراك الإضافي بأن الآخرين يدركونك بالمثل)",
 "じこいしょく": "طعم ذاتي (نسيج يؤخذ من موقع ويُطعم في موقع آخر على نفس الشخص)\nمثال: عندما تفشل الكسور في الالتئام، يمكن أن تكون الطعوم الذاتية من العظام قيمة للغاية في مساعدة العظم على الشفاء",
 "じこいにゅう": "تَعَاطُف",
 "じこう": "مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / وَصْفَة طِبِّيَّة, وَصْفَة / لم يعد (ليس الآن)\nمثال: لم تعد موجودة / آخِذ فِي الشَّيْخُوخَة, شَائِخ (في طور التقدّم في السنّ والشيخوخة) / صِمْلَاخ, شَمْع اَلْأُذْن / مَوْسِم / تَقْلِيعَة / طين صيني, كاولين (طين ناعم عادة ما يكون أبيض ناتج عن تجوية المعادن الألومينية (مثل الفلسبار)…) / ماغنيتيت, مغناطيس طبيعي (أكسيد حديد ينجذب بقوة للمغناطيس) / مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "じこうおん": "ميزو سوبرانو (الصوت الغنائي النسائي بين الكونترالتو والسوبرانو)",
 "じこうかい": "مَحَارَة ((في التشريح) بنية تشبه الصدفة في شكلها)",
 "じこうきゅうしょく": "في الموقع, ميداني (يحدث أو يقع في الموقع نفسه)\nمثال: تفتيش ميداني",
 "じこうはずれ": "في غير موسمه (لا يتماشى مع (وعادة ما يكون غير مرغوب فيه لـ) الموسم)\nمثال: عاصفة ثلجية مفاجئة في غير موسمها",
 "じこかいじ": "إِفْصَاح عَن الذَّات",
 "じこかぶしき": "أسهم الخزينة (أسهم أعادت الشركة المصدرة شراءها ومتاحة للإلغاء أو إعادة البيع؛ وهي مصدرة…)",
 "じこかんけつ": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "じこかんけつてき": "مُسْتَغْرِق فِي نَفْسِه, مُنْغَمِس فِي ذَاتِه (منغمس في اهتماماته أو أفكاره الخاصة)",
 "じこぎせい": "إِيثَار, نُكْرَان الذَّات (التصرف بقلة اهتمام بالنفس مقابل نجاح النشاط المشترك)",
 "じこぎまん": "خداع الذات (مفهوم خاطئ يكون في صالح الشخص الذي يحمله)",
 "じこく": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / فُرْصَة / بورتريه ذاتي (صورة لنفسك قمت بإنشائها بنفسك)",
 "じこくさんテロリズム": "إرهاب محلي (إرهاب يمارس في بلدك ضد شعبك)\nمثال: كان تفجير المبنى الفيدرالي في أوكلاهوما سيتي عام 1995 مثالاً على الإرهاب المحلي",
 "じこくひょう": "جَدْوَل مَوَاعِيد, جَدْوَل",
 "じこくみん": "مُوَاطِن, مُوَاطِنَة (مَدَنِيّ؛ مُقِيم)\nمثال: أنا مواطن لبناني",
 "じこけいはつしょ": "تحسين الذات, تطوير الذات (فعل تحسين نفسك)",
 "じこけいはつぼん": "تحسين الذات, تطوير الذات (فعل تحسين نفسك)",
 "じこけってい": "تَقْرِيرُ المَصِير",
 "じこけんお": "اشمئزاز من الذات, كره الذات (خزي ناتج عن كراهية قوية لنفسك أو لأفعالك)",
 "じこけんさん": "تحسين الذات, تطوير الذات (فعل تحسين نفسك)",
 "じここうたい": "جسم مضاد ذاتي (جسم مضاد يعمل ضد أنسجة الكائن الحي الذي ينتجه)",
 "じここうていかん": "تَقْدِير ذَات",
 "じこさいみん": "تنويم ذاتي (تنويم مغناطيسي يقوم به الشخص لنفسه)",
 "じこしゅうきょうふしょう": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "じこしゅうしょう": "رائحَة الجسم (الخاصية التي تمتلكها بعض المركبات الكيميائية المتطايرة في الهواء على الأرجح…)\nمثال: شم تلك الرائحة.",
 "じこしゅうよう": "تثقيف ذاتي, تعليم ذاتي (عملية تعليم النفس)",
 "じこしゅぎ": "أَنَانِيَّة",
 "じこしゅちょう": "تأكيد الذات (فعل تأكيد المرء لنفسه بطريقة عدوانية)",
 "じこしょうか": "تحلل ذاتي, هضم ذاتي (تحلل الأنسجة النباتية أو الحيوانية عن طريق عملية داخلية)",
 "じこしんだん": "استبطان, تأمل ذاتي (تأمل أفكارك ورغباتك وسلوكك)",
 "じこじつげん": "تحقيق الذات (تحقيق قدرات الفرد وإمكاناته)",
 "じこじゅようき": "مستقبل الحس العميق (نهايات عصبية خاصة في العضلات والأوتار والأعضاء الأخرى تستجيب للمحفزات المتعلقة…)",
 "じこせきにん": "بِمُفْرَدِي",
 "じこそうじずけい": "فركتل, كسرية ((رياضيات) نمط هندسي يتكرر عند كل مقياس، وبالتالي لا يمكن تمثيله بالهندسة…)",
 "じこそしきか": "تنظيم ذاتي (تنظيم نفسك (خاصة تنظيم نقابة العمال الخاصة بك))",
 "じこたはつ": "كَثِير الحَوَادِث (يتعرّض لعدد من الحوادث يفوق المتوسّط)",
 "じこたはつちてん": "كَثِير الحَوَادِث (يتعرّض لعدد من الحوادث يفوق المتوسّط)",
 "じこたんれん": "إنكار الذات, ضبط النفس (فعل إنكار الذات؛ السيطرة على الدوافع)",
 "じこちゅう": "أَنَانِيَّة",
 "じこちゅうしん": "أَنَانِيَّة",
 "じこちゅうしんせい": "أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة)",
 "じこちゅうしんてき": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "じことうえい": "إِسْقَاط\nمثال: دفنت في مسقط رأسها.",
 "じことうすい": "نَرْجِسِيَّة (حُبُّ المرء ذاته وعِشْقُهُ إِيَّاهَا دون سواها)",
 "じこどうちゃく": "تناقض ذاتي (مناقضة النفس)",
 "じこはかい": "انتحار, تدمير الذات (فعل قتل النفس)\nمثال: الانتحار جريمة (في بعض القوانين)",
 "じこはんせい": "إعادة نظر, تفكير ثانٍ (التفكير مرة أخرى في خيار تم اتخاذه سابقاً)\nمثال: أعاد النظر في مشترياته",
 "じこひだい": "تمجيد الذات, غرور (عمل يتم لزيادة قوتك ونفوذك أو لجذب الانتباه لأهميتك الخاصة)",
 "じこひてい": "إِنْكَار الذَّات, زُهْد (التخلي عن مصالحك الخاصة لصالح مصالح الآخرين)",
 "じこひはん": "نقد ذاتي (انتقاد المرء لنفسه)",
 "じこひょうか": "تَقْدِير ذَات",
 "じこひょうげん": "تعبير عن الذات (التعبير عن فردية المرء (عادة من خلال الأنشطة الإبداعية))",
 "じこぶっけん": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "じこぶんかい": "تحلل ذاتي, هضم ذاتي (تحلل الأنسجة النباتية أو الحيوانية عن طريق عملية داخلية)",
 "じこぶんせき": "تحليل ذاتي (تطبيق مبادئ العلاج النفسي لتحليل شخصيتك الخاصة)",
 "じこべんご": "تبرير, حجة (دفاع عن سلوك مسيء أو فشل في الوفاء بوعد وما إلى ذلك)\nمثال: استمر في إيجاد الأعذار للبقاء",
 "じこほしん": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "じこほぜん": "دفاع عن النفس (فعل الدفاع عن نفسك)",
 "じこほぞん": "حفظ الذات, غريزة البقاء (حفظ النفس من الأذى؛ ميل طبيعي أو غريزي)",
 "じこほんい": "أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة)",
 "じこぼうえい": "دِفَاع عَنِ النَّفْسِ",
 "じこまん": "رضا عن الذات, غرور (الشعور الذي ينتابك عندما تكون راضياً عن نفسك)\nمثال: كان رضاه عن نفسه مثيراً للاشمئزاز تماماً",
 "じこまんぞく": "رضا عن الذات, غرور (الشعور الذي ينتابك عندما تكون راضياً عن نفسك)\nمثال: كان رضاه عن نفسه مثيراً للاشمئزاز تماماً",
 "じこむじゅん": "تناقض ذاتي (مناقضة النفس)",
 "じこめんえき": "مناعة ذاتية (إنتاج أجسام مضادة ضد أنسجة جسمك؛ يسبب أمراض المناعة الذاتية أو تفاعلات فرط…)",
 "じこめんえきしっかん": "مرض مناعة ذاتية (أي من مجموعة كبيرة من الأمراض التي تتميز بخلل في وظائف الجهاز المناعي مما يجعله…)",
 "じこめんえきせい": "مناعة ذاتية (إنتاج أجسام مضادة ضد أنسجة جسمك؛ يسبب أمراض المناعة الذاتية أو تفاعلات فرط…)",
 "じこめんえきふぜん": "مرض مناعة ذاتية (أي من مجموعة كبيرة من الأمراض التي تتميز بخلل في وظائف الجهاز المناعي مما يجعله…)",
 "じこもく": "أَمَل ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل.",
 "じこゆうどう": "حث ذاتي (توليد قوة دافعة كهربائية في دائرة بتغيير التيار في تلك الدائرة؛ يقاس عادة…)",
 "じこよくせい": "تمالك النفس (إظهار التحفظ المفروض على الذات)\nمثال: اعتدال فعال في النقاش",
 "じこれんびん": "رثاء الذات (شعور بالأسى (غالباً ما يكون متساهلاً مع الذات) على معاناة المرء الخاصة)",
 "じこん": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "じこんいご": "من الآن, من الآن فصاعداً (من هذا الوقت فصاعداً؛ من الآن فصاعداً)\nمثال: من الآن فصاعداً ستعرف باسم السيدة سميث",
 "じこんじご": "فِي ٱلْمُسْتَقْبَل (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "じこインダクタンス": "حَثّ ذَاتِيّ, مُعَامِل الحَثّ الذَّاتِيّ (النسبة بين القوة الدافعة الكهربائية الناتجة في دائرة عن طريق الحث الذاتي ومعدل…)",
 "じご": "بعد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / بعد ذلك, منذ ذلك الحين (من ذلك الوقت فصاعداً)\nمثال: بعد ذلك لم يتصل أبداً مرة أخرى / خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح)",
 "じごう": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "じごえ": "سجل الصدر, صوت الصدر (النطاقات الدنيا للصوت في الكلام أو الغناء)",
 "じごく": "جَهَنَّم, جَحِيم",
 "じごくでほとけにあったよう": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "じごくにほとけ": "رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال))\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "じごしん": "مراجعة قضائية (مراجعة من قبل محكمة قانونية لإجراءات مسؤول حكومي أو هيئة أو شخص أو هيئة أخرى…)",
 "じごじゅうはん": "شريك بعد الواقعة (شخص يقدم المساعدة أو الراحة لشخص معروف بأنه مجرم أو معروف بأنه مطلوب فيما يتعلق…)",
 "じごじゅうはんにん": "شريك بعد الواقعة (شخص يقدم المساعدة أو الراحة لشخص معروف بأنه مجرم أو معروف بأنه مطلوب فيما يتعلق…)",
 "じごほうこく": "بِأَثَر رَجْعِيّ, رَجْعِيّ الأَثَر (يؤثّر في أمور ماضية)",
 "じさ": "فَارِق اَلتَّوْقِيت",
 "じさい": "شماس مساعد, مساعد الكاهن (شخص يساعد الكاهن أو القس في الخدمة الليتورجية؛ رجل دين مرسوم في أعلى الرتب…) / مُنْتَحِر, مُنْتَحِرَة",
 "じさくじえん": "مُدَبَّر سِرًّا (مخطط له في السر)",
 "じさげ": "تحزيز, تسنين (عملية القطع في حافة بشقوق تشبه الأسنان أو شقوق زاوية)",
 "じさつ": "مُنْتَحِر, مُنْتَحِرَة",
 "じさつてき": "اِنْتِحَارِيّ",
 "じさつてん": "هدف ذاتي, هدف عكسي (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "じさぼけ": "إعياء السفر, اضطراب الرحلات الجوية الطويلة (تعب واضطراب في النوم ناتج عن خلل في الإيقاع اليومي الطبيعي للجسم نتيجة السفر…)",
 "じさん": "تسليم, توصيل (عملية تسليم أو توزيع شيء ما (كالبضائع أو البريد))\nمثال: تسليمه المتردد للأخبار السيئة / تباهي, تفاخر (الحديث عن النفس بصيغ التفخيم)",
 "じさんきん": "مَهْر",
 "じさんにん": "حامل, ناقل (شخص تتضمن وظيفته حمل شيء ما)\nمثال: نُقلت السندات بواسطة حامل",
 "じさボケ": "إعياء السفر, اضطراب الرحلات الجوية الطويلة (تعب واضطراب في النوم ناتج عن خلل في الإيقاع اليومي الطبيعي للجسم نتيجة السفر…)",
 "じざい": "خطاف القدر",
 "じざいかぎ": "خطاف القدر",
 "じざいつぎて": "مفصل عام, وصلة كاردان (قارنة تربط عمودين دوارين مما يسمح بحرية الحركة في جميع الاتجاهات)\nمثال: في المركبات الآلية، يسمح المفصل العام لعمود التدوير بالتحرك صعوداً وهبوطاً أثناء مرور المركبة فوق المطبات",
 "じざいど": "باب متأرجح (باب يتأرجح على مفصل مزدوج؛ يفتح في أي من الاتجاهين)",
 "じざいに": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "じざいスパナ": "مِفْتَاح إِنْجْلِيزِيّ (مفتاح)\nمثال: بحث عن المفتاح.",
 "じざかい": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "じし": "بِاحْتِرَام (بطريقة محترمة)\nمثال: هل لي أن أقترح باحترام على مجلس المدينة أن يتبنوا سياسة عدم النشاط المتقن؟ / مُنْتَحِر, مُنْتَحِرَة / اسْتِماتَة / وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / سبابة (الإصبع المجاور للإبهام)",
 "じしつ": "تخدير, ذهول (فعل جعل الشخص متبلد الشعور أو خاملاً)\nمثال: اشتهر الأستاذ بجعل طلابه في حالة ذهول / بَاسُور",
 "じしゃ": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)\nمثال: كان حاضراً دائماً في اجتماعات القسم / إِنْكَار, رَفْض",
 "じしゃかぶこうにゅうけん": "خيار الأسهم, خيار شراء الأسهم (ميزة تمنحها الشركة للموظف في شكل خيار لشراء أسهم في الشركة بخصم أو بسعر ثابت)",
 "じしゃが": "مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "じしゃく": "مَغْنَاطِيس / بُوصُّلَة (البُوصَلَة أو البَوصَلَة : أَدَاة تسمَح بتحديد الاتجاهات)",
 "じしゃくばん": "بوصلة مغناطيسية (بوصلة تعتمد على مؤشر (مثل إبرة مغناطيسية) يشير إلى الشمال المغناطيسي)",
 "じしゃこう": "مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "じしゅ": "اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع…)\nمثال: الصحراويون يريدون الاستقلال. / اِسْتَسْلَمَ",
 "じしゅうしょ": "كريبج (لعبة ورق (عادة للاعبين اثنين) يتم فيها توزيع ست أوراق لكل لاعب ويتخلص من ورقة…)",
 "じしゅうしょう": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "じしゅかんり": "ذَاتِيُّ الفَرْض (فُرِضَ أَوْ تُحُمِّلَ طَوْعًا عَلَى النَّفْس)",
 "じしゅく": "تمالك النفس (إظهار التحفظ المفروض على الذات)\nمثال: اعتدال فعال في النقاش",
 "じしゅくけいさつ": "مُعَيَّن ذَاتِيًّا (عيّن نفسه بنفسه دون تفويض من جهة أخرى)",
 "じしゅけん": "اِسْتِقْلال, تَحَرُّر (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع…)\nمثال: الصحراويون يريدون الاستقلال.",
 "じしゅせい": "اِسْتِقْلال, تَحَرُّر (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع…)\nمثال: الصحراويون يريدون الاستقلال.",
 "じしゅてき": "مُسْتَقِل, حُرّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
 "じしゅぼうえい": "ذَاتِيُّ التَّوْجِيه, مُسْتَقِلّ ((عَنِ الأَشْخَاصِ) حُرٌّ مِنَ السَّيْطَرَةِ وَالقُيُودِ الخَارِجِيَّةِ فِي…)",
 "じしょ": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق…)\nمثال: أي قاموس تعنيه؟ / مُمْتَلَكَات, تَرِكَة / تَوْقِيع, إِمْضَاء (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم.",
 "じしょう": "وَاقِعَة, حَادِثَة (مؤنث الوَاقِع، اسم فاعل للشيء المؤنث الذي وَقَعَ؛ مؤنث وَاقِع، الأمر المؤنث…)\nمثال: الصخور الواقعة تشكل خطرا على المتسلقين. / مُنَصِّبٌ نَفْسَهُ (يصف نفسه بصفة ما دون تأييد من الآخرين) / مُتَكَلِّم / سُرِّيَة",
 "じしょうぎ": "مأزق",
 "じしょうこつ": "عظيمات السمع (عظيمات الأذن الوسطى التي تنقل الاهتزازات الصوتية من طبلة الأذن إلى الأذن…)",
 "じしょうのちへいせん": "أُفُق اَلْحَدَث ((أَفِقَ) أفَقَاً: بلغ النِّهَايَة فِي الْكَرم وَالْعلم فَهُوَ أفق وأفيق)\nمثال: طلعت الشمس فوق الأفق.",
 "じしょうのちへいめん": "أُفُق اَلْحَدَث ((أَفِقَ) أفَقَاً: بلغ النِّهَايَة فِي الْكَرم وَالْعلم فَهُوَ أفق وأفيق)\nمثال: طلعت الشمس فوق الأفق.",
 "じしょがく": "علم المعجم, لكسيكولوجيا (فرع اللسانيات الذي يدرس المكون المعجمي للغة)",
 "じしょく": "اِسْتِقَالَة, اِسْتِعْفَاء / ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / إخصاب ذاتي (إخصاب عن طريق اتحاد الأمشاج الذكرية والأنثوية من نفس الفرد)",
 "じしょくねがい": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "じしょけい": "لَيمَّا ((في علم اللسانيات) الشكل المعجمي القانوني للكلمات التي تتشارك في المعنى عينه…)",
 "じしょこうげき": "هجوم المعجم",
 "じしょぶもん": "معجم ذهني, مفردات (معرفة مستخدم اللغة بالكلمات)",
 "じしょへんしゅう": "صناعة المعاجم, معجمية (فعل تأليف القواميس)",
 "じしょへんしゅうしゃ": "معجمي, واضع المعاجم (جامع أو كاتب القاموس؛ دارس للمكون اللفظي للغة)",
 "じしょるい": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق…)\nمثال: أي قاموس تعنيه؟",
 "じしん": "رجل حاشية (مرافق في بلاط الحاكم) / النزعَة إلى الخير / نِوَاة / ثِقَة بِالنَّفْس / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن. / زَلْزَال, زِلْزال (فِي : ظاهرة طبيعية وهو اهتزاز أو سلسلة من الاهتزازات الارتجاجية المتتالية لسطح…)\nمثال: دمر زلزال عيادة سامي. / ازدواجية, تعامل بوجهين (التصرف بسوء نية؛ الخداع بالتظاهر بامتلاك مجموعة من النوايا بينما يتصرف تحت…) / إبرة مغناطيسية (مغناطيس رفيع معلق في بوصلة مغناطيسية على حامل باحتكاك قليل؛ يستخدم للإشارة إلى…) / عَقْرَب سَاعَات / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب.",
 "じしんかじょう": "مَغْرُور, مُفْرِط الثِّقَة (يتّسم بثقة مفرطة تتجاوز الحدّ المعقول)",
 "じしんがく": "عِلْم اَلزَّلَازِل (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "じしんがくしゃ": "عالم زلازل (جيوفيزيائي يدرس الزلازل والخصائص الميكانيكية للأرض)",
 "じしんきしょう": "سيزموجرام, مخطط زلزالي (السجل البياني لهزة أرضية تم إجراؤه باستخدام جهاز قياس الزلازل)",
 "じしんぎ": "أداة توقيت, ساعة (أداة قياس أو جهاز لحفظ الوقت) / كرونومتر, مقياس الزمن (ساعة دقيقة (تستخدم بشكل خاص في الملاحة))",
 "じしんけい": "جهاز قياس الزلازل, سيسموجراف (أداة قياس للكشف عن وقياس شدة واتجاه ومدة حركات الأرض (مثل الزلزال))",
 "じしんさく": "عمل فني (فن هو نتاج أحد الفنون الجميلة (خاصة لوحة أو نحت ذو قيمة فنية))",
 "じしんそうしつ": "عقدة الدونية, عقدة نقص (شعور بالنقص الشخصي ينشأ من الصراع بين الرغبة في لفت الانتباه والخوف من التعرض…)",
 "じしんたっぷり": "وَاثِق",
 "じしんつなみ": "تْسُونَامِي",
 "じしんばん": "سجن عسكري, مركز حراسة (منشأة عسكرية تعمل كمقر للشرطة العسكرية ويمكن فيها احتجاز السجناء العسكريين)",
 "じじ": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم…)\nمثال: عليك العمل بجد. / شَيْخ, عَجُوز / عجوز, مخضرم",
 "じじい": "شَيْخ, عَجُوز / عجوز, مخضرم",
 "じじこくこく": "بالساعة, كل ساعة (كل ساعة؛ حسب الساعة)\nمثال: يومياً، بل كل ساعة، كنت أزداد قوة",
 "じじこっこく": "بالساعة, كل ساعة (كل ساعة؛ حسب الساعة)\nمثال: يومياً، بل كل ساعة، كنت أزداد قوة",
 "じじつ": "مَعْلُومَة, حَقِيقَة / فِي الْحَقِيقَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / تَمْرَة, تَمْر\nمثال: ما تاريخ اليوم؟",
 "じじつこん": "بحكم الأمر الواقع",
 "じじつじょう": "فِي الْحَقِيقَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "じじつじょうのひょうじゅん": "بحكم الأمر الواقع",
 "じじつじょうひょうじゅん": "بحكم الأمر الواقع",
 "じじつちょうさ": "تقصي الحقائق",
 "じじつにてらして": "عَلَى مَرْأَى, فِي مَرْمَى البَصَر (عَلَى مَسَافَةٍ مَعْقُولَةٍ لِلرُّؤْيَة)",
 "じじつにんてい": "تقصي الحقائق",
 "じじつむこん": "لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "じじばば": "جَدّ, جَدَّة (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم…)\nمثال: عليك العمل بجد.",
 "じじぶつぶつ": "كُلّ شَيْء",
 "じじむさい": "خَرِف, هَرِم (ضعيف عقلياً أو جسدياً بسبب الشيخوخة)",
 "じじゃく": "مُتَمَالِكٌ لِنَفْسِه, مُتَّزِن (مسيطر تمامًا على ملكاته وقدراته؛ رابط الجأش)",
 "じじゅ": "زنمة (سديلة غضروفية صغيرة أمام الفتحة الخارجية للأذن)",
 "じじゅう": "حاجب, رئيس التشريفات (ضابط يدير منزل ملك أو نبيل) / حمل ميت (حمل ثابت على هيكل (مثل الجسر) بسبب وزن الهيكل المدعوم نفسه)",
 "じじゅうかん": "حاجب, رئيس التشريفات (ضابط يدير منزل ملك أو نبيل)",
 "じじゅうトレーニング": "وزن الجسم (وزن جسم الشخص)",
 "じじょ": "خادمة خاصة, وصيفة (خادمة تكون مرافقة شخصية لسيدة) / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية. / اعتماد على النفس, مساعدة ذاتية (فعل مساعدة أو تحسين المرء لنفسه دون الاعتماد على أي شخص آخر) / سِيرَة ذَاتِيَّة / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "じじょう": "أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً))\nمثال: وجد نفسه في ظروف مالية صعبة / مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / حقل مغناطيسي (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل. / أجواء, جو (الغلاف الجوي للبيئة المحيطة)\nمثال: كان هناك جو من الإثارة",
 "じじょうこん": "جَذْر تَرْبِيعِيّ (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "じじょうちょうしゅ": "استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته",
 "じじょぐ": "اعتماد على النفس, مساعدة ذاتية (فعل مساعدة أو تحسين المرء لنفسه دون الاعتماد على أي شخص آخر)",
 "じじょでん": "سِيرَة ذَاتِيَّة",
 "じじょどりょく": "اعتماد على النفس, مساعدة ذاتية (فعل مساعدة أو تحسين المرء لنفسه دون الاعتماد على أي شخص آخر)",
 "じじょろん": "اعتماد على النفس, مساعدة ذاتية (فعل مساعدة أو تحسين المرء لنفسه دون الاعتماد على أي شخص آخر)",
 "じじん": "مُنْتَحِر, مُنْتَحِرَة / جيل, معاصرون (جميع الناس الذين يعيشون في نفس الوقت أو من نفس العمر تقريباً)",
 "じす": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا. / اِسْتَقَالَ / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "じすう": "دَرَجَة",
 "じすうつき": "مُدَرَّج, مُرَتَّب (منظَّم في تسلسل من الدرجات أو الرُّتَب)",
 "じすべり": "اِنْهِيَار أَرْضِيّ (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى…)\nمثال: يوشك الجسر على الانهيار.",
 "じする": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا. / اِسْتَقَالَ / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / مَسَكَ, مسك / شِفَاء / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "じせい": "فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / مِغْنَاطِيسِيَّة, مَغْنَاطِيسِيَّة / استبطان, تأمل ذاتي (تأمل أفكارك ورغباتك وسلوكك) / إنكار الذات, ضبط النفس (فعل إنكار الذات؛ السيطرة على الدوافع)\nمثال: 君は自制しなければならない。 — عليك أن تتحكم بنزواتك. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون. / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / مَنْزِلِيّ / صِيغَة, صِيغَةُ الْفِعْل / خَزَف (خَزَفَ في مَشْيه يَخْزِفُ خَزْفًا: رفع يدَه ووَضعها؛ خَزَفَ الثوبَ: خَرَقه…)",
 "じせいしん": "إنكار الذات, ضبط النفس (فعل إنكار الذات؛ السيطرة على الدوافع)",
 "じせき": "إِنْجَاز / دبلوم متوسط, درجة مشارك (درجة تمنحها كلية لمدة عامين عند إتمام الطالب بنجاح للدراسات الجامعية الأولية)\nمثال: أولاً كان البرق ثم قرينه الراعد / مَغْنَاطِيس / بُوصُّلَة (البُوصَلَة أو البَوصَلَة : أَدَاة تسمَح بتحديد الاتجاهات) / إدانة النفس, اتهام الذات (اعتراف بأنك فشلت في فعل أو أن تكون شيئاً تعلم أنه يجب عليك فعله أو كونه) / دَلِيل, بُرْهَان",
 "じせきてん": "ركضة مكتسبة (ركضة لم تُسجل نتيجة لخطأ من الفريق الآخر)",
 "じせきのねん": "شعور بالذنب (ندم ناتج عن الشعور بالمسؤولية عن جريمة أو خطأ ما)",
 "じせつ": "مَوْسِم\nمثال: 物には時節、番茶も出花。 — هناك وقت لكل شيء. / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / فُرْصَة / بتر ذاتي (إزالة تلقائية أو طرح لجزء من الجسم (مثل ذيل السحلية أو مخلب سرطان البحر) خاصة…)",
 "じせん": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / سدادة أذن (سدادة من القطن أو الشمع أو المطاط يتم تركيبها في قناة الأذن للحماية من دخول…)",
 "じぜん": "رئيس الدير (رئيس رهبنة دينية؛ في الدير يكون أقل رتبة من الأباتي) / مُنَظَّمَة خَيْرِيَّة / صاحب المركز الثاني, وصيف (المنافس الذي ينهي السباق في المركز الثاني)",
 "じぜんか": "سَخِيّ ((سَخِيَ) سَخاً: كَانَ جوادًا كَرِيمًا؛ (سَخِيَت) نَفسه عَن الشَّيْء: تركته)\nمثال: هو سخي بأمواله.",
 "じぜんご": "بعد ذلك, فيما بعد (يحدث في وقت لاحق لوقت مرجعي)\nمثال: اعتذر لاحقاً",
 "じぜんさく": "تَحَاشٍ\nمثال: تجنب الازدحام المروري",
 "じぜんしはらい": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن.",
 "じぜんしん": "النزعَة إلى الخير",
 "じぜんじゅうはん": "شريك قبل الواقعة (شخص يدبر أو ينصح أو يأمر بارتكاب جناية ولكنه لا يكون حاضراً عند ارتكابها)",
 "じぜんじゅうはんにん": "شريك قبل الواقعة (شخص يدبر أو ينصح أو يأمر بارتكاب جناية ولكنه لا يكون حاضراً عند ارتكابها)",
 "じぜんじょうけん": "شرط مسبق (شرط يعتبر متطلباً أساسياً)",
 "じぜんだんたい": "جَمْعِيَّة خَيْرِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح…)\nمثال: أنشؤوا جمعية سينمائية.",
 "じぜんばらい": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن.",
 "じぜんぶんぷ": "رئيس الدير (رئيس رهبنة دينية؛ في الدير يكون أقل رتبة من الأباتي)",
 "じそう": "تعبير, ملامح (المشاعر الظاهرة على وجه الشخص)\nمثال: تعبير حزين / شماس مساعد, مساعد الكاهن (شخص يساعد الكاهن أو القس في الخدمة الليتورجية؛ رجل دين مرسوم في أعلى الرتب…) / صِيغَة, صِيغَةُ الْفِعْل / بِاحْتِرَام (بطريقة محترمة)\nمثال: هل لي أن أقترح باحترام على مجلس المدينة أن يتبنوا سياسة عدم النشاط المتقن؟",
 "じそうしき": "ذَاتِيُّ الحَرَكَة, ذَاتِيُّ الدَّفْع (يتحرّك بقوّته الذاتية أو زخمه)",
 "じそうほう": "ذَاتِيُّ الحَرَكَة, ذَاتِيُّ الدَّفْع (يتحرّك بقوّته الذاتية أو زخمه)",
 "じそく": "سُرْعَة / استقلالية, اعتماد على النفس (الاستقلال الشخصي) / فيض مغناطيسي, مجال مغناطيسي (خطوط القوة المحيطة بمغناطيس دائم أو جسيم مشحون متحرك)",
 "じそくけい": "مقياس التدفق المغناطيسي (مقياس يقيس التدفق المغناطيسي عن طريق التيار الذي يولده في ملف)",
 "じそくみつど": "شدة المجال المغناطيسي, كثافة التدفق المغناطيسي (كمية التدفق المغناطيسي في وحدة مساحة عمودية على اتجاه التدفق المغناطيسي)",
 "じそん": "أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا / عزة نفس, كرامة (صفة الجدارة بالتقدير أو الاحترام)\nمثال: كان من دون كرامته أن يغش",
 "じそんかんじょう": "تَقْدِير ذَات",
 "じそんしん": "تَقْدِير ذَات",
 "じぞく": "استمرار, مواصلة (فعل الاستمرار في نشاط ما دون انقطاع)",
 "じぞくいんせいかりつ": "جهاز الاستخبارات الخارجية (جهاز الاستخبارات الروسي المسؤول عن العمليات الخارجية وجمع المعلومات الاستخبارية…)",
 "じぞくかのう": "مستدام (قابل للاستدامة)",
 "じぞくかのうせい": "استدامة (خاصية كون الشيء مستداماً)",
 "じぞくかのうなかいはつ": "تَنْمِيَة مُسْتَدَامَة (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها.",
 "じぞくかのうなかいはつもくひょう": "تَنْمِيَة مُسْتَدَامَة (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها.",
 "じぞくじかん": "مُدَّة",
 "じぞくせい": "مَتَانَة",
 "じぞくてき": "مُتَوَاصِل, مُتَّصِل",
 "じぞくぼっきしょう": "انتصاب دائم, قساح (حالة يكون فيها القضيب منتصباً باستمرار؛ عادة ما تكون مؤلمة ونادراً ما ترتبط…)",
 "じぞくりょく": "مَتَانَة",
 "じた": "تَعَدٍّ (العلاقة النحوية التي ينشئها الفعل المتعدي) / مُتَكَلِّم",
 "じたい": "نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر. / نَفْسُهُ, نَفْسُهَا / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن. / أَصْلًا / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / حَالَة, وَضْع / جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر / أَصْلًا",
 "じたくがくしゅう": "دراسة منزلية (دورة دراسية يتم تنفيذها في المنزل بدلاً من الفصل الدراسي)",
 "じたくけいびいん": "حَبِيسُ المَنْزِلِ, مُلَازِمٌ لِلبَيْتِ (مَحْصُورٌ فِي البَيْتِ عَادَةً بِسَبَبِ المَرَضِ)",
 "じたくしゅっさん": "وضع, ولادة (عملية الولادة)",
 "じたくなんきん": "إِقَامَة جَبْرِيَّة",
 "じたじた": "ارتداد, انعكاس (حركة العودة من الارتطام)",
 "じたつ": "دليل التعليمات, كتيب التعليمات (دليل يرافق عادة جهازاً تقنياً ويشرح كيفية تثبيته أو تشغيله)",
 "じたばた": "مُكَافِح (منخرط في كفاح للتغلب خاصة على الفقر أو الغموض)",
 "じだ": "شحمة الأذن (الجزء اللحمي المتدلي من الأذن الخارجية للإنسان)",
 "じだい": "نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه. / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / شيخوخة, قدم (جودة كون الشيء قديماً؛ عكس الجدة) / عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير.",
 "じだいおくれ": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "じだいこんじょう": "مداهنة, نفاق (تذلل متملق)",
 "じだいさくご": "أداة لا تتناسب مع العصر, شيء في غير زمنه (غرض أو أداة تنتمي إلى زمن آخر غير الذي توجد فيه)",
 "じだいせいしん": "رُوحُ الْعَصْر (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة.",
 "じだいもの": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير. / عمل فني تاريخي (أي عمل فني تكمن قيمته الخاصة في استحضاره لفترة تاريخية)",
 "じだらく": "مُتَسَاهِل مَعَ النَّفْس (يُلبّي شهواته ورغباته الخاصّة)",
 "じち": "تقرير المصير, حكم ذاتي (حكم وحدة سياسية من قبل شعبها) / حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة. / معرفة الذات (فهم لنفسك وأهدافك وقدراتك)",
 "じちきかん": "ذُو سِيَادَة, مُسْتَقِلّ ((عَنِ الكِيَانَات السِّيَاسِيَّة) غَيْر خَاضِع لِسَيْطَرَة قُوًى خَارِجِيَّة)",
 "じちぎょうせい": "تقرير المصير, حكم ذاتي (حكم وحدة سياسية من قبل شعبها)",
 "じちく": "إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو…)",
 "じちけん": "اِسْتِقْلال, تَحَرُّر (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع…)\nمثال: الصحراويون يريدون الاستقلال.",
 "じちせいふ": "تقرير المصير, حكم ذاتي (حكم وحدة سياسية من قبل شعبها)",
 "じちたい": "بَلَدِيَّة",
 "じちたいけいさつ": "إدارة محلية, حكومة محلية (حكومة منطقة محلية)",
 "じちとし": "مَشَاعِيَّة",
 "じちゅうおん": "تِينُور (قريب في المدى من أعلى صوت ذكوريّ طبيعيّ بالغ)\nمثال: على الرغم من أنني اختلفت معه، إلا أنني استطعت متابعة فحوى حجته",
 "じちょう": "عزة نفس, كرامة (صفة الجدارة بالتقدير أو الاحترام)\nمثال: كان من دون كرامته أن يغش / عَقْل, حَنْك (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل. / سُخْرِيَة مِن الذَّات (دعابة لطيفة على حساب النفس)\nمثال: رسالته إلى المنزل تحمل لمسة من السخرية من الذات / غُرَاب, زَاغ\nمثال: سأساعدك يا صاح.",
 "じちょうてき": "مُتَوَاضِع, مُنْتَقِص مِنْ ذَاتِه (واعٍ بعيوبه وقصوره الشخصيّة)",
 "じちらしい": "نَزِيه, صَادِق",
 "じちりょう": "ذُو سِيَادَة, مُسْتَقِلّ ((عَنِ الكِيَانَات السِّيَاسِيَّة) غَيْر خَاضِع لِسَيْطَرَة قُوًى خَارِجِيَّة)",
 "じっか": "وَطَن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "じっかい": "الْوَصَايَا الْعَشْر",
 "じっかくけい": "عشاري الأضلاع, معشر (مضلع له 10 أضلاع و10 زوايا)",
 "じっかっけい": "عشاري الأضلاع, معشر (مضلع له 10 أضلاع و10 زوايا)",
 "じっき": "تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟",
 "じっきょうしゃ": "مُعَلِّق",
 "じっきょうはいしん": "بَثّ مُبَاشِر (نشر أو أذاع خبرًا أو معلومة؛ أرسل إشارات أو موجات عبر وسيط معين)\nمثال: لبث ياني مكانه.",
 "じっきょうほうそう": "مُفَصَّل خُطْوَةً بِخُطْوَة (يُقَدِّم تَفَاصِيل دَقِيقَة ومُتَسَلْسِلَة)",
 "じっきん": "تبسط غير لائق, تطاول (فعل ينطوي على حميمية غير لائقة)\nمثال: خلق غياب الأسوار حميمية غامضة لم يعرف فيها أحد الخصوصية",
 "じっくり": "بِعِنَايَة",
 "じっけん": "تَجْرِبَة, اِخْتِبَار\nمثال: جرب هذا الكسكس. / قدرة حقيقية, قدرة فعالة (جزء القدرة الذي يؤدي، عند حساب متوسطه على دورة كاملة لموجة التيار المتردد، إلى…) / شَهَادَة\nمثال: شاهد هذا الفيلم. / تَفَقُّد",
 "じっけんきかん": "فترة اختبار, فترة تجريبية (فترة زمنية يتم خلالها اختبار شخص أو شيء ما)",
 "じっけんしき": "صيغة أولية, صيغة تجريبية (صيغة كيميائية تظهر نسبة العناصر في مركب بدلاً من العدد الإجمالي للذرات)",
 "じっけんしつ": "مَعْمَل, مُخْتَبَر (موضع العَمَل. المَبْنَى الذي يعمل فيه العُمَّال؛ قد يقصد به الوَرْشَة)",
 "じっけんしゃ": "مُجرِّب (باحث يجري تجارب)\nمثال: كانت مجربة لأشكال جديدة من الشعر",
 "じっけんしゅぎ": "تجريبية (مذهب تجريبي يدعو إلى مبادئ تجريبية)\nمثال: غالباً ما ينشأ أطفال علماء النفس في جو من التجريبية",
 "じっけんしょ": "مَعْمَل, مُخْتَبَر (موضع العَمَل. المَبْنَى الذي يعمل فيه العُمَّال؛ قد يقصد به الوَرْشَة)",
 "じっけんしんりがく": "علم النفس التجريبي (فرع علم النفس الذي يستخدم الأساليب التجريبية لدراسة القضايا النفسية)",
 "じっけんじょう": "حقل تجارب (مكان عمل لاختبار معدات أو أفكار جديدة)",
 "じっけんたい": "عَيِّنَة (جزء من الأنسجة أو الدم أو البول يؤخذ لأغراض التشخيص)\nمثال: جمعوا عينة بول لتحليل البول",
 "じっけんだい": "خِنْزِير غِينِيَّا",
 "じっけんてき": "تَجْرِيبِيّ, رَصْدِيّ (يعتمد على الملاحظة أو التجربة)\nمثال: فيزياء تجريبية",
 "じっけんろん": "إِيجَابِيَّة, يَقِين (صفة أو حالة تتميز باليقين أو القبول أو التأكيد والتوكيد الجازم) / تجريبية (مذهب تجريبي يدعو إلى مبادئ تجريبية)\nمثال: غالباً ما ينشأ أطفال علماء النفس في جو من التجريبية",
 "じっけんシステム": "نموذج",
 "じっこう": "فعالية, نجاعة (القدرة أو القوة لإنتاج تأثير مرغوب)\nمثال: قلق بشأن سلامة وفعالية اللقاح / تَنْفِيذ\nمثال: محكم عليه بالإعدام.",
 "じっこうかのう": "عَمَلِيّ, مُمْكِن التَّنْفِيذ (يمكن تنفيذه بالوسائل المتاحة وفي الظروف القائمة)",
 "じっこうきのう": "وَظِيفَة تَنْفِيذِيَّة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "じっこうしゃ": "عَازِف",
 "じっこうじ": "نَظْمَة",
 "じっこうじかん": "نَظْمَة",
 "じっこうじエラー": "خطأ دلالي, خطأ وقت التشغيل (خطأ في المنطق أو الحساب يجب اكتشافه في وقت التشغيل)",
 "じっこうせい": "فعالية, قوة تأثير (القدرة على إنتاج تأثيرات فسيولوجية أو كيميائية قوية)\nمثال: قوة تأثير التوكسين",
 "じっこうそくど": "سرعة التنفيذ ((علوم الكمبيوتر) السرعة التي يمكن لجهاز حسابي تنفيذ التعليمات بها؛ تقاس بالميبس…)",
 "じっこうはん": "مذنب, مرتكب الجريمة (شخص يرتكب مخالفة)",
 "じっこうふかのう": "غَيْر عَمَلِيّ, غَيْر قَابِل لِلتَّطْبِيق (لا يمكن تنفيذه أو وضعه موضع التطبيق)",
 "じっこうようプログラム": "برنامج الهدف (برنامج تم تجميعه أو تجميعه بالكامل وجاهز للتحميل في الحاسوب)",
 "じっこん": "أُلْفَة",
 "じっさい": "وَاقِع, حَقِيقَة (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة)\nمثال: أنا واقع في حبك / تَدْرِيب (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة…)\nمثال: واصل زيري التدريب. / بصدق, حقاً (وفقاً للحقيقة أو الواقع)\nمثال: أصبحت الآن أمريكية حقاً",
 "じっさいせい": "عَمَلِيَّة, وَاقِعِيَّة (الاهتمام بالاستخدام الفعلي بدلاً من الاحتمالات النظرية)",
 "じっさいてき": "تَطْبِيقِيّ",
 "じっさいに": "فِعْلًا / عَمَلِيًّا",
 "じっさいにあった": "حَقِيقِيّ",
 "じっさいのところ": "فِعْلًا",
 "じっさいは": "فِي الْحَقِيقَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "じっし": "إنفاذ, تطبيق (فعل الإنفاذ؛ ضمان الامتثال أو الطاعة لـ)",
 "じっしいっしょう": "فوز بشق الأنفس, نجاة بأعجوبة (شيء تم تحقيقه (أو الهروب منه) بفارق ضئيل) / جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم)",
 "じっしけいたい": "تَجَسَّد",
 "じっしつ": "مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / جَوْهَرِيّ, مَوْضُوعِيّ (يحدد الحقوق والواجبات بدلاً من إعطاء القواعد التي يتم بموجبها تأسيس الحقوق…)\nمثال: القانون الموضوعي / من حيث المبدأ (فيما يتعلق بالأساسيات وإن لم يكن فيما يتعلق بالتفاصيل)\nمثال: نحن متفقون من حيث المبدأ / متن, نسيج حشوي (نسيج حيواني يشكل الجزء الأساسي والوظيفي للعضو على النقيض من النسيج الضام…)",
 "じっしつこくみんそうせいさん": "ناتج قومي إجمالي حقيقي (نسخة من الناتج القومي الإجمالي تم تعديلها لتأثيرات التضخم)",
 "じっしつじょう": "تَطْبِيقِيّ",
 "じっしつてき": "حَقِيقِيّ",
 "じっしゃ": "صُورَة, صُورَة شَمْسِيَّة / وَصْف, تَوْصِيف / شَامِل, كَامِلُ النِّطَاق (يستخدم جميع الموارد المتاحة)",
 "じっしゃかい": "عَالَم وَاقِعِيّ (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "じっしゅう": "تَدْرِيب (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة…)\nمثال: واصل زيري التدريب. / أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات…)",
