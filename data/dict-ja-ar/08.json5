 "はみだす": "نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول) / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "はみでる": "نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول) / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "はみ出し": "نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول)",
 "はみ出し者": "مَنْبُوذ, مَنْبُوذَة",
 "はみ出す": "نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول) / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "はみ出る": "نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول) / كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "はむ": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "はむかう": "شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه) / اِنْقَلَبَ عَلَى\nمثال: شغل بيل التلفاز.",
 "はむら": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "はめ": "لَجْنَة, لَجْنَة تَحْكِيم / صَلَّحَ / أَصْلَحَ",
 "はめあい": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "はめいた": "خَشَّبَ (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب.",
 "はめこむ": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "はめたおす": "ضَاجَعَ, جَامَعَ",
 "はめつ": "خَرَاب, خَرَابَة / دَمَّرَ",
 "はめはめ": "نَاكَ / نَكَحَ (نَكَحَ الرَّجُلُ زََوْجَتُهُ،اي مَارَسَ مَعَها الجِنْسُ؛ نَكَحَ:تَزَوَّجَ) / نكاح, تَبًّا (الوَطْء أو ممارسة الجِنْس؛ كتابة عقد يحلل الوَطْء؛ كتب الكتاب أو عقد القران)",
 "はめる": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة. / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "はめん": "كَسْر, اِنْكِسَار / كَسْر / يكسر, ينكسر",
 "はめ倒す": "ضَاجَعَ, جَامَعَ",
 "はめ合い": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "はめ込む": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "はもじい": "مُحْرَج, بِٱلْحَرَج",
 "はもと": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "はもの": "سِكِّين, مُدْيَة (أَدَاةٌ حَادَةٌ تُسْتَخْدَمُ فِي تَقْطِيعِ مُخْتَلَفِ أَصْنَافِ الطَّعَامِ كَاللَّحْمِ وَالْخُضَرِ، وَلِذَبْحِ الْحَيَوَانَاتِ؛ أَدَاةٌ حَادَةٌ تُصْنَعُ غَالِباً مِنَ الْمَعْدِنِ، لِلدِّفَاعِ عَنِ النَّفْسِ وَاسْتِخْدَامِهَا أَثْنَاءَ الْقِتَالِ) / خَنْجَر, خنجر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين) / نَصْل, شَفْرَة (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة الحادّة الجارحة)\nمثال: أحتاج الى سكين.",
 "はものし": "سَكَاكِينِيّ",
 "はもん": "أَثَّر, تَدَاعِي (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "はや": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا. / سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي.",
 "はやい": "عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان. / بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر. / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "はやいこと": "بِسُرْعَة, عَاجِلًا",
 "はやいとこ": "بِسُرْعَة, عَاجِلًا",
 "はやいところ": "بِسُرْعَة, عَاجِلًا",
 "はやいはなしが": "بِاخْتِصَار",
 "はやいもので": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "はやおきはさんもんのとく": "مِنْ سَبَق أَكْل النَبْق, مِنْ سَبَقْ شَمْ الحَبْقْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "はやかれおそかれ": "عَاجِلاً أَم آجِلاً, عَاجِلاً أَو آجِلاً",
 "はやかろうわるかろう": "فِي الْعَجَلَة اَلنَّدَامَة, العجلة من الشيطان (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "はやがねをうつ": "مِطْرَقَة, شَاكُوش (أداة رأسها من حَدِيد ولها ذراع غالبا ما تكون من خَشَب تستخدم لضرب المِسْمَار في الخشب أو الحائط أو نحوه؛ أدَاة من حديد يطرق بها الحديد لتطويعه) / مِطْرَقَة (أداة رأسها من حَدِيد ولها ذراع غالبا ما تكون من خَشَب تستخدم لضرب المِسْمَار في الخشب أو الحائط أو نحوه؛ أدَاة من حديد يطرق بها الحديد لتطويعه)\nمثال: سأشتري له مطرقة.",
 "はやがわり": "مَسْخ",
 "はやく": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر. / بِسُرْعَة, عَاجِلًا",
 "はやくも": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "はやさ": "سُرْعَة",
 "はやし": "خَشَب, خشب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب. / حُزْمَة, عُنْقُود / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / حُزْمَة / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: شكرا لإضافتي للمجموعة.",
 "はやしたてる": "صَفَّقَ / سَخِرَ, اِسْتَهْزَأَ (سَخَرَ(سخرت) السفينة سخرا: أطاعت وجرت وطابت لها الريح؛ (سَخَرَ) فلانا سخريا: كلفه ما لا يريده وقهره)\nمثال: سخر المدرس من جسمي.",
 "はやし立てる": "صَفَّقَ / سَخِرَ, اِسْتَهْزَأَ (سَخَرَ(سخرت) السفينة سخرا: أطاعت وجرت وطابت لها الريح؛ (سَخَرَ) فلانا سخريا: كلفه ما لا يريده وقهره)\nمثال: سخر المدرس من جسمي.",
 "はやす": "نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "はやすぎる": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "はやせ": "سَرِيع",
 "はやつけぎ": "مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "はやとうり": "شَايُوت",
 "はやはや": "بِسُرْعَة, عَاجِلًا",
 "はやばや": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "はやぶさ": "صَقْر, شَاهِين",
 "はやま": "سَفْح (لها معانٍ متعددة تتعلق بالانصباب والسكب؛ أراقَ دمًا أو ماءً)\nمثال: كان ذلك الحوض في سفح الجبل.",
 "はやまる": "أَحْيَا / سَرَّعَ (سَرُعَ يَسْرُعُ سَراعَة، وسُراعَة، وَسِرْعًا: سَرِع؛ فهو سَريعٌ. والجمع: سِراعٌ، وسُرْعَانٌ)\nمثال: اركض بأقصى سرعة.",
 "はやみ": "مُخَطَّط بَيَانِيّ / مُخَطَط",
 "はやめ": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "はやめる": "يقرب / أَحْيَا / سَرَّعَ (سَرُعَ يَسْرُعُ سَراعَة، وسُراعَة، وَسِرْعًا: سَرِع؛ فهو سَريعٌ. والجمع: سِراعٌ، وسُرْعَانٌ)\nمثال: اركض بأقصى سرعة.",
 "はやり": "مُودَة, مُوضَة / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: تساهم في انتشار الجهل والتضليل.",
 "はやりかぜ": "إِنْفْلُوَنْزَا",
 "はやりぎ": "نَفَاد صَبْر",
 "はやりっこ": "إِجَّامَة / نَجْمَة",
 "はやりっ子": "إِجَّامَة / نَجْمَة",
 "はやりやまい": "وَبَاء, أَوْبِئَة (المرض العام الذي ينتشر بين الناس)\nمثال: على السلطات أن توقف انتشار الوباء.",
 "はやり病": "وَبَاء, أَوْبِئَة (المرض العام الذي ينتشر بين الناس)\nمثال: على السلطات أن توقف انتشار الوباء.",
 "はやり風邪": "إِنْفْلُوَنْزَا",
 "はやるきもち": "حَمَاس, حَمَاسَة",
 "はやる気持ち": "حَمَاس, حَمَاسَة",
 "はやわかり": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "はやわざ": "مَأْثَرَة",
 "はやーい": "عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان. / بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر. / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "はよ": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "はよう": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا\nمثال: وصل السيد باكر.",
 "はら": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل.",
 "はらあか": "تَرُوتَة, أُطْرُوط",
 "はらあて": "مِرْيَلَة, مِئْزَر / لَبَب",
 "はらい": "تَطْهِير (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير.",
 "はらいおとす": "اِنْتَفَضَ",
 "はらいきよめる": "صَفَّى",
 "はらいこみ": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "はらいこむ": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "はらいさげ": "بَيْع / تخفيض (تَنْقِيص ، حَسْم ،تَقْلِيل؛ تَنْزِيل) / مُزَايَدَة\nمثال: هل يمكن ان تعطيني تخفيض",
 "はらいし": "رَاقٍ, رَاقِية (صَفَا وحَسُنَ؛ الشيُ فلانًا: أعْجَبَه)\nمثال: أخذ زيري ريمة إلى مطعم راق.",
 "はらいせ": "اِنْتِقَام",
 "はらいだし": "تَوْصِيل, تَسْلِيم / مَخَاض, وَضْع / إِلْقَاء (إِلْقَاءُ الشَّبَكَةِ فِي البَحْرِ : رَمْيُها؛ إِلْقاءُ مُحَاضَرَةٍ : إعْطَاؤُهُا، أَي الحَدِيثُ فِي مَوْضُوعٍ أَمَامَ جَمْهُورٍ)\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "はらいだす": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "はらいのける": "يَدْرَأ",
 "はらいもどし": "إِعَادَة مَال",
 "はらいもどしきん": "إِعَادَة مَال",
 "はらいもどす": "جَازَى",
 "はらいわたす": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "はらう": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن. / طَرَدَ / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / أخْلَا / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / أبْطَلَ, نَحّى\nمثال: لقد ترك لك هذا.",
 "はらえ": "تَطْهِير (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير.",
 "はらおち": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "はらか": "تَرُوتَة, أُطْرُوط",
 "はらがいる": "أَهْدَأَ, هَدَّأَ",
 "はらがきまる": "وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "はらがくろい": "مَكِيدَة",
 "はらがけ": "مِرْيَلَة",
 "はらがふとい": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "はらきり": "هَارَا كِيرِي, سِيبُّوكُو",
 "はらくだし": "مُلَيّن / إِسْهَال",
 "はらくだり": "إِسْهَال",
 "はらぐろ": "مَكِيدَة / قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "はらぐろい": "عَنَى, قَصَدَ / لَئِيم, خَسِيس / مُتَوَسِّط",
 "はらじゅく": "هَارَاجُوكُو",
 "はらす": "بَدَّدَ, أَزَالَ ((بَدَّدَ) الشَّيْءَ: فرّقه)\nمثال: 彼は父の死の恨みを晴らした。 — انتقم لموت أبيه.",
 "はらだち": "غَضَب / أَغْضَبَ / غَضِبَ",
 "はらちがい": "أَبَوِيّ",
 "はらっぱ": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "はらづもり": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "はらにいちもつ": "حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ",
 "はらにおさめる": "احتفظ بكل شيء لنسفه",
 "はらにおちる": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "はらにたまる": "مَلَأَ",
 "はらのすわった": "جريء, جريئة",
 "はらへった": "أَنَا جَائِع, أَنَا جَائِعَة",
 "はらぺこ": "جَائِع, جَوْعَان",
 "はらぼて": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه.",
 "はらませ": "تَلْقِيح",
 "はらみ": "حَبَل, حَمْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "はらみた": "كَمَال, إتقان",
 "はらみった": "كَمَال, إتقان",
 "はらみつ": "كَمَال, إتقان / جاكية",
 "はらむ": "حَبِلَ ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته) / خَرَجَ بِ (اِنْتَقَلَ إلى خارج المكان)\nمثال: حبل الكذب قصير. / اِحْتَوَى, تَضَمَّنَ / اِحْتَوَى",
 "はらわた": "مِعًى / مَعْي / مِعَاء / أَمْصِرَة / مَصِير / مُصْرَان / فَرَث / مَشِيمَة, خَلَاص (محلُّ الولد تخرج معهُ عند الولادة. ومنهُ قولهم ليس بمفطومٍ عن شيمة مفطورٌ عليها في المشيمة أي أن من كان مخلوقًا على طبيعةٍ وهو في بطن أمهِ لا ينقطع…) / قَلْب, فُؤَاد / قَلْب / كُبَّا",
 "はらわたのくさった": "مُرْتَشٍ, فَاسِد / أَفْسَدَ",
 "はらをきめる": "حَلَّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "はらをすえる": "وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن. / تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ",
 "はらん": "مُشْكِلَة, مَتاعِب / تبدل (صَارَ غير ما كان؛ اتخذ شيئا بدلا من شيء) / تقلب الأحوال\nمثال: لم لا تبدل ملابسك؟",
 "はらペコ": "جَائِع, جَوْعَان",
 "はらボテ": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه.",
 "はり": "إِبْرَة, مِخْيَط / خَطَّاف / لَكْمَة خُطَّافِيَّة / أَسَلَة / شَوْكَة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم)\nمثال: هناك شوكة ناقصة. / يَد, إيد (عُضْو من أعضاء الجَسَد، من المَنْكِب إلى أطراف الأصابع؛ مَقْبَض) / عَقْرَب / عَامِل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: ليس باليد حيلة.",
 "はりあい": "مُنَافَسَة, مُبَارَاة / مُنَافَسَة, مُسَابَقَة / دَافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو وجدانيّ، ولا شعوريّ في حين أنّ الباعث عقليّ وشعوريّ) / دافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو وجدانيّ، ولا شعوريّ في حين أنّ الباعث عقليّ وشعوريّ)\nمثال: دافع عن الضعفاء.",
