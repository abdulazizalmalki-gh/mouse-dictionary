 "じゅにく": "الحُلُول / التَّجَسُّد, التَّأَنُّس",
 "じゅにゅう": "رَضَاعَة طَبِيعِيَّة",
 "じゅにん": "صَبُور, طَوِيلُ البَال (يَتَحَمَّلُ بِصَبْرٍ الظُّلْمَ أَوِ المَتَاعِبَ المُسْتَمِرَّة) / خَالِد, رَاسِخ (يبقى مدّة طويلة؛ لا يزول بسهولة)",
 "じゅのう": "قَبُول, قُبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض.",
 "じゅはい": "تحمير, تحميص (الطهي حتى يصبح لونه بنياً ومقرمشاً فوق نار أو شواية)\nمثال: التحميص الجيد يجب أن يحمر جانبي قطعة الخبز",
 "じゅばく": "تَعْوِيذَة / هَجَّى, تَهَجَّى",
 "じゅばん": "فانيلا, قميص داخلي رجالي (رداء داخلي رجالي بلا ياقة للجزء العلوي من الجسم)",
 "じゅひ": "نَبَحَ, يَنْبَح / نُبَاح / لِحَاء",
 "じゅひょう": "صقيع (بلورات جليدية تشكل طبقة بيضاء (خاصة على الأشياء في الخارج))",
 "じゅひん": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تَوْرِيد, تَزْوِيد / ذَخِيرَة / ضابط التموين, مسؤول الإمداد والتموين (ضابط جيش يوفر الملابس والإعاشة للقوات)",
 "じゅふ": "تَمِيمَة, أُخْذَة",
 "じゅふん": "تأبير, تلقيح (نقل حبوب اللقاح من المئبر إلى الميسم في النبات)",
 "じゅぶつ": "هَوَس, وَلَع مَرَضِيّ (تفاني مفرط أو غير عقلاني لنشاط ما) / تميمة سحرية, سحر (تميمة يُعتقد بخرافة أنها تجسد قوى سحرية) / صنمية جنسية, فتيشية (شكل من أشكال الرغبة الجنسية يعتمد فيه الإشباع بدرجة غير طبيعية على كائن أو قطعة ملابس أو جزء من الجسم)\nمثال: جعل من النظافة هوساً",
 "じゅぶつすうはい": "صنمية جنسية, فيتيشية (الإثارة الجنسية أو الإشباع الناتج عن التعامل مع صنم (أو جزء معين من الجسم غير الأعضاء التناسلية)) / تقديس الأشياء, فيتيشية (الاعتقاد بالقوة السحرية للأشياء المادية (أو عبادة التمائم))",
 "じゅへんでんせつび": "مُحَوِّل",
 "じゅほう": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر.",
 "じゅみょう": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني)\nمثال: جون في عمر أخي. / حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "じゅめい": "عُمُولَة",
 "じゅもく": "شَجَر, شَجَرَة (الأمر المختلف بين الناس؛ مخرج الفَم أو مُؤَخَّره. ومنه الحروف الشَجْرِيَّة) / شَجَرَة (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: توم يتسلق شجرة.",
 "じゅもくい": "أخصائي أشجار, جراح أشجار (متخصص في علاج الأشجار المتضررة)",
 "じゅもくえん": "حديقة نباتية, مشتل (منشأة تُزرع فيها الأشجار والشجيرات للعرض)",
 "じゅもくがく": "علم الأشجار (دراسة النباتات الخشبية)",
 "じゅもん": "تَعْوِيذَة / هَجَّى, تَهَجَّى",
 "じゅよ": "حكم بالتعويض, منح (منحة تقدمها محكمة قانونية)\nمثال: انتقد منح المحكمة للتعويض",
 "じゅよう": "قَبُول, قُبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض. / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / مُطَّلِب / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / اِسْتِهْلَاك",
 "じゅようか": "مُسْتَهْلِك / مُسْتَنْفِد",
 "じゅようき": "مُسْتَقْبِل",
 "じゅようきょうきゅう": "الْعَرْض وَالْطَلَب",
 "じゅようきょくせん": "منحنى الطلب (في الاقتصاد، الرسم البياني الذي يصور العلاقة بين سعر سلعة معينة والكمية التي يرغب المستهلكون ويقدرون على شرائها بذلك السعر)",
 "じゅようしゃ": "مُسْتَلِم, مُسْتَلِمَة / مُسْتَهْلِك / مُسْتَنْفِد",
 "じゅようせい": "حورية الغابة, درياد (إلهة أو حورية الغابات) / انفتاح, تقبل (الاستعداد أو الجاهزية للتلقي (خاصة الانطباعات أو الأفكار))\nمثال: كان يختبر تقبل الحكومة للإصلاح",
 "じゅようたい": "مُسْتَقْبِل / قَابِل (واجه، وقف مُقبلا نحو شخص والآخر مقبل نحوه؛ فلانٌ فلانًا: التقى به)\nمثال: قابل زيري ريمة.",
 "じゅようときょうきゅう": "الْعَرْض وَالْطَلَب",
 "じゅようどくせん": "احتكار الشراء ((اقتصاد) سوق يتم فيه عرض السلع أو الخدمات من قبل عدة بائعين ولكن يوجد مشترٍ واحد فقط)",
 "じゅようひ": "اسْتِهْلَاكِيّ, قَابِل لِلاسْتِهْلَاك (يمكن أن يُسْتَهْلَك أو يُسْتَنْفَد)",
 "じゅようりょく": "انفتاح, تقبل (الاستعداد أو الجاهزية للتلقي (خاصة الانطباعات أو الأفكار))\nمثال: كان يختبر تقبل الحكومة للإصلاح",
 "じゅらく": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "じゅり": "قَبُول, قُبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض.",
 "じゅりつ": "تَأْسِيس / مُؤَسَّسَة",
 "じゅりょう": "إِيصَال",
 "じゅりょうしゃ": "مُسْتَلِم, مُسْتَلِمَة",
 "じゅりょうしょ": "إِيصَال",
 "じゅりょうしょう": "إِيصَال",
 "じゅりょうシステム": "مستقبل, نظام استقبال (جهاز يستقبل إشارات الراديو أو التلفزيون)",
 "じゅりょく": "قدرة سحرية (القدرة على أداء السحر)",
 "じゅりん": "غَابَة, غابة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "じゅるり": "مُؤَثِّر صَوْتِيّ",
 "じゅれい": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "じゅわ": "اِسْتِقْبَال / اِسْتِقْبَال, حَفْلَة اِسْتِقْبَال",
 "じゅわき": "مِذْيَاع, رَادِيُو / سَمَّاعَة",
 "じゅん": "عَقْد (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد. / دبلوم متوسط, درجة مشارك (درجة تمنحها كلية لمدة عامين عند إتمام الطالب بنجاح للدراسات الجامعية الأولية) / قرين, مرافق (أي حدث يصاحب عادة أو يرتبط ارتباطاً وثيقاً بآخر) / رَفِيق, زَمِيل (شخص ينضم للآخرين في نشاط أو مسعى) / زميل مشارك, شريك (شخص ذو عضوية تابعة في جمعية أو مؤسسة أو مؤسسة تجارية)\nمثال: أولاً كان البرق ثم قرينه الراعد / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / مُطِيع, مُذْعِن / بَرِيء, بَرِيئَة / بَرِيء / صَافٍ, اَلصَّافِي / غَنِيّ, مُكْتَنِزُ النَّكْهَة (يَتَّسِمُ بِالثَّرَاءِ وَالامْتِلَاءِ فِي النَّكْهَة) / صَافٍ, اَلصَّافِي",
 "じゅんあんてい": "شِبْه اسْتِقْرَار (صفة النظام الفيزيائي الذي يستمر في توازنه الحالي عند عدم تعرضه للاضطراب (أو تعرضه لاضطراب طفيف فقط) ولكنه قادر على الانتقال إلى توازن أكثر استقراراً…)",
 "じゅんい": "مساعد (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري. / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "じゅんいつ": "شرف, عفة (فضيلة المرأة أو عفتها) / براءة, طهارة (حالة الخلو من الخطيئة أو الخطأ الأخلاقي؛ الافتقار إلى معرفة الشر) / صفاء, نقاء (كون الشيء غير مخفف أو غير مخلوط بمواد غريبة)",
 "じゅんいづけ": "ترتيب, تصنيف (الموقع على مقياس بالنسبة للآخرين في المكانة أو الرتبة أو الإنجاز)",
 "じゅんいりょうかつどうじゅうじしゃ": "مُسْعِف, مُسْعِفة",
 "じゅんえき": "أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات غير النقدية الأخرى))",
 "じゅんえん": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق) / انتظار, تأجيل (الوقت الذي يتم فيه انتظار إجراء ما)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً",
 "じゅんおう": "تأقلم, تكيف ((فسيولوجيا) التعديل المستجيب لعضو حسي (كالعين) لظروف متغيرة (كالضوء)) / اقتباس, نسخة معدلة (عمل مكتوب (كرواية) تمت إعادة صياغته في شكل جديد) / تأقلم, تعديل (عملية التكيف مع شيء ما (مثل الظروف البيئية))\nمثال: المسرحية هي اقتباس لرواية قصيرة / أقلمة, تأقلم (التكيف مع مناخ جديد (درجة حرارة أو ارتفاع أو بيئة جديدة))",
 "じゅんおうせい": "تكيف, قابلية للتكيف (القدرة على التغيير (أو التغيّر) لتناسب الظروف المتغيرة)",
 "じゅんおん": "نغمة, نغمة نقية (صوت ثابت بدون نغمات توافقية)\nمثال: فحصوا سمعه بنغمات نقية ذات ترددات مختلفة",
 "じゅんか": "تَطْهِير (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير. / تبسيط, تقليل (عملية تقليل التعقيد) / تبسيط (إزالة التفاصيل الزائدة) / تبسيط (شرح يحذف التفاصيل الزائدة ويقلل من التعقيد) / أقلمة, تأقلم (التكيف مع مناخ جديد (درجة حرارة أو ارتفاع أو بيئة جديدة)) / تَكْرِير / نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "じゅんかい": "دَوْرِيَّة, خَفْر / دَوْرِيَّة",
 "じゅんかいじょうちょうけんさ": "فحص التكرار الدوري (رمز لتصحيح الخطأ يُسجل في كل قطاع من القرص المغناطيسي ويُستخدم لاكتشاف الأخطاء في البيانات)",
 "じゅんかいとしょかん": "مكتبة متنقلة (شاحنة مغلقة بها أرفف كتب؛ تعمل كمكتبة متنقلة أو مكتبة لبيع الكتب)",
 "じゅんかいれんらく": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت) / مِنْ بَابٍ لِبَاب ((عَنِ الرِّحْلَات أَوِ التَّوْصِيلَات) مُبَاشَرَة مِنْ نُقْطَة الأَصْل إِلَى الوِجْهَة)",
 "じゅんかいセールスマンのもんだい": "مندوب مبيعات متجول (بائع يسافر لزيارة العملاء)",
 "じゅんかつ": "تَشْحِيم, تَزْيِيت",
 "じゅんかつざい": "مِزْلَق",
 "じゅんかつゆ": "زيت التشحيم, شحم (زيت دهني سميك (خاصة ذلك المستخدم لتزييت الآلات)) / ميسّر (شخص يجعل التقدم أسهل)",
 "じゅんかん": "انتشار, تداول (انتشار أو نقل شيء ما (كالأخبار أو المال) إلى مجموعة أو منطقة أوسع) / توزيع, نشر (توزيع نسخ من الدوريات (مثل الصحف أو المجلات)) / دوران, سريان (حركة حرة أو مرور (كما في السيتوبلازم داخل الخلية أو النسغ عبر النبات)) / دوران, دورة دموية (الحركة عبر دائرة؛ وخاصة حركة الدم عبر القلب والأوعية الدموية)\nمثال: دوران المحيط جزء مهم من المناخ العالمي / ممرضة عملية مرخصة (ممرضة لديها تدريب كافٍ لترخيصها من قبل الدولة لتقديم الرعاية الروتينية للمرضى)",
 "じゅんかんがた": "دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل. / إِعَادَةْ تَدْوِير",
 "じゅんかんき": "دَوْر, دَوْرَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: في أي دور تسكن؟",
 "じゅんかんきけい": "جِهَاز اَلدَّوَرَان",
 "じゅんかんきびょう": "مرض القلب والأوعية الدموية, مرض قلبي وعائي (مرض يصيب القلب أو الأوعية الدموية)",
 "じゅんかんけい": "جِهَاز اَلدَّوَرَان",
 "じゅんかんけいとう": "جِهَاز اَلدَّوَرَان",
 "じゅんかんこう": "رسالة جماعية, عريضة دائرية (رسالة موقعة من قبل عدد من الأشخاص) / دورة روبن, دوري الكل ضد الكل (بطولة يلعب فيها كل متسابق ضد كل متسابق آخر)",
 "じゅんかんごし": "ممرضة عملية مرخصة (ممرضة لديها تدريب كافٍ لترخيصها من قبل الدولة لتقديم الرعاية الروتينية للمرضى)",
 "じゅんかんごふ": "ممرضة عملية مرخصة (ممرضة لديها تدريب كافٍ لترخيصها من قبل الدولة لتقديم الرعاية الروتينية للمرضى)",
 "じゅんかんしょうすう": "عَدَد عَشْرِيّ دَوْرِيّ, كَسْر دَوْرِيّ (عدد عشري يتكرر فيه تسلسل الأرقام إلى ما لا نهاية)",
 "じゅんかんせい": "دَوْرِيَّة (صفة التكرار على فترات منتظمة)",
 "じゅんかんてき": "حلقي, دوري (يتكرر في دورات)",
 "じゅんかんバス": "خط حلقي (خط فرعي للسكة الحديدية يتفرع من الخط الرئيسي ثم ينضم إليه لاحقاً)",
 "じゅんがくし": "دبلوم متوسط, درجة مشارك (درجة تمنحها كلية لمدة عامين عند إتمام الطالب بنجاح للدراسات الجامعية الأولية) / قرين, مرافق (أي حدث يصاحب عادة أو يرتبط ارتباطاً وثيقاً بآخر) / رَفِيق, زَمِيل (شخص ينضم للآخرين في نشاط أو مسعى) / زميل مشارك, شريك (شخص ذو عضوية تابعة في جمعية أو مؤسسة أو مؤسسة تجارية)\nمثال: أولاً كان البرق ثم قرينه الراعد",
 "じゅんきっさ": "مقهى (مطعم صغير تباع فيه المشروبات والوجبات الخفيفة)",
 "じゅんきょ": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض. / تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "じゅんきょう": "اِزْدِهَار, رَخَاء / شَهَادَة",
 "じゅんきょうしゃ": "شُهَدَاء, شَهِيد",
 "じゅんきょうじゅ": "أستاذ مشارك (معلم برتبة أقل من أستاذ كامل ولكن أعلى من أستاذ مساعد)",
 "じゅんきん": "ذهب خالص, ذهب عيار 24 (ذهب بنسبة 100 في المائة)",
 "じゅんくうい": "مساعد (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "じゅんぐり": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار.",
 "じゅんけっしょう": "الدور قبل النهائي",
 "じゅんけつ": "شرف, عفة (فضيلة المرأة أو عفتها) / براءة, طهارة (حالة الخلو من الخطيئة أو الخطأ الأخلاقي؛ الافتقار إلى معرفة الشر) / صفاء, نقاء (كون الشيء غير مخفف أو غير مخلوط بمواد غريبة) / أَصِيل / الدور قبل النهائي",
 "じゅんけつしゅ": "أصيل, حيوان أصيل (حيوان ذو نسب من سلالة غير مختلطة؛ يستخدم خاصة للخيول) / أصيل, صافي السلالة (تمت تربيته لعدة أجيال من أفراد سلالة أو عرق معترف به)",
 "じゅんこ": "صَافٍ, اَلصَّافِي",
 "じゅんこう": "رِحْلَة بَحْرِيَّة / دَوْرِيَّة, خَفْر / دَوْرِيَّة / طَاعَة, إِطَاعَة / وِقَائِيّ, استباق الْأَحْدَاث / تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "じゅんこうきゃくせん": "سَفِينَةٌ سِيَاحِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "じゅんこうせい": "وِقَائِيّ, استباق الْأَحْدَاث",
 "じゅんこうせいじょうてんたい": "نَجْم زَائِف, شَبِيه اَلنَّجْم (طَلَعَ وظَهَرَ؛ نَجَمَ عن الأمر: أي ظهر نَتِيجَة عنه أو نَتَجَ عنه)\nمثال: سميت السفينة \"النجم الفضي\".",
 "じゅんこうせん": "طَرَّاد",
 "じゅんこうミサイル": "صَارُوخ جَوَّال (سهم له ساق من قصب و في أحد طرفيه أنبوبة صغيرة من المقوى تحشى بارودا و لها فتيل من فتحتها السفلى فإذا أُشعل الفتيل و احتُرق ما في مُؤخرتها من بارود…؛ سلاح حربي، و رُبما استُخدم في أمور غير حربية، وهو كناية على اسطوانة ضخمة مخروطية الشكل، ذات جناحين صغيرين يثبتانها في خط مجراها…)\nمثال: هبط الصاروخ بدون مشاكل.",
 "じゅんこく": "حَالِك, دَامِس (شَدِيد الظُّلْمَة لِأَقْصَى دَرَجَة)",
 "じゅんごうかん": "اِعْتِدَاء جِنْسِيّ",
 "じゅんさ": "شُرْطِيّ, شُرَطِيّ (أحد المنتسبين إلى الشُرْطَة)\nمثال: تبدو وكأنك شرطي.",
 "じゅんさいしょくしゅぎ": "خُضْرِيَّة, نَبَاتِيَّة صِرْفَة",
 "じゅんさいしょくしゅぎしゃ": "خُضْرِيّ",
 "じゅんさぶちょう": "رَقِيب شُرْطَة (رجل قانون برتبة رقيب)",
 "じゅんしかん": "مساعد (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "じゅんしせん": "سفينة دورية, قارب دورية (سفينة مخصصة للقيام بدوريات في منطقة ما)",
 "じゅんしてい": "سفينة دورية, قارب دورية (سفينة مخصصة للقيام بدوريات في منطقة ما)",
 "じゅんしゅ": "رصد, مراقبة (فعل المراقبة؛ أخذ نظرة متأنية) / اِحْتِرَام, اِلْتِزَام (الامتثال للقانون أو العرف أو الممارسة وما إلى ذلك) / انتباه, ملاحظة (فعل الملاحظة أو الانتباه) / احتفال رسمي, طقس (حدث رسمي يتم إجراؤه في مناسبة خاصة)\nمثال: نجا من ملاحظة الشرطة / أصيل, حيوان أصيل (حيوان ذو نسب من سلالة غير مختلطة؛ يستخدم خاصة للخيول) / أصيل, صافي السلالة (تمت تربيته لعدة أجيال من أفراد سلالة أو عرق معترف به)",
 "じゅんしゅう": "إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما)",
 "じゅんしゅうえき": "أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات غير النقدية الأخرى))",
 "じゅんしょう": "عميد بحري, كومودور (ضابط بحري مفوض رتبته أعلى من قبطان وأقل من لواء بحري؛ أدنى درجة من درجات الأدميرال)",
 "じゅんしん": "صَافٍ, اَلصَّافِي",
 "じゅんしんむく": "صَافٍ, اَلصَّافِي",
 "じゅんじ": "فِي حَالَةِ اسْتِعْدَاد (في وضع سليم من الجاهزية والترتيب)",
 "じゅんじつ": "29 فبراير, يوم كبيس (اسم اليوم الذي يُضاف خلال السنة الكبيسة)",
 "じゅんじゅん": "فِي حَالَةِ اسْتِعْدَاد (في وضع سليم من الجاهزية والترتيب) / بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "じゅんじゅんけっしょう": "ربع النهائي (واحدة من أربع مسابقات في بطولة خروج المغلوب ينتقل الفائزون فيها للعب في نصف النهائي)",
 "じゅんじゅんに": "فِي حَالَةِ اسْتِعْدَاد (في وضع سليم من الجاهزية والترتيب)",
 "じゅんじょ": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / اِجْرَاء",
 "じゅんじょう": "المستوى المتقدم (المستوى المتقدم لمادة دراسية تؤخذ في المدرسة (عادة بعد عامين من المستوى العادي)) / بَسَاطَة, سَذَاجَة (نقص في التطور أو الخبرة الدنيوية)",
 "じゅんじょすう": "عدد ترتيبي (الرقم الذي يعين المكان في تسلسل مرتب)",
 "じゅんじょせい": "ترتيب, نظم (فعل وضع الأشياء في ترتيب تسلسلي) / ترتيب, نظام (ترتيب منطقي أو مفهوم لعناصر منفصلة)\nمثال: كانت هناك أخطاء في ترتيب العناصر في القائمة",
 "じゅんじょせいぎょ": "مُتَتَالِيَة, مُتَوَالِيَة",
 "じゅんじょだてる": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "じゅんじょづける": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب",
 "じゅんじる": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان. / اِنْتَحَرَ",
 "じゅんすい": "صَافٍ, اَلصَّافِي",
 "じゅんすいさいしょくしゅぎ": "خُضْرِيَّة, نَبَاتِيَّة صِرْفَة",
 "じゅんすいすうがく": "رياضيات بحتة (فروع الرياضيات التي تدرس وتطور مبادئ الرياضيات لذاتها بدلاً من فائدتها المباشرة)",
 "じゅんすいむく": "مُنَزَّه",
 "じゅんずる": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان. / اِنْتَحَرَ",
 "じゅんせい": "صَافٍ, اَلصَّافِي / أَصْلِيّ / نَجْم زَائِف, شَبِيه اَلنَّجْم (طَلَعَ وظَهَرَ؛ نَجَمَ عن الأمر: أي ظهر نَتِيجَة عنه أو نَتَجَ عنه)\nمثال: سميت السفينة \"النجم الفضي\". / إِضْفَاء الشَّرْعِيَّة, تَقْنِين (فعل جعل الشيء قانونياً) / إضفاء الشرعية, تشريع (فعل جعل الشخص شرعياً (قانونياً))\nمثال: لديه حقوق بنوة لأنه حصل على خطابات إضفاء الشرعية من الملك",
 "じゅんせいすうがく": "رياضيات بحتة (فروع الرياضيات التي تدرس وتطور مبادئ الرياضيات لذاتها بدلاً من فائدتها المباشرة)",
 "じゅんぜん": "مُطْلَق (المُطْلَق ؛ ضد المُقَيَّد، من يتحرك بلا قَيْد أو مَانِع؛ صفة: تركت الشرطة البريء مُطْلَق السراح) / مثال: \"متزوج؟\" \"مطلق.\"",
 "じゅんそう": "انطلاق سريع (فعل التحرك بسرعة (كما أمام عاصفة))",
 "じゅんそく": "تَنْظِيم",
 "じゅんそんえき": "أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات غير النقدية الأخرى))",
 "じゅんたく": "وافِر, وَفِير / بَرَّاق, لَمَّاع (يَعْكِس الضَّوْء) / بَهِيّ, نَيِّر (متألق ولامع؛ باهر في تميزه) / بَرَّاق, لَمَّاع (جُعل ناعماً ولامعاً كما لو بالحكّ؛ يعكس بريقاً أو توهجاً)",
 "じゅんだんしゃく": "بارونيت (عضو في رتبة الشرف البريطانية؛ رتبته أقل من بارون ولكن أعلى من فارس)",
 "じゅんち": "أَلِيف / رَوَّضَ, آلَفَ (رَوَّضَ المكانُ: أرَاضَ؛ رَوَّضَ فلانٌ: لَزِمَ الرِّياضَ)\nمثال: إلى أية روضة ذهبت؟",
 "じゅんちょう": "مُفِيد, مُوَاتٍ (يمنح ميزة) / سَعِيد, مُبَارَك (ينبئ أو من المرجح أن يجلب الحظ الجيد أو نتيجة حسنة) / مؤاتٍ, مساعد ((عن الرياح أو الطقس) تميل إلى التعزيز أو التسهيل) / إيجابي, مؤيد (مشجع أو موافق أو مبهج)\nمثال: عقد مفيد لبلدنا",
 "じゅんてき": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "じゅんとう": "سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب",
 "じゅんど": "شرف, عفة (فضيلة المرأة أو عفتها) / براءة, طهارة (حالة الخلو من الخطيئة أو الخطأ الأخلاقي؛ الافتقار إلى معرفة الشر) / صفاء, نقاء (كون الشيء غير مخفف أو غير مخلوط بمواد غريبة)",
 "じゅんどうけい": "تَشَاكُل",
 "じゅんなしょうじょ": "بتول, بِكْر (المنقطعه عن الرجال)",
 "じゅんなん": "شَهَادَة",
 "じゅんなんしゃ": "ضَحِيَّة / أُضْحِيَّة",
 "じゅんに": "فِي حَالَةِ اسْتِعْدَاد (في وضع سليم من الجاهزية والترتيب)",
 "じゅんねん": "سَنَة كَبِيسَة (مقدارُ قطع الشمس البروجَ الاثني عشر ، وهي السنة الشمسيَّة، و السَّنَةُ تمامُ اثنتَيْ عشرةَ دَورةً للقمر ، وهي السنة القمرية…)\nمثال: في عمره 24 سنة.",
 "じゅんのう": "تأقلم, تكيف ((فسيولوجيا) التعديل المستجيب لعضو حسي (كالعين) لظروف متغيرة (كالضوء)) / اقتباس, نسخة معدلة (عمل مكتوب (كرواية) تمت إعادة صياغته في شكل جديد) / تأقلم, تعديل (عملية التكيف مع شيء ما (مثل الظروف البيئية))\nمثال: المسرحية هي اقتباس لرواية قصيرة / أقلمة, تأقلم (التكيف مع مناخ جديد (درجة حرارة أو ارتفاع أو بيئة جديدة))",
 "じゅんのうせい": "تكيف, قابلية للتكيف (القدرة على التغيير (أو التغيّر) لتناسب الظروف المتغيرة)",
 "じゅんのうりょく": "تكيف, قابلية للتكيف (القدرة على التغيير (أو التغيّر) لتناسب الظروف المتغيرة)",
 "じゅんはずれ": "خارج الموسم, موسم الركود (الموسم الذي يكون فيه السفر أقل نشاطًا والأسعار أقل)",
 "じゅんばん": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "じゅんばんこ": "متردد, متناوب ((عن التيار الكهربائي) يعكس اتجاهه)\nمثال: تيار متردد",
 "じゅんばんづける": "مُتَتَالِيَة, مُتَوَالِيَة",
 "じゅんばんに": "بدوره",
 "じゅんばんれつ": "مُتَتَالِيَة, مُتَوَالِيَة",
 "じゅんぱく": "بَيْضَاء الثَّلْج, بَيَاضُ الثَّلْج (مؤنث أَبْيَض، صفة ما كان لونها البياض؛ يد بيضاء: هي اليد التي تعمل الخير وتسبق بالحسنات)\nمثال: هي بيضاء اللون.",
 "じゅんぱくいろ": "بَيْضَاء الثَّلْج, بَيَاضُ الثَّلْج (مؤنث أَبْيَض، صفة ما كان لونها البياض؛ يد بيضاء: هي اليد التي تعمل الخير وتسبق بالحسنات)\nمثال: هي بيضاء اللون.",
 "じゅんぱくしょく": "بَيْضَاء الثَّلْج, بَيَاضُ الثَّلْج (مؤنث أَبْيَض، صفة ما كان لونها البياض؛ يد بيضاء: هي اليد التي تعمل الخير وتسبق بالحسنات)\nمثال: هي بيضاء اللون.",
 "じゅんび": "تَحْضِير, إِعْدَاد / بَدِيع, رَائِع (بالغ الجمال؛ فائق الحُسن) / أَنِيق, بَدِيع (ذُو جَمَالٍ رَقِيقٍ وَدَقِيق) / بَالِغُ الأَنَاقَة, رَائِع (أنيق ومصقول بشكل بالغ) / حَادّ, لَاذِع (شَدِيدُ الحِدَّةِ وَالوَطْأَة)",
 "じゅんびきん": "حساب احتياطي, صندوق احتياطي (أموال مقتطعة من الأرباح لتوفير المدفوعات المستقبلية المتوقعة)",
 "じゅんびぎんこう": "بنك الاحتياطي الفيدرالي (واحد من 12 بنكاً إقليمياً تراقب وتعمل كمستودعات للبنوك في منطقتها)",
 "じゅんびしきん": "حساب احتياطي, صندوق احتياطي (أموال مقتطعة من الأرباح لتوفير المدفوعات المستقبلية المتوقعة)",
 "じゅんびしょめん": "مذكرة قانونية, مرافعة خطية (وثيقة تبين الحقائق والنقاط القانونية لقضية العميل)",
 "じゅんびたいそう": "إحماء, تحضير (ممارسة التمارين استعداداً لنشاط شاق)",
 "じゅんびちゅう": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "じゅんぴょう": "إنتاج مصنع, مصنع (منتج بكميات في مصنع)",
 "じゅんぶんがく": "أَدَب (هو الظُرْف وحسن التَنَاوُل أو التَصَرُّف، أو هو مَلَكَة تعصم من كانت به عما يشينه؛ تطلق على المُسْتَظْرف من المعارف والعلوم)\nمثال: زيري يحب الأدب.",
 "じゅんぼく": "بَسِيطٌ سَاذَج, رِيفِيّ (بَسِيطٌ بِطَرِيقَةٍ فَجَّةٍ وَقَرَوِيّ) / بَسِيط, غَيْر مُعَقَّد (يفتقر إلى التعقيد) / غَيْرُ دُنْيَوِيّ, غَيْرُ مُتَحَضِّر (لا يعرف طرق العالم ولا يملك خبرة فيها)",
 "じゅんぽう": "أَطَاعَ",
 "じゅんぽうしゃ": "اتباعي, مساير (يتميز بالعرف والامتثال للعادات أو القواعد أو الأنماط) / مُلْتَزِم, مُمْتَثِل (يتمسك بالعادات أو المذاهب الراسخة خاصة في الدين) / ملتزم, ممتثل (شخص يمتثل لمعايير السلوك الراسخة (خاصة في الأمور الدينية))\nمثال: تحت المظهر الراديكالي، المراهقون ممتثلون (للأعراف) بشكل مدهش",
 "じゅんぽうせいしん": "مُطِيع, مُلْتَزِم بِالقَانُون ((للأفراد) يلتزم بدقّة بالقوانين والقواعد والأعراف)",
 "じゅんゆう": "رِحْلَة / جَوْلَة",
 "じゅんようかん": "طَرَّاد",
 "じゅんようせんかん": "طراد معركة (طراد بأقصى سرعة وقوة نيران)",
 "じゅんらん": "رِحْلَة / جَوْلَة",
 "じゅんり": "أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات غير النقدية الأخرى))",
 "じゅんりえき": "أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات غير النقدية الأخرى))",
 "じゅんりゅうし": "شبه جسيم (كم من الطاقة (في شبكة بلورية أو نظام آخر) له موضع وزخم ويمكن اعتباره جسيماً من بعض النواحي)",
 "じゅんりょう": "بَرِيء, بَرِيئَة / بَرِيء / حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط / مُؤَدَّب / اَلْوَزْن اَلصَّافِي",
 "じゅんれい": "حَجّ (القَصْد والزِيَارَة على جهة التَعْظِيم؛ زيارة مكان مُقَدَّس بهدف ديني ويوجد عند معظم الديانات منها اليَهُودِيَّة والمَسِيحِيَّة والإسْلام)\nمثال: ذهب رجل للحج وترك خلفه خمس بنات وكلبة.",
 "じゅんれいしゃ": "حَاجّ, حَجِّيّ (افتقر)\nمثال: لا أرى لذلك حاجة.",
 "じゅんれき": "رِحْلَة / جَوْلَة",
 "じゅんれつ": "تَبْدِيل",
 "じゅんろ": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "じゅんろく": "رَنَة",
 "じゅんわくせい": "كَوْكَب قَزَم ((قديمًا) جرم سماوي من البلازما مضيئ بذاته متماسك بفعل الجاذبية؛ جرم سماوي يدور حول الشمس)\nمثال: كوكب الأرض جميل.",
 "じゅんをおって": "فِي حَالَةِ اسْتِعْدَاد (في وضع سليم من الجاهزية والترتيب)",
 "じゅんツ": "تشاو تشاو (سلالة من الكلاب متوسطة الحجم ذات معطف سميك وذيول مجعدة رقيقة وألسنة زرقاء سوداء مميزة؛ يعتقد أنها نشأت في شمال الصين) / أكل, طعام (مصطلحات غير رسمية تعني وجبة أو طعام) / تشو, سلالة تشو (السلالة الإمبراطورية للصين من 1122 إلى 221 قبل الميلاد؛ اشتهرت بظهور الكونفوشيوسية والطاوية)",
 "じゆう": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / حُرِّيَّة, حرية (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…) / حُرِّيَّة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "じゆういし": "حُرِّيَّة الْإِرَادَة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "じゆういしろん": "تحررية مفرطة, ليبرتارية (اعتقاد أيديولوجي بحرية الفكر والكلام والعمل)",
 "じゆうか": "تحرير, تخفيف القيود (عملية جعل الشيء أقل صرامة)",
 "じゆうかしか": "أَعْطِنِي",
 "じゆうかって": "حُرّ (ضد البَرْد) / شَاغِر, فَاضٍ / بِغَيْرِ, بِدُونِ / مَجَّانًا / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: أنا حر كالطائر.",
 "じゆうがきかない": "مُقَيَّد (يخضع لقيود في الاطّلاع والتداول) / مُحَدَّدُ المَعْنَى, مُقَيَّد (مَحْصُورُ المَعْنَى؛ كَمَا فِي 'رَجُل' فِي 'رَجُلٌ طَوِيل') / محدود, محصور (خاضع لقيود أو تم إخضاعه لقيود)\nمثال: ذو أهمية محدودة",
 "じゆうがた": "أسلوب حر, سباحة حرة (سباق (كما في السباحة) يمتلك فيه كل متسابق حرية اختيار الأسلوب الذي سيستخدمه)",
 "じゆうきまま": "حُرّ (ضد البَرْد) / شَاغِر, فَاضٍ / بِغَيْرِ, بِدُونِ / مَجَّانًا / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: أنا حر كالطائر.",
 "じゆうぎょう": "حر, مستقل (يعمل لنفسه (وليس موظفاً دائماً))",
 "じゆうけい": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "じゆうけいやく": "انتقال حر ((رياضة) حالة اللاعب المحترف الحر في التفاوض على عقد للعب لأي فريق) / حر, مستقل (يعمل لنفسه (وليس موظفاً دائماً)) / عامل مستقل, فريلانسر (كاتب أو فنان يبيع خدماته لأصحاب عمل مختلفين دون عقد طويل الأجل مع أي منهم)",
 "じゆうけいやくせんしゅ": "رُوح حُرَّة, شَخْص مُتَحَرِّر (شخص يتصرف بحرية أو حتى بمسؤولية أقل) / لاعب حر ((في الرياضة) رياضي محترف حر في توقيع عقد للعب مع أي فريق)",
 "じゆうけん": "حرية مدنية (حق فردي أساسي يحميه القانون ويُعبر عنه بالحصانة من التدخل الحكومي غير المبرر) / حرية سياسية, حرية مدنية (حرية الفرد في ممارسة حقوقه كما تضمنها قوانين البلاد)",
 "じゆうけんきやくじんけんいいんかい": "الْأُمَم الْمُتَّحِدَة",
 "じゆうけんきゅう": "بحث علمي, مشروع بحثي (البحث في الأسئلة التي تطرحها النظريات والفرضيات العلمية)",
 "じゆうこう": "ميناء حر (ميناء مفتوح بشروط متساوية لجميع السفن التجارية) / منطقة حرة, ميناء حر (منطقة مجاورة للميناء حيث يمكن استلام البضائع المعدة لإعادة الشحن وتخزينها دون دفع رسوم جمركية)",
 "じゆうこく": "ولاية حرة (أي ولاية كانت تحظر العبودية قبل الحرب الأهلية الأمريكية)",
 "じゆうさいりょう": "دَائِرَة عَرْض, خَطّ عَرْض (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "じゆうさんか": "شِجَار صَاخِب (قتال صاخب وسط حشد من الناس) / اِخْتِيَارِيّ",
 "じゆうざんまい": "حُرّ (ضد البَرْد) / شَاغِر, فَاضٍ / بِغَيْرِ, بِدُونِ / مَجَّانًا / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: أنا حر كالطائر.",
 "じゆうし": "شعر حر (شعر غير مقفى وبدون نمط وزني ثابت)",
 "じゆうしじょうしゅぎ": "تحررية مفرطة, ليبرتارية (اعتقاد أيديولوجي بحرية الفكر والكلام والعمل)",
 "じゆうしそう": "ربوبية, فكر حر (شكل من أشكال العقلانية اللاهوتية يؤمن بالله على أساس العقل دون الرجوع إلى الوحي)",
 "じゆうしそうか": "مفكر حر (شخص يرفض الدين)",
 "じゆうしゅぎ": "لِيبْرَالِيَّة",
 "じゆうしゅぎしゃ": "رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح) / تحرري, ليبرالي (متسامح مع التغيير؛ غير مقيد بالسلطوية أو الأرثوذكسية أو التقاليد) / حُرّ, مُتَصَرِّف (غير حرفيّ في الترجمة أو التفسير) / جَوَاد, سَخِيّ اليَد (يُعطي أو يُمنح بسخاء وبلا تردد)",
 "じゆうじかん": "رَاحَة, خُلُو مِنَ الْعَمَل\nمثال: いくらか自由時間があるときは、いつもクラシック音楽を聴くのが楽しみだ。 — أحب دائما أن أستمع للموسيقى الكلاسيكية عندما يكون لدي وقت فارغ.",
 "じゆうじざい": "حُرّ (ضد البَرْد) / شَاغِر, فَاضٍ / بِغَيْرِ, بِدُونِ / مَجَّانًا / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: أنا حر كالطائر.",
 "じゆうじん": "رُوح حُرَّة, شَخْص مُتَحَرِّر (شخص يتصرف بحرية أو حتى بمسؤولية أقل)",
 "じゆうせかい": "الْعَالَم الْحُرّ",
 "じゆうせんし": "محارب للحرية",
 "じゆうちょう": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "じゆうでんし": "إِلِكْتْرُون حُرّ (إلكترون غير مرتبط بذرة أو أيون أو جزيء ولكنه حر الحركة تحت تأثير مجال كهربائي)",
 "じゆうとう": "الحزب الليبرالي (حزب سياسي في أستراليا وكندا ودول أخرى، وسابقاً في بريطانيا العظمى)",
 "じゆうとし": "مَشَاعِيَّة",
 "じゆうど": "درجة الحرية ((إحصاء) متغير غير مقيد في توزيع التردد) / درجة الحرية (واحدة من الحد الأدنى لعدد المعاملات اللازمة لوصف حالة نظام فيزيائي)",
 "じゆうに": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "じゆうのみ": "حُرِّيَّة, حرية (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…) / حُرِّيَّة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "じゆうのめがみ": "تِمْثَال الْحُرِّيَّة\nمثال: 自由の女神はアメリカの象徴である。 — تمثال الحرية رمزٌ لأمريكا.",
 "じゆうのめがみぞう": "تِمْثَال الْحُرِّيَّة",
 "じゆうほんぽう": "طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة) / حُرّ, مُنْطَلِق (خالٍ من القيود أو القواعد)",
 "じゆうぼうえき": "تِجَارَة حُرَّة",
 "じゆうぼうえききょうてい": "تِجَارَة حُرَّة",
 "じゆうぼうえきたいいき": "تِجَارَة حُرَّة",
 "じゆうぼうえきちいき": "تِجَارَة حُرَّة",
 "じゆうぼうえきていこくしゅぎ": "تِجَارَة حُرَّة",
 "じゆうみん": "أحرار (الناس الذين يتمتعون بالحرية)\nمثال: موطن الأحرار والشجعان",
 "じゆうらっか": "انخفاض حاد, سقوط (انخفاض حاد ومفاجئ في كمية ما) / سقوط حر (حركة السقوط المثالية لشيء يخضع فقط لمجال الجاذبية)\nمثال: انخفاض بمقدار 57 نقطة في مؤشر داو جونز",
 "じゆうれんあい": "جنس خارج إطار الزواج, حب حر (الجماع الجنسي بين أفراد غير متزوجين من بعضهم البعض)",
 "じゆうれんそう": "تداعي حر (عملية تفكير تقترح فيها الأفكار (كلمات أو صور) أفكاراً أخرى في تسلسل)",
 "じゆうろうどうしゃ": "مُياوِم",
 "じゆうエネルギー": "طاقة ((في الفيزياء) كمية ديناميكية حرارية تكافئ قدرة نظام فيزيائي على القيام بشغل؛ وحدات الطاقة هي الجول أو الإرج)\nمثال: يمكن للطاقة أن تتخذ أشكالاً متنوعة",
 "じゆうソフトウェア": "بَرْمَجِيَّات حُرَّة",
 "じょ": "مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري. / اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية. / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / توطئة, ديباجة (مقال تمهيدي قصير يسبق نص كتاب) / اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها / تَقْسِيم / قِسْمَة (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / قِسْمَةٌ (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / فِرْقَة / فُرْقَة\nمثال: الزواج قسمة و نصيب.",
 "じょい": "تنصيب, تولية (العمل الرسمي المتمثل في إلباس شخص ما شارة منصب؛ الترقية الرسمية لشخص إلى منصب أو رتبة) / تتويج, تنصيب (مراسم تنصيب ملك جديد)",
 "じょいん": "أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية)",
 "じょう": "مُفَتِّش, مُفَتِّشَة / شَيْخ, عَجُوز / مُرَّان أَمْرِيكِيّ / بِخُصُوص, فِيمَا يَتَعَلَّقُ بِـ / عَلَى (يفيد الاستعلاء؛ يفيد التعليل) / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / عَلَى حِسَابِهِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / أَفْضَل / إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر / امرأة غير متزوجة, عزباء (امرأة ليست متزوجة) / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ. / ـَة / مشاعر (الحساسية العاطفية أو الأخلاقية (خاصة فيما يتعلق بالمبادئ الشخصية أو الكرامة))\nمثال: جرحت الملاحظة مشاعره / رَحْمَة / شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة. / عَاطِفَة, شَغْف / عَزْم / شَغَف (المرضُ فلانًا: وصل المرض شِغاف قلبه فالقلب عليل فيه مرض؛ الحبُّ فلانًا: وصل إلى شِغَاف قلبه. وقيل: دخل الحب تحت الشغاف. وقيل: غشى القلب تماما)\nمثال: قبل توم ماري بشغف. / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء. / قُفْل (أَغْلَقَ أو سَدَّ البابَ أو الشَّيْءَ؛ في بعض السياقات: عادَ أو رجَعَ إلى مكانه أو بدايته) / هَوِّيس / أَقْفَلَ / ذُؤَابَة\nمثال: يحاول توم كسر القفل. / لَوْح / مَقَال, مَقَالَة / أَدَاةُ تَعْرِيف, أَدَاةُ التَّعْرِيف / مادّةٌ, مَوَادُّ (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / رَغْم أَنَّ, مَعَ أَنَّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره. / مُنْذُ / لِأَنَّ / قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة, طَاقَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / طَاقَة كَهْرَبَائِيَّة, طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: توم شعر بالقوة. / ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / قَلْعَة, قِلْعَة (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة. / طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير. / سيد (صيغة خطاب للرجل) / مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس / يَقِين (والقيد الأول جنس يشتمل إلى الظن أيضاً؛ والثاني يخرج الظن)\nمثال: اليقين الإيمان كله. / عَادِيّ / مُنْتَظِمٌ",
 "じょうあい": "عاطفة, محبة (شعور إيجابي بالإعجاب)\nمثال: وجد صعوبة في التعبير عن المودة التي شعر بها",
 "じょうい": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو / إرَادَة / رَغْبَة, إرَادَة / شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس / مِعْطَف / قِمَّة / تنازل عن العرش (فعل التنازل عن العرش) / تنازل عن العرش, تنحي (استقالة رسمية وتنازل عن السلطات) / غُرْفَةْ الاِسْتِقْبَال, غُرْفَةْ جُلُوس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "じょういうち": "تَنْفِيذ / إِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "じょういかたつ": "من أعلى لأسفل (لنهج في حل المشكلات يبدأ من أعلى مستوى مفاهيمي ويعمل نزولاً إلى التفاصيل)\nمثال: تحليل من أعلى لأسفل قد يبدأ بالنظر في اتجاهات الاقتصاد الكلي",
 "じょういげだつ": "من أعلى لأسفل (لنهج في حل المشكلات يبدأ من أعلى مستوى مفاهيمي ويعمل نزولاً إلى التفاصيل)\nمثال: تحليل من أعلى لأسفل قد يبدأ بالنظر في اتجاهات الاقتصاد الكلي",
 "じょういご": "اسم شامل, لفظ أعم (كلمة أكثر شمولاً وعمومية من كلمة أخرى)",
 "じょういごかんせい": "توافقية مستقبلية",
 "じょういじん": "قادة, قيادة (هيئة الأشخاص الذين يقودون مجموعة)\nمثال: تبنت القيادة الوطنية خطته",
 "じょういたいばんそうきはくり": "انفصال المشيمة المبكر (اضطراب في الحمل تنفصل فيه المشيمة قبل الأوان عن جدار الرحم)",
 "じょういん": "عضو طاقم (عضو في طاقم عمل) / عضو طاقم (عضو في طاقم طائرة) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / كومبارس, ممثل إضافي (ممثل ثانوي يظهر في مشاهد الحشود) / زَائِد عَنِ الْحَاجَة, عَمَالَة فَائِضَة (شخص لا يؤدي وظيفة ظاهرة) / مَجْلِس عُلْوِيّ",
 "じょういんぎいん": "سِنَاتُور, سِنَاتُورَة",
 "じょういんぎかい": "مَجْلِس الشُّيُوخ",
 "じょういグループ": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "じょうえい": "فحص تحري, فرز (اختبار الأشياء أو الأشخاص لتحديد أولئك الذين لديهم خصائص معينة) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / شبكة غربلة, قماش شبكي (قماش من شبكة معدنية أو بلاستيكية) / عرض, عرض سينمائي (عرض صورة متحركة (فيلم))\nمثال: أخفى الغطاء بنادقهم عن طائرات العدو",
 "じょうえいかん": "دار عرض سينمائي, سينما (مسرح تُعرض فيه الأفلام)",
 "じょうえいじかん": "مدة العرض, وقت التشغيل (طول الوقت الذي يستمر فيه فيلم أو عرض تلفزيوني)",
 "じょうえん": "أَدَاء / مَسْرَحِيَّة",
 "じょうえんかほうふん": "تل مدفني, رابية الدفن ((في علم الآثار) كومة من التراب توضع فوق مقابر ما قبل التاريخ)",
 "じょうおう": "مَلِكَة, ملكة (مؤنث مَلِك) / وَزِير, فرزان / تفرزن\nمثال: ليحفظ الله الملكة. / ملكة قرينة (زوجة الملك الحاكم) / أَمِيرَة",
 "じょうおうさま": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "じょうおろす": "قُفْل (أَغْلَقَ أو سَدَّ البابَ أو الشَّيْءَ؛ في بعض السياقات: عادَ أو رجَعَ إلى مكانه أو بدايته) / هَوِّيس / أَقْفَلَ / ذُؤَابَة\nمثال: يحاول توم كسر القفل.",
 "じょうおん": "درجة حرارة الغرفة (درجة الحرارة العادية للغرفة التي يعيش فيها الناس) / نغمة تابعة, نغمة فوقية (نغمة توافقية ذات تردد يمثل مضاعفاً للتردد الأساسي) / إِيحَاء, نَبْرَة خَفِيَّة ((عادة الجمع) معنى أو جودة ضمنية خفية)\nمثال: إيحاءات اليأس",
 "じょうおんかくゆうごう": "اِنْدِمَاج بَارِد",
 "じょうか": "تَطْهِير (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير. / تنظيف (فعل جعل الشيء نظيفاً) / الضارب الرابع ((بيسبول) المركز الرابع في ترتيب الضرب (يشغله عادة أفضل ضارب في الفريق)) / ربح طائل (ربح كبير جداً)\nمثال: قام بتنظيف حذائه جيداً / ذهاباً وإياباً, صعوداً وهبوطاً (التحرك للخلف وللأمام على طول مسار معين) / صُعُودًا وَهُبُوطًا, مِنْ أَعْلَى إلى أَسْفَل (بالتبادل بين الاتجاهين العلوي والسفلي)\nمثال: مشى ذهاباً وإياباً في غرفة تبديل الملابس / عَاطِفَة, شَغْف / عَزْم / شَغَف (المرضُ فلانًا: وصل المرض شِغاف قلبه فالقلب عليل فيه مرض؛ الحبُّ فلانًا: وصل إلى شِغَاف قلبه. وقيل: دخل الحب تحت الشغاف. وقيل: غشى القلب تماما)\nمثال: قبل توم ماري بشغف. / أغنية حب, أغنية عاطفية (أغنية عن الحب أو تعبر عن الحب لشخص آخر) / فوق فصيلة ((في الأحياء) مجموعة تصنيفية تقع تحت الرتبة ولكن فوق الفصيلة)",
 "じょうかい": "حد أعلى ((رياضيات) عدد يساوي أو أكبر من أي عدد آخر في مجموعة معطاة) / طَبْخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ.",
 "じょうかく": "ضيف الشرف (الشخص الذي يُعقد التجمع تكريماً له) / قَلْعَة, قِلْعَة (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة. / إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حظيرة, مسيَّج (هيكل يتكون من منطقة تم تطويقها لغرض ما) / طية, مرفق (شيء ما (عادة وثيقة داعمة) يتم إرفاقه في ظرف مع رسالة تغطية) / حيز طبيعي مغلق, مكان مغلق (مساحة مغلقة بشكل طبيعي) / مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "じょうかそう": "خزان تحليل, خزان صرف صحي (خزان كبير يتم فيه تفكيك المواد الصلبة أو مياه الصرف الصحي بواسطة البكتيريا)",
 "じょうかそうち": "جهاز تنقية, منقٍّ (جهاز لإزالة الشوائب)",
 "じょうかのちかい": "اِسْتِسْلَام",
 "じょうかのめい": "اِسْتِسْلَام",
 "じょうかん": "شُعُور, إِحْسَاس / عَاطِفَة, إِحْسَاس / اشتراط, شرط (قيد يتم الإصرار عليه كشرط للاتفاق) / شرط, شرط مسبق (افتراض تعتمد عليه صحة أو تأثير شيء آخر) / إقرار قضائي, اشتراط ((قانون) اتفاق أو تنازل يقدمه الأطراف في دعوى قضائية يتعلق بالعمل المعروض على المحكمة؛ يجب أن يكون مكتوبًا ما لم يكن جزءًا من سجل المحكمة)\nمثال: تم عمل إقرار بالوقائع لتجنب التأخير",
 "じょうかんぱん": "سطح علوي (سطح مرتفع)",
 "じょうが": "قاعدة تثبيت (هيكل يستخدم للدعم أو العرض) / تسلق, تصاعد (حدث ينطوي على الارتفاع إلى نقطة أعلى (كما في الارتفاع أو درجة الحرارة أو الشدة، وما إلى ذلك))",
 "じょうがいかぶ": "سهم خارج المقصورة, سهم غير مدرج (سهم غير مدرج ومتداول في بورصة منظمة)",
 "じょうがいしじょう": "سوق التداول المباشر, سوق خارج البورصة (بورصة أسهم تتم فيها معاملات الأوراق المالية عبر الهاتف والكمبيوتر بدلاً من قاعة البورصة) / سوق التجزئة (السوق لبيع السلع أو الخدمات للمستهلكين بدلاً من المنتجين أو الوسطاء)",
 "じょうがいとりひき": "خَارِج البُورْصَة ((في الأوراق المالية) لا يُتَداوَل في سوق الأَوْراق المالِيَّة الرَّسْمِيّ)",
 "じょうがうすい": "بارد المشاعر, قاسي القلب (يفتقر إلى التعاطف أو الشعور)",
 "じょうがく": "فك علوي (الفك في الفقاريات الذي يندمج مع القحف)",
 "じょうがくこつ": "فك علوي (الفك في الفقاريات الذي يندمج مع القحف)",
 "じょうがこわい": "عَنِيد",
 "じょうき": "شطف (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن أن تعني إزالة ما علق بالشيء من أوساخ أو شوائب) / الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ / نظام المعلومات (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل. / بُخَار (كلُّ رَائِحَةٍ سَطَعَتْ مِنْ نَتْنٍ أَو غَيْرِهِ؛ كل مَا يصعد كالدخان من السوائل الحارة والرائحة)\nمثال: السحابة هي كتلة بخار في السماء. / بَاخِرَة, سَفِينَة بُخَارِيَّة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار)\nمثال: الباخرة الآن في الميناء. / اشتراط, شرط (قيد يتم الإصرار عليه كشرط للاتفاق) / شرط, شرط مسبق (افتراض تعتمد عليه صحة أو تأثير شيء آخر) / إقرار قضائي, اشتراط ((قانون) اتفاق أو تنازل يقدمه الأطراف في دعوى قضائية يتعلق بالعمل المعروض على المحكمة؛ يجب أن يكون مكتوبًا ما لم يكن جزءًا من سجل المحكمة)\nمثال: تم عمل إقرار بالوقائع لتجنب التأخير / مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء) / طَائِرَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر) / طَيَّارَة (هي الطَائِرَة؛ هي الطائرة الورقية)\nمثال: لقد وصلت الطائرة. / ركوب, صعود (فعل صعود الركاب والطاقم على متن سفينة أو طائرة) / ألواح خشبية, كسوة خشبية (هيكل من الألواح)",
 "じょうききかん": "محرك بخاري (محرك احتراق خارجي تستخدم فيه الحرارة لتوليد البخار الذي يدير توربينة أو يجبر مكبساً على التحرك صعوداً وهبوطاً في أسطوانة)",
 "じょうききかんしゃ": "قِطَار بُخَارِيّ",
 "じょうきげん": "انشراح, روقان (مزاج مبتهج ومقبول)",
 "じょうきせん": "بَاخِرَة, سَفِينَة بُخَارِيَّة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار)\nمثال: الباخرة الآن في الميناء.",
 "じょうきだんぼう": "تدفئة بالبخار (نظام تدفئة يتم فيه توليد البخار في غلايات ونقله بالأنابيب إلى مشعات)",
 "じょうきどう": "المسلك التنفسي العلوي (الأنف والحلق والقصبة الهوائية)",
 "じょうきどうえん": "المسلك التنفسي العلوي (الأنف والحلق والقصبة الهوائية)",
 "じょうきゃく": "ضيف الشرف (الشخص الذي يُعقد التجمع تكريماً له) / مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب. / راعي; حامي; وصي; سيد; و / حريف; زبون",
 "じょうきゃくるい": "مجدافية الأرجل (قشريات بحرية أو مياه عذبة دقيقة لها عادة ستة أزواج من الأطراف على الصدر؛ بعضها وفير في العوالق والبعض الآخر طفيلي على الأسماك)",
 "じょうきゅうこくみん": "نُخْبَة",
 "じょうきゅうさいばんしょ": "محكمة عليا (أي محكمة لها اختصاص أعلى من محكمة أدنى)",
 "じょうきゅうそうちょう": "سمكة الرقيب, سمكة العريف (سمكة قعيسية كبيرة زرقاء رمادية مخططة بالأسود؛ توجد في جميع أنحاء العالم تقريباً) / رقيب ميجر, مساعد أول (ضابط صف يعمل ككبير المسؤولين الإداريين لوحدة مقر الجيش)",
 "じょうきゅうふくしゃちょう": "نائب رئيس أول (نائب الرئيس الأعلى رتبة في شركة لديها أكثر من نائب رئيس)",
 "じょうきょ": "امتياز (عقد يمنح الحق في تشغيل عمل فرعي) / إذعان, تنازل (فعل التنازل أو الإذعان) / تنازل (نقطة يتم التنازل عنها أو التسليم بها)\nمثال: حصل على امتياز البيرة في ملعب الكرة",
 "じょうきょう": "حالة, ظرف (الحالة العامة للأشياء؛ مجموعة الظروف في وقت معين)\nمثال: الوضع الدولي الحالي خطير",
 "じょうきょうしょうこ": "دليل ظرفي, قرينة (دليل يوفر فقط أساساً للاستنتاج حول الواقعة المتنازع عليها)",
 "じょうきょうせつめい": "إيجاز, تعليمات موجزة (تعليمات مفصلة، كما هو الحال لعملية عسكرية)",
 "じょうきょうほうこく": "تقرير سير العمل, تقرير مرحلي (تقرير عن العمل المنجز خلال فترة زمنية محددة)",
 "じょうきよく": "حمام بخار, حمام تركي (التعرق في غرفة بخار قبل الحصول على تدليك ودش بارد) / حمام بخار, غرفة بخار (غرفة يمكن ملؤها بالبخار يستحم فيها الناس)",
 "じょうきをいっした": "شاذّ / ضالّ / زائِغ",
 "じょうきん": "بَدَوَام كَامِل (لعدد الساعات القياسي) / بدوام كامل (لكامل الوقت المناسب لنشاط ما)\nمثال: تعمل بدوام كامل",
 "じょうきんこうし": "مُحَاضِر, مُحَاضِرَة",
 "じょうきタービン": "عنفة بخارية",
 "じょうぎ": "مِسْطَرَة (أداة تستخدم لقياس الأطوال أو رسم الخطوط المستقيمة؛ خط مستقيم تحدده مِسطَرة أو بُعد محدد) / حَاكِم (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر)\nمثال: استعارت المسطرة. / أسرة, زمالة (رابطة لأشخاص يشتركون في معتقدات أو أنشطة مشتركة) / زمالة, منحة بحثية (أموال تُمنح (من قبل جامعة أو مؤسسة أو وكالة أخرى) للدراسات المتقدمة أو الأبحاث) / رفقة, زمالة (حالة الوجود مع شخص ما)\nمثال: الرسالة لم تكن موجهة للموظفين فحسب بل لكل عضو في أسرة الشركة",
 "じょうぎざ": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "じょうく": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ / تَكْرَار, إِعَادَة",
 "じょうくう": "سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات",
 "じょうぐう": "مِرْوَحَة, مروحة / مِرْوَحَة, هَوَّايَة / مُشَجِّع, مُشَجِّعَة",
 "じょうけい": "الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ / مَشْهَد, مَسْرَحِيَّة / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع.",
 "じょうけいき": "ذراع التطويل, عوارضة (أي من الصواري أو الأعمدة الأفقية المتنوعة المستخدمة لتمديد أسفل الشراع أو لمناولة البضائع أو في الإرساء) / بوم, ذراع الميكروفون (عمود يحمل ميكروفوناً علوياً مسلطاً فوق موقع تصوير فيلم أو تلفزيون) / دوي, رعد (ضجيج عميق طويل وعالٍ) / رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال))\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "じょうけん": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\"",
 "じょうけんけんさく": "مِصْفَايَة / فِلْتَر",
 "じょうけんせつ": "شَرْطِيّ (أحد المنتسبين إلى الشُرْطَة)\nمثال: تبدو وكأنك شرطي.",
 "じょうけんつき": "شَرْطِيّ (أحد المنتسبين إلى الشُرْطَة)\nمثال: تبدو وكأنك شرطي.",
 "じょうけんつきかくりつ": "احتمال مشروط (احتمال وقوع حدث ما بالنظر إلى وقوع حدث أو أحداث أخرى)",
 "じょうけんづけ": "تَكْيِيف",
 "じょうけんはんしゃ": "منعكس شرطي, منعكس مكتسب (استجابة مكتسبة تخضع لسيطرة (مشروطة بحدوث) محفز)",
 "じょうけんぶん": "جُمْلَة شَرْطِيَّة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة!",
 "じょうげ": "في كل حدب وصوب, في كل مكان (في كل مكان (عالياً ومنخفضاً))\nمثال: بحث في كل مكان / مُتَذَبْذِب, مُتَقَلِّب (يشهد صعودًا وهبوطًا غير قابلَيْن للتنبؤ) / قطعتان ((للملابس) مصنوع من أو يتكون من جزأين أو قطعتين) / بيكيني (ملابس سباحة نسائية قصيرة جداً) / بدلة من قطعتين (بدلة عمل تتكون من سترة وتنورة أو بنطال متطابقين)\nمثال: ملابس سباحة من قطعتين",
 "じょうげかんけい": "تسلسل هرمي, هرمية (تنظيم الأشخاص في مراتب ودرجات مختلفة داخل هيئة إدارية)",
 "じょうげげん": "حد, حدود (الخط أو المستوى الذي يشير إلى حد أو مدى شيء ما)",
 "じょうげさかさま": "رأساً على عقب, مقلوباً (في وضع مقلوب)\nمثال: كان الصندوق ملقى على الأرض مقلوباً",
 "じょうげせん": "ذهاباً وإياباً, صعوداً وهبوطاً (التحرك للخلف وللأمام على طول مسار معين) / صُعُودًا وَهُبُوطًا, مِنْ أَعْلَى إلى أَسْفَل (بالتبادل بين الاتجاهين العلوي والسفلي)\nمثال: مشى ذهاباً وإياباً في غرفة تبديل الملابس",
 "じょうげれつ": "سِلْسِلَة",
 "じょうげん": "التربيع الأوّل, التربيع المتزايد / حد شمالي, حد علوي (الحد الموجود على الجانب العلوي (أو الشمالي) لشيء ما) / حد أقصى, ذروة (أكبر كمية ممكنة) / هَذَى",
 "じょうげんち": "حد أعلى ((رياضيات) عدد يساوي أو أكبر من أي عدد آخر في مجموعة معطاة)",
 "じょうげんのつき": "التربيع الأوّل, التربيع المتزايد",
 "じょうこ": "بَدَوَام كَامِل (لعدد الساعات القياسي) / بدوام كامل (لكامل الوقت المناسب لنشاط ما)\nمثال: تعمل بدوام كامل",
 "じょうこう": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري) / جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع) / بَنْد\nمثال: يا لها من جملة! / جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس. / فوق طائفة ((في الأحياء) فئة تصنيفية تحت الشعبة وفوق الطائفة)",
 "じょうこうきょきん": "منشارية خلفية علوية (عضلة رباعية رقيقة في الجزء العلوي والظهري من الصدر؛ تعمل على رفع الأضلاع العلوية)",
 "じょうこうぐち": "أوتوبيس, باص (مركبة تحمل العديد من الركاب؛ تستخدم للنقل العام)\nمثال: كان دائماً يركب الحافلة للعمل",
 "じょうこうけっちょう": "قولون صاعد (جزء الأمعاء الغليظة الذي يصعد من الأعور إلى القولون المستعرض)",
 "じょうこうじょう": "مِنَصَّة / رَصِيف, مِنَصَّة",
 "じょうこうだいどうみゃく": "أبهر صاعد (الجزء الصاعد من الأبهر عند خروجه من البطين الأيسر)",
 "じょうこし": "تاريخ قديم (معرفة حقيقة أو حدث حديث أصبح معروفاً لدرجة أنه فقد أهميته الأصلية) / التاريخ القديم (تاريخ العالم القديم)",
 "じょうこん": "اِنْجِرَاف / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "じょうご": "شَارِب / مِرْوَحَة, مروحة / مِرْوَحَة, هَوَّايَة / مُشَجِّع, مُشَجِّعَة / ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات) / إسهاب, كثرة الكلام (وفرة مفرطة من الكلمات)",
 "じょうごう": "علامة الضرب, نقطة الضرب (علامة تشير إلى عملية الضرب) / اقتران علوي ((في علم الفلك) محاذاة الأرض وكوكب على الجانب المقابل من الشمس)",
 "じょうさい": "قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "じょうさいふく": "رداء القداس (رداء طويل بلا أكمام يرتديه الكاهن عند الاحتفال بالقداس)",
 "じょうさいぼう": "خلية ابنة, خلية وليدة (خلية تتكون عن طريق انقسام أو تبرعم خلية أخرى)\nمثال: تنمو الجمرة الخبيثة عن طريق الانقسام إلى خليتين وليدتين متطابقتين عموماً",
 "じょうさく": "تُحْفَة, رَائِعَة",
 "じょうさん": "نتح (انبعاث بخار الماء من أوراق النباتات) / انصباب, نتح (مرور الغازات عبر أنابيب دقيقة بسبب الاختلافات في الضغط أو درجة الحرارة) / نتح (عملية إخراج أو زفر بخار الماء من خلال الجلد أو الأغشية المخاطية) / اِبْنَة, بِنْت / آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "じょうさんけい": "مقياس التبخر (أداة تقيس معدل تبخر الماء)",
 "じょうさんさよう": "نتح (انبعاث بخار الماء من أوراق النباتات) / انصباب, نتح (مرور الغازات عبر أنابيب دقيقة بسبب الاختلافات في الضغط أو درجة الحرارة) / نتح (عملية إخراج أو زفر بخار الماء من خلال الجلد أو الأغشية المخاطية)",
 "じょうざい": "حَبَّة دَوَاء (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / قُرْص / حَبّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / حَبَّة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة)\nمثال: أكلت حبة طماطم. / تَبَرُّع, هِبَة / سَاكِن, سَاكِنَة",
 "じょうざぶぶっきょう": "بوذية التيرافادا, تيرافادا (واحدة من مدرستين عظيمتين للعقيدة البوذية تؤكدان على الخلاص الشخصي من خلال الجهود الذاتية؛ شكل محافظ من البوذية يلتزم بنصوص بالي والمثل غير الإلهي…)",
 "じょうざん": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "じょうざんき": "مَضْرُوب فِيه, مُعَامِل ضَرْب (العدد الذي يضرب به المضروب)",
 "じょうし": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / مَنْشُور\nمثال: نشر توم الغسيل. / مَبْعُوث / أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو / درع النبالة, شعار النبالة (الرموز الرسمية لعائلة أو دولة، إلخ) / أسلحة, تسليح (الأسلحة مجتمعة) / قصة حب, قصة غرامية (قصة تتناول موضوع الحب) / بِنْت / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة) / طِفْلة / بنت / فتاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة. / اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية. / زَوْجَة, اِمْرَأَة / عَالِيّ الرُتْبَة / بُودِيسَاتْفَا",
 "じょうしき": "اَلْحِسّ السَّلِيم / صِيغَة",
 "じょうしきじん": "اَلْحِسّ السَّلِيم",
 "じょうしきてき": "عَادِيّ, مَأْلُوف",
 "じょうしきはずれ": "خارج عن المألوف, غير تقليدي (غير مطابق للقواعد أو المعايير المقبولة) / غير تقليدي, متحرر (غير تقليدي أو غير مساير للأعراف) / غَيْرُ تَقْلِيدِيّ, غَيْرُ مَشْرُوعٍ (لا يتوافق مع القانون أو الأعراف الاجتماعية)\nمثال: ملابسها وتسريحة شعرها غير التقليدية",
 "じょうしきやぶり": "خارج عن المألوف, غير تقليدي (غير مطابق للقواعد أو المعايير المقبولة) / غير تقليدي, متحرر (غير تقليدي أو غير مساير للأعراف) / غَيْرُ تَقْلِيدِيّ, غَيْرُ مَشْرُوعٍ (لا يتوافق مع القانون أو الأعراف الاجتماعية)\nمثال: ملابسها وتسريحة شعرها غير التقليدية",
 "じょうしたい": "حزام صدري (دعامة هيكلية ترتبط بها الأطراف الأمامية للفقاريات)",
 "じょうしゃ": "ركوب, صعود (فعل صعود الركاب والطاقم على متن سفينة أو طائرة) / ألواح خشبية, كسوة خشبية (هيكل من الألواح) / مبيضة, نسخة منقحة (نسخة نظيفة من مسودة مصححة)",
 "じょうしゃぐち": "دُخُول / مَدْخَل",
 "じょうしゃけん": "تَذْكِرَة / تذكرة",
 "じょうしゃていいん": "سعة المقاعد (عدد الأشخاص الذين يمكن جلوسهم في مركبة أو قاعة أو ملعب وما إلى ذلك)",
 "じょうしゅ": "مَاهِر, حَاذِق / تملق, نفاق (ثناء مفرط أو غير صادق) / رَاقٍ بِتَصَنُّع (أنيق بشكل مُتَظَاهَر) / مَزَاج / شَيْخ, قَائِد",
 "じょうしゅう": "عَادَة, عُرْف",
 "じょうしゅうしゃ": "مُدْمِن, مُدْمِنَة",
 "じょうしゅうてき": "مَأْلُوف, مُعْتَاد (شائع الاستخدام أو الممارسة؛ اعتيادي)",
 "じょうしゅうはん": "عائد للإجرام (شخص يُعتقل بشكل متكرر بسبب سلوك إجرامي (خاصة لنفس السلوك الإجرامي)) / عَوْد (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "じょうしょ": "عَاطِفَة, عَوَاطِف / جَو, غِلَاف جَوِّيّ / جَو / مبيضة, نسخة منقحة (نسخة نظيفة من مسودة مصححة) / حَارّ رَطْب, خَانِق (يتَّسم بحرارة ورطوبة خانقتَين) / شَهْوَانِيّ, مُغْرٍ (مُثير جنسيًّا أو مُمتع حسّيًّا)",
 "じょうしょう": "اِنْتِفَاضَة, تَمَرُّد (معارضة منظمة للسلطة؛ صراع يحاول فيه فصيل انتزاع السيطرة من آخر) / بَازِغ, صَاعِد (برز حديثاً إلى الواجهة) / صَاعِد, نَاشِئ (يَبْلُغُ مَرْحَلَةَ النُّضْج) / طَالِع, مُنْحَدِرٌ صُعُودًا (مَائِلٌ نَحْوَ الأَعْلَى) / مَنِيع / قِسِّيس, دَاعِيَة (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ) / وَزِير, وَزِيرَة / إمدادات غذائية, تموين (مخزون أو إمدادات من الأطعمة)",
 "じょうしょうき": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "じょうしょうきりゅう": "تيار صاعد (تيار هوائي صاعد قوي)",
 "じょうしょうげんど": "سَقْف ((سَقَفَ) البيت ونحوه سقفا: عمل له سقفا)\nمثال: نظرت إلى السقف.",
 "じょうしょしょうがい": "اضطراب عاطفي, اضطراب وجداني (أي اضطراب عقلي لا تسببه تشوهات عضوية قابلة للكشف في الدماغ ويكون فيه الاضطراب الرئيسي في العواطف سائداً)",
 "じょうしん": "جَاضِم / تَقَدُّم",
 "じょうしんこ": "عَالِي الجَوْدَة, مُمْتَاز (يتفوق في الجودة)",
 "じょうしんしょ": "تقرير, تقرير مكتوب (وثيقة مكتوبة تصف نتائج فرد أو مجموعة ما)\nمثال: هذا يتفق مع الدراسة الحديثة التي أجراها هيل وديل",
 "じょうじ": "عَادَةً, الاَكْثِرْ / مُتَوَاصِل, مُتَّصِل / عَلَاقَة غَرَامِيَّة",
 "じょうじこよう": "بَدَوَام كَامِل (لعدد الساعات القياسي) / بدوام كامل (لكامل الوقت المناسب لنشاط ما)\nمثال: تعمل بدوام كامل",
 "じょうじせい": "بارامغناطيسية, مغناطيسية مسايرة (مواد مثل الألومنيوم أو البلاتين تصبح ممغنطة في مجال مغناطيسي لكنها تختفي عند إزالة المجال)",
 "じょうじせいたい": "مغناطيس مساير (مغناطيس مصنوع من مادة تتناسب مغنطتها مع قوة المجال المغناطيسي المطبق عليها)",
 "じょうじつ": "تمييز, محاباة (المعاملة غير العادلة لشخص أو مجموعة على أساس التحيز) / محاباة, محسوبية (الميل لتفضيل شخص أو مجموعة على حساب الآخرين) / إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "じょうじゅ": "إشباع, تحقيق (فعل إتمام شيء ما (كرغبة أو وعد)) / إنجاز, تحقيق الذات (شعور بالرضا لتحقيق رغباتك)",
 "じょうじゅう": "مُسْتَعْمَرَة, مُسْتَوْطَنَة / دَائِمًا, أَبَدًا / اسْتِقْرَار, ثَبَات (صفة الديمومة والخلو من التغيير أو التباين) / ثَبَات عَلَى العَهْد, وَفَاء (الإخلاص والاعتمادية في العلاقات الشخصية (خاصة الإخلاص الزوجي)) / ثبات إدراكي ((علم النفس) الميل لإدراك الأشياء بطريقة متشابهة جداً على الرغم من التباينات الواسعة في ظروف الملاحظة)\nمثال: اعتمد البحارة الأوائل على ثبات الرياح التجارية",
 "じょうじゅうざが": "أبداً",
 "じょうじゅうふだん": "دَائِم, لَا يَنْقَطِع (غَيْرُ مُنْقَطِعٍ فِي الزَّمَنِ وَمُسْتَمِرٌّ إِلَى أَجَلٍ غَيْرِ مُسَمًّى)",
 "じょうじゅうふめつ": "أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى) / أزهار مجففة, زهرة الخلود (أي من النباتات المختلفة من أجناس مختلفة من الفصيلة النجمية ذات زهور يمكن تجفيفها دون فقدان الشكل أو اللون)",
 "じょうじゅつ": "الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "じょうじょ": "قِسِّيس, دَاعِيَة (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ) / وَزِير, وَزِيرَة",
 "じょうじょう": "إدراج, سرد (فعل عمل قائمة بالعناصر) / قائمة (قاعدة بيانات تحتوي على مصفوفة مرتبة من العناصر (أسماء أو موضوعات)) / أَدَاء / مَسْرَحِيَّة / مُمْتَاز, فَاخِر / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "じょうじょうとうしん": "صندوق متداول في البورصة (صندوق استثمار مشترك يتم تداوله في سوق الأوراق المالية)",
 "じょうじる": "اِسْتَغَلَّ / ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "じょうじん": "عَاشِق, عَاشِقَة / مُغْرَم / عَادِيّ, غَيْر مُمَيَّز (ليس مميزاً بأي شكل؛ يفتقر للتميز) / كَابِر / بَيْلَسَان (زهره بيضاء ذات رائحه عطريه جميله) / خَمَان / حَم (التنور أو الفرن أو الماء: سجر وسخن وأصبح حارّا؛ الأمر: قُضِيَ وتقدر من الله)\nمثال: أفضل لحم البقر.",
 "じょうすい": "إمدادات المياه, نظام مياه (منشأة توفر مصدراً للمياه)\nمثال: ناقشت المدينة تنقية إمدادات المياه",
 "じょうすいき": "مرشح مياه (مرشح لإزالة الشوائب من إمدادات المياه)",
 "じょうすいち": "حَوْض, جَابِيَة (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه) / فِنْطَاس\nمثال: ملأت الحوض ماءا.",
 "じょうすいどう": "كُلْوَة, كُلْيَة",
 "じょうすう": "مَضْرُوب فِيه, مُعَامِل ضَرْب (العدد الذي يضرب به المضروب) / نِصَاب / ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة. / لَفْظِيّ, حَرْفِيّ / قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب.",
 "じょうず": "مَاهِر, حَاذِق / تملق, نفاق (ثناء مفرط أو غير صادق)",
 "じょうずもの": "مُتَمَلِّق, مُداهِن (شخص يستخدم الإطراء والتملق)",
 "じょうずる": "اِسْتَغَلَّ / ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "じょうせい": "حالة, ظرف (الحالة العامة للأشياء؛ مجموعة الظروف في وقت معين)\nمثال: الوضع الدولي الحالي خطير / تخمير (إنتاج المشروبات الشعيرية (مثل البيرة) من الشعير والجنجل عن طريق طحنها وغليها وتخمير الناتج بالخميرة) / إحداث, تسبيب (فعل التسبب في حدوث شيء ما) / تَارِيخ قَدِيم (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟ / رَائِق, طَافٍ ((للسوائل) يطفو على السطح فوق الراسب أو الرُّسابة) / سائل طافٍ (السائل الصافي الذي يطفو فوق الرواسب أو المواد المترسبة)",
 "じょうせいけつじょ": "تَبَلُّد شُعُورِيّ, غِلْظَة (الخلو من العاطفة أو الشعور؛ قسوة القلب)",
 "じょうせいご": "تَكْرَارِيّ (يتسم بالتكرار المتتابع)",
 "じょうせいちょうさ": "اِسْتِبَانَة, اِسْتِطْلَاع",
 "じょうせき": "أقدمية, طول العمر (خاصية العيش طويلاً) / أقدمية (رتبة أعلى من الآخرين خاصة بسبب الخدمة الأطول) / مُنْتَج / سِلْعَة / حَاصِل (الشيء :حصل عليه) / مَحْصُول / حَاصِل ضَرْب (الشيء :حصل عليه) / جَدَاء / صِيغَة",
 "じょうせつ": "مَنْزِلَة, مَكَانَة",
 "じょうせつかん": "دار عرض سينمائي, سينما (مسرح تُعرض فيه الأفلام)",
 "じょうせん": "صَعِدَ / سَفِينَة, سَفينة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ) / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة)\nمثال: غادروا السفينة. / تخطيط شريطي, تريط (شريط أو أشرطة ذات لون مغاير) / تحزز, تخطط (أي من الأخاديد المتوازية الدقيقة مثل: الخدوش التي يتركها نهر جليدي على الصخور أو الخطوط في الأنسجة العضلية)\nمثال: تظهر الكروموسومات شرائط مميزة / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / عَلَاقَات عَامَّة / دِعَايَة, بْرُوبَاغَنْدَا",
 "じょうせんしゃ": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "じょうせんしょくたい": "كْرُومُوسُوم جَسَدِيّ (أي كروموسوم ليس كروموسوماً جنسياً؛ تظهر في أزواج في خلايا الجسم ولكن ككروموسومات مفردة في الحيوانات المنوية)",
 "じょうぜつ": "ثرثرة (صفة الإطناب وكثرة الكلام)",
 "じょうぜつか": "ثَرْثَار",
 "じょうそ": "اِلْتِمَاس, اِسْتِئْنَاف / اِسْتَأْنَفَ",
 "じょうそう": "تحسس, حساسية ((علم وظائف الأعضاء) الاستجابة للمحفزات الخارجية؛ ملكة الإحساس) / حساسية, قابلية للإحساس (الاستجابة العقلية والوعي) / رهافة حس, شعور مرهف (حساسية راقية للانطباعات الممتعة أو المؤلمة)\nمثال: حساسية للألم",
 "じょうそううん": "عَالِي الارْتِفَاع (يحدث عند ارتفاع عالٍ نسبيّاً أو منه) / رَفِيع المُسْتَوَى (في مستوى مرتفع من الرتبة أو الأهمية)",
 "じょうそうかいきゅう": "الطَّبَقَة الْعُلْيَا",
 "じょうそうけんちく": "بنية فوقية (هيكل يتكون من جزء السفينة الموجود فوق السطح الرئيسي)",
 "じょうそうご": "لغة فوقية (لغة شعب غازٍ لاحق تُفرض على السكان الأصليين وتساهم بخصائص في لغتهم) / طبقة علوية, طبقة فوقية (أي طبقة توضع فوق أخرى)",
 "じょうそうど": "تربة سطحية (طبقة التربة الموجودة على السطح)",
 "じょうそうぶ": "القيادة العليا, كبار المسؤولين (أهم الأشخاص في هيئة حاكمة)",
 "じょうぞう": "تخمير (إنتاج المشروبات الشعيرية (مثل البيرة) من الشعير والجنجل عن طريق طحنها وغليها وتخمير الناتج بالخميرة)",
 "じょうぞうか": "صاحب مصنع بيرة (المالك أو المدير لمصنع بيرة) / خمّار, صانع البيرة (شخص يصنع البيرة من الشعير والجنجل والماء)",
 "じょうぞうがく": "علم التخمير (فرع الكيمياء المعني بالتخمير (كما في صناعة النبيذ أو التخمير أو التقطير))",
 "じょうぞうしゅ": "مشروب مخمر (مشروب مصنوع عن طريق النقع والغلي والتخمير بدلاً من التقطير)",
 "じょうぞうしょ": "مَصْنَع جِعَة (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "じょうぞうじょ": "مَصْنَع جِعَة (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "じょうた": "إفراط, فرط (كمية تزيد عما هو مناسب)\nمثال: الأطفال في سن الرابعة لديهم فرط في الطاقة",
 "じょうたい": "فَخِذ, فَخْذ / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع.",
 "じょうたいおこし": "تمرين الجلوس من الرقود (تمرين للبطن يجلس فيه الشخص من وضع الاستلقاء دون استخدام الذراعين للرافعة)",
 "じょうたいか": "تطبيع, تقييس (فرض المعايير أو اللوائح)",
 "じょうたいせんい": "تحول الطور, تغير الطور (تغير من حالة (صلبة أو سائلة أو غازية) إلى أخرى دون تغيير في التركيب الكيميائي)",
 "じょうたいへんか": "تحول الطور, تغير الطور (تغير من حالة (صلبة أو سائلة أو غازية) إلى أخرى دون تغيير في التركيب الكيميائي) / تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "じょうたつ": "تَحْسِين\nمثال: 君の英語は上達している。 — إنجليزيتك تتحسن.",
 "じょうたま": "جَمَال, زَيْن / حَسْنَاء, جَمِيلَة",
 "じょうたん": "قِمَّة",
 "じょうだい": "سعر التجزئة (السعر الإجمالي المفروض على منتج يُباع للعميل، ويشمل تكلفة المصنع بالإضافة إلى هامش ربح التجزئة) / حاجب, رئيس التشريفات (ضابط يدير منزل ملك أو نبيل) / أمين خزانة البلدية (أمين صندوق مؤسسة بلدية)",
 "じょうだいじょうみゃく": "وريد أجوف علوي (يتلقى الدم من الرأس والذراعين والصدر ويصب في الأذين الأيمن للقلب؛ يتكون من الوريد الفرد وكلا الوريدين العضديين الرأسيين)",
 "じょうだま": "جَمَال, زَيْن / حَسْنَاء, جَمِيلَة",
 "じょうだん": "سطح علوي (سطح مرتفع) / منبر, منصة الخطابة (منصة مرتفعة عن المستوى المحيط لإبراز الشخص الموجود عليها) / طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "じょうだんぐち": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "じょうだんぬきで": "بِجِدِّيَّة, بجد",
 "じょうだんめかして": "على سبيل المزاح, مازحاً (ليس بجدية) / على سبيل المزاح, مازحاً\nمثال: قصدت ذلك مازحاً (يفيد الاستعلاء؛ يفيد التعليل)",
 "じょうち": "دَائِم",
 "じょうちいいんかい": "لجنة دائمة (لجنة دائمة)",
 "じょうちゃん": "صبية, فتاة (فتاة أو شابة غير متزوجة)",
 "じょうちゅう": "سَاكِن, سَاكِنَة / حقن وريدي (حقنة في الوريد) / دودة شريطية (ديدان مفلطحة تشبه الشريط تتطفل في أمعاء البشر والفقاريات الأخرى)",
 "じょうちゅうるい": "دودة شريطية (ديدان مفلطحة تشبه الشريط تتطفل في أمعاء البشر والفقاريات الأخرى)",
 "じょうちょ": "عَاطِفَة, عَوَاطِف / جَو, غِلَاف جَوِّيّ / جَو",
 "じょうちょう": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / أرفع مقاماً, أقدم (أكبر سنًا؛ أعلى رتبة؛ أطول في مدة الولاية أو الخدمة) / أَكْبَر سِنّاً, مُسِنّ (شخص أكبر منك سناً) / طالب سنة نهائية (طالب جامعي خلال السنة التي تسبق التخرج)\nمثال: ضابط كبير / إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي) / مُضْجِر, مُمِلّ (يفتقر إلى الإثارة لدرجة تسبب السأم الذهني) / تكرار زائد, حشو (تكرار فعل ما بلا حاجة) / زيادة, فائض (سمة كون الشيء زائداً وغير مطلوب) / تكرار احتياطي ((إلكترونيات) تصميم نظام يكرر المكونات لتوفير بدائل في حالة فشل أحد المكونات) / تكرار زائد, حشو (تكرار الرسائل لتقليل احتمالية الأخطاء في الإرسال)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة / جَو, غِلَاف جَوِّيّ / جَو",
 "じょうちょうか": "استنساخ, مضاعفة (فعل نسخ أو عمل نسخة (أو نسخ) من شيء ما) / تكرار, نسخة طبق الأصل (نسخة تتوافق مع الأصل تماماً)\nمثال: هذا النوع من الازدواجية هو هدر",
 "じょうちょうかんまくどうみゃくへいさしょう": "شريان مساريقي علوي (ينشأ من الجزء العلوي للأبهر ويغذي الأمعاء الدقيقة والأعور والقولون)",
 "じょうちょうけんさ": "فحص التكافؤ (نظام للتحقق من الأخطاء في عمل الكمبيوتر)",
 "じょうちょうせい": "تكرار زائد, حشو (تكرار فعل ما بلا حاجة) / زيادة, فائض (سمة كون الشيء زائداً وغير مطلوب) / تكرار احتياطي ((إلكترونيات) تصميم نظام يكرر المكونات لتوفير بدائل في حالة فشل أحد المكونات) / تكرار زائد, حشو (تكرار الرسائل لتقليل احتمالية الأخطاء في الإرسال)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة",
 "じょうちょうど": "تكرار زائد, حشو (تكرار فعل ما بلا حاجة) / زيادة, فائض (سمة كون الشيء زائداً وغير مطلوب) / تكرار احتياطي ((إلكترونيات) تصميم نظام يكرر المكونات لتوفير بدائل في حالة فشل أحد المكونات) / تكرار زائد, حشو (تكرار الرسائل لتقليل احتمالية الأخطاء في الإرسال)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة",
 "じょうちょうりょう": "تكرار زائد, حشو (تكرار فعل ما بلا حاجة) / زيادة, فائض (سمة كون الشيء زائداً وغير مطلوب) / تكرار احتياطي ((إلكترونيات) تصميم نظام يكرر المكونات لتوفير بدائل في حالة فشل أحد المكونات) / تكرار زائد, حشو (تكرار الرسائل لتقليل احتمالية الأخطاء في الإرسال)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة",
 "じょうちょしょうがい": "اضطراب عاطفي, اضطراب وجداني (أي اضطراب عقلي لا تسببه تشوهات عضوية قابلة للكشف في الدماغ ويكون فيه الاضطراب الرئيسي في العواطف سائداً)",
 "じょうちょてき": "مُثَار عَاطِفِيًّا, مُنْفَعِل ((للأشخاص) متأثر بشكل مفرط بالعاطفة) / عاطفي (ذو عاطفة أكثر من المعتاد) / انفعالي, عاطفي (محدد أو مدفوع بالعاطفة بدلاً من العقل) / انفعالي, عاطفي (من أو يتعلق بالعاطفة)\nمثال: كان سلوكه عاطفياً للغاية",
 "じょうて": "مَاهِر, حَاذِق / تملق, نفاق (ثناء مفرط أو غير صادق)",
 "じょうてい": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب. / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: قدم عمي لرؤيتي.",
 "じょうてん": "سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب. / صُعُود, اِرْتِقَاء",
 "じょうと": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "じょうとう": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو / يقرب / عُرْفِيّ",
 "じょうとうく": "عِبَارَةٌ مُتَدَاوَلَة, كْلِيشِيه (الجملة من الكلام تعبّر عن شيء ما أو تعبّر عمّا في النفس من معان؛ للكلام: المعنى عامة أو المساواة في الدلالة)\nمثال: ستترجم هذه العبارة.",
 "じょうとうひょうげん": "عبارة مبتذلة, قول مأثور مبتذل (ملاحظة مبتذلة أو واضحة بشكل مفرط)",
 "じょうとうひん": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "じょうとうへい": "عريف رمح, وكيل عريف (جندي في سلاح مشاة البحرية رتبته أعلى من جندي درجة أولى وأقل من عريف)",
 "じょうとうへいそう": "رئيس ضباط الصف (شخص يحمل أعلى رتبة لضابط صف بحري)",
 "じょうとえき": "أرباح رأسمالية, مكاسب رأسمالية (المبلغ الذي يتجاوز به سعر بيع الأصل سعر الشراء؛ يتحقق الربح عند بيع الأصل)",
 "じょうとかのう": "قَابِل لِلتَّحْوِيل, قَابِل لِلتَّدَاوُل (يمكن نقل ملكيته قانونياً إلى شخص آخر) / قَابِلٌ لِلنَّقْل, مُتَحَرِّك (يُمْكِنُ نَقْلُهُ أَوْ تَحْوِيلُهُ مِنْ مَكَانٍ لِآخَر)",
 "じょうとくい": "راعي; حامي; وصي; سيد; و / حريف; زبون",
 "じょうとしょとく": "أرباح رأسمالية, مكاسب رأسمالية (المبلغ الذي يتجاوز به سعر بيع الأصل سعر الشراء؛ يتحقق الربح عند بيع الأصل)",
 "じょうとたんぽ": "رَهْن, رَهْن عَقَارِيّ ((رَهَنَ) الشيءُ يَرْهَنُ رهْنًا، ورُهُونا: ثَبَت ودامَ؛ يقال (رَهَنَ) بالمكان: أقامَ)\nمثال: رهن فاضل الحلي.",
 "じょうとにん": "ناقل الملكية ((قانون) شخص ينقل سند ملكية أو ممتلكات إلى آخر)",
 "じょうとふのう": "غَيْر قَابِل لِلتَّحْوِيل (لا يمكن نقله أو تحويله إلى شخص آخر)",
 "じょうど": "جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط) / سَمَاوَات / فِرْدَوْس (فردوس)\nمثال: هواوي جنة على الأرض. / تُرْبَة, أَرْض / اِتَّسَخَ / تربة طفالية, طمي (تربة غنية تتكون من خليط من الرمل والطين والمواد العضوية المتحللة)",
 "じょうどう": "عَاطِفَة, عَوَاطِف",
 "じょうどうきょく": "حركة أبدية (حركة تستمر إلى أجل غير مسمى دون أي مصدر خارجي للطاقة؛ مستحيلة عملياً بسبب الاحتكاك)",
 "じょうない": "باحة, ساحة (الأرض المسيجة المحيطة بمنزل أو مبنى آخر) / أساس, بينة (أساس الاعتقاد أو عدم التصديق؛ المعرفة التي يبنى عليها الاعتقاد) / سبب, مبرر (مبرر لوجود أو حدوث شيء ما) / أرض, ساحة (قطعة أرض تم تنظيفها لأغراض خاصة (مثل الترفيه أو الدفن إلخ))\nمثال: كان منزلاً صغيراً بلا فناء تقريباً",
 "じょうないほうそう": "مكبرات صوت عامة, نظام مخاطبة الجمهور (نظام تضخيم إلكتروني يستخدم كنظام اتصال في الأماكن العامة)",
 "じょうなまがし": "مُرْتَفِع الدَّرَجَة",
 "じょうにあつい": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة.",
 "じょうにもろい": "مُعَرَّض",
 "じょうにん": "مَنْزِلَة, مَكَانَة / عَاشِق, عَاشِقَة / مُغْرَم",
 "じょうにんいいんかい": "لجنة دائمة (لجنة دائمة)",
 "じょうにんりじ": "مدير تنفيذي, مسؤول تنفيذي (شخص مسؤول عن إدارة عمل تجاري)",
 "じょうねつ": "عَاطِفَة, شَغْف / عَزْم / شَغَف (المرضُ فلانًا: وصل المرض شِغاف قلبه فالقلب عليل فيه مرض؛ الحبُّ فلانًا: وصل إلى شِغَاف قلبه. وقيل: دخل الحب تحت الشغاف. وقيل: غشى القلب تماما)\nمثال: قبل توم ماري بشغف. / بشكل حار جداً, بغلليان ((تستخدم للحرارة) للغاية) / بُخَارِيّ, مُتَصَاعِد البُخَار (مملوء بالبخار أو ينبعث منه رطوبة على شكل بخار أو ضباب)\nمثال: كان الطبق ساخناً جداً / حَارّ رَطْب, خَانِق (يتَّسم بحرارة ورطوبة خانقتَين) / شَهْوَانِيّ, مُغْرٍ (مُثير جنسيًّا أو مُمتع حسّيًّا)",
 "じょうねつてき": "شَغُوف, مُتَحَمِّس",
 "じょうねん": "عَاطِفَة",
 "じょうのう": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / ضريبة الأراضي, ضريبة الأملاك (ضريبة رأسمالية تفرضها البلديات على الممتلكات؛ وتعتمد على القيمة المقدرة للعقار) / حمضيات (أي من الفواكه العديدة لجنس الحمضيات ذات القشرة السميكة واللب العصيري؛ تزرع في المناطق الدافئة)",
 "じょうのふかい": "حَنُون بِالفِطْرَة, طَيِّب القَلْب (ذو طبع فطري طيّب وحنون)",
 "じょうは": "إنتاج النفط, تنقيب (فعل حفر ثقب في الأرض على أمل إنتاج البترول) / تثقيب, حفر (فعل التثقيب أو الحفر)",
 "じょうはく": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة) / عَضُد (مُعِين؛ قُوَّة) / مُبْتَهِج, مُتَفَائِل بِسَذَاجَة (متفائل بشكل لطيف وربما غير واقعي) / نبرة صاعدة, نقر ضعيف (نقر غير مشدد (خاصة النقر الأخير في المقياس)) / رفاهية, سعادة (حالة قناعة وسعادة وصحة وازدهار)\nمثال: كانت المدينة أخيراً في حالة تحسن (رفاهية) بعد مشاكلنا الأخيرة",
 "じょうはくとう": "سكر ناعم الحبيبات (سكر ناعم الحبيبات جداً كان يرش قديماً من وعاء خاص)",
 "じょうはつ": "تتجفاف, تجفيف (عملية استخلاص الرطوبة) / تبخر, تبخير (عملية التحول إلى بخار) / اِخْتِفَاء",
 "じょうはつがん": "متبخرات (الراسب المتبقي بعد تبخر مياه البحر)",
 "じょうはり": "عَنِيد",
 "じょうはん": "شوط أول (الأول من شوطين للعب)",
 "じょうば": "ركوب الخيل (السفر محمولاً على ظهر الخيل) / ركوب الخيل, فروسية (رياضة الجلوس على ظهر الحصان مع التحكم في تحركاته) / رَكِبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا من الدواب)\nمثال: ركب ياني سفينة.",
 "じょうばぐつ": "حذاء ركوب الخيل (حذاء بدون أربطة يرتدى لركوب الخيل؛ جزء من زي الركوب)",
 "じょうばこ": "حافظة رسائل (حافظة لحمل الرسائل)",
 "じょうばたい": "مَوْكِب خَيَّالَة (موكب من الناس يسافرون على ظهور الخيل)",
 "じょうばふく": "بدلة ركوب الخيل (الملابس التي يرتديها عادة راكب الخيل (وخاصة زي المرأة))",
 "じょうばり": "عَنِيد",
 "じょうばん": "حَارِس",
 "じょうばズボン": "بنطال ركوب الخيل, جودبور ((تستخدم بصيغة الجمع) سراويل واسعة تنتهي عند الساق؛ تلبس مع أحذية الركوب)",
 "じょうひ": "نَسِيج طِلَائِيّ",
 "じょうひさいぼう": "خلية طلائية, خلية ظهارية (واحدة من الخلايا المتراصة التي تشكل النسيج الطلائي)",
 "じょうひそしき": "ظهارة, نسيج طلائي (نسيج غشائي يغطي الأعضاء الداخلية والأسطح الداخلية الأخرى للجسم)",
 "じょうひん": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة. / رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "じょうび": "مَنْزِلَة, مَكَانَة",
 "じょうびきん": "حساب احتياطي, صندوق احتياطي (أموال مقتطعة من الأرباح لتوفير المدفوعات المستقبلية المتوقعة)",
 "じょうびぐん": "جيش نظامي (جيش دائم من الجنود مدفوعي الأجر)",
 "じょうびけし": "إِطْفَائِيّ",
 "じょうふ": "عَاشِق, عَاشِقَة / مُغْرَم / بَطَل, بَطَلَة / مَدِينَة, قَرْيَة",
 "じょうふくぶ": "شرسوف, منطقة فوق المعدة (المنطقة الواقعة على أو فوق المعدة (أسفل عظم القص مباشرة))",
 "じょうふくぶあっぱくほう": "ضَغْطَات البَطْن, مُناوَرَة هَيْمْلِيك",
 "じょうぶ": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / صَحِيح, سَلِيم / صِحِّيّ (ما ينفع الصحة)\nمثال: لازمك تعمل حجر صحي.",
 "じょうぶく": "رُقْيَة",
 "じょうぶくろ": "مُغَلَّف, لِفَافَة / غِلَاف",
 "じょうぶこうぞう": "بنية فوقية (هيكل يتكون من جزء السفينة الموجود فوق السطح الرئيسي)",
 "じょうぶじまく": "ترجمة علوية (ترجمة كلمات أوبرا أجنبية (أو عمل كورالي) تُعرض على شاشة فوق المسرح)",
 "じょうぶつ": "تكرار زائد, حشو (تكرار فعل ما بلا حاجة) / زيادة, فائض (سمة كون الشيء زائداً وغير مطلوب) / تكرار احتياطي ((إلكترونيات) تصميم نظام يكرر المكونات لتوفير بدائل في حالة فشل أحد المكونات) / تكرار زائد, حشو (تكرار الرسائل لتقليل احتمالية الأخطاء في الإرسال)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة / مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر",
 "じょうぶん": "تخلٍّ, تنازل (فعل التنازل؛ التضحية أو التخلي عن (ممتلكات أو حق أو لقب أو امتياز، إلخ)) / تكرار زائد, حشو (تكرار فعل ما بلا حاجة) / زيادة, فائض (سمة كون الشيء زائداً وغير مطلوب) / تكرار احتياطي ((إلكترونيات) تصميم نظام يكرر المكونات لتوفير بدائل في حالة فشل أحد المكونات) / تكرار زائد, حشو (تكرار الرسائل لتقليل احتمالية الأخطاء في الإرسال)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة / رِسَالَة, مِيسِيج",
 "じょうぶんすう": "كَسْر حَقِيقِيّ (كسر يكون بسطه أصغر من مقامه)",
 "じょうへいそう": "مَخْزَن الْحُبُوب, شُونَة",
 "じょうへき": "مِتْرَاس",
 "じょうへん": "أعلى, قمة (الجانب الأعلى أو الأرفع لأي شيء)\nمثال: ضع كتبك على سطح المكتب / شَرِيط / قِطَاع / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "じょうべい": "خُبْز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / عيش (مصدر للفعل عَاشَ؛ هو الحَيَاة) / خُبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / خبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / قرص / خَبَزَ (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب)\nمثال: هذا الخبز لذيذ.",
 "じょうべき": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة, طَاقَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / طَاقَة كَهْرَبَائِيَّة, طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: توم شعر بالقوة.",
 "じょうほ": "امتياز (عقد يمنح الحق في تشغيل عمل فرعي) / إذعان, تنازل (فعل التنازل أو الإذعان) / تنازل (نقطة يتم التنازل عنها أو التسليم بها)\nمثال: حصل على امتياز البيرة في ملعب الكرة / مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص)) / تمشّى / مَسِير, سِيرَة / مِشْيَة\nمثال: مشى ياني مع سكورا.",
 "じょうほう": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / مَعْلُومَات, مَعْلُومَة\nمثال: この情報は正しいか。 — هل هذه المعلومة صحيحة؟ / مَعْلُومَات, مَعْلُومَة / مَعْلُومَاتِيَّة",
 "じょうほうか": "حوسبة (التحكم في العمليات بواسطة الحاسوب)",
 "じょうほうかがく": "علم المعلومات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "じょうほうがく": "مَعْلُومَاتِيَّة",
 "じょうほうきかん": "وَكَالَةْ اِسْتِخْبَار",
 "じょうほうきき": "نظام المعلومات (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "じょうほうきょく": "وَكَالَةْ اِسْتِخْبَار",
 "じょうほうぎじゅつ": "تِقْنِيَّة مَعْلُومَات, تِكْنُولُوجِيَا مَعْلُومَات",
 "じょうほうこうかんようアメリカひょうじゅんコード": "أسكي, الشيفرة المعيارية الأمريكية لتبادل المعلومات ((علم الحاسوب) شيفرة لتبادل المعلومات بين الحواسيب المصنوعة من قبل شركات مختلفة؛ حيث تمثل سلسلة من 7 أرقام ثنائية كل حرف)",
 "じょうほうこうがく": "عِلْم الْحَاسُوب, حَاسُوبِيَّات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "じょうほうしゅうしゅう": "جمع المعلومات (فعل جمع المعلومات)",
 "じょうほうしょうこう": "ضَابِطُ اِسْتِخْبَارَات",
 "じょうほうしょり": "مُعَالَجَة البَيَانَات",
 "じょうほうしょりぎじゅつしゃ": "علم المعلومات, معلوماتية (العلوم المعنية بجمع ومعالجة وتخزين واسترجاع وتصنيف المعلومات المسجلة)",
 "じょうほうしょりしんこうじぎょうきょうかい": "أصد ((أَصَّدَ) الثَّوْب: جعله أُصدة؛ (أَصَّدَ) الْجَارِيَة وَنَحْوهَا: ألبسها الأصدة)",
 "じょうほうしょりしんりがく": "علم المعلومات, معلوماتية (العلوم المعنية بجمع ومعالجة وتخزين واسترجاع وتصنيف المعلومات المسجلة)",
 "じょうほうしょりそうち": "علم المعلومات, معلوماتية (العلوم المعنية بجمع ومعالجة وتخزين واسترجاع وتصنيف المعلومات المسجلة)",
 "じょうほうじだい": "عصر المعلومات (فترة بدأت في الربع الأخير من القرن العشرين عندما أصبحت المعلومات متاحة بسهولة من خلال المنشورات ومن خلال معالجة المعلومات بواسطة أجهزة الكمبيوتر…)",
 "じょうほうすじ": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "じょうほうせん": "حَرْب مَعْلُومَات (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "じょうほうせんそう": "حَرْب مَعْلُومَات (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "じょうほうせんでん": "عَلَاقَات عَامَّة",
 "じょうほうそうさ": "رَدَنَ, غَزَلَ (رَدَنَ رَدْنًا: غزل الرَّدَن أو غزل بالمِردَن؛ ويقال: رَدَنَ الثوبَ: نسجه بالغزل المردون)",
 "じょうほうつう": "مُطَّلِع",
 "じょうほうつうしん": "اتصالات سلكية ولاسلكية (فرع الهندسة الكهربائية المعني بتكنولوجيا الاتصالات الإلكترونية عن بعد) / اتصالات, اتصالات عن بعد ((غالباً بصيغة الجمع) الأنظمة المستخدمة في نقل الرسائل عبر مسافات إلكترونياً)",
 "じょうほうていきょうしゃ": "مُخْبِر, مُخْبِرة / مُخْبِر",
 "じょうほうほご": "أمن المعلومات (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن.",
 "じょうほうりょう": "مباغتة, مفاجأة (فعل مفاجأة شخص ما)",
 "じょうほうりょうがおおい": "إِخْبَارِيّ, إِعْلَامِيّ",
 "じょうほうりょうのおおい": "إِخْبَارِيّ, إِعْلَامِيّ",
 "じょうほうりろん": "نظريَة المعلومات (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية.",
 "じょうほうシステム": "نظام المعلومات (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "じょうほうシステムがく": "نظام المعلومات (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "じょうほうスーパーハイウェイ": "الطريق السريع للمعلومات (شبكة إلكترونية واسعة (مثل الإنترنت) تستخدم للنقل السريع للصوت والفيديو والرسومات في شكل رقمي)",
 "じょうほうセキュリティ": "أمن المعلومات (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن.",
 "じょうほうチャネル": "خط اتصال, قناة اتصال ((غالباً الجمع) وسيلة للاتصال أو الوصول)\nمثال: يجب أن تمر عبر القنوات الرسمية",
 "じょうほうテクノロジー": "تِقْنِيَّة مَعْلُومَات, تِكْنُولُوجِيَا مَعْلُومَات",
 "じょうほうハイウェイ": "الطريق السريع للمعلومات (شبكة إلكترونية واسعة (مثل الإنترنت) تستخدم للنقل السريع للصوت والفيديو والرسومات في شكل رقمي)",
 "じょうぼ": "خَمِيرَة / حَمَاة",
 "じょうぼく": "مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء) / نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / مَنْشُور\nمثال: نشر توم الغسيل. / سقفية, ظلة (غطاء (عادة من القماش) يعمل كسقف لحماية منطقة ما من الطقس) / مظلة (الجزء الذي يشبه المظلة في الباراشوت والذي يمتلئ بالهواء) / قبة الطائرة (الغطاء الشفاف لمقصورة الطائرة)",
 "じょうまい": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "じょうまえ": "قُفْل (أَغْلَقَ أو سَدَّ البابَ أو الشَّيْءَ؛ في بعض السياقات: عادَ أو رجَعَ إلى مكانه أو بدايته) / هَوِّيس / أَقْفَلَ / ذُؤَابَة\nمثال: يحاول توم كسر القفل.",
 "じょうまえや": "قَفَّال, قَفَّالَة",
 "じょうまん": "إطناب, حشو (أسلوب تعبيري يستخدم كلمات مفرطة أو فارغة)",
 "じょうみ": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "じょうみゃく": "وَرِيد, عِرْق",
 "じょうみゃくあつ": "ضغط وريدي (الضغط الممارس على جدران الأوردة بواسطة الدم الدائر)",
 "じょうみゃくえん": "التهاب الوريد (التهاب الوريد (عادة في الساقين))",
 "じょうみゃくけっせんしょう": "تخثر وريدي (تخثر الوريد دون التهاب سابق للوريد؛ يرتبط ببطء تدفق الدم (كما في الراحة الطويلة في الفراش أو الحمل أو الجراحة) أو بتخثر سريع للدم)",
 "じょうみゃくけつ": "دم وريدي (الدم الموجود في الأوردة)\nمثال: باستثناء الوريد الرئوي، يكون الدم الوريدي غنياً بثاني أكسيد الكربون وفقيراً بالأكسجين",
 "じょうみゃくせんし": "بزل الوريد, فصد ((طب) ثقب الوريد عبر الجلد لسحب الدم للتحليل أو لبدء تقطير وريدي أو لحقن الدواء)",
 "じょうみゃくちゅうしゃ": "حقن وريدي (حقنة في الوريد)",
 "じょうみゃくどう": "جيب وريدي (قناة واسعة تحتوي على الدم؛ ليس لها غطاء مثل الأوعية الدموية العادية)",
 "じょうみゃくない": "داخل الوريد, وريدي (داخل الوريد أو عن طريقه)\nمثال: التهاب وريدي",
 "じょうみゃくますいやく": "مخدر وريدي (مخدر ينتج التخدير عند حقنه في الدورة الدموية)",
 "じょうみゃくりゅう": "دوالي (وعاء دموي أو وعاء لمفاوي متضخم أو ملتوي بشكل غير طبيعي)",
 "じょうみん": "الْجَمَاهِير, العَامَّةُ / نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "じょうむ": "مدير (شخص يتحكم في الموارد والنفقات)",
 "じょうむいん": "عضو طاقم (عضو في طاقم عمل) / عضو طاقم (عضو في طاقم طائرة)",
 "じょうむとりしまりやく": "مدير (شخص يتحكم في الموارد والنفقات)",
 "じょうめん": "قِمَّة",
 "じょうもく": "مَقَال, مَقَالَة / أَدَاةُ تَعْرِيف, أَدَاةُ التَّعْرِيف / مادّةٌ, مَوَادُّ (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / فوق رتبة ((في الأحياء) مجموعة تصنيفية تقع فوق الرتبة وتحت الطائفة أو الطويئفة)",
 "じょうもん": "فوق شعبة ((في الأحياء) مجموعة تصنيفية تقع بين الشعبة وتحت الطائفة أو الطويئفة)",
 "じょうやく": "مُعَاهَدَة, مُقَاوَلَة (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "じょうやくかめいこく": "مُوقّع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "じょうやくこう": "ميناء معاهدة (ميناء في الصين أو كوريا أو اليابان كان مفتوحًا للتجارة الخارجية بموجب معاهدة تجارية)",
 "じょうやとい": "بَدَوَام كَامِل (لعدد الساعات القياسي) / بدوام كامل (لكامل الوقت المناسب لنشاط ما)\nمثال: تعمل بدوام كامل",
 "じょうやど": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "じょうよ": "فَائِض / بَقِيَّة / حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / اِنْتِقَال\nمثال: رقصنا حول النار.",
 "じょうようしゃ": "سَيَّارَة, عَرَبِيَّة (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة. / مُدْمِن, مُدْمِنَة",
 "じょうようじどうしゃ": "أوتوبيس, باص (مركبة تحمل العديد من الركاب؛ تستخدم للنقل العام)\nمثال: كان دائماً يركب الحافلة للعمل",
 "じょうようたいすう": "لوغاريتم عشري (لوغاريتم للأساس 10)",
 "じょうようへき": "إِدْمَان",
 "じょうよきん": "فَائِض",
 "じょうよく": "عَاطِفَة, شَغْف / عَزْم / شَغَف (المرضُ فلانًا: وصل المرض شِغاف قلبه فالقلب عليل فيه مرض؛ الحبُّ فلانًا: وصل إلى شِغَاف قلبه. وقيل: دخل الحب تحت الشغاف. وقيل: غشى القلب تماما)\nمثال: قبل توم ماري بشغف.",
 "じょうらん": "إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما) / شِجَار عَلَنِيّ, عِرَاك (قتال صاخب) / إزعاج, اضطراب (نشاط يمثل خللاً أو تطفلاً أو انقطاعاً) / تداخل, تشويش (نشاط كهربائي أو صوتي يمكن أن يزعج الاتصالات)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي",
 "じょうり": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / زوري (صندل يثبت في القدم بواسطة شريط فوق الأصابع) / صَالَة, حَلْبَة (مكان فسيح في وسط المسكن يُوصِلُ إلى سائر الحجرات، الرُدْهَة؛ غُرْفَةُ المَعِيْشَة سواء كانت توصل إلى سائر الحجرات أم لا وسواء كانت فسيحة أم لا)\nمثال: حجزت الصالة يوم الخميس.",
 "じょうりく": "هُبُوط / بَسْطَة",
 "じょうりくきゅうか": "إجازة الشاطئ (إجازة تُمنح لبحار أو ضابط بحري)",
 "じょうりくきょか": "إجازة الشاطئ (إجازة تُمنح لبحار أو ضابط بحري)",
 "じょうりくようしゅうてい": "سفينة إنزال, مركبة إنزال (مركبة بحرية مصممة لإنزال القوات والمعدات على الشاطئ)",
 "じょうりゅう": "ضد التيار, نحو المنبع (نحو المصدر أو عكس التيار) / ضد التيار, عكس التيار (في الاتجاه المعاكس لتيار النهر) / الطَّبَقَة الْعُلْيَا / تَقْطِير",
 "じょうりゅうかいきゅう": "الطَّبَقَة الْعُلْيَا",
 "じょうりゅうき": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "じょうりゅうしゃかい": "الطَّبَقَة الْعُلْيَا",
 "じょうりゅうしゅ": "كُحُول, خَمْر (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول.",
 "じょうりゅうしょ": "معمل تقطير, مقطرة (مصنع ومنشآت يتم فيها صنع المشروبات الكحولية عن طريق التقطير)",
 "じょうりゅうじょ": "معمل تقطير, مقطرة (مصنع ومنشآت يتم فيها صنع المشروبات الكحولية عن طريق التقطير)",
 "じょうりゅうすい": "ماء مقطر (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "じょうりょく": "دائم الخضرة ((عن النباتات والشجيرات) تحمل أوراق الشجر طوال العام) / نبات دائم الخضرة (نبات له أوراق تدوم وتظل خضراء طوال العام)",
