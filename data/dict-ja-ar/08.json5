 "はかが行く": "يقرب",
 "はかき": "بُلُوغ",
 "はかく": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ / شَاذّ, غَيْر مُنْتَظِم",
 "はかしょ": "مَقْبَرَة, مَقْبُرَة",
 "はかせごう": "دُكْتُورَاة (الدُّكْتوراة : دَرَجة دُكْتُور ولَقَبه؛ الدُّكْتُورَاه :أَعْلى مُؤهِّل جامعيّ، أعلى شهادة جامعيَّة، أو أَعْلَى شَهادَةٍ جامِعِيَّةٍ تُمْنَحُ بَعْدَ شَهادَةِ الإِجازَةُ (الْلِيسانْسِ) لِمَنْ…)",
 "はかち": "مَقْبَرَة, مَقْبُرَة",
 "はかどころ": "مَقْبَرَة, مَقْبُرَة",
 "はかどる": "يقرب",
 "はかない": "أُسْطُول (الأسطول مجموعة من السفن تعد للحرب أو للنقل؛ جمع اساطيل ويقال مجموعة الطائرات: اسطول جوي) / فَارِغ / فَرَغَ",
 "はかなくなる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "はかば": "مَقْبَرَة, مَقْبُرَة",
 "はかばかしい": "سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي.",
 "はかま": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "はかまじ": "تَنُّورَة, جُوب",
 "はからい": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "はからう": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / نَصَحَ (نصحه: أَرْشَدَه وأَشَارَ عليه) / اِسْتَشَارَ\nمثال: نصح مناد بباية.",
 "はからずも": "صُدْفَةً, بِصُدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة.",
 "はかり": "مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل)",
 "はかりごと": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "はかりしる": "فَرَضِيَّة, اِفْتِرَاض (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة) / تَخْمِين\nمثال: الحقائق تؤكد هذه الفرضية.",
 "はかりしれない": "لَا يُقَاسُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "はかりめ": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "はかり知る": "فَرَضِيَّة, اِفْتِرَاض (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة) / تَخْمِين\nمثال: الحقائق تؤكد هذه الفرضية.",
 "はかり知れない": "لَا يُقَاسُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "はかる": "نَاقَشَ, بَحَثَ",
 "はがい": "جَنَاح",
 "はがき": "كَرْت بَرِيدِيّ / مُلَاحَظَة, مَلْحُوظَة / مُذَكَّرَة / دَرَجَة",
 "はがね": "فُولَاذ / سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة) / سَيَّافٌ\nمثال: القلم أقوى من السيف.",
 "はがみ": "صرير الأسنان",
 "はがゆい": "فَشَّلَ (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل)\nمثال: فشل ياني مجددا.",
 "はがれ": "تَقْشِير",
 "はき": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة. / مَطْمَح",
 "はきかえる": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "はきかける": "سَفُّود, سِيخ / بَصَقَ, بَزَقَ (بَصَقَ من باب نَصَرَ؛ لفظ مَا فِي فَمه) / بُزَاق",
 "はきけ": "غَثْيَان (جاشت النفس واضطربت واستعدت للقَيء؛ الاِشْمِئْزَاز والقَرَف)\nمثال: كنت أشعر بالغثيان.",
 "はきげ": "غَثْيَان (جاشت النفس واضطربت واستعدت للقَيء؛ الاِشْمِئْزَاز والقَرَف)\nمثال: كنت أشعر بالغثيان.",
 "はきすてる": "قَذَفَ نَفْسَهُ (بمعنى رَمَى؛ قذَف بالحقّ: أمر به وأبانه)",
 "はきだす": "تَقَيَّأَ, قَاءَ / تَقَيُّؤ / زَفَرَ (زفَر الشَّخصُ : أخرج نفَسه من رئتيه بعد مدِّه إيّاه؛ أظهر تعبيرًا عن الحزن أو الألم من خلال تنهد أو صوت عميق) / أَنْفَقَ, صَرَفَ / قَضَى / مُخرَج / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة.",
 "はきちがえる": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "はきつわり": "غَثَيَان الحَمْل (جاشت النفس واضطربت واستعدت للقَيء؛ الاِشْمِئْزَاز والقَرَف)\nمثال: كنت أشعر بالغثيان.",
 "はきづわり": "غَثَيَان الحَمْل (جاشت النفس واضطربت واستعدت للقَيء؛ الاِشْمِئْزَاز والقَرَف)\nمثال: كنت أشعر بالغثيان.",
 "はきはき": "بخفَة",
 "はきもどし": "قَيْءُ, اِسْتِفْرَاغ",
 "はきもどす": "تَقَيَّأَ, قَاءَ / تَقَيُّؤ",
 "はきもの": "حِذَاء, مَشَّايَة (بمعنى الإزاء والجوار؛ النَعْل)\nمثال: أردت حذاء أحمر.",
 "はきゃく": "هَدْم (الثوبُ ٱلْخَلَقُ المُرَقَّعُ؛ الكِساءُ الذي ضُوعِفت رِقَاعُهُ)\nمثال: توم يرسم خطة لهدم المنزل.",
 "はきゅう": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "はきょう": "طَلَاق, تَطْلِيق / طَلَّقَ (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ) / أَطْلَقَ\nمثال: طلق زيري زوجته.",
 "はきょく": "كَارِثَة, فَاجِعَة / نَكْبَة, فَاجِعَة / اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "はき違える": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "はぎ": "قَصَبَة / شِين",
 "はぎごと": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة) / اِحْتِفَال, مِهْرَجَان (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "はぎしり": "صرير الأسنان",
 "はぎめ": "دَرْز (درز:درزا تمكن من درز الدُّنْيَا؛ دَرِزَ الرجلُ، كفَرِح، وَكَذَلِكَ ذَرِزَ، بالدّالِ والذّالِ، إِذا تمَكَّن مِنْهَا أَي من نَعيمِها)",
 "はぎょう": "هَيْمَنَة, سَيْطَرَة",
 "はぎれいい": "شَفَّاف / وَاضِح",
 "はぎれがいい": "شَفَّاف / وَاضِح",
 "はぎれがよい": "شَفَّاف / وَاضِح",
 "はぎれのいい": "شَفَّاف / وَاضِح",
 "はぎれのよい": "شَفَّاف / وَاضِح",
 "はぎれよい": "شَفَّاف / وَاضِح",
 "はく": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة.",
 "はくあ": "طَبْشُورَة",
 "はくあい": "مُنَظَّمَة خَيْرِيَّة / صَدَقَة / إِحْسَان",
 "はくあいか": "سَخِيّ ((سَخِيَ) سَخاً: كَانَ جوادًا كَرِيمًا؛ (سَخِيَت) نَفسه عَن الشَّيْء: تركته)\nمثال: هو سخي بأمواله.",
 "はくあいしゅぎしゃ": "سَخِيّ ((سَخِيَ) سَخاً: كَانَ جوادًا كَرِيمًا؛ (سَخِيَت) نَفسه عَن الشَّيْء: تركته)\nمثال: هو سخي بأمواله.",
 "はくあかん": "الْبَيْت الْأَبْيَض / بَيْت أَبْيَض (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "はくあしつ": "أَسْمَنْت / سَمْنَتَ",
 "はくいのてんし": "مُمَرِّض / مُمَرِّضَة / ممرض / أَرْضَعَ ((أَرْضَعَت) الْأُم: كَانَ لَهَا ولد تُرْضِعه؛ (أَرْضَعَت) الْولد: جعلته يرضع فَهِيَ مرضع ومرضعة (ج) مراضع) / مَرَّضَ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "はくうんも": "مُوسْكُوفِيّ",
 "はくか": "مَادَّة تَبْيِيض (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / بَيَّضَ (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: لا أحب مادة العلوم.",
 "はくかげんしょう": "مَادَّة تَبْيِيض (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / بَيَّضَ (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: لا أحب مادة العلوم.",
 "はくかこたい": "أَمْهَق",
 "はくがい": "اِضْطِهَاد",
 "はくがくしゃ": "عَلَّامَة, بحر العلوم (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "はくぎ": "لعبة حظ (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "はくぎょくろうちゅうのひととなる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "はくぎん": "فِضَّة (فِي : فِلِزّ أَبْيَض قَابِلٌ لِلسَّحب والطَّرْق والصَّقْل، من أكثر المواد توصيلاً للحَرَارَة والكَهْرَبَاء…) / فِضِّيّ, لُجَيْن\nمثال: يقدر القبايل الفضة أكثر من الذهب. / ثَلْج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / تلج / ثلج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / أَثْلَجَ (أثلج يومُنا: دخل في الثلج؛ أثلجت الأرض: أصابها الثلج)\nمثال: سامي يحب الثلج.",
 "はくげきほう": "مِلَاط / مِهْرَاس, هَاوُن / هَاوُن, مِدْفَعُ الهَاوُن / هَاوُن",
 "はくげんがく": "لِسَانِيَّات, عِلْم اللُّغَة",
 "はくこく": "الْبَرَازِيل / كونتِيّة / مُحَافَظَة, مُقَاطَعَة (تقسيم إداري في أرض دولة؛ المؤنث من \"مُحَافَظ\")\nمثال: نشأت ليلى في بلدة محافظة.",
 "はくし": "خَرْبَشَ",
 "はくしいにん": "تَفْوِيض مُطْلَق, ضَوْء أَخْضَر",
 "はくしいにんじょう": "تَفْوِيض مُطْلَق, ضَوْء أَخْضَر",
 "はくしき": "تَعَلَّمَ (اكتسب معرفة أو خبرة أو مهارة) / اِعْتَبَرَ, اِتَّعَظَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين)\nمثال: هو سريع التعلم.",
 "はくしごう": "دُكْتُورَاة (الدُّكْتوراة : دَرَجة دُكْتُور ولَقَبه؛ الدُّكْتُورَاه :أَعْلى مُؤهِّل جامعيّ، أعلى شهادة جامعيَّة، أو أَعْلَى شَهادَةٍ جامِعِيَّةٍ تُمْنَحُ بَعْدَ شَهادَةِ الإِجازَةُ (الْلِيسانْسِ) لِمَنْ…)",
 "はくしじょうたい": "صَفْحَة بَيْضَاء",
 "はくしゃ": "مِهْمَاز / تَسَارُع (عَجَلَة، تزايُد السرعة بالنسبة إلى الزمن في جسم من الأَجسام المتحرِّكة؛ إِسْرَاعٍ وَتَسَابُقٍ فِي الجَرْيِ)\nمثال: تسارع السائق بسيارته.",
 "はくしゃがかかる": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "はくしゃく": "عَدَّ / كُونْت",
 "はくしゃをかける": "مِهْمَاز",
 "はくしゅ": "تَصْفِيق",
 "はくしゅう": "خَرِيف, خريف (فصل من فصول السَّنَة الأربعة، بعد الصَّيْف وقبل الشِّتَاء؛ سَنَة)\nمثال: نحن في الخريف الآن.",
 "はくしゅかっさい": "تَصْفِيق",
 "はくしゅく": "أَخ / شَقِيق (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب) / إخوات / أخ / أخو\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "はくしゅをおくる": "صَفَّقَ",
 "はくしょく": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا) / قَوْقَازِيّ, يَافِثِيّ / أَبْيَض, بَيْضَاء (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون يعتبر مجموع كل الألوان في الطيف الشمسيّ. انظر الصورة؛ صفة ما كان لونه أبيضًا)\nمثال: هذا الكلب أبيض.",
