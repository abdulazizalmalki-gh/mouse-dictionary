 "しんりせん": "حرب أعصاب, حرب نفسية (استخدام تكتيكات نفسية لتدمير معنويات الخصوم)",
 "しんりせんそう": "حرب أعصاب, حرب نفسية (استخدام تكتيكات نفسية لتدمير معنويات الخصوم)",
 "しんりそくていがく": "سيكومتريا, قياس نفسي (أي فرع من فروع علم النفس المعني بالقياسات النفسية)",
 "しんりつ": "اِخْتَلَجَ, اِرْتَجَفَ",
 "しんりてき": "سَيْكُولُوجِيّ, نَفْسَانِيّ (عقليّ أو عاطفيّ بطبيعته لا جسديّ)\nمثال: نظريات نفسية",
 "しんりてきかしぶっけん": "عَقَار (الاسم من العَقْر، وهو القَطْع نهائيا؛ كل مُلْك ثابت له أصْل كالأرْض والدَار…)\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "しんりゃく": "غَزْو, إِغَارَة (أَغَارَ عَلَى العَدُوِّ غَزْواً : سَارَ إِلَى مُحَارَبَتِهِ وَقِتَالِهِ فِي…)\nمثال: الصين مستعدة لغزو تايوان.",
 "しんりゃくしゃ": "غَازٍ, الْغَازِي",
 "しんりゃくしゅ": "نَوْعٌ مُجْتَاحٍ (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر.",
 "しんりゃくてき": "عُدْوَانِيّ",
 "しんりょ": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها / فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "しんりょう": "رعاية طبية, عناية طبية (علاج احترافي للمرض أو الإصابة)",
 "しんりょうかんごし": "ممرضة ممارسة (ممرضة مسجلة تلقت تدريباً خاصاً ويمكنها أداء العديد من واجبات الطبيب)",
 "しんりょうしょ": "عِيَادَة, مَصَحَّة",
 "しんりょうじょ": "عِيَادَة, مَصَحَّة",
 "しんりりゅうほ": "تحفظ, تحفظ ذهني (شك غير معلن يمنعك من قبول شيء ما بقلب خالص)",
 "しんりりょうほう": "علاج نفسي (علاج المشاكل العقلية أو العاطفية بوسائل نفسية)",
 "しんりりょうほうか": "معالج نفسي (معالج يتعامل مع الاضطرابات العقلية والعاطفية)",
 "しんりりょうほうし": "معالج نفسي (معالج يتعامل مع الاضطرابات العقلية والعاطفية)",
 "しんりりんしょうか": "عِلْم نَفْس سَرِيرِيّ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "しんりん": "غَابَة, غابة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا…)\nمثال: مشينا في الغابة",
 "しんりんおおかみ": "ذئب الغياض, ذئب رمادي (ذئب ذو معطف رمادي مبقع يعيش في المناطق الشمالية المشجرة في أمريكا الشمالية)",
