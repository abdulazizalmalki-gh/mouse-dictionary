 "のんでかかる": "اِسْتَخَفَّ, اِسْتَهَانَ / اِسْتَبَدَّ (حزم ولم يتردد في اتخاذ القرار وتنفيذه؛ (في السياسة) حكم بنظام استبدادي)",
 "のんど": "حَلْق, حُلْقُوم (أصاب حَلْقه أو ضربه في حلقه؛ أزال شعر رأسه أو ذقنه كله بالمُوسَى)\nمثال: حلق زيري لحيته. / مِزْراب (قناة صرف لمياه الأمطار والثلوج؛ نظام يحدّ من جريان المياه على الأسطح الخارجية للمبنى)",
 "のんどり": "اِسْتَرْخَى",
 "のんの": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "のんのん": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "のんびり": "بِهُدُوء / اِسْتَرْخَى",
 "のんべえ": "مُعَاقِر الخَمْر, شَارِب الخَمْر",
 "のんれん": "سُمْعَة, شُهْرَة",
 "の余り": "اِسْتَبَدَّ (حزم ولم يتردد في اتخاذ القرار وتنفيذه؛ (في السياسة) حكم بنظام استبدادي)",
 "の様に": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال.",
 "は": "رِيش, رِيشَة (رَيَّشَ السَّهْمَ: راشهُ؛ رَيَّشَ الثَّوْبَ: زَيَّنَهُ بِصُوَرِ الرِّيش)\nمثال: هل عنده ريشة رسم؟ / جَنَاح / نَصْل (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة الحادّة الجارحة)\nمثال: لن نصل إلى أي مكان. / رِيشَة",
 "はぁ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はぁっ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はぁー": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はぁーっ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はあ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はあく": "قَبْضَة",
 "はあっ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はあー": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はあーっ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَنَهَّدَ / تَنَهُّد",
 "はい": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / مَفْهُوم / حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / الْآنَ, حَالًا (في هذا الوقت الحالي) / بِمَا أَنّ, أَمَا وَأَنّ\nمثال: نحن بمأمن الآن.",
 "はい、はい": "أَيّ, أَيَّمَا (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / مَهْمَا مَا / طُز\nمثال: لم تقصد أي أذى. / بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "はいあがる": "هَزَمَ, غَلَبَ",
 "はいいし": "ربيطة",
 "はいいろ": "رَمَادِيّ, أَشْيَب",
 "はいいろぐま": "دُبّ أَشْهَب, دُبَّة شَهْبَاء",
 "はいいろののうさいぼう": "عَقْل, فِطْنَة (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "はいえき": "تَصْرِيف",
 "はいえん": "ذَات اَلرِّئَة, اِلْتِهَاب رِئَوِيّ",
 "はいか": "تَابِع / مُتَابِع",
 "はいかい": "عَبَثِيّ, سَخِيف",
 "はいかきょう": "زرادشتِيَّة",
 "はいかきょうと": "زَرَادُشْتِيّ, زَرَادَشْتِيّ",
 "はいかぶり": "سِنْدِرِيلَا",
 "はいかん": "سِبَاكَة",
 "はいかんこう": "سَبَّاك",
 "はいかんこうぎょう": "سِبَاكَة",
 "はいかんこうじ": "سِبَاكَة",
 "はいかんしゃ": "زَائِر / زَائِر, سَائِح",
 "はいが": "جُرْثُومَة",
 "はいがいしそう": "رُهَاب الْأَجَانِب, كَرْه الْأَجَانِب",
 "はいがいしゅぎ": "شُوفِينِيَّة / شُوفِينِّيَّة",
 "はいがいてき": "حَصْرِيّ",
 "はいがら": "رَمَاد, سَكَن / دَرْدَار",
 "はいがん": "سَرَطَان اَلرِّئَة",
 "はいき": "هِجْرَان, هُجْرَان / إِلْغَاء",
 "はいきかん": "أُنْبُوبُ ٱلْعَادِمِ",
 "はいきこう": "نَفَّسَ, هَوَّى (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…) / نَفَّسَ عَن (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "はいきとう": "مَدْخَنَة",
 "はいきぶつ": "زُبَالَة / نُفَايَات (بقيَّة؛ ما زاد على الحاجة) / قُمَامَة / مُخَلَّفَات\nمثال: توم عامل نفايات.",
 "はいきゅう": "تَوْزِيع / حِصَّة / قَنَّنَ (قلل الكمية واقتصد بها؛ وضع الشيء في قَنَانِي)",
 "はいきゅうせい": "حِصَّة / قَنَّنَ (قلل الكمية واقتصد بها؛ وضع الشيء في قَنَانِي)",
 "はいきょ": "خَرَاب, خَرَابَة / دَمَّرَ",
 "はいきょう": "رِدَّة, اِرْتِدَاد",
 "はいきょうしゃ": "مُرْتَدّ",
 "はいきりょう": "إِزَاحَة, نُزُوح / إِزَاحَة",
 "はいぎょう": "تَقَاعَدَ / اِعْتَزَلَ",
 "はいく": "هَايْكُو",
 "はいぐう": "زَوْج, زَوْجَة (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة. / زَوْجَانِ",
 "はいぐうしゃ": "زَوْج, زَوْجَة (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "はいぐん": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "はいけい": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "はいけつしょう": "تَلَوُّث اَلْدَم (تَلَطُّخ، تَكَدُّر، قذارة ودنس يصيبان الجو أو الماء أو البيئة ويؤديان إلى تسمم أو أمراض؛ تَشَوُّه)\nمثال: التلوث يضر كوكبنا.",
 "はいけん": "بَصِير, مُبْصِر (بَصير؛ بَصُرَ: (فعل) بصُرَ / بصُرَ بـ يَبصُر ، بَصَرًا و بَصارَةً ، فهو بَصير ، والمفعول مبصور به) / رُؤْيَة\nمثال: パスポートを拝見できますか。 — هل لي أن أرى جواز سفرك؟",
 "はいげき": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "はいご": "خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / خلفية",
 "はいごう": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "はいごかんけい": "خلفية",
 "はいごれい": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "はいさい": "آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "はいさく": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "はいさつ": "خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "はいざい": "تَحِلَّة",
 "はいざら": "مِنْفَضَة, طَفَّايَة",
 "はいざん": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "はいし": "إِلْغَاء, اِبْطَال",
 "はいしゃ": "طَبِيب أَسْنَان, طَبِيبَة أَسْنَان (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "はいしゃく": "اِسْتَعَارَ (مجازي)\nمثال: استعار سامي مالا.",
 "はいしゃふっかつ": "رِيمُونْتَادَا",
 "はいしゅ": "جُرْثُومَة",
 "はいしゅつ": "إخْلَاء, تَخْلِيَة / إخْلَاء / تَفْرِيغ, تَخْلِيَة (تَفْريغُ الظروف: إخْلاؤُها)",
