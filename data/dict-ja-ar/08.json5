 "ねんじゅ": "مِسْبَحَة, سُبْحَة",
 "ねんじゅう": "دَائِمًا, أَبَدًا",
 "ねんじる": "أُمْنِيَّة / رَغْبَة / مُنْيَة / تَمَنَّى / أُهْزُوجَة, أَهَازِيج",
 "ねんず": "مِسْبَحَة, سُبْحَة",
 "ねんずる": "أُمْنِيَّة / رَغْبَة / مُنْيَة / تَمَنَّى / أُهْزُوجَة, أَهَازِيج",
 "ねんせい": "لَزِج / لُزُوجَة (مصدر الفعل \"لَزِجَ\"؛ (في الفيزياء) تماسكُ أجزاء المادّة السَّائلة بعضِها ببعض تماسكًا يقاوم سيولتَها بحيث لا يتغيّر شكلها بسهولة، كالقطران والعسل وغيرهما)",
 "ねんせいりつ": "لُزُوجَة (مصدر الفعل \"لَزِجَ\"؛ (في الفيزياء) تماسكُ أجزاء المادّة السَّائلة بعضِها ببعض تماسكًا يقاوم سيولتَها بحيث لا يتغيّر شكلها بسهولة، كالقطران والعسل وغيرهما)",
 "ねんだい": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "ねんだいき": "حَوْلِيَّات",
