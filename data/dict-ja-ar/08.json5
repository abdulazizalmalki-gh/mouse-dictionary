 "にしてからが": "مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "にしては": "لِأَنَّ / لِـ (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي) / لِأَجْل / لِـ, بِالنِّسْبَة لِـ (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي)",
 "にしても": "بِالرَغْم مِن / مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "にしねずみざめ": "لِيَّاءٌ",
 "にしゅうかん": "أُسْبُوعَان",
 "にしゅうめ": "تَنَاسُخُ الأَرْوَاحِ",
 "にしる": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَقَة، وهي أخص من المرَق)",
 "にしろ": "رَغْم أَنّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره.",
 "にしん": "مُلَاحَظَة",
 "にしんぎ": "شَجَرَة ثُنَائِيَّة (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "にしアジア": "غَرْب آسِيَا (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم)\nمثال: تغرب الشمس في الغرب.",
 "にしオーストラリアしゅう": "أُسْتْرَالِيَا الْغَرْبِيَّة, أُوسْتُرَالِيَا الْغَرْبِيَّة (دولة في أوقيانوسيا؛ اسمها الرسمي كومنولث أستراليا؛ (في الجيولوجيا) قارة أستراليا-غينيا الجديدة؛ تُعتبر غينيا الجديدة أيضًا جزءًا من قارة أستراليا جيولوجيًّا بما أنها تقع على الصفيحة التكتونية…)\nمثال: جين من أستراليا.",
 "にしゴート": "قُوطِيّ غَرْبِيّ",
 "にしサハラ": "الصَّحْرَاء الْغَرْبِيَّة",
 "にしドイツ": "أَلْمَانِيَا الْغَرْبِيَّة (دولة أوروبية في وسط أوروبا)\nمثال: ستعجبك ألمانيا.",
 "にしヨーロッパ": "أُورُوبَّا الْغَرْبِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة.",
 "にじ": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟",
 "にじげん": "خَيَالِيّ, مُتَخَيَّل",
 "にじせい": "ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة الأُُولى)\nمثال: ثانوية زيري ضخمة.",
 "にじっさい": "عِشْرُونَ",
 "にじてき": "ثَانَوِي (الثانويّ : المَنْسوب إلى الثاني ما يجيء بعدَ الأَوَّل؛ ما ليس له الأَهمّيَّة الأُُولى)\nمثال: ثانوية زيري ضخمة.",
 "にじのはしをわたる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "にじみ": "غَشَّى, غَبَّش / لَطَّخَ, بَقَّعَ (لوَّثَ الشيءَ بسائل أو مادة لزجة؛ أصابه بشيء من العيب أو السوء)",
 "にじむ": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض. / غَشَّى, غَبَّش / لَطَّخَ, بَقَّعَ (لوَّثَ الشيءَ بسائل أو مادة لزجة؛ أصابه بشيء من العيب أو السوء)",
 "にじゅ": "مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "にじゅう": "عِشْرُونَ",
 "にじゅうあご": "ذِقْن مُزْدَوِج, لُغْد (الجزء الناتىء البارز في أسفل الوجه تحت الفم، وهو منبت اللِحْيَة عند الرَجُل؛ كناية اللِحْيَة)",
 "にじゅうきじゅん": "كَيْلٌ بِمِكْيالَيْنِ, اِزْدِوَاجِيَّة الْمَعَايِير",
 "にじゅうきはん": "كَيْلٌ بِمِكْيالَيْنِ, اِزْدِوَاجِيَّة الْمَعَايِير",
 "にじゅうけっこん": "تَعَدُّد اَلْأَزْوَاج, تَعَدُّد اَلزَّوْجَات",
 "にじゅうしん": "شَبِيه",
 "にじゅうだい": "عِشْرُونَ",
 "にじゅうていこく": "النَّمْسَا وَٱلْمَجَر (دولة في أوروبا الوسطى؛ اسمها الرسمي جمهورية النمسا، وعاصمتها فيينا)\nمثال: النمسا بلد الكناغر.",
 "にじゅうひょうじゅん": "كَيْلٌ بِمِكْيالَيْنِ, اِزْدِوَاجِيَّة الْمَعَايِير",
 "にじゅうぼいん": "مُصَوِّت مُزْدَوِج",
 "にじゅうよんじ": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "にじゅうスパイ": "عَمِيل مُزْدَوِج (من تُعَامِله ويعاملك في التِجَارَة؛ وكيل التَاجِر في الجِهَات)\nمثال: سامي عميل فدرالي.",
 "にじゅっさい": "عِشْرُونَ",
 "にじゅんじて": "وَفْقًا لِ / طِبْقًا لِـ, وَفْقًا لِـ / بِالنِّسْبَة لِـ",
 "にじょう": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "にじょうこん": "جَذْر تَرْبِيعِيّ (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "にじょうべき": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "にじる": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَقَة، وهي أخص من المرَق)",
 "にすがた": "حُزْمَة, عُبُوَّة / وَضَّبَ / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: حزم ياني أمتعته.",
 "にすぎない": "عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "にせ": "تَقْلِيد / زائف",
 "にせい": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية. / اِبْن (الولد الذكر)\nمثال: هو له ابن صغير.",
 "にせいしゃ": "بَطْبَطَة, زَبْط / زَبَطَ",
 "にせくんし": "مُرَاءٍ, مُنَافِق",
 "にせじょうほう": "مَعْلُومَات مُضَلِّلَة",
 "にせもの": "كَذَّاب, كَذَّابَة",
 "にせもん": "تَقْلِيد",
 "にせよ": "بِالرَغْم مِن",
 "にせる": "نُسْخَة / اِنْتَسَخَ, نَسَخَ",
 "にせアカシア": "شَجَرَةُ الْجَرَادِ, سَنْطٌ كَاذِبٌ (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "にせ医者": "بَطْبَطَة, زَبْط / زَبَطَ",
 "にぜん": "قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قَبْلَ, أَمَامَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "にそう": "أخت (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على امرأة لا يعرفها تأدبا وإن كانت غريبة عنه)\nمثال: ماري هي أخت توم",
 "にそういん": "دَيْر, رَهْبَنَة نِسْوِيّ (بيت يسكنه الرُهْبَان أو الرَاهِبَات ممن كان على دين المسيحية)\nمثال: سيداتي و سادتي ، رجاء قفوا للنشيد الوطني للاتحاد الروسي باداء جوقة دير سرتينسكي .",
 "にそって": "عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل) / بِالتَّوَازِي مَعَ\nمثال: أجب على السؤال.",
 "にそなえて": "فِي حَال (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "にたいし": "نَحْوَ, صَوْبَ / نَحُو / لِأَجْل / بِقُرْب",
 "にたいして": "نَحْوَ, صَوْبَ / نَحُو / لِأَجْل / بِقُرْب",
 "にたいする": "بِالنِّسْبَة لِـ, بِالنِّسْبَة إِلَى",
 "にたき": "طَبْخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ.",
 "にたっと": "إِهْلَاس",
 "にたつ": "دُمَّل, خُرَاج / غَلَيَان, غَلْي / غَلَّى",
 "にたにた": "إِهْلَاس",
 "にたり": "مُزَيَّف / قَدَّاحَة, وَلَّاعَة",
 "にたりぶね": "قَدَّاحَة, وَلَّاعَة",
 "にだ": "حُزْمَة, عُبُوَّة / وَضَّبَ / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: حزم ياني أمتعته.",
 "にだいめ": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "にだしじる": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل.",
 "にだん": "ثُنَائِيّ / ضِعْف",
 "にだんかいにんしょう": "مُصَادَقَة ثُنَائِيَّة (إِخْلاَصٌ فِي الصَّدَاقَةِ؛ الإقرار والموافقة على الشيء)",
 "にだんベッド": "سَرِير بِطَابَقَيْن (قطعة أثاث للنوم والاستلقاء والجلوس؛ مسطبة من الخشب المزيَّن يوضع عليه كرسي، يغلب على ما تحت عرش الملك)\nمثال: قاس طول السرير.",
 "にち": "الْأَحَد, يَوْم الْأَحَد / الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "にちがい": "مَرَّةً, مَرَّةً وَاحِدَةً (مؤنث مُرّ، صفة ما كان بها مرارة) / بِمُجَرَّد أَنّ\nمثال: كم من مرة ذهبت؟",
 "にちげつ": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "にちご": "يَابَانِيّ",
 "にちじ": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "にちじょう": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "にちじょうせいかつ": "حَيَاة يَوْمِيَّة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "にちじょうせいかつどうさ": "أنشطة الحياة اليومية",
 "にちじょうてき": "دُنْيَوِيّ / عَادِيّ / مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "にちにち": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ / أَيَّام / يَوْمًا بَعْدَ يَوْم",
 "にちべつ": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "にちぼつ": "غُرُوب, مَغْرِب (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / غُرُوب اَلشَّمْس (المَغْرِب، أيْ الوَقْت الذي تَغْرُبُ فيه الشَمْس) / خَاتِمَة, قَيَامَة\nمثال: نحب غروب الشمس.",
 "にちゃく": "وَصِيفَة",
 "にちや": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "にちょっかく": "زَاوِيَة مُسْتَقِيمَة",
 "にちよう": "الْأَحَد, يَوْم الْأَحَد\nمثال: 銀行は日曜にはやってません。 — لا يكون المصرف مفتوحاً أيام الأحد.",
 "にちようび": "الْأَحَد, يَوْم الْأَحَد",
 "にちりん": "شَمْس, شمس (الشَّمْسُ: النَّجْمُ الرئيسُ الذي تدور حوله الْأَرْض، وسائر كواكب المجموعة الشمسية؛ الشَّمس: اسم سورة من سور القرآن الكريم، وهي السُّورة رقم 91 في ترتيب المصحف، مكِّيَّة، عدد آياتها خمس عشرة آية) / مثال: نحب غروب الشمس.",
