 "に對して": "نَحْوَ, صَوْبَ / نَحُو / لِأَجْل / بِقُرْب",
 "に對する": "بِالنِّسْبَة لِـ, بِالنِّسْبَة إِلَى",
 "に当たっては": "فِي مَا يَتَعَلَق بِـ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "に影響されて": "فِي أَعْقَاب, عَلَى أَثَرِ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / عَلَى إِثْرِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: جون في عمر أخي.",
 "に従い": "وَفْقًا لِ",
 "に従って": "وَفْقًا لِ",
 "に拠る": "بِوَاسِطَة",
 "に文字": "ثُوم, ثُومَة",
 "に沿って": "عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل) / بِالتَّوَازِي مَعَ\nمثال: أجب على السؤال.",
 "に渡って": "طَوَال",
 "に渡り": "طَوَال",
 "に準じて": "وَفْقًا لِ / طِبْقًا لِـ, وَفْقًا لِـ / بِالنِّسْبَة لِـ",
 "に照らして": "طِبْقًا لِـ, وَفْقًا لِـ / بِالنِّسْبَة لِـ",
 "に照らすと": "طِبْقًا لِـ, وَفْقًا لِـ / بِالنِّسْبَة لِـ",
 "に至っては": "أَمَّا ؛ فَـ (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ)\nمثال: أما زلت تذكرني؟",
 "に連れ": "كَـ, مِثْل / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "に連れて": "كَـ, مِثْل / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "に過ぎない": "عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "に関し": "بِالنِّسْبَة إِلَى / بِالْمُقَارَنَة مَعَ, مُقَارَنَةً مَعَ",
 "に限って": "وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي.\nمثال: 夜寝れない時に限って、時計のカチカチいう音が気になるものだ。 — عندما لا استطيع النوم في الليل الشيء الوحيد الذي يزعجني هو تكتكة الساعة .",
 "に際して": "مَتَى / إمتى / متى / امتى / فوقتاش / حِينَمَا, عِنْدَمَا",
 "ぬ": "لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة.",
 "ぬい": "تَطْرِيز",
 "ぬいかた": "بَالُوعَة / خَيَّاط",
 "ぬいとり": "تَطْرِيز",
 "ぬいめ": "دَرْز (درز:درزا تمكن من درز الدُّنْيَا؛ دَرِزَ الرجلُ، كفَرِح، وَكَذَلِكَ ذَرِزَ، بالدّالِ والذّالِ، إِذا تمَكَّن مِنْهَا أَي من نَعيمِها)",
 "ぬいもの": "خِيَاطَة, حِيَاكَة",
 "ぬう": "خَاطَ (خَطَّ، خَيطَ في إبرة أو آلة؛ وَصَلَ أو أَصَّلَ أجزاء معًا باستخدام الخيط) / خَيَّطَ ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه)\nمثال: خاط سامي جيبه المثقوب.",
 "ぬうっと": "فَجْأَةً",
 "ぬえ": "لُغْز, غَامِضَة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة رمزية أو غير مباشرة)\nمثال: لم يحل أبدا لغز وفاتها.",
 "ぬえてき": "غَامِض",
 "ぬかあめ": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "ぬかす": "سَبَقَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك. / قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "ぬかずく": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "ぬかつく": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "ぬかづく": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "ぬかり": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "ぬかる": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "ぬか雨": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "ぬがす": "خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ) / أَقْلَعَ / اِزْدَهَرَ\nمثال: خلع سامي حذاءه.",
 "ぬき": "لُحْمَة (هو اللَحْم، واللحمة أخصُّ من اللحم؛ قطعة من اللحم)",
 "ぬきいた": "فَسْقِيَّة, فِسْقِيَّة",
 "ぬきいと": "لُحْمَة (هو اللَحْم، واللحمة أخصُّ من اللحم؛ قطعة من اللحم)",
 "ぬきがき": "مُقْتَطَف / خلاصة",
 "ぬきさし": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "ぬきさる": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب.",
 "ぬきしろ": "مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "ぬきだす": "اِخْتَارَ / مُقْتَطَف / خلاصة",
 "ぬきでる": "فَاقَ, تَجَاوَزَ",
 "ぬきとおす": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود. / شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز.",
 "ぬきとる": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب. / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي. / سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "ぬきはなつ": "اِسْتَلّ, شَهَرَ",
 "ぬきほん": "نبذة – مقتطفات من",
 "ぬきんでる": "فَاقَ, تَجَاوَزَ",
 "ぬきネタ": "مِغْرَفَة",
 "ぬき出す": "اِخْتَارَ / مُقْتَطَف / خلاصة",
 "ぬぎぬぎ": "تَعَرَّى, اِنْجَرَدَ / تَعَرَّى",
 "ぬく": "عَزَلَ (فَصَلَ، فرَز، أَبْعَدَ؛ أَبْعَدَ، نَحَّى)\nمثال: جو بايدن طالب الكونغرس بعزل ترامب. / بَالُوعَة / اِخْتَارَ / سَرَقَ (أخذ ما كان لغيره خفية وبدون علم أحد) / اِسْتَرَقَ\nمثال: من سرق التفاحة؟",
 "ぬくい": "دَافِئ / دَفِيء",
 "ぬくとい": "دَافِئ / دَفِيء",
 "ぬくぬく": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ",
 "ぬくまる": "اِسْتَدْفَأَ / دَفَّأَ, أَدْفَأَ (دَفَّأَ الَجريحَ: أَدْفَأَهُ)",
 "ぬくみ": "دفاء",
 "ぬくめる": "دَافِئ / دَفِيء",
 "ぬくもり": "دفاء",
 "ぬぐ": "خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ) / أَقْلَعَ / اِزْدَهَرَ\nمثال: خلع سامي حذاءه.",
 "ぬぐいさる": "دَسَمَ, طَلَسَ (دَسََّمَ: الدَّسَمُ، محرَّكةً: الوَدَكُ، والوَضَرُ، والدَّنَسُ)",
 "ぬぐいとる": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله) / مَحَى, عَفَا\nمثال: مسح توم الطاولة.",
 "ぬぐい去る": "دَسَمَ, طَلَسَ (دَسََّمَ: الدَّسَمُ، محرَّكةً: الوَدَكُ، والوَضَرُ، والدَّنَسُ)",
 "ぬぐい取る": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله) / مَحَى, عَفَا\nمثال: مسح توم الطاولة.",
 "ぬぐう": "مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة. / تَخَلَّصَ ؛ مِن",
 "ぬけ": "إِغْفَال / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي)\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "ぬけあな": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "ぬけおちる": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان) / غَادَرَ (تَرَكَ)\nمثال: خرج سامي ليحتفل.",
 "ぬけかわる": "سَقِيفَة",
 "ぬけがら": "قِشْرَة",
 "ぬけさく": "مُغَفَّل, أَحْمَق",
 "ぬけだす": "اِنْدَلَعَ",
 "ぬけでる": "تَفَوَّقَ, بَزَّ / بَرَعَ (تفوق أو تميز في مجال معين أو عمل معين؛ أجاد وأتقن أداء مهمة أو عمل)",
 "ぬけに": "تَهْرِيب",
 "ぬけみち": "عَذَرَ (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق) / اِعْتَذَرَ / عُذْر (تبرير، إعذار؛ اعتذر عن فعل أو تصرف غير لائق)\nمثال: لن أقبل أي عذر.",
 "ぬけめ": "إِغْفَال",
 "ぬけめがない": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء.",
 "ぬけめない": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء.",
 "ぬけめのない": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء.",
 "ぬけもれ": "إِغْفَال",
 "ぬける": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان) / غَادَرَ (تَرَكَ)\nمثال: خرج سامي ليحتفل. / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / خُرُوج / مَخْرَج / خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل. / اِخْتَرَقَ, نَفَذَ",
 "ぬけ作": "مُغَفَّل, أَحْمَق",
 "ぬこ": "قِطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث) / قِطَّة (حيوان مستأنس من فصيلة السنوريات) / هِرّ (القطّ؛ صوت الإبل أو دعائها إلى الماء) / هِرَّة (المؤنث من الْهِرّ) / سَنُّور / قطّ (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط.",
 "ぬし": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ / مَالِك, مَالِكَة (اسم شخصي معطًى للذكور من العرب)\nمثال: من مالك هذا البيت؟ / فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة.",
 "ぬすっと": "لِصّ, لِصَّة",
 "ぬすっとたけだけしい": "وَقِح, صَفِيق",
