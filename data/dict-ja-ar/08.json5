 "じゃらじゃら": "ذُو رَنِين, مُرَنِّن (يُصدِر سلسلة من الأصوات الرنّانة الحادة كالأجراس الصغيرة) / بشهوانية, بفجور (بطريقة شهوانية)",
 "じゃらす": "إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات…)\nمثال: تجاهل تهكمهم",
 "じゃらつく": "شعر ركيك, شعر هزلي (شعر كوميدي غير منتظم الوزن)\nمثال: سمع بعض الشعر الركيك السخيف الذي ظل يتردد في ذهنه",
 "じゃら付く": "شعر ركيك, شعر هزلي (شعر كوميدي غير منتظم الوزن)\nمثال: سمع بعض الشعر الركيك السخيف الذي ظل يتردد في ذهنه",
 "じゃり": "حَصَى, حَصْبَاء (الحَصَى: صِغارُ الْحِجَارَةِ، الواحدةُ مِنْهُ حَصَاة. ابْنُ سِيدَهْ: الحَصَاة…) / وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "じゃりじき": "حَصَى, حَصْبَاء (الحَصَى: صِغارُ الْحِجَارَةِ، الواحدةُ مِنْهُ حَصَاة. ابْنُ سِيدَهْ: الحَصَاة…)",
 "じゃりじゃり": "جَرِيء, ذُو هِمَّة (مُسْتَعِدّ لِمُوَاجَهَة الخَطَر)",
 "じゃりんこ": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "じゃりん子": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "じゃれつく": "مَسَكَ\nمثال: لقد قبض على توم.",
 "じゃれる": "تفتيش جسدي (فعل تفتيش شخص ما بحثاً عن أسلحة مخفية أو مخدرات غير قانونية)\nمثال: أجرى للمشتبه به تفتيشاً سريعاً",
 "じゃれ付く": "مَسَكَ\nمثال: لقد قبض على توم.",
 "じゃろ": "بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "じゃろう": "بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "じゃん": "بِالتَّأْكِيد\nمثال: すごいじゃん。 — رائع!",
 "じゃんじゃか": "بِصَخَب, بِضَجِيج (مع الكثير من الضجيج أو الصوت العالي والمزعج)\nمثال: نظف أنفه بصخب",
 "じゃんじゃん": "رَنَّان, مُدَوٍّ (ذو صوت معدنيّ رنّان وعالٍ) / باستمرار",
 "じゃん拳": "حَجَر وَرَقَة مِقَصّ, حَجَر وَرَق مِقَصّ (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)",
 "じゃーね": "أراكَ قَريبًا, سَلَام",
 "じやく": "نَقْحَرَة, كَرْشَنَة (مصدر للفعل \"نَقْحَرَ\"؛ (في اللسانيات) كتابة لغة ما بحروفٍ تُستعمل لكتابة غيرها)",
 "じゅ": "كُونْفُوشِيَّة, كُونْفُشْيُوسِيَة / شَرِيط / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها / لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان…)\nمثال: اللعنة حولها ومعرفة / تعويذة, مانترا ((سنسكريتية) تعني حرفياً 'قول مقدس' في الفيدية؛ واحدة من مجموعة ترانيم شعرية…)\nمثال: كررت 'مسرورة جداً بسير الأمور' على فترات مثل المانترا / أَصْغَر / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في…)\nمثال: جون في عمر أخي. / أقدمية, طول العمر (خاصية العيش طويلاً)\nمثال: طول بقائها كنجمة / تَهْنِئَة",
 "じゅい": "أخصائي أشجار, جراح أشجار (متخصص في علاج الأشجار المتضررة)",
 "じゅう": "مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور…)\nمثال: لقد هدأ المنزل. / مُتَوَحِّش / مُسَدَّس, طَبَنْجَة (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم…)\nمثال: كان عند زيري مسدس. / عَشَرَة, عَشْرَة / عَبْر (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق. / دَاخِل\nمثال: جون في عمر أخي. / جَمِيع أَنْحَاء, كُلّ / كُلّ, جَمِيع / ثَقِيل / جِدِّيّ / تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة / دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة…)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران / نُعُومَة",
 "じゅうあい": "تحبب, تودد (فعل إظهار العاطفة)",
 "じゅうい": "طَبِيب بَيْطَرِيّ, بيطار (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "じゅういがく": "طب بيطري (فرع الطب الذي يتعامل مع تشخيص وعلاج أمراض وإصابات الحيوانات)",
 "じゅういし": "طَبِيب بَيْطَرِيّ, بيطار (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "じゅういせつぞくし": "أداة شرط, رابط تبعي (رابط (مثل 'منذ' أو 'أن') يقدم جملة تابعة)",
 "じゅういち": "عُشر (تقدمة تمثل عشر الدخل الشخصي) / أَحَد عَشَر, إِحْدَى عَشْرَةَ (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد. / مِشْوَال, رَافِعَة\nمثال: هن بحاجة لحمار.",
 "じゅういちがつ": "نُوفِمْبِر, نُوفَمْبِر (الشهر الحادي عشر في السنة الميلادية)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "じゅういちけんきん": "عُشر (تقدمة تمثل عشر الدخل الشخصي)",
 "じゅういちじ": "السَاعَة الحَادِيَة عَشَرَة",
 "じゅういつ": "فَيَضَان",
 "じゅういん": "تَعْبِئَة / قوات احتياط, ميليشيا (مدنيون مدربون كجنود ولكنهم ليسوا جزءًا من الجيش النظامي)",
 "じゅういんしょく": "شَامِل, كَامِلُ النِّطَاق (يستخدم جميع الموارد المتاحة)",
 "じゅうえい": "تعبئة, ملء (عملية ملء شيء ما)\nمثال: عندما تثاءب استطعت رؤية الحشوات الذهبية في أسنانه",
 "じゅうえいきごう": "دييز مزدوج, رفع مزدوج (تدوين موسيقي لعلامتي رفع أمام نوتة يشير إلى وجوب رفعها بمقدار نصفي نغمة)",
 "じゅうえき": "عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟ / طاعون الماشية (مرض فيروسي معد حاد يصيب الماشية (غالباً ما يكون قاتلاً)؛ يتميز بالحمى والإسهال…)",
 "じゅうえん": "زواج الأقارب, زواج داخلي (الزواج داخل قبيلة أو مجموعة المرء كما يقتضي العرف أو القانون) / أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "じゅうおう": "حسب المشيئة, كما يشاء (كما يختار المرء أو يرضى)\nمثال: يمكنه التجول في الحي كما يشاء",
 "じゅうおうじざい": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "じゅうおうひ": "نِسْبَة العَرْض إِلَى الِارْتِفَاع (نسبة العرض إلى الارتفاع لصورة التلفزيون)",
 "じゅうおうむじん": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "じゅうおく": "مِلْيَار / مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور…)\nمثال: لقد هدأ المنزل.",
 "じゅうか": "إطلاق نار, نيران (فعل إطلاق النار من سلاح)\nمثال: عرض إطلاق النار المارة الأبرياء للخطر / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً)\nمثال: عبء المسؤولية / مَجْلِس",
 "じゅうかいき": "ارتباط متعدد, انحدار متعدد (تقنية إحصائية تتنبأ بقيم متغير واحد على أساس متغيرين آخرين أو أكثر)",
 "じゅうかいきぶんせき": "ارتباط متعدد, انحدار متعدد (تقنية إحصائية تتنبأ بقيم متغير واحد على أساس متغيرين آخرين أو أكثر)",
 "じゅうかき": "سلاح ثقيل, مدفعية (تسليح كبير ولكن قابل للنقل) / سِلَاح نَارِيّ",
 "じゅうかく": "منصف (جزء التجويف الصدري بين الرئتين الذي يحتوي على القلب والأبهر والمريء والرغامى…)",
 "じゅうかぜい": "حَسَب القِيمَة (بنسبة تتناسب مع القيمة المقدرة للبضائع الخاضعة للضريبة)\nمثال: فرضت الضريبة على البضائع حسب القيمة",
 "じゅうかん": "بَهِيمِيّة / اجتياز, عبور (السفر عبر)",
 "じゅうかんきょう": "مَوْطِن (الوَطَن؛ كل مكان أقام به الإنسان سواء اتخذه وطنا أم لا)\nمثال: السافانة موطن أيضا للأسود و النمور.",
 "じゅうかんせん": "عدوى إضافية (عدوى تحدث أثناء العلاج من عدوى أخرى)",
 "じゅうがつ": "أَكْتُوبَر, تِشْرِين الْأَوَّل (الشهر العاشر في السنة الميلادية الروميّة)\nمثال: أراك في شهر أكتوبر.",
 "じゅうがん": "فتحة الرمي, مزغل (ثقب صغير في جدار محصن؛ للمراقبة أو إطلاق الأسلحة) / رَصَاصَة, رَصَاص",
 "じゅうき": "آنية, أداة منزلية (أداة للاستخدام العملي (خاصة في المنزل)) / كَنْز / ختمية (أي من نباتات طويلة متنوعة من جنس ألسيا؛ موطنها الشرق الأوسط ولكنها توطنت وزرعت…) / درع النبالة, شعار النبالة (الرموز الرسمية لعائلة أو دولة، إلخ)",
 "じゅうきせい": "الرقابة على السلاح, ضبط الأسلحة (جهود لتنظيم أو السيطرة على مبيعات الأسلحة)",
 "じゅうきせいほう": "الرقابة على السلاح, ضبط الأسلحة (جهود لتنظيم أو السيطرة على مبيعات الأسلحة)",
 "じゅうきゃくるい": "ثيروبود, ديناصور ثيروبود (أي من العديد من الديناصورات اللاحمة من العصر الترياسي إلى الطباشيري ذات أطراف…)",
 "じゅうきゅう": "تِسْعَةَ عَشَرَ",
 "じゅうきゅうるい": "ثيرابسيد (من المحتمل أن يكون من ذوات الدم الحار؛ يعتبر سلفاً مباشراً للثدييات)",
 "じゅうきょ": "مَنْزِل, سَكَن (مكان نزول القافلة؛ واحد منازل القمر، وهي مداراته التي يدور فيها حول الأَرض يدور…)\nمثال: لقد هدأ المنزل.",
 "じゅうきょしんにゅうざい": "اقتحام, كسر وخلع (التعدي لغرض غير قانوني؛ الدخول غير المشروع إلى مبنى بنية إجرامية)",
 "じゅうきょちいき": "حي سكني, مجتمع سكني (حي يعيش فيه الناس؛ تشغله مساكن خاصة في المقام الأول)",
 "じゅうきんぞく": "مُوسِيقَى الْمِيتَال (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف…)\nمثال: أتعلم الموسيقى.",
 "じゅうぎょう": "وَظِيفَة, تَوْظِيف (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "じゅうぎょういん": "مُوَظَّف, مُوَظَّفَة",
 "じゅうぎょうしゃ": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة…)\nمثال: توم عامل نفايات.",
 "じゅうくうかん": "مَجَال حَيَوِيّ (المساحة التي تسعى أمة لاحتلالها لتوسع سكانها)",
 "じゅうくにち": "مُغَفَّل, أَحْمَق",
 "じゅうぐん": "خِدْمَةٌ عَسْكَرِيَّة",
 "じゅうぐんいあんふ": "إِمْرَأَة مِتْعَة, نِسَاء مِتْعَة",
 "じゅうぐんきしゃ": "مراسل حربي (صحفي يرسل تقارير إخبارية وتعليقات من منطقة قتال أو مكان معركة للنشر أو البث)",
 "じゅうぐんぼくし": "قسيس عسكري, مرشد ديني عسكري (قسيس في إحدى الخدمات العسكرية)",
 "じゅうけい": "اِبْن عَمّ (الولد الذكر)\nمثال: هو له ابن صغير. / تْشُونْغْتْشِينْغ",
 "じゅうけいき": "إنذار حريق, كاشف دخان (إنذار ينطلق بسبب الحريق أو الدخان)",
 "じゅうけいてい": "اِبْن عَمّ (الولد الذكر)\nمثال: هو له ابن صغير.",
 "じゅうけつ": "اِحْتِقَان",
 "じゅうけつきゅうちゅう": "بلهارسيا, منشقة (ديدان مفلطحة تتطفل في الأوعية الدموية للثدييات)",
 "じゅうけつきゅうちゅうしょう": "بلهارسيا, داء البلهارسيات (عدوى طفيلية تسببها طفيليات من جنس البلهارسيا؛ شائعة في المناطق الاستوائية…)",
 "じゅうけん": "حَرْبَة, سُونْكِيّ (آلة للحَرْب تكون قصيرة مُحَدَّدة الرَأس تستخدم للطَعْن. غالبا ما تُرَكَّب على…)",
 "じゅうげき": "رِمَايَة",
 "じゅうげきせん": "تَبَادُل إِطْلَاق نَار, مَعْرَكَة بِالأَسْلِحَة النَّارِيَّة (قتال يتضمن إطلاق أسلحة صغيرة بقصد القتل أو التخويف)",
 "じゅうげきはん": "رامٍ, مسلح (شخص ذكر يطلق النار من مسدس (فيما يتعلق بقدرته))",
 "じゅうげん": "حَشْو, إِطْنَاب",
 "じゅうこう": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / صناعات ثقيلة",
 "じゅうこうぎょう": "صناعات ثقيلة",
 "じゅうこうちょうだい": "ثَقِيل",
 "じゅうこく": "إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى) / تَبَعِيَّة (التَّبَعيَّة : كَوْن الشخص أو الشيْ تابعاً لغيره؛ مصدر صناعيّ من تَبَعَ:…)",
 "じゅうこん": "تَعَدُّد اَلْأَزْوَاج, تَعَدُّد اَلزَّوْجَات / ثقب رصاصة (ثقب أحدثته رصاصة مرت من خلاله)",
 "じゅうこんしゃ": "مزدوج الزواج (شخص يتزوج من شخص بينما هو متزوج قانونياً من آخر)",
 "じゅうご": "خَمْسَةَ عَشَرَ (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال. / الجبهة الداخلية (السكان المدنيون (وأنشطتهم) لبلد في حالة حرب)",
 "じゅうごう": "بلمرة (عملية كيميائية تجمع عدة مونومرات لتكوين بوليمر أو مركب بوليمري)",
 "じゅうごうたい": "بُولِيمَر",
 "じゅうごん": "حَشْو, إِطْنَاب",
 "じゅうさつ": "إخراج مزدوج, لعبة مزدوجة (فعل إخراج لاعبين اثنين في لعبة واحدة) / طبعة منفصلة, مُستَلّة (مقال مطبوع بشكل منفصل ظهر أصلاً في منشور أكبر)",
 "じゅうさん": "ثَلَاثَةَ عَشَرَ (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب. / مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه.",
 "じゅうさんかいだん": "مِشْنَقَة",
 "じゅうさんがつ": "يَنَايِر, كَانُون اَلثَّانِي (الشهر الأول من السنة الروميّة)\nمثال: لتبدأ الاحتفالات بيناير.",
 "じゅうざ": "تحديد الموقع, تمركز (فعل وضع شيء ما في مكان معين)",
 "じゅうざい": "جِنَايَة",
 "じゅうざいにん": "جانٍ, مجرم (شخص ارتكب جريمة أو تمت إدانته قانونياً بجريمة)",
 "じゅうし": "اِبْن عَمّ (الولد الذكر)\nمثال: هو له ابن صغير. / أَرْبَعَةَ عَشَرَ (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام. / شَحْم / مُسْكِيتِيّ / مثبت أسنان (جهاز سني يثبت الأسنان (أو طرف صناعي) في موضعها بعد علاج تقويم الأسنان) / ثين (رجل رتبته أعلى من الرجل الحر العادي وأقل من النبيل في إنجلترا الأنجلوساكسونية…)",
 "じゅうしがた": "موجه (معدل أو محدد الموقع بالنسبة للمحيط أو الظروف)\nمثال: المنزل كانت نوافذه الكبيرة موجهة نحو إطلالة المحيط",
 "じゅうしち": "سَبْعَةَ عَشَرَ",
 "じゅうしつ": "ثَقِيل",
 "じゅうしまい": "اِبْن عَمّ (الولد الذكر)\nمثال: هو له ابن صغير.",
 "じゅうしゃ": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)\nمثال: كان حاضراً دائماً في اجتماعات القسم / رمي جانبي (إطلاق نار موجه على طول تشكيل بدلاً من عرضه)",
 "じゅうしゅ": "جندي المدفعية, مدفعي (جندي يخدم في سلاح المدفعية)",
 "じゅうしょ": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "じゅうしょう": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها)\nمثال: كان سامي جرد طفل.",
 "じゅうしょうか": "استفحال, تفاقم (إجراء يجعل المشكلة أو المرض (أو أعراضه) أسوأ)\nمثال: نتج تفاقم حالتها عن نقص الرعاية",
 "じゅうしょうきゅうせいこきゅうきしょうこうぐん": "سارس, متلازمة تنفسية حادة وخيمة (مرض تنفسي مجهول السبب نشأ على ما يبدو في بر الصين الرئيسي في عام 2003؛ يتميز…)",
 "じゅうしょうきんむりょくしょう": "وهن عضلي وبيل (مرض تدريجي مزمن يتميز بالتعب المزمن والضعف العضلي)",
 "じゅうしょうしゅぎ": "تجارة, تجارية (المعاملات (البيع والشراء) التي تهدف إلى توفير السلع (البضائع والخدمات))",
 "じゅうしょうせき": "باريت, باريتا",
 "じゅうしょうど": "صَرَامَة",
 "じゅうしょく": "رَئِيس الدَّيْر, أَبَاتِي",
 "じゅうしょち": "مأوى, مسكن (سكن يعيش فيه شخص ما)\nمثال: بنى مسكناً متواضعاً بالقرب من البركة",
 "じゅうしょろく": "قَائِمَة بَرِيدِيَّة",
 "じゅうしん": "مركز الثقل, مركز الجاذبية (النقطة داخل شيء ما التي يمكن اعتبار الجاذبية تعمل عندها؛ في الجاذبية المنتظمة…) / مركز هندسي, نقطة مركزية (مركز كتلة جسم ذو كثافة منتظمة) / رَصِيد / سبطانة, ماسورة البندقية (أنبوب تمر من خلاله الرصاصة عند إطلاق النار من السلاح)",
 "じゅうしんをとる": "رَصِيد",
 "じゅうじ": "صَلِيب\nمثال: عبر جرذ الطريق. / تثليث, رسم الصليب (إيماءة باليد اليمنى تتحرك لتشكيل صليب؛ يستخدمها الكاثوليك كإعلان إيمان) / مُطَارِد, مُلَاحِق (يتبع بهدف اللحاق أو الإمساك) / اَلسَّاعَة اَلْعَاشِرَة",
 "じゅうじあなつきねじ": "برغي فيليبس (برغي برأس خاص به فتحات متقاطعة)",
 "じゅうじか": "صَلِيب\nمثال: عبر جرذ الطريق. / نيران متقاطعة (نيران من نقطتين أو أكثر بحيث تتقاطع خطوط النار)",
 "じゅうじかじょう": "صَلِيبِيّ",
 "じゅうじかぞう": "وضعية الصليب (تمرين جمباز يُؤدى على الحلقات عندما يدعم لاعب الجمباز نفسه بذراعين ممدودتين…)",
 "じゅうじがい": "مُفْتَرَق, تَقَاطُع",
 "じゅうじく": "مِغْزَل",
 "じゅうじぐん": "حَمْلَة صَلِيبِيَّة\nمثال: بوتين مجرم حرب.",
 "じゅうじけい": "صَلِيبِيّ الشَّكْل (على شكل صليب)",
 "じゅうじざ": "مَرْبِط الْفَرَس",
 "じゅうじしゃ": "مُمَارِس",
 "じゅうじせん": "دائرة الاستهداف, مرمى النظر (مركز للاهتمام)\nمثال: الحرب على الإرهاب وضعت صدام حسين في دائرة الاستهداف",
 "じゅうじつ": "اِمْتِلَاء / تحسين, تعزيز (تحسين يجعل الشيء أكثر قبولاً) / تجديد موارد",
 "じゅうじに": "عَرْضِيًّا, مُسْتَعْرِضًا (بشكل مستعرض)\nمثال: تم قطع ألواح الرخام بشكل عرضي",
 "じゅうじねじ": "برغي فيليبس (برغي برأس خاص به فتحات متقاطعة)",
 "じゅうじゃく": "ضَعِيف",
 "じゅうじゅう": "أَزِيزِيّ (ساخن بما يكفي للاحتراق مع صوت أزيز أو كأنَّه كذلك) / مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً / بالكامل, تماماً (إلى أقصى درجة أو مدى؛ بشكل كامل أو كلي)\nمثال: نمى بالكامل",
 "じゅうじゅつ": "جوجوتسو (طريقة للدفاع عن النفس بدون أسلحة تم تطويرها في الصين واليابان؛ يتم استكمال…)",
 "じゅうじゅん": "مُطِيع, مُذْعِن",
 "じゅうじろ": "مُفْتَرَق, تَقَاطُع",
 "じゅうじをきる": "صَلَّبَ (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "じゅうじん": "عَمُود / فَرْوِيّ, مُفَرَّى",
 "じゅうす": "حَيِيَ, عَاشَ\nمثال: ينبح كلب في الحي.",
 "じゅうすい": "أكسيد الديوتيريوم, ماء ثقيل (ماء يحتوي على نسبة كبيرة من ذرات الديوتيريوم، يستخدم في المفاعلات النووية)",
 "じゅうすいそ": "ديوتيريوم, هيدروجين ثقيل (نظير للهيدروجين يحتوي على نيوترون واحد (مقارنة بعدم وجود نيوترونات في…)",
 "じゅうする": "حَيِيَ, عَاشَ\nمثال: ينبح كلب في الحي.",
 "じゅうせい": "نَجْم مُتَعَدِّد (نظام مكون من ثلاثة نجوم أو أكثر مرتبطة بالجاذبية) / وحشية",
 "じゅうせつ": "جملة تابعة, جملة ثانوية (جملة في جملة معقدة لا يمكن أن تقف وحدها كجملة كاملة وتعمل داخل الجملة كاسم أو…) / تَابِع / أداة منزلية, جهاز منزلي (جهاز يؤدي وظيفة محددة في المنزل)",
 "じゅうせん": "خط البار, خط المقياس (خط عمودي قبل النبضة المشددة يحدد الحدود بين المقاييس الموسيقية)",
 "じゅうぜん": "كَمَال, إتقان / سَابِق / قَيْصَر, إِمْبْرَاطُور",
 "じゅうぜんのきみ": "قَيْصَر, إِمْبْرَاطُور",
 "じゅうそう": "صُودَا الْخَبْز / رَكْض (عَدَا)\nمثال: إنها تحب الركض. / مُتَعَدِّد الطَّوَابِق (ذو أكثر من طابق واحد)",
 "じゅうそうかんけいすう": "معامل الارتباط المتعدد (تقدير للتأثير المشترك لمتغيرين أو أكثر على المتغير المرصود (التابع))",
 "じゅうそうしんこう": "توفيق صيغي (دمج الأشكال المصرفة التي كانت مختلفة أصلاً (مما يؤدي إلى تقليل استخدام…)\nمثال: توفيقية بين النظريات المادية وغير المادية",
 "じゅうそうてき": "طَبَقِيّ, مُرَسَّب (مترسب أو مرتب في طبقات أفقية)\nمثال: صخور طبقية",
 "じゅうそく": "قَابِس / كِفَايَة",
 "じゅうそしき": "متن, نسيج حشوي (نسيج حيواني يشكل الجزء الأساسي والوظيفي للعضو على النقيض من النسيج الضام…)",
 "じゅうそつ": "منضبط, منظم (خالٍ من العنف أو الاضطراب)\nمثال: حشد منظم واجه الرئيس",
 "じゅうぞく": "إخضاع, سيادة (فعل السيطرة على شخص ما أو إخضاعه) / ربط تسلسلي, سَلسَلة (عملية الربط معاً كما هو الحال في سلسلة أو تعاقب)\nمثال: تسلسل القيادة",
 "じゅうぞくかんけい": "إخضاع, سيادة (فعل السيطرة على شخص ما أو إخضاعه)",
 "じゅうぞくこく": "تَبَعِيَّة (التَّبَعيَّة : كَوْن الشخص أو الشيْ تابعاً لغيره؛ مصدر صناعيّ من تَبَعَ:…)",
 "じゅうぞくせつ": "جملة تابعة, جملة ثانوية (جملة في جملة معقدة لا يمكن أن تقف وحدها كجملة كاملة وتعمل داخل الجملة كاسم أو…)",
 "じゅうぞくてき": "تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة",
 "じゅうぞくへんすう": "مُتَغَيِّر تَابِع",
 "じゅうたい": "اِحْتِقَان\nمثال: 渋滞で遅れました。 — أخّرني زحام السير. / تَأْخِير, تَأَخَّر\nمثال: اقترب أجل زيري. / تَعَادُل (تَسَاوَى؛ تَمَاثَلَ)\nمثال: انتهت المباراة بالتعادل. / وَتَر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه…) / أَبْرَاجُ السَّمَاء / عَمُود",
 "じゅうたく": "مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "じゅうたくがい": "حي سكني, مجتمع سكني (حي يعيش فيه الناس؛ تشغله مساكن خاصة في المقام الأول)",
 "じゅうたくさんぎょう": "صناعة الإسكان, صناعة البناء والتشييد (صناعة تقوم ببناء المساكن)",
 "じゅうたくせつび": "أداة منزلية, جهاز منزلي (جهاز يؤدي وظيفة محددة في المنزل)",
 "じゅうたくだんち": "مجمع سكني, مشروع سكني (منطقة سكنية تضم مساكن متشابهة بناها مطورون عقاريون وتخضع عادة لإدارة واحدة)\nمثال: يعيشون في المجمع السكني الجديد",
 "じゅうたくち": "حي سكني, مجتمع سكني (حي يعيش فيه الناس؛ تشغله مساكن خاصة في المقام الأول)",
 "じゅうたくちく": "حي سكني, مجتمع سكني (حي يعيش فيه الناس؛ تشغله مساكن خاصة في المقام الأول)",
 "じゅうたくとしせいびこうだん": "وزارة الإسكان والتنمية الحضرية (الإدارة الفيدرالية الأمريكية التي تدير البرامج الفيدرالية التي تتعامل مع تحسين…)",
 "じゅうたくようかさいけいほうき": "إنذار حريق, كاشف دخان (إنذار ينطلق بسبب الحريق أو الدخان)",
 "じゅうたくローン": "رَهْن, رَهْن عَقَارِيّ ((رَهَنَ) الشيءُ يَرْهَنُ رهْنًا، ورُهُونا: ثَبَت ودامَ؛ يقال (رَهَنَ) بالمكان:…)\nمثال: رهن فاضل الحلي.",
 "じゅうたくローンげんぜい": "إعفاء ضريبي, خصم ضريبي (تخفيض في المبلغ الإجمالي الذي تُحسب عليه الضريبة؛ يقلل الضرائب بالنسبة المئوية…)",
 "じゅうたる": "تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة",
 "じゅうたん": "سَجَّادَة, بِسَاط / أسود العظام, فحم العظام (مادة سوداء تحتوي على الفحم في شكل عظام متفحمة؛ تستخدم كصبغة سوداء)",
 "じゅうたんさんえん": "بيكربونات, كربونات الهيدروجين",
 "じゅうたんさんソーダ": "صُودَا الْخَبْز",
 "じゅうたんさんナトリウム": "صُودَا الْخَبْز",
 "じゅうたんばくげき": "قصف بساطي",
 "じゅうだい": "جِدِّيّ / الأَعْدَاد بَيْن الثَّالِثَة عَشْرَة والتَّاسِعَة عَشْرَة",
 "じゅうだいか": "استفحال, تفاقم (إجراء يجعل المشكلة أو المرض (أو أعراضه) أسوأ)\nمثال: نتج تفاقم حالتها عن نقص الرعاية",
 "じゅうだいせい": "أَهَمِّيَّة",
 "じゅうだいはんざい": "جِنَايَة",
 "じゅうだん": "رَصَاصَة, رَصَاص",
 "じゅうだんせき": "ثقب رصاصة (ثقب أحدثته رصاصة مرت من خلاله)",
 "じゅうだんてき": "طُولِيّ, مُمْتَدّ زَمَنِيًّا (يَمْتَدّ عَلى فَتْرَة زَمَنِيَّة طَويلَة)\nمثال: حساب طولي بواسطة الملاح",
 "じゅうちく": "مَوَاشٍ, أَنْعَام",
 "じゅうちゅうはっく": "على الأرجح, غالباً (بدرجة كبيرة من اليقين؛ دون شك كبير)\nمثال: من المحتمل أنه خارج البلاد",
 "じゅうちん": "قَائِد, زَعِيم",
 "じゅうてい": "اِبْن عَمّ (الولد الذكر)\nمثال: هو له ابن صغير.",
 "じゅうていおん": "تَرَدُّد مُنْخَفِض لِلغَايَة (3 إلى 30 كيلوهرتز)",
 "じゅうてき": "تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة / بَهِيمِيّ, حَيَوَانِيّ (يُشبه الوحش؛ يُظهر انعدام الحِسّ الإنساني)",
 "じゅうてん": "تعبئة, ملء (عملية ملء شيء ما)\nمثال: عندما تثاءب استطعت رؤية الحشوات الذهبية في أسنانه / تَرْكِيز / نُقْطَة مُزْدَوِجَة, نُقْطَتَان (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "じゅうてんざい": "حشوة (التبغ المستخدم لتشكيل لب السيجار)\nمثال: بعض العناصر في المجموعة مجرد تكملة",
 "じゅうてんそち": "كوفيد-19, كوڤيد-19",
