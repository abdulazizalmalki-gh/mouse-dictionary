 "しんけいがく": "طب الأعصاب, طب الجهاز العصبي (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "しんけいがくしゃ": "أخصائي أعصاب, طبيب أعصاب (أخصائي طبي في الجهاز العصبي والاضطرابات التي تؤثر عليه)",
 "しんけいがこまかい": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "しんけいがさいぼう": "أرومة عصبية (خلية تتطور منها الخلية العصبية)",
 "しんけいがさいぼうしゅ": "ورم أرومي عصبي (ورم خبيث يحتوي على خلايا عصبية جنينية؛ عادة ما ينتشر بسرعة)",
 "しんけいがしゅ": "ورم أرومي عصبي (ورم خبيث يحتوي على خلايا عصبية جنينية؛ عادة ما ينتشر بسرعة)",
 "しんけいがするどい": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "しんけいがほそい": "مُفْرِط الحَسَاسِيَّة (حسّاس بشكل مبالغ فيه)",
 "しんけいきん": "عصبي عضلي (يؤثر على أو يميز كلا من الأنسجة العصبية والعضلية)",
 "しんけいきんせつごうぶ": "مشبك عصبي عضلي (الوصلة بين الليف العصبي والعضلة التي يغذيها)",
 "しんけいけい": "جِهَاز عَصَبِيّ",
 "しんけいげか": "جراحة الأعصاب (أي جراحة تتعلق بالجهاز العصبي (الدماغ أو الحبل الشوكي أو الأعصاب المحيطية))",
 "しんけいげん": "عَصْبُون, خَلِيَّة عَصَبِيَّة",
 "しんけいげんごがく": "لسانيات عصبية (فرع اللسانيات الذي يدرس العلاقة بين اللغة وبنية ووظيفة الجهاز العصبي)",
 "しんけいげんごプログラミング": "معالجة اللغات الطبيعية (فرع علم المعلومات الذي يتعامل مع معلومات اللغة الطبيعية)",
 "しんけいこう": "خلايا دبقية, نسيج عصبي دبقي (نسيج داعم يحيط ويدعم الخلايا العصبية في الجهاز العصبي المركزي)",
 "しんけいこうさいぼう": "خلية دبقية, خلية غروية عصبية (خلية من خلايا الدبق العصبي)",
 "しんけいこうしゅ": "ورم دبقي (ورم في الدماغ يتكون من الخلايا الدبقية)",
 "しんけいさいぼう": "عَصْبُون, خَلِيَّة عَصَبِيَّة",
 "しんけいさいぼうたい": "عَصْبُون, خَلِيَّة عَصَبِيَّة",
 "しんけいざい": "عامل أعصاب, غاز الأعصاب (غاز سام يتم استنشاقه أو امتصاصه عبر الجلد وله آثار ضارة على الجهاز العصبي…)",
 "しんけいしつ": "عَصَبِيّ / دَقِيق, مُتَطَلِّب (شَدِيد التَّدْقِيق خَاصَّةً فِي التَّفَاصِيل)",
 "しんけいしはい": "إِمْدَاد عَصَبِيّ, تَعْصِيب (توزيع الألياف العصبية على عضو أو منطقة في الجسم)",
 "しんけいしゅ": "ورم عصبي (أي ورم مشتق من خلايا الجهاز العصبي)",
 "しんけいしゅうまく": "حول العصب, غمد الحزمة العصبية (غمد من النسيج الضام يغطي حزمة من الألياف العصبية)",
 "しんけいしゅうまつ": "نهاية عصبية (الهيكل الطرفي للمحور العصبي الذي لا ينتهي عند مشبك عصبي)",
 "しんけいしょう": "اضطراب عصبي, مرض عصبي (اضطراب في الجهاز العصبي)",
 "しんけいしょうがい": "اضطراب عصبي, مرض عصبي (اضطراب في الجهاز العصبي)",
 "しんけいしょうげき": "سيال عصبي, نبضة عصبية (التفريغ الكهربائي الذي ينتقل عبر الليف العصبي)\nمثال: أثبتوا انتقال النبضات من القشرة الدماغية إلى منطقة تحت المهاد",
 "しんけいしょうてき": "عصابي, مريض نفسياً (مصاب باضطراب عاطفي)\nمثال: اضطراب عصابي",
 "しんけいしんりがく": "علم النفس العصبي, علم النفس الفسيولوجي (فرع علم النفس المعني بالأسس الفسيولوجية للعمليات النفسية)",
 "しんけいすいじゃく": "وهن عصبي (انهيار عصبي (مصطلح غير تقني)) / تَرْكِيز",
 "しんけいせい": "عَصَبِيّ",
 "しんけいせいしんいがく": "طب النفس العصبي (فرع الطب المعني بالاضطرابات العقلية المنسوبة لأمراض الجهاز العصبي)",
 "しんけいせいたいしょくしょう": "الشره المرضي العصبي, النهام العصبي (اضطراب في الأكل يتناوب فيه الشخص بين رغبة قوية في الطعام ونفور منه؛ يتميز…)",
 "しんけいせいぶつがく": "بيولوجيا عصبية (فرع علم الأحياء الذي يتعامل مع تشريح وفسيولوجيا وباثولوجيا الجهاز العصبي)",
 "しんけいせいむしょくよくしょう": "فقدان الشهية العصبي ((الطب النفسي) اضطراب نفسي يتميز بأوهام جسدية بأن الشخص سمين جداً رغم كونه…)",
 "しんけいせいりがく": "فسيولوجيا عصبية (فرع علم الأعصاب الذي يدرس فسيولوجيا الجهاز العصبي)",
 "しんけいせつ": "عُقْدَة عَصَبِيَّة",
 "しんけいせん": "حرب أعصاب, حرب نفسية (استخدام تكتيكات نفسية لتدمير معنويات الخصوم)",
 "しんけいせんい": "ليف عصبي (امتداد خيطي للخلية العصبية)",
 "しんけいそう": "ضفيرة عصبية (شبكة من الأعصاب المتقاطعة)",
 "しんけいそしき": "نسيج عصبي (نسيج يتكون من عصبونات)",
 "しんけいたようせい": "تَنَوُّع عَصَبِيّ",
 "しんけいたんい": "عَصْبُون, خَلِيَّة عَصَبِيَّة",
 "しんけいちゅうすう": "مركز, مركز عصبي (مجموعة من الخلايا العصبية تتحكم في عملية جسدية محددة)\nمثال: في معظم الناس يقع مركز الكلام في نصف الكرة الأيسر",
 "しんけいちょうせつせいしっしん": "نانومتر (وحدة مترية للطول تساوي واحداً من المليار من المتر)",
 "しんけいつう": "ألم عصبي (ألم تشنجي حاد على طول مسار عصب واحد أو أكثر)",
 "しんけいつかう": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "しんけいてい": "عُرْف عَصَبِيّ (عَلِمَ؛ سَكَنَ إلى الشيءِ، أَنَسَهُ وأَلِفَه)\nمثال: من عرف نفسه فقد عرف ربه.",
 "しんけいでんたつぶっしつ": "نَاقِل عَصَبِيّ",
 "しんけいどく": "ذيفان عصبي, سم عصبي (أي سم يؤثر على الأنسجة العصبية)",
 "しんけいないか": "طب الأعصاب, طب الجهاز العصبي (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "しんけいないぶんぴ": "عصبي صماوي (متعلق بالجهازين العصبي والصماوي (خاصة في وظيفتهما المشتركة))",
 "しんけいないぶんぴつ": "عصبي صماوي (متعلق بالجهازين العصبي والصماوي (خاصة في وظيفتهما المشتركة))",
 "しんけいのかそせい": "اللُّدُونة العصبية",
 "しんけいのするどい": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "しんけいのにぶい": "غير حساس, متبلد الحس (غير مستجيب للمحفزات الجسدية)\nمثال: غير حساس للإشعاع",
 "しんけいのほそい": "مُفْرِط الحَسَاسِيَّة (حسّاس بشكل مبالغ فيه)",
 "しんけいばいどく": "زهري عصبي (زهري يصيب الجهاز العصبي المركزي)",
 "しんけいびょう": "اضطراب عصبي, مرض عصبي (اضطراب في الجهاز العصبي)",
 "しんけいもう": "شبكة عصبية (أي شبكة من الخلايا العصبية أو النوى التي تعمل معاً لأداء وظيفة ما في الجسم)",
 "しんけいをつかう": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "しんけいインパルス": "سيال عصبي, نبضة عصبية (التفريغ الكهربائي الذي ينتقل عبر الليف العصبي)\nمثال: أثبتوا انتقال النبضات من القشرة الدماغية إلى منطقة تحت المهاد",
 "しんけいガス": "غَاز أَعْصَاب, عَامِل أَعْصَاب",
 "しんけいホルモン": "هرمون عصبي (هرمون يتم إطلاقه بواسطة نبضات عصبية (مثل النورإبينفرين أو الفازوبريسين))",
 "しんけっかん": "جِهَاز اَلدَّوَرَان, جِهَاز قَلْبِيّ وِعَائِيّ",
 "しんけっかんけい": "الجهاز الدوري, جهاز الدوران (الأعضاء والأنسجة المشاركة في تدوير الدم والليمف عبر الجسم)",
 "しんけっかんしっかん": "مرض القلب والأوعية الدموية, مرض قلبي وعائي (مرض يصيب القلب أو الأوعية الدموية)",
 "しんけつ": "قلباً وقالباً (بإيمان كامل)\nمثال: كانت معه قلباً وقالباً",
 "しんけん": "جِدِّيّ / حَبْس (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس. / الحق الإلهي, الحق الإلهي للملوك (المذهب القائل بأن الملوك يستمدون حقهم في الحكم مباشرة من الله ولا يخضعون…)\nمثال: تم الإعلان عن مذهب الحق الإلهي للملوك من قبل عائلة ستيوارت في بريطانيا في القرن السادس عشر",
 "しんけんあらそい": "نزاع حضانة (تقاضي لتسوية حضانة أطفال زوجين مطلقين)",
 "しんけんしゃ": "أمين, وصي قانوني (شخص (أو مؤسسة) يُعهد إليه بالملكية القانونية للممتلكات لاستخدامها لصالح شخص آخر)",
 "しんけんせいじ": "ثِيُقْرَاطِيَّة",
 "しんげき": "يقرب",
 "しんげきめいれい": "عتاد المسير (تجهيزات للمسير)\nمثال: كانت السرية مجهزة بكامل عتاد المسير",
 "しんげつ": "مُحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة…) / هِلَال",
 "しんげん": "جَادّ, صَادِق (يتّسم بإيمان ثابت وجادّ بأهمية الشيء ذاته) / بُؤْرَة / مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / اَلْأَمْثَال / نَصِيحَة, مَشُورَة",
 "しんげんち": "بؤرة سطحية, مركز زلزالي سطحي (النقطة على سطح الأرض الواقعة مباشرة فوق بؤرة الزلزال) / مَصْدَر, مَصَادِر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "しんこ": "حَقِيقِيّ / مُخَلَّل / دَقِيق الْأَرُزّ, أَرُزّ مَسْحُوق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "しんこう": "إِيمَان, مُعْتَقَد\nمثال: キリスト教を信仰していますか。 — هل تؤمن بالمسيحية؟ / تَرْقِيَة, تَرْفِيع / اِنْتِفَاضَة, تَمَرُّد (معارضة منظمة للسلطة؛ صراع يحاول فيه فصيل انتزاع السيطرة من آخر) / تَقَدُّم / مُتَتَالِيَة / غَزْو, إِغَارَة (أَغَارَ عَلَى العَدُوِّ غَزْواً : سَارَ إِلَى مُحَارَبَتِهِ وَقِتَالِهِ فِي…)\nمثال: الصين مستعدة لغزو تايوان. / مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُخَلَّل / أُلْفَة / سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / حَمْلَة / صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق…)\nمثال: الغيرة عدوة الصداقة. / إكليل, نطاق (مؤشر لضوء مشع يُرسم حول رأس قديس)",
 "しんこうがかり": "ميسّر (شخص يجعل التقدم أسهل)",
 "しんこうけい": "دَائِر, مُسْتَمِرّ (يحدث الآن بشكل مستمر)",
 "しんこうこく": "دَوْلَة نَامِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من…)\nمثال: لبنان دولة صغيرة.",
 "しんこうしゃ": "مُؤْمِن, مُؤْمِنَة (هو الشخص الذي يُؤْمِنُ بالشيء ويصدقه؛ من دخل في قلبه الإِيْمَان، وهو يطلق على…)\nمثال: المؤمن لا يلدغ مرتين من جحر واحد.",
 "しんこうしょく": "سِقِلَّاتِيّ, قِرْمِزِيّ",
 "しんこうしん": "تَقْوَى\nمثال: دخل زيري إلى منطقة ببر.",
 "しんこうせい": "تَقَدُّمِيّ, مُتَرَقٍّ",
 "しんこうせいこつかせいせんいいけいせいしょう": "خلل التنسج الليفي المعظم المترقي (أدخل شيئًا بين آخر؛ جعل شيئًا يتخلل شيئًا آخر)",
 "しんこうそう": "مُسْتَمِرّ, هَيْئَة تَقَدُّمِيَّة (جهة الفعل التي تعبر عن حدث جارٍ)",
 "しんこうちゅう": "دَائِر, مُسْتَمِرّ (يحدث الآن بشكل مستمر)",
 "しんこうてき": "دِينِيّ",
 "しんこうとし": "مدينة مزدهرة (بلدة تتمتع بازدهار مفاجئ)",
 "しんこうのじゆう": "حُرِّيَّة اَلدِّين, حُرِّيَّة اَلْمُعْتَقَد (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ…)\nمثال: الحرية لفلسطين.",
 "しんこうは": "موجة متنقلة, موجة مسافرة (موجة يتحرك فيها الوسط في اتجاه انتشار الموجة)",
 "しんこうぶかい": "مُتَدَيِّن",
 "しんこうやく": "ميسّر (شخص يجعل التقدم أسهل)",
 "しんこく": "جِدِّيّ / وَصَفَ, أَبْلَغَ\nمثال: أبلغ توم تحياتي. / الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان. / تشينغ, سلالة تشينغ (آخر سلالة إمبراطورية للصين (من 1644 إلى 1912) والتي أطاح بها الثوار؛ خلال سلالة…)",
 "しんこくか": "استفحال, تفاقم (إجراء يجعل المشكلة أو المرض (أو أعراضه) أسوأ)\nمثال: نتج تفاقم حالتها عن نقص الرعاية",
 "しんこくしゃ": "جازم, مؤكِّد (شخص يدعي قول الحقيقة)\nمثال: مؤكد جريء",
 "しんこくしょ": "وَصَفَ, أَبْلَغَ\nمثال: أبلغ توم تحياتي.",
 "しんこつ": "قلباً وقالباً (بإيمان كامل)\nمثال: كانت معه قلباً وقالباً",
 "しんこつるい": "سمكة عظمية (سمكة عظمية من طويئفة العظميات)",
 "しんこてんしゅぎ": "كلاسيكية جديدة (إحياء لأسلوب كلاسيكي (في الفن أو الأدب أو العمارة أو الموسيقى) ولكن من منظور…)",
 "しんこてんは": "كلاسيكية جديدة (إحياء لأسلوب كلاسيكي (في الفن أو الأدب أو العمارة أو الموسيقى) ولكن من منظور…)",
 "しんこひん": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "しんこもち": "دَقِيق الْأَرُزّ, أَرُزّ مَسْحُوق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "しんこん": "قلباً وقالباً (بإيمان كامل)\nمثال: كانت معه قلباً وقالباً / قَلْب, فُؤَاد",
 "しんこんしょや": "ليلة الدخلة, ليلة الزفاف (الليلة التالية للزفاف عندما ينام العريس والعروس معاً)",
 "しんこんふうふ": "حديث الزواج (شخص تزوج حديثاً)",
 "しんこんりょこう": "شَهْر عَسَل (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر…)\nمثال: رمضان شهر حرام.",
