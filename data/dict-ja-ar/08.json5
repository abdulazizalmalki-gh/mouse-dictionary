 "じんこうとうけい": "ديموغرافي, سكاني (متعلق بعلم السكان (الديموغرافيا)) / إحصائية ديموغرافية, إحصائية سكانية (إحصائية تصف السكان البشريين (أو شرائح منهم مقسمة حسب العمر أو الجنس أو الدخل، إلخ))\nمثال: مسوحات ديموغرافية (سكانية)",
 "じんこうとうけいがく": "دِيمُوغْرَافِيَا, دِمُوغْرَافِيَا",
 "じんこうとうけいがくしゃ": "ديموغرافي, عالم سكان (عالم يدرس نمو وكثافة السكان وإحصاءاتهم الحيوية)",
 "じんこうとうせき": "غَسِيل كِلَى",
 "じんこうにんしんちゅうぜつ": "إجهاض متعمد (إنهاء متعمد للحمل)",
 "じんこうは": "مصنوع آلياً, ميكانيكي الصنع (مصنوع بواسطة الآلة)",
 "じんこうひにんほう": "منع الحمل (تحديد النسل باستخدام أجهزة (مثل الواقي الذكري أو اللولب) أو الأدوية أو الجراحة)",
 "じんこうぶつ": "تَرْكِيبِيّ, مَصْنُوع (ليس من أصل طبيعي؛ أُعِدّ أو صُنِع صناعيًّا) / صَنِيعَة, مَصْنُوعَة (شيء من صنع الإنسان يُؤخَذ ككلّ متكامل)",
 "じんこうべん": "قلب اصطناعي (مضخة تحل محل القلب الطبيعي)",
 "じんこうみっしゅうりつ": "كَثَافَة سُكَّانِيَّة (مصدر لكَثَفَ؛ اللغلظ والثخانة)\nمثال: هذه منطقة من الغابة أقل كثافة",
 "じんこうみつど": "كَثَافَة سُكَّانِيَّة (مصدر لكَثَفَ؛ اللغلظ والثخانة)\nمثال: هذه منطقة من الغابة أقل كثافة",
 "じんこうよくせい": "تحديد النسل, ضبط السكان (السيطرة على نمو السكان؛ برنامج حكومي)",
 "じんこうりゅうざん": "خِدَاج, إِجْهَاض",
 "じんこうわくせい": "تَرْكِيبِيّ, مَصْنُوع (ليس من أصل طبيعي؛ أُعِدّ أو صُنِع صناعيًّا)",
 "じんこうピラミッド": "هَرَم سُكَّانِيّ ((في الهندسة) منشور كثير السطوح، قاعدته مضلع، وأوجهه الأخرى مثلثات، قواعدها أضلاع مضلع القاعدة، ورؤوسها مجتمعة في نقطة واحدة خارجة عنه؛ بناء أثري بناه الفراعنة في مصر بالحجارة الصلبة، ذو قاعدة مربعة، له أربع واجهات، وكل واجهة مثلثة الشكل، تلتقي رؤوسها فتكون رأسًا واحدًا هو قمة الهرم)",
 "じんさ": "حَصَى, حَصْبَاء (الحَصَى: صِغارُ الْحِجَارَةِ، الواحدةُ مِنْهُ حَصَاة. ابْنُ سِيدَهْ: الحَصَاة مِنَ الْحِجَارَةِ مَعْرُوفَةٌ…)",
 "じんさい": "تَرْكِيبِيّ, مَصْنُوع (ليس من أصل طبيعي؛ أُعِدّ أو صُنِع صناعيًّا)",
 "じんざい": "إدارة الموارد البشرية, قسم شؤون الموظفين (القسم المسؤول عن تعيين وتدريب وتوزيع الموظفين ووضع سياسات إدارة الأفراد) / قوة (مجموعة من الناس مستعدة لإطاعة الأوامر)\nمثال: قوة عامة ضرورية لتوفير الأمن لحقوق المواطنين",
 "じんざいいくせいぎじゅつけんきゅうじょ": "مركز أبحاث (مركز يتم فيه إجراء الأبحاث)",
 "じんざいしょうかいがいしゃ": "وَكَالَة تَوْظِيف",
 "じんし": "اَلسَّيِّد, سَيِّد / نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه. / جرذ الماء (أي نوع من الجرذان البرمائية المختلفة) / جرذ الماء (فأر حقل أوراسي كبير شائع) / محب الماء (شخص يستمتع بالتواجد في الماء أو عليه) / رسول إلهي (رسول من عند الله)\nمثال: إنهم كائنات خارقة للطبيعة تعمل كرسل إلهيين بين الناس والآلهة",
 "じんしゃ": "رِيكْشَا / إِنْسَانَوِيّ (يتّسم بالقيم الإنسانويّة والتفاني في رعاية البشر) / إنساني (من أو يتعلق بالمذهب الإنساني أو يميزه) / إنساني (مدافع عن مبادئ الإنسانية؛ شخص مهتم بمصالح البشر ورفاهيتهم) / إنساني, فاعل خير (شخص مكرس لتعزيز رفاهية الإنسان والإصلاحات الاجتماعية)\nمثال: مساعدات إنسانية",
 "じんしゅ": "سِبَاق, مُسَابَقَة / عِرْق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "じんしゅかくり": "فصل عرقي (الفصل حسب العرق)",
 "じんしゅかくりせいさく": "فصل عرقي (الفصل حسب العرق)",
 "じんしゅがく": "إِتْنُولُوجِيَة",
 "じんしゅさべつ": "تمييز عنصري, عنصرية (سلوك تمييزي أو مسيء تجاه أفراد من عرق آخر)",
 "じんしゅさべつしゅぎ": "عِرْقِيَّة, عُنْصُرِيَّة",
 "じんしゅさべつしゅぎしゃ": "عُنْصُرِيّ, عُنْصُرِيَّة",
 "じんしゅしゅぎ": "عِرْقِيَّة, عُنْصُرِيَّة",
 "じんしゅじょう": "عِرْقِيّ, عُنْصُرِيّ",
 "じんしゅてき": "عِرْقِيّ, عُنْصُرِيّ",
 "じんしゅぼうどう": "شغب عرقي (شغب ناتج عن الكراهية بين أعضاء أعراق مختلفة في نفس المجتمع)",
 "じんしょ": "مُخَيِّم",
 "じんしょう": "اعتلال الكلية, مرض كلوي (مرض يصيب الكلى)",
 "じんしょうたい": "جسيم ملبيغي, كرية كلوية (المحفظة التي تحتوي على محفظة بومان والكبيبة عند النهاية المتوسعة للنفرون)",
 "じんしん": "فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / النزعَة إلى الخير / طبيعة بشرية (السمات النفسية المشتركة للبشرية التي يفترض أنها مشتركة بين جميع البشر)\nمثال: مراقب عظيم للطبيعة البشرية / جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان / آذريون المستنقع, قطيفة المستنقع (نبات مستنقعات من أوروبا وأمريكا الشمالية ذو أزهار صفراء زاهية تشبه الحوذان) / ذيل السحلية, زنبق المستنقع (نبات معمر عشبي من أمريكا الشمالية في الأماكن الرطبة له عناقيد رفيعة مجعدة من الزهور البيضاء الصغيرة)",
 "じんしんきょうきょう": "مَذْعُور",
 "じんしんこうげき": "شَخْصَنَة",
 "じんしんとりひき": "اِتِّجَار بِالْبَشَر",
 "じんしんばいばい": "اِتِّجَار بِالْبَشَر",
 "じんしんほご": "أمر المثول, حق المثول أمام القضاء (الحق المدني في الحصول على أمر بالمثول أمام القضاء كحماية ضد السجن غير القانوني) / أمر المثول أمام القضاء, هابياس كوربوس (أمر بإحضار سجين أمام قاضٍ)",
 "じんしんほごれいじょう": "أمر المثول أمام القضاء, هابياس كوربوس (أمر بإحضار سجين أمام قاضٍ)",
 "じんじ": "ساعة (فترة زمنية تعادل 1/24 من اليوم)\nمثال: ستستغرق المهمة أكثر من ساعة / حَنُون بِالفِطْرَة, طَيِّب القَلْب (ذو طبع فطري طيّب وحنون)",
 "じんじいどう": "إعادة خلط, تعديل وزاري (الخلط مرة أخرى) / إعادة خلط, تعديل وزاري (إعادة توزيع لشيء ما)\nمثال: طلب المقامر إعادة خلط الأوراق",
 "じんじつ": "طِوَال اليَوْم, نَهَارًا (خلال اليوم بأكمله)\nمثال: الضوء يتدفق طوال اليوم في الغرفة / يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "じんじふせい": "فِقْدَان اَلْوَعْي, إِغْمَاء",
 "じんじぶ": "إدارة الموارد البشرية, قسم شؤون الموظفين (القسم المسؤول عن تعيين وتدريب وتوزيع الموظفين ووضع سياسات إدارة الأفراد)",
 "じんじゅう": "سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ) / عَمِيقٌ مِنَ الأَعْمَاق (نَابِعٌ مِنْ أَعْمَاقِ النَّفْس) / بَالِغُ العُمْق, عَمِيقٌ جِدًّا (مِنْ أَشَدِّ دَرَجَاتِ الحِدَّةِ؛ تَامّ)",
 "じんじゅうきょうつうかんせんしょう": "مرض حيواني المنشأ (مرض حيواني يمكن أن ينتقل إلى البشر)",
 "じんじゅつ": "كلب الماء (كلب معتاد على الماء وعادة ما يتم تدريبه لاسترداد الطيور المائية) / محب الماء (شخص يستمتع بالتواجد في الماء أو عليه)",
 "じんじょ": "النزعَة إلى الخير",
 "じんじょう": "شَائِع / أَشْقَر (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان لونه أصفر أيضا؛ صفة ما كان لونه الشُقرة) / حَقَّانِيّ, عادِل / مَأْذُون, مُبَاح\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر. / إِفْرَنْجِيّ / غَيْرُ مُتَكَلَّف, مُتَحَفِّظ (يُظْهِرُ ذَوْقًا رَفِيعًا بِتَحَفُّظٍ وَاعْتِدَال)",
 "じんじょういちよう": "عَادِيّ, مَأْلُوف",
 "じんじょうしょうがっこう": "مدرسة ابتدائية (مدرسة للأطفال الصغار؛ عادة ما تكون الصفوف الستة أو الثمانية الأولى)",
 "じんじょうせいざそう": "حب الشباب الشائع (أكثر أشكال حب الشباب شيوعًا؛ يصيب عادة الأشخاص من سن البلوغ إلى مرحلة الشباب)",
 "じんじょうせいはくはん": "بُهَاق",
 "じんじょうせいろうそう": "ذئبة شائعة (سل الجلد؛ يظهر أولاً على الوجه ويشفى ببطء تاركًا ندوبًا عميقة)",
 "じんじょうならざる": "غَيْر مَأْلُوف (لا يُصادف عادة) / استثنائي, غير عادي (غير معتاد أو غير شائع أو غير عادي) / شاذ, عجيب (خارج عن المألوف وغير متوقع بشكل قاطع؛ غريب قليلاً أو حتى شاذ)\nمثال: مشهد ذو جمال غير عادي",
 "じんじょうみゃく": "وريد كلوي (أوردة ترافق الشرايين الكلوية؛ تفتح في الوريد الأجوف عند مستوى الفقرة القطنية الثانية)",
 "じんじん": "إِنْسَانَوِيّ (يتّسم بالقيم الإنسانويّة والتفاني في رعاية البشر) / إنساني (من أو يتعلق بالمذهب الإنساني أو يميزه) / إنساني (مدافع عن مبادئ الإنسانية؛ شخص مهتم بمصالح البشر ورفاهيتهم) / إنساني, فاعل خير (شخص مكرس لتعزيز رفاهية الإنسان والإصلاحات الاجتماعية)\nمثال: مساعدات إنسانية / قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / مَنِيع, مَتِيْن / قَوِيّ, راسِخ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل) / شَدِيْد, قَوْيّ / شَدِيْد / حَادّ, ثَقِيْل (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / بِقُوَّة\nمثال: كانت صدمة قوية. / مُتَقَطِّع / مَوْسِمِيّ / دَاغِدِغ, مُوَخِّز (يُثِير بلمسة خفيفة تُسَبِّب الضحك أو الارتعاش) / تنميل, وخز (إحساس جسدي يشبه العديد من اللسعات الصغيرة) / طَنِين",
 "じんすい": "مَنِيّ",
 "じんずうりき": "قدرة سحرية (القدرة على أداء السحر)",
 "じんせい": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة! / طبيعة بشرية (السمات النفسية المشتركة للبشرية التي يفترض أنها مشتركة بين جميع البشر)\nمثال: مراقب عظيم للطبيعة البشرية / شدة, صعوبة هائلة (صعوبة مثيرة للإعجاب) / صلابة, متانة (مرونة وصلابة جسم معدني؛ قدرته على امتصاص طاقة كبيرة قبل التشقق) / خشونة, قوة (خاصية كون الشخص كبيراً وقوياً) / جلد, قوة احتمال (قوة وطاقة دائمة)",
 "じんせいかん": "استطلاع, ترقب (فعل النظر للخارج أو الترقب) / أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / ذهنية, عقلية (موقف ذهني اعتيادي أو مميز يحدد كيفية تفسير المواقف والاستجابة لها)",
 "じんせいそうだんらん": "ناصحة اجتماعية (كاتبة عمود في صحيفة تجيب على الأسئلة وتقدم النصائح حول المشاكل الشخصية للقراء)",
 "じんせいにしゅうめ": "تَنَاسُخُ الأَرْوَاحِ",
 "じんせいのまっさかり": "أوج العمر, ريعان (وقت النضج عندما تكون القوة والحيوية في ذروتها)",
 "じんせいは": "إِنْسَانَوِيّ (يتّسم بالقيم الإنسانويّة والتفاني في رعاية البشر) / إنساني (متعلق بـ أو معني بالعلوم الإنسانية) / إنساني (مكون من أو متعلق بإنسانية عصر النهضة) / إنساني (مكون من أو متعلق بفلسفة تؤكد الكرامة الإنسانية وقدرة الإنسان على التحقق من خلال العقل والمنهج العلمي وغالباً ما ترفض الدين)\nمثال: دراسات إنسانية",
 "じんせいわずかごじゅうねん": "الحياة قصيرة, العمر لحظة",
 "じんせいゲーム": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة!",
 "じんせき": "حَصَاة كُلْوِيَّة",
 "じんせきみとう": "غَيْر مُكْتَشَف (لم يُكتشَف بعد)",
 "じんせん": "إِنْشْيُون",
 "じんせんぷう": "زوبعة غبارية, عفريت الغبار (دوامة هوائية مصغرة قوية بما يكفي لرفع الغبار والأوراق والنفايات في الهواء)",
 "じんそ": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "じんそく": "سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي.",
 "じんぞう": "مُتَصَنَّع, صِنَاعِيّ / كُلْيَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: في أي كلية تدرس؟",
 "じんぞうえん": "التهاب الكلية, مرض برايت (التهاب في الكلى)",
 "じんぞうがく": "طب الكلى (فرع الطب المعني بالكلى - تطورها وتشريحها وفسيولوجيتها واضطراباتها)",
 "じんぞうけっせき": "حَصَاة كُلْوِيَّة",
 "じんぞうけんし": "حرير صناعي, رايون (قماش صناعي يشبه الحرير)",
 "じんぞうこ": "بحيرة صناعية, خزان مائي (بحيرة تستخدم لتخزين المياه للاستخدام المجتمعي؛ بحيرة (طبيعية أو اصطناعية) تستخدم لتخزين المياه واستخدامها كمصدر للمياه)",
 "じんぞうご": "لغة مبنية, لغة مصطنعة (لغة تم إنشاؤها عمداً لغرض محدد)",
 "じんぞうせんい": "ألياف صناعية, ألياف من صنع الإنسان (ألياف تم إنشاؤها من مواد طبيعية أو عن طريق عمليات كيميائية)",
 "じんぞうないか": "طب الكلى (فرع الطب المعني بالكلى - تطورها وتشريحها وفسيولوجيتها واضطراباتها)",
 "じんぞうにんげん": "أَنْدْرُويِد",
 "じんぞうびょう": "اعتلال الكلية, مرض كلوي (مرض يصيب الكلى)",
 "じんぞうびょうがく": "طب الكلى (فرع الطب المعني بالكلى - تطورها وتشريحها وفسيولوجيتها واضطراباتها)",
 "じんぞうバター": "سَمْن نَبَاتِيّ (الدُهُون التي تؤكل، وتشمل الزُبْد والقِشْطَة وما يستخرج من الحَيْوَان والنبات. قيل السمن من الحيوان والدهن من النبات وقيل السمن ما يؤكل والدهن ما لا…)",
 "じんたい": "جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان / رِبَاط",
 "じんたいれいとうほぞん": "تجميد البشر, كريونيكس (تجميد شخص مريض بشكل خطير أو متوفى حديثاً لوقف تحلل الأنسجة؛ يتم الحفاظ على الجسم حتى يتم تطوير علاجات طبية جديدة قد تعيد الشخص إلى الحياة)\nمثال: تجميد البشر هو خيال علمي أكثر منه علم جاد",
 "じんたんい": "وَحْدَة أُنْبُوبِيَّة كُلْوِيَّة, كُلْيُون",
 "じんだい": "ضَخْم, هَائِل / مِثَالَة / مَانِيكَان / مَانُوكَان",
 "じんだいめいし": "ضمير شخصي (ضمير يعبر عن تمييز الشخص (المتكلم، المخاطب، الغائب))",
 "じんだて": "تَشْكِيلَة",
 "じんち": "مَحَلَّة, مُخَيَّم (ما دون الحَيّ وفوق المَنْزِل. قيل قرابة مئة بيت ومجلس ومسجد؛ تقسيم إداري للمناطق السكنية في المدن. أصغر من الحيّ وأكبر من الزُقَاق) / جَانِب / صَفْحَة / عِلْم, مَعْرِفَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "じんちがく": "أنثروبوصوفيا (نظام من المعتقدات والممارسات القائمة على فلسفة رودولف شتاينر؛ تدعي دمج الجوانب العملية والنفسية في التعليم المتمحور حول الطفل)",
 "じんちくきょうつうかんせんしょう": "مرض حيواني المنشأ (مرض حيواني يمكن أن ينتقل إلى البشر)",
 "じんちくむがい": "تافه, غير مهم (ليس مهماً) / تافه, ضئيل الشأن (خالٍ من الأهمية أو المعنى أو القوة)\nمثال: ميزة غير مهمة نسبياً للنظام",
 "じんちゅう": "خِنْزِير غِينِيَّا / وَفَاء, إِخْلَاص / نَثْرَة",
 "じんちゅうしょく": "جراية ميدانية, حصة ميدانية (حصص غذائية تصرف للقوات العسكرية في الميدان)",
 "じんちょう": "بِطْرِيق",
 "じんちょうるい": "بِطْرِيق",
 "じんつう": "آلام المخاض (تشنج ألم متكرر بانتظام وهو سمة من سمات الولادة)",
 "じんつうりき": "قدرة سحرية (القدرة على أداء السحر)",
 "じんづうりき": "قدرة سحرية (القدرة على أداء السحر)",
 "じんてい": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / تجسيد, تقمص (تمثيل دور شخصية على المسرح؛ تمثيل الشخصية بشكل درامي عن طريق الكلام والفعل والإشارة) / إقرار, سن (تمرير قانون من قبل هيئة تشريعية) / تشريع, قانون (وثيقة قانونية تدون نتيجة مداولات لجنة أو جمعية أو هيئة تشريعية)",
 "じんていほう": "تَرْكِيبِيّ, مَصْنُوع (ليس من أصل طبيعي؛ أُعِدّ أو صُنِع صناعيًّا)",
 "じんてき": "بَشَرِيّ, إنْسَانِيّ / آدْمِيّ, بَشَرِيّ / إِنْسَان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / إِنْس / إنسان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / بنيآدم\nمثال: أنا إنسان صادق.",
 "じんてきそんしつ": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "じんてきひがい": "خسائر, خسارة (نقصان في الأفراد أو المعدات العسكرية) / إصابة مميتة, حادث مميت (حادث يتسبب في موت شخص ما) / ضَحِيَّة حادِث, مُصاب (شخص أصيب أو قتل في حادث) / إِصابَة, خَسارَة بَشَرِيَّة (شخص أصيب أو قتل أو أسر أو فقد في اشتباك عسكري)",
 "じんでんごう": "أبدية, خلود (زمن بلا نهاية)",
 "じんと": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً) / بِعُمْق (إلى عمق كبير؛ بعيداً للأسفل أو للداخل)\nمثال: شعروا بالخسارة بعمق / جَارِح, لَاذِع ((في الكلام) حادّ أو مؤذٍ في النبرة أو الطابع) / لسعة (نوع من الألم؛ شيء مفاجئ ومؤلم كأنك تعرضت للدغ)\nمثال: لسعة الموت",
