 "じっしょうてつがく": "إِيجَابِيَّة, يَقِين (صفة أو حالة تتميز باليقين أو القبول أو التأكيد والتوكيد الجازم)",
 "じっしょうろん": "إِيجَابِيَّة, يَقِين (صفة أو حالة تتميز باليقين أو القبول أو التأكيد والتوكيد الجازم)",
 "じっしょく": "أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ.",
 "じっしれい": "تَجَسَّد",
 "じっしん": "عَشْرِيّ / يَوْمِيّ (يتعلق بكل يوم أو يحدث كل يوم)",
 "じっしんしょうすう": "كَسْر عَشْرِيّ (كسر حقيقي مقامه قوة للعدد 10)",
 "じっしんしょうすうてん": "فَاصِل عَشْرِيّ",
 "じっしんすう": "عَشْرِيّ",
 "じっしんせい": "النظام العشري, نظام العد العشري (نظام عد موضعي يستخدم أرقاماً عشرية وأساساً هو العشرة)",
 "じっしんひょうき": "تدوين عشري (أي تدوين يستخدم 10 أحرف مختلفة (عادة الأرقام من 0 إلى 9))",
 "じっしんほう": "النظام العشري, نظام العد العشري (نظام عد موضعي يستخدم أرقاماً عشرية وأساساً هو العشرة)",
 "じっすう": "عَدَد حَقِيقِيّ (أي عدد نسبي أو غير نسبي)",
 "じっすうたい": "عَدَد حَقِيقِيّ (أي عدد نسبي أو غير نسبي)",
 "じっせい": "حَقِيقِيّ, وَاقِعِيّ",
 "じっせいかかく": "سعر السوق, قيمة سوقية (السعر الذي يتبادل به المشترون والبائعون السلعة في سوق مفتوح)",
 "じっせいかつ": "حَيَاة وَاقِعِيَّة, حَيَاة حَقِيقِيَّة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول:…)\nمثال: ما أغرب الحياة!",
 "じっせかい": "عَالَم وَاقِعِيّ (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "じっせき": "إِنْجَاز",
 "じっせきデータ": "تَسَبَّب",
 "じっせん": "تَدْرِيب (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة…)\nمثال: واصل زيري التدريب. / تطبيق عملي, ممارسة (ترجمة فكرة إلى عمل)\nمثال: نظرية صعبة التطبيق العملي / قِتَال (من قَتَلَ: كثير القَتْل)\nمثال: لن يحل القتال أي شيء.",
 "じっせんか": "رَجُل عَمَل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول…)\nمثال: هذا الرجل تاجر.",
 "じっせんしゃ": "مُمَارِس",
 "じっせんてき": "تَطْبِيقِيّ",
 "じっそう": "تَنْفِيذ / وَاقِع, حَقِيقَة (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة)\nمثال: أنا واقع في حبك",
 "じっそうみつど": "سُكَّان",
 "じっそく": "اِسْتِبَانَة, اِسْتِطْلَاع",
 "じったい": "مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / وَاقِع, حَقِيقَة (الأمر الذي حَدَثَ وحَصَلَ؛ الحَال كما هي عليه، الحَقِيقَة الملموسة)\nمثال: أنا واقع في حبك",
 "じったいか": "إثبات, تحقق (فعل التحقق من الصحة؛ إيجاد أو اختبار حقيقة شيء ما)\nمثال: قدمت الحفريات تأكيداً إضافياً لنظرية التطور / تجسيد, تمثيل فعلي (تمثيل لفكرة ما في شكل نموذج أو حالة فعلية منها)\nمثال: كم عدد التجسيدات التي تم العثور عليها؟",
 "じったいきょう": "ستيريوسكوب, منظار مجسم (جهاز بصري لعرض الصور المجسمة)",
 "じったいちょうさ": "تقصي الحقائق",
 "じったいほう": "قَانُون مَوْضُوعِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "じっち": "تَدْرِيب (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة…)\nمثال: واصل زيري التدريب. / مَنْظَر, مَشْهَد",
 "じっちくんれん": "أثناء العمل, وظيفي (متعلق بـ أو مرتبط بوظيفة أو توظيف)\nمثال: تدريب أثناء العمل",
 "じっちけんしゅう": "عمل ميداني (تحقيق يتم إجراؤه في الميدان بدلاً من المختبر أو المقر الرئيسي)",
 "じっちしどう": "تَطْبِيقِيّ, مُبَاشِر (ينطوي على مشاركة فعليّة ومباشرة)",
 "じっちゃん": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم…)\nمثال: عليك العمل بجد.",
 "じっちゅうぎ": "بولينغ ذو عشرة دبابيس (البولينغ في مسار نحو هدف مكون من عشرة دبابيس خشبية)",
 "じっちゅうはっく": "على الأرجح, غالباً (بدرجة كبيرة من اليقين؛ دون شك كبير)\nمثال: من المحتمل أنه خارج البلاد",
 "じっちょく": "نَزِيه, صَادِق",
 "じってい": "نَزِيه, صَادِق",
 "じってんぽ": "طوب وملاط (مادة بناء تتكون من طوب موضوع مع ملاط بينه)",
 "じっと": "بلا حراك (بدون حركة؛ بطريقة ساكنة)\nمثال: رأى الرجل ذا الشعر الأسود ينتظر بلا حراك خلف الجانب الآخر من المنصة / بتركيز, بثبات (بطريقة ثابتة ومركزة)\nمثال: حدق بي بثبات / بصبر (مع صبر؛ بطريقة صبورة)\nمثال: لعب بصبر مع الطفل / بإصرار, بثبات (بتصميم حازم)\nمثال: صدقنا ذلك بحزم",
 "じっとくナイフ": "سِكِّين سْوِيسِرِيّ (أَدَاةٌ حَادَةٌ تُسْتَخْدَمُ فِي تَقْطِيعِ مُخْتَلَفِ أَصْنَافِ الطَّعَامِ…)\nمثال: أحتاج الى سكين.",
 "じっとみる": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ…)\nمثال: حدق الجميع في وجهي.",
 "じっとり": "بِتَبَلُّل, بِرُطُوبَة (بطريقة رطبة)\nمثال: كان هناك وشاح مربوط حول رأسها لكن الخصلة المتمردة هربت وتدلت برطوبة فوق عينها اليسرى",
 "じっと見る": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ…)\nمثال: حدق الجميع في وجهي.",
 "じっぱり": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "じっぴ": "مِنَ الجَيْب, نَقْدِيّ (يستلزم إنفاق مال نقديّ مباشر)",
 "じっぷかくていけんさ": "اختبار الأبوة (اختبار يعتمد على فصائل الدم لتحديد ما إذا كان رجل معين يمكن أن يكون الأب…)",
 "じっぽう": "خَرْطُوش, خَرْطُوشَة / فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "じっぽん": "عَشَرَة, عَشْرَة",
 "じつ": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة. / إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله…) / رَاضٍ, مُرْتَاح (رَاضَ (راضه)روضا ورياضا ورياضة: ذلله. يقال راض المهر وراض نفسه بالتقوى وراض…)\nمثال: سامي غير راض بوظيفته. / تَسَبَّب",
 "じつい": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله…)",
 "じつう": "أَلَم الأُذُنِ, أَلَم الأُذْنِ (الوَجَع)\nمثال: ألم أقل لك ذلك؟",
 "じつえき": "فَائِدَة, جَدْوَى",
 "じつえん": "مُظَاهَرَة, تَظَاهُر (مُظَاهَرَة من أجل تحقيق هدف معين ٠)\nمثال: قرابة الألف شاركوا في المظاهرة. / أَدَاء",
