 "どんけつ": "حِمَار (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة) / حُمار (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة) / عَجِيزَة, مُؤَخَّرَة\nمثال: هن بحاجة لحمار.",
 "どんさい": "غَبَاء, غَبَاوَة (بمعنى أن يخفى الأمر، يقال أيضا غَبَاءَة وغَبَاوَة والغباء أعمّ؛ بمعنى ضد الفِطْنة والذَكاء، يقال أيضا غَبَاوة)\nمثال: ما تقترحه غباء.",
 "どんじゅう": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "どんだけ": "كَمْ / يَا إِلٰهِي, يَا سَلَام (يستعمل لنِدَاء البعيد والقريب)\nمثال: يا لها من جملة!",
 "どんづまり": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "どんと": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "どんとう": "مُدَوَّر (اسم فاعل من دَوَّرَ، الشخص الذي يُدَوِّر)\nمثال: هناك طاولة مدورة في غرفة الضيوف.",
 "どんどん": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / بِسُرْعَة, عَاجِلًا / باستمرار",
 "どんな": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة! / مَهْمَا",
 "どんなぎせいをはらっても": "بِأَيِّ ثَمَنٍ",
 "どんなに": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ / بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال",
 "どんな犠牲を払っても": "بِأَيِّ ثَمَنٍ",
 "どんぱち": "صِرَاع, نِزَاع",
 "どんぶつ": "مُغَفَّل, أَحْمَق",
 "どんぶりばち": "زِبْدِيَّة / سُلْطَانِيَّة / زُبْدِيَّة",
 "どんぶり鉢": "زِبْدِيَّة / سُلْطَانِيَّة / زُبْدِيَّة",
 "どんべ": "قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما.",
 "どんまい": "غَيْر مُهِمّ, لَا بَأْس (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "どんよく": "طَمَّاع, جَشِع / شرِه, نهِم ((شَرِهَ) إلى الطعام وغيره، وشَرِهَ عليه يَشْرَهَ شَرَهًا: اشتد حرصُه عليه واشتِهاؤه له؛ فهو شَرِهٌ وشَرْهَانُ، وهي شَرِهة وشَرْهَى)\nمثال: كانت صوفيا شرهة.",
 "どんより": "غَامِق, دَاكِن / ثَقِيل",
 "どんらん": "طَمَع, شُحُّ",
 "どん尻": "حِمَار (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة) / حُمار (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة) / عَجِيزَة, مُؤَخَّرَة\nمثال: هن بحاجة لحمار.",
 "どん詰まり": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "どん詰り": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "どスケベ": "مُنْحَرِف, مُنْحَرِفَة",
 "どストライク": "إصابة دقيقة للهدف (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى)\nمثال: تعرض زيري لإصابة. / كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه)",
 "どーして": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ / لِمَاذَا / لِمَ (جَمَعَ، ضَمَّ) / علاش / علاه\nمثال: لم يساعدني أحد.",
 "どーたらこーたら": "فُلَان, فُلَانَة (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو شخص لا يريد المتحدث ذكره)\nمثال: سمعنا ذلك من فلان و فلان.",
 "どーん": "فَرْقَعَة",
 "ど偉い": "عِمْلاق",
 "ど性骨": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "ど百姓": "فَلَّاح, فَلَّاحَة",
 "ど突く": "لَكْمَة أَمَامِيَّة",
 "ど頭": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "な": "أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات؛ صفة ما كان لونه أخضرا) / خُضْر (خَضَر الرجلُ النَّخْلَ خَضَر ُ خَضْرًا: قطعه)\nمثال: ذلك الضوء أخضر. / اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "な〜": "يَاه, اسمع / هَلَا / يَعْنِي / عَجَبًا / سُبْحَانَ الله (مصدر للفعل سَبَحَ؛ تُقال حصرًا للَّٰه، كما في العبارة \"سُبْحَانَ اللَّٰهِ\")\nمثال: سبحان الله عما يشركون.",
 "なぁ": "يَاه, اسمع / هَلَا / يَعْنِي / عَجَبًا / سُبْحَانَ الله (مصدر للفعل سَبَحَ؛ تُقال حصرًا للَّٰه، كما في العبارة \"سُبْحَانَ اللَّٰهِ\")\nمثال: سبحان الله عما يشركون.",
 "なあ": "سَبْعَة\nمثال: 私は今朝7時に起きた。 — استيقظت في السابعة هذا الصباح.",
 "なあて": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
