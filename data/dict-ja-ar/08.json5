 "すいはんジャー": "طباخة أرز, قدر طهي الأرز (جهاز مطبخ آلي مصمم لسلق أو طهي الأرز بالبخار)",
 "すいば": "حُمَّاض بُسْتَانِيّ\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر.",
 "すいばく": "قنبلة هيدروجينية (سلاح نووي يطلق طاقة ذرية عن طريق اتحاد نوى خفيفة (هيدروجين) عند درجات حرارة…)",
 "すいばん": "تَوْصِيَة",
 "すいばんどこう": "بوكسيت (معدن شبيه بالطين؛ الخام الرئيسي للألمنيوم؛ يتكون من أكاسيد الألمنيوم…)",
 "すいひょう": "جَلِيد, ثَلْج",
 "すいび": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "すいふ": "بَحَّار (صيغة مبالغة من بَحَرَ بمعنى الذي يبحر كثيرا؛ الرجل الذي يتخذ من الملاحة أي ركوب…)\nمثال: هى متزوجة من بحار. / طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ)\nمثال: زوجي طباخ ماهر.",
 "すいふく": "إِعْجَاب",
 "すいふちょう": "رئيس البحارة (ضابط صف على سفينة تجارية يراقب عمل البحارة الآخرين)",
 "すいふよう": "ورد القطن, ورد كونفدرالي (شجيرة صينية أو شجرة صغيرة ذات زهور بيضاء أو وردية تصبح حمراء داكنة في الليل…)",
 "すいぶ": "فرقة عسكرية, فرقة موسيقية للحفلات (مجموعة من الموسيقيين يعزفون على الآلات النحاسية وآلات النفخ الخشبية والإيقاعية)",
 "すいぶん": "مِيَاه",
 "すいぶんほきゅう": "إِمَاهَة / هَايْدْرَات",
 "すいへい": "بَحَّار (صيغة مبالغة من بَحَرَ بمعنى الذي يبحر كثيرا؛ الرجل الذي يتخذ من الملاحة أي ركوب…)\nمثال: هى متزوجة من بحار. / أُفُقِيّ / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "すいへいき": "مُسْتَوًى",
 "すいへいしこう": "تفكير جانبي (نهج استكشافي لحل المشكلات؛ حيث تحاول النظر إلى المشكلة من زوايا عديدة بدلاً من…)",
 "すいへいせん": "أُفُق ((أَفِقَ) أفَقَاً: بلغ النِّهَايَة فِي الْكَرم وَالْعلم فَهُوَ أفق وأفيق)\nمثال: طلعت الشمس فوق الأفق.",
 "すいへいてんかい": "شَعْبِيّ قَاعِدِيّ (يتعلق بعامة الناس بوصفهم جماعة سياسية واقتصادية أساسية)",
 "すいへいびよく": "ذيل الطائرة, مثبت أفقي (السطح الانسيابي الأفقي لمجموعة ذيل الطائرة الذي يكون ثابتاً ويتم تعليق الرافع…)",
 "すいへん": "جانب الماء (أرض متاخمة لجسم مائي)",
 "すいほ": "سير عشوائي (عملية عشوائية تتكون من سلسلة من التغييرات التي يتم تحديد خصائص كل منها (مثل…)",
 "すいほう": "رَغْوَة\nمثال: اشترت رطلي زبدة. / لَا شَيْء (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة. / بَطْبَاطَة, نَفْطَة",
 "すいぼ": "قِنْدِيل الْبَحْر (مصباح فيه فتيل يُضاء بالزيت)",
 "すいぼう": "خَرَاب, خَرَابَة",
 "すいぼくさんすい": "فن المناظر الطبيعية (نوع فني يتعامل مع تصوير المناظر الطبيعية)",
 "すいぼつ": "انغمار, غمر (الغرق حتى التغطية بالماء تماماً)",
 "すいま": "نُعَاس, سِنَة / رجل الرمل (قزم في قصص الأطفال ينثر الرمل في عيون الأطفال ليجعلهم ينامون) / كلب الراعي الأسترالي, كيلبي (كلب راعي أسترالي ذو آذان مدببة)",
 "すいません": "آسِف",
 "すいみつ": "رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب)",
 "すいみゃく": "مَمَرّ مَائِيّ (على مَمَرّ العصور: على طولها ومداها؛ على مَمَرّ الفصول: على تواليها وتعاقبها)\nمثال: الباب في نهاية الممر.",
 "すいみゃくうらない": "تكهن بالعصا, كشف المياه (البحث عن المياه الجوفية أو المعادن باستخدام عصا الكشف)",
 "すいみん": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة.",
 "すいみんがくしゅう": "تعلم أثناء النوم (التدريس أثناء النوم (مثل استخدام التسجيلات لتعليم لغة أجنبية لشخص نائم))",
 "すいみんざい": "حبة منوم, قرص منوم (دواء منوم على شكل حبة (أو قرص أو كبسولة))",
 "すいみんしゃだん": "حرمان من النوم (شكل من أشكال التعذيب النفسي يتم عن طريق حرمان الضحية من النوم)",
 "すいみんしょうがい": "اضطراب النوم (خلل في نمط النوم الطبيعي)",
 "すいみんじむこきゅうしょうこうぐん": "اِنْقِطَاع النَّفَس أَثْنَاء النَّوْم",
 "すいみんじゆうこうしょう": "سير أثناء النوم, مشي نائم (المشي من قبل شخص نائم)",
 "すいみんびょう": "التهاب الدماغ السباتي, مرض النوم (التهاب دماغ كان وبائياً بين عامي 1915 و1926؛ تشمل الأعراض شلل عضلة العين…)",
 "すいみんぶそく": "حرمان من النوم (شكل من أشكال التعذيب النفسي يتم عن طريق حرمان الضحية من النوم)",
 "すいみんほっさ": "تَغْفِيق",
 "すいみんまひ": "شَلَل النَّوْم, جَاثُوم",
 "すいみんやく": "مُنَوِّم",
 "すいみんをとる": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة.",
