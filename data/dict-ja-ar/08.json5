 "はしばみ": "بَاشِق",
 "はしばみのみ": "بُنْدُق, بُنْدُقَة (نوع من الثَمَر صلب ينمو محاطا بغلاف صلب كالجَوْز يكثر في الشَام. الحبة الواحدة بُنْدُقَة ولا يُجْمَع؛ الشجر الذي يُثمِرُ بُنْدُقًا، يُجمع على بُنْدُقَات)",
 "はしびろこう": "أبو مركوب",
 "はしゃ": "غَازٍ / نَصِير, نَصِيرَة",
 "はしゅ": "مِقْبَض",
 "はしょうふう": "كُزَاز, كُزَّاز",
 "はしょる": "قَصَّر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "はしら": "عمود / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "はしらす": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / قَادَ, سَاقَ / سَاقَ / رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض.",
 "はしらせる": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / قَادَ, سَاقَ / سَاقَ / رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض.",
 "はしらどけい": "سَاعَة جَدّ (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن)\nمثال: درست لمدة ساعة.",
 "はしらま": "خَلِيج, شَرْم",
 "はしり": "رَكْض (عَدَا)\nمثال: إنها تحب الركض. / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "はしりがき": "خربشة",
 "はしりさる": "هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "はしりだす": "خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ) / أَقْلَعَ / اِزْدَهَرَ\nمثال: خلع سامي حذاءه.",
 "はしりでる": "نَفِدَ",
 "はしる": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض. / اِنْدَفَعَ, أَسْرَعَ / سَمَار / تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ / هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "はしをとる": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "はじ": "خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق) / عَار\nمثال: توم لص بلا خجل.",
 "はじお": "قَلَح, قَلْح",
 "はじかみ": "زَنْجَبِيل / أَصْهَب",
 "はじき": "مُسَدَّس, طَبَنْجَة (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ) / مِدْفَع (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)\nمثال: كان عند زيري مسدس.",
 "はじきおん": "رَفْرَف",
 "はじきかえす": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "はじきだす": "دَفَعَ, صَدَّ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / حَسَبَ (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال. / طَرَدَ, نَفَى",
 "はじきだま": "كُرَيَّات",
 "はじきとばす": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "はじき出す": "دَفَعَ, صَدَّ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / حَسَبَ (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال. / طَرَدَ, نَفَى",
 "はじき音": "رَفْرَف",
 "はじき飛ばす": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "はじく": "قَلَبَ / دَفَعَ, صَدَّ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن. / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "はじける": "بُوب, مُوسِيقَى شَعْبِيَّة / مُتَّجِه",
 "はじさらし": "عَار, خِزْي",
 "はじしらず": "وَقِح, صَفِيق",
 "はじっこ": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "はじまり": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل",
 "はじまる": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / حَدَثَ, جَرَى (وَقَعَ الأمر؛ نقيض قَدُمَ، كان حَدِيثا)\nمثال: لا أصدق ما حدث. / حتّى الآن (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "はじむ": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "はじめ": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل",
 "はじめて": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة.",
 "はじめとする": "شَامِل",
 "はじめに": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "はじめは": "أَصْلًا",
 "はじめる": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "はじらい": "خَجَل, حَيَاء (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق)\nمثال: توم لص بلا خجل.",
 "はじらう": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر) / رُوج (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها.",
 "はじをしる": "اِسْتَحَى\nمثال: 恥を知れ！ — عار عليك!",
 "はす": "نَيْلُوفَر",
 "はすう": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب) / كَسْر, كُسُور\nمثال: يصنع قطعة أثاث خشبية.",
 "はすかい": "مَائِل, قُطْرِيّ",
 "はすっぱ": "بَذِيء",
 "はすにかまえる": "فِرَاش, أَرِيكَة",
 "はすは": "بَذِيء",
 "はすば": "بَذِيء",
 "はすわ": "بَذِيء",
 "はす交い": "مَائِل, قُطْرِيّ",
 "はず": "يَنْبَغِي أَنْ / مِنْ اَلْمَفْرُوض أَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / مِنْ اَلْمُفْتَرَض أَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "はずい": "أَخْجَلَ (أَخْجَلَ (النباتُ): خَجِلَ؛ أَخْجَلَ (فلانًا): جعله يخجل)\nمثال: أخجل من تصرف ولدي.",
 "はずかしい": "أَخْجَلَ (أَخْجَلَ (النباتُ): خَجِلَ؛ أَخْجَلَ (فلانًا): جعله يخجل)\nمثال: أخجل من تصرف ولدي.",
 "はずかしがる": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر) / رُوج (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها.",
 "はずかしげ": "مُحْرَج, بِٱلْحَرَج",
 "はずかしめ": "خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق) / عَار\nمثال: توم لص بلا خجل. / اِنْتِهَاك",
 "はずかしめる": "أَخْزَى, اِسْتَذَلَّ (أَخْزَى: (فعل) أخزَى يُخزي ، أخْزِ ، إخزاءً ، فهو مُخْزٍ ، والمفعول مُخزًى) / اِنْتَهَكَ",
 "はずす": "نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا. / قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه. / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "はずみ": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / يَاي, زُنْبُرُك\nمثال: كان عين ليلى مسودة. / زَخَم حَرَكَة (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…) / زَخَم (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…)\nمثال: يمكنك أن تتعلم بنفس الزخم في المكتبة كما في المدرسة. / عَزْم / لَحْظَة, دَقِيقَة",
 "はずみぐるま": "حَدَّافَة",
 "はずみをつける": "شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "はずむ": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / يَاي, زُنْبُرُك\nمثال: كان عين ليلى مسودة.",
 "はずれ": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "はせいご": "مشتقّ",
 "はせいてき": "مشتقّ",
 "はせつ": "كَسْر, اِنْكِسَار / كَسْر / يكسر, ينكسر",
 "はせる": "رَكَضَ (عَدَا) / جَرَى (تحرك من مكان إلى آخر بصورة مستمرة وسريعة؛ الماء أو النهر أو السائل: سالَ)\nمثال: إنها تحب الركض. / رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "はせん": "حُطَام سَفِينَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)",
 "はせんふごう": "تِلْدَة",
 "はぜる": "بُوب, مُوسِيقَى شَعْبِيَّة",
 "はそく": "قَبْضَة",
 "はそん": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة.",
 "はた": "قاروس, قاروص",
 "はたいろ": "حَالَة, وَضْع / تَبَعِيَّة, اِنْتِمَاء (التَّبَعيَّة : كَوْن الشخص أو الشيْ تابعاً لغيره؛ مصدر صناعيّ من تَبَعَ: جِنْسِيَّة ومُواطَنَة أو انتماء إلى دولة ما، يكون للمواطن فيها حقوق وامتيازات، وبالمقابل عليه واجبات)",
 "はたうち": "حَرْث (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: حرث المزارع أرضه.",
 "はたおり": "نَسَجَ",
 "はたおりどり": "نَسَّاج, نَسَّاجَة / تَنَوُّط",
 "はたおりむし": "جُنْدُب, جَرَادَة",
 "はたがしら": "قَائِد, زَعِيم",
 "はたき": "مِمْسَحَة, مِمْسَح / غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تراب / غُبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تُراب / غبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم)\nمثال: أزل الغبار عن المرآة.",
 "はたきをかける": "غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تراب / غُبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تُراب / غبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم)\nمثال: أزل الغبار عن المرآة.",
 "はたく": "غُبَار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تراب / غُبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم) / تُراب / غبار (التراب الناعم الدقيق الجاف. ويقال أيضا غَبَرَة وغَبْرَة؛ \"في الجو غُبَارٌ\" ، أي فيه تراب ناعم)\nمثال: أزل الغبار عن المرآة. / صَفْعَة, لَطْمَة / صَفَعَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين) / لَطَمَ (ضربَ بباطن الكفّ على الوجه أو على شيءٍ آخر؛ أصابَ الشيءَ بقوة أو صدمه)\nمثال: صفع المدرس مؤخرتي.",
 "はたけ": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ) / سَاحَة, سَاحَة الْمَعْرَكَة / مَجَال\nمثال: يعمل الفلاحون في الحقل. / رَحِم, بَيْت الْوَلِد (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام) / مَنشَأ, رَحِم\nمثال: رحمة الله عليه.",
 "はたけのにく": "فُول اَلصُّويَا",
 "はたけをつくる": "مَزْرَعَة",
 "はたご": "خَان, اِسْتِرَاحَة (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة.",
 "はたざお": "سَارِيَةْ العَلَم (اسم فاعل مؤنث للفعل \"سَرَى\"؛ العمود الذي يُنصب عليه العلم أو الشراع)",
 "はたしあい": "مُبَارَزَة",
 "はたしあう": "مُبَارَزَة",
 "はたして": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا .",
 "はたじるし": "تَخْطِيط, تصميم (مصدر من خَطَّطَ؛ في : فكرةٌ مُثبتة بالرسم، أو الكتابة في حالة الخطّ. تدلّ دلالةً تامَّة على ما يُقصد في الصُّورة أو الرسم أَو اللَّوح المكتوب من المعنى والموضوع…) / تَصْمِيم, ديزاين\nمثال: يعمل في قسم التخطيط. / رَايَة, عَلَم / لَافِتَة / مُلْصَق / إِعْلَان / مُمْتَاز",
 "はたす": "أَدَّى\nمثال: 君はその義務を果たすべきである。 — عليك أن تقوم بالواجب.",
 "はたち": "أَرْض زِرَاعِيَّة (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة.",
 "はたて": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "はたと": "فَجْأَةً / تَمَامًا",
 "はたのものたち": "مُتَفَرِّج",
 "はたはた": "رَفْرَف",
 "はたふり": "مُحَرِّض, مُحَرِّضَة",
 "はたふりやく": "مُبَادِر",
 "はたまた": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "はためく": "لَوَّحَ, رَفْرَفَ / مَوْج, مَوْجَة",
 "はたもと": "الْقِيَادَة الْعَامَّة / مَقَرّ",
 "はたや": "نَسَّاج, نَسَّاجَة / تَنَوُّط",
 "はたらかせる": "اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "はたらき": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل. / إِنْجَاز / رَاتِب, أَجْر / عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "はたらきかけ": "ضَغْط",
 "はたらきかける": "ضَغْط",
 "はたらきぐち": "مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث.",
 "はたらきて": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "はたらきびと": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "はたらく": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل. / وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / مَهَمَّة / دَالَّة, تَابِع / وَظِيفَة, دَالَّة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟ / اِرْتَكَبَ",
 "はたをおる": "نَسَجَ",
 "はたん": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا. / مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة.",
 "はたんきょう": "بَرْقُوق",
 "はたんをきたす": "أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "はだ": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال. / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ)) / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / طَبْع (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة!",
 "はだあい": "طَبْع (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة!",
 "はだえ": "هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال. / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ)) / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / طَبْع (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة!",
 "はだか": "عُرْي / صَلَع",
 "はだかおどり": "رَقْص تَعَرِيّ, اِسْتْرِبْتِيز (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "はだかでばねずみ": "خُلْد أَمْرَط, خُلْد عَارٍ (الثَبَات المَدِيد والبَقَاء لفترة طويلة؛ دَوَام البَقَاء، يختلف عن السَرْمَد في أن السرمد مختص بالزمان تحديدا والخلد في غير ذلك)\nمثال: خلد ياني إلى النوم.",
 "はだかになる": "تَعَرَّى, اِنْجَرَدَ / تَعَرَّى",
 "はだかむし": "يَرَقَة, دُودَة الْفَرَاشَة",
 "はだぎ": "مَلَابِس دَاخِلِيَّة, لِبَاس دَاخِلِيّ",
 "はだぎぬ": "مَلَابِس دَاخِلِيَّة, لِبَاس دَاخِلِيّ",
 "はだける": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا. / تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ",
 "はだざわり": "تحسس / شَعَرَ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية) / شَعَرَ بِ (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "はだし": "حَافٍ, حَافِي (مال أو انحرف عن الشيء؛ سار على حافة الشيء أو حام حوله) / حافي القدمين (حَفِيَ، الذي لا يرتدي حِذَاء أو نَعَال أو غيره من لباس القَدَمَيْن)\nمثال: وقف على حافة الجرف.",
 "はだしつ": "مَلْمَس",
 "はだみ": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "はだん": "تَمَزُّق",
 "はち": "زِبْدِيَّة / سُلْطَانِيَّة / زُبْدِيَّة / قِدْر (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / إِنَاء / طَنْجَرَة / حَلَّة (المرة الواحدة من الحُلول، أي النزول؛ الزنبيل الكبير من القصب) / قِدِر (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / حلَّة (المرة الواحدة من الحُلول، أي النزول؛ الزنبيل الكبير من القصب)\nمثال: خذ قدر ما تريد. / تَاج, إِكْلِيل",
 "はちあわせ": "صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ) / مُلَاقَاة, مُقَابَلَة (لِقَاء)\nمثال: صادف مشكلا صعبا.",
 "はちあわせる": "صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ) / مُلَاقَاة, مُقَابَلَة (لِقَاء)\nمثال: صادف مشكلا صعبا.",
 "はちがつ": "أَغُسْطُس, آب (الشهر الثامن في السنة الروميّة)\nمثال: غادر فاضل البلد في الثالث و العشرين من أغسطس.",
 "はちじ": "اَلسَّاعَة اَلثَّامِنَة",
 "はちじゅう": "ثَمَانِينَ, ثَمَانُونَ",
 "はちじゅうだい": "ثَمَانِينَ, ثَمَانُونَ",
 "はちじゅうのてならい": "لَيْسَ هُنَاكَ سِنٌ مُتَأَخِّرَةٌ لِلتَعَلُّمِ",
 "はちす": "نَيْلُوفَر",
 "はちすずめ": "طَنَّان, طَنَان",
 "はちすは": "بَذِيء",
 "はちすば": "بَذِيء",
 "はちどり": "طَنَّان, طَنَان",
 "はちのす": "خَلِيَّة, قَفِير / جبنة سويسرية",
 "はちのすい": "قَلَنْسُوَة (القُلُنْسُوَة: لباس داخلي للرأس يُلبس غالبا داخليا تحت العَمَامَة أو الكُوفِيَّة أو غيره من أغطية الرأس للرجال والنساء، يسمى أيضا الطَاقِيَّة؛ القُلُنْسُوَة: لباس للرأس يشبه الداخلي إلا أنه يلبس لوحده، قد يكون أبيضا وقد يكون مطرزا، يسمى أيضا الطَاقِيَّة)\nمثال: كان زيري يرتدي قلنسوة.",
 "はちぶんぎ": "ثُمْن, ثُمُن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن.",
 "はちぶんぎざ": "الثُّمْن, الثُّمُن",
 "はちぶんぎ座": "الثُّمْن, الثُّمُن",
 "はちへんけい": "مثمن",
 "はちほん": "ثَمَانِيَة, تمانية / ثَمَانِيَةٌ",
 "はちまき": "طَوْق شَعَر (وَضَعَ عليه طَوْقا؛ تَحَلَّقَ الناس أو الحيوانات أو غيرها حوله كالطوق، يستخدم تحلق إذا كان الأمر برضاه وطوّق إذا كان ذلك كرها)\nمثال: كلب زيري يحب ارتداء ذلك الطوق.",
 "はちまん": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ",
 "はちまんしせん": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "はちみつ": "عَسَل, شَهْد (عَسَل) / حَبِيبِي, عَزِيزَتِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / عَسَل, عَسُّولَة (عَسَل) / عَسَلِيّ\nمثال: يصنع النحل العسل.",
 "はちみつしゅ": "بِتْع (تباعد؛ صيّرَ)",
 "はちみつ酒": "بِتْع (تباعد؛ صيّرَ)",
 "はちめんろっぴ": "جاك لجميع المهن",
 "はちもの": "بُونْسَاي",
 "はちゃめちゃ": "عَبَثِيّ, سَخِيف / الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ. / فَوْضَوِيّ",
 "はちゅう": "زَحَّافَة",
 "はちゅうるい": "زَحَّافَة",
 "はちょう": "طُول مَوْج (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "はちろう": "شَمْع الْعَسَل ((شَمَعَ) يَشْمُعُ شَمْعًا، وشُمُوعًا: مَزَحَ وطَرِبَ)\nمثال: أشعل كين الشمع.",
 "はち合わせる": "صَادَفَ, لَاقَى (لَقِيَ، وَافَقَ، وَجَدَ؛ وَاجَهَ، لَاقَى، وَجَدَ) / مُلَاقَاة, مُقَابَلَة (لِقَاء)\nمثال: صادف مشكلا صعبا.",
 "はち蜜": "عَسَل, شَهْد (عَسَل) / حَبِيبِي, عَزِيزَتِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / عَسَل, عَسُّولَة (عَسَل) / عَسَلِيّ\nمثال: يصنع النحل العسل.",
 "はっ": "وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة! / بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "はっか": "نَعْنَاع, نعناع",
 "はっかく": "اِكْتِشَاف",
 "はっかくういきょう": "ليسوم حقيقي, ينسون نجمي",
 "はっかくけい": "مثمن",
 "はっかげんしょう": "مَادَّة تَبْيِيض (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / بَيَّضَ (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: لا أحب مادة العلوم.",
 "はっかっけい": "مثمن",
 "はっかとう": "نَعْنَاع فِلْفِلِيّ",
 "はっかん": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / مَنْشُور\nمثال: نشر توم الغسيل.",
 "はっか糖": "نَعْنَاع فِلْفِلِيّ",
 "はっき": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه.",
 "はっきゅう": "عَدَد (مِقْدَار مَا يُعَدّ) / مُشْكِل, مَسْأَلَة\nمثال: كم عدد سكان الجزائر؟",
 "はっきゅうをおう": "لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس.",
 "はっきょう": "جُنُون",
 "はっきん": "بَلَاتِين / بَلَاتِينُوم",
 "はっくしょん": "أَتْشُو",
 "はっくつ": "اِكْتِشَاف",
 "はっくつちょうさ": "حَفَرَ, اِحْتَفَرَ ((حَفَرَ الشَّيْءَ يَحْفِرُه) ، من حَدِّ ضَرَبَ، حَفْراً، (واحْتَفَرَه: نَقَّاه، كَمَا تُحْفَرُ الأَرضُ بالحَدِيدَةِ)؛ حفر: حَفَرَ الشيءَ يَحْفِرُه حَفْراً واحْتَفَرَهُ: نَقَّاهُ كَمَا تُحْفَرُ الأَرض بِالْحَدِيدَةِ)\nمثال: هم يحفرون حفرة.",
 "はっくのげきをすぐるがごとし": "الْوَقْتُ يَمْضِي",
 "はっくぶ": "تَقْرِيبًا",
 "はっけ": "عَرَافَة",
 "はっけっきゅう": "كُرَيَّةُ دَمٍ بَيْضَاءُ, خَلِيَّةُ دَمٍ بَيْضَاءُ",
 "はっけつびょう": "سَرَطَان دَم",
 "はっけん": "عَدَد (مِقْدَار مَا يُعَدّ) / مُشْكِل, مَسْأَلَة\nمثال: كم عدد سكان الجزائر؟",
 "はっけんしゃ": "مُكْتَشِف",
 "はっけんてき": "إرشادي",
 "はっこう": "إِشْعَاع (انبعاث الطَّاقة وامتدادُها)",
 "はっこうがく": "علم التخمير (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "はっこうしゃ": "دَار نَشْر, نَاشِر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "はっこうしゅ": "خَمِيرَة",
 "はっこうしょ": "دَار نَشْر, نَشْر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "はっこうじょ": "دَار نَشْر, نَشْر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "はっこうずみ": "عَدَد (مِقْدَار مَا يُعَدّ) / مُشْكِل, مَسْأَلَة\nمثال: كم عدد سكان الجزائر؟",
 "はっこうそ": "خَمَرَ (شَرَابُ الْعِنَبِ إِذَا اخْتَمَرَ؛ كُلُّ مُسْكِرٍ مُخَامِرٍ لِلْعَقْلِ، إِذَا كَانَ شَرَاباً كُحُولِيّاً أَوْ غَيْرَهُ)\nمثال: أنت تشرب الخمر.",
 "はっこうにん": "دَار نَشْر, نَاشِر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "はっこく": "الْبَرَازِيل / كونتِيّة / مُحَافَظَة, مُقَاطَعَة (تقسيم إداري في أرض دولة؛ المؤنث من \"مُحَافَظ\")\nمثال: نشأت ليلى في بلدة محافظة.",
 "はっこつ": "هَيْكَل عَظْمِيّ, هَيْكَل",
 "はっこん": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / جَذْر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي) / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "はっさい": "تَفَشٍّ",
 "はっさん": "إِشْعَاع (انبعاث الطَّاقة وامتدادُها) / نَفَّسَ, هَوَّى (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…) / نَفَّسَ عَن (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "はっしゃ": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار. / قَذْف (بمعنى رَمَى؛ قذَف بالحقّ: أمر به وأبانه)",
 "はっしゅう": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "はっしゅつ": "عَدَد (مِقْدَار مَا يُعَدّ) / مُشْكِل, مَسْأَلَة\nمثال: كم عدد سكان الجزائر؟",
 "はっしょう": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل",
 "はっしょうち": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "はっしょうのち": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "はっしょく": "لَوْن, لون (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد) / لَوَّنَ (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد)\nمثال: ما هو لون شعرك؟",
 "はっしん": "بَلَّغَ, أَبْلَغَ",
 "はっしんおん": "نَغْمَة, نَغْم",
 "はっしんがわ": "مُرْسِل, مُرْسِلَة",
