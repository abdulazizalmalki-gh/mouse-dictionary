 "ないしょく": "وَاجِب, وَاجِب مَنْزِلِيّ (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "ないしょごと": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "ないしん": "بِصَمِيم",
 "ないしんしょ": "نُسْخَة",
 "ないじつ": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة. / فِي الْحَقِيقَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "ないせつ": "نَقْش (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "ないせん": "حَرْب أَهْلِيَّة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "ないそう": "هَنْدَسَةُ دِيكُور (الحدُّ والقياس؛ في الرياضيات: هي العلم الذي يبحث في الأشكال وعلاقاتها من حيث الخطوط والأبعاد والسطوح وغيرها)\nمثال: هو ضليع في علم الهندسة .",
 "ないそく": "دَاخِل / فِي بَطْن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / ضِمْن / دَاخِل, جُوَّة\nمثال: جون في عمر أخي.",
 "ないぞう": "مَبْنِيّ, مُدْمَج / مُضَمَّن",
 "ないち": "وَطَن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "ないつう": "تَوَاطُؤ / خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن / زِنىً, زِنَاء (مَارَسَ الزِّنَى)",
 "ないつうしゃ": "خَال, شَامَة (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث) / طَوْبِين, طُوبِين / مُول\nمثال: عندي ابنا خالة. / زَانٍ (زان - يزين، زينا؛ زانه: حلاه، حسنه) / الزَّانِي / زَانِيَة (اسم فاعلة من زَنَى، المرأة التي تمارس الجنس مع غير زوجها أو بدون زواج)",
 "ないてい": "اِسْتِطْلَاع",
 "ないてき": "داخلى",
 "ないてもわらっても": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "ないで": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "ないと": "يَضْطَر\nمثال: もう行かないと。 — علي الذهاب الآن.",
 "ないといけない": "يَضْطَر\nمثال: あなたはすぐ出発しないといけない。 — يجب عليك البدأ قريبا.",
 "ないといけません": "يَضْطَر",
 "ないどう": "بُوذِيّ (مِن، أو متعلق بالديانة البوذية؛ أحد أتباع الديانة البوذية وتعليمات مؤسسها وشخصيتها الرئيسية غواتاما بوذا)",
 "ないない": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك.",
 "ないねんきかん": "مُحَرِّك اِحْتِرَاق دَاخِلِيّ (اسم فاعل من حَرَّكَ؛ اسم آلة)\nمثال: المحرك لا يعمل.",
 "ないひ": "بِطَانَة",
 "ないぶ": "دَاخِل / فِي بَطْن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / ضِمْن / دَاخِل, جُوَّة\nمثال: جون في عمر أخي.",
 "ないぶはんこう": "سوء استغلال الوظيفَة",
 "ないぶん": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "ないへん": "دَاخِل / فِي بَطْن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / ضِمْن / دَاخِل, جُوَّة\nمثال: جون في عمر أخي.",
 "ないほう": "دَلَالَة (ما يستلزم العلم به العلم بشيء آخر)\nمثال: القدس مدينة ذات دلالة رمزية بالنسبة لكل من المسلمين و المسيحيين و اليهود.",
 "ないまぜ": "خَلِيط",
 "ないまぜにする": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "ないまぜる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "ないみつ": "سِرِّيَّة, خَلْوَة\nمثال: この情報は内密にしてください。 — احتفظ بهذه المعلومة لنفسك.",
 "ないめん": "دَاخِل / فِي بَطْن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / ضِمْن / دَاخِل, جُوَّة\nمثال: جون في عمر أخي.",
 "ないめんてき": "داخلى",
 "ないもう": "مُنْغُولِيَا اَلدَّاخِلِيَّة",
 "ないもうこ": "مُنْغُولِيَا اَلدَّاخِلِيَّة",
 "ないものない": "مَعْدُوم",
 "ないものはない": "مَعْدُوم",
 "ないや": "مَاس, أَلْمَاسَة / اَلدِّينَارِيّ",
 "ないやく": "خِطْبَة, خُطُوبَة",
 "ないよう": "مُحْتَوَى, مَضْمُون",
 "ないようご": "كَلِمَة الْمُحْتَوَى (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ: الكلامُ المؤلَّفُ المطوَّل، قصيدةً، أَو خُطْبَةً، أَو مقالةً، أَو رسالة)\nمثال: كلمة السر طويلة.",
 "ないようせき": "سِعَة",
 "ないようひん": "مُحْتَوَى, مَضْمُون",
 "ないようぶつ": "مُحْتَوَى, مَضْمُون",
 "ないらん": "حَرْب أَهْلِيَّة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "ないわけにはいかない": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب)) / لَابُدَّ / عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: وجب عليك إيقافه.",
 "ないわけには行かない": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب)) / لَابُدَّ / عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: وجب عليك إيقافه.",
 "ないわん": "ثَغْر, ثَغْر بَحْرِيّ (ثَغَرَ الجدارَ ونحوهَ يَثْغَرُ ثَغْرًا: أحدث فيه ثُلْمة؛ ثَغَرَ فلانًا: كسر أسنانه)",
 "ない事には": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "ない交ぜ": "خَلِيط",
 "ない交ぜにする": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "ない交ぜる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "ない内に": "قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قَبْلَ, أَمَامَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "ない混ぜ": "خَلِيط",
 "ない訳にはいかない": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب)) / لَابُدَّ / عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: وجب عليك إيقافه.",
 "ない訳には行かない": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب)) / لَابُدَّ / عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: وجب عليك إيقافه.",
 "なう": "لَوَى, بَرَمَ",
 "なうて": "مشنوع",
 "なえ": "شَتْلَة",
 "なえぎ": "شَتْلَة",
 "なえどこ": "رَوْضَة, حَضَانَة / مَشْتَلَة",
 "なえに": "رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "なえる": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / صَعَقَ",
 "なお": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة. / أَكْثَر / عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك / كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "なおいっそう": "أَبْعَد, أَقْصَى (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني.",
 "なおかつ": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / عِلَاوَة عَلَى ذٰلِكَ\nمثال: لا أعرف إلا هذا. / لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "なおき": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم.",
 "なおし": "تَصْحِيح / أَصْلَحَ",
 "なおしもの": "أَصْلَحَ",
 "なおす": "أَصْلَحَ / تَصْلِيح / إِصْلَاح / تَرْمِيم (التَّرْميم :إِصْلَاح البناء المتصدِّع أو المتداعي؛ عملية الإصلاح نفسها) / مَرَمَّة / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / شِفَاء / شَفَى / رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء وفتحها): عوَّذَه؛ يقال: باسم الله أَرقِيك واللهُ يَشفيك) / رَوَّجَ (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ)",
 "なおなお": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم. / عَادِيّ, مَأْلُوف / مُطِيع, مُذْعِن",
 "なおまた": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / عِلَاوَة عَلَى ذٰلِكَ\nمثال: لا أعرف إلا هذا.",
 "なおも": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "なおもて": "بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة كونه واجبَ الوجود لذاته ، فهو الأوّل بلا ابتداء ، والآخر بلا انتهاء؛ الباقي الثابتُ بعد غيره) / بَقِيَ, مَكَثَ (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: الباقي ليس مهم.",
 "なおり": "شِفَاء, تَعَافِي",
 "なおる": "شُفِيَ, بَرِئَ",
 "なおれ": "عَار, خِزْي",
 "なおん": "اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "なお一層": "أَبْعَد, أَقْصَى (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني.",
 "なか": "دَاخِل / فِي بَطْن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / ضِمْن / دَاخِل, جُوَّة\nمثال: جون في عمر أخي. / مِنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / مُنْتَصَف, وَسَط / وَسَط, مُتَوَسْط / خِلَالَ, فِي",
 "なかい": "نَادِلَة, جَرْسُونَة",
 "なかいい": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "なかいし": "حِصَان, فَرَس (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: لم يشفى الحصان.",
 "なかいま": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "なかいり": "فاصِل",
 "なかうど": "خَاطِب, خَاطِبَة",
 "なかおれ": "فيدورا, فدورا",
 "なかおれぼう": "فيدورا, فدورا",
 "なかおれぼうし": "فيدورا, فدورا",
 "なかおれハット": "فيدورا, فدورا",
 "なかおろし": "سِمْسَار, وَسِيط",
 "なかがい": "سِمْسَار, وَسِيط",
 "なかがいい": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "なかがいにん": "سِمْسَار, وَسِيط",
 "なかがくし": "جيب داخلي (جيَّب القميص:جَابَ، جعل له جيبًا)\nمثال: جيب سامي مثقوب.",
 "なかがよい": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "なかがわ": "دَاخِل / فِي بَطْن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / ضِمْن / دَاخِل, جُوَّة\nمثال: جون في عمر أخي.",
 "なかぐち": "تَشْهِير, اِفْتِرَاء",
 "なかぐり": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "なかご": "نِوَاة",
 "なかじき": "أَدْخَلَ / سَجَّادَة",
 "なかじきり": "تَقْسِيم",
 "なかす": "ضحضاح ماء",
 "なかせ": "إِزْعَاج",
 "なかぞら": "جَوّ",
 "なかたがい": "نِزَاع, شِجَار (حالة المريض المشرف على الموت؛ خُصُومَة بين أفراد أو جماعات قد تقتصر على تبادل الشتائم وقد تمتدّ إلى التماسك بالأيدي أو استخدام أداة ما في المشاجرة أو تُفضي إلى الحرب بين الدول) / تَشَاجَرَ\nمثال: شمال مالي منطقة نزاع.",
 "なかだか": "مُحَدَّب",
 "なかだち": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "なかったことにする": "سَامَحَ / غَفَرَ",
 "なかった事にする": "سَامَحَ / غَفَرَ",
 "なかつぎ": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر. / سِبَاق تَتَابُع",
 "なかつぎにん": "فَاعِل (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "なかつくに": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "なかて": "مُشْط اَلْيَد (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "なかでも": "مِنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "なかなおり": "صُلْح, مُصَالَحَة",
 "なかなか": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / أَبَدًا / مُنْتَصَف, وَسَط / وَسَط, مُتَوَسْط / مُمْتَاز, فَاخِر",
 "なかには": "مِنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "なかにも": "مِنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / فِي نَفْس اَلْوَقْت (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "なかにわ": "فِنَاء, حَوْش",
 "なかぬき": "لَخَّصَ, اِخْتَصَرَ",
 "なかのいい": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "なかのよい": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "なかば": "مُنْتَصَف, وَسَط / وَسَط, مُتَوَسْط / نِصْف, نُصْف / تَقْرِيبًا, عَلَى وَشْك",
 "なかばたらき": "خَادِمَة, خَدامَة",
 "なかひと": "خَاطِب, خَاطِبَة",
 "なかびく": "أَجْوَف",
 "なかびと": "خَاطِب, خَاطِبَة",
 "なかへはいる": "أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "なかほど": "مُنْتَصَف, وَسَط / وَسَط, مُتَوَسْط",
 "なかぼう": "خُوذَة, بَيْضَة",
 "なかぼね": "عَمُود فَقْرِيّ / دِعَامَة / شَجَاعَة",
 "なかま": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟ / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "なかまいり": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر.",
 "なかまたち": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "なかまどうし": "تِرْب, قَرِين (أصبح في حالة تربٍ، أي وضع في التراب أو اشتمل عليه؛ في : يُقال \"تَرَبَ\" على سبيل الاستعارة للمجيء بالراحة أو الهدوء بعد تعب)",
 "なかまにくわえる": "قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل.",
 "なかみ": "مُحْتَوَى, مَضْمُون / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / نَصْل (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة الحادّة الجارحة)\nمثال: لن نصل إلى أي مكان.",
 "なかやすみ": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "なかゆび": "وُسْطَى",
 "なかよい": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "なかよく": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق.",
 "なかよし": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "なかわた": "تَبْطِين",
 "なが": "طَوِيل",
 "ながい": "طَوِيل",
 "ながいす": "فِرَاش, أَرِيكَة",
 "ながきにわたる": "طَوِيل",
 "ながくつした": "جَوْرَب",
 "ながくつしたのピッピ": "بِيبِي ذَات الجَوْرَب الطَوِيل, جِنَان ذَات الجَوْرَب الطَوِيل",
 "ながぐつ": "وِيلِينْغْتُون",
 "ながさ": "طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "ながさき": "نَاغَاسَاكِي / نَاجَازَاكِي",
 "ながし": "غَطَسَ / مَجْلَى, مَغْسَلَة / رِحْلَة بَحْرِيَّة / طَفَا, عَامَ / طَفَا",
 "ながしかく": "مُسْتَطِيل",
 "ながしこむ": "أَدْخَلَ",
 "ながしだい": "غَطَسَ / مَجْلَى, مَغْسَلَة",
 "ながしだす": "نَفِدَ",
 "ながしづり": "طْرُول / مُتَصَيِّد, طْرُول",
 "ながしもと": "غَطَسَ / مَجْلَى, مَغْسَلَة",
 "ながす": "بَالُوعَة / طَفَا, عَامَ / طَفَا / تَلْفَزَة, إِذَاعَة / أَذَاعَ, بَثَّ / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "ながぜりふ": "مُونُولُوج, حَدِيث النَّفْس",
 "ながちょうば": "مَارَاثُون",
 "ながつき": "سِبْتِمْبِر, سِبْتَمْبِر (الشهر التاسع في السنة الروميّة)\nمثال: بدأ سامي عامه الجامعي في سبتمبر.",
 "ながづき": "سِبْتِمْبِر, سِبْتَمْبِر (الشهر التاسع في السنة الروميّة)\nمثال: بدأ سامي عامه الجامعي في سبتمبر.",
 "ながなが": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "ながね": "اِسْتَغْرَقَ فِي النَّوْم",
 "ながの": "طَوِيل",
 "ながびかせる": "أَطَالَ",
 "ながびく": "ثَابَرَ",
 "ながむ": "نَظَرَ (اِسْتَعْمَلَ عينه ليَرَى الشيءَ، ليُدْرِكَه ويُبْصِرَه. (مَصْدَرُهُ نَظَر)؛ (يتعدى تعدية عامة بإلى))\nمثال: نظر إلى السماء. / عَجَبَ / لَاحَظَ, رَاقَبَ",
 "ながむし": "ثُعْبَان, حَنَش",
 "ながめ": "مَنْظَر, مَشْهَد / مَشْهَد",
 "ながめまわす": "تَلَفَّتَ",
 "ながめる": "نَظَرَ (اِسْتَعْمَلَ عينه ليَرَى الشيءَ، ليُدْرِكَه ويُبْصِرَه. (مَصْدَرُهُ نَظَر)؛ (يتعدى تعدية عامة بإلى))\nمثال: نظر إلى السماء. / عَجَبَ / لَاحَظَ, رَاقَبَ",
 "ながもち": "دَائِم طَوِيْلًا",
 "ながら": "مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / كُلّ, جَمِيع / كَـ, مِثْل / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "ながらく": "طَوِيل",
 "ながらに": "مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "ながらも": "رَغْم أَنّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره. / مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "ながれ": "تَدَفُّق / تَدَفَّقَ, سَالَ / طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / مَسار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا الطبق لذيذ. / نُزُول / اَصْل / تَجَوَّلَ",
 "ながれぼし": "شِهَاب / سَعِيرَا",
 "ながれもの": "غَرِيب, غَرِيبَة / أَجْنَبِيّ",
 "ながれる": "جَدْوَل / تَيَّار / تَدَفّقَ / طَفَا, عَامَ / طَفَا / مَسَحَ (مَرَّ عليه بكفه وهو يلامسه؛ مَحَا، مرَّ عليه بكفه حتى يُزيله)\nمثال: مسح توم الطاولة. / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "ながわきざし": "مُقَامِر / مُغَامِر",
 "ながズボン": "بِنْطَال, سِرْوَال (البِنْطَال : ضرب من الألبسة حديث يلبس في النصف الأسفل من الجسم يتكون من ساقين مثل السَرَاويِل إلا أنها أضيق…) / سِرْوَال اَلسُّنَة (ضرب تقليدي أو قديم من الملابس يرتدى في الجزء السفلي من الجسم يكون واسعا ويربط بالخصر والكاحلين بشرائط من القماش، يفصل كل ساق عن الأخرى…؛ لباس يُغَطِّي الجسم مِن السرة إلى الركبة. —مجلة العربي - الكويت)\nمثال: هذا السروال يناسبني.",
 "ながーい": "طَوِيل",
 "なき": "بُكَاء",
 "なきいる": "فجأة بدأ يبكي",
 "なきがら": "بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة كونه واجبَ الوجود لذاته ، فهو الأوّل بلا ابتداء ، والآخر بلا انتهاء؛ الباقي الثابتُ بعد غيره) / بَقِيَ, مَكَثَ (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: الباقي ليس مهم.",
 "なきごえ": "بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه) / بكاء\nمثال: بكى زيري كثيرا.",
 "なきごと": "شِكَايَة, شَكْوَى",
 "なきさけぶ": "صرخة / صَرَخَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "なきしきる": "بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه) / بكاء\nمثال: بكى زيري كثيرا.",
 "なきじゃくる": "شهيق, شهقة / شَهِقَ (تنفس بصوت عالٍ وبشكل مفاجئ نتيجة التعب أو الخوف أو الضيق؛ في لغة الطيور: أصدرت صوتًا عاليًا يشبه الشهيق)",
 "なきたてる": "عُوَاء / عَوَى / أَنَّ (يفيد التوكيد)\nمثال: كيف لي أن أعرف؟",
 "なきたま": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "なきだす": "فجأة بدأ يبكي\nمثال: 彼女は今にも泣き出しそうだった。 — كادت أن تبكي.",
 "なきつく": "اِلْتِمَاس, اِسْتِئْنَاف / اِسْتَأْنَفَ",
 "なきひと": "مَيِّت مَيْت, مُتَوَفًّى / مَرْحُوم",
 "なきまね": "دُمُوع اَلتَّمَاسِيح",
 "なきものにする": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "なきわめく": "صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ) / صَرَخَ, صَاحَ (صاحَ صياحا شديدًا واستغاث)\nمثال: صرخ طالبا النجدة.",
 "なぎ": "هَادِئ / طَمْأَنَ",
 "なぎいかだ": "سَفَنْدَر",
 "なぎさ": "شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة) المنطقة اليابسة على طول حافة النهر. ضِفَّة، جَانِب، شَطّ) / سَاحِل\nمثال: عاد إلى الشاطئ.",
 "なぎたおす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ) / غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "なぎはらう": "خَطّ مَائِل (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "なぎ倒す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ) / غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "なぎ払う": "خَطّ مَائِل (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "なく": "بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه) / بكاء\nمثال: بكى زيري كثيرا. / تَأَلَّمَ, عَانَى / عَانَى (قَاسَى وكابد؛ الشيءَ: ملابسته ومباشرته)\nمثال: لقد عانى جمال كثيرا. / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل. / عَوِيل, رَثَاء / مَرْثِيَة / بَكَى, نَاحَ (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / بَكَى, رَثَى (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا.",
 "なくして": "بِدُونِ, بِلَا\nمثال: 労なくして益なし。 — كل شيء وله ثمن",
 "なくしては": "بِدُونِ, بِلَا",
 "なくす": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته. / تَخَلَّصَ ؛ مِن",
 "なくちゃ": "بِدُونِ, بِلَا",
 "なくては": "بِدُونِ, بِلَا",
 "なくてもいい": "يَضْطَر",
 "なくてもよい": "يَضْطَر",
 "なくても良い": "يَضْطَر",
 "なくなく": "بُكَاء",
 "なくなす": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته.",
 "なくなる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "なくはない": "قَلِيلًا",
 "なくもがな": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "なぐ": "جَزَّ (جَزَّ النخلُ ونحوُه يَجُزُّ جَزًّا: حان أَن يُقطَعَ ثَمَرُهُ؛ جَزَّ النَّخلَةَ جَزًّا، وجِزَازاً: قَطعَ ثمَرَها)\nمثال: طلبت من توم جز عشبنا.",
 "なぐさみ": "تَسْلِيَة",
 "なぐさみはんぶん": "مُتَقَلِّب",
 "なぐさめ": "رَاحَة / جابر / وَاسَى, عَزَّى",
 "なぐさめる": "رَاحَة / جابر / وَاسَى, عَزَّى",
 "なぐりあう": "عَارَكَ, قَاتَلَ / تَعَارَكَ, تَقَاتَلَ / نَاضَلَ, كَافَحَ / قِتَال (من قَتَلَ: كثير القَتْل) / مَعْرَكَة\nمثال: لن يحل القتال أي شيء.",
 "なぐりがき": "خربشة",
 "なぐりこみ": "مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "なぐりこむ": "مُدَاهَمَة / غَارَة, غَزْوَة / أَغَارَ, اِقْتَحَمَ / أَغَارَ",
 "なぐりたおす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "なぐり倒す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "なぐる": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "なけなし": "بَخْس (بَخَسَ؛ بَخِسَ)\nمثال: بيع المنزل بثمن بخس.",
 "なけばならない": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب)) / لَابُدَّ / عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: وجب عليك إيقافه.",
 "なければいけない": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب)) / لَابُدَّ / عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: وجب عليك إيقافه.",
 "なければいけません": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب)) / لَابُدَّ / عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: وجب عليك إيقافه.",
 "なければならない": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب)) / لَابُدَّ / عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: وجب عليك إيقافه.",
 "なければならぬ": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب)) / لَابُدَّ / عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: وجب عليك إيقافه.",
 "なければなりません": "وَجَبَ, يَتَحَتَّم (لَزِمَ، تَعَيَّنَ. (مصدره وُجُوب)؛ لزم وصار أكيد حدوثه. (مصدره وجُوب)) / لَابُدَّ / عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: وجب عليك إيقافه.",
 "なければなるまい": "يَنْبَغِي أَنْ / مِنْ اَلْمَفْرُوض أَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / مِنْ اَلْمُفْتَرَض أَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "なげ": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / اِسْتَقَالَ",
 "なげあみ": "شَبَكَة",
 "なげうつ": "طَرَحَ (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "なげうり": "مَزْبَلَة, نُفَايَة (موضع تجميع الأَزْبَال والتِفَايَات لحين نقلها؛ حَاوِيَة نفايات؛ موضع خارج المدينة توضع فيه الأزبال والنفايات)\nمثال: وضع فاضل جثة دانية في مزبلة.",
 "なげおろす": "مَزْبَلَة, نُفَايَة (موضع تجميع الأَزْبَال والتِفَايَات لحين نقلها؛ حَاوِيَة نفايات؛ موضع خارج المدينة توضع فيه الأزبال والنفايات)\nمثال: وضع فاضل جثة دانية في مزبلة.",
 "なげかける": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار.",
 "なげかわしい": "مُؤْسِف",
 "なげき": "غَمّ, حُزْن",
 "なげきのかべ": "حَائِط الْبُرَاق, حَائِط الْغَرْبِي",
 "なげく": "عَوِيل, رَثَاء / مَرْثِيَة / بَكَى, نَاحَ (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / بَكَى, رَثَى (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا.",
 "なげこみ": "أَدْخَلَ",
 "なげすてる": "طَرَحَ (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "なげせん": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "なげぜに": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "なげだす": "مَدَّدَ / اِمْتَدَّ / اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا! / تَضْحِيَة, قُرْبَان / ضَحَّى",
 "なげとばす": "عَلَاقَة سَرِيعَة, علاقة طيارى / صَبَّ, رَمَّى (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون)\nمثال: صب الشاي لضيفك.",
 "なげもの": "تَصْفِية",
 "なげやり": "غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "なげる": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / تَنَازَلَ / تَخَلَّى / اِسْتَسْلَمَ / صَبَّ, رَمَى (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون) / ضِمَاد مِنَ الْجِبْس\nمثال: صب الشاي لضيفك.",
 "なげわざ": "رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة.",
 "なげわたす": "اِسْتَسْلَمَ / اِسْتَسْلَام",
 "なげー": "طَوِيل",
 "なこうど": "خَاطِب, خَاطِبَة",
 "なことば": "اِسْم الذَّات (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: ما اسم حصان توم؟",
 "なごます": "هَادِئ / طَمْأَنَ",
 "なごむ": "أَهْدَأَ, هَدَّأَ",
 "なごめる": "هَادِئ / طَمْأَنَ",
 "なごや": "نَاغُويَا",
 "なごやか": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "なごり": "بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة كونه واجبَ الوجود لذاته ، فهو الأوّل بلا ابتداء ، والآخر بلا انتهاء؛ الباقي الثابتُ بعد غيره) / بَقِيَ, مَكَثَ (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: الباقي ليس مهم. / فِرَاقٌ / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "なさいます": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "なさけ": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ) / شَفِقَ ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: زيري مثير للشفقة. / حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "なさけない": "بَائِس",
 "なさけぶかい": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة.",
