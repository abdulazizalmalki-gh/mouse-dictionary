{
 "しらたえ": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون…)\nمثال: هذا الكلب أبيض.",
 "しらたま": "دَقِيق الْأَرُزّ, أَرُزّ مَسْحُوق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة. / أَبْيَض الأَزْهَار ((للنباتات) ذو أزهار بيضاء)",
 "しらたまこ": "دَقِيق الْأَرُزّ, أَرُزّ مَسْحُوق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "しらたまつばき": "أَبْيَض الأَزْهَار ((للنباتات) ذو أزهار بيضاء)",
 "しらちゃ": "بني فاتح (بني فاتح ولكنه غير مشبع) / شَاي أَبْيَض (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي…)\nمثال: صب الشاي لضيفك.",
 "しらちゃけた": "بَاهِت, شَاحِب",
 "しらちゃける": "اختفاء, تلاشٍ (التوقف التدريجي عن الظهور)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة",
 "しらっと": "بِبَلَادَة, بِخُمُول (بدون حيوية)\nمثال: أومأت برأسها ببلادة",
 "しらつち": "طين صيني, كاولين (طين ناعم عادة ما يكون أبيض ناتج عن تجوية المعادن الألومينية (مثل الفلسبار)…)",
 "しらとり": "تَمّ, قُقْنُس",
 "しらない": "مَجْهُول, مُبْهَم / لَا يَهُمُّنِي (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "しらなみ": "رغوة الموج, زبد الموج (موجة تهب عليها الرياح فينكسر عرفها ويظهر أبيض اللون) / لِصّ, لِصَّة",
 "しらぬかお": "تَجَاهَلَ, طَنَّش / لَامُبَالَاة",
 "しらぬがほとけ": "الْجَهْل نَعِيمَهُ, الْجَهْل نِعْمَة",
 "しらは": "ريشة بيضاء (رمز للجبن)",
 "しらはた": "راية الهدنة, علم أبيض (علم يتكون من قطعة قماش بيضاء تُرفع للإشارة إلى الاستسلام أو لطلب الهدنة)",
 "しらはたけ": "بُهَاق",
 "しらはだ": "بُهَاق",
 "しらはだけ": "بُهَاق",
 "しらはりぢょうちん": "كتاب أبيض, ورقة بيضاء (تقرير حكومي؛ يغلف عادة بغلاف أبيض)",
 "しらびと": "هَاوٍ, هَاوِيَة",
 "しらびょうし": "دَاعِرَة, بَغِيَّة",
 "しらべ": "تَحْقِيق / لَحْن (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن.",
 "しらべおび": "حِزَام, زُنَّار (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة…)\nمثال: هذا حزام من الجلد.",
 "しらべしつ": "صندوق تعريق (جهاز يسبب تعرق أوراق التبغ أو الفاكهة أو الجلود)",
 "しらべなおす": "أَعَادَ الفحص, رَاجَعَ (نظر مرة أخرى؛ فحص مرة أخرى)\nمثال: لنراجع وضعك",
 "しらべもの": "تَحْقِيق",
 "しらべる": "فَحَصَ, اِمْتَحَنَ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في :…)\nمثال: فحص الطبيب بطني.",
 "しらみ": "قَمْلَة, قَمْل",
 "しらみだらけ": "مَقْمُول, مَلِيء بِالقَمْل (موبوء بالقمل)",
 "しらみつぶし": "جلي, دعك (فعل تنظيف سطح بفركه بفرشاة وصابون وماء)\nمثال: تمشيط المنطقة بأكملها لم يكشف عن شيء",
 "しらみつぶしに": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "しらみばえ": "ذبابة القمل (ذبابة ثنائية الأجنحة ماصة للدماء تتطفل على الطيور والثدييات)",
 "しらむ": "بَيَّضَ, اِبْيَضَّ (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من…)\nمثال: ياني يحب البيض. / بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك…)\nمثال: الماء بارد حقا. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / تردد, تلكؤ (فعل التوقف بشكل غير مؤكد)\nمثال: كان هناك تردد في كلامه",
 "しらゆ": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "しらゆきひめ": "بَيْضَاء الثَّلْج, بَيَاضُ الثَّلْج (مؤنث أَبْيَض، صفة ما كان لونها البياض؛ يد بيضاء: هي اليد التي تعمل الخير وتسبق…)\nمثال: هي بيضاء اللون.",
 "しらゆり": "زنبق الماء المصري, لوتس (اللوتس المصري الأبيض: زنبق الماء في مصر إلى جنوب شرق أفريقيا؛ كان مقدساً عند…)",
 "しらよね": "أرز أبيض (أرز تمت إزالة القشرة أو الطبقات البنية الخارجية منه)",
 "しられざる": "مَجْهُول, مُبْهَم",
 "しらん": "بليتيلا مخططة (أوركيد ياباني بأوراق مخططة بالأبيض وعناقيد منتصبة نحيلة من الزهور الوردية إلى…) / موهوب (وهبه الله موهبة أو مواهب)\nمثال: كاتب موهوب",
 "しらんかお": "تَجَاهَلَ, طَنَّش / لَامُبَالَاة",
 "しり": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته / أسفل, جانب سفلي (الجانب السفلي من أي شيء) / نِهَايَة, غَايَة\nمثال: انتهى أمر زيري. / عَاقِبَة / أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة)",
 "しりあい": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "しりあがり": "تَحْسِين",
 "しりあげむし": "شَوَّالَة",
 "しりあな": "اِسْت (فتحة الدُبُر أو مقعد الإنسان؛ الأصل والأساس)",
 "しりいん": "مُوَظَّف, مُوَظَّفَة",
 "しりえ": "خَلْفِيّ",
 "しりお": "ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند…)\nمثال: عذر أقبح من ذنب. / أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "しりおし": "دعم, مؤازرة (فعل تقديم الموافقة والدعم)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين / إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة))",
 "しりおも": "بطيء الحركة, بليد (شخص يتحرك ببطء)",
 "しりがあおい": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "しりがい": "ثَفَر, قُوش ((ثَفَّرَ) الدَّابَّة: سَاقهَا من خلفهَا)",
 "しりがおもい": "كَسْلَان / أَخْرَق",
 "しりがかるい": "عميق\nمثال: صام ياني رمضان. / غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / دَاعِر, فَاجِر (متساهل وغير منضبط في السلوك الجنسيّ)",
 "しりがる": "فَضْفَاض, واسِع / سَرِيع\nمثال: ينبح كلب في الحي. / طَفْح, طَفْح جِلْدِيّ",
 "しりくせ": "سَلَس ((سَلُسَ) يَسْلُسُ سَلاسَةً: لانَ وسَهُلَ وانقادَ، فهو سَلِيسٌ)",
 "しりこそばゆい": "قَلِق, قَلِقَة (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "しりこぶた": "دُبْر, رِدْف (ضد القُبُل؛ من كل شيء عقبه ومؤخره؛ دُبُر الصلاة؛ بعدها مباشرة)\nمثال: دبر المحامي وسلية لهرب توم من السجن.",
 "しりごみ": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد)\nمثال: كان هناك تردد في كلامه",
 "しりざい": "مضاد للإسهال (دواء يستخدم للسيطرة على الإسهال أو إيقافه)",
 "しりしよく": "أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة)",
 "しりすぼまり": "ضَعِيف, مُوَهَّن (مُنخفِض القوّة أو الشدّة)",
 "しりすぼみ": "تخفيض تدريجي, تدريج (عملية تقليل الحجم أو الكمية تدريجياً)\nمثال: وصف الطبيب تخفيضاً تدريجياً للجرعة",
 "しりずもう": "مُتَتَالٍ, مُتَعَاقِب (واحد تلو الآخر دون انقطاع)",
 "しりぞく": "تَرَاجُع / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: سحب ياني تصريحه. / اِسْتَقَالَ",
 "しりぞける": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / دَفَعَ, صَدَّ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن. / طَرَدَ",
 "しりたたき": "خَفِيفُ الحَرَكَة, نَشِيط (سريع ومفعم بالطاقة والحيوية)",
 "しりたぶ": "دُبْر, رِدْف (ضد القُبُل؛ من كل شيء عقبه ومؤخره؛ دُبُر الصلاة؛ بعدها مباشرة)\nمثال: دبر المحامي وسلية لهرب توم من السجن.",
 "しりたぶら": "دُبْر, رِدْف (ضد القُبُل؛ من كل شيء عقبه ومؤخره؛ دُبُر الصلاة؛ بعدها مباشرة)\nمثال: دبر المحامي وسلية لهرب توم من السجن.",
 "しりっぺた": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "しりっぽ": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته / ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند…)\nمثال: عذر أقبح من ذنب.",
 "しりつ": "مَدَنِيّ / خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "しりつがっこう": "مدرسة خاصة (مدرسة تم إنشاؤها وإدارتها بشكل خاص ومدعومة بالأوقاف والرسوم الدراسية)",
 "しりつがっこうきょうしょくいんきょうさいくみあい": "دعم لوجستي دولي, عون متبادل (ترتيبات بين الدول لمساعدة بعضها البعض)",
 "しりつこう": "مدرسة خاصة (مدرسة تم إنشاؤها وإدارتها بشكل خاص ومدعومة بالأوقاف والرسوم الدراسية)",
 "しりつたんてい": "محقّق خاص (شخص يمكن استئجاره لجمع المعلومات والمساعدة في التحقيقات الجنائية)\nمثال: その男は私立探偵だとわかった。 — تبين أنا الرجل محقق خاص.",
 "しりつだいがく": "جامعة المدينة (جامعة حضرية في مدينة كبيرة)",
 "しりつとしょかん": "مكتبة عامة (مكتبة غير ربحية يتم صيانتها للاستخدام العام)",
 "しりつぼみ": "تخفيض تدريجي, تدريج (عملية تقليل الحجم أو الكمية تدريجياً)\nمثال: وصف الطبيب تخفيضاً تدريجياً للجرعة",
 "しりとり": "لعبة كلمات (أي لعبة تنطوي على تكوين أو تغيير أو اكتشاف الكلمات)",
 "しりにく": "ردف, كفل (جزء الحيوان الذي يقابل الأرداف البشرية)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "しりにしく": "سَيْطَرَ",
 "しりぬけ": "كثرة النسيان, نسيان (الميل للنسيان)\nمثال: ازداد سهوه مع تقدمه في السن",
 "しりのあな": "اِسْت (فتحة الدُبُر أو مقعد الإنسان؛ الأصل والأساس)",
 "しりびと": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "しりぺんぺん": "خَفِيفُ الحَرَكَة, نَشِيط (سريع ومفعم بالطاقة والحيوية)",
 "しりめ": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "しりめつれつ": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة)\nمثال: عرض منتفخ ومفكك",
 "しりめにかける": "تَرَفَّعَ",
 "しりもち": "خطأ فادح, زلة (خطأ محرج)",
 "しりゃくせん": "سفينة قرصنة مفوضة (سفينة حربية مملوكة للقطاع الخاص مفوضة للاعتداء على الشحن التجاري أو السفن…)",
 "しりゃくめんきょ": "خطاب تفويض (ترخيص لمواطن عادي للاستيلاء على سفن دولة أخرى وممتلكاتها)",
 "しりゃくめんきょじょう": "خطاب تفويض (ترخيص لمواطن عادي للاستيلاء على سفن دولة أخرى وممتلكاتها)",
 "しりゅう": "رَافِد",
 "しりょ": "عَقْل, حَنْك (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل.",
 "しりょう": "سجل تاريخي, وثيقة تاريخية (كتابة لها قيمة تاريخية (على عكس الخيال أو الأسطورة وما إلى ذلك)) / شَبَح, خَيَال / عَيِّنَة / مَادِّيّ\nمثال: لا أحب مادة العلوم. / عَلَف / فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة. / حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية…)\nمثال: ليس لدينا حديقة.",
 "しりょうかん": "أرشيف, سجلات (مجموعة من السجلات خاصة حول مؤسسة ما) / مَتْحَف (مكان تُجمع وتُعْرَض فيه الآثار التاريخيَّة أو الفنيَّة أو العِلْميَّة وغيرها)\nمثال: عاد إلى المتحف.",
 "しりょうじゅつし": "مستحضر الأرواح (من يمارس العرافة باستحضار الموتى)",
 "しりょうず": "نهاية اللعبة (المراحل النهائية من لعبة الشطرنج بعد إزالة معظم القطع من الرقعة)\nمثال: المرحلة النهائية الدبلوماسية",
 "しりょうへんさん": "تأريخ, علم التأريخ (كتابة التاريخ)",
 "しりょく": "بَصَر, نَظَر (قال سيبويه: بصر صار مبصرا، وابصره اذا أخبره بالذي وقعت عينه عليه)\nمثال: لدى مايوكو حاسة بصر حادة. / طريقة, واسطة (امتلاك القدرة على إنتاج تأثير معين أو تحقيق غاية)\nمثال: وسيلة للسيطرة",
 "しりょくけんさい": "أخصائي بصريات, فاحص نظر (شخص ماهر في اختبار عيوب الإبصار لوصف النظارات التصحيحية)",
 "しりょくけんさひょう": "لوحة فحص النظر (لوحة تقرأ من مسافة ثابتة؛ تستخدم كاختبار للرؤية)",
 "しりょくけんていい": "أخصائي بصريات, فاحص نظر (شخص ماهر في اختبار عيوب الإبصار لوصف النظارات التصحيحية)",
 "しりょくしょうがい": "عَمًى",
 "しりょくしょうがいしゃ": "ضعيف البصر, كفيف (شخص لديه ضعف في الرؤية)",
 "しりょくひょう": "لوحة فحص النظر (لوحة تقرأ من مسافة ثابتة؛ تستخدم كاختبار للرؤية)",
 "しりょぶかい": "حَرِيص, حَكِيم",
 "しりわ": "حافة السرج الخلفية, قادمة السرج (الجزء الخلفي من مقعد السرج)",
 "しりをあげる": "قَامَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه. / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "しりをすえる": "جَلَسَ, قَعَدَ (قَعَدَ)\nمثال: جلس سامي مجددا.",
 "しりをたたく": "صَفَعَ, سَتَهَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين)\nمثال: صفع المدرس مؤخرتي.",
 "しりをまくる": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا…)\nمثال: ضوء القمر ضعيف.",
 "しり込み": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد)\nمثال: كان هناك تردد في كلامه",
 "しる": "عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟ / شُورَبَة (في : هي الحَسَاء)\nمثال: هل مذاق الشوربة جيد؟ / عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / حَاسَّة\nمثال: لديهم حس الفكاهة. / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ:…)\nمثال: ليلى تذكر سامي.",
 "しるか": "لَا يَهُمُّنِي (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "しるけ": "عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟",
 "しるし": "دَرَجَة\nمثال: الصهاينة أشر من النازيين. / رَمْز, عَلَامَة (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة…)\nمثال: تمثال الحرية رمز لأمريكا. / شَارَة / دَلِيل, بُرْهَان / لافِتَة\nمثال: توم وقع و أصيب.",
 "しるしばた": "بِطَاقَة هُوِيَّة",
 "しるす": "ذِكْر (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة. / دَرَجَة\nمثال: الصهاينة أشر من النازيين. / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ:…)\nمثال: ليلى تذكر سامي. / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "しるすいきつつき": "نقار الخشب مصاص العصارة أصفر البطن (نقار خشب مصاص للعصارة من شرق أمريكا الشمالية ذو بطن أصفر شاحب)",
 "しるひと": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب. / عَاشِق, عَاشِقَة",
 "しるひとぞしる": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "しるべ": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب. / إِرْشَاد, هِدَايَة",
 "しるもの": "شُورَبَة (في : هي الحَسَاء)\nمثال: هل مذاق الشوربة جيد؟",
 "しるわん": "زبدية حساء, طبق شوربة (وعاء لتقديم الحساء)",
 "しれい": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف . / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية. / شَبَح, خَيَال / خَادِم, خَادِمَة",
 "しれいかん": "ضابط قائد, قائد (ضابط يتولى قيادة وحدة عسكرية)",
 "しれいげんご": "لغة الأوامر, لغة الاستعلام (لغة مصدر تتكون من مشغلات إجرائية تستدعي وظائف ليتم تنفيذها)",
 "しれいしつ": "غرفة التحكم (غرفة تضم معدات التحكم (كما في استوديو التسجيل))",
 "しれいせん": "وحدة القيادة (وحدة فضائية يمكن لرواد الفضاء العيش فيها والتحكم في المركبة الفضائية والتواصل…)",
 "しれいちょうかん": "رَئِيس أَرْكَان",
 "しれいとう": "بُرْج مُرَاقَبَة (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر. / قَائِد, زَعِيم / صانع ألعاب (لاعب في رياضة جماعية يقود الهجمات أو المناورات بطريقة تمكن زميله من التسجيل)",
 "しれいぶ": "الْقِيَادَة الْعَامَّة",
 "しれごと": "هُرَاء, لَغْو / حماقة, طيش (سلوك أحمق أو لا معنى له)\nمثال: محاولة القيادة خلال عاصفة ثلجية هي قمة الحماقة",
 "しれた": "بَدِيهِيّ, بَدَهِيّ / تَافِه, حَقِير (صغير ولا يلفت الانتباه)",
 "しれっと": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية)\nمثال: ألقى نظرة غير مبالية على العناوين",
 "しれつ": "عَاصِف, مُضْطَرِب (شَدِيد الهَيَجَان والاضْطِرَاب)",
 "しれつきょうせい": "تقويم الأسنان (فرع طب الأسنان الذي يتعامل مع الوقاية من أو تصحيح عدم انتظام الأسنان)",
 "しれつきょうせいき": "مُقَوَّم أَسْنَان",
 "しれもの": "مُغَفَّل, أَحْمَق",
 "しれわたる": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "しれん": "اِمْتِحَان, اِخْتِبَار (اِمْتِحَان)\nمثال: لدي امتحان غدا.",
 "しろ": "قَلْعَة, قِلْعَة (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة. / إحلال, استبدال (عملية وضع شيء أو شخص مكان آخر)\nمثال: استبدال الدم المفقود بنقل دم المتبرع / مَادِّيّ\nمثال: لا أحب مادة العلوم. / ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن. / هَامِش / أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون…)\nمثال: هذا الكلب أبيض. / بَرَاءَة / فراغ, مساحة فارغة (منطقة فارغة)\nمثال: اكتب اسمك في المكان المخصص",
 "しろあしげ": "مُتَدَاعٍ, مُتَهَالِك (بَالٍ وَمُتَحَطِّمٌ بِسَبَبِ الاسْتِعْمَالِ الشَّدِيدِ)",
 "しろあり": "أَرَضَة",
 "しろあん": "فاصولياء بيضاء (فاصولياء ذات بذور بيضاء؛ عادة ما تكون مجففة)",
 "しろい": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون…)\nمثال: هذا الكلب أبيض. / خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه…)\nمثال: عندي ابنا خالة. / بَرِيء, بَرِيئَة / لَامِع, نَيِّر",
 "しろいし": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون…)\nمثال: هذا الكلب أبيض.",
 "しろいたち": "اِبْنُ مِقْرَض (الولد الذكر)\nمثال: هو له ابن صغير.",
 "しろいもの": "ثَلْج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه)\nمثال: سامي يحب الثلج.",
 "しろいるか": "بيلوغا, حوت أبيض (حوت شمالي صغير يكون لونه أبيض عند البلوغ)",
 "しろいろ": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون…)\nمثال: هذا الكلب أبيض.",
 "しろいわやぎ": "ماعز الجبل (ثديي ثابت القدم يعيش في المناطق الجبلية بشمال غرب أمريكا الشمالية)",
 "しろいんげんまめ": "فاصولياء بيضاء (فاصولياء ذات بذور بيضاء؛ عادة ما تكون مجففة)",
 "しろう": "سيلان دهني (حالة يؤدي فيها فرط نشاط الغدد الدهنية إلى جعل الجلد دهنياً)",
 "しろうしょう": "سيلان دهني (حالة يؤدي فيها فرط نشاط الغدد الدهنية إلى جعل الجلد دهنياً)",
 "しろうせいひふえん": "إكزيما دهنية, التهاب الجلد الدهني (مرض جلدي مزمن مرتبط بالسيلان الدهني وقشور دهنية على فروة الرأس أو الجفون أو…)",
 "しろうとくさい": "غَيْر مَاهِر, هَاوٍ (يفتقر إلى المهارة أو الخبرة المهنية)",
 "しろうとげしゅく": "بنزيون, نزل داخلي (منزل خاص يوفر الإقامة والوجبات للضيوف مقابل أجر)",
 "しろうま": "رغوة الموج, زبد الموج (موجة تهب عليها الرياح فينكسر عرفها ويظهر أبيض اللون)",
 "しろうんも": "مُوسْكُوفِيّ",
 "しろえりはげわし": "نسر أسمر (الكشط والجرح والنقب؛ طَيْر من الجَوَارِح أكبرها حجما يقتات الجِيَف وله منقار…)\nمثال: الصغر أسرع من النسر",
 "しろかじき": "مارلين أسود (سمكة صيد كبيرة في المحيط الهادئ؛ قد يصل وزنها إلى 1000 رطل)",
 "しろかね": "فِضَّة (فِي : فِلِزّ أَبْيَض قَابِلٌ لِلسَّحب والطَّرْق والصَّقْل، من أكثر المواد…)\nمثال: يقدر القبايل الفضة أكثر من الذهب.",
 "しろかび": "تَعَفُّن, عُفُونَة",
 "しろかもめ": "عمدة (عمدة بلدية في ألمانيا أو هولندا أو فلاندرز أو النمسا)",
 "しろがね": "فِضَّة (فِي : فِلِزّ أَبْيَض قَابِلٌ لِلسَّحب والطَّرْق والصَّقْل، من أكثر المواد…)\nمثال: يقدر القبايل الفضة أكثر من الذهب.",
 "しろがねあじ": "سمكة لوك داون (تشبه سمكة القمر ولكن عيونها مرتفعة على الجبهة المقطوعة)",
 "しろがみかくめい": "كتاب أبيض, ورقة بيضاء (تقرير حكومي؛ يغلف عادة بغلاف أبيض)",
 "しろがらし": "خَرْدَل أَبْيَض",
 "しろきっぷ": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "しろきぬ": "شخص عادي, علماني (شخص ليس رجل دين وليس متخصصاً مهنياً)",
 "しろぎつね": "ثعلب أبيض, ثعلب قطبي (ثعلب كثيف الفرو من المناطق القطبية؛ بني في الصيف وأبيض في الشتاء)",
 "しろぎぬ": "شخص عادي, علماني (شخص ليس رجل دين وليس متخصصاً مهنياً)",
 "しろく": "أَرْبَعَة وَعِشْرُون (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "しろくじちゅう": "على مدار اليوم (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "しろくじら": "بيلوغا, حوت أبيض (حوت شمالي صغير يكون لونه أبيض عند البلوغ)",
 "しろくま": "دُبّ أَبْيَض, دُبَّة بَيْضَاء",
 "しろくろ": "صورة أبيض وأسود, صورة أحادية اللون (صورة فوتوغرافية أو شريحة بالأبيض والأسود)",
 "しろくろえりまききつねざる": "أَبْيَض وَأَسْوَد (ليس لديه أو غير قادر على إنتاج الألوان)\nمثال: فيلم أبيض وأسود",
 "しろくろテレビ": "أَبْيَض وَأَسْوَد (ليس لديه أو غير قادر على إنتاج الألوان)\nمثال: فيلم أبيض وأسود",
 "しろぐち": "كرواكر أبيض (سمكة طعام بحرية فضية صغيرة توجد قبالة كاليفورنيا)",
 "しろぐわい": "كستناء الماء, كستناء الماء الصينية (سعد صيني ينتج درنات صالحة للأكل على شكل بصيلة)",
 "しろげ": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون…)\nمثال: هذا الكلب أبيض.",
 "しろこ": "أَمْهَق",
 "しろごめ": "أرز أبيض (أرز تمت إزالة القشرة أو الطبقات البنية الخارجية منه)",
 "しろさい": "وحيد القرن الأبيض (وحيد قرن أفريقي كبير رمادي فاتح له قرنان؛ مهدد بالانقراض)",
 "しろさびびょう": "صدأ أبيض (فطر يسبب مرضاً يتميز بكتلة مسحوقية بيضاء من الكونيديا)",
 "しろざけ": "سلمون الكيتا (سلمون كبير من المحيط الهادئ ذو بقع صغيرة على ظهره؛ سمكة طعام مهمة)",
 "しろしめす": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "しろしゅもくざめ": "قرش المطرقة الأملس (يتم صيده من أجل جلوده وكبده الغني بالفيتامينات)",
 "しろじ": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه…)\nمثال: عندي ابنا خالة.",
 "しろぞう": "فيل أبيض (فيل هندي أمهق؛ نادر ومقدس أحياناً في شرق آسيا)",
 "しろた": "ثَلْجِيّ, مُكَلَّل بِالثَّلْج (مغطى بالثلج) / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "しろたえ": "أَبْيَض, أبيض (اسم لون البَيَاض، أي ما كان لونه كالثلج النظيف أو حليب الجاموس. وهذا اللون…)\nمثال: هذا الكلب أبيض.",
 "しろたえぎく": "قرنفل البوصير, ليخنيس إكليلي (نبات حديقة قديم في جنوب شرق أوروبا يزرع على نطاق واسع لأوراقه الصوفية البيضاء…)",
 "しろちゃ": "شَاي أَبْيَض (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي…)\nمثال: صب الشاي لضيفك.",
 "しろちょうがい": "أَبْيَض الشَّفَتَيْن مِنَ الخَوْف (ابيضّت شفتاه من الخوف أو الرعب)",
 "しろっぽい": "أَبْيَض مَائِل, مُبْيَضّ (بلون يميل إلى البياض) / غَيْر مَاهِر, هَاوٍ (يفتقر إلى المهارة أو الخبرة المهنية)",
 "しろつめくさ": "نفل أبيض, نفل زاحف (نفل أوروبي زاحف ذو أزهار بيضاء إلى وردية وأوراق خضراء زاهية؛ متوطن في الولايات…)",
 "しろてん": "قَاقِم",
 "しろという": "أَصَرَّ (لواه وشدّه وربطه؛ أَصَرَ الشيءَ: كَسَرَهُ وعَطَفه)\nمثال: أصر على الأفضل.",
 "しろとび": "بياض شامل, تعتيم ثلجي (حالة جوية قطبية بوجود سحب فوق الثلج تنتج بياضاً موحداً وتصعب رؤية الأشياء؛ تحدث…)",
 "しろとり": "تَمّ, قُقْنُس",
 "しろと言う": "أَصَرَّ (لواه وشدّه وربطه؛ أَصَرَ الشيءَ: كَسَرَهُ وعَطَفه)\nمثال: أصر على الأفضل.",
 "しろながすくじら": "حوت أزرق (أكبر حيوان ثديي معروف على الإطلاق؛ حوت باليني مهاجر أزرق رمادي يعيش غالباً في…)",
 "しろなまず": "بُهَاق",
 "しろにく": "كرشة",
 "しろにんじん": "جَزَر أَبْيَض (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ…)\nمثال: ضع الجزر في القدر.",
 "しろはた": "راية الهدنة, علم أبيض (علم يتكون من قطعة قماش بيضاء تُرفع للإشارة إلى الاستسلام أو لطلب الهدنة)",
 "しろはと": "يَمَام, حَمَام",
 "しろはやぶさ": "سنقر (صقر قطبي كبير ونادر له أطوار لونية بيضاء وداكنة)",
 "しろばなむしよけぎく": "بيرثروم, عاقر قرحا (بيرثروم أبيض الزهر من منطقة البلقان أوراقه الريشية بيضاء ومشعرّة حريرياً من…)",
 "しろびたい": "إِجَّامَة",
 "しろぶた": "أبيض, قوقازي (شخص من أصل أوروبي ذو بشرة فاتحة أو شاحبة)",
 "しろぶどうしゅ": "نَبِيذ أَبْيَض, خَمْر أَبْيَض (نَبِيذ (صفة مفردة مذكرة، مؤنثها نَبِيْذَة، وجمعها السالم نَبِيْذُوْن، وجمعها…)\nمثال: أنا شربت النبيذ.",
 "しろぼし": "اِنْتِصَار, نَصْر",
 "しろまじゅつ": "سحر أبيض (سحر يُستخدم لأغراض خيرة فقط)",
 "しろまほう": "سحر أبيض (سحر يُستخدم لأغراض خيرة فقط)",
 "しろみ": "غِرْقِل, آح البَيْض / صدر, لحم أبيض (اللحم المقطع من صدر الطائر) / خَشَب النُّسْغِ, خَشَب كَاذِب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع…)\nمثال: نحن نقطع الخشب. / بيوتر, سبيكة القصدير والرصاص (أي من سبائك القصدير المختلفة مع كميات صغيرة من معادن أخرى (خاصة الرصاص)) / بَيَاض",
 "しろみがかった": "أَبْيَض مَائِل, مُبْيَضّ (بلون يميل إلى البياض)",
 "しろめ": "بيوتر, سبيكة القصدير والرصاص (أي من سبائك القصدير المختلفة مع كميات صغيرة من معادن أخرى (خاصة الرصاص))",
 "しろめをむく": "إِغْمَاء",
 "しろもの": "مَقَال, مَقَالَة\nمثال: لا أحب مادة العلوم. / حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة)\nمثال: لو علمت أنه حبيبها لما سألت / دَاعِرَة, بَغِيَّة / ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن. / بياضات منزلية, سلع بيضاء (سلع جافة للاستخدام المنزلي مصنوعة عادة من قماش أبيض) / مِلْح, ملح",
 "しろものかでん": "بياضات منزلية, سلع بيضاء (سلع جافة للاستخدام المنزلي مصنوعة عادة من قماش أبيض)",
 "しろもみ": "شوح بهي, شوح فضي باسيفيكي (شوح متوسط إلى طويل من غرب أمريكا الشمالية له تاج مخروطي وفروع في طبقات؛ الأوراق…)",
 "しろわに": "قرش الرمل, قرش الرمل الببري (قرش المياه الضحلة ذو أسنان حادة مسننة يوجد على جانبي المحيط الأطلسي؛ خطير…)",
 "しろん": "مَقَالَة, بَحْث",
 "しろんぼ": "أبيض, قوقازي (شخص من أصل أوروبي ذو بشرة فاتحة أو شاحبة)",
 "しろインゲンまめ": "فاصولياء بيضاء (فاصولياء ذات بذور بيضاء؛ عادة ما تكون مجففة)",
 "しろインゲンマメ": "فاصولياء بيضاء (فاصولياء ذات بذور بيضاء؛ عادة ما تكون مجففة)",
 "しろテン": "قَاقِم",
 "しろワイン": "نَبِيذ أَبْيَض, خَمْر أَبْيَض (نَبِيذ (صفة مفردة مذكرة، مؤنثها نَبِيْذَة، وجمعها السالم نَبِيْذُوْن، وجمعها…)\nمثال: أنا شربت النبيذ.",
 "しわ": "جَعْدَة / تموج صغير, مويجة (موجة صغيرة على سطح سائل)",
 "しわい": "بَخِيل (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ…)\nمثال: بئس الرجل البخيل. / إِنْفَحَة",
 "しわがよる": "جَعْدَة",
 "しわが寄る": "جَعْدَة",
 "しわくちゃ": "مُجَعَّد, مُنْبَعِج (عن المعدن مثلاً؛ مُحنٍ أو مُنبعِج)",
 "しわけ": "تَصْنِيف",
 "しわけしょ": "مُوَاصَفَة",
 "しわけひょう": "رتك المحور, عنق المحور (جزء المحور المحتوي داخل المحمل)\nمثال: يقرأ المجلات الطبية",
 "しわける": "صَنَّفَ, قَسَّمَ",
 "しわざ": "مَأْثُرَة",
 "しわし": "دَاعِرَة, بَغِيَّة",
 "しわしわ": "مُجَعَّد, مُنْبَعِج (عن المعدن مثلاً؛ مُحنٍ أو مُنبعِج)",
 "しわしわネーム": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "しわす": "دِيسِمْبِر, دِيسَمْبِر (الشهر الثاني عشر في السنة الروميّة)\nمثال: أنا في إضراب من 8 إلى 12 ديسمبر.",
 "しわだらけ": "مُغَضَّن",
 "しわっぽい": "مُغَضَّن",
 "しわとり": "شد الوجه (جراحة تجميلية لإزالة التجاعيد وعلامات الشيخوخة الأخرى من الوجه؛ يتم عمل شق قرب…)\nمثال: بعض الممثلات يقمن بأكثر من عملية شد وجه",
 "しわのばし": "اِسْتِجْمَام",
 "しわぶき": "كَحَّ, سَعَلَ\nمثال: سعل زيري مرة أخرى.",
 "しわぶく": "كَحَّ, سَعَلَ\nمثال: سعل زيري مرة أخرى.",
 "しわほう": "لغة الإشارة (لغة يتم التعبير عنها بإيماءات اليد المرئية) / الكلام المرئي (مخطط طيفي للكلام؛ عرض الكلام طيفياً)",
 "しわよせ": "حِمْل, عِبْء (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "しわる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "しわをのばす": "اِسْتَقَامَ (أَقَامَ نفسه)",
 "しわをよせる": "ثَلْم (ثلَم الإناءَ: كسر حرفَه؛ ثلَم الحائطَ: أحدث خلل أو شقّ في الحائط)",
 "しわを寄せる": "ثَلْم (ثلَم الإناءَ: كسر حرفَه؛ ثلَم الحائطَ: أحدث خلل أو شقّ في الحائط)",
 "しわんぼう": "بَخِيل, بَخِيلَة (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ…)\nمثال: بئس الرجل البخيل.",
 "しわん坊": "بَخِيل, بَخِيلَة (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ…)\nمثال: بئس الرجل البخيل.",
 "しわ伸ばし": "اِسْتِجْمَام",
 "しわ取り": "شد الوجه (جراحة تجميلية لإزالة التجاعيد وعلامات الشيخوخة الأخرى من الوجه؛ يتم عمل شق قرب…)\nمثال: بعض الممثلات يقمن بأكثر من عملية شد وجه",
 "しわ寄せ": "حِمْل, عِبْء (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "しわ胃": "إِنْفَحَة",
 "しをいたす": "اِسْتَقَالَ",
 "しをえらぶ": "اِنْتَحَرَ",
 "しん": "جَدِيد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد / جدة, حداثة (جودة كون الشيء جديداً؛ عكس القدم) / التَقْوِيم الغَرْبِيّ, التَقْوِيم المِيلَادِيّ / حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة. / جِدِّيَّة / أمانة, صدق (صفة كون الشخص صادقاً) / ثِقَة\nمثال: وثق سامي بليلى ثقة عمياء. / إِيمَان, مُعْتَقَد / فَتِيل, فَتِيلَة / نِوَاة / مِدَقَّة / سَدَاة / قَلْب, فُؤَاد / نِوَاة / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف)\nمثال: مسؤولية السنتر هي إيصال الكرة إلى الكوارترباك / صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة. / تشين, سلالة تشين (السلالة الصينية (من 246 قبل الميلاد إلى 206 قبل الميلاد) التي أسست أول حكومة…) / مثبت أسنان (جهاز سني يثبت الأسنان (أو طرف صناعي) في موضعها بعد علاج تقويم الأسنان) / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / تشينغ, سلالة تشينغ (آخر سلالة إمبراطورية للصين (من 1644 إلى 1912) والتي أطاح بها الثوار؛ خلال سلالة…) / تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة) / أُلْفَة / رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة. / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب. / طَفْح, طَفْح جِلْدِيّ / تَحْذِير, إِنْذار / مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "しんあい": "أُلْفَة / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة)\nمثال: هذه رسالة من شخص عزيز.",
 "しんあん": "حلي رخيصة, حلية مبهرجة (مجوهرات رخيصة ومبهرجة أو زينة على الملابس)",
 "しんい": "مَلَابِس دَاخِلِيَّة, لِبَاس دَاخِلِيّ / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل. / غَضَب / إِلَٰهِيَّة / ملابس نوم (ملابس مصممة للارتداء في السرير) / ثِقَة\nمثال: وثق سامي بليلى ثقة عمياء.",
 "しんいき": "قدس الأقداس, منطقة المذبح (المنطقة المحيطة بمذبح الكنيسة لرجال الدين والجوقة؛ غالباً ما تكون محاطة بسياج…)",
 "しんいり": "قادم جديد, مستجد (أي مشارك جديد في نشاط ما)\nمثال: هو وافد جديد إلى بوسطن",
 "しんいん": "نشوء نفسي (مصطلح عام لأصل وتطور أي جانب من جوانب العقل تقريبًا)",
 "しんいんしょうしゅぎ": "انطباعية جديدة (حركة في أواخر القرن التاسع عشر في الرسم الفرنسي سعت لتحسين الانطباعية من خلال…)\nمثال: الانطباعية الجديدة لماكسيميليان لوس ومؤيده روبرت بيرنييه، على سبيل المثال، يجب تمييزها عن تلك الخاصة بسورا ومؤيده غوستاف خان",
 "しんいんせい": "نَفْسِيّ المَنْشَأ (ذو منشأ نفسيّ أو عاطفيّ لا جسديّ)",
 "しんいんひょうびょう": "رَفِيع, سَامٍ (مَرْفُوعُ الشَّأْنِ؛ فِي حَالَةِ سُمُوٍّ رُوحِيّ)",
 "しんうち": "الفنان المتصدر, نجم الحفل (فنان يوضع اسمه في صدارة الإعلانات لكونه الأبرز)",
 "しんうちゅう": "فضاء سحيق, فضاء عميق (أي منطقة في الفضاء خارج النظام الشمسي)",
 "しんうん": "تَقَدُّم",
 "しんえい": "مُجْتَهِد, نَشِيط (يعمل بجدّ لتعزيز مشروع أو مؤسّسة)",
 "しんえいたい": "حَرَس خَاصّ, حَرَس (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً…)\nمثال: كان لدى سامي حرس شخصي. / القوات الخاصة, شوتزشتافل (قوة شرطة خاصة في ألمانيا النازية تأسست كحرس شخصي لأدولف هتلر عام 1925؛ أدارت…) / مُعْجَبَة (معجبة شابة متحمسة (خاصة التي تتبع فرق الروك))",
 "しんえき": "لُعَاب, رِيق / سَائِل, مَائِع",
 "しんえん": "عَاطِفَة, شَغْف\nمثال: قبل توم ماري بشغف. / سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / هَاوِيَة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة)\nمثال: وصل سامي إلى قاع الهاوية ماليا. / التهاب القلب (التهاب القلب)",
 "しんえんど": "دائرية, شكل قرصي (استدارة شكل ثنائي الأبعاد)",
 "しんえんるい": "قِرْدِيَّاتُ الشَّكْلِ",
 "しんおう": "أعماق, أغوار ((الجمع) الجزء الأعمق والأكثر بعداً)\nمثال: من أعماق أفريقيا المظلمة / سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / مَرْكَز, مَرْكَز اَلزِّلْزَال (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "しんおん": "شَفَوِيّ, شَفَهِيّ / ارتجاف, تريمولو (فيبراتو صوتي خاصة المفرط أو سيئ التحكم) / تَكْرِير",
 "しんか": "تَأْلِيه / مثبت أسنان (جهاز سني يثبت الأسنان (أو طرف صناعي) في موضعها بعد علاج تقويم الأسنان) / تَطَوُّر / تعميق (عملية أن يصبح الشيء أعمق وأكثر عمقاً)",
 "しんかい": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / العالم الروحي, عالم الغيب (اعتقاد بوجود عالم تسيطر عليه روح إلهية)",
 "しんかいぎょ": "أَعْمَاقِيّ بَحْرِيّ (يتعلق بـأو يحدث في الأجزاء العميقة من البحر)",
 "しんかいぎょぎょう": "أَعْمَاقِيّ بَحْرِيّ (يتعلق بـأو يحدث في الأجزاء العميقة من البحر)",
 "しんかいせん": "مُلْتَفّ بِإِحْكَام ((لبعض الأصداف) ملتفّ بإحكام بحيث يختفي المحور)",
 "しんかいたい": "المنطقة السحيقة, نطاق الأعماق (أعماق البحر (2000 متر أو أكثر) حيث لا يوجد ضوء)",
 "しんかいち": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "しんかく": "إِلَٰهِيَّة",
 "しんかくか": "تَأْلِيه",
 "しんかくせいぶつ": "حقيقيات النوى",
 "しんかしゅぎ": "تطورية, نظرية التطور ((أحياء) نظرية علمية لأصل أنواع النباتات والحيوانات)",
 "しんかせいぶつがく": "علم الأحياء التطوري (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "しんかてきにあんていなせんりゃく": "إِس",
 "しんかはっせいがく": "علم الأحياء النمائي التطوري (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "しんかぶひきうけけん": "اسْتِبَاقِيّ, وِقَائِيّ مُسْبَق (مُصمَّم لمنع حدوث أمر متوقَّع أو إحباطه)",
