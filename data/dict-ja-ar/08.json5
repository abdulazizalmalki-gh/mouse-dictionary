 "じゅんをおって": "فِي حَالَةِ اسْتِعْدَاد (في وضع سليم من الجاهزية والترتيب)",
 "じゅんツ": "تشاو تشاو (سلالة من الكلاب متوسطة الحجم ذات معطف سميك وذيول مجعدة رقيقة وألسنة زرقاء سوداء…)",
 "じゆう": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل. / حُرِّيَّة, حرية (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ…)\nمثال: الحرية لفلسطين.",
 "じゆういし": "حُرِّيَّة الْإِرَادَة (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ…)\nمثال: الحرية لفلسطين.",
 "じゆういしろん": "تحررية مفرطة, ليبرتارية (اعتقاد أيديولوجي بحرية الفكر والكلام والعمل)",
 "じゆうか": "تحرير, تخفيف القيود (عملية جعل الشيء أقل صرامة)",
 "じゆうかしか": "أَعْطِنِي",
 "じゆうかって": "حُرّ (ضد البَرْد)\nمثال: أنا حر كالطائر.",
 "じゆうがきかない": "مُقَيَّد (يخضع لقيود في الاطّلاع والتداول)\nمثال: ذو أهمية محدودة",
 "じゆうがた": "أسلوب حر, سباحة حرة (سباق (كما في السباحة) يمتلك فيه كل متسابق حرية اختيار الأسلوب الذي سيستخدمه)",
 "じゆうきまま": "حُرّ (ضد البَرْد)\nمثال: أنا حر كالطائر.",
 "じゆうぎょう": "حر, مستقل (يعمل لنفسه (وليس موظفاً دائماً))",
 "じゆうけい": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "じゆうけいやく": "انتقال حر ((رياضة) حالة اللاعب المحترف الحر في التفاوض على عقد للعب لأي فريق) / حر, مستقل (يعمل لنفسه (وليس موظفاً دائماً))",
 "じゆうけいやくせんしゅ": "رُوح حُرَّة, شَخْص مُتَحَرِّر (شخص يتصرف بحرية أو حتى بمسؤولية أقل)",
 "じゆうけん": "حرية مدنية (حق فردي أساسي يحميه القانون ويُعبر عنه بالحصانة من التدخل الحكومي غير المبرر)",
 "じゆうけんきやくじんけんいいんかい": "الْأُمَم الْمُتَّحِدَة",
 "じゆうけんきゅう": "بحث علمي, مشروع بحثي (البحث في الأسئلة التي تطرحها النظريات والفرضيات العلمية)",
 "じゆうこう": "ميناء حر (ميناء مفتوح بشروط متساوية لجميع السفن التجارية)",
 "じゆうこく": "ولاية حرة (أي ولاية كانت تحظر العبودية قبل الحرب الأهلية الأمريكية)",
 "じゆうさいりょう": "دَائِرَة عَرْض, خَطّ عَرْض (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر…)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "じゆうさんか": "شِجَار صَاخِب (قتال صاخب وسط حشد من الناس) / اِخْتِيَارِيّ",
 "じゆうざんまい": "حُرّ (ضد البَرْد)\nمثال: أنا حر كالطائر.",
 "じゆうし": "شعر حر (شعر غير مقفى وبدون نمط وزني ثابت)",
 "じゆうしじょうしゅぎ": "تحررية مفرطة, ليبرتارية (اعتقاد أيديولوجي بحرية الفكر والكلام والعمل)",
 "じゆうしそう": "ربوبية, فكر حر (شكل من أشكال العقلانية اللاهوتية يؤمن بالله على أساس العقل دون الرجوع إلى الوحي)",
 "じゆうしそうか": "مفكر حر (شخص يرفض الدين)",
 "じゆうしゅぎ": "لِيبْرَالِيَّة",
 "じゆうしゅぎしゃ": "رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح)",
 "じゆうじかん": "رَاحَة, خُلُو مِنَ الْعَمَل\nمثال: いくらか自由時間があるときは、いつもクラシック音楽を聴くのが楽しみだ。 — أحب دائما أن أستمع للموسيقى الكلاسيكية عندما يكون لدي وقت فارغ.",
 "じゆうじざい": "حُرّ (ضد البَرْد)\nمثال: أنا حر كالطائر.",
 "じゆうじん": "رُوح حُرَّة, شَخْص مُتَحَرِّر (شخص يتصرف بحرية أو حتى بمسؤولية أقل)",
 "じゆうせかい": "الْعَالَم الْحُرّ",
 "じゆうせんし": "محارب للحرية",
 "じゆうちょう": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "じゆうでんし": "إِلِكْتْرُون حُرّ (إلكترون غير مرتبط بذرة أو أيون أو جزيء ولكنه حر الحركة تحت تأثير مجال كهربائي)",
 "じゆうとう": "الحزب الليبرالي (حزب سياسي في أستراليا وكندا ودول أخرى، وسابقاً في بريطانيا العظمى)",
 "じゆうとし": "مَشَاعِيَّة",
 "じゆうど": "درجة الحرية ((إحصاء) متغير غير مقيد في توزيع التردد)",
 "じゆうに": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "じゆうのみ": "حُرِّيَّة, حرية (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ…)\nمثال: الحرية لفلسطين.",
 "じゆうのめがみ": "تِمْثَال الْحُرِّيَّة\nمثال: 自由の女神はアメリカの象徴である。 — تمثال الحرية رمزٌ لأمريكا.",
 "じゆうのめがみぞう": "تِمْثَال الْحُرِّيَّة",
 "じゆうほんぽう": "طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة)",
 "じゆうぼうえき": "تِجَارَة حُرَّة",
 "じゆうぼうえききょうてい": "تِجَارَة حُرَّة",
 "じゆうぼうえきたいいき": "تِجَارَة حُرَّة",
 "じゆうぼうえきちいき": "تِجَارَة حُرَّة",
 "じゆうぼうえきていこくしゅぎ": "تِجَارَة حُرَّة",
 "じゆうみん": "أحرار (الناس الذين يتمتعون بالحرية)\nمثال: موطن الأحرار والشجعان",
 "じゆうらっか": "انخفاض حاد, سقوط (انخفاض حاد ومفاجئ في كمية ما)\nمثال: انخفاض بمقدار 57 نقطة في مؤشر داو جونز",
 "じゆうれんあい": "جنس خارج إطار الزواج, حب حر (الجماع الجنسي بين أفراد غير متزوجين من بعضهم البعض)",
 "じゆうれんそう": "تداعي حر (عملية تفكير تقترح فيها الأفكار (كلمات أو صور) أفكاراً أخرى في تسلسل)",
 "じゆうろうどうしゃ": "مُياوِم",
 "じゆうエネルギー": "طاقة ((في الفيزياء) كمية ديناميكية حرارية تكافئ قدرة نظام فيزيائي على القيام بشغل…)\nمثال: يمكن للطاقة أن تتخذ أشكالاً متنوعة",
 "じゆうソフトウェア": "بَرْمَجِيَّات حُرَّة",
 "じょ": "مُسَاعَدَة, مَعُونَة\nمثال: علي مساعدة ماري. / اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية. / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية. / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة. / توطئة, ديباجة (مقال تمهيدي قصير يسبق نص كتاب) / اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين)\nمثال: لم يظهر أي مراعاة لمشاعرها / تَقْسِيم\nمثال: الزواج قسمة و نصيب.",
 "じょい": "تنصيب, تولية (العمل الرسمي المتمثل في إلباس شخص ما شارة منصب؛ الترقية الرسمية لشخص إلى منصب…)",
 "じょいん": "أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية)",
 "じょう": "مُفَتِّش, مُفَتِّشَة / شَيْخ, عَجُوز / مُرَّان أَمْرِيكِيّ / بِخُصُوص, فِيمَا يَتَعَلَّقُ بِـ / عَلَى (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / أَفْضَل / إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر / امرأة غير متزوجة, عزباء (امرأة ليست متزوجة) / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ. / ـَة / مشاعر (الحساسية العاطفية أو الأخلاقية (خاصة فيما يتعلق بالمبادئ الشخصية أو الكرامة))\nمثال: جرحت الملاحظة مشاعره / رَحْمَة\nمثال: زيري مثير للشفقة. / عَاطِفَة, شَغْف\nمثال: قبل توم ماري بشغف. / صُورَة, شَكْل\nمثال: اجلس بشكل مريح. / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء. / قُفْل (أَغْلَقَ أو سَدَّ البابَ أو الشَّيْءَ؛ في بعض السياقات: عادَ أو رجَعَ إلى مكانه…)\nمثال: يحاول توم كسر القفل. / لَوْح / مَقَال, مَقَالَة\nمثال: لا أحب مادة العلوم. / رَغْم أَنَّ, مَعَ أَنَّ ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال…)\nمثال: إنه سعيد رغم فقره. / مُنْذُ / قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة. / ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / قَلْعَة, قِلْعَة (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة. / طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير. / سيد (صيغة خطاب للرجل) / مَيْدَان\nمثال: هذا المكان مقدس / يَقِين (والقيد الأول جنس يشتمل إلى الظن أيضاً؛ والثاني يخرج الظن)\nمثال: اليقين الإيمان كله. / عَادِيّ",
 "じょうあい": "عاطفة, محبة (شعور إيجابي بالإعجاب)\nمثال: وجد صعوبة في التعبير عن المودة التي شعر بها",
 "じょうい": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / إرَادَة / شُعُور, إِحْسَاس / مِعْطَف / قِمَّة / تنازل عن العرش (فعل التنازل عن العرش) / غُرْفَةْ الاِسْتِقْبَال, غُرْفَةْ جُلُوس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة.",
 "じょういうち": "تَنْفِيذ\nمثال: محكم عليه بالإعدام.",
 "じょういかたつ": "من أعلى لأسفل (لنهج في حل المشكلات يبدأ من أعلى مستوى مفاهيمي ويعمل نزولاً إلى التفاصيل)\nمثال: تحليل من أعلى لأسفل قد يبدأ بالنظر في اتجاهات الاقتصاد الكلي",
 "じょういげだつ": "من أعلى لأسفل (لنهج في حل المشكلات يبدأ من أعلى مستوى مفاهيمي ويعمل نزولاً إلى التفاصيل)\nمثال: تحليل من أعلى لأسفل قد يبدأ بالنظر في اتجاهات الاقتصاد الكلي",
 "じょういご": "اسم شامل, لفظ أعم (كلمة أكثر شمولاً وعمومية من كلمة أخرى)",
 "じょういごかんせい": "توافقية مستقبلية",
 "じょういじん": "قادة, قيادة (هيئة الأشخاص الذين يقودون مجموعة)\nمثال: تبنت القيادة الوطنية خطته",
 "じょういたいばんそうきはくり": "انفصال المشيمة المبكر (اضطراب في الحمل تنفصل فيه المشيمة قبل الأوان عن جدار الرحم)",
 "じょういん": "عضو طاقم (عضو في طاقم عمل) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / مَجْلِس عُلْوِيّ",
 "じょういんぎいん": "سِنَاتُور, سِنَاتُورَة",
 "じょういんぎかい": "مَجْلِس الشُّيُوخ",
 "じょういグループ": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "じょうえい": "فحص تحري, فرز (اختبار الأشياء أو الأشخاص لتحديد أولئك الذين لديهم خصائص معينة)\nمثال: أخفى الغطاء بنادقهم عن طائرات العدو",
 "じょうえいかん": "دار عرض سينمائي, سينما (مسرح تُعرض فيه الأفلام)",
 "じょうえいじかん": "مدة العرض, وقت التشغيل (طول الوقت الذي يستمر فيه فيلم أو عرض تلفزيوني)",
 "じょうえん": "أَدَاء",
 "じょうえんかほうふん": "تل مدفني, رابية الدفن ((في علم الآثار) كومة من التراب توضع فوق مقابر ما قبل التاريخ)",
 "じょうおう": "مَلِكَة, ملكة (مؤنث مَلِك)\nمثال: ليحفظ الله الملكة. / ملكة قرينة (زوجة الملك الحاكم) / أَمِيرَة",
 "じょうおうさま": "سَيِّدَة",
 "じょうおろす": "قُفْل (أَغْلَقَ أو سَدَّ البابَ أو الشَّيْءَ؛ في بعض السياقات: عادَ أو رجَعَ إلى مكانه…)\nمثال: يحاول توم كسر القفل.",
 "じょうおん": "درجة حرارة الغرفة (درجة الحرارة العادية للغرفة التي يعيش فيها الناس) / نغمة تابعة, نغمة فوقية (نغمة توافقية ذات تردد يمثل مضاعفاً للتردد الأساسي)\nمثال: إيحاءات اليأس",
 "じょうおんかくゆうごう": "اِنْدِمَاج بَارِد",
 "じょうか": "تَطْهِير (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير. / تنظيف (فعل جعل الشيء نظيفاً)\nمثال: قام بتنظيف حذائه جيداً / ذهاباً وإياباً, صعوداً وهبوطاً (التحرك للخلف وللأمام على طول مسار معين)\nمثال: مشى ذهاباً وإياباً في غرفة تبديل الملابس / عَاطِفَة, شَغْف\nمثال: قبل توم ماري بشغف. / أغنية حب, أغنية عاطفية (أغنية عن الحب أو تعبر عن الحب لشخص آخر) / فوق فصيلة ((في الأحياء) مجموعة تصنيفية تقع تحت الرتبة ولكن فوق الفصيلة)",
 "じょうかい": "حد أعلى ((رياضيات) عدد يساوي أو أكبر من أي عدد آخر في مجموعة معطاة) / طَبْخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ.",
 "じょうかく": "ضيف الشرف (الشخص الذي يُعقد التجمع تكريماً له) / قَلْعَة, قِلْعَة (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة. / إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "じょうかそう": "خزان تحليل, خزان صرف صحي (خزان كبير يتم فيه تفكيك المواد الصلبة أو مياه الصرف الصحي بواسطة البكتيريا)",
 "じょうかそうち": "جهاز تنقية, منقٍّ (جهاز لإزالة الشوائب)",
 "じょうかのちかい": "اِسْتِسْلَام",
 "じょうかのめい": "اِسْتِسْلَام",
 "じょうかん": "شُعُور, إِحْسَاس / اشتراط, شرط (قيد يتم الإصرار عليه كشرط للاتفاق)\nمثال: تم عمل إقرار بالوقائع لتجنب التأخير",
 "じょうかんぱん": "سطح علوي (سطح مرتفع)",
 "じょうが": "قاعدة تثبيت (هيكل يستخدم للدعم أو العرض)",
 "じょうがいかぶ": "سهم خارج المقصورة, سهم غير مدرج (سهم غير مدرج ومتداول في بورصة منظمة)",
 "じょうがいしじょう": "سوق التداول المباشر, سوق خارج البورصة (بورصة أسهم تتم فيها معاملات الأوراق المالية عبر الهاتف والكمبيوتر بدلاً من قاعة…) / سوق التجزئة (السوق لبيع السلع أو الخدمات للمستهلكين بدلاً من المنتجين أو الوسطاء)",
 "じょうがいとりひき": "خَارِج البُورْصَة ((في الأوراق المالية) لا يُتَداوَل في سوق الأَوْراق المالِيَّة الرَّسْمِيّ)",
 "じょうがうすい": "بارد المشاعر, قاسي القلب (يفتقر إلى التعاطف أو الشعور)",
 "じょうがく": "فك علوي (الفك في الفقاريات الذي يندمج مع القحف)",
 "じょうがくこつ": "فك علوي (الفك في الفقاريات الذي يندمج مع القحف)",
 "じょうがこわい": "عَنِيد",
 "じょうき": "شطف (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن…) / الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ / نظام المعلومات (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل. / بُخَار (كلُّ رَائِحَةٍ سَطَعَتْ مِنْ نَتْنٍ أَو غَيْرِهِ؛ كل مَا يصعد كالدخان من…)\nمثال: السحابة هي كتلة بخار في السماء. / بَاخِرَة, سَفِينَة بُخَارِيَّة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار)\nمثال: الباخرة الآن في الميناء. / اشتراط, شرط (قيد يتم الإصرار عليه كشرط للاتفاق)\nمثال: تم عمل إقرار بالوقائع لتجنب التأخير / مِعْيَارِيّ / طَائِرَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير…)\nمثال: لقد وصلت الطائرة. / ركوب, صعود (فعل صعود الركاب والطاقم على متن سفينة أو طائرة)",
 "じょうききかん": "محرك بخاري (محرك احتراق خارجي تستخدم فيه الحرارة لتوليد البخار الذي يدير توربينة أو يجبر…)",
 "じょうききかんしゃ": "قِطَار بُخَارِيّ",
 "じょうきげん": "انشراح, روقان (مزاج مبتهج ومقبول)",
 "じょうきせん": "بَاخِرَة, سَفِينَة بُخَارِيَّة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار)\nمثال: الباخرة الآن في الميناء.",
 "じょうきだんぼう": "تدفئة بالبخار (نظام تدفئة يتم فيه توليد البخار في غلايات ونقله بالأنابيب إلى مشعات)",
 "じょうきどう": "المسلك التنفسي العلوي (الأنف والحلق والقصبة الهوائية)",
 "じょうきどうえん": "المسلك التنفسي العلوي (الأنف والحلق والقصبة الهوائية)",
 "じょうきゃく": "ضيف الشرف (الشخص الذي يُعقد التجمع تكريماً له) / مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب. / راعي; حامي; وصي; سيد; و",
 "じょうきゃくるい": "مجدافية الأرجل (قشريات بحرية أو مياه عذبة دقيقة لها عادة ستة أزواج من الأطراف على الصدر؛ بعضها…)",
 "じょうきゅうこくみん": "نُخْبَة",
 "じょうきゅうさいばんしょ": "محكمة عليا (أي محكمة لها اختصاص أعلى من محكمة أدنى)",
 "じょうきゅうそうちょう": "سمكة الرقيب, سمكة العريف (سمكة قعيسية كبيرة زرقاء رمادية مخططة بالأسود؛ توجد في جميع أنحاء العالم تقريباً)",
 "じょうきゅうふくしゃちょう": "نائب رئيس أول (نائب الرئيس الأعلى رتبة في شركة لديها أكثر من نائب رئيس)",
 "じょうきょ": "امتياز (عقد يمنح الحق في تشغيل عمل فرعي)\nمثال: حصل على امتياز البيرة في ملعب الكرة",
 "じょうきょう": "حالة, ظرف (الحالة العامة للأشياء؛ مجموعة الظروف في وقت معين)\nمثال: الوضع الدولي الحالي خطير",
 "じょうきょうしょうこ": "دليل ظرفي, قرينة (دليل يوفر فقط أساساً للاستنتاج حول الواقعة المتنازع عليها)",
 "じょうきょうせつめい": "إيجاز, تعليمات موجزة (تعليمات مفصلة، كما هو الحال لعملية عسكرية)",
 "じょうきょうほうこく": "تقرير سير العمل, تقرير مرحلي (تقرير عن العمل المنجز خلال فترة زمنية محددة)",
 "じょうきよく": "حمام بخار, حمام تركي (التعرق في غرفة بخار قبل الحصول على تدليك ودش بارد)",
 "じょうきをいっした": "شاذّ",
 "じょうきん": "بَدَوَام كَامِل (لعدد الساعات القياسي)\nمثال: تعمل بدوام كامل",
 "じょうきんこうし": "مُحَاضِر, مُحَاضِرَة",
 "じょうきタービン": "عنفة بخارية",
 "じょうぎ": "مِسْطَرَة (أداة تستخدم لقياس الأطوال أو رسم الخطوط المستقيمة؛ خط مستقيم تحدده مِسطَرة أو…)\nمثال: استعارت المسطرة. / أسرة, زمالة (رابطة لأشخاص يشتركون في معتقدات أو أنشطة مشتركة)\nمثال: الرسالة لم تكن موجهة للموظفين فحسب بل لكل عضو في أسرة الشركة",
 "じょうぎざ": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "じょうく": "طُرْفَة, نُكْتَة / تَكْرَار, إِعَادَة",
 "じょうくう": "سَمَاء, سما",
 "じょうぐう": "مِرْوَحَة, مروحة",
 "じょうけい": "الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ / مَشْهَد, مَسْرَحِيَّة / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "じょうけいき": "ذراع التطويل, عوارضة (أي من الصواري أو الأعمدة الأفقية المتنوعة المستخدمة لتمديد أسفل الشراع أو…)\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "じょうけん": "شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\"",
 "じょうけんけんさく": "مِصْفَايَة",
 "じょうけんせつ": "شَرْطِيّ (أحد المنتسبين إلى الشُرْطَة)\nمثال: تبدو وكأنك شرطي.",
 "じょうけんつき": "شَرْطِيّ (أحد المنتسبين إلى الشُرْطَة)\nمثال: تبدو وكأنك شرطي.",
 "じょうけんつきかくりつ": "احتمال مشروط (احتمال وقوع حدث ما بالنظر إلى وقوع حدث أو أحداث أخرى)",
 "じょうけんづけ": "تَكْيِيف",
 "じょうけんはんしゃ": "منعكس شرطي, منعكس مكتسب (استجابة مكتسبة تخضع لسيطرة (مشروطة بحدوث) محفز)",
 "じょうけんぶん": "جُمْلَة شَرْطِيَّة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة!",
 "じょうげ": "في كل حدب وصوب, في كل مكان (في كل مكان (عالياً ومنخفضاً))\nمثال: بحث في كل مكان / مُتَذَبْذِب, مُتَقَلِّب (يشهد صعودًا وهبوطًا غير قابلَيْن للتنبؤ) / قطعتان ((للملابس) مصنوع من أو يتكون من جزأين أو قطعتين)\nمثال: ملابس سباحة من قطعتين",
 "じょうげかんけい": "تسلسل هرمي, هرمية (تنظيم الأشخاص في مراتب ودرجات مختلفة داخل هيئة إدارية)",
 "じょうげげん": "حد, حدود (الخط أو المستوى الذي يشير إلى حد أو مدى شيء ما)",
 "じょうげさかさま": "رأساً على عقب, مقلوباً (في وضع مقلوب)\nمثال: كان الصندوق ملقى على الأرض مقلوباً",
 "じょうげせん": "ذهاباً وإياباً, صعوداً وهبوطاً (التحرك للخلف وللأمام على طول مسار معين)\nمثال: مشى ذهاباً وإياباً في غرفة تبديل الملابس",
 "じょうげれつ": "سِلْسِلَة",
 "じょうげん": "التربيع الأوّل, التربيع المتزايد / حد شمالي, حد علوي (الحد الموجود على الجانب العلوي (أو الشمالي) لشيء ما) / هَذَى",
 "じょうげんち": "حد أعلى ((رياضيات) عدد يساوي أو أكبر من أي عدد آخر في مجموعة معطاة)",
 "じょうげんのつき": "التربيع الأوّل, التربيع المتزايد",
 "じょうこ": "بَدَوَام كَامِل (لعدد الساعات القياسي)\nمثال: تعمل بدوام كامل",
 "じょうこう": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري) / جُمْلَة (مؤنث جُمْل، وهو الحبل الغليظ أو الجماعة من الناس؛ المَجْمُوع)\nمثال: يا لها من جملة! / جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس. / فوق طائفة ((في الأحياء) فئة تصنيفية تحت الشعبة وفوق الطائفة)",
 "じょうこうきょきん": "منشارية خلفية علوية (عضلة رباعية رقيقة في الجزء العلوي والظهري من الصدر؛ تعمل على رفع الأضلاع العلوية)",
 "じょうこうぐち": "أوتوبيس, باص (مركبة تحمل العديد من الركاب؛ تستخدم للنقل العام)\nمثال: كان دائماً يركب الحافلة للعمل",
 "じょうこうけっちょう": "قولون صاعد (جزء الأمعاء الغليظة الذي يصعد من الأعور إلى القولون المستعرض)",
 "じょうこうじょう": "مِنَصَّة",
 "じょうこうだいどうみゃく": "أبهر صاعد (الجزء الصاعد من الأبهر عند خروجه من البطين الأيسر)",
 "じょうこし": "تاريخ قديم (معرفة حقيقة أو حدث حديث أصبح معروفاً لدرجة أنه فقد أهميته الأصلية)",
 "じょうこん": "اِنْجِرَاف / جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "じょうご": "شَارِب / مِرْوَحَة, مروحة / ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات)",
 "じょうごう": "علامة الضرب, نقطة الضرب (علامة تشير إلى عملية الضرب) / اقتران علوي ((في علم الفلك) محاذاة الأرض وكوكب على الجانب المقابل من الشمس)",
 "じょうさい": "قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "じょうさいふく": "رداء القداس (رداء طويل بلا أكمام يرتديه الكاهن عند الاحتفال بالقداس)",
 "じょうさいぼう": "خلية ابنة, خلية وليدة (خلية تتكون عن طريق انقسام أو تبرعم خلية أخرى)\nمثال: تنمو الجمرة الخبيثة عن طريق الانقسام إلى خليتين وليدتين متطابقتين عموماً",
 "じょうさく": "تُحْفَة, رَائِعَة",
 "じょうさん": "نتح (انبعاث بخار الماء من أوراق النباتات) / اِبْنَة, بِنْت / آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "じょうさんけい": "مقياس التبخر (أداة تقيس معدل تبخر الماء)",
 "じょうさんさよう": "نتح (انبعاث بخار الماء من أوراق النباتات)",
 "じょうざい": "حَبَّة دَوَاء (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة)\nمثال: أكلت حبة طماطم. / تَبَرُّع, هِبَة / سَاكِن, سَاكِنَة",
 "じょうざぶぶっきょう": "بوذية التيرافادا, تيرافادا (واحدة من مدرستين عظيمتين للعقيدة البوذية تؤكدان على الخلاص الشخصي من خلال…)",
 "じょうざん": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "じょうざんき": "مَضْرُوب فِيه, مُعَامِل ضَرْب (العدد الذي يضرب به المضروب)",
 "じょうし": "نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل. / مَبْعُوث / أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / درع النبالة, شعار النبالة (الرموز الرسمية لعائلة أو دولة، إلخ) / قصة حب, قصة غرامية (قصة تتناول موضوع الحب) / بِنْت\nمثال: أنا أري الفتاة. / اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية. / زَوْجَة, اِمْرَأَة / عَالِيّ الرُتْبَة / بُودِيسَاتْفَا",
 "じょうしき": "اَلْحِسّ السَّلِيم / صِيغَة",
 "じょうしきじん": "اَلْحِسّ السَّلِيم",
 "じょうしきてき": "عَادِيّ, مَأْلُوف",
 "じょうしきはずれ": "خارج عن المألوف, غير تقليدي (غير مطابق للقواعد أو المعايير المقبولة)\nمثال: ملابسها وتسريحة شعرها غير التقليدية",
 "じょうしきやぶり": "خارج عن المألوف, غير تقليدي (غير مطابق للقواعد أو المعايير المقبولة)\nمثال: ملابسها وتسريحة شعرها غير التقليدية",
 "じょうしたい": "حزام صدري (دعامة هيكلية ترتبط بها الأطراف الأمامية للفقاريات)",
 "じょうしゃ": "ركوب, صعود (فعل صعود الركاب والطاقم على متن سفينة أو طائرة) / مبيضة, نسخة منقحة (نسخة نظيفة من مسودة مصححة)",
 "じょうしゃぐち": "دُخُول",
 "じょうしゃけん": "تَذْكِرَة",
 "じょうしゃていいん": "سعة المقاعد (عدد الأشخاص الذين يمكن جلوسهم في مركبة أو قاعة أو ملعب وما إلى ذلك)",
 "じょうしゅ": "مَاهِر, حَاذِق / تملق, نفاق (ثناء مفرط أو غير صادق) / رَاقٍ بِتَصَنُّع (أنيق بشكل مُتَظَاهَر) / مَزَاج / شَيْخ, قَائِد",
 "じょうしゅう": "عَادَة, عُرْف",
 "じょうしゅうしゃ": "مُدْمِن, مُدْمِنَة",
 "じょうしゅうてき": "مَأْلُوف, مُعْتَاد (شائع الاستخدام أو الممارسة؛ اعتيادي)",
 "じょうしゅうはん": "عائد للإجرام (شخص يُعتقل بشكل متكرر بسبب سلوك إجرامي (خاصة لنفس السلوك الإجرامي)) / عَوْد (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "じょうしょ": "عَاطِفَة, عَوَاطِف / جَو, غِلَاف جَوِّيّ / مبيضة, نسخة منقحة (نسخة نظيفة من مسودة مصححة) / حَارّ رَطْب, خَانِق (يتَّسم بحرارة ورطوبة خانقتَين)",
 "じょうしょう": "اِنْتِفَاضَة, تَمَرُّد (معارضة منظمة للسلطة؛ صراع يحاول فيه فصيل انتزاع السيطرة من آخر) / مَنِيع / قِسِّيس, دَاعِيَة (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند…) / إمدادات غذائية, تموين (مخزون أو إمدادات من الأطعمة)",
 "じょうしょうき": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "じょうしょうきりゅう": "تيار صاعد (تيار هوائي صاعد قوي)",
 "じょうしょうげんど": "سَقْف ((سَقَفَ) البيت ونحوه سقفا: عمل له سقفا)\nمثال: نظرت إلى السقف.",
 "じょうしょしょうがい": "اضطراب عاطفي, اضطراب وجداني (أي اضطراب عقلي لا تسببه تشوهات عضوية قابلة للكشف في الدماغ ويكون فيه الاضطراب…)",
 "じょうしん": "جَاضِم / تَقَدُّم",
 "じょうしんこ": "عَالِي الجَوْدَة, مُمْتَاز (يتفوق في الجودة)",
 "じょうしんしょ": "تقرير, تقرير مكتوب (وثيقة مكتوبة تصف نتائج فرد أو مجموعة ما)\nمثال: هذا يتفق مع الدراسة الحديثة التي أجراها هيل وديل",
 "じょうじ": "عَادَةً, الاَكْثِرْ / مُتَوَاصِل, مُتَّصِل / عَلَاقَة غَرَامِيَّة",
 "じょうじこよう": "بَدَوَام كَامِل (لعدد الساعات القياسي)\nمثال: تعمل بدوام كامل",
 "じょうじせい": "بارامغناطيسية, مغناطيسية مسايرة (مواد مثل الألومنيوم أو البلاتين تصبح ممغنطة في مجال مغناطيسي لكنها تختفي عند…)",
 "じょうじせいたい": "مغناطيس مساير (مغناطيس مصنوع من مادة تتناسب مغنطتها مع قوة المجال المغناطيسي المطبق عليها)",
 "じょうじつ": "تمييز, محاباة (المعاملة غير العادلة لشخص أو مجموعة على أساس التحيز) / إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله…)",
 "じょうじゅ": "إشباع, تحقيق (فعل إتمام شيء ما (كرغبة أو وعد))",
 "じょうじゅう": "مُسْتَعْمَرَة, مُسْتَوْطَنَة / دَائِمًا, أَبَدًا / اسْتِقْرَار, ثَبَات (صفة الديمومة والخلو من التغيير أو التباين)\nمثال: اعتمد البحارة الأوائل على ثبات الرياح التجارية",
 "じょうじゅうざが": "أبداً",
 "じょうじゅうふだん": "دَائِم, لَا يَنْقَطِع (غَيْرُ مُنْقَطِعٍ فِي الزَّمَنِ وَمُسْتَمِرٌّ إِلَى أَجَلٍ غَيْرِ مُسَمًّى)",
 "じょうじゅうふめつ": "أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى)",
 "じょうじゅつ": "الْمَذْكُورُ آنِفًا, السًّابِقُ ذِكْرُهُ",
 "じょうじょ": "قِسِّيس, دَاعِيَة (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند…)",
 "じょうじょう": "إدراج, سرد (فعل عمل قائمة بالعناصر) / أَدَاء / مُمْتَاز, فَاخِر / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "じょうじょうとうしん": "صندوق متداول في البورصة (صندوق استثمار مشترك يتم تداوله في سوق الأوراق المالية)",
 "じょうじる": "اِسْتَغَلَّ / ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "じょうじん": "عَاشِق, عَاشِقَة / عَادِيّ, غَيْر مُمَيَّز (ليس مميزاً بأي شكل؛ يفتقر للتميز) / كَابِر / حَم (التنور أو الفرن أو الماء: سجر وسخن وأصبح حارّا؛ الأمر: قُضِيَ وتقدر من الله)\nمثال: أفضل لحم البقر.",
 "じょうすい": "إمدادات المياه, نظام مياه (منشأة توفر مصدراً للمياه)\nمثال: ناقشت المدينة تنقية إمدادات المياه",
 "じょうすいき": "مرشح مياه (مرشح لإزالة الشوائب من إمدادات المياه)",
 "じょうすいち": "حَوْض, جَابِيَة (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا.",
 "じょうすいどう": "كُلْوَة, كُلْيَة",
 "じょうすう": "مَضْرُوب فِيه, مُعَامِل ضَرْب (العدد الذي يضرب به المضروب) / نِصَاب / ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة. / لَفْظِيّ, حَرْفِيّ / قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب.",
 "じょうず": "مَاهِر, حَاذِق / تملق, نفاق (ثناء مفرط أو غير صادق)",
 "じょうずもの": "مُتَمَلِّق, مُداهِن (شخص يستخدم الإطراء والتملق)",
 "じょうずる": "اِسْتَغَلَّ / ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "じょうせい": "حالة, ظرف (الحالة العامة للأشياء؛ مجموعة الظروف في وقت معين)\nمثال: الوضع الدولي الحالي خطير / تخمير (إنتاج المشروبات الشعيرية (مثل البيرة) من الشعير والجنجل عن طريق طحنها وغليها…) / إحداث, تسبيب (فعل التسبب في حدوث شيء ما) / تَارِيخ قَدِيم (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟ / رَائِق, طَافٍ ((للسوائل) يطفو على السطح فوق الراسب أو الرُّسابة)",
 "じょうせいけつじょ": "تَبَلُّد شُعُورِيّ, غِلْظَة (الخلو من العاطفة أو الشعور؛ قسوة القلب)",
 "じょうせいご": "تَكْرَارِيّ (يتسم بالتكرار المتتابع)",
 "じょうせいちょうさ": "اِسْتِبَانَة, اِسْتِطْلَاع",
 "じょうせき": "أقدمية, طول العمر (خاصية العيش طويلاً) / مُنْتَج / صِيغَة",
 "じょうせつ": "مَنْزِلَة, مَكَانَة",
 "じょうせつかん": "دار عرض سينمائي, سينما (مسرح تُعرض فيه الأفلام)",
 "じょうせん": "صَعِدَ / سَفِينَة, سَفينة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة. / تخطيط شريطي, تريط (شريط أو أشرطة ذات لون مغاير)\nمثال: تظهر الكروموسومات شرائط مميزة / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / عَلَاقَات عَامَّة / دِعَايَة, بْرُوبَاغَنْدَا",
 "じょうせんしゃ": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "じょうせんしょくたい": "كْرُومُوسُوم جَسَدِيّ (أي كروموسوم ليس كروموسوماً جنسياً؛ تظهر في أزواج في خلايا الجسم ولكن…)",
 "じょうぜつ": "ثرثرة (صفة الإطناب وكثرة الكلام)",
 "じょうぜつか": "ثَرْثَار",
 "じょうそ": "اِلْتِمَاس, اِسْتِئْنَاف",
 "じょうそう": "تحسس, حساسية ((علم وظائف الأعضاء) الاستجابة للمحفزات الخارجية؛ ملكة الإحساس)\nمثال: حساسية للألم",
 "じょうそううん": "عَالِي الارْتِفَاع (يحدث عند ارتفاع عالٍ نسبيّاً أو منه)",
 "じょうそうかいきゅう": "الطَّبَقَة الْعُلْيَا",
 "じょうそうけんちく": "بنية فوقية (هيكل يتكون من جزء السفينة الموجود فوق السطح الرئيسي)",
 "じょうそうご": "لغة فوقية (لغة شعب غازٍ لاحق تُفرض على السكان الأصليين وتساهم بخصائص في لغتهم)",
 "じょうそうど": "تربة سطحية (طبقة التربة الموجودة على السطح)",
 "じょうそうぶ": "القيادة العليا, كبار المسؤولين (أهم الأشخاص في هيئة حاكمة)",
 "じょうぞう": "تخمير (إنتاج المشروبات الشعيرية (مثل البيرة) من الشعير والجنجل عن طريق طحنها وغليها…)",
 "じょうぞうか": "صاحب مصنع بيرة (المالك أو المدير لمصنع بيرة)",
 "じょうぞうがく": "علم التخمير (فرع الكيمياء المعني بالتخمير (كما في صناعة النبيذ أو التخمير أو التقطير))",
 "じょうぞうしゅ": "مشروب مخمر (مشروب مصنوع عن طريق النقع والغلي والتخمير بدلاً من التقطير)",
 "じょうぞうしょ": "مَصْنَع جِعَة (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "じょうぞうじょ": "مَصْنَع جِعَة (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "じょうた": "إفراط, فرط (كمية تزيد عما هو مناسب)\nمثال: الأطفال في سن الرابعة لديهم فرط في الطاقة",
 "じょうたい": "فَخِذ, فَخْذ / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "じょうたいおこし": "تمرين الجلوس من الرقود (تمرين للبطن يجلس فيه الشخص من وضع الاستلقاء دون استخدام الذراعين للرافعة)",
 "じょうたいか": "تطبيع, تقييس (فرض المعايير أو اللوائح)",
 "じょうたいせんい": "تحول الطور, تغير الطور (تغير من حالة (صلبة أو سائلة أو غازية) إلى أخرى دون تغيير في التركيب الكيميائي)",
 "じょうたいへんか": "تحول الطور, تغير الطور (تغير من حالة (صلبة أو سائلة أو غازية) إلى أخرى دون تغيير في التركيب الكيميائي) / تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "じょうたつ": "تَحْسِين\nمثال: 君の英語は上達している。 — إنجليزيتك تتحسن.",
 "じょうたま": "جَمَال, زَيْن",
 "じょうたん": "قِمَّة",
 "じょうだい": "سعر التجزئة (السعر الإجمالي المفروض على منتج يُباع للعميل، ويشمل تكلفة المصنع بالإضافة إلى…) / حاجب, رئيس التشريفات (ضابط يدير منزل ملك أو نبيل)",
 "じょうだいじょうみゃく": "وريد أجوف علوي (يتلقى الدم من الرأس والذراعين والصدر ويصب في الأذين الأيمن للقلب؛ يتكون من…)",
 "じょうだま": "جَمَال, زَيْن",
 "じょうだん": "سطح علوي (سطح مرتفع) / منبر, منصة الخطابة (منصة مرتفعة عن المستوى المحيط لإبراز الشخص الموجود عليها) / طُرْفَة, نُكْتَة",
 "じょうだんぐち": "طُرْفَة, نُكْتَة",
 "じょうだんぬきで": "بِجِدِّيَّة, بجد",
 "じょうだんめかして": "على سبيل المزاح, مازحاً (ليس بجدية)\nمثال: قصدت ذلك مازحاً (يفيد الاستعلاء؛ يفيد التعليل)",
 "じょうち": "دَائِم",
 "じょうちいいんかい": "لجنة دائمة (لجنة دائمة)",
 "じょうちゃん": "صبية, فتاة (فتاة أو شابة غير متزوجة)",
 "じょうちゅう": "سَاكِن, سَاكِنَة / حقن وريدي (حقنة في الوريد) / دودة شريطية (ديدان مفلطحة تشبه الشريط تتطفل في أمعاء البشر والفقاريات الأخرى)",
 "じょうちゅうるい": "دودة شريطية (ديدان مفلطحة تشبه الشريط تتطفل في أمعاء البشر والفقاريات الأخرى)",
 "じょうちょ": "عَاطِفَة, عَوَاطِف / جَو, غِلَاف جَوِّيّ",
 "じょうちょう": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر)\nمثال: ضابط كبير / إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي) / تكرار زائد, حشو (تكرار فعل ما بلا حاجة)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة / جَو, غِلَاف جَوِّيّ",
 "じょうちょうか": "استنساخ, مضاعفة (فعل نسخ أو عمل نسخة (أو نسخ) من شيء ما)\nمثال: هذا النوع من الازدواجية هو هدر",
 "じょうちょうかんまくどうみゃくへいさしょう": "شريان مساريقي علوي (ينشأ من الجزء العلوي للأبهر ويغذي الأمعاء الدقيقة والأعور والقولون)",
 "じょうちょうけんさ": "فحص التكافؤ (نظام للتحقق من الأخطاء في عمل الكمبيوتر)",
 "じょうちょうせい": "تكرار زائد, حشو (تكرار فعل ما بلا حاجة)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة",
 "じょうちょうど": "تكرار زائد, حشو (تكرار فعل ما بلا حاجة)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة",
 "じょうちょうりょう": "تكرار زائد, حشو (تكرار فعل ما بلا حاجة)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة",
 "じょうちょしょうがい": "اضطراب عاطفي, اضطراب وجداني (أي اضطراب عقلي لا تسببه تشوهات عضوية قابلة للكشف في الدماغ ويكون فيه الاضطراب…)",
 "じょうちょてき": "مُثَار عَاطِفِيًّا, مُنْفَعِل ((للأشخاص) متأثر بشكل مفرط بالعاطفة)\nمثال: كان سلوكه عاطفياً للغاية",
 "じょうて": "مَاهِر, حَاذِق / تملق, نفاق (ثناء مفرط أو غير صادق)",
 "じょうてい": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب. / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى…)\nمثال: قدم عمي لرؤيتي.",
 "じょうてん": "سَمَاء, سما / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب. / صُعُود, اِرْتِقَاء",
 "じょうと": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "じょうとう": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / يقرب / عُرْفِيّ",
 "じょうとうく": "عِبَارَةٌ مُتَدَاوَلَة, كْلِيشِيه (الجملة من الكلام تعبّر عن شيء ما أو تعبّر عمّا في النفس من معان؛ للكلام: المعنى…)\nمثال: ستترجم هذه العبارة.",
 "じょうとうひょうげん": "عبارة مبتذلة, قول مأثور مبتذل (ملاحظة مبتذلة أو واضحة بشكل مفرط)",
 "じょうとうひん": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "じょうとうへい": "عريف رمح, وكيل عريف (جندي في سلاح مشاة البحرية رتبته أعلى من جندي درجة أولى وأقل من عريف)",
 "じょうとうへいそう": "رئيس ضباط الصف (شخص يحمل أعلى رتبة لضابط صف بحري)",
 "じょうとえき": "أرباح رأسمالية, مكاسب رأسمالية (المبلغ الذي يتجاوز به سعر بيع الأصل سعر الشراء؛ يتحقق الربح عند بيع الأصل)",
 "じょうとかのう": "قَابِل لِلتَّحْوِيل, قَابِل لِلتَّدَاوُل (يمكن نقل ملكيته قانونياً إلى شخص آخر)",
 "じょうとくい": "راعي; حامي; وصي; سيد; و",
 "じょうとしょとく": "أرباح رأسمالية, مكاسب رأسمالية (المبلغ الذي يتجاوز به سعر بيع الأصل سعر الشراء؛ يتحقق الربح عند بيع الأصل)",
 "じょうとたんぽ": "رَهْن, رَهْن عَقَارِيّ ((رَهَنَ) الشيءُ يَرْهَنُ رهْنًا، ورُهُونا: ثَبَت ودامَ؛ يقال (رَهَنَ) بالمكان:…)\nمثال: رهن فاضل الحلي.",
 "じょうとにん": "ناقل الملكية ((قانون) شخص ينقل سند ملكية أو ممتلكات إلى آخر)",
 "じょうとふのう": "غَيْر قَابِل لِلتَّحْوِيل (لا يمكن نقله أو تحويله إلى شخص آخر)",
 "じょうど": "جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط)\nمثال: هواوي جنة على الأرض. / تُرْبَة, أَرْض / تربة طفالية, طمي (تربة غنية تتكون من خليط من الرمل والطين والمواد العضوية المتحللة)",
 "じょうどう": "عَاطِفَة, عَوَاطِف",
 "じょうどうきょく": "حركة أبدية (حركة تستمر إلى أجل غير مسمى دون أي مصدر خارجي للطاقة؛ مستحيلة عملياً بسبب…)",
 "じょうない": "باحة, ساحة (الأرض المسيجة المحيطة بمنزل أو مبنى آخر)\nمثال: كان منزلاً صغيراً بلا فناء تقريباً",
 "じょうないほうそう": "مكبرات صوت عامة, نظام مخاطبة الجمهور (نظام تضخيم إلكتروني يستخدم كنظام اتصال في الأماكن العامة)",
 "じょうなまがし": "مُرْتَفِع الدَّرَجَة",
 "じょうにあつい": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة.",
 "じょうにもろい": "مُعَرَّض",
 "じょうにん": "مَنْزِلَة, مَكَانَة / عَاشِق, عَاشِقَة",
 "じょうにんいいんかい": "لجنة دائمة (لجنة دائمة)",
 "じょうにんりじ": "مدير تنفيذي, مسؤول تنفيذي (شخص مسؤول عن إدارة عمل تجاري)",
 "じょうねつ": "عَاطِفَة, شَغْف\nمثال: قبل توم ماري بشغف. / بشكل حار جداً, بغلليان ((تستخدم للحرارة) للغاية)\nمثال: كان الطبق ساخناً جداً / حَارّ رَطْب, خَانِق (يتَّسم بحرارة ورطوبة خانقتَين)",
 "じょうねつてき": "شَغُوف, مُتَحَمِّس",
 "じょうねん": "عَاطِفَة",
 "じょうのう": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن. / ضريبة الأراضي, ضريبة الأملاك (ضريبة رأسمالية تفرضها البلديات على الممتلكات؛ وتعتمد على القيمة المقدرة للعقار) / حمضيات (أي من الفواكه العديدة لجنس الحمضيات ذات القشرة السميكة واللب العصيري؛ تزرع في…)",
 "じょうのふかい": "حَنُون بِالفِطْرَة, طَيِّب القَلْب (ذو طبع فطري طيّب وحنون)",
 "じょうは": "إنتاج النفط, تنقيب (فعل حفر ثقب في الأرض على أمل إنتاج البترول)",
 "じょうはく": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة) / عَضُد (مُعِين؛ قُوَّة) / مُبْتَهِج, مُتَفَائِل بِسَذَاجَة (متفائل بشكل لطيف وربما غير واقعي)\nمثال: كانت المدينة أخيراً في حالة تحسن (رفاهية) بعد مشاكلنا الأخيرة",
 "じょうはくとう": "سكر ناعم الحبيبات (سكر ناعم الحبيبات جداً كان يرش قديماً من وعاء خاص)",
 "じょうはつ": "تتجفاف, تجفيف (عملية استخلاص الرطوبة) / اِخْتِفَاء",
 "じょうはつがん": "متبخرات (الراسب المتبقي بعد تبخر مياه البحر)",
 "じょうはり": "عَنِيد",
 "じょうはん": "شوط أول (الأول من شوطين للعب)",
 "じょうば": "ركوب الخيل (السفر محمولاً على ظهر الخيل) / رَكِبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا…)\nمثال: ركب ياني سفينة.",
 "じょうばぐつ": "حذاء ركوب الخيل (حذاء بدون أربطة يرتدى لركوب الخيل؛ جزء من زي الركوب)",
 "じょうばこ": "حافظة رسائل (حافظة لحمل الرسائل)",
 "じょうばたい": "مَوْكِب خَيَّالَة (موكب من الناس يسافرون على ظهور الخيل)",
 "じょうばふく": "بدلة ركوب الخيل (الملابس التي يرتديها عادة راكب الخيل (وخاصة زي المرأة))",
 "じょうばり": "عَنِيد",
 "じょうばん": "حَارِس",
 "じょうばズボン": "بنطال ركوب الخيل, جودبور ((تستخدم بصيغة الجمع) سراويل واسعة تنتهي عند الساق؛ تلبس مع أحذية الركوب)",
 "じょうひ": "نَسِيج طِلَائِيّ",
 "じょうひさいぼう": "خلية طلائية, خلية ظهارية (واحدة من الخلايا المتراصة التي تشكل النسيج الطلائي)",
 "じょうひそしき": "ظهارة, نسيج طلائي (نسيج غشائي يغطي الأعضاء الداخلية والأسطح الداخلية الأخرى للجسم)",
 "じょうひん": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة. / رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "じょうび": "مَنْزِلَة, مَكَانَة",
 "じょうびきん": "حساب احتياطي, صندوق احتياطي (أموال مقتطعة من الأرباح لتوفير المدفوعات المستقبلية المتوقعة)",
 "じょうびぐん": "جيش نظامي (جيش دائم من الجنود مدفوعي الأجر)",
 "じょうびけし": "إِطْفَائِيّ",
 "じょうふ": "عَاشِق, عَاشِقَة / بَطَل, بَطَلَة / مَدِينَة, قَرْيَة",
 "じょうふくぶ": "شرسوف, منطقة فوق المعدة (المنطقة الواقعة على أو فوق المعدة (أسفل عظم القص مباشرة))",
 "じょうふくぶあっぱくほう": "ضَغْطَات البَطْن, مُناوَرَة هَيْمْلِيك",
 "じょうぶ": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)\nمثال: هناك ثقوب على السطح. / صَحِيح, سَلِيم\nمثال: لازمك تعمل حجر صحي.",
 "じょうぶく": "رُقْيَة",
 "じょうぶくろ": "مُغَلَّف, لِفَافَة",
 "じょうぶこうぞう": "بنية فوقية (هيكل يتكون من جزء السفينة الموجود فوق السطح الرئيسي)",
 "じょうぶじまく": "ترجمة علوية (ترجمة كلمات أوبرا أجنبية (أو عمل كورالي) تُعرض على شاشة فوق المسرح)",
 "じょうぶつ": "تكرار زائد, حشو (تكرار فعل ما بلا حاجة)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة / مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود)\nمثال: رجل يحتضر",
 "じょうぶん": "تخلٍّ, تنازل (فعل التنازل؛ التضحية أو التخلي عن (ممتلكات أو حق أو لقب أو امتياز، إلخ)) / تكرار زائد, حشو (تكرار فعل ما بلا حاجة)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة / رِسَالَة, مِيسِيج",
 "じょうぶんすう": "كَسْر حَقِيقِيّ (كسر يكون بسطه أصغر من مقامه)",
 "じょうへいそう": "مَخْزَن الْحُبُوب, شُونَة",
 "じょうへき": "مِتْرَاس",
 "じょうへん": "أعلى, قمة (الجانب الأعلى أو الأرفع لأي شيء)\nمثال: ضع كتبك على سطح المكتب / شَرِيط\nمثال: إرسم خط مستقيم.",
 "じょうべい": "خُبْز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو…)\nمثال: هذا الخبز لذيذ.",
 "じょうべき": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة.",
 "じょうほ": "امتياز (عقد يمنح الحق في تشغيل عمل فرعي)\nمثال: حصل على امتياز البيرة في ملعب الكرة / مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص))\nمثال: مشى ياني مع سكورا.",
 "じょうほう": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / مَعْلُومَات, مَعْلُومَة\nمثال: この情報は正しいか。 — هل هذه المعلومة صحيحة؟ / مَعْلُومَات, مَعْلُومَة / مَعْلُومَاتِيَّة",
 "じょうほうか": "حوسبة (التحكم في العمليات بواسطة الحاسوب)",
 "じょうほうかがく": "علم المعلومات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "じょうほうがく": "مَعْلُومَاتِيَّة",
 "じょうほうきかん": "وَكَالَةْ اِسْتِخْبَار",
 "じょうほうきき": "نظام المعلومات (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "じょうほうきょく": "وَكَالَةْ اِسْتِخْبَار",
 "じょうほうぎじゅつ": "تِقْنِيَّة مَعْلُومَات, تِكْنُولُوجِيَا مَعْلُومَات",
 "じょうほうこうかんようアメリカひょうじゅんコード": "أسكي, الشيفرة المعيارية الأمريكية لتبادل المعلومات ((علم الحاسوب) شيفرة لتبادل المعلومات بين الحواسيب المصنوعة من قبل شركات مختلفة…)",
 "じょうほうこうがく": "عِلْم الْحَاسُوب, حَاسُوبِيَّات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "じょうほうしゅうしゅう": "جمع المعلومات (فعل جمع المعلومات)",
 "じょうほうしょうこう": "ضَابِطُ اِسْتِخْبَارَات",
 "じょうほうしょり": "مُعَالَجَة البَيَانَات",
 "じょうほうしょりぎじゅつしゃ": "علم المعلومات, معلوماتية (العلوم المعنية بجمع ومعالجة وتخزين واسترجاع وتصنيف المعلومات المسجلة)",
 "じょうほうしょりしんこうじぎょうきょうかい": "أصد ((أَصَّدَ) الثَّوْب: جعله أُصدة؛ (أَصَّدَ) الْجَارِيَة وَنَحْوهَا: ألبسها الأصدة)",
 "じょうほうしょりしんりがく": "علم المعلومات, معلوماتية (العلوم المعنية بجمع ومعالجة وتخزين واسترجاع وتصنيف المعلومات المسجلة)",
 "じょうほうしょりそうち": "علم المعلومات, معلوماتية (العلوم المعنية بجمع ومعالجة وتخزين واسترجاع وتصنيف المعلومات المسجلة)",
 "じょうほうじだい": "عصر المعلومات (فترة بدأت في الربع الأخير من القرن العشرين عندما أصبحت المعلومات متاحة بسهولة…)",
 "じょうほうすじ": "مَصْدَر, مَصَادِر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "じょうほうせん": "حَرْب مَعْلُومَات (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "じょうほうせんそう": "حَرْب مَعْلُومَات (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "じょうほうせんでん": "عَلَاقَات عَامَّة",
 "じょうほうそうさ": "رَدَنَ, غَزَلَ (رَدَنَ رَدْنًا: غزل الرَّدَن أو غزل بالمِردَن؛ ويقال: رَدَنَ الثوبَ: نسجه…)",
 "じょうほうつう": "مُطَّلِع",
 "じょうほうつうしん": "اتصالات سلكية ولاسلكية (فرع الهندسة الكهربائية المعني بتكنولوجيا الاتصالات الإلكترونية عن بعد)",
 "じょうほうていきょうしゃ": "مُخْبِر, مُخْبِرة",
 "じょうほうほご": "أمن المعلومات (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن.",
 "じょうほうりょう": "مباغتة, مفاجأة (فعل مفاجأة شخص ما)",
 "じょうほうりょうがおおい": "إِخْبَارِيّ, إِعْلَامِيّ",
 "じょうほうりょうのおおい": "إِخْبَارِيّ, إِعْلَامِيّ",
 "じょうほうりろん": "نظريَة المعلومات (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير…)\nمثال: إنها مجرد نظرية.",
 "じょうほうシステム": "نظام المعلومات (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "じょうほうシステムがく": "نظام المعلومات (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "じょうほうスーパーハイウェイ": "الطريق السريع للمعلومات (شبكة إلكترونية واسعة (مثل الإنترنت) تستخدم للنقل السريع للصوت والفيديو…)",
 "じょうほうセキュリティ": "أمن المعلومات (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن.",
 "じょうほうチャネル": "خط اتصال, قناة اتصال ((غالباً الجمع) وسيلة للاتصال أو الوصول)\nمثال: يجب أن تمر عبر القنوات الرسمية",
 "じょうほうテクノロジー": "تِقْنِيَّة مَعْلُومَات, تِكْنُولُوجِيَا مَعْلُومَات",
 "じょうほうハイウェイ": "الطريق السريع للمعلومات (شبكة إلكترونية واسعة (مثل الإنترنت) تستخدم للنقل السريع للصوت والفيديو…)",
 "じょうぼ": "خَمِيرَة / حَمَاة",
 "じょうぼく": "مِعْيَارِيّ / نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل. / سقفية, ظلة (غطاء (عادة من القماش) يعمل كسقف لحماية منطقة ما من الطقس)",
 "じょうまい": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "じょうまえ": "قُفْل (أَغْلَقَ أو سَدَّ البابَ أو الشَّيْءَ؛ في بعض السياقات: عادَ أو رجَعَ إلى مكانه…)\nمثال: يحاول توم كسر القفل.",
 "じょうまえや": "قَفَّال, قَفَّالَة",
 "じょうまん": "إطناب, حشو (أسلوب تعبيري يستخدم كلمات مفرطة أو فارغة)",
 "じょうみ": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "じょうみゃく": "وَرِيد, عِرْق",
 "じょうみゃくあつ": "ضغط وريدي (الضغط الممارس على جدران الأوردة بواسطة الدم الدائر)",
 "じょうみゃくえん": "التهاب الوريد (التهاب الوريد (عادة في الساقين))",
 "じょうみゃくけっせんしょう": "تخثر وريدي (تخثر الوريد دون التهاب سابق للوريد؛ يرتبط ببطء تدفق الدم (كما في الراحة الطويلة…)",
 "じょうみゃくけつ": "دم وريدي (الدم الموجود في الأوردة)\nمثال: باستثناء الوريد الرئوي، يكون الدم الوريدي غنياً بثاني أكسيد الكربون وفقيراً بالأكسجين",
 "じょうみゃくせんし": "بزل الوريد, فصد ((طب) ثقب الوريد عبر الجلد لسحب الدم للتحليل أو لبدء تقطير وريدي أو لحقن الدواء)",
 "じょうみゃくちゅうしゃ": "حقن وريدي (حقنة في الوريد)",
 "じょうみゃくどう": "جيب وريدي (قناة واسعة تحتوي على الدم؛ ليس لها غطاء مثل الأوعية الدموية العادية)",
 "じょうみゃくない": "داخل الوريد, وريدي (داخل الوريد أو عن طريقه)\nمثال: التهاب وريدي",
 "じょうみゃくますいやく": "مخدر وريدي (مخدر ينتج التخدير عند حقنه في الدورة الدموية)",
 "じょうみゃくりゅう": "دوالي (وعاء دموي أو وعاء لمفاوي متضخم أو ملتوي بشكل غير طبيعي)",
 "じょうみん": "الْجَمَاهِير, العَامَّةُ / نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه.",
 "じょうむ": "مدير (شخص يتحكم في الموارد والنفقات)",
 "じょうむいん": "عضو طاقم (عضو في طاقم عمل)",
 "じょうむとりしまりやく": "مدير (شخص يتحكم في الموارد والنفقات)",
 "じょうめん": "قِمَّة",
 "じょうもく": "مَقَال, مَقَالَة\nمثال: لا أحب مادة العلوم. / فوق رتبة ((في الأحياء) مجموعة تصنيفية تقع فوق الرتبة وتحت الطائفة أو الطويئفة)",
 "じょうもん": "فوق شعبة ((في الأحياء) مجموعة تصنيفية تقع بين الشعبة وتحت الطائفة أو الطويئفة)",
 "じょうやく": "مُعَاهَدَة, مُقَاوَلَة (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو…)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "じょうやくかめいこく": "مُوقّع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "じょうやくこう": "ميناء معاهدة (ميناء في الصين أو كوريا أو اليابان كان مفتوحًا للتجارة الخارجية بموجب معاهدة…)",
 "じょうやとい": "بَدَوَام كَامِل (لعدد الساعات القياسي)\nمثال: تعمل بدوام كامل",
 "じょうやど": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "じょうよ": "فَائِض / بَقِيَّة / حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "じょうようしゃ": "سَيَّارَة, عَرَبِيَّة (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة. / مُدْمِن, مُدْمِنَة",
 "じょうようじどうしゃ": "أوتوبيس, باص (مركبة تحمل العديد من الركاب؛ تستخدم للنقل العام)\nمثال: كان دائماً يركب الحافلة للعمل",
