 "稟請": "عَرِيضَة, طَلَب",
 "稠密": "كَثِيف, غَلِيظ",
 "稠度": "اِتِّسَاق",
 "種": "نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر. / نَوْع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر. / بِذْرَة, زَرِّيعَة / مَنْي / نَسْل, سَلِيل / أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم) / أصل, سلالة (الاشتقاق الوراثي للفرد) / أجرة الكتابة, سعر السطر (معدل الدفع للمواد المكتوبة التي تقاس وفقاً لعدد الأسطر المقدمة) / عَدَد الأَسْطُر (عدد الأسطر في مادة مطبوعة)\nمثال: كل سلالته كانت محاربين / نُطْفَة, حَيَوَان مَنَوِيّ (نُطَفْة:خليّة جنسيّة ذكريّة موجودة في المَنيّ، وهي متعددة الأشكال؛ الجمع: نُطْفَ) / نُطْفَة, مَنْي (نُطَفْة:خليّة جنسيّة ذكريّة موجودة في المَنيّ، وهي متعددة الأشكال؛ الجمع: نُطْفَ) / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية. / اِخْتِلَاف",
 "種々": "مُخْتَلِف, مُتَنَوَّع",
 "種々様々": "مُتَعَدِّد, مُتَنَوِّع",
 "種々雑多": "مُخْتَلِف, مُتَنَوَّع",
 "種が島": "أركيبوز, بندقية القربينة (سلاح ناري قديم ذو ماسورة طويلة)",
 "種なしパン": "خبز الفطير, ماتزو (خبز مسطح هش يؤكل في عيد الفصح اليهودي)",
 "種まき機": "أصيص مزخرف, حوض زرع (وعاء مزخرف للنباتات المنزلية) / صاحب المزرعة (مالك أو مدير لمزرعة كبيرة (خاصة المزارع الاستعمارية أو الاستثمارية)) / غارس (عامل يضع أو يزرع البذور أو الشتلات في الأرض)",
 "種も仕掛けもない": "هُنَاك, يُوجَد",
 "種下ろし": "خِنْزِيرَة / زَرَعَ, بَذَرَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت.",
 "種付": "اقتران, تزاوج (عملية اقتران الذكر والأنثى لأغراض التكاثر)\nمثال: الاقتران العرضي للمراهقين",
 "種付け": "اقتران, تزاوج (عملية اقتران الذكر والأنثى لأغراض التكاثر)\nمثال: الاقتران العرضي للمراهقين",
 "種分化": "انتواع, تكون الأنواع (تطور نوع بيولوجي)",
 "種切れ": "نَفِدَ",
 "種別": "تَصْنِيف",
 "種取り": "إنجاب, تكاثر (النشاط الجنسي للحمل وإنجاب النسل) / تربية (إنتاج الحيوانات أو النباتات عن طريق التزاوج أو التهجين) / مُتَكَاثِر, مُنَسِّل (يُنْتِجُ نَسْلًا أَوْ مُخَصَّص لِإِنْتَاج النَّسْل) / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "種変わり": "رحمي (من أو يتعلق بالرحم)\nمثال: سرطان الرحم / هَجِين",
 "種姓": "وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / مُطَابَقَة / هُوِيَّة / مسقط الرأس, منشأ (المكان الذي نشأ فيه شيء ما أو تمت رعايته في بداية وجوده)\nمثال: مهد الحضارة",
 "種子": "بِذْرَة, زَرِّيعَة / مَنْي",
 "種子島": "أركيبوز, بندقية القربينة (سلاح ناري قديم ذو ماسورة طويلة)",
 "種子植物": "ظاهرة التزاوج, نبات بذري (نبات يتكاثر عن طريق البذور وليس الأبواغ)",
 "種子骨": "رَضَفَة",
 "種実類": "مَخْبُول, مَعْتُوه ((غير رسمي) مصطلحات عامّيّة تصف الاضطراب العقليّ)",
 "種市": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "種床": "مشتل, مهاد البذور (حوض تُزرع فيه الشتلات قبل نقلها)",
 "種形成": "انتواع, تكون الأنواع (تطور نوع بيولوجي)",
 "種播き機": "أصيص مزخرف, حوض زرع (وعاء مزخرف للنباتات المنزلية) / صاحب المزرعة (مالك أو مدير لمزرعة كبيرة (خاصة المزارع الاستعمارية أو الاستثمارية)) / غارس (عامل يضع أو يزرع البذور أو الشتلات في الأرض)",
 "種数": "جِنْس (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا)\nمثال: أنا مثلي الجنس.",
 "種族": "سِبَاق, مُسَابَقَة / عِرْق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق. / نَوْع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر.",
 "種明かし": "تعريض (فعل تعريض شخص ما لتجربة مؤثرة) / ترك في العراء, نبذ (التخلي دون مأوى أو حماية (مثل ترك رضيع في العراء)) / إظهار, كشف (العرض للمشاهدة بطريقة علنية أو عامة) / تعريض (فعل تعريض الفيلم للضوء)\nمثال: نددت بتعريض الأطفال للمواد الإباحية",
 "種本": "كتاب مصادر (مجموعة من الوثائق المهمة تاريخياً منشورة معاً ككتاب)",
 "種村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "種板": "سَلْبِيّ / سَلْبِيّ, سَالِب / مَنْفِيّ / سَالِب / صُورَة سَالِبَة",
 "種枕": "لحيمة, نتوء لحمي (نتوء على نبات أو حيوان مثل داليات الطيور أو نتوء بالقرب من نقير بعض البذور)",
 "種概念": "نَوْع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر.",
 "種油": "زيت السلجم, زيت الكولزا (زيت صالح للأكل أصفر فاتح إلى بني من بذور اللفت يُستخدم أيضاً كمواد تشحيم أو للإضاءة)",
 "種火": "شعلة إرشادية, شعلة دليل (موقد غاز مساعد صغير يوفر لهباً لإشعال موقد غاز أكبر) / مصباح بيان (مؤشر يتكون من ضوء للإشارة إلى ما إذا كانت الطاقة قيد التشغيل أو المحرك قيد التشغيل)",
 "種無し": "خالي من البذور (يفتقر إلى البذور)",
 "種無しパン": "خبز الفطير, ماتزو (خبز مسطح هش يؤكل في عيد الفصح اليهودي)",
 "種牛": "ثَوْر (حُمْرَة الشفق الثائرة فيه؛ الطُحْلُب وما أشبهه فوق الماء. سميّ كذلك لأنه يثور فجأة) / مَرْسُوم\nمثال: حرث ما حرث الثور.",
 "種牡蠣": "بذور المحار (محار صغير خاصة بحجم مناسب للنقل)",
 "種牡馬": "جَوَاد (السَخِيّ والسَخِيَّة؛ الحِصَان)",
 "種物": "بِذْرَة, زَرِّيعَة / مَنْي",
 "種田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "種皮": "غلاف البذرة, قصرة (الطبقة الخارجية الواقية لبذور النباتات الزهرية)",
 "種目": "بَنْد",
 "種種": "مُخْتَلِف, مُتَنَوَّع",
 "種種様様": "مُتَعَدِّد, مُتَنَوِّع",
 "種種雑多": "مُخْتَلِف, مُتَنَوَّع",
 "種芸": "زراعة الأشجار (العناية بالأشجار ورعايتها)",
 "種苗": "شَتْلَة",
 "種菌": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "種衣": "آريل, غلاف البذرة اللحمي (غطاء لحمي وعادة زاهي الألوان لبعض البذور يتطور من ساق البويضة ويغلف البذرة جزئياً أو كلياً)",
 "種豚": "خِنْزِير",
 "種違い": "رحمي (من أو يتعلق بالرحم)\nمثال: سرطان الرحم",
 "種間": "بين الأنواع (ينشأ أو يحدث بين الأنواع المختلفة)\nمثال: هجين بين الأنواع",
 "種雄": "أب, فحل (الوالد الذكر لحيوان، خاصة الحيوانات الأليفة مثل الحصان) / جد, سلف (مؤسس العائلة) / مولاي (لقب مخاطبة كان يستخدم سابقاً لرجل ذي رتبة وسلطة)\nمثال: حافظوا على إيمان أجدادنا",
 "種雄牛": "ثَوْر (حُمْرَة الشفق الثائرة فيه؛ الطُحْلُب وما أشبهه فوق الماء. سميّ كذلك لأنه يثور فجأة) / مَرْسُوم\nمثال: حرث ما حرث الثور.",
