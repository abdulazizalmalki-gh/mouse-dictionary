 "眼窩": "مَدَار (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير) / فَلَك (التَلّ المستدير من الرَمْل حوله فَضَاء؛ المَدَار يسبح فيه الجُرْم السماويّ)\nمثال: انتشرت الشائعة على مدار الدولة.",
 "眼筋": "عضلة العين (واحدة من العضلات الصغيرة للعين التي تعمل على تدوير مقلة العين)",
 "眼精疲労": "إجهاد العين, وهن البصر (تعب في العين ناتج عن العمل القريب لفترات طويلة من قبل شخص يعاني من مشكلة بصرية غير مصححة)",
 "眼角動脈": "الشريان الزاوي (الفرع النهائي للشريان الوجهي)",
 "眼識": "تَفْرِيق / تَمْيِيز",
 "眼路": "ساحة بصرية",
 "眼鏡": "نظارة ((جمع) أداة بصرية تتكون من إطار يحمل زوجاً من العدسات لتصحيح الرؤية المعيبة) / تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين",
 "眼鏡カイマン": "كايمان نظاراتي (كايمان ذو حواف عظمية حول العينين؛ يوجد من جنوب المكسيك إلى الأرجنتين)",
 "眼鏡ケース": "بيت النظارة, حافظة نظارات (حافظة لحمل النظارات)",
 "眼鏡レンチ": "مفتاح حلقي, مفتاح مغلق (مفتاح ربط بحلقة مغلقة (لقمة) تتناسب فوق صامولة أو رأس مسمار)",
 "眼鏡入れ": "بيت النظارة, حافظة نظارات (حافظة لحمل النظارات)",
 "眼鏡屋": "صانع عدسات, فني بصريات (عامل يصنع النظارات لعلاج عيوب الإبصار)",
 "眼鏡店": "صانع عدسات, فني بصريات (عامل يصنع النظارات لعلاج عيوب الإبصار)",
 "眼鏡熊": "دب أبو نظارة",
 "眼鏡猿": "تَارْسِير",
 "眼鏡蛇": "كوبرا هندية (كوبرا من أفريقيا الاستوائية وآسيا)",
 "着": "وُصُول, وِفَادَة / مَلَابِس, ثِيَاب",
 "着々": "بثبات",
 "着く": "بَلَغَ",
 "着ける": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه. / أْثَث ((أَثَّثَ): لين ومهد؛ (أَثَّثَ) البيت: فرشه بالأثاث) / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا. / وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع.",
 "着する": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر. / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "着せる": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / ثَوْب, لِبَاس (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء) / كَسْوَة, مَلْبَس\nمثال: لبس سروالا نظيفا. / غِطَاء / غِلَاف / غَطَّى / دَبُّوس",
 "着た": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "着つける": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "着もじ": "رِسَالَة, رِسَالَة إِس إِم إِس",
 "着る": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا. / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "着る物": "مَلَابِس, ثِيَاب",
 "着メロ": "نَغْمَة الرَنَّة, نَغْمَة رَنِين",
 "着付け": "غِيَار, رِبَاط / مَرَقَة, صَلْصَة (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / دَمَال / تَلَبُّس, تَرَدٍّ / لِبَاس (الزِيّ أو بعض الثياب تُلْبَس مع بعض لا جمع له؛ ما يُلْبَس من الثياب، الجمع ألْبِسَة)\nمثال: أحسن زيري اللباس. / رداء خارجي, ملابس خارجية (رداء يلبس فوق ملابس أخرى)",
 "着付ける": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "着信": "وُصُول, وِفَادَة",
 "着信メロディ": "نَغْمَة الرَنَّة, نَغْمَة رَنِين",
 "着信者": "مُسْتَلِم, مُسْتَلِمَة",
 "着信転送機能": "تحويل المكالمات (يتيح لك تحويل مكالماتك الواردة إلى أي هاتف يمكنك الاتصال به مباشرة)",
 "着信音": "نَغْمَة الرَنَّة, نَغْمَة رَنِين",
 "着倒れ": "استهلاك, صرف (عملية استهلاك شيء ما)",
 "着古し": "بَالٍ",
 "着味": "بَهَار, تَابِل",
 "着圧": "ضغط, كبس (تطبيق الضغط) / ضغط, ضغط البيانات (تشفير المعلومات مع تقليل النطاق الترددي أو البتات المطلوبة) / انضغاط, تقلص (عملية أو نتيجة أن يصبح الشيء أصغر أو مضغوطاً معاً) / تصلب, تكثيف (زيادة في كثافة شيء ما)\nمثال: تقلص الغاز عند التبريد",
 "着地": "هُبُوط / بَسْطَة / رصيف إنزال, مرسى (هيكل يوفر مكاناً يمكن للقوارب فيه إنزال الأشخاص أو البضائع) / وِجْهَة, وُجْهَة / نَتِيجَة",
 "着地点": "رصيف إنزال, مرسى (هيكل يوفر مكاناً يمكن للقوارب فيه إنزال الأشخاص أو البضائع) / أَرْضِيَّة مُشْتَرَكَة (أساس يتفق عليه جميع الأطراف للوصول إلى تفاهم متبادل)",
 "着実": "ثابت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "着席": "جَلَسَ, قَعَدَ (قَعَدَ)",
 "着床": "زرع, غرس (إجراء جراحي يضع شيئاً ما في جسم الإنسان) / غرس (فعل الغرس أو الوضع في الأرض) / انغراس, تعشيش ((علم الأجنة) العملية العضوية التي تنغرس فيها البويضة المخصبة في بطانة الرحم لدى الثدييات المشيمية)\nمثال: زرع كريات مشعة في غدة البروستاتا",
 "着弾": "تأثير, تعدي (التأثير بقوة) / صَدْمَة, صِدَام (التفاعل العنيف بين الأفراد أو الجماعات التي تدخل في القتال) / ارتطام, صدمة (ضرب جسم لآخر) / تأثير, وقع (عاقبة قوية؛ تأثير قوي)\nمثال: استاءوا من طغيان القيم الأمريكية على الثقافة الأوروبية",
 "着弾距離": "مدى, قدرة / مَدَى",
 "着彩": "تلوين, صباغة (عملية تغيير لون شيء ما) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه) / صبغة غذائية, ملون غذائي (مادة قابلة للهضم تستخدم لإعطاء لون للطعام)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء",
 "着御": "وُصُول, وِفَادَة",
 "着想": "حَبَل, حَمْل ((حَبَلَه): شَدّه بالحبْل؛ (حَبَلَه) الصَّيْدَ: نَصَب لَهُ الحِبَالةَ وصاده بهَا. وَيُقَال: حَبَلَت فُلَانَةُ فلَانًا: أوقعَتْه فِي شِباك حُبّها وسحَرته)\nمثال: حبل الكذب قصير.",
 "着意": "حَذَر, حِيطَة (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَذَر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك.",
 "着手": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / لعب (فعل المشاركة في لعبة أو رياضة أو ترفيه آخر) / عزف (فعل العزف على آلة موسيقية) / أداء, تمثيل (أداء دور في عمل درامي)",
 "着払": "الدَّفْع عِنْد الاسْتِلَام (تحصيل الرسوم عند التسليم)\nمثال: أرسل طرداً بالدفع عند الاستلام",
 "着払い": "الدَّفْع عِنْد الاسْتِلَام (تحصيل الرسوم عند التسليم)\nمثال: أرسل طرداً بالدفع عند الاستلام",
 "着替える": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "着替え所": "مَنْزَع / غُرْفَة الْمَلَابِس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "着服": "اِخْتِلَاس (الخَلَسُ: الأخذ نُهْزَةومخاتلة، والاختلاس كالخَلَسِ؛ أخذه خُِلْسَةً أي اختلاسا)\nمثال: لقد اتهم باختلاس الأموال العامة.",
 "着水": "هبوط مائي (هبوط مركبة فضائية في البحر في نهاية رحلة فضائية)",
 "着氷": "تَغْطِيَة سُكَّر (وضع شيء فوق آخر لإخفائه أو حمايته؛ معالجة ونقل أخبار حدث أو موضوع معين ونشره لجمهور أو ما يصطلح عليه بالتغطية الإعلامية)\nمثال: تمت تغطية زيري. / هُبُوط / بَسْطَة",
 "着港": "وُصُول, وِفَادَة",
 "着火": "إشعال, إضرام (عملية إضرام النار في شيء ما) / نظام إشعال (الآلية التي تشعل الوقود في محرك الاحتراق الداخلي) / إشعال, اتقاد (عملية بدء الاحتراق أو اشتعال النار)",
 "着火剤": "مكعب إشعال, ولاعة فحم (قطعة من مادة تحترق بسهولة ويمكن استخدامها لبدء إشعال الفحم أو الكوك)",
 "着火材": "مكعب إشعال, ولاعة فحم (قطعة من مادة تحترق بسهولة ويمكن استخدامها لبدء إشعال الفحم أو الكوك)",
 "着物": "كِيمُونُو / مَلَابِس, ثِيَاب",
 "着物虱": "قملة الجسم (قملة طفيلية تغزو جسم البشر)",
 "着生": "عليقي, نباتي هوائي (من أو يتعلق بالنباتات الهوائية (التي تنمو على نباتات أخرى))",
 "着生植物": "نبات فوقي, نبات هوائي (نبات يستمد الرطوبة والمواد المغذية من الهواء والمطر؛ ينمو عادة على نبات آخر ولكنه لا يتطفل عليه)",
 "着用": "ارتداء, لبس (فعل وضع شيء على الجسم كغطاء أو زينة) / مُتْعِب, مُرْهِق (يُسبّب الإنهاك والإعياء) / تعرية, نحت ((في الجيولوجيا) العملية الميكانيكية لتآكل أو طحن شيء ما (كما يحدث عند غسل الجسيمات له)، وتستخدم مجازياً أيضاً)\nمثال: اشترته للارتداء اليومي",
 "着用品": "أغراض شخصية, متعلقات شخصية (ممتلكات ذات طابع شخصي قابلة للحمل ولا تستخدم في الأعمال التجارية)\nمثال: تركت بعض متعلقاتها الشخصية في المنزل",
 "着用者": "لابِس, مُرتَدٍ (شخص يرتدي أو يحمل أو يعرض شيئاً كغطاء للجسم أو زينة)\nمثال: مرتدي التاج",
 "着目": "اِهْتِمَام, اِنْتِبَاه",
 "着眼": "مراعٍ, منتبه (يأخذ الحذر؛ يعطي اهتماماً وثيقاً وعميقاً) / اكتراث, اهتمام (إيلاء اهتمام خاص (كما هو الحال مع الأطفال أو العاجزين))\nمثال: منتبه للتحذيرات / رَصْد, مُشَاهَدَة (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس)",
 "着眼点": "وِجْهَة نَظَر, حَيْثِيَّة / وِجْهَة نَظَر",
 "着着": "بثبات",
 "着磁": "مَغْنَطَة",
 "着脱可能": "قَابِلٌ لِلطَّمْس (يمكن محوه أو إزالته بالكامل) / قابل للإزالة, قابل للعزل (يمكن إزالته أو أخذه بعيداً أو صرفه)\nمثال: سلك قابل للفك",
 "着脱式": "قَابِل لِلْفَصْل, قَابِل لِلْفَكّ (مصمم ليتم فكه أو فصله دون ضرر)\nمثال: قمصان بياقات قابلة للفصل",
 "着色": "تلوين, صباغة (عملية تغيير لون شيء ما) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه) / صبغة غذائية, ملون غذائي (مادة قابلة للهضم تستخدم لإعطاء لون للطعام)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء",
 "着色剤": "تلوين, صباغة (عملية تغيير لون شيء ما) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه) / صبغة غذائية, ملون غذائي (مادة قابلة للهضم تستخدم لإعطاء لون للطعام)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء",
 "着色料": "تلوين, صباغة (عملية تغيير لون شيء ما) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه) / صبغة غذائية, ملون غذائي (مادة قابلة للهضم تستخدم لإعطاء لون للطعام)\nمثال: اللون الأبيض مكون من العديد من الأطوال الموجية المختلفة للضوء",
 "着衣": "مَلَابِس, ثِيَاب",
 "着装": "ارتداء, لبس (فعل وضع شيء على الجسم كغطاء أو زينة) / مُتْعِب, مُرْهِق (يُسبّب الإنهاك والإعياء) / تعرية, نحت ((في الجيولوجيا) العملية الميكانيكية لتآكل أو طحن شيء ما (كما يحدث عند غسل الجسيمات له)، وتستخدم مجازياً أيضاً)\nمثال: اشترته للارتداء اليومي / حقيبة مستندات (حقيبة أوراق مستطيلة وضحلة) / ملحق (متخصص معين ضمن طاقم بعثة دبلوماسية)",
 "着込む": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا. / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "着陸": "هُبُوط / بَسْطَة",
 "着陸復航": "إلغاء الهبوط, تجاوز الهدف (اقتراب يفشل ويفسح المجال لمحاولة أخرى)",
 "着陸復行": "إلغاء الهبوط, تجاوز الهدف (اقتراب يفشل ويفسح المجال لمحاولة أخرى)",
 "着陸船": "مركبة هبوط, مسبار هبوط (مركبة فضائية مصممة للهبوط على القمر أو كوكب آخر)",
 "着陸装置": "عجلات الهبوط, معدات الهبوط (هيكل سفلي يدعم وزن الطائرة عندما تكون على الأرض)",
 "着類": "مَلَابِس, ثِيَاب",
 "睇視": "أَحْوَل, مُحَوِّل (ذو عينين نصف مغلقتين من أجل الرؤية بشكل أفضل)",
 "睡い": "نَعْسَان, نَاعِس",
 "睡らす": "نَوَّمَ, أَنَامَ (بكافة معانيه)\nمثال: لم أستطع النوم. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "睡らせる": "نَوَّمَ, أَنَامَ (بكافة معانيه)\nمثال: لم أستطع النوم. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "睡る": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "睡眠": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة.",
 "睡眠を取る": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة.",
 "睡眠不足": "حرمان من النوم (شكل من أشكال التعذيب النفسي يتم عن طريق حرمان الضحية من النوم)",
 "睡眠剤": "حبة منوم, قرص منوم (دواء منوم على شكل حبة (أو قرص أو كبسولة))",
 "睡眠学習": "تعلم أثناء النوم (التدريس أثناء النوم (مثل استخدام التسجيلات لتعليم لغة أجنبية لشخص نائم))",
 "睡眠時無呼吸症候群": "اِنْقِطَاع النَّفَس أَثْنَاء النَّوْم",
 "睡眠時遊行症": "سير أثناء النوم, مشي نائم (المشي من قبل شخص نائم)",
 "睡眠病": "التهاب الدماغ السباتي, مرض النوم (التهاب دماغ كان وبائياً بين عامي 1915 و1926؛ تشمل الأعراض شلل عضلة العين الخارجية وضعف عضلي شديد)",
 "睡眠発作": "تَغْفِيق",
 "睡眠薬": "مُنَوِّم",
 "睡眠遮断": "حرمان من النوم (شكل من أشكال التعذيب النفسي يتم عن طريق حرمان الضحية من النوم)",
 "睡眠障害": "اضطراب النوم (خلل في نمط النوم الطبيعي)",
 "睡眠麻痺": "شَلَل النَّوْم, جَاثُوم",
 "睡蓮": "زنبق الماء, نيلوفر (نبات مائي من فصيلة النيلوفرية)",
 "睡魔": "نُعَاس, سِنَة / رجل الرمل (قزم في قصص الأطفال ينثر الرمل في عيون الأطفال ليجعلهم ينامون)",
 "督する": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه) / آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة.",
 "督促": "حَثَّ (حثّ الشّخصَ:أعجله ، حثّه على الشّيء:حضّه عليه ، شجّعه؛ حثَّه علَيْه :حَضَّهُ عَلَيْهِ، ونَدَبَه لَهُ وإِليه)\nمثال: بحث عن المفتاح.",
 "督促状": "سند تحت الطلب (سند مستحق الدفع عند الطلب)",
 "督励": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "督責": "شاق, متطلب (يتطلب أكثر مما هو متوقع عادة أو يُعتقد أنه مستحق؛ خاصة صبراً وجهداً ومهارة كبيرة)\nمثال: وجد الوظيفة شاقة جداً",
 "睥睨": "مُبْهِر, وَهَّاج (يَلْمَع بِشِدَّة وقُوَّة) / صَارِخ, فَاضِح (سَيِّئٌ وَمُسْتَنْكَرٌ بِشَكْلٍ صَارِخٍ وَفَاضِحٍ)",
 "睦まじい": "مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً)",
 "睦月": "يَنَايِر, كَانُون اَلثَّانِي (الشهر الأول من السنة الروميّة)\nمثال: لتبدأ الاحتفالات بيناير.",
 "睨み": "وَهَج",
 "睨みをきかす": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / وَهَج",
 "睨みをきかせる": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / وَهَج",
 "睨みを利かす": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / وَهَج",
 "睨みを利かせる": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / وَهَج",
 "睨みを効かす": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / وَهَج",
 "睨みを効かせる": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / وَهَج",
 "睨み合い": "مُوَاجَهَة, مُجَابَهَة",
 "睨み据える": "وَهَج",
 "睨む": "تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء / سَاعَة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن) / حَارِس / رَصَدَ (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس) / حَذِرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: درست لمدة ساعة. / أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "睨めた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "睨んだ": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "睫毛": "رِمْش, هُدْب (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء وعين رمشاء وقد ارمش؛ وبه رمش اي برش:- وارمش الشجر:- اورق كأربش وقال ابن الاعرابي أرمش أخرج ثمره كالحمص، وارض رمشاء: كثيرة العشب كرسماء)",
 "睾丸": "بَيْضَة, خُصْيَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان)\nمثال: هذه بيضة مقلية.",
 "睾丸炎": "التهاب الخصية (التهاب إحدى الخصيتين أو كلتيهما؛ يتميز بالألم والتورم)",
 "瞋恚": "غَضَب / أَغْضَبَ / غَضِبَ",
 "瞑々": "غَامِق, دَاكِن",
 "瞑す": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / اُرْقُد فِي سَلَام, اُرْقُد بِسَلَام",
 "瞑する": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / اُرْقُد فِي سَلَام, اُرْقُد بِسَلَام",
 "瞑る": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "瞑想": "تأمل, مضاربة فكرية (تأمل مستمر وعميق في موضوع أو سلسلة من الموضوعات ذات طبيعة عميقة أو غامضة) / تأمل روحي ((دين) التأمل في الأمور الروحية (عادة في مواضيع دينية أو فلسفية))\nمثال: عادة التأمل هي الأساس لكل معرفة حقيقية",
 "瞑眩": "دُوَار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "瞑瞑": "غَامِق, دَاكِن",
 "瞞着": "خِدَاع, خَدْع",
 "瞞着手段": "حِيلَة",
 "瞟眇": "بِلَا حُدُود, لَامَحْدُود (يَبْدُو بِلَا حُدُودٍ فِي الكَمِّيَّةِ أَوِ العَدَدِ أَوِ الدَّرَجَةِ أَوِ المَدَى) / إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "瞠若": "ذُهُول, دَهْشَة",
 "瞠視症": "تلصص, تلصصية (انحراف يحصل فيه الشخص على إشباع جنسي من رؤية الأعضاء التناسلية للآخرين أو مشاهدة السلوك الجنسي للآخرين)",
 "瞥見": "لمحة, نظرة خاطفة (نظرة سريعة)",
 "瞬き": "رَمَشَ (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء وعين رمشاء وقد ارمش؛ وبه رمش اي برش:- وارمش الشجر:- اورق كأربش وقال ابن الاعرابي أرمش أخرج ثمره كالحمص، وارض رمشاء: كثيرة العشب كرسماء) / رَمْشَة / طرفة عين, لمح البصر (وقت قصير جداً (مثل الوقت الذي تستغرقه العين لتطرف))\nمثال: سأفعل ذلك في لمح البصر",
 "瞬く": "لَأْلَأَ (لَمَعَ، أَشْرَقَ؛ (استخدام مجازي) اغْرَوْرَقَتْ الدُّمُوع) / رَمَشَ (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء وعين رمشاء وقد ارمش؛ وبه رمش اي برش:- وارمش الشجر:- اورق كأربش وقال ابن الاعرابي أرمش أخرج ثمره كالحمص، وارض رمشاء: كثيرة العشب كرسماء) / رَمْشَة",
 "瞬く間": "طرفة عين, لمح البصر (وقت قصير جداً (مثل الوقت الذي تستغرقه العين لتطرف))\nمثال: سأفعل ذلك في لمح البصر",
 "瞬く間に": "حالاً, على الفور (بدون أي تأخير)\nمثال: قُتل على الفور",
 "瞬ぐ": "غَمَزَ / غَمْزَة",
 "瞬刻": "عَزْم / لَحْظَة, دَقِيقَة",
 "瞬時": "لَحْظَة",
 "瞬発": "آنِيّ, لَحْظِيّ (يَحْدُث بِدُون أَيّ تَأْخِير)",
 "瞬目": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة) / عَزْم / لَحْظَة, دَقِيقَة",
 "瞬膜": "جفن ثالث, غشاء راف (طية واقية من الجلد في عيون الزواحف والطيور وبعض الثدييات)",
 "瞬速": "البَرْق",
 "瞬間": "عَزْم / لَحْظَة, دَقِيقَة / عندئذ, في تلك اللحظة (في وقت معين في الماضي)\nمثال: عندئذ انطلق البوق / في أية لحظة, لحظياً (في أي لحظة) / للحظة, مؤقتاً (للحظة أو وهلة)\nمثال: ستكون معك في أية لحظة",
 "瞬間湯沸かし器": "حَادّ المِزَاج, سَرِيع الغَضَب (يُستثار إلى الغضب بسرعة)",
 "瞬間湯沸し器": "حَادّ المِزَاج, سَرِيع الغَضَب (يُستثار إلى الغضب بسرعة)",
 "瞬間的": "خَاطِف, عَابِر (يَدوم لِفَتْرَة قَصيرَة جِدًّا)",
 "瞬間移動": "إِنْتِقَال آنِي",
 "瞭然": "بَدِيهِيّ, بَدَهِيّ",
 "瞳": "تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ",
 "瞳を凝らす": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ فُلاناً: إِذا أَصَابَ حَدَقَتَه؛ حدَق به:أَحَاطَ به من كلّ جهة (حدَقت قوات الأمن بالقرية))\nمثال: حدق الجميع في وجهي.",
 "瞳子": "تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ",
 "瞳孔": "تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ",
 "瞳孔反射": "تقبض الحدقة, منعكس الضوء (انكماش انعكاسي للعضلة العاصرة للقزحية استجابة لضوء ساطع (أو أدوية معينة) مما يسبب صغر حجم الحدقة)",
 "瞳孔括約筋": "عضلة عاصرة, مصرة (حلقة من العضلات تنقبض لإغلاق فتحة)",
 "瞳孔散大": "توسع الحدقة (توسع انعكاسي للحدقة حيث تسحب العضلة القزحية للخارج؛ يحدث استجابة لانخفاض الضوء أو أدوية معينة)",
 "瞳孔縮小": "تقبض الحدقة, منعكس الضوء (انكماش انعكاسي للعضلة العاصرة للقزحية استجابة لضوء ساطع (أو أدوية معينة) مما يسبب صغر حجم الحدقة) / انقسام اختزالي, انقسام منصف ((علم الوراثة) انقسام الخلية الذي ينتج خلايا تناسلية في الكائنات التي تتكاثر جنسيًا؛ تنقسم النواة إلى أربع نوى تحتوي كل منها على نصف عدد الكروموسومات)",
 "瞼": "جَفْن (مَنَعَ نَفْسَهُ عَنْ كُلِّ مَكْرُوهٍ؛ وَضَعَ الطَّعَامَ فِي الجَفْنَةِ)",
 "瞼板": "رُصُغ",
 "瞼板腺": "غدة تارسية, غدة ميبوميان (غدة دهنية طويلة ترطب الجفون)\nمثال: تنتج العدوى البكتيرية لغدة ميبوميان شحاذاً",
 "瞽者": "مَكْفوف",
 "瞿麦": "وَرْدِيّ, زَهْرِيّ (هُو ما كان بِلَوْنِ الورد؛ ٌ إِلَىٰ ٱلْوَرْدِ) / زَهْرِيّ, وَرْدِيّ\nمثال: لا أظن أن توم سيشتري مظلة وردية.",
 "矍鑠": "حَازِم, قَوِيّ (يتّسم بالقوة والحيوية في الفعل أو النشاط) / قَوِيّ, نَشِيط (قوي ونشيط بدنياً أو ذهنياً)",
 "矛": "ذُو مِقْبَض طَوِيل (لَهُ مِقْبَض أَوْ يَد طَويلَة) / سِلَاح, أَسْلِحَة",
 "矛を交える": "عَارَكَ, قَاتَلَ / تَعَارَكَ, تَقَاتَلَ / نَاضَلَ, كَافَحَ / قِتَال (من قَتَلَ: كثير القَتْل) / مَعْرَكَة\nمثال: لن يحل القتال أي شيء.",
 "矛を収める": "دَفَنَ الأَحْقَادَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "矛先": "رأس حربة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ)\nمثال: قطع سامي رأس كلب. / بُؤْرَة / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "矛盾": "تَنَاقُضٌ\nمثال: それは矛盾だらけだ。 — انها مجموعة من التناقضات",
 "矛盾性": "تَنَاقُضٌ",
 "矛盾撞着": "تناقض ذاتي (مناقضة النفس)",
 "矛盾語法": "أوكسيمورون, تضاد ظاهري (الجمع بين مصطلحات متناقضة)",
 "矜恃": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "矜持": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "矠": "رُمح ثلاثي الشعب (رمح ذو ثلاث شوكات أو أكثر؛ يستخدم لصيد الأسماك بالرمح (خاصة السلمون))",
 "矢": "سَهْم, سهم (سَهَمَ؛ سَهَّمَ)\nمثال: لم يصب السهم توم. / إِسْفِين (عبارة عن وَتَد أو قطعة من الخَشَب أو الحَدِيد تستخدم في البِنَاء والنِجَارَة بلإبقاء على فُرْجَة بين الأجسام، خصوصا ألواح الخشب، أو لتكوين هذه الفرجة؛ دَقَّ بينهم إسفينا: فَرَّقَ بينهم) / وَتِد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / وَتَد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها)",
 "矢がら": "سمكة البوق (سمكة استوائية نحيلة ذات خطم أنبوبي طويل وصفائح عظمية بدلاً من القشور)",
 "矢じり": "رأس السهم, نصل (الرأس المدبب أو الطرف الضارب للسهم)",
 "矢の根": "رأس السهم, نصل (الرأس المدبب أو الطرف الضارب للسهم)",
 "矢ノ浦": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "矢井田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "矢代": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "矢住": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "矢作": "قذة",
 "矢倉": "برج حربي, برج مدفع (منصة أسلحة مستقلة تحتوي على مدافع وقابلة للدوران) / برج صغير, بريج (برج صغير يمتد فوق مبنى) / سِقَالَات, سِقَالَة / قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "矢先": "رأس السهم, نصل (الرأس المدبب أو الطرف الضارب للسهم) / جُلّ, مُعْظَم / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "矢先に": "بينما, في الوقت الذي (في نفس الوقت الذي)\nمثال: بينما كان يحتضر، تجادلوا حول تركته",
 "矢刃": "سِلَاح, أَسْلِحَة",
 "矢印": "سَهْم, سهم (سَهَمَ؛ سَهَّمَ)\nمثال: لم يصب السهم توم. / فَائِدَة",
 "矢口": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "矢吹": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اسم مكان (الاسم الذي يُعرف به مكان جغرافي)",
 "矢地": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "矢場": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "矢富": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "矢尻": "رأس السهم, نصل (الرأس المدبب أو الطرف الضارب للسهم)",
 "矢島": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "矢嶋": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "矢幹": "سمكة البوق (سمكة استوائية نحيلة ذات خطم أنبوبي طويل وصفائح عظمية بدلاً من القشور)",
 "矢床": "كَلْبَتَان",
 "矢座": "ساجيتا (أي دودة سهمية من جنس ساجيتا)",
 "矢庭に": "فَوْرًا, حَالًا / فَجْأَةً",
 "矢弾": "ذُخِيرَة",
 "矢板": "خازوق لوحي, ركيزة لوحية (ركيزة في صف من الركائز المدفوعة جنباً إلى جنب لاحتجاز الأرض أو منع التسرب)",
 "矢柄": "سمكة البوق (سمكة استوائية نحيلة ذات خطم أنبوبي طويل وصفائح عظمية بدلاً من القشور)",
 "矢楯": "ترس محمول (مأوى محمول مضاد للرصاص)",
 "矢沢": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "矢状": "سَهْمِيّ (يَقَع فِي مُسْتَوًى مُوَازٍ لِلمُسْتَوَى المَرْكَزِيّ لِلدَّرْز السَّهْمِيّ)",
 "矢状縫合": "درز سهمي (الدرز الذي يوحد العظمين الجداريين)",
 "矢狭間": "فتحة الرمي, مزغل (ثقب صغير في جدار محصن؛ للمراقبة أو إطلاق الأسلحة) / ثغرة (غموض (خاصة في نص قانون أو عقد) يجعل من الممكن التهرب من صعوبة أو التزام)",
 "矢玉": "ذُخِيرَة",
 "矢田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "矢盾": "ترس محمول (مأوى محمول مضاد للرصاص)",
 "矢矧": "قذة",
 "矢石": "سَاحَة حَرْب, سَاحَة مَعْرَكَة / بيلمنيت (أحفورة جيرية مخروطية مدببة من طرف ولها تجويف مخروطي في الطرف الآخر، تعود لرخويات منقرضة)",
 "矢立": "جَعْبَة",
 "矢立て": "جَعْبَة",
 "矢筈模様": "تعشيق مائل, نمط عظم السمكة (نمط من أعمدة خطوط متوازية قصيرة تميل جميع خطوط العمود الواحد في اتجاه واحد وتميل خطوط الأعمدة المجاورة في الاتجاه الآخر؛ يستخدم في النسيج والبناء…)",
 "矢筈豌豆": "وَزْن فَارِغ",
 "矢筒": "جَعْبَة",
 "矢細工": "قذة",
 "矢継ぎ早": "بسرعة فائقة, في لمح البصر (في وقت قصير نسبياً)",
 "矢藤": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "矢表": "الطليعة, خط المواجهة (المجموعة الأكثر تقدماً ومسؤولية في نشاط ما) / خط النار (الخط الذي يطلق منه الجنود النار)\nمثال: خط المواجهة هو مكان الحدث / أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا",
 "矢貫": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "矢車菊": "قنطريون عنبري, ورد الذرة (نبات أوراسي حولي يُزرع في أمريكا الشمالية له رؤوس مبهرجة من الزهور الزرقاء أو الأرجوانية أو الوردية أو البيضاء) / أوفولاريا كبيرة الأزهار, زهرة القش (نبات من جنوب وجنوب شرق الولايات المتحدة يزرع لزهوره الصفراء التي يمكن تجفيفها)",
 "矢追": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "矢部": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "矢郷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "矢野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "矢間": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "矢面": "الطليعة, خط المواجهة (المجموعة الأكثر تقدماً ومسؤولية في نشاط ما) / خط النار (الخط الذي يطلق منه الجنود النار)\nمثال: خط المواجهة هو مكان الحدث / أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا",
 "矢面に立つ": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "矢頭": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "矢鱈": "عَشْوَائِيّ",
 "知": "حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت.",
 "知ったかぶり屋": "مُتَعَالِم",
 "知ってのとおり": "كَمَا تَعْلَمُ",
 "知っての通り": "كَمَا تَعْلَمُ",
 "知は力なり": "اَلْمَعْرِفَة قُوَّة",
 "知らす": "أَخْبَرَ, أَبْلَغَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه. / عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء) / دَرَى, عَرَفَ (عَلِمَ وعَرَفَ)\nمثال: أدرس علم النفس. / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "知らず": "بصرف النظر, جانباً (غير مأخوذ في الاعتبار أو مستبعد) / ادِّخَارًا, جَانِبًا (في الاحتياط؛ ليس للاستخدام الفوري) / جَانِبًا (على أو إلى جانب واحد) / بَعِيدًا, جَانِبًا (بعيداً عن الطريق (خاصة بعيداً عن أفكار المرء))\nمثال: بصرف النظر عن هذه المشاكل، البلاد تبلي بلاءً حسناً / أَنَا أَعْرِفُ",
 "知らず知らず": "لَاشُعُورِيًّا",
 "知らせ": "أَخْبَار, أَنْبَاء (أنباء ما قد حدث؛ نشرة الأخبار أو عرض الأخبار: ما يعرضه التلفاز أو الراديو من أخبار سياسة واقتصادية ورياضية تهم عامة الناس)\nمثال: هذه أخبار طيبة. / فَأل, نَذِيْر",
 "知らせる": "أَخْبَرَ, أَبْلَغَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه.",
 "知らない": "مَجْهُول, مُبْهَم / مُتَغَيِّر / غَامِض, غَوَامِض / لَا يَهُمُّنِي (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "知らぬが仏": "الْجَهْل نَعِيمَهُ, الْجَهْل نِعْمَة",
 "知らぬ顔": "تَجَاهَلَ, طَنَّش / لَامُبَالَاة",
 "知られざる": "مَجْهُول, مُبْهَم / مُتَغَيِّر / غَامِض, غَوَامِض",
 "知らん顔": "تَجَاهَلَ, طَنَّش / لَامُبَالَاة",
 "知り人": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "知り合い": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "知る": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء) / دَرَى, عَرَفَ (عَلِمَ وعَرَفَ)\nمثال: أدرس علم النفس. / حَاسَّة / إِحْسَاس, شُعُور / مَعْنَى, دَلَالَة / مَوْهِبَة, قُدْرَة طَبِيعِيَّة / حَسَّ (حسّه:أحرقه ، حسسْتُ الشّيء:أحسَسْتُه،حسَسْتُ اللحمَ:جعلته على الجمر،حسَسْتُ النّارَ:رددْتُها بالعصا على خُبْزِ المَلّةِ؛ حَسَّ فلاناً:قتله قتلاً ذريعاً مستأصلاً رأسه.(حسَسْتُ اليهوديََ لما أظهر عداوته لله ودينه))\nمثال: لديهم حس الفكاهة. / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / اِسْتَذْكَرَ\nمثال: ليلى تذكر سامي.",
 "知るか": "لَا يَهُمُّنِي (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "知るべ": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "知る人": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب. / عَاشِق, عَاشِقَة / مُغْرَم",
 "知る人ぞ知る": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "知る辺": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "知れた": "بَدِيهِيّ, بَدَهِيّ / تَافِه, حَقِير (صغير ولا يلفت الانتباه) / تَافِه, ضَئِيلُ الشَّأْن (ذو أهمية أو نفوذ أو سلطة قليلة؛ ذو مكانة ثانوية) / عَدِيمُ الدَّلَالَة (لا يدل على شيء) / تافه, ضئيل الشأن (خالٍ من الأهمية أو المعنى أو القوة)",
 "知れ渡る": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "知ろしめす": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء) / دَرَى, عَرَفَ (عَلِمَ وعَرَفَ)\nمثال: أدرس علم النفس. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "知ろし召す": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء) / دَرَى, عَرَفَ (عَلِمَ وعَرَفَ)\nمثال: أدرس علم النفس. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "知ろし食す": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء) / دَرَى, عَرَفَ (عَلِمَ وعَرَفَ)\nمثال: أدرس علم النفس. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "知ろす": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء) / دَرَى, عَرَفَ (عَلِمَ وعَرَفَ)",
 "知人": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "知力": "ذكاء, عقل (القدرة العقلية)\nمثال: لديه الكثير من الذكاء ولكنه يفتقر للحس السليم",
 "知友": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "知名": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "知名度": "شَعْبِيَّة",
 "知嚢": "قوى عقلية, مدارك (القوة البشرية الأساسية للتفكير الذكي والإدراك)\nمثال: استخدم ذكاءه للتقدم",
 "知巧": "براعة, ذكاء (خاصية كون الشخص بارعاً) / إبداع, عبقرية (قوة الخيال الإبداعي)",
 "知己": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "知得": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "知性": "جِهَاز الْمُخَابَرَات, مُخَابَرَات",
 "知性的": "ذهني, عقلي (يخاطب أو يستخدم الفكر والعقل) / عَقْلَانِيّ, فِكْرِيّ (مرتبط بالعقل أو يتطلّب استخدامه) / ذهني, فكري (يشمل الذكاء بدلاً من العواطف أو الغريزة) / مثقف, مفكر (شخص يستخدم عقله بشكل إبداعي)\nمثال: السخرية سلاح فكري",
 "知性連合推進機構": "لجنة التجارة بين الولايات (وكالة فيدرالية مستقلة سابقة كانت تشرف وتحدد الأسعار للناقلين الذين ينقلون البضائع والأشخاص بين الولايات؛ تم إنهاؤها في عام 1995)\nمثال: تأسست لجنة التجارة بين الولايات عام 1887 كأول وكالة فيدرالية",
 "知恵": "حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت.",
 "知恵の書": "سِفْر الحِكْمَة, سِفْر حِكْمَة سُلَيْمَان (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد)",
 "知恵歯": "ضِرْس اَلْعَقْل",
 "知恵比べ": "مَعْرَكَة دَهَاء (مسابقة يستخدم فيها الذكاء بدلاً من العنف)",
 "知恵競べ": "مَعْرَكَة دَهَاء (مسابقة يستخدم فيها الذكاء بدلاً من العنف)",
 "知恵者": "رجل حكيم (مرشد ومستشار ذكر حكيم وموثوق به)",
 "知恵袋": "عَبْقَرِيّ, نَابِغَة / عَبْقَرِيَّة",
 "知恵遅れ": "تأخر, تخلف عقلي (نقص في التطور الطبيعي للقدرات الفكرية)",
 "知情意": "عَقْل, فِطْنَة (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "知慮": "بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / استشراف, بصيرة (الرؤية المسبقة؛ المعرفة مسبقاً)",
 "知桐": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "知歯": "ضِرْس اَلْعَقْل",
 "知略": "مَوْرِد",
