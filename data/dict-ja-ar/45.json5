 "督責": "شاق, متطلب (يتطلب أكثر مما هو متوقع عادة أو يُعتقد أنه مستحق؛ خاصة صبراً وجهداً ومهارة كبيرة)\nمثال: وجد الوظيفة شاقة جداً",
 "睥睨": "مُبْهِر, وَهَّاج (يَلْمَع بِشِدَّة وقُوَّة)",
 "睦まじい": "مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين)",
 "睦月": "يَنَايِر, كَانُون اَلثَّانِي (الشهر الأول من السنة الروميّة)\nمثال: لتبدأ الاحتفالات بيناير.",
 "睨み": "وَهَج",
 "睨みをきかす": "نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر. / وَهَج",
 "睨みをきかせる": "نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر. / وَهَج",
 "睨みを利かす": "نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر. / وَهَج",
 "睨みを利かせる": "نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر. / وَهَج",
 "睨みを効かす": "نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر. / وَهَج",
 "睨みを効かせる": "نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر. / وَهَج",
 "睨み合い": "مُوَاجَهَة, مُجَابَهَة",
 "睨み据える": "وَهَج",
 "睨む": "تثمين, تقدير (حكم على صفات شيء أو شخص ما)\nمثال: في تقديري الصبي بريء / سَاعَة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا…)\nمثال: درست لمدة ساعة. / أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي.",
 "睨めた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "睨んだ": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "睫毛": "رِمْش, هُدْب (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء…)",
 "睾丸": "بَيْضَة, خُصْيَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد…)\nمثال: هذه بيضة مقلية.",
 "睾丸炎": "التهاب الخصية (التهاب إحدى الخصيتين أو كلتيهما؛ يتميز بالألم والتورم)",
 "瞋恚": "غَضَب",
 "瞑々": "غَامِق, دَاكِن",
 "瞑す": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة. / اُرْقُد فِي سَلَام, اُرْقُد بِسَلَام",
 "瞑する": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة. / اُرْقُد فِي سَلَام, اُرْقُد بِسَلَام",
 "瞑る": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا…)\nمثال: أغلق الباب بغضب",
 "瞑想": "تأمل, مضاربة فكرية (تأمل مستمر وعميق في موضوع أو سلسلة من الموضوعات ذات طبيعة عميقة أو غامضة)\nمثال: عادة التأمل هي الأساس لكل معرفة حقيقية",
 "瞑眩": "دُوَار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "瞑瞑": "غَامِق, دَاكِن",
 "瞞着": "خِدَاع, خَدْع",
 "瞞着手段": "حِيلَة",
 "瞟眇": "بِلَا حُدُود, لَامَحْدُود (يَبْدُو بِلَا حُدُودٍ فِي الكَمِّيَّةِ أَوِ العَدَدِ أَوِ الدَّرَجَةِ أَوِ…) / إِغْمَاء",
 "瞠若": "ذُهُول, دَهْشَة",
 "瞠視症": "تلصص, تلصصية (انحراف يحصل فيه الشخص على إشباع جنسي من رؤية الأعضاء التناسلية للآخرين أو…)",
 "瞥見": "لمحة, نظرة خاطفة (نظرة سريعة)",
 "瞬き": "رَمَشَ (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء…) / طرفة عين, لمح البصر (وقت قصير جداً (مثل الوقت الذي تستغرقه العين لتطرف))\nمثال: سأفعل ذلك في لمح البصر",
 "瞬く": "لَأْلَأَ (لَمَعَ، أَشْرَقَ؛ (استخدام مجازي) اغْرَوْرَقَتْ الدُّمُوع) / رَمَشَ (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء…)",
 "瞬く間": "طرفة عين, لمح البصر (وقت قصير جداً (مثل الوقت الذي تستغرقه العين لتطرف))\nمثال: سأفعل ذلك في لمح البصر",
 "瞬く間に": "حالاً, على الفور (بدون أي تأخير)\nمثال: قُتل على الفور",
 "瞬ぐ": "غَمَزَ",
 "瞬刻": "عَزْم",
 "瞬時": "لَحْظَة",
 "瞬発": "آنِيّ, لَحْظِيّ (يَحْدُث بِدُون أَيّ تَأْخِير)",
 "瞬目": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة) / عَزْم",
 "瞬膜": "جفن ثالث, غشاء راف (طية واقية من الجلد في عيون الزواحف والطيور وبعض الثدييات)",
 "瞬速": "البَرْق",
 "瞬間": "عَزْم / عندئذ, في تلك اللحظة (في وقت معين في الماضي)\nمثال: عندئذ انطلق البوق / في أية لحظة, لحظياً (في أي لحظة)\nمثال: ستكون معك في أية لحظة",
 "瞬間湯沸かし器": "حَادّ المِزَاج, سَرِيع الغَضَب (يُستثار إلى الغضب بسرعة)",
 "瞬間湯沸し器": "حَادّ المِزَاج, سَرِيع الغَضَب (يُستثار إلى الغضب بسرعة)",
 "瞬間的": "خَاطِف, عَابِر (يَدوم لِفَتْرَة قَصيرَة جِدًّا)",
 "瞬間移動": "إِنْتِقَال آنِي",
 "瞭然": "بَدِيهِيّ, بَدَهِيّ",
 "瞳": "تِلْمِيذ, تِلْمِيذَة",
 "瞳を凝らす": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ…)\nمثال: حدق الجميع في وجهي.",
 "瞳子": "تِلْمِيذ, تِلْمِيذَة",
 "瞳孔": "تِلْمِيذ, تِلْمِيذَة",
 "瞳孔反射": "تقبض الحدقة, منعكس الضوء (انكماش انعكاسي للعضلة العاصرة للقزحية استجابة لضوء ساطع (أو أدوية معينة) مما…)",
 "瞳孔括約筋": "عضلة عاصرة, مصرة (حلقة من العضلات تنقبض لإغلاق فتحة)",
 "瞳孔散大": "توسع الحدقة (توسع انعكاسي للحدقة حيث تسحب العضلة القزحية للخارج؛ يحدث استجابة لانخفاض الضوء…)",
 "瞳孔縮小": "تقبض الحدقة, منعكس الضوء (انكماش انعكاسي للعضلة العاصرة للقزحية استجابة لضوء ساطع (أو أدوية معينة) مما…)",
 "瞼": "جَفْن (مَنَعَ نَفْسَهُ عَنْ كُلِّ مَكْرُوهٍ؛ وَضَعَ الطَّعَامَ فِي الجَفْنَةِ)",
 "瞼板": "رُصُغ",
 "瞼板腺": "غدة تارسية, غدة ميبوميان (غدة دهنية طويلة ترطب الجفون)\nمثال: تنتج العدوى البكتيرية لغدة ميبوميان شحاذاً",
 "瞽者": "مَكْفوف",
 "瞿麦": "وَرْدِيّ, زَهْرِيّ (هُو ما كان بِلَوْنِ الورد؛ ٌ إِلَىٰ ٱلْوَرْدِ)\nمثال: لا أظن أن توم سيشتري مظلة وردية.",
 "矍鑠": "حَازِم, قَوِيّ (يتّسم بالقوة والحيوية في الفعل أو النشاط)",
 "矛": "ذُو مِقْبَض طَوِيل (لَهُ مِقْبَض أَوْ يَد طَويلَة) / سِلَاح, أَسْلِحَة",
 "矛を交える": "عَارَكَ, قَاتَلَ\nمثال: لن يحل القتال أي شيء.",
 "矛を収める": "دَفَنَ الأَحْقَادَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "矛先": "رأس حربة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن…)\nمثال: قطع سامي رأس كلب. / بُؤْرَة / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة.",
 "矛盾": "تَنَاقُضٌ\nمثال: それは矛盾だらけだ。 — انها مجموعة من التناقضات",
 "矛盾性": "تَنَاقُضٌ",
 "矛盾撞着": "تناقض ذاتي (مناقضة النفس)",
 "矛盾語法": "أوكسيمورون, تضاد ظاهري (الجمع بين مصطلحات متناقضة)",
 "矜恃": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق)\nمثال: أنا شديدة الفخر بأبي.",
 "矜持": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق)\nمثال: أنا شديدة الفخر بأبي.",
 "矠": "رُمح ثلاثي الشعب (رمح ذو ثلاث شوكات أو أكثر؛ يستخدم لصيد الأسماك بالرمح (خاصة السلمون))",
 "矢": "سَهْم, سهم (سَهَمَ؛ سَهَّمَ)\nمثال: لم يصب السهم توم. / إِسْفِين (عبارة عن وَتَد أو قطعة من الخَشَب أو الحَدِيد تستخدم في البِنَاء والنِجَارَة…)",
 "矢がら": "سمكة البوق (سمكة استوائية نحيلة ذات خطم أنبوبي طويل وصفائح عظمية بدلاً من القشور)",
