 "真喜志": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "真四角": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "真堂": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "真夏": "قيظ",
 "真夜中": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل\nمثال: 私たちは真夜中にロンドンに着いた。 — وصلنا إلى لندن عند منتصف الليل.",
 "真孔雀": "طاووس أخضر (طاووس جنوب شرق آسيا)",
 "真字": "كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك.",
 "真実": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة. / بصدق, حقاً (وفقاً للحقيقة أو الواقع) / بصدق, حقاً (في الواقع (تستخدم للتوكيد أو تعديل الجملة)) / بِجَدَارَة, بِحَقّ (بموجب الحق أو الشرعية) / بإخلاص, بصدق (بصدق؛ دون تصنع)\nمثال: أصبحت الآن أمريكية حقاً",
 "真実井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "真実味": "صِدْق (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع)\nمثال: صدق سامي كل شيء. / إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "真実性": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…) / وَلَاء",
 "真山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "真島": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "真崎": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "真帆": "مع الريح (مع الريح؛ في اتجاه هبوب الريح) / باتجاه الريح (نحو الريح) / مَعَ اتِّجَاه الرِّيح (نحو الجانب البعيد عن مصدر الرياح)\nمثال: طاروا مع الريح",
 "真平": "بأي حال, تحت أي ظرف (تحت أي ظرف من الظروف)\nمثال: لن تتخلى عن حيواناتها الأليفة بأي حال",
 "真弓": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "真心": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "真心をこめて": "قَلْبًا وَقَالَبًا",
 "真心を込めて": "قَلْبًا وَقَالَبًا",
 "真性": "أَصْلِيّ",
 "真性コレラ": "كوليرا (عدوى معوية حادة ناجمة عن تناول مياه أو طعام ملوث)",
 "真成": "حَقٌّ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له)\nمثال: الأستاذ على حق.",
 "真打": "الفنان المتصدر, نجم الحفل (فنان يوضع اسمه في صدارة الإعلانات لكونه الأبرز)",
 "真打ち": "الفنان المتصدر, نجم الحفل (فنان يوضع اسمه في صدارة الإعلانات لكونه الأبرز)",
 "真摯": "مُخْلِص (الشخص الذي يفي ولا يخون)\nمثال: الغيرة لا تجعل أحد مخلص",
 "真改": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "真旗魚": "مارلين مخطط (سمكة طعام وصيد في المحيط الهادئ معلمة بخطوط عمودية زرقاء داكنة)",
 "真旦": "الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم.",
 "真昼": "ظهر, ظهيرة (منتصف اليوم)",
 "真昼の夢": "حُلْم يَقَظَة (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "真木撮棒": "مسكن عسكري (سكن للأفراد العسكريين (خاصة في منزل خاص)) / رسالة قصيرة, ملاحظة (رسالة شخصية قصيرة)\nمثال: اكتب لي رسالة قصيرة عندما تصل هناك",
 "真東": "الشَّرْق (نقطة البوصلة الأصلية التي تكون عند 90 درجة)",
 "真柴": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "真核生物": "حقيقيات النوى",
 "真梶木": "مارلين مخطط (سمكة طعام وصيد في المحيط الهادئ معلمة بخطوط عمودية زرقاء داكنة)",
 "真榊": "دائم الخضرة ((عن النباتات والشجيرات) تحمل أوراق الشجر طوال العام) / نبات دائم الخضرة (نبات له أوراق تدوم وتظل خضراء طوال العام)",
 "真横": "جَانِب / صَفْحَة",
 "真正": "أَصْلِيّ",
 "真正水平派": "حَفَّار",
 "真正直": "صَرِيح, مُسْتَقِيم",
 "真正細菌": "بكتيريا, جرثومة ((في علم الأحياء الدقيقة) كائنات وحيدة الخلية أو غير خلوية كروية أو حلزونية أو عصوية الشكل تفتقر إلى الكلوروفيل وتتكاثر بالانشطار؛ مهمة كمسببات…)",
 "真殿": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "真水": "مَاء عَذْب (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "真水水母": "زَهْرَة خَوْخ",
 "真海豚": "قَصِير المِنْقَار (ذو منقار قصير)",
 "真澄": "اسم مكان (الاسم الذي يُعرف به مكان جغرافي) / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "真犯人": "حقيقة, صحة (المطابقة للواقع أو الفعليّة)",
 "真猿": "سَعْدَان, قِرْد",
 "真猿類": "قِرْدِيَّاتُ الشَّكْلِ",
 "真獣類": "ثدييات مشيمية, مشيميات (ثدييات لها مشيمة؛ جميع الثدييات باستثناء الكظاميات والجرابيات) / حقيقي الوحشية, مشيمي (من أو يتعلق بالثدييات المشيمية (الحقيقية))\nمثال: ثدييات مشيمية",
 "真率": "أمانة, صدق (صفة كون الشخص صادقاً) / زهرة الدراهم, لوناريا (نبات من جنوب شرق أوروبا يُزرع لأزهاره الأرجوانية العطرة وقرون بذوره الورقية الفضية البيضاء المستديرة المسطحة التي تستخدم للزينة الداخلية)",
 "真珠": "لُؤْلُؤَة / لُؤْلُؤ (نوع من المجوهرات الغالية التي تكون في البحر عميقًا؛ اسم شخصي معطًى ذو استخدامات تاريخية للذكور من العرب) / جَوْهَر (جَوْهَر)\nمثال: يريد شراء عقد لؤلؤ لزوجته.",
 "真珠光沢": "تقزح, تلاعب لوني (الخاصية البصرية لشيء له سطوع حليبي وتلاعب بالألوان من السطح)",
 "真珠取り": "غواص لؤلؤ (غواص يبحث عن الرخويات التي تحتوي على اللؤلؤ)",
 "真珠層": "عِرْق اللُّؤْلُؤ, زِلْف (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "真珠母": "عِرْق اللُّؤْلُؤ, زِلْف (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "真珠湾": "بِيرْل هَارْبَر",
 "真珠湾生存者協会": "بِيرْل هَارْبَر",
 "真珠色": "رَمَادِيّ لُؤْلُؤِيّ (رمادي مع لمعة لؤلؤية)",
 "真珠貝": "محار اللؤلؤ (ذوات صدفتين بحرية استوائية توجد بشكل رئيسي قبالة شرق آسيا وساحل المحيط الهادئ لأمريكا الشمالية وأمريكا الوسطى؛ مصدر رئيسي للؤلؤ)",
 "真珠質": "عِرْق اللُّؤْلُؤ, زِلْف (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "真球度": "كُرَوِيَّة",
 "真理": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "真田": "طية, كسرة (أي نوع من الطيات يتشكل عن طريق ثني القماش على نفسه ثم ضغطه أو خياطته) / جَدِيلَة, ضَفِيرَة (تسريحة شعر تتشكل بجدل أو لف الشعر)",
 "真田紐": "ضَفَّرَ, ضَفَرَ / جَدِيلَة, ضَفِيرَة",
 "真田編み": "طية, كسرة (أي نوع من الطيات يتشكل عن طريق ثني القماش على نفسه ثم ضغطه أو خياطته) / جَدِيلَة, ضَفِيرَة (تسريحة شعر تتشكل بجدل أو لف الشعر)",
 "真田虫": "دودة شريطية (ديدان مفلطحة تشبه الشريط تتطفل في أمعاء البشر والفقاريات الأخرى)",
 "真白": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "真皮": "أَدَمة",
 "真直": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم. / صَرِيح, مُسْتَقِيم / غيرية جنسية (انجذاب جنسي (أو علاقات جنسية) لأشخاص من الجنس الآخر) / استقامة, حسن نية (امتلاك نوايا صادقة) / استقامة, مباشرة (صحة المسار نحو الهدف) / استقامة (الخلو من الانحناءات أو المنعطفات أو الزوايا)\nمثال: تصرف بحسن نية",
 "真直ぐ": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم. / صَرِيح, مُسْتَقِيم",
 "真相": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "真相究明委員会": "تقصي الحقائق",
 "真相調査": "تقصي الحقائق",
 "真砂": "رَمْل (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة تتكوّن غالباً على الشاطئ أو في الصحارى)\nمثال: وصلت شاحنة الرمل.",
 "真神": "ذِئْب (حيوان مفترس من فصيلة الكلاب يعيش في جماعات وأكثر ما يصطاد في الليل؛ صفة تطلق على الرجل الذي يخدع النساء ليحصل على مراده منهن بالدهاء) / ديب / ذيب / اِلْتَهَمَ بِشَرَاهَة\nمثال: نظرة الذئب للشاة.",
 "真秀": "مُمْتَاز, فَاخِر / سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب / صَرِيح, مُسْتَقِيم",
 "真空": "خَلَاء, فَرَاغ (المكان الخالي من الناس، غالبا ما يقصد به الأماكن غير المزروعة والتي تركت طبيعية؛ المِرْحَاض، الغرفة التي تقضى فيها الحاجة)\nمثال: حبب إليه الخلاء.",
 "真空チューブ列車": "أنبوب إلكتروني, صمام مفرغ (جهاز إلكتروني يتكون من نظام من الأقطاب الكهربائية مرتبة في غلاف زجاجي أو معدني مفرغ)",
 "真空容器": "حُجْرَة فَرَاغِيَة (الغُرْفَة أو القَاعَة. تطلق على القَبْر والحَضِيرَة من باب التشبيه؛ ما يشبه الغرفة من الأرض، المكان المحمي أو المحاط بما يجعله شبيها بالمنعى الأول. استخدام مجازي وقديم)\nمثال: قعدنا في وسط الحجرة.",
 "真空帯": "جيب هوائي, فجوة هوائية (منطقة محلية ذات ضغط منخفض أو هواء هابط تسبب فقدان الطائرة للارتفاع فجأة)",
 "真空掃除機": "مِكْنَسَة كَهْرَبَائِيَّة",
 "真空管": "أنبوب إلكتروني, صمام مفرغ (جهاز إلكتروني يتكون من نظام من الأقطاب الكهربائية مرتبة في غلاف زجاجي أو معدني مفرغ)",
 "真竹": "خيزران الخشب العملاق, ماداكي (خيزران كبير له سيقان سميكة الجدران؛ موطنه الصين وربما اليابان؛ يُزرع على نطاق واسع في أماكن أخرى)",
 "真筆": "تَوْقِيع, أُوتُوجْرَاف (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم.",
 "真箇": "حَقِيقِيّ / وَاقِعِيّ / رِيَال (العُمْلَة الرسمية لدى)",
 "真経津の鏡": "مِرْآة, مراية (أداة لها القابلية على عكس الضوء بطريقة تحافظ على الكثير من صفاتهما الأصلية قبل ملامسة سطح المرآة)\nمثال: أنظر في المرآة!",
 "真芯": "النُّقْطَة المَيِّتَة (موضع المرفق عندما يكون على خط واحد مع ذراع التوصيل ولا يبذل عزم دوران)",
 "真苧": "قُنَّبُ سِيَام",
 "真菅": "سعد, عشبة السعد (نبات يشبه العشب أو الأسل ينمو في الأماكن الرطبة وله سيقان صلبة وأوراق ضيقة تشبه العشب وسنيبلات من الزهور غير الواضحة)",
 "真菌": "فُطْر ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر.",
 "真菌学": "عَلْم الفَطْرِيَات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "真菌感染症": "عدوى فطرية, فطار (حالة التهابية تسببها الفطريات)",
 "真菌毒": "ذيفان فطري, سم فطري (ذيفان ينتجه فطر)",
 "真菌症": "عدوى فطرية, فطار (حالة التهابية تسببها الفطريات)",
 "真薯": "كرة السمك, كعكة السمك (كرة مقلية أو قرص من السمك المفتت والبطاطس المهروسة)",
 "真藤": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "真蜱": "قراد صلب (قراد له درع صلب على الظهر وأجزاء فم تبرز من الرأس)",
 "真裸": "عُرْي / عَارٍ تَمَاماً ((غير رسمي) عارٍ تماماً بلا أي ملابس)",
 "真西": "الغَرْب (نقطة البوصلة الأصلية التي تكون عند 270 درجة)",
 "真言": "تعويذة, مانترا ((سنسكريتية) تعني حرفياً 'قول مقدس' في الفيدية؛ واحدة من مجموعة ترانيم شعرية منقولة شفهياً) / تعويذة متكررة, مانترا (كلمة أو عبارة مكررة بشكل شائع)\nمثال: كررت 'مسرورة جداً بسير الأمور' على فترات مثل المانترا",
 "真誠": "حَقٌّ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له)\nمثال: الأستاذ على حق.",
 "真諦": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "真賢木": "دائم الخضرة ((عن النباتات والشجيرات) تحمل أوراق الشجر طوال العام) / نبات دائم الخضرة (نبات له أوراق تدوم وتظل خضراء طوال العام)",
 "真贋": "أَصَالَة, شَرْعِيَّة (مصداقية غير متنازع عليها)",
 "真赤": "قرمزي, ياقوتي (لون أحمر عميق وزاهٍ) / تماماً, كلياً / صِرْف, مَحْض (تامّ بلا تحفّظ أو تقييد؛ يُستخدم أحيانًا مُكثِّفًا غير رسميّ) / صَرِيح, مُبَاشِر (يتَّسم بالصراحة الواضحة والمباشرة)\nمثال: هو غير صادق تماماً",
 "真近点離角": "شذوذ حقيقي (المسافة الزاوية لنقطة في مدار ما بعد نقطة الحضيض مقاسة بالدرجات)",
 "真逆さま": "رَأْسًا عَلَى عَقِب, مُنْدَفِع (بالرأس أولاً نحو الأمام) / برأسه أولاً, مندفعاً (بالرأس قبل الجسم) / باندفاع, بتهور (بطريقة متسرعة ومتهورة) / باندفاع, بسرعة جنونية (بسرعة خطرة جداً)\nمثال: انزلق العداء برأسه أولاً نحو القاعدة الثالثة",
 "真逆様": "رَأْسًا عَلَى عَقِب, مُنْدَفِع (بالرأس أولاً نحو الأمام) / برأسه أولاً, مندفعاً (بالرأس قبل الجسم) / باندفاع, بتهور (بطريقة متسرعة ومتهورة) / باندفاع, بسرعة جنونية (بسرعة خطرة جداً)\nمثال: انزلق العداء برأسه أولاً نحو القاعدة الثالثة",
 "真道": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "真野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "真鍋": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "真鍮": "شَبَه / صُفْر (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / صُفَّر (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
 "真青": "أَزْرَق سَمَاوِيّ, لَازَوَرْدِيّ (ذو لون أزرق عميق مائل إلى البنفسجيّ كسماء أكتوبر الصافية) / بَاهِت, ذَابِل (خفيف اللون وضعيفه؛ يفتقر إلى الحيويّة) / بَاهِت, شَاحِب (ذو لون خفيف وضعيف يفتقر إلى العمق) / خَافِت, شَاحِب ((للضوء) ضعيف الشدة أو السطوع؛ خافت وباهت)",
 "真面": "مُمْتَاز, فَاخِر / سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب / صَرِيح, مُسْتَقِيم",
 "真面目": "جِدِّيّ / جَدِّيّ, جَادّ",
 "真顔": "وجه جاد (تعبير وجهي جاد لا يعطي أي دليل على الاهتمام أو التسلية)",
 "真骨類": "سمكة عظمية (سمكة عظمية من طويئفة العظميات)",
 "真髄": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "真魚鰹": "جوني الصخر (سمكة طعام زلقة بلا حراشف في المياه الساحلية لشمال المحيط الأطلسي) / سمكة الزبدة (سمكة بحرية صغيرة ذات جسم مضغوط قصير وأشواك ضعيفة) / سمك الزبدة (أي من العديد من أسماك الطعام الصغيرة المفلطحة الأطلسية ذات الجلد الناعم)",
 "真鯒": "مسطحة الرأس (سمكة شاحبة تعيش في القاع مسطحة الرأس ذات عيون كبيرة وخطم يشبه البط) / مسطحة الرأس (سمكة غذائية في المنطقة الإندونيسية من المحيط الهادئ؛ تشبه الغرنار)",
 "真鯖": "ماكريل تشوب (ماكريل صغير يوجد في جميع أنحاء العالم تقريباً)",
 "真鯛": "البَحْرُ الأَحْمَر, بَحْرُ القُلْزُم",
 "真鱈": "قد المحيط الهادئ (يرتبط ارتباطاً وثيقاً بالقد الأطلسي)",
 "真鴨": "بركة, بط بري (بط بري مخوض ينحدر منه البط المنزلي؛ واسع الانتشار)",
 "真麦": "قَمْح, حِنْطَة",
 "真麻": "قُنَّبُ سِيَام",
 "眠": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة",
 "眠い": "نَعْسَان, نَاعِس",
 "眠たい": "نَعْسَان, نَاعِس",
 "眠らす": "نَوَّمَ, أَنَامَ (بكافة معانيه)\nمثال: لم أستطع النوم. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "眠らせる": "نَوَّمَ, أَنَامَ (بكافة معانيه)\nمثال: لم أستطع النوم. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "眠り": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / خمول, ركود (حالة عدم النشاط أو قلة النشاط) / خمول, عطالة (الميل للبقاء غير نشط أو خامل) / جمود, خمول (حالة عدم النشاط)\nمثال: كان عليه التغلب على عطالته والعودة للعمل / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "眠りこむ": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "眠りにつく": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "眠りに付く": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "眠りに就く": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "眠りに着く": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "眠りに落ちる": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "眠り姫": "الْجَمِيلَة الْنَائِمَة",
 "眠り病": "التهاب الدماغ السباتي, مرض النوم (التهاب دماغ كان وبائياً بين عامي 1915 و1926؛ تشمل الأعراض شلل عضلة العين الخارجية وضعف عضلي شديد)",
 "眠り草": "ميموزا (مشروب مخلوط يحتوي على الشمبانيا وعصير البرتقال) / ست الحسن, ميموزا (أي من الشجيرات أو الأشجار الاستوائية المختلفة من جنس الميموزا ذات أزهار صفراء عادة وأوراق مركبة) / سنط فضي, ميموزا (شجرة أسترالية دائمة الخضرة ذات لحاء وأوراق صغيرة بيضاء أو فضية وزهور صفراء)",
 "眠り薬": "مُخَدِّر",
 "眠り込む": "غَلَّبَ النُعَاس, نَامَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "眠る": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "眠れる": "نوم (توقف الوعي وانخفاض معدل الأيض) / سكون, كمون (حالة من الراحة الهادئة وغير النشطة) / رَاقِد, نَائِم (مستلقٍ ورأسه على كفَّيه كأنَّه نائم) / استغراق في النوم (حالة كون الشخص نائماً)",
 "眠れる森の美女": "الْجَمِيلَة الْنَائِمَة",
