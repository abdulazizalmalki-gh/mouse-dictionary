 "空気力学": "أَيْرُودِينَامِيَّة, دِينَامِيكَا هَوَائِيَّة",
 "空気力学的": "اِنْسِيَابِيّ, دِينَامِيكِيٌّ هَوَائِيًّا (مصمَّم ليقدّم أقلّ مقاومة لتدفّق الهواء أو السوائل) / ديناميكي هوائي (من أو يتعلق بالديناميكا الهوائية)",
 "空気口": "نَفَّسَ, هَوَّى (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…) / نَفَّسَ عَن (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "空気呼吸器": "قناع غاز, كمامة تنفس (قناع واقٍ مزود بمرشح؛ يحمي الوجه والرئتين من الغازات السامة) / جهاز تنفس صناعي, منشقة (جهاز تنفس لإعطاء تنفس صناعي طويل الأمد)",
 "空気圧": "ضغط الهواء, ضغط جوي (الضغط الذي يمارسه الغلاف الجوي)",
 "空気圧縮機": "ضاغط هواء (ضاغط يسحب الهواء عند الضغط الجوي ويضخه بضغط أعلى)",
 "空気孔": "جيب هوائي, فجوة هوائية (منطقة محلية ذات ضغط منخفض أو هواء هابط تسبب فقدان الطائرة للارتفاع فجأة)",
 "空気感": "جَو, غِلَاف جَوِّيّ / جَو",
 "空気扱い": "تَجَاهَلَ, طَنَّش",
 "空気抜き": "مِرْوَحَة",
 "空気枕": "وسادة هوائية (وسادة مصنوعة عادة من المطاط أو البلاستيك يمكن نفخها) / زنبرك هوائي, وسادة هوائية (جهاز ميكانيكي يستخدم الهواء المحصور لامتصاص صدمة الحركة) / وسادة هوائية (الهواء المحبوس الذي يدعم الحوامة على مسافة قصيرة فوق الماء أو الأرض)",
 "空気汚染": "تَلَوُّث الْهَوَاء, تَلَوُّث هَوَائِيّ (تَلَطُّخ، تَكَدُّر، قذارة ودنس يصيبان الجو أو الماء أو البيئة ويؤديان إلى تسمم أو أمراض؛ تَشَوُّه)\nمثال: التلوث يضر كوكبنا.",
 "空気流": "تدفق الهواء, تيار هوائي (سريان الهواء)\nمثال: عدلت المروحة بحيث يوجه تدفق الهواء نحوها مباشرة",
 "空気浄化機": "مرشح هواء, منقي هواء (مرشح يزيل الغبار من الهواء الذي يمر عبره)",
 "空気発条": "زنبرك هوائي, وسادة هوائية (جهاز ميكانيكي يستخدم الهواء المحصور لامتصاص صدمة الحركة)",
 "空気袋": "كيس هوائي (أي من الامتدادات الغشائية المملوءة بالهواء لرئات الطيور) / كيس هوائي (أي من الامتدادات رقيقة الجدران للقصبات الهوائية للحشرات) / حويصلة هوائية, سنخ (كيس صغير جداً لحمل الهواء في الرئتين؛ يتكون من التوسع النهائي للممرات الهوائية الدقيقة)",
 "空気調和": "تَكْيِيف",
 "空気調和機": "تَكْيِيف",
 "空気調整": "تَكْيِيف",
 "空気調節": "تَكْيِيف",
 "空気調節器": "تدفق الهواء, تيار هوائي (سريان الهواء)\nمثال: عدلت المروحة بحيث يوجه تدفق الهواء نحوها مباشرة",
 "空気酸化": "آلة صنفرة أسطوانية (أداة كهربائية تستخدم لصنفرة الخشب؛ يتم تحريك حلقة لا نهائية من ورق الصنفرة بسرعة عالية بواسطة محرك كهربائي)",
 "空気銃": "بندقية هوائية, مسدس هوائي (بندقية تدفع المقذوف بواسطة الهواء المضغوط)",
 "空気電池": "حويصلة هوائية, سنخ (كيس صغير جداً لحمل الهواء في الرئتين؛ يتكون من التوسع النهائي للممرات الهوائية الدقيقة)",
 "空洞": "تَجْوِيف / أَجْوَف",
 "空洞共振器": "حجرة رنين, رنان (حجرة مجوفة تسمح أبعادها بالتذبذب الرنيني للموجات الكهرومغناطيسية أو الصوتية)",
 "空涙": "دموع التماسيح (إظهار نفاق للحزن؛ بكاء كاذب أو غير صادق)\nمثال: ذرفت السكرتيرات دموع التماسيح على معضلة المدير",
 "空港": "مَطَار (المَطارُ : اسمُ مكانٍ من طَارَ؛ المَطارُ :وهو مكان مُعَدُّ بالوسائل الفنِّيَّة لصعود الطائرات وهبوطها أي مركز طيران جوي، أو ميناء جوي)\nمثال: وصلت إلى المطار.",
 "空港ターミナル": "محطة جوية (محطة طرفية تخدم المسافرين جواً أو الشحن الجوي)",
 "空漠": "شَاسِع, وَاسِع / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "空疎": "فَارِغ / فَرَغَ",
 "空白": "فراغ, مساحة فارغة (منطقة فارغة)\nمثال: اكتب اسمك في المكان المخصص / خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "空白期間": "فَتْرَة",
 "空盒気圧計": "بارومتر لا سائلي, بارومتر معدني (بارومتر يقيس الضغط دون استخدام السوائل)",
 "空目": "هَلْوَسَة, وَهْم / هَلْوَسَة",
 "空知": "اسم مكان (الاسم الذي يُعرف به مكان جغرافي) / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "空穂": "جَعْبَة",
 "空空": "فَارِغ / فَرَغَ",
 "空空しい": "زَائِف, بَاطِل / كَاذِب",
 "空空漠漠": "شَاسِع, وَاسِع",
 "空耳": "صَمَم",
 "空胞": "فجوة (تجويف صغير مملوء بالسائل في سيتوبلازم الخلية)",
 "空胞化": "تشكل فجوات, تفجي (حالة الامتلاء بالفجوات)",
 "空腸": "صَائِم",
 "空腹": "رَغْبَة, تَعَطُّش / جَاعَ (أَصَابَهُ الجُوعُ؛ أَصَابَهُ الفَقْرُ الشَّديدُ)\nمثال: جاع الرجل العجوز حتى الموت.",
 "空腹時": "صَوْم, صِيَام",
 "空色": "سَمَاوِيّ, أَسْمَانْجُونِيّ",
 "空蒸し": "بشكل حار جداً, بغلليان ((تستخدم للحرارة) للغاية) / بُخَارِيّ, مُتَصَاعِد البُخَار (مملوء بالبخار أو ينبعث منه رطوبة على شكل بخار أو ضباب)\nمثال: كان الطبق ساخناً جداً",
 "空虚": "بُطْلَان, غُرُور (صفة كون الشيء عديم القيمة أو عبثياً) / خلاء, فراغ (منطقة أو مساحة فارغة) / خواء (حالة وجود معدة فارغة) / خواء, فراغ (حالة عدم احتواء أي شيء)\nمثال: رفض مغريات العالم الباطلة / حماقة, سخف (الافتقار التام للمعنى أو الأفكار)",
 "空蝉": "بُطْلَان, غُرُور (صفة كون الشيء عديم القيمة أو عبثياً) / خلاء, فراغ (منطقة أو مساحة فارغة) / خواء (حالة وجود معدة فارغة) / خواء, فراغ (حالة عدم احتواء أي شيء)",
 "空襲": "غارة جوية, هجوم جوي (هجوم بطائرات مسلحة على هدف سطحي)",
 "空覚え": "حِفْظ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "空言": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "空調": "تَكْيِيف",
 "空調機": "تَكْيِيف",
 "空調設備": "مُكَيِّف هَوَاء",
 "空談": "نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "空論家": "دُوغْمَائِيّ, عَقَائِدِيّ (متمسك بالنظرية بعناد دون مراعاة للجانب العملي أو الملاءمة) / دوغمائي, متزمت (شخص عنيد ذو آراء تعسفية أو متعجرفة)",
 "空豆": "فُول, بَاقِلَّاء",
 "空費": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "空路": "مسار طيران, ممر جوي (طريق محدد تتبعه الطائرات في الطيران من مطار إلى آخر)",
 "空軍": "سِلَاح طَيَرَان",
 "空軍力": "سلاح الطيران, قوة جوية (مجموع الطائرات العسكرية لدولة ما)",
 "空軍協会": "سِلَاح طَيَرَان",
 "空軍士官学校": "أكاديمية القوات الجوية, كلية القوات الجوية (أكاديمية لتدريب ضباط القوات الجوية)",
 "空軍大尉": "سِلَاح طَيَرَان",
 "空軍機": "سِلَاح طَيَرَان",
 "空転": "سباق (رياضة المشاركة في مسابقات السرعة)",
 "空輸": "نقل جوي (النقل عن طريق الجو)",
 "空運": "نقل جوي (النقل عن طريق الجو)",
 "空部屋": "شَاغِر, وَظِيفَة شَاغِرَة / غُرْفَة شَاغِرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات) / حَيِّز\nمثال: الأب في الغرفة.",
 "空門": "بُوذِيَّة, سَمَنِيَّة (المؤنث من \"بُوذِيّ\"؛ ديانة تتبع تعاليم مؤسسها غواتاما بوذا، نشأت في شبه قارة الهند ما بين القرنين السادس والرابع قبل الميلاد)",
 "空閑地": "أرض خالية, أرض فضاء (قطعة أرض لا توجد عليها مباني دائمة)",
 "空間": "فَرَاغ, مَكَان / فَضَاء (فَضَاء) / مَسَافَة\nمثال: الفضاء مليئ بالغموض. / شَاغِر, وَظِيفَة شَاغِرَة / غُرْفَة شَاغِرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات) / حَيِّز\nمثال: الأب في الغرفة. / انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "空間格子": "شبكة بلورية, شبكة فراغية (ترتيب هندسي ثلاثي الأبعاد للذرات أو الجزيئات أو الأيونات المكونة للبلورة)",
 "空間的": "فَضَائِيّ",
 "空間的関係": "عَلاقَة مَكَانِيَّة, مَوْضِع (الخاصية المكانية لمكان أو طريقة توجد بها الأشياء)\nمثال: موضع العقارب على الساعة",
 "空間芸術": "فن تشكيلي (فنون التشكيل أو النمذجة؛ النحت والحفر)",
 "空間計算量": "تَعْقِيد مَكَانِيّ",
 "空間識失調": "دَوْخَة, دُوَار",
 "空隙": "ثقب, فتحة (فتحة من صنع الإنسان؛ عادة ما تكون صغيرة) / فتحة عدسة (جهاز يتحكم في كمية الضوء المسموح بدخولها) / فتحة (فتحة طبيعية في شيء ما)",
 "空際": "أُفُق ((أَفِقَ) أفَقَاً: بلغ النِّهَايَة فِي الْكَرم وَالْعلم فَهُوَ أفق وأفيق)\nمثال: طلعت الشمس فوق الأفق.",
 "空電": "سَاكِن, مُسْتَقِرّ (لا يُظهر تغيّرًا يُذكر إن وُجد) / ثَابِت, جَامِد (ليس في حالة حركة جسدية) / كهروستاتيكي, كهروسكوني (معني بـ أو منتج لـ أو ناتج عن الكهرباء الساكنة) / تَشْوِيش, نَقْد غَاضِب (نقد غاضب)\nمثال: مولد كهروستاتيكي ينتج كهرباء ساكنة عالية الجهد",
 "空音": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "空風呂": "حمام بخار, حمام تركي (التعرق في غرفة بخار قبل الحصول على تدليك ودش بارد) / حمام بخار, غرفة بخار (غرفة يمكن ملؤها بالبخار يستحم فيها الناس)",
 "空飛ぶ円盤": "طَبَق طَائِر (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ.",
 "空騒ぎ": "عَجِيج, ضَجِيج",
 "空高さ": "اِرْتِفَاع",
 "穿く": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا. / أَفِكْس",
 "穿ちすぎた": "بَعِيد الاِحْتِمَال, مُسْتَبْعَد (غَيْر مُقْنِع؛ يَبْدو مُسْتَبْعَدًا أَوْ مُبالَغًا فيه) / بَعِيد الاحْتِمَال, مُتَعَسِّف ((عن فكرة أو قصة) مبالغ فيها أو هزلية لدرجة أنها غير محتملة)",
 "穿ち過ぎた": "بَعِيد الاِحْتِمَال, مُسْتَبْعَد (غَيْر مُقْنِع؛ يَبْدو مُسْتَبْعَدًا أَوْ مُبالَغًا فيه) / بَعِيد الاحْتِمَال, مُتَعَسِّف ((عن فكرة أو قصة) مبالغ فيها أو هزلية لدرجة أنها غير محتملة)",
 "穿った": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء.",
 "穿つ": "ثَقَبَ, نَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / مِثْقَاب, بريمة / نِظام مُنْضَمّ, تَدْرِيْبات (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: انه ثقب الاسود. / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "穿り出す": "عتلة, مِخْل (رافعة حديدية ثقيلة أحد طرفيها مُشَكَّل كإسفين)",
 "穿り返す": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "穿刺": "بزل البطن (بزل البطن لإزالة السائل للتشخيص)",
 "穿孔": "تثقيب, تخريم (فعل ثقب حفرة (خاصة صف من الثقوب لسهولة الفصل)) / تثقيب, خط ثقوب (خط من الثقوب الصغيرة للتمزيق في مكان معين) / تثقيب, خرق (ثقب مصنوع في شيء ما)\nمثال: ثقب في طبلة الأذن",
 "穿孔カード": "بطاقة مثقبة (بطاقة يمكن تسجيل البيانات عليها في شكل ثقوب)",
 "穿孔テープ": "شريط ورقي (شريط طويل ضيق من الورق)",
 "穿孔機": "مثقاب عمودي, مكبس حفر (أداة آلية ذات حامل عمودي منفصل؛ يتم ضغط المثقاب الكهربائي في العمل تلقائياً أو برافعة يدوية)",
 "穿孔機構": "لَكْمَة / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة) / خَرَّامَة\nمثال: لكم اشتقت إليك!",
 "穿孔済カード": "بطاقة مثقبة (بطاقة يمكن تسجيل البيانات عليها في شكل ثقوب)",
 "穿孔翻訳機": "مُتَرْجِم, مُتَرْجِمَة",
 "穿孔装置": "لَكْمَة / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة) / خَرَّامَة\nمثال: لكم اشتقت إليك!",
 "穿山甲": "آكل النمل الحرشفي, بنغول (ثديي عديم الأسنان من جنوب أفريقيا وآسيا يغطي جسمه حراشف قرنية وله خطم طويل للتغذى على النمل والنمل الأبيض)",
 "穿通": "اِخْتِرَاقْ (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "穿鑿": "سَبَّار, مُتَعَمِّق (دقيق وشامل في البحث أو التحقيق) / استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض) / تنيقب, حفر (فعل الحفر) / حفر, حفرية (حفرة في الأرض ناتجة عن الحفر) / حفرية, موقع أثري (موقع الاستكشاف الأثري)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون",
 "穿頭": "نَقَب الجَمْجَمَة (في الأرض: ذَهَبَ؛ كأن الشخص خرق الأرض إذا سار فيها. غالبا ما يقصد أن يكون ذلك طلبا للمهرب ولا يشترط؛ عن الشيء: فحصه فحصا دقيقا ليعرف تفاصيله)\nمثال: تم مراقبة قردة الأورانج أوتان و هي تستعمل عصي لنقب البذور المغذية من النباتات الشائكة.",
 "穿頭術": "نَقَب الجَمْجَمَة (في الأرض: ذَهَبَ؛ كأن الشخص خرق الأرض إذا سار فيها. غالبا ما يقصد أن يكون ذلك طلبا للمهرب ولا يشترط؛ عن الشيء: فحصه فحصا دقيقا ليعرف تفاصيله)\nمثال: تم مراقبة قردة الأورانج أوتان و هي تستعمل عصي لنقب البذور المغذية من النباتات الشائكة.",
 "突": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "突き": "دفع, قوة دافعة (فعل تطبيق قوة لدفع شيء ما) / نكز, وكز (إيماءة يد حادة (تشبه الضربة)) / طعنة (ضربة قوية بسكين أو أداة حادة أخرى مدببة) / طَعْنَة, نَقْد لَاذِع (نقد لفظي حاد)\nمثال: بعد الوصول إلى السرعة المطلوبة يتم قطع الدفع / نَقَّرَ, نَقَرَ",
 "突きぎり": "مِخْرَز, إِشْفَى",
 "突きくだく": "بَاوْنْد / رَطْل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ) / جُنَيْه",
 "突きこむ": "أشياء, أغراض (أشياء متنوعة غير محددة) / طينة, مقومات (صفات غير محددة مطلوبة للقيام بشيء ما أو لكي تكون شيئاً ما) / عنصر, مادة (مكون مهم جداً أو مميز) / كَلَام فَارِغ, هُرَاء (حديث لا معنى له)\nمثال: كان الصندوق مليئاً بالأغراض / أَشَارَ / رد, هجمة مرتدة ((المبارزة) هجوم مضاد يتم فوراً بعد صد اندفاع الخصم بنجاح) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "突きでる": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم.",
 "突きの順位": "تسلسل هرمي, هرمية (تنظيم الأشخاص في مراتب ودرجات مختلفة داخل هيئة إدارية)",
 "突き上げる": "رَفَعَ, سَانَدَ (دفع شخصاً أو شيئاً من الأسفل لمساعدته على الصعود)\nمثال: رفعت أطفالها للأعلى عندما مر الشرطي / ضَغْط",
 "突き倒す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "突き出し": "نَاتِئَة / مشهيات, مقبلات (طبق يُقدم لفتح الشهية قبل الوجبة الرئيسية)",
 "突き出す": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم. / سَلَّمَ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم.",
 "突き出た": "بَارِز, مُمْتَدّ (يمتد للخارج فوق سطح أو حدّ أو ما وراءهما)",
 "突き出る": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم.",
 "突き刺さる": "غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط.",
 "突き刺す": "طَعْن / طَعْنَة / طَعَنَ",
 "突き動かす": "دَفَعَ, زق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / دَفْعَة\nمثال: دفع زيري الثمن. / مِهْمَاز",
 "突き合わせ": "مُتَوَافِق, مُنَسَّق (مُطابَق عن قصد) / تَوْأَمِيّ, مُتَمَاثِل (يكون اثنين متطابقين)",
 "突き合わせる": "قَارَنَ / شَبَّهَ",
 "突き合わせ継ぎ手": "وصلة تقابل, وصلة تناكبية (وصلة تُصنع عن طريق تثبيت الأطراف معاً دون تداخل)",
 "突き合わせ継手": "وصلة تقابل, وصلة تناكبية (وصلة تُصنع عن طريق تثبيت الأطراف معاً دون تداخل)",
 "突き崩す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ) / هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا) / دَحَضَ, أَدْحَضَ (أبطلَ الحُجّة أو دفعها بالحُجّة المضادة؛ زلَّ أو انزلق) / كَذَّبَ (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة)\nمثال: اتهمتني بالكذب.",
 "突き当たり": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "突き当り": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "突き戻す": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "突き抜く": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود.",
 "突き放す": "هَجَرَ (ضد الوصل، الصرم والقطع. مصدره هَجْر وهِجران؛ ترك وابعد وتباعد. مصدره هَجْر)\nمثال: هجر ياني زوجته.",
 "突き板": "قِنَاع (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "突き棒": "مِدَكّ / مهماز, مهيج (أداة مدببة تستخدم للحث على الحركة) / تحفيز, حث (لفظ يشجعك على محاولة شيء ما)\nمثال: النكز المستمر أثار أعصابه",
 "突き止める": "تَيَقَّنَ, تَثَبَّتَ",
 "突き砕く": "بَاوْنْد / رَطْل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ) / جُنَيْه",
 "突き破る": "اِخْتَرَقَ",
 "突き立つ": "غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط. / وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "突き立てる": "طَعْن / طَعْنَة / طَعَنَ / نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "突き込む": "أشياء, أغراض (أشياء متنوعة غير محددة) / طينة, مقومات (صفات غير محددة مطلوبة للقيام بشيء ما أو لكي تكون شيئاً ما) / عنصر, مادة (مكون مهم جداً أو مميز) / كَلَام فَارِغ, هُرَاء (حديث لا معنى له)\nمثال: كان الصندوق مليئاً بالأغراض / أَشَارَ / رد, هجمة مرتدة ((المبارزة) هجوم مضاد يتم فوراً بعد صد اندفاع الخصم بنجاح) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "突き返す": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "突き通す": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود.",
 "突き通る": "اِخْتَرَقَ",
 "突き錐": "مِخْرَز, إِشْفَى",
 "突く": "زُبّ, زُبْر (في : اللحية أو مقدمها؛ في : الأنف) / خَزَّ (\"خَزَّهُ بسكِّينٍ\" : طَعَنَهُ بِهِ؛ \"خَزَّهُ بِبَصَرِهِ\" : أَصَابَتْهُ عَيْنُه)\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟ / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟ / حَمْلَة / هَاجَمَ",
 "突っかい": "سِنَاد, عِمَاد / دَعَمَ, عَمَدَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "突っかい棒": "سِنَاد, عِمَاد / دَعَمَ, عَمَدَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "突っかかる": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي / اِنْدَلَعَ",
 "突っかけ": "سهل الارتداء (قطعة ملابس (رداء أو حذاء) يمكن ارتداؤها أو خلعها بسهولة)",
 "突っこみ": "دفع, قوة دافعة (فعل تطبيق قوة لدفع شيء ما) / نكز, وكز (إيماءة يد حادة (تشبه الضربة)) / طعنة (ضربة قوية بسكين أو أداة حادة أخرى مدببة) / طَعْنَة, نَقْد لَاذِع (نقد لفظي حاد)\nمثال: بعد الوصول إلى السرعة المطلوبة يتم قطع الدفع / عَمْق / الممهد الكوميدي (مؤدٍ ذكر يلعب دور الشخصية الجادة الممهدة للمهرج أو الكوميدي) / طعني",
 "突っこむ": "أشياء, أغراض (أشياء متنوعة غير محددة) / طينة, مقومات (صفات غير محددة مطلوبة للقيام بشيء ما أو لكي تكون شيئاً ما) / عنصر, مادة (مكون مهم جداً أو مميز) / كَلَام فَارِغ, هُرَاء (حديث لا معنى له)\nمثال: كان الصندوق مليئاً بالأغراض / أَشَارَ / رد, هجمة مرتدة ((المبارزة) هجوم مضاد يتم فوراً بعد صد اندفاع الخصم بنجاح) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "突っつく": "خَزَّ (\"خَزَّهُ بسكِّينٍ\" : طَعَنَهُ بِهِ؛ \"خَزَّهُ بِبَصَرِهِ\" : أَصَابَتْهُ عَيْنُه)\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟",
 "突っぱねる": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "突っ伏す": "سَجَدَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)",
 "突っ切る": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "突っ張り": "سِنَاد, عِمَاد / دَعَمَ, عَمَدَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة. / إِحْكَام, ضِيق (انعدام الحركة أو المجال للحركة) / خسة, شح (بخل شديد) / اِكْتِظَاظ, تَرْكِيز (الخاصية المكانية للازدحام أو التكدس معاً) / انقباض, ضيق (شعور بالضيق في جزء من الجسم)\nمثال: شعر بانقباض في صدرها / دفع, قوة دافعة (فعل تطبيق قوة لدفع شيء ما) / نكز, وكز (إيماءة يد حادة (تشبه الضربة)) / طعنة (ضربة قوية بسكين أو أداة حادة أخرى مدببة) / طَعْنَة, نَقْد لَاذِع (نقد لفظي حاد)\nمثال: بعد الوصول إلى السرعة المطلوبة يتم قطع الدفع / انحراف الأحداث, جنوح (سلوك معاد للمجتمع ينتهك القانون يرتكبه قاصر) / إهمال, جنوح (الميل للإهمال وعدم الاكتراث) / تأخر في السداد, جنحة مالية (عدم سداد دين عند استحقاقه)\nمثال: ورث جنوحه عن أبيه",
 "突っ張る": "شَدَّ, ضَيَّقَ / ثَابَرَ / خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك) / صَرِيح, طَيِّب القَلْب (مُبَاشِر وَصَرِيح فِي الكَلَام لَكِنْ بِطِيبَة قَلْب) / شَاهِق, عَمُودِيّ تَقْرِيبًا (شديد الانحدار؛ ذو واجهة بارزة وشبه عمودية) / خداع, مخادعة (تظاهر بأن موقفك أقوى مما هو عليه في الواقع)\nمثال: نجحت مخادعته في قبوله / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "突っ慳貪": "كَلِيل",
 "突っ掛かる": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي / اِنْدَلَعَ",
 "突っ掛け": "سهل الارتداء (قطعة ملابس (رداء أو حذاء) يمكن ارتداؤها أو خلعها بسهولة)",
 "突っ支い": "سِنَاد, عِمَاد / دَعَمَ, عَمَدَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "突っ支い棒": "سِنَاد, عِمَاد / دَعَمَ, عَمَدَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "突っ突く": "خَزَّ (\"خَزَّهُ بسكِّينٍ\" : طَعَنَهُ بِهِ؛ \"خَزَّهُ بِبَصَرِهِ\" : أَصَابَتْهُ عَيْنُه)\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟",
 "突っ立つ": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "突っ立てる": "طَعْن / طَعْنَة / طَعَنَ / نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "突っ走る": "سُرْعَة\nمثال: 違反のスピードを出して、突っ走っていた車がブレーキをかけたが、空回りして、運転手があっというまもなく、トラックの背後に、もろにぶつかった。 — تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جداً .",
 "突っ込み": "دفع, قوة دافعة (فعل تطبيق قوة لدفع شيء ما) / نكز, وكز (إيماءة يد حادة (تشبه الضربة)) / طعنة (ضربة قوية بسكين أو أداة حادة أخرى مدببة) / طَعْنَة, نَقْد لَاذِع (نقد لفظي حاد)\nمثال: بعد الوصول إلى السرعة المطلوبة يتم قطع الدفع / عَمْق / الممهد الكوميدي (مؤدٍ ذكر يلعب دور الشخصية الجادة الممهدة للمهرج أو الكوميدي) / طعني",
 "突っ込みどころ": "تَنَاقُض, عَدَم اتِّسَاق (صفة عدم الاتساق وافتقار الانسجام بين الأشياء أو الأجزاء) / تَعَارُض, تَنَافُر (العلاقة بين القضايا التي لا يمكن أن تكون صحيحة في نفس الوقت)",
 "突っ込み所": "تَنَاقُض, عَدَم اتِّسَاق (صفة عدم الاتساق وافتقار الانسجام بين الأشياء أو الأجزاء) / تَعَارُض, تَنَافُر (العلاقة بين القضايا التي لا يمكن أن تكون صحيحة في نفس الوقت)",
 "突っ込む": "أشياء, أغراض (أشياء متنوعة غير محددة) / طينة, مقومات (صفات غير محددة مطلوبة للقيام بشيء ما أو لكي تكون شيئاً ما) / عنصر, مادة (مكون مهم جداً أو مميز) / كَلَام فَارِغ, هُرَاء (حديث لا معنى له)\nمثال: كان الصندوق مليئاً بالأغراض / أَشَارَ / رد, هجمة مرتدة ((المبارزة) هجوم مضاد يتم فوراً بعد صد اندفاع الخصم بنجاح) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "突っ返す": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "突として": "فَجْأَةً",
 "突ん出す": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم.",
 "突兀": "شَاهِق",
 "突先": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "突入": "عَاصِفَة / طُوفَان (عاصفة) / عَاصْفة",
 "突出": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها. / تَمَزُّق / بروز, شهرة (الأهمية النسبية أو الشهرة) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / بروز, شهرة (حالة كونه بارزاً: معروفاً على نطاق واسع أو مرموقاً)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "突出し": "نَاتِئَة / مشهيات, مقبلات (طبق يُقدم لفتح الشهية قبل الوجبة الرئيسية)",
 "突出して": "خُصُوصًا, خَاصَّةً",
 "突出る": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم.",
 "突出物": "نامية, نتوء غير طبيعي ((في علم الأمراض) نتوء أو تضخم غير طبيعي لجزء ما من الجسم) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "突出部": "بثق, طرد (الإخراج عن طريق تطبيق الضغط) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه)\nمثال: خروج غير متوقع لمعجون الأسنان من قاع الأنبوب",
 "突厥": "مُنْغُولِيَا",
 "突合": "مُتَوَافِق, مُنَسَّق (مُطابَق عن قصد) / تَوْأَمِيّ, مُتَمَاثِل (يكون اثنين متطابقين)",
 "突合せ": "مُتَوَافِق, مُنَسَّق (مُطابَق عن قصد) / تَوْأَمِيّ, مُتَمَاثِل (يكون اثنين متطابقين)",
 "突合せ溶接": "لحام تناكبي (إنشاء وصلة تناكبية عن طريق اللحام)",
 "突合せ継手": "وصلة تقابل, وصلة تناكبية (وصلة تُصنع عن طريق تثبيت الأطراف معاً دون تداخل)",
 "突堤": "كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ)",
 "突変": "طَفْرَة (التطوّر أو الارتفاع المفاجئ، الانتقال السريع من حالة إلى أخرى)",
 "突如": "فَجْأَةً",
 "突如として": "فَجْأَةً",
 "突崩す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ) / هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا) / دَحَضَ, أَدْحَضَ (أبطلَ الحُجّة أو دفعها بالحُجّة المضادة؛ زلَّ أو انزلق) / كَذَّبَ (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة)\nمثال: اتهمتني بالكذب.",
 "突当り": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "突慳貪": "كَلِيل",
 "突抜く": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود.",
 "突抜忍冬": "عسلة البوق, عسلة مرجانية (كرمة عسلة أمريكية شمالية دائمة الخضرة لها زهور حمراء مرجانية أو برتقالية)",
 "突拍子もない": "مُذْهِل",
 "突拍子も無い": "مُذْهِل",
 "突撃": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي",
 "突撃一番": "عَازِل ذَكَرِيّ / وَاقٍ ذَكَرِيّ / كُونْدُوم / كَانْدُوم / عَازِل طِبِّيّ",
 "突撃砲": "مدفع هجومي (مركبة مدرعة بهيكل دبابة (ولكن بدون برج) ومدفع كبير؛ تستخدم كسلاح مضاد للدبابات ولدعم المشاة) / بندقية اقتحام, بندقية هجومية (أي من البنادق الآلية أو نصف الآلية ذات مخازن الذخيرة الكبيرة المصممة للاستخدام العسكري)",
 "突撃銃": "بُنْدُقِيَّة هُجُومِيَّة (أنبوب لاطلاق الرصاص، وتعتبر من الأسلحة؛ الْبُنْدُقِيََة: فِي إِيطَالْيَا)\nمثال: البندقية مدينة جميلة.",
 "突撃隊": "كتيبة العاصفة (ميليشيا نازية أنشأها هتلر عام 1921 ساعدته في الوصول إلى السلطة ولكن طغت عليها القوات الخاصة بعد عام 1943) / قوات الصدمة (جنود مدربون ومسلحون بشكل خاص لقيادة هجوم)",
 "突撃隊員": "جندي العاصفة (عضو في القوات شبه العسكرية النازية)",
 "突板": "قِنَاع (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "突沸": "خبطة, ضربة (ارتطام (كما هو الحال في التصادم)) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / انتفاخ, ورم (كتلة في الجسم ناتجة عن ضربة)\nمثال: الخبطة ألقته عن الدراجة",
 "突然": "مُبَاغِت, مُفَاجِئ",
 "突然変異": "طَفْرَة (التطوّر أو الارتفاع المفاجئ، الانتقال السريع من حالة إلى أخرى)",
 "突然変異体": "حيوان متحول, طافر (حيوان خضع لطفرة جينية) / طافر, متحول (يميل للخضوع لطفرة أو ناتج عنها) / طافر, طفرة ((في علم الأحياء) كائن حي له خصائص ناتجة عن تغيير كروموسومي)\nمثال: جين طافر",
 "突然死": "مَوْت الفَجْأَة (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "突発": "تَفَشٍّ",
 "突発性発疹": "طفح جلدي (أي طفح أحمر على الجلد)",
 "突発的": "مُبَاغِت, مُفَاجِئ",
 "突破": "اِخْتِرَاق (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها) / هَزَمَ, تَغَلَّبَ / فَائِق, هَائِل (يتجاوز بكثير ما هو معتاد في الحجم أو الدرجة)",
 "突破る": "اِخْتَرَقَ",
 "突破口": "اِخْتِرَاق (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "突立つ": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط. / وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "突端": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "突貫": "اِنْدَفَعَ, أَسْرَعَ / سَمَار / استعجال, اندفاع (فعل التحرك بعجلة وبطريقة غير مبالية) / اندفاع, هجوم ((كرة القدم الأمريكية) محاولة لتقديم الكرة عن طريق الركض في الخط)\nمثال: في عجلته للمغادرة نسي كتابه / اِخْتِرَاقْ (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "突貫作業": "برنامج مكثف, دورة مكثفة (دورة سريعة ومكثفة للتدريب أو البحث (تتم عادة في حالة الطوارئ))\nمثال: أخذ دورة مكثفة في الإيطالية في طريقه إلى إيطاليا",
 "突起": "نُتُوء, نَاتِئ",
 "突起物": "نُتُوء, نَاتِئ / سُرّة الطبلة (ارتفاع دائري طفيف حيث تلتصق المطرقة بطبلة الأذن)",
 "突込み": "دفع, قوة دافعة (فعل تطبيق قوة لدفع شيء ما) / نكز, وكز (إيماءة يد حادة (تشبه الضربة)) / طعنة (ضربة قوية بسكين أو أداة حادة أخرى مدببة) / طَعْنَة, نَقْد لَاذِع (نقد لفظي حاد)\nمثال: بعد الوصول إلى السرعة المطلوبة يتم قطع الدفع / عَمْق / الممهد الكوميدي (مؤدٍ ذكر يلعب دور الشخصية الجادة الممهدة للمهرج أو الكوميدي) / طعني",
 "突込む": "أشياء, أغراض (أشياء متنوعة غير محددة) / طينة, مقومات (صفات غير محددة مطلوبة للقيام بشيء ما أو لكي تكون شيئاً ما) / عنصر, مادة (مكون مهم جداً أو مميز) / كَلَام فَارِغ, هُرَاء (حديث لا معنى له)\nمثال: كان الصندوق مليئاً بالأغراض / أَشَارَ / رد, هجمة مرتدة ((المبارزة) هجوم مضاد يتم فوراً بعد صد اندفاع الخصم بنجاح) / جواب سريع, رد مفحم (رد سريع على سؤال أو ملاحظة (خاصة إذا كان ذكياً أو نقدياً))\nمثال: استدعى ذلك رداً حاداً من المعلم",
 "突通る": "اِخْتَرَقَ",
 "突進": "اِنْدَفَعَ, أَسْرَعَ / سَمَار",
 "突顎": "بروز الفك, فقم (حالة بروز الفك نحو الأمام)",
 "突風": "هَبَّة",
 "突飛": "مُتَقَلِّب, نَزَوِيّ (عرضة لتغيّرات مفاجئة وغير متوقّعة) / غَيْرُ مُنْتَظِم, مُتَقَلِّب (مِنَ المُرَجَّحِ أَنْ يَعْمَلَ بِشَكْلٍ غَيْرِ مُتَوَقَّع) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت)",
 "窃取": "سَرِقَة, سَرَقَة",
 "窃盗": "سَرِقَة, سَرَقَة",
 "窃盗強迫": "مرض السرقَة (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "窃盗犯": "سَرِقَة, سَرَقَة",
 "窃盗狂": "مرض السرقَة (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "窃盗症": "مرض السرقَة (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "窃盗癖": "مرض السرقَة (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "窃盗罪": "سَرِقَة, سَرَقَة",
 "窃盗行為": "سَرِقَة, سَرَقَة",
 "窃視症": "تلصص, تلصصية (انحراف يحصل فيه الشخص على إشباع جنسي من رؤية الأعضاء التناسلية للآخرين أو مشاهدة السلوك الجنسي للآخرين)",
 "窄": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "窄まる": "عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد.",
 "窄む": "عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد. / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "窄める": "أَغْلَقَ (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / اِنْغَلَقَ\nمثال: أغلق الباب بغضب",
 "窈窕": "رَشِيق, ظَرِيف",
 "窒化": "نيتريد (مركب يحتوي على النيتروجين وعنصر أكثر إيجابية كهربائية (مثل الفوسفور أو فلز))",
 "窒化ホウ素": "نيتريد البورون\nمثال: نيتريد البورون له استخدام محتمل في تقنية النانو",
 "窒化物": "نيتريد (مركب يحتوي على النيتروجين وعنصر أكثر إيجابية كهربائية (مثل الفوسفور أو فلز))",
 "窒化硼素": "نيتريد البورون\nمثال: نيتريد البورون له استخدام محتمل في تقنية النانو",
 "窒塞": "مَسْدُود تَمَامًا, مُغْلَق (مسدود أو مغلق بالكامل) / مُغْلَق أَمَام الحَرَكَة (مغلق أمام حركة المرور)",
 "窒息": "اختناق, خنق (القتل عن طريق الحرمان من الأكسجين) / اختناق (حالة الحرمان من الأكسجين (كما في توقف التنفس))\nمثال: يستخدم الاختناق أحياناً كشكل من أشكال التعذيب",
 "窒息性": "خَنَّاق, كَاتِم لِلْأَنْفَاس (يُسَبِّب صُعُوبَة فِي التَّنَفُّس خَاصَّةً بِسَبَب نَقْص الهَوَاء النَّقِيّ)",
 "窒素中毒": "تخدير النيتروجين, سكر الأعماق (حالة تشوش أو ذهول تسببها مستويات عالية من النيتروجين المذاب في الدم)\nمثال: يمكن للغواصين في المياه العميقة أن يعانوا من تخدير النيتروجين جراء تنفس الهواء تحت ضغط عالٍ",
 "窒素固定": "تثبيت النيتروجين (استيعاب بكتيريا التربة للنيتروجين الجوي وإطلاقه لاستخدام النبات عند موت البكتيريا)",
 "窒素固定法": "تثبيت النيتروجين (استيعاب بكتيريا التربة للنيتروجين الجوي وإطلاقه لاستخدام النبات عند موت البكتيريا)",
 "窒素循環": "دورة النيتروجين (دورة النيتروجين؛ تمتص النباتات النترات من التربة، وتأكلها الحيوانات التي تموت وتتحلل لتعيد النيتروجين إلى التربة)",
 "窒素酸化物": "أكسيد النيتروجين (أي من أكاسيد النيتروجين المتعددة التي تتكون بفعل حمض النيتريك على المواد القابلة للأكسدة؛ موجودة في عوادم السيارات)",
 "窓": "نَافِذَة, شُبَّاك / نَافِذَة, ويندو",
 "窓の桟": "إِطَار النَافِذَة",
 "窓ガラス": "لوح الزجاج, ويندوبين (سمكة مفلطحة شفافة رقيقة جداً في ساحل المحيط الأطلسي لأمريكا الشمالية) / زجاج النافذة, لوح النافذة (لوح من الزجاج في نافذة)\nمثال: حطمت الكرة زجاج النافذة",
 "窓付き": "نَافِذَة, شُبَّاك / نَافِذَة, ويندو",
 "窓付き封筒": "ظرف بنافذة (ظرف به لوحة شفافة تكشف العنوان الموجود على المرفق)",
 "窓側": "نَافِذَة, شُبَّاك / نَافِذَة, ويندو",
 "窓側席": "مقعد النافذة (مقعد أو مجلس مشابه مبني داخل تجويف النافذة)",
 "窓口": "عَدَّاد",
 "窓台": "عتبة النافذة (العتبة أو الجزء الأفقي في أسفل إطار النافذة)",
 "窓外投擲": "الرَّمْيُ مِنَ النَّافِذَة",
 "窓外放出": "الرَّمْيُ مِنَ النَّافِذَة",
 "窓外放擲": "الرَّمْيُ مِنَ النَّافِذَة",
 "窓掛": "سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة أو منع أشعة الشمس)",
 "窓掛け": "سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة أو منع أشعة الشمس)",
 "窓枠": "إِطَار النَافِذَة",
 "窓牖": "نَافِذَة, شُبَّاك / نَافِذَة, ويندو",
 "窓硝子": "لوح الزجاج, ويندوبين (سمكة مفلطحة شفافة رقيقة جداً في ساحل المحيط الأطلسي لأمريكا الشمالية) / زجاج النافذة, لوح النافذة (لوح من الزجاج في نافذة)\nمثال: حطمت الكرة زجاج النافذة",
 "窓紗": "سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة أو منع أشعة الشمس)",
 "窓表示域変換": "نَافِذَة, شُبَّاك / نَافِذَة, ويندو",
 "窓貝": "محار النافذة (ذوات صدفتين بحرية شائعة في المياه الساحلية الفلبينية تتميز بصدفة شفافة مسطحة رقيقة كبيرة)",
 "窓間壁": "رَصِيف",
 "窖": "قَبْو, سِرْدَاب",
 "窘める": "قَرَّعَ, وَبَّخَ (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "窟": "كَهْف, غَار",
 "窩主買": "سُور / سِيَاج",
 "窩主買い": "سُور / سِيَاج",
 "窪": "أَجْوَف / مَهْبَل / مَهْبِل / فَرْج / ڤاچاينا",
 "窪まる": "انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته)",
 "窪み": "أَجْوَف\nمثال: 後ろのドアにへこみができた。 — لديهم بعجة في الباب الخلفي .",
 "窪む": "انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته)",
 "窪園": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "窪地": "أَجْوَف",
 "窪溜まり": "أَجْوَف",
 "窪田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "窮すれば通ず": "اَلْحَاجَة أَمّ اَلاِخْتِرَاع",
 "窮まり": "زائدة, طرف (جزء خارجي من الجسم يبرز منه) / طرف قاصي (ذلك الجزء من الطرف الأبعد عن الجذع) / حد أقصى, طرف (المنطقة أو النقطة الخارجية أو الأبعد) / أقصى درجات, غاية (أعظم أو أقصى درجة)\nمثال: من المهم الحفاظ على دفء الأطراف",
 "窮まる": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "窮み": "اِرْتِفَاع / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "窮みなき": "حَلَقِيّ, لَا نِهَائِيّ (مُتَّصِلُ الأَطْرَافِ بِحَيْثُ يُشَكِّلُ كُلًّا مُتَّصِلًا) / أَبَدِيّ, سَرْمَدِيّ (لَيْسَ لَهُ بِدَايَةٌ مَعْرُوفَةٌ وَلَا نِهَايَةٌ مُفْتَرَضَةٌ) / لَا نِهَائِيّ, لَا يُحْصَى (عَظِيمٌ بِلَا حُدُودٍ فِي العَدَدِ) / لَا نِهَائِيّ, لَا يَنْتَهِي (طَويل بِشَكْل مُمِلّ؛ يَبْدو بِلا نِهايَة)",
 "窮み無き": "حَلَقِيّ, لَا نِهَائِيّ (مُتَّصِلُ الأَطْرَافِ بِحَيْثُ يُشَكِّلُ كُلًّا مُتَّصِلًا) / أَبَدِيّ, سَرْمَدِيّ (لَيْسَ لَهُ بِدَايَةٌ مَعْرُوفَةٌ وَلَا نِهَايَةٌ مُفْتَرَضَةٌ) / لَا نِهَائِيّ, لَا يُحْصَى (عَظِيمٌ بِلَا حُدُودٍ فِي العَدَدِ) / لَا نِهَائِيّ, لَا يَنْتَهِي (طَويل بِشَكْل مُمِلّ؛ يَبْدو بِلا نِهايَة)",
 "窮乏": "فَقْر (بمعنى شقّ وحزّ؛ الشقّ والحزّ؛ الهمّ والحرص، يُجمع جَمْع تَكْسِير على فُقُور)\nمثال: الفقر والفرعنة.",
 "窮余": "زائدة, طرف (جزء خارجي من الجسم يبرز منه) / طرف قاصي (ذلك الجزء من الطرف الأبعد عن الجذع) / حد أقصى, طرف (المنطقة أو النقطة الخارجية أو الأبعد) / أقصى درجات, غاية (أعظم أو أقصى درجة)\nمثال: من المهم الحفاظ على دفء الأطراف",
 "窮余の一策": "إجراء يائس (إجراءات يائسة تتخذ كوسيلة لغاية)\nمثال: اضطر للجوء إلى إجراءات يائسة",
 "窮余の策": "إجراء يائس (إجراءات يائسة تتخذ كوسيلة لغاية)\nمثال: اضطر للجوء إلى إجراءات يائسة",
 "窮地": "مُعْضِلَة / مِحْنَة",
 "窮境": "مأزق, ورطة (موقف يصعب الخلاص منه، خاصة إذا كان مزعجاً أو شاقاً)\nمثال: وجد نفسه في مأزق محرج للغاية",
 "窮屈": "ضَيِّق / رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي. / قَسْرِيّ, مُتَكَلَّف (يفتقر إلى العفوية؛ غير طبيعي)",
 "窮民": "فقراء (الناس الذين ليس لديهم ممتلكات أو ثروة (يُعتبرون كمجموعة))\nمثال: فقراء الحضر بحاجة للمساعدة",
 "窮状": "مِحْنَة",
 "窮理学": "فِيزِيَاء, فِيزِيقَا (علم الطَّبيعة أو علم الطَّبيعيَّات)\nمثال: تدرس الفيزياء النووية.",
 "窮策": "إجراء يائس (إجراءات يائسة تتخذ كوسيلة لغاية)\nمثال: اضطر للجوء إلى إجراءات يائسة",
 "窮迫": "مِحْنَة",
 "窮追": "فِي مَأْزِق, مُحَاصَر (مُجْبَر عَلَى مُوَاجَهَة المُهَاجِمِين دُونَ مَفَرّ)",
 "窮陰": "النِهاية",
 "窯": "مَوْقِد, مِدْفَأَة / مَوْقِد",
 "窯元": "فَخَّار, خَزَف / مَتْجَر الْفَخَّارِيَّات, مَحَلّ الْفَخَّارِيَّات / صِنَاعَة الفَخَّار (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة. / خَزَّاف",
 "窯業": "خزف, فن الخزف (فن صنع وزخرفة الفخار)",
 "窶れ": "عظمية, هزال شديد (نحافة شديدة (عادة بسبب الجوع أو المرض))",
 "窺い知る": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه.",
 "窺う": "اختلاس النظر, تلصص (نظرة سرية) / زقزقة, صوصوة (الصوت الضعيف القصير لطائر صغير) / اِنْتَظَرَ, اِسْتَأْنَى (تَرَقَّبَ؛ تَوَقَّعَ)\nمثال: انتظر حتى أجلس. / خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\".",
 "窺知": "استدلال (التفكير المتضمن في استخلاص نتيجة أو إصدار حكم منطقي بناءً على أدلة ظرفية واستنتاجات سابقة بدلاً من الملاحظة المباشرة)",
 "窺見": "اكتشاف, رصد (فعل اكتشاف شيء ما؛ أو ملاحظة شيء ما) / تجسس, عمل سري (فعل المراقبة السرية لأغراض استخباراتية) / تجسس (الحفاظ على مراقبة سرية أو خفية)",
 "竃": "مَوْقِد, مِدْفَأَة / مَوْقِد / أسرة, عائلة (وحدة اجتماعية تعيش معًا)\nمثال: نقل عائلته إلى فيرجينيا / كانون",
 "竃突": "كانون",
 "竄する": "نَفْي, تَبْعِيد / نَفَى",
 "竄定": "تنقيح, مراجعة (فعل إعادة كتابة شيء ما)",
 "竈": "مَوْقِد, مِدْفَأَة / مَوْقِد / أسرة, عائلة (وحدة اجتماعية تعيش معًا)\nمثال: نقل عائلته إلى فيرجينيا / كانون",
 "竈突": "كانون",
 "竈風呂": "حمام بخار, حمام تركي (التعرق في غرفة بخار قبل الحصول على تدليك ودش بارد) / حمام بخار, غرفة بخار (غرفة يمكن ملؤها بالبخار يستحم فيها الناس)",
 "立": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)",
 "立たす": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "立ち": "رَحِيل, مُغَادَرَة / انتكاس, تراجع (فشل في الحفاظ على حالة أعلى) / سهو, غفلة (خطأ ناتج عن عدم الانتباه) / انقضاء, فترة انقطاع (استراحة أو توقف في حدوث شيء ما)\nمثال: فترة انقطاع لمدة ثلاثة أسابيع بين الرسائل / بَرُوفَة",
 "立ちかわる": "متبادل (للأوراق والفروع ونحوها؛ تظهر أولاً على جانب ثم على الآخر في صفين على طول المحور؛ غير مزدوجة) / بَدِيل (يُستخدَم أو يَخدُم مكان شيء آخر) / بَدِيل, عِوَض (شخص يأخذ مكان شخص آخر)\nمثال: سيقان بأوراق متبادلة",
 "立ちくらみ": "دُوَار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "立ちこめる": "كفن",
 "立ちづめ": "مَنْزِلَة, مَكَانَة",
 "立ちどころに": "حَالاً (مباشرةً، فوراً، دون تأخير؛ في هذه الأثناء، في الوضع الحالي)\nمثال: سأكون معك حالا.",
 "立ちなおる": "شُفِيَ, بَرِئَ",
 "立ちゆく": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "立ちんぼ": "عاهرة شوارع (عاهرة تجذب الزبائن بالمشي في الشوارع) / سَائِل / فَقِير / مُخبر المراهنات (شخص يبيع النصائح حول المقامرة أو المضاربة (خاصة في سباق الخيل)) / دلال, سمسار (شخص يعلن للزبائن بطريقة وقحة بشكل خاص) / بائع تذاكر في السوق السوداء (شخص يشتري تذاكر لحدث ما لإعادة بيعها بربح) / عقار مُساء استخدامه, مخدرات (عقار يتم تناوله لأسباب غير طبية (عادةً لتأثيراته المغيرة للحالة العقلية)؛ يمكن أن يؤدي تعاطي المخدرات إلى أضرار جسدية وعقلية وإلى الاعتماد والإدمان…)",
 "立ちん坊": "عاهرة شوارع (عاهرة تجذب الزبائن بالمشي في الشوارع) / سَائِل / فَقِير / مُخبر المراهنات (شخص يبيع النصائح حول المقامرة أو المضاربة (خاصة في سباق الخيل)) / دلال, سمسار (شخص يعلن للزبائن بطريقة وقحة بشكل خاص) / بائع تذاكر في السوق السوداء (شخص يشتري تذاكر لحدث ما لإعادة بيعها بربح) / عقار مُساء استخدامه, مخدرات (عقار يتم تناوله لأسباب غير طبية (عادةً لتأثيراته المغيرة للحالة العقلية)؛ يمكن أن يؤدي تعاطي المخدرات إلى أضرار جسدية وعقلية وإلى الاعتماد والإدمان…)",
 "立ち上がり": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "立ち上がる": "قَامَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه. / شُفِيَ, بَرِئَ / نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / بالإضافة إلى ذلك, علاوة على ذلك (بالإضافة؛ علاوة على ذلك)\nمثال: يعمل بالإضافة إلى ذلك كمدير تنفيذي",
 "立ち上げる": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / بالإضافة إلى ذلك, علاوة على ذلك (بالإضافة؛ علاوة على ذلك)\nمثال: يعمل بالإضافة إلى ذلك كمدير تنفيذي",
 "立ち上り": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "立ち上る": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "立ち下がり": "نَخْر / اضمحل / تضعضع",
 "立ち並ぶ": "خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "立ち交じる": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر.",
 "立ち仕事": "يَتَطَلَّب الوُقُوف (يستلزم وضعيَّة الوقوف)",
 "立ち代る": "متبادل (للأوراق والفروع ونحوها؛ تظهر أولاً على جانب ثم على الآخر في صفين على طول المحور؛ غير مزدوجة) / بَدِيل (يُستخدَم أو يَخدُم مكان شيء آخر) / بَدِيل, عِوَض (شخص يأخذ مكان شخص آخر)\nمثال: سيقان بأوراق متبادلة",
 "立ち代わる": "متبادل (للأوراق والفروع ونحوها؛ تظهر أولاً على جانب ثم على الآخر في صفين على طول المحور؛ غير مزدوجة) / بَدِيل (يُستخدَم أو يَخدُم مكان شيء آخر) / بَدِيل, عِوَض (شخص يأخذ مكان شخص آخر)\nمثال: سيقان بأوراق متبادلة",
 "立ち会い": "حُضُور (حُضُور)\nمثال: الحضور هام جدا. / إسقاط القرص, مواجهة البدء ((هوكي الجليد) طريقة بدء اللعب؛ حيث يسقط الحكم القرص بين لاعبين متنافسين) / مجابهة, مواجهة (خلاف عدائي وجهاً لوجه)",
 "立ち会う": "حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً؛ ويُعَدَّى فَيُقَالُ: حَضَرَه وحَضِرَه؛ حَضَرَ، كنَصَرَ وعلِمَ، حُضُورًا وحضارَةً: ضِدُّ غابَ)\nمثال: حضر كل شيئ لرحلتي.",
 "立ち位置": "مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث.",
 "立ち入り": "دخول (فعل الدخول) / دخول (حركة إلى الداخل أو نحو الباطن)\nمثال: قامت بدخول مهيب",
 "立ち入り検査": "في الموقع, ميداني (يحدث أو يقع في الموقع نفسه)\nمثال: تفتيش ميداني",
 "立ち入り禁止": "مَمْنُوع الدُّخُولُ / مَحْظُور, مَمْنُوعُ الدُّخُول (محظور على مجموعة مُعيَّنة)",
 "立ち入り禁止区域": "منطقة محظورة (منطقة خطرة أو يستحيل دخولها أو يُحظر الدخول إليها)",
 "立ち入る": "أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى. / عتلة, مِخْل (رافعة حديدية ثقيلة أحد طرفيها مُشَكَّل كإسفين)",
 "立ち到る": "بَلَغَ",
 "立ち勝る": "فَاقَ, تَجَاوَزَ",
 "立ち去る": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "立ち合い": "حُضُور (حُضُور)\nمثال: الحضور هام جدا. / إسقاط القرص, مواجهة البدء ((هوكي الجليد) طريقة بدء اللعب؛ حيث يسقط الحكم القرص بين لاعبين متنافسين) / مجابهة, مواجهة (خلاف عدائي وجهاً لوجه)",
 "立ち向かう": "عَارَض (فلانٌ: أخذ في ناحية من الطريق؛ فلانا: باراه وأتى بمثل ما أتى به) / اِعْتَرَضَ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ: حَالَ بينه وبين ما يريد، أو وقف في طريقه)\nمثال: جميع من حضر عارض تلك الخطة.",
 "立ち回り": "عَارَكَ, قَاتَلَ / تَعَارَكَ, تَقَاتَلَ / نَاضَلَ, كَافَحَ / قِتَال (من قَتَلَ: كثير القَتْل) / مَعْرَكَة\nمثال: لن يحل القتال أي شيء. / تَجَوُّل, تَنَزُّه / تَجَوَّلَ, تَنَزَّهَ",
 "立ち回り先": "مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة",
 "立ち回る": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / مَثَّلَ (الشَبَه؛ النَظِير) / تَصَرَّفَ\nمثال: المهم هو العمل. / شِجَار صَاخِب (قتال صاخب وسط حشد من الناس) / حفلة صاخبة (حفلة صاخبة أو مليئة بالضجيج والمرح)",
 "立ち売り": "جَوَّال, بَائِع مُتَجَوِّل (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان لآخر)\nمثال: اشتريت جوال مستعمل.",
 "立ち寄り温泉": "يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "立ち寄る": "اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني.",
 "立ち居": "حَرَكَة",
 "立ち居振る舞い": "حَرَكَة",
 "立ち居振舞い": "حَرَكَة",
 "立ち席": "أَمَاكِن وُقُوف (مساحة للركاب أو المتفرجين للوقوف)\nمثال: كان هناك أماكن وقوف لآلاف الأشخاص الإضافيين",
 "立ち席のみ": "أَمَاكِن وُقُوف (مساحة للركاب أو المتفرجين للوقوف)\nمثال: كان هناك أماكن وقوف لآلاف الأشخاص الإضافيين",
 "立ち帰る": "عَادَ, رَجَعَ (رَجَعَ)\nمثال: هل عاد توم حقا؟",
 "立ち往生": "تعطيل, مماطلة (تكتيك يستخدم للتضليل أو التأخير)",
 "立ち戻る": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "立ち振る舞い": "حَرَكَة",
 "立ち振る舞う": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / مَثَّلَ (الشَبَه؛ النَظِير) / تَصَرَّفَ\nمثال: المهم هو العمل.",
 "立ち振舞い": "حَرَكَة",
 "立ち振舞う": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / مَثَّلَ (الشَبَه؛ النَظِير) / تَصَرَّفَ\nمثال: المهم هو العمل.",
 "立ち方": "رَاقِص, رَاقِصَة",
 "立ち昇る": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "立ち替わる": "متبادل (للأوراق والفروع ونحوها؛ تظهر أولاً على جانب ثم على الآخر في صفين على طول المحور؛ غير مزدوجة) / بَدِيل (يُستخدَم أو يَخدُم مكان شيء آخر) / بَدِيل, عِوَض (شخص يأخذ مكان شخص آخر)\nمثال: سيقان بأوراق متبادلة",
 "立ち枯れ": "فَاسِد, مُصَاب بِالآفَة (أَصَابَهُ تَلَفٌ يُعِيقُ النُّمُوَّ أَوِ الازْدِهَار)",
 "立ち枯れ病": "لفحة (أي مرض نباتي يؤدي إلى الذبول دون تعفن) / آفة, لفحة (حالة أو وضع الإصابة بآفة)",
 "立ち止まる": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "立ち泳ぎ": "الطفو العمودي, مراوحة الماء (ضربة تبقي الرأس فوق الماء عن طريق تحريك الساقين والذراعين)",
 "立ち消える": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "立ち混じる": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر.",
 "立ち番": "حَارِس, خَفِير",
 "立ち直り": "شِفَاء, تَعَافِي",
 "立ち直る": "شُفِيَ, بَرِئَ",
 "立ち眩み": "دُوَار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "立ち稽古": "بَرُوفَة",
 "立ち聞き": "تَنَصُّت, اِسْتِرَاق سَمْع / تَنَصُّت",
 "立ち聞く": "تَنَصَّتَ, تَسَمَّعَ",
 "立ち腐れ": "تداعي, خراب (عملية التحول إلى حالة متداعية) / تداعي, تهالك (حالة تدهور بسبب الشيخوخة أو الاستخدام الطويل)",
 "立ち至る": "بَلَغَ",
 "立ち葵": "ختمية (أي من نباتات طويلة متنوعة من جنس ألسيا؛ موطنها الشرق الأوسط ولكنها توطنت وزرعت على نطاق واسع لزهورها الكبيرة جداً والمتنوعة الألوان) / ألثيا, ختمية (أي من نباتات متنوعة من جنس ألثيا؛ تشبه ولكن بزهور أصغر من جنس ألسيا)",
 "立ち行く": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "立ち襟": "يَتَطَلَّب الوُقُوف (يستلزم وضعيَّة الوقوف)",
 "立ち見客": "ستاندي, مجسم كرتوني (مجسم مفرغ من الورق المقوى بالحجم الطبيعي (عادة لأحد المشاهير)) / واقف (شخص يقف في مكان قد يجلس فيه المرء (كمتفرج يستخدم مساحة الوقوف في مسرح أو راكب في حافلة أو قطار مزدحم))\nمثال: التقط صورته مع مجسم كرتوني للرئيس",
 "立ち見席": "أَمَاكِن وُقُوف (مساحة للركاب أو المتفرجين للوقوف)\nمثال: كان هناك أماكن وقوف لآلاف الأشخاص الإضافيين",
 "立ち詰め": "مَنْزِلَة, مَكَانَة",
 "立ち読み": "رعي, قضم الأوراق (فعل التغذية عن طريق القضم المستمر) / تصفح (القراءة بشكل سطحي أو عشوائي)",
 "立ち越える": "فَاقَ, تَجَاوَزَ / خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "立ち込める": "كفن",
 "立ち返る": "عَادَ, رَجَعَ (رَجَعَ)\nمثال: هل عاد توم حقا؟",
 "立ち退かせる": "أَجْلَى, طَرَدَ",
 "立ち退き": "طَرْد",
 "立ち退く": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / أخْلَا / أبْطَلَ, نَحّى\nمثال: لقد ترك لك هذا.",
 "立ち食いそば": "يَتَطَلَّب الوُقُوف (يستلزم وضعيَّة الوقوف)",
 "立ち食い蕎麦": "يَتَطَلَّب الوُقُوف (يستلزم وضعيَّة الوقوف)",
 "立った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "立っち": "مَنْزِلَة, مَكَانَة",
 "立っ端": "اِرْتِفَاع",
 "立つ": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / غَادَرَ, رَحَلَ (تَرَكَ)\nمثال: غادر سامي للتو.",
 "立て": "مَرْكَزِيّ / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل / بشكل خاص, تحديداً (بدرجة أكبر بوضوح مما هو شائع) / بِتَمَيُّز, بِشَكْل خَاصّ (بشكل فريد أو مميز) / تَحْدِيدًا, عَلَى وَجْه الخُصُوص (مميز بشكل خاص عن الآخرين)\nمثال: كان دقيقاً بشكل خاص حول التهجئة",
 "立てこもる": "مَسَكَ, مسك",
 "立てて": "خُصُوصًا, خَاصَّةً",
 "立てなおす": "اِسْتَعَادَ / تنقيح, مراجعة (فعل إعادة كتابة شيء ما)",
 "立てる": "مُنْتَصِب, مُنْتَفِخ (مُتَصَلِّب ومُنْتَفِخ؛ في حالَة انْتِصاب) / قائم, منتصب (في وضع مستقيم أو وضعية قائمة)\nمثال: قامة منتصبة / فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟ / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "立て付け": "تجربة الملابس, قياس (ارتداء الملابس لمعرفة ما إذا كانت مناسبة) / لَائِق, مُنَاسِب (مطابق تماماً وصحيح) / مَعْقُول, مُلَائِم (يتناغم مع روح الأشخاص أو المناسبة المعنيّة) / تجهيزات, مستلزمات ((عادة بصيغة الجمع) المفروشات والمعدات (خاصة لسفينة أو فندق)) / تولي, خلافة (اكتساب الممتلكات عن طريق النسب أو الوصية) / تتابع, تسلسل (فعل التتابع بالترتيب) / تسلسل, تعاقب (تتابع شيء بعد آخر في الوقت) / تتابع, تعاقب (مجموعة من الأشخاص أو الأشياء مرتبة أو متتابعة بالترتيب)\nمثال: لعب الأوراق الرابحة بالتسلسل",
 "立て前": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / سَادُو, طُقُوس اَلشَّاي",
 "立て坑": "قصبة الريشة (العمود الفقري المجوف للريشة) / عمود دوار, عمود نقل الحركة (قضيب دوار ينقل الطاقة أو الحركة) / سارية, عمود (قضيب أو عمود طويل (خاصة مقبض أداة أو جسم سلاح مثل الرمح أو السهم)) / بئر, عمود (ممر رأسي طويل محفور في الأرض، كما لمنجم أو نفق)",
 "立て役": "بَطَل, بَطَلَة / مُتَصَدِّر",
 "立て役者": "إِجَّامَة / نَجْمَة",
 "立て替え金": "يقرب",
 "立て札": "لَوْحَة إِعْلَانَات",
 "立て板に水": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "立て物": "قَائِد, زَعِيم",
 "立て直し": "أَحْيَا, أَجَدَّ",
 "立て直す": "اِسْتَعَادَ / تنقيح, مراجعة (فعل إعادة كتابة شيء ما)",
 "立て直る": "شُفِيَ, بَرِئَ",
 "立て看": "أَفِيش / لَوْحَة / لَافِتَة / يَافِطَة / لَوْحَة إعْلَانِيَّة / لَوْحَة إِعْلَانَات",
 "立て看板": "أَفِيش / لَوْحَة / لَافِتَة / يَافِطَة / لَوْحَة إعْلَانِيَّة / لَوْحَة إِعْلَانَات",
 "立て石": "حجر الميل, معلم المسافة (عمود حجري بجانب الطريق لإظهار المسافات) / إنجاز مرحلي, حدث بارز (حدث مهم في حياتك (أو في مشروع)) / قائمة حجرية, منهير (ميغاليث عمودي طويل؛ يوجد بشكل أساسي في إنجلترا وشمال فرنسا) / شاهد قائم (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ)\nمثال: شاهد هذا الفيلم.",
 "立て篭もる": "مَسَكَ, مسك",
 "立て籠もる": "مَسَكَ, مسك",
 "立て続け": "تولي, خلافة (اكتساب الممتلكات عن طريق النسب أو الوصية) / تتابع, تسلسل (فعل التتابع بالترتيب) / تسلسل, تعاقب (تتابع شيء بعد آخر في الوقت) / تتابع, تعاقب (مجموعة من الأشخاص أو الأشياء مرتبة أو متتابعة بالترتيب)\nمثال: لعب الأوراق الرابحة بالتسلسل",
 "立上がり": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "立上り": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "立並ぶ": "خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "立会": "حُضُور (حُضُور)\nمثال: الحضور هام جدا. / إسقاط القرص, مواجهة البدء ((هوكي الجليد) طريقة بدء اللعب؛ حيث يسقط الحكم القرص بين لاعبين متنافسين) / مجابهة, مواجهة (خلاف عدائي وجهاً لوجه)",
 "立会い": "حُضُور (حُضُور)\nمثال: الحضور هام جدا. / إسقاط القرص, مواجهة البدء ((هوكي الجليد) طريقة بدء اللعب؛ حيث يسقط الحكم القرص بين لاعبين متنافسين) / مجابهة, مواجهة (خلاف عدائي وجهاً لوجه)",
 "立会う": "حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً؛ ويُعَدَّى فَيُقَالُ: حَضَرَه وحَضِرَه؛ حَضَرَ، كنَصَرَ وعلِمَ، حُضُورًا وحضارَةً: ضِدُّ غابَ)\nمثال: حضر كل شيئ لرحلتي.",
 "立会人": "شَهَادَة / شَاهِد, شَاهِدَة (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَاهِد, شَوَاهِد (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَهِدَ (شَهَدَ؛ شُهِدَ)\nمثال: شاهد هذا الفيلم.",
 "立会外取引": "بَعْدَ سَاعَاتِ العَمَل (بعد موعد الإغلاق خاصة الإغلاق المحدّد قانونياً)",
 "立位置": "مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث.",
 "立体": "ثُلَاثِيُّ الْأَبْعَادِ",
 "立体交差": "تقاطع منفصل المستويات (معبر يستخدم نفقاً أو جسراً علوياً)",
 "立体地図": "ثُلَاثِيُّ الْأَبْعَادِ",
 "立体幾何学": "هندسة فراغية (هندسة الفضاء ثلاثي الأبعاد)",
 "立体性": "ثلاثية الأبعاد (خاصية امتلاك ثلاثة أبعاد)",
 "立体感": "ثلاثية الأبعاد (خاصية امتلاك ثلاثة أبعاد)",
 "立体戦": "ثُلَاثِيُّ الْأَبْعَادِ",
 "立体映像": "تجسيم, رؤية مجسمة (رؤية ثلاثية الأبعاد ناتجة عن دمج مشهدين مختلفين قليلاً على كل شبكية)",
 "立体映画": "ثُلَاثِيُّ الْأَبْعَادِ",
 "立体派": "تَكْعِيبِيَّة",
 "立体異性体": "متصاوغ فراغي (أي من مجموعة من المتصاوغات التي ترتبط فيها الذرات بنفس الترتيب ولكن تختلف في ترتيبها الفراغي)",
 "立体的": "ثُلَاثِيُّ الْأَبْعَادِ",
 "立体裁断": "ستارة, سِتر (قماش معلق يستخدم كحاجز (خاصة للنافذة)) / ستارة معقمة, غطاء جراحي (غطاء معقم يوضع فوق جسم المريض أثناء الفحص الطبي أو الجراحة لتقليل احتمالية التلوث) / انسدال (الطريقة التي يتدلى بها القماش أو يسقط)\nمثال: عدلت انسدال تنورتها",
 "立体視": "تجسيم, رؤية مجسمة (رؤية ثلاثية الأبعاد ناتجة عن دمج مشهدين مختلفين قليلاً على كل شبكية)",
 "立体角": "زاوية مجسمة (زاوية مشكلة من ثلاثة مستويات أو أكثر تتقاطع عند نقطة مشتركة (الرأس))",
 "立体角密度": "إشعاع, بهاء (صفة كون الشيء ساطعاً ويرسل أشعة ضوئية) / تألق, توهج (كمية الإشعاع الكهرومغناطيسي التي تغادر أو تصل إلى نقطة على سطح ما) / تألق (مزيج جذاب من الصحة الجيدة والسعادة)\nمثال: تألق محياها",
 "立体配座": "اِمْتِثَال, تَوَافُق (التصرف وفقاً لمعايير معينة مقبولة) / بنية, تكوين (أي سمات مكانية (خاصة كما يحددها المخطط الخارجي)) / بنية, تشكيل (ترتيب متماثل لأجزاء الشيء)\nمثال: بياناتهم المالية متوافقة مع الممارسات المحاسبية المقبولة عموماً",
 "立体配置": "تَهايُؤ",
 "立体鏡": "ستيريوسكوب, منظار مجسم (جهاز بصري لعرض الصور المجسمة)",
 "立体音響": "ثُلَاثِيُّ الْأَبْعَادِ",
 "立候補": "حملة انتخابية (حملة المرشح ليتم انتخابه)",
 "立候補者": "مُرَشَّح / مُرَشَّحَة",
 "立入": "دخول (فعل الدخول) / دخول (حركة إلى الداخل أو نحو الباطن)\nمثال: قامت بدخول مهيب",
 "立入り": "دخول (فعل الدخول) / دخول (حركة إلى الداخل أو نحو الباطن)\nمثال: قامت بدخول مهيب",
 "立入り検査": "في الموقع, ميداني (يحدث أو يقع في الموقع نفسه)\nمثال: تفتيش ميداني",
 "立入る": "أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى. / عتلة, مِخْل (رافعة حديدية ثقيلة أحد طرفيها مُشَكَّل كإسفين)",
 "立入検査": "في الموقع, ميداني (يحدث أو يقع في الموقع نفسه)\nمثال: تفتيش ميداني",
 "立入禁止": "مَمْنُوع الدُّخُولُ / مَحْظُور, مَمْنُوعُ الدُّخُول (محظور على مجموعة مُعيَّنة)",
 "立入禁止区域": "منطقة محظورة (منطقة خطرة أو يستحيل دخولها أو يُحظر الدخول إليها)",
 "立入調査": "في الموقع, ميداني (يحدث أو يقع في الموقع نفسه)\nمثال: تفتيش ميداني",
 "立前": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / سَادُو, طُقُوس اَلشَّاي",
 "立勝る": "فَاقَ, تَجَاوَزَ",
 "立去る": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "立命": "سَكِينَة, طُمَأْنِينَة",
 "立回り": "عَارَكَ, قَاتَلَ / تَعَارَكَ, تَقَاتَلَ / نَاضَلَ, كَافَحَ / قِتَال (من قَتَلَ: كثير القَتْل) / مَعْرَكَة\nمثال: لن يحل القتال أي شيء. / تَجَوُّل, تَنَزُّه / تَجَوَّلَ, تَنَزَّهَ",
 "立回り先": "مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة",
 "立回る": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / مَثَّلَ (الشَبَه؛ النَظِير) / تَصَرَّفَ\nمثال: المهم هو العمل. / شِجَار صَاخِب (قتال صاخب وسط حشد من الناس) / حفلة صاخبة (حفلة صاخبة أو مليئة بالضجيج والمرح)",
 "立地": "زاوية نظر, منظور (موقف ذهني يتم من خلاله النظر إلى الأشياء)\nمثال: يجب أن ننظر في هذه المشكلة من وجهة نظر الروس",
 "立坑": "قصبة الريشة (العمود الفقري المجوف للريشة) / عمود دوار, عمود نقل الحركة (قضيب دوار ينقل الطاقة أو الحركة) / سارية, عمود (قضيب أو عمود طويل (خاصة مقبض أداة أو جسم سلاح مثل الرمح أو السهم)) / بئر, عمود (ممر رأسي طويل محفور في الأرض، كما لمنجم أو نفق)",
 "立型ピアノ": "بيانو عمودي, بيانو قائم (بيانو ذو لوحة صوتية رأسية)",
 "立場": "مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث. / زاوية نظر, منظور (موقف ذهني يتم من خلاله النظر إلى الأشياء) / مطل, نقطة مراقبة (مكان يمكن رؤية شيء ما منه)\nمثال: يجب أن ننظر في هذه المشكلة من وجهة نظر الروس",
 "立壁": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
