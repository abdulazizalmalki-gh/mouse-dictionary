 "稲荷": "ثَعْلَب (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر) / تعلب / ثعلب (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر)\nمثال: أردى الصياد الثعلب.",
 "稲葉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "稲見": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "稷": "دَخْن (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن) / ملَة, مل\nمثال: دخن زيري سيجارة.",
 "稼ぎ": "أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات غير النقدية الأخرى)) / أجر, راتب (شيء يُدفع كمقابل للعمل)\nمثال: دُفعت الأجور نقداً",
 "稼ぎだす": "كَسَبَ",
 "稼ぎ主": "مُعِيل, عَائِل",
 "稼ぎ人": "مُعِيل, عَائِل",
 "稼ぎ出す": "كَسَبَ",
 "稼ぎ手": "مُعِيل, عَائِل",
 "稼ぎ時": "متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية)\nمثال: قضينا وقتاً ممتعاً في الحفلة",
 "稼ぎ頭": "مُعِيل, عَائِل",
 "稼ぎ高": "أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات غير النقدية الأخرى)) / أجر, راتب (شيء يُدفع كمقابل للعمل)\nمثال: دُفعت الأجور نقداً",
 "稼ぐ": "كَسَبَ / إِصَابَة (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى) / دَرَجَة\nمثال: تعرض زيري لإصابة. / شغل, عمل (عمل منتج (خاصة العمل البدني المنجز مقابل أجر)) / مسعى, مشروع (أي قطعة عمل يتم الاضطلاع بها أو محاولتها) / وزارة العمل (الإدارة الفيدرالية المسؤولة عن تعزيز ظروف عمل أصحاب الأجور في الولايات المتحدة؛ أنشئت عام 1913) / الطبقة العاملة, بروليتاريا (طبقة اجتماعية تضم الذين يقومون بعمل يدوي أو يعملون مقابل أجر)\nمثال: لم يتطلب عمله قدراً كبيراً من المهارة",
 "稼げる": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل.",
 "稼働": "عَمَلِيَّة, عَمَل / عَمَلِيَّة جِرَاحِيَّة, جِرَاحَة / عَمَلِيَّات, عَمَلِيَّة / تَشْغِيلِيّ, عَمَلِيّ (يُمكّن من العمل أو النشاط اللاحق أو يُسهّله) / كَافٍ لِلْعَمَل (ملائم للاستخدام العملي؛ كافٍ من حيث القوة أو العدد لإنجاز المطلوب) / أعمال تعدين, منجم عامل (منجم أو محجر يتم العمل فيه حالياً أو تم العمل فيه) / نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "稼働中": "تَشْغِيلِيّ, عَمَلِيّ (يُمكّن من العمل أو النشاط اللاحق أو يُسهّله) / كَافٍ لِلْعَمَل (ملائم للاستخدام العملي؛ كافٍ من حيث القوة أو العدد لإنجاز المطلوب) / أعمال تعدين, منجم عامل (منجم أو محجر يتم العمل فيه حالياً أو تم العمل فيه)",
 "稼働人口": "أيدي عاملة, قوة عاملة (قوة العمال المتاحة)",
 "稼働時間": "فترة العمل, وقت التشغيل (فترة زمنية يكون فيها شيء ما (كالآلة أو المصنع) قيد التشغيل ومتاحاً للاستخدام)",
 "稼働率": "مُعَدَّل الإِشْغَال (النسبة المئوية لجميع الوحدات المؤجرة (كما في الفنادق) التي تكون مشغولة أو مؤجرة في وقت معين)",
 "稼動": "عَمَلِيَّة, عَمَل / عَمَلِيَّة جِرَاحِيَّة, جِرَاحَة / عَمَلِيَّات, عَمَلِيَّة / تَشْغِيلِيّ, عَمَلِيّ (يُمكّن من العمل أو النشاط اللاحق أو يُسهّله) / كَافٍ لِلْعَمَل (ملائم للاستخدام العملي؛ كافٍ من حيث القوة أو العدد لإنجاز المطلوب) / أعمال تعدين, منجم عامل (منجم أو محجر يتم العمل فيه حالياً أو تم العمل فيه) / نَشْر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "稼動時間": "فترة العمل, وقت التشغيل (فترة زمنية يكون فيها شيء ما (كالآلة أو المصنع) قيد التشغيل ومتاحاً للاستخدام)",
 "稼動率": "مُعَدَّل الإِشْغَال (النسبة المئوية لجميع الوحدات المؤجرة (كما في الفنادق) التي تكون مشغولة أو مؤجرة في وقت معين)",
 "稼得": "كَسَبَ",
 "稼業": "تِجَارَة",
 "稼穡": "زراعة, عمل في الأرض (الزراعة باعتبارها مهنة أو أسلوب حياة) / زراعة, فلاحة (ممارسة زراعة الأرض أو تربية الماشية)\nمثال: الزراعة حياة شاقة",
 "稽古": "تَدْرِيب (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة) / مُمَارَسَة\nمثال: واصل زيري التدريب.",
 "稽古ごと": "تَنْفِيذ",
 "稽古をつける": "عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "稽古を付ける": "عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "稽古事": "تَنْفِيذ",
 "稽古場": "جمنازيوم, صالة ألعاب رياضية (منشأة رياضية مجهزة للرياضة أو التدريب البدني) / مدرسة ثانوية, مدرسة متوسطة (مدرسة للطلاب بين المدرسة الابتدائية والكلية؛ عادة الصفوف من 9 إلى 12)",
 "稽古着": "زَيّ, زِي",
 "稿": "مَخْطُوطَة (مُؤَلَّف المكتوب باليد ، غير المطبوع؛ نُسْخة المؤلِّلف الأصليَّة المُعدَّة للطبع) / مَخْطُوطَة, مَخْطُوط (مُؤَلَّف المكتوب باليد ، غير المطبوع؛ نُسْخة المؤلِّلف الأصليَّة المُعدَّة للطبع)",
 "稿する": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)",
 "稿本": "مَخْطُوطَة (مُؤَلَّف المكتوب باليد ، غير المطبوع؛ نُسْخة المؤلِّلف الأصليَّة المُعدَّة للطبع) / مَخْطُوطَة, مَخْطُوط (مُؤَلَّف المكتوب باليد ، غير المطبوع؛ نُسْخة المؤلِّلف الأصليَّة المُعدَّة للطبع)",
 "穀の木": "توت الورق (شجرة شجيرية آسيوية لها لحاء (تابا) يشبه القماش؛ تزرع كشجرة ظل في أوروبا وأمريكا؛ الزهور الذكرية هي نورات هرية متدلية والأنثوية جرة الشكل تليها ثمار…)",
 "穀倉": "مَخْزَن الْحُبُوب, شُونَة",
 "穀潰し": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "穀物": "حَبَة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / حُبُوب / تَجْزِيع, تَعْرِيق\nمثال: أكلت حبة طماطم.",
 "穀粉": "طَحِين, دَقِيق",
 "穀粒": "نَوَاة",
 "穀類": "حَبَة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / حُبُوب / تَجْزِيع, تَعْرِيق\nمثال: أكلت حبة طماطم.",
 "穂": "أُذُن (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / أُذْن (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / سُنْبُلَة / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: من أذن لتوم باستعارة سيارتي? / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / عرف الخوذة ((شعارات النبالة) في العصور الوسطى، شعار يستخدم لتزيين الخوذة) / تحدب الطريق, ظهر الطريق (منتصف طريق محدب) / ذروة, قمة (الخط العلوي لتل أو جبل أو موجة) / سليل (حفيد أو وريث)\nمثال: سليل أصل ملكي",
 "穂先": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "穂状花序": "سنبلة",
 "穂首": "سنبلة",
 "積": "مُنْتَج / سِلْعَة / حَاصِل (الشيء :حصل عليه) / مَحْصُول / حَاصِل ضَرْب (الشيء :حصل عليه) / جَدَاء / حَجْم (حجّم الشّيء:وضع حجماً محدّداً له ، قَلَّلَ دوره وهَمَّشَه، قلّل تأثيره؛ حجّم: نَظَرَ نظراً شديداً،ويُقال حجّم إليه) / جَهَارَة / مُجَلَّد, جُزْء\nمثال: ما حجم البالون؟",
 "積みすぎ": "حمل زائد (عبء مفرط) / حمل زائد (حمل كهربائي يتجاوز الطاقة الكهربائية المتاحة)",
 "積みすぎる": "حمل زائد (عبء مفرط) / حمل زائد (حمل كهربائي يتجاوز الطاقة الكهربائية المتاحة)",
 "積み上げる": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / حَصَلَ (الشيء: حَصَلَ عليه؛ العلم: أخَذَه وحَازَه) / اِكْتَسَبَ, كَسَبَ\nمثال: متى حصل الحادث؟",
 "積み出し": "إرسال, إيفاد (فعل إرسال شيء ما) / بضاعة منقولة, حمولة (بضائع تحملها مركبة كبيرة)",
 "積み出し人": "شركة شحن (شركة تعمل في مجال شحن البضائع) / شاحن (شخص يقوم بشحن البضائع)",
 "積み増し": "زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
 "積み増す": "زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
 "積み換え": "إعادة الشحن, شحن عابر (النقل من وسيلة نقل إلى أخرى للشحن)",
 "積み方": "ترتيب البضائع, تستيف (عملية التعبئة أو التخزين) / غرفة تخزين, مخزن (غرفة تُخزن فيها الأشياء) / أجرة التستيف, رسوم التستيف (الرسم لتستيف (تخزين وترتيب) البضائع)",
 "積み替え": "إعادة الشحن, شحن عابر (النقل من وسيلة نقل إلى أخرى للشحن)",
 "積み木": "كتلة بناء (كتلة من المواد المستخدمة في أعمال البناء) / لبنة أساسية, وحدة (شيء طبيعي مفرد غير مقسم يدخل في تكوين شيء آخر)",
 "積み残し": "تقريب, خطأ التقريب ((رياضيات) خطأ في الحساب ينتج عن تقريب الأرقام إلى عدد مناسب من الخانات العشرية)\nمثال: كان الخطأ في الحساب يعزى إلى التقريب",
 "積み石": "حجر الأساس (حجر يوضع في حفل لتدشين تأسيس مبنى جديد)",
 "積み立て": "خَصْم, حَسْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة) / مُدَخَرَات",
 "積み立てる": "أَنْقَذَ, أَنْجَى / اِدَّخَرَ / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "積み立て資金": "حساب احتياطي, صندوق احتياطي (أموال مقتطعة من الأرباح لتوفير المدفوعات المستقبلية المتوقعة)",
 "積み肥": "دبال, سماد عضوي (خليط من النباتات المتحللة والروث؛ يستخدم كسماد)",
 "積み荷": "حِمْل (رَفَعَ، أَقَلَّ) / عَبَّأَ, شَحَنَ\nمثال: حمل سامي سلاحه.",
 "積み荷目録": "ظَاهِر (اسم فاعل من ظَهَرَ هو الذي يَظْهَر على عدوه؛ ضد الباطن) / بَيَان (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل) / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: كل شئ ظاهر على وجهه.",
 "積み込み": "تحميل (عمل وضع حمولة من شيء ما على أو في مركبة أو سفينة أو حاوية، إلخ) / بضاعة منقولة, حمولة (بضائع تحملها مركبة كبيرة) / حمل, عبء (وزن يجب تحمله أو نقله) / حمل, حمولة (كمية يمكن معالجتها أو نقلها في وقت واحد)\nمثال: استغرق التحميل ساعتين",
 "積み込み場": "منطقة تحميل (محطة توقف حيث يمكن تحميل وتفريغ الناقلات)",
 "積み込む": "حِمْل (رَفَعَ، أَقَلَّ) / عَبَّأَ, شَحَنَ\nمثال: حمل سامي سلاحه.",
 "積み送り": "إرسال, إيفاد (فعل إرسال شيء ما) / بضاعة منقولة, حمولة (بضائع تحملها مركبة كبيرة)",
 "積み過ぎ": "حمل زائد (عبء مفرط) / حمل زائد (حمل كهربائي يتجاوز الطاقة الكهربائية المتاحة)",
 "積み過ぎる": "حمل زائد (عبء مفرط) / حمل زائد (حمل كهربائي يتجاوز الطاقة الكهربائية المتاحة)",
 "積み重ね": "كَوْم",
 "積み金": "حساب احتياطي, صندوق احتياطي (أموال مقتطعة من الأرباح لتوفير المدفوعات المستقبلية المتوقعة)",
 "積む": "كَوْمَة / كُومَة / حِمْل (رَفَعَ، أَقَلَّ) / عَبَّأَ, شَحَنَ\nمثال: حمل سامي سلاحه. / حَصَلَ (الشيء: حَصَلَ عليه؛ العلم: أخَذَه وحَازَه) / اِكْتَسَبَ, كَسَبَ\nمثال: متى حصل الحادث؟",
 "積もり": "قَصْد, إِرَادَة / اِعْتِقَاد / عَقِيدَة (المُعَاقِدَة، بمعنى اسم الفاعل؛ المعقودة، بمعنى اسم المفعول) / إيمان / تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء",
 "積もり積もる": "رَكِبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا من الدواب)\nمثال: ركب ياني سفينة.",
 "積もる": "تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء",
 "積り": "قَصْد, إِرَادَة / اِعْتِقَاد / عَقِيدَة (المُعَاقِدَة، بمعنى اسم الفاعل؛ المعقودة، بمعنى اسم المفعول) / إيمان / تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء",
 "積る": "تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء",
 "積乱雲": "ركام مزني, سحابة رعدية (سحابة داكنة ذات امتداد عمودي كبير مشحونة بالكهرباء؛ ترتبط بالعواصف الرعدية)",
 "積分": "مُكَامَلَة / صَحِيح / تَكَامُلِيّ",
 "積分器": "مقياس المساحة, مكامل (أداة قياس لقياس مساحة شكل مستوٍ غير منتظم)",
 "積分学": "حساب التكامل (جزء التفاضل والتكامل الذي يتعامل مع التكامل وتطبيقه في حل المعادلات التفاضلية وتحديد المساحات أو الأحجام)",
 "積分法": "مُكَامَلَة",
 "積増し": "زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
 "積増す": "زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا.",
 "積層": "صفيحة, مادة صفائحية (ورقة من مادة مصنوعة عن طريق ربط ورقتين أو أكثر أو طبقات)",
 "積年": "أيام, سنوات (الوقت الذي تستمر فيه حياة شخص ما) / أرذل العمر, شيخوخة (مرحلة متأخرة من الحياة) / دهر, سنوات (فترة زمنية طويلة)\nمثال: أيام الملك الأخيرة / عَرِيق, قَدِيم العَهْد (مَوْجود مُنْذُ فَتْرَة طَويلَة)",
 "積弊": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "積換え": "إعادة الشحن, شحن عابر (النقل من وسيلة نقل إلى أخرى للشحن)",
 "積替え": "إعادة الشحن, شحن عابر (النقل من وسيلة نقل إلى أخرى للشحن)",
 "積木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "積極": "نَشِيط, عَامِل / نَشِيط / حَرِك (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / فَارِه, حَرِك\nمثال: لقد أوقفنا حركة المرور. / مِصْعَد / أَنُود",
 "積極性": "تَوْكِيد الذَّات, حَزْم (ثقة بالنفس عدوانية؛ الميل إلى تقديم تأكيدات جريئة)",
 "積極果敢": "عُدْوَانِيّ / هُجُومِيّ",
 "積極的": "مُوجَب / إِيجَابِيّ / صُورَة مُوجَبَة",
 "積極行動主義": "نَشَاطِيَّة",
 "積極行動主義者": "نَاشِط, نَاشِطَة",
 "積極論": "إِيجَابِيَّة, يَقِين (صفة أو حالة تتميز باليقين أو القبول أو التأكيد والتوكيد الجازم) / وضعية, وضعية منطقية (شكل التجريبية الذي يبني كل المعرفة على التجربة الإدراكية (وليس على الحدس أو الوحي))",
 "積水": "مسطح مائي, مياه (جزء من سطح الأرض مغطى بالماء (مثل نهر أو بحيرة أو محيط))\nمثال: غزوا مياهنا الإقليمية",
 "積率": "عَزْم / لَحْظَة, دَقِيقَة",
 "積率相関係数": "معامل ارتباط العزم, معامل ارتباط بيرسون للعزم (الطريقة الأكثر استخداماً لحساب معامل الارتباط بين المتغيرات المرتبطة خطياً)",
 "積石": "حجر الأساس (حجر يوضع في حفل لتدشين تأسيس مبنى جديد)",
 "積立": "خَصْم, حَسْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة) / مُدَخَرَات",
 "積立て": "خَصْم, حَسْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة) / مُدَخَرَات",
 "積立てる": "أَنْقَذَ, أَنْجَى / اِدَّخَرَ / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "積立資金": "حساب احتياطي, صندوق احتياطي (أموال مقتطعة من الأرباح لتوفير المدفوعات المستقبلية المتوقعة)",
 "積立金": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "積算": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / مُكَامَلَة / تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء",
 "積算法": "مُكَامَلَة",
 "積算電力計": "واط ساعي (وحدة طاقة تساوي قدرة واط واحد تعمل لمدة ساعة واحدة)",
 "積荷": "حِمْل (رَفَعَ، أَقَلَّ) / عَبَّأَ, شَحَنَ\nمثال: حمل سامي سلاحه.",
 "積荷目録": "ظَاهِر (اسم فاعل من ظَهَرَ هو الذي يَظْهَر على عدوه؛ ضد الباطن) / بَيَان (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل) / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: كل شئ ظاهر على وجهه.",
 "積載": "تحميل (عمل وضع حمولة من شيء ما على أو في مركبة أو سفينة أو حاوية، إلخ) / بضاعة منقولة, حمولة (بضائع تحملها مركبة كبيرة) / حمل, عبء (وزن يجب تحمله أو نقله) / حمل, حمولة (كمية يمكن معالجتها أو نقلها في وقت واحد)\nمثال: استغرق التحميل ساعتين",
 "積載量": "حِمْل (رَفَعَ، أَقَلَّ) / عَبَّأَ, شَحَنَ\nمثال: حمل سامي سلاحه.",
 "積込": "تحميل (عمل وضع حمولة من شيء ما على أو في مركبة أو سفينة أو حاوية، إلخ) / بضاعة منقولة, حمولة (بضائع تحملها مركبة كبيرة) / حمل, عبء (وزن يجب تحمله أو نقله) / حمل, حمولة (كمية يمكن معالجتها أو نقلها في وقت واحد)\nمثال: استغرق التحميل ساعتين",
 "積込み": "تحميل (عمل وضع حمولة من شيء ما على أو في مركبة أو سفينة أو حاوية، إلخ) / بضاعة منقولة, حمولة (بضائع تحملها مركبة كبيرة) / حمل, عبء (وزن يجب تحمله أو نقله) / حمل, حمولة (كمية يمكن معالجتها أو نقلها في وقت واحد)\nمثال: استغرق التحميل ساعتين",
 "積込む": "حِمْل (رَفَعَ، أَقَلَّ) / عَبَّأَ, شَحَنَ\nمثال: حمل سامي سلاحه.",
 "積込場": "منطقة تحميل (محطة توقف حيث يمكن تحميل وتفريغ الناقلات)",
 "積金": "حساب احتياطي, صندوق احتياطي (أموال مقتطعة من الأرباح لتوفير المدفوعات المستقبلية المتوقعة)",
 "積集合": "مُفْتَرَق, تَقَاطُع / تَقَاطُع",
 "積雪": "ثَلْج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / تلج / ثلج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / أَثْلَجَ (أثلج يومُنا: دخل في الثلج؛ أثلجت الأرض: أصابها الثلج)",
 "積雲": "ركام, سحاب ركامي (سحابة كروية الشكل)",
 "穎": "سَفَاة",
 "穎悟": "ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي.",
 "穎敏": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة.",
 "穎果": "برة, حبة (فاكهة جافة تشبه البذور تنتجها الحشائش النجيلية: مثل القمح والشعير والذرة)",
 "穏やか": "هَادِئ / طَمْأَنَ / مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "穏便": "مُؤَدَّب / بِكُلّ بَسَاطَة (بَكَلَه: خَلَطَه؛ بَكَلَ عَلَيْنَا حَديثَه وأَمْرَه: خَلَطَهُ وجاءَ بِهِ عَلَى غَيْرِ وَجْهِهِ)\nمثال: غادرنا بكل بساطة.",
 "穏健": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "穏健派": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "穏健路線": "وَسَطِيُّ الاتِّجَاه (لَيْسَ مُتَطَرِّفًا خَاصَّةً فِي الآرَاءِ السِّيَاسِيَّة) / مُعْتَدِل, وَسَطِيّ (يدعم أو ينتهج مساراً ليس ليبرالياً ولا محافظاً بشكل مفرط)",
 "穏和": "مُؤَدَّب / مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "穏当": "سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب",
 "穐田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "穗": "أُذُن (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / أُذْن (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / سُنْبُلَة / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: من أذن لتوم باستعارة سيارتي? / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / عرف الخوذة ((شعارات النبالة) في العصور الوسطى، شعار يستخدم لتزيين الخوذة) / تحدب الطريق, ظهر الطريق (منتصف طريق محدب) / ذروة, قمة (الخط العلوي لتل أو جبل أو موجة) / سليل (حفيد أو وريث)\nمثال: سليل أصل ملكي",
 "穢す": "تُرْبَة, أَرْض / اِتَّسَخَ\nمثال: その本を汚さないように扱ってくれるなら、貸してあげるよ。 — يمكنك استعارة هذا الكتاب بشرط أن تبقيه نظيفاً. / عَار, خِزْي",
 "穢らわしい": "قَذِر جِدًّا, مُقْرِف (بالغ القذارة بشكل مثير للاشمئزاز؛ ملطّخ بمواد كريهة) / بَذِيء, سَافِل (يتّسم بالفحش وخدش الحياء) / حَقِير, وَضِيع (خسيس ومحتقر؛ دنيء)",
 "穢れ": "عدم نظافة, قذارة (حالة كون الشيء غير صحي) / عَار, خِزْي",
 "穢れのない": "صَافٍ, اَلصَّافِي",
 "穢れの無い": "صَافٍ, اَلصَّافِي",
 "穢土": "بِرَاز, سَلْح",
 "穫る": "حِصَاد / مَحْصُول, غَلَّة / حَصَدَ (قَطَعَ الزَّرْعَ وغيره من النبات بالمِنْجَل أو آلة الحصاد)\nمثال: حصد الفلاح القمح.",
 "穴": "ثَقْب, حُفْرة (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / تقب\nمثال: انه ثقب الاسود. / حُفْرَة / جُحْر, سَرَب (معنى الفعل \"جَحَرَ\" متعدد: يدل على دخول الجحر (للضب مثلاً)، أو تأخر وتخلّف (للخير أو الحيوان أو العام -بمعنى قلة مطره-)…؛ يُشيرُ الفعل معانٍ مُتعدِّدة بحسب سياقه، منها: الدخول في شيء (مثل دخول الضبّ جُحْره)، وإدخال شيء في شيء آخر، والارتفاع (كارتفاع الشمس)…)\nمثال: ادخل إلى ذلك الجحر. / عَجْز / حِمَار (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة) / حُمار (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة) / عَجِيزَة, مُؤَخَّرَة\nمثال: هن بحاجة لحمار. / خَلْفِيّ / ثَقْب, حُفْرة (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / تقب\nمثال: انه ثقب الاسود.",
 "穴あき": "مَثْقُوب, مَخْرُوق (به ثقب مقطوع فيه)",
 "穴あけ": "إنتاج النفط, تنقيب (فعل حفر ثقب في الأرض على أمل إنتاج البترول) / تثقيب, حفر (فعل التثقيب أو الحفر)",
 "穴あけ器": "لَكْمَة / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة) / خَرَّامَة\nمثال: لكم اشتقت إليك!",
 "穴があくほど": "بشكل ثاقب, بصوت حاد (بصوت حاد) / بشكل ثاقب, بشكل قارص (بشكل شديد وحاد جداً)\nمثال: غنت بصوت حاد نوعاً ما",
 "穴が空くほど": "بشكل ثاقب, بصوت حاد (بصوت حاد) / بشكل ثاقب, بشكل قارص (بشكل شديد وحاد جداً)\nمثال: غنت بصوت حاد نوعاً ما",
 "穴が開くほど": "بشكل ثاقب, بصوت حاد (بصوت حاد) / بشكل ثاقب, بشكل قارص (بشكل شديد وحاد جداً)\nمثال: غنت بصوت حاد نوعاً ما",
 "穴ぐら": "قَبْو, سِرْدَاب",
 "穴ぐり": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "穴だらけ": "خَاطِئ, غَلَط (يتّسم بالأخطاء؛ لا يتّفق مع النموذج أو القواعد المُقرَّرة) / بِهِ خَلَل, مَعْطُوب (فيه عطب أو خلل)",
 "穴だらけにする": "لُغْز, أُحْجِيَّة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة رمزية أو غير مباشرة)\nمثال: لم يحل أبدا لغز وفاتها.",
 "穴のあくほど": "بشكل ثاقب, بصوت حاد (بصوت حاد) / بشكل ثاقب, بشكل قارص (بشكل شديد وحاد جداً)\nمثال: غنت بصوت حاد نوعاً ما",
 "穴の明くほど": "بشكل ثاقب, بصوت حاد (بصوت حاد) / بشكل ثاقب, بشكل قارص (بشكل شديد وحاد جداً)\nمثال: غنت بصوت حاد نوعاً ما",
 "穴の空くほど": "بشكل ثاقب, بصوت حاد (بصوت حاد) / بشكل ثاقب, بشكل قارص (بشكل شديد وحاد جداً)\nمثال: غنت بصوت حاد نوعاً ما",
 "穴の開くほど": "بشكل ثاقب, بصوت حاد (بصوت حاد) / بشكل ثاقب, بشكل قارص (بشكل شديد وحاد جداً)\nمثال: غنت بصوت حاد نوعاً ما",
 "穴ぼこ": "ثَقْب, حُفْرة (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / تقب\nمثال: انه ثقب الاسود. / حفرة طريق, حفرة وعائية (حفرة أو ثقب ناتج عن التآكل أو العوامل الجوية (خاصة في سطح الطريق))",
 "穴まんこ": "اِسْت (فتحة الدُبُر أو مقعد الإنسان؛ الأصل والأساس) / شَرْج",
 "穴を捲る": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "穴マンコ": "اِسْت (فتحة الدُبُر أو مقعد الإنسان؛ الأصل والأساس) / شَرْج",
 "穴久保": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "穴倉": "قَبْو, سِرْدَاب",
 "穴兎": "أرنب أوروبي, أرنب العالم القديم (حيوان حفار بني رمادي شائع موطنه جنوب أوروبا وشمال أفريقيا ولكن تم إدخاله في أماكن أخرى؛ مستأنس على نطاق واسع ومطور بألوان مختلفة ولاحتياجات مختلفة؛…)",
 "穴埋め": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / تطبيق, طلاء (عمل وضع شيء (على سطح)) / تغطية (فعل حماية شيء ما بتغطيته) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / غِطَاء (مصنوعة تُغطّي شيئًا آخر عادةً لحمايته أو إيوائه أو إخفائه)\nمثال: وصف الطبيب وضعاً موضعياً لليود / إجراء كلوز, اختبار إكمال الفراغات (اختبار لتشخيص القدرة على القراءة؛ يتم حذف كلمات من نص نثري ويطلب من القارئ ملء الفراغات)",
 "穴埋め問題": "إجراء كلوز, اختبار إكمال الفراغات (اختبار لتشخيص القدرة على القراءة؛ يتم حذف كلمات من نص نثري ويطلب من القارئ ملء الفراغات)",
 "穴場": "حَسَنُ الصِّيَانَة, مَعْتَنًى بِه (يُحَافَظُ عَلَيْهِ فِي حَالَةٍ جَيِّدَة) / حَسَنُ الصِّيَانَة, مُعْتَنًى بِه (يَتَّسِمُ بِالنِّظَامِ وَالتَّرْتِيبِ؛ خَالٍ مِنَ الفَوْضَى)",
 "穴子": "أنقليس كونجر, كونجر (أنقليس بحري كبير داكن اللون عديم القشور يوجد في المياه الساحلية المعتدلة والاستوائية؛ يُستخدم بعضه كطعام)",
 "穴居人": "ساكن الكهوف (شخص يعيش في كهف)",
 "穴掘り": "استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض) / تنيقب, حفر (فعل الحفر) / حفر, حفرية (حفرة في الأرض ناتجة عن الحفر) / حفرية, موقع أثري (موقع الاستكشاف الأثري)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون",
 "穴明き": "مَثْقُوب, مَخْرُوق (به ثقب مقطوع فيه)",
 "穴熊": "غُرَيْر / غرير أوراسي (نوع من الغرير موطنه أوروبا وآسيا)",
 "穴燕": "سمامة الكهوف (سمامة من شرق آسيا؛ تنتج عش الطائر الصالح للأكل)",
 "穴狙い": "حصان غامض (حصان سباق لا يُعرف عنه سوى القليل) / حصان أسود, مرشح غامض (مرشح سياسي غير معروف جيداً ولكنه قد يفوز بشكل غير متوقع)",
 "穴蔵": "قَبْو, سِرْدَاب",
 "穴蜂": "دبور حفار (دبور انفرادي يحفر أعشاشاً في التربة ويخزن فيها حشرات مشلولة لليرقات)",
 "穴開き": "مَثْقُوب, مَخْرُوق (به ثقب مقطوع فيه)",
 "穴開け": "إنتاج النفط, تنقيب (فعل حفر ثقب في الأرض على أمل إنتاج البترول) / تثقيب, حفر (فعل التثقيب أو الحفر)",
 "穴開け器": "لَكْمَة / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة) / خَرَّامَة\nمثال: لكم اشتقت إليك!",
 "穴隙": "شق, صدع (شق ضيق وطويل) / شق, صدع (انخفاض ضيق وطويل في سطح ما)",
 "穴馬": "حصان غامض (حصان سباق لا يُعرف عنه سوى القليل) / حصان أسود, مرشح غامض (مرشح سياسي غير معروف جيداً ولكنه قد يفوز بشكل غير متوقع)",
 "究める": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "究明": "تَحْقِيق",
 "究極": "قُصْوَى, نِهَائِيّ (يَكُونُ العُنْصُرَ الأَخِيرَ أَوِ الخِتَامِيَّ فِي سِلْسِلَةٍ) / أقصى, مطلق (الأبعد أو الأعلى في الدرجة أو الترتيب؛ الأقصى أو المتطرف) / قمة, منتهى (الجودة الأرقى أو الأكثر تفوقاً من نوعها)\nمثال: الإنجاز النهائي",
 "究極的": "قُصْوَى, نِهَائِيّ (يَكُونُ العُنْصُرَ الأَخِيرَ أَوِ الخِتَامِيَّ فِي سِلْسِلَةٍ) / أقصى, مطلق (الأبعد أو الأعلى في الدرجة أو الترتيب؛ الأقصى أو المتطرف) / قمة, منتهى (الجودة الأرقى أو الأكثر تفوقاً من نوعها)\nمثال: الإنجاز النهائي",
 "究理学": "فِيزِيَاء, فِيزِيقَا (علم الطَّبيعة أو علم الطَّبيعيَّات)\nمثال: تدرس الفيزياء النووية.",
 "究竟": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / مُمْتَاز, فَاخِر / قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية. / إتمام, إكمال (إجراء ختامي أو نهائي) / تتويج, ذروة (اللحظة الحاسمة في رواية أو مسرحية) / بلوغ القمة, عبور الزوال ((في الفلك) أعلى نقطة سماوية لجرم سماوي فوق أفق المراقب) / أوج, ذروة (مرحلة الذروة النهائية)\nمثال: مشهد فراش الموت هو ذروة المسرحية",
 "穹窿": "القبة السماوية, سماء (السطح الظاهري للكرة الوهمية التي تبدو الأجرام السماوية مسقطة عليها) / قُبَّة / قَبْو",
 "穹蒼": "القبة السماوية, سماء (السطح الظاهري للكرة الوهمية التي تبدو الأجرام السماوية مسقطة عليها)",
 "空": "بُطْلَان, غُرُور (صفة كون الشيء عديم القيمة أو عبثياً) / خلاء, فراغ (منطقة أو مساحة فارغة) / خواء (حالة وجود معدة فارغة) / خواء, فراغ (حالة عدم احتواء أي شيء)\nمثال: رفض مغريات العالم الباطلة / بِلَا عِبْء, خَفِيفُ الحِمْل (غير مُثقَل بحمل مادّي) / غير مثقل بالأعباء, مرتاح (غير مثقل بالصعوبات أو المسؤوليات)\nمثال: غير مثقل بنظرية شاملة / خزي, عار (الافتقار إلى الشرف أو النزاهة) / خزي, عار (حالة من الخجل أو العار)\nمثال: استسلم لحياة العار / سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات / طَقْس, جَوّ / قَصِيّ, نَائٍ جِدًّا (بعيد جدّاً في المكان أو الزمان) / حالة إدراكية, حالة معرفية (حالة العمليات المعرفية للشخص) / حالة ذهنية, مزاج (حالة نفسية مؤقتة) / أَجْوَف / سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات / بُطْلَان, غُرُور (صفة كون الشيء عديم القيمة أو عبثياً) / خلاء, فراغ (منطقة أو مساحة فارغة) / خواء (حالة وجود معدة فارغة) / خواء, فراغ (حالة عدم احتواء أي شيء)\nمثال: رفض مغريات العالم الباطلة / سِلَاح طَيَرَان / جَدْب, عُقْم (صفة عدم إنتاج أي شيء ذي قيمة) / عدم جدوى, عقم إبداعي (نقص الخيال الإبداعي)",
 "空々": "فَارِغ / فَرَغَ",
 "空々しい": "زَائِف, بَاطِل / كَاذِب",
 "空々漠々": "شَاسِع, وَاسِع",
 "空えずき": "تقيؤ جاف, تهوع (تشنج لا إرادي لمحاولة التقيؤ دون جدوى)\nمثال: نوبة سيئة من التهوع",
 "空き": "فَرَاغ, مَكَان / فَضَاء (فَضَاء) / مَسَافَة\nمثال: الفضاء مليئ بالغموض. / شَاغِر, وَظِيفَة شَاغِرَة / غُرْفَة شَاغِرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات) / حَيِّز\nمثال: الأب في الغرفة. / رَاحَة, خُلُو مِنَ الْعَمَل / إهمال, عدم استخدام (حالة الشيء الذي لم يستخدم وتم إهماله)\nمثال: كان المنزل في حالة إهمال رهيبة",
 "空きっ腹": "رَغْبَة, تَعَطُّش / جَاعَ (أَصَابَهُ الجُوعُ؛ أَصَابَهُ الفَقْرُ الشَّديدُ)\nمثال: جاع الرجل العجوز حتى الموت.",
 "空き室": "شَاغِر, وَظِيفَة شَاغِرَة / غُرْفَة شَاغِرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات) / حَيِّز\nمثال: الأب في الغرفة.",
 "空き家": "أَرْمَلَة",
 "空き巣": "سَطْو / لُصُوصِيَّة\nمثال: 空巣にやられた。 — سُرق منزلنا عندما كنا مسافرين.",
 "空き巣ねらい": "سَطْو / لُصُوصِيَّة",
 "空き巣狙い": "سَطْو / لُصُوصِيَّة",
 "空き巣被害": "سَطْو / لُصُوصِيَّة",
 "空き時間": "رَاحَة, خُلُو مِنَ الْعَمَل",
 "空き状況": "تَوَفُّر",
 "空き腹": "رَغْبَة, تَعَطُّش / جَاعَ (أَصَابَهُ الجُوعُ؛ أَصَابَهُ الفَقْرُ الشَّديدُ)\nمثال: جاع الرجل العجوز حتى الموت.",
 "空き部屋": "شَاغِر, وَظِيفَة شَاغِرَة / غُرْفَة شَاغِرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات) / حَيِّز\nمثال: الأب في الغرفة.",
 "空き間": "شَاغِر, وَظِيفَة شَاغِرَة / غُرْفَة شَاغِرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات) / حَيِّز\nمثال: الأب في الغرفة. / انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "空く": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "空くじ": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "空け": "شرود الذهن (انشغال كبير لدرجة تجاهل متطلبات الانتباه العادية) / مُغَفَّل, أَحْمَق / رياء, زيف (صفة عدم الصراحة أو الصدق؛ الخداع أو النفاق) / تجويف, فراغ (خاصية وجود منطقة غائرة) / تجوّف (حالة كونه مجوفاً: وجود مساحة فارغة في الداخل)",
 "空けた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "空ける": "فَارِغ / فَرَغَ / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة. / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "空しい": "فَارِغ / فَرَغَ / سُدًى, عَبَثِيّ (لا يؤدّي إلى نجاح أو نتيجة مرجوّة) / مَغْرُور, مُعْجَب بِنَفْسِه (يتّسم بكبرياء زائف؛ لديه شعور مبالَغ فيه بأهمية الذات) / جُثَّة هَامِدَة, فَاقِد الحَيَاة (حُرم من الحياة؛ لم يعد على قيد الحياة) / خَالٍ مِنَ الحَيَاة (لا يمتلك القدرة على دعم الحياة) / مَيِّت, هَامِد (فاقد للحيويّة والنشاط والإثارة) / خَاوٍ مِنَ الحَيَاة (خَالٍ مِنَ الحَيَاة أَوْ فُرِّغَ مِنَ الكَائِنَات الحَيَّة)",
 "空しく": "عَبَثًا, سُدًى",
 "空しくなる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "空っけつ": "فقير",
 "空っぽ": "فَارِغ / فَرَغَ",
 "空っ下手": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "空っ穴": "فقير",
 "空で覚える": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "空にする": "فَارِغ / فَرَغَ",
 "空の便": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة) / تَحْلِيق / فِرَار, هُرُوب\nمثال: الطيران أسرع وسيلة سفر.",
 "空の旅": "سفر جوي, طيران (السفر عبر الطائرات)\nمثال: السفر الجوي ينطوي على الكثير من الانتظار في المطارات",
 "空の玄関": "مَطَار (المَطارُ : اسمُ مكانٍ من طَارَ؛ المَطارُ :وهو مكان مُعَدُّ بالوسائل الفنِّيَّة لصعود الطائرات وهبوطها أي مركز طيران جوي، أو ميناء جوي)\nمثال: وصلت إلى المطار.",
 "空ぶかし": "بطالة, تسكع (عدم القيام بعمل أو وظيفة)",
 "空ろ": "تَجْوِيف / أَجْوَف",
 "空を使う": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "空クジ": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "空コン": "فَارِغ / فَرَغَ",
 "空下手": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
