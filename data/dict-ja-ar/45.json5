 "短点": "أسيد, حمض (اسم دارج لثنائي إيثيل أميد حمض الليسرجيك) / نقطة (أقصر الإشارتين التلغرافيتين المستخدمتين في شفرة مورس) / وزارة النقل (الإدارة الفيدرالية الأمريكية التي تؤسس وتنسق برامج النقل الوطنية؛ أنشئت عام 1966) / نقطة (شكل دائري صغير جداً)\nمثال: صف من النقاط",
 "短目": "قَصِير نَوْعًا مَا (أَقْصَر بِقَليل مِنَ المُعْتاد)",
 "短眠": "سنة, غفوة (النوم لفترة قصيرة (عادة ليس في السرير))",
 "短稈": "قَصِيرُ السَّاق (وَصْفٌ لِلنَّبَاتَاتِ ذَاتِ السِّيقَانِ القَصِيرَةِ نِسْبِيًّا)",
 "短筒": "مُسَدَّس (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ) / فَرْد / طَبَنْجَة / غَدَّارَة\nمثال: كان عند زيري مسدس.",
 "短篇": "قِصَّة قَصِيرَة, أُقْصُوصَة",
 "短篇小説": "قِصَّة قَصِيرَة, أُقْصُوصَة",
 "短篇物": "قِصَّة قَصِيرَة, أُقْصُوصَة",
 "短簡": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "短絡": "دائرة قصر, ماس كهربائي (تلامس عرضي بين نقطتين في دائرة كهربائية يوجد بينهما فرق جهد)",
 "短絡的": "تَبْسِيطِيّ, سَاذَج (يتَّسم بالبساطة المُفرطة والمُضلِّلة أحيانًا)",
 "短編": "قِصَّة قَصِيرَة, أُقْصُوصَة",
 "短編小説": "قِصَّة قَصِيرَة, أُقْصُوصَة",
 "短縮": "تقصير (عملية الإنقاص في الطول) / دهن المعجنات, سمن نباتي (دهن مثل الزبدة أو الشحم يُستخدم في المخبوزات)\nمثال: الفستان يحتاج إلى تقصير",
 "短縮形": "انكماش, تقلص (عملية إنقاص (شيء ما) في الحجم أو الكثافة أو الكمية أو النطاق) / انقباض, تقلص عضلي ((فسيولوجيا) تقصير أو توتر جزء أو عضو (خاصة العضلة أو الألياف العضلية)) / إدغام, اختصار لفظي (كلمة تتكون من كلمتين أو أكثر عن طريق حذف أو دمج بعض الأصوات) / انضغاط, تقلص (عملية أو نتيجة أن يصبح الشيء أصغر أو مضغوطاً معاً)\nمثال: تقلص الغاز عند التبريد",
 "短腹": "حَادّ المِزَاج, سَرِيع الغَضَب (يُستثار إلى الغضب بسرعة)",
 "短艇": "قَارِب, مَرْكَب (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير",
 "短観": "قَصِير الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة مَحْدودَة أَوْ مُمْتَدّ عَلَيْها)",
