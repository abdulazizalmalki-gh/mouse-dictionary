 "破城槌": "كبش ضارب (كبش يستخدم لكسر أبواب المباني المحصنة)",
 "破壊": "تَدْمِير, هَدْم / حَادِث إِصْطِدَام\nمثال: يوشك الجسر على الانهيار.",
 "破壊分子": "تَخْرِيبِيّ, مُتَمَرِّد (مُعَارِض لِسُلْطَة مَدَنِيَّة أَوْ حُكُومَة)",
 "破壊工作": "أَعْمَال تَخْرِيبِيَّة, تَخْرِيب (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما…)\nمثال: أنا في رحلة أعمال.",
 "破壊措置命令": "إرداء بالرصاص (القتل بإطلاق النار على شخص بدم بارد)",
 "破壊活動": "تخريب, تقويض (فعل التقويض؛ مثل الإطاحة بحكومة شرعية أو تدميرها)",
 "破壊的": "مدمر, هدام (يسبب دماراً أو ضرراً كبيراً)\nمثال: سياسة هدامة للاقتصاد",
 "破壊者": "مُدَمِّر",
 "破天荒": "غَيْر مَسْبُوق, لَمْ يُسْمَع بِهِ (لم يكن معروفاً من قبل) / جَرِيء, جَسُور",
 "破婚": "طَلَاق, تَطْلِيق\nمثال: طلق زيري زوجته.",
 "破局": "كَارِثَة, فَاجِعَة / اِنْهَار\nمثال: يوشك الجسر على الانهيار.",
 "破廉恥": "وَقِح, صَفِيق",
 "破廉恥漢": "أَعْرَج",
 "破恋": "انكسار القلب (أسى ويأس مدمر)\nمثال: إنه يتعافى من انكسار القلب",
 "破折": "كَسْر, اِنْكِسَار",
 "破損": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام…)\nمثال: ذهب سامي في عطلة.",
 "破擦音": "صَامِت مَوْقُوف اِحْتِكَاكِيّ, صَامِت مَزْجِيّ",
 "破断": "تَمَزُّق",
 "破格": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ / شَاذّ, غَيْر مُنْتَظِم",
 "破棄": "تَدْمِير, هَدْم / إلغاء, فسخ (فعل النسخ؛ إلغاء رسمي أو قانوني) / انقلاب في الموقف, تحول تام (تغيير كبير في الموقف أو المبدأ أو وجهة النظر)\nمثال: تحول تام في السياسة الخارجية",
 "破殻": "روبيان الهيكل العظمي (قشري صغير من مزدوجات الأرجل له شكل غريب يوحي بفرس النبي؛ يوجد بشكل رئيسي على…)",
 "破毀院": "مَحْكَمَة التَّمْيِيزِ, مَحْكَمَة النَّقْضِ (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)",
 "破滅": "خَرَاب, خَرَابَة",
 "破滅的": "مدمر, هدام (يسبب دماراً أو ضرراً كبيراً)\nمثال: سياسة هدامة للاقتصاد",
 "破片": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من…)\nمثال: يصنع قطعة أثاث خشبية.",
 "破牢": "هروب من السجن (هروب من السجن)\nمثال: تم التخطيط للهروب بعناية",
 "破獄": "هروب من السجن (هروب من السجن)",
 "破瓜": "بلوغ (وقت الحياة الذي تصبح فيه الغدد الجنسية وظيفية) / اِفْتَضَّ, تَصَرُّف",
 "破瓜期": "بُلُوغ",
 "破瓜病": "فصام غير منتظم, فصام مراهقة (شكل من أشكال الفصام يتميز بتفكك شديد للشخصية، بما في ذلك الكلام المضطرب…)",
 "破産": "إِفْلَاس",
 "破産寸前": "مُتَرَاصّ, مُتَلَاصِق ((عَنْ حَرَكَة المُرُور) مُتَلَاصِق سَيَّارَة بِسَيَّارَة بِسَبَب الازْدِحَام)",
 "破目": "عَهْد, مِيثَاق (تعهد رسمي بالوفاء والإخلاص)\nمثال: وجد نفسه في مأزق محرج للغاية",
 "破砕": "سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي…)\nمثال: قمع الهرطقة",
 "破砕性": "قابل للكسر, هش (قادر على أن ينكسر أو يتلف)\nمثال: الفخار الخزفي قابل للكسر",
 "破砕性爆弾": "ضربة أرضية زاحفة (كرة مضروبة أو مرسلة تنزلق قريباً من الأرض)",
 "破砕機": "ساحقة, كسارة (جهاز يقوم بسحق شيء ما)",
 "破竹": "لَا يُقَاوَم (بالغ الجاذبيّة إلى حدّ لا يمكن مقاومته)\nمثال: دوافع لا تقاوم",
 "破算": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا!",
 "破約": "تحطيم, كسر (عملية كسر شيء ما)\nمثال: كان الكسر لا مفر منه",
 "破綻": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة…)\nمثال: فشل ياني مجددا. / مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو…)\nمثال: مزق سامي الرسالة.",
 "破綻をきたす": "أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "破綻を来す": "أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "破船": "حُطَام سَفِينَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)",
 "破落戸": "أفاق, محتال (شخص مخادع ولا يمكن الوثوق به) / بلطجي, فتوة (رجل قاسٍ ووحشي)",
 "破裂": "انفجار (عملية الانفجار أو التفرقع)\nمثال: انفجار الألعاب النارية أيقظ الأطفال / تَوَزُّع",
 "破談": "انقطاع, قطع مفاجئ (حالة من المقاطعة المفاجئة)",
 "破過": "اِخْتِرَاق (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "破鏡": "طَلَاق, تَطْلِيق\nمثال: طلق زيري زوجته.",
 "破門": "إِبْعَاد ((في السياسية) عقوبة جنائية تقضي بإخراج المحكوم عليه من البلاد) / حِرْمَان كَنَسِيّ",
 "破面": "كَسْر, اِنْكِسَار",
 "破風": "جملون (الجدار المثلث العمودي بين الأطراف المائلة لسقف الجملون)",
 "破骨細胞": "خلية هادمة للعظم, ناقضة العظم (خلية تعمل على تكسير وامتصاص النسيج العظمي)",
 "破魔": "رُقْيَة",
 "破魔師": "رَاقٍ, رَاقِية (صَفَا وحَسُنَ؛ الشيُ فلانًا: أعْجَبَه)",
 "破魔術": "رُقْيَة",
 "硅石": "ثاني أكسيد السيليكون, سيليكا",
 "硅砂": "رمل الكوارتز (رمل يتكون أساساً من الكوارتز، يستخدم كمادة خام رئيسية لإنتاج الزجاج التجاري)",
 "硅肺": "سَحَار سِيلِيسِيّ",
 "硇砂": "كلوريد الأمونيوم, ملح النشادر (ملح أبيض يستخدم في الخلايا الجافة)",
 "硏": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "硝化": "نترجة (أكسدة مركبات الأمونيوم في المواد العضوية الميتة إلى نترات ونيتريت بواسطة…)",
 "硝化綿": "نترات السليلوز, نيتروسليلوز (إستر لحمض النيتريك؛ يستخدم في الورنيش والمتفجرات)",
 "硝子": "زُجَاج, قزاز\nمثال: هل لي بكأس ماء؟",
 "硝子体": "جسم زجاجي, خلط زجاجي (الهلام الشفاف عديم اللون الذي يملأ الغرفة الخلفية لمقلة العين)",
 "硝子屋": "زجّاج, قاطع الزجاج (شخص يقطع الزجاج المسطح حسب المقاس)",
 "硝子細工": "أواني زجاجية (صنف من أدوات المائدة مصنوع من الزجاج)",
 "硝子軟骨": "غضروف زجاجي (غضروف شفاف شائع في المفاصل والممرات التنفسية؛ يشكل معظم الهيكل العظمي للجنين)",
 "硝安": "نترات الأمونيوم (تستخدم كمتفجرات وسماد ووقود للصواريخ)",
 "硝煙反応": "تَفَاعُل كِيمِيَائِيّ (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به) / استجابة الجلد الجلفانية (تغير في الخصائص الكهربائية للجلد استجابة للتوتر أو القلق)",
 "硝石": "ملح البارود, نترات البوتاسيوم",
 "硝薬": "بَارُود",
 "硝酸": "حمض النتريك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في…)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "硝酸アンモニウム": "نترات الأمونيوم (تستخدم كمتفجرات وسماد ووقود للصواريخ)",
 "硝酸ウラニル": "نترات اليورانيل (ملح أصفر يتم الحصول عليه عن طريق تفاعل أملاح اليورانيوم مع حمض النيتريك)",
 "硝酸エステル": "نترات (أي مركب يحتوي على مجموعة النترات (مثل ملح أو إستر حمض النيتريك))",
 "硝酸カリウム": "ملح البارود, نترات البوتاسيوم",
 "硝酸カルシウム": "نترات الكالسيوم (ملح متميع قابل للذوبان في الماء؛ يستخدم أحياناً كمصدر للنيتروجين في الأسمدة)",
 "硝酸セルロース": "نترات السليلوز, نيتروسليلوز (إستر لحمض النيتريك؛ يستخدم في الورنيش والمتفجرات)",
 "硝酸ナトリウム": "نترات الصوديوم",
 "硝酸塩": "نترات (أي مركب يحتوي على مجموعة النترات (مثل ملح أو إستر حمض النيتريك))",
 "硝酸系": "حمض النتريك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في…)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "硝酸繊維素": "نترات السليلوز, نيتروسليلوز (إستر لحمض النيتريك؛ يستخدم في الورنيش والمتفجرات)",
 "硝酸銀": "نترات الفضة (نترات تستخدم في صنع المستحلبات الفوتوغرافية؛ وتستخدم أيضاً في الطب للكي وكعامل…)",
 "硨磲": "محار عملاق (محار كبير يسكن الشعاب المرجانية في جنوب المحيط الهادئ ويزن ما يصل إلى 500 رطل)",
 "硫化カドミウム": "كبريتيد الكادميوم (كبريتيد أصفر يستخدم بشكل رئيسي كصبغة)",
 "硫化亜鉛": "كبريتيد الخارصين, كبريتيد الزنك (مركب بلوري متفسفر أصفر إلى أبيض يوجد طبيعياً في السفاليريت أو الفورتزيت ويستخدم…)",
 "硫化水素": "كبريتيد الهيدروجين (كبريتيد له رائحة كريهة تشبه رائحة البيض الفاسد)",
 "硫化物": "كبريتيد (مركب من الكبريت وعنصر آخر أكثر إيجابية كهربائية)",
 "硫化鉄鉱": "بيريت (أي من الكبريتيدات ذات المظهر المعدني المختلفة (ويعتبر البيريت أكثرها شيوعاً))",
 "硫砒鉄鉱": "أرسينوبيريت (خام الزرنيخ ذو لون أبيض فضي أو رمادي)",
 "硫酸": "حمض الكبريتيك, زاج (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في…)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "硫酸エステル": "كبريتات (ملح أو إستر لحمض الكبريتيك)",
 "硫酸カルシウム": "كبريتات الكالسيوم",
 "硫酸ナトリウム": "كبريتات الصوديوم (ملح أبيض مر صلب يستخدم في تصنيع الزجاج والورق والأصباغ والمستحضرات الصيدلانية)",
 "硫酸バリウム": "كبريتات الباريوم (مسحوق أبيض غير قابل للذوبان وغير منفذ للأشعة يستخدم كصبغة)",
 "硫酸マグネシウム": "كبريتات المغنيسيوم (ملح للمغنيسيوم)",
 "硫酸亜鉛": "كبريتات الزنك (مسحوق عديم اللون قابل للذوبان في الماء؛ يستخدم كمثبت للون أو لحفظ الخشب أو…)",
 "硫酸塩": "كبريتات (ملح أو إستر لحمض الكبريتيك)",
 "硫酸銅": "سُلْفَات اَلنُّحَاس",
 "硫銀鉱": "أرجنتيت",
 "硫銅鉱": "كالكوسيت (معدن رمادي ثقيل يعد خاماً للنحاس)",
 "硫黄": "كِبْرِيتِيّ",
 "硫黄山": "منجم كبريت (منجم يُستخرج منه الكبريت من الأرض)",
 "硫黄酸化物": "أكسيد الكبريت (أي من أكاسيد الكبريت المتعددة)",
 "硬": "شدة, صرامة (صرامة مفرطة)\nمثال: صرامة الشخصية",
 "硬い": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب. / بتصلب, بجمود (بطريقة متصلبة)\nمثال: استقرت يداه بتصلب / قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية. / أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "硬さ": "ثَبَات",
 "硬し": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "硬たんぱく質": "بروتين صلب (بروتين بسيط يوجد في الأنسجة القرنية والغضروفية وفي عدسة العين)",
 "硬タンパク質": "بروتين صلب (بروتين بسيط يوجد في الأنسجة القرنية والغضروفية وفي عدسة العين)",
 "硬券": "تذكرة قطار (تذكرة صالحة لركوب القطار)",
 "硬化": "تصلب, تقسية (عملية جعل الشيء أكثر صلابة (أكثر متانة أو إحكاماً أو تماسكاً))\nمثال: تصلب الخرسانة / انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "硬化ゴム": "إيبونيت, مطاط صلب (مطاط صلب غير مرن يتكون من فلكنة المطاط الطبيعي)",
 "硬化剤": "مصلب, مقسي (مادة تزيد الصلابة، خاصة مادة تضاف إلى الورنيش أو الطلاء لمنحه سطحاً أو طبقة…)",
 "硬化性": "صلبي (مكون من أو متعلق بصلبة العين)\nمثال: نسيج صلبي",
 "硬化症": "تَصَلُّب",
 "硬口蓋": "حَنَك صَلْب ((حَنَكَت) الْأُم الصَّبِي حنكا: دلكت حنكه؛ (حَنَكَ) فُلَان الدَّابَّة: جعل…)",
 "硬口蓋音": "غَارِيّ",
 "硬変": "تَشَمُّع, تَلَيُّف",
 "硬度": "شدة, صرامة (صرامة مفرطة)\nمثال: صرامة الشخصية",
 "硬式": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "硬式テニス": "تَنِس, تِنِس",
 "硬性": "شدة, صرامة (صرامة مفرطة)\nمثال: صرامة الشخصية",
 "硬木": "خشب صلب (خشب الأشجار عريضة الأوراق ثنائية الفلقة (بالمقارنة مع خشب الصنوبريات))",
