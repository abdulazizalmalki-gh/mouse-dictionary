 "笑劇": "فارس, مهزلة (كوميديا تتميز بالسخرية الواسعة والمواقف غير المحتملة) / حشوة مفرومة, فورس ميت (خليط من الدجاج النيئ المفروم والفطر مع الفستق والكمأة والبصل والبقدونس والكثير من الزبدة ويربط بالبيض)",
 "笑声": "ضَحْكَة / ضَحِكَ, ضحك (أثار الضحك أو جعل شخصًا يضحك بشيء مضحك أو طريف؛ سلّى أو أبهج شخصًا بجعل الأجواء مرحة)\nمثال: ضحك الجميع علي.",
 "笑止": "كُومِيدِيّ, مُضْحِك (يُثير الضحك أو يستدعيه) / سَخِيف, مُثِير لِلسُّخْرِيَة (بالغ اللامعقوليّة بحيث يستدعي الاستهزاء والسخرية)",
 "笑気": "أكسيد النيتروز, غاز الضحك (مخدر استنشاقي يستخدم كمخدر في طب الأسنان والجراحة)",
 "笑気麻酔": "أكسيد النيتروز, غاز الضحك (مخدر استنشاقي يستخدم كمخدر في طب الأسنان والجراحة)",
 "笑納": "مُتَقَبِّل",
 "笑翡翠": "كوكابورا",
 "笑覧": "قِرَاءَة",
 "笑話": "قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))",
 "笑読": "قِرَاءَة",
 "笑談": "قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))\nمثال: روت قصة مضحكة",
 "笑門来福": "حسن طالع, ضربة حظ (جَمِيل؛ مُبْهِج) / توفيق, حسن الحظ (حالة ميمونة ناتجة عن نتائج إيجابية)\nمثال: إيمي فتاة حسنة.",
 "笑門福来": "حسن طالع, ضربة حظ (جَمِيل؛ مُبْهِج) / توفيق, حسن الحظ (حالة ميمونة ناتجة عن نتائج إيجابية)\nمثال: إيمي فتاة حسنة.",
 "笑顔": "اِبْتِسَامَة, بَسْمَة / اِبْتَسَمَ",
 "笙": "ريشة حرة (ريشة لا تنطبق تماماً فوق الفتحة)",
 "笛": "نَاي / أُخْدُود (أخْدُودُ) / صَفَّارَة / صَفَرَ, صَفَّرَ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر.",
 "笛吹": "عازف فلوت (شخص يعزف على الفلوت)",
 "笛吹き": "عازف فلوت (شخص يعزف على الفلوت)",
 "笛小千鳥": "زقزاق شادي (زقزاق صغير من شرق أمريكا الشمالية)",
 "笞": "خوص, غصن الصفصاف (عمل مصنوع من أغصان رفيعة متشابكة (خاصة أغصان الصفصاف)) / سوط / وباء, بَلْوَى (المرض العام الذي ينتشر بين الناس)\nمثال: على السلطات أن توقف انتشار الوباء.",
 "笞刑": "جَلْد (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد.",
 "笠": "ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "笠井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "笠原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "笠子": "سمكة العقرب, عقرب البحر (أسماك بحرية لها جسم مستدق ورأس مدرع وأشواك سامة)",
 "笠岡": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "笠木": "حجر الغطاء, طوبة رأسية (طوبة توضع جانبياً في أعلى الجدار)",
 "笠石": "حجر التتويج, حجر القمة (حجر يشكل قمة الجدار أو المبنى) / تتويج, لمسة نهائية (لمسة أخيرة؛ إنجاز متوج؛ ذروة)",
 "笠貝": "بطلينوس (أي من بطنيات القدم البحرية المختلفة عادة بأصداف مخروطية منخفضة؛ توجد ملتصقة بالصخور في المناطق الساحلية) / بطلينوس صدفي, ليمبيت (رخويات ذات صدفة مخروطية منخفضة)",
 "笥": "حَاوِيَة (وعاء ضخم جدًا من المعدن يستخدم في المستودعات والموانيء كمخازن للبضاعة. انظر الصورة؛ أي وعاء كبير يمكن أن تحتوي الكثير)\nمثال: أسقط توم الحاوية من الرافعة دون قصد.",
 "符": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها / ركضة, نقطة (نقطة في البيسبول يسجلها العداء بلمس جميع القواعد الأربع بأمان) / إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي) / حساب, كشف الحساب (فاتورة بمبلغ مستحق)\nمثال: سجل فريق اليانكيز 3 ركضات في النصف الثاني من الشوط التاسع / لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "符丁": "رَمْز, عَلَامَة (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا. / دُسْتُور, دَسْتُور (قَاعِدَة) / اِصْطِلَاح / تَرْمِيز, شِفْرَة / كود, شِفْرَة\nمثال: العدالة مضمونة في الدستور.",
 "符号": "لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "符号づけ": "تَرْمِيز, إِنْكُودِينْغ",
 "符号付": "إِشَارِيّ, بِلُغَةِ الإِشَارَة (متعلّق بلغة إشارة الصُّمّ) / ممهور بتوقيع, موقع (يحمل توقيعًا مكتوبًا بخط اليد)\nمثال: رسالة موقعة",
 "符号付き": "إِشَارِيّ, بِلُغَةِ الإِشَارَة (متعلّق بلغة إشارة الصُّمّ) / ممهور بتوقيع, موقع (يحمل توقيعًا مكتوبًا بخط اليد)\nمثال: رسالة موقعة",
 "符号体系": "دُسْتُور, دَسْتُور (قَاعِدَة) / اِصْطِلَاح / تَرْمِيز, شِفْرَة / كود, شِفْرَة\nمثال: العدالة مضمونة في الدستور.",
 "符号化": "تَرْمِيز, إِنْكُودِينْغ",
 "符号化文字集合": "دُسْتُور, دَسْتُور (قَاعِدَة) / اِصْطِلَاح / تَرْمِيز, شِفْرَة / كود, شِفْرَة\nمثال: العدالة مضمونة في الدستور.",
 "符号変換器": "انفرتر, عاكس كهربائي (محول كهربائي يحول التيار المستمر إلى تيار متردد)",
 "符号無し": "غير موقع (يفتقر إلى التوقيع)\nمثال: الرسالة كانت مطبوعة وغير موقعة",
 "符号解読": "فك الترميز, فك التشفير (نشاط توضيح أو تحويل من رمز إلى نص عادي)\nمثال: مطلوب مفتاح سري أو كلمة مرور لفك التشفير",
 "符号間干渉": "المخابرات الباكستانية, وكالة الاستخبارات الباكستانية (وكالة الاستخبارات الباكستانية؛ قوة سياسية وعسكرية قوية وشبه مستقلة)",
 "符合": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "符呪": "استحضار, عزيمة (تلاوة طقسية لكلمات أو أصوات يُعتقد أن لها تأثيراً سحرياً)",
 "符尾": "سَاق نَبَات / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أخشى أن أصل متأخرا. / ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب.",
 "符幹": "سَاق نَبَات / أَصْل (جعله أصيلًا أو ثابت الجذور؛ أي عَمَّق وأحكم أصوله؛ نسب شيئًا إلى أصله أو وضّح جذوره)\nمثال: أخشى أن أصل متأخرا.",
 "符牒": "رَمْز, عَلَامَة (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا. / دُسْتُور, دَسْتُور (قَاعِدَة) / اِصْطِلَاح / تَرْمِيز, شِفْرَة / كود, شِفْرَة\nمثال: العدالة مضمونة في الدستور.",
 "符節": "ركضة, نقطة (نقطة في البيسبول يسجلها العداء بلمس جميع القواعد الأربع بأمان) / إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي) / حساب, كشف الحساب (فاتورة بمبلغ مستحق)\nمثال: سجل فريق اليانكيز 3 ركضات في النصف الثاني من الشوط التاسع",
 "符鉤": "ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب.",
 "笧": "هَدَّار (\"صَوْتٌ هَدَّارٌ\" : مُجَلْجِلٌ قَوِيٌّ؛ \"مَطَرٌ هَدَّارٌ\" : هَاطِلٌ بِقُوَّةٍ) / رباط, وصلة تثبيت (وصلة تثبت الأشياء ببعضها البعض) / صفد, قيد (قيد يحد أو يقيد الحرية (خاصة شيء يستخدم لربط أو تقييد سجين)) / التصاق, تلاصق (خاصية الالتصاق معاً (كالغراء والخشب) أو انضمام أسطح مختلفة التكوين) / رابطة, رابطة كيميائية (قوة كهربائية تربط الذرات)\nمثال: الالتصاق المتبادل للخلايا",
 "第一": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / أَفْضَل / الأهم, قبل كل شيء (فوق كل اعتبار آخر) / أولاً وأخيراً, قبل كل شيء (بأخذ كل شيء معاً)\nمثال: قبل كل شيء، يجب أن تكون مستقلاً",
 "第一世界": "الْعَالَم الْأَوَّل",
 "第一人称": "مُتَكَلِّم",
 "第一原理": "ألفباء, مبادئ أولية (المراحل الأولية لأي موضوع)\nمثال: أتقن فقط مبادئ الهندسة الأولية",
 "第一号": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة.",
 "第一四半期": "التربيع الأوّل, التربيع المتزايد",
 "第一回": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة.",
 "第一声": "خطاب التنصيب (خطاب يلقى في مراسم التنصيب (خاصة من قبل رئيس الولايات المتحدة))",
 "第一子": "بِكْر (في : يُطلق على الحليب الذي يُحلب من أول مرة بعد الولادة)\nمثال: لا أفهم سبب ولعه بكرة القدم.",
 "第一度熱傷": "درجة أولى (درجة واحد)\nمثال: جميع الحدود في المعادلة الخطية هي من الدرجة الأولى",
 "第一次": "أَوَّلِيّ",
 "第一次世界大戦": "الْعَالَم الْأَوَّل",
 "第一次大戦": "الْعَالَم الْأَوَّل",
 "第一次性徴": "صفة جنسية أولية (الخصائص الجنسية المحددة وراثيًا والمرتبطة بالتكاثر (الأعضاء التناسلية وأعضاء التكاثر))",
 "第一歩": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)",
 "第一流": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "第一相試験": "المرحلة الأولى من التجارب السريرية (تجربة سريرية على عدد قليل من الأشخاص لتحديد سلامة دواء جديد)",
 "第一種": "بالدرجة الأولى (بواسطة وسائل نقل من الدرجة الأولى؛ مع إقامة من الدرجة الأولى) / درجة أولى (أغلى أماكن الإقامة على متن سفينة أو قطار أو طائرة) / درجة أولى (أعلى رتبة في التصنيف) / بريد الدرجة الأولى (بريد يشمل الرسائل والبطاقات البريدية والطرود المختومة ضد التفتيش)\nمثال: نسافر دائماً بالدرجة الأولى",
 "第一種郵便物": "بريد الدرجة الأولى (بريد يشمل الرسائل والبطاقات البريدية والطرود المختومة ضد التفتيش)",
 "第一級": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "第一線": "جَبْهَة / أَمَامِيّ",
 "第一義的": "أَسَاسِيّ",
 "第一言語": "اللغة الأصلية, اللغة الأم (اللغة الأصلية للفرد؛ اللغة التي يتعلمها الأطفال وتنتقل من جيل إلى جيل)",
 "第一趾": "إبهام القدم (الإصبع الأول الأكبر والأكثر تداخلًا في القدم)",
 "第一Ｑ": "التربيع الأوّل, التربيع المتزايد",
 "第七": "سَابِع, سَابِعَة / سُبْع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: عمره سبع سنوات.",
 "第三": "ثَالِث, ثَالِثَة / ثُلْث (ثَلَثَ الحبل ونحوه يَثْلُثُ ثَلْثًا: فَتَلَهُ من ثلاث قُوى؛ ثَلَثَ العمل: عمله ثلات مرات)\nمثال: الساعة العاشرة والثلث.",
 "第三の目": "عين ثالثة, عين صنوبرية (هيكل حسي قادر على استقبال الضوء يقع على الجانب الظهري للدماغ البيني في الزواحف المختلفة)",
 "第三セクター": "شَرِكَة مُحَاصَّة",
 "第三世界": "الْعَالَم الثَّالِث",
 "第三人称": "غَائِب",
 "第三債務者": "محجوز لديه (كاسب أجر يتم إبلاغه بأمر حجز على الراتب)",
 "第三帝国": "الرَّايْخ الثَّالِث",
 "第三度熱傷": "استجواب قسري, الدرجة الثالثة (استجواب يصاحبه غالبًا تعذيب لانتزاع معلومات أو اعتراف)",
 "第三政党": "حزب ثالث (حزب سياسي منظم في معارضة للأحزاب الرئيسية في نظام الحزبين) / طرف ثالث (شخص آخر غير الأطراف الرئيسية المشاركة في معاملة ما)",
 "第三次": "ثَالِث, ثَالِثَة / ثُلْث (ثَلَثَ الحبل ونحوه يَثْلُثُ ثَلْثًا: فَتَلَهُ من ثلاث قُوى؛ ثَلَثَ العمل: عمله ثلات مرات)\nمثال: الساعة العاشرة والثلث.",
 "第三次世界大戦": "اَلْحَرْبُ اَلْعَالَمِيَّةُ اَلثَّالِثَة",
 "第三相試験": "المرحلة الثالثة من التجارب السريرية (تجربة سريرية كبيرة لعلاج أو دواء ثبتت فعاليته في المرحلتين الأولى والثانية)",
 "第三種郵便物": "بريد الدرجة الثالثة (بريد يتكون من مواد مطبوعة مؤهلة لأسعار بريدية مخفضة)",
 "第三者": "حزب ثالث (حزب سياسي منظم في معارضة للأحزاب الرئيسية في نظام الحزبين) / طرف ثالث (شخص آخر غير الأطراف الرئيسية المشاركة في معاملة ما)",
 "第三者のためにする契約": "حزب ثالث (حزب سياسي منظم في معارضة للأحزاب الرئيسية في نظام الحزبين) / طرف ثالث (شخص آخر غير الأطراف الرئيسية المشاركة في معاملة ما)",
 "第三脳室": "بطين ثالث (بطين ضيق في المستوى المتوسط أسفل الجسم الثفني؛ يتصل بالبطين الرابع عبر قناة سيلفيان)",
 "第三階級": "الطبقة الثالثة, عامة الشعب (عامة الناس)",
 "第九": "تَاسِع, تَاسِعَة / تُسْع (الثَلَاثُ التُسَع: الليلة السابعة والثامنة والتاسعة من كل شهر قمري…)\nمثال: عمري تسعة عشر سنة",
 "第二": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "第二のふるさと": "بيت ثان, مسكن بديل (مكان تشعر فيه بالراحة والرضا كما لو كنت في منزلك)",
 "第二のわが家": "بيت ثان, مسكن بديل (مكان تشعر فيه بالراحة والرضا كما لو كنت في منزلك)",
 "第二の天性": "طبيعة ثانية (سلوك مكتسب تمت ممارسته لفترة طويلة لدرجة أنه يبدو فطريًا)",
 "第二の我が家": "بيت ثان, مسكن بديل (مكان تشعر فيه بالراحة والرضا كما لو كنت في منزلك)",
 "第二の故郷": "بيت ثان, مسكن بديل (مكان تشعر فيه بالراحة والرضا كما لو كنت في منزلك)",
 "第二人称": "مُخَاطَب",
 "第二帝政": "الإمبراطورية الثانية (الحكومة الإمبراطورية لنابليون الثالث في فرنسا من 1852-1870)",
 "第二次世界大戦": "الْحَرْبُ الْعَالَمِيَّةُ الثَّانِيَة",
 "第二次大戦": "الْحَرْبُ الْعَالَمِيَّةُ الثَّانِيَة",
 "第二次性徴": "صفة جنسية ثانوية (الخصائص الجنسية المحددة وراثيًا والتي ليست ضرورية وظيفيًا للتكاثر (مثل نبرة الصوت وشعر الجسم والعضلات))",
 "第二次性徴期": "بُلُوغ",
 "第二相試験": "المرحلة الثانية من التجارب السريرية (تجربة سريرية على أشخاص أكثر من المرحلة الأولى؛ تهدف إلى تقييم فعالية العلاج)",
 "第二種": "بالدرجة الثانية (بواسطة وسائل نقل الدرجة الثانية) / درجة ثانية, درجة سياحية (فئة من أماكن الإقامة على متن سفينة أو قطار أو طائرة أقل تكلفة من أماكن الدرجة الأولى) / درجة ثانية (ليس أعلى جودة في التصنيف) / درجة ثانية (ليست أعلى رتبة في التصنيف)\nمثال: سافرنا بالدرجة الثانية",
 "第二種郵便物": "مِنَ الدَّرَجَة الثَّانِيَة (ذو مكانة أو جودة أدنى)",
 "第二胃": "قَلَنْسُوَة (القُلُنْسُوَة: لباس داخلي للرأس يُلبس غالبا داخليا تحت العَمَامَة أو الكُوفِيَّة أو غيره من أغطية الرأس للرجال والنساء، يسمى أيضا الطَاقِيَّة؛ القُلُنْسُوَة: لباس للرأس يشبه الداخلي إلا أنه يلبس لوحده، قد يكون أبيضا وقد يكون مطرزا، يسمى أيضا الطَاقِيَّة)\nمثال: كان زيري يرتدي قلنسوة.",
 "第二言語": "لغة ثانية (لغة اكتسبها الشخص في مرحلة المراهقة أو في وقت لاحق)",
 "第五": "خَامِس, خَامِسَة / خُمْس ((خَمَسَ) المَال خمْسا: أَخذ خمسه؛ (خَمَسَ) فُلَانًا أَخذ خمس مَاله)\nمثال: رأيت خمسة رجال.",
 "第五列": "الطَّابُورُ الخَامِس",
 "第五趾": "خنصر القدم (الإصبع الخامس الأصغر والأكثر تطرفاً في القدم)",
 "第八": "ثَامِن, ثَامِنَة / ثُمْن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن.",
 "第八脳神経": "عصب دهليزي قوقعي, عصب سمعي (عصب حسي مركب يغذي الخلايا الشعرية للعضو الدهليزي والخلايا الشعرية للقوقعة)",
 "第六": "سَادِس, سَادِسَة / سُدْس",
 "第六感": "بصيرة, حاسة سادسة (إدراك الطبيعة الداخلية للأشياء بشكل حدسي)",
 "第十": "عَاشِر / عُشْر (الثَلَاثُ العُشَر: الليلة العاشرة والحادية عشر والثانية عشر من كل شهر قمري…)\nمثال: لدي عشرة أقلام.",
 "第四": "رَابِع, رَابِعَة (رابعوا الحمِلَ مرابعة: أدخلوا المِربَعة تحتهُ)\nمثال: زيري هو الرابع.",
 "第四次中東戦争": "حرب أكتوبر (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "第四胃": "إِنْفَحَة",
 "第四脳室": "بطين رابع (بطين غير منتظم بين البطين الثالث والقناة المركزية للحبل الشوكي)",
 "第四階級": "السلطة الرابعة, الصحافة (الصحافة، بما في ذلك الصحفيون وكتاب الصحف والمصورون)",
 "第１": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / أَفْضَل / الأهم, قبل كل شيء (فوق كل اعتبار آخر) / أولاً وأخيراً, قبل كل شيء (بأخذ كل شيء معاً)\nمثال: قبل كل شيء، يجب أن تكون مستقلاً",
 "第１四半期": "التربيع الأوّل, التربيع المتزايد",
