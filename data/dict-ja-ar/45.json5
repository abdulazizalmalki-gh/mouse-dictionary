 "矢郷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "矢野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "矢間": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "矢面": "الطليعة, خط المواجهة (المجموعة الأكثر تقدماً ومسؤولية في نشاط ما)\nمثال: خط المواجهة هو مكان الحدث / أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا",
 "矢面に立つ": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه.",
 "矢頭": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "矢鱈": "عَشْوَائِيّ",
 "知": "حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت.",
 "知ったかぶり屋": "مُتَعَالِم",
 "知ってのとおり": "كَمَا تَعْلَمُ",
 "知っての通り": "كَمَا تَعْلَمُ",
 "知は力なり": "اَلْمَعْرِفَة قُوَّة",
 "知らす": "أَخْبَرَ, أَبْلَغَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه. / عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "知らず": "بصرف النظر, جانباً (غير مأخوذ في الاعتبار أو مستبعد)\nمثال: بصرف النظر عن هذه المشاكل، البلاد تبلي بلاءً حسناً / أَنَا أَعْرِفُ",
 "知らず知らず": "لَاشُعُورِيًّا",
 "知らせ": "أَخْبَار, أَنْبَاء (أنباء ما قد حدث؛ نشرة الأخبار أو عرض الأخبار: ما يعرضه التلفاز أو الراديو من…)\nمثال: هذه أخبار طيبة. / فَأل, نَذِيْر",
 "知らせる": "أَخْبَرَ, أَبْلَغَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه.",
 "知らない": "مَجْهُول, مُبْهَم / لَا يَهُمُّنِي (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "知らぬが仏": "الْجَهْل نَعِيمَهُ, الْجَهْل نِعْمَة",
 "知らぬ顔": "تَجَاهَلَ, طَنَّش / لَامُبَالَاة",
 "知られざる": "مَجْهُول, مُبْهَم",
 "知らん顔": "تَجَاهَلَ, طَنَّش / لَامُبَالَاة",
 "知り人": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "知り合い": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "知る": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / حَاسَّة\nمثال: لديهم حس الفكاهة. / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ:…)\nمثال: ليلى تذكر سامي.",
 "知るか": "لَا يَهُمُّنِي (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "知るべ": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "知る人": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب. / عَاشِق, عَاشِقَة",
 "知る人ぞ知る": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "知る辺": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "知れた": "بَدِيهِيّ, بَدَهِيّ / تَافِه, حَقِير (صغير ولا يلفت الانتباه)",
 "知れ渡る": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "知ろしめす": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "知ろし召す": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "知ろし食す": "عَلِمَ, عَرَفَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
