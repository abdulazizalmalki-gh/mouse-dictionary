 "磁気テープ": "شريط مغناطيسي (جهاز ذاكرة يتكون من شريط بلاستيكي رفيع طويل مطلي بأكسيد الحديد؛ يستخدم لتسجيل…)\nمثال: أخذ معه دزينة من الأشرطة لتسجيل المقابلة",
 "磁気テープ記憶装置": "شريط مغناطيسي (جهاز ذاكرة يتكون من شريط بلاستيكي رفيع طويل مطلي بأكسيد الحديد؛ يستخدم لتسجيل…)\nمثال: أخذ معه دزينة من الأشرطة لتسجيل المقابلة",
 "磁気ディスク": "قرص مغناطيسي ((علم الحاسوب) جهاز ذاكرة يتكون من قرص مسطح مغطى بطبقة مغناطيسية يتم تخزين…)",
 "磁気ドラム": "أسطوانة مغناطيسية (أسطوانة مطلية بمادة مغناطيسية، لتخزين بيانات وبرامج الحاسوب)",
 "磁気ドラム記憶装置": "أسطوانة مغناطيسية (أسطوانة مطلية بمادة مغناطيسية، لتخزين بيانات وبرامج الحاسوب)",
 "磁気ヘッド": "رأس مغناطيسي (مغناطيس كهربائي (كما في مسجل الشريط) يحول التغيرات الكهربائية إلى تغيرات…)",
 "磁気モーメント": "عَزْم مَغْنَاطِيسِيّ",
 "磁気偏差": "اختلاف مغناطيسي, انحراف مغناطيسي (الزاوية (في موقع معين) بين الشمال المغناطيسي والشمال الحقيقي)",
 "磁気共鳴": "رنين مغناطيسي (رنين الإلكترونات أو الذرات أو الجزيئات أو الأنوية لترددات الإشعاع نتيجة لتكميم…)",
 "磁気共鳴断層撮影": "رنين مغناطيسي (رنين الإلكترونات أو الذرات أو الجزيئات أو الأنوية لترددات الإشعاع نتيجة لتكميم…)",
 "磁気共鳴映像法": "تصوير بالرنين المغناطيسي (استخدام الرنين المغناطيسي النووي للبروتونات لإنتاج صور كثافة البروتون)",
 "磁気共鳴画像": "تصوير بالرنين المغناطيسي (استخدام الرنين المغناطيسي النووي للبروتونات لإنتاج صور كثافة البروتون)",
 "磁気共鳴血管撮影": "رنين مغناطيسي (رنين الإلكترونات أو الذرات أو الجزيئات أو الأنوية لترددات الإشعاع نتيجة لتكميم…)",
 "磁気共鳴血管造影": "رنين مغناطيسي (رنين الإلكترونات أو الذرات أو الجزيئات أو الأنوية لترددات الإشعاع نتيجة لتكميم…)",
 "磁気共鳴診断装置": "تصوير بالرنين المغناطيسي (استخدام الرنين المغناطيسي النووي للبروتونات لإنتاج صور كثافة البروتون)",
 "磁気力": "جذب مغناطيسي, مغناطيسية (الانجذاب للحديد؛ يرتبط بالتيارات الكهربائية وكذلك المغناطيسات؛ ويتميز بمجالات…)",
 "磁気力線": "حقل مغناطيسي (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "磁気単極子": "أُحَادِيّ القُطْب المِغْنَاطِيسِيّ (جسيم افتراضي له قطب مغناطيسي واحد بدلاً من القطبين المعتادين)",
 "磁気双極子": "ثنائي قطب مغناطيسي (ثنائي قطب بأقطاب مغناطيسية متضادة)",
 "磁気圏": "غلاف مغناطيسي (المجال المغناطيسي لكوكب؛ الحجم حول الكوكب الذي تخضع فيه الجسيمات المشحونة…)",
 "磁気子午線": "خط الزوال المغناطيسي (خط وهمي يمر عبر كلا القطبين المغناطيسيين للأرض)",
 "磁気学": "علم المغناطيسية, مغناطيسية (فرع العلوم الذي يدرس المغناطيسية)",
 "磁気嵐": "عاصفة مغناطيسية (اضطراب مفاجئ في المجال المغناطيسي للأرض؛ ناتج عن انبعاث جسيمات من الشمس)",
 "磁気抵抗率": "ممانعة مغناطيسية ((في الفيزياء) مقاومة المادة لإنشاء مجال مغناطيسي فيها)",
 "磁気機雷": "لغم مغناطيسي ((بحري) لغم بحري يتم تفجيره بواسطة آلية تستجيب للمواد المغناطيسية (مثل الهيكل…)",
 "磁気流体力学": "ديناميكا الموائع المغناطيسية (دراسة تفاعل المجالات المغناطيسية والموائع الموصلة للكهرباء (مثل البلازما أو…)",
 "磁気浮上": "رفع مغناطيسي, ماجليف (تكنولوجيا سكك حديدية عالية السرعة؛ حيث يُعلق القطار على وسادة مغناطيسية فوق…)",
 "磁気能率": "عَزْم مَغْنَاطِيسِيّ",
 "磁気記憶装置": "تخزين مغناطيسي, وسيط تخزين مغناطيسي (أي وسيط تخزين تُستخدم فيه أنماط مختلفة من المغنطة لتمثيل البتات أو البايتات…)\nمثال: القرص الصلب في جهاز الكمبيوتر الخاص بك هو تخزين مغناطيسي",
 "磁気誘導": "شدة المجال المغناطيسي, كثافة التدفق المغناطيسي (كمية التدفق المغناطيسي في وحدة مساحة عمودية على اتجاه التدفق المغناطيسي)",
 "磁流鉄鉱": "بايريت مغناطيسي, بيروتيت",
 "磁界": "حقل مغناطيسي (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "磁界強度": "حقل مغناطيسي (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "磁石": "مَغْنَاطِيس / بُوصُّلَة (البُوصَلَة أو البَوصَلَة : أَدَاة تسمَح بتحديد الاتجاهات)",
 "磁石盤": "بوصلة مغناطيسية (بوصلة تعتمد على مؤشر (مثل إبرة مغناطيسية) يشير إلى الشمال المغناطيسي)",
 "磁硫鉄鉱": "بايريت مغناطيسي, بيروتيت",
 "磁製": "خَزَف (خَزَفَ في مَشْيه يَخْزِفُ خَزْفًا: رفع يدَه ووَضعها؛ خَزَفَ الثوبَ: خَرَقه…)",
 "磁針": "إبرة مغناطيسية (مغناطيس رفيع معلق في بوصلة مغناطيسية على حامل باحتكاك قليل؛ يستخدم للإشارة إلى…)",
 "磁鉄鉱": "ماغنيتيت, مغناطيس طبيعي (أكسيد حديد ينجذب بقوة للمغناطيس)",
 "磁鉱": "طين صيني, كاولين (طين ناعم عادة ما يكون أبيض ناتج عن تجوية المعادن الألومينية (مثل الفلسبار)…) / ماغنيتيت, مغناطيس طبيعي (أكسيد حديد ينجذب بقوة للمغناطيس)",
 "磁電管": "ماجنترون, مغناطيسون (أنبوب مفرغ ثنائي الصمام يتم فيه التحكم في تدفق الإلكترونات من كاثود مركزي إلى…)",
 "磊々落々": "صَرِيح, مُنْفَتِحُ القَلْب (يتواصل بحرّيّة وصراحة ومباشرة)",
 "磊塊": "ساخط, غير راضٍ (يظهر أو يمر بعدم الرضا أو الشوق القلق)\nمثال: رأى العديد من الوجوه الساخطة في الغرفة",
 "磊嵬": "ساخط, غير راضٍ (يظهر أو يمر بعدم الرضا أو الشوق القلق)\nمثال: رأى العديد من الوجوه الساخطة في الغرفة",
 "磊磈": "ساخط, غير راضٍ (يظهر أو يمر بعدم الرضا أو الشوق القلق)\nمثال: رأى العديد من الوجوه الساخطة في الغرفة",
 "磊磊落落": "صَرِيح, مُنْفَتِحُ القَلْب (يتواصل بحرّيّة وصراحة ومباشرة)",
 "磊落": "إِفْرَنْجِيّ",
 "磐": "صَخْرَة, حجر / جُرْفٌ (أخذ شيئًا وجرفه بعيدًا، أو سحب شيئًا بقوة؛ في : في بعض الحالات، قد تستخدم…)\nمثال: وقف على حافة الجرف.",
 "磐境": "ضَرِيح",
 "磐石": "ثَبَات",
 "磔": "صَلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "磔刑": "صَلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "磔刑像": "وضعية الصليب (تمرين جمباز يُؤدى على الحلقات عندما يدعم لاعب الجمباز نفسه بذراعين ممدودتين…)",
 "磔柱": "صَلِيب\nمثال: عبر جرذ الطريق.",
 "磚": "طُوبَة, لَبِنَة",
 "磠砂": "كلوريد الأمونيوم, ملح النشادر (ملح أبيض يستخدم في الخلايا الجافة)",
 "磨き": "بُولَنْدِيّ / تَحْسِين",
 "磨きこむ": "بُولَنْدِيّ",
 "磨きをかける": "مسن دقيق (حجر شحذ مصنوع من الحجر الرملي الدقيق؛ يستخدم لشحذ شفرات الحلاقة) / بُولَنْدِيّ",
 "磨きを掛ける": "مسن دقيق (حجر شحذ مصنوع من الحجر الرملي الدقيق؛ يستخدم لشحذ شفرات الحلاقة) / بُولَنْدِيّ",
 "磨き液": "بُولَنْدِيّ",
 "磨き立てる": "بُولَنْدِيّ",
 "磨き紙": "ورق صنفرة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "磨き込む": "بُولَنْدِيّ",
 "磨く": "بُولَنْدِيّ / حَسَّنَ (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "磨ぐ": "شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو…) / غَسَلَ (معنى غَسَّلَ، بِالتَّشْدِيدِ، اغْتَسَلَ بعدَ الجِمَاع، ثمّ اغْتسلَ…)\nمثال: سأذهب لغسل يدي. / مجرف, مكان محفور (مكان تم حفره (خاصة بالمياه الجارية))",
 "磨りつぶす": "خلطة علفية, هريس (خليط من أعلاف الحيوانات المطحونة) / فَقَدَ\nمثال: خسر توم وظيفته.",
 "磨りガラス": "زجاج مصنفر (زجاج يشتت الضوء بسبب خشونة سطحه الناتجة عن الكشط أو الحفر)",
 "磨り出し": "تلميع, صقل (عمل جعل الشيء أملساً ولامعاً عن طريق فركه أو تشميعة)\nمثال: وفر تلميع الأحذية عيشاً ضئيلاً / مُبَارَاة",
 "磨り出す": "بُولَنْدِيّ",
 "磨り消す": "مَحَا, مَحَى",
 "磨り減らす": "كَشَطَ, قَشَطَ",
 "磨り潰す": "خلطة علفية, هريس (خليط من أعلاف الحيوانات المطحونة) / فَقَدَ\nمثال: خسر توم وظيفته.",
 "磨損": "إهلاك, استهلاك (انخفاض في قيمة أصل ما بسبب التقادم أو الاستخدام)",
 "磨石": "مِسَنّ, مِجْلَخَة",
 "磨研紙": "ورق صنفرة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "磨砕": "صرير, طحن (صوت خشن وحاد (مثل صوت طحن التروس))\nمثال: سحالة الخضروات سدت المصرف",
 "磨羯宮": "بُرْج اَلْجَدْي (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "磨耗": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "磨面": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)\nمثال: هناك ثقوب على السطح.",
 "磬": "تشينغ, سلالة تشينغ (آخر سلالة إمبراطورية للصين (من 1644 إلى 1912) والتي أطاح بها الثوار؛ خلال سلالة…)",
 "磯": "شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة)…)\nمثال: عاد إلى الشاطئ.",
 "磯い": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا) / صَارِم",
 "磯べ": "سَاحِل, شَاطِئ",
 "磯城島": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "磯巾着": "شَقِيقَة نُعْمَانِ اَلْبَحْرِ (مؤنث الشَقِيْق، وهو كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر. الجمع شَقَائِق…)",
 "磯村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "磯波": "تكسر الأمواج, موج متكسر (أمواج تتكسر على الشاطئ)",
 "磯辺": "سَاحِل, شَاطِئ",
 "磯部": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "磯野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "磯釣": "صيد الأمواج (رمي طعم (صناعي) بعيداً في المحيط (حتى 200 ياردة) مع تكسر الأمواج حولك)",
 "磯釣り": "صيد الأمواج (رمي طعم (صناعي) بعيداً في المحيط (حتى 200 ياردة) مع تكسر الأمواج حولك)",
 "礁": "شَعَاب",
 "礎": "حجر الأساس (حجر يوضع في حفل لتدشين تأسيس مبنى جديد)",
 "礎石": "حجر الأساس (حجر يوضع في حفل لتدشين تأسيس مبنى جديد)",
 "礙子": "عازل, مادة عازلة (مادة مثل الزجاج أو الخزف ذات موصلية كهربائية أو حرارية مهملة)",
 "礦石": "رِكَاز, خَامَة",
 "礪茶": "بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر)",
 "礫": "حَصَاة / حَجَر, حجر (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر. / حَصَى, حَصْبَاء (الحَصَى: صِغارُ الْحِجَارَةِ، الواحدةُ مِنْهُ حَصَاة. ابْنُ سِيدَهْ: الحَصَاة…)",
 "礫岩": "تَجْمِيعِيّ, مُتَكَتِّل (مؤلف من عناصر متباينة مجتمعة في كتلة واحدة)",
 "礬土": "أكسيد الألمنيوم, ألومينا (أي من أشكال أكسيد الألمنيوم المختلفة التي توجد بشكل طبيعي مثل الكورندوم)",
 "示し": "دَرْس, حِصَّة ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: أراك بعد الدرس. / وَحْي, تَنْزِيل (الإعلام في الخفاء، وهذا أصل الكلمة؛ الإلهام، سواء كان غريزيّ أو فطريّ أو فنيّ…)\nمثال: يا رسول الله، كيف يأتيك الوحي ؟",
 "示し合せる": "تَآمَرَ, اِئْتَمَرَ",
 "示し合わす": "تَآمَرَ, اِئْتَمَرَ",
 "示し合わせる": "تَآمَرَ, اِئْتَمَرَ",
 "示す": "تَظَاهَر, احْتَجَّ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر…)\nمثال: تظاهر بأنه طبيب. / أَشَارَ / دَلَّ عَلَى, رَمَزَ إِلَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: بدل سامي ملابسه.",
 "示唆": "اِقْتِرَاح, مُقْتَرَح",
 "示唆的": "إِيحَائِيّ, مُوحٍ (يميل إلى الإيحاء بشيء غير لائق أو فاحش)",
 "示圧計": "مقياس الضغط (مقياس لقياس ضغط السوائل والإشارة إليه)",
 "示威": "مُظَاهَرَة, تَظَاهُر (مُظَاهَرَة من أجل تحقيق هدف معين ٠)\nمثال: قرابة الألف شاركوا في المظاهرة.",
 "示威行為": "مُظَاهَرَة, تَظَاهُر (مُظَاهَرَة من أجل تحقيق هدف معين ٠)\nمثال: قرابة الألف شاركوا في المظاهرة.",
 "示威運動": "مُظَاهَرَة, تَظَاهُر (مُظَاهَرَة من أجل تحقيق هدف معين ٠)\nمثال: قرابة الألف شاركوا في المظاهرة.",
 "示導動機": "لايت موتيف, لحن دال (جملة لحنية تصاحب ظهور شخص أو موقف معين (كما في أوبرا فاغنر))",
 "示差": "تفاضلي, فارقي (متعلق بـ أو يظهر فرقاً واختلافاً)\nمثال: معاملة تفاضلية",
 "示差的特徴": "خاصية فارقة, سمة مميزة (خاصية غريبة أو غير عادية)",
 "示度": "قراءة, قراءة العداد (بيان حول حالة فيزيائية معينة يتم تقديمه للمستخدم بواسطة عداد أو أداة مماثلة)\nمثال: لم يصدق قراءة العداد",
 "示性値": "رَقَم الجَوْدَة, مُعَامِل الجَدَارَة (تعبير رقمي يمثل كفاءة نظام أو مادة أو إجراء معين)",
 "示指": "سبابة (الإصبع المجاور للإبهام)",
 "示教": "تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على…)\nمثال: هو بارع في التعليم.",
 "示準化石": "أحفورة مرشدة (أحفورة معروفة بأنها عاشت في عصر جيولوجي معين ويمكن استخدامها لتأريخ طبقة الصخور…)",
 "示現": "مُظَاهَرَة (عرض عام للمشاعر الجماعية (عادة ذات طابع سياسي))\nمثال: كانت هناك مظاهرات عنيفة ضد الحرب",
 "示達": "دليل التعليمات, كتيب التعليمات (دليل يرافق عادة جهازاً تقنياً ويشرح كيفية تثبيته أو تشغيله)",
 "礼": "شُكْرًا / آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير / قَوْس, قوس / مُكَافَأَة, ثَوَاب",
 "礼す": "عِبَادَة\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "礼には及ばない": "عَفْوًا",
 "礼やか": "أَدِيب, مُؤَدَّب",
 "礼を言う": "شَكَرَ ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ:…)\nمثال: شكر ياني أسرته.",
 "礼事": "آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير",
 "礼儀": "آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير",
 "礼儀作法": "ذَوْق, آدَاب (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ…)\nمثال: أكره ذوق الكحول.",
 "礼儀正しい": "مُهَذَّب, مُؤَدَّب",
 "礼儀正しさ": "أَدَب (هو الظُرْف وحسن التَنَاوُل أو التَصَرُّف، أو هو مَلَكَة تعصم من كانت به عما…)\nمثال: زيري يحب الأدب.",
 "礼儀知らず": "فَظّ",
 "礼典": "ذَوْق, آدَاب (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ…)\nمثال: أكره ذوق الكحول.",
 "礼奏": "فقرة إضافية (أداء إضافي أو متكرر؛ يُعطى عادة استجابة لطلب الجمهور)",
 "礼式": "ذَوْق, آدَاب (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ…)\nمثال: أكره ذوق الكحول.",
 "礼拝": "عِبَادَة\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "礼拝堂": "مُصَلًّى, كَنِيسَة (موضع الصلاة للشخص والجماعة؛ غرفة تخصص للصلاة في الأماكن العامّة، لا إمام فيها…)",
 "礼拝式": "خدمة دينية, صلاة جماعية (فعل العبادة العامة باتباع قواعد مقررة)\nمثال: خدمة الأحد",
 "礼拝所": "مَعْبَد",
 "礼服": "فستان منزلي صباحي (فستان نسائي غير رسمي للأعمال المنزلية)",
 "礼法": "ذَوْق, آدَاب (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ…)\nمثال: أكره ذوق الكحول.",
 "礼物": "هَدِيَّة, هدية",
 "礼状": "إِقْرَار, اعْتِرَاف (بيان يقر بشيء أو بشخص ما)\nمثال: لا بد أنها رأته لكنها لم تبد أي علامة إقرار بذلك",
