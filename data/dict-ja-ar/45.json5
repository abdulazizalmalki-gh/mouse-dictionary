 "祝福": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال. / بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها)\nمثال: البركة عميقة جدا.",
 "祝融": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "祝言": "احتفال, مهرجان (أي نشاط ترفيهي بهيج) / عُرْس, زِفَاف",
 "祝賀": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "祝賀会": "اِحْتِفَال (إقامة مراسم أو فعاليات تعبيرًا عن مناسبة معينة)\nمثال: لم يحضر الاحتفال.",
 "神": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب. / غير معقول, لا يصدق (يتجاوز التصديق أو الفهم)\nمثال: بسرعة لا تصدق / قَيْصَر, إِمْبْرَاطُور / رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو…)\nمثال: البرق يسبق الرعد / رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة. / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب. / رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة. / إِلٰهِيّ\nمثال: هذا الرجل تاجر.",
 "神々": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "神々しい": "إِلٰهِيّ\nمثال: هذا الرجل تاجر.",
 "神々の黄昏": "راغناروك, شفق الآلهة (أسطورة حول الدمار النهائي للآلهة في معركة مع قوى الشر)",
 "神かけて": "مطلقا, على الإطلاق",
 "神がかり": "غَرَابَة الأَطْوَار (سلوك غريب وغير تقليدي)\nمثال: الدائرة هي قطع ناقص ذو اختلاف مركزي صفري",
 "神さま": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب. / آس (نوع نباتي من جنس الآس من الفَصِيلَة الآسيّة. وهو شجر دائم الخُضْرَة، بيضيّ…)\nمثال: لدي الآس الكوبا.",
 "神さん": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "神とあがめる": "أَلَّهَ (أَلِهَ فلانٌ يَأْلَهُ إِلاَهَةً، وأُلُوهَةً، وألوهِيّةً: تحيَّر؛ أَلِهَ…)",
 "神と崇める": "أَلَّهَ (أَلِهَ فلانٌ يَأْلَهُ إِلاَهَةً، وأُلُوهَةً، وألوهِيّةً: تحيَّر؛ أَلِهَ…)",
 "神に召される": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "神のみ子": "اِبْن اللَّٰه (الولد الذكر)\nمثال: هو له ابن صغير.",
 "神の使い": "رسول إلهي (رسول من عند الله)\nمثال: إنهم كائنات خارقة للطبيعة تعمل كرسل إلهيين بين الناس والآلهة",
 "神の命": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "神の国": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "神の子": "اِبْن اللَّٰه (الولد الذكر)\nمثال: هو له ابن صغير. / مَسِيحِيّ, مَسِيحِيَّة (المنسوب إلى المَسِيْح عليه السلام؛ المنسوب إلى الدين المسيحي، النَصْرَانِي)\nمثال: زيري صهيوني مسيحي. / أُعْجُوبَة",
 "神の子羊": "حَمَلُ اَللهِ (رَفَعَ، أَقَلَّ)",
 "神の御子": "اِبْن اللَّٰه (الولد الذكر)\nمثال: هو له ابن صغير.",
 "神の思し召し": "إرادة إلهية, مشيئة الله (القدرة المطلقة لكائن إلهي)",
 "神の思召": "إرادة إلهية, مشيئة الله (القدرة المطلقة لكائن إلهي)",
 "神の思召し": "إرادة إلهية, مشيئة الله (القدرة المطلقة لكائن إلهي)",
 "神の愛": "أغابي, وليمة المحبة (وجبة دينية مشتركة كعلامة على الحب والزمالة)",
 "神の手": "سَيِّد\nمثال: يبدو زيري أحسن.",
 "神の民": "شعب الله المختار (أي شعب يعتقد أن الله اختاره)",
 "神の王国": "ملكوت الله (المجال الروحي الذي يخضع لسيادة الله)",
 "神の言": "كَلَام اللّٰهِ / كلمة الله (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ:…)\nمثال: كلمة السر طويلة.",
 "神の言葉": "كَلَام اللّٰهِ / كلمة الله (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ:…)\nمثال: كلمة السر طويلة.",
 "神も仏もない": "هُنَاكَ, يُوجَدُ",
 "神わざ": "مُعْجِزَة, أُعْجُوبَة",
 "神主": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "神事": "مُعْجِزَة, أُعْجُوبَة",
 "神人": "كَاهِن, قِسِّيس",
 "神仙": "كائن خارق للطبيعة, كيان روحي (كائن غير مادي يُعتقد أن له قوى تؤثر على مسار الأحداث البشرية)",
 "神仙菜": "خس البحر (عشب بحري ذو سعف أخضر مجعد شفاف صالح للأكل)",
 "神代": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "神位": "إِلَٰهِيَّة",
 "神作": "تُحْفَة, رَائِعَة",
 "神使": "رسول إلهي (رسول من عند الله)\nمثال: إنهم كائنات خارقة للطبيعة تعمل كرسل إلهيين بين الناس والآلهة",
 "神像": "صَنَم, وَثَن (الصَّنَم: نَحْتٌ من خَشَبٍ ويُصَاغُ من نُحاسٍ، وغيره يُصنع لعبادته. ويُسمى…)",
 "神出鬼没": "متملص, مراوغ",
 "神判": "محاكمة بالتعذيب, محنة (طريقة بدائية لتحديد ذنب أو براءة الشخص عن طريق تعريض المتهم لاختبارات خطيرة أو…)",
 "神勅": "كَاهِن, عَرَّاف",
 "神化": "تَأْلِيه",
 "神占": "تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة)",
 "神原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "神司": "كَاهِن, قِسِّيس",
 "神品": "تُحْفَة, رَائِعَة",
 "神国": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "神域": "قدس الأقداس, منطقة المذبح (المنطقة المحيطة بمذبح الكنيسة لرجال الدين والجوقة؛ غالباً ما تكون محاطة بسياج…)",
 "神壇": "مَذْبَح, هَيْكَل",
 "神変": "مُعْجِزَة, أُعْجُوبَة",
 "神奈川": "كَانَاغَاوَا",
 "神奈川沖浪裏": "لَوَّحَ, رَفْرَفَ",
 "神女": "إِلَاهَة, إِلٰهَة",
 "神妙": "خَنُوع, مُسْتَكِين (يُظْهِر قِلَّة فِي الشَّجَاعَة؛ مُفْرِط فِي الِامْتِثَال) / غَامِض",
 "神威": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "神媒": "أَفَاتَار",
 "神子": "صبية, فتاة (فتاة أو شابة غير متزوجة)",
 "神学": "إِلٰهِيَّات",
 "神学士": "دكتوراه في اللاهوت (درجة الدكتوراه في الدراسات الدينية)",
 "神学校": "مدرسة بنات, مدرسة خاصة (مكان خاص لتعليم الصغار)",
 "神学者": "عَالِم لَاهُوت, لَاهُوتِيّ (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "神官": "كَاهِن, قِسِّيس",
 "神官文字": "كَهَنُوتِيّ, هِيرَاطِيقِيّ (يلتزم بأنماط وأساليب ثابتة؛ شديد التقييد والرسمية)\nمثال: نص مصري هيراطيقي",
 "神宮寺": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "神尾": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "神山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "神崎": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "神州": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "神巫": "سَاحِرَة",
 "神性": "إِلَٰهِيَّة",
 "神憑り": "غَرَابَة الأَطْوَار (سلوك غريب وغير تقليدي)\nمثال: الدائرة هي قطع ناقص ذو اختلاف مركزي صفري",
 "神懸かり": "غَرَابَة الأَطْوَار (سلوك غريب وغير تقليدي)\nمثال: الدائرة هي قطع ناقص ذو اختلاف مركزي صفري",
 "神懸り": "غَرَابَة الأَطْوَار (سلوك غريب وغير تقليدي)\nمثال: الدائرة هي قطع ناقص ذو اختلاف مركزي صفري",
 "神戸": "كُوبِه",
 "神戸情報大学院大学": "كلية الدراسات العليا (مدرسة في جامعة تقدم دراسة تؤدي إلى درجات علمية تتجاوز درجة البكالوريوس)",
 "神掛けて": "مطلقا, على الإطلاق",
 "神政": "ثِيُقْرَاطِيَّة",
 "神教": "ألوهية, إيمان بوجود إله (العقيدة أو الإيمان بوجود إله أو آلهة)",
 "神明": "إِلٰه, مَعْبُود (كل ما اتُّخِذَ معبودًا)\nمثال: يؤمن فاضل بإله الإسلام. / أَمَاتِيرَاسُو",
 "神明裁判": "محاكمة بالتعذيب, محنة (طريقة بدائية لتحديد ذنب أو براءة الشخص عن طريق تعريض المتهم لاختبارات خطيرة أو…)",
 "神智学": "الحكمة الإلهية, ثيوصوفيا (نظام عقائدي يقوم على البصيرة الصوفية في طبيعة الله والروح)",
 "神村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "神格": "إِلَٰهِيَّة",
 "神格化": "تَأْلِيه",
 "神業": "مُعْجِزَة, أُعْجُوبَة",
 "神楽": "كاغورا (رقصة فخمة من ديانة الشنتو تشكل الآن جزءاً من مهرجانات القرى اليابانية)\nمثال: تُعد الكاغورا، وخاصة تلك الأشكال التي تتضمن سرد القصص أو إعادة تمثيل الخرافات، أحد التأثيرات الأساسية على مسرح نو",
 "神楽坂": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "神様": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب. / آس (نوع نباتي من جنس الآس من الفَصِيلَة الآسيّة. وهو شجر دائم الخُضْرَة، بيضيّ…)\nمثال: لدي الآس الكوبا.",
 "神権": "الحق الإلهي, الحق الإلهي للملوك (المذهب القائل بأن الملوك يستمدون حقهم في الحكم مباشرة من الله ولا يخضعون…)\nمثال: تم الإعلان عن مذهب الحق الإلهي للملوك من قبل عائلة ستيوارت في بريطانيا في القرن السادس عشر",
 "神権政治": "ثِيُقْرَاطِيَّة",
 "神樹": "شجرة القطن الحريري, قابوق (شجرة استوائية ضخمة ذات تلال عميقة على جذعها الضخم وتحمل قروناً كبيرة من البذور…)",
 "神樹蚕": "عثة سينثيا (عثة آسيوية كبيرة أُدخلت إلى الولايات المتحدة؛ تتغذى اليرقات على شجرة السماء)",
 "神武以来": "غَيْر مَسْبُوق (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "神殺し": "قَتْل إِلٰه (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "神殿": "مَعْبَد\nمثال: この神殿は建てるのに４６年かかりました。 — في ست وأربعين سنة بني هذا الهيكل.",
 "神気": "طاقة تشي, كي (طاقة الحياة المتداولة التي يعتقد في الفلسفة الصينية أنها كامنة في كل شيء؛ في…) / كُحُول, خَمْر (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ…)\nمثال: أكره ذوق الكحول.",
 "神洲": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "神渡": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "神漿": "أمبروزيا, طعام الآلهة ((الأساطير الكلاسيكية) طعام وشراب الآلهة؛ البشر الذين أكلوه أصبحوا خالدين)",
 "神無月": "أَكْتُوبَر, تِشْرِين الْأَوَّل (الشهر العاشر في السنة الميلادية الروميّة)\nمثال: أراك في شهر أكتوبر.",
 "神父": "رئيس دير (رئيس دير فرنسي)",
 "神田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "神的": "إِلٰهِيّ\nمثال: هذا الرجل تاجر.",
 "神神": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "神神しい": "إِلٰهِيّ\nمثال: هذا الرجل تاجر.",
 "神祠": "ضَرِيح",
 "神福": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "神秘": "سِرّ (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "神秘主義": "تصوف, غموضية (فكر غامض أو غير عقلاني)",
 "神秘劇": "مسرحية الأسرار (مسرحية من القرون الوسطى تمثل حلقات من حياة المسيح)",
 "神秘化": "تضليل, تعمية (نشاط حجب فهم الناس وتركهم في حيرة أو ارتباك)",
 "神秘学": "تنجيم, علوم خفية (اعتقاد بوجود قوى خارقة للطبيعة وإمكانية إخضاعها للسيطرة البشرية)",
 "神秘性": "جَاذِبِيَّة غَامِضَة, سِحْر غَامِض (هالة من القيمة العالية أو الاهتمام أو المعنى تحيط بشخص أو شيء)",
 "神秘的": "غَامِض",
 "神秘的雰囲気": "جَاذِبِيَّة غَامِضَة, سِحْر غَامِض (هالة من القيمة العالية أو الاهتمام أو المعنى تحيط بشخص أو شيء)",
 "神立": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو…)",
 "神童": "طفل عبقري (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان…)\nمثال: هو طفل العائلة.",
 "神符": "تَمِيمَة, أُخْذَة",
 "神経": "عَصَب / أعصاب, ثبات (التحكم في العواطف)\nمثال: هذا النوع من التوتر ليس جيداً لأعصابي",
 "神経が細い": "مُفْرِط الحَسَاسِيَّة (حسّاس بشكل مبالغ فيه)",
 "神経が細かい": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "神経が鋭い": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "神経の可塑性": "اللُّدُونة العصبية",
 "神経の細い": "مُفْرِط الحَسَاسِيَّة (حسّاس بشكل مبالغ فيه)",
 "神経の鈍い": "غير حساس, متبلد الحس (غير مستجيب للمحفزات الجسدية)\nمثال: غير حساس للإشعاع",
 "神経の鋭い": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "神経を使う": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "神経インパルス": "سيال عصبي, نبضة عصبية (التفريغ الكهربائي الذي ينتقل عبر الليف العصبي)\nمثال: أثبتوا انتقال النبضات من القشرة الدماغية إلى منطقة تحت المهاد",
 "神経ガス": "غَاز أَعْصَاب, عَامِل أَعْصَاب",
 "神経ホルモン": "هرمون عصبي (هرمون يتم إطلاقه بواسطة نبضات عصبية (مثل النورإبينفرين أو الفازوبريسين))",
 "神経中枢": "مركز, مركز عصبي (مجموعة من الخلايا العصبية تتحكم في عملية جسدية محددة)\nمثال: في معظم الناس يقع مركز الكلام في نصف الكرة الأيسر",
 "神経伝達物質": "نَاقِل عَصَبِيّ",
 "神経元": "عَصْبُون, خَلِيَّة عَصَبِيَّة",
 "神経内分泌": "عصبي صماوي (متعلق بالجهازين العصبي والصماوي (خاصة في وظيفتهما المشتركة))",
 "神経内科": "طب الأعصاب, طب الجهاز العصبي (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "神経剤": "عامل أعصاب, غاز الأعصاب (غاز سام يتم استنشاقه أو امتصاصه عبر الجلد وله آثار ضارة على الجهاز العصبي…)",
 "神経単位": "عَصْبُون, خَلِيَّة عَصَبِيَّة",
 "神経叢": "ضفيرة عصبية (شبكة من الأعصاب المتقاطعة)",
 "神経可塑性": "اللُّدُونة العصبية",
 "神経周膜": "حول العصب, غمد الحزمة العصبية (غمد من النسيج الضام يغطي حزمة من الألياف العصبية)",
 "神経回路": "شبكة عصبية (أي شبكة من الخلايا العصبية أو النوى التي تعمل معاً لأداء وظيفة ما في الجسم)",
 "神経回路網": "شبكة عصبية (أي شبكة من الخلايا العصبية أو النوى التي تعمل معاً لأداء وظيفة ما في الجسم)",
 "神経堤": "عُرْف عَصَبِيّ (عَلِمَ؛ سَكَنَ إلى الشيءِ، أَنَسَهُ وأَلِفَه)\nمثال: من عرف نفسه فقد عرف ربه.",
 "神経外科": "جراحة الأعصاب (أي جراحة تتعلق بالجهاز العصبي (الدماغ أو الحبل الشوكي أو الأعصاب المحيطية))",
 "神経多様性": "تَنَوُّع عَصَبِيّ",
 "神経学": "طب الأعصاب, طب الجهاز العصبي (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "神経学者": "أخصائي أعصاب, طبيب أعصاب (أخصائي طبي في الجهاز العصبي والاضطرابات التي تؤثر عليه)",
 "神経心理学": "علم النفس العصبي, علم النفس الفسيولوجي (فرع علم النفس المعني بالأسس الفسيولوجية للعمليات النفسية)",
 "神経性": "عَصَبِيّ",
 "神経性大食症": "الشره المرضي العصبي, النهام العصبي (اضطراب في الأكل يتناوب فيه الشخص بين رغبة قوية في الطعام ونفور منه؛ يتميز…)",
 "神経性無食欲症": "فقدان الشهية العصبي ((الطب النفسي) اضطراب نفسي يتميز بأوهام جسدية بأن الشخص سمين جداً رغم كونه…)",
 "神経戦": "حرب أعصاب, حرب نفسية (استخدام تكتيكات نفسية لتدمير معنويات الخصوم)",
 "神経支配": "إِمْدَاد عَصَبِيّ, تَعْصِيب (توزيع الألياف العصبية على عضو أو منطقة في الجسم)",
 "神経核": "عَصْبُون, خَلِيَّة عَصَبِيَّة",
 "神経梅毒": "زهري عصبي (زهري يصيب الجهاز العصبي المركزي)",
 "神経毒": "ذيفان عصبي, سم عصبي (أي سم يؤثر على الأنسجة العصبية)",
 "神経炎": "التهاب العصب (التهاب العصب مصحوب بألم وأحياناً فقدان الوظيفة)",
 "神経生物学": "بيولوجيا عصبية (فرع علم الأحياء الذي يتعامل مع تشريح وفسيولوجيا وباثولوجيا الجهاز العصبي)",
 "神経生理学": "فسيولوجيا عصبية (فرع علم الأعصاب الذي يدرس فسيولوجيا الجهاز العصبي)",
 "神経病": "اضطراب عصبي, مرض عصبي (اضطراب في الجهاز العصبي)",
 "神経症": "اضطراب عصبي, مرض عصبي (اضطراب في الجهاز العصبي)",
 "神経症的": "عصابي, مريض نفسياً (مصاب باضطراب عاطفي)\nمثال: اضطراب عصابي",
 "神経痛": "ألم عصبي (ألم تشنجي حاد على طول مسار عصب واحد أو أكثر)",
 "神経科": "طب الأعصاب, طب الجهاز العصبي (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "神経科医": "أخصائي أعصاب, طبيب أعصاب (أخصائي طبي في الجهاز العصبي والاضطرابات التي تؤثر عليه)",
 "神経科学": "عُلُوم عَصَبِيَّة, عِلْم الأَعْصَاب (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: علم، عُلُوْم)\nمثال: الصبر أم العلوم.",
 "神経科学者": "عالم أعصاب (عالم أحياء عصبية يتخصص في دراسة الدماغ)",
 "神経筋": "عصبي عضلي (يؤثر على أو يميز كلا من الأنسجة العصبية والعضلية)",
 "神経筋接合部": "مشبك عصبي عضلي (الوصلة بين الليف العصبي والعضلة التي يغذيها)",
 "神経管": "أنبوب عصبي (أنبوب من نسيج الأديم الظاهر في الجنين يتطور منه الدماغ والحبل الشوكي)",
 "神経節": "عُقْدَة عَصَبِيَّة",
 "神経精神医学": "طب النفس العصبي (فرع الطب المعني بالاضطرابات العقلية المنسوبة لأمراض الجهاز العصبي)",
 "神経系": "جِهَاز عَصَبِيّ",
 "神経細胞": "عَصْبُون, خَلِيَّة عَصَبِيَّة",
 "神経細胞体": "عَصْبُون, خَلِيَّة عَصَبِيَّة",
 "神経終末": "نهاية عصبية (الهيكل الطرفي للمحور العصبي الذي لا ينتهي عند مشبك عصبي)",
 "神経組織": "نسيج عصبي (نسيج يتكون من عصبونات)",
 "神経網": "شبكة عصبية (أي شبكة من الخلايا العصبية أو النوى التي تعمل معاً لأداء وظيفة ما في الجسم)",
 "神経線維": "ليف عصبي (امتداد خيطي للخلية العصبية)",
 "神経繊維": "ليف عصبي (امتداد خيطي للخلية العصبية)",
 "神経腫": "ورم عصبي (أي ورم مشتق من خلايا الجهاز العصبي)",
 "神経膠": "خلايا دبقية, نسيج عصبي دبقي (نسيج داعم يحيط ويدعم الخلايا العصبية في الجهاز العصبي المركزي)",
 "神経膠細胞": "خلية دبقية, خلية غروية عصبية (خلية من خلايا الدبق العصبي)",
 "神経膠腫": "ورم دبقي (ورم في الدماغ يتكون من الخلايا الدبقية)",
 "神経芽細胞": "أرومة عصبية (خلية تتطور منها الخلية العصبية)",
 "神経芽細胞腫": "ورم أرومي عصبي (ورم خبيث يحتوي على خلايا عصبية جنينية؛ عادة ما ينتشر بسرعة)",
 "神経芽腫": "ورم أرومي عصبي (ورم خبيث يحتوي على خلايا عصبية جنينية؛ عادة ما ينتشر بسرعة)",
 "神経衝撃": "سيال عصبي, نبضة عصبية (التفريغ الكهربائي الذي ينتقل عبر الليف العصبي)\nمثال: أثبتوا انتقال النبضات من القشرة الدماغية إلى منطقة تحت المهاد",
 "神経衰弱": "وهن عصبي (انهيار عصبي (مصطلح غير تقني)) / تَرْكِيز",
 "神経解剖学": "تشريح عصبي (تشريح الجهاز العصبي)",
 "神経言語プログラミング": "معالجة اللغات الطبيعية (فرع علم المعلومات الذي يتعامل مع معلومات اللغة الطبيعية)",
 "神経言語学": "لسانيات عصبية (فرع اللسانيات الذي يدرس العلاقة بين اللغة وبنية ووظيفة الجهاز العصبي)",
 "神経調節性失神": "نانومتر (وحدة مترية للطول تساوي واحداً من المليار من المتر)",
 "神経質": "عَصَبِيّ / دَقِيق, مُتَطَلِّب (شَدِيد التَّدْقِيق خَاصَّةً فِي التَّفَاصِيل)",
 "神経過敏": "مُفْرِط الحَسَاسِيَّة (حسّاس بشكل مبالغ فيه)",
 "神経障害": "اضطراب عصبي, مرض عصبي (اضطراب في الجهاز العصبي)",
 "神統記": "أصل الآلهة, ثيوغونيا (دراسة أصول وأنساب الآلهة)",
 "神義論": "ثيوديسيا, عدالة الإله (فرع اللاهوت الذي يدافع عن صلاح الله وعدله في مواجهة وجود الشر)",
 "神聖": "قُدْسِيَّة",
 "神聖ローマ帝国": "اَلْإِمْبَرَاطُورِيَّة اَلرُّومَانِيَّة اَلْمُقَدَّسَة",
 "神聖ローマ皇帝": "إمبراطور روماني مقدس (عاهل الإمبراطورية الرومانية المقدسة)",
 "神聖化": "تقديس (حفل ديني يتم فيه جعل شيء مقدسًا)",
 "神聖性": "قُدْسِيَّة (صفة كون الشيء مقدساً)",
 "神聖戦争": "حَرْب مُقَدَّسَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "神聖文字": "هِيرُوغْلِيفِيَّة",
 "神聖視": "تأليه, تعظيم (رفع شخص ما (إلى مرتبة إله))",
 "神託": "كَاهِن, عَرَّاف",
 "神話": "خُرَافَة",
 "神話学": "عِلْم اَلْأَسَاطِير (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "神話的": "أُسْطُورِيّ, مِيثُولُوجِيّ (مبنيّ على القصص التقليدية أو مرويّ فيها؛ يفتقر إلى أساس واقعي)",
 "神谷": "اسم مكان (الاسم الذي يُعرف به مكان جغرافي) / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "神輿": "مُسْتَدَقّ الظَّهْر",
 "神輿を上げる": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "神送り": "رُقْيَة",
 "神通力": "قدرة سحرية (القدرة على أداء السحر)",
 "神速": "سرعة (معدل (عادة سريع) يحدث به شيء ما)\nمثال: تقدم المشروع بسرعة مرضية",
 "神遊": "قصة خيالية, قصة ملفقة (قصة مثيرة للاهتمام ولكنها غير قابلة للتصديق إلى حد كبير؛ تُروى غالباً كعذر)",
 "神遊び": "قصة خيالية, قصة ملفقة (قصة مثيرة للاهتمام ولكنها غير قابلة للتصديق إلى حد كبير؛ تُروى غالباً كعذر)",
 "神道": "شِنْتَوِيَّة, شِنْتُو",
 "神道信者": "شنتوي (متعلق بالشنتوية أو مميز لها)\nمثال: معابد شنتوية",
 "神道家": "شنتوي (متعلق بالشنتوية أو مميز لها)\nمثال: معابد شنتوية",
 "神野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "神霊": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب. / رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة.",
 "神韻縹渺": "رَفِيع, سَامٍ (مَرْفُوعُ الشَّأْنِ؛ فِي حَالَةِ سُمُوٍّ رُوحِيّ)",
 "神風": "اِنْتِحَارِيّ, كَامِيكَازِي",
 "神髄": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "神魂": "قلباً وقالباً (بإيمان كامل)\nمثال: كانت معه قلباً وقالباً",
 "祟り": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان…)\nمثال: اللعنة حولها ومعرفة",
 "祟り目": "بَلَاء, بُؤْس\nمثال: 弱り目に祟り目。 — لا تأتي المصائب فُرَادَى.",
 "祟り神": "كائن خارق للطبيعة, كيان روحي (كائن غير مادي يُعتقد أن له قوى تؤثر على مسار الأحداث البشرية)",
 "祟る": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان…)\nمثال: اللعنة حولها ومعرفة",
 "祠宇": "ضَرِيح",
 "祢宜": "كَاهِن, قِسِّيس / جُنْدُب, جَرَادَة",
 "祥": "فَأل, نَذِيْر",
 "票": "تَصْوِيت, اِقْتِرَاع\nمثال: اقرأ بصوت عالي. / مُلْصَق, بِطَاقَة",
 "票差": "هَامِش",
 "票決": "تَصْوِيت, اِقْتِرَاع\nمثال: اقرأ بصوت عالي.",
 "票田": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما…)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "祭": "عِيد, مَهْرَجَان / مُتَّقِد, مُلْتَهِب (عاطفيّ أو سريع الغضب)\nمثال: كانت النار واحدة من أولى اكتشافات أسلافنا / نوبة جنون, هياج (حالة من الهياج العقلي العنيف)",
 "祭り": "عِيد, مَهْرَجَان / مُتَّقِد, مُلْتَهِب (عاطفيّ أو سريع الغضب)\nمثال: كانت النار واحدة من أولى اكتشافات أسلافنا / نوبة جنون, هياج (حالة من الهياج العقلي العنيف)",
 "祭り上げる": "عِبَادَة\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / تَمَلَّقَ, تَبَصْبَصَ",
 "祭る": "أَلَّهَ (أَلِهَ فلانٌ يَأْلَهُ إِلاَهَةً، وأُلُوهَةً، وألوهِيّةً: تحيَّر؛ أَلِهَ…) / صَلَّى, دَعَا",
 "祭主": "كَاهِن, قِسِّيس",
 "祭事": "عِيد, مَهْرَجَان",
 "祭儀": "طَقْس دِينِيّ, شَعِيرَة",
 "祭典": "عِيد, مَهْرَجَان",
 "祭司": "كَاهِن, قِسِّيس",
 "祭壇": "مَذْبَح, هَيْكَل",
 "祭壇座": "مَذْبَح, هَيْكَل",
 "祭壇画": "ستار المذبح, لوحة المذبح الخلفية (ساتر مطلي أو منحوت يوضع فوق وخلف المذبح أو مائدة العشاء الرباني)",
 "祭式": "طَقْس دِينِيّ, شَعِيرَة",
 "祭政一致": "ثِيُقْرَاطِيَّة",
 "祭日": "عطلة رسمية, عطلة قانونية (عطلة مصرح بها قانوناً ويتم فيها تقليص العمل أو الأعمال الرسمية)",
 "祭殿": "ضَرِيح",
 "祭礼": "عِيد, مَهْرَجَان",
 "祭祀": "شَعِيرَة, مَرَاسِم",
 "祭禮": "عِيد, مَهْرَجَان",
 "祭騒ぎ": "احتفال, مهرجان (أي نشاط ترفيهي بهيج)",
 "禀告": "لَاحَظَ",
 "禀性": "طَبِيعَة, طبيعة",
 "禀請": "عَرِيضَة, طَلَب",
 "禀請書": "عَرِيضَة, طَلَب",
 "禁": "حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ)\nمثال: حرم الإسلام الترويع",
 "禁じる": "حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ)\nمثال: حرم الإسلام الترويع",
 "禁じ手": "مُخَالَفَة",
 "禁ず": "حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ)\nمثال: حرم الإسلام الترويع",
 "禁ずる": "حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ)\nمثال: حرم الإسلام الترويع",
 "禁め": "اعتراض, معاتبة (فعل التعبير عن معارضة جادة أو احتجاج)",
 "禁中": "مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "禁令": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "禁制": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "禁制原理": "مبدأ استبعاد باولي (لا يمكن لأي إلكترونين أو بروتونين أو نيوترونين في نظام معين أن يكونا في حالات…)",
 "禁制品": "تَهْرِيب",
 "禁則": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "禁則処理": "معالج نصوص (تطبيق يوفر للمستخدم الأدوات اللازمة لكتابة وتحرير وتنسيق النصوص وإرسالها إلى…)",
 "禁反言": "إِغْلَاق, اِسْتُوبْل (قاعدة إثبات تمنع الشخص من إنكار حقيقة واقعة تم تسويتها بالفعل)",
 "禁呪": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "禁固": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "禁固刑": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "禁圧": "كبت, كبح ((علم النفس) الاستبعاد الواعي للأفكار أو الرغبات غير المقبولة)\nمثال: قمع الهرطقة",
 "禁域": "غير جاهز (لا يعمل بشكل صحيح أو ليس في حالة مناسبة للمتابعة)\nمثال: كان إطلاق الفضاء غير جاهز",
 "禁忌": "مَحْظُورٌ اجْتِمَاعِيّ (اسم مفعول من حَظَرَ؛ المَمْنُوع والمُحَرَّم، ضد المُبَاح) / مُضَادّ اِسْتِطْبَاب",
 "禁戒": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "禁手": "مُخَالَفَة",
 "禁断": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما. / مَحْظُور, مُحَرَّم (اسم مفعول من حَظَرَ؛ المَمْنُوع والمُحَرَّم، ضد المُبَاح)",
 "禁断の木の実": "فَاكِهَة مُحَرَّمَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها)\nمثال: التفاح فاكهة لذيذة.",
 "禁断の果実": "فَاكِهَة مُحَرَّمَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها)\nمثال: التفاح فاكهة لذيذة.",
 "禁断症状": "عَرَض الانسحاب (أي اضطراب جسدي أو نفسي (مثل التعرق أو الاكتئاب) يعاني منه مدمن المخدرات عند…)",
 "禁欲": "امتناع, تعفف (فعل أو ممارسة الامتناع عن الانغماس في شهوة ما)",
 "禁欲主義": "زُهْد (زَهَّدَ (زهده): قلله؛ زَهَّدَ فيه وعنه: جعله يزهد)",
 "禁欲主義者": "نُسُكِيّ",
 "禁欲生活": "امتناع, تعفف (فعل أو ممارسة الامتناع عن الانغماس في شهوة ما)",
 "禁欲的": "زَهِيد, مُتَقَشِّف (مقتصد في الاستهلاك خاصة الطعام والشراب)\nمثال: ملذات المائدة لم تكن ذات أهمية تذكر لشخص متقشف بطبعه",
 "禁欲者": "نُسُكِيّ",
 "禁止": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "禁止令": "حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ)\nمثال: حرم الإسلام الترويع",
 "禁止命令": "أمر حجر, قرار حظر (أمر محكمة يمنع طرفاً من القيام بنشاط معين)",
 "禁止条約": "حَرَّمَ, حَظَرَ (مَنَعَ ولم يعطِ)\nمثال: حرم الإسلام الترويع",
 "禁止的": "نَهْي",
 "禁治産": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات)",
 "禁煙": "التَّدْخِين مَمْنُوعَ, مَمْنُوع التَّدْخِين",
 "禁煙区域": "التَّدْخِين مَمْنُوعَ, مَمْنُوع التَّدْخِين",
 "禁煙車": "خَالٍ مِنَ الدُّخَانِ (خالٍ من الدخان)",
 "禁獄": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
