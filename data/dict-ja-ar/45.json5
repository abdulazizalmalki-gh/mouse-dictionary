 "社債": "سند شركات (سند تصدره شركة؛ لا يحمل أي مطالبة بالملكية ولا يدفع أرباحاً ولكن مدفوعات حملة السندات لها الأولوية على مدفوعات المساهمين)\nمثال: سندات الشركات استثمار أكثر أماناً من الأسهم العادية في نفس الشركة",
 "社債券": "سند دين, سند مديونية (شهادة أو إيصال يقر بوجود دين) / سند دين, سند غير مضمون (قدرة العميل على الحصول على سلع أو خدمات قبل الدفع، بناءً على الثقة بأن الدفع سيتم في المستقبل)",
 "社債権者": "حامل سندات (حامل سندات تصدرها حكومة أو شركة)",
 "社友": "شَرِيك, شَرِيكَة",
 "社号": "اسم الشركة (الاسم الذي تُعرف به الشركة)",
 "社名": "اسم الشركة (الاسم الذي تُعرف به الشركة)",
 "社告": "إِعْلَان, بَلَاغ",
 "社団": "كرش (مصطلحات عامية للكرش أو البطن البارز) / شركة مساهمة, مؤسسة (شركة تجارية تمت الموافقة على مواد تأسيسها في ولاية ما)",
 "社団法人": "كرش (مصطلحات عامية للكرش أو البطن البارز) / شركة مساهمة, مؤسسة (شركة تجارية تمت الموافقة على مواد تأسيسها في ولاية ما)",
 "社歴": "تعمير, طول الخدمة (مدة الخدمة أو البقاء)\nمثال: طول بقائها كنجمة",
 "社民": "الحزب الديمقراطي الاجتماعي (حزب سياسي في ألمانيا وبريطانيا (وغيرها) تأسس في أواخر القرن التاسع عشر؛ كان ماركسياً في الأصل؛ ويدعو الآن إلى التحول التدريجي للرأسمالية إلى اشتراكية…)",
 "社民党": "الحزب الديمقراطي الاجتماعي (حزب سياسي في ألمانيا وبريطانيا (وغيرها) تأسس في أواخر القرن التاسع عشر؛ كان ماركسياً في الأصل؛ ويدعو الآن إلى التحول التدريجي للرأسمالية إلى اشتراكية…)",
 "社稷": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع.",
 "社説": "تَحْرِيرِيّ / اِفْتِتاحِيّة, مَقَال اِفْتِتَاحِيّ",
 "社長": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "祀る": "أَلَّهَ (أَلِهَ فلانٌ يَأْلَهُ إِلاَهَةً، وأُلُوهَةً، وألوهِيّةً: تحيَّر؛ أَلِهَ أَلَهًا: تَحيَّرَ) / صَلَّى, دَعَا",
 "祆教": "زرادشتِيَّة",
 "祇園": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "祈": "صَلَّى, دَعَا / أُمْنِيَّة / رَغْبَة / مُنْيَة / تَمَنَّى",
 "祈ぐ": "صَلَّى, دَعَا",
 "祈とう": "صَلَاة, دُعَاء / صَلَاة / مُصَلٍّ / رُقْيَة",
 "祈とう書": "كتاب صلوات (كتاب يحتوي على صلوات)",
 "祈り": "صَلَاة, دُعَاء / صَلَاة / مُصَلٍّ",
 "祈りをささげる": "صَلَّى, دَعَا",
