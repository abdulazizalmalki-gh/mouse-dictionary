 "知的財産高等裁判所": "مِلْكِيَّة فِكْرِيَّة",
 "知者": "حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب)\nمثال: هذه كلمات حكيمة. / بُوذَا, بُدّ",
 "知育偏重": "بإفراط, كثيراً جداً (أكثر مما يلزم)\nمثال: إنها تأكل كثيراً جداً",
 "知能": "جِهَاز الْمُخَابَرَات, مُخَابَرَات",
 "知能テスト": "اختبار ذكاء (اختبار نفسي لقياس الذكاء)\nمثال: اعتادوا الاعتقاد بأن الذكاء هو ما يختبره اختبار الذكاء",
 "知能年齢": "عمر عقلي (مستوى التطور الفكري كما يقاس باختبار الذكاء)",
 "知能指数": "مُعَدَّل ذَكَاء (هو الأمر الذي جرى عليه تَعْدِيل فهو أفضل من ما يناظره؛ السيارة المعدّلة تسير…)\nمثال: انخفض معدل الجريمة.",
 "知能検査": "اختبار ذكاء (اختبار نفسي لقياس الذكاء)\nمثال: اعتادوا الاعتقاد بأن الذكاء هو ما يختبره اختبار الذكاء",
 "知能犯": "إداري, ذو الياقات البيضاء (من أو يحدد العمل المهني أو الكتابي المأجور أو العمال)\nمثال: طمح ابن عامل المنجم إلى وظيفة مكتبية (ذوي الياقات البيضاء) كمحاسب",
 "知能的": "ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي.",
 "知能設計": "التَصْمِيم الذَكِيّ",
 "知行": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها)\nمثال: انتقدوا أداءه كرئيس للبلدية / إقْطَاعَة",
 "知見": "عِلْم, مَعْرِفَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "知覚": "اِدْرََاك حَسِّيّ",
 "知覚力": "بصيرة, فطنة (شعور بالفهم)",
 "知覚神経": "عصب حسي, عصب وارد (عصب ينقل النبضات من المستقبلات باتجاه أو إلى الجهاز العصبي المركزي)",
 "知覚過敏": "فرط حساسية (حساسية مفرطة)",
 "知覚麻痺": "ترنح, ذهول (وعي هامشي)\nمثال: كان ترنحه بسبب الإرهاق بقدر ما كان بسبب الضربات",
 "知謀": "براعة, ذكاء (خاصية كون الشخص بارعاً)\nمثال: حبكة ذات براعة كبيرة",
 "知識": "عِلْم, مَعْرِفَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "知識は力なり": "اَلْمَعْرِفَة قُوَّة",
 "知識ベース": "حَقْل مَعْرِفِيّ, مَجَال مَعْرِفِيّ (محتوى حقل معرفيّ معيَّن)",
