 "立腹": "غَضَب / أَغْضَبَ / غَضِبَ",
 "立至る": "بَلَغَ",
 "立花": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "立茎": "إسناد, تدعيم (فعل التدعيم بالدعامات)",
 "立葵": "ختمية (أي من نباتات طويلة متنوعة من جنس ألسيا؛ موطنها الشرق الأوسط ولكنها توطنت وزرعت على نطاق واسع لزهورها الكبيرة جداً والمتنوعة الألوان) / ألثيا, ختمية (أي من نباتات متنوعة من جنس ألثيا؛ تشبه ولكن بزهور أصغر من جنس ألسيا)",
 "立襟": "يَتَطَلَّب الوُقُوف (يستلزم وضعيَّة الوقوف)",
 "立見客": "ستاندي, مجسم كرتوني (مجسم مفرغ من الورق المقوى بالحجم الطبيعي (عادة لأحد المشاهير)) / واقف (شخص يقف في مكان قد يجلس فيه المرء (كمتفرج يستخدم مساحة الوقوف في مسرح أو راكب في حافلة أو قطار مزدحم))\nمثال: التقط صورته مع مجسم كرتوني للرئيس",
 "立見席": "أَمَاكِن وُقُوف (مساحة للركاب أو المتفرجين للوقوف)\nمثال: كان هناك أماكن وقوف لآلاف الأشخاص الإضافيين",
 "立証": "مُظَاهَرَة, تَظَاهُر (مُظَاهَرَة من أجل تحقيق هدف معين ٠)\nمثال: قرابة الألف شاركوا في المظاهرة.",
 "立証責任": "عِبْء الإثْبات, عِبْء البَيِّنة (عِبْء: اسم؛ الحمل الثقيل. \"يحمل على كاهله عبأً\") / التزام بتقديم الدليل, التزامات بتقديم الدليل",
 "立詰め": "مَنْزِلَة, مَكَانَة",
 "立読み": "رعي, قضم الأوراق (فعل التغذية عن طريق القضم المستمر) / تصفح (القراءة بشكل سطحي أو عشوائي)",
 "立論": "جِدَال, مُجَادَلَة (مراء يتعلق بإظهار المذاهب وتقريرها، ذكره ابن الكمال (التوقيف)؛ فنّ الجِدال: ( والتصوف) ضربٌ خادعٌ من المناقشة أساسه استعمال الحجج السُّفسطائيّة…) / وَسِيط\nمثال: لا جدال في ذلك.",
 "立退き": "طَرْد",
 "立野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "立錐の余地もない": "مَحْشُوّ, مُكْتَظّ (مُزْدَحِمٌ لِلغَايَةِ أَوْ مَمْلُوءٌ حَتَّى أَقْصَى طَاقَتِهِ)",
 "立面図": "منسوب",
 "立項": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول.",
 "立食": "يَتَطَلَّب الوُقُوف (يستلزم وضعيَّة الوقوف)",
 "立食いそば": "يَتَطَلَّب الوُقُوف (يستلزم وضعيَّة الوقوف)",
 "立食い蕎麦": "يَتَطَلَّب الوُقُوف (يستلزم وضعيَّة الوقوف)",
 "立食会": "يَتَطَلَّب الوُقُوف (يستلزم وضعيَّة الوقوف)",
 "立麝香草": "زعتر, زعتر شائع (نبات معمر عطري شائع في الحدائق موطنه غرب البحر الأبيض المتوسط؛ يستخدم في التوابل وسابقاً كدواء)",
 "立鼓": "سَاعَاتِيّ الشَّكْل (على شكل ساعة رمليّة)",
 "竜": "تِنِّين / لغات ناغا (لغات كاماروبان يتم التحدث بها في شمال شرق الهند وغرب بورما)",
 "竜の落とし子": "حصان البحر (سمكة صغيرة برأس يشبه الحصان ينحني بحدة للأسفل وذيل ملتف؛ تسبح في وضع عمودي) / فظ (أي من ثدييين بحريين شماليين كبيرين لهما أنياب عاجية وجلد قوي فوق دهن سميك)",
 "竜吐水": "غَيْر آلِيّ, يَدَوِيّ التَّشْغِيل (يعمل باليد وبتشغيل يدوي) / رشاش ماء, مسدس مائي (لعبة تتكون من مسدس لعبة يرش الماء)",
 "竜園": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "竜宮の使い": "سمكة المجداف, ملك الرنجة (سمكة استوائية رفيعة تعيش في المياه العميقة يتراوح طولها بين 20 و 30 قدماً ولها زعنفة ظهرية حمراء)",
 "竜崎": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "竜巻": "إِعْصَار (الرِيَاح التي تهب من الأرض وتثير الغبار فترتفع كالعمود إلى نحو السماء. زَوْبَعَة؛ دوّامات هوائيّة شديدة السرعة تدور حول مراكزٍ من الهواء عالي الضغط، سواء كانت فوق الأرض أو فوق الماء. [])\nمثال: السطح دمر من قبل الإعصار.",
 "竜座": "تِنِّين",
 "竜涎香": "عَنْبَر",
 "竜眼": "لونجان, لونغان (شجرة من جنوب شرق آسيا إلى أستراليا تزرع أساساً لفاكهتها الحلوة الصالحة للأكل التي تشبه مكسرات الليتشي)",
 "竜神": "لغات ناغا (لغات كاماروبان يتم التحدث بها في شمال شرق الهند وغرب بورما)",
 "竜胆": "جَنْطِيَانَا, كُوشَاد",
 "竜脚類": "ديناصور سوروبود, سوروبود (ديناصور عشبي ضخم جداً من العصر الجوراسي والطباشيري له رأس صغير على رقبة طويلة وذيل وأطراف خماسية الأصابع؛ أكبر حيوان بري معروف)",
 "竜舌蘭": "أغاف, ألوة أمريكية (نباتات أمريكية استوائية ذات وريدات قاعدية من أوراق ليفية تشبه السيف وأزهار في سنابل طويلة؛ يزرع بعضها للزينة أو للألياف)",
 "竜血樹": "أَيْدَع, دَم الْأَخَوَيْن",
 "竜頭": "تَاج, إِكْلِيل / الأسفار القانونية (مجموعة الكتب المقبولة ككتب مقدسة، وخاصة كتب الكتاب المقدس المعترف بها من قبل أي كنيسة مسيحية على أنها أصلية وموحى بها) / قائمة القديسين, قانون كنسي (قائمة كاملة بالقديسين المعترف بهم من قبل الكنيسة الكاثوليكية الرومانية) / قَانُون, مِعْيَار (قاعدة أو مجموعة قواعد أو مبادئ معترف بصحتها وأساسيتها عموماً في مجال الفن أو الفلسفة) / كانون (قطعة موسيقية طباقية يتم فيها تقليد اللحن في جزء واحد تماماً في أجزاء أخرى)\nمثال: القانون الكلاسيكي الجديد",
 "竜頭蛇尾": "انحدار في الأسلوب, هبوط مفاجئ (تغيير من موضوع جاد إلى موضوع مخيب للآمال) / تراجع مخيب, خيبة أمل (تراجع مخيب للآمال بعد ارتفاع سابق)\nمثال: النهاية المخيبة لمهنة رائعة",
 "竜馬": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "竜騎兵": "فارِس (اسم فاعل لفَرَسَ؛ راكب الفَرَس أو الحِصَان)\nمثال: فارس الظلام فيلم جيد.",
 "竜騎士": "فارِس (اسم فاعل لفَرَسَ؛ راكب الفَرَس أو الحِصَان)\nمثال: فارس الظلام فيلم جيد.",
 "竜骨": "صَالِب",
 "竜骨座": "جؤجؤ (أي من التراكيب المختلفة التي تشبه العارضة أو الحواف مثل تلك الموجودة على عظم القص للطائر أو تلك التي تشكلها البتلات المندمجة لزهرة البازلاء)",
 "竜骨突起": "صَالِب",
 "竟": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / أَبَدًا",
 "章": "فَصْل (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / بَاب (ما يُسَدُّ به مَدْخَل المَبْنَى أو الغُرْفَة أو المَرْكَبَة؛ (تعميم) مَدْخَل أي شيء؛ فُتْحَة)\nمثال: اقرأ هذا الفصل. / مِيدَالِيَة, مِِيدَالْيَة",
 "章動": "تَرَنُّح / إِنْغَاض",
 "章句": "فِقْرَة, بَنْد",
 "章段": "فِقْرَة, بَنْد",
 "章程": "قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "竣成": "إتمام, إكمال (إجراء ختامي أو نهائي) / تمريرة ناجحة ((كرة القدم الأمريكية) تمريرة أمامية ناجحة في كرة القدم)",
 "童": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "童丱": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "童僕": "صَفْحَة, صفحة",
 "童女": "بِنْت / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة) / طِفْلة / بنت / فتاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "童子": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى.",
 "童心": "بَسَاطَة, سَذَاجَة (نقص في التطور أو الخبرة الدنيوية)",
 "童男": "غُلَام, صَبِيّ",
 "童衆": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "童話": "قِصَّة خُرَافِيَّة, خُرَافَة",
 "童謡": "أُسْجُوعَةُ أَطْفَال",
 "童謡殺人": "أُسْجُوعَةُ أَطْفَال",
 "童貞": "بَكَارَة, بَتُولِيَّة / رَاهِبَة / نُون, ن",
 "童貞生殖": "توالد ذكري (توالد عذري ذكري يحتوي فيه الجنين على كروموسومات الأب فقط بسبب فشل نواة البويضة في المشاركة في الإخصاب)",
 "童貞説": "الحَمْل بِلَا دَنَس",
 "童遊び": "لعب (نشاط للأطفال يسترشد بالخيال أكثر من القواعد الثابتة) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به)\nمثال: آمن فرويد بفائدة اللعب للطفل الصغير",
 "童部": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "竦む": "تَجَمَّدَ",
 "竦める": "هَزَّ كَتِفَيْن",
 "竦然": "مَذْعُور, مُرْتَعِب (أصابه ذعر شديد أو يأس غامر)",
 "竪坑": "قصبة الريشة (العمود الفقري المجوف للريشة) / عمود دوار, عمود نقل الحركة (قضيب دوار ينقل الطاقة أو الحركة) / سارية, عمود (قضيب أو عمود طويل (خاصة مقبض أداة أو جسم سلاح مثل الرمح أو السهم)) / بئر, عمود (ممر رأسي طويل محفور في الأرض، كما لمنجم أو نفق)",
 "竪型ピアノ": "بيانو عمودي, بيانو قائم (بيانو ذو لوحة صوتية رأسية)",
 "竪子": "شبكة خشبية (هيكل يتكون من تصميم زخرفي مصنوع من شرائط من الخشب أو المعدن) / شباك صغير, كوة (فتحة صغيرة (مثل نافذة في باب) يمكن من خلالها إجراء المعاملات) / شبكة بلورية, شبيكة (ترتيب للنقاط أو الجسيمات أو الأشياء في نمط دوري منتظم في بعدين أو 3 أبعاد)",
 "竪框": "قائم (قائم هو عضو في إطار باب أو نافذة)",
 "竪樋": "شِيشَة, أرجيلة",
 "竪琴": "قِيثَارَة (آلة للطرب ذات ستة أوتار)\nمثال: أعجبته تلك القيثارة.",
 "竪琴海豹": "فقمة القيثارة (فقمة قطبية شائعة؛ صغارها بيضاء بالكامل)",
 "竪穴": "حُفْرَة",
 "竪穴住居": "خندق محصن (تحصين من التراب؛ معظمه أو كله تحت الأرض) / دكة البدلاء (أحد المأويين المنخفضين على جانبي ملعب البيسبول حيث يجلس اللاعبون والمدربون أثناء المباراة) / بيروج, زورق محفور (كانو مصنوع عن طريق حفر وتشكيل جذع شجرة كبير) / مخبأ أرضي, منزل حفرة (مأوى للبشر أو الحيوانات الأليفة والماشية يعتمد على حفرة أو منخفض محفور في الأرض)\nمثال: المخابئ الأرضية هي واحدة من أقدم أنواع المساكن البشرية التي يعرفها علماء الآثار",
 "竪穴式住居": "خندق محصن (تحصين من التراب؛ معظمه أو كله تحت الأرض) / دكة البدلاء (أحد المأويين المنخفضين على جانبي ملعب البيسبول حيث يجلس اللاعبون والمدربون أثناء المباراة) / بيروج, زورق محفور (كانو مصنوع عن طريق حفر وتشكيل جذع شجرة كبير) / مخبأ أرضي, منزل حفرة (مأوى للبشر أو الحيوانات الأليفة والماشية يعتمد على حفرة أو منخفض محفور في الأرض)\nمثال: المخابئ الأرضية هي واحدة من أقدم أنواع المساكن البشرية التي يعرفها علماء الآثار",
 "端": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء) / قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب) / كَسْر, كُسُور\nمثال: يصنع قطعة أثاث خشبية. / فُرَاطَة / حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما) / حافة, طرف (الحد الخارجي لجسم أو منطقة أو سطح؛ مكان أبعد ما يكون عن مركز الشيء) / أَفْضَلِيَّة نِسْبِيَّة, تَفَوُّق بَسِيط (ميزة تنافسية طفيفة) / حدة (سمة الإلحاح في نبرة الصوت)\nمثال: قام بتدوير حواف الصندوق / جملون (الجدار المثلث العمودي بين الأطراف المائلة لسقف الجملون) / مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل / طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة / أجنبي, دخيل (شخص مستبعد أو ليس عضواً في مجموعة معينة) / متسابق غير مرشح (متسابق (إنسان أو حيوان) لا يُعتقد أن لديه فرصة جيدة للفوز)",
 "端々": "أخلاط, أشياء متنوعة (تشكيلة مختلطة من الأشياء)",
 "端から": "مُنْذُ البِدَايَة / مِنَ الأَلِف إِلَى اليَاء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "端から端まで": "باستفاضة, بدقة (بطريقة شاملة) / بشكل جيد, بقوة (كلياً وبالكامل)\nمثال: بحثنا في الملفات بدقة",
 "端くれ": "خُرْدَة / يتخلى, نبذ / شجار / تافه, غير مهم (ليس مهماً) / تافه, ضئيل الشأن (خالٍ من الأهمية أو المعنى أو القوة)\nمثال: ميزة غير مهمة نسبياً للنظام",
 "端た": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب) / كَسْر, كُسُور\nمثال: يصنع قطعة أثاث خشبية. / فُرَاطَة",
