 "易しい": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "易を見る": "إِلٰهِيّ\nمثال: هذا الرجل تاجر.",
 "易刺激性": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "易動度": "حَرَكِيَّة, قَابِلِيَّة الحَرَكَة (صفة القدرة على التحرك بحرية)",
 "易化": "تبسيط, تقليل (عملية تقليل التعقيد)",
 "易怒性": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "易感染性": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "易断": "تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة)",
 "易易": "بِسُهُولَة / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "易者": "عراف, قاريء البخت (شخص يتنبأ بمستقبلك الشخصي)",
 "昔": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)\nمثال: و بعد قليل أتى.",
 "昔々": "قَدِيماً",
 "昔々あるところに": "كَان يَامَا كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "昔々ある所に": "كَان يَامَا كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "昔かたぎ": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "昔ながら": "غَيْر مُغَيَّر (باقٍ في حالة أصلية)\nمثال: استمر غير متغير عبر الزمن",
 "昔人": "الأسلاف, قدماء (الناس الذين عاشوا في أزمنة غابرة (خاصة خلال الفترة التاريخية قبل سقوط…)",
 "昔人間": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "昔堅気": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "昔年": "أيام الخوالي (أوقات ماضية يتم تذكرها بحنين)",
 "昔式": "أولد فاشن (كوكتيل مصنوع من الويسكي والبيترز والسكر مع شرائح الفاكهة)",
 "昔昔": "قَدِيماً",
 "昔時": "أيام الخوالي (أوقات ماضية يتم تذكرها بحنين)",
 "昔気質": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "昔者": "عجوز, كبير السن (شخص متقدم في السن)",
 "昔蜥蜴": "تواتارا (العضو الوحيد الباقي من رتبة منقاريات الرأس من الزواحف الكبيرة الشائكة الشبيهة…)",
 "昔話": "حِكَايَة شَعْبِيَّة, فُولْكُلُور (حكاية تتداول شفهياً بين عامة الناس) / استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني))\nمثال: لديه استدعاء كامل للحلقة",
 "昔語": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني))\nمثال: لديه استدعاء كامل للحلقة",
 "昔語り": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني))\nمثال: لديه استدعاء كامل للحلقة",
 "昔風": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "星": "إِجَّامَة / أسيد, حمض (اسم دارج لثنائي إيثيل أميد حمض الليسرجيك)\nمثال: صف من النقاط / إصابة دقيقة للهدف (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى)\nمثال: تعرض زيري لإصابة. / مذنب, مرتكب الجريمة (شخص يرتكب مخالفة) / سِنْغَافُورَة (دولة مدينة تقع في جنوب شرق قارة آسيا البحري جنوب شبه جزيرة ملايو وشمال مضيق…)",
 "星々": "سورة النجم",
 "星くず": "خيال حالم, سحر رومانسي (صفة رومانسية حالمة أو عاطفية)",
 "星さま": "إِجَّامَة",
 "星になる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "星を落とす": "فَقَدَ\nمثال: خسر توم وظيفته.",
 "星井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "星光": "ضوء النجوم (ضوء النجوم)",
 "星列": "صُورَة نَجْمِيَّة, صُورَة سَمَاوِيَّة",
 "星加": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "星占い": "تَنْجِيم",
 "星占い師": "مُنَجِّم, مُنَجِّمَة",
 "星印": "إِجَّامَة / إِجَّامَة, نُجَيْمَة",
 "星原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "星口動物": "دودة الفول السوداني, دودة رشفية (دودة بحرية صغيرة غير مقسمة تسحب جزأها الأمامي إلى الجسم عند إزعاجها مما يعطيها…)",
 "星図": "خريطة النجوم (مخطط يوضح المواقع النسبية للنجوم في جزء معين من السماء)",
 "星型": "شكل خماسي, نجمة خماسية (نجمة لها 5 رؤوس؛ تتكون من 5 خطوط مستقيمة بين رؤوس مخمس وتحيط بمخمس آخر)",
 "星型六角形": "نجمة سداسية (مضلع منتظم يتكون من مد كل ضلع من أضلاع مسدس منتظم لتشكيل مثلثين متساويي الأضلاع)",
 "星埜": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "星学": "فَلَك, عِلْم الْفَلَك (التَلّ المستدير من الرَمْل حوله فَضَاء؛ المَدَار يسبح فيه الجُرْم السماويّ)\nمثال: أصبح زيري عالم فلك.",
 "星官": "كَوْكَبَة",
 "星宝貝": "ودعة النمر (ودعة تستخدم صدفتها للزينة)",
 "星宿": "كَوْكَبَة / قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "星屎": "حَجَر نَيْزَكِيّ (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر.",
 "星屑": "خيال حالم, سحر رومانسي (صفة رومانسية حالمة أو عاطفية)",
 "星山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "星崎": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "星川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "星希": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "星座": "كَوْكَبَة / برج, برج فلكي ((علم التنجيم) واحدة من 12 منطقة متساوية تنقسم إليها دائرة البروج)",
 "星座図": "خريطة النجوم (مخطط يوضح المواقع النسبية للنجوم في جزء معين من السماء)",
 "星座投影機": "القبة السماوية, نموذج النظام الشمسي (جهاز أو نموذج لتمثيل الأنظمة الشمسية)",
 "星形": "شكل خماسي, نجمة خماسية (نجمة لها 5 رؤوس؛ تتكون من 5 خطوط مستقيمة بين رؤوس مخمس وتحيط بمخمس آخر)",
 "星彩": "صُورَة نَجْمِيَّة, صُورَة سَمَاوِيَّة / ضوء النجوم (ضوء النجوم)",
 "星影": "ضوء النجوم (ضوء النجوم)",
 "星斗": "إِجَّامَة",
 "星明かり": "ضوء النجوم (ضوء النجوم)",
 "星明り": "ضوء النجوم (ضوء النجوم)",
 "星星": "سورة النجم",
 "星月": "إِجَّامَة",
 "星条旗": "العلم الأمريكي, علم النجوم والخطوط (العلم الوطني للولايات المتحدة الأمريكية)",
 "星条旗新聞": "العلم الأمريكي, علم النجوم والخطوط (العلم الوطني للولايات المتحدة الأمريكية)",
 "星椋鳥": "زرزور شائع (طائر اجتماعي ذو ريش بلمعان معدني داكن؛ يبني أعشاشاً حول المساكن والهياكل الأخرى…)",
 "星様": "إِجَّامَة",
 "星河": "دَرْب اَلتَّبَّانَة (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل :…)\nمثال: درب على يد خبير.",
 "星漢": "دَرْب اَلتَّبَّانَة (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل :…)\nمثال: درب على يد خبير.",
 "星状体": "النَّجْم, قَسِيم نَجْمِيّ (بنية نجمية الشكل تتشكل في سيتوبلازم الخلية لها ألياف تشبه الأشعة تحيط بالجسيم…)",
 "星状膠細胞": "خلية نجمية (خلية دبقية عصبية كبيرة نسبياً)",
 "星田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "星石": "حَجَر نَيْزَكِيّ (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر.",
 "星章": "إِجَّامَة",
 "星系": "نِظَام نَجْمِيّ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "星群": "صُورَة نَجْمِيَّة, صُورَة سَمَاوِيَّة",
 "星草": "عشبة الغليون (نبات مائي معمر في أمريكا الشمالية وأيرلندا وجزر هبريدس له أوراق خضراء شفافة في…)",
 "星虫": "دودة الفول السوداني, دودة رشفية (دودة بحرية صغيرة غير مقسمة تسحب جزأها الأمامي إلى الجسم عند إزعاجها مما يعطيها…)",
 "星蝕": "احْتِجَاب",
 "星辰": "جِرْم سَمَاوِيّ, جِرْم فَلَكِيّ (جَرَم الشَّخْصُ: أَذْنَبَ وَاكتَسَبَ الإِثْمَ؛ جَرَم نفسَه\nمثال: الإهمال هو نوع من الضرر أو الجرم",
 "星野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "星間": "بين النجوم (يقع بين أو وسط النجوم)\nمثال: كثافة الهيدروجين في الفضاء بين الكواكب وبين النجوم",
 "星間空間": "الفضاء بين النجوم, فضاء بين نجمي (الفضاء الموجود بين النجوم)",
 "星雲": "سَدِيم / مَجَرَّة (نجوم كثيرة لا تدرك بمجرد البصر، وعندما ينتشر ضوؤها فيُرى كأنه بقعة بيضاء (أي:…)\nمثال: أنا بطل المجرة.",
 "星雲説": "فرضية سديمية ((علم الكونيات) النظرية القائلة بأن النظام الشمسي تطور من سديم غازي ساخن)",
 "星霜": "أيام, سنوات (الوقت الذي تستمر فيه حياة شخص ما)\nمثال: أيام الملك الأخيرة",
 "星食": "احْتِجَاب",
 "星鼻土竜": "خلد نجمي الأنف (خلد برمائي من شرق أمريكا الشمالية له مجسات لحمية وردية حول الأنف)",
 "映え": "مَجْد, جَلَال (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد…)\nمثال: المجد لأوكرانيا / جَذَّاب, مُغْرٍ (قادر على جذب الاهتمام أو لفت الانتباه الإيجابي)\nمثال: أضاف شخصية جذابة لا تُنسى إلى الأساطير الأمريكية الشعبية",
 "映える": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ)",
 "映し出す": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء…)\nمثال: هذا مشروع عظيم. / وَصَفَ / عَكَسَ",
 "映し絵": "صورة شعاعية (صورة فوتوغرافية منتجة على سطح حساس للإشعاع بواسطة إشعاع غير الضوء المرئي (خاصة…)",
 "映じる": "تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية)",
 "映す": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء…)\nمثال: هذا مشروع عظيم.",
 "映ずる": "تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية)",
 "映り": "إِسْقَاط\nمثال: دفنت في مسقط رأسها. / مُبَارَاة",
 "映りこむ": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "映り行く": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "映り込む": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "映る": "خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "映像": "صُورَة / فِيدِيُو, فيديو / اِنْعِكَاس, عَكْس",
 "映像作家": "سينمائي, صانع أفلام (منتج للأفلام السينمائية)",
 "映像圧縮": "ضغط الصور (ضغط الرسومات للتخزين أو الإرسال)",
 "映像媒体": "تسجيل فيديو, فيديو (تسجيل للمكونات المرئية والمسموعة (خاصة تلك التي تحتوي على تسجيل لفيلم أو برنامج…)",
 "映写": "إِسْقَاط\nمثال: دفنت في مسقط رأسها.",
 "映写幕": "حِجَاب, سِتَارَة (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "映写機": "جِهَاز إِسْقَاط",
 "映射": "عَاكِسٌ لِلضَّوْء (يُسبِّب الانعكاس أو يحتوي على جهاز عاكس)",
 "映画": "فِلْم (شريط من السِّلِيلُوز تعلوه قشرة من الجلاتين ومن برومور الفِضَّة يستعمل للتصوير…)\nمثال: استمر الفلم ساعتين.",
 "映画スター": "نجم سينمائي (نجم يلعب أدوار البطولة في السينما)",
 "映画作家": "سينمائي مبدع, مخرج مؤلف (صانع أفلام له أسلوب شخصي ويحتفظ بالسيطرة الإبداعية على أعماله)",
 "映画俳優組合": "تدلي, ترهل (شكل يتدلى أو يهبط للأسفل)\nمثال: كان هناك هبوط في مقعد الكرسي",
 "映画学校": "مدرسة سينما (أي مؤسسة تعليمية مخصصة لتدريس جوانب صناعة الأفلام، بما في ذلك مواضيع مثل إنتاج…)",
 "映画監督": "مُخْرِج, مُخْرِجَة",
 "映画研究": "دراسات سينمائية (تخصص أكاديمي يتعامل مع مختلف المناهج النظرية والتاريخية والنقدية للأفلام)",
 "映画祭": "مهرجان أفلام, مهرجان سينمائي (مهرجان سينمائي يعرض الأفلام (عادة الأفلام المنتجة خلال العام الماضي))",
 "映画芸術科学協会": "أكاديمية فنون وعلوم الصور المتحركة (أكاديمية تمنح جوائز سنوية للإنجازات في إنتاج الصور المتحركة والأداء)",
 "映画輸出協会": "فيلم, فيلم سينمائي (شكل من أشكال الترفيه يجسد قصة بالصوت وتسلسل من الصور يعطي وهماً بالحركة المستمرة)\nمثال: ذهبوا لمشاهدة فيلم كل ليلة سبت",
 "映画館": "دار عرض سينمائي, سينما (مسرح تُعرض فيه الأفلام)",
 "映研": "دراسات سينمائية (تخصص أكاديمي يتعامل مع مختلف المناهج النظرية والتاريخية والنقدية للأفلام)",
 "春": "عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره…)\nمثال: كان عين ليلى مسودة. / السَّنَة الْجَدِيدَة / مُمْتَاز, فَاخِر / مُرَاهَقَة",
