 "流亡": "تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به / انجراف التربة (جرف التربة عن طريق تدفق المياه)",
 "流人": "نَفْي, تَبْعِيد / نَفَى / تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر) / متشرد, هائم (متجول ليس لديه إقامة ثابتة أو وسيلة عيش ظاهرة)",
 "流体": "سَائِل, مَائِع",
 "流体力学": "ميكانيكا الموائع, هيدروليكا (دراسة ميكانيكا السوائل)",
 "流儀": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "流入": "تدفق داخلي (عملية التدفق إلى الداخل)",
 "流出": "تسرب, نضوح (خروج سائل من حاوية ما) / عين, نبع (تدفق طبيعي للمياه الجوفية) / تدفق خارجي (عملية التدفق إلى الخارج)\nمثال: حاولوا وقف تسرب الغاز من الأنبوب التالف",
 "流刑": "نَفْي, تَبْعِيد / نَفَى",
 "流刑地": "مستعمرة عقابية, منفى (مؤسسة عقابية يتم فيها نفي السجناء (غالباً ما تقع في جزيرة يصعب الهروب منها))",
 "流刑者": "مطرود, مُبعَد (شخص يُطرد من وطنه أو بلده بأمر من السلطة)",
 "流動": "تَدَفُّق / تَدَفَّقَ, سَالَ",
 "流動体": "سَائِل, مَائِع",
 "流動性": "سُيُولَة (توفر النقد أو سهولة التحويل إلى نقد؛ القدرة على سداد الديون) / سيولة (خاصية التدفق بسهولة) / حالة سائلة, سائل (الحالة التي تظهر فيها المادة استعداداً مميزاً للتدفق مع ميل ضئيل أو معدوم للتشتت وعدم قابلية للانضغاط عالية نسبياً)\nمثال: إضافة الرصاص تجعل السبيكة أسهل في السكب لأن درجة الانصهار تنخفض وتزداد السيولة / انْسِيَابِيَّة, سُيُولَة (صفة متغيرة) / سيولة (خاصية التدفق بسهولة)\nمثال: انسيابية شرقية ساحرة في الأسلوب / حَرَكِيَّة, قَابِلِيَّة الحَرَكَة (صفة القدرة على التحرك بحرية)",
 "流動物": "سَائِل, مَائِع",
 "流動的": "سَائِل, مَائِع",
 "流動資産": "أصول سائلة, أصول متداولة (أصول في شكل نقد (أو قابلة للتحويل بسهولة إلى نقد))",
 "流域": "حوض النهر, مستجمع مائي (المنطقة الجغرافية الكاملة التي يصرفها النهر وروافده؛ منطقة تتميز بتدفق جميع مياه الجريان السطحي إلى نفس المخرج)\nمثال: التحكم في الفيضانات في حوض ميسوري",
 "流布": "انتشار, تداول (انتشار أو نقل شيء ما (كالأخبار أو المال) إلى مجموعة أو منطقة أوسع) / توزيع, نشر (توزيع نسخ من الدوريات (مثل الصحف أو المجلات)) / دوران, سريان (حركة حرة أو مرور (كما في السيتوبلازم داخل الخلية أو النسغ عبر النبات)) / دوران, دورة دموية (الحركة عبر دائرة؛ وخاصة حركة الدم عبر القلب والأوعية الدموية)\nمثال: دوران المحيط جزء مهم من المناخ العالمي",
 "流感": "إِنْفْلُوَنْزَا\nمثال: 流感の予防ワクチンの注射をした。 — طُعِّمتُ من الإنفلونزا.",
 "流星": "شِهَاب",
 "流星体": "نَيْزَك",
 "流星塵": "نَيْزَك دَقِيق (حجر نيزكي أو نيزك صغير جداً لدرجة أنه ينجرف إلى الأرض دون أن يسخن بشدة في الغلاف الجوي)",
 "流星物質": "نَيْزَك",
 "流星群": "سِرْب نَيَازِك (مجموعة من النيازك ذات مسارات متشابهة)",
 "流星雨": "زخة شهب, وابل شهبي (تساقط عابر للشهب عندما يدخل سرب من الشهب الغلاف الجوي للأرض)",
 "流暢": "طَلِق, فَصِيح (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ)\nمثال: طلق زيري زوجته.",
 "流木": "خشب طاف (خشب يطفو أو جرفته الأمواج إلى الشاطئ)",
 "流束": "تغير مستمر, تقلب (في تغيير مستمر) / كثافة التدفق ((فيزياء) عدد التغيرات في تدفق الطاقة عبر سطح معين لكل وحدة مساحة) / تدفق, سيلان (جريان أو تصريف) / فيض مغناطيسي, مجال مغناطيسي (خطوط القوة المحيطة بمغناطيس دائم أو جسيم مشحون متحرك)\nمثال: آراؤه في تقلب مستمر",
 "流民": "لَاجِئ, لَاجِئَة",
 "流氓": "لَاجِئ, لَاجِئَة",
 "流水": "جَدْوَل / تَيَّار / تَدَفّقَ",
 "流氷": "جليد طافٍ (كتل من الجليد تطفو في البحر المفتوح)",
 "流氷野": "حقل جليدي (كتلة مسطحة كبيرة من الجليد (أكبر من الطوف الجليدي) تطفو في البحر)",
 "流汗": "عَرَق, عرق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك) / عَرِقَ, عِرِق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "流沙": "رِمَال مُتَحَرِّكَة",
 "流派": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "流流": "إتقان, حرفة (المهارة في مهنة أو تجارة)",
 "流浪": "تسكع, تشرد (حالة التجوال من مكان إلى آخر؛ عدم وجود منزل دائم أو وسيلة للعيش)",
