 "整流管": "صِمَام ثُنَائِيّ, ثَنَائِي دِيُود (الصِّمَامُ : السِّدَادُ؛ الصِّمام : جهاز لضبط السوائل والغازات في أَوعيتها…)\nمثال: فتح سامر صمام المياه.",
 "整然": "منضبط, منظم (خالٍ من العنف أو الاضطراب)\nمثال: حشد منظم واجه الرئيس",
 "整版": "طَابُوقَة",
 "整理": "تصنيف, فرز (التجميع حسب الفئة أو النوع أو الحجم)\nمثال: عنق الزجاجة في تسليم البريد هو عملية الفرز / تَصْفِية / تقشف, تقليص النفقات (تخفيض النفقات من أجل الاستقرار المالي)",
 "整理がつく": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "整理が付く": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "整理ダンス": "مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة…)\nمثال: عاد إلى المكتب.",
 "整理券": "تذكرة حافلة (تذكرة صالحة لركوب الحافلة)",
 "整理屋": "مرابٍ (شخص يقرض المال بأسعار فائدة مفرطة)",
 "整理箪笥": "مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة…)\nمثال: عاد إلى المكتب.",
 "整理統合": "تكامل, توحيد (عملية الدمج في كلٍ متكامل)\nمثال: دمج شركتين",
 "整級数": "مُتَسَلْسِلَة القُوَى (مجموع حدود تحتوي على قوى صحيحة أعلى تباعاً لمتغير ما)",
 "整経機": "آلة التسدية, آلة السداء (آلة نسيج تستخدم لتسدية أي خيوط طبيعية أو صناعية)",
 "整置": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "整調": "توليف, دوزنة ((موسيقى) معايرة شيء ما (آلة أو دائرة إلكترونية) لتردد قياسي) / تَنْظِيم / سكتة دِمَاغِيَّة",
 "整除数": "جُزْء قَاسِم, قَاسِم تَامّ (عدد صحيح هو قاسم تام لكمية معينة)\nمثال: 4 هو قاسم تام لـ 12",
 "整音": "تجويد الصوت, ضبط النغمة (فعل تعديل أنبوب الأرغن (أو آلة النفخ) ليتوافق مع معايير النغمة والطبقة واللون)",
 "整頓": "تَرْتِيب, مَنْهَجِيَّة (صفة تقدير المنهج والنظام)\nمثال: رتب مكتبه",
 "整風": "تقويم المنحنى (تحديد طول منحنى؛ إيجاد خط مستقيم مساوٍ في الطول لمنحنى معين)",
 "整骨師": "مقوم العظام (معالج يعالج الهيكل العظمي والعضلات)",
 "整髪": "تصفيف شعر, عناية بالشعر (العناية بالشعر: نشاط غسل أو قص أو تجعيد أو ترتيب الشعر)",
 "整髪剤": "تصفيف شعر, عناية بالشعر (العناية بالشعر: نشاط غسل أو قص أو تجعيد أو ترتيب الشعر)",
 "敵": "مُنَافِس / ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر. / زَوْج, زَوْجَة (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)\nمثال: زوجة ماري طبيبة. / خَصْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه…) / تَهْدِيد",
 "敵う": "مُبَارَاة",
 "敵に回る": "اِنْقَلَبَ عَلَى",
 "敵は本能寺にあり": "هُنَاك, يُوجَد",
 "敵は本能寺に在り": "هُنَاك, يُوجَد",
 "敵わない": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية / مُسْتَحِيل",
 "敵中": "فِي المُنْتَصَف تَمَامًا (الجزء أو النقطة الوسطى أو المركزية)\nمثال: في وسط الغابة",
 "敵人": "عَدُوّ, عَدُوَّة (ركض أو جري)\nمثال: عدو عدوي صديقي. / مُنَافِس",
 "敵兵": "عَدُوّ, عَدُوَّة (ركض أو جري)\nمثال: عدو عدوي صديقي.",
