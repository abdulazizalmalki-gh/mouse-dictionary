 "摘記": "تَلْخِيص",
 "摘録": "خُلَاصَة, مُلَخَّص",
 "摧ける": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة. / اِنْهَار\nمثال: يوشك الجسر على الانهيار.",
 "摩する": "حَكَّ, فَرَكَ (مَرَّرَ شَيْئًا عَلَى شَيْءٍ آخَرَ بِقُوَّةٍ لِيُزِيلَ مَا عَلَيْهِ؛ حَكَّ…)\nمثال: لقد حك سامي كعبه حتى بدأ ينزف. / آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "摩り替える": "مِقْلَاد",
 "摩る": "حَكَّ, فَرَكَ (مَرَّرَ شَيْئًا عَلَى شَيْءٍ آخَرَ بِقُوَّةٍ لِيُزِيلَ مَا عَلَيْهِ؛ حَكَّ…)\nمثال: لقد حك سامي كعبه حتى بدأ ينزف.",
 "摩れ": "تسلخ, سحج (ألم أو تهيج في الجلد ناتج عن الاحتكاك)",
 "摩多": "صَائِت, مُصَوِّت\nمثال: لقد أوقفنا حركة المرور.",
 "摩天楼": "نَاطِحَة سَحَاب",
 "摩尼": "جَوْهَر, جَوْهَرَة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "摩尼宝珠": "جَوْهَر, جَوْهَرَة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "摩尼教": "مَانَوِيَّة",
 "摩尼珠": "جَوْهَر, جَوْهَرَة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "摩損": "إهلاك, استهلاك (انخفاض في قيمة أصل ما بسبب التقادم أو الاستخدام)",
 "摩擦": "اِحْتِكَاك / احتكاك, فرك (الجهد المبذول في تحريك جسم فوق آخر مع الضغط) / خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق)",
