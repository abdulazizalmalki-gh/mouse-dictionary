 "撚り糸": "برم, دوران سريع (عملية الدوران بسرعة)\nمثال: أدار الكرنك بقوة",
 "撚り線": "خيط, سلسلة (قلادة مصنوعة من ربط أشياء ببعضها)\nمثال: خيط من الخرز",
 "撚る": "لَوَى, بَرَمَ",
 "撚糸": "برم, دوران سريع (عملية الدوران بسرعة)\nمثال: أدار الكرنك بقوة",
 "撚線": "خيط, سلسلة (قلادة مصنوعة من ربط أشياء ببعضها)\nمثال: خيط من الخرز",
 "撞く": "زُبّ, زُبْر (في : اللحية أو مقدمها؛ في : الأنف) / خَزَّ (\"خَزَّهُ بسكِّينٍ\" : طَعَنَهُ بِهِ؛ \"خَزَّهُ بِبَصَرِهِ\" : أَصَابَتْهُ عَيْنُه)\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟ / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال)\nمثال: أيمكنني استعمال هاتفك؟ / حَمْلَة",
 "撞木反り": "وَضْع جِنْسِيّ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "撞木杖": "عُكَّاز, عُكَّازَة",
 "撞木鮫": "قرش المطرقة (قرش متوسط الحجم ولود ذو عيون في طرفي رأس مفلطح يشبه المطرقة؛ يوجد عالمياً في…)",
 "撞球": "بِلْيَارْدُو",
