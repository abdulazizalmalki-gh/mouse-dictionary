 "水酸化アルミニウム": "هيدروكسيد الألومنيوم (مركب بلوري أبيض يوجد بشكل طبيعي كمعدن الجبسيت)",
 "水酸化カリウム": "بوتاس, بوتاس كاوٍ (مركب للبوتاسيوم يستخدم غالباً في الزراعة والصناعة)",
 "水酸化ナトリウム": "الصودا الكاوية, هيدروكسيد الصوديوم (مادة كاوية قلوية قوية تستخدم في تصنيع الصابون والورق والألومنيوم ومركبات الصوديوم المختلفة)",
 "水酸化バリウム": "هيدروكسيد الباريوم (بلورات بيضاء سامة؛ تصنع بإذابة أكسيد الباريوم في الماء)",
 "水酸化物": "هيدروكسيد (مركب كيميائي يحتوي على مجموعة الهيدروكسيل) / أكسيد مائي, هيدروكسيد (مركب من أكسيد مع ماء)",
 "水酸化物イオン": "أَيُون الهِيدْرُوكْسِيد",
 "水酸基": "شق هيدروكسيل, مجموعة هيدروكسيل ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو أشَقُّ، وهي شَقَّاءُ)\nمثال: اكشف عن الشق العلوي من الجسم.",
 "水酸根": "شق هيدروكسيل, مجموعة هيدروكسيل ((شَقَّ) الفَرَسُ ونحوُهُ يَشِقَّ شَقَقًا: مال في جَرْيِهِ إِلى جانب؛ فهو أشَقُّ، وهي شَقَّاءُ)\nمثال: اكشف عن الشق العلوي من الجسم.",
 "水量計": "مقياس مستوى الماء (مقياس للإشارة إلى مستوى الماء في خزان أو مرجل أو مستودع)",
 "水金": "رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "水鉄砲": "رشاش ماء, مسدس مائي (لعبة تتكون من مسدس لعبة يرش الماء)",
 "水鉛": "مُولِبْدِينُوم",
 "水鉛鉛鉱": "ولفينيت (معدن أصفر إلى برتقالي أو بني يستخدم كخام للموليبدينوم)",
 "水銀": "زِئْبَق, زَاؤُوق / حُلْبُوب",
 "水銀中毒": "تسمم بالزئبق (حالة تسمم ناتجة عن تناول أو استنشاق الزئبق؛ التسمم الحاد بالزئبق يسبب طعماً معدنياً وقيئاً وإسهالاً ومشاكل في الكلى قد تؤدي إلى الوفاة)",
 "水銀剤": "حَامِي الطَّبْع, مِزَاجِيّ",
 "水銀気圧計": "بارومتر زئبقي (بارومتر يظهر الضغط بارتفاع عمود من الزئبق)",
 "水銀温度計": "مقياس حرارة زئبقي (مقياس حرارة يتكون من زئبق موجود في بصلة في أسفل أنبوب شعري زجاجي مدرج ومختوم ومميز بدرجات مئوية أو فهرنهايت؛ يتمدد الزئبق مع ارتفاع درجة الحرارة مما…)",
 "水銀電池": "خلية زئبقية (خلية أولية تتكون من أنود الزنك وكاثود من أكسيد الزئبق وإلكتروليت من هيدروكسيد البوتاسيوم)",
 "水門": "خَوْخَة",
 "水陸両用": "بَرْمَائِيّ (يعمل أو يعيش على اليابسة وفي الماء) / برمائي (متعلق بحيوانات طائفة البرمائيات أو مميز لها)\nمثال: مركبات برمائية",
 "水際": "جانب الماء (أرض متاخمة لجسم مائي)\nمثال: 彼らは水際でキャンプをした。 — خيموا على حافة الماء. / حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما. / شَاطِئ, سَاحِل (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة) المنطقة اليابسة على طول حافة النهر. ضِفَّة، جَانِب، شَطّ)\nمثال: عاد إلى الشاطئ.",
 "水難": "إِغْرَاق",
 "水雷": "طُرْبِيد / لِي, لي / مَنْجَم, لَغَم / لَغْم, لَغَم / لَغَمَ",
 "水雷艇": "قارب طوربيد (سفينة حربية صغيرة عالية السرعة مصممة لهجمات الطوربيد في المياه الساحلية)",
 "水霜": "سائل أمينوسي, سائل سلوي (السائل المصلي الذي يعلق فيه الجنين داخل السلى)",
 "水面下": "تَحْت مَائِيّ, مَغْمُور (ينمو أو يبقى تحت سطح الماء) / تَحْتَ المَاء, مَغْمُور (تحت سطح الماء؛ غاطس فيه) / خلف الأبواب المغلقة (بَدَلَ، أَعْقَبَ؛ أَتَى بعده أو جاء مكانه)\nمثال: دار زيري للخلف.",
 "水頭": "جانب الماء (أرض متاخمة لجسم مائي)",
 "水頭症": "مواه الرأس",
 "水飛沫": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "水食": "تآكل, حت (تآكل بفعل العمليات الكيميائية) / تعرية, نحت ((في الجيولوجيا) العملية الميكانيكية لتآكل أو طحن شيء ما (كما يحدث عند غسل الجسيمات له)، وتستخدم مجازياً أيضاً) / تآكل, تراجع (انخفاض تدريجي لشيء ما) / تآكل, تعرية (حالة يتآكل فيها سطح الأرض بفعل الماء والرياح)\nمثال: بعد فضيحة المحاسبة كان هناك تآكل في الثقة في المدققين",
 "水飢饉": "جَفَاف",
 "水飲み": "مَاء شُرْب, مَاء صَالِح لِلشُّرْبِ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء. / زُجَاج, قزاز / كَأْس, كُوب (إناء الشرب إذا كان فيه شراب؛ الشراب الذي في الإناء)\nمثال: هل لي بكأس ماء؟ / فَلَّاح, فَلَّاحَة",
 "水飲み場": "سبيل ماء, نافورة شرب (نافورة عامة لتوفير تيار من مياه الشرب)",
 "水飴": "شراب الذرة (شراب محضر من الذرة)",
 "水馬": "بق الماء المتزحلق (بق طويل الأرجل ينزلق على سطح الماء)",
 "水魔": "كلب الراعي الأسترالي, كيلبي (كلب راعي أسترالي ذو آذان مدببة) / كيلبي ((فلكلور اسكتلندي) روح مائية على شكل حصان تحب إغراق راكبيها)",
 "水鱶": "قرش أزرق, قرش أزرق كبير (قرش نحيل عالمي الانتشار يعيش في عرض البحر؛ يتدرج لون جسمه الأزرق إلى بطن أبيض؛ خطير خاصة أثناء الكوارث البحرية)",
 "水鳥": "طائر مائي (طائر مائي يعيش في المياه العذبة)",
 "水鶏": "تفلق / درابزين, قضيب (قضيب أفقي (عادة من الخشب أو المعدن)) / سكة حديد (اختصار لسكة حديدية) / درابزين, سياج (حاجز يتكون من قضيب أفقي ودعامات)\nمثال: سافر بالقطار",
 "水黽": "بق الماء المتزحلق (بق طويل الأرجل ينزلق على سطح الماء)",
 "氷": "جَلِيد, ثَلْج / جَلِيد, ثَلْج / بَرَد, مطر تلج (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن الميت تبرد جثته. فعل لازم مصدر بَرْد) / السلام عليك, السلام عليكم\nمثال: لا أتحمل البرد. / دَلَاة جَلِيدِيَّة / جَلِيد, ثَلْج",
 "氷のう": "كمادة ثلج, كيس ثلج (كيس مقاوم للماء مملوء بالثلج؛ يوضع على الجسم لتبريده أو تقليل التورم)",
 "氷人": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "氷冠": "غطاء جليدي (كتلة من الجليد والثلج تغطي بشكل دائم مساحة كبيرة من الأرض (مثل المناطق القطبية أو قمة جبل))",
 "氷原": "حقل جليدي (كتلة مسطحة كبيرة من الجليد (أكبر من الطوف الجليدي) تطفو في البحر)",
 "氷嚢": "كمادة ثلج, كيس ثلج (كيس مقاوم للماء مملوء بالثلج؛ يوضع على الجسم لتبريده أو تقليل التورم)",
 "氷堆石": "ركام جليدي, مورين (تربة وحجارة متراكمة ترسبها الأنهار الجليدية)",
 "氷塊": "طوف جليدي (كتلة مسطحة من الجليد (أصغر من الحقل الجليدي) تطفو في البحر)",
 "氷山": "جَبَل جَلِيد, جَبَل جَلِيدِيّ (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين)\nمثال: منزلي في الجبل.",
 "氷州石": "سبار أيسلندي (كالسيت شفاف يوجد في أيسلندا ويستخدم في المجاهر المستقطبة)",
 "氷帽": "غطاء جليدي (كتلة من الجليد والثلج تغطي بشكل دائم مساحة كبيرة من الأرض (مثل المناطق القطبية أو قمة جبل))",
 "氷挟み": "ملقط ثلج (ملقط لرفع كتل الثلج)",
 "氷晶": "بلورة جليدية, رذاذ ثلجي (بلورات صغيرة من الجليد)",
 "氷晶石": "كريوليت (معدن أبيض يتكون من فلوريدات الألمنيوم والصوديوم؛ مصدر للفلور)",
 "氷期": "عصر جليدي (أي فترة زمنية غطت فيها الأنهار الجليدية جزءاً كبيراً من سطح الأرض)\nمثال: كان أحدث عصر جليدي خلال البليستوسين",
 "氷柱": "دَلَاة جَلِيدِيَّة / جَلِيد, ثَلْج",
 "氷棚": "رف جليدي (جليد متصل باليابسة ولكنه يبرز في البحر)",
 "氷水": "ماء مثلج (ماء يُقدم بارداً جداً أو مع الثلج)\nمثال: 私はビニール袋にワインを注ぎ、それからそれを氷水に付けた。 — سكبت النبيذ في كيس و بعدها غمسته في مياه مجمدة.",
 "氷河": "مَثْلَجَة, مَجْلَدَة",
 "氷河学": "علم الجليد (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "氷河時代": "عَصْر جَلِيدِيّ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "氷河期": "عصر جليدي (أي فترة زمنية غطت فيها الأنهار الجليدية جزءاً كبيراً من سطح الأرض)\nمثال: كان أحدث عصر جليدي خلال البليستوسين / جَفَاف",
 "氷滑り": "تزلج على الجليد (التزلج على الجليد)",
 "氷瀑": "شلال جليدي (جزء منحدر من نهر جليدي يشبه شلالاً متجمداً)",
 "氷炭": "تَنَاقُضٌ",
 "氷点": "نقطة الانصهار, نقطة التجمد (درجة الحرارة التي يتحول تحتها السائل إلى صلب)",
 "氷球": "هُوكِي اَلْجَلِيد",
 "氷盤": "طوف جليدي (كتلة مسطحة من الجليد (أصغر من الحقل الجليدي) تطفو في البحر)",
 "氷砂糖": "حلوى صخرية, سكر نبات (سكر على شكل بلورات صلبة كبيرة وشفافة على خيط) / حلوى الروك (عصا حلوى صلبة زاهية الألوان (عادة بنكهة النعناع))",
 "氷箱": "برّاد, ثلاجة (من السلع البيضاء التي يُحفظ فيها الطعام في درجات حرارة منخفضة)",
 "氷糖": "حلوى صخرية, سكر نبات (سكر على شكل بلورات صلبة كبيرة وشفافة على خيط) / حلوى الروك (عصا حلوى صلبة زاهية الألوان (عادة بنكهة النعناع))",
 "氷結": "تجمد, تجميد (سحب الحرارة لتحويل شيء من سائل إلى صلب)",
 "氷菓": "تحلية مجمدة (أي من الحلويات المتنوعة التي تُحضر بالتجميد)",
 "氷菓子": "تحلية مجمدة (أي من الحلويات المتنوعة التي تُحضر بالتجميد)",
 "氷袋": "كمادة ثلج, كيس ثلج (كيس مقاوم للماء مملوء بالثلج؛ يوضع على الجسم لتبريده أو تقليل التورم)",
 "氷解": "اِنْصِهَار, ذَوَبَان (صَهَرَ (الشَّيْءَ) ، كالشّحْمِ ونَحْوِه، يَصْهَرُه صَهْراً: (أَذابَه، فانْصَهَرَ، فَهُوَ صَهِيرٌ)…؛ انصهر المعدن ينصهر انصهاراً:ذاب بفعل الحرارة،تحوّل من حالة صلبة إلى حالة سائلة)",
 "氷輪": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "氷雨": "بَرَد, مطر تلج (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن الميت تبرد جثته. فعل لازم مصدر بَرْد) / السلام عليك, السلام عليكم\nمثال: لا أتحمل البرد.",
 "氷霧": "ضباب جليدي (ضباب شتوي كثيف يحتوي على جزيئات ثلجية)",
 "氷魚": "أسماك صغيرة (الصغار الصالحة للأكل خاصة من الرنجة والاسبرط والهف) / أسماك صغيرة, وايت بيت (أسماك المنوة أو غيرها من الأسماك الصغيرة في المياه العذبة أو المالحة (خاصة الرنجة)؛ تطهى عادة كاملة)",
 "永": "طَوِيل",
 "永々": "إِلَى الْأَبَد (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "永い": "طَوِيل",
 "永え": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "永き": "مكالمة بعيدة المدى, مكالمة دولية (مكالمة هاتفية تتم خارج منطقة الاتصال المحلية)\nمثال: تحدثت معها عبر مكالمة بعيدة المدى",
 "永の": "طَوِيل",
 "永らく": "طَوِيل",
 "永世": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "永久": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "永久不変": "دَوَام (دَوَام)\nمثال: أنا أعمل بدوام جزئي.",
 "永久凍土": "تُربَةُ صَقِيعِيّة",
 "永久性": "بقاء, ديمومة (خاصية القدرة على الوجود لمدة غير محددة)",
 "永久機関": "آلة الحركة الدائمة (آلة يمكنها الاستمرار في العمل إلى ما لا نهاية دون سحب طاقة من مصدر خارجي؛ مستحيلة بموجب قانون حفظ الطاقة)",
 "永久歯": "سن دائمة (أي من الأسنان الـ 32 التي تحل محل الأسنان اللبنية في مرحلة الطفولة المبكرة ويمكن أن تستمر حتى الشيخوخة)",
 "永久磁石": "مغناطيس دائم (مغناطيس يحتفظ بمغنطته بعد إزالته من المجال المغناطيسي)",
 "永久運動": "حركة أبدية (حركة تستمر إلى أجل غير مسمى دون أي مصدر خارجي للطاقة؛ مستحيلة عملياً بسبب الاحتكاك)",
 "永代": "دَوَام (دَوَام)\nمثال: أنا أعمل بدوام جزئي.",
 "永劫": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "永存": "مَتَانَة",
 "永寿": "أقدمية, طول العمر (خاصية العيش طويلاً) / تعمير, طول الخدمة (مدة الخدمة أو البقاء)\nمثال: طول بقائها كنجمة",
 "永年": "دهر, سنوات (فترة زمنية طويلة)\nمثال: نحن نعرف بعضنا منذ دهر",
 "永年在職議員": "عَرِيق, قَدِيم العَهْد (مَوْجود مُنْذُ فَتْرَة طَويلَة)",
 "永永": "إِلَى الْأَبَد (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "永牢": "سَجْن مُؤَبَّد (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "永生": "حياة أبدية, خلود (حياة بلا بداية أو نهاية)",
 "永眠": "راحة أبدية, رقاد (تعابير ملطفة للموت (بناءً على تشبيه بين الاستلقاء في السرير وفي القبر))\nمثال: وريت الثرى (رقدت) بجوار زوجها",
 "永続": "دَوَام (دَوَام)\nمثال: أنا أعمل بدوام جزئي.",
 "永続性": "حَثِيث, دَائِم (لَا يَتَوَقَّفُ أَبَدًا) / مُلَازِمٌ لِلذِّهْن, مُلِحّ (يَعُودُ إِلَى الذِّهْنِ بِاسْتِمْرَارٍ) / دائم, مستديم (باقٍ؛ لا يسقط) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: الأوراق المستديمة تبقى ملتصقة بعد النضج",
 "永続的": "دَائِم",
 "永逝": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "永遠": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "永遠の生命": "حياة أبدية, خلود (حياة بلا بداية أو نهاية)",
 "永遠の眠り": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "氾濫": "غَارِق, مَغْمُور (مُغَطًّى بِالمَاء) / إغراق, تخمة (صفة الوفرة المفرطة لدرجة انخفاض الأسعار)",
 "氾濫原": "سهل فيضي (سهل منخفض مجاور لنهر يتكون بشكل رئيسي من رواسب النهر وعرضة للفيضانات)",
 "汀": "شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة) المنطقة اليابسة على طول حافة النهر. ضِفَّة، جَانِب، شَطّ) / سَاحِل\nمثال: عاد إلى الشاطئ. / شَاطِئ, سَاحِل (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة) المنطقة اليابسة على طول حافة النهر. ضِفَّة، جَانِب، شَطّ)\nمثال: عاد إلى الشاطئ.",
 "汀段": "كتف الطريق (حافة ضيقة من الأرض (غير معبدة عادة) على طول جانب الطريق) / حافة, مسطح ترابي (حافة ضيقة أو رف عادة في أعلى أو أسفل منحدر)\nمثال: توقفت السيارة على كتف الطريق",
 "汀渚": "شَاطِئ, سَاحِل (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة) المنطقة اليابسة على طول حافة النهر. ضِفَّة، جَانِب، شَطّ)\nمثال: عاد إلى الشاطئ.",
 "汀線": "خط الساحل, شاطئ (خط الحدود بين اليابسة والماء)",
 "汁": "عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟ / شُورَبَة (في : هي الحَسَاء) / شُرْبَة / حَسَاء\nمثال: هل مذاق الشوربة جيد؟ / صَلْصَة, مَرَق",
 "汁だく": "رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق) / حَسَائِيّ (ذُو قِوَامٍ وَمَظْهَرٍ يُشْبِهُ الحَسَاء)",
 "汁吸啄木鳥": "نقار الخشب مصاص العصارة أصفر البطن (نقار خشب مصاص للعصارة من شرق أمريكا الشمالية ذو بطن أصفر شاحب)",
 "汁椀": "زبدية حساء, طبق شوربة (وعاء لتقديم الحساء)",
 "汁気": "عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟",
 "汁液": "عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟",
 "汁物": "شُورَبَة (في : هي الحَسَاء) / شُرْبَة / حَسَاء\nمثال: هل مذاق الشوربة جيد؟",
 "求む": "أَرَادَ, رَغِبَ (شَاءَ الشيءَ، رَغِبَ فيه؛ أَحَبَّ، شَهِيَ، اِشْتَهَى. (تخصيص))\nمثال: أراد مني الكذب. / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / بَحَثَ, طَلَبَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث. / شِرَاء, اِشْتِرَاء / مُشْتَرًى, مُشْتَرَيَات / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك.",
 "求むる": "أَرَادَ, رَغِبَ (شَاءَ الشيءَ، رَغِبَ فيه؛ أَحَبَّ، شَهِيَ، اِشْتَهَى. (تخصيص))\nمثال: أراد مني الكذب.",
 "求め": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / شِرَاء, اِشْتِرَاء / مُشْتَرًى, مُشْتَرَيَات / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك.",
 "求める": "أَرَادَ, رَغِبَ (شَاءَ الشيءَ، رَغِبَ فيه؛ أَحَبَّ، شَهِيَ، اِشْتَهَى. (تخصيص))\nمثال: أراد مني الكذب. / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / بَحَثَ, طَلَبَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث. / شِرَاء, اِشْتِرَاء / مُشْتَرًى, مُشْتَرَيَات / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك.",
 "求人": "متطوع, مُجنّد (أي عضو أو مؤيد جديد (كما في القوات المسلحة)) / مجند جديد, مستجد (جندي تم تجنيده حديثاً)",
 "求人広告": "إِعْلَان طَلَب, إِعْلَان مَطْلُوب (إعلان صحفي يذكر ما هو مطلوب)",
 "求人者": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "求婚": "طَلَب زَوَاج, عَرْض زَوَاج (عرض للزواج)",
 "求婚者": "خاطب, طالب الزواج (رجل يتودد لامرأة (بغرض الزواج))",
 "求心": "جَاذِب مَرْكَزِيّ (يميل إلى التحرك نحو المركز) / جَابِذ مَرْكَزِيّ, حِسِّيّ (خاصّ بليف عصبيّ أو نبضة تنشأ خارجيًّا وتتّجه نحو الجهاز العصبيّ المركزيّ) / تَوْحِيدِيّ, مُوَحِّد (يميل إلى التوحيد والتجميع)\nمثال: قوة الجذب المركزي",
 "求心力": "قوة جذب مركزي (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "求心性": "جَاذِب مَرْكَزِيّ (يميل إلى التحرك نحو المركز) / جَابِذ مَرْكَزِيّ, حِسِّيّ (خاصّ بليف عصبيّ أو نبضة تنشأ خارجيًّا وتتّجه نحو الجهاز العصبيّ المركزيّ) / تَوْحِيدِيّ, مُوَحِّد (يميل إلى التوحيد والتجميع)\nمثال: قوة الجذب المركزي",
 "求心性神経": "عصب حسي, عصب وارد (عصب ينقل النبضات من المستقبلات باتجاه أو إلى الجهاز العصبي المركزي)",
 "求心的": "اِنْطِوَائِيّ / جَاذِب مَرْكَزِيّ (يميل إلى التحرك نحو المركز) / جَابِذ مَرْكَزِيّ, حِسِّيّ (خاصّ بليف عصبيّ أو نبضة تنشأ خارجيًّا وتتّجه نحو الجهاز العصبيّ المركزيّ) / تَوْحِيدِيّ, مُوَحِّد (يميل إلى التوحيد والتجميع)\nمثال: قوة الجذب المركزي",
 "求愛": "تودد, مغازلة (تودد الرجل للمرأة؛ السعي لكسب عواطف المرأة (عادةً بهدف الزواج))\nمثال: كانت فترة تودد قصيرة ومكثفة",
 "求法者": "سائل, مستفسر (شخص يطرح سؤالاً)",
 "求知心": "رغبة في المعرفة, نهم للعلم (فضول يحفز البحث والدراسة)",
 "求積": "قياس (فعل أو عملية تعيين أرقام للظواهر وفقًا لقاعدة)\nمثال: تمت القياسات بعناية",
 "求積法": "تربيع (إنشاء مربع له نفس مساحة شكل آخر)",
 "求縁": "تودد, مغازلة (تودد الرجل للمرأة؛ السعي لكسب عواطف المرأة (عادةً بهدف الزواج))\nمثال: كانت فترة تودد قصيرة ومكثفة",
 "求職申し込み": "طَلَب تَوْظِيف (طلب للحصول على وظيفة)",
 "汎ゲルマン主義": "جامعة جرمانية (حركة كان هدفها التوحيد السياسي لجميع الشعوب التي تتحدث الألمانية أو اللغات الجرمانية)",
 "汎スラブ主義": "قَوْمِيَّة سِلَافِيَّة (ما يجمع أمة ذات تاريخ وأمانٍ مشتركة)\nمثال: اللغة اليابانية لغتي القومية.",
 "汎スラヴ主義": "قَوْمِيَّة سِلَافِيَّة (ما يجمع أمة ذات تاريخ وأمانٍ مشتركة)\nمثال: اللغة اليابانية لغتي القومية.",
 "汎化": "تَعْمِيم",
 "汎愛": "عمل خيري, هدية خيرية (التعزيز الطوعي لرفاهية الإنسان)",
 "汎用": "إِجْمالِيّ, جامِع",
 "汎用品": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "汎用型コンピュータ": "حاسوب مركزي (حاسوب رقمي كبير يخدم 100-400 مستخدم ويشغل غرفة خاصة مكيفة الهواء)",
 "汎用性": "تعدد المهارات, موسوعية (امتلاك مجموعة واسعة من المهارات)",
 "汎用機": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "汎用的": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "汎発": "جَائِحَة",
 "汎神教": "وَحْدَة اَلْوُجُود",
 "汎神論": "وَحْدَة اَلْوُجُود",
 "汎血球減少症": "نقص الكريات الشامل (نقص غير طبيعي في جميع خلايا الدم (الحمراء والبيضاء والصفائح الدموية))",
 "汎論": "لَخَّصَ, اِخْتَصَرَ",
 "汎関数": "عملي, وظيفي (مصمم لـ أو قادر على أداء وظيفة أو استخدام معين) / شَغَّال, عَامِل ((عَنِ الآلَات مَثَلًا) يَعْمَلُ أَوْ قَادِر عَلَى العَمَل) / وظيفي (يتعلق بالوظيفة أو يؤثر عليها بدلاً من علم وظائف الأعضاء (الفسيولوجيا)) / وَظِيفِيّ (مصمم لوظيفة معينة أو مكيَّف لاستخدام محدد)\nمثال: أسلوب في الكتابة تكون فيه كل كلمة وظيفية",
 "汐": "مَدّ وَجَزْر (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى. / فُرْصَة",
 "汐合": "فُرْصَة",
 "汗": "عَرَق, عرق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك) / عَرِقَ, عِرِق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق. / رُطُوبَة / تجرع, عب (بلعة كبيرة وسريعة) / بلع, تجرع (منعكس تشنجي للحلق وكأنه في حالة بلع)\nمثال: أنهاه بجرعة واحدة / خَان (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة.",
 "汗おさえ": "مضاد للتعرق (مادة قابضة توضع على الجلد لتقليل التعرق)",
 "汗する": "عَرَق, عرق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك) / عَرِقَ, عِرِق (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
