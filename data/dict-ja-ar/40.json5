 "摸刻": "نُشْخَة",
 "摸擬": "تَقْلِيد",
 "摸製": "نسخ (فعل النسخ)",
 "摸造": "تَقْلِيد",
 "摺り": "طِبَاعَة",
 "摺り出し": "تلميع, صقل (عمل جعل الشيء أملساً ولامعاً عن طريق فركه أو تشميعة)\nمثال: وفر تلميع الأحذية عيشاً ضئيلاً / مُبَارَاة",
 "摺り合せる": "أَصْلَحَ بَيْنَ, وَفَّقَ بَيْنَ",
 "摺り合わせ": "تَصَالُحِيّ, تَوْفِيقِيّ (يميل إلى التوفيق أو التكييف؛ يُحقِّق الانسجام) / تداخل, تراكب (غطاء بتصميم يغطي فيه عنصر جزءاً من عنصر آخر (كما هو الحال في البلاط أو القرميد))",
 "摺り合わせる": "أَصْلَحَ بَيْنَ, وَفَّقَ بَيْنَ",
 "摺り足": "تسكع, جر الأقدام (المشي بحركة جر بطيئة دون رفع القدمين)\nمثال: من طريقة جره لأقدامه افترضت أنه عجوز جداً",
 "摺る": "طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة!",
 "摺足": "تسكع, جر الأقدام (المشي بحركة جر بطيئة دون رفع القدمين)\nمثال: من طريقة جره لأقدامه افترضت أنه عجوز جداً",
 "撃ちそこなう": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "撃ち合い": "تَبَادُل إِطْلَاق نَار, مَعْرَكَة بِالأَسْلِحَة النَّارِيَّة (قتال يتضمن إطلاق أسلحة صغيرة بقصد القتل أو التخويف)",
 "撃ち当てる": "أَصَابَ\nمثال: تلقى مناد ضربة.",
 "撃ち手": "رَامٍ ((رَامَ) الجُرحُ يَرِيمُ رَيْمًا، ورَيَمَانًا: انْضَمَّ فَمُهُ للبُرْءِ؛ (رَامَ)…)",
 "撃ち損なう": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "撃ち方": "إطلاق نار (فعل إطلاق النار من بندقية)\nمثال: تراجعوا في مواجهة نيران العدو الشديدة",
 "撃ち止める": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "撃ち破る": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة.",
 "撃ち落す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "撃ち落とす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "撃つ": "صَوَّبَ (أحد جانبي المدينة التي يقسمها نهر، ومن ذلك صوب الكرخ وصوب الرصافة في بغداد…)\nمثال: صوب الرجل مسدسا نحو المحققين. / حَمْلَة",
 "撃剣": "مُبَارَزَة",
 "撃合い": "تَبَادُل إِطْلَاق نَار, مَعْرَكَة بِالأَسْلِحَة النَّارِيَّة (قتال يتضمن إطلاق أسلحة صغيرة بقصد القتل أو التخويف)",
 "撃手": "رَامٍ ((رَامَ) الجُرحُ يَرِيمُ رَيْمًا، ورَيَمَانًا: انْضَمَّ فَمُهُ للبُرْءِ؛ (رَامَ)…)",
 "撃攘": "رفض, زجر (حالة من الإبعاد أو الصد)",
 "撃柝": "النوبة الليلية, نوبة آخر الليل (نوبة حراسة أثناء الليل (كما من منتصف الليل إلى 8 صباحاً))",
 "撃止める": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "撃沈": "غَرَق / اِنْهَار\nمثال: يوشك الجسر على الانهيار.",
 "撃滅": "تَدْمِير, هَدْم",
 "撃発": "آلَة إِيقَاعِيَّة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "撃砕": "فَتَّتَ",
 "撃破": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "撃茎": "إبرة الإطلاق (مطرقة تشعل الشحنة بضرب الكبسولة)",
 "撃落す": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "撃退": "رفض, زجر (حالة من الإبعاد أو الصد)",
 "撃針": "إبرة الإطلاق (مطرقة تشعل الشحنة بضرب الكبسولة)",
 "撒き散らす": "نَثَرَ, تَفَرَّقَ",
 "撒き菱": "حَسَك ((حَسِكَ) الْمَكَان حسكا: كثر حسكه؛ (حَسِكَ) رَأسه: اشتدت جعودته)",
 "撒き餌": "طعم قاعي (طعم ينثر على الماء لجذب الأسماك)",
 "撒く": "نَثَرَ, تَفَرَّقَ\nمثال: まいた種は刈らねばならない。 — من زرع حصد / وَزَّعَ (كَفَّ ومَنَعَ وحَبَسَ؛ به: أَغْرَى)\nمثال: وزع علينا الورق. / اِنْتَفَضَ",
 "撒布": "نَشْر, بَثّ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "撒布剤": "بودرة تجميل, بودرة جسم (مسحوق ناعم لنشره على الجسم (كما بعد الاستحمام))",
 "撒菱": "حَسَك ((حَسِكَ) الْمَكَان حسكا: كثر حسكه؛ (حَسِكَ) رَأسه: اشتدت جعودته)",
