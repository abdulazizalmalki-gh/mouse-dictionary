 "昼日なか": "نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر…)\nمثال: نهار اليوم ممل!",
 "昼日中": "نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر…)\nمثال: نهار اليوم ممل!",
 "昼時": "ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "昼盲症": "عشى, عمى نهاري (عدم القدرة على الرؤية بوضوح في الضوء الساطع)",
 "昼興行": "حفلة نهارية, ماتينيه (عرض مسرحي يُقام خلال النهار (خاصة بعد الظهر))",
 "昼行性": "نَهَارِيّ",
 "昼行灯": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "昼過ぎ": "بَعْد الظُّهْر, بَعْدَ الزَّوَال (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "昼間": "نَهَارُ (انْتِشَار البَصَر وافْتِرَاقه؛ الفترة المضيئة من اليَوْم ما بين طلوع الفَجْر…)\nمثال: نهار اليوم ممل!",
 "昼食": "غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام…)\nمثال: إنه وقت الغداء.",
 "昼食会": "اجتماع غداء, غداء عمل (اجتماع على الغداء؛ عادة لإجراء الأعمال أثناء تناول الطعام)",
 "昼飯": "غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام…)\nمثال: إنه وقت الغداء.",
 "昼餉": "غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام…)\nمثال: إنه وقت الغداء.",
 "昼餐": "غداء (وجبة منتصف النهار)",
 "昼鳶": "لص متسلل (لص يسرق دون استخدام العنف) / نَشَّال",
 "時": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / فُرْصَة, مُنَاسَبَة\nمثال: أرى مرآة مناسبة / فُرْصَة / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية)\nمثال: قضينا وقتاً ممتعاً في الحفلة / مَوْسِم",
 "時々": "أَحْيَانًا, سَاعَات / موسمي (يحدث في أو يعتمد على موسم معين)\nمثال: عمالة موسمية",
 "時々刻々": "بالساعة, كل ساعة (كل ساعة؛ حسب الساعة)\nمثال: يومياً، بل كل ساعة، كنت أزداد قوة",
 "時あたかも": "عندئذ, في تلك اللحظة (في وقت معين في الماضي)\nمثال: عندئذ انطلق البوق",
 "時おり": "أَحْيَانًا, سَاعَات",
 "時が解決する": "الزَّمَن يُعَالِجُ كُل الأَجْرَاح",
 "時たま": "أحياناً, بين الحين والآخر (بشكل متقطع وغير متكرر)\nمثال: كان متغطرساً وقاسياً أحياناً",
 "時つ": "فِي الوَقْت المُنَاسِب (في وقت ملائم)\nمثال: وصلت رسالتك في الوقت المناسب",
 "時として": "أَحْيَانًا, سَاعَات",
 "時なし大根": "على مدار السنة (يعمل أو يستمر طوال العام)\nمثال: منتجع يعمل على مدار السنة",
 "時ならぬ": "مُفَاجِئ",
 "時に": "بِالْمُنَاسَبَةِ, عَلَى فِكْرَةٍ / أَحْيَانًا, سَاعَات / بِدِقَّة",
 "時には": "أَحْيَانًا",
 "時の": "مَرْغُوب, مَطْلُوب (مَطْلُوبٌ كَثِيرًا)",
 "時の気": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "時の運": "فُرْصَة",
 "時は金なり": "اَلْوَقْتُ مِنْ ذَهَبٍ",
 "時めく": "ازدهر",
 "時を同じくして": "فِي نَفْس اَلْوَقْت (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "時を得た": "فِي الوَقْت المُنَاسِب (في وقت ملائم)\nمثال: وصلت رسالتك في الوقت المناسب",
 "時を移さず": "حَالاً (مباشرةً، فوراً، دون تأخير؛ في هذه الأثناء، في الوضع الحالي)\nمثال: سأكون معك حالا.",
 "時んば": "أَحْيَانًا",
 "時下": "الآن, اليوم (في هذه الأوقات)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام",
 "時世": "فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "時人": "جيل, معاصرون (جميع الناس الذين يعيشون في نفس الوقت أو من نفس العمر تقريباً)",
 "時代": "نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه. / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / شيخوخة, قدم (جودة كون الشيء قديماً؛ عكس الجدة) / عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير.",
 "時代物": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير. / عمل فني تاريخي (أي عمل فني تكمن قيمته الخاصة في استحضاره لفترة تاريخية)",
 "時代精神": "رُوحُ الْعَصْر (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة.",
 "時代遅れ": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "時代錯誤": "أداة لا تتناسب مع العصر, شيء في غير زمنه (غرض أو أداة تنتمي إلى زمن آخر غير الذي توجد فيه)",
 "時余": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو…)\nمثال: مزيد من الأرض",
 "時価": "ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن.",
 "時価主義": "سعر السوق, قيمة سوقية (السعر الذي يتبادل به المشترون والبائعون السلعة في سوق مفتوح)",
 "時価総額": "القيمة السوقية, رسملة السوق (تقدير لقيمة شركة يتم الحصول عليه بضرب عدد الأسهم القائمة في السعر الحالي للسهم)",
 "時候": "مَوْسِم",
 "時候外れ": "في غير موسمه (لا يتماشى مع (وعادة ما يكون غير مرغوب فيه لـ) الموسم)\nمثال: عاصفة ثلجية مفاجئة في غير موسمها",
 "時分": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / فُرْصَة",
 "時分時": "وقت الطعام, وقت الوجبة (الساعة التي تُؤكل فيها وجبة عادة أو عرفاً)",
 "時制": "صِيغَة, صِيغَةُ الْفِعْل",
 "時刻": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / فُرْصَة",
 "時刻表": "جَدْوَل مَوَاعِيد, جَدْوَل",
 "時効": "وَصْفَة طِبِّيَّة, وَصْفَة / لم يعد (ليس الآن)\nمثال: لم تعد موجودة / آخِذ فِي الشَّيْخُوخَة, شَائِخ (في طور التقدّم في السنّ والشيخوخة)",
 "時勢": "فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "時半": "السَّاعَة وَالنِّصْف, السَّاعَة الْوَاحِدَة وَالنِّصْف",
 "時圏": "دائرة الساعة (دائرة عظمى على الكرة السماوية تمر عبر كلا القطبين السماويين)",
 "時報": "إشارة الوقت (إشارة (خاصة إلكترونية أو لاسلكية) تشير إلى الوقت الصحيح بدقة) / تقرير, خبر (سرد قصير للأخبار)\nمثال: تقرير خطابه",
 "時好": "تَقْلِيعَة",
 "時季": "مَوْسِم",
