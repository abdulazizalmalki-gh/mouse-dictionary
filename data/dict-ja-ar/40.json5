 "清風": "متنفس, نسمة هواء عليل (ارتياح مرحب به)\nمثال: كانت الإدارة الجديدة بمثابة نسمة هواء عليل",
 "清麗": "نَظِيف / نضيف / نَظَّفَ",
 "渇": "عَطَش, ظَمَأ (مصدر للفعل \"عَطِشَ\"؛ الإحساس بالجفاف في الحلق المتعلق بالتشوق من أجل السوائل بسبب انعدام الشرب أو لسبب آخر، كالخوف أو غيرها، مما يوقف إنتاج الغشاء المخاطي) / عَطِشَ, ظَمِئَ (مصدر للفعل \"عَطِشَ\"؛ الإحساس بالجفاف في الحلق المتعلق بالتشوق من أجل السوائل بسبب انعدام الشرب أو لسبب آخر، كالخوف أو غيرها، مما يوقف إنتاج الغشاء المخاطي)\nمثال: لا أشعر بالعطش.",
 "渇き": "عَطَش, ظَمَأ (مصدر للفعل \"عَطِشَ\"؛ الإحساس بالجفاف في الحلق المتعلق بالتشوق من أجل السوائل بسبب انعدام الشرب أو لسبب آخر، كالخوف أو غيرها، مما يوقف إنتاج الغشاء المخاطي) / عَطِشَ, ظَمِئَ (مصدر للفعل \"عَطِشَ\"؛ الإحساس بالجفاف في الحلق المتعلق بالتشوق من أجل السوائل بسبب انعدام الشرب أو لسبب آخر، كالخوف أو غيرها، مما يوقف إنتاج الغشاء المخاطي)\nمثال: لا أشعر بالعطش. / تَوْق, تَشَوُّق",
 "渇く": "اِشْتَهَى",
 "渇仰": "توقير, عبادة (العبادة المقدمة لله وحده) / تبجيل, عشق (فعل الإعجاب بشدة) / عبادة, هيام (شعور بالحب العميق والإعجاب)",
 "渇愛": "عَطَش, ظَمَأ (مصدر للفعل \"عَطِشَ\"؛ الإحساس بالجفاف في الحلق المتعلق بالتشوق من أجل السوائل بسبب انعدام الشرب أو لسبب آخر، كالخوف أو غيرها، مما يوقف إنتاج الغشاء المخاطي) / عَطِشَ, ظَمِئَ (مصدر للفعل \"عَطِشَ\"؛ الإحساس بالجفاف في الحلق المتعلق بالتشوق من أجل السوائل بسبب انعدام الشرب أو لسبب آخر، كالخوف أو غيرها، مما يوقف إنتاج الغشاء المخاطي)\nمثال: لا أشعر بالعطش.",
 "渇望": "تَوْق, تَشَوُّق",
 "渇望者": "جاذِبيّة / إشْراق, تَهْذِيب",
 "渇水期": "موسم الجفاف (أحد الموسمين في المناخات الاستوائية، فترة سنوية يقل فيها هطول الأمطار في المناطق الاستوائية)",
 "済": "مُرَتَّب, مُعَدّ لِلتَّأْثِير (مرتب عمدًا لإحداث تأثير معين) / مُدَبَّر, مُرَتَّب (منظم أو مخطط له مسبقاً) / مرتب, منسق (موضع أو مرتب بنوع معين من النظام)\nمثال: قطع الشطرنج المرتبة بعناية",
 "済す": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "済ます": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "済ませる": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل. / حَلَّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: حل زيري المشكل.",
 "済まない": "لَا يُعْذَر, لَا يُغْتَفَر (لَا يُمْكِنُ التَّمَاسُ العُذْرِ لَه) / غير معذور, لا مبرر له (بدون عذر أو مبرر) / آسِف / حَزِين / مُؤْسِف, مُحْزِن / آسِف, آسِفَة / عَفْوًا!, مَاذَا قُلْتَ؟",
 "済まなそう": "آسِف / حَزِين / مُؤْسِف, مُحْزِن / آسِف, آسِفَة",
 "済まぬ": "عَفْوًا!, مَاذَا قُلْتَ؟",
 "済み": "مُرَتَّب, مُعَدّ لِلتَّأْثِير (مرتب عمدًا لإحداث تأثير معين) / مُدَبَّر, مُرَتَّب (منظم أو مخطط له مسبقاً) / مرتب, منسق (موضع أو مرتب بنوع معين من النظام)\nمثال: قطع الشطرنج المرتبة بعناية",
 "済みません": "عَفْوًا!, مَاذَا قُلْتَ؟ / شُكْرًا, تِسْلَم",
 "済む": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "済南": "جِينَان",
 "済度": "فِدَاء / خَلَاص",
 "渉外": "عَلَاقَات عَامَّة",
 "渉外係": "رجل علاقات عامة (رجل موظف لترتيب الدعاية (لشركة أو شخصية عامة))",
 "渉外私法": "قَانُون دُوَلِيّ خَاصّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "渉禽類": "طائر خائض (أي من الطيور طويلة الساقين العديدة التي تخوض في الماء بحثاً عن الطعام)",
 "渋々": "بتردد, على مضض (مع تردد أو عدم رغبة)",
 "渋い": "مُقَلِص / زَاهِد, مُتَقَشِّف (يُمارِس حرمانًا ذاتيًّا شديدًا) / صَارِم, قَاسِي المَلَامِح (ذو هيئة أو سلوك صارم وجادّ؛ مُنفّر في المظهر) / تَقَشُّفِيّ, صَارِم (بسيط بشكل صارم وخالٍ من أيّ زخرفة) / حَامِض / بَخِيل (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ؛ شَحِيْح، مُقْتِر)\nمثال: بئس الرجل البخيل.",
 "渋い顔をする": "عُبُوسة, عُبُوس / عَبَسَ, عَقَدَ حَاجِبَيْهُ",
 "渋ちん": "بَخِيل, بَخِيلَة (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ؛ شَحِيْح، مُقْتِر)\nمثال: بئس الرجل البخيل.",
 "渋み": "تأثير قابض, قبض (القدرة على قبض أو تجميع أنسجة الجسم الرخوة لوقف تدفق الدم أو تقييد إفراز السوائل) / عفوصة, قابضية (طعم قابض حاد؛ تجربة التذوق عندما تسبب مادة ما انكماشاً في الفم)",
 "渋る": "تَرَدَّدَ (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد. / تردد, تلكؤ (فعل التوقف بشكل غير مؤكد)\nمثال: كان هناك تردد في كلامه",
 "渋味": "تأثير قابض, قبض (القدرة على قبض أو تجميع أنسجة الجسم الرخوة لوقف تدفق الدم أو تقييد إفراز السوائل) / عفوصة, قابضية (طعم قابض حاد؛ تجربة التذوق عندما تسبب مادة ما انكماشاً في الفم)",
 "渋渋": "بتردد, على مضض (مع تردد أو عدم رغبة)",
 "渋滞": "اِحْتِقَان\nمثال: 渋滞で遅れました。 — أخّرني زحام السير. / تَأْخِير, تَأَخَّر / أَجَّلَ, أَبْطَأَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "渋色": "حِنْطِيّ / قَمْحِيُّ اللَّوْن / اِسْمَرَّ / دَبَغَ (عالجه بمادة ليلين وَيَزُول مَا بِهِ من رُطُوبَة ونتن؛ دبغ الْمَطَر الأَرْض بمائه فَهُوَ دابغ ودبوغ وَالْمَفْعُول مدبوغ ودبيغ)",
 "渋谷": "شِيبُويَا",
 "渋面": "تجهم, تكشيرة (تعبير وجهي ملتوي)\nمثال: قامت بتجهم عند التفكير في الأمر",
 "渓": "وَادٍ, الْوَادِي (حوض أو منخفض طبيعي على سطح الأرض، يمتد بين السهول والهضاب والجبال)\nمثال: بإمكاني السباحة في الواد.",
 "渓壑": "وَهْدَة",
 "渓澗": "وَادٍ, الْوَادِي (حوض أو منخفض طبيعي على سطح الأرض، يمتد بين السهول والهضاب والجبال)\nمثال: بإمكاني السباحة في الواد.",
 "渓谷": "وَادٍ, الْوَادِي (حوض أو منخفض طبيعي على سطح الأرض، يمتد بين السهول والهضاب والجبال)\nمثال: بإمكاني السباحة في الواد.",
 "渓間": "وَهْدَة",
 "渕": "مشكلة عويصة, مياه عميقة (مشكلة خطيرة) / أعماق, أغوار ((الجمع) الجزء الأعمق والأكثر بعداً)\nمثال: من أعماق أفريقيا المظلمة",
 "渙散": "اِنْحِلَال",
 "渙然": "طَلِيق, مَحْلُول القُيُود (غير مُقيَّد بأغلال أو سلاسل) / مَحْلُول الأَرْبِطَة (مع أربطة غير مربوطة) / غَيْر مَرْبُوط, مَحْلُول (غير مربوط)\nمثال: مراهقون يتسكعون بأحذية رياضية محلولة الأربطة",
 "渚": "شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة) المنطقة اليابسة على طول حافة النهر. ضِفَّة، جَانِب، شَطّ) / سَاحِل\nمثال: عاد إلى الشاطئ. / شَاطِئ, سَاحِل (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة) المنطقة اليابسة على طول حافة النهر. ضِفَّة، جَانِب، شَطّ)\nمثال: عاد إلى الشاطئ.",
 "渚畔": "شَاطِئ, سَاحِل (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة) المنطقة اليابسة على طول حافة النهر. ضِفَّة، جَانِب، شَطّ)\nمثال: عاد إلى الشاطئ.",
 "減": "نَقْص / طَرْح (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "減じる": "تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى / قَلَّلَ / خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ) / أَقْلَعَ / اِزْدَهَرَ\nمثال: خلع سامي حذاءه.",
 "減ずる": "تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى / قَلَّلَ / خَلَعَ (نَزَعَ، أَزَالَ إلا أنَّ في الخَلْعِ مُهْلَةً (لسان العرب)؛ عَزَلَ) / أَقْلَعَ / اِزْدَهَرَ\nمثال: خلع سامي حذاءه.",
