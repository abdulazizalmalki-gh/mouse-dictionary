 "海風": "نسيم البحر (نسيم منعش من البحر (خلال النهار))",
 "海食柱": "كَوْمَة / كُومَة",
 "海馬": "فَظّ / فيل البحر (أي من نوعين من الفقمات الكبيرة عديمة الأذن في شمال المحيط الأطلسي لها خطم يشبه الخرطوم) / أسد البحر ستيلر (أكبر أسود البحر؛ يعيش في شمال المحيط الهادئ) / حصان البحر (سمكة صغيرة برأس يشبه الحصان ينحني بحدة للأسفل وذيل ملتف؛ تسبح في وضع عمودي) / فظ (أي من ثدييين بحريين شماليين كبيرين لهما أنياب عاجية وجلد قوي فوق دهن سميك) / حصين (بنية عصبية معقدة (تشبه حصان البحر) تتكون من مادة رمادية وتقع على أرضية كل بطين جانبي؛ تشارك بشكل وثيق في الدافع والعاطفة كجزء من الجهاز الحوفي؛ ولها…) / فَظّ",
 "海馬状隆起": "حصين (بنية عصبية معقدة (تشبه حصان البحر) تتكون من مادة رمادية وتقع على أرضية كل بطين جانبي؛ تشارك بشكل وثيق في الدافع والعاطفة كجزء من الجهاز الحوفي؛ ولها…)",
 "海魚": "سمك مياه مالحة (لحم الأسماك البحرية المستخدم كطعام)",
 "海鮮": "مَأْكُولَات بَحْرِيَّة, طَعَام الْبَحْر",
 "海鮮醤": "صلصة البط, صلصة هويسين (تابل صيني سميك حلو ولاذع)",
 "海鰓": "قلم البحر (مستعمرات لحمية تشبه الريش تعيش في المياه الدافئة)",
 "海鱒": "ترويت بحري (نوع بحري فضي اللون من الترويت البني يهاجر إلى المياه العذبة للتكاثر) / ترويت بحري (أي من عدة أسماك بهارية في المياه الساحلية لأمريكا الشمالية) / تراوت بحري (لحم التراوت البحري الذي يهاجر من المياه المالحة إلى العذبة)",
 "海鱮": "شوب البحر (أسماك تعيش في أسراب غالباً في المحيط الهندي وغرب المحيط الهادئ؛ نوعان في غرب المحيط الأطلسي)",
 "海鳥": "طائر بحري (طائر يتردد على المياه الساحلية والمحيط المفتوح: النوارس، البجع، الأطيش، الغاق، القطرس، النوء، إلخ)",
 "海鳥糞": "جوانو, ذرق الطيور (فضلات الطيور البحرية؛ تستخدم كسماد)",
 "海鳩": "غلموت الحمام (غلموت شمال المحيط الهادئ)",
 "海鴉": "مور شائع (أكثر أنواع طائر المور شيوعاً)",
 "海鷂魚": "شُعَاع / شِفْنِين, شِفْنِين بَحْرِيّ",
 "海鼠": "خيار البحر (الإسم من الإختيار ، وهو إنتقاء شيء فيكون خير من غيره؛ صيغة جمع لخير ، بمعنى أفضل)\nمثال: لم يكن لدي خيار.",
 "浸ける": "اِبْتَلَّ\nمثال: 彼はスプーンをスープの中につけた。 — هو غمس ملعقته في الحساء.",
 "浸け置き": "نقع (غسل شيء عن طريق تركه منقعاً في سائل) / إشباع بالماء, نقع (فعل جعل الشيء مبللاً تماماً) / غارقاً في البلل, مبللاً تماماً (رطب للغاية) / غمر, نقع (عملية التلين والتشبع نتيجة الغمر في الماء (أو سائل آخر))\nمثال: نقعه بالماء نقعاً",
 "浸す": "اِبْتَلَّ\nمثال: 鳥は首をひょいと水に浸した。 — الطائر غمس رأسه في الماء. / مُبْتَلّ / مَبْلُول, مُبْتَلّ",
 "浸入": "تسلل (عملية يخترق فيها أفراد (أو مجموعات صغيرة) منطقة (خاصة الاختراق العسكري لمواقع العدو دون كشفهم)) / تخلل, ترشيح (المرور البطيء لسائل عبر وسط ترشيح)\nمثال: تخلل مياه الأمطار عبر التربة",
 "浸出": "تسلل (عملية يخترق فيها أفراد (أو مجموعات صغيرة) منطقة (خاصة الاختراق العسكري لمواقع العدو دون كشفهم)) / تخلل, ترشيح (المرور البطيء لسائل عبر وسط ترشيح)\nمثال: تخلل مياه الأمطار عبر التربة",
 "浸剤": "بث, حقن (فعل غرس أو إدخال عنصر أو صفة معدلة معينة) / تسريب ((طب) الإدخال السلبي لمادة (سائل أو دواء أو إلكتروليت) في وريد أو بين الأنسجة (كما عن طريق قوة الجاذبية)) / منقوع, نقع (عملية استخلاص خصائص فعالة معينة (كدواء من نبات) عن طريق النقع أو الغمر (عادة في الماء)) / مستخلص, منقوع (محلول يتم الحصول عليه عن طريق نقع مادة (عادة في الماء))\nمثال: يُعزى النجاح المستمر للفريق إلى الضخ المستمر للمواهب الجديدة",
 "浸水": "فيضان",
 "浸漬": "نقع (غسل شيء عن طريق تركه منقعاً في سائل) / إشباع بالماء, نقع (فعل جعل الشيء مبللاً تماماً) / غارقاً في البلل, مبللاً تماماً (رطب للغاية) / غمر, نقع (عملية التلين والتشبع نتيجة الغمر في الماء (أو سائل آخر))\nمثال: نقعه بالماء نقعاً",
 "浸潤": "تسلل (عملية يخترق فيها أفراد (أو مجموعات صغيرة) منطقة (خاصة الاختراق العسكري لمواقع العدو دون كشفهم)) / تخلل, ترشيح (المرور البطيء لسائل عبر وسط ترشيح)\nمثال: تخلل مياه الأمطار عبر التربة / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "浸礼教会": "الكنيسة المعمدانية, المعمدانيون (أي من مختلف الكنائس البروتستانتية الإنجيلية التي تؤمن بمعمودية المؤمنين الطوعيين)",
 "浸透": "تداخل, تغلغل متبادل (اختراق متبادل؛ انتشار كل طرف خلال الآخر) / تشرب, تغلغل (عملية تغلغل مادة في شيء ما أو تشبعه بها) / خَاصِّيَّة أُسْمُوزِيَّة, تَنَاضُح",
 "浸透圧": "ضغط أسموزي, ضغط تناضحي ((في الكيمياء الفيزيائية) الضغط الذي يمارسه محلول واللازم لمنع التناضح إلى ذلك المحلول عندما يتم فصله عن المذيب النقي بواسطة غشاء شبه منفذ)",
 "浸透性": "خَاصِّيَّة أُسْمُوزِيَّة, تَنَاضُح",
 "浸透探傷検査": "بِي, پِي / ط, بَاي (الحرف السادس عشر في الترتيب الهجائي العربي والتاسع في ترتيب الأبجدية العربية؛ يسبقه \"ض\" ويتبعه \"ظ\"؛ عدد غير نسبي يمثل محيط الدائرة إلى قُطْرِهَا)",
 "浸食": "تآكل, حت (تآكل بفعل العمليات الكيميائية) / تعرية, نحت ((في الجيولوجيا) العملية الميكانيكية لتآكل أو طحن شيء ما (كما يحدث عند غسل الجسيمات له)، وتستخدم مجازياً أيضاً) / تآكل, تراجع (انخفاض تدريجي لشيء ما) / تآكل, تعرية (حالة يتآكل فيها سطح الأرض بفعل الماء والرياح)\nمثال: بعد فضيحة المحاسبة كان هناك تآكل في الثقة في المدققين",
 "涅槃": "اَلنِّرْفَانَا / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "涅色": "أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / أَسْوَد (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / زِنْجِيّ, زَنْجِيّ / أَسْوَد, أسود (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن)\nمثال: لديه قميص أسود.",
 "消えうせる": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "消えうせろ": "اُغْرُب عَن وَجْهِي!, إِبْتَعِد عَنِّي! / ضَلَّ الطَّرِيق",
 "消えてなくなる": "اِنْقَرَضَ",
 "消えないインク": "حبر لا يمحى (حبر لا يمكن مسحه أو غسله)",
 "消えゆく": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "消える": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل. / اختفاء, تلاشٍ (التوقف التدريجي عن الظهور) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة / اِبْتَعَدَ",
 "消え去る": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "消え失せる": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "消え失せろ": "اُغْرُب عَن وَجْهِي!, إِبْتَعِد عَنِّي! / ضَلَّ الطَّرِيق",
 "消え残る": "نَجَا",
 "消え行く": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "消し": "نَقْص",
 "消しこみ": "صُلْح, مُصَالَحَة",
 "消しゴム": "مِمْحَاة",
 "消し印": "خَتْم بَرِيدِيّ (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "消し去る": "تَخَلَّصَ ؛ مِن",
 "消し止める": "أَنْتَجَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت)",
 "消し炭": "جَمْرُ مُنْطَفِيّ ((جمر) الْفرس جمرا وثب فِي الْقَيْد وَفُلَانًا أعطَاهُ جمرا ونحاه؛ جَمَرَ: الجَمْر: النَّارُ الْمُتَّقِدَةُ، وَاحِدَتُهُ جَمْرَةٌ. فإِذا بَرَدَ فَهُوَ فَحْمٌ)\nمثال: أنا أنتظر قرارك على أحر من الجمر.",
 "消し込み": "صُلْح, مُصَالَحَة",
 "消す": "مَحَا, مَحَى / اِمَّحَى, اِنْمَحَى / أَطْفَأَ / نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا. / اِتَّسَعَ, اِحْتَوَى / اِمْتَصَ, تَشَرَّبَ / اِحْتَلَّ, شَغَلَ (الموضعَ: نزل به وكان لغيره قبله؛ الجيشُ البلدَ: فتحها ثم نزل بها غصبا عن أهلها وبلا رضاهم، استولى عليها) / اِسْتَنْفَدَ / اِسْتَوْعَبَ, وَعَى / دَفَعَ, تَحَمَّلَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "消する": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / تَخَلَّصَ ؛ مِن / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "消ずる": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / تَخَلَّصَ ؛ مِن / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "消ゆ": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "消光": "اِنْقِرَاض / إخماد, إطفاء (فعل الإطفاء؛ التسبب في توقف الاحتراق)\nمثال: إطفاء الأنوار",
 "消化": "هَضْم / اِسْتِهْلَاك",
 "消化不良": "عُسْر الهَضَم, تُخْمَة (جعَل شيئًا صعبًا أو أكثر تعقيدًا؛ وضع عوائق أو صعوبات أمام أمرٍ ما)\nمثال: إن مع العسر يسرا. / غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "消化剤": "هَضْمِيّ / جِهَاز هَضْمِيّ",
 "消化器学": "طب الجهاز الهضمي (فرع الطب الذي يدرس الجهاز الهضمي وأمراضه)",
