 "政治献金": "تبرع سياسي (مساهمة تُقدم لسياسي أو حملة سياسية أو حزب سياسي)",
 "政治理論": "أيديولوجيا, توجه سياسي (توجه يميز تفكير مجموعة أو أمة)",
 "政治的": "سِيَاسِيّ",
 "政治的に正しい": "صائب سياسيا (يظهر الصواب السياسي)",
 "政治的指導者": "سياسي (شخص نشط في السياسة الحزبية)",
 "政治経済学": "اقتصاد, علم الاقتصاد (فرع العلوم الاجتماعية الذي يتعامل مع إنتاج وتوزيع واستهلاك السلع والخدمات…)",
 "政治行動委員会": "لجنة العمل السياسي (لجنة تشكلها مجموعة مصالح خاصة لجمع الأموال لمرشحيها السياسيين المفضلين)",
 "政治要綱": "مِنَصَّة",
 "政治運動": "حملة انتخابية (حملة المرشح ليتم انتخابه)\nمثال: أدرت حملته لمنصب الحاكم",
 "政法": "عُلُوم سِيَاسِيَّة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: علم، عُلُوْم)\nمثال: الصبر أم العلوم.",
 "政界": "سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب…)\nمثال: عاد إلى السياسة.",
 "政略": "سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب…)\nمثال: عاد إلى السياسة.",
 "政略結婚": "زَوَاج مَصْلَحَة",
 "政策": "سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب…)\nمثال: عاد إلى السياسة.",
 "政策官庁": "مَعْنِيّ بِرَسْم السِّيَاسَات (يهتم بالسياسات العامة لا بالإدارة التنفيذية)",
 "政策方針": "خط مشترك (خط هاتف يخدم مشتركين اثنين أو أكثر)\nمثال: فاز في تصويت على أساس خطوط الحزب",
 "政策決定者": "صَانِعُ سِيَاسَة (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى.",
 "政策決定過程": "مَعْنِيّ بِرَسْم السِّيَاسَات (يهتم بالسياسات العامة لا بالإدارة التنفيذية)",
 "政策研究大学院大学": "مَقْبِض",
 "政策立案者": "صانع القرار, واضع السياسات (شخص يضع الخطة التي تتبعها حكومة أو شركة وما إلى ذلك)\nمثال: غالباً ما يتخذ صناع القرار القرار الصحيح لسبب خاطئ",
 "政道": "سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب…)\nمثال: عاد إلى السياسة.",
 "故": "مُتَأَخِّر / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل. / بِسَبَب, بِحُكْم / عَمْدًا / خُصُوصًا, خَاصَّةً / سَابِق / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)\nمثال: و بعد قليل أتى. / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "故なしとしない": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "故に": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "故事": "تَقْلِيد",
 "故事来歴": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "故人": "مَيِّت مَيْت, مُتَوَفًّى",
 "故意": "نِيَّة / قصد جنائي, نية جرمية ((قانون) النية الإجرامية؛ الأفكار والنوايا وراء فعل خاطئ (بما في ذلك المعرفة بأن…)",
 "故意に": "عُمْداً",
 "故殺": "قتل خطأ, قتل غير متعمد (قتل دون سبق إصرار وترصد)",
 "故無しとしない": "مَعْقُول (مربوط، قد عُقِلَ بالعِقَال؛ ما يمكن عَقْلَه بالعَقْل)\nمثال: زيري يخاف العناكب بصفة غير معقولة.",
 "故買": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "故買者": "مِذْيَاع, رَادِيُو",
 "故郷": "مَسْقَط اَلرَّأْس, وَطَن الأُمّ (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد…)\nمثال: دفنت في مسقط رأسها. / خَرَاب, خَرَابَة",
 "故郷忘じ難し": "هُنَاكَ, يُوجَدُ",
 "故障": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة…)\nمثال: كان خطأ حاسوبي. / عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام…)\nمثال: ذهب سامي في عطلة. / تَمْرِين / اِعْتَرَاض",
 "故障中": "مُعَطَّل",
 "故障車": "مُعَطَّل",
 "敏": "سَرِيع\nمثال: ينبح كلب في الحي.",
 "敏い": "ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي. / حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ…)\nمثال: عندك ذاكرة حادة.",
 "敏し": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ…)\nمثال: عندك ذاكرة حادة. / شَدِيد / سَرِيع\nمثال: ينبح كلب في الحي. / سَنِين, مُرْهَف (له حافة قاطعة أو رأس حادّ)",
 "敏感": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "敏捷": "خَفِيف الحَرَكَة, رَشِيق (يتحرّك بسرعة وخفّة) / سَرِيع\nمثال: ينبح كلب في الحي.",
 "敏捷力": "براعة يدوية, خفة يد (البراعة في استخدام اليدين)",
 "敏捷性": "خفة الحركة, مرونة (رشاقة شخص أو حيوان سريع وخفيف الحركة)",
 "敏活": "سرعة (معدل سريع)\nمثال: براعته السريعة كانت نتاج تصميم جيد",
 "敏腕": "قُدْرَة, مَقْدِرَة",
 "敏速": "سرعة (معدل سريع)\nمثال: براعته السريعة كانت نتاج تصميم جيد",
 "救い": "مُسَاعَدَة, مَعُونَة\nمثال: علي مساعدة ماري. / خَلَاص, تَطْهِير اَلنَّفْس",
 "救いの手": "مساعدة, يد العون (مساعدة جسدية)\nمثال: أعطني يد العون في الأعمال المنزلية",
 "救いようのない": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "救い主": "مُخَلِّص, مُنْقِذ (الشخص الذي يفي ولا يخون)\nمثال: الغيرة لا تجعل أحد مخلص / مَسِيح",
 "救い出す": "أَنْقَذَ, خَلَّصَ",
 "救い様のない": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "救う": "أَنْقَذَ, خَلَّصَ / أَنْقَذَ, أَنْجَى\nمثال: حفظ رقم هاتفها.",
 "救われない": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "救世": "خَلَاص, تَطْهِير اَلنَّفْس",
 "救世主": "مُخَلِّص, مُنقِذ (شخص ينقذك من الأذى أو الخطر) / مَسِيح",
 "救世軍": "جيش الخلاص (منظمة خيرية ودينية للتبشير ورعاية الفقراء والمشردين)",
 "救出": "أَنْقَذَ, خَلَّصَ",
 "救助": "رَاحَة, تَخْفِيف",
 "救助活動": "عملية إنقاذ (عملية منظمة للتحرير من الخطر أو الحبس)",
 "救助網": "شبكة أمان (شبكة قوية كبيرة لالتقاط لاعبي سيرك الأكروبات الذين يسقطون أو يقفزون من الأرجوحة)",
 "救助船": "قَارِب نَجَاةَ (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير",
 "救助艇": "قَارِب نَجَاةَ (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير",
 "救命": "إنقاذ الغرقى (إنقاذ حياة الغرقى)\nمثال: أخذ دورة في إنقاذ الغرقى",
 "救命いかだ": "طوف نجاة (طوف يستخدم إذا كان يجب التخلي عن السفينة في حالة الطوارئ)",
 "救命ボート": "قَارِب نَجَاةَ (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير",
 "救命救急士": "مُسْعِف, مُسْعِفة",
 "救命桴": "طوف نجاة (طوف يستخدم إذا كان يجب التخلي عن السفينة في حالة الطوارئ)",
 "救命筏": "طوف نجاة (طوف يستخدم إذا كان يجب التخلي عن السفينة في حالة الطوارئ)",
 "救命索": "حبل النجاة (حبل يُلقى من سفينة ليتمسك به الناس لإنقاذ أنفسهم من الغرق)\nمثال: وفر الجسر الجوي شريان حياة لبرلين",
 "救命胴衣": "سُتْرَة نَجَاة, صِدَار نَجَاة (ضرب من اللِبَاس الخارجي، عبارة عن ثوب قصير يصل إلى الخصر مفتوح من أمام…)\nمثال: أحتاج سترة جديدة",
 "救命艇": "قَارِب نَجَاةَ (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير",
 "救急": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "救急医療": "طب الطوارئ (فرع الطب المعني بالتشخيص والعلاج الفوري للإصابات أو الصدمات أو المرض المفاجئ)",
 "救急医療室": "غرفة الطوارئ (غرفة في مستشفى أو عيادة مزودة بطاقم ومعدات لتوفير رعاية طارئة للأشخاص الذين…)",
 "救急所": "محطة إسعافات أولية (محطة تقدم الرعاية الطارئة أو العلاج قبل التمكن من الحصول على المساعدة الطبية…)",
 "救急救命士": "مُسْعِف, مُسْعِفة",
 "救急救命室": "غرفة الطوارئ (غرفة في مستشفى أو عيادة مزودة بطاقم ومعدات لتوفير رعاية طارئة للأشخاص الذين…)",
 "救急科": "الطَوَارِئ",
 "救急箱": "حقيبة إسعافات أولية (مجموعة تتكون من ضمادات وأدوية لتقديم الإسعافات الأولية)",
 "救急自動車": "سَيَّارَة إِسْعَاف (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "救急車": "سَيَّارَة إِسْعَاف (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "救急隊員": "مُسْعِف, مُسْعِفة",
 "救恤": "رَاحَة, تَخْفِيف",
 "救援": "رَاحَة, تَخْفِيف",
 "救援投手": "رامي الإغاثة, رامٍ بديل (رامٍ لا يبدأ المباراة بل يدخل كبديل)",
 "救援活動": "عملية إنقاذ (عملية منظمة للتحرير من الخطر أو الحبس)",
 "救援軍": "تعزيز, دعم (عملية عسكرية (غالباً ما تتضمن إمدادات جديدة من الرجال والعتاد) لتقوية قوة…)\nمثال: طلبوا دعماً مدفعياً",
 "救援隊": "فريق الإنقاذ (مجموعة من المنقذين)",
 "救済": "رَاحَة, تَخْفِيف / خَلَاص, تَطْهِير اَلنَّفْس",
 "救済者": "مُخَلِّص, مُنْقِذ (الشخص الذي يفي ولا يخون)\nمثال: الغيرة لا تجعل أحد مخلص",
 "救護": "رَاحَة, تَخْفِيف",
 "救護所": "محطة إسعافات أولية (محطة تقدم الرعاية الطارئة أو العلاج قبل التمكن من الحصول على المساعدة الطبية…)",
 "救護班": "فريق الإنقاذ (مجموعة من المنقذين)",
 "救貧法": "قانون الفقراء (قانون يوفر الدعم للفقراء)",
 "救貧院": "ملجأ الفقراء (مؤسسة تدار على نفقة الدولة لتوفير السكن للفقراء والمشردين)",
 "救難": "أَنْقَذَ, خَلَّصَ",
 "救難信号": "إشارة استغاثة, نداء استغاثة (إشارة معترف بها دولياً ترسلها سفينة أو طائرة تفيد بالحاجة إلى المساعدة)",
 "敗": "خَسَارَة, فِقْدَان",
 "敗る": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "敗れ": "خَسَارَة, فِقْدَان",
 "敗れる": "فَقَدَ\nمثال: خسر توم وظيفته.",
 "敗亡": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "敗余": "مَغْلُوب",
 "敗北": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "敗北主義": "انهزامية (قبول حتمية الهزيمة)",
 "敗北主義者": "انهزامي, سلبي (شخص يستسلم للهزيمة دون تقديم اقتراحات إيجابية)",
 "敗北者": "خَاسِر",
 "敗戦": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "敗戦者": "خَاسِر",
 "敗残": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "敗者": "خَاسِر",
 "敗者復活": "رِيمُونْتَادَا / جولة الفرصة الثانية, سباق الترضية (سباق (خاصة في التجديف) يتنافس فيه الخاسرون في التصفيات من أجل مكان في السباق…)",
 "敗者復活戦": "جولة الفرصة الثانية, سباق الترضية (سباق (خاصة في التجديف) يتنافس فيه الخاسرون في التصفيات من أجل مكان في السباق…)",
 "敗肉": "جِيفة, فَطِيسَة",
 "敗血症": "تَلَوُّث اَلْدَم (تَلَطُّخ، تَكَدُّر، قذارة ودنس يصيبان الجو أو الماء أو البيئة ويؤديان إلى تسمم…)\nمثال: التلوث يضر كوكبنا.",
 "敗血症性": "إنتاني, متقيح (يحتوي على كائنات مسببة للأمراض أو ناتج عنها)\nمثال: التهاب حلق إنتاني",
 "敗衄": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "敗走": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة)\nمثال: الطيران أسرع وسيلة سفر.",
 "敗軍": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "敗退": "حذف (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ…)",
 "教": "ـِيَّة",
 "教え": "تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على…)\nمثال: هو بارع في التعليم.",
 "教えさとす": "حَذَّرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك.",
 "教える": "عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه. / خَطَبَ, وَعَظَ (يُشير إلى من يُلقي خطبة أو يطلب الزواج، وجمعه خُطّاب. ويُضرب مثل \"ذهب خاطباً…)\nمثال: أخبرني ما الخطب.",
 "教え導く": "عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "教え諭す": "حَذَّرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه)\nمثال: قد بحذر من فضلك.",
 "教え魔": "متعالم, مدعي المعرفة (شخص يظن أنه يعرف كل شيء ويرفض قبول النصيحة أو المعلومات من الآخرين)",
 "教わる": "تَعَلَّمَ (اكتسب معرفة أو خبرة أو مهارة)\nمثال: هو سريع التعلم.",
 "教人": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "教会": "كَنِيسَة, كَنَائِس (محلّ العبادة عند المسيحيين؛ جماعة المؤمنين بدين المسيح)\nمثال: أين أقرب كنيسة ؟",
 "教会員": "مواظب على الكنيسة (شخص متدين يذهب إلى الكنيسة بانتظام)",
 "教会堂": "كَنِيسَة, كَنَائِس (محلّ العبادة عند المسيحيين؛ جماعة المؤمنين بدين المسيح)\nمثال: أين أقرب كنيسة ؟",
 "教会学校": "مدرسة أبرشية, مدرسة كنسية (مدرسة دينية خاصة تديرها كنيسة أو أبرشية)",
 "教会旋法": "مقام كنسي (أي من نظام المقامات المستخدمة في التراتيل الغريغورية حتى عام 1600؛ مشتق…)",
 "教会暦": "تقويم كنسي (تقويم للسنة المسيحية يشير إلى تواريخ الصيام والأعياد)",
 "教会法": "قانون كنسي (مجموعة القوانين المدونة التي تحكم شؤون الكنيسة المسيحية)",
 "教会管区": "أبرشية كبرى, مقاطعة كنسية (المنطقة الخاضعة لولاية رئيس أساقفة أو مطران أو أحد التقسيمات الإقليمية لنظام…)\nمثال: الولايات المتحدة مقسمة إلى 33 مقاطعة كنسية",
 "教会音楽": "موسيقى دينية, موسيقى كنسية (نوع من الموسيقى المؤلفة للأداء كجزء من الاحتفالات الدينية)",
 "教典": "أسفار مقدسة, كتاب مقدس (أي كتابة تعتبر مقدسة من قبل جماعة دينية)\nمثال: ذهب ليحمل كلمة الله (الإنجيل) إلى الوثنيين",
 "教則本": "كُتَيِّب, كُتَيِّب التَّشْغِيل (كِتَاب صَغِير؛ دَلِيل)",
 "教化": "تَعْلِيم, تَرْبِيَة (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على…)\nمثال: هو بارع في التعليم. / إِرْشَاد, هِدَايَة",
 "教区": "أبرشية",
 "教区学校": "مدرسة أبرشية, مدرسة كنسية (مدرسة دينية خاصة تديرها كنيسة أو أبرشية)",
 "教区民": "أبناء الرعية (عضو في رعية)",
 "教員": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "教唆": "إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة)) / تَحْرِيض",
 "教唆者": "مُحَرِّض, مُحَرِّضَة",
 "教場": "صَفّ, غُرْفَة التَّدْرِيس (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎.",
 "教壇": "مِنَصَّة",
 "教壇に立つ": "عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "教委": "مجلس التعليم, مجلس المدرسة (مجلس مسؤول عن المدارس العامة المحلية)",
 "教子": "ابن بالمعمودية, ابنة بالمعمودية (رضيع يكفله شخص بالغ (العراب) عند المعمودية)",
 "教官": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "教宣": "دِعَايَة, بْرُوبَاغَنْدَا",
 "教室": "صَفّ, غُرْفَة التَّدْرِيس (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎. / قِسْم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ…)\nمثال: أنا أزين القسم. / صِنْف, صَنْف\nمثال: اقرأ هذا الفصل. / مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح…)\nمثال: لا أحب المدرسة.",
 "教導": "تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على…)\nمثال: هو بارع في التعليم.",
 "教師": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "教師役": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "教徒": "مُؤْمِن, مُؤْمِنَة (هو الشخص الذي يُؤْمِنُ بالشيء ويصدقه؛ من دخل في قلبه الإِيْمَان، وهو يطلق على…)\nمثال: المؤمن لا يلدغ مرتين من جحر واحد.",
 "教戒": "إِرْشَاد, اسْتِشَارَة (شيء يوفر التوجيه أو المشورة بشأن قرار أو مسار عمل) / إِنْذَار, تَحْذِير (توبيخ حازم)",
 "教戒師": "قِسِّيس, قَسّ (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند…)",
 "教授": "أُسْتَاذ, مُعَلِّم (الْمُعَلِّمُ العَالِمُ بِمَا يُعَلِّمُ وَيُدَرِّسُ العارِف لَهُ؛ لقب علميّ…)\nمثال: الأستاذ على حق. / تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على…)\nمثال: هو بارع في التعليم.",
 "教授法": "مهنَة التدريس, تَعْلِيم",
 "教授陣": "كُلِّيَّة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: في أي كلية تدرس؟",
 "教旨": "مَذْهَب, عَقِيدَة (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب:…)\nمثال: الوجودية مذهب إنساني.",
 "教書": "رِسَالَة, خَبَر / ثَوْر (حُمْرَة الشفق الثائرة فيه؛ الطُحْلُب وما أشبهه فوق الماء. سميّ كذلك لأنه يثور…)\nمثال: حرث ما حرث الثور. / كِتَاب مَدْرَسِيّ, مَرْجِع (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة…)\nمثال: هذا الكتاب جديد",
 "教本": "كِتَاب مَدْرَسِيّ, مَرْجِع (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة…)\nمثال: هذا الكتاب جديد",
 "教条": "دوغما, عقيدة (عقيدة دينية تُعلن كحقيقة دون برهان)",
 "教条主義": "عَقِيدِيَّة, عَقَائِدِيَّة",
 "教母": "عَرَّابَة, إِشْبِينَة",
 "教法": "بيداغوجيا, طريقة تدريس (مبادئ وطرق التعليم)",
 "教派": "فِرْقَة\nمثال: الوجودية مذهب إنساني.",
 "教父": "عَرَّاب, إِشْبِين (عامل العَرَبَات؛ عند النصارى: كفيل الطفل المعتمد)\nمثال: العراب هو فيلمي المفضل. / أب الكنيسة ((في المسيحية) أي من حوالي 70 لاهوتياً في الفترة من القرن الثاني إلى السابع أسست…)",
 "教父学": "باترولوجيا, علم الآباء (دراسة حياة وكتابات ومذاهب آباء الكنيسة)",
 "教父母": "عراب المعمودية (شخص يكفل شخصاً (الطفل الروحي) عند المعمودية)",
 "教理": "مَذْهَب, عَقِيدَة (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب:…)\nمثال: الوجودية مذهب إنساني.",
 "教生": "طالب معلم (طالب جامعي يقوم بالتدريس تحت إشراف معلم معتمد للتأهل للحصول على درجة في التعليم)",
 "教皇": "بَابَا\nمثال: لا تكتب بالحبر.",
 "教皇の座": "اَلْكُرْسِيّ اَلرَّسُولِيّ",
 "教皇庁": "الكوريا, الكوريا الرومانية ((الكنيسة الرومانية الكاثوليكية) الإدارة المركزية التي تحكم الكنيسة الرومانية…)",
 "教皇領": "دَوْلَة الْكَنِيسَة, الدَّوْلَة الْبَابَوِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من…)\nمثال: لبنان دولة صغيرة.",
 "教示": "تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على…)\nمثال: هو بارع في التعليم.",
 "教祖": "مُعَلِّم رُوحِيّ, جُورُو (من يمتهن التعليم، مُدَرِّس)",
 "教科": "فَاعِل, مُبْتَدَأ (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "教科書": "كِتَاب مَدْرَسِيّ, مَرْجِع (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة…)\nمثال: هذا الكتاب جديد",
 "教科用図書": "كِتَاب مَدْرَسِيّ, مَرْجِع (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة…)\nمثال: هذا الكتاب جديد",
 "教程": "مَنْهَج, مَنْهَج دِرَاسِيّ",
 "教範": "بيداغوجيا, طريقة تدريس (مبادئ وطرق التعليم)",
 "教練": "ثَقَبَ, نَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود.",
 "教練教官": "مدرب عسكري, مدرب مشاة (ضابط صف يدرب المجندين على السير العسكري والانضباط)",
 "教義": "عَقِيدَة (المُعَاقِدَة، بمعنى اسم الفاعل؛ المعقودة، بمعنى اسم المفعول)",
 "教義学": "عَقَائِدِي",
 "教習": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة…)\nمثال: واصل زيري التدريب.",
 "教習所": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح…)\nمثال: لا أحب المدرسة. / مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "教習生": "مُتَدَرِّب, مُتَدَرِّبَة",
 "教習車": "مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "教者": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "教職員": "كُلِّيَّة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: في أي كلية تدرس؟",
 "教育": "تَعْلِيم, تَرْبِيَة (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على…)\nمثال: هو بارع في التعليم. / ثَقَافَة (بمعنى صار حَاذقا فطنا؛ المعرفة الواسعة والإطلاع على الكثير من المعلومات)\nمثال: توم لا يهتم بالثقافة.",
 "教育公務員特例法": "قانون خاص (قانون تشريعي ينطبق فقط على شخص معين أو منطقة معينة)",
 "教育制度": "نظام مدرسي (مؤسسة تشمل المنشآت والمعدات لتوفير التعليم من رياض الأطفال حتى المدرسة الثانوية)",
 "教育委員会": "مجلس التعليم, مجلس المدرسة (مجلس مسؤول عن المدارس العامة المحلية)",
 "教育学": "مهنَة التدريس, تَعْلِيم",
 "教育実習生": "طالب معلم (طالب جامعي يقوم بالتدريس تحت إشراف معلم معتمد للتأهل للحصول على درجة في التعليم)",
 "教育家": "مُعَلِّم, مُؤَدِّب (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "教育施設": "مُؤَسَّسَة تَعْلِيمِيَّة",
 "教育機関": "مُؤَسَّسَة تَعْلِيمِيَّة",
 "教育法": "بيداغوجيا, طريقة تدريس (مبادئ وطرق التعليم)",
 "教育現場": "صَفّ, غُرْفَة التَّدْرِيس (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎.",
 "教育的": "تَعْلِيمِيّ",
 "教育省": "وزارة التعليم (الإدارة الفيدرالية الأمريكية التي تدير جميع البرامج الفيدرالية المتعلقة…)",
 "教育者": "مُعَلِّم, مُؤَدِّب (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "教育課程": "مَنْهَج, مَنْهَج دِرَاسِيّ",
 "教訓": "دَرْس, حِصَّة ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: أراك بعد الدرس.",
 "教訓を垂れる": "مُحَاضَرَة",
 "教訓的": "إرشادي, تثقيفي (يخدم غرض التعليم أو التنوير أو الإعلام)",
 "教誡": "إِنْذَار, تَحْذِير (توبيخ حازم)",
 "教誨": "إِرْشَاد, اسْتِشَارَة (شيء يوفر التوجيه أو المشورة بشأن قرار أو مسار عمل)",
 "教誨師": "قِسِّيس, قَسّ (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند…)",
 "教諭": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "教護院": "إصلاحية, دار رعاية الأحداث (مؤسسة إصلاحية لاحتجاز وتأديب وتدريب الأحداث أو المجرمين لأول مرة)",
 "教鞭": "مُؤَشِّر",
 "教鞭をとる": "عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "教鞭を取る": "عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "教鞭を執る": "عَلَّمَ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
