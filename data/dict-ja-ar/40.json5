 "撓み": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "撓む": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / يَئِسَ, أُحْبِطَ",
 "撓める": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "撓やか": "مَرِن",
 "撓り": "ثني, حني (عملية ثني شيء ما)",
 "撓る": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "撓垂れる": "تدلي, ترهل (شكل يتدلى أو يهبط للأسفل)\nمثال: كان هناك هبوط في مقعد الكرسي",
 "撓曲": "انثناء, ثني (فعل ثني مفصل؛ خاصة المفصل بين عظام طرف بحيث تقل الزاوية بينهما)\nمثال: طية في المنديل",
