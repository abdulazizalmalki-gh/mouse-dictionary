 "方術": "طَرِيقَة, مِنْهَج / سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو…)\nمثال: هذا هو سحر الجزائر.",
 "方角": "اِتِّجَاه\nمثال: لا تنس إخراج القمامة. / رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة)\nمثال: وقف بوضعية جيدة / طَرِيقَة, مِنْهَج",
 "方解石": "كالسيت (معدن شائع يتكون من كربونات الكالسيوم المتبلورة؛ مكون رئيسي للحجر الجيري)",
 "方言": "لَهْجَة, الْعَامِّيَّة (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية.",
 "方言学": "عِلْم اللَّهْجَات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "方計": "خِطَّة, خُطَّة\nمثال: خطط زيري لهجومه.",
 "方途": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق.",
 "方達": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه.",
 "方針": "سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب…)\nمثال: عاد إلى السياسة. / إبرة مغناطيسية (مغناطيس رفيع معلق في بوصلة مغناطيسية على حامل باحتكاك قليل؛ يستخدم للإشارة إلى…)",
 "方鉛鉱": "غَالِينَا",
 "方錐": "هرم منتظم (هرم قاعدته مضلع منتظم وقمته تقع على العمود المقام على القاعدة من مركزها)",
 "方錐形": "هرم منتظم (هرم قاعدته مضلع منتظم وقمته تقع على العمود المقام على القاعدة من مركزها)",
 "方陣": "مربع سحري (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ)\nمثال: لا توجد مثلثات مربعة.",
 "方面": "اِتِّجَاه\nمثال: لا تنس إخراج القمامة. / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "方面隊": "جَيْش (الجُنْد السائرون لحرب أو غيرها. ويطلق أيضا على هؤلاء الجند وكل الهيئات التابعة…)\nمثال: هل كان في الجيش.",
 "方領": "مُرَبَّعُ الشَّكْلِ (على هيئة المربّع)",
 "於ける": "فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)",
 "施し": "مُنَظَّمَة خَيْرِيَّة",
 "施し物": "صَدَقَة, خَيْر",
 "施す": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / خِنْزِيرَة\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت.",
