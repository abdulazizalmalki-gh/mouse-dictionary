 "涕泣": "بُكَاء",
 "涙": "مَزَّقَ, شَقَّ (فَتَّ أو شَقَّ شيئًا إلى قطع صغيرة أو أجزاء؛ كسّر أو أفسد شيئًا بتشويهه أو تدميره) / خَرْق, شَقّ (شَقَّ الثوب والقماش وما أشبه) / دَمْع, دَمْعَة (فعل ثلاثي؛ سال دمعه) / دَمَعَ (فعل ثلاثي؛ سال دمعه)\nمثال: مزق سامي الرسالة. / تَعَاطُف / عَطْف (عِطْف: عُنُق، رَقبة؛ الجمع: أَعْطَافٌ، و عِطَافٌ، و عُطُوفٌ) / حُنُو",
 "涙ぐましい": "مُؤَثِّر / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي!",
 "涙する": "بَكَى, عَيَّط (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / صَاحَ (صاتَ بأقصى طاقته وأعلى صوته، يستخدم للحيّ ولا يقال صاح للجماد؛ عليه: ناداه) / بكاء\nمثال: بكى زيري كثيرا.",
 "涙ながら": "باكياً, والدموع في عينيه (مع الدموع؛ بطريقة دامعة)\nمثال: اعترف الرجل باكياً بضرب زوجته",
 "涙もろい": "بكّاء",
 "涙器": "جِهَاز دَمْعِيّ (الهياكل التي تفرز وتصرف الدموع من العين)",
 "涙嚢": "كيس دمعي (إحدى النهايتين المتسعتين للقنوات الدمعية عند النهايات الأنفية للعينين والتي تمتلئ بالدموع التي تفرزها الغدد الدمعية)",
 "涙嚢炎": "التهاب كيس الدمع (التهاب الكيس الدمعي يسبب انسداد الأنبوب الذي يصرف الدموع إلى الأنف)",
 "涙小管": "قناة دمعية (أي من عدة قنوات صغيرة تحمل الدموع من الغدد الدمعية)",
 "涙液": "بكاء, نحيب (عملية ذرف الدموع (عادة ما تكون مصحوبة بنشيج أو أصوات أخرى غير مفصلة))\nمثال: أكره سماع بكاء طفل",
 "涙脆い": "بكّاء",
 "涙腺": "غدة دمعية (أي من الغدد الموجودة في العين التي تفرز الدموع)",
 "涙腺動脈": "شريان دمعي (شريان ينشأ من الشريان العيني ويغذي الغدة الدمعية وعضلات العين المستقيمة والجفن العلوي والجبهة)",
 "涙骨": "عظم دمعي (عظم هش صغير يشكل جزءاً من الجدران الداخلية الأمامية لكل محجر عين ويوفر مساحة لمرور القنوات الدمعية)",
 "涜神": "تَجْدِيف",
 "涜職": "فَسَاد",
 "液": "سَائِل, مَائِع / عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟ / شُورَبَة (في : هي الحَسَاء) / شُرْبَة / حَسَاء\nمثال: هل مذاق الشوربة جيد؟ / صَلْصَة, مَرَق",
 "液だく": "رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق) / حَسَائِيّ (ذُو قِوَامٍ وَمَظْهَرٍ يُشْبِهُ الحَسَاء)",
 "液だめ": "حَوْض, جَابِيَة (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه) / فِنْطَاس\nمثال: ملأت الحوض ماءا.",
 "液体": "سَائِل, مَائِع",
 "液体につける": "رَمْيَة سَاحِقَة",
 "液体に浸ける": "رَمْيَة سَاحِقَة",
 "液体に浸す": "رَمْيَة سَاحِقَة",
 "液体に漬ける": "رَمْيَة سَاحِقَة",
 "液体化": "إسالة (تحويل مادة صلبة أو غازية إلى سائل)",
 "液体石鹸": "صابون سائل (صابون في شكل سائل)",
 "液体空気": "هواء سائل (الهواء في حالة سائلة)",
 "液体窒素": "نيتروجين سائل (نيتروجين في الحالة السائلة)",
 "液体酸素": "أكسجين سائل (سائل مغناطيسي أزرق شفاف يتم الحصول عليه بضغط الأكسجين الغازي وتبريده تحت نقطة غليانه)",
 "液化": "إسالة (تحويل مادة صلبة أو غازية إلى سائل)",
 "液化天然ガス": "غَاز طَبِيعِيّ مُسَال",
 "液化石油ガス": "غاز معبأ, غاز نفطي مسال (غازات هيدروكربونية، عادة البروبان أو البوتان، محفوظة تحت الضغط)",
 "液圧プレス": "مكبس هيدروليكي (مكبس تنتقل فيه القوة المطبقة بواسطة مكبس على مساحة صغيرة عبر الماء إلى مكبس آخر ذي مساحة كبيرة)",
 "液性": "سُيُولَة (توفر النقد أو سهولة التحويل إلى نقد؛ القدرة على سداد الديون) / سيولة (خاصية التدفق بسهولة) / حالة سائلة, سائل (الحالة التي تظهر فيها المادة استعداداً مميزاً للتدفق مع ميل ضئيل أو معدوم للتشتت وعدم قابلية للانضغاط عالية نسبياً)\nمثال: إضافة الرصاص تجعل السبيكة أسهل في السكب لأن درجة الانصهار تنخفض وتزداد السيولة / خلطي (متعلق بسوائل الجسم أو الأخلاط)",
 "液晶": "بلورة سائلة (سائل يظهر خصائص البلورة التي لا تظهرها السوائل العادية)",
 "液晶ディスプレイ": "إل سي دي, شاشة الكريستال السائل (شاشة رقمية تستخدم خلايا الكريستال السائل التي تغير الانعكاسية في مجال كهربائي مطبق؛ تستخدم لشاشات الكمبيوتر المحمولة والساعات وما إلى ذلك)",
 "液晶画面": "إل سي دي, شاشة الكريستال السائل (شاشة رقمية تستخدم خلايا الكريستال السائل التي تغير الانعكاسية في مجال كهربائي مطبق؛ تستخدم لشاشات الكمبيوتر المحمولة والساعات وما إلى ذلك)",
 "液晶表示装置": "إل سي دي, شاشة الكريستال السائل (شاشة رقمية تستخدم خلايا الكريستال السائل التي تغير الانعكاسية في مجال كهربائي مطبق؛ تستخدم لشاشات الكمبيوتر المحمولة والساعات وما إلى ذلك)",
 "液汁": "عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟",
 "液浸": "تغطيس, غمر (فعل تبليل شيء بغمره) / تغطيس (شكل من أشكال المعمودية يغمر فيه جزء أو كل جسم الشخص) / استغراق, انهماك (انتباه كامل؛ جهد عقلي مكثف) / احتجاب, دخول ((في علم الفلك) اختفاء جرم سماوي قبل الكسوف)",
 "液溜": "حَوْض, جَابِيَة (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه) / فِنْطَاس\nمثال: ملأت الحوض ماءا.",
 "液溜め": "حَوْض, جَابِيَة (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه) / فِنْطَاس\nمثال: ملأت الحوض ماءا.",
