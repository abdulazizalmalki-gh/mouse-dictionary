 "替え": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / اِسْتَبْدَلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ. / سعر الصرف (الرسم لتبادل عملة دولة بعملة دولة أخرى)",
 "替える": "اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ. / تَبْدِيل, تَبَادُل / اِسْتَبْدَلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "替え名": "اسم تجاري مستعار ((قانون) اسم تمارس به شركة أعمالها وليس الاسم القانوني للشركة كما هو مبين في…) / اسم فني (الاسم المستعار لممثل)",
 "替え歌": "مُحَاكَاة سَاخِرَة (تقليد أو محاولة إعادة عملية أو نظام موجود في الواقع بطريقة اصطناعية أو نموذجية)\nمثال: ويتم الآن طرح التساؤل التالي: هل يفهم الذكاء الصناعي اللغة الصينية حقيقة أم أنه يتم فقط محاكاة هذه المقدرة.",
 "替え玉": "احْتِياطِيّ, بَدِيل (شخص يأخذ مكان آخر (كما هو الحال عندما تصبح الأمور خطيرة أو صعبة))\nمثال: كان لدى النجم بديل للمشاهد الخطرة",
 "替り": "اِسْتَبْدَلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ. / احْتِياطِيّ, بَدِيل (شخص يأخذ مكان آخر (كما هو الحال عندما تصبح الأمور خطيرة أو صعبة))\nمثال: كان لدى النجم بديل للمشاهد الخطرة / تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / ثَانٍ, تاني\nمثال: لن أفعلها ثانية.",
 "替る": "نَجَحَ / مَثَّلَ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "替わり": "اِسْتَبْدَلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ. / احْتِياطِيّ, بَدِيل (شخص يأخذ مكان آخر (كما هو الحال عندما تصبح الأمور خطيرة أو صعبة))\nمثال: كان لدى النجم بديل للمشاهد الخطرة / تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / ثَانٍ, تاني\nمثال: لن أفعلها ثانية.",
 "替わる": "نَجَحَ / مَثَّلَ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "替名": "اسم تجاري مستعار ((قانون) اسم تمارس به شركة أعمالها وليس الاسم القانوني للشركة كما هو مبين في…) / اسم فني (الاسم المستعار لممثل)",
 "替歌": "مُحَاكَاة سَاخِرَة (تقليد أو محاولة إعادة عملية أو نظام موجود في الواقع بطريقة اصطناعية أو نموذجية)\nمثال: ويتم الآن طرح التساؤل التالي: هل يفهم الذكاء الصناعي اللغة الصينية حقيقة أم أنه يتم فقط محاكاة هذه المقدرة.",
 "替玉": "احْتِياطِيّ, بَدِيل (شخص يأخذ مكان آخر (كما هو الحال عندما تصبح الأمور خطيرة أو صعبة))\nمثال: كان لدى النجم بديل للمشاهد الخطرة",
 "最": "أَكْثَر, أَغْلَب\nمثال: إنها غالية جدا! / مُمْتَاز, فَاخِر",
 "最たる": "مُمْتَاز, فَاخِر",
 "最の高": "مَهِيب, مُذْهِل (يُلهم الرهبة أو الإعجاب أو الدهشة)",
 "最も": "أَكْثَر, أَغْلَب\nمثال: إنها غالية جدا!",
 "最上": "قِمَّة\nمثال: 最後に笑う者の笑いが最上。 — من يضحك أخيرًا يضحك كثيرًا. / أَفْضَل",
 "最上位ビット": "بنك ادخار متبادل (بنك ادخار مرخص من الدولة ومملوك للمودعين فيه ويديره مجلس أمناء)",
 "最上級": "دَرَجَة فَائِقَة",
 "最上級品": "عَالِي الجَوْدَة, مُمْتَاز (يتفوق في الجودة)",
 "最上級生": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر)\nمثال: ضابط كبير",
 "最下": "أَخِير, الأَدْنَى (الأدنى في الرتبة أو الأهمية)\nمثال: الغصن الذي يحمل الدراق الكبير تدلى إلى أدنى مستوى",
 "最中の月": "بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ…)",
 "最低": "أَقَلَّ / الأسوأ (لأقصى درجة من الرداءة أو السوء)\nمثال: عانت الأسوأ من بينهم جميعاً / فَظِيع, أَرْبَد",
 "最低最悪": "حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار)",
 "最低気温": "حَزين",
 "最低水準": "طَابِق أَرْضِيّ, دَوْر أَرْضِيّ",
 "最低賃金": "حد أدنى للأجور (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "最低賃金制": "حد أدنى للأجور (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "最低賃金法": "حد أدنى للأجور (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "最低限": "أدنى, حد أدنى (أقل ما يمكن)\nمثال: الحاجة لفرض معايير دنيا",
 "最低音部": "غيتار البيس",
 "最優秀": "أَفْضَل",
 "最優秀成績": "رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "最優秀選手": "أفضل لاعب, اللاعب الأكثر قيمة (اللاعب الذي يُحكم عليه بأنه الأكثر أهمية للرياضة أو الفريق)",
 "最優等": "بِأَعْلَى مَرَاتِب الشَّرَف, بِمَرْتَبَة الشَّرَف الأُولَى (بأعلى مراتب الشرف)\nمثال: تخرج بأعلى مراتب الشرف",
 "最先端": "نَصْل (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة…)\nمثال: لن نصل إلى أي مكان. / طَرَف",
 "最初": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة.",
 "最初から最後まで": "من البداية إلى النهاية (بشكل كامل وشامل)",
 "最初で最後": "أولاً وأخيراً, قبل كل شيء (بأخذ كل شيء معاً)\nمثال: كانت عالمة أولاً وأخيراً",
 "最前": "الأَمَامِيّ, الأَوَّل (يسبق جميع الآخرين في الموقع المكاني) / قَلِيلًا\nمثال: そのかわりに最前定義した二つの経済学的変数に関する議論を行うことにしよう。 — بدلًا من ذلك، سأنتقل إلى نقاش المتغيريَّن الاقتصادييَّن اللذين عرفتهما قبل قليل.",
 "最前戦": "جَبْهَة",
 "最前線": "خَطّ أَمَامِيّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "最北": "أَقْصَى الشَّمَال (يقع في أبعد نقطة شمالًا)",
 "最南": "أَقْصَى الجَنُوب (يقع في أبعد نقطة جنوبًا)",
 "最古": "أبكر وقت, في أقرب وقت (بأقل تأخير)\nمثال: أقرب وقت يمكنني الوصول فيه هو الساعة 3 مساءً",
 "最右": "أَقْصَى اليَمِين (الأبعد نحو اليمين)",
 "最右翼": "أَقْصَى اَليَمْيِنِ, الْيَمِين الْمُتَطَرِّف",
 "最善": "آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "最外側": "أَبْعَد, أَقْصَى (يقع في أبعد نقطة ممكنة عن المركز)",
 "最多": "أَكْثَر, أَغْلَب\nمثال: إنها غالية جدا!",
 "最多数": "أكثرية نسبية, تعددية ((في انتخابات بها أكثر من خيارين) عدد الأصوات للمرشح أو الحزب الذي يحصل على أكبر…)\nمثال: حشد من النمل",
 "最大": "أَرْقَى, فَائِق الجَوْدَة (الأعلى في مستوى الجودة)",
 "最大値": "أعظمي, أقصى (الأعظم أو الأكثر اكتمالاً أو الأفضل الممكن)",
 "最大公約数": "العَامِل المُشْتَرَك الأَكْبَر, القَاسِم المُشْتَرَك الأَكْبَر (أكبر عدد صحيح يقسم مجموعة من الأعداد الصحيحة بدون باقي)",
 "最大化": "إيصال للحد الأقصى, تعظيم (عملية الرفع إلى أعلى نقطة أو حالة أو موضع ممكن)",
 "最大数": "أعظمي, أقصى (الأعظم أو الأكثر اكتمالاً أو الأفضل الممكن)\nمثال: توسع أقصى",
 "最大有効ビット": "بنك ادخار متبادل (بنك ادخار مرخص من الدولة ومملوك للمودعين فيه ويديره مجلس أمناء)",
 "最大量": "أعظمي, أقصى (الأعظم أو الأكثر اكتمالاً أو الأفضل الممكن)\nمثال: توسع أقصى",
 "最大限": "أعظمي, أقصى (الأعظم أو الأكثر اكتمالاً أو الأفضل الممكن)\nمثال: توسع أقصى / بالكامل, تماماً (إلى أقصى درجة أو مدى؛ بشكل كامل أو كلي)\nمثال: نمى بالكامل",
 "最大限度": "أعظمي, أقصى (الأعظم أو الأكثر اكتمالاً أو الأفضل الممكن)\nمثال: توسع أقصى",
 "最安値": "تَارِيخِيّ, غَيْرُ مَسْبُوق (لم يُتجاوَز في جانب ما حتى الآن)",
 "最寄": "الأقرب ((صيغة التفضيل لـ قريب) ضمن أقصر مسافة)\nمثال: كان ذلك الوقت الذي اقترب فيه الأقرب إلى الموت",
 "最寄り": "الأقرب ((صيغة التفضيل لـ قريب) ضمن أقصر مسافة)\nمثال: كان ذلك الوقت الذي اقترب فيه الأقرب إلى الموت",
 "最密充填構造": "مُتَكَدِّس, مُتَلَاصِق (مرصوص بإحكام شديد)",
 "最小": "أَقَلَّ",
 "最小侵襲手術": "ذَات أَقَل تَدَخُّل جِرَاحِيّ, بِأَقَل تَدَخُّل جِرَاحِيّ",
 "最小値": "أدنى, حد أدنى (أقل ما يمكن)",
 "最小公倍数": "المضاعف المشترك الأصغر (أصغر مضاعف يقبل القسمة تمامًا على كل عضو في مجموعة من الأرقام)\nمثال: المضاعف المشترك الأصغر للعددين 12 و 18 هو 36",
 "最小公分母": "إل سي دي, شاشة الكريستال السائل (شاشة رقمية تستخدم خلايا الكريستال السائل التي تغير الانعكاسية في مجال كهربائي…)",
 "最小化": "تقليل للحد الأدنى (عملية تقليل شيء ما إلى أقل قدر أو درجة أو وضع ممكن)",
 "最小可知差異": "فارق ملحوظ بالكاد ((في الفيزياء النفسية) الفرق بين محفزين الذي يتم اكتشافه بنفس قدر عدم اكتشافه…)",
 "最小有効数字": "إل إس دي, ثنائي إيثيل أميد حمض الليسرجيك (عقار مهلوس قوي مصنع من حمض الليسرجيك)",
 "最小限": "أدنى, حد أدنى (أقل ما يمكن)\nمثال: الحاجة لفرض معايير دنيا",
 "最小限度": "أدنى, حد أدنى (أقل ما يمكن)\nمثال: الحاجة لفرض معايير دنيا",
 "最少": "أَقَلَّ",
 "最年長": "أَكْبَر, بِكْر (الأَوَّلُ فِي تَرْتِيبِ الوِلَادَةِ)",
 "最幸": "عَجِيب",
 "最後": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري. / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "最後っ屁": "قنبلة نتنة (قنبلة صغيرة مصممة لإطلاق رائحة كريهة عند انفجارها)",
 "最後の審判": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "最後の手段": "الملاذ الأخير, حل يائس (وسيلة لا يتم اللجوء إليها إلا عند اليأس)",
 "最後の晩餐": "الْعَشَاء الْأَخِير",
 "最後の舞台": "أغنية البجعة, العمل الأخير (أداء أو جهد أخير (خاصة قبل التقاعد))",
 "最後まで": "النِهاية",
 "最後尾": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري.",
 "最後屁": "قنبلة نتنة (قنبلة صغيرة مصممة لإطلاق رائحة كريهة عند انفجارها)",
 "最後方": "الأَبْعَد خَلْفًا, الأَخِير (يقع في أبعد نقطة نحو الخلف)",
 "最後通告": "بِلَاغ نِهَائِيّ",
 "最後通牒": "بِلَاغ نِهَائِيّ",
 "最悪": "الأسوأ (لأقصى درجة من الرداءة أو السوء)\nمثال: عانت الأسوأ من بينهم جميعاً / رَهِيب, فَظِيع",
 "最悪の事態": "الأسوأ (لأقصى درجة من الرداءة أو السوء)\nمثال: عانت الأسوأ من بينهم جميعاً",
 "最悪時": "في أسوأ الأحوال (في ظل أسوأ الظروف)\nمثال: في أسوأ الأحوال سنذهب إلى السجن",
 "最愛": "مَحْبُوب",
 "最新": "آخِرُ مَا صَدَرَ, أَحْدَث (مواكب للحاضر المباشر؛ الأكثر حداثة)\nمثال: هل سمعت آخر الأخبار؟",
 "最新性": "حالية, رواج (خاصية الانتماء إلى الوقت الحاضر)\nمثال: رواج مصطلح عامي",
 "最新情報": "تحديث (حَدَّث الشّخصُ:روى حديث الرّسول -صلّى الله عليه وسلّم-،حدّثه الشّخصُ:أخبره…)\nمثال: تم تحديث القاموس."
}
