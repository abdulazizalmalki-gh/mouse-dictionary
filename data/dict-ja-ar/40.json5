 "汰る": "هَزَّ",
 "汲々": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "汲み上げる": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "汲み入れる": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "汲み取り": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "汲み取り便所": "مِرْحَاض خَارِجِيّ",
 "汲み取り式便所": "مِرْحَاض, تواليت",
 "汲み取る": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "汲む": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / صَبَّ, سَكَبَ (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون)\nمثال: صب الشاي لضيفك. / اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين) / عَدَّ\nمثال: اعتبر نفسك محظوظا / وَرَثَ",
 "汲上げる": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "汲汲": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "決": "قَرَار, تَصْمِيم",
 "決して": "يَوْمًا",
 "決す": "قَرَّرَ, صَمَّمَ / قَرَّرَ",
 "決する": "قَرَّرَ, صَمَّمَ / قَرَّرَ / اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "決って": "دَائِمًا, أَبَدًا",
 "決まって": "دَائِمًا, أَبَدًا",
 "決まり": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون. / مُسْتَعْمَرَة, مُسْتَوْطَنَة / عَادَة / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "決まりが悪い": "مُحْرَج, بِٱلْحَرَج",
 "決まりきった": "ثَابِت, مُجَمَّد (لا يمكن تغييره أو تحريكه أو التراجع عنه) / ثَابِت ((عَنْ عَدَدٍ) لَهُ قِيمَةٌ ثَابِتَةٌ وَغَيْرُ مُتَغَيِّرَة) / ثابت, مثبت (موضوع أو مثبت بإحكام في مكانه) / ثَابِت, جَامِد (مثبّت في مكانه ولا يتحرك)\nمثال: قطعة خشب مثبتة",
 "決まりごと": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "決まり事": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "決まり切った": "ثَابِت, مُجَمَّد (لا يمكن تغييره أو تحريكه أو التراجع عنه) / ثَابِت ((عَنْ عَدَدٍ) لَهُ قِيمَةٌ ثَابِتَةٌ وَغَيْرُ مُتَغَيِّرَة) / ثابت, مثبت (موضوع أو مثبت بإحكام في مكانه) / ثَابِت, جَامِد (مثبّت في مكانه ولا يتحرك)\nمثال: قطعة خشب مثبتة",
 "決まり悪い": "مُحْرَج, بِٱلْحَرَج",
 "決まり手": "أداة برشمة, مُثبِّت (أداة تستخدم لثني (برشمة) المسامير أو البراغي أو المسامير البرشامية لتثبيتها) / عامل حاسم, قول فصل (نقطة أو حقيقة أو ملاحظة تحسم أمراً ما بشكل نهائي) / حجة حاسمة, عامل حاسم (حجة تكون قاطعة وفاصلة)",
 "決まり文句": "تعبير اصطلاحي, مصطلح (تعبير لا يمكن استنتاج معانيه من معاني الكلمات التي يتكون منها)",
 "決まる": "نَجَحَ",
 "決め": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "決めうち": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "決めこむ": "سلّم جدلا (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم. / اِدَّعَى / زَعَمَ / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب. / وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "決めつける": "اِمْرَأَة سَلِيطَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ) / وَبَّخَ (التأنيب بشدة)\nمثال: أنا امرأة قوية.",
 "決める": "قَرَّرَ, صَمَّمَ / قَرَّرَ / التحام ((ملاكمة) فعل أحد الملاكمين بالإمساك بالآخر لتجنب التعرض للضرب وللراحة لحظياً) / حضن, عناق (عناق قوي أو عاطفي) / مشبك, ملزمة (جهاز (يستخدمه النجارون عادة) يثبت الأشياء معاً بإحكام) / برشمة, طرف المسمار المثني (الجزء المسطح من مسمار أو برغي أو برشام)\nمثال: تعال هنا وأعطني حضنًا كبيرًا / سلّم جدلا (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم.",
 "決め付ける": "اِمْرَأَة سَلِيطَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ) / وَبَّخَ (التأنيب بشدة)\nمثال: أنا امرأة قوية.",
 "決め手": "عامل حاسم, قول فصل (نقطة أو حقيقة أو ملاحظة تحسم أمراً ما بشكل نهائي)",
 "決め打ち": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "決め込む": "سلّم جدلا (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم. / اِدَّعَى / زَعَمَ / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب. / وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "決り切った": "ثَابِت, مُجَمَّد (لا يمكن تغييره أو تحريكه أو التراجع عنه) / ثَابِت ((عَنْ عَدَدٍ) لَهُ قِيمَةٌ ثَابِتَةٌ وَغَيْرُ مُتَغَيِّرَة) / ثابت, مثبت (موضوع أو مثبت بإحكام في مكانه) / ثَابِت, جَامِد (مثبّت في مكانه ولا يتحرك)\nمثال: قطعة خشب مثبتة",
 "決り手": "أداة برشمة, مُثبِّت (أداة تستخدم لثني (برشمة) المسامير أو البراغي أو المسامير البرشامية لتثبيتها) / عامل حاسم, قول فصل (نقطة أو حقيقة أو ملاحظة تحسم أمراً ما بشكل نهائي) / حجة حاسمة, عامل حاسم (حجة تكون قاطعة وفاصلة)",
 "決り文句": "تعبير اصطلاحي, مصطلح (تعبير لا يمكن استنتاج معانيه من معاني الكلمات التي يتكون منها)",
 "決る": "نَجَحَ / تَجَوَّفَ / مِغْرَفَة / رَعَشَة / يرتعش / يهز",
 "決別": "تَفْرِقَة",
 "決勝": "أَخِير, نِهَائِيّ (لا يمكن تغييره أو التراجع عنه) / أَخِير, خِتَامِيّ (يَقَعُ فِي نِهَايَةِ شَيْءٍ أَوْ يُشَكِّلُ خَاتِمَتَهُ) / أَخِير, خِتَامِيّ (حاسم في عملية أو مسار تقدمي) / امتحان نهائي (امتحان يجرى في نهاية الفصل الدراسي)",
 "決勝戦": "أَخِير, نِهَائِيّ (لا يمكن تغييره أو التراجع عنه) / أَخِير, خِتَامِيّ (يَقَعُ فِي نِهَايَةِ شَيْءٍ أَوْ يُشَكِّلُ خَاتِمَتَهُ) / أَخِير, خِتَامِيّ (حاسم في عملية أو مسار تقدمي) / امتحان نهائي (امتحان يجرى في نهاية الفصل الدراسي)",
 "決勝点": "خط النهاية (خط يشير إلى موقع نهاية السباق)",
 "決勝線": "خط النهاية (خط يشير إلى موقع نهاية السباق)",
 "決壊": "انفجار (عملية الانفجار أو التفرقع) / فورة, نوبة (فورة مفاجئة من النشاط (غالباً لسبب غير واضح)) / رشقة, صلية (إطلاق نار سريع ومتزامن للأسلحة النارية) / اندلاع, انفجار (حدث مفاجئ ومكثف)\nمثال: انفجار الألعاب النارية أيقظ الأطفال",
 "決定": "قَرَار, تَصْمِيم",
 "決定づける": "قَرَّرَ, صَمَّمَ / قَرَّرَ",
 "決定力": "حَسْم, قَطْعِيَّة (صفة كون الشيء نهائياً أو محسوماً بشكل قاطع) / حسم, قاطع (سمة الحزم كما يتضح من صلابة الشخصية أو الغرض)\nمثال: نهائية الموت",
 "決定戦": "جولة الإعادة, الجولة الثانية",
 "決定投票": "صوت مرجح (التصويت الحاسم الذي يدلي به رئيس الجلسة لحل التعادل)",
 "決定的": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "決定表": "جدول القرار (جدول لجميع الاحتمالات والإجراءات التي يجب اتخاذها لكل منها)",
 "決定論": "حَتْمِيَّة",
 "決定論的": "حَتْمِيّ, قَطْعِيّ (نتيجة حتمية لأسباب سابقة كافية)",
 "決心": "عَزِيمَة",
 "決意": "قَرَار, تَصْمِيم",
 "決断": "قَرَار, تَصْمِيم",
 "決断力": "حَسْم, قَطْعِيَّة (صفة كون الشيء نهائياً أو محسوماً بشكل قاطع) / حسم, قاطع (سمة الحزم كما يتضح من صلابة الشخصية أو الغرض)\nمثال: نهائية الموت",
 "決済": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "決然": "حاسم, حاسمة",
 "決疑論": "إفتاء أخلاقي, دراسة الحالات الأخلاقية (فلسفة أخلاقية تقوم على تطبيق المبادئ الأخلاقية العامة لحل المعضلات الأخلاقية) / إفتاء سفسطائي, تلاعب بالألفاظ (مجادلة خادعة أو دقيقة بشكل مفرط وتهدف إلى التضليل)",
 "決着": "نَتِيجَة",
 "決着をつける": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "決着を付ける": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "決算": "تغطية, تقرير صحفي (الأخبار كما يقدمها المراسلون للصحف أو الإذاعة أو التلفزيون)\nمثال: اتهموا الصحيفة بتغطية متحيزة للعلاقات العرقية",
 "決算報告": "بَيَان مَالِيّ (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل)\nمثال: وأوضح البيان ذاته، أن الوزارة وجهت تعليمات من أجل تسخير كافة الإمكانيات البشرية والمادية للتسريع من وتيرة سير العملية.",
 "決算日": "نهاية العالم, هلاك (مصير غير سار أو كارثي) / يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)\nمثال: كان الجميع يدركون الهلاك القادم لكنهم كانوا عاجزين عن تجنبه",
 "決算書": "بَيَان مَالِيّ (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل)\nمثال: وأوضح البيان ذاته، أن الوزارة وجهت تعليمات من أجل تسخير كافة الإمكانيات البشرية والمادية للتسريع من وتيرة سير العملية.",
 "決算賞与": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "決行": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية",
 "決裁": "عِقَاب, إِسْتِحْسَان (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "決裂": "تَوَزُّع",
 "決議": "عَزْم, عُزْم / دِقَّة",
 "決議事項": "عَزْم, عُزْم / دِقَّة",
 "決議案": "عَزْم, عُزْم / دِقَّة",
 "決議権": "حق التصويت (الحق في التصويت؛ وخاصة حق المساهم العادي في التصويت شخصيًا أو بالوكالة في شؤون الشركة)",
 "決議機関": "اِجْتِمَاع حِزْبِيّ مُغْلَق, مُؤْتَمَر حِزْبِيّ (اجتماع سياسي مغلق)",
 "決起会": "تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب.",
 "決起大会": "تَجَمُّع تَشْجِيعِيّ (تجمع (خاصة للطلاب) قبل مباراة رياضية)",
 "決起集会": "تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب.",
 "決込む": "سلّم جدلا (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى)\nمثال: هم يريدون السلم. / اِدَّعَى / زَعَمَ / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب. / وَطَّنَ نَفْسَهُ عَلَى, عَزَمَ (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "決闘": "مُبَارَزَة",
 "決闘者": "مُبارز (شخص يخوض المبارزات)",
 "汽笛": "صافرة بخارية (صافرة يتم إنتاج الصوت فيها بواسطة البخار؛ عادة ما تكون متصلة بغلاية بخارية)",
 "汽缶": "غَلَّايَة",
 "汽罐": "غَلَّايَة",
 "汽船": "بَاخِرَة, سَفِينَة بُخَارِيَّة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار)\nمثال: الباخرة الآن في الميناء.",
 "汽艇": "أَطْلَقَ, قَذَفَ",
 "汽車": "قِطَار بُخَارِيّ / ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل.",
 "汽車ぽっぽ": "تُوت تُوت",
 "汽車ポッポ": "تُوت تُوت",
 "汽車賃": "أجرة القطار, تذكرة قطار (الأجرة المفروضة للسفر بالقطار)",
 "汽鑵": "غَلَّايَة",
 "沁みる": "اِبْتَلَّ / لَسَعَ",
 "沃る": "صَبَّ, سَكَبَ (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون)\nمثال: صب الشاي لضيفك.",
 "沃化カリウム": "يوديد البوتاسيوم (ملح بلوري يُستخدم في التخليق العضوي وصنع المستحلبات الفوتوغرافية وفي ملح الطعام المعالج باليود)",
 "沃化水素": "يوديد الهيدروجين (غاز عديم اللون ينتج حمض الهيدرويوديك في المحلول المائي)",
 "沃化物": "يوديد (ملح أو إستر لحمض الهيدرويوديك)",
 "沃化銀": "يوديد الفضة (يوديد يُستخدم في التصوير الفوتوغرافي، وفي استمطار السحب، وفي الطب)",
 "沃地": "وَاحَة, غُوطَة (بقعة خضراء في الصحراء أو في أرض قاحلة، وأصبحت كذلك بسبب وجود مصدر ماء بقربها)",
 "沃素": "يُود",
 "沃素一三一": "يود-131 (نظير مشع ثقيل لليود له عمر نصف 8 أيام؛ يستخدم في ملح الصوديوم لتشخيص أمراض الغدة الدرقية ولعلاج تضخم الغدة الدرقية)",
 "沃素一二五": "يود-125 (نظير مشع خفيف لليود له عمر نصف 60 يوماً؛ يستخدم كمتتبع في دراسات الغدة الدرقية وكعلاج لفرط نشاط الغدة الدرقية)",
 "沃素酸": "حمض اليوديك (حمض بلوري قابل للذوبان؛ يستخدم ككاشف ومطهر)",
 "沈々": "صَامِت, سَاكِت / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / ثَاقِب, حَادّ (لَدَيْهِ القُدْرَةُ عَلَى التَّمْيِيزِ الدَّقِيقِ وَالإِدْرَاكِ العَمِيق)",
 "沈み込む": "غَطَسَ / مَجْلَى, مَغْسَلَة",
 "沈む": "غَطَسَ / مَجْلَى, مَغْسَلَة / نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف.",
 "沈め": "غَرَق / كرة هابطة (رمية تنحني للأسفل بسرعة عند اقترابها من اللوحة) / ثقالة (وزن يغرق (لتثبيت الشباك أو خيوط الصيد تحت الماء)) / دونات, كعكة مقلية (كعكة مقلية صغيرة على شكل حلقة)",
 "沈める": "غَطَسَ / مَجْلَى, مَغْسَلَة / أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى. / أَرْضِيَّة, أَرْض (ما يقابل السَقْف من الغرفة؛ قاع الشيء) / طَابِق\nمثال: انهارت الأرضية.",
 "沈んだ心": "اعتلال المزاج, انقباض (حالة من الاكتئاب الخفيف)",
 "沈下": "غَرَق",
 "沈吟": "هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل .",
 "沈子": "وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه.",
 "沈床園": "حديقة غائرة (حديقة تقع تحت مستوى الأرض المحيطة بها)",
 "沈思": "تَفَكُّر",
 "沈殿": "تَسَاقُط, هُطُول / تَرَسُّب / عجلة",
 "沈殿剤": "مُتَرَسِّع, مُتَعَجِّل (يتمّ بعجلة شديدة وبدون تَرَوٍّ كافٍ) / مادة مرسبة, مرسب (عامل يسبب تشكل راسب)",
 "沈殿物": "رَاسِب",
 "沈沈": "صَامِت, سَاكِت / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / ثَاقِب, حَادّ (لَدَيْهِ القُدْرَةُ عَلَى التَّمْيِيزِ الدَّقِيقِ وَالإِدْرَاكِ العَمِيق)",
 "沈没": "غَرَق",
 "沈泥": "غَرِين",
 "沈渣": "رَاسِب",
 "沈滞": "رُكُود / ركود اقتصادي",
 "沈潜": "تَفَكُّر",
 "沈澱": "تَسَاقُط, هُطُول / تَرَسُّب / عجلة",
 "沈澱物": "رَاسِب",
 "沈痛": "قَبْر, ضَرِيح (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: زار توم قبر ماري.",
 "沈着": "اتزان, رباطة جأش (ثبات العقل تحت الضغط)\nمثال: تقبل مشاكلهم برباطة جأش وهي باتزان / وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "沈砂": "إقدام, عزيمة (الثبات والتصميم) / جريت, حجر رملي خشن (حجر رملي سيليسي خشن الحبيبات صلب)\nمثال: لم يكن لديه الجرأة لتجربتها",
 "沈積": "ترسب, ترسيب (ظاهرة تراكم الرواسب أو الحصى)",
 "沈積岩": "صَخْر رُسُوبِيّ",
 "沈積物": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "沈降": "ترسب, ترسيب (ظاهرة تراكم الرواسب أو الحصى) / انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته) / ترسب, ترييح (غوص تدريجي إلى مستوى أدنى) / انحسار, هجوع (انخفاض في الشدة أو الدرجة (كما في أعراض المرض))\nمثال: سرطانه في حالة هجوع",
 "沈静": "سكون, هدوء تام ((شعرياً) صمت وسكون مطمئن) / انعدام الحركة, جمود (حالة عدم وجود حركة) / انعدام الرياح, سكون (هدوء بدون رياح)\nمثال: سكون الليل",
 "沈香": "عُود, رَنْد (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "沈鬱": "سَوْدَاوِيَّة",
 "沈黙": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ! / تحفظ, تكتم (سمة قلة التواصل؛ عدم التطوع بأي شيء أكثر من الضروري)",
 "沈黙は金雄弁は銀": "إِنْ كَانَ الْكَلَامُ مِنْ فِضَّةٍ فَالسُّكُوتُ مِنْ ذَهَبٍ (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "沈黙寡言": "قليل الكلام, كتوم (متحفظ عادة وغير متحدث)",
 "沐する": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "沐浴": "استحمام, اغتسال (فعل غسل النفس (أو شخص آخر)) / استجمام, اغتسال (غمر الجسم في الماء أو تعريضه للشمس بغرض الاستجمام) / وُضُوء, غُسْل / وَضُوء",
 "沐猴": "سَعْدَان, قِرْد",
 "沓底": "وَحِيد / عَزْب / أَخْمُص, بَاطِن القَدَم / نَعْل / سَمَك مُوسَى (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "沓脱ぎ石": "حجر أساس, نقطة انطلاق (أي وسيلة للتقدم) / حَجَرُ عُبُور (حجر في مستنقع أو مياه ضحلة يمكن الوقوف عليه للعبور)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء",
