 "新竹": "شِينْجُو, شِينْتْشُو",
 "新篇": "طبعة جديدة (منشور (مثل كتاب) تم تعديله أو تحديثه وعرضه للبيع مرة أخرى)",
 "新築祝い": "حفل تدشين المنزل, حفل نزالة (حفلة يجتمع فيها الناس للاحتفال بالانتقال إلى منزل جديد)",
 "新米": "مبتدئ, مستجد (شخص جديد في مجال أو نشاط ما)",
 "新約": "اَلْعَهْد اَلْجَدِيد",
 "新約全書": "اَلْعَهْد اَلْجَدِيد",
 "新約聖書": "اَلْعَهْد اَلْجَدِيد",
 "新編": "طبعة جديدة (منشور (مثل كتاب) تم تعديله أو تحديثه وعرضه للبيع مرة أخرى)",
 "新聞": "جَرِيدَة",
 "新聞売り": "بائع صحف (صبي يوزع الصحف)",
 "新聞売店": "كُشْك صُحُف (هو الكِشْك في بعض اللهجات العربية؛ شبه رِوَاق بارز عن مساواة بقية البيت)",
 "新聞広告": "إِعْلَان صُحُفِيّ (إعلان مطبوع ينشر في صحيفة)",
 "新聞発表": "بَيَان صَحَفِيّ (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء…)\nمثال: وأوضح البيان ذاته، أن الوزارة وجهت تعليمات من أجل تسخير كافة الإمكانيات البشرية والمادية للتسريع من وتيرة سير العملية.",
 "新聞紙": "ورق جرائد (ورق رخيص مصنوع من لب الخشب ويستخدم لطباعة الصحف)\nمثال: استخدموا رزمًا من ورق الجرائد كل يوم / جَرِيدَة",
 "新聞紙上": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "新聞配達": "نَاقِل\nمثال: يبدو أنني حامل.",
 "新自由主義": "نِيُولِيبِرَالِيَّة",
 "新自由主義者": "نِيُولِيبْرَالِيّ (يُؤْمِنُ بِضَرُورَةِ النُّمُوِّ الِاقْتِصَادِيِّ إِضَافَةً إِلَى الأَهْدَافِ…)",
 "新興": "اِنْتِفَاضَة, تَمَرُّد (معارضة منظمة للسلطة؛ صراع يحاول فيه فصيل انتزاع السيطرة من آخر)",
 "新興国": "دَوْلَة نَامِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من…)\nمثال: لبنان دولة صغيرة.",
 "新興都市": "مدينة مزدهرة (بلدة تتمتع بازدهار مفاجئ)",
 "新芽": "نَبْتَة",
 "新藤": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "新装": "تجديد, ترميم (حالة الاستعادة إلى الحالة الجيدة السابقة)\nمثال: كان النزل تجديداً لمنزل استعماري",
 "新規": "جَدِيد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد",
 "新規住宅着工件数": "بدء الإسكان, بدء البناء (فعل البدء في بناء منزل)",
 "新規性": "حلي رخيصة, حلية مبهرجة (مجوهرات رخيصة ومبهرجة أو زينة على الملابس)",
 "新規株式公開": "اكتتاب عام أولي, طرح أولي (أول عرض للشركة لبيع الأسهم للجمهور)",
 "新設": "إنشاء, ابتداء (فعل بدء شيء ما لأول مرة؛ تقديم شيء جديد)\nمثال: تطلعت إلى بدايتها كشخص بالغ",
 "新設合併": "تكامل, توحيد (عملية الدمج في كلٍ متكامل)\nمثال: دمج شركتين",
 "新語": "مُوَلَّدَة",
 "新調": "ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود)\nمثال: ابتكار الخطط",
 "新谷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "新造": "بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء. / زَوْجَة, اِمْرَأَة",
 "新造語": "مُوَلَّدَة",
 "新進": "اِنْتِفَاضَة, تَمَرُّد (معارضة منظمة للسلطة؛ صراع يحاول فيه فصيل انتزاع السيطرة من آخر)",
 "新進気鋭": "مُجْتَهِد, نَشِيط (يعمل بجدّ لتعزيز مشروع أو مؤسّسة)",
 "新道": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "新郎": "عَرِيس (اِسْمٌ لِمَاْوَى الأَسَد)",
 "新里": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "新鋭": "مُجْتَهِد, نَشِيط (يعمل بجدّ لتعزيز مشروع أو مؤسّسة)",
 "新開": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "新開地": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "新陳代謝": "تَجْدِيد / أَيْض ( تَحَوُّل غذائيّ في الخلايا، أو قوّة التجدُّد والبناء والهدم في الكائن الحيّ)",
 "新面目": "مظهر جديد, نيو لوك (نمط من الملابس النسائية ابتكره كريستيان ديور عام 1947؛ تضمن صدراً ضيقاً وخصراً…)",
 "新顔": "قادم جديد, مستجد (أي مشارك جديد في نشاط ما)\nمثال: هو وافد جديد إلى بوسطن",
 "新館": "توسعة, جناح (إضافة توسع المبنى الرئيسي)",
 "新香": "مُخَلَّل",
 "新馬": "حولي (حيوان في سنته الثانية) / فوطة صحية (وسادة ماصة تستخدم لمرة واحدة؛ تُرتدى لامتصاص تدفق الدورة الشهرية) / حصان بديل (حصان جديد خاصة (سابقاً) ليحل محل حصان قُتل أو أصيب في المعركة)",
 "新鮮": "طَازَج, طَازَة",
 "新鮮味": "جِدَّة, طَرَافَة (الأصالة بحكم كون الشيء جديداً ومنعشاً)\nمثال: أحبت طزاجة الخبز المخبوز حديثاً",
 "方": "اِتِّجَاه\nمثال: لا تنس إخراج القمامة. / أُقْنُوم / جَانِب / اِتِّجَاه\nمثال: لا تنس إخراج القمامة. / جَانِب / نَوْع, نَمَط (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر. / حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل. / أُسْتَاذ, سَيِّد (الْمُعَلِّمُ العَالِمُ بِمَا يُعَلِّمُ وَيُدَرِّسُ العارِف لَهُ؛ لقب علميّ…)\nمثال: الأستاذ على حق. / حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار. / قُرْب, جِوَار (أَدْنَى؛ قدَّرَ)\nمثال: جلست بالقرب منها. / سَاحِل, شَاطِئ",
 "方々": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / هُنَا وَهُنَاكَ\nمثال: 観光名所をほうぼう訪ね歩いたので、すっかり疲れ果ててしまった。 — زيارة جميع المعالم السياحية حقاً ترهقني كثيراً .",
 "方がた": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "方がつく": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها…)\nمثال: استقر زيري في خيمته.",
 "方が付く": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها…)\nمثال: استقر زيري في خيمته.",
 "方たち": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه.",
 "方を付ける": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها…)\nمثال: استقر زيري في خيمته.",
 "方今": "الْآنَ, حَالًا (في هذا الوقت الحالي)\nمثال: نحن بمأمن الآن.",
 "方伯": "لاندغريف (كونت كان له ولاية قضائية على منطقة كبيرة في ألمانيا في العصور الوسطى)",
 "方位": "رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة)\nمثال: وقف بوضعية جيدة",
