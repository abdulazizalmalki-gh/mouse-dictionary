 "液量": "مقياس سائل, وحدة سائلة (وحدة سعة للسوائل (لقياس أحجام السوائل أو حاوياتها))",
 "液量オンス": "أونصة سائلة (وحدة أمريكية للسعة أو الحجم تساوي 1.804 بوصة مكعبة) / أونصة سائلة (وحدة إمبراطورية بريطانية للسعة أو الحجم (سائلة أو جافة) تساوي 8 دراهم سائلة)",
 "液量計": "مقياس سائل, وحدة سائلة (وحدة سعة للسوائل (لقياس أحجام السوائل أو حاوياتها))",
 "涵養": "تَهْذِيب",
 "涸らす": "اِسْتَهْلَكَ, اِسْتَنْفَدَ",
 "涸れる": "نَفِدَ",
 "涸れ川": "مُسْتَنْزَف الْمَاء, نَاضِب (نضب ماؤه واستُنزف) / ذَابِل, يَابِس ((يُوصف به النبات خاصّةً) فَقَد كلّ رطوبته وذبل)",
 "涸れ涸れ": "مُحَمَّص (مُحَمَّصٌ أَوْ مَشْوِيٌّ قَلِيلًا) / مُحْتَرِق, يَابِس مِنَ الحَرّ (جفّ بفعل الحرارة أو التعرّض المفرط لأشعّة الشمس)",
 "涸沢": "مُسْتَنْزَف الْمَاء, نَاضِب (نضب ماؤه واستُنزف) / ذَابِل, يَابِس ((يُوصف به النبات خاصّةً) فَقَد كلّ رطوبته وذبل)",
 "涼しい": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا. / شَفَّاف / وَاضِح / رابط الجأش, رزين (يتمتع بضبط النفس والهدوء وخلو من الاضطراب خاصة في أوقات التوتر)\nمثال: بدت المؤدية رابطة الجأش تماماً وهي تصعد إلى المسرح / صَافٍ, اَلصَّافِي",
 "涼しげ": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا. / شَفَّاف / وَاضِح / رابط الجأش, رزين (يتمتع بضبط النفس والهدوء وخلو من الاضطراب خاصة في أوقات التوتر)\nمثال: بدت المؤدية رابطة الجأش تماماً وهي تصعد إلى المسرح",
 "涼しさ": "برود, جفاء (نقص في المودة أو الحماس) / برود الأعصاب, هدوء الأعصاب (تمالك النفس بجرأة في مواجهة الخطر) / برودة خفيفة, نسمة باردة (خاصية أن يكون الشيء بارداً بشكل معتدل) / برود, رباطة جأش (ثقة بالنفس هادئة وغير مضطربة)\nمثال: برود مؤلم في النبرة والأسلوب",
 "涼やか": "مُنْعِش",
 "涼亭": "جوسق, شرفة حديقة (مبنى صغير مسقوف يوفر الظل والراحة)",
 "涼味": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا.",
 "淀": "رُكُود / ركود اقتصادي / تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / مُتَرَدِّد, مُتَلَعْثِم (غير ثابت في الكلام أو الفعل)\nمثال: كان هناك تردد في كلامه / بِرْكَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها)\nمثال: البركة عميقة جدا.",
 "淀み": "رُكُود / ركود اقتصادي / تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / مُتَرَدِّد, مُتَلَعْثِم (غير ثابت في الكلام أو الفعل)\nمثال: كان هناك تردد في كلامه",
 "淀みない": "طَلِق, فَصِيح (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ)\nمثال: طلق زيري زوجته.",
 "淀みなく": "بِطَلَاقَة, لِبْلِب",
 "淀み無い": "طَلِق, فَصِيح (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ)\nمثال: طلق زيري زوجته.",
 "淀む": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته. / تَرَدَّدَ (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "淋しい": "وَحِيد, مُوحِش / مُقْفِر, مَهْجُور / حَزِين, زعلان / مُحْزِنٌ / غَائِب, مَفْقُود (غير موجود أو مفتقد)",
 "淋毒": "سيلان (مرض تناسلي شائع تسببه بكتيريا النيسرية البنية؛ الأعراض هي تبول مؤلم وألم حول مجرى البول)",
 "淋漓": "بغزارة, بوفرة (بطريقة وفيرة)\nمثال: تم تزويدهم بالطعام بوفرة / طَافِح, مَمْلُوء حَتَّى الحَافَة (مَمْلُوء إِلَى أَقْصَى حَدّ)",
 "淋疾": "سَيَلَان",
 "淋病": "سَيَلَان",
 "淋菌": "مكورة بنية, نيسرية بنية (البكتيريا المنتجة للقيح التي تسبب السيلان)",
 "淑やか": "رَشِيق, ظَرِيف",
 "淑女": "رَبَّة, رَبَّةْ اَلْبَيْت / خَاتُون, سَيِّدَة / لِيدِي / مُنْحَرِف, مُنْحَرِفَة",
 "淑女風": "أُنْثَوِيُّ الطِّبَاعِ (يليق بامرأة حسنة التربية)",
 "淘る": "هَزَّ",
 "淘汰": "حذف (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ؛ حَذَفَهُ بِالعَصَا: ضَرَبَهُ ، ورَمَاهُ بِها)\nمثال: حذف ياني حسابه. / اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "淘汰作用": "اختيار, انتقاء (فعل الاختيار أو الانتقاء) / اختيار, خيار (الشخص أو الشيء الذي تم اختياره أو انتقاؤه) / مختارات, مقتبس (مقطع مختار من عمل أكبر) / تشكيلة مختارة, خيار (مجموعة متنوعة من الأشياء التي يمكن الاختيار منها)\nمثال: كان اختيارك للألوان غير موفق",
 "淙々": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / تذمر, تمتمة (شكوى يتم التلفظ بها بنبرة منخفضة وغير واضحة) / تمتمة, غمغمة (صوت منخفض مستمر غير واضح؛ غالباً ما يكون مصحوباً بحركة الشفاه دون إنتاج كلام واضح)",
 "淙淙": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / تذمر, تمتمة (شكوى يتم التلفظ بها بنبرة منخفضة وغير واضحة) / تمتمة, غمغمة (صوت منخفض مستمر غير واضح؛ غالباً ما يكون مصحوباً بحركة الشفاه دون إنتاج كلام واضح)",
 "淡々": "غَيْرُ مُكْتَرِث, غَيْرُ مُهْتَمّ (لا يبالي ولا يهتم بالمعرفة) / غير مهتم, لا مبالٍ (ليس لديه أو لا يظهر اهتماماً)\nمثال: متفرج غير مهتم / بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / باستخفاف, ببساطة (بلا مبالاة أو بدون اكتئاب) / باعتدال, بخفة (الانغماس باعتدال) / بشكل طفيف, خفيفاً (إلى درجة طفيفة) / بخفة, برفق (بقليل من الوزن أو القوة)\nمثال: أخذ الأمر باستخفاف",
 "淡い": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور. / إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "淡す": "غَيْر لَامِع, مَطْفِيّ (لَا يَعْكِس الضَّوْء؛ غَيْر بَرَّاق) / انطفاء, عدم اللمعان (خاصية وجود تباين ضئيل أو معدوم؛ الافتقار إلى الإبرازات الضوئية أو اللمعان) / خليط كبريتيدي خام, مات (خليط من الكبريتيدات يتشكل عند صهر خامات المعادن الكبريتيدية)",
 "淡口": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور.",
 "淡彩画": "رسم بالغسل, غسل (لوحة مائية مصنوعة من خلال تطبيق سلسلة من الغسلات أحادية اللون واحدة فوق الأخرى)",
 "淡水": "مَاء عَذْب (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "淡水化": "تَقْطِير, إِعْذَاب",
 "淡水産": "ماء عذب (ماء غير مالح)",
 "淡水魚": "سمك مياه عذبة (لحم السمك من المياه العذبة المستخدم كطعام)",
 "淡泊": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور. / إِفْرَنْجِيّ",
 "淡淡": "غَيْرُ مُكْتَرِث, غَيْرُ مُهْتَمّ (لا يبالي ولا يهتم بالمعرفة) / غير مهتم, لا مبالٍ (ليس لديه أو لا يظهر اهتماماً)\nمثال: متفرج غير مهتم / بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / باستخفاف, ببساطة (بلا مبالاة أو بدون اكتئاب) / باعتدال, بخفة (الانغماس باعتدال) / بشكل طفيف, خفيفاً (إلى درجة طفيفة) / بخفة, برفق (بقليل من الوزن أو القوة)\nمثال: أخذ الأمر باستخفاف",
 "淡然": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "淡白": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور. / إِفْرَنْجِيّ",
 "淡紅": "وَرْدِيّ, زَهْرِيّ (هُو ما كان بِلَوْنِ الورد؛ ٌ إِلَىٰ ٱلْوَرْدِ) / زَهْرِيّ, وَرْدِيّ\nمثال: لا أظن أن توم سيشتري مظلة وردية.",
 "淡紅色": "وَرْدِيّ, زَهْرِيّ (هُو ما كان بِلَوْنِ الورد؛ ٌ إِلَىٰ ٱلْوَرْدِ) / زَهْرِيّ, وَرْدِيّ\nمثال: لا أظن أن توم سيشتري مظلة وردية.",
 "淡紫色": "لَيْلَك / لَيْلَكِيّ",
 "淡褐色": "بني فاتح (بني فاتح ولكنه غير مشبع)",
 "淡青": "سَمَاوِيّ, لَبَنِيّ",
 "淡青色": "سَمَاوِيّ, لَبَنِيّ",
 "淡黄": "أصفر شاحب, تِبنِي (صبغة صفراء متغيرة؛ أصفر باهت، غالباً ما يكون مخففاً بالأبيض)",
 "淡黄緑色": "فُسْتُق, فُسْتُق حَلَبِيّ",
 "淡黄色": "أصفر شاحب, تِبنِي (صبغة صفراء متغيرة؛ أصفر باهت، غالباً ما يكون مخففاً بالأبيض)",
 "淦": "ماء الآسن (الماء المتجمع في قاع السفينة)",
 "淦取り": "يُوكَاتَا",
 "淦水": "ماء الآسن (الماء المتجمع في قاع السفينة)",
 "淪落": "خَرَاب, خَرَابَة / دَمَّرَ",
 "淫": "انحلال, فجور (انغماس منحل في الملذات الحسية) / إباحية, خلاعة (صفة الفسق والمجون)",
 "淫ら": "فَاحِش, قَذِر",
 "淫乱": "فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف)",
 "淫佚": "فُجُور (اسم فاعل من الفعل \"فَجَرَ\"؛ مصدر من الفعل \"فَجَرَ\") / إِغْوَاء / فُسُوق",
 "淫具": "لعبة جنسية (جسم أو جهاز يستخدم بشكل أساسي لتسهيل المتعة الجنسية البشرية)",
 "淫口": "كِس, كُس (الشيءَ: دقّه دقَّا شديدا أو ضغطه أو دعكه)",
 "淫唇": "شَفْر ((شَفَّرَتِ) الشَّمْسُ: دنَت للغُرُوبِ؛ (شَفَّرَتِ) المالُ: قَلَّ وذهب)",
 "淫売": "بِغَاءٌ, دَعَارَة",
 "淫売婦": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "淫売宿": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "淫売屋": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "淫奔": "شَبَق",
 "淫女": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "淫婦": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "淫欲": "رغبة جنسية, شهوة (رغبة في الحميمية الجنسية)",
 "淫気": "شَهْوَة",
 "淫猥": "بذاءة, فاحشة (فعل فاحش) / بذاءة, فحش (سمة التصرف بطريقة فاحشة) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة)",
 "淫羊かく": "عشبة العقر, قبعة الأسقف (نبات زاحف بطيء النمو بأوراق شبه دائمة الخضرة على سيقان سلكية منتصبة؛ يستخدم كغطاء أرضي)",
 "淫羊藿": "عشبة العقر, قبعة الأسقف (نبات زاحف بطيء النمو بأوراق شبه دائمة الخضرة على سيقان سلكية منتصبة؛ يستخدم كغطاء أرضي)",
 "淫蕩": "فُجُور (اسم فاعل من الفعل \"فَجَرَ\"؛ مصدر من الفعل \"فَجَرَ\") / إِغْوَاء / فُسُوق",
 "淫行": "بذاءة, فاحشة (فعل فاحش) / بذاءة, فحش (سمة التصرف بطريقة فاحشة) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة)",
 "淫裂": "فَرْج, حِرّ",
 "淫賣": "بِغَاءٌ, دَعَارَة",
 "淫賣婦": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "淫逸": "فُجُور (اسم فاعل من الفعل \"فَجَرَ\"؛ مصدر من الفعل \"فَجَرَ\") / إِغْوَاء / فُسُوق",
 "淫靡": "فَاحِش, قَذِر",
 "淫風": "شر, فجور (سلوك مرفوض أخلاقياً) / انحلال أخلاقي, فجور (صفة عدم التوافق مع معايير السلوك القويم أو الجيد)\nمثال: لا أخلاقية تأسيس دفاع الغرب على التهديد بالدمار المتبادل المؤكد",
 "淫魔": "جَاثُوم, كَابُوس / كابوس, حلم / باروك",
 "深々": "صَامِت, سَاكِت / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / ثَاقِب, حَادّ (لَدَيْهِ القُدْرَةُ عَلَى التَّمْيِيزِ الدَّقِيقِ وَالإِدْرَاكِ العَمِيق)",
 "深い": "عَمِيق, غَوِيط / سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ) / عَمِيقٌ مِنَ الأَعْمَاق (نَابِعٌ مِنْ أَعْمَاقِ النَّفْس) / بَالِغُ العُمْق, عَمِيقٌ جِدًّا (مِنْ أَشَدِّ دَرَجَاتِ الحِدَّةِ؛ تَامّ) / كَثِيف, غَلِيظ / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "深い愛情": "تَفَرُّغ",
 "深く": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً) / بِعُمْق (إلى عمق كبير؛ بعيداً للأسفل أو للداخل)\nمثال: شعروا بالخسارة بعمق",
 "深さ": "عَمْق",
 "深ぞり": "فوز بشق الأنفس, نجاة بأعجوبة (شيء تم تحقيقه (أو الهروب منه) بفارق ضئيل)",
 "深まる": "تَعَمَّقَ",
 "深み": "أعماق, أغوار ((الجمع) الجزء الأعمق والأكثر بعداً)\nمثال: من أعماق أفريقيا المظلمة / عَمْق",
 "深める": "تَعَمَّقَ",
 "深セン": "شِينْتْشِين, شِينْجِين",
 "深傷": "جرح قطعي, شرط (قطع كاسح قوي يتم بأداة حادة) / شق, قطع (خندق يشبه الأخدود ناتج عن التعرية أو الحفر) / جرح قطعي, قطع (جرح ناتج عن القطع)\nمثال: وضع ضمادة على الجرح",
 "深冷処理": "تَحْتَ الصِّفْر (أَقَلَّ)\nمثال: أنا تحت الشجرة.",
 "深刻": "جِدِّيّ / جَدِّيّ, جَادّ",
 "深刻化": "استفحال, تفاقم (إجراء يجعل المشكلة أو المرض (أو أعراضه) أسوأ) / إغاظة, استفزاز (سلوك غير ودي يسبب الغضب أو الاستياء) / تفاقم, حنق (شعور ساخط بالانزعاج)\nمثال: نتج تفاقم حالتها عن نقص الرعاية",
 "深剃り": "فوز بشق الأنفس, نجاة بأعجوبة (شيء تم تحقيقه (أو الهروب منه) بفارق ضئيل)",
 "深化": "تعميق (عملية أن يصبح الشيء أعمق وأكثر عمقاً)",
 "深厚": "سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ) / عَمِيقٌ مِنَ الأَعْمَاق (نَابِعٌ مِنْ أَعْمَاقِ النَّفْس) / بَالِغُ العُمْق, عَمِيقٌ جِدًّا (مِنْ أَشَدِّ دَرَجَاتِ الحِدَّةِ؛ تَامّ)",
 "深圳": "شِينْتْشِين, شِينْجِين",
 "深奥": "أعماق, أغوار ((الجمع) الجزء الأعمق والأكثر بعداً)\nمثال: من أعماق أفريقيا المظلمة / سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ) / عَمِيقٌ مِنَ الأَعْمَاق (نَابِعٌ مِنْ أَعْمَاقِ النَّفْس) / بَالِغُ العُمْق, عَمِيقٌ جِدًّا (مِنْ أَشَدِّ دَرَجَاتِ الحِدَّةِ؛ تَامّ)",
 "深宇宙": "فضاء سحيق, فضاء عميق (أي منطقة في الفضاء خارج النظام الشمسي)",
 "深層": "أعماق, أغوار ((الجمع) الجزء الأعمق والأكثر بعداً)\nمثال: من أعماق أفريقيا المظلمة",
 "深層崩壊": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "深層心理": "عقل لاواعي, لاوعي (ذلك الجزء من العقل الذي يحدث فيه النشاط النفسي الذي لا يدركه الشخص)",
 "深層心理学": "تحليل نفسي, علم نفس الأعماق (مجموعة من التقنيات لاستكشاف الدوافع الكامنة وطريقة لعلاج الاضطرابات العقلية المختلفة؛ تستند إلى نظريات سيغموند فرويد)\nمثال: أوصى طبيبه بالتحليل النفسي",
 "深層水": "مشكلة عويصة, مياه عميقة (مشكلة خطيرة)",
 "深山": "جَبَل (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين) / طُور\nمثال: منزلي في الجبل.",
 "深山烏": "غُدَاف / قَلْعَة, رُخّ (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "深山秋の麒麟草": "قَسْطَرَان",
 "深山金梅": "زخرفة خماسية الفصوص (نحت زخرفي يتكون من خمسة أقواس مرتبة في دائرة) / حشيشة الخمس ورقات, عشبة القوى (أي من النباتات العديدة التي تزرع لزهورها خماسية البتلات؛ وفيرة في المناطق المعتدلة؛ ويزعم أن لها خصائص طبية)",
 "深山金鳳花": "حوذان المروج, حوذان طويل (حوذان أوروبي معمر ذو أزهار ربيعية صفراء، متوطن بشكل واسع خاصة في شرق أمريكا الشمالية)",
 "深山鴉": "غُدَاف / قَلْعَة, رُخّ (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "深山鸚鵡": "كيا (ببغاء نيوزيلندي كبير بني مخضر)",
 "深度": "عَمْق",
 "深慮": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / تفكير, روية (سمة التفكير بعناية قبل التصرف) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / تأمل, تفكر (تفكير هادئ ومطول ومركّز)\nمثال: لم يظهر أي مراعاة لمشاعرها",
 "深成岩": "باثوليت, صخر بلوتوني (كتلة كبيرة من الصخور النارية المتطفلة يعتقد أنها تصلبت في أعماق الأرض)",
 "深手": "جرح قطعي, شرط (قطع كاسح قوي يتم بأداة حادة) / شق, قطع (خندق يشبه الأخدود ناتج عن التعرية أو الحفر) / جرح قطعي, قطع (جرح ناتج عن القطع)\nمثال: وضع ضمادة على الجرح",
 "深更": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "深沈": "هَادِئ / طَمْأَنَ / بدون كلام, بصمت (بدون التحدث)\nمثال: جلس بصمت بجوارها",
 "深浅": "عَمْق",
 "深浅測量": "قِيَاس الْأَعْمَاق, مِعْمَاقِيَّة",
 "深海帯": "المنطقة السحيقة, نطاق الأعماق (أعماق البحر (2000 متر أو أكثر) حيث لا يوجد ضوء)",
 "深海漁業": "أَعْمَاقِيّ بَحْرِيّ (يتعلق بـأو يحدث في الأجزاء العميقة من البحر)",
 "深海魚": "أَعْمَاقِيّ بَحْرِيّ (يتعلق بـأو يحدث في الأجزاء العميقة من البحر)",
 "深深": "صَامِت, سَاكِت / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / ثَاقِب, حَادّ (لَدَيْهِ القُدْرَةُ عَلَى التَّمْيِيزِ الدَّقِيقِ وَالإِدْرَاكِ العَمِيق)",
 "深淵": "هَاوِيَة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة) / هَاوِيَة, هُوَّة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة)\nمثال: وصل سامي إلى قاع الهاوية ماليا.",
 "深潭": "هَاوِيَة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة) / هَاوِيَة, هُوَّة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة)\nمثال: وصل سامي إلى قاع الهاوية ماليا.",
 "深爪": "غَائِر, مُنْخَفِض (ذو منطقة غائرة أو منخفضة عن السطح)",
 "深甚": "سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ) / عَمِيقٌ مِنَ الأَعْمَاق (نَابِعٌ مِنْ أَعْمَاقِ النَّفْس) / بَالِغُ العُمْق, عَمِيقٌ جِدًّا (مِنْ أَشَدِّ دَرَجَاتِ الحِدَّةِ؛ تَامّ)",
 "深甚なる": "سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ) / عَمِيقٌ مِنَ الأَعْمَاق (نَابِعٌ مِنْ أَعْمَاقِ النَّفْس) / بَالِغُ العُمْق, عَمِيقٌ جِدًّا (مِنْ أَشَدِّ دَرَجَاتِ الحِدَّةِ؛ تَامّ)",
 "深皿": "سلطانية حساء كبيرة, طاسية (طبق تقديم عميق وكبير بغطاء؛ لتقديم الحساء واليخنات)",
 "深紅色": "سِقِلَّاتِيّ, قِرْمِزِيّ / سِقِلَّاط, سِقِلَّات",
 "深蒼": "كحلي",
 "深謀": "اِئْتَمَرَ",
 "深遠": "سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ) / عَمِيقٌ مِنَ الأَعْمَاق (نَابِعٌ مِنْ أَعْمَاقِ النَّفْس) / بَالِغُ العُمْق, عَمِيقٌ جِدًّا (مِنْ أَشَدِّ دَرَجَاتِ الحِدَّةِ؛ تَامّ)",
 "深部": "أعماق, أغوار ((الجمع) الجزء الأعمق والأكثر بعداً)\nمثال: من أعماق أفريقيا المظلمة",
 "深重": "سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ) / عَمِيقٌ مِنَ الأَعْمَاق (نَابِعٌ مِنْ أَعْمَاقِ النَّفْس) / بَالِغُ العُمْق, عَمِيقٌ جِدًّا (مِنْ أَشَدِّ دَرَجَاتِ الحِدَّةِ؛ تَامّ)",
 "深鍋": "قدر مرق (وعاء يستخدم لإعداد مرق الحساء)",
 "深長": "سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ) / عَمِيقٌ مِنَ الأَعْمَاق (نَابِعٌ مِنْ أَعْمَاقِ النَّفْس) / بَالِغُ العُمْق, عَمِيقٌ جِدًّا (مِنْ أَشَدِّ دَرَجَاتِ الحِدَّةِ؛ تَامّ)",
 "深閑": "صَامِت, سَاكِت",
 "深間": "أعماق, أغوار ((الجمع) الجزء الأعمق والأكثر بعداً)\nمثال: من أعماق أفريقيا المظلمة",
 "深雪": "ثَلْج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / تلج / ثلج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / أَثْلَجَ (أثلج يومُنا: دخل في الثلج؛ أثلجت الأرض: أصابها الثلج)\nمثال: سامي يحب الثلج.",
 "深青": "كحلي",
 "淳良": "بَرِيء, بَرِيئَة / بَرِيء",
 "淵": "مشكلة عويصة, مياه عميقة (مشكلة خطيرة) / أعماق, أغوار ((الجمع) الجزء الأعمق والأكثر بعداً)\nمثال: من أعماق أفريقيا المظلمة",
 "淵叢": "مَرْكَز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "淵底": "هَاوِيَة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة) / هَاوِيَة, هُوَّة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة)\nمثال: وصل سامي إلى قاع الهاوية ماليا. / أعماق, أغوار ((الجمع) الجزء الأعمق والأكثر بعداً)\nمثال: من أعماق أفريقيا المظلمة / تَمَامًا",
 "淵源": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل",
 "淵藪": "مَرْكَز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "混": "اِحْتِقَان",
 "混ざり合う": "خَلَط (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "混ざり物": "شوائب, عدم نقاء (حالة كونه غير نقي) / خبث, شائب (مادة عديمة القيمة أو خطرة يجب إزالتها)\nمثال: كانت هناك شوائب في الماء",
 "混じりけ": "خَلِيط",
 "混じりっけ": "خَلِيط",
 "混じりっ気": "خَلِيط",
 "混じり合う": "خَلَط (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "混じり気": "خَلِيط",
 "混じり物": "خَلِيط",
 "混じる": "فَائِدَة",
 "混ず": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "混ぜこぜ": "خليط, مزيج غير متجانس (نظرية أو حجة مكونة من أفكار متنوعة أو غير متناغمة) / كعكة جامبل (كعكة أو بسكويت صغير مسطح على شكل حلقة) / خليط, ركام (مجموعة مشوشة من الأشياء)",
 "混ぜっ返す": "قَاطَعَ",
 "混ぜる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "混ぜ合せる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "混ぜ合わす": "توليف, مزج (عملية مزج المكونات معاً بدقة) / كلمة منحوتة, نحت (كلمة جديدة تتشكل من خلال ضم كلمتين أخريين والجمع بين معانيهما) / امتزاج, تمازج (حدوث خلط شامل)\nمثال: 'الزمكان' هي نحت من 'الزمان' و 'المكان'",
 "混ぜ合わせる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "混ぜ物": "خَلِيط",
 "混ぜ返す": "قَاطَعَ",
 "混み混み": "مُزْدَحِم",
 "混一色": "تَبَايُن الخَوَاصّ, عَدَم تَجَانُس (صفة التنوع وعدم القابلية للمقارنة في النوع)",
 "混乱": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب",
 "混交": "خَلِيط / تَلْوِيث, تَلَوُّث",
 "混信": "تشويش, تشويش إلكتروني (إشعاع أو عكس متعمد للطاقة الكهرومغناطيسية لغرض تعطيل استخدام العدو للأجهزة أو الأنظمة الإلكترونية)",
 "混入": "خلط, خليط (عملية خلط الأشياء معاً)\nمثال: عجينة مصنوعة من خليط الدقيق والماء",
 "混分数": "عَدَد مُرَكَّب الْوَحَدَات, كَمِّيَّة مُرَكَّبَة (كمية يُعَبَّر عنها بوحدتين مختلفتين)\nمثال: كمية مركبة مثل 'ساعة وعشر دقائق'",
 "混合": "خلط, خليط (عملية خلط الأشياء معاً)\nمثال: عجينة مصنوعة من خليط الدقيق والماء / تَمَازُج الأَجْنَاسِ",
 "混合体": "خَلِيط",
