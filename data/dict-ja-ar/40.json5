 "曠々": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)\nمثال: إنتاج القمح في ظل ظروف واسعة النطاق",
 "曠世": "فَرِيدٌ مِنْ نَوْعِه, لَا يُضَاهَى (مُتميّز جذريًّا وليس له مثيل أو نظير)",
 "曠劫": "أيون, دهر ((الغنوصية) قوة إلهية أو طبيعة تنبثق من الكائن الأسمى وتلعب أدواراً مختلفة في…)\nمثال: أوه، لقد حدث ذلك منذ دهر",
 "曠古": "تَارِيخِيّ (مهمّ في التاريخ؛ ذو أثر تاريخيّ)",
 "曠曠": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)\nمثال: إنتاج القمح في ظل ظروف واسعة النطاق",
 "曠然": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)\nمثال: إنتاج القمح في ظل ظروف واسعة النطاق",
 "曰う": "قَالَ, قال (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "曰く": "ذَرِيعَة, عُذْر",
 "曰くありげ": "ذُو مَعْنًى (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "曰ふ": "قَالَ, قال (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "曲": "مُؤَلَّف, مُصَنَّف / لَحْن (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن. / مُتْعَة, مِتْعَة / شر, فجور (سلوك مرفوض أخلاقياً)\nمثال: فاجأتنا بشاعة لغته / مُخْطِئ\nمثال: نحن نرفض الظلم.",
 "曲々": "تدوير, ملء (عملية التدوير أو اللف)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "曲がった": "مُجَعَّد, مُنْبَعِج (عن المعدن مثلاً؛ مُحنٍ أو مُنبعِج)\nمثال: كان لديه ميل لذلك / عَلَى نَحْو خَاطِئ, مُنْحَرِفًا (بعيداً عن المسار الصحيح أو المتوقع)\nمثال: شيء ما انحرف في خططنا",
 "曲がない": "رَتِيب, عَادِيّ (غير مُلهِم ولا يُشكِّل تحدياً؛ باهت وخالٍ من الإثارة) / انطوائي, غير اجتماعي (لا يميل إلى المجتمع أو الرفقة)\nمثال: طبيعة غير اجتماعية؛ خجول ومتحفظ",
 "曲がり": "انحناء",
 "曲がりくねる": "بشكل متعرج (في مسار متعرج أو على طريق متعرج)\nمثال: طارت الطيور بشكل متعرج عبر السماء الزرقاء",
 "曲がりなりにも": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "曲がり家": "مرهن",
 "曲がり尺": "زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية)",
 "曲がり屋": "مرهن",
 "曲がり目": "زَاوِيَة, رُكْن",
 "曲がり角": "زَاوِيَة, رُكْن / نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "曲がり金": "زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية)",
 "曲がる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع…)\nمثال: إذهب إلى الدار.",
 "曲げ": "انثناء, ثني (فعل ثني مفصل؛ خاصة المفصل بين عظام طرف بحيث تقل الزاوية بينهما)\nمثال: طية في المنديل",
 "曲げる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)\nمثال: 少年は考えを曲げなかった。 — لم يغير الولد رأيه. / مَالَ (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل…)\nمثال: أريد بعض المال. / ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث)\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "曲げ易い": "طَيِّع, قَابِلٌ لِلثَّنْي (يُمْكِنُ ثَنْيُهُ أَوْ لَيُّهُ دُونَ أَنْ يَنْكَسِرَ)",
 "曲げ物屋": "مرهن",
 "曲のない": "مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "曲の無い": "مُمِلّ المُؤَسَّسَاتِيَّة (يتَّسم بطابع المؤسَّسة خاصَّة في الرتابة والجمود)\nمثال: رواية غير مثيرة للاهتمام للغاية عن رحلتها",
 "曲り": "انحناء",
 "曲りくねる": "بشكل متعرج (في مسار متعرج أو على طريق متعرج)\nمثال: طارت الطيور بشكل متعرج عبر السماء الزرقاء",
 "曲り家": "مرهن",
 "曲り尺": "زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية)",
 "曲り屋": "مرهن",
 "曲り目": "زَاوِيَة, رُكْن",
 "曲り角": "زَاوِيَة, رُكْن / نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "曲り金": "زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية)",
 "曲る": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع…)\nمثال: إذهب إلى الدار.",
 "曲事": "شر, فجور (سلوك مرفوض أخلاقياً)\nمثال: فاجأتنا بشاعة لغته / زَوَر, عِوَج (زَوَّرَ الطائرُ: أَكَلَ حتى امتلأَت حوصَلتُه وارتفعت؛ زَوَّرَ الشىءَ: أَصلَحَه…)",
 "曲作り": "تأليف موسيقي, عمل موسيقي (عمل موسيقي تم إبداعه)\nمثال: التأليف مكتوب في أربع حركات",
 "曲射": "نيران بزاوية عالية (نيران من مدفع يتم إطلاقها بارتفاع أكبر من الارتفاع الأقصى للمدى)",
 "曲射砲": "مورتر, هاون (مدفع يلقم من الفوهة ذو سبطانة قصيرة يطلق القذائف بزوايا مرتفعة لمدى قصير)",
 "曲尺": "زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية)",
 "曲庇": "مَرْفَأ, مَرْسَى",
 "曲度": "انحناء",
 "曲彔": "مُحْدَوْدِب, مُنْحَنِي الظَّهْر (ذو ظهر وكتفَين مُنحنيَين؛ غير منتصب)",
 "曲悪": "شر, فجور (سلوك مرفوض أخلاقياً)\nمثال: فاجأتنا بشاعة لغته",
 "曲想": "تيمة, موضوع موسيقي ((موسيقى) الموضوع اللحني لتكوين موسيقي)\nمثال: تم الإعلان عن الموضوع في المقاييس الأولى",
 "曲技": "حركة بهلوانية (حيلة أو حركة يؤديها لاعب بهلوان)",
 "曲技飛行": "ألعاب بهلوانية جوية, استعراض جوي (أداء حركات بهلوانية أثناء الطيران بطائرة)",
 "曲折": "ثني, حني (عملية ثني شيء ما) / تَعْقِيد",
 "曲曲": "تدوير, ملء (عملية التدوير أو اللف)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "曲椂": "مُحْدَوْدِب, مُنْحَنِي الظَّهْر (ذو ظهر وكتفَين مُنحنيَين؛ غير منتصب)",
 "曲物屋": "مرهن",
 "曲独楽": "قِمَّة",
 "曲率": "انحناء",
 "曲球": "رمية متغيرة السرعة (كرة بيسبول ترمى بسرعة قليلة عندما يتوقع الضارب كرة سريعة)",
 "曲用": "إِعْرَاب, صَرْف (في هو)",
 "曲目": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟ / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ)\nمثال: نشط البرنامج الآن.",
 "曲直": "جَدَارَة",
 "曲禄": "مُحْدَوْدِب, مُنْحَنِي الظَّهْر (ذو ظهر وكتفَين مُنحنيَين؛ غير منتصب)",
 "曲筆": "تحريف, تزييف (تحريف متعمد للحقائق)",
 "曲管": "سِيفُون",
 "曲節": "لَحْن (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن.",
 "曲線": "منحنى",
 "曲線美": "امتلاء الجسم, تناسق القوام (صفة امتلاك جسم ممتلئ وجذاب)",
 "曲者": "بلطجي, فتوة (رجل قاسٍ ووحشي) / خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه)\nمثال: درب على يد خبير. / جني, عفريت ((فلكلور) مخلوق خارق صغير بشع يسبب المشاكل للبشر)",
 "曲芸": "بِهْلَوَانِيَّات",
 "曲芸師": "بَهْلَوَان",
 "曲解": "سوء تفسير, سوء فهم (وضع تفسير خاطئ لشيء ما)\nمثال: تسبب سوء تفسيره للسؤال في خطئه",
 "曲調": "لَحْن, أُغْنِيَّة (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن.",
 "曲論": "سفسطة (حجة غير صحيحة عمدًا تظهر البراعة في التفكير على أمل خداع شخص ما)",
 "曲譜": "إِصَابَة (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى)\nمثال: تعرض زيري لإصابة.",
 "曲輪": "مِنْطَقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة. / إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "曲録": "مُحْدَوْدِب, مُنْحَنِي الظَّهْر (ذو ظهر وكتفَين مُنحنيَين؛ غير منتصب)",
 "曲集": "مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "曳々": "رمي ثقيل, قذف بجهد (رمي شيء ثقيل (بجهد كبير))\nمثال: أعطاها دفعة قوية",
 "曳き綱": "حبل الشد ((مصطلح بحري) حبل يستخدم لتمديد أو تثبيت التجهيزات على السفن)",
 "曳き網": "شبكة",
 "曳き船": "زَوْرَق اَلْقَطْر / سحب, قطر (فعل سحب شيء (مثل مركبة) بواسطة حبل أو مشبك)\nمثال: سحبته الشاحنة إلى المرآب",
 "曳光弾": "طلقة تتبع, طلقة كاشفة (ذخيرة يمكن ملاحظة مسارها من خلال أثر دخاني)",
 "曳曳": "رمي ثقيل, قذف بجهد (رمي شيء ثقيل (بجهد كبير))\nمثال: أعطاها دفعة قوية",
 "曳火": "انفجار جوي (انفجار في الغلاف الجوي)",
 "曳火弾": "فتيل التوقيت (فتيل مصنوع ليحترق لفترة زمنية محددة (خاصة لتفجير قنبلة))",
 "曳痕弾": "طلقة تتبع, طلقة كاشفة (ذخيرة يمكن ملاحظة مسارها من خلال أثر دخاني)",
 "曳網": "شبكة",
 "曳航": "سحب, قطر (فعل سحب شيء (مثل مركبة) بواسطة حبل أو مشبك)\nمثال: سحبته الشاحنة إلى المرآب",
 "曳船": "زَوْرَق اَلْقَطْر / سحب, قطر (فعل سحب شيء (مثل مركبة) بواسطة حبل أو مشبك)\nمثال: سحبته الشاحنة إلى المرآب",
 "更": "بالتناوب (في تسلسل أو وضع متناوب)\nمثال: زرع أشجار التنوب والصنوبر بالتناوب / خُمْس (جزء واحد من خمسة أجزاء متساوية) / جَدِيد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد / بَدِيهِيّ, بَدَهِيّ",
 "更々": "أبداً",
 "更ける": "يقرب",
 "更なり": "طَبْعًا",
 "更なる": "أَبْعَد, أَقْصَى (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني.",
 "更に": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك",
 "更にもっと": "وأكثر من ذلك (وأكثر بكثير بالإضافة إلى ذلك)\nمثال: كلفني راتب أسبوع وأكثر من ذلك",
 "更代": "تَبْدِيل, تَبَادُل",
 "更問": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق)\nمثال: برنامجه الجديد هو متابعة للبرامج التي بدؤوا بها",
 "更問い": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق)\nمثال: برنامجه الجديد هو متابعة للبرامج التي بدؤوا بها",
 "更始": "تَجْدِيد",
 "更始一新": "قَلَبَ",
 "更年期": "إِيَاس",
 "更改": "تَجْدِيد",
 "更新": "تَجْدِيد",
 "更更": "أبداً",
 "更正": "تَصْحِيح",
 "更湯": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "更生": "إِعَادَةُ تَأْهِيل / اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / رجوع, عودة (حدوث تغيير في الاتجاه للرجوع في الاتجاه المعاكس)",
 "更生保護": "إِعَادَةُ تَأْهِيل",
 "更生期": "انقطاع الطمث, سن اليأس (الوقت في حياة المرأة الذي تنتهي فيه الدورة الشهرية)",
 "更科升麻": "بق باني, طارد البق ((بَقَّ) الرجل بقا: أَكثر القَوْل فِي صَوَاب أَو خطأ؛ (بَقَّ) الْمَرْأَة: كثر…)\nمثال: قد غزا بق الفراش فرنسا.",
 "更科蕎麦": "تفوق, جودة عالية (جودة كون الشيء متفوقاً)",
 "更衣": "تَجْدِيد, إِحْيَاء / فِبْرَايِر, شُبَاط (الشهر الثاني في السنة الميلادية الروميّة)\nمثال: سأكون قد درست الإنجليزية لخمس سنوات مع حلول فبراير المقبل.",
 "更衣場": "غُرْفَة الْمَلَابِس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة.",
 "更衣室": "غرفة الخزائن, غرفة تبديل الملابس (غرفة (كما في منشأة رياضية أو مكان عمل) يمكنك فيها تغيير الملابس وتحتوي على…)",
 "更衣所": "غُرْفَة الْمَلَابِس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة.",
 "更訂": "تَنْقِيح",
 "更迭": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "書": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء. / كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة…)\nمثال: هذا الكتاب جديد / تَعَلُّم (اكتسب معرفة أو خبرة أو مهارة)\nمثال: هو سريع التعلم. / كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة…)\nمثال: هذا الكتاب جديد / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
 "書いた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "書きあげる": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "書きおくる": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "書きかけ": "غير مكتمل, غير منتهٍ (لم يتم الانتهاء منه أو اختتامه)\nمثال: أعمال غير منتهية",
 "書きかた": "الخط, فن الخط (الكتابة اليدوية الجميلة) / تنسيق, شكل (المظهر العام لمنشور)",
 "書きことば": "كلمة مكتوبة (الشكل المكتوب للكلمة)\nمثال: بينما الكلمة المنطوقة ترمز لشيء ما، فإن الكلمة المكتوبة ترمز لشيء يرمز لشيء ما",
 "書きこむ": "مَلَأَ / خَزَنَ (حفظ، إدخر، أودع في مخزن) / كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "書きしるす": "تَسْجِيل, مُدَوَّنَة\nمثال: سجل سامي وصوله.",
 "書きだし": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة. / لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه…)\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "書きだす": "مُقْتَطَف / صَادِرَات (جمع اسم فاعل من صَدَرَ؛ اللواتي يَصْدُرْن؛ البضائع الوطنية تُرسَل إلى بلاد أخرى…)\nمثال: صادرات الجزائر في تزايد.",
 "書きとめる": "تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟",
 "書きなぐる": "خربشة",
 "書きまちがい": "تهجئة خاطئة, خطأ إملائي (تهجئة غير صحيحة)",
 "書きもの": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما)\nمثال: تعبت من الكتابة.",
 "書きもの机": "طاولة كتابة, مكتب (مكتب للكتابة (عادة بسطح مائل))",
 "書き上げる": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "書き下ろす": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "書き人": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد…)\nمثال: لست بذاك الكاتب.",
 "書き付け": "وَرَق, قِرْطَاس (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء. / لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه…)\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "書き候": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "書き入れ": "إِدْخَال",
 "書き入れ時": "موسم الذروة (الموسم الذي يكون فيه السفر أكثر نشاطًا والأسعار أعلى)\nمثال: سافروا إلى أوروبا في موسم الذروة",
 "書き写す": "نُسْخَة",
 "書き出し": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة. / لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه…)\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "書き出す": "مُقْتَطَف / صَادِرَات (جمع اسم فاعل من صَدَرَ؛ اللواتي يَصْدُرْن؛ البضائع الوطنية تُرسَل إلى بلاد أخرى…)\nمثال: صادرات الجزائر في تزايد.",
 "書き分ける": "دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم.",
 "書き加える": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "書き取り": "كَرْشَنَة, نَقْصَوَة",
