 "混濁液": "مُسْتَحْلَب",
 "混然": "كَامِل / كُلّ",
 "混獲": "صيد جانبي, صيد عرضي (كائنات بحرية غير مرغوب فيها يتم صيدها في الشباك أثناء صيد أنواع أخرى)\nمثال: تقتل الآلاف من الدلافين وخنازير البحر والحيتان كجزء من الصيد العرضي كل عام",
 "混生": "مُتَزَامِن الوُجُود, مُتَعَايِش (موجود في نفس الوقت)",
 "混用": "خلط, خليط (عملية خلط الأشياء معاً)\nمثال: عجينة مصنوعة من خليط الدقيق والماء",
 "混線": "تداخل الإشارات (وجود إشارة غير مرغوب فيها عبر اقتران عرضي) / اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "混芽": "برعم مختلط (برعم ينتج أوراقًا وزهورًا معًا)",
 "混血人": "مُوَلَّد, مِسْتِيزُو (شخص من أصل عرقي مختلط (خاصة من أصل أوروبي وأمريكي أصلي مختلط))",
 "混載": "تكامل, توحيد (عملية الدمج في كلٍ متكامل) / تصلب, تماسك (التجمع في كتلة صلبة) / كُتْلَة مُتَصَلِّبَة (شيء تصلب ليصبح كتلة مدمجة)\nمثال: دمج شركتين",
 "混迷": "مَعْمَعَة",
 "混迷状態": "مَعْمَعَة",
 "混雑": "اِحْتِقَان / اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك.",
 "淹れる": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟",
 "添い星": "قَمَر, تَابِع (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث) / قَمَر اِصْطِنَاعِيّ (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "添う": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري. / رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟ / تَزَوَّجَ / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "添える": "زَيَّن, زَخْرَف (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع) / زَيَّن (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع)\nمثال: زين سامي المكتب. / رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟ / تَقْلِيدِيّ (يُشكِّل تقليداً أو محاكاة) / مقلد (شخص يقلد (خاصة ممثل أو ممثلة))",
 "添え字": "سفلي, منخفض (نص) (مكتوب أو مطبوع أسفل وإلى جانب حرف آخر) / حرف سفلي, نص منخفض (حرف أو رمز يوضع أو يُطبع أو يُكتب أسفل أو قليلاً إلى أسفل وجانب حرف آخر) / دَلِيل, فِهْرِس / فِهْرِس (كِتَاب تجمع فيه أسماء الكتب بترتيب يسهل منه إجاد العنوان المراد البحث عنه؛ فَصْل أو بَاب في أول أو آخر الكتاب ترتب فيه الأبواب والفصول ومواضعها ليسهل منه إيجاد المطلوب)",
 "添え書き": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية) / تذييل, ملاحظة لاحقة (ملاحظة تضاف إلى رسالة بعد التوقيع)",
 "添え木": "جبيرة (جهاز ميكانيكي لتقويم العظام يستخدم لتثبيت وحماية جزء من الجسم (مثل الساق المكسورة)) / شَظِيَّة خشبية, شُقَاقَة (شظية رفيعة من الخشب)\nمثال: أشعل النار باستخدام شظية خشبية مشتعلة / وصلة تراكبية (وصلة تصنع عن طريق تداخل طرفين وربطهما معاً) / لصقة, وصلة (نقطة اتصال حيث يتم ضم شيئين (مثل الورق أو الفيلم أو الشريط المغناطيسي) معاً)\nمثال: كان الانقطاع بسبب وصلة غير متقنة",
 "添え板": "لوح وصل (لوحة معدنية تثبت بمسامير على طول جانبي سكتين أو عارضتين)",
 "添え物": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "添わせる": "تَزَوَّجَ / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "添乗": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)",
 "添乗員": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "添付": "حقيبة مستندات (حقيبة أوراق مستطيلة وضحلة) / ملحق (متخصص معين ضمن طاقم بعثة دبلوماسية)",
 "添付ファイル": "مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "添付文書": "مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "添付書類": "مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "添削": "تَصْحِيح",
 "添加": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "添加物": "إِضَافِيّ, تَرَاكُمِيّ (يتميز أو ينتج عن طريق الإضافة) / خطي (يصف أو يتضمن معادلة تكون حدودها من الدرجة الأولى) / مادة مضافة (شيء يضاف لتعزيز الطعام أو البنزين أو الطلاء أو الدواء)\nمثال: عملية إضافية",
 "添加要素": "إدراج, تضمين (عملية التضمين) / جِسْم اِحْتِوَائِيّ (أي جسم صغير داخل الخلية يوجد داخل آخر (من خصائص بعض الأمراض)) / اشْتِمَال, تَضَمُّن (علاقة تضمين شيء ما) / إدراج, اشتمال (حالة كونه مشمولاً أو مدرجاً)\nمثال: جسم احتوائي في سيتوبلازم الخلية",
 "添字": "سفلي, منخفض (نص) (مكتوب أو مطبوع أسفل وإلى جانب حرف آخر) / حرف سفلي, نص منخفض (حرف أو رمز يوضع أو يُطبع أو يُكتب أسفل أو قليلاً إلى أسفل وجانب حرف آخر) / دَلِيل, فِهْرِس / فِهْرِس (كِتَاب تجمع فيه أسماء الكتب بترتيب يسهل منه إجاد العنوان المراد البحث عنه؛ فَصْل أو بَاب في أول أو آخر الكتاب ترتب فيه الأبواب والفصول ومواضعها ليسهل منه إيجاد المطلوب)",
 "添字指定": "سفلي, منخفض (نص) (مكتوب أو مطبوع أسفل وإلى جانب حرف آخر) / حرف سفلي, نص منخفض (حرف أو رمز يوضع أو يُطبع أو يُكتب أسفل أو قليلاً إلى أسفل وجانب حرف آخر)",
 "添星": "قَمَر, تَابِع (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث) / قَمَر اِصْطِنَاعِيّ (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "添書": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية) / تذييل, ملاحظة لاحقة (ملاحظة تضاف إلى رسالة بعد التوقيع)",
 "添木": "جبيرة (جهاز ميكانيكي لتقويم العظام يستخدم لتثبيت وحماية جزء من الجسم (مثل الساق المكسورة)) / شَظِيَّة خشبية, شُقَاقَة (شظية رفيعة من الخشب)\nمثال: أشعل النار باستخدام شظية خشبية مشتعلة / وصلة تراكبية (وصلة تصنع عن طريق تداخل طرفين وربطهما معاً) / لصقة, وصلة (نقطة اتصال حيث يتم ضم شيئين (مثل الورق أو الفيلم أو الشريط المغناطيسي) معاً)\nمثال: كان الانقطاع بسبب وصلة غير متقنة",
 "添板": "لوح وصل (لوحة معدنية تثبت بمسامير على طول جانبي سكتين أو عارضتين)",
 "清": "تشينغ, سلالة تشينغ (آخر سلالة إمبراطورية للصين (من 1644 إلى 1912) والتي أطاح بها الثوار؛ خلال سلالة تشينغ حكم المانشو الصين) / بوضوح (بدون شك أو تساؤل) / بشكل متميز, بوضوح (واضح للعقل؛ بتمييز عقلي واضح) / بشكل مفهوم, بوضوح (بطريقة يمكن فهمها) / بِوُضُوح (بطريقة يسهل إدراكها)\nمثال: كانوا تائهين بوضوح / بِدِقَّة مُتَنَاهِيَة, بِلَا عَيْب (بسلاسة وبدون صعوبة؛ بدقة وبراعة) / بِنَظَافَة (بطريقة تقلل من الأوساخ والتلوث) / نَظِيف بِطَبْعِه (يتّسم بالنظافة عادةً وبشكل معتاد)\nمثال: هبط لاعب الجمباز بلا عيب",
 "清々しい": "مُنْعِش",
 "清い": "نَظِيف / نضيف / نَظَّفَ / صَافٍ, اَلصَّافِي",
 "清か": "شَفَّاف / وَاضِح",
 "清しい": "مُنْعِش",
 "清ます": "شَفَّاف / وَاضِح / سُلَالَة",
 "清め": "تَطْهِير (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير.",
 "清める": "صَفَّى",
 "清らか": "نَظِيف / نضيف / نَظَّفَ / صَافٍ, اَلصَّافِي",
 "清一色": "تَجَانُس (صفة التشابه أو القابلية للمقارنة في النوع أو الطبيعة) / تَجَانُس (صفة كون الشيء موحداً في جميع أنحائه في التكوين أو الهيكل)\nمثال: هناك تجانس ملحوظ بين الشركتين",
 "清代": "تشينغ, سلالة تشينغ (آخر سلالة إمبراطورية للصين (من 1644 إلى 1912) والتي أطاح بها الثوار؛ خلال سلالة تشينغ حكم المانشو الصين)",
 "清勝": "صحة جيدة, عافية (حالة التمتع بالنشاط والخلو من الأمراض الجسدية أو العقلية)",
 "清国": "تشينغ, سلالة تشينغ (آخر سلالة إمبراطورية للصين (من 1644 إلى 1912) والتي أطاح بها الثوار؛ خلال سلالة تشينغ حكم المانشو الصين)",
 "清子音": "صوت مهموس (صامت يُنتج بدون صوت من الحبال الصوتية)",
 "清廉": "نَزِيه, صَادِق",
 "清廉潔白": "استقامة, نزاهة (الصلاح الناتج عن كون الشخص شريفاً وصادقاً) / تَعَامُد, رَأْسِيَّة (الوضع بزاوية قائمة مع الأفق) / استقامة, انتصاب (خاصية كون الجسم منتصباً في الوضعية)",
 "清拭": "حمام إسفنجي (غسل الجسم بإسفنجة أو قطعة قماش مبللة بدلاً من الغمر في حوض الاستحمام)",
 "清掃": "تَنْظِيف",
 "清掃作業員": "جَامِع الْمُخَلَّفَات, جَامِعَة الْمُخَلَّفَات (اسم فاعل من الفعل جَمَعَ، الذي قام بالجَمع؛ قِدرٌ جامع: عظيمة. الجمع جُمْع)\nمثال: في أي جامعة تدرس؟",
 "清掃員": "مُنَظِّف / مُنَظِّفَة",
 "清掃夫": "عامل نظافة الشوارع, كنّاس الشوارع (عامل يعمل لتنظيف الشوارع (خاصة من يعمل لدى قسم الصرف الصحي في البلدية))",
 "清掃車": "شاحنة القمامة (شاحنة لجمع النفايات المنزلية)",
 "清教徒": "متزمت (شخص يهتم بشكل مفرط باللياقة والأعراف) / بيوريتاني, متزمت (شخص يلتزم بمبادئ دينية صارمة؛ شخص يعارض الملذات الحسية) / بيوريتاني, تطهيري (عضو في مجموعة من البروتستانت الإنجليز في القرنين السادس عشر والسابع عشر اعتقدوا أن الإصلاح البروتستانتي في عهد إليزابيث كان غير مكتمل ودعوا لتبسيط…)",
 "清新": "طَازَج, طَازَة / عَذْب",
 "清書": "مبيضة, نسخة منقحة (نسخة نظيفة من مسودة مصححة)",
 "清朝": "تشينغ, سلالة تشينغ (آخر سلالة إمبراطورية للصين (من 1644 إلى 1912) والتي أطاح بها الثوار؛ خلال سلالة تشينغ حكم المانشو الصين)",
 "清楚": "مُنَظَّم, نَظِيف",
 "清水": "مياه الينابيع (مياه من نبع طبيعي) / مياه جوفية (مياه تحت الأرض محتجزة في التربة وفي الصخور المنفذة)",
 "清浄": "صَافٍ, اَلصَّافِي",
 "清浄度": "نَظَافَة",
 "清浄無垢": "شرف, عفة (فضيلة المرأة أو عفتها) / براءة, طهارة (حالة الخلو من الخطيئة أو الخطأ الأخلاقي؛ الافتقار إلى معرفة الشر) / صفاء, نقاء (كون الشيء غير مخفف أو غير مخلوط بمواد غريبة)",
 "清浄綿": "قطن طبي, قطن ماص (قطن أصبح ماصاً عن طريق إزالة الشمع الطبيعي)",
 "清涼": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا.",
 "清涼剤": "استجمام, ترويح عن النفس (نشاط يجدد النشاط ويرفه؛ نشاط يجدد صحتك وروحك بالمتعة والاسترخاء) / ضيافة, مرطبات (وجبات خفيفة ومشروبات تقدم كوجبة خفيفة)\nمثال: وقت للراحة والاستجمام بجانب المسبح / مُنَبِّه, مُنْعِش (يبثّ الحيوية والطاقة) / منبور, نغمي ((للمقاطع) تحمل النبرة الرئيسية، وعادة ما تكون مصحوبة بتغيير في طبقة الصوت) / أَسَاسِيّ نَغْمِيّ (متعلق بالنغمة الأساسية في السلم الكبير أو الصغير أو كائنها) / نغمي (يستخدم تنوعات في طبقة الصوت لتمييز معاني الكلمات المتشابهة)\nمثال: المقطع النغمي يحمل النبرة الرئيسية في الكلمة",
 "清涼飲料": "مَشْرُوب غَازِيّ",
 "清涼飲料水": "مَشْرُوب غَازِيّ",
 "清清しい": "مُنْعِش",
 "清潔": "نَظِيف / نضيف / نَظَّفَ / صَافٍ, اَلصَّافِي",
 "清潔感": "نَظَافَة",
 "清澄": "شَفَّاف / وَاضِح",
 "清爽": "مُنْعِش / دَقِيق, مُتْقَن (خالٍ من الخَرَق؛ مُنفَّذ بدقة ومهارة) / صِرْف, غَيْر مَمْزُوج ((عَنِ المَشْرُوب الكُحُولِيّ) بِدُون مَاء) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / أَنِيق ظَاهِرِيًّا, بَرَّاق (يبدو مؤثّرًا من السطح لكنّه يفتقر إلى العمق والدقّة)",
 "清白": "فِجْل (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة) / دَايْكُون",
 "清真寺": "مَسْجِد, جَامِع (هو مكان السُجُوْد، بناء كان أم لا، عاما كان أم خاصا؛ المُصَلَّى)\nمثال: دخل إلى المسجد.",
 "清真教": "الْإِسْلَام",
 "清福": "سَعَادَة, فَرَح",
 "清算": "مُسْتَعْمَرَة, مُسْتَوْطَنَة / تَصْفِية / إنهاء, خاتمة (فعل إنهاء شيء ما) / خاتمة, نهاية (نهاية الكلمة (لاحقة أو نهاية تصريفية أو مورفيم نهائي)) / خاتمة, نهاية (القسم الأخير من اتصال ما) / إنهاء, ختام (حدث ينهي وقوعه شيئاً ما)\nمثال: إنهاء الاتفاقية",
 "清算人": "مُسوي مطالبات, وكيل مطالبات (شخص يحقق في مطالبات التأمين أو المطالبات عن الأضرار ويوصي بتسوية فعالة)",
 "清粋": "أَنَاقَة",
 "清純": "شرف, عفة (فضيلة المرأة أو عفتها) / براءة, طهارة (حالة الخلو من الخطيئة أو الخطأ الأخلاقي؛ الافتقار إلى معرفة الشر) / صفاء, نقاء (كون الشيء غير مخفف أو غير مخلوط بمواد غريبة)",
 "清聴": "اِهْتِمَام, اِنْتِبَاه",
