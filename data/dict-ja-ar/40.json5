 "湿布": "كِمادة (وسادة قماشية أو ضمادة (مع دواء أو بدونه) توضع بإحكام على جزء من الجسم (لتخفيف الانزعاج أو خفض الحرارة))",
 "湿布薬": "لَبْخَة",
 "湿度": "رُطُوبَة",
 "湿度計": "جَهَاز قِيَاس الرُطُوبَة",
 "湿式": "مُبْتَلّ / مَبْلُول, مُبْتَلّ",
 "湿性": "مُبْتَلّ / مَبْلُول, مُبْتَلّ",
 "湿気": "رُطُوبَة",
 "湿気っぽい": "رُطُوبة",
 "湿潤": "رُطُوبة",
 "湿生植物": "نبات مائي (نبات ينمو جزئياً أو كلياً في الماء سواء كان متجذراً في الطين، مثل اللوتس، أو عائماً دون تثبيت، مثل ورد النيل)",
 "湿疹": "أَكْزِيمَا",
 "満": "مُمْتَلِئ, مَلِيء / شِبَع, شبعان / مَنْشُورِيَا",
 "満たざる": "أَصْغَر مِن, صُغْرَى مِن",
 "満たす": "رَضَّى / مَلَأَ",
 "満たない": "أَصْغَر مِن, صُغْرَى مِن",
 "満ちる": "مَلَأَ / شَمْع, شَمَع ((شَمَعَ) يَشْمُعُ شَمْعًا، وشُمُوعًا: مَزَحَ وطَرِبَ)\nمثال: أشعل كين الشمع. / نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه. / نَاضِج, رَاشِد",
 "満ち潮": "ذروة المد, مد عالي (المد عندما يكون الماء في أعلى مستوياته)",
 "満ち足りる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "満つ": "شَمْع, شَمَع ((شَمَعَ) يَشْمُعُ شَمْعًا، وشُمُوعًا: مَزَحَ وطَرِبَ)\nمثال: أشعل كين الشمع. / نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه. / نَاضِج, رَاشِد",
 "満了": "إخراج النفس, زفير (فعل إخراج الهواء من الرئتين) / رحيل, فقدان (تعبيرات ملطفة للموت) / انتهاء, انقضاء (وصول فترة العقد إلى نهايتها)\nمثال: نعى الآلاف رحيله",
 "満了日": "تاريخ انهاء الصلاحية (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "満卓": "بيت كامل, فل هاوس (يد بوكر تحتوي على ثلاث بطاقات من نوع واحد وزوج من نوع آخر)",
 "満員": "بيت كامل, فل هاوس (يد بوكر تحتوي على ثلاث بطاقات من نوع واحد وزوج من نوع آخر)\nمثال: バスは満員だった。 — مُلئت الحافلة.",
 "満員御礼": "بيت كامل, فل هاوس (يد بوكر تحتوي على ثلاث بطاقات من نوع واحد وزوج من نوع آخر)",
 "満場一致": "إجماع تام (أن يكون الجميع على رأي واحد)",
 "満場総立ち": "تَصْفِيقٌ مَعَ الوُقُوف, تَصْفِيقٌ حَارّ",
 "満塁ホームラン": "اكتساح كامل, جراند سلام (الفوز بجميع الحيل في يد البريدج)",
 "満天": "رَقِيع, سماء",
 "満州": "مَنْشُورِيَا",
 "満州人": "منشوريا",
 "満州族": "لغة المانشو (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "満州語": "لغة المانشو (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "満席": "بيت كامل, فل هاوس (يد بوكر تحتوي على ثلاث بطاقات من نوع واحد وزوج من نوع آخر)",
 "満幅": "مُمْتَلِئ, مَلِيء / شِبَع, شبعان",
 "満年齢": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "満座": "بيت كامل, فل هاوس (يد بوكر تحتوي على ثلاث بطاقات من نوع واحد وزوج من نوع آخر)",
 "満悦": "طَرَب, نَشْوَة (طَرَّبَ الْمُغَنِّي: تَغَنَّى؛ طَرَّبَهُ بِغِنَاءٍ عَذْبٍ: هَزَّهُ، أَطْرَبَهُ، حَمَلَهُ عَلَى الطَّرَبِ)",
 "満月": "بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ بالغُرُوب طُلُوع الشَّمْسِ…؛ البَدْرُ الغلامُ المكتمل أو الممتلئ)",
 "満期": "إخراج النفس, زفير (فعل إخراج الهواء من الرئتين) / رحيل, فقدان (تعبيرات ملطفة للموت) / انتهاء, انقضاء (وصول فترة العقد إلى نهايتها)\nمثال: نعى الآلاف رحيله",
 "満期日": "مَوْعِد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "満杯": "مُمْتَلِئ, مَلِيء / شِبَع, شبعان / مَضْغُوط, مَكْبُوس (مضغوط معًا أو مكبوس بإحكام) / مَحْشُوّ, مُكْتَظّ (مُزْدَحِمٌ لِلغَايَةِ أَوْ مَمْلُوءٌ حَتَّى أَقْصَى طَاقَتِهِ)",
 "満洲": "مَنْشُورِيَا",
 "満潮": "ذروة المد, مد عالي (المد عندما يكون الماء في أعلى مستوياته)",
 "満潮線": "علامة المد العالي (خط يحدد أعلى مستوى تم الوصول إليه)",
 "満点": "كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه)",
 "満目": "على مَد البَصَر (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "満票": "بالإجماع (برأي واحد؛ بدون معارضة)\nمثال: وافق مجلس الشيوخ بالإجماع على مشروع القانون",
 "満腔": "حَارّ, صَمِيمِيّ (صَادِق وَجَادّ فِي المَشَاعِر)",
 "満腹": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "満腹度": "رَغْبَة, تَعَطُّش / جَاعَ (أَصَابَهُ الجُوعُ؛ أَصَابَهُ الفَقْرُ الشَّديدُ)\nمثال: جاع الرجل العجوز حتى الموت.",
 "満艦飾の船": "كَامِل, وَافٍ (كامل من كلّ جهة ووجه) / بِلِبَاسٍ رَسْمِيّ ((عَنِ المُنَاسَبَاتِ) يَسْتَلْزِمُ ارْتِدَاءَ مَلَابِسَ رَسْمِيَّةٍ) / لِلْمُنَاسَبَاتِ الرَّسْمِيَّة (مُنَاسِبٌ لِلمُنَاسَبَاتِ الرَّسْمِيَّةِ)",
 "満足": "رِضَا, إِشْبَاع (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا. / كافٍ, وافٍ (كمية يمكن أن تلبي حاجة أو متطلبًا ولكن دون أن تكون وفيرة)\nمثال: طعام كافٍ / مُرِيح, مُطَمْئِن (يبعث على الراحة ويحرّر من القلق) / دَسِم, مُشْبِع (يوفّر غذاءً وافرًا ومُشبِعًا)",
 "満足のいく": "مُرِيح, مُطَمْئِن (يبعث على الراحة ويحرّر من القلق) / دَسِم, مُشْبِع (يوفّر غذاءً وافرًا ومُشبِعًا)",
 "満足の行く": "مُرِيح, مُطَمْئِن (يبعث على الراحة ويحرّر من القلق) / دَسِم, مُشْبِع (يوفّر غذاءً وافرًا ومُشبِعًا)",
 "満足度": "رِضَا, إِشْبَاع (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "満載喫水": "مقياس (أداة قياس لقياس وتوضيح كمية مثل سمك السلك أو كمية المطر وما إلى ذلك) / عيار, قُطْر داخلي (قُطر أنبوب أو ماسورة سلاح ناري) / سُمك, عيار (سُمك السلك) / اتساع السكة (المسافة بين قضيبي السكة الحديدية أو بين عجلات القطار)",
 "満載喫水線": "خط التحميل, علامة بليمسول (خطوط مائية لإظهار المستوى الذي يجب أن يصل إليه الماء عندما تكون السفينة محملة بشكل صحيح)",
 "満遍": "كَافَّة, تَمَام / رَصِيد",
 "満遍なく": "بِالتَّسَاوِي",
 "溌剌": "دَجِر",
 "源": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "源氏豆": "مُسَكَّر, مُغَلَّف بِالسُّكَّر (مُغَطّى بطبقة من السكر أو الشراب المركز)",
 "源泉": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "源泉税": "حجز ضريبي, ضريبة الاستقطاع (ضريبة دخل تُستقطع من أجور الموظفين وتدفع مباشرة للحكومة من قبل صاحب العمل)",
 "源流": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "源頭": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "準": "دبلوم متوسط, درجة مشارك (درجة تمنحها كلية لمدة عامين عند إتمام الطالب بنجاح للدراسات الجامعية الأولية) / قرين, مرافق (أي حدث يصاحب عادة أو يرتبط ارتباطاً وثيقاً بآخر) / رَفِيق, زَمِيل (شخص ينضم للآخرين في نشاط أو مسعى) / زميل مشارك, شريك (شخص ذو عضوية تابعة في جمعية أو مؤسسة أو مؤسسة تجارية)\nمثال: أولاً كان البرق ثم قرينه الراعد",
 "準々決勝": "ربع النهائي (واحدة من أربع مسابقات في بطولة خروج المغلوب ينتقل الفائزون فيها للعب في نصف النهائي)",
 "準える": "قَلَّدَ",
 "準じる": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "準ずる": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "準備": "تَحْضِير, إِعْدَاد",
 "準備体操": "إحماء, تحضير (ممارسة التمارين استعداداً لنشاط شاق)",
 "準備書面": "مذكرة قانونية, مرافعة خطية (وثيقة تبين الحقائق والنقاط القانونية لقضية العميل)",
 "準備資金": "حساب احتياطي, صندوق احتياطي (أموال مقتطعة من الأرباح لتوفير المدفوعات المستقبلية المتوقعة)",
 "準備金": "حساب احتياطي, صندوق احتياطي (أموال مقتطعة من الأرباح لتوفير المدفوعات المستقبلية المتوقعة)",
 "準備銀行": "بنك الاحتياطي الفيدرالي (واحد من 12 بنكاً إقليمياً تراقب وتعمل كمستودعات للبنوك في منطقتها)",
 "準則": "تَنْظِيم",
 "準医療活動従事者": "مُسْعِف, مُسْعِفة",
 "準同型": "تَشَاكُل",
 "準学士": "دبلوم متوسط, درجة مشارك (درجة تمنحها كلية لمدة عامين عند إتمام الطالب بنجاح للدراسات الجامعية الأولية) / قرين, مرافق (أي حدث يصاحب عادة أو يرتبط ارتباطاً وثيقاً بآخر) / رَفِيق, زَمِيل (شخص ينضم للآخرين في نشاط أو مسعى) / زميل مشارك, شريك (شخص ذو عضوية تابعة في جمعية أو مؤسسة أو مؤسسة تجارية)\nمثال: أولاً كان البرق ثم قرينه الراعد",
 "準安定": "شِبْه اسْتِقْرَار (صفة النظام الفيزيائي الذي يستمر في توازنه الحالي عند عدم تعرضه للاضطراب (أو تعرضه لاضطراب طفيف فقط) ولكنه قادر على الانتقال إلى توازن أكثر استقراراً…)",
 "準州": "إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما)",
 "準恒星状天体": "نَجْم زَائِف, شَبِيه اَلنَّجْم (طَلَعَ وظَهَرَ؛ نَجَمَ عن الأمر: أي ظهر نَتِيجَة عنه أو نَتَجَ عنه)\nمثال: سميت السفينة \"النجم الفضي\".",
 "準惑星": "كَوْكَب قَزَم ((قديمًا) جرم سماوي من البلازما مضيئ بذاته متماسك بفعل الجاذبية؛ جرم سماوي يدور حول الشمس)\nمثال: كوكب الأرض جميل.",
 "準拠": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "準教授": "أستاذ مشارك (معلم برتبة أقل من أستاذ كامل ولكن أعلى من أستاذ مساعد)",
 "準星": "نَجْم زَائِف, شَبِيه اَلنَّجْم (طَلَعَ وظَهَرَ؛ نَجَمَ عن الأمر: أي ظهر نَتِيجَة عنه أو نَتَجَ عنه)\nمثال: سميت السفينة \"النجم الفضي\".",
