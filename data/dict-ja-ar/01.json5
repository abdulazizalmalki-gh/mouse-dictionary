 "いんじ": "طِبَاعَة / سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "いんじいち": "عَمُود / خَانَة",
 "いんじき": "آلَة كَاتِبَة, مِكْتَاب (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "いんじしゅつりょく": "نسخة مطبوعة, نسخة ورقية ((في علم الحاسوب) مادة محفوظة في كمبيوتر ومكتوبة أو مطبوعة على ورق)\nمثال: طبع نسخة ورقية من التقرير",
 "いんじそうち": "طَابِعَة",
 "いんじゃ": "رَاهِب (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "いんじゅ": "شجرة ظل (شجرة تزرع أو تقدر قيمتها بشكل رئيسي لظلها من أشعة الشمس)",
 "いんじゅん": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "いんじょ": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "いんすい": "مَاء شُرْب, مَاء صَالِح لِلشُّرْبِ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "いんすう": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟ / عَامِل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات. / عَدَد زَوْجِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "いんすうぶんかい": "تحليل العوامل, تفكيك ((رياضيات) تحليل تعبير رياضي إلى عوامل بحيث يعطي ضربها معاً التعبير الأصلي)",
 "いんする": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان. / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "いんず": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟",
 "いんずう": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟",
 "いんせい": "طالب دراسات عليا (طالب يواصل دراسته بعد التخرج) / سَلْبِيّ / سَلْبِيّ, سَالِب / مَنْفِيّ / سَالِب / صُورَة سَالِبَة / كَئِيب, مُوحِش / اِزْدِهَار, رَخَاء / شِهَاب",
 "いんせき": "صهر, نسيب (قريب عن طريق الزواج) / حَجَر نَيْزَكِيّ (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "いんせきやく": "دواء محمر للجلد (دواء للاستخدام الخارجي ينتج احمراراً في الجلد)",
 "いんせつ": "مُقَابَلَة",
 "いんせん": "مُبِيد (مَادَّةٌ كيميائيَّة سَامَّةٌ تُستخدم لإِبَادَةِ الْحَشَرَاتِ والجراثيم)\nمثال: اشترى ياني مبيد النمل.",
 "いんぜい": "مَلَكِيَّة",
 "いんぜん": "كَامِن, دَفِين",
 "いんそう": "مودرا (حركة يد طقسية في الدين أو الرقص الديني، خاصة في الهندوسية أو البوذية)",
 "いんそつ": "رَائِد, قِيَادِيّ (يذهب أو يتقدم في المقدمة؛ يظهر الطريق) / قيادة (نشاط القيادة) / فِي المُقَدِّمَة, مُتَصَدِّر (يَحْتَلُّ المَرْكَزَ الأَوَّلَ أَوْ لَدَيْهِ النَّتِيجَةُ الأَعْلَى فِي مُنَافَسَة) / شريحة رصاص, فاصد (شريط رفيع من المعدن يستخدم لفصل خطوط الحروف في الطباعة)\nمثال: ركبنا في السيارة المتقدمة",
 "いんそつしゃ": "قَائِد, زَعِيم",
 "いんぞう": "مودرا (حركة يد طقسية في الدين أو الرقص الديني، خاصة في الهندوسية أو البوذية)",
 "いんぞく": "صهر, نسيب (قريب عن طريق الزواج)",
 "いんたい": "تَقَاعُد / اِعْتِكَاف, عُزْلَة (فعل عزل نفسك عن الآخرين) / خصوصية, عزلة (صفة الانعزال عن وجود أو أنظار الآخرين)",
 "いんたく": "تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "いんち": "تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "いんちき": "تحايل, غش (خداع من أجل الربح الشخصي) / مُزَيَّف",
 "いんちきくさい": "مُثِيرٌ لِلشُّبْهَة, مُرِيب (ليس كما هو متوقّع؛ يبعث على الريبة) / زفر, سمكي (مكون من أو متعلق بـ أو يشبه السمك)\nمثال: كان للحساء رائحة سمكية",
 "いんちきりょうほう": "دجل, شعوذة طبية (ممارسة طبية ومشورة قائمة على الملاحظة والخبرة مع الجهل بالنتائج العلمية) / دجل, شعوذة (عدم أمانة الدجال)",
 "いんちき療法": "دجل, شعوذة طبية (ممارسة طبية ومشورة قائمة على الملاحظة والخبرة مع الجهل بالنتائج العلمية) / دجل, شعوذة (عدم أمانة الدجال)",
 "いんちき臭い": "مُثِيرٌ لِلشُّبْهَة, مُرِيب (ليس كما هو متوقّع؛ يبعث على الريبة) / زفر, سمكي (مكون من أو متعلق بـ أو يشبه السمك)\nمثال: كان للحساء رائحة سمكية",
 "いんちょう": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "いんてい": "بَظْر",
 "いんてき": "ضِمْنِيّ, مُطْلَق (بلا شكّ أو تحفُّظ) / ضمني, مفهوم ضمناً (مفهوم ضمناً وإن لم يتم التعبير عنه مباشرة؛ متأصل في طبيعة الشيء)\nمثال: اتفاق ضمني بعدم إثارة الموضوع",
 "いんでい": "خسارة, عجز (المبلغ الذي تتجاوز به تكلفة العمل إيراداته)\nمثال: عملت الشركة بخسارة العام الماضي",
 "いんでんか": "شحنة سالبة (وجود فائض من الإلكترونات؛ وجود جهد كهربائي أقل)",
 "いんでんき": "شحنة سالبة (وجود فائض من الإلكترونات؛ وجود جهد كهربائي أقل)",
 "いんでんし": "إِلِكْتْرُون, كُهَيْرِب",
 "いんとう": "بُلْعُوم / فُجُور (اسم فاعل من الفعل \"فَجَرَ\"؛ مصدر من الفعل \"فَجَرَ\") / إِغْوَاء / فُسُوق",
 "いんとうえん": "التهاب البلعوم, التهاب الحلق (التهاب الحلق والبلعوم)",
 "いんとうかじょ": "أنبوب الكأس, مجن (الهيكل الذي يشبه الكوب أو الحلقة أو الأنبوب للزهرة والذي يحمل السبلات والأسدية والكأس (كما في الوردية))",
 "いんとうつう": "اِلْتِهَاب حَلْق",
 "いんとうはんしゃ": "منعكس البلعوم, منعكس التقيؤ (منعكس طبيعي يتكون من التهوع؛ قد ينتج عن لمس الحنك الرخو في الجزء الخلفي من الفم)",
 "いんとく": "إخفاء, كتمان (نشاط إبقاء شيء ما سراً) / ستار, غطاء (غطاء يعمل على إخفاء أو حماية شيء ما) / خصوصية, سرية (حالة الاخفاء أو الكتمان)\nمثال: وفر ستار من الأشجار الخصوصية",
 "いんとくざい": "إخفاء, كتمان (نشاط إبقاء شيء ما سراً) / ستار, غطاء (غطاء يعمل على إخفاء أو حماية شيء ما) / خصوصية, سرية (حالة الاخفاء أو الكتمان)\nمثال: وفر ستار من الأشجار الخصوصية",
 "いんとん": "تَقَاعُد",
 "いんとんしゃ": "مُعْتَزِل, مُنْزَوٍ (منسحب من المجتمع ويطلب العزلة) / زاهد, معتزل (من يعيش في عزلة)",
 "いんどう": "الْكَلِمَات آخِرَة / مَهْبَل / مَهْبِل / فَرْج / ڤاچاينا",
 "いんないそうむ": "زعيم الكتلة البرلمانية (المشرع الذي ينظم استراتيجية حزبه)",
 "いんに": "بشكل غير مرئي, خفيةً (دون أن يُرى)\nمثال: تدخل هذه الكائنات الجسم خفية",
 "いんにく": "محبرة ختم, وسادة حبر (كتلة من مادة ماصة مشبعة بالحبر؛ تستخدم لنقل الحبر بالتساوي إلى ختم مطاطي)",
 "いんにん": "صَبْر, تَحَمُّل ((صَبَرَ) يَصْبِرُ صَبْرًا: تجلَّد ولم يَجْزَع؛ (صَبَرَ): انتظر في هدوء واطمئنان)\nمثال: الصبر أم العلوم. / أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية",
 "いんねん": "قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب. / صِلَة, صُلَة / عَلَاقَة, صِلَة / ذَرِيعَة, عُذْر",
 "いんのう": "صَفَن, كِيس اَلصَّفَن",
 "いんのこ": "جَرْو (الصَغير من كل نَبَات أو حَيَوَان؛ الصغير من الثَمَر كالبَطِّيخ والرُمَّان وغيره)\nمثال: كان الجرو يلحس خدها.",
 "いんばい": "بِغَاءٌ, دَعَارَة",
 "いんばいふ": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "いんばいや": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "いんばいやど": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "いんばん": "فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "いんばんや": "حفّار, نقاش (صانع طباعة يطبع من لوحة طباعة محفورة) / حفار, نقاش (عامل ماهر يمكنه نقش التصاميم أو الكتابة على سطح عن طريق النحت أو الحفر)",
 "いんぱん": "فُقْمَة / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "いんび": "فَاحِش, قَذِر / إِبْهَام, خَفاء (الإِصْبَعُ الغليظةُ الخامسةُ من أَصابع اليد والرِّجل، وهي ذات سُلامَيَيْن (مؤنثة وقد تذكَّر) والجمع: أباهيم، وإبهامات)",
 "いんぴ": "إخفاء, كتمان (نشاط إبقاء شيء ما سراً) / اختباء (حالة الاختباء)\nمثال: ذهب في الاختباء (تواري عن الأنظار)",
 "いんぶ": "عانة (الجزء السفلي من البطن فوق الأعضاء التناسلية الخارجية مباشرة)",
 "いんぶつ": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "いんぶん": "نَظْم (نَظَّمَه تَنْظِيمًا:أَلَّفَه وجَمَعَه فِي سِلْكٍ فانْتَظَمَ وتَنَظَّمَ ، وَمِنْه:نَظَمْتُ الشِّعْرَ ونَظَّمْتُه؛ نَظّم الأشياء :نظمها ،رتّبها،وضمّ بعضها إلى بعض في صورة منسّقة) / بَيْت (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت) / آيَة, عَدَد (العَلامَة أو الأمَارَة؛ المُعْجِزَة)\nمثال: نظم سامي كل شيء.",
 "いんぷ": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد) / أَمْوَال, ثَرْوَة / جبل الزهرة, عانة (تلة من الأنسجة الدهنية تغطي منطقة العانة عند النساء) / هَادِيس",
 "いんぷう": "شر, فجور (سلوك مرفوض أخلاقياً) / انحلال أخلاقي, فجور (صفة عدم التوافق مع معايير السلوك القويم أو الجيد)\nمثال: لا أخلاقية تأسيس دفاع الغرب على التهديد بالدمار المتبادل المؤكد",
 "いんぷく": "إخفاء, كتمان (نشاط إبقاء شيء ما سراً) / ستار, غطاء (غطاء يعمل على إخفاء أو حماية شيء ما) / خصوصية, سرية (حالة الاخفاء أو الكتمان)\nمثال: وفر ستار من الأشجار الخصوصية",
 "いんぺい": "إخفاء, كتمان (نشاط إبقاء شيء ما سراً) / ستار, غطاء (غطاء يعمل على إخفاء أو حماية شيء ما) / خصوصية, سرية (حالة الاخفاء أو الكتمان)\nمثال: وفر ستار من الأشجار الخصوصية",
 "いんぺいこうさく": "تستر (إخفاء يحاول منع شيء فاضح من أن يصبح علنياً)",
 "いんぺいし": "كابت, مخمد (جهاز كهربائي لكبت التيارات غير المرغوب فيها) / جين كابت, كابت (جين يكبت التعبير الظاهري لجين آخر (خاصة الجين الطافر)) / قامع, كاتم (شخص يقوم بالقمع)\nمثال: الديكتاتوريون هم قامعو حرية التعبير",
 "いんぺいしょく": "تلوين تخفي (تلوين يخفي أو يطمس شكل الحيوان)",
 "いんぼ": "أَخِير, نِهَائِيّ (لا يمكن تغييره أو التراجع عنه) / أَخِير, خِتَامِيّ (يَقَعُ فِي نِهَايَةِ شَيْءٍ أَوْ يُشَكِّلُ خَاتِمَتَهُ) / أَخِير, خِتَامِيّ (حاسم في عملية أو مسار تقدمي) / امتحان نهائي (امتحان يجرى في نهاية الفصل الدراسي)",
 "いんぼう": "حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ / دَسِيسَة / مُؤَامِرَة, مُوَاطَأَة",
 "いんぼうか": "متآمر (عضو في مؤامرة)",
 "いんぼうしゃ": "رسامة (أداة (عادة ما يتم تشغيلها بواسطة حاسوب) لرسم الرسوم البيانية أو الصور) / متآمر (عضو في مؤامرة) / رسام خرائط بيانية (كاتب يحدد البيانات على رسم بياني) / متآمر, مُدَبِّر (مخطط يضع خطة عمل شخصية)",
 "いんぼうせつ": "نَظَرِيَّة مُؤَامَرَة (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية.",
 "いんぼうだん": "مؤامرة (مخطط لتنفيذ عمل ضار أو غير قانوني (خاصة مؤامرة سياسية)) / زمرة سرية, عصبة (زمرة (غالباً ما تكون سرية) تسعى للسلطة عادة من خلال المؤامرات)",
 "いんぼうろん": "نَظَرِيَّة مُؤَامَرَة (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية.",
 "いんぽん": "شَبَق / دْرَامَا, مَسْرَحِيَّة",
 "いんま": "جَاثُوم, كَابُوس / كابوس, حلم / باروك",
 "いんめつ": "تَدْمِير, هَدْم / إخفاء, كتمان (نشاط إبقاء شيء ما سراً) / اختباء (حالة الاختباء)\nمثال: ذهب في الاختباء (تواري عن الأنظار)",
 "いんもう": "شَعْر اَلْعَانَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "いんもつ": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "いんもん": "فَرْج, حِرّ",
 "いんゆ": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية. / اِسْتِعَارَة / تَلْمِيح",
 "いんよう": "اقتباس (ممارسة الاقتباس من الكتب أو المسرحيات وغيرها) / اقتباس (مقطع أو تعبير مقتبس أو مستشهد به) / تسعيرة, سعر السوق (بيان لسعر السوق الحالي لورقة مالية أو سلعة) / إشارة مرجعية, استشهاد (ملاحظة قصيرة تعترف بمصدر المعلومات أو فقرة مقتبسة)\nمثال: بما أنه يفتقر إلى الأصالة، يجب عليه الاعتماد على الاقتباس / شُرْب (جَرَعَ)\nمثال: جلس وشرب قهوته.",
 "いんようか": "عرّاف (شخص يدعي اكتشاف المعرفة الخفية بمساعدة قوى خارقة للطبيعة)",
 "いんようかく": "عشبة العقر, قبعة الأسقف (نبات زاحف بطيء النمو بأوراق شبه دائمة الخضرة على سيقان سلكية منتصبة؛ يستخدم كغطاء أرضي)",
 "いんようく": "اقتباس (ممارسة الاقتباس من الكتب أو المسرحيات وغيرها) / اقتباس (مقطع أو تعبير مقتبس أو مستشهد به) / تسعيرة, سعر السوق (بيان لسعر السوق الحالي لورقة مالية أو سلعة) / إشارة مرجعية, استشهاد (ملاحظة قصيرة تعترف بمصدر المعلومات أو فقرة مقتبسة)\nمثال: بما أنه يفتقر إلى الأصالة، يجب عليه الاعتماد على الاقتباس",
 "いんようし": "يِين وَيَانْغ",
 "いんようしょ": "كِتَاب مَرْجِعِيّ (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "いんようしよう": "واجِهَة",
 "いんようふ": "عَلَامَات اِقْتِبَاس",
 "いんようぶん": "اقتباس (ممارسة الاقتباس من الكتب أو المسرحيات وغيرها) / اقتباس (مقطع أو تعبير مقتبس أو مستشهد به) / تسعيرة, سعر السوق (بيان لسعر السوق الحالي لورقة مالية أو سلعة) / إشارة مرجعية, استشهاد (ملاحظة قصيرة تعترف بمصدر المعلومات أو فقرة مقتبسة)\nمثال: بما أنه يفتقر إلى الأصالة، يجب عليه الاعتماد على الاقتباس",
 "いんようれき": "تقويم قمري شمسي (تقويم يعتمد على كل من الدورات القمرية والشمسية)",
 "いんよく": "رغبة جنسية, شهوة (رغبة في الحميمية الجنسية)",
 "いんらん": "فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف)",
 "いんりつ": "مِتْر (فِي : مُسْتَعْمَلٌ لِتَحْدِيدِ طُولِ مُخْتَلِفِ الأَشْيَاءِ، قَدْرُهُ ذِرَاعٌ وَنِصْفٌ تَقْرِيباً…؛ فِي : هوَ النَادل أو موَظف خدْمة الزَّبائن في المطْعم، يقَال أيْضاً \"مِيتْر\")\nمثال: أنا أقل بقليل من 150 سنتي متر. / عَرُوض, عِلْمُ العَرُوض",
 "いんりつろん": "عَرُوض, عِلْمُ العَرُوض",
 "いんりょう": "شَرَاب, مَشْرُوب",
 "いんりょうすい": "مَاء شُرْب, مَاء صَالِح لِلشُّرْبِ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "いんりょく": "جَاذِبِيَّة (صفة إثارة الاهتمام؛ كون الشيء جذاباً أو شيئاً يجذب) / جاذبية, عنصر جذب (خاصية توفر المتعة وتجذب) / مَعلم ترفيهي, وسيلة جذب (ترفيه يُقدم للجمهور) / عامل جذب, مصدر جذب (فنان ترفيهي يجذب جماهير غفيرة)\nمثال: حملت شخصيتها جاذبية غريبة بالنسبة له / جاذبية (جاذبية جنسية) / جَاذِبِيَّة (صفة إثارة الاهتمام؛ كون الشيء جذاباً أو شيئاً يجذب)\nمثال: حملت شخصيتها جاذبية غريبة بالنسبة له",
 "いんりょくけん": "حقل الجاذبية, مجال الجاذبية (مجال قوة يحيط بجسم ذي كتلة محدودة)",
 "いんれい": "اقتباس (ممارسة الاقتباس من الكتب أو المسرحيات وغيرها) / اقتباس (مقطع أو تعبير مقتبس أو مستشهد به) / تسعيرة, سعر السوق (بيان لسعر السوق الحالي لورقة مالية أو سلعة) / إشارة مرجعية, استشهاد (ملاحظة قصيرة تعترف بمصدر المعلومات أو فقرة مقتبسة)\nمثال: بما أنه يفتقر إلى الأصالة، يجب عليه الاعتماد على الاقتباس",
 "いんれき": "تقويم قمري",
 "いんれつ": "شق فرجي (الشق بين الشفرين الكبيرين) / فَرْج, حِرّ",
 "いんわい": "بذاءة, فاحشة (فعل فاحش) / بذاءة, فحش (سمة التصرف بطريقة فاحشة) / بذاءة, فحش (كلمة أو عبارة مسيئة أو غير لائقة)",
 "いんをなす": "قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "いんをふむ": "سَجْع (نَطَقَ، تَكَلَّمَ بأسلوب مُوزون؛ في نحو: التكرار في الجملة مما يؤدي إلى التأثير في المعنى، غالبًا بما يتناسب مع الوزن)",
 "いんイオン": "أَنْيُون, أَيُون سَالِب (أيون سالب الشحنة)",
 "いカメラ": "منظار المعدة (نوع من المناظير لفحص المعدة بصرياً) / تنظير المعدة (فحص بصري للمعدة عن طريق منظار المعدة الذي يتم إدخاله عبر المريء)",
 "いカメラけんさ": "تنظير المعدة (فحص بصري للمعدة عن طريق منظار المعدة الذي يتم إدخاله عبر المريء)",
 "い文字": "حَبَّار",
 "い続ける": "بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة كونه واجبَ الوجود لذاته ، فهو الأوّل بلا ابتداء ، والآخر بلا انتهاء؛ الباقي الثابتُ بعد غيره) / بَقِيَ, مَكَثَ (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: الباقي ليس مهم.",
 "い草": "أسل شائع, سمار ناعم (أسل طويل بسيقان ناعمة منتصبة أو مقوسة يوجد في أوراسيا وأستراليا ونيوزيلندا وشائع في أمريكا الشمالية)",
 "い辛い": "حَارِق, لَاذِع (قاسٍ أو كاوٍ في اللهجة) / حِرِّيف, نَفَّاذ (قَوِيٌّ وَحَادُّ الطَّعْمِ أَوِ الرَّائِحَة)",
 "う": "غَاقِيَات / أَرْنَب (حيوان من فصيلة الثدييات مستأنس يربيه الناس من أجل لحومه وفرائه الناعم، ويربى أحيانًا كحيوان أليف)\nمثال: زيري لديه أرنب. / أَرْنَب (حيوان من فصيلة الثدييات مستأنس يربيه الناس من أجل لحومه وفرائه الناعم، ويربى أحيانًا كحيوان أليف)\nمثال: زيري لديه أرنب. / شَرْق (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت) / مَشْرِق / شَرْقِيٌّ\nمثال: تشرق الشمس من الشرق. / اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / أَصْبَحَ (دَخَلَ فِي الصَّبَاح؛ صَارَ)\nمثال: استقبل توم الضيوف. / بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / أَنْقَلِيس, أَنْكَلِيس / أُوكْرَانِيَا (دولة تقع في شرق قارة أوروبا، وتحد الساحل الشمالي من البحر الأسود؛ أُسِّسَت كدولة مستقلة بعد سقوط الاتحاد السوفياتي عام ١٩٩١…)\nمثال: المجد لأوكرانيا",
 "うp": "حَمّل (رَفَعَ، أَقَلَّ) / تَحْمٍيْل",
 "うpる": "حَمّل (رَفَعَ، أَقَلَّ) / تَحْمٍيْل",
 "うぃっす": "يَاه, اسمع / هَلَا / نَعَم سَيِّدِي (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: أنت نعم الطالب.",
 "うぃーす": "يَاه, اسمع / هَلَا / نَعَم سَيِّدِي (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: أنت نعم الطالب.",
 "うぃーっす": "يَاه, اسمع / هَلَا / نَعَم سَيِّدِي (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: أنت نعم الطالب.",
 "うい": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / لَعُوق / غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل)",
 "ういうい": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "ういういしい": "بَرِيء, بَرِيئَة / بَرِيء",
 "ういきょう": "شَمَر ((شَمَرَ) يَشْمُرُ شَمْرًا: مَرَّ جادًّا؛ (شَمَرَ): مَشَى مُخْتالاً)",
 "ういた": "عِشْقِيّ, غَرَامِيّ / عَاشِق / إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور. / مُبَالَغ فِي زَخْرَفَتِهِ, مُتَنَمِّق (مزخرف بإفراط وتكلّف) / بَرَّاق, صَارِخ (يتّسم بالتباهي لكنّه غالبًا عديم الذوق) / بوانسيانا ملكية, زهرة الطاووس (شجرة استوائية مبهرجة أو شجيرة موطنها مدغشقر؛ تزرع على نطاق واسع في المناطق الاستوائية لعناقيدها الضخمة من الزهور القرمزية والبرتقالية؛ تصنف أحياناً…)",
 "ういっす": "يَاه, اسمع / هَلَا / نَعَم سَيِّدِي (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: أنت نعم الطالب.",
 "ういてんぺん": "قَابِلِيَّة لِلتَّحَوُّل, قَابِلِيَّة لِلتَّغَيُّر (صفة القابلية للتحول أو الطفرة)",
 "ういどうみゃく": "شريان معدي أيمن (فرع من الشريان الكبدي يغذي الجزء البوابي من المعدة عند الانحناء الصغير)",
 "うう": "نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "ううむ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل .",
 "ううわ": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "ううん": "غرفة الطوارئ (غرفة في مستشفى أو عيادة مزودة بطاقم ومعدات لتوفير رعاية طارئة للأشخاص الذين يحتاجون إلى علاج طبي فوري) / إيربيوم (عنصر فلزي ثلاثي التكافؤ من مجموعة الأتربة النادرة) / لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / نَعَم (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…) / لَا, لَاءَان (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "うぇーい": "يَاه, اسمع / هَلَا",
 "うえ": "رَغْبَة, تَعَطُّش / جَاعَ (أَصَابَهُ الجُوعُ؛ أَصَابَهُ الفَقْرُ الشَّديدُ)\nمثال: جاع الرجل العجوز حتى الموت. / أَعْلَى (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / فَوقَ / شَمَالِيّ / على (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذها إلى الأعلى. / قِمَّة / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو",
 "うえかえ": "زرع, نقل (عملية إزالة شيء من مكان وإدخاله في مكان آخر) / زراعة الأعضاء, نقل الأعضاء (عملية نقل عضو من كائن حي (المتبرع) إلى آخر (المتلقي))\nمثال: لم تزهر الشتلة المزروعة حتى السنة الثانية",
 "うえかえる": "زَرَعَ, شَتَلَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى) / زَرَعَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى) / زَرْع (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت. / جهاز إعادة ضبط, زر إعادة تعيين (جهاز لإعادة ضبط الأدوات أو عناصر التحكم)",
 "うえから": "مُتَعَال, اِسْتِعْلَائِيّ",
 "うえき": "نبات حدائق (أي من النباتات المتنوعة التي تُزرع عادة في حديقة زهور أو حديقة أعشاب)",
 "うえきしょくにん": "بُسْتَانِيّ, بُسْتَانِيَّة",
 "うえきばち": "أَصِيص الزُّهُور, أَصِيص",
 "うえきや": "بُسْتَانِيّ, بُسْتَانِيَّة",
 "うえこみ": "مَزْرَعَة",
 "うえこむ": "نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "うえさ": "إِشَاعَة, شَائِعَة",
 "うえさま": "قَيْصَر, إِمْبْرَاطُور",
 "うえざま": "قَيْصَر, إِمْبْرَاطُور",
 "うえした": "ذهاباً وإياباً, صعوداً وهبوطاً (التحرك للخلف وللأمام على طول مسار معين) / صُعُودًا وَهُبُوطًا, مِنْ أَعْلَى إلى أَسْفَل (بالتبادل بين الاتجاهين العلوي والسفلي)\nمثال: مشى ذهاباً وإياباً في غرفة تبديل الملابس / رَأْسًا عَلَى عَقِب, مَقْلُوب (في وضع انعكس فيه الأعلى والأسفل)",
 "うえじ": "تَنْضِيد",
 "うえじに": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "うえつがた": "نَبِيل, شريف (اَلذَّكِيُّ؛ اَلنَّجِيبُ) / كَرِيم, شَرِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: إنها امرأة نبيلة.",
 "うえつきそえじ": "علوي, مرتفع (نص) (مكتوب أو مطبوع فوق وإلى جانب حرف آخر) / حرف علوي, نص مرتفع (حرف أو رمز يوضع أو يُطبع أو يُكتب فوق وإلى جانب حرف آخر مباشرة)",
 "うえつきもじ": "علوي, مرتفع (نص) (مكتوب أو مطبوع فوق وإلى جانب حرف آخر) / حرف علوي, نص مرتفع (حرف أو رمز يوضع أو يُطبع أو يُكتب فوق وإلى جانب حرف آخر مباشرة)",
 "うえつけ": "زراعة, غرس (وضع البذور أو النباتات الصغيرة في الأرض لتنمو) / زرع, غرس (فعل التثبيت بإحكام في المكان) / مشجر, مغرس (مجموعة من النباتات (أشجار أو شجيرات أو زهور) في منطقة معينة)\nمثال: زراعة الذرة عمل شاق",
 "うえつける": "نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "うえでは": "طِبْقًا لِـ, وَفْقًا لِـ / بِالنِّسْبَة لِـ",
 "うえにはうえがある": "هُنَاكَ, يُوجَدُ",
 "うえにはうえがいる": "هُنَاكَ, يُوجَدُ",
 "うえのなまえ": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "うえのひと": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو / ـهُم / ـهُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / ـهُمَا / إِيَّاهُم / إِيَّاهُنَّ / إيَّاهُمَا\nمثال: هن يحببن الجاز.",
 "うえは": "بِمَا أَنّ, أَمَا وَأَنّ",
 "うえぶれ": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "うえむき": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "うえむく": "حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "うえる": "تَضَوَّرَ / نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض. / أَدْخَلَ / لَقَّحَ",
 "うえをいく": "فَاقَ, تَجَاوَزَ",
 "うえをしたへ": "اِحْتَارَ / تَشَوَّش / اِرْتَبَكَ, تَشَوَّش",
 "うえをむいてあるこう": "سوكيياكي",
 "うえん": "دَوَّار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار. / جَاهِل / مُتَعَلَّق",
 "うお": "سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / سَمَك, سمك (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك) / صَادَ\nمثال: سمكة ميناد ماتت",
 "うおかす": "مسحوق السمك (سمك مجفف مطحون يستخدم كسماد وعلف للماشية المنزلية)",
 "うおごころ": "إِحْسَان",
 "うおざ": "بُرْج اَلْحُوت, اَلْحُوت (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "うおしょうゆ": "صلصة السمك, صوص السمك",
 "うおじょうゆ": "صلصة السمك, صوص السمك",
 "うおつり": "صَيْد سَمَك, صَيْد",
 "うおのめ": "غَلَّة",
 "うお座": "بُرْج اَلْحُوت, اَلْحُوت (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "うか": "انبثاق / مَاطِر, مُنْهَمِر (يَتَسَاقَطُ قَطَرَاتٍ أَوْ كَأَنَّهُ يَتَسَاقَطُ كَالمَطَر)",
 "うかい": "تحويلة, طريق التفافي (طريق غير مباشر (خاصة الذي يستخدم مؤقتاً أثناء إغلاق الطريق الرئيسي))",
 "うかいろ": "تحويلة, طريق التفافي (طريق غير مباشر (خاصة الذي يستخدم مؤقتاً أثناء إغلاق الطريق الرئيسي))",
 "うかうか": "بإهمال, بلا مبالاة (دون عناية أو اهتمام) / بأناقة متمردة, باستهتار (بطريقة مستهترة أو مائلة) / بِتَهَوُّر, دُونَ حَذَر (بدون حذر أو حكمة)\nمثال: رفع آمال الأطفال بإهمال",
 "うかがい": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام) / بحث, تحقيق (بحث عن المعرفة) / استجواب, استفسار (حالة من السؤال أو الاستفسار)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته",
 "うかがいごと": "استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام) / بحث, تحقيق (بحث عن المعرفة) / استجواب, استفسار (حالة من السؤال أو الاستفسار)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته",
 "うかがいしる": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه.",
 "うかがい知る": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه.",
 "うかがう": "اختلاس النظر, تلصص (نظرة سرية) / زقزقة, صوصوة (الصوت الضعيف القصير لطائر صغير) / اِنْتَظَرَ, اِسْتَأْنَى (تَرَقَّبَ؛ تَوَقَّعَ)\nمثال: انتظر حتى أجلس. / خَمَّنَ, حزر ((خَمَّنَ) الشَّيْء: خمنه فَهُوَ مخمن)\nمثال: خمن الصائب: \"إن كانوا من السراعيف، فنعم\". / سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا. / سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا. / رَجَا (رَجَا يرْجُو رَجْوًا ورَجاءً ورَجاةً ورَجاءةً ورَجاوةً ومَرْجاةً: رجاه أملًا به؛ ورَجَاه: ناشده وتوسّل إليه)",
 "うかす": "طَفَا, عَامَ / طَفَا / أَنْقَذَ, أَنْجَى / اِدَّخَرَ / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "うかせる": "طَفَا, عَامَ / طَفَا / أَنْقَذَ, أَنْجَى / اِدَّخَرَ / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "うかつ": "غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "うかばれる": "اُرْقُد فِي سَلَام, اُرْقُد بِسَلَام",
 "うかびあがる": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "うかびでる": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح.",
 "うかぶ": "طَفَا, عَامَ / طَفَا / ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ظَهَرَ, بَدَا (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "うかぶせ": "فُرْصَة",
 "うかべる": "طَفَا, عَامَ / طَفَا / ٱسْتَدْعى / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / سَحْبٌ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: ليلى تذكر سامي.",
 "うから": "ذو رحم, قريب بالدم (شخص يرتبط بآخر عن طريق الدم أو الأصل؛ خاصة من يشترك في سلف مع آخر)",
 "うかり": "بإهمال, بلا مبالاة (دون عناية أو اهتمام) / بأناقة متمردة, باستهتار (بطريقة مستهترة أو مائلة) / بِتَهَوُّر, دُونَ حَذَر (بدون حذر أو حكمة)\nمثال: رفع آمال الأطفال بإهمال",
 "うかる": "مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "うかれあるく": "تسكع",
 "うかれお": "مُسْتَهْتَر",
 "うかれおとこ": "مُسْتَهْتَر",
 "うかれぶし": "أُغْنِيَّةٌ شَعْبِيَّة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر)\nمثال: أنا أغني أغنية.",
 "うかれめ": "مَرِح, مُعَاشِر (مشغول بمتع الصُّحْبَة الطيّبة أو مُولَع بها)",
 "うかれ歩く": "تسكع",
 "うがい": "تَمَضْمَضَ, غَرْغَرَ / سَائِل الْغَرْغَرَة",
 "うがいぐすり": "غَسُولُ فَمّ",
 "うがい薬": "غَسُولُ فَمّ",
 "うがちすぎた": "بَعِيد الاِحْتِمَال, مُسْتَبْعَد (غَيْر مُقْنِع؛ يَبْدو مُسْتَبْعَدًا أَوْ مُبالَغًا فيه) / بَعِيد الاحْتِمَال, مُتَعَسِّف ((عن فكرة أو قصة) مبالغ فيها أو هزلية لدرجة أنها غير محتملة)",
 "うがった": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء.",
 "うがつ": "ثَقَبَ, نَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / مِثْقَاب, بريمة / نِظام مُنْضَمّ, تَدْرِيْبات (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: انه ثقب الاسود. / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "うがんじゅ": "مَعْبَد",
 "うき": "طَافٍ, مُعَلَّق فِي سَائِل (محمول أو معلق في سائل) / طفو (فعل الشخص الذي يطفو على الماء) / عَائِم, مُتَنَقِّل (يَمِيلُ إِلَى التَّنَقُّلِ مِنْ مَكَانٍ لِآخَر) / تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر) / عوامة صيد (عوامة صغيرة مصنوعة عادة من الفلين؛ تعلق بخيط الصيد) / شَمَنْدُورَة / عَوَّامَة / طوق نجاة (وسيلة نجاة على شكل حلقة من مادة طافية) / حزام أمان, حزام نجاة (حزام يربطك بشيء ما كقيد لمنعك من التعرض للأذى) / موسم الأمطار (أحد الموسمين في المناخات الاستوائية، وهي فترة سنوية يحدث فيها معظم هطول الأمطار في بلد ما) / سَبَقَ, سَلَفَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك. / لَعُوق",
 "うきあがる": "طَفَا, عَامَ / طَفَا",
 "うきいし": "حجر الخفاف, خفاف (زجاج خفيف يتكون على سطح بعض الحمم البركانية؛ يستخدم كمادة كاشطة)",
 "うきいわ": "حجر الخفاف, خفاف (زجاج خفيف يتكون على سطح بعض الحمم البركانية؛ يستخدم كمادة كاشطة)",
 "うきうき": "بِبَهْجَة, بِمَرَح (بطريقة مرحة)\nمثال: وافق بمرح على القيام بذلك",
 "うきおり": "إِسْتَبْرَق (إستَبرَق)",
 "うきぎ": "خشب طاف (خشب يطفو أو جرفته الأمواج إلى الشاطئ)",
 "うきくさ": "غَيْرُ مُسْتَقِرّ, هَشّ (لا يوفّر راحة أو طمأنينة) / مَحْفُوفٌ بِالخَطَر, وَخِيم (مليء بالأخطار والمهالك) / مُتَزَعْزِع, هَشّ (غير آمن؛ محفوف بالصعوبات)",
 "うきくも": "تَقَلُّب, عَدَم اسْتِقْرَار (الصفة أو الخاصية المتمثلة في كون الشيء غير مستقر ومتردد) / عدم استقرار (عدم موثوقية ناتجة عن كون الشيء غير مستقر) / عدم استقرار (نظام غير مستقر) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني",
 "うきぐも": "تَقَلُّب, عَدَم اسْتِقْرَار (الصفة أو الخاصية المتمثلة في كون الشيء غير مستقر ومتردد) / عدم استقرار (عدم موثوقية ناتجة عن كون الشيء غير مستقر) / عدم استقرار (نظام غير مستقر) / اختلال, عدم استقرار (نقص التوازن أو حالة اختلال التوازن)\nمثال: اختلال هرموني",
 "うきこぼれ": "طالب متفوق (طالب يحقق معايير أعلى مما يشير إليه معدل ذكائه)",
 "うきごし": "مُتَذَبْذِبٌ, مُتَرَدِّدٌ (غير ثابت في الغرض أو الفعل) / تَذَبْذُب, تَقَلُّب (صفة كون الشيء غير ثابت وخاضع للتغيرات) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: احتفظ بسجل لتقلبات الأسعار",
 "うきたつ": "تباين, مقابلة (فعل التمييز عن طريق مقارنة الاختلافات) / تباين (نطاق الكثافة البصرية واللون في صورة سلبية أو مطبوعة (أو المدى الذي تختلف فيه المناطق المتجاورة على شاشة التلفزيون في السطوع)) / تباين (التأثير الإدراكي الناتج عن تجاور ألوان مختلفة جداً) / حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي)\nمثال: هناك خط رفيع بين العقل والجنون",
 "うきだす": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح.",
 "うきでる": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح.",
 "うきな": "إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "うきに": "حطام عائم (حطام سفينة يطفو على الماء)",
 "うきね": "شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "うきはし": "جسر عائم (جسر مؤقت يُبنى فوق سلسلة من الطوافات)",
 "うきぶくろ": "طوق نجاة (وسيلة نجاة على شكل حلقة من مادة طافية) / نَفَّاخَة الْعَوْم, مَثَانَة الْعَوْم",
 "うきぼり": "رَاحَة, تَخْفِيف / نَقْش نَافِر (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "うきめ": "شَقَاوَة, تَعَاسَة",
 "うきゅう": "بَدْمِينْتُون, تِنِس اَلرِّيشَة",
 "うきょうしん": "القلب اليميني (حالة غير طبيعية يقع فيها القلب باتجاه الجانب الأيمن من الصدر)",
 "うきょく": "تَعَرَّجَ",
 "うきよ": "ضَوْء أَحْمَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "うきよのならい": "سنة الحياة, طبيعة الأمور (الطريقة التي يتصرف بها الناس عادة أو تحدث بها الأشياء عادة)\nمثال: يتمتع القارئ العادي بقدر كبير من الحكمة والمعرفة بسنة الحياة",
 "うきよばなれ": "روحانية (الاهتمام بأمور الروح)",
 "うきわ": "طوق نجاة (وسيلة نجاة على شكل حلقة من مادة طافية)",
 "うきドック": "حوض جاف عائم, حوض عائم (حوض جاف يمكن غمره تحت السفينة ثم رفعه)",
 "うく": "طَفَا, عَامَ / طَفَا / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "うぐ": "غَبِيّ / غَبِيّ, أَحْمَق",
 "うぐいすいろ": "أخضر زيتوني (لون أفتح وأكثر خضرة من الزيتوني)",
 "うぐいすばり": "عَنْدَلِيب, بلبل",
 "うぐいす張り": "عَنْدَلِيب, بلبل",
 "うぐいす色": "أخضر زيتوني (لون أفتح وأكثر خضرة من الزيتوني)",
 "うぐら": "دابة الشجر, متسلق (أي من الطيور الصغيرة المتنوعة آكلة الحشرات في نصف الكرة الشمالي التي تتسلق جذوع الأشجار مستندة على ريش ذيل صلب وأقدامها) / زَاحِف (شخص يزحف أو يدب على الأرض) / مدادة, نبات زاحف (أي نبات (مثل اللبلاب أو العناقية) ينمو عن طريق الزحف)",
 "うけ": "شَعْبِيَّة / دِفَاع, حِمَايَة / دِفاع / اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة / قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما. / طَشْت / حوض (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا.",
 "うけあい": "ثقة, ثقة بالنفس (الخلو من الشك؛ الإيمان بالنفس وبالقدرات) / تأكيد, طمأنة (بيان يهدف إلى إلهام الثقة) / تَعَهُّد, ضَمَان (التزام ملزم بالقيام بشيء أو إعطائه أو الامتناع عنه) / تأمين (بريطاني) (مصطلح بريطاني لبعض أنواع التأمين)\nمثال: ثقته بتفوقه لم تجعله محبوباً",
 "うけあう": "قَامَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه. / أَكَّدَ (أكَّد الخبرَ ونحوه :صرّح بصحَّته؛ أَكَدَّ : قَرَّرَ، أَثْبَتَ، وثَّقَ)\nمثال: أكد صمته شكوكها",
 "うけいれ": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "うけいれさき": "مُسْتَلِم, مُسْتَلِمَة",
 "うけいれる": "قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل.",
 "うけうり": "تجارة التجزئة (الأنشطة المتعلقة ببيع السلع مباشرة للمستهلكين) / إعادة, تكرار (فعل القيام بالشيء أو أدائه مرة أخرى)",
 "うけおい": "عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد.",
 "うけおいけいやく": "عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد.",
 "うけおいし": "مُقَاوِل",
 "うけおいにん": "مُقَاوِل",
 "うけおう": "عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد.",
 "うけがいい": "مَحْبُوب",
 "うけがう": "صَدَّقَ, وَافَقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع) / اِسْتَحَسَنَ, وَافَقَ (عَدَّه حَسَنا بمعنى جميل؛ عدَّه حسنًا بمعنى جَيِّد) / وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: صدق سامي كل شيء.",
 "うけがよい": "مَحْبُوب",
 "うけがわるい": "غير رائج, غير شعبي (يُنظر إليه بعدم رضا أو يفتقر إلى القبول العام)\nمثال: أفكار غير شعبية",
 "うけぎ": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "うけぐち": "مَقْبِس",
 "うけこたえ": "أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ) / إِجَابَة, جَوَاب\nمثال: أجاب ياني فورا.",
 "うけざら": "صُحَيْفَة, طَبَق فِنْجَان / حاوية, مستوعب (حاوية تستخدم لوضع الأشياء أو حفظها بداخلها) / مأخذ, مِقبس (تجهيزة كهربائية (أو إلكترونية) متصلة بمصدر طاقة ومجهزة لاستقبال قابس) / تخت (طرف متضخم للساق يحمل الأجزاء الزهرية)",
 "うけざらとなる": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "うけしょ": "إِيصَال",
 "うけたまわり": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)",
 "うけたまわりおよぶ": "سَمِعَ بِـ (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا.",
 "うけたまわる": "سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "うけつぐ": "وَرَثَ",
 "うけつけ": "اِسْتِقْبَال / اِسْتِقْبَال, حَفْلَة اِسْتِقْبَال / إِيصَال",
 "うけつけがかり": "مُوَظَّف الْاِسْتِقْبَال, مُوَظَّفَةُ الْاِسْتِقْبَال",
 "うけつけじょう": "مُوَظَّف الْاِسْتِقْبَال, مُوَظَّفَةُ الْاِسْتِقْبَال",
 "うけつける": "قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل. / دُبّ / دُبَّة / اِحْتَمَلَ",
 "うけつぼ": "أَمِين, حارِس (شخص يتولى مسؤولية المباني أو الأراضي أو الحيوانات) / راعٍ, مَسْؤُول (شخص مسؤول عن رعاية أشخاص آخرين)\nمثال: هل أنا حارس لأخي؟",
 "うけて": "مِذْيَاع, رَادِيُو / سَمَّاعَة",
 "うけとめる": "لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "うけとり": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "うけとりかんじょう": "حِسَاب مَدِين (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "うけとりしょ": "إِيصَال",
 "うけとりしょうしょ": "إِيصَال",
 "うけとりつうち": "آر",
 "うけとりにん": "مُسْتَلِم, مُسْتَلِمَة",
 "うけとる": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "うけながす": "يَدْرَأ",
 "うけにん": "كَافِل",
 "うけのいい": "مَحْبُوب",
 "うけのよい": "مَحْبُوب",
 "うけみ": "دفاعي (مخصص أو مناسب للدفاع ضد العدوان أو الهجوم أو لردعه) / تَبْرِيرِيّ, دِفَاعِيّ (يسعى إلى التبرير أو الدفاع قولاً أو كتابةً) / موقف دفاعي (موقف يتسم بالدفاع عن النفس)\nمثال: أسلحة دفاعية / سلبية (سمة البقاء غير نشط؛ نقص في المبادرة) / استسلام, سلبية (الخضوع للآخرين أو للمؤثرات الخارجية) / مَبْنِيٌّ لِلْمَجْهُول",
 "うけみけい": "صِيغَة مَجْهُول / مَبْنِي مَجْهُول",
 "うけもち": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي",
 "うけもどし": "فِدَاء / خَلَاص",
 "うけもどす": "فِدْيَة / اِفْتَدَى, فَدَى",
 "うけやすい": "مُعَرَّض\nمثال: 日本は非常に地震の害を受けやすい。 — اليابان معرضة للزلازل بشدة.",
 "うける": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / أَبْقَى / عَالَ, يَعُولُ (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي.",
 "うけわたし": "تَوْصِيل, تَسْلِيم / مَخَاض, وَضْع / إِلْقَاء (إِلْقَاءُ الشَّبَكَةِ فِي البَحْرِ : رَمْيُها؛ إِلْقاءُ مُحَاضَرَةٍ : إعْطَاؤُهُا، أَي الحَدِيثُ فِي مَوْضُوعٍ أَمَامَ جَمْهُورٍ)\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "うけわたす": "نَقَلَ",
 "うげん": "يَمِينِيُّ السَّفِينَة (واقع على الجانب الأيمن من السفينة أو الطائرة) / الجانب الأيمن, الميمنة (الجانب الأيمن لسفينة أو طائرة لشخص على متنها ويواجه المقدمة أو الأنف)",
 "うげんほう": "إطناب, لف ودوران (أسلوب يتضمن طرقاً غير مباشرة للتعبير عن الأشياء)",
 "うこさべん": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / تثاقل, تردد (درجة معينة من عدم الرغبة) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: كان هناك تردد في كلامه",
 "うこっけい": "حَرِيرِيّ, نَاعِم اللَّمَعَان (ذُو سَطْح أَمْلَس لَامِع يَعْكِس الضَّوْء؛ نَاعِم كَالحَرِير)",
 "うこつけい": "حَرِيرِيّ, نَاعِم اللَّمَعَان (ذُو سَطْح أَمْلَس لَامِع يَعْكِس الضَّوْء؛ نَاعِم كَالحَرِير)",
 "うこん": "كُرْكُم",
 "うこんいろ": "أَصْفَر (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع) / أَصْفَر, صَفْرَاء (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان والذَهَب والعُصْفُر. انظر الصورة؛ صفة ما كان لونه أصفرا) / اِصْفَرَّ, صَفَّرَ\nمثال: قلبي أخضر و أصفر.",
 "うこんこう": "لَعْلَع / تُولِيب",
 "うごうのしゅう": "رعاع, غوغاء (حشد غير منظم من الناس) / عصابة (رابطة من المجرمين) / عصابة, نقابة الجريمة (تحالف فضفاض من رجال العصابات المسؤولين عن الأنشطة الإجرامية المنظمة)\nمثال: حاولت الشرطة تفكيك العصابة",
 "うごかしがたい": "رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب) / ثَابِتٌ, رَاسِخٌ (يتميز بعزيمة راسخة لا تتزعزع)",
 "うごかす": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور. / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ. / شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز. / حَشَدَ, اِسْتَجَاشَ (حَشَد القَوْمَ: جَمَعَهم؛ حَشَد الزَّرْعُ: نَبَتَ كُلُّه)\nمثال: لمحته للحظة وسط الحشد",
 "うごかぬしょうこ": "دليل دامغ, دليل قاطع (دليل لا يقبل الجدل (خاصة في جريمة))",
 "うごき": "حَرَكَة / رَائِج, مُتَدَاوَل / يَرُوج, يُتَدَاوَل",
 "うごきがとれない": "مُسْتَنْقَع",
 "うごく": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور. / شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه)\nمثال: شغل بيل التلفاز. / عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / مَثَّلَ (الشَبَه؛ النَظِير) / تَصَرَّفَ\nمثال: المهم هو العمل. / تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "うごめかす": "تلوّي, تململ (عملية التلوّي أو التململ)",
 "うごめく": "تلوّي, تململ (عملية التلوّي أو التململ)",
 "うごろもち": "خَال, شَامَة (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث) / طَوْبِين, طُوبِين / مُول\nمثال: عندي ابنا خالة.",
 "うさ": "قتامة, كآبة (شعور بتوجس كئيب) / عتمة, قتامة (حالة من الظلام الجزئي أو الكلي) / تجهم, قتامة (جو من الاكتئاب والحزن)\nمثال: أشعل عود ثقاب ليبدد العتمة",
 "うさいかく": "وحيد القرن الأسود",
 "うさぎ": "أَرْنَب (حيوان من فصيلة الثدييات مستأنس يربيه الناس من أجل لحومه وفرائه الناعم، ويربى أحيانًا كحيوان أليف)\nمثال: زيري لديه أرنب.",
 "うさぎうま": "حِمَار (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة)\nمثال: هن بحاجة لحمار.",
 "うさぎごや": "قفص أرانب (قفص مخصص للأرانب)",
 "うさぎざ": "قُوَاع, أَرْنَب بَرِّيَّة",
 "うさぎみみ": "نَمَّام, نَمَّامة",
 "うさぎむすび": "عقدة حلقية (أي من العقد المختلفة المستخدمة لعمل حلقة ثابتة في حبل)",
 "うさぎ小屋": "قفص أرانب (قفص مخصص للأرانب)",
 "うさぎ座": "قُوَاع, أَرْنَب بَرِّيَّة",
 "うさちゃん": "أرنب صغير, أرنوب ((عادة غير رسمي) خاصة أرنب صغير)",
 "うさばらし": "انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / استجمام, ترفيه (نشاط يسلّي أو يمتع أو ينشّط) / تمويه, هجوم تضليلي (هجوم محسوب لجذب دفاع العدو بعيداً عن نقطة الهجوم الرئيسي)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "うさん": "مُريب, مَشبوه",
 "うさんくさい": "ظَلِيل, وَارِف الظِّلّ (مَمْلُوء بِالظِّلّ) / مَشْبُوه (مشكوك في نزاهته أو قانونيَّته) / مُثِيرٌ لِلشُّبْهَة, مُرِيب (ليس كما هو متوقّع؛ يبعث على الريبة) / مُسْتَتِر, مُظْلِم (هادئ ومعتم أو مستتر عن الأنظار)",
 "うさん臭い": "ظَلِيل, وَارِف الظِّلّ (مَمْلُوء بِالظِّلّ) / مَشْبُوه (مشكوك في نزاهته أو قانونيَّته) / مُثِيرٌ لِلشُّبْهَة, مُرِيب (ليس كما هو متوقّع؛ يبعث على الريبة) / مُسْتَتِر, مُظْلِم (هادئ ومعتم أو مستتر عن الأنظار)",
