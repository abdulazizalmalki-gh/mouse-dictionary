 "おおはやり": "ذراع التطويل, عوارضة (أي من الصواري أو الأعمدة الأفقية المتنوعة المستخدمة لتمديد أسفل الشراع أو…)\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "おおば": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا…)\nمثال: كان لزيري جد و جدة. / إيريسين, نبات شريحة اللحم (نبات أمريكي جنوبي ذو فروع خضراء إلى أرجوانية أو حمراء بأوراق زينة خضراء إلى…)",
 "おおばけ": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "おおばこ": "لِسَان الْحَمَل, لِسَان الْخَرُوف (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق…)\nمثال: ماري لها فم ليس لها لسان. / خَزِينَة\nمثال: تلقى ياني طلقة في الصدر.",
 "おおばね": "رِيشَة مُحِيطِيَّة (ريش يغطي جسم الطائر البالغ ويحدد شكله)",
 "おおばん": "غُرَّة (بياض في جبهة الفرس فوق العينين أو بينهما وتحت الأذنين. انظر الصورة؛ أول يوم في…)",
 "おおひろま": "القاعة الكبرى (القاعة الرئيسية في قلعة أو قصر؛ يمكن استخدامها لتناول الطعام أو الترفيه)",
 "おおびき": "نجاح مفاجئ (عمل يحقق نجاحاً غير متوقع)\nمثال: كان ذلك الفيلم هو النجاح المفاجئ لهذا الصيف",
 "おおびけ": "إتمام, إكمال (إجراء ختامي أو نهائي)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية / سعر الإغلاق ((سوق الأسهم) سعر آخر معاملة تمت خلال جلسة تداول اليوم)",
 "おおびと": "عِمْلَاق",
 "おおびら": "مَفْتُوح\nمثال: فتح الباب آليا.",
 "おおふう": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية. / هَادِئ",
 "おおふくろももんが": "رَعْدِيد, هَيَّاب (سَرِيع الخَوْف وسَهْل الإِفْزَاع)",
 "おおぶくろ": "لِصّ, لِصَّة",
 "おおぶり": "عَاصِفَة",
 "おおぶろしき": "عجرفة, غطرسة (تفاخر فارغ ومغرور)",
 "おおへい": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية.",
 "おおべや": "غُرْفَةُ الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار…)\nمثال: الأب في الغرفة. / جناح, عنبر (مبنى يشكل قسماً من مستشفى (أو مجموعة من الغرف) يشترك فيه المرضى الذين يحتاجون…)\nمثال: وضعوها في جناح بأربعة أسرة / إدارَة المشاريع (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة…)\nمثال: والدتي تنتظرني في الإدارة.",
 "おおぼけ": "مُغَفَّل, أَحْمَق",
 "おおぼら": "شيء ضخم, شيء هائل (شيء كبير أو مثير للإعجاب بشكل خاص من نوعه)",
 "おおぼらふき": "متباهٍ, متفاخر (شخص كثير التفاخر والحديث عن نفسه)",
 "おおまえ": "حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "おおまか": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق. / كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل…)\nمثال: يا لك من رجل كريم!",
 "おおまかにいえば": "بإسهاب, بشكل عام (بطريقة عامة)\nمثال: تحدث بإسهاب عن خططه",
 "おおまがとき": "شَفَق ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه:…)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "おおまた": "اِمْتَطَى",
 "おおまちがい": "خطأ فادح, زلة (خطأ محرج)",
 "おおまわり": "تحويلة, طريق التفافي (طريق غير مباشر (خاصة الذي يستخدم مؤقتاً أثناء إغلاق الطريق الرئيسي))",
 "おおみ": "أَغُسْطُس, آب (الشهر الثامن في السنة الروميّة)\nمثال: غادر فاضل البلد في الثالث و العشرين من أغسطس.",
 "おおみかみ": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "おおみず": "طُوفَان, فَيَضَان (عاصفة)",
 "おおみずあお": "عثة الإمبراطور (عثة كبيرة من الغابات المعتدلة في أوراسيا ذات أجنحة شفافة كثيفة القشور)",
 "おおみそか": "31 ديسمبر, ليلة رأس السنة (اليوم الأخير من السنة)",
 "おおみたから": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه.",
 "おおみみぎつね": "لَوْشَب",
 "おおみや": "ضَرِيح / إِمْبِرَاطُورَة الأُمّ",
 "おおみやびと": "رجل حاشية (مرافق في بلاط الحاكم)",
 "おおむ": "أَغُسْطُس, آب (الشهر الثامن في السنة الروميّة)\nمثال: غادر فاضل البلد في الثالث و العشرين من أغسطس.",
 "おおむぎ": "شَعِير",
 "おおむぎわかば": "شعير الحائط (عشب حولي أوروبي يوجد غالباً كعشبة ضارة في الأراضي المهملة خاصة على طول جوانب…)",
 "おおむこう": "مَعْرِض, صَالَةُ عَرْض / جُمْهُور, نَظَّارَة",
 "おおむね": "بشكل عام, عموماً (دون تمييز واحد عن الآخرين)\nمثال: هو مهتم بالثعابين بشكل عام / لُبّ",
 "おおめ": "شهامَة / قَلِيلًا",
 "おおめいわく": "الكثير, دفعة (عدد كبير أو كمية أو مدى كبير (وغالباً ما تتبعها كلمة 'من'))\nمثال: دفعة من الرسائل",
 "おおめじろざめ": "قرش الثور (أكثر أنواع القرش شيوعاً في المياه الساحلية المعتدلة والاستوائية حول العالم؛ ضخم…)",
 "おおめにみる": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "おおもうけ": "مُمِيت, قَاتِل\nمثال: قتل الصياد دبا.",
 "おおもじ": "حَرْف كَبِير (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
 "おおもず": "صرد شمالي (طائر صرد من شمال أمريكا الشمالية)",
 "おおもと": "جَذْر, جدر (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه…)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "おおもの": "شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث) / طرائد كبيرة (حيوانات كبيرة يتم اصطيادها للرياضة)",
 "おおや": "مؤجر, مالك العقار (مالك أرض يقوم بتأجيرها للآخرين)",
 "おおやけ": "مَسْؤُول\nمثال: كلكم راع وكلكم مسئول عن رعيته. / عَلَنِيّ, عَامّ",
 "おおやけどころ": "مكتب حكومي (مكتب يعمل فيه موظفو الحكومة)",
 "おおやけのば": "عَلَنِيّ, عَامّ",
 "おおやさん": "مؤجر, مالك العقار (مالك أرض يقوم بتأجيرها للآخرين)",
 "おおやしま": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "おおやしまぐに": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "おおやしまのくに": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "おおやね": "سطح المنزل (سقف البيت)\nمثال: أعلنها من فوق أسطح المنازل",
 "おおやまと": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "おおやまととよあきずしま": "هُونْشُو / الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "おおやまととよあきつしま": "هُونْشُو / الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "おおやまねこ": "وَشَق",
 "おおゆみ": "قَوْس, قوس",
 "おおゆれ": "اِضْطِرَاب",
 "おおよう": "خَيِّر, طَيِّب القَلْب (يُظهر التعاطف والتفهّم والسخاء أو مدفوع بها) / هادئ, ساكن",
 "おおよそ": "حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار. / عُمُومًا / تَمَامًا / لَخَّصَ, اِخْتَصَرَ",
 "おおよろい": "شَبِيهٌ بِالصُّنْدُوقِ, صُنْدُوقِيّ (يشبه الصندوق في استطالته)",
 "おおよろこび": "فُرْجَة",
 "おおらか": "هادئ, ساكن / مُتَفَتِّح الذِّهْن, وَاسِع الأُفُق (يميل إلى احترام الآراء والمعتقدات التي تختلف عن آرائك ومعتقداتك)\nمثال: قاضٍ واسع الأفق ولكنه منصف",
 "おおるりそう": "لسان الكلب المخزني (شجيرة ثنائية الحول في أوروبا وغرب آسيا لها أوراق خشنة على شكل لسان وأزهار حمراء…)",
 "おおわく": "عُمُومًا",
 "おおわざもの": "بشكل ممتاز, على ما يرام (بشكل جيد جداً)\nمثال: إنها لا تشعر أنها على ما يرام اليوم",
 "おおわた": "أَمْعَاء غَلِيظَة, مِعًى غَلِيظ",
 "おおわれ": "غِطَاء",
 "おおん": "أَغُسْطُس, آب (الشهر الثامن في السنة الروميّة)\nمثال: غادر فاضل البلد في الثالث و العشرين من أغسطس.",
 "おおアメリカももんが": "سنجاب طائر شمالي (سنجاب طائر كبير؛ بشكل رئيسي من كندا)",
 "おおアルマジロ": "مدرع عملاق (يبلغ طوله حوالي ثلاثة أقدام باستثناء الذيل)",
 "おおコケ": "تماماً, مباشرة (بشكل كامل)\nمثال: سقط مباشرة على وجهه",
 "おおトカゲ": "وَرَل",
 "おおノリ": "بإثارة, بانفعال (مع إثارة؛ بطريقة منفعلة)\nمثال: صافحته بانفعال",
 "おおフルマかもめ": "نوء عملاق (طائر نوء بني كبير يوجد بشكل رئيسي في بحار القطب الجنوبي)",
 "おおボケ": "مُغَفَّل, أَحْمَق",
 "おか": "بَرّ, أَرْض (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر. / تَلّ, أَكَمَة (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: لقد تسلقت تل طويل / وَعْل, كَبْش",
 "おかあ": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟ / زَوْجَة, اِمْرَأَة",
 "おかあさま": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "おかあさん": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟ / زَوْجَة, اِمْرَأَة / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "おかあさんこ": "ابن أمه (صبي متعلق بأمه بشكل مفرط؛ يفتقر إلى الاهتمامات الذكورية الطبيعية)",
 "おかあさんっこ": "ابن أمه (صبي متعلق بأمه بشكل مفرط؛ يفتقر إلى الاهتمامات الذكورية الطبيعية)",
 "おかあちゃん": "أُمّ, مَامَا (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "おかい": "سماد بشري, فضلات بشرية (فضلات بشرية تستخدم كسماد) / روث, زبل (فضلات الحيوانات)",
 "おかいあげ": "شِرَاء, اِشْتِرَاء",
 "おかいけい": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه…)\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "おかいどく": "صَفْقَة (عَقْد، اتِّفَاق؛ ضرب اليدين عند العقد)\nمثال: إنها صفقة جيدة.",
 "おかえし": "ثَأْر, اِنْتِقَام ((ثَأَرَ) الْقَتِيلَ وَبِالْقَتِيلِ: أَيْ قَتَلَ قَاتِلَهُ)\nمثال: كل ما فعل سامي كان بداعي الثأر. / تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "おかえり": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ)\nمثال: إياك والتحرك حتى أرجع.",
 "おかお": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه.",
 "おかかえ": "شَخْصِيّ",
 "おかくれ": "مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود)\nمثال: رجل يحتضر",
 "おかくれになる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "おかけください": "إِجْلِس مِن فَضْلَك, إِجْلِس مِن فَضْلِك",
 "おかけ下さい": "إِجْلِس مِن فَضْلَك, إِجْلِس مِن فَضْلِك",
 "おかげ": "غريس / مُسَاعَدَة, إِمْدَاد / أغراض شخصية, متعلقات شخصية (ممتلكات ذات طابع شخصي قابلة للحمل ولا تستخدم في الأعمال التجارية)\nمثال: تركت بعض متعلقاتها الشخصية في المنزل",
 "おかげさま": "مُسَاعَدَة, إِمْدَاد / غريس",
 "おかげさまで": "لحسن الحظ (من حسن الحظ أن)\nمثال: لحسن الحظ لم يأت إلى الحفلة",
 "おかげ様": "مُسَاعَدَة, إِمْدَاد / غريس",
 "おかげ様で": "لحسن الحظ (من حسن الحظ أن)\nمثال: لحسن الحظ لم يأت إلى الحفلة",
 "おかざきフラグメント": "شَظَايَا أُوكَازَاكِي, قَطْع أُوكَازَاكِي",
 "おかざり": "زينة",
 "おかし": "حَلْوَى",
 "おかしがたい": "رزين, مهيب (يمتلك أو يعبر عن الكرامة؛ خاصة الرسمية أو الهيبة في السلوك أو المظهر)\nمثال: سلوكها الوقور",
 "おかしな": "مُضْحِك, هَزْلِيّ\nمثال: 先週の日曜日におかしな映画を見た。 — شاهدنا فلماً مضحكاً يوم الأحد الماضي. / غَرِيب, عَجِيب / مُخْطِئ\nمثال: نحن نرفض الظلم. / مُريب, مَشبوه",
 "おかしみ": "روح الدعابة, فكاهة (سمة تقدير (والقدرة على التعبير عن) الفكاهة)\nمثال: لم تقدر فكاهتي",
 "おかしや": "متجر سكاكر, محل حلويات (متجر لصنع أو بيع الحلويات والسكاكر)",
 "おかしら": "قَائِد, زَعِيم / رَئِيس, رَئِيسَة",
 "おかす": "غَزَا, اِجْتاحَ / اِخْتَلَسَ, أَزْعَجَ / ضَرَرٌ / اِرْتَكَبَ\nمثال: ビルはその罪を犯していなかった。 — لم يرتكب بيل الجريمة. / اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة. / اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ…)\nمثال: تعرض زيري للاغتصاب. / شُجَاع, جَرِيء (الثعبان)\nمثال: إنك شجاع للغاية. / ضَرَرٌ / سَابّ, كُفْرِيّ (يتّسم بالتجديف أو السبّ والشتم)\nمثال: موسيقى مقدسة ودنيوية / اِفْتَرَضَ",
 "おかず": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له) / مَلَأَ",
 "おかた": "رَبَّة, رَبَّةْ اَلْبَيْت",
 "おかたい": "صَارِم",
 "おかちめんこ": "امرأة قبيحة, عجوز شمطاء (امرأة قبيحة أو سيئة المزاج)\nمثال: كان يتودد لتلك العجوز الشمطاء طمعاً في مالها",
 "おかちん": "موتْشِي",
 "おかったるい": "غير كافٍ, قاصر (كمية غير قادرة على تلبية حاجة أو متطلب)\nمثال: أموال غير كافية",
 "おかっぴき": "محقّق خاص (شخص يمكن استئجاره لجمع المعلومات والمساعدة في التحقيقات الجنائية)",
 "おかとらのお": "ليسيماكيا عنق الإوزة (صنف من عشبة الليسيماكيا)",
 "おかね": "نُقُود, مَال\nمثال: أريد بعض المال.",
 "おかねもち": "ثري, غني (شخص يمتلك ثروة مادية كبيرة)",
 "おかのした": "مَفْهُوم",
 "おかばしょ": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "おかひき": "محقّق خاص (شخص يمكن استئجاره لجمع المعلومات والمساعدة في التحقيقات الجنائية)",
 "おかぶ": "تَخَصُّص, مَوْطِن قُوَّة (ميزة ذات قيمة أو فائدة خاصة)\nمثال: الطبخ هو نقطة قوته",
 "おかべ": "تُوفُو, توفو",
 "おかぼ": "بَرّ, يَابِسَة (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "おかま": "قِدْر (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد. / فَوَّهَةُ الْبُرْكَان, فَوَّهَة / أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته / رجل مثلي (رجل مثلي الجنس)",
 "おかまい": "تَرْفِيه, تَسْلِيَة / إبعاد, حظر (الرفض عن طريق فعل نفي أو حظر شخص ما)\nمثال: يجب على الجمعية التخلص من أعضائها المسنين - ليس عن طريق القتل الرحيم بالطبع، ولكن عن طريق النبذ",
 "おかまいなし": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات / تَبْرِئَة",
 "おかまぼう": "قبعة بولر, قبعة مستديرة (قبعة لباد مستديرة وصلبة ذات حافة ضيقة)",
 "おかまをほる": "لوطي (شخص يمارس اللواط)",
 "おかまを掘る": "لوطي (شخص يمارس اللواط)",
 "おかみ": "قَيْصَر, إِمْبْرَاطُور / حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة. / مالكة (امرأة مالكة) / سَيِّد\nمثال: يبدو زيري أحسن.",
 "おかみさん": "زوجة, مدام (مصطلح غير رسمي لمخاطبة زوجة شخص ما) / مالكة (امرأة مالكة)",
 "おかめいんこ": "كُوكَاتِيل",
 "おかやき": "حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "おかやま": "أُوكَايَامَا",
 "おかゆ": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية / إذن بالانصراف, طرد مفاجئ (فصل مفاجئ وبدون مراسم)",
 "おかよしがも": "بط سماري ((بَطَّ) الْقُرْحَةَ شَقَّهَا)\nمثال: ذهب لاصطياد البط.",
 "おからこうじ": "رَدِيء البِنَاء, مُرْتَجَل (مبنيّ بطريقة رديئة أو متسرعة)",
 "おからだ": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ…)",
 "おから工事": "رَدِيء البِنَاء, مُرْتَجَل (مبنيّ بطريقة رديئة أو متسرعة)",
 "おかれまして": "أَمَّا ؛ فَـ (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ)\nمثال: أما زلت تذكرني؟",
 "おかれんこん": "بَامْيَة, بَامْيَا",
 "おかわ": "قَعَادَة / فَاتِن, قَشِيب",
 "おかわり": "ثَانٍ, تاني\nمثال: لن أفعلها ثانية.",
 "おかん": "برودة شديدة, صقيع (برودة ناتجة عن بيئة باردة)\nمثال: سرت فيه رعشة مفاجئة / أمي, ماما (مصطلحات غير رسمية للأم)",
 "おかんじょう": "لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه…)\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "おかんむり": "حدة المزاج, سوء المزاج (حالة مزاجية غاضبة مستمرة)",
 "おかーさん": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟ / زَوْجَة, اِمْرَأَة / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "おがくず": "نُشَارَة",
 "おがみたおす": "اِسْتَجْدَى, تَسَوَّلَ",
 "おがむ": "اِسْتَجْدَى, تَسَوَّلَ / رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا.",
 "おがる": "كَبُرَ, ْنَشَأ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / نَمَى / صَيح, صِيَاح (مبالغة في الصياح، صاح كثيرا؛ في : صرخ)",
 "おがわ": "جَدْوَل",
 "おがわこまっこう": "حوت العنبر القزمي (حوت عنبر صغير جداً (يصل إلى 8 أقدام) يعيش في السواحل الوسطى للمحيط الأطلسي…)",
 "おが屑": "نُشَارَة",
 "おき": "أُوكِينَاوَا / جَمْرَة",
 "おきあい": "بعيداً عن الشاطئ, في عرض البحر (بعيداً عن الشاطئ؛ بعيداً عن اليابسة)\nمثال: تبحر على بعد ثلاثة أميال في عرض البحر",
 "おきあがりこぼし": "حمام قلاب (حمامة تقوم بشقلبات خلفية أثناء الطيران أو على الأرض)",
 "おきあがる": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "おきあみ": "كريل (قشريات عوالق تشبه الروبيان؛ مصدر رئيسي للغذاء للحيتان البالينية مثلاً)",
 "おきえそ": "سمكة السحلية (أسماك استوائية ذات أفواه كبيرة في رؤوس تشبه السحالي؛ توجد في جميع أنحاء العالم)",
 "おきかえ": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر)\nمثال: استبدال النجم لن يكون سهلاً",
 "おきかえる": "اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ. / نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "おきかた": "إعداد المسرح, ديكور المسرح (ترتيب المناظر والممتلكات لتمثيل المكان الذي تُمثل فيه مسرحية أو فيلم)\nمثال: كان الماس في مثبت ذهبي بسيط",
 "おききいただく": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا.",
 "おきさる": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا!",
 "おきざり": "فِرَار, هَجْر",
 "おきざる": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا!",
 "おきだい": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب."
}
