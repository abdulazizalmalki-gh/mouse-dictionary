 "うわなり": "سُرِّيَة / حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "うわにぶね": "قَدَّاحَة, وَلَّاعَة",
 "うわぬり": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "うわのせ": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول.",
 "うわばり": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "うわびょうし": "غِطَاء / غِلَاف / غَطَّى",
 "うわぶた": "غِطَاء",
 "うわぶれ": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "うわべ": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "うわべをかざる": "اِدَّعَى / زَعَمَ / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب.",
 "うわべを飾る": "اِدَّعَى / زَعَمَ / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب.",
 "うわまい": "عُمُولَة",
 "うわまえ": "النِّسْبَة الْمِئَوِيَّة",
 "うわまる": "كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "うわまわる": "كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "うわむく": "حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "うわや": "سَقِيفَة",
 "うわやく": "رَئِيس, رَئِيسَة",
 "うわり": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "うわん": "عَجَبًا / سُبْحَانَ الله (مصدر للفعل سَبَحَ؛ تُقال حصرًا للَّٰه، كما في العبارة \"سُبْحَانَ اللَّٰهِ\")\nمثال: سبحان الله عما يشركون.",
 "うわー": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "うわーっ": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "うわ言": "هُرَاء, لَغْو",
 "うん": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل .",
 "うんえい": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "うんえいかんりかん": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "うんえいけいひ": "مِيزَانِيَّة, مُوَازَنَة",
 "うんえいしゃ": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "うんえいひ": "مِيزَانِيَّة, مُوَازَنَة",
 "うんえん": "عَجَاج / مَنْظَر طَبِيعِيّ, مَنْظَر",
 "うんおう": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "うんか": "ثَوْل (بدا فيه الجنون) / اِزْدِحَام",
 "うんが": "قَنَاة",
 "うんがいい": "مَحْظُوظ, جَالِب للحَظّ",
 "うんがよい": "مَحْظُوظ, جَالِب للحَظّ",
 "うんき": "قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب.",
 "うんきゅう": "يُعَلِّق / تَعْلِيق",
 "うんきゅうほう": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "うんこ": "بَرَّزَ, تَغَوَّطَ (خَرَجَ؛ نَبُه بعد خُمول) / بُرَاز, كَاكَا / خَرَاء, بُرَاز",
 "うんこう": "عَمَلِيَّة, عَمَل / عَمَلِيَّة جِرَاحِيَّة, جِرَاحَة / عَمَلِيَّات, عَمَلِيَّة",
 "うんさん": "نَثَرَ, تَفَرَّقَ",
 "うんざり": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "うんざん": "حَسْب, مُحَاسَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "うんし": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / بَنَان (أَطْرَافُ الأَصَابِعِ) / صَبَّعَ ((صَبَعَ) به، وصَبَعَ عليه يَصْبَعُ صَبْعًا: أشار نحوه بِإِصبَعِهِ سخريةً؛ (صَبَعَ) في الشيءِ: أَدخل إصبَعَه فيه)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "うんしゅう": "ثَوْل (بدا فيه الجنون) / اِزْدِحَام",
 "うんしょう": "سَمَاوَات",
 "うんじ": "هَكَذَا",
 "うんじょう": "سَمَاوَات",
 "うんじょうびと": "نُبْل, نَبَالَة / فَخَامَة, شَهَامَة",
 "うんせい": "ثَرْوَة",
 "うんせいはんだん": "عَرَافَة",
 "うんそう": "نَقَلَ / نَقْل",
 "うんそうぎょうしゃ": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "うんそうじょう": "بُولِيصَةُ شَحْنٍ",
 "うんそうにん": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "うんそうひん": "حُمُولَة, شِحْنَة",
 "うんたい": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "うんたら": "فُلَان, فُلَانَة (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو شخص لا يريد المتحدث ذكره)\nمثال: سمعنا ذلك من فلان و فلان.",
 "うんたらかんたら": "فُلَان, فُلَانَة (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو شخص لا يريد المتحدث ذكره)\nمثال: سمعنا ذلك من فلان و فلان.",
 "うんだい": "مِنَصَّة / رَصِيف, مِنَصَّة",
 "うんち": "بَرَّزَ, تَغَوَّطَ (خَرَجَ؛ نَبُه بعد خُمول) / بُرَاز, كَاكَا",
 "うんちゃん": "سَائِق, سَوَّاق",
 "うんちん": "أُجْرَة, تَوْصِيلَة / مُسَافِر, سَافِر (مَسَافِر: (اسم)؛ مُسَافَر: (اسم)) / طَعَام (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: أقل سامي مسافر أوتوستوب.",
 "うんっ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل .",
 "うんてん": "عَمَلِيَّة, عَمَل / عَمَلِيَّة جِرَاحِيَّة, جِرَاحَة / عَمَلِيَّات, عَمَلِيَّة / سِيَاقَة, قِيَادَة / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "うんてんけいとう": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "うんてんし": "سَائِق, سَوَّاق / صَدِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "うんてんしゃ": "سَائِق, سَوَّاق",
 "うんてんしゅ": "سَائِق, سَوَّاق",
 "うんてんじかく": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "うんてんめんきょ": "رُخْصَةُ سِيَاقَة, رُخْصَةُ قِيَادَة",
 "うんてんめんきょしょう": "رُخْصَةُ سِيَاقَة, رُخْصَةُ قِيَادَة\nمثال: 運転免許証を持っていますか。 — هل تملك رخصة قيادة؟",
 "うんと": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "うんとうびょう": "دَوْخَة, دُوَار",
 "うんとこ": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "うんとこさ": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "うんとこしょ": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "うんどう": "تَمْرِين, تَدْرِيب / تَمَرَّنَ / اِلْتِمَاس, اِسْتِئْنَاف / اِسْتَأْنَفَ / حَرَكَة",
 "うんどうか": "نَاشِط, نَاشِطَة / رِيَاضِيّ, رِيَاضِيَّة",
 "うんどうぐつ": "مُتَسَلِّل / حِذَاء رِيَاضِيّ (بمعنى الإزاء والجوار؛ النَعْل)\nمثال: أردت حذاء أحمر.",
 "うんどうこうえん": "مَلْعَب, إِسْتَاد (موضع اللَعِب عامة؛ موضع يلعب فيه الصغار، يوضع لهم فيه العاب)\nمثال: .يمشون في الملعب",
 "うんどうしっちょう": "رَنَح ((رَنَّحَ) فلان: تمايل من السكر وغيره؛ (رَنَّحَ) الشراب فلانا: جعله يرنح)",
 "うんどうしゃ": "نَاشِط, نَاشِطَة",
 "うんどうしんけい": "مُنْعَكَس",
 "うんどうじょう": "مَلْعَب أَطْفَال (موضع اللَعِب عامة؛ موضع يلعب فيه الصغار، يوضع لهم فيه العاب)\nمثال: .يمشون في الملعب",
 "うんどうせんしゅ": "رِيَاضِيّ, رِيَاضِيَّة",
 "うんどうば": "مَلْعَب أَطْفَال (موضع اللَعِب عامة؛ موضع يلعب فيه الصغار، يوضع لهم فيه العاب)\nمثال: .يمشون في الملعب",
 "うんどうりつ": "عَزْم / لَحْظَة, دَقِيقَة",
 "うんどうりょう": "زَخَم حَرَكَة (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…) / زَخَم (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…)\nمثال: يمكنك أن تتعلم بنفس الزخم في المكتبة كما في المدرسة.",
 "うんどうエネルギー": "طَاقَة حَرَكِيَّة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد.",
 "うんにゃ": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / نَعَم (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…) / لَا, لَاءَان (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "うんぬん": "وَهٰكَذَا, وَهَلُمَّ جَرًّا / تَعْلِيق, مَلْحُوظَة / عَلَّقَ",
 "うんぬんかんぬん": "وَهٰكَذَا, وَهَلُمَّ جَرًّا",
 "うんのいい": "مَحْظُوظ, جَالِب للحَظّ",
 "うんのう": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
