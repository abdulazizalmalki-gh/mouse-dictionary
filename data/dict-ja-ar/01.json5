 "かくかく": "باهِر",
 "かくかん": "حَقَّانِيّ, عَقْلَانِيّ / مَوْضُوعِيّ / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / عَدَسَة\nمثال: لقد أخطأ الهدف.",
 "かくがい": "شَاذّ",
 "かくがた": "مُسْتَطِيل",
 "かくぎ": "فَنٌّ قِتَالِيّ, الفُنُون القِتَالِيَّة (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "かくぎょう": "فِيل (حيوان ثديي آكل أعشاب، وهو أكبر الحيوانات الأرضية الحية؛ (في الشطرنج) قطعة من قطع الشطرنج تتحرك بشكل قطري، ورمزها \"♗\" أو \"♝\")\nمثال: لدى الفيل أنف طويل.",
 "かくげん": "قَوْل",
 "かくこう": "فِيل (حيوان ثديي آكل أعشاب، وهو أكبر الحيوانات الأرضية الحية؛ (في الشطرنج) قطعة من قطع الشطرنج تتحرك بشكل قطري، ورمزها \"♗\" أو \"♝\")\nمثال: لدى الفيل أنف طويل.",
 "かくことができない": "ضَرُورِيّ, لَازِم",
 "かくことのできない": "ضَرُورِيّ, لَازِم",
 "かくご": "عَزْم, عُزْم / دِقَّة / اِسْتِقَالَة, اِسْتِعْفَاء",
 "かくごおり": "مُكَعَّبُ ثَلْجٍ",
 "かくさ": "مدى, قدرة / مَدَى",
 "かくさく": "مَكِيدَة",
 "かくされたいと": "أَجَنْدَة",
 "かくさん": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل. / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: تساهم في انتشار الجهل والتضليل.",
 "かくざとう": "قَنْد",
 "かくし": "أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟ / جَيْب (جيَّب القميص:جَابَ، جعل له جيبًا)\nمثال: جيب سامي مثقوب.",
 "かくしき": "شَكْلِيَّة",
 "かくしきのう": "بَيْضَة عِيد اَلْفِصْح, بَيْضَة اَلْفِصْح (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان)\nمثال: هذه بيضة مقلية.",
 "かくしこと": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "かくしごと": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "かくしだて": "سِرِّيَّة",
 "かくしつ": "كيراتين",
 "かくして": "هَكَذَا, كَذَا / وَهٰكَذَا, لِذَا",
 "かくしぼうちょう": "إِصَابَة (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى) / دَرَجَة\nمثال: تعرض زيري لإصابة.",
 "かくしゃ": "فُنْدُق, نُزْل (النُزْل، مبنى يؤجر الغُرَف والأَجْنِحَة باليَوْم أو اللَيْلَة ويقدم خدمات للنازلين فيه؛ قد يُقصد به البُنْدُق)\nمثال: دخل إلى الفندق.",
 "かくしゃく": "لَامِع, نَيِّر / مُسْتَنِير",
 "かくしゅ": "إِقَالَة / ضَرَبَ عُنُقَهُ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "かくしゅしてまつ": "اِشْتَاقَ",
 "かくしょう": "تَأْكِيد / سِرّ المَيْرُون (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "かくしょく": "خُبْز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / عيش (مصدر للفعل عَاشَ؛ هو الحَيَاة) / خُبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / خبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / قرص / خَبَزَ (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب)\nمثال: هذا الخبز لذيذ.",
 "かくしん": "نِوَاة",
 "かくしんてき": "اِبْتِكارِيّ, مُبْتَكَر / إِصْلَاحِيّ",
 "かくしマイク": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "かくじ": "كُلّ",
 "かくじつ": "أَكِيد / مُتَأَكِّد / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مُحَدَّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: لديك بعض الكتب.",
 "かくじつせい": "يَقِين (والقيد الأول جنس يشتمل إلى الظن أيضاً؛ والثاني يخرج الظن)\nمثال: اليقين الإيمان كله.",
 "かくじつど": "يَقِين (والقيد الأول جنس يشتمل إلى الظن أيضاً؛ والثاني يخرج الظن)\nمثال: اليقين الإيمان كله.",
 "かくじゅう": "تَمَدُّد / تَوَسُّع",
 "かくじょう": "أَقْرَن",
 "かくじんにかれのものを": "كل شخص حرّ في ذوقه",
 "かくす": "أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟",
 "かくすい": "هَرَم, أَهْرَام ((في الهندسة) منشور كثير السطوح، قاعدته مضلع، وأوجهه الأخرى مثلثات، قواعدها أضلاع مضلع القاعدة، ورؤوسها مجتمعة في نقطة واحدة خارجة عنه؛ بناء أثري بناه الفراعنة في مصر بالحجارة الصلبة، ذو قاعدة مربعة، له أربع واجهات، وكل واجهة مثلثة الشكل، تلتقي رؤوسها فتكون رأسًا واحدًا هو قمة الهرم)",
 "かくする": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "かくずけ": "مُعَدَّل (هو الأمر الذي جرى عليه تَعْدِيل فهو أفضل من ما يناظره؛ السيارة المعدّلة تسير بسرعة أكبر من مثيلاتها) / سِعْر (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: انخفض معدل الجريمة.",
 "かくせい": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره) / اِسْتَيْقَظَ, أَفَاقَ (منع النَوْم)\nمثال: أيقظ زيري السائق",
 "かくせいき": "مُكَبِّر صَوْت, بُوق",
 "かくせいざい": "مُنَشِّط, مُنَبِّه",
 "かくせん": "بُثُور سَوْدَاء, رُؤُوس سَوْدَاء",
 "かくぜつ": "تَوَحُّد",
 "かくぜん": "شَفَّاف / وَاضِح",
 "かくたい": "عُرْضَة, شَيْء / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَفْعُول بِهِ, مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به) / كَائِن\nمثال: لقد أخطأ الهدف.",
 "かくたる": "أَكِيد / مُتَأَكِّد / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مُحَدَّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: لديك بعض الكتب.",
 "かくだい": "تَمَدُّد / تَوَسُّع / تَوْسِيع / تَصْعِيد",
 "かくだいきょう": "عَدَسَةٌ مُكَبِّرَة",
 "かくだいしゅくしょう": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "かくだいすいけい": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "かくだん": "لافت للنظر / أَفْضَل, أَحْسَن / حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "かくち": "اِدْرََاك حَسِّيّ / تَعَلُّم (اكتسب معرفة أو خبرة أو مهارة) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: هو سريع التعلم.",
 "かくちく": "مُنَافَسَة, مُبَارَاة / مُنَافَسَة, مُسَابَقَة",
 "かくちゅう": "مَنْشُور / مَوْشُور",
 "かくちょう": "تَمَدُّد / تَوَسُّع / هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "かくちょうか": "تَوْسِيع",
 "かくちょうき": "اِنْبِسَاط (أَرَى على وَجْهِهِ انْبِسَاطاً : اِنْشِراحاً؛ اِنْبِسَاطُ الذِّراعَيْنِ: اِمْتِدادُهُما قابِلِيَّةُ التَّمَدُّدِ وَالاِنْبِساطِ)",
 "かくちょうきのう": "تَمَدُّد / تَوَسُّع",
 "かくちょうげんじつ": "الواقع المعزز",
 "かくちょうこうが": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "かくちょうだかい": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "かくちょうぶぶん": "تَمْدِيد",
 "かくっと": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "かくつう": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير.",
 "かくづけ": "مُعَدَّل (هو الأمر الذي جرى عليه تَعْدِيل فهو أفضل من ما يناظره؛ السيارة المعدّلة تسير بسرعة أكبر من مثيلاتها) / سِعْر (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: انخفض معدل الجريمة.",
 "かくて": "هَكَذَا, كَذَا / وَهٰكَذَا, لِذَا",
 "かくてい": "قَرَار, تَصْمِيم",
 "かくていてき": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "かくていはんげき": "عَاقَبَ, قَاصَصَ",
 "かくとう": "عَارَكَ, قَاتَلَ / تَعَارَكَ, تَقَاتَلَ / نَاضَلَ, كَافَحَ / قِتَال (من قَتَلَ: كثير القَتْل) / مَعْرَكَة\nمثال: لن يحل القتال أي شيء. / كِفَاح, نِضَال / كافح, جَاهَدَ",
 "かくとうか": "مُبَارِز, مُقَاتِل / مُحَارِب, مُقَاتِل",
 "かくとうぎ": "فَنٌّ قِتَالِيّ, الفُنُون القِتَالِيَّة (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن.",
 "かくとく": "اِكْتِسَاب",
 "かくとくけいしつ": "صِفَة مُكْتَسَبَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "かくとした": "أَكِيد / مُتَأَكِّد / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مُحَدَّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: لديك بعض الكتب.",
 "かくど": "زَاوِيَة",
 "かくにゅうき": "مَخَاضَة",
