 "うちあげはなび": "شمروخ, صاروخ ألعاب نارية (يرسل عرضًا للألعاب النارية عاليًا في السماء)",
 "うちあげる": "أَطْلَقَ, قَذَفَ / شَحْطَة / فَرَغَ, أَنْهَى\nمثال: انتهى أمر زيري. / وَصَفَ, أَبْلَغَ\nمثال: أبلغ توم تحياتي.",
 "うちあてる": "أَصَابَ\nمثال: تلقى مناد ضربة.",
 "うちあわせ": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم. / تراكب, طية (لسان يقع فوق جزء آخر)\nمثال: يجب أن يكون تراكب القرميد عشر بوصات على الأقل",
 "うちあわせる": "تَصَادُم / رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "うちいり": "عَاصِفَة",
 "うちいる": "عَاصِفَة",
 "うちうち": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "うちうみ": "بَحْر دَاخِلِيّ (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر. / بُحَيْرَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "うちおとす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "うちおろし": "مُنْحَدِرًا, نَحْو الأَسْفَل (باتجاه أسفل التل)\nمثال: عند الجري نحو الأسفل، اكتسب الكثير من السرعة",
 "うちかかる": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "うちかくし": "جيب داخلي (جيَّب القميص:جَابَ، جعل له جيبًا)\nمثال: جيب سامي مثقوب.",
 "うちかた": "إطلاق نار (فعل إطلاق النار من بندقية)\nمثال: تراجعوا في مواجهة نيران العدو الشديدة",
 "うちかつ": "قَهَرَ, اِنْتَصَرَ (غَلَبَ وانْتَصَرَ ولم يقدر عليه أحد) / هَزَمَ, غَلَبَ",
 "うちがね": "مِطْرَقَة, شَاكُوش (أداة رأسها من حَدِيد ولها ذراع غالبا ما تكون من خَشَب تستخدم لضرب المِسْمَار في…)\nمثال: سأشتري له مطرقة.",
 "うちがま": "طباخة أرز, قدر طهي الأرز (جهاز مطبخ آلي مصمم لسلق أو طهي الأرز بالبخار)",
 "うちがわ": "دَاخِل\nمثال: جون في عمر أخي.",
 "うちき": "خَجُول, خَجِل",
 "うちきず": "كَدَمَ",
 "うちきり": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري.",
 "うちきりごさ": "خطأ البتر ((رياضيات) خطأ في الحساب ينتج عن قطع عملية حسابية رقمية قبل انتهائها)",
 "うちきる": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "うちきん": "وَدِيعَة\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "うちぎ": "مَلَابِس دَاخِلِيَّة, لِبَاس دَاخِلِيّ",
 "うちくずす": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة.",
 "うちくだく": "كَسَّرَ",
 "うちくび": "قَطْعُ الرَّأَس (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "うちくら": "غرفة تخزين, مخزن (غرفة تُخزن فيها الأشياء)",
 "うちぐら": "غرفة تخزين, مخزن (غرفة تُخزن فيها الأشياء)",
 "うちけし": "نَفْي",
 "うちけす": "نَفَى / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "うちげんかん": "باب جانبي, مدخل جانبي (باب خارجي على أحد جوانب المبنى)",
 "うちこ": "طَحِين, دَقِيق / بُودْرَة / للسان الجرس, مصفق (مطرقة معدنية تتدلى داخل الجرس وتصدر صوتاً بضرب الجانب)",
 "うちこみ": "سِيَاقَة, قِيَادَة",
 "うちこむ": "أَصَابَ\nمثال: تلقى مناد ضربة. / مُدْخَل",
 "うちこわし": "تَدْمِير, هَدْم",
 "うちこわす": "دَمَّرَ / خَرَاب, خَرَابَة",
 "うちしおれる": "تدلي, ترهل (شكل يتدلى أو يهبط للأسفل)\nمثال: كان هناك هبوط في مقعد الكرسي",
 "うちじゅう": "جَمِيع أَنْحَاء, كُلّ",
 "うちすえる": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "うちすてる": "طَرَحَ (طَرَحَ الشَّيْءَ: أَلْقَاهُ؛ طَرَحَ فُلَاناً أَرْضاً: أَوْقَعَهُ)\nمثال: طرح زيري سؤالا.",
 "うちそこなう": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "うちそと": "حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "うちたおす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "うちだし": "دك, طرق (فعل الطرق (توجيه ضربات ثقيلة متكررة))\nمثال: فاجأه طرق القبضات المفاجئ / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / مطبوعة, نسخة مطبوعة (مخرجات الكمبيوتر في شكل مطبوع)",
 "うちだす": "طَبَعَ (طَبَعَ الله الخلقَ : أَنشأَهُ؛ طبَعَت الدَّوْلةُ النَّقْد : صاغتْه ونقشته)\nمثال: بالطبع هي مزحة! / ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "うちっぱなし": "ميدان غولف (ميدان تدريب للتدرب على ضربات الغولف)",
 "うちつける": "ظُفْر, ضفر (الجزء المتقرن الميت على طرف الأصبع من الإنْسَان وبعض الحَيْوَانَات)\nمثال: نبت ظفر أصبع رجلي الكبير. / فَرْقَعَة / رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة.",
 "うちて": "رَامٍ ((رَامَ) الجُرحُ يَرِيمُ رَيْمًا، ورَيَمَانًا: انْضَمَّ فَمُهُ للبُرْءِ؛ (رَامَ)…) / مُلقح (ممارس طبي يلقح الناس ضد الأمراض) / طبال (شخص يعزف على الطبل)",
 "うちでし": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "うちとめる": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري. / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "うちとる": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا. / غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "うちどころ": "بُقْعَة",
 "うちどめ": "نِهَايَة, غَايَة\nمثال: انتهى أمر زيري.",
 "うちならす": "حَلْقَة",
 "うちなる": "داخلى",
 "うちなー": "أُوكِينَاوَا",
 "うちにわ": "ساحة رباعية, فناء رباعي (منطقة مستطيلة محاطة بالمباني من جميع الجوانب)",
 "うちぬき": "لَكْمَة\nمثال: لكم اشتقت إليك! / بِئْرٌ إِرْتِوَازِيَّة, بِئْرٌ إِرْتِوَازِيّ",
 "うちぬく": "اِخْتَرَقَ / لَكْمَة\nمثال: لكم اشتقت إليك! / نَقَلَ\nمثال: لا أزال عطشانا. / شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ…)\nمثال: شغل بيل التلفاز.",
 "うちねこ": "قط, قط أليف (حَيْوَان مستأنس من عائلة السَنُّورِيّات، له في اللغة أسماء عديدة تذكر وتؤنث)\nمثال: أعطنا هذا القط.",
 "うちのめす": "أَرْضِيَّة, أَرْض (ما يقابل السَقْف من الغرفة؛ قاع الشيء)\nمثال: انهارت الأرضية. / هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "うちのやつ": "زَوْجَة, اِمْرَأَة",
 "うちの奴": "زَوْجَة, اِمْرَأَة",
 "うちはじめる": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "うちはたす": "قَتَلَ, أَزْهَقَ رُوحَهُ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "うちはなし": "ميدان غولف (ميدان تدريب للتدرب على ضربات الغولف)",
 "うちはらう": "دَفَعَ, صَدَّ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن…)\nمثال: دفع زيري الثمن.",
 "うちばり": "بِطَانَة / خَشَبَة",
 "うちひしぐ": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "うちふす": "اِسْتَلْقَى (وَضَعَ ظَهْرَهُ عَلَى سَطْحٍ كَالسَّرِيرِ والأَرْضِ للنوم أو الاستراحة)\nمثال: استلقى على السرير.",
 "うちふる": "إشهار, تلويح (فعل التلويح)",
 "うちふるえる": "اِخْتَلَجَ, اِرْتَجَفَ",
 "うちぶ": "إصدار مُكَلف",
 "うちぶところ": "جيب داخلي (جيَّب القميص:جَابَ، جعل له جيبًا)\nمثال: جيب سامي مثقوب.",
 "うちほろぼす": "دَمَّرَ",
 "うちぼう": "مِرْقَاق, فَرَّادَة / تَهْرِيجِيّ (يتّسم بالمُشاغبة والحركة البدنيّة في الكوميديا)",
 "うちまかす": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "うちまく": "تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية",
 "うちまくばなし": "تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية",
 "うちまた": "أروح, حنف القدم (ذو قدمين تتجهان نحو الداخل)",
 "うちまたがる": "رَكِبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا…)\nمثال: ركب ياني سفينة.",
 "うちまたこうやく": "خائن, غادر (شخص يقول شيئاً ويفعل شيئاً آخر)",
 "うちまたごうやく": "خائن, غادر (شخص يقول شيئاً ويفعل شيئاً آخر)",
 "うちまたに": "أروح, حنف القدم (ذو قدمين تتجهان نحو الداخل)",
 "うちまちがい": "خَطَأ مَطْبَعِيّ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة…)\nمثال: كان خطأ حاسوبي.",
 "うちまわり": "بالداخل, في الداخل (داخل مبنى)\nمثال: في الشتاء نلعب في الداخل",
 "うちみ": "كَدَمَ",
 "うちみる": "نَظَرَ (اِسْتَعْمَلَ عينه ليَرَى الشيءَ، ليُدْرِكَه ويُبْصِرَه. (مَصْدَرُهُ نَظَر)…)\nمثال: نظر إلى السماء.",
 "うちもうこ": "مُنْغُولِيَا اَلدَّاخِلِيَّة",
 "うちもうこじちく": "مُنْغُولِيَا اَلدَّاخِلِيَّة",
 "うちもの": "آلة إيقاعية (آلة موسيقية يتم فيها إنتاج الصوت عن طريق ضرب شيء بآخر)",
 "うちものし": "حَدَّاد, قَيْن / سَيَّاف, سَلَّال",
 "うちやぶる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ…)\nمثال: عليك أخذ استراحة.",
 "うちゅう": "كَوْن, الْكَوْن",
 "うちゅういがく": "طب الفضاء (فرع الطب المعني بتأثيرات رحلات الفضاء على البشر)",
 "うちゅうがく": "عِلْم الكَوْن الفِيزِيَائِيّ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "うちゅうき": "مَرْكَبَةٌ فَضَائِيَّة",
 "うちゅうきかん": "وكالة فضاء (منظمة مكرسة لاستكشاف الفضاء)",
 "うちゅうきかんかいぎ": "وكالة فضاء (منظمة مكرسة لاستكشاف الفضاء)",
 "うちゅうきち": "مَحَطَّةُ فَضَاء / كُوسْمُودْرُوم",
 "うちゅうきょく": "وكالة فضاء (منظمة مكرسة لاستكشاف الفضاء)",
 "うちゅうくうかん": "فَرَاغ, مَكَان\nمثال: الفضاء مليئ بالغموض.",
 "うちゅうけいかく": "برنامج فضاء (برنامج تكنولوجي يهدف إلى استكشاف الفضاء الخارجي)",
 "うちゅうこうがく": "مِلَاحَة فَضَائِيَّة",
 "うちゅうしんかろん": "علم الكون, نشأة الكون (فرع الفيزياء الفلكية الذي يدرس أصل وتطور وبنية الكون)",
 "うちゅうじだい": "عَصْر اَلْفَضَاء (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "うちゅうじょうやく": "فَضَاء خَارِجِيّ (فَضَاء)\nمثال: الفضاء مليئ بالغموض.",
 "うちゅうじん": "غَرِيب, غَرِيبَة\nمثال: みんな宇宙人になったつもりで。 — لنتظاهر بأننا مخلوقات فضائية. / غبار كوني (سحب من الجسيمات أو الغازات توجد في جميع أنحاء الفضاء بين النجمي)",
 "うちゅうせいぶつがく": "بيولوجيا الفضاء, علم الأحياء الفلكي (فرع علم الأحياء المعني بتأثيرات الفضاء الخارجي على الكائنات الحية والبحث عن…)",
 "うちゅうせきりょく": "طاقة مظلمة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة…)\nمثال: طلب بطاقة اعتماد.",
 "うちゅうせん": "أشعة كونية (إشعاع مؤين عالي الاختراق من أصل خارج الأرض؛ يتكون بشكل رئيسي من بروتونات…) / سَفِينَةٌ فَضَائِيَّة, مَرْكَبَةٌ فَضَائِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
