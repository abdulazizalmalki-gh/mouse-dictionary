{
 "いっぺんに": "حَالاً (مباشرةً، فوراً، دون تأخير؛ في هذه الأثناء، في الوضع الحالي)\nمثال: سأكون معك حالا. / فَوْرًا, حَالًا",
 "いっぽ": "خُطْوَة, خَطْوَة\nمثال: もう一歩も歩けないよ。 — لا يمكنني المشي خطوة أخرى. / مُسْتَوًى",
 "いっぽいっぽ": "خُطْوَةً خُطْوَةً, خُطْوَةً بِخُطْوَةٍ",
 "いっぽう": "مَعْلُومَات, مَعْلُومَة / وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة. / من جهة, من ناحية (من وجهة نظر واحدة)\nمثال: من ناحية، هي كيميائية موهوبة / عِنْدَمَا",
 "いっぽうこうつう": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "いっぽうそのころ": "أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ)\nمثال: أما زلت تذكرني؟",
 "いっぽうつうこう": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "いっぽうてき": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط)\nمثال: شلل أحادي الجانب",
 "いっぽずつ": "بشكل متدرج, خطوة بخطوة (المضي في خطوات)\nمثال: تم زيادة الجهد بشكل متدرج",
 "いっぽん": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة)\nمثال: يداك أوكتا وفوك نفخ / غَيْشَا / أُحَادِيُّ الْهَدَفِ, مُصَمِّمٌ (مُصَمِّم ومُنصَبّ على هدف واحد)",
 "いっぽんか": "تَوْحِيد",
 "いっぽんぎ": "أُحَادِيُّ الْهَدَفِ, مُصَمِّمٌ (مُصَمِّم ومُنصَبّ على هدف واحد)",
 "いっぽんぐそ": "نَقَانِقِيُّ الشَّكْل (على شكل النقانق)",
 "いっぽんぜおい": "أَحَادِيّ الذِّرَاع (ذو ذراع واحدة فقط)",
 "いっぽんだち": "اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع…)\nمثال: الصحراويون يريدون الاستقلال.",
 "いっぽんちょうし": "أُحَادِيُّ النَّغْمَة, رَتِيب (يُنْطَقُ أَوْ يُسْمَعُ بِنَغْمَةٍ ثَابِتَةٍ لَا تَتَفَاوَتُ فِي الطَّبَقَة)",
 "いっぽんぢょうし": "أُحَادِيُّ النَّغْمَة, رَتِيب (يُنْطَقُ أَوْ يُسْمَعُ بِنَغْمَةٍ ثَابِتَةٍ لَا تَتَفَاوَتُ فِي الطَّبَقَة)",
 "いっぽんとられた": "مَلْمُوس",
 "いっぽんとる": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "いっぽんゆび": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "いつ": "خَمْسَة, خمسة (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال. / باعث على الاسترخاء, مريح (يوفر راحة جسدية أو عقلية)\nمثال: قضت ليلة مريحة في المنزل / تَجَمَّدَ / وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة. / نَفْسَهُ, نَفْسَهَا",
 "いついつ": "مَتَى",
