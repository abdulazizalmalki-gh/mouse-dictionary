 "うでくらべ": "مُسَابَقَة",
 "うでこき": "قَادِر (الذي له قُدْرَة أو مقدرة؛ القويّ المتمكن؛ الذي يَقْدُر الأمور أي يقيسها ويُهيأها)\nمثال: سامي قادر على هذا.",
 "うでずく": "بِالقُوَّة, قَسْرِيّ (مدفوع بالقوّة الجسدية خاصة ضدّ المقاومة)",
 "うでずもう": "مُصَارَعَة ذراعية",
 "うでたて": "تَمْرِين اَلضَّغَط",
 "うでたてふせ": "تَمْرِين اَلضَّغَط",
 "うでぢから": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة.",
 "うでっこき": "قَادِر (الذي له قُدْرَة أو مقدرة؛ القويّ المتمكن؛ الذي يَقْدُر الأمور أي يقيسها ويُهيأها)\nمثال: سامي قادر على هذا.",
 "うでづく": "بِالقُوَّة, قَسْرِيّ (مدفوع بالقوّة الجسدية خاصة ضدّ المقاومة)",
 "うでどけい": "ساعة يد (ساعة تلبس مربوطة حول المعصم)",
 "うでぬき": "سِوَار",
 "うでのいい": "مَاهِر",
 "うでのさえ": "براعة يدوية, خفة يد (البراعة في استخدام اليدين)",
 "うでのよい": "مَاهِر",
 "うでまえ": "قُدْرَة, مَقْدِرَة / مَوْهِبَة",
 "うでる": "دُمَّل, خُرَاج / غَلَيَان, غَلْي / غَلَّى",
 "うでわ": "سِوَار",
 "うでわたり": "تأرجح بالذراعين (التأرجح بالذراعين من غصن إلى غصن (عند القرود))",
 "うと": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "うとい": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا. / جَاهِل",
 "うとう": "يَمِينِيّ",
 "うとうとしい": "عدائي, غير ودود (غير ميال للصداقة أو الود) / صعب الاستخدام, غير صديق للمستخدم (ليس سهلاً في الفهم أو الاستخدام) / غَيْر مُلَائِم, مُعَادٍ (غير ملائم للحياة أو النموّ إطلاقاً) / غَيْر وُدِّيّ, مُعَادٍ (ليس ودِّيّاً؛ يتَّسم بالجفاء)\nمثال: برود في التصرف غير ودود",
 "うとく": "فَاضِل",
 "うとそうそう": "الْوَقْتُ يَمْضِي",
 "うとましい": "بَغِيض, غَيْر مَقْبُول (ليس على هواك) / غَيْرُ مُتَعَاطِفٍ, مُنَفِّر (لَا يَتَّفِقُ مَعَ أَذْوَاقِكَ أَوْ تَوَقُّعَاتِكَ) / بَغِيض, كَرِيه المُعَاشَرَة (غير سار في التعامل معه)\nمثال: موقف بغيض",
 "うとむ": "تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "うとんじる": "تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "うとんずる": "تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "うどんげ": "شبكية الأجنحة الخضراء (ذبابة شبكية الأجنحة خضراء شاحبة كريهة الرائحة لها يرقات آكلة للحوم)",
 "うどんこびょう": "بياض دقيقي (أي من الفطريات المختلفة من جنس إري سيفي تنتج كونيديا مسحوقية على سطح العائل)",
 "うどんこ病": "بياض دقيقي (أي من الفطريات المختلفة من جنس إري سيفي تنتج كونيديا مسحوقية على سطح العائل)",
 "うどん粉病": "بياض دقيقي (أي من الفطريات المختلفة من جنس إري سيفي تنتج كونيديا مسحوقية على سطح العائل)",
 "うな": "أَنْقَلِيس, أَنْكَلِيس",
 "うながす": "حَثَّ (حثّ الشّخصَ:أعجله ، حثّه على الشّيء:حضّه عليه ، شجّعه؛ حثَّه علَيْه :حَضَّهُ عَلَيْهِ، ونَدَبَه لَهُ وإِليه)\nمثال: بحث عن المفتاح. / أَحْيَا / سَرَّعَ (سَرُعَ يَسْرُعُ سَراعَة، وسُراعَة، وَسِرْعًا: سَرِع؛ فهو سَريعٌ. والجمع: سِراعٌ، وسُرْعَانٌ)\nمثال: اركض بأقصى سرعة.",
 "うなぎ": "أَنْقَلِيس, أَنْكَلِيس",
 "うなぎのぼり": "طيران شراعي (نشاط الطيران بطائرة شراعية) / بَاسِق, سَامِق (ذو ارتفاع مهيب؛ خاصَّة يبرز فوق غيره) / صَاعِد, مُتَصَاعِد (يصعد إلى مستوى أعلى بكثير من المعتاد)",
 "うなぎ上り": "طيران شراعي (نشاط الطيران بطائرة شراعية) / بَاسِق, سَامِق (ذو ارتفاع مهيب؛ خاصَّة يبرز فوق غيره) / صَاعِد, مُتَصَاعِد (يصعد إلى مستوى أعلى بكثير من المعتاد)",
 "うなぎ登り": "طيران شراعي (نشاط الطيران بطائرة شراعية) / بَاسِق, سَامِق (ذو ارتفاع مهيب؛ خاصَّة يبرز فوق غيره) / صَاعِد, مُتَصَاعِد (يصعد إلى مستوى أعلى بكثير من المعتاد)",
 "うなじ": "قَفًا",
 "うなずき": "أَوْمَأَ, أَوْمَأَ بِرَأْسِهِ (أومأ إليه/أومأ له٬ أشار إليه بيده أو بعينه أو بحاجبه أو برأسه أو غيرها، كدلالة على الموافقة أو المعرفة) / إِيمَاءَة, هَزَّة\nمثال: أومأ زيري بنعم.",
 "うなずく": "أَوْمَأَ, أَوْمَأَ بِرَأْسِهِ (أومأ إليه/أومأ له٬ أشار إليه بيده أو بعينه أو بحاجبه أو برأسه أو غيرها، كدلالة على الموافقة أو المعرفة) / إِيمَاءَة, هَزَّة\nمثال: أومأ زيري بنعم.",
 "うなぞこ": "قاع البحر, قاع المحيط (الجزء السفلي من بحر أو محيط)\nمثال: 海の植物は海底に付着して育つ。 — النباتات البحرية تنمو في قاع البحر. / تَحْتَ بَحْرِيّ, غَوَّاصِيّ (تحت سطح البحر)",
 "うなづく": "أَوْمَأَ, أَوْمَأَ بِرَأْسِهِ (أومأ إليه/أومأ له٬ أشار إليه بيده أو بعينه أو بحاجبه أو برأسه أو غيرها، كدلالة على الموافقة أو المعرفة) / إِيمَاءَة, هَزَّة\nمثال: أومأ زيري بنعم.",
 "うなはら": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "うなばら": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "うなめ": "بَقَرَة, بقرة (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى) / بَقَرَة, بَقَر (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى)\nمثال: زيري لديه بقرة.",
 "うなり": "آهَة, أَنِين / تَأَوَّهَ, أَنَّ (قَالَ آه؛ تَحَسَّرَ، تَنَهَّدَ) / زَمْجَرَة (اِسْمٌ لِصَوْتِ الأَسَد) / قَرْقَرَة / هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل . / نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته.",
 "うなりごえ": "آهَة, أَنِين / تَأَوَّهَ, أَنَّ (قَالَ آه؛ تَحَسَّرَ، تَنَهَّدَ) / زَمْجَرَة (اِسْمٌ لِصَوْتِ الأَسَد) / قَرْقَرَة / هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل .",
 "うなり声": "آهَة, أَنِين / تَأَوَّهَ, أَنَّ (قَالَ آه؛ تَحَسَّرَ، تَنَهَّدَ) / زَمْجَرَة (اِسْمٌ لِصَوْتِ الأَسَد) / قَرْقَرَة / هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل .",
 "うなる": "آهَة, أَنِين / تَأَوَّهَ, أَنَّ (قَالَ آه؛ تَحَسَّرَ، تَنَهَّدَ) / أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟ / هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل . / فَيَضَان / فَاضَ",
 "うなるほど": "بثقل, بشكل كبير (بدرجة كبيرة)\nمثال: اعتمد بشكل كبير على بيانات الآخرين",
 "うなる程": "بثقل, بشكل كبير (بدرجة كبيرة)\nمثال: اعتمد بشكل كبير على بيانات الآخرين",
 "うにうに": "بلا هدف (بدون هدف)\nمثال: تجول بلا هدف",
 "うにどん": "قُنْفُذ البَحْر",
 "うに丼": "قُنْفُذ البَحْر",
 "うぬ": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "うぬぼれ": "خلاء, غرور (سمة كون المرء مغروراً ومعجباً بنفسه بشكل مفرط؛ كبرياء زائف) / خيال جامح, صورة بلاغية مبتكرة (أداة أو تأثير فني) / تعبير بارع (تعبير ذكي أو مبتكر) / صورة شعرية متكلفة (صورة شعرية معقدة أو مقارنة بعيدة المنال لأشياء متباينة جداً)",
 "うぬら": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "うね": "سلسلة جبال / ضِلْع",
 "うねうね": "تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "うねくる": "تَعَرَّجَ",
 "うねま": "ثَلْم (ثلَم الإناءَ: كسر حرفَه؛ ثلَم الحائطَ: أحدث خلل أو شقّ في الحائط)",
 "うねめのしょう": "عَالِيّ الرُتْبَة",
 "うねり": "تموج, موجة ((في الفيزياء) حركة صعود وهبوط أو جيئة وذهاباً) / تموج (حركة تشبه الموج؛ ارتفاع وانخفاض لطيف بطريقة الأمواج) / تموج, موجة (منحنى متموج) / اِنْتَفَخَ, وَرِمَ",
 "うねる": "رِيح, ريح / لَفَّ / مُتَمَوِّج (ذو حافة متموّجة وسطح مُجَعَّد)",
 "うのう": "الدماغ الأيمن, نصف الكرة الأيمن (نصف الكرة المخية إلى يمين الجسم الثفني الذي يتحكم في النصف الأيسر من الجسم)",
 "うのはな": "توفو, خثرة الفول (طعام يشبه الجبن مصنوع من حليب فول الصويا المتخثر) / دوتزية (أي من الشجيرات المختلفة من جنس دوتزية ذات أوراق متقابلة مسننة عادة ولحاء مقشر وزهور بيضاء أو وردية في عناقيد طرفية فضفاضة)",
 "うのみ": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو",
 "うのみにする": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو",
 "うの花": "توفو, خثرة الفول (طعام يشبه الجبن مصنوع من حليب فول الصويا المتخثر) / دوتزية (أي من الشجيرات المختلفة من جنس دوتزية ذات أوراق متقابلة مسننة عادة ولحاء مقشر وزهور بيضاء أو وردية في عناقيد طرفية فضفاضة)",
 "うは": "الجناح اليميني, اليمين (أولئك الذين يدعمون المحافظة السياسية أو الاجتماعية أو الاقتصادية؛ أولئك الذين يعتقدون أن الأمور أفضل إذا تركت دون تغيير)",
 "うはうは": "مَسْرُور, مُنْتَشٍ (شَعَرَ بِالبَهْجَةِ وَالسُّرُور)",
 "うば": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة.",
 "うばいあい": "تَهَافَتَ",
 "うばいかえす": "استرداد, استعادة (فعل استعادة شيء ما) / استرداد الأرباح (استيلاء قانوني من قبل الحكومة على الأرباح التي تتجاوز مبلغاً ثابتاً)",
 "うばいとる": "سَلَبَ, نَهَبَ ((سَلَبَ) الشيء سلبا: انتزعه قهرا؛ (سَلَبَ) ت فلانة فؤاده أو عقله: استهوته واستولت عليه)\nمثال: لقد سلب مني كل شيء.",
 "うばう": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي. / اِتَّسَعَ, اِحْتَوَى / اِمْتَصَ, تَشَرَّبَ / اِحْتَلَّ, شَغَلَ (الموضعَ: نزل به وكان لغيره قبله؛ الجيشُ البلدَ: فتحها ثم نزل بها غصبا عن أهلها وبلا رضاهم، استولى عليها) / اِسْتَنْفَدَ / اِسْتَوْعَبَ, وَعَى / دَفَعَ, تَحَمَّلَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "うばぐるま": "عربة أطفال (مركبة صغيرة بأربع عجلات يدفع فيها الرضيع أو الطفل)",
 "うばざめ": "قرش متشمس (قرش شمالي كبير غير ضار يتغذى على العوالق؛ غالباً ما يسبح ببطء أو يطفو على سطح البحر)",
 "うばたま": "أبنوسي, أسود حالك (أسود داكن جداً) / بيوت, ميسكالين (القلويد المهلوس الذي هو العامل النشط في أزرار الميسكال) / بيوت, مسكال (صبار صغير عديم الأشواك كروي الشكل؛ مصدر لأزرار المسكال)",
 "うばん": "نَصْل الرِّيشَة (الجزء المسطح الشبيه بالشبكة من الريشة المكون من سلسلة من الأسلات على جانبي القصبة) / ريشة, شفرة (سطح مسطح يدور ويدفع ضد الهواء أو الماء) / ريشة توجيه, زعنفة (زعنفة مثبتة بذيل سهم أو قنبلة أو صاروخ لتثبيته أو توجيهه) / دوارة الرياح, ريشة الطقس (جهاز ميكانيكي مثبت على هيكل مرتفع؛ يدور بحرية لإظهار اتجاه الرياح)",
 "うば車": "عربة أطفال (مركبة صغيرة بأربع عجلات يدفع فيها الرضيع أو الطفل)",
 "うひゃ": "قَهْقَهَ / اِفْتِرَار, اِنْكِلَال",
 "うひゃひゃ": "قَهْقَهَ / اِفْتِرَار, اِنْكِلَال",
 "うひゃひゃひゃ": "قَهْقَهَ / اِفْتِرَار, اِنْكِلَال",
 "うひゃひゃひゃひゃ": "قَهْقَهَ / اِفْتِرَار, اِنْكِلَال",
 "うひょ": "عَجَبًا / سُبْحَانَ الله (مصدر للفعل سَبَحَ؛ تُقال حصرًا للَّٰه، كما في العبارة \"سُبْحَانَ اللَّٰهِ\")\nمثال: سبحان الله عما يشركون.",
 "うひょー": "عَجَبًا / سُبْحَانَ الله (مصدر للفعل سَبَحَ؛ تُقال حصرًا للَّٰه، كما في العبارة \"سُبْحَانَ اللَّٰهِ\")\nمثال: سبحان الله عما يشركون.",
 "うぶ": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "うぶい": "بَرِيء, بَرِيئَة / بَرِيء",
 "うぶげ": "تَحْتَ, تَحْت (أَقَلَّ) / حَتَى, إِلَى (يفيد انتهاء الغاية؛ يفيد الغاية) / سقط (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / زَغَب\nمثال: أنا تحت الشجرة. / زَغَبُ الجَنِين (الشعر الزغبي الناعم الذي يغطي الجنين البشري؛ يسقط عادة خلال الشهر التاسع من الحمل)",
 "うぶご": "مَوْلُود حَدِيث, مَوْلُودَة حَدِيثة",
 "うぶごえをあげる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "うぶだし": "إطلاق, تدشين (فعل البدء بشيء جديد)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "うぶんぼく": "آبَنُوس",
 "うぶ毛": "تَحْتَ, تَحْت (أَقَلَّ) / حَتَى, إِلَى (يفيد انتهاء الغاية؛ يفيد الغاية) / سقط (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / زَغَب\nمثال: أنا تحت الشجرة. / زَغَبُ الجَنِين (الشعر الزغبي الناعم الذي يغطي الجنين البشري؛ يسقط عادة خلال الشهر التاسع من الحمل)",
 "うぷ": "حَمّل (رَفَعَ، أَقَلَّ) / تَحْمٍيْل\nمثال: حمل سامي سلاحه.",
 "うへい": "قصبة الريشة (العمود الفقري المجوف للريشة) / عود الوج, قصب الذريرة (نبات مستنقعات معمر ذو أوراق تشبه السيف وجذور عطرية) / قصب الذريرة (الجذر العطري لنبات الوج المستخدم طبياً) / كلاموس, نخيل القصب (أي نخيل آسيوي استوائي من جنس كلاموس؛ سيقانه الخفيفة القوية مصدر لعيدان الروتان)",
 "うへっ": "صيحة ابتهاج (صيحة عالية تعبر عن الابتهاج أو الإثارة) / تجرع, عب (بلعة كبيرة وسريعة) / بلع, تجرع (منعكس تشنجي للحلق وكأنه في حالة بلع)\nمثال: أنهاه بجرعة واحدة / يَع",
 "うへん": "عامل مطلق, هرمون مطلق (أي من عدة هرمونات تنتج في الهايبوتلاموس وتحمل إلى الغدة النخامية الأمامية حيث تحفز إطلاق هرمونات الغدة النخامية الأمامية) / روديوم (عنصر فلزي صلب أبيض من مجموعة البلاتين ويوجد في خامات البلاتين) / العامل الرايزيسي, عامل ريزوس (مستضد فصيلة الدم يمتلكه الأشخاص إيجابيو العامل الرايزيسي)",
 "うべ": "بصدق, حقاً (وفقاً للحقيقة أو الواقع) / بصدق, حقاً (في الواقع (تستخدم للتوكيد أو تعديل الجملة)) / بِجَدَارَة, بِحَقّ (بموجب الحق أو الشرعية) / بإخلاص, بصدق (بصدق؛ دون تصنع)\nمثال: أصبحت الآن أمريكية حقاً",
 "うべなう": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "うべん": "ويب",
 "うほうたん": "يَمِين, يُمْنَى",
 "うほうほ": "فِي نَشْوَة, مُفْعَمٌ بِالحَيَوِيَّة (سَعِيدٌ وَمُتَحَمِّسٌ وَنَشِيط)",
 "うぼう": "أذين أيمن (الحجرة العلوية اليمنى للقلب التي تتلقى الدم من الأوردة الجوفاء والجيب التاجي)",
 "うぼく": "آبَنُوس",
 "うま": "حِصَان, فَرَس (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: لم يشفى الحصان. / جَنُوب (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب) / جنوب (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب) / جَنوب (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب. / حِصَان, فَرَس (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: لم يشفى الحصان. / سباق الخيل (رياضة سباق الخيول) / فَارِس (اسم فاعل لفَرَسَ؛ راكب الفَرَس أو الحِصَان) / حِصَان, فَرَس (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: فارس الظلام فيلم جيد.",
 "うまあぶ": "نبرة الخيل (طفيلية بشكل رئيسي على الخيول)",
 "うまい": "مَاهِر, حَاذِق / لَذِيذ / شَهِيّ / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "うまいくさ": "فَارِس, سِلَاح الفُرْسَان (اسم فاعل لفَرَسَ؛ راكب الفَرَس أو الحِصَان)\nمثال: فارس الظلام فيلم جيد.",
 "うまいぐあいに": "لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "うまいこと": "بِنَجَاحٍ",
 "うまいしゃ": "طبيب خيول (طبيب بيطري يعالج الخيول)",
 "うまいしる": "حِصَّةُ الأَسَد",
 "うまいな": "سلق, سلق سويسري (سيقان بيضاء طويلة عصارية ذات أوراق خضراء كبيرة) / سلق, سلق سويسري (شمندر يفتقر إلى الجذر المتضخم؛ يزرع كخضروات لأوراقه وسيقانه الصالحة للأكل)",
 "うまい具合に": "لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "うまい汁": "حِصَّةُ الأَسَد",
 "うまい菜": "سلق, سلق سويسري (سيقان بيضاء طويلة عصارية ذات أوراق خضراء كبيرة) / سلق, سلق سويسري (شمندر يفتقر إلى الجذر المتضخم؛ يزرع كخضروات لأوراقه وسيقانه الصالحة للأكل)",
 "うまうま": "بِنَجَاحٍ / طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "うまがる": "مذاق, نكهة (تجربة التذوق عند وضع طعام متبل في الفم) / تلذذ, شغف (استمتاع قوي ومتحمس) / ريليش, مقبلات مخللة (تابل حار أو لذيذ)",
 "うまく": "ببراعة, بمهارة (بمهارة وحذق)\nمثال: شظايا إبريق شبه كامل، تم ترميمها بمهارة في معهد الآثار / بِنَجَاحٍ / بِشَكْل مُبْهِج, بِلَذَّة (بطريقة ممتعة للغاية) / بشكل شهي, بلذة (بطريقة تنتج طعماً لذيذاً)\nمثال: كانا يمشيان على الشاطئ ببطء ومتعة",
 "うまくさ": "عَلَف",
 "うまくら": "سَرْج, سرج ((سَرَجَ) فلان سرجا: كذب. ويقال سرج فلان الكذب؛ (سَرَجَ)ت المرأة شعرها: ضفرته)",
 "うまぐり": "قسطل الحصان, كستناء الحصان (شجرة ذات أوراق راحية وعناقيد كبيرة من الزهور البيضاء إلى الحمراء تليها بذور بنية لامعة غير صالحة للأكل) / كستناء الحصان (البذرة غير الصالحة للأكل التي تشبه الجوز لكستناء الحصان)",
 "うまぐるま": "عَرَبَة / مُدَرِّب, مُدَرِّبَة / حافلة السفر, حافلة النقل الخارجي (وسيلة نَقْل للركاب)\nمثال: لنذهب بالحافلة.",
 "うまぐわ": "جَرّافَة, كَاسِحَة",
 "うまげ": "قماش شعر الخيل (قماش مصنوع من الألياف المأخوذة من عرف أو ذيل الخيل؛ يستخدم للتنجيد) / شعر الخيل (الشعر المأخوذ من عرف أو ذيل الحصان)",
 "うまごや": "حَظِيرَة, اِسْطَبْل / زَرِيبَة / ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "うまごやし": "نفل أبيض, نفل زاحف (نفل أوروبي زاحف ذو أزهار بيضاء إلى وردية وأوراق خضراء زاهية؛ متوطن في الولايات المتحدة؛ يزرع على نطاق واسع كعلف)",
 "うまさけ": "مُرْتَفِع الدَّرَجَة",
 "うまざけ": "مُرْتَفِع الدَّرَجَة",
 "うましか": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "うまずたゆまず": "بشكل دؤوب, بلا كلل (بطاقة لا تكل)\nمثال: شاهدت العرض بلا كلل",
 "うまとび": "قفزة الضفدع, نط الحبل (لعبة ينحني فيها طفل ويقفز آخر من فوقه) / تجاوز, قفزة (التقدم كما في لعبة الأطفال، بالقفز فوق العقبات أو المنافسين)\nمثال: لا تزال الشركة تعتقد أن الرقاقة تمثل قفزة في التكامل وستحقق أرباحاً طائلة",
 "うまとり": "سَائِس / هَندَم",
 "うまのあしがた": "حَوْذَان",
 "うまのすずくさ": "زَرَاوَنْد",
 "うまのせ": "سلسلة جبال",
 "うまのほね": "أصل, سلالة (الاشتقاق الوراثي للفرد) / أُبُوَّة وَأُمُومَة, وِلَادَة (علاقة القرابة بين النسل والوالدين) / أبوة أو أمومة, والدية (حالة كونه والداً)",
 "うまのり": "ركوب الخيل (السفر محمولاً على ظهر الخيل) / ركوب الخيل, فروسية (رياضة الجلوس على ظهر الحصان مع التحكم في تحركاته) / اِمْتَطَى",
 "うまばえ": "نبرة الخيل (طفيلية بشكل رئيسي على الخيول)",
 "うまひと": "أَرِسْتُقْرَاطِيّ, أَرِسْتُقْرَاطِيَّة",
 "うまふぶき": "أرقطيون كبير, لزيق (أرقطيون بأوراق على شكل قلب يوجد في الغابات المفتوحة والأسيجة والمراعي الوعرة في أوروبا (باستثناء أقصى الشمال) وآسيا الصغرى؛ يزرع أحياناً للاستخدام…)",
 "うまみ": "لَذَّة / أُومَامِي / مَهَارَة / رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "うまや": "حَظِيرَة, اِسْطَبْل / زَرِيبَة / ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة. / محطة البريد, نزل البريد (نزل لتبادل خيول البريد واستيعاب الفرسان)",
 "うまやごえ": "سَمَّدَ ((سَمَدَ) يَسْمُدُ سُمُودًا: عَلاَ؛ (سَمَدَ): رفع رأْسه ونَصَبَ صَدرَه) / رَوْث, سَمَاد",
 "うまる": "فَيَضَان / فَاضَ",
 "うまれ": "وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "うまれおちる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "うまれかわり": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / عصر النهضة, نهضة (إحياء التعلم والثقافة) / انبعاث, تناسخ الأرواح (ولادة ثانية أو جديدة) / تناسخ الأرواح (بعد الموت تبدأ الروح دورة جديدة من الوجود في جسم بشري آخر)",
 "うまれがいい": "كَرِيم الأَصْل, نَبِيل المَحْتِد (مِنْ نَسَبٍ رَفِيعٍ أَوْ سُلَالَة عُلْيَا)",
 "うまれがよい": "كَرِيم الأَصْل, نَبِيل المَحْتِد (مِنْ نَسَبٍ رَفِيعٍ أَوْ سُلَالَة عُلْيَا)",
 "うまれそこない": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "うまれたて": "مَوْلُود حَدِيث, مَوْلُودَة حَدِيثة",
 "うまれたばしょ": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "うまれついて": "طَبِيعِيّ",
 "うまれつき": "بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: كان كسولاً بطبعه",
 "うまれつく": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "うまれてくる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "うまれてこのかた": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "うまれでる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "うまれどころ": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "うまれながら": "بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: كان كسولاً بطبعه",
 "うまれのいい": "كَرِيم الأَصْل, نَبِيل المَحْتِد (مِنْ نَسَبٍ رَفِيعٍ أَوْ سُلَالَة عُلْيَا)",
 "うまれのよい": "كَرِيم الأَصْل, نَبِيل المَحْتِد (مِنْ نَسَبٍ رَفِيعٍ أَوْ سُلَالَة عُلْيَا)",
 "うまれび": "عِيد مِيلَاد / يَوْم مِيلَاد (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "うまれる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "うまれ変わり": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / عصر النهضة, نهضة (إحياء التعلم والثقافة) / انبعاث, تناسخ الأرواح (ولادة ثانية أو جديدة) / تناسخ الأرواح (بعد الموت تبدأ الروح دورة جديدة من الوجود في جسم بشري آخر)",
 "うみ": "بَحْر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا) / يَمّ (البَحْر) / بَحَر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا) / بحر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر. / قَيْح, صَدِيد / فَسَاد / وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "うみあいさ": "بلقشة حمراء الصدر (بلقشة واسعة الانتشار في أمريكا وأوروبا)",
 "うみうし": "بزاق البحر, عاريات الخياشيم (أي من بطنيات القدم البحرية المختلفة من رتيبة عاريات الخياشيم التي لها جسم عديم الصدفة وغالباً ما يكون ملوناً بشكل جميل)",
 "うみうそ": "أَسَد بَحْر, كَلْب البَحْر (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة)\nمثال: الأسد حيوان بري.",
 "うみうま": "حصان البحر (سمكة صغيرة برأس يشبه الحصان ينحني بحدة للأسفل وذيل ملتف؛ تسبح في وضع عمودي) / فظ (أي من ثدييين بحريين شماليين كبيرين لهما أنياب عاجية وجلد قوي فوق دهن سميك)",
 "うみえら": "قلم البحر (مستعمرات لحمية تشبه الريش تعيش في المياه الدافئة)",
 "うみおそ": "أَسَد بَحْر, كَلْب البَحْر (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة)\nمثال: الأسد حيوان بري.",
 "うみおとす": "قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه.",
 "うみかぜ": "نسيم البحر (نسيم منعش من البحر (خلال النهار))",
 "うみがめ": "سلحفاة بحرية (أي من سلاحف كبيرة متنوعة ذات أطراف معدلة إلى زعانف؛ واسعة الانتشار في البحار الدافئة)",
 "うみがらす": "مور شائع (أكثر أنواع طائر المور شيوعاً)",
 "うみくさ": "نجيل بحري / عُشْب بَحْرِيّ",
 "うみぐさ": "نجيل بحري / عُشْب بَحْرِيّ",
 "うみぐも": "عنكبوت البحر (أي من المفصليات البحرية الصغيرة المختلفة التي تشبه العناكب ولها أجسام صغيرة رفيعة وأرجل طويلة نحيلة)",
 "うみぐもるい": "عنكبوت البحر (أي من المفصليات البحرية الصغيرة المختلفة التي تشبه العناكب ولها أجسام صغيرة رفيعة وأرجل طويلة نحيلة)",
 "うみさそり": "عقرب البحر, يوريبتيريد (مفصلي منقرض كبير يشبه العقرب يعتبر مرتبطاً بسرطانات حدوة الحصان)",
 "うみさち": "مَأْكُولَات بَحْرِيَّة, طَعَام الْبَحْر",
 "うみざりがに": "كَرْكَنْد",
 "うみしだ": "نجم ريشي (كرينويد حر السباحة بدون ساق بعشرة أذرع ريشية؛ يوجد في قيعان البحر الطينية)",
 "うみしだもく": "نجم ريشي (كرينويد حر السباحة بدون ساق بعشرة أذرع ريشية؛ يوجد في قيعان البحر الطينية)",
 "うみしる": "قَيْح, صَدِيد",
 "うみじる": "قَيْح, صَدِيد",
 "うみぞい": "سَاحِل, شَاطِئ",
 "うみただれる": "تَقَيَّحَ",
 "うみたなご": "شوب البحر (أسماك تعيش في أسراب غالباً في المحيط الهندي وغرب المحيط الهادئ؛ نوعان في غرب المحيط الأطلسي)",
 "うみだす": "خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق. / اِخْتَرَعَ / دُبّ / دُبَّة / اِحْتَمَلَ",
 "うみだぬき": "قُنْدُس, سَمُّور",
 "うみっぺり": "سَاحِل, شَاطِئ",
 "うみつける": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "うみつばめ": "طائر النوء (أي من طيور النوء الصغيرة المتنوعة ذات الريش الداكن والأجزاء السفلية الشاحبة)",
 "うみどり": "طائر بحري (طائر يتردد على المياه الساحلية والمحيط المفتوح: النوارس، البجع، الأطيش، الغاق، القطرس، النوء، إلخ)",
 "うみのえき": "مارينا",
 "うみのおや": "مُؤَسِّس, مُؤَسِّسَة",
 "うみのくるしみ": "آلام المخاض (تشنج ألم متكرر بانتظام وهو سمة من سمات الولادة)",
 "うみのこ": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "うみのさち": "مَأْكُولَات بَحْرِيَّة, طَعَام الْبَحْر",
 "うみのものともやまのものともつかない": "لا السمك ولا الطيور (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "うみのものともやまのものともわからない": "لا السمك ولا الطيور (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "うみばと": "غلموت الحمام (غلموت شمال المحيط الهادئ)",
 "うみひごい": "مُخَطَّط بِالأَصْفَر (عليه خطوط صفراء اللون)",
 "うみへび": "ثعبان البحر (أي من الثعابين المائية السامة الولودة العديدة التي لها ذيل يشبه الزعنفة؛ من البحار الساحلية الدافئة؛ تتغذى على الأسماك التي تشلها بسم سريع المفعول)",
 "うみへびざ": "هِيدْرَا",
 "うみへび座": "هِيدْرَا",
 "うみべ": "شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة) المنطقة اليابسة على طول حافة النهر. ضِفَّة، جَانِب، شَطّ) / سَاحِل\nمثال: عاد إلى الشاطئ.",
 "うみほたる": "صدفيات (قشريات بحرية ومياه عذبة صغيرة بجسم يشبه الروبيان محاط بصدفة ذات مصراعين)",
 "うみぼうず": "سلحفاة خضراء (سلحفاة استوائية كبيرة ذات لحم مخضر يُستخدم في حساء السلاحف)",
 "うみます": "ترويت بحري (نوع بحري فضي اللون من الترويت البني يهاجر إلى المياه العذبة للتكاثر) / ترويت بحري (أي من عدة أسماك بهارية في المياه الساحلية لأمريكا الشمالية) / تراوت بحري (لحم التراوت البحري الذي يهاجر من المياه المالحة إلى العذبة)",
 "うみやつめ": "جلكى بحرية (جلكى كبيرة مهاجرة تستخدم أحياناً كغذاء؛ مدمرة لحيوانات الأسماك المحلية في البحيرات العظمى)",
 "うみやま": "عَمِيق, غَوِيط",
 "うみゆり": "زنبق البحر (كرينويد بأذرع مشعة دقيقة وجسم ذو ساق ملتصق بسطح صلب)",
 "うみわた": "إِسْفَنْج / سَفِنْج",
 "うみんちゅ": "صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "うみイグアナ": "إغوانة بحرية (سحلية تعيش على الشاطئ وتأكل الأعشاب البحرية في جزر غالاباغوس)",
 "うみガメ": "سلحفاة بحرية (أي من سلاحف كبيرة متنوعة ذات أطراف معدلة إلى زعانف؛ واسعة الانتشار في البحار الدافئة)",
 "うみザリガニ": "كَرْكَنْد",
 "うむ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل . / تَقَيَّحَ / وَلَدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه) / أَنْجَبَ\nمثال: أعرف ذلك الولد. / أَنْتَجَ, صَنَعَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت) / يَنَعَ, نَضَجَ (أَيْنَعَ؛ نَضَجَ) / رَدَنَ, غَزَلَ (رَدَنَ رَدْنًا: غزل الرَّدَن أو غزل بالمِردَن؛ ويقال: رَدَنَ الثوبَ: نسجه بالغزل المردون)",
 "うむあいつうじる": "عُمْدَة",
 "うむをいわさず": "بشكل آمر, بشكل حاسم (بطريقة آمرة وحاسمة)",
 "うむをいわせず": "بشكل آمر, بشكل حاسم (بطريقة آمرة وحاسمة)",
 "うめ": "مشمش ياباني (شجرة زينة يابانية بزهور بيضاء أو وردية عطرة وثمار صفراء صغيرة) / أَخِير, الأَدْنَى (الأدنى في الرتبة أو الأهمية) / في أدنى مستوى (في أدنى وضع؛ الأقرب إلى الأرض)\nمثال: الغصن الذي يحمل الدراق الكبير تدلى إلى أدنى مستوى",
 "うめあわす": "تراجع معماري, ردة الجدار (هيكل يضيق فيه الجدار أو المبنى بشكل مفاجئ) / أوفست, طباعة أوفست (يقوم لوح بعمل طبعة محبرة على أسطوانة مغطاة بالمطاط، والتي بدورها تنقلها إلى الورق) / فرع, نتاج طبيعي (عاقبة طبيعية للتطور) / رئد, ساق جارية (فرع أفقي من قاعدة النبات ينتج نباتات جديدة من براعم في أطرافه)",
 "うめあわせ": "تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / تعويض (شيء (مثل المال) يُعطى أو يُستلم كدفعة أو تعويض (كما هو الحال عن خدمة أو خسارة أو إصابة)) / تعويض ((في الطب النفسي) آلية دفاع تخفي عيوبك غير المرغوب فيها عن طريق المبالغة في السلوكيات المرغوبة)",
 "うめあわせる": "تراجع معماري, ردة الجدار (هيكل يضيق فيه الجدار أو المبنى بشكل مفاجئ) / أوفست, طباعة أوفست (يقوم لوح بعمل طبعة محبرة على أسطوانة مغطاة بالمطاط، والتي بدورها تنقلها إلى الورق) / فرع, نتاج طبيعي (عاقبة طبيعية للتطور) / رئد, ساق جارية (فرع أفقي من قاعدة النبات ينتج نباتات جديدة من براعم في أطرافه)",
 "うめぇ": "لَذِيذ / شَهِيّ / مَاهِر, حَاذِق",
 "うめえ": "لَذِيذ / شَهِيّ / مَاهِر, حَاذِق",
 "うめき": "تَأَوَّهَ (قَالَ آه؛ تَحَسَّرَ، تَنَهَّدَ)",
 "うめきごえ": "آهَة, أَنِين / تَأَوَّهَ, أَنَّ (قَالَ آه؛ تَحَسَّرَ، تَنَهَّدَ)",
 "うめき声": "آهَة, أَنِين / تَأَوَّهَ, أَنَّ (قَالَ آه؛ تَحَسَّرَ، تَنَهَّدَ)",
 "うめく": "تَأَوَّهَ (قَالَ آه؛ تَحَسَّرَ، تَنَهَّدَ)",
 "うめくさ": "حشوة (التبغ المستخدم لتشكيل لب السيجار) / تِكملة, حشو (أي شيء يضاف لإكمال الكل) / حشو, مادة لملء الفراغ (نسخة لملء الفراغ بين المقالات الأكثر أهمية في تخطيط مجلة أو صحيفة) / فيلر (100 فيلر تساوي 1 فورنت في المجر)\nمثال: بعض العناصر في المجموعة مجرد تكملة",
 "うめこみ": "زرع, غرس (إجراء جراحي يضع شيئاً ما في جسم الإنسان) / غرس (فعل الغرس أو الوضع في الأرض) / انغراس, تعشيش ((علم الأجنة) العملية العضوية التي تنغرس فيها البويضة المخصبة في بطانة الرحم لدى الثدييات المشيمية)\nمثال: زرع كريات مشعة في غدة البروستاتا",
 "うめこむ": "دَفَنَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه) / قَبَرَ (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: دفن القط فضلاته.",
 "うめごよみ": "زَهْرَة بَرْقُوق",
 "うめしそ": "مشمش ياباني (شجرة زينة يابانية بزهور بيضاء أو وردية عطرة وثمار صفراء صغيرة)",
 "うめしゅ": "اسكدنيا, مشمش هندي (فاكهة شبه استوائية صفراء بحجم الزيتون ذات نواة حرة كبيرة ولحم قليل نسبياً) / أسكدنيا, أكي دنيا (شجرة دائمة الخضرة في المناطق الدافئة لها فاكهة صفراء زغبية بحجم الزيتون مع نواة كبيرة حرة؛ موطنها الصين واليابان) / برقوق ياباني (شجرة صغيرة من الصين واليابان تحمل برقوقاً كبيراً أصفر إلى أحمر عادة ما يكون أقل جودة نوعاً ما من البرقوق الأوروبي في النكهة)",
 "うめじそ": "مشمش ياباني (شجرة زينة يابانية بزهور بيضاء أو وردية عطرة وثمار صفراء صغيرة)",
 "うめぞの": "مشمش ياباني (شجرة زينة يابانية بزهور بيضاء أو وردية عطرة وثمار صفراء صغيرة)",
 "うめたてる": "مَلَأَ",
 "うめつくす": "حُزْمَة, عُبُوَّة / وَضَّبَ / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: حزم ياني أمتعته.",
 "うめのみ": "مشمش ياباني (شجرة زينة يابانية بزهور بيضاء أو وردية عطرة وثمار صفراء صغيرة)",
 "うめもどし": "إعادة دفن (فعل الدفن مرة أخرى)",
 "うめもどす": "عبوة إعادة تعبئة, غيار (منتج تجاري يملأ حاوية بمحتوياتها المناسبة) / إعادة صرف, تجديد وصفة (دواء بوصفة طبية يتم توفيره مرة أخرى)\nمثال: حصل على عبوة حبر لقلمه الجاف",
 "うめる": "دَفَنَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه) / قَبَرَ (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: دفن القط فضلاته. / مَلَأَ / قَابِس / فِيشَة ((في العامية) قابس كهرباء) / بُوجِيه / دِسَام / سِدَاد / سِدَادَة / غِطَاء / غِلَاف / غَطَّى",
 "うめー": "لَذِيذ / شَهِيّ / مَاهِر, حَاذِق",
 "うもう": "رِيش, رِيشَة (رَيَّشَ السَّهْمَ: راشهُ؛ رَيَّشَ الثَّوْبَ: زَيَّنَهُ بِصُوَرِ الرِّيش)\nمثال: هل عنده ريشة رسم؟",
 "うもうふとん": "زَغَبُ العَيْدَر (زغب بط العيدر) / دوفيت, لحاف ريشي (لحاف ناعم محشو عادة بريش البط)",
 "うもうぶとん": "زَغَبُ العَيْدَر (زغب بط العيدر) / دوفيت, لحاف ريشي (لحاف ناعم محشو عادة بريش البط)",
 "うもれぎ": "تِين, بَلَس",
 "うもん": "مزخرف, منقوش (لديه نقوش (خاصة أنماط ملونة))",
 "うやうやしい": "أَدِيب, مُؤَدَّب",
 "うやまい": "تبجيل, تعظيم (عمل يظهر الاحترام (خاصة الانحناء)) / إجلال, توقير (موقف ذهني يتسم بالتبجيل والإجلال) / خشية, هيبة (شعور بالاحترام العميق لشخص أو شيء ما)\nمثال: خشية الله",
 "うやまう": "وَقَّرَ",
 "うやむや": "نَكِرَة",
 "うゆ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "うゆう": "عَدَم (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "うよ": "تَعَرَّجَ",
 "うよきょくせつ": "تَعَرَّجَ",
 "うよく": "الجناح اليميني, اليمين (أولئك الذين يدعمون المحافظة السياسية أو الاجتماعية أو الاقتصادية؛ أولئك الذين يعتقدون أن الأمور أفضل إذا تركت دون تغيير) / الحقل الأيمن (مركز اللعب للاعب في فريق البيسبول المتوقع منه التقاط الكرات في الثلث الأيمن من الملعب الخارجي) / يمين الملعب (قطعة الأرض في المنطقة الخارجية على يمين الماسك) / مُسَاعَدَة, إِمْدَاد",
 "うよくうんどう": "يَمِينِيّ",
 "うよくしゅ": "لاعب الدفاع الأيمن (الشخص الذي يلعب في الجانب الأيمن من الملعب الخارجي)",
 "うよくだんたい": "يَمِينِيّ",
 "うら": "ثَغْر, ثَغْر بَحْرِيّ (ثَغَرَ الجدارَ ونحوهَ يَثْغَرُ ثَغْرًا: أحدث فيه ثُلْمة؛ ثَغَرَ فلانًا: كسر أسنانه) / سَاحِل, شَاطِئ / عَرَافَة / طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة / قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما. / خَلْفِيّ / بِطَانَة\nمثال: 不幸の裏には幸いあり。 — رب ضارّةٍ نافعة. / مِن وَرَاءَ السِّتارِ, وَرَاءَ الكَوالِيسِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "うらあて": "دعم, مؤازرة (فعل تقديم الموافقة والدعم) / بطانة, دعامة خلفية (شيء يشكل ظهراً يضاف للتقوية) / تمويل, دعم مالي (الموارد المالية المقدمة لجعل مشروع ما ممكناً)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "うらあみ": "غرزة مقلوبة (غرزة حياكة أساسية مصنوعة بوضع الإبرة عبر الجزء الأمامي من الغرزة من الجانب الأيمن) / خيط مقصب, سلك ذهبي أو فضي (خيط سلكي من الذهب أو الفضة)",
 "うらいた": "سَقْف ((سَقَفَ) البيت ونحوه سقفا: عمل له سقفا)\nمثال: نظرت إلى السقف.",
 "うらうち": "بِطَانَة / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "うらうつり": "تراجع معماري, ردة الجدار (هيكل يضيق فيه الجدار أو المبنى بشكل مفاجئ) / أوفست, طباعة أوفست (يقوم لوح بعمل طبعة محبرة على أسطوانة مغطاة بالمطاط، والتي بدورها تنقلها إلى الورق) / فرع, نتاج طبيعي (عاقبة طبيعية للتطور) / رئد, ساق جارية (فرع أفقي من قاعدة النبات ينتج نباتات جديدة من براعم في أطرافه)",
 "うらおもて": "بِالْمَقْلُوبِ / ازدواجية, تعامل بوجهين (التصرف بسوء نية؛ الخداع بالتظاهر بامتلاك مجموعة من النوايا بينما يتصرف تحت تأثير أخرى) / ذُو وَجْهَيْن, مُرَاوِغ (يتَّسم بخداع متعمَّد خاصَّة بإظهار مشاعر والتصرُّف بمشاعر أخرى)",
 "うらかいどう": "طريق جانبي, طريق فرعي (طريق جانبي قليل الاستخدام (كما في الريف))",
 "うらかぜ": "نسيم البحر (نسيم منعش من البحر (خلال النهار))",
 "うらかた": "خَلْفَ الكَوَالِيس, سِرِّيّ (مُصَمَّمٌ وَمُنَفَّذٌ بِسِرِّيَّةٍ أَوْ بِشَكْلٍ سِرِّيّ)",
 "うらかわ": "شمواه, قماش شمواه (قماش مصنوع ليشبه جلد الشمواه) / جلد سويدي, شمواه (جلد ذو سطح وبري) / قطعة جلد (جزء منفصل مصنوع من الجلد)",
 "うらがえし": "بِالْمَقْلُوبِ / الوَجْه الآخَر (جانب مختلف لشيء ما (وخاصة الجانب المعاكس))\nمثال: الوجه الآخر لصفاتك الإيجابية هو أنها تخرج أحياناً عن السيطرة",
 "うらがえる": "خانَ (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / صَرِير / صَرَّ ((صَرَّ) يَصْرِرِ صَريرًا: صوَّتَ. يقال: (صَرَّ) العصفورُ والجُندُبُ، و(صَرَّ) القلم، و(صَرَّ) البابُ؛ (صَرَّتِ) الأُذنُ: كان لها طنين)\nمثال: لدى مايوكو حاسة بصر حادة.",
 "うらがき": "إقرار, تزكية (فعل المصادقة أو التزكية) / تظهير, مصادقة (توقيع يثبت صحة شيء ما) / إقرار, تأييد (موافقة رسمية وصريحة) / تأييد, تثنية (حديث لتأييد أو تثنية اقتراح ما)\nمثال: يمكن للرياضي النجم أن يجني الكثير من المال من عقود التزكية / تَعْلِيق, مَلْحُوظَة / عَلَّقَ / بُرْهَان, دَلِيل",
 "うらがききんしてがた": "غَيْر قَابِل لِلتَّدَاوُل (لا يمكن شراؤه أو بيعه)",
 "うらがきにん": "مُجَيِّر, مُظَهِّر (شخص ينقل ملكيته لشيء ما عن طريق التوقيع على شيك أو ورقة مالية قابلة للتداول) / مؤيد, مصادق (شخص يعبر عن موافقة قوية)",
 "うらがなしい": "حَزِين, زعلان / مُحْزِنٌ",
 "うらがね": "رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا. / أموال سرية, صندوق رشاوى (صندوق لشراء الأصوات أو رشوة المسؤولين الحكوميين)",
 "うらがれる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "うらがわ": "عَكَسَ / شمواه, قماش شمواه (قماش مصنوع ليشبه جلد الشمواه) / جلد سويدي, شمواه (جلد ذو سطح وبري) / قطعة جلد (جزء منفصل مصنوع من الجلد)",
 "うらき": "تاج الشجرة, قمة الشجرة (الفروع والأوراق العليا لشجرة أو نبات آخر)",
 "うらきど": "بَاب خَلْفِيّ (ما يُسَدُّ به مَدْخَل المَبْنَى أو الغُرْفَة أو المَرْكَبَة؛ (تعميم) مَدْخَل أي شيء؛ فُتْحَة)\nمثال: ظل الباب مغلقا.",
 "うらぎく": "أستر البحر, نجمة البحر (أستر أوروبي شائع ينمو في المستنقعات المالحة)",
 "うらぎり": "خيانة, غدر (فعل خيانة متعمد) / خِيَانَة, غَدْر (خيانة الأمانة)",
 "うらぎりもの": "خائن, غادر (شخص يقول شيئاً ويفعل شيئاً آخر) / مخبر, واشٍ (من يكشف معلومات سرية للشرطة أو سلطة أخرى)",
 "うらぎる": "خانَ (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / خَيَّبَ آمَالَهُ ((خَيَّبَ)و(خيبه): جعله خائبا وَحرمه وَلم ينله طلبه)\nمثال: خيبة أملها كانت جلية للجميع.",
 "うらぐち": "باب خلفي, وسيلة سرية (وسيلة سرية أو ملتوية للوصول (إلى مكان أو منصب)) / باب خلفي, مدخل خلفي (مدخل في الجزء الخلفي من المبنى) / باب خلفي, مدخل خلفي (طريقة غير موثقة للوصول إلى نظام حاسوب أو البيانات التي يحتوي عليها)\nمثال: حصل على وظيفته من الباب الخلفي / غَيْر مُخَوَّل, غَيْر مُصَرَّح بِه (غير ممنوح السلطة) / غَيْر مَأْذُون, غَيْر مُصَرَّح بِه (بدون تصريح أو إذن رسميّ)",
 "うらごえ": "فَالْسِيتُّو (عالي النبرة اصطناعيّاً؛ فوق المدى الصوتيّ الطبيعيّ) / صوت مستعار, فالسيتو (صوت غنائي ذكوري بنغمات عالية مصطنعة في سجل علوي)",
 "うらごし": "غِرْبَال, مِصْفاة / صَفَّى, غَرْبَلَ / هريس (اسم مفعول من هَرَسَ، وهو المدقوق دقا عنيفا حتى تفتت؛ اسم: طعام مصنوع من القَمْح المدقوق بقوة مخلوطا باللحم)",
 "うらごしき": "غِرْبَال, مِصْفاة / صَفَّى, غَرْبَلَ",
 "うらさ": "تِسْعَة, تسعة",
 "うらさびしい": "مُسْتَوْحِش, وَحِيد (يَتَّسِمُ بِالحُزْنِ النَّاجِمِ عَنِ الوَحْدَة)",
 "うらさみしい": "مُسْتَوْحِش, وَحِيد (يَتَّسِمُ بِالحُزْنِ النَّاجِمِ عَنِ الوَحْدَة)",
 "うらさん": "عصا التكهن, عصا الكشف عن المياه (عصا متشعبة يُزعم أنها تنحني لأسفل للإشارة إلى وجود مياه جوفية أو نفط)",
 "うらしまたろうじょうたい": "كثير النوم, نؤوم (شخص ينام كثيراً) / ريب فان وينكل (شخص غافل عن التغيرات الاجتماعية)",
 "うらしまつつじ": "عنب الدب الألبي, قطلب ألبي (شجيرة زاحفة متساقطة الأوراق تكون حمراء زاهية في الخريف ولها توت أسود أو أزرق مسود؛ ألبية وقطبية)",
 "うらしまはなこ": "كثير النوم, نؤوم (شخص ينام كثيراً) / ريب فان وينكل (شخص غافل عن التغيرات الاجتماعية)",
 "うらしゃかい": "سِجِّين, عَالَم سُفْلِيّ",
 "うらじ": "بِطَانَة\nمثال: どの雲にも銀の裏地がついている。 — رب ضارّةٍ نافعة.",
 "うらじじょう": "تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية",
 "うらじょうほう": "تَلْمِيح, طَرَف خَيْط (إشارة إلى فرصة محتملة)\nمثال: حصل على نصيحة حول سوق الأسهم",
 "うらじろはこやなぎ": "خشب الحور الأصفر, خشب الزنبق (خشب خفيف سهل العمل لشجرة الزنبق؛ يستخدم للأثاث والقشرة) / حور أبيض (حور يزرع على نطاق واسع في الولايات المتحدة؛ له لحاء أبيض وأوراق ذات أسطح سفلية بيضاء)",
 "うらす": "ضحضاح ماء",
 "うらせど": "بَاب خَلْفِيّ (ما يُسَدُّ به مَدْخَل المَبْنَى أو الغُرْفَة أو المَرْكَبَة؛ (تعميم) مَدْخَل أي شيء؛ فُتْحَة)\nمثال: ظل الباب مغلقا.",
 "うらっかわ": "عَكَسَ",
 "うらつき": "مُحَاط بِصَفّ (محدود بصف من الأشياء على جانبيه) / مبطن (يحتوي على بطانة؛ غالباً ما تستخدم في التركيبات) / مُجَعَّد, مُخَطَّط (ذو خطوط أو تجاعيد على السطح)\nمثال: تنورة مبطنة",
 "うらづけ": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "うらづける": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "うらて": "خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "うらとおり": "شارع جانبي (شارع يتقاطع مع شارع رئيسي وينتهي عنده)",
 "うらど": "باب خلفي, وسيلة سرية (وسيلة سرية أو ملتوية للوصول (إلى مكان أو منصب)) / باب خلفي, مدخل خلفي (مدخل في الجزء الخلفي من المبنى) / باب خلفي, مدخل خلفي (طريقة غير موثقة للوصول إلى نظام حاسوب أو البيانات التي يحتوي عليها)\nمثال: حصل على وظيفته من الباب الخلفي",
 "うらどおり": "شارع جانبي (شارع يتقاطع مع شارع رئيسي وينتهي عنده)",
 "うらどし": "سنة ركود سياسي (سنة لا تُجرى فيها انتخابات سياسية كبرى) / سنة ركود (سنة تكون فيها الإنتاجية منخفضة أو رديئة)",
