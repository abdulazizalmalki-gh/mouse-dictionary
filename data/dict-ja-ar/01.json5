 "うつらうつら": "بِنُعَاس, بِوَسَن (بطريقة ناعسة)\nمثال: 'حان وقت الاستيقاظ'، قالت بنعاس",
 "うつり": "إِسْقَاط\nمثال: دفنت في مسقط رأسها. / مُبَارَاة / تَحَوُّل, نَقِل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "うつりかわり": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "うつりかわる": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "うつりぎ": "مُتَقَلِّب, نَزَوِيّ (عرضة لتغيّرات مفاجئة وغير متوقّعة)",
 "うつりこむ": "ظَهَرَ (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "うつりすむ": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ…)\nمثال: لقد أوقفنا حركة المرور.",
 "うつりゆく": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "うつりん": "اِسْتَطَاعَ (أَطَاقَ الشَّيءَ وقَدَرَ عليه، أَمْكَنَهُ الشَّيءُ)\nمثال: توم استطاع ان يهرب",
 "うつる": "حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ…)\nمثال: لقد أوقفنا حركة المرور. / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل. / مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق. / خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "うつろ": "تَجْوِيف / أَجْوَف",
 "うつろい": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / توهين, خفوت (ضعف في القوة أو الشدة)\nمثال: توهين في حجم الصوت",
 "うつろう": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / اختفاء, تلاشٍ (التوقف التدريجي عن الظهور)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة",
 "うつわ": "زِبْدِيَّة / قُدْرَة, مَقْدِرَة",
 "うつわがおおきい": "رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح)",
 "うつわがちいさい": "غَيْر مُتَسَامِح, مُتَعَصِّب (ضَيِّق التَّفْكِير بِشَأْن آرَائِه الرَّاسِخَة)",
 "うつわのおおきい": "رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح)",
 "うつわのちいさい": "غَيْر مُتَسَامِح, مُتَعَصِّب (ضَيِّق التَّفْكِير بِشَأْن آرَائِه الرَّاسِخَة)",
 "うつわもの": "حاوية, مستوعب (حاوية تستخدم لوضع الأشياء أو حفظها بداخلها) / آنية, أداة منزلية (أداة للاستخدام العملي (خاصة في المنزل)) / جودة, عيار (درجة أو مرتبة من التميز أو القيمة)\nمثال: ارتفعت جودة الطلاب",
 "うつ伏す": "أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل))\nمثال: سامي من طبقة أدنى.",
