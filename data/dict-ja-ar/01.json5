 "うるう": "انسداد وعائي, انصمام (انسداد وعاء دموي بواسطة صمة (جلطة دموية أو فقاعة هواء أو جسيم آخر))",
 "うるうどし": "سَنَة كَبِيسَة (مقدارُ قطع الشمس البروجَ الاثني عشر ، وهي السنة الشمسيَّة، و السَّنَةُ تمامُ…)\nمثال: في عمره 24 سنة.",
 "うるうび": "29 فبراير, يوم كبيس (اسم اليوم الذي يُضاف خلال السنة الكبيسة)",
 "うるうびょう": "ثانية كبيسة (ثانية (كما تقاس بالساعة الذرية) تضاف أو تطرح من توقيت غرينتش للتعويض عن التباطؤ…)",
 "うるうる": "دَامِع العَيْنَيْن (عيناه مليئتان بالدموع) / رُطُوبة",
 "うるう年": "سَنَة كَبِيسَة (مقدارُ قطع الشمس البروجَ الاثني عشر ، وهي السنة الشمسيَّة، و السَّنَةُ تمامُ…)\nمثال: في عمره 24 سنة.",
 "うるう日": "29 فبراير, يوم كبيس (اسم اليوم الذي يُضاف خلال السنة الكبيسة)",
 "うるう秒": "ثانية كبيسة (ثانية (كما تقاس بالساعة الذرية) تضاف أو تطرح من توقيت غرينتش للتعويض عن التباطؤ…)",
 "うるおい": "رُطُوبَة / عَظَمَة, فَخَامَة (الروعة أو الهيبة في الحجم أو المظهر)\nمثال: عظمة العمارة / كَسَبَ / بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها)\nمثال: البركة عميقة جدا.",
 "うるおう": "رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ…)\nمثال: ربح زيري المال.",
 "うるおす": "مُبْتَلّ / رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ…)\nمثال: ربح زيري المال.",
 "うるかす": "اِبْتَلَّ",
 "うるさい": "صَارِخ, صاخِب / مُزْعِج / دَقِيق, مُتَطَلِّب (شَدِيد التَّدْقِيق خَاصَّةً فِي التَّفَاصِيل) / كَمَّمَ الفَمَ",
 "うるさがた": "تنطع, دقة مفرطة (سمة التدقيق المفرط في أمور الذوق أو الأسلوب)\nمثال: أناقة وتدقيق في الملابس",
 "うるさ型": "تنطع, دقة مفرطة (سمة التدقيق المفرط في أمور الذوق أو الأسلوب)\nمثال: أناقة وتدقيق في الملابس",
 "うるし": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان. / شجرة اللك, شجرة الورنيش (شجرة آسيوية صغيرة تفرز مادة سامة يتم الحصول منها على اللك (الورنيش))",
 "うるしかぶれ": "لَبْلَاب",
 "うるしざいく": "أشغال اللك (عمل زخرفي مصنوع من الخشب ومغطى باللك وغالباً ما يكون مرصعاً بالعاج أو المعادن…)",
 "うるしぬり": "وَرْنِيش",
 "うるしまけ": "لَبْلَاب",
 "うるっと": "دَامِع العَيْنَيْن (عيناه مليئتان بالدموع)",
 "うるほど": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو…)\nمثال: مزيد من الأرض",
 "うるみ": "غَشَّى, غَبَّش",
 "うるわしい": "جَمِيل (حَسَن)\nمثال: طقس اليوم جميل. / دَافِئ, مُفْرِح (يبعث على السرور والبهجة في القلب)",
 "うるわしの": "جَمِيل (حَسَن)\nمثال: طقس اليوم جميل. / دَافِئ, مُفْرِح (يبعث على السرور والبهجة في القلب)",
 "うれ": "نَضْج",
 "うれあし": "إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة)",
 "うれい": "حُزْن (يقالُ: أَصابَهُ حَزَنٌ شَديدٌ وحُزْنٌ شَديدٌ:(الهَمُّ)؛ حَزِنَ الرّجل :…)\nمثال: شعر توم بالحزن. / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "うれいごと": "شَقَاوَة, تَعَاسَة",
 "うれいる": "عَوِيل, رَثَاء\nمثال: بكى زيري كثيرا.",
 "うれう": "عَوِيل, رَثَاء\nمثال: بكى زيري كثيرا.",
 "うれうべき": "مُخِيف, مُقْلِق (مخيف بسبب الوعي بالخطر)",
 "うれえ": "حداد, ندب (النشاط العاطفي والظاهر للتعبير عن الحزن)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح / غَمّ, حُزْن / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "うれえる": "عَوِيل, رَثَاء\nمثال: بكى زيري كثيرا.",
 "うれくち": "تنفيس, مخرج (نشاط يحرر أو يعبر عن الطاقة الإبداعية أو العاطفة)\nمثال: لم يكن لديها مخرج آخر لمشاعرها / توقع, احتمال",
 "うれしい": "سَعِيد\nمثال: فرح فاضل كثيرا. / سَعِيد, مُفْرِح",
 "うれしがらせ": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "うれしそう": "بَهِيج",
 "うれだか": "إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة)",
 "うれっこ": "مَحْبُوب, مُفَضَّل (يروق لعامة الناس ويستهويهم)\nمثال: هذا الكتاب هو أحد مفضلاتي",
 "うれのこり": "الْبَقَايَا / عَانِس",
 "うれゆき": "إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة)",
 "うれる": "يَنَعَ, نَضَجَ (أَيْنَعَ؛ نَضَجَ) / بَاعَ (أَعْطَى الشيءَ بِثَمَن؛ اِشْتَرَى)\nمثال: باع زيري منزله.",
 "うれわしい": "بَائِس, تَعِيس (يتسم بالبؤس الجسدي)",
 "うろ": "تحويلة, طريق التفافي (طريق غير مباشر (خاصة الذي يستخدم مؤقتاً أثناء إغلاق الطريق الرئيسي)) / أَجْوَف / صورة أبيض وأسود, صورة أحادية اللون (صورة فوتوغرافية أو شريحة بالأبيض والأسود) / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ…)\nمثال: ذهب إلى الدكان.",
 "うろうろ": "بتململ, بقلق (بطريقة متململة)\nمثال: طقطق مفاصل أصابعه بتململ / نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني / صخب, ضجة (اضطراب نشط وسريع)\nمثال: لم يرد إثارة جلبة",
 "うろこ": "مِقْيَاس\nمثال: هم يريدون السلم.",
 "うろこがた": "تداخل, تراكب (غطاء بتصميم يغطي فيه عنصر جزءاً من عنصر آخر (كما هو الحال في البلاط أو القرميد))",
 "うろこぐも": "ركام سمحاقي, سحاب قزعي (سحابة على ارتفاع عالٍ تتكون من سلسلة من السحب الصغيرة المرتبة بانتظام تشبه…)",
 "うろこ形": "تداخل, تراكب (غطاء بتصميم يغطي فيه عنصر جزءاً من عنصر آخر (كما هو الحال في البلاط أو القرميد))",
 "うろこ雲": "ركام سمحاقي, سحاب قزعي (سحابة على ارتفاع عالٍ تتكون من سلسلة من السحب الصغيرة المرتبة بانتظام تشبه…)",
