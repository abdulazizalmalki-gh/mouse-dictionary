 "おもわぬ": "مُفَاجِئ",
 "おもわれる": "بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "おもんじる": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "おもんずる": "شَرَف, عِزَّة (شَرَف) / شَرَف (شَرَف)\nمثال: لا أستحق هذا الشرف.",
 "おもんない": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "おもんね": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "おもんねえ": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "おもんねー": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "おもんばかり": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "おもんぱかり": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "おや": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في الجنين؛ الأب الطبيعي) / وَالِدَة (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\") / وَالِدَان (الشكل المثنى من \"وَالِد\" في حالة الرفع)\nمثال: ألست والدة توم؟ / تَاجِر, تَاجِرَة / مُؤَسِّس, مُؤَسِّسَة / مَالِك, مَالِكَة (اسم شخصي معطًى للذكور من العرب)\nمثال: من مالك هذا البيت؟",
 "おやかた": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن. / صَانِع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة) / حِرَفِيّ / حِرْفِيّ\nمثال: أحب أن أكون صانع محتوى.",
 "おやかたさま": "نَبِيل (اَلذَّكِيُّ؛ اَلنَّجِيبُ)\nمثال: إنها امرأة نبيلة.",
 "おやき": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل.",
 "おやぎ": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل.",
 "おやぎょう": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في الجنين؛ الأب الطبيعي) / وَالِدَة (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\") / وَالِدَان (الشكل المثنى من \"وَالِد\" في حالة الرفع)\nمثال: ألست والدة توم؟",
 "おやくごめん": "إِقَالَة",
 "おやくそく": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها.",
 "おやくめ": "وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب.",
 "おやこうこう": "بِرّ اَلْوَالِدَيْن (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "おやご": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في الجنين؛ الأب الطبيعي) / وَالِدَة (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\") / وَالِدَان (الشكل المثنى من \"وَالِد\" في حالة الرفع)\nمثال: ألست والدة توم؟",
 "おやごさん": "وَالِد (الذي قام بالولادة؛ هو الذكر الذي كان له دور مباشر وعضوي في تكوين الطفل في الجنين؛ الأب الطبيعي) / وَالِدَة (اسم فاعل مؤنث للفعل \"وَلَدَ\"؛ مرادف لـ\"أُمّ\") / وَالِدَان (الشكل المثنى من \"وَالِد\" في حالة الرفع)\nمثال: ألست والدة توم؟",
 "おやしらず": "ضِرْس اَلْعَقْل",
 "おやすい": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "おやすいごよう": "عَفْوًا",
 "おやすみ": "عِيد / عُطْل, عُطْلَة (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام) / إِجَازَة, عُطْلَة\nمثال: ذهب سامي في عطلة. / نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة. / تُصْبِح عَلَى خَيْر, لَيْلَة سَعِيدَة\nمثال: お休み、いい夢たくさん見てね。 — ليلة سعيدة و أحلام أسعد.",
 "おやすみなさい": "تُصْبِح عَلَى خَيْر, لَيْلَة سَعِيدَة",
 "おやだいだい": "مِيرَاث, إرْثْ",
 "おやだま": "رَئِيس, رَئِيسَة",
 "おやっさん": "أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة. / شَيْخ, عَجُوز",
 "おやなかせ": "عَار, خِزْي",
 "おやなし": "يَتِيم / يَتِيمَة",
 "おやなしご": "يَتِيم / يَتِيمَة",
 "おやににぬこはおにご": "الْوَلَدُ سُرّ أَبِيهِ",
 "おやびん": "رَئِيس, رَئِيسَة",
 "おやぶん": "رَئِيس, رَئِيسَة",
 "おやま": "جَبَل (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين) / طُور\nمثال: منزلي في الجبل.",
 "おやみ": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "おやみたけりゃこをみろ": "الْوَلَدُ سُرّ أَبِيهِ",
 "おやむし": "بَالِغ, رَاشِد",
 "おやもじ": "حَرْف كَبِير (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء. / مَصْفُوفَة",
 "おやゆび": "إِبْهَام (الإِصْبَعُ الغليظةُ الخامسةُ من أَصابع اليد والرِّجل، وهي ذات سُلامَيَيْن (مؤنثة وقد تذكَّر) والجمع: أباهيم، وإبهامات)",
 "おやゆびひめ": "ثُومْبِلِينَا",
 "おやチャ": "تَاجِر, تَاجِرَة",
 "おやプログラム": "مُضِيف (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم) / مُضِيف, آدِب (مِنْ أَضَافَ؛ الذي يدعو الضيوف ويقريهم) / جُنْد, جَيْش (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)\nمثال: الجزائر العاصمة مدينة مضيفة جدا.",
 "おゆ": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "おゆび": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / بَنَان (أَطْرَافُ الأَصَابِعِ) / صَبَّعَ ((صَبَعَ) به، وصَبَعَ عليه يَصْبَعُ صَبْعًا: أشار نحوه بِإِصبَعِهِ سخريةً؛ (صَبَعَ) في الشيءِ: أَدخل إصبَعَه فيه)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "およぎ": "سِبَاحَة",
 "およぎて": "سَبَّاح, عَوَّام",
 "およぐ": "سَبَحَ (الشيءَ: غطس وتصرف به؛ الأمر :استكشفه، وبحث فيه بعمق) / سَبْحَة, سِبَاحَة\nمثال: سبح مع الدلافين.",
 "およし": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "およそ": "حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / عَلَى وَشَكِ (يفيد الاستعلاء؛ يفيد التعليل) / عَن (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى) / حَوَالِي\nمثال: رقصنا حول النار. / عُمُومًا / بِوَجْهٍ عَامّ / تَمَامًا / لَخَّصَ, اِخْتَصَرَ",
 "およばない": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "および": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "およびじゃない": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "およびでない": "غَيْر ضَرُورِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "およぶ": "بَلَغَ / مُنْتَجَع / اِقْتَضَى, تَطَلَّبَ",
 "およぼす": "تَمْرِين, تَدْرِيب / تَمَرَّنَ",
 "およめさん": "زَوْجَة, اِمْرَأَة",
 "およる": "نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو) / نَوْم, سِنَة (بكافة معانيه) / نَوْمَة / غَمَص, رَمَص\nمثال: نام في الحافلة.",
 "およろこび": "مُبَارَك, مَبْرُوك",
 "おら": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "おらあ": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "おらおら": "مُتَسَلِّط",
 "おらんだがらし": "قُرَّة, حُرْف",
 "おり": "فُرْصَة / طَوَى / طَيَّة",
 "おりあい": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة / عَلَاقَة, مُنَاسَبَة / صِلَة, عَلَاقَة",
 "おりあう": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل.",
 "おりあしく": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "おりえり": "طَيَّة",
 "おりおり": "أَحْيَانًا",
 "おりかえし": "طَيَّة / رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع. / كَوْرَس, كُورَس / لَازِمَة, قَرَار / لَفَّ, غَلَّفَ",
 "おりかえしちてん": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "おりかえしてん": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "おりかえす": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "おりかばん": "حَقِيبَة, مِحْفَظَة",
 "おりがみ": "أُورِيغَامِي, طَيّ اَلْوَرَق",
 "おりがみつき": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء.",
 "おりがみをつける": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء.",
 "おりき": "مِنْسَج",
 "おりくち": "قِمَّة",
 "おりぐち": "قِمَّة",
 "おりこ": "نَسَّاج, نَسَّاجَة / تَنَوُّط",
 "おりこう": "نَسَّاج, نَسَّاجَة / تَنَوُّط",
 "おりこみ": "أَدْخَلَ",
 "おりこみずみ": "خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "おりこむ": "دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة.",
 "おりしき": "رَكَعَ, جَثَا ((رَكَعَ) رَكْعًا، ورُكوعًا: انحنى، سواءٌ؛ مَسّتْ ركبتاه الأرض أم لا)",
 "おりしく": "رَكَعَ, جَثَا ((رَكَعَ) رَكْعًا، ورُكوعًا: انحنى، سواءٌ؛ مَسّتْ ركبتاه الأرض أم لا)",
 "おりじ": "مَلْمَس / قُمَاش, نَسِيج (النسيج الذي لم يُقَصّ أو يُخَاط)\nمثال: الورق و القماش يمتصان الماء.",
 "おりそう": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "おりたたみ": "طَوَى / طَيَّة",
 "おりたたみき": "مِلَفّ, مُجَلَّد / مُجَلَّد",
 "おりたたみナイフ": "مِطْواة",
 "おりたたむ": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "おりちょう": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "おりにふれて": "بَيْنَ ٱلْحِينِ وَٱلْآخَرِ, بين وقت وآخر (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك.",
 "おりひめ": "اَلنَّسْر اَلْوَاقِع",
 "おりふし": "أَحْيَانًا",
 "おりまげる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "おりめ": "مَلْمَس",
 "おりめただしい": "مُهَذَّب, مُؤَدَّب",
 "おりもの": "حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ معلومةٍ كلَّ شهر؛ أعراض ما قبل الحيض (في ): أعراض تشمل انتفاخ البطن وألم الصدر والصداع والشعور بالتّعب وحدَّة الطبع والتهيّج العصبيّ والاكتئاب…) / خَلَاص",
 "おりものしょう": "بَزَّاز",
 "おりゃる": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان. / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "おりよく": "لِحُسْن اَلْحَظّ",
 "おりる": "نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف. / تَقَاعَدَ / اِعْتَزَلَ / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح.",
 "おりわるく": "لِلْأَسَف, لِسُوءِ الْحَظِّ",
 "おる": "نَسَجَ",
 "おるすになる": "أَهْمَلَ / إِهْمَال",
 "おれ": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "おれあう": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل.",
 "おれい": "شُكْرًا / أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب. / قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "おれいにはおよびません": "عَفْوًا",
 "おれおんな": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "おれかえる": "كَرَّرَ, أَعَادَ (أَعَادَ)\nمثال: كرر الشهادة بعدي.",
 "おれくち": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة.",
 "おれさま": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "おれし": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "おれたち": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "おれっち": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "おれまがる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "おれめ": "طَوَى / طَيَّة",
 "おれら": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "おれる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / أَذْعَنَ ((أَذْعَنَ): انْقَادَ وسلس وَيُقَال: أذعن بِالْحَقِّ: أقرّ بِهِ) / دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار.",
 "おれ合う": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل.",
 "おれ女": "فَتَاة مُسْتَرْجِلَة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "おろおろ": "اِخْتَلَجَ, اِرْتَجَفَ / رَجْفَة (المرّة الواحدة من الرَجْف؛ الزَلْزَلَة)",
 "おろか": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "おろかしい": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "おろかもの": "مُغَفَّل, أَحْمَق",
 "おろか者": "مُغَفَّل, أَحْمَق",
 "おろし": "نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا. / مِبْشَرَة",
