 "うりだか": "إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة)",
 "うりだし": "بَيْع / تخفيض (تَنْقِيص ، حَسْم ،تَقْلِيل؛ تَنْزِيل) / مُزَايَدَة\nمثال: هل يمكن ان تعطيني تخفيض",
 "うりだしちゅう": "مُجْتَهِد, نَشِيط (يعمل بجدّ لتعزيز مشروع أو مؤسّسة)",
 "うりだて": "حساب البيع على المكشوف (مجموع المبيعات القصيرة في سوق مفتوحة) / حساب بيع على المكشوف (حساب وساطة لشخص يبيع على المكشوف (يبيع أوراقاً مالية لا يملكها))",
 "うりだてぎょく": "حساب البيع على المكشوف (مجموع المبيعات القصيرة في سوق مفتوحة) / حساب بيع على المكشوف (حساب وساطة لشخص يبيع على المكشوف (يبيع أوراقاً مالية لا يملكها))",
 "うりつけ": "بَيْع, بُيُوع / مَهَارَة البَيْع, مَهَارَات البَيْع",
 "うりつなぎ": "تحوط, مراوغة (بيان غير ملزم أو غامض عمداً) / تحوط (أي تقنية مصممة لتقليل أو القضاء على المخاطر المالية؛ على سبيل المثال، اتخاذ موقفين يعوض كل منهما الآخر إذا تغيرت الأسعار)\nمثال: عندما تقول 'ربما' فأنت تتحوط فقط",
 "うりて": "بَائِع, بَائِعَة",
 "うりてしじょう": "سوق البائعين (سوق يكون فيه عدد الأشخاص الذين يريدون الشراء أكثر ممن يريدون البيع)",
 "うりどき": "متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية)\nمثال: قضينا وقتاً ممتعاً في الحفلة",
 "うりどころ": "ميزة تنافسية, نقطة بيع (خاصية تجعل الشيء المعروض للبيع جذابًا للعملاء) / عَدَّاد",
 "うりぬし": "بَائِع, بَائِعَة",
 "うりね": "سعر البيع, سعر العرض (السعر الذي يُعرض به شيء للبيع)",
 "うりのつる": "قرع, يقطين (أي كرمة من الفصيلة القرعية تحمل ثماراً ذات قشور صلبة)",
 "うりば": "عَدَّاد / متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية)\nمثال: قضينا وقتاً ممتعاً في الحفلة",
 "うりふたつ": "أُحَادِيّ البُوَيْضَة, مُتَطَابِق ((للتوائم) مشتق من بيضة واحدة أو بويضة) / قَابِلٌ لِلتَّطَابُقِ, مُتَمَاثِل (يَتَطَابَقُ تَمَامًا عِنْدَ وَضْعِهِ فَوْقَ الآخَرِ) / مُتَمَاثِل (ذو خصائص بقيم موحّدة على طول جميع المحاور) / لَا يُمَيَّز, مُتَطَابِق (متماثل تمامًا؛ لا يمكن إدراك أيّ فرق بينهما)\nمثال: التوائم المتطابقة هي أحادية البويضة",
 "うりぼう": "خَنْزِير بَرِيّ",
 "うりもの": "قُرْبَان / اِخْتِصَاص, تَخَصُّص / لِلبَيع",
 "うりものにする": "سُوق (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "うりもんく": "خِطَاب الْبَيْع, عَرْض تَرْوِيجِيّ (ترويج عن طريق الحجة والبرهان)",
 "うりょう": "مطر, هطول مطري (ماء يسقط في قطرات من بخار متكثف في الغلاف الجوي) / عَوِيل, رَثَاء / مَرْثِيَة / بَكَى, نَاحَ (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / بَكَى, رَثَى (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا.",
 "うりょうけい": "مقياس المطر (مقياس يتكون من أداة لقياس كمية هطول الأمطار)",
 "うりるい": "قرعيات (أي نبات من الفصيلة القرعية)",
 "うりわたし": "بَيْع / تخفيض (تَنْقِيص ، حَسْم ،تَقْلِيل؛ تَنْزِيل) / مُزَايَدَة\nمثال: هل يمكن ان تعطيني تخفيض",
 "うりわたししょう": "سند بيع, فاتورة بيع (صك ينقل الممتلكات الشخصية)",
 "うりわたししょうしょ": "سند بيع, فاتورة بيع (صك ينقل الممتلكات الشخصية)",
 "うりん": "غَابَة اِسْتِوَائِيَّة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "うり坊": "خَنْزِير بَرِيّ",
 "うる": "اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / أَصْبَحَ (دَخَلَ فِي الصَّبَاح؛ صَارَ)\nمثال: استقبل توم الضيوف. / بَاعَ (أَعْطَى الشيءَ بِثَمَن؛ اِشْتَرَى) / اِنْبَاعَ, بِيعَ\nمثال: باع زيري منزله. / خانَ (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة)",
 "うるう": "انسداد وعائي, انصمام (انسداد وعاء دموي بواسطة صمة (جلطة دموية أو فقاعة هواء أو جسيم آخر)) / إقحام, كبس (إدراج في التقويم (مثل يوم كبيس))",
 "うるうどし": "سَنَة كَبِيسَة (مقدارُ قطع الشمس البروجَ الاثني عشر ، وهي السنة الشمسيَّة، و السَّنَةُ تمامُ اثنتَيْ عشرةَ دَورةً للقمر ، وهي السنة القمرية…)\nمثال: في عمره 24 سنة.",
 "うるうび": "29 فبراير, يوم كبيس (اسم اليوم الذي يُضاف خلال السنة الكبيسة)",
 "うるうびょう": "ثانية كبيسة (ثانية (كما تقاس بالساعة الذرية) تضاف أو تطرح من توقيت غرينتش للتعويض عن التباطؤ في دوران الأرض)",
 "うるうる": "دَامِع العَيْنَيْن (عيناه مليئتان بالدموع) / رُطُوبة",
 "うるう年": "سَنَة كَبِيسَة (مقدارُ قطع الشمس البروجَ الاثني عشر ، وهي السنة الشمسيَّة، و السَّنَةُ تمامُ اثنتَيْ عشرةَ دَورةً للقمر ، وهي السنة القمرية…)\nمثال: في عمره 24 سنة.",
 "うるう日": "29 فبراير, يوم كبيس (اسم اليوم الذي يُضاف خلال السنة الكبيسة)",
 "うるう秒": "ثانية كبيسة (ثانية (كما تقاس بالساعة الذرية) تضاف أو تطرح من توقيت غرينتش للتعويض عن التباطؤ في دوران الأرض)",
 "うるおい": "رُطُوبَة / عَظَمَة, فَخَامَة (الروعة أو الهيبة في الحجم أو المظهر) / ثراء لوني, غنى (حيوية عميقة وقوية للون) / امتلاء, رقة (خاصية الإحساس الغني والممتع) / ثراء, غزارة (خاصية كون الشيء وفيراً للغاية)\nمثال: عظمة العمارة / كَسَبَ / بَرَكَة, نِعْمَة (مُسْتَنْقَع الماء أو أو بُحِيْرَة صغيرة؛ حوض الماء المصنوع لتزيين الحدائق وريها) / نِعْمَة\nمثال: البركة عميقة جدا.",
 "うるおう": "رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "うるおす": "مُبْتَلّ / مَبْلُول, مُبْتَلّ / رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "うるかす": "اِبْتَلَّ",
 "うるさい": "صَارِخ, صاخِب / مُزْعِج / دَقِيق, مُتَطَلِّب (شَدِيد التَّدْقِيق خَاصَّةً فِي التَّفَاصِيل) / عَبُوس, مُتَذَمِّر (مُنزعج وسريع الانفعال) / مُزْدَحِم بِالتَّفَاصِيل (مكتظّ بالتفاصيل والزخارف بشكل مفرط) / كَمَّمَ الفَمَ / صَه, اُسْكُت (صَهْ اسم فعل أمر بمعنى اسكتْ، وهو بلفظ واحد للمفرد و الجمع و المذكر و المؤنث; يقال صَهٍ بالتنوين بمعنى اسكت سكوتاً ما في وقتٍ ما)",
 "うるさがた": "تنطع, دقة مفرطة (سمة التدقيق المفرط في أمور الذوق أو الأسلوب)\nمثال: أناقة وتدقيق في الملابس",
 "うるさ型": "تنطع, دقة مفرطة (سمة التدقيق المفرط في أمور الذوق أو الأسلوب)\nمثال: أناقة وتدقيق في الملابس",
 "うるし": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان. / شجرة اللك, شجرة الورنيش (شجرة آسيوية صغيرة تفرز مادة سامة يتم الحصول منها على اللك (الورنيش))",
 "うるしかぶれ": "لَبْلَاب",
 "うるしざいく": "أشغال اللك (عمل زخرفي مصنوع من الخشب ومغطى باللك وغالباً ما يكون مرصعاً بالعاج أو المعادن الثمينة)",
 "うるしぬり": "وَرْنِيش",
 "うるしまけ": "لَبْلَاب",
 "うるっと": "دَامِع العَيْنَيْن (عيناه مليئتان بالدموع)",
 "うるほど": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض",
 "うるみ": "غَشَّى, غَبَّش / لَطَّخَ, بَقَّعَ (لوَّثَ الشيءَ بسائل أو مادة لزجة؛ أصابه بشيء من العيب أو السوء)",
 "うるわしい": "جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل. / دَافِئ, مُفْرِح (يبعث على السرور والبهجة في القلب)",
 "うるわしの": "جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل. / دَافِئ, مُفْرِح (يبعث على السرور والبهجة في القلب)",
 "うれ": "نَضْج",
 "うれあし": "إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة)",
 "うれい": "حُزْن (يقالُ: أَصابَهُ حَزَنٌ شَديدٌ وحُزْنٌ شَديدٌ:(الهَمُّ)؛ حَزِنَ الرّجل : اغْتَمَّ ، حزِنت المرأة:لبست السّواد)\nمثال: شعر توم بالحزن. / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "うれいごと": "شَقَاوَة, تَعَاسَة",
 "うれいる": "عَوِيل, رَثَاء / مَرْثِيَة / بَكَى, نَاحَ (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / بَكَى, رَثَى (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا.",
 "うれう": "عَوِيل, رَثَاء / مَرْثِيَة / بَكَى, نَاحَ (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / بَكَى, رَثَى (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا.",
 "うれうべき": "مُخِيف, مُقْلِق (مخيف بسبب الوعي بالخطر)",
 "うれえ": "حداد, ندب (النشاط العاطفي والظاهر للتعبير عن الحزن) / رثاء, عويل (صرخة حزن وأسى)\nمثال: يمكن سماع نواحهم المثير للشفقة في جميع أنحاء الجناح / غَمّ, حُزْن / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "うれえる": "عَوِيل, رَثَاء / مَرْثِيَة / بَكَى, نَاحَ (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه) / بَكَى, رَثَى (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا.",
 "うれくち": "تنفيس, مخرج (نشاط يحرر أو يعبر عن الطاقة الإبداعية أو العاطفة) / مخرج, منفذ (فتحة تسمح بالهروب أو الخروج) / متجر, محل تجاري (مكان عمل لبيع البضائع بالتجزئة) / مأخذ كهربائي, مِقبس جداري (مقبس يوفر مكاناً في نظام الأسلاك يمكن منه أخذ التيار لتشغيل الأجهزة الكهربائية)\nمثال: لم يكن لديها مخرج آخر لمشاعرها / توقع, احتمال / تَنْقِيْب (نقّب إذا سار في البلاد طلباً للمهرب ، نقّب عن الأخبار وغيرها:بحث عنها،هو البحث عن كلّ شيء والتّفتيش مطلقاً؛ نقّب مبالغة في نَقَب ، نقّب عن الشيء :فحص عنه فحصاً بليغاً)",
 "うれしい": "سَعِيد / فَرِح (سُرُور؛ اسم يطلق على الإناث) / مَحْظُوظ\nمثال: فرح فاضل كثيرا. / سَعِيد, مُفْرِح",
 "うれしがらせ": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "うれしそう": "بَهِيج",
 "うれだか": "إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة)",
 "うれっこ": "مَحْبُوب, مُفَضَّل (يروق لعامة الناس ويستهويهم) / مفضل (شيء يحظى بتفضيل أو إعجاب خاص) / حبيب, مفضل (شخص محبوب مميز) / مرشح للفوز, مفضل (منافس يُعتقد أنه من المرجح أن يفوز)\nمثال: هذا الكتاب هو أحد مفضلاتي",
 "うれのこり": "الْبَقَايَا / عَانِس",
 "うれゆき": "إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة)",
 "うれる": "يَنَعَ, نَضَجَ (أَيْنَعَ؛ نَضَجَ) / بَاعَ (أَعْطَى الشيءَ بِثَمَن؛ اِشْتَرَى) / اِنْبَاعَ, بِيعَ\nمثال: باع زيري منزله.",
 "うれわしい": "بَائِس, تَعِيس (يتسم بالبؤس الجسدي) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا) / حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار) / بَائِس, مُعَذَّب (شَديد التَّعاسَة؛ مَليء بالبُؤس والشَّقاء)",
 "うろ": "تحويلة, طريق التفافي (طريق غير مباشر (خاصة الذي يستخدم مؤقتاً أثناء إغلاق الطريق الرئيسي)) / أَجْوَف / صورة أبيض وأسود, صورة أحادية اللون (صورة فوتوغرافية أو شريحة بالأبيض والأسود) / تَوَاصُل كِتَابِيّ, لُغَة مَكْتُوبَة (التواصل بوساطة رموز مكتوبة، سواء أكانت مطبوعة أم مخطوطة) / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "うろうろ": "بتململ, بقلق (بطريقة متململة)\nمثال: طقطق مفاصل أصابعه بتململ / نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم) / مرمى, مغزى (المعنى العام أو الفحوى السائد) / اتجاه, تيار (ميل عام للتغيير (كما في الرأي)) / رُكَام (كتلة كبيرة من المواد المتراكمة بفعل الرياح أو التيارات المائية)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني / صخب, ضجة (اضطراب نشط وسريع) / مشاجرة تافهة, ملاحاة (شجار حول نقاط تافهة) / إزعاج, جلبة (اضطراب غاضب) / اضطراب, حيرة (حالة من الهياج المثار)\nمثال: لم يرد إثارة جلبة",
 "うろこ": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "うろこがた": "تداخل, تراكب (غطاء بتصميم يغطي فيه عنصر جزءاً من عنصر آخر (كما هو الحال في البلاط أو القرميد))",
 "うろこぐも": "ركام سمحاقي, سحاب قزعي (سحابة على ارتفاع عالٍ تتكون من سلسلة من السحب الصغيرة المرتبة بانتظام تشبه التموجات)",
 "うろこ形": "تداخل, تراكب (غطاء بتصميم يغطي فيه عنصر جزءاً من عنصر آخر (كما هو الحال في البلاط أو القرميد))",
 "うろこ雲": "ركام سمحاقي, سحاب قزعي (سحابة على ارتفاع عالٍ تتكون من سلسلة من السحب الصغيرة المرتبة بانتظام تشبه التموجات)",
 "うろつきまわる": "تجوال خلسة, تسلل (فعل التجوال خلسة)",
 "うろつき回る": "تجوال خلسة, تسلل (فعل التجوال خلسة)",
 "うろつく": "تجوال خلسة, تسلل (فعل التجوال خلسة)",
 "うろん": "مُثِيرٌ لِلشُّبْهَة, مُرِيب (ليس كما هو متوقّع؛ يبعث على الريبة) / زفر, سمكي (مكون من أو متعلق بـ أو يشبه السمك)\nمثال: كان للحساء رائحة سمكية",
 "うわ": "أَعْلَى, عُلْيَا (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / عُلْوِيّ, فَوْقَانِيّ\nمثال: خذها إلى الأعلى. / آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "うわ〜": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "うわあ": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "うわあご": "فك علوي (الفك في الفقاريات الذي يندمج مع القحف)",
 "うわあっ": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "うわお": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "うわおおい": "غِطَاء / غِلَاف / غَطَّى",
 "うわかけ": "لحاف (مفرش سرير مصنوع من طبقتين من القماش محشوتين ومخيطتين معاً) / غِطَاء / غِلَاف / غَطَّى / مِعْطَف فَضْفَاض / مِنَ الدَّرَجَة الأُولَى (ممتاز؛ أفضل ما يمكن) / زينة علوية, طبقة علوية (إضافة ذات نكهة توضع فوق طبق الطعام)",
 "うわかみあわせ": "بروز الفك العلوي, تراكب العضة ((طب الأسنان) سوء إطباق تمتد فيه الأسنان العلوية بشكل غير طبيعي فوق الأسنان السفلية)",
 "うわかわ": "أعلى, قمة (الجانب الأعلى أو الأرفع لأي شيء)\nمثال: ضع كتبك على سطح المكتب / بُشَيْرَة / نَسِيج طِلَائِيّ",
 "うわがき": "كتابة فوقية (نشاط الكتابة فوق شيء ما) / كتابة فوقية (نص مكتوب فوق شيء آخر)",
 "うわがけ": "لحاف (مفرش سرير مصنوع من طبقتين من القماش محشوتين ومخيطتين معاً) / غِطَاء / غِلَاف / غَطَّى / مِعْطَف فَضْفَاض / مِنَ الدَّرَجَة الأُولَى (ممتاز؛ أفضل ما يمكن) / زينة علوية, طبقة علوية (إضافة ذات نكهة توضع فوق طبق الطعام)",
 "うわがみ": "غِلَاف",
 "うわがわ": "أعلى, قمة (الجانب الأعلى أو الأرفع لأي شيء)\nمثال: ضع كتبك على سطح المكتب",
 "うわき": "جنس خارج إطار الزواج, حب حر (الجماع الجنسي بين أفراد غير متزوجين من بعضهم البعض) / خِيَانَة / كُفْر, زَنْدَقَة (مصدر للفعل \"كَفَرَ\") / سقفية, ظلة (غطاء (عادة من القماش) يعمل كسقف لحماية منطقة ما من الطقس) / مظلة (الجزء الذي يشبه المظلة في الباراشوت والذي يمتلئ بالهواء) / قبة الطائرة (الغطاء الشفاف لمقصورة الطائرة)",
 "うわきおとこ": "غزل, ملاطفة (سلوك مرح يهدف إلى إثارة الاهتمام الجنسي) / غانية, لعوب (امرأة مغرية تستخدم جاذبيتها لاستغلال الرجال)",
 "うわきおんな": "زَانِيَة (اسم فاعلة من زَنَى، المرأة التي تمارس الجنس مع غير زوجها أو بدون زواج)",
 "うわきしょう": "مُتَدَلِّل, مُغَازِل (يتصرّف بدلال ومغازلة)",
 "うわきもの": "غشاش, محتال (شخص يجعلك تعتقد شيئاً غير حقيقي)",
 "うわぎ": "مِعْطَف / قِمَّة",
 "うわぐすり": "صقل, طلاء زجاجي (طلاء للسيراميك والمعدن وما إلى ذلك) / تلميع, صقل (طبقة نهائية لامعة على القماش) / طبقة تلميع, طلاء لامع (أي من التغطيات الرقيقة اللامعة (المالحة أو الحلوة) التي توضع على الأطعمة)",
 "うわぐつ": "حذاء فوقي (حذاء يحمي حذاءك الأصلي من الماء أو الثلج أو البرد)",
 "うわごと": "هُرَاء, لَغْو",
 "うわさ": "إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "うわさばなし": "نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "うわさ話": "نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "うわしき": "سَجَّادَة / حلس, دثار السرج (من معدات الإسطبل يتكون من بطانية توضع تحت السرج)",
 "うわじき": "سَجَّادَة / حلس, دثار السرج (من معدات الإسطبل يتكون من بطانية توضع تحت السرج)",
 "うわすべり": "سَطْحِيّ / تافه, طائش (غير جاد في المحتوى أو الموقف أو السلوك)\nمثال: رواية تافهة",
 "うわぜい": "طول, قامة ((لشخص واقف) المسافة من الرأس إلى القدم) / قامة, منزلة رفيعة (مستوى عالٍ من الاحترام يتم اكتسابه من خلال التطور أو الإنجاز المثير للإعجاب)\nمثال: رجل ذو قامة عظيمة",
 "うわぞうり": "خُفّ, نَعْل (قدم البعير والنعام وهو بمثابة الحافر لغيرهما. الجمع أخفاف ويجوز قول خفاف؛ الحذاء الخفيف المصنوع من الجلد الطري أو القماش ونعله طريّ ويغطي الكعب، سميّ بالخُفّ لخفة وزنه. الجمع خِفَاف) / خُفّ (قدم البعير والنعام وهو بمثابة الحافر لغيرهما. الجمع أخفاف ويجوز قول خفاف؛ الحذاء الخفيف المصنوع من الجلد الطري أو القماش ونعله طريّ ويغطي الكعب، سميّ بالخُفّ لخفة وزنه. الجمع خِفَاف)\nمثال: لا تخف من الغريب، خف من الذي تعرفه.",
 "うわだい": "سعر التجزئة (السعر الإجمالي المفروض على منتج يُباع للعميل، ويشمل تكلفة المصنع بالإضافة إلى هامش ربح التجزئة)",
 "うわちょうし": "تردد عالي, طبقة عالية (طبقة صوتية تُدرك على أنها أعلى من غيرها)",
 "うわっ": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "うわっかわ": "أعلى, قمة (الجانب الأعلى أو الأرفع لأي شيء)\nمثال: ضع كتبك على سطح المكتب / بُشَيْرَة",
 "うわっちょうし": "خَفِيف العَقْل, مُسْتَخِفّ (يُظهر خفّة غير لائقة في موضع يستدعي الجدّية)",
 "うわっつら": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح.",
 "うわっぱり": "إِجْمَالِيّ, شَامِل (يتناول السمات الرئيسية فقط) / إِجْمَالِيّ, شَامِل (يشمل كل شيء بلا استثناء) / أفرول, سروال عمل ((عادة جمع) ملابس عمل تتكون من سراويل دنيم (عادة بمريلة وحمالات كتف)) / أفرول, بدلة عمل (رداء واقٍ فضفاض أو مريول يرتدى فوق الملابس العادية للعمل المتسخ)",
 "うわつき": "علوي, مرتفع (نص) (مكتوب أو مطبوع فوق وإلى جانب حرف آخر) / حرف علوي, نص مرتفع (حرف أو رمز يوضع أو يُطبع أو يُكتب فوق وإلى جانب حرف آخر مباشرة)",
 "うわつきもじ": "علوي, مرتفع (نص) (مكتوب أو مطبوع فوق وإلى جانب حرف آخر) / حرف علوي, نص مرتفع (حرف أو رمز يوضع أو يُطبع أو يُكتب فوق وإلى جانب حرف آخر مباشرة)",
 "うわつら": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح.",
 "うわづつみ": "غِطَاء / غِلَاف / غَطَّى",
 "うわづみ": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول.",
 "うわて": "مَاهِر, حَاذِق",
 "うわてをいく": "فَاقَ, تَجَاوَزَ",
 "うわなみ": "لَوَّحَ, رَفْرَفَ / مَوْج, مَوْجَة",
 "うわなり": "سُرِّيَة / حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "うわにぶね": "قارب صغير (قارب صغير الحجم)",
 "うわぬり": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "うわのせ": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها) / أَضَافَ\nمثال: جمع خيل هو خيول.",
 "うわのそら": "شرود, عدم انتباه (قلة الانتباه أو عدم التركيز)",
 "うわのり": "مشرف الشحن (ضابط على سفينة تجارية مسؤول عن البضائع وبيعها وشرائها)",
 "うわの空": "شرود, عدم انتباه (قلة الانتباه أو عدم التركيز)",
 "うわばたらき": "خادمة (عاملة منزلية)",
 "うわばり": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / طبقة نهائية, وجه أخير (الطلاء النهائي (مثل الدهان أو الجص أو الورنيش، إلخ))\nمثال: لا يمكننا الطلاء حتى يضعوا الطبقة النهائية",
 "うわばん": "الجدار المعلق (الجدار العلوي لصدع مائل)",
 "うわびょうし": "غِطَاء / غِلَاف / غَطَّى",
 "うわふく": "رداء خارجي, ملابس خارجية (رداء يلبس فوق ملابس أخرى)",
 "うわぶた": "غِطَاء",
 "うわぶれ": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "うわべ": "خارجي (يقع في أو مناسب للأماكن الخارجية أو خارج مبنى) / خارج, سطح خارجي (الجانب الخارجي أو السطح الخارجي لشيء ما) / خارج, محيط خارجي (المنطقة الموجودة خارج شيء ما)\nمثال: مشهد خارجي / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "うわべをかざる": "اِدَّعَى / زَعَمَ / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب.",
 "うわべを飾る": "اِدَّعَى / زَعَمَ / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب.",
 "うわまい": "عُمُولَة / ضريبة الإنتاج, ضريبة الاستهلاك (ضريبة تقاس بحجم الأعمال المنجزة (وليس على الممتلكات أو الدخل العقاري))",
 "うわまえ": "النِّسْبَة الْمِئَوِيَّة",
 "うわまる": "كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "うわまわる": "كَبُرَ, تَخَطَّى (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي) / فَاقَ / عَلَا, تَخَطَّى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "うわむき": "انتعاش, تحسن (حركة تصاعدية أو اتجاه صعودي كما في النشاط التجاري)",
 "うわむく": "حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "うわもの": "إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / تجهيزات, تركيبات (جسم مثبت بإحكام في مكانه (خاصة في المنزل)) / ثَبَات, رُسُوخ (صفة التثبيت في المكان كما لو كان بملحق قوي) / زبون معتاد, مرتاد دائم (راعٍ منتظم لمكان ما)\nمثال: مرتاد دائم لمضمار السباق",
 "うわや": "سَقِيفَة",
 "うわやく": "أعلى مرتبة, رئيس (شخص ذو رتبة أو مكانة أو جودة أعلى)",
 "うわり": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "うわん": "رامٍ أيمن ((في البيسبول) رامٍ يرمي الكرة باليد اليمنى) / عَجَبًا / سُبْحَانَ الله (مصدر للفعل سَبَحَ؛ تُقال حصرًا للَّٰه، كما في العبارة \"سُبْحَانَ اللَّٰهِ\")\nمثال: سبحان الله عما يشركون. / مخلوق أسطوري, وحش أسطوري (وحش مشهور في الفولكلور والأسطورة)",
 "うわー": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "うわーっ": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "うわ言": "هُرَاء, لَغْو",
 "うん": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل . / ثَرْوَة / هَالَة / بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مثال: لديك بعض الكتب.",
 "うんえい": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "うんえいいいんかい": "لجنة توجيهية (لجنة لترتيب جدول أعمال هيئة (تشريعية) أكبر)",
 "うんえいかんりかん": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "うんえいけいひ": "تكاليف التشغيل, مصاريف إدارية وعامة (نفقات صيانة الممتلكات (مثل دفع الضرائب العقارية والمرافق والتأمين)؛ لا تشمل الإهلاك أو تكلفة التمويل أو ضرائب الدخل)",
 "うんえいしゃ": "داهية, محتال ذكي (شخص ذكي أو عديم المبادئ يعرف كيفية التحايل على الصعوبات لتحقيق أهدافه) / عامل تشغيل, مُشَغِّل (وكيل يقوم بتشغيل جهاز أو آلة) / مُشغِّل (شخص يمتلك أو يدير عملاً تجارياً) / مشغل, مضارب محترف (مضارب يتداول بقوة في أسواق الأسهم أو السلع)\nمثال: مشغل لوحة المفاتيح",
 "うんえいじょう": "عَامِل, قَيْدَ التَّشْغِيل (في حالة تنفيذ أو تشغيل) / تشغيلي, عملياتي ((عسكري) متعلق أو مخصص أو مشارك في العمليات العسكرية) / جَاهِز لِلْعَمَل, صَالِح لِلاسْتِعْمَال (مناسب وجاهز للاستخدام أو الخدمة) / تشغيلي, عملياتي (يخص عملية أو سلسلة من الإجراءات لتحقيق نتيجة)\nمثال: صعوبات تشغيلية",
 "うんえいひ": "تكاليف التشغيل, مصاريف إدارية وعامة (نفقات صيانة الممتلكات (مثل دفع الضرائب العقارية والمرافق والتأمين)؛ لا تشمل الإهلاك أو تكلفة التمويل أو ضرائب الدخل)",
 "うんえん": "عَجَاج / مَنْظَر طَبِيعِيّ, مَنْظَر",
 "うんおう": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "うんか": "ثَوْل (بدا فيه الجنون) / اِزْدِحَام / نطاط النبات (قريب من نطاطات الأوراق وحشرات البصاق ولكنه نادراً ما يضر بالنباتات المزروعة)",
 "うんかく": "رجل حاشية (مرافق في بلاط الحاكم)",
 "うんが": "قَنَاة",
 "うんがいい": "مَحْظُوظ, جَالِب للحَظّ",
 "うんがない": "سَيِّئُ الطَّالِع, مَنْحُوس (يَتَّسِمُ بِسُوءِ الحَظِّ أَوْ يُنْذِرُ بِهِ) / سيء الحظ, نحس (لديه أو يجلب سوء الحظ)\nمثال: الجمعة الثالث عشر تاريخ منحوس",
 "うんがよい": "مَحْظُوظ, جَالِب للحَظّ",
 "うんがわるい": "سَيِّئُ الطَّالِع, مَنْحُوس (يَتَّسِمُ بِسُوءِ الحَظِّ أَوْ يُنْذِرُ بِهِ) / سيء الحظ, نحس (لديه أو يجلب سوء الحظ)\nمثال: الجمعة الثالث عشر تاريخ منحوس",
 "うんき": "قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب. / سَحَاب, غَيْم (الغيوم المتحركة؛ غُيُوم، دَيْم)\nمثال: القمر موجود خلف السحاب. / حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد.",
 "うんきゅう": "يُعَلِّق / تَعْلِيق / استخدام القوس (إدارة القوس في العزف على آلة وترية) / مُتَمَلِّق, مُنْحَنٍ (يُظْهِر أَدَبًا مُفْرِطًا فِي الخُضُوع) / انحناء (حني الرأس أو الجسم أو الركبة كعلامة على الاحترام أو الخضوع أو التحية)\nمثال: كان استخدام عازف الكمان للقوس ممتازاً",
 "うんきゅうほう": "استخدام القوس (إدارة القوس في العزف على آلة وترية) / مُتَمَلِّق, مُنْحَنٍ (يُظْهِر أَدَبًا مُفْرِطًا فِي الخُضُوع) / انحناء (حني الرأس أو الجسم أو الركبة كعلامة على الاحترام أو الخضوع أو التحية)\nمثال: كان استخدام عازف الكمان للقوس ممتازاً",
 "うんこ": "بَرَّزَ, تَغَوَّطَ (خَرَجَ؛ نَبُه بعد خُمول) / بُرَاز, كَاكَا / خَرَاء, بُرَاز",
 "うんこう": "عَمَلِيَّة, عَمَل / عَمَلِيَّة جِرَاحِيَّة, جِرَاحَة / عَمَلِيَّات, عَمَلِيَّة / عَمَلِيَّة, عَمَل / عَمَلِيَّة جِرَاحِيَّة, جِرَاحَة / عَمَلِيَّات, عَمَلِيَّة / حَرَكَة",
 "うんこずわり": "قرفصاء (فعل اتخاذ أو الحفاظ على وضعية الانحناء مع ثني الركبتين والأرداف بالقرب من الكعبين) / القرفصاء, سكوات (تمرين عن طريق اتخاذ وضعية الانحناء مع ثني الركبتين بشكل متكرر؛ يقوي عضلات الساق)",
 "うんこ座り": "قرفصاء (فعل اتخاذ أو الحفاظ على وضعية الانحناء مع ثني الركبتين والأرداف بالقرب من الكعبين) / القرفصاء, سكوات (تمرين عن طريق اتخاذ وضعية الانحناء مع ثني الركبتين بشكل متكرر؛ يقوي عضلات الساق)",
 "うんさん": "نَثَرَ, تَفَرَّقَ",
 "うんざり": "إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي) / مُضْجِر, مُمِلّ (يفتقر إلى الإثارة لدرجة تسبب السأم الذهني)",
 "うんざん": "عملية, عملية رياضية (الحساب بالطرق الرياضية)\nمثال: أظهرت المسائل في نهاية الفصل العمليات الرياضية المعنية بالاشتقاق",
 "うんし": "تلمس, لمس بالأصابع (لمس شيء ما بالأصابع) / ترقيم الأصابع (وضع الأصابع لعزف نغمات مختلفة على آلة موسيقية)",
 "うんしゅう": "ثَوْل (بدا فيه الجنون) / اِزْدِحَام",
 "うんしょう": "سَمَاوَات",
 "うんじ": "هَكَذَا",
 "うんじょう": "سَمَاوَات / تخمير (إنتاج المشروبات الشعيرية (مثل البيرة) من الشعير والجنجل عن طريق طحنها وغليها وتخمير الناتج بالخميرة) / إحداث, تسبيب (فعل التسبب في حدوث شيء ما)",
 "うんじょうびと": "نُبْل, نَبَالَة / فَخَامَة, شَهَامَة",
 "うんすい": "شَحَّاذ, مُتَسَوِّل (يُمَارِسُ الاسْتِجْدَاءَ وَالتَّسَوُّل) / شَحَّاذ, مُتَسَوِّل (فقير يعيش على التسول) / راهب متسول (عضو ذكر في رهبنة دينية كانت تعتمد في الأصل كلياً على الصدقات)",
 "うんせい": "ثَرْوَة",
 "うんせいはんだん": "عَرَافَة",
 "うんそう": "نَقَلَ / نَقْل / شحن, نقل (المشروع التجاري لنقل البضائع والمواد) / شحن بحري, ملاحة تجارية (خدمات النقل التي توفرها السفن التابعة لبلد أو صناعة معينة)",
 "うんそうがいしゃ": "شركة شحن (شركة تقدم خدمات الشحن)",
 "うんそうぎょうしゃ": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "うんそうじょう": "بُولِيصَةُ شَحْنٍ",
 "うんそうせん": "باخرة شحن, سفينة تجارية (سفينة شحن)\nمثال: قاموا بالكثير من تجارتهم الخارجية في سفن أجنبية",
 "うんそうにん": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "うんそうひん": "شحن البضائع (نقل البضائع تجارياً بأسعار أرخص من أسعار النقل السريع) / بضاعة منقولة, حمولة (بضائع تحملها مركبة كبيرة) / أجرة الشحن, سعر الشحن (الرسم لنقل شيء ما بواسطة ناقل عام)\nمثال: نحن ندفع أجرة الشحن",
 "うんそうりょう": "نقل بالعربات (عمل نقل شيء ما بعربة أو شاحنة والتخلص منه)",
 "うんたい": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "うんたら": "فُلَان, فُلَانَة (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو شخص لا يريد المتحدث ذكره)\nمثال: سمعنا ذلك من فلان و فلان.",
 "うんたらかんたら": "فُلَان, فُلَانَة (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو شخص لا يريد المتحدث ذكره)\nمثال: سمعنا ذلك من فلان و فلان.",
 "うんだい": "مِنَصَّة / رَصِيف, مِنَصَّة / اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "うんち": "بَرَّزَ, تَغَوَّطَ (خَرَجَ؛ نَبُه بعد خُمول) / بُرَاز, كَاكَا",
 "うんちゃん": "سَائِق, سَوَّاق",
 "うんちん": "أُجْرَة, تَوْصِيلَة / مُسَافِر, سَافِر (مَسَافِر: (اسم)؛ مُسَافَر: (اسم)) / طَعَام (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: أقل سامي مسافر أوتوستوب. / أجرة الشحن, سعر الشحن (الرسم لنقل شيء ما بواسطة ناقل عام)\nمثال: نحن ندفع أجرة الشحن",
 "うんっ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل .",
 "うんてん": "عَمَلِيَّة, عَمَل / عَمَلِيَّة جِرَاحِيَّة, جِرَاحَة / عَمَلِيَّات, عَمَلِيَّة / سِيَاقَة, قِيَادَة / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟",
 "うんてんけいとう": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "うんてんし": "سَائِق, سَوَّاق / صَدِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "うんてんしきん": "رأس مال تشغيلي, رأس مال عامل (أصول متاحة للاستخدام في إنتاج المزيد من الأصول)",
 "うんてんしほん": "رأس مال تشغيلي, رأس مال عامل (أصول متاحة للاستخدام في إنتاج المزيد من الأصول)",
 "うんてんしゃ": "سَائِق, سَوَّاق",
 "うんてんしゅ": "سَائِق, سَوَّاق",
 "うんてんしれいじょ": "غرفة التحكم (غرفة تضم معدات التحكم (كما في استوديو التسجيل))",
 "うんてんじかく": "تقدم (حركة إلى الأمام) / اِرْتِفَاع خَالِص, مِسَاحَة عُلْوِيَّة (المساحة الرأسية المتاحة للسماح بالمرور السهل تحت شيء ما)\nمثال: لم تحقق السفينة تقدماً يذكر في مواجهة العاصفة",
 "うんてんちゅう": "قَيْد التَّنْفِيذ, قَيْد الحَرَكَة (في حالة حركة؛ بدأ في التحرك)\nمثال: تحركت السفينة",
 "うんてんとりやめ": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما) / إبطال, إلغاء (الفعل الكلامي للإلغاء أو الفسخ أو الإبطال)",
 "うんてんめんきょ": "رُخْصَةُ سِيَاقَة, رُخْصَةُ قِيَادَة",
 "うんてんめんきょしょう": "رُخْصَةُ سِيَاقَة, رُخْصَةُ قِيَادَة\nمثال: 運転免許証を持っていますか。 — هل تملك رخصة قيادة؟",
 "うんと": "الكثير, قدراً كبيراً (إلى درجة أو مدى كبير جداً) / غالباً, كثيراً (بشكل متكرر أو بكميات كبيرة)\nمثال: أشعر بتحسن كبير",
 "うんとうびょう": "دَوْخَة, دُوَار",
 "うんとこ": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "うんとこさ": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "うんとこしょ": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "うんどう": "تَمْرِين, تَدْرِيب / تَمَرَّنَ / اِلْتِمَاس, اِسْتِئْنَاف / اِسْتَأْنَفَ / حَرَكَة",
 "うんどういん": "مرشح (سياسي يترشح لمنصب عام)",
 "うんどうか": "نَاشِط, نَاشِطَة / رِيَاضِيّ, رِيَاضِيَّة",
 "うんどうかい": "رحلة خلوية, نزهة خلوية (يوم مخصص لتجمع اجتماعي في الهواء الطلق) / يوم حافل, يوم ممتع (وقت من المتعة والنجاح غير المعتاد) / يوم رياضي (يوم للمنافسات الرياضية الخارجية) / يوم مناورات ((عسكرية) يوم للتدريبات والعروض العسكرية)",
 "うんどうかく": "إحساس حركي, حاسة العضلات (القدرة على الشعور بحركات الأطراف والجسم) / إحساس حركي, شعور بالحركة (إدراك وضعية الجسم وحركته وتوترات العضلات وما إلى ذلك)",
 "うんどうかんかく": "إحساس حركي, حاسة العضلات (القدرة على الشعور بحركات الأطراف والجسم) / إحساس حركي, شعور بالحركة (إدراك وضعية الجسم وحركته وتوترات العضلات وما إلى ذلك)",
 "うんどうがく": "علم الحركة المجردة, كينماتيكا (فرع الميكانيكا المعني بالحركة دون الإشارة إلى القوة أو الكتلة)",
 "うんどうき": "الجهاز العضلي الهيكلي (نظام العضلات والأوتار والأربطة والعظام والمفاصل والأنسجة المرتبطة بها التي تحرك الجسم وتحافظ على شكله)",
 "うんどうぎ": "ملابس رياضية (ملابس تلبس للرياضة أو للارتداء غير الرسمي)",
 "うんどうぐ": "بضائع رياضية, سلع رياضية (معدات رياضية تباع كسلعة)",
 "うんどうぐつ": "مُتَسَلِّل / حِذَاء رِيَاضِيّ (بمعنى الإزاء والجوار؛ النَعْل)\nمثال: أردت حذاء أحمر.",
 "うんどうこうえん": "مَلْعَب, إِسْتَاد (موضع اللَعِب عامة؛ موضع يلعب فيه الصغار، يوضع لهم فيه العاب)\nمثال: .يمشون في الملعب",
 "うんどうしっちょう": "رَنَح ((رَنَّحَ) فلان: تمايل من السكر وغيره؛ (رَنَّحَ) الشراب فلانا: جعله يرنح)",
 "うんどうしっちょうしょう": "رنح, فقدان الانتظام الحركي (عدم القدرة على تنسيق الحركات العضلية الإرادية؛ حركات غير مستقرة ومشية مترنحة)",
 "うんどうしゃ": "نَاشِط, نَاشِطَة",
 "うんどうしょうがい": "خلل الحركة, عسر الحركة (شذوذ في أداء الحركات العضلية الإرادية)",
 "うんどうしょうがいせいこうおんしょうがい": "رتة, عسر التلفظ (ضعف القدرة التعبيرية الناتجة عن عيوب في الأعصاب الحركية المحيطية أو في عضلات الكلام)",
 "うんどうしんけい": "عصب حركي, عصب صادر (عصب ينقل النبضات باتجاه أو إلى العضلات أو الغدد) / مُنْعَكَس",
 "うんどうじょう": "ملعب, ميدان اللعب (قطعة أرض مجهزة لممارسة لعبة ما) / مجال تنافس, ملعب (الظروف التي تجري في ظلها المنافسة)\nمثال: هلل الجمهور عندما نزل فريق برينستون إلى الملعب",
 "うんどうせい": "تحرك, حركة (تغير في الموضع لا يستلزم تغيراً في الموقع الجغرافي) / حَرَكِيَّة, قُدْرَة عَلَى الحَرَكَة الذَّاتِيَّة (القدرة على التحرك بشكل عفوي ومستقل)\nمثال: كشفت الحركة الانعكاسية لحواجبه عن مفاجأته",
 "うんどうせいこうおんしょうがい": "رتة, عسر التلفظ (ضعف القدرة التعبيرية الناتجة عن عيوب في الأعصاب الحركية المحيطية أو في عضلات الكلام)",
 "うんどうせんしゅ": "رِيَاضِيّ, رِيَاضِيَّة",
 "うんどうのうりょく": "تحرك, حركة (تغير في الموضع لا يستلزم تغيراً في الموقع الجغرافي) / حَرَكِيَّة, قُدْرَة عَلَى الحَرَكَة الذَّاتِيَّة (القدرة على التحرك بشكل عفوي ومستقل)\nمثال: كشفت الحركة الانعكاسية لحواجبه عن مفاجأته",
 "うんどうば": "ملعب, ميدان اللعب (قطعة أرض مجهزة لممارسة لعبة ما) / مجال تنافس, ملعب (الظروف التي تجري في ظلها المنافسة)\nمثال: هلل الجمهور عندما نزل فريق برينستون إلى الملعب",
 "うんどうひしつ": "قشرة حركية, منطقة حركية (المنطقة القشرية التي تؤثر على الحركات الحركية)",
 "うんどうぶそく": "خمول, ركود (حالة عدم النشاط أو قلة النشاط) / خمول, عطالة (الميل للبقاء غير نشط أو خامل) / جمود, خمول (حالة عدم النشاط)\nمثال: كان عليه التغلب على عطالته والعودة للعمل",
 "うんどうや": "قشرة حركية, منطقة حركية (المنطقة القشرية التي تؤثر على الحركات الحركية)",
 "うんどうらん": "القسم الرياضي (قسم الصحيفة الذي يغطي الأخبار الرياضية)",
 "うんどうりつ": "تحرك, حركة (تغير في الموضع لا يستلزم تغيراً في الموقع الجغرافي) / حَرَكِيَّة, قُدْرَة عَلَى الحَرَكَة الذَّاتِيَّة (القدرة على التحرك بشكل عفوي ومستقل)\nمثال: كشفت الحركة الانعكاسية لحواجبه عن مفاجأته",
 "うんどうりょう": "زَخَم حَرَكَة (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…) / زَخَم (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…)\nمثال: يمكنك أن تتعلم بنفس الزخم في المكتبة كما في المدرسة. / قشرة حركية, منطقة حركية (المنطقة القشرية التي تؤثر على الحركات الحركية)",
 "うんどうりょく": "دفعة, قوة دافعة مفاجئة (فعل تطبيق قوة فجأة) / اندفاع, حافز (قوة تحرك شيئاً ما للأمام)\nمثال: الدفعة المفاجئة أسقطته أرضاً",
 "うんどうエネルギー": "طَاقَة حَرَكِيَّة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: طلب بطاقة اعتماد.",
 "うんどうニューロン": "عصبون حركي (عصبون ينقل النبضات من الدماغ أو الحبل الشوكي إلى الخارج)",
 "うんなんみんぞくだいがく": "ين (المبدأ الأنثوي السلبي المظلم في علم الكونيات المزدوج الصيني)\nمثال: تفاعل الين واليانغ يحافظ على انسجام الكون",
 "うんにゃ": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / نَعَم (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…) / لَا, لَاءَان (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "うんぬん": "إلخ, وما إلى ذلك (الاستمرار بنفس الطريقة) / تَعْلِيق, مَلْحُوظَة / عَلَّقَ",
 "うんぬんかんぬん": "إلخ, وما إلى ذلك (الاستمرار بنفس الطريقة)",
 "うんのいい": "مَحْظُوظ, جَالِب للحَظّ",
 "うんのう": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "うんのよい": "مَحْظُوظ, جَالِب للحَظّ",
 "うんのわるい": "سَيِّئُ الطَّالِع, مَنْحُوس (يَتَّسِمُ بِسُوءِ الحَظِّ أَوْ يُنْذِرُ بِهِ) / سيء الحظ, نحس (لديه أو يجلب سوء الحظ)\nمثال: الجمعة الثالث عشر تاريخ منحوس",
 "うんぱん": "نَقَلَ / نَقْل",
 "うんぱんさよう": "نَقْل, نَقْلِيَّات",
 "うんぱんせん": "باخرة شحن, سفينة تجارية (سفينة شحن)\nمثال: قاموا بالكثير من تجارتهم الخارجية في سفن أجنبية",
 "うんぱんにん": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "うんぱんアールエヌエー": "حمض نووي ريبوزي ناقل (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "うんぴつ": "الخط, فن الخط (الكتابة اليدوية الجميلة)",
 "うんぼ": "ميكا (أي من المعادن المختلفة المكونة من سيليكات مائية للألمنيوم أو البوتاسيوم وغيرها والتي تتبلور في أشكال تسمح بانقسامها إلى أوراق رقيقة جداً)",
 "うんめい": "قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب.",
 "うんめいてき": "مَحْتُوم, مُقَدَّر ((يُتبع عادة بـ 'أن') محكوم بالقدر) / ذَاهِب, مُتَّجِه (متجه أو ينوي التوجه في اتجاه معين)",
 "うんめいのいたずら": "سُخْرِيَة / مُفَارَقَة / تَهَكُّم (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى عَلَيْهِ، عَبَثَ بِهِ. تَهَكَّمَ صَاحِبَهُ) / تَعَارُض / تَنَافُر / اِسْتِهْزَاء",
 "うんめいろん": "جبرية (مذهب فلسفي يرى أن جميع الأحداث محددة مسبقاً لكل الأوقات وأن البشر عاجزون عن تغييرها) / إيمان بالقضاء والقدر, قدرية (موقف ذهني خاضع ناتج عن قبول عقيدة أن كل ما يحدث مقدر سلفاً وحتمي)",
 "うんめいろんしゃ": "جبري, قدري (من أو متعلق بالقدرية (الإيمان بالقضاء والقدر المحتوم)) / حتمي, قدري (أي شخص يسلم بالاعتقاد بأنه عاجز عن تغيير قدره)\nمثال: شخص قدري",
 "うんめいろんじゃ": "جبري, قدري (من أو متعلق بالقدرية (الإيمان بالقضاء والقدر المحتوم)) / حتمي, قدري (أي شخص يسلم بالاعتقاد بأنه عاجز عن تغيير قدره)\nمثال: شخص قدري",
 "うんめぇ": "لَذِيذ / شَهِيّ / مَاهِر, حَاذِق",
 "うんめえ": "لَذِيذ / شَهِيّ / مَاهِر, حَاذِق",
 "うんめー": "لَذِيذ / شَهِيّ / مَاهِر, حَاذِق",
 "うんも": "ميكا (أي من المعادن المختلفة المكونة من سيليكات مائية للألمنيوم أو البوتاسيوم وغيرها والتي تتبلور في أشكال تسمح بانقسامها إلى أوراق رقيقة جداً)",
 "うんやらかんやら": "فُلَان, فُلَانَة (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو شخص لا يريد المتحدث ذكره)\nمثال: سمعنا ذلك من فلان و فلان.",
 "うんゆ": "نَقْل, نَقْلِيَّات",
 "うんゆぎょうしゃ": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "うんゆほあんきょく": "إدارة أمن النقل (وكالة تأسست عام 2001 لحماية أنظمة النقل الأمريكية وضمان السفر الجوي الآمن)",
 "うんゆりょう": "مُرُور",
 "うんよう": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد / عَمَلِيَّة, عَمَل / عَمَلِيَّة جِرَاحِيَّة, جِرَاحَة / عَمَلِيَّات, عَمَلِيَّة",
 "うんよういたく": "اِنْتِدَاب, حُكْم",
 "うんようしゃ": "داهية, محتال ذكي (شخص ذكي أو عديم المبادئ يعرف كيفية التحايل على الصعوبات لتحقيق أهدافه) / عامل تشغيل, مُشَغِّل (وكيل يقوم بتشغيل جهاز أو آلة) / مُشغِّل (شخص يمتلك أو يدير عملاً تجارياً) / مشغل, مضارب محترف (مضارب يتداول بقوة في أسواق الأسهم أو السلع)\nمثال: مشغل لوحة المفاتيح",
 "うんようちょう": "رئيس البحارة (ضابط صف على سفينة تجارية يراقب عمل البحارة الآخرين)",
 "うんようほうほう": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "うんよく": "لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "うんりゅうすい": "غَيْر آلِيّ, يَدَوِيّ التَّشْغِيل (يعمل باليد وبتشغيل يدوي)",
 "うんりょう": "تغيم, غطاء سحابي (حالة السماء عندما تكون مغطاة بالسحب)",
 "うんわるく": "بكل أسف, لسوء الحظ (بسبب سوء الحظ)\nمثال: لسوء الحظ أمطرت طوال اليوم",
 "うんゲー": "لعبة حظ (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "うん悪く": "بكل أسف, لسوء الحظ (بسبب سوء الحظ)\nمثال: لسوء الحظ أمطرت طوال اليوم",
 "うん気": "حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد.",
 "うん薹": "اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب.",
 "うーす": "يَاه, اسمع / هَلَا / نَعَم سَيِّدِي (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: أنت نعم الطالب.",
 "うーわ": "آهٍ (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي)\nمثال: آه ، هناك فراشة!",
 "うーん": "غرفة الطوارئ (غرفة في مستشفى أو عيادة مزودة بطاقم ومعدات لتوفير رعاية طارئة للأشخاص الذين يحتاجون إلى علاج طبي فوري) / إيربيوم (عنصر فلزي ثلاثي التكافؤ من مجموعة الأتربة النادرة)",
 "う蝕": "تسوس, تسوس الأسنان (منطقة لينة متآكلة في السن؛ ويمكن أن يؤدي التسوس التدريجي إلى موت السن)",
 "うｐ": "حَمّل (رَفَعَ، أَقَلَّ) / تَحْمٍيْل\nمثال: حمل سامي سلاحه.",
 "う～ん": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل .",
 "え": "أَطْعَمَ, غَذَّى / طُعْم (ذَاقَ)\nمثال: أحب طعم البطيخ. / قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب. / عَلَاقَة, مُنَاسَبَة / صِلَة, عَلَاقَة / أُلْفَة, انْجِذَاب (انجذاب طبيعي أو شعور بالقرابة) / أُلْفَة, تَجَانُس (تشابه متأصل بين الأشخاص أو الأشياء) / ألفة, انجذاب كيميائي (القوة التي تجذب الذرات لبعضها وتربطها معاً في جزيء) / ألفة ((في المناعة) الانجذاب بين مستضد وجسم مضاد)\nمثال: انجذاب للسياسة / جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع / صُورَة, تَصْوِير / صُورَة, صُورَة شَمْسِيَّة / صُورَة / اِنْطِبَاع, سُمْعَة / ثَغْر, ثَغْر بَحْرِيّ (ثَغَرَ الجدارَ ونحوهَ يَثْغَرُ ثَغْرًا: أحدث فيه ثُلْمة؛ ثَغَرَ فلانًا: كسر أسنانه) / مِقْبَض / سَاق / معلومات (مصطلح غير رسمي للمعلومات)\nمثال: أعطني المعلومات حول خط أجهزة الكمبيوتر الجديد الخاص بك / بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / يَاه, اسمع / هَلَا / حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت.",
 "え〜": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق. / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "え〜と": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق.",
 "えい": "شُعَاع / شِفْنِين, شِفْنِين بَحْرِيّ / حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة. / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة. / كافٍ, وافٍ (كمية يمكن أن تلبي حاجة أو متطلبًا ولكن دون أن تكون وفيرة)\nمثال: طعام كافٍ / مجد, مربح (يدر مكسباً مادياً أو ربحاً)\nمثال: مضاربة مربحة في سوق الأسهم / حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق. / سَفَاة / حدة, خشونة (قسوة في الأسلوب) / تَمَايُز, حِدَّة (صفة كون الشيء حاداً وواضحاً) / حدة (رقة الحافة أو دقة الطرف) / حدة (صفة الشعور بالشيء بحدة وألم شديد)\nمثال: حدة خسارتها / نَصْل (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة الحادّة الجارحة)\nمثال: لن نصل إلى أي مكان. / سُكْرٌ (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام)\nمثال: حرمني من السكر. / دُوَار اَلْبَحْر (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار. / الْمَمْلَكَةُ الْمُتَّحِدَة / إِنْجِلِيزِيّ إِنْكِلِيزِيّ, إنْقِليزي (ٌ مُذَكَّرَةٌ إِلَى إِنْجِلْتِرَا، أَوْ الْإِنْجْلِيزْ) / إِنْجِلِيزِيّ, إِنْجِلِيزِيَّة (ٌ مُذَكَّرَةٌ إِلَى إِنْجِلْتِرَا، أَوْ الْإِنْجْلِيزْ)\nمثال: ما أكتبه ليس إنجليزية. / سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ) / ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب. / شَرَف, عِزَّة (شَرَف) / شَرَف (شَرَف)\nمثال: لا أستحق هذا الشرف. / اِزْدِهَار, رَخَاء / تِلَاوَة / مُؤَلَّف, مُصَنَّف",
 "えいい": "بشوق, بلهفة\nمثال: كانت الأخبار منتظرة بلهفة / شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل.",
 "えいいん": "جهاز فاكس, فاكس (ناسخة ترسل النسخة عن طريق السلك أو الراديو) / صورة طبق الأصل, فاكسيميلي (نسخة طبق الأصل أو استنساخ) / الْمَمْلَكَةُ الْمُتَّحِدَة",
 "えいうんがん": "غرايزن (صخر جرانيتي يتكون من الكوارتز والميكا)",
 "えいえい": "إِلَى الْأَبَد (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي. / رمي ثقيل, قذف بجهد (رمي شيء ثقيل (بجهد كبير)) / رفع بجهد (فعل رفع شيء بجهد كبير) / لهاث (التنفس بصعوبة وثقل (كما يحدث بعد المجهود)) / تمايل, تموج (حركة تصاعدية (خاصة الارتفاع والانخفاض الإيقاعي))\nمثال: أعطاها دفعة قوية / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "えいえいおう": "مرحى, هتاف النصر (هتاف النصر)\nمثال: دعونا نعطي الفريق هتافاً كبيراً",
 "えいえいおー": "مرحى, هتاف النصر (هتاف النصر)\nمثال: دعونا نعطي الفريق هتافاً كبيراً",
 "えいえいご": "اَلْإِنْجِلِيزِيَّة اَلْبِرِيطَانِيَّة",
 "えいえん": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "えいえんのせいめい": "حياة أبدية, خلود (حياة بلا بداية أو نهاية)",
 "えいえんのねむり": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "えいおう": "ملك إنجلترا (الحاكم السيادي لإنجلترا عندما يكون ذكراً)",
 "えいおおもじ": "حرف كبير, كابيتال (أحد الأحرف الأبجدية الكبيرة المستخدمة كأول حرف في كتابة أو طباعة الأسماء العلمة وللتأكيد أحياناً)",
 "えいおん": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة.",
 "えいか": "قَصِيدَة, شِعْر / برة, حبة (فاكهة جافة تشبه البذور تنتجها الحشائش النجيلية: مثل القمح والشعير والذرة) / جُنَيْه, جُنَيْه إِسْتَرْلِينِيّ / انفجار جوي (انفجار في الغلاف الجوي)",
 "えいかく": "زَاوِيَة حَادَّة",
 "えいかくさんかくけい": "مُثَلَّث حَادّ الزَّوَايَا",
 "えいかくさんかっけい": "مُثَلَّث حَادّ الزَّوَايَا",
 "えいかくてき": "ذو زوايا, زاوي (له زوايا أو شكل زاوي) / زاوي (يقاس بواسطة زاوية أو بمعدل تغير الزاوية)\nمثال: زخم زاوي",
 "えいかだん": "فتيل التوقيت (فتيل مصنوع ليحترق لفترة زمنية محددة (خاصة لتفجير قنبلة))",
 "えいかん": "تكريم, جائزة (رمز ملموس يدل على الاستحسان أو التميز) / تكريم, شرف (حالة كونه مكرماً)\nمثال: جائزة للشجاعة / شَرَف, عِزَّة (شَرَف) / شَرَف (شَرَف)\nمثال: لا أستحق هذا الشرف. / تأثر, حساسية (القدرة على الاستجابة للتغيرات الوجدانية في البيئة الشخصية) / حساسية (القدرة على الاستجابة للمحفزات الفيزيائية أو تسجيل كميات فيزيائية صغيرة أو فروق) / تحسس, حساسية ((علم وظائف الأعضاء) الاستجابة للمحفزات الخارجية؛ ملكة الإحساس) / حساسية (الحساسية للمشاعر العاطفية (للذات وللآخرين))\nمثال: جلفانومتر ذو حساسية شديدة",
 "えいが": "فِلْم (شريط من السِّلِيلُوز تعلوه قشرة من الجلاتين ومن برومور الفِضَّة يستعمل للتصوير الفوتوغرافي والسينمائي؛ قصة سينمائية، نتاج سينمائي: «فلم تاريخي») / شَرِيط / فِيلْم سِينَمَائِيّ / تَصْوِير مُتَحَرِّك\nمثال: استمر الفلم ساعتين. / اِزْدِهَار, رَخَاء / قَصِيدَة, شِعْر",
 "えいがかん": "دار عرض سينمائي, سينما (مسرح تُعرض فيه الأفلام)",
 "えいがかんとく": "مُخْرِج, مُخْرِجَة",
 "えいががっこう": "مدرسة سينما (أي مؤسسة تعليمية مخصصة لتدريس جوانب صناعة الأفلام، بما في ذلك مواضيع مثل إنتاج الأفلام ونظرية الفيلم وإنتاج الوسائط الرقمية وكتابة السيناريو)",
 "えいがけんきゅう": "دراسات سينمائية (تخصص أكاديمي يتعامل مع مختلف المناهج النظرية والتاريخية والنقدية للأفلام)",
 "えいがげいじゅつかがくきょうかい": "أكاديمية فنون وعلوم الصور المتحركة (أكاديمية تمنح جوائز سنوية للإنجازات في إنتاج الصور المتحركة والأداء)",
 "えいがさい": "مهرجان أفلام, مهرجان سينمائي (مهرجان سينمائي يعرض الأفلام (عادة الأفلام المنتجة خلال العام الماضي))",
 "えいがさっか": "سينمائي مبدع, مخرج مؤلف (صانع أفلام له أسلوب شخصي ويحتفظ بالسيطرة الإبداعية على أعماله)",
 "えいがはいゆうくみあい": "تدلي, ترهل (شكل يتدلى أو يهبط للأسفل)\nمثال: كان هناك هبوط في مقعد الكرسي",
 "えいがゆしゅつきょうかい": "فيلم, فيلم سينمائي (شكل من أشكال الترفيه يجسد قصة بالصوت وتسلسل من الصور يعطي وهماً بالحركة المستمرة)\nمثال: ذهبوا لمشاهدة فيلم كل ليلة سبت",
 "えいがスター": "نجم سينمائي (نجم يلعب أدوار البطولة في السينما)",
 "えいき": "مَرْحَلَة / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة. / شَجَاعَة, جَسَارَة",
 "えいきごう": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة.",
 "えいきゅう": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "えいきゅううんどう": "حركة أبدية (حركة تستمر إلى أجل غير مسمى دون أي مصدر خارجي للطاقة؛ مستحيلة عملياً بسبب الاحتكاك)",
 "えいきゅうきかん": "آلة الحركة الدائمة (آلة يمكنها الاستمرار في العمل إلى ما لا نهاية دون سحب طاقة من مصدر خارجي؛ مستحيلة بموجب قانون حفظ الطاقة)",
 "えいきゅうし": "سن دائمة (أي من الأسنان الـ 32 التي تحل محل الأسنان اللبنية في مرحلة الطفولة المبكرة ويمكن أن تستمر حتى الشيخوخة)",
 "えいきゅうじしゃく": "مغناطيس دائم (مغناطيس يحتفظ بمغنطته بعد إزالته من المجال المغناطيسي)",
 "えいきゅうじしゃくどうきでんどうき": "مغناطيس دائم (مغناطيس يحتفظ بمغنطته بعد إزالته من المجال المغناطيسي)",
 "えいきゅうじしゃくはつでんき": "مغناطيس دائم (مغناطيس يحتفظ بمغنطته بعد إزالته من المجال المغناطيسي)",
 "えいきゅうせい": "بقاء, ديمومة (خاصية القدرة على الوجود لمدة غير محددة)",
 "えいきゅうとうど": "تُربَةُ صَقِيعِيّة",
 "えいきゅうふへん": "دَوَام (دَوَام)\nمثال: أنا أعمل بدوام جزئي.",
 "えいきょ": "مَرْحَلَة",
 "えいきょう": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر. / لَنْدَن",
 "えいきょうか": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "えいきょうけん": "مِنْطَقَةُ نُفُوذٍ (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "えいきょうしゃ": "مُؤَثِّر",
 "えいきょうりょく": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "えいきょうをおよぼす": "أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "えいきん": "بَاوْنْد / رَطْل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ) / جُنَيْه",
 "えいぎかい": "البرلمان البريطاني (الهيئة التشريعية البريطانية)",
 "えいぎょう": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل. / إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة)",
 "えいぎょうあんない": "كَتَالُوج, فِهْرِس",
 "えいぎょういん": "بَيَّاع, بَيَّاعَة",
 "えいぎょうかつどう": "نشاط تجاري (نشاط يتم القيام به كجزء من مؤسسة تجارية)",
 "えいぎょうきょかしんせいしょ": "استمارة طلب, نموذج تقديم (نموذج يستخدم عند تقديم طلب)",
 "えいぎょうしゃ": "رَائِد أَعْمال مُتَعَهِّد / مُنَظِّم",
 "えいぎょうしゅもく": "مجال, ميدان عمل (نوع معين من المؤسسات التجارية) / تشكيلة منتجات, خط إنتاج (نوع معين من المنتجات أو البضائع)\nمثال: هم متميزون في مجالهم",
 "えいぎょうしょ": "مكتب (مكان عمل يتم فيه أداء واجبات مهنية أو كتابية)\nمثال: استأجر مكتباً في المبنى الجديد",
 "えいぎょうちゅう": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "えいぎょうねんど": "سَنَة مَالِيَّة (مقدارُ قطع الشمس البروجَ الاثني عشر ، وهي السنة الشمسيَّة، و السَّنَةُ تمامُ اثنتَيْ عشرةَ دَورةً للقمر ، وهي السنة القمرية…)\nمثال: في عمره 24 سنة.",
 "えいぎょうひ": "تكاليف التشغيل, مصاريف إدارية وعامة (نفقات صيانة الممتلكات (مثل دفع الضرائب العقارية والمرافق والتأمين)؛ لا تشمل الإهلاك أو تكلفة التمويل أو ضرائب الدخل)",
 "えいぎょうひみつ": "سر تجاري (سر (طريقة أو جهاز أو صيغة) يمنح الشركة المصنعة ميزة على المنافسة)",
 "えいぎょうひんもく": "تشكيلة منتجات, خط إنتاج (نوع معين من المنتجات أو البضائع)\nمثال: تشكيلة جميلة من الأحذية",
 "えいぎょうぶ": "إدارة المبيعات, قسم المبيعات (قسم في مؤسسة تجارية مسؤول عن بيع المنتجات أو الخدمات)",
 "えいぎょうスタッフ": "طاقم المبيعات (أولئك في شركة المسؤولون عن المبيعات)",
 "えいぎょうスマイル": "خِدْمَة اَلْعُمَلَاء",
 "えいぎょうトーク": "خِطَاب الْبَيْع, عَرْض تَرْوِيجِيّ (ترويج عن طريق الحجة والبرهان)",
 "えいぎょうパーソン": "بَيَّاع, بَيَّاعَة",
 "えいぎょうマン": "بَيَّاع, بَيَّاعَة",
 "えいけい": "لَنْدَن / حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / شَدِيد\nمثال: عندك ذاكرة حادة.",
 "えいけつ": "بَطَل, بَطَلَة",
 "えいけん": "دراسات سينمائية (تخصص أكاديمي يتعامل مع مختلف المناهج النظرية والتاريخية والنقدية للأفلام)",
 "えいこ": "تبدل (صَارَ غير ما كان؛ اتخذ شيئا بدلا من شيء) / تقلب الأحوال\nمثال: لم لا تبدل ملابسك؟",
 "えいこう": "سحب, قطر (فعل سحب شيء (مثل مركبة) بواسطة حبل أو مشبك)\nمثال: سحبته الشاحنة إلى المرآب / مَجْد, جَلَال (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد به) / مَجْد, شَرَف (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد به)\nمثال: المجد لأوكرانيا",
 "えいこうあれ": "مَجْد, جَلَال (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد به) / مَجْد, شَرَف (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد به)\nمثال: المجد لأوكرانيا",
 "えいこうだん": "طلقة تتبع, طلقة كاشفة (ذخيرة يمكن ملاحظة مسارها من خلال أثر دخاني)",
 "えいこうらん": "خنجر إسباني (يوكا شجرية من جنوب غرب الولايات المتحدة وشمال المكسيك بأوراق سيفية الشكل وزهور بيضاء) / خنجر إسباني, يوكا مجيدة (يوكا من جنوب شرق الولايات المتحدة تشبه الحراب الإسبانية ولكن بجذع أقصر وأوراق أنعم)",
 "えいこく": "الْمَمْلَكَةُ الْمُتَّحِدَة\nمثال: 英国へ行ったことがありますか。 — هل سبق أن زرت بريطانيا؟",
 "えいこくおうりつげいじゅつがくいん": "الأكاديمية الملكية, الأكاديمية الملكية للفنون (أكاديمية فخرية في لندن (تأسست عام 1768) تهدف إلى زراعة الرسم والنحت والهندسة المعمارية في بريطانيا)",
 "えいこくがくしいん": "مَجْمَع, جَامِعَة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة) / مَجْمَع, أَكَادِيمِيَّة (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "えいこくぎかい": "البرلمان البريطاني (الهيئة التشريعية البريطانية)",
 "えいこくこっきょうかい": "الكنيسة الإنجليكانية, كنيسة إنجلترا (الكنيسة الوطنية لإنجلترا (وجميع الكنائس الأخرى في بلدان أخرى تشاركها معتقداتها)؛ مقرها في كانتربري والملك هو رئيسها الزمني)",
 "えいこくじん": "بَرِيطَانِيّ, بَرِيطَانِيَّة (مِنْ، أو متعلق بالمملكة المتحدة أو بريطانيا بمعانيها الأخرى)\nمثال: توم مواطن بريطاني.",
 "えいこくなんきょくけんきゅうじょ": "بكالوريوس الآداب, ليسانس الآداب (درجة البكالوريوس في الآداب والعلوم الإنسانية) / باريوم (عنصر فلزي فضي ناعم من مجموعة الأتربة القلوية)",
 "えいこくほうそうきょうかい": "بِي بِي سِي",
 "えいこくみん": "بَرِيطَانِيّ, بَرِيطَانِيَّة (مِنْ، أو متعلق بالمملكة المتحدة أو بريطانيا بمعانيها الأخرى)\nمثال: توم مواطن بريطاني.",
 "えいこくりくぐんとくしゅくうていぶたい": "القوة الجوية الخاصة (فوج متخصص في الجيش البريطاني مدرب على تقنيات حرب الكوماندوز ويستخدم في العمليات السرية (خاصة ضد الجماعات الإرهابية))",
 "えいこもじ": "حرف صغير (الأحرف التي كانت تُحفظ سابقاً في النصف السفلي من صندوق حروف الطباعة)",
 "えいこんだん": "طلقة تتبع, طلقة كاشفة (ذخيرة يمكن ملاحظة مسارها من خلال أثر دخاني)",
 "えいご": "ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي. / إِنْجِلِيزِيّ إِنْكِلِيزِيّ, إنْقِليزي (ٌ مُذَكَّرَةٌ إِلَى إِنْجِلْتِرَا، أَوْ الْإِنْجْلِيزْ) / إِنْجِلِيزِيّ, إِنْجِلِيزِيَّة (ٌ مُذَكَّرَةٌ إِلَى إِنْجِلْتِرَا، أَوْ الْإِنْجْلِيزْ)\nمثال: ما أكتبه ليس إنجليزية. / حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "えいごう": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "えいごがっか": "قسم اللغة الإنجليزية (القسم الأكاديمي المسؤول عن تدريس الأدب الإنجليزي والأمريكي)",
 "えいごきそのうりょくしけん": "اللغة الإنجليزية (لغة هندية أوروبية تنتمي للفرع الجرماني الغربي؛ اللغة الرسمية لبريطانيا والولايات المتحدة ومعظم دول الكومنولث)",
 "えいごきょうし": "معلم لغة إنجليزية (شخص يدرس اللغة الإنجليزية)",
 "えいごけん": "نَاطِقٌ بِالإِنْجِلِيزِيَّة (قادر على التواصل باللغة الإنجليزية)",
 "えいごげき": "تمثيل, عرض مسرحي (أداء لمسرحية)",
 "えいごじゅく": "مدرسة خاصة (مدرسة تم إنشاؤها وإدارتها بشكل خاص ومدعومة بالأوقاف والرسوم الدراسية)",
 "えいごじん": "نَاطِقٌ بِالإِنْجِلِيزِيَّة (قادر على التواصل باللغة الإنجليزية)",
 "えいさい": "عَبْقَرِيّ, نَابِغَة / عَبْقَرِيَّة",
 "えいさいきょういく": "تربية خاصة, تعليم خاص (تعليم الأطفال ذوي الإعاقات الجسدية أو العقلية الذين لا يمكن تلبية احتياجاتهم في فصل دراسي عادي)",
 "えいしゃ": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها. / عَاكِسٌ لِلضَّوْء (يُسبِّب الانعكاس أو يحتوي على جهاز عاكس) / سَبَّاح, عَوَّام / ثُكْنَة, قَشْلَة",
 "えいしゃき": "جِهَاز إِسْقَاط",
 "えいしゃく": "اللوردات, النبلاء (أقران المملكة (اللوردات) يُعتبرون كمجموعة)",
 "えいしゃまく": "حِجَاب, سِتَارَة (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "えいしゅん": "عَبْقَرِيّ, نَابِغَة / عَبْقَرِيَّة",
 "えいしょ": "ثُكْنَة, قَشْلَة",
 "えいしょう": "نَغَم / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: عادت إلى الغناء.",
 "えいしん": "تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة",
 "えいじ": "رَضِيع / حرف, حرف أبجدي (الأحرف التقليدية للأبجدية المستخدمة لتمثيل الكلام)\nمثال: علمته جدته الحروف",
 "えいじごろし": "قتل الرضيع, وأد (قتل طفل رضيع) / قاتل الرضيع (شخص يقتل رضيعاً)",
 "えいじしゅうごう": "حرف, حرف أبجدي (الأحرف التقليدية للأبجدية المستخدمة لتمثيل الكلام)\nمثال: علمته جدته الحروف",
 "えいじゅ": "أقدمية, طول العمر (خاصية العيش طويلاً) / تعمير, طول الخدمة (مدة الخدمة أو البقاء)\nمثال: طول بقائها كنجمة / حَامِيَة",
 "えいじゅじ": "حَامِيَة",
 "えいじゅち": "حَامِيَة",
 "えいじょしょう": "أريوسو ((موسيقى) رسيتاتيف قصير لحني ولكنه ليس آريا كاملة)",
 "えいじる": "تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية) / أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك. / تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه)",
 "えいじん": "بَرِيطَانِيّ, بَرِيطَانِيَّة (مِنْ، أو متعلق بالمملكة المتحدة أو بريطانيا بمعانيها الأخرى)\nمثال: توم مواطن بريطاني.",
 "えいすう": "محارف أبجدية رقمية (مجموعة أحرف تتضمن الحروف والأرقام وعلامات الترقيم)",
 "えいずる": "تجنيد إجباري, سخرة (فعل إجبار شخص ما على الخدمة الحكومية) / أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك. / تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه)",
 "えいせい": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد. / حياة أبدية, خلود (حياة بلا بداية أو نهاية) / قَمَر, تَابِع (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث) / قَمَر اِصْطِنَاعِيّ (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف. / عِلْم الصِّحَّة, عِلْم حِفْظ الصِّحَّة (أَدْرَكَ حقيقة الشيء) / نَظَافَة, حِفْظ الصِّحَّة\nمثال: أدرس علم النفس. / مِرْحَاض, تواليت / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "えいせいかんり": "اَلصِّحَّة الْعُمُومِيَّة",
 "えいせいがく": "علم الصحة العامة, نظافة (العلم المعني بالوقاية من المرض والحفاظ على الصحة)",
 "えいせいし": "أخصائي صحة عامة (أخصائي طبي في علم الصحة)",
 "えいせいじょう": "صحي, نظيف (خالٍ من القذارة ومسببات الأمراض)\nمثال: ظروف صحية لإعداد الطعام",
 "えいせいじょうたい": "حالة صحية, وضع صحي (حالة النظافة العامة (نظيف أو قذر))",
 "えいせいてき": "صِحِّيّ, وِقَائِيّ (يميل إلى تعزيز الصحة أو الحفاظ عليها)",
 "えいせいへい": "ضابط طبي (ممارس طبي في القوات المسلحة) / فصة, نفل",
 "えいせいテレビ": "تلفزيون فضائي (نظام تلفزيوني يتم فيه إرسال الإشارة إلى قمر صناعي يدور حول الأرض يستقبل الإشارة ويضخمها ويرسلها مرة أخرى إلى الأرض)",
 "えいせいテレビほうそう": "تلفزيون فضائي (نظام تلفزيوني يتم فيه إرسال الإشارة إلى قمر صناعي يدور حول الأرض يستقبل الإشارة ويضخمها ويرسلها مرة أخرى إلى الأرض)",
 "えいせいマスク": "قناع الوجه (قناع يوفر غطاءً واقياً للوجه في رياضات مثل البيسبول أو كرة القدم أو الهوكي)",
 "えいせん": "زَوْرَق اَلْقَطْر / سحب, قطر (فعل سحب شيء (مثل مركبة) بواسطة حبل أو مشبك)\nمثال: سحبته الشاحنة إلى المرآب",
 "えいせんけい": "مُسْتَدَقّ الطَّرَف ((عن شكل الورقة) يضيق تدريجيًّا إلى طرف رفيع مُدبَّب)",
 "えいぜん": "صيانة, عناية (نشاط يتضمن الحفاظ على شيء في حالة عمل جيدة) / إعاشة, صيانة (فعل الحفاظ على الحياة بالطعام أو توفير وسائل العيش)\nمثال: ألف دليل العناية بالسيارة",
 "えいそう": "سجن عسكري, مركز حراسة (منشأة عسكرية تعمل كمقر للشرطة العسكرية ويمكن فيها احتجاز السجناء العسكريين)",
 "えいそうち": "معشش, مكان التعشيش (مكان مناسب للتعشيش)",
 "えいそん": "مَتَانَة",
 "えいぞう": "بِنَاء (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَبْنَى, بِنَاء (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: أنا وجدت البناء. / خَيَال, سَوَاد (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي. / صُورَة / اِنْطِبَاع, سُمْعَة / فِيدِيُو, فيديو / اِنْعِكَاس, عَكْس",
 "えいぞうあっしゅく": "ضغط الصور (ضغط الرسومات للتخزين أو الإرسال)",
 "えいぞうさっか": "سينمائي, صانع أفلام (منتج للأفلام السينمائية)",
 "えいぞうばいたい": "تسجيل فيديو, فيديو (تسجيل للمكونات المرئية والمسموعة (خاصة تلك التي تحتوي على تسجيل لفيلم أو برنامج تلفزيوني))",
 "えいぞうぶつ": "بِنَاء (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَبْنَى, بِنَاء (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: أنا وجدت البناء.",
 "えいぞく": "دَوَام (دَوَام)\nمثال: أنا أعمل بدوام جزئي.",
 "えいぞくせい": "حَثِيث, دَائِم (لَا يَتَوَقَّفُ أَبَدًا) / مُلَازِمٌ لِلذِّهْن, مُلِحّ (يَعُودُ إِلَى الذِّهْنِ بِاسْتِمْرَارٍ) / دائم, مستديم (باقٍ؛ لا يسقط) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: الأوراق المستديمة تبقى ملتصقة بعد النضج",
 "えいぞくてき": "دَائِم",
 "えいぞん": "مَتَانَة",
 "えいたい": "دَوَام (دَوَام)\nمثال: أنا أعمل بدوام جزئي.",
 "えいたつ": "شُهْرَة",
 "えいたん": "صِيَاح, صُرَاخ (مصدر الفعل صَاحَ؛ صوت الكائن الحي القوي)\nمثال: بدأنا في الصياح.",
 "えいだん": "كرش (مصطلحات عامية للكرش أو البطن البارز) / شركة مساهمة, مؤسسة (شركة تجارية تمت الموافقة على مواد تأسيسها في ولاية ما)",
 "えいち": "حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت.",
 "えいてん": "درجة الشرف (درجة جامعية مع مرتبة الشرف) / تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة",
 "えいとう": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / شَدِيد\nمثال: عندك ذاكرة حادة.",
 "えいどう": "هِجْرَة (ترك الأرض والخروج منها إلى أخرى؛ في الشرع: ترك الوطن الذي بين الكفار والانتقال إلى دار الإسلام قربة لله)\nمثال: الهجرة النبوية.",
 "えいどく": "الْمَمْلَكَةُ الْمُتَّحِدَة",
 "えいねん": "دهر, سنوات (فترة زمنية طويلة)\nمثال: نحن نعرف بعضنا منذ دهر",
 "えいねんざいしょくぎいん": "عَرِيق, قَدِيم العَهْد (مَوْجود مُنْذُ فَتْرَة طَويلَة)",
 "えいのう": "زراعة, عمل في الأرض (الزراعة باعتبارها مهنة أو أسلوب حياة) / زراعة, فلاحة (ممارسة زراعة الأرض أو تربية الماشية)\nمثال: الزراعة حياة شاقة",
 "えいびん": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة. / حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء.",
 "えいふつ": "الأنجلو فرنسية, الأنجلو نورماندية (اللغة الفرنسية (النورماندية) المستخدمة في إنجلترا في العصور الوسطى)",
 "えいふつかいきょう": "بَحْر الْمَانْش, الْمَانْش (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "えいぶんか": "قسم اللغة الإنجليزية (القسم الأكاديمي المسؤول عن تدريس الأدب الإنجليزي والأمريكي)",
 "えいへい": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "えいへいじょ": "سجن عسكري, مركز حراسة (منشأة عسكرية تعمل كمقر للشرطة العسكرية ويمكن فيها احتجاز السجناء العسكريين)",
 "えいべい": "أنجلو-أمريكي (أمريكي ولد في بريطانيا أو من أجداد بريطانيين)",
 "えいべいほう": "أنجلو-أمريكي (أمريكي ولد في بريطانيا أو من أجداد بريطانيين)",
 "えいみん": "راحة أبدية, رقاد (تعابير ملطفة للموت (بناءً على تشبيه بين الاستلقاء في السرير وفي القبر))\nمثال: وريت الثرى (رقدت) بجوار زوجها",
 "えいめい": "شُهْرَة / ذَكِيّ (ذَكِيَ: صار شديد الفطنة وسريع البديهة؛ ذكِيَ التلميذ في مهارات الحساب الدهني)\nمثال: إنه وسيم و ذكي. / مَجْد, جَلَال (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد به) / مَجْد, شَرَف (رفع شأن شيء أو شخص وعظمه وأضفى عليه قيمة كبيرة؛ أثنى على عظمة شيء أو شخص وأشاد به)\nمثال: المجد لأوكرانيا",
 "えいもじ": "حرف, حرف أبجدي (الأحرف التقليدية للأبجدية المستخدمة لتمثيل الكلام)\nمثال: علمته جدته الحروف",
 "えいや": "رمي ثقيل, قذف بجهد (رمي شيء ثقيل (بجهد كبير)) / رفع (فعل رفع شيء ما) / تقيؤ جاف, تهوع (تشنج لا إرادي لمحاولة التقيؤ دون جدوى) / رفع بجهد (فعل رفع شيء بجهد كبير)\nمثال: أعطاها دفعة قوية",
 "えいやっ": "رمي ثقيل, قذف بجهد (رمي شيء ثقيل (بجهد كبير)) / رفع (فعل رفع شيء ما) / تقيؤ جاف, تهوع (تشنج لا إرادي لمحاولة التقيؤ دون جدوى) / رفع بجهد (فعل رفع شيء بجهد كبير)\nمثال: أعطاها دفعة قوية",
 "えいゆう": "بَطَل, بَطَلَة",
 "えいゆうごうけつ": "بَطَل, بَطَلَة",
 "えいゆうしゅぎ": "بَسَالَة, بُطُولَة",
 "えいゆうすうはい": "تقديس الأبطال (الإعجاب بالرجال العظماء (أو ذكراهم))",
 "えいゆうたん": "مَلْحَمَة / مَلْحَمِيّ (متعلق بالكتب، أو الأفلام، أو الأشعار، أو بغيرها من الوسائط التي تصور دراما إنسانية على نطاق واسع، وتُعرف باسم الملحمات أو الملحميات)",
 "えいゆうてき": "بُطُولِيّ",
 "えいよ": "شرف, عفة (فضيلة المرأة أو عفتها) / شرف, كرامة (صفة كون الشخص شريفاً وذا سمعة طيبة) / تكريم, جائزة (رمز ملموس يدل على الاستحسان أو التميز) / تكريم, شرف (حالة كونه مكرماً)\nمثال: رجل شريف / بَقِيَّة",
 "えいよある": "مبجل, مشرف (يستحق التبجيل؛ يستحق الشرف والاحترام) / أَخْلَاقِيّ, شَرِيف (يلتزم بالمبادئ الأخلاقية والقِيَمية)\nمثال: رجل مبجل",
 "えいよう": "رَفَاهِيَّة, تَرَف / تَرَف (تَرِفَ النَّبَاتُ، كفَرِح: تَرَوَّى؛ تَرِفَ النَّبَات تَرَفَا: كَثُرَ مَاؤُهُ ونَضُر) / كَمَالِيّ / تَغْذِيَة (تَغْذِيَةُ الجِسْمِ: تَزْوِيدُهُ بِـالغِذَاءِ؛ في ركيزة أساسية للحياة، فهي تشمل جميع العمليات التي يُحصل من خلالها الكائن الحي على احتياجاته الغذائية. تُساهم هذه الاحتياجات في تشغيل الوظائف…) / غِذَاء / إِطْعَام / اِغْتِذَاء / طَعَام (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: لن نستمر في تغذية الانتقامات.",
 "えいようえいが": "رَفَاهِيَّة, تَرَف / تَرَف (تَرِفَ النَّبَاتُ، كفَرِح: تَرَوَّى؛ تَرِفَ النَّبَات تَرَفَا: كَثُرَ مَاؤُهُ ونَضُر) / كَمَالِيّ",
 "えいようがく": "علم الحمية, نظام غذائي (الدراسة العلمية لإعداد الطعام وتناوله)",
 "えいようがくしゃ": "أخصائي تغذية, أخصائي حميات (متخصص في دراسة الأنظمة الغذائية والتغذية)",
 "えいようざい": "مُغَذٍّ, المُغَذِّي",
 "えいようし": "أخصائي تغذية, أخصائي حميات (متخصص في دراسة الأنظمة الغذائية والتغذية)",
 "えいようしっちょう": "سُوء تَغْذِيَة",
 "えいようそ": "مُغَذٍّ, المُغَذِّي",
 "えいようたん": "كلية متوسطة, كلية مجتمع (كلية تقدم فقط السنتين الأوليين وتنتهي بدرجة مشارك)",
 "えいようてき": "غذائي (من أو يتعلق بالتغذية أو يوفرها)\nمثال: معلومات غذائية",
 "えいようふりょう": "سُوء تَغْذِيَة",
 "えいようぶそく": "سُوء تَغْذِيَة",
 "えいようぶつ": "تَغْذِيَة (تَغْذِيَةُ الجِسْمِ: تَزْوِيدُهُ بِـالغِذَاءِ؛ في ركيزة أساسية للحياة، فهي تشمل جميع العمليات التي يُحصل من خلالها الكائن الحي على احتياجاته الغذائية. تُساهم هذه الاحتياجات في تشغيل الوظائف…) / غِذَاء / إِطْعَام / اِغْتِذَاء / طَعَام (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: لن نستمر في تغذية الانتقامات.",
 "えいようぶん": "مُغَذٍّ, المُغَذِّي",
 "えいようほきゅう": "مكمل غذائي (شيء يضاف لإكمال النظام الغذائي أو لتعويض نقص غذائي)",
 "えいようほじょしょくひん": "مكمل غذائي (شيء يضاف لإكمال النظام الغذائي أو لتعويض نقص غذائي)",
 "えいようドリンク": "مَشْرُوب الطَّاقَة",
 "えいらん": "إِنْجِلْتِرَا (منطقة في بِرِيطَانِيَا الْعُظْمَى، تقع بشرق وِيلْز، وجنوب إِسْكُتْلَنْدَا؛ عاصمتها لُنْدُن؛ وهي إحدى الدول المكونة للمملكة المتحدة) / إِنْقِلْتِرَا / إِنْكِلْتِرَا / إِنْكِلْتِرَة\nمثال: أنا من إنجلترا.",
 "えいらんたい": "طحلب آيسلندا (أشنة ذات ثالوس مسطح متفرع منتصب جزئياً ينمو في المناطق الجبلية والقطبية الشمالية؛ يستخدم كدواء أو غذاء للبشر والماشية؛ مصدر للجلسرين)",
 "えいり": "مُتَسَلِّع, مُسَوَّق (مُنظّم أساساً لتحقيق الربح المالي) / حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة. / حَيّ, نَابِض (يستحضر صورًا حيّة ونابضة في الذهن) / تصويري (متعلق بالصور أو يتكون منها) / مجلة مصورة (دورية (مجلة أو صحيفة) تحتوي على العديد من الصور)\nمثال: منظور تصويري / ظِلّ, مَظَلَّة (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "えいりしゅぎ": "تجارة, تجارية (المعاملات (البيع والشراء) التي تهدف إلى توفير السلع (البضائع والخدمات))",
 "えいりてき": "إِعْلَان تِجَارِيّ",
 "えいりゅう": "صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / صفراء, عصارة صفراوية (عصارة هضمية يفرزها الكبد وتخزن في المرارة؛ تساعد في هضم الدهون) / استياء, حقد (شعور بالغضب العميق والمرارة وسوء النية) / عفصة (تورم غير طبيعي في أنسجة النبات ناتج عن الحشرات أو الكائنات الحية الدقيقة أو الإصابة)",
 "えいれい": "عَبْقَرِيّ, نَابِغَة / عَبْقَرِيَّة",
 "えいれんぽう": "الكومنولث البريطاني, رابطة الشعوب البريطانية (رابطة دول تتكون من المملكة المتحدة والعديد من المستعمرات البريطانية السابقة التي أصبحت الآن دولاً ذات سيادة لكنها لا تزال تدين بالولاء للتاج البريطاني)",
 "えいろう": "سَجْن مُؤَبَّد (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "えいん": "عِجَان",
 "えいんせっかい": "بضع الفرج (شقَّ الشيءَ أو قطعه)\nمثال: ستأخذ بضع دقائق.",
 "えいんどうみゃく": "شريان عجاني (فرع من الشريان الفروجي الداخلي يغذي التراكيب السطحية للعجان)",
 "えいアクセント": "نَبْرَة حَادَّة",
 "えいトン": "طن إنجليزي, طن طويل (وحدة وزن بريطانية تعادل 2240 رطلاً)",
 "えいポンド": "باوند, جنيه (وحدة المال الأساسية في بريطانيا العظمى وأيرلندا الشمالية؛ تساوي 100 بنس)",
 "えい航": "سحب, قطر (فعل سحب شيء (مثل مركبة) بواسطة حبل أو مشبك)\nمثال: سحبته الشاحنة إلى المرآب",
 "えう": "سَكِرَ, ثَمِلَ (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام) / أَسْكَرَ (الشرابُ فلانًا: جعله يَسْكَر؛ فلانٌ فلانًا: سقاهُ خمرًا فجعله يسكر)\nمثال: حرمني من السكر.",
 "ええ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق. / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "ええかげん": "غير مسؤول, مستهتر (يظهر عدم الاكتراث بالعواقب)\nمثال: تصرف كأحمق غير مسؤول / فَاتِر (الفَاتِرُ : ما بينَ الحارِّ والبارِد؛ \" اُسْتُقْبِلَ اسْتِقْبَالاً فَاتِراً \": بَارِداً لاَحَرَارَةَ فِيهِ) / كَافٍ (كِفَايَة، يَكْفِي، كَافِ؛ مَه، كَفَى) / تَمَامًا / مَه, كَفَى (اسم فعل بمعنى إنْكَفِفْ أو تَوَقَّفْ، ويقال مَهٍ أيضاً)\nمثال: خسر كافة ممتلكاته. / إلى حد كبير, بشكل جوهري (إلى مدى أو درجة كبيرة)\nمثال: أخشى أن الفيلم تجاوز الميزانية بكثير",
 "ええっと": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق.",
 "ええと": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق.",
 "ええん": "لِسَان اَلْمِزْمَار (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق؛ جَارِحَة الْكَلَام؛ كَلِمَة)\nمثال: ماري لها فم ليس لها لسان.",
 "ええんなんこつ": "لِسَان اَلْمِزْمَار (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق؛ جَارِحَة الْكَلَام؛ كَلِمَة)\nمثال: ماري لها فم ليس لها لسان.",
 "ええ加減": "غير مسؤول, مستهتر (يظهر عدم الاكتراث بالعواقب)\nمثال: تصرف كأحمق غير مسؤول / فَاتِر (الفَاتِرُ : ما بينَ الحارِّ والبارِد؛ \" اُسْتُقْبِلَ اسْتِقْبَالاً فَاتِراً \": بَارِداً لاَحَرَارَةَ فِيهِ) / كَافٍ (كِفَايَة، يَكْفِي، كَافِ؛ مَه، كَفَى) / تَمَامًا / مَه, كَفَى (اسم فعل بمعنى إنْكَفِفْ أو تَوَقَّفْ، ويقال مَهٍ أيضاً)\nمثال: خسر كافة ممتلكاته. / إلى حد كبير, بشكل جوهري (إلى مدى أو درجة كبيرة)\nمثال: أخشى أن الفيلم تجاوز الميزانية بكثير",
 "えおじ": "عَمّ, خَال (هو أخ الأب؛ في : هو إضافة إلى الفعل المضارع تشبه سَوْفَ إلا أنها تستخدم للتعبير عن الحاضر المستمر)\nمثال: أنا وهو أولاد عم.",
 "えかき": "رَسَّام, رَسَّامَة (الفَنَّان الذي يَصْنَعُ الرُّسُومَ) / دَهَّان, دَهَّانَة\nمثال: إنه رسام مشهور. / خربشة, شخبطة (رسم بلا هدف)",
 "えがお": "اِبْتِسَامَة, بَسْمَة / اِبْتَسَمَ",
 "えがきだす": "محدد, ممثل (تم تمثيله بدقة أو تحديده)",
 "えがきて": "فَنَّان, فَنَّانَة (من يصنع الفَنَّ، من يمتهنه؛ مَوْهُوب)\nمثال: إنه فنان مشهور.",
 "えがく": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم. / وَصَفَ / تَخَيَّلَ, تَصَوَّرَ",
 "えがら": "نُمُوذَج, نَمَط",
 "えがらい": "حَارِق, لَاذِع (قاسٍ أو كاوٍ في اللهجة) / حِرِّيف, نَفَّاذ (قَوِيٌّ وَحَادُّ الطَّعْمِ أَوِ الرَّائِحَة)",
 "えがらっぽい": "مُتَضَايِق, مُنْزَعِج (أُثير فيه نفاد الصبر أو الغضب) / حَارِق, لَاذِع (قاسٍ أو كاوٍ في اللهجة) / حِرِّيف, نَفَّاذ (قَوِيٌّ وَحَادُّ الطَّعْمِ أَوِ الرَّائِحَة)",
 "えき": "سَائِل, مَائِع / مَحَطَّة السِّكَك الْحَدِيدِيَّة, مَحَطَّة / حَرْب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / مُحَارَبَة / حرب (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك) / حَارَبَ, شَنَّ حَرْبًا\nمثال: بوتين مجرم حرب. / عمل قسري (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل. / فَائِدَة, جَدْوَى\nمثال: 労なくして益なし。 — كل شيء وله ثمن / رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "えきあつプレス": "مكبس هيدروليكي (مكبس تنتقل فيه القوة المطبقة بواسطة مكبس على مساحة صغيرة عبر الماء إلى مكبس آخر ذي مساحة كبيرة)",
 "えきえき": "باهِر / كَبِير, وَاسِع (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير.",
 "えきか": "إسالة (تحويل مادة صلبة أو غازية إلى سائل) / إِبْط (ما تحت الذراع بين ال المتن والمنكب؛ إبط الحيوان: ما تحت منكبه، ما يعادل إبط الإنسان عنده) / محطة البريد, نزل البريد (نزل لتبادل خيول البريد واستيعاب الفرسان)",
 "えきかせきゆガス": "غاز معبأ, غاز نفطي مسال (غازات هيدروكربونية، عادة البروبان أو البوتان، محفوظة تحت الضغط)",
 "えきかてんねんガス": "غَاز طَبِيعِيّ مُسَال",
 "えきかどうみゃく": "شريان إبطي (جزء من الشريان الرئيسي للذراع يقع في الإبط وهو استمرار للشريان تحت الترقوة من الأعلى والشريان العضدي من الأسفل)",
 "えきが": "مَاصّ / مُغَفَّل",
 "えきがく": "عِلْم أَوْبِئَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
