{
 "いっぺんに": "حَالاً (مباشرةً، فوراً، دون تأخير؛ في هذه الأثناء، في الوضع الحالي)\nمثال: سأكون معك حالا. / فَوْرًا, حَالًا",
 "いっぽ": "خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة\nمثال: もう一歩も歩けないよ。 — لا يمكنني المشي خطوة أخرى. / مُسْتَوًى / مَرْحَلَة",
 "いっぽいっぽ": "خُطْوَةً خُطْوَةً, خُطْوَةً بِخُطْوَةٍ",
 "いっぽう": "مَعْلُومَات, مَعْلُومَة / وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة. / من جهة, من ناحية (من وجهة نظر واحدة)\nمثال: من ناحية، هي كيميائية موهوبة / عِنْدَمَا",
 "いっぽうこうつう": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "いっぽうそのころ": "أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ) / إِلَى حِينِ ذَلِكَ الوَقْتِ فِي الأَثْنَاءِ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / فِي حِينِ أَنَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: أما زلت تذكرني؟",
 "いっぽうつうこう": "ذُو اِتِّجَاه وَاحِد (يتحرك أو يسمح بالحركة في اتجاه واحد فقط)",
 "いっぽうてき": "أُحَادِيّ الجَانِب, مِن طَرَف وَاحِد (يشمل جزءاً أو جانباً واحداً فقط) / مُتَحَيِّز, مُنْحَاز (يُفَضِّلُ شَخْصًا أَوْ طَرَفًا عَلَى آخَر) / أحادي الوجه, غير قابل للقلب (غير قابل للعكس أو لاستخدام أي من الجانبين للخارج)\nمثال: شلل أحادي الجانب",
 "いっぽずつ": "بشكل متدرج, خطوة بخطوة (المضي في خطوات) / تَدْرِيجِيًّا, خُطْوَة بِخُطْوَة (شيء واحد في كل مرة؛ على مراحل صغيرة)\nمثال: تم زيادة الجهد بشكل متدرج",
 "いっぽん": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ / غَيْشَا / أُحَادِيُّ الْهَدَفِ, مُصَمِّمٌ (مُصَمِّم ومُنصَبّ على هدف واحد)",
 "いっぽんか": "تَوْحِيد",
 "いっぽんぎ": "أُحَادِيُّ الْهَدَفِ, مُصَمِّمٌ (مُصَمِّم ومُنصَبّ على هدف واحد)",
 "いっぽんぐそ": "نَقَانِقِيُّ الشَّكْل (على شكل النقانق)",
 "いっぽんぜおい": "أَحَادِيّ الذِّرَاع (ذو ذراع واحدة فقط)",
 "いっぽんだち": "اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع بالاكتفاء الذاتي والقدرة على اتخاذ القرارات دون تدخل خارجي)\nمثال: الصحراويون يريدون الاستقلال.",
 "いっぽんちょうし": "أُحَادِيُّ النَّغْمَة, رَتِيب (يُنْطَقُ أَوْ يُسْمَعُ بِنَغْمَةٍ ثَابِتَةٍ لَا تَتَفَاوَتُ فِي الطَّبَقَة) / رتيب, مطرد (عن التسلسل أو الدالة؛ تتزايد باستمرار ولا تتناقص أبداً أو تتناقص باستمرار ولا تتزايد أبداً في القيمة) / رتابة, صوت رتيب (تنغيم غير متغير) / نغمة رتيبة, نغمة واحدة (نغمة واحدة تتكرر بكلمات مختلفة أو إيقاعات مختلفة (خاصة في أداء النصوص الليتورجية))",
 "いっぽんぢょうし": "أُحَادِيُّ النَّغْمَة, رَتِيب (يُنْطَقُ أَوْ يُسْمَعُ بِنَغْمَةٍ ثَابِتَةٍ لَا تَتَفَاوَتُ فِي الطَّبَقَة) / رتيب, مطرد (عن التسلسل أو الدالة؛ تتزايد باستمرار ولا تتناقص أبداً أو تتناقص باستمرار ولا تتزايد أبداً في القيمة) / رتابة, صوت رتيب (تنغيم غير متغير) / نغمة رتيبة, نغمة واحدة (نغمة واحدة تتكرر بكلمات مختلفة أو إيقاعات مختلفة (خاصة في أداء النصوص الليتورجية))",
 "いっぽんとられた": "مَلْمُوس",
 "いっぽんとる": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "いっぽんゆび": "إِصْبَع (عضو مستطيل ينشعِب من طرف الكفّ أو القدم) / بَنَان (أَطْرَافُ الأَصَابِعِ) / صَبَّعَ ((صَبَعَ) به، وصَبَعَ عليه يَصْبَعُ صَبْعًا: أشار نحوه بِإِصبَعِهِ سخريةً؛ (صَبَعَ) في الشيءِ: أَدخل إصبَعَه فيه)\nمثال: كان أول ما لفت انتباهه هي بصمة الإصبع على الزجاج.",
 "いつ": "خَمْسَة, خمسة (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال. / باعث على الاسترخاء, مريح (يوفر راحة جسدية أو عقلية)\nمثال: قضت ليلة مريحة في المنزل / تَجَمَّدَ / وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة. / نَفْسَهُ, نَفْسَهَا / مِثْلَهَا, يُشْبِهَهُ",
 "いついつ": "مَتَى / إمتى / متى / امتى / فوقتاش / حِينَمَا, عِنْدَمَا",
 "いついつまでも": "إلى أجل غير مسمى (إلى حد غير محدد؛ لفترة غير محددة)\nمثال: يمكن أن يستمر هذا إلى أجل غير مسمى",
 "いつう": "ألم المعدة, مغص (وجع موضعي في المعدة أو منطقة البطن)",
 "いつえ": "خُمَاسِيّ",
 "いつか": "في وقت ما, يوماً ما (في وقت غير محدد أو غير مصرح به)\nمثال: دعنا نجتمع يوماً ما",
 "いつかしら": "غير ملحوظ (لم يتم ملاحظته)\nمثال: أمل أن يكون رحيله قد مر دون أن يلاحظه أحد",
 "いつかねつ": "حمى الخنادق (تتميز بألم في العضلات والمفاصل وينقلها القمل)",
 "いつかは": "عَاجِلاً أَم آجِلاً, عَاجِلاً أَو آجِلاً",
 "いつから": "كَم وَقْتًا, إِلَى مَتَى",
 "いつく": "هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته. / عِبَادَة / عَبَدَ, سَجَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / سَجَدَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "いつくしみ": "عاطفة, محبة (شعور إيجابي بالإعجاب)\nمثال: وجد صعوبة في التعبير عن المودة التي شعر بها",
 "いつくしむ": "حَبِيب, حَبِيبَة / أَحَبَّ, حب (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه)\nمثال: لا أحب المدرسة.",
 "いつげん": "مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "いつしか": "غير ملحوظ (لم يتم ملاحظته)\nمثال: أمل أن يكون رحيله قد مر دون أن يلاحظه أحد",
 "いつじ": "نَادِرَة / أُطْرُوفَة / أُفْكُوهَة / طُرْفَة / فُكَاهَة / لَطِيفَة (مؤنث لَطِيْف؛ ذات اللطف والطافة؛ يقصد بها أحيانا جميلة بدون أن تكون ملفتة للنظر)\nمثال: هي مدرسة لطيفة.",
 "いつせのみこと": "اَلْأَخ اَلْأَكْبَر",
 "いつぞや": "مُنْذُ بِضْعَةْ أَيَّام, بِالْأَمْس",
 "いつだって": "دَائِمًا, أَبَدًا",
 "いつだつ": "إِنْحِرَاف / إِغْفَال",
 "いつつ": "خَمْسَة, خمسة (قيمة عددية تساوي \"٥\"؛ الرقم ما بعد \"أَرْبَعَة\" وقبل \"سِتَّة\")\nمثال: رأيت خمسة رجال. / اَلسَّاعَة اَلثَّامِنَة",
 "いつつご": "خماسي (مجموعة من خمسة أشياء متشابهة تُعتبر كوحدة واحدة) / توأم خماسي (واحد من خمسة أطفال ولدوا في نفس الوقت من نفس الحمل) / خَمْسَة, خُمَاسِيّ (العدد الأصلي الذي هو مجموع أربعة وواحد)",
 "いつづける": "بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة كونه واجبَ الوجود لذاته ، فهو الأوّل بلا ابتداء ، والآخر بلا انتهاء؛ الباقي الثابتُ بعد غيره) / بَقِيَ, مَكَثَ (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: الباقي ليس مهم.",
 "いつでも": "دَائِمًا, أَبَدًا / مَتَى, مَتَى مَا / كُلَّمَا",
 "いつなりと": "مَتَى, مَتَى مَا / كُلَّمَا",
 "いつなんどき": "مَتَى / إمتى / متى / امتى / فوقتاش / حِينَمَا, عِنْدَمَا",
 "いつに": "حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان الملوم وحده / إِقْتِسَام, مُقَاسَمَة",
 "いつにない": "غَيْر مَأْلُوف (لا يُصادف عادة) / استثنائي, غير عادي (غير معتاد أو غير شائع أو غير عادي) / شاذ, عجيب (خارج عن المألوف وغير متوقع بشكل قاطع؛ غريب قليلاً أو حتى شاذ)\nمثال: مشهد ذو جمال غير عادي",
 "いつになく": "بشكل غير عادي, بشكل لافت (لدرجة أو مدى ملحوظ)\nمثال: كانت طويلة بشكل غير عادي",
