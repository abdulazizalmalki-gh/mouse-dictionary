 "いでんしくみかえ": "غرام (وحدة مترية للوزن تساوي واحداً من الألف من الكيلوغرام)",
 "いでんしげんへのアクセスとりえきはいぶん": "أكريلونتريل بوتادين ستايرين, بلاستيك إيه بي إس (فئة من البلاستيك المركب تستخدم لصنع هياكل السيارات وحافظات الحواسيب والأجهزة…)",
 "いでんしこうがく": "هندسة وراثية (تكنولوجيا إعداد الحمض النووي المؤتلف في المختبر عن طريق تقطيع جزيئات الحمض…)",
 "いでんししっかん": "اضطراب جيني, مرض وراثي (مرض أو اضطراب يتم توريثه جينياً)",
 "いでんしちず": "خريطة جينية (تمثيل رسومي لترتيب الجينات على الكروموسوم)",
 "いでんしとつぜんへんい": "طفرة جينية, طفرة نقطية ((في علم الوراثة) طفرة ناتجة عن إعادة تنظيم داخل الجزيء لجين ما)",
 "いでんしはつげん": "تعبير جيني",
 "いでんしマーカー": "واسم جيني (جين محدد ينتج سمة يمكن التعرف عليها ويمكن استخدامه في دراسات العائلة أو السكان)",
 "いでんせい": "قابل للتوريث, وراثي (قابل لأن يورَّث)\nمثال: سمات وراثية مثل لون العين",
 "いでんせいしっかん": "اضطراب جيني, مرض وراثي (مرض أو اضطراب يتم توريثه جينياً)",
 "いでんそうだん": "اسْتِشَارَة وِرَاثِيَّة (إرشاد للآباء المحتملين حول احتمالية حدوث اضطرابات وراثية في أطفالهم المستقبليين)",
 "いでんちず": "خريطة جينية (تمثيل رسومي لترتيب الجينات على الكروموسوم)",
 "いでんてき": "عَائِلِيّ, وِرَاثِيّ (يحدث بين أفراد الأسرة عادة عن طريق الوراثة)\nمثال: بحث وراثي",
 "いでんてきアルゴリズム": "خوارزمية جينية ((حوسبة) إجراء بحث يستخدم تقنيات مستوحاة من النظرية البيولوجية للاختيار الطبيعي)",
 "いでんカウンセリング": "اسْتِشَارَة وِرَاثِيَّة (إرشاد للآباء المحتملين حول احتمالية حدوث اضطرابات وراثية في أطفالهم المستقبليين)",
 "いで湯": "يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "いと": "قَصْد, إِرَادَة / خَيْط, خيط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ…)\nمثال: حل الصرة تلقى خيط. / بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً / بصدق, حقاً (وفقاً للحقيقة أو الواقع)\nمثال: أصبحت الآن أمريكية حقاً / حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه…)\nمثال: هو اغضبني حقا . / صَغِير, حَدَث",
 "いとう": "بُغْض, ضَغِينَة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "いとおしい": "جَمِيل, مَحْبُوب (يخاطب العواطف والعين معاً) / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة)",
 "いとおしがる": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة.",
 "いとおしむ": "حَبِيب, حَبِيبَة\nمثال: لا أحب المدرسة.",
 "いとおす": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود.",
 "いときりば": "ناب (واحدة من الأسنان المخروطية الأربعة المدببة (اثنتان في كل فك) تقع بين القواطع…)",
 "いとくず": "قماش للكشط, نسالة (قماش قطني أو كتاني ذو وبر مرتفع على جانب واحد؛ يستخدم لتضميد الجروح)",
 "いとくり": "بَكَرَة",
 "いとくりぐるま": "عَجَلَة الْمِغْزَل",
 "いとぐち": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة. / خيط دليل, قرينة (دليل يساعد على حل مشكلة)",
 "いとぐるま": "عَجَلَة الْمِغْزَل",
 "いとけない": "صَغِير, حَدَث",
 "いとこはん": "ابن الخال, ابن العم (ابن عمك أو عمتك أو خالك أو خالتك)",
 "いとこ半": "ابن الخال, ابن العم (ابن عمك أو عمتك أو خالك أو خالتك)",
 "いとさま": "اِبْنَة, بِنْت",
 "いとさめ": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ)",
 "いとさん": "اِبْنَة, بِنْت",
 "いとしい": "جَمِيل, مَحْبُوب (يخاطب العواطف والعين معاً) / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة)",
 "いとしがる": "شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة.",
 "いとしき": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة)\nمثال: هذه رسالة من شخص عزيز.",
 "いとしの": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة)\nمثال: هذه رسالة من شخص عزيز.",
 "いとしむ": "حَبِيب, حَبِيبَة\nمثال: لا أحب المدرسة.",
 "いとしゃじん": "جريس, جريس مستدير الأوراق (نبات معمر من نصف الكرة الشمالي ذو سيقان نحيلة وأزهار زرقاء على شكل جرس)",
 "いとじょう": "خَيْطِيّ (رَقِيقُ القُطْرِ؛ يُشْبِهُ الخَيْط)",
 "いとすぎ": "سَرْوَة, سَرْو",
 "いとせず": "عَنْ غَفْلَةٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "いとだま": "خيط دليل, قرينة (دليل يساعد على حل مشكلة)",
 "いとてき": "عَمْدِيّ, إرَادِيّ",
 "いととり": "بكرة غزل الحرير (بكرة تستخدم في غزل الحرير إلى خيوط)",
 "いととんぼ": "مقترنة الأجنحة, يعسوب صغير (حشرة نحيلة غير لاسعة تشبه اليعسوب ولكنها أصغر منه ولها أجنحة مطوية عند الراحة)",
 "いとど": "أكثر فأكثر, بشكل متزايد (يتقدم في الكمية أو الكثافة)\nمثال: أصبحت مكتئبة بشكل متزايد / عِلَاوَةً عَلَى",
 "いとなみ": "نَشَاط / وَظِيفَة, مِهْنَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟ / جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس. / تَحْضِير, إِعْدَاد",
 "いとなむ": "رَكَضَ (عَدَا)\nمثال: إنها تحب الركض. / شَغَّلَ, نَفَّذَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ…)\nمثال: شغل بيل التلفاز. / مَسَكَ, مسك",
 "いとのこ": "منشار أركت, منشار منحنيات (منشار آلي دقيق الأسنان بشفرة ضيقة؛ يستخدم لقطع الخطوط المنحنية)",
 "いとのこばん": "منشار أركت, منشار منحنيات (منشار آلي دقيق الأسنان بشفرة ضيقة؛ يستخدم لقطع الخطوط المنحنية)",
 "いとはん": "اِبْنَة, بِنْت",
 "いとひき": "بكرة غزل الحرير (بكرة تستخدم في غزل الحرير إلى خيوط) / حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ…)",
 "いとま": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / إجازة, وقت راحة (فترة زمنية لا يُطلب منك العمل فيها)\nمثال: طلب إجازة لحضور جنازة جدته / اِسْتِقَالَة, اِسْتِعْفَاء / ذهاب, رحيل (فعل المغادرة)",
 "いとまがない": "مَشْغُول",
 "いとまき": "بَكَرَة",
 "いとまごい": "استئذان بالانصراف, فراق (فعل المغادرة بأدب)\nمثال: كان يكره الوداع الطويل",
 "いとめる": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ…)\nمثال: ربح زيري المال.",
 "いとも": "بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً",
 "いとやなぎ": "صفصاف بابلي, صفصاف باكي (صفصاف ذو فروع طويلة متدلية وأوراق رفيعة موطنه الصين؛ يزرع على نطاق واسع كنبات…)",
 "いとよ": "شائكة الظهر ثلاثية الأشواك (تعيش في الأنهار والمناطق الساحلية)",
 "いとようじ": "خَيْط أَسْنَان, خَيْط سِنِّيّ ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ…)\nمثال: حل الصرة تلقى خيط.",
 "いとらん": "عشب الدب (يوكا من جنوب الولايات المتحدة لها كتلة من الأوراق القاعدية التي تشبه العشب وساق…)",
 "いとり": "اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)",
 "いとわく": "بَكَرَة",
 "いとわしい": "بَشِع, مَقِيت (مكروه بشكل لا لبس فيه)",
 "いとわない": "إرادة, مشيئة (فعل الاختيار)\nمثال: تبعت والدي بمحض إرادتي",
 "いとわぬ": "إرادة, مشيئة (فعل الاختيار)\nمثال: تبعت والدي بمحض إرادتي",
 "いとをたれる": "سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس)\nمثال: سمكة ميناد ماتت",
 "いとをとおす": "خَيْط, خيط ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ…)\nمثال: حل الصرة تلقى خيط.",
 "いとをひく": "مَدَّدَ",
 "いとノコ": "منشار أركت, منشار منحنيات (منشار آلي دقيق الأسنان بشفرة ضيقة؛ يستخدم لقطع الخطوط المنحنية)",
 "いとノコばん": "منشار أركت, منشار منحنيات (منشار آلي دقيق الأسنان بشفرة ضيقة؛ يستخدم لقطع الخطوط المنحنية)",
 "いど": "دَائِرَة عَرْض, خَطّ عَرْض (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر…)\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "いどう": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ. / فَرْق, اِخْتِلَاف / حَرَكَة / مُنْتَقِل",
 "いどうしき": "مُنْتَقِل",
 "いどうしゃ": "دمية, لعبة (نسخة صغيرة من شخص؛ تستخدم كلعبة)",
 "いどうせい": "حَرَكِيَّة, قَابِلِيَّة الحَرَكَة (صفة القدرة على التحرك بحرية) / مُنْتَقِل",
 "いどうたんまつ": "سيدة (صيغة خطاب للمرأة (دون تحديد الحالة الاجتماعية))",
 "いどうでんわ": "جَوَّال, هَاتِف مَحْمُول (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان…)\nمثال: اشتريت جوال مستعمل.",
 "いどうとしょかん": "مكتبة متنقلة (شاحنة مغلقة بها أرفف كتب؛ تعمل كمكتبة متنقلة أو مكتبة لبيع الكتب)",
 "いどうど": "حَرَكِيَّة, قَابِلِيَّة الحَرَكَة (صفة القدرة على التحرك بحرية)",
 "いどうろうどうしゃ": "عامل مهاجر, متشرد (عامل يتنقل ويعمل مؤقتاً في أماكن مختلفة)",
 "いどこ": "مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة / أَيْن, فين\nمثال: あなたはどこでテレビを見ますか。 — أين تشاهد التلفاز؟ / كَمْ",
 "いどころ": "مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة",
 "いどせい": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "いどみず": "مياه جوفية (مياه تحت الأرض محتجزة في التربة وفي الصخور المنفذة)",
 "いどむ": "عَالَجَ",
 "いな": "غَرِيب, عَجِيب / لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة. / تَبَايُن, تَضَارُب (اختلاف بين حقائق أو ادعاءات أو آراء متعارضة)\nمثال: تباين متزايد في الآراء",
 "いない": "دَاخِل\nمثال: جون في عمر أخي.",
 "いないしきょう": "منظار المعدة (نوع من المناظير لفحص المعدة بصرياً)",
 "いなおし": "إعادة صياغة (تغيير كلمة أو عبارة معينة)",
 "いなかかたぎ": "خُشُونَة, رِيفِيَّة (صفة كون الشخص ريفياً أو فجاً)",
 "いなかくさい": "رَيْفِيّ, قَرَوِيّ",
 "いなかしんし": "أقطاعي, إسكواير (مالك أرض ريفي إنجليزي)",
 "いなかそだち": "خَشِن, رِيفِيُّ النَّشْأَةِ (فظّ وغير مهذّب؛ نشأ في الريف)",
 "いなかっぺ": "شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد…)\nمثال: هذا الشخص فنان.",
 "いなかっぺい": "شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد…)\nمثال: هذا الشخص فنان.",
 "いなかっぺえ": "شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد…)\nمثال: هذا الشخص فنان.",
 "いなかっぽい": "إقليمي, ريفي (من خصائص الأقاليم (الريف) أو سكانها)\nمثال: ريفي ومساير للأعراف بعمق",
 "いなかふう": "رَيْفِيّ, قَرَوِيّ",
 "いなかもの": "مُوَاطِن (مَدَنِيّ؛ مُقِيم)\nمثال: أنا مواطن لبناني",
 "いなかもん": "مُوَاطِن (مَدَنِيّ؛ مُقِيم)\nمثال: أنا مواطن لبناني",
 "いなくなる": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا)\nمثال: لقد اختفى فاضل.",
 "いなげな": "غَرِيب, عَجِيب",
 "いなご": "جُنْدُب, جَرَادَة",
 "いなごまめ": "خَرُّوب",
 "いなご豆": "خَرُّوب",
 "いなす": "نَاكَفَ",
 "いなずま": "بَرْق (بَرَقَ الرجلُ: تَهَدّدَ وتَوَعَّدَ، كأَبْرَقَ؛ بَرَقَ الشيءُ بَرْقاً وبَريقاً…)\nمثال: البرق يسبق الرعد",
 "いなずまよこばい": "زِيكْزَاكِيّ, مُتَعَرِّج (ذو منعطفات حادة وقصيرة أو زوايا متتالية)",
 "いなせ": "بَاسِل, صَنْدِيد (لَا يَتَرَاجَع فِي المَعْرَكَة أَوِ العَمَل)",
 "いなたい": "فَلَّاحِيّ, قَرَوِيّ",
 "いなだ": "حقل أرز (حقل مروي أو مغمور يُزرع فيه الأرز)",
 "いなづま": "بَرْق (بَرَقَ الرجلُ: تَهَدّدَ وتَوَعَّدَ، كأَبْرَقَ؛ بَرَقَ الشيءُ بَرْقاً وبَريقاً…)\nمثال: البرق يسبق الرعد",
 "いななき": "صَهِيل",
 "いななく": "صَهِيل",
 "いなびかり": "بَرْق (بَرَقَ الرجلُ: تَهَدّدَ وتَوَعَّدَ، كأَبْرَقَ؛ بَرَقَ الشيءُ بَرْقاً وبَريقاً…)\nمثال: البرق يسبق الرعد",
 "いなむ": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / نَفَى",
 "いなむら": "بيدر, كومة قش (كدس من القش)",
 "いなめない": "لا جدال فيه, لا يمكن إنكاره (لا يمكن نفيه أو دحضه)",
 "いなや": "مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟ / اِعْتَرَاض",
 "いにかいす": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل.",
 "いにかいする": "عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم…)\nمثال: هي فتاة تسحر العقل.",
 "いにかなう": "رَضَّى",
 "いにし": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)\nمثال: و بعد قليل أتى.",
 "いにしえ": "تَارِيخ قَدِيم (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟",
 "いにみたない": "غير مُرضٍ (لا يبعث على الرضا)\nمثال: يجب أن تسترجع المتاجر البضائع غير المرضية",
 "いにゅう": "مُقَدَّمَة\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف) / نَقَلَ",
 "いにょう": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه) / بوال, سلس البول (عدم القدرة على التحكم في تدفق البول والتبول اللاإرادي)",
 "いにょうしょう": "بوال, سلس البول (عدم القدرة على التحكم في تدفق البول والتبول اللاإرادي)",
 "いにん": "تُهْمَة\nمثال: أقوم بشحن هاتفي",
 "いにんじょう": "عُمُولَة",
 "いにんとうち": "اِنْتِدَاب, حُكْم",
 "いぬ": "كَلْبِيّ / خنزير (خنزير مستأنس) / خَاسِر / مزيف, مقلد (غير حقيقي؛ يقلد شيئاً متفوقاً)\nمثال: عاطفة مزيفة / كَلْب, كلب (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا…)\nمثال: كان الكلب ميتا. / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا. / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ…)\nمثال: ذهب إلى الدكان. / مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات. / نَامَ, رَقَدَ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة. / تَقَاعَدَ",
 "いぬあわせ": "قِتَال الكِلَاب (قتال عنيف بين الكلاب (ينظم أحياناً بشكل غير قانوني للترفيه والمقامرة))\nمثال: ضغينة تعود لقتال سياسي شرس بينهما",
 "いぬい": "باتجاه الشمال الغربي (إلى أو باتجاه أو في الشمال الغربي)",
 "いぬかき": "سباحة الكلاب (طريقة سباحة أولية تقلد سباحة الكلب)",
 "いぬがみつかい": "طَبِيب سَاحِر (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "いぬがみづかい": "طَبِيب سَاحِر (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "いぬく": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود.",
 "いぬくい": "قِتَال الكِلَاب (قتال عنيف بين الكلاب (ينظم أحياناً بشكل غير قانوني للترفيه والمقامرة))\nمثال: ضغينة تعود لقتال سياسي شرس بينهما",
 "いぬくぎ": "سنبلة",
 "いぬぐい": "قِتَال الكِلَاب (قتال عنيف بين الكلاب (ينظم أحياناً بشكل غير قانوني للترفيه والمقامرة))\nمثال: ضغينة تعود لقتال سياسي شرس بينهما",
 "いぬころ": "جَرْو, غَلْو (الصَغير من كل نَبَات أو حَيَوَان؛ الصغير من الثَمَر كالبَطِّيخ والرُمَّان وغيره)\nمثال: كان الجرو يلحس خدها.",
 "いぬごや": "وِجَار\nمثال: لنعد إلى البيت.",
 "いぬぞり": "زلاجة الكلاب (زلاجة تجرها الكلاب)",
 "いぬちくしょう": "مُتَوَحِّش",
 "いぬっころ": "جَرْو, غَلْو (الصَغير من كل نَبَات أو حَيَوَان؛ الصغير من الثَمَر كالبَطِّيخ والرُمَّان وغيره)\nمثال: كان الجرو يلحس خدها. / كلب شوارع, كلب هجين (كلب رديء أو من سلالة مختلطة)",
 "いぬねこ": "حَيَوَان مَنْزَلِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي…)\nمثال: هذا حيوان أليف.",
 "いぬのかお": "كَلْب, كلب (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا…)\nمثال: كان الكلب ميتا.",
 "いぬはっか": "قَطْرَمْ",
 "いぬはりこ": "وَرَق مُقَوَّى (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "いぬばしり": "كتف الطريق (حافة ضيقة من الأرض (غير معبدة عادة) على طول جانب الطريق)\nمثال: توقفت السيارة على كتف الطريق",
 "いぬぶな": "زان ياباني (زان موطنه اليابان له خشب بني مصفر فاتح ناعم)",
 "いぬほおずき": "مَغْد أَسْوَد",
 "いぬほしざめ": "كلب البحر الأملس (قرش صغير يعيش في القاع يوجد على طول سواحل المحيط الأطلسي)",
 "いぬもあるけばぼうにあたる": "بِالتَّوْفِيق!, حَظًّا سَعِيدًا!",
 "いぬる": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ)\nمثال: إياك والتحرك حتى أرجع.",
 "いぬわし": "عُقَاب ذَهَبِيّ (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة…)\nمثال: هو من تلقى العقاب الأكبر.",
 "いぬサフラン": "زعفران الخريف, سورنجان (عشب بصلي يزهر في الخريف بأزهار بيضاء أو أرجوانية أو خزامية وبيضاء؛ موطنه غرب…)",
 "いぬジステンパー": "ديستمبر, سل الكلاب (مرض فيروسي يصيب الكلاب الصغيرة يتميز بحمى شديدة والتهاب تنفسي)",
 "いぬゾリ": "زلاجة الكلاب (زلاجة تجرها الكلاب)",
 "いねむり": "غفوة, نعاس (نوم خفيف متقطع)",
 "いねむる": "نَامَ عَلَى نَفْسِهِ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة.",
 "いのいちばん": "أَوَّلًا, قَبْلَ كُلِّ شَيْءٍ",
 "いのう": "جَيْب (جيَّب القميص:جَابَ، جعل له جيبًا)\nمثال: جيب سامي مثقوب. / قُوَى عُظْمَى",
 "いのうしゃ": "حيوان متحول, طافر (حيوان خضع لطفرة جينية)\nمثال: جين طافر",
 "いのこ": "خَنْزِير بَرِيّ / خِنْزِير",
 "いのこり": "تَوْقِيف",
 "いのこる": "بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة…)\nمثال: الباقي ليس مهم.",
 "いのしし": "خَنْزِير بَرِيّ",
 "いのししむしゃ": "أَهْوَج, مُتَهَوِّر (جريء بشكل متهور ومُفرِط)",
 "いのち": "حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول:…)\nمثال: ما أغرب الحياة! / حياة, عمر (الفترة التي يكون فيها شيء ما وظيفياً أو حياً (ما بين الولادة والموت))\nمثال: عاش حياة طويلة وسعيدة / إِنْشاء, إِشَادَة (مصدر للفعل \"أَنْشَأَ\")\nمثال: إنشاء موقع إلكتروني بدون أي تكلفة؟ / قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب.",
 "いのちからがら": "للنجاة بحياته (كما لو كانت حياتك على المحك)\nمثال: كان يركض للنجاة بحياته",
 "いのちがちる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "いのちしらず": "تَهَوُّر (التسرع والاندفاع لفعل شيء دون التفكير بالنتائج)\nمثال: إنه خطر أن تقود بتهور.",
 "いのちづな": "حبل النجاة (حبل يُلقى من سفينة ليتمسك به الناس لإنقاذ أنفسهم من الغرق)\nمثال: وفر الجسر الجوي شريان حياة لبرلين",
 "いのちとり": "مُمِيت, قَاتِل",
 "いのちのおんじん": "طوق نجاة (وسيلة نجاة على شكل حلقة من مادة طافية)",
 "いのちのみず": "بَاعِث لِلْحَيَاة, مُحْيٍ (يمنح أو يملك القدرة على بثّ الحياة والروح) / كُحُول, خَمْر (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ…)\nمثال: أكره ذوق الكحول. / مَنِيّ",
 "いのちびろい": "فوز بشق الأنفس, نجاة بأعجوبة (شيء تم تحقيقه (أو الهروب منه) بفارق ضئيل)",
 "いのちをたつ": "اِنْتَحَرَ / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة…)\nمثال: قتل الصياد دبا.",
 "いのちをちらす": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "いのちをつなぐ": "نَجَا",
 "いのふ": "مَعِدَة, مِعْدَة",
 "いのぶた": "خَنْزِير بَرِيّ",
 "いのままに": "حسب المشيئة, كما يشاء (كما يختار المرء أو يرضى)\nمثال: يمكنه التجول في الحي كما يشاء",
 "いのり": "صَلَاة, دُعَاء",
 "いのりかい": "اجتماع صلاة (خدمة يغني فيها الناس الترانيم ويصلون معًا)",
 "いのりをささげる": "صَلَّى, دَعَا",
 "いのる": "صَلَّى, دَعَا / أُمْنِيَّة",
 "いの一番": "أَوَّلًا, قَبْلَ كُلِّ شَيْءٍ",
 "いはい": "اِنْتِهَاك / رَمَاد, سَكَن",
 "いはく": "دكتور في الطب (درجة الدكتوراه في الطب) / تَهْدِيد",
 "いはん": "اِنْتِهَاك / جنحة, مخالفة (تجاوز يشكل انتهاكاً لما يُحكم بأنه حق)\nمثال: لقد شعر بالاستياء من سؤالي / قدوة, مثال (شيء يستحق التقليد)\nمثال: مثال للنجاح",
 "いはんきっぷ": "تَذْكِرَة",
 "いはんこうい": "اِنْتِهَاك",
 "いはんしゃ": "جَانٍ ((جَانَ) جونا وجونة: اسود)",
 "いばく": "سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة…)",
 "いばしょ": "مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة",
 "いばら": "غليون الخلنج (غليون مصنوع من جذر شجيرة الخلنج) / أَسَلَة\nمثال: هناك شوكة ناقصة. / نقطة الالتقاء (نقطة تتشكل من قوسين متقاطعين (كما في القوس القوطي))",
 "いばらき": "إِيبَارَاكِي",
 "いばらぎ": "إِيبَارَاكِي",
 "いばらだらけ": "شَائِك / بَائِس",
 "いばらのかんむり": "إكليل الشوك (تاج ساخر مصنوع من فروع الشوك وضعه الجنود الرومان على يسوع قبل الصلب)\nمثال: هذا هو صليبه (عبؤه) الذي يجب أن يحمله",
 "いばらひめ": "الْجَمِيلَة الْنَائِمَة",
 "いばら姫": "الْجَمِيلَة الْنَائِمَة",
 "いばり": "بَوْل",
 "いばりぶくろ": "مَثَانَة, مَثَانَة بَوْلِيَّة ((في الأحياء) عضو مرن يشبه الكيس يتمدد وينقبض، وظيفته تخزين سائل أو غاز ما…)",
 "いばりや": "مُتَعَجْرِف, مُتَغَطْرِس (لديه أو يُظهِر شعورًا بأهمية لا مبرّر لها ناتجًا عن كبرياء مفرط)",
 "いばりんぼ": "متباهٍ, متفاخر (شخص كثير التفاخر والحديث عن نفسه)",
 "いばりんぼう": "متباهٍ, متفاخر (شخص كثير التفاخر والحديث عن نفسه)",
 "いばる": "تبختر, خيلاء (مشية فخورة ومتيبسة ومتغطرسة)",
 "いひょう": "دَهْشَة, تَعَجُّب",
 "いひょうがい": "مُفَاجِئ",
 "いひん": "مُمْتَلَكَات, تَرِكَة",
 "いび": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "いびき": "شخير (فعل الشخير أو إصدار صوت الشخير)",
 "いびきをかく": "شَخَرَ",
 "いびせい": "مُجَفِّل",
 "いびつ": "مُحَرَّف, مُشَوَّه (تم تغيير معناه المقصود أو تشويهه) / إِهْلِيلَج",
 "いびり": "إِرْهَاب, تَنَمُّر (ال الإِزعاجُ والإِخَافَةُ، تقولُ: ويَقْشَعِرُّ الإِهَابُ إِذَا وَقَعَ مِنْهُ…)\nمثال: الإنفصاليون مثل الإرهاب.",
 "いびる": "إغاظة, تهكم (فعل مضايقة شخص ما بمرح أو بخبث (خاصة عن طريق السخرية)؛ استفزاز شخص ما بمضايقات…)\nمثال: تجاهل تهكمهم",
 "いふ": "هِجْرَان, هُجْرَان / هَيْبَة",
 "いふう": "جَلَالَة",
