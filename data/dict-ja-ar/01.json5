 "いまんとこ": "الآن, في الوقت الحاضر (في اللحظة الحالية)\nمثال: بضائع معروضة للبيع الآن",
 "いま一度": "ثانية, مجدداً (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: حاولت مرة أخرى (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)",
 "いま一歩": "آخَر, إِضَافِيّ (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "いみ": "مَعْنًى / حِدَاد\nمثال: هو ذئب في ثوب حمل. / مَحْظُورٌ اجْتِمَاعِيّ (اسم مفعول من حَظَرَ؛ المَمْنُوع والمُحَرَّم، ضد المُبَاح) / صَافٍ, اَلصَّافِي",
 "いみあい": "تَلَازُم",
 "いみありげ": "ذُو مَعْنًى (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "いみかんけい": "عَلَاقَة دَلَالِيَّة (علاقة بين المعاني)",
 "いみがとおらない": "غامض, غير مفهوم (صعب الفهم)\nمثال: الشيء الأكثر غموضاً (عدم قابلية للفهم) في الكون هو أنه قابل للفهم",
 "いみがない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "いみことば": "تلطيف التعبير, يوفيميزم (تعبير غير مسيء أو غير مباشر يتم استبداله بآخر يعتبر مسيئاً أو قاسياً جداً)",
 "いみしん": "ذُو مَعْنًى (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "いみしんちょう": "ذُو مَعْنًى (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "いみじくも": "بشكل جدير بالثناء, بشكل مثير للإعجاب (بطريقة مثيرة للإعجاب)\nمثال: كانت استجابات الأطفال طبيعية بشكل مثير للإعجاب",
 "いみするもの": "مَعْنًى",
 "いみてき": "دَلَالَات الأَلفَاظ",
 "いみない": "بلا معنى, عبثي (ليس له معنى أو اتجاه أو غرض)\nمثال: مسعى بلا معنى",
 "いみないよう": "مَعْنًى",
 "いみふ": "غَامِض",
 "いみふめい": "غَامِض",
 "いみぶか": "ذُو مَعْنًى (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب)\nمثال: كان رجل ذو قامة طويله.",
 "いみぶかい": "سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ)",
 "いみやくわり": "دور دلالي ((لغويات) العلاقة الأساسية التي يمتلكها مكون مع الفعل الرئيسي في الجملة)",
 "いみょう": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "いみろん": "عِلْم اَلْمَعَانِي (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "いみをなさない": "بلا معنى, عبثي (ليس له معنى أو اتجاه أو غرض)\nمثال: مسعى بلا معنى",
 "いみん": "هِجْرَة, مُهَاجَرَة (ترك الأرض والخروج منها إلى أخرى؛ في الشرع: ترك الوطن الذي بين الكفار والانتقال…)\nمثال: الهجرة النبوية. / مُهَاجِر, مُهَاجِرَة",
 "いみんだん": "مستعمر, مستوطن (شخص يستقر في مستعمرة جديدة أو ينتقل إلى بلد جديد)",
 "いみんろうどうしゃ": "عامل مهاجر, متشرد (عامل يتنقل ويعمل مؤقتاً في أماكن مختلفة)",
 "いむ": "تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "いむかん": "ضابط طبي (ممارس طبي في القوات المسلحة)",
 "いむしつ": "عنبر المرضى, عيادة السفينة ((بحري) غرفة لعلاج المرضى أو المصابين (كما في سفينة))",
 "いむべき": "بَغِيض",
 "いめい": "شُهْرَة / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة. / مُرَادِف (اسم فاعل من الفعل \"رَادَفَ\"؛ (في علم دلالة الألفاظ) كلمة لها المعنى نفسه أو…)\nمثال: الانفصالي مرادف للعاهرة. / إرَادَة / عِصْيَان / مَسْؤُول\nمثال: كلكم راع وكلكم مسئول عن رعيته.",
 "いも": "درنة (ساق أو جذر تحت أرضي لحمي يخدم في التكاثر وتخزين الغذاء) / فلاح ساذج, قروي بسيط (شخص ليس ذكياً جداً أو غير مهتم بالثقافة) / خَامِل, فَاشِل (لا يَنْفَجِر؛ غَيْر مَشْحون بِمادَّة مُتَفَجِّرَة فَعَّالَة)\nمثال: كانت التجربة الأولى عملاً فاشلاً حقاً / جُدَرِيّ / أثر بثرة, ندبة جدري (ندبة أو حفرة على الجلد تتركها بثرة جدري أو حب شباب أو مرض طفح جلدي آخر) / حَبِيب, حَبِيبَة / صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "いもあん": "بَطَاطَا حُلْوَة",
 "いもい": "رَيْفِيّ, قَرَوِيّ",
 "いもうとぎみ": "أخت (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على…)\nمثال: ماري هي أخت توم",
 "いもうとぶん": "مشمولة بالرعاية (أنثى مشمولة بالرعاية)",
 "いもがしら": "أحدوبة, حديبة (نتوء على عظم خاصة لربط عضلة أو رباط)",
 "いもぎみ": "أخت (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على…)\nمثال: ماري هي أخت توم",
 "いもくさい": "رِيفِيُّ الطَّابِع (يتّسم بسمات الحياة الريفيّة)",
 "いもしない": "غَيْر مَرْئِيّ, خَفِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى)\nمثال: مصطلح غير محدد (مبهم) / خِيَّالِيّ",
 "いもじ": "عجلة الأثاث, عجلة دوارة (عجلة محورية متصلة بأسفل الأثاث أو الشاحنات أو الآلات المحمولة لجعلها قابلة…) / حَبَّار",
 "いもじょうちゅう": "بَطَاطَا حُلْوَة",
 "いもじり": "فَرَس اَلنَّبِيّ (أقوام تسكن شرق العِرَاق، يقال أنهم أقوام آرِيَّة)\nمثال: الفرس هي أنثى الحصان",
 "いもすけ": "بَسِيطٌ سَاذَج, رِيفِيّ (بَسِيطٌ بِطَرِيقَةٍ فَجَّةٍ وَقَرَوِيّ)",
 "いもせ": "زَوْجَانِ\nمثال: لديك بعض الكتب. / شَقِيق, شَقِيقَة (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب)\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "いもたれ": "عُسْر الهَضَم, تُخْمَة (جعَل شيئًا صعبًا أو أكثر تعقيدًا؛ وضع عوائق أو صعوبات أمام أمرٍ ما)\nمثال: إن مع العسر يسرا.",
 "いもっぽい": "غَيْر رَائِج, مُمِلّ ((عامية) غير عصري وممل)",
 "いもづるしき": "وَاحِدًا تِلْوَ الآخَرِ",
 "いもづるせつぞく": "سلسلة الإقحوان (سلسلة زهور تتكون من خيط من زهور الإقحوان مرتبطة بسيقانها؛ يرتديها الطلاب في يوم…)",
 "いもづる式": "وَاحِدًا تِلْوَ الآخَرِ",
 "いもづる接続": "سلسلة الإقحوان (سلسلة زهور تتكون من خيط من زهور الإقحوان مرتبطة بسيقانها؛ يرتديها الطلاب في يوم…)",
 "いもの": "اختيار الممثلين, توزيع الأدوار (اختيار الممثلين للعب أدوار معينة في مسرحية أو فيلم)",
 "いものこをあらうよう": "حَاشِد, مُكْتَظّ (مليء بالكائنات الحيّة خاصّة)",
 "いものし": "عجلة الأثاث, عجلة دوارة (عجلة محورية متصلة بأسفل الأثاث أو الشاحنات أو الآلات المحمولة لجعلها قابلة…)",
 "いものみこと": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "いもほり": "شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد…)\nمثال: هذا الشخص فنان.",
 "いもむし": "يَرَقَة, دُودَة الْفَرَاشَة",
 "いもり": "سَمَنْدَل",
 "いもる": "مُخَيِّم",
 "いもをあらうよう": "حَاشِد, مُكْتَظّ (مليء بالكائنات الحيّة خاصّة)",
 "いも掘り": "شَخْص رِيفِيّ أَحْمَق (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد…)\nمثال: هذا الشخص فنان.",
 "いや": "كَرِهَ (لم يُحِبّ، لم يَسْتطِع تحمُّلَ شَخْص أو أمرٍ، لم يُطِقْه، مقَته وكان عنده…)\nمثال: هتلر كره اليهود. / بغيض, غير سار (مسيء أو غير مقبول؛ يسبب عدم الراحة أو التعاسة)\nمثال: شخصية بغيضة / أكثر فأكثر, بشكل متزايد (يتقدم في الكمية أو الكثافة)\nمثال: أصبحت مكتئبة بشكل متزايد / بشدة, جداً (لدرجة قصوى)\nمثال: بارد جداً / وَا, يَا يَاه\nمثال: آه ، هناك فراشة! / لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "いやぁ": "وَا, يَا يَاه\nمثال: آه ، هناك فراشة!",
 "いやあ": "وَا, يَا يَاه\nمثال: آه ، هناك فراشة!",
 "いやあん": "وَا, يَا يَاه\nمثال: آه ، هناك فراشة!",
 "いやいとこ": "قريب من الدرجة الثانية (ابن ابن عم أو ابن خال أحد الوالدين)",
 "いやいや": "دُونَ رَغْبَة, عَلَى مَضَض (بطريقة غير راغبة)\nمثال: لقد أخطأ بحقها كرهاً",
 "いやいやながら": "بتردد, على مضض (مع تردد أو عدم رغبة)",
 "いやおうなし": "إِجْبَارِيّ, إِلْزَامِيّ",
 "いやおうなしに": "بالضرورة, حتماً (بطريقة لا يمكن أن تكون خلاف ذلك)\nمثال: هو كذلك بالضرورة",
 "いやがおうでも": "طَوْعًا أَوْ كَرْهًا, شاءَ مَن شاءَ وَأَبَى مَن أَبَى",
 "いやがおうにも": "طَوْعًا أَوْ كَرْهًا, شاءَ مَن شاءَ وَأَبَى مَن أَبَى",
 "いやがらせ": "تَحَرُّش",
 "いやが応にも": "طَوْعًا أَوْ كَرْهًا, شاءَ مَن شاءَ وَأَبَى مَن أَبَى",
 "いやき": "كَرِهَ (لم يُحِبّ، لم يَسْتطِع تحمُّلَ شَخْص أو أمرٍ، لم يُطِقْه، مقَته وكان عنده…)\nمثال: هتلر كره اليهود.",
 "いやく": "خرق العقد (شَقَّ الثوب والقماش وما أشبه)\nمثال: لقد قام بخرق الاتفاق. / دَوَاء\nمثال: اختص في طب القلب. / ممارسة الطب (مزاولة مهنة الطب)",
 "いやくきん": "فقدان كعقوبة, مصادرة (فعل فقدان أو تسليم شيء ما كعقوبة لخطأ أو فشل في الأداء)\nمثال: حدد العقد مصادرات إذا لم يكتمل العمل في الوقت المحدد",
 "いやくきんじょうこう": "خرق العقد (شَقَّ الثوب والقماش وما أشبه)\nمثال: لقد قام بخرق الاتفاق.",
 "いやくひん": "مُخَدِّر\nمثال: قاموا بتجربة لمعرفة ما اذا كان العقار قد حسن الذاكرة.",
 "いやくひんじょうほうきょうかい": "وكالة استخبارات الدفاع (وكالة استخبارات أمريكية في وزارة الدفاع؛ مسؤولة عن توفير الاستخبارات لدعم…)",
 "いやけ": "كَرِهَ (لم يُحِبّ، لم يَسْتطِع تحمُّلَ شَخْص أو أمرٍ، لم يُطِقْه، مقَته وكان عنده…)\nمثال: هتلر كره اليهود.",
 "いやごと": "آداب, أخلاق (السلوك الاجتماعي)\nمثال: أخلاقه أخلاق خنازير",
 "いやさ": "يعني",
 "いやさか": "اِزْدِهَار, رَخَاء / حَظًّا مُوَفَّقًاَ ((حَظَا) فلان حظوا: مشى رويدا)\nمثال: حظا سعيدا يا زيري.",
 "いやし": "شِفَاء",
 "いやしい": "من أصل متواضع, وضيع النسب (من مولد أو أصول متواضعة)\nمثال: مجتمع مقلوب رأساً على عقب من الأغنياء وضيعي النسب والفقراء ذوي الدماء الزرقاء / بَذِيء / بَالٍ / طَمَّاع, جَشِع\nمثال: كانت صوفيا شرهة.",
 "いやしいうまれ": "من أصل متواضع, وضيع النسب (من مولد أو أصول متواضعة)\nمثال: مجتمع مقلوب رأساً على عقب من الأغنياء وضيعي النسب والفقراء ذوي الدماء الزرقاء",
 "いやしからぬ": "مُحْتَرَم",
 "いやしくも": "أَيّ (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "いやしけい": "مُعَزٍّ, مُوَاسٍ (يمنح الراحة والعزاء والسلوان)",
 "いやしみ": "اِحْتِقَار, اِزْدِرَاء",
 "いやしむ": "اِحْتَقَرَ, أَهَانَ",
 "いやしむべき": "حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار)",
 "いやしめる": "اِحْتَقَرَ, أَهَانَ",
 "いやしんぼう": "نَهِم, شَرِه\nمثال: كان مارك يميل للجشع.",
 "いやしん坊": "نَهِم, شَرِه\nمثال: كان مارك يميل للجشع.",
 "いやす": "شُفِيَ, اِشْتَفَى",
 "いやでも": "طَوْعًا أَوْ كَرْهًا, شاءَ مَن شاءَ وَأَبَى مَن أَبَى",
 "いやでもおうでも": "طَوْعًا أَوْ كَرْهًا, شاءَ مَن شاءَ وَأَبَى مَن أَبَى",
 "いやというほど": "كَافٍ (كِفَايَة، يَكْفِي، كَافِ؛ مَه، كَفَى)\nمثال: خسر كافة ممتلكاته. / بمرارة (بمرارة؛ بطريقة مستاءة)\nمثال: اشتكت بمرارة",
 "いやなてんき": "طقس سيء, قسوة الطقس (طقس غير مناسب للأنشطة الخارجية)",
 "いやなめ": "عَيْن اَلْحَسُود, عين حارّة (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره…)\nمثال: كان عين ليلى مسودة.",
 "いやな目": "عَيْن اَلْحَسُود, عين حارّة (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره…)\nمثال: كان عين ليلى مسودة.",
