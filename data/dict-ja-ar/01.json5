 "うばいとる": "سَلَبَ, نَهَبَ ((سَلَبَ) الشيء سلبا: انتزعه قهرا؛ (سَلَبَ) ت فلانة فؤاده أو عقله: استهوته…)\nمثال: لقد سلب مني كل شيء.",
 "うばう": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي. / اِتَّسَعَ, اِحْتَوَى\nمثال: دفع زيري الثمن.",
 "うばぐるま": "عربة أطفال (مركبة صغيرة بأربع عجلات يدفع فيها الرضيع أو الطفل)",
 "うばざめ": "قرش متشمس (قرش شمالي كبير غير ضار يتغذى على العوالق؛ غالباً ما يسبح ببطء أو يطفو على سطح…)",
 "うばたま": "أبنوسي, أسود حالك (أسود داكن جداً) / بيوت, ميسكالين (القلويد المهلوس الذي هو العامل النشط في أزرار الميسكال)",
 "うばん": "نَصْل الرِّيشَة (الجزء المسطح الشبيه بالشبكة من الريشة المكون من سلسلة من الأسلات على جانبي…)",
 "うば車": "عربة أطفال (مركبة صغيرة بأربع عجلات يدفع فيها الرضيع أو الطفل)",
 "うひゃ": "قَهْقَهَ",
 "うひゃひゃ": "قَهْقَهَ",
 "うひゃひゃひゃ": "قَهْقَهَ",
 "うひゃひゃひゃひゃ": "قَهْقَهَ",
 "うひょ": "عَجَبًا\nمثال: سبحان الله عما يشركون.",
 "うひょー": "عَجَبًا\nمثال: سبحان الله عما يشركون.",
 "うぶ": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "うぶい": "بَرِيء, بَرِيئَة",
 "うぶげ": "تَحْتَ, تَحْت (أَقَلَّ)\nمثال: أنا تحت الشجرة. / زَغَبُ الجَنِين (الشعر الزغبي الناعم الذي يغطي الجنين البشري؛ يسقط عادة خلال الشهر التاسع من…)",
 "うぶご": "مَوْلُود حَدِيث, مَوْلُودَة حَدِيثة",
 "うぶごえをあげる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "うぶだし": "إطلاق, تدشين (فعل البدء بشيء جديد)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "うぶんぼく": "آبَنُوس",
 "うぶ毛": "تَحْتَ, تَحْت (أَقَلَّ)\nمثال: أنا تحت الشجرة. / زَغَبُ الجَنِين (الشعر الزغبي الناعم الذي يغطي الجنين البشري؛ يسقط عادة خلال الشهر التاسع من…)",
 "うぷ": "حَمّل (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "うへい": "قصبة الريشة (العمود الفقري المجوف للريشة)",
 "うへっ": "صيحة ابتهاج (صيحة عالية تعبر عن الابتهاج أو الإثارة) / تجرع, عب (بلعة كبيرة وسريعة)\nمثال: أنهاه بجرعة واحدة / يَع",
 "うへん": "عامل مطلق, هرمون مطلق (أي من عدة هرمونات تنتج في الهايبوتلاموس وتحمل إلى الغدة النخامية الأمامية حيث…)",
 "うべ": "بصدق, حقاً (وفقاً للحقيقة أو الواقع)\nمثال: أصبحت الآن أمريكية حقاً",
 "うべなう": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "うべん": "ويب",
 "うほうたん": "يَمِين, يُمْنَى",
 "うほうほ": "فِي نَشْوَة, مُفْعَمٌ بِالحَيَوِيَّة (سَعِيدٌ وَمُتَحَمِّسٌ وَنَشِيط)",
 "うぼう": "أذين أيمن (الحجرة العلوية اليمنى للقلب التي تتلقى الدم من الأوردة الجوفاء والجيب التاجي)",
 "うぼく": "آبَنُوس",
 "うま": "حِصَان, فَرَس (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان…)\nمثال: لم يشفى الحصان. / جَنُوب (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب. / حِصَان, فَرَس (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان…)\nمثال: لم يشفى الحصان. / سباق الخيل (رياضة سباق الخيول) / فَارِس (اسم فاعل لفَرَسَ؛ راكب الفَرَس أو الحِصَان)\nمثال: فارس الظلام فيلم جيد.",
 "うまあぶ": "نبرة الخيل (طفيلية بشكل رئيسي على الخيول)",
 "うまい": "مَاهِر, حَاذِق / لَذِيذ / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "うまいくさ": "فَارِس, سِلَاح الفُرْسَان (اسم فاعل لفَرَسَ؛ راكب الفَرَس أو الحِصَان)\nمثال: فارس الظلام فيلم جيد.",
 "うまいぐあいに": "لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "うまいこと": "بِنَجَاحٍ",
 "うまいしゃ": "طبيب خيول (طبيب بيطري يعالج الخيول)",
 "うまいしる": "حِصَّةُ الأَسَد",
 "うまいな": "سلق, سلق سويسري (سيقان بيضاء طويلة عصارية ذات أوراق خضراء كبيرة)",
 "うまい具合に": "لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "うまい汁": "حِصَّةُ الأَسَد",
 "うまい菜": "سلق, سلق سويسري (سيقان بيضاء طويلة عصارية ذات أوراق خضراء كبيرة)",
 "うまうま": "بِنَجَاحٍ / طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "うまがる": "مذاق, نكهة (تجربة التذوق عند وضع طعام متبل في الفم)",
 "うまく": "ببراعة, بمهارة (بمهارة وحذق)\nمثال: شظايا إبريق شبه كامل، تم ترميمها بمهارة في معهد الآثار / بِنَجَاحٍ / بِشَكْل مُبْهِج, بِلَذَّة (بطريقة ممتعة للغاية)\nمثال: كانا يمشيان على الشاطئ ببطء ومتعة",
 "うまくさ": "عَلَف",
 "うまくら": "سَرْج, سرج ((سَرَجَ) فلان سرجا: كذب. ويقال سرج فلان الكذب؛ (سَرَجَ)ت المرأة شعرها: ضفرته)",
 "うまぐり": "قسطل الحصان, كستناء الحصان (شجرة ذات أوراق راحية وعناقيد كبيرة من الزهور البيضاء إلى الحمراء تليها بذور…)",
 "うまぐるま": "عَرَبَة\nمثال: لنذهب بالحافلة.",
 "うまぐわ": "جَرّافَة, كَاسِحَة",
 "うまげ": "قماش شعر الخيل (قماش مصنوع من الألياف المأخوذة من عرف أو ذيل الخيل؛ يستخدم للتنجيد)",
 "うまごや": "حَظِيرَة, اِسْطَبْل\nمثال: الشاحنة غير ثابتة.",
 "うまごやし": "نفل أبيض, نفل زاحف (نفل أوروبي زاحف ذو أزهار بيضاء إلى وردية وأوراق خضراء زاهية؛ متوطن في الولايات…)",
 "うまさけ": "مُرْتَفِع الدَّرَجَة",
 "うまざけ": "مُرْتَفِع الدَّرَجَة",
 "うましか": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "うまずたゆまず": "بشكل دؤوب, بلا كلل (بطاقة لا تكل)\nمثال: شاهدت العرض بلا كلل",
 "うまとび": "قفزة الضفدع, نط الحبل (لعبة ينحني فيها طفل ويقفز آخر من فوقه)\nمثال: لا تزال الشركة تعتقد أن الرقاقة تمثل قفزة في التكامل وستحقق أرباحاً طائلة",
