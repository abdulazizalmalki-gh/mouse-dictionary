 "うざっこい": "اِحْتَارَ / تَشَوَّش / اِرْتَبَكَ, تَشَوَّش",
 "うざったい": "مُزْعِج / صَارِم",
 "うし": "ثَوْر (حُمْرَة الشفق الثائرة فيه؛ الطُحْلُب وما أشبهه فوق الماء. سميّ كذلك لأنه يثور فجأة)\nمثال: حرث ما حرث الثور. / باتجاه الشمال الشمالي الشرقي (إلى أو باتجاه أو في الشمال الشمالي الشرقي) / مَوَاشٍ, مَاشِيَة / بَقَر (فتح وشق ووسّع؛ فتش عن الخفايا وكشف عنها، عرف أحوال الناس)\nمثال: أفضل لحم البقر. / لَحْم بَقَر (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر. / سفيف الريشة (واحدة من الشعيرات المتوازية التي تبرز من العمود الرئيسي للريشة) / حسك, شوكة (نقطة فرعية تواجه عكس النقطة الرئيسية تجعل من الصعب إزالة رأس السهم أو الرمح) / شوكة (الجزء المدبب من الأسلاك الشائكة) / تهكم, نقد لاذع (ملاحظة عدوانية موجهة لشخص مثل قذيفة وتهدف إلى إحداث تأثير قوي)\nمثال: كانت كلمته الأخيرة 'اذهب للجحيم' / ريشة (قسم من ورقة مقسمة ريشياً عادة)",
 "うしお": "مَدّ وَجَزْر (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "うしおい": "راعي (شخص يقود القطيع)",
 "うしかい": "مربي ماشية (رجل يربي (أو يرعى) الماشية) / راعي بقر, راعي ماشية (عامل أجير ذكر يرعى الماشية ويؤدي واجبات أخرى على ظهر الخيل)",
 "うしかいざ": "رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر.",
 "うしかいめんじょうのうしょう": "جُنُون اَلْبَقَر",
 "うしかい座": "رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر.",
 "うしかもしか": "نَوّ",
 "うしがわ": "سوط من جلد البقر (سوط مرن ثقيل مضفر من الجلد المصنوع من جلد البقر) / جلد البقر (إهاب البقرة) / جلد بقري (جلد مصنوع من إهاب البقرة)",
 "うしぐるま": "عربة ثيران (عربة يجرها ثور)",
 "うしざめ": "قرش الثور (أكثر أنواع القرش شيوعاً في المياه الساحلية المعتدلة والاستوائية حول العالم؛ ضخم الجسم وخطير)",
 "うしつ": "بطين أيمن (الحجرة على الجانب الأيمن من القلب التي تتلقى الدم الوريدي من الأذين الأيمن وتضخه في الجذع الرئوي)",
 "うしとら": "باتجاه الشمال الشرقي (إلى أو باتجاه أو في الشمال الشرقي) / شَمَال شَرْقِيّ (يقع في الشمال الشرقي أو موجَّه نحوه) / قَادِم مِنَ الشَّمَال الشَّرْقِيّ (قادم من اتجاه الشمال الشرقي) / شمال شرق (موقع في الجزء الشمالي الشرقي من بلد أو منطقة أو مدينة)",
 "うしどろぼう": "سارق المواشي (شخص يسرق المواشي (خاصة الأبقار))",
 "うしなう": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته. / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "うしなわれたかん": "الحلقة المفقودة, الرجل القرد (كائن افتراضي كان يُعتقد سابقاً أنه حلقة وصل بين القردة والبشر)",
 "うしなわれたくさり": "الحلقة المفقودة, الرجل القرد (كائن افتراضي كان يُعتقد سابقاً أنه حلقة وصل بين القردة والبشر)",
 "うしぬすっと": "سارق المواشي (شخص يسرق المواشي (خاصة الأبقار))",
 "うしぬすびと": "سارق المواشي (شخص يسرق المواشي (خاصة الأبقار))",
 "うしのけぐさ": "فستوكة الغنم (تُزرع لرعي الأغنام في المناطق المرتفعة أو تستخدم كعشب للمروج)",
 "うしのした": "وَحِيد / عَزْب / أَخْمُص, بَاطِن القَدَم / نَعْل / سَمَك مُوسَى (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "うしまけた": "لَذِيذ / شَهِيّ",
 "うしみつ": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "うしみつどき": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "うしももにく": "شريحة الفخذ المدورة (قطعة لحم بقر قليلة الدهن من المنطقة بين الكفل والساق)",
 "うしゃく": "عَقْعَق",
 "うしや": "حظيرة أبقار (حظيرة للأبقار)",
 "うしやみ": "طاعون الماشية (مرض فيروسي معد حاد يصيب الماشية (غالباً ما يكون قاتلاً)؛ يتميز بالحمى والإسهال والتهاب الأغشية المخاطية)",
 "うしょう": "شَيْء حَيّ, كَائِن حَيّ (كيان حيّ أو كان حيًّا في وقت ما) / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "うしょく": "تسوس, تسوس الأسنان (منطقة لينة متآكلة في السن؛ ويمكن أن يؤدي التسوس التدريجي إلى موت السن)",
 "うしろ": "خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "うしろあし": "رجل خلفية, ساق خلفية (الطرف الخلفي لذوات الأربع)",
 "うしろがわ": "خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "うしろぐらい": "ظَلِيل, وَارِف الظِّلّ (مَمْلُوء بِالظِّلّ) / مَشْبُوه (مشكوك في نزاهته أو قانونيَّته) / مُثِيرٌ لِلشُّبْهَة, مُرِيب (ليس كما هو متوقّع؛ يبعث على الريبة) / مُسْتَتِر, مُظْلِم (هادئ ومعتم أو مستتر عن الأنظار)",
 "うしろごと": "فضيحة, نميمة خبيثة (قيل وقال مشين عن الحياة الخاصة للآخرين)",
 "うしろだおし": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق) / انتظار, تأجيل (الوقت الذي يتم فيه انتظار إجراء ما)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً",
 "うしろだて": "دعم, مؤازرة (فعل تقديم الموافقة والدعم) / بطانة, دعامة خلفية (شيء يشكل ظهراً يضاف للتقوية) / تمويل, دعم مالي (الموارد المالية المقدمة لجعل مشروع ما ممكناً)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "うしろで": "وَرَاءَ",
 "うしろまえ": "إلى الوراء, للخلف (عند أو إلى أو نحو الخلف أو المؤخرة) / بالمقلوب, معكوساً (بطريقة أو ترتيب أو اتجاه عكس الطبيعي)\nمثال: تحرك للخلف",
 "うしろむき": "إلى الوراء, للخلف (عند أو إلى أو نحو الخلف أو المؤخرة) / بالمقلوب, معكوساً (بطريقة أو ترتيب أو اتجاه عكس الطبيعي)\nمثال: تحرك للخلف / اِنْحِدَارِيّ, تَرَاجُعِيّ (يتحوّل من الأفضل إلى الأسوأ)",
 "うしろめたい": "مُذْنِب, مُذْنِبَة / مُذْنِب",
 "うしろゆび": "غِيبَة",
 "うしろゆびをさす": "اِغْتَابَ, أَبَرَ",
 "うしろ倒し": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق) / انتظار, تأجيل (الوقت الذي يتم فيه انتظار إجراء ما)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً",
 "うしろ暗い": "ظَلِيل, وَارِف الظِّلّ (مَمْلُوء بِالظِّلّ) / مَشْبُوه (مشكوك في نزاهته أو قانونيَّته) / مُثِيرٌ لِلشُّبْهَة, مُرِيب (ليس كما هو متوقّع؛ يبعث على الريبة) / مُسْتَتِر, مُظْلِم (هادئ ومعتم أو مستتر عن الأنظار)",
 "うしん": "تَفْرِيق / تَمْيِيز / مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق.",
 "うしんしつ": "بطين أيمن (الحجرة على الجانب الأيمن من القلب التي تتلقى الدم الوريدي من الأذين الأيمن وتضخه في الجذع الرئوي)",
 "うしんぼう": "أذين أيمن (الحجرة العلوية اليمنى للقلب التي تتلقى الدم من الأوردة الجوفاء والجيب التاجي)",
 "うしモモにく": "شريحة الفخذ المدورة (قطعة لحم بقر قليلة الدهن من المنطقة بين الكفل والساق)",
 "うじ": "اسم العائلة, لقب (الاسم المستخدم لتعريف أفراد الأسرة (لتمييزه عن الاسم الأول لكل فرد)) / عَشِيرَة (مؤنث العَشِيْر؛ التي تعاشرها. الجمع عَشِيرَات؛ إحدى طبقات الأنساب دون الفخذ وفوق الفصيلة. الجمع عَشَائِر) / نَغَفة",
 "うじうじ": "بِشَكْل غَيْر قَاطِع, دُونَ حَسْم (بدون نهائية؛ بشكل غير حاسم) / بِتَرَدُّد, دُونَ حَزْم (الافتقار إلى الحزم أو التصميم)\nمثال: انتهت المعركة دون حسم: لم يفز أي من الجانبين بوضوح لكن لم يعترف أي منهما بالهزيمة",
 "うじうど": "فَرْد مِن العَشِيرَة (عضو في عشيرة)",
 "うじく": "عمود شوكي, عمود فقري (سلسلة الفقرات التي تشكل محور الهيكل العظمي وتحمي الحبل الشوكي) / محور (محور ورقة مركبة أو نورة مركبة)\nمثال: تسبب السقوط في كسر ظهره",
 "うじすじょう": "أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم) / أصل, سلالة (الاشتقاق الوراثي للفرد) / أجرة الكتابة, سعر السطر (معدل الدفع للمواد المكتوبة التي تقاس وفقاً لعدد الأسطر المقدمة) / عَدَد الأَسْطُر (عدد الأسطر في مادة مطبوعة)\nمثال: كل سلالته كانت محاربين",
 "うじな": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟",
 "うじひと": "فَرْد مِن العَشِيرَة (عضو في عشيرة)",
 "うじびと": "فَرْد مِن العَشِيرَة (عضو في عشيرة)",
 "うじむし": "نَغَفة / شَخْص دَنِيء (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "うじゃうじゃ": "بشكل ممل, بضجر (بطريقة مملة)\nمثال: عمل بطيء بشكل ممل",
 "うじゃく": "عَقْعَق",
 "うじょう": "إِنْسَانِيَّة, رَأْفَة (صفة الرحمة أو مراعاة الآخرين (الناس أو الحيوانات))",
 "うす": "رَحًى (رَحَى: طاحون؛ مؤنثة، جمعها: أرحاء، أرحية، أرح، رَحِيّ، رِحِيّ، رِحًى، وأُرْحِي، ومِثل: رَحْوان ورَحْيان؛ ورَحَى: وَجْ، جمعه أرحاء، بمعنى الصدر) / إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور. / بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما / نَادِر / يَاه, اسمع / هَلَا / نَعَم سَيِّدِي (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: أنت نعم الطالب. / اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "うすあお": "سَمَاوِيّ, لَبَنِيّ",
 "うすあかり": "ضوء خافت, غلس (ضوء رمادي (كما في الفجر أو الغسق أو في الدواخل المعتمة))",
 "うすあかるい": "خَافِت, مُعْتَدِل الإِضَاءَة (ضَعِيف الضَّوْء؛ غَيْر سَاطِعٍ أَوْ قَاسٍ) / مُخْفَت, مُعْتِم (جُعل معتماً أو أقل سطوعاً) / بَطِيء الفَهْم, كَلِيل الذِّهْن (بطيء التعلّم والاستيعاب؛ يفتقر إلى الحدّة الذهنيّة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: أضواء القاعة المخفتة جلبت صمتاً من الترقب",
 "うすあげ": "مَقْلِيّ (مَطْهُوٌّ بِالقَلْيِ فِي الدُّهْن)",
 "うすい": "رَفِيع, رَقِيق / ضعيف, ضعيفة / بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ / رَقِيق, مَائِيّ (مُخَفَّف أَكْثَر مِنَ اللَّازِم؛ ضَعِيف وَبِلَا طَعْم) / مَائِيّ (متعلّق بالماء أو شبيه به أو مؤلَّف منه) / دَامِع, رَاشِح (مبلَّل بإفرازات رطبة كالعَرَق أو الدموع) / مَمْلُوء بِالْمَاء (مملوء بالماء) / ضَعِيف",
 "うすいいた": "وَرَقَة, وَرَق",
 "うすいた": "قِنَاع (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "うすうす": "بشكل خفيف, بقلة كثافة (بطريقة موزعة على نطاق واسع وقليلة الكثافة) / بشكل رقيق, بطبقة خفيفة (بكمية صغيرة أو مدى قليل) / بسيولة, بميوعة (بدون لزوجة) / بضعف, بفتور (بدون قوة أو جهد صادق)\nمثال: سفح جبل مغطى بالنباتات بشكل خفيف",
 "うすかわをはぐように": "بوصة بوصة, شيئاً فشيئاً (بمسافة قصيرة) / تدريجياً, شيئاً فشيئاً (جزءاً صغيراً في كل مرة)\nمثال: حركوه بوصة بوصة",
 "うすがた": "رَفِيع, رَقِيق / ضعيف, ضعيفة",
 "うすがみをはぐように": "بوصة بوصة, شيئاً فشيئاً (بمسافة قصيرة) / تدريجياً, شيئاً فشيئاً (جزءاً صغيراً في كل مرة)\nمثال: حركوه بوصة بوصة",
 "うすきみのわるい": "مُخِيف, مُوحِش (يُوحِي بِالخَوْف؛ غَرِيب وَمُرْعِب) / مُخِيف, مُوحٍ بِالخَوَارِق (يوحي بما هو خارق للطبيعة؛ غامض ومريب)",
 "うすきみわるい": "عَجِيب, غَرِيب",
 "うすぎたない": "قَذِر جِدًّا, مُقْرِف (بالغ القذارة بشكل مثير للاشمئزاز؛ ملطّخ بمواد كريهة) / بَذِيء, سَافِل (يتّسم بالفحش وخدش الحياء) / حَقِير, وَضِيع (خسيس ومحتقر؛ دنيء)",
 "うすぎぬ": "حِجَاب, خِمَار (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "うすくち": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور. / رَفِيع, رَقِيق / ضعيف, ضعيفة",
 "うすくらがり": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / يَغْسِق, يَعْتِم\nمثال: هل العشاء جاهز؟",
 "うすくらやみ": "قتامة, كآبة (شعور بتوجس كئيب) / عتمة, قتامة (حالة من الظلام الجزئي أو الكلي) / تجهم, قتامة (جو من الاكتئاب والحزن)\nمثال: أشعل عود ثقاب ليبدد العتمة",
 "うすぐらい": "خَافِت, مُعْتَدِل الإِضَاءَة (ضَعِيف الضَّوْء؛ غَيْر سَاطِعٍ أَوْ قَاسٍ) / مُخْفَت, مُعْتِم (جُعل معتماً أو أقل سطوعاً) / بَطِيء الفَهْم, كَلِيل الذِّهْن (بطيء التعلّم والاستيعاب؛ يفتقر إلى الحدّة الذهنيّة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: أضواء القاعة المخفتة جلبت صمتاً من الترقب",
 "うすぐれ": "مَسَاء",
 "うすぐろい": "مَائِل لِلسَّوَاد (مائل إلى السواد قليلاً)",
 "うすごろも": "حِجَاب, خِمَار (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "うすさむい": "بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "うすざくら": "زَهْرَة كَرَز",
 "うすざむい": "بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "うすじろい": "أَبْيَض مَائِل, مُبْيَضّ (بلون يميل إلى البياض) / أَبْيَض مُعْتِم, حَلِيبِيّ (يُشبه الحليب في لونه الأبيض غير الصافي)",
 "うすちゃ": "بني فاتح (بني فاتح ولكنه غير مشبع)",
 "うすちゃいろ": "بني فاتح (بني فاتح ولكنه غير مشبع)",
 "うすっぺら": "غير مقنع, واهٍ (ليس مقنعاً) / ضَعِيف, هَشّ (يفتقر إلى الجوهر أو الأهمّيّة) / رَقِيق, هَشّ (يفتقر إلى الصلابة أو المتانة) / ورق قشر البصل (ورق رقيق قوي خفيف الوزن وشفاف يستخدم خاصة لعمل نسخ كربونية)\nمثال: حجة واهية",
 "うすっぺらい": "غير مقنع, واهٍ (ليس مقنعاً) / ضَعِيف, هَشّ (يفتقر إلى الجوهر أو الأهمّيّة) / رَقِيق, هَشّ (يفتقر إلى الصلابة أو المتانة) / ورق قشر البصل (ورق رقيق قوي خفيف الوزن وشفاف يستخدم خاصة لعمل نسخ كربونية)\nمثال: حجة واهية",
 "うすつく": "بَاوْنْد / رَطْل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ) / جُنَيْه",
 "うすづく": "بَاوْنْد / رَطْل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ) / جُنَيْه",
 "うすづくり": "رَفِيع, رَقِيق / ضعيف, ضعيفة",
 "うすで": "رَفِيع, رَقِيق / ضعيف, ضعيفة / سَطْحِيّ",
 "うすのろ": "أحمق, غبي (شخص غبي وغير كفء) / أبله, متخلف عقلياً (شخص ذو ذكاء دون الطبيعي)",
 "うすば": "ضِرْس / رَفِيع, رَقِيق / ضعيف, ضعيفة",
 "うすばか": "أحمق, غبي (شخص غبي وغير كفء)",
 "うすばかげろう": "لَيْث عِفِرِّين, أَسَد النَّمْلِ (أَسَد)\nمثال: إذا رأيت نيوب الليث بارزة، فلا تظنن أن الليث يبتسم.",
 "うすべにいろ": "قرنفل المستنقعات, قنطريون أمريكي (أي من عدة نباتات مستنقعات زهرية اللون من شرق الولايات المتحدة تشبه القنطريون الحقيقي)",
 "うすべにたちあおい": "خِطْمِيّ",
 "うすぼんやり": "بشكل خافت, بضعف (بدرجة خافتة أو مدركة بضعف)\nمثال: بينه وبين الضوء الخافت تم تحديد شكل بشكل خافت / مُغَفَّل, أَحْمَق",
 "うすむらさきいろ": "أُورْكِيد, سَحْلَب",
 "うすめる": "خَفَّفَ (قلل شيئًا أو نقص من حدته؛ هون أو لطف من شدة أمر)\nمثال: خفف زيري السرعة. / حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط) / صلابة, متانة (مرونة وصلابة جسم معدني؛ قدرته على امتصاص طاقة كبيرة قبل التشقق) / فورة غضب, هيجان (نوبة مفاجئة من الغضب) / مزاج (حالة شعورية مميزة (عادة أو مؤقتة نسبياً))\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "うすももいろ": "خَوْخِيّ اللَّوْن (ذو لون الخوخ)",
 "うすら": "طَفِيف",
 "うすらぐ": "اختفاء, تلاشٍ (التوقف التدريجي عن الظهور) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة",
 "うすらさむい": "بَارِد, فَاتِرُ المَشَاعِر (لا يتّسم بالعاطفة) / بَارِد, جَافّ المُعَامَلَة (يَفْتَقِرُ إِلَى دِفْء المَشَاعِر) / بَارِد نَوْعًا مَا (بارد بشكل ملحوظ أو مُزعج) / فلفل تشيلي, فلفل حار (فلفل حار جداً ودقيق الاستدقاق ذو طعم لاذع خاص)",
 "うすらとんかち": "أحمق, بليد (شخص ليس ذكياً جداً)\nمثال: إنه الاقتصاد يا غبي!",
 "うすらばか": "مُغَفَّل, سَاذَج",
 "うすら馬鹿": "مُغَفَّل, سَاذَج",
 "うすれゆく": "اختفاء, تلاشٍ (التوقف التدريجي عن الظهور) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة",
 "うすれる": "اختفاء, تلاشٍ (التوقف التدريجي عن الظهور) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة",
 "うすバカ": "أحمق, غبي (شخص غبي وغير كفء)",
 "うす寒い": "بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "うず": "دَوَّامَة / إرَادَة / رَغْبَة, إرَادَة / تَعَمَّدَ, نَوَى / يَنْبَغِي أَنْ / مِنْ اَلْمَفْرُوض أَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / مِنْ اَلْمُفْتَرَض أَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / آقونيطن نابلس, قلنسوة الراهب (عشب سام موطنه شمال أوروبا له أزهار زرقاء بنفسجية مقلنسة؛ الأوراق والجذور المجففة تنتج الآقونيت)",
 "うずうず": "ضجر, عجول (قلق أو سريع الغضب تحت التأخير أو المعارضة)\nمثال: نافذ الصبر مع الطلاب الأبطاء",
 "うずき": "تَأَلَّمَ, وَجِعَ / أَلَم, وَجَع (الوَجَع)\nمثال: ألم أقل لك ذلك؟",
 "うずく": "خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَ, نَبَضَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَان / صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / صفراء, عصارة صفراوية (عصارة هضمية يفرزها الكبد وتخزن في المرارة؛ تساعد في هضم الدهون) / استياء, حقد (شعور بالغضب العميق والمرارة وسوء النية) / عفصة (تورم غير طبيعي في أنسجة النبات ناتج عن الحشرات أو الكائنات الحية الدقيقة أو الإصابة)",
 "うずくまる": "انحناء, جثوم (عملية الانحناء المنخفض مع ضم الأطراف للجسم)",
 "うずじょうぎんが": "مَجَرَة حَلَزُونِيَّة (نجوم كثيرة لا تدرك بمجرد البصر، وعندما ينتشر ضوؤها فيُرى كأنه بقعة بيضاء (أي: مصادر ضوء كثيرة بحيث يبدو ضوئها كوهج بدلاً من أن يَبدو كل نجم واضحٍ…؛ باب السماء، وهي البياض الذي يَعبر السماء ويَقع بين النّسرَين (المقصود هنا هو مجرة دَرْب التّبانَة…)\nمثال: أنا بطل المجرة.",
 "うずべんもうそう": "سوطيات دوارة (أوالي بحرية بشكل رئيسي لها سوطان؛ مكون رئيسي للعوالق)",
 "うずべんもうそうるい": "سوطيات دوارة (أوالي بحرية بشكل رئيسي لها سوطان؛ مكون رئيسي للعوالق)",
 "うずべんもうちゅう": "سوطيات دوارة (أوالي بحرية بشكل رئيسي لها سوطان؛ مكون رئيسي للعوالق)",
 "うずまき": "دَوَّامَة / لَوْلَب, بُرْغِيّ",
 "うずまきがた": "لَوْلَب, بُرْغِيّ",
 "うずまきぎんが": "مَجَرَة حَلَزُونِيَّة (نجوم كثيرة لا تدرك بمجرد البصر، وعندما ينتشر ضوؤها فيُرى كأنه بقعة بيضاء (أي: مصادر ضوء كثيرة بحيث يبدو ضوئها كوهج بدلاً من أن يَبدو كل نجم واضحٍ…؛ باب السماء، وهي البياض الذي يَعبر السماء ويَقع بين النّسرَين (المقصود هنا هو مجرة دَرْب التّبانَة…)\nمثال: أنا بطل المجرة.",
 "うずまきじょう": "لَوْلَب, بُرْغِيّ",
 "うずまきせいうん": "مجرة حلزونية (مجرة ذات بنية حلزونية؛ أذرع تحتوي على نجوم أصغر سناً تلتف خارجة من نجوم قديمة في المركز)",
 "うずまきせん": "لَوْلَب, بُرْغِيّ",
 "うずまきポンプ": "مضخة طرد مركزي (مضخة تستخدم قوة الطرد المركزي لتفريغ السائل في أنبوب)",
 "うずまき線": "لَوْلَب, بُرْغِيّ",
 "うずまく": "برم, دوران سريع (عملية الدوران بسرعة) / تجربة, محاولة سريعة (محاولة عادة ما تكون قصيرة) / جلبة, دوامة (حركة مضطربة) / تلفيف, دوامة (شكل شيء يدور بسرعة)\nمثال: أدار الكرنك بقوة / طفرة, فورة (زيادة قوية مفاجئة) / تلاطم, موجة عارمة (موجة بحرية كبيرة) / اندفاع, فورة (تدفق قوي مفاجئ)\nمثال: حفزت طفرة من المضاربة",
 "うずまる": "فَيَضَان / فَاضَ",
 "うずめる": "غِطَاء / غِلَاف / غَطَّى / مَلَأَ",
 "うずら": "سُمَّان, سَلْوَى",
 "うずらくいな": "مرعة الغيط (طائر مرعة أوراسي شائع يتردد على حقول الحبوب)",
 "うずらまめ": "فاصولياء بينتو (فاصولياء مرقطة أو منقطة من جنوب غرب الولايات المتحدة؛ عادة ما تكون مجففة)",
 "うずら豆": "فاصولياء بينتو (فاصولياء مرقطة أو منقطة من جنوب غرب الولايات المتحدة؛ عادة ما تكون مجففة)",
 "うせい": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "うせさる": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "うせつ": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / تَسَاقُط ثُلُوج",
 "うせる": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "うせんせい": "يَمِينِيّ الدَّوَرَان (يدور باتّجاه عقارب الساعة؛ يُقال عن المواد التي تحرف مستوى الضوء المستقطَب يميناً)",
 "うせんとう": "ديكستروز, سكر العنب (متصاوغ للجلوكوز يوجد في العسل والفواكه الحلوة)",
 "うぜえ": "مُزْعِج",
 "うそ": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب. / أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي. / قُضَاعَة / ثَعْلَب الْمَاء (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر)\nمثال: أردى الصياد الثعلب.",
 "うそいつわり": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "うそう": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "うそうそ": "بتوجس, بقلق (مع قلق أو توجس)\nمثال: راقبنا بقلق",
 "うそく": "يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "うそくさい": "مُتَصَلِّب, مُصْطَنَع (رسمي بشكل مصطنع ومتكلّف) / مُتَكَلَّف, مُصْطَنَع (يظهر عليه أثر التخطيط أو التلاعب)",
 "うそさむい": "بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "うそっこ": "لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس.",
 "うそっぽい": "مُتَصَلِّب, مُصْطَنَع (رسمي بشكل مصطنع ومتكلّف) / مُتَكَلَّف, مُصْطَنَع (يظهر عليه أثر التخطيط أو التلاعب)",
 "うそつき": "كَذَّاب, كَذَّابَة / كَذِب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة)\nمثال: اتهمتني بالكذب.",
 "うそつけ": "كَذَّاب, كَذَّابَة",
 "うそなき": "دموع التماسيح (إظهار نفاق للحزن؛ بكاء كاذب أو غير صادق)\nمثال: ذرفت السكرتيرات دموع التماسيح على معضلة المدير",
 "うそのよう": "لا يصدق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "うそはっけんき": "جهاز كشف الكذب (جهاز بوليغراف يسجل التغيرات الجسدية المرتبطة أحياناً بالكذب)",
 "うそぶく": "تَبَاهَى / تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه) / نَبَحَ, يَنْبَح / نُبَاح / لِحَاء",
 "うそもほうべん": "الْغَايَةُ تُبَرِّرُ الْوَسِيلَةَ",
 "うそも方便": "الْغَايَةُ تُبَرِّرُ الْوَسِيلَةَ",
 "うそをつく": "كذبة بيضاء, كذبة تافهة (كذبة تافهة)\nمثال: قال كذبة صغيرة حول أكل سبانخه",
 "うそをつけ": "كَذَّاب, كَذَّابَة",
 "うそ寒い": "بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "うそ泣き": "دموع التماسيح (إظهار نفاق للحزن؛ بكاء كاذب أو غير صادق)\nمثال: ذرفت السكرتيرات دموع التماسيح على معضلة المدير",
 "うそ発見器": "جهاز كشف الكذب (جهاز بوليغراف يسجل التغيرات الجسدية المرتبطة أحياناً بالكذب)",
 "うそ臭い": "مُتَصَلِّب, مُصْطَنَع (رسمي بشكل مصطنع ومتكلّف) / مُتَكَلَّف, مُصْطَنَع (يظهر عليه أثر التخطيط أو التلاعب)",
 "うぞうぞ": "مُتَأَثِّر, مُسْتَثَار (مُثَار عاطفياً ووجدانياً)",
 "うぞうむぞう": "رعاع, غوغاء (حشد غير منظم من الناس) / عصابة (رابطة من المجرمين) / عصابة, نقابة الجريمة (تحالف فضفاض من رجال العصابات المسؤولين عن الأنشطة الإجرامية المنظمة)\nمثال: حاولت الشرطة تفكيك العصابة",
 "うた": "أُغْنِيَّة, أُغْنِيَة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر) / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: أنا أغني أغنية.",
 "うたいて": "مُطْرِب, مُغَنٍّ",
 "うたいもんく": "شِعار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "うたい文句": "شِعار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "うたう": "غَنَّى / تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه) / اِحْتَفَلَ / عَبَّرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق. / أُهْزُوجَة, أَهَازِيج",
 "うたうたい": "مُطْرِب, مُغَنٍّ",
 "うたかた": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا) / كائن سريع الزوال (أي شيء قصير العمر، مثل حشرة تعيش ليوم واحد فقط في شكلها المجنح)",
 "うたがい": "شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شَكّ, شُبْهَة ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شُبْهَة\nمثال: إنها بلا شك محقة.",
 "うたがいぶかい": "شَكَّاك, مُتَشَكِّك (يتسم بالشك أو يميل إليه)\nمثال: 田舎の人々は外部の人に対して昔から疑い深い。 — يشتبه الريفيون عادةً بالغرباء.",
 "うたがう": "شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شَكّ, شُبْهَة ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شُبْهَة\nمثال: إنها بلا شك محقة.",
 "うたがた": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا) / كائن سريع الزوال (أي شيء قصير العمر، مثل حشرة تعيش ليوم واحد فقط في شكلها المجنح)",
 "うたがみ": "ربة الإلهام, ملهمة (مصدر إلهام الفنان) / ربة الإلهام, موز (في الأساطير اليونانية القديمة أي من بنات زيوس وميموزين التسع؛ حاميات الفنون والعلوم)\nمثال: كانت يوتيربي ملهمته",
 "うたがわしい": "مَشْكُوك فِيه, مُرْتَاب (مليء بالشكّ وعدم اليقين) / مَشْبُوه, مَشْكُوكٌ فِيه (يثير الشكّ أو الريبة) / مُبْدَئِيّ, مُتَرَدِّد (غير مستقرّ في الرأي؛ مُتذبذب)",
 "うたく": "أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟",
 "うたぐり": "شَكَّ ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شَكّ, شُبْهَة ((شَكَّ) الشيءُ يَشُكُّ شَكًّا: لَصِقَ بعضُه ببعضَ واتَّصَلَ؛ (شَكَّ) القرابةُ: اتَّصَلَتْ) / شُبْهَة\nمثال: إنها بلا شك محقة.",
