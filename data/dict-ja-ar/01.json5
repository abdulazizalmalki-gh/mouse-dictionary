 "えもいえぬ": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "えもいわず": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "えもいわれず": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "えもいわれぬ": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "えもじ": "إِيمُوجِي / بيكتوغراف, رمز تصويري (رمز رسومي يُستخدم في الكتابة التصويرية)",
 "えもの": "فَرِيسَة / أَفْسَدَ\nمثال: دلل سامي صديقته. / سِلَاح, أَسْلِحَة",
 "えもん": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "えも言えぬ": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "えも言はず": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "えも言われず": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "えも言われぬ": "لَا يُوصَف, يَفُوق الوَصْف (يتحدى التعبير اللغوي أو الوصف؛ لا تسعه الكلمات)",
 "えやみ": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي. / رعشة حمى, نفضية (نوبة من الارتعاش أو القشعريرة)",
 "えよう": "رَفَاهِيَّة, تَرَف / تَخْطِيط, تصميم (مصدر من خَطَّطَ؛ في : فكرةٌ مُثبتة بالرسم، أو الكتابة في حالة الخطّ. تدلّ…)\nمثال: يعمل في قسم التخطيط.",
 "えようえいが": "رَفَاهِيَّة, تَرَف",
 "えら": "خَيْشُوم, نَخْشُوش / عَظِيم, هَائِل (كبير بشكل استثنائي في الحجم أو المدى أو الكمية أو القوة أو الدرجة)",
 "えらあな": "شَقّ خَيْشُومِيّ (واحدة من سلسلة فتحات شقية في بلعوم الأسماك والبرمائيات المائية يمر الماء من…)",
 "えらい": "رَائِع, عَظِيم\nمثال: الصين بلد عظيم. / مُمَيَّز, مُمْتَاز / فَظِيع, أَرْبَد / مُتْعِب, شَاق",
 "えらいさん": "رأس كبير, شخصية كبيرة (شخص مؤثر وهام)\nمثال: هو يعتقد أنه شخصية كبيرة",
 "えらく": "بشكل رهيب, جداً (تستخدم للتوكيد)\nمثال: مثير للاهتمام جداً",
 "えらそう": "مُتَعَجْرِف, مُتَغَطْرِس (لديه أو يُظهِر شعورًا بأهمية لا مبرّر لها ناتجًا عن كبرياء مفرط)",
 "えらそー": "مُتَعَجْرِف, مُتَغَطْرِس (لديه أو يُظهِر شعورًا بأهمية لا مبرّر لها ناتجًا عن كبرياء مفرط)",
 "えらばれしもの": "الْمُخْتَار, الْمُخْتَارَة",
 "えらび": "اِخْتَارَ",
 "えらびかた": "اِخْتِيَار, خِيَار",
 "えらびだす": "اِخْتَارَ",
 "えらびとる": "اِخْتَارَ",
 "えらぶ": "اِخْتَارَ",
 "えらぶた": "غشاء الخيشوم, غطاء الخيشوم (سديلة صلبة تعمل كغطاء (أ) لشقوق الخياشيم في الأسماك أو (ب) لفتحة الصدفة في بعض…)",
 "えらぶる": "تبختر, خيلاء (مشية فخورة ومتيبسة ومتغطرسة)",
 "えらぼね": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم) / قَوْس خَيْشُومِيّ (أحد الأقواس العظمية أو الغضروفية على كل جانب من البلعوم والتي تدعم خياشيم…)",
 "えら蓋": "غشاء الخيشوم, غطاء الخيشوم (سديلة صلبة تعمل كغطاء (أ) لشقوق الخياشيم في الأسماك أو (ب) لفتحة الصدفة في بعض…)",
 "えら骨": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم) / قَوْس خَيْشُومِيّ (أحد الأقواس العظمية أو الغضروفية على كل جانب من البلعوم والتي تدعم خياشيم…)",
 "えり": "يَاقَة, قَبَّة\nمثال: كلب زيري يحب ارتداء ذلك الطوق. / نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي…)\nمثال: من علمك نحت الخشب. / جِرَابِيُّ الشَّكْل, كِيسِيّ (على شكل جراب أو كيس)",
 "えりあし": "قَفًا",
 "えりかざり": "رِبَاط, رَبْطَةُ الْعُنُق",
 "えりくず": "زُبَالَة, نُفَايَات",
 "えりくびをつかむ": "يَاقَة, قَبَّة\nمثال: كلب زيري يحب ارتداء ذلك الطوق.",
 "えりぐり": "خط العنق (الخط الذي تشكله حافة الملابس حول الرقبة)",
 "えりさいぼう": "خلية قمعية, خلية مطوقة (أي من الخلايا السوطية في الإسفنجيات التي تمتلك طوقاً من السيتوبلازم حول السوط…)",
 "えりだす": "اِخْتَارَ",
 "えりつき": "يَاقَة, قَبَّة\nمثال: كلب زيري يحب ارتداء ذلك الطوق. / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "えりぬき": "نُخْبَة\nمثال: あの科学者たちは選り抜きだ。 — هؤلاء العلماء هم صفوة الصفوة.",
 "えりぬく": "اِخْتَارَ",
 "えりのおりかえし": "طَيَّة",
 "えりまき": "وِشَاح, لِفاع",
 "えりまきしぎ": "دريجة شرسة",
 "えりまきとかげ": "سحلية مكشكشة (سحلية أسترالية شجرية كبيرة آكلة للحشرات ذات طوق من الجلد حول الرقبة)",
 "えりまわり": "يَاقَة, قَبَّة\nمثال: كلب زيري يحب ارتداء ذلك الطوق. / عَكْس عَقَارِب السَّاعَة (في اتجاه معاكس لاتجاه حركة عقارب الساعة)\nمثال: الرجاء التحرك عكس اتجاه عقارب الساعة في دائرة!",
 "えりもと": "رَقَبَة, عُنُق / يَاقَة, قَبَّة\nمثال: كلب زيري يحب ارتداء ذلك الطوق.",
 "えりわける": "صَنَّفَ, قَسَّمَ",
 "えり抜き": "نُخْبَة\nمثال: あの科学者たちは選り抜きだ。 — هؤلاء العلماء هم صفوة الصفوة.",
 "えり抜く": "اِخْتَارَ",
 "える": "نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي…)\nمثال: من علمك نحت الخشب. / اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / اِخْتَارَ",
 "えろい": "شَبَقِيّ, جِنْسِيّ",
 "えん": "يَن\nمثال: 私はそのレコードを買うのに３０００円かかった。 — دفعت 3000 ين لشراء التسجيل. / دَوَائِر تَحْتَ ٱلْعَيْنَيْن (بمعنى الشكل الذي لا بداية له ولا نهاية بشكل قوس مستمر؛ بمعنى الهيئة أو الجهة…) / قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب. / عَلَاقَة, مُنَاسَبَة / أُلْفَة, انْجِذَاب (انجذاب طبيعي أو شعور بالقرابة)\nمثال: انجذاب للسياسة / فُرْصَة / مَقْعَد, مَقْعَدَة (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد. / سِحْرِيّ, شَعْوَذِيّ (يمتلك أو يستخدم قوى خارقة للطبيعة أو يتسم بها) / مِلْح, ملح / كُلُورِيد / بُسْتَان (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على…)\nمثال: أحب سقي البستان. / رَوْضَة, رَوْضَة أَطْفَال / وَلِيمَة, مَأْدُبَة (طعام العُرْس؛ أي طعام صنع لدعوة ولجمع كبير من الناس)\nمثال: كانت الوليمة من أطيب ما ذقت.",
 "えんあい": "نِسْبِيّ",
 "えんあん": "كلوريد الأمونيوم, ملح النشادر (ملح أبيض يستخدم في الخلايا الجافة)",
 "えんあんソーダほう": "كلوريد الأمونيوم, ملح النشادر (ملح أبيض يستخدم في الخلايا الجافة)",
 "えんい": "بعيد, قاصٍ (يقع في أبعد نقطة من نقطة الاتصال أو المنشأ، كما في طرف أو عظم)",
 "えんいん": "تَأْخِير, تَأَخَّر\nمثال: اقترب أجل زيري. / مَرْجِع",
 "えんえい": "بَعِيد المَدَى (يغطي مسافة طويلة)\nمثال: مكالمة بعيدة المسافة",
 "えんえき": "استدلال استنتاجي, استنتاج (الاستدلال من العام إلى الخاص (أو من السبب إلى النتيجة))",
 "えんえきてき": "استدلالي, استنتاجي (يتضمن استنتاجات من مبادئ عامة)\nمثال: تفكير استنتاجي",
 "えんえきほう": "اِسْتِنْتَاج (اِسْتِنْتَاج)\nمثال: المنطق هو طريقة نظامية للوصول إلى الاستنتاج الخاطئ مع الثقة.",
 "えんえん": "إِلى مَا لَا نِهَايَة, بِلَا نِهَايَة (الاستمرار للأبد دون توقف)\nمثال: هناك احتمالات لا حصر لها / تَعَرَّجَ / شهقة, لهاث (سحب قصير ومجهد للنفس مع فتح الفم)\nمثال: أطلقت شهقة وأغمي عليها / مُبْهِر, وَهَّاج (يَلْمَع بِشِدَّة وقُوَّة)\nمثال: انتشر الحريق الهائل بسرعة",
 "えんお": "كَرِهَ (لم يُحِبّ، لم يَسْتطِع تحمُّلَ شَخْص أو أمرٍ، لم يُطِقْه، مقَته وكان عنده…)\nمثال: هتلر كره اليهود.",
 "えんおう": "بطة الماندرين (بطة آسيوية متوجة مبهرجة؛ غالباً ما تُستأنس)",
 "えんか": "تْرُوبَادُور / فَنَار / مُفَرْقِعَات, أَلْعَاب نَارِيَّة / سَدِيم / كُلُورِيد / جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / حَضَانَة, رَوْضَة",
 "えんかい": "طَرَف / سَاحِل, شَاطِئ / مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط. / بَحْر دَاخِلِيّ (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "えんかぎん": "كلوريد الفضة (كلوريد يستخدم بشكل رئيسي في تصنيع المستحلبات الفوتوغرافية)",
 "えんかく": "تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟ / بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "えんかくけいそくき": "تيليمتر, مقياس عن بعد (أي أداة علمية لمراقبة الأحداث عن بعد ونقل المعلومات مرة أخرى إلى المراقب)",
 "えんかくしょり": "معالجة بيانات موزعة, معالجة عن بعد (معالجة البيانات التي يتم فيها تنفيذ بعض الوظائف في أماكن مختلفة ومتصلة بمرافق…)",
 "えんかくせい": "بَعِيد, نَاءٍ (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا.",
 "えんかくそうさ": "تَحَكُّم مِن بُعْد (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا…)\nمثال: من أنت لتحكم علي؟",
 "えんかくそくてい": "قياس عن بعد (النقل والقياس التلقائي للبيانات من مصادر بعيدة عن طريق الأسلاك أو الراديو أو…)",
 "えんかくたんまつそうち": "طرفية بعيدة, محطة طرفية نائية (طرفية متصلة بجهاز كمبيوتر عن طريق وصلة بيانات)",
 "えんかくつうしん": "اتصالات سلكية ولاسلكية (فرع الهندسة الكهربائية المعني بتكنولوجيا الاتصالات الإلكترونية عن بعد)",
 "えんかくほしゅシステム": "تمريرة حاسمة, مساعدة ((رياضة) فعل تمكين لاعب آخر من القيام بلعبة جيدة)\nمثال: قدم لي مساعدة في الأعمال المنزلية",
 "えんかくアクセスデータしょり": "معالجة بيانات موزعة, معالجة عن بعد (معالجة البيانات التي يتم فيها تنفيذ بعض الوظائف في أماكن مختلفة ومتصلة بمرافق…)",
 "えんかすいぎん": "المتسامي الآكل, كلوريد الزئبق (مادة بلورية بيضاء سامة قابلة للذوبان (ناتجة عن تسامي الزئبق)؛ تستخدم كمبيد…)",
 "えんかすいそ": "كلوريد الهيدروجين",
 "えんかだいいちすいぎん": "المتسامي الآكل, كلوريد الزئبق (مادة بلورية بيضاء سامة قابلة للذوبان (ناتجة عن تسامي الزئبق)؛ تستخدم كمبيد…)",
 "えんかだいにすいぎん": "المتسامي الآكل, كلوريد الزئبق (مادة بلورية بيضاء سامة قابلة للذوبان (ناتجة عن تسامي الزئبق)؛ تستخدم كمبيد…)",
 "えんかつ": "نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "えんかつか": "تسهيل, تيسير (فعل المساعدة أو جعل تقدم شيء ما أو تحسينه أسهل)\nمثال: التيسير الاجتماعي هو حالة تكيفية",
 "えんかつにする": "نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "えんかふのう": "تعذر البلع, لا بلع (فقدان القدرة على البلع)",
 "えんかぶつ": "كُلُورِيد",
 "えんかん": "دَوَائِر تَحْتَ ٱلْعَيْنَيْن (بمعنى الشكل الذي لا بداية له ولا نهاية بشكل قوس مستمر؛ بمعنى الهيئة أو الجهة…) / مَدْخَنَة / خَصِيّ, مَخْصِيّ",
 "えんかんすう": "دَالَّة دَائِرِيَّة, دَالَّة مُثَلَّثِيَّة (دالة لزاوية معبر عنها كنسبة لطول أضلاع مثلث قائم الزاوية يحتوي على الزاوية)",
 "えんかんめん": "طَارَة (في و: هو اسم آخر للمِقْوَد، وخصوصاً مقوَد السَيَّارَة؛ في و: الشخص الماهر في…)",
 "えんかアセチル": "كلوريد الأسيتيل",
 "えんかアルミニウム": "كلوريد الألومنيوم (كلوريد يستخدم كمادة حافظة للخشب أو محفز)",
 "えんかアンモニウム": "كلوريد الأمونيوم, ملح النشادر (ملح أبيض يستخدم في الخلايا الجافة)",
 "えんかエチル": "كلوريد الإيثيل (غاز عديم اللون قابل للاشتعال يستخدم كمخدر سطحي موضعي)",
 "えんかカリウム": "كلوريد البوتاسيوم",
 "えんかカルシウム": "كلوريد الكالسيوم (ملح متميع؛ يستخدم في إزالة الجليد وكعامل تجفيف)",
 "えんかナトリウム": "كُلُورِيد الصُودِيُوم",
 "えんかビニルかん": "بي في سي, كلوريد البوليفينيل (بوليمر من كلوريد الفينيل يُستخدم بدلاً من المطاط في الكابلات الكهربائية)",
 "えんかビニルじゅし": "بي في سي, كلوريد البوليفينيل (بوليمر من كلوريد الفينيل يُستخدم بدلاً من المطاط في الكابلات الكهربائية)",
 "えんがい": "قُبَّة / غِطَاء / تسمم بالرصاص (حالة سامة تنتج عن امتصاص كمية زائدة من الرصاص في الجسم)",
 "えんがいじょう": "قُبَيْعِيّ, كُؤَيْسِيّ (على شكل قُبيعة أو كُؤيس أو يحملها)",
 "えんがん": "سَاحِل, شَاطِئ / مَدَّ النَّظَرِ (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "えんがんきょう": "تِلِسْكُوب, مِقْرَاب",
 "えんがんぶ": "خط الساحل (المخطط الخارجي للساحل)",
 "えんき": "فِرْجَار, بِرْكَار / إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً / قَاعِدَة / هِجْرَان, هُجْرَان / بُغْض, كَرَاهِيَة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "えんきせい": "قلوية (قيم الرقم الهيدروجيني أعلى من 7) / أَسَاسِيّ",
 "えんきせいせんりょう": "صبغة قاعدية (صبغة تعتبر قاعدة لأن الكروموفور (حامل اللون) هو جزء من أيون موجب)",
 "えんきつい": "زوج قاعدي (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)\nمثال: زوجة ماري طبيبة.",
 "えんきはいれつ": "حمض نووي ((كيمياء حيوية) أي من الجزيئات الكبيرة المختلفة المكونة من سلاسل النيوكليوتيدات…)",
 "えんきゅう": "أكمة, رابية (تل طبيعي صغير)",
 "えんきょく": "تلطيفي, مهذب التعبير (من أو ذو طبيعة التلطيف (استخدام تعبير لطيف لشيء كريه))",
 "えんきょくご": "تلطيف التعبير, يوفيميزم (تعبير غير مسيء أو غير مباشر يتم استبداله بآخر يعتبر مسيئاً أو قاسياً جداً)",
 "えんきょくごほう": "تلطيف التعبير, يوفيميزم (تعبير غير مسيء أو غير مباشر يتم استبداله بآخر يعتبر مسيئاً أو قاسياً جداً)",
 "えんきょくてき": "تلطيفي, مهذب التعبير (من أو ذو طبيعة التلطيف (استخدام تعبير لطيف لشيء كريه))",
 "えんきょくひょうげん": "تلطيف التعبير, يوفيميزم (تعبير غير مسيء أو غير مباشر يتم استبداله بآخر يعتبر مسيئاً أو قاسياً جداً)",
 "えんきょくほう": "تلطيف التعبير, يوفيميزم (تعبير غير مسيء أو غير مباشر يتم استبداله بآخر يعتبر مسيئاً أو قاسياً جداً)",
 "えんきょり": "مكالمة بعيدة المدى, مكالمة دولية (مكالمة هاتفية تتم خارج منطقة الاتصال المحلية)\nمثال: تحدثت معها عبر مكالمة بعيدة المدى",
 "えんきょりかいご": "بَعِيد المَدَى (يغطي مسافة طويلة)\nمثال: مكالمة بعيدة المسافة",
 "えんきょりれんあい": "مكالمة بعيدة المدى, مكالمة دولية (مكالمة هاتفية تتم خارج منطقة الاتصال المحلية)\nمثال: تحدثت معها عبر مكالمة بعيدة المدى",
 "えんきり": "تَفْرِقَة",
 "えんきん": "بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "えんきんほう": "مَنْظُور, نَظْرَة",
 "えんきんりょうようめがね": "نظارة ثنائية البؤرة ((جمع) نظارات لها طولان بؤريان، أحدهما للرؤية القريبة والآخر للرؤية البعيدة)",
 "えんきんりょうようメガネ": "نظارة ثنائية البؤرة ((جمع) نظارات لها طولان بؤريان، أحدهما للرؤية القريبة والآخر للرؤية البعيدة)",
 "えんぎ": "دْرَامَا, مَسْرَحِيَّة / تَمْثِيل / ابتذال, تعميم (فعل جعل الشيء جذاباً للجمهور العام) / فَأل, نَذِيْر / مَنْشَأ / إسهاب, بلورة (التطوير بتفاصيل معقدة ومضنية)\nمثال: بضع ملاحظات أضيفت كتوضيح ودفاع",
 "えんぎかじょう": "مبالغة في التمثيل (تمثيل رديء من قبل ممثل مبالغ)",
 "えんぎがいい": "مَيْمُون, مُبَشِّر (يبشر بظروف مواتية وحظ جيد)\nمثال: بداية مبشرة للحملة",
 "えんぎがよい": "مَيْمُون, مُبَشِّر (يبشر بظروف مواتية وحظ جيد)\nمثال: بداية مبشرة للحملة",
 "えんぎしゃ": "عَازِف",
 "えんぎでもない": "سَيِّئُ الطَّالِع, مَنْحُوس (يَتَّسِمُ بِسُوءِ الحَظِّ أَوْ يُنْذِرُ بِهِ)",
 "えんぎのいい": "مَيْمُون, مُبَشِّر (يبشر بظروف مواتية وحظ جيد)\nمثال: بداية مبشرة للحملة",
 "えんぎのよい": "مَيْمُون, مُبَشِّر (يبشر بظروف مواتية وحظ جيد)\nمثال: بداية مبشرة للحملة",
 "えんぎのわるい": "مَشْؤُوم, نَذِير شُؤْم (ينذر بسوء الحظ والطالع)",
 "えんぎもの": "طِلَسْم, طِلَّسْم / عَازِف",
 "えんぎょう": "مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود)\nمثال: رجل يحتضر",
 "えんぐみ": "تَبَنٍّ (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "えんぐん": "تعزيز, دعم (عملية عسكرية (غالباً ما تتضمن إمدادات جديدة من الرجال والعتاد) لتقوية قوة…)\nمثال: طلبوا دعماً مدفعياً",
 "えんけい": "إطلالة, مشهد (المُدرَك البصري لمنطقة ما)\nمثال: أكثر ما يميز الحديقة هو المناظر الجميلة / شكل مستدير (شكل منحني وبدون زوايا حادة)",
 "えんけいげきじょう": "مدرج (ملعب بيضاوي كبير بصفوف مقاعد متدرجة؛ ساحة تقام فيها المسابقات والعروض)",
 "えんけいこうさてん": "دَوَّار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "えんけいだつもうしょう": "ثعلبة بقعية (صلع متقطع (على شكل بقع))",
 "えんけいほうき": "إنذار حريق, كاشف دخان (إنذار ينطلق بسبب الحريق أو الدخان)",
 "えんけん": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "えんげ": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه)",
 "えんげい": "بَسْتَنَة / تَرْفِيه, تَسْلِيَة",
 "えんげいか": "خبير بستنة (خبير في علم زراعة النباتات (الفواكه أو الزهور أو الخضروات أو نباتات الزينة))",
 "えんげいかい": "تَرْفِيه, تَسْلِيَة",
 "えんげいかん": "قاعة موسيقى, مسرح فودفيل (مسرح يتم فيه تقديم عروض الفودفيل)",
 "えんげいがく": "بَسْتَنَة",
 "えんげいじん": "فنان ترفيهي, مُؤنِس (شخص يحاول إمتاع الناس أو تسليتهم)",
 "えんげいのうか": "خبير بستنة (خبير في علم زراعة النباتات (الفواكه أو الزهور أو الخضروات أو نباتات الزينة))",
 "えんげいひんしゅ": "مُسْتَنْبَت",
 "えんげき": "دْرَامَا, مَسْرَحِيَّة / مباغتة, هجوم مفاجئ (هجوم دون سابق إنذار)",
 "えんげきてき": "درامي, مثير (مناسب لـ أو من خصائص الدراما)\nمثال: دخول درامي بعباءة ملوحة",
 "えんげしょうがい": "عسر البلع (حالة يكون فيها البلع صعباً أو مؤلماً)",
 "えんげつ": "هِلَال / بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ…)",
 "えんげつとう": "سَيْف (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها…)\nمثال: القلم أقوى من السيف.",
 "えんげん": "مَنْشَأ / غزل, ملاطفة (سلوك مرح يهدف إلى إثارة الاهتمام الجنسي) / بُغْض, ضَغِينَة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "えんげんどう": "قِمَار, مُقَامَرَة",
 "えんこ": "عَلَاقَة / بُحَيْرَة مِلْحَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة. / ضغط الأوتار (نوع العزف الذي يتضمن الضغط بالأصابع على أوتار آلة وترية للتحكم في النغمة)\nمثال: كان ضغط عازف الكمان للأوتار ممتازاً",
 "えんこい": "مكالمة بعيدة المدى, مكالمة دولية (مكالمة هاتفية تتم خارج منطقة الاتصال المحلية)\nمثال: تحدثت معها عبر مكالمة بعيدة المدى",
 "えんこう": "هَالَة / لَهَب, شُعْلَة / سَعْدَان, قِرْد / كَبَا / مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود)\nمثال: رجل يحتضر",
 "えんこうげいとう": "حب الحب, زهرة القطيفة (تستخدم الأوراق الصغيرة على نطاق واسع كخضروات ورقية؛ تستخدم البذور كحبوب)",
 "えんこうるい": "دائريات الفم (فقاري مائي بدائي)",
 "えんこさいよう": "محسوبية الأقارب (المحاباة التي يظهرها من هم في السلطة للأقارب أو الأصدقاء المقربين (كإعطائهم…)",
 "えんこしゃ": "نِسْبِيّ",
 "えんこしゅぎ": "محسوبية الأقارب (المحاباة التي يظهرها من هم في السلطة للأقارب أو الأصدقاء المقربين (كإعطائهم…)",
 "えんこつ": "نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "えんこん": "عَدَاوَة",
 "えんご": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة. / تطبيق, طلاء (عمل وضع شيء (على سطح))\nمثال: وصف الطبيب وضعاً موضعياً لليود / بُغْض, ضَغِينَة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "えんごしゃげき": "تغطية نارية, نيران التغطية (نيران تجعل من الصعب على العدو إطلاق النار على أفرادك أو تشكيلاتك)\nمثال: وفرت المدفعية نيران تغطية للانسحاب / إسناد, دعم (فعل تحمل وزن أو تقوية شيء ما)\nمثال: استند على الحائط للدعم",
 "えんさ": "مرارة",
 "えんさだめ": "اتفاق ما قبل الزواج, عقد زواج (اتفاق أو عقد ما قبل الزواج)",
 "えんさん": "حَامِض الْهِيدْرُولِيك, حَمْض الْهِيدْرُولِيك",
 "えんさんえん": "هيدروكلوريد (معقد يتكون من قاعدة عضوية مرتبطة بكلوريد الهيدروجين)",
 "えんざい": "تحريف, تزييف (تحريف متعمد للحقائق) / ملاكمة تدريبية, مناوشة (القيام بحركات الهجوم والدفاع بالقبضات والأذرع؛ جزء من تدريب الملاكم)",
 "えんざん": "عَمَلِيَّة, عَمَل",
 "えんざんきごうしょうりゃく": "غير موصول, مفكك (يفتقر إلى أدوات العطف)",
 "えんざんし": "داهية, محتال ذكي (شخص ذكي أو عديم المبادئ يعرف كيفية التحايل على الصعوبات لتحقيق أهدافه)\nمثال: مشغل لوحة المفاتيح",
 "えんざんしほう": "تحليل عملياتي (تقنية يتم من خلالها تحويل المشاكل في التحليل، ولا سيما المعادلات التفاضلية، إلى…)",
 "えんざんすう": "الكمية المحسوبة, مُعامَل (كمية يتم إجراء عملية رياضية عليها)",
 "えんざんそし": "عنصر منطقي (جهاز إلكتروني يؤدي عملية منطقية أولية)",
 "えんざんたいしょう": "الكمية المحسوبة, مُعامَل (كمية يتم إجراء عملية رياضية عليها)",
 "えんざんてじゅん": "خَوَارِزْمِيَّة (خوارزمية: مجموعة من الخطوات والقواعد المحددة التي تُتَّبع لحل مسألة أو تنفيذ…)\nمثال: هذه الخوارزمية لا تتقارب.",
 "えんざんコード": "رمز العملية, كود العملية (الجزء من مجموعة أوصاف العمليات الذي يحدد العملية التي سيتم تنفيذها؛ مجموعة…)",
 "えんし": "مَدَّ النَّظَرِ (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى. / جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه)",
 "えんしがん": "مَدَّ النَّظَرِ (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى.",
 "えんしゃ": "قَلِيْلُ ٱلاِحْتِمالِ (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء)\nمثال: و بعد قليل أتى.",
 "えんしゅう": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط. / تَدْرِيب (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة…)\nمثال: واصل زيري التدريب. / مُنَاوَرَة عَسْكَرِيَّة / نَدْوَة / مرارة",
 "えんしゅうりつ": "بِي, پِي",
 "えんしゅつ": "اِتِّجَاه\nمثال: لا تنس إخراج القمامة. / تَرْتِيب, تَنْظِيم (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "えんしゅつか": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير.",
 "えんしょ": "مَوْجَة اَلْحَرّ / رِسَالَةُ حُبٍّ",
 "えんしょう": "اِلْتِهَاب / بَارُود / وَشِيع, سِيَاج نَبَاتِيّ",
 "えんしょうせい": "تَحْرِيضِيّ",
 "えんしょく": "لَهَب, شُعْلَة",
 "えんしん": "تَمَدُّد, مط (عملية التوسع عن طريق الإطالة أو التوسيع) / طَرْد مَرْكَزِيّ / مُدَوَّر (اسم فاعل من دَوَّرَ، الشخص الذي يُدَوِّر)\nمثال: هناك طاولة مدورة في غرفة الضيوف.",
 "えんしんき": "طَرْد مَرْكَزِيّ",
 "えんしんせい": "حَرَكِيّ, صَادِر (للأعصاب والنبضات العصبية؛ تنقل المعلومات بعيداً عن الجهاز العصبي المركزي)\nمثال: أعصاب ونبضات صادرة",
 "えんしんせいしんけい": "عصبون حركي (عصبون ينقل النبضات من الدماغ أو الحبل الشوكي إلى الخارج)",
 "えんしんてき": "نَابِذ",
 "えんしんぶん": "نَابِذ",
 "えんしんぶんり": "طرد مركزي, نبذ مركزي (عملية فصل المواد ذات الكثافات المختلفة باستخدام جهاز الطرد المركزي)",
 "えんしんぶんりき": "طَرْد مَرْكَزِيّ",
 "えんしんぼいん": "صائت مدور, صائت مضموم ((لغويات) صائت يتم نطقه مع ضم الشفتين وتشكيل فتحة دائرية)",
 "えんしんりょく": "قوة الطرد المركزي (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة…)\nمثال: توم شعر بالقوة.",
 "えんじ": "طفل ما قبل المدرسة (طفل يرتاد حضانة أو روضة أطفال) / أحمر خدود (مكياج يتكون من مسحوق وردي أو أحمر يوضع على الخدين) / أحمر داكن (لون أحمر يعكس القليل من الضوء) / دودة قرمزية",
 "えんじいろ": "أحمر داكن (لون أحمر يعكس القليل من الضوء)",
 "えんじつてん": "أَوْج",
 "えんじむし": "دودة القرمز (حشرة قشرية حمراء مكسيكية تتغذى على الصبار؛ مصدر لصبغة حمراء)",
 "えんじゃ": "مانح, متبرع (شخص يقدم هدية أو هبة من ممتلكاته) / عَازِف / نِسْبِيّ",
 "えんじゃく": "اَلنِّرْفَانَا / تَافِه, ضَيِّق النَّظَر (مَحْدُود الأُفُق بِشَكْلٍ مُحْتَقَر)",
 "えんじゃびいき": "محسوبية الأقارب (المحاباة التي يظهرها من هم في السلطة للأقارب أو الأصدقاء المقربين (كإعطائهم…)",
 "えんじゅ": "أقدمية, طول العمر (خاصية العيش طويلاً)\nمثال: طول بقائها كنجمة / شجرة الباغودا اليابانية, صفيراء يابانية (شجرة نفضية جميلة مستديرة الرأس لها أوراق مركبة خضراء داكنة وعناقيد غزيرة من…) / شجرة الرصاص, ليوسينا (شجرة منخفضة شجيرية من المناطق الاستوائية وشبه الاستوائية في أمريكا الشمالية ذات…)",
 "えんじゅく": "نضج (حالة كونه ناضجاً (للثمار))",
 "えんじゅくした": "برخامة, بنعومة (بطريقة رخيمة)",
 "えんじゅくみ": "انتشاء, نشوة (المرح واللطف، كما من خلال تأثيرات الكحول أو الماريجوانا)\nمثال: رقة الضوء والظلال التي لا يمكن تحقيقها في الرخام",
 "えんじゅつ": "مُحَاضَرَة",
 "えんじょ": "مُسَاعَدَة, إِمْدَاد / رِسَالَةُ حُبٍّ",
 "えんじょしゃ": "داعم رياضي (داعم للأعضاء التناسلية يرتديه الرجال الذين يمارسون تمارين شاقة)\nمثال: مساعدي الذي لا يقدر بثمن",
 "えんじる": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل. / أَدَّى / اِرْتَكَبَ / اِدَّعَى\nمثال: تظاهر بأنه طبيب.",
 "えんじん": "بُغْض الْبَشَرِيَّة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك…)\nمثال: سأذهب بغض النظر عن مجيئه. / دَوَائِر تَحْتَ ٱلْعَيْنَيْن (بمعنى الشكل الذي لا بداية له ولا نهاية بشكل قوس مستمر؛ بمعنى الهيئة أو الجهة…) / خَصِيّ, مَخْصِيّ / تُرْبَة, تُرَاب",
 "えんじんしゃ": "كاره للناس, مبغض للبشر (شخص يكره الناس بشكل عام)",
 "えんじ色": "أحمر داكن (لون أحمر يعكس القليل من الضوء)",
 "えんすい": "مَخْرُوط (اسم المفعول من خَرَطَ؛ (هندسة) مُجَسَّمٌ يبتدئُّ من سَطْحٍ دائريٍّ أَو مستدير…) / مَاء مِلْح (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما…)\nمثال: أنا أشرب الماء. / ثقل الشاقول (الثقل المعدني لخيط الشاقول)",
 "えんすいかくまく": "القرنية المخروطية (بروز مخروطي غير طبيعي لقرنية العين؛ يمكن علاجه برأب القرنية الفوقي)",
 "えんすいきょくせん": "قطاع مخروطي ((هندسة) منحنى ناتج عن تقاطع مستوى مع مخروط دائري)",
 "えんすいけい": "شكل مخروطي, مخروط (شكل قاعدته دائرة وتستدق جوانبه لتصل إلى نقطة)",
 "えんすいずほう": "إسقاط مخروطي (إسقاط خرائطي للكرة الأرضية على مخروط تقع رأسه فوق أحد قطبي الأرض)",
 "えんすいたい": "مَخْرُوط (اسم المفعول من خَرَطَ؛ (هندسة) مُجَسَّمٌ يبتدئُّ من سَطْحٍ دائريٍّ أَو مستدير…)",
 "えんすいだい": "مخروط ناقص (جذع مُشكل من مخروط)",
 "えんずい": "نُخَاع مُسْتَطِيل, بَصَلَة سِيسَائِيَّة",
 "えんずる": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل. / أَدَّى / اِرْتَكَبَ",
 "えんせい": "سأم من الحياة (الحزن عند التفكير في شرور العالم) / قابلية للسحب, مطيلية (طواعية الشيء الذي يمكن سحبه إلى خيوط أو أسلاك أو طرقه إلى صفائح رقيقة) / شِكَايَة, شَكْوَى / بعثة, حملة (رحلة منظمة لغرض معين)\nمثال: العديد من النزهات الصيفية إلى الشاطئ / رَصَاصِيّ / مَالِح, مِلْحِيّ (يَحْتَوِي عَلَى مِلْح) / بُسْتَان (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على…)\nمثال: أحب سقي البستان. / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "えんせいか": "مُتَشَائِم",
 "えんせいかん": "تَشَاؤُم",
 "えんせいしゅぎ": "تَشَاؤُم",
 "えんせいじあい": "مباراة الذهاب, مباراة خارج الأرض (مباراة تُلعب بعيداً عن الملعب الرئيسي للفريق)",
 "えんせいてき": "سَئِمٌ مِنَ الدُّنْيَا, ضَجِر (مُتْعَبٌ مِنَ الحَيَاةِ وَمَا فِيهَا)",
 "えんせいひかんしゃ": "مُتَشَائِم",
 "えんせき": "وَلِيمَة, مَأْدُبَة (طعام العُرْس؛ أي طعام صنع لدعوة ولجمع كبير من الناس)\nمثال: كانت الوليمة من أطيب ما ذقت. / نِسْبِيّ / إطار داخلي (تركيب يتكون من حد أو خلفية لصورة) / ضبط, كبح (فعل تقييد القوة أو العمل أو الحد من التجاوز)\nمثال: حسه السليم هو لجام لمزاجه السريع / حَصَاة",
 "えんせきがいせん": "شُوح",
 "えんぜつ": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "えんぜつか": "خَطِيب, مُتَكَلِّم",
 "えんぜつしゃ": "خَطِيب, مُتَكَلِّم",
 "えんぜん": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له. / كَرِيم, مُنْعِم (ميّال إلى منح النِّعم والإحسان)\nمثال: لطيف حتى مع الزوار غير المتوقعين / رَشِيق, ظَرِيف",
 "えんそ": "جد, سلف (مؤسس العائلة)\nمثال: حافظوا على إيمان أجدادنا / كُلُور",
 "えんそう": "أداء موسيقي (فعل أداء الموسيقى) / مَرْكَز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟ / بِاتِّجَاه الحَافَّة, مِن الحَافَّة (مع الحافة للأمام أو على، بواسطة، أو نحو الحافة)\nمثال: نشر اللوح من الحافة / تِبْغ, تَبْغ",
 "えんそうかい": "حَفْلَة\nمثال: عزف على البيانو.",
 "えんそうきごう": "تَدْوِين مُوسِيقِيّ",
 "えんそうこうどう": "نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني",
 "えんそうしゃ": "عَازِف",
 "えんそく": "رحلة ميدانية (رحلة جماعية (إلى متحف أو غابة أو مكان تاريخي) للفحص المباشر) / جَوْلَة, نُزْهَة",
 "えんそけい": "كلور",
 "えんそさん": "حمض الكلوريك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في…)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "えんそさんえん": "كلورات (أي ملح لحمض الكلوريك)",
 "えんそさんカリウム": "كلورات البوتاسيوم",
 "えんそさんナトリウム": "كلورات الصوديوم",
 "えんそしょうどく": "كلورة (تطهير المياه بإضافة كميات صغيرة من الكلور أو مركب الكلور)",
 "えんそしょり": "كلورة (تطهير المياه بإضافة كميات صغيرة من الكلور أو مركب الكلور)",
 "えんそすい": "ماء الكلور (محلول مائي للكلور يستخدم كعامل تبييض)",
 "えんぞ": "رِسَالَةُ حُبٍّ",
 "えんたい": "متأخرات (دين غير مدفوع تجاوز موعد استحقاقه)\nمثال: حساب عليه متأخرات / تحديد الموقع, تمركز (فعل وضع شيء ما في مكان معين)",
 "えんたいきん": "متأخرات (دين غير مدفوع تجاوز موعد استحقاقه)\nمثال: حساب عليه متأخرات",
 "えんたいごう": "مَخْبَأ, قَبْو",
 "えんたいりょう": "متأخرات (دين غير مدفوع تجاوز موعد استحقاقه)\nمثال: حساب عليه متأخرات",
 "えんたいりょうきん": "متأخرات (دين غير مدفوع تجاوز موعد استحقاقه)\nمثال: حساب عليه متأخرات",
 "えんたく": "مائدة مستديرة (اجتماع للأقران للمناقشة وتبادل وجهات النظر)\nمثال: مائدة مستديرة حول مستقبل الحوسبة",
 "えんたくかいぎ": "مائدة مستديرة (اجتماع للأقران للمناقشة وتبادل وجهات النظر)\nمثال: مائدة مستديرة حول مستقبل الحوسبة",
 "えんたん": "أكسيد الرصاص الأحمر, الرصاص الأحمر",
 "えんたんちき": "إنذار حريق, كاشف دخان (إنذار ينطلق بسبب الحريق أو الدخان)",
 "えんだい": "بِنْش / جَلِيل, فَخْم (يُوصَف بِهِ مَظْهَر الشَّخْص أَوْ سُلُوكه؛ يَلِيق بِشَخْصٍ بَارِز) / منبر القراءة, منصة إلقاء (مكتب أو حامل ذو سطح مائل يستخدم لحمل نص على الارتفاع المناسب للمحاضر) / خطم (نتوء يشبه المنقار للجزء الأمامي من رأس بعض الحشرات مثل السوس)",
 "えんだん": "كرة مدفع (مقذوف صلب كان يُطلق في العصور القديمة من مدفع) / خطم (نتوء يشبه المنقار للجزء الأمامي من رأس بعض الحشرات مثل السوس) / قنبلة دخانية (قنبلة تطلق دخاناً كثيفاً عند انفجارها؛ تستخدم لعمل ستار دخاني أو لتحديد موقع) / طَلَب زَوَاج, عَرْض زَوَاج (عرض للزواج)",
 "えんち": "حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية…)\nمثال: ليس لدينا حديقة.",
 "えんちてん": "أَوْج",
 "えんちゅう": "عَمُود",
 "えんちゅうけい": "أُسْطُوَانَة",
 "えんちゅうじょう": "أُسْطُوَانَة",
 "えんちゅうどく": "تسمم بالرصاص (حالة سامة تنتج عن امتصاص كمية زائدة من الرصاص في الجسم)",
 "えんちょう": "قُبَّة / حَضَانَة, رَوْضَة / تَمْدِيد / طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير. / وَقْت إِضَافِيّ (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب.",
 "えんちょうこうはん": "شوط ثاني (الثاني من شوطين للعب)",
 "えんちょうせん": "وَقْت إِضَافِيّ (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب.",
 "えんちょうぜんはん": "شوط أول (الأول من شوطين للعب)",
 "えんちょうコード": "سِلْك تَوْصِيل (السِّلْكُ : الخيطُ الذي ينظَم فيه الخرز ونحوه، أَو الذي يخاط به؛ السِّلْكُ :…)\nمثال: هذا السلك ساخن.",
 "えんちょく": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم.",
 "えんちょくけん": "دائرة راسية (دائرة عظمى على الكرة السماوية تمر عبر السمت وتكون عمودية على الأفق)",
 "えんちん": "رَاسِب",
 "えんつづき": "نِسْبِيّ",
 "えんづき": "زَوَاج, نِكَاح",
 "えんづく": "تَزَوَّجَ\nمثال: زوجة ماري طبيبة.",
 "えんづける": "زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)\nمثال: زوجة ماري طبيبة.",
 "えんてい": "سَدّ, سد (أغلق الخلل ورَدَمَ الثلم فلائم الردمُ الثلم؛ الطريق: أغلقه وأعاق السير فيه) / بُسْتَانِيّ, بُسْتَانِيَّة / بُسْتَان (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على…)\nمثال: أحب سقي البستان. / مَلْعَب أَطْفَال (موضع اللَعِب عامة؛ موضع يلعب فيه الصغار، يوضع لهم فيه العاب)\nمثال: .يمشون في الملعب / هَاوِيَة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة)\nمثال: وصل سامي إلى قاع الهاوية ماليا. / أعماق, أغوار ((الجمع) الجزء الأعمق والأكثر بعداً)\nمثال: من أعماق أفريقيا المظلمة / تَمَامًا",
 "えんてん": "فَخْم, مُسْتَدِير ((للأصوات) ممتلئ وغني) / فَصِيح, فُصْحَى / حَسَن (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة. / أوج, نقطة الأوج ((في الفلك) النقطة في المدار الأبعد عن الجرم الذي يتم الدوران حوله)",
 "えんてんかつだつ": "دَمِث, لَبِق (مُجَامِل بِسَلَاسَة وَأَدَب مَعَ قَدْرٍ مِنَ الرُّقِيّ) / حُرُّ الحَرَكَة, مُتَعَدِّدُ الاتِّجَاهَات (قَادِرٌ عَلَى التَّحَرُّكِ بِحُرِّيَّةٍ فِي جَمِيعِ الاتِّجَاهَات)",
 "えんでん": "حوض ملحي (حوض ضحل في منطقة صحراوية؛ يحتوي على الملح والجبس المترسب من بحيرة مالحة متبخرة)",
 "えんとう": "أُسْطُوَانَة / مَدْخَنَة",
 "えんとうけい": "أُسْطُوَانِيّ (ذو شكل الأسطوانة)",
 "えんとつ": "مَدْخَنَة",
 "えんどう": "جانب الطريق (حافة طريق أو مسار)\nمثال: زهور على جانب الطريق / بَازِلَّاء / تحويلة, طريق التفافي (طريق غير مباشر (خاصة الذي يستخدم مؤقتاً أثناء إغلاق الطريق الرئيسي)) / مَدْخَنَة",
 "えんどうまめ": "بَازِلَّاء",
 "えんどう豆": "بَازِلَّاء",
 "えんどおい": "مُبَعْثَر, مُشَوَّش (يفتقر إلى الاستمرارية المنظمة)",
 "えんどく": "تسمم بالرصاص (حالة سامة تنتج عن امتصاص كمية زائدة من الرصاص في الجسم)",
 "えんにち": "أَشْقَر (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان…)\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر.",
 "えんにちてん": "أَوْج",
 "えんねん": "أقدمية, طول العمر (خاصية العيش طويلاً)\nمثال: طول بقائها كنجمة",
 "えんのう": "ائتمان, دفع مؤجل (ترتيب للدفع المؤجل للسلع والخدمات)",
 "えんのした": "فِي الخَفَاء, مُتَرَبِّصًا (بهدوء في الخفاء)\nمثال: استلقى متربصاً",
 "えんのしたのちからもち": "بطل مجهول",
 "えんのない": "لا تربطه قرابة, ليس قريباً (غير متصل بقرابة)",
 "えんはいなもの": "هُنَاكَ, يُوجَدُ",
 "えんばい": "بَهَار, تَابِل",
 "えんばく": "شُوفَان, خَرْطَال",
 "えんばん": "قُرْص\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / طَبَق طَائِر (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ. / صُورَة نَمَطِيَّة",
 "えんばんじょう": "قُرْصِيّ, مُسَطَّحٌ دَائِرِيّ (ذو شكل دائري مسطّح كالقرص)",
 "えんばんじょうエリテマトーデス": "ذئبة حمامية قرصية (مرض جلدي مزمن يتميز بطفح جلدي من آفات حمراء على الخدين وجسر الأنف)",
 "えんばんクラッチ": "قابض قرصي (قابض احتكاكي تكون فيه أسطح الاحتكاك عبارة عن أقراص)",
 "えんぱ": "رذاذ البحر (رذاذ من أمواج المحيط)",
 "えんぱい": "أحدب (شخص ظهره مقوس بسبب انحناء غير طبيعي في العمود الفقري العلوي)",
 "えんぱく": "سِبِيدَاج, بَارُوق",
 "えんび": "أَبِيقُورِيّ, مُتَرَفّ (يعرض الترف ويُمتِّع الحواسّ) / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "えんびふく": "بدلة بذيول, بدلة رسمية كاملة (ملابس رسمية تتكون من زي سهرة كامل للرجال)",
 "えんぴつ": "قَلَم رَصَاص, قَلَم (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "えんぴつが": "رَسْم تَقْرِيبِيّ, رَسِيمَة (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم.",
 "えんぴつけずり": "بَرَّايَة, مِبْرَاة",
 "えんぴつのき": "عرعر أحمر شرقي (عرعر صغير يوجد شرق جبال روكي له تاج مخروطي ولحاء بني يتقشر في شرائح وإبر صغيرة…)",
 "えんぴつびゃくしん": "عرعر أحمر شرقي (عرعر صغير يوجد شرق جبال روكي له تاج مخروطي ولحاء بني يتقشر في شرائح وإبر صغيرة…)",
 "えんぶ": "فَالْس, رَقْصَة الْفَالْس / هُدْنَة",
 "えんぶきょく": "فَالْس, رَقْصَة الْفَالْس",
 "えんぶじょう": "دار عرض, مسرح (مبنى يمكن فيه تقديم العروض المسرحية أو عروض الصور المتحركة)\nمثال: كان المسرح ممتلئاً",
 "えんぶたんごん": "ذهب خالص, ذهب عيار 24 (ذهب بنسبة 100 في المائة)",
 "えんぶだごん": "ذهب خالص, ذهب عيار 24 (ذهب بنسبة 100 في المائة)",
 "えんぶん": "مِلْح, ملح",
 "えんぶんのうど": "مِلْحِيَّة",
 "えんぷくか": "زير نساء, مغوٍ (رجل يستغل النساء)",
 "えんぺい": "غِطَاء / احْتِجَاب / تعزيز, دعم (عملية عسكرية (غالباً ما تتضمن إمدادات جديدة من الرجال والعتاد) لتقوية قوة…)\nمثال: طلبوا دعماً مدفعياً",
 "えんぺいごう": "مَخْبَأ, قَبْو",
 "えんぺん": "حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما)\nمثال: قام بتدوير حواف الصندوق",
 "えんぼう": "إطلالة, مشهد (المُدرَك البصري لمنطقة ما)\nمثال: أكثر ما يميز الحديقة هو المناظر الجميلة / بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل) / مرارة",
 "えんまく": "سِتَار دُخَانِيّ",
 "えんまん": "مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين)",
 "えんみ": "مُلُوْحَة",
 "えんみょう": "داعم للحياة (مكون من أو متعلق بالمعدات أو الأساليب المستخدمة للحفاظ على الحياة)",
 "えんむ": "عَجَاج",
 "えんむしつ": "هَبَاء جَوِّيّ, أَيْرُوسُول",
 "えんむすび": "زَوَاج, نِكَاح",
 "えんむすびのかみ": "خَاطِب, خَاطِبَة",
 "えんめい": "داعم للحياة (مكون من أو متعلق بالمعدات أو الأساليب المستخدمة للحفاظ على الحياة)",
 "えんめいそう": "بليكترانتوس, نبات الشار (أي من نباتات الزينة المتنوعة من جنس بليكترانتوس)",
 "えんめつ": "تَدْمِير, هَدْم / إخفاء, كتمان (نشاط إبقاء شيء ما سراً)\nمثال: ذهب في الاختباء (تواري عن الأنظار)",
 "えんもく": "بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ)\nمثال: نشط البرنامج الآن.",
 "えんもゆかりもない": "غَرِيب, غَرِيبَة",
 "えんや": "سِحْرِيّ, شَعْوَذِيّ (يمتلك أو يستخدم قوى خارقة للطبيعة أو يتسم بها)",
 "えんゆ": "صِلَة, صُلَة / مَنْشَأ / حَافِز",
 "えんゆう": "صِلَة, صُلَة / مَنْشَأ / حَافِز / بصيرة, بعد نظر (حسن التدبير بحكم التخطيط الحكيم للمستقبل)",
 "えんゆうかい": "حفلة حديقة, حفلة خارجية (حفلة يجتمع فيها الناس للتفاعل الاجتماعي في الهواء الطلق)",
 "えんよう": "اقتباس (ممارسة الاقتباس من الكتب أو المسرحيات وغيرها)\nمثال: بما أنه يفتقر إلى الأصالة، يجب عليه الاعتماد على الاقتباس / مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط. / صَيْف, صيف (فصل من فصول السنة الأربعة، يلي الرَّبِيع ويأتي بعده الخَرِيف، يتميز بشدة الحَرّ)\nمثال: نأتي هنا كل صيف.",
 "えんようぎょぎょう": "أَعْمَاقِيّ بَحْرِيّ (يتعلق بـأو يحدث في الأجزاء العميقة من البحر)",
 "えんようこうろ": "طريق ملاحي, ممر بحري (ممر في البحر يعتبر طريقاً منتظماً للسفن)",
 "えんようていきせん": "باخرة ركاب, سفينة رحلات (سفينة تجارية كبيرة (خاصة تلك التي تنقل الركاب وفق جدول منتظم))",
 "えんらく": "ابتهاج, احتفال صاخب (احتفال صاخب؛ بهجة ومرح)",
 "えんりょ": "اِحْتِيَاط\nمثال: حجز مناد موعدا. / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / احتراس, تروي (التعقل في تجنب الضرر أو الخطر)\nمثال: توخى الحذر عند فتح الباب",
 "えんりょえしゃくもない": "غير مراعٍ, مستهتر (يفتقر إلى الاهتمام بحقوق أو مشاعر الآخرين)\nمثال: سلوك مستهتر بشكل صادم",
 "えんりょがち": "خَجُول, خَجِل",
 "えんりょぎみ": "بِاسْتِحْيَاء, بِخَجَل (بطريقة تتسم بالخجل أو التردد)\nمثال: ابتسم بخجل",
 "えんりょなく": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "えんりょのない": "صريح, غير متحفظ (غير حذر أو متحفظ)\nمثال: سلوك غير متحفظ",
 "えんりょぶかい": "مَحْجُوز",
 "えんる": "إبعاد, حظر (الرفض عن طريق فعل نفي أو حظر شخص ما)\nمثال: يجب على الجمعية التخلص من أعضائها المسنين - ليس عن طريق القتل الرحيم بالطبع، ولكن عن طريق النبذ",
 "えんるい": "مِلْح, ملح",
 "えんるいへいげん": "مسطح ملحي (مساحة مسطحة من الملح خلفتها عملية تبخر جسم مائي مالح)",
 "えんるいようえき": "مَالِح, مِلْحِيّ (يَحْتَوِي عَلَى مِلْح)",
 "えんれい": "مُبْهِر, وَهَّاج (يَلْمَع بِشِدَّة وقُوَّة) / أقدمية, طول العمر (خاصية العيش طويلاً)\nمثال: طول بقائها كنجمة",
 "えんれん": "مكالمة بعيدة المدى, مكالمة دولية (مكالمة هاتفية تتم خارج منطقة الاتصال المحلية)\nمثال: تحدثت معها عبر مكالمة بعيدة المدى / ثَقَبَ, نَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود.",
 "えんろ": "حلاقة الترهب, طونسورة (حلاقة قمة الرأس من قبل الكهنة أو أعضاء الرهبنة) / طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق.",
 "えんグラフ": "مخطط دائري (مخطط دائري مقسم إلى مناطق مثلثة تتناسب مع نسب الكل)",
 "えんタク": "تَاكْسِي, سَيَّارَةُ أُجْرَة",
 "えんビ": "انقباض بطيني سابق لأوانه (عدم انتظام في إيقاع القلب؛ يمكن أن يكون تكرار حدوثه مقدمة للرجفان البطيني)",
 "えんビかん": "بي في سي, كلوريد البوليفينيل (بوليمر من كلوريد الفينيل يُستخدم بدلاً من المطاط في الكابلات الكهربائية)",
 "えん麦": "شُوفَان, خَرْطَال",
 "えグラフ": "بيكتوغراف, رمز تصويري (رمز رسومي يُستخدم في الكتابة التصويرية)",
 "えー": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق. / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "えーかげん": "غير مسؤول, مستهتر (يظهر عدم الاكتراث بالعواقب)\nمثال: تصرف كأحمق غير مسؤول / فَاتِر (الفَاتِرُ : ما بينَ الحارِّ والبارِد؛ \" اُسْتُقْبِلَ اسْتِقْبَالاً فَاتِراً \":…) / كَافٍ (كِفَايَة، يَكْفِي، كَافِ؛ مَه، كَفَى)\nمثال: خسر كافة ممتلكاته. / إلى حد كبير, بشكل جوهري (إلى مدى أو درجة كبيرة)\nمثال: أخشى أن الفيلم تجاوز الميزانية بكثير",
 "えーっ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق. / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "えーっと": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "えーと": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "えーー": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق. / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "えーーっと": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "えーーーっと": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "えーーーーっと": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "え辛い": "حَارِق, لَاذِع (قاسٍ أو كاوٍ في اللهجة)",
 "お": "خَيْط, حَبْل ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ…)\nمثال: حل الصرة تلقى خيط. / وَتَر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه…) / ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند…)\nمثال: عذر أقبح من ذنب. / قِنَّب هِنْدِيّ / قِنَّب / صَغِير, صغير / قَلِيلًا / بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / ذَكَرِيّ\nمثال: قتله ذكر زرافة. / رُجُولِيّ / أَكْبَر (كبير نسبةً إلى شيء آخر) / إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق.",
 "おあい": "سماد بشري, فضلات بشرية (فضلات بشرية تستخدم كسماد) / روث, زبل (فضلات الحيوانات) / صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ…)\nمثال: من صاحب هذه الأرض؟",
 "おあいこ": "مُتَسَاوٍ, مُتَصَالِح (على قدم المساواة عن طريق الدفع أو الردّ)",
 "おあいそ": "تَحِيَّات, تَمَنِّيَات (تعبير مهذب عن الرغبة في رفاهية شخص ما)\nمثال: أبلغه تحياتي الطيبة / كَرَم, إِكْرَام / لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه…)\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "おあいそう": "تَحِيَّات, تَمَنِّيَات (تعبير مهذب عن الرغبة في رفاهية شخص ما)\nمثال: أبلغه تحياتي الطيبة / كَرَم, إِكْرَام / لَائِحَة (قانون مكتوب للإشارة إلى مواقف محددة وغرضه أن يمنع حدوث أمر معين أو يحث عليه…)\nمثال: من فضلك أضف اسمي إلى اللائحة.",
 "おあいにくさま": "آسِف / مُؤْسِف, يُؤْسَفُ لَهُ (يَسْتَحِقُّ الأَسَفَ أَوِ النَّدَمَ)",
 "おあし": "نُقُود, مَال\nمثال: أريد بعض المال.",
 "おあずけ": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً",
 "おあそび": "لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس. / فَاتِرُ الهِمَّة, مُتَرَدِّد (يشعر أو يُظهِر اهتماماً أو حماسة قليلة)",
 "おあつらえむき": "كَامِل",
 "おあつらえ向き": "كَامِل",
 "おい": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / اِبْنُ أَخٍ, اِبْنُ أُخْتٍ (الولد الذكر)\nمثال: هو له ابن صغير. / شَيْخُوخَة, عُجُوز / عجوز, كبير السن (شخص متقدم في السن) / إِضَافِيّ, زَائِد (أكثر من اللازم أو مُضاف إلى ما هو موجود)\nمثال: سيارة سريعة بشكل استثنائي",
 "おいえ": "صالون, غرفة جلوس (غرفة في منزل خاص أو منشأة حيث يمكن للناس الجلوس والتحدث والاسترخاء)",
 "おいおい": "شَيْئاً فَشَيْئاً, خُطْوةً فَخُطْوةً",
 "おいおとし": "إقالة, خلع (فعل طرد شخص ما أو إجباره على الخروج (من منصب))",
 "おいおとす": "طَرَدَ / أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة. / إمساك, التقاط (فعل التقاط شيء باليدين)\nمثال: أمسك ميس بالكرة وظهره للوحة",
 "おいかえす": "طَرَدَ",
 "おいかける": "طَارَدَ / بعد ذلك, فيما بعد (يحدث في وقت لاحق لوقت مرجعي)\nمثال: اعتذر لاحقاً",
 "おいかぜ": "رياح خلفية (رياح تهب في نفس اتجاه مسار سفينة أو طائرة)",
 "おいかぶさる": "غِطَاء",
 "おいかわ": "مِقْلَاع",
 "おいきた": "جَيِّد (بَيِّن الجَوْدَة)",
 "おいきり": "مُحَاكَمَة (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري.",
 "おいこし": "اجتياز, نجاح (النجاح في استيفاء اختبار أو شرط)\nمثال: كان مستقبله يعتمد على اجتيازه لذلك الاختبار",
 "おいこししゃせん": "الحارة السريعة, المسار السريع (الحارة المرورية للمركبات التي تتحرك بسرعة)\nمثال: الحياة في المسار السريع للموضة علمتها الكثير",
 "おいこす": "مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق. / فَاقَ, تَجَاوَزَ",
 "おいこみ": "مَعْرِض, صَالَةُ عَرْض / سِيَاقَة, قِيَادَة",
 "おいこむ": "قَطِيع / زَاوِيَة, رُكْن",
 "おいご": "اِبْنُ أَخٍ, اِبْنُ أُخْتٍ (الولد الذكر)\nمثال: هو له ابن صغير.",
 "おいしげる": "اِزْدَهَرَ, أَهَلَّ",
 "おいしそう": "حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم.",
 "おいしゃさま": "طَبِيب, طَبِيبة (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "おいしゅうございました": "شُكْرًا, تِسْلَم",
 "おいそれと": "بسرعة, على الفور (بطريقة دقيقة في المواعيد)\nمثال: أدى واجبه المنزلي بسرعة",
 "おいた": "أذى, شقاوة (سلوك متهور أو خبيث يسبب الإزعاج أو الضيق للآخرين) / شَأْن",
 "おいたち": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها. / تَرْبِيَة",
 "おいたつ": "نَمَى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "おいたて": "إخراج, طرد (فعل الطرد أو القذف أو الإخراج)\nمثال: طرد مثيري الشغب من قبل الشرطة",
 "おいたてる": "أَجْلَى, طَرَدَ",
 "おいだし": "إِبْعَاد ((في السياسية) عقوبة جنائية تقضي بإخراج المحكوم عليه من البلاد)",
 "おいだしコンパ": "تَوْدِيع, حَفْل وَدَاع (تعبير منظم عن حسن النية عند بدء رحلة أو مشروع جديد)\nمثال: كنت هناك مع والدي عند الانطلاق",
 "おいだす": "طَرَدَ, نَفَى",
 "おいちい": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة. / جَذَّاب",
 "おいちゃん": "رجل في منتصف العمر (رجل يتراوح عمره تقريباً بين 45 و 65 عاماً)",
 "おいちょ": "ثَمَانِيَة, تمانية",
 "おいちょう": "ثَمَانِيَة, تمانية",
 "おいちらす": "طَرَدَ",
 "おいちー": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة. / جَذَّاب",
 "おいっこ": "اِبْنُ أَخٍ, اِبْنُ أُخْتٍ (الولد الذكر)\nمثال: هو له ابن صغير.",
 "おいっす": "يَاه, اسمع / نَعَم سَيِّدِي (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: أنت نعم الطالب.",
 "おいつく": "بَلَغَ",
 "おいつめる": "زَاوِيَة, رُكْن",
 "おいて": "صَوْب, ناحية (أحد جانبي المدينة التي يقسمها نهر، ومن ذلك صوب الكرخ وصوب الرصافة في بغداد…)\nمثال: صوب الرجل مسدسا نحو المحققين. / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / بِٱسْمِ / رياح خلفية (رياح تهب في نفس اتجاه مسار سفينة أو طائرة) / اِسْتَثْنَى (أن يشمل الكُلّ إلا جزء، ولا يكون إلا إذا كان الجزءُ جزءًا من الكل) / مُطارِد, مُلاحِق (شخص يطارد ويحاول اللحاق أو القبض على أحد)\nمثال: كان دائمًا قادرًا على خداع مطارديه من قبل / رياح خلفية (رياح تهب في نفس اتجاه مسار سفينة أو طائرة)",
 "おいで": "إتْيَان, أَتْي / جَاءَ (أَتَى؛ حَدَثَ)\nمثال: تقريبا الكل جاء",
 "おいでなさい": "جَاءَ (أَتَى؛ حَدَثَ)\nمثال: تقريبا الكل جاء / أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة)\nمثال: أهلا يا أصدقاء.",
 "おいでなさる": "جَاءَ (أَتَى؛ حَدَثَ)\nمثال: تقريبا الكل جاء",
 "おいでになる": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / جَاءَ (أَتَى؛ حَدَثَ)\nمثال: تقريبا الكل جاء / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ…)\nمثال: ذهب إلى الدكان.",
 "おいでやす": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة)\nمثال: أهلا يا أصدقاء.",
 "おいとま": "ذهاب, رحيل (فعل المغادرة)",
 "おいど": "قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر)\nمثال: نمت في قاعة السينما.",
 "おいどん": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "おいない": "جَاءَ (أَتَى؛ حَدَثَ)\nمثال: تقريبا الكل جاء",
 "おいなりさん": "صَفَن, كِيس اَلصَّفَن",
 "おいぬ": "ذِئْب (حيوان مفترس من فصيلة الكلاب يعيش في جماعات وأكثر ما يصطاد في الليل؛ صفة تطلق…)\nمثال: نظرة الذئب للشاة. / ذِئْبٌ فِي ثَوْبِ حَمَلٍ (حيوان مفترس من فصيلة الكلاب يعيش في جماعات وأكثر ما يصطاد في الليل؛ صفة تطلق…)\nمثال: نظرة الذئب للشاة.",
 "おいぬき": "تجاوز, تخطي (المرور بجانب شيء متحرك للوصول إلى أمامه)\nمثال: كانت تقود بشكل جيد لكن تجاوزها المتهور لكل سيارة على الطريق أخافني / مطارده, ملاحقة (فعل المطاردة في محاولة للحاق أو القبض على شخص)\nمثال: بدأ الجاني في الجري وانطلق الشرطي في مطاردته",
 "おいぬく": "مَرَّرَ, مَرَّ\nمثال: أسأل عن الطريق. / فَاقَ, تَجَاوَزَ",
 "おいのなみ": "جَعْدَة",
 "おいのり": "صَلَاة, دُعَاء",
 "おいのりメール": "إيميل, بريد إلكتروني ((علوم الكمبيوتر) نظام للاتصال الإلكتروني العالمي حيث يمكن لمستخدم الكمبيوتر…)\nمثال: لا يمكنك إرسال طرود بالبريد الإلكتروني",
 "おいはぎ": "قاطِعُ طَرِيق, قُطّاعُ ٱلطُّرُق / قطع الطريق (سلب المسافرين على طريق عام أو بالقرب منه)\nمثال: ما يطلبونه للوقود هذه الأيام هو سرقة علنية",
 "おいはらう": "طَرَدَ",
 "おいばね": "باتلدور (لعبة مضرب قديمة)",
 "おいぼれ": "خرف, هرم (الضعف العقلي نتيجة لكبر السن) / خرف (مسن في مرحلة الخرف؛ شخص أضعف العمر عقله)",
 "おいめ": "الْتِزَام, دَيْن (علاقة شخصية يكون فيها المرء مدينًا بخدمة أو معروف)",
 "おいもとめる": "لَاحَقَ\nمثال: اتبع قلبك فحسب.",
 "おいやる": "طَرَدَ",
 "おいら": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "おいらく": "شَيْخُوخَة, عُجُوز",
 "おいらっち": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )…)\nمثال: نحن مهتمون جدا.",
 "おいる": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في…)\nمثال: جون في عمر أخي.",
 "おいわい": "تَهْنِئَة / حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي",
 "おいコン": "تَوْدِيع, حَفْل وَدَاع (تعبير منظم عن حسن النية عند بدء رحلة أو مشروع جديد)\nمثال: كنت هناك مع والدي عند الانطلاق",
 "おう": "مُقَعَّر, مُجَوَّف / دَمَجَ (دمج الأشياء: جمعها وخلطها معًا؛ دمجهُ:جعله جزءًا من شيء أكبر منه)\nمثال: دمج فكرتين في فكرة. / لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَمَى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟ / طَارَدَ / تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه)\nمثال: تبع المشتبه محققان. / طَرَدَ / قَادَ, سَاقَ / دُبّ / أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي. / تَأَلَّمَ, عَانَى\nمثال: لقد عانى جمال كثيرا. / شَيْخ, عَجُوز / جَلِيل, مُبَجَّل (محلّ احترام وتبجيل عميقين) / مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه. / إمبراطور مالي, بارون (رجل أعمال ثري جداً أو قوي النفوذ)\nمثال: بارون نفط / مُنْتَصَف, وَسَط / اِتِّفَاق, تَوَافُق / بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / النَّمْسَا, النِّمْسَا (دولة في أوروبا الوسطى؛ اسمها الرسمي جمهورية النمسا، وعاصمتها فيينا)\nمثال: النمسا بلد الكناغر. / أُورُوبَّا, أُورُوبَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته…)\nمثال: ذهبت إلى أوروبا مرة.",
 "おうあたいりく": "أُورَاسِيَا",
 "おうい": "عَرْش, كُرْسِيّ (هو كُرْسِيّ المَلِك تحديدا؛ العَرْش: هو عَرش الرَحْمَان فوق سِدْرَة المنتهى)\nمثال: ولي العهد هو من يرث العرش.",
 "おういつ": "غَارِق, مَغْمُور (مُغَطًّى بِالمَاء)",
 "おういん": "مسجوع, مقفى (له أصوات متطابقة خاصة الأصوات النهائية)\nمثال: شعر مقفى",
 "おううつ": "مُتَكَاثِف النَّبَات (مغطى بنباتات نامية بكثافة)",
 "おうえん": "مُسَاعَدَة / مُرِيح, مُطَمْئِن (يبعث على الراحة ويحرّر من القلق)\nمثال: انتهى كل شيء ما عدا الصياح / أصفر الكروم (أي من الأصباغ الصفراء المتعددة التي تتكون من كرومات الرصاص العادية ومركبات…)",
 "おうえんこう": "ولفينيت (معدن أصفر إلى برتقالي أو بني يستخدم كخام للموليبدينوم)",
 "おうえんしゃ": "داعم رياضي (داعم للأعضاء التناسلية يرتديه الرجال الذين يمارسون تمارين شاقة)\nمثال: مساعدي الذي لا يقدر بثمن",
 "おうおう": "أَحْيَانًا, سَاعَات / ساخط, غير راضٍ (يظهر أو يمر بعدم الرضا أو الشوق القلق)\nمثال: رأى العديد من الوجوه الساخطة في الغرفة / ضَخْم, غَزِير (كبير في العدد أو الكمّ، خاصّة في الكلام أو الكتابة) / شَيْخ, عَجُوز",
 "おうおうにして": "أَحْيَانًا, سَاعَات",
 "おうおん": "شَيْخ, عَجُوز",
 "おうか": "كَئِيب, كَنُود (يسبب مشاعر حزينة من الكآبة وعدم الكفاءة)\nمثال: التوقعات الاقتصادية محبطة / أوربة (الاستيعاب في الثقافة الأوروبية) / ظَافِر, مُبْتَهِج (فَرِحٌ وَفَخُورٌ خَاصَّةً بِسَبَبِ نَصْرٍ أَوْ نَجَاح) / زَهْرَة كَرَز / تأقلم, تكيف ((فسيولوجيا) التعديل المستجيب لعضو حسي (كالعين) لظروف متغيرة (كالضوء))\nمثال: المسرحية هي اقتباس لرواية قصيرة / اصفرار, شحوب ((علم النبات) فعل جعل النبات ينمو بدون كلوروفيل عن طريق زراعته دون التعرض لأشعة…)\nمثال: اصفرار الكرفس",
 "おうかがい": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته",
 "おうかく": "داخل, منعكس ((للزوايا) تشير إلى الداخل)\nمثال: مضلع بزوايا منعكسة",
 "おうかくしんけい": "عصب حجابي (أحد زوجين من الأعصاب ينشأ من الجذور الشوكية العنقية ويمر أسفل القفص الصدري…)",
 "おうかくまく": "حِجَاب حَاجِز (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "おうかくまくヘルニア": "فتق الحجاب الحاجز, فتق حجابي (فتق ناتج عن بروز جزء من المعدة عبر الحجاب الحاجز)",
 "おうかっしょく": "بني مصفر, كراميل (لون أسمر متوسط إلى داكن)",
 "おうかびょう": "صفار, يرقان (اصفرار الجلد وبياض العينين الناتج عن تراكم صبغة الصفراء (البيليروبين) في الدم…)",
 "おうかん": "مُرُور / تَاج, إِكْلِيل / غِطَاء زُجَاجَة, غِطَاء قَارُورَة",
 "おうがた": "تقعر (الخاصية التي يمتلكها الشكل المقعر)",
 "おうき": "غَثْيَان (جاشت النفس واضطربت واستعدت للقَيء؛ الاِشْمِئْزَاز والقَرَف)\nمثال: كنت أشعر بالغثيان.",
 "おうきゅうしょち": "إجراء طوارئ (إجراء يتم اعتماده لمواجهة حالة طوارئ (خاصة الطوارئ الطبية))",
 "おうぎ": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "おうぎがい": "محار عملاق (محار كبير يسكن الشعاب المرجانية في جنوب المحيط الهادئ ويزن ما يصل إلى 500 رطل)",
 "おうぎばしょう": "رافينالا, شجرة المسافر (نبات عملاق يشبه الشجرة له جوز صالح للأكل وأعناق أوراق تنتج مشروباً منعشاً من…)",
 "おうぎばら": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل…)\nمثال: محكم عليه بالإعدام.",
 "おうぎひでん": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "おうぎやし": "دوم, نخلة تدمر (نخيل مروحي طويل من أفريقيا والهند وماليزيا ينتج خشباً صلباً وعصارة حلوة تعد…)",
 "おうぎょう": "مُدْهِش, مُذْهِل (مُثير للإعجاب بشكل مُفاجئ لدرجة الذهول أو الإرباك)",
 "おうぎょく": "تُوبَاز",
 "おうぎょくせき": "تُوبَاز",
 "おうぎわし": "عقاب هاربي (عقاب كبيرة سوداء وبيضاء متوجة من أمريكا الاستوائية)",
 "おうぐ": "بوذا (الشخص الذي حقق حالة من الاستنارة الكاملة)",
 "おうけ": "عَائِلَة مَلِكِيَّة (اسم فاعل من الفعل عَالَ؛ مؤنث عَائِل؛ إحدى طبقات الأنساب وهي آخرها دون الفصيلة…)\nمثال: هو طفل العائلة.",
 "おうけい": "تقعر (الخاصية التي يمتلكها الشكل المقعر) / خط طول سماوي, مطلع مستقيم ((علم الفلك) الإحداثي الاستوائي الذي يحدد الزاوية، مقاسة شرقاً على طول خط…)\nمثال: ساعة واحدة من المطلع المستقيم تساوي خمس عشرة درجة",
 "おうけつ": "كَهْف, غَار / حفرة طريق, حفرة وعائية (حفرة أو ثقب ناتج عن التآكل أو العوامل الجوية (خاصة في سطح الطريق))",
 "おうけつえん": "فيروسيانيد البوتاسيوم (مركب سيانيد يتم تحضيره بتفاعل سيانيد البوتاسيوم مع أملاح الحديدوز؛ يستخدم عادة…)",
 "おうこう": "مُدْهِش, مُذْهِل (مُثير للإعجاب بشكل مُفاجئ لدرجة الذهول أو الإرباك) / مَلِكَة, ملكة (مؤنث مَلِك)\nمثال: ليحفظ الله الملكة. / مدخل أفقي للمجم, نفق أفقي (ممر أفقي تقريباً من السطح إلى داخل المنجم) / نَبِيل, شريف (اَلذَّكِيُّ؛ اَلنَّجِيبُ)\nمثال: إنها امرأة نبيلة.",
 "おうこうかっぽ": "مُتَبَخْتِر, مُتَهَوِّر بِمَرَح (مغامر بطريقة استعراضية وبَاهرة)",
 "おうこうけっちょう": "قولون مستعرض (جزء الأمعاء الغليظة الذي يمتد عبر تجويف البطن ويربط القولون الصاعد بالنازل)",
 "おうこうしょうしょういずくんぞしゅあらんや": "مكانة عالية (منصب ذو مكانة متفوقة)",
 "おうこく": "مَمْلَكَة, مُلْك (دَوْلَةً يَحْكُمُهَا مَلِكٌ)\nمثال: نعيش في المملكة المتحدة.",
 "おうこらいこん": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "おうごろし": "قتل الملك (فعل قتل الملك)",
 "おうごん": "ذَهَب, إِبْرِيز (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ…)\nمثال: ذهب إلى الدكان. / ذَهَبِيّ / نُقُود, مَال\nمثال: أريد بعض المال.",
 "おうごんき": "عَصْر ذَهَبِيّ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "おうごんきょう": "إلدورادو (مكان خيالي للثروة العظيمة والفرص؛ بحث عنه المستكشفون في القرن السادس عشر في…)",
 "おうごんこく": "إلدورادو (مكان خيالي للثروة العظيمة والفرص؛ بحث عنه المستكشفون في القرن السادس عشر في…)",
 "おうごんじだい": "عَصْر ذَهَبِيّ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "おうごんじゅつ": "اَلْخِيمِيَاء, خِيمِيَاء",
 "おうごんせかい": "طُوبَائِيَّة, مَدِينَةٌ فَاضِلَة",
 "おうごんひ": "الرَقْم الذَهَبِيّ",
 "おうごんぶんかつ": "النِّسْبَة الذَّهَبِيَّة (العلاقة التناسبية بين قسمين من خط أو بُعدين لشكل مستوٍ بحيث تكون النسبة بين…)",
 "おうごんりつ": "القاعدة الذهبية (أمر يستند إلى كلمات يسوع في الموعظة على الجبل)\nمثال: فكل ما تريدون أن يفعل الناس بكم افعلوا هكذا أنتم أيضاً بهم / الرَقْم الذَهَبِيّ",
 "おうさ": "لوس (تراكم غير طبقي ناعم الحبيبات من الطين والغرين المترسب بفعل الرياح) / صَحْرَاء (الصَّحْرَاءُ : الفَضاءُ الواسِعُ لا نباتَ به، نادرة الماء مرتفعة درجات الحرارة…)\nمثال: عاد إلى الصحراء. / زِيَارَة مَوْقِع, مُعَايَنَة مَيْدَانِيَّة (زيارة بصفة رسمية لفحص موقع لتحديد مدى ملاءمته لمشروع ما)",
 "おうさつ": "مَذْبَحَة, مَجْزَرَة (الحَادِثَة أو المَعْرَكَة التي يقتل فيها ناس كثيرون)\nمثال: قتل الصياد دبا.",
 "おうさま": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه.",
 "おうさまゲーム": "لعبة جماعية (لعبة لتسلية الضيوف في حفلة)",
 "おうさまペンギン": "بطريق ملك (بطريق كبير في الجزر المحاذية للدائرة القطبية الجنوبية)",
 "おうざ": "عَرْش, كُرْسِيّ (هو كُرْسِيّ المَلِك تحديدا؛ العَرْش: هو عَرش الرَحْمَان فوق سِدْرَة المنتهى)\nمثال: ولي العهد هو من يرث العرش. / دعم, مؤازرة (فعل تقديم الموافقة والدعم)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "おうし": "خرس, صمت (رفض التحدث عند التوقع)\nمثال: كان صمته عن مساهمتي مفاجئاً / أَخْرَس, أَبْكَم ((أَخْرَسَت) الأَرْض: لم تصلح للزِّرَاعَة؛ (أَخْرَسَ) الله فلَانا: أَصَابَهُ…) / ثَوْر (حُمْرَة الشفق الثائرة فيه؛ الطُحْلُب وما أشبهه فوق الماء. سميّ كذلك لأنه يثور…)\nمثال: حرث ما حرث الثور. / ورق نشاف (ورق ماص يستخدم لتجفيف الحبر)",
 "おうしかん": "الأنبوب السمعي, النفير (أي من الأنبوبين المزدوجين اللذين يربطان الأذن الوسطى بالبلعوم الأنفي؛ يعمل على…)",
 "おうしざ": "بُرْج اَلثَّوْر, اَلثَّوْر (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "おうしつ": "عَائِلَة مَلِكِيَّة (اسم فاعل من الفعل عَالَ؛ مؤنث عَائِل؛ إحدى طبقات الأنساب وهي آخرها دون الفصيلة…)\nمثال: هو طفل العائلة.",
 "おうしつカナダきばけいさつ": "شرطة الخيالة الكندية الملكية (قوة الشرطة الفيدرالية لكندا)",
 "おうしゃ": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه. / نَصِير, نَصِيرَة / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)\nمثال: و بعد قليل أتى.",
 "おうしゃく": "صَوْلَجَان",
 "おうしゃくこう": "بايريت القصدير, ستانيت (معدن رمادي غامق بلمعان معدني يعد مصدراً للقصدير)",
 "おうしゅ": "استجابة, رد فعل (عملية جسدية تحدث نتيجة تأثير منبه أو عامل سابق)\nمثال: رد فعل سيء للدواء",
 "おうしゅう": "تَبْدِيل, تَبَادُل / أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا. / حجز, مصادرة (الاستيلاء على شيء عن طريق الإجراءات القانونية)\nمثال: عانى من نوبة صرع / أُورُوبَّا, أُورُوبَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته…)\nمثال: ذهبت إلى أوروبا مرة. / عَرْض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "おうしゅうあかまつ": "صنوبر اسكتلندي, صنوبر بري (صنوبر متوسط الكبر ثنائي الإبر من شمال أوروبا وآسيا له لحاء أحمر بني متقشر)",
 "おうしゅうあんていメカニズム": "تدابير دعم الحرب الإلكترونية (حرب إلكترونية تتم تحت السيطرة المباشرة لقائد عملياتي لتحديد مصادر الطاقة…)",
 "おうしゅうかいぎ": "مَجْلِس أُورُوبَا",
 "おうしゅうきょうどうたい": "الاتحاد الأوروبي, السوق الأوروبية المشتركة (منظمة دولية للدول الأوروبية تشكلت بعد الحرب العالمية الثانية لتقليل الحواجز…)\nمثال: حاول إدخال بريطانيا في الاتحاد الأوروبي",
 "おうしゅうけいざいきょうどうたい": "الاتحاد الأوروبي, السوق الأوروبية المشتركة (منظمة دولية للدول الأوروبية تشكلت بعد الحرب العالمية الثانية لتقليل الحواجز…)\nمثال: حاول إدخال بريطانيا في الاتحاد الأوروبي",
 "おうしゅうさいばんしょ": "دار العدالة, محكمة قانونية (محكمة يترأسها قاضي صلح أو قاض واحد أو أكثر يديرون العدالة وفقاً للقوانين)",
 "おうしゅうしょこく": "دولة أوروبية (أي دولة من الدول التي تشغل القارة الأوروبية)",
 "おうしゅうしらかんば": "بتولا بيضاء أوروبية, بتولا فضية (بتولا أوروبية بلحاء أبيض فضي مقشر وفروع متدلية بشكل ملحوظ)",
 "おうしゅうたいせん": "الْعَالَم الْأَوَّل",
 "おうしゅうちゅうおうぎんこう": "اَلْبَنْك اَلْمَرْكَزِيّ اَلْأُورُوبِّيّ",
 "おうしゅうつうかききん": "فولتية, قوة دافعة كهربائية (المعدل الذي يتم به سحب الطاقة من مصدر ينتج تدفقاً للكهرباء في دائرة؛ يعبر عنه…)",
 "おうしゅうつうかせいど": "إِم",
 "おうしゅうとうひ": "تنوب نرويجي (تنوب هرمي طويل موطنه شمال أوروبا له أوراق خضراء داكنة على فروع منتشرة بغصينات…)",
 "おうしゅうなら": "بلوط شائع, سنديان إنجليزي (سنديان أوروبي نفضي متوسط إلى كبير الحجم، له أوراق ناعمة ذات فصوص مستديرة؛ ينتج…)",
 "おうしゅうひょうぎかい": "مَجْلِس أُورُوبَا",
 "おうしゅうれんごう": "الِٱتِّحَاد الْأُورُوبِيّ",
 "おうしょ": "تقعر (الخاصية التي يمتلكها الشكل المقعر)",
 "おうしょう": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه.",
 "おうしょうしゃ": "مجند إلزامي, مكلف (شخص يتم تجنيده في الخدمة العسكرية (غالباً بشكل إلزامي))",
 "おうしょうへい": "مُجَنَّد",
 "おうしょく": "أَصْفَر (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان…)\nمثال: قلبي أخضر و أصفر.",
 "おうしょくくみあい": "نقابة تابعة للشركة (نقابة للعمال لشركة واحدة؛ نقابة غير تابعة لنقابة أكبر)",
 "おうしょくしゅ": "ورم أصفر (مشكلة جلدية تتميز بتطور عقيدات صفراء غير منتظمة)",
 "おうしょくじんしゅ": "العرق الأصفر, العرق المغولي (عرق آسيوي)",
 "おうしん": "شوط أول (الأول من شوطين للعب)",
 "おうし座": "بُرْج اَلثَّوْر, اَلثَّوْر (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "おうじ": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)\nمثال: و بعد قليل أتى. / أَمِير",
 "おうじさま": "أَمِير",
 "おうじしゅうごう": "حرف, حرف أبجدي (الأحرف التقليدية للأبجدية المستخدمة لتمثيل الكلام)\nمثال: علمته جدته الحروف",
 "おうじて": "طِبْقًا لِـ, وَفْقًا لِـ",
 "おうじゃ": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه. / نَصِير, نَصِيرَة / بُوَاء",
 "おうじゃく": "ناي, ناي مستعرض (آلة نفخ خشبية عالية النبرة؛ أنبوب رفيع مغلق من أحد طرفيه بفتحات للأصابع في أحد…)",
 "おうじゅ": "شجرة الكرز, كرز (أي من العديد من الأشجار والشجيرات التي تنتج فاكهة مستديرة لحمية صغيرة بنواة…)",
 "おうじょ": "أَمِيرَة",
 "おうじょう": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / ترك, هجران (فعل الهجر أو التخلي) / قَهْر, قَسْر (غَلَبَ وانْتَصَرَ ولم يقدر عليه أحد) / تقعر (الخاصية التي يمتلكها الشكل المقعر)",
 "おうじる": "أَجَابَ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا.",
 "おうじん": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "おうすい": "مَاء مَلَكِيّ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما…)\nمثال: أنا أشرب الماء. / صَفْرَاء (مؤنث أَصْفَر؛ صفة ما كان لونها الصفار؛ الغُدّة الصفراء: غدة في الكبد، تسمى أيضا…)\nمثال: هذه وردة صفراء.",
 "おうずる": "رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى))\nمثال: اليوم هناك برد. / رَضَّى",
 "おうせ": "لِقَاء مُحَدَّد, مَوْعِد (اجتماع مخطط له في وقت ومكان معينين)\nمثال: كان ينتظرهم في مكان اللقاء",
 "おうせい": "دَجِر / مَلِكِيَّة / أمير قرين (أمير هو زوج ملكة حاكمة)",
 "おうせいふっこ": "إعادة, استرداد (استعادة الشيء مرة أخرى)\nمثال: عند إعادة الكتاب إلى صاحبه الشرعي تم توبيخ الطفل",
 "おうせつ": "اِسْتِقْبَال",
 "おうせつかかり": "مُوَظَّف الْاِسْتِقْبَال, مُوَظَّفَةُ الْاِسْتِقْبَال",
 "おうせつがかり": "مُوَظَّف الْاِسْتِقْبَال, مُوَظَّفَةُ الْاِسْتِقْبَال",
 "おうせつしつ": "غرفة الاستقبال الرسمية, غرفة الصالون (غرفة رسمية يمكن فيها استقبال الزوار والترفيه عنهم)",
 "おうせつま": "غرفة الاستقبال (غرفة لاستقبال وترفيه الزوار (كما في منزل خاص أو فندق))",
 "おうせん": "هُجُوم مُضَادّ / سففة, قرعة (عدوى فطرية معدية في فروة الرأس؛ تحدث بشكل رئيسي في أفريقيا والشرق الأوسط)",
 "おうぜん": "سَعِيد, مُبَارَك (ينبئ أو من المرجح أن يجلب الحظ الجيد أو نتيجة حسنة)",
 "おうそ": "دعوى مضادة (دعوى مرفوعة ضد شخص قام بمقاضاتك)",
 "おうそう": "مُرَافَقَة",
 "おうぞく": "مَلَكِيَّة",
 "おうた": "قَصِيدَة, شِعْر",
 "おうたい": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / جسم أصفر (نسيج صم أصفر يتكون في جريب جراف الممزق بعد إطلاق البويضة؛ يضمر بعد بضعة أيام ما…)",
 "おうたいき": "المرحلة الأصفرية, المرحلة الإفرازية (النصف الثاني من الدورة الشهرية بعد الإباضة؛ يفرز الجسم الأصفر البروجسترون الذي…)",
 "おうたいけいせいホルモン": "الهرمون الملوتن (هرمون موجه للغدد التناسلية تفرزه الغدة النخامية الأمامية؛ يحفز التبويض في إناث…)",
 "おうたいし": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "おうたいしひ": "ولية العهد (وريثة أنثى ظاهرة للعرش)",
 "おうたいひ": "ولية العهد (وريثة أنثى ظاهرة للعرش)",
 "おうたいホルモン": "بروجستوجين, بروجستين (أي من مجموعة الهرمونات الستيرويدية التي لها تأثير البروجسترون)",
 "おうたかくけい": "مضلع مقعر (مضلع يوجد فيه خط مستقيم يقطعه في أربع نقاط أو أكثر)",
 "おうだ": "أَصَابَ\nمثال: تلقى مناد ضربة.",
 "おうだく": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع)\nمثال: السكوت علامة الرضا.",
 "おうだつ": "اختلاس, سوء استخدام (استعارة غير مشروعة)\nمثال: كان تفسيره سوء استخدام للنظرية الاجتماعية",
 "おうだん": "مَعْبَر (مكان العُبُور؛ مَعْبَر رَفَح: نقطة العبور الحدودية بين أراضي قطاع غَزَّة ومِصْر…) / صُفَار, يَرَقَان",
 "おうだんしゃ": "عابر (شخص يتحرك أو يمر عبر)\nمثال: العابرون صعدوا الجبل ببطء",
 "おうだんせん": "عَرْضِيّ, مُسْتَعْرِض (يَمْتَدّ أَوْ يَقَع بِالعَرْض؛ في اتِّجاه عَمودِيّ عَلى المِحْوَر)",
 "おうだんちかどう": "نَفَق مُشَاة",
 "おうだんてき": "مَقْطَعِيّ (يُمَثِّل مُسْتَوًى ناتِجًا عَن القَطْع عَرْضِيًّا بِزاوِيَة قائِمَة)\nمثال: شريحة مقطعية",
 "おうだんてきデータ": "مَقْطَعِيّ (يُمَثِّل مُسْتَوًى ناتِجًا عَن القَطْع عَرْضِيًّا بِزاوِيَة قائِمَة)\nمثال: شريحة مقطعية",
 "おうだんほこうしゃ": "عُبُورُ الْمُشَاة, مَمَرُّ الرَّاجِلِينَ",
 "おうだんほどう": "عُبُورُ الْمُشَاة, مَمَرُّ الرَّاجِلِينَ",
 "おうだんほどうきょう": "جسر مشاة (جسر مصمم لعبور المشاة)",
 "おうだんめん": "المقطع العرضي ((فيزياء) احتمال حدوث تفاعل معين (مثل الأسر أو التأين) بين الجسيمات؛ يقاس بالبارن)",
 "おうち": "أَجْوَف / جَوْفِيّ, دَاخِلِيّ (من وسط المنطقة أو البلاد أو قادم منه)\nمثال: مشهد داخلي / وَطَن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن. / أزدرخت, زنزلخت (شجرة من شمال الهند والصين لها أزهار أرجوانية وثمار صفراء صغيرة غير صالحة للأكل…)",
 "おうちゃく": "كَسَل / سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق)",
 "おうちゃくもの": "متخاذل, متهرب (شخص يتهرب من عمله أو واجبه (خاصة من يحاول التهرب من الخدمة العسكرية في وقت…)",
 "おうちょう": "سُلَالَة",
 "おうて": "تَفَقُّد",
 "おうてい": "أعماق, أغوار ((الجمع) الجزء الأعمق والأكثر بعداً)\nمثال: من أعماق أفريقيا المظلمة / قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر)\nمثال: نمت في قاعة السينما. / حارِس سِجْن, سَجَّان (شخص يحرس السجناء)",
 "おうてき": "ناي, ناي مستعرض (آلة نفخ خشبية عالية النبرة؛ أنبوب رفيع مغلق من أحد طرفيه بفتحات للأصابع في أحد…)",
 "おうてっこう": "بايرايت الحديد, بايريت (معدن شائع (ثنائي كبريتيد الحديد) لونه أصفر شاحب)",
 "おうてをかける": "تَفَقُّد / هَدَّدَ",
 "おうてん": "لفة برميلية (لفة تتبع فيها الطائرة مساراً لولبياً)",
 "おうと": "قَيْءُ, اِسْتِفْرَاغ / غَثْيَان (جاشت النفس واضطربت واستعدت للقَيء؛ الاِشْمِئْزَاز والقَرَف)\nمثال: كنت أشعر بالغثيان.",
 "おうとう": "أَجَابَ, رَدَّ (رَدَّ على سُؤالٍ أو طلبٍ؛ أَمْتَثَلَ لِمُطَالَبَةٍ أو دعوةٍ)\nمثال: أجاب ياني فورا. / عائلة مالكة, ملوك (الأشخاص الملكيون بشكل جماعي)\nمثال: حضر الزفاف أفراد من العائلة المالكة / فارس ملكي (مؤيد ملكي لتشارلز الأول خلال الحرب الأهلية الإنجليزية) / كَرَز, كَرَزَة / مُقَابِلٌ, مُنَاظِرٌ (مُصَاحِب ومُلازم)",
 "おうとうがわ": "مجيب (شخص يستجيب)",
 "おうとうじかん": "كمون, وقت الاستجابة (الوقت الذي ينقضي بين المثير والاستجابة له)",
 "おうとうじかんウインドウ": "كمون, وقت الاستجابة (الوقت الذي ينقضي بين المثير والاستجابة له)",
 "おうとうのう": "أهلية, جدارة (صفة التمتع بالمؤهلات البدنية والفكرية الكافية)",
 "おうとうは": "فارس ملكي (مؤيد ملكي لتشارلز الأول خلال الحرب الأهلية الإنجليزية)",
 "おうとうメッセージ": "تَحِيَّة (مصدر للفعل \"حَيَّا\"؛ عبارة لفظية أو جسدية تُبدأ بها الرسالة أو المحادثة غرضها…)\nمثال: ألقى زيري تحية.",
 "おうとっき": "نتوء مستعرض (أحد نتوءين يمتدان من كل فقرة ويوفران نقطة تمفصل للأضلاع)",
 "おうとつ": "تَفَاوُت, عَدَم اسْتِوَاء (صفة عدم التوازن) / اخْتِلَال التَّوَازُن, عَدَم تَنَاسُب (افتقار للتناسب؛ عدم توازن بين أجزاء الشيء)\nمثال: اختلال هرموني",
 "おうとぶつ": "تَقَيَّأَ, قَاءَ",
 "おうとも": "طَبْعًا",
 "おうど": "لوس (تراكم غير طبقي ناعم الحبيبات من الطين والغرين المترسب بفعل الرياح) / مغرة صفراء (صبغة تتكون من الليمونيت الممزوج بالطين والسيليكا)",
 "おうどいろ": "مَغْرِيّ اللَّوْن (بلون برتقالي مصفر معتدل كلون المغرة)",
 "おうどう": "ملكية, مُلك (كرامة أو رتبة أو منصب الملك) / طريق ملكي, طريق ممهد (طريقة أو وسيلة مميزة وسهلة لتحقيق شيء ما)\nمثال: الطريق الممهد للنجاح / مَسَارُ الشَّمْسِ (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول…)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة. / شَبَه\nمثال: بدأ سامي من نقطة الصفر. / شر, فجور (سلوك مرفوض أخلاقياً)\nمثال: فاجأتنا بشاعة لغته",
 "おうどうこう": "بايريت النحاس, كالكوبيريت",
 "おうどうしんこう": "طريق ملكي, طريق ممهد (طريقة أو وسيلة مميزة وسهلة لتحقيق شيء ما)\nمثال: الطريق الممهد للنجاح",
 "おうどうてき": "تَقْلِيدِيّ, كُلَاسِيكِيّ (يتعلق بالفترة المهمة الأولى لحضارة أو ثقافة أو مجال دراسة، إلخ)\nمثال: فخار صيني كلاسيكي",
 "おうな": "عَجُوز",
 "おうなつ": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ)\nمثال: ختم سامي القرآن في شهر رمضان.",
 "おうにょ": "أَمِيرَة",
 "おうねつ": "حَمَّى صَفْرَاء (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "おうねつびょう": "حَمَّى صَفْرَاء (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "おうねん": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)\nمثال: و بعد قليل أتى.",
 "おうのう": "عذاب, غم (ضيق عقلي شديد)",
 "おうのうはんもん": "عذاب, غم (ضيق عقلي شديد)",
 "おうはい": "أمير قرين (أمير هو زوج ملكة حاكمة)",
 "おうはくしょく": "أَبْيَض مُصْفَرّ (أبيض مع مسحة صفراء)",
 "おうはん": "لطخة جلدية (رقعة من الجلد متغيرة اللون ولكنها غير مرتفعة عادة؛ تسببها أمراض مختلفة) / شراع مربع (شراع رباعي الأضلاع يوضع تحت عارضة أفقية معلقة من المنتصف في الصارية)",
 "おうはんいんさつ": "طباعة غائرة, غرافور (عملية طباعة تستخدم لوحاً محفوراً أو منقوشاً؛ يُلطخ اللوح بالحبر ويُمسح لينظف…)",
 "おうばい": "ياسمين شتوي (شجيرة متسلقة متساقطة الأوراق تُزرع على نطاق واسع لزهورها الصفراء التي تتفتح في…)",
 "おうひ": "مَلِكَة, ملكة (مؤنث مَلِك)\nمثال: ليحفظ الله الملكة. / شجرة الكرز, كرز (أي من العديد من الأشجار والشجيرات التي تنتج فاكهة مستديرة لحمية صغيرة بنواة…)",
 "おうふう": "غَرْبِيّ / مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية.",
 "おうふく": "تذكرة ذهاب وعودة (تذكرة لمكان ما والعودة منه (عادة عبر نفس الطريق)) / مُرَاسَلَة / تَوَاصُل اِجْتِمَاعِيّ, مُخَالَطَة اِجْتِمَاعِيَّة (فعل الاجتماع لأغراض اجتماعية)\nمثال: كان هناك الكثير من المخالطة الاجتماعية مع الجنود المجندين",
 "おうふくきかん": "محرك ترددي (محرك احتراق داخلي يتم فيه تدوير العمود المرفقي بواسطة مكابس تتحرك صعوداً…)",
 "おうふくきっぷ": "تذكرة ذهاب وعودة (تذكرة لمكان ما والعودة منه (عادة عبر نفس الطريق))\nمثال: 往復切符を買いましたか。 — ھل إشتريت تذكرة ذهاب وإياب؟",
 "おうふくこうくうけん": "ذهاب وعودة",
 "おうふくしょかん": "مُرَاسَلَة",
 "おうふくじょうしゃけん": "تذكرة ذهاب وعودة (تذكرة لمكان ما والعودة منه (عادة عبر نفس الطريق))",
 "おうぶん": "مُنَاسِب / خط روماني (نمط خط استخدم في النقوش الرومانية القديمة)",
 "おうへい": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية.",
 "おうへん": "ذهاب وعودة / مَصْلَحَة ظَرْفِيَّة, مُلَائَمَة (صفة كون الشيء مناسباً للغابة المنشودة) / أَصْفَر (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَصْفَر والأَزْرَق)، وهو لون الزُعْفُرَان…)\nمثال: قلبي أخضر و أصفر.",
 "おうべい": "غَرْب (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة…)\nمثال: تغرب الشمس في الغرب.",
 "おうべいか": "تَغْرِيب",
 "おうべいじん": "غَرْبِيّ",
 "おうほう": "عِقَاب, اِنْتِقَام (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة…)\nمثال: هو من تلقى العقاب الأكبر.",
 "おうぼ": "تَطْبِيق\nمثال: هذا الكتاب جديد",
 "おうぼう": "عُنْف, عَنْف",
 "おうぼしゃ": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى…)\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "おうぼようし": "استمارة طلب, نموذج تقديم (نموذج يستخدم عند تقديم طلب)",
 "おうま": "جوت / حصان (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان…)\nمثال: لم يشفى الحصان.",
 "おうまがとき": "شَفَق ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه:…)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "おうまさん": "حِصَان, فَرَس (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان…)\nمثال: لم يشفى الحصان.",
 "おうまふ": "خيش (قماش الجوت الخشن)",
 "おうみょう": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "おうむ": "بَبَّغَاء (طائر من فصيلة كبيرة من الطيور ذوات ألوان زاهية قادرة على تقليد صوت كلام الإنسان…)",
 "おうむがい": "نوتي (رأسيات الأرجل في المحيطين الهندي والهادئ لها صدفة حلزونية ذات حواجز لؤلؤية شاحبة)",
 "おうむびょう": "حمى الببغاء, داء الببغائية (التهاب رئوي لانمطي يسببه كائن دقيق من الريكيتسيا وينتقل إلى البشر من الطيور…)",
 "おうめん": "تقعر (الخاصية التي يمتلكها الشكل المقعر) / مُقَعَّر, مُجَوَّف",
 "おうもの": "مَلِك, شاه (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض…)\nمثال: زيري ملك لنفسه.",
 "おうもんきん": "عضلة مخططة, عضلة هيكلية (عضلة متصلة في أحد طرفيها أو كليهما بعظم وبالتالي تحرك أجزاء من الهيكل العظمي…)",
 "おうよう": "تَطْبِيق\nمثال: هذا الكتاب جديد / تبيقي (يهتم بالمشاكل أو البيانات الملموسة بدلاً من المبادئ الأساسية)\nمثال: فيزياء تطبيقية / خَيِّر, طَيِّب القَلْب (يُظهر التعاطف والتفهّم والسخاء أو مدفوع بها) / هادئ, ساكن",
 "おうようかがく": "تكنولوجيا, علم الهندسة (التخصص الذي يتعامل مع فن أو علم تطبيق المعرفة العلمية على المشاكل العملية)\nمثال: واجه صعوبة في تحديد أي فرع من الهندسة سيدرس",
 "おうようしんりがく": "علم النفس التطبيقي, علم النفس الصناعي (أي من عدة فروع لعلم النفس التي تسعى لتطبيق المبادئ النفسية على المشاكل العملية…)",
 "おうようすうがく": "رياضيات تطبيقية (فروع الرياضيات المعنية بدراسة العالم المادي أو البيولوجي أو الاجتماعي)",
 "おうようもんだい": "تَمْرِين, تَدْرِيب",
 "おうようりょく": "تكيف, قابلية للتكيف (القدرة على التغيير (أو التغيّر) لتناسب الظروف المتغيرة)",
 "おうようアソシエーション": "جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح…)\nمثال: أنشؤوا جمعية سينمائية.",
 "おうようプログラム": "برنامج تطبيقي, تطبيق (برنامج يعطي تعليمات للحاسوب توفر للمستخدم أدوات لإنجاز مهمة ما)\nمثال: لقد جرب عدة تطبيقات مختلفة لمعالجة النصوص",
 "おうらい": "مُرُور / طَرِيق, سِكَّة (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق. / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح…)\nمثال: أنشؤوا جمعية سينمائية. / رَاجِع, عَائِد (يَعُودُ مِنْ جَدِيد)",
 "おうりつ": "مَلَكِيّ, قَيْصَرِيّ",
 "おうりつえんげいきょうかい": "عامل مطلق, هرمون مطلق (أي من عدة هرمونات تنتج في الهايبوتلاموس وتحمل إلى الغدة النخامية الأمامية حيث…)",
 "おうりつきょうかい": "الجمعية الملكية (جمعية إنجليزية فخرية (تم إضفاء الطابع الرسمي عليها في عام 1660 ومنحها تشارلز…)",
 "おうりつこうがくアカデミー": "الأكاديمية الملكية, الأكاديمية الملكية للفنون (أكاديمية فخرية في لندن (تأسست عام 1768) تهدف إلى زراعة الرسم والنحت والهندسة…)",
 "おうりつどうぶつぎゃくたいぼうしきょうかい": "الجمعية الملكية (جمعية إنجليزية فخرية (تم إضفاء الطابع الرسمي عليها في عام 1660 ومنحها تشارلز…)",
 "おうりゅう": "غَارِق, مَغْمُور (مُغَطًّى بِالمَاء)",
 "おうりょう": "اِخْتِلَاس (الخَلَسُ: الأخذ نُهْزَةومخاتلة، والاختلاس كالخَلَسِ؛ أخذه خُِلْسَةً أي اختلاسا)\nمثال: لقد اتهم باختلاس الأموال العامة.",
 "おうりょうざい": "اِخْتِلَاس (الخَلَسُ: الأخذ نُهْزَةومخاتلة، والاختلاس كالخَلَسِ؛ أخذه خُِلْسَةً أي اختلاسا)\nمثال: لقد اتهم باختلاس الأموال العامة.",
 "おうりょうしゃ": "مختلس (شخص ينتهك الأمانة بأخذ (المال) لاستخدامه الخاص)",
 "おうりょうはん": "مختلس (شخص ينتهك الأمانة بأخذ (المال) لاستخدامه الخاص)",
 "おうりょく": "إِجْهَاد / أخضر ليموني, أخضر مصفر (درجة من الأخضر مشوبة بالأصفر)",
 "おうりょくしょく": "أَخْضَر مُصْفَرّ (بلون متوسط بين الأصفر والأخضر)",
 "おうれつ": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "おうれん": "خيط الذهب, كوبتيس (نبات معمر منخفض النمو في غابات أمريكا الشمالية له أوراق ثلاثية وساق جذري أصفر…)",
 "おうわく": "حيلة, خديعة (استخدام الحيل لخداع شخص ما (عادة لانتزاع المال منه))",
 "おうレンズ": "عدسة مفرقة, عدسة مقعرة (عدسة تعمل على تفريق أو نشر شعاع الضوء المتوازي المار عبرها)",
 "おえかき": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / خربشة, شخبطة (رسم بلا هدف)",
 "おえつ": "شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "おえらいさん": "رأس كبير, شخصية كبيرة (شخص مؤثر وهام)\nمثال: هو يعتقد أنه شخصية كبيرة",
 "おえらがた": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ)",
 "おえる": "فَرَغَ, أَنْهَى\nمثال: انتهى أمر زيري. / خِرِّيج, خِرِّيجَة\nمثال: حرارتي 38 درجة. / نِهَايَة, غَايَة\nمثال: انتهى أمر زيري.",
 "おお": "كَبِير, وَاسِع (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير. / قَدِيم, مُخَضْرَم (ماهر من خلال خبرة طويلة) / أَخِير, نِهَائِيّ (لا يمكن تغييره أو التراجع عنه) / خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "おおあさ": "قِنَّب / قِنَّب هِنْدِيّ",
 "おおあじ": "دَمِث, لَبِق (مُجَامِل بِسَلَاسَة وَأَدَب مَعَ قَدْرٍ مِنَ الرُّقِيّ) / كَلِيل",
 "おおあせ": "الكثير, قدراً كبيراً (إلى درجة أو مدى كبير جداً)\nمثال: أشعر بتحسن كبير",
 "おおあたり": "بلوك باستر, عمل ضخم النجاح (نجاح غير عادي مع شعبية واسعة ومبيعات ضخمة (خاصة لفيلم أو مسرحية أو تسجيل أو…) / الجَائِزَةُ الكُبْرَى",
 "おおあな": "مُمِيت, قَاتِل\nمثال: قتل الصياد دبا.",
 "おおあばれ": "عربدة, هيجان (سلوك عنيف غاضب ومدمر)",
 "おおあま": "لَيِّن, مُتَسَاهِل (يتّسم بالتسامح والرحمة في التعامل)",
 "おおあめ": "وَابِل, مَطَر غَزِير",
 "おおあり": "سَخِيّ, غَزِير (يُوفِّر إمدادًا وافرًا وغزيرًا)",
 "おおありくい": "آكل النمل العملاق (آكل نمل كبير أشعث الشعر وعديم الأسنان ذو لسان طويل ومخالب قوية؛ من أمريكا…)",
 "おおあれ": "مُسْتَاء, مُمْتَعِض / إثارة, تحريك (فعل تحريك شيء ما؛ التسبب في تحركه (عادة بقوة))\nمثال: أنتج الغليان السياسي قيادة جديدة",
 "おおあわがえり": "تِيمُوثَاوُس",
 "おおい": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / مُتَكَرِّر / غِطَاء / نفل أبيض, نفل زاحف (نفل أوروبي زاحف ذو أزهار بيضاء إلى وردية وأوراق خضراء زاهية؛ متوطن في الولايات…) / كَبِير, كبير (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير. / أَكْبَر, كُبْرَى (الأَكْبَر: هو ما فاق غيره في الكُبْر، ويكون ذلك إما بالحجم أو المقام أو كلاهما…)\nمثال: إنه أخي الأكبر.",
 "おおいかくす": "قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "おおいかぶさる": "غِطَاء",
 "おおいくさ": "اَلْحَرْب الْعُظْمَى",
 "おおいし": "جُلْمُود, صَخْرَة كَبِيرَة (كتلة صخرية كبيرة ملساء منفصلة عن مكان نشأتها) / تِنِّين",
 "おおいそぎ": "اِنْدَفَعَ, أَسْرَعَ",
 "おおいなる": "كَبِير, كبير (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير.",
 "おおいに": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "おおいぬのふぐり": "بَانُورَامِيّ, مِنْ عَلُوّ (كما يُرى من ارتفاع أو مسافة بعيدة)",
 "おおいぬふぐり": "بَانُورَامِيّ, مِنْ عَلُوّ (كما يُرى من ارتفاع أو مسافة بعيدة)",
 "おおいばり": "تبجح, تفاخر (حالة من الحديث المتباهي)\nمثال: تبجحه أسوأ من قتاله",
 "おおいまつりごとのつかさ": "وزارة الخارجية, وزارة الخارجية الأمريكية (الإدارة الفيدرالية في الولايات المتحدة التي تضع وتحافظ على السياسات الخارجية)\nمثال: تأسست وزارة الخارجية عام 1789",
 "おおいり": "بيت كامل, فل هاوس (يد بوكر تحتوي على ثلاث بطاقات من نوع واحد وزوج من نوع آخر)",
 "おおいりぶくろ": "بيت كامل, فل هاوس (يد بوكر تحتوي على ثلاث بطاقات من نوع واحد وزوج من نوع آخر)",
 "おおいりまんいん": "مَأْجُوْرٌ",
 "おおう": "غِطَاء",
 "おおうつし": "لقطة مقربة (صورة فوتوغرافية (أو غيرها) يظهر فيها الموضوع بمقياس كبير نسبياً، ويشغل معظم أو…)",
 "おおうなばら": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط.",
 "おおうみ": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط.",
 "おおうみがらす": "أوك عظيم (طائر أوك كبير لا يطير من الجزر الصخرية قبالة سواحل شمال الأطلسي؛ منقرض)",
 "おおえ": "غُصْن",
 "おおえだ": "غُصْن",
 "おおえび": "كَرْكَنْد",
 "おおおかさばき": "حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها)",
 "おおおくさま": "ربة منزل (زوجة تدير منزلاً بينما يكسب زوجها دخل الأسرة)",
 "おおおじ": "خال الأب, عم الأب (عم أو خال والدك أو والدتك)",
 "おおおとこ": "عِمْلَاق",
 "おおおば": "خالة كبرى, عمة كبرى (عمة أو خالة والدك أو والدتك)",
 "おおおんな": "عملاقة (أنثى عملاقة)",
 "おおかがりび": "مَشْعَل",
 "おおかぜ": "ريح عاتية, عاصفة (رياح قوية تتحرك بسرعة 45-90 عقدة؛ قوة 7 إلى 10 على مقياس بوفورت)",
 "おおかた": "غَالِبِيَّة, أَغْلَبِيّة / عَامَّة اَلنَّاس / إلى حد كبير, بشكل رئيسي (في جزء كبير؛ بشكل رئيسي أو أساسي)\nمثال: هذه الحسابات غير نشطة إلى حد كبير / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "おおかばまだら": "فراشة الصقلاب, فراشة الملك (فراشة أمريكية مهاجرة كبيرة لها أجنحة برتقالية عميقة بعلامات سوداء وبيضاء؛ تتغذى…)",
 "おおかみ": "ذِئْب (حيوان مفترس من فصيلة الكلاب يعيش في جماعات وأكثر ما يصطاد في الليل؛ صفة تطلق…)\nمثال: نظرة الذئب للشاة. / ذِئْبٌ فِي ثَوْبِ حَمَلٍ (حيوان مفترس من فصيلة الكلاب يعيش في جماعات وأكثر ما يصطاد في الليل؛ صفة تطلق…)\nمثال: نظرة الذئب للشاة. / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "おおかみおとこ": "مُسْتَذْئِب, مُسْتَذْئِبَة",
 "おおかみざ": "ذِئْبَة",
 "おおかみづめ": "زمعة",
 "おおかみにんげん": "مُسْتَذْئِب, مُسْتَذْئِبَة",
 "おおかみ座": "ذِئْبَة",
 "おおかみ男": "مُسْتَذْئِب, مُسْتَذْئِبَة",
 "おおかめ": "ذِئْب (حيوان مفترس من فصيلة الكلاب يعيش في جماعات وأكثر ما يصطاد في الليل؛ صفة تطلق…)\nمثال: نظرة الذئب للشاة. / ذِئْبٌ فِي ثَوْبِ حَمَلٍ (حيوان مفترس من فصيلة الكلاب يعيش في جماعات وأكثر ما يصطاد في الليل؛ صفة تطلق…)\nمثال: نظرة الذئب للشاة.",
 "おおかれすくなかれ": "حَوَالِي",
 "おおかんばん": "أَفِيش / بشكل ممتاز, على ما يرام (بشكل جيد جداً)\nمثال: إنها لا تشعر أنها على ما يرام اليوم",
 "おおがかり": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق)",
 "おおがしら": "طائر النفخة (طائر أمريكي استوائي بني اللون له رأس كبير بريش منفوش)",
 "おおがた": "كَبِير, وَاسِع (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير.",
 "おおがたか": "تَوْسِيع",
 "おおがたき": "جامبو جت, طائرة جامبو (طائرة نفاثة كبيرة جداً)",
 "おおがたきかい": "نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره)\nمثال: هذا النبات مهدد بالانقراض.",
 "おおがたそうちかがく": "العلوم الكبرى (البحث العلمي الذي يتطلب استثمارات رأسمالية ضخمة ولكن من المتوقع أن يسفر عن…)",
 "おおがたてん": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق)",
 "おおがたるいじんえん": "قرد عظيم (أي من القردة العليا الكبيرة من فصيلة البونجيد)",
 "おおがち": "مُمِيت, قَاتِل\nمثال: قتل الصياد دبا.",
 "おおがま": "مِنْجَل, مِقْضَب / قِدْر (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "おおがみ": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "おおがらす": "غُرَاب",
 "おおき": "رَائِع, عَظِيم\nمثال: الصين بلد عظيم. / أَكْبَر, كُبْرَى (الأَكْبَر: هو ما فاق غيره في الكُبْر، ويكون ذلك إما بالحجم أو المقام أو كلاهما…)\nمثال: إنه أخي الأكبر. / الكثير, قدراً كبيراً (إلى درجة أو مدى كبير جداً)\nمثال: أشعر بتحسن كبير",
 "おおきい": "كَبِير, كبير (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير. / عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال / شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)\nمثال: إنتاج القمح في ظل ظروف واسعة النطاق / مُهِمّ",
 "おおきく": "عَرِيض",
 "おおきくなる": "كَبُرَ, ْنَشَأ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "おおきさ": "مَقَاس, قِيَاس",
 "おおきど": "حَاجِز, نُقْطَة تَفْتِيش",
 "おおきな": "كَبِير, كبير (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير.",
 "おおきに": "بشكل كبير",
 "おおきみ": "قَيْصَر, إِمْبْرَاطُور / أَمِير",
 "おおきめ": "كَبِير نَوْعًا مَا (كبير إلى حدٍّ ما)",
 "おおきんけいぎく": "أشرفية, بذر القراد",
 "おおぎみ": "قَيْصَر, إِمْبْرَاطُور / أَمِير",
 "おおぎょう": "مُضَخَّم, مُكَبَّر (مُكبَّر إلى درجة غير طبيعية)",
 "おおく": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / غَالِبِيَّة, أَغْلَبِيّة / إلى حد كبير, بشكل رئيسي (في جزء كبير؛ بشكل رئيسي أو أساسي)\nمثال: هذه الحسابات غير نشطة إلى حد كبير",
 "おおくぎ": "سنبلة",
 "おおくち": "تبجح, تفاخر (حالة من الحديث المتباهي)\nمثال: تبجحه أسوأ من قتاله",
 "おおくちをたたく": "تَبَاهَى",
 "おおくちバス": "قاروص كبير الفم (قاروص أسود كبير؛ تقع زاوية الفك خلف العين)",
 "おおくとも": "فِي مُعْظَمِ, فِي الأَغْلَبِ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "おおくび": "رقعة, وصلة تقوية (قطعة من المادة تستخدم لتقوية أو توسيع الثوب)",
 "おおくまざ": "الدُّب الْأَكْبَر, بَنَات نَعْش الكُبْرَى",
 "おおくらしょうしょうけん": "أذونات الخزانة (التزام قصير الأجل لا يحمل فائدة (يتم شراؤه بخصم)؛ يمكن تداوله على أساس الخصم…)",
 "おおくらだいじん": "وزير المالية (الوزير المسؤول عن مالية الدولة)",
 "おおくろぐわい": "كستناء الماء, كستناء الماء الصينية (سعد صيني ينتج درنات صالحة للأكل على شكل بصيلة)",
 "おおぐい": "نَهَم, شَرَه / أكول, نهم (شخص ذكر مكرس للأكل والشرب بإفراط)",
 "おおぐち": "تبجح, تفاخر (حالة من الحديث المتباهي)\nمثال: تبجحه أسوأ من قتاله",
 "おおぐちをあける": "ذهول, فغر الفم (تحديق بذهول (عادة مع فم مفتوح))",
 "おおぐちをたたく": "تَبَاهَى",
 "おおぐちバス": "قاروص كبير الفم (قاروص أسود كبير؛ تقع زاوية الفك خلف العين)",
 "おおぐまざ": "الدُّب الْأَكْبَر, بَنَات نَعْش الكُبْرَى",
 "おおぐま座": "الدُّب الْأَكْبَر, بَنَات نَعْش الكُبْرَى",
 "おおぐみ": "تبرج, مكياج (مستحضرات تجميل توضع على الوجه لتحسين أو تغيير المظهر)\nمثال: فاتته الاختبار واضطر لإجراء اختبار تعويضي",
 "おおぐらい": "أَكَّال, شَرَه",
 "おおけたで": "بطباط شرقي, ريشة الأمير (نبات حولي بأوراق بيضاوية عريضة وسنابل متدلية رفيعة من الزهور القرمزية؛ جنوب شرق…)",
 "おおげさ": "مُضَخَّم, مُكَبَّر (مُكبَّر إلى درجة غير طبيعية)",
 "おおげさにいう": "بَالَغَ",
 "おおげさにする": "بَالَغَ",
 "おおこうもり": "خفاش الفاكهة (خفاش كبير من العالم القديم في المناطق الدافئة والاستوائية يتغذى على الفاكهة)",
 "おおこけ": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة…)",
 "おおごえだす": "رَفَعَ صَوْتَهُ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "おおごえをだす": "رَفَعَ صَوْتَهُ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "おおごしょ": "إمبراطور مالي, بارون (رجل أعمال ثري جداً أو قوي النفوذ)\nمثال: بارون نفط",
 "おおごと": "أَزْمَة, بُحْرَان",
 "おおさか": "أُوسَاكَا",
 "おおさかみんこく": "أُوسَاكَا",
 "おおさじ": "ملعقة طعام, ملعقة كبيرة (ملعقة أكبر من ملعقة الحلوى؛ تستخدم للتقديم)",
 "おおさらい": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق)",
 "おおさわぎ": "جلبة, صخب (صيحات عالية ومستمرة من العديد من الناس)\nمثال: تجاهل صخب الحشد",
 "おおざっぱ": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق. / غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "おおざら": "أسطوانة, أسطوانة فونوغراف (تسجيل صوتي يتكون من قرص به أخدود مستمر؛ يستخدم لإعادة إنتاج الموسيقى عن طريق…)",
 "おおし": "عَدِيد, كَثِير",
 "おおしあい": "طرائد كبيرة (حيوانات كبيرة يتم اصطيادها للرياضة)",
 "おおしい": "رُجُولِيّ",
 "おおしばい": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق)",
 "おおしょうじょう": "غُورِيلَا",
 "おおじ": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم…)\nمثال: عليك العمل بجد. / شَيْخ, عَجُوز / جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم…)\nمثال: كانت ماري جادة.",
 "おおじか": "مُوظ",
 "おおじかけ": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق)",
 "おおじだい": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "おおじゅりん": "درسة القصب (طائر درسة أوروبي يسكن المناطق المستنقعية)",
 "おおすじ": "لَخَّصَ, اِخْتَصَرَ",
 "おおせ": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية. / كلام, كلمات (اللغة التي يتم التحدث بها أو كتابتها)\nمثال: لديه موهبة في الكلام",
 "おおせごと": "تَصْرِيح, بَيَان",
 "おおせつける": "أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "おおせられる": "قَالَ, قال (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "おおそうどう": "مَعْمَعَة",
 "おおそうば": "ذراع التطويل, عوارضة (أي من الصواري أو الأعمدة الأفقية المتنوعة المستخدمة لتمديد أسفل الشراع أو…)\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "おおそれた": "بَاهِظ, فَاحِش (يَتَجَاوَزُ حُدُودَ المَعْقُولِ وَالاعْتِدَالِ بِكَثِير)",
 "おおぞら": "حَزِين\nمثال: هذا البناء أزرق.",
 "おおたか": "باز شمالي / صَقَارَة",
 "おおたかがり": "صَقَارَة",
