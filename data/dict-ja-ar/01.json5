 "うまのり": "ركوب الخيل (السفر محمولاً على ظهر الخيل) / اِمْتَطَى",
 "うまばえ": "نبرة الخيل (طفيلية بشكل رئيسي على الخيول)",
 "うまひと": "أَرِسْتُقْرَاطِيّ, أَرِسْتُقْرَاطِيَّة",
 "うまふぶき": "أرقطيون كبير, لزيق (أرقطيون بأوراق على شكل قلب يوجد في الغابات المفتوحة والأسيجة والمراعي الوعرة في…)",
 "うまみ": "لَذَّة / أُومَامِي / مَهَارَة / رِبْح, مَكْسَب (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ…)\nمثال: ربح زيري المال.",
 "うまや": "حَظِيرَة, اِسْطَبْل\nمثال: الشاحنة غير ثابتة. / محطة البريد, نزل البريد (نزل لتبادل خيول البريد واستيعاب الفرسان)",
 "うまやごえ": "سَمَّدَ ((سَمَدَ) يَسْمُدُ سُمُودًا: عَلاَ؛ (سَمَدَ): رفع رأْسه ونَصَبَ صَدرَه)",
 "うまる": "فَيَضَان",
 "うまれ": "وِلَادَة, مَوْلِد\nمثال: أعرف ذلك الولد.",
 "うまれおちる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "うまれかわり": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة)",
 "うまれがいい": "كَرِيم الأَصْل, نَبِيل المَحْتِد (مِنْ نَسَبٍ رَفِيعٍ أَوْ سُلَالَة عُلْيَا)",
 "うまれがよい": "كَرِيم الأَصْل, نَبِيل المَحْتِد (مِنْ نَسَبٍ رَفِيعٍ أَوْ سُلَالَة عُلْيَا)",
 "うまれそこない": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "うまれたて": "مَوْلُود حَدِيث, مَوْلُودَة حَدِيثة",
 "うまれたばしょ": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "うまれついて": "طَبِيعِيّ",
 "うまれつき": "بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: كان كسولاً بطبعه",
 "うまれつく": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "うまれてくる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "うまれてこのかた": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "うまれでる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "うまれどころ": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "うまれながら": "بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: كان كسولاً بطبعه",
 "うまれのいい": "كَرِيم الأَصْل, نَبِيل المَحْتِد (مِنْ نَسَبٍ رَفِيعٍ أَوْ سُلَالَة عُلْيَا)",
 "うまれのよい": "كَرِيم الأَصْل, نَبِيل المَحْتِد (مِنْ نَسَبٍ رَفِيعٍ أَوْ سُلَالَة عُلْيَا)",
 "うまれび": "عِيد مِيلَاد\nمثال: طقس اليوم جميل.",
 "うまれる": "وُلِدَ, تَوَلَّدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "うまれ変わり": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة)",
 "うみ": "بَحْر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر. / قَيْح, صَدِيد / فَسَاد / وِلَادَة, مَوْلِد\nمثال: أعرف ذلك الولد. / خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "うみあいさ": "بلقشة حمراء الصدر (بلقشة واسعة الانتشار في أمريكا وأوروبا)",
 "うみうし": "بزاق البحر, عاريات الخياشيم (أي من بطنيات القدم البحرية المختلفة من رتيبة عاريات الخياشيم التي لها جسم عديم…)",
 "うみうそ": "أَسَد بَحْر, كَلْب البَحْر (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة…)\nمثال: الأسد حيوان بري.",
 "うみうま": "حصان البحر (سمكة صغيرة برأس يشبه الحصان ينحني بحدة للأسفل وذيل ملتف؛ تسبح في وضع عمودي)",
 "うみえら": "قلم البحر (مستعمرات لحمية تشبه الريش تعيش في المياه الدافئة)",
 "うみおそ": "أَسَد بَحْر, كَلْب البَحْر (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة…)\nمثال: الأسد حيوان بري.",
 "うみおとす": "قَطْرَة\nمثال: هذه هي نقطة ضعفه.",
 "うみかぜ": "نسيم البحر (نسيم منعش من البحر (خلال النهار))",
 "うみがめ": "سلحفاة بحرية (أي من سلاحف كبيرة متنوعة ذات أطراف معدلة إلى زعانف؛ واسعة الانتشار في البحار…)",
 "うみがらす": "مور شائع (أكثر أنواع طائر المور شيوعاً)",
 "うみくさ": "نجيل بحري / عُشْب بَحْرِيّ",
 "うみぐさ": "نجيل بحري / عُشْب بَحْرِيّ",
 "うみぐも": "عنكبوت البحر (أي من المفصليات البحرية الصغيرة المختلفة التي تشبه العناكب ولها أجسام صغيرة…)",
 "うみぐもるい": "عنكبوت البحر (أي من المفصليات البحرية الصغيرة المختلفة التي تشبه العناكب ولها أجسام صغيرة…)",
 "うみさそり": "عقرب البحر, يوريبتيريد (مفصلي منقرض كبير يشبه العقرب يعتبر مرتبطاً بسرطانات حدوة الحصان)",
 "うみさち": "مَأْكُولَات بَحْرِيَّة, طَعَام الْبَحْر",
 "うみざりがに": "كَرْكَنْد",
 "うみしだ": "نجم ريشي (كرينويد حر السباحة بدون ساق بعشرة أذرع ريشية؛ يوجد في قيعان البحر الطينية)",
 "うみしだもく": "نجم ريشي (كرينويد حر السباحة بدون ساق بعشرة أذرع ريشية؛ يوجد في قيعان البحر الطينية)",
 "うみしる": "قَيْح, صَدِيد",
 "うみじる": "قَيْح, صَدِيد",
 "うみぞい": "سَاحِل, شَاطِئ",
 "うみただれる": "تَقَيَّحَ",
 "うみたなご": "شوب البحر (أسماك تعيش في أسراب غالباً في المحيط الهندي وغرب المحيط الهادئ؛ نوعان في غرب…)",
 "うみだす": "خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق. / اِخْتَرَعَ / دُبّ",
 "うみだぬき": "قُنْدُس, سَمُّور",
 "うみっぺり": "سَاحِل, شَاطِئ",
 "うみつける": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "うみつばめ": "طائر النوء (أي من طيور النوء الصغيرة المتنوعة ذات الريش الداكن والأجزاء السفلية الشاحبة)",
 "うみどり": "طائر بحري (طائر يتردد على المياه الساحلية والمحيط المفتوح: النوارس، البجع، الأطيش، الغاق…)",
 "うみのえき": "مارينا",
 "うみのおや": "مُؤَسِّس, مُؤَسِّسَة",
 "うみのくるしみ": "آلام المخاض (تشنج ألم متكرر بانتظام وهو سمة من سمات الولادة)",
 "うみのこ": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "うみのさち": "مَأْكُولَات بَحْرِيَّة, طَعَام الْبَحْر",
 "うみのものともやまのものともつかない": "لا السمك ولا الطيور (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "うみのものともやまのものともわからない": "لا السمك ولا الطيور (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "うみばと": "غلموت الحمام (غلموت شمال المحيط الهادئ)",
 "うみひごい": "مُخَطَّط بِالأَصْفَر (عليه خطوط صفراء اللون)",
 "うみへび": "ثعبان البحر (أي من الثعابين المائية السامة الولودة العديدة التي لها ذيل يشبه الزعنفة؛ من…)",
 "うみへびざ": "هِيدْرَا",
 "うみへび座": "هِيدْرَا",
 "うみべ": "شَاطِئ (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة)…)\nمثال: عاد إلى الشاطئ.",
 "うみほたる": "صدفيات (قشريات بحرية ومياه عذبة صغيرة بجسم يشبه الروبيان محاط بصدفة ذات مصراعين)",
 "うみぼうず": "سلحفاة خضراء (سلحفاة استوائية كبيرة ذات لحم مخضر يُستخدم في حساء السلاحف)",
 "うみます": "ترويت بحري (نوع بحري فضي اللون من الترويت البني يهاجر إلى المياه العذبة للتكاثر)",
 "うみやつめ": "جلكى بحرية (جلكى كبيرة مهاجرة تستخدم أحياناً كغذاء؛ مدمرة لحيوانات الأسماك المحلية في…)",
 "うみやま": "عَمِيق, غَوِيط",
 "うみゆり": "زنبق البحر (كرينويد بأذرع مشعة دقيقة وجسم ذو ساق ملتصق بسطح صلب)",
 "うみわた": "إِسْفَنْج",
 "うみんちゅ": "صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "うみイグアナ": "إغوانة بحرية (سحلية تعيش على الشاطئ وتأكل الأعشاب البحرية في جزر غالاباغوس)",
 "うみガメ": "سلحفاة بحرية (أي من سلاحف كبيرة متنوعة ذات أطراف معدلة إلى زعانف؛ واسعة الانتشار في البحار…)",
 "うみザリガニ": "كَرْكَنْد",
 "うむ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد)\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل . / تَقَيَّحَ / وَلَدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / أَنْتَجَ, صَنَعَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت) / يَنَعَ, نَضَجَ (أَيْنَعَ؛ نَضَجَ) / رَدَنَ, غَزَلَ (رَدَنَ رَدْنًا: غزل الرَّدَن أو غزل بالمِردَن؛ ويقال: رَدَنَ الثوبَ: نسجه…)",
 "うむあいつうじる": "عُمْدَة",
 "うむをいわさず": "بشكل آمر, بشكل حاسم (بطريقة آمرة وحاسمة)",
 "うむをいわせず": "بشكل آمر, بشكل حاسم (بطريقة آمرة وحاسمة)",
 "うめ": "مشمش ياباني (شجرة زينة يابانية بزهور بيضاء أو وردية عطرة وثمار صفراء صغيرة) / أَخِير, الأَدْنَى (الأدنى في الرتبة أو الأهمية)\nمثال: الغصن الذي يحمل الدراق الكبير تدلى إلى أدنى مستوى",
 "うめあわす": "تراجع معماري, ردة الجدار (هيكل يضيق فيه الجدار أو المبنى بشكل مفاجئ)",
 "うめあわせ": "تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة)",
 "うめあわせる": "تراجع معماري, ردة الجدار (هيكل يضيق فيه الجدار أو المبنى بشكل مفاجئ)",
 "うめぇ": "لَذِيذ / مَاهِر, حَاذِق",
 "うめえ": "لَذِيذ / مَاهِر, حَاذِق",
 "うめき": "تَأَوَّهَ (قَالَ آه؛ تَحَسَّرَ، تَنَهَّدَ)",
 "うめきごえ": "آهَة, أَنِين",
 "うめき声": "آهَة, أَنِين",
 "うめく": "تَأَوَّهَ (قَالَ آه؛ تَحَسَّرَ، تَنَهَّدَ)",
 "うめくさ": "حشوة (التبغ المستخدم لتشكيل لب السيجار)\nمثال: بعض العناصر في المجموعة مجرد تكملة",
 "うめこみ": "زرع, غرس (إجراء جراحي يضع شيئاً ما في جسم الإنسان)\nمثال: زرع كريات مشعة في غدة البروستاتا",
 "うめこむ": "دَفَنَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "うめごよみ": "زَهْرَة بَرْقُوق",
 "うめしそ": "مشمش ياباني (شجرة زينة يابانية بزهور بيضاء أو وردية عطرة وثمار صفراء صغيرة)",
 "うめしゅ": "اسكدنيا, مشمش هندي (فاكهة شبه استوائية صفراء بحجم الزيتون ذات نواة حرة كبيرة ولحم قليل نسبياً)",
 "うめじそ": "مشمش ياباني (شجرة زينة يابانية بزهور بيضاء أو وردية عطرة وثمار صفراء صغيرة)",
 "うめぞの": "مشمش ياباني (شجرة زينة يابانية بزهور بيضاء أو وردية عطرة وثمار صفراء صغيرة)",
 "うめたてる": "مَلَأَ",
 "うめつくす": "حُزْمَة, عُبُوَّة\nمثال: حزم ياني أمتعته.",
 "うめのみ": "مشمش ياباني (شجرة زينة يابانية بزهور بيضاء أو وردية عطرة وثمار صفراء صغيرة)",
 "うめもどし": "إعادة دفن (فعل الدفن مرة أخرى)",
 "うめもどす": "عبوة إعادة تعبئة, غيار (منتج تجاري يملأ حاوية بمحتوياتها المناسبة)\nمثال: حصل على عبوة حبر لقلمه الجاف",
 "うめる": "دَفَنَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته. / مَلَأَ / قَابِس / غِطَاء",
 "うめー": "لَذِيذ / مَاهِر, حَاذِق",
 "うもう": "رِيش, رِيشَة (رَيَّشَ السَّهْمَ: راشهُ؛ رَيَّشَ الثَّوْبَ: زَيَّنَهُ بِصُوَرِ الرِّيش)\nمثال: هل عنده ريشة رسم؟",
 "うもうふとん": "زَغَبُ العَيْدَر (زغب بط العيدر)",
 "うもうぶとん": "زَغَبُ العَيْدَر (زغب بط العيدر)",
 "うもれぎ": "تِين, بَلَس",
 "うもん": "مزخرف, منقوش (لديه نقوش (خاصة أنماط ملونة))",
 "うやうやしい": "أَدِيب, مُؤَدَّب",
 "うやまい": "تبجيل, تعظيم (عمل يظهر الاحترام (خاصة الانحناء))\nمثال: خشية الله",
 "うやまう": "وَقَّرَ",
 "うやむや": "نَكِرَة",
 "うゆ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "うゆう": "عَدَم (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "うよ": "تَعَرَّجَ",
 "うよきょくせつ": "تَعَرَّجَ",
 "うよく": "الجناح اليميني, اليمين (أولئك الذين يدعمون المحافظة السياسية أو الاجتماعية أو الاقتصادية؛ أولئك الذين…) / الحقل الأيمن (مركز اللعب للاعب في فريق البيسبول المتوقع منه التقاط الكرات في الثلث الأيمن من…) / مُسَاعَدَة, إِمْدَاد",
 "うよくうんどう": "يَمِينِيّ",
 "うよくしゅ": "لاعب الدفاع الأيمن (الشخص الذي يلعب في الجانب الأيمن من الملعب الخارجي)",
 "うよくだんたい": "يَمِينِيّ",
 "うら": "ثَغْر, ثَغْر بَحْرِيّ (ثَغَرَ الجدارَ ونحوهَ يَثْغَرُ ثَغْرًا: أحدث فيه ثُلْمة؛ ثَغَرَ فلانًا: كسر…) / سَاحِل, شَاطِئ / عَرَافَة / طَرَف / قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر)\nمثال: نمت في قاعة السينما. / خَلْفِيّ / بِطَانَة\nمثال: 不幸の裏には幸いあり。 — رب ضارّةٍ نافعة. / مِن وَرَاءَ السِّتارِ, وَرَاءَ الكَوالِيسِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "うらあて": "دعم, مؤازرة (فعل تقديم الموافقة والدعم)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "うらあみ": "غرزة مقلوبة (غرزة حياكة أساسية مصنوعة بوضع الإبرة عبر الجزء الأمامي من الغرزة من الجانب…)",
 "うらいた": "سَقْف ((سَقَفَ) البيت ونحوه سقفا: عمل له سقفا)\nمثال: نظرت إلى السقف.",
 "うらうち": "بِطَانَة / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة.",
 "うらうつり": "تراجع معماري, ردة الجدار (هيكل يضيق فيه الجدار أو المبنى بشكل مفاجئ)",
 "うらおもて": "بِالْمَقْلُوبِ / ازدواجية, تعامل بوجهين (التصرف بسوء نية؛ الخداع بالتظاهر بامتلاك مجموعة من النوايا بينما يتصرف تحت…)",
 "うらかいどう": "طريق جانبي, طريق فرعي (طريق جانبي قليل الاستخدام (كما في الريف))",
 "うらかぜ": "نسيم البحر (نسيم منعش من البحر (خلال النهار))",
 "うらかた": "خَلْفَ الكَوَالِيس, سِرِّيّ (مُصَمَّمٌ وَمُنَفَّذٌ بِسِرِّيَّةٍ أَوْ بِشَكْلٍ سِرِّيّ)",
 "うらかわ": "شمواه, قماش شمواه (قماش مصنوع ليشبه جلد الشمواه) / قطعة جلد (جزء منفصل مصنوع من الجلد)",
 "うらがえし": "بِالْمَقْلُوبِ / الوَجْه الآخَر (جانب مختلف لشيء ما (وخاصة الجانب المعاكس))\nمثال: الوجه الآخر لصفاتك الإيجابية هو أنها تخرج أحياناً عن السيطرة",
 "うらがえる": "خانَ (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / صَرِير\nمثال: لدى مايوكو حاسة بصر حادة.",
 "うらがき": "إقرار, تزكية (فعل المصادقة أو التزكية)\nمثال: يمكن للرياضي النجم أن يجني الكثير من المال من عقود التزكية / تَعْلِيق, مَلْحُوظَة / بُرْهَان, دَلِيل",
 "うらがききんしてがた": "غَيْر قَابِل لِلتَّدَاوُل (لا يمكن شراؤه أو بيعه)",
 "うらがきにん": "مُجَيِّر, مُظَهِّر (شخص ينقل ملكيته لشيء ما عن طريق التوقيع على شيك أو ورقة مالية قابلة للتداول)",
 "うらがなしい": "حَزِين, زعلان",
 "うらがね": "رَشْوَة, رِشْوَة\nمثال: عندي برشا أسئلة على الكتاب هذا. / أموال سرية, صندوق رشاوى (صندوق لشراء الأصوات أو رشوة المسؤولين الحكوميين)",
 "うらがれる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "うらがわ": "عَكَسَ / شمواه, قماش شمواه (قماش مصنوع ليشبه جلد الشمواه) / قطعة جلد (جزء منفصل مصنوع من الجلد)",
 "うらき": "تاج الشجرة, قمة الشجرة (الفروع والأوراق العليا لشجرة أو نبات آخر)",
 "うらきど": "بَاب خَلْفِيّ (ما يُسَدُّ به مَدْخَل المَبْنَى أو الغُرْفَة أو المَرْكَبَة؛ (تعميم) مَدْخَل أي…)\nمثال: ظل الباب مغلقا.",
 "うらぎく": "أستر البحر, نجمة البحر (أستر أوروبي شائع ينمو في المستنقعات المالحة)",
 "うらぎり": "خيانة, غدر (فعل خيانة متعمد)",
 "うらぎりもの": "خائن, غادر (شخص يقول شيئاً ويفعل شيئاً آخر)",
 "うらぎる": "خانَ (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / خَيَّبَ آمَالَهُ ((خَيَّبَ)و(خيبه): جعله خائبا وَحرمه وَلم ينله طلبه)\nمثال: خيبة أملها كانت جلية للجميع.",
 "うらぐち": "باب خلفي, وسيلة سرية (وسيلة سرية أو ملتوية للوصول (إلى مكان أو منصب))\nمثال: حصل على وظيفته من الباب الخلفي / غَيْر مُخَوَّل, غَيْر مُصَرَّح بِه (غير ممنوح السلطة)",
 "うらごえ": "فَالْسِيتُّو (عالي النبرة اصطناعيّاً؛ فوق المدى الصوتيّ الطبيعيّ)",
 "うらごし": "غِرْبَال, مِصْفاة / هريس (اسم مفعول من هَرَسَ، وهو المدقوق دقا عنيفا حتى تفتت؛ اسم: طعام مصنوع من القَمْح…)",
 "うらごしき": "غِرْبَال, مِصْفاة",
 "うらさ": "تِسْعَة, تسعة",
 "うらさびしい": "مُسْتَوْحِش, وَحِيد (يَتَّسِمُ بِالحُزْنِ النَّاجِمِ عَنِ الوَحْدَة)",
 "うらさみしい": "مُسْتَوْحِش, وَحِيد (يَتَّسِمُ بِالحُزْنِ النَّاجِمِ عَنِ الوَحْدَة)",
 "うらさん": "عصا التكهن, عصا الكشف عن المياه (عصا متشعبة يُزعم أنها تنحني لأسفل للإشارة إلى وجود مياه جوفية أو نفط)",
 "うらしまたろうじょうたい": "كثير النوم, نؤوم (شخص ينام كثيراً)",
 "うらしまつつじ": "عنب الدب الألبي, قطلب ألبي (شجيرة زاحفة متساقطة الأوراق تكون حمراء زاهية في الخريف ولها توت أسود أو أزرق…)",
 "うらしまはなこ": "كثير النوم, نؤوم (شخص ينام كثيراً)",
 "うらしゃかい": "سِجِّين, عَالَم سُفْلِيّ",
 "うらじ": "بِطَانَة\nمثال: どの雲にも銀の裏地がついている。 — رب ضارّةٍ نافعة.",
 "うらじじょう": "تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية",
