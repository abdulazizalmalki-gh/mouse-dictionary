{
 "しなやか": "رَشِيق, لَدْن ((عَنْ أَجْسَادِ الأَشْخَاصِ) قَادِرٌ عَلَى الحَرَكَةِ أَوِ الِانْثِنَاءِ بِحُرِّيَّةٍ) / سَلِس, طَيِّع ((عَنْ سِمَاتِ الشَّخْصِيَّةِ) سَرِيعُ التَّكَيُّفِ) / رَشِيق, لَدِن (نحيل بأناقة ويتحرك وينثني بسهولة ويُسر) / رَشِيق, ظَرِيف",
 "しなり": "ثني, حني (عملية ثني شيء ما) / انحراف, انحناء (خاصية الانحناء أو الانحراف) / انحناء, تقوس (حركة تسبب تشكل منحنى)",
 "しなる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "しなわけ": "تبويب, تصنيف (فعل توزيع الأشياء في فئات أو أصناف من نفس النوع) / تشكيلة, خليط (مجموعة تحتوي على تشكيلة متنوعة من أنواع الأشياء)\nمثال: كانت هناك تشكيلة كبيرة من السيارات معروضة",
 "しなん": "تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: هو بارع في التعليم.",
 "しなんしょ": "دَلِيل, كُتَيِّب",
 "しなんじょ": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "しなんばん": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "しなんやく": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "しなチベットごぞく": "اللغات الصينية التبتية (عائلة اللغات النغمية التي يتم التحدث بها في شرق آسيا)",
 "しなチベットしょご": "اللغات الصينية التبتية (عائلة اللغات النغمية التي يتم التحدث بها في شرق آسيا)",
 "しな垂れる": "تدلي, ترهل (شكل يتدلى أو يهبط للأسفل)\nمثال: كان هناك هبوط في مقعد الكرسي",
 "しに": "مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر / مَيِّت / بِشَكْل بَغِيض, بِشَكْل لَعِين (بطريقة بغيضة) / لَعِين, مَلْعُون ((غير رسمي) شتائم تُستخدَم للتوكيد والتأثير) / مَحْكُومٌ عَلَيْه, مَلْعُون (مُعرَّض لعذاب جهنم الأبدي) / ملعونون, هالكون (الناس المحكوم عليهم بالعقاب الأبدي)\nمثال: آرثر اللطيف - مثابر بشكل لعين، وبأدب، وبلا نهاية!",
 "しにいき": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "しにいたらしめる": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "しにうま": "طعم الغربان (حصان هزيل من المحتمل أن يصبح جيفة قريباً وبالتالي يجذب الغربان)",
 "しにがみ": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "しにく": "لِثَة, لَثَة / صَمْغ / عِلْكَة / جِيفة, فَطِيسَة",
 "しにくえん": "التهاب اللثة (التهاب اللثة)",
 "しにそこない": "خرف (مسن في مرحلة الخرف؛ شخص أضعف العمر عقله)",
 "しにそこなう": "نَجَا",
 "しにぞこない": "خرف (مسن في مرحلة الخرف؛ شخص أضعف العمر عقله)",
 "しにたい": "الْبَطَّةُ الْعَرْجَاءُ",
 "しにたえる": "اِنْقَرَضَ",
 "しにのぼせる": "نَشَرَ, أَصْدَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "しにみ": "جَسَد مَيِّت, جُثَّة (جسم طبيعي يتكون من حيوان أو إنسان ميت)\nمثال: وجدوا الجثة في البحيرة",
 "しにものぐるい": "استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "しにょう": "إفرازات, فضلات الجسم (نفايات (مثل البول أو العرق ولكن خاصة البراز) يتم تصريفها من الجسم)",
 "しにょうしょり": "تصريف مياه الصرف الصحي (التخلص من مياه الصرف الصحي)",
 "しにん": "جُثَّة, جُثْمَان / رؤية, مشاهدة (فعل الرؤية أو الملاحظة)\nمثال: تم الإبلاغ عن عدة مشاهدات لقوات العدو",
 "しにんせい": "رُؤْيَة",
 "しぬ": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات. / زَالَ (زَالَ يَزُولُ زَوَالاً، وزَوَلاَنًا: تحوَّلَ وانتقل؛ يقال: زَالَ من مكانه وعنه)\nمثال: توم لا زال يبكي",
 "しぬきで": "بجنون, بشدة ((عامية) بسرعة أو جهد أو شدة كبيرة؛ للمبالغة) / في أحلامه, مستحيل (تستخدم بسخرية للإشارة إلى عكس ما قيل)\nمثال: قاد بجنون",
 "しぬほど": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "しね": "اللعنة عليك",
 "しねしね": "مَرِن",
 "しねん": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "しねんじょ": "وعي, يقظة ذهنية (سمة البقاء واعياً (إيلاء اهتمام وثيق) بمسؤولياتك)",
 "しねんせい": "قابلية الاحتراق, قابلية الاشتعال (صفة القدرة على الاشتعال والاحتراق)",
 "しの": "قُشَارة, كُشَاطَة (شظية أو شريحة رفيعة (خاصة من الخشب) تم كشطها أو حلقها من شيء ما) / دَقِيقَة, شَظِيَّة (قطعة صغيرة رفيعة وحادة من الخشب أو الزجاج أو المعدن)\nمثال: دخلت شظية في إصبعه",
 "しのう": "زق, كيس بوغي (بنية تشبه الكيس تتكون فيها الأبواغ الزقية من خلال التكاثر الجنسي للفطريات الزقية)",
 "しのうきん": "زِقِّيّ",
 "しのうくんれんし": "أخصائي تقويم بصر (أخصائي في تقويم البصر)",
 "しのぎ": "صَبُور, طَوِيلُ البَال (يَتَحَمَّلُ بِصَبْرٍ الظُّلْمَ أَوِ المَتَاعِبَ المُسْتَمِرَّة) / خَالِد, رَاسِخ (يبقى مدّة طويلة؛ لا يزول بسهولة)",
 "しのぎば": "مَلَاذ (مَلْجَأ، مَأْوَى) / مَخْلَص (الشخص الذي يفي ولا يخون)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "しのくみ": "مَجْمُوعَة الْمَوْت (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "しのぐ": "تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ / نَجَا / فَاقَ, تَجَاوَزَ",
 "しのざさ": "خَيْزَرَان, خَيْزُرَان",
 "しのだけ": "خَيْزَرَان, خَيْزُرَان",
 "しのつく": "صَبَّ, سَكَبَ (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون)\nمثال: صب الشاي لضيفك.",
 "しのつくあめ": "وَابِل, مَطَر غَزِير",
 "しのつく雨": "وَابِل, مَطَر غَزِير",
 "しのとこ": "سرير الاحتضار, فراش الموت (السرير الذي يموت عليه الشخص) / فراش الموت (الساعات الأخيرة قبل الوفاة)",
 "しのに": "سِتَّة",
 "しののめいろ": "حُوت سُلَيْمَان, سَلَمُون (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "しのばせる": "أَخْفَى",
 "しのび": "تسلل, خلسة (تجنب الكشف عن طريق التحرك بحذر) / نِينْجُوتْسُو / نِينْجَا, نِنْجَا / لص متسلل (لص يسرق دون استخدام العنف)",
 "しのびあい": "لِقَاء مُحَدَّد, مَوْعِد (اجتماع مخطط له في وقت ومكان معينين) / لقاء, موعد غرامي (موعد؛ عادة مع شخص من الجنس الآخر) / مكان اللقاء, ملتقى (مكان يلتقي فيه الناس)\nمثال: كان ينتظرهم في مكان اللقاء",
 "しのびがたい": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "しのびごえ": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / همس, وشوشة (التحدث بنعومة دون اهتزاز الحبال الصوتية) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "しのびしのび": "بتسلل, خلسة (بطريقة خفية)\nمثال: تقدموا خلسة عكس التيار",
 "しのびでる": "انْسَلَّ, تَسَلَّلَ خارجاً (المغادرة خلسة وسراً)\nمثال: كانت المحاضرة مملة وانسل العديد من الطلاب خارجاً",
 "しのびない": "مُتَرَدِّد, مُحْجِم (غير متحمّس؛ يتردّد في الإقدام) / مُتَرَدِّد, مُحْجِم (غير راغب في الانخراط أو المشاركة) / كَارِه, مُمَانِع (يأبى فعل شيء يخالف عادته أو طبعه)",
 "しのびね": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / همس, وشوشة (التحدث بنعومة دون اهتزاز الحبال الصوتية) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "しのびのもの": "نِينْجَا, نِنْجَا",
 "しのびやか": "خَلْسِيّ, مُتَسَلِّل (يتّسم بالهدوء والحذر والسرّيّة؛ يحرص على تجنّب الملاحظة)",
 "しのびわらい": "إِهْلَاس",
 "しのび逢い": "لِقَاء مُحَدَّد, مَوْعِد (اجتماع مخطط له في وقت ومكان معينين) / لقاء, موعد غرامي (موعد؛ عادة مع شخص من الجنس الآخر) / مكان اللقاء, ملتقى (مكان يلتقي فيه الناس)\nمثال: كان ينتظرهم في مكان اللقاء",
 "しのふ": "تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ)\nمثال: ليلى تذكر سامي. / تَخَيَّلَ, تَصَوَّرَ",
 "しのぶ": "تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ)\nمثال: ليلى تذكر سامي. / تَخَيَّلَ, تَصَوَّرَ / عَجَبَ / أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟ / تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ",
 "しのぶいし": "تغصن, زائدة شجرية (ليف قصير ينقل الإشارات نحو جسم الخلية العصبية)",
 "しのぶとう": "رقصة الموت (رقصة من العصور الوسطى يقود فيها هيكل عظمي يمثل الموت موكباً من الآخرين إلى القبر)",
 "しのをつく": "صَبَّ, سَكَبَ (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون)\nمثال: صب الشاي لضيفك.",
 "しはい": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون. / اِتِّجَاه / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة. / سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟ / حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة.",
 "しはいかいきゅう": "أصحاب السلطة, الطبقة الحاكمة (فئة الناس التي تمارس السلطة أو الحكم)",
 "しはいがしら": "قَائِد, زَعِيم",
 "しはいけん": "تَفَوُّق",
 "しはいしゃ": "مُحَافِظ, حَاكِم",
 "しはいそう": "أصحاب السلطة, الطبقة الحاكمة (فئة الناس التي تمارس السلطة أو الحكم)",
 "しはいてき": "سَائِد / سَائِد, شَائِع",
 "しはいにん": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "しはいりつ": "مَسّ, تَلَبُّس / مُمْتَلَك / حَوْزَة, مُلْكِيّة / اِسْتِحْوَاذ / حِيَازَة",
 "しはじめる": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "しはす": "دِيسِمْبِر, دِيسَمْبِر (الشهر الثاني عشر في السنة الروميّة)\nمثال: أنا في إضراب من 8 إلى 12 ديسمبر.",
 "しはらい": "دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "しはらいしゃ": "دَافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو وجدانيّ، ولا شعوريّ في حين أنّ الباعث عقليّ وشعوريّ)\nمثال: دافع عن الضعفاء.",
 "しはらいじゅんびりつ": "نِسْبَة الِاحْتِيَاطِيّ (نسبة مئوية من إجمالي الودائع المصرفية، يتم الاحتفاظ بها لضمان قدرة البنك على دفع عدد كبير غير عادي من عمليات السحب عند الطلب إذا حدث ذلك)\nمثال: تُستخدم نسبة الاحتياطي الإلزامي أحيانًا كأداة في السياسة النقدية",
 "しはらいずみ": "ثَابِت, مُسْتَقِرّ (غَيْر قَابِل لِلتَّغَيُّر) / مُسْتَعْمَر, مُسْتَوْطَن (يسكنه مستوطنون أو مستعمرون) / مستقر, مستوطن (تم تأسيسه في وضع أو مكان مرغوب؛ غير متنقل) / محسوم, مُبت فيه (تم تحديده أو البت فيه بما لا يدع مجالاً للنزاع أو الشك)\nمثال: بدو؛ اندمجوا بين الناس المستقرين",
 "しはらいてがた": "أوراق دفع, سندات دفع (سند يعد بدفع مبلغ معين من المال في وقت معين)",
 "しはらいにん": "دَافِع (دَافِع : حافِزٌ وسببٌ، أمرٌ مُوجِبٌ؛ ما يحمل على الفعل من غرائز وميول فهو وجدانيّ، ولا شعوريّ في حين أنّ الباعث عقليّ وشعوريّ)\nمثال: دافع عن الضعفاء.",
 "しはらいのうりょく": "سُيُولَة",
 "しはらいふのう": "إِعْسَار, إِعْسَار مَالِيّ",
 "しはらいりそく": "مصاريف الفوائد (الفوائد المدفوعة على القروض)",
 "しはらう": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "しはん": "إِعْلَان تِجَارِيّ / مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة. / نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به) / دار المعلمين, مدرسة إعداد المعلمين (مدرسة مدتها سنتان لتدريب معلمي المدارس الابتدائية) / فرفرية (أي من عدة أمراض دموية تسبب نزيفاً تحت الجلد) / رُبُع (وقف وانتظر وتحبّس؛ الرجلُ: رفع الحجر بيده امتحانا لقوتّه) / حَارَة\nمثال: الساعة السادسة و الربع مساء.",
 "しはんがっこう": "دار المعلمين, مدرسة إعداد المعلمين (مدرسة مدتها سنتان لتدريب معلمي المدارس الابتدائية)",
 "しはんき": "رُبُع (وقف وانتظر وتحبّس؛ الرجلُ: رفع الحجر بيده امتحانا لقوتّه) / حَارَة\nمثال: الساعة السادسة و الربع مساء.",
 "しはんびょう": "فرفرية (أي من عدة أمراض دموية تسبب نزيفاً تحت الجلد)",
 "しはんぶん": "رَابِع, رَابِعَة (رابعوا الحمِلَ مرابعة: أدخلوا المِربَعة تحتهُ)\nمثال: زيري هو الرابع.",
 "しはんやく": "دواء بدون وصفة طبية, دواء لا يستلزم وصفة طبية (دواء يباع بدون وصفة طبية)",
 "しば": "غَضْراء, مَرْجة / أجمة, دغل (نمو كثيف للشجيرات) / حطب, خشب الغابة (الخشب من الشجيرات أو الفروع الصغيرة)\nمثال: أشعلوا ناراً من الحطب",
 "しばい": "لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس.",
 "しばいぎ": "مسرحي (مناسب لـ أو من خصائص خشبة المسرح أو المسرح) / مسرحي (متعلق بالمسرح أو فنونه) / تمثيل, عرض مسرحي (أداء لمسرحية)\nمثال: وضعية مسرحية",
 "しばいげ": "مسرحي (مناسب لـ أو من خصائص خشبة المسرح أو المسرح) / مسرحي (متعلق بالمسرح أو فنونه) / تمثيل, عرض مسرحي (أداء لمسرحية)\nمثال: وضعية مسرحية",
 "しばいごや": "بيت اللعب (لعبة تتكون من نموذج صغير لمنزل يمكن للأطفال اللعب بداخله)",
 "しばいずき": "مرتاد المسرح (شخص يحضر المسرح)",
 "しばいっけ": "بطولات زائفة, سلوك درامي مبالغ (سلوك تفاخري أو استعراضي أو مبالغ فيه أو ميلودرامي)\nمثال: البطولات الزائفة هي لتلك الأفلام الملحمية التي يصنعونها في هوليوود",
 "しばいもの": "مُمَثِّل, مُمَثِّلَة",
 "しばかりき": "جُزَازَة عُشْب",
 "しばきあい": "شِجَار صَاخِب (قتال صاخب وسط حشد من الناس) / حفلة صاخبة (حفلة صاخبة أو مليئة بالضجيج والمرح)",
 "しばき合い": "شِجَار صَاخِب (قتال صاخب وسط حشد من الناس) / حفلة صاخبة (حفلة صاخبة أو مليئة بالضجيج والمرح)",
 "しばく": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته. / أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "しばくさ": "غَضْراء, مَرْجة",
 "しばざくら": "قبس جبلي, قبس طحلبي (قبس معمر منخفض ذو خصلات بأوراق دائمة الخضرة تشبه الإبر وزهور وردية أو بيضاء؛ موطنه الولايات المتحدة ويزرع على نطاق واسع كغطاء أرضي)",
 "しばし": "قَرِيبًا, سَرْعَانَ مَا",
 "しばしば": "كَثِيرًا, غَالِبًا / مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "しばふ": "غَضْراء, مَرْجة",
 "しばめ": "حَبَة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / حُبُوب / تَجْزِيع, تَعْرِيق\nمثال: أكلت حبة طماطم.",
 "しばらく": "لبرهة, لفترة وجيزة (لفترة قصيرة)\nمثال: اجلس وابقى لبرهة / في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / لَم أَرَكَ مُنْذُ وَقْت طَوِيل, لَم أَرَكِ مُنْذُ وَقْت طَوِيل (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "しばらくして": "حالاً, خلال وقت قصير (في المستقبل القريب) / حالياً, في الوقت الحاضر (في هذا الوقت أو الفترة؛ الآن)\nمثال: سيكون الطبيب هنا قريباً",
 "しばらくのあいだ": "لبرهة, لفترة وجيزة (لفترة قصيرة)\nمثال: اجلس وابقى لبرهة",
 "しばらくの間": "لبرهة, لفترة وجيزة (لفترة قصيرة)\nمثال: اجلس وابقى لبرهة",
 "しばらくぶり": "دهر, سنوات (فترة زمنية طويلة)\nمثال: نحن نعرف بعضنا منذ دهر",
 "しばらく振り": "دهر, سنوات (فترة زمنية طويلة)\nمثال: نحن نعرف بعضنا منذ دهر",
 "しばり": "تضميد, تضميد الجراح (عمل وضع ضمادة) / مُلْزِم (مُنَفَّذٌ بِسُلْطَةٍ قَانُونِيَّةٍ صَحِيحَة) / تجليد, غلاف الكتاب (الغطاء الواقي لمقدمة الكتاب ومؤخرته وكعبه) / حاشية, شريط ربط (شريط مخيط فوق أو على طول حافة لتقويتها أو تزيينها)\nمثال: كان للكتاب تجليد جلدي / تَنْظِيم",
 "しばりあげる": "رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
 "しばりくび": "شَنْق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة.",
 "しばりつける": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل.",
 "しばりプレイ": "تقييد جنسي (ممارسة جنسية تتضمن تقييد أحد الشريكين جسديًا (بالحبال أو الأصفاد)) / رق, عبودية (حالة الخضوع لسيطرة شخص آخر) / استرقاق, عبودية (حالة الخضوع لسيطرة قوة أو تأثير أو قوة مجردة)\nمثال: كان في عبودية للخوف",
 "しばりプレー": "تقييد جنسي (ممارسة جنسية تتضمن تقييد أحد الشريكين جسديًا (بالحبال أو الأصفاد)) / رق, عبودية (حالة الخضوع لسيطرة شخص آخر) / استرقاق, عبودية (حالة الخضوع لسيطرة قوة أو تأثير أو قوة مجردة)\nمثال: كان في عبودية للخوف",
 "しばる": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل. / حَدَّ, حَدَّدَ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "しばれる": "تَجَمَّدَ",
 "しばん": "لوحة الأصابع (شريط ضيق من الخشب على عنق بعض الآلات الوترية (كالكمان أو التشيلو أو الجيتار وغيرها) حيث يتم الضغط على الأوتار ضد الخشب بالأصابع) / لوحة مفاتيح بيانو (مجموعة من المفاتيح على آلة موسيقية) / لوحة أصبعية (عمود إرشادي يشبه اليد بإصبع سبابة يشير للاتجاه)",
 "しぱしぱ": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "しひ": "سَمَّدَ ((سَمَدَ) يَسْمُدُ سُمُودًا: عَلاَ؛ (سَمَدَ): رفع رأْسه ونَصَبَ صَدرَه) / رَوْث, سَمَاد",
 "しひつ": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "しひょう": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به) / دَلِيل, فِهْرِس / فِهْرِس (كِتَاب تجمع فيه أسماء الكتب بترتيب يسهل منه إجاد العنوان المراد البحث عنه؛ فَصْل أو بَاب في أول أو آخر الكتاب ترتب فيه الأبواب والفصول ومواضعها ليسهل منه إيجاد المطلوب)",
 "しひょうレジスタ": "سجل الفهرس ((في علم الحاسوب) سجل يستخدم لتحديد عنوان المعامل)",
 "しび": "تمرحنة, وردية الكريب (شجيرة زينة من شرق الهند تزرع بكثرة في جنوب الولايات المتحدة) / تُونَة, تُنّ",
 "しびと": "جُثَّة, جُثْمَان",
 "しびょうし": "زمن شائع, وزن رباعي (توقيع زمني يشير إلى أربع دقات في المقياس)",
 "しびれ": "فتور, لامبالاة (سمة الافتقار للحماس أو الاهتمام بالأشياء عموماً) / تنميل, خدر (فقدان جزئي أو كلي للإحساس في جزء من الجسم؛ عَرَض لتلف الأعصاب أو خلل وظيفي)",
 "しびれうなぎ": "أنقليس رعاد, أنقليس كهربائي (سمكة مياه عذبة تشبه الثعبان تعيش في أمريكا الجنوبية ولها أعضاء كهربائية في جسمها)",
 "しびれえい": "رعاد, سمك الرعاد (أي سمكة راي بطيئة الحركة تعيش في القاع من رتبة الطوربيدينيات ولها جسم مستدير وأعضاء كهربائية على كل جانب من الرأس قادرة على إصدار شحنات كهربائية قوية)",
 "しびれかん": "فتور, لامبالاة (سمة الافتقار للحماس أو الاهتمام بالأشياء عموماً) / تنميل, خدر (فقدان جزئي أو كلي للإحساس في جزء من الجسم؛ عَرَض لتلف الأعصاب أو خلل وظيفي)",
 "しびれぐすり": "مُخَدِّر, بَنْج",
 "しびれなまず": "رعاد, سلور كهربائي (سلور مياه عذبة في النيل ووسط أفريقيا الاستوائية يمتلك عضواً كهربائياً)",
 "しびれる": "وَخَزَ (الطعن بآلة حادة بدون يكون نافذا ولا يكسر الجلد) / نَمِلَ\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟",
 "しびれエイ": "رعاد, سمك الرعاد (أي سمكة راي بطيئة الحركة تعيش في القاع من رتبة الطوربيدينيات ولها جسم مستدير وأعضاء كهربائية على كل جانب من الرأس قادرة على إصدار شحنات كهربائية قوية)",
 "しびれ感": "فتور, لامبالاة (سمة الافتقار للحماس أو الاهتمام بالأشياء عموماً) / تنميل, خدر (فقدان جزئي أو كلي للإحساس في جزء من الجسم؛ عَرَض لتلف الأعصاب أو خلل وظيفي)",
 "しびれ薬": "مُخَدِّر, بَنْج",
 "しびん": "قصرية, نونية سرير (وعاء ضحل يستخدمه المريض طريح الفراش للتغوط والتبول)",
 "しふ": "إشارة بصرية, إشارة مرئية (إشارة تتضمن تواصلاً بصرياً)",
 "しふく": "تطويبة / سعادة قصوى, طوبى (حالة من السعادة العارمة)\nمثال: التطويبة المفضلة لديها هي 'طوبى للودعاء لأنهم يرثون الأرض' / زي مدني, ملابس مدنية (الملابس العادية تمييزاً لها عن الزي الرسمي أو ملابس العمل أو الزي الديني) / اِزْدِهَار, رَخَاء",
 "しふくせんねん": "أَلْفِيَّة",
 "しふくせんねんせつ": "ألفية (الإيمان بالعقيدة المسيحية للألفية المذكورة في سفر الرؤيا)",
 "しふん": "مُسْتَحْضَرَاتُ التَّجْمِيل",
 "しぶ": "منطقة حضرية, منطقة مأهولة (منطقة جغرافية تشكّل مدينة أو بلدة) / فَرْع, غُصْن / لحاء ((علم النبات) نسيج يوصل المواد الغذائية المصنعة (مثل من الأوراق) إلى الأجزاء التي تحتاج إليها؛ يتكون أساسًا من الأنابيب الغربالية)",
 "しぶい": "مُقَلِص / زَاهِد, مُتَقَشِّف (يُمارِس حرمانًا ذاتيًّا شديدًا) / صَارِم, قَاسِي المَلَامِح (ذو هيئة أو سلوك صارم وجادّ؛ مُنفّر في المظهر) / تَقَشُّفِيّ, صَارِم (بسيط بشكل صارم وخالٍ من أيّ زخرفة) / حَامِض / بَخِيل (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ؛ شَحِيْح، مُقْتِر)\nمثال: بئس الرجل البخيل.",
 "しぶいかおをする": "عُبُوسة, عُبُوس / عَبَسَ, عَقَدَ حَاجِبَيْهُ",
 "しぶいろ": "حِنْطِيّ / قَمْحِيُّ اللَّوْن / اِسْمَرَّ / دَبَغَ (عالجه بمادة ليلين وَيَزُول مَا بِهِ من رُطُوبَة ونتن؛ دبغ الْمَطَر الأَرْض بمائه فَهُوَ دابغ ودبوغ وَالْمَفْعُول مدبوغ ودبيغ)",
 "しぶおんぷ": "سوداء, نوتة ربعية (نوتة موسيقية لها قيمة زمنية تعادل ربع نوتة كاملة)",
 "しぶがっしょう": "تناغم رباعي الأجزاء (تناغم يحتوي فيه كل كورد على أربع نغمات تخلق أربعة خطوط لحنية)",
 "しぶがっそう": "رباعي, كوارتيت (تأليف موسيقي لأربعة مؤديين) / رباعي, مجموعة رباعية (أربعة أشخاص يُنظر إليهم كوحدة واحدة) / رباعي (مجموعة من أربعة أشياء متشابهة تُعتبر كوحدة واحدة) / رباعي (أربعة مؤدين أو مغنين يؤدون معاً)\nمثال: انضم إلى رباعي غنائي",
 "しぶき": "مرذاذ (موزع يحول السائل (مثل العطر) إلى رذاذ ناعم) / غصن مزهر (تنسيق زهور يتكون من غصن واحد أو فرع يحمل أزهاراً وأوراقاً) / رذاذ (دفق من البخار أو قطرات السائل) / رذاذ, رشقة (كمية من الأجسام الصغيرة تتطاير في الهواء)\nمثال: رشقة من الرصاص",
 "しぶく": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "しぶさく": "رُبَاعِيَّة",
 "しぶしぶ": "بتردد, على مضض (مع تردد أو عدم رغبة)",
 "しぶちん": "بَخِيل, بَخِيلَة (الجمع : بُخَلاءُ ، المؤنث : بخيلة ، و الجمع للمؤنث : بخيلات و بُخَلاءُ؛ شَحِيْح، مُقْتِر)\nمثال: بئس الرجل البخيل.",
 "しぶつ": "مِلْكِيَّة خَاصَّة",
 "しぶつか": "استيلاء, مصادرة (فعل متعمد لاكتساب شيء ما، غالباً دون إذن المالك) / استيلاء, ضم (الدمج عن طريق الانضمام أو الاتحاد) / اعتماد مالي, مخصصات مالية (أموال مخصصة (كما من قبل هيئة تشريعية) لغرض محدد)\nمثال: تم الحصول على الأموال اللازمة من خلال استيلاء الحكومة على الوحدة التشغيلية للشركة",
 "しぶつら": "تجهم, تكشيرة (تعبير وجهي ملتوي)\nمثال: قامت بتجهم عند التفكير في الأمر",
 "しぶづら": "تجهم, تكشيرة (تعبير وجهي ملتوي)\nمثال: قامت بتجهم عند التفكير في الأمر",
 "しぶとい": "مُتَمَاسِك (ملتصق ببعضه ومتماسك) / حافظ, قوي الذاكرة (جيد في التذكر) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)\nمثال: عقل حافظ",
 "しぶみ": "تأثير قابض, قبض (القدرة على قبض أو تجميع أنسجة الجسم الرخوة لوقف تدفق الدم أو تقييد إفراز السوائل) / عفوصة, قابضية (طعم قابض حاد؛ تجربة التذوق عندما تسبب مادة ما انكماشاً في الفم)",
 "しぶや": "شِيبُويَا",
 "しぶる": "تَرَدَّدَ (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد. / تردد, تلكؤ (فعل التوقف بشكل غير مؤكد)\nمثال: كان هناك تردد في كلامه",
 "しぶん": "تربيع, تقسيم لأربعة (التقسيم إلى أربعة أجزاء متساوية) / إيواء (أماكن إقامة (خاصة تلك المخصصة للأفراد العسكريين)) / الربع (في الشعار) (شعار النبالة الذي يحتل ربع الدرع؛ عادة ما يمثل الجمع بين أربعة شعارات على درع واحد حالات التزاوج المختلط) / بريد ميت, رسالة مهملة (بريد لا يمكن تسليمه ولا إعادته) / حبر على ورق, قانون مهمل (حالة شيء فقد أهميته أو فعاليته) / أَدَب, أَدَبِيَّات (هو الظُرْف وحسن التَنَاوُل أو التَصَرُّف، أو هو مَلَكَة تعصم من كانت به عما يشينه؛ تطلق على المُسْتَظْرف من المعارف والعلوم)\nمثال: زيري يحب الأدب.",
 "しぶんい": "ربيع ((إحصاء) أي من النقاط الثلاث التي تقسم توزيعاً مرتباً إلى أربعة أجزاء يحتوي كل منها على ربع الدرجات)",
 "しぶんえん": "ربعية, مقياس الارتفاع (أداة قياس لقياس ارتفاع الأجرام السماوية) / ربع دائرة (المساحة المحصورة بين نصفي قطرين متعامدين لدائرة) / ربع (أي من المناطق الأربع التي ينقسم إليها المستوى بواسطة محوري إحداثيات متعامدين) / ربع دائرة (ربع محيط الدائرة)",
 "しぶんおんぷ": "سوداء, نوتة ربعية (نوتة موسيقية لها قيمة زمنية تعادل ربع نوتة كاملة)",
 "しぶんぎ": "ربعية, مقياس الارتفاع (أداة قياس لقياس ارتفاع الأجرام السماوية) / ربع دائرة (المساحة المحصورة بين نصفي قطرين متعامدين لدائرة) / ربع (أي من المناطق الأربع التي ينقسم إليها المستوى بواسطة محوري إحداثيات متعامدين) / ربع دائرة (ربع محيط الدائرة)",
 "しへい": "بنكنوت, نقود ورقية (عملة تصدرها حكومة أو بنك مركزي وتتكون من ورق مطبوع يمكن تداوله كبديل للنقود المعدنية)",
 "しへき": "إِدْمَان",
 "しへん": "جوار, جيرة (أشخاص يعيشون بالقرب من بعضهم البعض) / جوار, منطقة مجاورة (منطقة محيطة أو قريبة)\nمثال: إنه حي ودود / حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما. / الْمَزَامِير, الزَّبُور",
 "しへんけい": "رُبَاعِيّ الْأَضْلَاع / رُبَاعِيّ الْجَوَانِب",
 "しべ": "مِدَقَّة / سَدَاة",
 "しべつ": "حداد, فجيعة (حالة من الحزن على وفاة أو رحيل شخص محبوب)",
 "しべん": "تَكَهُّنٌ / مُضَارَبَة / دَفْع (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "しべんてき": "اسْتِفْهَامِيّ, مُتَسَائِل (يُظهِر الفضول والتساؤل) / تَصَوُّرِيّ, نَظَرِيّ (غير مبنيّ على حقائق أو تحقيق فعلي) / خَطِر, مُحْفُوفٌ بِالمَخَاطِر (غير آمن ماليًّا؛ ينطوي على مضاربة ومخاطرة عالية)",
 "しほ": "مطلق سراحه بشروط (شخص أُطلق سراحه تحت المراقبة أو بكفالة) / ممرضة متدربة (ممرضة قيد التدريب تخضع لفترة تجربة)",
 "しほう": "قضاء, منصب القاضي (منصب القاضي) / إقامة العدل, قضاء (فعل تطبيق العدالة وفقاً للقانون) / سلطة قضائية, قضاء (نظام المحاكم القانونية التي تدير العدالة وتشكل الفرع القضائي للحكومة) / محكمة, هيئة قضائية (جمعية (تضم قاضياً واحداً أو أكثر) لإجراء الأعمال القضائية) / مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط. / مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة. / فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي. / رِسَالَة خَاصَّة",
 "しほうかいぼう": "بِأَمْرِ المَحْكَمَة (صادِر بِأَمْرٍ مِن مَحْكَمَة قَضائِيَّة)",
 "しほうがき": "وَصْفَة",
 "しほうきかん": "السلطة القضائية (فرع حكومة الولايات المتحدة المسؤول عن إدارة العدالة)",
 "しほうけん": "قَضَاء / اِخْتِصَاص",
 "しほうしけん": "اختبار النقابة, امتحان المحاماة (امتحان يجرى على فترات منتظمة لتحديد ما إذا كان المرشح مؤهلاً لممارسة القانون في ولاية قضائية معينة)\nمثال: اجتاز امتحان النقابة في محاولته الثالثة",
 "しほうしょう": "وزارة العدل (الإدارة الفيدرالية الأمريكية المسؤولة عن إنفاذ القوانين الفيدرالية (بما في ذلك إنفاذ جميع تشريعات الحقوق المدنية)؛ أنشئت عام 1870)",
 "しほうしんさ": "مراجعة قضائية (مراجعة من قبل محكمة قانونية لإجراءات مسؤول حكومي أو هيئة أو شخص أو هيئة أخرى معينة قانونياً أو مراجعة محكمة استئناف لقرار محكمة ابتدائية)",
 "しほうじん": "شركة مساهمة خاصة, شركة مغلقة (شركة مملوكة لعدد قليل من الأشخاص؛ ليس لأسهمها سوق عام)",
 "しほうちょうかん": "نَائِب عَامّ",
 "しほうとりひき": "صفقة الإقرار بالذنب, مساومة قضائية ((القانون الجنائي) تفاوض يوافق فيه المدعى عليه على الاعتراف بالذنب في تهمة أقل وتوافق النيابة على إسقاط تهمة أكثر خطورة)\nمثال: اعترافه كان جزءاً من صفقة إقرار بالذنب مع المدعي العام",
 "しほうどうぶつ": "جوفمعوي, لاسع (حيوانات متناظرة شعاعياً لها أجسام تشبه الكيس بفتحة واحدة فقط ومجسات ذات هياكل لاسعة)",
 "しほうのば": "قَاعَةُ مَحْكَمَة, قَاعَةُ الْمَحْكَمَة",
 "しほうはんだん": "حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها)",
 "しほうぼうがい": "إعاقة العدالة, عرقلة سير العدالة (إعاقة أولئك الذين يسعون لتحقيق العدالة في المحكمة (مثل محاولة التأثير على المحلفين أو الشهود))",
 "しほこう": "خَشَب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر) / خَشَب!\nمثال: نحن نقطع الخشب.",
 "しほん": "أموال, موارد مالية (أصول في شكل مال) / أَرْبَعَة, أَرْبَع (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام.",
 "しほんか": "رَأْسُمَالِيّ (يفضل أو يمارس الرأسمالية) / رأسمالي (من أو يتعلق بالرأسمالية أو الرأسماليين) / رأسمالي (شخص يستثمر رأس المال في مشروع تجاري (خاصة المشاريع الكبيرة)) / رأسمالي (مدافع محافظ عن الرأسمالية)\nمثال: أمة رأسمالية",
 "しほんかんじょう": "حساب رأس المال ((في المالية) حساب لصافي قيمة شركة في تاريخ محدد) / حساب رأس المال ((في الاقتصاد) ذلك الجزء من ميزان المدفوعات الذي يسجل تدفق الأوراق المالية من وإلى الدولة)",
 "しほんきん": "رأس مال الأسهم (القيمة الدفترية للأسهم القائمة لشركة ما) / أسهم مصرح بها, رأس المال المصرح به (الحد الأقصى لعدد الأسهم المصرح بها بموجب شروط عقد تأسيس الشركة)",
 "しほんしじょう": "سُوق رَأْس الْمَال (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "しほんしゅ": "مُسْتَثْمِر, مُسْتَثْمِرَة",
 "しほんしゅぎ": "رَأْسْمَالِيَّة (الرَّسُمالبَّة : نظامٌ اقتصاديّ تكون فيه وسائل الانتاج مُلْكً لأَصحاب ِ الأَموال المُوَظَّفة؛ مجْموعُ الرَّأْسماايِّين أو البلدان الرَّأْسماليَّة)\nمثال: 共産主義が崩壊したことにより、今や資本主義が「世界を支配」しようとしているという非難を浴びている。 — بعد سقوط الشيوعية, الرأسماليون متهمون في محاولة \"السيطرة على العالم\".",
 "しほんしゅぎしゃ": "رَأْسُمَالِيّ (يفضل أو يمارس الرأسمالية) / رأسمالي (من أو يتعلق بالرأسمالية أو الرأسماليين) / رأسمالي (شخص يستثمر رأس المال في مشروع تجاري (خاصة المشاريع الكبيرة)) / رأسمالي (مدافع محافظ عن الرأسمالية)\nمثال: أمة رأسمالية",
 "しほんそんしつ": "خسارة رأسمالية (المبلغ الذي يتجاوز به سعر شراء الأصل سعر البيع؛ تتحقق الخسارة عند بيع الأصل)",
 "しほんぬし": "مُسْتَثْمِر, مُسْتَثْمِرَة",
 "しほんりとく": "أرباح رأسمالية, مكاسب رأسمالية (المبلغ الذي يتجاوز به سعر بيع الأصل سعر الشراء؛ يتحقق الربح عند بيع الأصل)",
 "しほんりとくぜい": "ضريبة الأرباح الرأسمالية (ضريبة تفرض على الأرباح الرأسمالية)\nمثال: لقد تجنب ضريبة الأرباح الرأسمالية عن طريق البيع على المكشوف",
 "しほんコスト": "تكلفة رأس المال (تكلفة الفرصة البديلة للأموال المستخدمة نتيجة لقرار استثماري؛ معدل العائد الذي يمكن أن تكسبه الشركة إذا اختارت استثماراً آخر بمخاطر معادلة)",
 "しぼ": "شَوْق (نزوعُ النَّفْس إِلى الشيء، أو تَعَلُّقها به؛ مصدر الفعل شَاقَ)\nمثال: سأشعر بالشوق إليك.",
 "しぼう": "أُمْنِيَّة / رَغْبَة / مُنْيَة / تَمَنَّى / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / سَمِين, بَدِين / دُهْن (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق) / شَحْم\nمثال: توم بدهن غرفته. / مِبْيَض, مَبِيض",
 "しぼうかた": "سِمْنَة, بَدَانَة",
 "しぼうかたしょう": "سِمْنَة, بَدَانَة",
 "しぼうかん": "كَبِد دُهْنِيّ",
 "しぼうきゅういん": "شفط الدهون (استئصال الشحم (خاصة لأغراض تجميلية) حيث يتم إزالة الأنسجة الدهنية الزائدة من تحت الجلد عن طريق الشفط)",
 "しぼうきゅういんほう": "شفط الدهون (استئصال الشحم (خاصة لأغراض تجميلية) حيث يتم إزالة الأنسجة الدهنية الزائدة من تحت الجلد عن طريق الشفط)",
 "しぼうきゅうふきん": "تعويض الوفاة, مخصص الوفاة (أموال تأمين أو معاش تقاعدي تدفع لمستفيد من المتوفى)",
 "しぼうこうこく": "نَعْي",
 "しぼうさいぼう": "خَلِيَّة دُهْنِيَّة",
 "しぼうさん": "حمض دهني (أي من فئة الأحماض الكربوكسيلية الأليفاتية الأحادية التي تشكل جزءاً من جزيء الدهون ويمكن اشتقاقها من الدهون عن طريق التحلل المائي)",
 "しぼうしつ": "دسم, دهني (يحتوي على أو يتكون من الدهون) / بدين, سمين (شخص مستدير الجسم)\nمثال: طعام دسم",
 "しぼうしゃ": "مَيِّت مَيْت, مُتَوَفًّى / مَرْحُوم / مُرَشَّح / مُرَشَّحَة",
 "しぼうしゅ": "ورم شحمي (ورم يتكون من نسيج دهني)",
 "しぼうしょう": "بدانة, وزن زائد (خاصية السمنة المفرطة)",
 "しぼうじこ": "إصابة مميتة, حادث مميت (حادث يتسبب في موت شخص ما)",
 "しぼうせん": "عَلَامَة تَمَدُّد, عَلَامَة مَطّ (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "しぼうそくせんしょう": "انصمام دهني (حالة خطيرة تسد فيها الدهون شرياناً؛ يمكن أن تدخل الدهون مجرى الدم بعد كسر عظم طويل أو في حالة إصابة الأنسجة الدهنية أو نتيجة للكبد الدهني)",
 "しぼうそしき": "دهن, شحم (نوع من أنسجة الجسم يحتوي على دهون مخزنة تعمل كمصدر للطاقة؛ كما أنه يوفر توسيداً وعزلاً للأعضاء الحيوية)\nمثال: حماهم النسيج الدهني من البرد القارس",
 "しぼうぞくかごうぶつ": "مركب أليفاتي (مركب عضوي يكون إما ألكان أو ألكين أو ألكاين أو مشتقاتها)",
 "しぼうにくしゅ": "ساركومة شحمية (ساركومة الخلايا الدهنية)",
 "しぼうぶとり": "سَمِين, بَدِين / دُهْن (طلى الشيء بالدهن أو الزيت أو الطيب؛ ضرب بالرفق) / شَحْم\nمثال: توم بدهن غرفته.",
 "しぼうべん": "إسهال دهني (وجود كميات أكبر من المعتاد من الدهون في البراز الذي يكون رغوياً وكريه الرائحة وطافياً؛ عَرَض لاضطرابات استقلاب الدهون ومتلازمة سوء الامتصاص)",
 "しぼうほけん": "تَأْمِين عَلَى اَلْحَيَاة",
 "しぼうほけんきん": "تعويض الوفاة, مخصص الوفاة (أموال تأمين أو معاش تقاعدي تدفع لمستفيد من المتوفى)",
 "しぼうほしょう": "تعويض الوفاة, مخصص الوفاة (أموال تأمين أو معاش تقاعدي تدفع لمستفيد من المتوفى)",
 "しぼうゆ": "زيت ثابت (زيت حيواني أو نباتي غير متطاير)",
 "しぼうりつ": "مُعَدَّل الوَفَيَات (نسبة الوفيات في منطقة ما إلى سكان تلك المنطقة؛ يُعبر عنها لكل 1000 في السنة)",
 "しぼち": "حديث العهد بالإيمان, موعوظ (معتنق جديد يتم تعليمه مبادئ المسيحية) / قادم جديد, مستجد (أي مشارك جديد في نشاط ما) / نبات دخيل حديث, نبات وافد (نبات موجود في منطقة لم يتم تسجيله فيها سابقاً)",
 "しぼつ": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "しぼつしゃ": "راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "しぼむ": "صَعَقَ",
 "しぼり": "ثقب, فتحة (فتحة من صنع الإنسان؛ عادة ما تكون صغيرة) / فتحة عدسة (جهاز يتحكم في كمية الضوء المسموح بدخولها) / فتحة (فتحة طبيعية في شيء ما) / انكماش, تقلص (عملية إنقاص (شيء ما) في الحجم أو الكثافة أو الكمية أو النطاق) / انقباض, تقلص عضلي ((فسيولوجيا) تقصير أو توتر جزء أو عضو (خاصة العضلة أو الألياف العضلية)) / إدغام, اختصار لفظي (كلمة تتكون من كلمتين أو أكثر عن طريق حذف أو دمج بعض الأصوات) / انضغاط, تقلص (عملية أو نتيجة أن يصبح الشيء أصغر أو مضغوطاً معاً)\nمثال: تقلص الغاز عند التبريد / عَصَرَ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "しぼりあげる": "عَصَرَ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر. / اِمْرَأَة سَلِيطَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ) / وَبَّخَ (التأنيب بشدة)\nمثال: أنا امرأة قوية. / سُلَالَة",
 "しぼりかす": "تفل الشعير, حبوب البيرة المستهلكة (بقايا الشعير والحبوب التي تبقى في وعاء الهرش بعد عملية الهرش والتصفية)\nمثال: تُستخدم الحبوب المستهلكة في أعلاف الحيوانات نظراً لأنها تتكون أساساً من الكربوهيدرات والبروتينات",
 "しぼりき": "عصّارة (مجفف ملابس يتكون من أسطوانتين يتم عصر الملابس المبللة بينهما)",
 "しぼりこみ": "تَكْرِير",
 "しぼりこむ": "عَصَرَ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "しぼりち": "النِّسْبَة البُؤْرِيَّة, رَقَم البُؤْرَة (نسبة البعد البؤري إلى قطر نظام عدسة (الكاميرا))",
 "しぼりとる": "مَأْثُرَة / اِسْتَغَلَّ / عَصَرَ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "しぼりべん": "دواسة الوقود, صمام الخانق (صمام ينظم إمداد المحرك بالوقود)",
 "しぼり器": "عصّارة (مجفف ملابس يتكون من أسطوانتين يتم عصر الملابس المبللة بينهما)",
 "しぼる": "عصر, لوي (عصر مع التواء)\nمثال: عصر القماش المبلل / عَصَرَ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر. / مَكْتَبَة شَخْصِيَّة / مَأْثُرَة / اِسْتَغَلَّ",
 "しま": "شريط, نطاق (زينة تتكون من شريط بلون أو مادة مغايرة) / تقليم, خط (علامة ضيقة بلون أو ملمس مختلف عن الخلفية) / صنف, طينة (نوع أو فئة (من الناس أو التوجهات)) / شارة الرتبة, شريط رتبة\nمثال: ضفدع أخضر بخطوط سوداء صغيرة / جَزِيرَة / جزيرة / فَرَضِيَّة, اِفْتِرَاض (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة) / تَخْمِين\nمثال: الحقائق تؤكد هذه الفرضية.",
 "しまあおじ": "درسة صفراء الصدر (شائع في روسيا وسيبيريا)",
 "しまあじ": "شَرْشِير صَيْفِيّ",
 "しまい": "أخت (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على امرأة لا يعرفها تأدبا وإن كانت غريبة عنه)\nمثال: ماري هي أخت توم / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "しまいかん": "سفينة شقيقة (سفينة هي واحدة من سفينتين أو أكثر متشابهة تم بناؤها في نفس الوقت)",
 "しまいこむ": "كنز مخفي, مخبأ (مخزون سري من الأشياء الثمينة أو المال)",
 "しまいご": "ذُو رَحِمٍ, مِنْ نَفْسِ الدَّمِ (مرتبط بصلة الدم) / ذُو أَصْلٍ لُغَوِيٍّ مُشْتَرَكٍ (ينتمي إلى نفس اللغة الأم) / مُتَقَارِبٌ فِي الطَّبِيعَةِ (مرتبط في الطبيعة والجوهر) / لفظ قريب, لفظ مشترك الأصل (تكون الكلمة قريبة لأخرى إذا كان كلاهما مشتقاً من نفس الكلمة في لغة الأسلاف)",
 "しまいせん": "سفينة شقيقة (سفينة هي واحدة من سفينتين أو أكثر متشابهة تم بناؤها في نفس الوقت)",
 "しまいに": "أخيراً, في الختام (كنتيجة نهائية لتتابع أو عملية) / في النهاية (في نهاية المطاف أو بعد فترة طويلة)\nمثال: في النهاية كان عليه الاستسلام",
 "しまいへん": "تكملة, جزء تالٍ (جزء يضاف إلى كتاب أو مسرحية يكملها ويوسعها) / تتمة, تكملة (شيء يتبع شيئاً آخر)",
 "しまい込む": "كنز مخفي, مخبأ (مخزون سري من الأشياء الثمينة أو المال)",
 "しまう": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب / اِحْتَفَظَ, أَبْقَى",
 "しまうちゅう": "مَجَرَّة (نجوم كثيرة لا تدرك بمجرد البصر، وعندما ينتشر ضوؤها فيُرى كأنه بقعة بيضاء (أي: مصادر ضوء كثيرة بحيث يبدو ضوئها كوهج بدلاً من أن يَبدو كل نجم واضحٍ…؛ باب السماء، وهي البياض الذي يَعبر السماء ويَقع بين النّسرَين (المقصود هنا هو مجرة دَرْب التّبانَة…)\nمثال: أنا بطل المجرة.",
 "しまうま": "حِمَار وَحْشِيّ, حِمَار وَحْشِيّ مُخَطَّط (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة)\nمثال: هن بحاجة لحمار.",
 "しまえなが": "قُرْقُف طَوِيل الذِّيل",
 "しまおくそく": "تَكَهُّنٌ / مُضَارَبَة",
 "しまかんぎく": "أُقْحُوَان",
 "しまく": "أَحَاطَ, حَفَّ (بالشيء: استدار حوله بجوانبه؛ بالشيء علما: علم منه كل جوانبه) / هَبَّة",
 "しまくえん": "التهاب اللثة, مرض دواعم السن (مرض يهاجم اللثة والعظام حول الأسنان)",
 "しまくとぅば": "لُغَة أُمّ, لُغَة قَوْمِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "しまぐにこんじょう": "انعزال, تقوقع (حالة العزلة أو الانفصال)\nمثال: حافظت القناة الإنجليزية على انعزال إنجلترا",
 "しまざい": "معجون أسنان, منظف أسنان (مادة لتنظيف الأسنان؛ توضع بفرشاة الأسنان)",
 "しましこく": "صَغِير المِقْيَاس (مبنيّ أو مرسوم على نطاق صغير) / صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة)",
 "しましま": "مُخَطَّط",
 "しまじま": "جَزِيرَة / جزيرة",
 "しまつ": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة. / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة / نَتِيجَة / اِقْتَصَدَ, اِدَّخَرَ",
 "しまつがわるい": "صَعْب",
 "しまつにおえない": "لَا يُمْكِنُ السَّيْطَرَةُ عَلَيْه, مُسْتَعْصٍ (غَيْرُ قَابِلٍ لِلسَّيْطَرَةِ أَوِ الإِدَارَة) / صعب المراس, مستعصٍ (يصعب التحكم فيه) / عَصِيّ عَلَى الحَلّ, لَا يُمْكِن السَّيْطَرَة عَلَيْه (صعب الحل أو التخفيف منه) / ثقيل, صعب الاستخدام (صعب الاستخدام أو التعامل معه أو إدارته بسبب الحجم أو الوزن أو الشكل)\nمثال: طفل صعب المراس",
 "しまながし": "نَفْي, تَبْعِيد / نَفَى",
 "しまね": "شِيمَانِه",
 "しまばえ": "ذبابة اللحم (ذبابة تتغذى يرقاتها على الجيف أو لحم الحيوانات الحية)",
 "しまびと": "جَزَرِيّ, جَزَرِيَّة",
 "しまめのう": "جَزْع (قَطَعَ الشَّيءَ؛ قَطَعَ النَّهْرَ عَرْضًا)",
 "しまらない": "فَضْفَاض, واسِع",
 "しまり": "إتمام, إكمال (إجراء ختامي أو نهائي) / إغلاق, إقفال (إنهاء العمليات) / اقتراب, تضييق المسافة (الاقتراب من وجهة معينة؛ تضييق الفجوة) / إغلاق (عملية إغلاق شيء ما)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية / ثَبَات / حذر, حرص (صفة كون المرء حذراً ومجتهداً) / حذر, حيطة (سمة كون المرء حذراً؛ الانتباه للخطر المحتمل)\nمثال: أعجبت بحرصه في عمله / نَتِيجَة",
 "しまりがない": "مسترخٍ, هادئ (بدون إجهاد أو قلق)\nمثال: أعطى انطباعاً بأنه مسترخٍ تماماً",
 "しまりが無い": "مسترخٍ, هادئ (بدون إجهاد أو قلق)\nمثال: أعطى انطباعاً بأنه مسترخٍ تماماً",
 "しまりす": "صيدناني (سنجاب أرضي يحفر الجحور من غرب أمريكا وآسيا؛ له جيوب خدية وشريط فاتح وداكن يمتد أسفل الجسم)",
 "しまりのない": "مُتَرَاخٍ, مُتَسَاهِل (يَفْتَقِر إِلَى الصَّرَامَة أَوِ الدِّقَّة) / بَطِيء الجَرَيَان (يسيل بسرعة ضئيلة كما عند تحوُّل المدّ) / فَضْفَاض, مُرْتَخٍ (غَيْرُ مَشْدُودٍ وَلَا مُتَوَتِّر) / الجزء المرتخي (حبل أو خيط أو كابل يتدلى باسترخاء)\nمثال: قام بسحب الجزء المرتخي",
 "しまる": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب / شَدَّ, ضَيَّقَ",
 "しまんちゅ": "جَزَرِيّ, جَزَرِيَّة",
 "しまクトゥバ": "لُغَة أُمّ, لُغَة قَوْمِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "しまスカンク": "ظربان مخطط (أكثر أنواع الظربان شيوعاً وانتشاراً في أمريكا الشمالية)",
 "しみ": "بُقْعَة",
 "しみじみ": "بحدة, بشدة (بطريقة حادة أو نافذة)\nمثال: كان مدركاً بحدة لعيوبه / بهدوء (برباطة جأش (خاصة في أوقات التوتر)) / برزانة, بهدوء ووقار (بطريقة رزينة وهادئة)\nمثال: تحدث بهدوء للطلاب المشاغبين / بتركيز, بثبات (بطريقة ثابتة ومركزة)\nمثال: حدق بي بثبات",
 "しみず": "مياه الينابيع (مياه من نبع طبيعي) / مياه جوفية (مياه تحت الأرض محتجزة في التربة وفي الصخور المنفذة)",
 "しみだし": "رشح, نزيز (عملية التسرب ببطء)",
 "しみだす": "رشح, نزيز (عملية التسرب ببطء) / حمأة, طين لزج (أي مادة سميكة ولزجة)",
 "しみったれ": "بُخْل (بَخِلَ :ضَنَّ بما عنده،أمسك ومنع؛ البُخْل:ضِدُّ الْكَرَم والْجُود)",
 "しみでる": "رشح, نزيز (عملية التسرب ببطء) / حمأة, طين لزج (أي مادة سميكة ولزجة)",
 "しみゃく": "مِهْمَاز",
 "しみょう": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "しみる": "اِبْتَلَّ / لَسَعَ / تَجَمَّدَ",
 "しみわたる": "اِخْتَرَقَ",
 "しみをつける": "لطخة, وصمة (فعل يجلب العار للشخص الذي يقوم به) / بقعة, تلطخ (عيب ناتج عن الأوساخ)\nمثال: أحدث لطخة كبيرة في سجله",
 "しみん": "مُوَاطِن, مُوَاطِنَة (مَدَنِيّ؛ مُقِيم) / سَاكِن, سَاكِنَة / مَدَنِيّ, مَدَنِيَّة\nمثال: أنا مواطن لبناني / بُرْجُوَازِيَّة / نَوْم عَمِيق (بكافة معانيه)\nمثال: لم أستطع النوم.",
 "しみんかいかん": "مركز مجتمعي, مركز مدني (مركز يمكن لأعضاء المجتمع التجمع فيه لممارسة أنشطة اجتماعية أو ثقافية)",
 "しみんかいきゅう": "طَبَقَة وُسْطَى",
 "しみんかんかく": "اَلْحِسّ السَّلِيم",
 "しみんぐん": "تَنْظِيم مُسَلَّح, جَمَاعَة مُسَلَّحَة",
 "しみんけん": "مُوَاطِنِيَّة, مُوَاطَنَة",
 "しみんしゃかい": "مُجْتَمَع مَدَنِيّ (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية)\nمثال: سامي خطر للمجتمع.",
 "しみんせい": "خامل, فاتر (يفتقر إلى اليقظة أو النشاط)\nمثال: أصبحت الضفادع خاملة مع أول ليالي البرد",
 "しみんせいのうえん": "التهاب الدماغ السباتي, مرض النوم (التهاب دماغ كان وبائياً بين عامي 1915 و1926؛ تشمل الأعراض شلل عضلة العين الخارجية وضعف عضلي شديد)",
 "しみんせんそう": "حَرْب أَهْلِيَّة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "しみんたいかい": "تَجَمُّع جَمَاهِيرِيّ, مَهْرَجَان خِطَابِيّ (تجمع كبير من الناس يهدف إلى إثارة الحماس)",
 "しみんてきふふくじゅう": "عِصْيان مَدَنيّ",
 "しみんほう": "القانون الروماني (المدونة القانونية لروما القديمة؛ دُونت في عهد جستنيان؛ وهي الأساس للعديد من الأنظمة الحديثة للقانون المدني) / قَانُون مَدَنِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "しみんセンター": "مركز مجتمعي, مركز مدني (مركز يمكن لأعضاء المجتمع التجمع فيه لممارسة أنشطة اجتماعية أو ثقافية) / مركز المدينة, وسط البلد (مركز المدينة (وغالباً ما يحتوي على المباني الحكومية والتجارية))",
 "しみ出し": "رشح, نزيز (عملية التسرب ببطء)",
 "しみ出す": "رشح, نزيز (عملية التسرب ببطء) / حمأة, طين لزج (أي مادة سميكة ولزجة)",
 "しみ出る": "رشح, نزيز (عملية التسرب ببطء) / حمأة, طين لزج (أي مادة سميكة ولزجة)",
 "しむ": "اِحْتَلَّ (الموضعَ: نزل به وكان لغيره قبله؛ الجيشُ البلدَ: فتحها ثم نزل بها غصبا عن أهلها وبلا رضاهم، استولى عليها)",
 "しむけ": "تَوْصِيل, تَسْلِيم / مَخَاض, وَضْع / إِلْقَاء (إِلْقَاءُ الشَّبَكَةِ فِي البَحْرِ : رَمْيُها؛ إِلْقاءُ مُحَاضَرَةٍ : إعْطَاؤُهُا، أَي الحَدِيثُ فِي مَوْضُوعٍ أَمَامَ جَمْهُورٍ)\nمثال: مروا بسرعة و بدون إلقاء نظرة.",
 "しむける": "أَغْوَى, أَغْرَى / أَغْرَى / مِقْبَض / أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "しめ": "إرساء, ربط السفينة (فعل تأمين سفينة واصلة بالحبال) / مَجْمُوع / نَتِيجَة / أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "しめあげる": "عَصَرَ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "しめい": "مُهِمَّة, مَأْمُورِيَّة / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف. / تسمية, تعيين (فعل وضع شخص في منصب غير انتخابي) / تسمية (الفعل اللفظي للتسمية)\nمثال: كان يجب الموافقة على التعيين من قبل اللجنة بأكملها / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟ / قِسْمَة, مَصِير (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب)\nمثال: الزواج قسمة و نصيب.",
 "しめいうんてんしゃ": "سائق مُعَيَّن, سائق مُكَلَّف (عضو في مجموعة يتم تعيينه للامتناع عن الكحول ليكون رصيناً عندما يحين وقت القيادة إلى المنزل)",
 "しめいかん": "حياء, شعور بالمسؤولية (وعي دافع بالمسؤولية الأخلاقية)",
 "しめいしゃ": "رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في الإسلام) من يبعثه الله تعالى بشَرْعٍ يعمل به ويبلغه)\nمثال: محمد رسول الله.",
 "しめいだしゃ": "ضارب مخصص (لاعب كرة يتم تعيينه للضرب بالمضرب بدلاً من رامي الكرة)",
 "しめいつうわ": "شخصاً لشخص, فرداً لفرد ((لشخصين) في لقاء مباشر) / مُبَاشِر, مِنْ شَخْصٍ لِآخَر (ينطوي على تواصل أو اتّصال مباشر بين الأشخاص)\nمثال: فضل تسوية الأمر فرداً لفرد",
 "しめいドライバー": "سائق مُعَيَّن, سائق مُكَلَّف (عضو في مجموعة يتم تعيينه للامتناع عن الكحول ليكون رصيناً عندما يحين وقت القيادة إلى المنزل)",
 "しめかす": "كُسْبَة, كُسْب",
 "しめかためる": "كثيف, متراص (متحد بشكل وثيق وثابت أو معبأ معاً) / جَامِع, مُلَخَّص (يُقَدِّمُ خُلَاصَةَ الشَّيْءِ بِإِيجَازٍ) / مَتِين البُنْيَة, مُمْتَلِئ الجِسْم (ذو بنية قصيرة وصلبة) / علبة بودرة, مضغوطة تجميل (علبة مستحضرات تجميل صغيرة بمرآة؛ لتحمل في حقيبة المرأة)\nمثال: تربة متراصة",
 "しめがね": "إِبْزِيم (حديدة الحزام)\nمثال: ذهبت لشراء إبزيم.",
 "しめきり": "أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري. / إتمام, إكمال (إجراء ختامي أو نهائي) / إغلاق, إقفال (إنهاء العمليات) / اقتراب, تضييق المسافة (الاقتراب من وجهة معينة؛ تضييق الفجوة) / إغلاق (عملية إغلاق شيء ما)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية / صندوق غاطس, قيسون (حجرة كبيرة مانعة لتسرب الماء تستخدم للبناء تحت الماء)",
 "しめきりび": "حد زمني, مهلة (فترة زمنية يجب خلالها إنجاز شيء ما أو إكماله)",
 "しめきる": "بمدى قريب, عن قرب (قريب جداً)\nمثال: بدون نظارة القراءة لا أستطيع رؤية الأشياء عن قرب / قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "しめぎ": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة.",
 "しめくくり": "نَتِيجَة / إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة)",
 "しめくくりをつける": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري.",
 "しめぐ": "مَشْبَك",
 "しめこ": "أَرْنَب (حيوان من فصيلة الثدييات مستأنس يربيه الناس من أجل لحومه وفرائه الناعم، ويربى أحيانًا كحيوان أليف)\nمثال: زيري لديه أرنب.",
 "しめし": "دَرْس, حِصَّة ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / عِبْرَة (الدَمْعَة قبل أن تفيض؛ المَشَاعِر العميقة الحزينة)\nمثال: أراك بعد الدرس. / وَحْي, تَنْزِيل (الإعلام في الخفاء، وهذا أصل الكلمة؛ الإلهام، سواء كان غريزيّ أو فطريّ أو فنيّ أو غيره وسواء كان من الله أو من غيره)\nمثال: يا رسول الله، كيف يأتيك الوحي ؟",
 "しめしあわす": "تَآمَرَ, اِئْتَمَرَ",
 "しめしあわせる": "تَآمَرَ, اِئْتَمَرَ",
 "しめしろ": "تَدَاخُل",
 "しめじめ": "بِتَبَلُّل, بِرُطُوبَة (بطريقة رطبة)\nمثال: كان هناك وشاح مربوط حول رأسها لكن الخصلة المتمردة هربت وتدلت برطوبة فوق عينها اليسرى / بِتَجَهُّم, بِكَآبَة (مع الكآبة)\nمثال: يتوقع الكثيرون مثل هذا التغيير بكآبة",
 "しめす": "تَظَاهَر, احْتَجَّ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب. / أَشَارَ / دَلَّ عَلَى, رَمَزَ إِلَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: بدل سامي ملابسه. / مُبْتَلّ / مَبْلُول, مُبْتَلّ",
 "しめだか": "مَجْمُوع / مَبْلَغ",
 "しめだし": "تبييض, فوز نظيف (هزيمة في لعبة يفشل فيها أحد الجانبين في التسجيل)",
 "しめだす": "حَانَة, بَار",
 "しめっぽい": "رُطُوبة / كَئِيب, مُوحِش",
 "しめつ": "اِنْقِرَاض",
 "しめつけ": "ضَغْط",
 "しめつける": "شَدَّ, ضَيَّقَ / عَصَرَ (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: صلى زيري العصر.",
 "しめて": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "しめひも": "مشروب مقوي, منشط (مقوي أو منشط (خاصة مشروب كحولي)) / حامي الساعد, واقي الذراع (غطاء واقٍ للمعصم أو الذراع يستخدم في الرماية والمبارزة ورياضات أخرى)",
 "しめび": "أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "しめやか": "جَادّ, صَادِق (يتّسم بإيمان ثابت وجادّ بأهمية الشيء ذاته) / رَزِين, وَقُور (يتّسم بالوقار والرصانة في الطبع والسلوك)",
 "しめやき": "بيسك, حساء القشطة البحرية (حساء كريمي كثيف مصنوع من المحار)",
 "しめり": "رطوبة, نداوة (بلل خفيف)",
 "しめりけ": "رُطُوبَة",
 "しめる": "خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته. / اِحْتَلَّ (الموضعَ: نزل به وكان لغيره قبله؛ الجيشُ البلدَ: فتحها ثم نزل بها غصبا عن أهلها وبلا رضاهم، استولى عليها) / كَسَبَ / تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل. / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا. / مَجْمُوع / اِقْتَصَدَ, اِدَّخَرَ / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب / مَجْمُوع / قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "しめん": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء. / قناع الموت (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "しめんたい": "رباعي السطوح, هرم ثلاثي (أي متعدد سطوح له أربعة أوجه مستوية)",
 "しも": "صَقِيع / صَقِيع, صَقْعَة / قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما. / بِرَاز, سَلْح / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / قَذِر, وَسِخ / وَسَّخَ (مادة غير نظيفة، خاصة عند ملامستها لملابس الشخص أو جلده أو ممتلكاته. في مثل هذه الحالة يقال أنها أصبحت مُتّسخة)\nمثال: أنت من وسخ الأرض.",
 "しもう": "شعيرة لاسعة (شعرة متعددة الخلايا في نباتات مثل القراص اللاسع تطرد سائلاً مهيجاً)",
 "しもがれ": "قَاتِم, كَئِيب (لا يبعث على الأمل إلّا قليلاً أو لا يبعث عليه أبداً) / جَرْدَاء, قَاحِلَة (لا توفِّر مأوى ولا قوتاً) / قَارِص, كَئِيب (بارد ورطب بشكل مُزعج)",
 "しもがれどき": "موسم ركود, موسم ميت (الموسم الميت هو فترة خلال العام يرغب فيها عدد قليل جدًا من الناس في شراء منتج أو خدمة معينة)\nمثال: عانى مقهى صديقي من موسم ميت بعد افتتاح ستاربكس في مكان قريب",
 "しもごえ": "سَمَّدَ ((سَمَدَ) يَسْمُدُ سُمُودًا: عَلاَ؛ (سَمَدَ): رفع رأْسه ونَصَبَ صَدرَه) / رَوْث, سَمَاد",
 "しもさか": "مُنْحَدِرًا, نَحْو الأَسْفَل (باتجاه أسفل التل) / فِي انْحِدَار, نَحْو الأَسْوَأ (نحو حالة أدنى أو أسوأ) / مُنْحَدِر, هَابِطٌ بِشِدَّة (يَنْحَدِرُ نَحْوَ الأَسْفَلِ بِحِدَّة) / تزلج الانحدار, سباق الانحدار (سباق تزلج أسفل منحدر)\nمثال: عند الجري نحو الأسفل، اكتسب الكثير من السرعة",
 "しもざま": "الطَّبَقَاتُ الدُّنْيَا",
 "しもしはんき": "التربيع الثاني, التربيع المتناقص",
 "しもじも": "عامة الناس, قوم (الناس بشكل عام (وغالباً ما تستخدم بصيغة الجمع))\nمثال: إنهم مجرد ناس ريفيين",
 "しもて": "رِجْل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / قَدَم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / قدم (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / رجل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء) / ريل\nمثال: هذا الرجل تاجر. / يمين المسرح (جزء المسرح الواقع على يمين الممثل عندما يواجه الجمهور)",
 "しもと": "سوط / وباء, بَلْوَى (المرض العام الذي ينتشر بين الناس)\nمثال: على السلطات أن توقف انتشار الوباء. / سليل (حفيد أو وريث)\nمثال: سليل أصل ملكي",
 "しもどけ": "أَذَابَ (فعل تعدي من ذَابَ بمعنى جعله يَذُوبُ) / ذَابَ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا فشيئًا، مثل ذوبان الجليد أو اختفاء الألم)\nمثال: ذاب ذلك الجليد.",
 "しもねた": "نُكْتَة بَذِيئَة (نكتة غير مهذبة)",
 "しものけ": "شَعْر اَلْعَانَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "しもばしら": "بلورة جليدية, رذاذ ثلجي (بلورات صغيرة من الجليد)",
 "しもふり": "خَلِيس / تجزع (تداخل الدهون واللحم في قطعة من اللحم)",
 "しもぶくれ": "مُسْتَدِير الوَجْه (ذو وجه مستدير)",
 "しもべ": "خَادِم, خَادِمَة / مع التيار (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "しもや": "سقيفة مائلة (مأوى بسيط له سقف منحدر واحد فقط)",
 "しもやけ": "تَثْلِيج, قَضْمَة صَقِيع",
 "しもゆ": "مغطس مقعدي (حوض استحمام تُغمر فيه الأرداف والوركين كما لو كنت جالساً على كرسي وتستحم في وضعية الجلوس)",
 "しもをおいた": "رَمَادِيّ, أَشْيَب",
 "しもん": "حضانة, رعاية (الاهتمام والإدارة بما ينطوي على مسؤولية السلامة) / دروس خصوصية, وصاية تعليمية (تدريس التلاميذ بشكل فردي (عادة بواسطة معلم خاص))\nمثال: هو في رعاية حارس شخصي / بَصْمَة / مُقَابَلَة / مُشَاوَرَة, اِسْتِشَارَة",
 "しもんおうなつ": "أخذ البصمات (إجراء أخذ انطباعات بالحبر لبصمات أصابع الشخص لغرض تحديد الهوية)",
 "しもんじ": "تهجئة بالأصابع (أبجدية من الإشارات اليدوية)",
 "しもチャ": "يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "しもネタ": "نُكْتَة بَذِيئَة (نكتة غير مهذبة)",
 "しゃ": "كُوخ, تَخْشِيبَة / بنزيون, نزل داخلي (منزل خاص يوفر الإقامة والوجبات للضيوف مقابل أجر) / شَاش / سَرِيَّة / شَرِكَة / ضَرِيح / كرش (مصطلحات عامية للكرش أو البطن البارز) / شركة مساهمة, مؤسسة (شركة تجارية تمت الموافقة على مواد تأسيسها في ولاية ما) / مَائِل, قُطْرِيّ / أُقْنُوم / فَرْد / خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / رِمَايَة / رسم الخرائط الجينية ((علم الوراثة) عملية تحديد مواقع الجينات على الكروموسوم) / تَابِع رِيَاضِيّ, دَالَّة ((الرياضيات) علاقة رياضية بحيث يرتبط كل عنصر من مجموعة معينة (مجال الدالة) بعنصر من مجموعة أخرى (مدى الدالة)) / رسم الخرائط (عملية صنع الخرائط)\nمثال: رسم خرائط مفصل لبنية الصخور / خَرِيطَة (الخَارِطَة، رسم عليه تضاريس الأرض وحدودها)\nمثال: انظر إلى الخريطة. / سَيَّارَة, عَرَبِيَّة (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة. / إِبْرَاء, إِعْفَاء / عَفْو, صَفْح / عَفَا (عَفَا شَعَرُ البَعِيرِ: كَثُرَ، وطَالَ فَغَطَّى دُبُرَهُ؛ عَفَا أثَرُهُ عفاءً: هَلَكَ) / عَفْواً!, مَاذَا قُلْتَ؟ / صَبْر, تساوي ((صَبَرَ) يَصْبِرُ صَبْرًا: تجلَّد ولم يَجْزَع؛ (صَبَرَ): انتظر في هدوء واطمئنان)\nمثال: الصبر أم العلوم.",
 "しゃあしゃあ": "بلا خجل, بوقاحة (بدون خجل)\nمثال: تخلى بلا خجل عن المشروع",
 "しゃあない": "لَا مَفَرّ, لَا أَسْتَطِيع ذٰلِك (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "しゃあなし": "لَا مَفَرّ, لَا أَسْتَطِيع ذٰلِك (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "しゃい": "شُكْر, اِمْتِنَان ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته. / اِعْتِذَار, عُذْر / دِفَاع, تَبْرِير",
 "しゃえい": "مسكن عسكري (سكن للأفراد العسكريين (خاصة في منزل خاص)) / رسالة قصيرة, ملاحظة (رسالة شخصية قصيرة)\nمثال: اكتب لي رسالة قصيرة عندما تصل هناك / إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "しゃおん": "شُكْر, اِمْتِنَان ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته. / عَازِل لِلصَّوْت (لا ينفذ منه الصوت)",
 "しゃおんへき": "حاجز الصوت (الزيادة في الكبح الديناميكي الهوائي (مقاومة الهواء) عندما تقترب الطائرة من سرعة الصوت)",
 "しゃか": "تَنْفِيس",
 "しゃかい": "مُجْتَمَع, جَمَاعَة (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية) / جَمْعِيَّة (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع) / اِجْتِمَاعِيَّة\nمثال: سامي خطر للمجتمع.",
 "しゃかいうんどう": "جبهة, حركة (مجموعة من الناس لديهم أيديولوجية مشتركة يحاولون معاً تحقيق أهداف عامة معينة)\nمثال: كان عضواً مؤسساً في الحركة",
 "しゃかいか": "تطبع اجتماعي, تنشئة اجتماعية (تبني أنماط سلوك الثقافة المحيطة) / تَوَاصُل اِجْتِمَاعِيّ, مُخَالَطَة اِجْتِمَاعِيَّة (فعل الاجتماع لأغراض اجتماعية) / تَطْبِيق الاِشْتِرَاكِيَّة (فعل التأسيس على أساس اشتراكي)\nمثال: التنشئة الاجتماعية للأطفال وفقاً لمعايير ثقافتهم",
 "しゃかいかいきゅう": "طبقة, طبقة اجتماعية (مجموعة من الناس لديهم نفس الوضع الاجتماعي أو الاقتصادي أو التعليمي)\nمثال: الطبقة العاملة",
 "しゃかいかいそう": "طبقة, طبقة اجتماعية (مجموعة من الناس لديهم نفس الوضع الاجتماعي أو الاقتصادي أو التعليمي)\nمثال: الطبقة العاملة",
 "しゃかいかがく": "علم اجتماعي (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "しゃかいかけんがく": "رحلة ميدانية (رحلة جماعية (إلى متحف أو غابة أو مكان تاريخي) للفحص المباشر)",
 "しゃかいかつどう": "نَشَاط اِجْتِمَاعِيّ (نشاط يعتبر مناسباً في المناسبات الاجتماعية)",
 "しゃかいがく": "عِلْم الْمُجْتَمَع (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "しゃかいがくしゃ": "عالم اجتماع (عالم اجتماعي يدرس مؤسسات المجتمع البشري وتطوره)",
 "しゃかいきょういくしせつ": "مركز مجتمعي, مركز مدني (مركز يمكن لأعضاء المجتمع التجمع فيه لممارسة أنشطة اجتماعية أو ثقافية)",
 "しゃかいきょうふしょう": "الرهاب الاجتماعي (أي رهاب (بخلاف رهاب الخلاء) يرتبط بمواقف تكون فيها عرضة لانتقاد الآخرين (مثل الخوف من الأكل في الأماكن العامة أو التحدث أمام الجمهور وغيرها))",
 "しゃかいきょりせんりゃく": "تباعد اجتماعي, تباعد جسدي (الحفاظ على مسافة آمنة بينك وبين الآخرين وتجنب الحشود لإبطاء انتشار الأمراض المعدية)\nمثال: لممارسة التباعد الاجتماعي، ابق على مسافة 6 أقدام على الأقل من الآخرين",
 "しゃかいけいやく": "عَقْد اِجْتِمَاعِيّ (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "しゃかいけんがく": "رحلة ميدانية (رحلة جماعية (إلى متحف أو غابة أو مكان تاريخي) للفحص المباشر)",
 "しゃかいげんごがく": "لِسَانِيَّات اِجْتِمَاعِيَّة",
 "しゃかいこうぞう": "بنية اجتماعية, تنظيم اجتماعي (الناس في مجتمع يُنظر إليهم كنظام منظم بنمط مميز من العلاقات)\nمثال: التنظيمات الاجتماعية في إنجلترا وأمريكا مختلفة جداً",
 "しゃかいしゅうだん": "جَمَاعَة اجْتِمَاعِيَّة, فِئَة اجْتِمَاعِيَّة (أشخاص تجمعهم علاقة اجتماعيّة مشتركة)",
 "しゃかいしゅぎ": "اِشْتِرَاكِيَّة",
 "しゃかいしゅぎけいざい": "اشتراكية, اقتصاد اشتراكي (نظام اقتصادي يقوم على ملكية الدولة لرأس المال)",
 "しゃかいしゅぎしゃ": "اِشْتِرَاكِيّ / اِشْتِرَاكِيّ, اِشْتِرَاكِيَّة",
 "しゃかいしゅぎリアリズム": "الواقعية الاشتراكية (أسلوب من الفن الواقعي تم تطويره في الاتحاد السوفيتي وأصبح أسلوباً سائداً في البلدان الاشتراكية الأخرى)\nمثال: كانت الواقعية الاشتراكية في ثلاثينيات القرن العشرين جزءاً من نظام أكبر للخطاب السلطوي تم تطويره من خلال تبادل تفاعلي بين القادة ومؤيديهم",
 "しゃかいしょかがく": "علم اجتماعي (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "しゃかいしんりがく": "علم النفس الاجتماعي (فرع علم النفس الذي يدرس الأشخاص وعلاقاتهم مع الآخرين ومع المجموعات ومع المجتمع ككل)",
 "しゃかいじぎょう": "خِدْمَة اجْتِمَاعِيَّة",
 "しゃかいじっけん": "تجربة ميدانية (اختبار لأداء منتج جديد في ظل الظروف التي سيستخدم فيها)",
 "しゃかいじゆうしゅぎ": "ليبرالية اجتماعية (أيديولوجية سياسية تسعى لإيجاد توازن بين الحرية الفردية والعدالة الاجتماعية)",
 "しゃかいじん": "كَامِل الأَهْلِيَّة, مُكْتَمِل ((عن الأشخاص) حاز على مكانة أو صفة كاملة) / مُكْتَمِل الرِّيش, نَاضِج ((عن الطائر) بلغ النمو الكامل بريش بالغ مكتمل؛ جاهز للطيران)",
 "しゃかいじんるいがく": "أنثروبولوجيا اجتماعية, أنثروبولوجيا ثقافية (فرع الأنثروبولوجيا الذي يتعامل مع الثقافة والمجتمع البشري)",
 "しゃかいじんサークル": "عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / نَادٍ لَيْلِيّ, اَلنَّادِي اَللَّيْلِيّ / سِبَاتِي\nمثال: لا تمسك العصا من الوسط.",
 "しゃかいせい": "اجتماعية (الميل للاختلاط بالآخرين وتكوين مجموعات اجتماعية)\nمثال: الثدييات كفئة ليست قوية في الاجتماعيات",
 "しゃかいせいこんちゅう": "حشرة اجتماعية (حشرة تعيش في مستعمرة مع حشرات أخرى من نفس النوع)",
 "しゃかいせいさく": "سياسة اجتماعية (سياسة للتعامل مع القضايا الاجتماعية)",
 "しゃかいせいど": "بنية اجتماعية, تنظيم اجتماعي (الناس في مجتمع يُنظر إليهم كنظام منظم بنمط مميز من العلاقات)\nمثال: التنظيمات الاجتماعية في إنجلترا وأمريكا مختلفة جداً",
 "しゃかいせいぶつがく": "بيولوجيا اجتماعية (فرع علم الأحياء الذي يجري دراسات مقارنة للتنظيم الاجتماعي للحيوانات (بما في ذلك البشر))",
 "しゃかいそしき": "بنية اجتماعية, تنظيم اجتماعي (الناس في مجتمع يُنظر إليهم كنظام منظم بنمط مميز من العلاقات)\nمثال: التنظيمات الاجتماعية في إنجلترا وأمريكا مختلفة جداً",
 "しゃかいたいせい": "بنية اجتماعية, تنظيم اجتماعي (الناس في مجتمع يُنظر إليهم كنظام منظم بنمط مميز من العلاقات)\nمثال: التنظيمات الاجتماعية في إنجلترا وأمريكا مختلفة جداً",
 "しゃかいてき": "مُجْتَمَعِيّ, اِجْتِمَاعِيّ\nمثال: 彼は近所の人々より社会的に一段上だ。 — هو أفضل من جيرانه.",
 "しゃかいてきちい": "رتبة, مكانة اجتماعية (الموقع في تسلسل هرمي اجتماعي)\nمثال: البريطانيون أكثر وعياً بالمكانة الاجتماعية من الأمريكيين",
 "しゃかいてきステータス": "رتبة, مكانة اجتماعية (الموقع في تسلسل هرمي اجتماعي)\nمثال: البريطانيون أكثر وعياً بالمكانة الاجتماعية من الأمريكيين",
 "しゃかいてきネットワーク": "شَبَكَة اِجْتِمَاعِيَّة",
 "しゃかいとう": "الحزب الاشتراكي (حزب سياسي في الولايات المتحدة تشكل عام 1900 للدعوة إلى الاشتراكية)",
 "しゃかいとうせい": "رقابة اجتماعية, ضبط اجتماعي (السيطرة التي تمارس (بشكل نشط أو سلبي) عن طريق العمل الجماعي)",
 "しゃかいのまど": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة.",
 "しゃかいびょうしつしゃ": "سِيكُوباتِيّ, مُعْتَلّ اجْتِماعِيّاً (شخص ذو شخصية معادية للمجتمع)",
 "しゃかいふあんしょうがい": "حَزِين, زعلان / مُحْزِنٌ",
 "しゃかいふくし": "رعاية اجتماعية, رفاه اجتماعي (توفير حكومي للمساعدة الاقتصادية للأشخاص المحتاجين)\nمثال: هي تعيش على الإعانة الاجتماعية",
 "しゃかいふくしじぎょう": "خدمة اجتماعية, عمل خيري (نشاط منظم لتحسين ظروف المحرومين في المجتمع)",
 "しゃかいふじょ": "إعانة تكميلية, مساعدة اجتماعية (مزايا تُدفع لرفع الدخل إلى الحد الأدنى للمستويات التي يحددها القانون)",
 "しゃかいふっき": "إِعَادَةُ تَأْهِيل",
 "しゃかいふてきおうしゃ": "شاذ, غير متكيف (شخص غير قادر على التكيف مع ظروفه)",
 "しゃかいふてきごうしゃ": "شاذ, غير متكيف (شخص غير قادر على التكيف مع ظروفه)",
 "しゃかいぶ": "قسم الأخبار المحلية (قسم التحرير في صحيفة الذي يحرر الأخبار المحلية)",
 "しゃかいほうげん": "لهجة اجتماعية (طَرَفُ ٱللِّسَانِ؛ جَرْسُ ٱلْكَلَامِ)\nمثال: الشاوية هي لهجة للأمازيغية.",
 "しゃかいほけん": "تأمين اجتماعي (مخصصات حكومية للعاطلين عن العمل، المصابين، أو كبار السن؛ تُمول من مساهمات أصحاب العمل والموظفين وكذلك من الإيرادات الحكومية)",
 "しゃかいほしょう": "ضمان اجتماعي (برنامج رعاية اجتماعية في الولايات المتحدة؛ يشمل تأمين الشيخوخة والورثة وبعض تأمينات البطالة ومساعدات كبار السن)",
 "しゃかいほしょうばんごう": "رقم الضمان الاجتماعي (رقم حساب الضمان الاجتماعي لفرد معين)",
 "しゃかいみんしゅしゅぎ": "الديمقراطية الاجتماعية",
 "しゃかいみんしゅとう": "الحزب الديمقراطي الاجتماعي (حزب سياسي في ألمانيا وبريطانيا (وغيرها) تأسس في أواخر القرن التاسع عشر؛ كان ماركسياً في الأصل؛ ويدعو الآن إلى التحول التدريجي للرأسمالية إلى اشتراكية…)",
 "しゃかいシステム": "بنية اجتماعية, تنظيم اجتماعي (الناس في مجتمع يُنظر إليهم كنظام منظم بنمط مميز من العلاقات)\nمثال: التنظيمات الاجتماعية في إنجلترا وأمريكا مختلفة جداً",
 "しゃかく": "زاوية مائلة (زاوية ليست قائمة وليست من مضاعفات الزاوية القائمة) / حالة غير الرفع (أي حالة نحوية غير حالة الرفع)",
 "しゃかくせい": "التواء, انحراف (صفة الميل وعدم الاستقامة في المسار) / انحراف, ميلان (خاصية عدم التوازي أو التعامد، بل التواجد بزاوية مائلة)",
 "しゃかっこう": "اِجْتَازَ, عَبَرَ",
 "しゃかつ": "مسمار المحور (مسمار يتم إدخاله عبر محور العجلة لتثبيت العجلة) / دعامة أساسية, ركيزة (مصدر دعم واستقرار مركزي ومتماسك)\nمثال: الإيمان هو ركيزته",
 "しゃかとう": "قِشْطَة صَدَفِيّة (طَبَقَة من السَمْن تطفو على الحَلِيب عند غليه، تُقْشَطُ عنه وتؤكل بالخبز أو يصنع منها أنواع أخرى من الطعام لا سيما الحلويات)",
 "しゃかやく": "مُلَيّن",
 "しゃかりきに": "بجنون, بهيجان (بطريقة لا يمكن كبحها)\nمثال: قاومت بجنون",
 "しゃかん": "جَصّاص, عامل جص (عامل ماهر في وضع الجص (الجبس) على الجدران)",
 "しゃが": "سوسن دموي",
 "しゃがく": "مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "しゃがみこむ": "صَغِير وَثَخِين / قُرْفُصَاء / جَثَمَ (وجَثَم فُلَانٌ بالأَرضَ يَجْثُم جُثومًا: لصِق بِهَا ولَزِمها؛ قَالَ النَّابِغَةُ يصِف رَكَبَ امرأَةٍ)",
 "しゃがみ込む": "صَغِير وَثَخِين / قُرْفُصَاء / جَثَمَ (وجَثَم فُلَانٌ بالأَرضَ يَجْثُم جُثومًا: لصِق بِهَا ولَزِمها؛ قَالَ النَّابِغَةُ يصِف رَكَبَ امرأَةٍ)",
 "しゃがむ": "صَغِير وَثَخِين / قُرْفُصَاء / جَثَمَ (وجَثَم فُلَانٌ بالأَرضَ يَجْثُم جُثومًا: لصِق بِهَا ولَزِمها؛ قَالَ النَّابِغَةُ يصِف رَكَبَ امرأَةٍ)",
 "しゃがん": "حَجَر رَمْلِيّ (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر. / بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب) / تحديق بعينين مغلقتين جزئياً, حول (فعل النظر بعينين مغلقتين جزئياً) / حول (محاذاة غير طبيعية لإحدى العينين أو كلتيهما)",
 "しゃがんかく": "غمّاز, وماض (ضوء يضيء وينطفئ؛ يستخدم كإشارة أو لإرسال رسائل) / غطاء العين, غمامة (ساتر يتكون من رقعة جلدية مخيطة بجانب الرسن تمنع الحصان من رؤية ما هو موجود على الجانبين) / إشارة الانعطاف, غمّاز (ضوء وامض في مركبة بمحرك يشير إلى الاتجاه الذي توشك المركبة على الانعطاف إليه)",
 "しゃがんたい": "غمّاز, وماض (ضوء يضيء وينطفئ؛ يستخدم كإشارة أو لإرسال رسائل) / غطاء العين, غمامة (ساتر يتكون من رقعة جلدية مخيطة بجانب الرسن تمنع الحصان من رؤية ما هو موجود على الجانبين) / إشارة الانعطاف, غمّاز (ضوء وامض في مركبة بمحرك يشير إلى الاتجاه الذي توشك المركبة على الانعطاف إليه)",
 "しゃきしゃき": "حَادّ, مُقْتَضَب (قَصِيرٌ وَمُبَاشِرٌ؛ مُخْتَصَرٌ بِفَاعِلِيَّةٍ) / حَادّ, قَاطِع ((عَمَّا يُرَى أَوْ يُسْمَع) مُحَدَّد بِوُضُوح) / شَدِيدُ التَّجْعِيد, مُكَرَّش ((عَنِ الشَّعْرِ) ذُو تَجْعِيدَاتٍ صَغِيرَةٍ وَمُحْكَمَةٍ) / مُقَرْمَش, هَشّ (صَلْب وَطَازَج بِشَكْل مُسْتَحَبّ)",
 "しゃきっと": "بشكل حاد, بوضوح (بطريقة محددة بوضوح)\nمثال: كان النمط الجديد للفخار المينوي محدداً بوضوح / بشكل منعش, بصورة مبهجة (بطريقة جديدة وممتعة تبعث على الانشراح) / بإنعاش, بشكل منعش (بطريقة تزيل التعب وتعيد الحيوية)\nمثال: كانت متحررة من الخجل بشكل منعش / بِصَرَاحَة, بِصِدْق ((تستخدم للتأكيد وتعكس موقف المتحدث) من الصحيح بصدق أن)\nمثال: بصدق، أنا لا أصدق ذلك / بأناقة (بطريقة أنيقة)\nمثال: كانت ترتدي ملابس أنيقة جداً",
 "しゃきゅう": "كثيب, كثيب رملي (سلسلة من الرمال كونتها الرياح؛ توجد في الصحاري أو بالقرب من البحيرات والمحيطات)",
 "しゃきん": "تبر الذهب, غبار الذهب (الجزيئات والرقائق (وأحيانًا شذرات صغيرة) من الذهب التي يتم الحصول عليها في التعدين الغريني) / مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "しゃく": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون. / طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير. / إِزْعَاج / اِخْتِلَاج (الخَلْجُ: الجَذْبُ،واختلج شيء في صدري:احتكأ مع شك؛ أصل الاختلاج: الحركة والاضطراب) / مِغْرَفَة / بقدونس البقر, سرفيل بري (عشب ثنائي الحول خشن قائم من العالم القديم أدخل كعشب ضار في شرق أمريكا الشمالية) / اللوردات, النبلاء (أقران المملكة (اللوردات) يُعتبرون كمجموعة)",
 "しゃくい": "اللوردات, النبلاء (أقران المملكة (اللوردات) يُعتبرون كمجموعة)",
 "しゃくが": "عثة هندسية (عثة نحيلة الجسم عريضة الأجنحة تسمى يرقاتها الديدان القياسية)",
 "しゃくぎ": "تَفْسِير",
 "しゃくぎがく": "تَفْسِير",
 "しゃくこつどうみゃく": "شريان زندي (شريان كبير يتفرع من الشريان العضدي لتغذية عضلات الساعد والرسغ واليد)",
 "しゃくごう": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الدَّلَع (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "しゃくざい": "قَرْض, إِعَارَة",
 "しゃくしぎ": "كَرَوَان",
 "しゃくしじょうぎ": "صَارِم",
 "しゃくしな": "كُرُنْب صِينِيّ, بُوك تْشُوي",
 "しゃくしゃく": "على مهل, في وقت الفراغ (بطريقة غير متسرعة أو في الوقت المناسب) / مُسْتَرْسِل, هَادِئ (غير مُتعجّل ولا قسريّ)\nمثال: اقرأ الدليل في وقت فراغك",
 "しゃくし定規": "صَارِم",
 "しゃくし菜": "كُرُنْب صِينِيّ, بُوك تْشُوي",
 "しゃくじょうそう": "شبيه الغليون الهندي, عصارة الصنوبر",
 "しゃくすん": "دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "しゃくせん": "دَيْن (العِبَادَة والتَقْدِيْس؛ المَذْهَب) / دَيْن, قَرْض (العِبَادَة والتَقْدِيْس؛ المَذْهَب)\nمثال: الإسلام دين حق.",
 "しゃくぜん": "سَعِيد / فَرِح (سُرُور؛ اسم يطلق على الإناث) / مَحْظُوظ\nمثال: فرح فاضل كثيرا. / بَرَّاق, لَمَّاع (يَعْكِس الضَّوْء) / تلميع, صقل (عمل جعل الشيء أملساً ولامعاً عن طريق فركه أو تشميعة) / بَرَّاق, لَمَّاع (جُعل ناعماً ولامعاً كما لو بالحكّ؛ يعكس بريقاً أو توهجاً) / لَامِع, مُشْرِق (يتميز بجدارة استثنائية)\nمثال: وفر تلميع الأحذية عيشاً ضئيلاً / بَيِّن, مَلْحُوظ (يمكن رؤيته أو ملاحظته) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "しゃくたい": "قَرْض, إِعَارَة",
 "しゃくだい": "منبر القراءة, منصة إلقاء (مكتب أو حامل ذو سطح مائل يستخدم لحمل نص على الارتفاع المناسب للمحاضر)",
 "しゃくちけん": "عقد إيجار (عقد يمنح استخدام أو شغل الممتلكات خلال وقت محدد مقابل مبلغ محدد) / عين مؤجرة, مأجور (الممتلكات التي يتم تأجيرها أو إكراؤها) / مدة الإيجار, مدة العقد (الفترة الزمنية التي يكون خلالها عقد نقل الممتلكات إلى شخص ما ساري المفعول)",
 "しゃくとり": "دودة شبرية, دودة قياسة (يسروع صغير أملس له أرجل فقط في قطاعاته الأمامية والخلفية؛ معظمها يرقات لعث من عائلة الأرفية)",
 "しゃくとりむし": "دودة شبرية, دودة قياسة (يسروع صغير أملس له أرجل فقط في قطاعاته الأمامية والخلفية؛ معظمها يرقات لعث من عائلة الأرفية)",
 "しゃくど": "مقياس (أداة قياس لقياس وتوضيح كمية مثل سمك السلك أو كمية المطر وما إلى ذلك) / عيار, قُطْر داخلي (قُطر أنبوب أو ماسورة سلاح ناري) / سُمك, عيار (سُمك السلك) / اتساع السكة (المسافة بين قضيبي السكة الحديدية أو بين عجلات القطار) / طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "しゃくどういろ": "بُنِّيّ (هو لون ينتمي لمجموعة الألوان الحارة. وكلمة بني نسبة للبن (قهوة)) / أَسْمَر / أَسْمَر, سَمْرَاء\nمثال: توم من بني البشر.",
 "しゃくどく": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "しゃくなげ": "رودودندرون, وردية الشجر (أي شجيرة من جنس رودودندرون: شجيرات دائمة الخضرة أو أشجار شجيرية صغيرة ذات أوراق جلدية وعناقيد مبهرجة من الزهور الجريسية (على شكل جرس))",
 "しゃくにさわる": "أَزْعَجَ",
 "しゃくにゅう": "قَرْض, إِعَارَة",
 "しゃくにゅうひよう": "تكلفة الاقتراض (تكلفة اقتراض شيء ما)",
 "しゃくに障る": "أَزْعَجَ",
 "しゃくねつ": "احمرار, توهج (حرارة أو لون النار) / احتراق, حرق (عملية حرق شيء ما) / حرق (شكل من أشكال التعذيب تستخدم فيه السجائر أو السيجار أو أدوات ساخنة أخرى لحرق جلد الضحية) / حرق, حرق على الخازوق (الإعدام بالنار) / صعق كهربائي (الإعدام بالكهرباء)\nمثال: حرق الأوراق كان ممنوعاً بموجب مرسوم المدينة",
 "しゃくのたね": "شوكة, مصدر إزعاج (شيء يسبب التهيج والانزعاج)\nمثال: إنه شوكة في حلقي",
 "しゃくの種": "شوكة, مصدر إزعاج (شيء يسبب التهيج والانزعاج)\nمثال: إنه شوكة في حلقي",
 "しゃくはち": "مَصّ قَضِيب, لَعْق قَضِيب (مَصَّ الرَّضِيعُ ثَدْيَ أُمِّهِ: رَضَعَ؛ مَصَّ العَصِيرَ: رَشَفَهُ رَشْفًا رَقِيقًا، جَذَبَهُ بِنَفَسِهِ)",
 "しゃくびょうし": "للسان الجرس, مصفق (مطرقة معدنية تتدلى داخل الجرس وتصدر صوتاً بضرب الجانب) / لسان (كتلة متحركة من الأنسجة العضلية مغطاة بغشاء مخاطي وتقع في التجويف الفموي) / مصفق (شخص يصفق)",
 "しゃくふ": "نادلة حانة (أنثى تعمل في حانة)",
 "しゃくほう": "أَطْلَقَ سَرَاح, حَرَّرَ",
 "しゃくめい": "تَفْسِير, شَرْح",
 "しゃくもん": "باحث, متسائل (يميل إلى التساؤل والبحث) / استعلام, استفسار (طلب معلومات)\nمثال: عقل متسائل (باحث)",
 "しゃくやにん": "مُسْتَأْجِر",
 "しゃくよう": "استعارة, اقتباس (الاستيلاء (على الأفكار أو الكلمات، إلخ) من مصدر آخر) / اقتراض (الحصول على أموال من مقرض)\nمثال: كان اقتباس الزخارف القديمة واضحاً جداً",
 "しゃくようご": "دَخِيل, لَفْظ دَخِيل",
 "しゃくようしゃ": "مُسْتَعِير, مُسْتَعِيرَة",
 "しゃくようしょ": "سند إذني, كمبيالة (وعد بدفع مبلغ محدد عند الطلب أو في وقت معين)\nمثال: كان علي توقيع سنده في البنك ككفيل",
 "しゃくようしょうしょ": "سند إذني, كمبيالة (وعد بدفع مبلغ محدد عند الطلب أو في وقت معين)\nمثال: كان علي توقيع سنده في البنك ككفيل",
 "しゃくりょう": "أُجْرَة, اِسْتَأْجَر / اِسْتَأْجَرَ / أجَّرَ (جزاء؛ هو المقابل المادّي الذي يتلقاه طرف أو أكثر نتيجة القيام بعمل) / خَرْق (شَقَّ الثوب والقماش وما أشبه)\nمثال: ركبت سيارة أجرة.",
 "しゃくる": "تَجَوَّفَ / مِغْرَفَة / رَعَشَة / يرتعش / يهز",
 "しゃくをとる": "قِيَاس / فَاصِلَة / إِجْرَاء / قَاسَ (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "しゃけ": "حُوت سُلَيْمَان, سَلَمُون (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟ / سلمون الكيتا (سلمون كبير من المحيط الهادئ ذو بقع صغيرة على ظهره؛ سمكة طعام مهمة)",
 "しゃけい": "تشنج الرقبة, صعر (حالة غير طبيعية يميل فيها الرأس إلى جانب واحد بسبب تقلص عضلات الرقبة على ذلك الجانب)",
 "しゃけつ": "فَصْد",
 "しゃげ": "تَنْفِيس",
 "しゃげい": "رِمَايَة",
 "しゃげき": "إطلاق نار (فعل إطلاق النار من بندقية) / إقالة, تسريح (إنهاء توظيف شخص ما (وتركه حراً للمغادرة)) / إشعال, إضرام (عملية إضرام النار في شيء ما) / إطلاق نار, رمي (فعل إطلاق الأسلحة أو المدفعية على عدو)\nمثال: تراجعوا في مواجهة نيران العدو الشديدة",
 "しゃげきじょう": "مَيْدَان رِمَايَة, سَاحَة رِمَايَة",
 "しゃげやく": "مُلَيّن",
 "しゃこ": "روبيان السرعوف (قشريات بحرية استوائية حفارة بزوائد إمساك كبيرة) / مُسْتَوْدَع, مِرْآب / مَرْأَب, وَرْشَة / دُرَّاج / حَجَل, قبج (طَائِرٌ مِنْ فَصيلَةِ التَّدْرُجِيَّاتِ، مِنْ رُتْبَةِ الدَّجاجِيّاتِ، رَمادِيُّ اللَّوْنِ، أَحْمَرُ المِنْقارِ والسَّاقَيْنِ…؛ حَجَلُ: الذَّكَرُ من القَبَجِ، الواحدةُ: حَجَلَةٌ)\nمثال: إن الإسم \"سكورة\" مشتق من كلمة \"تاسكورت\" الذي يعني حجلة بالأمازيغية. / محار عملاق (محار كبير يسكن الشعاب المرجانية في جنوب المحيط الهادئ ويزن ما يصل إلى 500 رطل)",
 "しゃこう": "تفاعل اجتماعي, تواصل (التواصل بين الأفراد) / تظليل, مزج (تدرج ينطوي على اختلافات صغيرة أو غير محسوسة بين الدرجات) / تظليل (علامات متدرجة تشير إلى الضوء أو المناطق المظللة في الرسم أو اللوحة) / ادعاء, تصنع (فعل إعطاء مظهر زائف) / حجة, ذريعة (مظهر مصطنع أو مقلد) / ادِّعَاء, تَظَاهُر (صفة زائفة أو لا يمكن دعمها) / تظاهر, لعب تخيلي (لعب فكري خيالي)\nمثال: كان امتثاله مجرد تظاهر / تَكَهُّنٌ / مُضَارَبَة / مُخَاتِل, مُضَلِّل (غَيْر مُبَاشِر بِالِانْحِرَاف عَنِ الطَّرِيق المَقْبُول أَوِ الصَّحِيح؛ مُضَلِّل) / مائل, منحرف (مائل أو منحرف في الاتجاه أو المسار أو الموضع - ليس متوازياً ولا متعامداً ولا قائم الزاوية) / منحرفة خارجية (عضلة بطنية مرتبة بشكل قطري على جانبي الجذع) / حالة غير الرفع (أي حالة نحوية غير حالة الرفع)\nمثال: أشعة الشمس الشتوية المائلة / مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات) / إِشْعَاع (انبعاث الطَّاقة وامتدادُها)",
 "しゃこうかい": "مُجْتَمَع رَاقِيّ (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية)\nمثال: سامي خطر للمجتمع.",
 "しゃこうけいやく": "عقد احتمالي, عقد الغرر (عقد يعتمد تنفيذه من قبل أحد الطرفين على وقوع حدث طارئ غير مؤكد (لكن إذا كان متوقفاً على نتيجة رهان فهو غير قابل للتنفيذ))",
 "しゃこうしつ": "صَالَة, قَاعَة (مكان فسيح في وسط المسكن يُوصِلُ إلى سائر الحجرات، الرُدْهَة؛ غُرْفَةُ المَعِيْشَة سواء كانت توصل إلى سائر الحجرات أم لا وسواء كانت فسيحة أم لا)\nمثال: حجزت الصالة يوم الخميس.",
 "しゃこうじょう": "حمامات معدنية, منتجع صحي (منتجع صحي يقع بالقرب من نبع أو عند شاطئ البحر)",
 "しゃこうじれい": "كلمات معسولة, همسات الحب (تعبيرات عاطفية غير مهمة المضمون)\nمثال: همس بكلمات معسولة في أذنها",
 "しゃこうせい": "ألفة, حب الاختلاط (الميل النسبي أو الاستعداد ليكون المرء اجتماعياً أو يختلط بأقرانه)",
 "しゃこうてき": "أَنِيس, اجْتِمَاعِيّ (وَدُودٌ وَلَطِيفٌ فِي المُعَامَلَةِ) / أليف, أنيس (يميل إلى الرفقة مع الآخرين أو يؤدي إليها) / تجمع اجتماعي, لقاء تعارفي (حفلة تجمع الناس لتعزيز الروابط الاجتماعية والنشاط الجماعي)\nمثال: مناسبة اجتماعية",
 "しゃこうば": "حمامات معدنية, منتجع صحي (منتجع صحي يقع بالقرب من نبع أو عند شاطئ البحر)",
 "しゃこうふあんしょうがい": "اِضْطِرَاب الْقَلَقِ الاِجْتِمَاعِي",
 "しゃこうふく": "ملابس رسمية, ملابس سهرة (ملابس تُرتدى في المناسبات الرسمية المسائية)",
 "しゃこうまく": "أَبَاجُور, عَاكِس النُّور",
 "しゃこうクラブ": "جمعية, رابطة (رابطة رسمية لأشخاص لديهم اهتمامات مماثلة)\nمثال: انضم إلى نادي الجولف",
 "しゃこうダンス": "رقص الصالونات (أي من مجموعة متنوعة من الرقصات الاجتماعية التي يؤديها الأزواج في قاعة الرقص)",
 "しゃこがい": "محار عملاق (محار كبير يسكن الشعاب المرجانية في جنوب المحيط الهادئ ويزن ما يصل إلى 500 رطل)",
 "しゃこく": "إِعْلَان, بَلَاغ",
 "しゃこばさぼてん": "صبار عيد الميلاد (صبار نباتي (هوائي) من أصل برازيلي يزرع على نطاق واسع كنبات منزلي له قطع مسطحة مفصلية وعادة أزهار وردية أرجوانية تتفتح في الشتاء)",
 "しゃこ貝": "محار عملاق (محار كبير يسكن الشعاب المرجانية في جنوب المحيط الهادئ ويزن ما يصل إلى 500 رطل)",
 "しゃごう": "اسم الشركة (الاسم الذي تُعرف به الشركة)",
 "しゃさい": "سند شركات (سند تصدره شركة؛ لا يحمل أي مطالبة بالملكية ولا يدفع أرباحاً ولكن مدفوعات حملة السندات لها الأولوية على مدفوعات المساهمين)\nمثال: سندات الشركات استثمار أكثر أماناً من الأسهم العادية في نفس الشركة",
 "しゃさいけん": "سند دين, سند مديونية (شهادة أو إيصال يقر بوجود دين) / سند دين, سند غير مضمون (قدرة العميل على الحصول على سلع أو خدمات قبل الدفع، بناءً على الثقة بأن الدفع سيتم في المستقبل)",
 "しゃさいけんしゃ": "حامل سندات (حامل سندات تصدرها حكومة أو شركة)",
 "しゃざい": "اِعْتِذَار, عُذْر / دِفَاع, تَبْرِير / مُسْهِلٌ قَوِيّ, مُنَقٍّ (شديد التأثير المُسْهِل) / تَطْهِيرِيّ, مُنَفِّس (يُطهِّر النفس من المشاعر المكبوتة (كما في الفنّ)) / عِلاجِيّ نَفْسِيّ (يَتَعَلَّق بِالعِلاج النَّفْسِيّ أو يُفيد فيه) / مسهل, ملين قوي (دواء مسهل؛ يحفز إخلاء الأمعاء)",
 "しゃし": "حول (محاذاة غير طبيعية لإحدى العينين أو كلتيهما) / رَفَاهِيَّة, تَرَف / تَرَف (تَرِفَ النَّبَاتُ، كفَرِح: تَرَوَّى؛ تَرِفَ النَّبَات تَرَفَا: كَثُرَ مَاؤُهُ ونَضُر) / كَمَالِيّ",
 "しゃしつ": "مَقْصُورَة / مَوْقِف",
 "しゃしゃ": "سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي. / أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "しゃしゃらくらく": "إِفْرَنْجِيّ",
 "しゃしゃりでる": "حَادِث إِصْطِدَام / اِنْهِيَار, اِنْهِيَار نِظَام (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل) / تَحَطَّمَ\nمثال: يوشك الجسر على الانهيار.",
 "しゃしゃり出る": "حَادِث إِصْطِدَام / اِنْهِيَار, اِنْهِيَار نِظَام (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل) / تَحَطَّمَ\nمثال: يوشك الجسر على الانهيار.",
 "しゃしゅ": "رَامٍ, الرَّامِي ((رَامَ) الجُرحُ يَرِيمُ رَيْمًا، ورَيَمَانًا: انْضَمَّ فَمُهُ للبُرْءِ؛ (رَامَ) الحِمْلُ: مالَ) / رَامٍ ((رَامَ) الجُرحُ يَرِيمُ رَيْمًا، ورَيَمَانًا: انْضَمَّ فَمُهُ للبُرْءِ؛ (رَامَ) الحِمْلُ: مالَ) / رَامِيَة",
 "しゃしゅつ": "رِمَايَة",
 "しゃしょう": "صُورَة / اِنْطِبَاع, سُمْعَة / تَجْرِيد, كِيَان مُجَرَّد (مفهوم عامّ يُستخلَص بانتزاع السمات المشتركة من أمثلة محدّدة) / انتزاع, سحب (عملية سحب أو إزالة شيء ما) / لوحة تجريدية (لوحة فنية تجريدية) / انشغال بال, ذهول (الانشغال بشيء ما واستبعاد كل شيء آخر) / قَائِدُ فِرْقَاتٍ مُوسِيقِيَّةٍ / كُمْسَرِيّ, كُمْسَارِيّ / مُوَصِّل كَهْرَبَائِيّ, مُوَصِّل",
 "しゃしょうしゃ": "عربة الطاقم, كابوز (عربة في قطار البضائع لاستخدام طاقم القطار؛ عادة ما تكون العربة الأخيرة في القطار) / مطبخ السفينة (منطقة إعداد الطعام على متن سفينة)",
 "しゃしょく": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع.",
 "しゃしん": "صُورَة, صُورَة شَمْسِيَّة / اِلْتَقَطَ صُورَة\nمثال: あなたに何枚かの写真を見せましょう。 — سأريك بعض الصور. / فيلم, فيلم سينمائي (شكل من أشكال الترفيه يجسد قصة بالصوت وتسلسل من الصور يعطي وهماً بالحركة المستمرة)\nمثال: ذهبوا لمشاهدة فيلم كل ليلة سبت",
 "しゃしんか": "مُصَوِّر, مُصَوِّرَة",
 "しゃしんかんぱん": "لوح جاف (طريقة تصوير سابقة استخدمت لوحاً زجاجياً مطلياً بمستحلب جيلاتيني حساس للضوء)",
 "しゃしんき": "كَمِرَة, كَامِيرَا",
 "しゃしんきしゃ": "مصور صحفي (صحفي يقدم القصة بشكل أساسي من خلال استخدام الصور الفوتوغرافية)",
 "しゃしんさつえい": "تَصْوِير, فُوتُوغْرَافِيَّا",
 "しゃしんし": "مُصَوِّر, مُصَوِّرَة",
 "しゃしんじゅつ": "تَصْوِير, فُوتُوغْرَافِيَّا",
 "しゃしんせいはん": "لوحة تظليل, نقش ضوئي (نقش يستخدم لإعادة إنتاج رسم توضيحي)",
 "しゃしんせきばん": "طباعة حجرية ضوئية, فوتو ليثوغرافيا (عملية طباعة مستوية تستخدم ألواحاً مصنوعة من صورة فوتوغرافية)",
 "しゃしんちょう": "ألبوم صور (ألبوم للصور الفوتوغرافية)",
 "しゃしんでんそう": "إبراق ضوئي, إرسال صور بالتلغراف (تقنية مبكرة لنقل النسخ المماثلة (الفاكس))\nمثال: وجه آيفز انتباهه بعد ذلك إلى التلفزيون، الذي اعتبره مجرد شكل مسرع من الإبراق الضوئي",
 "しゃしんにゅうざい": "مستحلب, مستحلب فوتوغرافي (طلاء حساس للضوء على الورق أو الفيلم؛ يتكون من حبيبات دقيقة من بروميد الفضة معلقة في جيلاتين)",
 "しゃしんのうど": "امتصاصية, كثافة ضوئية ((فيزياء) مقياس لمدى نقل المادة للضوء أو الإشعاع الكهرومغناطيسي الآخر)",
 "しゃしんはんていけっしょう": "نهاية متقاربة جداً, نهاية مصورة (بشكل عام، أي نهاية متقاربة جداً؛ وتحديداً، نهاية سباق يكون فيه المتسابقون قريبين جداً من بعضهم البعض بحيث يجب تحديد الفائز من صورة التقطت لحظة النهاية)",
 "しゃしんばん": "جهاز تصوير, فوتوستات (آلة نسخ تقوم بعمل نسخ موجبة أو سالبة سريعة مباشرة على سطح ورق محضر) / فوتوستات (نسخة مصورة مصنوعة على جهاز فوتوستات)",
 "しゃしんふくしゃき": "نَاسِخَة, نَاسِخَة ضَوْئِيَّة",
 "しゃしんや": "مُصَوِّر, مُصَوِّرَة",
 "しゃしんようし": "ورق تصوير (ورق حساس للضوء يمكن طباعة صورة فوتوغرافية عليه)",
 "しゃしんをうつす": "صُورَة, صُورَة شَمْسِيَّة / اِلْتَقَطَ صُورَة",
 "しゃしんをとる": "اِلْتَقَطَ صُورَةً",
 "しゃしんフィルム": "فيلم, فيلم فوتوغرافي (مادة فوتوغرافية تتكون من قاعدة من السيلولويد مغطاة بمستحلب فوتوغرافي؛ تستخدم لعمل السلبيات أو الشفافيات)",
 "しゃじ": "نسخ (فعل النسخ) / إِقْرَار, اعْتِرَاف (بيان يقر بشيء أو بشخص ما) / إقرار, اعتراف (حالة أو صفة كونه معترفاً به أو مقدراً)\nمثال: لا بد أنها رأته لكنها لم تبد أي علامة إقرار بذلك / اِعْتِذَار, عُذْر / دِفَاع, تَبْرِير / مِلْعَقَة, معلقة (أداة للأكل والاحتساء والطبخ وتقديم الطعام)",
 "しゃじく": "إكس, مِحْوَر (عمود تدور عليه العجلة)",
 "しゃじくそう": "نفل صغير, نفل مشكوك (نفل موطنه أيرلندا ذو أزهار مصفرة؛ غالباً ما يعتبر النفل الحقيقي أو الأصلي) / فصة ذئبية, فصة سوداء (عشب أوروبي مفترش ذو زهور صفراء صغيرة وقرون سوداء منحنية؛ تم توطينه في أمريكا الشمالية)",
 "しゃじくも": "عشب الحجر, كارا (أي من الطحالب المائية المغمورة المختلفة من جنس كارا لها عقد ذات فروع تشبه الخيوط؛ عادة ما تكون مغطاة برواسب كربونات الكالسيوم)",
 "しゃじくもるい": "عشب الحجر, كارا (أي من الطحالب المائية المغمورة المختلفة من جنس كارا لها عقد ذات فروع تشبه الخيوط؛ عادة ما تكون مغطاة برواسب كربونات الكالسيوم)",
 "しゃじしつ": "غرفة النسخ (غرفة في دير مخصصة لكتابة أو نسخ المخطوطات)",
 "しゃじつ": "بَرَاغْمَاتِيَّة, وَاقِعِيَّة (سمة قبول حقائق الحياة وتفضيل العملية والحقيقة الحرفية) / أفلاطونية, واقعية ((فلسفة) المذهب الفلسفي القائل بأن المفاهيم المجردة توجد مستقلة عن أسمائها) / واقعية, واقعية ساذجة ((فلسفة) المذهب الفلسفي القائل بأن الأشياء المادية تستمر في الوجود عندما لا يتم إدراكها) / الطبيعية, الواقعية (حركة فنية في فرنسا في القرن التاسع عشر؛ سعى الفنانون والكتاب للحصول على وصف واقعي وواقعي مفصل)",
 "しゃじつしゅぎ": "بَرَاغْمَاتِيَّة, وَاقِعِيَّة (سمة قبول حقائق الحياة وتفضيل العملية والحقيقة الحرفية) / أفلاطونية, واقعية ((فلسفة) المذهب الفلسفي القائل بأن المفاهيم المجردة توجد مستقلة عن أسمائها) / واقعية, واقعية ساذجة ((فلسفة) المذهب الفلسفي القائل بأن الأشياء المادية تستمر في الوجود عندما لا يتم إدراكها) / الطبيعية, الواقعية (حركة فنية في فرنسا في القرن التاسع عشر؛ سعى الفنانون والكتاب للحصول على وصف واقعي وواقعي مفصل)",
 "しゃじつしゅぎしゃ": "وَاقِعِيّ",
 "しゃじつせい": "بَرَاغْمَاتِيَّة, وَاقِعِيَّة (سمة قبول حقائق الحياة وتفضيل العملية والحقيقة الحرفية) / أفلاطونية, واقعية ((فلسفة) المذهب الفلسفي القائل بأن المفاهيم المجردة توجد مستقلة عن أسمائها) / واقعية, واقعية ساذجة ((فلسفة) المذهب الفلسفي القائل بأن الأشياء المادية تستمر في الوجود عندما لا يتم إدراكها) / الطبيعية, الواقعية (حركة فنية في فرنسا في القرن التاسع عشر؛ سعى الفنانون والكتاب للحصول على وصف واقعي وواقعي مفصل)",
 "しゃじつてき": "واقعي (مدرك أو يعبر عن إدراك للأشياء كما هي حقاً) / طَبِيعِيّ, وَاقِعِيّ (يمثل الواقع كما هو؛ ليس تجريدياً أو مثالياً) / واقعي (مكون من أو متعلق بالمذهب الفلسفي للواقعية)\nمثال: وصف واقعي",
 "しゃじゅく": "تخسيس, تنحيف (فقدان الوزن الزائد (عن طريق اتباع نظام غذائي مثلاً)؛ أن تصبح أنحف) / اختزال (أي عملية تضاف فيها إلكترونات إلى ذرة أو أيون (كما هو الحال عند إزالة الأكسجين أو إضافة الهيدروجين)؛ وتحدث دائماً مصحوبة بأكسدة العامل المختزل)\nمثال: أشرف طبيب على عملية تنحيفها",
 "しゃじゅつ": "رِمَايَة",
 "しゃじょう": "مَيْدَان رِمَايَة, سَاحَة رِمَايَة",
 "しゃじん": "خَادِم, خَادِمَة",
 "しゃす": "شَكَرَ ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته. / اِعْتَذَرَ, اِسْتَعْذَرَ / تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / تَقَيَّأَ, قَاءَ / تَقَيُّؤ",
 "しゃすい": "عزل الماء (فعل معالجة شيء ما لجعله طاردا للماء) / عزل مائي (طلاء قادر على جعل السطح مقاوماً للماء)",
 "しゃする": "شَكَرَ ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته. / اِعْتَذَرَ, اِسْتَعْذَرَ / تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / تَقَيَّأَ, قَاءَ / تَقَيُّؤ",
 "しゃせい": "رَسْم تَقْرِيبِيّ, رَسِيمَة (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / قَذْف (بمعنى رَمَى؛ قذَف بالحقّ: أمر به وأبانه)",
 "しゃせいかん": "قناة دافقة (جزء من القناة المنوية يتكون من القناة القادمة من الحويصلة المنوية والأسهر؛ تمر عبر غدة البروستاتا)",
 "しゃせいちょう": "دفتر رسم",
 "しゃせいぶん": "تشخيص, تصوير (وصف لفظي بياني أو حيوي)\nمثال: في كثير من الأحيان كانت الرواية تُقاطع بصور لفظية طويلة",
 "しゃせき": "حَصَاة",
 "しゃせつ": "تَحْرِيرِيّ / اِفْتِتاحِيّة, مَقَال اِفْتِتَاحِيّ",
 "しゃせん": "حارة مرورية, مسار (حارة في طريق رئيسي محددة بخطوط مرسومة)\nمثال: تلك السيارة في الحارة المرورية الخاطئة / خط النار (مسار قذيفة تطلق من سلاح ناري)",
 "しゃぜつ": "إِنْكَار, رَفْض",
 "しゃぜんそう": "لِسَان الْحَمَل, لِسَان الْخَرُوف (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق؛ جَارِحَة الْكَلَام؛ كَلِمَة)\nمثال: ماري لها فم ليس لها لسان.",
 "しゃそう": "نافذة السيارة (نافذة في السيارة) / خولنجان, سعد طويل (سعد أوروبي له أوراق خشنة الحواف وسنيبلات من زهور حمراء وجذور عطرية) / سعد الحمار, سعد مستدير (سعد معمر واسع الانتشار له درنات صغيرة صالحة للأكل تشبه الجوز)",
 "しゃぞう": "رسم الخرائط الجينية ((علم الوراثة) عملية تحديد مواقع الجينات على الكروموسوم) / تَابِع رِيَاضِيّ, دَالَّة ((الرياضيات) علاقة رياضية بحيث يرتبط كل عنصر من مجموعة معينة (مجال الدالة) بعنصر من مجموعة أخرى (مدى الدالة)) / رسم الخرائط (عملية صنع الخرائط)\nمثال: رسم خرائط مفصل لبنية الصخور",
 "しゃたい": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "しゃたく": "مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "しゃたん": "إِذَاعَة, مَحَطَّة إِذَاعِيَّة",
 "しゃだい": "شَاصِي, هَيْكَل",
 "しゃだつ": "مُتَطَوِّر, مُتَقَدِّم (متقدِّم في التطوُّر؛ معقَّد أو دقيق) / رَاقٍ, مُتَطَوِّر (جذاب فكريًّا ومتطور) / حنِك, راقٍ (يمتلك أو يجذب أولئك الذين لديهم معرفة دنيوية وتهذيب وكياسة)\nمثال: شبان اجتماعيون راقون",
 "しゃだん": "تَوَحُّد / كرش (مصطلحات عامية للكرش أو البطن البارز) / شركة مساهمة, مؤسسة (شركة تجارية تمت الموافقة على مواد تأسيسها في ولاية ما)",
 "しゃだんき": "حَاجِز / عَقَبَة, حَاجِز / قاطع الدائرة, قاطع كهربائي (جهاز يعمل مثل المفتاح ويفتح الدائرة عند التحميل الزائد)",
 "しゃだんぺき": "حاجز / جدار ساحلي",
 "しゃだんほうじん": "كرش (مصطلحات عامية للكرش أو البطن البارز) / شركة مساهمة, مؤسسة (شركة تجارية تمت الموافقة على مواد تأسيسها في ولاية ما)",
 "しゃだんやく": "خَصْم, عَدُوّ (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة) / غَرِيم, خَصْم",
 "しゃち": "حُوت قَاتِل (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟ / رحوية, ملفاف (رافعة تدور في مستوى أفقي حول محور عمودي؛ تستخدم على السفن لرفع المرساة أو الأشرعة الثقيلة) / زِرّ",
 "しゃちほこだち": "وقوف على الرأس (حركة بهلوانية يتوازن فيها الشخص على رأسه (عادةً بمساعدة اليدين))",
 "しゃちほこ立ち": "وقوف على الرأس (حركة بهلوانية يتوازن فيها الشخص على رأسه (عادةً بمساعدة اليدين))",
 "しゃちゅう": "فرقة, فرقة مسرحية (منظمة من المؤدين والموظفين المرتبطين بهم (خاصة المسرحية))\nمثال: أقامت الفرقة المتجولة كلها في نفس الفندق",
 "しゃちょう": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "しゃっかけんぶつ": "اِنْتِحال",
 "しゃっかにん": "مُسْتَأْجِر",
 "しゃっかん": "قَرْض, إِعَارَة",
 "しゃっきり": "بشكل حاد, بوضوح (بطريقة محددة بوضوح)\nمثال: كان النمط الجديد للفخار المينوي محدداً بوضوح / بشكل منعش, بصورة مبهجة (بطريقة جديدة وممتعة تبعث على الانشراح) / بإنعاش, بشكل منعش (بطريقة تزيل التعب وتعيد الحيوية)\nمثال: كانت متحررة من الخجل بشكل منعش / مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم.",
 "しゃっきん": "دَيْن (العِبَادَة والتَقْدِيْس؛ المَذْهَب) / دَيْن, قَرْض (العِبَادَة والتَقْدِيْس؛ المَذْهَب)\nمثال: الإسلام دين حق.",
 "しゃっきんのかた": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / جانبي, غير مباشر (منحدر من جد مشترك ولكن عبر خطوط مختلفة) / مُتَجَاوِر, مُتَوَازٍ جَنْبًا إِلَى جَنْب (يَقَعُ أَوْ يَمْتَدُّ جَنْبًا إِلَى جَنْب) / إِضَافِيّ ثَانَوِيّ, مُلْحَق (إضافيّ لكنّه ثانويّ؛ مساعد)\nمثال: أبناء العمومة هم أقارب جانبيون",
 "しゃっきんのカタ": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / جانبي, غير مباشر (منحدر من جد مشترك ولكن عبر خطوط مختلفة) / مُتَجَاوِر, مُتَوَازٍ جَنْبًا إِلَى جَنْب (يَقَعُ أَوْ يَمْتَدُّ جَنْبًا إِلَى جَنْب) / إِضَافِيّ ثَانَوِيّ, مُلْحَق (إضافيّ لكنّه ثانويّ؛ مساعد)\nمثال: أبناء العمومة هم أقارب جانبيون",
 "しゃっきんへんさい": "استرداد, سداد (عملية إعادة الأموال المستلمة سابقاً) / إبراء ذمة, تسديد (دفع دين أو التزام)",
 "しゃっくり": "حَازُوقَة / فُوَاق / فَوَاقَ",
 "しゃっこつ": "زِنْد (زَنَّدَ: أوْرَى زَنْدُه؛ زَنَّدَ كذَبَ)",
 "しゃっちょこだち": "وقوف على الرأس (حركة بهلوانية يتوازن فيها الشخص على رأسه (عادةً بمساعدة اليدين))",
 "しゃつき": "ذو عجلات, مُعجَّل (له عجلات؛ غالبًا ما تستخدم في المركبات)",
 "しゃつばら": "رَجُل (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "しゃつめ": "هُوَ",
 "しゃてい": "تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر) / مدى, قدرة / مَدَى",
 "しゃていきょり": "مدى, قدرة / مَدَى",
 "しゃてき": "تدريب الرماية (التدريب على إطلاق النار على أهداف)",
 "しゃてきじょう": "مَيْدَان رِمَايَة, سَاحَة رِمَايَة / صالة رماية (ميدان رماية مغلق به أهداف للتدرب بالبنادق أو المسدسات) / وكر تعاطي (مبنى (عادة مهجور) حيث يشتري مدمنو المخدرات الهيروين ويستخدمونه)",
 "しゃてきや": "صالة رماية (ميدان رماية مغلق به أهداف للتدرب بالبنادق أو المسدسات) / وكر تعاطي (مبنى (عادة مهجور) حيث يشتري مدمنو المخدرات الهيروين ويستخدمونه)",
 "しゃとうしょう": "رأس وارب (تشوه خلقي في الجمجمة حيث يكون المحور الرئيسي للجمجمة مائلاً)",
 "しゃど": "اِنْحِدَار, مَيْل (الخاصية التي يمتلكها خط أو سطح ينحرف عن الوضع الأفقي) / تَدَرُّج, مَيْل (تغير متدرج في حجم كمية فيزيائية أو بعد ما)\nمثال: منحدر بمقدار خمس درجات",
 "しゃどう": "طريق معبد, نهر الطريق (طريق (خاصة ذلك الجزء من الطريق) الذي تسير عليه المركبات)",
 "しゃなりしゃなり": "بِرَشَاقَة, بِلَبَاقَة",
 "しゃにかまえる": "فِرَاش, أَرِيكَة",
 "しゃにくさい": "كَرْنَفَال",
 "しゃにむに": "بإلحاح, بشكل عاجل (بإلحاح شديد) / باستماتة, بيأس (بيأس شديد)\nمثال: إصلاح الرعاية الصحية مطلوب بشكل عاجل",
 "しゃねつ": "عزل حراري (تقليل انتقال الحرارة بين الأجسام المتلامسة حرارياً أو في نطاق التأثير الإشعاعي)\nمثال: هناك عدد من المنتجات المتاحة المصممة لتحسين العزل الحراري للمنازل، بما في ذلك الزجاج الحراري مثل بلانيثيرم",
 "しゃのよう": "رَقِيقٌ كَالغَزْل, شَفَّاف (بَالِغُ الرِّقَّةِ بِحَيْثُ يَنْفُذُ مِنْهُ الضَّوْء)",
 "しゃはん": "هٰذِهِ, هٰؤُلَاءِ",
 "しゃば": "الْعَالَم الْحُرّ",
 "しゃばい": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / غير مُرضٍ (لا يبعث على الرضا)\nمثال: يجب أن تسترجع المتاجر البضائع غير المرضية",
 "しゃばちん": "أجرة الحافلة (الأجرة المفروضة لركوب حافلة أو ترام)",
 "しゃばふさぎ": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "しゃばふさげ": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "しゃふ": "شاذ, غير متكيف (شخص غير قادر على التكيف مع ظروفه)",
 "しゃぶる": "مَصَّة / مَصَّ, رَشَفَ (مَصَّ الرَّضِيعُ ثَدْيَ أُمِّهِ: رَضَعَ؛ مَصَّ العَصِيرَ: رَشَفَهُ رَشْفًا رَقِيقًا، جَذَبَهُ بِنَفَسِهِ)",
 "しゃへい": "حجب, درع (فعل الحجب عن الأذى) / تدريع إشعاعي, حجب (درع من الرصاص أو الخرسانة يهدف ليكون حاجزاً للإشعاع المنبعث في التحلل النووي) / تدريع, حجب كهرومغناطيسي (درع يتكون من ترتيب لشبكة معدنية أو صفائح مصممة لحماية المعدات الإلكترونية من التداخل الكهرومغناطيسي المحيط)",
 "しゃへいぶつ": "مَلَاذ (مَلْجَأ، مَأْوَى) / مَخْلَص (الشخص الذي يفي ولا يخون)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "しゃへん": "وَتَر, ضِلْع مُتَوَتِّر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس)",
 "しゃべくる": "هَذَى",
 "しゃべち": "تَمْيِيْز / تَفْرِيق / تَمْيِيز",
 "しゃべつ": "تَمْيِيْز / تَفْرِيق / تَمْيِيز",
 "しゃべり": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب.",
 "しゃべる": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب.",
 "しゃほ": "تأمين اجتماعي (مخصصات حكومية للعاطلين عن العمل، المصابين، أو كبار السن؛ تُمول من مساهمات أصحاب العمل والموظفين وكذلك من الإيرادات الحكومية)",
 "しゃほうけい": "مُعَيِّن",
 "しゃほうふっせき": "شابازيت (مجموعة معادن من عائلة الزيوليت تتكون من سيليكات مائية للكالسيوم والألومنيوم)",
 "しゃほん": "مَخْطُوطَة (مُؤَلَّف المكتوب باليد ، غير المطبوع؛ نُسْخة المؤلِّلف الأصليَّة المُعدَّة للطبع) / مَخْطُوطَة, مَخْطُوط (مُؤَلَّف المكتوب باليد ، غير المطبوع؛ نُسْخة المؤلِّلف الأصليَّة المُعدَّة للطبع)",
 "しゃぼんだま": "فُقَّاعَةُ صَابُون",
 "しゃぼん玉": "فُقَّاعَةُ صَابُون",
 "しゃまく": "سكريم, قماش شبكي خشن (قماش متماسك مفتوح النسج يستخدم كستارة في المسرح)",
 "しゃみ": "كِيمِيَاء (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما إلى الذهب؛ علم من علوم الطبيعة يتناول خواص العناصر والمركبات والقوانين التي تحكم تفاعلاتها) / كِيمِيَائِيّ, كِيمِيَاوِيّ\nمثال: هو يحب الكيمياء.",
 "しゃみせん": "شَامِيسِين",
 "しゃみつ": "كِيمِيَاء (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما إلى الذهب؛ علم من علوم الطبيعة يتناول خواص العناصر والمركبات والقوانين التي تحكم تفاعلاتها) / كِيمِيَائِيّ, كِيمِيَاوِيّ\nمثال: هو يحب الكيمياء.",
 "しゃみん": "الحزب الديمقراطي الاجتماعي (حزب سياسي في ألمانيا وبريطانيا (وغيرها) تأسس في أواخر القرن التاسع عشر؛ كان ماركسياً في الأصل؛ ويدعو الآن إلى التحول التدريجي للرأسمالية إلى اشتراكية…)",
 "しゃみんとう": "الحزب الديمقراطي الاجتماعي (حزب سياسي في ألمانيا وبريطانيا (وغيرها) تأسس في أواخر القرن التاسع عشر؛ كان ماركسياً في الأصل؛ ويدعو الآن إلى التحول التدريجي للرأسمالية إلى اشتراكية…)",
 "しゃめい": "اسم الشركة (الاسم الذي تُعرف به الشركة) / اسم تجاري, علامة تجارية (اسم يُعطى لمنتج أو خدمة)",
 "しゃめん": "إِبْرَاء, إِعْفَاء / عَفْو, صَفْح / عَفَا (عَفَا شَعَرُ البَعِيرِ: كَثُرَ، وطَالَ فَغَطَّى دُبُرَهُ؛ عَفَا أثَرُهُ عفاءً: هَلَكَ) / عَفْواً!, مَاذَا قُلْتَ؟ / مُنْحَدَر / مَيْل",
 "しゃめんじょう": "إِبْرَاء, إِعْفَاء / عَفْو, صَفْح / عَفَا (عَفَا شَعَرُ البَعِيرِ: كَثُرَ، وطَالَ فَغَطَّى دُبُرَهُ؛ عَفَا أثَرُهُ عفاءً: هَلَكَ) / عَفْواً!, مَاذَا قُلْتَ؟",
 "しゃもじ": "ملعقة خشبية (ملعقة مصنوعة من الخشب) / ملعقة خشبية (جائزة ترضية تتكون من ملعقة مصنوعة من الخشب)",
 "しゃもん": "باحث, متسائل (يميل إلى التساؤل والبحث) / استعلام, استفسار (طلب معلومات)\nمثال: عقل متسائل (باحث)",
 "しゃやく": "مُسْهِلٌ قَوِيّ, مُنَقٍّ (شديد التأثير المُسْهِل) / تَطْهِيرِيّ, مُنَفِّس (يُطهِّر النفس من المشاعر المكبوتة (كما في الفنّ)) / عِلاجِيّ نَفْسِيّ (يَتَعَلَّق بِالعِلاج النَّفْسِيّ أو يُفيد فيه) / مسهل, ملين قوي (دواء مسهل؛ يحفز إخلاء الأمعاء)",
 "しゃゆう": "شَرِيك, شَرِيكَة",
 "しゃよう": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "しゃら": "شَاؤُول, طَالُوت / شَاؤُول / سَوْل, شَاؤُول / سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق) / خَارِجِيّ, غَيْرُ جَوْهَرِيّ (لا يتعلق بالمسألة قيد البحث) / جَرِيءُ اللِّسَان, وَقِح (يتّسم بخفّة وقحة ومرح طافح) / طَازَج, طَازَة / عَذْب / دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "しゃらく": "مسترخٍ, هادئ (بدون إجهاد أو قلق)\nمثال: أعطى انطباعاً بأنه مسترخٍ تماماً",
 "しゃらくさい": "سَلِيط, صَفِيق (جريء ومتطاول بشكل غير لائق) / خَارِجِيّ, غَيْرُ جَوْهَرِيّ (لا يتعلق بالمسألة قيد البحث) / جَرِيءُ اللِّسَان, وَقِح (يتّسم بخفّة وقحة ومرح طافح)",
 "しゃらじゅ": "شَاؤُول, طَالُوت / شَاؤُول / سَوْل, شَاؤُول",
 "しゃらそうじゅ": "شَاؤُول, طَالُوت / شَاؤُول / سَوْل, شَاؤُول",
 "しゃり": "دَاخِل / في غضون (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / فِي خِلَال (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / إِسْهَال",
 "しゃりえん": "كبريتات المغنيسيوم (ملح للمغنيسيوم)",
 "しゃりとう": "ذخيرة مقدسة, وعاء الذخائر (حاوية تُحفظ فيها الآثار الدينية أو تُعرض (خاصة آثار القديسين))",
 "しゃりべつ": "شَرَاب, قَطْر",
 "しゃりょう": "وَاسِطَة, وَسِيلَة",
 "しゃりょうきち": "ساحة قطارات (منطقة بها شبكة من مسارات السكك الحديدية والتحويلات لتخزين وصيانة العربات والقاطرات)",
 "しゃりょうつうこうたい": "زُقَاق, ممر / مَسَار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة.",
 "しゃりん": "عَجَلَة / عجلة / رويضة",
 "しゃりんどめ": "تَمَامًا, حَتَّى الامْتِلَاء (بأقصى ما يمكن) / إسفين, سنادة (كتلة من الخشب تستخدم لمنع انزلاق أو تدحرج جسم ثقيل)\nمثال: كان ممتلئاً تماماً",
 "しゃりんまど": "نافذة وردية (نافذة دائرية مليئة بالزخارف)",
 "しゃれ": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ / أنيق, عصري (كائن أو متوافق مع الموضات الاجتماعية الحالية) / أنيق, عصري (لديه أناقة أو ذوق أو رقي في الأخلاق أو الملبس)\nمثال: ملابس عصرية",
 "しゃれい": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "しゃれいきん": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "しゃれおつ": "أنيق, عصري (كائن أو متوافق مع الموضات الاجتماعية الحالية) / أنيق, عصري (لديه أناقة أو ذوق أو رقي في الأخلاق أو الملبس)\nمثال: ملابس عصرية",
 "しゃれこうべ": "جُمْجُمَة",
 "しゃれた": "أنيق, عصري (كائن أو متوافق مع الموضات الاجتماعية الحالية) / أنيق, عصري (لديه أناقة أو ذوق أو رقي في الأخلاق أو الملبس)\nمثال: ملابس عصرية / بَلِيغ الدُّعَابَة, حَاضِر البَدِيهَة (يجمع بين الفكرة الذكيّة والتعبير الطريف)",
 "しゃれっけ": "روح الدعابة, فكاهة (سمة تقدير (والقدرة على التعبير عن) الفكاهة) / طَرَافَة, فُكَاهَة (صفة كون الشيء مضحكا) / سائل جسدي, سوائل الجسم (الأجزاء السائلة من الجسم) / خلط ((في العصور الوسطى) أحد السوائل الأربعة في الجسم التي كان يعتقد أن توازنها يحدد الحالة العاطفية والجسدية)\nمثال: لم تقدر فكاهتي",
 "しゃれっ気": "روح الدعابة, فكاهة (سمة تقدير (والقدرة على التعبير عن) الفكاهة) / طَرَافَة, فُكَاهَة (صفة كون الشيء مضحكا) / سائل جسدي, سوائل الجسم (الأجزاء السائلة من الجسم) / خلط ((في العصور الوسطى) أحد السوائل الأربعة في الجسم التي كان يعتقد أن توازنها يحدد الحالة العاطفية والجسدية)\nمثال: لم تقدر فكاهتي",
 "しゃれつ": "مَوْكِب سَيَّارَات (موكب من الناس يسافرون في السيارات)",
 "しゃれもの": "رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / يول (سفينة شراعية بصاريتين؛ صارية خلفية صغيرة تقع خلف عمود الدفة) / متأنق (رجل يهتم كثيراً بملابسه ومظهره)",
 "しゃれる": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "しゃろ": "منحدر (سطح مائل يربط بين مستويين) / سلم الطائرة, منحدر (درج متحرك يستخدمه الركاب للصعود إلى الطائرة أو النزول منها) / رامب, كراث بري (نبات معمر من أمريكا الشمالية له بصلة رفيعة وزهور بيضاء)",
 "しゃろう": "سَاعَةٌ رَمْلِيَّة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن)\nمثال: درست لمدة ساعة.",
 "しゃんしゃん": "ذُو رَنِين, مُرَنِّن (يُصدِر سلسلة من الأصوات الرنّانة الحادة كالأجراس الصغيرة) / صَحِيح, سَلِيم / صِحِّيّ (ما ينفع الصحة)\nمثال: لازمك تعمل حجر صحي. / غَلَيَان",
 "しゃー": "اندفاع, هفير (الضجيج الناتج عن الاندفاع المفاجئ لسائل (غاز أو سائل)) / أَزِيز, فَحِيح / هَفَّ, فَحَّ / أزيز, طشة (ضجيج أزيز (مثل القلي))",
 "しゃーっ": "اندفاع, هفير (الضجيج الناتج عن الاندفاع المفاجئ لسائل (غاز أو سائل)) / أَزِيز, فَحِيح / هَفَّ, فَحَّ / أزيز, طشة (ضجيج أزيز (مثل القلي))",
 "しゃーない": "لَا مَفَرّ, لَا أَسْتَطِيع ذٰلِك (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "しゃーなし": "لَا مَفَرّ, لَا أَسْتَطِيع ذٰلِك (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "しゃ断機": "حاجز / جدار ساحلي",
 "しや": "ساحة بصرية",
 "しやいどう": "طُومَار",
 "しやきょうさく": "انغلاق, ضيق الأفق (الميل لانتقاد الآراء المعارضة أو السلوكيات الصادمة)",
 "しやく": "كاشف, مادة متفاعلة (عامل كيميائي يستخدم في التفاعلات الكيميائية)",
 "しやくしょ": "مَجْلِس / مَجْمَع (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "しやにいれる": "اِعْتَبَرَ, تَدَبَّرَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين) / عَدَّ\nمثال: اعتبر نفسك محظوظا",
 "しやのせまい": "قَصِيرُ النَّظَر (يفتقر إلى بُعْد النظر أو الشمولية) / طَائِش, غَيْرُ مَدْرُوس (لم يُعْطَ تفكيرًا كافيًا أو دراسة متأنّية) / قصير النظر, مصاب بقصر النظر (غير قادر على رؤية الأشياء البعيدة بوضوح)",
 "しやわせ": "سَعَادَة, فَرَح",
 "しゅ": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن. / قَائِد, زَعِيم / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب. / نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر. / نَوْع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر. / وَرَم / الْجَمَاهِير, العَامَّةُ / نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه. / زِنْجَفْرِيّ (بلون أحمر زاهٍ إلى برتقالي محمر) / جُذْمُور, كُنَّاشَة / استيلاء, مصادرة (فعل متعمد لاكتساب شيء ما، غالباً دون إذن المالك) / استيلاء, ضم (الدمج عن طريق الانضمام أو الاتحاد) / اعتماد مالي, مخصصات مالية (أموال مخصصة (كما من قبل هيئة تشريعية) لغرض محدد)\nمثال: تم الحصول على الأموال اللازمة من خلال استيلاء الحكومة على الوحدة التشغيلية للشركة / كُحُول, مَشْرُوب كُحُولِيّ (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول.",
 "しゅあか": "زِنْجَفْرِيّ (بلون أحمر زاهٍ إلى برتقالي محمر) / أحمر زاهٍ, قرمزي فاتح (لون متغير يكون أحمر زاهياً ولكن أحياناً مع مسحة برتقالية)",
 "しゅい": "آريل, غلاف البذرة اللحمي (غطاء لحمي وعادة زاهي الألوان لبعض البذور يتطور من ساق البويضة ويغلف البذرة جزئياً أو كلياً) / رَأْي, نَظَر",
 "しゅいしょ": "دليل المقررات (كتالوج يسرد الدورات التي تقدمها كلية أو جامعة) / نَشْرَة إِصْدَار, نَشْرَة اكْتِتَاب (عرض مكتوب رسمي لبيع الأوراق المالية يحدد خطة لمؤسسة تجارية (مقترحة))\nمثال: يجب أن تحتوي نشرة الاكتتاب على الحقائق التي يحتاجها المستثمر لاتخاذ قرار مستنير",
 "しゅいろ": "زِنْجَفْرِيّ (بلون أحمر زاهٍ إلى برتقالي محمر) / أحمر زاهٍ, قرمزي فاتح (لون متغير يكون أحمر زاهياً ولكن أحياناً مع مسحة برتقالية)",
 "しゅいん": "عَادَة سِرِّيَّة / اِسْتِمْنَاء",
 "しゅう": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط. / تشو, سلالة تشو (السلالة الإمبراطورية للصين من 1122 إلى 221 قبل الميلاد؛ اشتهرت بظهور الكونفوشيوسية والطاوية) / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع. / قَارَّة / وِلَايَة, مُقَاطَعَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى)\nمثال: كان زيري من ولاية أخرى. / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز. / الْجَمَاهِير, العَامَّةُ / نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه. / أُسْبُوع / جُمْعَة (مجموعة، قبضة أو كمية صغيرة؛ جمعةٌ من تمر، أي قبضة منهُ) / اسبوع / إسبوع / أُسبوع / سيمانة\nمثال: اليوم هو الجمعة. / فِرْقَة / مَذْهَب (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب: المُعْتَقَد الديني الذي يُذهب إليه) / طائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه) / نِحْلَة\nمثال: الوجودية مذهب إنساني. / دوغما, عقيدة (عقيدة دينية تُعلن كحقيقة دون برهان) / مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: شكرا لإضافتي للمجموعة. / تَقَدُّم / دمامة, قبح (صفات المظهر التي لا تمنح المتعة للحواس) / خباثة, دناءة (صفة الشر والفساد الأخلاقي) / خَجَل, عَيْب (كلمة \"خَجِلَ\" تتراوح معانيها بين الحرج الشخصي والتأثر بالحمل أو البيئة، وتُستخدم في العديد من السياقات التي تعبر عن الاستحياء أو الحيرة؛ شعر بالخجل أو الحياء نتيجة لموقف محرج أو بسبب تصرف غير لائق) / عَار\nمثال: توم لص بلا خجل. / مَوَدَّة / مُلْحَق / مُرْفَق (مَا يُتَّكَأُ عَلَيْهِ)\nمثال: يؤلمني ذراعي من الكتف إلى المرفق. / حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس. / أَسِير, أَسِيرَة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ) / أَسِير, مَحْبُوس (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب. / كَهْف, غَار / سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "しゅうあく": "قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح.",
 "しゅうい": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط. / رَأْي عَامّ / إِنْفَحَة",
 "しゅういちょう": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "しゅういつ": "مُمْتَاز, فَاخِر",
 "しゅういん": "دير الرهبان (دير للرهبان المتجولين) / مَجْلِس النُّوَّاب, مَجْلِسْ أَدْنٰى",
 "しゅういんちょう": "حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى)",
 "しゅうえき": "أرباح, صافي الدخل (فائض الإيرادات عن المصروفات في فترة زمنية معينة (بما في ذلك الإهلاك والمصروفات غير النقدية الأخرى)) / أجر, راتب (شيء يُدفع كمقابل للعمل)\nمثال: دُفعت الأجور نقداً / تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة) / نبوءة (تنبؤ ينطق به تحت إلهام إلهي) / حَدْس صَائِب, فِرَاسَة (تخمين ناجح عن طريق بصيرة غير عادية أو حظ جيد)",
 "しゅうえきか": "اعتماد كعملة, سك العملة (اعتماد شيء ما (كالذهب أو الفضة) كعملة قانونية للبلد)",
 "しゅうえききん": "دَخْل (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "しゅうえきせい": "مَرْدُودِيَّة",
 "しゅうえきほうこく": "بيان الدخل, تقرير الأرباح (بيان مالي يعطي نتائج التشغيل لفترة محددة)",
 "しゅうえきりつ": "مُعَدَّل العَائِد (المبلغ المُعاد لكل وحدة زمنية معبراً عنه كنسبة مئوية من التكلفة)",
 "しゅうえん": "هُدْب (هُدْبُ العين ما نبت من الشعر على أشفارها) / هُدُب (هُدْبُ العين ما نبت من الشعر على أشفارها) / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "しゅうえんか": "تهميش (العملية الاجتماعية المتمثلة في التحول إلى هامشي أو جعله هامشياً (خاصة كمجموعة داخل المجتمع الأكبر))\nمثال: تهميش الطبقة الدنيا",
 "しゅうえんぶ": "أطراف, حد خارجي (الحد الخارجي أو سطح شيء ما)",
 "しゅうおんき": "عاكس مكافئ (عاكس مقعر يستخدم لإنتاج حزمة متوازية عندما يوضع المصدر في بؤرته أو لتركيز حزمة متوازية واردة)",
 "しゅうかい": "مَدَار (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير) / فَلَك (التَلّ المستدير من الرَمْل حوله فَضَاء؛ المَدَار يسبح فيه الجُرْم السماويّ)\nمثال: انتشرت الشائعة على مدار الدولة. / مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط. / اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم. / مُتَجَمِّع, مُتَكَتِّل (متجمع معاً لكن دون تماسك) / ركام, كدس (مجموعة من الأشياء مكدسة فوق بعضها البعض) / تكتل بركاني (صخر بركاني يتكون من شظايا كبيرة منصهرة معاً) / بَشِع, مُنَفِّر (قبيح لدرجة تبعث على الرعب) / شَنِيع, فَظِيع (مسيء بشكل فاحش للآداب أو الأخلاق؛ مثير للرعب)",
 "しゅうかいがん": "مُتَجَمِّع, مُتَكَتِّل (متجمع معاً لكن دون تماسك) / ركام, كدس (مجموعة من الأشياء مكدسة فوق بعضها البعض) / تكتل بركاني (صخر بركاني يتكون من شظايا كبيرة منصهرة معاً)",
 "しゅうかいきどう": "مَدَار (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير) / فَلَك (التَلّ المستدير من الرَمْل حوله فَضَاء؛ المَدَار يسبح فيه الجُرْم السماويّ)\nمثال: انتشرت الشائعة على مدار الدولة.",
 "しゅうかいしつ": "قاعة اجتماعات, قاعة تجميع (قاعة يمكن لعدد كبير من الناس التجمع فيها)",
 "しゅうかいじょ": "مكان اجتماع, منتدى (منشأة عامة للاجتماع للمناقشة المفتوحة)",
 "しゅうかいじょう": "مكان تجمع, ملتقى (مكان مفضل يجتمع فيه الناس)",
 "しゅうかいのじゆう": "حُرِّيَّة التَّجَمُّع (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "しゅうかぎん": "بروميد الفضة (بروميد يغمق لونه عند تعرضه للضوء؛ يُستخدم في صنع المستحلبات الفوتوغرافية)",
 "しゅうかく": "حِصَاد / مَحْصُول, غَلَّة / حَصَدَ (قَطَعَ الزَّرْعَ وغيره من النبات بالمِنْجَل أو آلة الحصاد)\nمثال: حصد الفلاح القمح. / فَاكِهَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها) / ثَمَرَة, شَاذّ جِنْسِيًّا / أَثْمَرَ (أثمر الشجر: صار فيه الثمر؛ أثمر الشجر: طلع ثمره قبل أن ينضج)\nمثال: التفاح فاكهة لذيذة. / لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / حاسة الشم, شم (الملكة التي تمكننا من تمييز الروائح)",
 "しゅうかくかんしゃさい": "عيد الشكر (عيد يحتفل به في أمريكا الشمالية كشكر للنعم والحصاد)",
 "しゅうかくき": "حصاد, موسم الحصاد (الموسم المخصص لجمع المحاصيل)",
 "しゅうかくだか": "مَحْصُول / حَوْصَلة",
 "しゅうかくていげんのほうそく": "قانون تناقص العوائد (قانون يؤكد أن الاستمرار بعد الوصول إلى مستوى معين من الأداء سيؤدي إلى انخفاض في الفعالية)",
 "しゅうかくぶつ": "حِصَاد / مَحْصُول, غَلَّة / حَصَدَ (قَطَعَ الزَّرْعَ وغيره من النبات بالمِنْجَل أو آلة الحصاد)\nمثال: حصد الفلاح القمح.",
 "しゅうかすいそ": "بروميد الهيدروجين (غاز عديم اللون ينتج حمض الهيدروبروميك عند ذوبانه في الماء)",
 "しゅうかぶつ": "عبارة مبتذلة, قول مأثور مبتذل (ملاحظة مبتذلة أو واضحة بشكل مفرط) / بروميد (أي من أملاح حمض الهيدروبروميك؛ كان يستخدم سابقاً كمهدئ ولكن تم استبداله عموماً بأدوية أكثر أماناً)",
 "しゅうかん": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس. / عَادَة / عَادَة, عُرْف / أُسْبُوع / جُمْعَة (مجموعة، قبضة أو كمية صغيرة؛ جمعةٌ من تمر، أي قبضة منهُ) / اسبوع / إسبوع / أُسبوع / سيمانة\nمثال: اليوم هو الجمعة.",
 "しゅうかんか": "اعتياد, تعود (تكيف عام مع ظروف بيئية غير متغيرة) / إدمان, اعتماد (التحمل غير الطبيعي والاعتماد على شيء يسبب التعود نفسياً أو جسدياً (خاصة الكحول أو المخدرات))",
 "しゅうかんこうそくどうろ": "طريق سريع بين الولايات (أحد الطرق السريعة في النظام الذي يربط المدن الكبرى في الولايات المتحدة)",
 "しゅうかんし": "أُسْبُوعِيًّا / أُسْبُوعِيٌّ",
 "しゅうかんせい": "مُسَبِّب لِلْإِدْمَان (يسبب أو يتميز بالإدمان)\nمثال: عقاقير تسبب الإدمان / مَأْلُوف, مُعْتَاد (شائع الاستخدام أو الممارسة؛ اعتيادي)",
 "しゅうかんせいりゅうざん": "إجهاض متكرر (إجهاض تلقائي متكرر (غالباً لسبب غير معروف))",
 "しゅうかんてき": "مَأْلُوف, مُعْتَاد (شائع الاستخدام أو الممارسة؛ اعتيادي)",
 "しゅうかカリウム": "بروميد البوتاسيوم",
 "しゅうかメチル": "بروميد الميثيل",
 "しゅうがく": "تَعَلُّم (اكتسب معرفة أو خبرة أو مهارة) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: هو سريع التعلم.",
 "しゅうがくりょこう": "جَوْلَة, نُزْهَة",
 "しゅうき": "دَوْر, دَوْرَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: في أي دور تسكن؟ / نَتُنَ, نَتِنَ / إنهاء, خاتمة (فعل إنهاء شيء ما) / خاتمة, نهاية (نهاية الكلمة (لاحقة أو نهاية تصريفية أو مورفيم نهائي)) / خاتمة, نهاية (القسم الأخير من اتصال ما) / إنهاء, ختام (حدث ينهي وقوعه شيئاً ما)\nمثال: إنهاء الاتفاقية",
 "しゅうきじょうちょうけんさ": "فحص التكرار الدوري (رمز لتصحيح الخطأ يُسجل في كل قطاع من القرص المغناطيسي ويُستخدم لاكتشاف الأخطاء في البيانات)",
 "しゅうきせい": "دَوْرِيَّة (صفة التكرار على فترات منتظمة) / دَوْرِيّ, عَرَضِيّ (يَتَكَرَّرُ أَوْ يَظْهَرُ مِنْ حِينٍ لِآخَر) / دوري (يحدث أو يتكرر على فترات منتظمة)\nمثال: الظهور الدوري للجراد ذي السبعة عشر عاماً",
 "しゅうきせいおうとしょう": "مِئَة وَخَمْسَة (يَدُلُّ عَلَى العَدَد 105) / سيرة ذاتية (ملخص للتاريخ الأكاديمي والوظيفي للشخص)",
 "しゅうきつ": "برتقال بري, برتقال ثلاثي الأوراق (شجرة برتقال صينية نفضية شائكة صغيرة سريعة النمو تحمل زهوراً حلوة الرائحة وثماراً زخرفية ولكن غير صالحة للأكل: تستخدم كأصل في التطعيم وللأسوار الحية)",
 "しゅうきてき": "دَوْرِيّ, عَرَضِيّ (يَتَكَرَّرُ أَوْ يَظْهَرُ مِنْ حِينٍ لِآخَر) / دوري (يحدث أو يتكرر على فترات منتظمة)\nمثال: الظهور الدوري للجراد ذي السبعة عشر عاماً",
