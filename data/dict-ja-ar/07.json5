 "とっくむ": "عَالَجَ",
 "とっくり": "بِعِنَايَة",
 "とっくりけい": "كَلْب, كلب (بمعنى ضربهُ بالكُلاب أو جعل لها كَلْبًا؛ سَيْر أحمر يُجعَل بين طرفي الأديم إذا خُرِز)\nمثال: كان الكلب ميتا.",
 "とっくん": "حَلَقَة دِرَاسِيَّة مُكَثِّفَة",
 "とっけん": "اِمْتِيَاز",
 "とっこう": "فَضِيلَة / عِفَّة, طَهَارَة",
 "とっこうやく": "رَصَاصَة الْفُضَّة",
 "とっこつ": "شَاهِق",
 "とっさ": "عَزْم / لَحْظَة, دَقِيقَة",
 "とっさき": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "とっさに": "حَالاً (مباشرةً، فوراً، دون تأخير؛ في هذه الأثناء، في الوضع الحالي)\nمثال: سأكون معك حالا.",
 "とっしゅつ": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها. / تَمَزُّق",
 "とっしゅつして": "خُصُوصًا, خَاصَّةً",
 "とっしゅつぶ": "نَاتِئَة",
 "とっしゅつぶつ": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "とっしん": "اِنْدَفَعَ, أَسْرَعَ / سَمَار",
 "とったん": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "とっちめる": "اِمْرَأَة سَلِيطَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ) / وَبَّخَ (التأنيب بشدة)\nمثال: أنا امرأة قوية.",
 "とっちゃん": "بَابَا",
 "とっつかまえる": "لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة.",
 "とっつき": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة.",
 "とっつく": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه. / اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني.",
 "とっつぱれ": "النِهاية",
 "とって": "مِقْبَض",
 "とってい": "رَصِيف",
 "とっておき": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا. / كَنْز / وَرَقَة رَابِحَة",
 "とってかえす": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "とってかわる": "اِسْتَبْدَلَ, بَدَّلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
