 "しいくじょう": "مرتع, مفقس (مكان تتكاثر فيه الحيوانات)",
 "しいくわあさあ": "حَسَّاس, سَرِيع الغَضَب (سريع التأثّر والانزعاج من أيّ إساءة)",
 "しいこうい": "مُظَاهَرَة, تَظَاهُر (مُظَاهَرَة من أجل تحقيق هدف معين ٠)\nمثال: قرابة الألف شاركوا في المظاهرة.",
 "しいざかな": "طبق جانبي (طبق يُقدم مع الطبق الرئيسي ولكنه تابع له)",
 "しいしい": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "しいしゅ": "حَقَّانِيّ, عَقْلَانِيّ / مَوْضُوعِيّ / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / عَدَسَة\nمثال: لقد أخطأ الهدف.",
 "しいする": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "しいせい": "تقلب, نزوة (سمة التصرف بشكل غير متوقع وبدافع نزوة أكثر منه بدافع العقل أو الحكم)\nمثال: أيأس من تقلب ونزوة ذاكرتي",
 "しいそん": "قَيْصَر, إِمْبْرَاطُور",
 "しいたけ": "شيتاكي (فطر شرق آسيوي صالح للأكل له قبعة ذهبية أو بنية داكنة إلى سوداء وساق غير صالح للأكل)",
 "しいたげられたひとびと": "مَظْلُوم",
 "しいたげる": "اِسْتَضْعَفَ, قَهَرَ",
 "しいてき": "اِعْتِبَاطِيّ",
 "しいと": "حَم (التنور أو الفرن أو الماء: سجر وسخن وأصبح حارّا؛ الأمر: قُضِيَ وتقدر من الله)\nمثال: أفضل لحم البقر.",
 "しいとめ": "حَمَاة",
 "しいにび": "أبنوسي, أسود حالك (أسود داكن جداً)",
 "しいにぶ": "أبنوسي, أسود حالك (أسود داكن جداً)",
 "しいね": "انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء)) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / انتفاخ, تضخم (بروز غير طبيعي أو تضخم موضعي)",
 "しいら": "دُلْفِين / دَرْفِيل / دُخَس (سَمِنَ وامتلأ شحمًا ولحمًا؛ دَسَّ الشيءَ)",
 "しいる": "قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / أَجْبَرَ, اِضْطَرَّ (فعل تعدّي من جَبَرَ؛ جعله يَجْبُر، ضد أَكْسَرَ؛ جعله يفعل شيئا رُغْما عنه؛ أَرْغَمَ)\nمثال: توم شعر بالقوة. / تَشْهِير, اِفْتِرَاء",
 "しいれ": "شِرَاء, اِشْتِرَاء",
 "しいれさき": "مُزَوِّد, مُزَوِّدَة",
 "しいれたんか": "سعر الشراء (السعر الذي يتم شراء شيء ما به فعلياً)",
 "しいれる": "اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك. / اِسْتَقْبَلَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / أَصْبَحَ (دَخَلَ فِي الصَّبَاح؛ صَارَ)\nمثال: استقبل توم الضيوف.",
 "しいん": "صَامِت / حَرْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء. / سَبَب مَوْت, سَبَب وَفَاة ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سامي كان السبب. / بدون كلام, بصمت (بدون التحدث)\nمثال: جلس بصمت بجوارها / مَذَاق (مَا تُدْرِكُهُ حَاسَّةُ الذَّوْق)\nمثال: التين حلو المذاق.",
 "しいんぐん": "اِجْتِمَاع السَّاكِنِين, التَّقَاء السَّاكِنِين (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم.",
 "しいんせい": "ساكن, صامت (كونه أو يتميز بـ أو يحتوي على أو يعمل كحرف ساكن) / سكوني, صامت (يتعلق بـ أو له طبيعة الحرف الصامت (الساكن))\nمثال: أصوات ساكنة",
 "しう": "ضَرِيح / رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "しうち": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري. / حَرَكَة",
 "しうと": "حَم (التنور أو الفرن أو الماء: سجر وسخن وأصبح حارّا؛ الأمر: قُضِيَ وتقدر من الله)\nمثال: أفضل لحم البقر.",
 "しうとめ": "حَمَاة",
 "しうんてん": "اختبار, تجربة (تجربة شيء ما لمعرفة المزيد عنه)\nمثال: عينة للتجربة المجانية لمدة عشرة أيام",
 "しぇえ": "قِف, قِفِي",
 "しえ": "عَالِيّ الرُتْبَة / كَاهِن, قِسِّيس",
 "しえき": "وَظِيفَة, تَوْظِيف (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِسْتِخْدَام\nمثال: ما وظيفة زوجتك؟ / عِلِّيّ, مُسَبِّب (ينتج تأثيراً)\nمثال: الفقر كعامل مسبب للجريمة / مُسَاعَدَة, مَعُونَة / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة) / سَاعَدَ, عَاوَنَ (عَاوَنَ، أَعَانَ) / مُسَاعَدَة, النَّجْدَة\nمثال: علي مساعدة ماري.",
 "しえきけん": "كلب عمل (أي من عدة سلالات من الكلاب القوية الكبيرة عادة التي يتم تربيتها للعمل كحيوانات جر وكلاب حراسة وإرشاد)",
 "しえきどうぶつ": "حيوان جر (حيوان يستخدم لسحب الأحمال الثقيلة)",
 "しえん": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / دخان التبغ (الدخان الناتج عن حرق المنتجات المصنوعة من أوراق التبغ المجففة، مثل السجائر)\nمثال: يجب أن تقلع عن التدخين، ألا تعلم أن دخان التبغ يحتوي على مواد ضارة؟ / بَرُوفَة",
 "しえんかたんそ": "رابع كلوريد الكربون (سائل عديم اللون غير قابل للاشتعال يستخدم كمذيب للدهون والزيوت؛ تراجع استخدامه كسائل تنظيف أو طفاية حريق بسبب سميته)",
 "しえんきん": "تمويل, دعم مالي (الموارد المالية المقدمة لجعل مشروع ما ممكناً)\nمثال: قدمت المؤسسة الدعم للتجربة",
 "しえんしゃ": "داعم رياضي (داعم للأعضاء التناسلية يرتديه الرجال الذين يمارسون تمارين شاقة) / رباط جورب, مشد (شريط (عادة مطاطي) يرتدى حول الساق لتثبيت الجورب (أو حول الذراع لتثبيت الكم)) / مساعد, معين (شخص يساهم في تلبية حاجة أو تعزيز جهد أو غرض) / داعم, راعٍ (شخص يدعم أو يناصر شيئاً ما)\nمثال: مساعدي الذي لا يقدر بثمن",
 "しえんたいせい": "نظام دعم (شبكة من المرافق والأشخاص الذين يتفاعلون ويظلون في اتصال غير رسمي للمساعدة المتبادلة؛ شبكة تمكنك من العيش بأسلوب معين)",
 "しお": "مَدّ وَجَزْر (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى. / فُرْصَة / مِلْح, ملح / مَلَّحَ / مَشَقَّة, شِدَّة / مُلُوْحَة / بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "しおあい": "فُرْصَة",
 "しおあじ": "مُلُوْحَة",
 "しおいれ": "رَشَّاشَةْ الْمِلْح (مؤنث رَشَّاش، وهو الكثير الرَشّ؛ سِلاح نَارِيّ يَرُشّ الرَصَاص رشّا ولا يحتاج إلى ضغط الزَنَاد لكل رَصَاصَة)",
 "しおう": "رَهَج أَصْفَر / أصفر ليموني, ليموني (لون أصفر قوي) / غامبوج (صمغ راتنجي يُستخدم كصبغة صفراء ومسهل) / تَزْيِيف",
 "しおえる": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "しおおせる": "أَدَّى",
 "しおかぜ": "نسيم البحر (نسيم منعش من البحر (خلال النهار))",
 "しおからい": "مَالِح / مِلْحِيّ",
 "しおき": "عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "しおくり": "سماح (فعل السماح) / تَفَاوُت مَسْمُوح, سَمَاحِيَّة (فرق مسموح به؛ السماح ببعض الحرية للحركة ضمن حدود) / بدل, تعديل (مبلغ يضاف أو يخصم بناءً على ظروف مؤهلة) / بدل, مخصص (مبلغ مسموح به أو ممنوح (كما خلال فترة معينة))\nمثال: اعترض على السماح بالتدخين في غرفة الطعام",
 "しおけ": "مُلُوْحَة",
 "しおさき": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "しおしお": "بِإِحْبَاط, بِاكْتِئَاب (بطريقة مكتئبة)\nمثال: عندما عادت كانت صوفي وإستر تجلسان باكتئاب في المطبخ",
 "しおじ": "مجرى المد (قناة يجري فيها تيار المد والجزر)",
 "しおじり": "مخروطي (متعلق بالمخروط أو يشبهه)\nمثال: جبال مخروطية",
 "しおじる": "مَاء مِلْح (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "しおた": "حوض ملحي (حوض ضحل في منطقة صحراوية؛ يحتوي على الملح والجبس المترسب من بحيرة مالحة متبخرة)",
 "しおたいおう": "ازدراء, تجاهل (رفض التعرف على شخص تعرفه)\nمثال: كان التجاهل متعمداً بوضوح",
 "しおだ": "حوض ملحي (حوض ضحل في منطقة صحراوية؛ يحتوي على الملح والجبس المترسب من بحيرة مالحة متبخرة)",
 "しおち": "إِغْفَال",
 "しおっけ": "مُلُوْحَة",
 "しおつなみ": "طغيان المد, موجة المد العارمة (موجة عالية (غالباً ما تكون خطرة) ناتجة عن تدفق المد والجزر (كما هو الحال عند تصادم تيارات المد والجزر أو في مصب ضيق))",
 "しおづけ": "كرة النفتالين (كرة صغيرة من الكافور أو النفتالين تستخدم لإبعاد العث عن الملابس المخزنة)",
 "しおとし": "إِغْفَال",
 "しおとす": "اِسْتَخَفَّ, اِسْتَهَانَ",
 "しおどき": "فُرْصَة",
 "しおのながれ": "تيار المد والجزر (تيار مائي ناتج عن المد والجزر)",
 "しおはま": "حوض ملحي (حوض ضحل في منطقة صحراوية؛ يحتوي على الملح والجبس المترسب من بحيرة مالحة متبخرة)",
 "しおばな": "رغوة الموج, زبد الموج (موجة تهب عليها الرياح فينكسر عرفها ويظهر أبيض اللون)",
 "しおひ": "انحسار الماء, جزر (أدنى (أبعد) انحسار للمد)",
 "しおふき": "مُتَطَاير, مُنْدَفِع (يُدفَع بقوَّة في مجرى ضيِّق عادةً) / قَذْف اَلْإِنَاث (بمعنى رَمَى؛ قذَف بالحقّ: أمر به وأبانه)",
 "しおふきあな": "فتحة تهوية, منفس (ثقب لهروب الغاز أو الهواء) / ثقب النفث (متنفس الحيتانيات الواقع بعيداً في الخلف على الجمجمة)",
 "しおぶた": "هَام (أصابه الهيام)\nمثال: الحضور هام جدا.",
 "しおまねき": "سرطان عازف (سرطان حفار في المناطق الساحلية الأمريكية يتميز بوجود مخلب واحد متضخم جداً لدى الذكر)",
 "しおみ": "مُلُوْحَة",
 "しおみず": "مَاء مِلْح (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء. / ماء البحر, ماء مالح (ماء يحتوي على أملاح)",
 "しおめ": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "しおやあぶ": "ذبابة سارقة (ذبابة مفترسة سريعة لها جسم قوي يشبه النحلة مع خرطوم صلب لامتصاص عصارة الحشرات الأخرى التي يتم اصطيادها أثناء الطيران)",
 "しおらしい": "خَنُوع, مُسْتَكِين (يُظْهِر قِلَّة فِي الشَّجَاعَة؛ مُفْرِط فِي الِامْتِثَال) / خَجُول, وَدِيع (متواضع في الروح أو السلوك؛ يُوحي بلطف منسحب أو خضوع مهيب) / خَنُوع, وَدِيع (بالغ الطاعة والانقياد) / مُحَمَّد (مُفَعَّل من حَمَّدَ؛ الذي يُحْمَدُ كثيرا)\nمثال: محمد رسول الله.",
 "しおり": "علامة قراءة, فاصل كتب (علامة (قطعة من الورق أو شريط) توضع بين صفحات الكتاب لتحديد مكان القراءة) / دليل سياحي, مرشد (شيء يقدم معلومات أو تعليمات أساسية)",
 "しおりど": "باب صغير, بويب (بوابة أو باب صغير (خاصة الذي يكون جزءاً من باب أكبر))",
 "しおれる": "صَعَقَ",
 "しおをかける": "مِلْح, ملح / مَلَّحَ",
 "しおをする": "مِلْح, ملح / مَلَّحَ",
 "しおをふく": "فوهة, مصب (فتحة تسمح بمرور السوائل أو الحبوب) / بَخَّ, بَجَّسَ (معناه عظم الأمر وفخُم تقال عند الرضى والإعجاب بالشيء أو عند الفخر أو المدح)\nمثال: توم التقط بطل الشامبو و بخ القليل في يده",
 "しおん": "صَامِت / حَرْف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء. / سِنِّيّ ((سَنِيَ) يَسْنَى سَنًا، وسَناءً: ارتفع؛ (سَنِيَ): صار ذا سَناء ورِفْعةٍ وقَدْرٍ)\nمثال: وقعت سني الأمامية. / النَّجْم, قَسِيم نَجْمِيّ (بنية نجمية الشكل تتشكل في سيتوبلازم الخلية لها ألياف تشبه الأشعة تحيط بالجسيم المركزي أثناء الانقسام المتساوي) / أستر, نجمة (أي من أعشاب مختلفة تزهر غالباً في الخريف من جنس أستر ذات زهور مبهرجة تشبه الأقحوان)",
 "しおんき": "كابح, مثبط (قيد يسبب الإحباط أو التثبيط) / كاتم, مخمّد (جهاز يقلل من سعة التذبذبات الإلكترونية أو الميكانيكية أو الصوتية أو الديناميكية الهوائية) / مخمد (لوحة حديدية متحركة تنظم تيار الهواء في موقد أو مدخنة أو فرن)\nمثال: وضع المطر كابحًا لخطط نزهتنا",
 "しか": "اِسْتَثْنَى (أن يشمل الكُلّ إلا جزء، ولا يكون إلا إذا كان الجزءُ جزءًا من الكل) / إِلَّا, بِاسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / مثال: لا أعرف إلا هذا. / مُؤَرِّخ, مُؤَرِّخَة / سعر السوق, قيمة سوقية (السعر الذي يتبادل به المشترون والبائعون السلعة في سوق مفتوح) / إجازة عسكرية (إجازة مؤقتة من الخدمة العسكرية) / طب الأسنان (فرع الطب المعني بتشريح وتطور وأمراض الأسنان) / أَيِّل / شِعْر (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل. / جهنمية ملساء, زهرة الورق (كرمة برازيلية تميل للإزهار بشكل مستمر) / شائبة, عيب (علامة أو عيب يفسد مظهر شيء ما (خاصة على جسم الشخص))\nمثال: عيب في الوجه / هَٰكَذَا, كَذَا / بل, نعم (ليس ذلك فحسب، بل)\nمثال: أنا بذلك أفرح، بل وسأفرح / شَاعِر, شَاعِرَة",
 "しかい": "رئاسة (منصب الرئيس (لمجلس أو هيئة)) / رَئِيس / المجلس البلدي, مجلس المدينة (هيئة بلدية يمكنها إصدار المراسيم وتخصيص الأموال وغيرها) / ساحة بصرية / طَبِيب أَسْنَان, طَبِيبَة أَسْنَان (العالم بالطب)\nمثال: سوف تصبح طبيبة. / اَلْبِحَار اَلسَّبْعَة / الْبَحْر الْمَيِّت / سِجِّين, عَالَم سُفْلِيّ / نُقْطَة عَمْيَاء (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "しかいいん": "جراحة الأسنان (فرع طب الأسنان الذي يشمل الإجراءات الجراحية)",
 "しかいがく": "طب الأسنان (فرع الطب المعني بتشريح وتطور وأمراض الأسنان)",
 "しかいし": "طَبِيب أَسْنَان, طَبِيبَة أَسْنَان (العالم بالطب)\nمثال: سوف تصبح طبيبة.",
 "しかいしゃ": "رَئِيس",
 "しかいしゃほん": "الْبَحْر الْمَيِّت",
 "しかいじゅつ": "طب الأسنان (فرع الطب المعني بتشريح وتطور وأمراض الأسنان)",
 "しかいのしし": "بَابِيرُوسَة",
 "しかいぶんしょ": "الْبَحْر الْمَيِّت",
 "しかいもんじょ": "الْبَحْر الْمَيِّت",
 "しかいやく": "مُشْرِف",
 "しかえいせいし": "أخصائي صحة الأسنان (شخص مدرب لتقديم خدمات طب الأسنان الوقائية (تنظيف الأسنان أو أخذ صور الأشعة السينية))",
 "しかえし": "اِنْتِقَام, قِصَاص (فعل الانتقام (إيذاء شخص ما انتقاماً لشيء ضار فعله) خاصة في الحياة الآخرة) / استرداد الاستثمار, عائد الاستثمار (عائد مالي أو مكافأة (خاصة العوائد التي تساوي الاستثمار الأولي))\nمثال: لي النقمة أنا أجازي يقول الرب",
 "しかえす": "اِنْتَقَمَ",
 "しかかり": "فاتِحَة (لفَاتِح؛ سُوْرَة الْفَاتِحَة : أعظم سورة في القرآن الكريم وسميت بذلك لأنها افتتح بها المصحف في الكتابة، ولأنها تفتتح بها الصلاة في القراءة)\nمثال: لدى نبات الخلنج هذا أزهار وردية فاتحة.",
 "しかかりひん": "عمل قيد الإنجاز (قطعة عمل لم تنته بعد)",
 "しかがく": "طب الأسنان (فرع الطب المعني بتشريح وتطور وأمراض الأسنان)",
 "しかがわ": "جلد الغزال (جلد مصنوع من إهاب الغزال)",
 "しかきょうせいがく": "تقويم الأسنان (فرع طب الأسنان الذي يتعامل مع الوقاية من أو تصحيح عدم انتظام الأسنان)",
 "しかぎこうし": "فني أسنان (شخص يصنع أجهزة طب الأسنان (الجسور وأطقم الأسنان))",
 "しかく": "قَاتِل, سَفَّاح (اسم فاعل من الفعل قَتَلَ، الذي قَامَ بالقَتْل. الجمع قَاتِلُون؛ المُجْرِم الذي يقتل بلا حَقّ. الجمع قتلة) / حَشَّاش\nمثال: بيتي قاتلة أمك. / رُبَاعِيّ الْأَضْلَاع / رُبَاعِيّ الْجَوَانِب / نُقْطَة عَمْيَاء (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه. / مَشْهَد / مَنْظَر / مُؤَهِّل / شَاعِر, شَاعِرَة",
 "しかくい": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "しかくか": "تصور بصري, صورة بصرية (صورة ذهنية تشبه الإدراك البصري)",
 "しかくがない": "غير مؤهل, غير مختص قانونياً (غير مؤهل أو غير كافٍ قانونياً) / بِلَا حَقّ, غَيْرُ مُسْتَحِقّ (لا يملك حقاً أو استحقاقاً) / غير مؤهل (غير مستوف للمعايير والمتطلبات والتدريب المناسب) / غير مشروط, مطلق (غير محدود أو مقيد)\nمثال: تعتبر الزوجة عادة غير مؤهلة للشهادة ضد زوجها",
 "しかくけい": "رُبَاعِيّ الْأَضْلَاع / رُبَاعِيّ الْجَوَانِب / الجهاز البصري (الجهاز الحسي للرؤية)",
 "しかくげいじゅつ": "فُنُون بَصَرِيَّة (بمعنى الضرب من الشيء والنوع؛ بمعنى بعض الصناعات الراقية التي تحتاج إلى مهارة يحكمها الذوق والمواهب)\nمثال: زيري يحب الفنون.",
 "しかくしつにん": "عمه بصري (عدم القدرة على التعرف على أو تفسير الأشياء في المجال البصري)",
 "しかくしめん": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "しかくしょうがい": "خلل بصري, ضعف البصر (قصور في حاسة البصر)",
 "しかくしょうがいしゃ": "ضعيف البصر, كفيف (شخص لديه ضعف في الرؤية)",
 "しかくせいしつごしょう": "حبسة بصرية, عسر القراءة (عدم القدرة على إدراك الكلمات المكتوبة)",
 "しかくちゅう": "منشور رباعي (منشور قاعدتاه أشكال رباعية)",
 "しかくてき": "بَصَرِيّ",
 "しかくてきエディタ": "سِتَّة (يَدُلُّ عَلَى العَدَد 6) / سُدَاسِيّ, سِتَّة (العدد الأصلي الذي هو مجموع خمسة وواحد)",
 "しかくのない": "غير مؤهل, غير مختص قانونياً (غير مؤهل أو غير كافٍ قانونياً) / بِلَا حَقّ, غَيْرُ مُسْتَحِقّ (لا يملك حقاً أو استحقاقاً) / غير مؤهل (غير مستوف للمعايير والمتطلبات والتدريب المناسب) / غير مشروط, مطلق (غير محدود أو مقيد)\nمثال: تعتبر الزوجة عادة غير مؤهلة للشهادة ضد زوجها",
 "しかくまめ": "فاصوليا مجنحة, فول غوا (كرمة حولية درنية ملتفة تحمل عناقيد من الزهور الأرجوانية وقروناً بأربعة أجنحة مسننة؛ المناطق الاستوائية في العالم القديم)",
 "しかくや": "قشرة بصرية, منطقة بصرية (المنطقة القشرية التي تستقبل المعلومات من الجسم الركبي الجانبي للمهاد)",
 "しかけ": "أَدَاة, جِهَاز / حِيلَة / مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم. / فاتِحَة (لفَاتِح؛ سُوْرَة الْفَاتِحَة : أعظم سورة في القرآن الكريم وسميت بذلك لأنها افتتح بها المصحف في الكتابة، ولأنها تفتتح بها الصلاة في القراءة)\nمثال: لدى نبات الخلنج هذا أزهار وردية فاتحة.",
 "しかけえほん": "كتاب مجسم, كتاب منبثق (كتاب (عادة للأطفال) يحتوي على صفحة أو أكثر بحيث يرتفع هيكل ثلاثي الأبعاد عند فتح الصفحة)",
 "しかけじらい": "شَرَك, فَخّ ((شَرِكَتِ) النَّعْلُ تَشْرَكُ شَرَكًا: انقطَعَ شِراكُها؛ (شَرِكَتْ) فُلانًا في الأمْرِ شِرْكًا، وشَرِكَةً، وشِرْكَةً: كان لكل منهما نصيب منه)\nمثال: هذه شركة صينية.",
 "しかけとびら": "باب أرضي, باب سحري (باب مفصلي أو منزلق في أرضية أو سقف)",
 "しかけにん": "مُحَرِّض, مُحَرِّضَة",
 "しかけばくだん": "شَرَك, فَخّ ((شَرِكَتِ) النَّعْلُ تَشْرَكُ شَرَكًا: انقطَعَ شِراكُها؛ (شَرِكَتْ) فُلانًا في الأمْرِ شِرْكًا، وشَرِكَةً، وشِرْكَةً: كان لكل منهما نصيب منه)\nمثال: هذه شركة صينية.",
 "しかけひん": "عمل قيد الإنجاز (قطعة عمل لم تنته بعد)",
 "しかける": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / تَحَدٍّ, التَّحَدِّي / وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع.",
 "しかけ絵本": "كتاب مجسم, كتاب منبثق (كتاب (عادة للأطفال) يحتوي على صفحة أو أكثر بحيث يرتفع هيكل ثلاثي الأبعاد عند فتح الصفحة)",
 "しかし": "بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال / دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "しかして": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "しかしながら": "بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال",
 "しかしゅう": "تَجْمِيعَة, دِيوَان",
 "しかじゅう": "ثقل ساكن, وزن ميت (وزن ثقيل لا يتحرك) / عبء ثقيل (عائق قمعي أو ثقيل)",
 "しかた": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "しかたがない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / بدون جدوى / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه / غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "しかたない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / بدون جدوى / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه / غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "しかたなく": "بعجز, بقلة حيلة (بطريقة عاجزة)\nمثال: راقبه الحشد بقلة حيلة",
 "しかたなしに": "بعجز, بقلة حيلة (بطريقة عاجزة)\nمثال: راقبه الحشد بقلة حيلة",
 "しかたのない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / بدون جدوى / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه / غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "しかっけい": "رُبَاعِيّ الْأَضْلَاع / رُبَاعِيّ الْجَوَانِب",
 "しかつく": "مِنْطَقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "しかつめらしい": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "しかつもんだい": "حَيَاتِيّ, مَصِيرِيّ (بالغ الأهمية على نحو حيوي)",
 "しかと": "تَجَاهَلَ, طَنَّش / بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ / بشكل متميز, بوضوح (واضح للعقل؛ بتمييز عقلي واضح) / بِشَكْل وَاضِح, بِوُضُوح (بدرجة متميزة) / بِتَمَيُّز, بِشَكْل مُمَيَّز (بطريقة مميزة وقابلة للتمييز)\nمثال: إنه ممكن بوضوح / بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم",
 "しかない": "هُنَاكَ, يُوجَدُ\nمثال: 金は少ししかない。 — لدي القليل من المال.",
 "しかにく": "لَحْم الْأَيِّل (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "しかのつの": "قَرْن الْأَيِّل (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "しかのみならず": "أَيْضًا, كَذٰلِكَ",
 "しかばな": "جهنمية ملساء, زهرة الورق (كرمة برازيلية تميل للإزهار بشكل مستمر)",
 "しかばね": "جُثَّة, جُثْمَان",
 "しかめっつら": "عُبُوسة, عُبُوس / عَبَسَ, عَقَدَ حَاجِبَيْهُ",
 "しかめっ面": "عُبُوسة, عُبُوس / عَبَسَ, عَقَدَ حَاجِبَيْهُ",
 "しかめつら": "عُبُوسة, عُبُوس / عَبَسَ, عَقَدَ حَاجِبَيْهُ",
 "しかめづら": "عُبُوسة, عُبُوس / عَبَسَ, عَقَدَ حَاجِبَيْهُ",
 "しかめる": "ثَلْم (ثلَم الإناءَ: كسر حرفَه؛ ثلَم الحائطَ: أحدث خلل أو شقّ في الحائط)",
 "しかめ面": "عُبُوسة, عُبُوس / عَبَسَ, عَقَدَ حَاجِبَيْهُ",
 "しかも": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك / لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "しからずば": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "しからずんば": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "しからば": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "しかり": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / تَعْنِيف, تَقْرِيع (توبيخ شخص ما بقسوة)",
 "しかりつける": "تَأْنِيب, تَوْبِيخ (فعل أو تعبير عن النقد واللوم)\nمثال: اضطر لتلقي التوبيخ بابتسامة على وجهه",
 "しかりとばす": "وَبَّخَ (التأنيب بشدة)",
 "しかる": "اِمْرَأَة سَلِيطَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ) / وَبَّخَ (التأنيب بشدة)\nمثال: أنا امرأة قوية.",
 "しかるうえは": "بِمَا أَنّ, أَمَا وَأَنّ",
 "しかるに": "بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال",
 "しかるのち": "بعد ذلك, منذ ذلك الحين (من ذلك الوقت فصاعداً)\nمثال: بعد ذلك لم يتصل أبداً مرة أخرى",
 "しかるべき": "سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب",
 "しかるべく": "بشكل لائق, بشكل مناسب (بما يتوافق مع ما هو مناسب أو ملائم للظروف)\nمثال: كان يرتدي ملابس مناسبة",
 "しかるを": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "しかる上は": "بِمَا أَنّ, أَمَا وَأَنّ",
 "しかる後": "بعد ذلك, منذ ذلك الحين (من ذلك الوقت فصاعداً)\nمثال: بعد ذلك لم يتصل أبداً مرة أخرى",
 "しかれども": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "しかれば": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي. / بِالْمُنَاسَبَةِ, عَلَى فِكْرَةٍ",
 "しかん": "مُؤَرِّخ, مُؤَرِّخَة / مَأْمُور / مَسْؤُول / ضَابِط / اِسْتِرْخَاءْ / ارتعاج, تشنج الحمل (حالة سامة تتميز بتشنجات وربما غيبوبة أثناء الحمل أو بعده مباشرة) / اشتهاء الموتى, نيكروفيليا (انجذاب جنسي لا يقاوم نحو الجثث) / عَيْن, عين (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / سُمّ, خُرْبَة (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط)\nمثال: كان عين ليلى مسودة. / أنبوب غربالي (أنبوب يتكون من خلايا متصلة من طرف لآخر تتدفق من خلالها العناصر الغذائية في النباتات الزهرية والطحالب البنية)",
 "しかんがっこう": "أَكَادِيمِيَّةٌ عَسْكَرِيَّة",
 "しかんしきかごうぶつ": "مركب حلقي أليفاتي (مركب أليفاتي يحتوي على حلقة من الذرات)",
 "しかんせいまひ": "شلل رخو (ضعف أو فقدان توتر العضلات الناتج عن إصابة أو مرض في الأعصاب التي تغذي العضلات)",
 "しかんせつ": "مفصل بين السلاميات (أي من المفاصل بين سلاميات أصابع اليد أو القدم)",
 "しかんぜんしょう": "تسمّم الحمل",
 "しかインプラント": "زرعة سنية (زرعة تحل محل سن طبيعي)",
 "しが": "أسنان, نظام الأسنان (نوع وعدد وترتيب الأسنان (مجتمعة) في شخص أو حيوان) / شِيغَا",
 "しがい": "ضَاحِيَة / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي. / منطقة حضرية, منطقة مأهولة (منطقة جغرافية تشكّل مدينة أو بلدة) / فَوْقَ البَنَفْسَجِيّ (ذُو أَطْوَالٍ مَوْجِيَّةٍ أَقْصَرَ مِنَ الضَّوْءِ المَرْئِيِّ وَأَطْوَلَ مِنَ الأَشِعَّةِ السِّينِيَّة) / أشعة فوق بنفسجية (إشعاع يقع في النطاق فوق البنفسجي؛ أطوال موجية أقصر من الضوء ولكن أطول من الأشعة السينية) / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "しがいか": "تَمَدُّن, تَحَضُّر",
 "しがいきょくばん": "رمز المنطقة (رقم يتكون عادة من 3 خانات يُخصص لمنطقة هاتفية كما هو الحال في الولايات المتحدة وكندا)",
 "しがいこう": "أشعة فوق بنفسجية (إشعاع يقع في النطاق فوق البنفسجي؛ أطوال موجية أقصر من الضوء ولكن أطول من الأشعة السينية)",
 "しがいせん": "اقتتال شوارع / أشعة فوق بنفسجية (إشعاع يقع في النطاق فوق البنفسجي؛ أطوال موجية أقصر من الضوء ولكن أطول من الأشعة السينية)",
 "しがいせんりょうほう": "أشعة فوق بنفسجية (إشعاع يقع في النطاق فوق البنفسجي؛ أطوال موجية أقصر من الضوء ولكن أطول من الأشعة السينية)",
 "しがいち": "منطقة حضرية, منطقة مأهولة (منطقة جغرافية تشكّل مدينة أو بلدة)",
 "しがいつうわ": "مكالمة مدفوعة (مكالمة هاتفية بعيدة المدى بتكلفة أعلى من السعر المحلي)",
 "しがいでんしゃ": "ترام, قطار شوارع (مركبة بعجلات تسير على قضبان وتدفع بالكهرباء)",
 "しがいでんわ": "مكالمة بعيدة المدى, مكالمة دولية (مكالمة هاتفية تتم خارج منطقة الاتصال المحلية)\nمثال: تحدثت معها عبر مكالمة بعيدة المدى",
 "しがきょうせいじゅつ": "تقويم الأسنان (فرع طب الأسنان الذي يتعامل مع الوقاية من أو تصحيح عدم انتظام الأسنان)",
 "しがく": "طب الأسنان (فرع الطب المعني بتشريح وتطور وأمراض الأسنان) / شعرية, فن الشعر (دراسة الأعمال الشعرية)",
 "しがくし": "تأريخ, علم التأريخ (كتابة التاريخ) / تأريخ, علم التاريخ (مجموعة من الأدبيات التاريخية)",
 "しがくしゃ": "مُؤَرِّخ, مُؤَرِّخَة",
 "しがくぶ": "كلية طب الأسنان (كلية دراسات عليا تقدم دراسة تؤدي إلى درجات علمية في طب الأسنان)",
 "しがっか": "مُؤَرِّخ, مُؤَرِّخَة",
 "しがっこう": "مدرسة خاصة (مدرسة تم إنشاؤها وإدارتها بشكل خاص ومدعومة بالأوقاف والرسوم الدراسية)",
 "しがつ": "أَبْرِيل, نِيسَان (الشهر الرابع من السنة الميلادية الروميّة)\nمثال: أبريل شهر الرابع في السنة",
 "しがつばか": "كِذْبَةُ أَبْرِيل",
 "しがない": "لَا قِيمَةَ لَهُ, حَقِير (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة. / فَقِير / مِسْكِين / فُقَرَاء",
 "しがみつく": "تَمَسَّكَ",
 "しがみ付く": "تَمَسَّكَ",
 "しがむ": "مَضَغَ",
 "しがらみ": "هَدَّار (\"صَوْتٌ هَدَّارٌ\" : مُجَلْجِلٌ قَوِيٌّ؛ \"مَطَرٌ هَدَّارٌ\" : هَاطِلٌ بِقُوَّةٍ) / رباط, وصلة تثبيت (وصلة تثبت الأشياء ببعضها البعض) / صفد, قيد (قيد يحد أو يقيد الحرية (خاصة شيء يستخدم لربط أو تقييد سجين)) / التصاق, تلاصق (خاصية الالتصاق معاً (كالغراء والخشب) أو انضمام أسطح مختلفة التكوين) / رابطة, رابطة كيميائية (قوة كهربائية تربط الذرات)\nمثال: الالتصاق المتبادل للخلايا",
 "しがん": "أَمَل ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / رَشْف (رشف الماء أو نحوه: مصه بشفتيه؛ رشف الإناء: شرب ما فيه ولم يترك فيه شيئا) / زَفْر (زفَر الشَّخصُ : أخرج نفَسه من رئتيه بعد مدِّه إيّاه؛ أظهر تعبيرًا عن الحزن أو الألم من خلال تنهد أو صوت عميق)\nمثال: أشعر بخيبة أمل.",
 "しがんしゃ": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "しがんしょ": "تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "しき": "رُوح مَعْنَوِيَّة (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح)\nمثال: كان سامي هو روح الحفلة. / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف . / قيادة موسيقية (توجيه فرقة موسيقية أو جوقة) / إدارة (طريقة إدارة الأعمال التجارية) / طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / مَرَاسِم, طُقُوس / حَفْل رَسْمِيّ (الحَفْل: اجْتِمَاعُ الْمَاءِ فِي مَحْفِلِه؛ حَفَلَ الماءُ يَحْفِلُ حَفْلًا وحُفُولًا وحَفِيلًا)\nمثال: حفل زفافهم غدا. / عُرْس, زِفَاف / مُعَادَلَة (المُوَازَنَة؛ في الرِيَاضِيَّات: هي مسألة مُتَوَازِنَة فيها طرفين كل واحد منهما يعادل الآخر فيها مَجْهُول أو أكثر يُرَادُ استخراجه) / عَتَبَة / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / عَزِيمَة / علاقة معرفة, معرفة (علاقة أقل حميمية من الصداقة) / وَعْي (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…) / شُعُور\nمثال: إنها فاقدة الوعي. / بئر المنجم (حفر يتكون من ممر عمودي أو مائل للعثور على الخام أو تعدينه أو لتهوية المنجم) / فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / انتشار, نشر (عملية الامتداد على نطاق أوسع أو مساحة من المكان أو الزمان) / إذاعة, نشر (فتح موضوع لمناقشة واسعة وجدل) / انتشار, تفشي (عملية أو نتيجة التوزيع أو الامتداد على مساحة واسعة من الفضاء) / تأمين الهامش, هامش (مبلغ الضمان الذي يودعه العميل لدى وسيط عند الاقتراض من الوسيط لشراء أوراق مالية) / غُول",
 "しきい": "عَتَبَة / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "しきいき": "حد, عتبة (أصغر إحساس يمكن كشفه)",
 "しきいきか": "دُونَ العَتَبَةِ الوَاعِيَة (تَحْتَ عَتَبَةِ الإِدْرَاكِ الوَاعِي)",
 "しきいし": "حَجَر رَصْف (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "しきいた": "لوح أرضية (لوح في الأرضية) / أرضية السيارة (أرضية السيارة)",
 "しきいち": "عَتَبَة / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "しきいちえんざん": "عملية عتبة (عملية تجرى على المعاملات للحصول على قيمة دالة العتبة)",
 "しきいちかんすう": "دَالَّة العَتَبَة (دالة تأخذ القيمة 1 إذا تجاوزت دالة محددة للحجج عتبة معينة و 0 خلاف ذلك)",
 "しきいちそし": "عنصر العتبة (عنصر منطقي يؤدي عملية العتبة)",
 "しきいちゲート": "عنصر العتبة (عنصر منطقي يؤدي عملية العتبة)",
 "しきいをまたぐ": "أَدْخَلَ / دَخَلَ (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى.",
 "しきい値": "عَتَبَة / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "しきうつし": "تتبع, تقفي الأثر (اكتشاف ووصف مسار تطور شيء ما) / رسم تتبعي, شف (فعل رسم مخطط أو تصميم أو مسودة عن طريق الشف) / رسم شفاف, شف (رسم تم إنشاؤه بوضع ورقة نصف شفافة على الصورة الأصلية ونسخ خطوط الصورة الأصلية عليها)\nمثال: تتبع الأنساب",
 "しきかくいじょう": "عمى الألوان (عجز وراثي عن تمييز الاختلافات في درجات الألوان)",
 "しきかん": "آمِر, مُقَدَّم",
 "しきがわ": "نعل داخلي (النعل الداخلي للحذاء حيث تستقر القدم)",
 "しきき": "زير نساء, مغوٍ (رجل يستغل النساء) / مغوي (شخص سيء يغري الآخرين بالوقوع في الخطأ أو المخالفة)",
 "しききん": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "しきぎょう": "اقتصاد السوق, مشروع حر (اقتصاد يعتمد بشكل رئيسي على قوى السوق لتخصيص السلع والموارد وتحديد الأسعار)",
 "しきけん": "مَنْظَر, مَشْهَد",
 "しきご": "مُقَدِّمَة",
 "しきさい": "مُلَوَّن (لديه أو قادر على إنتاج الألوان) / لون (مظهر الأشياء (أو مصادر الضوء) الموصوف من حيث إدراك الشخص لدرجة اللون والسطوع (أو الإضاءة) والتشبع) / شبه, صبغة (مظهر خارجي أو شكلي مضلل عمداً) / لون (سمة بصرية للأشياء ناتجة عن الضوء الذي تنبعث منه أو تنقله أو تعكسه)\nمثال: فيلم ملون",
 "しきさいせっけい": "مخطط ألوان, نسق لوني (مزيج مخطط من الألوان)\nمثال: تم تحديد النسق اللوني لهذه الغرفة بواسطة مصمم داخلي",
 "しきさいゆたか": "زَاهِي الأَلْوَان, مُلَوَّن (لديه لون أو لون معين؛ تستخدم أحياناً في التركيب) / زَاهِي الأَلْوَان, مُلَوَّن (لديه الكثير من الألوان أو ألوان متنوعة) / حَيَوِيّ, مُثِير (لافت للنظر في التنوع والاهتمام)\nمثال: ورق كريب ملون",
 "しきしま": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "しきしゃ": "قَائِدُ فِرْقَاتٍ مُوسِيقِيَّةٍ / كُمْسَرِيّ, كُمْسَارِيّ / مُوَصِّل كَهْرَبَائِيّ, مُوَصِّل / آمِر, مُقَدَّم / مُطَّلِع / رَئِيس الإِطْفاء, مَأْمُور الإِطْفاء (رئيس إدارة الإطفاء)",
 "しきじ": "مَحْو الْأُمِّيَّة",
 "しきじょ": "المقر العام, مركز القيادة (مقر عسكري يسيطر منه القائد العسكري وينظم القوات)",
 "しきじょう": "شَهْوَة",
 "しきじょうきょう": "سعار جنسي, نيمفومانيا (رغبة جنسية شديدة بشكل غير طبيعي لدى النساء)",
 "しきじょうとうさく": "بَارَافِيلِيَا / اِنْحِرَاف جِنْسِيّ / شُذُوذ جِنْسِيّ",
 "しきじょえんしゅう": "المقر العام, مركز القيادة (مقر عسكري يسيطر منه القائد العسكري وينظم القوات)",
 "しきせ": "إسطبل تأجير, إيواء الخيول (رعاية (إطعام وإيواء) الخيول مقابل أجر) / تسليم, نقل قانوني (النقل الطوعي لشيء ما (سند أو حيازة) من طرف إلى آخر) / صَفْرَاوِيّ (يعاني من اضطراب كبديّ أو هضميّ أو يُوحي بذلك) / زي الخدم الموحد (زي يرتديه بعض الخدم والسائقين)",
 "しきそ": "دهان, طلاء (مادة تستخدم كطلاء لحماية أو تزيين سطح (خاصة خليط من صبغة معلقة في سائل)؛ تجف لتشكل طبقة صلبة) / خضاب, صبغة (مادة تلوين جافة (خاصة مسحوق يخلط مع سائل لإنتاج الطلاء، إلخ)) / خضاب, صبغة (أي مادة ينتج عن وجودها في الأنسجة النباتية أو الحيوانية لون مميز)",
 "しきそう": "تدرج لوني, صبغة (نوع اللون كما يتحدد بطوله الموجي السائد)",
 "しきそうかん": "دائرة الألوان, عجلة الألوان (مخطط يتم فيه ترتيب الألوان المكملة (أو أسمائها) على جوانب متقابلة من دائرة)",
 "しきそけつぼうしょう": "مهق, نقص الصباغ (غياب التصبغ الطبيعي خاصة في الجلد أو خلايا الدم الحمراء)",
 "しきそせいかんぴしょう": "جفاف الجلد المصطبغ (حالة وراثية نادرة تتميز بطفح جلدي على الجلد المكشوف يحدث في مرحلة الطفولة وحساسية للضوء مع حروق شمس شديدة؛ يورث كصفة جسدية متنحية تكون فيها عمليات…)",
 "しきそそう": "إحباط المعنويات, إفساد الأخلاق (تدمير الأساس الأخلاقي لعقيدة أو سياسة) / انهيار معنوي, تثبيط العزيمة (اكتئاب ناتج عن تقويض معنوياتك) / إحباط, تثبيط (حالة من الاضطراب والارتباك)\nمثال: أدى عدم ثباته إلى إحباط معنويات موظفيه",
 "しきそだっしつ": "زوال الصباغ, نقص التصبغ (غياب أو فقدان التصبغ (أو تصبغ أقل من الطبيعي) في الجلد أو الشعر)",
 "しきそちんちゃく": "تصبغ (تلوين الأنسجة الحية بواسطة صبغة) / تصبغ (ترسب الصبغة في الحيوانات أو النباتات أو البشر)",
 "しきたいしゃ": "رَئِيس الإِطْفاء, مَأْمُور الإِطْفاء (رئيس إدارة الإطفاء)",
 "しきたり": "عَادَة, عُرْف",
 "しきち": "مَوْضِع / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "しきつめる": "لِحَاف, بَطَّانِيَّة",
 "しきてん": "مَرَاسِم, طُقُوس / حَفْل رَسْمِيّ (الحَفْل: اجْتِمَاعُ الْمَاءِ فِي مَحْفِلِه؛ حَفَلَ الماءُ يَحْفِلُ حَفْلًا وحُفُولًا وحَفِيلًا)\nمثال: حفل زفافهم غدا.",
 "しきど": "لَوْنِيَّة",
 "しきどそくてい": "تحليل لوني, قياس اللون (التحليل الكيميائي الكمي عن طريق اللون باستخدام مقياس اللون)",
 "しきび": "نَخْر / اضمحل / تضعضع",
 "しきふ": "وَرَقَة, وَرَق",
 "しきぶとん": "فُوتُون, فُوتُون يَابَانِيّ",
 "しきへんけい": "تَحَوُّل (صَارَ غير ما كان)\nمثال: تحول ياني إلى وحش.",
 "しきべつ": "تَمْيِيْز",
 "しきべつし": "مُعَرِّف",
 "しきべつしんごう": "رَمْز نِدَاء (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "しきべつふのう": "غير قابل للتعرف عليه, مجهول الهوية (يستحيل التعرف عليه أو تحديده)",
 "しきべつめい": "مُعَرِّف",
 "しきほう": "مَرَاسِم, طُقُوس / حَفْل رَسْمِيّ (الحَفْل: اجْتِمَاعُ الْمَاءِ فِي مَحْفِلِه؛ حَفَلَ الماءُ يَحْفِلُ حَفْلًا وحُفُولًا وحَفِيلًا)\nمثال: حفل زفافهم غدا. / ربع سنوياً, كل ثلاثة أشهر (في فترات كل ثلاثة أشهر) / في أرباع الشعار (في أرباع متقابلة قطرياً من الشعار (في علم الشعارات)) / ربع سنوي (من أو يتعلق بربع (فترة زمنية) أو يتكون منه) / ربع سنوية, فصلية (دورية تصدر كل ربع سنة (أو أربعة أعداد في السنة))\nمثال: الفائدة مركبة ربع سنوياً",
 "しきぼう": "هِرَاوَة / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "しきま": "زير نساء, مغوٍ (رجل يستغل النساء) / مغوي (شخص سيء يغري الآخرين بالوقوع في الخطأ أو المخالفة)",
 "しきみ": "عَتَبَة / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "しきもう": "عمى الألوان",
 "しきもの": "سَجَّادَة, بِسَاط / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "しきゃ": "اِسْتَثْنَى (أن يشمل الكُلّ إلا جزء، ولا يكون إلا إذا كان الجزءُ جزءًا من الكل) / إِلَّا, بِاسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / مثال: لا أعرف إلا هذا.",
 "しきやみ": "حلكة, سواد (الغياب التام للضوء)\nمثال: تحسسوا طريقهم في ظلام دامس",
 "しきゅう": "مشي للقاعدة ((في البيسبول) تقدم الضارب للقاعدة الأولى بعد تلقي أربع رميات خارج منطقة الجزاء)\nمثال: تلاعب بالرامي للحصول على مشي للقاعدة / رَحِم, بَيْت الْوَلِد (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام) / مَنشَأ, رَحِم\nمثال: رحمة الله عليه. / إمداد, تزويد (نشاط توريد أو توفير شيء ما) / إعداد, تحضير (العملية المعرفية للتفكير فيما ستفعله في حالة حدوث شيء ما) / بند, شرط (شرط منصوص عليه) / إمدادات, مؤونة (مخزون أو إمداد من شيء ما (خاصة الطعام أو الملابس أو الأسلحة))\nمثال: أعيق تخطيطه للتقاعد بسبب العديد من الشكوك / مُسْتَعْجِل / بإلحاح, بشكل عاجل (بإلحاح شديد)\nمثال: إصلاح الرعاية الصحية مطلوب بشكل عاجل",
 "しきゅうがいにんしん": "حمل خارج الرحم, حمل منتبذ (حمل ناتج عن نمو الجنين في مكان آخر غير الرحم)",
 "しきゅうがく": "سماح (فعل السماح) / تَفَاوُت مَسْمُوح, سَمَاحِيَّة (فرق مسموح به؛ السماح ببعض الحرية للحركة ضمن حدود) / بدل, تعديل (مبلغ يضاف أو يخصم بناءً على ظروف مؤهلة) / بدل, مخصص (مبلغ مسموح به أو ممنوح (كما خلال فترة معينة))\nمثال: اعترض على السماح بالتدخين في غرفة الطعام",
 "しきゅうきんしゅ": "ورم ليفي (ورم حميد يحتوي على أنسجة ليفية (خاصة في الرحم))",
 "しきゅうけい": "عُنُق اَلرَّحِم",
 "しきゅうけいかん": "قناة عنق الرحم (قناة مغزلية الشكل تمتد من الرحم إلى المهبل)",
 "しきゅうけいぶ": "عُنُق اَلرَّحِم",
 "しきゅうたい": "كبيبة (مجموعة صغيرة متشابكة من الشعيرات الدموية في جسم ملبيغي؛ تقوم بتصفية الدم أثناء تكوين البول)",
 "しきゅうたいじんえん": "التهاب كبيبات الكلى (التهاب الكلية يتميز بالتهاب كبيبات الكلى)",
 "しきゅうたいのう": "محفظة بومان, محفظة كبيبية (غشاء مزدوج رقيق يحيط بكبيبة النفرون)",
 "しきゅうてきしゅつ": "استئصال الرحم (إزالة جراحية للرحم)",
 "しきゅうない": "داخل الرحم (كائن أو حادث داخل الرحم)",
 "しきゅうないひにんきぐ": "لولب رحمي (جهاز لمنع الحمل يتكون من قطعة من البلاستيك أو المعدن المثني يتم إدخالها عبر المهبل إلى الرحم)",
 "しきゅうないまく": "بطانَة الرحم",
 "しきゅうないまくえん": "التهاب الرحم, التهاب بطانة الرحم (التهاب بطانة الرحم)",
 "しきゅうないまくがん": "سرطان بطانة الرحم, سرطانة بطانة الرحم (سرطان في بطانة الرحم)",
 "しきゅうないまくしょう": "انتباذ بطاني رحمي, بطانة الرحم المهاجرة (وجود بطانة الرحم في مكان آخر غير بطانة الرحم؛ يسبب ألم ما قبل الحيض وعسر الطمث)",
 "しきゅうひん": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تَوْرِيد, تَزْوِيد / ذَخِيرَة",
 "しきゅうびん": "بريد سريع (بريد يتم توزيعه بواسطة نظام سريع وفعال)",
 "しきょ": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "しきょう": "فِيل (حيوان ثديي آكل أعشاب، وهو أكبر الحيوانات الأرضية الحية؛ (في الشطرنج) قطعة من قطع الشطرنج تتحرك بشكل قطري، ورمزها \"♗\" أو \"♝\")\nمثال: لدى الفيل أنف طويل. / تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: هو بارع في التعليم.",
 "しきょうく": "أَبْرَشِيَّة",
 "しきょうざきょうかい": "كَاتِدْرَائِيَّة",
 "しきょうざせいどう": "كَاتِدْرَائِيَّة",
 "しきょうひん": "عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ",
 "しきょうふしょう": "رهاب الموت (خوف مرضي من الموت)",
 "しきよく": "شَهْوَة",
 "しきり": "تَقْسِيم / إِرْشَادِيّ, تَوْجِيهِيّ (يُظهر الطريق بالقيادة والتوجيه؛ يفرض اتجاهاً) / مُتَكَرِّر / اِرْتَادَ (لأهله: ذهب أمامهم رائدًا ليجد النجعة والكلاء؛ المكانَ: كان من روّادِه، أي من الذين كانوا فيه منذ البدء) / رَائِع, عَظِيم / عَظِيم, كَبِير (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم.",
 "しきりと": "غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة / بشوق, بلهفة\nمثال: كانت الأخبار منتظرة بلهفة / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "しきりに": "غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة / بشوق, بلهفة\nمثال: كانت الأخبار منتظرة بلهفة / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "しきりべん": "بوابة هويس, صمام هويس (منظم يتكون من صمام أو بوابة تتحكم في معدل تدفق المياه عبر هويس)",
 "しきりや": "مُعَيَّن ذَاتِيًّا (عيّن نفسه بنفسه دون تفويض من جهة أخرى)",
 "しきる": "تَقْسِيم / مُبَاشِر / وَجَّه, قَاد (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس)\nمثال: تبدو شاحب الوجه.",
 "しきれつ": "عَاصِف, مُضْطَرِب (شَدِيد الهَيَجَان والاضْطِرَاب) / شَرِس, ضَارٍ (عَدِيمُ الرَّحْمَةِ فِي المُنَافَسَة) / جَامِح, حَادّ (يَتَّسِمُ بِشِدَّةٍ مُتَطَرِّفَةٍ فِي المَشَاعِرِ أَوِ القَنَاعَات؛ يَمِيلُ إِلَى رَدِّ الفِعْلِ العَنِيف) / شَرِس, ضَارٍ (يَتَّسِمُ بِطَاقَةٍ بَالِغَةِ العُنْفِ وَالشِّدَّة)",
 "しきわら": "مِحَفَّة / بَعْثَرَ",
 "しきん": "أموال, موارد مالية (أصول في شكل مال) / تحليل مخبري, مقايسة (اختبار كمي أو نوعي لمادة (خاصة خام أو دواء) لتحديد مكوناتها؛ يستخدم بشكل متكرر لاختبار وجود أو تركيز العوامل المعدية أو الأجسام المضادة وما إلى ذلك) / اختبار, تدقيق (تقييم لحالة الأمور) / تقرير تحليل, تقرير فحص (تقرير مكتوب عن نتائج تحليل تكوين مادة ما) / عينة الفحص, مادة الاختبار (مادة تخضع لتحليل مكوناتها)\nمثال: قاموا بفحص المحتويات",
 "しきんえんじょ": "إعانة, دعم اقتصادي (هبة مالية أو مساعدة مادية أخرى لدعم شخص أو قضية)\nمثال: مساعدة اقتصادية للمناطق الكاسدة",
 "しきんきょうきゅう": "تمويل (عملية التمويل)",
 "しきんきょり": "بشكل مباشر, بصراحة تامة (بطريقة مباشرة ولا لبس فيها) / مِنْ مَسَافَةٍ قَرِيبَة (قَرِيب بِمَا يَكْفِي لِلإِصَابَة المُبَاشِرَة لِلهَدَف) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)\nمثال: سألته بصراحة تامة عما إذا كان يريد الوظيفة",
 "しきんぐり": "تمويل (عملية التمويل)",
 "しきんせき": "مِحَكّ (محك الشّخص:أكثر من الجدل بالباطل ، لَجَّ في المنازعة؛ محَكَ ، يَمْحَكُ مَحْكًا: لَجَّ فِي الأَمْرِ، وقِيلَ:المَحْكُ: التَّمادِي فِي اللَّجاجَةِ عِنْد المُساوَمَةِ والغَضَب ونَحْوِ ذَلِك)\nمثال: مستقبلنا على المحك.",
 "しきんせんじょう": "غَسِيل أَمْوَال, غَسْل أَمْوَال",
 "しきんだん": "بشكل مباشر, بصراحة تامة (بطريقة مباشرة ولا لبس فيها) / مِنْ مَسَافَةٍ قَرِيبَة (قَرِيب بِمَا يَكْفِي لِلإِصَابَة المُبَاشِرَة لِلهَدَف) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)\nمثال: سألته بصراحة تامة عما إذا كان يريد الوظيفة",
 "しきんてあて": "تمويل (عملية التمويل) / تمويل, دعم مالي (الموارد المالية المقدمة لجعل مشروع ما ممكناً)\nمثال: قدمت المؤسسة الدعم للتجربة",
 "しきんていきょうしゃ": "مُسْتَثْمِر, مُسْتَثْمِرَة",
 "しきんなん": "تدفق نقدي (فائض الإيرادات النقدية عن المصروفات النقدية في فترة زمنية معينة (لا يشمل المصروفات غير النقدية))",
 "しきんめん": "مَالِيّ (مَالِي هي دولة تقع في وسط إفريقيا؛ مالي:نقودي، أموالي)\nمثال: زيري من المالي.",
 "しきんをだす": "ذَخِيرَة / مَوَّل",
 "しぎ": "حَالَة, وَضْع / مُشَاوَرَة, اِسْتِشَارَة / فَرَضِيَّة, اِفْتِرَاض (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف الحَقِيقَة. كلمة حديثة) / تَخْمِين\nمثال: الحقائق تؤكد هذه الفرضية. / دُرَّيْجَة",
 "しぎかい": "المجلس البلدي, مجلس المدينة (هيئة بلدية يمكنها إصدار المراسيم وتخصيص الأموال وغيرها)",
 "しぎかいぎいん": "المجلس البلدي, مجلس المدينة (هيئة بلدية يمكنها إصدار المراسيم وتخصيص الأموال وغيرها)",
 "しぎだちょう": "تنام (طائر صيد ثقيل الجسم صغير الجناحين من أمريكا الجنوبية يشبه الطيور الدجاجية ولكنه قريب من الطيور المسطحة الصدر)",
 "しぎゃく": "سادية",
 "しぎゃくせい": "سادية",
 "しぎゃくてき": "سادى",
 "しぎょう": "فاتِحَة (لفَاتِح؛ سُوْرَة الْفَاتِحَة : أعظم سورة في القرآن الكريم وسميت بذلك لأنها افتتح بها المصحف في الكتابة، ولأنها تفتتح بها الصلاة في القراءة)\nمثال: لدى نبات الخلنج هذا أزهار وردية فاتحة. / أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية / مِيرَاث, إرْثْ / مَطْمَح",
 "しぎょうじかん": "استهلال, انطلاق (الوقت الذي يفترض أن يبدأ فيه شيء ما)\nمثال: بدأوا بداية مبكرة",
 "しぎん": "لِثَة, لَثَة / صَمْغ / عِلْكَة",
 "しぎんえん": "التهاب اللثة (التهاب اللثة)",
 "しく": "شَارِع, زَنَقَة / نَظْم (نَظَّمَه تَنْظِيمًا:أَلَّفَه وجَمَعَه فِي سِلْكٍ فانْتَظَمَ وتَنَظَّمَ ، وَمِنْه:نَظَمْتُ الشِّعْرَ ونَظَّمْتُه؛ نَظّم الأشياء :نظمها ،رتّبها،وضمّ بعضها إلى بعض في صورة منسّقة) / بَيْت (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت) / آيَة, عَدَد (العَلامَة أو الأمَارَة؛ المُعْجِزَة)\nمثال: نظم سامي كل شيء. / تَفَرَّقَ (تفرق الشَّيْء تفَرقا وتفراقا تبدد وَالرجلَانِ ذهب كل مِنْهُمَا فِي طَرِيق؛ تفرَّقَ) / فَرَّقَ / مُنْتَشِر, مُتَفَرِّق\nمثال: أتستطيع أن تفرق توم من أخيه؟ / وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / عَبَّأَ, نَشَرَ / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل. / مُبَارَاة / شَحّاطَة, شَخَّاطَة / سَبَقَ (سَبَقَهُ إِلَى الشيءِ يَسْبِقَهُ سَبْقًا: تقدَّمَهُ؛ يقال سَبَقَ الفرسُ في الحَلْبةِ: جاءَ قبل الأَفراسِ)\nمثال: سبق و رأيت ذلك.",
 "しくうかん": "حيز بصري (الإدراك البصري للمكان)",
 "しくさる": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "しくしく": "بُكَاء / باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / بِلَا انْقِطَاع, بِلَا تَوَقُّف (بعزيمة لا تكل)\nمثال: العالم يتغير باستمرار",
 "しくしくなく": "شهيق, شهقة / شَهِقَ (تنفس بصوت عالٍ وبشكل مفاجئ نتيجة التعب أو الخوف أو الضيق؛ في لغة الطيور: أصدرت صوتًا عاليًا يشبه الشهيق)",
 "しくしく泣く": "شهيق, شهقة / شَهِقَ (تنفس بصوت عالٍ وبشكل مفاجئ نتيجة التعب أو الخوف أو الضيق؛ في لغة الطيور: أصدرت صوتًا عاليًا يشبه الشهيق)",
 "しくじり": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "しくじる": "أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "しくち": "طَرِيقَة, مِنْهَج",
 "しくちょうそん": "إدارة محلية, حكومة محلية (حكومة منطقة محلية)",
 "しくつ": "توقع, احتمال / تَنْقِيْب (نقّب إذا سار في البلاد طلباً للمهرب ، نقّب عن الأخبار وغيرها:بحث عنها،هو البحث عن كلّ شيء والتّفتيش مطلقاً؛ نقّب مبالغة في نَقَب ، نقّب عن الشيء :فحص عنه فحصاً بليغاً)",
 "しくつしゃ": "منقّب (شخص يستكشف منطقة بحثاً عن رواسب معدنية)",
 "しくはなし": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "しくみ": "هَيْكَل / خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "しくむ": "وصية عقارية ((قانون) هبة لممتلكات عقارية بموجب وصية) / وصية عقارية (وصية للتصرف في الممتلكات العقارية)",
 "しくよろ": "مَعَ أَطْيَب التَحْيَات (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "しくる": "أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "しくんし": "اَلسَّيِّد, سَيِّد",
 "しぐさ": "لَفْتَة, إِشَارَة / تَمْثِيل",
 "しぐれ": "ديمة, زخات مطر (فترة قصيرة من الهطول)\nمثال: توقفت المباراة بسبب زخة مطر قصيرة",
 "しけ": "تَرَاجُع",
 "しけい": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام. / اقتصاص ذاتي, الأمن الأهلي (أفعال لجنة أمن أهلي في محاولة لإنفاذ القوانين) / رَوْسَم / شعر, قصيدة (مؤلف مكتوب بتفعيلات مترية تشكل أسطراً إيقاعية)",
 "しけいおん": "صامت سني, صامت لثوي (صامت يُنطق بطرف اللسان بالقرب من حافة اللثة)",
 "しけいしっこう": "تَنْفِيذ / إِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "しけいしっこうにん": "جَلَّاد",
 "しけいせいど": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "しけいだい": "سِقَالَة, إِسْقَالَة",
 "しけいふう": "هواء خفيف (رياح تتحرك بسرعة 1-3 عقد؛ 1 على مقياس بوفورت)",
 "しけっぽい": "رُطُوبة",
 "しけつ": "إرقاء, قطع النزف (إجراء جراحي لوقف تدفق الدم)",
 "しけつざい": "مُرْقِئ, مُوقِف لِلنَّزِيف (يميل إلى وقف النزيف عبر تقليص الأنسجة أو الأوعية الدموية)",
 "しけつたい": "عاصِبَة",
 "しけつやく": "مُرْقِئ, مُوقِف لِلنَّزِيف (يميل إلى وقف النزيف عبر تقليص الأنسجة أو الأوعية الدموية)",
 "しけもく": "عقب سيجارة (جزء صغير من السيجارة يتبقى بعد التدخين)",
 "しけん": "اِخْتِبَار, اِمْتِحَان (اختبر الشّيء:خبره) / فَحْص (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض) / اِمْتِحَان, اِخْتِبَار (اِمْتِحَان)\nمثال: تم اختبار زيري. / مُحَاكَمَة (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري.",
 "しけんかん": "فاحص, مفتش (محقّق يراقب ويدقق بعناية) / مختبِر, ممتحِن (شخص يدير اختبارًا لتحديد مؤهلاتك)\nمثال: بحث الفاحص عن أدلة / أُنْبُوب اِخْتِبَار",
 "しけんかんたて": "أُنْبُوب اِخْتِبَار",
 "しけんかんとく": "مراقبة الامتحانات (مراقبة المرشحين في الامتحان لمنع الغش)",
 "しけんかんベイビー": "طفل الأنابيب (طفل تم الحمل به عن طريق الإخصاب الذي يحدث خارج جسم الأم)",
 "しけんかんベビー": "طفل الأنابيب (طفل تم الحمل به عن طريق الإخصاب الذي يحدث خارج جسم الأم)",
 "しけんこうてい": "فترة اختبار, فترة تجريبية (فترة زمنية يتم خلالها اختبار شخص أو شيء ما)",
 "しけんこうもく": "قضية اختبارية (إجراء قانوني تمثيلي من المحتمل أن تصبح نتيجته سابقة قضائية)",
 "しけんこうもくあやまり": "قضية اختبارية (إجراء قانوني تمثيلي من المحتمل أن تصبح نتيجته سابقة قضائية)",
 "しけんし": "ورق اختبار (ورق مشبع بمؤشر للاستخدام في الاختبارات الكيميائية) / ورقة امتحان (امتحان تحريري)",
 "しけんしつ": "مَعْمَل, مُخْتَبَر (موضع العَمَل. المَبْنَى الذي يعمل فيه العُمَّال؛ قد يقصد به الوَرْشَة) / مُخْتَبَر, مَعْمَل",
 "しけんじっこう": "اختبار, تجربة (تجربة شيء ما لمعرفة المزيد عنه)\nمثال: عينة للتجربة المجانية لمدة عشرة أيام",
 "しけんじょう": "مَعْمَل, مُخْتَبَر (موضع العَمَل. المَبْنَى الذي يعمل فيه العُمَّال؛ قد يقصد به الوَرْشَة) / مُخْتَبَر, مَعْمَل",
 "しけんずみ": "مُجَرَّب, مُخْتَبَر (تَمَّ اخْتِبَارُهُ وَثَبَتَتْ مَوْثُوقِيَّتُهُ) / مُجَرَّب, مُخْتَبَر (تمّ اختباره وثبتت فائدته أو صحّته)",
 "しけんたい": "عَيِّنَة (جزء من الأنسجة أو الدم أو البول يؤخذ لأغراض التشخيص) / عينة, نموذج (مثال يعتبر نموذجياً لفئته)\nمثال: جمعوا عينة بول لتحليل البول",
 "しけんちゅう": "تَحْتَ التَّجْرِبَة, قَيْدَ الاِخْتِبَار (في طَوْر الاختبار أو التجريب)",
 "しけんてき": "تَجْرِيبِيّ, رَصْدِيّ (يعتمد على الملاحظة أو التجربة) / اِخْتِبَارِيّ, تَجْرِيبِيّ (ذو طبيعة تجريبية أو يخضع لتجربة) / تجريبي (يتعلق بالتجربة أو يعتمد عليها)\nمثال: فيزياء تجريبية",
 "しけんほう": "تحليل مخبري, مقايسة (اختبار كمي أو نوعي لمادة (خاصة خام أو دواء) لتحديد مكوناتها؛ يستخدم بشكل متكرر لاختبار وجود أو تركيز العوامل المعدية أو الأجسام المضادة وما إلى ذلك) / اختبار, تدقيق (تقييم لحالة الأمور) / تقرير تحليل, تقرير فحص (تقرير مكتوب عن نتائج تحليل تكوين مادة ما) / عينة الفحص, مادة الاختبار (مادة تخضع لتحليل مكوناتها)\nمثال: قاموا بفحص المحتويات",
 "しけんやすみ": "إجازة, وقت راحة (فترة زمنية لا يُطلب منك العمل فيها)\nمثال: طلب إجازة لحضور جنازة جدته",
 "しけんよう": "اِمْتِحَان, اِخْتِبَار (اِمْتِحَان) / اِمْتَحَنَ (وضع الشخص في محنه ليعرف كم يستطيع أن يحتمل وما سيكون رد فعله؛ اختبر وفحص؛ أن يسأل الملعلم الطلاب عن الدرس ليعلم كم تعلّموا) / اِمْتَحَنَ, اِخْتَبَرَ (وضع الشخص في محنه ليعرف كم يستطيع أن يحتمل وما سيكون رد فعله؛ اختبر وفحص؛ أن يسأل الملعلم الطلاب عن الدرس ليعلم كم تعلّموا)\nمثال: لدي امتحان غدا.",
 "しげい": "مُتَكَرِّر / اِرْتَادَ (لأهله: ذهب أمامهم رائدًا ليجد النجعة والكلاء؛ المكانَ: كان من روّادِه، أي من الذين كانوا فيه منذ البدء) / سَمِيك, غَلِيظ / غَلِيظ",
 "しげき": "مثير, محفز (أي معلومة أو حدث محفز؛ يعمل على إثارة العمل) / دفعة, قوة دافعة مفاجئة (فعل تطبيق قوة فجأة) / اندفاع, حافز (قوة تحرك شيئاً ما للأمام)\nمثال: الدفعة المفاجئة أسقطته أرضاً / اضطراب, هياج (اضطراب عادة ما يكون احتجاجاً) / إثارة, تهيج (شيء يسبب الاضطراب والإثارة) / إثارة, انتعاش (الشعور بفرح حيوي ومبهج) / إثارة, انفعال (حالة الاستثارة العاطفية والانفعال)\nمثال: تطلع إلى إثارة اليوم",
 "しげきざい": "مُنَشِّط, مُنَبِّه / تشجيع, حافز (تأثير تحفيزي إيجابي)",
 "しげきせい": "إزعاج, غيظ (فعل إقلاق أو إزعاج شخص ما) / إغاظة, استفزاز (سلوك غير ودي يسبب الغضب أو الاستياء) / انزعاج, ضيق (شعور غير مريح بالألم العقلي أو الضيق) / فورة غضب, هيجان (نوبة مفاجئة من الغضب)\nمثال: اشتعل غضبه كالحطب الجاف",
 "しげきてき": "مُبْهِج, مُحَفِّز (يجعل النفس حيّة ومبتهجة) / مثير, محفز (يثير أو ينشط النشاط أو الحواس) / مُحَفِّز, مُنَبِّه (ذو تأثير تنبيهي وتحفيزي)\nمثال: مناقشة محفزة",
 "しげきぶつ": "مُنَشِّط, مُنَبِّه",
 "しげきやく": "مُنَشِّط, مُنَبِّه",
 "しげく": "غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة",
 "しげしげ": "غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة / بتركيز, بثبات (بطريقة ثابتة ومركزة)\nمثال: حدق بي بثبات",
 "しげみ": "عَرِين (اِسْمٌ لِمَاْوَى الأَسَد)",
 "しげん": "مَوْرِد / نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "しげんすう": "أَرْبَعَة, رُبَاعِيّ (العدد الأصلي الذي هو مجموع ثلاثة وواحد)",
 "しこ": "أَشَارَ, أَوْمَأَ / جِوَار, قُرْب / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جِوَار\nمثال: ينبح كلب في الحي. / قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح. / حَقِير, دَنِيء (مستنكَر أخلاقياً؛ يستحق الاحتقار) / غير جدير, لا يستحق (يفتقر إلى القيمة أو الاستحقاق) / غَيْرُ مُسْتَحِقٍّ (لَا يَسْتَحِقُّ التَّقْدِيرَ أَوِ المُكَافَأَةَ)\nمثال: طرد طالب يعتبر سلوكه غير جدير",
 "しこう": "قَصْد, إِرَادَة / فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة. / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / إِرْشَادِيّ, تَوْجِيهِيّ (يُظهر الطريق بالقيادة والتوجيه؛ يفرض اتجاهاً) / اتجاهي (متعلق بـ أو يشير إلى الاتجاهات في الفضاء) / توجيهي (متعلق بالاتجاه نحو هدف (غير مكاني))\nمثال: ميكروفون اتجاهي / أَعْلَى, سَيِّد (الأَعْظَم مَكَانَةً أَوْ سُلْطَةً أَوْ قُوَّةً) / أَسْمَى, سَامٍ (في أعلى درجة أو أقصاها؛ بالغ الشدة) / أَسْمَى, أَعْلَى (نهائي أو أخير في الحياة أو مسيرة التقدم) / أَسْمَى, أَعْلَى (الأعلى في التميز أو الإنجاز) / اختبار, تجربة (تجربة شيء ما لمعرفة المزيد عنه)\nمثال: عينة للتجربة المجانية لمدة عشرة أيام / لوحة تذكارية نحاسية, لوحة معدنية (نصب تذكاري مصنوع من النحاس الأصفر) / لويحة ((علم الأمراض) رقعة غير طبيعية صغيرة على أو داخل الجسم) / ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول. / إنفاذ, تطبيق (فعل الإنفاذ؛ ضمان الامتثال أو الطاعة لـ) / أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية / بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء. / أرجوان بصري, رودوبسين (خضاب ضوئي أحمر في العصي الشبكية للفقاريات؛ يتحلل إلى ريتينال بواسطة الضوء)",
 "しこうか": "حِنَّاء (الحِنَّاءُ : نَبَات من الفصيلة الخثرية التي تتبع رتبة الآسيّات، وَرَقُهُ كورق الرُّمان وعيدانه كعيدانه، له زهر أبيضَ كالعناقيد، وَرَقُهُ أخْضَرُ…؛ خضاب أحمر يُؤخذ من ورق شجرة الحِنَّاء)\nمثال: طائر ابو الحناء هو من اشهر الطيور المغردة التي تعيش في انكلترا .",
 "しこうかいろ": "تسلسل الأفكار, حبل الأفكار (الروابط التي تربط أجزاء مختلفة من حدث أو حجة معاً)\nمثال: لم أستطع متابعة حبل أفكاره",
 "しこうさ": "تَصَالُب بَصَري (تقاطع العصبين البصريين القادمين من العينين عند قاعدة الدماغ)",
 "しこうさくご": "التَّجْرِبَة وَالْخَطَأ",
 "しこうして": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "しこうせい": "اتجاهية, توجيهية (خاصية الميكروفون أو الهوائي بكونه أكثر حساسية في اتجاه واحد من الآخر) / توجيهية (صفة التوجيه أو القدرة على التوجيه)\nمثال: تلقى الهوائي إشارات دون توجيهية / عمد, قصدية (معبر عن النوايا) / إصبعي السير, مترجل على الأصابع ((عن الثدييات) السير على أصابع القدمين مع رفع الجزء الخلفي من القدم (كما تفعل القطط والكلاب والخيول)) / حيوان إصبعي السير (حيوان يمشي بحيث تلامس أصابع القدم فقط الأرض مثل الكلاب والقطط والخيول)",
 "しこうせいアンテナ": "هوائي توجيهي (هوائي يرسل أو يستقبل الإشارات فقط في زاوية ضيقة)",
 "しこうていし": "ترك, هجران (فعل الهجر أو التخلي) / إذعان, استسلام (فعل لفظي للاعتراف بالهزيمة) / انحباس, حصر ذهني (عدم القدرة على تذكر أو التفكير في شيء يمكنك فعله عادة؛ غالباً ما يحدث بسبب التوتر العاطفي)\nمثال: كنت أعرف اسمه تماماً ولكن أصابني انحباس مؤقت",
 "しこうひん": "صَكّ غُفْرَان",
 "しこく": "شِيكُوكُو / دولة مدينة (دولة تتكون من مدينة ذات سيادة)",
 "しこくいぬ": "شِيكُوكُو",
 "しこくけん": "شِيكُوكُو",
 "しこくびえ": "دخن الإصبع, راجي (عشب حبوب من شرق الهند تنتج بذوره دقيقاً مراً نوعاً ما، وهو غذاء أساسي في الشرق)",
 "しこしこ": "مَطَّاطِيُّ القِوَام, يَحْتَاجُ لِلْمَضْغ ((عن القوام) يحتاج إلى المضغ) / عَلِك, كَثِير المَضْغ (يحتاج إلى كثير من المضغ) / بثبات / استمناء, جلك (مصطلحات عامية للاستمناء)",
 "しこしらえ": "تَحْضِير, إِعْدَاد",
 "しこたま": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "しこつ": "عظم غربالي (أحد عظام القحف الثمانية؛ عظم صغير مليء بجيوب هوائية يشكل جزءاً من محجر العين والتجويف الأنفي) / سُلَامَى, سُلَامِيَّة",
 "しこなす": "مِقْبَض",
 "しこみ": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب. / تَحْضِير, إِعْدَاد",
 "しこみづえ": "عصا سيف (عصا تخفي سيفاً أو خنجراً)",
 "しこむ": "ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل. / حَصَلَ (الشيء: حَصَلَ عليه؛ العلم: أخَذَه وحَازَه) / اِكْتَسَبَ, كَسَبَ\nمثال: متى حصل الحادث؟ / جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل. / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه.",
 "しこり": "كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم)\nمثال: السحابة هي كتلة بخار في السماء. / تململ, قلق (عدم القدرة على الراحة أو الاسترخاء أو السكون) / عدم ارتياح, قلق (سمة عدم الارتياح) / ارتباك, وعي مفرط بالذات (إحراج نابع من الشعور بأن الآخرين يراقبونك بشكل نقدي) / توتر, قلق (مشاعر القلق التي تجعلك متوتراً وسريع الانفعال)",
 "しこる": "جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو النَّمُوِّ)",
 "しこん": "آنِفاً",
 "しこんかんちりょう": "قناة الجذر (الممر في جذر السن الذي تدخل من خلاله أعصابه وأوعيته الدموية إلى تجويف اللب)",
 "しこんまくえん": "التهاب اللثة, مرض دواعم السن (مرض يهاجم اللثة والعظام حول الأسنان)",
 "しご": "لُغَة بَائِدَة, لُغَة مَيِّتَة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة. / خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / همس, وشوشة (التحدث بنعومة دون اهتزاز الحبال الصوتية) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "しごき": "ذُلّ (ذَلَّ الرَّجُلُ: ضَعُفَ، هَانَ، حَقُرَ؛ ذَلَّتِ الدَّابَّةُ: سَهُلَتْ، إِنْقَادَتْ)\nمثال: بذل زيري قصارى جهده. / تِكَّة, حِزَام (في و: هو الشُقَف)",
 "しごぎ": "أداة العبور (تلسكوب مثبت على محور يمتد شرقاً وغرباً ويستخدم لتوقيت عبور جرم سماوي عبر خط الزوال)",
 "しごく": "سكتة دِمَاغِيَّة / لَاطَفَ / مَلَّسَ / اِسْتَمْنَى / مَارَسَ الْعَادَة السِّرِّيَّة (ومَرِسَ؛ إله الحرب في الأساطير الرُومِيَّة، وهو المَرِيِّخ، لا يؤنث ولا يجمع)\nمثال: مارس الأمازيغية. / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / قِمَّة",
 "しごこうちょく": "تخشب الموت, تيبس الموت (تصلب عضلي يبدأ بعد 2 إلى 4 ساعات من الوفاة ويستمر لمدة 4 أيام تقريباً) / تيبس موتي, صمل موتي (تصلب مؤقت للمفاصل وتيبس عضلي يحدث بعد الموت)",
 "しごせん": "خَطّ الطُّول (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "しごせんつうか": "إتمام, إكمال (إجراء ختامي أو نهائي) / تتويج, ذروة (اللحظة الحاسمة في رواية أو مسرحية) / بلوغ القمة, عبور الزوال ((في الفلك) أعلى نقطة سماوية لجرم سماوي فوق أفق المراقب) / أوج, ذروة (مرحلة الذروة النهائية)\nمثال: مشهد فراش الموت هو ذروة المسرحية",
 "しごと": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل.",
 "しごとうた": "أغنية عمل (أغنية إيقاعية عادة لمصاحبة العمل المتكرر)",
 "しごとがえり": "فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "しごとぎ": "ملابس عمل (ملابس تلبس للقيام بعمل يدوي)",
 "しごとし": "عَامِل, شَغِّيل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "しごとだい": "طَاوِلَة عَمَل (قِطْعَة أَثَاث توضع عليها الأشياء، ولها رِجْل أو أكثر. ( أحادي)؛ لُعْبَة مشهورة في الشرق الأوسط عبارة عن لوح توضع عليه قطع من خشب بلونين ويستخدم النَّرْد للعب. (اسم علم))\nمثال: هذه ليست طاولة.",
 "しごとだいいちしゅぎ": "إدمان العمل (قهرية تجاه العمل)",
 "しごとちゅう": "فِي المُنْتَصَف تَمَامًا (الجزء أو النقطة الوسطى أو المركزية)\nمثال: في وسط الغابة",
 "しごとちゅうどく": "إدمان العمل (قهرية تجاه العمل)",
 "しごとちゅうどくしゃ": "مدمن عمل (شخص لديه حاجة قهرية للعمل)",
 "しごとにん": "مُحْتَرِف, مُحْتَرِفَة",
 "しごとにんげん": "مدمن عمل (شخص لديه حاجة قهرية للعمل)",
 "しごとのむし": "مدمن عمل (شخص لديه حاجة قهرية للعمل)",
 "しごとばか": "مدمن عمل (شخص لديه حاجة قهرية للعمل)",
 "しごとばこ": "سلة عمل, صندوق أدوات الخياطة (حاوية لحفظ أدوات ومواد العمل (خاصة للخياطة))",
 "しごとび": "يوم عمل (اليوم الذي يتم فيه إنجاز العمل)",
 "しごとべや": "غرفة عمل, مشغل (غرفة يتم فيها إنجاز العمل)",
 "しごとりつ": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة, طَاقَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / طَاقَة كَهْرَبَائِيَّة, طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: توم شعر بالقوة.",
 "しごとりょう": "حمل العمل, عبء العمل (العمل الذي يُتوقع من الشخص القيام به في وقت محدد)",
 "しごとをやめる": "اِسْتَقَالَ",
 "しさ": "اختلاف المنظر, تزيح (الإزاحة الظاهرية لجسم كما يُرى من نقطتين مختلفتين ليستا على خط واحد مع الجسم) / اِقْتِرَاح, مُقْتَرَح / تفاضلي, فارقي (متعلق بـ أو يظهر فرقاً واختلافاً) / تفاضلي (ينطوي على أو يحتوي على مشتق واحد أو أكثر (في الرياضيات)) / ترس تفاضلي, دفرنس (ترس مخروطي يسمح بتدوير عمودين بسرعات مختلفة؛ يستخدم في المحور الخلفي للسيارات للسماح للعجلات بالدوران بسرعات مختلفة عند المنعطفات) / عَامِل تَفَاضُل, فَارِق (صفة تميز بين الأشياء المتشابهة)\nمثال: معاملة تفاضلية",
 "しさい": "سند بلدي (سند تصدره حكومة ولاية أو حكومة محلية) / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية / إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم) / كَاهِن, قِسِّيس",
 "しさいに": "بِالتَّفْصِيل, تَفْصِيلًا",
 "しさいにおよばず": "هُنَاكَ, يُوجَدُ",
 "しさく": "تَكَهُّنٌ / مُضَارَبَة / سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر) / سَنَد تَأْمِين ((سَنَدَ )إِليه يَسْنُدُ سُنُودًا: رَكَنَ إِليه، واعتمد عليه واتكأَ؛ (سَنَدَ) ذَنَبُ الناقة:، خَطَرَ فضربَ قَطاتَها يَمْنَةً ويَسْرَةً)\nمثال: عاد إلى السياسة. / تَجْرِبَة, اِخْتِبَار / جَرَّبَ (أَصابَهُ الجَرَب؛ السَّيْفُ: صَدِئَ)\nمثال: جرب هذا الكسكس. / مَكَثَ, بَقِيَ / إِقَامَة",
 "しさくか": "مُفَكِّر (اسم فاعل للفعل فَكَّرَ؛ اصطلاحا: هو شَخْص له عِلْم وفِكْر ودراية يعتد بها وقادر على التَنْظِير والتَحْلِيل، غالبا ما يؤخذ رأيه في أمور العامة وغالبا ما يؤلف كتبا)\nمثال: \"مفكرة الموت\" هو واحد من أفضل عشرة مسلسلات تلفزيونية عندي.",
 "しさくてき": "تَأَمُّلِيّ, مُتَدَبِّر (مُسْتَغْرِقٌ فِي تَفْكِيرٍ عَمِيقٍ وَجِدِّيّ) / مُتَأَمِّل (شخص مكرس لحياة التأمل)",
 "しさつ": "تَفَقُّد",
 "しさついん": "مُفَتِّش, مُفَتِّشَة",
 "しさつおん": "صَفِيرِيّ / حَرْفُ صَفِير (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "しさてき": "إِيحَائِيّ, مُوحٍ (يميل إلى الإيحاء بشيء غير لائق أو فاحش) / إِيحَائِيّ, تَلْمِيحِيّ (يَمِيلُ إِلَى التَّلْمِيحِ أَوِ الإِيحَاء) / دَالّ, كَاشِف (يشير بوضوح أو يكشف؛ يُستخدَم عادة مع 'على')",
 "しさてきとくちょう": "خاصية فارقة, سمة مميزة (خاصية غريبة أو غير عادية)",
 "しさん": "إجهاض تلقائي, إسقاط (فقدان طبيعي لنتاج الحمل) / تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء / مُلْك, مَال (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / خَاصَّة / خَاصِّيَّة\nمثال: زيري ملك لنفسه. / بعثرة, نثر (عملية البعثرة) / تشتت, تفريق (الانتشار على نطاق واسع أو الطرد بعيداً) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة) / بعثرة, تشتت (العملية الفيزيائية التي تنحرف فيها الجسيمات عشوائياً نتيجة للتصادمات) / مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل! / مِلْكِيَّة خَاصَّة",
 "しさんか": "ثري, غني (شخص يمتلك ثروة مادية كبيرة)",
 "しさんじかい": "المجلس البلدي, مجلس المدينة (هيئة بلدية يمكنها إصدار المراسيم وتخصيص الأموال وغيرها)",
 "しさんぜい": "ضريبة الأراضي, ضريبة الأملاك (ضريبة رأسمالية تفرضها البلديات على الممتلكات؛ وتعتمد على القيمة المقدرة للعقار)",
 "しさんたんぽしょうけん": "أكريلونتريل بوتادين ستايرين, بلاستيك إيه بي إس (فئة من البلاستيك المركب تستخدم لصنع هياكل السيارات وحافظات الحواسيب والأجهزة الأخرى)",
 "しさんばいきゃくえき": "أرباح رأسمالية, مكاسب رأسمالية (المبلغ الذي يتجاوز به سعر بيع الأصل سعر الشراء؛ يتحقق الربح عند بيع الأصل)",
 "しさんひょう": "مِيزَان المُراجَعَة (ميزان للمدين والدائن في مسك الدفاتر بالقيد المزدوج؛ يُعد لاختبار تساويهما)",
 "しさんふさいひょう": "بَيَان مَالِيّ (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل)\nمثال: وأوضح البيان ذاته، أن الوزارة وجهت تعليمات من أجل تسخير كافة الإمكانيات البشرية والمادية للتسريع من وتيرة سير العملية.",
 "しざ": "مطل, نقطة مراقبة (مكان يمكن رؤية شيء ما منه)\nمثال: من نقطة المراقبة تلك كان بإمكانه مسح الوادي بأكمله",
 "しざい": "مِلْكِيَّة خَاصَّة / مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / مُلْك, مَال (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / خَاصَّة / خَاصِّيَّة\nمثال: زيري ملك لنفسه.",
 "しざん": "إجهاض تلقائي, إسقاط (فقدان طبيعي لنتاج الحمل)",
 "しし": "غاردينيا, ياسمين الكاب (شجيرة دائمة الخضرة تزرع على نطاق واسع لزهورها البيضاء الشمعية العطرة الكبيرة وأوراقها اللامعة) / وَارِث, وَرِيث (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى) / خَزَنَ (حفظ، إدخر، أودع في مخزن) / وَطَنِيّ, وَطَنِيَّة / قراءة, قراءة العداد (بيان حول حالة فيزيائية معينة يتم تقديمه للمستخدم بواسطة عداد أو أداة مماثلة) / دَلَالَة, مُؤَشِّر (شيء (كمسار عمل) يشار إليه على أنه مناسب أو ضروري) / دلالة, علامة (شيء يخدم للدلالة أو الإيحاء) / استطباب, دعي الاستعمال ((طب) سبب لوصف دواء أو إجراء عملية)\nمثال: لم يصدق قراءة العداد / دليل التعليمات, كتيب التعليمات (دليل يرافق عادة جهازاً تقنياً ويشرح كيفية تثبيته أو تشغيله) / أَسَد (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة) / لَيْث (أَسَد) / أسَد (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة) / سبع (اِسْمٌ وَصِفَةٌ لِلْأَسَد) / أسد (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة)\nمثال: الأسد حيوان بري. / قَمْلَة, قَمْل / قِمْلَة / جُثَّة, جُثْمَان / قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / بِدَأْب, بِمُوَاظَبَة (بعناية ومثابرة)\nمثال: عملت بمواظبة على أطروحة التخرج / مُتَوَحِّش / صَيْد / اختبار النقابة, امتحان المحاماة (امتحان يجرى على فترات منتظمة لتحديد ما إذا كان المرشح مؤهلاً لممارسة القانون في ولاية قضائية معينة)\nمثال: اجتاز امتحان النقابة في محاولته الثالثة / لَحْمٌ (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر. / مُحَافِظ, حَاكِم / بَوْل",
 "ししあい": "بدانة, سمنة مفرطة (سمنة أكثر من المتوسط)",
 "ししいろ": "خوخي, مشمشي (درجة من الوردي مشوبة بالأصفر)",
 "ししえいえい": "بِدَأْب, بِمُوَاظَبَة (بعناية ومثابرة)\nمثال: عملت بمواظبة على أطروحة التخرج",
 "ししおう": "أَسَد (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة) / لَيْث (أَسَد) / أسَد (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة) / سبع (اِسْمٌ وَصِفَةٌ لِلْأَسَد) / أسد (نوع من السباع مفترس من فصيلة السنوريات، يشتهر بفروة تحيط برقبته. أنثاه لبوة. يُعرَف بمَلِك الغابة؛  الرجل الشجاع القوي. مؤنثه أَسَدَة)\nمثال: الأسد حيوان بري.",
 "ししおき": "بدانة, سمنة مفرطة (سمنة أكثر من المتوسط)",
 "ししがき": "حِظَار",
 "ししがしら": "أيل سيكا, أيل ياباني (أيل صغير في اليابان ذو قرون متشعبة قليلاً)",
 "ししがへる": "فَقَدَ وَزْن",
 "ししがり": "صَيْد",
 "ししき": "سِفْر اَلْقُضَاة (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد)\nمثال: صاحبته في السفر. / تحكيم (فعل التحكيم (في الرياضة))\nمثال: كان التحكيم ممتازاً",
 "ししきしゃ": "القائم بالطقوس, المحتفل (رجل دين يدير احتفالاً دينياً أو خدمة دينية)",
 "ししきゅう": "بُرْج الْأَسَد, الْأَسَد (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "ししく": "خطبة عصماء, صياح (خطبة رنانة عالية الصوت تعبر عن مشاعر قوية)",
 "ししざ": "بُرْج الْأَسَد, الْأَسَد (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "ししそんそん": "الأجيال القادمة, الخَلَف (جميع الأجيال المستقبلية) / أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا",
 "ししそんぞん": "الأجيال القادمة, الخَلَف (جميع الأجيال المستقبلية) / أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا",
 "ししっぱな": "أنف أفطس (أنف قصير؛ مسطح ومقلوب في النهاية)",
 "ししっ鼻": "أنف أفطس (أنف قصير؛ مسطح ومقلوب في النهاية)",
 "ししつ": "طَبِيعَة, طبيعة / عاج (عظم (نسيج متكلس) يحيط بتجويف لب السن) / دنتين, عاج الأسنان (مادة كلسية أصلب وأكثر كثافة من العظم تشكل الجزء الأكبر من السن) / لِيبِيد, دُهْنِيَّة",
 "ししついじょうしょう": "فَرْط شَحْمِيَّات الدَّم",
 "ししとして": "بِدَأْب, بِمُوَاظَبَة (بعناية ومثابرة)\nمثال: عملت بمواظبة على أطروحة التخرج",
 "ししどうぶつ": "رباعي الأطراف (حيوان فقاري له أربعة أقدام أو أرجل أو زوائد تشبه الأرجل)",
 "ししばな": "أنف أفطس (أنف قصير؛ مسطح ومقلوب في النهاية)",
 "ししばなざる": "أَفْطَس, قَصِير الأَنْف (ذو أنف قصير وأفطس)",
 "ししばば": "إفرازات, فضلات الجسم (نفايات (مثل البول أو العرق ولكن خاصة البراز) يتم تصريفها من الجسم)",
 "ししふんじん": "ثَائِر, مُسْتَشِيط (يتّسم بغضب شديد بالغ الحدّة) / عَاتٍ, هَائِج ((عَنِ العَنَاصِر الطَّبِيعِيَّة) كَأَنَّهُ يُظْهِر غَضَبًا عَنِيفًا) / شَرِس, ضَارٍ (يَتَّسِمُ بِطَاقَةٍ بَالِغَةِ العُنْفِ وَالشِّدَّة)",
 "ししまい": "رَقَص الأَسَد (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "ししまひ": "شلل رباعي (شلل الذراعين والساقين)",
 "ししむら": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "ししゃ": "رَسُول, قَاصِد (شخص يحمل الرسائل، أو ينقل رسالة شفوية، أو يقوم برحلة قصيرة لتوصيل رسالة؛ (في الإسلام) من يبعثه الله تعالى بشَرْعٍ يعمل به ويبلغه)\nمثال: محمد رسول الله. / راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت / عرض خاص, عرض مسبق (عرض لجمهور مختار قبل الإصدار للجمهور العام) / عَرْض تَرْوِيجِيّ, مَقْطَع دِعَائِيّ (إعلان يتكون من مشاهد قصيرة من فيلم سينمائي سيظهر في المستقبل القريب)",
 "ししゃかい": "عرض خاص, عرض مسبق (عرض لجمهور مختار قبل الإصدار للجمهور العام) / عَرْض تَرْوِيجِيّ, مَقْطَع دِعَائِيّ (إعلان يتكون من مشاهد قصيرة من فيلم سينمائي سيظهر في المستقبل القريب)",
 "ししゃく": "فيكونت",
 "ししゃごにゅう": "تَقْرِيب",
 "ししゃごにゅうきのう": "تَقْرِيب",
 "ししゃざい": "مضاد للإسهال (دواء يستخدم للسيطرة على الإسهال أو إيقافه)",
 "ししゃすう": "حصيلة القتلى (عدد الوفيات الناتجة عن سبب معين مثل حادث أو معركة أو كارثة طبيعية)",
 "ししゃのしょ": "كِتَاب الْمَوْتَى (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد",
 "ししゃやく": "مضاد للإسهال (دواء يستخدم للسيطرة على الإسهال أو إيقافه)",
 "ししゅ": "شِعْرِيّ / مُرْتَفِع الدَّرَجَة / حَقَّانِيّ, عَقْلَانِيّ / مَوْضُوعِيّ / هَدَف, مَقْصَد (جاء إلى الهَدَف؛ ارتفع عن الأرض) / عَدَسَة\nمثال: لقد أخطأ الهدف.",
 "ししゅう": "تَطْرِيز / خَزَّان الْبُنْدُقِيَّة, مَخْزَن طَلَقَاتِ السِّلَاحِ / أطراف, حد خارجي (الحد الخارجي أو سطح شيء ما) / لثوي, متعلق بدواعم الأسنان (متعلق بعلاج دواعم الأسنان (اللثة والعظام))\nمثال: مرض دواعم الأسنان",
 "ししゅうえん": "التهاب اللثة, مرض دواعم السن (مرض يهاجم اللثة والعظام حول الأسنان)",
 "ししゅうちりょうがく": "طب دواعم الأسنان, علاج اللثة (فرع طب الأسنان الذي يتعامل مع أمراض اللثة والهياكل الأخرى حول الأسنان)",
 "ししゅうびょう": "التهاب اللثة, مرض دواعم السن (مرض يهاجم اللثة والعظام حول الأسنان)",
 "ししゅうわく": "طارة تطريز (إطار مصنوع من طارتين؛ يستخدم للتطريز)",
 "ししゅく": "إِقَامَة / أَلَه (أَلِهَ فلانٌ يَأْلَهُ إِلاَهَةً، وأُلُوهَةً، وألوهِيّةً: تحيَّر؛ أَلِهَ أَلَهًا: تَحيَّرَ)",
 "ししゅせい": "فارنا ((في الهندوسية) اسم التقسيم الاجتماعي الأصلي للشعب الفيدي إلى أربع مجموعات (والتي تنقسم إلى آلاف الطوائف))",
 "ししゅつ": "صَرْف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال وبمعنى الرَدّ والمَنْع) / مَصَارِيف, تَكَالِيف\nمثال: أيمكنك صرف خمسين؟",
 "ししゅつがかり": "كَاشِير, صَرَّاف / أَمِينُ الصُّنْدُوقِ (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "ししゅつきん": "إنفاق, صرف (عملية إنفاق أو صرف المال) / صرف, مصروف (مبالغ مدفوعة للسلع والخدمات قد تكون قابلة للخصم الضريبي حالياً (على عكس النفقات الرأسمالية))",
 "ししゅんき": "بُلُوغ",
 "ししょ": "أَمِين مَكْتَبَة, أَمِينَةْ مَكْتَبَة (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين. / فَرْع, غُصْن / رسالة شخصية (رسالة تتعلق بالشؤون الشخصية) / محطة فرعية (محطة فرعية يتم فيها تحويل الكهرباء للتوزيع بواسطة شبكة منخفضة الجهد)",
 "ししょう": "طَعْن / طَعْنَة / طَعَنَ / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / جارِح, طاعِن (يُسَبِّب جِراحًا أو ألَمًا حادًّا) / سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن. / عَقَبَة, حَاجِز / تَجْمِيعَة, دِيوَان / مِهَاد / صانع الأثاث, صانع الخزائن (نجار متخصص في صنع الأثاث) / اِخْتِلَاس (الخَلَسُ: الأخذ نُهْزَةومخاتلة، والاختلاس كالخَلَسِ؛ أخذه خُِلْسَةً أي اختلاسا)\nمثال: لقد اتهم باختلاس الأموال العامة. / تَكْشِيرَة سَاخِرَة, نَظْرَة ازْدِرَاء (تعبير وجهي يدل على الازدراء أو الاحتقار (برفع الشفة العليا)) / تَعْلِيق مُتَهَكِّم, مُلَاحَظَة سَاخِرَة (ملاحظة ازدرائية أو محتقرة) / غمْد الجناح (أي من الأجنحة الأمامية القرنية في الخنافس وبعض الحشرات الأخرى التي تغطي وتحمي الأجنحة الخلفية الوظيفية) / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "ししょうかかく": "نواة أسفل المهاد (كتلة بيضاوية من المادة الرمادية تقع في الجزء الذيلي من المهاد السفلي؛ مرتبطة بالجسم المخطط)",
 "ししょうかぶ": "تَحْت اَلْمِهَاد, وِطَاء (أَقَلَّ)\nمثال: أنا تحت الشجرة.",
 "ししょうくつ": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "ししょうしゃ": "خسائر, خسارة (نقصان في الأفراد أو المعدات العسكرية) / إصابة مميتة, حادث مميت (حادث يتسبب في موت شخص ما) / ضَحِيَّة حادِث, مُصاب (شخص أصيب أو قتل في حادث) / إِصابَة, خَسارَة بَشَرِيَّة (شخص أصيب أو قتل أو أسر أو فقد في اشتباك عسكري)",
 "ししょうじ": "ضَئِيل / تَصْغِيرِيّ",
 "ししょうふち": "أَهْوَج, مُتَهَوِّر (جريء بشكل متهور ومُفرِط) / طائش, متهور (شخص متهور مندفع غير مسؤول)",
 "ししょうをきたす": "عَاقَ, عَرْقَلَ / خَلْفِيّ / رِدْف, عَجِيزَة (رَدِفَهُ يَرْدَفُ رَدْفاً: رَدَفه؛ وفي التنزل العزيز)",
 "ししょかん": "مَكْتَب الْبَرِيد, بَرِيد (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها) / بَرِيد\nمثال: عاد إلى المكتب.",
 "ししょく": "بَنَفْسَجِيّ / أُرْجُوَانِيّ / مَذَاق (مَا تُدْرِكُهُ حَاسَّةُ الذَّوْق)\nمثال: التين حلو المذاق. / تذوق (أخذ كمية صغيرة في الفم لاختبار جودتها)\nمثال: كان الطهي جيدًا ولكن التذوق هو ما استمتع به أكثر / أكل الجيف (التغذية على الجثث أو الجيف)",
 "ししょくき": "غُول",
 "ししょばこ": "مَكْتَب الْبَرِيد, بَرِيد (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها) / بَرِيد\nمثال: عاد إلى المكتب.",
 "ししょばこばんごう": "مَكْتَب الْبَرِيد, بَرِيد (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها) / بَرِيد\nمثال: عاد إلى المكتب.",
 "ししん": "مَبْعُوث, وَزِير مُفَوَّض / إِبْرَة, مِخْيَط / تَوْجِيهَات / رسالة شخصية (رسالة تتعلق بالشؤون الشخصية) / أَنَانِيَّة / إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "ししんけい": "عصب بصري, عصب قحفي ثاني (العصب القحفي الذي يخدم الشبكية)",
 "ししんけいこうさ": "تَصَالُب بَصَري (تقاطع العصبين البصريين القادمين من العينين عند قاعدة الدماغ)",
 "しし座": "بُرْج الْأَسَد, الْأَسَد (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "しし鼻": "أنف أفطس (أنف قصير؛ مسطح ومقلوب في النهاية)",
 "しじ": "قراءة, قراءة العداد (بيان حول حالة فيزيائية معينة يتم تقديمه للمستخدم بواسطة عداد أو أداة مماثلة) / دَلَالَة, مُؤَشِّر (شيء (كمسار عمل) يشار إليه على أنه مناسب أو ضروري) / دلالة, علامة (شيء يخدم للدلالة أو الإيحاء) / استطباب, دعي الاستعمال ((طب) سبب لوصف دواء أو إجراء عملية)\nمثال: لم يصدق قراءة العداد / دليل التعليمات, كتيب التعليمات (دليل يرافق عادة جهازاً تقنياً ويشرح كيفية تثبيته أو تشغيله) / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة. / إسناد, تدعيم (فعل التدعيم بالدعامات) / سِرِّيَّة, خَلْوَة / رمز لفظي, لوغوغراف (رمز مكتوب واحد يمثل كلمة أو عبارة كاملة دون الإشارة إلى نطقها)",
 "しじき": "مُؤَشِّر",
 "しじきをだす": "إِشَارَة",
 "しじく": "محور خامل, محور ميت (محور يحمل عجلة ولكن بدون قوة لدفعها) / محور بصري, محور رئيسي (خط يمر عبر مركز انحناء العدسة بحيث لا ينعكس الضوء ولا ينكسر) / محور بصري (في البلورة مزدوجة الانكسار، الخط الذي لا يحدث في اتجاهه انكسار مزدوج)\nمثال: في العين الطبيعية، المحور البصري هو الاتجاه الذي تُرى فيه الأشياء بوضوح أكبر",
 "しじげん": "البعد الرابع, الزمن (الإحداثي الرابع المطلوب (إلى جانب الأبعاد المكانية الثلاثة) لتحديد حدث فيزيائي)",
 "しじご": "عاطفي, معبر عن المشاعر (يميل إلى أو يتميز بالتعبير الصريح عن العاطفة) / إِيضَاحِيّ, بَيَانِيّ (يخدم غرض العرض والتوضيح) / اسم إشارة, ضمير إشارة (ضمير يشير إلى مرجع مقصود)\nمثال: عائلة حنونة ومعبرة عن مشاعرها",
 "しじさき": "دَرِيئَة, نِيشَان / هَدَف, مَرْمًى (جاء إلى الهَدَف؛ ارتفع عن الأرض) / يَسْتَهْدِفُ\nمثال: لقد أخطأ الهدف.",
 "しじし": "عاطفي, معبر عن المشاعر (يميل إلى أو يتميز بالتعبير الصريح عن العاطفة) / إِيضَاحِيّ, بَيَانِيّ (يخدم غرض العرض والتوضيح) / اسم إشارة, ضمير إشارة (ضمير يشير إلى مرجع مقصود)\nمثال: عائلة حنونة ومعبرة عن مشاعرها / مُؤَشِّر",
 "しじしゃ": "داعم رياضي (داعم للأعضاء التناسلية يرتديه الرجال الذين يمارسون تمارين شاقة) / رباط جورب, مشد (شريط (عادة مطاطي) يرتدى حول الساق لتثبيت الجورب (أو حول الذراع لتثبيت الكم)) / مساعد, معين (شخص يساهم في تلبية حاجة أو تعزيز جهد أو غرض) / داعم, راعٍ (شخص يدعم أو يناصر شيئاً ما)\nمثال: مساعدي الذي لا يقدر بثمن",
 "しじせん": "مستوى الدعم ((سوق الأسهم) السعر الذي تصبح عنده ورقة مالية معينة جذابة للمستثمرين)",
 "しじそう": "ركيزة لغوية, لغة تحتية (لغة أصلية تساهم بخصائص في لغة شعب غازٍ يفرض لغته على السكان الأصليين) / طبقة تحتية, طبقة سفلية (أي طبقة تقع تحت أخرى) / ركيزة, طبقة تحتية (سطح ينمو عليه كائن حي أو يلتصق به) / ركيزة, مادة تفاعل (المادة التي يعمل عليها إنزيم أو خميرة)\nمثال: اللغات السلتية في بريطانيا هي ركيزة للغة الإنجليزية",
 "しじだいめいし": "اسم إشارة, ضمير إشارة (ضمير يشير إلى مرجع مقصود)",
 "しじつ": "جِدِّيّ / جَدِّيّ, جَادّ",
 "しじつたい": "جسم ثمرى (عضو متخصص لإنتاج الأبواغ)",
 "しじばん": "لَافِتَة, لَوْحَة",
 "しじぼう": "مُؤَشِّر",
 "しじま": "صَامِت, هَادِئ",
 "しじみ": "بلح البحر النهري (رخوي ذو صدفتين وفير في أنهار وسط الولايات المتحدة)",
 "しじみがい": "بلح البحر النهري (رخوي ذو صدفتين وفير في أنهار وسط الولايات المتحدة)",
 "しじみばな": "إكليل العروس (شجيرة لها زهور بيضاء صغيرة غزيرة في الربيع) / إكليل العروس, فرانكوا (شجيرة تشيلية دائمة الخضرة لها سنابل دقيقة من الزهور البيضاء الصغيرة)",
 "しじみ貝": "بلح البحر النهري (رخوي ذو صدفتين وفير في أنهار وسط الولايات المتحدة)",
 "しじやく": "مُؤَشِّر",
 "しじゅ": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "しじゅう": "باستمرار / أَرْبَعُونَ / أربعة أضعاف (بمقدار أربعة أضعاف) / أَرْبَعَةُ أَضْعَافٍ, رُبَاعِيُّ الضِّعْفِ (أربعة أمثال الكمية أو العدد) / رُبَاعِيّ (ذو أربع وحدات أو مكوّنات)\nمثال: ارتفع سعر البنزين أربعة أضعاف خلال العامين الماضيين",
 "しじゅうくにち": "اَلتَّاسِعُ وَالْأَرْبَعُونَ (العدد الترتيبي لتسعة وأربعين في العدّ)",
 "しじゅく": "مدرسة خاصة (مدرسة تم إنشاؤها وإدارتها بشكل خاص ومدعومة بالأوقاف والرسوم الدراسية)",
 "しじゅつ": "مُعَامَلَة (كيفية التَصَرُّف مع الآخرين ومدى احترامهم أو خلافه؛ عند الفقهاء: العَقْد على العَمَل ببعض الخارج مع سائِر شرائِط جوازها. وتُطَلق المعاملات على الأحكام الشرعية المتعلّقة بأمر الدنيا باعتبار بقاءِ الشخص…) / عِلَاج, مُعَالَجَة\nمثال: أساء توم معاملة ماري. / جراحة, عملية جراحية (إجراء طبي يتضمن شقاً بالأدوات؛ يتم إجراؤه لإصلاح تلف أو وقف مرض في جسم حي)\nمثال: سيحددون موعد العملية بمجرد توفر غرفة عمليات",
 "しじゅつしゃ": "مُمَارِس",
 "しじゅほうしょう": "ميدالية الشرف, وسام الشرف (أعلى وسام عسكري أمريكي يُمنح للشجاعة والإقدام في العمليات 'فوق وخارج نداء الواجب')",
 "しじゅん": "سُؤَال, سؤال (سُؤَال) / مَسْأَلَة / استفهم\nمثال: أجب على السؤال. / تسامت (الضبط الدقيق لخط رؤية التلسكوب)",
 "しじゅんかせき": "أحفورة مرشدة (أحفورة معروفة بأنها عاشت في عصر جيولوجي معين ويمكن استخدامها لتأريخ طبقة الصخور التي توجد فيها)",
 "しじゅんぎ": "مجمع أشعة, مسدد (جهاز بصري يتكون من أنبوب يحتوي على عدسة محدبة لونية في أحد طرفيه وشق في الطرف الآخر مع وجود الشق في بؤرة العدسة؛ تترك أشعة الضوء الشق كحزمة متوازية) / مسدد, ميزاء (تلسكوب صغير متصل بتلسكوب كبير لاستخدامه في ضبط خط رؤية التلسكوب الأكبر)",
 "しじゅんせつ": "الصَّوْم الْأَرْبَعِينِيّ / اَلصَّوْم اَلْكَبِير",
 "しじょ": "بِنْت / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة) / طِفْلة / بنت / فتاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "しじょう": "يَوْمًا / تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مَحْفُوظَات\nمثال: ما تاريخ اليوم؟ / سُوق (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق. / تَفَوُّق / قيادة تجريبية (اختبار صلاحية مركبة يفكر المرء في شرائها) / على الورق, نظرياً (في النظرية؛ وفقاً للحقائق المفترضة) / عَلَى الوَرَق, نَظَرِيًّا (كما هو مكتوب أو مطبوع)\nمثال: على الورق يبدو المرشح واعداً / إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…) / أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة) / انتهازية (استغلال الفرص دون النظر للعواقب على الآخرين) / خَيْطِيّ (رَقِيقُ القُطْرِ؛ يُشْبِهُ الخَيْط) / لَزِجٌ خَيْطِيّ (يُشَكِّلُ خُيُوطًا لَزِجَةً أَوْ غَرَوِيَّة) / سَهْمِيّ (يَقَع فِي مُسْتَوًى مُوَازٍ لِلمُسْتَوَى المَرْكَزِيّ لِلدَّرْز السَّهْمِيّ) / حيوية, طاقة (أسلوب حيوي خيالي (خاصة أسلوب الكتابة)) / حيوية, نشاط (قوة نشطة للجسد أو العقل) / حيوية, طاقة (بذل قوي للجهد)\nمثال: تنقل كتابته طاقة كبيرة / فَرْع, غُصْن",
 "しじょうかかく": "سعر السوق, قيمة سوقية (السعر الذي يتبادل به المشترون والبائعون السلعة في سوق مفتوح)",
 "しじょうかち": "سعر السوق, قيمة سوقية (السعر الذي يتبادل به المشترون والبائعون السلعة في سوق مفتوح)",
 "しじょうくうぜん": "غَيْر مَسْبُوق, لَمْ يُسْمَع بِهِ (لم يكن معروفاً من قبل)",
 "しじょうけいざい": "اِقْتِصَاد اَلسُّوق (بمعنى واصل عمل القصائد؛ بمعنى تَوَسَّط في الانفاق فلم يسرف ولم يقتر)\nمثال: ابني يدرس الاقتصاد.",
 "しじょうけん": "تَفَوُّق",
 "しじょうげんり": "أساسيات, مبادئ أساسية (مبادئ يمكن استنتاج حقائق أخرى منها)\nمثال: أولاً يجب أن تتعلم الأساسيات",
 "しじょうさいこう": "تَارِيخِيّ, غَيْرُ مَسْبُوق (لم يُتجاوَز في جانب ما حتى الآن)",
 "しじょうしゃ": "الْكَائِنُ الْأَسْمَى",
 "しじょうしゅぎ": "استعلاء, فوقية (الاعتقاد بأن مجموعة أو عرقاً معيناً يتفوق على الآخرين)\nمثال: استعلاء العرق الأبيض",
 "しじょうしんとう": "اختراق السوق (المدى الذي يتم فيه التعرف على منتج وشراؤه من قبل العملاء في سوق معين)",
 "しじょうじゅう": "بُنْدُقِيَّة (أنبوب لاطلاق الرصاص، وتعتبر من الأسلحة؛ الْبُنْدُقِيََة: فِي إِيطَالْيَا)\nمثال: البندقية مدينة جميلة.",
 "しじょうたい": "فتيل (سلك رفيع (عادة من التنجستن) يسخن حتى التوهج الأبيض بمرور تيار كهربائي) / خيط, خييط (بنية تشبه الخيط (كسلسلة من الخلايا تشبه السلسلة)) / خيط (ساق السداة) / خيط دقيق, لييفة (ليفة طبيعية أو اصطناعية رفيعة جداً)",
 "しじょうちゅう": "فيلاريا (ديدان أسطوانية رفيعة تشبه الخيط تعيش في دم وأنسجة الفقاريات؛ تنتقل كيرقات عن طريق الحشرات اللادغة) / رقمة شوكرانية, منقار اللقلق أحمر الساق (عشب ضار أوروبي توطن في جنوب غرب الولايات المتحدة والمكسيك له سيقان منبطحة محمرة بأوراق صغيرة تشبه السرخس وزهور صغيرة خزامية حمراء عميقة تليها ثمار…)",
 "しじょうちょうさ": "بَحْث سُوق, بَحْث السُوق (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "しじょうちょうさきかん": "بَحْث سُوق, بَحْث السُوق (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث.",
 "しじょうてったい": "الجماع المقطوع, العزل (طريقة لتحديد النسل يتم فيها بدء الجماع ولكن يتم سحب القضيب عمداً قبل القذف)",
 "しじょうとっき": "حسكة, شوكة (طرف صغير مدبب حاد يشبه السنبلة على ساق أو ورقة)",
 "しじょうぶんせき": "تحليل السوق (أبحاث تسويقية تسفر عن معلومات حول السوق)",
 "しじょうほうごう": "درز سهمي (الدرز الذي يوحد العظمين الجداريين)",
 "しじん": "حَضَر (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً؛ ويُعَدَّى فَيُقَالُ: حَضَرَه وحَضِرَه؛ حَضَرَ، كنَصَرَ وعلِمَ، حُضُورًا وحضارَةً: ضِدُّ غابَ)\nمثال: حضر كل شيئ لرحلتي. / تَاجِر, تَاجِرَة / شَاعِر, شَاعِرَة / سَامُورَاي / سِلَاح, أَسْلِحَة / حَكِيم, فَطِن (الذي يتصرف دوما بحكمة وتكون الحكمة من صفاته؛ في : هو الطَبِيب) / مَرْيَمِيَّة / شَاقِيَة\nمثال: هذه كلمات حكيمة.",
 "しす": "سَاهَمَ / تَمْوِيل, مَالِيَّة / مَوَّل / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "しすい": "مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "しすいき": "ثَقَبَ, نَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء) / مِثْقَاب, بريمة / نِظام مُنْضَمّ, تَدْرِيْبات (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: انه ثقب الاسود.",
 "しすう": "دَلِيل, فِهْرِس / فِهْرِس (كِتَاب تجمع فيه أسماء الكتب بترتيب يسهل منه إجاد العنوان المراد البحث عنه؛ فَصْل أو بَاب في أول أو آخر الكتاب ترتب فيه الأبواب والفصول ومواضعها ليسهل منه إيجاد المطلوب) / أُسّ",
 "しすうか": "ربط بمؤشر, مقايسة (نظام للتنظيم الاقتصادي: يتم ربط الأجور والفائدة بمؤشر تكلفة المعيشة لتقليل آثار التضخم)",
 "しすうかほうしき": "ربط بمؤشر, مقايسة (نظام للتنظيم الاقتصادي: يتم ربط الأجور والفائدة بمؤشر تكلفة المعيشة لتقليل آثار التضخم)",
 "しすうかんすう": "دَالَّة أُسِّيَّة (دالة يظهر فيها متغير مستقل كأس)",
 "しすうかんすうてき": "أُسِّيّ",
 "しすうてき": "أُسِّيّ",
 "しすうぶ": "صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "しすべき": "إنسان, شخص (كائن بشري؛ فرد من البشر) / فَتَّاك, مُمِيت (يُسَبِّب أَوْ قَادِر عَلَى التَّسَبُّب فِي المَوْت) / فانٍ, مائت (عرضة للموت)\nمثال: كان هناك الكثير ليفعله شخص واحد",
 "しすます": "أَدَّى",
 "しする": "سَاهَمَ / تَمْوِيل, مَالِيَّة / مَوَّل / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "しず": "ضعة, مكانة متدنية (موقف ذو مكانة أدنى؛ منخفض في المقام أو الرتبة أو الثروة أو التقدير) / تواضع المكانة, خمول (حالة كونه متواضعاً وغير مهم) / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / وَزْن / ثِقْل (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / صَامِت, هَادِئ",
 "しずい": "لب (الجزء الداخلي الرخو للسن) / مجلة إثارة, مجلة رخيصة (مجلة غير مكلفة مطبوعة على ورق رديء الجودة) / عَصِيدَة, لُبّ (أي كتلة ناعمة أو رطبة) / لب, لحم الفاكهة (جزء طري رطب من الفاكهة)\nمثال: سحقه حتى أصبح لباً / مِدَقَّة",
 "しずいくう": "تجويف اللب (التجويف المركزي للسن الذي يحتوي على اللب (بما في ذلك قناة الجذر))",
 "しずいこう": "تجويف اللب (التجويف المركزي للسن الذي يحتوي على اللب (بما في ذلك قناة الجذر))",
 "しずおか": "شِيزُوكَا",
 "しずか": "صَامِت, هَادِئ / بَطِيء / أَبْطَأَ, بَطَّأَ / هَادِئ / طَمْأَنَ",
 "しずかに": "بهدوء (برباطة جأش (خاصة في أوقات التوتر)) / برزانة, بهدوء ووقار (بطريقة رزينة وهادئة)\nمثال: تحدث بهدوء للطلاب المشاغبين",
 "しずく": "قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه.",
 "しずけさ": "سكون, هدوء تام ((شعرياً) صمت وسكون مطمئن) / انعدام الحركة, جمود (حالة عدم وجود حركة) / انعدام الرياح, سكون (هدوء بدون رياح)\nمثال: سكون الليل",
 "しずけし": "صَامِت, هَادِئ",
 "しずこころなし": "مُتَوَتِّر جَسَدِيّاً (متعلق بقلق جسدي يسبب عدم الارتياح) / غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غير مرتاح, قلق (يفتقر إلى الشعور بالأمان أو لا يوفر راحة أو طمأنينة) / غير مريح, قلق (يفتقر أو لا يوفر راحة جسدية أو عقلية)\nمثال: كان المزارعون قلقين حتى نزل المطر أخيراً",
 "しずごころなし": "مُتَوَتِّر جَسَدِيّاً (متعلق بقلق جسدي يسبب عدم الارتياح) / غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غير مرتاح, قلق (يفتقر إلى الشعور بالأمان أو لا يوفر راحة أو طمأنينة) / غير مريح, قلق (يفتقر أو لا يوفر راحة جسدية أو عقلية)\nمثال: كان المزارعون قلقين حتى نزل المطر أخيراً",
 "しずしず": "بِهُدُوء",
 "しずまる": "هَدَأَ / أَهْدَأَ, هَدَّأَ",
 "しずみこむ": "غَطَسَ / مَجْلَى, مَغْسَلَة",
 "しずむ": "غَطَسَ / مَجْلَى, مَغْسَلَة / نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف.",
 "しずめ": "غَرَق / كرة هابطة (رمية تنحني للأسفل بسرعة عند اقترابها من اللوحة) / ثقالة (وزن يغرق (لتثبيت الشباك أو خيوط الصيد تحت الماء)) / دونات, كعكة مقلية (كعكة مقلية صغيرة على شكل حلقة) / مُتَحَكِّم (قَادِر عَلَى التَّحَكُّم فِي السِّيَاسَة أَوْ تَحْدِيدِهَا)",
 "しずめる": "غَطَسَ / مَجْلَى, مَغْسَلَة / أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى. / أَرْضِيَّة, أَرْض (ما يقابل السَقْف من الغرفة؛ قاع الشيء) / طَابِق\nمثال: انهارت الأرضية. / صَامِت, هَادِئ / هَادِئ / طَمْأَنَ / سَكَّنَ (قَرَّ وهَدَأ، ضد اِضْطَرَبَ؛ وَطَنَ، يستخدم سكن عند الحديث عن البيت أو الدار ووطن عن الحديث عن البلاد أو المدينة)\nمثال: كان زيري بسكن هناك.",
 "しずわ": "حافة السرج الخلفية, قادمة السرج (الجزء الخلفي من مقعد السرج)",
 "しずんだこころ": "اعتلال المزاج, انقباض (حالة من الاكتئاب الخفيف)",
 "しせい": "وَضْعِيَّة / مَوْقِف, سُلُوك / وول ستريت (يستخدم للإشارة إلى صناعة الأوراق المالية في الولايات المتحدة) / بَلَدِيَّة / حكومة بلدية, مجلس بلدي (حكومة البلدية) / حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة. / غير رسمي (ليس له سلطة أو إقرار رسمي) / غَيْر رَسْمِيّ, غَيْر مُثَبَّت (لم يُقَرّ أو يُثبَّت رسمياً)\nمثال: نوع من العمدة غير الرسمي / أُنْثَى (شخض أو حيوان ينتمي إلى الجنس المؤنث، وهو الجنس الذي غالبًا ما يُنتج البويضة في عملية التكاثر الجنسي، ويملك اثنين من الصبغي إكس) / مثال: الفرس هي أنثى الحصان / إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…) / حيوية, طاقة (أسلوب حيوي خيالي (خاصة أسلوب الكتابة)) / حيوية, نشاط (قوة نشطة للجسد أو العقل) / حيوية, طاقة (بذل قوي للجهد)\nمثال: تنقل كتابته طاقة كبيرة / وَشْم / وَشَمَ, وَشَّمَ",
 "しせいがく": "ثاناتولوجيا, علم الموت (فرع العلم الذي يدرس الموت (خاصة جوانبه الاجتماعية والنفسية))",
 "しせいし": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "しせいじ": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "しせいじょ": "قدس الأقداس ((اليهودية) مزار مقدس يتكون من الغرفة الداخلية للمسكن في هيكل سليمان حيث كان يُحفظ تابوت العهد) / قُدْس الأَقْدَاس ((مجازياً) شيء يعتبر مقدساً أو لا يجوز انتهاكه)\nمثال: كل سياسي يخشى المساس بقدس الأقداس، نظام الضمان الاجتماعي",
 "しせいち": "رَقَم الجَوْدَة, مُعَامِل الجَدَارَة (تعبير رقمي يمثل كفاءة نظام أو مادة أو إجراء معين)",
 "しせいのしん": "أهل البلدة, سكان البلدة (الناس الذين يعيشون في بلدية أصغر من المدينة)\nمثال: هتفت البلدة بأكملها للفريق",
 "しせいのひと": "أهل البلدة, سكان البلدة (الناس الذين يعيشون في بلدية أصغر من المدينة)\nمثال: هتفت البلدة بأكملها للفريق",
 "しせいはいぐうたい": "مشيج أنثوي, نابتة عروسية كبروية (النابتة العروسية الأنثوية التي تنتجها البوغة الكبيرة لنبات ينتج كلا النوعين من الأبواغ (الصغيرة والكبيرة))",
 "しせいはっせい": "توالد أنثوي (توالد عذري أنثوي يحتوي فيه الجنين على كروموسومات الأم فقط بسبب فشل الحيوان المنوي في الاندماج مع نواة البويضة)",
 "しせき": "حَوْلِيَّات / جِيرُ الأَسْنَان, قَلَح (طبقة قشرية تتكون على الأسنان واللثة) / تتار (عضو في الشعب المنغولي في آسيا الوسطى الذي غزا روسيا في القرن الثالث عشر) / امرأة شرسة, صارمة (امرأة يقظة بشراسة وبغيضة) / طرطرات البوتاسيوم الهيدروجينية, كريم التارتار (ملح يستخدم بشكل خاص في مسحوق الخبز (البيكنج بودر)) / سَاحَة حَرْب, سَاحَة مَعْرَكَة",
 "しせきえい": "جَمَشْت",
 "しせきひふえん": "شاشة مسطحة (نوع من شاشات الفيديو رقيقة ومسطحة؛ تستخدم عادة في الحواسيب المحمولة)",
 "しせきぼ": "دولمن, منضدة صخرية (مقبرة صخرية ضخمة من عصور ما قبل التاريخ تتكون عادة من حجرين عموديين كبيرين وحجر غطاء)",
 "しせつ": "مَبْعُوث, وَزِير مُفَوَّض / مَرَافِق, مُنْشَأَة / سُهُولَة / وَطَن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن. / خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك.",
 "しせつかいせん": "خط خاص (خط هاتف يخدم مشتركاً واحداً)",
 "しせつだん": "مُهِمَّة, مَأْمُورِيَّة",
 "しせる": "مَيِّت",
 "しせるたましい": "راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "しせん": "سِيشْوَان, سِيتْشْوَان / خط فرعي (خط سكة حديد متصل بخط رئيسي) / لمحة, نظرة خاطفة (نظرة سريعة) / أَرْبَعَة آلَاف (أَرْبِعَة؛ أربعَة)\nمثال: مرت أربعة أيام. / أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري. / غُدَّة دُهْنيّة / ثَرِيّ, مُوسِر (يمتلك وفرة من المال أو الممتلكات القيّمة) / رافد (فرع يصب في المجرى الرئيسي) / مرفه, ميسور (شخص ميسور الحال؛ شخص في وضع مالي جيد)\nمثال: ما يسمى بالأثرياء الناشئين",
 "しせんしょう": "سِيشْوَان, سِيتْشْوَان",
 "しせんそくど": "سُرْعَة شُعَاعِيَّة (السرعة على طول خط البصر باتجاه الراصد أو بعيداً عنه)",
 "しせんをそそぐ": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ فُلاناً: إِذا أَصَابَ حَدَقَتَه؛ حدَق به:أَحَاطَ به من كلّ جهة (حدَقت قوات الأمن بالقرية))\nمثال: حدق الجميع في وجهي.",
 "しぜつ": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر",
 "しぜん": "طَبِيعَة, طبيعة / طَبِيعِيّ / بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "しぜんかい": "طَبِيعَة, طبيعة",
 "しぜんかがく": "علوم طبيعية (العلوم المعنية بدراسة العالم المادي وظواهره)",
 "しぜんかがくしゃ": "عالم تاريخ طبيعي, عالم طبيعة (عالم أحياء مطلع على التاريخ الطبيعي (خاصة علم النبات وعلم الحيوان))",
 "しぜんかんきょう": "بِيئَة (النُزُوْل أو المَنْزِل؛ الحَال)\nمثال: نشأ جون في بيئة سعيدة.",
 "しぜんがく": "فِيزِيَاء, فِيزِيقَا (علم الطَّبيعة أو علم الطَّبيعيَّات)\nمثال: تدرس الفيزياء النووية.",
 "しぜんげんご": "لُغَةْ طَبِيعِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "しぜんげんごしょり": "مُعَالَجَة اللُّغَات الطَبِيعِيَّة",
 "しぜんげんごりかい": "لُغَةْ طَبِيعِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "しぜんげんしょう": "ظاهرة طبيعية (جميع الظواهر التي ليست اصطناعية)",
 "しぜんさいがい": "كارثة طبيعية",
 "しぜんし": "تاريخ طبيعي (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "しぜんしげん": "موارد طبيعية (موارد (فعلية ومحتملة) توفرها الطبيعة)",
 "しぜんしはくぶつかん": "تاريخ طبيعي (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "しぜんしゅぎ": "طبيعية ((فلسفة) المذهب القائل بأن العالم يمكن فهمه بمصطلحات علمية دون اللجوء إلى تفسيرات روحية أو خارقة للطبيعة) / الطبيعية, الواقعية (حركة فنية في فرنسا في القرن التاسع عشر؛ سعى الفنانون والكتاب للحصول على وصف واقعي وواقعي مفصل)",
 "しぜんしゅぎしゃ": "عالم تاريخ طبيعي, عالم طبيعة (عالم أحياء مطلع على التاريخ الطبيعي (خاصة علم النبات وعلم الحيوان)) / طبيعاني, فيلسوف الطبيعة (مدافع عن العقيدة القائلة بأن العالم يمكن فهمه بالمصطلحات العلمية)",
 "しぜんしゅっさん": "ولادة طبيعية (المخاض والولادة بدون تدخل طبي؛ لا يتم إعطاء أي أدوية لتخفيف الألم أو المساعدة في عملية الولادة)\nمثال: تعتبر الولادة الطبيعية الأكثر أمانًا للطفل",
 "しぜんしょうめつ": "شَبَح, خَيَال",
 "しぜんしょく": "طعام صحي (أي طعام طبيعي أو محضر يعتقد شعبياً أنه يعزز الصحة الجيدة)",
 "しぜんしんがく": "اللاهوت الطبيعي (لاهوت يرى أن معرفة الله يمكن اكتسابها عن طريق العقل البشري دون مساعدة الوحي الإلهي)",
 "しぜんしんきょう": "رُبُوبِيَّة",
 "しぜんじょうたい": "برية, حالة الطبيعة (حالة بدائية برية لم تمسها الحضارة)\nمثال: عاش في البرية",
 "しぜんじんるいがく": "أنثروبولوجيا فيزيائية (فرع الأنثروبولوجيا الذي يتعامل مع نشأة وتنوع البشر)",
 "しぜんすう": "عَدَد طَبِيعِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "しぜんすうはい": "عبادة الطبيعة (نظام ديني يؤله ويعبد القوى والظواهر الطبيعية)",
 "しぜんせき": "حجر الحقل (حجر يوجد بشكل طبيعي في الحقول؛ يستخدم غالباً كمواد بناء)",
 "しぜんせんたく": "اِنْتِقَاءٌ طَبِيعِيّ",
 "しぜんたいすう": "لوغاريتم طبيعي",
 "しぜんちゆ": "برونيلا, شفيقة (نبات معمر أوروبي أزرق الزهر مستلقي يعتقد أنه يمتلك خصائص علاجية؛ مستوطن في جميع أنحاء أمريكا الشمالية)",
 "しぜんちり": "جغرافيا طبيعية (دراسة السمات الفيزيائية لسطح الأرض)",
 "しぜんちりがく": "جغرافيا طبيعية (دراسة السمات الفيزيائية لسطح الأرض)",
 "しぜんちりょう": "برونيلا, شفيقة (نبات معمر أوروبي أزرق الزهر مستلقي يعتقد أنه يمتلك خصائص علاجية؛ مستوطن في جميع أنحاء أمريكا الشمالية)",
 "しぜんてき": "طَبِيعِيّ",
 "しぜんてつがく": "فيزياء (علم المادة والطاقة وتفاعلاتهما)\nمثال: مادته المفضلة كانت الفيزياء",
 "しぜんとうた": "اِنْتِقَاءٌ طَبِيعِيّ",
 "しぜんどく": "طَبِيعِيّ الوُجُود, مَوْجُود بِالطَّبِيعَة (موجود بالطبيعة ودون تدخّل اصطناعي)",
 "しぜんのせつり": "قانون, قانون طبيعي (تعميم يصف حقائق أو أحداث متكررة في الطبيعة)\nمثال: قوانين الديناميكا الحرارية",
 "しぜんはっか": "احتراق ذاتي (اشتعال مادة (مثل الخرق الزيتية) ناتج عن عملية أكسدة داخلية)",
 "しぜんはっせい": "تولد ذاتي, نشوء تلقائي (ظاهرة عضوية افتراضية يتم من خلالها إنشاء الكائنات الحية من مواد غير حية)",
 "しぜんぶつ": "جِسْم طَبِيعِيّ (جسم موجود في الطبيعة؛ ليس من صنع الإنسان)",
 "しぜんぶんべん": "ولادة طبيعية (المخاض والولادة بدون تدخل طبي؛ لا يتم إعطاء أي أدوية لتخفيف الألم أو المساعدة في عملية الولادة)\nمثال: تعتبر الولادة الطبيعية الأكثر أمانًا للطفل",
 "しぜんぶんり": "انتزاع, قَلْع (تمزيق قسري أو فصل جراحي لجزء من الجسم عن آخر) / اجتثاث, انحراف النهر (تغير مفاجئ في مجرى النهر الذي يشكل الحدود بين قطعتين من الأرض مما يؤدي إلى فقدان جزء من أرض مالك واحد وزيادة لاحقة في أرض آخر)",
 "しぜんほう": "شريعة, قانون (قاعدة أو مجموعة قواعد للسلوك متأصلة في الطبيعة البشرية وضرورية أو ملزمة للمجتمع البشري)",
 "しぜんほうしゃせん": "إشعاع الخلفية (إشعاع قادم من مصادر أخرى غير تلك التي يتم رصدها)",
 "しぜんほうそく": "قانون, قانون طبيعي (تعميم يصف حقائق أو أحداث متكررة في الطبيعة)\nمثال: قوانين الديناميكا الحرارية",
 "しぜんほごく": "مَحْمِيَّة طَبِيعِيَّة",
 "しぜんめんえき": "مناعة طبيعية, مناعة فطرية (مناعة ضد المرض تحدث كجزء من التكوين البيولوجي الطبيعي للفرد)",
 "しぜんりつ": "شريعة, قانون (قاعدة أو مجموعة قواعد للسلوك متأصلة في الطبيعة البشرية وضرورية أو ملزمة للمجتمع البشري)",
 "しぜんりゅうざん": "إجهاض تلقائي, إسقاط (فقدان طبيعي لنتاج الحمل)",
 "しぜんりょうほう": "علاج طبيعي, نعتالوباثي (طريقة لعلاج المرض باستخدام الغذاء والتمارين والحرارة لمساعدة عملية الشفاء الطبيعية)",
 "しぜんりょうほうし": "معالج طبيعي (معالج يمارس العلاج الطبيعي (غير الدوائي))",
 "しぜんりん": "غابة بكر, غابة قديمة النمو (غابة أو أرض حرجية ذات نظام بيئي ناضج أو مفرط النضج لم يتأثر تقريباً بالنشاط البشري)",
 "しぜんれい": "أَوَّلِيّ, جَوْهَرِيّ (من الجزء الأساسي أو الجوهري أو يكونه) / عنصري (متعلق بـ أو كونه عنصراً (كيميائياً)) / جوهري, عاصف (متعلق بالظروف الجوية القاسية)\nمثال: كبريت عنصري",
 "しそ": "مُؤَسِّس, مُؤَسِّسَة / إيريسين, نبات شريحة اللحم (نبات أمريكي جنوبي ذو فروع خضراء إلى أرجوانية أو حمراء بأوراق زينة خضراء إلى أرجوانية وسنابل من زهور صوفية غير مهمة بقنابات غشائية جافة) / بريلا, نبات شريحة اللحم (نبات يزرع لأوراقه الحمراء أو الأرجوانية الزخرفية) / قضية اختبارية (إجراء قانوني تمثيلي من المحتمل أن تصبح نتيجته سابقة قضائية) / دعوى مدنية (دعوى قضائية تزعم انتهاكات للقانون المدني من قبل المدعى عليه)",
 "しそう": "إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة)) / تحريض, حث (الفعل اللفظي للحث) / فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة. / حويصلة هوائية / مَبْدَأ, قاعِدَة (أَسَاس، أَصْل؛ مُسَلَّمَة، اِفْتِرَاض، ما يسلّم به لوضوحه) / قيادة تجريبية (اختبار صلاحية مركبة يفكر المرء في شرائها)",
 "しそうえん": "التهاب الأسناخ (التهاب الأسناخ في الرئتين الناتج عن استنشاق الغبار؛ مع التعرض المتكرر قد تصبح الحالة مزمنة) / التهاب السنخ الجاف (التهاب في سنخ السن؛ يحدث أحياناً بعد قلع السن وفشل تكون جلطة دموية)",
 "しそうか": "مُفَكِّر (اسم فاعل للفعل فَكَّرَ؛ اصطلاحا: هو شَخْص له عِلْم وفِكْر ودراية يعتد بها وقادر على التَنْظِير والتَحْلِيل، غالبا ما يؤخذ رأيه في أمور العامة وغالبا ما يؤلف كتبا)\nمثال: \"مفكرة الموت\" هو واحد من أفضل عشرة مسلسلات تلفزيونية عندي.",
 "しそうけいさつ": "بوليس الفكر",
 "しそうけんご": "اسْتِقْرَار, ثَبَات (صفة الديمومة والخلو من التغيير أو التباين) / ثَبَات عَلَى العَهْد, وَفَاء (الإخلاص والاعتمادية في العلاقات الشخصية (خاصة الإخلاص الزوجي)) / ثبات إدراكي ((علم النفس) الميل لإدراك الأشياء بطريقة متشابهة جداً على الرغم من التباينات الواسعة في ظروف الملاحظة)\nمثال: اعتمد البحارة الأوائل على ثبات الرياح التجارية",
 "しそうてき": "أَيْدِيُولُوجِيّ, فِكْرِيّ (يتعلّق بالأفكار أو يُوحي بها) / أيديولوجي, عقائدي (مكون من أو متعلق بـ أو مميز لتوجه يطبع تفكير مجموعة أو أمة)",
 "しそうのうろう": "التهاب اللثة, مرض دواعم السن (مرض يهاجم اللثة والعظام حول الأسنان)",
 "しそうのじゆう": "حرية الفكر (الحق في اعتناق أفكار غير شائعة)",
 "しそうのほし": "بَنَاتُ نَعْشٍ الكُبْرَى",
 "しそく": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير. / رُبَاعِيّ الأَرْجُل (لديه أربعة أقدام) / رباعي الأرجل (حيوان خاصة الثدييات له أربعة أطراف متخصصة للمشي)",
 "しそくじゅう": "رُبَاعِيّ الأَرْجُل (لديه أربعة أقدام) / رباعي الأرجل (حيوان خاصة الثدييات له أربعة أطراف متخصصة للمشي)",
 "しそくどうぶつ": "رباعي الأطراف (حيوان فقاري له أربعة أقدام أو أرجل أو زوائد تشبه الأرجل)",
 "しそこない": "خطأ فادح, زلة (خطأ محرج)",
 "しそこなう": "خطأ فادح, زلة (خطأ محرج)",
 "しそこねる": "خطأ فادح, زلة (خطأ محرج)",
 "しそちょう": "أركيوبتركس (طائر بدائي مسنن منقرض من العصر الجوراسي له ذيل طويل مكسو بالريش وعظام مجوفة؛ يعتبر عادة الأكثر بدائية بين جميع الطيور)",
 "しそつ": "جُنْدِيّ, عَسْكَرِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: غادر ذلك الجندي.",
 "しそん": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ) / قَيْصَر, إِمْبْرَاطُور",
 "しそんじ": "خطأ فادح, زلة (خطأ محرج)",
 "しそんじる": "خطأ فادح, زلة (خطأ محرج)",
 "しそんずる": "خطأ فادح, زلة (خطأ محرج)",
 "しぞう": "اِكْتِنَاز",
 "しぞく": "إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة)) / تحريض, حث (الفعل اللفظي للحث) / تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ / سَحَبَ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه) / تَرَاجَعَ\nمثال: سحب ياني تصريحه. / اِسْتَقَالَ / قَبِيلَة, عَشِيرَة (ما دون الشَعْب وفوق العَمَارَة في تقسيم الناس؛ مجموعة كبيرة من الناس ينحدرون من جَدّ وَاحِد؛ كَيَان اِجْتِمَاعِي أو اِقْتِصَادِي أو سِيَاسِي لعَائِلَات تجمع بينها روابط القُرْبَى) / قَبِيلَة (ما دون الشَعْب وفوق العَمَارَة في تقسيم الناس؛ مجموعة كبيرة من الناس ينحدرون من جَدّ وَاحِد؛ كَيَان اِجْتِمَاعِي أو اِقْتِصَادِي أو سِيَاسِي لعَائِلَات تجمع بينها روابط القُرْبَى)\nمثال: انضم جوناس لقبيلة ريمة. / عَشِيرَة (مؤنث العَشِيْر؛ التي تعاشرها. الجمع عَشِيرَات؛ إحدى طبقات الأنساب دون الفخذ وفوق الفصيلة. الجمع عَشَائِر)",
 "しぞこなう": "خطأ فادح, زلة (خطأ محرج)",
 "しぞめ": "استهلال, انطلاق (الوقت الذي يفترض أن يبدأ فيه شيء ما)\nمثال: بدأوا بداية مبكرة",
 "した": "تَحْتَ (أَقَلَّ) / جَنُوبِيّ\nمثال: أنا تحت الشجرة. / قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما. / تَحْت (أَقَلَّ) / أَسْفَل\nمثال: أنا تحت الشجرة. / جودة منخفضة, دونية (جودة متدنية) / دونية, وضع أدنى (صفة كون الشخص في وضع تنافسي أضعف) / دونية, مكانة أدنى (حالة كونه أدنى) / لِسَان (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق؛ جَارِحَة الْكَلَام؛ كَلِمَة) / لسان (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق؛ جَارِحَة الْكَلَام؛ كَلِمَة)\nمثال: ماري لها فم ليس لها لسان. / للسان الجرس, مصفق (مطرقة معدنية تتدلى داخل الجرس وتصدر صوتاً بضرب الجانب) / لسان (كتلة متحركة من الأنسجة العضلية مغطاة بغشاء مخاطي وتقع في التجويف الفموي) / مصفق (شخص يصفق) / قَصَبَة, بُوصَة",
 "したあご": "فك سفلي (الفك في الفقاريات الذي يتمفصل ليفتح الفم)",
 "したい": "حركة فنية (مجموعة محددة مسبقاً من الحركات في الرقص أو التزلج) / تصميم, شكل (عمل زخرفي أو فني) / تمثال صغير, شكل (نموذج لشكل جسماني (خاصة لشخص)) / شخصية, هيئة (الانطباع الذي يحدثه الشخص)\nمثال: حققت أفضل درجة في الحركات الإلزامية / فصل, فك الارتباط (عملية التحرير من مرفق أو اتصال) / انفصال, تفكك (التفرق أو الانقسام) / انسحاب, تجرد (تجنب التورط العاطفي) / مفرزة (وحدة صغيرة من القوات ذات تكوين خاص) / جَسَد مَيِّت, جُثَّة (جسم طبيعي يتكون من حيوان أو إنسان ميت)\nمثال: وجدوا الجثة في البحيرة / طَرَف, عُضْو / كورسيه, مشد (رداء داخلي نسائي ضيق ومشكّل) / حزام, زنار (شريط من مادة حول الخصر يقوي التنورة أو البنطال) / حزام (بنية مطوقة أو حلقية الشكل) / شعر, قصيدة (مؤلف مكتوب بتفعيلات مترية تشكل أسطراً إيقاعية)",
 "したいあいこう": "اشتهاء الموتى, نيكروفيليا (انجذاب جنسي لا يقاوم نحو الجثث)",
 "したいあんちじょ": "مَشْرَحَة",
 "したいおきば": "مَشْرَحَة",
 "したいかいぼう": "تَشْرِيح",
 "したいけんあん": "تشريح الجثة, فحص ما بعد الوفاة (فحص وتشريح جثة ميت لتحديد سبب الوفاة أو التغيرات الناتجة عن المرض)",
 "したいけんあんしょ": "تشريح الجثة, فحص ما بعد الوفاة (فحص وتشريح جثة ميت لتحديد سبب الوفاة أو التغيرات الناتجة عن المرض) / تحليل لاحق, مراجعة ما بعد الحدث (مناقشة لحدث ما بعد وقوعه)",
 "したいごっこ": "تبليط بالألواح الخشبية (عمل تغطية منطقة بألواح خشبية) / أرضية خشبية, تبليط خشبي ((بحرياً) غطاء أو أرضية مصنوعة من الألواح الخشبية (كما في السفينة)) / ألواح خشبية (الألواح الخشبية بشكل جماعي؛ كمية من الألواح)",
 "したいせいあい": "اشتهاء الموتى, نيكروفيليا (انجذاب جنسي لا يقاوم نحو الجثث)",
 "したいといれ": "مَكُّوك / مَكُوك",
 "したいほかんじょ": "مَشْرَحَة",
 "したう": "اِشْتَاقَ / تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان. / أَلَه (أَلِهَ فلانٌ يَأْلَهُ إِلاَهَةً، وأُلُوهَةً، وألوهِيّةً: تحيَّر؛ أَلِهَ أَلَهًا: تَحيَّرَ)",
 "したうけ": "عقد من الباطن (عقد يسند إلى طرف آخر بعض التزامات عقد سابق) / مقاول",
 "したうけおい": "عقد من الباطن (عقد يسند إلى طرف آخر بعض التزامات عقد سابق)",
 "したうけがいしゃ": "مقاول",
 "したうけぎょうしゃ": "مقاول",
 "したえ": "تَخْطِيط, تصميم (مصدر من خَطَّطَ؛ في : فكرةٌ مُثبتة بالرسم، أو الكتابة في حالة الخطّ. تدلّ دلالةً تامَّة على ما يُقصد في الصُّورة أو الرسم أَو اللَّوح المكتوب من المعنى والموضوع…) / تَصْمِيم, ديزاين\nمثال: يعمل في قسم التخطيط.",
 "したおし": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "したおす": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "したおび": "سروال تحتي, مئزر (رداء يوفر غطاءً لمنطقة العانة والوركين)",
 "したがい": "وَفْقًا لِ",
 "したがう": "أَطَاعَ / تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان. / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "したがえる": "قَهَرَ, اِنْتَصَرَ (غَلَبَ وانْتَصَرَ ولم يقدر عليه أحد)",
 "したがき": "مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "したがたどうぶつ": "دودة اللسان (مفصلي يشبه الدودة له زوجان من الخطافات على جانبي الفم؛ طفيلي في الجيوب الأنفية للثدييات)",
 "したがって": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "したがり": "عُشْبَة ضَارَّة / بانْجو, حَشيش",
 "したがる": "أُمْنِيَّة / رَغْبَة / مُنْيَة / تَمَنَّى",
 "したがわ": "أسفل, جانب سفلي (الجانب السفلي من أي شيء) / لِسَان (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق؛ جَارِحَة الْكَلَام؛ كَلِمَة) / لسان (فِي : جسم لحميّ مستطيل متحرك، يكون في الفم، ويصلح للتّذوُّق والبلع، وللنطق؛ جَارِحَة الْكَلَام؛ كَلِمَة)\nمثال: ماري لها فم ليس لها لسان.",
 "したき": "أحراش, شجيرات تحتية (الشجيرات (الأشجار الصغيرة والشجيرات والسراخس وما إلى ذلك) التي تنمو تحت الأشجار الأطول في غابة أو حرش)",
 "したぎ": "مَلَابِس دَاخِلِيَّة, لِبَاس دَاخِلِيّ / أحراش, شجيرات تحتية (الشجيرات (الأشجار الصغيرة والشجيرات والسراخس وما إلى ذلك) التي تنمو تحت الأشجار الأطول في غابة أو حرش)",
 "したぎるい": "ثياب داخلية, ملابس داخلية (رداء داخلي يلبس مباشرة على الجلد وتحت الملابس الخارجية)",
 "したく": "تَحْضِير, إِعْدَاد",
 "したくさ": "أحراش, شجيرات تحتية (الشجيرات (الأشجار الصغيرة والشجيرات والسراخس وما إلى ذلك) التي تنمو تحت الأشجار الأطول في غابة أو حرش)",
 "したくべや": "مَنْزَع / غُرْفَة الْمَلَابِس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "したぐさ": "أحراش, شجيرات تحتية (الشجيرات (الأشجار الصغيرة والشجيرات والسراخس وما إلى ذلك) التي تنمو تحت الأشجار الأطول في غابة أو حرش)",
 "したけんぶん": "امتحان تمهيدي (امتحان يؤديه طلاب الدراسات العليا لتحديد أهليتهم للاستمرار)",
 "したげいこ": "بَرُوفَة",
 "したごしらえ": "تَحْضِير, إِعْدَاد",
 "したごろも": "ملابس داخلية (رداء يلبس تحت ملابس أخرى)",
 "したざさえ": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "したざわり": "مَلْمَس",
 "したしい": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب / مَأْلُوف",
 "したしく": "بتقارب, عن كثب (في علاقة أو موقع قريب في الزمان أو المكان) / بشكل وثيق, حميمياً (بطريقة وثيقة) / بدقة, عن كثب (بطريقة منتبهة)\nمثال: كانت البدايات متقاربة زمنياً / شَخْصِيًّا / مُبَاشَرَةً",
 "したしげ": "لَطِيف (ذو اللطف وذو اللطافة؛ من الكلام: هو عمض معناه وخفي)\nمثال: هي مدرسة لطيفة.",
 "したしごと": "عقد من الباطن (عقد يسند إلى طرف آخر بعض التزامات عقد سابق)",
 "したしさ": "أُلْفَة",
 "したしぶり": "انْتِظَام, ثَبَات (صفة كون الشيء ثابتاً - منتظماً وغير متغير) / ثَبَات, رُسُوخ (صفة كون الشيء ثابتاً أو مثبتاً بأمان ولا يتحرك في مكانه) / ثبات, رسوخ (الخلو من التردد؛ ثبات العزم أو السلوك)\nمثال: وثق بثباتها الواضح في أنها ستفعل ما قالت",
 "したしみ": "أُلْفَة",
 "したしみぶかい": "لَطِيف (ذو اللطف وذو اللطافة؛ من الكلام: هو عمض معناه وخفي)\nمثال: هي مدرسة لطيفة.",
 "したしみやすい": "لَطِيف (ذو اللطف وذو اللطافة؛ من الكلام: هو عمض معناه وخفي)\nمثال: هي مدرسة لطيفة.",
 "したしょく": "مقاول",
 "したしらべ": "تَحْضِير, إِعْدَاد",
 "したじ": "أساس, عمل تمهيدي (إعداد أولي كأساس أو قاعدة) / أساس (أدنى دعامة لهيكل ما) / أساس, حجر الزاوية (الافتراضات الأساسية التي يبدأ منها شيء ما أو يتطور أو يُحسب أو يُشرح)\nمثال: نحن مستعدون اليوم بسبب العمل التمهيدي الذي تم قبل عشر سنوات / انحناء, ميل (فعل الانحناء؛ الميل إلى الأمام) / ميل, نزعة (احتمالية مميزة أو استعداد طبيعي تجاه حالة أو طابع أو تأثير معين) / اِنْحِنَاء, مَيَلَان (الخاصية التي يمتلكها خط أو سطح ينحرف عن الوضع العمودي) / استعداد, ميل (موقف ذهني يميل لتفضيل بديل على آخر)\nمثال: أشار انحناء رأسه إلى موافقته / فَرْو تَحْتِيّ, وَبَر (فراء ناعم وكثيف يقع تحت شعر الحماية الأطول والأخشن) / بطانة, طلاء أولي (الطبقة الأولى أو التمهيدية من الطلاء أو الغراء المطبق على سطح ما) / عازل سفلي (عازل يتكون من طبقة من القطران أو مادة تشبه المطاط على الجانب السفلي للمركبة لتأخير التآكل) / صَلْصَةْ اَلصُّويَا",
 "したじき": "بطانة السجاد (لبادة توضع تحت السجادة) / نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "したじた": "عامة الناس, قوم (الناس بشكل عام (وغالباً ما تستخدم بصيغة الجمع))\nمثال: إنهم مجرد ناس ريفيين",
 "したじゅんび": "تَحْضِير, إِعْدَاد",
 "したそうだん": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "したぞめ": "قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما.",
 "したたか": "مُتَوَعِّك, مُتْعَب (يشعر بعدم الراحة الجسدية أو الألم) / صَلْب, مَتِين (مَصْنُوعٌ أَوْ مَبْنِيٌّ بِمَتَانَةٍ وَصَلَابَة) / عَوِيص, مُحَيِّر (يَفْرِض مُتَطَلَّبَات ذِهْنِيَّة كَبِيرَة؛ صَعْب الفَهْم أَوِ الحَلّ) / شَرِس, قَاسٍ (بَالِغ الصُّعُوبَة؛ يَخْتَبِر القُدْرَة عَلَى التَّحَمُّل بِشِدَّة) / بشدة, بشكل بالغ (لدرجة شديدة أو خطيرة) / بشدة, بقسوة (مسبباً ضرراً كبيراً أو معاناة) / بِحَزْم, بِصَرَامَة (بصرامة؛ بطريقة شديدة)\nمثال: أصابع متجمدة بشدة لدرجة أنه كان لا بد من بترها",
 "したたかもの": "صَلْب العَزِيمَة, قَوِيّ الإِرَادَة (ذو إرادة حازمة وعزيمة لا تلين)",
 "したたか者": "صَلْب العَزِيمَة, قَوِيّ الإِرَادَة (ذو إرادة حازمة وعزيمة لا تلين)",
 "したたむ": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه.",
 "したためる": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه.",
 "したたらす": "رَاوَغ",
 "したたらず": "غَامِض, غَيْر وَاضِح (غير واضح للعقل) / سيء التحديد, غير واضح (مصرح به أو موصوف بشكل سيء) / غَيْر مَقْرُوء, مُسْتَغْلَق (يَتَعَذَّر قِراءَتُه أَوْ فَكّ رُموزِه)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "したたり": "غارقاً في البلل, مبللاً تماماً (رطب للغاية) / تقاطر, خرير (صوت سقوط سائل قطرة بقطرة) / تقاطر, تنقيط (سائل (كالماء) يتدفق في قطرات (كما من طنف المنزل))\nمثال: مبلل تماماً",
 "したたる": "قَطَر (في الشرق الأوسط. وتعرف رسميا بدولة قطر)\nمثال: كنت أسكن في قطر. / فَيَضَان / فَاضَ",
 "したたるい": "لُثْغَة",
 "しただい": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "したっけ": "مَعَ السَّلَامَة, إِلَى اللِّقَاء (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي. / آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "したったらず": "غَامِض, غَيْر وَاضِح (غير واضح للعقل) / سيء التحديد, غير واضح (مصرح به أو موصوف بشكل سيء) / غَيْر مَقْرُوء, مُسْتَغْلَق (يَتَعَذَّر قِراءَتُه أَوْ فَكّ رُموزِه)\nمثال: القانون نفسه كان غير واضح بشأن تلك النقطة",
 "したっぱ": "تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر) / تَافِه",
 "したっぱなれ": "تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة) / أزمة اقتصادية, كساد (حالة اقتصادية طويلة الأمد تتميز بالبطالة وانخفاض الأسعار ومستويات منخفضة من التجارة والاستثمار)\nمثال: دخل الفريق في حالة ركود",
 "したっぱら": "بَطْن, جَوْف (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء) / بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة.",
 "したつ": "دليل التعليمات, كتيب التعليمات (دليل يرافق عادة جهازاً تقنياً ويشرح كيفية تثبيته أو تشغيله)",
 "したつき": "سفلي, منخفض (نص) (مكتوب أو مطبوع أسفل وإلى جانب حرف آخر) / حرف سفلي, نص منخفض (حرف أو رمز يوضع أو يُطبع أو يُكتب أسفل أو قليلاً إلى أسفل وجانب حرف آخر)",
 "したつきそえじ": "سفلي, منخفض (نص) (مكتوب أو مطبوع أسفل وإلى جانب حرف آخر) / حرف سفلي, نص منخفض (حرف أو رمز يوضع أو يُطبع أو يُكتب أسفل أو قليلاً إلى أسفل وجانب حرف آخر)",
 "したつきもじ": "سفلي, منخفض (نص) (مكتوب أو مطبوع أسفل وإلى جانب حرف آخر) / حرف سفلي, نص منخفض (حرف أو رمز يوضع أو يُطبع أو يُكتب أسفل أو قليلاً إلى أسفل وجانب حرف آخر)",
 "したづみ": "قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما.",
 "したて": "دُون المُسْتَوَى, نَاقِص (لا يرقى إلى المعيار المحدد؛ أقل من المستوى المطلوب) / أدنى, مرؤوس (من رتبة أو أهمية منخفضة أو يتسم بها) / دوني, رديء (ذو جودة منخفضة أو رديئة) / داخلي (كوكب) (له مدار بين الشمس ومدار الأرض)\nمثال: عطارد والزهرة كواكب داخلية / تفصيل, خياطة (مهنة الخياط) / تَحْضِير, إِعْدَاد / تَعْلِيم (الأوامر والنواهي التي يحددها دِين ما أو مَذْهَب ما. يُجمع جَمْع تَكْسِير على تَعَالِيم؛ ما دون الأمْر المُلْزِم والمستدعي للعقوبة وفوق الطَلَب الإختياري. أكثر ما يستخدم بصيغة الجمع تَعْلِيمَات)\nمثال: هو بارع في التعليم.",
 "したてあげる": "جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه.",
 "したてなおし": "تَغَيُّر (صَارَ غير ما كان)\nمثال: هل تغير أي شيء؟",
 "したてなおす": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "したてもの": "خِيَاطَة, حِيَاكَة",
 "したてや": "خَيَّاط, خَيَّاطَة",
 "したてる": "خَيَّاط, خَيَّاطَة / ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل. / جَهَّزَ, حَضَّرَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ) / اِسْتَعَدَّ, تَأَهَّبَ (اِسْتَعَدَّ للامْتِحانِ بِجِدٍّ: حَضَّرَ لَه؛ يَسْتَعِدُّ لِلْمُبَارَاةِ: يَتَهَيَّأُ لَهَا)\nمثال: جهز زيري حقائبه.",
 "したで": "دُون المُسْتَوَى, نَاقِص (لا يرقى إلى المعيار المحدد؛ أقل من المستوى المطلوب) / أدنى, مرؤوس (من رتبة أو أهمية منخفضة أو يتسم بها) / دوني, رديء (ذو جودة منخفضة أو رديئة) / داخلي (كوكب) (له مدار بين الشمس ومدار الأرض)\nمثال: عطارد والزهرة كواكب داخلية",
 "したどり": "استبدال, مقايضة (عنصر من الممتلكات يتم تقديمه كجزء من الدفع مقابل عنصر جديد)",
 "したなが": "مُتَبَاهٍ, مُتَفَاخِر (يُظهِر أهمية ذاتية ويتباهى بنفسه)",
 "したならし": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب.",
 "したにみる": "تَرَفَّعَ",
 "したぬい": "سقي اللحم (ترطيب الشواء أثناء طهيه) / خياطة مؤقتة, سراجة (غرزة خياطة مؤقتة فضفاضة لتثبيت طبقات القماش معاً)",
 "したぬり": "فَرْو تَحْتِيّ, وَبَر (فراء ناعم وكثيف يقع تحت شعر الحماية الأطول والأخشن) / بطانة, طلاء أولي (الطبقة الأولى أو التمهيدية من الطلاء أو الغراء المطبق على سطح ما) / عازل سفلي (عازل يتكون من طبقة من القطران أو مادة تشبه المطاط على الجانب السفلي للمركبة لتأخير التآكل)",
 "したのけ": "شَعْر اَلْعَانَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "したのなまえ": "اسم أول, اسم شخصي (الاسم الذي يسبق اللقب)",
 "したのねのかわかぬうち": "في نفس النفس, في نفس الوقت (في وقت واحد تقريباً)\nمثال: مدحته وانتقدته في نفس الوقت",
 "したのねもかわかぬうち": "في نفس النفس, في نفس الوقت (في وقت واحد تقريباً)\nمثال: مدحته وانتقدته في نفس الوقت",
 "したのひと": "تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة) / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / تابع, خاضع (خاضع أو مستسلم للسلطة أو لسيطرة شخص آخر) / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة",
 "したはら": "بَطْن, جَوْف (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء) / بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة.",
 "したば": "باطن القوس, سقف سفلي (الجانب السفلي لجزء من مبنى (مثل قوس أو بروز أو عارضة))",
 "したばえ": "أحراش, شجيرات تحتية (الشجيرات (الأشجار الصغيرة والشجيرات والسراخس وما إلى ذلك) التي تنمو تحت الأشجار الأطول في غابة أو حرش)",
 "したばき": "سِرْوَال (ضرب تقليدي أو قديم من الملابس يرتدى في الجزء السفلي من الجسم يكون واسعا ويربط بالخصر والكاحلين بشرائط من القماش، يفصل كل ساق عن الأخرى…؛ لباس يُغَطِّي الجسم مِن السرة إلى الركبة. —مجلة العربي - الكويت)\nمثال: هذا السروال يناسبني.",
 "したばたらき": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري. / خَادِم, خَادِمَة",
 "したばなれ": "تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة) / أزمة اقتصادية, كساد (حالة اقتصادية طويلة الأمد تتميز بالبطالة وانخفاض الأسعار ومستويات منخفضة من التجارة والاستثمار)\nمثال: دخل الفريق في حالة ركود",
 "したばら": "بَطْن, جَوْف (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء) / بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة.",
 "したばり": "فَرْو تَحْتِيّ, وَبَر (فراء ناعم وكثيف يقع تحت شعر الحماية الأطول والأخشن) / بطانة, طلاء أولي (الطبقة الأولى أو التمهيدية من الطلاء أو الغراء المطبق على سطح ما) / عازل سفلي (عازل يتكون من طبقة من القطران أو مادة تشبه المطاط على الجانب السفلي للمركبة لتأخير التآكل)",
 "したばん": "الجدار السفلي (الجدار السفلي لصدع مائل)",
 "したひも": "حِزَام, زُنَّار (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر) / سَيْر (أسَارَ، أي جعله يَسِير والفرق بين الإثنين أن سَيَّرَ فيها تكرار وأسارَ لا تكرار فيها؛ فلان من بَلَده أو مَوْطِنه: أخْرَجَه وأجْلاه)\nمثال: هذا حزام من الجلد.",
 "したび": "متناقص (للقمر) ((للقمر) يتعلق بالفترة التي يتناقص فيها السطح المرئي للقمر) / أفول, اضمحلال (انخفاض تدريجي في الحجم أو المدى)\nمثال: بعد البدر يأتي القمر المتناقص",
 "したびになる": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "したびらめ": "وَحِيد / عَزْب / أَخْمُص, بَاطِن القَدَم / نَعْل / سَمَك مُوسَى (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "したぶき": "مَأْهُول, مَبْنِيّ (مملوء بالسكّان والمستوطنين)",
 "したぶれ": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "したまち": "مُنْخَفِض الوَضْع (ذو ارتفاع صغير فوق سطح الأرض أو الأفق أو مستوى البحر) / عَلَى مُسْتَوَى سَطْح البَحْر, مُنْخَفِض (يقع تحت المستوى الطبيعيّ)",
 "したまちことば": "عُمَّالِيّ, مِن الطَّبَقَة العَامِلَة (ينتمي إلى من يعملون بأجر خاصة العمال اليدويين أو الصناعيين) / بِأَجْر سَاعِيّ, عُمَّالِيّ (يعمل بأجر ساعيّ بدلًا من راتب ثابت)",
 "したまわり": "تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة) / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / تابع, خاضع (خاضع أو مستسلم للسلطة أو لسيطرة شخص آخر) / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة / أسفل, جانب سفلي (الجانب السفلي من أي شيء)",
 "したみ": "تحويلة جانبية, سكة فرعية (امتداد قصير لسكة الحديد يُستخدم لتخزين العربات أو لتمكين القطارات على نفس الخط من المرور) / كساء خارجي (مادة تطبق على السطح الخارجي للمبنى لجعله مقاومًا للعوامل الجوية)",
 "したみいた": "تحويلة جانبية, سكة فرعية (امتداد قصير لسكة الحديد يُستخدم لتخزين العربات أو لتمكين القطارات على نفس الخط من المرور) / كساء خارجي (مادة تطبق على السطح الخارجي للمبنى لجعله مقاومًا للعوامل الجوية)",
 "したみち": "مجاني (لا تفرض عليه رسوم استخدام)\nمثال: طريق مجاني",
 "したむき": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "したむし": "دودة اللسان (مفصلي يشبه الدودة له زوجان من الخطافات على جانبي الفم؛ طفيلي في الجيوب الأنفية للثدييات)",
 "したや": "سقيفة مائلة (مأوى بسيط له سقف منحدر واحد فقط)",
 "したやく": "تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر)",
 "したよみ": "تَحْضِير, إِعْدَاد",
 "したりがお": "رَاضٍ عَنْ نَفْسِهِ, مُتَرَاخٍ (رَاضٍ عَنْ ذَاتِهِ أَوْ أَفْعَالِهِ إِلَى حَدِّ الخَلَلِ) / مُتَعَجْرِف, مُعْجَبٌ بِنَفْسِهِ (يَتَّسِمُ بِالرِّضَا المُفْرِطِ عَنِ الذَّاتِ)",
 "したり顔": "رَاضٍ عَنْ نَفْسِهِ, مُتَرَاخٍ (رَاضٍ عَنْ ذَاتِهِ أَوْ أَفْعَالِهِ إِلَى حَدِّ الخَلَلِ) / مُتَعَجْرِف, مُعْجَبٌ بِنَفْسِهِ (يَتَّسِمُ بِالرِّضَا المُفْرِطِ عَنِ الذَّاتِ)",
 "したる": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "したわしい": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "したん": "خشب الورد, شجرة خشب الورد (أي من تلك الأشجار الخشبية الصلبة من جنس دالبيرجيا التي تنتج خشب الورد - أخشاب خزائن قيمة ذات لون أحمر داكن أو أرجواني مخطط ومبرقش بالأسود) / خشب الورد (خشب محمر داكن صلب لشجرة خشب الورد له عروق مميزة بقوة؛ يستخدم في الخزائن)",
 "したんぶ": "قَائِد, زَعِيم",
 "しだ": "سَرْخَس",
 "しだい": "مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟ / كَـ, مِثْل / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة / عِمْلاق / جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان",
 "しだいしだい": "شَيْئاً فَشَيْئاً, خُطْوةً فَخُطْوةً",
 "しだいしだいに": "شَيْئاً فَشَيْئاً, خُطْوةً فَخُطْوةً",
 "しだいに": "شَيْئاً فَشَيْئاً, خُطْوةً فَخُطْوةً",
 "しだいふちょう": "مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "しだし": "تَمْوِين / صَامِت, غَيْر نَاطِق (غير قادر على أو لا ينطوي بشكل خاص على الكلام أو السطور المنطوقة) / ممثل دور عابر (يؤدي دوراً صغيراً في عمل درامي)\nمثال: كان له دور صامت في المسرحية",
 "しだしや": "متعهد طعام, ممون حفلات (شخص يوفر الطعام والخدمة (كما في الحفلات))",
 "しだしょくぶつ": "نبات تريدي, نبات وعائي لا زهري (نباتات تحتوي على أنسجة وعائية وتتكاثر عن طريق الأبواغ)",
 "しだらない": "قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ)",
 "しだれかんば": "بتولا بيضاء أوروبية, بتولا فضية (بتولا أوروبية بلحاء أبيض فضي مقشر وفروع متدلية بشكل ملحوظ)",
 "しだれやなぎ": "صفصاف بابلي, صفصاف باكي (صفصاف ذو فروع طويلة متدلية وأوراق رفيعة موطنه الصين؛ يزرع على نطاق واسع كنبات زينة)",
 "しだれる": "تدلي, ترهل (شكل يتدلى أو يهبط للأسفل)\nمثال: كان هناك هبوط في مقعد الكرسي",
 "しだれ柳": "صفصاف بابلي, صفصاف باكي (صفصاف ذو فروع طويلة متدلية وأوراق رفيعة موطنه الصين؛ يزرع على نطاق واسع كنبات زينة)",
 "しだん": "تَقْسِيم / قِسْمَة (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / قِسْمَةٌ (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / فِرْقَة / فُرْقَة\nمثال: الزواج قسمة و نصيب. / نَقْد, اِنْتِقَاد / فيلم, فيلم سينمائي (شكل من أشكال الترفيه يجسد قصة بالصوت وتسلسل من الصور يعطي وهماً بالحركة المستمرة) / شطبة سريعة, نقر (خط قصير وسريع) / ضربة خفيفة, نقرة (تلامس خفيف وحاد (عادة بشيء مرن))\nمثال: ذهبوا لمشاهدة فيلم كل ليلة سبت",
 "しち": "سَبْعَة\nمثال: 私は今朝7時に起きた。 — استيقظت في السابعة هذا الصباح. / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / مُعْضِلَة / مِحْنَة / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق) / بَيْدَق ((في الشطرنج) القطعة الأكثر انتشارًا على رقعة الشِطْرَنْج) / بيذق\nمثال: غادر ذلك الجندي. / تَعَهَّدَ / ضَمَان (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / تَعَهُّد\nمثال: لا أستطيع ضمان أي شيء.",
 "しちいれ": "جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق) / بَيْدَق ((في الشطرنج) القطعة الأكثر انتشارًا على رقعة الشِطْرَنْج) / بيذق\nمثال: غادر ذلك الجندي. / تَعَهَّدَ / ضَمَان (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / تَعَهُّد\nمثال: لا أستطيع ضمان أي شيء.",
 "しちかくけい": "مُسَبَّع",
 "しちかっけい": "مُسَبَّع",
 "しちがつ": "يُولِيُو, تَمُّوز (الشهر السابع في السنة الروميّة؛ يُولِيُوز)\nمثال: نحن نحتفل بمهرجان النجمة في يوليو.",
 "しちがつおうせい": "مَلَكِيَّة يُولْيُو",
