 "しゅどう": "قِيَادَة / كُتَيِّب, كُتَيِّب التَّشْغِيل (كِتَاب صَغِير؛ دَلِيل) / يَدَوِيّ / اشتهاء الغلمان, لواط بالأطفال (العلاقات الجنسية بين رجل وصبي (عادة الجماع الشرجي مع الصبي كشريك سلبي))",
 "しゅどうけん": "هَيْمَنَة, سَيْطَرَة",
 "しゅどうしゃ": "قَائِد, زَعِيم / رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "しゅどうてき": "اِسْتِقْلَالِيّ",
 "しゅどうによる": "كُتَيِّب, كُتَيِّب التَّشْغِيل (كِتَاب صَغِير؛ دَلِيل) / يَدَوِيّ",
 "しゅにく": "خسارة, عجز (المبلغ الذي تتجاوز به تكلفة العمل إيراداته)\nمثال: عملت الشركة بخسارة العام الماضي",
 "しゅにまじわればあかくなる": "قَضَى وَقْت",
 "しゅにゅう": "وَارِدَات / اِسْتِيرَاد, تَوْرِيد / اِسْتَوْرَدَ, وَرَّدَ (جاء بالوِرْد من مكان آخر؛ اِشْتَرَى البضائع من خارج البلاد وبَاعَها في البلاد) / وَارِد (للأعصاب والنبضات العصبية؛ تنقل المعلومات الحسية من أعضاء الحس إلى الجهاز العصبي المركزي) / عصب حسي, عصب وارد (عصب ينقل النبضات من المستقبلات باتجاه أو إلى الجهاز العصبي المركزي)\nمثال: أعصاب واردة",
 "しゅにん": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "しゅにんきょうじゅ": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "しゅにんしゃ": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "しゅのいのり": "اَلصَّلَاة اَلرَّبِّيَّة",
 "しゅのう": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "しゅのうかいぎ": "قِمَّة, مُؤْتَمَر قِمَّة (اجتماع لرؤساء الحكومات)",
 "しゅのうかいごう": "قِمَّة, مُؤْتَمَر قِمَّة (اجتماع لرؤساء الحكومات)",
 "しゅのうかいだん": "قِمَّة, مُؤْتَمَر قِمَّة (اجتماع لرؤساء الحكومات)",
 "しゅのうしゃ": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "しゅのうじん": "قادة, قيادة (هيئة الأشخاص الذين يقودون مجموعة)\nمثال: تبنت القيادة الوطنية خطته",
 "しゅのうぶ": "إِجْرَائِيّ",
 "しゅのばんさん": "العشاء الأخير (عشاء الفصح التقليدي ليسوع مع تلاميذه عشية صلبه) / الإفخارستيا, القربان المقدس (سر مسيحي يحيي ذكرى العشاء الأخير بتكريس الخبز والنبيذ)",
 "しゅのひ": "اَلسَّبْت",
 "しゅはん": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "しゅばしこう": "لَقْلَق أَبْيَض",
 "しゅひ": "غلاف البذرة, قصرة (الطبقة الخارجية الواقية لبذور النباتات الزهرية) / سِرِّيَّة / غِطَاء, لِحَاف (غطاء واقٍ خارجي مثل جلد الحيوان أو قشرة أو غلاف بذرة أو قشر أو صدفة)",
 "しゅひん": "ضيف الشرف (الشخص الذي يُعقد التجمع تكريماً له)",
 "しゅび": "دِفَاع, حِمَايَة / دِفاع / دفاع, لعب ميداني ((بيسبول) التعامل مع الكرة أثناء اللعب في الملعب) / تَسَبَّب / نَتِيجَة",
 "しゅびいっかん": "مُتَّسِق",
 "しゅびいっかんした": "مُتَّسِق",
 "しゅびかえ": "الحبل الرئيسي للسارية (الحبل الأمامي الذي يثبت الصاري الرئيسي) / دعامة أساسية, ركيزة (مصدر دعم واستقرار مركزي ومتماسك) / دعامة, ركن أساسي (مؤيد بارز)\nمثال: الإيمان هو ركيزته",
