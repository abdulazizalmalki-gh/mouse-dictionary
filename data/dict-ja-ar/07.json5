 "しんかをとげる": "طَوَّرَ",
 "しんかん": "فَتِيل / مُنْصَهِرَة, مصهر / توسعة, جناح (إضافة توسع المبنى الرئيسي) / صَامِت, سَاكِت / كَاهِن, قِسِّيس / قَلْب, فُؤَاد / قَلْب / كُبَّا / هَزَّ",
 "しんかんかく": "مُسْتَجِدّ / رِوَايَة",
 "しんかんさせる": "هَزَّ",
 "しんかんしょうかい": "مراجعة كتاب (مراجعة نقدية لكتاب (عادة ما يكون كتاباً نُشر حديثاً))",
 "しんかんせん": "شِينْكَانْسِن",
 "しんかんもじ": "كَهَنُوتِيّ, هِيرَاطِيقِيّ (يلتزم بأنماط وأساليب ثابتة؛ شديد التقييد والرسمية) / هيراطيقي (مكتوب بـ أو ينتمي إلى شكل متصل من الكتابة المصرية القديمة) / كهنوتي (مرتبط بالكهنوت أو الكهنة) / الخط الهيراطيقي, هيراطيقية (شكل متصل (مختزل) من الهيروغليفية المصرية؛ استخدمه الكهنة بشكل خاص)\nمثال: نص مصري هيراطيقي",
 "しんがい": "مِسَاس / مُؤْسِف, يُؤْسَفُ لَهُ (يَسْتَحِقُّ الأَسَفَ أَوِ النَّدَمَ) / لَا يَخْطُرُ عَلَى الْبَالِ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة. / ترويع / إِرْهَاب (ال الإِزعاجُ والإِخَافَةُ، تقولُ: ويَقْشَعِرُّ الإِهَابُ إِذَا وَقَعَ مِنْهُ الإِرْهَابُ؛ الإِرْهَابُ قَدْعُ الإِبِلِ عن الحَوْضِ وذِيَادُهَا)\nمثال: الإنفصاليون مثل الإرهاب.",
 "しんがいさせる": "خَشَّى, أَفْزَعَ",
 "しんがいしげき": "عيارية ((للمحاليل) التركيز معبراً عنه بمكافئات الجرام من المذاب لكل لتر) / نيوتن (وحدة قوة تساوي القوة التي تكسب كتلة مقدارها كيلوغرام واحد تسارعًا قدره 1 متر/ثانية/ثانية؛ وتساوي 100,000 داين) / الشَّمَال (نقطة البوصلة الأصلية التي تكون عند 0 أو 360 درجة) / نيتروجين (عنصر لافلزي شائع يكون عادةً غازاً ثنائي الذرة عديم اللون والرائحة والطعم؛ يشكل 78 في المائة من الغلاف الجوي من حيث الحجم)",
 "しんがいしゃ": "غَازٍ, الْغَازِي",
 "しんがいまくえん": "اِلْتِهَاب التَّأْمُور",
 "しんがお": "قادم جديد, مستجد (أي مشارك جديد في نشاط ما) / وافد جديد (شخص وصل حديثًا)\nمثال: هو وافد جديد إلى بوسطن",
 "しんがく": "إِلٰهِيَّات",
 "しんがくし": "دكتوراه في اللاهوت (درجة الدكتوراه في الدراسات الدينية)",
 "しんがくしゃ": "عَالِم لَاهُوت, لَاهُوتِيّ (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "しんがくじゅく": "وَظِيفَة بِدَوَامٍ جُزْئِيّ, عَمَل جُزْئِيّ (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "しんがたコロナウイルスかんせんしょう": "كوفيد-19, كوڤيد-19",
 "しんがっこう": "مدرسة بنات, مدرسة خاصة (مكان خاص لتعليم الصغار) / كلية لاهوت, معهد لاهوتي (مدرسة لاهوتية لتدريب القساوسة أو الكهنة أو الحاخامات)",
 "しんがつよい": "صَلْب العَزِيمَة, قَوِيّ الإِرَادَة (ذو إرادة حازمة وعزيمة لا تلين)",
 "しんがり": "خَلْفِيّ / مِرْسَاة, أَنْجَر / مُذِيع, مُذِيعَة / رَسَا ((رَسَا) الشيءُ يَرْسُو رَسْواً، ورُسُوّاً: ثَبَتَ؛ رَسا الجبلُ: ثَبَتَ أصَله في الأَرض)",
 "しんがん": "أَصَالَة, شَرْعِيَّة (مصداقية غير متنازع عليها) / عين العقل, مخيلة (تخيل مشاهد متذكرة أو مخترعة)\nمثال: استطعت رؤيتها بوضوح في مخيلتي / صَلَاة, دُعَاء / صَلَاة / مُصَلٍّ",
 "しんき": "عَقْلِيَّة / تهيج, سرعة الغضب (شعور بالتهيج والنزق) / تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع) / مُسْتَجِدّ / رِوَايَة / جَدِيد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / حَدِيث (جَدِيد؛ الخبر عن ما حدث) / جديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / جَديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد / طاقة تشي, كي (طاقة الحياة المتداولة التي يعتقد في الفلسفة الصينية أنها كامنة في كل شيء؛ في الطب الصيني التقليدي يعتبر توازن الأشكال السلبية والإيجابية في الجسم…) / كُحُول, خَمْر (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول. / حالة عقلية, حالة نفسية ((علم النفس) حالة عقلية تكون فيها صفات الحالة ثابتة نسبيًا على الرغم من أن الحالة نفسها قد تكون ديناميكية)\nمثال: الإجهاد ليس الحالة العاطفية أو العقلية الوحيدة التي يمكن أن تستفيد من التأمل المنتظم / خَفَقَان",
 "しんきかぶしきこうかい": "اكتتاب عام أولي, طرح أولي (أول عرض للشركة لبيع الأسهم للجمهور)",
 "しんきくさい": "كَئِيب, كَنُود (يسبب مشاعر حزينة من الكآبة وعدم الكفاءة)\nمثال: التوقعات الاقتصادية محبطة / مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / مُؤْلِم, مُهَيِّج (يسبب عدم الراحة الجسدية) / تَنْبِيهِيّ, مُهَيِّج ((للمحفزات الجسدية) يعمل على التحفيز أو الإثارة)",
 "しんきこうしん": "خَفَقَان",
 "しんきしょう": "وَسَاوِس مرضية",
 "しんきじく": "اِبْتِكَار",
 "しんきじゅうたくちゃっこうけんすう": "بدء الإسكان, بدء البناء (فعل البدء في بناء منزل)",
 "しんきせい": "حلي رخيصة, حلية مبهرجة (مجوهرات رخيصة ومبهرجة أو زينة على الملابس) / تحفة صغيرة, حلية (صنف صغير غير مكلف يتم إنتاجه بكميات كبيرة) / جِدَّة, طَرَافَة (الأصالة بحكم كون الشيء جديداً ومنعشاً) / جدة, حداثة (الأصالة بحكم كونها جديدة ومفاجئة)",
 "しんきゃく": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "しんきゅう": "تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة / عينة, مثال (عنصر من المعلومات يعتبر نموذجياً لفئة أو مجموعة) / حالة, مثال (حدوث لشيء ما)\nمثال: يقدم هذا المريض مثالاً نموذجياً للمتلازمة",
 "しんきょう": "إيمان, دين (اعتقاد قوي بقوة أو قوى خارقة للطبيعة تتحكم في المصير البشري)\nمثال: فقد إيمانه ولكن ليس أخلاقه / عَقِيدَة (المُعَاقِدَة، بمعنى اسم الفاعل؛ المعقودة، بمعنى اسم المفعول) / حالة إدراكية, حالة معرفية (حالة العمليات المعرفية للشخص) / حالة ذهنية, مزاج (حالة نفسية مؤقتة) / بُرُوتِسْتَانْتِيَّة / تَقَدُّم / ألوهية, إيمان بوجود إله (العقيدة أو الإيمان بوجود إله أو آلهة)",
 "しんきょうち": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "しんきょうと": "بُرُوتِسْتَانْتِيّ",
 "しんきょうのじゆう": "حُرِّيَّة اَلدِّين, حُرِّيَّة اَلْمُعْتَقَد (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "しんきょうのへんか": "انقلاب, تراجع (قرار بعكس قرار سابق)",
 "しんきり": "قمع الإطفاء, مطفأة الشموع (أداة مخروطية الشكل ذات مقبض؛ تستخدم لإطفاء الشموع) / مستنشق السعوط (شخص يتعاطى السعوط (النشوق)) / مُطْفِئ الشُّمُوع (شخص يطفئ الشموع)",
 "しんきろう": "سَرَاب",
 "しんきん": "عضلة باسطة (عضلة هيكلية يمد انقباضها أو يبسط جزءاً من الجسم) / فُطْر ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر. / عضلة قلبية (النسيج العضلي للقلب؛ متكيف للانقباض الإيقاعي المستمر) / لحام, لصق (التثبيت بإحكام معاً) / ربط الأسنان, لصق تجميلي ((طب الأسنان) تقنية لإصلاح الأسنان؛ يتم تطبيق مادة صمغية على سطح السن حيث تلتصق بمينا الأسنان) / أُلْفَة, تَرَابُط (علاقة شخصية وثيقة تتشكل بين الناس (كما بين الزوج والزوجة أو الوالد والطفل)) / اتحاد ائتماني, جمعية تعاونية للتسليف (مؤسسة مالية إيداعية تعاونية يمكن لأعضائها الحصول على قروض من مدخراتهم المشتركة)",
 "しんきんえん": "التهاب عضلة القلب (التهاب عضلة القلب)",
 "しんきんかん": "أُلْفَة, انْجِذَاب (انجذاب طبيعي أو شعور بالقرابة) / أُلْفَة, تَجَانُس (تشابه متأصل بين الأشخاص أو الأشياء) / ألفة, انجذاب كيميائي (القوة التي تجذب الذرات لبعضها وتربطها معاً في جزيء) / ألفة ((في المناعة) الانجذاب بين مستضد وجسم مضاد)\nمثال: انجذاب للسياسة",
 "しんきんかんせんしょう": "عدوى فطرية, فطار (حالة التهابية تسببها الفطريات)",
 "しんきんがく": "عَلْم الفَطْرِيَات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "しんきんこうそく": "اِحْتِشَاء قَلْبِيّ, احتشاء عضلة القلب",
 "しんきんしゃ": "أمين سر, خليل (شخص يُؤتمن على الأمور الخاصة)",
 "しんきんしょう": "عدوى فطرية, فطار (حالة التهابية تسببها الفطريات) / اعتلال عضلة القلب (اضطراب (مجهول السبب عادةً) يصيب عضلة القلب)",
 "しんきんてんりかく": "شذوذ حقيقي (المسافة الزاوية لنقطة في مدار ما بعد نقطة الحضيض مقاسة بالدرجات)",
 "しんきんどく": "ذيفان فطري, سم فطري (ذيفان ينتجه فطر)",
 "しんぎ": "أَصَالَة, شَرْعِيَّة (مصداقية غير متنازع عليها) / إِيمَان, مُعْتَقَد / إِيمَان, دِين / تداول, تريث (سمة التفكير المتأني في العمل أو القرار) / بطء, تأنٍ (معدل يظهر غياب العجلة أو التسرع) / تداول, روية (تفكير متأنٍ وحذر) / تعمد, حساب (تخطيط شيء ما بعناية وعن قصد)\nمثال: كان رجلاً ذا تداول قضائي / أَصَالَة, شَرْعِيَّة (مصداقية غير متنازع عليها) / أصالة, حقيقية (حالة كونه أصلياً أو حقيقياً)",
 "しんぎかい": "مَجْلِس / مَجْمَع (اسم مفعول من جَمَّعَ؛ كُلِّيَّة، جَامِعَة)\nمثال: كان سامي يعيش في مجمع مسور.",
 "しんぎかん": "عُضْو مَجْلِس, مُسْتَشار (عضو في مجلس (بلدي أو إداري))",
 "しんぎふめい": "مَشْكُوك فِيه, مُرْتَاب (مليء بالشكّ وعدم اليقين) / شَاكّ, غَيْر مُقْتَنِع (ليس على اقتناع أو يقين) / مَشْبُوه, مَشْكُوكٌ فِيه (يثير الشكّ أو الريبة)",
 "しんぎみりょう": "غَيْر مَحْلول, مُعَلَّق ((في المُوسيقى) لَمْ يُحَلّ إلى تَوافُق؛ يَظَلّ مُتَنافِرًا) / غَيْر مَحْسُوم, مَفْتُوح (لم يُبَتّ فيه بعد؛ قابل لمزيد من التفكير والنقاش) / عالق, غير محلول (لم يتم حله)\nمثال: العديد من الجرائم تبقى غير محلولة",
 "しんぎろん": "ثيوديسيا, عدالة الإله (فرع اللاهوت الذي يدافع عن صلاح الله وعدله في مواجهة وجود الشر)",
 "しんぎん": "تَأَوَّهَ (قَالَ آه؛ تَحَسَّرَ، تَنَهَّدَ)",
 "しんく": "مَشَقَّة, شِدَّة",
 "しんくう": "خَلَاء, فَرَاغ (المكان الخالي من الناس، غالبا ما يقصد به الأماكن غير المزروعة والتي تركت طبيعية؛ المِرْحَاض، الغرفة التي تقضى فيها الحاجة)\nمثال: حبب إليه الخلاء.",
 "しんくうかん": "أنبوب إلكتروني, صمام مفرغ (جهاز إلكتروني يتكون من نظام من الأقطاب الكهربائية مرتبة في غلاف زجاجي أو معدني مفرغ)",
 "しんくうそうじき": "مِكْنَسَة كَهْرَبَائِيَّة",
 "しんくうたい": "جيب هوائي, فجوة هوائية (منطقة محلية ذات ضغط منخفض أو هواء هابط تسبب فقدان الطائرة للارتفاع فجأة)",
 "しんくうようき": "حُجْرَة فَرَاغِيَة (الغُرْفَة أو القَاعَة. تطلق على القَبْر والحَضِيرَة من باب التشبيه؛ ما يشبه الغرفة من الأرض، المكان المحمي أو المحاط بما يجعله شبيها بالمنعى الأول. استخدام مجازي وقديم)\nمثال: قعدنا في وسط الحجرة.",
 "しんくかんなん": "بُؤْس, ضَنْك (الفُقْر والشِدَّة وضِيق الحال)\nمثال: عانى الكثيرون الظلم والبؤس ردحا من الزمن تحت حكم الإستعمار.",
 "しんくみ": "اتحاد ائتماني, جمعية تعاونية للتسليف (مؤسسة مالية إيداعية تعاونية يمكن لأعضائها الحصول على قروض من مدخراتهم المشتركة)",
 "しんぐ": "أغطية السرير, مفروشات السرير (الأغطية التي تستخدم على السرير) / فَرْشَة, فِرَاش (مادة تُستخدم لتهيئة فراش أو مرقد للحيوانات)",
 "しんぐるい": "أغطية السرير, مفروشات السرير (الأغطية التي تستخدم على السرير) / فَرْشَة, فِرَاش (مادة تُستخدم لتهيئة فراش أو مرقد للحيوانات)",
 "しんぐん": "مَسِيرَة / لَحْن السَّيْر, مَارْش (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز) / سَارَ (مَشَى)\nمثال: أنا أحب هذا اللحن.",
 "しんけい": "عَصَب / أعصاب, ثبات (التحكم في العواطف) / توتر عصبي, عصبية (حالة نفسية غير مستقرة)\nمثال: هذا النوع من التوتر ليس جيداً لأعصابي / شَبِيهٌ بِالشَّفَة, شَفَوِيّ (لَهُ شِفَاهٌ أَوْ أَجْزَاءٌ تُشْبِهُ الشِّفَاه)",
 "しんけいえん": "التهاب العصب (التهاب العصب مصحوب بألم وأحياناً فقدان الوظيفة)",
 "しんけいか": "طب الأعصاب, طب الجهاز العصبي (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "しんけいかい": "أخصائي أعصاب, طبيب أعصاب (أخصائي طبي في الجهاز العصبي والاضطرابات التي تؤثر عليه)",
 "しんけいかいぼうがく": "تشريح عصبي (تشريح الجهاز العصبي)",
 "しんけいかいろもう": "شبكة عصبية (أي شبكة من الخلايا العصبية أو النوى التي تعمل معاً لأداء وظيفة ما في الجسم) / شبكة عصبونية, شبكة عصبية (هندسة حاسوبية يتم فيها توصيل المعالجات بطريقة توحي بالاتصالات بين الخلايا العصبية؛ يمكنها التعلم عن طريق التجربة والخطأ)",
 "しんけいかがく": "عُلُوم عَصَبِيَّة, عِلْم الأَعْصَاب (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: علم، عُلُوْم)\nمثال: الصبر أم العلوم.",
 "しんけいかがくしゃ": "عالم أعصاب (عالم أحياء عصبية يتخصص في دراسة الدماغ)",
 "しんけいかく": "عَصْبُون, خَلِيَّة عَصَبِيَّة",
 "しんけいかそせい": "اللُّدُونة العصبية",
 "しんけいかびん": "مُفْرِط الحَسَاسِيَّة (حسّاس بشكل مبالغ فيه)",
 "しんけいかん": "أنبوب عصبي (أنبوب من نسيج الأديم الظاهر في الجنين يتطور منه الدماغ والحبل الشوكي)",
 "しんけいがく": "طب الأعصاب, طب الجهاز العصبي (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "しんけいがくしゃ": "أخصائي أعصاب, طبيب أعصاب (أخصائي طبي في الجهاز العصبي والاضطرابات التي تؤثر عليه)",
 "しんけいがこまかい": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "しんけいがさいぼう": "أرومة عصبية (خلية تتطور منها الخلية العصبية)",
 "しんけいがさいぼうしゅ": "ورم أرومي عصبي (ورم خبيث يحتوي على خلايا عصبية جنينية؛ عادة ما ينتشر بسرعة)",
 "しんけいがしゅ": "ورم أرومي عصبي (ورم خبيث يحتوي على خلايا عصبية جنينية؛ عادة ما ينتشر بسرعة)",
 "しんけいがするどい": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "しんけいがほそい": "مُفْرِط الحَسَاسِيَّة (حسّاس بشكل مبالغ فيه)",
 "しんけいきん": "عصبي عضلي (يؤثر على أو يميز كلا من الأنسجة العصبية والعضلية)",
 "しんけいきんせつごうぶ": "مشبك عصبي عضلي (الوصلة بين الليف العصبي والعضلة التي يغذيها)",
 "しんけいけい": "جِهَاز عَصَبِيّ",
 "しんけいげか": "جراحة الأعصاب (أي جراحة تتعلق بالجهاز العصبي (الدماغ أو الحبل الشوكي أو الأعصاب المحيطية))",
 "しんけいげん": "عَصْبُون, خَلِيَّة عَصَبِيَّة",
 "しんけいげんごがく": "لسانيات عصبية (فرع اللسانيات الذي يدرس العلاقة بين اللغة وبنية ووظيفة الجهاز العصبي)",
 "しんけいげんごプログラミング": "معالجة اللغات الطبيعية (فرع علم المعلومات الذي يتعامل مع معلومات اللغة الطبيعية)",
 "しんけいこう": "خلايا دبقية, نسيج عصبي دبقي (نسيج داعم يحيط ويدعم الخلايا العصبية في الجهاز العصبي المركزي)",
 "しんけいこうさいぼう": "خلية دبقية, خلية غروية عصبية (خلية من خلايا الدبق العصبي)",
 "しんけいこうしゅ": "ورم دبقي (ورم في الدماغ يتكون من الخلايا الدبقية)",
 "しんけいさいぼう": "عَصْبُون, خَلِيَّة عَصَبِيَّة",
 "しんけいさいぼうたい": "جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان) / سوما (تجسيد لشراب مسكر مقدس يُستخدم في الطقوس الفيدية) / سوما, هاوما (كرمة عديمة الأوراق من جزر الهند الشرقية؛ كانت عصارتها اللبنية الحامضة تستخدم سابقاً لصنع مشروب مسكر)\nمثال: درس ليوناردو جسم الإنسان",
 "しんけいざい": "عامل أعصاب, غاز الأعصاب (غاز سام يتم استنشاقه أو امتصاصه عبر الجلد وله آثار ضارة على الجهاز العصبي والتنفسي)",
 "しんけいしつ": "عَصَبِيّ / دَقِيق, مُتَطَلِّب (شَدِيد التَّدْقِيق خَاصَّةً فِي التَّفَاصِيل) / عَبُوس, مُتَذَمِّر (مُنزعج وسريع الانفعال) / مُزْدَحِم بِالتَّفَاصِيل (مكتظّ بالتفاصيل والزخارف بشكل مفرط)",
 "しんけいしはい": "إِمْدَاد عَصَبِيّ, تَعْصِيب (توزيع الألياف العصبية على عضو أو منطقة في الجسم) / استثارة, تهيج (الاستثارة العصبية أو الكهربائية لعضو أو عضلة أو غدة)",
 "しんけいしゅ": "ورم عصبي (أي ورم مشتق من خلايا الجهاز العصبي)",
 "しんけいしゅうまく": "حول العصب, غمد الحزمة العصبية (غمد من النسيج الضام يغطي حزمة من الألياف العصبية)",
 "しんけいしゅうまつ": "نهاية عصبية (الهيكل الطرفي للمحور العصبي الذي لا ينتهي عند مشبك عصبي)",
 "しんけいしょう": "اضطراب عصبي, مرض عصبي (اضطراب في الجهاز العصبي)",
 "しんけいしょうがい": "اضطراب عصبي, مرض عصبي (اضطراب في الجهاز العصبي)",
 "しんけいしょうげき": "سيال عصبي, نبضة عصبية (التفريغ الكهربائي الذي ينتقل عبر الليف العصبي)\nمثال: أثبتوا انتقال النبضات من القشرة الدماغية إلى منطقة تحت المهاد",
 "しんけいしょうてき": "عصابي, مريض نفسياً (مصاب باضطراب عاطفي) / عصابي (مميز للعصاب أو مصاب به) / عُصابِيّ, مَرِيض نَفْسِيّ (شخص يعاني من العصاب)\nمثال: اضطراب عصابي",
 "しんけいしんりがく": "علم النفس العصبي, علم النفس الفسيولوجي (فرع علم النفس المعني بالأسس الفسيولوجية للعمليات النفسية)",
 "しんけいすいじゃく": "وهن عصبي (انهيار عصبي (مصطلح غير تقني)) / تَرْكِيز",
 "しんけいせい": "عَصَبِيّ",
 "しんけいせいしんいがく": "طب النفس العصبي (فرع الطب المعني بالاضطرابات العقلية المنسوبة لأمراض الجهاز العصبي)",
 "しんけいせいたいしょくしょう": "الشره المرضي العصبي, النهام العصبي (اضطراب في الأكل يتناوب فيه الشخص بين رغبة قوية في الطعام ونفور منه؛ يتميز بالإفراط في الأكل تليها فترات من الصيام أو التقيؤ المستحث ذاتياً)",
 "しんけいせいぶつがく": "بيولوجيا عصبية (فرع علم الأحياء الذي يتعامل مع تشريح وفسيولوجيا وباثولوجيا الجهاز العصبي)",
 "しんけいせいむしょくよくしょう": "فقدان الشهية العصبي ((الطب النفسي) اضطراب نفسي يتميز بأوهام جسدية بأن الشخص سمين جداً رغم كونه نحيفاً جداً)",
 "しんけいせいりがく": "فسيولوجيا عصبية (فرع علم الأعصاب الذي يدرس فسيولوجيا الجهاز العصبي)",
 "しんけいせつ": "عُقْدَة عَصَبِيَّة",
 "しんけいせん": "حرب أعصاب, حرب نفسية (استخدام تكتيكات نفسية لتدمير معنويات الخصوم)",
 "しんけいせんい": "ليف عصبي (امتداد خيطي للخلية العصبية)",
 "しんけいそう": "ضفيرة عصبية (شبكة من الأعصاب المتقاطعة)",
 "しんけいそしき": "نسيج عصبي (نسيج يتكون من عصبونات)",
 "しんけいたようせい": "تَنَوُّع عَصَبِيّ",
 "しんけいたんい": "عَصْبُون, خَلِيَّة عَصَبِيَّة",
 "しんけいちゅうすう": "مركز, مركز عصبي (مجموعة من الخلايا العصبية تتحكم في عملية جسدية محددة) / غرفة العمليات, مركز الأعصاب (مركز يوفر المعلومات والتحكم)\nمثال: في معظم الناس يقع مركز الكلام في نصف الكرة الأيسر",
 "しんけいちょうせつせいしっしん": "نانومتر (وحدة مترية للطول تساوي واحداً من المليار من المتر)",
 "しんけいつう": "ألم عصبي (ألم تشنجي حاد على طول مسار عصب واحد أو أكثر)",
 "しんけいつかう": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "しんけいてい": "عُرْف عَصَبِيّ (عَلِمَ؛ سَكَنَ إلى الشيءِ، أَنَسَهُ وأَلِفَه)\nمثال: من عرف نفسه فقد عرف ربه.",
 "しんけいでんたつぶっしつ": "نَاقِل عَصَبِيّ",
 "しんけいどく": "ذيفان عصبي, سم عصبي (أي سم يؤثر على الأنسجة العصبية)",
 "しんけいないか": "طب الأعصاب, طب الجهاز العصبي (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "しんけいないぶんぴ": "عصبي صماوي (متعلق بالجهازين العصبي والصماوي (خاصة في وظيفتهما المشتركة))",
 "しんけいないぶんぴつ": "عصبي صماوي (متعلق بالجهازين العصبي والصماوي (خاصة في وظيفتهما المشتركة))",
 "しんけいのかそせい": "اللُّدُونة العصبية",
 "しんけいのするどい": "ذُو إِحْسَاس (أحد الأسماء الستة، لا يأتي إلا مُضَافًا، بمعنى صاحب) / حَسَّاس\nمثال: كان رجل ذو قامة طويله.",
 "しんけいのにぶい": "غير حساس, متبلد الحس (غير مستجيب للمحفزات الجسدية) / عديم الإحساس, غليظ (يفتقر إلى المشاعر الإنسانية؛ غير حساس عقليًا أو أخلاقيًا)\nمثال: غير حساس للإشعاع",
 "しんけいのほそい": "مُفْرِط الحَسَاسِيَّة (حسّاس بشكل مبالغ فيه)",
 "しんけいばいどく": "زهري عصبي (زهري يصيب الجهاز العصبي المركزي)",
 "しんけいびょう": "اضطراب عصبي, مرض عصبي (اضطراب في الجهاز العصبي)",
 "しんけいもう": "شبكة عصبية (أي شبكة من الخلايا العصبية أو النوى التي تعمل معاً لأداء وظيفة ما في الجسم) / شبكة عصبونية, شبكة عصبية (هندسة حاسوبية يتم فيها توصيل المعالجات بطريقة توحي بالاتصالات بين الخلايا العصبية؛ يمكنها التعلم عن طريق التجربة والخطأ)",
 "しんけいをつかう": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "しんけいインパルス": "سيال عصبي, نبضة عصبية (التفريغ الكهربائي الذي ينتقل عبر الليف العصبي)\nمثال: أثبتوا انتقال النبضات من القشرة الدماغية إلى منطقة تحت المهاد",
 "しんけいガス": "غَاز أَعْصَاب, عَامِل أَعْصَاب",
 "しんけいホルモン": "هرمون عصبي (هرمون يتم إطلاقه بواسطة نبضات عصبية (مثل النورإبينفرين أو الفازوبريسين))",
 "しんけっかん": "جِهَاز اَلدَّوَرَان, جِهَاز قَلْبِيّ وِعَائِيّ",
 "しんけっかんけい": "الجهاز الدوري, جهاز الدوران (الأعضاء والأنسجة المشاركة في تدوير الدم والليمف عبر الجسم)",
 "しんけっかんしっかん": "مرض القلب والأوعية الدموية, مرض قلبي وعائي (مرض يصيب القلب أو الأوعية الدموية)",
 "しんけつ": "قلباً وقالباً (بإيمان كامل) / جوهر, خلاصة (الجزء المختار أو الأكثر أهمية أو حيوية في فكرة أو تجربة ما)\nمثال: كانت معه قلباً وقالباً",
 "しんけん": "جِدِّيّ / جَدِّيّ, جَادّ / حَبْس (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ) / حِرَاسَة نَظَرِيَّة\nمثال: هو,البارحة حرر من الحبس. / الحق الإلهي, الحق الإلهي للملوك (المذهب القائل بأن الملوك يستمدون حقهم في الحكم مباشرة من الله ولا يخضعون لمحاسبة رعاياهم؛ التمرد هو أسوأ الجرائم السياسية)\nمثال: تم الإعلان عن مذهب الحق الإلهي للملوك من قبل عائلة ستيوارت في بريطانيا في القرن السادس عشر",
 "しんけんあらそい": "نزاع حضانة (تقاضي لتسوية حضانة أطفال زوجين مطلقين)",
 "しんけんしゃ": "أمين, وصي قانوني (شخص (أو مؤسسة) يُعهد إليه بالملكية القانونية للممتلكات لاستخدامها لصالح شخص آخر)",
 "しんけんせいじ": "ثِيُقْرَاطِيَّة",
 "しんげき": "يقرب",
 "しんげきめいれい": "عتاد المسير (تجهيزات للمسير)\nمثال: كانت السرية مجهزة بكامل عتاد المسير",
 "しんげつ": "مُحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…) / مَحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…) / مِحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…) / هِلَال",
 "しんげん": "جَادّ, صَادِق (يتّسم بإيمان ثابت وجادّ بأهمية الشيء ذاته) / رَزِين, وَقُور (يتّسم بالوقار والرصانة في الطبع والسلوك) / بُؤْرَة / مَثَل, حِكْمَة (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / اَلْأَمْثَال / نَصِيحَة, مَشُورَة",
 "しんげんち": "بؤرة سطحية, مركز زلزالي سطحي (النقطة على سطح الأرض الواقعة مباشرة فوق بؤرة الزلزال) / مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "しんこ": "حَقِيقِيّ / وَاقِعِيّ / رِيَال (العُمْلَة الرسمية لدى) / مُخَلَّل / دَقِيق الْأَرُزّ, أَرُزّ مَسْحُوق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "しんこう": "إِيمَان, مُعْتَقَد / إِيمَان, دِين\nمثال: キリスト教を信仰していますか。 — هل تؤمن بالمسيحية؟ / تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة / اِنْتِفَاضَة, تَمَرُّد (معارضة منظمة للسلطة؛ صراع يحاول فيه فصيل انتزاع السيطرة من آخر) / بَازِغ, صَاعِد (برز حديثاً إلى الواجهة) / صَاعِد, نَاشِئ (يَبْلُغُ مَرْحَلَةَ النُّضْج) / طَالِع, مُنْحَدِرٌ صُعُودًا (مَائِلٌ نَحْوَ الأَعْلَى) / تَقَدُّم / مُتَتَالِيَة / غَزْو, إِغَارَة (أَغَارَ عَلَى العَدُوِّ غَزْواً : سَارَ إِلَى مُحَارَبَتِهِ وَقِتَالِهِ فِي عُقْرِ دِيَارِهِ؛ سيطرة على دولة أو منطقة بواسطة قوّات مُسلَّحة أجنبيّة)\nمثال: الصين مستعدة لغزو تايوان. / مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل / مُخَلَّل / أُلْفَة / سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ) / عَمِيقٌ مِنَ الأَعْمَاق (نَابِعٌ مِنْ أَعْمَاقِ النَّفْس) / بَالِغُ العُمْق, عَمِيقٌ جِدًّا (مِنْ أَشَدِّ دَرَجَاتِ الحِدَّةِ؛ تَامّ) / حَمْلَة / هَاجَمَ / صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة. / إكليل, نطاق (مؤشر لضوء مشع يُرسم حول رأس قديس) / إكليل الشمس, هالة شمسية (المنطقة الخارجية لغلاف الشمس الجوي؛ مرئية كهالة بيضاء أثناء الكسوف الشمسي)",
 "しんこうがかり": "ميسّر (شخص يجعل التقدم أسهل)",
 "しんこうけい": "دَائِر, مُسْتَمِرّ (يحدث الآن بشكل مستمر)",
 "しんこうこく": "دَوْلَة نَامِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "しんこうしゃ": "مُؤْمِن, مُؤْمِنَة (هو الشخص الذي يُؤْمِنُ بالشيء ويصدقه؛ من دخل في قلبه الإِيْمَان، وهو يطلق على من يدخل الإسلام)\nمثال: المؤمن لا يلدغ مرتين من جحر واحد.",
 "しんこうしょく": "سِقِلَّاتِيّ, قِرْمِزِيّ / سِقِلَّاط, سِقِلَّات",
 "しんこうしん": "تَقْوَى / بِرّ (أحسن إلى والديه أو إلى غيره بالخير والاحترام؛ صدق أو وفى بوعد أو عهد)\nمثال: دخل زيري إلى منطقة ببر.",
 "しんこうせい": "تَقَدُّمِيّ, مُتَرَقٍّ",
 "しんこうせいこつかせいせんいいけいせいしょう": "خلل التنسج الليفي المعظم المترقي (أدخل شيئًا بين آخر؛ جعل شيئًا يتخلل شيئًا آخر)",
 "しんこうそう": "مُسْتَمِرّ, هَيْئَة تَقَدُّمِيَّة (جهة الفعل التي تعبر عن حدث جارٍ)",
 "しんこうちゅう": "دَائِر, مُسْتَمِرّ (يحدث الآن بشكل مستمر)",
 "しんこうてき": "دِينِيّ / مُتَدَيِّنٌ, دَيِّنٌ",
 "しんこうとし": "مدينة مزدهرة (بلدة تتمتع بازدهار مفاجئ)",
 "しんこうのじゆう": "حُرِّيَّة اَلدِّين, حُرِّيَّة اَلْمُعْتَقَد (الحُرِّيَة : الخلُوص من الشَّوائب أَو الرقّ أَو اللُّؤْم؛ الحُرِّيَة : حَقُّ الإنْسَانِ فِي اخْتِيَارِ مَا يُرِيدُ حَسَبَ اعْتِقَادِهِ…)\nمثال: الحرية لفلسطين.",
 "しんこうは": "موجة متنقلة, موجة مسافرة (موجة يتحرك فيها الوسط في اتجاه انتشار الموجة)",
 "しんこうぶかい": "مُتَدَيِّن",
 "しんこうやく": "ميسّر (شخص يجعل التقدم أسهل)",
 "しんこく": "جِدِّيّ / جَدِّيّ, جَادّ / وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي. / الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان. / تشينغ, سلالة تشينغ (آخر سلالة إمبراطورية للصين (من 1644 إلى 1912) والتي أطاح بها الثوار؛ خلال سلالة تشينغ حكم المانشو الصين)",
 "しんこくか": "استفحال, تفاقم (إجراء يجعل المشكلة أو المرض (أو أعراضه) أسوأ) / إغاظة, استفزاز (سلوك غير ودي يسبب الغضب أو الاستياء) / تفاقم, حنق (شعور ساخط بالانزعاج)\nمثال: نتج تفاقم حالتها عن نقص الرعاية",
 "しんこくしゃ": "جازم, مؤكِّد (شخص يدعي قول الحقيقة) / مُعلن\nمثال: مؤكد جريء",
 "しんこくしょ": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "しんこつ": "قلباً وقالباً (بإيمان كامل)\nمثال: كانت معه قلباً وقالباً",
 "しんこつるい": "سمكة عظمية (سمكة عظمية من طويئفة العظميات)",
 "しんこてんしゅぎ": "كلاسيكية جديدة (إحياء لأسلوب كلاسيكي (في الفن أو الأدب أو العمارة أو الموسيقى) ولكن من منظور جديد أو بدافع جديد)",
 "しんこてんは": "كلاسيكية جديدة (إحياء لأسلوب كلاسيكي (في الفن أو الأدب أو العمارة أو الموسيقى) ولكن من منظور جديد أو بدافع جديد)",
 "しんこひん": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / نَعَم (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…) / لَا, لَاءَان (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "しんこん": "قلباً وقالباً (بإيمان كامل) / جوهر, خلاصة (الجزء المختار أو الأكثر أهمية أو حيوية في فكرة أو تجربة ما)\nمثال: كانت معه قلباً وقالباً / قَلْب, فُؤَاد / قَلْب / كُبَّا",
 "しんこんしょや": "ليلة الدخلة, ليلة الزفاف (الليلة التالية للزفاف عندما ينام العريس والعروس معاً)",
 "しんこんふうふ": "حديث الزواج (شخص تزوج حديثاً)",
 "しんこんりょこう": "شَهْر عَسَل (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر جزئا من السَنَة…)\nمثال: رمضان شهر حرام.",
 "しんご": "مُوَلَّدَة / تَوْلِيد",
 "しんごう": "إِشَارَة / إِشَارَة مُرُور / إِشَارَة ضَوْئِيَّة",
 "しんごうえんかん": "بادئ إشعال, فتيل (أي مشعل يستخدم لبدء حرق الوقود الدافع) / عود ثقاب مقاوم للرياح (عود ثقاب احتكاكي برأس كبير يظل مشتعلاً في الرياح) / شعلة تحذير (شعلة ملونة تستخدم كإشارة تحذير من قبل الشاحنات والقطارات) / فيوزي, محرك فيوزي (عمود دوران ذو أخدود حلزوني في الساعة يعمل على موازنة القوة المتناقصة للنابض الرئيسي أثناء انبساطه)",
 "しんごうき": "راية إشارة, علم (قطعة مستطيلة من القماش تستخدم كجهاز للإشارة) / إِشَارَة مُرُور / إِشَارَة ضَوْئِيَّة / إِشَارَة",
 "しんごうきょうど": "القوات الخاصة, شوتزشتافل (قوة شرطة خاصة في ألمانيا النازية تأسست كحرس شخصي لأدولف هتلر عام 1925؛ أدارت القوات الخاصة معسكرات الاعتقال) / الخدمة السرية الأمريكية (وكالة الاستخبارات الأمريكية التي تحمي الرؤساء ونواب الرئيس الحاليين والسابقين وعائلاتهم المباشرة وتحمي الزوار الأجانب المتميزين؛ تكشف وتقبض على مزوري…)",
 "しんごうけんしゅつ": "كشف الإشارة (الكشف عن استقبال إشارة)",
 "しんごうけんじゅう": "مسدس إشارة, مسدس فيري (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ)\nمثال: كان عند زيري مسدس.",
 "しんごうざつおんひ": "نِسْبَة الإِشَارَة إِلَى الضَّجِيج (نسبة كثافة الإشارة إلى كثافة الضجيج)",
 "しんごうたいノイズひ": "نِسْبَة الإِشَارَة إِلَى الضَّجِيج (نسبة كثافة الإشارة إلى كثافة الضجيج)",
 "しんごうでんぱ": "خَشَبَة / كَمَرَة, جَائِز / شُعَاع",
 "しんごうとう": "برج الإشارات, صندوق الإشارات (مبنى يتم من خلاله إرسال الإشارات للتحكم في حركة القطارات) / ضوء الإشارة, نار الإشارة (نار تُشعل كإشارة) / إشارة بصرية, سيمافور (جهاز للإشارات البصرية باستخدام الأضواء أو الأذرع المتحركة ميكانيكياً)",
 "しんごうふじ": "رَمْز نِدَاء (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "しんごん": "تعويذة, مانترا ((سنسكريتية) تعني حرفياً 'قول مقدس' في الفيدية؛ واحدة من مجموعة ترانيم شعرية منقولة شفهياً) / تعويذة متكررة, مانترا (كلمة أو عبارة مكررة بشكل شائع)\nمثال: كررت 'مسرورة جداً بسير الأمور' على فترات مثل المانترا",
 "しんさ": "إصدار الحكم, حكم (العملية المعرفية للوصول إلى قرار أو استخلاص استنتاجات) / زِنْجَفْر / اِسْتِكْشَاف",
 "しんさいかり": "قطع تحتي (قطع يتم في الجانب السفلي لإزالة مادة) / ضربة مقطوعة, قص ((رياضة) ضربة تضع دوراناً عكسياً على الكرة) / حز التوجيه, قطع تحتي (حز يُقطع في جذع الشجرة لتحديد اتجاه سقوطها) / تندرلوين, فيليه الظهر (اللحم الطري لعضلة الخاصرة على جانبي العمود الفقري)\nمثال: الضربات المقطوعة لا تزعج لاعب التنس الجيد",
 "しんさいん": "فاحص, مفتش (محقّق يراقب ويدقق بعناية) / مختبِر, ممتحِن (شخص يدير اختبارًا لتحديد مؤهلاتك)\nمثال: بحث الفاحص عن أدلة",
 "しんさい刈り": "قطع تحتي (قطع يتم في الجانب السفلي لإزالة مادة) / ضربة مقطوعة, قص ((رياضة) ضربة تضع دوراناً عكسياً على الكرة) / حز التوجيه, قطع تحتي (حز يُقطع في جذع الشجرة لتحديد اتجاه سقوطها) / تندرلوين, فيليه الظهر (اللحم الطري لعضلة الخاصرة على جانبي العمود الفقري)\nمثال: الضربات المقطوعة لا تزعج لاعب التنس الجيد",
 "しんさかん": "فاحص, مفتش (محقّق يراقب ويدقق بعناية) / مختبِر, ممتحِن (شخص يدير اختبارًا لتحديد مؤهلاتك)\nمثال: بحث الفاحص عن أدلة",
 "しんさく": "اِزْدِهَار, رَخَاء / تُحْفَة, رَائِعَة",
 "しんさけん": "مراجعة قضائية (مراجعة من قبل محكمة قانونية لإجراءات مسؤول حكومي أو هيئة أو شخص أو هيئة أخرى معينة قانونياً أو مراجعة محكمة استئناف لقرار محكمة ابتدائية)",
 "しんさつ": "بَنْكْنُوت, وَرَقَة نَقْدِيَّة / فحص طبي, كشف طبي (فحص بدني شامل؛ يتضمن مجموعة متنوعة من الاختبارات حسب العمر والجنس وصحة الشخص)",
 "しんさつしょ": "عِيَادَة, مَصَحَّة",
 "しんさん": "مَشَقَّة, شِدَّة / قَصْد, إِرَادَة",
 "しんざい": "خشب القلب (هو ما غَلَظَ وصَلُبَ من أصول الشَجَر وفروعها مثل الجِذْع والأغْصَان؛ هو ما صنع من جذوع أو أغصان الشَجَر)\nمثال: نحن نقطع الخشب. / بث, حقن (فعل غرس أو إدخال عنصر أو صفة معدلة معينة) / تسريب ((طب) الإدخال السلبي لمادة (سائل أو دواء أو إلكتروليت) في وريد أو بين الأنسجة (كما عن طريق قوة الجاذبية)) / منقوع, نقع (عملية استخلاص خصائص فعالة معينة (كدواء من نبات) عن طريق النقع أو الغمر (عادة في الماء)) / مستخلص, منقوع (محلول يتم الحصول عليه عن طريق نقع مادة (عادة في الماء))\nمثال: يُعزى النجاح المستمر للفريق إلى الضخ المستمر للمواهب الجديدة",
 "しんざつおん": "لغط القلب, نفخة قلبية (صوت غير طبيعي للقلب؛ أحياناً يكون علامة على وظيفة غير طبيعية لصمامات القلب)",
 "しんざん": "قادم جديد, مستجد (أي مشارك جديد في نشاط ما) / وافد جديد (شخص وصل حديثًا)\nمثال: هو وافد جديد إلى بوسطن / قَصْد, إِرَادَة",
 "しんざんもの": "قادم جديد, مستجد (أي مشارك جديد في نشاط ما) / وافد جديد (شخص وصل حديثًا)\nمثال: هو وافد جديد إلى بوسطن",
 "しんし": "نقع (غسل شيء عن طريق تركه منقعاً في سائل) / إشباع بالماء, نقع (فعل جعل الشيء مبللاً تماماً) / غارقاً في البلل, مبللاً تماماً (رطب للغاية) / غمر, نقع (عملية التلين والتشبع نتيجة الغمر في الماء (أو سائل آخر))\nمثال: نقعه بالماء نقعاً / مُخْلِص (الشخص الذي يفي ولا يخون)\nمثال: الغيرة لا تجعل أحد مخلص / اَلسَّيِّد, سَيِّد / نُوَاس / رَقَّاص / بَنْدُول / مُؤْمِن, مُؤْمِنَة (هو الشخص الذي يُؤْمِنُ بالشيء ويصدقه؛ من دخل في قلبه الإِيْمَان، وهو يطلق على من يدخل الإسلام)\nمثال: المؤمن لا يلدغ مرتين من جحر واحد. / ضَرِيح / رسول إلهي (رسول من عند الله)\nمثال: إنهم كائنات خارقة للطبيعة تعمل كرسل إلهيين بين الناس والآلهة / مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع",
 "しんしおん": "صوت شفوي سني (صامت يتضمن نطقه الشفاه والأسنان)",
 "しんしがい": "مدينة جديدة (مجتمع حضري مخطط أُنشئ في منطقة ريفية أو غير متطورة، ومصمم ليكون مكتفياً ذاتياً بمرافقه السكنية والتعليمية والتجارية والترفيهية)",
 "しんしきょうてい": "اتفاق السادة, اتفاق شرف (اتفاق شخصي قائم على الشرف وغير ملزم قانوناً)",
 "しんししゅくじょ": "سَيِّدَاتِي وَسَادَتِي",
 "しんしっかん": "اعتلال القلب, مرض القلب (مرض يصيب القلب)",
 "しんしつ": "مَخْدَع, غُرْفَةُ نَوْم / بُطَيْن",
 "しんしつさいどう": "رجفان بطيني",
 "しんしてき": "نَبِيلُ السُّلُوكِ (يليق برجل حسن التربية)",
 "しんしふう": "نَبِيلُ السُّلُوكِ (يليق برجل حسن التربية)",
 "しんしゃ": "زِنْجَفْر",
 "しんしゃく": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "しんしゅ": "مبادر, مقدام (يتميز بالخيال والمبادرة والاستعداد للقيام بمشاريع جديدة)\nمثال: سياسة خارجية مقدامة",
 "しんしゅう": "طبعة جديدة (منشور (مثل كتاب) تم تعديله أو تحديثه وعرضه للبيع مرة أخرى) / الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان. / غَزْو, إِغَارَة (أَغَارَ عَلَى العَدُوِّ غَزْواً : سَارَ إِلَى مُحَارَبَتِهِ وَقِتَالِهِ فِي عُقْرِ دِيَارِهِ؛ سيطرة على دولة أو منطقة بواسطة قوّات مُسلَّحة أجنبيّة)\nمثال: الصين مستعدة لغزو تايوان. / عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة.",
 "しんしゅうてき": "غَازٍ",
 "しんしゅく": "مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته",
 "しんしゅくじざい": "مَرِن",
 "しんしゅくせい": "مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته",
 "しんしゅくほう": "سلم متحرك للأجور (سلم أجور يتقلب استجابة لمؤشر تكلفة المعيشة)",
 "しんしゅくほうたい": "رباط ضاغط مرن (ضمادة تحتوي على مادة قابلة للتمدد يمكنها تطبيق ضغط موضعي)",
 "しんしゅつ": "تسلل (عملية يخترق فيها أفراد (أو مجموعات صغيرة) منطقة (خاصة الاختراق العسكري لمواقع العدو دون كشفهم)) / تخلل, ترشيح (المرور البطيء لسائل عبر وسط ترشيح)\nمثال: تخلل مياه الأمطار عبر التربة / يقرب\nمثال: その会社は中国への進出を目指している。 — تهدف الشركة إلى فتح فروع في الصين. / يقرب / تَطَفُّل, مُدَاخَلَة",
 "しんしゅつきぼつ": "متملص, مراوغ",
 "しんしゅてき": "مبادر, مقدام (يتميز بالخيال والمبادرة والاستعداد للقيام بمشاريع جديدة)\nمثال: سياسة خارجية مقدامة",
 "しんしゅん": "السَّنَة الْجَدِيدَة",
 "しんしょ": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء. / عَاطِفَة, عَوَاطِف / يام أبيض, يام الماء (يزرع في أسترالاسيا وبولينيزيا لجذره الكبير ذو اللحم الأبيض الناعم الصالح للأكل)",
 "しんしょう": "اِنْطِبَاع, أَثَر / تَقْلِيد / إيمان راسخ, قناعة (إيمان راسخ بشيء ما دون الحاجة إلى إثبات أو دليل) / ثَرْوَة / أموال, موارد مالية (أصول في شكل مال) / رَصِيد, مَكْسَب (صفة مفيدة أو ذات قيمة) / دَلِيل, بُرْهَان / دَلِيل / أمبروزيا, طعام الآلهة ((الأساطير الكلاسيكية) طعام وشراب الآلهة؛ البشر الذين أكلوه أصبحوا خالدين) / أمبروزيا (تحلية فواكه مصنوعة من البرتقال والموز مع جوز الهند المبشور) / أمبروزية, دمسيسة (أي من العديد من النباتات الضارة في أمريكا الشمالية التي تشكل جنس الأمبروزية والتي تنتج حبوب لقاح مسببة للحساسية الشديدة المسؤولة عن الكثير من حمى…) / خبز النحل (خليط من الرحيق وحبوب اللقاح يعده النحل العامل ويُطعم لليرقات) / صورة, صورة ذهنية (تمثيل عقلي أيقوني (يشبه الصورة المرئية))\nمثال: فرض خيالها عليها صوراً مروعة جداً لا يمكن تأملها / اضطراب نفسي",
 "しんしょうがつ": "يَنَايِر, كَانُون اَلثَّانِي (الشهر الأول من السنة الروميّة)\nمثال: لتبدأ الاحتفالات بيناير.",
 "しんしょうぼうだい": "مُبَالَغَة (بصيغة المؤنث؛ الزيادة حتى يبلغ أقصى الشيء أو الأمر)\nمثال: توم يحب المبالغة.",
 "しんしょうもち": "ثري, غني (شخص يمتلك ثروة مادية كبيرة) / أعمال منزلية, تنظيف المنزل (عمل تنظيف وإدارة المنزل)",
 "しんしょく": "تأثير, تعدي (التأثير بقوة) / انتهاك حرمة, تجاوز (دخول ممتلكات شخص آخر دون حق أو إذن) / اجتياح, تطفل (أي دخول إلى منطقة لم تكن مشغولة سابقاً)\nمثال: استاءوا من طغيان القيم الأمريكية على الثقافة الأوروبية / تآكل, حت (تآكل بفعل العمليات الكيميائية) / تعرية, نحت ((في الجيولوجيا) العملية الميكانيكية لتآكل أو طحن شيء ما (كما يحدث عند غسل الجسيمات له)، وتستخدم مجازياً أيضاً) / تآكل, تراجع (انخفاض تدريجي لشيء ما) / تآكل, تعرية (حالة يتآكل فيها سطح الأرض بفعل الماء والرياح)\nمثال: بعد فضيحة المحاسبة كان هناك تآكل في الثقة في المدققين",
 "しんしょくみんちしゅぎ": "اِسْتِعْمَار جَدِيد, نِيوُكُولُونِيالِيّة",
 "しんしようそうしんぐしょうにん": "بائع ملابس رجالية, تاجر ملابس (تاجر يبيع الملابس الرجالية)",
 "しんしろく": "دليل (قائمة أبجدية بالأسماء والعناوين) / دليل ((علوم الكمبيوتر) قائمة بالملفات المخزنة في الذاكرة (عادة على قرص صلب))",
 "しんしん": "اِنْتِفَاضَة, تَمَرُّد (معارضة منظمة للسلطة؛ صراع يحاول فيه فصيل انتزاع السيطرة من آخر) / بَازِغ, صَاعِد (برز حديثاً إلى الواجهة) / صَاعِد, نَاشِئ (يَبْلُغُ مَرْحَلَةَ النُّضْج) / طَالِع, مُنْحَدِرٌ صُعُودًا (مَائِلٌ نَحْوَ الأَعْلَى) / فَيَّاض, مُتَدَفِّق (يُعبَّر عنه بحماسة غير مقيّدة) / مُتَدَفِّق, مُنْهَمِر (يسيل بغزارة) / صَامِت, سَاكِت / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / ثَاقِب, حَادّ (لَدَيْهِ القُدْرَةُ عَلَى التَّمْيِيزِ الدَّقِيقِ وَالإِدْرَاكِ العَمِيق) / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / طيران (حالة السفر جواً) / خَاطِف, عَابِر (سريع وقصير؛ على عجل) / سَرِيع الحَرَكَة, طَائِر (يتحرك بسرعة كبيرة)\nمثال: كان الطيران لا يزال مغامرة مثيرة بالنسبة له",
 "しんしんいったい": "شمولية, نظرية شمولية (النظرية القائلة بأن أجزاء أي كل لا يمكن أن توجد ولا يمكن فهمها إلا في علاقتها بالكل)\nمثال: تفيد الشمولية بأن الكل أكبر من مجموع أجزائه",
 "しんしんきえい": "مُجْتَهِد, نَشِيط (يعمل بجدّ لتعزيز مشروع أو مؤسّسة)",
 "しんしんそうしつ": "جُنُون",
 "しんじ": "الوَخْز بِالْإِبْر / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / تَبْطِين / مُؤْمِن, مُؤْمِنَة (هو الشخص الذي يُؤْمِنُ بالشيء ويصدقه؛ من دخل في قلبه الإِيْمَان، وهو يطلق على من يدخل الإسلام)\nمثال: المؤمن لا يلدغ مرتين من جحر واحد. / كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك. / صيوان الأذن (البنية الغضروفية المرئية خارجياً للأذن الخارجية) / أذينة (جيب مخروطي صغير يبرز من الجزء الأمامي العلوي لكل أذين من القلب) / أُذَيْن",
 "しんじがたい": "لا يصدق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "しんじきる": "ثِقَة / تْرَسْت, اِئْتِمَان / وَثِقَ (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء.",
 "しんじだい": "العَصْر الجَدِيد",
 "しんじち": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة. / بصدق, حقاً (وفقاً للحقيقة أو الواقع) / بصدق, حقاً (في الواقع (تستخدم للتوكيد أو تعديل الجملة)) / بِجَدَارَة, بِحَقّ (بموجب الحق أو الشرعية) / بإخلاص, بصدق (بصدق؛ دون تصنع)\nمثال: أصبحت الآن أمريكية حقاً",
 "しんじつ": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…) / حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة. / بصدق, حقاً (وفقاً للحقيقة أو الواقع) / بصدق, حقاً (في الواقع (تستخدم للتوكيد أو تعديل الجملة)) / بِجَدَارَة, بِحَقّ (بموجب الحق أو الشرعية) / بإخلاص, بصدق (بصدق؛ دون تصنع)\nمثال: أصبحت الآن أمريكية حقاً",
 "しんじつせい": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…) / وَلَاء",
 "しんじつみ": "صِدْق (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع)\nمثال: صدق سامي كل شيء. / إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "しんじゃ": "مُؤْمِن, مُؤْمِنَة (هو الشخص الذي يُؤْمِنُ بالشيء ويصدقه؛ من دخل في قلبه الإِيْمَان، وهو يطلق على من يدخل الإسلام)\nمثال: المؤمن لا يلدغ مرتين من جحر واحد. / معجب مهووس (معجب ذكر مهووس بموضوع معين (خاصة شخص أو شيء في وسائل الترفيه الشعبية))",
 "しんじゅ": "اِعْتِقَاد / عَقِيدَة (المُعَاقِدَة، بمعنى اسم الفاعل؛ المعقودة، بمعنى اسم المفعول) / إيمان / لُؤْلُؤَة / لُؤْلُؤ (نوع من المجوهرات الغالية التي تكون في البحر عميقًا؛ اسم شخصي معطًى ذو استخدامات تاريخية للذكور من العرب) / جَوْهَر (جَوْهَر)\nمثال: يريد شراء عقد لؤلؤ لزوجته. / شجرة القطن الحريري, قابوق (شجرة استوائية ضخمة ذات تلال عميقة على جذعها الضخم وتحمل قروناً كبيرة من البذور مغطاة بزغب حريري؛ مصدر لألياف القابوق الحريرية)",
 "しんじゅいろ": "رَمَادِيّ لُؤْلُؤِيّ (رمادي مع لمعة لؤلؤية)",
 "しんじゅう": "عبودية الأرض, قنانة (حالة القن (عبد الأرض))",
 "しんじゅうだて": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…) / وَلَاء / وَفَاء, إِخْلَاص",
 "しんじゅうるい": "ثدييات مشيمية, مشيميات (ثدييات لها مشيمة؛ جميع الثدييات باستثناء الكظاميات والجرابيات) / حقيقي الوحشية, مشيمي (من أو يتعلق بالثدييات المشيمية (الحقيقية))\nمثال: ثدييات مشيمية",
 "しんじゅがい": "محار اللؤلؤ (ذوات صدفتين بحرية استوائية توجد بشكل رئيسي قبالة شرق آسيا وساحل المحيط الهادئ لأمريكا الشمالية وأمريكا الوسطى؛ مصدر رئيسي للؤلؤ)",
 "しんじゅこうたく": "تقزح, تلاعب لوني (الخاصية البصرية لشيء له سطوع حليبي وتلاعب بالألوان من السطح)",
 "しんじゅさん": "عثة سينثيا (عثة آسيوية كبيرة أُدخلت إلى الولايات المتحدة؛ تتغذى اليرقات على شجرة السماء)",
 "しんじゅしつ": "عِرْق اللُّؤْلُؤ, زِلْف (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "しんじゅそう": "عِرْق اللُّؤْلُؤ, زِلْف (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "しんじゅつ": "الوَخْز بِالْإِبْر / تَصْرِيح, بَيَان / طَبِيعَة, طبيعة",
 "しんじゅとり": "غواص لؤلؤ (غواص يبحث عن الرخويات التي تحتوي على اللؤلؤ)",
 "しんじゅぼ": "عِرْق اللُّؤْلُؤ, زِلْف (وريد أو شريان، مجرى الدَّم في الجسَد؛ جِنْس؛ سُلَالَة من النّاس يُصنَّفون بناء على التَّاريخ أو الجنسيّة أو التّوزيع الجغرافيّ المشترك)\nمثال: هذا القميص مبلل بالعرق.",
 "しんじゅん": "تسلل (عملية يخترق فيها أفراد (أو مجموعات صغيرة) منطقة (خاصة الاختراق العسكري لمواقع العدو دون كشفهم)) / تخلل, ترشيح (المرور البطيء لسائل عبر وسط ترشيح)\nمثال: تخلل مياه الأمطار عبر التربة / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "しんじゆうしゅぎ": "نِيُولِيبِرَالِيَّة",
 "しんじゆうしゅぎしゃ": "نِيُولِيبْرَالِيّ (يُؤْمِنُ بِضَرُورَةِ النُّمُوِّ الِاقْتِصَادِيِّ إِضَافَةً إِلَى الأَهْدَافِ اللِّيبْرَالِيَّةِ التَّقْلِيدِيَّةِ) / ليبرالي جديد (ليبرالي يتبنى الليبرالية الجديدة)",
 "しんじょ": "كرة السمك, كعكة السمك (كرة مقلية أو قرص من السمك المفتت والبطاطس المهروسة) / مَخْدَع, غُرْفَةُ نَوْم / حالة عقلية, حالة نفسية ((علم النفس) حالة عقلية تكون فيها صفات الحالة ثابتة نسبيًا على الرغم من أن الحالة نفسها قد تكون ديناميكية)\nمثال: الإجهاد ليس الحالة العاطفية أو العقلية الوحيدة التي يمكن أن تستفيد من التأمل المنتظم",
 "しんじょう": "عَقِيدَة (المُعَاقِدَة، بمعنى اسم الفاعل؛ المعقودة، بمعنى اسم المفعول) / عَاطِفَة / رَصِيد, مَكْسَب (صفة مفيدة أو ذات قيمة) / إِبْرِيّ, إِبْرِيّ الشَّكْل (ضيّق وطويل ومُدبَّب؛ كأوراق الصَّنَوْبَر) / مِعْطَاء",
 "しんじょうてき": "رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق) / عَاطِفِيّ, وِجْدَانِيّ (يميل إلى العاطفة أو يتسم بها)",
 "しんじょうもの": "هَدِيَّة, هدية / قَرِيحَة / أَهْدَى",
 "しんじょうろん": "انفعالية, عاطفية (طبيعة أو صفة عاطفية)",
 "しんじようとしんじまいと": "صدق أو لا تصدق (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع)\nمثال: صدق سامي كل شيء.",
 "しんじられない": "غير معقول, لا يصدق (يتجاوز التصديق أو الفهم)\nمثال: بسرعة لا تصدق",
 "しんじる": "صَدَّقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع) / ظَنَّ, آمَنَ (عَلِمَ بغير يقين؛ عَلِمَ بيقين) / آمَنَ بِـ (وَثِقَ وصَدَّقَ؛ جعله في مأمن، بمفعول، وقد يتعدى بمفعول ثاني بمن)\nمثال: صدق سامي كل شيء.",
 "しんじん": "إِيمَان, مُعْتَقَد / إِيمَان, دِين / قادم جديد, مستجد (أي مشارك جديد في نشاط ما) / وافد جديد (شخص وصل حديثًا)\nمثال: هو وافد جديد إلى بوسطن / إنسان عاقل (شبيه البشر الوحيد الباقي؛ النوع الذي ينتمي إليه الإنسان الحديث؛ رئيسيات تسير على قدمين ولها لغة وقدرة على صنع واستخدام أدوات معقدة؛ حجم الدماغ لا يقل…) / سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ) / عَمِيقٌ مِنَ الأَعْمَاق (نَابِعٌ مِنْ أَعْمَاقِ النَّفْس) / بَالِغُ العُمْق, عَمِيقٌ جِدًّا (مِنْ أَشَدِّ دَرَجَاتِ الحِدَّةِ؛ تَامّ) / سَمِيع (سَميع: (اسم)؛ سميع: (اسم)) / سَمْع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى)) / جَلْسَة\nمثال: سمع سامي صريرا.",
 "しんじんか": "متعصب ديني, مهووس بالدين (شخص مدمن على الدين أو متعصب ديني)",
 "しんじんけんしゅう": "توجيه, دورة توجيهية (دورة تقدم موقفاً أو بيئة جديدة)",
 "しんじんなる": "سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ) / عَمِيقٌ مِنَ الأَعْمَاق (نَابِعٌ مِنْ أَعْمَاقِ النَّفْس) / بَالِغُ العُمْق, عَمِيقٌ جِدًّا (مِنْ أَشَدِّ دَرَجَاتِ الحِدَّةِ؛ تَامّ)",
 "しんじんぶかい": "مُتَدَيِّن",
 "しんすい": "توقير, عبادة (العبادة المقدمة لله وحده) / تبجيل, عشق (فعل الإعجاب بشدة) / عبادة, هيام (شعور بالحب العميق والإعجاب) / تَفَرُّغ / فيضان / أَعْمَال مَنْزِل, أَعْمَال الْمَنْزِل (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما أشبه)\nمثال: أنا في رحلة أعمال. / إطلاق, قذف (فعل الدفع بقوة) / إطلاق سفينة, تدشين (فعل تحريك سفينة مبنية حديثاً إلى الماء لأول مرة) / إطلاق, تدشين (فعل البدء بشيء جديد)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد / أليف للماء, محب للماء (لديه ألفة قوية للماء؛ يميل للذوبان في الماء أو الامتزاج به أو التبلل به)",
 "しんすいせい": "أليف للماء, محب للماء (لديه ألفة قوية للماء؛ يميل للذوبان في الماء أو الامتزاج به أو التبلل به)",
 "しんすう": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "しんずい": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر / نِقْيُ ٱلْعَظْم, مُخُّ ٱلْعَظْم / كُوسَا / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / سنتر, لاعب وسط (مركز في فريق كرة السلة للاعب الذي يشارك في قفزة البداية التي تبدأ المباراة) / سنتر, لاعب وسط ((كرة قدم أمريكية) مركز اللاعب على خط الاشتباك الذي يضع الكرة في اللعب) / سنتر, لاعب وسط (مركز في فريق الهوكي للاعب الذي يشارك في مواجهة البداية عند بداية المباراة)\nمثال: مسؤولية السنتر هي إيصال الكرة إلى الكوارترباك",
 "しんずべき": "ثِقَةٌ",
 "しんずる": "صَدَّقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع) / ظَنَّ, آمَنَ (عَلِمَ بغير يقين؛ عَلِمَ بيقين) / آمَنَ بِـ (وَثِقَ وصَدَّقَ؛ جعله في مأمن، بمفعول، وقد يتعدى بمفعول ثاني بمن)\nمثال: صدق سامي كل شيء. / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "しんせい": "مُسْتَعِر / اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / عصر النهضة, نهضة (إحياء التعلم والثقافة) / انبعاث, تناسخ الأرواح (ولادة ثانية أو جديدة) / تناسخ الأرواح (بعد الموت تبدأ الروح دورة جديدة من الوجود في جسم بشري آخر) / تَطْبِيق / كِتَاب, اِسْتِمَارَة (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…)\nمثال: هذا الكتاب جديد / أَصْلِيّ / إِلَٰهِيَّة / قُدْسِيَّة / ثِيُقْرَاطِيَّة / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / جِرْم سَمَاوِيّ, جِرْم فَلَكِيّ (جَرَم الشَّخْصُ: أَذْنَبَ وَاكتَسَبَ الإِثْمَ؛ جَرَم نفسَه / جَرَم قومَه / جَرَم على / جَرَم على قومه: جَنَى جَنَايَةً)\nمثال: الإهمال هو نوع من الضرر أو الجرم / زِئْبَق, زَاؤُوق / حُلْبُوب / حَقٌّ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له)\nمثال: الأستاذ على حق.",
 "しんせいか": "تقديس (حفل ديني يتم فيه جعل شيء مقدسًا)",
 "しんせいかつ": "بداية جديدة, صفحة بيضاء (فرصة للبدء من جديد دون أحكام مسبقة)",
 "しんせいがん": "باثوليت, صخر بلوتوني (كتلة كبيرة من الصخور النارية المتطفلة يعتقد أنها تصلبت في أعماق الأرض)",
 "しんせいきせだい": "ألفي (متعلق بألفية أو فترة تمتد لألف عام)",
 "しんせいこうこう": "مَدْرَسَة ثَانَوِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "しんせいさいきん": "بكتيريا, جرثومة ((في علم الأحياء الدقيقة) كائنات وحيدة الخلية أو غير خلوية كروية أو حلزونية أو عصوية الشكل تفتقر إلى الكلوروفيل وتتكاثر بالانشطار؛ مهمة كمسببات…)",
 "しんせいし": "تأليه, تعظيم (رفع شخص ما (إلى مرتبة إله)) / مثال للكمال, نموذج مثالي (نموذج للتميز أو الكمال من نوعه؛ شخص لا مثيل له)",
 "しんせいしゃ": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "しんせいじしぼう": "وفاة حديثي الولادة (وفاة رضيع ولد حياً خلال أول 28 يوماً من الحياة)",
 "しんせいじとうぶひふえん": "قبعة المهد (التهاب جلد فروة الرأس الشائع عند الرضع)",
 "しんせいじようけつせいしっかん": "كثرة الأرومات الحمر الجنينية",
 "しんせいすいへいは": "حَفَّار",
 "しんせいせい": "قُدْسِيَّة (صفة كون الشيء مقدساً)",
 "しんせいせんそう": "حَرْب مُقَدَّسَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "しんせいだいがく": "جَامِعَة (مؤنث الجَامِع، اسم فاعل من جَمَعَ، التي تَجْمَع؛ الغُلّ يجمع اليدين إِلى العُنُق)\nمثال: هكذا دخل الجامعة.",
 "しんせいちゅうがく": "مدرسة إعدادية, مدرسة متوسطة (مدرسة ثانوية تشمل عادة الصفين السابع والثامن)",
 "しんせいにん": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "しんせいぶつ": "ورم (كتلة نسيجية جديدة غير طبيعية لا تخدم أي غرض)",
 "しんせいもじ": "هِيرُوغْلِيفِيَّة",
 "しんせいコレラ": "كوليرا (عدوى معوية حادة ناجمة عن تناول مياه أو طعام ملوث)",
 "しんせいローマこうてい": "إمبراطور روماني مقدس (عاهل الإمبراطورية الرومانية المقدسة)",
 "しんせいローマていこく": "اَلْإِمْبَرَاطُورِيَّة اَلرُّومَانِيَّة اَلْمُقَدَّسَة",
 "しんせかい": "الْعَالَم الْجَدِيد",
 "しんせかいざる": "قرد العالم الجديد (قرود شجرية ذات وجوه مشعرة ولها فتحتا أنف متباعدتان وذيول طويلة عادة ما تكون قابضة)",
 "しんせき": "نقع (غسل شيء عن طريق تركه منقعاً في سائل) / إشباع بالماء, نقع (فعل جعل الشيء مبللاً تماماً) / غارقاً في البلل, مبللاً تماماً (رطب للغاية) / غمر, نقع (عملية التلين والتشبع نتيجة الغمر في الماء (أو سائل آخر))\nمثال: نقعه بالماء نقعاً / نِسْبِيّ / قَرِيب, قَرِيبَة",
 "しんせきかんけい": "تَعَامُلَات, عَلَاقَات (تعاملات متبادلة أو اتصالات أو تواصل بين الأشخاص أو الجماعات)",
 "しんせっきじだい": "حجري حديث, نيوليثي (من أو متعلق بأحدث فترة من العصر الحجري (تلي العصر الحجري المتوسط))\nمثال: أدلة على مستوطنات من العصر الحجري الحديث",
 "しんせつ": "إنشاء, ابتداء (فعل بدء شيء ما لأول مرة؛ تقديم شيء جديد)\nمثال: تطلعت إلى بدايتها كشخص بالغ / نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "しんせつがっぺい": "تكامل, توحيد (عملية الدمج في كلٍ متكامل) / تصلب, تماسك (التجمع في كتلة صلبة) / كُتْلَة مُتَصَلِّبَة (شيء تصلب ليصبح كتلة مدمجة)\nمثال: دمج شركتين",
 "しんせつぎ": "طيبة قلب (تعاطف نابع من قلب طيب)",
 "しんせつごかし": "تمجيد الذات, غرور (عمل يتم لزيادة قوتك ونفوذك أو لجذب الانتباه لأهميتك الخاصة)",
 "しんせつしん": "إِحْسَان",
 "しんせん": "طَازَج, طَازَة / عَذْب / عَمْق / كائن خارق للطبيعة, كيان روحي (كائن غير مادي يُعتقد أن له قوى تؤثر على مسار الأحداث البشرية) / ارتجاف, رعشة (اهتزاز لا إرادي (كما لو كان بسبب المرض أو الخوف)) / رعشة أرضية, زلزال صغير (زلزال صغير) / ارتجاف, رعشة (اهتزاز أو ارتعاش (ناتج عادة عن ضعف أو توتر أو مرض)) / شِينْتْشِين, شِينْجِين / قَائِدُ فِرْقَاتٍ مُوسِيقِيَّةٍ / كُمْسَرِيّ, كُمْسَارِيّ / مُوَصِّل كَهْرَبَائِيّ, مُوَصِّل / تنجيم, عرافة (فن أو موهبة النبوءة (أو ادعاء النبوءة) بوسائل خارقة للطبيعة) / نبوءة (تنبؤ ينطق به تحت إلهام إلهي) / حَدْس صَائِب, فِرَاسَة (تخمين ناجح عن طريق بصيرة غير عادية أو حظ جيد)",
 "しんせんせんもう": "هذيان ارتعاشي (هذيان حاد ناجم عن التسمم الكحولي)",
 "しんせんそくりょう": "قِيَاس الْأَعْمَاق, مِعْمَاقِيَّة",
 "しんせんまひ": "الشلل الرعاش, داء باركنسون (اضطراب تنكسي في الجهاز العصبي المركزي يتميز بالرعاش وضعف التنسيق العضلي)",
 "しんせんみ": "جِدَّة, طَرَافَة (الأصالة بحكم كون الشيء جديداً ومنعشاً) / صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / طزاجة, نضارة (خاصية كون الشيء نقياً وطازجاً (كأنه صنع حديثاً)؛ غير بائت أو متدهور) / جدة, حداثة (الأصالة بحكم كونها جديدة ومفاجئة)\nمثال: أحبت طزاجة الخبز المخبوز حديثاً",
 "しんぜる": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "しんぜん": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "しんぜんじあい": "لَطِيف (ذو اللطف وذو اللطافة؛ من الكلام: هو عمض معناه وخفي)\nمثال: هي مدرسة لطيفة.",
 "しんそ": "اتحاد ائتماني, جمعية تعاونية للتسليف (مؤسسة مالية إيداعية تعاونية يمكن لأعضائها الحصول على قروض من مدخراتهم المشتركة)",
 "しんそう": "أعماق, أغوار ((الجمع) الجزء الأعمق والأكثر بعداً)\nمثال: من أعماق أفريقيا المظلمة / حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة. / تجديد, ترميم (حالة الاستعادة إلى الحالة الجيدة السابقة)\nمثال: كان النزل تجديداً لمنزل استعماري",
 "しんそうきゅうめいいいんかい": "تقصي الحقائق",
 "しんそうしんり": "عقل لاواعي, لاوعي (ذلك الجزء من العقل الذي يحدث فيه النشاط النفسي الذي لا يدركه الشخص)",
 "しんそうしんりがく": "تحليل نفسي, علم نفس الأعماق (مجموعة من التقنيات لاستكشاف الدوافع الكامنة وطريقة لعلاج الاضطرابات العقلية المختلفة؛ تستند إلى نظريات سيغموند فرويد)\nمثال: أوصى طبيبه بالتحليل النفسي",
 "しんそうすい": "مشكلة عويصة, مياه عميقة (مشكلة خطيرة)",
 "しんそうちょうさ": "تقصي الحقائق",
 "しんそうほうかい": "رَاسِخ, عَمِيق الجُذُور ((يستخدم خاصة للأفكار أو المبادئ) عميق الجذور؛ ثابت ومتمكّن بقوّة)",
 "しんそく": "سرعة (معدل (عادة سريع) يحدث به شيء ما)\nمثال: تقدم المشروع بسرعة مرضية",
 "しんそこ": "قَلْبًا وَقَالَبًا",
 "しんそつ": "أمانة, صدق (صفة كون الشخص صادقاً) / زهرة الدراهم, لوناريا (نبات من جنوب شرق أوروبا يُزرع لأزهاره الأرجوانية العطرة وقرون بذوره الورقية الفضية البيضاء المستديرة المسطحة التي تستخدم للزينة الداخلية)",
 "しんぞ": "بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء. / زَوْجَة, اِمْرَأَة",
 "しんぞう": "قَلْب, فُؤَاد / قَلْب / كُبَّا / أَحْشَاء / صورة, صورة ذهنية (تمثيل عقلي أيقوني (يشبه الصورة المرئية))\nمثال: فرض خيالها عليها صوراً مروعة جداً لا يمكن تأملها / بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء. / زَوْجَة, اِمْرَأَة / صَنَم, وَثَن (الصَّنَم: نَحْتٌ من خَشَبٍ ويُصَاغُ من نُحاسٍ، وغيره يُصنع لعبادته. ويُسمى أيضًا وَثَنًا) / آيْدُول",
 "しんぞうえん": "التهاب القلب (التهاب القلب)",
 "しんぞうがく": "طِبّ اَلْقَلْب (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "しんぞうけい": "قلبي, منحنى قلبي (دويري خارجي تتساوى فيه الدائرة المتدحرجة مع الدائرة الثابتة) / قَلْبِيّ الشَّكْل ((عن الورقة) على شكل قلب)",
 "しんぞうげか": "جراحة القلب (أي إجراء جراحي يتعلق بالقلب)",
 "しんぞうご": "مُوَلَّدَة / تَوْلِيد",
 "しんぞうしゅじゅつ": "جراحة القلب (أي إجراء جراحي يتعلق بالقلب)",
 "しんぞうせんもんい": "أخصائي قلب, جراح قلب (أخصائي في طب القلب؛ متخصص في بنية ووظيفة واضطرابات القلب)",
 "しんぞうちょうおんぱけんさ": "تخطيط صدى القلب (إجراء تشخيصي غير جراحي يستخدم الموجات فوق الصوتية لدراسة بنية وحركات القلب)",
 "しんぞうていし": "سَكْتَة قَلْبِيَّة",
 "しんぞうにけがはえた": "صَفِيق, وَقِح (لا يتقيّد بالأعراف أو اللياقة؛ جريء بشكل فظّ)",
 "しんぞうびょう": "اعتلال القلب, مرض القلب (مرض يصيب القلب)",
 "しんぞうびょうがく": "طِبّ اَلْقَلْب (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "しんぞうぶ": "قَلْب, فُؤَاد / قَلْب / كُبَّا",
 "しんぞうべん": "صمام قلب (زرعة تحل محل صمام قلبي طبيعي) / صمام قلبي (صمام للتحكم في تدفق الدم في اتجاه واحد)",
 "しんぞうべんまく": "صمام قلب (زرعة تحل محل صمام قلبي طبيعي) / صمام قلبي (صمام للتحكم في تدفق الدم في اتجاه واحد)",
 "しんぞうべんまくしょう": "مرض صمام القلب (مرض قلبي ناجم عن تضيق صمامات القلب وانسداد تدفق الدم أو ناجم عن التنكس وارتجاع الدم)",
 "しんぞうほっさ": "اِحْتِشَاء قَلْبِيّ, احتشاء عضلة القلب",
 "しんぞうまひ": "قُصُور القَلْب, فَشَل القَلْب",
 "しんぞうマッサージ": "تدليك القلب (إجراء طارئ يستخدم الضغط الإيقاعي للقلب (إما من خلال جدار الصدر أو مباشرة على القلب أثناء الجراحة) في محاولة للحفاظ على الدورة الدموية أثناء السكتة…)",
 "しんぞく": "نِسْبِيّ / قَرِيب, قَرِيبَة",
 "しんぞくかんけい": "قَرَابَة",
 "しんたい": "حَرَكَة / مسار عمل, نهج (طريقة للعمل أو التصرف)\nمثال: إذا استمررت في هذا المسار فستفشل بالتأكيد / جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "しんたいけい": "عُقُوبَةٌ بَدَنِيَّة",
 "しんたいけんさ": "فَحْص طِبِّيّ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض)\nمثال: فحص الطبيب بطني. / تفتيش جسدي (فعل تفتيش شخص ما بحثاً عن أسلحة مخفية أو مخدرات غير قانونية)\nمثال: أجرى للمشتبه به تفتيشاً سريعاً",
 "しんたいげんご": "لُغَةُ الْجَسَدِ (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "しんたいしょうがい": "تَكَافُؤ الفُرَص, مِيزَة تَعْوِيضِيَّة (أفضلية تُمنح لمنافس لمساواة فرص الفوز) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم) / إعاقة, عجز (حالة عدم القدرة على الأداء نتيجة لعدم اللياقة البدنية أو العقلية)\nمثال: إعاقة القراءة",
 "しんたいじょう": "مَادِّيّ, مَلْمُوس",
 "しんたいせい": "تَجَسَّد",
 "しんたいてき": "مَادِّيّ, مَلْمُوس",
 "しんたいのうりょく": "قدرة بدنية (القدرة على أداء فعل بدني ما)",
 "しんたいりく": "الْعَالَم الْجَدِيد",
 "しんたく": "ثِقَة / تْرَسْت, اِئْتِمَان / وَثِقَ (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء. / كَاهِن, عَرَّاف / إِلْهَام",
 "しんたくがいしゃ": "شركة أمينة, شركة ائتمان (منظمة (عادة مع بنك تجاري) تعمل كوصي أو وكيل ائتماني في التعامل مع صناديق الائتمان أو التركات أو ترتيبات الحفظ أو تحويلات الأسهم أو الخدمات ذات الصلة)",
 "しんたくききん": "صندوق ائتمان (صندوق يُحفظ في أمانة)",
 "しんたくしきん": "صندوق ائتمان (صندوق يُحفظ في أمانة)",
 "しんたくしょうしょ": "سند الوصاية, صك الائتمان (صك مكتوب ينقل الملكية قانوناً إلى وصي يستخدم غالباً لتأمين التزام مثل الرهن العقاري أو السند الإذني)",
 "しんたくとうち": "أمانة, وصاية (منصب الوصي أو عضو مجلس الأمناء) / إقليم خاضع للوصاية (بلد تابع؛ يُدار بواسطة بلد آخر تحت إشراف الأمم المتحدة)",
 "しんたくとうちりじかい": "مجلس الوصاية (مجلس دائم للأمم المتحدة يكلف دولة (أو دول) بتولي إدارة إقليم ما)",
 "しんたつ": "إِشْعَار, إِخْطَار / تَنْبِيه, إِشْعَار / إعادة توجيه, تحويل (فعل الإرسال إلى وجهة أخرى) / ترويج, تعزيز (النهوض بمشروع ما)\nمثال: تتم إعادة توجيه البريد إلى العنوان الجديد تلقائياً / يقرب",
 "しんたん": "وَقُود / هَاوِيَة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة) / هَاوِيَة, هُوَّة (مؤنث هاوٍ، الساقطة أو الواقعة؛ مؤنث هَاوٍ، المحبّة)\nمثال: وصل سامي إلى قاع الهاوية ماليا. / قَلْب, فُؤَاد / قَلْب / كُبَّا / الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم.",
 "しんだい": "حَرَكَة / مسار عمل, نهج (طريقة للعمل أو التصرف)\nمثال: إذا استمررت في هذا المسار فستفشل بالتأكيد / قَاع, حَوْض (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / مَشَارَة, حَوْض\nمثال: نمت في قاعة السينما. / ثَرْوَة / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ)) / تشينغ, سلالة تشينغ (آخر سلالة إمبراطورية للصين (من 1644 إلى 1912) والتي أطاح بها الثوار؛ خلال سلالة تشينغ حكم المانشو الصين)",
 "しんだいけん": "تَذْكِرَة / تذكرة",
 "しんだいしゃ": "عربة نوم (عربة ركاب تحتوي على أسرّة للنوم)",
 "しんだいむし": "بَقّ ((بَقَّ) الرجل بقا: أَكثر القَوْل فِي صَوَاب أَو خطأ؛ (بَقَّ) الْمَرْأَة: كثر وَلَدهَا)\nمثال: قد غزا بق الفراش فرنسا.",
 "しんだし": "سحب الكرة, سناب ((كرة القدم الأمريكية) وضع الكرة في اللعب عن طريق تمريرها (بين الساقين) إلى الخلف) / بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما)\nمثال: أسقط لاعب الوسط الكرة عند السحب",
 "しんだつ": "غَصْب",
 "しんだん": "تَشْخِيص / الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم. / مَذْبَح, هَيْكَل",
 "しんだんい": "أخصائي علم الأمراض, مُشخِّص (طبيب متخصص في التشخيص الطبي)",
 "しんだんがく": "علم التشخيص, علم تصنيف الأمراض (فرع العلوم الطبية المعني بتصنيف الأمراض)",
 "しんだんけんさ": "اختبار تشخيصي, فحص تشخيصي (فحص يتم لأغراض التشخيص)",
 "しんだんし": "مُسْتَشَار, مُسْتَشَارَة (المُسْتشار : مَنْ تطلب مشورته || رتبة في القضاء : « مُسْتشار في محكمة الاستئناف »)",
 "しんだんプログラム": "برنامج تشخيص (برنامج يتعرف على الأعطال في المعدات أو الأخطاء في برنامج حاسوبي ويشرحها)",
 "しんち": "حي البغاء, منطقة الضوء الأحمر (حي يكثر فيه وجود بيوت الدعارة)",
 "しんちがく": "الحكمة الإلهية, ثيوصوفيا (نظام عقائدي يقوم على البصيرة الصوفية في طبيعة الله والروح)",
 "しんちくいわい": "حفل تدشين المنزل, حفل نزالة (حفلة يجتمع فيها الناس للاحتفال بالانتقال إلى منزل جديد)",
 "しんちしき": "حتى الآن, عصري (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "しんちゅう": "شَبَه / صُفْر (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / صُفَّر (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية)\nمثال: بدأ سامي من نقطة الصفر. / وَظِيفَة, مِهْنَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِحْتِلال, إِشْغَال (احتلّ: نزل؛ احتلّ به واحتلّه: نزل به، واحتلّ الشيء: اتّخذه حلالاً)\nمثال: ما وظيفة زوجتك؟ / عَقْل (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "しんちゅうおだやかでない": "مُتَوَتِّر جَسَدِيّاً (متعلق بقلق جسدي يسبب عدم الارتياح) / غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غير مرتاح, قلق (يفتقر إلى الشعور بالأمان أو لا يوفر راحة أو طمأنينة) / غير مريح, قلق (يفتقر أو لا يوفر راحة جسدية أو عقلية)\nمثال: كان المزارعون قلقين حتى نزل المطر أخيراً",
 "しんちょ": "عَاطِفَة, عَوَاطِف",
 "しんちょう": "حَذِر (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: قد بحذر من فضلك. / ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود) / مستلزمات, مقومات ((عادة بصيغة الجمع) المكونات اللازمة لصنع أو فعل شيء ما) / كَفَاءَة, مُؤَهِّل (سمة يجب الوفاء بها أو الامتثال لها وتجعل الشخص مناسباً لشيء ما)\nمثال: ابتكار الخطط / اِرْتِفَاع\nمثال: 息子はもう私と同じ身長だ。 — إبني بنفس طولي حالياً. / تَمَدُّد / تَوَسُّع / تشينغ, سلالة تشينغ (آخر سلالة إمبراطورية للصين (من 1644 إلى 1912) والتي أطاح بها الثوار؛ خلال سلالة تشينغ حكم المانشو الصين) / سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ) / عَمِيقٌ مِنَ الأَعْمَاق (نَابِعٌ مِنْ أَعْمَاقِ النَّفْس) / بَالِغُ العُمْق, عَمِيقٌ جِدًّا (مِنْ أَشَدِّ دَرَجَاتِ الحِدَّةِ؛ تَامّ)",
 "しんちょうぎんみ": "تَدْقِيق",
 "しんちょく": "تَقَدُّم / كَاهِن, عَرَّاف / إِلْهَام / غيرية جنسية (انجذاب جنسي (أو علاقات جنسية) لأشخاص من الجنس الآخر) / استقامة, حسن نية (امتلاك نوايا صادقة) / استقامة, مباشرة (صحة المسار نحو الهدف) / استقامة (الخلو من الانحناءات أو المنعطفات أو الزوايا)\nمثال: تصرف بحسن نية",
 "しんちょくほうこく": "تقرير سير العمل, تقرير مرحلي (تقرير عن العمل المنجز خلال فترة زمنية محددة)",
 "しんちん": "هَادِئ / طَمْأَنَ / بدون كلام, بصمت (بدون التحدث)\nمثال: جلس بصمت بجوارها",
 "しんちんたいしゃ": "تَجْدِيد / أَيْض ( تَحَوُّل غذائيّ في الخلايا، أو قوّة التجدُّد والبناء والهدم في الكائن الحيّ) / تَمْثِيل غِذَائِيّ / اِسْتِقْلَاب (يُشير مُعجم مُفردات كلمة \"قلَب\" إلى معانٍ متعددة تدور حول فكرة التغيير و التحويل، سواءً كان ذلك بتغيير مكان شيء ما (كإفراغ قدر أو عكس شيء)…؛ يُشير الفعل \"قلب\" إلى معانٍ تتراوح بين الحركة المادية لعكس اتجاه أو وضع شيء ما (كقلب كأس أو صفحة)…)",
 "しんつう": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "しんてい": "إِرَاءَة / إِهْدَاء, مَنْح / جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "しんていし": "سَكْتَة قَلْبِيَّة",
 "しんてき": "عَقْلِيّ / إِلٰهِيّ / رَجُلُ دِينٍ, رِجالُ دِينٍ (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "しんてきがいしょう": "صدمة, صدمة نفسية (جرح أو صدمة عاطفية غالباً ما يكون لها آثار طويلة الأمد)",
 "しんてきがいしょうごストレスしょうがい": "اِضْطِرَاب الْكَرْب التَّالِيّ لِلصَّدْمَة النَّفْسِيَّة",
 "しんてきひょうじ": "تصور داخلي, تمثيل (عرض للأمور في العقل على شكل فكرة أو صورة)",
 "しんてっこう": "غوثيت (معدن أحمر أو أصفر أو بني؛ أكسيد الحديد ومكون شائع للصدأ)",
 "しんてん": "تَمَدُّد / تَوَسُّع / سَرِّيّ, خُصُوصِيّ / تَقَدُّم",
 "しんてんおう": "قَطْرَس (طائر بحري كبير)",
 "しんてんち": "الْعَالَم الْجَدِيد",
 "しんでも": "بِأَيِّ ثَمَنٍ",
 "しんでん": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع\nمثال: この神殿は建てるのに４６年かかりました。 — في ست وأربعين سنة بني هذا الهيكل. / عَصْرِيّ, حَدِيث",
 "しんでんけい": "جهاز تخطيط القلب, مخطط القلب (أداة طبية تسجل التيارات الكهربائية المرتبطة بانقباضات القلب)",
 "しんでんず": "مُخَطَط كَهْرَبِيَّة اَلْقَلْب, إِلِكْتْرُوكَارْدِيُوغْرَام",
 "しんと": "شخص عادي, علماني (رجل ليس رجل دين أو شخصاً محترفاً) / صَامِت, سَاكِت",
 "しんといて": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "しんとう": "صَدْمَة / صَعْقَة / صَعَقَ / تداخل, تغلغل متبادل (اختراق متبادل؛ انتشار كل طرف خلال الآخر) / تشرب, تغلغل (عملية تغلغل مادة في شيء ما أو تشبعه بها) / خَاصِّيَّة أُسْمُوزِيَّة, تَنَاضُح / شِنْتَوِيَّة, شِنْتُو / قَلْب, فُؤَاد / قَلْب / كُبَّا",
 "しんとうあつ": "ضغط أسموزي, ضغط تناضحي ((في الكيمياء الفيزيائية) الضغط الذي يمارسه محلول واللازم لمنع التناضح إلى ذلك المحلول عندما يتم فصله عن المذيب النقي بواسطة غشاء شبه منفذ)",
 "しんとうか": "شنتوي (متعلق بالشنتوية أو مميز لها) / شِنْتُوِيّ (مؤمن بالشنتوية)\nمثال: معابد شنتوية",
 "しんとうき": "أصل الآلهة, ثيوغونيا (دراسة أصول وأنساب الآلهة)",
 "しんとうしんじゃ": "شنتوي (متعلق بالشنتوية أو مميز لها) / شِنْتُوِيّ (مؤمن بالشنتوية)\nمثال: معابد شنتوية",
 "しんとうじょう": "إطلاق, تدشين (فعل البدء بشيء جديد) / ظهور أول (تقديم فتاة للمجتمع لأول مرة)\nمثال: تطلعوا إلى الظهور الأول لخط إنتاجهم الجديد",
 "しんとうせい": "خَاصِّيَّة أُسْمُوزِيَّة, تَنَاضُح",
 "しんとうたんしょうけんさ": "بِي, پِي / ط, بَاي (الحرف السادس عشر في الترتيب الهجائي العربي والتاسع في ترتيب الأبجدية العربية؛ يسبقه \"ض\" ويتبعه \"ظ\"؛ عدد غير نسبي يمثل محيط الدائرة إلى قُطْرِهَا)",
 "しんとき": "لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "しんど": "مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته / عَمْق / تَقَدُّم / تربة تحتية, طبقة تحت التربة (طبقة التربة بين التربة السطحية والصخر الأساس)",
 "しんどい": "مُتْعَب, تَعْبَان / مُضْجِر, مُمِلّ (يفتقر إلى الإثارة لدرجة تسبب السأم الذهني)",
 "しんどう": "تَذَبْذُب / طفل عبقري (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان منذ أن تلده أمه حتى يَبْلُغ)\nمثال: هو طفل العائلة. / شِنْتَوِيَّة, شِنْتُو / صَدْمَة / صَعْقَة / صَعَقَ",
 "しんどうし": "مذبذب (مولد ينتج ذبذبات صوتية أو تياراً متردداً)",
 "しんどうすう": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "しんどうばん": "حِجَاب حَاجِز (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب. / مرتجف (من يرتجف ويهتز خوفاً)",
 "しんどく": "الْهِنْد, الهند (في جنوب قارة آسيا؛ اسمها الرسمي جمهورية الهند، وعاصمتها نيودلهي)\nمثال: يبدو أنك من الهند.",
 "しんないまく": "شُغاف",
 "しんないまくえん": "التهاب الشغاف (التهاب الشغاف وصمامات القلب)",
 "しんなり": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "しんに": "غَضَب / أَغْضَبَ / غَضِبَ / بصدق, حقاً (وفقاً للحقيقة أو الواقع) / بصدق, حقاً (في الواقع (تستخدم للتوكيد أو تعديل الجملة)) / بِجَدَارَة, بِحَقّ (بموجب الحق أو الشرعية) / بإخلاص, بصدق (بصدق؛ دون تصنع)\nمثال: أصبحت الآن أمريكية حقاً",
 "しんにゅう": "غَزْو, إِغَارَة (أَغَارَ عَلَى العَدُوِّ غَزْواً : سَارَ إِلَى مُحَارَبَتِهِ وَقِتَالِهِ فِي عُقْرِ دِيَارِهِ؛ سيطرة على دولة أو منطقة بواسطة قوّات مُسلَّحة أجنبيّة)\nمثال: الصين مستعدة لغزو تايوان. / قادم جديد, مستجد (أي مشارك جديد في نشاط ما) / وافد جديد (شخص وصل حديثًا)\nمثال: هو وافد جديد إلى بوسطن / إِدْخَال / وُلُوج, نَفَاذ / مَدْخَل, دُخُول / مَدْخَل, مُدْخَل / دَفْتَر, مَدْخَل / تداخل, تغلغل متبادل (اختراق متبادل؛ انتشار كل طرف خلال الآخر) / تشرب, تغلغل (عملية تغلغل مادة في شيء ما أو تشبعه بها) / تسلل (عملية يخترق فيها أفراد (أو مجموعات صغيرة) منطقة (خاصة الاختراق العسكري لمواقع العدو دون كشفهم)) / تخلل, ترشيح (المرور البطيء لسائل عبر وسط ترشيح)\nمثال: تخلل مياه الأمطار عبر التربة",
 "しんにゅうきんし": "مَمْنُوع الدُّخُولُ",
 "しんにゅうしゃ": "مُقْتَحِم, دَخِيل",
 "しんにゅうしゅ": "نَوْعٌ مُجْتَاحٍ (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر.",
 "しんにゅうせい": "فِي السَّنَةِ الأُولَى, مُسْتَجِدّ (يُوصَفُ بِهِ الشَّخْصُ فِي سَنَتِهِ الأُولَى مِنْ تَجْرِبَةٍ (خَاصَّةً فِي المَدْرَسَةِ أَوِ الجَامِعَةِ)) / طالب سنة أولى (طالب جامعي في السنة الأولى) / قادم جديد, مستجد (أي مشارك جديد في نشاط ما)",
 "しんにゅうせいぶつ": "نَوْعٌ مُجْتَاحٍ (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر.",
 "しんにゅうろ": "طريق فرعي, مدخل طريق (طريق قصير يتيح الوصول إلى طريق سريع) / مسار الاقتراب, مسار الانزلاق (المسار النهائي الذي تتبعه الطائرة أثناء هبوطها)",
 "しんにゅうをかける": "بَالَغَ",
 "しんにょ": "مُؤْمِن, مُؤْمِنَة (هو الشخص الذي يُؤْمِنُ بالشيء ويصدقه؛ من دخل في قلبه الإِيْمَان، وهو يطلق على من يدخل الإسلام)\nمثال: المؤمن لا يلدغ مرتين من جحر واحد. / إِلَاهَة, إِلٰهَة / مَعْبُودَة",
 "しんにん": "ثِقَة / تْرَسْت, اِئْتِمَان / وَثِقَ (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء. / شَكَرَ ((شَكِرَت) الشَّجرة تَشْكَرُ شَكَرًا: خرج منها الشَّكِيرُ؛ (شَكِرَت) الضَّرْعُ: امتلأ باللبن)\nمثال: شكر ياني أسرته. / تدشين, تنصيب (التنصيب الاحتفالي في منصب ما) / اسْتِهْلَالِيّ, تَدْشِينِيّ (يَهْدِفُ إِلَى تَحْرِيكِ الأُمُورِ أَوْ إِطْلَاقِهَا) / افتتاحي, تدشيني (يحدث عند أو يميز تنصيباً رسمياً أو تقليد منصب) / خطاب التنصيب (خطاب يلقى في مراسم التنصيب (خاصة من قبل رئيس الولايات المتحدة))\nمثال: استمتع الرئيس الجديد بوضوح بحفل تنصيبه",
 "しんにんじょう": "اعتماد, شهادة (وثيقة تشهد بصحة وقائع معينة مذكورة)",
 "しんにんとうひょう": "تصويت بالثقة, منح الثقة (تعبير عن الموافقة والتشجيع)\nمثال: أعطوا الرئيس تصويتاً بالثقة",
 "しんにんひょう": "تصويت بالثقة, منح الثقة (تعبير عن الموافقة والتشجيع)\nمثال: أعطوا الرئيس تصويتاً بالثقة",
 "しんぬきき": "أداة إزالة اللب, مقوّر (أداة لإزالة اللب من التفاح)",
 "しんね": "غَضَب / أَغْضَبَ / غَضِبَ",
 "しんねり": "بِإِصْرَار (مع الإصرار) / بإصرار, بشكل متواصل (بطريقة مستمرة ومصرة)\nمثال: كان يطرح أسئلة، أسئلة لا مفر منها، بإصرار / بِبُطْء",
 "しんねん": "اِعْتِقَاد / عَقِيدَة (المُعَاقِدَة، بمعنى اسم الفاعل؛ المعقودة، بمعنى اسم المفعول) / إيمان / السَّنَة الْجَدِيدَة",
 "しんねんあけましておめでとうございます": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "しんねんおめでとう": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "しんねんおめでとうございます": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "しんの": "حَقٌّ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له)\nمثال: الأستاذ على حق.",
 "しんのう": "تَأْمُور",
 "しんのぞう": "قَلْب, فُؤَاد / قَلْب / كُبَّا",
 "しんはくしゅつりょう": "النِّتَاج القَلْبِيّ (كمية الدم التي يضخها البطينان في فترة زمنية معينة)\nمثال: يبلغ النتاج القلبي للبالغ في حالة الراحة حوالي ثلاثة لترات في الدقيقة",
 "しんはつばい": "أَطْلَقَ, قَذَفَ",
 "しんば": "حصان بديل (حصان جديد خاصة (سابقاً) ليحل محل حصان قُتل أو أصيب في المعركة)",
 "しんばりぼう": "حَانَة, بَار",
 "しんばり棒": "حَانَة, بَار",
 "しんばん": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين / تحكيم (فعل التحكيم (في الرياضة))\nمثال: كان التحكيم ممتازاً / حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "しんばんいん": "حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "しんぱい": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / اِهْتِمَام / عِنَايَة, رِعَايَة / اِهْتَمَّ بِـ / جهاز القلب والرئة (مضخة للحفاظ على الدورة الدموية أثناء جراحة القلب؛ تحول الدم من القلب وتؤكسده ثم تضخه عبر الجسم)",
 "しんぱいごと": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "しんぱいそせいほう": "إنعاش قلبي رئوي (إجراء طوارئ يتكون من تدليك القلب الخارجي والتنفس الاصطناعي)",
 "しんぱいていし": "توقف الانقباض, توقف قلبي رئوي (غياب الانقباض القلبي؛ فشل بطينات القلب في الانقباض (عادة بسبب الرجفان البطيني) مما يؤدي إلى غياب ضربات القلب وبالتالي نقص الأكسجين والموت في النهاية)",
 "しんぱく": "نَبْض, نَبْضُ القَلْب",
 "しんぱくきろく": "تخطيط القلب, تخطيط كهربائية القلب (إجراء تشخيصي يتمثل في تسجيل نشاط القلب إلكترونياً باستخدام جهاز تخطيط القلب)",
 "しんぱくすう": "مُعَدَّل النَّبْض, مُعَدَّل ضَرَبَات القَلْب (المعدل الذي ينبض به القلب؛ يقاس عادة للحصول على تقييم سريع لصحة الشخص)",
 "しんぱつ": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "しんぱん": "اِنْتِهَاك / تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين / تحكيم (فعل التحكيم (في الرياضة))\nمثال: كان التحكيم ممتازاً / حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / طبعة جديدة (منشور (مثل كتاب) تم تعديله أو تحديثه وعرضه للبيع مرة أخرى) / محاكمة بالتعذيب, محنة (طريقة بدائية لتحديد ذنب أو براءة الشخص عن طريق تعريض المتهم لاختبارات خطيرة أو مؤلمة يعتقد أنها تحت السيطرة الإلهية؛ كان الهروب عادة علامة على البراءة)",
 "しんぱんいん": "حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "しんぱんしゃ": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "しんぱんのひ": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "しんぱんやく": "حكم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "しんひしつ": "قشرة حديثة (الجزء القشري من الدماغ الحديث)",
 "しんびがく": "عِلْم الْجَمَال, فَلْسَفَةُ الْجَمَال (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "しんびしか": "طب الأسنان التجميلي (فرع طب الأسنان الذي يتعامل مع مظهر الأسنان)",
 "しんびてき": "جَمَالِيّ, فَنِّيّ (يتعلق بـ أو يتميز بتقدير الجمال أو الذوق الرفيع) / جَمَالِيّ, فَنِّيّ (مُمْتِعٌ مِنَ النَّاحِيَةِ الجَمَالِيَّة) / استيطيقي, جمالي (يتعلق بموضوع علم الجمال (الاستيطيقا)) / جمالية ((فلسفة) نظرية فلسفية حول ماهية الجميل)\nمثال: الملكات الجمالية",
 "しんびょう": "خَنُوع, مُسْتَكِين (يُظْهِر قِلَّة فِي الشَّجَاعَة؛ مُفْرِط فِي الِامْتِثَال) / خَجُول, وَدِيع (متواضع في الروح أو السلوك؛ يُوحي بلطف منسحب أو خضوع مهيب) / خَنُوع, وَدِيع (بالغ الطاعة والانقياد) / غَامِض",
 "しんぴ": "سِرّ (شَعَرَ بِالسُّرُورِ) / غُمُوض\nمثال: السر سيبقى سرا. / كربلة (مدقة بسيطة أو عنصر واحد من مدقة مركبة) / أَدَمة",
 "しんぴがく": "تنجيم, علوم خفية (اعتقاد بوجود قوى خارقة للطبيعة وإمكانية إخضاعها للسيطرة البشرية) / التنجيم, العلوم الخفية (دراسة ما وراء الطبيعة أو القوى الخارقة)",
 "しんぴげき": "مسرحية الأسرار (مسرحية من القرون الوسطى تمثل حلقات من حياة المسيح)",
 "しんぴしゅぎ": "تصوف, غموضية (فكر غامض أو غير عقلاني) / تصوف, عرفان (دين يقوم على الاتحاد الروحي الغامض مع حقيقة مطلقة)",
 "しんぴせい": "جَاذِبِيَّة غَامِضَة, سِحْر غَامِض (هالة من القيمة العالية أو الاهتمام أو المعنى تحيط بشخص أو شيء)",
 "しんぴつ": "تَوْقِيع, أُوتُوجْرَاف (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم. / خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "しんぴてき": "غَامِض",
 "しんぴてきふんいき": "جَاذِبِيَّة غَامِضَة, سِحْر غَامِض (هالة من القيمة العالية أو الاهتمام أو المعنى تحيط بشخص أو شيء)",
 "しんぴょう": "ثِقَة / تْرَسْت, اِئْتِمَان / وَثِقَ (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء.",
 "しんぴょうせい": "أَصَالَة, شَرْعِيَّة (مصداقية غير متنازع عليها)",
 "しんぴん": "جَدِيد تَمَامًا, لَامِع (جديد بشكل لافت للنظر) / تُحْفَة, رَائِعَة",
 "しんふぜん": "قُصُور القَلْب, فَشَل القَلْب",
 "しんぶ": "أعماق, أغوار ((الجمع) الجزء الأعمق والأكثر بعداً)\nمثال: من أعماق أفريقيا المظلمة / أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "しんぶん": "جَرِيدَة / صَحِيفَة",
 "しんぶんうり": "بائع صحف (صبي يوزع الصحف)",
 "しんぶんがみ": "ورق جرائد (ورق رخيص مصنوع من لب الخشب ويستخدم لطباعة الصحف)\nمثال: استخدموا رزمًا من ورق الجرائد كل يوم",
 "しんぶんこうこく": "إِعْلَان صُحُفِيّ (إعلان مطبوع ينشر في صحيفة)",
 "しんぶんし": "ورق جرائد (ورق رخيص مصنوع من لب الخشب ويستخدم لطباعة الصحف)\nمثال: استخدموا رزمًا من ورق الجرائد كل يوم / جَرِيدَة / صَحِيفَة",
 "しんぶんしじょう": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة.",
 "しんぶんすう": "كَسْر حَقِيقِيّ (كسر يكون بسطه أصغر من مقامه)",
 "しんぶんはいたつ": "نَاقِل / مَوْجَة حامِلة / حَامِل, حَمَلَة (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة)\nمثال: يبدو أنني حامل.",
 "しんぶんはっぴょう": "بَيَان صَحَفِيّ (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل)\nمثال: وأوضح البيان ذاته، أن الوزارة وجهت تعليمات من أجل تسخير كافة الإمكانيات البشرية والمادية للتسريع من وتيرة سير العملية.",
 "しんぶんばいてん": "كُشْك صُحُف (هو الكِشْك في بعض اللهجات العربية؛ شبه رِوَاق بارز عن مساواة بقية البيت)",
 "しんぷ": "عَرُوس / رئيس دير (رئيس دير فرنسي) / تَمِيمَة, أُخْذَة / أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "しんぷく": "سعة, مدى (عِظَم المقدار) / جود, سعة (خاصية الوفرة الغزيرة) / سعة ((في الفيزياء) أقصى إزاحة لموجة دورية) / عبودية الأرض, قنانة (حالة القن (عبد الأرض))",
 "しんぷくへんちょう": "تضمين السعة (تضمين سعة الموجة الحاملة (للراديو))",
 "しんべい": "موال لأمريكا (يدعم الولايات المتحدة وسياساتها)",
 "しんべん": "شَفَة, شفة / حنك رخو (سديلة عضلية تغلق البلعوم الأنفي أثناء البلع أو الكلام) / حجاب (غطاء غشائي متصل بالجسم الثمري غير الناضج لبعض الفطريات)",
 "しんぺい": "مُجَنَّد",
 "しんぺん": "مُعْجِزَة, أُعْجُوبَة / طبعة جديدة (منشور (مثل كتاب) تم تعديله أو تحديثه وعرضه للبيع مرة أخرى)",
 "しんほしゅしゅぎ": "محافظة جديدة (نهج في السياسة أو اللاهوت يمثل عودة إلى وجهة نظر تقليدية (على عكس المدارس الفكرية الأكثر ليبرالية أو راديكالية في الستينيات))",
 "しんぼう": "ثِقَة / قصبة الريشة (العمود الفقري المجوف للريشة) / عمود دوار, عمود نقل الحركة (قضيب دوار ينقل الطاقة أو الحركة) / سارية, عمود (قضيب أو عمود طويل (خاصة مقبض أداة أو جسم سلاح مثل الرمح أو السهم)) / بئر, عمود (ممر رأسي طويل محفور في الأرض، كما لمنجم أو نفق) / عمود دوران, مغزل (أي من الأعمدة الدوارة المختلفة التي تعمل كمحاور لأجزاء دوارة أكبر) / صَبْر, تَحَمُّل ((صَبَرَ) يَصْبِرُ صَبْرًا: تجلَّد ولم يَجْزَع؛ (صَبَرَ): انتظر في هدوء واطمئنان)\nمثال: الصبر أم العلوم. / اِئْتَمَرَ / أُذَيْن",
 "しんぼうさいどう": "رَجَفَان أُذَيْنِيّ",
 "しんぼうちゅうかくけっそん": "عيب الحاجز الأذيني (فتحة غير طبيعية بين الأذينين الأيسر والأيمن للقلب)",
 "しんぼうづよい": "صَبُور (الكثير الصبر أو الذي يصبر طويلا، من كانت صفته الصبر؛ الصَبُوْر: اسم من الأسماء الحسنى) / مَرِيض, مَرِيضَة (من به مَرَض، أي السَقِيْم المَعْلُوْل. يقال لما يصاب به الجَسَد والنَفَس والرُوْح أو أحدهم) / مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به)\nمثال: أظن أنها مريضة.",
 "しんぼく": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "しんぼち": "حديث العهد بالإيمان, موعوظ (معتنق جديد يتم تعليمه مبادئ المسيحية) / قادم جديد, مستجد (أي مشارك جديد في نشاط ما) / نبات دخيل حديث, نبات وافد (نبات موجود في منطقة لم يتم تسجيله فيها سابقاً)",
 "しんぼっち": "حديث العهد بالإيمان, موعوظ (معتنق جديد يتم تعليمه مبادئ المسيحية) / قادم جديد, مستجد (أي مشارك جديد في نشاط ما) / نبات دخيل حديث, نبات وافد (نبات موجود في منطقة لم يتم تسجيله فيها سابقاً)",
 "しんぽ": "تَقَدُّم",
 "しんぽう": "اِعْتِقَاد / عَقِيدَة (المُعَاقِدَة، بمعنى اسم الفاعل؛ المعقودة، بمعنى اسم المفعول) / إيمان\nمثال: 開拓民たちはキリスト教を信奉した。 — أعتنق المستوطنون الديانة المسيحيّىة. / أَخْبَار, أَنْبَاء (أنباء ما قد حدث؛ نشرة الأخبار أو عرض الأخبار: ما يعرضه التلفاز أو الراديو من أخبار سياسة واقتصادية ورياضية تهم عامة الناس)\nمثال: هذه أخبار طيبة.",
 "しんぽうしゃ": "لَاصِق, مُلْتَصِق (ملتصق بإحكام) / تابِع, تِلْمِيذ (شخص يؤمن بمذهب شخص آخر ويساعد في نشره)",
 "しんぽしゅぎ": "تقدمية (التوجه السياسي لمن يفضلون التقدم نحو ظروف أفضل في الحكومة والمجتمع)",
 "しんぽせい": "اِخْتِرَاع",
 "しんぽてき": "تَقَدُّمِيّ, مُتَرَقٍّ",
 "しんぽとう": "الحزب التقدمي, حزب بول موس (حزب سياسي سابق في الولايات المتحدة؛ أسسه ثيودور روزفلت خلال الحملة الرئاسية لعام 1912؛ كان شعاره صورة لحيوان الموظ)",
 "しんまい": "مبتدئ, مستجد (شخص جديد في مجال أو نشاط ما) / مبتدئ (شخص دخل في رهبنة دينية لكنه لم يأخذ النذور النهائية بعد)",
 "しんまく": "تَأْمُور",
 "しんまくえん": "اِلْتِهَاب التَّأْمُور",
 "しんまくこう": "تجويف التامور (الحيز بين طبقات التامور الذي يحتوي على سائل يزيت أسطح الغشاء ويسمح بحركة القلب بسهولة)",
 "しんみ": "حلي رخيصة, حلية مبهرجة (مجوهرات رخيصة ومبهرجة أو زينة على الملابس) / تحفة صغيرة, حلية (صنف صغير غير مكلف يتم إنتاجه بكميات كبيرة) / جِدَّة, طَرَافَة (الأصالة بحكم كون الشيء جديداً ومنعشاً) / جدة, حداثة (الأصالة بحكم كونها جديدة ومفاجئة) / عَلَاقَة / نوع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / حَنُون, لَطِيف\nمثال: انه نوع من الفطر.",
 "しんみつ": "أُلْفَة",
 "しんみつか": "تضليل, تعمية (نشاط حجب فهم الناس وتركهم في حيرة أو ارتباك) / أحجية, شيء مُحيّر (شيء مصمم لإثارة الحيرة أو الإرباك) / ارتباك, حيرة (ارتباك ناتج عن الفشل في الفهم)",
 "しんみつかん": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "しんみになって": "بحرارة, بقلب خالص (بطريقة قلبية) / بشكل ثقيل (للملابس), بشكل دافئ (بطريقة دافئة (غالباً للملابس))\nمثال: رحبنا بها بحرارة",
 "しんみょう": "خَنُوع, مُسْتَكِين (يُظْهِر قِلَّة فِي الشَّجَاعَة؛ مُفْرِط فِي الِامْتِثَال) / خَجُول, وَدِيع (متواضع في الروح أو السلوك؛ يُوحي بلطف منسحب أو خضوع مهيب) / خَنُوع, وَدِيع (بالغ الطاعة والانقياد) / غَامِض",
 "しんみり": "بِهُدُوء / برصانة, بمهابة (بطريقة جادة ورصينة)\nمثال: جلس القاضي هناك بمهابة",
 "しんみん": "فَاعِل, مُبْتَدَأ (الشيء :فعله) / مَوْضُوع / دَوْرَة, مَادَّة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه) / رَعِيَّة\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "しんめ": "نَبْتَة",
 "しんめい": "إِلٰه, مَعْبُود (كل ما اتُّخِذَ معبودًا)\nمثال: يؤمن فاضل بإله الإسلام. / أَمَاتِيرَاسُو",
 "しんめいき": "سِفْر التَثْنِيَة, سِفْر تَثْنِيَةِ الاِشْتِرَاع (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد)\nمثال: صاحبته في السفر.",
 "しんめいさいばん": "محاكمة بالتعذيب, محنة (طريقة بدائية لتحديد ذنب أو براءة الشخص عن طريق تعريض المتهم لاختبارات خطيرة أو مؤلمة يعتقد أنها تحت السيطرة الإلهية؛ كان الهروب عادة علامة على البراءة)",
 "しんめんぼく": "جِدِّيّ / جَدِّيّ, جَادّ / مظهر جديد, نيو لوك (نمط من الملابس النسائية ابتكره كريستيان ديور عام 1947؛ تضمن صدراً ضيقاً وخصراً نحيفاً وتنورة واسعة ذات طيات)",
 "しんめんもく": "جِدِّيّ / جَدِّيّ, جَادّ / مظهر جديد, نيو لوك (نمط من الملابس النسائية ابتكره كريستيان ديور عام 1947؛ تضمن صدراً ضيقاً وخصراً نحيفاً وتنورة واسعة ذات طيات)",
 "しんもつ": "هَدِيَّة, هدية / قَرِيحَة / أَهْدَى",
 "しんもつどころ": "مَطْبَخ (المكان الذي يُطْبَخُ فيه، غُرْفَة أو مساحة في البناء مخصصة للطبخ؛ في : هو المَطْعَم)\nمثال: سامي في المطبخ.",
 "しんもん": "مُحَاكَمَة (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري.",
 "しんもんかん": "مُحَقِّق, مُحَقِّقَة (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ الَّذِي يُحَقِّقُ مَعَ الْمُتَّهَمِ فِي قَضِيَّةٍ لِلْكَشْفِ عَنْ مَجْرَيَاتِهَا)\nمثال: تحدث ياني مع محقق.",
 "しんやく": "نَذْر / نَذَرَ / اَلْعَهْد اَلْجَدِيد",
 "しんやくせいしょ": "اَلْعَهْد اَلْجَدِيد",
 "しんやくぜんしょ": "اَلْعَهْد اَلْجَدِيد",
 "しんゆう": "رفيق, زميل (صديق مقرب يرافق رفاقه في أنشطتهم)",
 "しんゆせい": "أليف للزيت, أوليوفيلي (لديه ألفة قوية للزيوت بدلاً من الماء)",
 "しんよ": "حَمَّالَة, مِحَفَّة",
 "しんよう": "ثِقَة / اِئْتِمَان / إِبْرَة, مِخْيَط / شِنْيَانْغ, شِينْيَانْغ",
 "しんようかくづけ": "تصنيف ائتماني, جدارة ائتمانية (تقدير، بناءً على تعاملات سابقة، لقدرة شخص أو منظمة على الوفاء بالتزاماتهم المالية)",
 "しんようがり": "دين شرف (التزام، خاصة ديون المقامرة القائمة على وعد شفهي، لا يكون ملزماً قانونياً ولكنه يعتبر مضموناً بالنزاهة الأخلاقية للمدين)\nمثال: يجب أن أوفر له المال - إنه دين شرف",
 "しんようきき": "أزمة ائتمان, أزمة سيولة (حالة يوجد فيها نقص في النقد لإقراض الشركات والمستهلكين وتكون أسعار الفائدة مرتفعة)",
 "しんようきんこ": "اتحاد ائتماني, جمعية تعاونية للتسليف (مؤسسة مالية إيداعية تعاونية يمكن لأعضائها الحصول على قروض من مدخراتهم المشتركة)",
 "しんようくみあい": "اتحاد ائتماني, جمعية تعاونية للتسليف (مؤسسة مالية إيداعية تعاونية يمكن لأعضائها الحصول على قروض من مدخراتهم المشتركة)",
 "しんようさぎ": "احتيال, خديعة الثقة (عملية نصب تغش فيها في القمار أو تقنع شخصاً بشراء ممتلكات لا قيمة لها)",
 "しんようしゅうしゅく": "أزمة ائتمان, أزمة سيولة (حالة يوجد فيها نقص في النقد لإقراض الشركات والمستهلكين وتكون أسعار الفائدة مرتفعة)",
 "しんようじゅ": "شجرة مخروطية, صنوبريات (أي شجرة أو شجيرة عارية البذور تحمل مخاريط)",
 "しんようじょう": "خطاب اعتماد (وثيقة يصدرها بنك تضمن دفع حوالة العميل؛ تستبدل ائتمان البنك بائتمان العميل)",
 "しんようせい": "مِصْدَاقِيّة",
 "しんようリスク": "مَخَاطِر الاِئْتِمَان",
 "しんらい": "ثِقَة / تْرَسْت, اِئْتِمَان / وَثِقَ (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء. / جَدِيد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / حَدِيث (جَدِيد؛ الخبر عن ما حدث) / جديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل) / جَديد (مصنوع حديثا؛ لم يمر على حدوثه زمن طويل)\nمثال: هذا الكتاب جديد",
 "しんらいかん": "ثِقَة / تْرَسْت, اِئْتِمَان / وَثِقَ (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء.",
 "しんらいかんけい": "عَلَاقَة اِئْتِمَانِيَّة (العلاقة القانونية التي توجد عندما يعتمد شخص بشكل مبرر على شخص آخر يُطلب منه العون أو الحماية في أمر ما)",
 "しんらいしゃ": "قادم جديد, مستجد (أي مشارك جديد في نشاط ما) / وافد جديد (شخص وصل حديثًا)\nمثال: هو وافد جديد إلى بوسطن",
 "しんらいせい": "مِصْدَاقِيّة",
 "しんらいど": "اعتمادية, موثوقية (جودة كون الشخص أو الشيء جديراً بالاعتماد أو الثقة)",
 "しんらいにたる": "أَصِيل, مَوْثُوق (غير مُزيَّف أو منسوخ؛ حقيقي لا شك فيه) / صَحِيح, مَوْثُوق (مطابق للحقائق وبالتالي جدير بالتصديق)",
 "しんらいのおける": "مَوْثُوق",
 "しんらつ": "مُرّ (فَاتَ ومَضَى؛ الحدثُ أو الأمرُ: حدث وانتهى) / أَلِيم / مَقِيت, مَمْقُوت (مَقيت: ( اسم )؛ مُقِيت: ( اسم ))\nمثال: مر زيري بجانبي.",
 "しんり": "مُحَاكَمَة (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري. / حالة إدراكية, حالة معرفية (حالة العمليات المعرفية للشخص) / حالة ذهنية, مزاج (حالة نفسية مؤقتة) / حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "しんりがく": "سَيْكُولُوجْيَا, عِلْم النَّفْس",
 "しんりがくしゃ": "نَفْسَانِيّ, عَالِم النَّفْس",
 "しんりがくてき": "سَيْكُولُوجِيّ, نَفْسَانِيّ (عقليّ أو عاطفيّ بطبيعته لا جسديّ) / سيكولوجي, نفسي (متعلق علم النفس أو محدد به)\nمثال: نظريات نفسية",
 "しんりげんごがく": "لسانيات نفسية (فرع علم النفس المعرفي الذي يدرس الأساس النفسي للكفاءة والأداء اللغوي)",
 "しんりし": "معالج نفسي (معالج يتعامل مع الاضطرابات العقلية والعاطفية)",
 "しんりじょうたい": "حالة إدراكية, حالة معرفية (حالة العمليات المعرفية للشخص) / حالة ذهنية, مزاج (حالة نفسية مؤقتة)",
 "しんりせん": "حرب أعصاب, حرب نفسية (استخدام تكتيكات نفسية لتدمير معنويات الخصوم)",
 "しんりせんそう": "حرب أعصاب, حرب نفسية (استخدام تكتيكات نفسية لتدمير معنويات الخصوم)",
 "しんりそくていがく": "سيكومتريا, قياس نفسي (أي فرع من فروع علم النفس المعني بالقياسات النفسية)",
 "しんりつ": "اِخْتَلَجَ, اِرْتَجَفَ / رَجْفَة (المرّة الواحدة من الرَجْف؛ الزَلْزَلَة)",
 "しんりてき": "سَيْكُولُوجِيّ, نَفْسَانِيّ (عقليّ أو عاطفيّ بطبيعته لا جسديّ) / سيكولوجي, نفسي (متعلق علم النفس أو محدد به)\nمثال: نظريات نفسية",
 "しんりゃく": "غَزْو, إِغَارَة (أَغَارَ عَلَى العَدُوِّ غَزْواً : سَارَ إِلَى مُحَارَبَتِهِ وَقِتَالِهِ فِي عُقْرِ دِيَارِهِ؛ سيطرة على دولة أو منطقة بواسطة قوّات مُسلَّحة أجنبيّة)\nمثال: الصين مستعدة لغزو تايوان.",
 "しんりゃくしゃ": "غَازٍ, الْغَازِي",
 "しんりゃくしゅ": "نَوْعٌ مُجْتَاحٍ (صِنْف؛ في : وحدة تصنيفية أقل من الجنس)\nمثال: انه نوع من الفطر.",
 "しんりゃくてき": "عُدْوَانِيّ / هُجُومِيّ",
 "しんりょ": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / تفكير, روية (سمة التفكير بعناية قبل التصرف) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / تأمل, تفكر (تفكير هادئ ومطول ومركّز)\nمثال: لم يظهر أي مراعاة لمشاعرها / فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "しんりょう": "رعاية طبية, عناية طبية (علاج احترافي للمرض أو الإصابة)",
 "しんりょうかんごし": "ممرضة ممارسة (ممرضة مسجلة تلقت تدريباً خاصاً ويمكنها أداء العديد من واجبات الطبيب)",
 "しんりょうしょ": "عِيَادَة, مَصَحَّة",
 "しんりょうじょ": "عِيَادَة, مَصَحَّة",
 "しんりりゅうほ": "تحفظ, تحفظ ذهني (شك غير معلن يمنعك من قبول شيء ما بقلب خالص)",
 "しんりりょうほう": "علاج نفسي (علاج المشاكل العقلية أو العاطفية بوسائل نفسية) / الصحة النفسية, علاج نفسي (فرع الطب النفسي المعني بالطرق النفسية)",
 "しんりりょうほうか": "معالج نفسي (معالج يتعامل مع الاضطرابات العقلية والعاطفية)",
 "しんりりょうほうし": "معالج نفسي (معالج يتعامل مع الاضطرابات العقلية والعاطفية)",
 "しんりりんしょうか": "معالج نفسي (معالج يتعامل مع الاضطرابات العقلية والعاطفية)",
 "しんりん": "غَابَة, غابة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "しんりんおおかみ": "ذئب الغياض, ذئب رمادي (ذئب ذو معطف رمادي مبقع يعيش في المناطق الشمالية المشجرة في أمريكا الشمالية)",
 "しんりんかさい": "حريق غابة (حريق غير منضبط في منطقة حرجية)",
 "しんりんがく": "علم الغابات (علم زراعة ورعاية الغابات وإدارة الأخشاب النامية)",
 "しんりんげんかい": "خط الأشجار (الخط الذي يمثل الحد الأعلى لنمو الأشجار في الجبال أو خطوط العرض الشمالية)",
 "しんりんさいせい": "إعادة التشجير (استعادة (إعادة زراعة) غابة تم تقليصها بسبب حريق أو قطع)",
 "しんりんち": "أحراج, غابة (أرض مغطاة بالأشجار والشجيرات)",
 "しんりんちたい": "أحراج, غابة (أرض مغطاة بالأشجار والشجيرات)",
 "しんりんはかい": "إزالة الأشجار, إزالة الغابات (إزالة الأشجار) / إزالة الغابات (حالة خلو المكان من الأشجار)",
 "しんりんばっさい": "إزالة الأشجار, إزالة الغابات (إزالة الأشجار) / إزالة الغابات (حالة خلو المكان من الأشجار)",
 "しんりテスト": "اختبار شخصية (أي اختبار يهدف إلى تقييم الشخصية)",
 "しんるい": "نِسْبِيّ / قَرِيب, قَرِيبَة / يقرب",
 "しんれい": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة. / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب. / رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / سول\nمثال: كان سامي هو روح الحفلة.",
 "しんれいがく": "رُوحَانِيّ, نَفْسَانِيّ (خارج نطاق العلوم الفيزيائية) / رُوحَانِيّ, نَفْسِيّ (يؤثّر في النفس البشريّة أو يتأثّر بها) / نفساني, وسيط روحي (شخص يبدو حساساً لأشياء تتجاوز النطاق الطبيعي للإدراك)",
 "しんれいきょうかい": "الكنيسة المعمدانية, المعمدانيون (أي من مختلف الكنائس البروتستانتية الإنجيلية التي تؤمن بمعمودية المؤمنين الطوعيين)",
 "しんれいげんしょう": "باراسيكولوجيا, ظواهر نفسية خارقة (ظواهر تبدو وكأنها تتناقض مع القوانين الفيزيائية وتشير إلى إمكانية السببية عن طريق العمليات العقلية)",
 "しんれいしゅぎ": "روحانية (الاهتمام بأمور الروح)",
 "しんれいしょり": "تَحْتَ الصِّفْر (أَقَلَّ)\nمثال: أنا تحت الشجرة.",
 "しんれいじゅつ": "روحانية (الاهتمام بأمور الروح) / تحضير الأرواح, روحانية (الاعتقاد بأن أرواح الموتى يمكن أن تتواصل مع الأحياء (خاصة عبر وسيط)) / روحانية ((اللاهوت) أي مذهب يؤكد الوجود المنفصل لله)",
 "しんれいちりょう": "شفاء بالإيمان (الرعاية المقدمة من خلال الصلاة والإيمان بالله)",
 "しんれいろん": "روحانية (الاهتمام بأمور الروح) / تحضير الأرواح, روحانية (الاعتقاد بأن أرواح الموتى يمكن أن تتواصل مع الأحياء (خاصة عبر وسيط)) / روحانية ((اللاهوت) أي مذهب يؤكد الوجود المنفصل لله)",
 "しんれいろんしゃ": "روحاني (متعلق بالروحانية أو متصل بها) / وسيط روحي (شخص يعمل كوسيط بين الأحياء والأموات)\nمثال: استشار العديد من الوسطاء",
 "しんれき": "تقويم شمسي (تقويم يعتمد على الدورات الشمسية)",
 "しんれつ": "شفة أرنبية, شفة مشقوقة (شق خلقي في منتصف الشفة العليا)",
 "しんろ": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / مَسار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا الطبق لذيذ.",
 "しんろう": "قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / عَرِيس (اِسْمٌ لِمَاْوَى الأَسَد) / مَشَقَّة, شِدَّة / صَحْن (ساحة وسط الدَار. الجمع صحون؛ المستوي من الأرض)\nمثال: توم يلعب الصحن الطائر.",
 "しんろうまんしゅぎ": "الرومانسية الجديدة (حركة فنية تستند إلى إحياء الرومانسية في الفن والأدب)",
 "しんろへんこう": "تغيير المسار (تغيير في الاتجاه الذي تتحرك فيه)",
 "しんわ": "خُرَافَة / صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "しんわがく": "عِلْم اَلْأَسَاطِير (أَدْرَكَ حقيقة الشيء) / مِيثُولُوجِيَا\nمثال: أدرس علم النفس.",
 "しんわせい": "أُلْفَة, انْجِذَاب (انجذاب طبيعي أو شعور بالقرابة) / أُلْفَة, تَجَانُس (تشابه متأصل بين الأشخاص أو الأشياء) / ألفة, انجذاب كيميائي (القوة التي تجذب الذرات لبعضها وتربطها معاً في جزيء) / ألفة ((في المناعة) الانجذاب بين مستضد وجسم مضاد)\nمثال: انجذاب للسياسة",
 "しんわてき": "أُسْطُورِيّ, مِيثُولُوجِيّ (مبنيّ على القصص التقليدية أو مرويّ فيها؛ يفتقر إلى أساس واقعي) / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً) / متوافق, منسجم (قادر على الوجود والأداء في مزيج متناغم أو مقبول) / متوافق ((تقنياً) قابل للاستخدام مع أو الاتصال بأجهزة أو مكونات أخرى دون تعديل) / قَابِلٌ لِلمَزْج, مُتَجَانِس (قادر على تكوين خليط متجانس لا ينفصل ولا يتغيّر بالتفاعل الكيميائي)\nمثال: زوجان متوافقان",
 "しんわりょく": "أُلْفَة, انْجِذَاب (انجذاب طبيعي أو شعور بالقرابة) / أُلْفَة, تَجَانُس (تشابه متأصل بين الأشخاص أو الأشياء) / ألفة, انجذاب كيميائي (القوة التي تجذب الذرات لبعضها وتربطها معاً في جزيء) / ألفة ((في المناعة) الانجذاب بين مستضد وجسم مضاد)\nمثال: انجذاب للسياسة",
 "しんエコー": "تخطيط صدى القلب (إجراء تشخيصي غير جراحي يستخدم الموجات فوق الصوتية لدراسة بنية وحركات القلب)",
 "しんエコーしんだん": "تخطيط صدى القلب (إجراء تشخيصي غير جراحي يستخدم الموجات فوق الصوتية لدراسة بنية وحركات القلب)",
 "しんエコーず": "مخطط صدى القلب (صورة بيانية للقلب منتجة بواسطة جهاز تخطيط صدى القلب)",
 "しんエネ": "طاقة بديلة (طاقة مستمدة من مصادر لا تستنفد الموارد الطبيعية أو تضر بالبيئة)",
 "しんエネルギー": "طاقة بديلة (طاقة مستمدة من مصادر لا تستنفد الموارد الطبيعية أو تضر بالبيئة)",
 "しんタンポナーデ": "اندكاك قلبي, سطام قلبي (ضغط ميكانيكي على القلب ناتج عن تجمع كميات كبيرة من السوائل في حيز التامور مما يحد من نطاق الحركة الطبيعي للقلب)",
 "しんニッケルこう": "ميليريت (معدن أصفر يتكون من كبريتيد النيكل؛ مصدر ثانوي للنيكل)",
 "しんプラトンしゅぎ": "أفلاطونية محدثة (نظام من العقائد الفلسفية واللاهوتية يتألف من عناصر الأفلاطونية والأرسطية والتصوف الشرقي؛ مذهبها الأكثر تميزاً يرى أن المبدأ الأول ومصدر الواقع يتجاوز…)\nمثال: كانت الأفلاطونية المحدثة سائدة في أوروبا الوثنية حتى القرن السادس",
 "しんマ": "تدليك القلب (إجراء طارئ يستخدم الضغط الإيقاعي للقلب (إما من خلال جدار الصدر أو مباشرة على القلب أثناء الجراحة) في محاولة للحفاظ على الدورة الدموية أثناء السكتة…)",
 "しんロマンしゅぎ": "الرومانسية الجديدة (حركة فنية تستند إلى إحياء الرومانسية في الفن والأدب)",
 "しんローマンしゅぎ": "الرومانسية الجديدة (حركة فنية تستند إلى إحياء الرومانسية في الفن والأدب)",
 "しん酌": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "しーん": "بدون كلام, بصمت (بدون التحدث)\nمثال: جلس بصمت بجوارها",
 "し出し": "تَمْوِين / صَامِت, غَيْر نَاطِق (غير قادر على أو لا ينطوي بشكل خاص على الكلام أو السطور المنطوقة) / ممثل دور عابر (يؤدي دوراً صغيراً في عمل درامي)\nمثال: كان له دور صامت في المسرحية",
 "し向ける": "أَغْوَى, أَغْرَى / أَغْرَى / مِقْبَض / أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "し始める": "بَدَأَ, اِبْتَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "し尿": "إفرازات, فضلات الجسم (نفايات (مثل البول أو العرق ولكن خاصة البراز) يتم تصريفها من الجسم)",
 "し損じ": "خطأ فادح, زلة (خطأ محرج)",
 "し損じる": "خطأ فادح, زلة (خطأ محرج)",
 "し損ずる": "خطأ فادح, زلة (خطأ محرج)",
 "し損ない": "خطأ فادح, زلة (خطأ محرج)",
 "し損なう": "خطأ فادح, زلة (خطأ محرج)",
 "し損ねる": "خطأ فادح, زلة (خطأ محرج)",
 "し烈": "عَاصِف, مُضْطَرِب (شَدِيد الهَيَجَان والاضْطِرَاب) / شَرِس, ضَارٍ (عَدِيمُ الرَّحْمَةِ فِي المُنَافَسَة) / جَامِح, حَادّ (يَتَّسِمُ بِشِدَّةٍ مُتَطَرِّفَةٍ فِي المَشَاعِرِ أَوِ القَنَاعَات؛ يَمِيلُ إِلَى رَدِّ الفِعْلِ العَنِيف) / شَرِس, ضَارٍ (يَتَّسِمُ بِطَاقَةٍ بَالِغَةِ العُنْفِ وَالشِّدَّة)",
 "し直す": "إعادة إنتاج, نسخة جديدة (إبداع تم إنشاؤه مرة أخرى أو من جديد)\nمثال: إنه إعادة إنتاج لفيلم قديم",
 "し終える": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "し腐る": "فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "し遂げる": "أَدَّى",
 "じ": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / شَخْصِيَّة / خُلْق (أَنْشَأَ، أَوْجَدَ) / حَرْف, رَمْز (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / مِحْرَف\nمثال: زيري سيء الخلق. / خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض. / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / بَاسُور / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب. / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم. / مِئَة وَوَاحِد (يَدُلُّ عَلَى العَدَد 101) / كوري (وحدة للنشاط الإشعاعي تساوي كمية النظير المشع الذي يتحلل بمعدل 37 مليار تفكك في الثانية) / طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / مِن, عَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / أَرْض (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون) / مَلْعَب كُرَة قَدَم (موضع اللَعِب عامة؛ موضع يلعب فيه الصغار، يوضع لهم فيه العاب)\nمثال: أرض الله واسعة. / هدورة, جلدة / ريقة / سَلَخَ (قشر الجلد عن اللحم؛ نزع الشيء عن الشيء بقوة)\nمثال: سلخ زيري ذلك الغزال. / مَلْمَس / قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء / جِسْر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قَنْطَرَة / كوبري / جسر (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ) / قنطرة / بْرِيدْج\nمثال: اذهب إلى الجسر. / دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
 "じあい": "عاطفة, محبة (شعور إيجابي بالإعجاب)\nمثال: وجد صعوبة في التعبير عن المودة التي شعر بها / عشق الذات, نرجسية (اهتمام وإعجاب استثنائي بالنفس) / خيلاء, عجب (مشاعر الفخر المفرط)\nمثال: عشق للذات حجب كل شخص آخر / مَلْمَس / لون خفي, مسحة (لون شاحب أو هادئ) / معنى مبطن, نبرة خفية (جودة عاطفية خفية تكمن وراء الكلام؛ معنى ضمني) / صوت خفيض, همس (نبرة صوت هادئة أو مكتومة)",
 "じあえんそさん": "حمض الهيبوكلوروز (حمض ضعيف غير مستقر يعرف فقط في المحلول وفي أملاحه؛ يستخدم كعامل تبييض ومؤكسد)",
 "じあえんそさんえん": "هيبوكلوريت (أي ملح أو إستر لحمض الهيبوكلوروز)",
 "じあえんそさんナトリウム": "هيبوكلوريت الصوديوم",
 "じあたま": "جِهَاز الْمُخَابَرَات, مُخَابَرَات",
 "じあつ": "سَمِيك, غَلِيظ / غَلِيظ",
 "じありんさん": "حمض الهيبوفوسفوروز (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "じあん": "خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة) / هَمَّ\nمثال: لخص التقرير في صفحة.",
 "じあリンさん": "حمض الهيبوفوسفوروز (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "じぃじ": "جَدِّي",
 "じぃちゃん": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم عن طريق الأب، فهو أبو الأب وأبو أبوه وهكذا)\nمثال: عليك العمل بجد.",
 "じい": "عَادَة سِرِّيَّة / اِسْتِمْنَاء / جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم عن طريق الأب، فهو أبو الأب وأبو أبوه وهكذا)\nمثال: عليك العمل بجد. / شَيْخ, عَجُوز / عجوز, مخضرم / مُظَاهَرَة, تَظَاهُر (مُظَاهَرَة من أجل تحقيق هدف معين ٠)\nمثال: قرابة الألف شاركوا في المظاهرة. / مَسْرَد",
 "じいうんどう": "مُظَاهَرَة, تَظَاهُر (مُظَاهَرَة من أجل تحقيق هدف معين ٠)\nمثال: قرابة الألف شاركوا في المظاهرة.",
 "じいがせ": "خيتون, عديد الأصداف (رخوي بحري بدائي ممدود متناظر ثنائياً له عباءة مغطاة بثماني صفائح جيرية) / خيتون (سترة صوفية ارتداها الرجال والنساء في اليونان القديمة)",
 "じいこうい": "عَادَة سِرِّيَّة / اِسْتِمْنَاء / مُظَاهَرَة, تَظَاهُر (مُظَاهَرَة من أجل تحقيق هدف معين ٠)\nمثال: قرابة الألف شاركوا في المظاهرة.",
 "じいさん": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم عن طريق الأب، فهو أبو الأب وأبو أبوه وهكذا)\nمثال: عليك العمل بجد.",
 "じいしき": "ارتباك ذاتي, وعي ذاتي (وعي بالذات بالإضافة إلى الإدراك الإضافي بأن الآخرين يدركونك بالمثل) / ارتباك, وعي مفرط بالذات (إحراج نابع من الشعور بأن الآخرين يراقبونك بشكل نقدي)",
 "じいじ": "جَدِّي",
 "じいじい": "أَزِيزِيّ (ساخن بما يكفي للاحتراق مع صوت أزيز أو كأنَّه كذلك) / مُتَأَجِّج, مُثِير (يتّسم بالعاطفة الشديدة أو الاهتمام أو الإثارة) / صفير حاد, صياح (ضجيج حاد مستمر)\nمثال: صليل السيوف وصفير الأبواق / طَنِين",
 "じいちゃん": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم عن طريق الأب، فهو أبو الأب وأبو أبوه وهكذا)\nمثال: عليك العمل بجد.",
 "じいっと": "بلا حراك (بدون حركة؛ بطريقة ساكنة)\nمثال: رأى الرجل ذا الشعر الأسود ينتظر بلا حراك خلف الجانب الآخر من المنصة / بتركيز, بثبات (بطريقة ثابتة ومركزة)\nمثال: حدق بي بثبات / بصبر (مع صبر؛ بطريقة صبورة)\nمثال: لعب بصبر مع الطفل / بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم",
 "じいろ": "أَرْض (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون) / مَلْعَب كُرَة قَدَم (موضع اللَعِب عامة؛ موضع يلعب فيه الصغار، يوضع لهم فيه العاب)\nمثال: أرض الله واسعة.",
 "じいん": "كَنِيسَة, كَنَائِس (محلّ العبادة عند المسيحيين؛ جماعة المؤمنين بدين المسيح)\nمثال: أين أقرب كنيسة ؟",
 "じいんと": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً) / بِعُمْق (إلى عمق كبير؛ بعيداً للأسفل أو للداخل)\nمثال: شعروا بالخسارة بعمق / جَارِح, لَاذِع ((في الكلام) حادّ أو مؤذٍ في النبرة أو الطابع) / لسعة (نوع من الألم؛ شيء مفاجئ ومؤلم كأنك تعرضت للدغ)\nمثال: لسعة الموت",
 "じうす": "رَفِيع, رَقِيق / ضعيف, ضعيفة",
 "じうた": "أُغْنِيَّةٌ شَعْبِيَّة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر)\nمثال: أنا أغني أغنية.",
 "じぇじぇじぇ": "وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة!",
 "じぇんこ": "نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال.",
 "じえい": "حَرَس خَاصّ, حَرَس (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي. / دِفَاع عَنِ النَّفْسِ",
 "じえいかん": "دِفَاع عَنِ النَّفْسِ",
 "じえいかんたい": "دِفَاع عَنِ النَّفْسِ",
 "じえいぎょうしゃ": "عامل مستقل, فريلانسر (كاتب أو فنان يبيع خدماته لأصحاب عمل مختلفين دون عقد طويل الأجل مع أي منهم)",
 "じえいしょうぼうたい": "دفاع عن النفس (فعل الدفاع عن نفسك)",
 "じえいたい": "دفاع عن النفس (فعل الدفاع عن نفسك)",
 "じえいたいはけん": "دِفَاع عَنِ النَّفْسِ",
 "じえいたいほう": "دِفَاع عَنِ النَّفْسِ",
 "じえいだん": "دفاع عن النفس (فعل الدفاع عن نفسك)",
 "じえき": "وَبَاء, أَوْبِئَة (المرض العام الذي ينتشر بين الناس)\nمثال: على السلطات أن توقف انتشار الوباء.",
 "じえん": "التهاب الأذن (التهاب الأذن)",
 "じか": "الآن, اليوم (في هذه الأوقات) / حاضر (الفترة الزمنية التي تحدث الآن؛ أي امتداد مستمر للزمن يشمل لحظة الكلام)\nمثال: فقط من خلال لغتهم يتم تمييز الطبقات العليا في هذه الأيام / ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان) / ثَمَن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن. / مَغْنَطَة / مِلْك, نَفْس (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / مَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه. / مُبَاشِر / وَجَّه, قَاد (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس)\nمثال: تبدو شاحب الوجه. / طب الأذن (فرع الطب المعني بالأذن)",
 "じかい": "حقل مغناطيسي (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل. / إبادة, محق (تدمير شامل) / اضمحلال إشعاعي, تفكك إشعاعي (التفكك التلقائي لمادة مشعة مصحوب بانبعاث إشعاع مؤين) / انحلال, تفكك (الانفصال إلى أجزاء مكونة) / تفتت, تفكك (في حالة متحللة)\nمثال: أدت تجارب القنابل إلى إبادة الجزيرة المرجانية / انتحار, تدمير الذات (فعل قتل النفس) / تدمير الذات (فعل تدمير النفس)\nمثال: الانتحار جريمة (في بعض القوانين) / صيوان الأذن (البنية الغضروفية المرئية خارجياً للأذن الخارجية) / أذينة (جيب مخروطي صغير يبرز من الجزء الأمامي العلوي لكل أذين من القلب)",
 "じかいきょうど": "شدة المجال المغناطيسي, كثافة التدفق المغناطيسي (كمية التدفق المغناطيسي في وحدة مساحة عمودية على اتجاه التدفق المغناطيسي)",
 "じかいさく": "تكملة, جزء تالٍ (جزء يضاف إلى كتاب أو مسرحية يكملها ويوسعها) / تتمة, تكملة (شيء يتبع شيئاً آخر)",
 "じかいさよう": "إبادة, محق (تدمير شامل) / اضمحلال إشعاعي, تفكك إشعاعي (التفكك التلقائي لمادة مشعة مصحوب بانبعاث إشعاع مؤين) / انحلال, تفكك (الانفصال إلى أجزاء مكونة) / تفتت, تفكك (في حالة متحللة)\nمثال: أدت تجارب القنابل إلى إبادة الجزيرة المرجانية",
 "じかいしょく": "طعم ذاتي (نسيج يؤخذ من موقع ويُطعم في موقع آخر على نفس الشخص)\nمثال: عندما تفشل الكسور في الالتئام، يمكن أن تكون الطعوم الذاتية من العظام قيمة للغاية في مساعدة العظم على الشفاء",
 "じかく": "بَاسُور / وَعْي بِالذَّات (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…)\nمثال: إنها فاقدة الوعي. / أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد أن سَبَقَه)\nمثال: لم أدرك أبدا أنه يحبني. / ارتباك ذاتي, وعي ذاتي (وعي بالذات بالإضافة إلى الإدراك الإضافي بأن الآخرين يدركونك بالمثل) / ارتباك, وعي مفرط بالذات (إحراج نابع من الشعور بأن الآخرين يراقبونك بشكل نقدي) / صيوان الأذن (البنية الغضروفية المرئية خارجياً للأذن الخارجية) / أذينة (جيب مخروطي صغير يبرز من الجزء الأمامي العلوي لكل أذين من القلب) / الزَّاوِيَة السَّاعِيَّة (المسافة الزاوية على طول خط الاستواء السماوي من خط زوال الراصد إلى الدائرة الساعية لجرم سماوي معين) / زاوية الساعة ((علم الفلك) المسافة الزاوية لنقطة سماوية مقاسة غرباً على طول خط الاستواء السماوي من تقاطع السمت؛ المطلع المستقيم لمراقب في موقع معين ووقت معين من…)",
 "じかくてき": "خَجُول, مُرْتَبِك مِنْ ذَاتِهِ (واعٍ بشكل مفرط وغير مريح بمظهره أو سلوكه) / مُدْرِكٌ لِنَفْسِهِ, وَاعٍ بِذَاتِهِ (مُدْرِكٌ لِذَاتِهِ كَفَرْدٍ وَلِكَيْنُونَتِهِ وَأَفْعَالِهِ وَأَفْكَارِهِ)",
 "じかけいこう": "فلورة ذاتية (فلورة مستحثة ذاتياً)",
 "じかじゅせい": "إخصاب ذاتي (إخصاب عن طريق اتحاد الأمشاج الذكرية والأنثوية من نفس الفرد)",
 "じかじゅふん": "تلقيح ذاتي (إخصاب عن طريق نقل حبوب اللقاح من المئبر إلى الميسم في نفس الزهرة)",
 "じかじょうぞう": "مُخَمَّرٌ مَنْزِلِيًّا (مُخمَّر أو مُختمَر في المنزل)",
 "じかせい": "مَنْزِلِيّ",
 "じかせいしょく": "تزاوج ذاتي (الإخصاب الذاتي في النباتات)",
 "じかせん": "غدة نكفية (غدة لعابية كبيرة تنتج 50% من اللعاب أثناء النهار؛ توجد في البشر أمام وأسفل كل أذن)",
 "じかせんえん": "نُكَاف",
 "じかそうがく": "القيمة السوقية, رسملة السوق (تقدير لقيمة شركة يتم الحصول عليه بضرب عدد الأسهم القائمة في السعر الحالي للسهم)",
 "じかた": "سَاحِل, شَاطِئ / دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / رِيف, ريف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة) / كونتري, كنتري / رِيفِيّ, نِسْبَة إِلَى الرِّيف\nمثال: لبنان دولة صغيرة.",
 "じかどうちゃく": "تناقض ذاتي (مناقضة النفس)",
 "じかに": "مُبَاشَرَةً",
 "じかはつでん": "عَادَة سِرِّيَّة / اِسْتِمْنَاء",
 "じかほけん": "تأمين ذاتي (تأمين نفسك عن طريق تخصيص أموال لتغطية الخسائر المحتملة بدلاً من شراء بوليصة تأمين)",
 "じかほんい": "أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة)",
 "じかん": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب. / نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / حِصَّةٌ / عَصْر (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: هذه هي نقطة ضعفه. / وكيل وزارة (وزير يتبع مباشرة رئيس قسم حكومي) / الأنبوب السمعي, النفير (أي من الأنبوبين المزدوجين اللذين يربطان الأذن الوسطى بالبلعوم الأنفي؛ يعمل على موازنة ضغط الهواء على جانبي طبلة الأذن)",
 "じかんかんり": "الوقَة",
 "じかんがい": "وَقْت إِضَافِيّ (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب.",
 "じかんがいきんむ": "وَقْت إِضَافِيّ (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب.",
 "じかんぎれ": "وَقْت مُسْتَقْطَع (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب.",
 "じかんげんしゅ": "انضباط, دقة المواعيد (صفة أو عادة الالتزام بالوقت المحدد)",
 "じかんさ": "فَارِق اَلتَّوْقِيت",
 "じかんじく": "جدول زمني, خط زمني (تسلسل لأحداث مترابطة مرتبة زمنياً ومعروضة على طول خط (عادة ما يُرسم من اليسار إلى اليمين أو من الأعلى إلى الأسفل))",
 "じかんずれ": "انتظار, تأجيل (الوقت الذي يتم فيه انتظار إجراء ما)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً",
 "じかんせい": "ممتلكات زمنية (الممتلكات الدنيوية للكنيسة (غير الروحية))",
 "じかんせいげん": "حد زمني, مهلة (فترة زمنية يجب خلالها إنجاز شيء ما أو إكماله)",
 "じかんたい": "فترة, فترة زمنية (مقدار من الزمن)\nمثال: فترة زمنية تمتد لثلاثين عاماً / مِنْطَقَة زَمَنِيَّة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "じかんつぶし": "مضيعة للوقت, هدر الوقت (تكريس الوقت لنشاط غير مجد)\nمثال: قد يكون هدر الوقت قاتلاً",
 "じかんてき": "دُنْيَوِيّ, زَمَنِيّ (مُتَعَلِّق بِالحَياة الدُّنْيا والوُجود الزَّمَنِيّ) / دُنْيَوِيّ, زَمَنِيّ (غير أبديّ؛ مرتبط بالحياة الدنيا الفانية) / دنيوي, زمني (من سمات أو مكرس للعالم الدنيوي مقابل العالم الروحي) / صدغي (مكون من أو متعلق بالصدغين (جانبي الجمجمة خلف محجر العين))\nمثال: متاع الدنيا والتقدم",
 "じかんどおり": "عَلَى الْمَوْعَدِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "じかんにおくれる": "تَأَخَّرَ\nمثال: 約束の時間に遅れた。 — تأخرتُ على الموعد.",
 "じかんのむだ": "مضيعة للوقت, هدر الوقت (تكريس الوقت لنشاط غير مجد)\nمثال: قد يكون هدر الوقت قاتلاً",
 "じかんのムダ": "مضيعة للوقت, هدر الوقت (تكريس الوقت لنشاط غير مجد)\nمثال: قد يكون هدر الوقت قاتلاً",
 "じかんひょう": "جَدْوَل مَوَاعِيد, جَدْوَل",
 "じかんへんかんけいすう": "مقياس زمني (ترتيب للأحداث يُستخدم كمقياس للمدة)\nمثال: على المقياس الزمني الجيولوجي، وجد البشر للحظة وجيزة فقط",
 "じかんめ": "نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / حِصَّةٌ / عَصْر (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: هذه هي نقطة ضعفه.",
 "じかんわり": "جَدْوَل مَوَاعِيد, جَدْوَل",
 "じかんをかける": "قَضَى وَقْت",
 "じかんをさく": "وقت الفراغ, وقت حر (الوقت الخالي من الواجبات أو المسؤوليات) / وقت حر, وقت فراغ (الوقت المتاح للهوايات والأنشطة الأخرى التي تستمتع بها)",
 "じかんをむだにする": "ضَيَّعَ اَلْوَقْت",
 "じが": "اَلْأَنَا / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / بورتريه ذاتي (صورة لنفسك قمت بإنشائها بنفسك)",
 "じがい": "مُنْتَحِر, مُنْتَحِرَة",
 "じがいしき": "ارتباك ذاتي, وعي ذاتي (وعي بالذات بالإضافة إلى الإدراك الإضافي بأن الآخرين يدركونك بالمثل) / ارتباك, وعي مفرط بالذات (إحراج نابع من الشعور بأن الآخرين يراقبونك بشكل نقدي)",
 "じがく": "مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "じがじつげん": "تحقيق الذات (تحقيق قدرات الفرد وإمكاناته)",
 "じがぞう": "بورتريه ذاتي (صورة لنفسك قمت بإنشائها بنفسك)",
 "じがため": "الدور الأرضي, الطابق الأرضي (طابق المبنى الذي يكون عند مستوى الأرض المحيطة بالمبنى أو الأقرب إليه) / مَنْسُوب الأَرْض, مُسْتَوَى الأَرْض (ارتفاع الأرض التي يقوم عليها شيء ما)\nمثال: كانت قاعدة البرج تحت منسوب الأرض",
 "じがね": "سبيكة / معدن خسيس, معدن رخيص (معدن شائع ولا يعتبر ثميناً)\nمثال: الرصاص والحديد والنحاس والقصدير والزنك هي معادن خسيسة",
 "じき": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / خَزَف (خَزَفَ في مَشْيه يَخْزِفُ خَزْفًا: رفع يدَه ووَضعها؛ خَزَفَ الثوبَ: خَرَقه وشقَّه) / مِغْنَاطِيسِيَّة, مَغْنَاطِيسِيَّة / قَرِيبًا, سَرْعَانَ مَا / بالقرب, في مكان قريب (ليس بعيداً بالمصطلحات النسبية) / قَرِيب, مُجَاوِر (على مقربة؛ في متناول اليد)\nمثال: هي تعمل في مكان قريب / مُبَاشِر / وَجَّه, قَاد (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس)\nمثال: تبدو شاحب الوجه. / فُرْصَة / مَوْسِم / مَوْسِم, جُزْء / طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام. / استماتة, يأس (تهور يائس) / قنوط, يأس (حالة فقدان كل أمل أو غيابه)\nمثال: كانت سياسة يائسة",
 "じきあらし": "عاصفة مغناطيسية (اضطراب مفاجئ في المجال المغناطيسي للأرض؛ ناتج عن انبعاث جسيمات من الشمس)",
 "じきおんどけい": "مقياس حرارة ذاتي التسجيل (مقياس حرارة يسجل درجة الحرارة تلقائياً)",
 "じきがく": "علم المغناطيسية, مغناطيسية (فرع العلوم الذي يدرس المغناطيسية)",
 "じききあつけい": "باروجراف, مسجل الضغط الجوي (بارومتر مسجل؛ يسجل تلقائياً التغيرات في الضغط الجوي على الورق)",
 "じききおくそうち": "تخزين مغناطيسي, وسيط تخزين مغناطيسي (أي وسيط تخزين تُستخدم فيه أنماط مختلفة من المغنطة لتمثيل البتات أو البايتات المخزنة من المعلومات)\nمثال: القرص الصلب في جهاز الكمبيوتر الخاص بك هو تخزين مغناطيسي",
 "じききょうめい": "رنين مغناطيسي (رنين الإلكترونات أو الذرات أو الجزيئات أو الأنوية لترددات الإشعاع نتيجة لتكميم الفضاء في مجال مغناطيسي)",
 "じききょうめいえいぞうほう": "تصوير بالرنين المغناطيسي (استخدام الرنين المغناطيسي النووي للبروتونات لإنتاج صور كثافة البروتون)",
 "じききょうめいがぞう": "تصوير بالرنين المغناطيسي (استخدام الرنين المغناطيسي النووي للبروتونات لإنتاج صور كثافة البروتون)",
 "じききらい": "لغم مغناطيسي ((بحري) لغم بحري يتم تفجيره بواسطة آلية تستجيب للمواد المغناطيسية (مثل الهيكل الفولاذي للسفينة))",
 "じきけん": "غلاف مغناطيسي (المجال المغناطيسي لكوكب؛ الحجم حول الكوكب الذي تخضع فيه الجسيمات المشحونة للمجال المغناطيسي للكوكب أكثر من المجال المغناطيسي الشمسي)",
 "じきさま": "فَوْرًا, حَالًا",
 "じきざま": "فَوْرًا, حَالًا",
 "じきしごせん": "خط الزوال المغناطيسي (خط وهمي يمر عبر كلا القطبين المغناطيسيين للأرض)",
 "じきしょうそう": "سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع) / مُتَسَرِّع, مُسْتَعْجَل (أبكر ممّا ينبغي أو أكثر تسرّعاً من اللازم) / سابق لأوانه, مبتسر (ولد بعد فترة حمل أقل من الوقت الطبيعي)\nمثال: رضيع مبتسر",
 "じきじき": "بالذات, شخصياً (بالحضور الجسدي المباشر؛ دون وسيط)\nمثال: ذهبت إلى هناك شخصياً",
 "じきせいひん": "خَزَف (خَزَفَ في مَشْيه يَخْزِفُ خَزْفًا: رفع يدَه ووَضعها؛ خَزَفَ الثوبَ: خَرَقه وشقَّه)",
 "じきそうきょくし": "ثنائي قطب مغناطيسي (ثنائي قطب بأقطاب مغناطيسية متضادة)",
 "じきそうしょう": "سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع) / مُتَسَرِّع, مُسْتَعْجَل (أبكر ممّا ينبغي أو أكثر تسرّعاً من اللازم) / سابق لأوانه, مبتسر (ولد بعد فترة حمل أقل من الوقت الطبيعي)\nمثال: رضيع مبتسر",
 "じきそうそう": "سَابِقٌ لِأَوَانِه, مُبْتَسَر (مبكّر بشكل غير مألوف أو قبل الوقت المتوقّع) / مُتَسَرِّع, مُسْتَعْجَل (أبكر ممّا ينبغي أو أكثر تسرّعاً من اللازم) / سابق لأوانه, مبتسر (ولد بعد فترة حمل أقل من الوقت الطبيعي)\nمثال: رضيع مبتسر",
 "じきたんきょくし": "أُحَادِيّ القُطْب المِغْنَاطِيسِيّ (جسيم افتراضي له قطب مغناطيسي واحد بدلاً من القطبين المعتادين)",
 "じきていこうりつ": "ممانعة مغناطيسية ((في الفيزياء) مقاومة المادة لإنشاء مجال مغناطيسي فيها)",
 "じきてき": "موسمي (يحدث في أو يعتمد على موسم معين) / عامل موسمي (عامل يجد عملاً فقط في مواسم معينة)\nمثال: عمالة موسمية",
 "じきでん": "انْتِقَال مُبَاشِر (آلية انتقال ينتقل فيها العامل المعدي مباشرة إلى الجسم عن طريق اللمس أو العض أو التقبيل أو الجماع أو عن طريق قطرات تدخل العين أو الأنف أو الفم)",
 "じきに": "فَوْرًا, حَالًا / بِسُهُولَة",
 "じきのうりつ": "عَزْم مَغْنَاطِيسِيّ",
 "じきひ": "شَخْصِيّ",
 "じきひつ": "تَوْقِيع, أُوتُوجْرَاف (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم.",
 "じきふじょう": "رفع مغناطيسي, ماجليف (تكنولوجيا سكك حديدية عالية السرعة؛ حيث يُعلق القطار على وسادة مغناطيسية فوق مسار ممغنط ويسافر دون احتكاك)",
 "じきへんさ": "اختلاف مغناطيسي, انحراف مغناطيسي (الزاوية (في موقع معين) بين الشمال المغناطيسي والشمال الحقيقي)",
 "じきものしじょう": "السوق الفورية, سوق السلع الحاضرة (سوق يتم فيها شراء أو بيع سلعة للتسليم الفوري أو التسليم في المستقبل القريب جدًا)",
 "じきゅう": "تحمل, جلد (القدرة على تحمل المشقة أو التوتر) / بقاء, نجاة (حالة البقاء على قيد الحياة)\nمثال: يختبر الماراثون قدرة تحمل العداء / استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "じきゅうじそく": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "じきゅうせん": "حَرْب اِسْتِنْزاف (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "じきゅうりつ": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "じきゅうりょく": "تَحَمُّل, قُوَّةُ تَحَمُّل",
 "じきゆうどう": "شدة المجال المغناطيسي, كثافة التدفق المغناطيسي (كمية التدفق المغناطيسي في وحدة مساحة عمودية على اتجاه التدفق المغناطيسي) / تمغنط, مغنطة (العملية التي تجعل المادة مغناطيسية (مؤقتاً أو بشكل دائم))",
 "じきょ": "ذهاب, رحيل (فعل المغادرة)",
 "じきょう": "إِقْرَار, اِعْتِرَاف / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه) / منظار الأذن (أداة طبية تتكون من عدسة مكبرة وضوء؛ تستخدم لفحص الأذن الخارجية (القناة السمعية وخاصة طبلة الأذن))",
 "じきょく": "أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة / حَالَة, وَضْع",
 "じきりゅうたいりきがく": "ديناميكا الموائع المغناطيسية (دراسة تفاعل المجالات المغناطيسية والموائع الموصلة للكهرباء (مثل البلازما أو المعدن المنصهر))",
 "じきりょく": "جذب مغناطيسي, مغناطيسية (الانجذاب للحديد؛ يرتبط بالتيارات الكهربائية وكذلك المغناطيسات؛ ويتميز بمجالات القوة)",
 "じきん": "سبيكة / معدن خسيس, معدن رخيص (معدن شائع ولا يعتبر ثميناً)\nمثال: الرصاص والحديد والنحاس والقصدير والزنك هي معادن خسيسة",
 "じきインク": "حبر مغناطيسي (حبر يحتوي على جزيئات من مادة مغناطيسية يمكن الكشف عن وجودها بواسطة أجهزة استشعار مغناطيسية)",
 "じきコアメモリ": "ذاكرة القلب المغناطيسي (ذاكرة كمبيوتر تتكون من مصفوفة من القلوب المغناطيسية؛ تم استبدالها الآن بذواكر أشباه الموصلات)",
 "じきコンパス": "بوصلة مغناطيسية (بوصلة تعتمد على مؤشر (مثل إبرة مغناطيسية) يشير إلى الشمال المغناطيسي)",
 "じきストライプ": "شريط مغناطيسي (شريط قصير من الشريط المغناطيسي ملحق ببطاقة ائتمان أو بطاقة خصم؛ يحتوي على بيانات تخبر جهاز القراءة بهويتك ورقم حسابك، إلخ)",
 "じきテープ": "شريط مغناطيسي (جهاز ذاكرة يتكون من شريط بلاستيكي رفيع طويل مطلي بأكسيد الحديد؛ يستخدم لتسجيل الإشارات الصوتية أو الفيديو أو لتخزين معلومات الحاسوب)\nمثال: أخذ معه دزينة من الأشرطة لتسجيل المقابلة",
 "じきディスク": "قرص مغناطيسي ((علم الحاسوب) جهاز ذاكرة يتكون من قرص مسطح مغطى بطبقة مغناطيسية يتم تخزين المعلومات عليها)",
 "じきドラム": "أسطوانة مغناطيسية (أسطوانة مطلية بمادة مغناطيسية، لتخزين بيانات وبرامج الحاسوب)",
 "じきヘッド": "رأس مغناطيسي (مغناطيس كهربائي (كما في مسجل الشريط) يحول التغيرات الكهربائية إلى تغيرات مغناطيسية يمكن تخزينها على سطح واسترجاعها لاحقاً)",
 "じきモーメント": "عَزْم مَغْنَاطِيسِيّ",
 "じぎ": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "じぎどおり": "لَفْظِيّ, حَرْفِيّ",
 "じぎゃく": "تعذيب النفس, جلد الذات (ضيق مفروض ذاتياً)",
 "じぎゃくてき": "تعذيب النفس, جلد الذات (ضيق مفروض ذاتياً)",
 "じぎゃくネタ": "مُتَوَاضِع, مُنْتَقِص مِنْ ذَاتِه (واعٍ بعيوبه وقصوره الشخصيّة)",
 "じぎょう": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل. / مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم. / مِنْطَقَة, أَرْض (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "じぎょうか": "تَصْنِيع, تَحَوُّل صِنَاعِيّ / إضفاء الطابع التجاري, تسويق تجاري (فعل جعل الشيء تجارياً؛ إدخال شيء ما في التجارة)\nمثال: اعتبر والدي تحويل عيد الميلاد إلى مناسبة تجارية تدنيساً للمقدسات / رَجُل أَعْمَال, تَاجِر (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر.",
 "じぎょうかつどう": "نشاط تجاري (نشاط يتم القيام به كجزء من مؤسسة تجارية)",
 "じぎょうがいしゃ": "شركة, مؤسسة تجارية (أعضاء منظمة تجارية تمتلك أو تدير مؤسسة واحدة أو أكثر)\nمثال: عمل في شركة وساطة",
 "じぎょうけいかく": "مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم.",
 "じぎょうしゅ": "رَائِد أَعْمال مُتَعَهِّد / مُنَظِّم / رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "じぎょうしょ": "تَأْسِيس / مُؤَسَّسَة",
 "じぎょうじょう": "مَكَان عَمَل (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "じぎょうせい": "إِعْلَان تِجَارِيّ",
 "じぎょうだん": "كرش (مصطلحات عامية للكرش أو البطن البارز) / شركة مساهمة, مؤسسة (شركة تجارية تمت الموافقة على مواد تأسيسها في ولاية ما)",
 "じぎょうぬし": "رَائِد أَعْمال مُتَعَهِّد / مُنَظِّم / رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "じぎょうねんど": "سَنَة مَالِيَّة (مقدارُ قطع الشمس البروجَ الاثني عشر ، وهي السنة الشمسيَّة، و السَّنَةُ تمامُ اثنتَيْ عشرةَ دَورةً للقمر ، وهي السنة القمرية…)\nمثال: في عمره 24 سنة.",
 "じぎょうぶ": "تَقْسِيم / قِسْمَة (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / قِسْمَةٌ (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / فِرْقَة / فُرْقَة\nمثال: الزواج قسمة و نصيب.",
 "じぎょうほんぶ": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "じぎわ": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "じく": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات) / مِحْوَر / مَرْكَز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟ / سَاق / قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "じくあし": "تَرْكِيز",
 "じくう": "زمكان, متصل مكاني زماني (نظام الإحداثيات رباعي الأبعاد (3 أبعاد للمكان و1 للزمان) الذي تقع فيه الأحداث الفيزيائية)",
 "じくうかん": "زمكان, متصل مكاني زماني (نظام الإحداثيات رباعي الأبعاد (3 أبعاد للمكان و1 للزمان) الذي تقع فيه الأحداث الفيزيائية)",
 "じくうけ": "رمان بلي, كرسي تحميل (دعامة دوارة توضع بين الأجزاء المتحركة للسماح لها بالحركة بسهولة) / رسم شعار النبالة, شحنة (شعار النبالة المتمثل في تصميم أو صورة مرسومة على درع) / سلوك, هيئة (أسلوب أو سلوك وقور) / قوام, هيئة (طريقة مميزة لحمل الجسم)\nمثال: وقف بوضعية جيدة",
 "じくうせかい": "زمكان, متصل مكاني زماني (نظام الإحداثيات رباعي الأبعاد (3 أبعاد للمكان و1 للزمان) الذي تقع فيه الأحداث الفيزيائية)",
 "じくうれんぞくたい": "زمكان, متصل مكاني زماني (نظام الإحداثيات رباعي الأبعاد (3 أبعاد للمكان و1 للزمان) الذي تقع فيه الأحداث الفيزيائية)",
 "じくきょ": "قَاعِدَة العَجَلَات (المسافة من مركز العجلة الأمامية للسيارة إلى المحور الخلفي)",
 "じくぎ": "حُطَام خشب, عِيدَان (شظايا أو فتات من الخشب) / خشب أعواد الثقاب (خشب مناسب لصنع أعواد الثقاب) / حطام خشبي, شظايا خشبية (خشب في قطع صغيرة أو شظايا)\nمثال: تَحَطَّم إلى شظايا خشبية صغيرة",
 "じくぐみ": "إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما) / إطار, نسيج (الهيكل الأساسي) / إطار نظري, نموذج (وصف افتراضي لكيان أو عملية معقدة)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي",
 "じくさく": "محور عصبي (ليف عصبي طويل ينقل الإشارات بعيداً عن جسم الخلية العصبية)",
 "じくじ": "خَجُول",
 "じくじく": "رَاشِح, نَازِّ (يتسرّب ببطء) / رشح, نزيز (عملية التسرب ببطء)",
 "じくせい": "مِحْوَرِيّ (واقِع عَلى المِحْوَر أَوْ في اتِّجاهِه) / محوري (من أو متعلق بـ أو يشبه محور الدوران) / محوري (يتعلق بـ أو متصل بالمحور)\nمثال: زاوية محورية",
 "じくせん": "مِحْوَر",
 "じくつい": "مِحْوَر",
 "じくぼう": "قصبة الريشة (العمود الفقري المجوف للريشة) / عمود دوار, عمود نقل الحركة (قضيب دوار ينقل الطاقة أو الحركة) / سارية, عمود (قضيب أو عمود طويل (خاصة مقبض أداة أو جسم سلاح مثل الرمح أو السهم)) / بئر, عمود (ممر رأسي طويل محفور في الأرض، كما لمنجم أو نفق)",
 "じくもの": "طُومَار",
 "じくりゅうすいしゃ": "توربين محوري التدفق, عنفة محورية (توربين يعمل بتدفق محوري عكس الضاغط المحوري تماماً)\nمثال: بينما يصطدم تدفق الهواء بالدوار في التوربين المحوري، يتم توجيه التدفق بسلاسة بزاوية 90 درجة في التوربين الشعاعي",
 "じぐち": "لُعْبَة اَلْكَلِمَات, جِنَاس (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "じぐるま": "رباعي العجلات (مكون من أو متعلق بالمركبات ذات العجلات الأربع)\nمثال: دفع رباعي العجلات",
 "じけい": "اقتصاص ذاتي, الأمن الأهلي (أفعال لجنة أمن أهلي في محاولة لإنفاذ القوانين) / مَشْرُوع (ما تُجِيزُه السلطة أو القانون أو أي قاعدة، جَائِز، قَانُونِيّ؛ مسعى مؤقت أي شيء يُسْعى لفعله خلال فترة زمنية معينة، فيُقال مشروع شخصي، مشروع سياسي، مشروع تجاري ؛إلخ)\nمثال: هذا مشروع عظيم.",
 "じけいだん": "دِفَاع عَنِ النَّفْسِ",
 "じけいだんいん": "عضو لجنة الأمن الأهلية (عضو في لجنة الأمن الأهلية)",
 "じけいれつ": "سلسلة زمنية (سلسلة من قيم متغير في أوقات متتالية) / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / تَسَلْسُل زَمَنِيّ\nمثال: ما تاريخ اليوم؟",
 "じけし": "مِمْحَاة",
 "じけっしゅ": "أذن قرنبيطية (صيوان أذن مشوه بسبب إصابة؛ شائع بين الملاكمين)",
 "じけつ": "تَقْرِيرُ المَصِير / مُنْتَحِر, مُنْتَحِرَة",
 "じけん": "وَاقِعَة, حَادِثَة (مؤنث الوَاقِع، اسم فاعل للشيء المؤنث الذي وَقَعَ؛ مؤنث وَاقِع، الأمر المؤنث الحاصل)\nمثال: الصخور الواقعة تشكل خطرا على المتسلقين. / دائرة الساعة (دائرة عظمى على الكرة السماوية تمر عبر كلا القطبين السماويين)",
 "じけんせい": "إجرام (حالة كون الشخص مجرماً)",
 "じけんひょう": "برنامج زمني, جدول أعمال (خطة منظمة زمنياً للأمور التي يجب الاهتمام بها) / سجل القضايا ((قانون) تقويم المحكمة؛ قائمة القضايا التي ستتم محاكمتها أو ملخص لأنشطة المحكمة)",
 "じけんや": "ميثادون (عقار مخدر صناعي مشابه للمورفين ولكنه أقل تسبباً في التعود؛ يستخدم في إزالة السموم من المخدرات والحفاظ على علاج إدمان الهيروين) / وسيط نفوذ (شخص يتدخل لدى السلطات لصالح شخص في ورطة (عادة باستخدام أساليب ملتوية أو غير قانونية مقابل رسوم)) / مرمّم, مصلّح (عامل ماهر يصلح أو يرمم الأشياء) / عامل تثبيت, مثبت (مركب كيميائي يقوم بتثبيت شيء ما (مثل الصبغة أو الصورة الفوتوغرافية))",
 "じげ": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "じげん": "نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / حِصَّةٌ / عَصْر (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: هذه هي نقطة ضعفه. / حد زمني, مهلة (فترة زمنية يجب خلالها إنجاز شيء ما أو إكماله) / بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / مَنْظُور, نَظْرَة / مُظَاهَرَة (عرض عام للمشاعر الجماعية (عادة ذات طابع سياسي)) / تجلي, مظهر (دلالة واضحة لوجود أو حضور أو طبيعة شخص أو شيء ما) / انعكاس, تعبير (تعبير بدون كلمات) / تجسد, تجلي (ظهور في شكل جسدي (كما في الروح غير المتجسدة))\nمثال: كانت هناك مظاهرات عنيفة ضد الحرب",
 "じげんすう": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "じげんばくだん": "قُنْبُلَةٌ مَوْقُوتَةٌ",
 "じこ": "حَادِث / مُصَادَفَة, صُدْفَة / صُدْفَة, صِدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة. / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "じこあい": "نَرْجِسِيَّة (حُبُّ المرء ذاته وعِشْقُهُ إِيَّاهَا دون سواها)",
 "じこあいせいじんかくしょうがい": "اِضْطِرَاب الشَخْصِيَّة النَرْجِسِيَّة",
 "じこあいせいパーソナリティしょうがい": "اِضْطِرَاب الشَخْصِيَّة النَرْجِسِيَّة",
 "じこあんじ": "إيحاء ذاتي (نظام لتطوير الذات طوره إميل كوي وكان شائعاً في العشرينيات والثلاثينيات)",
 "じこいしき": "ارتباك ذاتي, وعي ذاتي (وعي بالذات بالإضافة إلى الإدراك الإضافي بأن الآخرين يدركونك بالمثل) / ارتباك, وعي مفرط بالذات (إحراج نابع من الشعور بأن الآخرين يراقبونك بشكل نقدي)",
 "じこいしょく": "طعم ذاتي (نسيج يؤخذ من موقع ويُطعم في موقع آخر على نفس الشخص)\nمثال: عندما تفشل الكسور في الالتئام، يمكن أن تكون الطعوم الذاتية من العظام قيمة للغاية في مساعدة العظم على الشفاء",
 "じこいにゅう": "تَعَاطُف",
 "じこう": "مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / أَمْر (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / قَضِيَّة, أَمْر (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / مَادَّة, جِسْم (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره) / هَمَّ\nمثال: لا أحب مادة العلوم. / وَصْفَة طِبِّيَّة, وَصْفَة / تَقَادُم / آخِذ فِي الشَّيْخُوخَة, شَائِخ (في طور التقدّم في السنّ والشيخوخة) / تقدم في السن, شيخوخة (العملية العضوية للتقدم في العمر وظهور آثار زيادة السن) / تعتق, نضج (اكتساب صفات مرغوبة عن طريق ترك الشيء دون إزعاج لبعض الوقت) / صِمْلَاخ, شَمْع اَلْأُذْن / مَوْسِم / مَوْسِم, جُزْء / تَقْلِيعَة / طين صيني, كاولين (طين ناعم عادة ما يكون أبيض ناتج عن تجوية المعادن الألومينية (مثل الفلسبار)؛ يستخدم في السيراميك وكمادة ماصة وكمادة مالئة (على سبيل المثال، في الورق)) / ماغنيتيت, مغناطيس طبيعي (أكسيد حديد ينجذب بقوة للمغناطيس) / مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "じこうおん": "ميزو سوبرانو (الصوت الغنائي النسائي بين الكونترالتو والسوبرانو) / ميزو سوبرانو (سوبرانو بصوت يقع بين السوبرانو والكونترالتو)",
 "じこうかい": "مَحَارَة ((في التشريح) بنية تشبه الصدفة في شكلها)",
 "じこうきゅうしょく": "في الموقع, ميداني (يحدث أو يقع في الموقع نفسه)\nمثال: تفتيش ميداني",
 "じこうはずれ": "في غير موسمه (لا يتماشى مع (وعادة ما يكون غير مرغوب فيه لـ) الموسم) / سَيِّئ التَّوْقِيت, فِي غَيْر أَوَانِه (ذو توقيت سيئ أو غير ملائم)\nمثال: عاصفة ثلجية مفاجئة في غير موسمها",
 "じこかいじ": "إِفْصَاح عَن الذَّات",
 "じこかぶしき": "أسهم الخزينة (أسهم أعادت الشركة المصدرة شراءها ومتاحة للإلغاء أو إعادة البيع؛ وهي مصدرة ولكنها غير متداولة؛ لا يمكن التصويت بها ولا تدفع أرباحاً)",
 "じこかんけつ": "استقلالية, اعتماد على النفس (الاستقلال الشخصي)",
 "じこかんけつてき": "مُسْتَغْرِق فِي نَفْسِه, مُنْغَمِس فِي ذَاتِه (منغمس في اهتماماته أو أفكاره الخاصة)",
 "じこぎせい": "إِيثَار, نُكْرَان الذَّات (التصرف بقلة اهتمام بالنفس مقابل نجاح النشاط المشترك)",
 "じこぎまん": "خداع الذات (مفهوم خاطئ يكون في صالح الشخص الذي يحمله)",
 "じこく": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / فُرْصَة / بورتريه ذاتي (صورة لنفسك قمت بإنشائها بنفسك)",
 "じこくさんテロリズム": "إرهاب محلي (إرهاب يمارس في بلدك ضد شعبك)\nمثال: كان تفجير المبنى الفيدرالي في أوكلاهوما سيتي عام 1995 مثالاً على الإرهاب المحلي",
 "じこくひょう": "جَدْوَل مَوَاعِيد, جَدْوَل",
 "じこくみん": "مُوَاطِن, مُوَاطِنَة (مَدَنِيّ؛ مُقِيم)\nمثال: أنا مواطن لبناني",
 "じこけいはつしょ": "تحسين الذات, تطوير الذات (فعل تحسين نفسك)",
 "じこけいはつぼん": "تحسين الذات, تطوير الذات (فعل تحسين نفسك)",
 "じこけってい": "تَقْرِيرُ المَصِير",
 "じこけんお": "اشمئزاز من الذات, كره الذات (خزي ناتج عن كراهية قوية لنفسك أو لأفعالك)",
 "じこけんさん": "تحسين الذات, تطوير الذات (فعل تحسين نفسك)",
 "じここうたい": "جسم مضاد ذاتي (جسم مضاد يعمل ضد أنسجة الكائن الحي الذي ينتجه)",
 "じここうていかん": "تَقْدِير ذَات",
 "じこさいみん": "تنويم ذاتي (تنويم مغناطيسي يقوم به الشخص لنفسه)",
 "じこしゅうきょうふしょう": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "じこしゅうよう": "تثقيف ذاتي, تعليم ذاتي (عملية تعليم النفس)",
 "じこしゅぎ": "أَنَانِيَّة",
 "じこしゅちょう": "تأكيد الذات (فعل تأكيد المرء لنفسه بطريقة عدوانية) / إثبات الذات (فعل طرح آرائك الخاصة بطريقة متباهية أو غير مراعية توحي بأنك تشعر بالتفوق على الآخرين)",
 "じこしょうか": "تحلل ذاتي, هضم ذاتي (تحلل الأنسجة النباتية أو الحيوانية عن طريق عملية داخلية)",
 "じこしんだん": "استبطان, تأمل ذاتي (تأمل أفكارك ورغباتك وسلوكك)",
 "じこじつげん": "تحقيق الذات (تحقيق قدرات الفرد وإمكاناته)",
 "じこじゅようき": "مستقبل الحس العميق (نهايات عصبية خاصة في العضلات والأوتار والأعضاء الأخرى تستجيب للمحفزات المتعلقة بوضع وحركة الجسم)",
 "じこそうじずけい": "فركتل, كسرية ((رياضيات) نمط هندسي يتكرر عند كل مقياس، وبالتالي لا يمكن تمثيله بالهندسة الكلاسيكية)",
 "じこそしきか": "تنظيم ذاتي (تنظيم نفسك (خاصة تنظيم نقابة العمال الخاصة بك))",
 "じこたはつ": "كَثِير الحَوَادِث (يتعرّض لعدد من الحوادث يفوق المتوسّط)",
 "じこたはつちてん": "كَثِير الحَوَادِث (يتعرّض لعدد من الحوادث يفوق المتوسّط)",
 "じこたんれん": "إنكار الذات, ضبط النفس (فعل إنكار الذات؛ السيطرة على الدوافع) / انضباط ذاتي (سمة ممارسة الانضباط الذاتي)",
 "じこちゅう": "أَنَانِيَّة",
 "じこちゅうしん": "أَنَانِيَّة",
 "じこちゅうしんせい": "أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة)",
 "じこちゅうしんてき": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "じことうえい": "إِسْقَاط / مَسْقَط (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "じことうすい": "نَرْجِسِيَّة (حُبُّ المرء ذاته وعِشْقُهُ إِيَّاهَا دون سواها)",
 "じこどうちゃく": "تناقض ذاتي (مناقضة النفس)",
 "じこはかい": "انتحار, تدمير الذات (فعل قتل النفس) / تدمير الذات (فعل تدمير النفس)\nمثال: الانتحار جريمة (في بعض القوانين)",
 "じこはんせい": "إعادة نظر, تفكير ثانٍ (التفكير مرة أخرى في خيار تم اتخاذه سابقاً)\nمثال: أعاد النظر في مشترياته",
 "じこひだい": "تمجيد الذات, غرور (عمل يتم لزيادة قوتك ونفوذك أو لجذب الانتباه لأهميتك الخاصة)",
 "じこひてい": "إِنْكَار الذَّات, زُهْد (التخلي عن مصالحك الخاصة لصالح مصالح الآخرين) / إنكار الذات, ضبط النفس (فعل إنكار الذات؛ السيطرة على الدوافع) / انضباط ذاتي (سمة ممارسة الانضباط الذاتي)",
 "じこひはん": "نقد ذاتي (انتقاد المرء لنفسه)",
 "じこひょうか": "تَقْدِير ذَات",
 "じこひょうげん": "تعبير عن الذات (التعبير عن فردية المرء (عادة من خلال الأنشطة الإبداعية))",
 "じこぶんかい": "تحلل ذاتي, هضم ذاتي (تحلل الأنسجة النباتية أو الحيوانية عن طريق عملية داخلية)",
 "じこぶんせき": "تحليل ذاتي (تطبيق مبادئ العلاج النفسي لتحليل شخصيتك الخاصة) / تحليل ذاتي, محاسبة النفس (فحص دقيق لمعتقداتك ودوافعك)",
 "じこべんご": "تبرير, حجة (دفاع عن سلوك مسيء أو فشل في الوفاء بوعد وما إلى ذلك)\nمثال: استمر في إيجاد الأعذار للبقاء",
 "じこほしん": "أناني, متمركز حول الذات (يهتم بشكل رئيسي أو حصري بنفسه ومصلحته مع استبعاد الآخرين)\nمثال: رجال أنانيون كانوا يحاولون تحقيق مكاسب لأنفسهم من قضية الحقوق المدنية المقدسة",
 "じこほぜん": "دفاع عن النفس (فعل الدفاع عن نفسك)",
 "じこほぞん": "حفظ الذات, غريزة البقاء (حفظ النفس من الأذى؛ ميل طبيعي أو غريزي)",
 "じこほんい": "أحادية, حب الذات (الاهتمام بمصالح المرء ورفاهيته الخاصة)",
 "じこぼうえい": "دِفَاع عَنِ النَّفْسِ",
 "じこまん": "رضا عن الذات, غرور (الشعور الذي ينتابك عندما تكون راضياً عن نفسك)\nمثال: كان رضاه عن نفسه مثيراً للاشمئزاز تماماً",
 "じこまんぞく": "رضا عن الذات, غرور (الشعور الذي ينتابك عندما تكون راضياً عن نفسك)\nمثال: كان رضاه عن نفسه مثيراً للاشمئزاز تماماً",
 "じこむじゅん": "تناقض ذاتي (مناقضة النفس)",
 "じこめんえき": "مناعة ذاتية (إنتاج أجسام مضادة ضد أنسجة جسمك؛ يسبب أمراض المناعة الذاتية أو تفاعلات فرط الحساسية)",
 "じこめんえきしっかん": "مرض مناعة ذاتية (أي من مجموعة كبيرة من الأمراض التي تتميز بخلل في وظائف الجهاز المناعي مما يجعله ينتج أجساماً مضادة ضد أنسجة الجسم نفسه)",
 "じこめんえきせい": "مناعة ذاتية (إنتاج أجسام مضادة ضد أنسجة جسمك؛ يسبب أمراض المناعة الذاتية أو تفاعلات فرط الحساسية)",
 "じこめんえきふぜん": "مرض مناعة ذاتية (أي من مجموعة كبيرة من الأمراض التي تتميز بخلل في وظائف الجهاز المناعي مما يجعله ينتج أجساماً مضادة ضد أنسجة الجسم نفسه)",
 "じこもく": "أَمَل ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / رَشْف (رشف الماء أو نحوه: مصه بشفتيه؛ رشف الإناء: شرب ما فيه ولم يترك فيه شيئا) / زَفْر (زفَر الشَّخصُ : أخرج نفَسه من رئتيه بعد مدِّه إيّاه؛ أظهر تعبيرًا عن الحزن أو الألم من خلال تنهد أو صوت عميق)\nمثال: أشعر بخيبة أمل.",
 "じこゆうどう": "حث ذاتي (توليد قوة دافعة كهربائية في دائرة بتغيير التيار في تلك الدائرة؛ يقاس عادة بالهنري)",
 "じこよくせい": "تمالك النفس (إظهار التحفظ المفروض على الذات)\nمثال: اعتدال فعال في النقاش",
 "じこれんびん": "رثاء الذات (شعور بالأسى (غالباً ما يكون متساهلاً مع الذات) على معاناة المرء الخاصة)",
 "じこん": "مِنَ الآنَ فَصَاعِدًا, اِنْطِلَاقًا مِنَ الْآنِ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "じこんいご": "من الآن, من الآن فصاعداً (من هذا الوقت فصاعداً؛ من الآن فصاعداً)\nمثال: من الآن فصاعداً ستعرف باسم السيدة سميث",
 "じこんじご": "فِي ٱلْمُسْتَقْبَل (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "じこインダクタンス": "حَثّ ذَاتِيّ, مُعَامِل الحَثّ الذَّاتِيّ (النسبة بين القوة الدافعة الكهربائية الناتجة في دائرة عن طريق الحث الذاتي ومعدل تغير التيار الذي ينتجها، معبراً عنها بالهنري)",
 "じご": "بعد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / خَلْفَ, وَرَاء (بَدَلَ، أَعْقَبَ؛ أَتَى بعده أو جاء مكانه) / بَعْدَمَا\nمثال: و بعد قليل أتى. / بعد ذلك, منذ ذلك الحين (من ذلك الوقت فصاعداً)\nمثال: بعد ذلك لم يتصل أبداً مرة أخرى / خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / همس, وشوشة (التحدث بنعومة دون اهتزاز الحبال الصوتية) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "じごう": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "じごえ": "سجل الصدر, صوت الصدر (النطاقات الدنيا للصوت في الكلام أو الغناء)",
 "じごく": "جَهَنَّم, جَحِيم / جَحِيم, جَهَنَّم",
 "じごくにほとけ": "رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال)) / المن, المن والسلوى ((في العهد القديم) الطعام الذي أعطاه الله لبني إسرائيل أثناء الخروج)\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "じごじゅうはん": "شريك بعد الواقعة (شخص يقدم المساعدة أو الراحة لشخص معروف بأنه مجرم أو معروف بأنه مطلوب فيما يتعلق بارتكاب جناية)",
 "じごじゅうはんにん": "شريك بعد الواقعة (شخص يقدم المساعدة أو الراحة لشخص معروف بأنه مجرم أو معروف بأنه مطلوب فيما يتعلق بارتكاب جناية)",
 "じさ": "فَارِق اَلتَّوْقِيت",
 "じさい": "شماس مساعد, مساعد الكاهن (شخص يساعد الكاهن أو القس في الخدمة الليتورجية؛ رجل دين مرسوم في أعلى الرتب الصغرى في الكنيسة الكاثوليكية الرومانية) / مُنْتَحِر, مُنْتَحِرَة",
 "じさくじえん": "مُدَبَّر سِرًّا (مخطط له في السر)",
 "じさげ": "تحزيز, تسنين (عملية القطع في حافة بشقوق تشبه الأسنان أو شقوق زاوية) / مسافة بادئة (المسافة المتروكة بين الهامش وبداية سطر تمت إزاحته) / تخشّن, تنقر (تشكل نقر صغيرة في سطح ما نتيجة للتآكل) / انبعاج, ثلمة (قطع مقعر في سطح أو حافة (كما في الخط الساحلي))",
 "じさつ": "مُنْتَحِر, مُنْتَحِرَة",
 "じさつてき": "اِنْتِحَارِيّ",
 "じさつてん": "هدف ذاتي, هدف عكسي (جاء إلى الهَدَف؛ ارتفع عن الأرض)\nمثال: لقد أخطأ الهدف.",
 "じさぼけ": "إعياء السفر, اضطراب الرحلات الجوية الطويلة (تعب واضطراب في النوم ناتج عن خلل في الإيقاع اليومي الطبيعي للجسم نتيجة السفر بالطائرة)",
 "じさん": "تسليم, توصيل (عملية تسليم أو توزيع شيء ما (كالبضائع أو البريد))\nمثال: تسليمه المتردد للأخبار السيئة / تباهي, تفاخر (الحديث عن النفس بصيغ التفخيم)",
 "じさんきん": "مَهْر",
 "じさんにん": "حامل, ناقل (شخص تتضمن وظيفته حمل شيء ما) / حامل (الشخص الذي بحوزته شيك أو كمبيالة أو سند أو وثيقة ملكية مظهرة له أو لمن يحملها) / حامل (رسول يحمل أو يقدم شيئاً) / حامِل النَّعْش (أحد المشيعين الذين يحملون النعش في الجنازة)\nمثال: نُقلت السندات بواسطة حامل",
 "じさボケ": "إعياء السفر, اضطراب الرحلات الجوية الطويلة (تعب واضطراب في النوم ناتج عن خلل في الإيقاع اليومي الطبيعي للجسم نتيجة السفر بالطائرة)",
 "じざい": "خطاف القدر",
 "じざいかぎ": "خطاف القدر",
 "じざいつぎて": "مفصل عام, وصلة كاردان (قارنة تربط عمودين دوارين مما يسمح بحرية الحركة في جميع الاتجاهات)\nمثال: في المركبات الآلية، يسمح المفصل العام لعمود التدوير بالتحرك صعوداً وهبوطاً أثناء مرور المركبة فوق المطبات",
 "じざいど": "باب متأرجح (باب يتأرجح على مفصل مزدوج؛ يفتح في أي من الاتجاهين)",
 "じざいに": "بحرية (بطريقة حرة)\nمثال: تتميز اللوحة بضربات فرشاة حرة",
 "じざいスパナ": "مِفْتَاح إِنْجْلِيزِيّ (مفتاح)\nمثال: بحث عن المفتاح.",
 "じざかい": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "じし": "بِاحْتِرَام (بطريقة محترمة)\nمثال: هل لي أن أقترح باحترام على مجلس المدينة أن يتبنوا سياسة عدم النشاط المتقن؟ / مُنْتَحِر, مُنْتَحِرَة / اسْتِماتَة / وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / سبابة (الإصبع المجاور للإبهام)",
 "じしつ": "تخدير, ذهول (فعل جعل الشخص متبلد الشعور أو خاملاً) / ترنح, ذهول (وعي هامشي) / انصعاق, ذهول (شعور بالدهشة المذهلة)\nمثال: اشتهر الأستاذ بجعل طلابه في حالة ذهول / بَاسُور",
 "じしゃ": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم / إِنْكَار, رَفْض",
 "じしゃかぶこうにゅうけん": "خيار الأسهم, خيار شراء الأسهم (ميزة تمنحها الشركة للموظف في شكل خيار لشراء أسهم في الشركة بخصم أو بسعر ثابت) / خيار الأسهم (الحق في شراء أو بيع سهم بسعر محدد خلال فترة محددة)",
 "じしゃが": "مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "じしゃく": "مَغْنَاطِيس / بُوصُّلَة (البُوصَلَة أو البَوصَلَة : أَدَاة تسمَح بتحديد الاتجاهات)",
 "じしゃくばん": "بوصلة مغناطيسية (بوصلة تعتمد على مؤشر (مثل إبرة مغناطيسية) يشير إلى الشمال المغناطيسي)",
 "じしゃこう": "مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "じしゅ": "اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع بالاكتفاء الذاتي والقدرة على اتخاذ القرارات دون تدخل خارجي)\nمثال: الصحراويون يريدون الاستقلال. / اِسْتَسْلَمَ / اِسْتَسْلَام",
 "じしゅうしょ": "كريبج (لعبة ورق (عادة للاعبين اثنين) يتم فيها توزيع ست أوراق لكل لاعب ويتخلص من ورقة أو اثنتين) / المهملات (البطاقات التي يتخلص منها اللاعبون في لعبة الكريبج) / سرير أطفال, مهد (سرير أطفال ذو جوانب عالية مصنوعة من شرائح خشبية أو قضبان) / صومعة صغيرة, مخزن حبوب (صندوق أو مخزن لتخزين الحبوب)",
 "じしゅうしょう": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "じしゅかんり": "ذَاتِيُّ الفَرْض (فُرِضَ أَوْ تُحُمِّلَ طَوْعًا عَلَى النَّفْس)",
 "じしゅく": "تمالك النفس (إظهار التحفظ المفروض على الذات)\nمثال: اعتدال فعال في النقاش",
 "じしゅくけいさつ": "مُعَيَّن ذَاتِيًّا (عيّن نفسه بنفسه دون تفويض من جهة أخرى)",
 "じしゅけん": "اِسْتِقْلال, تَحَرُّر (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع بالاكتفاء الذاتي والقدرة على اتخاذ القرارات دون تدخل خارجي)\nمثال: الصحراويون يريدون الاستقلال.",
 "じしゅせい": "اِسْتِقْلال, تَحَرُّر (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع بالاكتفاء الذاتي والقدرة على اتخاذ القرارات دون تدخل خارجي)\nمثال: الصحراويون يريدون الاستقلال.",
 "じしゅてき": "مُسْتَقِل, حُرّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
 "じしゅぼうえい": "ذَاتِيُّ التَّوْجِيه, مُسْتَقِلّ ((عَنِ الأَشْخَاصِ) حُرٌّ مِنَ السَّيْطَرَةِ وَالقُيُودِ الخَارِجِيَّةِ فِي الفِعْلِ وَالحُكْم)",
 "じしょ": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه) / مُعْجَم (المُنَقَّط بالسواد؛ أن تلوكه للأكل أو للخبرة) / قاموس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه)\nمثال: أي قاموس تعنيه؟ / مُمْتَلَكَات, تَرِكَة / تركة / تَوْقِيع, إِمْضَاء (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ) / تَوْقِيع (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم.",
 "じしょう": "وَاقِعَة, حَادِثَة (مؤنث الوَاقِع، اسم فاعل للشيء المؤنث الذي وَقَعَ؛ مؤنث وَاقِع، الأمر المؤنث الحاصل)\nمثال: الصخور الواقعة تشكل خطرا على المتسلقين. / مُنَصِّبٌ نَفْسَهُ (يصف نفسه بصفة ما دون تأييد من الآخرين) / مُتَكَلِّم / سُرِّيَة",
 "じしょうぎ": "مأزق",
 "じしょうこつ": "عظيمات السمع (عظيمات الأذن الوسطى التي تنقل الاهتزازات الصوتية من طبلة الأذن إلى الأذن الداخلية)",
 "じしょうのちへいせん": "أُفُق اَلْحَدَث ((أَفِقَ) أفَقَاً: بلغ النِّهَايَة فِي الْكَرم وَالْعلم فَهُوَ أفق وأفيق)\nمثال: طلعت الشمس فوق الأفق.",
 "じしょうのちへいめん": "أُفُق اَلْحَدَث ((أَفِقَ) أفَقَاً: بلغ النِّهَايَة فِي الْكَرم وَالْعلم فَهُوَ أفق وأفيق)\nمثال: طلعت الشمس فوق الأفق.",
 "じしょがく": "علم المعجم, لكسيكولوجيا (فرع اللسانيات الذي يدرس المكون المعجمي للغة)",
 "じしょく": "اِسْتِقَالَة, اِسْتِعْفَاء / ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / إخصاب ذاتي (إخصاب عن طريق اتحاد الأمشاج الذكرية والأنثوية من نفس الفرد)",
 "じしょくねがい": "اِسْتِقَالَة, اِسْتِعْفَاء",
 "じしょけい": "لَيمَّا ((في علم اللسانيات) الشكل المعجمي القانوني للكلمات التي تتشارك في المعنى عينه…)",
 "じしょこうげき": "هجوم المعجم",
 "じしょぶもん": "معجم ذهني, مفردات (معرفة مستخدم اللغة بالكلمات) / قاموس, معجم (كتاب مرجعي يحتوي على قائمة أبجدية بالكلمات مع معلومات عنها)",
 "じしょへんしゅう": "صناعة المعاجم, معجمية (فعل تأليف القواميس)",
 "じしょへんしゅうしゃ": "معجمي, واضع المعاجم (جامع أو كاتب القاموس؛ دارس للمكون اللفظي للغة)",
 "じしょるい": "قَامُوس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه) / مُعْجَم (المُنَقَّط بالسواد؛ أن تلوكه للأكل أو للخبرة) / قاموس (اَلْبَحْر ٱلْعَظِيم، البحْرُ ٱلْكَبِير، ٱلْمُحِيط؛ قَعْر البَحْرِ أو أَعْمَق نقطَة فيه)\nمثال: أي قاموس تعنيه؟",
 "じしん": "رجل حاشية (مرافق في بلاط الحاكم) / النزعَة إلى الخير / نِوَاة / ثِقَة بِالنَّفْس / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / زَلْزَال, زِلْزال (فِي : ظاهرة طبيعية وهو اهتزاز أو سلسلة من الاهتزازات الارتجاجية المتتالية لسطح تحدث في وقت لا يتعدى ثواني معدودة…)\nمثال: دمر زلزال عيادة سامي. / ازدواجية, تعامل بوجهين (التصرف بسوء نية؛ الخداع بالتظاهر بامتلاك مجموعة من النوايا بينما يتصرف تحت تأثير أخرى) / احتيال, ازدواجية (تمثيل احتيالي أو مزدوج) / إبرة مغناطيسية (مغناطيس رفيع معلق في بوصلة مغناطيسية على حامل باحتكاك قليل؛ يستخدم للإشارة إلى اتجاه القطب المغناطيسي للأرض) / عَقْرَب سَاعَات / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "じしんかじょう": "مَغْرُور, مُفْرِط الثِّقَة (يتّسم بثقة مفرطة تتجاوز الحدّ المعقول)",
 "じしんがく": "عِلْم اَلزَّلَازِل (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "じしんがくしゃ": "عالم زلازل (جيوفيزيائي يدرس الزلازل والخصائص الميكانيكية للأرض)",
 "じしんきしょう": "سيزموجرام, مخطط زلزالي (السجل البياني لهزة أرضية تم إجراؤه باستخدام جهاز قياس الزلازل)",
 "じしんぎ": "أداة توقيت, ساعة (أداة قياس أو جهاز لحفظ الوقت) / كرونومتر, مقياس الزمن (ساعة دقيقة (تستخدم بشكل خاص في الملاحة))",
 "じしんけい": "جهاز قياس الزلازل, سيسموجراف (أداة قياس للكشف عن وقياس شدة واتجاه ومدة حركات الأرض (مثل الزلزال))"
}
