 "しゅんっ": "بِسُرْعَة, عَاجِلًا",
 "しゅんでい": "وَحْل (الخوض في الوَحَل؛ لغة رديئة من وَحَل؛ وهو الطين الخفيف الذي فيه ماء كثير) / سلاش\nمثال: علقت السيارة في الوحل.",
 "しゅんと": "بِإِحْبَاط, بِاكْتِئَاب (بطريقة مكتئبة)\nمثال: عندما عادت كانت صوفي وإستر تجلسان باكتئاب في المطبخ",
 "しゅんどう": "مُتَعَرِّج, مُتَلَوٍّ (يتحرك بطريقة ملتوية كحركة الأفعى أو الدودة) / مُنَاوَرَة, تَدْرِيب عَسْكَرِيّ",
 "しゅんばつ": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو نوعه) / فَرِيد, نَادِر (يتميز بجودة غير مألوفة؛ خاصة من الدرجة العليا أو المتطرفة في نوعه)\nمثال: طيور غير شائعة",
 "しゅんぱつ": "آنِيّ, لَحْظِيّ (يَحْدُث بِدُون أَيّ تَأْخِير)",
 "しゅんびん": "سَرِيع البَدِيهَة (ذكي وسريع الحيلة ذهنياً)",
 "しゅんぶん": "اعتدال ربيعي ((في الفلك) نقطة الاعتدال التي تقع في كوكبة الحوت) / اعتدال ربيعي (الوَسَطِيَّة، يقابله التَطَرُّف؛ التَنَاسُب وأن يكون الأمر عَدْلا، يقابله الاِنْقِلاب)\nمثال: الاعتدال هو اليوم الذي يتساوى به الليل و النهار بنفس المدة.",
 "しゅんぶんてん": "اعتدال ربيعي ((في الفلك) نقطة الاعتدال التي تقع في كوكبة الحوت) / اعتدال ربيعي (الوَسَطِيَّة، يقابله التَطَرُّف؛ التَنَاسُب وأن يكون الأمر عَدْلا، يقابله الاِنْقِلاب)\nمثال: الاعتدال هو اليوم الذي يتساوى به الليل و النهار بنفس المدة.",
 "しゅんぶんのひ": "اعتدال ربيعي ((في الفلك) نقطة الاعتدال التي تقع في كوكبة الحوت) / اعتدال ربيعي (الوَسَطِيَّة، يقابله التَطَرُّف؛ التَنَاسُب وأن يكون الأمر عَدْلا، يقابله الاِنْقِلاب)\nمثال: الاعتدال هو اليوم الذي يتساوى به الليل و النهار بنفس المدة.",
 "しゅんぷ": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "しゅんぷく": "السَّنَة الْجَدِيدَة",
 "しゅんぼく": "عَزْم / لَحْظَة, دَقِيقَة",
 "しゅんまく": "جفن ثالث, غشاء راف (طية واقية من الجلد في عيون الزواحف والطيور وبعض الثدييات)",
 "しゅんみん": "نَوْم عَمِيق (بكافة معانيه)\nمثال: لم أستطع النوم.",
 "しゅんもく": "رفة عين, رمش (منعكس يغلق ويفتح العينين بسرعة) / عَزْم / لَحْظَة, دَقِيقَة",
 "しゅんよう": "ربيع (موسم النمو)\nمثال: البراعم الناشئة كانت علامة أكيدة على الربيع",
 "しゅんれつ": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع)",
 "しゅん烈": "جَسِيم, خَطِير (يُثير الخوف أو القلق بتهديده بأذى عظيم) / حَادّ, وَخِيم (سيء جداً في درجته أو مداه) / إسْبَرْطِيّ, شَدِيد (لا يرحم ولا يتهاون في الانضباط أو الحكم) / فَظِيع, وَخِيم (بَالِغُ السُّوءِ أَوِ الفَظَاعَةِ فِي الدَّرَجَةِ أَوِ النَّوْع)",
 "しゅキー": "ماستر كي, مفتاح رئيسي (مفتاح يؤمن الدخول في كل مكان)",
 "しゅー": "أَزِيز, فَحِيح / هَفَّ, فَحَّ",
 "しゆ": "زيت ثابت (زيت حيواني أو نباتي غير متطاير)",
 "しゆい": "فِكْر, فِكْرَة (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي)) / فِكْر, تَفْكِير (أَعْمَلَ عقله ليصل إلى شيءٍ، ليحل مشكلةً. (يتعدى تعدية عامة بفي))\nمثال: إنها فكرة جيدة.",
 "しゆう": "مَدِينَة, بَلَد",
 "しゆうかんべつ": "جِنْس (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا) / جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: أنا مثلي الجنس.",
 "しゆうざいさん": "مِلْكِيَّة خَاصَّة",
 "しゆうざいさんせい": "مِلْكِيَّة خَاصَّة",
 "しゆうせい": "جِنْسِيَّة (مؤنث الجنسي، المنتسبة إلى الجنس؛ حالة الجنس أو ماهيته) / جِنْس, هُوِيَّة جِنْسِيَّة (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا)\nمثال: لديه الجنسية الأوكرانية.",
 "しゆうち": "أرض, إقليم (إقليم تمارس عليه السيادة أو السيطرة) / إقطاعية, ضيعة (ممتلكات واسعة من الأراضي (خاصة في الريف) يحتفظ بها المالك لاستخدامه الخاص)\nمثال: امتد نطاق حكمه إلى أوروبا",
 "しゆうどうたい": "ازدواجية الجنس, خنوثة (إظهار خصائص كلا الجنسين) / خنثى, خنثية (حالة خلقية تمتلك فيها الأعضاء التناسلية الخارجية والأعضاء الجنسية الداخلية خصائص ذكورية وأنثوية)",
 "しゆうをけっする": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "しゆうモザイク": "خنثى (شخص يمتلك خصائص وأعضاء جنسية ذكرية وأنثوية؛ ولا يمكن تحديد جنسه بشكل قاطع عند الولادة)",
 "しょ": "مُخْتَلِف, مُتَنَوَّع / كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء. / إِذَاعَة, مَحَطَّة إِذَاعِيَّة / حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد. / قيظ / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / فاجرا (صاعقة إندرا) / تَفْسِير, شَرْح",
 "しょあたり": "ضربة شمس, فرط الحرارة (انهيار ناتج عن التعرض للحرارة المفرطة)",
 "しょい": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / مَثَّلَ (الشَبَه؛ النَظِير) / تَصَرَّفَ\nمثال: المهم هو العمل. / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "しょいかわ": "مِقْلَاع / حَمَّالَة",
 "しょいん": "غرفة الاستقبال الرسمية, غرفة الصالون (غرفة رسمية يمكن فيها استقبال الزوار والترفيه عنهم) / غرفة صالون, مقصورة قطار خاصة (مقصورة خاصة في عربة النوم بها ثلاثة أسرّة ومرحاض) / دَار نَشْر, نَشْر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار. / عضو هيئة, موظف (موظف يكون عضواً في هيئة عاملين (خاصة عضو في الطاقم الذي يعمل لرئيس الولايات المتحدة)) / دودة كتب (شخص يقضي وقتاً طويلاً في القراءة) / متحذلق, متفيهق (شخص يولي اهتماماً مفرطاً للقواعد الرسمية والمعرفة الكتبية أكثر مما تستحق) / ببليومانيا, هوس الكتب (انشغال باكتساب وامتلاك الكتب)",
 "しょう": "خَارِج قِسْمَة, خَارِج / شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل. / سلالة شانغ, شانغ (السلالة الإمبراطورية التي حكمت الصين من حوالي القرن الثامن عشر إلى القرن الثاني عشر قبل الميلاد) / مَرَض, دَاء (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي. / اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟ / شُهْرَة / فَصْل (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / بَاب (ما يُسَدُّ به مَدْخَل المَبْنَى أو الغُرْفَة أو المَرْكَبَة؛ (تعميم) مَدْخَل أي شيء؛ فُتْحَة)\nمثال: اقرأ هذا الفصل. / مِيدَالِيَة, مِِيدَالْيَة / صُورَة, شَكْل / اِسْتِمَارَة / شَكَّلَ ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: اجلس بشكل مريح. / سَلِيبَة / غَنِيمَة / جَائِزَة, مُكَافَأَة / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة. / رَاحَة, كَفّ / مرسوم إمبراطوري (مرسوم يصدره حاكم ذو سيادة) / جَرَس, نَاقُوس (جَرَسَ الطَّائِرُ: صَوَّتَ؛ جَرَسَ الكَلاَمَ: نَغَمَ بِهِ وَتَكَلَّمَ)\nمثال: ياني يرن الجرس. / آمِر, مُقَدَّم / مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة. / ريشة حرة (ريشة لا تنطبق تماماً فوق الفتحة) / وِزَارَة / وِلَايَة, مُقَاطَعَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى)\nمثال: كان زيري من ولاية أخرى. / خَصْم, حَسْم (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة) / مُدَخَرَات / صِغَر (جعل الشيء أصغر حجمًا أو أقل قيمة؛ قلل من أهمية شخص أو شيء أو استهان به)\nمثال: الصغر أسرع من النسر / بَوْل / مدرسة ابتدائية (مدرسة للأطفال الصغار؛ عادة ما تكون الصفوف الستة أو الثمانية الأولى) / أَصْغَر (صغير نسبةً إلى شيء آخر) / حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة! / صَغِير, صغير / مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى / تَرْتِيلَة, تَرْنِيمَة / قِسِّيس, دَاعِيَة (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ) / وَزِير, وَزِيرَة / قصر ريفي, مانور (قصر لورد أو شخص ثري) / عزبة السيد, قصر ريفي (الضيعة المملوكة لسيد إقطاعي (بما في ذلك المنزل الموجود عليها)) / نبذة – مقتطفات من / تذييل, تعليق (عملية إضافة ملاحظات) / حاشية, ملاحظة (تعليق أو تعليمات (تضاف عادة))\nمثال: أضيفت ملاحظاته في نهاية المقال / بَنْكْنُوت, وَرَقَة نَقْدِيَّة / بِالضَّبْط, تَمَامًا / بِالْضَبْط / صَحِيح, صَوَاب / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: صحح نطقي من فضلك. / أَكْبَر, كُبْرَى (الأَكْبَر: هو ما فاق غيره في الكُبْر، ويكون ذلك إما بالحجم أو المقام أو كلاهما؛ للكُبْر)\nمثال: إنه أخي الأكبر. / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير. / طَبِيعَة, طبيعة / نَوْعِيَّة, جَوْدَة / رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال. / سَيِّدَة / خَلِيلَة, عَشِيقَة / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / صَوْت, صوت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة) / صَوَّت (أكثر من إحداث الصوت؛ بالغ في إحداث الصوت؛ في : صاح نوحا أو استغاثة)\nمثال: اقرأ بصوت عالي. / نَغْمَة, نَغْم / إِجْهَاد / فَأل, نَذِيْر / شَعَاب / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / صَانِع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة) / حِرَفِيّ / حِرْفِيّ\nمثال: أحب أن أكون صانع محتوى. / بُرْهَان, دَلِيل / شَهَادَة / تَنْوِير / عَرَض, عَلَامَة (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / عَرَض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "しょうあい": "تَفَرُّغ",
 "しょうあく": "جَشِع, حَرِيص (شديد الرغبة بشكل مفرط في اكتساب الثروة وغيرها) / إمساك, قبض (فعل الإمساك بشيء بإحكام باليدين) / محاولة الفهم (الفهم بصعوبة)\nمثال: كانت المحاضرة تتجاوز أقصى محاولاته للفهم",
 "しょうあつき": "جرعة داعمة, جرعة معززة (جرعة إضافية للتأكد من فعالية الجرعة الأولى) / صاروخ معزز, معزز الإقلاع (المرحلة الأولى من صاروخ متعدد المراحل) / محطة تقوية, معزز (مضخم لاستعادة قوة الإشارة المرسلة) / سارق متاجر (لص يسرق البضائع الموجودة في متجر)",
 "しょうあつざい": "رافع ضغط الدم, مُقَبِّض وعائي (أي عامل يسبب تضيق الأوعية وارتفاع ضغط الدم (يُفهم عادة على أنه زيادة الضغط الشرياني))",
 "しょうあつやく": "رافع ضغط الدم, مُقَبِّض وعائي (أي عامل يسبب تضيق الأوعية وارتفاع ضغط الدم (يُفهم عادة على أنه زيادة الضغط الشرياني))",
 "しょうあん": "نترات الأمونيوم (تستخدم كمتفجرات وسماد ووقود للصواريخ)",
 "しょうい": "جُرْح, جِرَاحَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح. / ملازم ثان (ضابط مفوض في الجيش أو القوات الجوية أو المارينز يحمل أدنى رتبة) / لجنة فرعية (مجموعة فرعية من أعضاء لجنة منظمة لغرض محدد)",
 "しょういいんかい": "لجنة فرعية (مجموعة فرعية من أعضاء لجنة منظمة لغرض محدد)",
 "しょういき": "سُوق (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "しょういだん": "قنبلة حارقة (قنبلة مصممة لإشعال الحرائق؛ وهي أكثر فعالية ضد الأهداف القابلة للاشتعال (مثل الوقود))",
 "しょういん": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "しょういんしん": "الشفران الصغيران (الطيتان الداخليتان للفرج)",
 "しょうう": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة\nمثال: 昨日は小雨だった。 — أمطرت مطراً خفيفاً البارحة.",
 "しょううちゅう": "صورة مصغرة, كون مصغر (نموذج مصغر لشيء ما)",
 "しょううん": "اِزْدِهَار, رَخَاء / نقل سريع (نظام نقل عام حضري يستخدم قطارات تحت الأرض أو مرتفعة)",
 "しょうえい": "تمجيد, ذوكسولوجيا (ترنيمة أو آية في الليتورجيا المسيحية تمجد الله) / صُورَة / بُورْتْرِيَّة",
 "しょうえき": "عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟",
 "しょうえきほう": "حويصلة, كيس (كيس صغير طبيعي تشريحياً أو بنية شبيهة بالمثانة (خاصة تلك التي تحتوي على سائل))",
 "しょうえん": "قصر ريفي, مانور (قصر لورد أو شخص ثري) / عزبة السيد, قصر ريفي (الضيعة المملوكة لسيد إقطاعي (بما في ذلك المنزل الموجود عليها)) / وَلِيمَة, مَأْدُبَة (طعام العُرْس؛ أي طعام صنع لدعوة ولجمع كبير من الناس)\nمثال: كانت الوليمة من أطيب ما ذقت. / دواء مضاد للالتهاب, مضاد للالتهاب (دواء يهدف إلى تقليل الالتهاب)",
 "しょうえんざい": "دواء مضاد للالتهاب, مضاد للالتهاب (دواء يهدف إلى تقليل الالتهاب)",
 "しょうえんじ": "دودة قرمزية",
 "しょうえんはんのう": "تَفَاعُل كِيمِيَائِيّ (فلان وفلان: أثّر كلّ منهما في الآخر؛ مع الشيء: تأثّر به) / استجابة الجلد الجلفانية (تغير في الخصائص الكهربائية للجلد استجابة للتوتر أو القلق)",
 "しょうおう": "مُرَاسَلَة",
 "しょうおく": "كُوخ, تَخْشِيبَة",
 "しょうおん": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ! / مُدَفِّئ, مُسَخِّن (يُنتِج إحساساً بالحرارة عند وضعه على الجسم) / مُدْفِئ (يمنح الدفء والحرارة) / دفء, ذوبان الجليد (طقس دافئ يعقب التجمد؛ يذوب فيه الثلج والجليد) / تدفئة, تسخين (عملية التحول إلى الدفء؛ ارتفاع درجة الحرارة)\nمثال: رحبوا بذوبان الجليد الربيعي",
 "しょうおんき": "كاتم, مخمّد (جهاز يقلل من سعة التذبذبات الإلكترونية أو الميكانيكية أو الصوتية أو الديناميكية الهوائية) / كوفية, لفحة (وشاح يلبس حول الرقبة) / كاتم صوت (جهاز صوتي أنبوبي يدرج في نظام العادم مصمم لتقليل الضوضاء)",
 "しょうおんそうち": "كَاتِم, كَاتِم الصَّوْت",
 "しょうか": "تَاجِر, تَاجِرَة / تِجَارَة / غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: عادت إلى الغناء. / تبلور (تركيب ذهني يصبح ثابتاً أو ملموساً بعملية تشبه تكوين البلورات) / بِلَّوْرَة, كْرِيسْتَال (صخر يتكون من تصلب مادة ما؛ له هيكل داخلي متكرر بانتظام؛ وأوجه مستوية خارجية) / بلورة, تبلور (تشكل البلورات) / هَضْم / اِسْتِهْلَاك / ذهاباً وإياباً, صعوداً وهبوطاً (التحرك للخلف وللأمام على طول مسار معين) / صُعُودًا وَهُبُوطًا, مِنْ أَعْلَى إلى أَسْفَل (بالتبادل بين الاتجاهين العلوي والسفلي)\nمثال: مشى ذهاباً وإياباً في غرفة تبديل الملابس / تسامي ((في علم النفس) تعديل التعبير الطبيعي عن دافع أو غريزة (خاصة الجنسية) إلى تعبير مقبول اجتماعياً) / تسامي ((في الكيمياء) تغير مباشر من الحالة الصلبة إلى الغازية دون المرور بالحالة السائلة) / تُوت, حَبَّة / بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت. / صَيْف, صيف (فصل من فصول السنة الأربعة، يلي الرَّبِيع ويأتي بعده الخَرِيف، يتميز بشدة الحَرّ)\nمثال: نأتي هنا كل صيف. / نَشِيد, نَشِيد وَطَنِيّ / نترجة (أكسدة مركبات الأمونيوم في المواد العضوية الميتة إلى نترات ونيتريت بواسطة بكتيريا التربة (مما يجعل النيتروجين متاحاً للنباتات)) / نترتة (العملية الكيميائية التي تضاف فيها مجموعة نيترو إلى مركب عضوي (أو تحل محل مجموعة أخرى في مركب عضوي)) / زهيرة (زهرة صغيرة (خاصة تلك التي تكون جزءًا من زهرة مركبة))",
 "しょうかい": "بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم / استفسار, تحقيق (تحقيق منهجي في مسألة ذات اهتمام عام) / بحث, تحقيق (بحث عن المعرفة) / استجواب, استفسار (حالة من السؤال أو الاستفسار)\nمثال: تستحق فخارياتهم بحثاً أكثر مما تلقته / اِسْتِعْلام (يُقال:اِسْتَعْلِمْ لي خبر فلان وأَعْلِمِنِيه حتى أَعْلَمَهُ، واسْتَعْلَمَنِي الخبَرَ فَأَعْلَمْتُهُ إيّاهُ؛ اِسْتَعْلَمَ يَسْتَعْلِمُ اِسْتِعْلَاماً: فهو مُسْتَعْلِم والمفعول مُسْتَعْلَم) / مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف) / دَوْرِيَّة, خَفْر / دَوْرِيَّة / عُقدة, مقبض دائري (مقبض مستدير الشكل) / عقدة, مقبض (نتوء أو بروز دائري مستدير) / مقبض مزخرف (زخرفة على شكل كرة على مقبض السيف أو الخنجر) / تغلظ, عقدة (أي تضخم سميك) / طوب محروق, كلينكر (طوب صلب يستخدم كحجر رصف) / خَبَث الفحم, رَمَاد خَشِن (بقايا غير قابلة للاحتراق تُترك بعد حريق الخشب أو الفحم أو الفحم النباتي)",
 "しょうかいきじ": "إِيذَان, إِعْلَان",
 "しょうかいきょう": "جسر قلاب, جسر متحرك (جسر يمكن رفعه لقطع الطريق أو للسماح للقوارب أو السفن بالمرور تحته)",
 "しょうかいげんご": "لُغَةَ الاِسْتِعْلَام (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "しょうかいさき": "مَرْجِع",
 "しょうかいじょ": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "しょうかいてい": "سفينة دورية, قارب دورية (سفينة مخصصة للقيام بدوريات في منطقة ما)",
 "しょうかえき": "عصارة هضمية (إفرازات تساعد على الهضم)",
 "しょうかかん": "جهاز هضمي, قناة هضمية (ممر أنبوبي من الغشاء المخاطي والعضلات يمتد حوالي 8.3 متر من الفم إلى الشرج؛ وظيفته الهضم والإخراج)",
 "しょうかかんかんしつしゅよう": "لُبّ",
 "しょうかき": "سِلَاح نَارِيّ / مِطْفَأَةُ حَرِيق, طَفَّايَةُ حَرِيق",
 "しょうかきがく": "طب الجهاز الهضمي (فرع الطب الذي يدرس الجهاز الهضمي وأمراضه)",
 "しょうかく": "تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة",
 "しょうかくじんじ": "تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة",
 "しょうかけい": "جِهَاز هَضْمِيّ",
 "しょうかこう": "تَعْرِيجَة, سَاق / سُوَيْق",
 "しょうかざい": "هَضْمِيّ / جِهَاز هَضْمِيّ",
 "しょうかしゅう": "كتاب أغاني (كتاب يحتوي على مجموعة من الأغاني)",
 "しょうかせいかいよう": "قرحة هضمية",
 "しょうかせん": "صُنْبُور حَرِيق, صُنْبُور اِطْفَاء حَرِيق / غدة هضمية (أي غدة لها قنوات تصب إفرازاتها في القناة الهضمية) / غُدَّة صَنَوْبَرِيَّة, جِسْم صَنَوْبَرِيّ",
 "しょうかたい": "صَنَوْبَرِيّ (ذو شكل يشبه كوز الصنوبر) / صنوبري (متعلق بالجسم الصنوبري (الغدة الصنوبرية))\nمثال: هرمون صنوبري",
 "しょうかち": "سُكَّرِيّ, دِيَابِيطَا / سَيَلَان",
 "しょうかっこ": "حشو",
 "しょうかつ": "خُلَاصَة, مُلَخَّص / سُكَّرِيّ, دِيَابِيطَا / سَيَلَان",
 "しょうかねつ": "حرارة التسامي (حرارة تمتصها وحدة كتلة من مادة عندما تتغير من حالة صلبة إلى غازية)",
 "しょうかふりょう": "عُسْر الهَضَم, تُخْمَة (جعَل شيئًا صعبًا أو أكثر تعقيدًا؛ وضع عوائق أو صعوبات أمام أمرٍ ما)\nمثال: إن مع العسر يسرا. / غَيْرُ مُكْتَمِلِ النُّضْج, نَاقِصُ الطَّهْو (لَمْ يُطْهَ بِالقَدْرِ الكَافِي) / أَحْمَق, طَائِش (سخيف وعديم الجدوى تماماً)",
 "しょうかへい": "تَعْرِيجَة, سَاق / سُوَيْق",
 "しょうかめん": "نترات السليلوز, نيتروسليلوز (إستر لحمض النيتريك؛ يستخدم في الورنيش والمتفجرات)",
 "しょうかん": "استرداد, سداد (عملية إعادة الأموال المستلمة سابقاً) / إبراء ذمة, تسديد (دفع دين أو التزام) / اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له. / استجلباب, استحضار (استدعاء قوى خارقة مفترضة عن طريق التعاويذ والرقى) / ٱسْتَدْعى / تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / سَحْبٌ (سحب أو جذب شيئًا باتجاهه أو بعيدًا عنه؛ أزال أو سحب شيء من مكانه)\nمثال: ليلى تذكر سامي. / بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم / عَامّ / عُمُومِيّ, عَامّ / جِنِرال, فريق أوّل / ركود, هدوء مؤقت (فترة من الطقس الهادئ) / فترة هدوء, هوداة (توقف تكون فيه الأمور هادئة أو الأنشطة متناقصة)\nمثال: كان هناك هدوء مؤقت في العاصفة / تَقْدِير / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت. / سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات / قنية (قناة أو مجرى صغير كما في بعض العظام وأجزاء النباتات)",
 "しょうかんぎむしゃ": "كَافِل",
 "しょうかんじょう": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له.",
 "しょうが": "غِنَاء (مصدر للفعل \"غَنَّى\"؛ استعمال الصوت البشري لصنع أصوات موسيقية)\nمثال: عادت إلى الغناء. / زَنْجَبِيل / أَصْهَب / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "しょうがい": "جُرْح, إِصَابَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح. / عَلَاقَات عَامَّة / عَقَبَة, حَاجِز / إعاقة, عجز (حالة عدم القدرة على الأداء نتيجة لعدم اللياقة البدنية أو العقلية)\nمثال: إعاقة القراءة / سباق قفز الموانع (سباق خيل عبر مضمار مليء بالعوائق) / سباق الموانع (سباق جري عادة لمسافة 3000 متر عبر مضمار مغلق مع حواجز وقفزة مائية) / سباق الحواجز, سباق العقبات (سباق يجب على المنافسين فيه تجاوز العقبات) / حَياة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ما أغرب الحياة! / اِنْتَحَرَ",
 "しょうがいい": "حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط",
 "しょうがいがかり": "رجل علاقات عامة (رجل موظف لترتيب الدعاية (لشركة أو شخصية عامة))",
 "しょうがいきょういく": "تعليم مستمر (برنامج تعليمي مصمم بشكل أساسي للطلاب البالغين الذين يشاركون بدوام جزئي)",
 "しょうがいきょうそう": "سباق قفز الموانع (سباق خيل عبر مضمار مليء بالعوائق) / سباق الموانع (سباق جري عادة لمسافة 3000 متر عبر مضمار مغلق مع حواجز وقفزة مائية)",
 "しょうがいしほう": "قَانُون دُوَلِيّ خَاصّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "しょうがいしゃさべつ": "اَلتَّمْيِيزُ ضِدَّ ٱلْمُعَاقِينَ",
 "しょうがいじ": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "しょうがいそう": "سباق الحواجز (سباق جري يجب على المتسابقين فيه اجتياز سلسلة من الحواجز)",
 "しょうがいちし": "قتل خطأ, قتل غير متعمد (قتل دون سبق إصرار وترصد)",
 "しょうがいぶ": "عَلَاقَات عَامَّة",
 "しょうがいぶつ": "عَقَبَة, حَاجِز",
 "しょうがいぶつきょうそう": "سباق الحواجز, سباق العقبات (سباق يجب على المنافسين فيه تجاوز العقبات)",
 "しょうがいをとじる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "しょうがく": "مدرسة ابتدائية (مدرسة للأطفال الصغار؛ عادة ما تكون الصفوف الستة أو الثمانية الأولى) / حُرُوف صِينِيَّة تَقْلِيدِيَّة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟",
 "しょうがくきん": "مِنْحَة دِرَاسِيَّة, إِعَانَة دِرَاسِيَّة",
 "しょうがくせい": "مدرسة ابتدائية (مدرسة للأطفال الصغار؛ عادة ما تكون الصفوف الستة أو الثمانية الأولى)",
 "しょうがくぶ": "مدرسة ابتدائية (مدرسة للأطفال الصغار؛ عادة ما تكون الصفوف الستة أو الثمانية الأولى)",
 "しょうがしょうゆ": "صَلْصَةْ اَلصُّويَا",
 "しょうがっきん": "مِنْحَة دِرَاسِيَّة, إِعَانَة دِرَاسِيَّة",
 "しょうがっこう": "مَدْرَسَة اَلاِبْتِدَائِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "しょうがっこうく": "مَدْرَسَة اَلاِبْتِدَائِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "しょうがつ": "السَّنَة الْجَدِيدَة / يَنَايِر, كَانُون اَلثَّانِي (الشهر الأول من السنة الروميّة)\nمثال: لتبدأ الاحتفالات بيناير.",
 "しょうがつかざり": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "しょうがつやすみ": "السَّنَة الْجَدِيدَة",
 "しょうがない": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب. / بدون جدوى / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه / غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية",
 "しょうがよい": "حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط",
 "しょうがん": "تَقْدِير",
 "しょうが醤油": "صَلْصَةْ اَلصُّويَا",
 "しょうき": "تَصَنُّع, تَكَلُّف / حُرُوف صِينِيَّة تَقْلِيدِيَّة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟ / رشاد, سلامة العقل (القوى الطبيعية أو السليمة للعقل) / غاز المستنقعات (غاز الميثان الناتج عن تحلل النباتات في الماء) / أكسيد النيتروز, غاز الضحك (مخدر استنشاقي يستخدم كمخدر في طب الأسنان والجراحة) / ميازما, وخم (أبخرة غير صحية تتصاعد من الأرض أو من مصادر أخرى) / جو فاسد, ميازما (جو غير صحي)\nمثال: وخم المستنقعات",
 "しょうきさん": "حُرُوف صِينِيَّة تَقْلِيدِيَّة (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حرف)\nمثال: كيف أتذكر الحروف الصينية؟",
 "しょうきとはおもえない": "مَجْنُون, مَخْبُول",
 "しょうきのさた": "تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة)",
 "しょうきますい": "أكسيد النيتروز, غاز الضحك (مخدر استنشاقي يستخدم كمخدر في طب الأسنان والجراحة)",
 "しょうきゃく": "استرداد, سداد (عملية إعادة الأموال المستلمة سابقاً) / إبراء ذمة, تسديد (دفع دين أو التزام) / إهلاك, انخفاض القيمة (انخفاض في السعر أو القيمة) / اسْتِخْفَاف, انْتِقَاص (تواصل يقلل من شأن شخص أو شيء ما) / إهلاك, استهلاك (انخفاض في قيمة أصل ما بسبب التقادم أو الاستخدام)\nمثال: انخفاض قيمة الدولار مقابل الين / إطفاء الدين, سداد بالتقسيط (دفع التزام في سلسلة من الأقساط أو التحويلات) / إطفاء الدين, إهلاك (تخفيض قيمة أصل ما عن طريق توزيع تكلفته على مدى سنوات) / تحريق, ترميد (عملية حرق شيء ما بالكامل؛ تحويله إلى رماد) / ضيف الشرف (الشخص الذي يُعقد التجمع تكريماً له) / شطب, محو (الحذف عن طريق الشطب أو المسح) / كشط, محو (منطقة سطح تم محو شيء منها) / شطب, محو (تصحيح يتم عن طريق المسح)\nمثال: تمت كتابة كلمة أخرى فوق المحو / رَدّ, مُعَامَلَة بِالمِثْل (عمل جماعي متبادل)\nمثال: في المقابل، أعطيناهم بقدر ما حصلنا عليه",
 "しょうきゃくばい": "رَمَاد, سَكَن / دَرْدَار",
 "しょうきゃくろ": "محرقة, مرمدة (فرن للحرق (خاصة للتخلص من النفايات))",
 "しょうきゅう": "تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة / أكمة, رابية (تل طبيعي صغير) / قطرة, كرية (كرة صغيرة)",
 "しょうきゅうけい": "أنبوب التنفس, سنوركل (ممر هوائي يوفره جهاز قابل للسحب يحتوي على أنابيب سحب وعادم؛ يسمح للغواصة بالبقاء تحت الماء لفترات طويلة) / فترة التقاط الأنفاس, متنفس (استراحة قصيرة)",
 "しょうきゅうし": "أنبوب التنفس, سنوركل (ممر هوائي يوفره جهاز قابل للسحب يحتوي على أنابيب سحب وعادم؛ يسمح للغواصة بالبقاء تحت الماء لفترات طويلة) / فترة التقاط الأنفاس, متنفس (استراحة قصيرة) / نَاجِذ, ضَاحِك",
 "しょうきょ": "شطب, محو (الحذف عن طريق الشطب أو المسح) / كشط, محو (منطقة سطح تم محو شيء منها) / شطب, محو (تصحيح يتم عن طريق المسح)\nمثال: تمت كتابة كلمة أخرى فوق المحو / حذف (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ؛ حَذَفَهُ بِالعَصَا: ضَرَبَهُ ، ورَمَاهُ بِها)\nمثال: حذف ياني حسابه. / اِنْقِرَاض / قَلِيلًا",
 "しょうきょう": "تبرج, مكياج (مستحضرات تجميل توضع على الوجه لتحسين أو تغيير المظهر) / بنية, تركيب (الطريقة التي يتكون بها شخص أو شيء ما) / اختبار تعويضي, حدث تعويضي (حدث يتم استبداله بحدث تم إلغاؤه مسبقاً)\nمثال: فاتته الاختبار واضطر لإجراء اختبار تعويضي",
 "しょうきょうきん": "صدرية صغرى (عضلة هيكلية تسحب لوح الكتف لأسفل أو ترفع الأضلاع)",
 "しょうきょうと": "بلدة صغيرة, قرية (مجتمع من الناس أصغر من بلدة)",
 "しょうきょく": "مَبْنِيٌّ لِلْمَجْهُول / زوال الاستقطاب (فقدان القطبية أو الاستقطاب) / كاثود, مهبط (قطب كهربائي سالب الشحنة وهو مصدر الإلكترونات التي تدخل جهازاً كهربائياً) / قطب موجب, كاثود (الطرف الموجب الشحنة لخلية فولتية أو بطارية تخزين يوفر التيار)",
 "しょうきょくせい": "سلبية (سمة البقاء غير نشط؛ نقص في المبادرة) / استسلام, سلبية (الخضوع للآخرين أو للمؤثرات الخارجية)",
 "しょうきょくてき": "سَلْبِيّ / سَلْبِيّ, سَالِب / مَنْفِيّ / سَالِب / صُورَة سَالِبَة",
 "しょうきょほう": "حذف (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ؛ حَذَفَهُ بِالعَصَا: ضَرَبَهُ ، ورَمَاهُ بِها)\nمثال: حذف ياني حسابه.",
 "しょうきん": "إصلاح الضرر, تعويض (شيء يتم فعله أو دفعه تكفيراً عن خطأ) / إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / تعويضات الحرب ((عادة بصيغة الجمع) تعويض يفرضه المنتصرون على دولة مهزومة) / إصلاح, جبر الضرر (تعويض (مُعطى أو مُستلم) عن إهانة أو إصابة)\nمثال: كيف يمكنني التكفير عن خطئي / جائزة مالية (أي أموال تُعطى كجائزة) / نَقْد, نُقُود / مسكوكات, نقود معدنية (العملات المعدنية مجتمعة) / إِعَانَة مَالِيَّة",
 "しょうきんかせぎ": "صَائِدُ ٱلْجَوَائِز",
 "しょうきんるい": "طائر خائض (أي من الطيور طويلة الساقين العديدة التي تخوض في الماء بحثاً عن الطعام)",
 "しょうぎ": "مُؤْتَمَر / دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد) / شُوغِي",
 "しょうぎいん": "محامي دفاع, مستشار قانوني (محامٍ يترافع في القضايا أمام المحكمة) / مرشد, ناصح (شخص يقدم المشورة بشأن المشكلات) / مشرف مخيم (شخص لديه واجبات إشرافية في مخيم صيفي)",
 "しょうぎょ": "تونا وثابة, وثابة (تونة محيطية تعيش في أسراب ذات قيمة كبيرة في المحيط الهادئ ولكن أقل في الأطلسي؛ تصل إلى 75 رطلاً؛ تشبه جداً بونيتو المحيط إن لم تكن هي نفسها)",
 "しょうぎょう": "تِجَارَة / سوترا (قاعدة أو قول مأثور في الأدب السنسكريتي أو مجموعة من الملخصات العقائدية)",
 "しょうぎょうか": "إضفاء الطابع التجاري, تسويق تجاري (فعل جعل الشيء تجارياً؛ إدخال شيء ما في التجارة)\nمثال: اعتبر والدي تحويل عيد الميلاد إلى مناسبة تجارية تدنيساً للمقدسات",
 "しょうぎょうぎんこう": "بنك تجاري, مصرف تجاري (مؤسسة مالية تقبل الودائع تحت الطلب وتقدم القروض وتوفر خدمات أخرى للجمهور)",
 "しょうぎょうくみあい": "جمعية, رابطة (رابطة رسمية لأشخاص لديهم اهتمامات مماثلة)\nمثال: انضم إلى نادي الجولف",
 "しょうぎょうしゅぎ": "تجارة, تجارية (المعاملات (البيع والشراء) التي تهدف إلى توفير السلع (البضائع والخدمات))",
 "しょうぎょうしんようじょう": "خطاب اعتماد تجاري (خطاب اعتماد يُعطى لمؤسسة تجارية لأغراض تجارية)",
 "しょうぎょうち": "المنطقة التجارية, حي تجاري (المنطقة المركزية أو المركز التجاري لبلدة أو مدينة)\nمثال: قلب وسط مدينة برمنغهام",
 "しょうぎょうちいき": "المنطقة التجارية, حي تجاري (المنطقة المركزية أو المركز التجاري لبلدة أو مدينة)\nمثال: قلب وسط مدينة برمنغهام",
 "しょうぎょうちゅうしんち": "وَسَطُ البَلَد",
 "しょうぎょうてがた": "ورقة تجارية (التزام قصير الأجل غير مضمون وغير مسجل يصدره مقترض مؤسسي للمستثمرين الذين لديهم نقد خامل مؤقتاً)",
 "しょうぎょうびじゅつ": "فن تجاري (فن يُستخدم لأغراض تجارية (كما في الإعلانات))",
 "しょうぎょうよう": "إِعْلَان تِجَارِيّ",
 "しょうぎょうれつしき": "صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة) / أصغر, أقلية (أقل في العدد أو الحجم أو المقدار) / بسيط, ثانوي (أقل في النطاق أو التأثير) / قاصر (لم يبلغ السن القانونية)\nمثال: حصة صغيرة من الأرباح",
 "しょうぎん": "بنك تجاري, مصرف تجاري (مؤسسة مالية تقبل الودائع تحت الطلب وتقدم القروض وتوفر خدمات أخرى للجمهور)",
 "しょうく": "فِقْرَة, بَنْد",
 "しょうくうとう": "كشاف ضوئي (مصدر ضوء بعاكسات يسقط شعاعاً من الضوء في اتجاه معين)",
 "しょうぐん": "عَامّ / عُمُومِيّ, عَامّ / جِنِرال, فريق أوّل / شُوغُون",
 "しょうぐんしょく": "استبدادية, دكتاتورية (شكل من أشكال الحكم يكون فيه الحاكم دكتاتوراً مطلقاً (غير مقيد بدستور أو قوانين أو معارضة وما إلى ذلك))",
 "しょうけい": "مجموع فرعي (مجموع جزء من مجموعة من الأرقام) / تولي, خلافة (اكتساب الممتلكات عن طريق النسب أو الوصية) / تتابع, تسلسل (فعل التتابع بالترتيب) / تسلسل, تعاقب (تتابع شيء بعد آخر في الوقت) / تتابع, تعاقب (مجموعة من الأشخاص أو الأشياء مرتبة أو متتابعة بالترتيب)\nمثال: لعب الأوراق الرابحة بالتسلسل / اختصار, طريق مختصر (طريق أقصر من الطريق المعتاد) / هيروغليفي (مكتوب بـ أو ينتمي إلى نظام كتابة يستخدم رموزاً تصويرية) / هيروغليفي الشكل (يشبه الكتابة الهيروغليفية) / كتابة هيروغليفية, هيروغليفية (نظام كتابة يستخدم رموزاً صورية؛ استُخدم في مصر القديمة) / كتابة هيروغليفية (كتابة تشبه الهيروغليفية (عادة لكونها غير مقروءة)) / بيكتوغراف, رمز تصويري (رمز رسومي يُستخدم في الكتابة التصويرية) / شَوْق (نزوعُ النَّفْس إِلى الشيء، أو تَعَلُّقها به؛ مصدر الفعل شَاقَ)\nمثال: سأشعر بالشوق إليك. / أنبوب التنفس, سنوركل (ممر هوائي يوفره جهاز قابل للسحب يحتوي على أنابيب سحب وعادم؛ يسمح للغواصة بالبقاء تحت الماء لفترات طويلة) / فترة التقاط الأنفاس, متنفس (استراحة قصيرة) / طَرِيق, صِرَاط (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / صِرَاط, مَسَار / مَحَجَّة\nمثال: أسأل عن الطريق.",
 "しょうけいもじ": "هِيرُوغْلِيفِيَّة",
 "しょうけつ": "انتشار, نشر (عملية الامتداد على نطاق أوسع أو مساحة من المكان أو الزمان) / إذاعة, نشر (فتح موضوع لمناقشة واسعة وجدل) / انتشار, تفشي (عملية أو نتيجة التوزيع أو الامتداد على مساحة واسعة من الفضاء)",
 "しょうけん": "رباط, وصلة تثبيت (وصلة تثبت الأشياء ببعضها البعض) / صفد, قيد (قيد يحد أو يقيد الحرية (خاصة شيء يستخدم لربط أو تقييد سجين)) / التصاق, تلاصق (خاصية الالتصاق معاً (كالغراء والخشب) أو انضمام أسطح مختلفة التكوين) / رابطة, رابطة كيميائية (قوة كهربائية تربط الذرات)\nمثال: الالتصاق المتبادل للخلايا",
 "しょうけんがいしゃ": "بيت وساطة, شركة وساطة (المكان الذي يدير فيه الوسيط أعماله) / سمسرة, وساطة (عمل السمسار؛ يتقاضى رسوماً لترتيب عقد بين طرفين) / شركة سمسرة, شركة وساطة مالية (أعمال سمسار الأوراق المالية؛ تتقاضى رسوماً للعمل كوسيط بين البائع والمشتري)",
 "しょうけんぎょうかい": "السوق, سوق الأوراق المالية (أسواق الأوراق المالية بشكل إجمالي)\nمثال: السوق دائماً ما يحبط المستثمر الصغير",
 "しょうけんぎょうしゃきょうかい": "السوق, سوق الأوراق المالية (أسواق الأوراق المالية بشكل إجمالي)\nمثال: السوق دائماً ما يحبط المستثمر الصغير",
 "しょうけんけいざいがっかい": "بانجو, عشب (أسماء دارجة للماريجوانا)",
 "しょうけんしじょう": "بورصة, سوق الأوراق المالية (بورصة يتم فيها تداول الأوراق المالية من قبل وسطاء الأسهم المحترفين)",
 "しょうけんとりひきいいんかい": "لجنة الأوراق المالية والبورصات (وكالة فيدرالية مستقلة تشرف على تداول الأوراق المالية لحماية المستثمرين)",
 "しょうけんとりひきじょ": "بُورْصَة, سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ",
 "しょうけんアナリスト": "محلل أوراق مالية, محلل مالي (محلل يدرس الأداء المالي للشركات)",
 "しょうげ": "عَقَبَة, حَاجِز",
 "しょうげき": "تأثير, تعدي (التأثير بقوة) / صَدْمَة, صِدَام (التفاعل العنيف بين الأفراد أو الجماعات التي تدخل في القتال) / ارتطام, صدمة (ضرب جسم لآخر) / تأثير, وقع (عاقبة قوية؛ تأثير قوي)\nمثال: استاءوا من طغيان القيم الأمريكية على الثقافة الأوروبية / صَدْمَة / صَعْقَة / صَعَقَ / فارس, مهزلة (كوميديا تتميز بالسخرية الواسعة والمواقف غير المحتملة) / حشوة مفرومة, فورس ميت (خليط من الدجاج النيئ المفروم والفطر مع الفستق والكمأة والبصل والبقدونس والكثير من الزبدة ويربط بالبيض)",
 "しょうげきけんりゅうけい": "جلفانومتر باليستي (جلفانومتر ذو ملف متحرك يقيس الشحنة الكهربائية)",
 "しょうげきじょう": "مسرح صغير (مسرح صغير للدراما التجريبية أو المجموعات الجامعية أو المجتمعية)",
 "しょうげきてき": "مُبِيد, مُدَمِّر (يَتَسَبَّبُ أَوْ يَقْدِرُ عَلَى التَّدْمِيرِ الكَامِلِ) / سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي التَّرْكِيبَاتِ) / سَاحِقٌ, مَاحِقٌ (يستخف بالآخرين ويحقرهم)",
 "しょうげきといふ": "الصدمة والترويع",
 "しょうげきは": "موجة صادمة",
 "しょうげきりょうほう": "علاج بالصدمة (علاج بعض الحالات الذهانية عن طريق إعطاء صدمات تتبعها تشنجات)",
 "しょうげきタービン": "توربين نبضي, عنفة دفعية (توربين يتم تشغيله بواسطة تدفقات نفاثة مباشرة ضد الشفرات)",
 "しょうげん": "شَهَادَة, إِفَادَة / زَيَّنَ, زَخْرَفَ (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع)\nمثال: زين سامي المكتب. / ربعية, مقياس الارتفاع (أداة قياس لقياس ارتفاع الأجرام السماوية) / ربع دائرة (المساحة المحصورة بين نصفي قطرين متعامدين لدائرة) / ربع (أي من المناطق الأربع التي ينقسم إليها المستوى بواسطة محوري إحداثيات متعامدين) / ربع دائرة (ربع محيط الدائرة) / مُفَتِّش, مُفَتِّشَة",
 "しょうげんぎ": "ربعية, مقياس الارتفاع (أداة قياس لقياس ارتفاع الأجرام السماوية) / ربع دائرة (المساحة المحصورة بين نصفي قطرين متعامدين لدائرة) / ربع (أي من المناطق الأربع التي ينقسم إليها المستوى بواسطة محوري إحداثيات متعامدين) / ربع دائرة (ربع محيط الدائرة)",
 "しょうげんしゃ": "شَهَادَة / شَاهِد, شَاهِدَة (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَاهِد, شَوَاهِد (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَهِدَ (شَهَدَ؛ شُهِدَ)\nمثال: شاهد هذا الفيلم.",
 "しょうげんだい": "منصة الشهود (مقصورة للشاهد عند الإدلاء بشهادته)",
 "しょうげんろくしゅ": "خلع, عزل (فعل عزل شخص ما؛ إزالة شخص قوي من منصب أو وظيفة) / إيداع, وضع (عملية وضع شيء ما في مكان ما) / إفادة, شهادة خطية ((قانون) استجواب تمهيدي لشاهد قبل المحاكمة؛ عادة ما يتم في مكتب محام) / ترسب, رواسب (العملية الطبيعية لترسب شيء ما)",
 "しょうこ": "دَلِيل, بُرْهَان / دَلِيل / تسمية المنشأ (مؤشر جغرافي يستخدم لتحديد المكان الذي يُزرع فيه العنب للنبيذ) / تسمية, لقب (كلمة أو كلمات تعريفية يُدعى بها شخص أو شيء ويُصنف أو يتميز بها عن الآخرين) / رسالة مهنية, مسار مهني (المهنة المحددة التي تدربت من أجلها)",
 "しょうこう": "ضابط مفوض, ضابط نظامي (ضابط عسكري يحمل تكليفاً رسمياً (مرسوماً)) / ركود, هدوء مؤقت (فترة من الطقس الهادئ) / فترة هدوء, هوداة (توقف تكون فيه الأمور هادئة أو الأنشطة متناقصة)\nمثال: كان هناك هدوء مؤقت في العاصفة / عَفْو, صَفْح / عَرَض, عَلَامَة (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / عَرَض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض. / إعياء, إنهاك (عملية استنفاد شيء ما بالكامل) / إعياء, إنهاك (ضعف خطير وفقدان للطاقة) / إجهاد شديد, إنهاك (تعب شديد) / اِنْقِرَاض / إخماد, إطفاء (فعل الإطفاء؛ التسبب في توقف الاحتراق)\nمثال: إطفاء الأنوار / المتسامي الآكل, كلوريد الزئبق (مادة بلورية بيضاء سامة قابلة للذوبان (ناتجة عن تسامي الزئبق)؛ تستخدم كمبيد للآفات أو مطهر أو مادة حافظة للخشب) / فغرة (فم أو فتحة تشبه الفم (خاصة تلك التي يتم إنشاؤها جراحياً على سطح الجسم لإنشاء فتحة لعضو داخلي)) / ثغر, مسام (مسام بشروي دقيق في ورقة أو ساق يمكن للغازات وبخار الماء المرور من خلاله) / فوهة (مسام صغير خاصة في الأجسام التكاثرية لبعض الطحالب والفطريات تمر عبرها الأبواغ)",
 "しょうこうかい": "غُرْفَةُ تِجَارَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "しょうこうかいぎしょ": "غُرْفَةُ تِجَارَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "しょうこうがく": "عِلْم اَلْأَعْرَاض (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "しょうこうき": "مِصْعَدْ",
 "しょうこうくみあいちゅうおうきんこ": "بَنْك مَرْكَزِيّ ((بَنَّكَ) الخدم: تحدَّثُوا بأسرار الْبيُوت)\nمثال: هي تعمل في بنك.",
 "しょうこうぐち": "دُخُول / مَدْخَل",
 "しょうこうぐん": "مُتَلَازِمَة, أَعْرَاض",
 "しょうこうし": "طفل مدلل (صبي مهذب ومتأنق بشكل مفرط)",
 "しょうこうしょ": "أَحْمَر, حُمْرَة (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا) / حَمْرَاء (مؤنث أَحْمَر؛ صفة لما كان لونها الحَمَار؛ ذوات الرايات الحمراء أو الحُمُر: عن المومسات) / أحمر (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا)\nمثال: أردت حذاء أحمر.",
 "しょうこうじょ": "قَلِيلًا",
 "しょうこうじょうたい": "ركود, هدوء مؤقت (فترة من الطقس الهادئ) / فترة هدوء, هوداة (توقف تكون فيه الأمور هادئة أو الأنشطة متناقصة)\nمثال: كان هناك هدوء مؤقت في العاصفة",
 "しょうこうだ": "مِصْعَدْ",
 "しょうこうちゅうきん": "بَنْك مَرْكَزِيّ ((بَنَّكَ) الخدم: تحدَّثُوا بأسرار الْبيُوت)\nمثال: هي تعمل في بنك.",
 "しょうこうてき": "حاصر",
 "しょうこうてん": "عقدة صاعدة (النقطة التي يتقاطع فيها المدار مع مستوى مسار الشمس متجهاً شمالاً)",
 "しょうこうねつ": "حمى قرمزية (مرض معد حاد (عادة عند الأطفال) يتميز بالحمى وطفح جلدي أحمر)",
 "しょうこきん": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي. / هَامِش",
 "しょうこく": "صَارِم",
 "しょうこしゅぎ": "كلاسيكية (حركة في الأدب والفن خلال القرنين السابع عشر والثامن عشر في أوروبا فضلت العقلانية وضبط النفس والأشكال الصارمة)\nمثال: غالباً ما استمدت الكلاسيكية نماذجها من اليونان والرومان القدماء",
 "しょうこしょるい": "وَثَائِق",
 "しょうこだてる": "بَرْهَنَ, أَثْبَتَ",
 "しょうこつ": "مُشْط الْيَد (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج. / عظم العقب, عظم الكعب (أكبر عظام الرصغ؛ يشكل كعب الإنسان) / حرق الجثث (ترميد جثة الميت) / رَمَاد, سَكَن / دَرْدَار",
 "しょうこひん": "دَلِيل, بُرْهَان / دَلِيل",
 "しょうこぶっけん": "دَلِيل, بُرْهَان / دَلِيل",
 "しょうこぶつ": "دَلِيل, بُرْهَان / دَلِيل",
 "しょうこり": "تَابَ (تَابَ: عادَ إِلى اللَّهِ ورَجَعَ وأَنَابَ؛ تابَ اللهُ عَلَيْهِ: أَي عادَ عَلَيْهِ بالمَغْفِرة)",
 "しょうこりもない": "عَنِيد",
 "しょうこりもなく": "بِإِصْرَار, بِعِنَاد (بتصميم عنيد)\nمثال: طاردها بإصرار",
 "しょうこん": "نَدْبَة, نَدْب / مُثَابَرَة",
 "しょうこんたくましい": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء.",
 "しょうご": "ظهر, ظَهِيرَة (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "しょうごう": "اسم تجاري, علامة تجارية (اسم يُعطى لمنتج أو خدمة) / تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / عُنْوَان (عُنْوَان) / عِنْوَان (عُنْوَان) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "しょうごうき": "آلة تجميع, مجمعة البطاقات (آلة تقوم باختيار ودمج ومطابقة مجموعات من البطاقات المثقوبة)",
 "しょうごん": "زَيَّنَ, زَخْرَفَ (في : تعني الحسن أي الوسيم، وتعني أيضا الشيء الرائع)\nمثال: زين سامي المكتب.",
 "しょうさ": "رَائِد / إثبات, تأكيد (دليل إضافي على أن شيئاً كان يُعتقد (حقيقة أو فرضية أو نظرية) صحيح) / تحقق, توثيق ((في القانون) إقرار مرفق ببيان يؤكد صحة ذلك البيان)\nمثال: قدمت الحفريات تأكيداً إضافياً لنظرية التطور / دَلِيل, بُرْهَان / دَلِيل / شَهَادَة / شَاهِد, شَاهِدَة (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَاهِد, شَوَاهِد (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَهِدَ (شَهَدَ؛ شُهِدَ)\nمثال: شاهد هذا الفيلم. / هامش ضيق (هامش صغير)\nمثال: لم يتواضع الرئيس بسبب هامش فوزه الضيق",
 "しょうさい": "تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية / مُفَصَّل / لقطة مقربة (صورة فوتوغرافية (أو غيرها) يظهر فيها الموضوع بمقياس كبير نسبياً، ويشغل معظم أو كل الإطار) / براعة, ذكاء (خاصية كون الشخص بارعاً) / ذكاء, شطارة (الذكاء الذي يظهر في سرعة البديهة والفطنة) / إبداع, عبقرية (قوة الخيال الإبداعي)\nمثال: حبكة ذات براعة كبيرة / امتناع, تعفف (فعل أو ممارسة الامتناع عن الانغماس في شهوة ما) / امتناع, عفة (سمة الامتناع (خاصة عن الكحول))",
 "しょうさいちず": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير)",
 "しょうさく": "حِيلَة / وَحِيد, مُوحِش",
 "しょうさっし": "كُتَيِّب, كُرَّاسَة (كِتَاب صَغِير؛ دَلِيل)",
 "しょうさつ": "اِنْعِكَاس, عَكْس / مَنْشُور, كُرَّاسَة",
 "しょうさん": "حمض النتريك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة. / مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى / تتجفاف, تجفيف (عملية استخلاص الرطوبة) / تبخر, تبخير (عملية التحول إلى بخار)",
 "しょうさんえん": "نترات (أي مركب يحتوي على مجموعة النترات (مثل ملح أو إستر حمض النيتريك))",
 "しょうさんぎん": "نترات الفضة (نترات تستخدم في صنع المستحلبات الفوتوغرافية؛ وتستخدم أيضاً في الطب للكي وكعامل مضاد للبكتيريا موضعي)",
 "しょうさんけい": "حمض النتريك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "しょうさんせんいそ": "نترات السليلوز, نيتروسليلوز (إستر لحمض النيتريك؛ يستخدم في الورنيش والمتفجرات)",
 "しょうさんアンモニウム": "نترات الأمونيوم (تستخدم كمتفجرات وسماد ووقود للصواريخ)",
 "しょうさんウラニル": "نترات اليورانيل (ملح أصفر يتم الحصول عليه عن طريق تفاعل أملاح اليورانيوم مع حمض النيتريك)",
 "しょうさんエステル": "نترات (أي مركب يحتوي على مجموعة النترات (مثل ملح أو إستر حمض النيتريك))",
 "しょうさんカリウム": "ملح البارود, نترات البوتاسيوم",
 "しょうさんカルシウム": "نترات الكالسيوم (ملح متميع قابل للذوبان في الماء؛ يستخدم أحياناً كمصدر للنيتروجين في الأسمدة)",
 "しょうさんセルロース": "نترات السليلوز, نيتروسليلوز (إستر لحمض النيتريك؛ يستخدم في الورنيش والمتفجرات)",
 "しょうさんナトリウム": "نترات الصوديوم",
 "しょうざい": "مُنْتَج / سِلْعَة / حَاصِل (الشيء :حصل عليه) / مَحْصُول / حَاصِل ضَرْب (الشيء :حصل عليه) / جَدَاء / ملطف / خطيئة عرضية, صغيرة من الصغائر (خطيئة يمكن غفرانها وتعتبر مستوجبة لفقدان جزئي فقط للنعمة)",
 "しょうし": "كُومِيدِيّ, مُضْحِك (يُثير الضحك أو يستدعيه) / سَخِيف, مُثِير لِلسُّخْرِيَة (بالغ اللامعقوليّة بحيث يستدعي الاستهزاء والسخرية) / مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل / تناسخ الأرواح, سامسارا ((في الهندوسية والبوذية) الدورة اللانهائية من الولادة والمعاناة والموت والبعث) / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى / خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان. / مراكبي (رجل يقود أو يركب قارباً) / بِلَّوْرَة دَقِيقَة (أي من الأجسام البلورية البدائية الدقيقة مجهولة التركيب الموجودة في الصخور النارية الزجاجية) / صناعة الورق (حرفة صنع الورق) / تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / زُجَاج, قزاز / كَأْس, كُوب (إناء الشرب إذا كان فيه شراب؛ الشراب الذي في الإناء)\nمثال: هل لي بكأس ماء؟",
 "しょうしがん": "بتشستون, حجر القار (زجاج جرانيتي حمضي داكن)",
 "しょうしたい": "جسم زجاجي, خلط زجاجي (الهلام الشفاف عديم اللون الذي يملأ الغرفة الخلفية لمقلة العين)",
 "しょうしつ": "اِخْتِفَاء",
 "しょうしつてん": "نقطة التلاشي (مظهر نقطة في الأفق تلتقي عندها الخطوط المتوازية) / نقطة التلاشي (النقطة التي يختفي بعدها الشيء أو يتوقف عن الوجود)",
 "しょうしなんこつ": "غضروف زجاجي (غضروف شفاف شائع في المفاصل والممرات التنفسية؛ يشكل معظم الهيكل العظمي للجنين)",
 "しょうしほん": "حرف كبير مصغر (حرف له شكل الحرف الكبير ولكن بنفس ارتفاع الأحرف الصغيرة)",
 "しょうしゃ": "خسائر, خسارة (نقصان في الأفراد أو المعدات العسكرية) / إصابة مميتة, حادث مميت (حادث يتسبب في موت شخص ما) / ضَحِيَّة حادِث, مُصاب (شخص أصيب أو قتل في حادث) / إِصابَة, خَسارَة بَشَرِيَّة (شخص أصيب أو قتل أو أسر أو فقد في اشتباك عسكري) / فَائِز, فَائِزَة / شاب, يافع (شخص صغير السن (خاصة شاب أو صبي)) / تَشَعُّع / تَشْعِيع / تعريض (فعل تعريض شخص ما لتجربة مؤثرة) / ترك في العراء, نبذ (التخلي دون مأوى أو حماية (مثل ترك رضيع في العراء)) / إظهار, كشف (العرض للمشاهدة بطريقة علنية أو عامة) / تعريض (فعل تعريض الفيلم للضوء)\nمثال: نددت بتعريض الأطفال للمواد الإباحية / أنيق, عصري (كائن أو متوافق مع الموضات الاجتماعية الحالية) / أنيق, عصري (لديه أناقة أو ذوق أو رقي في الأخلاق أو الملبس)\nمثال: ملابس عصرية / سَرِيَّة / شَرِكَة / كشك الحراسة (مأوى صغير مفتوح من الأمام لحماية الحارس من الطقس) / ثُكْنَة, قَشْلَة",
 "しょうしゃく": "مَشْهَد / مَنْظَر / كي (فعل تخثير الدم وتدمير الأنسجة بحديد ساخن أو عامل كاوٍ أو بالتجميد) / مادة كاوية, مكواة (أداة أو مادة تستخدم لتدمير الأنسجة لأسباب طبية (مثل إزالة الثؤلول) عن طريق حرقها بمكواة ساخنة أو تيار كهربائي أو مادة كاوية أو عن طريق تجميدها)",
 "しょうしゃしょり": "إِضَاءَة",
 "しょうしゃせんりょう": "جرعة التعرض (قياس للإشعاع فيما يتعلق بقدرته على إنتاج التأين)",
 "しょうしゃほう": "تَشَعُّع / تَشْعِيع",
 "しょうしゃほうこう": "ضوء, مصدر ضوء (أي جهاز يعمل كمصدر للإضاءة)\nمثال: أوقف السيارة وأطفأ الأضواء",
 "しょうしゅう": "اِلْتِئَام, اِنْعِقَاد (فعل عقد الاجتماع) / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / ديناميكا كهربائية كمية (نظرية كمية نسبية للتفاعلات الكهرومغناطيسية للفوتونات والإلكترونات والميونات)",
 "しょうしゅうざい": "مُزِيل اَلْعَرَق, مُزِيل اَلرَّائِحَة",
 "しょうしゅじゅつ": "جراحة صغرى (أي إجراء جراحي لا يتضمن التخدير أو المساعدة التنفسية)",
 "しょうしゅつ": "استخراج, خلع (عملية إخراج شيء ما (خاصة باستخدام الجهد أو القوة)) / أصل, منشأ (الخصائص المنسوبة لأسلافك) / استخراج, استخلاص (عملية الحصول على شيء من خليط أو مركب بوسائل كيميائية أو فيزيائية أو ميكانيكية)\nمثال: أعطاها طبيب الأسنان تخديراً موضعياً قبل الخلع / غَيْر مَشْرُوع, مُحَرَّم (مُخالِف لِلقانون؛ لا يُجيزُهُ القانون) / غير شرعي (للزواج والنسل؛ غير معترف به كقانوني) / ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين) / تبلور (تركيب ذهني يصبح ثابتاً أو ملموساً بعملية تشبه تكوين البلورات) / بِلَّوْرَة, كْرِيسْتَال (صخر يتكون من تصلب مادة ما؛ له هيكل داخلي متكرر بانتظام؛ وأوجه مستوية خارجية) / بلورة, تبلور (تشكل البلورات)",
 "しょうしゅん": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, سَنَة جَدِيدَة سَعِيدَة",
 "しょうしょ": "وَثِيقَة, مُسْتَنَد / مُسْتَنَد / وَثَّق (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء. / أَمْر, مَرْسُوم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف . / مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس / قِسِّيس, دَاعِيَة (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ) / وَزِير, وَزِيرَة",
 "しょうしょう": "لواء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء) / قَلِيلًا / شَفَّاف / وَاضِح / قَاتِم, كَئِيب (يبعث على الحزن والكآبة) / رَتِيب, كَئِيب (يفتقر إلى الحيوية أو السحر أو المفاجأة) / دَجِر / ذُو طَنِين, مُتَرَنِّم (يشبه صوت الرنين القصير العالي لجرس صغير) / بَاكٍ / بُكَاء / مُنَمْنَمَة / بَرَّاق, مُتَلَأْلِئ (ذُو وَمَضَاتٍ قَصِيرَةٍ وبَرَّاقَة مِنَ الضَّوْء) / بِإِحْبَاط, بِاكْتِئَاب (بطريقة مكتئبة)\nمثال: عندما عادت كانت صوفي وإستر تجلسان باكتئاب في المطبخ / وَحِيد, مُنْفَرِد",
 "しょうしょく": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "しょうしょしょう": "وزارة الخارجية, وزارة الخارجية الأمريكية (الإدارة الفيدرالية في الولايات المتحدة التي تضع وتحافظ على السياسات الخارجية)\nمثال: تأسست وزارة الخارجية عام 1789",
 "しょうしるい": "خُنْفُسَاء",
 "しょうしん": "حزن شديد, فجيعة (أسى شديد ناتج عن فقدان شخص محبوب (خاصة بالموت)) / تهيب, جبن (الخوف عند الخوض في أماكن أو أنشطة جديدة ومجهولة) / جبن, خجل (الخوف من المجهول أو غير المألوف أو الخوف من اتخاذ القرارات) / عَقْل, حَنْك (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل. / تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة / قُصُور القَلْب, فَشَل القَلْب / نَفَاد صَبْر / تَرْكِيز / حَقٌّ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له)\nمثال: الأستاذ على حق.",
 "しょうしんくりょ": "تَمَلْمَلَ",
 "しょうしんしょうめい": "أَصْلِيّ",
 "しょうしんじんじ": "تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة",
 "しょうしんもの": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "しょうしんよくよく": "خَجُول, مُتَرَدِّد (يَفْتَقِر إِلَى القَنَاعَة أَوِ الجُرْأَة أَوِ الشَّجَاعَة)",
 "しょうじ": "رَضِيع / شوجي (ستار شفاف مصنوع من إطار خشبي مغطى بورق الأرز) / تناسخ الأرواح, سامسارا ((في الهندوسية والبوذية) الدورة اللانهائية من الولادة والمعاناة والموت والبعث) / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / تَرْكِيز / زُهْد (زَهَّدَ (زهده): قلله؛ زَهَّدَ فيه وعنه: جعله يزهد) / زُقَاق, ممر / مَسَار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة. / تفاهة, شيء تافه (شيء قليل الأهمية) / أمر تافه, تفاهة (تفصيل يعتبر غير مهم) / ترافل (بودينغ بارد مصنوع من طبقات من الكعك الاسفنجي المدهون بالفاكهة أو الجيلي؛ وقد يُزين بالمكسرات أو الكريمة أو الشوكولاتة) / إزالة المغناطيسية, زوال المغناطيسية (عملية إزالة التمغنط) / ثَنَاء / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب. / إيضاح, تبيان (تفسير يزيل عقبات الفهم) / تبيان, توضيح (فعل الشرح الذي يخدم في إزالة الغموض وإلقاء الضوء)\nمثال: ساعدها توضيح الأستاذ على فهم الكتاب المدرسي / حرف صغير (الأحرف التي كانت تُحفظ سابقاً في النصف السفلي من صندوق حروف الطباعة)",
 "しょうじき": "نَزِيه, صَادِق / بِصَراحة",
 "しょうじきいって": "بِصَراحة",
 "しょうじきなところ": "بصدق, حقاً (في الواقع (تستخدم للتوكيد أو تعديل الجملة))\nمثال: في الحقيقة، عجل الانحلال الأخلاقي بسقوط الإمبراطورية الرومانية",
 "しょうじきもの": "شخص مستقيم, نزيه (شخص صريح وصادق)\nمثال: 正直者に神宿る。 — الصدق أفضل سياسة .",
 "しょうじけん": "عرض جانبي (عرض صغير يكون جزءاً من عرض أكبر (كما في السيرك)) / حدث جانبي, عرض جانبي (حادثة ثانوية قليلة الأهمية مقارنة بالحدث الرئيسي)\nمثال: التعليم ليس حدثاً جانبياً تربوياً",
 "しょうじてん": "قاموس جيب (قاموس صغير بما يكفي لحمله في جيبك)",
 "しょうじにめあり": "اَلْجِدْرَانُ لَهَا آذَانٌ, لِلْحِيطَانِ آذَانٌ",
 "しょうじゃ": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع / وَلِيّ, قِدِّيس (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش. / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي.",
 "しょうじゅ": "شجرة الصنوبر, صنوبر (شجرة صنوبرية)",
 "しょうじゅう": "بُنْدُقِيَّة (أنبوب لاطلاق الرصاص، وتعتبر من الأسلحة؛ الْبُنْدُقِيََة: فِي إِيطَالْيَا)\nمثال: البندقية مدينة جميلة.",
 "しょうじゅつ": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "しょうじゅん": "مَشْهَد / مَنْظَر",
 "しょうじゅんかん": "دَوْرَة دَمَوِيَّة صُغْرَى (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "しょうじゅんき": "منظار التسديد, موجّه (أداة بصرية لمساعدة العين في التصويب، كما في سلاح ناري أو أداة مسح)",
 "しょうじゅんせいれつ": "نَوْع (صِنْف؛ في : وحدة تصنيفية أقل من الجنس) / فَرَزَ\nمثال: انه نوع من الفطر.",
 "しょうじょ": "بِنْت / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة) / طِفْلة / بنت / فتاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة. / تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة / مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة. / حذف, شطب (عملية حذف شيء مكتوب أو مطبوع) / استئصال, حذف (الإسقاط الذي يحدث عندما يختصر التغيير التحريري مقطعاً مكتوباً) / حذف ((في علم الوراثة) فقدان أو غياب نيوكليوتيد واحد أو أكثر من الكروموسوم) / حذف (أي عملية يتم فيها ترك أصوات أو كلمات من الكلمات أو العبارات المنطوقة)\nمثال: حذوفات المحرر كثيراً ما تزعج المؤلفين الشباب / مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس / دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "しょうじょう": "عَرَض, عَلَامَة (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / عَرَض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض. / شهادتي (مكون من أو متعلق بـ أو يشكل شهادة) / تقديري, تكريمي (معبر عن الإعجاب أو التقدير) / شهادة (شيء يخدم كدليل) / تزكية, توصية (شيء يوصي (أو يعبر عن الثناء على) شخص أو شيء على أنه جدير أو مرغوب فيه)\nمثال: عشاء تكريمي / صَافٍ, اَلصَّافِي / إِنْسَان اَلْغَاب, إِنْسَان الْغَابَة (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق. / دَعْوَة, عزيمة / إِغْرَاء / بوذية الهينايانا, هينايانا (اسم مسيء لبوذية التيرافادا المحافظة المبكرة؛ انقرضت في الهند لكنها بقيت في سريلانكا ونقلت من هناك إلى مناطق أخرى من جنوب غرب آسيا) / هينايانا (مدرسة رئيسية في البوذية تُعَلِّم الخلاص الشخصي من خلال الجهود الذاتية) / قَاتِم, كَئِيب (يبعث على الحزن والكآبة) / رَتِيب, كَئِيب (يفتقر إلى الحيوية أو السحر أو المفاجأة) / قِسِّيس, دَاعِيَة (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ) / وَزِير, وَزِيرَة",
 "しょうじょうせせ": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "しょうじょうせぜ": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "しょうじょうだんそう": "صدع الدسر, صدع عكسي (صدع جيولوجي يبدو فيه أن الجانب العلوي قد تم دفعه للأعلى بفعل الضغط)",
 "しょうじょうてき": "ضَيِّق الأُفُق (يفتقر إلى التسامح أو المرونة أو اتساع الرؤية) / ضيق الأفق, متعصب (يلتزم بجمود بطائفة معينة أو عقائدها) / سريع التأثر, قابل للصدمة (يمكن أن يصاب بالصدمة (الاجتماعية أو الأخلاقية))\nمثال: قاضٍ لامع ولكنه ضيق الأفق",
 "しょうじょうばえ": "ذبابة الفاكهة (أي من الحشرات الصغيرة المتعددة التي تتغذى يرقاتها على الفواكه)",
 "しょうじょうひ": "سِقِلَّاتِيّ, قِرْمِزِيّ / سِقِلَّاط, سِقِلَّات",
 "しょうじょうぶっきょう": "بوذية الهينايانا, هينايانا (اسم مسيء لبوذية التيرافادا المحافظة المبكرة؛ انقرضت في الهند لكنها بقيت في سريلانكا ونقلت من هناك إلى مناطق أخرى من جنوب غرب آسيا) / بوذية التيرافادا, تيرافادا (واحدة من مدرستين عظيمتين للعقيدة البوذية تؤكدان على الخلاص الشخصي من خلال الجهود الذاتية؛ شكل محافظ من البوذية يلتزم بنصوص بالي والمثل غير الإلهي…)",
 "しょうじょうむく": "شرف, عفة (فضيلة المرأة أو عفتها) / براءة, طهارة (حالة الخلو من الخطيئة أو الخطأ الأخلاقي؛ الافتقار إلى معرفة الشر) / صفاء, نقاء (كون الشيء غير مخفف أو غير مخلوط بمواد غريبة)",
 "しょうじる": "أَنْتَجَ, صَنَعَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت) / نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه. / دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "しょうじん": "تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة / تَرْكِيز / زُهْد (زَهَّدَ (زهده): قلله؛ زَهَّدَ فيه وعنه: جعله يزهد) / ضَيِّق الأُفُق (يفتقر إلى التسامح أو المرونة أو اتساع الرؤية) / ضيق الأفق, متعصب (يلتزم بجمود بطائفة معينة أو عقائدها) / سريع التأثر, قابل للصدمة (يمكن أن يصاب بالصدمة (الاجتماعية أو الأخلاقية))\nمثال: قاضٍ لامع ولكنه ضيق الأفق / وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / قَزَم / حَنْدَل, حِنْتَار / قَزَمِيّ / صَانِع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة) / حِرَفِيّ / حِرْفِيّ\nمثال: أحب أن أكون صانع محتوى. / جَسَد, جِسْمُ الإِنْسَان (أسماء بديلة لجسد الإنسان)\nمثال: درس ليوناردو جسم الإنسان",
 "しょうじんしょう": "تقزم (خلل جيني يؤدي إلى قصر القامة)",
 "しょうじんぶつ": "تَافِه, ضَيِّق النَّظَر (مَحْدُود الأُفُق بِشَكْلٍ مُحْتَقَر)",
 "しょうす": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / مرمى, مغزى (المعنى العام أو الفحوى السائد) / قَصْد, مَغْزًى (المعنى المقصود من التواصل)\nمثال: فهمت المغزى العام للمحادثة / مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى / بَرْهَنَ, أَثْبَتَ / ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء.",
 "しょうすい": "بَوْل / عظمية, هزال شديد (نحافة شديدة (عادة بسبب الجوع أو المرض)) / آمِر, مُقَدَّم / شويكة (هيكل مدبب صغير يعمل كعنصر هيكلي في مختلف اللافقاريات البحرية والمياه العذبة مثل الإسفنج والمرجان)",
 "しょうすいりょくはつでん": "صَغِير المِقْيَاس (مبنيّ أو مرسوم على نطاق صغير) / صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة)",
 "しょうすう": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب) / كَسْر, كُسُور\nمثال: يصنع قطعة أثاث خشبية. / قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "しょうすうしゃ": "أَقَلِّيَّة",
 "しょうすうてん": "فَاصِل عَشْرِيّ",
 "しょうすうは": "أَقَلِّيَّة",
 "しょうすうみんぞく": "أَقَلِّيَّة قَوْمِيَّة",
 "しょうする": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / مرمى, مغزى (المعنى العام أو الفحوى السائد) / قَصْد, مَغْزًى (المعنى المقصود من التواصل)\nمثال: فهمت المغزى العام للمحادثة / مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى / تَلَا (قَرَأَ، نحو: تَلُوتُ القرآن تلاوةً أي قرأته؛ اتّبَعَ، نحو: تلا الكتاب والسنة، أو تبع فلان في عمله وسار على نهجه) / بَرْهَنَ, أَثْبَتَ / ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء. / اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / تَخَلَّصَ ؛ مِن / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / اِحْتَفَلَ / مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى / قَدَّرَ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / عَلِمَ (أَدْرَكَ حقيقة الشيء) / رَفَعَ قِيمَة, زَادَ فِي قِيمَة (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: خذ قدر ما تريد.",
 "しょうず": "فاصولياء الأزوكي, لوبياء زاوية (نبات حولي كثيف يزرع على نطاق واسع في الصين واليابان للدقيق المصنوع من بذوره)",
 "しょうずく": "هَال, هَيْل / حَبْهَان, هَال",
 "しょうずる": "أَنْتَجَ, صَنَعَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت) / نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه. / اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / تَخَلَّصَ ؛ مِن / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر",
 "しょうせい": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / دَعْوَة, عزيمة / إِغْرَاء / خرزة (كرة صغيرة بها ثقب في المنتصف) / حافة خرزية (إطار مزخرف بالخرز لحاشية أو تزيين الأثاث) / حبة, قطرة (شكل كروي وصغير)\nمثال: حبات العرق على جبهته / إطلاق نار (فعل إطلاق النار من بندقية) / إقالة, تسريح (إنهاء توظيف شخص ما (وتركه حراً للمغادرة)) / إشعال, إضرام (عملية إضرام النار في شيء ما) / إطلاق نار, رمي (فعل إطلاق الأسلحة أو المدفعية على عدو)\nمثال: تراجعوا في مواجهة نيران العدو الشديدة / ضَحْكَة / ضَحِكَ, ضحك (أثار الضحك أو جعل شخصًا يضحك بشيء مضحك أو طريف؛ سلّى أو أبهج شخصًا بجعل الأجواء مرحة)\nمثال: ضحك الجميع علي. / آمِر, مُقَدَّم / أَرْجَحِيَّة, فُرْصَة (احتمالية حدوث شيء بدلاً من عدم حدوثه) / أَرْجَحِيَّة, اِحْتِمَالَات الفَوْز (النسبة التي يزيد بها رهان مقامر على آخر)\nمثال: عرض احتمالات اثنين إلى واحد",
 "しょうせかい": "مُنَمْنَمَة",
 "しょうせき": "ملح البارود, نترات البوتاسيوم / بُرْهَان, دَلِيل / تبلور (تركيب ذهني يصبح ثابتاً أو ملموساً بعملية تشبه تكوين البلورات) / بِلَّوْرَة, كْرِيسْتَال (صخر يتكون من تصلب مادة ما؛ له هيكل داخلي متكرر بانتظام؛ وأوجه مستوية خارجية) / بلورة, تبلور (تشكل البلورات)",
 "しょうせっかい": "جير, هيدروكسيد الكالسيوم (مادة كاوية تنتج عن تسخين الحجر الجيري)",
 "しょうせっこう": "جص, جص باريس (أي من أسمنتات الجبس المختلفة؛ مسحوق أبيض (شكل من أشكال كبريتات الكالسيوم) يشكل عجينة عند خلطه بالماء ويتصلب؛ يستخدم في صنع القوالب والمنحوتات…)",
 "しょうせつ": "حَانَة, بَار / مُسْتَجِدّ / رِوَايَة / امْتِيَاز, بَرَاعَة (صفة التفوق؛ امتلاك صفات جيدة بدرجة عالية) / براعة, تفوق (ميزة بارزة؛ شيء يتفوق فيه شيء أو شخص ما)\nمثال: مركز للتميز الصناعي / مُتَتَالِيَة, مُتَوَالِيَة",
 "しょうせつか": "رِوَائِيّ, رِوَائِيَّة / تحويل إلى رواية, روينة (تحويل شيء ما إلى شكل رواية)",
 "しょうせん": "باخرة شحن, سفينة تجارية (سفينة شحن)\nمثال: قاموا بالكثير من تجارتهم الخارجية في سفن أجنبية / خط سكة حديد (الطريق المكون من مسار السكة الحديدية وأرضية الطريق) / خط سكة حديد, سكة حديد (الخط الذي يمثل المنظمة التجارية المسؤولة عن تشغيل نظام نقل للقطارات التي تسحب الركاب أو البضائع) / فُرْشَاة / فَرَشَ / مَشَّطَ (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "しょうせんきょくひれいだいひょうへいりつせい": "نظام التصويت, نظام انتخابي (نظام قانوني لاتخاذ خيارات ديمقراطية)",
 "しょうぜつ": "امْتِيَاز, بَرَاعَة (صفة التفوق؛ امتلاك صفات جيدة بدرجة عالية) / براعة, تفوق (ميزة بارزة؛ شيء يتفوق فيه شيء أو شخص ما)\nمثال: مركز للتميز الصناعي",
 "しょうぜん": "متواصل, مستمر (بدون توقف أو انقطاع)\nمثال: لضمان النجاح المتواصل للحرب / قَانِط, أَسْوَان / ظَاهِر (اسم فاعل من ظَهَرَ هو الذي يَظْهَر على عدوه؛ ضد الباطن) / بَيَان (ما يتبيَّن به الشيء من الدلالة والفصاحة وغيرها، وقيل هو الإفصاح مع ذكاء؛ كل شيء كُشف لك وبان عليك، وقيل هو الكشف والتوضيح بمعنى الإثبات بالدليل) / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: كل شئ ظاهر على وجهه. / مَذْعُور, مُرْتَعِب (أصابه ذعر شديد أو يأس غامر) / وَحِيد, مُوحِش",
 "しょうぜんてい": "مقدمة صغرى (مقدمة القياس المنطقي التي تحتوي على الحد الأصغر (الذي هو موضوع النتيجة))",
 "しょうそ": "اِنْتِصَار, نَصْر",
 "しょうそう": "جُرْح, جِرَاحَة (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ) / جَرَحَ (كَلَمَ، شَقَّ اللَحْم وأسَالَ الدَمّ؛ صَادَ أو اكْتَسَبَ)\nمثال: ذلك سيهيج الجرح. / شَبَاب / شَبَاب, صِبًا / شَابّ / ابتسار, سابق لأوانه (حالة كون الشيء سابقاً لأوانه) / نَفَاد صَبْر / وَحِيد, مُوحِش",
 "しょうそうかん": "حدة المزاج, سرعة الغضب (الميل لإظهار غضب غير منضبط) / تهيج, قابلية للاستثارة (حساسية مفرطة لعضو أو جزء من الجسم) / تهيج, سرعة الغضب (شعور بالتهيج والنزق)\nمثال: كانت حدة مزاجه معروفة لجميع موظفيه",
 "しょうそうきえい": "مُجْتَهِد, نَشِيط (يعمل بجدّ لتعزيز مشروع أو مؤسّسة)",
 "しょうそうゆうい": "نَشِيط",
 "しょうそく": "أَخْبَار, أَنْبَاء (أنباء ما قد حدث؛ نشرة الأخبار أو عرض الأخبار: ما يعرضه التلفاز أو الراديو من أخبار سياسة واقتصادية ورياضية تهم عامة الناس)\nمثال: هذه أخبار طيبة. / مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة",
 "しょうそくし": "مِسْبَار",
 "しょうそくつう": "مُطَّلِع",
 "しょうそくふめい": "لا يمكن تتبعه, مجهول المصدر (يستحيل تتبعه أو تعقبه)\nمثال: مصدر لا يمكن تتبعه",
 "しょうそくぶん": "رسالة شخصية (رسالة تتعلق بالشؤون الشخصية)",
 "しょうそくをたつ": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "しょうそこ": "أَخْبَار, أَنْبَاء (أنباء ما قد حدث؛ نشرة الأخبار أو عرض الأخبار: ما يعرضه التلفاز أو الراديو من أخبار سياسة واقتصادية ورياضية تهم عامة الناس)\nمثال: هذه أخبار طيبة. / مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة",
 "しょうそつ": "مدرسة ابتدائية (مدرسة للأطفال الصغار؛ عادة ما تكون الصفوف الستة أو الثمانية الأولى)",
 "しょうそん": "هَامْلِت",
 "しょうぞう": "صُورَة / بُورْتْرِيَّة\nمثال: この切手には誰の肖像が印刷してありますか。 — من هو الشخص المصور على هذا الطابع؟ / بيبلو, تمثال صغير (تمثال صغير منحوت أو مقولب) / صناعة الورق (حرفة صنع الورق)",
 "しょうぞうが": "صُورَة / بُورْتْرِيَّة",
 "しょうぞうがか": "رسام بورتريه, مصور وجوه (رسام أو راسم للصور الشخصية (البورتريه))",
 "しょうぞく": "بَذْلَة, بَدْلَة",
 "しょうたい": "فَصِيلَة عَسْكَرِيَّة, فَصِيلَة (ولد الناقة أو البقرة بعد أن يفصل عن أمه، الجمع فِصال وفصلان؛ فصيلة الرجل: المقرّبون إليه من عشيرته)\nمثال: يريد سامي أن يبيع كلبه من فصيلة الشيبا إينو. / دَعْوَة, عزيمة / إِغْرَاء / مُطَابَقَة / هُوِيَّة / وَعْي (الفَهْم والتَدَبُّر واِحْتِوَاء كل معاني الشيء؛ في علم النفس: حالة وعي ويعني أيضا محتوى العقل، ويشمل المشاعر والوعي الذاتي وٱلصور وَالأفكار وَٱلقدرة على إدراك العلاقة بين المرء وٱلبيئة والشعور بما…) / شُعُور\nمثال: إنها فاقدة الوعي. / اِخْتِفَاء / منطقة صغيرة, نطيقة (منطقة صغيرة تشبه الحزام)",
 "しょうたいきゃく": "ضيف, مدعو (زائر تقدم له الضيافة)",
 "しょうたいじょう": "دَعْوَة, عزيمة / إِغْرَاء",
 "しょうたいふめい": "غير قابل للتعرف عليه, مجهول الهوية (يستحيل التعرف عليه أو تحديده)",
 "しょうたく": "نَعْصَة, مُسْتَنْقَع / مَجْلِس",
 "しょうたくしょくぶつ": "نبات المستنقعات (نبات شبه مائي ينمو في الأراضي الرطبة الرخوة؛ معظمها من ذوات الفلقة الواحدة: السعادى، الطحالب، الأعشاب، البردي، إلخ؛ وربما الخلنج)",
 "しょうたくち": "أرض رطبة (منطقة منخفضة تكون الأرض فيها مشبعة بالماء)",
 "しょうたん": "تهيب, جبن (الخوف عند الخوض في أماكن أو أنشطة جديدة ومجهولة) / جبن, خجل (الخوف من المجهول أو غير المألوف أو الخوف من اتخاذ القرارات) / إشادة, استحسان (موافقة حماسية)\nمثال: لقي الكتاب استحساناً متواضعاً",
 "しょうだい": "دَعْوَة, عزيمة / إِغْرَاء / صَغِير, صغير",
 "しょうだく": "رَضِيَ, وَافَقَ (قَبِلَ؛ سلَّم واقتنع) / رِضًا (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "しょうだくねんれい": "سن الرشد القانوني, سن الموافقة (الحد الأدنى للسن للزواج دون موافقة الوالدين أو الحد الأدنى للسن للعلاقات الجنسية بالتراضي)",
 "しょうだん": "مُفَاوَضَات, مُذَاكَرَات / تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة / قِصَّة مُضْحِكَة, مَوْقِف طَرِيف (رواية لحادث مسلٍ (عادة مع جملة ختامية مضحكة))\nمثال: روت قصة مضحكة / فِقْرَة, بَنْد",
 "しょうち": "اِسْتِدْعَاء, دَعْوَة لِلْاِجْتِمَاع (عملية دعوة الناس للتجمع) / عِلْم, مَعْرِفَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس. / قَبُول, قُبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض. / غَفُور (غَفُور: ( اسم )؛ غَفور: ( اسم )) / دَعْوَة, عزيمة / إِغْرَاء / مستنقع عشبي, هور (أرض رطبة منخفضة ذات غطاء نباتي عشبي؛ عادة ما تكون منطقة انتقالية بين اليابسة والماء)\nمثال: آلاف الأفدنة من المستنقعات / مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس / حسنة, شامة اصطناعية (نقطة توضع على وجه السيدة للزينة)",
 "しょうちのうえで": "عَمْدًا",
 "しょうちのすけ": "حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "しょうちのまく": "اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة",
 "しょうちゅう": "هاموش (ذبابة دقيقة ذات جناحين تشبه البعوض تفتقر إلى أجزاء الفم القارضة؛ تظهر في أسراب راقصة خاصة بالقرب من الماء)",
 "しょうちゅうぼん": "كتاب جيب (كتاب غلاف ورقي بحجم الجيب)",
 "しょうちょう": "حكومة, سلطة (المنظمة التي تمثل السلطة الحاكمة لوحدة سياسية)\nمثال: خفضت الحكومة الضرائب / رَمْز, عَلَامَة (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا. / الْأَمْعَاء الدَّقِيقَة",
 "しょうちょうしゅぎ": "رَمْزِيَّة",
 "しょうちょうせいすい": "تبدل (صَارَ غير ما كان؛ اتخذ شيئا بدلا من شيء) / تقلب الأحوال\nمثال: لم لا تبدل ملابسك؟",
 "しょうちょうてき": "رَمْزِيّ, شِعَارِيّ (يعمل كرمز مرئي لشيء مجرد) / رمزي (متعلق بـ أو يستخدم أو يمضي عن طريق الرموز) / رمزي (يستخدم الرمزية)\nمثال: منطق رمزي",
 "しょうちょうは": "رمزي, فنان رمزي (عضو في حركة فنية عبرت عن الأفكار بشكل غير مباشر عبر الرموز) / رمزياتي, مفسر الرموز (شخص ماهر في تفسير أو تمثيل الرموز)",
 "しょうちょく": "أَمْر, مَرْسُوم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "しょうちん": "مُنْخَفَض",
 "しょうてい": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب. / أخ أصغر (أخ أصغر سناً)\nمثال: احتفل أخي الصغير للتو بعيد ميلاده الخمسين / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / قَانُون, حُقُوق (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "しょうていぼく": "جنبة, شجيرة فرعية (شجيرة خشبية منخفضة النمو أو نبات معمر بقاعدة خشبية)",
 "しょうてん": "دُكَّان, مَتْجَر (حانوت أو محل بيع؛ مصطبة يُقعد عليها) / تَسَوَّقَ, تَبَضَّعَ\nمثال: ذهب إلى الدكان. / صُعُود, اِرْتِقَاء / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / بُؤْرَة / ابتهاج, زهو (شعور بالفرح والفخر) / سَلِيبَة / غَنِيمَة / جَائِزَة, مُكَافَأَة / نقطة التلاشي (مظهر نقطة في الأفق تلتقي عندها الخطوط المتوازية) / نقطة التلاشي (النقطة التي يختفي بعدها الشيء أو يتوقف عن الوجود)",
 "しょうてんがい": "وَسَطُ البَلَد",
 "しょうてんきょり": "بُعْد بُؤْرِيّ, مَسَافَة بُؤْرِيَّة (المسافة من العدسة إلى بؤرتها)",
 "しょうてんさい": "عِيد الصُعُود, يَوْم الصُعُود",
 "しょうてんしゅ": "صاحب دكان, صاحب متجر (تاجر يمتلك أو يدير متجراً)",
 "しょうてんをあてる": "بُؤْرَة",
 "しょうてんをあわせる": "بُؤْرَة",
 "しょうてんをしぼる": "رَكَّزَ (وضع الشيء بثبات في مكانه؛ أثبت الشيء أو ثبّتَه، وخاصة في مكان محدد) / رَكَّزَ, تَرَكَّزَ (وضع الشيء بثبات في مكانه؛ أثبت الشيء أو ثبّتَه، وخاصة في مكان محدد) / مركز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: فقط ركز يا زيري.",
 "しょうでんき": "كهرباء حرارية (توليد شحنة كهربائية على بلورات معينة (مثل التورمالين) نتيجة لتغير في درجة الحرارة)",
 "しょうと": "عاصمة المقاطعة (العاصمة لمقاطعة ما)",
 "しょうとう": "جُزَيِّرَة / قَانُونِيّ / قَاع, حَوْض (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / مَشَارَة, حَوْض\nمثال: نمت في قاعة السينما. / برج الجرس (برج يدعم أو يأوي جرساً) / سكريات قليلة التعدد, قليل السكاريد (أي من الكربوهيدرات التي تنتج عددًا قليلًا فقط من جزيئات السكر الأحادي عند التحلل المائي الكامل) / رأس الصاري, قمة الصاري (رأس أو قمة الصاري) / ترويسة (عنوان صحيفة أو مجلة؛ عادة ما يُطبع على الصفحة الأولى وعلى الصفحة الافتتاحية) / ترويسة (قائمة مطبوعة في جميع أعداد صحيفة أو مجلة (عادة في الصفحة الافتتاحية) تعطي اسم المنشور وأسماء هيئة التحرير، إلخ) / جانب السرير (المساحة بجانب السرير (خاصة سرير المريض أو المحتضر))\nمثال: وقف الطبيب بجانب سريرها",
 "しょうとうしょう": "صغر الرأس (رأس صغير بشكل غير طبيعي ودماغ غير مكتمل النمو)",
 "しょうとうしょかいはつとじょうこく": "متلازمة موت الرضيع المفاجئ (موت مفاجئ وغير متوقع لرضيع يبدو بصحة جيدة أثناء النوم)",
 "しょうとうじかん": "نداء إطفاء الأنوار ((عسكري) إشارة لإطفاء الأنوار) / وقت إطفاء الأنوار (وقت محدد للنوم)",
 "しょうとうらっぱ": "نداء إطفاء الأنوار ((عسكري) إشارة لإطفاء الأنوار) / وقت إطفاء الأنوار (وقت محدد للنوم)",
 "しょうとうるい": "سكريات قليلة التعدد, قليل السكاريد (أي من الكربوهيدرات التي تنتج عددًا قليلًا فقط من جزيئات السكر الأحادي عند التحلل المائي الكامل)",
 "しょうとうれい": "مَنْعُ التَّجَوُّل, حَظْرُ التَّجَوُّل (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه) / مَوْعِد الحَظْر (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "しょうとうラッパ": "نداء إطفاء الأنوار ((عسكري) إشارة لإطفاء الأنوار) / وقت إطفاء الأنوار (وقت محدد للنوم)",
 "しょうとく": "مُتَأَصِّل / تَأْبِين, أُمْدُوحَة / ثَنَاء, أُمْدُوحَة",
 "しょうとくひ": "نُصُب, مَعْلَم تَذْكَارِيّ",
 "しょうとつ": "تَصَادُّم, اِصْطِدَام / تَصَادُم / يتصادم",
 "しょうとつき": "مصادم (معجل يتم فيه إجبار شعاعين من الجسيمات على التصادم وجهاً لوجه)",
 "しょうとつけんしゅつ": "سِي دِي",
 "しょうとり": "بُورْصَة, سُوقُ الْأَوْرَاقِ الْمَالِيَّةِ",
 "しょうど": "إِضَاءَة / سِيَاسَةُ الأَرْضِ المَحْرُوقَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "しょうどう": "محاماة / تَأْييد / مُنَاصَرَة / دفعة, قوة دافعة مفاجئة (فعل تطبيق قوة فجأة) / دفعة, زخم (قوة دافعة) / سيال عصبي, نبضة عصبية (التفريغ الكهربائي الذي ينتقل عبر الليف العصبي) / نبض, نبضة ((في الإلكترونيات) موجة عابرة حادة في الحالة الكهربائية الطبيعية (أو سلسلة من هذه العوابر))\nمثال: الدفعة المفاجئة أسقطته أرضاً / رَائِد, قِيَادِيّ (يذهب أو يتقدم في المقدمة؛ يظهر الطريق) / قيادة (نشاط القيادة) / فِي المُقَدِّمَة, مُتَصَدِّر (يَحْتَلُّ المَرْكَزَ الأَوَّلَ أَوْ لَدَيْهِ النَّتِيجَةُ الأَعْلَى فِي مُنَافَسَة) / شريحة رصاص, فاصد (شريط رفيع من المعدن يستخدم لفصل خطوط الحروف في الطباعة)\nمثال: ركبنا في السيارة المتقدمة / محاماة / تَأْييد / مُنَاصَرَة / دُرْزِيّ (معتنق لمذهب التوحيد الدرزي)\nمثال: يُسمح للدرزي بالتوافق ظاهرياً مع عقيدة غير المؤمنين الذين يعيش بينهم / شاب, يافع (شخص صغير السن (خاصة شاب أو صبي)) / برج الجرس, غرفة الجرس (غرفة (غالباً في قمة برج) تعلق فيها الأجراس) / برج الناقوس, منارة الجرس (برج جرس؛ عادة ما يقف منفرداً غير متصل بمبنى) / تَرَنُّح / إِنْغَاض",
 "しょうどうせき": "جِيُود, فجوة صخرية ((في علم المعادن) صخرة مجوفة أو عقيدة ذات تجويف مبطن عادةً بالبلورات)",
 "しょうどうつばめ": "سنونو الجرف (سنونو من نصف الكرة الشمالي يعشش في أنفاق محفورة في ضفاف الطين أو الرمل)",
 "しょうどうてき": "طَائِش, مُتَهَوِّر (يتّسم بالتسرّع المفرط وعدم التفكير أو التروّي) / مِزَاجِيّ, نَزَوِيّ (مُحَدَّدٌ بِالصُّدْفَةِ أَوِ النَّزْوَةِ لَا بِالضَّرُورَةِ أَوِ العَقْل) / دَافِع, مُحَرِّك (له قوّة الدفع أو التحريك) / انْدِفَاعِيّ, مُتَهَوِّر (بدون تفكير مسبق أو ترَوٍّ)",
 "しょうどうタービン": "توربين نبضي, عنفة دفعية (توربين يتم تشغيله بواسطة تدفقات نفاثة مباشرة ضد الشفرات)",
 "しょうどく": "تطهير, تعقيم (علاج لتدمير الكائنات الحية الدقيقة الضارة) / قِرَاءَة",
 "しょうどくき": "أوتوكلاف, جهاز تعقيم بالبخار المضغوط (جهاز لتسخين المواد فوق درجة غليانها؛ يستخدم لتصنيع المواد الكيميائية أو لتعقيم الأدوات الجراحية)",
 "しょうどくざい": "مُعَقِّمٌ",
 "しょうどくやく": "مُطَهِّر",
 "しょうどくようアルコール": "كحول طبي, كحول محمر (غسول يتكون من محلول سام من كحول الأيزوبروبيل أو الإيثانول المحول للاستخدام الخارجي)",
 "しょうどん": "تطبيع, تلدين (تقسية شيء ما بالمعالجة الحرارية)",
 "しょうなり": "أَصْغَر مِن, صُغْرَى مِن",
 "しょうなりイコール": "أَصْغَر مِن, صُغْرَى مِن",
 "しょうに": "رَضِيع",
 "しょうにあいしゃ": "بيدوفيل, متحرش بالأطفال (شخص بالغ ينجذب جنسياً للأطفال)",
 "しょうにか": "طِبُّ الأَطْفَال (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "しょうにかい": "طبيب أطفال (أخصائي في رعاية الأطفال)",
 "しょうにしぼうびんしょう": "الداء البطني, حساسية القمح (اضطراب يصيب الأطفال والبالغين؛ عدم القدرة على تحمل بروتين القمح (الغلوتين)؛ تشمل الأعراض إسهالاً كريه الرائحة وهزالاً؛ غالباً ما يكون مصحوباً بعدم…)",
 "しょうにせいあい": "بيدوفيليا, ولع بالأطفال (الانجذاب الجنسي للأطفال)",
 "しょうにせいあいしゃ": "بيدوفيل, متحرش بالأطفال (شخص بالغ ينجذب جنسياً للأطفال)",
 "しょうにまひ": "شَلَل الْأَطْفَال / شلل دماغي",
 "しょうにゅうせき": "نوازل الكهوف, هابطة (أسطوانة من كربونات الكالسيوم تتدلى من سقف كهف جيري)",
 "しょうにゅうたい": "حَصَاةُ المَثَانَة (حصاة تتكون في المثانة)",
 "しょうにょうまく": "مشيماء سجقية (الغشاء الجنيني الوعائي جداً المكون من المشيمة المندمجة والجدار المجاور للسجق)",
 "しょうにん": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / إذن بالكلام (تعيين من قبل رئيس الجلسة يمنح الشخص الحق في التحدث في هيئة تداولية) / تحديد الهوية, تعرف (عملية التعرف على شيء ما أو شخص ما عن طريق التذكر) / إدراك, اعتراف (الوصول إلى فهم شيء ما بوضوح وتميز) / إقرار, اعتراف (قبول (مثل قبول ادعاء) على أنه حقيقي وصالح)\nمثال: لم يتمكن من تقديم اقتراحه لأنه لم يحصل على إذن بالكلام من الرئيس / تَرْقِيَة, تَرْفِيع / تَرْوِيج / تَرْقِيَة / شَهَادَة / شَاهِد, شَاهِدَة (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَاهِد, شَوَاهِد (اسم فاعلٍ للفعل شَهِدَ؛ هو مَنْ رَأَى وَعَايَنَ وَحَضَرَ ٱلْأَمْرَ) / شَهِدَ (شَهَدَ؛ شُهِدَ)\nمثال: شاهد هذا الفيلم. / حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى) / زعيم روحي, كاهن أعظم (سلطة بارزة أو مؤيد رئيسي لحركة أو مذهب ما)\nمثال: إنه الكاهن الأعظم لموسيقى الجاز المعاصرة / جَلِيل, سَامٍ (جدير بالإجلال والتبجيل) / المبجل, قس (لقب احترام لرجل دين) / قسيس, مُبَجَّل (عضو في سلك رجال الدين وقائد روحي في الكنيسة المسيحية) / تَاجِر, تَاجِرَة / بُوذَا, بُدّ / حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى) / زعيم روحي, كاهن أعظم (سلطة بارزة أو مؤيد رئيسي لحركة أو مذهب ما)\nمثال: إنه الكاهن الأعظم لموسيقى الجاز المعاصرة",
 "しょうにんいん": "خاتم الموافقة, ختم (مؤشر على الحالة المعتمدة أو المتفوقة)",
 "しょうにんかんもん": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له.",
 "しょうにんこんじょう": "تجارة, تجارية (المعاملات (البيع والشراء) التي تهدف إلى توفير السلع (البضائع والخدمات))",
 "しょうにんしゃ": "مُعتمِد, مُوافق (سلطة لديها القدرة على الموافقة)",
 "しょうにんしょう": "خاتم الموافقة, ختم (مؤشر على الحالة المعتمدة أو المتفوقة)",
 "しょうにんせき": "منصة الشهود (مقصورة للشاهد عند الإدلاء بشهادته)",
 "しょうにんだい": "منصة الشهود (مقصورة للشاهد عند الإدلاء بشهادته)",
 "しょうね": "طَبِيعَة, طبيعة",
 "しょうねつじごく": "جَحِيم, جَهَنَّم / جَحِيم, سَعِير",
 "しょうねん": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى. / سَاذَج, صِبْيَانِيّ (يُظهر أو يوحي بافتقار إلى النضج) / شبابي, صبياني (متعلق بالأطفال أو الشباب أو مميز لهم أو مناسب لهم) / حدث, قاصر (شخص صغير السن لم يكتمل نموه بعد)\nمثال: سكري الأحداث / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "しょうねんあい": "اشتهاء الغلمان, لواط بالأطفال (العلاقات الجنسية بين رجل وصبي (عادة الجماع الشرجي مع الصبي كشريك سلبي))",
 "しょうねんあいしこう": "بيدوفيليا, ولع بالأطفال (الانجذاب الجنسي للأطفال)",
 "しょうねんいん": "إصْلاحِيّ, تَهْذيبِيّ (يَهْدِف إلى الإصْلاح والتَّهْذيب) / إصلاحية, دار رعاية الأحداث (مؤسسة إصلاحية لاحتجاز وتأديب وتدريب الأحداث أو المجرمين لأول مرة)",
 "しょうねんかんかいん": "إصلاحية, دار رعاية الأحداث (مؤسسة إصلاحية لاحتجاز وتأديب وتدريب الأحداث أو المجرمين لأول مرة)",
 "しょうねんき": "مُرَاهَقَة",
 "しょうねんさいばんしょ": "محكمة الأحداث (محكمة لها اختصاص على الأطفال المعالين والجانحين)",
 "しょうねんしんぱんしょ": "محكمة الأحداث (محكمة لها اختصاص على الأطفال المعالين والجانحين)",
 "しょうねんしんぱんじょ": "محكمة الأحداث (محكمة لها اختصاص على الأطفال المعالين والجانحين)",
 "しょうねんだん": "الكشافة, فتيان الكشافة (حركة دولية (لكنها لامركزية) بدأت في عام 1908 في إنجلترا بهدف تعليم المواطنة الصالحة للفتيان)",
 "しょうねんはんざい": "انحراف الأحداث, جنوح (سلوك معاد للمجتمع ينتهك القانون يرتكبه قاصر)",
 "しょうねんはんざいしゃ": "جانح, حدث جانح (مذنب شاب)",
 "しょうねんろうどう": "عمالة الأطفال (مؤنث عَمَّال بمعنى صيغة مبالغة في العَمَل؛ في : هم العُمَّال؛ جمع عَامِل، وقد يكون جمع عَمَّال)",
 "しょうのいい": "حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط",
 "しょうのう": "مُخَيْخ / كَافُور / مزارع صغير (مزارع يعمل في مزرعة صغيرة المساحة) / حُوَيْصِلَة",
 "しょうのうせい": "مخيخي (يتعلق بـ أو مرتبط بالمخيخ)\nمثال: شريان مخيخي",
 "しょうのない": "مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه / أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "しょうのよい": "حسن الطباع, دمث الخلق (ذو طبع سهل ومرح)\nمثال: أطيب قلباً من أن يستاء من انتقاد بسيط",
 "しょうのわるい": "سيء الطباع, فظ (ذو طبع سريع الغضب وغير سار)",
 "しょうはい": "نَتِيجَة / غَنِيمَة / مِيدَالِيَة, مِِيدَالْيَة",
 "しょうはく": "شجرة مخروطية, صنوبريات (أي شجرة أو شجيرة عارية البذور تحمل مخاريط) / وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب.",
 "しょうはてい": "كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ)",
 "しょうはんてん": "بقعة, لطخة (جزء صغير مغاير في شيء ما)\nمثال: بقعة صلعاء",
 "しょうはブロック": "رباعي الأطراف (حيوان فقاري له أربعة أقدام أو أرجل أو زوائد تشبه الأرجل)",
 "しょうばい": "تِجَارَة\nمثال: 地元の店は観光客相手に順調な商売をしている。 — المتاجر المحلية تقوم بمتاجرة جيدة مع السياح . / وَظِيفَة, مِهْنَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِحْتِلال, إِشْغَال (احتلّ: نزل؛ احتلّ به واحتلّه: نزل به، واحتلّ الشيء: اتّخذه حلالاً)\nمثال: ما وظيفة زوجتك؟",
 "しょうばいおんな": "بائعة هوى",
 "しょうばいしん": "هيئة محلفين صغرى (هيئة محلفين من 12 شخصاً لتحديد الوقائع والبت في القضية في الإجراءات المدنية أو الجنائية)",
 "しょうばいどうぐ": "أدوات المهنة, عدة العمل (أي معدات تستخدم باستمرار كجزء من مهنة أو وظيفة)\nمثال: الود هو أداة البائع في عمله",
 "しょうばいになる": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "しょうばいにん": "تَاجِر, تَاجِرَة / خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير. / بائعة هوى",
 "しょうばん": "لوح أرضية (لوح في الأرضية) / أرضية السيارة (أرضية السيارة) / مُشَارِك, نَشِط (يَأْخُذُ دَوْرًا فَاعِلًا فِي نَشَاطٍ مَا)",
 "しょうひ": "اِسْتِهْلَاك",
 "しょうひがわひどうきてつづき": "مُسْتَهْلِك / مُسْتَنْفِد",
 "しょうひきげん": "تاريخ انهاء الصلاحية (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "しょうひざい": "بضائع استهلاكية, سلع استهلاكية (بضائع (مثل الطعام أو الملابس) مخصصة للاستخدام أو الاستهلاك المباشر)",
 "しょうひしゃ": "مُسْتَهْلِك / مُسْتَنْفِد",
 "しょうひしゃきんゆう": "ائتمان استهلاكي (خط ائتمان ممدد للاستخدام الشخصي أو المنزلي)",
 "しょうひしゃしんよう": "ائتمان استهلاكي (خط ائتمان ممدد للاستخدام الشخصي أو المنزلي)",
 "しょうひしゃしんようほごほう": "ائتمان استهلاكي (خط ائتمان ممدد للاستخدام الشخصي أو المنزلي)",
 "しょうひしゃぶっかしすう": "مؤشر أسعار المستهلك (مؤشر لتكلفة جميع السلع والخدمات للمستهلك النموذجي)",
 "しょうひしゅぎ": "استهلاكية, نزعة استهلاكية",
 "しょうひぜいりつ": "ضريبة المبيعات (ضريبة تعتمد على تكلفة السلعة المشتراة وتُحصل مباشرة من المشتري)",
 "しょうひつ": "إِغْفَال",
 "しょうひょう": "عَلَامَة تِجَارِيَّة (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ. / شَهَادَة / قَسِيمَة",
 "しょうひょうめい": "اسم تجاري, علامة تجارية (اسم يُعطى لمنتج أو خدمة)",
 "しょうひん": "بِضَاعَة, بَضَائِع / مَقَالَة, بَحْث / سَلِيبَة / غَنِيمَة / جَائِزَة, مُكَافَأَة",
 "しょうひんか": "إضفاء الطابع التجاري, تسويق تجاري (فعل جعل الشيء تجارياً؛ إدخال شيء ما في التجارة)\nمثال: اعتبر والدي تحويل عيد الميلاد إلى مناسبة تجارية تدنيساً للمقدسات",
 "しょうひんかいはつ": "تطوير المنتجات (تحسين منتج موجود أو تطوير أنواع جديدة من المنتجات)",
 "しょうひんがく": "إعلان, دعاية (العمل التجاري لجذب انتباه الجمهور إلى السلع والخدمات) / بيع, متاجرة (تبادل البضائع مقابل مبلغ متفق عليه من المال) / منتجات ترويجية (منتجات تحمل علامة تجارية تهدف للترويج لمنتج آخر، وخاصة الأفلام والفرق الموسيقية)",
 "しょうひんさくもつ": "محصول تجاري, محصول نقدي (محصول قابل للبيع بسهولة يُزرع ويُجمع من أجل السوق (مثل الخضروات أو القطن أو التبغ))",
 "しょうひんとりひきじょ": "بورصة السلع (بورصة لبيع وشراء السلع للتسليم المستقبلي)",
 "しょうひんめい": "اسم تجاري, علامة تجارية (اسم يُعطى لمنتج أو خدمة)",
 "しょうひんもくろく": "جَرْد (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها)\nمثال: كان سامي جرد طفل.",
 "しょうび": "وَرْدَة / إِعْجَاب / طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "しょうびゆ": "زيت الورد (زيت عطري متطاير يتم الحصول عليه من الورود الطازجة بالتقطير بالبخار)",
 "しょうびん": "سَلْدَج / قِرِلَّى / رَفْرَاف",
 "しょうふ": "حَطَّاب / دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد) / غلوتين القمح (غلوتين محضر من القمح)",
 "しょうふう": "قَيْقَب",
 "しょうふく": "مُتَقَبِّل / غَيْر مَشْرُوع, مُحَرَّم (مُخالِف لِلقانون؛ لا يُجيزُهُ القانون) / غير شرعي (للزواج والنسل؛ غير معترف به كقانوني) / ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين) / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / سُجُود",
 "しょうふだ": "عَلَامَةُ سِعْر, بِطَاقَةُ سِعْر (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "しょうぶ": "مُبَارَاة / شَحّاطَة, شَخَّاطَة / عَسْكَرِيَّة / وَجّ, ذَرِيرَة / سوسن دموي / قَصِير, قصير (ضد الطويل) / قَصِير (ضد الطويل)\nمثال: حبل الكذب قصير.",
 "しょうぶごと": "قِمَار, مُقَامَرَة",
 "しょうぶし": "مُقَامِر / مُغَامِر / مغامر, مُخاطر (شخص يخاطر بالخسارة أو الإصابة أملاً في الكسب أو الإثارة)",
 "しょうぶどころ": "نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "しょうぶなし": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
 "しょうぶん": "طَبِيعَة, طبيعة",
 "しょうへい": "دَعْوَة, عزيمة / إِغْرَاء / سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام. / حارِس, خَفِير (شخص يتم توظيفه للمراقبة تحسباً لحدث متوقع)",
 "しょうへき": "عَقَبَة, حَاجِز",
 "しょうへん": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / قِصَّة قَصِيرَة, أُقْصُوصَة / اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / عصر النهضة, نهضة (إحياء التعلم والثقافة) / انبعاث, تناسخ الأرواح (ولادة ثانية أو جديدة) / تناسخ الأرواح (بعد الموت تبدأ الروح دورة جديدة من الوجود في جسم بشري آخر)",
 "しょうべい": "أرز أبيض (أرز تمت إزالة القشرة أو الطبقات البنية الخارجية منه)",
 "しょうべん": "بَوْل",
 "しょうべんき": "مِبْوَلَة",
 "しょうべんくさい": "طُفُولِيّ",
 "しょうべんじょ": "مِبْوَلَة",
 "しょうべんぶくろ": "مَثَانَة, مَثَانَة بَوْلِيَّة ((في الأحياء) عضو مرن يشبه الكيس يتمدد وينقبض، وظيفته تخزين سائل أو غاز ما؛ تحديدًا، المثانة البولية، وهي العضو الذي يخزن البول في الإنسان وفي العديد من الحيوانات)",
 "しょうべんをする": "تَبَوَّلَ, بَالَ",
 "しょうほ": "دُكَّان, مَتْجَر (حانوت أو محل بيع؛ مصطبة يُقعد عليها) / تَسَوَّقَ, تَبَضَّعَ\nمثال: ذهب إلى الدكان. / لواء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "しょうほう": "تِجَارَة / قانون تجاري (مجموعة القواعد المطبقة على المعاملات التجارية؛ مستمدة من ممارسات التجار بدلاً من الفقه القانوني) / تفاصيل, معلومات داخلية (معلومات سرية حقيقية)\nمثال: بعد المحاكمة أعطانا التفاصيل الحقيقية / حويصلة, كيس (كيس صغير طبيعي تشريحياً أو بنية شبيهة بالمثانة (خاصة تلك التي تحتوي على سائل))",
 "しょうほうし": "بوغ دقيق, بوغ صغير (أصغر نوعي الأبواغ المنتجة في النباتات متباينة الأبواغ؛ يتطور في كيس اللقاح إلى نبات مشيجي ذكري)",
 "しょうほうしのう": "محفظة بوغية صغيرة (بنية نباتية تنتج أبواغاً صغيرة)",
 "しょうほうたい": "شبكة إندوبلازمية",
 "しょうほっさ": "صرع صغير, نوبة خفيفة (نوبة قصيرة الأمد تتميز بفقدان لحظي للوعي وتشنجات عضلية موضعية أو ارتعاش) / صرع صغير, نوبة غيبية (صرع يتميز بنوبات انتيابية من تغيم الوعي لفترة وجيزة (وربما تشوهات أخرى))\nمثال: خافت الفتاة من أول نوبة صرع صغيرة لها",
 "しょうほん": "نبذة – مقتطفات من",
 "しょうぼ": "تجنيد عام, نفير عام (فعل التجنيد في الخدمة العسكرية) / جباية, رسم مفروض (رسم يفرض ويحصل)",
 "しょうぼう": "إدارة الإطفاء, المطافئ (إدارة تابعة للحكومة المحلية مسؤولة عن منع الحرائق وإخمادها) / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / زهيرة (زهرة صغيرة (خاصة تلك التي تكون جزءًا من زهرة مركبة))",
 "しょうぼうぐみ": "فِرْقَة مَطَافِئ / إِطْفَائِيَّة, فِرْقَة مَطَافِئ",
 "しょうぼうし": "إِطْفَائِيّ\nمثال: 私の夢は消防士になる事だ。 — أريد أن أكون رجل إطفاء.",
 "しょうぼうしゃ": "حَرِيق مُحَرِّك, سَيَّارَة إطْفَاء حَرِيق (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "しょうぼうしゃりょう": "حَرِيق مُحَرِّك, سَيَّارَة إطْفَاء حَرِيق (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "しょうぼうしょ": "مَرْكَز إطْفَاء (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "しょうぼうしょいん": "مَرْكَز إطْفَاء (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "しょうぼうしょちょう": "رَئِيس الإِطْفاء, مَأْمُور الإِطْفاء (رئيس إدارة الإطفاء) / رئيس الإطفاء, مأمور إطفاء (مسؤول عن الوقاية من الحرائق والتحقيق فيها)",
 "しょうぼうじどうしゃ": "حَرِيق مُحَرِّك, سَيَّارَة إطْفَاء حَرِيق (النَار المشتعلة في شيء كالدَار او الغَابَة)\nمثال: أين هو الحريق إذا؟",
 "しょうぼうせん": "قارب إطفاء (قارب مجهز لمكافحة الحرائق على السفن أو على طول الواجهة البحرية)",
 "しょうぼうたい": "فِرْقَة مَطَافِئ / إِطْفَائِيَّة, فِرْقَة مَطَافِئ",
 "しょうぼうだん": "إدارة الإطفاء, المطافئ (إدارة تابعة للحكومة المحلية مسؤولة عن منع الحرائق وإخمادها)",
 "しょうぼうてい": "قارب إطفاء (قارب مجهز لمكافحة الحرائق على السفن أو على طول الواجهة البحرية)",
 "しょうぼうふ": "لعبة الإطفائي (لعب يتظاهر فيه الأطفال بإخماد حريق) / رجل إطفاء (عضو ذكر في قسم الإطفاء يحاول إخماد الحرائق) / رامٍ بديل (رامٍ ذكر (في البيسبول) لا يبدأ المباراة (يتم استدعاؤه لإنقاذ الموقف)) / وقاد (عامل ذكر يقوم بتغذية النيران (كما في القطارات التي تعمل بالفحم أو السفن البخارية))",
 "しょうぼうほんぶ": "إدارة الإطفاء, المطافئ (إدارة تابعة للحكومة المحلية مسؤولة عن منع الحرائق وإخمادها)",
 "しょうま": "اِنْجِرَاف",
 "しょうまい": "أخت صغرى (أخت أصغر سناً) / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / أرز أبيض (أرز تمت إزالة القشرة أو الطبقات البنية الخارجية منه)",
 "しょうまく": "غشاء مصلي (غشاء رقيق يبطن التجاويف المغلقة للجسم؛ له طبقتان بينهما مساحة مليئة بسائل مصلي) / كوريون, مشيمة (الكيس الغشائي الخارجي الذي يحيط بالجنين في الفقاريات العليا (الزواحف والطيور والثدييات))",
 "しょうみ": "مذاق, نكهة (تجربة التذوق عند وضع طعام متبل في الفم) / تلذذ, شغف (استمتاع قوي ومتحمس) / ريليش, مقبلات مخللة (تابل حار أو لذيذ) / شَبَكَة, شبكة / اَلْوَزْن اَلصَّافِي",
 "しょうみきげん": "تاريخ انهاء الصلاحية (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "しょうみじゅうりょう": "اَلْوَزْن اَلصَّافِي",
 "しょうみつ": "دَقِيقَة, دِقيقة (وِحْدَة زَمَنِيَّة تساوي ستين ثَانِيَة، وجزءًا من ستّين جزءًا من السَّاعَة؛ في : وحدة لقياس خطوط الطول والعرض) / لَحْظَة / دَقِيقٌ, تَافِهٌ (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: استأذنت لدقيقة.",
 "しょうむ": "تَقَاضٍ",
 "しょうむしょう": "وزارة التجارة (الإدارة الفيدرالية الأمريكية التي تعزز وتدير التجارة المحلية والخارجية (بما في ذلك إدارة التعداد ومكتب براءات الاختراع)؛ أنشئت عام 1913)",
 "しょうめい": "دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / إِضَاءَة / بُرْهَان, دَلِيل / مَشْعَل / شُعْلَة",
 "しょうめいおわり": "ديناميكا كهربائية كمية (نظرية كمية نسبية للتفاعلات الكهرومغناطيسية للفوتونات والإلكترونات والميونات)",
 "しょうめいしゃしんき": "كُشْك تَصْوِير (هو الكِشْك في بعض اللهجات العربية؛ شبه رِوَاق بارز عن مساواة بقية البيت)",
 "しょうめいしゅうりょう": "ديناميكا كهربائية كمية (نظرية كمية نسبية للتفاعلات الكهرومغناطيسية للفوتونات والإلكترونات والميونات)",
 "しょうめいしょ": "شَهَادَة",
 "しょうめいしょう": "شَهَادَة",
 "しょうめいせきにん": "عِبْء الإثْبات, عِبْء البَيِّنة (عِبْء: اسم؛ الحمل الثقيل. \"يحمل على كاهله عبأً\") / التزام بتقديم الدليل, التزامات بتقديم الدليل",
 "しょうめいだん": "كرة طائرة قصيرة ((بيسبول) كرة طائرة تضرب لمسافة قصيرة في الملعب الخارجي) / تمريرة جانبية (تمريرة أمامية قصيرة لظهير يركض نحو الخطوط الجانبية) / شعلة ضوئية, مشعل (جهاز ينتج ضوءاً ساطعاً للتحذير أو الإضاءة أو تحديد الهوية) / توهج, وميض (انفجار ضوئي يستخدم للتواصل أو الإضاءة)",
 "しょうめいりょく": "مِصْدَاقِيّة",
 "しょうめつ": "اِنْقِرَاض / إِفْنَاء, تَدْمِير / إِفْنَاء",
 "しょうめつじこう": "قانون التقادم (قانون يحدد الفترة الزمنية التي يمكن خلالها اتخاذ إجراء قانوني)",
 "しょうめん": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / جَانِب\nمثال: هناك ثقوب على السطح. / جَبْهَة / أَمَامِيّ\nمثال: 正面のドアは鍵がかかったままだった。 — ظل الباب مغلقاً.",
 "しょうめんから": "جَبْهِيّ, مُوَاجِه (يلتقي وجهاً لوجه بشكل مباشر) / بمقدمته, وجهاً لوجه (مع المقدمة أولاً) / بشكل مباشر, بمواجهة (في معارضة مباشرة؛ مباشرة) / مُبَاشِر, مُوَاجِه (يتَّسم بالمعارضة المباشرة وجهاً لوجه)\nمثال: اصطدمت السيارات وجهاً لوجه",
 "しょうめんきって": "بشكل علني, بصراحة (بطريقة مفتوحة)\nمثال: تباهى علانية بعاطفته تجاه أخته",
 "しょうめんぐち": "باب أمامي, مدخل أمامي (باب خارجي (عند المدخل) في واجهة المبنى)",
 "しょうめんげんかん": "باب أمامي, مدخل أمامي (باب خارجي (عند المدخل) في واجهة المبنى)",
 "しょうめんしょうとつ": "جَبْهِيّ, مُوَاجِه (يلتقي وجهاً لوجه بشكل مباشر) / بمقدمته, وجهاً لوجه (مع المقدمة أولاً) / بشكل مباشر, بمواجهة (في معارضة مباشرة؛ مباشرة) / مُبَاشِر, مُوَاجِه (يتَّسم بالمعارضة المباشرة وجهاً لوجه)\nمثال: اصطدمت السيارات وجهاً لوجه",
 "しょうもう": "إعياء, إنهاك (عملية استنفاد شيء ما بالكامل) / إعياء, إنهاك (ضعف خطير وفقدان للطاقة) / إجهاد شديد, إنهاك (تعب شديد) / ثرب صغير (جزء من الصفاق متصل بالمعدة والكبد ويدعم الأوعية الكبدية)",
 "しょうもうせん": "حَرْب اِسْتِنْزاف (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "しょうもうてき": "حاصر",
 "しょうもない": "غَبِيّ / غَبِيّ, أَحْمَق / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "しょうもん": "رباط, وصلة تثبيت (وصلة تثبت الأشياء ببعضها البعض) / صفد, قيد (قيد يحد أو يقيد الحرية (خاصة شيء يستخدم لربط أو تقييد سجين)) / التصاق, تلاصق (خاصية الالتصاق معاً (كالغراء والخشب) أو انضمام أسطح مختلفة التكوين) / رابطة, رابطة كيميائية (قوة كهربائية تربط الذرات)\nمثال: الالتصاق المتبادل للخلايا",
 "しょうもんふくらい": "حسن طالع, ضربة حظ (جَمِيل؛ مُبْهِج) / توفيق, حسن الحظ (حالة ميمونة ناتجة عن نتائج إيجابية)\nمثال: إيمي فتاة حسنة.",
 "しょうもんらいふく": "حسن طالع, ضربة حظ (جَمِيل؛ مُبْهِج) / توفيق, حسن الحظ (حالة ميمونة ناتجة عن نتائج إيجابية)\nمثال: إيمي فتاة حسنة.",
 "しょうやきょく": "ديفرتيمنتو, سيريناد (تأليف موسيقي في عدة حركات؛ ليس له شكل ثابت) / أغنية مسائية, سيريناد (أغنية تُلعب بشكل مميز خارج منزل امرأة)",
 "しょうやく": "بَارُود",
 "しょうゆ": "صَلْصَةْ اَلصُّويَا",
 "しょうゆう": "صَلْصَةْ اَلصُّويَا",
 "しょうゆうせい": "بَنَاتُ نَعْشٍ الصُّغْرَى, الدُّب الْأَصْغَر",
 "しょうゆかす": "صَلْصَةْ اَلصُّويَا",
 "しょうゆさし": "صَلْصَةْ اَلصُّويَا",
 "しょうゆざら": "صَلْصَةْ اَلصُّويَا",
 "しょうゆラーメン": "صَلْصَةْ اَلصُّويَا",
 "しょうよ": "عِلَاوَة / مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "しょうよう": "شَرِكَة / عَمَل, تِجَارَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / رِعَايَة\nمثال: المهم هو العمل. / تجوال, هيام (السفر دون وجهة واضحة) / بِلَا مَسَار ثَابِت, شَارِد (ليس له مسار محدّد أو ثابت) / بَدَوِيّ, رَحَّال (يتنقّل من مكان لآخر دون استقرار)\nمثال: تبعته في ترحاله واعتنت به / تجوال بلا وجهة, تسكع (تجوال بلا هدف في مسار متعرج) / مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى / تبول (إخراج البول) / هَادِئ / طَمْأَنَ / نَصِيحَة, مَشُورَة / فص (نتوء مستدير يُعد جزءاً من هيكل أكبر) / فص ((في التشريح) قسم فرعي مستدير نوعاً ما لعضو أو جزء جسدي) / فص (الاستجابة المعززة لهوائي في اتجاه معين كما هو موضح بواسطة حلقة في نمط إشعاعه) / فَصّ ((في علم النبات) جزء تنقسم إليه الورقة)\nمثال: شحمة الأذن / شرفة, وريقة (سديلة مثلثة رقيقة لصمام القلب) / كتيب, كراسة (كتاب صغير عادة ما يكون له غطاء ورقي) / وريقة (جزء من ورقة مركبة)",
 "しょうようか": "إضفاء الطابع التجاري, تسويق تجاري (فعل جعل الشيء تجارياً؛ إدخال شيء ما في التجارة)\nمثال: اعتبر والدي تحويل عيد الميلاد إلى مناسبة تجارية تدنيساً للمقدسات",
 "しょうようじじゃく": "لَا يَتَزَعْزَع, وَقُور (لا يسهل إزعاجه أو إثارته؛ يتّسم بهدوء وضبط نفس شديدَين)",
 "しょうようせい": "آلْف",
 "しょうよきん": "تشجيع, حافز (تأثير تحفيزي إيجابي) / حافز, مكافأة (دفعة إضافية (أو مكافأة أخرى) للموظفين كوسيلة لزيادة الإنتاج)",
 "しょうよく": "قَلِيلًا",
 "しょうよくう": "الجَنَاحُ الكَاذِب, جُنَيْح (خصلة من الريش الصغير الصلب على الإصبع الأول لجناح الطائر) / جُنَيْح, مِقْرَنَة (هيكل يشبه الحرشفة يقع بين قاعدة الجناح والدبوس في الذباب ثنائي الجناحين)",
 "しょうら": "لحية العجوز, ياسمين بري فرجيني (نبات متسلق شائع في شرق أمريكا الشمالية يمتد فوق النباتات الأخرى ويحمل عناقيد عديدة من الزهور البيضاء الكريمية الصغيرة) / فرحة المسافر, لحية العجوز (نبات متسلق نفضي قوي من أوروبا إلى أفغانستان ولبنان ذو عناقيد من الزهور البيضاء المخضرة العطرة في الصيف والخريف) / طحلب إسباني, لحية العجوز (أكاليل كثيفة من خيوط مرنة تشبه الشعر بلون رمادي مخضر مثبتة بجذوع الأشجار وفروعها بواسطة جذور سلكية متفرقة؛ جنوب شرق الولايات المتحدة وجزر الهند…) / شجرة الصنوبر, صنوبر (شجرة صنوبرية)",
 "しょうらい": "مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل / تسليم, توصيل (عملية تسليم أو توزيع شيء ما (كالبضائع أو البريد))\nمثال: تسليمه المتردد للأخبار السيئة / إحداث, تسبيب (فعل التسبب في حدوث شيء ما) / دَعْوَة, عزيمة / إِغْرَاء / إحداث, تسبيب (فعل التسبب في حدوث شيء ما) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: كان كسولاً بطبعه",
 "しょうらいせい": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها.",
 "しょうらいてき": "مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل",
 "しょうらん": "قِرَاءَة / بويضة صغيرة (بويضة صغيرة أو غير ناضجة) / بويضة (جسم صغير يحتوي على الخلية الجرثومية الأنثوية للنبات؛ يتطور إلى بذرة بعد الإخصاب)",
 "しょうり": "اِنْتِصَار, نَصْر / سيادة القانون (حالة من النظام تتوافق فيها الأحداث مع القانون)",
 "しょうりしゃ": "فَائِز, فَائِزَة",
 "しょうりゃく": "إِغْفَال / اِخْتِصَار",
 "しょうりゃくきごう": "حَذْف, إِضْمَار (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ؛ حَذَفَهُ بِالعَصَا: ضَرَبَهُ ، ورَمَاهُ بِها)\nمثال: حذف ياني حسابه.",
 "しょうりゃくけい": "اِخْتِصَار",
 "しょうりゃくじ": "تَخَلُّف, تَغَيُّب (خسارة بسبب عدم الحضور) / خيار افتراضي (خيار يتم تحديده تلقائياً ما لم يتم تحديد بديل) / تخلف عن الدفع, عدم السداد (خسارة ناتجة عن عدم سداد دين) / تخلف عن السداد, تعثر (فعل الفشل في الوفاء بالتزام مالي)\nمثال: خسر المباراة بالتغيب",
 "しょうりゃくふごう": "نقاط الحذف (واحدة من سلسلة من النقاط ('؛') تشير إلى أن شيئاً ما قد تم حذفه أو أن الجملة غير مكتملة)",
 "しょうりゅう": "قناة توزيع (طريقة لبيع منتج الشركة إما مباشرة أو عبر موزعين)",
 "しょうりょ": "نَفَاد صَبْر",
 "しょうりょう": "اهتمام, مراعاة (عمل ينم عن مراعاة وتفكير بالآخرين) / اهتمام بالآخرين, مراعاة (احترام ومراعاة لطيفة للآخرين) / اعتبار, نظر (عملية التفكير المتأني في شيء ما) / اعتبار, حالة (معلومات يجب وضعها في الاعتبار عند اتخاذ قرار)\nمثال: لم يظهر أي مراعاة لمشاعرها / مُقْفِر, مَهْجُور / وَزْن / صَعْو / وَصْع / آمِر, مُقَدَّم",
 "しょうりょうけいこつ": "عظم منحرف (عظم الرسغ الواقع بين العظم المربعي والعظم الكبير)",
 "しょうりょこう": "جَوْلَة, نُزْهَة",
 "しょうりをおさめる": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "しょうるい": "شَيْء حَيّ, كَائِن حَيّ (كيان حيّ أو كان حيًّا في وقت ما)",
 "しょうれい": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع) / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / عُلْبَة / حَالَات / دَعْوَى (إدِّعَاء؛ دُعَاء) / عُلَب\nمثال: سأرفع عليك قضية.",
 "しょうれいきん": "إِعَانَة مَالِيَّة",
 "しょうれいしょう": "تنويه شرفي, ذكر مشرف (اعتراف رسمي بالاستحقاق)\nمثال: على الرغم من أنه لم يفز بالجائزة، إلا أنه حصل على تنويه خاص",
 "しょうろう": "برج الجرس, غرفة الجرس (غرفة (غالباً في قمة برج) تعلق فيها الأجراس) / برج الناقوس, منارة الجرس (برج جرس؛ عادة ما يقف منفرداً غير متصل بمبنى) / قِمَّة / بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "しょうろく": "اقتباس (ممارسة الاقتباس من الكتب أو المسرحيات وغيرها) / اقتباس (مقطع أو تعبير مقتبس أو مستشهد به) / تسعيرة, سعر السوق (بيان لسعر السوق الحالي لورقة مالية أو سلعة) / إشارة مرجعية, استشهاد (ملاحظة قصيرة تعترف بمصدر المعلومات أو فقرة مقتبسة)\nمثال: بما أنه يفتقر إلى الأصالة، يجب عليه الاعتماد على الاقتباس",
 "しょうろんぶん": "مَنْشُور, كُرَّاسَة",
 "しょうわ": "نَادِرَة / أُطْرُوفَة / أُفْكُوهَة / طُرْفَة / فُكَاهَة / لَطِيفَة (مؤنث لَطِيْف؛ ذات اللطف والطافة؛ يقصد بها أحيانا جميلة بدون أن تكون ملفتة للنظر)\nمثال: هي مدرسة لطيفة. / عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "しょうわくせい": "كُوَيْكِب",
 "しょうわくせいたい": "حِزَام كُوَيْكِبَات (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر)\nمثال: هذا حزام من الجلد.",
 "しょうわる": "سيء الطباع, فظ (ذو طبع سريع الغضب وغير سار)",
 "しょうをかえす": "شقلبة خلفية (شقلبة هوائية للخلف) / دائرة قلابة, قلاب (دائرة إلكترونية يمكن أن تتخذ إحدى حالتين مستقرتين) / شبشب بإصبع (صندل بدون ظهر يثبت في القدم بواسطة شريط بين إصبع القدم الكبير والإصبع الثاني) / انقلاب, تراجع (قرار بعكس قرار سابق)",
 "しょうアジア": "آسِيَا الصُّغْرَى (إحدى القارات السبع؛ أكبرها مساحةً، وأكثرها سكانًا)\nمثال: على شعوب آسيا أن تتعاون.",
 "しょうカッコ": "حشو",
 "しょうジョッキ": "تفاهة, شيء تافه (شيء قليل الأهمية)",
 "しょうテスト": "اِخْتِبَار (اختبر الشّيء:خبره)\nمثال: تم اختبار زيري.",
 "しょうブル": "البرجوازية الصغيرة (الطبقة المتوسطة الدنيا (مثل أصحاب المتاجر والموظفين الكتابيين)) / برجوازي صغير (عضو في الطبقة المتوسطة الدنيا)",
 "しょうブルジョア": "البرجوازية الصغيرة (الطبقة المتوسطة الدنيا (مثل أصحاب المتاجر والموظفين الكتابيين)) / برجوازي صغير (عضو في الطبقة المتوسطة الدنيا)",
 "しょうレース": "مُنَافَسَة, مُبَارَاة / مُنَافَسَة, مُسَابَقَة",
 "しょうロシア": "أُوكْرَانِيَا (دولة تقع في شرق قارة أوروبا، وتحد الساحل الشمالي من البحر الأسود؛ أُسِّسَت كدولة مستقلة بعد سقوط الاتحاد السوفياتي عام ١٩٩١…)\nمثال: المجد لأوكرانيا",
 "しょう液": "عَصِير (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟",
 "しょえん": "صِلَة, صُلَة / عَلَاقَة, صِلَة / الْعَرْضُ ٱلْأَوَّل",
 "しょか": "رَفّ كُتُب, رَفُّ الْكُتُب (رَفَّتْ أَوْراقُ الشَّجَرِ: اِهْتَزَّتْ، تَحَرَّكَتْ؛ رَفَّتِ العَيْنُ: رَمَّشَتْ)\nمثال: وضع الكتاب على الرف. / خَطَّاط",
 "しょかい": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة.",
 "しょかく": "حالة الظرفية المكانية, حالة المكان (حالة تستخدم للإشارة إلى المكان، أو المكان الذي يحدث فيه الشيء)",
 "しょかつ": "قَضَاء / اِخْتِصَاص",
 "しょかつけいさつしょ": "مَرْكَز شُرْطَة, مَرْكِز شُرْطَة (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "しょかつしょ": "مَرْكَز شُرْطَة, مَرْكِز شُرْطَة (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "しょかん": "اِنْطِبَاع, أَثَر / تَقْلِيد / قَضَاء / اِخْتِصَاص / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء. / صُنْدُوق بَرِيد, صَنْدُوق بَرِيد (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق)\nمثال: أين صندوق البريد؟ / كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد",
 "しょかんせん": "قرطاسية, ورق مراسلات (ورق مقصوص بحجم مناسب لكتابة الرسائل؛ عادة مع مظاريف مطابقة) / ورق رسائل (ورق كتابة للاستخدام في كتابة المراسلات)",
 "しょがくしゃ": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "しょがん": "أُمْنِيَّة / رَغْبَة / مُنْيَة / تَمَنَّى",
 "しょき": "بداية, حداثة (فترة مبكرة من التطور)\nمثال: خلال حداثة المشروع / مُوَظَّف / مُوَظَّفَة / رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب. / متوقع, منتظر (يعتبر محتملاً أو مرجح الحدوث أو الوصول)\nمثال: استعد للهجوم المتوقع / مَدْلُول, مَعْنًى (معنى كلمة أو تعبير؛ الطريقة التي يمكن بها تفسير كلمة أو تعبير أو موقف)\nمثال: قدم القاموس عدة معانٍ للكلمة",
 "しょきあたり": "ضربة شمس, فرط الحرارة (انهيار ناتج عن التعرض للحرارة المفرطة)",
 "しょきか": "تهيئة منخفضة المستوى ((علوم الكمبيوتر) تنسيق القطاعات على سطح محرك الأقراص الثابتة حتى يتمكن نظام التشغيل من الوصول إليها وتحديد موضع البداية) / تنسيق, صيغة البيانات (تنظيم المعلومات وفقاً لمواصفات محددة مسبقاً (عادة للمعالجة الحاسوبية))",
 "しょきかん": "سِكْرِتِير, سِكْرِتِيرَة",
 "しょききょく": "أمانة عامة, سكرتارية (وحدة إدارية مسؤولة عن حفظ السجلات والواجبات الكتابية الأخرى؛ خاصة للمنظمات الدولية)",
 "しょきげんご": "تَوَاصُل كِتَابِيّ, لُغَة مَكْتُوبَة (التواصل بوساطة رموز مكتوبة، سواء أكانت مطبوعة أم مخطوطة)",
 "しょきせってい": "تهيئة منخفضة المستوى ((علوم الكمبيوتر) تنسيق القطاعات على سطح محرك الأقراص الثابتة حتى يتمكن نظام التشغيل من الوصول إليها وتحديد موضع البداية)",
 "しょきそ": "حرف, رمز كتابي (رمز مكتوب يُستخدم لتمثيل الكلام)\nمثال: الأبجدية اليونانية تحتوي على 24 حرفاً",
 "しょきたいけい": "إملاء, رسم الحروف (طريقة لتمثيل أصوات لغة ما بواسطة رموز مكتوبة أو مطبوعة)",
 "しょきち": "تغذية وريدية (إعطاء المغذيات عبر الوريد) / أَرْبَعَة (يَدُلُّ عَلَى العَدَد 4) / أَرْبَعَة, رُبَاعِيّ (العدد الأصلي الذي هو مجموع ثلاثة وواحد)",
 "しょきちょう": "أَمِين عَامّ (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "しょきゅう": "عُقَاب نُسَارِيّ, عُقَاب نُسَارِيَّة (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر. / مَكْتَبَة, خِزَانَةُ الْكُتُب",
 "しょきゅうしゃ": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "しょきょうこんこう": "توفيق صيغي (دمج الأشكال المصرفة التي كانت مختلفة أصلاً (مما يؤدي إلى تقليل استخدام التصريفات)) / تلفيقية, توفيقية (اتحاد (أو محاولة دمج) أنظمة فكرية أو معتقدات مختلفة (خاصة في الدين أو الفلسفة))\nمثال: توفيقية بين النظريات المادية وغير المادية",
 "しょぎ": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم.",
 "しょぎょう": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / مَثَّلَ (الشَبَه؛ النَظِير) / تَصَرَّفَ\nمثال: المهم هو العمل.",
 "しょく": "مَهَمَّة / عَمَل, وَظِيفَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل. / وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب. / تِجَارَة / شخص عادي, علماني (رجل ليس رجل دين أو شخصاً محترفاً) / شَائِع / بَذِيء / جَدْوَل / طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام. / أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / وَجْبَة, أكلة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة. / لَوْن, لون (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد) / لَوَّنَ (صفة خارجة للشيء ترى بالعين فقط ولا تلمس أو تسمع أو تشم أو يمكن تذوقها؛ كناية عن النَوع أو الشكل أو مجموعة من الصفات المختلفة في جنس واحد)\nمثال: ما هو لون شعرك؟ / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / تَعْبِير / تَعْبِير, عِبَارَة / سِيمَاء / مَيْل, نَزَعَة / تكملة, جزء تالٍ (جزء يضاف إلى كتاب أو مسرحية يكملها ويوسعها) / تتمة, تكملة (شيء يتبع شيئاً آخر) / إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة / نُور, ضَوْء (ضد الظَلام؛ ما يشع فيمكن الرؤية بسببه؛ ضد الضوء:ما يشع من أصله وليس ما يعكس الشعاع من غيره) / أَشْعَلَ, أَوْقَدَ ((أَشْعَلَ) النارَ: شَعَلها؛ يقال أَشْعَلَ فلانًا: هيَّج غَضبَه) / أَضَاءَ / مُنِير / فَاتِح (الرجلُ المرأةَ: جامعها؛ عمرٌ زيدًا: قاضاه وحاكمه) / خَفِيف / خفيف\nمثال: نسي أن يطفئ النور. / سِيشْوَان, سِيتْشْوَان / كُسُوف, خُسُوف",
 "しょくあたり": "اضطراب معوي, تسمم غذائي (مرض ناتج عن طعام سام أو ملوث)",
 "しょくいん": "عضو هيئة, موظف (موظف يكون عضواً في هيئة عاملين (خاصة عضو في الطاقم الذي يعمل لرئيس الولايات المتحدة))\nمثال: 職員以外入室禁止。 — الدخول للموظفين فقط.",
 "しょくえん": "ملح, ملح الطعام (شكل بلوري أبيض لكلوريد الصوديوم خاصة يستخدم لتتبيل وحفظ الطعام)",
 "しょくえんそうとうりょう": "كُلُورِيد الصُودِيُوم",
 "しょくえんふしよう": "غَيْرُ مُتَبَّل, غَيْرُ مُمَلَّح (بِدُونِ مِلْحٍ أَوْ تَوَابِل)",
 "しょくぎょう": "وَظِيفَة, مِهْنَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِحْتِلال, إِشْغَال (احتلّ: نزل؛ احتلّ به واحتلّه: نزل به، واحتلّ الشيء: اتّخذه حلالاً)\nمثال: ما وظيفة زوجتك؟",
 "しょくぎょうがっこう": "مدرسة صناعية, مدرسة مهنية (مدرسة ثانوية تُعلّم الحرف الماهرة)",
 "しょくぎょうきょういく": "تدريب مهني, تعليم مهني (التدريب لمهنة محددة في الصناعة أو الزراعة أو التجارة)",
 "しょくぎょうくんれんたんきだいがっこう": "تدريب مهني, تعليم مهني (التدريب لمهنة محددة في الصناعة أو الزراعة أو التجارة)",
 "しょくぎょうしゅうだん": "مجموعة مهنية, مهنة (مجموعة من الناس يقومون بنفس نوع العمل)",
 "しょくぎょうしょうかいじょ": "وَكَالَة تَوْظِيف",
 "しょくぎょうじん": "مُحْتَرِف, مُحْتَرِفَة",
 "しょくぎょうてき": "مُحْتَرِف, مُحْتَرِفَة",
 "しょくぎょうびょう": "مرض مهني (مرض أو إعاقة ناتجة عن ظروف العمل)",
 "しょくぎょうふじん": "امرأة مهنية (امرأة تهتم بمسيرتها المهنية)",
 "しょくぎょうべつくみあい": "نقابة حرفية (نقابة عمالية تقتصر عضويتها على العمال في حرفة معينة)",
 "しょくぎょうやきゅう": "بيسبول المحترفين (لعب البيسبول مقابل المال)",
 "しょくぎょうリハビリテーション": "تأهيل مهني (توفير التدريب في مهنة محددة بهدف الحصول على عمل)",
 "しょくさい": "زراعة, غرس (وضع البذور أو النباتات الصغيرة في الأرض لتنمو) / زرع, غرس (فعل التثبيت بإحكام في المكان) / مشجر, مغرس (مجموعة من النباتات (أشجار أو شجيرات أو زهور) في منطقة معينة)\nمثال: زراعة الذرة عمل شاق",
 "しょくさいぼう": "بلعم, خلية بلعمية (خلية تبتلع وتهضم الحطام والكائنات الحية الدقيقة الغازية)",
 "しょくさよう": "بلعمة (عملية تقوم فيها الخلايا البلعمية بابتلاع وهضم الكائنات الحية الدقيقة والحطام الخلوي؛ دفاع مهم ضد العدوى)",
 "しょくざい": "كَفَّارَة / كسب المال (فعل جني المال (وتراكم الثروة)) / مُدِرّ لِلْأَرْبَاح, مُرْبِح جِدًّا (ينتج ربحًا كبيرًا ووافرًا) / بقالة, مواد غذائية (سلع استهلاكية تباع عند البقال) / مادة غذائية, منتج غذائي (مادة يمكن استخدامها أو تحضيرها للاستخدام كطعام)",
 "しょくざいのひ": "يَوْم الْكَفَّارَة, يَوْم الْغُفْرَان (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "しょくざいのやぎ": "كَبْش فِدَاء",
 "しょくし": "سبابة (الإصبع المجاور للإبهام) / مِدَكّ",
 "しょくしき": "غُول",
 "しょくしゅ": "قرن استشعار, ملمس (واحدة من زوج من الزوائد المتحركة على رأس الحشرات والقشريات؛ حساسة عادة للمس والتذوق) / بربيس, زائدة استشعارية (نتوء لمسي رفيع على فكي السمكة) / استشعار, حدس (حساسية تشبه حساسية عضو الاستقبال الحسي) / جَسّ نَبْض, مُبَادَرَة (اقتراح مبدئي مصمم لاستنباط ردود فعل الآخرين)\nمثال: كان لديه استشعار خاص للعلاقات العامة / مُؤَثِّر / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي!",
 "しょくしゅうかん": "عَادَات اَلْأَكْل",
 "しょくしょ": "قيط, نوط الكتف (حبل أو جديلة زخرفية على كتف الزي الرسمي)",
 "しょくしょう": "مَهَمَّة / إفراط في الأكل, تخمة (الأكل حتى الامتلاء المفرط) / إغراق, تخمة (صفة الوفرة المفرطة لدرجة انخفاض الأسعار) / إفراط, تخمة (حالة الامتلاء بأكثر من اللازم) / اضطراب معوي, تسمم غذائي (مرض ناتج عن طعام سام أو ملوث)",
 "しょくしん": "جس (طريقة للفحص يشعر فيها الفاحص بحجم أو شكل أو صلابة أو موقع شيء ما (أو أجزاء الجسم عندما يكون الفاحص محترفاً صحياً))",
 "しょくじ": "تَنْضِيد / وَجْبَة, أكلة (الحصة التي صارت واجبة؛ الحصة الواحدة من الطعام توجب في موعد محدد)\nمثال: التهم زيري الوجبة. / حِمْيَة, حِمْيَة غِذَائِيَّة / حِمْيَة, نِظَام غِذَائِيّ / بَرْلَمَان, مَجْلِس / طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام. / وقت الطعام, وقت الوجبة (الساعة التي تُؤكل فيها وجبة عادة أو عرفاً)",
 "しょくじかい": "حفل عشاء, عزومة عشاء (حفلة يجتمع فيها الناس لتناول العشاء معاً)\nمثال: يجب ألا يتأخر الضيوف عن حفل العشاء أبداً",
 "しょくじき": "آلة تنضيد الحروف (طابعة تضبط المواد النصية في شكل حروف)",
 "しょくじけん": "تذكرة طعام, قسيمة وجبة (قسيمة قابلة للاسترداد في مطعم وتخول حاملها الحصول على وجبة) / مصدر دخل (مصدر للدخل أو الرزق)",
 "しょくじこう": "صفاف, منضد الحروف (شخص يصف المواد المكتوبة في قوالب الطباعة)",
 "しょくじどき": "وقت الطعام, وقت الوجبة (الساعة التي تُؤكل فيها وجبة عادة أو عرفاً)",
 "しょくじどころ": "مَطْعَم",
 "しょくじゅさい": "عيد الشجرة (يوم مخصص لغرس الأشجار)",
 "しょくじょ": "اَلنَّسْر اَلْوَاقِع",
 "しょくじょう": "دَبُّوس / قِشْرَةُ جَوْزِ الطِيبِ, بَسْبَاس",
 "しょくじょせい": "اَلنَّسْر اَلْوَاقِع",
 "しょくじりょうほうがく": "علم الحمية, نظام غذائي (الدراسة العلمية لإعداد الطعام وتناوله)",
 "しょくじん": "أكل لحوم الجنس الواحد (ممارسة أكل لحم جنسك)",
 "しょくじんしゅ": "غُول, آكِلُ لُحُوم البَشْر",
 "しょくじんぞく": "غُول, آكِلُ لُحُوم البَشْر",
 "しょくす": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / خَلّ ((خَلَّ) خلا وخلولا: صار فيه خلل؛ (خَلَّ) لحمه: قل ونحف)\nمثال: تذوق زيري ذلك الخل. / أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "しょくする": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "しょくず": "خَلّ ((خَلَّ) خلا وخلولا: صار فيه خلل؛ (خَلَّ) لحمه: قل ونحف)\nمثال: تذوق زيري ذلك الخل.",
 "しょくせい": "خُضْرَة, عَشَابَة / إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "しょくせいかつ": "عَادَات اَلْأَكْل",
 "しょくせんき": "غَسَّالَة صُحُون (صيغة مبالغة من غَسَلَ بمعنى الذي يغسل كثيرا. تجمع على غسّالات وغواسل؛ المرأة التي تتخذ من غسل الملابس مهنة لها. تجمع على غسّالات)\nمثال: تعطلت الغسالة مجددا.",
 "しょくぜん": "سُفْرَة (طَعَامُ الْمُسَافِرِ؛ مَائِدَةُ الطَّعَامِ)",
 "しょくぜんしゅ": "أبيرتيف, فاتح للشهية (مشروب كحولي يؤخذ قبل الوجبة لفتح الشهية)",
 "しょくたく": "عُمُولَة / وَظِيفَة بِدَوَامٍ جُزْئِيّ, عَمَل جُزْئِيّ (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟ / سُفْرَة (طَعَامُ الْمُسَافِرِ؛ مَائِدَةُ الطَّعَامِ)",
 "しょくたくえん": "ملح, ملح الطعام (شكل بلوري أبيض لكلوريد الصوديوم خاصة يستخدم لتتبيل وحفظ الطعام)",
 "しょくだい": "شَمْعَدَان, قِنْدِيل",
 "しょくち": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / متفرقات (أشياء متنوعة عديدة جداً أو صغيرة جداً بحيث لا يمكن تحديدها)",
 "しょくちゅう": "آكل الحشرات (أي كائن حي يتغذى بشكل أساسي على الحشرات) / آكل الحشرات (ثدييات صغيرة آكلة للحشرات ليلية بشكل رئيسي برية أو حفارة)",
 "しょくちゅうか": "نبات آكل للحشرات, نبات لاحم (نباتات متكيفة لجذب والتقاط وهضم الحشرات بشكل أساسي ولكن أيضاً الحيوانات الصغيرة الأخرى)",
 "しょくちゅうしょくぶつ": "نبات آكل للحشرات, نبات لاحم (نباتات متكيفة لجذب والتقاط وهضم الحشرات بشكل أساسي ولكن أيضاً الحيوانات الصغيرة الأخرى)",
 "しょくちゅうせい": "آكِل لِلْحَشَرَات ((للحيوانات والنباتات) يتغذى على الحشرات)",
 "しょくちゅうどく": "اضطراب معوي, تسمم غذائي (مرض ناتج عن طعام سام أو ملوث)",
 "しょくちょ": "قيط, نوط الكتف (حبل أو جديلة زخرفية على كتف الزي الرسمي)",
 "しょくちょう": "مُشْرِف, رَئِيس عُمَّال",
 "しょくつう": "شره, نهم (طبع وعادات الأكول) / ذَوَّاق",
 "しょくてん": "مَطْعَم",
 "しょくとう": "مِضَخَّة / ضَخّ",
 "しょくとして": "غَالِبًا",
 "しょくどう": "غَرْفَةْ الطَعَام, مَطْعَم (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة. / مَطْعَم / مريء (الممر بين البلعوم والمعدة)",
 "しょくどうえん": "التهاب المريء (التهاب المريء؛ غالباً ما يكون سببه الارتجاع المعدي المريئي)",
 "しょくどうきょう": "منظار المريء (أداة بصرية لفحص الجزء الداخلي من المريء)",
 "しょくどうしゃ": "حَافِلَة طَعَام (وسيلة نَقْل للركاب)\nمثال: لنذهب بالحافلة.",
 "しょくどうらく": "أكول, شرِه (شخص مفرط في الأكل والشرب)",
 "しょくにく": "لَحْم, لحمة (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر.",
 "しょくにくかいたい": "قتل جماعي, مجزرة (القتل الوحشي والمفرط لعدد كبير من الناس) / جزارة (عمل الجزار) / مذبح, مسلخ (مبنى يتم فيه ذبح الحيوانات)",
 "しょくにくかこう": "تعبئة اللحوم (تعبئة اللحوم بالجملة للبيع المستقبلي (بما في ذلك الذبح والمعالجة والتوزيع لتجار التجزئة))",
 "しょくにくしょくぶつ": "نبات آكل للحشرات, نبات لاحم (نباتات متكيفة لجذب والتقاط وهضم الحشرات بشكل أساسي ولكن أيضاً الحيوانات الصغيرة الأخرى)",
 "しょくにくるい": "لَاحِم (فِي حَيَوَانٌ لَاحِم هو الذي يتكون نظامه الغذائي أساسيا من اللُّحُومِ؛ النَّبَات اللََاجِم هو نبات يتغذى على اللحم؛غالباً الحشرات)",
 "しょくにくセンター": "مذبح, مسلخ (مبنى يتم فيه ذبح الحيوانات)",
 "しょくにん": "صَانِع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة) / حِرَفِيّ / حِرْفِيّ\nمثال: أحب أن أكون صانع محتوى.",
 "しょくにんげい": "إتقان, حرفة (المهارة في مهنة أو تجارة)",
 "しょくにんわざ": "إتقان, حرفة (المهارة في مهنة أو تجارة)",
 "しょくのう": "وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / مَهَمَّة / دَالَّة, تَابِع / وَظِيفَة, دَالَّة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "しょくのうだんたい": "جمعية مهنية, نقابة مهنية (رابطة للممارسين لمهنة معينة)",
 "しょくはつ": "زِنَاد",
 "しょくば": "مَكَان عَمَل (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "しょくばい": "حَفَّاز",
 "しょくばいさよう": "تحفيز, حفز (تسريع تفاعل كيميائي نتيجة وجود مادة لا تتغير كيميائياً في نهاية التفاعل)\nمثال: من بين أهم 50 مادة كيميائية أساسية، يتم إنشاء 30 منها مباشرة عن طريق التحفيز ويتم صنع 6 أخرى من مواد خام تم إنتاجها بطريقة التحفيز",
 "しょくばいどく": "سُمّ, سَمّ (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط) / سَمَّمَ, سَمَّ\nمثال: تناول سامي السم.",
 "しょくばほうき": "مَسِيرَة",
 "しょくひ": "طُعْم جِلْدِيّ (قطعة جلد تؤخذ من منطقة مانحة وتزرع جراحياً في موقع إصابة أو حرق)",
 "しょくひん": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "しょくひんいやくひんきょく": "إدارة الغذاء والدواء (وكالة فيدرالية في وزارة الصحة والخدمات الإنسانية تأسست لتنظيم إصدار الأطعمة الجديدة والمنتجات المتعلقة بالصحة)",
 "しょくひんがいしゃ": "شركة أغذية, شركة غذائية (شركة تقوم بمعالجة وبيع المواد الغذائية)",
 "しょくひんちゅうどく": "اضطراب معوي, تسمم غذائي (مرض ناتج عن طعام سام أو ملوث)",
 "しょくひんてん": "بِقَالَة, حَانُوت بَقَّال",
 "しょくひんてんかぶつ": "مادة مضافة للطعام, مضاف غذائي (مادة تضاف للطعام لتحسين نكهته أو مظهره أو فترة صلاحيته)",
 "しょくひんメーカー": "شركة أغذية, شركة غذائية (شركة تقوم بمعالجة وبيع المواد الغذائية)",
 "しょくひんロス": "قمامة, نفايات الطعام (طعام يتم التخلص منه (كما هو الحال من المطبخ))",
 "しょくふく": "زَيّ, زِي / ملابس عمل (ملابس تلبس للقيام بعمل يدوي)",
 "しょくふん": "أكل البراز (تناول البراز؛ يعد عرضًا لبعض أنواع الجنون عند البشر)",
 "しょくぶつ": "نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "しょくぶつえん": "حَدِيقَة نَبَاتِيَّة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة.",
 "しょくぶつかん": "حَدِيقَة نَبَاتِيَّة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة.",
 "しょくぶつがく": "عِلْم اَلنَّبَات (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "しょくぶつがくしゃ": "عالم نبات (عالم أحياء متخصص في دراسة النباتات)",
 "しょくぶつこうえん": "حَدِيقَة نَبَاتِيَّة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة.",
 "しょくぶつさいぼう": "خلية نباتية (خلية تشكل وحدة هيكلية ووظيفية للنبات)",
 "しょくぶつし": "حياة نباتية, فلورا ((علم النبات) كائن حي يفتقر إلى القدرة على الانتقال الحركي) / غطاء نباتي, فلورا (جميع الحياة النباتية في منطقة أو فترة معينة)\nمثال: نباتات العصر البليستوسيني",
 "しょくぶつしつ": "مادة نباتية (مادة تنتجها النباتات أو تنمو بطريقة نمو النبات)",
 "しょくぶつせい": "بوتاني, نباتي (من أو متعلق بالنباتات أو علم النبات) / دواء نباتي (دواء مصنوع من جزء من نبات (مثل اللحاء أو الجذر أو الأوراق))\nمثال: حديقة نباتية",
 "しょくぶつせいミルク": "حَلِيب نَبَاتِيّ (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "しょくぶつそう": "حياة نباتية, فلورا ((علم النبات) كائن حي يفتقر إلى القدرة على الانتقال الحركي) / غطاء نباتي, فلورا (جميع الحياة النباتية في منطقة أو فترة معينة)\nمثال: نباتات العصر البليستوسيني",
 "しょくぶつひょうほん": "مَعْشَبَة",
 "しょくぶつゆ": "زيت نباتي (أي من مجموعة الدهون السائلة الصالحة للأكل التي يتم الحصول عليها من النباتات)",
 "しょくぶつウイルス": "فيروس نباتي",
 "しょくぶつプランクトン": "عوالق نباتية, فيتوبلانكتون (مكون نباتي أو ضوئي التخليق من العوالق؛ يتكون أساساً من طحالب وحيدة الخلية)",
 "しょくぶつホルモン": "منظم نمو, هرمون نباتي ((علم النبات) منتج نباتي يعمل مثل الهرمون)",
 "しょくぶん": "رِسَالَة, نداء / حِرْفَة, مِهْنَة",
 "しょくぶんか": "طَبْخ, طَبِيخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ.",
 "しょくほう": "راتب, مخصص (مبلغ من المال يخصص بشكل منتظم؛ عادة لغرض محدد)",
 "しょくほうしょうねん": "جانح, حدث جانح (مذنب شاب)",
 "しょくほうせいしんしょうがいしゃ": "مَجْنُون, مَخْبُول",
 "しょくみ": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "しょくみん": "اِسْتِعْمَار",
 "しょくみんち": "مُسْتَعْمَرَة / مُسْتَعْمَرَة, مُسْتَمْلَكَة / مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "しょくみんちか": "اِسْتِعْمَار",
