 "どうとくてき": "أَخْلَاقِيّ",
 "どうど": "حَادِث إِصْطِدَام / اِنْهِيَار, اِنْهِيَار نِظَام (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل) / تَحَطَّمَ\nمثال: يوشك الجسر على الانهيار.",
 "どうどう": "رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "どうどくりょうほう": "مُعَالَجَة مَثَلِيَّة",
 "どうなか": "جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر) / خُرْطُوم / صَنْدُوق, صُنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / حَقِيبَة أَمْتِعَة, صُنْدُوقُ السَّيَّارَةِ\nمثال: أين صندوق البريد؟",
 "どうなん": "غُلَام, صَبِيّ",
 "どうにか": "بِطَرِيقَةٍ أَو بِأُخرَى",
 "どうにかなりそう": "مَجْنُون, مَخْبُول",
 "どうにも": "أبداً",
 "どうにもこうにも": "أبداً",
 "どうにもならない": "عَقِيم",
 "どうにゅう": "مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "どうにゅうぶ": "مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف) / رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
 "どうにょ": "بِنْت / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة) / طِفْلة / بنت / فتاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "どうにん": "طُغْمَة, عُصْبَة",
 "どうは": "إِعْلَان, بَيَان",
 "どうはい": "رَفِيق, رَفِيقَة",
 "どうはん": "رَافَقَ / صَاحَبَ, رَافَقَ (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "どうはんしゃ": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "どうふくし": "مِحَفَّة / بَعْثَرَ",
 "どうふけん": "مَبْنَى الْوِلَايَة (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص)) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى)\nمثال: دخل توم المبنى.",
 "どうぶ": "جِذْع, جِسْم (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر)",
 "どうぶつ": "حَيَوَان (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط) / حَيَوَان, وَحْش (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "どうぶつあいご": "حقوق الحيوان (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حق)\nمثال: الحقوق إنسانية.",
 "どうぶついめい": "مُرَادِف (اسم فاعل من الفعل \"رَادَفَ\"؛ (في علم دلالة الألفاظ) كلمة لها المعنى نفسه أو معنى قريب له لكلمة أخرى في اللغة)\nمثال: الانفصالي مرادف للعاهرة.",
 "どうぶつえん": "حَدِيقَة الْحَيَوَان, حَدِيقَة حَيَوَان (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة.",
 "どうぶつかい": "الْمَمْلَكَة الْحَيَوَانِيَّة",
 "どうぶつがく": "عِلْم اَلْحَيَوَان (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "どうぶつこうえん": "حَدِيقَة الْحَيَوَان, حَدِيقَة حَيَوَان (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…)\nمثال: ليس لدينا حديقة.",
 "どうぶつしゅうようじょ": "بَاوْنْد / رَطْل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ) / جُنَيْه",
 "どうぶつじっけん": "تَجَارِبُ عَلَى الْحَيْوَان (نطق أقل فصاحة لكلمة تَجَارِب)\nمثال: عاش الكثير من التجارب السيئة.",
 "どうぶつせい": "حَيَوَان (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط) / حَيَوَان, وَحْش (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "どうぶつたち": "حَيَوَان (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط) / حَيَوَان, وَحْش (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "どうぶつてき": "حَيَوَان (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط) / حَيَوَان, وَحْش (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "どうぶつのけんり": "حقوق الحيوان (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حق)\nمثال: الحقوق إنسانية.",
 "どうぶるい": "اِرْتَجَفَ, اِقْشَعَّرَ",
 "どうほう": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "どうぼう": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "どうぼうしゃ": "رَفِيق الزِّنْزَانَة",
 "どうぼく": "صَفْحَة, صفحة",
 "どうまわり": "خَصْر, وَسَط (خصره خصرا ضرب خاصرته)",
 "どうみゃく": "شِرْيَان, شَرْيَان",
 "どうみゃくりゅう": "أُمّ دَمٍ (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "どうめい": "تَحَالُف, اِتِّحَاد",
 "どうめいいじん": "سَمِيّ / سَمِيَّة",
 "どうめいかんけい": "تَحَالُف, اِتِّحَاد",
 "どうめいこく": "حَلِيف, حَلِيفَة",
 "どうめいし": "صِيغَةُ فِعْل, مَصْدَر",
 "どうめいしゃ": "حَلِيف, حَلِيفَة",
 "どうめいひぎょう": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "どうも": "شُكْرًا, تِسْلَم\nمثال: お土産を頂いてご親切にどうも。 — لطيف منك أن تهديني هدية. / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير. / حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا . / تَحِيَّة (مصدر للفعل \"حَيَّا\"؛ عبارة لفظية أو جسدية تُبدأ بها الرسالة أو المحادثة غرضها التعريف عن وجود قائلها)\nمثال: ألقى زيري تحية.",
 "どうもありがとう": "شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "どうもありがとうございます": "شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "どうもう": "شَرِس ((شَرَسَ) الجِلْدَ يَشْرُسُ شَرْسًا: دَلكَهُ؛ (شَرَسَ) صاحبَه: أمَضَّهُ بالقول)\nمثال: احذر من الكلب الشرس",
 "どうもこうもない": "فَظِيع / مُرْعِب / فَظِيع, أَرْبَد / حَتْمِيّ",
 "どうもすみません": "شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "どうもと": "مَصْرَفِيّ, بَنْكِيّ / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "どうもん": "نَفَق",
 "どうも有り難う": "شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "どうも有り難うございます": "شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "どうも有り難う御座います": "شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "どうも有難う": "شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "どうも有難うございます": "شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "どうも有難う御座います": "شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "どうやく": "شَرِيك, شَرِيكَة",
 "どうやったら": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "どうやって": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ\nمثال: どうやってそのお金を手に入れたんですか。 — من أين لك بالمال؟",
 "どうやら": "ظَاهِرًا, عَلَى مَا يَبْدُو / ظَاهِرًا / بصعوبة",
 "どうゆうふうに": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "どうゆう風に": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "どうよう": "هَزَّ",
 "どうよく": "طَمَع, شُحُّ",
 "どうよろい": "لَبَب",
 "どうら": "جَرَس, نَاقُوس (جَرَسَ الطَّائِرُ: صَوَّتَ؛ جَرَسَ الكَلاَمَ: نَغَمَ بِهِ وَتَكَلَّمَ)\nمثال: ياني يرن الجرس.",
 "どうらく": "هِوَايَة, هَوَس (في : مرادف لكثير)\nمثال: خصص أمسياته لهواية جديدة; بدأ يتعلم اللغة الألمانية. / فُجُور (اسم فاعل من الفعل \"فَجَرَ\"؛ مصدر من الفعل \"فَجَرَ\") / إِغْوَاء / فُسُوق",
 "どうらくもの": "مُسْتَهْتَر / هَاوٍ",
 "どうらん": "اِضْطِرَاب",
 "どうり": "وَفْقًا لِ / حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / عَلَى وَشَكِ (يفيد الاستعلاء؛ يفيد التعليل) / عَن (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى) / حَوَالِي\nمثال: رقصنا حول النار. / شَارِع, زَنَقَة",
 "どうりきがく": "دِينَامِيكَا, حَرَكِيَّة",
 "どうりょ": "صَاحِب, صَاحِبَة (اَلْمُرَافِق، الْمُلَازِمُ، وَلَا يُقَالُ عُرْفاً إِلَّا لِمَنْ كَثُرَتْ مُلَازَمَتُهُ؛ صَاحِبُ الشَّيْءِ: مَالِكُهُ)\nمثال: من صاحب هذه الأرض؟",
 "どうりょう": "زَخَم حَرَكَة (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…) / زَخَم (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…)\nمثال: يمكنك أن تتعلم بنفس الزخم في المكتبة كما في المدرسة.",
 "どうりょく": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة, طَاقَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / طَاقَة كَهْرَبَائِيَّة, طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: توم شعر بالقوة.",
 "どうるい": "شَرِيك فِي جَرِيمَة",
 "どうれ": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "どうろ": "طَرِيق, سِكَّة (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "どうろひょうしき": "عَلَامَةُ طَرِيق, لَافِتَةُ مُرُور (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "どうろふうさ": "حَاجِز",
 "どうわ": "قِصَّة خُرَافِيَّة, خُرَافَة",
 "どう考えても": "بُوضُوح",
 "どう致しまして": "عَفْوًا, الْعَفْو",
 "どう言う": "يَا لَ (يستعمل لنِدَاء البعيد والقريب) / مَا (انظر مَا) / مَاذَا, مَا (أداة استفهام)\nمثال: يا لها من جملة!",
 "どう言う風に": "كَيْف, ازاي / كَيْفَ, ازاي / كَمْ, يَا لَ",
 "どう転んでも": "عَلَى أَيِّ حَالٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "どえらい": "عِمْلاق",
 "どおし": "يبقي",
 "どおじ": "لُوط / مِنْطَقَة, مَنْطِقَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "どおり": "وَفْقًا لِ / حَوْلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر) / عَلَى وَشَكِ (يفيد الاستعلاء؛ يفيد التعليل) / عَن (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى) / حَوَالِي\nمثال: رقصنا حول النار. / شَارِع, زَنَقَة",
 "どかぐい": "أُخْدُود (أخْدُودُ)",
 "どかす": "نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا.",
 "どかた": "عَامِل, عَامِلَة (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "どか食い": "أُخْدُود (أخْدُودُ)",
 "どがいし": "إِهْمال\nمثال: 君は自分の健康を度外視するわけにはいかない。 — لا يسعك أن تهمل صحتك.",
 "どき": "غَضَب / أَغْضَبَ / غَضِبَ",
 "どきどき": "خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَ, نَبَضَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَان",
 "どきへん": "كِسْرَة",
 "どきまぎ": "مُسْتَاء, مُمْتَعِض / إخْلَال / أَسْخَطَ ((أأَسْخَطَه): أغضَبَهُ) / أَخَلَّ ((أَخَلَّ): رعت إبله الخلة؛ (أَخَلَّ) بالمكان وبمركزه وغيره: غاب عنه وتركه)",
 "どきゅう": "قَوْس إفْرَنْجِيَّة",
 "どきゅうかん": "دريدنوت",
 "どきゅうせんかん": "دريدنوت",
 "どきょう": "شَجَاعَة, جَسَارَة",
 "どきょうせんりょう": "جَرِيء, جَسُور",
 "どきんどきん": "خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَ, نَبَضَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَان",
 "どぎつい": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال",
 "どぎまぎ": "مُسْتَاء, مُمْتَعِض / إخْلَال / أَسْخَطَ ((أأَسْخَطَه): أغضَبَهُ) / أَخَلَّ ((أَخَلَّ): رعت إبله الخلة؛ (أَخَلَّ) بالمكان وبمركزه وغيره: غاب عنه وتركه)",
 "どぎも": "أَحْشَاء",
 "どぎもをぬく": "أَذْهَلَ (أَذْهَلَ (أذهله) عنه: جعله يذهل عنه)",
 "どく": "سُمّ, سَمّ (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط) / سَمَّمَ, سَمَّ\nمثال: تناول سامي السم. / ضَرَرٌ / ضَرَّ أَضَرَّ / حِقْد (حقد:أَمْسَكَ عَداوتَهُ فِي قَلْبهِ وتَرَبَّصَ لفُرْصَتِها؛ حقد على فلان:أَضْمَرَ له العداوة وتربّص فرصة الإيقاع به ، كَرِهَه وبَغِضَه)\nمثال: احس سامي بالحقد.",
