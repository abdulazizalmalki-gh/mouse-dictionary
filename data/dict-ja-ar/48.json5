 "震わせる": "هَزَّ",
 "震動": "صَدْمَة / صَعْقَة / صَعَقَ",
 "震央": "مَرْكَز, مَرْكَز اَلزِّلْزَال (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة) / بُؤْرَة\nمثال: أين أقرب مركز شرطة؟",
 "震慄": "اِخْتَلَجَ, اِرْتَجَفَ / رَجْفَة (المرّة الواحدة من الرَجْف؛ الزَلْزَلَة)",
 "震撼": "هَزَّ",
 "震撼させる": "هَزَّ",
 "震旦": "الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم.",
 "震源": "بُؤْرَة",
 "震源地": "بؤرة سطحية, مركز زلزالي سطحي (النقطة على سطح الأرض الواقعة مباشرة فوق بؤرة الزلزال) / مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "震災刈り": "قطع تحتي (قطع يتم في الجانب السفلي لإزالة مادة) / ضربة مقطوعة, قص ((رياضة) ضربة تضع دوراناً عكسياً على الكرة) / حز التوجيه, قطع تحتي (حز يُقطع في جذع الشجرة لتحديد اتجاه سقوطها) / تندرلوين, فيليه الظهر (اللحم الطري لعضلة الخاصرة على جانبي العمود الفقري)\nمثال: الضربات المقطوعة لا تزعج لاعب التنس الجيد",
 "震盪": "صَدْمَة / صَعْقَة / صَعَقَ",
 "震脚": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "震蕩": "صَدْمَة / صَعْقَة / صَعَقَ",
 "震音": "ارتجاف, تريمولو (فيبراتو صوتي خاصة المفرط أو سيئ التحكم) / تريمولو, رجفة صوتية ((موسيقى) تأثير مرتعش ينتج عن التكرار السريع لنغمة واحدة أو التبادل السريع لنغمتين) / تَكْرِير",
 "震顫": "ارتجاف, رعشة (اهتزاز لا إرادي (كما لو كان بسبب المرض أو الخوف)) / رعشة أرضية, زلزال صغير (زلزال صغير) / ارتجاف, رعشة (اهتزاز أو ارتعاش (ناتج عادة عن ضعف أو توتر أو مرض))",
 "震顫麻痺": "الشلل الرعاش, داء باركنسون (اضطراب تنكسي في الجهاز العصبي المركزي يتميز بالرعاش وضعف التنسيق العضلي)",
 "震駭": "ترويع / إِرْهَاب (ال الإِزعاجُ والإِخَافَةُ، تقولُ: ويَقْشَعِرُّ الإِهَابُ إِذَا وَقَعَ مِنْهُ الإِرْهَابُ؛ الإِرْهَابُ قَدْعُ الإِبِلِ عن الحَوْضِ وذِيَادُهَا)\nمثال: الإنفصاليون مثل الإرهاب.",
 "震駭させる": "خَشَّى, أَفْزَعَ",
 "霊": "رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / سول\nمثال: كان سامي هو روح الحفلة. / رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / سول\nمثال: كان سامي هو روح الحفلة. / ضبط النفس (سمة التحكم الحازم في سلوك المرء) / حالة إدراكية, حالة معرفية (حالة العمليات المعرفية للشخص) / حالة ذهنية, مزاج (حالة نفسية مؤقتة)",
 "霊きゅう": "تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل)",
 "霊きゅう自動車": "سَيَّارة نَقْل مَوْتَى, عَرَبة نَقْل مَوْتَى (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "霊位": "لوحة تذكارية نحاسية, لوحة معدنية (نصب تذكاري مصنوع من النحاس الأصفر)",
 "霊体": "شَبَح, خَيَال",
 "霊台方寸": "قَلْب, فُؤَاد / قَلْب / كُبَّا",
 "霊名": "اسم المعمودية (الاسم الأول الذي يُعطى للمسيحيين عند الولادة أو التعميد)",
 "霊園": "جبانة, مدفن (قطعة أرض تستخدم للدفن)",
 "霊夢": "وَحْي, تَنْزِيل (الإعلام في الخفاء، وهذا أصل الكلمة؛ الإلهام، سواء كان غريزيّ أو فطريّ أو فنيّ أو غيره وسواء كان من الله أو من غيره)\nمثال: يا رسول الله، كيف يأتيك الوحي ؟",
