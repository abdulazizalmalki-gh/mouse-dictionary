 "零": "صِفْر, ٠ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / مثال: بدأ سامي من نقطة الصفر. / صِفْر, ٠ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / مثال: بدأ سامي من نقطة الصفر. / لَا شَيْء (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "零し屋": "سيء المزاج, عبوس (شخص سيء الطباع)",
 "零し話": "تَذَمَّرَ, اِشْتَكَى / شَكَا, اِشْتَكَى (تَأَلَّمَ مِنْ مَرَضٍ أو هَمٍّ وَنَحْوِهِ؛ أَظْهَرَ)",
 "零す": "دَلَقَ, أَرَاقَ (صب وأراق؛ خرج سريعًا) / قَمْقَمَ",
 "零れ": "دَلَقَ, أَرَاقَ (صب وأراق؛ خرج سريعًا) / ذهاب, رحيل (فعل المغادرة)",
 "零れだす": "فَيَضَان / فَاضَ",
 "零れる": "دَلَقَ, أَرَاقَ (صب وأراق؛ خرج سريعًا) / هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "零れ出す": "فَيَضَان / فَاضَ",
 "零れ幸い": "رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال)) / ثمرة ساقطة, سقط الشجر (الفاكهة التي سقطت من الشجرة)\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "零れ球": "استحواذ على المرتدة, ريباوند (فعل تأمين حيازة كرة السلة المرتدة بعد تسديدة ضائعة) / ارتداد, رد فعل عكسي (رد فعل لأزمة أو نكسة أو إحباط) / ارتداد, انعكاس (حركة العودة من الارتطام)\nمثال: لا يزال في حالة ارتداد من وفاة زوجته",
 "零れ種": "ذَاتِيّ البَذْر (ينمو من بذور نثرتها عوامل طبيعية كالرياح أو الطيور) / ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "零れ落ちる": "نَثَرَ, تَفَرَّقَ",
 "零れ話": "قطعة لذيذة, لقمة شهية (قطعة صغيرة ولذيذة من الطعام)",
 "零下": "تَحْتَ الصِّفْر (أَقَلَّ)\nمثال: أنا تحت الشجرة.",
 "零余子": "بصيلة (بصلة صغيرة أو نمو على شكل بصلة ينشأ من إبط الورقة أو في مكان الزهور)",
 "零和ゲーム": "لعبة صفرية, لعبة محصلتها صفر (لعبة يكون فيها مجموع كل المكاسب والخسائر صفراً)",
 "零度": "نقطة الانصهار, نقطة التجمد (درجة الحرارة التي يتحول تحتها السائل إلى صلب) / صِفْر, ٠ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / مثال: بدأ سامي من نقطة الصفر.",
 "零敗": "تبييض, فوز نظيف (هزيمة في لعبة يفشل فيها أحد الجانبين في التسجيل)",
 "零時": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل",
 "零点": "صِفْر, ٠ (الخَالِي كأنه تَصْفِر فيه الرِيح. ويقال أيضا صَفْر وصُفْر؛ في : هي عَدَد قيمته لا شيء، أو خالية) / مثال: بدأ سامي من نقطة الصفر. / نقطة الانصهار, نقطة التجمد (درجة الحرارة التي يتحول تحتها السائل إلى صلب)",
 "零番目": "صِفْرِيّ",
 "零空間": "فضاء صفري, فضاء فارغ (فضاء لا يحتوي على نقاط؛ وفضاء فارغ)",
 "零細": "تَافِه, حَقِير (صغير ولا يلفت الانتباه) / تَافِه, ضَئِيلُ الشَّأْن (ذو أهمية أو نفوذ أو سلطة قليلة؛ ذو مكانة ثانوية) / عَدِيمُ الدَّلَالَة (لا يدل على شيء) / تافه, ضئيل الشأن (خالٍ من الأهمية أو المعنى أو القوة)",
 "零細農": "زراعة الكفاف (الزراعة التي توفر الاحتياجات الأساسية للمزارع دون فوائض للتسويق)",
 "零落": "دمار, سقوط (فشل يؤدي إلى فقدان المنصب أو السمعة) / انهيار, سقوط (تراجع مفاجئ في القوة أو العدد أو الأهمية) / سقوط, هطول (سقوط أي شكل من أشكال الماء على الأرض (مطر أو ثلج أو برد أو صقيع أو رذاذ))\nمثال: سقوط آل هابسبورغ",
 "零距離": "تقارب شديد, مكان ضيق (حالة التواجد بشكل قريب جداً وغير مريح من شخص أو شيء ما)",
 "零距離射撃": "بشكل مباشر, بصراحة تامة (بطريقة مباشرة ولا لبس فيها) / مِنْ مَسَافَةٍ قَرِيبَة (قَرِيب بِمَا يَكْفِي لِلإِصَابَة المُبَاشِرَة لِلهَدَف) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)\nمثال: سألته بصراحة تامة عما إذا كان يريد الوظيفة",
 "零集合": "مجموعة خالية, مجموعة فارغة (مجموعة فارغة؛ مجموعة ليس لها أعضاء)",
 "雷": "بَرْق (بَرَقَ الرجلُ: تَهَدّدَ وتَوَعَّدَ، كأَبْرَقَ؛ بَرَقَ الشيءُ بَرْقاً وبَريقاً وبَرَقاناً: لَمَعَ) / بَرَقَ, أَبْرَقَ (بَرَقَ الرجلُ: تَهَدّدَ وتَوَعَّدَ، كأَبْرَقَ؛ بَرَقَ الشيءُ بَرْقاً وبَريقاً وبَرَقاناً: لَمَعَ)\nمثال: البرق يسبق الرعد / غَضَب / أَغْضَبَ / غَضِبَ / رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد",
 "雷が鳴る": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد",
 "雷こう": "فلمينات الزئبق (فلمينات تنفجر بعنف عندما تكون جافة إذا ضُربت أو سُخنت؛ تستخدم في الصواعق وأغطية التفجير)",
 "雷さま": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد",
 "雷に打たれた": "مَبْهُوت, مَصْعُوق (كأنه أُصيب بالخرس من شدة الذهول والمفاجأة)",
 "雷光": "بَرْق (بَرَقَ الرجلُ: تَهَدّدَ وتَوَعَّدَ، كأَبْرَقَ؛ بَرَقَ الشيءُ بَرْقاً وبَريقاً وبَرَقاناً: لَمَعَ) / بَرَقَ, أَبْرَقَ (بَرَقَ الرجلُ: تَهَدّدَ وتَوَعَّدَ، كأَبْرَقَ؛ بَرَقَ الشيءُ بَرْقاً وبَريقاً وبَرَقاناً: لَمَعَ)\nمثال: البرق يسبق الرعد",
 "雷公": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد",
 "雷名": "شُهْرَة",
 "雷撃": "صَاعِقَة",
 "雷様": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد",
 "雷汞": "فلمينات الزئبق (فلمينات تنفجر بعنف عندما تكون جافة إذا ضُربت أو سُخنت؛ تستخدم في الصواعق وأغطية التفجير)",
 "雷竜": "أباتوصور, برونتوصور (ديناصور عاشب ضخم رباعي الأرجل كان شائعاً في أمريكا الشمالية في أواخر العصر الجوراسي)",
 "雷管": "صاعق, كبسولة تفجير (جهاز تفجير ميكانيكي أو كهربائي أو كمية صغيرة من المتفجرات؛ يمكن استخدامه لبدء تفاعل متفجر مدمر)",
 "雷酸": "حمض الفلمينيك (أصبح حامضًا، تغير الطعم إلى الحموضة؛ ارتفعت نسبة الحموضة في شيء ما، كما في الطعام أو السوائل)\nمثال: رمى ياني الحمض على وجه سكورة.",
 "雷酸塩": "فلمينات (ملح أو إستر لحمض الفلمينيك)",
 "雷酸水銀": "فلمينات الزئبق (فلمينات تنفجر بعنف عندما تكون جافة إذا ضُربت أو سُخنت؛ تستخدم في الصواعق وأغطية التفجير)",
 "雷除け": "مَانِعَة صَوَاعِق",
 "雷雨": "عَاصِفَة رَعْدِيَّة",
 "雷雲": "سَحَاب رَاعِد, سَحَابَة رَاعِدَة (الغيوم المتحركة؛ غُيُوم، دَيْم)\nمثال: القمر موجود خلف السحاب.",
 "雷霆": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد",
 "雷魚": "رأس الأفعى الشمالية (سمكة مياه عذبة شرهة موطنها شمال شرق الصين؛ يمكنها استخدام الزعانف للمشي ويمكنها البقاء على قيد الحياة خارج الماء لمدة ثلاثة أيام؛ تشكل تهديداً…)",
 "雷鳥": "ترمجان (طيهوج كبير من القطب الشمالي وشبه القطبي ذو أقدام مكسوة بالريش وريش شتوي أبيض عادة)",
 "雷鳴": "رَعْد, رعد (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر) / رَعَدَ (الصَوْت الذي يصدر حين تفرغ الغَيْمَة شحنة كَهْرَبَائيَّة إلى غَيْمَة أخرى أو إلى الأرْض، ويكون معه بَرْق، وغالبا ما يكون مُصَاحَبا بالمَطَر)\nمثال: البرق يسبق الرعد",
 "雹": "بَرَد, مطر تلج (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن الميت تبرد جثته. فعل لازم مصدر بَرْد) / السلام عليك, السلام عليكم\nمثال: لا أتحمل البرد.",
 "電しんばしら": "عمود التلغراف, عمود الهاتف (عمود طويل يدعم أسلاك الهاتف)",
 "電位": "جهد كهربائي, فرق الجهد (الفرق في الشحنة الكهربائية بين نقطتين في دائرة معبراً عنه بالفولت)",
 "電位差": "جهد كهربائي, فرق الجهد (الفرق في الشحنة الكهربائية بين نقطتين في دائرة معبراً عنه بالفولت)",
 "電位差計": "مقياس الجهد الانزلاقي",
 "電位計": "إلكترومتر, مقياس الكهرباء (مقياس لقياس فروق الجهد الكهروستاتيكي؛ لا يسحب تياراً من المصدر)",
 "電信": "تِلِغْرَاف, بَرْقِيَّة",
 "電信売相場": "التوقيت الأرضي, توقيت التقويم الفلكي ((علم الفلك) مقياس للوقت محدد بحركة الأرض المدارية؛ التوقيت الأرضي هو التوقيت الشمسي المتوسط مصححاً لعدم انتظام حركات الأرض)",
 "電信技手": "عامل تلغراف, مُبْرِق (شخص يرسل الرسائل عن طريق التلغراف)",
 "電信柱": "عمود التلغراف, عمود الهاتف (عمود طويل يدعم أسلاك الهاتف)",
 "電信機": "تِلِغْرَاف, بَرْقِيَّة",
 "電信電話会社": "شركة نقل, ناقل (شخص أو شركة تعمل في مجال نقل الأشخاص أو البضائع أو الرسائل)",
 "電光": "بَرْق (بَرَقَ الرجلُ: تَهَدّدَ وتَوَعَّدَ، كأَبْرَقَ؛ بَرَقَ الشيءُ بَرْقاً وبَريقاً وبَرَقاناً: لَمَعَ) / بَرَقَ, أَبْرَقَ (بَرَقَ الرجلُ: تَهَدّدَ وتَوَعَّدَ، كأَبْرَقَ؛ بَرَقَ الشيءُ بَرْقاً وبَريقاً وبَرَقاناً: لَمَعَ)\nمثال: البرق يسبق الرعد",
 "電光朝露": "خَاطِف, عَابِر (يَدوم لِفَتْرَة قَصيرَة جِدًّا)",
 "電光石火": "البَرْق",
 "電力": "استطاعة كهربائية, قدرة كهربائية (حاصل ضرب الجهد في التيار)",
 "電力ケーブル": "خط كهرباء, كابل طاقة (كابل يستخدم لتوزيع الكهرباء)",
 "電力会社": "شركة طاقة, شركة كهرباء (مرفق عام يوفر الكهرباء)",
 "電力供給": "وحدة تزويد الطاقة / تغذية طاقة (تَغْذِيَةُ الجِسْمِ: تَزْوِيدُهُ بِـالغِذَاءِ؛ في ركيزة أساسية للحياة، فهي تشمل جميع العمليات التي يُحصل من خلالها الكائن الحي على احتياجاته الغذائية. تُساهم هذه الاحتياجات في تشغيل الوظائف…)\nمثال: لن نستمر في تغذية الانتقامات.",
 "電力工学": "هندسة القوى (مجال فرعي من هندسة الطاقة يتعامل مع توليد ونقل وتوزيع واستخدام الطاقة الكهربائية والأجهزة الكهربائية المتصلة بهذه الأنظمة)",
 "電力系統": "شبكة الكهرباء, نظام الطاقة (نظام من الكابلات عالية الجهد يتم من خلاله توزيع الطاقة الكهربائية عبر منطقة ما)",
 "電力網": "شبكة الكهرباء, نظام الطاقة (نظام من الكابلات عالية الجهد يتم من خلاله توزيع الطاقة الكهربائية عبر منطقة ما)",
 "電力計": "مقياس الواط, واطميتر (أداة لقياس تدفق الطاقة الكهربائية في دائرة كهربائية بوحدة الواط)",
 "電力量": "طاقة كهربائية (كامنة) ((في الفيزياء) الطاقة الكامنة لشحنة كهربائية في مجال كهربائي، أو لتيار كهربائي في مجال مغناطيسي)",
 "電動": "كَهْرَبَائِيّ, كَهْرُبَائِيّ",
 "電動のこぎり": "منشار كهربائي (أداة كهربائية لقطع الخشب)",
 "電動アシスト自転車": "دراجة إلكترونية, دراجة كهربائية (دراجة مبنية بمحرك، يمكن تشغيل الدراجة بواسطة المحرك أو بتدويس الراكب)",
 "電動モーター": "محرك كهربائي (محرك يحول الكهرباء إلى عمل ميكانيكي)",
 "電動化": "إمداد بالكهرباء, كهربة (فعل توفير الكهرباء) / إثارة, تهييج (نشاط إثارة أو تحميس شخص أو مجموعة بشكل ملحوظ)\nمثال: كهربة ريف تينيسي",
 "電動工具": "أداة كهربائية (أداة تعمل بمحرك)",
 "電動式": "استطاعة كهربائية, قدرة كهربائية (حاصل ضرب الجهد في التيار)",
 "電動機": "محرك كهربائي (محرك يحول الكهرباء إلى عمل ميكانيكي)",
 "電動歯ブラシ": "فرشاة أسنان كهربائية (فرشاة أسنان ذات محرك كهربائي في المقبض يهز رأس الفرشاة)",
 "電動発動機": "محرك كهربائي (محرك يحول الكهرباء إلى عمل ميكانيكي)",
 "電動自転車": "دراجة إلكترونية, دراجة كهربائية (دراجة مبنية بمحرك، يمكن تشغيل الدراجة بواسطة المحرك أو بتدويس الراكب)",
 "電動車いす": "كرسي كهربائي, كرسي متحرك آلي (كرسي متحرك يعمل بمحرك)",
 "電動車椅子": "كرسي كهربائي, كرسي متحرك آلي (كرسي متحرك يعمل بمحرك)",
 "電動鋸": "منشار كهربائي (أداة كهربائية لقطع الخشب)",
 "電化": "إمداد بالكهرباء, كهربة (فعل توفير الكهرباء) / إثارة, تهييج (نشاط إثارة أو تحميس شخص أو مجموعة بشكل ملحوظ)\nمثال: كهربة ريف تينيسي",
 "電卓": "حَاسِبَة, آلَة حَاسِبَة (أو حَسِبَ أو كلاهما)\nمثال: هذه حاسبة ييذير.",
 "電商": "تِجَارَة إِلِكْتْرُونِيَّة",
 "電器": "كَهْرَبَائِيّ, كَهْرُبَائِيّ",
 "電圧": "جُهْد, فُولْتِيَّة (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد .",
 "電圧低下": "انقطاع الكهرباء, تعتيم (الظلام الناتج عن إطفاء الأنوار (كما في مدينة غير مرئية لطائرات العدو))",
 "電圧計": "مِقْياس الْجُهْد الْكَهْرَبَائِيّ, مِقْياس الْفُولْت",
 "電圧降下": "هبوط الجهد (انخفاض في الجهد الكهربائي على طول موصل يتدفق خلاله تيار)",
 "電報": "بَرْقِيَّة, تِلِغْرَاف",
 "電場": "حقل كهربائي (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "電子": "إِلِكْتْرُون, كُهَيْرِب / إِلِكْتْرُونِيّ",
 "電子たばこ": "سِيجَارَة إِلِكْتْرُونِيَّة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض التدخين)\nمثال: دخن زيري سيجارة.",
 "電子ウイルス": "فيروس, فيروس حاسوبي (برنامج قادر على نسخ نفسه وعادة ما يكون قادراً على إلحاق ضرر كبير بالملفات أو البرامج الأخرى على نفس الحاسوب)\nمثال: لا يمكن للفيروس الحقيقي الانتشار إلى حاسوب آخر دون مساعدة بشرية",
 "電子オルガン": "أورغن كهربائي ((موسيقى) محاكاة إلكترونية للأورغن الأنبوبي)",
 "電子スピン共鳴": "رنين إلكتروني مغزلي, رنين مغناطيسي إلكتروني (مطيافية الميكروويف التي يوجد فيها امتصاص رنيني للإشعاع بواسطة مغناطيس مساير)",
 "電子タバコ": "سِيجَارَة إِلِكْتْرُونِيَّة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض التدخين)\nمثال: دخن زيري سيجارة.",
 "電子デバイス": "جهاز إلكتروني (جهاز يحقق غرضه إلكترونياً)",
