 "蚕業": "إنتاج الحرير من دودة القز",
 "蚕蛾": "عثة دودة القز (عثة آسيوية متوسطة الحجم تتغذى يرقاتها على أوراق التوت وتنتج الحرير)",
 "蚕食": "تأثير, تعدي (التأثير بقوة)\nمثال: استاءوا من طغيان القيم الأمريكية على الثقافة الأوروبية",
 "蚜虫": "مَنّ, مَنَّة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / مَنّ, مَنَّة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / صُرْصُور / مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "蚤": "بُرْغُوث",
 "蚤の市": "سوق البراغيث, سوق السلع المستعملة (سوق شوارع مفتوح للسلع الرخيصة أو المستعملة)",
 "蚤の心臓": "تهيب, جبن (الخوف عند الخوض في أماكن أو أنشطة جديدة ومجهولة)",
 "蚤虫": "قافزات الذيل (أي من الحشرات البدائية الدقيقة عديمة الأجنحة العديدة التي تمتلك زائدة بطنية…)",
 "蚯蚓": "دُودَة الْأَرْض, خُرْطُون",
 "蚯蚓腫れ": "لوح جانبي (لوح سميك يشكل حافة على طول جانب سفينة خشبية)",
 "蚯蚓蜥蜴": "سحلية دودية (سحلية من جنس أمفيسباينا؛ سحلية غير ضارة تشبه الدودة وعديمة الأطراف من المناطق…)",
 "蚰蜒羊歯": "زان ياباني (زان موطنه اليابان له خشب بني مصفر فاتح ناعم)",
 "蚶": "محار الدم (محار أحمر الدم)",
 "蚶貝": "محار الدم (محار أحمر الدم)",
 "蚺蛇": "أَصَلَة",
 "蛆": "نَغَفة",
 "蛆虫": "نَغَفة / شَخْص دَنِيء (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد…)\nمثال: هذا الشخص فنان.",
 "蛇": "ثُعْبَان, حَنَش / ثُعْبَان",
 "蛇の生殺し": "الليمبو ((اللاهوت) في الكاثوليكية الرومانية، مكان الأرواح غير المعمدة ولكن البريئة أو…)",
 "蛇の目": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه)\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "蛇体": "ثُعْبَانِيّ",
 "蛇使い": "حاوي الثعابين, مروض الثعابين (فنان يستخدم الحركات والموسيقى للسيطرة على الثعابين)",
 "蛇口": "حَنَفِيَّة, صُنْبُور",
 "蛇座": "الْحَيَّة",
 "蛇毒": "زعاف الثعبان, سم الأفعى (سم تفرزه بعض الثعابين)",
 "蛇神": "إله الثعبان, زومبي (إله في طوائف الفودو ذات الأصل الأفريقي، يُعبد خاصة في جزر الهند الغربية)",
 "蛇管": "مِلَفّ, وَشِيعَة",
 "蛇紋岩": "سربنتينيت",
 "蛇紋石": "ثُعْبَانِيّ",
 "蛇結茨": "شوك ميسور (شجيرة شائكة منتشرة من آسيا الاستوائية تحمل عناقيد منتصبة كبيرة من الزهور…)",
 "蛇腹": "مِنْفَاخ / إفريز, كرنيش (الجزء البارز العلوي من السطح المعمد) / ركراك, شريط متعرج (شريط متعرج ضيق يستخدم كحاشية)",
 "蛇蜻蛉": "ذبابة دوبسون (حشرة كبيرة ناعمة الجسم لها فكوك نحيلة طويلة في الذكر؛ تستخدم اليرقات المائية…)",
 "蛇蠍": "ثُعْبَان, حَنَش / عَقْرَب, عَقْرَبَة / اشمئزاز, بغض (كراهية مقترنة بالاشمئزاز)",
 "蛇行": "تَعَرَّجَ",
 "蛇足": "تكرار زائد, حشو (تكرار فعل ما بلا حاجة)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة",
 "蛇遣い": "حاوي الثعابين, مروض الثعابين (فنان يستخدم الحركات والموسيقى للسيطرة على الثعابين)",
 "蛇遣い座": "الْحَوَّاء",
 "蛇遣座": "الْحَوَّاء",
 "蛇頭": "زهرة السلحفاة, كيلون (نبات معمر بارز في الأراضي المستنقعية في شرق ووسط أمريكا الشمالية له أوراق رمحية…)",
 "蛇食鷲": "كَاتِب (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد…)\nمثال: لست بذاك الكاتب.",
 "蛋民": "شعب تانكا (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه…)",
 "蛋白": "بْرُوتِين (في جزيئات حيوية ضخمة تتكون من سلسلة أو أكثر من الأحماض الأمينية)\nمثال: يحتوي اللحم على البروتين. / غِرْقِل, آح البَيْض",
 "蛋白同化ステロイド": "ستيرويد بنائي, منشط (أي من مجموعة الهرمونات الستيرويدية الاصطناعية التي تستخدم لتحفيز نمو العضلات…)",
 "蛋白尿": "بيلة ألبومينية, بيلة بروتينية (وجود بروتين مفرط (بشكل رئيسي الألبومين ولكن أيضاً الجلوبيولين) في البول؛ عادة…)",
 "蛋白石": "أُوبَال",
 "蛋白質": "بْرُوتِين (في جزيئات حيوية ضخمة تتكون من سلسلة أو أكثر من الأحماض الأمينية)\nمثال: يحتوي اللحم على البروتين.",
 "蛋白質分解酵素": "بروتياز (أي إنزيم يحفز انقسام البروتينات إلى أجزاء ببتيد أصغر وأحماض أمينية بعملية تعرف…)",
 "蛋黄": "صفار البيض, مح (الجزء الكروي الأصفر من البيضة الذي يحيط به الزلال)",
 "蛍": "يَرَاعَة, حُبَاحِب",
 "蛍光": "تالق, فلورة (ضوء ينبعث أثناء امتصاص إشعاع ذي طول موجي آخر (غير مرئي))",
 "蛍光ペン": "قلم تحديد, قلم تظليل (قلم تمييز فلوري يستخدم لتمييز الفقرات المهمة في النص)",
 "蛍光板": "شاشة فلورية (شاشة شفافة مطلية من جانب واحد بمادة فسفورية تتفلور عند تعرضها للأشعة السينية أو…)",
 "蛍光染料": "صبغة الفلوريسين, فلوريسين (صبغة صفراء تظهر بوضوح حتى عند تخفيفها بشدة؛ تستخدم كمؤشر امتزاز)",
 "蛍光灯": "مصباح فلوري, مصباح نيون (مصباح يتكون من أنبوب مطلي من الداخل بمادة فلورية؛ يبعث بخار الزئبق في الأنبوب…)",
 "蛍光物質": "فوسفور (مادة اصطناعية تتصف بالفلورية أو التفسفر؛ تستخدم لطلاء شاشات أنابيب أشعة الكاثود)",
 "蛍光色素": "صبغة الفلوريسين, فلوريسين (صبغة صفراء تظهر بوضوح حتى عند تخفيفها بشدة؛ تستخدم كمؤشر امتزاز)",
 "蛍火": "جَمْرَة",
 "蛍石": "فلسبار, فلوريت (معدن ناعم (فلوريد الكالسيوم) مشع في الضوء فوق البنفسجي؛ المصدر الرئيسي للفلور)",
 "蛍草": "زهرة النهار, عشبة العنكبوت",
 "蛍蛆": "يَرَاع, حَبَاحِب",
 "蛍袋": "جريس, زهرة الجرس",
 "蛔虫": "دودة أسطوانية, نيماتودا (ديدان غير مقسمة ذات جسم مستدير ممدود مدبب من كلا الطرفين؛ معظمها حرة المعيشة…)",
 "蛙": "ضِفْدِع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ…)\nمثال: الضفدع في البئر.",
 "蛙の子は蛙": "الْوَلَدُ سُرّ أَبِيهِ",
 "蛙手": "قَيْقَب",
 "蛙泳ぎ": "سباحة الصدر (طريقة سباحة؛ تُمد الذراعان معاً أمام الرأس وتُسحبان للخلف على الجانبين مصحوبة…)",
 "蛙跳び": "قفزة الضفدع, نط الحبل (لعبة ينحني فيها طفل ويقفز آخر من فوقه)\nمثال: لا تزال الشركة تعتقد أن الرقاقة تمثل قفزة في التكامل وستحقق أرباحاً طائلة",
 "蛙飛び": "قفزة الضفدع, نط الحبل (لعبة ينحني فيها طفل ويقفز آخر من فوقه)\nمثال: لا تزال الشركة تعتقد أن الرقاقة تمثل قفزة في التكامل وستحقق أرباحاً طائلة",
 "蛙鮟鱇": "سمكة الضفدع (سمكة لها فم يشبه فم الضفدع مع طُعم على الخطم)",
 "蛙黽": "ضِفْدَع شَجَر (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ…)\nمثال: الضفدع في البئر.",
 "蛛形類": "حَيَوَان عَنْكَبُوتِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي…)\nمثال: هذا حيوان أليف.",
 "蛛網": "بَيْت الْعَنْكَبُوت, نَسِيج الْعَنْكَبُوت (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع…)",
 "蛞蝓": "بَزَّاقَة",
 "蛞蝓に塩": "خَائِبُ الأَمَل, مُنْكَسِر (مُنْخَفِضُ الرُّوحِ المَعْنَوِيَّة؛ مَكْسُورُ الخَاطِر)",
 "蛞蝓魚": "رميح, سهيم (حيوان بحري صغير شفاف يشبه المشرط يحفر في الرمل؛ سلف بدائي للفقاريات)",
 "蛤": "تَنَاقُض, عَدَم اتِّسَاق (صفة عدم الاتساق وافتقار الانسجام بين الأشياء أو الأجزاء)",
