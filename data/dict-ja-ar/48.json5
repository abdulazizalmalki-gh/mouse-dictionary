 "随行": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "随行員": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "随身": "حَرَس خَاصّ, حَرَس (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي. / مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "隔": "ثَانٍ, تاني / ثَانِيَة, ثانية (وحدة زمنية تعادل جزءًا من ستين جزءًا من الدقيقة)\nمثال: لن أفعلها ثانية.",
 "隔たり": "بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "隔つ": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل.",
 "隔て": "تَقْسِيم / تَفْرِيق / تَمْيِيز / اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "隔てる": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل.",
 "隔て心": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "隔世遺伝": "ارتداد وراثي, رجعة (عودة ظهور صفة وراثية قديمة) / عودة, عودة الظهور (فعل ظهور شخص ما مرة أخرى) / ظهور مجدد, عودة ظهور (حدث ظهور شيء ما مرة أخرى)\nمثال: كانت عودة ظهوره في دور هاملت منتظرة منذ فترة طويلة",
 "隔壁": "حاجز / جدار ساحلي",
 "隔年": "كُلّ سَنَتَيْن (كل عامين)\nمثال: يقام هذا المهرجان كل سنتين",
 "隔心": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "隔意": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "隔絶": "تَوَحُّد",
 "隔膜": "تَقْسِيم",
 "隔離": "تَوَحُّد",
 "隕星": "شِهَاب",
 "隕石": "حَجَر نَيْزَكِيّ (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "隘路": "مضيق, ممر ضيق (ممر ضيق (خاصة بين الجبال)) / عُنُق الزُّجَاجَة",
 "隙": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية / اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / إهمال, لا مبالاة (صفة عدم الحذر أو عدم بذل الجهد) / فُرْصَة / انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية / فُرْصَة / خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / تضارب, تنافر (خليط حاد ومزعج من الأصوات) / تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / خلاف, شقاق (عدم الاتفاق أو الانسجام)",
 "隙目": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "隙見": "اختلاس النظر, تلصص (نظرة سرية) / زقزقة, صوصوة (الصوت الضعيف القصير لطائر صغير)",
 "隙間": "انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية / فَاصِل / مُدَّة, فَتْرَة / مَسَافَة / إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / إهمال, لا مبالاة (صفة عدم الحذر أو عدم بذل الجهد)",
 "隙間なく": "بتقارب, عن كثب (في علاقة أو موقع قريب في الزمان أو المكان) / بشكل وثيق, حميمياً (بطريقة وثيقة) / بدقة, عن كثب (بطريقة منتبهة)\nمثال: كانت البدايات متقاربة زمنياً",
 "隙間時間": "رَاحَة, خُلُو مِنَ الْعَمَل",
 "隙間風": "مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "際": "حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما) / حافة, طرف (الحد الخارجي لجسم أو منطقة أو سطح؛ مكان أبعد ما يكون عن مركز الشيء) / أَفْضَلِيَّة نِسْبِيَّة, تَفَوُّق بَسِيط (ميزة تنافسية طفيفة) / حدة (سمة الإلحاح في نبرة الصوت)\nمثال: قام بتدوير حواف الصندوق / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / فُرْصَة, مُنَاسَبَة / مُنَاسَبَة (مؤنث مُنَاسَب؛ اسم مفعول من نَاسَبَ؛ التي نُوسِبَتْ أي اتُّخِذَتْ نَسِيبَة؛ الحَدَث الذي يكون مناسِبًا لفعل شيئا ما، غالبا ما يُقصد به حَدَثًا سعيدا وما يُراد فعله هو الاحتفال ويجوز استخدامها في الاحداث غير سعيدة)\nمثال: أرى مرآة مناسبة",
 "際して": "مَتَى / إمتى / متى / امتى / فوقتاش / حِينَمَا, عِنْدَمَا",
 "際する": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر.",
 "際どい": "خَطِر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر. / إِيحَائِيّ, مُوحٍ (يميل إلى الإيحاء بشيء غير لائق أو فاحش) / إِيحَائِيّ, تَلْمِيحِيّ (يَمِيلُ إِلَى التَّلْمِيحِ أَوِ الإِيحَاء) / دَالّ, كَاشِف (يشير بوضوح أو يكشف؛ يُستخدَم عادة مع 'على') / الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ.",
 "際どいところ": "فوز بشق الأنفس, نجاة بأعجوبة (شيء تم تحقيقه (أو الهروب منه) بفارق ضئيل)",
 "際どい所": "فوز بشق الأنفس, نجاة بأعجوبة (شيء تم تحقيقه (أو الهروب منه) بفارق ضئيل)",
 "際に": "فِي حَال, إِذ مَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "際会": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم.",
 "際涯": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ) / نِهَايَة / حَدَّ, حَدَّدَ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "際限": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ) / نِهَايَة / حَدَّ, حَدَّدَ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "際限なく": "إلى ما لا نهاية (إلى اللانهاية؛ دون حد ظاهر)\nمثال: تحدث وتحدث إلى ما لا نهاية",
 "障がい": "عَقَبَة, حَاجِز / إعاقة, عجز (حالة عدم القدرة على الأداء نتيجة لعدم اللياقة البدنية أو العقلية)\nمثال: إعاقة القراءة / سباق قفز الموانع (سباق خيل عبر مضمار مليء بالعوائق) / سباق الموانع (سباق جري عادة لمسافة 3000 متر عبر مضمار مغلق مع حواجز وقفزة مائية) / سباق الحواجز, سباق العقبات (سباق يجب على المنافسين فيه تجاوز العقبات)",
 "障む": "عَاقَ, عَرْقَلَ / خَلْفِيّ / رِدْف, عَجِيزَة (رَدِفَهُ يَرْدَفُ رَدْفاً: رَدَفه؛ وفي التنزل العزيز)",
 "障り": "إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم) / ضَرَرٌ / ضَرَّ أَضَرَّ / حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ معلومةٍ كلَّ شهر؛ أعراض ما قبل الحيض (في ): أعراض تشمل انتفاخ البطن وألم الصدر والصداع والشعور بالتّعب وحدَّة الطبع والتهيّج العصبيّ والاكتئاب…)",
 "障る": "عَاقَ, عَرْقَلَ / خَلْفِيّ / رِدْف, عَجِيزَة (رَدِفَهُ يَرْدَفُ رَدْفاً: رَدَفه؛ وفي التنزل العزيز)",
 "障壁": "عَقَبَة, حَاجِز",
 "障子": "شوجي (ستار شفاف مصنوع من إطار خشبي مغطى بورق الأرز)",
 "障子に目あり": "اَلْجِدْرَانُ لَهَا آذَانٌ, لِلْحِيطَانِ آذَانٌ",
 "障害": "عَقَبَة, حَاجِز / إعاقة, عجز (حالة عدم القدرة على الأداء نتيجة لعدم اللياقة البدنية أو العقلية)\nمثال: إعاقة القراءة / سباق قفز الموانع (سباق خيل عبر مضمار مليء بالعوائق) / سباق الموانع (سباق جري عادة لمسافة 3000 متر عبر مضمار مغلق مع حواجز وقفزة مائية) / سباق الحواجز, سباق العقبات (سباق يجب على المنافسين فيه تجاوز العقبات)",
 "障害物": "عَقَبَة, حَاجِز",
 "障害物競走": "سباق الحواجز, سباق العقبات (سباق يجب على المنافسين فيه تجاوز العقبات)",
 "障害競走": "سباق قفز الموانع (سباق خيل عبر مضمار مليء بالعوائق) / سباق الموانع (سباق جري عادة لمسافة 3000 متر عبر مضمار مغلق مع حواجز وقفزة مائية)",
 "障害者差別": "اَلتَّمْيِيزُ ضِدَّ ٱلْمُعَاقِينَ",
 "障害走": "سباق الحواجز (سباق جري يجب على المتسابقين فيه اجتياز سلسلة من الحواجز)",
 "障碍": "عَقَبَة, حَاجِز",
 "障礙": "عَقَبَة, حَاجِز",
 "隠された意図": "أَجَنْدَة",
 "隠し": "إخفاء, كتمان (نشاط إبقاء شيء ما سراً) / اختباء (حالة الاختباء)\nمثال: ذهب في الاختباء (تواري عن الأنظار) / جَيْب (جيَّب القميص:جَابَ، جعل له جيبًا)\nمثال: جيب سامي مثقوب.",
 "隠しだて": "سِرِّيَّة",
 "隠しどころ": "مخبأ (مكان مناسب لإخفاء شيء ما (مثل نفسك)) / أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)",
 "隠しマイク": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "隠し事": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "隠し処": "مخبأ (مكان مناسب لإخفاء شيء ما (مثل نفسك)) / أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)",
 "隠し包丁": "تصحيح, وضع الدرجات (تقييم الأداء عن طريق تعيين درجة أو نتيجة)\nمثال: ما كرهه في التدريس هو كل التصحيح الذي كان عليه القيام به",
 "隠し場所": "مخبأ (مساحة تخزين مخفية (للمال أو المؤن أو الأسلحة)) / ذاكرة كاش, ذاكرة مخبئية ((في علم الحاسوب) ذاكرة وصول عشوائي مخصصة كذاكرة تخزين مؤقت يتم تحديثها باستمرار؛ تستخدم لتحسين نقل البيانات بين عناصر النظام ذات الخصائص المختلفة) / كنز مخفي, مخبأ (مخزون سري من الأشياء الثمينة أو المال)",
 "隠し子": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "隠し所": "مخبأ (مكان مناسب لإخفاء شيء ما (مثل نفسك)) / أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)",
 "隠し機能": "بَيْضَة عِيد اَلْفِصْح, بَيْضَة اَلْفِصْح (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان)\nمثال: هذه بيضة مقلية.",
 "隠し立て": "سِرِّيَّة",
 "隠し言葉": "رطانة, عامية خاصة (لغة مميزة لمجموعة معينة (كما بين اللصوص))\nمثال: هم لا يتحدثون لغتنا",
 "隠し詞": "رطانة, عامية خاصة (لغة مميزة لمجموعة معينة (كما بين اللصوص))\nمثال: هم لا يتحدثون لغتنا",
 "隠す": "أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟",
 "隠ぺい": "إخفاء, كتمان (نشاط إبقاء شيء ما سراً) / ستار, غطاء (غطاء يعمل على إخفاء أو حماية شيء ما) / خصوصية, سرية (حالة الاخفاء أو الكتمان)\nمثال: وفر ستار من الأشجار الخصوصية",
 "隠り世": "آخِرَة",
 "隠る": "أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟",
 "隠れ": "مُخْفًى, خَفِيّ (مُخْفَى هُوَ؛ مُخْفِي أَوْ مُخْفٍ) / مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر",
 "隠れひそむ": "أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟",
 "隠れみの": "غِطَاء / غِلَاف / غَطَّى",
 "隠れもない": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "隠れも無い": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "隠れる": "أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟ / اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / تَقَاعَدَ / اِعْتَزَلَ",
 "隠れんぼ": "الغميضة, لعبة الاختباء (لعبة يغطي فيها طفل عينيه بينما يختبئ اللاعبون الآخرون ثم يحاول العثور عليهم)",
 "隠れ場": "مخبأ (مكان مناسب لإخفاء شيء ما (مثل نفسك))",
 "隠れ場所": "مخبأ (مكان مناسب لإخفاء شيء ما (مثل نفسك))",
 "隠れ家": "مخبأ (مكان مناسب لإخفاء شيء ما (مثل نفسك)) / تَرَاجُع / اِنْسِحَاب / تَرَاجَعَ",
 "隠れ潜む": "أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟",
 "隠れ蓑": "غِطَاء / غِلَاف / غَطَّى",
 "隠れ蟹": "سرطان البازلاء (سرطان صغير ناعم الجسم يعيش بشكل تكافلي في عباءات بعض الرخويات ذات الصدفتين)",
 "隠れ身": "اختفاء, تواري (فعل المغادرة سراً أو دون تفسير)",
 "隠れ里": "شَانْغْرِيلَا",
 "隠れ鬼": "الغميضة, لعبة الاختباء (لعبة يغطي فيها طفل عينيه بينما يختبئ اللاعبون الآخرون ثم يحاول العثور عليهم)",
 "隠世": "آخِرَة",
 "隠事": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "隠伏": "إخفاء, كتمان (نشاط إبقاء شيء ما سراً) / ستار, غطاء (غطاء يعمل على إخفاء أو حماية شيء ما) / خصوصية, سرية (حالة الاخفاء أو الكتمان)\nمثال: وفر ستار من الأشجار الخصوصية",
 "隠元": "فاصولياء شائعة (أي من أنواع الفاصولياء العديدة التي تؤكل طازجة أو مجففة) / فاصولياء شائعة (نبات الفاصولياء الحولي المتسلق أو الشجيري الشائع الذي يزرع لبذوره أو قرونه الصالحة للأكل)",
 "隠元豆": "فاصولياء شائعة (أي من أنواع الفاصولياء العديدة التي تؤكل طازجة أو مجففة) / فاصولياء شائعة (نبات الفاصولياء الحولي المتسلق أو الشجيري الشائع الذي يزرع لبذوره أو قرونه الصالحة للأكل)",
