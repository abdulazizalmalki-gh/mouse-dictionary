 "蘇連": "الْاِتِّحَادُ السُّوفْيَاتِيّ, الْاِتِّحَادُ السُّوفْيَتِيّ",
 "蘇部": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "蘇鉄": "سيكاس, نخيل الساغو (سيكاد قزم يشبه النخيل من اليابان ينتج الساغو)",
 "蘊奥": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "蘚": "أُشْنَة, طُحْلُب",
 "蘚苔": "أُشْنَة, طُحْلُب",
 "蘚苔植物": "نبات طحلبي, نبات لا وعائي (أي من النباتات العديدة من قسم النباتات الطحلبيه)",
 "蘚類": "أُشْنَة, طُحْلُب",
 "蘞辛い": "حَارِق, لَاذِع (قاسٍ أو كاوٍ في اللهجة)",
 "蘭": "أُورْكِيد, سَحْلَب / هُولَنْدَا, هُولَنْدَة / طقسوس ياباني (شجيرة دائمة الخضرة قوية من الصين واليابان لها أوراق خضراء داكنة لامعة؛ تزرع في…) / جابر العظام, غافث مثقوب (عشب معمر في جنوب شرق الولايات المتحدة له رؤوس زهرية بيضاء الشعاع؛ كان يستخدم…)",
 "蘭人": "هُولَنْدِيّ",
 "蘭国": "هُولَنْدَا, هُولَنْدَة",
 "蘭州": "لَانْغْتْشُو, لَانْغْجُو",
 "蘭画": "لَوْحَة زَيْتِيَة",
 "蘭語": "هُولَنْدِيّ",
 "蘿": "أُشْنَة, طُحْلُب / صنوبر أرضي, عجوقة صفراء (نبات حولي منخفض النمو بزهور صفراء منقطة بالأحمر؛ معطر برائحة خفيفة من راتنج…)",
 "蘿蔔": "فِجْل (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل…)",
 "虎": "نِمْر (النّمر: حيوان مرقّط يُشبه الأَسَد؛ النّمر: لونه أنمر، وفيه نُمر حمراء أو بيضاء…)\nمثال: دخل نمر مخيمنا. / سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "虎の威を借る狐": "شخص صغير الحجم, ضئيل الجسم (شخص حجمه أقل من المتوسط)",
 "虎の子": "جرو النمر, فزر (نمر صغير)",
 "虎の尾": "ليسيماكيا عنق الإوزة (صنف من عشبة الليسيماكيا)",
 "虎の尾を踏む": "لَعِبَ بِالنَّار (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس.",
 "虎の巻": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا. / كريبج (لعبة ورق (عادة للاعبين اثنين) يتم فيها توزيع ست أوراق لكل لاعب ويتخلص من ورقة…)",
 "虎ばさみ": "فخ فولاذي (فخ مصنوع من الفولاذ بنابض قوي وبروزات حادة تشبه الأسنان للإمساك بالفريسة)\nمثال: إنه حاد الذكاء كالمصيدة الفولاذية",
 "虎パン": "مُخَطَّط كَالنَّمِر (ذو خطوط تُشبه خطوط النمر)",
 "虎児": "جرو النمر, فزر (نمر صغير)",
 "虎子": "قصرية, نونية سرير (وعاء ضحل يستخدمه المريض طريح الفراش للتغوط والتبول)",
 "虎巻": "زِرّ",
 "虎挟み": "فخ فولاذي (فخ مصنوع من الفولاذ بنابض قوي وبروزات حادة تشبه الأسنان للإمساك بالفريسة)\nمثال: إنه حاد الذكاء كالمصيدة الفولاذية",
 "虎斑": "مُبَرْقَش, مُرَقَّط (ذو خطوط رماديّة أو بنّيّة أو نقوش ملوّنة مرقّطة؛ يُستخدَم خاصّة لوصف فرو القطط)",
 "虎斑木菟": "بومة أذناء",
 "虎柄": "مُخَطَّط",
 "虎柄パンツ": "مُخَطَّط كَالنَّمِر (ذو خطوط تُشبه خطوط النمر)",
 "虎毛": "مُبَرْقَش, مُرَقَّط (ذو خطوط رماديّة أو بنّيّة أو نقوش ملوّنة مرقّطة؛ يُستخدَم خاصّة لوصف فرو القطط)",
 "虎猫": "قط عتابي, قط مخطط (قط ذو معطف رمادي أو أسمر مبقع بالأسود)",
 "虎疫": "كُولِيرَا, هَيْضَة",
 "虎穴": "عَرِين الْأُسُود (اِسْمٌ لِمَاْوَى الأَسَد)",
 "虎落": "اِبْتِزَاز (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد)",
 "虎視眈々": "بحذر, بيقظة (بطريقة يقظة)",
 "虎視眈眈": "بحذر, بيقظة (بطريقة يقظة)",
 "虎豹": "شَرِس ((شَرَسَ) الجِلْدَ يَشْرُسُ شَرْسًا: دَلكَهُ؛ (شَرَسَ) صاحبَه: أمَضَّهُ بالقول)\nمثال: احذر من الكلب الشرس",
 "虎魚": "سمكة العقرب, عقرب البحر (أسماك بحرية لها جسم مستدق ورأس مدرع وأشواك سامة)",
 "虐げられた人々": "مَظْلُوم",
 "虐げられた人人": "مَظْلُوم",
 "虐げる": "اِسْتَضْعَفَ, قَهَرَ",
 "虐め": "إِرْهَاب, تَنَمُّر (ال الإِزعاجُ والإِخَافَةُ، تقولُ: ويَقْشَعِرُّ الإِهَابُ إِذَا وَقَعَ مِنْهُ…)\nمثال: الإنفصاليون مثل الإرهاب.",
 "虐める": "مُسْتَأْسِد, مُتَنَمِّر",
 "虐待": "تَعَسُّف, طُغْيَان\nمثال: أهان سامي ليلى بقص شعرها.",
 "虐待者": "مسيء, منتهك (شخص يمارس الإساءة)",
 "虐政": "طُغْيَان, اِسْتِبْدَاد",
 "虐殺": "ذَبْح (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون…)\nمثال: وعندما يتم ذبح الأبرياء في دارفور والبوسنة يسبب ذلك وصمة في ضميرنا المشترك.",
 "虐遇": "إساءة, سوء المعاملة (معاملة قاسية أو غير إنسانية)\nمثال: أظهر الطفل علامات الإساءة الجسدية",
 "虔しみ": "تَوَاضُع",
 "虔み": "تَوَاضُع",
 "虔む": "اِمْتَنَعَ (مَنَعَ نفسه؛ كان مَنِيْعًا يصعب الوصول إليه)",
 "虚": "سَمَاء, سما / طَقْس, جَوّ / قَصِيّ, نَائٍ جِدًّا (بعيد جدّاً في المكان أو الزمان) / حالة إدراكية, حالة معرفية (حالة العمليات المعرفية للشخص) / أَجْوَف / بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "虚け": "شرود الذهن (انشغال كبير لدرجة تجاهل متطلبات الانتباه العادية) / مُغَفَّل, أَحْمَق / رياء, زيف (صفة عدم الصراحة أو الصدق؛ الخداع أو النفاق)",
 "虚け者": "مُغَفَّل, أَحْمَق",
 "虚しい": "فَارِغ / سُدًى, عَبَثِيّ (لا يؤدّي إلى نجاح أو نتيجة مرجوّة) / جُثَّة هَامِدَة, فَاقِد الحَيَاة (حُرم من الحياة؛ لم يعد على قيد الحياة)",
 "虚しく": "عَبَثًا, سُدًى",
 "虚しくなる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "虚ろ": "تَجْوِيف / أَجْوَف",
 "虚事": "مُزَيَّف",
 "虚仮": "حماقة, طيش (سلوك أحمق أو لا معنى له)\nمثال: محاولة القيادة خلال عاصفة ثلجية هي قمة الحماقة",
 "虚仮威し": "خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك)\nمثال: نجحت مخادعته في قبوله",
 "虚偽": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد. / مُغَالَطَة (أما من حيث الصورة فكقولنا لصورة الفرس المنقوش على الجدار: إنها فرس، وكل فرس…)",
 "虚偽表示": "تحريف, تزييف (تحريف متعمد للحقائق)",
 "虚偽記載": "تحريف, تزييف (تحريف متعمد للحقائق)",
 "虚像": "خيال, صورة افتراضية (صورة بصرية منعكسة (كما تُرى في مرآة مستوية)) / ذريعة",
 "虚勢": "خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك)\nمثال: نجحت مخادعته في قبوله",
 "虚勢を張る": "خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك)\nمثال: نجحت مخادعته في قبوله",
 "虚報": "إشاعة كاذبة, فرية (تلفيق مضلل عمداً)",
 "虚妄": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "虚弱": "رقة, وهن (جودة الافتقار للشدة أو الجوهر)\nمثال: رقة صوت حادة ولكنها عذبة",
 "虚心": "مُنْفَتِح",
 "虚心坦懐": "إِفْرَنْجِيّ",
 "虚数": "عَدَد تَخَيُّلِيّ, عَدَد عُقَدِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "虚栄": "غُرُور",
 "虚栄の市": "حياة الترف, سوق الغرور (نمط حياة مغرور وتافه خاصة في المدن الكبيرة)",
 "虚栄心": "غُرُور",
 "虚構": "خَيَال, رِوَايَة (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "虚無": "عدم, لاشيء (حالة عدم الوجود)",
 "虚無主義": "عَدَمِيَّة",
 "虚無主義者": "فوضوي (داعية للفوضوية)",
 "虚無的": "عدمي (متعلق بالعدمية)",
 "虚無虚無しい": "خَاوٍ, فَارِغ (لَا يَحْتَوِي عَلَى شَيْء)",
 "虚脱": "خُمُول / اِنْهَار\nمثال: يوشك الجسر على الانهيار.",
 "虚脱感": "انكسار, قنوط (الشعور بالإحباط واليأس وتثبيط الهمة)",
 "虚脱状態": "ذهول, غشاوة (ارتباك يتميز بنقص الوضوح)\nمثال: تركه موت والدته في حالة ذهول",
 "虚血": "نقص التروية",
 "虚血性": "إقفاري, ناقص التروية (متعلق بـ أو مصاب بنقص التروية (الإقفار))",
 "虚血性心疾患": "مَرَض الْقَلْب التَّاجِيّ, دَاء الشَّرْيَان التَّاجِيّ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "虚言": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "虚語": "ضَجَعَ, تَمَدَّدَ\nمثال: اتهمتني بالكذب.",
 "虚辞": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "虚部": "جُزْء تَخَيُّلِيّ (الجزء من العدد المركب الذي يحتوي على الجذر التربيعي لـ -1 كعامل)",
 "虚飾": "اسْتِعْرَاض, مُبَاهَاة (عرض مدعٍ أو مبهرج أو مبتذل)",
 "虚飾的": "استعراضي, متباه (يهدف إلى جذب الانتباه وإبهار الآخرين)\nمثال: معطف سمور استعراضي",
 "虜": "أَسِير, أَسِيرَة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ…)\nمثال: أنا بريء وأسير حرب. / ضَحِيَّة / أَسِير, أَسِيرَة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ…)\nمثال: أنا بريء وأسير حرب. / أَجْنَبِيّ, أَجْنَبِيَّة",
 "虜囚": "أَسِير, أَسِيرَة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ…)\nمثال: أنا بريء وأسير حرب.",
 "虞美人草": "خشخاش الحقول, خشخاش الذرة (خشخاش أوروبي سنوي شائع في حقول الحبوب ويزرع غالباً)",
 "號": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟ / كنية, لقب تحبب (اسم مألوف لشخص (غالباً نسخة مختصرة من الاسم الأول للشخص))\nمثال: لم تستخدم والدة جو كنيته وكانت تناديه دائماً جوزيف / مَقَاس, قِيَاس",
 "虫": "حَشَرَة (صغار دواب الأرض؛ الهامة من هوام الأرض كالخنافس)\nمثال: ما زالت الحشرة حية. / شَخْص دَنِيء (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد…)\nمثال: هذا الشخص فنان. / فاقد الوعي, لاواعٍ (غير واعٍ؛ يفتقر إلى الوعي والقدرة على الإدراك الحسي كما لو كان نائماً أو ميتاً)\nمثال: مستلقٍ فاقداً للوعي على الأرض / تَوَتُّر",
 "虫えい": "صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة)",
 "虫がいい": "أَنَانِيّ",
 "虫が好かない": "كَرِهَ (لم يُحِبّ، لم يَسْتطِع تحمُّلَ شَخْص أو أمرٍ، لم يُطِقْه، مقَته وكان عنده…)\nمثال: هتلر كره اليهود.",
 "虫が良い": "أَنَانِيّ",
 "虫けら": "شَخْص دَنِيء (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد…)\nمثال: هذا الشخص فنان.",
 "虫こぶ": "صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة)",
 "虫さされ": "لدغة, لسعة (جرح مؤلم ناتج عن غرز حشرة لإبرتها في الجلد)",
 "虫のいい": "أَنَانِيّ",
 "虫の居所が悪い": "سَرِيع التَّأَفُّف, عَصَبِيّ (يتهيج أو ينزعج بسهولة)",
 "虫の知らせ": "توجس, نذير شؤم (فأل غير مواتٍ)\nمثال: شعور متزايد بنذير شؤم",
 "虫の良い": "أَنَانِيّ",
 "虫めがね": "عَدَسَةٌ مُكَبِّرَة",
 "虫よけ": "مبيد حشري (مادة كيميائية تستخدم لقتل الحشرات)",
 "虫ケラ": "شَخْص دَنِيء (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد…)\nمثال: هذا الشخص فنان.",
 "虫コブ": "صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة)",
 "虫ピン": "دَبُّوس",
 "虫メガネ": "عَدَسَةٌ مُكَبِّرَة",
 "虫下し": "طارِد لِلدِّيدان, مُبيد لِلطُّفَيْلِيّات (يَقْتُل الدِّيدان والطُّفَيْلِيّات المِعَوِيَّة)",
 "虫刺され": "لدغة, لسعة (جرح مؤلم ناتج عن غرز حشرة لإبرتها في الجلد)",
 "虫唾": "حُرْقَة الْمَعِدَة, حموضة معوية",
 "虫喰い": "مَسُوس, مُتَأَكِّلٌ بِالدُّودِ (مُصَابٌ أَوْ مُتَضَرِّرٌ بِفِعْلِ الدِّيدَانِ)",
 "虫国": "الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها…)\nمثال: الصين بلد عظيم.",
 "虫垂": "مُلْحَق",
