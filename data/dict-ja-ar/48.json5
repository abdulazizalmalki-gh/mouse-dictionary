 "静かに": "بهدوء (برباطة جأش (خاصة في أوقات التوتر)) / برزانة, بهدوء ووقار (بطريقة رزينة وهادئة)\nمثال: تحدث بهدوء للطلاب المشاغبين",
 "静けさ": "سكون, هدوء تام ((شعرياً) صمت وسكون مطمئن) / انعدام الحركة, جمود (حالة عدم وجود حركة) / انعدام الرياح, سكون (هدوء بدون رياح)\nمثال: سكون الليل",
 "静けし": "صَامِت, هَادِئ",
 "静まる": "هَدَأَ / أَهْدَأَ, هَدَّأَ",
 "静める": "صَامِت, هَادِئ / هَادِئ / طَمْأَنَ / سَكَّنَ (قَرَّ وهَدَأ، ضد اِضْطَرَبَ؛ وَطَنَ، يستخدم سكن عند الحديث عن البيت أو الدار ووطن عن الحديث عن البلاد أو المدينة)\nمثال: كان زيري بسكن هناك.",
 "静力学": "إستاتيكا, علم السكون (فرع الميكانيكا المعني بالقوى في حالة توازن)",
 "静寂": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "静寂主義": "سكونية (شكل من أشكال التصوف الديني يتطلب الانسحاب من كل جهد بشري والتأمل السلبي في الله)",
 "静寧": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام.",
 "静岡": "شِيزُوكَا",
 "静心無し": "مُتَوَتِّر جَسَدِيّاً (متعلق بقلق جسدي يسبب عدم الارتياح) / غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غير مرتاح, قلق (يفتقر إلى الشعور بالأمان أو لا يوفر راحة أو طمأنينة) / غير مريح, قلق (يفتقر أو لا يوفر راحة جسدية أو عقلية)\nمثال: كان المزارعون قلقين حتى نزل المطر أخيراً",
 "静思": "تأمل, مضاربة فكرية (تأمل مستمر وعميق في موضوع أو سلسلة من الموضوعات ذات طبيعة عميقة أو غامضة) / تأمل روحي ((دين) التأمل في الأمور الروحية (عادة في مواضيع دينية أو فلسفية))\nمثال: عادة التأمل هي الأساس لكل معرفة حقيقية",
 "静態": "سَاكِن, مُسْتَقِرّ (لا يُظهر تغيّرًا يُذكر إن وُجد) / ثَابِت, جَامِد (ليس في حالة حركة جسدية) / كهروستاتيكي, كهروسكوني (معني بـ أو منتج لـ أو ناتج عن الكهرباء الساكنة) / تَشْوِيش, نَقْد غَاضِب (نقد غاضب)\nمثال: مولد كهروستاتيكي ينتج كهرباء ساكنة عالية الجهد",
 "静振": "سيش, موجة راكدة (موجة على سطح بحيرة أو خليج غير ساحلي؛ ناجمة عن اضطرابات جوية أو زلزالية)",
 "静止": "سكون, هدوء تام ((شعرياً) صمت وسكون مطمئن) / انعدام الحركة, جمود (حالة عدم وجود حركة) / انعدام الرياح, سكون (هدوء بدون رياح)\nمثال: سكون الليل",
 "静止エネルギー": "طاقة السكون (الطاقة المكافئة لكتلة جسيم في حالة سكون في إطار مرجعي قصوري؛ تساوي كتلة السكون مضروبة في مربع سرعة الضوء)",
 "静止質量": "كتلة السكون ((في الفيزياء) كتلة الجسم عند قياسها عندما يكون الجسم في حالة سكون بالنسبة للمراقب، وهي خاصية متأصلة في الجسم)",
 "静止軌道": "مدار ثابت بالنسبة للأرض (مدار متزامن مع الأرض ثابت بالنسبة لموقع على الأرض)",
 "静止電位": "جهد الراحة (فرق الجهد بين جانبي غشاء خلية عصبية عندما لا تقوم الخلية بتوصيل نبضة)",
 "静注": "حقن وريدي (حقنة في الوريد)",
 "静物": "طبيعة صامتة (لوحة لأشياء جامدة مثل الفاكهة أو الزهور)",
 "静物画": "طبيعة صامتة (لوحة لأشياء جامدة مثل الفاكهة أو الزهور)",
 "静的": "سَاكِن, مُسْتَقِرّ (لا يُظهر تغيّرًا يُذكر إن وُجد) / ثَابِت, جَامِد (ليس في حالة حركة جسدية) / كهروستاتيكي, كهروسكوني (معني بـ أو منتج لـ أو ناتج عن الكهرباء الساكنة) / تَشْوِيش, نَقْد غَاضِب (نقد غاضب)\nمثال: مولد كهروستاتيكي ينتج كهرباء ساكنة عالية الجهد",
 "静穏": "سكينة, طمأنينة (طبع خالٍ من التوتر أو الانفعال) / سكون, طمأنينة (حالة من السلام والهدوء) / سكينة, هدوء (حالة خالية من المتاعب والاضطرابات)",
 "静粛": "صَامِت, سَاكِت",
 "静粛に": "بِهُدُوء",
 "静索": "حبل التثبيت التلقائي, حبل ثابت (حبل يستخدم بدلاً من حبل الفتح لفتح المظلة؛ يُربط أحد طرفيه بالطائرة والآخر بحقيبة المظلة، ويفتح المظلة بعد قفز المظلي من الطائرة)",
 "静置": "مَنْزِلَة, مَكَانَة / وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
