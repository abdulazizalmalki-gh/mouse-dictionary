 "霊感": "إِلْهَام, وَحْي",
 "霊柩": "تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل)",
 "霊柩自動車": "سَيَّارة نَقْل مَوْتَى, عَرَبة نَقْل مَوْتَى (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "霊柩車": "سَيَّارة نَقْل مَوْتَى, عَرَبة نَقْل مَوْتَى (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "霊歌": "رُوحَانِيّ, رُوحِيّ",
 "霊殿": "ضَرِيح",
 "霊液": "إِكْسِير",
 "霊猫": "زباد (ثديي يشبه القط يفرز عادة المسك المستخدم في العطور) / بساريسك, قط حلقي الذيل (ثديي قارت شبيه بالراكون من المكسيك وجنوب غرب الولايات المتحدة له ذيل كثيف طويل بحلقات سوداء وبيضاء)",
 "霊界": "العالم الروحي, عالم الغيب (اعتقاد بوجود عالم تسيطر عليه روح إلهية)",
 "霊異": "مُعْجِزَة, أُعْجُوبَة",
 "霊的": "رُوحَانِيّ, رُوحِيّ",
 "霊示": "وَحْي, تَنْزِيل (الإعلام في الخفاء، وهذا أصل الكلمة؛ الإلهام، سواء كان غريزيّ أو فطريّ أو فنيّ أو غيره وسواء كان من الله أو من غيره)\nمثال: يا رسول الله، كيف يأتيك الوحي ؟",
 "霊符": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "霊肉": "قلباً وقالباً (بإيمان كامل)\nمثال: كانت معه قلباً وقالباً",
 "霊能力者": "رُوحَانِيّ, نَفْسَانِيّ (خارج نطاق العلوم الفيزيائية) / رُوحَانِيّ, نَفْسِيّ (يؤثّر في النفس البشريّة أو يتأثّر بها) / نفساني, وسيط روحي (شخص يبدو حساساً لأشياء تتجاوز النطاق الطبيعي للإدراك)",
 "霊能者": "رُوحَانِيّ, نَفْسَانِيّ (خارج نطاق العلوم الفيزيائية) / رُوحَانِيّ, نَفْسِيّ (يؤثّر في النفس البشريّة أو يتأثّر بها) / نفساني, وسيط روحي (شخص يبدو حساساً لأشياء تتجاوز النطاق الطبيعي للإدراك)",
 "霊芝": "فطر الرف, فطر قوسي (فطر خشبي يشكل حوامل بوغية تشبه الرف على جذوع الأشجار والهياكل الخشبية)",
 "霊視": "إدراك خارج الحواس, استبصار (قوة ظاهرية لإدراك أشياء غير موجودة للحواس)",
 "霊長": "تَاج, إِكْلِيل",
 "霊長目": "رَئِيسِيَّات",
 "霊長類": "رَئِيسِيَّات",
 "霊長類学": "علم الرئيسيات (فرع علم الحيوان الذي يدرس الرئيسيات)",
 "霊験": "مُعْجِزَة, أُعْجُوبَة",
 "霊験あらたか": "خَارِق, مُعْجِز (الشيء)\nمثال: ذلك خارق للعادة.",
 "霊魂": "رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / سول\nمثال: كان سامي هو روح الحفلة.",
 "霊魂消滅": "إِفْنَاء, تَدْمِير / إِفْنَاء",
 "霍乱": "ضَرْبَة شَمْس (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "霙": "صقيع, مطر متجمد (ثلج ذائب جزئياً (أو خليط من المطر والثلج))",
 "霜": "صَقِيع / صَقِيع, صَقْعَة",
 "霜を置いた": "رَمَادِيّ, أَشْيَب",
 "霜枯れ": "قَاتِم, كَئِيب (لا يبعث على الأمل إلّا قليلاً أو لا يبعث عليه أبداً) / جَرْدَاء, قَاحِلَة (لا توفِّر مأوى ولا قوتاً) / قَارِص, كَئِيب (بارد ورطب بشكل مُزعج)",
 "霜枯れ時": "موسم ركود, موسم ميت (الموسم الميت هو فترة خلال العام يرغب فيها عدد قليل جدًا من الناس في شراء منتج أو خدمة معينة)\nمثال: عانى مقهى صديقي من موسم ميت بعد افتتاح ستاربكس في مكان قريب",
 "霜枯時": "موسم ركود, موسم ميت (الموسم الميت هو فترة خلال العام يرغب فيها عدد قليل جدًا من الناس في شراء منتج أو خدمة معينة)\nمثال: عانى مقهى صديقي من موسم ميت بعد افتتاح ستاربكس في مكان قريب",
 "霜柱": "بلورة جليدية, رذاذ ثلجي (بلورات صغيرة من الجليد)",
 "霜焼け": "تَثْلِيج, قَضْمَة صَقِيع",
 "霜解け": "أَذَابَ (فعل تعدي من ذَابَ بمعنى جعله يَذُوبُ) / ذَابَ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا فشيئًا، مثل ذوبان الجليد أو اختفاء الألم)\nمثال: ذاب ذلك الجليد.",
 "霜降": "خَلِيس / تجزع (تداخل الدهون واللحم في قطعة من اللحم)",
 "霜降り": "خَلِيس / تجزع (تداخل الدهون واللحم في قطعة من اللحم)",
 "霞": "عَجَاج / خُفُوت, عَتْمَة (صفة كون الشيء خافتاً أو يفتقر إلى التباين) / خفوت, عتمة (خاصية الأضواء أو الأصوات التي تفتقر إلى البريق أو منخفضة الشدة) / خفوت, عتمة (حالة ضعف الإضاءة)",
 "霞石": "نيفيلين (معدن مائل للبياض يتكون من سيليكات الصوديوم والألمنيوم أو البوتاسيوم في شكل بلوري؛ يستخدم في صناعة السيراميك والمينا)",
 "霞草": "جِيبْسُوفِيلَا, كُنْدُس",
 "霧": "ضَبَاب, شبورة / مرذاذ (موزع يحول السائل (مثل العطر) إلى رذاذ ناعم) / غصن مزهر (تنسيق زهور يتكون من غصن واحد أو فرع يحمل أزهاراً وأوراقاً) / رذاذ (دفق من البخار أو قطرات السائل) / رذاذ, رشقة (كمية من الأجسام الصغيرة تتطاير في الهواء)\nمثال: رشقة من الرصاص",
 "霧化": "تحويل إلى ذرات, تذرية (الإفناء عن طريق تحويل الشيء إلى ذرات) / تذرية, تفتيت (فصل شيء ما إلى جزيئات دقيقة)",
 "霧吹き": "رش المحاصيل (نثر مبيدات الفطريات أو الحشرات أو الأسمدة على المحاصيل النامية (غالباً من طائرة تحلق على ارتفاع منخفض)) / رش (وضع سائل على شكل جزيئات صغيرة تقذف من بخاخ) / رذاذ, رشقة (كمية من الأجسام الصغيرة تتطاير في الهواء)\nمثال: رشقة من الرصاص / مرذاذ (موزع يحول السائل (مثل العطر) إلى رذاذ ناعم) / عامل رش (عامل يضع الرذاذ على سطح ما)",
 "霧散": "اختفاء مفاجئ, تلاشي (اختفاء مفاجئ عن الأنظار) / اختفاء مفاجئ, تلاشي (اختفاء مفاجئ أو غامض)",
 "霧氷": "بَرَد (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن الميت تبرد جثته. فعل لازم مصدر بَرْد)\nمثال: لا أتحمل البرد.",
 "霧深い": "ضَبَابِيّ, مُعْتِم (ممتلئ بالضباب أو السديم) / ضَبَابِيّ (مبلَّل بالضباب الخفيف)",
 "霧状": "مرذاذ (موزع يحول السائل (مثل العطر) إلى رذاذ ناعم) / غصن مزهر (تنسيق زهور يتكون من غصن واحد أو فرع يحمل أزهاراً وأوراقاً) / رذاذ (دفق من البخار أو قطرات السائل) / رذاذ, رشقة (كمية من الأجسام الصغيرة تتطاير في الهواء)\nمثال: رشقة من الرصاص",
 "霧笛": "بوق الضباب (جهاز تحذير يتكون من بوق يولد نغمة منخفضة عالية الصوت) / إشارة الضباب, بوق الضباب (إشارة تحذير منخفضة وعالية الصوت يمكن سماعها من قبل السفن المحاصرة بالضباب)",
 "霧箱": "غرفة سحابية, غرفة ويلسون السحابية (جهاز يكشف مسار الجسيمات عالية الطاقة التي تمر عبر بخار مفرط التشبع؛ حيث يؤين كل جسيم الجزيئات على طول مساره وتتكثف قطرات صغيرة عليها لتنتج مساراً…)",
 "霧雨": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "霧雲": "رهج, سحاب طبقي (سحابة كبيرة داكنة ومنخفضة)",
 "霰": "بَرَد, مطر تلج (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن الميت تبرد جثته. فعل لازم مصدر بَرْد) / السلام عليك, السلام عليكم\nمثال: لا أتحمل البرد. / زهر, نرد (مكعب صغير به 1 إلى 6 نقاط على الأوجه الستة؛ يستخدم في المقامرة لتوليد أرقام عشوائية)",
 "霰星": "نَاتِئَة",
 "霰石": "أراغونيت (شكل معدني من كربونات الكالسيوم البلورية؛ ثنائي الشكل مع الكالسيت)",
 "霰粒腫": "برد, كيسة ميبومية (كيس دهني صغير في الجفن ينتج عن انسداد غدة ميبوميان)",
 "露": "رُوسِيَا (دولة يقع جزء منها في شمال شرق أوروبا، والجزء الأكبر في شمال آسيا؛ اسمها الرسمي الاتحاد الروسي، وعاصمتها موسكو، وهي أكبر دولة في العالم من حيث المساحة)\nمثال: زوجتي من روسيا. / نَدَى, طَلّ / بكاء, نحيب (عملية ذرف الدموع (عادة ما تكون مصحوبة بنشيج أو أصوات أخرى غير مفصلة))\nمثال: أكره سماع بكاء طفل / بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً / مَكْشُوف, مُعَرَّض / عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور",
 "露にする": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "露に濡れた": "مُبَلَّل بِالنَّدَى, مُنَدًّى (مبلَّل بالندى)",
 "露の間": "لَحْظَة",
 "露わ": "مَكْشُوف, مُعَرَّض / عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور",
 "露わにする": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "露光": "تعريض (فعل تعريض شخص ما لتجربة مؤثرة) / ترك في العراء, نبذ (التخلي دون مأوى أو حماية (مثل ترك رضيع في العراء)) / إظهار, كشف (العرض للمشاهدة بطريقة علنية أو عامة) / تعريض (فعل تعريض الفيلم للضوء)\nمثال: نددت بتعريض الأطفال للمواد الإباحية",
 "露光装置": "الطباعة الحجرية",
 "露光計": "مقياس الضوء (معدات تصوير فوتوغرافي تقيس شدة الضوء)",
 "露出": "تعريض (فعل تعريض شخص ما لتجربة مؤثرة) / ترك في العراء, نبذ (التخلي دون مأوى أو حماية (مثل ترك رضيع في العراء)) / إظهار, كشف (العرض للمشاهدة بطريقة علنية أو عامة) / تعريض (فعل تعريض الفيلم للضوء)\nمثال: نددت بتعريض الأطفال للمواد الإباحية",
 "露出不足": "ضعف الدعاية, قلة التعرض (دعاية أو تعرض غير كافٍ) / تعريض ناقص (فعل تعريض الفيلم لضوء قليل جدًا أو لفترة قصيرة جدًا)",
 "露出狂": "استعراضي, محب للظهور (شخص يتصرف عمداً بطريقة تجذب الانتباه) / استعراضي (شخص لديه رغبة قهرية في كشف أعضائه التناسلية)",
 "露出症": "استعراضية (الفعل المنحرف المتمثل في كشف الأعضاء التناسلية وجذب الانتباه إليها) / استعراضية, حب الظهور (سلوك مبالغ فيه وواضح يهدف إلى جذب الانتباه للنفس)",
 "露出計": "مقياس الضوء (معدات تصوير فوتوغرافي تقيس شدة الضوء)",
 "露出魔": "غمّاز, وماض (ضوء يضيء وينطفئ؛ يستخدم كإشارة أو لإرسال رسائل) / وماض (جهاز كهربائي يقوم بتشغيل وإيقاف المصباح تلقائياً (كما في شاشات الإعلانات)) / استعراضي (شخص لديه رغبة قهرية في كشف أعضائه التناسلية)",
 "露台": "شُرْفَة",
 "露呈": "تعريض (فعل تعريض شخص ما لتجربة مؤثرة) / ترك في العراء, نبذ (التخلي دون مأوى أو حماية (مثل ترك رضيع في العراء)) / إظهار, كشف (العرض للمشاهدة بطريقة علنية أو عامة) / تعريض (فعل تعريض الفيلم للضوء)\nمثال: نددت بتعريض الأطفال للمواد الإباحية",
 "露営": "مخيم, معسكر (أماكن معيشة مؤقتة بناها الجيش خصيصاً للجنود) / مخيم, موقع تخييم (موقع يمكن للأشخاص في العطلة نصب خيمة فيه)\nمثال: أينما ذهب في المعسكر كان الرجال يتذمرون",
 "露国": "رُوسِيَا (دولة يقع جزء منها في شمال شرق أوروبا، والجزء الأكبر في شمال آسيا؛ اسمها الرسمي الاتحاد الروسي، وعاصمتها موسكو، وهي أكبر دولة في العالم من حيث المساحة)\nمثال: زوجتي من روسيا.",
 "露地": "بالخارج, في الخارج (خارج مبنى) / خلاء, عراء (حيث يكون الهواء غير محصور)\nمثال: في الصيف نلعب في الخارج",
 "露壇": "شرفة أرضية, فناء (منطقة خارجية مبلطة عادة مجاورة للمسكن) / شرفة, صف منازل (صف من المنازل مبني بنمط مماثل وله جدران فاصلة مشتركة (أو الشارع الذي تطل عليه)) / شرفة, مصطبة (رف مستوٍ من الأرض يقطع انحداراً (مع منحدرات حادة فوقه وتحته))",
 "露天": "خلاء, عراء (حيث يكون الهواء غير محصور)\nمثال: أراد الخروج للهواء الطلق قليلاً",
 "露帝": "تْسَار, قَيْصَر",
 "露店": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "露店市": "سوق شعبي, سوق مفتوح (سوق عام حيث يباع الطعام والبضائع في الهواء الطلق)",
 "露悪的": "مُتَوَاضِع, مُنْتَقِص مِنْ ذَاتِه (واعٍ بعيوبه وقصوره الشخصيّة)",
 "露払い": "راكِب الطَّلِيعَة, مُرافِق مُتَقَدِّم (مرافق يركب (عادة دراجة أو حصاناً) في مقدمة الموكب)",
