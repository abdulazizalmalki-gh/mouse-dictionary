 "裏帆": "إِلَى اَلْخَلْف (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "裏年": "سنة ركود سياسي (سنة لا تُجرى فيها انتخابات سياسية كبرى) / سنة ركود (سنة تكون فيها الإنتاجية منخفضة أو رديئة)",
 "裏庭": "ساحة خلفية, فناء خلفي (الأرض الواقعة خلف المنزل)",
 "裏張": "بِطَانَة",
 "裏張り": "بِطَانَة",
 "裏当て": "دعم, مؤازرة (فعل تقديم الموافقة والدعم) / بطانة, دعامة خلفية (شيء يشكل ظهراً يضاف للتقوية) / تمويل, دعم مالي (الموارد المالية المقدمة لجعل مشروع ما ممكناً)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "裏情報": "تَلْمِيح, طَرَف خَيْط (إشارة إلى فرصة محتملة)\nمثال: حصل على نصيحة حول سوق الأسهم",
 "裏戸": "باب خلفي, وسيلة سرية (وسيلة سرية أو ملتوية للوصول (إلى مكان أو منصب)) / باب خلفي, مدخل خلفي (مدخل في الجزء الخلفي من المبنى) / باب خلفي, مدخل خلفي (طريقة غير موثقة للوصول إلى نظام حاسوب أو البيانات التي يحتوي عليها)\nمثال: حصل على وظيفته من الباب الخلفي",
 "裏手": "خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "裏打ち": "بِطَانَة / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "裏技": "غَشَّ",
 "裏拍": "مُبْتَهِج, مُتَفَائِل بِسَذَاجَة (متفائل بشكل لطيف وربما غير واقعي) / نبرة صاعدة, نقر ضعيف (نقر غير مشدد (خاصة النقر الأخير في المقياس)) / رفاهية, سعادة (حالة قناعة وسعادة وصحة وازدهار)\nمثال: كانت المدينة أخيراً في حالة تحسن (رفاهية) بعد مشاكلنا الأخيرة",
 "裏日本": "بَحْر اَلْيَابَان (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "裏書": "إقرار, تزكية (فعل المصادقة أو التزكية) / تظهير, مصادقة (توقيع يثبت صحة شيء ما) / إقرار, تأييد (موافقة رسمية وصريحة) / تأييد, تثنية (حديث لتأييد أو تثنية اقتراح ما)\nمثال: يمكن للرياضي النجم أن يجني الكثير من المال من عقود التزكية / تَعْلِيق, مَلْحُوظَة / عَلَّقَ / بُرْهَان, دَلِيل",
 "裏書き": "إقرار, تزكية (فعل المصادقة أو التزكية) / تظهير, مصادقة (توقيع يثبت صحة شيء ما) / إقرار, تأييد (موافقة رسمية وصريحة) / تأييد, تثنية (حديث لتأييد أو تثنية اقتراح ما)\nمثال: يمكن للرياضي النجم أن يجني الكثير من المال من عقود التزكية / تَعْلِيق, مَلْحُوظَة / عَلَّقَ / بُرْهَان, دَلِيل",
 "裏書き人": "مُجَيِّر, مُظَهِّر (شخص ينقل ملكيته لشيء ما عن طريق التوقيع على شيك أو ورقة مالية قابلة للتداول) / مؤيد, مصادق (شخص يعبر عن موافقة قوية)",
 "裏書人": "مُجَيِّر, مُظَهِّر (شخص ينقل ملكيته لشيء ما عن طريق التوقيع على شيك أو ورقة مالية قابلة للتداول) / مؤيد, مصادق (شخص يعبر عن موافقة قوية)",
 "裏書禁止手形": "غَيْر قَابِل لِلتَّدَاوُل (لا يمكن شراؤه أو بيعه)",
 "裏木戸": "بَاب خَلْفِيّ (ما يُسَدُّ به مَدْخَل المَبْنَى أو الغُرْفَة أو المَرْكَبَة؛ (تعميم) مَدْخَل أي شيء؛ فُتْحَة)\nمثال: ظل الباب مغلقا.",
 "裏本": "تَحْتَ الطَّاوِلَة (يُباع خُفْيَةً بِشَكْل غَيْر قانونِيّ)",
 "裏板": "سَقْف ((سَقَفَ) البيت ونحوه سقفا: عمل له سقفا)\nمثال: نظرت إلى السقف.",
 "裏海": "بَحْر دَاخِلِيّ (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر. / بَحْر قَزْوِين, بَحْر الخَزَر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "裏漉し": "غِرْبَال, مِصْفاة / صَفَّى, غَرْبَلَ / هريس (اسم مفعول من هَرَسَ، وهو المدقوق دقا عنيفا حتى تفتت؛ اسم: طعام مصنوع من القَمْح المدقوق بقوة مخلوطا باللحم)",
 "裏漉し器": "غِرْبَال, مِصْفاة / صَفَّى, غَرْبَلَ",
 "裏町": "حارة, زقاق (شارع ضيق بجدران على كلا الجانبين)",
 "裏白白揚": "خشب الحور الأصفر, خشب الزنبق (خشب خفيف سهل العمل لشجرة الزنبق؛ يستخدم للأثاث والقشرة) / حور أبيض (حور يزرع على نطاق واسع في الولايات المتحدة؛ له لحاء أبيض وأوراق ذات أسطح سفلية بيضاء)",
 "裏白箱柳": "خشب الحور الأصفر, خشب الزنبق (خشب خفيف سهل العمل لشجرة الزنبق؛ يستخدم للأثاث والقشرة) / حور أبيض (حور يزرع على نطاق واسع في الولايات المتحدة؛ له لحاء أبيض وأوراق ذات أسطح سفلية بيضاء)",
 "裏皮": "شمواه, قماش شمواه (قماش مصنوع ليشبه جلد الشمواه) / جلد سويدي, شمواه (جلد ذو سطح وبري) / قطعة جلد (جزء منفصل مصنوع من الجلد)",
 "裏盆": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "裏目": "ضِدّ / آخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / عَلَى العَكْس (يفيد الاستعلاء؛ يفيد التعليل) / فِي مُوَاجَهَة, أَمَام (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / أَمَام\nمثال: أرني مثالا آخر. / غرزة مقلوبة (غرزة حياكة أساسية مصنوعة بوضع الإبرة عبر الجزء الأمامي من الغرزة من الجانب الأيمن)",
 "裏目に出る": "نتيجة عكسية (سوء تقدير يرتد على صاحبه) / حريق مضاد (حريق يتم إشعاله عمداً لإبطاء حريق غابة أو حشائش مقبل عن طريق إخلاء منطقة محترقة في مساره) / اشتعال خلفي, فرقعة عكسية (ضجيج عالٍ صادر عن انفجار الوقود في متشعب أو عادم محرك الاحتراق الداخلي) / ارتداد غازي, نفث خلفي (الهروب العكسي للغازات والبارود غير المحترق بعد إطلاق النار)",
 "裏目る": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "裏社会": "سِجِّين, عَالَم سُفْلِيّ",
 "裏移り": "تراجع معماري, ردة الجدار (هيكل يضيق فيه الجدار أو المبنى بشكل مفاجئ) / أوفست, طباعة أوفست (يقوم لوح بعمل طبعة محبرة على أسطوانة مغطاة بالمطاط، والتي بدورها تنقلها إلى الورق) / فرع, نتاج طبيعي (عاقبة طبيعية للتطور) / رئد, ساق جارية (فرع أفقي من قاعدة النبات ينتج نباتات جديدة من براعم في أطرافه)",
 "裏窓": "نافذة خلفية (نافذة سيارة تسمح بالرؤية من الجزء الخلفي للسيارة)",
 "裏編み": "غرزة مقلوبة (غرزة حياكة أساسية مصنوعة بوضع الإبرة عبر الجزء الأمامي من الغرزة من الجانب الأيمن) / خيط مقصب, سلك ذهبي أو فضي (خيط سلكي من الذهب أو الفضة)",
 "裏縞躑躅": "عنب الدب الألبي, قطلب ألبي (شجيرة زاحفة متساقطة الأوراق تكون حمراء زاهية في الخريف ولها توت أسود أو أزرق مسود؛ ألبية وقطبية)",
 "裏背戸": "بَاب خَلْفِيّ (ما يُسَدُّ به مَدْخَل المَبْنَى أو الغُرْفَة أو المَرْكَبَة؛ (تعميم) مَدْخَل أي شيء؛ فُتْحَة)\nمثال: ظل الباب مغلقا.",
 "裏腹": "ضِدّ / آخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / عَلَى العَكْس (يفيد الاستعلاء؛ يفيد التعليل) / فِي مُوَاجَهَة, أَمَام (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / أَمَام\nمثال: أرني مثالا آخر.",
 "裏街": "حارة, زقاق (شارع ضيق بجدران على كلا الجانبين)",
 "裏街道": "طريق جانبي, طريق فرعي (طريق جانبي قليل الاستخدام (كما في الريف))",
 "裏表": "بِالْمَقْلُوبِ / ازدواجية, تعامل بوجهين (التصرف بسوء نية؛ الخداع بالتظاهر بامتلاك مجموعة من النوايا بينما يتصرف تحت تأثير أخرى) / ذُو وَجْهَيْن, مُرَاوِغ (يتَّسم بخداع متعمَّد خاصَّة بإظهار مشاعر والتصرُّف بمشاعر أخرى)",
 "裏話": "خلفية درامية",
 "裏貼": "بِطَانَة",
 "裏貼り": "بِطَانَة",
 "裏路地": "حارة, زقاق (شارع ضيق بجدران على كلا الجانبين)",
 "裏返し": "بِالْمَقْلُوبِ / الوَجْه الآخَر (جانب مختلف لشيء ما (وخاصة الجانب المعاكس))\nمثال: الوجه الآخر لصفاتك الإيجابية هو أنها تخرج أحياناً عن السيطرة",
 "裏返る": "خانَ (النُزْل أو الفُنْدُق أو اِسْتِرَاحَة المسافرين؛ الحَانُوْت أو الدُكَّان)\nمثال: خان ياني سكورة. / صَرِير / صَرَّ ((صَرَّ) يَصْرِرِ صَريرًا: صوَّتَ. يقال: (صَرَّ) العصفورُ والجُندُبُ، و(صَرَّ) القلم، و(صَرَّ) البابُ؛ (صَرَّتِ) الأُذنُ: كان لها طنين)\nمثال: لدى مايوكو حاسة بصر حادة.",
 "裏通": "شارع جانبي (شارع يتقاطع مع شارع رئيسي وينتهي عنده)",
 "裏通り": "شارع جانبي (شارع يتقاطع مع شارع رئيسي وينتهي عنده)",
 "裏道": "طريق جانبي, طريق فرعي (طريق جانبي قليل الاستخدام (كما في الريف))",
 "裏金": "رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا. / أموال سرية, صندوق رشاوى (صندوق لشراء الأصوات أو رشوة المسؤولين الحكوميين)",
 "裏面": "خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر. / دَاخِل / فِي بَطْن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / ضِمْن / دَاخِل, جُوَّة\nمثال: جون في عمر أخي.",
 "裏面に続く": "عمود نقل الحركة, مأخذ طاقة (جهاز ينقل الطاقة من محرك (كما في الجرار أو المركبات الآلية الأخرى) إلى قطعة أخرى من المعدات (مثل مضخة أو مطرقة ثقب))",
 "裏革": "شمواه, قماش شمواه (قماش مصنوع ليشبه جلد الشمواه) / جلد سويدي, شمواه (جلد ذو سطح وبري) / قطعة جلد (جزء منفصل مصنوع من الجلد)",
 "裏ＤＶＤ": "سُوق سَوْدَاء (مكان للبيع والشراء؛ جمع ساق، قال الله تعالى: 《رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ》)\nمثال: ذهبت إلى السوق.",
 "裑": "صدرية الفستان (جزء من الفستان فوق الخصر)",
 "裔": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "裕木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "裕福": "غَنِيّ",
 "裕福層": "غَنِيّ",
 "裘": "معطف فرو (معطف مصنوع من الفرو)",
 "補い": "تجديد موارد",
 "補い合う": "عُمْدَة",
 "補う": "ملحق / مُكَمِّل",
 "補する": "تعيين شخص لعمل ما",
 "補てん": "تطبيق, طلاء (عمل وضع شيء (على سطح)) / تغطية (فعل حماية شيء ما بتغطيته) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / غِطَاء (مصنوعة تُغطّي شيئًا آخر عادةً لحمايته أو إيوائه أو إخفائه)\nمثال: وصف الطبيب وضعاً موضعياً لليود",
 "補佐": "مُسَاعَدَة",
 "補佐人": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "補佐官": "مرافق عسكري, مساعد (ضابط يعمل كمساعد عسكري لضابط أعلى رتبة) / مساعد (شخص يعمل كمساعد)",
 "補佐役": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "補佐的": "داعم, مؤازر (يقدم الدعم أو المساعدة)\nمثال: شبكة عائلية داعمة",
 "補体": "عُمْدَة",
 "補修": "أَصْلَحَ / تَصْلِيح / إِصْلَاح / تَرْمِيم (التَّرْميم :إِصْلَاح البناء المتصدِّع أو المتداعي؛ عملية الإصلاح نفسها) / مَرَمَّة",
 "補償": "تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / تعويض (شيء (مثل المال) يُعطى أو يُستلم كدفعة أو تعويض (كما هو الحال عن خدمة أو خسارة أو إصابة)) / تعويض ((في الطب النفسي) آلية دفاع تخفي عيوبك غير المرغوب فيها عن طريق المبالغة في السلوكيات المرغوبة)",
 "補償金": "إصلاح الضرر, تعويض (شيء يتم فعله أو دفعه تكفيراً عن خطأ) / إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / تعويضات الحرب ((عادة بصيغة الجمع) تعويض يفرضه المنتصرون على دولة مهزومة) / إصلاح, جبر الضرر (تعويض (مُعطى أو مُستلم) عن إهانة أو إصابة)\nمثال: كيف يمكنني التكفير عن خطئي",
 "補充": "تجديد موارد",
 "補充兵": "جندي احتياط (عضو في قوات الاحتياط العسكرية)",
 "補充書": "وَجِيز, قَصِير / وَجِيز, مُوجَز",
 "補助": "مُسَاعَدَة, إِمْدَاد / إِعَانَة مَالِيَّة / اكتشاف, رصد (فعل اكتشاف شيء ما؛ أو ملاحظة شيء ما) / تبقيع, تلطيخ (فعل تبقيع أو تلطيخ شيء ما)",
 "補助元帳": "دفتر أستاذ مساعد (تفاصيل حساب تدعم المبلغ المذكور في دفتر الأستاذ العام)",
 "補助券": "قَسِيمَة",
 "補助動詞": "فعل مساعد (فعل يندمج مع فعل آخر في عبارة فعلية للمساعدة في تشكيل الزمن أو الصيغة أو البناء أو الشرط للفعل الذي يندمج معه)",
 "補助員": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "補助定理": "سُدَّة, لِيمَّا",
 "補助機関": "محرك مساعد ((بحري) محرك صغير (مثل الذي يستخدم على متن السفن لتشغيل الرافعة))",
 "補助的": "إِضَافِيّ, تَكْمِيلِيّ (يعمل في صفة داعمة ومساندة) / إِضَافِيّ, مُسَاعِد (يقدم دعمًا إضافيًا) / مساعد (شخص يعمل كمساعد)",
 "補助翼": "جنيح (سطح انسيابي يتحكم في الحركة الجانبية)",
 "補助者": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "補助装置": "معدات غير متصلة, معدات مساعدة (معدات إلكترونية ليست في اتصال مباشر (أو تحت سيطرة) وحدة المعالجة المركزية)",
 "補助記憶": "تخزين خارجي, تخزين مساعد (جهاز تخزين بيانات ليس الذاكرة الرئيسية للحاسوب)",
 "補助記憶装置": "تخزين خارجي, تخزين مساعد (جهاز تخزين بيانات ليس الذاكرة الرئيسية للحاسوب)",
 "補助費": "إِعَانَة مَالِيَّة",
 "補助輪": "مثبت, موازن (جهاز لجعل شيء ما مستقراً) / مثبت (سطح انسيابي يتكون من جهاز لتثبيت الطائرة) / مادة مثبتة, مثبت (مادة كيميائية تضاف إلى محلول أو خليط أو معلق للحفاظ عليه في حالة مستقرة أو غير متغيرة)",
 "補助通貨": "عملة كسرية (عملة ورقية بفئات أقل من الوحدة النقدية الأساسية)",
 "補助金": "إِعَانَة مَالِيَّة",
 "補動": "فعل مساعد (فعل يندمج مع فعل آخر في عبارة فعلية للمساعدة في تشكيل الزمن أو الصيغة أو البناء أو الشرط للفعل الذي يندمج معه)",
 "補回": "أشواط إضافية (اللعب الإضافي حتى يتقدم فريق واحد في نهاية الشوط؛ مثل البيسبول)",
 "補因子": "تميم, عامل مرافق (مادة (مثل الإنزيم المساعد) يجب أن تتحد مع مادة أخرى لإنتاج نتيجة معينة)",
 "補填": "تطبيق, طلاء (عمل وضع شيء (على سطح)) / تغطية (فعل حماية شيء ما بتغطيته) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / غِطَاء (مصنوعة تُغطّي شيئًا آخر عادةً لحمايته أو إيوائه أو إخفائه)\nمثال: وصف الطبيب وضعاً موضعياً لليود",
 "補外法": "استقراء خارجي, تنبؤ استقرائي (استدلال حول المستقبل (أو حول موقف افتراضي) بناءً على حقائق وملاحظات معروفة) / إقحام خارجي, استقراء ((رياضيات) حساب قيمة دالة خارج نطاق القيم المعروفة)",
 "補完": "تَوْزِيع تَكَامُلِيّ ((اللغويات) توزيع أصوات أو أشكال الكلام ذات الصلة بطريقة تجعلها تظهر فقط في سياقات مختلفة) / تَتْمِيم, تَكْمِلَة (العلاقة النحوية لكلمة أو عبارة بمسند)",
 "補完医学": "طب تكميلي (ممارسة الطب التي تجمع بين الطب التقليدي والطب البديل)",
 "補完医療": "طب تكميلي (ممارسة الطب التي تجمع بين الطب التقليدي والطب البديل)",
 "補導": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد / اعتقال, قبض (فعل القبض (خاصة القبض على مجرم))\nمثال: حصل الشرطي المناوب على التقدير للقبض على المجرم",
 "補巻": "ملحق / مُكَمِّل",
 "補強": "تعزيز, دعم (عملية عسكرية (غالباً ما تتضمن إمدادات جديدة من الرجال والعتاد) لتقوية قوة عسكرية أو المساعدة في أداء مهمتها) / تعزيز, مكافأة (فعل يتم القيام به لتقوية سلوك مقبول) / دعامة تقوية, مقوي (جهاز مصمم لتوفير قوة إضافية) / مثير معزز, معزز ((علم النفس) مثير يقوي أو يضعف السلوك الذي أنتجه)\nمثال: طلبوا دعماً مدفعياً",
 "補強証拠": "إثبات, تأييد (تأكيد صحة حقيقة أو بيان من خلال استخدام الأدلة الوثائقية)",
 "補弼": "مُسَاعَدَة, إِمْدَاد",
 "補数": "عُمْدَة",
 "補欠": "إلحاق, تكميل (عملية التكميل) / إضافة, تكملة (كمية تضاف (مثلاً لتعويض نقص)) / اِسْتَبْدَلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "補欠選手": "اِسْتَبْدَلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
