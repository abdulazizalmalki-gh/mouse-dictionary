 "雄叫び": "أَنَّ (يفيد التوكيد) / قَهْقَهَ / زَئِير (اسم لصوت الأَسَد؛ زائير اسم سابق لجمهورية الكونغو الديمقراطية)\nمثال: كيف لي أن أعرف؟ / صرخة, عويل (صيحة حادة ثاقبة) / صراخ, صرخة (ضجيج عالي النبرة يشبه صرخة الإنسان)\nمثال: جذب صراخها الجيران",
 "雄壮": "بُطُولِيّ",
 "雄大": "جَلِيل, فَخْم (يُوصَف بِهِ مَظْهَر الشَّخْص أَوْ سُلُوكه؛ يَلِيق بِشَخْصٍ بَارِز) / فَخْم, كَبِير (الأكثر أهمّيّة وفخامة في الزخرفة) / طَمُوح, وَاسِع النِّطَاق (من السلوك المُثير للإعجاب والطموح في الحجم أو النطاق) / عَظِيم, فَخْم (كبير ومثير للإعجاب في الحجم المادي أو الامتداد)",
 "雄弁": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "雄弁は銀、沈黙は金": "إِنْ كَانَ الْكَلَامُ مِنْ فِضَّةٍ فَالسُّكُوتُ مِنْ ذَهَبٍ (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "雄弁家": "خَطِيب, خَطِيبَة",
 "雄弁術": "مُصَلًّى (موضع الصلاة للشخص والجماعة؛ غرفة تخصص للصلاة في الأماكن العامّة، لا إمام فيها وهي دون المسجد) / خِطَابَة",
 "雄心": "أَمَل ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / رَشْف (رشف الماء أو نحوه: مصه بشفتيه؛ رشف الإناء: شرب ما فيه ولم يترك فيه شيئا) / زَفْر (زفَر الشَّخصُ : أخرج نفَسه من رئتيه بعد مدِّه إيّاه؛ أظهر تعبيرًا عن الحزن أو الألم من خلال تنهد أو صوت عميق)\nمثال: أشعر بخيبة أمل.",
 "雄心勃々": "طَمُوح",
 "雄心勃勃": "طَمُوح",
 "雄性": "رجولة, فحولة (سمة كون المرء رجلاً؛ امتلاك خصائص الذكر البالغ)",
 "雄性配偶体": "مشيج ذكري, نابتة عروسية صغروية (النابتة العروسية الذكرية التي تنتجها البوغة الصغيرة)",
 "雄松": "صنوبر أسود (صنوبر خشب كبير ثنائي الإبر من جنوب شرق أوروبا) / صنوبر أسود, صنوبر جيفري (صنوبر متناظر طويل من غرب أمريكا الشمالية له إبر زرقاء خضراء طويلة في حزم من 3 ومخاريط ممدودة على فروع منتشرة متدلية نوعاً ما؛ يصنف أحياناً كصنف من…) / صنوبر أسود ياباني (نبات زينة ياباني كبير له إبر طويلة في حزم من 2؛ يزرع على نطاق واسع في الولايات المتحدة لمقاومته للملح والضباب الدخاني) / صنوبر أسود, ميرو (صنوبرية نيوزيلندية تستخدم للأخشاب؛ يستخدم الخشب الداكن للنجارة الداخلية)",
 "雄武": "شَجَاعَة",
 "雄渾": "عَظِيم, رَائِع (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم.",
 "雄牛": "ثَوْر (حُمْرَة الشفق الثائرة فيه؛ الطُحْلُب وما أشبهه فوق الماء. سميّ كذلك لأنه يثور فجأة) / مَرْسُوم\nمثال: حرث ما حرث الثور.",
 "雄猫": "قط ذكر (ذكر القط)",
 "雄篇": "تُحْفَة, رَائِعَة",
 "雄編": "تُحْفَة, رَائِعَة",
 "雄羊": "كَبْش",
 "雄羊歯": "سَمِيك السَّاق (ذو ساق سميكة)",
 "雄蕊": "سَدَاة",
 "雄蛭木": "أفيسينيا مارينا, قرم أسود (مانغروف في جزر الهند الغربية وساحل فلوريدا الجنوبي؛ يوجد في غابات كثيفة وله جذور قصيرة عديدة تنحني لأعلى من الأرض) / مانغروف أسود (شجرة أسترالية تشبه المانغروف الأسود في جزر الهند الغربية وفلوريدا)",
 "雄蜂": "يَعْسُوب, يَمْخُور / مُسَيَّرَة, طَائِرَة بِدُونِ طَيَّار",
 "雄視": "غَالِب",
 "雄親": "أب, فحل (الوالد الذكر لحيوان، خاصة الحيوانات الأليفة مثل الحصان) / جد, سلف (مؤسس العائلة) / مولاي (لقب مخاطبة كان يستخدم سابقاً لرجل ذي رتبة وسلطة)\nمثال: حافظوا على إيمان أجدادنا",
 "雄豚": "خِنْزِير",
 "雄辯": "بَلَاغَة, فَصَاحَة (مطابَقةُ الكلام لمقتضى الحال أو حُسْن البَيَانِ وقوَّةُ التأثير؛ قُدرة المتكلِّم على البيان والتأثير)",
 "雄風": "نسيم قوي (رياح تتحرك بسرعة 25-31 عقدة؛ 6 على مقياس بوفورت)",
 "雄馬": "حصان (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: لم يشفى الحصان.",
 "雄鳥": "ديك (طائر ذكر بالغ) / ديك (ذكر الدجاج البالغ) / ديك, مطرقة (جزء من قفل البندقية يضرب كبسولة القدح عند سحب الزناد) / صنبور, محبس (صنبور يتكون من جهاز دوار لتنظيم تدفق السائل)",
 "雄鶏": "ديك (طائر ذكر بالغ) / ديك (ذكر الدجاج البالغ) / ديك, مطرقة (جزء من قفل البندقية يضرب كبسولة القدح عند سحب الزناد) / صنبور, محبس (صنبور يتكون من جهاز دوار لتنظيم تدفق السائل)",
 "雄鹿": "وَعْل, كَبْش",
 "雄黄": "رَهَج أَصْفَر",
 "雅": "تَكْرِير / أَنَاقَة",
 "雅び": "تَكْرِير",
 "雅びた": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "雅びやか": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "雅やか": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "雅兄": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "雅号": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "雅味": "تَكْرِير",
 "雅客": "عَالِم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي. / نَرْجِس",
 "雅歌": "سِفْرُ نَشِيدِ الْأَنْشَادِ (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد)\nمثال: صاحبته في السفر.",
 "雅称": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "雅致": "براعة, فن (مهارة فائقة يمكنك تعلمها بالدراسة والممارسة والملاحظة)\nمثال: فن المحادثة",
 "雅趣": "أَنَاقَة",
 "雅量": "شهامَة",
 "雅馴": "رَاقٍ, مُهَذَّب (يوحي بالذوق الرفيع واليسر والثراء) / مُحَسَّن, مُنَقَّح (دقيق إلى درجة رفيعة من الإحكام) / راق, مصقول ((للأشخاص وسلوكهم) مثقف ومهذب) / مكرر, منقى (منقى من الشوائب عن طريق المعالجة)\nمثال: كانت رقيقة ومهذبة وغير معتادة على المشقة",
 "集": "مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: شكرا لإضافتي للمجموعة.",
 "集い": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم.",
 "集う": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري.",
 "集く": "تَغْرِيدَة, تَغْرِيد / غَرَّدَ / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "集まり": "جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع",
 "集まる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "集め": "تجميع, جمع (فعل جمع شيء ما معاً)",
 "集める": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "集り": "اِبْتِزَاز (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد) / مبتز (مجرم يبتز المال من شخص ما بتهديده بفضح معلومات محرجة عنه) / جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع",
 "集り屋": "انتهازي, طفيلي (شخص يستغل كرم الآخرين)",
 "集る": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / إِسْفَنْج / سَفِنْج",
