 "萩野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "萬": "عَشَرَة آلَاف / لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)\nمثال: واجه عدداً لا يحصى من التفاصيل / كُلّ شَيْء / مُخْتَلِف, مُتَنَوَّع",
 "萬歳": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت)",
 "萱堂": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "萱草": "زنبق النهار (أي من النباتات المعمرة المتعددة ذات جذور درنية وأوراق طويلة ضيقة تشبه النصل…) / تِبْغ, تَبْغ",
 "萱葺き": "سقف معروش, سقف من القش (سقف منزل مصنوع من مادة نباتية (كالقش))",
 "萱葺き屋根": "سقف معروش, سقف من القش (سقف منزل مصنوع من مادة نباتية (كالقش))",
 "萵苣": "خَسّ (خَسَّ الرجُلُ يَخِسُّ خِسَّةً، وخَسَاسَةً: حَقُرَ؛ يقال: خَسَّ فِعْلُهُ وقولُه…)\nمثال: بيع المنزل بثمن بخس.",
 "萼": "كأس الزهرة ((نبات) دوارة السبلات للزهرة التي تشكل الغلاف الخارجي)",
 "萼片": "سَبَلَة, كَأْسِيَّة",
 "落": "اِنْزَلَقَ / أثر, عاقبة (ظاهرة تتبع وتنتج عن ظاهرة سابقة)\nمثال: كان التأثير المغناطيسي أكبر عندما كان القضيب بالطول / نُكْتَة",
 "落し": "سَاقِط, مُتَسَاقِط (يَنْزِلُ بِحُرِّيَّةٍ تَحْتَ تَأْثِيرِ الجَاذِبِيَّة) / تَنْظِيف / فَخّ, مِصْيَدَة / نَتِيجَة",
 "落しだね": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "落し卵": "بَيْض مَسْلُوق بِدُونَ قِشْر (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من…)\nمثال: ياني يحب البيض.",
 "落し子": "مُنْتَج",
 "落し紙": "وَرَق مِرْحَاض, وَرَق حَمَّام (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "落し胤": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "落し込む": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها)",
 "落す": "قَطْرَة\nمثال: هذه هي نقطة ضعفه. / نَقَلَ\nمثال: لا أزال عطشانا. / فَقَدَ\nمثال: خسر توم وظيفته. / أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل))\nمثال: سامي من طبقة أدنى.",
 "落ち": "اِنْزَلَقَ / أثر, عاقبة (ظاهرة تتبع وتنتج عن ظاهرة سابقة)\nمثال: كان التأثير المغناطيسي أكبر عندما كان القضيب بالطول / نُكْتَة",
 "落ちくぼむ": "انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته)",
 "落ちこぼれ": "بعثرة, نثر (عملية البعثرة) / الْبَقَايَا / مُتَسَرِّب (شخص يترك المدرسة قبل التخرج)",
 "落ちこぼれる": "تَأَخَّرَ / قَطْرَة\nمثال: هذه هي نقطة ضعفه.",
 "落ちついた": "هَادِئ / ثَابِت, مُسْتَقِرّ (غَيْر قَابِل لِلتَّغَيُّر)\nمثال: بدو؛ اندمجوا بين الناس المستقرين / غَيْر مُتَطَفِّل, مُتَحَفِّظ (غير مُتطفّل ولا ملحوظ بشكل مُزعج)",
 "落ちつく": "أَهْدَأَ, هَدَّأَ / هَدَأَ\nمثال: استقر زيري في خيمته. / مُبَارَاة",
 "落ちつける": "صَامِت, هَادِئ",
 "落ちのびる": "هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "落ちゆく": "هَرَبَ, فَرَّ (الفِرارُ)\nمثال: هرب كأرنب خائف. / هَدَأَ\nمثال: استقر زيري في خيمته.",
 "落ちる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب. / وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى / خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "落ち付き": "هُدُوء / اِسْتِقْرَار",
 "落ち付ける": "صَامِت, هَادِئ",
 "落ち口": "عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / فَم, بق / فوهة, مصب (فتحة تسمح بمرور السوائل أو الحبوب)",
 "落ち合う": "لِقَاء مُحَدَّد, مَوْعِد (اجتماع مخطط له في وقت ومكان معينين)\nمثال: كان ينتظرهم في مكان اللقاء / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر.",
 "落ち度": "أَسَاء اَلْفَهْم, أَخْطَأَ\nمثال: كان خطأ حاسوبي.",
 "落ち延びる": "هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "落ち武者": "هَارِب",
 "落ち着いた": "هَادِئ / ثَابِت, مُسْتَقِرّ (غَيْر قَابِل لِلتَّغَيُّر)\nمثال: بدو؛ اندمجوا بين الناس المستقرين / غَيْر مُتَطَفِّل, مُتَحَفِّظ (غير مُتطفّل ولا ملحوظ بشكل مُزعج)",
 "落ち着き": "هُدُوء / اِسْتِقْرَار",
 "落ち着く": "أَهْدَأَ, هَدَّأَ / هَدَأَ\nمثال: استقر زيري في خيمته. / مُبَارَاة",
 "落ち着ける": "صَامِت, هَادِئ",
 "落ち窪む": "انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته)",
 "落ち葉": "إسقاط الورق, تعرية الأشجار (التسبب في تساقط أوراق الأشجار والنباتات الأخرى (عن طريق استخدام مواد كيميائية…) / نَفَضِي, نَفَضِية",
 "落ち葉色": "بُنِّيّ مُحْمَرّ دَاكِن (بني مع مسحة حمراء داكنة)",
 "落ち行く": "هَرَبَ, فَرَّ (الفِرارُ)\nمثال: هرب كأرنب خائف. / هَدَأَ\nمثال: استقر زيري في خيمته.",
 "落ち込み": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / مُنْخَفَض",
 "落ち込む": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / غَطَسَ",
 "落ち零れ": "بعثرة, نثر (عملية البعثرة) / الْبَقَايَا / مُتَسَرِّب (شخص يترك المدرسة قبل التخرج)",
 "落ち零れる": "تَأَخَّرَ / قَطْرَة\nمثال: هذه هي نقطة ضعفه.",
 "落っこちる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب. / أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "落っことす": "قَطْرَة\nمثال: هذه هي نقطة ضعفه.",
 "落っこる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب. / أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "落った": "إسقاط, صرع (فعل إسقاط شيء ما (كشجرة))",
 "落つ": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "落とし": "سَاقِط, مُتَسَاقِط (يَنْزِلُ بِحُرِّيَّةٍ تَحْتَ تَأْثِيرِ الجَاذِبِيَّة) / تَنْظِيف / فَخّ, مِصْيَدَة / نَتِيجَة",
 "落としこむ": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها)",
 "落としだね": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "落としどころ": "أَرْضِيَّة مُشْتَرَكَة (أساس يتفق عليه جميع الأطراف للوصول إلى تفاهم متبادل)",
 "落とし入れる": "فَخّ, مِصْيَدَة / أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة.",
 "落とし前": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "落とし卵": "بَيْض مَسْلُوق بِدُونَ قِشْر (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من…)\nمثال: ياني يحب البيض.",
 "落とし子": "مُنْتَج",
 "落とし所": "أَرْضِيَّة مُشْتَرَكَة (أساس يتفق عليه جميع الأطراف للوصول إلى تفاهم متبادل)",
 "落とし格子": "بوابة منزلقة (بوابة تتكون من شبكة حديدية أو خشبية تتدلى في مدخل قلعة أو مدينة محصنة؛ يمكن…)",
 "落とし穴": "حفرة, فخ (فخ على شكل حفرة مخفية)",
 "落とし紙": "وَرَق مِرْحَاض, وَرَق حَمَّام (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "落とし胤": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "落とし込む": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها)",
 "落とす": "قَطْرَة\nمثال: هذه هي نقطة ضعفه. / نَقَلَ\nمثال: لا أزال عطشانا. / فَقَدَ\nمثال: خسر توم وظيفته. / أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل))\nمثال: سامي من طبقة أدنى.",
 "落る": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب. / وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى / خَرَجَ (اِنْتَقَلَ إلى خارج المكان)\nمثال: خرج سامي ليحتفل.",
 "落下": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "落下傘": "بَرَاشُوت, مِظَلّة هُبُوط",
 "落下傘兵": "مِظَلِّيّ",
 "落下傘部隊": "مظليين (مشاة مدربون ومجهزون للقفز بالمظلات)",
 "落付き": "هُدُوء / اِسْتِقْرَار",
 "落付ける": "صَامِت, هَادِئ",
 "落伍": "مُتَرَامِي الأَطْرَاف, مُتَنَاثِر (يَمْتَدُّ فِي اتِّجَاهَاتٍ مُخْتَلِفَةٍ أَوْ مُوَزَّعٌ بِشَكْلٍ غَيْرِ مُنْتَظِم) / انشقاق, صدع (انفصال شخصي أو اجتماعي (كما بين الفصائل المتعارضة))\nمثال: كانوا يأملون في تجنب قطيعة في العلاقات",
 "落伍者": "مُتَسَرِّب (شخص يترك المدرسة قبل التخرج)",
 "落口": "عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / فَم, بق / فوهة, مصب (فتحة تسمح بمرور السوائل أو الحبوب)",
 "落合": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "落合う": "لِقَاء مُحَدَّد, مَوْعِد (اجتماع مخطط له في وقت ومكان معينين)\nمثال: كان ينتظرهم في مكان اللقاء / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر.",
 "落命": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "落城": "ترك, هجران (فعل الهجر أو التخلي)",
 "落堕": "تَزَوَّجَ\nمثال: زوجة ماري طبيبة.",
 "落屑": "انسلاخ, تقشر (فقدان أجزاء من الجلد الخارجي عن طريق التقشير أو التساقط)",
 "落差": "رَئِيس, رَئِيسَة / فَرْق, اِخْتِلَاف",
 "落度": "أَسَاء اَلْفَهْم, أَخْطَأَ\nمثال: كان خطأ حاسوبي.",
 "落延びる": "هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "落後": "مُتَرَامِي الأَطْرَاف, مُتَنَاثِر (يَمْتَدُّ فِي اتِّجَاهَاتٍ مُخْتَلِفَةٍ أَوْ مُوَزَّعٌ بِشَكْلٍ غَيْرِ مُنْتَظِم) / انشقاق, صدع (انفصال شخصي أو اجتماعي (كما بين الفصائل المتعارضة))\nمثال: كانوا يأملون في تجنب قطيعة في العلاقات",
 "落後者": "مُتَسَرِّب (شخص يترك المدرسة قبل التخرج)",
 "落想": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة.",
 "落成": "إتمام, إكمال (إجراء ختامي أو نهائي)",
 "落手": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "落掌": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "落書": "خربشة, شخبطة (كتابة يدوية رديئة)",
 "落書き": "خربشة, شخبطة (كتابة يدوية رديئة)",
 "落書き帳": "دفتر رسم",
 "落書帳": "دفتر رسم",
 "落機山": "جِبَال رُوكِي",
 "落武者": "هَارِب",
 "落水": "طاقة مائية, قوة مائية (القدرة على بذل الشغل الكامنة في مسقط مائي) / مُرْهِق, مُنْهِك (له أثر مُوهِن ومُنهِك للقوى)",
 "落沙": "لَاك",
 "落涙": "إدماع, تدميع (ذرف الدموع)",
 "落潮": "انحسار الماء, جزر (أدنى (أبعد) انحسار للمد)",
 "落盤": "انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته)",
 "落着": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "落着き": "هُدُوء / اِسْتِقْرَار",
 "落着く": "أَهْدَأَ, هَدَّأَ / هَدَأَ\nمثال: استقر زيري في خيمته. / مُبَارَاة",
 "落着ける": "صَامِت, هَادِئ",
 "落第": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة…)\nمثال: فشل ياني مجددا.",
 "落羽松": "سرو المستنقعات (خشب صنوبر متساقط الأوراق من جنس التاكسوديوم، موطنه أمريكا الشمالية)",
 "落胆": "تثبيط (فعل التثبيط أو الإحباط)\nمثال: تثبيط السرقة الصغيرة",
 "落脱": "فِرَار, هَجْر / إِغْفَال / تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة)\nمثال: دخل الفريق في حالة ركود",
 "落花枝に帰らず破鏡再び照らさず": "مَا حَدَثَ قَد حَدَثَ, مَا فَاتَ قَدْ مَاتْ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "落花生": "فُولٌ سُودَانِيٌّ, فُسْتُقُ العَبِيد",
 "落花生油": "زيت الفول السوداني (زيت مستخرج من الفول السوداني؛ يُستخدم في الطهي وصنع الصابون)",
 "落莫": "مُقْفِر, مَهْجُور",
 "落葉": "إسقاط الورق, تعرية الأشجار (التسبب في تساقط أوراق الأشجار والنباتات الأخرى (عن طريق استخدام مواد كيميائية…) / نَفَضِي, نَفَضِية",
 "落葉剤": "مزيل الأوراق, مسقط الأوراق (مادة كيميائية تُرش على النباتات وتتسبب في تساقط أوراقها)",
 "落葉性": "نَفَضِي, نَفَضِية",
 "落葉松": "شجرة اللاريكس, لاريكس (أي من الصنوبريات العديدة من جنس لاريكس، جميعها ذات أوراق إبرية متساقطة)",
 "落葉樹林": "غابة نفضية (غابة تتكون بشكل رئيسي من أشجار عريضة الأوراق تسقط جميع أوراقها خلال موسم واحد)",
 "落葉状": "صَفَائِحِيّ, وَرَقِيّ ((خاصة للصخور المتحولة) ذو طبقات رقيقة تشبه الأوراق)",
 "落行く": "هَرَبَ, فَرَّ (الفِرارُ)\nمثال: هرب كأرنب خائف. / هَدَأَ\nمثال: استقر زيري في خيمته.",
 "落込み": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / مُنْخَفَض",
 "落選": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "落雷": "صَاعِقَة",
 "落飾": "حلاقة الترهب, طونسورة (حلاقة قمة الرأس من قبل الكهنة أو أعضاء الرهبنة)",
 "落首": "بَارُودِيَا, مُحَاكَاة سَاخِرَة (تكوين يقلد أو يحرف أسلوب شخص ما، عادة بطريقة فكاهية)",
 "落髪": "حلاقة الترهب, طونسورة (حلاقة قمة الرأس من قبل الكهنة أو أعضاء الرهبنة)",
 "葈耳": "أرقطيون كبير, لزيق (أرقطيون بأوراق على شكل قلب يوجد في الغابات المفتوحة والأسيجة والمراعي الوعرة في…)",
 "葉": "وَرَقَة, وَرَقة",
 "葉っぱ": "وَرَقَة, وَرَقة / مَارِهْوَانَا, حَشِيش",
 "葉むら": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "葉ろう石": "بيروفيليت (معدن سيليكات ألمنيوم أبيض أو مخضر (يشبه التلك))",
 "葉レタス": "خس مفكك الأوراق, خس ورقي (خس ذو أوراق مجعدة بشكل فضفاض لا تشكل رأساً مضغوطاً)",
 "葉加瀬": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "葉叢": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "葉壁蝨": "سوس عنكبوتي (سوس غازل للشبك يهاجم نباتات الحدائق وأشجار الفاكهة)",
 "葉室": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "葉層": "صفيحة رقيقة (صفيحة رقيقة أو طبقة (خاصة من العظم أو المعدن))",
 "葉巻": "سِيجَار, سِيكَار",
 "葉巻き": "سِيجَار, سِيكَار",
 "葉巻きたばこ": "سِيجَار, سِيكَار",
 "葉巻きタバコ": "سِيجَار, سِيكَار",
 "葉巻タバコ": "سِيجَار, سِيكَار",
 "葉形": "شكل الورقة (أي من الأشكال المتنوعة التي يمكن أن تتخذها أوراق النباتات)",
 "葉書": "كَرْت بَرِيدِيّ / مذكرة, مذكرة داخلية (اقتراح أو تذكير مكتوب)",
 "葉書き": "كَرْت بَرِيدِيّ / مذكرة, مذكرة داخلية (اقتراح أو تذكير مكتوب)",
 "葉柄": "سويقة الورقة, معلاق (الساق النحيلة التي تدعم نصل الورقة)",
 "葉桜": "شجرة الكرز, كرز (أي من العديد من الأشجار والشجيرات التي تنتج فاكهة مستديرة لحمية صغيرة بنواة…)",
 "葉焼け": "احتراق الأوراق, لفحة الأوراق (مرض نباتي يسبب مظهرًا محترقًا أو ملفوحاً للأوراق)",
 "葉片": "صفيحة رقيقة (صفيحة رقيقة أو طبقة (خاصة من العظم أو المعدن))",
 "葉状": "شَبِيه بِالوَرَقَة (يُشبه الورقة في شكله)",
 "葉状体": "ثالوس, مشرة (جسم نباتي بدون سيقان أو جذور أو أوراق حقيقية أو نظام وعائي؛ مميز للنباتات…)",
 "葉状植物": "نبات ثالوسي, نبات مشيجي (أي من مجموعة الكائنات اللازهرية التي تتكون أساساً من مشرة (ثالس) وبالتالي لا…)",
 "葉状茎": "ساق ورقية (ساق مسطحة تشبه ورقة الشجر وتعمل عملها)",
 "葉理": "صفيحة رقيقة (صفيحة رقيقة أو طبقة (خاصة من العظم أو المعدن))",
 "葉緑体": "بلاستيدة خضراء, صانعة خضراء (بلاستيد يحتوي على اليخضور وأصباغ أخرى؛ في النباتات التي تقوم بعملية التمثيل…)",
 "葉緑素": "كلوروفيل, يخضور (أي مجموعة من الأصباغ الخضراء الموجودة في الكائنات التي تقوم بالتمثيل الضوئي)",
 "葉群": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "葉胃": "أُمّ التَلَافِيف (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "葉芹草": "عنق الكمان (نبات حولي زغبي من كاليفورنيا إلى المكسيك بنوارات مزدحمة من الزهور الصغيرة…)",
 "葉芽": "برعم ورقي (برعم تتطور منه الأوراق (ولكن ليس الزهور))",
 "葉茎菜類": "خضراوات ورقية (أي من النباتات الورقية المختلفة أو أوراقها وسيقانها التي تؤكل كخضروات)",
 "葉菜類": "خضراوات ورقية (أي من النباتات الورقية المختلفة أو أوراقها وسيقانها التي تؤكل كخضروات)",
 "葉蘭": "حديد الزهر, حديد مسبوك (سبيكة من الحديد تحتوي على نسبة عالية من الكربون بحيث تكون هشة ولا يمكن طرقها بل…)",
 "葉虫": "خنفساء الأوراق (خنفساء زاهية الألوان تتغذى على أوراق النباتات؛ وتغزو يرقاتها الجذور والسيقان)",
 "葉蜂": "دبور المنشار, ذبابة المنشار (حشرة تمتلك أنثاها آلة وضع بيض تشبه المنشار لإدخال البيض في أنسجة أوراق أو سيقان…)",
 "葉蝋石": "بيروفيليت (معدن سيليكات ألمنيوم أبيض أو مخضر (يشبه التلك))",
 "葉身": "صفيحة رقيقة (صفيحة رقيقة أو طبقة (خاصة من العظم أو المعدن)) / شَبِيه بِالوَرَقَة (يُشبه الورقة في شكله)",
 "葉軸": "عمود شوكي, عمود فقري (سلسلة الفقرات التي تشكل محور الهيكل العظمي وتحمي الحبل الشوكي)\nمثال: تسبب السقوط في كسر ظهره",
 "葉酸": "حمض الفوليك, فولات (فيتامين ب ضروري لنمو الخلايا والتكاثر)",
 "葉野菜": "خضراوات ورقية (أي من النباتات الورقية المختلفة أو أوراقها وسيقانها التي تؤكل كخضروات)",
 "葉隠": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "葉鞘": "مَهْبَل",
 "葉鶏頭": "سجاد, كوليوس",
 "葎": "دابة الشجر, متسلق (أي من الطيور الصغيرة المتنوعة آكلة الحشرات في نصف الكرة الشمالي التي تتسلق جذوع…)",
 "著": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل. / بِجَانِب, جنب (بجانب)\nمثال: زيري بجانب الحوض. / صَفَاء, نَقَاء (صفة الماء الصافي)\nمثال: عندما استيقظت عاد الصفاء إلى عينيها",
 "著しい": "لافِتٌ لِلنَّظَرِ, لافِتَةٌ لِلنَّظَرِ",
 "著しく": "إلى حد كبير, بشكل جوهري (إلى مدى أو درجة كبيرة)\nمثال: أخشى أن الفيلم تجاوز الميزانية بكثير",
 "著す": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "著する": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر. / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "著わす": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "著作": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما)\nمثال: تعبت من الكتابة.",
 "著作家": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد…)\nمثال: لست بذاك الكاتب.",
 "著作権": "حُقُوقُ النَّشْر, حُقُوقُ التَّأْلِيفِ وَٱلنَّشْر (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حق)\nمثال: الحقوق إنسانية.",
 "著作権使用料": "مَلَكِيَّة",
 "著作権侵害": "انتهاك حقوق النشر, تعدي على حق المؤلف (انتهاك الحقوق التي يكفلها حق المؤلف)",
 "著作権侵害訴訟": "انتهاك حقوق النشر, تعدي على حق المؤلف (انتهاك الحقوق التي يكفلها حق المؤلف)",
 "著作物": "أعمال, أفعال (أداء الأعمال الأخلاقية أو الدينية)\nمثال: الخلاص بالأعمال",
 "著作者": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد…)\nمثال: لست بذاك الكاتب.",
 "著作集": "مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "著名": "مَشْهُور, شَهِير (معروف على نطاق واسع؛ اسم مفعول للفعل \"شَهَرَ\")\nمثال: إنه رسام مشهور.",
 "著名人": "نَجْم, نَجْمَة (طَلَعَ وظَهَرَ؛ نَجَمَ عن الأمر: أي ظهر نَتِيجَة عنه أو نَتَجَ عنه)\nمثال: سميت السفينة \"النجم الفضي\".",
 "著明": "صَفَاء, نَقَاء (صفة الماء الصافي)\nمثال: عندما استيقظت عاد الصفاء إلى عينيها",
 "著書": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "著者": "مُؤَلِّف, مُصَنِّف\nمثال: ألف شكر على لطفك.",
 "著莪": "سوسن دموي",
 "著述": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما)\nمثال: تعبت من الكتابة.",
 "著述家": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد…)\nمثال: لست بذاك الكاتب.",
 "葛": "كودزو (كرمة سريعة النمو من شرق آسيا لها جذور نشوية درنية وأوراق ثلاثية مشعرة وعناقيد…) / دابة الشجر, متسلق (أي من الطيور الصغيرة المتنوعة آكلة الحشرات في نصف الكرة الشمالي التي تتسلق جذوع…)",
 "葛折": "تدوير, ملء (عملية التدوير أو اللف)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "葛折り": "تدوير, ملء (عملية التدوير أو اللف)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "葛縷子": "كَرَاوِيَا, كَرَوْيَاء",
 "葛芋": "فاصوليا اليام, هيكاما (نبات ملتف من أمريكا الوسطى بجذور وقرون صالحة للأكل؛ تؤكل الدرنات الكبيرة نيئة…)",
 "葛藤": "صِرَاع, نِزَاع\nمثال: 父と私の葛藤に、彼は気付いていないようです。 — لا يبدو على علم بسوء التفاهم الذي بيني وبين أبي.",
 "葛西": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "葛鬱金": "أكيرا, كنا هندية (كنا تزرع خاصة لجذمورها الصالح للأكل الذي يتم الحصول منه على نشا الأروروت)",
 "葡": "الْبُرْتُغَال, البرتغال (دولة في جنوب غرب أوروبا، تقع في الجزء الغربي من شبه الجزيرة الأيبيرية؛ اسمها…)\nمثال: أنا من البرتغال.",
 "葡国": "الْبُرْتُغَال, البرتغال (دولة في جنوب غرب أوروبا، تقع في الجزء الغربي من شبه الجزيرة الأيبيرية؛ اسمها…)",
 "葡萄": "عِنَب",
