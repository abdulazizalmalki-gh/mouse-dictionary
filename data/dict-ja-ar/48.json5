 "電気布団": "وسادة تدفئة (سخان يتكون من عناصر تسخين كهربائية موجودة في وسادة مرنة)",
 "電気式": "كهربائي (متعلق بالكهرباء (كعلم أو مجال)) / كهربائي, كهربي (يستخدم الكهرباء أو يوفرها أو ينتجها أو ينقلها أو يعمل بها)\nمثال: مهندس كهربائي",
 "電気技師": "مهندس كهربائي (شخص مدرب على التطبيقات العملية لنظرية الكهرباء)",
 "電気技術者": "مهندس كهربائي (شخص مدرب على التطبيقات العملية لنظرية الكهرباء)",
 "電気抵抗": "مُقَاوَمَة",
 "電気抵抗計": "أوممتر, مقياس الأوم (مقياس لقياس المقاومة الكهربائية بالأوم)",
 "電気時計": "ساعة كهربائية (ساعة تستخدم محركاً كهربائيًا صغيراً)",
 "電気椅子": "كُرْسِيّ كَهْرَبَائِيّ (مَقْعَد لواحد؛ العِلْم. يقال هو من أهل الكُرسِيّ أي أهل العِلم)\nمثال: أحب ذاك الكرسي.",
 "電気機関車": "قاطرة كهربائية (قاطرة تعمل بمحرك كهربائي)",
 "電気毛布": "بطانية كهربائية (بطانية تحتوي على عنصر تسخين كهربائي يمكن التحكم فيه للوصول لدرجة الحرارة المطلوبة)",
 "電気水母": "رجل الحرب البرتغالي (سحاري كبير له عوامة تشبه المثانة ومجسات لاسعة)",
 "電気治療": "علاج كهربائي (التطبيق العلاجي للكهرباء على الجسم (كما في علاج أشكال مختلفة من الشلل))",
 "電気泳動": "رحلان كهربائي (حركة الجسيمات المشحونة في مادة غروانية تحت تأثير مجال كهربائي؛ حيث تتجه الجسيمات ذات الشحنة الموجبة إلى الكاثود والسالبة إلى الأنود)",
 "電気泳動法": "رحلان كهربائي (حركة الجسيمات المشحونة في مادة غروانية تحت تأثير مجال كهربائي؛ حيث تتجه الجسيمات ذات الشحنة الموجبة إلى الكاثود والسالبة إلى الأنود)",
 "電気炉": "فرن كهربائي (أي فرن يتم توفير الحرارة فيه بواسطة تيار كهربائي)",
 "電気焜炉": "مدفأة كهربائية (سخان مساحة كهربائي صغير)",
 "電気痙攣療法": "علاج بالصدمات الكهربائية (إعطاء تيار كهربائي قوي يمر عبر الدماغ للحث على التشنجات والغيبوبة)",
 "電気療法": "علاج كهربائي (التطبيق العلاجي للكهرباء على الجسم (كما في علاج أشكال مختلفة من الشلل))",
 "電気的筋肉刺激": "إِم",
 "電気盆": "إلكتروفور, حامل الكهرباء (مولد كهروستاتيكي بسيط يولد شحنات متكررة من الكهرباء الساكنة)",
 "電気石": "تورمالين (معدن معقد من البوروسيليكات وهيدروكسيد الألمنيوم يحتوي على الحديد والمغنيسيوم والكالسيوم والليثيوم والصوديوم؛ يوجد عادة باللون الأسود ولكن يوجد في…)",
 "電気磁気学": "كهرومغناطيسية",
 "電気系統": "نظام كهربائي (معدات في مركبة بمحرك توفر الكهرباء لتشغيل المحرك وإشعال الوقود وتشغيل الأضواء ومساحات الزجاج الأمامي والسخان ومكيف الهواء والراديو) / نظام كهربائي (مرفق يوفر الكهرباء)",
 "電気自動車": "سَيَّارَة كَهْرَبَائِيَّة (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "電気蓄音機": "غْرَامَافُون, فُونُوغْرَاف",
 "電気装置": "جهاز كهربائي (جهاز ينتج الكهرباء أو يعمل بها)",
 "電気解離": "تأين (عملية التأين؛ تكوين الأيونات عن طريق فصل الذرات أو الجزيئات أو الجذور أو عن طريق إضافة أو طرح الإلكترونات من الذرات بواسطة مجالات كهربائية قوية في غاز) / تأين (حالة التفكك إلى أيونات (كما يحدث بالحرارة أو الإشعاع أو التفاعل الكيميائي أو التفريغ الكهربائي))\nمثال: تأين الغاز",
 "電気通信": "اتصالات سلكية ولاسلكية (فرع الهندسة الكهربائية المعني بتكنولوجيا الاتصالات الإلكترونية عن بعد) / اتصالات, اتصالات عن بعد ((غالباً بصيغة الجمع) الأنظمة المستخدمة في نقل الرسائل عبر مسافات إلكترونياً)",
 "電気量": "شِحْنَة كَهْرَبَائِيَّة",
 "電気除細動器": "مُزِيلُ رَجَفَان",
 "電気陰性度": "سلبية كهربائية ((كيمياء) ميل الذرة أو الجذر لجذب الإلكترونات في تكوين رابطة أيونية)",
 "電気鯰": "رعاد, سلور كهربائي (سلور مياه عذبة في النيل ووسط أفريقيا الاستوائية يمتلك عضواً كهربائياً)",
 "電気鰻": "أنقليس رعاد, أنقليس كهربائي (سمكة مياه عذبة تشبه الثعبان تعيش في أمريكا الجنوبية ولها أعضاء كهربائية في جسمها)",
 "電池": "ضَرْب, اِعْتِدَاء (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "電池式": "يَعْمَل بِالبَطَّارِيَّة (يُشغَّل بواسطة بطارية كهربائية واحدة أو أكثر)",
 "電池式計算器": "يَعْمَل بِالبَطَّارِيَّة (يُشغَّل بواسطة بطارية كهربائية واحدة أو أكثر)",
 "電波": "مَوْجَة رَادْيُو",
 "電波天文学": "علم الفلك الراديوي (فرع علم الفلك الذي يكتشف ويدرس موجات الراديو المنبعثة من الأجرام السماوية)",
 "電波妨害": "تشويش, تشويش إلكتروني (إشعاع أو عكس متعمد للطاقة الكهرومغناطيسية لغرض تعطيل استخدام العدو للأجهزة أو الأنظمة الإلكترونية)",
 "電波探信儀": "رَادَار",
 "電波探知": "رادار (أداة قياس يستخدم فيها صدى نبضة من إشعاع الميكروويف للكشف عن الأجسام البعيدة وتحديد موقعها)",
 "電波探知器": "رَادَار",
 "電波探知機": "رَادَار",
 "電波望遠鏡": "مِقْرَاب رَادْيُوي, مِقْرَاب الكَاشُوفِي",
 "電波源": "مَصْدَر رَادْيَوِيّ (جسم يشع موجات راديوية)",
 "電流": "تَيَّار كَهْرَبَائِيّ / تَيَّار كَهْرُبَائِيّ",
 "電流計": "أُمِيتْر",
 "電源": "استطاعة كهربائية, قدرة كهربائية (حاصل ضرب الجهد في التيار) / قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة, طَاقَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / طَاقَة كَهْرَبَائِيَّة, طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: توم شعر بالقوة.",
 "電源ケーブル": "خط كهرباء, كابل طاقة (كابل يستخدم لتوزيع الكهرباء)",
 "電源コンセント": "مأخذ كهربائي, مِقبس جداري (مقبس يوفر مكاناً في نظام الأسلاك يمكن منه أخذ التيار لتشغيل الأجهزة الكهربائية)",
 "電源コード": "سلك الطاقة (سلك لتوصيل الطاقة لجهاز كهربائي)",
 "電源ユニット": "وحدة طاقة (وحدة توفر الطاقة لتشغيل وحدات أخرى)",
 "電源供給": "وحدة تزويد الطاقة / تغذية طاقة (تَغْذِيَةُ الجِسْمِ: تَزْوِيدُهُ بِـالغِذَاءِ؛ في ركيزة أساسية للحياة، فهي تشمل جميع العمليات التي يُحصل من خلالها الكائن الحي على احتياجاته الغذائية. تُساهم هذه الاحتياجات في تشغيل الوظائف…)\nمثال: لن نستمر في تغذية الانتقامات.",
 "電源喪失": "انقطاع التيار الكهربائي, انقطاع الكهرباء (فشل المعدات الناتج عند انقطاع مصدر الطاقة)\nمثال: تسببت العاصفة الثلجية في انقطاع التيار الكهربائي",
 "電源回路": "وحدة تزويد الطاقة / تغذية طاقة (تَغْذِيَةُ الجِسْمِ: تَزْوِيدُهُ بِـالغِذَاءِ؛ في ركيزة أساسية للحياة، فهي تشمل جميع العمليات التي يُحصل من خلالها الكائن الحي على احتياجاته الغذائية. تُساهم هذه الاحتياجات في تشغيل الوظائف…)\nمثال: لن نستمر في تغذية الانتقامات.",
 "電源異常": "انقطاع التيار الكهربائي, انقطاع الكهرباء (فشل المعدات الناتج عند انقطاع مصدر الطاقة)\nمثال: تسببت العاصفة الثلجية في انقطاع التيار الكهربائي",
 "電源装置": "وحدة تزويد الطاقة / تغذية طاقة (تَغْذِيَةُ الجِسْمِ: تَزْوِيدُهُ بِـالغِذَاءِ؛ في ركيزة أساسية للحياة، فهي تشمل جميع العمليات التي يُحصل من خلالها الكائن الحي على احتياجاته الغذائية. تُساهم هذه الاحتياجات في تشغيل الوظائف…)\nمثال: لن نستمر في تغذية الانتقامات.",
 "電灯": "لمبة, مصباح كهربائي (مصباح كهربائي يتكون من غلاف زجاجي شفاف أو نصف شفاف يحتوي على فتيل سلكي (عادة من التنجستن) يبعث الضوء عند تسخينه بالكهرباء)",
 "電炉": "فرن كهربائي (أي فرن يتم توفير الحرارة فيه بواسطة تيار كهربائي)",
 "電熱線": "عنصر تسخين (مكون في سخان أو موقد يحول الوقود أو الكهرباء إلى حرارة)",
 "電燈": "لمبة, مصباح كهربائي (مصباح كهربائي يتكون من غلاف زجاجي شفاف أو نصف شفاف يحتوي على فتيل سلكي (عادة من التنجستن) يبعث الضوء عند تسخينه بالكهرباء)",
 "電球": "لَمْبَة, مِصْبَاح",
 "電界": "حقل كهربائي (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "電界効果トランジスタ": "ترانزستور تأثير المجال, فيت (ترانزستور يتدفق فيه معظم التيار في قناة يمكن التحكم في مقاومتها الفعالة بواسطة مجال كهربائي مستعرض)",
 "電界効果トランジスター": "ترانزستور تأثير المجال, فيت (ترانزستور يتدفق فيه معظم التيار في قناة يمكن التحكم في مقاومتها الفعالة بواسطة مجال كهربائي مستعرض)",
 "電界放出": "انبعاث مجالي (انبعاث الإلكترونات التي تنتزع من الذرات الأم بواسطة مجال كهربائي عالٍ)",
 "電番": "رَقْم هَاتِف, رَقْم تِلِفُون (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: سجلت رقم هاتفه.",
 "電着": "ترسيب كهربائي (ترسيب مادة على قطب كهربائي بفعل الكهرباء (خاصة عن طريق التحليل الكهربائي))",
 "電磁": "كَهْرُومِغْنَاطِيسِيّ",
 "電磁スペクトル": "طَيْف كَهْرُومَغْنَاطِيسِيّ",
 "電磁単位": "وحدة كهرومغناطيسية (أي من أنظمة الوحدات المختلفة لقياس الكهرباء والمغناطيسية)",
 "電磁放射線": "إشعاع كهرومغناطيسي, موجة كهرومغناطيسية (إشعاع يتكون من موجات من الطاقة مرتبطة بمجالات كهربائية ومغناطيسية ناتجة عن تسارع شحنة كهربائية)",
 "電磁気": "كهرومغناطيسية",
 "電磁気学": "كهرومغناطيسية",
 "電磁波": "إشعاع كهرومغناطيسي, موجة كهرومغناطيسية (إشعاع يتكون من موجات من الطاقة مرتبطة بمجالات كهربائية ومغناطيسية ناتجة عن تسارع شحنة كهربائية)",
 "電磁流体力学": "ديناميكا الموائع المغناطيسية (دراسة تفاعل المجالات المغناطيسية والموائع الموصلة للكهرباء (مثل البلازما أو المعدن المنصهر))",
 "電磁的": "كَهْرُومِغْنَاطِيسِيّ",
 "電磁相互作用": "تفاعل كهرومغناطيسي (تفاعل بين الجسيمات الأولية المشحونة يكون متوسطاً في القوة بين التفاعلات القوية والضعيفة؛ يتوسطه فوتونات)",
 "電磁石": "مغناطيس كهربائي (مغناطيس مؤقت مصنوع عن طريق لف سلك حول قلب حديدي؛ عندما يتدفق التيار في الملف يصبح الحديد مغناطيساً)",
 "電算": "حَاسُوب, حَاسِب (آلة ألِكْتُرُونِيَّة تقوم بعمليات حِسَابِيَّة سريعة بواسطتها يمكن للآلة القيام بمهمات مختلفة على البَيَانَات والمَعْلُومَات)\nمثال: أستخدم الحاسوب.",
 "電算化": "حوسبة (التحكم في العمليات بواسطة الحاسوب)",
 "電算機": "حاسوب, كمبيوتر (آلة لإجراء الحسابات تلقائياً)",
 "電網": "إِنْتَرْنَت, شُبَّاكَة (شبكة المعلومات العالمية)\nمثال: كان ياني على الإنترنت.",
 "電線": "خط كهرباء, كابل طاقة (كابل يستخدم لتوزيع الكهرباء) / خَطّ هَاتِفِيّ, خَطّ تِلِفُونِيّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "電纜": "كَابْل",
 "電脳": "حَاسُوب, حَاسِب (آلة ألِكْتُرُونِيَّة تقوم بعمليات حِسَابِيَّة سريعة بواسطتها يمكن للآلة القيام بمهمات مختلفة على البَيَانَات والمَعْلُومَات)\nمثال: أستخدم الحاسوب.",
 "電脳空間": "إنترنت, شبكة المعلومات الدولية (شبكة المعلومات العالمية)\nمثال: كان ياني على الإنترنت.",
 "電荷": "شِحْنَة كَهْرَبَائِيَّة",
 "電装": "تجربة الملابس, قياس (ارتداء الملابس لمعرفة ما إذا كانت مناسبة) / لَائِق, مُنَاسِب (مطابق تماماً وصحيح) / مَعْقُول, مُلَائِم (يتناغم مع روح الأشخاص أو المناسبة المعنيّة) / تجهيزات, مستلزمات ((عادة بصيغة الجمع) المفروشات والمعدات (خاصة لسفينة أو فندق))",
 "電視": "تِلْفَاز, تِلِفِزْيُون (جِهَاز اتصالات لبَثّ واِسْتِقْبَال صور متحركة وصوت عن بعد يواسطة أَمْوَاج كهرومغناطيسية؛ الجِهَة التي تقوم بإدارة وتكوين وبث البَرَامِج التي تعرض على إحدى القَنَوَات في جهاز التلفاز. غالبا ما يستعاض عنها باستخدام كلمة تلفزيون)\nمثال: لنشاهد التلفاز.",
 "電視台": "مَحَطَّة تِلِفِزْيُون",
 "電解": "تحليل كهربائي لإزالة الشعر (إزالة الشعر الزائد أو غير المرغوب فيه عن طريق تمرير تيار كهربائي عبر جذر الشعرة) / تحليل كهربائي ((في الكيمياء) تفاعل تحلل كيميائي ينتج عن تمرير تيار كهربائي عبر محلول يحتوي على أيونات)",
 "電解コンデンサー": "مكثف إلكتروليتي, مكثف كيميائي (مكثف ثابت يتكون من قطبين يفصل بينهما إلكتروليت)",
 "電解槽": "خلية تحليل كهربائي (خلية تحتوي على إلكتروليت يتسبب الجهد المطبق فيه بحدوث تفاعل لا يحدث لولاه (مثل تحلل الماء إلى هيدروجين وأكسجين))",
 "電解質": "إلكتروليت, كهرل (محلول يوصل الكهرباء)\nمثال: الكمية والتوزيع المناسب للإلكتروليتات في الجسم ضروري للصحة",
 "電話": "مُكَالَمَة / مُكَالَمَة هَاتِفِيَّة, مُحَادَثَة تِلِفُونِيَّة / هَاتِف, تِلِفون (جهاز يستخدم للتحدث؛ الصوت يسمع دون أن يرى صاحبه) / تَلْفَنَ / هَاتَفَ (جهاز يستخدم للتحدث؛ الصوت يسمع دون أن يرى صاحبه)\nمثال: رن الهاتف تكرارا.",
 "電話をかける": "هَاتِف, تِلِفون (جهاز يستخدم للتحدث؛ الصوت يسمع دون أن يرى صاحبه) / تَلْفَنَ / هَاتَفَ (جهاز يستخدم للتحدث؛ الصوت يسمع دون أن يرى صاحبه)\nمثال: رن الهاتف تكرارا.",
 "電話をきる": "عَلَّقَ / أَغْلَقَ الْخَطّ (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح)\nمثال: أغلق الباب بغضب",
 "電話を切る": "عَلَّقَ / أَغْلَقَ الْخَطّ (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح)\nمثال: أغلق الباب بغضب",
 "電話を掛ける": "هَاتِف, تِلِفون (جهاز يستخدم للتحدث؛ الصوت يسمع دون أن يرى صاحبه) / تَلْفَنَ / هَاتَفَ (جهاز يستخدم للتحدث؛ الصوت يسمع دون أن يرى صاحبه)\nمثال: رن الهاتف تكرارا.",
 "電話インタビュー": "مقابلة هاتفية (مقابلة تجرى عبر الهاتف)",
 "電話ボックス": "كَابِينَةُ هَاتِف, كُشْك هَاتِف",
 "電話ワイヤ": "خط الهاتف, سلك الهاتف (السلك الذي يحمل إشارات التلغراف والهاتف)",
 "電話交換局": "سنترال, مقسم هاتف (مكان عمل يعمل كمنشأة اتصالات حيث يمكن توصيل الخطوط من الهواتف معًا للسماح بالاتصال)",
 "電話交換手": "عامل هاتف, مأمور مقسم (شخص يساعد المتصلين في الوصول إلى الشخص الذي يتصلون به)",
 "電話代": "فاتورة الهاتف (بيان بتكاليف خدمة الهاتف)",
 "電話会社": "شركة اتصالات, شركة هاتف (مرفق عام يوفر خدمة الهاتف)",
 "電話会議": "مكالمة جماعية, مكالمة مؤتمرية (مكالمة هاتفية يشارك فيها أكثر من شخصين)",
 "電話口": "سماعة الهاتف (سماعة أذن تحول الإشارات الكهربائية إلى أصوات)",
 "電話回線": "خَطّ هَاتِفِيّ, خَطّ تِلِفُونِيّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "電話室": "كَابِينَةُ هَاتِف, كُشْك هَاتِف",
 "電話局": "شركة اتصالات, شركة هاتف (مرفق عام يوفر خدمة الهاتف)",
 "電話帳": "دَلِيل هَاتِف, دَلِيلُ الهَاتِف",
 "電話機": "هَاتِف, تِلِفون (جهاز يستخدم للتحدث؛ الصوت يسمع دون أن يرى صاحبه) / تَلْفَنَ / هَاتَفَ (جهاز يستخدم للتحدث؛ الصوت يسمع دون أن يرى صاحبه)\nمثال: رن الهاتف تكرارا.",
 "電話注文": "طلب عبر الهاتف (استلام الطلبات عبر الهاتف)",
 "電話番号": "رَقْم هَاتِف, رَقْم تِلِفُون (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: سجلت رقم هاتفه.",
 "電話盗聴": "تنصت, تنصت هاتفي (فعل التنصت على خط هاتف أو تلغراف للحصول على المعلومات)",
 "電話線": "خَطّ هَاتِفِيّ, خَطّ تِلِفُونِيّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "電話通信": "مهاتفة, هاتف (نقل الكلام عن بعد)",
 "電話電報": "رمز صوتي, فونوغرام (أي رمز مكتوب يمثل صوتاً أو مقطعاً لفظياً أو مورفيماً أو كلمة)",
 "電路": "دائرة كهربائية (جهاز كهربائي يوفر مساراً لتدفق التيار الكهربائي)",
 "電車": "ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل.",
 "電車代": "أجرة القطار, تذكرة قطار (الأجرة المفروضة للسفر بالقطار)",
 "電車区": "محطة سكة حديد, محطة قطار (محطة طرفية حيث تقوم القطارات بتحميل أو تفريغ الركاب أو البضائع)",
 "電車賃": "أجرة القطار, تذكرة قطار (الأجرة المفروضة للسفر بالقطار)",
 "電車道": "خط سكة حديد, سكة حديدية (خط من القضبان يوفر مساراً لعجلات القطار)\nمثال: مشى بمحاذاة السكة الحديدية",
 "電郵": "إيميل, بريد إلكتروني ((علوم الكمبيوتر) نظام للاتصال الإلكتروني العالمي حيث يمكن لمستخدم الكمبيوتر إنشاء رسالة في محطة طرفية واحدة يمكن إعادة إنشائها في محطة المستلم عند…)\nمثال: لا يمكنك إرسال طرود بالبريد الإلكتروني",
 "電鈴": "جرس كهربائي (جرس يتم تفعيله بواسطة التأثير المغناطيسي لتيار كهربائي)",
 "電鍵": "مفتاح التلغراف (مفتاح يتكون من رافعة ترسل إشارة تلغراف عند الضغط عليها وإغلاق الدائرة)",
 "電離": "تأين (عملية التأين؛ تكوين الأيونات عن طريق فصل الذرات أو الجزيئات أو الجذور أو عن طريق إضافة أو طرح الإلكترونات من الذرات بواسطة مجالات كهربائية قوية في غاز) / تأين (حالة التفكك إلى أيونات (كما يحدث بالحرارة أو الإشعاع أو التفاعل الكيميائي أو التفريغ الكهربائي))\nمثال: تأين الغاز",
 "電離圏": "أَيْونْوسْفِير",
 "電離層": "أَيْونْوسْفِير",
 "電離放射線": "الإشعاعات المؤينة",
 "電離箱": "غرفة التأين (أداة قياس تقيس كمية الإشعاع المؤين)",
 "電顕": "مجهر إلكتروني (مجهر يشبه في الغرض المجهر الضوئي ولكنه يحقق قوة تحليل أكبر بكثير باستخدام شعاع متواز من الإلكترونات لإضاءة الجسم بدلاً من شعاع الضوء)",
 "電飾": "إِضَاءَة",
 "電髪": "بِيرْم",
 "需品": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تَوْرِيد, تَزْوِيد / ذَخِيرَة / ضابط التموين, مسؤول الإمداد والتموين (ضابط جيش يوفر الملابس والإعاشة للقوات)",
 "需用": "اِسْتِهْلَاك",
 "需用費": "اسْتِهْلَاكِيّ, قَابِل لِلاسْتِهْلَاك (يمكن أن يُسْتَهْلَك أو يُسْتَنْفَد)",
 "需給": "الْعَرْض وَالْطَلَب",
 "需要": "طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / مُطَّلِب / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "需要と供給": "الْعَرْض وَالْطَلَب",
 "需要供給": "الْعَرْض وَالْطَلَب",
 "需要家": "مُسْتَهْلِك / مُسْتَنْفِد",
 "需要曲線": "منحنى الطلب (في الاقتصاد، الرسم البياني الذي يصور العلاقة بين سعر سلعة معينة والكمية التي يرغب المستهلكون ويقدرون على شرائها بذلك السعر)",
 "需要独占": "احتكار الشراء ((اقتصاد) سوق يتم فيه عرض السلع أو الخدمات من قبل عدة بائعين ولكن يوجد مشترٍ واحد فقط)",
