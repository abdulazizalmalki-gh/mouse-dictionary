 "震い": "رج, هز (عملية التسبب في تحرك شيء ما صعوداً وهبوطاً (أو ذهاباً وإياباً) بحركات سريعة) / ارتعاش, اهتزاز (حركة مهتزة)\nمثال: ارتعاش أصابعه وهو يشعل غليونه",
 "震いつく": "اِحْتِضَان, حَضْن / عَانَقَ, اِحْتَضَنَ",
 "震い付く": "اِحْتِضَان, حَضْن / عَانَقَ, اِحْتَضَنَ",
 "震う": "اِرْتَجَفَ, اِقْشَعَّرَ",
 "震え": "مُرْتَجِف, مُرْتَعِش (يهتز بشكل طفيف وغير منتظم كما من الخوف أو البرد) / رجفة, قشعريرة (إحساس بالبرد غالباً ما يشير إلى بداية عدوى وتطور حمى)",
 "震えあがる": "هَزَّ",
 "震える": "اِرْتَجَفَ, اِقْشَعَّرَ",
 "震え上がる": "هَزَّ",
 "震え音": "تَكْرِير",
 "震とう": "صَدْمَة / صَعْقَة / صَعَقَ",
 "震れる": "تَأَرْجَحَ / أُرْجُوحَة, مُرْجِيحَة",
