 "華金": "الْجُمُعَة, الجُمْعَة",
 "華頭窓": "جَرَسِيُّ الشَّكْل, نَاقُوسِيّ (ذو شكل محدّب يشبه الجرس)",
 "華鬘草": "مفرط التعاطف (شخص متعاطف بشكل مفرط مع أولئك الذين يدعون أنهم مستغلون أو محرومون) / القلب النازف, ديسنترا رائعة (نبات حدائق له أزهار متدلية على شكل قلب وردية داكنة)",
 "華麗": "بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين) / بَهِيّ, رَائِع (يتّسم بالعظمة والفخامة) / رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة)",
 "華麗なる": "رَائِع, عَظِيم / عَظِيم, كَبِير (خلاف الصَغِيْر، الكَبِيْر؛ نقيض الحَقِير)\nمثال: الصين بلد عظيم.",
 "菰": "سَائِل / فَقِير",
 "菰被り": "سَائِل / فَقِير",
 "菱": "جوز اليسوعيين, كستناء الماء (نوع من كستناء الماء) / حَسَك ((حَسِكَ) الْمَكَان حسكا: كثر حسكه؛ (حَسِكَ) رَأسه: اشتدت جعودته)",
 "菱マンガン鉱": "رودوكروزيت (معدن يتكون من كربونات المنغنيز؛ مصدر للمنغنيز)",
 "菱亜鉛鉱": "سميثسونيت",
 "菱川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "菱形": "مُعَيِّن",
 "菱形筋": "عضلة معينية (أي من عدة عضلات في الجزء العلوي من الظهر تساعد في تحريك لوح الكتف)",
 "菱田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "菱脳": "دماغ خلفي (الجزء الخلفي من الدماغ بما في ذلك المخيخ وجذع الدماغ)",
 "菱花": "كستناء الماء (درنة بصلية صالحة للأكل لنبات مستنقعات صيني) / كستناء الماء, كستناء الماء الصينية (سعد صيني ينتج درنات صالحة للأكل على شكل بصيلة) / جوز الماء, كستناء الماء (جَوَّز لَهُمْ إِبِلَهم إِذا قَادَهَا بَعِيرًا بَعِيرًا حَتَّى تَجُوزَ)\nمثال: نريد أن نأكل نبات جوز الهند.",
 "菱苦土石": "مغنسيت (معدن أبيض يتكون من كربونات المغنيسيوم؛ مصدر للمغنيسيوم)",
 "菱苦土鉱": "مغنسيت (معدن أبيض يتكون من كربونات المغنيسيوم؛ مصدر للمغنيسيوم)",
 "菱鉄鉱": "نَيْزَك حَدِيدِيّ (حجر نيزكي يتكون أساساً من النيكل والحديد) / سيدريت (خام حديد في شكل كربونات الحديدوز)",
 "菱面体": "موشور معيني (متوازي سطوح يحده ستة أوجه متشابهة (إما معينات أو متوازيات أضلاع))",
 "菲才": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات) / عجز, قصور (عدم قدرة جزء أو عضو على العمل بشكل صحيح)",
 "菴": "صومعة (مسكن الناسك)",
 "菴羅": "مَنْجُو, مَنْجَا",
 "菽": "بقول, قرن (قرن البذور لنبات بقولي (مثل البازلاء أو الفاصولياء أو العدس)) / بقول, قرنية (نبات فول أو بازلاء قائم أو متسلق من الفصيلة البقولية) / بقل, ثمرة قرنية (فاكهة أو بذرة أي من نباتات الفاصوليا أو البازلاء المختلفة تتكون من علبة تنشق على طول كلا الجانبين عند النضج وتكون البذور ملتصقة بجانب واحد من العلبة) / صويا, فول الصويا (أكثر الخضراوات المعروفة احتواءً على البروتين؛ تستخدم ثمرة نبات الصويا في مجموعة متنوعة من الأطعمة وكعلف (خاصة كبديل للبروتين الحيواني)) / صويا, فول الصويا (عشب حولي منتصب كثيف الشعر له أوراق ثلاثية وزهور أرجوانية إلى وردية؛ يزرع على نطاق واسع للغذاء والعلف ولتحسين التربة، وخاصة لبذوره المغذية الغنية…) / فول الصويا (مصدر للزيت؛ يستخدم للعلف وتحسين التربة وكغذاء) / أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية) / كُلْيَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: في أي كلية تدرس؟",
 "萌": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "萌え": "إنبات, تبرعم (العملية التي تنبت بها البذور أو الأبواغ وتبدأ في النمو) / انْبِهَار, سِحْر (القدرة على جذب اهتمام شديد) / افتتان, انبهار (شعور بإعجاب كبير بشيء رائع وغير عادي) / افتتان, انبهار (حالة الاهتمام الشديد بشيء ما (كما في الرهبة أو الإعجاب أو الرعب))\nمثال: سحر الأطفال بحيل سحرية وفتن أخرى",
 "萌えだす": "بُرْعُم",
 "萌える": "نَبْتَة",
 "萌え出す": "بُرْعُم",
 "萌え出る": "نَبْتَة",
 "萌え立つ": "نَبْتَة",
 "萌す": "بُرْعُم",
 "萌む": "بُرْعُم",
 "萌やし": "برعم الفاصولياء, نبتة الفاصولياء (أي من حبوب الفاصولياء المستنبتة المختلفة: خاصة الماش أو العدس أو فول الصويا الصالح للأكل)",
 "萌やす": "نَبْتَة",
 "萌出": "بزوغ السن (ظهور السن عند اختراقه اللثة) / انفجار, دوي (ضجيج عالٍ جداً ومفاجئ) / اندلاع, تفشي (حدوث تلقائي عنيف ومفاجئ (عادة لحالة غير مرغوب فيها)) / ثوران, ثوران بركاني (الحدوث المفاجئ لتفريغ عنيف للبخار والمواد البركانية)\nمثال: اندلاع الأعمال العدائية",
 "萌出す": "بُرْعُم",
 "萌動": "إنبات, تبرعم (العملية التي تنبت بها البذور أو الأبواغ وتبدأ في النمو)",
 "萌芽": "اِنْتَاش / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "萌芽更新": "أجمة, دغل (نمو كثيف للشجيرات)",
 "萌黎": "الْجَمَاهِير, العَامَّةُ",
 "萍": "غَيْرُ مُسْتَقِرّ, هَشّ (لا يوفّر راحة أو طمأنينة) / مَحْفُوفٌ بِالخَطَر, وَخِيم (مليء بالأخطار والمهالك) / مُتَزَعْزِع, هَشّ (غير آمن؛ محفوف بالصعوبات)",
 "萎え": "إضعاف (عملية تقليل قوة شيء ما) / مُضَعِّف, مُوَهِّن (يُخفّف عن طريق إضعاف حدة الألم أو الحزن) / مُضْعِف, مُوهِن (يسبب الوهن والضعف) / إضعاف, وهن (أن يصبح الشيء أضعف) / خَيْبَة أَمَل",
 "萎える": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / صَعَقَ",
 "萎ちょう病": "ذبول (أي مرض نباتي يتميز بالتدلي والذبول؛ عادة ما تسببه طفيليات تهاجم الجذور)",
 "萎びる": "ذبول (التسبب في أن يصبح الشيء مرتخياً أو متدلياً) / ذبول (أي مرض نباتي يتميز بالتدلي والذبول؛ عادة ما تسببه طفيليات تهاجم الجذور)",
 "萎む": "صَعَقَ",
 "萎れる": "صَعَقَ",
 "萎凋": "ذبول (التسبب في أن يصبح الشيء مرتخياً أو متدلياً)",
 "萎凋病": "ذبول (أي مرض نباتي يتميز بالتدلي والذبول؛ عادة ما تسببه طفيليات تهاجم الجذور)",
 "萎縮": "مُبِيد, مُدَمِّر (يَتَسَبَّبُ أَوْ يَقْدِرُ عَلَى التَّدْمِيرِ الكَامِلِ) / سَاحِقٌ, مَاحِقٌ (يستخف بالآخرين ويحقرهم) / ذبول, ضمور (أي ضعف أو تدهور (خاصة بسبب عدم الاستخدام)) / انكماش, تقلص (عملية إنقاص (شيء ما) في الحجم أو الكثافة أو الكمية أو النطاق) / انقباض, تقلص عضلي ((فسيولوجيا) تقصير أو توتر جزء أو عضو (خاصة العضلة أو الألياف العضلية)) / إدغام, اختصار لفظي (كلمة تتكون من كلمتين أو أكثر عن طريق حذف أو دمج بعض الأصوات) / انضغاط, تقلص (عملية أو نتيجة أن يصبح الشيء أصغر أو مضغوطاً معاً)\nمثال: تقلص الغاز عند التبريد",
 "萎縮性": "ضموري (يتعلق بالضمور أو يتميز به)\nمثال: التهاب مفاصل ضموري",
 "萎縮症": "ضُمُور, تَلَاشٍ / ضَمُرَ, تَلَاشَى",
 "萎靡": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "萎黄病": "داء الاخضرار, يرقان شاحب (فقر الدم الناجم عن نقص الحديد لدى الشابات؛ يتميز بالضعف واضطرابات الدورة الشهرية ولون أخضر للجلد)",
 "萩": "برسيم الشجيرة, ليسبيديزا (نباتات شجيرية أو عشبية تستخدم على نطاق واسع للعلف وتحسين التربة وخاصة التبن في جنوب الولايات المتحدة) / أحمر داكن (لون أحمر يعكس القليل من الضوء)",
 "萩原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "萩属": "برسيم الشجيرة, ليسبيديزا (نباتات شجيرية أو عشبية تستخدم على نطاق واسع للعلف وتحسين التربة وخاصة التبن في جنوب الولايات المتحدة)",
 "萩生": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "萩生田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "萩野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "萬": "عَشَرَة آلَاف / لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ) / عَشَرَة آلَاف (العدد الأصلي الذي هو حاصل ضرب عشرة في ألف) / عدد لا يحصى, كثرة كاثرة (عدد كبير غير محدد)\nمثال: واجه عدداً لا يحصى من التفاصيل / كُلّ شَيْء / مُخْتَلِف, مُتَنَوَّع",
 "萬歳": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت) / مِنْ بَابٍ لِبَاب ((عَنِ الرِّحْلَات أَوِ التَّوْصِيلَات) مُبَاشَرَة مِنْ نُقْطَة الأَصْل إِلَى الوِجْهَة)",
 "萱堂": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "萱草": "زنبق النهار (أي من النباتات المعمرة المتعددة ذات جذور درنية وأوراق طويلة ضيقة تشبه النصل وزهور تشبه الزنبق صفراء عادة تتفتح ليوم واحد فقط) / تِبْغ, تَبْغ / تَبْغ, تَبَغ",
 "萱葺き": "سقف معروش, سقف من القش (سقف منزل مصنوع من مادة نباتية (كالقش))",
 "萱葺き屋根": "سقف معروش, سقف من القش (سقف منزل مصنوع من مادة نباتية (كالقش))",
 "萵苣": "خَسّ (خَسَّ الرجُلُ يَخِسُّ خِسَّةً، وخَسَاسَةً: حَقُرَ؛ يقال: خَسَّ فِعْلُهُ وقولُه ورأْيُه)\nمثال: بيع المنزل بثمن بخس.",
 "萼": "كأس الزهرة ((نبات) دوارة السبلات للزهرة التي تشكل الغلاف الخارجي)",
 "萼片": "سَبَلَة, كَأْسِيَّة",
 "落": "اِنْزَلَقَ / أثر, عاقبة (ظاهرة تتبع وتنتج عن ظاهرة سابقة)\nمثال: كان التأثير المغناطيسي أكبر عندما كان القضيب بالطول / نُكْتَة",
 "落し": "سَاقِط, مُتَسَاقِط (يَنْزِلُ بِحُرِّيَّةٍ تَحْتَ تَأْثِيرِ الجَاذِبِيَّة) / تَنْظِيف / فَخّ, مِصْيَدَة / نَتِيجَة",
 "落しだね": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "落し卵": "بَيْض مَسْلُوق بِدُونَ قِشْر (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: ياني يحب البيض.",
 "落し子": "مُنْتَج / سِلْعَة / حَاصِل (الشيء :حصل عليه) / مَحْصُول / حَاصِل ضَرْب (الشيء :حصل عليه) / جَدَاء",
 "落し紙": "وَرَق مِرْحَاض, وَرَق حَمَّام (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "落し胤": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "落し込む": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / طَبَّقَ (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: لقد أزمت الوضع. / شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, طعم (أي شيء يعمل كوسيلة للإغواء)",
 "落す": "قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه. / نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا. / فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته. / أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى.",
 "落ち": "اِنْزَلَقَ / أثر, عاقبة (ظاهرة تتبع وتنتج عن ظاهرة سابقة)\nمثال: كان التأثير المغناطيسي أكبر عندما كان القضيب بالطول / نُكْتَة",
 "落ちくぼむ": "انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته)",
 "落ちこぼれ": "بعثرة, نثر (عملية البعثرة) / تشتت, تفريق (الانتشار على نطاق واسع أو الطرد بعيداً) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة) / بعثرة, تشتت (العملية الفيزيائية التي تنحرف فيها الجسيمات عشوائياً نتيجة للتصادمات) / الْبَقَايَا / مُتَسَرِّب (شخص يترك المدرسة قبل التخرج) / منسحب (شخص ينسحب من مجموعة اجتماعية أو بيئة)",
 "落ちこぼれる": "تَأَخَّرَ / قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه.",
 "落ちついた": "هَادِئ / طَمْأَنَ / ثَابِت, مُسْتَقِرّ (غَيْر قَابِل لِلتَّغَيُّر) / مُسْتَعْمَر, مُسْتَوْطَن (يسكنه مستوطنون أو مستعمرون) / مستقر, مستوطن (تم تأسيسه في وضع أو مكان مرغوب؛ غير متنقل) / محسوم, مُبت فيه (تم تحديده أو البت فيه بما لا يدع مجالاً للنزاع أو الشك)\nمثال: بدو؛ اندمجوا بين الناس المستقرين / غَيْر مُتَطَفِّل, مُتَحَفِّظ (غير مُتطفّل ولا ملحوظ بشكل مُزعج)",
 "落ちつく": "أَهْدَأَ, هَدَّأَ / هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته. / مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "落ちつける": "صَامِت, هَادِئ",
 "落ちのびる": "هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "落ちゆく": "هَرَبَ, فَرَّ (الفِرارُ)\nمثال: هرب كأرنب خائف. / هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "落ちる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب. / وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع. / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى / خَرَجَ (اِنْتَقَلَ إلى خارج المكان) / غَادَرَ (تَرَكَ)\nمثال: خرج سامي ليحتفل.",
 "落ち付き": "هُدُوء / اِسْتِقْرَار",
 "落ち付ける": "صَامِت, هَادِئ",
 "落ち口": "عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / عرف الخوذة ((شعارات النبالة) في العصور الوسطى، شعار يستخدم لتزيين الخوذة) / تحدب الطريق, ظهر الطريق (منتصف طريق محدب) / ذروة, قمة (الخط العلوي لتل أو جبل أو موجة) / فَم, بق / فوهة, مصب (فتحة تسمح بمرور السوائل أو الحبوب)",
 "落ち合う": "لِقَاء مُحَدَّد, مَوْعِد (اجتماع مخطط له في وقت ومكان معينين) / لقاء, موعد غرامي (موعد؛ عادة مع شخص من الجنس الآخر) / مكان اللقاء, ملتقى (مكان يلتقي فيه الناس)\nمثال: كان ينتظرهم في مكان اللقاء / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر.",
 "落ち度": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "落ち延びる": "هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "落ち武者": "هَارِب",
 "落ち着いた": "هَادِئ / طَمْأَنَ / ثَابِت, مُسْتَقِرّ (غَيْر قَابِل لِلتَّغَيُّر) / مُسْتَعْمَر, مُسْتَوْطَن (يسكنه مستوطنون أو مستعمرون) / مستقر, مستوطن (تم تأسيسه في وضع أو مكان مرغوب؛ غير متنقل) / محسوم, مُبت فيه (تم تحديده أو البت فيه بما لا يدع مجالاً للنزاع أو الشك)\nمثال: بدو؛ اندمجوا بين الناس المستقرين / غَيْر مُتَطَفِّل, مُتَحَفِّظ (غير مُتطفّل ولا ملحوظ بشكل مُزعج)",
 "落ち着き": "هُدُوء / اِسْتِقْرَار",
 "落ち着く": "أَهْدَأَ, هَدَّأَ / هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته. / مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "落ち着ける": "صَامِت, هَادِئ",
 "落ち窪む": "انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته)",
 "落ち葉": "إسقاط الورق, تعرية الأشجار (التسبب في تساقط أوراق الأشجار والنباتات الأخرى (عن طريق استخدام مواد كيميائية مثلاً)) / إزالة الأوراق, تساقط الأوراق (فقدان أوراق الشجر) / نَفَضِي, نَفَضِية",
 "落ち葉色": "بُنِّيّ مُحْمَرّ دَاكِن (بني مع مسحة حمراء داكنة) / قماش خمري (قماش منزلي الغزل لونه بني محمر)",
 "落ち行く": "هَرَبَ, فَرَّ (الفِرارُ)\nمثال: هرب كأرنب خائف. / هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "落ち込み": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / مُنْخَفَض",
 "落ち込む": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر) / غَطَسَ / مَجْلَى, مَغْسَلَة",
 "落ち零れ": "بعثرة, نثر (عملية البعثرة) / تشتت, تفريق (الانتشار على نطاق واسع أو الطرد بعيداً) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة) / بعثرة, تشتت (العملية الفيزيائية التي تنحرف فيها الجسيمات عشوائياً نتيجة للتصادمات) / الْبَقَايَا / مُتَسَرِّب (شخص يترك المدرسة قبل التخرج) / منسحب (شخص ينسحب من مجموعة اجتماعية أو بيئة)",
 "落ち零れる": "تَأَخَّرَ / قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه.",
 "落っこちる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب. / أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "落っことす": "قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه.",
 "落っこる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب. / أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "落った": "إسقاط, صرع (فعل إسقاط شيء ما (كشجرة)) / قَاسٍ, هَمَجِيّ ((عن الأشخاص أو أفعالهم) قادر على إلحاق الألم أو المعاناة أو مُيّال لذلك) / ثنية, درزة مسطحة (درزة تُصنع عن طريق ثني المواد الموصولة تحت بعضها أو طيها معاً وخياطتها لتجنب الحواف الخشنة) / إهاب, جلد مدبوغ (جلد الحيوان (وخاصة الحيوانات الكبيرة) بعد معالجته)",
 "落つ": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "落とし": "سَاقِط, مُتَسَاقِط (يَنْزِلُ بِحُرِّيَّةٍ تَحْتَ تَأْثِيرِ الجَاذِبِيَّة) / تَنْظِيف / فَخّ, مِصْيَدَة / نَتِيجَة",
 "落としこむ": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / طَبَّقَ (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: لقد أزمت الوضع. / شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, طعم (أي شيء يعمل كوسيلة للإغواء)",
 "落としだね": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "落としどころ": "أَرْضِيَّة مُشْتَرَكَة (أساس يتفق عليه جميع الأطراف للوصول إلى تفاهم متبادل)",
 "落とし入れる": "فَخّ, مِصْيَدَة / أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / أَسَرَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة.",
 "落とし前": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "落とし卵": "بَيْض مَسْلُوق بِدُونَ قِشْر (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من كل شهر من أشهر العام الهجري، وقد سُمِّيت بذلك…)\nمثال: ياني يحب البيض.",
 "落とし子": "مُنْتَج / سِلْعَة / حَاصِل (الشيء :حصل عليه) / مَحْصُول / حَاصِل ضَرْب (الشيء :حصل عليه) / جَدَاء",
 "落とし所": "أَرْضِيَّة مُشْتَرَكَة (أساس يتفق عليه جميع الأطراف للوصول إلى تفاهم متبادل)",
 "落とし格子": "بوابة منزلقة (بوابة تتكون من شبكة حديدية أو خشبية تتدلى في مدخل قلعة أو مدينة محصنة؛ يمكن إنزالها لمنع المرور)",
 "落とし穴": "حفرة, فخ (فخ على شكل حفرة مخفية) / شرك, فخ (صعوبة غير متوقعة أو مفاجئة)",
 "落とし紙": "وَرَق مِرْحَاض, وَرَق حَمَّام (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "落とし胤": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "落とし込む": "وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / طَبَّقَ (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: لقد أزمت الوضع. / شرك, طُعم (شيء يستخدم لجذب الأسماك أو الحيوانات الأخرى إلى الخطر ليتم اصطيادها أو قتلها) / إِغْرَاء, اسْتِدْرَاج (صفات تجذب من خلال ما يبدو أنه يعد بنوع من المكافأة) / إغراء, طعم (أي شيء يعمل كوسيلة للإغواء)",
 "落とす": "قَطْرَة / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / أَسْقَطَ ((أَسْقَطَ) في قوله أو فعله أخطأ وزل. ويقال تكلم فما أسقط في كلمة ما أخطأ؛ (أَسْقَطَ) له: خاطبه بسقط الكلام)\nمثال: هذه هي نقطة ضعفه. / نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا. / فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته. / أَدْنَى, دُنْيَا (أَدْنَى؛ أَدْنَى: (فعل)) / أَنْزَلَ (فعل تعدّ من نَزَلَ؛ ضد أَصْعَدَ، جَعَله يَنْزِل أو وضعه في مكان سَفْل؛ الشخصَ في مكان: جعله يَنْزِل به، أي يُقِيم)\nمثال: سامي من طبقة أدنى.",
 "落る": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب. / وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع. / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى / خَرَجَ (اِنْتَقَلَ إلى خارج المكان) / غَادَرَ (تَرَكَ)\nمثال: خرج سامي ليحتفل.",
 "落下": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "落下傘": "بَرَاشُوت, مِظَلّة هُبُوط",
 "落下傘兵": "مِظَلِّيّ",
 "落下傘部隊": "مظليين (مشاة مدربون ومجهزون للقفز بالمظلات)",
 "落付き": "هُدُوء / اِسْتِقْرَار",
 "落付ける": "صَامِت, هَادِئ",
 "落伍": "مُتَرَامِي الأَطْرَاف, مُتَنَاثِر (يَمْتَدُّ فِي اتِّجَاهَاتٍ مُخْتَلِفَةٍ أَوْ مُوَزَّعٌ بِشَكْلٍ غَيْرِ مُنْتَظِم) / انشقاق, صدع (انفصال شخصي أو اجتماعي (كما بين الفصائل المتعارضة))\nمثال: كانوا يأملون في تجنب قطيعة في العلاقات",
 "落伍者": "مُتَسَرِّب (شخص يترك المدرسة قبل التخرج) / منسحب (شخص ينسحب من مجموعة اجتماعية أو بيئة)",
 "落口": "عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / عرف الخوذة ((شعارات النبالة) في العصور الوسطى، شعار يستخدم لتزيين الخوذة) / تحدب الطريق, ظهر الطريق (منتصف طريق محدب) / ذروة, قمة (الخط العلوي لتل أو جبل أو موجة) / فَم, بق / فوهة, مصب (فتحة تسمح بمرور السوائل أو الحبوب)",
 "落合": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "落合う": "لِقَاء مُحَدَّد, مَوْعِد (اجتماع مخطط له في وقت ومكان معينين) / لقاء, موعد غرامي (موعد؛ عادة مع شخص من الجنس الآخر) / مكان اللقاء, ملتقى (مكان يلتقي فيه الناس)\nمثال: كان ينتظرهم في مكان اللقاء / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر.",
 "落命": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "落城": "ترك, هجران (فعل الهجر أو التخلي) / إذعان, استسلام (فعل لفظي للاعتراف بالهزيمة)",
 "落堕": "تَزَوَّجَ / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "落屑": "انسلاخ, تقشر (فقدان أجزاء من الجلد الخارجي عن طريق التقشير أو التساقط)",
 "落差": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ / فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ",
 "落度": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "落延びる": "هَرَبَ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "落後": "مُتَرَامِي الأَطْرَاف, مُتَنَاثِر (يَمْتَدُّ فِي اتِّجَاهَاتٍ مُخْتَلِفَةٍ أَوْ مُوَزَّعٌ بِشَكْلٍ غَيْرِ مُنْتَظِم) / انشقاق, صدع (انفصال شخصي أو اجتماعي (كما بين الفصائل المتعارضة))\nمثال: كانوا يأملون في تجنب قطيعة في العلاقات",
 "落後者": "مُتَسَرِّب (شخص يترك المدرسة قبل التخرج) / منسحب (شخص ينسحب من مجموعة اجتماعية أو بيئة)",
 "落想": "فِكْرَة, فِكْر (صورة ذهنية لأمر ما؛ فِكْر، نَظَر، رَأْي)\nمثال: إنها فكرة جيدة.",
 "落成": "إتمام, إكمال (إجراء ختامي أو نهائي) / تمريرة ناجحة ((كرة القدم الأمريكية) تمريرة أمامية ناجحة في كرة القدم)",
 "落手": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "落掌": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "落書": "خربشة, شخبطة (كتابة يدوية رديئة)",
 "落書き": "خربشة, شخبطة (كتابة يدوية رديئة)",
 "落書き帳": "دفتر رسم",
 "落書帳": "دفتر رسم",
 "落機山": "جِبَال رُوكِي",
 "落武者": "هَارِب",
 "落水": "طاقة مائية, قوة مائية (القدرة على بذل الشغل الكامنة في مسقط مائي) / مُرْهِق, مُنْهِك (له أثر مُوهِن ومُنهِك للقوى)",
 "落沙": "لَاك",
 "落涙": "إدماع, تدميع (ذرف الدموع)",
 "落潮": "انحسار الماء, جزر (أدنى (أبعد) انحسار للمد)",
 "落盤": "انخساف, هبوط أرضي (الانهيار المفاجئ لشيء ما في تجويف تحته)",
 "落着": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "落着き": "هُدُوء / اِسْتِقْرَار",
 "落着く": "أَهْدَأَ, هَدَّأَ / هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته. / مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "落着ける": "صَامِت, هَادِئ",
 "落第": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "落羽松": "سرو المستنقعات (خشب صنوبر متساقط الأوراق من جنس التاكسوديوم، موطنه أمريكا الشمالية) / سرو البرك / سرو أصلع, سرو المستنقعات (خشب سرو شائع في جنوب شرق الولايات المتحدة له جذع موسع عند القاعدة؛ يوجد في المستنقعات الساحلية وقيعان الأنهار الفيضية) / سرو أصلع, سرو المستنقعات (سرو شائع في جنوب شرق الولايات المتحدة له جذع متوسع عند القاعدة؛ يوجد في المستنقعات الساحلية وقيعان الأنهار الفيضية)",
 "落胆": "تثبيط (فعل التثبيط أو الإحباط) / إِحْبَاط, تَثْبِيط (التعبير عن المعارضة وعدم الاستحسان) / إحباط, تثبيط (شعور اليأس في مواجهة العقبات)\nمثال: تثبيط السرقة الصغيرة",
 "落脱": "فِرَار, هَجْر / إِغْفَال / تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة)\nمثال: دخل الفريق في حالة ركود",
 "落花枝に帰らず破鏡再び照らさず": "مَا حَدَثَ قَد حَدَثَ, مَا فَاتَ قَدْ مَاتْ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "落花生": "فُولٌ سُودَانِيٌّ, فُسْتُقُ العَبِيد",
 "落花生油": "زيت الفول السوداني (زيت مستخرج من الفول السوداني؛ يُستخدم في الطهي وصنع الصابون)",
 "落莫": "مُقْفِر, مَهْجُور",
 "落葉": "إسقاط الورق, تعرية الأشجار (التسبب في تساقط أوراق الأشجار والنباتات الأخرى (عن طريق استخدام مواد كيميائية مثلاً)) / إزالة الأوراق, تساقط الأوراق (فقدان أوراق الشجر) / نَفَضِي, نَفَضِية",
 "落葉剤": "مزيل الأوراق, مسقط الأوراق (مادة كيميائية تُرش على النباتات وتتسبب في تساقط أوراقها)",
 "落葉性": "نَفَضِي, نَفَضِية",
 "落葉松": "شجرة اللاريكس, لاريكس (أي من الصنوبريات العديدة من جنس لاريكس، جميعها ذات أوراق إبرية متساقطة) / خشب الأرزية, خشب اللارك (خشب شجرة الأرزية)",
 "落葉樹林": "غابة نفضية (غابة تتكون بشكل رئيسي من أشجار عريضة الأوراق تسقط جميع أوراقها خلال موسم واحد)",
 "落葉状": "صَفَائِحِيّ, وَرَقِيّ ((خاصة للصخور المتحولة) ذو طبقات رقيقة تشبه الأوراق) / غَزِير الأَوْرَاق, وَرَقِيّ (يحمل أوراقاً عديدة وكثيفة) / ورقي (مكون من أو يخص أو يشبه ورقة النبات)",
 "落行く": "هَرَبَ, فَرَّ (الفِرارُ)\nمثال: هرب كأرنب خائف. / هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "落込み": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / مُنْخَفَض",
 "落選": "رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "落雷": "صَاعِقَة",
 "落飾": "حلاقة الترهب, طونسورة (حلاقة قمة الرأس من قبل الكهنة أو أعضاء الرهبنة) / قرعة (تاج الرأس المحلوق للراهب أو الكاهن)",
 "落首": "بَارُودِيَا, مُحَاكَاة سَاخِرَة (تكوين يقلد أو يحرف أسلوب شخص ما، عادة بطريقة فكاهية)",
 "落髪": "حلاقة الترهب, طونسورة (حلاقة قمة الرأس من قبل الكهنة أو أعضاء الرهبنة) / قرعة (تاج الرأس المحلوق للراهب أو الكاهن)",
 "葈耳": "أرقطيون كبير, لزيق (أرقطيون بأوراق على شكل قلب يوجد في الغابات المفتوحة والأسيجة والمراعي الوعرة في أوروبا (باستثناء أقصى الشمال) وآسيا الصغرى؛ يزرع أحياناً للاستخدام…) / خراق البحر, شبيط",
 "葉": "وَرَقَة, وَرَقة / صَحِيفَة",
 "葉っぱ": "وَرَقَة, وَرَقة / صَحِيفَة / مَارِهْوَانَا, حَشِيش",
 "葉むら": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "葉ろう石": "بيروفيليت (معدن سيليكات ألمنيوم أبيض أو مخضر (يشبه التلك))",
 "葉レタス": "خس مفكك الأوراق, خس ورقي (خس ذو أوراق مجعدة بشكل فضفاض لا تشكل رأساً مضغوطاً) / خس ورقي (يتميز بأوراق مجعدة أو محززة تشكل وريدة فضفاضة لا تتطور إلى رأس مدمج)",
 "葉加瀬": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "葉叢": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "葉壁蝨": "سوس عنكبوتي (سوس غازل للشبك يهاجم نباتات الحدائق وأشجار الفاكهة)",
 "葉室": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "葉層": "صفيحة رقيقة (صفيحة رقيقة أو طبقة (خاصة من العظم أو المعدن))",
 "葉巻": "سِيجَار, سِيكَار",
 "葉巻き": "سِيجَار, سِيكَار",
 "葉巻きたばこ": "سِيجَار, سِيكَار",
 "葉巻きタバコ": "سِيجَار, سِيكَار",
 "葉巻タバコ": "سِيجَار, سِيكَار",
 "葉形": "شكل الورقة (أي من الأشكال المتنوعة التي يمكن أن تتخذها أوراق النباتات)",
 "葉書": "كَرْت بَرِيدِيّ / مذكرة, مذكرة داخلية (اقتراح أو تذكير مكتوب)",
 "葉書き": "كَرْت بَرِيدِيّ / مذكرة, مذكرة داخلية (اقتراح أو تذكير مكتوب)",
 "葉柄": "سويقة الورقة, معلاق (الساق النحيلة التي تدعم نصل الورقة)",
 "葉桜": "شجرة الكرز, كرز (أي من العديد من الأشجار والشجيرات التي تنتج فاكهة مستديرة لحمية صغيرة بنواة صلبة واحدة؛ ينتج الكثير منها أيضاً خشباً صلباً قيماً)",
 "葉焼け": "احتراق الأوراق, لفحة الأوراق (مرض نباتي يسبب مظهرًا محترقًا أو ملفوحاً للأوراق)",
 "葉片": "صفيحة رقيقة (صفيحة رقيقة أو طبقة (خاصة من العظم أو المعدن))",
 "葉状": "شَبِيه بِالوَرَقَة (يُشبه الورقة في شكله)",
 "葉状体": "ثالوس, مشرة (جسم نباتي بدون سيقان أو جذور أو أوراق حقيقية أو نظام وعائي؛ مميز للنباتات الثالوسية)",
 "葉状植物": "نبات ثالوسي, نبات مشيجي (أي من مجموعة الكائنات اللازهرية التي تتكون أساساً من مشرة (ثالس) وبالتالي لا تظهر تمايزاً إلى ساق وجذر وأوراق)",
 "葉状茎": "ساق ورقية (ساق مسطحة تشبه ورقة الشجر وتعمل عملها)",
 "葉理": "صفيحة رقيقة (صفيحة رقيقة أو طبقة (خاصة من العظم أو المعدن))",
 "葉緑体": "بلاستيدة خضراء, صانعة خضراء (بلاستيد يحتوي على اليخضور وأصباغ أخرى؛ في النباتات التي تقوم بعملية التمثيل الضوئي)",
 "葉緑素": "كلوروفيل, يخضور (أي مجموعة من الأصباغ الخضراء الموجودة في الكائنات التي تقوم بالتمثيل الضوئي)",
 "葉群": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "葉胃": "أُمّ التَلَافِيف (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "葉芹草": "عنق الكمان (نبات حولي زغبي من كاليفورنيا إلى المكسيك بنوارات مزدحمة من الزهور الصغيرة الزرقاء إلى الليلكية أو البنفسجية الفاتحة)",
 "葉芽": "برعم ورقي (برعم تتطور منه الأوراق (ولكن ليس الزهور))",
 "葉茎菜類": "خضراوات ورقية (أي من النباتات الورقية المختلفة أو أوراقها وسيقانها التي تؤكل كخضروات)",
 "葉菜類": "خضراوات ورقية (أي من النباتات الورقية المختلفة أو أوراقها وسيقانها التي تؤكل كخضروات)",
 "葉蘭": "حديد الزهر, حديد مسبوك (سبيكة من الحديد تحتوي على نسبة عالية من الكربون بحيث تكون هشة ولا يمكن طرقها بل يجب تشكيلها بالصب)",
 "葉虫": "خنفساء الأوراق (خنفساء زاهية الألوان تتغذى على أوراق النباتات؛ وتغزو يرقاتها الجذور والسيقان)",
 "葉蜂": "دبور المنشار, ذبابة المنشار (حشرة تمتلك أنثاها آلة وضع بيض تشبه المنشار لإدخال البيض في أنسجة أوراق أو سيقان النبات العائل)",
 "葉蝋石": "بيروفيليت (معدن سيليكات ألمنيوم أبيض أو مخضر (يشبه التلك))",
 "葉身": "صفيحة رقيقة (صفيحة رقيقة أو طبقة (خاصة من العظم أو المعدن)) / شَبِيه بِالوَرَقَة (يُشبه الورقة في شكله)",
 "葉軸": "عمود شوكي, عمود فقري (سلسلة الفقرات التي تشكل محور الهيكل العظمي وتحمي الحبل الشوكي) / محور (محور ورقة مركبة أو نورة مركبة)\nمثال: تسبب السقوط في كسر ظهره",
 "葉酸": "حمض الفوليك, فولات (فيتامين ب ضروري لنمو الخلايا والتكاثر)",
 "葉野菜": "خضراوات ورقية (أي من النباتات الورقية المختلفة أو أوراقها وسيقانها التي تؤكل كخضروات)",
 "葉隠": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "葉鞘": "مَهْبَل / مَهْبِل / فَرْج / ڤاچاينا",
 "葉鶏頭": "سجاد, كوليوس",
 "葎": "دابة الشجر, متسلق (أي من الطيور الصغيرة المتنوعة آكلة الحشرات في نصف الكرة الشمالي التي تتسلق جذوع الأشجار مستندة على ريش ذيل صلب وأقدامها) / زَاحِف (شخص يزحف أو يدب على الأرض) / مدادة, نبات زاحف (أي نبات (مثل اللبلاب أو العناقية) ينمو عن طريق الزحف)",
 "著": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل. / بِجَانِب, جنب (بجانب) / عِنْدَ, فِي (يُفِيدُ الحضور أو وجود صلة أو علاقة مثل الانتماء والامتلاك. (ظرف مكان)؛ يُفِيدُ قُرْبَ الشيء. (ظرف مكان)) / مِن قِبَل, بِوَاسِطَّة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / بِوَاسِطَّة, لِـ\nمثال: زيري بجانب الحوض. / صَفَاء, نَقَاء (صفة الماء الصافي) / جَلَاء, صَفَاء (الخلو من الغموض وسهولة الفهم؛ قابلية التعبير الواضح للفهم)\nمثال: عندما استيقظت عاد الصفاء إلى عينيها",
 "著しい": "لافِتٌ لِلنَّظَرِ, لافِتَةٌ لِلنَّظَرِ",
 "著しく": "إلى حد كبير, بشكل جوهري (إلى مدى أو درجة كبيرة)\nمثال: أخشى أن الفيلم تجاوز الميزانية بكثير",
 "著す": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "著する": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر. / لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "著わす": "كَتَبَ, كتب (خَطَّ الكلام؛ كتَبَ الله شيئا على فلان: أي قدَّره له أو عليه أو أوجبه على الناس)\nمثال: حملت ثلاثة كتب.",
 "著作": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "著作家": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "著作権": "حُقُوقُ النَّشْر, حُقُوقُ التَّأْلِيفِ وَٱلنَّشْر (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حق)\nمثال: الحقوق إنسانية.",
 "著作権使用料": "مَلَكِيَّة",
 "著作権侵害": "انتهاك حقوق النشر, تعدي على حق المؤلف (انتهاك الحقوق التي يكفلها حق المؤلف)",
 "著作権侵害訴訟": "انتهاك حقوق النشر, تعدي على حق المؤلف (انتهاك الحقوق التي يكفلها حق المؤلف)",
 "著作物": "أعمال, أفعال (أداء الأعمال الأخلاقية أو الدينية) / مصنع, منشأة صناعية (مباني لممارسة العمل الصناعي) / آلية داخلية (الآلية الداخلية لجهاز ما) / الشلة كلها, العدة والعتاد (كل شيء متاح)\nمثال: الخلاص بالأعمال",
 "著作者": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "著作集": "مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: شكرا لإضافتي للمجموعة.",
 "著名": "مَشْهُور, شَهِير (معروف على نطاق واسع؛ اسم مفعول للفعل \"شَهَرَ\") / مَشْهُور (معروف على نطاق واسع؛ اسم مفعول للفعل \"شَهَرَ\")\nمثال: إنه رسام مشهور.",
 "著名人": "نَجْم, نَجْمَة (طَلَعَ وظَهَرَ؛ نَجَمَ عن الأمر: أي ظهر نَتِيجَة عنه أو نَتَجَ عنه)\nمثال: سميت السفينة \"النجم الفضي\".",
 "著明": "صَفَاء, نَقَاء (صفة الماء الصافي) / جَلَاء, صَفَاء (الخلو من الغموض وسهولة الفهم؛ قابلية التعبير الواضح للفهم)\nمثال: عندما استيقظت عاد الصفاء إلى عينيها",
 "著書": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل.",
 "著者": "مُؤَلِّف, مُصَنِّف / أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك.",
 "著莪": "سوسن دموي",
 "著述": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "著述家": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "葛": "كودزو (كرمة سريعة النمو من شرق آسيا لها جذور نشوية درنية وأوراق ثلاثية مشعرة وعناقيد من الزهور الأرجوانية تليها قرون مشعرة طويلة تحتوي على العديد من البذور؛…) / دابة الشجر, متسلق (أي من الطيور الصغيرة المتنوعة آكلة الحشرات في نصف الكرة الشمالي التي تتسلق جذوع الأشجار مستندة على ريش ذيل صلب وأقدامها) / زَاحِف (شخص يزحف أو يدب على الأرض) / مدادة, نبات زاحف (أي نبات (مثل اللبلاب أو العناقية) ينمو عن طريق الزحف)",
 "葛折": "تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "葛折り": "تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "葛縷子": "كَرَاوِيَا, كَرَوْيَاء",
 "葛芋": "فاصوليا اليام, هيكاما (نبات ملتف من أمريكا الوسطى بجذور وقرون صالحة للأكل؛ تؤكل الدرنات الكبيرة نيئة أو مطبوخة خاصة عندما تكون صغيرة ويجب طهي القرون الصغيرة جيداً؛ تنتج…) / فاصوليا البطاطس, فاصوليا اليام (نبات ملتف في حوض الأمازون له جذور كبيرة صالحة للأكل)",
 "葛藤": "صِرَاع, نِزَاع\nمثال: 父と私の葛藤に、彼は気付いていないようです。 — لا يبدو على علم بسوء التفاهم الذي بيني وبين أبي.",
 "葛西": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "葛鬱金": "أكيرا, كنا هندية (كنا تزرع خاصة لجذمورها الصالح للأكل الذي يتم الحصول منه على نشا الأروروت) / أروروت, أروروت أمريكي (نبات أبيض الزهر من جزر الهند الغربية ينتج جذره نشا الأروروت) / أروروت (نشا مغذٍ يتم الحصول عليه من جذر نبات الأروروت)",
 "葡": "الْبُرْتُغَال, البرتغال (دولة في جنوب غرب أوروبا، تقع في الجزء الغربي من شبه الجزيرة الأيبيرية؛ اسمها الرسمي الجمهورية البرتغالية، وعاصمتها لشبونة)\nمثال: أنا من البرتغال.",
 "葡国": "الْبُرْتُغَال, البرتغال (دولة في جنوب غرب أوروبا، تقع في الجزء الغربي من شبه الجزيرة الأيبيرية؛ اسمها الرسمي الجمهورية البرتغالية، وعاصمتها لشبونة)",
 "葡萄": "عِنَب",
 "葡萄の木": "جَفْنَة, كَرْمَة",
 "葡萄ジュース": "عصير عنب (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟",
 "葡萄パン": "خبز الزبيب (خبز يحتوي على الزبيب)",
 "葡萄園": "كَرْم",
 "葡萄弾": "طلقة عنقودية (مجموعة من المقذوفات الصغيرة تطلق معاً من مدفع لإنتاج وابل من الطلقات)",
 "葡萄果汁": "عصير عنب (سائلٌ سُكَّريٌّ يُستخرج من بعض الثّمار عند عَصْرها)\nمثال: هل تريد عصير فاكهة؟",
 "葡萄栽培": "زراعة الكروم (زراعة العنب وكروم العنب)",
 "葡萄状球菌": "مكورة عنقودية (بكتيريا طفيلية كروية موجبة الجرام تميل لتشكيل مستعمرات غير منتظمة؛ يسبب بعضها دمامل أو تسمم الدم أو التهابات)",
 "葡萄球菌": "مكورة عنقودية (بكتيريا طفيلية كروية موجبة الجرام تميل لتشكيل مستعمرات غير منتظمة؛ يسبب بعضها دمامل أو تسمم الدم أو التهابات)",
 "葡萄畑": "كَرْم",
 "葡萄糖果糖液糖": "هيدروفلوروكربون (فلوروكربون ينبعث كمنتج ثانوي للتصنيع الصناعي)",
 "葡萄膜": "عِنَبِيَّة (جزء العين الذي يحتوي على القزحية والجسم الهدبي والمشيمية)",
 "葡萄膜炎": "التهاب العنبية, التهاب القزحية (التهاب العنبية في العين)",
 "葡萄色": "عِنَب / بني داكن, بني محمر (درجة من البني مع مسحة من الأحمر)",
 "葡萄茶": "كَسْتَنَائِيّ",
 "葡萄葛": "جَفْنَة, كَرْمَة / مِقْلَاد",
 "葡萄豆": "بَازِلَّاء",
 "葡萄酒": "نَبِيذ (نَبِيذ (صفة مفردة مذكرة، مؤنثها نَبِيْذَة، وجمعها السالم نَبِيْذُوْن، وجمعها المؤنث السالم نَبِيْذَات، وجمعها المكسر أَنْبِذَة)؛ نَبِيذ (لا يؤنث، وجمعه أَنْبِذَة)) / خَمْر (شَرَابُ الْعِنَبِ إِذَا اخْتَمَرَ؛ كُلُّ مُسْكِرٍ مُخَامِرٍ لِلْعَقْلِ، إِذَا كَانَ شَرَاباً كُحُولِيّاً أَوْ غَيْرَهُ) / شَرَاب / نبيت / خمرة / خَمُر (شَرَابُ الْعِنَبِ إِذَا اخْتَمَرَ؛ كُلُّ مُسْكِرٍ مُخَامِرٍ لِلْعَقْلِ، إِذَا كَانَ شَرَاباً كُحُولِيّاً أَوْ غَيْرَهُ) / يشرب الخمر\nمثال: أنا شربت النبيذ.",
 "葡萄酒学": "علم صناعة النبيذ (فن صناعة النبيذ)",
 "葡語": "بُرْتُغَالِيّ / اَلْبُرْتُغَالِيَّة",
 "葦": "قصب الخنادق, قيصوب شائع (قصب طويل من أمريكا الشمالية له أوراق عريضة نسبياً وعناقيد كبيرة تشبه الريش؛ واسع الانتشار في المناطق الرطبة؛ يستخدم للحصير والستائر وأعمدة السهام)",
 "葦原の中つ国": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "葦原中国": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "葦月": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "葦毛": "رمادي مرقط (رمادي بنمط مرقط من علامات رمادية أغمق)",
 "葦田鶴": "كُرْكِيّ, غُرْنُوق / رَافِعَة / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "葦笛": "أنبوب قصبي (أنبوب أرغن بقصبة مهتزة)",
 "葦鴨": "بَطَّة, بط (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق) / بَطَّة (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق)",
 "葫": "قَوِيّ الرَّائِحَةِ, نَفَّاذ (ذُو رَائِحَة قَوِيَّة نَفَّاذَة)",
 "葫蘆": "دُبَّاء",
 "葬": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\"",
 "葬り": "دَفْن, تَدْفِين (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "葬る": "دَفَنَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه) / قَبَرَ (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: دفن القط فضلاته.",
 "葬儀": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\"",
 "葬儀場": "دار الجنازة, صالة العزاء (مبنى جنائزي حيث يمكن لمن عرفوا المتوفى الحضور لتقديم احترامهم الأخير)",
 "葬儀屋": "دار الجنازة, صالة العزاء (مبنى جنائزي حيث يمكن لمن عرفوا المتوفى الحضور لتقديم احترامهم الأخير) / حَانُوتِيّ",
 "葬儀式": "أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "葬儀社": "دار الجنازة, صالة العزاء (مبنى جنائزي حيث يمكن لمن عرفوا المتوفى الحضور لتقديم احترامهم الأخير)",
 "葬儀車": "سَيَّارة نَقْل مَوْتَى, عَرَبة نَقْل مَوْتَى (مؤنث سَيَّار، صفة للكثير السَيْر؛ القَافِلَة أوالقَوْم الذين يسيرون)\nمثال: إنه يملك سيارة.",
 "葬式": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\"",
 "葬斂": "دفن (إخفاء شيء تحت الأرض) / جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\"",
 "葬殮": "دفن (إخفاء شيء تحت الأرض) / جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\"",
 "葬礼": "جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\"",
 "葬送曲": "مارش جنائزي (مارش بطيء يُعزف للجنازات)",
 "葬送歌": "تَرْنِيمَة جَنَائِزِيَّة",
 "葬送行進曲": "مارش جنائزي (مارش بطيء يُعزف للجنازات)",
 "葭": "قصب الخنادق, قيصوب شائع (قصب طويل من أمريكا الشمالية له أوراق عريضة نسبياً وعناقيد كبيرة تشبه الريش؛ واسع الانتشار في المناطق الرطبة؛ يستخدم للحصير والستائر وأعمدة السهام)",
 "葯": "مِئْبَر",
 "葱": "بصل ويلزي, كراث ياباني (بصل آسيوي ذو بصيلات نحيلة؛ يستخدم كبصل أخضر مبكر)",
 "葱パイ": "بصل أخضر (بصل صغير قبل تضخم البصلة؛ يؤكل في السلطات)",
 "葱油餅": "بصل أخضر (بصل صغير قبل تضخم البصلة؛ يؤكل في السلطات)",
 "葵": "خُبَازَى",
 "葵のご紋": "زنجبيل بري (عشب معمر منخفض النمو ذو أوراق زنجبيلية حريفة وجذامير)",
 "葵の御紋": "زنجبيل بري (عشب معمر منخفض النمو ذو أوراق زنجبيلية حريفة وجذامير)",
 "葵色": "بَنَفْسَجِيّ / أُرْجُوَانِيّ",
 "葵花": "زَهْرَة اَلشَّمْس, دَوَّار اَلشَّمْس",
 "葷": "قَوِيّ الرَّائِحَةِ, نَفَّاذ (ذُو رَائِحَة قَوِيَّة نَفَّاذَة)",
 "葹": "أرقطيون كبير, لزيق (أرقطيون بأوراق على شكل قلب يوجد في الغابات المفتوحة والأسيجة والمراعي الوعرة في أوروبا (باستثناء أقصى الشمال) وآسيا الصغرى؛ يزرع أحياناً للاستخدام…) / خراق البحر, شبيط",
 "葺": "تسقيف (حرفة السقاف (صانع الأسقف)) / سقف, مواد تسقيف (المواد المستخدمة لبناء السقف)",
 "葺き": "تسقيف (حرفة السقاف (صانع الأسقف)) / سقف, مواد تسقيف (المواد المستخدمة لبناء السقف)",
 "葺き板": "اَلْهِرْبِس اَلْعَصَبِيّ",
 "葺く": "سَقْف, سَطْح ((سَقَفَ) البيت ونحوه سقفا: عمل له سقفا)\nمثال: نظرت إلى السقف.",
 "葼": "سليل (حفيد أو وريث)\nمثال: سليل أصل ملكي",
 "蒐集家": "مجمّع (القطب الكهربائي في الترانزستور الذي يغادر من خلاله التدفق الأساسي للحاملات المنطقة بين الأقطاب) / فوهة تجميع (فوهة جمعت مواد كونية ارتطمت بالأرض) / جابي, حصل (شخص يعمل لتحصيل المدفوعات (مثل الإيجار أو الضرائب)) / جامع, مُجَمِّع (شخص يجمع الأشياء)",
 "蒔きつける": "خِنْزِيرَة / زَرَعَ, بَذَرَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت.",
 "蒔き付け": "خِنْزِيرَة / زَرَعَ, بَذَرَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت.",
 "蒔き付ける": "خِنْزِيرَة / زَرَعَ, بَذَرَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت.",
 "蒔く": "خِنْزِيرَة / زَرَعَ, بَذَرَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت. / رش, نثر (فعل رش أو طرطشة الماء) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة)",
 "蒔輪": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "蒙": "جَهْل, جَهَالَة (الجَهْل: نَقِيضُ العِلْم؛ تَجَاهَلَ: أَظهر الجَهْل)\nمثال: العلم نور والجهل ظلام. / تطبيق, طلاء (عمل وضع شيء (على سطح)) / تغطية (فعل حماية شيء ما بتغطيته) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / غِطَاء (مصنوعة تُغطّي شيئًا آخر عادةً لحمايته أو إيوائه أو إخفائه)\nمثال: وصف الطبيب وضعاً موضعياً لليود / مُنْغُولِيَا",
 "蒙る": "تَأَلَّمَ, عَانَى / عَانَى (قَاسَى وكابد؛ الشيءَ: ملابسته ومباشرته)\nمثال: لقد عانى جمال كثيرا.",
 "蒙古": "مُنْغُولِيَا / مغولي, منغولي (من أو متعلق بمنطقة منغوليا أو شعبها أو لغاتهم أو ثقافاتهم) / مغولي (عضو في الشعوب البدوية في منغوليا)\nمثال: الغزاة المغول",
 "蒙古ひだ": "طية علاية الموق (طية عمودية من الجلد فوق الموق الأنفي؛ نموذجية للعديد من شعوب شرق آسيا؛ وتحدث أحياناً في متلازمة داون)",
 "蒙古ヒダ": "طية علاية الموق (طية عمودية من الجلد فوق الموق الأنفي؛ نموذجية للعديد من شعوب شرق آسيا؛ وتحدث أحياناً في متلازمة داون)",
 "蒙古人": "مغولي, منغولي (من أو متعلق بمنطقة منغوليا أو شعبها أو لغاتهم أو ثقافاتهم) / مغولي (عضو في الشعوب البدوية في منغوليا)\nمثال: الغزاة المغول",
 "蒙古人種": "العرق الأصفر, العرق المغولي (عرق آسيوي)",
 "蒙古症": "المنغولية, متلازمة داون (اضطراب خلقي ناجم عن وجود كروموسوم 21 إضافي؛ يؤدي إلى وجه مسطح وقصر القامة وتخلف عقلي)",
 "蒙古襞": "طية علاية الموق (طية عمودية من الجلد فوق الموق الأنفي؛ نموذجية للعديد من شعوب شرق آسيا؛ وتحدث أحياناً في متلازمة داون)",
 "蒙古語": "مُغُولِيّ",
 "蒙古野馬": "حصان برزوالسكي (حصان بري في وسط آسيا يشبه الحمار؛ مهدد بالانقراض الآن)",
 "蒙昧": "جَاهِل",
 "蒙昧主義": "إبهام, تعتيم (عمل متعمد يهدف إلى جعل الشيء غامضاً) / ظلامية (سياسة معارضة التنوير أو نشر المعرفة)",
 "蒜": "قَوِيّ الرَّائِحَةِ, نَفَّاذ (ذُو رَائِحَة قَوِيَّة نَفَّاذَة)",
 "蒟蒻": "لسان الشيطان, نخيل الثعبان (نبات استوائي لحمي نوعاً ما كريه الرائحة من جنوب شرق آسيا يزرع لكورماته الصالحة للأكل أو في البيوت الزجاجية لأوراقه الكبيرة وقنابته الحمراء الداكنة…)",
 "蒟蒻版": "هيكتوغراف (ناسخة تتكون من لوحة جيلاتينية يمكن أخذ الحبر منها لعمل نسخة)",
 "蒟醤": "تانبول, فلفل التانبول (نبات فلفل آسيوي تمضغ أوراقه مع جوز التنبول (بذرة نخل التنبول) من قبل سكان جنوب شرق آسيا) / ورقة التنبول (ورقة كرمة من فلفل التنبول)",
 "蒲公英": "هِنْدِبَاء, طَرْخَشْقُون",
 "蒲団皮": "تضريب, قماش مبطن (مادة تستخدم لصنع لحاف، أو قماش مبطن) / تنجيد, خياطة اللحف (خياطة عبر طبقات من القماش والحشو لإنشاء تصميم)",
 "蒲柳": "صفصاف أحمر, صفصاف أرجواني (صفصاف أوراسي له غصينات محمرة أو أرجوانية ولحاء غني بالعفص) / ضعف, عجز (حالة الضعف في الصحة أو الجسم (خاصة بسبب الشيخوخة))",
 "蒲桃": "تفاح الورد, جامبو (فاكهة استوائية صفراء بيضاوية عطرية تستخدم في الهلام والحلويات) / تفاح الورد, جامبوزا (شجرة استوائية من جزر الهند الشرقية تزرع لفاكهتها الصالحة للأكل)",
 "蒲鉾兵舎": "كوخ كونسيت, كوخ نيسن (كوخ جاهز من الحديد المموج له مقطع عرضي نصف دائري)",
 "蒴": "كَبْسُولة",
 "蒴果": "كَبْسُولة",
 "蒸かす": "بُخَار (كلُّ رَائِحَةٍ سَطَعَتْ مِنْ نَتْنٍ أَو غَيْرِهِ؛ كل مَا يصعد كالدخان من السوائل الحارة والرائحة)\nمثال: السحابة هي كتلة بخار في السماء.",
 "蒸し": "بشكل حار جداً, بغلليان ((تستخدم للحرارة) للغاية) / بُخَارِيّ, مُتَصَاعِد البُخَار (مملوء بالبخار أو ينبعث منه رطوبة على شكل بخار أو ضباب)\nمثال: كان الطبق ساخناً جداً",
 "蒸し器": "بَاخِرَة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار) / قِدْر بُخَارِيّ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / بَاخِرَة, سَفِينَة بُخَارِيَّة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار)\nمثال: الباخرة الآن في الميناء.",
 "蒸し暑い": "رَطْب, رَطِب (يحتوي على الماء أو الرطوبة، غير جاف؛ لين أو طري الملمس بسبب وجود الرطوبة)\nمثال: ملابسي رطبة ومليئة في التراب علي تبديلها.",
 "蒸し煮": "سلق, غلي (الطهي في سائل تم غليه)",
 "蒸し蒸し": "حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج)",
 "蒸し返す": "اجترار, تكرار (مادة قديمة تم إعادة صياغتها قليلاً واستخدامها مرة أخرى)\nمثال: مجرد اجترار ممل لروايته الأولى",
 "蒸し鍋": "بَاخِرَة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار) / قِدْر بُخَارِيّ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / بَاخِرَة, سَفِينَة بُخَارِيَّة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار)\nمثال: الباخرة الآن في الميناء.",
 "蒸し風呂": "حمام بخار, حمام تركي (التعرق في غرفة بخار قبل الحصول على تدليك ودش بارد) / حمام بخار, غرفة بخار (غرفة يمكن ملؤها بالبخار يستحم فيها الناس)",
 "蒸す": "بُخَار (كلُّ رَائِحَةٍ سَطَعَتْ مِنْ نَتْنٍ أَو غَيْرِهِ؛ كل مَا يصعد كالدخان من السوائل الحارة والرائحة)\nمثال: السحابة هي كتلة بخار في السماء.",
 "蒸らす": "بُخَار (كلُّ رَائِحَةٍ سَطَعَتْ مِنْ نَتْنٍ أَو غَيْرِهِ؛ كل مَا يصعد كالدخان من السوائل الحارة والرائحة)",
 "蒸器": "بَاخِرَة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار) / قِدْر بُخَارِيّ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / بَاخِرَة, سَفِينَة بُخَارِيَّة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار)\nمثال: الباخرة الآن في الميناء.",
 "蒸散": "نتح (انبعاث بخار الماء من أوراق النباتات) / انصباب, نتح (مرور الغازات عبر أنابيب دقيقة بسبب الاختلافات في الضغط أو درجة الحرارة) / نتح (عملية إخراج أو زفر بخار الماء من خلال الجلد أو الأغشية المخاطية)",
 "蒸散作用": "نتح (انبعاث بخار الماء من أوراق النباتات) / انصباب, نتح (مرور الغازات عبر أنابيب دقيقة بسبب الاختلافات في الضغط أو درجة الحرارة) / نتح (عملية إخراج أو زفر بخار الماء من خلال الجلد أو الأغشية المخاطية)",
 "蒸散計": "مقياس التبخر (أداة تقيس معدل تبخر الماء)",
 "蒸暑": "حَارّ رَطْب, خَانِق (يتَّسم بحرارة ورطوبة خانقتَين) / شَهْوَانِيّ, مُغْرٍ (مُثير جنسيًّا أو مُمتع حسّيًّا)",
 "蒸暑い": "رَطْب, رَطِب (يحتوي على الماء أو الرطوبة، غير جاف؛ لين أو طري الملمس بسبب وجود الرطوبة)\nمثال: ملابسي رطبة ومليئة في التراب علي تبديلها.",
 "蒸民": "الْجَمَاهِير, العَامَّةُ",
 "蒸気": "بُخَار (كلُّ رَائِحَةٍ سَطَعَتْ مِنْ نَتْنٍ أَو غَيْرِهِ؛ كل مَا يصعد كالدخان من السوائل الحارة والرائحة)\nمثال: السحابة هي كتلة بخار في السماء. / بَاخِرَة, سَفِينَة بُخَارِيَّة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار)\nمثال: الباخرة الآن في الميناء.",
 "蒸気タービン": "عنفة بخارية",
 "蒸気圧": "ضغط البخار (الضغط الذي يمارسه البخار؛ غالباً ما يفهم على أنه ضغط البخار المشبع (ضغط بخار لبخار في حالة تلامس مع شكله السائل))",
 "蒸気暖房": "تدفئة بالبخار (نظام تدفئة يتم فيه توليد البخار في غلايات ونقله بالأنابيب إلى مشعات)",
 "蒸気機関": "محرك بخاري (محرك احتراق خارجي تستخدم فيه الحرارة لتوليد البخار الذي يدير توربينة أو يجبر مكبساً على التحرك صعوداً وهبوطاً في أسطوانة)",
 "蒸気機関車": "قِطَار بُخَارِيّ",
 "蒸気浴": "حمام بخار, حمام تركي (التعرق في غرفة بخار قبل الحصول على تدليك ودش بارد) / حمام بخار, غرفة بخار (غرفة يمكن ملؤها بالبخار يستحم فيها الناس)",
 "蒸気船": "بَاخِرَة, سَفِينَة بُخَارِيَّة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار)\nمثال: الباخرة الآن في الميناء.",
 "蒸汽": "بُخَار (كلُّ رَائِحَةٍ سَطَعَتْ مِنْ نَتْنٍ أَو غَيْرِهِ؛ كل مَا يصعد كالدخان من السوائل الحارة والرائحة)\nمثال: السحابة هي كتلة بخار في السماء. / بَاخِرَة, سَفِينَة بُخَارِيَّة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار)\nمثال: الباخرة الآن في الميناء.",
 "蒸汽船": "بَاخِرَة, سَفِينَة بُخَارِيَّة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار)\nمثال: الباخرة الآن في الميناء.",
 "蒸溜": "تَقْطِير",
 "蒸溜所": "معمل تقطير, مقطرة (مصنع ومنشآت يتم فيها صنع المشروبات الكحولية عن طريق التقطير)",
 "蒸煮": "سلق, غلي (الطهي في سائل تم غليه)",
 "蒸熱": "بشكل حار جداً, بغلليان ((تستخدم للحرارة) للغاية) / بُخَارِيّ, مُتَصَاعِد البُخَار (مملوء بالبخار أو ينبعث منه رطوبة على شكل بخار أو ضباب)\nمثال: كان الطبق ساخناً جداً / حَارّ رَطْب, خَانِق (يتَّسم بحرارة ورطوبة خانقتَين) / شَهْوَانِيّ, مُغْرٍ (مُثير جنسيًّا أو مُمتع حسّيًّا)",
 "蒸留": "تَقْطِير",
 "蒸留器": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "蒸留所": "معمل تقطير, مقطرة (مصنع ومنشآت يتم فيها صنع المشروبات الكحولية عن طريق التقطير)",
 "蒸留水": "ماء مقطر (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "蒸留酒": "كُحُول, خَمْر (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: أكره ذوق الكحول.",
 "蒸発": "تتجفاف, تجفيف (عملية استخلاص الرطوبة) / تبخر, تبخير (عملية التحول إلى بخار) / اِخْتِفَاء",
 "蒸発岩": "متبخرات (الراسب المتبقي بعد تبخر مياه البحر)",
 "蒸解": "طَبْخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ.",
 "蒸返す": "اجترار, تكرار (مادة قديمة تم إعادة صياغتها قليلاً واستخدامها مرة أخرى)\nمثال: مجرد اجترار ممل لروايته الأولى",
 "蒸風呂": "حمام بخار, حمام تركي (التعرق في غرفة بخار قبل الحصول على تدليك ودش بارد) / حمام بخار, غرفة بخار (غرفة يمكن ملؤها بالبخار يستحم فيها الناس)",
 "蒸餅": "خُبْز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / عيش (مصدر للفعل عَاشَ؛ هو الحَيَاة) / خُبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / خبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / قرص / خَبَزَ (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب)\nمثال: هذا الخبز لذيذ.",
 "蒼": "حَزِين / أَزْرَق, زرق (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَزْرَق والأَصْفَر) وهو لون السَمَاء نهارا حين تكون صافية. انظر الصورة؛ صفة ما كان لونه أزرقًا)\nمثال: هذا البناء أزرق. / أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات؛ صفة ما كان لونه أخضرا) / خُضْر (خَضَر الرجلُ النَّخْلَ خَضَر ُ خَضْرًا: قطعه)\nمثال: ذلك الضوء أخضر. / ضَوْء أَخْضَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف. / أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / أَسْوَد (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن) / زِنْجِيّ, زَنْجِيّ / أَسْوَد, أسود (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان لظلامه؛ هو انعدام اللَوْن)\nمثال: لديه قميص أسود.",
 "蒼々": "حَزِين / أَزْرَق, زرق (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَزْرَق والأَصْفَر) وهو لون السَمَاء نهارا حين تكون صافية. انظر الصورة؛ صفة ما كان لونه أزرقًا)\nمثال: هذا البناء أزرق. / أَخْضَر, مُخْضَرّ (يتّسم بوَفْرة الخُضْرة والنبات) / رَمَادِيّ (بلون لا لوني متوسط بين الأبيض والأسود) / رَمَادِيّ, ضَبَابِيّ (وَسَطٌ فِي الطَّبِيعَةِ أَوِ المَوْقِعِ؛ غَيْرُ وَاضِحِ المَعَالِمِ) / رَمَادِيّ (يُستخدم للدلالة على قوات الكونفدرالية في الحرب الأهلية الأمريكية (الذين ارتدوا زيّاً رمادياً)) / أَشْيَب, شَائِب (يُظهِر علامات الشيخوخة خاصّة الشعر الأبيض أو الرماديّ)",
 "蒼い": "حَزِين / أَزْرَق, زرق (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَزْرَق والأَصْفَر) وهو لون السَمَاء نهارا حين تكون صافية. انظر الصورة؛ صفة ما كان لونه أزرقًا)\nمثال: هذا البناء أزرق. / أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات؛ صفة ما كان لونه أخضرا) / خُضْر (خَضَر الرجلُ النَّخْلَ خَضَر ُ خَضْرًا: قطعه)\nمثال: ذلك الضوء أخضر. / بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ / غير ناضج, فج (غير مكتمل النمو أو النضج؛ غير يانع) / غَيْرُ جَاهِز, غَيْرُ نَاضِج (لم يكتمل استعداده بعد)\nمثال: فاكهة غير ناضجة",
 "蒼古": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "蒼天": "زرقة السماء, سماء زرقاء (السماء كما تُرى في وضح النهار)\nمثال: أطلق سهماً في كبد السماء / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "蒼惶": "بسرعة, بعجلة (بطريقة سريعة أو متسرعة)\nمثال: الطريقة التي دفنوه بها بسرعة كانت معيبة",
 "蒼惶として": "بسرعة, بعجلة (بطريقة سريعة أو متسرعة)\nمثال: الطريقة التي دفنوه بها بسرعة كانت معيبة",
 "蒼旻": "زرقة السماء, سماء زرقاء (السماء كما تُرى في وضح النهار)",
 "蒼枯": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "蒼氓": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "蒼海の一粟": "قَطْرَة فِي الْمُحِيط",
 "蒼溟": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "蒼然": "حَزِين / أَزْرَق, زرق (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَزْرَق والأَصْفَر) وهو لون السَمَاء نهارا حين تكون صافية. انظر الصورة؛ صفة ما كان لونه أزرقًا)\nمثال: هذا البناء أزرق.",
 "蒼生": "الْجَمَاهِير, العَامَّةُ",
 "蒼白": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "蒼白い": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ / أَبْيَض مُزْرَقّ (أبيض مع مسحة زرقاء)",
 "蒼白色": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "蒼穹": "زرقة السماء, سماء زرقاء (السماء كما تُرى في وضح النهار)\nمثال: أطلق سهماً في كبد السماء",
 "蒼空": "زرقة السماء, سماء زرقاء (السماء كما تُرى في وضح النهار)\nمثال: أطلق سهماً في كبد السماء",
 "蒼翠": "أَخْضَر مُزْرَقّ (ذو لون أخضر بمسحة زرقاء)",
 "蒼茫": "أَسْمَر البَشَرَة, دَاكِن البَشَرَة (ذو بشرة داكنة بطبيعتها) / شَفَقِيّ, مُتَلَأْلِئ بِنُور الغُرُوب (مُضَاء بِنُور الشَّفَق أَوْ كَأَنَّهُ كَذَلِك)",
 "蒼蒼": "حَزِين / أَزْرَق, زرق (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَزْرَق والأَصْفَر) وهو لون السَمَاء نهارا حين تكون صافية. انظر الصورة؛ صفة ما كان لونه أزرقًا)\nمثال: هذا البناء أزرق. / أَخْضَر, مُخْضَرّ (يتّسم بوَفْرة الخُضْرة والنبات) / رَمَادِيّ (بلون لا لوني متوسط بين الأبيض والأسود) / رَمَادِيّ, ضَبَابِيّ (وَسَطٌ فِي الطَّبِيعَةِ أَوِ المَوْقِعِ؛ غَيْرُ وَاضِحِ المَعَالِمِ) / رَمَادِيّ (يُستخدم للدلالة على قوات الكونفدرالية في الحرب الأهلية الأمريكية (الذين ارتدوا زيّاً رمادياً)) / أَشْيَب, شَائِب (يُظهِر علامات الشيخوخة خاصّة الشعر الأبيض أو الرماديّ)",
 "蒼鉛": "بِزْمُوث / بِزْمُوت",
 "蒼黒い": "أَسْوَد مُزْرَقّ (أسود مع مسحة زرقاء)",
 "蒿": "حبق الراعي, شيح (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في النّاس : حَبَقَ يحبِق حبْقاً وحَبِقاً وحُباقاً؛ الحَبْق : ضُراط المَعِز ، وقد تستعمل في النّاس)",
 "蓄え": "خَزَنَ (حفظ، إدخر، أودع في مخزن)",
 "蓄える": "خَزَنَ (حفظ، إدخر، أودع في مخزن) / طَوَّرَ / نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "蓄光": "تالق فسفوري, فسفرة (فلورة تستمر بعد توقف الإشعاع القاصف)",
 "蓄冷剤": "تَبْرِيدِيّ, مُبَرِّد (يُسبِّب التبريد أو التجميد) / مادة تبريد, وسيط تبريد (أي مادة تستخدم للتبريد (كما في الثلاجة))",
 "蓄圧器": "سجل المركم, مركم ((علم الحاسوب) سجل يحتوي على جامع مدمج يضيف رقم إدخال إلى محتويات السجل) / بطارية تخزين, مركم (بطارية فولتية تخزن الشحنة الكهربائية) / جابي, حصل (شخص يعمل لتحصيل المدفوعات (مثل الإيجار أو الضرائب))",
 "蓄積": "تجميع, تراكم (عملية التراكم) / تجميع, تشكيلة (أشياء عديدة مجمعة معًا أو تعتبر ككل) / أرباح محتجزة, تراكم الأرباح ((تمويل) الأرباح التي لا تُدفع كتوزيعات أرباح ولكن تضاف إلى القاعدة الرأسمالية للشركة) / تراكم, تكدس (زيادة عن طريق النمو الطبيعي أو الإضافة)",
 "蓄膿症": "تجمع قيحي, دبيلة (تجمع للقيح في تجويف الجسم (خاصة في تجويف الرئة))",
 "蓄財家": "بقرة حلوب, مشروع مُدر للربح (مشروع يولد تدفقًا مستمرًا للمال) / صانع ثروة, كاسب المال (شخص ناجح في جمع الثروة)",
 "蓄電器": "مُكَثِّف, مُكَثِّفَة",
 "蓄電池": "بطارية تخزين, مركم (بطارية فولتية تخزن الشحنة الكهربائية)",
 "蓄音器": "جرامافون, حاكي (مشغل أسطوانات قديم؛ يتم تضخيم صوت الإبرة المهتزة صوتياً)",
 "蓄音機": "جرامافون, حاكي (مشغل أسطوانات قديم؛ يتم تضخيم صوت الإبرة المهتزة صوتياً)",
 "蓄養": "إنجاب, تكاثر (النشاط الجنسي للحمل وإنجاب النسل) / تربية (إنتاج الحيوانات أو النباتات عن طريق التزاوج أو التهجين) / مُتَكَاثِر, مُنَسِّل (يُنْتِجُ نَسْلًا أَوْ مُخَصَّص لِإِنْتَاج النَّسْل) / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "蓊蔚": "مُتَكَاثِف النَّبَات (مغطى بنباتات نامية بكثافة) / مُتَشَعِّب, مُتَكَاثِف النَّبَات (مَلِيءٌ بِالنَّبَاتَاتِ غَيْرِ المَرْغُوبَةِ عَادَةً)",
 "蓊鬱": "مُتَكَاثِف النَّبَات (مغطى بنباتات نامية بكثافة) / مُتَشَعِّب, مُتَكَاثِف النَّبَات (مَلِيءٌ بِالنَّبَاتَاتِ غَيْرِ المَرْغُوبَةِ عَادَةً)",
 "蓋": "غِطَاء / غِلَاف / غَطَّى",
 "蓋し": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ / رُبَّمَا, لَعَلَّ (عن طريق الصدفة (أو الاحتمال)) / بِأَيّ حَال, بِإِمْكَان (إلى درجة يمكن تحقيقها أو بوسائل ممكنة)\nمثال: ربما ستتصل غداً",
 "蓋つき": "ذو غطاء (لديه أو مغطى بغطاء أو أغطية؛ غالباً ما تستخدم في التركيبات) / ذُو غِطَاء (له غطاء أو غطاء علوي)\nمثال: يُترك الحليب في كوب كبير ذي غطاء",
 "蓋をする": "غِطَاء / غِلَاف / غَطَّى",
 "蓋を開ける": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "蓋世": "لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "蓋付き": "ذو غطاء (لديه أو مغطى بغطاء أو أغطية؛ غالباً ما تستخدم في التركيبات) / ذُو غِطَاء (له غطاء أو غطاء علوي)\nمثال: يُترك الحليب في كوب كبير ذي غطاء",
