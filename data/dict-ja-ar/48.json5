 "青眼": "غَرْبِيّ",
 "青空": "زرقة السماء, سماء زرقاء (السماء كما تُرى في وضح النهار)\nمثال: أطلق سهماً في كبد السماء",
 "青空市場": "سوق شعبي, سوق مفتوح (سوق عام حيث يباع الطعام والبضائع في الهواء الطلق)",
 "青竜刀": "سيف معقوف (سيف قصير عريض محدب قليلاً من العصور الوسطى بنقطة حادة)",
 "青竹色": "أَخْضَر مُزْرَقّ (ذو لون أخضر بمسحة زرقاء)",
 "青筋": "وَرِيد, عِرْق",
 "青粉": "بكتيريا زرقاء, طحالب خضراء مزرقة (كائنات بدائية النواة تقوم بالتمثيل الضوئي بشكل أساسي وتحتوي على صبغة زرقاء بالإضافة إلى الكلوروفيل؛ توجد منفردة أو في مستعمرات في بيئات متنوعة؛ مهمة…)",
 "青系統": "بْلُوز / بَلُوز",
 "青緑": "سبيروجيرا, لولبية (طحالب مياه عذبة تتكون من خيوط دقيقة تحتوي على أشرطة كلوروفيل حلزونية) / أَخْضَر مُزْرَقّ (ذو لون أخضر بمسحة زرقاء) / سبيروجيرا, لولبية (طحالب مياه عذبة تتكون من خيوط دقيقة تحتوي على أشرطة كلوروفيل حلزونية)",
 "青緑色": "أَخْضَر مُزْرَقّ (ذو لون أخضر بمسحة زرقاء) / أخضر مزرق, فيروزي غامق (لون أو صبغة زرقاء مخضرة)\nمثال: طلوها بدرجة فاتحة من الأزرق المخضر",
 "青線": "خَطّ أَزْرَق (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "青臭い": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "青色": "حَزِين / أَزْرَق, زرق (أحد الأَلْوَان الرئيسية (الأَحْمَر والأَزْرَق والأَصْفَر) وهو لون السَمَاء نهارا حين تكون صافية. انظر الصورة؛ صفة ما كان لونه أزرقًا)\nمثال: هذا البناء أزرق.",
 "青色光": "ضَوْء أَزْرَق (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف.",
 "青色症": "زرقة",
 "青菜": "خضراوات ورقية (أي من النباتات الورقية المختلفة أو أوراقها وسيقانها التي تؤكل كخضروات)",
 "青萍": "عدس الماء (عَدَس)\nمثال: أعدت سلطة العدس.",
 "青藍色": "مُسْتَشِيط غَضَبًا (غاضب غضبًا عارمًا لا يُطاق) / بَاهِت, شَاحِب الإِضَاءَة ((عَنِ الضَّوْء) يُضْفِي لَمَعَانًا شَاحِبًا كَلَمَعَان المَوْت) / شَاحِب, مُمْتَقَع (شاحب اللون كأنّه فاقد الدم؛ ذو مظهر مريض) / مَكْدُوم, مُزْرَقّ (تغيّر لونه بسبب تجمع الدم تحت الجلد)",
