 "行啓": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "行嚢": "حقيبة بريد (حقيبة كتف يحملها ساعي البريد) / جراب بريد, حقيبة بريد (جراب يستخدم في شحن البريد)",
 "行平": "كَسْرُول, طَاجِن",
 "行当たる": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "行当る": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "行所": "وِجْهَة, وُجْهَة",
 "行揃え": "محاذاة, موازاة (فعل تعديل أو محاذاة أجزاء جهاز بالنسبة لبعضها البعض) / اِصْطِفَاف, مُحَاذَاة (الخاصية المكانية التي يمتلكها ترتيب أو وضع الأشياء في خط مستقيم أو في خطوط متوازية) / اقتران, محاذاة ((في علم الفلك) التقاء ظاهري أو مرور لجرمين سماويين أو أكثر في نفس الدرجة من البروج) / ائتلاف, تحالف (منظمة من الأشخاص (أو البلدان) المشاركين في ميثاق أو معاهدة)",
 "行政": "إِجْرَائِيّ / إِدَارَة, مُرَاقَبَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة) / إِدَارَة تَنْفِيذِيَّة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "行政サービス": "خدمة عامة, وظيفة حكومية (التوظيف ضمن نظام حكومي (خاصة في الخدمة المدنية)) / خدمة عامة, خدمة مجتمعية (خدمة يتم أداؤها لصالح الجمهور أو مؤسساته)",
 "行政上": "إداري (متعلق بالإدارة أو مسؤول عنها)",
 "行政区": "تقسيم إداري, قطاع إداري (منطقة محددة لأغراض إدارية)",
 "行政区画": "تقسيم إداري, قطاع إداري (منطقة محددة لأغراض إدارية)",
 "行政官": "ضابط تنفيذي, نائب القائد (الضابط الثاني في القيادة)",
 "行政官庁": "مكتب, هيئة (وحدة إدارية حكومية)\nمثال: وكالة الاستخبارات المركزية",
 "行政府": "حُكُومَة (الجهة أو المؤسسة التي تحكم دولة أو أرض ما)\nمثال: انشأوا حكومة جديدة.",
 "行政書士": "كاتب عدل, موثق (شخص مخول قانونياً ليشهد على التوقيعات ويصدق على صحة الوثائق ويأخذ الإفادات)",
 "行政条例": "أَمْرٌ تَنْفِيذِيٌّ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة)\nمثال: إنه أمر مختلف .",
 "行政権": "سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ)\nمثال: هو متعطش للسلطة.",
 "行政機関": "هيئة إدارية, وحدة إدارية (وحدة ذات مسؤوليات إدارية)",
 "行政法": "قانون إداري (مجموعة القواعد واللوائح والأوامر والقرارات التي تنشئها الوكالات الإدارية الحكومية)",
 "行政的": "إداري (متعلق بالإدارة أو مسؤول عنها)",
 "行数": "أجرة الكتابة, سعر السطر (معدل الدفع للمواد المكتوبة التي تقاس وفقاً لعدد الأسطر المقدمة) / عَدَد الأَسْطُر (عدد الأسطر في مادة مطبوعة)",
 "行文": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "行方": "مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة / وِجْهَة, وُجْهَة / نَتِيجَة / مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل / طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "行方をくらます": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "行方を晦ます": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "行方を暗ます": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "行方不明": "مَفْقُود",
 "行方知れず": "مَفْقُود",
 "行旅": "ترحال, سفر (فعل الذهاب من مكان إلى آخر)\nمثال: استمتع بالبيع لكنه كره السفر / رحّالة, مسافر (شخص يغير موقعه)",
 "行星": "كَوْكَب سَيَّار, كَوْكَب ((قديمًا) جرم سماوي من البلازما مضيئ بذاته متماسك بفعل الجاذبية؛ جرم سماوي يدور حول الشمس) / كَوْكَب ((قديمًا) جرم سماوي من البلازما مضيئ بذاته متماسك بفعل الجاذبية؛ جرم سماوي يدور حول الشمس)\nمثال: كوكب الأرض جميل.",
 "行末": "توقع, احتمال / تَنْقِيْب (نقّب إذا سار في البلاد طلباً للمهرب ، نقّب عن الأخبار وغيرها:بحث عنها،هو البحث عن كلّ شيء والتّفتيش مطلقاً؛ نقّب مبالغة في نَقَب ، نقّب عن الشيء :فحص عنه فحصاً بليغاً)",
 "行来": "طَرِيق, طَرِيق عَامّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "行楽": "رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة) / رحلة خلوية, نزهة خلوية (يوم مخصص لتجمع اجتماعي في الهواء الطلق)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "行楽地": "فندق منتجع, منتجع (فندق يقع في منطقة منتجع)",
 "行楽客": "سَائِح, سَائِحَة",
 "行殊": "وَاقِعَة, حَادِثَة (مؤنث الوَاقِع، اسم فاعل للشيء المؤنث الذي وَقَعَ؛ مؤنث وَاقِع، الأمر المؤنث الحاصل)\nمثال: الصخور الواقعة تشكل خطرا على المتسلقين.",
 "行水": "وُضُوء, غُسْل / وَضُوء",
 "行法": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية",
 "行為": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / مَثَّلَ (الشَبَه؛ النَظِير) / تَصَرَّفَ\nمثال: المهم هو العمل.",
 "行為者": "فَاعِل, فَاعِلَة (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "行為障害": "سِي دِي",
 "行状": "سُلُوك, تَصَرُّف",
 "行着く": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر.",
 "行程": "رِحْلَة, سَفَر / مَسار الرِّحْلَة (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة. / سكتة دِمَاغِيَّة / لَاطَفَ / مَلَّسَ",
 "行程表": "مَسار الرِّحْلَة (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة. / خَرِيطَةُ الطَّرِيق (الخَارِطَة، رسم عليه تضاريس الأرض وحدودها)\nمثال: انظر إلى الخريطة.",
 "行者": "نُسُكِيّ / نَاسِك",
 "行脚": "حَجّ (القَصْد والزِيَارَة على جهة التَعْظِيم؛ زيارة مكان مُقَدَّس بهدف ديني ويوجد عند معظم الديانات منها اليَهُودِيَّة والمَسِيحِيَّة والإسْلام)\nمثال: ذهب رجل للحج وترك خلفه خمس بنات وكلبة. / ترحال, سفر (فعل الذهاب من مكان إلى آخر)\nمثال: استمتع بالبيع لكنه كره السفر",
 "行詰まり": "جمود, طريق مسدود (وضع لا يمكن فيه إحراز تقدم أو لا يمكن فيه أي تقدم)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "行詰り": "جمود, طريق مسدود (وضع لا يمكن فيه إحراز تقدم أو لا يمكن فيه أي تقدم)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "行足": "زَخَم حَرَكَة (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…) / زَخَم (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…)\nمثال: يمكنك أن تتعلم بنفس الزخم في المكتبة كما في المدرسة.",
 "行跡": "سُلُوك, تَصَرُّف",
 "行路": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "行軍": "مَسِيرَة / لَحْن السَّيْر, مَارْش (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز) / سَارَ (مَشَى)\nمثال: أنا أحب هذا اللحن.",
 "行送り": "تغذية السطر (العملية التي تمهد لطباعة أو عرض الحرف التالي في السطر التالي)",
 "行進": "مَسِيرَة / لَحْن السَّيْر, مَارْش (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز) / سَارَ (مَشَى)\nمثال: أنا أحب هذا اللحن.",
 "行進曲": "مَسِيرَة / لَحْن السَّيْر, مَارْش (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز) / سَارَ (مَشَى)\nمثال: أنا أحب هذا اللحن.",
 "行道": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "行違い": "خلاف, صراع (خلاف أو جدال حول أمر مهم)\nمثال: كان لديه نزاع مع زوجته",
 "行違う": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق. / تَصَادُم / يتصادم",
 "行間を読み取る": "قَرَأَ مَا بَيْنَ السُّطُور (نَطَقَ بما هو مكتوب؛ تَتَبَّعَ ما هو مكتوب وفَهِمَه)\nمثال: قرأ سامي الرسالة.",
 "行間を読む": "قَرَأَ مَا بَيْنَ السُّطُور (نَطَقَ بما هو مكتوب؛ تَتَبَّعَ ما هو مكتوب وفَهِمَه)\nمثال: قرأ سامي الرسالة.",
 "衍義": "إسهاب, بلورة (التطوير بتفاصيل معقدة ومضنية) / تفصيل, توضيح (إضافة مواد إضافية أو توضيح أو تفاصيل شارحة) / تَعْقِيد دَقِيق, تَفْصِيل (يتميز بتفاصيل معقدة ومتقنة) / توسع, توضيح (مناقشة تقدم معلومات إضافية)\nمثال: بضع ملاحظات أضيفت كتوضيح ودفاع",
 "衒い": "تَصَنُّع, تَكَلُّف",
 "衒う": "اِسْتِعْرَاض, مَوْكِب",
 "衒妻": "زَوْجَة, اِمْرَأَة / دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "衒学": "تحذلق (عرض متباه وغير مناسب للمعرفة)",
 "衒学的": "أَكَادِيمِيّ, مُتَحَذْلِق (يتّسم بالتركيز الضيّق على المعرفة وعرضها خاصّة جوانبها التافهة)",
 "衒学者": "مُتَشَدِّق / مُتَحَذْلِق",
 "衒学趣味": "تحذلق (عرض متباه وغير مناسب للمعرفة)",
 "衒気": "تَصَنُّع, تَكَلُّف",
 "術": "فَنّ, فُنُون (نوع، صنف؛ كل عمل جميل يؤثر في المشاعر والعواطف)\nمثال: هذا مدرسنا في الفن. / طريقة, واسطة (امتلاك القدرة على إنتاج تأثير معين أو تحقيق غاية) / أَدَاة, وَسِيلَة (مصنوعة تُستخدَم وسيلة لإنجاز غاية ما) / ثراء, سعة (رأس مال كبير (ثروة أو دخل))\nمثال: وسيلة للسيطرة / حيلة, مناورة (مناورة في لعبة أو محادثة) / حيلة, خديعة (مخطط مفصل أو خادع تم تدبيره للخداع أو التهرب)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار / سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر. / طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "術ない": "بِخَسَارَة (أقل من التكلفة)\nمثال: باع السيارة بخسارة",
 "術なし": "بِخَسَارَة (أقل من التكلفة)\nمثال: باع السيارة بخسارة",
 "術中": "حِيلَة",
 "術前": "قَبْل الجِراحَة (يَسْبِق العَمَلِيَّة الجِراحِيَّة)",
 "術士": "تكتيكي (شخص ماهر في تخطيط التكتيكات) / سَاحِر",
 "術式": "اِجْرَاء / أُسْلُوب, تِقْنِيَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "術後": "بَعْد الجِراحَة (يَلي العَمَلِيَّة الجِراحِيَّة)",
 "術数": "حيلة, مناورة (مناورة في لعبة أو محادثة) / حيلة, خديعة (مخطط مفصل أو خادع تم تدبيره للخداع أو التهرب)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "術法": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر.",
 "術無い": "بِخَسَارَة (أقل من التكلفة)\nمثال: باع السيارة بخسارة",
 "術無し": "بِخَسَارَة (أقل من التكلفة)\nمثال: باع السيارة بخسارة",
 "術策": "خدعة, مكيدة (مناورة خادعة (خاصة لتجنب الأسر))",
 "術策を弄する": "دَسِيسَة",
 "術者": "مُمَارِس",
 "術計": "حيلة, مناورة (مناورة في لعبة أو محادثة) / حيلة, خديعة (مخطط مفصل أو خادع تم تدبيره للخداع أو التهرب)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "術語": "عِلْمُ المُصْطَلَحِ (أَدْرَكَ حقيقة الشيء) / مُصْطَلَح (اسم مفعول من الفعل \"اصْطَلَحَ\"؛ كل كلمة لها دلالة معينة، متفق عليها بين العلماء في علم ما)\nمثال: أدرس علم النفس.",
 "術野": "حقل الجراحة, ساحة العملية (المنطقة التي تكون مفتوحة أثناء الجراحة)",
 "街": "شَارِع, زَنَقَة / مَدِينَة, قَرْيَة / وَسَطُ البَلَد / شَارِع, زَنَقَة",
 "街々": "شَارِع, زَنَقَة",
 "街じゅう": "جَمِيع أَنْحَاء, كُلّ",
 "街づくり": "تخطيط حضري, تخطيط مدن (تحديد ووضع خطط للترتيب المادي المستقبلي وحالة المجتمع السكني)",
 "街の女": "عاهرة شوارع (عاهرة تجذب الزبائن بالمشي في الشوارع)",
 "街並": "شَارِع, زَنَقَة",
 "街並み": "شَارِع, زَنَقَة",
 "街中": "وَسَطُ البَلَد / جَمِيع أَنْحَاء, كُلّ",
 "街作り": "تخطيط حضري, تخطيط مدن (تحديد ووضع خطط للترتيب المادي المستقبلي وحالة المجتمع السكني)",
 "街区": "طَابُوقَة",
 "街外れ": "أطراف, ضواحي (المناطق الخارجية (كما في مدينة أو بلدة))\nمثال: عاشوا في ضواحي هيوستن",
 "街娼": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "街宣": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية",
 "街宣右翼": "الجناح اليميني, اليمين (أولئك الذين يدعمون المحافظة السياسية أو الاجتماعية أو الاقتصادية؛ أولئك الذين يعتقدون أن الأمور أفضل إذا تركت دون تغيير)",
 "街宣車": "شاحنة دعاية صوتية (شاحنة مجهزة بمكبر صوت وتستخدم للإعلان)",
 "街着": "ملابس خروج (ملابس عادية مناسبة للظهور العام (بخلاف الأزياء التنكرية أو الملابس الرياضية أو ملابس العمل وما إلى ذلك))",
 "街街": "شَارِع, زَنَقَة",
 "街衢": "مَدِينَة, قَرْيَة",
 "街角": "زاوِيَةِ, نَاصِيَة",
 "街談巷語": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً) / إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "街路": "طَرِيق, سِكَّة (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "街路アドレス": "عنوان الشارع (العنوان الذي يمكن العثور فيه على شخص أو منظمة)",
 "街造り": "تخطيط حضري, تخطيط مدن (تحديد ووضع خطط للترتيب المادي المستقبلي وحالة المجتمع السكني)",
 "街道": "طَرِيق, طَرِيق عَامّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "街金": "مرابٍ (شخص يقرض المال بأسعار فائدة مفرطة)",
 "街頭": "شَارِع, زَنَقَة",
 "街頭アンケート": "استطلاع رأي, استفتاء (استقصاء للرأي العام يتم عن طريق مقابلة عينة عشوائية من الناس)",
 "街頭インタビュー": "رأي عام, صوت الشعب (معتقد أو شعور يشاركه معظم الناس)\nمثال: طلب إجراء استطلاع للرأي العام",
 "街頭宣伝": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية",
 "衙府": "مكتب حكومي (مكتب يعمل فيه موظفو الحكومة)",
 "衙門": "مكتب حكومي (مكتب يعمل فيه موظفو الحكومة)",
 "衛兵": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "衛兵所": "سجن عسكري, مركز حراسة (منشأة عسكرية تعمل كمقر للشرطة العسكرية ويمكن فيها احتجاز السجناء العسكريين)",
 "衛戍": "حَامِيَة",
 "衛戍地": "حَامِيَة",
 "衛星": "قَمَر, تَابِع (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث) / قَمَر اِصْطِنَاعِيّ (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "衛星テレビ": "تلفزيون فضائي (نظام تلفزيوني يتم فيه إرسال الإشارة إلى قمر صناعي يدور حول الأرض يستقبل الإشارة ويضخمها ويرسلها مرة أخرى إلى الأرض)",
 "衛星テレビ放送": "تلفزيون فضائي (نظام تلفزيوني يتم فيه إرسال الإشارة إلى قمر صناعي يدور حول الأرض يستقبل الإشارة ويضخمها ويرسلها مرة أخرى إلى الأرض)",
 "衛生": "عِلْم الصِّحَّة, عِلْم حِفْظ الصِّحَّة (أَدْرَكَ حقيقة الشيء) / نَظَافَة, حِفْظ الصِّحَّة\nمثال: أدرس علم النفس. / مِرْحَاض, تواليت",
 "衛生マスク": "قناع الوجه (قناع يوفر غطاءً واقياً للوجه في رياضات مثل البيسبول أو كرة القدم أو الهوكي)",
 "衛生上": "صحي, نظيف (خالٍ من القذارة ومسببات الأمراض)\nمثال: ظروف صحية لإعداد الطعام",
 "衛生兵": "ضابط طبي (ممارس طبي في القوات المسلحة) / فصة, نفل",
 "衛生士": "أخصائي صحة عامة (أخصائي طبي في علم الصحة)",
 "衛生学": "علم الصحة العامة, نظافة (العلم المعني بالوقاية من المرض والحفاظ على الصحة)",
 "衛生状態": "حالة صحية, وضع صحي (حالة النظافة العامة (نظيف أو قذر))",
 "衛生的": "صِحِّيّ, وِقَائِيّ (يميل إلى تعزيز الصحة أو الحفاظ عليها)",
 "衛生管理": "اَلصِّحَّة الْعُمُومِيَّة",
 "衛護": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "衝": "مقابلة / مُعَارَضَة, مُقَاوَمَة (الرفض وعدم القبول؛ أخذ الطريق بالعرض) / تَنَاقُضْ\nمثال: أغلبية اللجنة كانت معارضة للخطة.",
 "衝き動かす": "مِهْمَاز",
 "衝く": "زُبّ, زُبْر (في : اللحية أو مقدمها؛ في : الأنف) / خَزَّ (\"خَزَّهُ بسكِّينٍ\" : طَعَنَهُ بِهِ؛ \"خَزَّهُ بِبَصَرِهِ\" : أَصَابَتْهُ عَيْنُه)\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟ / اِسْتِعْمَال, اِسْتِخْدَام (اِسْتِعْمَال) / اِسْتَعْمَلَ, اِسْتَخْدَمَ (عَمِلَ بالشيء؛ اِتَّخَذَ الشخصَ عَامِلًا عنده)\nمثال: أيمكنني استعمال هاتفك؟ / حَمْلَة / هَاجَمَ",
 "衝上断層": "صدع الدسر, صدع عكسي (صدع جيولوجي يبدو فيه أن الجانب العلوي قد تم دفعه للأعلى بفعل الضغط)",
 "衝動": "دفعة, قوة دافعة مفاجئة (فعل تطبيق قوة فجأة) / دفعة, زخم (قوة دافعة) / سيال عصبي, نبضة عصبية (التفريغ الكهربائي الذي ينتقل عبر الليف العصبي) / نبض, نبضة ((في الإلكترونيات) موجة عابرة حادة في الحالة الكهربائية الطبيعية (أو سلسلة من هذه العوابر))\nمثال: الدفعة المفاجئة أسقطته أرضاً",
 "衝動タービン": "توربين نبضي, عنفة دفعية (توربين يتم تشغيله بواسطة تدفقات نفاثة مباشرة ضد الشفرات)",
 "衝動的": "طَائِش, مُتَهَوِّر (يتّسم بالتسرّع المفرط وعدم التفكير أو التروّي) / مِزَاجِيّ, نَزَوِيّ (مُحَدَّدٌ بِالصُّدْفَةِ أَوِ النَّزْوَةِ لَا بِالضَّرُورَةِ أَوِ العَقْل) / دَافِع, مُحَرِّك (له قوّة الدفع أو التحريك) / انْدِفَاعِيّ, مُتَهَوِّر (بدون تفكير مسبق أو ترَوٍّ)",
 "衝天": "ابتهاج, زهو (شعور بالفرح والفخر)",
 "衝心": "قُصُور القَلْب, فَشَل القَلْب",
 "衝撃": "تأثير, تعدي (التأثير بقوة) / صَدْمَة, صِدَام (التفاعل العنيف بين الأفراد أو الجماعات التي تدخل في القتال) / ارتطام, صدمة (ضرب جسم لآخر) / تأثير, وقع (عاقبة قوية؛ تأثير قوي)\nمثال: استاءوا من طغيان القيم الأمريكية على الثقافة الأوروبية / صَدْمَة / صَعْقَة / صَعَقَ",
 "衝撃と畏怖": "الصدمة والترويع",
 "衝撃タービン": "توربين نبضي, عنفة دفعية (توربين يتم تشغيله بواسطة تدفقات نفاثة مباشرة ضد الشفرات)",
 "衝撃検流計": "جلفانومتر باليستي (جلفانومتر ذو ملف متحرك يقيس الشحنة الكهربائية)",
 "衝撃波": "موجة صادمة",
 "衝撃療法": "علاج بالصدمة (علاج بعض الحالات الذهانية عن طريق إعطاء صدمات تتبعها تشنجات)",
 "衝撃的": "مُبِيد, مُدَمِّر (يَتَسَبَّبُ أَوْ يَقْدِرُ عَلَى التَّدْمِيرِ الكَامِلِ) / سَاحِق, مُدَمِّر (مُدَمِّرٌ مَادِّيًّا أَوْ مَعْنَوِيًّا؛ يُسْتَخْدَمُ غَالِبًا فِي التَّرْكِيبَاتِ) / سَاحِقٌ, مَاحِقٌ (يستخف بالآخرين ويحقرهم)",
 "衝突": "تَصَادُّم, اِصْطِدَام / تَصَادُم / يتصادم",
 "衝突器": "مصادم (معجل يتم فيه إجبار شعاعين من الجسيمات على التصادم وجهاً لوجه)",
 "衝突検出": "سِي دِي",
 "衝羽根朝顔": "بيتونيا (أي من الأعشاب الاستوائية العديدة ذات الزهور المخددة على شكل قمع)",
 "衡器": "مِقْيَاس / مِيزَان (آلة تُوزن بها الأشياء ويُعْرف مِقْدارها؛ عَدْل) / سُلَّمٌ مُوسِيقِيّ (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / سُلَّم (أَمِنَ على نفسه وحالته؛ بَرِئَ من الآفات والْأَذَى) / فَلْس, حَرْشَف\nمثال: هم يريدون السلم.",
 "衡平": "رَصِيد",
 "衡平法": "إنصاف, عدالة (المطابقة للقواعد أو المعايير) / حقوق الملكية, رأس المال السهمي (حصة ملكية المساهمين في شركة) / حقوق الملكية الصافية (الفرق بين القيمة السوقية للعقار والمطالبات المحتفظ بها ضده)\nمثال: اعترف القاضي بعدالة مطالبتي",
 "衡量": "وَزْن",
 "衢": "عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور / شَارِع, زَنَقَة / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَوْضِع\nمثال: هنا موقع الحادث. / قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "衣": "مَلَابِس, ثِيَاب / رِدَاء (ما يُلبَس فوق الثياب كالجُبَّة والعَبَاءَة؛ الثوب يستر الجزء الأعلى من الجسم فوق الإِزَار)\nمثال: تبدو جميلة في هذا الرداء. / تطبيق, طلاء (عمل وضع شيء (على سطح)) / طبقة, طلاء (طبقة رقيقة تغطي شيئاً ما) / قماش المعاطف (قماش ثقيل مناسب للمعاطف) / تشطيب, طبقة خارجية (ملمس أو مظهر زخرفي لسطح ما (أو المادة التي تعطيه ذلك المظهر))\nمثال: وصف الطبيب وضعاً موضعياً لليود",
 "衣吹": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "衣嚢": "جَيْب (جيَّب القميص:جَابَ، جعل له جيبًا)\nمثال: جيب سامي مثقوب.",
 "衣川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "衣手": "كُمّ, رُدْن",
 "衣文": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / ثَوْب, لِبَاس (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء) / كَسْوَة, مَلْبَس\nمثال: لبس سروالا نظيفا.",
 "衣料": "مَلَابِس, ثِيَاب",
 "衣料品": "مَلَابِس, ثِيَاب",
 "衣料品店": "متجر ملابس رجالية (متجر تباع فيه ملابس الرجال)",
 "衣更着": "فِبْرَايِر, شُبَاط (الشهر الثاني في السنة الميلادية الروميّة)\nمثال: سأكون قد درست الإنجليزية لخمس سنوات مع حلول فبراير المقبل.",
 "衣替え": "تَجْدِيد, إِحْيَاء",
 "衣服": "مَلَابِس, ثِيَاب",
 "衣物": "مَلَابِس, ثِيَاب",
 "衣笠": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "衣紋": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / ثَوْب, لِبَاس (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء) / كَسْوَة, مَلْبَس\nمثال: لبس سروالا نظيفا.",
 "衣虱": "قملة الجسم (قملة طفيلية تغزو جسم البشر)",
 "衣被": "صَحْنَاة, صِحْنَاة",
 "衣装": "مَلَابِس, ثِيَاب",
 "衣装戸棚": "خِزَانَة, خِزَانَة ثَوْب (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "衣装方": "كومودينو",
 "衣装箪笥": "خِزَانَة, خِزَانَة ثَوْب (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "衣装部屋": "غرفة صغيرة (غرفة صغيرة كبيرة بما يكفي للسماح بالدخول) / فوز مضمون, نزهة (نصر مؤكد (خاصة في الانتخابات)) / منشق طوعي (عميل يبادر بالانشقاق (عادة إلى بلد معادٍ) من أجل اللجوء السياسي) / زَائِر دُونَ مَوْعِد (شخص يدخل دون الحصول على موعد مسبق)\nمثال: غرفة الطوارئ كانت مكتظة بالزائرين دون موعد",
 "衣裳": "مَلَابِس, ثِيَاب",
 "衣類": "مَلَابِس, ثِيَاب",
 "衣類乾燥機": "مُجَفِّف مَلَابِس",
 "衣食": "حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / مَعِيشَة, مَعَاش / حَيَاة, طَرِيقَة فِي حَيَاة (الحَياة: ضد الموت والحَيُّ: ضدُّ الميّت؛ والمَحْيا مَفْعَلٌ من الحياة. تقول: مَحْيَاي ومماتي. والجمع الحَحايي)\nمثال: ينبح كلب في الحي.",
 "表": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / جَبْهَة / أَمَامِيّ / خَارِج, بره / جَدْوَل",
