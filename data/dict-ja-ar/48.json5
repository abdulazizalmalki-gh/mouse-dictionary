 "鏡鑑": "قدوة, كمال (حالة مثالية؛ تجسيد مثالي لمفهوم ما) / مثال للكمال, نموذج مثالي (نموذج للتميز أو الكمال من نوعه؛ شخص لا مثيل له)",
 "鏤刻": "نَقْشْ (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان) / تلميع, صقل (عمل جعل الشيء أملساً ولامعاً عن طريق فركه أو تشميعة)\nمثال: وفر تلميع الأحذية عيشاً ضئيلاً",
 "鏨": "إِزْمِيل / منقاش, مِزمَل (إزميل من الفولاذ المقسى ذو طرف حاد؛ يستخدم للنقش) / مهماز (نخاس حاد مثبت في كعب الراكب ويستخدم لحث الحصان على التقدم) / اضطراب القلق العام (اضطراب قلق يتميز بقلق مزمن غير محدد وأعراض مثل التوتر أو التعرق أو الارتجاف أو الدوار أو التهيج وما إلى ذلك، والتي استمرت لأكثر من ستة أشهر)\nمثال: يعرف رعاة البقر ألا يجلسوا القرفصاء وهم يرتدون مهاميزهم",
 "鐔": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي. / حَافَة",
 "鐘": "جَرَس, جرس (جَرَسَ الطَّائِرُ: صَوَّتَ؛ جَرَسَ الكَلاَمَ: نَغَمَ بِهِ وَتَكَلَّمَ) / اِتِّصَال\nمثال: ياني يرن الجرس.",
 "鐘つき": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه) / قارع الأجراس (شخص يعزف على الأجراس اليدوية الموسيقية) / قارع الأجراس (شخص يقرع أجراس الكنيسة (مثل دعوة المصلين))\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "鐘つき堂": "برج الجرس, غرفة الجرس (غرفة (غالباً في قمة برج) تعلق فيها الأجراس) / برج الناقوس, منارة الجرس (برج جرس؛ عادة ما يقف منفرداً غير متصل بمبنى)",
 "鐘の音": "جرس موسيقي, رنين (آلة إيقاعية تتكون من مجموعة من الأجراس المضبوطة التي تُضرب بمطرقة؛ تستخدم كآلة أوركسترالية)",
 "鐘堂": "برج الجرس, غرفة الجرس (غرفة (غالباً في قمة برج) تعلق فيها الأجراس) / برج الناقوس, منارة الجرس (برج جرس؛ عادة ما يقف منفرداً غير متصل بمبنى)",
 "鐘塔": "برج الجرس (برج يدعم أو يأوي جرساً)",
 "鐘撞き": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه) / قارع الأجراس (شخص يعزف على الأجراس اليدوية الموسيقية) / قارع الأجراس (شخص يقرع أجراس الكنيسة (مثل دعوة المصلين))\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "鐘撞き堂": "برج الجرس, غرفة الجرس (غرفة (غالباً في قمة برج) تعلق فيها الأجراس) / برج الناقوس, منارة الجرس (برج جرس؛ عادة ما يقف منفرداً غير متصل بمبنى)",
 "鐘撞堂": "برج الجرس, غرفة الجرس (غرفة (غالباً في قمة برج) تعلق فيها الأجراس) / برج الناقوس, منارة الجرس (برج جرس؛ عادة ما يقف منفرداً غير متصل بمبنى)",
 "鐘楼": "برج الجرس, غرفة الجرس (غرفة (غالباً في قمة برج) تعلق فيها الأجراس) / برج الناقوس, منارة الجرس (برج جرس؛ عادة ما يقف منفرداً غير متصل بمبنى)",
 "鐙": "رِكَاب",
 "鐙骨": "رِكَاب",
 "鐚一文": "بِنْس",
 "鐵": "حَدِيد (مَعْدِن صَلْب قَوِيّ يستخرج من الأرض له ألوان تتراوح بين الرَمَاديّ والأسْوَد) / حَدِيدِيّ / كَوَى\nمثال: حملت الحديد فلم أجد أثقل من الدين. / فُولَاذ / سِكَّة حَدِيدِيَّة, سِكَّة حَدِيد / سِكَّة حَدِيدِيَّة, سِكَّة الْحَدِيد",
 "鐵工所": "مصنع حديد (مكان العمل الذي يتم فيه صهر الحديد أو صنع المنتجات الحديدية)",
 "鐶": "حَلْقَة / خَاتَم, خَاتِم / دَقَّ, رَنَّ (الشيءَ: ضربه وأصدر صوتًا عند الدق؛ البابَ: طرقه) / رَنَّ ((رَنَّ) رنينا: صَوَّت وَصَاح؛ (رَنَّ) إِلَيْهِ: أصغى) / تَلْفَنَ, رَنَّ / مثال: واصل زيري دق الجرس. / سِوَار / مشروب مقوي, منشط (مقوي أو منشط (خاصة مشروب كحولي)) / حامي الساعد, واقي الذراع (غطاء واقٍ للمعصم أو الذراع يستخدم في الرماية والمبارزة ورياضات أخرى)",
 "鐸": "ثنائي, دويتو (تأليف موسيقي لمؤديين اثنين) / ثنائي, زوجان (زوج من الأشخاص يرتبطون ببعضهم البعض) / ثنائي (اثنان من المؤدين أو المغنين يؤدون معاً) / ثُنَائِيّ, زَوْج (عنصران من نفس النوع)\nمثال: الخطيبان",
 "鑄る": "صَبَّ, رَمَى (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون) / ضِمَاد مِنَ الْجِبْس\nمثال: صب الشاي لضيفك.",
 "鑑": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "鑑みる": "أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "鑑別": "تَفْرِيق / تَمْيِيز",
 "鑑別診断": "تشخيص تفريقي (طريقة منهجية لتشخيص اضطراب يفتقر إلى أعراض أو علامات فريدة)",
 "鑑定": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين",
 "鑑定人": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "鑑定価格": "تثمين, تخمين (تقدير خبير للجودة والكمية والخصائص الأخرى لشخص أو شيء ما) / تقدير, تقييم (تصنيف شخص أو شيء ما فيما يتعلق بقيمته) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))",
 "鑑定士": "مُثمِّن, مُقدِّر القيمة (شخص يقدر رسميًا قيمة أو جودة الأشياء) / خبير توثيق, مُوثِّق (من يحدد الأصالة (كما في الأعمال الفنية) أو يضمن الصلاحية)",
 "鑑定官": "مُثمِّن, مُقدِّر القيمة (شخص يقدر رسميًا قيمة أو جودة الأشياء) / خبير توثيق, مُوثِّق (من يحدد الأصالة (كما في الأعمال الفنية) أو يضمن الصلاحية)",
 "鑑定家": "قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "鑑札": "إذن, تصريح (وثيقة قانونية تعطي إذناً رسمياً للقيام بشيء ما) / خروج عن المألوف, رخصة (حرية الانحراف عمداً عن القواعد أو الممارسات المطبقة عادة (خاصة في السلوك أو الكلام)) / إباحية, تحرر مفرط (حرية مفرطة؛ انعدام القيود الواجبة)\nمثال: عندما تصبح الحرية إباحية، تكون الديكتاتورية قريبة",
 "鑑査": "تَفَقُّد",
 "鑑識": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين / تثمين, تخمين (تقدير خبير للجودة والكمية والخصائص الأخرى لشخص أو شيء ما) / تقدير, تقييم (تصنيف شخص أو شيء ما فيما يتعلق بقيمته) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب)) / أدلة جنائية, طب شرعي (اختبارات أو تقنيات علمية تستخدم في التحقيق في الجرائم)",
 "鑑識家": "عَارِف, عَارِفَة",
 "鑑識課": "أدلة جنائية, طب شرعي (اختبارات أو تقنيات علمية تستخدم في التحقيق في الجرائم)",
 "鑑賞": "تَقْدِير",
