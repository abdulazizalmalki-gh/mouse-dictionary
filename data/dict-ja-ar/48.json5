 "長音": "حركة طويلة, صائت طويل (صائت يتم نطقه عادة لفترة أطول نوعاً ما من الصوائت الأخرى (عادة حوالي 1.5 إلى ضعف الطول))",
 "長音符": "عَلَامَة اَلْمَدّ (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "長音符号": "عَلَامَة اَلْمَدّ (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "長音記号": "عَلَامَة اَلْمَدّ (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "長音階": "سلم الماجور, سلم كبير (سلم دياتوني تفصل بين نغماته نغمات كاملة باستثناء بين الثالثة والرابعة والسابعة والثامنة)",
 "長須鯨": "حوت الزعنفة, حوت زعنفي (حوت باليني كبير مسطح الرأس له أخاديد عميقة على طول الحلق؛ يعيش في المحيط الأطلسي والهادئ)",
 "長頭": "تطاول الرأس (صفة تطاول الجمجمة أو الرأس (طول الرأس كبير بالنسبة لعرضه))",
 "長骨": "عظم طويل (في أطراف الفقاريات: عظم أسطواني طويل يحتوي على نخاع)",
 "長鼻": "خُرْطُوم",
 "長鼻類": "خرطوميات (ثدييات عاشبة ضخمة لها أنياب وخرطوم طويل)",
 "門": "مِصْرَاع (البَاب. ويطلق غالباً على الأبواب الخشبية الثقيلة؛ هو ما يسُدٌّ الباب من خشب) / دُخُول / مَدْخَل / ضَيِّق / بَوَّابَة / مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة. / شُعْبَة / بَوَّابَة / مَجْلِس",
 "門がまえ": "بَوَّابَة",
 "門下生": "تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ",
 "門下省": "مستشارية (مبنى حكومي يضم مكتب المستشار)",
 "門人": "تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ",
 "門付": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت) / مِنْ بَابٍ لِبَاب ((عَنِ الرِّحْلَات أَوِ التَّوْصِيلَات) مُبَاشَرَة مِنْ نُقْطَة الأَصْل إِلَى الوِجْهَة)",
 "門付け": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت) / مِنْ بَابٍ لِبَاب ((عَنِ الرِّحْلَات أَوِ التَّوْصِيلَات) مُبَاشَرَة مِنْ نُقْطَة الأَصْل إِلَى الوِجْهَة)",
 "門出": "رَحِيل, مُغَادَرَة",
 "門口": "أَبْوَاب, بَاب",
 "門地": "دَرَجَة",
 "門外漢": "أجنبي, دخيل (شخص مستبعد أو ليس عضواً في مجموعة معينة) / متسابق غير مرشح (متسابق (إنسان أو حيوان) لا يُعتقد أن لديه فرصة جيدة للفوز)",
 "門弟": "حَوَارِيّ, تِلْمِيذ",
 "門徒": "تَابِع / مُتَابِع",
 "門戸": "أَبْوَاب, بَاب",
 "門札": "لوحة الباب (لوحة اسم مثبتة على باب؛ تشير إلى الشخص الذي يعمل أو يعيش هناك)",
 "門柱": "عمود البوابة (أي من العمودين اللذين يحدان البوابة)",
 "門構": "بَوَّابَة",
 "門構え": "بَوَّابَة",
 "門標": "لوحة الاسم (لوحة تحمل اسماً)",
 "門歯": "قَاطِعَة",
 "門生": "تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ",
 "門番": "بَوَّاب, حارِس الباب (شخص يحرس مدخلاً) / حَارِس الْبَوَّابَة, مُرَاقِب الدُّخُول (شخص يتحكم في الوصول إلى شيء ما)\nمثال: يوجد الكثير من مراقبي الدخول بين الضباط الميدانيين والرئيس",
 "門脈": "وريد بابي, وريد بابي كبدي (وريد قصير يحمل الدم إلى الكبد)",
 "門葉": "نَسَب",
 "門衛": "بَوَّاب, حارِس الباب (شخص يحرس مدخلاً) / حَارِس الْبَوَّابَة, مُرَاقِب الدُّخُول (شخص يتحكم في الوصول إلى شيء ما)\nمثال: يوجد الكثير من مراقبي الدخول بين الضباط الميدانيين والرئيس",
 "門表": "لوحة الاسم (لوحة تحمل اسماً)",
 "門閥": "أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم) / أصل, سلالة (الاشتقاق الوراثي للفرد) / أجرة الكتابة, سعر السطر (معدل الدفع للمواد المكتوبة التي تقاس وفقاً لعدد الأسطر المقدمة) / عَدَد الأَسْطُر (عدد الأسطر في مادة مطبوعة)\nمثال: كل سلالته كانت محاربين",
 "門附": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت) / مِنْ بَابٍ لِبَاب ((عَنِ الرِّحْلَات أَوِ التَّوْصِيلَات) مُبَاشَرَة مِنْ نُقْطَة الأَصْل إِلَى الوِجْهَة)",
 "門附け": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت) / مِنْ بَابٍ لِبَاب ((عَنِ الرِّحْلَات أَوِ التَّوْصِيلَات) مُبَاشَرَة مِنْ نُقْطَة الأَصْل إِلَى الوِجْهَة)",
 "門限": "وقت الإغلاق (الوقت المعتاد من اليوم الذي تغلق فيه مؤسسة أبوابها أمام الجمهور)",
 "門院": "إِمْبِرَاطُورَة الأُمّ",
 "閂": "حَانَة, بَار / سينش (شكل من أشكال لعبة أول فورز يزايد فيه اللاعبون لامتياز تسمية الأوراق الرابحة) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به) / حزام البطن, حزام السرج (معدات اسطبل تتكون من حزام حول بطن الحصان يثبت السرج في مكانه)\nمثال: تسويق هذا المنتج لن يكون نزهة",
 "閃々": "غازي, فوار (يُستخدم للنبيذ والمياه؛ مشحون طبيعياً أو صناعياً بثاني أكسيد الكربون) / بَرَّاق, مُتَأَلِّق (يلمع بنقاط ضوء ساطعة كالنجوم) / تلألؤ, وميض (تغير سريع في السطوع؛ شرارة قصيرة أو وميض)\nمثال: نبيذ فوار / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً)",
 "閃かす": "إشهار, تلويح (فعل التلويح)",
 "閃き": "أُسْلُوب مُمَيَّز, تَأَلُّق (أناقة مميزة وعصرية) / ذوق فطري, موهبة فطرية (موهبة طبيعية) / اتساع, انفراج (شكل يتسع للخارج)\nمثال: لديه موهبة في الرياضيات / نظرة ثاقبة / تلويح (فعل الإشارة بحركة اليد)",
 "閃く": "البَرْق / تمايل, رفرفة (فعل التحرك ذهاباً وإياباً) / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً) / اضطراب, قلاقل (ثوران أو صخب غير منظم) / رفرفة (خفقان سريع غير طبيعي للأذينين في القلب (خاصة بنظم منتظم)؛ يمكن أن يؤدي إلى حصار القلب)\nمثال: لقد ذهلوا من الاضطراب العنيف الذي سببوه",
 "閃ウラン鉱": "بتشبيند, يورانينيت (معدن يتكون من أكسيد اليورانيوم وآثار من الراديوم والثوريوم والبولونيوم والرصاص والهيليوم؛ يسمى اليورانينيت في شكله الكتلي بتشبيند وهو خام اليورانيوم…)",
 "閃亜鉛鉱": "بلند الزنك, سفاليريت (خام يعد المصدر الرئيسي للزنك؛ يتكون إلى حد كبير من كبريتيد الزنك البلوري)",
 "閃光": "البَرْق / شِيلَر",
 "閃光電球": "فلاش, مصباح وميضي (مصباح لتوفير ضوء لحظي لالتقاط صورة فوتوغرافية)",
 "閃緑岩": "ديوريت (صخر ناري متطفل بلوري حبيبي)",
 "閃閃": "غازي, فوار (يُستخدم للنبيذ والمياه؛ مشحون طبيعياً أو صناعياً بثاني أكسيد الكربون) / بَرَّاق, مُتَأَلِّق (يلمع بنقاط ضوء ساطعة كالنجوم) / تلألؤ, وميض (تغير سريع في السطوع؛ شرارة قصيرة أو وميض)\nمثال: نبيذ فوار / خفقان, رفرفة (حركة الرفرفة صعوداً وهبوطاً)",
 "閉ざす": "أَغْلَقَ (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / اِنْغَلَقَ\nمثال: أغلق الباب بغضب / طَابُوقَة / قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب. / مَلَأَ",
 "閉じこめる": "كَمَّمَ الفَمَ / صَه, اُسْكُت (صَهْ اسم فعل أمر بمعنى اسكتْ، وهو بلفظ واحد للمفرد و الجمع و المذكر و المؤنث; يقال صَهٍ بالتنوين بمعنى اسكت سكوتاً ما في وقتٍ ما)",
 "閉じる": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "閉じ込める": "كَمَّمَ الفَمَ / صَه, اُسْكُت (صَهْ اسم فعل أمر بمعنى اسكتْ، وهو بلفظ واحد للمفرد و الجمع و المذكر و المؤنث; يقال صَهٍ بالتنوين بمعنى اسكت سكوتاً ما في وقتٍ ما)",
 "閉まり": "إتمام, إكمال (إجراء ختامي أو نهائي) / إغلاق, إقفال (إنهاء العمليات) / اقتراب, تضييق المسافة (الاقتراب من وجهة معينة؛ تضييق الفجوة) / إغلاق (عملية إغلاق شيء ما)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية",
 "閉まる": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب / شَدَّ, ضَيَّقَ",
 "閉める": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "閉め出し": "تبييض, فوز نظيف (هزيمة في لعبة يفشل فيها أحد الجانبين في التسجيل)",
 "閉め出す": "حَانَة, بَار",
 "閉め切る": "بمدى قريب, عن قرب (قريب جداً)\nمثال: بدون نظارة القراءة لا أستطيع رؤية الأشياء عن قرب / قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "閉会": "إغلاق, إقفال (إنهاء العمليات) / اقتراب, تضييق المسافة (الاقتراب من وجهة معينة؛ تضييق الفجوة) / انسداد, سد (فعل السد أو الغلق) / انسداد, سدادة (عائق في أنبوب أو مجرى)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية",
 "閉出し": "تبييض, فوز نظيف (هزيمة في لعبة يفشل فيها أحد الجانبين في التسجيل)",
 "閉切る": "بمدى قريب, عن قرب (قريب جداً)\nمثال: بدون نظارة القراءة لا أستطيع رؤية الأشياء عن قرب / قَطَعَ (قطع الشيء : جزه؛ قطع الشيء : فصل بعضه عن بعضه الآخر)\nمثال: قطع زيري العشب.",
 "閉包": "إغلاق, إقفال (إنهاء العمليات) / اقتراب, تضييق المسافة (الاقتراب من وجهة معينة؛ تضييق الفجوة) / انسداد, سد (فعل السد أو الغلق) / انسداد, سدادة (عائق في أنبوب أو مجرى)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية",
 "閉区間": "فترة مغلقة (فترة تتضمن نقطتي نهايتها)",
 "閉合": "إغلاق, إقفال (إنهاء العمليات) / اقتراب, تضييق المسافة (الاقتراب من وجهة معينة؛ تضييق الفجوة) / انسداد, سد (فعل السد أو الغلق) / انسداد, سدادة (عائق في أنبوب أو مجرى)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية",
 "閉回路": "دائرة مغلقة (دائرة كهربائية كاملة يتدفق حولها التيار أو تدور فيها إشارة)",
 "閉域": "مُغْلَق",
 "閉場": "إتمام, إكمال (إجراء ختامي أو نهائي) / إغلاق, إقفال (إنهاء العمليات) / اقتراب, تضييق المسافة (الاقتراب من وجهة معينة؛ تضييق الفجوة) / إغلاق (عملية إغلاق شيء ما)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية",
 "閉塞": "انسداد, سد (فعل السد أو الغلق) / انسداد, سدادة (عائق في أنبوب أو مجرى) / إعاقة, انسداد (الحالة المادية لسد أو ملء ممر بعائق)\nمثال: اضطررنا لاستدعاء سباك لإزالة الانسداد في أنبوب الصرف",
 "閉塞性動脈硬化症": "تصلب الشرايين الساد (مرحلة من تصلب الشرايين تنطوي على انغلاق الأوعية الدموية)",
 "閉塞隅角緑内障": "زرق حاد, زرق مغلق الزاوية (زرق (غلوكوما) تقوم فيه القزحية بسد تدفق الخلط المائي)\nمثال: يمكن للزرق مغلق الزاوية أن يسبب تراكمًا سريعًا لضغط العين المرتفع مما يؤدي إلى تلف بصري دائم في غضون يومين",
 "閉局": "إتمام, إكمال (إجراء ختامي أو نهائي) / إغلاق, إقفال (إنهاء العمليات) / اقتراب, تضييق المسافة (الاقتراب من وجهة معينة؛ تضييق الفجوة) / إغلاق (عملية إغلاق شيء ما)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية",
 "閉幕": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "閉店セール": "تصفية إغلاق النشاط, تصفية نهائية (بيع جميع الأصول الملموسة لشركة على وشك الإغلاق)\nمثال: خلال الكساد الكبير كانت تصفيات إغلاق النشاط شائعة جداً",
 "閉所": "إتمام, إكمال (إجراء ختامي أو نهائي) / إغلاق, إقفال (إنهاء العمليات) / اقتراب, تضييق المسافة (الاقتراب من وجهة معينة؛ تضييق الفجوة) / إغلاق (عملية إغلاق شيء ما)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية",
 "閉所恐怖": "رهاب الأماكن المغلقة (خوف مرضي من الاحتجاز في مكان ضيق)",
 "閉所恐怖症": "رهاب الأماكن المغلقة (خوف مرضي من الاحتجاز في مكان ضيق)",
 "閉曲線": "منحنى مغلق (منحنى (مثل الدائرة) ليس له نقاط نهاية)",
 "閉栓": "ضغط الأوتار (نوع العزف الذي يتضمن الضغط بالأصابع على أوتار آلة وترية للتحكم في النغمة) / حشوة, شريط لحام (مثبت يتكون من شريط ضيق من المعدن الملحوم يستخدم لربط الأعضاء الفولاذية)\nمثال: كان ضغط عازف الكمان للأوتار ممتازاً / فَجْوَة عَمِيقَة, هُوَّة (تفاوت لا يمكن جسره (بسبب فشل في الفهم مثلاً))\nمثال: شعر بهوة بينه وبين أصدقائه السابقين",
 "閉業": "إيقاف, انقطاع (فعل الإيقاف أو القطع؛ انقطاع (مؤقت أو دائم))",
 "閉止": "إيقاف, توقف (فعل إيقاف شيء ما) / انسداد, سدادة (عائق في أنبوب أو مجرى) / توقف, كبح (حالة عدم النشاط بعد انقطاع)\nمثال: إيقافه للتدفق أدى إلى فيضان",
 "閉殻筋": "عضلة مقربة (عضلة تسحب جزءاً من الجسم باتجاه الخط الناصف)",
 "閉経": "إِيَاس",
 "閉経後": "ما بعد الإياس, ما بعد انقطاع الطمث (لاحق لسن اليأس (انقطاع الطمث))",
 "閉経期": "إِيَاس",
 "閉路": "دائرة مغلقة (دائرة كهربائية كاملة يتدفق حولها التيار أو تدور فيها إشارة)",
 "閉鎖": "إتمام, إكمال (إجراء ختامي أو نهائي) / إغلاق, إقفال (إنهاء العمليات) / اقتراب, تضييق المسافة (الاقتراب من وجهة معينة؛ تضييق الفجوة) / إغلاق (عملية إغلاق شيء ما)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية / إغلاق, إقفال (إنهاء العمليات)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية",
 "閉鎖式": "دائرة مغلقة (دائرة كهربائية كاملة يتدفق حولها التيار أو تدور فيها إشارة)",
 "閉鎖的": "جَزَرِيّ",
 "閉鎖花": "ذاتي التلقيح (مكون من أو متعلق بـ أو مميز للتلقيح الذاتي)",
 "閉鎖音": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "閉門蟄居": "إِقَامَة جَبْرِيَّة",
 "閉音節": "مقطع مغلق (مقطع صوتي ينتهي بصامت)",
 "閉館": "إتمام, إكمال (إجراء ختامي أو نهائي) / إغلاق, إقفال (إنهاء العمليات) / اقتراب, تضييق المسافة (الاقتراب من وجهة معينة؛ تضييق الفجوة) / إغلاق (عملية إغلاق شيء ما)\nمثال: أسفوا لإغلاق مركز الرعاية النهارية",
 "閉館時間": "وقت الإغلاق (الوقت المعتاد من اليوم الذي تغلق فيه مؤسسة أبوابها أمام الجمهور)",
 "開": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "開いた口がふさがらない": "مَبْهُوت, مَصْعُوق (كأنه أُصيب بالخرس من شدة الذهول والمفاجأة)",
 "開いた口が塞がらない": "مَبْهُوت, مَصْعُوق (كأنه أُصيب بالخرس من شدة الذهول والمفاجأة)",
 "開いた口が塞がらぬ": "مدهش, مفاجئ (يسبب المفاجأة أو العجب أو الذهول)\nمثال: التقرير يظهر نقصاً مفاجئاً في البيانات الواقعية الصلبة",
 "開いた口も塞がらぬ": "مدهش, مفاجئ (يسبب المفاجأة أو العجب أو الذهول)\nمثال: التقرير يظهر نقصاً مفاجئاً في البيانات الواقعية الصلبة",
 "開かずの": "غَيْرُ مَفْتُوح, مُغْلَق (لم يُفتَح بعد ولم يُفَكّ ختمه) / مَحْظُور, مُحَرَّم (اسم مفعول من حَظَرَ؛ المَمْنُوع والمُحَرَّم، ضد المُبَاح)",
 "開き": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / تَمْدِيد",
 "開き口": "ثقب, فتحة (فتحة من صنع الإنسان؛ عادة ما تكون صغيرة) / فتحة عدسة (جهاز يتحكم في كمية الضوء المسموح بدخولها) / فتحة (فتحة طبيعية في شيء ما)",
 "開き戸": "أَبْوَاب, بَاب",
 "開き癖": "سدى (الخيط المرتب طولياً على النول ويقطعه اللحمة) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / اعوجاج, انبعاج (شكل مشوه باللي أو الطي) / انحراف (التواء أو شذوذ؛ خاصة طريقة منحرفة أو غير طبيعية في الحكم أو التصرف)",
 "開く": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا. / إزهار, تزهير (رواسب مسحوقية على سطح ما) / زهرة (العضو التكاثري للنباتات كاسيات البذور خاصة تلك التي لها أجزاء مبهرجة أو ملونة) / إزهار, تفتح (العملية العضوية لحمل الزهور) / تورد, نضارة (لون وردي (خاصة في الخدين) يؤخذ كعلامة على الصحة الجيدة)\nمثال: سوف توقف كل الإزهار إذا تركت الزهور تنتج البذور / مَسَكَ, مسك / أَسَّسَ",
 "開け": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / حَضَارَة, تَمَدُّن (حَضَارَة: مصدر؛ ضد البداوة، الإستقرار في الحضر. \"فلان من أهل الحضارة\" أي من أهل المدن أو القرى؛ حَضَارَة: مصدر؛ مَدَنِية. \"السرعة جزء من الحضارة الحديثة\"، أي جزء من الحياة في المدن في الوقت الحديث) / تَثْقِيف\nمثال: الحضارة الامازيغية عظيمة.",
 "開けっぴろげ": "بِلَا ضَوَابِط, مُتَسَاهِل (متراخٍ في تطبيق القوانين) / مَفْتُوح عَلَى مِصْرَاعَيْه (مفتوح على اتّساعه) / إِفْرَنْجِيّ",
 "開けっ広げ": "بِلَا ضَوَابِط, مُتَسَاهِل (متراخٍ في تطبيق القوانين) / مَفْتُوح عَلَى مِصْرَاعَيْه (مفتوح على اتّساعه) / إِفْرَنْجِيّ",
 "開けっ放し": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "開ける": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا. / فَارِغ / فَرَغَ / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة. / تَفَرَّقَ (تفرق الشَّيْء تفَرقا وتفراقا تبدد وَالرجلَانِ ذهب كل مِنْهُمَا فِي طَرِيق؛ تفرَّقَ) / فَرَّقَ / مُنْتَشِر, مُتَفَرِّق\nمثال: أتستطيع أن تفرق توم من أخيه؟ / حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة. / طَوَّرَ / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا. / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا. / تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ",
 "開け口": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "開け広げ": "غَيْر مُتَيَقِّظ, مَكْشُوف (لا يُبدي أيّ حذر أو احتراس) / غَيْرُ مَحْرُوس (يَفْتَقِرُ إِلَى الحِرَاسَةِ أَوِ الحِمَايَة)",
 "開け払う": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "開け放し": "جَرِيء, صَدَّاح (يُعبّر عن رأيه بحرّيّة وإصرار) / صَرِيح, فَصِيح (يَتَّسِم بِالمُبَاشَرَة فِي الأُسْلُوب أَوِ الكَلَام؛ بِدُون مُوَارَبَة أَوْ تَهَرُّب)",
 "開催": "إبقاء, احتفاظ (فعل الاحتفاظ بشيء ما) / أملاك, مقتنيات (شيء مملوك؛ أي حيازة ملموسة أو غير ملموسة يمتلكها شخص ما)\nمثال: تلك القبعة ملكي",
 "開催中": "قَيْد التَّنْفِيذ, قَيْد الحَرَكَة (في حالة حركة؛ بدأ في التحرك)\nمثال: تحركت السفينة",
 "開催地": "دائرة الاختصاص المكاني, مكان الانعقاد (في القانون: الولاية القضائية التي ستُعقد فيها المحاكمة) / محل, مكان الانعقاد (مسرح أي حدث أو إجراء (خاصة مكان الاجتماع))",
 "開催日": "تَمْرَة, تَمْر / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مُوَاعَدَة, مَوْعِد / لِقَاء الْحُبّ, مَوْعِد (وجود اثنين أو أكثر معًا، صدفةً أو تدبيرًا) / أَرَّخَ (أَرَخَّ الشيءَ: بالغ فيه؛ وأَرَخَّ العجينَ: أكثر ماءه)\nمثال: ما تاريخ اليوم؟",
 "開先": "روتين ممل (روتين ثابت ورتيب يصعب الهروب منه) / أخدود, ميزابة ((في التشريح) أي شق أو قناة على هيكل أو جزء جسدي) / أخدود, شطب (شق ضيق وطويل تم حفره بعملية طبيعية (مثل التآكل) أو بأداة (مثل أخدود في أسطوانة فونوغراف))\nمثال: وقعوا في روتين محادثة ممل",
 "開削": "استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض) / تنيقب, حفر (فعل الحفر) / حفر, حفرية (حفرة في الأرض ناتجة عن الحفر) / حفرية, موقع أثري (موقع الاستكشاف الأثري)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون",
 "開創器": "مبعد (أداة جراحية تمسك حواف الشق الجراحي للخلف)",
 "開化": "حَضَارَة, تَمَدُّن (حَضَارَة: مصدر؛ ضد البداوة، الإستقرار في الحضر. \"فلان من أهل الحضارة\" أي من أهل المدن أو القرى؛ حَضَارَة: مصدر؛ مَدَنِية. \"السرعة جزء من الحضارة الحديثة\"، أي جزء من الحياة في المدن في الوقت الحديث) / تَثْقِيف\nمثال: الحضارة الامازيغية عظيمة.",
 "開区間": "فترة مفتوحة (فترة لا تتضمن نقطتي نهايتها)",
 "開口": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "開口一番": "أَوَّلًا, قَبْلَ كُلِّ شَيْءٍ",
 "開口部": "ثقب, فتحة (فتحة من صنع الإنسان؛ عادة ما تكون صغيرة) / فتحة عدسة (جهاز يتحكم في كمية الضوء المسموح بدخولها) / فتحة (فتحة طبيعية في شيء ما)",
 "開回路": "دائرة مفتوحة (دائرة كهربائية غير مكتملة لا يتدفق فيها تيار)",
 "開基": "إنشاء, ابتداء (فعل بدء شيء ما لأول مرة؛ تقديم شيء جديد)\nمثال: تطلعت إلى بدايتها كشخص بالغ / قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "開場": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / تَنْصِيب",
 "開墾": "ترويق, تصفية (فعل إزالة الجزيئات الصلبة من سائل) / تبرئة (فعل التحرير من الشكوك) / فُرْجَة, فُسْحَة (قطعة أرض بها عدد قليل من الأشجار أو خالية منها تقع وسط منطقة حرجية)",
 "開墾地": "أرض زراعية, أرض محروثة (أرض صالحة للزراعة يتم حرثها وزرعها وإنتاج المحاصيل منها)",
 "開始": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "開始価格": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا.",
 "開始時刻": "استهلال, انطلاق (الوقت الذي يفترض أن يبدأ فيه شيء ما)\nمثال: بدأوا بداية مبكرة",
 "開室": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "開封": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "開局": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "開帳": "إِظْهَار, عَرْض / شَاشَة / فَاضِح, كَاشِف (يكشف عن غير قصد شيئًا مخفيًّا) / فاضح, كاشف (يُظهر أو يُعرف بالشيء) / إفشاء, كشف (الفعل الكلامي لجعل الشيء واضحاً)\nمثال: نظرة كاشفة / حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "開幕": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "開幕戦": "فَتَّاحَة, مِفَكّ (التي تكثر الفَتْح)",
 "開度": "تباعد, تشعب (عملية الابتعاد في اتجاهات مختلفة عن نقطة مشتركة) / تَبَايُن, تَضَارُب (اختلاف بين حقائق أو ادعاءات أو آراء متعارضة) / تَبَاعُد (متسلسلة لا نهائية ليس لها حد) / اختلاف, انحراف (اختلاف ينحرف عن المعيار أو القاعدة)\nمثال: تتشكل الزاوية من تباعد خطين مستقيمين",
 "開廷": "مُحَاكَمَة (قرار المحكمة على الجاني؛ القضاء الجنائي على متهم)\nمثال: تمت محاكمة زيري.",
 "開張": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / باع الجناح (المسافة الخطية بين طرفي سطح انسيابي هوائي) / امتداد الجناحين (المسافة بين طرفي الأجنحة (لطائر أو حشرة) عند فردها بالكامل)",
 "開心術": "جراحة القلب المفتوح (جراحة قلب يتم فيها فتح القفص الصدري، وإيقاف القلب، وتحويل الدم عبر جهاز القلب والرئة بينما يتم إصلاح صمام القلب أو الشريان التاجي جراحياً)",
 "開悟": "حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت.",
 "開戦派": "حزب الحرب (حزب سياسي يدعم الحرب) / فريق الحرب (مجموعة من المحاربين الذين يغيرون أو يقاتلون عدواً (تستخدم بشكل خاص للأمريكيين الأصليين))",
 "開所": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "開披": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "開拓": "استصلاح, تدوير (استعادة المواد المفيدة من النفايات) / إصلاح, تقويم (الإنقاذ من الخطأ والعودة إلى المسار الصحيح) / إعادة تأهيل, استصلاح (تحويل الأرض البور إلى أرض صالحة للسكن أو الزراعة)\nمثال: إصلاح الأطفال الجانحين / رَائِد",
 "開拓者": "رَائِد",
 "開放": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "開放値": "النِّسْبَة البُؤْرِيَّة, رَقَم البُؤْرَة (نسبة البعد البؤري إلى قطر نظام عدسة (الكاميرا))",
 "開放性": "انفتاح, تقبل (الاستعداد أو الجاهزية للتلقي (خاصة الانطباعات أو الأفكار)) / انفتاح, شفافية (يتسم بموقف يسهل الوصول إليه (خاصة فيما يتعلق بأفعال المرء أو مقاصده)؛ بدون إخفاء؛ غير كتوم) / اِتِّسَاع, اِنْفِتَاح (الخلو من العوائق أمام المرور أو الرؤية)\nمثال: كان يختبر تقبل الحكومة للإصلاح",
 "開放感": "رُحْب, رَحَب (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: رحب فاضل بليلى.",
 "開放的": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "開放骨折": "كسر مركب, كسر مفتوح (كسر عظمي مصحوب بتهتك في الأنسجة الرخوة أو جرح مفتوح)",
 "開散": "تباعد, تشعب (عملية الابتعاد في اتجاهات مختلفة عن نقطة مشتركة) / تَبَايُن, تَضَارُب (اختلاف بين حقائق أو ادعاءات أو آراء متعارضة) / تَبَاعُد (متسلسلة لا نهائية ليس لها حد) / اختلاف, انحراف (اختلاف ينحرف عن المعيار أو القاعدة)\nمثال: تتشكل الزاوية من تباعد خطين مستقيمين",
 "開方": "تَطَوُّر",
 "開明": "حَضَارَة, تَمَدُّن (حَضَارَة: مصدر؛ ضد البداوة، الإستقرار في الحضر. \"فلان من أهل الحضارة\" أي من أهل المدن أو القرى؛ حَضَارَة: مصدر؛ مَدَنِية. \"السرعة جزء من الحضارة الحديثة\"، أي جزء من الحياة في المدن في الوقت الحديث) / تَثْقِيف\nمثال: الحضارة الامازيغية عظيمة.",
 "開板": "نشر (العمل التجاري لإصدار المواد المطبوعة للبيع أو التوزيع)",
 "開枕": "نوم (توقف الوعي وانخفاض معدل الأيض) / سكون, كمون (حالة من الراحة الهادئة وغير النشطة) / رَاقِد, نَائِم (مستلقٍ ورأسه على كفَّيه كأنَّه نائم) / استغراق في النوم (حالة كون الشخص نائماً)",
 "開栓": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب / رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
 "開梱": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "開法": "تَطَوُّر",
 "開浴": "استحمام, اغتسال (فعل غسل النفس (أو شخص آخر)) / استجمام, اغتسال (غمر الجسم في الماء أو تعريضه للشمس بغرض الاستجمام)",
 "開港場": "ميناء معاهدة (ميناء في الصين أو كوريا أو اليابان كان مفتوحًا للتجارة الخارجية بموجب معاهدة تجارية)",
 "開演": "افتتاح, ليلة الافتتاح (الأداء الأول (كما في إنتاج مسرحي))\nمثال: تلقى الافتتاح مراجعات نقدية جيدة",
 "開版": "نشر (العمل التجاري لإصدار المواد المطبوعة للبيع أو التوزيع)",
 "開発": "إِعْمَار, تَعْمِير / اِسْتِغْلَال (استخدام الموارد أو الظروف أو الفرص بشكل مثمر أو للحصول على فائدة؛ استغلال شخص أو موقف بشكل غير عادل لتحقيق مكاسب شخصية)\nمثال: يبدو أن رئيس القسم يحب استغلال سلطته.",
 "開発事業": "إِعْمَار, تَعْمِير",
 "開発元": "مُطَوِّر (الشخص الذي يقوم بـ«تطوير» شيء ما، أي تحسينه أو تغييره للأفضل، كمنتج أو نظام أو مهارة؛ في الاستخدام المعاصر، يُقصد به غالبًا «مُطَوِّر البرمجيات» أو «مُطَوِّر التطبيقات» أي شخص يعمل على تصميم وتطوير البرمجيات)",
 "開発教育協会": "عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "開発経緯": "مِيزَة / صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "開発者": "مُطَوِّر (الشخص الذي يقوم بـ«تطوير» شيء ما، أي تحسينه أو تغييره للأفضل، كمنتج أو نظام أو مهارة؛ في الاستخدام المعاصر، يُقصد به غالبًا «مُطَوِّر البرمجيات» أو «مُطَوِّر التطبيقات» أي شخص يعمل على تصميم وتطوير البرمجيات)",
 "開発途上国": "دَوْلَة نَامِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "開眼": "تَنْوِير",
 "開示": "أَطْلَقَ سَرَاح, حَرَّرَ / اِكْتِشَاف",
 "開祖": "مُؤَسِّس, مُؤَسِّسَة",
 "開票": "ركضة, نقطة (نقطة في البيسبول يسجلها العداء بلمس جميع القواعد الأربع بأمان) / إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي) / حساب, كشف الحساب (فاتورة بمبلغ مستحق)\nمثال: سجل فريق اليانكيز 3 ركضات في النصف الثاني من الشوط التاسع",
 "開胸": "بضع الصدر (شق جراحي في جدران الصدر لفتح التجويف الجنبي)",
 "開胸術": "بضع الصدر (شق جراحي في جدران الصدر لفتح التجويف الجنبي)",
 "開腹手術": "بضع البطن, فتح البطن (شق جراحي في جدار البطن؛ غالباً ما يتم لفحص أعضاء البطن)",
 "開腹術": "بضع البطن, فتح البطن (شق جراحي في جدار البطن؛ غالباً ما يتم لفحص أعضاء البطن)",
 "開花": "مُزهر (عندما يكون النبات في حالة امتلاك زهرة واحدة أو متعددة و/أو براعم) / إزهار, تفتح الزهور (وقت وعملية تبرعم وتفتح الزهور) / ازدهار, تفتح (عملية تنموية)\nمثال: نبات مزهر",
 "開花期": "إزهار, تفتح الزهور (وقت وعملية تبرعم وتفتح الزهور)",
 "開裂": "شطر, فلق (عملية الفلق أو الشق) / شق الصدر, فلق الصدر (الخط المتشكل من أخدود بين جزأين (خاصة الفاصل بين ثديي المرأة)) / تفلج, تقطع ((علم الأجنة) الانقسام المتكرر للبويضة المخصبة) / انشطار, انقسام (كسر رابطة كيميائية في جزيء مما يؤدي إلى جزيئات أصغر)",
 "開設": "تَأْسِيس / مُؤَسَّسَة",
 "開設者": "مُؤَسِّس, مُؤَسِّسَة",
 "開豁": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "開通": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "開鑿": "استخراج المعادن, تعدين (فعل استخراج الخامات أو الفحم وما إلى ذلك من الأرض) / تنيقب, حفر (فعل الحفر) / حفر, حفرية (حفرة في الأرض ناتجة عن الحفر) / حفرية, موقع أثري (موقع الاستكشاف الأثري)\nمثال: هناك حفر مثير للاهتمام يجري بالقرب من برينستون",
 "開閉器": "مِقْلَاد",
 "開閉機": "حَاجِز / عَقَبَة, حَاجِز",
 "開闢": "خِلْقَة, خَلْق / اِبْتِكَار, خَلْق / خَلْق (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق.",
 "開陳": "وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / دَوْلَة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / وِلَايَة (منطقة إدارية لها استقلالها الإداري والمعنوي؛ ويختلف المعنى من بلد لآخر كما يختلف من فترة زمنية لأخرى) / يُبْدِي\nمثال: لقد أزمت الوضع.",
 "開音節": "مقطع مفتوح (مقطع صوتي ينتهي بصائت أو حرف لين)",
 "開頭": "حج القحف (القَصْد والزِيَارَة على جهة التَعْظِيم؛ زيارة مكان مُقَدَّس بهدف ديني ويوجد عند معظم الديانات منها اليَهُودِيَّة والمَسِيحِيَّة والإسْلام)\nمثال: ذهب رجل للحج وترك خلفه خمس بنات وكلبة.",
 "開頭手術": "حج القحف (القَصْد والزِيَارَة على جهة التَعْظِيم؛ زيارة مكان مُقَدَّس بهدف ديني ويوجد عند معظم الديانات منها اليَهُودِيَّة والمَسِيحِيَّة والإسْلام)\nمثال: ذهب رجل للحج وترك خلفه خمس بنات وكلبة.",
 "開頭術": "حج القحف (القَصْد والزِيَارَة على جهة التَعْظِيم؛ زيارة مكان مُقَدَّس بهدف ديني ويوجد عند معظم الديانات منها اليَهُودِيَّة والمَسِيحِيَّة والإسْلام)\nمثال: ذهب رجل للحج وترك خلفه خمس بنات وكلبة.",
 "開館": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "閏": "انسداد وعائي, انصمام (انسداد وعاء دموي بواسطة صمة (جلطة دموية أو فقاعة هواء أو جسيم آخر)) / إقحام, كبس (إدراج في التقويم (مثل يوم كبيس))",
 "閏年": "سَنَة كَبِيسَة (مقدارُ قطع الشمس البروجَ الاثني عشر ، وهي السنة الشمسيَّة، و السَّنَةُ تمامُ اثنتَيْ عشرةَ دَورةً للقمر ، وهي السنة القمرية…)\nمثال: في عمره 24 سنة.",
 "閏日": "29 فبراير, يوم كبيس (اسم اليوم الذي يُضاف خلال السنة الكبيسة)",
 "閏秒": "ثانية كبيسة (ثانية (كما تقاس بالساعة الذرية) تضاف أو تطرح من توقيت غرينتش للتعويض عن التباطؤ في دوران الأرض)",
 "閑": "وقت الفراغ, وقت حر (الوقت الخالي من الواجبات أو المسؤوليات) / وقت حر, وقت فراغ (الوقت المتاح للهوايات والأنشطة الأخرى التي تستمتع بها) / رَاكِد, سَاجٍ ((عَنْ جِسْمٍ مَائِيّ) خَالٍ مِنَ الاضْطِرَاب بِسَبَب الأَمْوَاج الكَبِيرَة) / سَاكِن, هَادِئ (غير مضطرب؛ يحافظ على ضبط النفس)",
 "閑々": "بِهُدُوء",
 "閑人": "عاطل, كسول (شخص لا يقوم بأي عمل)\nمثال: متشرد كسول",
 "閑処": "مِرْحَاض, تواليت",
 "閑却": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / إهمال, تقصير (سمة إهمال المسؤوليات ونقص الاهتمام)",
 "閑古鳥": "وَقْوَاق, وَقْوَاقِيَّة",
 "閑寂": "صَامِت, هَادِئ",
 "閑所": "مِرْحَاض, تواليت",
 "閑散": "مَهْجُور / خَامِد / عَاطِل عَن اَلْعَمَل",
 "閑文字": "كلام فارغ, هراء (خطابة فارغة أو حديث غير صادق أو مبالغ فيه)\nمثال: هذا الكثير من الهراء",
 "閑日月": "خُلُو مِن اَلْعَمَل / رَاحَة, خُلُو مِن اَلْعَمَل",
 "閑暇": "خُلُو مِن اَلْعَمَل / رَاحَة, خُلُو مِن اَلْعَمَل",
 "閑職": "عاطل, كسول (شخص لا يقوم بأي عمل)\nمثال: متشرد كسول",
 "閑話": "ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة)",
 "閑語": "ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة)",
 "閑談": "ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة)",
 "閑閑": "بِهُدُوء",
 "閑雅": "رَاقٍ, مُهَذَّب (يوحي بالذوق الرفيع واليسر والثراء) / مُحَسَّن, مُنَقَّح (دقيق إلى درجة رفيعة من الإحكام) / راق, مصقول ((للأشخاص وسلوكهم) مثقف ومهذب) / مكرر, منقى (منقى من الشوائب عن طريق المعالجة)\nمثال: كانت رقيقة ومهذبة وغير معتادة على المشقة",
 "閑静": "صَامِت, هَادِئ",
 "間": "فَرَاغ, مَكَان / فَضَاء (فَضَاء) / مَسَافَة\nمثال: الفضاء مليئ بالغموض. / فترة, فترة زمنية (مقدار من الزمن)\nمثال: فترة زمنية تمتد لثلاثين عاماً / بَيْنَ (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك. / مِنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / فَرَاغ, مَكَان / فَضَاء (فَضَاء) / مَسَافَة\nمثال: الفضاء مليئ بالغموض. / فَضاء (فَضَاء) / غُرْفَة, حُجْرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الفضاء مليئ بالغموض. / فَاصِل / مُدَّة, فَتْرَة / مَسَافَة / مِنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / فُرْصَة / اغتراب, جفاء (الشعور بالغربة عن الآخرين) / اغتراب, نفرة (الانفصال الناتج عن العداء) / مدى الرؤية, مرمى البصر (نطاق الرؤية أو المعرفة) / مدارك, نطاق المعرفة (نطاق ما يمكن للمرء معرفته أو فهمه)\nمثال: بعيدًا عن مرأى اليابسة",
 "間々": "أَحْيَانًا",
 "間がいい": "مَحْظُوظ, جَالِب للحَظّ",
 "間がよい": "مَحْظُوظ, جَالِب للحَظّ",
 "間がら": "عَلَاقَة, مُنَاسَبَة / صِلَة, عَلَاقَة",
 "間が悪い": "غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غَيْرُ مُنَاسِب, مُحْرِج (يُسَبِّبُ الإِزْعَاجَ أَوْ عَدَمَ الارْتِيَاح) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / ثَقِيل الأُسْلُوب, رَكِيك (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الرَّشَاقَة فِي التَّعْبِير) / غير ملائم, مزدحم (غير مناسب لراحتك أو غرضك أو احتياجاتك) / غَيْر مُرِيح, غَيْر مُلَائِم (ذو توقيت غير مريح أو مناسب)\nمثال: من غير الملائم عدم وجود هاتف في المطبخ",
 "間が良い": "مَحْظُوظ, جَالِب للحَظّ",
 "間じゅう": "خِلَالَ, فِي",
 "間ずっと": "طَوَال",
 "間にあう": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "間にある": "فَاصِل, وَاقِعٌ بَيْنَ (يحدث أو يقع بين أحداث أو نقاط زمنية)",
 "間に入る": "تَدَخَّلَ",
 "間に合い": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "間に合う": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "間に合せ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "間に合わせ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "間に立つ": "بواسطة, غير مباشر (يعمل من خلال أو يعتمد على وكالة أو وسيط متدخل) / مُتَوَسِّط, وَسَطِيّ (لَيْسَ فِي البِدَايَةِ وَلَا فِي النِّهَايَةِ ضِمْنَ سِلْسِلَةٍ)\nمثال: انتشر المرض عن طريق الاتصال غير المباشر (بواسطة) وكذلك المباشر",
 "間のいい": "مَحْظُوظ, جَالِب للحَظّ",
 "間のび": "بطء, تأنٍ (معدل يظهر غياب العجلة أو التسرع) / تأخر, تخلف عقلي (نقص في التطور الطبيعي للقدرات الفكرية) / خرق, عدم براعة (عدم المهارة الناتج عن نقص التدريب) / انحلال, فجور (انغماس منحل في الملذات الحسية) / تَخَلْخُل, حَرَكَة حُرَّة (حركة أو مساحة للحركة (خاصة في الأجزاء الميكانيكية)) / انْفِلَات, تَحَرُّر (صفة قابلية الحركة بحكم التحرر من الارتباط أو القيود الأخرى) / تَرَاخٍ, تَسَيُّب (نقص الدقة الصارمة؛ التساهل في الممارسة)\nمثال: كان هناك الكثير من التخلخل في عجلة القيادة",
 "間のよい": "مَحْظُوظ, جَالِب للحَظّ",
 "間の子": "هجين ((في علم الوراثة) كائن حي هو نسل أبوين أو سلالة غير متماثلة وراثياً؛ خاصة النسل الناتج عن تزاوج نباتات أو حيوانات من أصناف أو سلالات أو أنواع مختلفة)\nمثال: البغل هو هجين بين حصان وحمار / هَجِين",
 "間の手": "فاصل, فقرة بينية (عرض قصير (موسيقى أو رقص وما إلى ذلك) يُدرج بين أقسام عرض أطول) / فاصل, فترة بينية (فترة أو حلقة فاصلة) / حَرْف نِدَاء (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء.",
 "間の抜けた": "عَبِيط",
 "間の楔": "إِسْفِين (عبارة عن وَتَد أو قطعة من الخَشَب أو الحَدِيد تستخدم في البِنَاء والنِجَارَة بلإبقاء على فُرْجَة بين الأجسام، خصوصا ألواح الخشب، أو لتكوين هذه الفرجة؛ دَقَّ بينهم إسفينا: فَرَّقَ بينهم) / وَتِد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / وَتَد (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل.",
 "間の良い": "مَحْظُوظ, جَالِب للحَظّ",
 "間びき": "تقليم (عملية تشذيب النبات) / قُلامَة (ما تم تقليمه وقصه من النبات) / قتل الرضيع, وأد (قتل طفل رضيع) / قاتل الرضيع (شخص يقتل رضيعاً)",
 "間もない": "عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "間もなく": "قَرِيبًا, سَرْعَانَ مَا",
 "間も無く": "قَرِيبًا, سَرْعَانَ مَا",
 "間をとる": "تَوَقَّفَ / تَوَقُّف, وَقْف",
 "間を取る": "تَوَقَّفَ / تَوَقُّف, وَقْف",
 "間を持たす": "مَعْلِف, مُرَاح / بَسْطة",
 "間を持たせる": "مَعْلِف, مُرَاح / بَسْطة",
 "間を置いて": "بشكل متقطع, على فترات (بطريقة متقطعة)\nمثال: استجوبنا البارومتر بشكل متقطع",
 "間を置く": "تَوَقَّفَ / تَوَقُّف, وَقْف",
 "間一髪": "شعرة, قيد شعرة (مسافة أو مساحة صغيرة جداً)\nمثال: نجوا بشق الأنفس (بقدر شعرة)",
 "間一髪のところ": "فوز بشق الأنفس, نجاة بأعجوبة (شيء تم تحقيقه (أو الهروب منه) بفارق ضئيل)",
 "間一髪の所": "فوز بشق الأنفس, نجاة بأعجوبة (شيء تم تحقيقه (أو الهروب منه) بفارق ضئيل)",
 "間一髪を入れず": "فَوْرًا, حَالًا",
 "間中": "خِلَالَ, فِي",
 "間代": "رمع (تشنج يتميز بتقلصات واسترخاءات متناوبة)",
 "間作": "محصول بيني, محصول مؤقت (محصول ينمو بسرعة (مثل الخس) ويمكن زراعته بين محصولين عاديين يزرعان في مواسم متتالية أو بين صفين من المحاصيل في نفس الموسم)",
