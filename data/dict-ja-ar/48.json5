 "銀行家": "مَصْرَفِيّ, بَنْكِيّ",
 "銀行強盗": "سارق بنوك (لص يسرق البنوك)",
 "銀行業": "أعمال مصرفية, معاملات بنكية (إجراء الأعمال مع بنك؛ إيداع أو سحب الأموال أو طلب قرض، إلخ) / أعمال مصرفية (ممارسة الأعمال التجارية المتمثلة في حفظ الأموال لحسابات التوفير والحسابات الجارية أو للصرف أو لإصدار القروض والائتمان، إلخ)",
 "銀行融資": "قرض بنكي, قرض مصرفي (قرض يمنحه مصرف؛ يسدد مع الفائدة في تاريخ محدد أو قبله)",
 "銀行預金": "وديعة (أموال مودعة في بنك أو مؤسسة مماثلة)",
 "銀賞": "فضية, ميدالية فضية (كأس مصنوعة من الفضة (أو لها مظهر الفضة) تمنح عادة للفائز بالمركز الثاني في المسابقة)",
 "銀輪": "عجلة دراجة (عجلة الدراجة الهوائية)",
 "銀鈴": "جرس فضي, هاليزية (أي من الأشجار المتساقطة الأوراق المختلفة من جنس هاليزية ذات زهور بيضاء على شكل جرس)",
 "銀鉱": "منجم فضة (منجم يُستخرج منه خام الفضة)",
 "銀鍍金": "فِضَّة (فِي : فِلِزّ أَبْيَض قَابِلٌ لِلسَّحب والطَّرْق والصَّقْل، من أكثر المواد توصيلاً للحَرَارَة والكَهْرَبَاء…) / فِضِّيّ, لُجَيْن\nمثال: يقدر القبايل الفضة أكثر من الذهب.",
 "銀鑞": "لحام صلد (سبيكة لحام تحتوي على النحاس؛ تنصهر عند درجة حرارة عالية نسبياً؛ تستخدم في اللحام بالنحاس)",
 "銀食器": "أواني فضية (أدوات مائدة مصنوعة من الفضة أو الفضة المطلية أو البيوتر أو الفولاذ المقاوم للصدأ)",
 "銀鮭": "سلمون فضي, سلمون كوهو (سلمون صغير من سواحل شمال المحيط الهادئ والبحيرات العظمى) / سلمون فضي, سلمون كوهو (لحم وردي دهني لسلمون صغير يتم اصطيده في المحيط الهادئ والبحيرات العظمى)",
 "銀鯵": "سمكة لوك داون (تشبه سمكة القمر ولكن عيونها مرتفعة على الجبهة المقطوعة)",
 "銀鱗": "سَمَكَة, سَمَك (مصطلح شمولي لأي حيوان فقاري مائي خيشومي التنفس) / سَمَك, سمك (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك) / صَادَ\nمثال: سمكة ميناد ماتت",
 "銀鼠": "رمادي رمادي, فضي (درجة فاتحة من الرمادي)",
 "銃": "مُسَدَّس, طَبَنْجَة (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ) / مِدْفَع (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)\nمثال: كان عند زيري مسدس.",
 "銃丸": "رَصَاصَة, رَصَاص",
 "銃剣": "حَرْبَة, سُونْكِيّ (آلة للحَرْب تكون قصيرة مُحَدَّدة الرَأس تستخدم للطَعْن. غالبا ما تُرَكَّب على غيرها مثل الرُمْح أو البُنْدُقِيَّة. الجمع حِرَاب وحَرْبَات؛ رأس حَرْبَة: تعبير مجازيّ يقصد به شيء يستخدم لتهديد العَدُو)",
 "銃口": "خَطْم (وضع الخِطام على الدابة أو الحيوان؛ أخذ الشيء بقوة أو سيطرة) / خِطَام, كِمَامَة",
 "銃士": "مُسْكِيتِيّ",
 "銃尾": "مؤخرة الماسورة (فتحة في مؤخرة ماسورة البندقية حيث يمكن تحميل الرصاص)",
 "銃床": "جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل.",
 "銃座": "تحديد الموقع, تمركز (فعل وضع شيء ما في مكان معين) / موضع سلاح (منشأة عسكرية تتكون من موقع مجهز لوضع سلاح)",
 "銃弾": "رَصَاصَة, رَصَاص",
 "銃弾跡": "ثقب رصاصة (ثقب أحدثته رصاصة مرت من خلاله)",
 "銃後": "الجبهة الداخلية (السكان المدنيون (وأنشطتهم) لبلد في حالة حرب)",
 "銃手": "جندي المدفعية, مدفعي (جندي يخدم في سلاح المدفعية) / رامي, مسلح (شخص يطلق النار بمسدس (فيما يتعلق بقدرته))",
 "銃撃": "رِمَايَة",
 "銃撃戦": "تَبَادُل إِطْلَاق نَار, مَعْرَكَة بِالأَسْلِحَة النَّارِيَّة (قتال يتضمن إطلاق أسلحة صغيرة بقصد القتل أو التخويف)",
 "銃撃犯": "رامٍ, مسلح (شخص ذكر يطلق النار من مسدس (فيما يتعلق بقدرته)) / قاتل مأجور, مسلح (قاتل محترف ذكر يستخدم مسدساً)",
 "銃火": "إطلاق نار, نيران (فعل إطلاق النار من سلاح)\nمثال: عرض إطلاق النار المارة الأبرياء للخطر",
 "銃火器": "سِلَاح نَارِيّ",
 "銃猟": "رِمَايَة",
 "銃痕": "ثقب رصاصة (ثقب أحدثته رصاصة مرت من خلاله)",
 "銃眼": "فتحة الرمي, مزغل (ثقب صغير في جدار محصن؛ للمراقبة أو إطلاق الأسلحة) / ثغرة (غموض (خاصة في نص قانون أو عقد) يجعل من الممكن التهرب من صعوبة أو التزام)",
 "銃砲": "مُسَدَّس, طَبَنْجَة (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم تكن متساوية سميّ بالسُدَاسِيّ) / مِدْفَع (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)\nمثال: كان عند زيري مسدس.",
 "銃規制": "الرقابة على السلاح, ضبط الأسلحة (جهود لتنظيم أو السيطرة على مبيعات الأسلحة)",
 "銃身": "سبطانة, ماسورة البندقية (أنبوب تمر من خلاله الرصاصة عند إطلاق النار من السلاح)",
 "銅": "نُحَاس, نحاس (في : عنصرْ فِلزيّ قابل للطَّرْق ، يوصَف عادة بالأحمر لقرب لونه من الحمرة؛ ما سقَط من شرر الصُّفْر أو الحدود إِذا طُرق)\nمثال: هي تصهر النحاس. / بُرُنْزٌ, فِلِزّ / بُرُنْزِيٌّ",
 "銅メダル": "ميدالية برونزية (كأس مصنوعة من البرونز (أو لها مظهر البرونز) تمنح عادة للفائز بالمركز الثالث في المسابقة)",
 "銅器": "أواني نحاسية, نحاسيات (أواني مصنوعة من النحاس)",
 "銅山": "منجم نحاس (منجم يُستخرج منه النحاس من الأرض)",
 "銅版": "لوحة نحاسية (نقص يتكون من صفيحة ملساء من النحاس تم حفرها أو نقشها) / نقش نحاسي (مطبوعة مصنوعة من صفيحة نحاسية منقوشة) / خط نحاسي, كوبربليت (أسلوب رشيق من الكتابة اليدوية يعتمد على الكتابة المستخدمة في النقوش على الألواح النحاسية)",
 "銅版画": "لوحة نحاسية (نقص يتكون من صفيحة ملساء من النحاس تم حفرها أو نقشها)",
 "銅牌": "ميدالية برونزية (كأس مصنوعة من البرونز (أو لها مظهر البرونز) تمنح عادة للفائز بالمركز الثالث في المسابقة)",
 "銅羅": "جَرَس, نَاقُوس (جَرَسَ الطَّائِرُ: صَوَّتَ؛ جَرَسَ الكَلاَمَ: نَغَمَ بِهِ وَتَكَلَّمَ)\nمثال: ياني يرن الجرس.",
 "銅色": "نحاسي (لون بني محمر يشبه لون النحاس المصقول)",
 "銅賞": "ميدالية برونزية (كأس مصنوعة من البرونز (أو لها مظهر البرونز) تمنح عادة للفائز بالمركز الثالث في المسابقة)",
 "銅鐸": "جَرَسِيُّ الشَّكْل, نَاقُوسِيّ (ذو شكل محدّب يشبه الجرس)",
 "銅鑼": "جَرَس, نَاقُوس (جَرَسَ الطَّائِرُ: صَوَّتَ؛ جَرَسَ الكَلاَمَ: نَغَمَ بِهِ وَتَكَلَّمَ)\nمثال: ياني يرن الجرس.",
 "銑": "حديد غفل (مَعْدِن صَلْب قَوِيّ يستخرج من الأرض له ألوان تتراوح بين الرَمَاديّ والأسْوَد)\nمثال: حملت الحديد فلم أجد أثقل من الدين.",
 "銑鉄": "حديد غفل (مَعْدِن صَلْب قَوِيّ يستخرج من الأرض له ألوان تتراوح بين الرَمَاديّ والأسْوَد)\nمثال: حملت الحديد فلم أجد أثقل من الدين.",
 "銘": "نَقْش (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان) / شِعَار (العلامة: وذلك من شعار العقلاء (مادة حلم من مجمع بحار الأنوار))\nمثال: الشعار ☭ هو رمز الشيوعية.",
 "銘々": "كُلّ\nمثال: 生徒はめいめい自分の机を持っている。 — كل طالب لديه مقعد خاص به.",
 "銘じる": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "銘する": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "銘ずる": "خَتْم (أنهى الشيءَ وأتمّه؛ طبع بخاتم أو ختم رسميّ) / طَابَع\nمثال: ختم سامي القرآن في شهر رمضان.",
 "銘店": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "銘打つ": "دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين.",
 "銘文": "نَقْش (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "銘板": "لوحة الاسم (لوحة تحمل اسماً)",
 "銘柄": "عَلَامَة, شِعَار (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / مَارْكَة\nمثال: تحصلت على علامة أ. / عَدَد (مِقْدَار مَا يُعَدّ) / مُشْكِل, مَسْأَلَة\nمثال: كم عدد سكان الجزائر؟",
 "銘版": "بصمة, طبعة (أثر أو علامة تنتج عن الضغط على سطح ما) / أثر, بصمة (تأثير مميز) / بصمة, نقش بارز (انطباع ناتج عن الضغط أو الطباعة) / بصمة الناشر, بيان النشر (تعريف للناشر؛ اسم الناشر مع التاريخ والعنوان والطبعة المطبوعة في أسفل صفحة العنوان)\nمثال: لا تزال اللغة الإنجليزية تحمل بصمة الغزو النورماندي",
 "銘記": "تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / اِسْتَذْكَرَ\nمثال: ليلى تذكر سامي.",
 "銘酒屋": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "銘銘": "كُلّ\nمثال: 生徒はめいめい自分の机を持っている。 — كل طالب لديه مقعد خاص به.",
 "銚子": "دورق, قنينة (زجاجة ذات سدادة؛ لتقديم النبيذ أو الماء)",
 "銛": "مشرط (سكين جراحي بشفرة مدببة ذات حدين؛ يستخدم للثقب والشقوق الصغيرة) / رمح (قضيب طويل مدبب يستخدم كأداة أو سلاح) / حربة صيد, رمح الصيد (أداة ذات عمود ورأس شائك تستخدم لصيد الأسماك)",
 "銜": "بِت (انقطع؛ قَطَع)",
 "銜む": "اِحْتَوَى, تَضَمَّنَ / اِحْتَوَى / ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة. / عَبَّرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "銭": "سن (وحدة نقدية كسرية لليابان وإندونيسيا وكمبوديا؛ تساوي واحداً من المائة من الين أو الروبية أو الرييل) / جُزْء مِن أَلْف, وَاحِد بِالأَلْف (جزء واحد من ألف جزء متساوي) / نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال.",
 "銭ころ": "نَقْد, نُقُود",
 "銭使い": "مصروف الجيب (نقد للإنفاق اليومي على المصاريف العرضية)",
 "銭入れ": "حَتَّى, إِلَى أَنّ (يفيد انتهاء الغاية؛ يفيد الغاية) / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: انتظر حتى أجلس.",
 "銭失い": "هدر المال (المال الذي ينفق مقابل عائد غير كاف)\nمثال: قال السناتور إن المشروع كان هدراً للمال",
 "銭形海豹": "فقمة الميناء, فقمة شائعة (فقمة مرقطة صغيرة تعيش في المياه الساحلية لنصف الكرة الشمالي)",
 "銭湯": "حَمَّام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق)\nمثال: هل الحمام جاهز؟",
 "銭苔": "حشيشة الكبد (أي من النباتات اللاوعائية الخضراء الصغيرة العديدة من طائفة الكبدية تنمو في الأماكن الرطبة وتشبه الأعشاب البحرية الخضراء أو الحزازيات الورقية)",
 "銭葵": "خبازة شائعة (نبات حولي من العالم القديم بعناقيد من الزهور الوردية أو البيضاء؛ توطن في الولايات المتحدة)",
 "銭貨": "قِرْش, عُمْلَة",
 "銭貨学": "جمع العملات, علم العملات (جمع ودراسة النقود (والعملات المعدنية بشكل خاص))",
 "銭遣い": "مصروف الجيب (نقد للإنفاق اليومي على المصاريف العرضية)",
 "銭金": "نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال.",
 "銷する": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / تَخَلَّصَ ؛ مِن / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "銷夏": "صَيْف, صيف (فصل من فصول السنة الأربعة، يلي الرَّبِيع ويأتي بعده الخَرِيف، يتميز بشدة الحَرّ)\nمثال: نأتي هنا كل صيف.",
 "銹病": "صَدَأ / صَدَّأَ",
 "銹菌": "صَدَأ / صَدَّأَ",
 "鋏": "مِقَصّ, مِقْرَاض / خَرَّامَة, خَرَّامَة وَرَق / كَلْبَتَان",
 "鋏む": "مِشْبَك / كْلِيبْ",
 "鋏を入れる": "شَذَّبَ, قَلَّمَ / لَكْمَة / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة) / خَرَّامَة\nمثال: لكم اشتقت إليك!",
 "鋏虫": "أَبُو مِقَصّ",
 "鋏角": "قرن كلابي (أحد الزوج الأول من الزوائد الشبيهة بالأنياب بالقرب من فم العناكب؛ غالباً ما تكون معدلة للإمساك والثقب)",
 "鋏角類": "كلابي (من أو متعلق بـ أو يشبه الكلابات (أجزاء فم العناكب))",
 "鋒": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / ذُو مِقْبَض طَوِيل (لَهُ مِقْبَض أَوْ يَد طَويلَة) / سِلَاح, أَسْلِحَة",
 "鋒先": "طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "鋤": "مِجْرَفَة, مِجْرَف / الْبَسْتُونِيّ / مِحْرَاث / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: حرث المزارع أرضه.",
 "鋤き返す": "مِحْراث (أداة زراعية ذات شفرة ثقيلة أو أكثر لقلب التربة وشق أخدود قبل البذر)",
 "鋤く": "مِحْرَاث / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: حرث المزارع أرضه.",
 "鋤足蛙": "علجوم قدم المجرفة (علجوم حفار من نصف الكرة الشمالي ببروز قرني يشبه المجرفة على كل قدم خلفية)",
 "鋤返す": "مِحْراث (أداة زراعية ذات شفرة ثقيلة أو أكثر لقلب التربة وشق أخدود قبل البذر)",
 "鋤骨": "عظم الميكعة, ميكعة (عظم شبه منحرف رقيق للجمجمة يشكل الأجزاء الخلفية والسفلية من الحاجز الأنفي)",
 "鋪": "دُكَّان, مَتْجَر (حانوت أو محل بيع؛ مصطبة يُقعد عليها) / تَسَوَّقَ, تَبَضَّعَ\nمثال: ذهب إلى الدكان. / بئر المنجم (حفر يتكون من ممر عمودي أو مائل للعثور على الخام أو تعدينه أو لتهوية المنجم)",
 "鋭": "حدة, خشونة (قسوة في الأسلوب) / تَمَايُز, حِدَّة (صفة كون الشيء حاداً وواضحاً) / حدة (رقة الحافة أو دقة الطرف) / حدة (صفة الشعور بالشيء بحدة وألم شديد)\nمثال: حدة خسارتها / نَصْل (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة الحادّة الجارحة)\nمثال: لن نصل إلى أي مكان.",
 "鋭い": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة. / سَنِين, مُرْهَف (له حافة قاطعة أو رأس حادّ) / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / حَادّ, لَاذِع (شَدِيدُ الحِدَّةِ وَالوَطْأَة)",
 "鋭し": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة. / شَدِيد / سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي. / سَنِين, مُرْهَف (له حافة قاطعة أو رأس حادّ) / طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / حَادّ, لَاذِع (شَدِيدُ الحِدَّةِ وَالوَطْأَة)",
 "鋭アクセント": "نَبْرَة حَادَّة",
 "鋭先形": "مُسْتَدَقّ الطَّرَف ((عن شكل الورقة) يضيق تدريجيًّا إلى طرف رفيع مُدبَّب)",
 "鋭利": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة.",
 "鋭尖形": "مُسْتَدَقّ الطَّرَف ((عن شكل الورقة) يضيق تدريجيًّا إلى طرف رفيع مُدبَّب)",
 "鋭形": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / شَدِيد\nمثال: عندك ذاكرة حادة.",
 "鋭意": "بشوق, بلهفة\nمثال: كانت الأخبار منتظرة بلهفة",
 "鋭感": "تأثر, حساسية (القدرة على الاستجابة للتغيرات الوجدانية في البيئة الشخصية) / حساسية (القدرة على الاستجابة للمحفزات الفيزيائية أو تسجيل كميات فيزيائية صغيرة أو فروق) / تحسس, حساسية ((علم وظائف الأعضاء) الاستجابة للمحفزات الخارجية؛ ملكة الإحساس) / حساسية (الحساسية للمشاعر العاطفية (للذات وللآخرين))\nمثال: جلفانومتر ذو حساسية شديدة",
 "鋭敏": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة. / حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء.",
 "鋭気": "شَجَاعَة, جَسَارَة",
 "鋭角": "زَاوِيَة حَادَّة",
 "鋭角三角形": "مُثَلَّث حَادّ الزَّوَايَا",
 "鋭角的": "ذو زوايا, زاوي (له زوايا أو شكل زاوي) / زاوي (يقاس بواسطة زاوية أو بمعدل تغير الزاوية)\nمثال: زخم زاوي",
 "鋭頭": "حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ) / شَدِيد\nمثال: عندك ذاكرة حادة.",
 "鋲": "بِرْشَام (برشم المسمار و نحوه؛ دق رأسه بعد نفاذه دقا شديدا ليتفلطح الرأس)",
 "鋲打ち機": "آلة برشمة (آلة لدق المسامير) / عامل برشمة, مُبَرْشِم (عامل يقوم بإدخال وطرق المسامير البرشامية)",
 "鋲締め機": "آلة برشمة (آلة لدق المسامير) / عامل برشمة, مُبَرْشِم (عامل يقوم بإدخال وطرق المسامير البرشامية)",
 "鋲釘": "بِرْشَام (برشم المسمار و نحوه؛ دق رأسه بعد نفاذه دقا شديدا ليتفلطح الرأس)",
 "鋳る": "صَبَّ, رَمَى (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون) / ضِمَاد مِنَ الْجِبْس\nمثال: صب الشاي لضيفك.",
 "鋳型": "قَالِب / سَنَّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين) / تَعَفُّن, عُفُونَة\nمثال: هم في نفس السن.",
 "鋳塊": "سبيكة",
 "鋳掛": "ماكريل تشوب (ماكريل صغير يوجد في جميع أنحاء العالم تقريباً) / سمكري متجول (قديماً، شخص (غالباً غجري) يسافر من مكان لآخر لإصلاح الأواني والمقالي وغيرها من الأواني المعدنية كوسيلة لكسب العيش) / عَابِث بِالْآلَات, مُصْلِح هَاوٍ (شخص يستمتع بإصلاح وتجربة الآلات وأجزائها)",
 "鋳掛け": "ماكريل تشوب (ماكريل صغير يوجد في جميع أنحاء العالم تقريباً) / سمكري متجول (قديماً، شخص (غالباً غجري) يسافر من مكان لآخر لإصلاح الأواني والمقالي وغيرها من الأواني المعدنية كوسيلة لكسب العيش) / عَابِث بِالْآلَات, مُصْلِح هَاوٍ (شخص يستمتع بإصلاح وتجربة الآلات وأجزائها)",
 "鋳掛け屋": "ماكريل تشوب (ماكريل صغير يوجد في جميع أنحاء العالم تقريباً) / سمكري متجول (قديماً، شخص (غالباً غجري) يسافر من مكان لآخر لإصلاح الأواني والمقالي وغيرها من الأواني المعدنية كوسيلة لكسب العيش) / عَابِث بِالْآلَات, مُصْلِح هَاوٍ (شخص يستمتع بإصلاح وتجربة الآلات وأجزائها)",
 "鋳掛屋": "ماكريل تشوب (ماكريل صغير يوجد في جميع أنحاء العالم تقريباً) / سمكري متجول (قديماً، شخص (غالباً غجري) يسافر من مكان لآخر لإصلاح الأواني والمقالي وغيرها من الأواني المعدنية كوسيلة لكسب العيش) / عَابِث بِالْآلَات, مُصْلِح هَاوٍ (شخص يستمتع بإصلاح وتجربة الآلات وأجزائها)",
