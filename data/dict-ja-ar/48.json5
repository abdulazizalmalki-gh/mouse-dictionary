 "藤髙": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "藤黄": "أصفر ليموني, ليموني (لون أصفر قوي) / غامبوج (صمغ راتنجي يُستخدم كصبغة صفراء ومسهل)",
 "藩": "أُسْرَة هَان / هَان, قَوْمِيَّة اَلْهَان",
 "藩主": "إقطاعي, سيد إقطاعي (رجل ذو رتبة في النظام القديم)",
 "藩侯": "إقطاعي, سيد إقطاعي (رجل ذو رتبة في النظام القديم)",
 "藩屏": "سُور / سِيَاج",
 "藩屛": "سُور / سِيَاج",
 "藩札": "بنكنوت, نقود ورقية (عملة تصدرها حكومة أو بنك مركزي وتتكون من ورق مطبوع يمكن تداوله كبديل للنقود المعدنية)",
 "藩王": "مَاهَارَاجَا",
 "藪": "عَرِين (اِسْمٌ لِمَاْوَى الأَسَد) / بَطْبَطَة, زَبْط / زَبَطَ",
 "藪から棒に": "فَجْأَةً, عَلَى حِينِ غِرَّةٍ",
 "藪こぎ": "مُتَرَبِّصٌ فِي كَمِين (يكمن في انتظار الفريسة أو العدوّ)",
 "藪にらみ": "بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب) / تحديق بعينين مغلقتين جزئياً, حول (فعل النظر بعينين مغلقتين جزئياً) / حول (محاذاة غير طبيعية لإحدى العينين أو كلتيهما)",
 "藪ワラビー": "باديميلون (ولب بني محمر صغير يعيش في المناطق الشجرية في أستراليا وغينيا الجديدة)",
 "藪上": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "藪医": "بَطْبَطَة, زَبْط / زَبَطَ",
 "藪漕ぎ": "مُتَرَبِّصٌ فِي كَمِين (يكمن في انتظار الفريسة أو العدوّ)",
 "藪睨み": "بِطَرْف العَيْن, مُنْحَرِف النَّظْرَة ((خَاصَّةً عَنِ النَّظَرَات) مُوَجَّه إِلَى جَانِبٍ بِشَكٍّ أَوِ ارْتِيَاب) / تحديق بعينين مغلقتين جزئياً, حول (فعل النظر بعينين مغلقتين جزئياً) / حول (محاذاة غير طبيعية لإحدى العينين أو كلتيهما)",
 "藪知らず": "مَتَاهَة",
 "藪蘭": "بيج بلو (قنبلة متشظية موثوقة وفتاكة تزن 15000 رطل تنفجر فوق الأرض مباشرة بنصف قطر كبير؛ وهي أكبر قنبلة تقليدية موجودة؛ استخدمت في أفغانستان)",
 "藪野兎": "أرنب بري أوروبي (أرنب بري كبير أُدخل في أمريكا الشمالية؛ لا يتحول إلى الأبيض في الشتاء)",
 "藹々": "مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً) / زَاخِر, فَيَّاض (يُنتَج أو ينمو بوَفْرة بالغة) / أَبِيقُورِيّ, مُتَرَفّ (يعرض الترف ويُمتِّع الحواسّ) / مُتَقَن, مُفَصَّل (يتميز بتعقيد وثراء في التفاصيل)",
 "藹然": "مُؤَدَّب",
 "藹藹": "مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً) / زَاخِر, فَيَّاض (يُنتَج أو ينمو بوَفْرة بالغة) / أَبِيقُورِيّ, مُتَرَفّ (يعرض الترف ويُمتِّع الحواسّ) / مُتَقَن, مُفَصَّل (يتميز بتعقيد وثراء في التفاصيل)",
 "藺": "أسل شائع, سمار ناعم (أسل طويل بسيقان ناعمة منتصبة أو مقوسة يوجد في أوراسيا وأستراليا ونيوزيلندا وشائع في أمريكا الشمالية)",
 "藺草": "أسل شائع, سمار ناعم (أسل طويل بسيقان ناعمة منتصبة أو مقوسة يوجد في أوراسيا وأستراليا ونيوزيلندا وشائع في أمريكا الشمالية)",
 "藻": "طحالب, طحلب (كائنات حقيقية النواة بدائية تحتوي على الكلوروفيل مائية بشكل أساسي تفتقر إلى السيقان والجذور والأوراق الحقيقية)",
 "藻塩草": "تَجْمِيعَة, دِيوَان",
 "藻草": "نبات مائي (نبات ينمو جزئياً أو كلياً في الماء سواء كان متجذراً في الطين، مثل اللوتس، أو عائماً دون تثبيت، مثل ورد النيل)",
 "藻類": "عُشْب بَحْرِيّ",
 "藻類学": "علم الطحالب (فرع علم النبات الذي يدرس الطحالب)",
 "蘂": "مِدَقَّة / سَدَاة",
 "蘆": "قصب الخنادق, قيصوب شائع (قصب طويل من أمريكا الشمالية له أوراق عريضة نسبياً وعناقيد كبيرة تشبه الريش؛ واسع الانتشار في المناطق الرطبة؛ يستخدم للحصير والستائر وأعمدة السهام)",
 "蘆毛": "رمادي مرقط (رمادي بنمط مرقط من علامات رمادية أغمق)",
 "蘆笛": "أنبوب قصبي (أنبوب أرغن بقصبة مهتزة)",
 "蘆荻": "قَصَبَة, بُوصَة",
 "蘆薈": "أَلْوَة, صَبْر",
 "蘇": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "蘇り": "قِيَامَة / سُورَةُ الْقِيَامَةِ",
 "蘇合香": "أَصْطَرَك, أَسْطَرَك",
 "蘇州": "سُوجُو",
 "蘇我": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "蘇油": "أَصْطَرَك, أَسْطَرَك",
 "蘇生": "إحياء, انبعاث (إعادة الشيء إلى النشاط والشهرة مرة أخرى) / إِحْيَاء دِينِيّ, اِجْتِمَاع نَهْضَة دِينِيَّة (اجتماع تبشيري يهدف إلى إيقاظ الاهتمام بالدين)\nمثال: انتعاش التجارة / إحياء, انبعاث (إعادة الشيء إلى النشاط والشهرة مرة أخرى)\nمثال: انتعاش التجارة",
 "蘇生術": "اِنْعَاش",
 "蘇連": "الْاِتِّحَادُ السُّوفْيَاتِيّ, الْاِتِّحَادُ السُّوفْيَتِيّ",
 "蘇部": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "蘇鉄": "سيكاس, نخيل الساغو (سيكاد قزم يشبه النخيل من اليابان ينتج الساغو) / نخيل الساغو (أي من أشجار نخيل آسيوية استوائية مختلفة تنتج جذوعها الساغو)",
 "蘊奥": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "蘚": "أُشْنَة, طُحْلُب",
 "蘚苔": "أُشْنَة, طُحْلُب",
 "蘚苔植物": "نبات طحلبي, نبات لا وعائي (أي من النباتات العديدة من قسم النباتات الطحلبيه)",
 "蘚類": "أُشْنَة, طُحْلُب",
 "蘞辛い": "حَارِق, لَاذِع (قاسٍ أو كاوٍ في اللهجة) / حِرِّيف, نَفَّاذ (قَوِيٌّ وَحَادُّ الطَّعْمِ أَوِ الرَّائِحَة)",
 "蘭": "أُورْكِيد, سَحْلَب / هُولَنْدَا, هُولَنْدَة / طقسوس ياباني (شجيرة دائمة الخضرة قوية من الصين واليابان لها أوراق خضراء داكنة لامعة؛ تزرع في شرق الولايات المتحدة) / جابر العظام, غافث مثقوب (عشب معمر في جنوب شرق الولايات المتحدة له رؤوس زهرية بيضاء الشعاع؛ كان يستخدم سابقاً في الطب الشعبي)",
 "蘭人": "هُولَنْدِيّ",
 "蘭国": "هُولَنْدَا, هُولَنْدَة",
 "蘭州": "لَانْغْتْشُو, لَانْغْجُو",
 "蘭画": "لَوْحَة زَيْتِيَة",
 "蘭語": "هُولَنْدِيّ",
 "蘿": "أُشْنَة, طُحْلُب / صنوبر أرضي, عجوقة صفراء (نبات حولي منخفض النمو بزهور صفراء منقطة بالأحمر؛ معطر برائحة خفيفة من راتنج الصنوبر؛ أوروبا والجزر البريطانية وشمال إفريقيا) / صنوبر أرضي (أي من عدة طحالب نادي ذات سيقان زاحفة طويلة وفروع منتصبة)",
 "蘿蔔": "فِجْل (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل للإشارة إلى تعريض شيء ما للآخرين أو جعله واضحًا؛ فجل - يفجل، فجلا، الكلمة مرتبطة بتغيير شكل الشيء ليصبح أوسع أو أكثر استرخاءً وغلظة) / دَايْكُون",
 "虎": "نِمْر (النّمر: حيوان مرقّط يُشبه الأَسَد؛ النّمر: لونه أنمر، وفيه نُمر حمراء أو بيضاء وسوداء) / بَبْر (حيوان ضخم مخطط من السّنوريّات. والببر يَختلف عن النَمِر، فالببر مخطط والنمر مرقّط) / نمر (النّمر: حيوان مرقّط يُشبه الأَسَد؛ النّمر: لونه أنمر، وفيه نُمر حمراء أو بيضاء وسوداء)\nمثال: دخل نمر مخيمنا. / سكير, مدمن خمر (شخص يشرب الخمر بشكل مزمن)",
 "虎の威を借る狐": "شخص صغير الحجم, ضئيل الجسم (شخص حجمه أقل من المتوسط)",
 "虎の子": "جرو النمر, فزر (نمر صغير)",
 "虎の尾": "ليسيماكيا عنق الإوزة (صنف من عشبة الليسيماكيا)",
 "虎の尾を踏む": "لَعِبَ بِالنَّار (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس.",
 "虎の巻": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا. / كريبج (لعبة ورق (عادة للاعبين اثنين) يتم فيها توزيع ست أوراق لكل لاعب ويتخلص من ورقة أو اثنتين) / المهملات (البطاقات التي يتخلص منها اللاعبون في لعبة الكريبج) / سرير أطفال, مهد (سرير أطفال ذو جوانب عالية مصنوعة من شرائح خشبية أو قضبان) / صومعة صغيرة, مخزن حبوب (صندوق أو مخزن لتخزين الحبوب)",
 "虎ばさみ": "فخ فولاذي (فخ مصنوع من الفولاذ بنابض قوي وبروزات حادة تشبه الأسنان للإمساك بالفريسة) / ذكاء حاد, عقل حاد (ذكاء حاد (تشبيه يعتمد على حدة المصائد الفولاذية المعروفة))\nمثال: إنه حاد الذكاء كالمصيدة الفولاذية",
 "虎パン": "مُخَطَّط كَالنَّمِر (ذو خطوط تُشبه خطوط النمر)",
 "虎児": "جرو النمر, فزر (نمر صغير)",
 "虎子": "قصرية, نونية سرير (وعاء ضحل يستخدمه المريض طريح الفراش للتغوط والتبول)",
 "虎巻": "زِرّ",
 "虎挟み": "فخ فولاذي (فخ مصنوع من الفولاذ بنابض قوي وبروزات حادة تشبه الأسنان للإمساك بالفريسة) / ذكاء حاد, عقل حاد (ذكاء حاد (تشبيه يعتمد على حدة المصائد الفولاذية المعروفة))\nمثال: إنه حاد الذكاء كالمصيدة الفولاذية",
 "虎斑": "مُبَرْقَش, مُرَقَّط (ذو خطوط رماديّة أو بنّيّة أو نقوش ملوّنة مرقّطة؛ يُستخدَم خاصّة لوصف فرو القطط)",
 "虎斑木菟": "بومة أذناء",
 "虎柄": "مُخَطَّط",
 "虎柄パンツ": "مُخَطَّط كَالنَّمِر (ذو خطوط تُشبه خطوط النمر)",
 "虎毛": "مُبَرْقَش, مُرَقَّط (ذو خطوط رماديّة أو بنّيّة أو نقوش ملوّنة مرقّطة؛ يُستخدَم خاصّة لوصف فرو القطط)",
 "虎猫": "قط عتابي, قط مخطط (قط ذو معطف رمادي أو أسمر مبقع بالأسود)",
 "虎疫": "كُولِيرَا, هَيْضَة",
 "虎穴": "عَرِين الْأُسُود (اِسْمٌ لِمَاْوَى الأَسَد)",
 "虎落": "اِبْتِزَاز (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد) / اِبْتِزَازَ (اِسْتِغْلالٌ بِدَنَاءَة؛ ابتزاز المال بالتهديد)",
 "虎視眈々": "بحذر, بيقظة (بطريقة يقظة)",
 "虎視眈眈": "بحذر, بيقظة (بطريقة يقظة)",
 "虎豹": "شَرِس ((شَرَسَ) الجِلْدَ يَشْرُسُ شَرْسًا: دَلكَهُ؛ (شَرَسَ) صاحبَه: أمَضَّهُ بالقول)\nمثال: احذر من الكلب الشرس",
 "虎魚": "سمكة العقرب, عقرب البحر (أسماك بحرية لها جسم مستدق ورأس مدرع وأشواك سامة)",
 "虐げられた人々": "مَظْلُوم",
 "虐げられた人人": "مَظْلُوم",
 "虐げる": "اِسْتَضْعَفَ, قَهَرَ",
 "虐め": "إِرْهَاب, تَنَمُّر (ال الإِزعاجُ والإِخَافَةُ، تقولُ: ويَقْشَعِرُّ الإِهَابُ إِذَا وَقَعَ مِنْهُ الإِرْهَابُ؛ الإِرْهَابُ قَدْعُ الإِبِلِ عن الحَوْضِ وذِيَادُهَا) / تَنَمُّر (صار كالنمر شراسة؛ أذى وألحق الضرر الجسدي أو النفسي بمن هو أضعف منه)\nمثال: الإنفصاليون مثل الإرهاب.",
 "虐める": "مُسْتَأْسِد, مُتَنَمِّر / تَنَمَّرَ (صار كالنمر شراسة؛ أذى وألحق الضرر الجسدي أو النفسي بمن هو أضعف منه)",
 "虐待": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "虐待者": "مسيء, منتهك (شخص يمارس الإساءة)",
 "虐政": "طُغْيَان, اِسْتِبْدَاد",
 "虐殺": "ذَبْح (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول) / ذَبَحَ (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول)\nمثال: وعندما يتم ذبح الأبرياء في دارفور والبوسنة يسبب ذلك وصمة في ضميرنا المشترك.",
 "虐遇": "إساءة, سوء المعاملة (معاملة قاسية أو غير إنسانية)\nمثال: أظهر الطفل علامات الإساءة الجسدية",
 "虔しみ": "تَوَاضُع / حِشْمَة",
 "虔み": "تَوَاضُع / حِشْمَة",
 "虔む": "اِمْتَنَعَ (مَنَعَ نفسه؛ كان مَنِيْعًا يصعب الوصول إليه) / لَازِمَة, قَرَار",
 "虚": "سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات / طَقْس, جَوّ / قَصِيّ, نَائٍ جِدًّا (بعيد جدّاً في المكان أو الزمان) / حالة إدراكية, حالة معرفية (حالة العمليات المعرفية للشخص) / حالة ذهنية, مزاج (حالة نفسية مؤقتة) / أَجْوَف / بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "虚け": "شرود الذهن (انشغال كبير لدرجة تجاهل متطلبات الانتباه العادية) / مُغَفَّل, أَحْمَق / رياء, زيف (صفة عدم الصراحة أو الصدق؛ الخداع أو النفاق) / تجويف, فراغ (خاصية وجود منطقة غائرة) / تجوّف (حالة كونه مجوفاً: وجود مساحة فارغة في الداخل)",
 "虚け者": "مُغَفَّل, أَحْمَق",
 "虚しい": "فَارِغ / فَرَغَ / سُدًى, عَبَثِيّ (لا يؤدّي إلى نجاح أو نتيجة مرجوّة) / مَغْرُور, مُعْجَب بِنَفْسِه (يتّسم بكبرياء زائف؛ لديه شعور مبالَغ فيه بأهمية الذات) / جُثَّة هَامِدَة, فَاقِد الحَيَاة (حُرم من الحياة؛ لم يعد على قيد الحياة) / خَالٍ مِنَ الحَيَاة (لا يمتلك القدرة على دعم الحياة) / مَيِّت, هَامِد (فاقد للحيويّة والنشاط والإثارة) / خَاوٍ مِنَ الحَيَاة (خَالٍ مِنَ الحَيَاة أَوْ فُرِّغَ مِنَ الكَائِنَات الحَيَّة)",
 "虚しく": "عَبَثًا, سُدًى",
 "虚しくなる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "虚ろ": "تَجْوِيف / أَجْوَف",
 "虚事": "مُزَيَّف",
 "虚仮": "حماقة, طيش (سلوك أحمق أو لا معنى له) / حماقة, غباء (خطأ سخيف) / حماقة (سمة التصرف بغباء أو تهور) / جنون, حماقة (صفة التهور والحماقة)\nمثال: محاولة القيادة خلال عاصفة ثلجية هي قمة الحماقة",
 "虚仮威し": "خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك) / صَرِيح, طَيِّب القَلْب (مُبَاشِر وَصَرِيح فِي الكَلَام لَكِنْ بِطِيبَة قَلْب) / شَاهِق, عَمُودِيّ تَقْرِيبًا (شديد الانحدار؛ ذو واجهة بارزة وشبه عمودية) / خداع, مخادعة (تظاهر بأن موقفك أقوى مما هو عليه في الواقع)\nمثال: نجحت مخادعته في قبوله",
 "虚偽": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد. / مُغَالَطَة (أما من حيث الصورة فكقولنا لصورة الفرس المنقوش على الجدار: إنها فرس، وكل فرس صهال، ينتج أن تلك الصورة صهالة؛ وأما من حيث المعنى فلعدم رعاية وجود الموضوع في الموجبة)",
 "虚偽表示": "تحريف, تزييف (تحريف متعمد للحقائق) / تضليل, خداع (كذب مضلل)",
 "虚偽記載": "تحريف, تزييف (تحريف متعمد للحقائق) / تضليل, خداع (كذب مضلل)",
 "虚像": "خيال, صورة افتراضية (صورة بصرية منعكسة (كما تُرى في مرآة مستوية)) / ذريعة",
 "虚勢": "خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك) / صَرِيح, طَيِّب القَلْب (مُبَاشِر وَصَرِيح فِي الكَلَام لَكِنْ بِطِيبَة قَلْب) / شَاهِق, عَمُودِيّ تَقْرِيبًا (شديد الانحدار؛ ذو واجهة بارزة وشبه عمودية) / خداع, مخادعة (تظاهر بأن موقفك أقوى مما هو عليه في الواقع)\nمثال: نجحت مخادعته في قبوله",
 "虚勢を張る": "خداع, مخادعة (فعل المخادعة في البوكر؛ الخداع بإظهار ثقة زائفة في قوة أوراقك) / صَرِيح, طَيِّب القَلْب (مُبَاشِر وَصَرِيح فِي الكَلَام لَكِنْ بِطِيبَة قَلْب) / شَاهِق, عَمُودِيّ تَقْرِيبًا (شديد الانحدار؛ ذو واجهة بارزة وشبه عمودية) / خداع, مخادعة (تظاهر بأن موقفك أقوى مما هو عليه في الواقع)\nمثال: نجحت مخادعته في قبوله",
 "虚報": "إشاعة كاذبة, فرية (تلفيق مضلل عمداً)",
 "虚妄": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "虚弱": "رقة, وهن (جودة الافتقار للشدة أو الجوهر) / ضعف, عجز (حالة الضعف في الصحة أو الجسم (خاصة بسبب الشيخوخة))\nمثال: رقة صوت حادة ولكنها عذبة",
 "虚心": "مُنْفَتِح",
 "虚心坦懐": "إِفْرَنْجِيّ",
 "虚数": "عَدَد تَخَيُّلِيّ, عَدَد عُقَدِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "虚栄": "غُرُور",
 "虚栄の市": "حياة الترف, سوق الغرور (نمط حياة مغرور وتافه خاصة في المدن الكبيرة)",
 "虚栄心": "غُرُور",
 "虚構": "خَيَال, رِوَايَة (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول)\nمثال: يحب الخيال العلمي.",
 "虚無": "عدم, لاشيء (حالة عدم الوجود)",
 "虚無主義": "عَدَمِيَّة",
 "虚無主義者": "فوضوي (داعية للفوضوية) / عدمي (شخص يرفض كل نظريات الأخلاق أو المعتقدات الدينية)",
 "虚無的": "عدمي (متعلق بالعدمية)",
 "虚無虚無しい": "خَاوٍ, فَارِغ (لَا يَحْتَوِي عَلَى شَيْء) / بَاطِل, لَاغٍ (يَفْتَقِرُ إِلَى أَيِّ قُوَّةٍ قَانُونِيَّةٍ أَوْ إِلْزَامِيَّة) / خلاء, فراغ (منطقة أو مساحة فارغة) / عدم, لاشيء (حالة عدم الوجود)",
 "虚脱": "خُمُول / اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "虚脱感": "انكسار, قنوط (الشعور بالإحباط واليأس وتثبيط الهمة)",
 "虚脱状態": "ذهول, غشاوة (ارتباك يتميز بنقص الوضوح) / ذهول, صدمة (شعور بالضيق وعدم التصديق الذي ينتابك عند حدوث شيء سيء بشكل عرضي)\nمثال: تركه موت والدته في حالة ذهول",
 "虚血": "نقص التروية",
 "虚血性": "إقفاري, ناقص التروية (متعلق بـ أو مصاب بنقص التروية (الإقفار))",
 "虚血性心疾患": "مَرَض الْقَلْب التَّاجِيّ, دَاء الشَّرْيَان التَّاجِيّ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "虚言": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "虚語": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "虚辞": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "虚部": "جُزْء تَخَيُّلِيّ (الجزء من العدد المركب الذي يحتوي على الجذر التربيعي لـ -1 كعامل)",
 "虚飾": "اسْتِعْرَاض, مُبَاهَاة (عرض مدعٍ أو مبهرج أو مبتذل) / انْتِفَاخ, تَبَاهِي (انعدام الأناقة نتيجة التفاخر والغرور وانتفاخ الذات) / بهرجة, تباهي (عرض خارجي مبهرج)",
 "虚飾的": "استعراضي, متباه (يهدف إلى جذب الانتباه وإبهار الآخرين) / اسْتِعْرَاضِيّ, مُتَبَاهٍ ((لِلعَرْضِ) مُبْتَذَلٌ أَوْ سُوقِيّ)\nمثال: معطف سمور استعراضي",
 "虜": "أَسِير, أَسِيرَة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ) / أَسِير, مَحْبُوس (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب. / ضَحِيَّة / أُضْحِيَّة / أَسِير, أَسِيرَة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ) / أَسِير, مَحْبُوس (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب. / أَجْنَبِيّ, أَجْنَبِيَّة",
 "虜囚": "أَسِير, أَسِيرَة (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ) / أَسِير, مَحْبُوس (اَلْأَسِيرُ هُوَ مَنْ أُسِرَ فِي مَعْرَكَةٍ حَيّّا فَسُجِنَ إِلَى حِينٍ؛ الأَسيرُ: الأَخِيذُ)\nمثال: أنا بريء وأسير حرب.",
 "虞美人草": "خشخاش الحقول, خشخاش الذرة (خشخاش أوروبي سنوي شائع في حقول الحبوب ويزرع غالباً)",
 "號": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟ / كنية, لقب تحبب (اسم مألوف لشخص (غالباً نسخة مختصرة من الاسم الأول للشخص))\nمثال: لم تستخدم والدة جو كنيته وكانت تناديه دائماً جوزيف / مَقَاس, قِيَاس",
 "虫": "حَشَرَة (صغار دواب الأرض؛ الهامة من هوام الأرض كالخنافس)\nمثال: ما زالت الحشرة حية. / شَخْص دَنِيء (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان. / فاقد الوعي, لاواعٍ (غير واعٍ؛ يفتقر إلى الوعي والقدرة على الإدراك الحسي كما لو كان نائماً أو ميتاً) / لَا وَاعٍ (بِدُونِ إِرَادَةٍ وَاعِيَة) / عقل لاواعي, لاوعي (ذلك الجزء من العقل الذي يحدث فيه النشاط النفسي الذي لا يدركه الشخص)\nمثال: مستلقٍ فاقداً للوعي على الأرض / تَوَتُّر",
 "虫えい": "صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / صفراء, عصارة صفراوية (عصارة هضمية يفرزها الكبد وتخزن في المرارة؛ تساعد في هضم الدهون) / استياء, حقد (شعور بالغضب العميق والمرارة وسوء النية) / عفصة (تورم غير طبيعي في أنسجة النبات ناتج عن الحشرات أو الكائنات الحية الدقيقة أو الإصابة)",
 "虫がいい": "أَنَانِيّ",
 "虫が好かない": "كَرِهَ (لم يُحِبّ، لم يَسْتطِع تحمُّلَ شَخْص أو أمرٍ، لم يُطِقْه، مقَته وكان عنده نُفورٌ منه؛ كره الشّخص فعل السّوء)\nمثال: هتلر كره اليهود.",
 "虫が良い": "أَنَانِيّ",
 "虫けら": "شَخْص دَنِيء (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "虫こぶ": "صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / صفراء, عصارة صفراوية (عصارة هضمية يفرزها الكبد وتخزن في المرارة؛ تساعد في هضم الدهون) / استياء, حقد (شعور بالغضب العميق والمرارة وسوء النية) / عفصة (تورم غير طبيعي في أنسجة النبات ناتج عن الحشرات أو الكائنات الحية الدقيقة أو الإصابة)",
 "虫さされ": "لدغة, لسعة (جرح مؤلم ناتج عن غرز حشرة لإبرتها في الجلد)",
 "虫のいい": "أَنَانِيّ",
 "虫の居所が悪い": "سَرِيع التَّأَفُّف, عَصَبِيّ (يتهيج أو ينزعج بسهولة) / سَرِيع الاسْتِثَارَة, قَابِل لِلتَّهَيُّج (قادر على الاستجابة للمحفّزات) / شَدِيد التَّهَيُّج (حسّاس بشكل غير طبيعي لمؤثّر ما)",
 "虫の知らせ": "توجس, نذير شؤم (فأل غير مواتٍ) / بشيرة سوء, نذير شؤم (شعور بقدوم شر)\nمثال: شعور متزايد بنذير شؤم",
 "虫の良い": "أَنَانِيّ",
 "虫めがね": "عَدَسَةٌ مُكَبِّرَة",
 "虫よけ": "مبيد حشري (مادة كيميائية تستخدم لقتل الحشرات)",
 "虫ケラ": "شَخْص دَنِيء (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "虫コブ": "صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / صفراء, عصارة صفراوية (عصارة هضمية يفرزها الكبد وتخزن في المرارة؛ تساعد في هضم الدهون) / استياء, حقد (شعور بالغضب العميق والمرارة وسوء النية) / عفصة (تورم غير طبيعي في أنسجة النبات ناتج عن الحشرات أو الكائنات الحية الدقيقة أو الإصابة)",
 "虫ピン": "دَبُّوس",
 "虫メガネ": "عَدَسَةٌ مُكَبِّرَة",
 "虫下し": "طارِد لِلدِّيدان, مُبيد لِلطُّفَيْلِيّات (يَقْتُل الدِّيدان والطُّفَيْلِيّات المِعَوِيَّة) / طارد للديدان (دواء قادر على التسبب في إخلاء الديدان المعوية الطفيلية)",
 "虫刺され": "لدغة, لسعة (جرح مؤلم ناتج عن غرز حشرة لإبرتها في الجلد)",
 "虫唾": "حُرْقَة الْمَعِدَة, حموضة معوية",
 "虫喰い": "مَسُوس, مُتَأَكِّلٌ بِالدُّودِ (مُصَابٌ أَوْ مُتَضَرِّرٌ بِفِعْلِ الدِّيدَانِ)",
 "虫国": "الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم.",
 "虫垂": "مُلْحَق",
 "虫垂切除術": "اِسْتِئْصَال الزَائِدَة الدُودِيَّة",
 "虫垂炎": "الْتِهابُ الزَّائِدَةِ الدُّودِيَّة",
 "虫嫌い": "رهاب الحشرات (خوف مرضي من الحشرات)",
 "虫引虻": "ذبابة سارقة (ذبابة مفترسة سريعة لها جسم قوي يشبه النحلة مع خرطوم صلب لامتصاص عصارة الحشرات الأخرى التي يتم اصطيادها أثناء الطيران)",
 "虫曳虻": "ذبابة سارقة (ذبابة مفترسة سريعة لها جسم قوي يشبه النحلة مع خرطوم صلب لامتصاص عصارة الحشرات الأخرى التي يتم اصطيادها أثناء الطيران)",
 "虫様垂": "مُلْحَق",
 "虫様突起": "زائدة, زائدة دودية (نتوء أثري يمتد من الطرف السفلي للمصران الأعور ويشبه جيباً صغيراً)",
 "虫様突起炎": "الْتِهابُ الزَّائِدَةِ الدُّودِيَّة",
 "虫歯": "تسوس, تسوس الأسنان (منطقة لينة متآكلة في السن؛ ويمكن أن يؤدي التسوس التدريجي إلى موت السن)",
 "虫狩": "أُفلُوس, رِبَاط",
 "虫瘤": "صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / صفراء, عصارة صفراوية (عصارة هضمية يفرزها الكبد وتخزن في المرارة؛ تساعد في هضم الدهون) / استياء, حقد (شعور بالغضب العميق والمرارة وسوء النية) / عفصة (تورم غير طبيعي في أنسجة النبات ناتج عن الحشرات أو الكائنات الحية الدقيقة أو الإصابة)",
 "虫癭": "صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / صفراء, عصارة صفراوية (عصارة هضمية يفرزها الكبد وتخزن في المرارة؛ تساعد في هضم الدهون) / استياء, حقد (شعور بالغضب العميق والمرارة وسوء النية) / عفصة (تورم غير طبيعي في أنسجة النبات ناتج عن الحشرات أو الكائنات الحية الدقيقة أو الإصابة)",
 "虫眼鏡": "عَدَسَةٌ مُكَبِّرَة",
 "虫草": "زهرة الحواشي الرجلة (نبات حولي من أمريكا الشمالية بزهور بيضاء صغيرة متوطن كعشبة ضارة في أمريكا الجنوبية وأوروبا)",
 "虫除け": "مبيد حشري (مادة كيميائية تستخدم لقتل الحشرات)",
 "虫食い": "مَسُوس, مُتَأَكِّلٌ بِالدُّودِ (مُصَابٌ أَوْ مُتَضَرِّرٌ بِفِعْلِ الدِّيدَانِ)",
 "虱": "قَمْلَة, قَمْل / قِمْلَة",
 "虱だらけ": "مَقْمُول, مَلِيء بِالقَمْل (موبوء بالقمل) / تَافِه, رَدِيء جِدًّا ((غير رسمي) سيء جداً ومُقزِّز) / حَقِير, وَضِيع (خسيس ومحتقر؛ دنيء)",
 "虱潰し": "جلي, دعك (فعل تنظيف سطح بفركه بفرشاة وصابون وماء) / تمشيط (التحرك عبر منطقة للبحث عن شيء ما)\nمثال: تمشيط المنطقة بأكملها لم يكشف عن شيء",
 "虱潰しに": "بِالتَّرْتِيب, فَرْدًا فَرْدًا",
 "虱蝿": "ذبابة القمل (ذبابة ثنائية الأجنحة ماصة للدماء تتطفل على الطيور والثدييات)",
 "虱蠅": "ذبابة القمل (ذبابة ثنائية الأجنحة ماصة للدماء تتطفل على الطيور والثدييات)",
 "虹": "قَوْس قُزَح, قوس قزح / قَزَّحَ",
 "虹の橋を渡る": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "虹上": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "虹彩": "قُزَحِيَّة",
 "虹彩毛様体炎": "التهاب القزحية والجسم الهدبي (التهاب القزحية والجسم الهدبي للعين)",
 "虹彩炎": "التهاب القزحية (التهاب القزحية)",
 "虹蜺": "قَوْس قُزَح, قوس قزح / قَزَّحَ",
 "虹野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "虹霓": "قَوْس قُزَح, قوس قزح / قَزَّحَ",
 "虹鱒": "تروتة قوس قزح (توجد في المياه الساحلية للمحيط الهادئ والجداول من كاليفورنيا السفلى إلى ألاسكا) / تراوت قوس قزح (لحم تراوت المحيط الهادئ الذي يهاجر من المياه المالحة إلى العذبة)",
 "虻": "نُعَرَة",
 "蚊": "بَعُوضَة, نَامُوسَة",
 "蚊いぶし": "بقعة, تلطخ (عيب ناتج عن الأوساخ) / دخان طارد (نار مدخنة لطرد الحشرات)\nمثال: كانت هناك لطخة على خده",
 "蚊の涙": "أجر زهيد, مبلغ ضئيل (دفعة غير كافية)\nمثال: يعملون طوال اليوم مقابل مبلغ زهيد",
 "蚊の食うほどにも思わぬ": "بِلَا قَلَق, مُطْمَئِنّ (خالٍ من الاضطراب والقلق) / آمن, مرتاح البال (خالٍ من الخوف أو الشك؛ مرتاح البال) / غير مهموم, مرتاح البال (غير مثقل بالمتاعب أو الاضطراب أو الضيق)\nمثال: كان مطمئناً بأنه لن يُحاسب على أي شيء",
 "蚊の食う程にも思わぬ": "بِلَا قَلَق, مُطْمَئِنّ (خالٍ من الاضطراب والقلق) / آمن, مرتاح البال (خالٍ من الخوف أو الشك؛ مرتاح البال) / غير مهموم, مرتاح البال (غير مثقل بالمتاعب أو الاضطراب أو الضيق)\nمثال: كان مطمئناً بأنه لن يُحاسب على أي شيء",
 "蚊トンボ": "ذبابة الكركي, طيثارة (ذباب نحيل طويل الأرجل يشبه البعوض الكبير ولكنه لا يلدغ) / فاصولياء خضراء خيطية (فاصولياء خضراء ذات خيوط يجب إزالتها)",
 "蚊帳": "نَامُوسِيَّة",
 "蚊帳吊草": "خولنجان, سعد طويل (سعد أوروبي له أوراق خشنة الحواف وسنيبلات من زهور حمراء وجذور عطرية) / سعد الحمار, سعد مستدير (سعد معمر واسع الانتشار له درنات صغيرة صالحة للأكل تشبه الجوز)",
 "蚊帳釣草": "خولنجان, سعد طويل (سعد أوروبي له أوراق خشنة الحواف وسنيبلات من زهور حمراء وجذور عطرية) / سعد الحمار, سعد مستدير (سعد معمر واسع الانتشار له درنات صغيرة صالحة للأكل تشبه الجوز)",
 "蚊母鳥": "سبد (طيور غير جاثمة شفقية أو ليلية بشكل رئيسي بريش بني رمادي مبقع وعيون كبيرة؛ تتغذى على الحشرات)",
 "蚊燻": "بقعة, تلطخ (عيب ناتج عن الأوساخ) / دخان طارد (نار مدخنة لطرد الحشرات)\nمثال: كانت هناك لطخة على خده",
 "蚊燻し": "بقعة, تلطخ (عيب ناتج عن الأوساخ) / دخان طارد (نار مدخنة لطرد الحشرات)\nمثال: كانت هناك لطخة على خده",
 "蚊絶": "سمكة البعوض (سمكة فضية ذات صفوف من البقع السوداء تعيش في أمريكا الشمالية الاستوائية وجزر الهند الغربية؛ مهمة في مكافحة البعوض)",
 "蚊絶やし": "سمكة البعوض (سمكة فضية ذات صفوف من البقع السوداء تعيش في أمريكا الشمالية الاستوائية وجزر الهند الغربية؛ مهمة في مكافحة البعوض)",
 "蚊蜻蛉": "ذبابة الكركي, طيثارة (ذباب نحيل طويل الأرجل يشبه البعوض الكبير ولكنه لا يلدغ) / فاصولياء خضراء خيطية (فاصولياء خضراء ذات خيوط يجب إزالتها)",
 "蚊食い鳥": "وَطْوَاط, خُفَّاش / مِضْرَب, عَصًا",
 "蚊食鳥": "وَطْوَاط, خُفَّاش / مِضْرَب, عَصًا",
 "蚋": "ذبابة سوداء (ذبابة لاسعة صغيرة مسودة ممتلئة الجسم لها يرقات مائية؛ تمتص دماء الطيور وكذلك البشر والثدييات الأخرى)",
 "蚕": "دُودَة اَلْقَزّ",
 "蚕児": "دُودَة اَلْقَزّ",
 "蚕棚": "سرير سفينة, سرير قطار (سرير على متن سفينة أو قطار؛ عادة ما يكون في طبقات) / سرير بسيط, مضجع (سرير خشن الصنع (كما في موقع التخييم)) / معلف طويل (حوض طويل لتغذية الماشية) / سرير بطابقين (أسرّة مبنية فوق بعضها البعض)",
 "蚕業": "إنتاج الحرير من دودة القز",
 "蚕蛾": "عثة دودة القز (عثة آسيوية متوسطة الحجم تتغذى يرقاتها على أوراق التوت وتنتج الحرير) / عثة دودة القز العملاقة (أي عثة دودة قز من فصيلة ساتورنيداي)",
 "蚕食": "تأثير, تعدي (التأثير بقوة) / انتهاك حرمة, تجاوز (دخول ممتلكات شخص آخر دون حق أو إذن) / اجتياح, تطفل (أي دخول إلى منطقة لم تكن مشغولة سابقاً)\nمثال: استاءوا من طغيان القيم الأمريكية على الثقافة الأوروبية",
 "蚜虫": "مَنّ, مَنَّة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / مَنّ, مَنَّة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / صُرْصُور / مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "蚤": "بُرْغُوث",
 "蚤の市": "سوق البراغيث, سوق السلع المستعملة (سوق شوارع مفتوح للسلع الرخيصة أو المستعملة)",
 "蚤の心臓": "تهيب, جبن (الخوف عند الخوض في أماكن أو أنشطة جديدة ومجهولة) / جبن, خجل (الخوف من المجهول أو غير المألوف أو الخوف من اتخاذ القرارات)",
 "蚤虫": "قافزات الذيل (أي من الحشرات البدائية الدقيقة عديمة الأجنحة العديدة التي تمتلك زائدة بطنية خاصة تسمح بنمط القفز المميز شبه الدائم؛ توجد في التربة الغنية بالحطام…)",
 "蚯蚓": "دُودَة الْأَرْض, خُرْطُون",
 "蚯蚓腫れ": "لوح جانبي (لوح سميك يشكل حافة على طول جانب سفينة خشبية) / أثر ضربة, انتبار (علامة بارزة على الجلد (تنتج عن ضربة سوط مثلاً)؛ سمة مميزة للعديد من ردود الفعل التحسسية)",
 "蚯蚓蜥蜴": "سحلية دودية (سحلية من جنس أمفيسباينا؛ سحلية غير ضارة تشبه الدودة وعديمة الأطراف من المناطق الدافئة أو الاستوائية لها عيون وآذان مخفية وذيل قصير غير حاد)",
 "蚰蜒羊歯": "زان ياباني (زان موطنه اليابان له خشب بني مصفر فاتح ناعم)",
 "蚶": "محار الدم (محار أحمر الدم)",
 "蚶貝": "محار الدم (محار أحمر الدم)",
 "蚺蛇": "أَصَلَة",
 "蛆": "نَغَفة",
 "蛆虫": "نَغَفة / شَخْص دَنِيء (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "蛇": "ثُعْبَان, حَنَش / ثُعْبَان / حَنَش (حَنَشَ (حنشه) الحنش حنشا: لدغه؛ حَنَشَ (حنشه): ساقه وطرده ويقال حنش الصيد صاده) / حَيَّة / أَفْعَى",
 "蛇の生殺し": "الليمبو ((اللاهوت) في الكاثوليكية الرومانية، مكان الأرواح غير المعمدة ولكن البريئة أو الصالحة (مثل الرضع والأفراد الفاضلين)) / إهمال, نسيان (مكان خيالي للأشياء المفقودة أو المهملة) / طي الكتمان, نسيان (حالة كونه مهملاً أو منسياً)",
 "蛇の目": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه) / إصابة في الصميم, إصابة مركز الهدف (في الرماية: نقطة تُحرز بضرب مركز الهدف) / فانوس مظلم (فانوس بفتحة واحدة ولوحة منزلقة يمكن إغلاقها لإخفاء الضوء) / إصابة الهدف, نقطة الوسط (مركز الهدف)\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "蛇体": "ثُعْبَانِيّ",
 "蛇使い": "حاوي الثعابين, مروض الثعابين (فنان يستخدم الحركات والموسيقى للسيطرة على الثعابين)",
 "蛇口": "حَنَفِيَّة, صُنْبُور",
 "蛇座": "الْحَيَّة",
 "蛇毒": "زعاف الثعبان, سم الأفعى (سم تفرزه بعض الثعابين)",
 "蛇神": "إله الثعبان, زومبي (إله في طوائف الفودو ذات الأصل الأفريقي، يُعبد خاصة في جزر الهند الغربية)",
 "蛇管": "مِلَفّ, وَشِيعَة / وَشِيعَة",
 "蛇紋岩": "سربنتينيت",
 "蛇紋石": "ثُعْبَانِيّ",
 "蛇結茨": "شوك ميسور (شجيرة شائكة منتشرة من آسيا الاستوائية تحمل عناقيد منتصبة كبيرة من الزهور الصفراء ذات العلامات الحمراء)",
 "蛇腹": "مِنْفَاخ / إفريز, كرنيش (الجزء البارز العلوي من السطح المعمد) / كورنيش (إطار زخرفي في الزاوية بين السقف وأعلى الجدار) / ستارة, كورنيش (هيكل زخرفي لإخفاء تركيبات الستائر في الجزء العلوي من غلاف النافذة) / ركراك, شريط متعرج (شريط متعرج ضيق يستخدم كحاشية)",
 "蛇蜻蛉": "ذبابة دوبسون (حشرة كبيرة ناعمة الجسم لها فكوك نحيلة طويلة في الذكر؛ تستخدم اليرقات المائية غالباً كطعم)",
 "蛇蠍": "ثُعْبَان, حَنَش / عَقْرَب, عَقْرَبَة / اشمئزاز, بغض (كراهية مقترنة بالاشمئزاز)",
 "蛇行": "تَعَرَّجَ",
 "蛇足": "تكرار زائد, حشو (تكرار فعل ما بلا حاجة) / زيادة, فائض (سمة كون الشيء زائداً وغير مطلوب) / تكرار احتياطي ((إلكترونيات) تصميم نظام يكرر المكونات لتوفير بدائل في حالة فشل أحد المكونات) / تكرار زائد, حشو (تكرار الرسائل لتقليل احتمالية الأخطاء في الإرسال)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة",
 "蛇遣い": "حاوي الثعابين, مروض الثعابين (فنان يستخدم الحركات والموسيقى للسيطرة على الثعابين)",
 "蛇遣い座": "الْحَوَّاء",
 "蛇遣座": "الْحَوَّاء",
 "蛇頭": "زهرة السلحفاة, كيلون (نبات معمر بارز في الأراضي المستنقعية في شرق ووسط أمريكا الشمالية له أوراق رمحية شمعية وزهرة ذات جزء سفلي أبيض كريمي وأجزاء علوية وردية شاحبة إلى…)",
 "蛇食鷲": "كَاتِب (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "蛋民": "شعب تانكا (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)",
 "蛋白": "بْرُوتِين (في جزيئات حيوية ضخمة تتكون من سلسلة أو أكثر من الأحماض الأمينية) / بُرُوتِين (في جزيئات حيوية ضخمة تتكون من سلسلة أو أكثر من الأحماض الأمينية)\nمثال: يحتوي اللحم على البروتين. / غِرْقِل, آح البَيْض",
 "蛋白同化ステロイド": "ستيرويد بنائي, منشط (أي من مجموعة الهرمونات الستيرويدية الاصطناعية التي تستخدم لتحفيز نمو العضلات والعظام؛ يستخدمها الرياضيون أحياناً بشكل غير قانوني لزيادة قوتهم)",
 "蛋白尿": "بيلة ألبومينية, بيلة بروتينية (وجود بروتين مفرط (بشكل رئيسي الألبومين ولكن أيضاً الجلوبيولين) في البول؛ عادة ما يكون عرضاً لاضطراب كلوي)",
 "蛋白石": "أُوبَال",
 "蛋白質": "بْرُوتِين (في جزيئات حيوية ضخمة تتكون من سلسلة أو أكثر من الأحماض الأمينية) / بُرُوتِين (في جزيئات حيوية ضخمة تتكون من سلسلة أو أكثر من الأحماض الأمينية)\nمثال: يحتوي اللحم على البروتين.",
 "蛋白質分解酵素": "بروتياز (أي إنزيم يحفز انقسام البروتينات إلى أجزاء ببتيد أصغر وأحماض أمينية بعملية تعرف بالتحلل البروتيني)",
 "蛋黄": "صفار البيض, مح (الجزء الكروي الأصفر من البيضة الذي يحيط به الزلال)",
 "蛍": "يَرَاعَة, حُبَاحِب",
 "蛍光": "تالق, فلورة (ضوء ينبعث أثناء امتصاص إشعاع ذي طول موجي آخر (غير مرئي))",
 "蛍光ペン": "قلم تحديد, قلم تظليل (قلم تمييز فلوري يستخدم لتمييز الفقرات المهمة في النص) / قلم تمييز, هايلايتر (مستحضر تجميل يستخدم لإبراز العيون أو عظام الوجنتين)",
 "蛍光板": "شاشة فلورية (شاشة شفافة مطلية من جانب واحد بمادة فسفورية تتفلور عند تعرضها للأشعة السينية أو أشعة الكاثود)",
 "蛍光染料": "صبغة الفلوريسين, فلوريسين (صبغة صفراء تظهر بوضوح حتى عند تخفيفها بشدة؛ تستخدم كمؤشر امتزاز)",
 "蛍光灯": "مصباح فلوري, مصباح نيون (مصباح يتكون من أنبوب مطلي من الداخل بمادة فلورية؛ يبعث بخار الزئبق في الأنبوب أشعة فوق بنفسجية تتحول إلى إشعاع مرئي بواسطة المادة الفلورية)",
 "蛍光物質": "فوسفور (مادة اصطناعية تتصف بالفلورية أو التفسفر؛ تستخدم لطلاء شاشات أنابيب أشعة الكاثود)",
 "蛍光色素": "صبغة الفلوريسين, فلوريسين (صبغة صفراء تظهر بوضوح حتى عند تخفيفها بشدة؛ تستخدم كمؤشر امتزاز)",
 "蛍火": "جَمْرَة",
 "蛍石": "فلسبار, فلوريت (معدن ناعم (فلوريد الكالسيوم) مشع في الضوء فوق البنفسجي؛ المصدر الرئيسي للفلور)",
 "蛍草": "زهرة النهار, عشبة العنكبوت",
 "蛍蛆": "يَرَاع, حَبَاحِب",
 "蛍袋": "جريس, زهرة الجرس",
 "蛔虫": "دودة أسطوانية, نيماتودا (ديدان غير مقسمة ذات جسم مستدير ممدود مدبب من كلا الطرفين؛ معظمها حرة المعيشة ولكن بعضها طفيلي)",
 "蛙": "ضِفْدِع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضَفْدَع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضِفْدَع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / ضفدع (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ) / بقرور\nمثال: الضفدع في البئر.",
 "蛙の子は蛙": "الْوَلَدُ سُرّ أَبِيهِ",
 "蛙手": "قَيْقَب",
 "蛙泳ぎ": "سباحة الصدر (طريقة سباحة؛ تُمد الذراعان معاً أمام الرأس وتُسحبان للخلف على الجانبين مصحوبة بركلة الضفدع)",
 "蛙跳び": "قفزة الضفدع, نط الحبل (لعبة ينحني فيها طفل ويقفز آخر من فوقه) / تجاوز, قفزة (التقدم كما في لعبة الأطفال، بالقفز فوق العقبات أو المنافسين)\nمثال: لا تزال الشركة تعتقد أن الرقاقة تمثل قفزة في التكامل وستحقق أرباحاً طائلة",
 "蛙飛び": "قفزة الضفدع, نط الحبل (لعبة ينحني فيها طفل ويقفز آخر من فوقه) / تجاوز, قفزة (التقدم كما في لعبة الأطفال، بالقفز فوق العقبات أو المنافسين)\nمثال: لا تزال الشركة تعتقد أن الرقاقة تمثل قفزة في التكامل وستحقق أرباحاً طائلة",
 "蛙鮟鱇": "سمكة الضفدع (سمكة لها فم يشبه فم الضفدع مع طُعم على الخطم)",
 "蛙黽": "ضِفْدَع شَجَر (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ)\nمثال: الضفدع في البئر.",
 "蛛形類": "حَيَوَان عَنْكَبُوتِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "蛛網": "بَيْت الْعَنْكَبُوت, نَسِيج الْعَنْكَبُوت (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)",
 "蛞蝓": "بَزَّاقَة",
 "蛞蝓に塩": "خَائِبُ الأَمَل, مُنْكَسِر (مُنْخَفِضُ الرُّوحِ المَعْنَوِيَّة؛ مَكْسُورُ الخَاطِر)",
 "蛞蝓魚": "رميح, سهيم (حيوان بحري صغير شفاف يشبه المشرط يحفر في الرمل؛ سلف بدائي للفقاريات)",
 "蛤": "تَنَاقُض, عَدَم اتِّسَاق (صفة عدم الاتساق وافتقار الانسجام بين الأشياء أو الأجزاء) / تَعَارُض, تَنَافُر (العلاقة بين القضايا التي لا يمكن أن تكون صحيحة في نفس الوقت)",
 "蛭": "عَلَق",
 "蛭木": "المنغروف",
 "蛭木騙": "مانغروف أبيض (شجيرة إلى شجرة متوسطة الحجم تنمو في المياه قليلة الملوحة على طول سواحل غرب أفريقيا وأمريكا الاستوائية؛ مهمة محلياً كمصدر للتانين) / قرم, مانغروف أبيض (شجرة صغيرة إلى متوسطة الحجم تنمو في المياه قليلة الملوحة خاصة على طول سواحل جنوب غرب المحيط الهادئ)",
 "蛭石": "فيرميكوليت (أي من مجموعة معادن السيليكات المائية الصفراء أو البنية ذات البنية الميكائية)",
 "蛭蓆": "بواق, جار النهر",
 "蛮から": "رَثّ, مُهْمَل المَظْهَرِ (بَالٍ وَغَيْرُ مُرَتَّبٍ)",
 "蛮カラ": "رَثّ, مُهْمَل المَظْهَرِ (بَالٍ وَغَيْرُ مُرَتَّبٍ)",
 "蛮人": "مُتَوَحِّش / هَمَجِيّ / مُتَوَحِّش, هَمَجِيّ",
 "蛮勇": "تهور, طيش (سمة إيلاء القليل من التفكير للخطر)",
 "蛮国": "بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "蛮夷": "مُتَوَحِّش / هَمَجِيّ / مُتَوَحِّش, هَمَجِيّ",
 "蛮岩": "تَجْمِيعِيّ, مُتَكَتِّل (مؤلف من عناصر متباينة مجتمعة في كتلة واحدة) / تكتل شركات, مجموعة شركات (مجموعة من الشركات المتنوعة تحت ملكية مشتركة وتدار كمنظمة واحدة) / تكتلات صخرية, كونغلوميريت (صخر مركب يتكون من جزيئات متفاوتة الحجم)",
 "蛮的": "مُتَوَحِّش / هَمَجِيّ / مُتَوَحِّش, هَمَجِيّ",
 "蛮行": "بربرية",
 "蛮襟": "رَثّ, مُهْمَل المَظْهَرِ (بَالٍ وَغَيْرُ مُرَتَّبٍ)",
 "蛮語": "لُغَة أَجْنَبِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "蛮骨": "تَهَوُّر (التسرع والاندفاع لفعل شيء دون التفكير بالنتائج)\nمثال: إنه خطر أن تقود بتهور.",
 "蛯原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "蛸": "أُخْطُبُوط, أَخْطَبُوط (الأُخْطُبُوْط حَيَوَانٌ بَحْرِيٌّ مِنْ فَصِيلَةِ الرِّخْوِيَّاتِ، لَهُ ثَمَانِي أرجُلِ فِي رَأْسِهِ، فِيهَا مَحَاكِم يَلْتَصِقُ بِهَا…؛ الأُخْطُبوط : حيوان بَحْريّ من الرِّخْويَّات له ثماني أرجلٍ رأْسية، يضرب به المثل في شُدة التشبُّث بما يمسكه) / مُغَفَّل, أَحْمَق",
 "蛸入道": "أُخْطُبُوط, أَخْطَبُوط (الأُخْطُبُوْط حَيَوَانٌ بَحْرِيٌّ مِنْ فَصِيلَةِ الرِّخْوِيَّاتِ، لَهُ ثَمَانِي أرجُلِ فِي رَأْسِهِ، فِيهَا مَحَاكِم يَلْتَصِقُ بِهَا…؛ الأُخْطُبوط : حيوان بَحْريّ من الرِّخْويَّات له ثماني أرجلٍ رأْسية، يضرب به المثل في شُدة التشبُّث بما يمسكه)",
 "蛸壷": "حفرة فردية (خندق صغير به حفرة للمأوى الفردي ضد نيران العدو)",
 "蛸壺": "حفرة فردية (خندق صغير به حفرة للمأوى الفردي ضد نيران العدو) / فُقَّاعَة",
 "蛸焼き": "تاكوياكي (وجبة خفيفة يابانية على شكل كرة مصنوعة من عجين أساسه دقيق القمح وتطهى في مقلاة مقولبة خاصة)",
 "蛸部屋": "مخيم عمل قسري, معسكر عمل (مؤسسة عقابية للسجناء السياسيين الذين يستخدمون كعمالة قسرية)",
 "蛹": "خَادِرَة",
 "蛹虫": "خَادِرَة, شَرْنَقَة",
 "蛻": "انسلاخ, طرح الريش (الانسلاخ الدوري للبشرة في المفصليات أو الجلد الخارجي في الزواحف) / قِشْرَة",
 "蛻け": "انسلاخ, طرح الريش (الانسلاخ الدوري للبشرة في المفصليات أو الجلد الخارجي في الزواحف)",
 "蛻の殻": "خَالِيّ / خَاوِي, فَارِغ / جُثَّة, جُثْمَان",
 "蛾": "عُثَّة",
 "蛾眉": "هِلَال",
 "蜀": "سِيشْوَان, سِيتْشْوَان",
 "蜀黍": "ذُرَة, سرغوم",
 "蜂": "نَحْلَة / نَحْل / نحل / نحلة / بِي\nمثال: 蜂は花から花に飛ぶ。 — تطير النحلات من زهرة إلى زهرة.",
 "蜂か": "خَلِيَّة, قَفِير",
 "蜂の巣": "خَلِيَّة, قَفِير / جبنة سويسرية / القلنسوة, كرشة العسل (بطانة المعدة الثانية (الشبكية) للحيوانات المجترة تستخدم كطعام) / قالب التشكيل (كتلة حديدية مقطوعة بثقوب وأخاديد للمساعدة في تشكيل المعادن على البارد)",
 "蜂の巣胃": "قَلَنْسُوَة (القُلُنْسُوَة: لباس داخلي للرأس يُلبس غالبا داخليا تحت العَمَامَة أو الكُوفِيَّة أو غيره من أغطية الرأس للرجال والنساء، يسمى أيضا الطَاقِيَّة؛ القُلُنْسُوَة: لباس للرأس يشبه الداخلي إلا أنه يلبس لوحده، قد يكون أبيضا وقد يكون مطرزا، يسمى أيضا الطَاقِيَّة)\nمثال: كان زيري يرتدي قلنسوة.",
 "蜂ろう": "شَمْع الْعَسَل ((شَمَعَ) يَشْمُعُ شَمْعًا، وشُمُوعًا: مَزَحَ وطَرِبَ)\nمثال: أشعل كين الشمع.",
 "蜂巣": "خلية نحل, قفير (وعاء من صنع الإنسان يأوي سرباً من النحل) / حشد مزدحم, خلية (حشد يعج بالنشاط) / خَلِيَّةُ نَحْل (هيكل يوفر مسكناً طبيعياً للنحل؛ كما في شجرة مجوفة)",
 "蜂巣炎": "التهاب النسيج الخلوي, التهاب الهلل (التهاب أنسجة الجسم (خاصة تلك الموجودة تحت الجلد) يتميز بالحمى والتورم والاحمرار والألم)",
 "蜂巣織炎": "التهاب النسيج الخلوي, التهاب الهلل (التهاب أنسجة الجسم (خاصة تلك الموجودة تحت الجلد) يتميز بالحمى والتورم والاحمرار والألم)",
 "蜂巣胃": "قَلَنْسُوَة (القُلُنْسُوَة: لباس داخلي للرأس يُلبس غالبا داخليا تحت العَمَامَة أو الكُوفِيَّة أو غيره من أغطية الرأس للرجال والنساء، يسمى أيضا الطَاقِيَّة؛ القُلُنْسُوَة: لباس للرأس يشبه الداخلي إلا أنه يلبس لوحده، قد يكون أبيضا وقد يكون مطرزا، يسمى أيضا الطَاقِيَّة)\nمثال: كان زيري يرتدي قلنسوة.",
 "蜂房": "خلية نحل, قفير (وعاء من صنع الإنسان يأوي سرباً من النحل) / حشد مزدحم, خلية (حشد يعج بالنشاط) / خَلِيَّةُ نَحْل (هيكل يوفر مسكناً طبيعياً للنحل؛ كما في شجرة مجوفة)",
 "蜂球": "ثَوْل (بدا فيه الجنون) / اِزْدِحَام",
 "蜂窩": "خَلِيَّة, قَفِير",
 "蜂窩織炎": "التهاب النسيج الخلوي, التهاب الهلل (التهاب أنسجة الجسم (خاصة تلك الموجودة تحت الجلد) يتميز بالحمى والتورم والاحمرار والألم)",
 "蜂蜜": "عَسَل, شَهْد (عَسَل) / حَبِيبِي, عَزِيزَتِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / عَسَل, عَسُّولَة (عَسَل) / عَسَلِيّ\nمثال: يصنع النحل العسل.",
 "蜂蜜色": "عَسَلِيّ اللَّوْن (ذو لون العسل)",
 "蜂蜜酒": "بِتْع (تباعد؛ صيّرَ)",
 "蜂蝋": "شَمْع الْعَسَل ((شَمَعَ) يَشْمُعُ شَمْعًا، وشُمُوعًا: مَزَحَ وطَرِبَ)\nمثال: أشعل كين الشمع.",
 "蜂起": "ثَوْرَة, عِصْيَان",
 "蜂雀": "طَنَّان, طَنَان",
 "蜂須賀": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "蜂鳥": "طَنَّان, طَنَان",
 "蜃気楼": "سَرَاب",
 "蜆": "بلح البحر النهري (رخوي ذو صدفتين وفير في أنهار وسط الولايات المتحدة)",
 "蜆花": "إكليل العروس (شجيرة لها زهور بيضاء صغيرة غزيرة في الربيع) / إكليل العروس, فرانكوا (شجيرة تشيلية دائمة الخضرة لها سنابل دقيقة من الزهور البيضاء الصغيرة)",
 "蜆貝": "بلح البحر النهري (رخوي ذو صدفتين وفير في أنهار وسط الولايات المتحدة)",
 "蜈蚣": "أُمّ أَرْبَعَة وَأَرْبَعِين (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "蜉蝣": "ذُبَابَة مَايُو, ذُبَاب مَايُو (حشرة صغيرة سوداء اللون معروفة)\nمثال: أمسك بتلك الذبابة. / زوال سريع, قصر الأمد (خاصية الاستمرار لفترة قصيرة جداً) / يَعْسُوب",
 "蜑": "صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "蜘蛛": "عَنْكَبُوت, شَبَث",
 "蜘蛛の巣": "بَيْت الْعَنْكَبُوت, نَسِيج الْعَنْكَبُوت (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "蜘蛛の巣黴": "ريزوبوس (أي من الفطريات المسببة للعفن المختلفة من جنس ريزوبوس)",
 "蜘蛛人手": "نجم البحر الهش (حيوان يشبه نجم البحر بأذرع هشة تشبه السوط تشع من قرص مركزي صغير)",
 "蜘蛛形類": "حَيَوَان عَنْكَبُوتِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "蜘蛛恐怖症": "رُهَاب اَلْعَنَاكِب",
 "蜘蛛手": "عَرْضِيًّا, مُسْتَعْرِضًا (بشكل مستعرض) / بِشَكْل مُعَاكِس, عَلَى نَحْو مُخَالِف (ليس بالطريقة المقصودة) / صَلِيبِيّ, مُتَقَاطِع (على شكل صليب أو قطعة أفقيَّة منه) / عرضي (يقع أو يمتد عبر طول الشيء أو في اتجاه متقاطع)\nمثال: تم قطع ألواح الرخام بشكل عرضي",
 "蜘蛛海星": "نجم البحر الهش (حيوان يشبه نجم البحر بأذرع هشة تشبه السوط تشع من قرص مركزي صغير)",
 "蜘蛛猿": "سَعْدَان عَنْكَبُوتِيّ, آتِل",
 "蜘蛛類": "حَيَوَان عَنْكَبُوتِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "蜚語": "نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "蜜": "رَحِيق / عَسَل, شَهْد (عَسَل) / حَبِيبِي, عَزِيزَتِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / عَسَل, عَسُّولَة (عَسَل) / عَسَلِيّ\nمثال: يصنع النحل العسل. / مغثر / مَنّ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / ابتذال عاطفي (كتابة أو موسيقى حلوة وعاطفية بشكل مفرط) / تريكل, شراب ذهبي (شراب قصب شاحب اللون)",
 "蜜ろう": "شَمْع الْعَسَل ((شَمَعَ) يَشْمُعُ شَمْعًا، وشُمُوعًا: مَزَحَ وطَرِبَ)\nمثال: أشعل كين الشمع.",
 "蜜人": "مُومِيَاء / مَامَا, مَامَان",
 "蜜壺": "أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية)",
 "蜜月": "شَهْر عَسَل (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر جزئا من السَنَة…)\nمثال: رمضان شهر حرام.",
 "蜜柑": "يُوسُفِيّ, يُوسُف أَفَنْدِي / حمضيات (أي من الفواكه العديدة لجنس الحمضيات ذات القشرة السميكة واللب العصيري؛ تزرع في المناطق الدافئة) / حمضيات, شجرة حمضيات",
 "蜜源植物": "نبات عسلي (نبات يوفر رحيقاً مناسباً لصنع العسل)",
 "蜜砂糖": "ابتذال عاطفي (كتابة أو موسيقى حلوة وعاطفية بشكل مفرط) / تريكل, شراب ذهبي (شراب قصب شاحب اللون)",
 "蜜穴熊": "غُرَيْر العَسَل",
 "蜜肉": "أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية)",
 "蜜腺": "غدة رحيقية (غدة (غالباً ما تكون نتوءاً أو انخفاضاً) تفرز الرحيق)",
 "蜜色": "عَسَلِيّ اللَّوْن (ذو لون العسل)",
 "蜜蜂": "نحل العسل (نحل اجتماعي يتم تدجينه غالباً من أجل العسل الذي ينتجه)",
 "蜜蝋": "شَمْع الْعَسَل ((شَمَعَ) يَشْمُعُ شَمْعًا، وشُمُوعًا: مَزَحَ وطَرِبَ)\nمثال: أشعل كين الشمع.",
 "蜜語": "كلمات معسولة, همسات الحب (تعبيرات عاطفية غير مهمة المضمون)\nمثال: همس بكلمات معسولة في أذنها",
 "蜥蜴": "سِحْلِيَّة, ضَبّ",
 "蜥蜴座": "سِحْلِيَّة, ضَبّ",
 "蜷局": "مِلَفّ, وَشِيعَة / وَشِيعَة",
 "蜷川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "蜻蛉": "ذُبَابَة مَايُو, ذُبَاب مَايُو (حشرة صغيرة سوداء اللون معروفة)\nمثال: أمسك بتلك الذبابة. / زوال سريع, قصر الأمد (خاصية الاستمرار لفترة قصيرة جداً) / يَعْسُوب / يَعْسُوب\nمثال: クモはそこで、チョウとかトンボといった小さな昆虫が罠にかかるのを待つ。 — ينتظر العنكبوت هناك الحشراتِ الصغيرة كالفراشات واليعاسيب حتى تقع في شباكه.",
 "蜻蜒": "رتّاء (شخص يصلح (الملابس) بالرتق) / يَعْسُوب",
 "蜻蜓": "رتّاء (شخص يصلح (الملابس) بالرتق) / يَعْسُوب",
 "蜾蠃": "أَيِّل",
 "蜾蠃乙女": "دَقِيق الخَصْر, نَحِيل الخَصْر (ذُو خَصْر صَغِير وَنَحِيل)",
 "蜾蠃少女": "دَقِيق الخَصْر, نَحِيل الخَصْر (ذُو خَصْر صَغِير وَنَحِيل)",
 "蝃蝀": "قَوْس قُزَح, قوس قزح / قَزَّحَ",
 "蝉": "زِيز",
 "蝉塚": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "蝋": "شَمْع, شَمَع ((شَمَعَ) يَشْمُعُ شَمْعًا، وشُمُوعًا: مَزَحَ وطَرِبَ)\nمثال: أشعل كين الشمع.",
 "蝋人形": "تمثال شمع (تمثال (عادة لشخص مشهور) مصنوع من الشمع)",
 "蝋引き": "تشميع",
 "蝋染": "باتيك",
 "蝋染め": "باتيك",
 "蝋梅": "بهار ياباني, حلوى الشتاء (شجيرة يابانية نفضية تزرع لأزهارها الصفراء العطرة)",
 "蝋燭": "شَمْعَة, قِنْدِيل (عَمود تُعمَد عليه القَنْطَرة؛ وحدة تُقاس بها القوَّة الكهربائيَّة)\nمثال: أشعل سيسيل شمعة.",
 "蝋燭屋": "شَمَّاع",
 "蝋燭立て": "حامل الشموع, شمعدان (حامل ذو تجاويف لتثبيت الشموع)",
 "蝋紙": "وَرَق شَمْع, مُهْرَق (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "蝋細工": "تمثال شمع (تمثال (عادة لشخص مشهور) مصنوع من الشمع) / حلوة مرة أمريكية, سيلاستروس (شجيرة ملتفة في أمريكا الشمالية لها كبسولات صفراء تحيط ببذور قرمزية)",
 "蝋纈染": "باتيك",
 "蝋纈染め": "باتيك",
 "蝋膜": "قير (الغطاء اللحمي الشمعي عند قاعدة المنقار العلوي لبعض الطيور)",
 "蝌蚪": "شُرْغُوف (الضِفْدَعُ الصغير)",
 "蝕": "كُسُوف, خُسُوف",
 "蝕む": "أَفْسَدَ / دَلَّلَ, غَنَّجَ (دلل: أَدَلَّ عَلَيْهِ وتَدَلَّلَ: انْبَسَطَ؛ قالَ ابْنُ دُرَيْدٍ: أَدَلَّ عَلَيْهِ وَثِق بِمَحَبَّتِهِ فأَفْرَط عَلَيْهِ) / فَسَدَ, نَتِنَ\nمثال: دلل سامي صديقته.",
 "蝗": "جُنْدُب, جَرَادَة",
 "蝗豆": "خَرُّوب",
 "蝙蝠": "وَطْوَاط, خُفَّاش / مِضْرَب, عَصًا / مِظَلَّة, شَمْسِيَّة / وَاقٍ, الْوَاقِي / انْتِهَازِيّ, وُصُولِيّ (ينتهز الفرصة فوراً وبشكل غير أخلاقي في كثير من الأحيان) / انتهازي, وصولي (شخص يفضل المصلحة الشخصية والوسائل النفعية على المبادئ)",
 "蝙蝠傘": "مِظَلَّة, شَمْسِيَّة / وَاقٍ, الْوَاقِي",
 "蝟": "قُنْفُذ",
 "蝟集": "ثَوْل (بدا فيه الجنون) / اِزْدِحَام",
 "蝤蛑": "سرطان سابح (سرطان بحري بعض أرجله مفلطحة ومزينة بأهداب للسباحة)",
 "蝦原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "蝦名": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "蝦夷ねぎ": "ثوم معمر (أوراق أسطوانية تستخدم طازجة كتابل خفيف بنكهة البصل) / ثوم معمر (نبات معمر له أوراق أسطوانية مجوفة تستخدم للتتبيل)",
 "蝦夷ネギ": "ثوم معمر (أوراق أسطوانية تستخدم طازجة كتابل خفيف بنكهة البصل) / ثوم معمر (نبات معمر له أوراق أسطوانية مجوفة تستخدم للتتبيل)",
 "蝦夷上溝桜": "كرز الطيور (أي من عدة أشجار كرز صغيرة الثمار تتردد عليها الطيور أو تتغذى عليها)",
 "蝦夷禅庭花": "زنبق النهار (أي من النباتات المعمرة المتعددة ذات جذور درنية وأوراق طويلة ضيقة تشبه النصل وزهور تشبه الزنبق صفراء عادة تتفتح ليوم واحد فقط) / زنبق لسان الحمل, هوستا (أي من النباتات المعمرة العديدة التي تتميز بكتل من الأوراق المضلعة العريضة الفخمة وعناقيد من الزهور البيضاء أو الزرقاء أو الليلكية؛ تستخدم كغطاء أرضي)",
 "蝦夷菊": "أستر صيني (نبات يُقدّر لزهوره الجميلة ذات الألوان الزاهية والنقية المتنوعة؛ يُزرع بشكل أساسي للقطف)",
 "蝦夷葱": "ثوم معمر (أوراق أسطوانية تستخدم طازجة كتابل خفيف بنكهة البصل) / ثوم معمر (نبات معمر له أوراق أسطوانية مجوفة تستخدم للتتبيل)",
 "蝦夷黄菅": "زنبق الليمون (زنبق نهاري بزهور صفراء)",
 "蝦蛄": "روبيان السرعوف (قشريات بحرية استوائية حفارة بزوائد إمساك كبيرة)",
 "蝦蟆": "عُلْجُوم, ضِفْدَع طِين",
 "蝦蟇": "عُلْجُوم, ضِفْدَع طِين",
 "蝦蟇腫": "ضفدع, كيسة تحت اللسان (كيس على الجانب السفلي من اللسان)",
 "蝦蟇鮟鱇": "سمكة العلجوم (سمكة تعيش في القاع ذات جلد لزج عديم القشور ورأس عريض سميك وفم واسع)",
 "蝦蟹": "جَرَاد الْبَحْر",
 "蝦錠": "كَيْلُون, كَالُون",
 "蝨": "قَمْلَة, قَمْل / قِمْلَة",
 "蝮": "أفعى الحفر (أفاعي العالم الجديد ذات أنياب مجوفة وحفرة حساسة للحرارة على كل جانب من الرأس)",
 "蝱": "نُعَرَة",
 "蝲蛄": "جَرَاد الْبَحْر",
 "蝶": "فَرَاشَة, ابو دقيق (حشرة صغيرة رقيقة ذات أجنحة كبيرة قد تكون ملونة أو غير ملونة)\nمثال: آه ، هناك فراشة!",
 "蝶々": "فَرَاشَة, ابو دقيق (حشرة صغيرة رقيقة ذات أجنحة كبيرة قد تكون ملونة أو غير ملونة)\nمثال: آه ، هناك فراشة!",
 "蝶々結び": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "蝶よ花よ": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "蝶ネクタイ": "بابيون, ربطة عنق فراشة (ربطة عنق رجالية تُربط على شكل فيونكة)",
 "蝶ネジ": "صامولة فراشة, صامولة مجنحة (صامولة مسننة ذات نتوءات تشبه الأجنحة لتدويرها بالإبهام والسبابة) / جوز مجنح (جَوَّز لَهُمْ إِبِلَهم إِذا قَادَهَا بَعِيرًا بَعِيرًا حَتَّى تَجُوزَ)\nمثال: نريد أن نأكل نبات جوز الهند.",
 "蝶名林": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "蝶型": "فَرَاشِيّ الشَّكْل (على شكل فراشة)",
 "蝶形": "فَرَاشِيّ الشَّكْل (على شكل فراشة)",
 "蝶形弁": "صمام فراشة (صمام في المكربن يتكون من قرص يدور ويعمل كخانق)",
 "蝶形骨": "عظم وتدي (عظم على شكل فراشة عند قاعدة الجمجمة)",
 "蝶番": "مِقْبَض / مُشْتَرَك / مِفْصَل",
 "蝶番関節": "مفصل رزي, مفصل مفصلي (مفصل يسمح بالحركة في مستوى واحد فقط) / مفصل رزي (مفصل حر الحركة يتمفصل فيه العظمان بحيث يسمحان بحركة واسعة في مستوى واحد)",
 "蝶結び": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "蝶蝶": "فَرَاشَة, ابو دقيق (حشرة صغيرة رقيقة ذات أجنحة كبيرة قد تكون ملونة أو غير ملونة)\nمثال: آه ، هناك فراشة!",
 "蝶蝿": "ذبابة الرمل (أي من الذباب الصغير ثنائي الأجنحة المتنوع؛ يمكن للإناث الماصة للدماء نقل حمى ذباب الرمل وداء الليشمانيات)",
 "蝶豆": "بازلاء الفراشة, سينتروسيما (كرمة كبيرة الزهر ضعيفة الالتفاف أو منبسطة من نيو جيرسي إلى شرق أمريكا الشمالية الاستوائية، تزرع أحياناً لزهورها الأرجوانية والبيضاء) / بازلاء الفراشة, كليتوريا ماريانا (كرمة برية ملتفة كبيرة الزهر في جنوب شرق ووسط الولايات المتحدة لها أزهار زرقاء شاحبة) / بازلاء الفراشة, بازلاء زرقاء (كرمة من آسيا الاستوائية لها أوراق ريشية وأزهار زرقاء زاهية بمراكز صفراء)",
 "蝶貝": "أَبْيَض الشَّفَتَيْن مِنَ الخَوْف (ابيضّت شفتاه من الخوف أو الرعب)",
 "蝶道": "مسار طيران, ممر جوي (طريق محدد تتبعه الطائرات في الطيران من مطار إلى آخر) / مسار الطيران (مسار صاروخ أو مقذوف أو طائرة عبر الهواء)",
 "蝶野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "蝶鮫": "حَفْش (دخل في شيءٍ بسرعة أو اقتحمَه بطريقة مفاجئة؛ عمل شيئًا بسرعة أو دون تدقيق)",
 "蝸牛": "حَلَزُون / حَلَزُون / قوقعة (الأنبوب الحلزوني الشكل (في الأذن الداخلية ملفوف حول العُميد) حيث تتحول الاهتزازات الصوتية إلى نبضات عصبية بواسطة عضو كورتي)",
 "蝸牛殻": "قوقعة (الأنبوب الحلزوني الشكل (في الأذن الداخلية ملفوف حول العُميد) حيث تتحول الاهتزازات الصوتية إلى نبضات عصبية بواسطة عضو كورتي)",
 "蝸牛角上": "تضييع الوقت, عبث (الفعل المتعمد للتأخير واللعب بدلاً من العمل) / زَهِيد, ضَئِيل (لَا يَسْتَحِقُّ الاِعْتِبَار)",
 "蝿": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة. / جلي, دعك (فعل تنظيف سطح بفركه بفرشاة وصابون وماء) / غَيْر مُنْتَقًى ((عن الحيوانات الداجنة) لم تتمّ تربيتها بشكل انتقائيّ) / أدغال, شجيرات قصيرة (نباتات كثيفة تتكون من أشجار متقزمة أو شجيرات)",
 "蝿取": "مصيدة ذباب (فخ لصيد الذباب)",
 "蝿取り": "مصيدة ذباب (فخ لصيد الذباب)",
 "蝿取り紙": "ورق صائد الذباب (ورق مسمم أو مطلي بمادة لزجة لقتل الذباب)",
 "蝿取紙": "ورق صائد الذباب (ورق مسمم أو مطلي بمادة لزجة لقتل الذباب)",
 "蝿叩き": "مضرب الذباب, منشة ذباب (أداة ذات جزء مسطح (من شبكة أو بلاستيك) ومقبض طويل؛ تستخدم لقتل الحشرات)",
 "蝿座": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة.",
 "蝿蛆症": "تتدود, نغف (إصابة الجسم بيرقات الذباب (عادة من خلال جرح أو فتحة أخرى) أو أي مرض ناتج عن هذه الإصابة)",
 "融ける": "ذَابَ, انْصَهَرَ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا فشيئًا، مثل ذوبان الجليد أو اختفاء الألم)\nمثال: ذاب ذلك الجليد. / تلاشي تدريجي, مزج ((في الفيلم) انتقال تدريجي من مشهد إلى التالي؛ يتم تركيب المشهد التالي تدريجياً بينما يتلاشى المشهد السابق)",
 "融け水": "ماء ذائب (الثلج أو الجليد المذاب)",
 "融剤": "تغير مستمر, تقلب (في تغيير مستمر) / كثافة التدفق ((فيزياء) عدد التغيرات في تدفق الطاقة عبر سطح معين لكل وحدة مساحة) / تدفق, سيلان (جريان أو تصريف) / فيض مغناطيسي, مجال مغناطيسي (خطوط القوة المحيطة بمغناطيس دائم أو جسيم مشحون متحرك)\nمثال: آراؤه في تقلب مستمر",
 "融化": "أَذَابَ (فعل تعدي من ذَابَ بمعنى جعله يَذُوبُ) / ذَابَ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا فشيئًا، مثل ذوبان الجليد أو اختفاء الألم)",
 "融合": "إلصاق (بناء الكلمات من المورفيمات المكونة التي تحتفظ بشكلها ومعناها في عملية الجمع) / تراص, تلازن (تكتل البكتيريا أو الخلايا الحمراء عند ربطها معًا بواسطة الأجسام المضادة (الراصات)) / تراص, تلازن (التحام الجزيئات الصغيرة العالقة في محلول؛ مما يؤدي عادة إلى ترسب هذه الكتل الأكبر)",
 "融和": "اِنْسِجَام, تَوَافُق",
 "融朗": "سُطُوع",
 "融氷期": "أَذَابَ (فعل تعدي من ذَابَ بمعنى جعله يَذُوبُ) / ذَابَ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا فشيئًا، مثل ذوبان الجليد أو اختفاء الألم)\nمثال: ذاب ذلك الجليد.",
 "融氷液": "مذيب الجليد, مزيل الصقيع (سخان يزيل الجليد أو الصقيع (كما هو الحال من الزجاج الأمامي أو الثلاجة أو أجنحة الطائرة))",
 "融点": "نقطة الانصهار, نقطة التجمد (درجة الحرارة التي يتحول تحتها السائل إلى صلب)",
 "融着": "اِنْدِمَاج / ذَوَبَان (تحول الجامد إلى سائل) / اِتِّحَاد (اِتِّحَاد؛ الاتِّحاد الأوربيّ : (السياسة) اتِّحاد أوربيّ إقليميّ أنشئ بمقتضى معاهدة ماستريخت في عام 1993 م…)\nمثال: عاش الاتحاد السوفيتي!",
 "融解": "اِنْصِهَار, ذَوَبَان (صَهَرَ (الشَّيْءَ) ، كالشّحْمِ ونَحْوِه، يَصْهَرُه صَهْراً: (أَذابَه، فانْصَهَرَ، فَهُوَ صَهِيرٌ)…؛ انصهر المعدن ينصهر انصهاراً:ذاب بفعل الحرارة،تحوّل من حالة صلبة إلى حالة سائلة)",
 "融解点": "نقطة الانصهار, نقطة التجمد (درجة الحرارة التي يتحول تحتها السائل إلى صلب)",
 "融解熱": "حرارة الانصهار (حرارة تمتصها وحدة كتلة من مادة صلبة عند نقطة انصهارها لتحويل المادة الصلبة إلى سائل عند نفس درجة الحرارة)\nمثال: حرارة الانصهار تساوي حرارة التجمد",
 "融資": "تمويل (عملية التمويل)",
 "融資枠": "سطر الكاتب (سطر يعطي اسم كاتب قصة أو مقال) / حد ائتماني, خط ائتمان (الحد الأقصى للائتمان المسموح به للعميل)",
 "融通": "إعارة, إقراض (التصرف في المال أو الممتلكات مع توقع إعادة نفس الشيء (أو ما يعادله)) / تكيف, قابلية للتكيف (القدرة على التغيير (أو التغيّر) لتناسب الظروف المتغيرة)",
 "融通性": "مُرُونة",
 "融通無碍": "حُرُّ الحَرَكَة, مُتَعَدِّدُ الاتِّجَاهَات (قَادِرٌ عَلَى التَّحَرُّكِ بِحُرِّيَّةٍ فِي جَمِيعِ الاتِّجَاهَات) / مُتَعَدِّدُ الْمَوَاهِبِ, مُتَنَوِّعُ الْمَهَارَاتِ (كُفء في مجالات عديدة وقادر على الانتقال بسهولة بينها) / غَيْرُ ثَابِت, مُتَلَوِّن (مُتَغَيِّرٌ أَوْ غَيْرُ مُسْتَقِرّ) / مُتَشَعِّب, وَاسِعُ التَّنَوُّع (ذُو تَنَوُّعٍ كَبِيرٍ وَاتِّسَاعٍ فِي المَجَالَات)",
 "融通無礙": "حُرُّ الحَرَكَة, مُتَعَدِّدُ الاتِّجَاهَات (قَادِرٌ عَلَى التَّحَرُّكِ بِحُرِّيَّةٍ فِي جَمِيعِ الاتِّجَاهَات) / مُتَعَدِّدُ الْمَوَاهِبِ, مُتَنَوِّعُ الْمَهَارَاتِ (كُفء في مجالات عديدة وقادر على الانتقال بسهولة بينها) / غَيْرُ ثَابِت, مُتَلَوِّن (مُتَغَيِّرٌ أَوْ غَيْرُ مُسْتَقِرّ) / مُتَشَعِّب, وَاسِعُ التَّنَوُّع (ذُو تَنَوُّعٍ كَبِيرٍ وَاتِّسَاعٍ فِي المَجَالَات)",
 "螟虫": "ثاقبة الخشب, حفار الخشب (أي من الحشرات أو اليرقات أو الرخويات المختلفة التي تحفر في الخشب) / ريشة حفر الصخر, مثقاب الصخور (مثقاب لاختراق الصخور)",
 "螟蛾": "عثة بيراليد (عثة استوائية عادة نحيلة الجسم طويلة الأرجل تعتبر يرقاتها آفات للمحاصيل)",
 "螢": "يَرَاعَة, حُبَاحِب",
 "螢光": "تالق, فلورة (ضوء ينبعث أثناء امتصاص إشعاع ذي طول موجي آخر (غير مرئي))",
 "螢火": "جَمْرَة",
 "螢石": "فلسبار, فلوريت (معدن ناعم (فلوريد الكالسيوم) مشع في الضوء فوق البنفسجي؛ المصدر الرئيسي للفلور)",
 "螯": "كَلْبَتَان",
