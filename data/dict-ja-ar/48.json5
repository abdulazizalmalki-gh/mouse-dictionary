 "静脈穿刺": "بزل الوريد, فصد ((طب) ثقب الوريد عبر الجلد لسحب الدم للتحليل أو لبدء تقطير وريدي أو لحقن الدواء)",
 "静脈血": "دم وريدي (الدم الموجود في الأوردة)\nمثال: باستثناء الوريد الرئوي، يكون الدم الوريدي غنياً بثاني أكسيد الكربون وفقيراً بالأكسجين",
 "静脈血栓症": "تخثر وريدي (تخثر الوريد دون التهاب سابق للوريد؛ يرتبط ببطء تدفق الدم (كما في الراحة الطويلة في الفراش أو الحمل أو الجراحة) أو بتخثر سريع للدم)",
 "静脈麻酔薬": "مخدر وريدي (مخدر ينتج التخدير عند حقنه في الدورة الدموية)",
 "静荷重": "ثقل ساكن, وزن ميت (وزن ثقيل لا يتحرك) / عبء ثقيل (عائق قمعي أو ثقيل)",
 "静菌": "ركود جرثومي, كبح البكتيريا (تثبيط نمو البكتيريا)",
 "静謐": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام.",
 "静電": "كهرباء ساكنَة / كهروستاتيكي, كهروسكوني (معني بـ أو منتج لـ أو ناتج عن الكهرباء الساكنة)\nمثال: مولد كهروستاتيكي ينتج كهرباء ساكنة عالية الجهد",
 "静電プリンタ": "طابعة كهروستاتيكية (طابعة تستخدم شحنة كهربائية لترسيب الحبر الجاف (التونر) على الورق)",
 "静電単位": "وحدة كهروستاتيكية (أي من وحدات الكهرباء المختلفة القائمة على قوى التفاعل بين الشحنات الكهربائية)",
 "静電印字装置": "طابعة كهروستاتيكية (طابعة تستخدم شحنة كهربائية لترسيب الحبر الجاف (التونر) على الورق)",
 "静電場": "مجال كهروستاتيكي, مجال كهروسكوني (مجال كهربائي مرتبط بشحنات كهربائية ساكنة)",
 "静電容量": "مكثف (جهاز كهربائي يتميز بقدرته على تخزين شحنة كهربائية) / سعة كهربائية, مواسعة (ظاهرة كهربائية يتم فيها تخزين شحنة كهربائية)",
 "静電気": "كهرباء ساكنَة",
 "静電気プリンタ": "طابعة كهروستاتيكية (طابعة تستخدم شحنة كهربائية لترسيب الحبر الجاف (التونر) على الورق)",
 "静静": "بِهُدُوء",
 "静音": "صَامِت, سَاكِت",
 "静音化": "رُطُوبة",
 "静音性": "انعدام الصوت, هدوء (خاصية عدم إصدار أي صوت) / سكون, طمأنينة (حالة من السلام والهدوء)",
 "静養": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة.",
 "非": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي.",
 "非ざる": "لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة.",
 "非ず": "لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة.",
 "非ずんば": "إِلَّا (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لا أعرف إلا هذا.",
 "非と": "إِدَانِيّ, شَاجِب (يتضمن أو يفرض الإدانة أو التوبيخ)",
 "非の打ちどころ": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي.",
 "非の打ち所": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي.",
 "非の打ち所がない": "بِلَا عَيْب, لَا تَشُوبُهُ شَائِبَة (خَالٍ مِنَ العَيْبِ أَوِ الخَطَأ)",
 "非の打ち所が無い": "بِلَا عَيْب, لَا تَشُوبُهُ شَائِبَة (خَالٍ مِنَ العَيْبِ أَوِ الخَطَأ)",
 "非の打ち所のない": "مَعْصُوم, كَامِل / مَعْصُوم",
 "非アクティブ化": "إبطال مفعول, تعطيل (فعل التعطيل أو جعل الشيء غير فعال (مثل القنبلة)) / تعطيل, حل الوحدة (تفكيك وحدة عسكرية (عن طريق النقل أو التسريح))",
 "非イオン系合成洗剤": "منظف أنيوني, منظف لا أيوني (فئة من المنظفات الاصطناعية التي لا تتأين جزيئاتها في المحاليل المائية)",
 "非シールド": "غَيْر مُدَرَّع ((خاصة عن الآلات) غير محميّ بدرع واقٍ)",
 "非ステロイド性抗炎症薬": "مضاد التهاب غير ستيرويدي (دواء مضاد للالتهاب لا يحتوي على الستيرويدات)\nمثال: مضادات الالتهاب غير الستيرويدية تثبط نشاط كل من إنزيمات كوكس-1 وكوكس-2",
 "非フレーム形式": "غير مؤطر (غير مزود بإطار)\nمثال: صور غير مؤطرة",
 "非モテ": "غير رائج, غير شعبي (يُنظر إليه بعدم رضا أو يفتقر إلى القبول العام)\nمثال: أفكار غير شعبية",
 "非ユークリッド幾何学": "هندسة لاإقليدية ((رياضيات) هندسة قائمة على بديهيات تختلف عن بديهيات إقليدس)",
 "非上場": "غير مُدرج (غير موجود في قائمة) / غَيْرُ مُدْرَجٍ (لم يُدرج اسمه في قائمة الناخبين)\nمثال: رقم هاتف غير مدرج",
 "非主要": "صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة) / أصغر, أقلية (أقل في العدد أو الحجم أو المقدار) / بسيط, ثانوي (أقل في النطاق أو التأثير) / قاصر (لم يبلغ السن القانونية)\nمثال: حصة صغيرة من الأرباح",
 "非人情": "عديم الرحمة, قاسي القلب (يفتقر إلى الشعور أو الشفقة أو الدفء) / فَاقِدُ الشَّجَاعَة (خالٍ من الشجاعة أو الحماس)",
 "非人格化": "تجريد من الشخصية, تشييء (تمثيل إنسان كشيء مادي مجرد من الصفات الشخصية أو الفردية) / اختلال الإنية, تبدد الشخصية ((في الوجودية) فقدان الهوية الشخصية؛ شعور الفرد بأنه ترس مجهول في آلة اجتماعية غير شخصية) / اضطراب تبدد الشخصية, تبدد الشخصية (اضطراب انشقاقي عاطفي يحدث فيه فقدان للاتصال بالواقع الشخصي للفرد مصحوباً بمشاعر اللاواقعية والغرابة)\nمثال: وفقًا لماركس، فإن معاملة العمل كسلعة تجسد تشييء الفرد",
 "非人道": "فظاعة, وحشية (عمل من أعمال القسوة الفظيعة) / لَا إِنْسَانِيَّة, وَحْشِيَّة (صفة الافتقار إلى الرحمة أو مراعاة الآخرين)",
 "非人道性": "فظاعة, وحشية (عمل من أعمال القسوة الفظيعة) / لَا إِنْسَانِيَّة, وَحْشِيَّة (صفة الافتقار إلى الرحمة أو مراعاة الآخرين)",
 "非人道的": "غير إنساني, وحشي (يفتقر ويعكس الافتقار إلى الشفقة أو الرحمة)\nمثال: البشر غير إنسانيين فطرياً؛ هذا يفسر الكثير من البؤس والمعاناة في العالم",
 "非人間化": "التَّجْرِيد مِن الإنْسَانِيَّة",
 "非人間的": "غَيْر إِنْسَانِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "非公式": "غير رسمي (ليس رسمياً) / عامي, غير رسمي (يستخدم في اللغة المنطوقة والمكتوبة) / أَلِيف, حَمِيمِيّ (يُوَفِّرُ جَوًّا دَافِئًا وَوُدِّيًّا وَغَيْر رَسْمِيّ) / غَيْر رَسْمِيّ, فَضْفَاض (غير معترف به أو مُراقَب رسمياً)\nمثال: أناس محافظون غير معتادين على اللباس غير الرسمي",
 "非公認": "غير رسمي (ليس له سلطة أو إقرار رسمي) / غَيْر رَسْمِيّ, غَيْر مُثَبَّت (لم يُقَرّ أو يُثبَّت رسمياً)\nمثال: نوع من العمدة غير الرسمي",
 "非公開": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك.",
 "非凡": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "非凡人": "عَبْقَرِيّ, نَابِغَة / عَبْقَرِيَّة",
 "非力": "ضَعِيف, عَاجِز / عَاجِز, غَيْر مُؤَهَّل (لا يستوفي المتطلّبات اللازمة) / عاجز, غير كفء (غير مؤهل أو غير مناسب لغرض ما) / غير مؤهل, غير مختص قانونياً (غير مؤهل أو غير كافٍ قانونياً) / عَدِيم المَهَارَة, غَيْر كُفْء (لا يؤدي العمل بشكل جيد؛ يفتقر إلى الكفاءة)\nمثال: جهاز مخابرات غير كفء",
 "非効率": "غَيْرُ فَعَّال, غَيْرُ كَفُوء (يفتقر إلى القدرة أو المهارة اللازمة للأداء الفعّال؛ غير كافٍ) / غير كفء, مبذر (لا ينتج النتائج المرجوة؛ مسرف)\nمثال: حملة غير كفؤة ضد المخدرات",
 "非効率的": "غَيْرُ فَعَّال, غَيْرُ كَفُوء (يفتقر إلى القدرة أو المهارة اللازمة للأداء الفعّال؛ غير كافٍ) / غير كفء, مبذر (لا ينتج النتائج المرجوة؛ مسرف)\nمثال: حملة غير كفؤة ضد المخدرات",
 "非協力的": "غَيْر مُتَعَاوِن (غير متعاون عَمْدًا) / غير متعاون (غير راغب في التعاون)\nمثال: شاهد غير متعاون",
 "非友好": "عدائي, غير ودود (غير ميال للصداقة أو الود) / صعب الاستخدام, غير صديق للمستخدم (ليس سهلاً في الفهم أو الاستخدام) / غَيْر مُلَائِم, مُعَادٍ (غير ملائم للحياة أو النموّ إطلاقاً) / غَيْر وُدِّيّ, مُعَادٍ (ليس ودِّيّاً؛ يتَّسم بالجفاء)\nمثال: برود في التصرف غير ودود",
 "非可分": "عدم القابلية للقسمة ((في الحساب) حالة استحالة القسمة على عدد صحيح محدد دون ترك باقي)\nمثال: تعتمد أولية العدد على عدم قابلية كمية معينة للقسمة على ذلك العدد",
 "非可干渉的": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة) / غَيْر مُتَرَابِط ((في الفيزياء) لموجات ليس لها علاقة طور مستقرة أو محددة) / غَيْر مُتَرَابِط, مُفَكَّك (بدون اتصال منطقي أو ذي معنى)\nمثال: عرض منتفخ ومفكك",
 "非合法": "غَيْر قَانُونِيٍّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "非合法化": "حظر, منع (حظر رسمي أو مرسوم ضد شيء ما)",
 "非合理": "لَا مَنْطِقِيَّة (استدلال غير صالح أو غير صحيح)",
 "非合理的": "مُبَعْثَر, مُشَوَّش (يفتقر إلى الاستمرارية المنظمة) / غير منطقي (يفتقر إلى العلاقة المنطقية الصحيحة)",
 "非同期": "لَا مُتَزَامِن, لَا مُتَزَامِنَة (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "非同期式": "لَا مُتَزَامِن, لَا مُتَزَامِنَة (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "非同期転送モード": "وضع النقل غير المتزامن (وسيلة للاتصالات الرقمية قادرة على سرعات عالية جداً؛ مناسبة لنقل الصور أو الصوت أو الفيديو وكذلك البيانات)\nمثال: يستخدم وضع النقل غير المتزامن لكل من الشبكات المحلية والشبكات الواسعة",
 "非同盟": "عدم الانحياز (شعب (أو دول) غير متحالفين مع آخرين في حلف أو معاهدة)",
 "非営利": "منظمة غير ربحية (منظمة مرخصة لأنشطة غير ربحية)",
 "非営利団体": "منظمة غير ربحية (منظمة مرخصة لأنشطة غير ربحية)",
 "非営利的": "غَيْرُ رِبْحِيّ, غَيْرُ هَادِفٍ لِلرِّبْحِ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "非営利組織": "منظمة غير ربحية (منظمة مرخصة لأنشطة غير ربحية)",
 "非器": "عَجْز, عَدَم قُدْرَة (افتقاد القدرة على الأداء) / عجز, عدم قدرة (نقص القدرة (خاصة القدرة العقلية) لفعل شيء ما)",
 "非国営化": "خصخصة (تحويل شيء ما من ملكية الدولة أو سيطرتها إلى الملكية الخاصة)",
 "非国教徒": "خارج عن العرف, غير ممتثل (لا يمتثل لبعض المعايير أو الأنماط السلوكية أو الفكرية المقبولة اجتماعياً) / غَيْر مُمْتَثِل, مُخَالِف (لا يمتثل للعادات أو المذاهب الراسخة خاصة في الدين) / خارج عن المألوف, غير ممتثل (شخص يرفض الامتثال لمعايير السلوك الراسخة) / غير ملتزم, منشق عن الكنيسة الرسمية (بروتستانتي في إنجلترا ليس عضواً في كنيسة إنجلترا)\nمثال: سلوكهم غير الممتثل بشدة جعلهم أسطوريين",
 "非国民": "خَائِن, خَائِنَة (الشخص الذي قام بالخِيَانَة)\nمثال: نمر مفترس أمامك خير من خائن ورائك!",
 "非圧縮": "غير قابل للانضغاط (غير قابل للضغط؛ يقاوم الانضغاط)\nمثال: أكوام من القمامة غير القابلة للانضغاط",
 "非婚": "أعزب, غير متزوج (غير متزوج أو يتعلق بحالة العزوبية)\nمثال: رجال ونساء غير متزوجين",
 "非嫡出子": "ابن غير شرعي, نغل (النسل غير الشرعي لأبوين غير متزوجين)",
 "非宗教主義": "عَلْمَانِيَّة, لَائِكِيَّة",
 "非定型": "حُرّ (ضد البَرْد) / شَاغِر, فَاضٍ / بِغَيْرِ, بِدُونِ / مَجَّانًا / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: أنا حر كالطائر. / غَيْر مُنْتَظِم, لَا نَمَطِيّ (ينحرف عن التوقعات الطبيعية؛ غريب أو شاذ بعض الشيء) / شاذ, غير نمطي (لا يمثل مجموعة أو فئة أو نوعًا)\nمثال: فئة من الطحالب غير النموذجية",
 "非定型肺炎": "التهاب رئوي لانمطي (مرض تنفسي حاد يتميز بحمى عالية وسعال)",
 "非定形動詞": "غير متصرف, غير محدد ((عن الأفعال) ليس له زمن أو شخص أو عدد (مثل اسم الفاعل أو المصدر أو صيغة المصدر))\nمثال: صيغة فعل غير محددة",
 "非実際的": "غير عملي (ليس عملياً؛ غير قابل للتطبيق أو لا يهتم بالأمور العملية) / خَيَالِيّ, غَيْرُ وَاقِعِيّ (غَيْرُ عَمَلِيٍّ وَلَا قَابِلٍ لِلتَّحْقِيق؛ تَأَمُّلِيّ)\nمثال: تعويم السفينة ثبت أنه غير عملي بسبب التكلفة",
 "非対応": "غير متوافق, غير منسجم (غير متوافق) / غير متوافق ((تقنياً) غير قابل للاستخدام مع أو الاتصال بأجهزة أو مكونات أخرى دون تعديل) / غَيْرُ مُتَجَانِس ((خاصةً المواد الصلبة أو المحاليل) غير قابل للامتزاج في خليط متجانس ومستقرّ) / غير متوافق, غير ملائم (غير مناسب لأذواقك أو احتياجاتك)\nمثال: شخصيات غير متوافقة",
 "非対称": "عَدَم تَنَاسُق (الفقدان ونقيض الوجود؛ يجب عدم فعل كذا: أي يجب الامتناع عن الفعل)\nمثال: عليك عدم الخوف.",
 "非居住者": "غير مقيم (لا يعيش في مكان معين أو مملوك لمقيمين دائمين) / غَيْر مُقِيم (شخص لا يعيش في مكان معين)\nمثال: طلاب غير مقيمين يتنقلون إلى الفصول",
 "非常": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ / الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ.",
 "非常に": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "非常ブレーキ": "مكبح الطوارئ, مكبح يدوي (مكبح يعمل باليد؛ يعمل عادة عن طريق وصلة ميكانيكية)",
 "非常ベル": "جرس الإنذار, ناقوس الخطر (صوت إنذار (عادة جرس))",
 "非常信号": "إِنْذَار",
 "非常勤": "وَظِيفَة بِدَوَامٍ جُزْئِيّ, عَمَل جُزْئِيّ (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "非常勤講師": "وَظِيفَة بِدَوَامٍ جُزْئِيّ, عَمَل جُزْئِيّ (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "非常口": "مخرج طوارئ\nمثال: その建物には非常口がない。 — ليس لهذه البناية مخرج للطوارئ.",
 "非常時": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "非常線": "شريط زينة, وشاح (زينة تتكون من شريط أو حبل مزخرف) / شريط, وشاح (حبل أو شريط يلبس كشارة شرف أو رتبة) / طوق, كردون (سلسلة من الحراس أو المراكز العسكرية تحيط أو تحرس مكاناً أو شيئاً ما)",
 "非常識": "طيش, عدم اكتراث (سمة عدم التفكير بعناية قبل التصرف) / اسْتِهْتَار, طَيْش (صفة الفشل في مراعاة شعور الآخرين)",
 "非常階段": "مخرج طوارئ",
 "非常駐": "مُؤَقَّت, سَريع الزوال",
 "非干渉的": "عَاجِز عَن التَّعْبِير, مُتَلَعْثِم (غير قادر على التعبير عن نفسه بوضوح أو طلاقة) / غَيْر مُتَرَابِط ((في الفيزياء) لموجات ليس لها علاقة طور مستقرة أو محددة) / غَيْر مُتَرَابِط, مُفَكَّك (بدون اتصال منطقي أو ذي معنى)\nمثال: عرض منتفخ ومفكك",
 "非循環的": "لاحلقي, مفتوح السلسلة (له هيكل سلسلة مفتوحة) / لاحلقي, لاسواري (غير حلقي؛ خاصة وجود أجزاء مرتبة في لوالب بدلاً من دوارات)",
 "非情": "قَاسٍ, مُتَحَجِّر المَشَاعِر (متصلّب عاطفيًّا؛ فاقد للرقّة الإنسانية) / سَمِيك الجِلْد, مُتَثَفِّن (عليه ثفن؛ ذو جلد أصبح سميكًا وخشنًا من كثرة الاستعمال) / بِلَا شُعُور, جَامِد (خالٍ من الشعور والوعي والحيوية)\nمثال: حجر جامد",
 "非戦論": "سَلَامِيَّة, سِلْمِيَّة",
 "非戦論者": "مُسَالِم / مُسَالِمَة",
 "非戦闘員": "مَدَنِيّ / مَدَنِيَّة",
 "非手指動作": "نانومتر (وحدة مترية للطول تساوي واحداً من المليار من المتر)",
 "非才": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات) / عجز, قصور (عدم قدرة جزء أو عضو على العمل بشكل صحيح)",
 "非承認": "غَيْر مُخَوَّل, غَيْر مُصَرَّح بِه (غير ممنوح السلطة) / غَيْر مَأْذُون, غَيْر مُصَرَّح بِه (بدون تصريح أو إذن رسميّ)",
 "非排水": "غير مُجفف, غير مُصرَّف (لم يتم تصريف محتواه)\nمثال: الحفاظ على الأراضي الرطبة: إبقاؤها غير مجففة",
 "非政府組織": "مُنَظَّمَة غَيْر حُكُومِيَّة",
 "非政治的": "لَا سِيَاسِيّ, مُحَايِد سِيَاسِيًّا (محايد من الناحية السياسية)",
 "非数": "خبز النان (خبز مخمر يخبز في فرن طيني في الهند؛ عادة ما يكون على شكل دمعة) / جدة (والدة أبيك أو أمك) / جدة (جدتك (مصطلح غير رسمي))",
 "非日常": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "非日常性": "اسْتِثْنَائِيَّة, غَرَابَة (صفة كون الشيء استثنائياً وغير مألوف)",
 "非日常的": "اِسْتِثْنَائِيّ, غَيْرُ عَادِيّ",
 "非晶質": "عَدِيم الشَّكْل, لَابَلُّورِيّ (بِدُون شَكْلٍ بَلُّورِيٍّ حَقِيقِيٍّ أَوْ ظَاهِر) / عَشْوَائِيّ, مُبْهَم (غامض بسبب ضعف التنظيم أو عدم الوضوح) / غَيْر مُتَبَلْوِر, لَا شَكْلِيّ ((يوصف بمجموعة من الناس أو منظمة) غير منظم أو غير مركز) / غَيْر مُهَيْكَل, لَا شَكْلِيّ (يفتقر للنظام أو البنية المميزة للأجسام الحية)",
 "非暴力": "لاعنف",
 "非暴力・不服従": "لَا عُنْف, مُقَاوَمَة سَلْبِيَّة (مقاومة سلمية للحكومة عن طريق الصيام أو رفض التعاون)",
 "非暴力不服従": "لَا عُنْف, مُقَاوَمَة سَلْبِيَّة (مقاومة سلمية للحكومة عن طريق الصيام أو رفض التعاون)",
 "非暴力抵抗": "لَا عُنْف, مُقَاوَمَة سَلْبِيَّة (مقاومة سلمية للحكومة عن طريق الصيام أو رفض التعاون)",
 "非有界": "بِلَا حُدُود, لَامَحْدُود (يَبْدُو بِلَا حُدُودٍ فِي الكَمِّيَّةِ أَوِ العَدَدِ أَوِ الدَّرَجَةِ أَوِ المَدَى)",
 "非業の最期": "قتل, موت عنيف (حدث يتسبب في موت شخص ما)",
 "非業の死": "قتل, موت عنيف (حدث يتسبب في موت شخص ما)",
 "非構造制約集合": "عشوائي, غير مهيكل (يفتقر لهيكل محدد أو تنظيم) / غَيْر مُهَيْكَل, لَا شَكْلِيّ (يفتقر للنظام أو البنية المميزة للأجسام الحية)\nمثال: وضع غير منظم بلا مسؤول",
 "非正則行列": "مصفوفة منفردة (مصفوفة مربعة يساوي محددها صفراً)",
 "非正規": "شَاذّ, غَيْر مُنْتَظِم / دُون الطَّبِيعِيّ (أقل من المستوى الطبيعي أو المتوسط) / دون الطبيعي (شخص ذكاؤه أقل من الطبيعي)",
 "非正規労働者": "موظف مؤقت (عامل (خاصة في مكتب) يتم تعيينه على أساس مؤقت)",
 "非武装": "أَعْزَل",
 "非武装地帯": "مِنْطَقَةُ مَنْزُوعَةُ السَلَاح (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "非毀": "تَشْهِير, بُهْتَان",
 "非民主": "غير ديمقراطي (لا يتفق مع أو لا يتوافق مع العقيدة أو الممارسة أو المثل الديمقراطية)\nمثال: قطعت النقابة علاقتها بإجراءاتها غير الديمقراطية السابقة",
 "非活動": "خَامِد",
 "非活性": "خَامِد",
 "非浸潤性乳管がん": "مدير الاستخبارات المركزية (رئيس مجتمع الاستخبارات الأمريكي ومدير وكالة المخابرات المركزية)",
 "非点収差": "لَابُؤْرِيّة, اللَانُقَطِيَّة",
 "非熱処理": "غير مبستر (لم يخضع للبسترة)",
 "非特異性": "غير محدد, لا نوعي (غير ناتج عن عامل محدد؛ يستخدم أيضاً للتلوين في إعداد الشرائح المجهرية)\nمثال: التهاب الأمعاء اللا نوعي",
 "非特異的": "غير محدد, لا نوعي (غير ناتج عن عامل محدد؛ يستخدم أيضاً للتلوين في إعداد الشرائح المجهرية)\nمثال: التهاب الأمعاء اللا نوعي",
 "非現実": "لَا وَاقِعِيَّة, وَهْم (الصفة التي يمتلكها شيء غير حقيقي) / لا واقعية, وهمية (حالة كون الشيء غير جوهري أو خيالي؛ لا وجود له موضوعياً أو في الواقع) / عدم واقعية (عدم الكفاءة في التعامل مع الواقع)",
 "非現実性": "لَا وَاقِعِيَّة, وَهْم (الصفة التي يمتلكها شيء غير حقيقي) / لا واقعية, وهمية (حالة كون الشيء غير جوهري أو خيالي؛ لا وجود له موضوعياً أو في الواقع) / عدم واقعية (عدم الكفاءة في التعامل مع الواقع)",
 "非現実的": "غير واقعي (ليس واقعياً)\nمثال: توقعات غير واقعية",
 "非球面": "لَاكُرَوِيّ (يختلف قليلاً عن الشكل الكروي التامّ)",
 "非理": "غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / غير معقول, غير منطقي (غير معقول؛ لا يظهر حكماً صائباً)",
 "非生産的": "غَيْرُ مُثْمِر, غَيْرُ مُنْتِج (لا يُنتج النتائج المرجوّة) / عقيم, غير مثمر (لا ينتج أو غير قادر على الإنتاج)\nمثال: القضاء على الصناعات عالية التكلفة أو غير المنتجة",
 "非直結": "غَيْر مُتَّصِل, غَيْر مُتَوَاجِد (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "非礼": "قلة أدب, وقاحة (أسلوب غير مهذب يتجاهل العرف الاجتماعي المقبول)",
 "非社交的": "انطوائي, غير اجتماعي (لا يميل إلى المجتمع أو الرفقة)\nمثال: طبيعة غير اجتماعية؛ خجول ومتحفظ",
 "非神話化": "عقلنة, نزع الأسطورة (إعادة صياغة رسالة (دينية مثلاً) بمصطلحات عقلانية)",
 "非科学的": "غير علمي (لا يتسق مع أساليب أو مبادئ العلم)\nمثال: افتقار غير علمي للموضوعية",
 "非競合的": "غير تنافسي (لا ينطوي على منافسة أو روح تنافسية)\nمثال: وظائف غير تنافسية",
 "非結晶性": "عَدِيم الشَّكْل, لَابَلُّورِيّ (بِدُون شَكْلٍ بَلُّورِيٍّ حَقِيقِيٍّ أَوْ ظَاهِر) / عَشْوَائِيّ, مُبْهَم (غامض بسبب ضعف التنظيم أو عدم الوضوح) / غَيْر مُتَبَلْوِر, لَا شَكْلِيّ ((يوصف بمجموعة من الناس أو منظمة) غير منظم أو غير مركز) / غَيْر مُهَيْكَل, لَا شَكْلِيّ (يفتقر للنظام أو البنية المميزة للأجسام الحية)",
 "非結晶質": "عَدِيم الشَّكْل, لَابَلُّورِيّ (بِدُون شَكْلٍ بَلُّورِيٍّ حَقِيقِيٍّ أَوْ ظَاهِر) / عَشْوَائِيّ, مُبْهَم (غامض بسبب ضعف التنظيم أو عدم الوضوح) / غَيْر مُتَبَلْوِر, لَا شَكْلِيّ ((يوصف بمجموعة من الناس أو منظمة) غير منظم أو غير مركز) / غَيْر مُهَيْكَل, لَا شَكْلِيّ (يفتقر للنظام أو البنية المميزة للأجسام الحية)",
 "非線型": "غير خطي (يصف أو يتضمن معادلة تكون حدودها ليست من الدرجة الأولى)",
 "非線形": "غير خطي (يصف أو يتضمن معادلة تكون حدودها ليست من الدرجة الأولى)",
 "非能率": "عدم كفاءة (نقص المهارة الناتج عن نقص الكفاءة)",
 "非良心的": "عديم الضمير, متجرد من المبادئ (بلا وازع أو مبادئ أخلاقية)\nمثال: السياسيون عديمو الضمير الذين يسعدهم بيع بلادهم من أجل السلطة",
 "非芸術的": "عَدِيم الذَّوْق الفَنِّيّ (يفتقر إلى الحس الجمالي)",
 "非行": "انحراف الأحداث, جنوح (سلوك معاد للمجتمع ينتهك القانون يرتكبه قاصر) / إهمال, جنوح (الميل للإهمال وعدم الاكتراث) / تأخر في السداد, جنحة مالية (عدم سداد دين عند استحقاقه)\nمثال: ورث جنوحه عن أبيه",
 "非行少年": "جانح, حدث جانح (مذنب شاب)",
 "非衛生": "غير صحي, ملوث (ليس صحيًا أو نظيفًا)\nمثال: مجاري مفتوحة غير صحية",
 "非表示": "مُخْفًى, خَفِيّ (مُخْفَى هُوَ؛ مُخْفِي أَوْ مُخْفٍ) / أَخْفَى, خَبَأَ / اِخْتَبَأَ (فعل مطاوعة لأَخْبَأَ، أخبأْتُهُ فأخْتَبَأ؛ خَبَّأ نفسه متعمدًا، أي أخْفَى نفسه عن الناس فلا يعلمون مكانه) / إِهَاب, جِلْد\nمثال: أين اختبأ ياني؟",
 "非課税": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب) / ورقة مالية معفاة من الضرائب (ورقة مالية لا تخضع للضرائب)",
 "非課税品": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب)",
 "非調和": "مُتَنَافِر",
 "非論理的": "مُبَعْثَر, مُشَوَّش (يفتقر إلى الاستمرارية المنظمة) / غير منطقي (يفتقر إلى العلاقة المنطقية الصحيحة)",
 "非識字": "أُمِّيَّة",
 "非議": "نَقْد, اِنْتِقَاد",
 "非負整数": "عَدَد صَحِيح (أي من الأعداد الطبيعية (الموجبة أو السالبة) أو الصفر)\nمثال: العدد الصحيح هو عدد ليس كسراً",
 "非買同盟": "قَاطَعَ / مُقَاطَعَة",
 "非軍事": "غَيْر عَسْكَرِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "非連続": "مُتَقَطِّع",
 "非連続性": "انقطاع, عدم استمرارية (عدم الاتصال أو الاستمرارية)",
 "非連続的": "مُتَقَطِّع",
 "非運": "مُصِيبَة, شَقْوَة",
 "非道": "ظَالِم, جَائِر",
 "非道徳的": "فاسد, لا أخلاقي (ينتهك عمداً المبادئ المقبولة للصواب والخطأ) / فَاسِد, لَا أَخْلَاقِيّ (لا يلتزم بالمبادئ الأخلاقية أو القِيَمية)",
 "非違": "لَا قَانُونِيَّة, مُخَالَفَة القَانُون (عدم المشروعية بحكم انتهاك قانون تشريعي ما)",
 "非適用": "لَا ينطبق (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "非金属": "لا فلزي, لا معدني (لا يحتوي على معدن ولا يشبهه ولا يتسم بخصائصه) / لا فلز (عنصر كيميائي يفتقر إلى الخصائص الفلزية النموذجية)\nمثال: عناصر لا فلزية",
 "非開示合意": "اِتِّفَاقِيَّة عَدَم الإِفْصَاح, اِتِّفَاقِيَّة عَدَم الْإِفْشَاء",
 "非難": "نَقْد, اِنْتِقَاد",
 "非難がましい": "تَأْدِيبِيّ, عَتَابِيّ (يُعَبِّر عَنِ التَّوْبِيخ أَوِ اللَّوْم خَاصَّةً بِغَرَض التَّصْحِيح)",
 "非難を浴びせる": "ضربة قوية (كرة طائرة طويلة جداً) / انْتِقَاد شَدِيد, هُجُوم (نقد سلبي مكثف) / متعة, وقت ممتع (تجربة ممتعة أو مثيرة للغاية) / انفجار, دوي (ضجيج عالٍ جداً ومفاجئ)\nمثال: وجه كلينتون هجومه إلى الحزب الجمهوري",
 "非零": "غَيْرُ صِفْرِيّ (لَا يَتَضَمَّنُ الصِّفْرَ)",
 "靡かす": "أَغْرَى, أَغْوَى",
 "靡かせる": "ذُبَابَة, دبان (حشرة صغيرة سوداء اللون معروفة) / طَارَ / طار\nمثال: أمسك بتلك الذبابة.",
 "靡く": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / أَطَاعَ",
 "面": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / خَدّ (شَقَّ أو حَفَرَ في الأرض خطاً طويلاً أو أثراً عميقاً؛ أثَّر على سطحٍ ما بترك علامات أو شقوق) / وَجْنَة\nمثال: قبلتني على الخد. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع. / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / صَفْحَة, صفحة",
