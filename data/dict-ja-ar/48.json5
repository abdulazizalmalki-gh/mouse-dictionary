 "蒸汽船": "بَاخِرَة, سَفِينَة بُخَارِيَّة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار)\nمثال: الباخرة الآن في الميناء.",
 "蒸溜": "تَقْطِير",
 "蒸溜所": "معمل تقطير, مقطرة (مصنع ومنشآت يتم فيها صنع المشروبات الكحولية عن طريق التقطير)",
 "蒸煮": "سلق, غلي (الطهي في سائل تم غليه)",
 "蒸熱": "بشكل حار جداً, بغلليان ((تستخدم للحرارة) للغاية)\nمثال: كان الطبق ساخناً جداً / حَارّ رَطْب, خَانِق (يتَّسم بحرارة ورطوبة خانقتَين)",
 "蒸留": "تَقْطِير",
 "蒸留器": "سَاكِن, ثَابِت\nمثال: لا أحب المدرسة.",
 "蒸留所": "معمل تقطير, مقطرة (مصنع ومنشآت يتم فيها صنع المشروبات الكحولية عن طريق التقطير)",
 "蒸留水": "ماء مقطر (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما…)\nمثال: أنا أشرب الماء.",
 "蒸留酒": "كُحُول, خَمْر (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ…)\nمثال: أكره ذوق الكحول.",
 "蒸発": "تتجفاف, تجفيف (عملية استخلاص الرطوبة) / اِخْتِفَاء",
 "蒸発岩": "متبخرات (الراسب المتبقي بعد تبخر مياه البحر)",
 "蒸解": "طَبْخ (أَنْضَجَ الطعام بتسخينه)\nمثال: سامي يحب الطبخ.",
 "蒸返す": "اجترار, تكرار (مادة قديمة تم إعادة صياغتها قليلاً واستخدامها مرة أخرى)\nمثال: مجرد اجترار ممل لروايته الأولى",
 "蒸風呂": "حمام بخار, حمام تركي (التعرق في غرفة بخار قبل الحصول على تدليك ودش بارد)",
 "蒸餅": "خُبْز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو…)\nمثال: هذا الخبز لذيذ.",
 "蒼": "حَزِين\nمثال: هذا البناء أزرق. / أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات…)\nمثال: ذلك الضوء أخضر. / ضَوْء أَخْضَر (النُّور؛ مصدر ضَاء)\nمثال: ضوء القمر ضعيف. / أَسْوَد, سَوْدَاء (هو لَوْن مُظلم غَامِق لا يُبان منه. سميّ كذلك لأنه يسود على غيره من الألوان…)\nمثال: لديه قميص أسود.",
 "蒼々": "حَزِين\nمثال: هذا البناء أزرق. / أَخْضَر, مُخْضَرّ (يتّسم بوَفْرة الخُضْرة والنبات) / رَمَادِيّ (بلون لا لوني متوسط بين الأبيض والأسود)",
 "蒼い": "حَزِين\nمثال: هذا البناء أزرق. / أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات…)\nمثال: ذلك الضوء أخضر. / بَاهِت, شَاحِب / غير ناضج, فج (غير مكتمل النمو أو النضج؛ غير يانع)\nمثال: فاكهة غير ناضجة",
 "蒼古": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "蒼天": "زرقة السماء, سماء زرقاء (السماء كما تُرى في وضح النهار)\nمثال: أطلق سهماً في كبد السماء / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "蒼惶": "بسرعة, بعجلة (بطريقة سريعة أو متسرعة)\nمثال: الطريقة التي دفنوه بها بسرعة كانت معيبة",
 "蒼惶として": "بسرعة, بعجلة (بطريقة سريعة أو متسرعة)\nمثال: الطريقة التي دفنوه بها بسرعة كانت معيبة",
 "蒼旻": "زرقة السماء, سماء زرقاء (السماء كما تُرى في وضح النهار)",
 "蒼枯": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "蒼氓": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه.",
 "蒼海の一粟": "قَطْرَة فِي الْمُحِيط",
 "蒼溟": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط.",
 "蒼然": "حَزِين\nمثال: هذا البناء أزرق.",
