 "集会所": "مكان اجتماع, منتدى (منشأة عامة للاجتماع للمناقشة المفتوحة)",
 "集光": "تَرْكِيز",
 "集光レンズ": "مكثف (جهاز كهربائي يتميز بقدرته على تخزين شحنة كهربائية) / مكثف ضوئي (عدسة تستخدم لتركيز الضوء على جسم ما) / مكثف (ملف مجوف يقوم بالتكثيف عن طريق سحب الحرارة) / مكثف (جهاز يحول البخار إلى سائل)",
 "集光器": "مكثف (جهاز كهربائي يتميز بقدرته على تخزين شحنة كهربائية) / مكثف ضوئي (عدسة تستخدم لتركيز الضوء على جسم ما) / مكثف (ملف مجوف يقوم بالتكثيف عن طريق سحب الحرارة) / مكثف (جهاز يحول البخار إلى سائل)",
 "集取": "تجميع, جمع (فعل جمع شيء ما معاً)",
 "集合": "جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع / وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع.",
 "集合住宅": "عمارة سكنية, مبنى سكني (مبنى مقسم إلى شقق)",
 "集合体": "تَجْمِيع, مَجْمَع (مصدر جَمَّعَ) / جَمْعِيَّة, مَجْمَع (هَيْئَة أو جهة معينة يجتمع فيها الناس لغَايَة أو هَدَف مشترك لا يستهدف الرِبْح المَادِيّ؛ مؤسسة رِبْحِيَّة إلا أن لها أهداف أخرى في مصلحة المُجْتَمَع)\nمثال: أنشؤوا جمعية سينمائية.",
 "集合名詞": "اسم الجمع (اسم مفرد في صيغته ولكنه يشير إلى مجموعة من الأشخاص أو الأشياء)",
 "集合場所": "مكان اجتماع, منتدى (منشأة عامة للاجتماع للمناقشة المفتوحة)\nمثال: 集合場所はどこですか？ — أين سنلتقي؟",
 "集合果": "ثمرة متجمعة (فاكهة تتكون من العديد من الفواكه الصغيرة الفردية أو النواة المشتقة من مبايض منفصلة داخل وعاء مشترك: مثل التوت الأسود والتوت الأحمر والأناناس)",
 "集合的": "تَعَاوُنِيّ, جَمَاعِيّ (قَائِم عَلَى مَبْدَأ المِلْكِيَّة الجَمَاعِيَّة والإِنْتَاج بِوَاسِطَة العُمَّال) / جَمَاعِيّ (يشكل كلاً أو مجموعة) / جَمَاعِيّ, مُؤَسَّسِيّ (يتمّ بواسطة أفراد يعملون معًا أو يتّسم بالعمل الجماعيّ) / تعاونية, جماعية (أعضاء في مؤسسة تعاونية)",
 "集合論": "نظرية المجموعات (فرع الرياضيات البحتة الذي يتعامل مع طبيعة وعلاقات المجموعات)",
 "集団": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "集団ヒステリー": "هستيريا جماعية (حالة تظهر فيها مجموعة كبيرة من الناس نفس حالة الهياج العقلي العنيف)",
 "集団レイプ": "اِغْتِصَاب جَمَاعِيّ (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن)\nمثال: تعرض زيري للاغتصاب.",
 "集団主義": "جماعية (نظرية سياسية ترى أن الشعب يجب أن يمتلك وسائل الإنتاج) / بلشفية, جماعية (الشيوعية السوفيتية)",
 "集団免疫": "مناعة القطيع",
 "集団全体": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "集団力学": "ديناميكيات الجماعة (فرع علم النفس الاجتماعي الذي يدرس الديناميكيات النفسية للتفاعل في المجموعات الاجتماعية)",
 "集団墓地": "مَقْبَرَة جَمَاعِيَّة",
 "集団安全保障": "أمن جماعي (نظام للسلام الدولي)",
 "集団強姦": "اِغْتِصَاب جَمَاعِيّ (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن)\nمثال: تعرض زيري للاغتصاب.",
 "集団強姦等罪": "اِغْتِصَاب جَمَاعِيّ (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن)\nمثال: تعرض زيري للاغتصاب.",
 "集団強姦罪": "اِغْتِصَاب جَمَاعِيّ (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن)\nمثال: تعرض زيري للاغتصاب.",
 "集団思考": "تفكير جماعي (اتخاذ القرار من قبل مجموعة (خاصة بطريقة تثبط الإبداع أو المسؤولية الفردية))",
 "集団暴行": "اِغْتِصَاب جَمَاعِيّ (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن)\nمثال: تعرض زيري للاغتصاب.",
 "集団殺害": "إِبَادَة جَمَاعِيَّة",
 "集団的": "تَعَاوُنِيّ, جَمَاعِيّ (قَائِم عَلَى مَبْدَأ المِلْكِيَّة الجَمَاعِيَّة والإِنْتَاج بِوَاسِطَة العُمَّال) / جَمَاعِيّ (يشكل كلاً أو مجموعة) / جَمَاعِيّ, مُؤَسَّسِيّ (يتمّ بواسطة أفراد يعملون معًا أو يتّسم بالعمل الجماعيّ) / تعاونية, جماعية (أعضاء في مؤسسة تعاونية)",
 "集団行動": "عَمَل جَمَاعِيّ (إجراء يتّخذه مجموعة من الناس)",
 "集団訴訟": "دعوى جماعية (دعوى قضائية يرفعها عضو ممثل لمجموعة كبيرة من الناس نيابة عن جميع أعضاء المجموعة)",
 "集団農場": "مزرعة جماعية (مزرعة تدار بشكل جماعي)",
 "集塊": "مُتَجَمِّع, مُتَكَتِّل (متجمع معاً لكن دون تماسك) / ركام, كدس (مجموعة من الأشياء مكدسة فوق بعضها البعض) / تكتل بركاني (صخر بركاني يتكون من شظايا كبيرة منصهرة معاً)",
 "集塊岩": "مُتَجَمِّع, مُتَكَتِّل (متجمع معاً لكن دون تماسك) / ركام, كدس (مجموعة من الأشياء مكدسة فوق بعضها البعض) / تكتل بركاني (صخر بركاني يتكون من شظايا كبيرة منصهرة معاً)",
 "集大成": "تأليف, تجميع (فعل التجميع (كما في كتاب واحد أو ملف أو قائمة)) / تجميع, مصنف (شيء تم تجميعه (كما في كتاب واحد أو ملف))\nمثال: استغرقت وظيفة تجميع المخزون عدة ساعات / إتمام, إكمال (إجراء ختامي أو نهائي) / تتويج, ذروة (اللحظة الحاسمة في رواية أو مسرحية) / بلوغ القمة, عبور الزوال ((في الفلك) أعلى نقطة سماوية لجرم سماوي فوق أفق المراقب) / أوج, ذروة (مرحلة الذروة النهائية)\nمثال: مشهد فراش الموت هو ذروة المسرحية",
 "集客交流": "كَرَم, إِكْرَام / ضِيَافَة",
 "集成": "تجميع, جمع (فعل جمع شيء ما معاً) / تجميع, تشكيلة (أشياء عديدة مجمعة معًا أو تعتبر ككل)",
 "集成体型": "إِجْمَالِيّ, مَجْمُوع / سْكَانْدَا",
 "集散花序": "سيمة, نورة محدودة (عنقود زهري مسطح القمة تقريبًا تفتح فيه الزهرة المركزية أو الطرفية أولاً)",
 "集札係": "جامِع التَّذاكِر, قاطِع التَّذاكِر (شخص يتقاضى أجراً للسماح بدخول من اشتروا التذاكر فقط)",
 "集束": "تبيؤر, تركيز البؤرة (عملية وضع الشيء في البؤرة) / بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما)\nمثال: تحول محور النشاط إلى البيولوجيا الجزيئية",
 "集束レンズ": "عدسة مجمعة, عدسة محدبة (عدسة تعمل على تجميع شعاع الضوء المار عبرها في نقطة أو بؤرة)",
 "集束爆弾": "قنبلة عنقودية",
 "集権": "مَرْكَزِيَّة",
 "集権排除": "لامركزية (نشر السلطة بعيداً عن المركز إلى الفروع المحلية أو الحكومات) / لامركزية (العملية الاجتماعية التي ينتقل فيها السكان والصناعة من المراكز الحضرية إلى المناطق النائية)",
 "集注": "طبعة جامعة (طبعة تحتوي على نسخ مختلفة من نص أو ملاحظات من قبل علماء أو محررين مختلفين)",
 "集産主義": "جماعية (نظرية سياسية ترى أن الشعب يجب أن يمتلك وسائل الإنتاج) / بلشفية, جماعية (الشيوعية السوفيتية)",
 "集積": "تجميع, تراكم (عملية التراكم) / تجميع, تشكيلة (أشياء عديدة مجمعة معًا أو تعتبر ككل) / أرباح محتجزة, تراكم الأرباح ((تمويل) الأرباح التي لا تُدفع كتوزيعات أرباح ولكن تضاف إلى القاعدة الرأسمالية للشركة) / تراكم, تكدس (زيادة عن طريق النمو الطبيعي أو الإضافة)",
 "集積回路": "دارة متكاملة (لا جمع له)",
 "集積所": "مَخْزَن, مُسْتَوْدَع",
 "集積点": "حد رياضي, نهاية (القيمة الرياضية التي تتجه إليها الدالة عندما يقترب المتغير المستقل من اللانهاية)",
 "集簇": "تجميع, جمع (فعل جمع شيء ما معاً) / تجميع, تشكيلة (أشياء عديدة مجمعة معًا أو تعتبر ككل)",
 "集約": "جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع",
 "集約的": "مُكَثَّف, مُكَثَّفَة",
 "集結": "ضربة ماسية (ضربة في البلياردو تتم بضرب الكرة البيضاء والعصا ممسوكة بشكل عمودي تقريباً؛ تدور الكرة البيضاء حول كرة أخرى قبل ضرب كرة الهدف)",
 "集群": "تجميع, جمع (فعل جمع شيء ما معاً) / تجميع, تشكيلة (أشياء عديدة مجمعة معًا أو تعتبر ككل) / حُزْمَة, عُنْقُود / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / حُزْمَة / حَزَمَ (جَمَعَ، رَتَّبَ؛ في اللغة: شدّ الأشياء معًا بشكل محكم)\nمثال: شكرا لإضافتي للمجموعة. / إِجْمَالِيّ, مَجْمُوع / سْكَانْدَا",
 "集落": "مُسْتَعْمَرَة, مُسْتَوْطَنَة / مُسْتَعْمَرَة / مُسْتَعْمَرَة, مُسْتَمْلَكَة",
 "集計": "تجميع, جمع (فعل جمع شيء ما معاً) / تجميع, تشكيلة (أشياء عديدة مجمعة معًا أو تعتبر ككل)",
 "集註": "طبعة جامعة (طبعة تحتوي على نسخ مختلفة من نص أو ملاحظات من قبل علماء أو محررين مختلفين)",
 "集配人": "ساعي البريد (رجل يقوم بتوصيل البريد)",
 "集録": "تأليف, تجميع (فعل التجميع (كما في كتاب واحد أو ملف أو قائمة)) / تجميع, مصنف (شيء تم تجميعه (كما في كتاب واحد أو ملف))\nمثال: استغرقت وظيفة تجميع المخزون عدة ساعات",
 "集電体": "مجمع تيار (جهاز مثبت على السقف تستخدمه حافلات الترولي أو الترام أو القاطرات الكهربائية لنقل الطاقة الكهربائية من الخطوط العلوية أو القضبان الثالثة الكهربائية…)",
 "集電装置": "مجمع تيار (جهاز مثبت على السقف تستخدمه حافلات الترولي أو الترام أو القاطرات الكهربائية لنقل الطاقة الكهربائية من الخطوط العلوية أو القضبان الثالثة الكهربائية…)",
 "集音機": "عاكس مكافئ (عاكس مقعر يستخدم لإنتاج حزمة متوازية عندما يوضع المصدر في بؤرته أو لتركيز حزمة متوازية واردة)",
 "雇": "مُوَظَّف, مُوَظَّفَة",
 "雇い": "مُوَظَّف, مُوَظَّفَة",
 "雇い主": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "雇い人": "مُوَظَّف, مُوَظَّفَة",
 "雇い入れ": "خِطْبَة, خُطُوبَة",
 "雇い入れる": "وَظَّفَ",
 "雇い口": "مَهَمَّة / عَمَل, وَظِيفَة (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "雇う": "وَظَّفَ / مِيثَاق",
 "雇われ": "عَارِض, مُسْتَأْجَر (مستأجر للاستخدام المؤقت الحصري لمجموعة من المسافرين) / مَأْجُور, مُسْتَأْجَر (تمّ استئجار خدماته مقابل أجر)\nمثال: طائرة مستأجرة",
 "雇主": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "雇人": "مُوَظَّف, مُوَظَّفَة",
 "雇傭者": "مُوَظَّف, مُوَظَّفَة / رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "雇入": "خِطْبَة, خُطُوبَة",
 "雇入れ": "خِطْبَة, خُطُوبَة",
 "雇入れる": "وَظَّفَ",
 "雇員": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "雇用": "وَظِيفَة, تَوْظِيف (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِسْتِخْدَام\nمثال: ما وظيفة زوجتك؟",
 "雇用主": "رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "雇用凍結": "تجميد التوظيف (تجميد عمليات التوظيف الجديدة)",
 "雇用可能人口": "قُوَّة عَمَل (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية)\nمثال: توم شعر بالقوة.",
 "雇用者": "مُوَظَّف, مُوَظَّفَة / رَبّ عَمَل, رَبَّة عَمَل (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب.",
 "雉猫": "مُنَمَّش بِالبُنِّيّ (ذو نمش بنّيّ اللون)",
 "雉目": "دَجَاجِيّ / دَجَاجِيَّة",
 "雋": "امْتِيَاز, بَرَاعَة (صفة التفوق؛ امتلاك صفات جيدة بدرجة عالية) / براعة, تفوق (ميزة بارزة؛ شيء يتفوق فيه شيء أو شخص ما)\nمثال: مركز للتميز الصناعي",
 "雌": "أُنْثَى (شخض أو حيوان ينتمي إلى الجنس المؤنث، وهو الجنس الذي غالبًا ما يُنتج البويضة في عملية التكاثر الجنسي، ويملك اثنين من الصبغي إكس) / مثال: الفرس هي أنثى الحصان / أُنْثَى (شخض أو حيوان ينتمي إلى الجنس المؤنث، وهو الجنس الذي غالبًا ما يُنتج البويضة في عملية التكاثر الجنسي، ويملك اثنين من الصبغي إكس) / مثال: الفرس هي أنثى الحصان / أَصْغَر (صغير نسبةً إلى شيء آخر) / اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية. / زَوْجَة, اِمْرَأَة",
 "雌しべ": "مِدَقَّة",
 "雌ねじ": "رَأْس, قَرْعَة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ) / مَخْبُول / بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان) / صَمُولَة\nمثال: قطع سامي رأس كلب.",
 "雌の狐": "ثَعْلَبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع)",
 "雌ネジ": "رَأْس, قَرْعَة (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ) / مَخْبُول / بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد به بَيْضَة الدجاج تحديدا لأنه أكثر ما يأكله الإنسان من بيوض الحيوان) / صَمُولَة\nمثال: قطع سامي رأس كلب.",
 "雌バチ": "مَلِكَة, ملكة (مؤنث مَلِك) / وَزِير, فرزان / تفرزن\nمثال: ليحفظ الله الملكة.",
 "雌性": "أُنْثَى (شخض أو حيوان ينتمي إلى الجنس المؤنث، وهو الجنس الذي غالبًا ما يُنتج البويضة في عملية التكاثر الجنسي، ويملك اثنين من الصبغي إكس) / مثال: الفرس هي أنثى الحصان",
 "雌性発生": "توالد أنثوي (توالد عذري أنثوي يحتوي فيه الجنين على كروموسومات الأم فقط بسبب فشل الحيوان المنوي في الاندماج مع نواة البويضة)",
 "雌性配偶体": "مشيج أنثوي, نابتة عروسية كبروية (النابتة العروسية الأنثوية التي تنتجها البوغة الكبيرة لنبات ينتج كلا النوعين من الأبواغ (الصغيرة والكبيرة))",
 "雌松": "صنوبر أحمر ياباني (صنوبر موطنه اليابان وكوريا له تاج غير منتظم واسع الانتشار عند النضج؛ يزرع للزينة)",
 "雌牛": "بَقَرَة, بقرة (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى) / بَقَرَة, بَقَر (اسم؛ حيوان أليف ذو أربع قوائِم مشقوق الظلف ذلول يستخدمه الناس للحرث وبعض الأعمال الأخرى…؛ اسم؛ حيوان من فصيلة البقريات، قد يكون البَقَرَة الأهلية أو غيرها مثل الجاموس. يطلق على الذكر والأنثى)\nمثال: زيري لديه بقرة.",
 "雌犬": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع) / قَحْبَة, سَلِيطَة",
 "雌狐": "ثَعْلَبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع)",
 "雌蕊": "مِدَقَّة",
 "雌蜂": "مَلِكَة, ملكة (مؤنث مَلِك) / وَزِير, فرزان / تفرزن\nمثال: ليحفظ الله الملكة.",
 "雌豚": "خِنْزِيرَة / زَرَعَ, بَذَرَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت. / خِنْزِيرَة / زَرَعَ, بَذَرَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت. / عَاهِرَة (امرأة تتاجر بجسدها؛ امرأة تقدم خدمات جنسية بمقابل مادي)\nمثال: قتل سامي عاهرة.",
 "雌雄を決する": "اِسْتَعْمَرَ (اِسْتَعْمَرَ الاِسْتِعْمارُ الفَرَنْسِيُّ البِلادَ بِالسِّلاَحِ: دَخَلَها غَازِياً، وَأَرَادَها تابِعَةً لَهُ لِفَرْضِ سِيادَتِهِ عَلَيْها) / اِسْتَوْطَنَ (اتخذ وَطَنا أرضا كانت لغيره) / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "雌雄モザイク": "خنثى (شخص يمتلك خصائص وأعضاء جنسية ذكرية وأنثوية؛ ولا يمكن تحديد جنسه بشكل قاطع عند الولادة)",
 "雌雄同体": "ازدواجية الجنس, خنوثة (إظهار خصائص كلا الجنسين) / خنثى, خنثية (حالة خلقية تمتلك فيها الأعضاء التناسلية الخارجية والأعضاء الجنسية الداخلية خصائص ذكورية وأنثوية)",
 "雌雄性": "جِنْسِيَّة (مؤنث الجنسي، المنتسبة إلى الجنس؛ حالة الجنس أو ماهيته) / جِنْس, هُوِيَّة جِنْسِيَّة (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا)\nمثال: لديه الجنسية الأوكرانية.",
 "雌雄鑑別": "جِنْس (الجَمَاعَة أو المَجْمُوعَة الواحدة التي لها صفات تجعلها تنتمي إلى بعض تسمى جِنْسا وهو أعمُّ من النَوْع. ليس للجنس أو النوع ما يحددهما فالبشر كلهم جنس…؛ أحيانا يقصد به ذكر أم أنثى تحديدا) / جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: أنا مثلي الجنس.",
 "雌馬": "حِجْر, فَرَس (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "雌鳥": "دَجَاجَة, دُجَاجَة (طَيْر من الدواجن، لا يطير ويربيه البشر لبيضه ولحمه وريشه؛ أنثى بعض الطيور من الفصائل التي لا تطير كالقَبَج وغيره)\nمثال: وضعت الدجاجة بيضة.",
 "雌鶏": "دَجَاجَة, دُجَاجَة (طَيْر من الدواجن، لا يطير ويربيه البشر لبيضه ولحمه وريشه؛ أنثى بعض الطيور من الفصائل التي لا تطير كالقَبَج وغيره)\nمثال: وضعت الدجاجة بيضة.",
 "雌鹿": "ظَبْيَة (مؤنث ظَبْي، وهو الغزال ذو القرن)",
 "雌黄": "رَهَج أَصْفَر / أصفر ليموني, ليموني (لون أصفر قوي) / غامبوج (صمغ راتنجي يُستخدم كصبغة صفراء ومسهل) / تَزْيِيف",
 "雎鳩": "عُقَاب نُسَارِيّ, عُقَاب نُسَارِيَّة (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "雑": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق. / مُتَنَوِّع / مُتَفَرِّقات",
 "雑い": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس) / ثَخِن (ثَخُنَ الشيءُ ثُخونةً وثَخانةً وثِخَنًا، فَهُوَ ثَخِينٌ: كثُفَ وغَلُظ وصَلُبَ)\nمثال: زيري خشن الخلق.",
 "雑ず": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "雑の部": "مُتَفَرِّقات",
 "雑ぱく": "اِحْتَارَ / تَشَوَّش / اِرْتَبَكَ, تَشَوَّش",
 "雑交": "تَهْجِين",
 "雑人": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "雑作": "مُشْكِلَة, مَتاعِب / كَرَم, إِكْرَام / ضِيَافَة / بِنَاء (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَبْنَى, بِنَاء (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: أنا وجدت البناء. / تجربة الملابس, قياس (ارتداء الملابس لمعرفة ما إذا كانت مناسبة) / لَائِق, مُنَاسِب (مطابق تماماً وصحيح) / مَعْقُول, مُلَائِم (يتناغم مع روح الأشخاص أو المناسبة المعنيّة) / تجهيزات, مستلزمات ((عادة بصيغة الجمع) المفروشات والمعدات (خاصة لسفينة أو فندق))",
 "雑作もない": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "雑作も無い": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "雑兵": "جندي (جندي مجند من أدنى رتبة في الجيش أو مشاة البحرية)\nمثال: كان سجيننا مجرد جندي ولم يكن يعرف شيئاً ذا قيمة / صغير, طفل (شخص صغير السن من أي من الجنسين) / إمّعة, تافه (شخص صغير وغير مهم)\nمثال: هي تكتب كتباً للأطفال",
 "雑品": "متفرقات (أشياء متنوعة عديدة جداً أو صغيرة جداً بحيث لا يمكن تحديدها)",
 "雑嚢": "حقيبة أمتعة أسطوانية, حقيبة دافل (حقيبة أسطوانية كبيرة من القماش الثقيل؛ لحمل الأمتعة الشخصية)",
 "雑多": "مُتَنَوِّع",
 "雑婚": "إباحية, علاقات متعددة (الانغماس في علاقات جنسية عشوائية وغير مميزة) / زَوَاج مُخْتَلِط, تَزَاوُج",
 "雑家": "توفيق صيغي (دمج الأشكال المصرفة التي كانت مختلفة أصلاً (مما يؤدي إلى تقليل استخدام التصريفات)) / تلفيقية, توفيقية (اتحاد (أو محاولة دمج) أنظمة فكرية أو معتقدات مختلفة (خاصة في الدين أو الفلسفة))\nمثال: توفيقية بين النظريات المادية وغير المادية",
 "雑居": "مُجْتَمَع, اِجْتِمَاع (قد يقصد به المكان الذي يجتمع فيه الناس؛ مجموعة من الناس من طبقة اجتماعية واحدة تختلط ببعضها ولها ما يميزها عن غيرها من المجموعات البشرية) / مِلَّة\nمثال: سامي خطر للمجتمع.",
 "雑巾がけ": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً) / مُنْخَفِض الشِّدَّة (غير شديد؛ ضعيف المستوى) / مُنْخَفِض المُسْتَوَى (في مستوى منخفض من الرتبة أو الأهمية)",
 "雑巾掛け": "تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / مُنْخَفِض الارْتِفَاع (يحدث على ارتفاع منخفض نسبيّاً) / مُنْخَفِض الشِّدَّة (غير شديد؛ ضعيف المستوى) / مُنْخَفِض المُسْتَوَى (في مستوى منخفض من الرتبة أو الأهمية)",
 "雑巾摺": "إزار الحائط, وزرة (إطار يغطي المفصل المكون من الجدار والأرضية)",
 "雑巾摺り": "إزار الحائط, وزرة (إطار يغطي المفصل المكون من الجدار والأرضية)",
 "雑役": "عَمَلٌ رُوتِينِيّ (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "雑役夫": "بارع في كل الصنعات, عامل صيانة (رجل ماهر في وظائف متنوعة ومهام صغيرة أخرى)",
 "雑役婦": "عاملة نظافة (أنثى بشرية موظفة للقيام بالأعمال المنزلية)\nمثال: ستنظف عاملة النظافة السجاد",
 "雑戸": "تاجر, صاحب متجر (تاجر ذكر يمتلك أو يدير متجراً)",
 "雑技": "فنون أدائية (فنون أو مهارات تتطلب أداءً عاماً)",
 "雑木林": "أجمة, دغل (نمو كثيف للشجيرات)",
 "雑楽": "مُوسِيقَى الْبُوب, بُوب (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن)\nمثال: أتعلم الموسيقى.",
 "雑然": "شعث, غير مرتب (غير نظيف وغير منظم)\nمثال: مهملة وغير مرتبة في عاداتها الشخصية",
 "雑犬": "هَجِين",
 "雑用": "عَمَلٌ رُوتِينِيّ (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة)\nمثال: المهم هو العمل.",
 "雑砕": "تْشُوب سُوِي",
 "雑種": "هَجِين",
 "雑種強勢": "تغاير, قوة الهجين ((وراثة) ميل الكائن الهجين لامتلاك صفات متفوقة على صفات أي من الوالدين)",
 "雑穀": "حُبُوب / دَخْن (دخن: الشَّيْء دخنة دخن؛ دخنت: النَّار دخنت والوقود دخن) / ملَة, مل\nمثال: دخن زيري سيجارة.",
 "雑肉": "سقط, فضلات الذبيحة (الأحشاء والأجزاء المتبقية من الحيوان المذبوح التي غالباً ما تعتبر غير صالحة للأكل للبشر)",
 "雑草": "عُشْبَة ضَارَّة / بانْجو, حَشيش",
 "雑菌": "مِيكْرُوب",
 "雑言": "قَبَاحَة",
 "雑記帳": "دَفْتَر, مُذَكِّرَة / كَمْبْيُوتَر مَحْمُول, حَاسُوب مَحْمُول",
 "雑話": "أحاديث جانبية, ثرثرة خفيفة (محادثة غير رسمية خفيفة للمناسبات الاجتماعية)",
 "雑誌": "خَزَّان الْبُنْدُقِيَّة, مَخْزَن طَلَقَاتِ السِّلَاحِ",
 "雑誌社": "خَزَّان الْبُنْدُقِيَّة, مَخْزَن طَلَقَاتِ السِّلَاحِ",
 "雑誌記事": "مقال مجلة (مقال منشور في مجلة)",
 "雑語": "قَبَاحَة",
 "雑談": "ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة)",
 "雑貨": "متفرقات (أشياء متنوعة عديدة جداً أو صغيرة جداً بحيث لا يمكن تحديدها)",
 "雑貨商": "متجر ريفي, متجر عام (متجر بيع بالتجزئة يخدم منطقة ذات كثافة سكانية منخفضة؛ عادة ما يكون مخزناً بمجموعة واسعة من البضائع)",
 "雑貨屋": "متجر ريفي, متجر عام (متجر بيع بالتجزئة يخدم منطقة ذات كثافة سكانية منخفضة؛ عادة ما يكون مخزناً بمجموعة واسعة من البضائع)",
 "雑踏": "جمهور, حشد كبير (تجمع كبير للناس)",
 "雑音": "ضَوْضَاء, ضَجِيج / تَدَاخُل / نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "雑食": "قَارِت, كَالِش",
 "雑食動物": "حَيَوَان قَارِت, حَيَوَان كَالِش (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "雑食性": "تغذية شاملة, قارتية (حالة أكل كل من المواد الحيوانية والنباتية)\nمثال: إنها ليست المخلوقات الوحيدة التي ستلجأ إلى هذا، ولكن بالتأكيد قارتيتها هي التي تجعلها دورية قمامة مذهلة / قَارِت, كَالِش",
 "雑食系": "حَيَوَان قَارِت, حَيَوَان كَالِش (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "雑駁": "اِحْتَارَ / تَشَوَّش / اِرْتَبَكَ, تَشَوَّش",
 "雑魚": "صغير, طفل (شخص صغير السن من أي من الجنسين) / إمّعة, تافه (شخص صغير وغير مهم)\nمثال: هي تكتب كتباً للأطفال / شخص غير مهم, لا أحد (شخص ليس له تأثير أو نفوذ) / مُسْتَجِدّ",
 "雑魚キャラ": "رعاع, غوغاء (حشد غير منظم من الناس) / عصابة (رابطة من المجرمين) / عصابة, نقابة الجريمة (تحالف فضفاض من رجال العصابات المسؤولين عن الأنشطة الإجرامية المنظمة)\nمثال: حاولت الشرطة تفكيك العصابة",
 "雒": "رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "雖も": "بِالرَغْم مِن",
 "雛": "طائر صغير, فرخ طائر (طائر لا يزال صغيراً) / ساذج, غر (شاب أخرق وقليل الخبرة)",
 "雛型": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به) / عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ",
 "雛尖": "بَظْر",
 "雛形": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به) / عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ",
 "雛罌粟": "خشخاش الحقول, خشخاش الذرة (خشخاش أوروبي سنوي شائع في حقول الحبوب ويزرع غالباً)",
 "雛菊": "أُقْحُوَان",
 "雛豆": "حِمِّص (حَمَصَ الجُرْحُ: سَكَنَ وَرَمُه؛ حَمَصَ القَذَاةَ: أَخْرَجَها مِنْ عَيْنِه بِرِفْقٍ)\nمثال: الحمص مكون أساسي في طبق الفلافل.",
 "雛鑑別師": "مُجَنِّس الْكَتَاكِيت (شخص مدرب يتم تعيينه لتحديد جنس الدجاج والفراخ الأخرى)",
 "雛頭": "بَظْر",
 "雛鳥": "صُوص, فَرُّوج / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "離": "وَاحِد وَخَمْسُونَ (يَدُلُّ عَلَى العَدَد 51) / لي (مقياس مسافة صيني؛ حوالي 0.5 كيلومتر) / ليثيوم (عنصر فضي أبيض ناعم أحادي التكافؤ من مجموعة الفلزات القلوية؛ أخف معدن معروف)",
 "離しょう": "انكماش الهلام, نضْح (انفصال السائل عن الهلام الناتج عن الانكماش (كما في صناعة الجبن)) / دمج الحركات (انكماش حرفين متحركين في إدغام)",
 "離す": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل.",
 "離る": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / اِبْتَعَدَ",
 "離ればなれ": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل.",
 "離れる": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "離れ去る": "تَخَلَّى عَن, تَوَقَّفَ",
 "離れ技": "حيلة مثيرة, مجازفة (عمل صعب أو غير عادي أو خطير؛ يتم عادة لجذب الانتباه) / حيوان متقزم (مخلوق (خاصة الحوت) تم منعه من بلوغ النمو الكامل)",
 "離れ業": "حيلة مثيرة, مجازفة (عمل صعب أو غير عادي أو خطير؛ يتم عادة لجذب الانتباه) / حيوان متقزم (مخلوق (خاصة الحوت) تم منعه من بلوغ النمو الكامل)",
 "離れ離れ": "فَصَلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / مُنْفَصِل\nمثال: اقرأ هذا الفصل. / مُتَنَافِر, مُنْفَصِل (أصبح غير محبوب بسبب الجفاء والبعد)",
 "離乳": "فطام (عملية استبدال حليب الأم بطعام آخر في النظام الغذائي للطفل أو الثدييات الصغيرة)",
 "離乳食": "طَعَام, غِذَاء صُلْب (أيّ مادّة صلبة تُستخدَم مصدرًا للتغذية، في مقابل السوائل)",
 "離人症": "تجريد من الشخصية, تشييء (تمثيل إنسان كشيء مادي مجرد من الصفات الشخصية أو الفردية) / اختلال الإنية, تبدد الشخصية ((في الوجودية) فقدان الهوية الشخصية؛ شعور الفرد بأنه ترس مجهول في آلة اجتماعية غير شخصية) / اضطراب تبدد الشخصية, تبدد الشخصية (اضطراب انشقاقي عاطفي يحدث فيه فقدان للاتصال بالواقع الشخصي للفرد مصحوباً بمشاعر اللاواقعية والغرابة)\nمثال: وفقًا لماركس، فإن معاملة العمل كسلعة تجسد تشييء الفرد",
 "離別": "تَفْرِقَة",
 "離反": "اغتراب, جفاء (الشعور بالغربة عن الآخرين) / اغتراب, نفرة (الانفصال الناتج عن العداء) / مَخَاضَة",
 "離婚": "طَلَاق, تَطْلِيق / طَلَّقَ (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ) / أَطْلَقَ\nمثال: طلق زيري زوجته.",
 "離岸流": "تيار ساحب, تيار شاطئي (تيار سطحي قوي يتدفق للخارج من الشاطئ)",
 "離弁": "مُنْفَصِل البَتَلَات (ذو تويج مكوَّن من بتلات متعدّدة منفصلة)",
 "離心率": "غَرَابَة الأَطْوَار (سلوك غريب وغير تقليدي) / لا مركزية (دائرية لها مركز مختلف أو تنحرف عن مسار دائري) / اِخْتِلَاف مَرْكَزِيّ, لَا مَرْكَزِيَّة ((الهندسة) نسبة تصف شكل القطع المخروطي؛ نسبة المسافة بين البؤرتين إلى طول المحور الأكبر)\nمثال: الدائرة هي قطع ناقص ذو اختلاف مركزي صفري",
 "離散": "تَشَتُّت",
 "離散的": "مُمَيَّز, مُنْفَصِل / مُتَقَطِّع",
 "離断": "تبضيع, تشريح (القطع بغرض الفصل إلى قطع) / تحليل نقدي دقيق, تشريح (تحليل نقدي مفصل أو فحص جزء تلو الآخر (كما في العمل الأدبي)) / تحليل دقيق, تشريح (تحليل دقيق ونقدي)",
 "離漿": "انكماش الهلام, نضْح (انفصال السائل عن الهلام الناتج عن الانكماش (كما في صناعة الجبن)) / دمج الحركات (انكماش حرفين متحركين في إدغام)",
 "離為火": "وَاحِد وَخَمْسُونَ (يَدُلُّ عَلَى العَدَد 51) / لي (مقياس مسافة صيني؛ حوالي 0.5 كيلومتر) / ليثيوم (عنصر فضي أبيض ناعم أحادي التكافؤ من مجموعة الفلزات القلوية؛ أخف معدن معروف)",
 "離瓣": "مُنْفَصِل البَتَلَات (ذو تويج مكوَّن من بتلات متعدّدة منفصلة)",
 "離縁": "طَلَاق, تَطْلِيق / طَلَّقَ (فعل؛ تحرر من القَيْد ونحوه بمعنى حَرْفيّ؛ فعل؛ تحرك بحرية بدون قيد معنى مَجَازيّ) / أَطْلَقَ\nمثال: طلق زيري زوجته.",
 "離群": "عُزْلَة",
 "離職者": "عاطل عن العمل (شخص بلا وظيفة)",
 "離背": "اغتراب, جفاء (الشعور بالغربة عن الآخرين) / اغتراب, نفرة (الانفصال الناتج عن العداء)",
 "離脱": "اِنْسِحَاب",
 "離脱症状": "عَرَض الانسحاب (أي اضطراب جسدي أو نفسي (مثل التعرق أو الاكتئاب) يعاني منه مدمن المخدرات عند حرمانه من الدواء)",
 "離行": "تخلٍّ, تنازل (فعل التنازل؛ التضحية أو التخلي عن (ممتلكات أو حق أو لقب أو امتياز، إلخ)) / تنصل, نبذ (رفض أو تبرؤ أو إنكار الصلاحية) / تخل, نبذ (فعل (منطوق أو مكتوب) يعلن أن شيئاً ما تم التنازل عنه أو التبرؤ منه) / انشقاق, تخلي (حالة نبذ المعتقدات الدينية أو الحزب السياسي أو قضية ما (غالباً لصالح معتقدات أو قضايا معارضة))\nمثال: تنصل الكونغرس من المعاهدة التي تفاوض عليها الرئيس",
 "離角": "إطالة (عملية تطويل شيء ما) / إطالة, تمديد (إضافة إلى طول شيء ما) / استطالة (صفة كون الشيء مستطيلاً أو ممدوداً)",
 "離間": "اغتراب, جفاء (الشعور بالغربة عن الآخرين) / اغتراب, نفرة (الانفصال الناتج عن العداء)",
 "離陸": "إِقْلَاع",
 "離隔": "تَوَحُّد",
 "離魂病": "سير أثناء النوم, مشي نائم (المشي من قبل شخص نائم)",
 "難": "صُعُوبَة / حَادِث / مُصَادَفَة, صُدْفَة / صُدْفَة, صِدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة. / خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي. / نَقْد, اِنْتِقَاد",
 "難あり": "تالف, متضرر (تعرض للأذى أو الإصابة أو التلف) / فَاقِدُ الْمِصْدَاقِيَّةِ, مُتَضَرِّرُ السُّمْعَةِ (فقد سمعته أو مصداقيته ظلماً)\nمثال: لن أشتري بضائع تالفة",
 "難い": "صَعْب",
 "難き": "صُعُوبَة",
 "難くない": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "難し": "صَعْب",
 "難しい": "صَعْب / مُسْتَحِيل / دَقِيق, مُتَطَلِّب (شَدِيد التَّدْقِيق خَاصَّةً فِي التَّفَاصِيل) / عَبُوس, مُتَذَمِّر (مُنزعج وسريع الانفعال) / مُزْدَحِم بِالتَّفَاصِيل (مكتظّ بالتفاصيل والزخارف بشكل مفرط) / كَئِيب, مُوحِش",
 "難しい顔をする": "عُبُوسة, عُبُوس / عَبَسَ, عَقَدَ حَاجِبَيْهُ",
 "難しげ": "صَعْب",
 "難しさ": "صُعُوبَة",
 "難し屋": "سيء المزاج, عبوس (شخص سيء الطباع)",
 "難じる": "اِنْتَقَدَ / نَقَدَ",
 "難ずる": "اِنْتَقَدَ / نَقَدَ",
 "難なく": "بِسُهُولَة",
 "難事": "صُعُوبَة",
 "難儀": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا) / مُعَانَاة",
 "難問": "ارتباك, حيرة (مشكلة أو ارتباك ناتج عن التعقيد)",
 "難場": "مأزق, ورطة (موقف يصعب الخلاص منه، خاصة إذا كان مزعجاً أو شاقاً)\nمثال: وجد نفسه في مأزق محرج للغاية",
 "難平": "مُتَوَسِّط, مُعَدَّل",
 "難攻不落": "لَا يُقْهَر, مَنِيع (لَا يُمْكِنُ التَّغَلُّبُ عَلَيْهِ أَوْ تَحَدِّيهِ أَوْ دَحْضُهُ) / قَابِل لِلحَمْل, قَادِر عَلَى الإِنْجَاب (قَادِر عَلَى الحَمْل والإِخْصَاب) / لَا يُقْهَر, مَنِيع (مُحَصَّنٌ ضِدَّ الهُجُوم؛ لَا يُمْكِنُ العَبَثُ بِه)",
 "難易": "صُعُوبَة",
 "難有り": "تالف, متضرر (تعرض للأذى أو الإصابة أو التلف) / فَاقِدُ الْمِصْدَاقِيَّةِ, مُتَضَرِّرُ السُّمْعَةِ (فقد سمعته أو مصداقيته ظلماً)\nمثال: لن أشتري بضائع تالفة",
 "難民": "لَاجِئ, لَاجِئَة",
 "難民キャンプ": "مُخَيَّم لَاجِئِين",
 "難民申請者": "طَالِب لُجُوء, طَالِبَة لُجُوء",
 "難治": "صعب المراس, عنيد (غير طيع؛ صعب الإدارة أو التشكيل)\nمثال: طبع عنيد / عَاصٍ",
 "難治性": "استعصاء, جموح (سمة صعوبة التأثير أو السيطرة)",
 "難波薔薇": "ورد شيروكي (ورد متسلق صيني ذو أزهار بيضاء عطرة)",
 "難消化性": "عسير الهضم, غير قابل للهضم (يتم هضمه بصعوبة)",
 "難渋": "مُعَانَاة",
 "難点": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي. / مَرْبِط الْفَرَس",
 "難無く": "بِسُهُولَة",
 "難燃加工": "مُقَاوِم لِلْحَرِيق (لا تؤثر فيه النار)",
 "難癖": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي.",
 "難癖つける": "لَوْم, مَلَامَة",
 "難癖をつける": "لَوْم, مَلَامَة",
 "難癖を付ける": "لَوْم, مَلَامَة",
 "難癖付ける": "لَوْم, مَلَامَة",
 "難破": "حُطَام سَفِينَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)",
 "難義": "الْتِبَاس, خَفَاء (صفة كون الشيء غير واضح أو عويصاً وصعب الفهم) / عمق, عوص (الحكمة التي تتسم بالغموض والصعوبة والعمق)\nمثال: أعجب عالم الأنثروبولوجيا بعمق الأمثال المحلية",
 "難聴": "صَمَم",
 "難聴者": "أَصَمّ",
 "難船": "حُطَام سَفِينَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)",
 "難色": "إدانة, استهجان (فعل الاستهجان أو الإدانة) / استهجان, عدم رضا (الميل لعدم منح الموافقة أو الرضا عن شخص أو مجموعة) / اسْتِنْكَار, اسْتِهْجَان (التعبير عن عدم الموافقة أو الاستهجان) / استهجان, عدم استحسان (شعور بعدم الإعجاب بشيء أو بما يفعله شخص ما)",
 "難行": "كَفَّارَة / سِرّ التَوْبَة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "難行苦行": "كَفَّارَة / سِرّ التَوْبَة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "難解": "غَيْرُ مَفْهُوم, مُعْتِم (صعب أو مستحيل الفهم والاستيعاب) / غير مفهوم, مبهم (ملفوظ أو منطوق بشكل سيء، أو طغت عليه الضوضاء)\nمثال: كلام غير مفهوم",
 "難詰": "عَزْر / توبيخ ;تقريع",
 "難語集": "مَسْرَد",
 "難読化": "تَعْتِيم",
 "難関": "حَاجِز / عَقَبَة, حَاجِز",
 "難題": "تَحَدٍّ, التَّحَدِّي",
 "雨": "مَطَر, مطر (السماء: أنزلت مَطَرًا) / أَمْطَرَ, مَطَرَ / أَمْطَرَ\nمثال: فجأة هطل المطر. / اليوم الأسود, وقت الشدة (وقت (مستقبلي) للحاجة المالية)\nمثال: أنا أدخر ليوم الحاجة",
 "雨あられ": "بَرَد, مطر تلج (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن الميت تبرد جثته. فعل لازم مصدر بَرْد) / السلام عليك, السلام عليكم\nمثال: لا أتحمل البرد.",
 "雨がえる": "ضِفْدَع شَجَر (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ)\nمثال: الضفدع في البئر.",
 "雨がさ": "مِظَلَّة, شَمْسِيَّة / وَاقٍ, الْوَاقِي",
 "雨がち": "مَطِر, مَاطِر (السماء: أنزلت مَطَرًا)\nمثال: فجأة هطل المطر.",
 "雨がっぱ": "مِعْطَف",
 "雨が多い": "مَطِر, مَاطِر (السماء: أنزلت مَطَرًا)\nمثال: فجأة هطل المطر.",
 "雨が降る": "مَطَر, مطر (السماء: أنزلت مَطَرًا) / أَمْطَرَ, مَطَرَ / أَمْطَرَ\nمثال: فجأة هطل المطر.",
 "雨が降ろうが槍が降ろうが": "مهما حدث, مهما كانت الظروف (رغم كل العقبات)\nمثال: سنذهب إلى التبت مهما حدث",
 "雨が降ろうと槍が降ろうと": "مهما حدث, مهما كانت الظروف (رغم كل العقبات)\nمثال: سنذهب إلى التبت مهما حدث",
 "雨じまい": "عزل الماء (فعل معالجة شيء ما لجعله طاردا للماء) / عزل مائي (طلاء قادر على جعل السطح مقاوماً للماء)",
 "雨だれ": "قَطْرَةُ مَطَر / علامة تعجب (علامة ترقيم ('!') تستخدم بعد التعجب)",
 "雨の多い": "مَطِر, مَاطِر (السماء: أنزلت مَطَرًا)\nمثال: فجأة هطل المطر.",
 "雨の降る": "مَطِر, مَاطِر (السماء: أنزلت مَطَرًا)\nمثال: فجأة هطل المطر.",
 "雨よけ": "قماش القنب المشمع, مشمع (قماش قنب معالج ليكون مقاوماً للماء)",
 "雨ガッパ": "مِعْطَف",
 "雨下": "مَاطِر, مُنْهَمِر (يَتَسَاقَطُ قَطَرَاتٍ أَوْ كَأَنَّهُ يَتَسَاقَطُ كَالمَطَر)",
 "雨仕舞": "عزل الماء (فعل معالجة شيء ما لجعله طاردا للماء) / عزل مائي (طلاء قادر على جعل السطح مقاوماً للماء)",
 "雨仕舞い": "عزل الماء (فعل معالجة شيء ما لجعله طاردا للماء) / عزل مائي (طلاء قادر على جعل السطح مقاوماً للماء)",
 "雨傘": "مِظَلَّة, شَمْسِيَّة / وَاقٍ, الْوَاقِي",
 "雨傘蛇": "كرايت (ثعبان زاهي الألوان سام ولكنه غير عدواني من جنوب شرق آسيا وشبه جزيرة الملايو)",
 "雨勝ち": "مَطِر, مَاطِر (السماء: أنزلت مَطَرًا)\nمثال: فجأة هطل المطر.",
 "雨垂れ": "قَطْرَةُ مَطَر / علامة تعجب (علامة ترقيم ('!') تستخدم بعد التعجب)",
 "雨垂れ石": "ميزاب حجري (ميزاب واقٍ مصنوع من الحجر) / حجر التنقيط (شكل كربونات الكالسيوم الموجود في الهوابط والصواعد)",
 "雨外套": "معطف ماكنتوش (معطف واق من المطر مصنوع من قماش معالج بالمطاط) / ماكينتوش (قماش خفيف الوزن مقاوم للماء (عادة ما يكون معالجاً بالمطاط))",
 "雨季": "موسم الأمطار (أحد الموسمين في المناخات الاستوائية، وهي فترة سنوية يحدث فيها معظم هطول الأمطار في بلد ما)",
 "雨承け": "مِزْراب (قناة صرف لمياه الأمطار والثلوج؛ نظام يحدّ من جريان المياه على الأسطح الخارجية للمبنى)",
 "雨期": "موسم الأمطار (أحد الموسمين في المناخات الاستوائية، وهي فترة سنوية يحدث فيها معظم هطول الأمطار في بلد ما)",
 "雨林": "غَابَة اِسْتِوَائِيَّة (الغَابَةُ: الأَجَمَةُ ذاتُ الشَّجَرِ المُتَكَاثِف؛ لأَنَّها تُغَيِّبُ مَا فِيهَا. أو الأَجَمَةُ الَّتِي طالتْ، وَلَهَا أَطْراف مُرْتَفِعَةٌ باسِقَة؛ الغابةُ أَجَمة القَصَب، قَالَ: وَقَدْ جُعِلَتْ جماعةَ الشَّجَرِ، لأَنه مأْخوذ مِنَ الغَيابةِ)\nمثال: مشينا في الغابة",
 "雨滴": "قَطْرَةُ مَطَر",
 "雨燕": "خُطَّاف",
 "雨着": "مِعْطَف",
 "雨粒": "قَطْرَةُ مَطَر",
 "雨落ち石": "ميزاب حجري (ميزاب واقٍ مصنوع من الحجر) / حجر التنقيط (شكل كربونات الكالسيوم الموجود في الهوابط والصواعد)",
 "雨落石": "ميزاب حجري (ميزاب واقٍ مصنوع من الحجر) / حجر التنقيط (شكل كربونات الكالسيوم الموجود في الهوابط والصواعد)",
 "雨虎": "أرنب البحر (بطني قدم بحري عارٍ له جسم رخو بصدفة داخلية مختزلة وزوجين من المجسات تشبه الأذن)",
 "雨蛙": "ضِفْدَع شَجَر (مِنْ فَصِيلَةِ الضِّفْدَعِيَّاتِ ، بَرْمَائِيٌّ لاَ ذَنَبَ لَهُ ، رَخْوٌ ، دَقِيقُ العِظَامِ ، جَمِيلُ السِّبَاحَةِ ، وَهُوَ أَنْوَاعٌ…؛ \" نَقَّتْ ضَفَادِعُ بَطْنِهِ \" : صَوَّتَتْ عَصَافِيرُ بَطْنِهِ ، أَيْ جَاعَ)\nمثال: الضفدع في البئر.",
 "雨覆い": "قماش القنب المشمع, مشمع (قماش قنب معالج ليكون مقاوماً للماء)",
 "雨避け": "قماش القنب المشمع, مشمع (قماش قنب معالج ليكون مقاوماً للماء)",
 "雨量": "مطر, هطول مطري (ماء يسقط في قطرات من بخار متكثف في الغلاف الجوي)",
 "雨量計": "مقياس المطر (مقياس يتكون من أداة لقياس كمية هطول الأمطار)",
 "雨降": "أرنب البحر (بطني قدم بحري عارٍ له جسم رخو بصدفة داخلية مختزلة وزوجين من المجسات تشبه الأذن)",
 "雨降って地固まる": "مَا لَا يَقْتُلُكَ يَجْعَلُكَ أَقْوَى, مَا لَا يَقْتُلُكِ يَجْعَلُكِ قُويَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "雨降らし": "أرنب البحر (بطني قدم بحري عارٍ له جسم رخو بصدفة داخلية مختزلة وزوجين من المجسات تشبه الأذن)",
 "雨降り": "مطر, هطول مطري (ماء يسقط في قطرات من بخار متكثف في الغلاف الجوي)\nمثال: 私たちは雨降りにもかかわらず、外出した。 — خرجنا بالرغم من هطول المطر. / مَطِر, مَاطِر (السماء: أنزلت مَطَرًا)\nمثال: فجأة هطل المطر.",
 "雨除け": "قماش القنب المشمع, مشمع (قماش قنب معالج ليكون مقاوماً للماء)",
 "雨雪": "تَسَاقُط ثُلُوج / صقيع, مطر متجمد (ثلج ذائب جزئياً (أو خليط من المطر والثلج))",
 "雨雫": "قَطْرَةُ مَطَر",
 "雨雲": "مُزْنَة",
 "雨雲レーダー": "رادار الطقس (رادار قادر على اكتشاف السحب وهطول الأمطار)",
 "雨霰": "بَرَد, مطر تلج (أصبح باردا، ضد سَخَنَ وهو فعل لازم مصدر بَرْد وبُرود؛ مَاتَ، على المجاز لأن الميت تبرد جثته. فعل لازم مصدر بَرْد) / السلام عليك, السلام عليكم\nمثال: لا أتحمل البرد.",
 "雨靴": "جزمة مطاطية (حذاء طويل مصنوع من المطاط)",
 "雨風": "عوامل الطبيعة (طقس عنيف أو قاسٍ (ينظر إليه على أنه ناجم عن فعل العناصر الأربعة))\nمثال: شعروا بغضب الطبيعة الكامل",
 "雪": "ثَلْج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / تلج / ثلج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / أَثْلَجَ (أثلج يومُنا: دخل في الثلج؛ أثلجت الأرض: أصابها الثلج)\nمثال: سامي يحب الثلج.",
 "雪かき車": "كَاسِحَةُ ثُلُوج",
 "雪ぐ": "شَطَفَ (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن أن تعني إزالة ما علق بالشيء من أوساخ أو شوائب) / مَضْمَضَ",
 "雪しまき": "عَاصِفَة ثَلْجِيَّة, دَمَق",
 "雪だるま": "إِنْسَان ثَلْجِيّ, تِمْثَال ثَلْجِيّ (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق.",
 "雪だるま式": "كُرَةُ الثَّلْج",
 "雪つぶて": "كُرَةُ الثَّلْج",
 "雪と墨": "صورة أبيض وأسود, صورة أحادية اللون (صورة فوتوغرافية أو شريحة بالأبيض والأسود) / تَوَاصُل كِتَابِيّ, لُغَة مَكْتُوبَة (التواصل بوساطة رموز مكتوبة، سواء أكانت مطبوعة أم مخطوطة)",
 "雪どけ水": "ماء ذائب (الثلج أو الجليد المذاب)",
 "雪の下": "غرنوقي الفراولة, كاسر الحجر المتدلي (كاسر حجر آسيوي شرقي بعناقيد من الزهور الحمراء والبيضاء الصغيرة؛ ينتشر عن طريق العديد من السيقان الزاحفة)",
 "雪の結晶": "رُقَاقَةُ الثَّلْج, نُدْفَةُ الثَّلْج",
 "雪の花": "شقائق النعمان الحرجية, قطرة الثلج (شقائق نعمان شائعة في شرق أمريكا الشمالية بزهور بيضاء وحيدة مشوبة بالوردي)",
 "雪の華": "شقائق النعمان الحرجية, قطرة الثلج (شقائق نعمان شائعة في شرق أمريكا الشمالية بزهور بيضاء وحيدة مشوبة بالوردي)",
 "雪ぴ": "إفريز, كرنيش (الجزء البارز العلوي من السطح المعمد) / كورنيش (إطار زخرفي في الزاوية بين السقف وأعلى الجدار) / ستارة, كورنيش (هيكل زخرفي لإخفاء تركيبات الستائر في الجزء العلوي من غلاف النافذة)",
 "雪上車": "زَحَّافَةُ ثَلْج, زَحَّافَةُ الثَّلْج",
 "雪中花": "نَرْجُس بَرِّيّ",
 "雪人形": "إِنْسَان ثَلْجِيّ, تِمْثَال ثَلْجِيّ (كَائِن بَشَرِيّ؛ سَوَاد العَيْن)\nمثال: أنا إنسان صادق.",
 "雪冤": "تَبْرِئَة",
 "雪割り草": "ماركانتيا بوليمورفا, هيباتيكا (حشيشة كبد شائعة) / حشيشة الكبد, هيباتيكا (أي من عدة نباتات من جنس هيباتيكا ذات أوراق ثلاثية الفصوص وأزهار بيضاء أو وردية في أوائل الربيع؛ توجد في مناطق الغابات الرطبة والمغطاة بالطحالب في…) / بَانُورَامِيّ, مِنْ عَلُوّ (كما يُرى من ارتفاع أو مسافة بعيدة)",
 "雪割草": "ماركانتيا بوليمورفا, هيباتيكا (حشيشة كبد شائعة) / حشيشة الكبد, هيباتيكا (أي من عدة نباتات من جنس هيباتيكا ذات أوراق ثلاثية الفصوص وأزهار بيضاء أو وردية في أوائل الربيع؛ توجد في مناطق الغابات الرطبة والمغطاة بالطحالب في…) / بَانُورَامِيّ, مِنْ عَلُوّ (كما يُرى من ارتفاع أو مسافة بعيدة)",
 "雪堤": "ضفة ثلجية, كومة ثلج (كومة أو ركام من الثلج)",
 "雪寃": "تَبْرِئَة",
 "雪山": "هِمَالِيَة, هِيمَالَايَا",
 "雪崩": "تَيْهُور, اِنْهِيَار ثَلْجِيّ",
 "雪崩れる": "مُنْحَدَر / مَيْل / اِنْزَلَقَ, تَزَحْلَقَ / زَحْلِيقَة, مَزْلَقَة",
 "雪崩を打つ": "طُوفَان, فَيَضَان (عاصفة)",
 "雪嵐": "عاصفة ثلجية (عاصفة ذات تساقط ثلوج واسع النطاق مصحوبة برياح قوية)",
