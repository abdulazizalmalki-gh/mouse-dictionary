 "隊舎": "أماكن معيشة, مساكن (سكن متاح للناس للعيش فيه)\nمثال: وجد مسكناً لعائلته",
 "隊長": "طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَقِيب, قُبْطَان / قَائِد, كَبْتِن\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "階": "طَابَق, دَوْر / سَلَالِم / مَرْحَلَة / مُنَصَّة, مَسْرَح / مَقَال, مَقَالَة / أَدَاةُ تَعْرِيف, أَدَاةُ التَّعْرِيف / مادّةٌ, مَوَادُّ (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / نَوْعِيَّة, جَوْدَة / دَلَال",
 "階上": "أعلى الدرج, في الطابق العلوي (في طابق أعلى) / عقلياً, في الرأس (فيما يتعلق بالعقل) / علوي (طابق) (في أو من الطوابق العليا لمبنى) / طابق علوي (جزء المبنى الذي يقع فوق الطابق الأرضي)\nمثال: عاشوا في الطابق العلوي",
 "階下": "أسفل الدرج, في الطابق السفلي (في طابق أدنى) / سفلي (طابق) (في أو من الطوابق السفلية لمبنى)\nمثال: المستأجرون يعيشون في الطابق السفلي",
 "階乗": "عاملي (مكون من أو متعلق بالمضروب أو العاملي (رياضيات)) / عاملي, مضروب (حاصل ضرب جميع الأعداد الصحيحة حتى عدد صحيح معين وتضمينه)",
 "階位": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "階名唱法": "صولميزاسيون (الغناء باستخدام مقاطع الصولفا للدلالة على نغمات سلم دو الكبير) / تسمية النغمات, صولفيج (نظام لتسمية نوتات السلم الموسيقي بمقاطع صوتية بدلاً من الحروف)",
 "階層": "صِنْف, صَنْف / طَبَقَة / فَصْل, صَفّ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)\nمثال: اقرأ هذا الفصل.",
 "階層メニュー": "قائمة فرعية, قائمة هرمية (قائمة ثانوية تظهر أثناء وضع المؤشر فوق عنصر في القائمة الرئيسية)",
 "階層分類体系": "نظام تصنيف هرمي (نظام تصنيف حيث يتم ترتيب المدخلات بناءً على بنية هرمية)",
 "階層化": "تنضيد (وضع البذور في رمل رطب أو نشارة خشب لحفظها أو تعزيز الإنبات) / تراصف, تطبقات (فعل أو عملية ترتيب الأشخاص في طبقات أو شرائح اجتماعية) / تطبق (تكوين طبقي) / ترسب طبقي, تطبّق (التشكيل أو الترسيب في طبقات)",
 "階層化メニュー": "قائمة فرعية, قائمة هرمية (قائمة ثانوية تظهر أثناء وضع المؤشر فوق عنصر في القائمة الرئيسية)",
 "階層型メニュー": "قائمة فرعية, قائمة هرمية (قائمة ثانوية تظهر أثناء وضع المؤشر فوق عنصر في القائمة الرئيسية)",
 "階層構造": "تنضيد (وضع البذور في رمل رطب أو نشارة خشب لحفظها أو تعزيز الإنبات) / تراصف, تطبقات (فعل أو عملية ترتيب الأشخاص في طبقات أو شرائح اجتماعية) / تطبق (تكوين طبقي) / ترسب طبقي, تطبّق (التشكيل أو الترسيب في طبقات)",
 "階差": "فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ",
 "階数": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "階梯": "سَلَالِم / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "階段": "سَلَالِم",
 "階段の吹き抜け": "عَمُود السُّلَّم",
 "階段ホール": "عَمُود السُّلَّم",
 "階段室": "عَمُود السُّلَّم",
 "階段昇降機": "تلفريك الكراسي, مصعد الكراسي (مصعد تزلج يجلس فيه الركاب (المتزلجون أو السياح) ويُنقلون صعوداً أو هبوطاً على سفح الجبل؛ حيث تكون المقاعد معلقة بكابل علوي لا نهائي)",
 "階級": "صِنْف, صَنْف / طَبَقَة / فَصْل, صَفّ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / طَائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه)\nمثال: اقرأ هذا الفصل. / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
 "階級制度": "نظام طبقي (هيكل اجتماعي يتم فيه تحديد الطبقات عن طريق الوراثة)",
 "階級差別": "طَبَقِيَّة, تَمَايُز طَبَقِيّ",
 "階級闘争": "صراع الطبقات",
 "階調": "تَدَرُّج / تَدْرِيج",
 "随一": "أَفْضَل",
 "随伴": "حُضُور (فعل التواجد (في اجتماع أو حدث إلخ)) / حضور (عدد الأشخاص الموجودين) / حُضُور, مُوَاظَبَة (تواتر وجود الشخص في مكان ما)\nمثال: زاد الحضور بنسبة 50 في المائة",
 "随伴現象": "ظاهرة ثانوية, ظاهرة مصاحبة (ظاهرة ثانوية تعد ناتجاً عرضياً لظاهرة أخرى)",
 "随伴者": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "随分": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / فَظِيع / مُرْعِب / فَظِيع, أَرْبَد / لافت للنظر",
 "随員": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / حَاضِر, مُتَوَاجِد (موجود (في اجتماع أو حدث ونحوه)) / تزامن, مرافقة (حدث أو موقف يحدث في نفس الوقت أو بالارتباط مع آخر) / حاضِر, حُضُور (شخص حاضر ومشارك في اجتماع)\nمثال: كان حاضراً دائماً في اجتماعات القسم",
 "随従": "تَابِع / مُتَابِع",
 "随従者": "تَابِع / مُتَابِع",
 "随想録": "مَقَالَة, بَحْث",
 "随意": "إرادي, تطوعي (بمحض إرادتك أو تصميمك؛ تم بالاختيار؛ غير مجبر أو مكره) / إرادي (يتم التحكم فيه بواسطة الإرادة الفردية) / عزف حر, مقطوعة تطوعية (تأليف (غالباً ما يكون مرتجلاً) لآلة منفردة (خاصة الأرغن) وليس جزءاً منتظماً من الخدمة الدينية أو الأداء الموسيقي) / متطوع, متطوع عسكري ((عسكرياً) شخص يتطوع بحرية للخدمة)\nمثال: الإنسان فاعل مختار",
 "随意的": "إرادي, تطوعي (بمحض إرادتك أو تصميمك؛ تم بالاختيار؛ غير مجبر أو مكره) / إرادي (يتم التحكم فيه بواسطة الإرادة الفردية) / عزف حر, مقطوعة تطوعية (تأليف (غالباً ما يكون مرتجلاً) لآلة منفردة (خاصة الأرغن) وليس جزءاً منتظماً من الخدمة الدينية أو الأداء الموسيقي) / متطوع, متطوع عسكري ((عسكرياً) شخص يتطوع بحرية للخدمة)\nمثال: الإنسان فاعل مختار",
 "随意筋": "عضلة إرادية (عضلة مخططة يمكن التحكم فيها إرادياً)",
 "随所": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "随時": "حسب الحاجة (وفقاً للحاجة (تستخدم طبياً))\nمثال: أضف الماء حسب الحاجة",
 "随神の道": "شِنْتَوِيَّة, شِنْتُو",
 "随筆": "مَقَالَة, بَحْث",
