 "角笛": "بُوق (فَسَد؛ باق الرجل: كَذَب) / زَمْر, بُوق\nمثال: كان سامي ينبه بالبوق.",
 "角結膜炎": "التهاب القرنية والملتحمة (التهاب القرنية والملتحمة)",
 "角縁の眼鏡": "ذُو إِطَارٍ قَرْنِيّ (ذو إطار مصنوع من القرن أو صَدَفة السلحفاة أو البلاستيك المُشابِه)",
 "角縁眼鏡": "ذُو إِطَارٍ قَرْنِيّ (ذو إطار مصنوع من القرن أو صَدَفة السلحفاة أو البلاستيك المُشابِه)",
 "角胡麻": "بروبوسيديا, مخالب الشيطان (نبات حولي من جنوب الولايات المتحدة إلى المكسيك له أزهار كبيرة بيضاء أو صفراء مرقطة بالأرجواني ومنقار منحن طويل)",
 "角膜": "قَرْنِيَّة",
 "角膜切開": "بضع القرنية (شق جراحي في القرنية)",
 "角膜炎": "التهاب القرنية (التهاب القرنية يسبب دمع العين وألم وتشوش الرؤية)",
 "角膜移植": "رأب القرنية, زراعة القرنية (إجراء جراحي يتم فيه استبدال جزء أو كل القرنية التالفة أو المريضة بأنسجة قرنية سليمة من متبرع)",
 "角膜銀行": "بنك العيون (مكان لتخزين وحفظ القرنيات التي يتم الحصول عليها من الجثث البشرية مباشرة بعد الوفاة؛ تستخدم لزرع القرنية للمرضى الذين يعانون من عيوب القرنية)",
 "角苔": "حشيشة القرن (حشائش كبدية بكبسولات رفيعة تشبه القرن) / شمبلان, نبات قرني الأوراق",
 "角苔類": "حشيشة القرن (حشائش كبدية بكبسولات رفيعة تشبه القرن) / شمبلان, نبات قرني الأوراق",
 "角苦瓜": "كيوانو",
 "角茄子": "عُشَر (الثَلَاثُ العُشَر: الليلة العاشرة والحادية عشر والثانية عشر من كل شهر قمري…)\nمثال: لدي عشرة أقلام.",
 "角蜥蜴": "سحلية مقرنة (سحلية آكلة للحشرات ذات أشواك تشبه القرون على الرأس وحراشف شائكة على الجسم؛ من غرب أمريكا الشمالية)",
 "角蝉": "نطاط الشجر (حشرة صغيرة قافزة تمتص عصارة الفروع والأغصان)",
 "角行": "فِيل (حيوان ثديي آكل أعشاب، وهو أكبر الحيوانات الأرضية الحية؛ (في الشطرنج) قطعة من قطع الشطرنج تتحرك بشكل قطري، ورمزها \"♗\" أو \"♝\")\nمثال: لدى الفيل أنف طويل.",
 "角角しい": "صعب المراس, عنيد (غير طيع؛ صعب الإدارة أو التشكيل)\nمثال: طبع عنيد",
 "角谷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "角貝": "صدفة سنية (أي من رخويات شاطئ البحر المختلفة التي لها صدفة أنبوبية مستدقة مفتوحة من كل طرف وقدم مدببة مثل المجرفة للحفر)",
 "角質": "كيراتين",
 "角質化": "تقرن (عملية عضوية يتم فيها ترسيب الكيراتين في الخلايا وتصبح الخلايا قرنية (كما في الأظافر والشعر))",
 "角質層": "طبقة قرنية, طبقة متقرنة (الطبقة الخارجية من البشرة وتتكون من خلايا ميتة تتساقط)",
 "角質落し": "تَقَشُّر, حَرْشَفَة (رقاقة رفيعة من البشرة الميتة تنسلخ من سطح الجلد) / تقشر (تقشر اللحاء أو الجلد الميت على شكل رقائق أو قشور)\nمثال: يزداد التقشر بسبب حروق الشمس",
 "角質落とし": "تَقَشُّر, حَرْشَفَة (رقاقة رفيعة من البشرة الميتة تنسلخ من سطح الجلد) / تقشر (تقشر اللحاء أو الجلد الميت على شكل رقائق أو قشور)\nمثال: يزداد التقشر بسبب حروق الشمس",
 "角距": "مسافة زاوية (الفصل الزاوي بين جسمين كما يدركه المراقب)\nمثال: سجل المسافات الزاوية بين النجوم",
 "角距離": "مسافة زاوية (الفصل الزاوي بين جسمين كما يدركه المراقب)\nمثال: سجل المسافات الزاوية بين النجوم",
 "角逐": "مُنَافَسَة, مُبَارَاة / مُنَافَسَة, مُسَابَقَة",
 "角通": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير.",
 "角速度": "سُرْعَة زَاوِيَّة ((الفيزياء) معدل تغير الموضع الزاوي لجسم يدور؛ يُعبر عنه عادة بالراديان في الثانية أو الراديان في الدقيقة)",
 "角運動量": "زخم زاوي (حاصل ضرب زخم جسم دوار وبعده عن محور الدوران)\nمثال: أي جسم دوار له زخم زاوي حول مركز كتلته",
 "角錐": "هَرَم, أَهْرَام ((في الهندسة) منشور كثير السطوح، قاعدته مضلع، وأوجهه الأخرى مثلثات، قواعدها أضلاع مضلع القاعدة، ورؤوسها مجتمعة في نقطة واحدة خارجة عنه؛ بناء أثري بناه الفراعنة في مصر بالحجارة الصلبة، ذو قاعدة مربعة، له أربع واجهات، وكل واجهة مثلثة الشكل، تلتقي رؤوسها فتكون رأسًا واحدًا هو قمة الهرم)",
 "角錐台": "هرم ناقص (جذع مُشكل من هرم)",
 "角鎖蛇": "أفعى مقرنة (أفعى شديدة السمية من شمال أفريقيا وجنوب غرب آسيا لها شوكة قرنية فوق كل عين)",
 "角閃岩": "أمفيبوليت (صخر متحول يتكون أساساً من الأمفيبول والبلاجيوكلاز)",
 "角閃石": "أمفيبول (معدن أو نوع معدني ينتمي إلى مجموعة الأمفيبول)",
 "角食": "خُبْز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / عيش (مصدر للفعل عَاشَ؛ هو الحَيَاة) / خُبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / خبز (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب) / قرص / خَبَزَ (هو طعام يصنع من الدَقِيق الذي يعجن بالماء والخَمِيرَة ويُخْبَز في الفُرْن أو التَنُّور؛ خُبْز الغُراب: الفِطْر، ويسمى أيضا عُشّ الغُرَاب)\nمثال: هذا الخبز لذيذ.",
 "角馬": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "角鮫": "كلب البحر (أي من عدة أسماك قرش صغيرة) / مقوسة الزعنفة (سمكة بدائية طويلة الجسم آكلة للحوم تعيش في المياه العذبة ولها زعنفة ظهرية طويلة جداً؛ توجد في المياه الراكدة في أمريكا الشمالية)",
 "觜": "مِنْقَار",
 "解": "مَحْلُول (أكثر ما يستخدم في حَلَّ بمعنى وصل إلى حَلّ في مشكلة ما أو مسألة رياضية أو سؤال ما وإن جاز استخدامه في غيره؛ ماء قد حُلَّ فيه شيء ما مثل الملح أو السكر أو غيره) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: اصبعي تحول الى بني بعد ان غمرته في محلول برمنغانات البوتاسيوم الكثيف جزئيا. / تَفْسِير, شَرْح",
 "解かす": "فُرْشَاة / فَرَشَ / مَشَّطَ (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "解きがたい": "صعب المراس, عنيد (غير طيع؛ صعب الإدارة أو التشكيل)\nمثال: طبع عنيد",
 "解きほぐす": "اِسْتَرْخَى",
 "解き放す": "حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: هو,البارحة حرر من الحبس.",
 "解き放つ": "أَطْلَقَ سَرَاح, حَرَّرَ",
 "解き明かす": "ذَابَ, حَلَّ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا فشيئًا، مثل ذوبان الجليد أو اختفاء الألم)\nمثال: ذاب ذلك الجليد.",
 "解き難い": "صعب المراس, عنيد (غير طيع؛ صعب الإدارة أو التشكيل)\nمثال: طبع عنيد",
 "解く": "فَكَّ / ذَابَ, حَلَّ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا فشيئًا، مثل ذوبان الجليد أو اختفاء الألم)\nمثال: ذاب ذلك الجليد. / بَدَّدَ, أَزَالَ ((بَدَّدَ) الشَّيْءَ: فرّقه) / تلاشي تدريجي, مزج ((في الفيلم) انتقال تدريجي من مشهد إلى التالي؛ يتم تركيب المشهد التالي تدريجياً بينما يتلاشى المشهد السابق)",
 "解けた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "解けない": "عَصِيٌّ عَلَى الحَلّ, مُسْتَعْصٍ (ليس سهل الحلّ؛ يصعب التوصّل إلى حلّه)",
 "解ける": "استجمام, استرخاء (التحرر من النشاط (العمل أو الجهد أو المسؤولية)) / بَسَاطَة, سُهُولَة (التحرر من الصعوبة أو المشقة أو الجهد) / أَرِيحِيَّة, بَسَاطَة (التحرر من القيد أو الحرج) / تخفيف, راحة (حالة الارتياح أو التخفيف (خاصة بعد التخلص من الضيق))\nمثال: أخذ قسطاً من الراحة بجانب المسبح / ذَابَ, انْصَهَرَ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا فشيئًا، مثل ذوبان الجليد أو اختفاء الألم)\nمثال: ذاب ذلك الجليد. / تلاشي تدريجي, مزج ((في الفيلم) انتقال تدريجي من مشهد إلى التالي؛ يتم تركيب المشهد التالي تدريجياً بينما يتلاشى المشهد السابق)",
 "解す": "أَرْخَى, حَلَّ / رُقَاقة, شَظِيَّة صغيرة (شظية صغيرة من شيء انفصلت عن الكل) / غَرِيب الْأَطْوَار (شخص ذو شخصية غير عادية أو غريبة) / ندفة الثلج (بلورة من الثلج)\nمثال: أصابت عينه شظية صخرية صغيرة / استجمام, استرخاء (التحرر من النشاط (العمل أو الجهد أو المسؤولية)) / بَسَاطَة, سُهُولَة (التحرر من الصعوبة أو المشقة أو الجهد) / أَرِيحِيَّة, بَسَاطَة (التحرر من القيد أو الحرج) / تخفيف, راحة (حالة الارتياح أو التخفيف (خاصة بعد التخلص من الضيق))\nمثال: أخذ قسطاً من الراحة بجانب المسبح / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / فَسَّرَ, أَوَّلَ",
 "解する": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / فَسَّرَ, أَوَّلَ",
 "解せない": "غامِض, غَلِق",
 "解せる": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "解り": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "解りにくい": "غامض, غير مفهوم (صعب الفهم) / عصي على الفهم, لا يمكن تفسيره (غير قادر على أن يفسر أو يعلل)\nمثال: الشيء الأكثر غموضاً (عدم قابلية للفهم) في الكون هو أنه قابل للفهم",
 "解り難い": "غامض, غير مفهوم (صعب الفهم) / عصي على الفهم, لا يمكن تفسيره (غير قادر على أن يفسر أو يعلل)\nمثال: الشيء الأكثر غموضاً (عدم قابلية للفهم) في الكون هو أنه قابل للفهم",
 "解る": "فَهِمَ (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم. / أَظُنُّ ذٰلِك",
 "解れ": "شِجَار عَلَنِيّ, عِرَاك (قتال صاخب)",
 "解任": "إِقَالَة",
 "解体": "هَدْم (الثوبُ ٱلْخَلَقُ المُرَقَّعُ؛ الكِساءُ الذي ضُوعِفت رِقَاعُهُ)\nمثال: توم يرسم خطة لهدم المنزل. / انحلال, انفصال (إنهاء أو تفكك علاقة (بين أشخاص أو دول)) / رفع الجلسة, فض الاجتماع (إنهاء اجتماع) / انحلال, فجور (انغماس منحل في الملذات الحسية) / انحلال, تفكك (الانفصال إلى أجزاء مكونة) / تبضيع, تشريح (القطع بغرض الفصل إلى قطع) / تحليل نقدي دقيق, تشريح (تحليل نقدي مفصل أو فحص جزء تلو الآخر (كما في العمل الأدبي)) / تحليل دقيق, تشريح (تحليل دقيق ونقدي)",
 "解体屋": "مُخَرِّب / ساحة خردة (حقل يتم فيه جمع الخردة وتخزينها لإعادة بيعها)",
 "解体工場": "ورشة تفكيك سيارات (مكان يتم فيه تفكيك السيارات المسروقة للحصول على قطع غيارها)",
 "解傭": "إِقَالَة",
 "解像": "عَزْم, عُزْم / دِقَّة",
 "解像力": "دقة, قدرة التمييز (قدرة المجهر أو التلسكوب على قياس الفصل الزاوي للصور المتقاربة)",
 "解像度": "عَزْم, عُزْم / دِقَّة",
 "解凍": "دفء, ذوبان الجليد (طقس دافئ يعقب التجمد؛ يذوب فيه الثلج والجليد) / انصهار, ذوبان (العملية التي تغير فيها الحرارة شيئاً من الحالة الصلبة إلى السائلة)\nمثال: رحبوا بذوبان الجليد الربيعي / تخفيف الضغط (تخفيف الضغط (خاصة إعادة شخص مضغوط تدريجياً إلى الضغط الجوي)) / فك الضغط (استعادة المعلومات المضغوطة إلى شكلها الطبيعي للاستخدام أو العرض)",
 "解凝剤": "مذيب, مُحِل (مادة سائلة قادرة على إذابة مواد أخرى)\nمثال: المذيب لا يغير حالته عند تكوين محلول",
 "解剖": "تبضيع, تشريح (القطع بغرض الفصل إلى قطع) / تحليل نقدي دقيق, تشريح (تحليل نقدي مفصل أو فحص جزء تلو الآخر (كما في العمل الأدبي)) / تحليل دقيق, تشريح (تحليل دقيق ونقدي) / تَحْلِيل / تَحْلِيل رِيَاضِيّ / تَحْلِيلْ مُخْتَبَرِيّ",
 "解剖学": "تَشْرِيح",
 "解剖学者": "مُشَرِّح, مُشَرِّحَة",
 "解呪": "تحرر من الوهم, زوال الوهم (التحرر من الاعتقاد الخاطئ أو الأوهام)",
 "解団": "حَلّ (فعل الحل (لمنظمة أو جماعة))\nمثال: واجهت الأوركسترا احتمال الحل",
 "解式": "مَحْلُول (أكثر ما يستخدم في حَلَّ بمعنى وصل إلى حَلّ في مشكلة ما أو مسألة رياضية أو سؤال ما وإن جاز استخدامه في غيره؛ ماء قد حُلَّ فيه شيء ما مثل الملح أو السكر أو غيره) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: اصبعي تحول الى بني بعد ان غمرته في محلول برمنغانات البوتاسيوم الكثيف جزئيا.",
 "解放": "أَطْلَقَ سَرَاح, حَرَّرَ\nمثال: 人質は解放されるだろう。 — سيُفرج عن الرهائن.",
 "解放の神学": "لاهوت التحرير (شكل من أشكال اللاهوت المسيحي (طوره الكاثوليك في أمريكا الجنوبية) يؤكد على التحرر الاجتماعي والسياسي كاستباق للخلاص النهائي)",
 "解放軍報": "جَيْش التَحْرِير الشَعْبِيّ الصِينِيّ (الجُنْد السائرون لحرب أو غيرها. ويطلق أيضا على هؤلاء الجند وكل الهيئات التابعة لهم حتى وإن كانوا في السلم؛ الجمع الغفير من الناس)\nمثال: هل كان في الجيش.",
 "解散": "تشتت, نثر (عملية تشتيت أو نشر شيء ما)\nمثال: تشتت القوات / انحلال, انفصال (إنهاء أو تفكك علاقة (بين أشخاص أو دول)) / رفع الجلسة, فض الاجتماع (إنهاء اجتماع) / انحلال, فجور (انغماس منحل في الملذات الحسية) / انحلال, تفكك (الانفصال إلى أجزاء مكونة)",
 "解明": "إيضاح, تبيان (تفسير يزيل عقبات الفهم) / تبيان, توضيح (فعل الشرح الذي يخدم في إزالة الغموض وإلقاء الضوء)\nمثال: ساعدها توضيح الأستاذ على فهم الكتاب المدرسي",
 "解明す": "ذَابَ, حَلَّ (تحوّل الشيء من حالته الصلبة إلى حالة سائلة نتيجة الحرارة؛ زال أو تلاشى شيئًا فشيئًا، مثل ذوبان الجليد أو اختفاء الألم)\nمثال: ذاب ذلك الجليد.",
 "解析": "تَحْلِيل / تَحْلِيل رِيَاضِيّ / تَحْلِيلْ مُخْتَبَرِيّ",
 "解析器": "جهاز تحليل, محلل (أداة تقوم بإجراء التحليلات)",
 "解析学": "تَحْلِيل / تَحْلِيل رِيَاضِيّ / تَحْلِيلْ مُخْتَبَرِيّ",
 "解析幾何学": "هندسة إحداثية, هندسة تحليلية (استخدام الجبر لدراسة الخصائص الهندسية)",
 "解析性": "تحليلية (خاصية كون الشيء تحليلياً)",
 "解析部": "جهاز تحليل, محلل (أداة تقوم بإجراء التحليلات)",
 "解止": "إنهاء, خاتمة (فعل إنهاء شيء ما) / خاتمة, نهاية (نهاية الكلمة (لاحقة أو نهاية تصريفية أو مورفيم نهائي)) / عاقبة, نتيجة (شيء ينتج عن أمر ما) / محطة أخيرة, نقطة نهاية (مكان ينتهي فيه شيء أو يكتمل)\nمثال: إنهاء الاتفاقية",
 "解毒": "إزالة السموم (علاج للتسمم عن طريق تحييد الخصائص السامة (عادة وظيفة الكبد)) / تخلص من السموم, علاج الإدمان (علاج لإدمان المخدرات أو الكحول يهدف إلى إزالة الآثار الفسيولوجية للمواد المسببة للإدمان)",
 "解毒剤": "تِرْيَاق (دواء مركب يدفع السموم؛ ما يضاد عمل السمّ)",
 "解毒薬": "تِرْيَاق (دواء مركب يدفع السموم؛ ما يضاد عمل السمّ)",
 "解氷": "دفء, ذوبان الجليد (طقس دافئ يعقب التجمد؛ يذوب فيه الثلج والجليد) / انصهار, ذوبان (العملية التي تغير فيها الحرارة شيئاً من الحالة الصلبة إلى السائلة)\nمثال: رحبوا بذوبان الجليد الربيعي",
 "解氷剤": "مذيب الجليد, مزيل الجليد (مادة تستخدم لإذابة الجليد؛ يمكن أن تكون على شكل سائل أو بلورات صلبة)\nمثال: عزيزتي، الممر مغطى بالجليد مرة أخرى، أعتقد أننا يجب أن نشتري مذيباً للجليد قبل أن ينزلق شخص ما ويكسر ساقه",
 "解決": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "解決の糸口": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)",
 "解決不能": "عَصِيٌّ عَلَى الحَلّ, مُسْتَعْصٍ (ليس سهل الحلّ؛ يصعب التوصّل إلى حلّه)",
 "解決方法": "مَحْلُول (أكثر ما يستخدم في حَلَّ بمعنى وصل إلى حَلّ في مشكلة ما أو مسألة رياضية أو سؤال ما وإن جاز استخدامه في غيره؛ ماء قد حُلَّ فيه شيء ما مثل الملح أو السكر أو غيره) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: اصبعي تحول الى بني بعد ان غمرته في محلول برمنغانات البوتاسيوم الكثيف جزئيا.",
 "解決法": "مَحْلُول (أكثر ما يستخدم في حَلَّ بمعنى وصل إلى حَلّ في مشكلة ما أو مسألة رياضية أو سؤال ما وإن جاز استخدامه في غيره؛ ماء قد حُلَّ فيه شيء ما مثل الملح أو السكر أو غيره) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: اصبعي تحول الى بني بعد ان غمرته في محلول برمنغانات البوتاسيوم الكثيف جزئيا.",
 "解決済": "أُحَادِيُّ الْهَدَفِ, مُصَمِّمٌ (مُصَمِّم ومُنصَبّ على هدف واحد) / محلول, مفكك (لغزه) (تم تفسيره أو الإجابة عليه)\nمثال: ألغاز محلولة وغير محلولة",
 "解決済み": "أُحَادِيُّ الْهَدَفِ, مُصَمِّمٌ (مُصَمِّم ومُنصَبّ على هدف واحد) / محلول, مفكك (لغزه) (تم تفسيره أو الإجابة عليه)\nمثال: ألغاز محلولة وغير محلولة",
 "解決策": "مَحْلُول (أكثر ما يستخدم في حَلَّ بمعنى وصل إلى حَلّ في مشكلة ما أو مسألة رياضية أو سؤال ما وإن جاز استخدامه في غيره؛ ماء قد حُلَّ فيه شيء ما مثل الملح أو السكر أو غيره) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: اصبعي تحول الى بني بعد ان غمرته في محلول برمنغانات البوتاسيوم الكثيف جزئيا.",
 "解法": "مَحْلُول (أكثر ما يستخدم في حَلَّ بمعنى وصل إلى حَلّ في مشكلة ما أو مسألة رياضية أو سؤال ما وإن جاز استخدامه في غيره؛ ماء قد حُلَّ فيه شيء ما مثل الملح أو السكر أو غيره) / حَلّ (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته)\nمثال: اصبعي تحول الى بني بعد ان غمرته في محلول برمنغانات البوتاسيوم الكثيف جزئيا.",
