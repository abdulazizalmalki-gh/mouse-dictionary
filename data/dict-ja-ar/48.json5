 "西舘": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "西蔵": "التِّبِت, تُبَّت",
 "西藏": "التِّبِت, تُبَّت",
 "西蛮蜀黍": "عشب جونسون, عشب حلب (عشب معمر طويل ينتشر عن طريق الجذامير الزاحفة ويزرع للعلف؛ متوطن في جنوب…)",
 "西角目鳥": "بفن أطلسي (بفن شائع في شمال المحيط الأطلسي)",
 "西語": "إِسْبَانِيّ",
 "西谷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "西遊記": "سَعْدَان, قِرْد",
 "西部": "غَرْب (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة…)\nمثال: تغرب الشمس في الغرب.",
 "西部劇": "غَرْبِيّ",
 "西郷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "西野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "西風": "رياح غربية (رياح تهب من الغرب إلى الشرق)",
 "西鼠鮫": "لِيَّاءٌ",
 "要": "ارتكاز, تمحور (عملية الدوران على (أو كما لو كان على) محور)\nمثال: ذهب لاعب الغولف إلى ميدان التدريب لممارسة ارتكازه / حجر أساس (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر. / ضَرُورَة, حَاجَة",
 "要す": "حَاجَة, ضَرُورَة",
 "要する": "حَاجَة, ضَرُورَة",
 "要するに": "بِاخْتِصَار",
 "要は": "بِاخْتِصَار",
 "要らぬ": "لَا مُبَرِّر لَه, مَجَّانِيّ (غير ضروري وغير مبرر)",
 "要り": "صَرْف, مَصْرُوف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال…)\nمثال: أيمكنك صرف خمسين؟",
 "要事": "ضَرُورَة",
 "要人": "شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث)\nمثال: 彼は要人だから、そのように扱わねばならない。 — هو شخصية مهمة و يجب أن نعامله على هذا الأساس.",
 "要介護度": "رعاية تمريضية (رعاية من قبل ممرض ماهر)",
 "要件": "ضَرُورَة",
 "要償": "دَعْوَى, اِدِّعَاء (إدِّعَاء؛ دُعَاء)\nمثال: رفضت الضحية إقامة دعوى قضائية.",
 "要出典": "بِحَاجَةٍ لِمَصْدَرٍ",
 "要否": "ضَرُورَة, حَاجَة",
 "要員": "إدارة الموارد البشرية, قسم شؤون الموظفين (القسم المسؤول عن تعيين وتدريب وتوزيع الموظفين ووضع سياسات إدارة الأفراد)\nمثال: قوة عامة ضرورية لتوفير الأمن لحقوق المواطنين",
 "要図": "لَخَّصَ, اِخْتَصَرَ",
 "要塞": "قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "要塞化": "مَعْقِل (الملجأ والجبل المرتفع)\nمثال: رغم أن إيران مشهورة بأنها معقل الفكر الشيعي في عصرنا، إلا أن معظم أهلها كانوا من السنة حتى القرن الخامس عشر.",
 "要害": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما…)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "要害堅固": "لَا يُقْهَر, مَنِيع (لَا يُمْكِنُ التَّغَلُّبُ عَلَيْهِ أَوْ تَحَدِّيهِ أَوْ دَحْضُهُ)",
 "要式": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "要所": "جَوْهَرِيّ, مَوْضُوعِيّ (يحدد الحقوق والواجبات بدلاً من إعطاء القواعد التي يتم بموجبها تأسيس الحقوق…)\nمثال: القانون الموضوعي",
 "要撃": "كَمين / اعتراض الكرة ((كرة القدم الأمريكية) فعل التقاط كرة القدم من قبل لاعب في الفريق المنافس)\nمثال: لجأ إلى اعتراض رسائل ابنته",
 "要撃機": "طائرة اعتراضية, معترضة (طائرة مقاتلة سريعة وقادرة على المناورة مصممة لاعتراض طائرات العدو)",
 "要旨": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "要望": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا.",
 "要求": "طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا.",
 "要求事項": "ضَرُورَة",
 "要求側": "مستعطف, ملتمس (شخص يطلب شيئاً بتواضع)\nمثال: مستعطف لرضاها",
 "要求側ＳＳ利用者": "مستعطف, ملتمس (شخص يطلب شيئاً بتواضع)\nمثال: مستعطف لرضاها",
 "要求払い預金": "وديعة تحت الطلب (وديعة بنكية يمكن السحب منها دون إشعار مسبق)",
 "要求書": "حراسة قضائية, مصادرة مؤقتة (الاستيلاء على ممتلكات تخص شخصاً آخر والاحتفاظ بها حتى تدفع الأرباح الطلب الذي…)\nمثال: أولاً عليك ملء طلب الصرف",
 "要求者": "مُدَّعٍ, مُدَّعِيَة",
 "要点": "لُبّ",
 "要略": "مَثَال",
 "要目": "برنامج دراسي, منهج دراسي (دورة متكاملة من الدراسات الأكاديمية)\nمثال: تم قبوله في برنامج جديد في الجامعة",
 "要相談": "قَابِل لِلتَّحْوِيل, قَابِل لِلتَّدَاوُل (يمكن نقل ملكيته قانونياً إلى شخص آخر)",
 "要石": "حجر العقد (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر.",
 "要約": "خُلَاصَة, مُلَخَّص\nمثال: その報告を１ページに要約せよ。 — لَخِّص التقرير في صفحة.",
 "要約すれば": "بِاخْتِصَار",
 "要約者": "موعود (شخص يتم تقديم وعد له)",
 "要素": "مُكَوِّن, جُزْء / عُنْصُر كِيمِيَائِيّ, عُنْصُر (الْأَصْل؛ الجِنْس)\nمثال: المغنيزيوم عنصر كيميائي.",
 "要素別処理": "أَوَّلِيّ, جَوْهَرِيّ (من الجزء الأساسي أو الجوهري أو يكونه)\nمثال: كبريت عنصري",
 "要綱": "لُبّ",
 "要義": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "要覧": "لَخَّصَ, اِخْتَصَرَ",
 "要解": "لَخَّصَ, اِخْتَصَرَ",
 "要説": "لَخَّصَ, اِخْتَصَرَ",
 "要請": "اِلْتِمَاس, اِسْتِئْنَاف / بَدِيهِيَّة",
 "要諦": "زِرّ",
 "要路": "حكومة, سلطة (المنظمة التي تمثل السلطة الحاكمة لوحدة سياسية)\nمثال: خفضت الحكومة الضرائب",
 "要項": "لُبّ",
 "要領": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه. / براعة, مهارة خاصة (طريقة خاصة أو مهارة فطرية للقيام بشيء ما)\nمثال: كان لديه ميل لذلك",
 "要領よく": "فِي صَمِيمِ الْمَوْضُوعِ (ذو صلة دقيقة أو منطقية بالمسألة المطروحة)",
 "要領を得ない": "عَرَضِيّ",
 "要領書": "كُتَيِّب, كُتَيِّب التَّشْغِيل (كِتَاب صَغِير؛ دَلِيل)",
 "要領良く": "فِي صَمِيمِ الْمَوْضُوعِ (ذو صلة دقيقة أو منطقية بالمسألة المطروحة)",
 "覆": "إخفاء, كتمان (نشاط إبقاء شيء ما سراً)\nمثال: وفر ستار من الأشجار الخصوصية / فوز غير متوقع, قلب التوقعات (نصر غير محتمل وغير متوقع)\nمثال: أكبر فوز غير متوقع منذ فوز داود على جالوت",
 "覆い": "غِطَاء",
 "覆いかぶさる": "غِطَاء",
 "覆い被さる": "غِطَاء",
 "覆い隠す": "قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "覆う": "غِطَاء",
 "覆す": "فوز غير متوقع, قلب التوقعات (نصر غير محتمل وغير متوقع)\nمثال: أكبر فوز غير متوقع منذ فوز داود على جالوت / أَطَاحَ / عَكَسَ",
 "覆われ": "غِطَاء",
 "覆刻": "إعادة نشر (عملية النشر مرة أخرى)",
 "覆刻版": "طبعة منفصلة, مُستَلّة (مقال مطبوع بشكل منفصل ظهر أصلاً في منشور أكبر)",
 "覆審": "مراجعة قضائية (مراجعة من قبل محكمة قانونية لإجراءات مسؤول حكومي أو هيئة أو شخص أو هيئة أخرى…)",
 "覆水盆に返らず": "مَا حَدَثَ قَد حَدَثَ, مَا فَاتَ قَدْ مَاتْ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "覆滅": "إفساد, تخريب (التدمير المتحقق عن طريق تحطيم الشيء أو إفساده)\nمثال: لقد جلبت الخراب على هذه العائلة بأكملها",
 "覆蔵": "اِحْتِيَاط\nمثال: حجز مناد موعدا.",
 "覆輪馬酔木": "أندروميدا يابانية, شجرة زنبق الوادي (شجيرة آسيوية دائمة الخضرة عريضة الأوراق ذات أوراق لامعة وعناقيد متدلية من…)",
 "覆面": "قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع. / مَجْهُول",
 "覇": "تَفَوُّق / دعم, مؤازرة (فعل تقديم الموافقة والدعم)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "覇を唱える": "سَيْطَرَ",
 "覇業": "هَيْمَنَة, سَيْطَرَة",
 "覇権": "هَيْمَنَة, سَيْطَرَة",
 "覇権争い": "صِرَاع عَلَى ٱلسُّلْطَة",
 "覇気": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة. / مَطْمَح",
 "覇王": "مُسْتَبِدّ, جَبَّار",
 "覇王樹": "صَبَّار",
 "覇王竜": "تيرانوصور, تيرانوصور ريكس (ديناصور لاحم كبير ثنائي الأرجل له أسنان ضخمة ذات حواف مسننة تشبه السكاكين؛ ربما…)",
 "覇者": "غَازٍ / نَصِير, نَصِيرَة",
 "覇道": "غَازٍ",
 "覊束": "غُلّ, أَغْلال",
 "覊絆": "غُلّ, أَغْلال",
 "見": "مشاهدة, نظر (فعل توجيه العينين نحو شيء ما وإدراكه بصرياً)\nمثال: خرج ليلقي نظرة / حَاوَلَ, سَعَى (طَلَبَ، رَامَ)\nمثال: حاول توم قتلنا! / مَنْظَر, مَشْهَد",
 "見あげる": "عَجَبَ",
 "見いだす": "اِكْتَشَفَ / اِخْتَارَ / حا َسـِب",
 "見い出す": "اِكْتَشَفَ / اِخْتَارَ / حا َسـِب",
 "見うける": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا.",
 "見え": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ…)\nمثال: ثبت مناد مكانه. / جِلْسَة, جَلْسَة",
 "見えた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "見えっ張り": "استعراضي, محب للظهور (شخص يتصرف عمداً بطريقة تجذب الانتباه)",
 "見えづらい": "غير مميز, غير واضح (غير محدد بوضوح أو ليس من السهل إدراكه أو فهمه)\nمثال: أشكال غير واضحة في الظلام",
 "見えない": "أَعْمَى, عَمْيَاء / بَالِغ الصِّغَر, مِيكْرَوِيّ (صغير للغاية في النطاق أو المدى أو القدرة) / شَفَّاف / بَعِيد المَدَى (يغطي مسافة طويلة)",
 "見えにくい": "مُظْلِم",
 "見える": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا. / جَاءَ (أَتَى؛ حَدَثَ)\nمثال: تقريبا الكل جاء / لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ)\nمثال: لقد التقى بماري. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه. / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "見える化": "تصور بصري, صورة بصرية (صورة ذهنية تشبه الإدراك البصري)",
 "見え見え": "بَدِيهِيّ, بَدَهِيّ",
 "見え辛い": "غير مميز, غير واضح (غير محدد بوضوح أو ليس من السهل إدراكه أو فهمه)\nمثال: أشكال غير واضحة في الظلام",
 "見え難い": "مُظْلِم",
 "見おろす": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة. / اِحْتَقَرَ, أَهَانَ",
 "見かけ": "بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "見かける": "لَاحَظَ",
 "見かけ上": "بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "見かじめ": "إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة)",
 "見くびる": "صَغَّرَ, اِحْتَقَرَ (جعل الشيء أصغر حجمًا أو أقل قيمة؛ قلل من أهمية شخص أو شيء أو استهان به)\nمثال: الصغر أسرع من النسر",
 "見ごたえ": "بَلِيغ, مُؤَثِّر (يُنتج أثراً قويّاً)\nمثال: احتفال مثير للإعجاب",
 "見す": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "見すてる": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا!",
 "見すぼらしい": "بَالٍ",
 "見すます": "تَأَكَّدَ",
 "見ず知らず": "غَرِيب, عَجِيب\nمثال: どうして見ず知らずの男が自分の名前を知っているんだろう？ — كيف يعرف شخص أجنبيّ تماما اسمه؟ / عَدَم أُلْفَة, غَرَابَة (الغرابة نتيجة لعدم كون الشيء معروفاً جيداً)",
 "見せかけ": "بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "見せかける": "اِدَّعَى\nمثال: تظاهر بأنه طبيب.",
 "見せしめ": "دَرْس, حِصَّة ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: أراك بعد الدرس.",
 "見せつける": "استعراض, تباهي (فعل عرض شيء ما بتفاخر)\nمثال: كان سلوكه استعراضاً شائناً",
 "見せびらかす": "استعراض, تباهي (فعل عرض شيء ما بتفاخر)\nمثال: كان سلوكه استعراضاً شائناً",
 "見せる": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ…)\nمثال: ثبت مناد مكانه.",
 "見せブラ": "استعراضي, محب للظهور (شخص يتصرف عمداً بطريقة تجذب الانتباه)",
 "見せ付ける": "استعراض, تباهي (فعل عرض شيء ما بتفاخر)\nمثال: كان سلوكه استعراضاً شائناً",
 "見せ場": "إبراز ضوئي, منطقة مضيئة (منطقة من السطوع في الصورة)\nمثال: كان الجزء الأبرز في الجولة زيارتنا للفاتيكان / استعراضي, محب للظهور (شخص يتصرف عمداً بطريقة تجذب الانتباه)",
 "見せ所": "معلم سياحي, مكان للعرض (مكان يتم عرضه وزيارته بشكل متكرر لاهتمامه التاريخي أو جماله الطبيعي)",
 "見せ掛け": "بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "見せ掛ける": "اِدَّعَى\nمثال: تظاهر بأنه طبيب.",
 "見せ板": "طَبَقَة",
 "見せ櫓": "برج مراقبة, مرصد (هيكل يطل على مشهد واسع لمحيطه)",
 "見せ物": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ…)\nمثال: ثبت مناد مكانه.",
 "見せ物小屋": "خيمة السيرك (خيمة قماشية لإيواء الجمهور في عرض السيرك)\nمثال: كان خائفاً من حريق في خيمة السيرك",
 "見せ玉": "طَبَقَة",
 "見たてる": "اِخْتَارَ / شَخَّصَ (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد…)\nمثال: هذا الشخص فنان. / قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت. / شَبَّهَ",
 "見たところ": "عَلَى مَا يَبْدُوْ, لِأَوَّلِ وَهْلَةٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "見た所": "عَلَى مَا يَبْدُوْ, لِأَوَّلِ وَهْلَةٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "見た目": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب.",
 "見っともいい": "بشكل صحيح, كما ينبغي (بالطريقة الصحيحة؛ بشكل لائق)\nمثال: أرجوك قم بعملك كما ينبغي!",
 "見つける": "وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه…)\nمثال: وجد ياني هاتفه.",
 "見つけ出す": "اِكْتَشَفَ",
 "見つめなおす": "حَلَّلَ (بالمكان: جعله يحل به؛ الشيء: جعله حلالا بعد أن كان حراما)\nمثال: حلل زيري ذلك الفيديو.",
 "見つめる": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ…)\nمثال: حدق الجميع في وجهي.",
 "見つめ直す": "حَلَّلَ (بالمكان: جعله يحل به؛ الشيء: جعله حلالا بعد أن كان حراما)\nمثال: حلل زيري ذلك الفيديو.",
 "見づらい": "غير مميز, غير واضح (غير محدد بوضوح أو ليس من السهل إدراكه أو فهمه)\nمثال: أشكال غير واضحة في الظلام",
 "見てくれ": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب.",
 "見てとる": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد…)\nمثال: لم أدرك أبدا أنه يحبني.",
 "見てまわる": "تَلَفَّتَ",
 "見てもらう": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا. / نَصَحَ (نصحه: أَرْشَدَه وأَشَارَ عليه)\nمثال: نصح مناد بباية.",
 "見て取る": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد…)\nمثال: لم أدرك أبدا أنه يحبني.",
 "見て回る": "تَلَفَّتَ",
 "見て貰う": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا. / نَصَحَ (نصحه: أَرْشَدَه وأَشَارَ عليه)\nمثال: نصح مناد بباية.",
 "見とがめる": "سُؤَال, سؤال (سُؤَال)\nمثال: أجب على السؤال.",
 "見とる": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد…)\nمثال: لم أدرك أبدا أنه يحبني.",
 "見どころ": "إبراز ضوئي, منطقة مضيئة (منطقة من السطوع في الصورة)\nمثال: كان الجزء الأبرز في الجولة زيارتنا للفاتيكان / وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به)\nمثال: وعد بأن يتزوجها.",
 "見なおす": "أَعَادَ الفحص, رَاجَعَ (نظر مرة أخرى؛ فحص مرة أخرى)\nمثال: لنراجع وضعك / حَسَّنَ (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "見なし": "حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "見なす": "تحديق, نظرة ثابتة (نظرة ثابتة وطويلة)\nمثال: ثبت نظرته الأبوية علي",
 "見にくい": "مُظْلِم",
 "見に出かける": "حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً…)\nمثال: حضر كل شيئ لرحلتي.",
 "見に出掛ける": "حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً…)\nمثال: حضر كل شيئ لرحلتي.",
 "見に来る": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة)\nمثال: زار سامي مسجدا.",
 "見に行く": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة)\nمثال: زار سامي مسجدا.",
 "見ぬく": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد…)\nمثال: لم أدرك أبدا أنه يحبني.",
 "見はる": "حا َسـِب",
 "見まがう": "أَسَاء اَلْفَهْم, أَخْطَأَ\nمثال: كان خطأ حاسوبي.",
 "見まごう": "أَسَاء اَلْفَهْم, أَخْطَأَ\nمثال: كان خطأ حاسوبي.",
 "見もの": "مَشْهَد",
 "見も知らぬ": "غَيْر مَأْلُوف (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "見やすい": "جَذَّاب",
 "見やる": "نَظَرَ (اِسْتَعْمَلَ عينه ليَرَى الشيءَ، ليُدْرِكَه ويُبْصِرَه. (مَصْدَرُهُ نَظَر)…)\nمثال: نظر إلى السماء.",
 "見ゆ": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا. / جَاءَ (أَتَى؛ حَدَثَ)\nمثال: تقريبا الكل جاء",
 "見られたものじゃない": "مُذْهِل, مُفْزِع (يسبب الذعر والفزع)\nمثال: هل من الأفضل رؤية الأمر المروع أم مجرد السماع عنه؟",
 "見られたものではない": "مُذْهِل, مُفْزِع (يسبب الذعر والفزع)\nمثال: هل من الأفضل رؤية الأمر المروع أم مجرد السماع عنه؟",
 "見られる": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا.",
 "見る": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا. / فَحَصَ, اِمْتَحَنَ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في :…)\nمثال: فحص الطبيب بطني. / اِهْتَمَّ, اِعْتَنَى / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "見るから": "بُوضُوح",
 "見ると聞くとは大違い": "هُنَاكَ, يُوجَدُ",
 "見るべき": "شيء لا يُفَوَّت, ما يجب رؤيته (شيء يُعَد الاطلاع عليه أو رؤيته أمراً ضرورياً)",
 "見るも": "بوضوح, جلياً (بشكل لا لبس فيه)\nمثال: الإجابة خاطئة بوضوح",
