 "西語": "إِسْبَانِيّ / إسبانية",
 "西谷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "西遊記": "سَعْدَان, قِرْد",
 "西部": "غَرْب (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَغْرِب (مَكَان غُرُوب الشَمْس، ويقصد به الغَرْب مجَازًا؛ زَمَان غروب الشمس) / غرب (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم)\nمثال: تغرب الشمس في الغرب.",
 "西部劇": "غَرْبِيّ / وِيسْتَرْن, الْغَرْب",
 "西郷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "西野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "西風": "رياح غربية (رياح تهب من الغرب إلى الشرق)",
 "西鼠鮫": "لِيَّاءٌ",
 "要": "ارتكاز, تمحور (عملية الدوران على (أو كما لو كان على) محور) / محور ارتكاز (محور يتكون من عمود قصير يدعم شيئاً يدور) / محور الارتكاز (الشخص في الصف الذي يدور ويناور الآخرون حوله)\nمثال: ذهب لاعب الغولف إلى ميدان التدريب لممارسة ارتكازه / حجر أساس (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر. / ضَرُورَة, حَاجَة",
 "要す": "حَاجَة, ضَرُورَة / اِحْتَاجَ",
 "要する": "حَاجَة, ضَرُورَة / اِحْتَاجَ",
 "要するに": "بِاخْتِصَار",
 "要は": "بِاخْتِصَار",
 "要らぬ": "لَا مُبَرِّر لَه, مَجَّانِيّ (غير ضروري وغير مبرر)",
 "要り": "صَرْف, مَصْرُوف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال وبمعنى الرَدّ والمَنْع)\nمثال: أيمكنك صرف خمسين؟",
 "要事": "ضَرُورَة / مَطْلَب, طَلَب",
 "要人": "شخصية مؤثرة, شخصية هامة (شخص تؤثر أفعاله وآراؤه بقوة على مسار الأحداث)\nمثال: 彼は要人だから、そのように扱わねばならない。 — هو شخصية مهمة و يجب أن نعامله على هذا الأساس.",
 "要介護度": "رعاية تمريضية (رعاية من قبل ممرض ماهر)",
 "要件": "ضَرُورَة / مَطْلَب, طَلَب",
 "要償": "دَعْوَى, اِدِّعَاء (إدِّعَاء؛ دُعَاء) / مُطَالَبَة / ٱِدَّعَى, زَعَمَ\nمثال: رفضت الضحية إقامة دعوى قضائية.",
 "要出典": "بِحَاجَةٍ لِمَصْدَرٍ",
 "要否": "ضَرُورَة, حَاجَة",
 "要員": "إدارة الموارد البشرية, قسم شؤون الموظفين (القسم المسؤول عن تعيين وتدريب وتوزيع الموظفين ووضع سياسات إدارة الأفراد) / قوة (مجموعة من الناس مستعدة لإطاعة الأوامر)\nمثال: قوة عامة ضرورية لتوفير الأمن لحقوق المواطنين",
 "要図": "لَخَّصَ, اِخْتَصَرَ",
 "要塞": "قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "要塞化": "مَعْقِل (الملجأ والجبل المرتفع)\nمثال: رغم أن إيران مشهورة بأنها معقل الفكر الشيعي في عصرنا، إلا أن معظم أهلها كانوا من السنة حتى القرن الخامس عشر.",
 "要害": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "要害堅固": "لَا يُقْهَر, مَنِيع (لَا يُمْكِنُ التَّغَلُّبُ عَلَيْهِ أَوْ تَحَدِّيهِ أَوْ دَحْضُهُ) / قَابِل لِلحَمْل, قَادِر عَلَى الإِنْجَاب (قَادِر عَلَى الحَمْل والإِخْصَاب) / لَا يُقْهَر, مَنِيع (مُحَصَّنٌ ضِدَّ الهُجُوم؛ لَا يُمْكِنُ العَبَثُ بِه)",
 "要式": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي.",
 "要所": "جَوْهَرِيّ, مَوْضُوعِيّ (يحدد الحقوق والواجبات بدلاً من إعطاء القواعد التي يتم بموجبها تأسيس الحقوق والواجبات) / أساسي, جوهري (أساسي وجوهري) / بَالِغ الأَهَمِّيَّة, جَوْهَرِيّ (من الأهمّيّة القُصوى) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: القانون الموضوعي",
 "要撃": "كَمين / كَمِين / اعتراض الكرة ((كرة القدم الأمريكية) فعل التقاط كرة القدم من قبل لاعب في الفريق المنافس) / اعتراض (فعل الاعتراض؛ منع شيء ما من المضي قدماً أو الوصول)\nمثال: لجأ إلى اعتراض رسائل ابنته",
 "要撃機": "طائرة اعتراضية, معترضة (طائرة مقاتلة سريعة وقادرة على المناورة مصممة لاعتراض طائرات العدو)",
 "要旨": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "要望": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "要求": "طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / مُطَّلِب / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "要求事項": "ضَرُورَة / مَطْلَب, طَلَب",
 "要求側": "مستعطف, ملتمس (شخص يطلب شيئاً بتواضع)\nمثال: مستعطف لرضاها",
 "要求側ＳＳ利用者": "مستعطف, ملتمس (شخص يطلب شيئاً بتواضع)\nمثال: مستعطف لرضاها",
 "要求払い預金": "وديعة تحت الطلب (وديعة بنكية يمكن السحب منها دون إشعار مسبق)",
 "要求書": "حراسة قضائية, مصادرة مؤقتة (الاستيلاء على ممتلكات تخص شخصاً آخر والاحتفاظ بها حتى تدفع الأرباح الطلب الذي تم الاستيلاء عليها من أجله) / طلب صرف, نموذج طلب رسمي (نموذج رسمي يتم فيه تقديم طلب (عادة لمواد أو إمدادات)) / اسْتِيلَاء, طَلَب رَسْمِيّ (طلب رسمي أو مطالبة، خاصة من قبل سلطة عسكرية أو عامة تستولي على شيء (عادة مؤقتاً) للاستخدام العسكري أو العام)\nمثال: أولاً عليك ملء طلب الصرف",
 "要求者": "مُدَّعٍ, مُدَّعِيَة",
 "要点": "لُبّ",
 "要略": "مَثَال",
 "要目": "برنامج دراسي, منهج دراسي (دورة متكاملة من الدراسات الأكاديمية)\nمثال: تم قبوله في برنامج جديد في الجامعة",
 "要相談": "قَابِل لِلتَّحْوِيل, قَابِل لِلتَّدَاوُل (يمكن نقل ملكيته قانونياً إلى شخص آخر) / قَابِلٌ لِلتَّفَاوُض, مَطْرُوحٌ لِلنِّقَاش (يُمْكِنُ التَّفَاوُضُ بِشَأْنِهِ أَوْ تَسْوِيَتُهُ بِالتَّوَافُقِ) / قَابِلٌ لِلاجْتِيَاز (يُمْكِنُ المُرُورُ عَبْرَهُ أَوْ تَخَطِّيه)",
 "要石": "حجر العقد (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "要約": "خُلَاصَة, مُلَخَّص\nمثال: その報告を１ページに要約せよ。 — لَخِّص التقرير في صفحة.",
 "要約すれば": "بِاخْتِصَار",
 "要約者": "موعود (شخص يتم تقديم وعد له)",
 "要素": "مُكَوِّن, جُزْء / عُنْصُر كِيمِيَائِيّ, عُنْصُر (الْأَصْل؛ الجِنْس)\nمثال: المغنيزيوم عنصر كيميائي.",
 "要素別処理": "أَوَّلِيّ, جَوْهَرِيّ (من الجزء الأساسي أو الجوهري أو يكونه) / عنصري (متعلق بـ أو كونه عنصراً (كيميائياً)) / جوهري, عاصف (متعلق بالظروف الجوية القاسية)\nمثال: كبريت عنصري",
 "要綱": "لُبّ",
 "要義": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "要覧": "لَخَّصَ, اِخْتَصَرَ",
 "要解": "لَخَّصَ, اِخْتَصَرَ",
 "要説": "لَخَّصَ, اِخْتَصَرَ",
 "要請": "اِلْتِمَاس, اِسْتِئْنَاف / اِسْتَأْنَفَ / بَدِيهِيَّة",
 "要諦": "زِرّ",
 "要路": "حكومة, سلطة (المنظمة التي تمثل السلطة الحاكمة لوحدة سياسية)\nمثال: خفضت الحكومة الضرائب",
 "要項": "لُبّ",
 "要領": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / براعة, مهارة خاصة (طريقة خاصة أو مهارة فطرية للقيام بشيء ما)\nمثال: كان لديه ميل لذلك",
 "要領よく": "فِي صَمِيمِ الْمَوْضُوعِ (ذو صلة دقيقة أو منطقية بالمسألة المطروحة)",
 "要領を得ない": "عَرَضِيّ",
 "要領書": "كُتَيِّب, كُتَيِّب التَّشْغِيل (كِتَاب صَغِير؛ دَلِيل) / يَدَوِيّ",
 "要領良く": "فِي صَمِيمِ الْمَوْضُوعِ (ذو صلة دقيقة أو منطقية بالمسألة المطروحة)",
 "覆": "إخفاء, كتمان (نشاط إبقاء شيء ما سراً) / ستار, غطاء (غطاء يعمل على إخفاء أو حماية شيء ما) / خصوصية, سرية (حالة الاخفاء أو الكتمان)\nمثال: وفر ستار من الأشجار الخصوصية / فوز غير متوقع, قلب التوقعات (نصر غير محتمل وغير متوقع) / انقلاب, قلب (عملية قلب شيء ما)\nمثال: أكبر فوز غير متوقع منذ فوز داود على جالوت",
 "覆い": "غِطَاء / غِلَاف / غَطَّى",
 "覆いかぶさる": "غِطَاء / غِلَاف / غَطَّى",
 "覆い被さる": "غِطَاء / غِلَاف / غَطَّى",
 "覆い隠す": "قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "覆う": "غِطَاء / غِلَاف / غَطَّى",
 "覆す": "فوز غير متوقع, قلب التوقعات (نصر غير محتمل وغير متوقع) / انقلاب, قلب (عملية قلب شيء ما)\nمثال: أكبر فوز غير متوقع منذ فوز داود على جالوت / أَطَاحَ / عَكَسَ",
 "覆われ": "غِطَاء / غِلَاف / غَطَّى",
 "覆刻": "إعادة نشر (عملية النشر مرة أخرى) / إعادة نشر (شيء تم نشره مرة أخرى؛ منشور جديد (كما لعمل أدبي))",
 "覆刻版": "طبعة منفصلة, مُستَلّة (مقال مطبوع بشكل منفصل ظهر أصلاً في منشور أكبر) / إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "覆審": "مراجعة قضائية (مراجعة من قبل محكمة قانونية لإجراءات مسؤول حكومي أو هيئة أو شخص أو هيئة أخرى معينة قانونياً أو مراجعة محكمة استئناف لقرار محكمة ابتدائية)",
 "覆水盆に返らず": "مَا حَدَثَ قَد حَدَثَ, مَا فَاتَ قَدْ مَاتْ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "覆滅": "إفساد, تخريب (التدمير المتحقق عن طريق تحطيم الشيء أو إفساده) / دمار, سقوط (فشل يؤدي إلى فقدان المنصب أو السمعة) / خراب, دمار (حدث يؤدي إلى التدمير) / خراب, هلاك (حالة دمار وتدمير لا يمكن إصلاحها)\nمثال: لقد جلبت الخراب على هذه العائلة بأكملها",
 "覆蔵": "اِحْتِيَاط / ذَخِيرَة / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "覆輪馬酔木": "أندروميدا يابانية, شجرة زنبق الوادي (شجيرة آسيوية دائمة الخضرة عريضة الأوراق ذات أوراق لامعة وعناقيد متدلية من الزهور البيضاء)",
 "覆面": "قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع. / مَجْهُول",
 "覇": "تَفَوُّق / دعم, مؤازرة (فعل تقديم الموافقة والدعم) / بطولة (مسابقة يتم فيها اختيار البطل) / بطولة (مكانة كونه بطلاً)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين",
 "覇を唱える": "سَيْطَرَ",
 "覇業": "هَيْمَنَة, سَيْطَرَة",
 "覇権": "هَيْمَنَة, سَيْطَرَة",
 "覇権争い": "صِرَاع عَلَى ٱلسُّلْطَة",
 "覇気": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة. / مَطْمَح",
 "覇王": "مُسْتَبِدّ, جَبَّار",
 "覇王樹": "صَبَّار",
 "覇王竜": "تيرانوصور, تيرانوصور ريكس (ديناصور لاحم كبير ثنائي الأرجل له أسنان ضخمة ذات حواف مسننة تشبه السكاكين؛ ربما كان قمّاماً (آكل جيف) بدلاً من مفترس نشط؛ من أواخر العصر الطباشيري في…)",
 "覇者": "غَازٍ / نَصِير, نَصِيرَة",
 "覇道": "غَازٍ",
 "覊束": "غُلّ, أَغْلال",
 "覊絆": "غُلّ, أَغْلال",
 "見": "مشاهدة, نظر (فعل توجيه العينين نحو شيء ما وإدراكه بصرياً) / بحث بصري, نظر (فعل البحث بصرياً) / ذُو صَوْت, ذُو مَظْهَر (يبدو كما يُوصَف؛ يُستخدَم عادةً في التراكيب المركّبة)\nمثال: خرج ليلقي نظرة / حَاوَلَ, سَعَى (طَلَبَ، رَامَ) / حَاكَمَ (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر) / مُحَاوَلَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: حاول توم قتلنا! / مَنْظَر, مَشْهَد",
 "見あげる": "عَجَبَ",
 "見いだす": "اِكْتَشَفَ / اِخْتَارَ / حا َسـِب",
 "見い出す": "اِكْتَشَفَ / اِخْتَارَ / حا َسـِب",
 "見うける": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "見え": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه. / جِلْسَة, جَلْسَة / تَكَلُّف",
 "見えた": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "見えっ張り": "استعراضي, محب للظهور (شخص يتصرف عمداً بطريقة تجذب الانتباه)",
 "見えづらい": "غير مميز, غير واضح (غير محدد بوضوح أو ليس من السهل إدراكه أو فهمه)\nمثال: أشكال غير واضحة في الظلام",
 "見えない": "أَعْمَى, عَمْيَاء / بَالِغ الصِّغَر, مِيكْرَوِيّ (صغير للغاية في النطاق أو المدى أو القدرة) / شَفَّاف / بَعِيد المَدَى (يغطي مسافة طويلة) / بعيد المسافة, طويل المدى (مكون من أو متعلق بـ أو كونه مكالمة هاتفية بعيدة المسافة)",
 "見えにくい": "مُظْلِم",
 "見える": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء / لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "見える化": "تصور بصري, صورة بصرية (صورة ذهنية تشبه الإدراك البصري)",
 "見え見え": "بَدِيهِيّ, بَدَهِيّ",
 "見え辛い": "غير مميز, غير واضح (غير محدد بوضوح أو ليس من السهل إدراكه أو فهمه)\nمثال: أشكال غير واضحة في الظلام",
 "見え難い": "مُظْلِم",
 "見おろす": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة. / اِحْتَقَرَ, أَهَانَ",
 "見かけ": "بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "見かける": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "見かけ上": "بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "見かじめ": "إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة)",
 "見くびる": "صَغَّرَ, اِحْتَقَرَ (جعل الشيء أصغر حجمًا أو أقل قيمة؛ قلل من أهمية شخص أو شيء أو استهان به)\nمثال: الصغر أسرع من النسر",
 "見ごたえ": "بَلِيغ, مُؤَثِّر (يُنتج أثراً قويّاً) / مؤثر, مثير للإعجاب (يترك انطباعاً قوياً أو حياً)\nمثال: احتفال مثير للإعجاب",
 "見す": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "見すてる": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "見すぼらしい": "بَالٍ",
 "見すます": "تَأَكَّدَ",
 "見ず知らず": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب\nمثال: どうして見ず知らずの男が自分の名前を知っているんだろう？ — كيف يعرف شخص أجنبيّ تماما اسمه؟ / عَدَم أُلْفَة, غَرَابَة (الغرابة نتيجة لعدم كون الشيء معروفاً جيداً)",
 "見せかけ": "بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "見せかける": "اِدَّعَى / زَعَمَ / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب.",
 "見せしめ": "دَرْس, حِصَّة ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / عِبْرَة (الدَمْعَة قبل أن تفيض؛ المَشَاعِر العميقة الحزينة)\nمثال: أراك بعد الدرس.",
 "見せつける": "استعراض, تباهي (فعل عرض شيء ما بتفاخر)\nمثال: كان سلوكه استعراضاً شائناً",
 "見せびらかす": "استعراض, تباهي (فعل عرض شيء ما بتفاخر)\nمثال: كان سلوكه استعراضاً شائناً",
 "見せる": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه.",
 "見せブラ": "استعراضي, محب للظهور (شخص يتصرف عمداً بطريقة تجذب الانتباه)",
 "見せ付ける": "استعراض, تباهي (فعل عرض شيء ما بتفاخر)\nمثال: كان سلوكه استعراضاً شائناً",
 "見せ場": "إبراز ضوئي, منطقة مضيئة (منطقة من السطوع في الصورة) / الجزء الأبرز, علامة مميزة (الجزء الأكثر إثارة للاهتمام أو الذي لا يُنسى)\nمثال: كان الجزء الأبرز في الجولة زيارتنا للفاتيكان / استعراضي, محب للظهور (شخص يتصرف عمداً بطريقة تجذب الانتباه)",
 "見せ所": "معلم سياحي, مكان للعرض (مكان يتم عرضه وزيارته بشكل متكرر لاهتمامه التاريخي أو جماله الطبيعي)",
 "見せ掛け": "بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "見せ掛ける": "اِدَّعَى / زَعَمَ / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب.",
 "見せ板": "طَبَقَة",
 "見せ櫓": "برج مراقبة, مرصد (هيكل يطل على مشهد واسع لمحيطه)",
 "見せ物": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه.",
 "見せ物小屋": "خيمة السيرك (خيمة قماشية لإيواء الجمهور في عرض السيرك)\nمثال: كان خائفاً من حريق في خيمة السيرك",
 "見せ玉": "طَبَقَة",
 "見たてる": "اِخْتَارَ / شَخَّصَ (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان. / قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / شَبَّهَ",
 "見たところ": "عَلَى مَا يَبْدُوْ, لِأَوَّلِ وَهْلَةٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "見た所": "عَلَى مَا يَبْدُوْ, لِأَوَّلِ وَهْلَةٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "見た目": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "見っともいい": "بشكل صحيح, كما ينبغي (بالطريقة الصحيحة؛ بشكل لائق) / عفيف, لائق (مطابق لأعراف السلوك الجنسي (الأخلاقي)) / لَائِق, مَقْبُول (يفي بالمتطلبات والمعايير المطلوبة) / لَائِق, مُحْتَشِم (يُرَاعِي الآدَابَ الأَخْلَاقِيَّةَ فِي الكَلَامِ وَالسُّلُوكِ وَالمَلْبَس)\nمثال: أرجوك قم بعملك كما ينبغي!",
 "見つける": "وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه. (يتعدى بعلى)) / لَقِيَّة\nمثال: وجد ياني هاتفه.",
 "見つけ出す": "اِكْتَشَفَ",
 "見つめなおす": "حَلَّلَ (بالمكان: جعله يحل به؛ الشيء: جعله حلالا بعد أن كان حراما)\nمثال: حلل زيري ذلك الفيديو.",
 "見つめる": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ فُلاناً: إِذا أَصَابَ حَدَقَتَه؛ حدَق به:أَحَاطَ به من كلّ جهة (حدَقت قوات الأمن بالقرية))\nمثال: حدق الجميع في وجهي.",
 "見つめ直す": "حَلَّلَ (بالمكان: جعله يحل به؛ الشيء: جعله حلالا بعد أن كان حراما)\nمثال: حلل زيري ذلك الفيديو.",
 "見づらい": "غير مميز, غير واضح (غير محدد بوضوح أو ليس من السهل إدراكه أو فهمه)\nمثال: أشكال غير واضحة في الظلام",
 "見てくれ": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "見てとる": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد أن سَبَقَه)\nمثال: لم أدرك أبدا أنه يحبني.",
 "見てまわる": "تَلَفَّتَ",
 "見てもらう": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا. / نَصَحَ (نصحه: أَرْشَدَه وأَشَارَ عليه) / اِسْتَشَارَ\nمثال: نصح مناد بباية.",
 "見て取る": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد أن سَبَقَه)\nمثال: لم أدرك أبدا أنه يحبني.",
 "見て回る": "تَلَفَّتَ",
 "見て貰う": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا. / نَصَحَ (نصحه: أَرْشَدَه وأَشَارَ عليه) / اِسْتَشَارَ\nمثال: نصح مناد بباية.",
 "見とがめる": "سُؤَال, سؤال (سُؤَال) / مَسْأَلَة / استفهم\nمثال: أجب على السؤال.",
 "見とる": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد أن سَبَقَه)\nمثال: لم أدرك أبدا أنه يحبني.",
 "見どころ": "إبراز ضوئي, منطقة مضيئة (منطقة من السطوع في الصورة) / الجزء الأبرز, علامة مميزة (الجزء الأكثر إثارة للاهتمام أو الذي لا يُنسى)\nمثال: كان الجزء الأبرز في الجولة زيارتنا للفاتيكان / وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها.",
 "見なおす": "أَعَادَ الفحص, رَاجَعَ (نظر مرة أخرى؛ فحص مرة أخرى)\nمثال: لنراجع وضعك / حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "見なし": "حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "見なす": "تحديق, نظرة ثابتة (نظرة ثابتة وطويلة) / اكتراث, اهتمام (إيلاء اهتمام خاص (كما هو الحال مع الأطفال أو العاجزين)) / جانب, صدد ((عادة تسبقها 'في') تفصيل أو نقطة معينة) / احترام, تقدير (موقف يتسم بالإعجاب والتقدير)\nمثال: ثبت نظرته الأبوية علي",
 "見にくい": "مُظْلِم",
 "見に出かける": "حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً؛ ويُعَدَّى فَيُقَالُ: حَضَرَه وحَضِرَه؛ حَضَرَ، كنَصَرَ وعلِمَ، حُضُورًا وحضارَةً: ضِدُّ غابَ)\nمثال: حضر كل شيئ لرحلتي.",
 "見に出掛ける": "حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً؛ ويُعَدَّى فَيُقَالُ: حَضَرَه وحَضِرَه؛ حَضَرَ، كنَصَرَ وعلِمَ، حُضُورًا وحضارَةً: ضِدُّ غابَ)\nمثال: حضر كل شيئ لرحلتي.",
 "見に来る": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "見に行く": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "見ぬく": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد أن سَبَقَه)\nمثال: لم أدرك أبدا أنه يحبني.",
 "見はる": "حا َسـِب",
 "見まがう": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "見まごう": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "見もの": "مَشْهَد / مَنْظَر",
 "見も知らぬ": "غَيْر مَأْلُوف (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "見やすい": "جَذَّاب",
 "見やる": "نَظَرَ (اِسْتَعْمَلَ عينه ليَرَى الشيءَ، ليُدْرِكَه ويُبْصِرَه. (مَصْدَرُهُ نَظَر)؛ (يتعدى تعدية عامة بإلى))\nمثال: نظر إلى السماء.",
 "見ゆ": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء",
 "見られたものじゃない": "مُذْهِل, مُفْزِع (يسبب الذعر والفزع) / أمر مروع, فاجعة (تجربة تثير الفزع أو الروعة)\nمثال: هل من الأفضل رؤية الأمر المروع أم مجرد السماع عنه؟",
 "見られたものではない": "مُذْهِل, مُفْزِع (يسبب الذعر والفزع) / أمر مروع, فاجعة (تجربة تثير الفزع أو الروعة)\nمثال: هل من الأفضل رؤية الأمر المروع أم مجرد السماع عنه؟",
 "見られる": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "見る": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا. / فَحَصَ, اِمْتَحَنَ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض)\nمثال: فحص الطبيب بطني. / اِهْتَمَّ, اِعْتَنَى / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "見るから": "بُوضُوح",
 "見ると聞くとは大違い": "هُنَاكَ, يُوجَدُ",
 "見るべき": "شيء لا يُفَوَّت, ما يجب رؤيته (شيء يُعَد الاطلاع عليه أو رؤيته أمراً ضرورياً)",
 "見るも": "بوضوح, جلياً (بشكل لا لبس فيه)\nمثال: الإجابة خاطئة بوضوح",
 "見るも無惨": "بَائِس",
