 "複眼的": "مُتَشَعِّب, مُتَعَدِّدُ الجَوَانِب (ذُو جَوَانِبَ أَوْ صِفَاتٍ كَثِيرَة)",
 "複素": "مَعْقِد / عُقْدَة",
 "複素共役": "مُرَافِق, مُرَادِف",
 "複素平面": "المستوى المركب (تمثيل هندسي للأعداد المركبة يتكون من المحور الحقيقي والمحور التخيلي المتعامد)",
 "複素数": "عَدَد عَقَدِيّّ, عَدَد مُرَكِّب (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "複素環": "حلقة غير متجانسة, مركب حلقي غير متجانس (حلقة من ذرات من أكثر من نوع؛ خاصة حلقة من ذرات الكربون تحتوي على ذرة واحدة على الأقل ليست كربوناً) / مركب حلقي غير متجانس (مركب يحتوي على حلقة غير متجانسة)",
 "複素環式化合物": "مركب حلقي غير متجانس (مركب يحتوي على حلقة غير متجانسة)",
 "複舌": "اِزْدِوَاجِيَّة لُغَوِيَّة, دِيجْلُوسْيَا",
 "複葉": "ورقة مركبة (ورقة تتكون من عدد من الوريقات على ساق مشترك) / طائرة ثنائية الأجنحة (طائرة من طراز قديم؛ لها جناحان أحدهما فوق الآخر)",
 "複葉機": "طائرة ثنائية الأجنحة (طائرة من طراز قديم؛ لها جناحان أحدهما فوق الآخر)",
 "複製": "تَكَاثُر",
 "複製品": "نُسْخَة / اِنْتَسَخَ, نَسَخَ",
 "複視": "رؤية مزدوجة, شفع (ضعف بصري يُرى فيه الجسم كجسمين)\nمثال: غالباً ما يختفي الشفع عند تغطية إحدى العينين",
 "複試合": "زوجي (التنس التي تُلعب بلاعبين في كل جانب) / زوجي (تنس الريشة التي تُلعب بلاعبين في كل جانب)",
 "複雑": "مَعْقِد / عُقْدَة",
 "複雑さ": "تَعْقِيد",
 "複雑化": "تَعْقِيد / مُضَاعَفَة\nمثال: 現代の社会問題はますます複雑化する傾向がある。 — تميل مشكلات يومنا الاجتماعية إلى التعقيد أكثر فأكثر.",
 "複雑命令セットコンピュータ": "حاسوب بمجموعة تعليمات معقدة, سيسك ((علم الحاسوب) نوع من معمارية الحاسوب يحتوي على عدد كبير من التعليمات المرمزة في شريحة المعالج المركزي)",
 "複雑多岐": "شَائِك, مُعَقَّد (بَالِغ التَّعْقِيد أَوِ التَّشَابُك وَأَحْيَانًا مُخَادِع) / مُتَاهِيّ, مُتَعَرِّج (يُشْبِه المَتَاهَة فِي الشَّكْل أَوِ التَّعْقِيد) / تيهي (يتعلق بالأذن الداخلية (التيه) أو يؤثر عليها أو ينشأ فيها)\nمثال: صمم تيهي",
 "複雑性": "تَعْقِيد / مَعْقِد / عُقْدَة",
 "複雑訴訟形態": "دعوى جماعية (دعوى قضائية يرفعها عضو ممثل لمجموعة كبيرة من الناس نيابة عن جميع أعضاء المجموعة)",
 "複雑骨折": "كسر مركب, كسر مفتوح (كسر عظمي مصحوب بتهتك في الأنسجة الرخوة أو جرح مفتوح)",
 "褊狭": "انغلاق, ضيق الأفق (الميل لانتقاد الآراء المعارضة أو السلوكيات الصادمة)",
 "褌": "سروال تحتي, مئزر (رداء يوفر غطاءً لمنطقة العانة والوركين)",
 "褌担ぎ": "تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر)",
 "褐変": "تحمير, تحميص (الطهي حتى يصبح لونه بنياً ومقرمشاً فوق نار أو شواية)\nمثال: التحميص الجيد يجب أن يحمر جانبي قطعة الخبز",
 "褐炭": "فحم بني, ليغنيت (مرحلة وسيطة بين الخث والفحم البيتوميني)",
 "褐色斑": "قناع الحمل, كلف (تغير لون وجه المرأة إلى الأسمر ويرتبط بالحمل أو باستخدام حبوب منع الحمل)",
 "褐色細胞腫": "ورم القواتم (ورم وعائي في الغدة الكظرية)",
 "褐藻": "طحالب بنية (طحالب يحجب الكلوروفيل فيها أصباغ بنية وصفراء)",
 "褐藻類": "طحالب بنية (طحالب يحجب الكلوروفيل فيها أصباغ بنية وصفراء)",
 "褐鉄鉱": "ليمونيت (خام أكسيد الحديد واسع الانتشار؛ خليط من الغوثيت والهيماتيت والليبدوكروشيت)",
 "褐鉛鉱": "فانادينيت",
 "褒む": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "褒むべき": "مُحَمَّد (مُفَعَّل من حَمَّدَ؛ الذي يُحْمَدُ كثيرا)\nمثال: محمد رسول الله.",
 "褒めたてる": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "褒めちぎる": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "褒める": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "褒め上手": "جَذَّاب, سَاحِر (شخص يسحر الآخرين (عادة بجاذبيته الشخصية)) / ساحر, متملق (شخص ذو أسلوب واثق ومتملق)",
 "褒め奉る": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "褒め称える": "صَفَّقَ",
 "褒め立てる": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "褒め言葉": "تَأْبِين, أُمْدُوحَة / ثَنَاء, أُمْدُوحَة",
 "褒奨": "تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / تعويض (شيء (مثل المال) يُعطى أو يُستلم كدفعة أو تعويض (كما هو الحال عن خدمة أو خسارة أو إصابة)) / تعويض ((في الطب النفسي) آلية دفاع تخفي عيوبك غير المرغوب فيها عن طريق المبالغة في السلوكيات المرغوبة)",
 "褒奨金": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "褒称": "إِطْرَائِيّ, ثَنَائِيّ (مَلِيء بالثناء أو يُقَدِّم المديح)",
 "褒美": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "褒詞": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "褒貶": "نَقْد, اِنْتِقَاد",
 "褒賞": "سَلِيبَة / غَنِيمَة / جَائِزَة, مُكَافَأَة",
 "褒辞": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "褓": "حِفَاضة, حِفَاظ",
 "褥": "وِسَادَة (ما يوضع تحت الرأس عند النوم أو الاستلقاء) / وَسَادَة (ما يوضع تحت الرأس عند النوم أو الاستلقاء) / وُسَادَة (ما يوضع تحت الرأس عند النوم أو الاستلقاء) / نُمْرُقَة / نِمْرِقَة / نَمْرَقَة\nمثال: غطى توم رأسه بوسادة.",
 "褥傷": "قرحة الفراش (قرحة مزمنة في الجلد ناتجة عن الضغط المطول عليه)",
 "褥婦": "نفساء (امرأة في حالة الولادة أو بعد ذلك بقليل)",
 "褥瘡": "قرحة الفراش (قرحة مزمنة في الجلد ناتجة عن الضغط المطول عليه)",
 "褪せる": "اختفاء, تلاشٍ (التوقف التدريجي عن الظهور) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة / خَسَّ (خَسَّ الرجُلُ يَخِسُّ خِسَّةً، وخَسَاسَةً: حَقُرَ؛ يقال: خَسَّ فِعْلُهُ وقولُه ورأْيُه)\nمثال: بيع المنزل بثمن بخس.",
 "褪める": "اختفاء, تلاشٍ (التوقف التدريجي عن الظهور) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة",
 "褪紅": "وَرْدِيّ, زَهْرِيّ (هُو ما كان بِلَوْنِ الورد؛ ٌ إِلَىٰ ٱلْوَرْدِ) / زَهْرِيّ, وَرْدِيّ\nمثال: لا أظن أن توم سيشتري مظلة وردية.",
 "褪紅色": "وَرْدِيّ, زَهْرِيّ (هُو ما كان بِلَوْنِ الورد؛ ٌ إِلَىٰ ٱلْوَرْدِ) / زَهْرِيّ, وَرْدِيّ\nمثال: لا أظن أن توم سيشتري مظلة وردية.",
 "褪色": "توهين, خفوت (ضعف في القوة أو الشدة)\nمثال: توهين في حجم الصوت",
 "褫く": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار. / أَهْمَلَ / إِهْمَال",
 "褫奪": "تعرية, كشف (إزالة الغطاء)",
 "褶曲": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "褶襞": "طَوَى / طَيَّة",
 "褻": "دُنْيَوِيّ / عَادِيّ / مُمِلّ, مُضْجِر (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "褻にも晴れにも": "أبداً",
 "褻涜": "انتهاك الحرمة, تدنيس (الحط من قدر شيء يستحق الاحترام؛ تقليل القيمة) / ازدراء المقدسات, تجديف (سلوك تجديفي؛ فعل تجريد الشيء من طابعه المقدس)\nمثال: تدنيس السبت المقدس",
 "褻瀆": "انتهاك الحرمة, تدنيس (الحط من قدر شيء يستحق الاحترام؛ تقليل القيمة) / ازدراء المقدسات, تجديف (سلوك تجديفي؛ فعل تجريد الشيء من طابعه المقدس)\nمثال: تدنيس السبت المقدس",
 "襀翅": "ذبابة الحجر (حشرة مجنحة بدائية بجسم مسطح؛ تستخدم كطعم من قبل الصيادين؛ اليرقات المائية ذات الخياشيم لاحمة وتعيش تحت الحجارة)",
 "襁褓": "حِفَاضة, حِفَاظ",
 "襞": "طَوَى / طَيَّة / تَفْصِيل, تَفَاصِيل / فَصَّلَ (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل. / صفيحة رقيقة (لوحة رقيقة) / صفيحة (غشاء رقيق هو إحدى الطبقات المتكلسة التي تشكل العظام) / خيشوم, صفيحة (أي من الهياكل المشعة الشبيهة بالأوراق المنتجة للأبواغ على الجانب السفلي من غطاء الفطر أو فطريات مماثلة)",
 "襞襟": "دريجة شرسة",
 "襟": "يَاقَة, قَبَّة / طَوْق (وَضَعَ عليه طَوْقا؛ تَحَلَّقَ الناس أو الحيوانات أو غيرها حوله كالطوق، يستخدم تحلق إذا كان الأمر برضاه وطوّق إذا كان ذلك كرها)\nمثال: كلب زيري يحب ارتداء ذلك الطوق.",
 "襟ぐり": "خط العنق (الخط الذي تشكله حافة الملابس حول الرقبة)",
 "襟つき": "يَاقَة, قَبَّة / طَوْق (وَضَعَ عليه طَوْقا؛ تَحَلَّقَ الناس أو الحيوانات أو غيرها حوله كالطوق، يستخدم تحلق إذا كان الأمر برضاه وطوّق إذا كان ذلك كرها)\nمثال: كلب زيري يحب ارتداء ذلك الطوق. / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "襟の折り返し": "طَيَّة",
 "襟付": "يَاقَة, قَبَّة / طَوْق (وَضَعَ عليه طَوْقا؛ تَحَلَّقَ الناس أو الحيوانات أو غيرها حوله كالطوق، يستخدم تحلق إذا كان الأمر برضاه وطوّق إذا كان ذلك كرها)\nمثال: كلب زيري يحب ارتداء ذلك الطوق. / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "襟付き": "يَاقَة, قَبَّة / طَوْق (وَضَعَ عليه طَوْقا؛ تَحَلَّقَ الناس أو الحيوانات أو غيرها حوله كالطوق، يستخدم تحلق إذا كان الأمر برضاه وطوّق إذا كان ذلك كرها)\nمثال: كلب زيري يحب ارتداء ذلك الطوق. / أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "襟元": "رَقَبَة, عُنُق / يَاقَة, قَبَّة / طَوْق (وَضَعَ عليه طَوْقا؛ تَحَلَّقَ الناس أو الحيوانات أو غيرها حوله كالطوق، يستخدم تحلق إذا كان الأمر برضاه وطوّق إذا كان ذلك كرها)\nمثال: كلب زيري يحب ارتداء ذلك الطوق.",
 "襟回り": "يَاقَة, قَبَّة / طَوْق (وَضَعَ عليه طَوْقا؛ تَحَلَّقَ الناس أو الحيوانات أو غيرها حوله كالطوق، يستخدم تحلق إذا كان الأمر برضاه وطوّق إذا كان ذلك كرها)\nمثال: كلب زيري يحب ارتداء ذلك الطوق. / عَكْس عَقَارِب السَّاعَة (في اتجاه معاكس لاتجاه حركة عقارب الساعة) / عَكْس اتِّجَاه عَقَارِب السَّاعَة (في الاتجاه المعاكس لدوران عقارب الساعة)\nمثال: الرجاء التحرك عكس اتجاه عقارب الساعة في دائرة!",
 "襟巻": "وِشَاح, لِفاع",
 "襟巻き": "وِشَاح, لِفاع",
