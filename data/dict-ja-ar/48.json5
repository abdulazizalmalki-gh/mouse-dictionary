 "闘志": "عَارَكَ, قَاتَلَ / تَعَارَكَ, تَقَاتَلَ / نَاضَلَ, كَافَحَ / قِتَال (من قَتَلَ: كثير القَتْل) / مَعْرَكَة\nمثال: لن يحل القتال أي شيء.",
 "闘技": "مُنَافَسَة, مُبَارَاة / مُنَافَسَة, مُسَابَقَة",
 "闘技場": "صَالَة, حَلْبَة (مكان فسيح في وسط المسكن يُوصِلُ إلى سائر الحجرات، الرُدْهَة؛ غُرْفَةُ المَعِيْشَة سواء كانت توصل إلى سائر الحجرات أم لا وسواء كانت فسيحة أم لا)\nمثال: حجزت الصالة يوم الخميس.",
 "闘牛": "مُصَارَعَة ثِيرَانٍ",
 "闘牛場": "حلبة مصارعة الثيران (ملعب تقام فيه مصارعة الثيران)",
 "闘牛士": "مُصارِع ثِيرَانٍ, مُصَارِعَة ثِيرانٍ (مَن يقوم بالمُصارعة؛ محترف المُصارعة)",
 "闘犬": "قِتَال الكِلَاب (قتال عنيف بين الكلاب (ينظم أحياناً بشكل غير قانوني للترفيه والمقامرة)) / اشتباك جوي, معركة جوية قريبة (اشتباك جوي بين الطائرات المقاتلة) / تَشَابُك بِالأَيْدِي, عِرَاك (قتال غير منظم) / صراع عنيف, قتال شرس (منافسة متنازع عليها بضراوة)\nمثال: ضغينة تعود لقتال سياسي شرس بينهما",
 "闘球": "رَغْبِي, رَجْبِي",
 "闘諍": "عَارَكَ, قَاتَلَ / تَعَارَكَ, تَقَاتَلَ / نَاضَلَ, كَافَحَ / قِتَال (من قَتَلَ: كثير القَتْل) / مَعْرَكَة\nمثال: لن يحل القتال أي شيء.",
 "闘鶏": "مصارعة الديوك",
 "闡明": "تَوْضِيح",
 "闥": "بَوَّابَة",
 "阜": "بيشر, رامي (مركز في فريق البيسبول للاعب الذي يرمي الكرة للضارب ليحاول ضربها) / تل, رابية (هيكل يتكون من كومة صناعية أو ركام عادة من التراب أو الحجارة) / تل الرامي ((بيسبول) الارتفاع الطفيف الذي يقف عليه الرامي) / ركام, كدس (مجموعة من الأشياء مكدسة فوق بعضها البعض)\nمثال: لعب في كل مركز باستثناء الرامي",
 "阡": "أَلْف, ١٠٠٠ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك.",
 "阪": "مُنْحَدَر / مَيْل / حجر الميل, معلم المسافة (عمود حجري بجانب الطريق لإظهار المسافات) / إنجاز مرحلي, حدث بارز (حدث مهم في حياتك (أو في مشروع)) / أُوسَاكَا",
 "阪路": "منحدر (سطح مائل يربط بين مستويين) / سلم الطائرة, منحدر (درج متحرك يستخدمه الركاب للصعود إلى الطائرة أو النزول منها) / رامب, كراث بري (نبات معمر من أمريكا الشمالية له بصلة رفيعة وزهور بيضاء)",
 "防ぎ": "دِفَاع, حِمَايَة / دِفاع",
 "防ぎ止める": "مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "防ぐ": "مَنَعَ (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "防備": "دِفَاع, حِمَايَة / دِفاع",
 "防具": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "防塁": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "防塞": "قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "防壁": "حَاجِز / عَقَبَة, حَاجِز",
 "防寒帽": "قبعة بحرية صوفية (قبعة صوفية زرقاء داكنة محبوكة يرتديها البحارة في الطقس البارد أو العاصف)",
 "防寨": "قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "防弾": "مُضَادّ لِلرَّصَاص, وَاقٍ مِن الرَّصَاص (لا تخترقه الرصاصات) / رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب)",
 "防弾チョッキ": "صَدْرِيَّة ضِدَّ الرَّصَاص, سُتْرَة وَاقِيَة (المنسوبة إلى الصدر، غالبا ما يقصد بالصدر معنى الجزء من جسم الإنسان؛ في : هي المَرْيُول، ثوب يُغطي الجزء الأمامي من الجسم ويُربط من خلف يُرتدى فوق الملابس لحمايتها أثناء الطبخ أو العمل. الجمع صداري)",
 "防弾ベスト": "صَدْرِيَّة ضِدَّ الرَّصَاص, سُتْرَة وَاقِيَة (المنسوبة إلى الصدر، غالبا ما يقصد بالصدر معنى الجزء من جسم الإنسان؛ في : هي المَرْيُول، ثوب يُغطي الجزء الأمامي من الجسم ويُربط من خلف يُرتدى فوق الملابس لحمايتها أثناء الطبخ أو العمل. الجمع صداري)",
 "防御": "دِفَاع, حِمَايَة / دِفاع",
 "防御率": "معدل الركض المكتسب ((بيسبول) مقياس لفعالية الرامي)",
 "防撓材": "دعك, مادة مقوية (مادة تستخدم لتصلب شيء ما) / دعامة تقوية, مقوي (عضو متصل بقلب العارضة لمنع فقدان القوة بسبب انبعاج القلب)",
 "防材": "ذراع التطويل, عوارضة (أي من الصواري أو الأعمدة الأفقية المتنوعة المستخدمة لتمديد أسفل الشراع أو لمناولة البضائع أو في الإرساء) / بوم, ذراع الميكروفون (عمود يحمل ميكروفوناً علوياً مسلطاً فوق موقع تصوير فيلم أو تلفزيون) / دوي, رعد (ضجيج عميق طويل وعالٍ) / رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال))\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "防染糊": "طَارِد, مُقَاوِم (غير قادر على الامتصاص أو الاختلاط) / عَاصٍ, مُقَاوِم (مَيَّالٌ إِلَى تَحَدِّي السُّلْطَةِ القَائِمَةِ أَوْ مُنْخَرِطٌ فِيه) / مُقَاوِم (لا يتأثّر بسهولة؛ محصَّن ضدّ التأثير) / مَنِيع, مُقَاوِم (يتعلق بالمناعة أو يمنحها (ضد المرض أو العدوى))",
 "防止": "مَنْع (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "防止剤": "مانع, مثبط (مادة تؤخر أو توقف نشاطاً ما)",
 "防毒マスク": "قِنَاع غَاز (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "防毒面": "قِنَاع غَاز (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "防水": "عزل الماء (فعل معالجة شيء ما لجعله طاردا للماء) / عزل مائي (طلاء قادر على جعل السطح مقاوماً للماء)",
 "防水シート": "قماش القنب المشمع, مشمع (قماش قنب معالج ليكون مقاوماً للماء)",
 "防水ズボン": "حذاء الخوض, خوّاضة (أحذية طويلة تصل للفخذ مقاومة للماء (تمتد أحياناً إلى الصدر) يرتديها الصيادون)",
 "防水加工": "عزل الماء (فعل معالجة شيء ما لجعله طاردا للماء) / عزل مائي (طلاء قادر على جعل السطح مقاوماً للماء)",
 "防水帆布": "قماش القنب المشمع, مشمع (قماش قنب معالج ليكون مقاوماً للماء)",
 "防水長靴": "حذاء الخوض, خوّاضة (أحذية طويلة تصل للفخذ مقاومة للماء (تمتد أحياناً إلى الصدر) يرتديها الصيادون)",
 "防汚塗料": "طلاء مانع للحشف (طلاء يستخدم للحماية من تراكم البرنقيل وما إلى ذلك على الأسطح المغمورة تحت الماء)",
 "防波堤": "كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ) / حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "防波壁": "كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ)",
 "防浸": "رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب) / مَانِع لِلْمَاء (لا يسمح بمرور الماء دخولاً أو خروجاً)",
 "防湿剤": "عامل تجفيف, مادة مجففة (مادة تعزز الجفاف (مثل أكسيد الكالسيوم الذي يمتص الماء ويستخدم لإزالة الرطوبة))",
 "防潮堤": "كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ)",
 "防火": "إدارة النيران, التحكم في الرمي (التحضير لإيصال القذائف إلى الهدف)",
 "防火塗料": "مُثَبِّط لِلْحَرِيق, مُقَاوِم لِلنَّار (صعب الاحتراق)",
 "防火壁": "جِدَار ناريّ, فَايْرْوُول",
 "防火戸": "باب حريق (باب مقاوم للحريق يمكن إغلاقه لوقف انتشار الحريق)",
 "防火扉": "باب حريق (باب مقاوم للحريق يمكن إغلاقه لوقف انتشار الحريق)",
 "防火線": "خط النار, مانع النار (حقل ضيق تم تنظيفه للحد من انتشار حرائق البراري أو الغابات)",
 "防火訓練": "تدريب إخلاء, مناورة حريق (تمرين يهدف إلى تدريب الناس على الواجبات وإجراءات الهروب الواجب اتباعها في حالة نشوب حريق)",
 "防燃": "مُقَاوِم لِلْحَرِيق (لا تؤثر فيه النار)",
 "防犯": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه) / حِمَايَة / ضَمَانَة, كَفَالَة (وَثِيقَةٌ يَضْمَنُ بِهَا شَخْصٌ شَخْصاً آخَرَ فِي غَرَضٍ مِنْ أَغْرَاضِ البَيْعِ وَقَضَايَا التَّعَامُلِ؛ وَثِيقَةٌ يَضْمَنُ بِهَا ٱلْبَائِعُ سَلاَمَةَ الْمَبِيعِ مِنْ كُلِّ عَيْبٍ وَبَقَاءَهُ صَالِحاً لِلاِسْتِعْمَالِ مُدَّةً مُعَيَّنَةً حَسَبَ…)\nمثال: اتصل زيري بالأمن.",
 "防犯システム": "نظام أمان (جهاز كهربائي يطلق إنذاراً عندما يحاول شخص ما الاقتحام) / نظام أمني ((في الحوسبة) نظام يفرض حدوداً بين شبكات الكمبيوتر)",
 "防犯ベル": "إنذار سرقة (جهاز تحذير ينطلق عند حدوث عملية سطو) / إنذار السرقة (إشارة تحذير عالية يصدرها جهاز إنذار السرقة)\nمثال: كان بإمكانهم سماع إنذار السرقة من مسافة ميل",
 "防空": "الدِّفَاع الجَوِّيّ, دِفَاع جَوِّيّ",
 "防空壕": "مَلْجَأ مِنَ الْقَنَابِل",
 "防空気球": "منطاد حاجز (بالون أو منطاد ممدود ومربوط بحبال أو شبكة تتدلى منه لردع طائرات العدو التي تحلق على ارتفاع منخفض)",
 "防総省": "البنتاغون, وزارة الدفاع (الإدارة الفيدرالية المسؤولة عن حماية الأمن القومي للولايات المتحدة؛ أنشئت عام 1947)",
 "防腐": "تحنيط (حفظ (الجثة) عن طريق المعالجة بالبلسم والأدوية ومواد كيميائية أخرى)",
 "防腐剤": "مُعَقِّمٌ / مَادَّة حَافِظَة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "防臭剤": "مُزِيل اَلْعَرَق, مُزِيل اَلرَّائِحَة",
 "防舷材": "مِصَدّ",
 "防舷物": "مِصَدّ",
 "防菌": "مبيد فطريات, مضاد للفطريات (أي عامل يقضي على الفطريات أو يمنع نموها) / مبيد للفطريات, مضاد للفطريات (قادر على تدمير الفطريات)",
 "防虫剤": "طارد الحشرات (مادة كيميائية تطرد الحشرات)",
 "防虫加工": "مُقَاوِم لِلْعُثّ (مقاوم لأضرار العُثّ)",
 "防虫網": "نَامُوسِيَّة",
 "防衛": "دِفَاع, حِمَايَة / دِفاع",
 "防衛機制": "آلية دفاع, آلية دفاعية ((في الطب النفسي) عملية لاواعية تحاول تقليل القلق المرتبط بالرغبات الغريزية)",
 "防衛機構": "آلية دفاع, آلية دفاعية ((في الطب النفسي) عملية لاواعية تحاول تقليل القلق المرتبط بالرغبات الغريزية)",
 "防衛的": "دفاعي (مخصص أو مناسب للدفاع ضد العدوان أو الهجوم أو لردعه) / تَبْرِيرِيّ, دِفَاعِيّ (يسعى إلى التبرير أو الدفاع قولاً أو كتابةً) / موقف دفاعي (موقف يتسم بالدفاع عن النفس)\nمثال: أسلحة دفاعية",
 "防衛策": "إجراء دفاعي, دفاع (عمل عسكري أو موارد تحمي دولة ضد أعداء محتملين)\nمثال: ماتوا في الدفاع عن ستالينغراد",
 "防衛線": "خط دفاع (هيكل دفاعي يتكون من حاجز يمكن استخدامه للدفاع ضد الهجوم) / خط دفاع (أي منظمة تكون مسؤوليتها الدفاع ضد شيء ما)\nمثال: الشرطة هي خط الدفاع الرئيسي ضد الجريمة",
 "防衛者": "مُدَافِع, مُنَاصِر (هو سيِّد قومِه غير مُدَافَعٍ: لا ينافسه أحد، غير مزاحَم؛ هو مدَفَّعٌ: فقير يَدْفَعُهُ كلُّ أحدٍ عن نفسه) / مُدَافِع (هو سيِّد قومِه غير مُدَافَعٍ: لا ينافسه أحد، غير مزاحَم؛ هو مدَفَّعٌ: فقير يَدْفَعُهُ كلُّ أحدٍ عن نفسه)",
 "防衛計画": "برنامج دفاعي, سياسة دفاعية (برنامج للدفاع عن دولة ضد أعدائها)",
 "防衛軍": "دفاع, قوة دفاع (منظمة من المدافعين توفر المقاومة ضد الهجوم)\nمثال: انضم إلى الدفاع ضد الغزو",
 "防諜": "مكافحة التجسس (أنشطة استخباراتية معنية بتحديد ومواجهة التهديد للأمن الذي تشكله منظمات الاستخبارات المعادية أو الأفراد المنخرطون في التجسس أو التخريب أو التخريب…)",
 "防護": "حِمَايَة",
