 "補正": "تَصْحِيح",
 "補殺": "تمريرة حاسمة, مساعدة ((رياضة) فعل تمكين لاعب آخر من القيام بلعبة جيدة) / إعانة, عون (نشاط المساهمة في تلبية حاجة أو تعزيز جهد أو غرض ما)\nمثال: قدم لي مساعدة في الأعمال المنزلية",
 "補用": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر) / بديل (شخص أو شيء يأخذ أو يمكن أن يأخذ مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر) / خَلَف, خَلِيفَة (الشخص الذي يلي في الترتيب)\nمثال: استبدال النجم لن يكون سهلاً",
 "補筆": "تَصْحِيح",
 "補給": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تَوْرِيد, تَزْوِيد / ذَخِيرَة",
 "補給線": "خط إمداد, طريق إمداد (طريق يمكن من خلاله توصيل الإمدادات)",
 "補給船": "سفينة تموين (سفينة توفر عادة الإمدادات لسفن أخرى)",
 "補給路": "خط إمداد, طريق إمداد (طريق يمكن من خلاله توصيل الإمدادات)",
 "補給食": "مكمل غذائي (شيء يضاف لإكمال النظام الغذائي أو لتعويض نقص غذائي)",
 "補綴": "إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / ملابس للرتق (الملابس التي يجب إصلاحها) / بَدِيل اِصْطِنَاعِيّ, طَرَف اِصْطِنَاعِيّ",
 "補翼": "مُسَاعَدَة",
 "補聴器": "سَمَّاعَةُ أُذُن, مُسَاعَدَات سَمْع",
 "補職": "تسمية, تعيين (فعل وضع شخص في منصب غير انتخابي) / تخصيص, تعيين (فعل توزيع شيء ما على أماكن أو أشخاص معينين) / تكليف, مهمة (واجب تكلف بأدائه (خاصة في القوات المسلحة)) / تكليف, واجب منزلي (مشروع تم تكليفك بالقيام به (كما من قبل مدرب أو معلم))\nمثال: كان يجب الموافقة على التعيين من قبل اللجنة بأكملها",
 "補色": "لون مكمل (أحد لونين لونيين يعطيان عند مزجهما معاً اللون الأبيض (في حالة الأضواء) أو الرمادي (في حالة الأصباغ))\nمثال: الأصفر والأزرق لونان مكملان",
 "補薬": "مُساعِد, مُعَزِّز (يُعَزِّز فِعْل العِلاج الطِّبِّيّ) / إِضَافِيّ, مُسَاعِد (يقدم دعمًا إضافيًا) / عامل مساعد, مادة مساعدة (مادة مضافة تعزز فعالية العلاج الطبي)",
 "補訂": "إعادة كتابة, مراجعة (تحرير يتضمن كتابة الشيء مرة أخرى)",
 "補記": "إضَافَة / مُضَاف / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "補語": "عُمْدَة",
 "補論": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية)",
 "補足": "ملحق / مُكَمِّل",
 "補足的": "تَكْمِيلِيّ, مُكَمِّل (يعمل كمُكمِّل لشيء يُتمِّم الكلّ) / تَكَامُلِيّ ((للكلمات أو القضايا) مترابطة بحيث كل منها نفي للآخر) / لون مكمل (أحد لونين لونيين يعطيان عند مزجهما معاً اللون الأبيض (في حالة الأضواء) أو الرمادي (في حالة الأصباغ))\nمثال: الأصفر والأزرق لونان مكملان",
 "補選": "اِنْتِخَابَات تَكْمِيلِيَّة",
 "補遺": "ملحق / مُكَمِّل",
 "補酵素": "إنزيم مساعد, مرافق إنزيم (جزيء صغير (ليس بروتيناً ولكن أحياناً فيتامين) ضروري لنشاط بعض الإنزيمات)",
 "補酵素Ａ": "مرافق الإنزيم أ (مرافق إنزيم موجود في جميع الخلايا الحية؛ ضروري لعمليات التمثيل الغذائي للكربوهيدرات والدهون وبعض الأحماض الأمينية)",
 "補酵素Ｑ": "يوبيكينون (أي من الكينونات المتعددة الموجودة في الخلايا الحية والتي تعمل كإنزيمات مساعدة تنقل الإلكترونات من جزيء إلى آخر في التنفس الخلوي)",
 "補間": "إقحام, اعتراض (فعل إقحام أو إدراج إجراء أو ملاحظة تقاطع الحديث) / إقحام داخلي, استكمال ((رياضيات) حساب قيمة دالة بين القيم المعروفة بالفعل) / إِدْرَاج, إِضَافَة (رسالة (منطوقة أو مكتوبة) يتم تقديمها أو إدراجها)\nمثال: بمساعدة إضافات صديقه تم سرد قصته في النهاية",
 "補間法": "إقحام, اعتراض (فعل إقحام أو إدراج إجراء أو ملاحظة تقاطع الحديث) / إقحام داخلي, استكمال ((رياضيات) حساب قيمة دالة بين القيم المعروفة بالفعل) / إِدْرَاج, إِضَافَة (رسالة (منطوقة أو مكتوبة) يتم تقديمها أو إدراجها)\nمثال: بمساعدة إضافات صديقه تم سرد قصته في النهاية",
 "補集合": "عُمْدَة",
 "補題": "سُدَّة, لِيمَّا",
 "裡": "فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / مِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: جون في عمر أخي.",
 "裨益": "فَائِدَة, جَدْوَى",
 "裨補": "دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ) / أَيَّدَ, دَعَمَ ((أَيَّدَه): قوّاه بالإياد) / تَأْيِيد, دَعْم\nمثال: ياني هنا لدعم ريمة.",
 "裳脱け": "انسلاخ, طرح الريش (الانسلاخ الدوري للبشرة في المفصليات أو الجلد الخارجي في الزواحف)",
 "裳裾": "ثنية الكم, كُفّة (طية تتكون من حاشية مقلوبة للخلف تطوق نهاية الكم أو الساق) / أصفاد, كلبشات (قيد يتكون من حلقة معدنية يمكن قفلها حول المعصم؛ تستخدم عادة في أزواج)",
 "裸": "انفتاح, شفافية (يتسم بموقف يسهل الوصول إليه (خاصة فيما يتعلق بأفعال المرء أو مقاصده)؛ بدون إخفاء؛ غير كتوم) / عري (حالة عدم وجود ملابس أو غطاء من أي نوع) / عراء, قفار (جو موحش ومقفر)\nمثال: عراء المنظر الطبيعي / خلو من الزينة, عري (نقص شديد في المفروشات أو الزخرفة) / انكشاف, عري (حالة كونه غير مكسو ومكشوفاً (خاصة لجزء من الجسم)) / عراء, قفار (جو موحش ومقفر)\nمثال: لقد أذهلني خلو غرفة أبي من الزينة / انفتاح, تقبل (الاستعداد أو الجاهزية للتلقي (خاصة الانطباعات أو الأفكار)) / اِتِّسَاع, اِنْفِتَاح (الخلو من العوائق أمام المرور أو الرؤية)\nمثال: كان يختبر تقبل الحكومة للإصلاح",
 "裸になる": "تَعَرَّى, اِنْجَرَدَ / تَعَرَّى",
 "裸体": "عُرْي",
 "裸体主義": "عُرْيَانِيَّة, مَذْهَب الْعُرْي",
 "裸体画": "عَارٍ, عُرْيَان",
 "裸像": "عَارٍ, عُرْيَان",
 "裸出": "تعريض (فعل تعريض شخص ما لتجربة مؤثرة) / ترك في العراء, نبذ (التخلي دون مأوى أو حماية (مثل ترك رضيع في العراء)) / إظهار, كشف (العرض للمشاهدة بطريقة علنية أو عامة) / تعريض (فعل تعريض الفيلم للضوء)\nمثال: نددت بتعريض الأطفال للمواد الإباحية",
 "裸出歯鼠": "خُلْد أَمْرَط, خُلْد عَارٍ (الثَبَات المَدِيد والبَقَاء لفترة طويلة؛ دَوَام البَقَاء، يختلف عن السَرْمَد في أن السرمد مختص بالزمان تحديدا والخلد في غير ذلك)\nمثال: خلد ياني إلى النوم.",
 "裸婦画": "عَارٍ, عُرْيَان",
 "裸子植物": "عاريات البذور (نباتات من طائفة عاريات البذور تكون بذورها غير محاطة بمبيض)",
 "裸形": "انفتاح, شفافية (يتسم بموقف يسهل الوصول إليه (خاصة فيما يتعلق بأفعال المرء أو مقاصده)؛ بدون إخفاء؛ غير كتوم) / عري (حالة عدم وجود ملابس أو غطاء من أي نوع) / عراء, قفار (جو موحش ومقفر)\nمثال: عراء المنظر الطبيعي",
 "裸眼": "عَيْن مُجَرَّدَة (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)",
 "裸眼視力": "عَيْن مُجَرَّدَة (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: كان عين ليلى مسودة.",
 "裸虫": "يَرَقَة, دُودَة الْفَرَاشَة",
 "裸蛇": "ضفدع ثعباني (أي من البرمائيات الصغيرة النحيلة عديمة الأطراف الحفارة التي تشبه الديدان؛ تعيش في التربة الرطبة في المناطق الاستوائية) / ضفدعي ثعباني (من أو متعلق بـ أو ينتمي إلى فصيلة الضفادع الثعبانية)",
 "裸裎": "عُرْيَان, عَارٍ",
 "裸足": "حَافٍ, حَافِي (مال أو انحرف عن الشيء؛ سار على حافة الشيء أو حام حوله) / حافي القدمين (حَفِيَ، الذي لا يرتدي حِذَاء أو نَعَال أو غيره من لباس القَدَمَيْن)\nمثال: وقف على حافة الجرف.",
 "裸足で逃げる": "أَجْدَر (أَجْدَرَ النَّبْتُ: جَدَرَ؛ يقال: أَجْدَرَتِ الأَرْضُ) / مُتَفَوِّق / يعلو",
 "裸踊り": "رَقْص تَعَرِيّ, اِسْتْرِبْتِيز (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "裸鰓類": "بزاق البحر, عاريات الخياشيم (أي من بطنيات القدم البحرية المختلفة من رتيبة عاريات الخياشيم التي لها جسم عديم الصدفة وغالباً ما يكون ملوناً بشكل جميل)",
 "製": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟",
 "製する": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟",
 "製作": "صَنَعَ, أَنْتَجَ (عَمِلَ شيئًا يعلم ويُجِيد كيفية عَمَلِه؛ فَعَلَ)\nمثال: صنع لي أبي رفا. / إِنْتَاج",
 "製作所": "أعمال, أفعال (أداء الأعمال الأخلاقية أو الدينية) / مصنع, منشأة صناعية (مباني لممارسة العمل الصناعي) / آلية داخلية (الآلية الداخلية لجهاز ما) / الشلة كلها, العدة والعتاد (كل شيء متاح)\nمثال: الخلاص بالأعمال",
 "製作者": "صَانِع, صَائِغ (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة)\nمثال: أحب أن أكون صانع محتوى. / مُنْتِج",
 "製作費": "تكلفة الإنتاج (التكاليف المجمعة للمواد الخام والعمالة المتكبدة في إنتاج البضائع)",
 "製剤": "تصوّر, صياغة مفاهيمية (ابتكار أو تدبير فكرة أو تفسير وصياغته ذهنيًا) / تعبير, صياغة (أسلوب التعبير عن النفس) / تركيبة, مستحضر (مادة محضرة وفقاً لصيغة محددة)\nمثال: وصف الطبيب مستحضراً تجارياً للدواء",
 "製品": "مُنْتَج / سِلْعَة / حَاصِل (الشيء :حصل عليه) / مَحْصُول / حَاصِل ضَرْب (الشيء :حصل عليه) / جَدَاء",
