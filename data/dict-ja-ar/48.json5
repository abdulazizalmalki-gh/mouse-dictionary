 "靭性": "شدة, صعوبة هائلة (صعوبة مثيرة للإعجاب) / صلابة, متانة (مرونة وصلابة جسم معدني؛ قدرته على امتصاص طاقة كبيرة قبل التشقق) / خشونة, قوة (خاصية كون الشخص كبيراً وقوياً) / جلد, قوة احتمال (قوة وطاقة دائمة)",
 "靭皮": "لحاء ((علم النبات) نسيج يوصل المواد الغذائية المصنعة (مثل من الأوراق) إلى الأجزاء التي تحتاج إليها؛ يتكون أساسًا من الأنابيب الغربالية) / ألياف اللحاء, لحاء (ألياف خشبية قوية يتم الحصول عليها خاصة من اللحاء الداخلي لنباتات مختلفة)",
 "靱": "جَعْبَة",
 "靱帯": "رِبَاط",
 "靱性": "شدة, صعوبة هائلة (صعوبة مثيرة للإعجاب) / صلابة, متانة (مرونة وصلابة جسم معدني؛ قدرته على امتصاص طاقة كبيرة قبل التشقق) / خشونة, قوة (خاصية كون الشخص كبيراً وقوياً) / جلد, قوة احتمال (قوة وطاقة دائمة)",
 "靱皮": "لحاء ((علم النبات) نسيج يوصل المواد الغذائية المصنعة (مثل من الأوراق) إلى الأجزاء التي تحتاج إليها؛ يتكون أساسًا من الأنابيب الغربالية) / ألياف اللحاء, لحاء (ألياف خشبية قوية يتم الحصول عليها خاصة من اللحاء الداخلي لنباتات مختلفة)",
 "靴": "حِذَاء, نَعْل (بمعنى الإزاء والجوار؛ النَعْل)\nمثال: أردت حذاء أحمر.",
 "靴のひも": "شِرَاك, رِبَاط الْحِذَاء",
 "靴の木型": "قالب حذاء (جهاز تثبيت على شكل قدم بشرية يستخدم لتشكيل أو إصلاح الأحذية)",
 "靴の紐": "شِرَاك, رِبَاط الْحِذَاء",
 "靴ひも": "شِرَاك, رِبَاط الْحِذَاء",
 "靴べら": "قَرْن (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "靴みがき": "تلميع الأحذية, مسح الأحذية (فعل تلميع الأحذية) / تلميع أحذية (لمسة نهائية لامعة توضع على الأحذية باستخدام الملمع والمسح)\nمثال: كان يتقاضى دولاراً مقابل تلميع الأحذية",
 "靴クリーム": "ملمع الأحذية (مادة تستخدم لإنتاج سطح واقٍ لامع للأحذية)",
 "靴ベラ": "قَرْن (مصدر للفعل قَرَنَ؛ القوم يعيشون سوية فترة طويلة جذا من الزمن، أو هو الفترة الطويلة من الزمن بدون تحديد عدد السنين)\nمثال: هذه الشجرة عمرها أكثر من قرن.",
 "靴下": "جَوْرَب",
 "靴下止め": "رباط جورب, مشد (شريط (عادة مطاطي) يرتدى حول الساق لتثبيت الجورب (أو حول الذراع لتثبيت الكم))",
 "靴下留": "رباط جورب, مشد (شريط (عادة مطاطي) يرتدى حول الساق لتثبيت الجورب (أو حول الذراع لتثبيت الكم))",
 "靴下留め": "رباط جورب, مشد (شريط (عادة مطاطي) يرتدى حول الساق لتثبيت الجورب (أو حول الذراع لتثبيت الكم))",
 "靴墨": "ملمع الأحذية (مادة تستخدم لإنتاج سطح واقٍ لامع للأحذية)",
 "靴屋": "متجر أحذية, محل أحذية (متجر تباع فيه الأحذية)",
 "靴底": "وَحِيد / عَزْب / أَخْمُص, بَاطِن القَدَم / نَعْل / سَمَك مُوسَى (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "靴拭き": "ممسحة الباب (حصيرة توضع خارج الباب الخارجي لمسح الأحذية قبل الدخول) / ضعيف, واهن (شخص ضعيف جسدياً وغير فعال)",
 "靴磨": "تلميع الأحذية, مسح الأحذية (فعل تلميع الأحذية) / تلميع أحذية (لمسة نهائية لامعة توضع على الأحذية باستخدام الملمع والمسح)\nمثال: كان يتقاضى دولاراً مقابل تلميع الأحذية",
 "靴磨き": "تلميع الأحذية, مسح الأحذية (فعل تلميع الأحذية) / تلميع أحذية (لمسة نهائية لامعة توضع على الأحذية باستخدام الملمع والمسح)\nمثال: كان يتقاضى دولاراً مقابل تلميع الأحذية",
 "靴紐": "شِرَاك, رِبَاط الْحِذَاء",
 "靴脱ぎ石": "حجر أساس, نقطة انطلاق (أي وسيلة للتقدم) / حَجَرُ عُبُور (حجر في مستنقع أو مياه ضحلة يمكن الوقوف عليه للعبور)\nمثال: كانت الوظيفة مجرد نقطة انطلاق في طريقه إلى الشهرة والثراء",
 "靴裏": "وَحِيد / عَزْب / أَخْمُص, بَاطِن القَدَم / نَعْل / سَمَك مُوسَى (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "靴足袋": "جَوْرَب",
 "靴革": "جلد الأحذية (جلد يستخدم لصنع الأحذية)",
 "靴音": "خطوة, موطئ قدم (فعل اتخاذ خطوة في المشي) / خطوة, وقع الأقدام (صوت خطوة شخص يمشي) / خطوة (المسافة التي تغطيها خطوة)\nمثال: سمع وقع أقدام على الشرفة",
 "鞄": "كِيس, چيس",
 "鞄持": "إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل) / تابع, خادم ذكر (خادم ذكر (خاصة تابع)) / حامل أمتعة (حامل (كما خلف مقعد الدراجة) للأمتعة)",
 "鞄持ち": "إِمَّعَة, تابِع ذَلِيل (شخص يطيع دون تساؤل) / تابع, خادم ذكر (خادم ذكر (خاصة تابع)) / حامل أمتعة (حامل (كما خلف مقعد الدراجة) للأمتعة)",
 "鞄語": "لَفْظٌ مَنْحُوت, مَزَاج (نَطَقَ، تَكَلَّمَ؛ أَخْرَجَ، رَمَى)\nمثال: هذه الكلمة صعبة اللفظ.",
 "鞅": "عارضة الدولفين (عارضة تحت الصاري المائل لمركب شراعي) / لجام الصدر, مارتنجال (شريط سرج يربط قطعة الأنف بالحزام البطني؛ يمنع الحصان من رفع رأسه للخلف)",
 "鞅々": "ساخط, غير راضٍ (يظهر أو يمر بعدم الرضا أو الشوق القلق)\nمثال: رأى العديد من الوجوه الساخطة في الغرفة",
 "鞅鞅": "ساخط, غير راضٍ (يظهر أو يمر بعدم الرضا أو الشوق القلق)\nمثال: رأى العديد من الوجوه الساخطة في الغرفة",
 "鞍": "سَرْج, سرج ((سَرَجَ) فلان سرجا: كذب. ويقال سرج فلان الكذب؛ (سَرَجَ)ت المرأة شعرها: ضفرته)",
 "鞍ずれ": "قرحة السرج (قرحة تصيب راكب الخيل بسبب احتكاك السرج) / قرحة السرج (قرحة مفتوحة على ظهر الحصان ناتجة عن سرج غير مناسب أو معدل بشكل سيء)",
 "鞍下": "سيرلوين (جزء من الخاصرة (وخاصة في البقر) يقع أمام الكفل مباشرة)",
 "鞍尻": "حافة السرج الخلفية, قادمة السرج (الجزء الخلفي من مقعد السرج)",
 "鞍擦れ": "قرحة السرج (قرحة تصيب راكب الخيل بسبب احتكاك السرج) / قرحة السرج (قرحة مفتوحة على ظهر الحصان ناتجة عن سرج غير مناسب أو معدل بشكل سيء)",
 "鞍敷": "حلس, دثار السرج (من معدات الإسطبل يتكون من بطانية توضع تحت السرج)",
 "鞍敷き": "حلس, دثار السرج (من معدات الإسطبل يتكون من بطانية توضع تحت السرج)",
 "鞍替え": "دَائِمُ التَّغَيُّر, مُتَغَيِّر (يتميّز بالتغيّر المستمرّ أو الفعل المؤثّر)",
 "鞍褥": "حلس, دثار السرج (من معدات الإسطبل يتكون من بطانية توضع تحت السرج)",
 "鞍部": "فجوة جبلية, ممر (ممر بين قمم الجبال؛ مصطلح جيومورفولوجي لأدنى نقطة على حيد جبلي بين قمتين)",
 "鞍馬": "حصان الحلق (حصان جمباز بجسم أسطواني مغطى بالجلد ومقابض قائمة (حلقات) بالقرب من المركز؛ مثبت بواسطة دعامتين فولاذيتين)",
 "鞏皮症": "تصلب الجلد (مرض مناعي ذاتي يصيب الأوعية الدموية والنسيج الضام)",
 "鞏膜": "مُقْلَة, بَيَاض اَلْعَيْن",
 "鞏膜炎": "التهاب الصلبة (التهاب صلبة العين)",
 "鞐": "إمساك, قبضة (فعل الإمساك) / مشبك (أداة تثبيت (مثل إبزيم أو خطاف) تستخدم لربط شيئين معاً)\nمثال: أرخى قبضته عن ذراعي",
 "鞘": "غِمْد, غِلَاف / قُبَّعَة, قُبَّعة (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس العَمَامَة التي لا يكون فيها خِيَاطَة. قُلُنْسُوَة)\nمثال: لقد اشترى قبعة. / هَامِش / إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حظيرة, مسيَّج (هيكل يتكون من منطقة تم تطويقها لغرض ما) / طية, مرفق (شيء ما (عادة وثيقة داعمة) يتم إرفاقه في ظرف مع رسالة تغطية) / حيز طبيعي مغلق, مكان مغلق (مساحة مغلقة بشكل طبيعي)",
 "鞘取り": "مراجحة (نوع من الاستثمار المحوط يهدف إلى الاستفادة من الفروق الطفيفة في السعر؛ عندما يكون هناك فرق في سعر شيء ما في سوقين مختلفين، يقوم المراجح بالشراء…) / بيت وساطة, شركة وساطة (المكان الذي يدير فيه الوسيط أعماله) / سمسرة, وساطة (عمل السمسار؛ يتقاضى رسوماً لترتيب عقد بين طرفين) / شركة سمسرة, شركة وساطة مالية (أعمال سمسار الأوراق المالية؛ تتقاضى رسوماً للعمل كوسيط بين البائع والمشتري)",
 "鞘翅類": "خُنْفُسَاء",
 "鞠": "ضَرَّة",
 "鞠問": "تَحْقِيق مَعَ, اِسْتِجْوَاب",
 "鞠躬如": "مُبَجِّلٌ, مُوَقِّرٌ (يُظهر التوقير والاحترام)",
 "鞣": "دِبَاغَة",
 "鞣す": "حِنْطِيّ / قَمْحِيُّ اللَّوْن / اِسْمَرَّ / دَبَغَ (عالجه بمادة ليلين وَيَزُول مَا بِهِ من رُطُوبَة ونتن؛ دبغ الْمَطَر الأَرْض بمائه فَهُوَ دابغ ودبوغ وَالْمَفْعُول مدبوغ ودبيغ)",
 "鞦": "ثَفَر, قُوش ((ثَفَّرَ) الدَّابَّة: سَاقهَا من خلفهَا)",
 "鞫問": "تَحْقِيق مَعَ, اِسْتِجْوَاب",
 "鞭": "سَوْط / كِرْبَاج / كُرْبَاج / جَلَدَ بِسَوْط, سَاطَ (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد. / غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط. / تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "鞭ち": "جلد, سوط (الضرب بسوط أو حزام أو حبل كشكل من أشكال العقاب) / ضَرْب, هَزِيمَة (فعل التغلب أو التفوق) / أَنِيق, لَبِق (ذكيّ وأنيق في المظهر والأسلوب) / غرزة السوط, غرزة ملفقة (غرزة خياطة تمر فوق الحافة بشكل قطري) / جلد, ضرب بالسوط (ضربة سريعة توجه بسوط أو أداة تشبه السوط) / إصابة السوط, إصابة المصع (إصابة في الرقبة (الفقرات العنقية) ناتجة عن التسارع أو التباطؤ السريع (كما في حوادث السيارات))\nمثال: أحدث السوط علامة حمراء",
 "鞭をくれる": "سَوْط / كِرْبَاج / كُرْبَاج / جَلَدَ بِسَوْط, سَاطَ (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد. / شَجَّعَ (حفَّز شخصًا أو دعمه لتحقيق هدف أو القيام بعمل؛ بثَّ الحماس أو الثقة في نفس شخص)\nمثال: شجع سامي ليلى لتفعل ذلك.",
 "鞭入れ": "جلد, سوط (الضرب بسوط أو حزام أو حبل كشكل من أشكال العقاب) / ضَرْب, هَزِيمَة (فعل التغلب أو التفوق) / أَنِيق, لَبِق (ذكيّ وأنيق في المظهر والأسلوب) / غرزة السوط, غرزة ملفقة (غرزة خياطة تمر فوق الحافة بشكل قطري)",
 "鞭打": "جلد, سوط (الضرب بسوط أو حزام أو حبل كشكل من أشكال العقاب) / ضَرْب, هَزِيمَة (فعل التغلب أو التفوق) / أَنِيق, لَبِق (ذكيّ وأنيق في المظهر والأسلوب) / غرزة السوط, غرزة ملفقة (غرزة خياطة تمر فوق الحافة بشكل قطري)",
 "鞭打ち": "جلد, سوط (الضرب بسوط أو حزام أو حبل كشكل من أشكال العقاب) / ضَرْب, هَزِيمَة (فعل التغلب أو التفوق) / أَنِيق, لَبِق (ذكيّ وأنيق في المظهر والأسلوب) / غرزة السوط, غرزة ملفقة (غرزة خياطة تمر فوق الحافة بشكل قطري) / جلد, ضرب بالسوط (ضربة سريعة توجه بسوط أو أداة تشبه السوط) / إصابة السوط, إصابة المصع (إصابة في الرقبة (الفقرات العنقية) ناتجة عن التسارع أو التباطؤ السريع (كما في حوادث السيارات))\nمثال: أحدث السوط علامة حمراء",
 "鞭打ち症": "جلد, ضرب بالسوط (ضربة سريعة توجه بسوط أو أداة تشبه السوط) / إصابة السوط, إصابة المصع (إصابة في الرقبة (الفقرات العنقية) ناتجة عن التسارع أو التباطؤ السريع (كما في حوادث السيارات))\nمثال: أحدث السوط علامة حمراء",
 "鞭打つ": "سَوْط / كِرْبَاج / كُرْبَاج / جَلَدَ بِسَوْط, سَاطَ (ضَرَبَ بشدّة بعصا أو سوط أو نحوهما؛ تَحَمَّلَ المصاعب بصبر وشدّة)\nمثال: هذا حزام من الجلد.",
 "鞭撻": "تشجيع, دعم (فعل إعطاء الأمل أو الدعم لشخص ما) / تشجيع (التعبير عن الموافقة والدعم) / تشجيع (الشعور بالتشجيع)",
 "鞭毛": "سَوْط",
 "鞭毛虫": "أوالي سوطية, سوطيات (أوالي حر المعيشة عادة لا يقوم بالتمثيل الضوئي وله زوائد تشبه السوط؛ بعضها ممرض للبشر والحيوانات الأخرى) / سوطي (له سوط أو يشبهه)",
 "鞭毛虫類": "أوالي سوطية, سوطيات (أوالي حر المعيشة عادة لا يقوم بالتمثيل الضوئي وله زوائد تشبه السوط؛ بعضها ممرض للبشر والحيوانات الأخرى) / سوطي (له سوط أو يشبهه)",
 "鞴": "مِنْفَاخ",
 "鞺鞳": "ضَرْب (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / استعجال, اندفاع (فعل التحرك بعجلة وبطريقة غير مبالية) / اندفاع, هجوم ((كرة القدم الأمريكية) محاولة لتقديم الكرة عن طريق الركض في الخط)\nمثال: في عجلته للمغادرة نسي كتابه",
 "韓": "الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم. / جُمْهُورِيَة كُورِيَا / أُسْرَة هَان / هَان, قَوْمِيَّة اَلْهَان",
 "韓半島": "شِبْه الْجَزِيرَةِ الْكُورِيَّة",
 "韓国": "كُورِيَا الْجَنُوبِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا. / الصِّين (دولة في شرق آسيا؛ اسمها الرسمي جُمْهُورِيَّة الصِّين الشَّعْبِيَّة، وعاصمتها بِكِّين) / صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: الصين بلد عظيم.",
 "韓国のり": "كِيم",
 "韓国海苔": "كِيم",
 "韓国街": "كوريا تاون, كورياتاون (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "韓国語": "كُورِيّ",
 "韓紅": "قِرْمِز (القِرْمِزُ: صِبْغ أرمني أَحمر يقال إِنه من عُصارة دود يكون في آجامهم (في الصخور)، فارسي معرب؛ صبغ لونه احمر قانٍ يصنع من حشرة القرمز الجافة والمسحوقة) / قِرْمِزِيّ",
 "韓語": "صِينِيّ / كُورِيّ",
 "韛": "مِنْفَاخ",
 "韜晦": "انزواء, تواري (الانسحاب إلى الخلفية؛ جعل النفس غير ملحوظة)",
 "韜略": "إِسْتْرَاتِيجِيَّة (الإستراتيجية فن وعلم وضع خُطط الحرب وإدارة العمليَّات الحربيَّة: إستراتيجيَّة القوَّات المسلَّحة؛ خُطَّة شاملة في أي مجال من المجالات: وضعت الحكومة إستراتيجيَّة مستقبليَّة للنهوض بالاقتصاد القوميّ)\nمثال: ستحمي روسيا مصالحها الإستراتيجية كما تفعل الولايات المتحدة.",
