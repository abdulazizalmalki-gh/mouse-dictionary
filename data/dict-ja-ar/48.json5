 "血のり": "ينطح / بَنِيقَة",
 "血の出るよう": "مُجْتَهِد, وَرِع فِي عَمَلِه (يَتَّسِم بِعِنَايَة فَائِقَة وجُهْدٍ كَبِير)",
 "血の巡り": "اعتقال, قبض (فعل القبض (خاصة القبض على مجرم)) / إدراك, استيعاب (الحالة المعرفية لشخص يفهم) / تخوف, توجس (توقع مؤلم أو شعور بالقلق من المستقبل) / توجس, خشية (توقع أو تحسب خائف)\nمثال: حصل الشرطي المناوب على التقدير للقبض على المجرم",
 "血の巡りが悪い": "بَسِيط, سَاذَج (يفتقر إلى القدرة العقلية والفطنة)",
 "血の巡りの悪い": "بَسِيط, سَاذَج (يفتقر إلى القدرة العقلية والفطنة)",
 "血の気": "دَم, دم (فِي وَ: سائل أحمر في جسم الكائنات الحية يقوم بنقل المواد الغذائية والأكسجين إلى الخلايا والفضلات وثاني أكسيد الكربون منها)\nمثال: تبرع توم بالدم.",
 "血の気がない": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "血の気が多い": "حَمِيّ الطَّبْع, مُتَّقِدُ المَشَاعِر (ميّال إلى الانفعال والعاطفة الشديدة)",
 "血の気が無い": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "血の気のない": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "血の気の多い": "حَمِيّ الطَّبْع, مُتَّقِدُ المَشَاعِر (ميّال إلى الانفعال والعاطفة الشديدة)",
 "血の気の無い": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "血の滲むよう": "مُجْتَهِد, وَرِع فِي عَمَلِه (يَتَّسِم بِعِنَايَة فَائِقَة وجُهْدٍ كَبِير)",
 "血の繋がった": "مُتَعَلَّق",
 "血の通った": "بَشَرِيّ, إنْسَانِيّ / آدْمِيّ, بَشَرِيّ / إِنْسَان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / نَاس (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / إِنْس / إنسان (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / بنيآدم\nمثال: أنا إنسان صادق.",
 "血の道": "وِعَاء دَمَوِيّ (الوِعَاءُ : الظَّرْفُ يوعَى فيه الشيءُ، ما يُجْمَعُ فيه الشّيءُ ويُحْفظ؛ الوِعَاءُ : إناء منزليّ يُصنع من الخزف أو المعدن أو الزُّجاج كوعاء الطَّبخ الذي له يد وغطاء أو وعاء دائريّ لتقديم الطَّعام أو إناء حفظ القهوة والشَّاي)\nمثال: وعاء السکر فارغ.",
 "血の雨": "سَفْك الدَّم, إِرَاقَةُ الدَّم (أَسَاءَ، سَكَبَ الدم أو السائل؛ سَفَكَ الدم: أراقه وأهدره) / سَفَكَ الدَّمَ (أَسَاءَ، سَكَبَ الدم أو السائل؛ سَفَكَ الدم: أراقه وأهدره)",
 "血は争えない": "الْوَلَدُ سُرّ أَبِيهِ",
 "血まなこ": "نوبة جنون, هياج (حالة من الهياج العقلي العنيف)",
 "血まみれ": "مُلَطَّخ بِالدِّمَاء (مغطى بالدم)",
 "血みどろ": "مُدَمَّى, مُخَضَّب بِالدِّمَاء / دَامِي / يَائِس, قَانِط / مَيْئُوس مِنْهُ",
 "血も涙もない": "بَارِد الدَّم, عَدِيم الرَّحْمَة (بلا وخز ضمير أو إحساس إنساني) / ذوات الدم البارد (لديه دم بارد (في الحيوانات التي لا يتم تنظيم درجة حرارة جسمها داخليًا))",
 "血も涙も無い": "بَارِد الدَّم, عَدِيم الرَّحْمَة (بلا وخز ضمير أو إحساس إنساني) / ذوات الدم البارد (لديه دم بارد (في الحيوانات التي لا يتم تنظيم درجة حرارة جسمها داخليًا))",
 "血を流す": "سَفَكَ الدَّمَ (أَسَاءَ، سَكَبَ الدم أو السائل؛ سَفَكَ الدم: أراقه وأهدره)",
 "血友病": "ناعور, هيموفيليا (ميل خلقي لنزيف غير منضبط)",
 "血友病患者": "مَرِيض بِالنَّاعُور, هِيمُوفِيلِيّ (شخص مصاب بمرض الهيموفيليا (الناعور) وعرضة لنزيف لا يمكن السيطرة عليه)",
 "血吸い蝙蝠": "خفاش مصاص الدماء (أي من خفافيش أمريكية استوائية متنوعة تعض الثدييات والطيور لتتغذى على دمائها)",
 "血吸蝙蝠": "خفاش مصاص الدماء (أي من خفافيش أمريكية استوائية متنوعة تعض الثدييات والطيور لتتغذى على دمائها)",
 "血圧": "ضَغْط اَلدَّمّ\nمثال: 血圧を計りましょう。 — اسمح لي أن أقيس ضغط دمك.",
 "血圧計": "مقياس ضغط الدم (مقياس ضغط لقياس ضغط الدم)",
 "血塊": "خُثْرَة, جُلْطَة",
 "血塗られた": "مُدَمَّى, مُخَضَّب بِالدِّمَاء / دَامِي",
 "血塗る": "قَتَلَ, قتل (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر) / قَتْلَة\nمثال: قتل الصياد دبا.",
 "血塗れ": "مُلَطَّخ بِالدِّمَاء (مغطى بالدم)",
 "血小板": "صَفِيحَةُ دَمٍ",
 "血小板凝集": "صفيحة دموية (قطع صغيرة من البروتوبلازم توجد في دم الفقاريات؛ ضرورية لتخثر الدم)",
 "血小板減少": "نقص الصفائح الدموية (مرض دموي يتميز بعدد قليل بشكل غير طبيعي من الصفائح الدموية في الدم)",
 "血小板減少症": "نقص الصفائح الدموية (مرض دموي يتميز بعدد قليل بشكل غير طبيعي من الصفائح الدموية في الدم)",
 "血小板無力症": "وهن الصفيحات (مرض وراثي جسمي متنحٍ نادر لا تنتج فيه الصفائح الدموية جلطات بالطريقة الطبيعية مما يؤدي إلى النزيف)",
 "血尿": "هِيمَاتُورِيَا",
 "血尿症": "هِيمَاتُورِيَا",
 "血族": "ذو رحم, قريب بالدم (شخص يرتبط بآخر عن طريق الدم أو الأصل؛ خاصة من يشترك في سلف مع آخر)",
 "血族関係": "قَرَابَة عَصَب, قَرَابَة دَم",
 "血染め": "مُلَطَّخ بِالدِّمَاء (مغطى بالدم)",
 "血栓": "خُثْرَة, جُلْطَة",
 "血栓塞栓症": "انصمام خثاري (انسداد وعاء دموي بصمة انفصلت عن خثرة)",
 "血栓溶解": "إذابة الجلطة (عملية تفتيت وإذابة جلطات الدم)",
 "血栓症": "خُثار",
 "血止": "مُرْقِئ, مُوقِف لِلنَّزِيف (يميل إلى وقف النزيف عبر تقليص الأنسجة أو الأوعية الدموية) / دواء قابض, مادة قابضة (دواء يسبب انكماش أنسجة وقنوات الجسم)",
 "血止め": "مُرْقِئ, مُوقِف لِلنَّزِيف (يميل إلى وقف النزيف عبر تقليص الأنسجة أو الأوعية الدموية) / دواء قابض, مادة قابضة (دواء يسبب انكماش أنسجة وقنوات الجسم)",
 "血気": "حيوية, طاقة (أسلوب حيوي خيالي (خاصة أسلوب الكتابة)) / حيوية, نشاط (قوة نشطة للجسد أو العقل) / حيوية, طاقة (بذل قوي للجهد)\nمثال: تنقل كتابته طاقة كبيرة",
 "血気盛ん": "شَغُوف, مُتَحَمِّس",
 "血汐": "اتقاد, حرارة (مشاعر الدفء والحدة الكبيرة) / شغف, وله (شعور مكثف بالحب) / اتقاد, اندفاع (شعور بتوق قوي (عادة لصالح شخص أو قضية))\nمثال: تحدث بحماسة كبيرة",
 "血流": "مجرى الدم (اسم مكان من جَرَى؛ موضع الجريان؛ مجرى الأمر أو الشيء: طريقة جريانها)\nمثال: القناة الكبرى هي المجرى المائي الرئيسي لمدينة البندقية.",
 "血流量": "تدفق الدم",
 "血浴": "مَذْبَحَة, حَمَّام دَمّ (الحَادِثَة أو المَعْرَكَة التي يقتل فيها ناس كثيرون)",
 "血液": "دَم, دم (فِي وَ: سائل أحمر في جسم الكائنات الحية يقوم بنقل المواد الغذائية والأكسجين إلى الخلايا والفضلات وثاني أكسيد الكربون منها)\nمثال: تبرع توم بالدم.",
 "血液中の糖": "جلوكوز الدم, سكر الدم (الجلوكوز الموجود في مجرى الدم)",
 "血液内科": "عِلْم الدَّمْ (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "血液凝固": "تجلط الدم, تخثر الدم (عملية يتحول فيها الدم السائل إلى كتلة شبه صلبة (جلطة دموية))",
 "血液凝固因子": "تجلط الدم, تخثر الدم (عملية يتحول فيها الدم السائل إلى كتلة شبه صلبة (جلطة دموية))",
 "血液型": "فَصِيلَةُ دَم (ولد الناقة أو البقرة بعد أن يفصل عن أمه، الجمع فِصال وفصلان؛ فصيلة الرجل: المقرّبون إليه من عشيرته) / فِئَةُ دَم (هي الجماعة المُتَظَاهِرَة التي يرجع بعضها إلى بعض في التعاضد؛ هي الطائفة المقيمة وراء الجيش للاتجاء إليهم عند الهزيمة) / فَصِيلَةٌ دَمَوِيَّة (ولد الناقة أو البقرة بعد أن يفصل عن أمه، الجمع فِصال وفصلان؛ فصيلة الرجل: المقرّبون إليه من عشيرته)\nمثال: يريد سامي أن يبيع كلبه من فصيلة الشيبا إينو.",
 "血液型不適合": "فَصِيلَةُ دَم (ولد الناقة أو البقرة بعد أن يفصل عن أمه، الجمع فِصال وفصلان؛ فصيلة الرجل: المقرّبون إليه من عشيرته) / فِئَةُ دَم (هي الجماعة المُتَظَاهِرَة التي يرجع بعضها إلى بعض في التعاضد؛ هي الطائفة المقيمة وراء الجيش للاتجاء إليهم عند الهزيمة) / فَصِيلَةٌ دَمَوِيَّة (ولد الناقة أو البقرة بعد أن يفصل عن أمه، الجمع فِصال وفصلان؛ فصيلة الرجل: المقرّبون إليه من عشيرته)\nمثال: يريد سامي أن يبيع كلبه من فصيلة الشيبا إينو.",
 "血液学": "أمراض الدم (فرع الطب الذي يتعامل مع أمراض الدم والأعضاء المكونة للدم)",
 "血液学会": "رَمَاد, سَكَن / دَرْدَار",
 "血液検査": "تَحْلِيل الدَّمّ",
 "血液脳関門": "الحَاجِزُ الدَّمَوِيُّ الدِّمَاغِيّ (آلية تخلق حاجزاً بين أنسجة الدماغ والدم المتداول؛ تعمل على حماية الجهاز العصبي المركزي)\nمثال: تمت حماية الدماغ من الجزيئات الكبيرة للفيروس بواسطة الحاجز الدموي الدماغي",
 "血液透析": "غسيل الكلى الدموي (غسيل الدم لإزالة المواد السامة أو النفايات الأيضية من مجرى الدم؛ يستخدم في حالة الفشل الكلوي)",
 "血液銀行": "بنك الدم (مكان لتخزين الدم الكامل أو بلازما الدم)\nمثال: أنشأ الصليب الأحمر بنك دم للطوارئ",
 "血清": "مَصْل دَم / مَصْل",
 "血清アルブミン": "ألبومين المصل (ألبومين يوجد في مصل الدم؛ يعمل على الحفاظ على الضغط التناضحي للدم)",
 "血清学": "علم الأمصال (فرع العلوم الطبية الذي يتعامل مع الأمصال؛ وخاصة أمصال الدم والمرض)",
 "血清病": "داء المصل (رد فعل تحسسي متأخر لحقن مصل مضاد ناتج عن تفاعل الأجسام المضادة مع مولد الضد في مصل المتبرع)",
 "血清肝炎": "التهاب الكبد المصلي, التهاب الكبد ب",
 "血温": "درجة حرارة الجسم (درجة حرارة الجسم؛ عادة 37 درجة مئوية في البشر)",
 "血漿": "بِلَزْمَا / مُصَوِّرَة, بِلَزْمَا الدّم",
 "血漿瀉血": "فصادة البلازما (يتم فصل البلازما عن الدم الكامل وإعادة الباقي إلى المتبرع)",
 "血潮": "اتقاد, حرارة (مشاعر الدفء والحدة الكبيرة) / شغف, وله (شعور مكثف بالحب) / اتقاد, اندفاع (شعور بتوق قوي (عادة لصالح شخص أو قضية))\nمثال: تحدث بحماسة كبيرة",
 "血玉髄": "حجر الدم, هيليوتروب (كالسيدوني أخضر مع بقع حمراء تشبه الدم)",
 "血球": "خَلِيَّة دَم, خَلِيَّة دَمَوِيَّة",
 "血生臭い": "مُدَمَّى, مُخَضَّب بِالدِّمَاء / دَامِي",
 "血痕": "بقعة دم (تغير في اللون ناتج عن الدم)",
 "血瘤": "قيلة دموية (تورم ناتج عن تجمع الدم في تجويف الجسم (وخاصة تورم الغشاء الذي يغطي الخصية))",
 "血目": "نوبة جنون, هياج (حالة من الهياج العقلي العنيف)",
 "血相": "تَعْبِير / تَعْبِير, عِبَارَة / سِيمَاء",
 "血眼": "نوبة جنون, هياج (حالة من الهياج العقلي العنيف)",
 "血石": "حجر الدم, هيليوتروب (كالسيدوني أخضر مع بقع حمراء تشبه الدم)",
 "血祭り": "مَذْبَحَة, حَمَّام دَمّ (الحَادِثَة أو المَعْرَكَة التي يقتل فيها ناس كثيرون) / حَيْض, طَمْث (الحَيْضُ : الدورة التي ينزل فيها الدم من رَحِم المرأة البالغة في أَيَّامٍ معلومةٍ كلَّ شهر؛ أعراض ما قبل الحيض (في ): أعراض تشمل انتفاخ البطن وألم الصدر والصداع والشعور بالتّعب وحدَّة الطبع والتهيّج العصبيّ والاكتئاب…)",
 "血祭りにあげる": "عَذَاب / عَذَّبَ",
 "血祭りに上げる": "عَذَاب / عَذَّبَ",
 "血税": "تَجْنِيد إِجْبَارِيّ",
 "血筋": "أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم) / أصل, سلالة (الاشتقاق الوراثي للفرد) / أجرة الكتابة, سعر السطر (معدل الدفع للمواد المكتوبة التي تقاس وفقاً لعدد الأسطر المقدمة) / عَدَد الأَسْطُر (عدد الأسطر في مادة مطبوعة)\nمثال: كل سلالته كانت محاربين",
 "血管": "وِعَاء دَمَوِيّ (الوِعَاءُ : الظَّرْفُ يوعَى فيه الشيءُ، ما يُجْمَعُ فيه الشّيءُ ويُحْفظ؛ الوِعَاءُ : إناء منزليّ يُصنع من الخزف أو المعدن أو الزُّجاج كوعاء الطَّبخ الذي له يد وغطاء أو وعاء دائريّ لتقديم الطَّعام أو إناء حفظ القهوة والشَّاي)\nمثال: وعاء السکر فارغ.",
 "血管内皮": "بِطَانَة",
 "血管収縮薬": "رافع للضغط, مُقَبِّض للأوعية (أي عامل يسبب تضييق فتحة الأوعية الدموية مما يرفع ضغط الدم أو يحافظ عليه؛ مثل البرد أو النيكوتين أو الإبينفرين)",
 "血管形成": "تكون الأوعية الدموية (تكوين أوعية دموية جديدة) / رأب الوعاء (عملية لإصلاح وعاء دموي تالف أو فتح شريان تاجي مسدود)",
 "血管形成術": "رأب الوعاء (عملية لإصلاح وعاء دموي تالف أو فتح شريان تاجي مسدود)",
 "血管性浮腫": "وذمة وعائية (مناطق محددة كبيرة متكررة من وذمة تحت الجلد؛ تبدأ فجأة وتختفي خلال 24 ساعة؛ تظهر بشكل رئيسي عند الشابات، غالباً كرد فعل تحسسي للطعام أو الأدوية)",
 "血管拡張": "توسع الأوعية (توسع الأوعية الدموية (خاصة الشرايين))",
 "血管拡張薬": "موسع للأوعية الدموية (عقار يسبب توسع الأوعية الدموية)",
 "血管新生": "تكون الأوعية الدموية (تكوين أوعية دموية جديدة)",
 "血管浮腫": "وذمة وعائية (مناطق محددة كبيرة متكررة من وذمة تحت الجلد؛ تبدأ فجأة وتختفي خلال 24 ساعة؛ تظهر بشكل رئيسي عند الشابات، غالباً كرد فعل تحسسي للطعام أو الأدوية)",
 "血管炎": "التهاب الأوعية الدموية (التهاب وعاء دموي)",
 "血管系": "الجهاز الوعائي (الأوعية والأنسجة التي تحمل أو تدور السوائل مثل الدم أو الليمف أو النسغ عبر جسم الحيوان أو النبات)",
 "血管肉腫": "ساركومة وعائية (ورم خبيث نادر ينشأ من الأنسجة الوعائية؛ يحدث عادة في الثدي والجلد ويُعتقد أنه ينشأ من الخلايا البطانية للأوعية الدموية)",
 "血管腫": "ورم وعائي (ورم يتكون من كتلة من الأوعية الدموية أو الليمفاوية)",
 "血管造影": "تصوير الأوعية (فحص بالأشعة السينية للأوعية الدموية بعد حقن وسيط تباين غير شفاف للأشعة)",
 "血管造影法": "تصوير الأوعية (فحص بالأشعة السينية للأوعية الدموية بعد حقن وسيط تباين غير شفاف للأشعة)",
 "血糊": "ينطح / بَنِيقَة",
 "血糖": "جلوكوز الدم, سكر الدم (الجلوكوز الموجود في مجرى الدم)",
 "血糖値": "جلوكوز الدم, سكر الدم (الجلوكوز الموجود في مجرى الدم)",
 "血糖値スパイク": "جلوكوز الدم, سكر الدم (الجلوكوز الموجود في مجرى الدم)",
 "血糖値測定器": "جلوكوز الدم, سكر الدم (الجلوكوز الموجود في مجرى الدم)",
 "血糖自己測定": "جلوكوز الدم, سكر الدم (الجلوكوز الموجود في مجرى الدم)",
 "血紅素": "خضاب الدم, هيموغلوبين (بروتين هيمي يتكون من الغلوبين والهيم ويعطي خلايا الدم الحمراء لونها المميز؛ وظيفته الأساسية نقل الأكسجين من الرئتين إلى أنسجة الجسم)\nمثال: الأسماك لديها هيموغلوبين أبسط من الثدييات",
 "血紅色": "أَحْمَر الوَجْه, مُحْمَرّ (ذو بَشَرَة حَمْراء مُشْرِقَة تَدُلّ عَلى صِحَّة جَيِّدَة) / دَمَوِيّ, مُتَفَائِل بِثِقَة (متفائل بثقة ومرح) / أحمر دموي, أحمر قانٍ (لون أحمر مثل الدم) / سانغوين, طباشير أحمر (طباشير بلون بني محمر يشبه الدم الجاف)",
 "血統": "أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم) / أصل, سلالة (الاشتقاق الوراثي للفرد) / أجرة الكتابة, سعر السطر (معدل الدفع للمواد المكتوبة التي تقاس وفقاً لعدد الأسطر المقدمة) / عَدَد الأَسْطُر (عدد الأسطر في مادة مطبوعة)\nمثال: كل سلالته كانت محاربين",
 "血統主義": "حق الدم (المبدأ القائل بأن جنسية الشخص عند الولادة هي نفس جنسية والديه الطبيعيين)",
 "血続き": "صِلَة الدَّم الوَاحِد",
 "血縁": "قَرَابَة عَصَب, قَرَابَة دَم / ذو رحم, قريب بالدم (شخص يرتبط بآخر عن طريق الدم أو الأصل؛ خاصة من يشترك في سلف مع آخر)",
 "血縁者": "ذو رحم, قريب بالدم (شخص يرتبط بآخر عن طريق الدم أو الأصل؛ خاصة من يشترك في سلف مع آخر)",
 "血縁関係": "صِلَة الدَّم الوَاحِد",
 "血縁集団": "عشيرة, قبيلة (مجموعة من الناس يرتبطون بالدم أو الزواج)",
 "血肉": "ذو رحم, قريب بالدم (شخص يرتبط بآخر عن طريق الدم أو الأصل؛ خاصة من يشترك في سلف مع آخر) / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "血肉化": "إدماج, دمج (التضمين عن طريق الدمج) / تأسيس, دمج (دمج شيئين أو أكثر؛ الاتحاد في (أو ضمن) هيئة واحدة) / استدماج, تذويت (التعلم (للقيم أو المواقف وما إلى ذلك) الذي يتم دمجها داخل الذات)",
 "血胤": "أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم) / أصل, سلالة (الاشتقاق الوراثي للفرد) / أجرة الكتابة, سعر السطر (معدل الدفع للمواد المكتوبة التي تقاس وفقاً لعدد الأسطر المقدمة) / عَدَد الأَسْطُر (عدد الأسطر في مادة مطبوعة)\nمثال: كل سلالته كانت محاربين",
 "血胸": "تدمي الصدر (تراكم الدم في التجويف الجنبي (الفراغ بين الرئتين وجدران الصدر))",
 "血脈": "وِعَاء دَمَوِيّ (الوِعَاءُ : الظَّرْفُ يوعَى فيه الشيءُ، ما يُجْمَعُ فيه الشّيءُ ويُحْفظ؛ الوِعَاءُ : إناء منزليّ يُصنع من الخزف أو المعدن أو الزُّجاج كوعاء الطَّبخ الذي له يد وغطاء أو وعاء دائريّ لتقديم الطَّعام أو إناء حفظ القهوة والشَّاي)\nمثال: وعاء السکر فارغ.",
 "血腥い": "مُدَمَّى, مُخَضَّب بِالدِّمَاء / دَامِي",
 "血腫": "ورم دموي (تورم موضعي مملوء بالدم)",
 "血色": "بَشْرَة",
 "血色が悪い": "بَاهِت, شَاحِب / لَوْح / تَخْم, حَدّ",
 "血色素": "خضاب الدم, هيموغلوبين (بروتين هيمي يتكون من الغلوبين والهيم ويعطي خلايا الدم الحمراء لونها المميز؛ وظيفته الأساسية نقل الأكسجين من الرئتين إلى أنسجة الجسم)\nمثال: الأسماك لديها هيموغلوبين أبسط من الثدييات",
 "血色素尿": "بيلة هيموغلوبينية (وجود الهيموغلوبين في البول)",
 "血色素尿症": "بيلة هيموغلوبينية (وجود الهيموغلوبين في البول)",
 "血色素症": "داء ترسب الأصبغة الدموية, زيادة حمل الحديد (حالة مرضية يتراكم فيها الحديد في الأنسجة؛ تتميز بجلد برونزي وتضخم الكبد والسكري وتشوهات في البنكرياس والمفاصل)",
 "血行": "انتشار, تداول (انتشار أو نقل شيء ما (كالأخبار أو المال) إلى مجموعة أو منطقة أوسع) / توزيع, نشر (توزيع نسخ من الدوريات (مثل الصحف أو المجلات)) / دوران, سريان (حركة حرة أو مرور (كما في السيتوبلازم داخل الخلية أو النسغ عبر النبات)) / دوران, دورة دموية (الحركة عبر دائرة؛ وخاصة حركة الدم عبر القلب والأوعية الدموية)\nمثال: دوران المحيط جزء مهم من المناخ العالمي",
 "血行動態": "ديناميكا الدم (فرع علم وظائف الأعضاء الذي يدرس الدورة الدموية والقوى المتضمنة)",
 "血裔": "أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم) / أصل, سلالة (الاشتقاق الوراثي للفرد) / أجرة الكتابة, سعر السطر (معدل الدفع للمواد المكتوبة التي تقاس وفقاً لعدد الأسطر المقدمة) / عَدَد الأَسْطُر (عدد الأسطر في مادة مطبوعة)\nمثال: كل سلالته كانت محاربين",
 "血豆": "فقاعة دموية (بثرة تحتوي على دم أو مصل دموي عادة ما تسببها إصابة)",
 "血路": "مخرج, منفذ (فتحة تسمح بالهروب أو الخروج)\nمثال: أغلق المخرج",
 "血道": "وِعَاء دَمَوِيّ (الوِعَاءُ : الظَّرْفُ يوعَى فيه الشيءُ، ما يُجْمَعُ فيه الشّيءُ ويُحْفظ؛ الوِعَاءُ : إناء منزليّ يُصنع من الخزف أو المعدن أو الزُّجاج كوعاء الطَّبخ الذي له يد وغطاء أو وعاء دائريّ لتقديم الطَّعام أو إناء حفظ القهوة والشَّاي)\nمثال: وعاء السکر فارغ.",
 "血餅": "جلطة, خثرة (كتلة من مادة تشكلت من محتوى سائل)",
 "衆": "الْجَمَاهِير, العَامَّةُ / نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "衆人": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "衆俗": "الْجَمَاهِير, العَامَّةُ",
 "衆参": "مَجْلِس النُّوَّاب, مَجْلِسْ أَدْنٰى",
 "衆口": "حديث, حديث المدينة (ثرثرة فارغة أو شائعة)\nمثال: كان هناك حديث عنك مؤخراً",
 "衆多": "جماهير, جموع (عامة الناس بشكل عام) / جمهور, حشد كبير (تجمع كبير للناس) / جموع, حشد (كمية كبيرة غير محددة)\nمثال: افصل المحاربين عن الجموع",
 "衆庶": "الْجَمَاهِير, العَامَّةُ",
 "衆意": "رَأْي عَامّ",
 "衆愚政治": "حكم الغوغاء (نظام سياسي تكون فيه الغوغاء مصدر السيطرة؛ حكم الجماهير)",
 "衆樹": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "衆生": "بَشَرِيَّة, الْجِنْس الْبَشَرِيّ",
 "衆知": "ذَائِع الصِّيت, مَعْرُوف جَيِّدًا (معروف على نطاق واسع أو بشكل تامّ)",
 "衆評": "رَأْي عَامّ",
 "衆論": "رَأْي عَامّ",
 "衆議": "تَجَمُّع جَمَاهِيرِيّ, مَهْرَجَان خِطَابِيّ (تجمع كبير من الناس يهدف إلى إثارة الحماس)",
 "衆議院": "مَجْلِس النُّوَّاب, مَجْلِسْ أَدْنٰى",
 "衆議院議員総会": "سلطة تشريعية, مشرعون (أشخاص يسنون القوانين أو يعدلونها أو يلغونها) / الجمعية العامة (الجمعية التداولية العليا للأمم المتحدة)",
 "衆議院議員選挙": "مَجْلِس النُّوَّاب, مَجْلِسْ أَدْنٰى",
 "衆議院運営委員会": "مَجْلِس النُّوَّاب, مَجْلِسْ أَدْنٰى",
 "衆議院選挙": "مَجْلِس النُّوَّاب, مَجْلِسْ أَدْنٰى",
 "衆道": "اشتهاء الغلمان, لواط بالأطفال (العلاقات الجنسية بين رجل وصبي (عادة الجماع الشرجي مع الصبي كشريك سلبي))",
 "衆院": "مَجْلِس النُّوَّاب, مَجْلِسْ أَدْنٰى",
 "衆院選": "مَجْلِس النُّوَّاب, مَجْلِسْ أَدْنٰى",
 "行": "خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / ذهاب, رحيل (فعل المغادرة) / تقدم, سير الأمور (التقدم نحو هدف ما) / رحيل, فقدان (تعبيرات ملطفة للموت)\nمثال: كان إقناعه أمراً سهلاً / عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / مَثَّلَ (الشَبَه؛ النَظِير) / تَصَرَّفَ\nمثال: المهم هو العمل. / مَصْرِف, بَنْك (في الاقتصاد: مؤسسة مالية مُرَخصة، تختص بإتمام الخدمات المالية كتلقي عمليات الإيداع، ومنح القروض، وإدارة الثروات، واستبدال العملات) / ضِفَّة\nمثال: عدن إلى المصرف.",
 "行い": "مَأْثُرَة / تصرف, سلوك (طريقة التصرف أو التحكم بالنفس) / تصرف, سلوك ((السمات السلوكية) الطريقة التي يتصرف بها الشخص تجاه الآخرين) / زُهْد (زَهَّدَ (زهده): قلله؛ زَهَّدَ فيه وعنه: جعله يزهد)",
 "行う": "أَدَّى",
 "行かず後家": "أولد ميد, العانس (لعبة ورق تستخدم حزمة أوراق أزيلت منها ملكة واحدة؛ يطابق اللاعبون الأوراق واللاعب الذي يحمل الملكة غير المطابقة في نهاية اللعبة هو الخاسر) / خاسر في لعبة العانس / عانس (امرأة مسنة غير متزوجة) / عناقية, عين البزون (عشب خشبي من العالم القديم يزرع عادة وله أزهار كبيرة وردية إلى حمراء)",
 "行かなくちゃ": "يَجِبُ أَن أَذْهَب, لَا بُدَّ أَن أَذْهَب",
 "行かなくては": "يَجِبُ أَن أَذْهَب, لَا بُدَّ أَن أَذْهَب",
 "行かん": "سَيِّئ, وحش / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "行き": "ذهاب, رحيل (فعل المغادرة) / تقدم, سير الأمور (التقدم نحو هدف ما) / رحيل, فقدان (تعبيرات ملطفة للموت)",
 "行きあし": "زَخَم حَرَكَة (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…) / زَخَم (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…)\nمثال: يمكنك أن تتعلم بنفس الزخم في المكتبة كما في المدرسة.",
 "行きがかり": "أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "行きしな": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "行きずり": "اجتياز, نجاح (النجاح في استيفاء اختبار أو شرط) / تجاوز, تخطي (المرور بجانب شيء متحرك للوصول إلى أمامه) / بدرجة استثنائية, بشكل فائق (بدرجة غير عادية) / تمرير, لعب التمرير ((كرة القدم الأمريكية) لعبة تتضمن قيام لاعب برمي الكرة لزميل في الفريق)\nمثال: كان مستقبله يعتمد على اجتيازه لذلك الاختبار / ذٰلِكَ / سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / عَابِث, لَامُبَالٍ (يَتَّسِمُ بِعَدَمِ الِاكْتِرَاثِ وَالِاسْتِهْتَارِ) / بِلَا جُهْد, يَسِير (لَا يُظْهِر جُهْدًا أَوْ إِجْهَادًا) / عَادِيّ, يَوْمِيّ (مُنَاسِبٌ لِلْمُنَاسَبَاتِ العَادِيَّةِ أَوِ الرُّوتِينِيَّةِ)",
 "行きつく": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر.",
 "行きつけ": "عَادِيّ / مُنْتَظِمٌ",
 "行きどころ": "وِجْهَة, وُجْهَة",
 "行き交い": "مُرُور",
 "行き付け": "عَادِيّ / مُنْتَظِمٌ",
 "行き付ける": "مُتَكَرِّر / اِرْتَادَ (لأهله: ذهب أمامهم رائدًا ليجد النجعة والكلاء؛ المكانَ: كان من روّادِه، أي من الذين كانوا فيه منذ البدء)",
 "行き先": "وِجْهَة, وُجْهَة / مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة / مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل",
 "行き場": "وِجْهَة, وُجْهَة",
 "行き当たりばったり": "عَشْوَائِيّ",
 "行き当たる": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "行き当る": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "行き所": "وِجْهَة, وُجْهَة",
 "行き掛かり": "أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "行き掛り": "أحوال مالية, ظروف مادية (الوضع المالي للشخص (جيداً كان أو سيئاً)) / حظ, قدر (ظروفك العامة أو حالتك في الحياة (بما في ذلك كل ما يحدث لك))\nمثال: وجد نفسه في ظروف مالية صعبة",
 "行き損なう": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "行き摩り": "اجتياز, نجاح (النجاح في استيفاء اختبار أو شرط) / تجاوز, تخطي (المرور بجانب شيء متحرك للوصول إلى أمامه) / بدرجة استثنائية, بشكل فائق (بدرجة غير عادية) / تمرير, لعب التمرير ((كرة القدم الأمريكية) لعبة تتضمن قيام لاعب برمي الكرة لزميل في الفريق)\nمثال: كان مستقبله يعتمد على اجتيازه لذلك الاختبار / ذٰلِكَ / سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / عَابِث, لَامُبَالٍ (يَتَّسِمُ بِعَدَمِ الِاكْتِرَاثِ وَالِاسْتِهْتَارِ) / بِلَا جُهْد, يَسِير (لَا يُظْهِر جُهْدًا أَوْ إِجْهَادًا) / عَادِيّ, يَوْمِيّ (مُنَاسِبٌ لِلْمُنَاسَبَاتِ العَادِيَّةِ أَوِ الرُّوتِينِيَّةِ)",
 "行き摺り": "اجتياز, نجاح (النجاح في استيفاء اختبار أو شرط) / تجاوز, تخطي (المرور بجانب شيء متحرك للوصول إلى أمامه) / بدرجة استثنائية, بشكل فائق (بدرجة غير عادية) / تمرير, لعب التمرير ((كرة القدم الأمريكية) لعبة تتضمن قيام لاعب برمي الكرة لزميل في الفريق)\nمثال: كان مستقبله يعتمد على اجتيازه لذلك الاختبار / ذٰلِكَ / سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / عَابِث, لَامُبَالٍ (يَتَّسِمُ بِعَدَمِ الِاكْتِرَاثِ وَالِاسْتِهْتَارِ) / بِلَا جُهْد, يَسِير (لَا يُظْهِر جُهْدًا أَوْ إِجْهَادًا) / عَادِيّ, يَوْمِيّ (مُنَاسِبٌ لِلْمُنَاسَبَاتِ العَادِيَّةِ أَوِ الرُّوتِينِيَّةِ)",
 "行き方": "طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة",
 "行き来": "طَرِيق, طَرِيق عَامّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "行き止まり": "طَرِيق مَسْدُود, طَرِيق غَيْر نَافِذ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / طَرِيق مَسْدُود (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "行き渡る": "مُبَعْثَر, مُنْتَشِر (مُمْتَدٌّ عَلَى مِسَاحَةٍ وَاسِعَةٍ؛ غَيْرُ مُتَمَرْكِزٍ فِي مَكَانٍ وَاحِدٍ) / فَضْفَاض, مُطَوَّل (يَفْتَقِرُ إِلَى الإِيجَازِ وَالِاخْتِصَارِ) / مشتت, ناعم ((للضوء) ينتقل من مصدر ضوء واسع أو منعكس)",
 "行き着く": "وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر.",
 "行き脚": "زَخَم حَرَكَة (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…) / زَخَم (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…)\nمثال: يمكنك أن تتعلم بنفس الزخم في المكتبة كما في المدرسة.",
 "行き詰まり": "جمود, طريق مسدود (وضع لا يمكن فيه إحراز تقدم أو لا يمكن فيه أي تقدم)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "行き詰り": "جمود, طريق مسدود (وضع لا يمكن فيه إحراز تقدم أو لا يمكن فيه أي تقدم)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "行き足": "زَخَم حَرَكَة (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…) / زَخَم (زخم للشيء إذا كانت رائحته كريهة؛ \"الزَّخَمَة\" تعني الرائحة الكريهة، خصوصاً من الطعام أو اللحم. قد يُستخدم المصطلح لوصف لحوم السباع التي تكون دسمة وخبيثة الرائحة. يُقال \"طعام فيه…)\nمثال: يمكنك أن تتعلم بنفس الزخم في المكتبة كما في المدرسة.",
 "行き路": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "行き道": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "行き違い": "خلاف, صراع (خلاف أو جدال حول أمر مهم)\nمثال: كان لديه نزاع مع زوجته",
 "行き違いになる": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "行き違う": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق. / تَصَادُم / يتصادم",
 "行く": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟ / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق. / جَدْوَل / تَيَّار / تَدَفّقَ",
 "行く先": "وِجْهَة, وُجْهَة / مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة / مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل",
 "行く先々": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "行く先先": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "行く方": "وِجْهَة, وُجْهَة",
 "行く末": "توقع, احتمال / تَنْقِيْب (نقّب إذا سار في البلاد طلباً للمهرب ، نقّب عن الأخبار وغيرها:بحث عنها،هو البحث عن كلّ شيء والتّفتيش مطلقاً؛ نقّب مبالغة في نَقَب ، نقّب عن الشيء :فحص عنه فحصاً بليغاً)",
 "行く行く": "فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / فِي ٱلْمُسْتَقْبَل (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "行けません": "مُخْطِئ / ظَلَمَ (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم. / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه",
 "行け行け": "ابتهاج, زهو (شعور بالفرح والفخر) / صَارِخ, مُبَهْرَج (ذو ألوان صارخة وبرّاقة تجذب الانتباه بشكل مفرط) / صَارِخ, مُبَهْرَج (بَرَّاقٌ وَلَافِتٌ بِطَرِيقَةٍ تَفْتَقِرُ إِلَى الذَّوْق)",
 "行ずる": "أَدَّى",
 "行った": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "行ったりきたり": "ذَهَابًا وَإِيَابًا",
 "行ったり来たり": "ذَهَابًا وَإِيَابًا",
 "行ったり来り": "ذَهَابًا وَإِيَابًا",
 "行っちまえ": "اِبْتَعَدَ",
 "行ってき": "إِلَى اللِّقَاء (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / مَعَ السَّلَامَة (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: تعال إلى منزلي.",
 "行ってきます": "إِلَى اللِّقَاء, أَرَاكَ لَاحِقًا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "行ってくる": "إِلَى اللِّقَاء, أَرَاكَ لَاحِقًا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي. / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "行ってまいります": "إِلَى اللِّقَاء, أَرَاكَ لَاحِقًا (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "行ってら": "تَوَخَّى اَلْحِذْر",
