 "だいりけん": "فَاعِلِيَّة\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "だいりしゃ": "إِنَابَة, اِسْتِنَابَة (عند السالكين: الرجوع عن الغَفْلَة إلى الذِّكْر)",
 "だいりせき": "رُخَام",
 "だいりせんそう": "حَرْب بِالوِكَالَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "だいりたいし": "قائم بالأعمال (المسؤول المسؤول مؤقتاً عن البعثة الدبلوماسية في غياب السفير)",
 "だいりてん": "فَاعِلِيَّة\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "だいりにん": "إِنَابَة, اِسْتِنَابَة (عند السالكين: الرجوع عن الغَفْلَة إلى الذِّكْر)",
 "だいりはは": "أُمّ بَدِيلَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "だいりぼ": "أُمّ بَدِيلَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "だいりぼくし": "نائب كاهن (كاهن كاثوليكي ينوب عن رجل دين آخر أعلى رتبة)",
 "だいりゅうこう": "ذراع التطويل, عوارضة (أي من الصواري أو الأعمدة الأفقية المتنوعة المستخدمة لتمديد أسفل الشراع أو…)\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "だいりょうけいこつ": "عظم مربعي (عظم الرسغ على جانب الإبهام من اليد الذي يتمفصل مع العظم السنعي الأول والثاني)",
 "だいりょうじゅう": "طرائد كبيرة (حيوانات كبيرة يتم اصطيادها للرياضة)",
 "だいれん": "دَالْيَان",
 "だいろく": "سَادِس, سَادِسَة",
 "だいろっかん": "بصيرة, حاسة سادسة (إدراك الطبيعة الداخلية للأشياء بشكل حدسي)",
 "だいわ": "عارضة (الجزء السفلي من السطح المعمد؛ يرتكز مباشرة على تيجان الأعمدة)",
 "だいわくせい": "كَوْكَب ((علم الفلك) أي من الأجرام السماوية الكبيرة التسعة في النظام الشمسي التي تدور…) / عِمْلَاق غَازِيّ, كَوْكَب غَازِيّ (أي من الكواكب الأربعة الخارجية في النظام الشمسي؛ أكبر بكثير من الأرض وغازي…)",
 "だいカッコ": "قوس مربع (إحدى علامتي الترقيم  المستخدمة لتطويق مادة نصية)",
 "だいスター": "بارع, جهبذ (شخص يتمتع بمهارة مذهلة في أي مجال)",
 "だいヒット": "بلوك باستر, عمل ضخم النجاح (نجاح غير عادي مع شعبية واسعة ومبيعات ضخمة (خاصة لفيلم أو مسرحية أو تسجيل أو…)",
 "だいピンチ": "ضائقة شديدة, ظروف يائسة (حالة من الضيق الشديد)",
 "だいブリテン": "بِرِيطَانِيَا الْعُظْمَى (اسم غير رسمي لِلْمَمْلَكَةِ الْمُتَّحِدَةِ؛ (منذ القرن السابع عشر)…)\nمثال: أنا من بريطانيا.",
 "だいブリテンとう": "بِرِيطَانِيَا الْعُظْمَى (اسم غير رسمي لِلْمَمْلَكَةِ الْمُتَّحِدَةِ؛ (منذ القرن السابع عشر)…)\nمثال: أنا من بريطانيا.",
 "だいリーグ": "الدوري الرئيسي, الدوري الممتاز (أهم دوري في أي رياضة (خاصة البيسبول))",
 "だうま": "حصان حمل (حصان عمل يستخدم كحيوان حمل)",
 "だえき": "لُعَاب, رِيق",
 "だえきせん": "غُدّة لُعَابِيّة",
 "だえきぶんぴ": "إفراز اللعاب, إلعاب (إفراز اللعاب)",
 "だえきぶんぴつ": "إفراز اللعاب, إلعاب (إفراز اللعاب)",
 "だえん": "إِهْلِيلَج, قَطْعٌ نَاقِص",
 "だえんきかがく": "هندسة إهليلجية, هندسة ريمانية ((رياضيات) هندسة لا إقليدية تعتبر الفضاء مثل كرة والخط مثل دائرة عظمى)",
 "だえんぎんが": "مَجَرَة إِهْلِيجِيَّة (نجوم كثيرة لا تدرك بمجرد البصر، وعندما ينتشر ضوؤها فيُرى كأنه بقعة بيضاء (أي:…)\nمثال: أنا بطل المجرة.",
 "だえんめん": "إِهْلِيلَجِيّ, شِبْهُ كُرَوِيّ (ذو طبيعة أو شكل القَطْع الناقص المجسَّم)\nمثال: الأرض عبارة عن مجسم بيضوي",
 "だか": "كَمِّيَّة, مِقْدَار",
 "だから": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب)",
 "だからこそ": "يَعْنِي, أَي",
 "だからって": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "だからといって": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "だからと言って": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "だからよ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "だから何だ": "ثُمَّ ماذَا (يفيد الترتيب والتراخي)",
 "だかん": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / مِلَفّ, وَشِيعَة",
 "だが": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "だがしかし": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "だがしや": "ثَانَوِيّ, صَغِير (ذو أهمّيّة ضئيلة)",
