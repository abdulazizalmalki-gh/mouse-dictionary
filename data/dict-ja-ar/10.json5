 "だとうせいかくにんしけん": "التأكيد على الفاعلية / تصديق (صَدّقّهُ تصديقا:ضد كذَّبّهُ؛ تَصْديق: مصدر صدَّقَ/صَدّقَ ب/صَدّقَ على)\nمثال: رفصنا تصديق ذلك.",
 "だとつ": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "だに": "قُرَادَة, قُرَاد / بلطجي, سفاح (مجرم شاب عدواني وعنيف) / مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "だにねつ": "حمى جبال روكي المبقعة (تسببها بكتيريا ريكتسي وينقلها قراد الخشب)",
 "だの": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "だは": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "だば": "حصان حمل (حصان عمل يستخدم كحيوان حمل)",
 "だばくじょう": "جُرْن, جَرِين (تَعَوَّدَ أَمْرًا وَمَرَنَ عَلَيْهِ؛ جَرَنَ الثَّوْبُ وَالدِّرْعُ وَالأَدِيمُ: لَانَ وَانْسَحَقَ)",
 "だばだば": "بانفعال شديد, بفيض من العاطفة (بطريقة متدفقة المشاعر بشكل مفرط)\nمثال: كاتب غزير الإنتاج بفيض",
 "だび": "حرق الجثث (ترميد جثة الميت)",
 "だふ": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "だふや": "سمسار سوق سوداء, مضارب (شخص يشتري شيئاً ويعيد بيعه بسعر أعلى بكثير من التكلفة الأولية)\nمثال: حصل على تذاكر المسرح من خلال سمسار سوق سوداء",
 "だふ屋": "سمسار سوق سوداء, مضارب (شخص يشتري شيئاً ويعيد بيعه بسعر أعلى بكثير من التكلفة الأولية)\nمثال: حصل على تذاكر المسرح من خلال سمسار سوق سوداء",
 "だぶだぶ": "فَضْفَاض, واسِع / مُتَرَهِّل / غَارِق, مَغْمُور (مُغَطًّى بِالمَاء) / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "だぶる": "تراكب, طية (لسان يقع فوق جزء آخر) / تداخل (خاصية التصادف الجزئي في الوقت) / التقاء, تداخل (تمثيل للأرضية المشتركة بين النظريات أو الظواهر)\nمثال: يجب أن يكون تراكب القرميد عشر بوصات على الأقل / كَرَّرَ, أَعَادَ (أَعَادَ)\nمثال: كرر الشهادة بعدي.",
 "だへい": "دَفَّة",
 "だべる": "بَرْبَرَة, ثَرْثَرَة سَرِيعَة (كلام سريع وغير واضح)",
 "だべん": "هُرَاء, لَغْو",
 "だほ": "أَسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ) / أَسَرَ (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة.",
 "だほう": "تَأَرْجَحَ / أُرْجُوحَة, مُرْجِيحَة",
 "だぼ": "مسمار خشبي, وتد (مثبت يتم إدخاله في ثقوب في قطعتين متجاورتين لتثبيتهما معاً)",
 "だぼう": "وَطْوَاط, خُفَّاش / مِضْرَب, عَصًا",
 "だぼく": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ",
 "だぼくしょう": "كَدَمَ / كَدْمَة, رَضّ",
 "だぼだぼ": "فَضْفَاض, واسِع / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "だぼはぜ": "قوبيون (سمكة صغيرة شائكة الزعانف تعيش في المياه الساحلية أو قليلة الملوحة لها رأس كبير وجسم مستدق ممدود وتتحور الزعانف البطنية لتعمل كممص)",
 "だぼら": "خُرَافَة, قِصَّة مُبَالَغ فِيهَا (قصة غير محتملة (غير عادية أو لا تصدق أو خيالية))",
 "だぼ鯊": "قوبيون (سمكة صغيرة شائكة الزعانف تعيش في المياه الساحلية أو قليلة الملوحة لها رأس كبير وجسم مستدق ممدود وتتحور الزعانف البطنية لتعمل كممص)",
 "だま": "كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم)\nمثال: السحابة هي كتلة بخار في السماء.",
 "だまかす": "حِيلَة",
 "だまくらかす": "حِيلَة",
 "だまされやすい": "سَاذَج",
 "だまし": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "だましうち": "مباغتة, هجوم مفاجئ (هجوم دون سابق إنذار)",
 "だましえ": "ترمبلوي, خداع العين (لوحة مقدمة بتفاصيل دقيقة جداً لخداع المشاهد بشأن حقيقتها)",
 "だましこむ": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "だまし絵": "ترمبلوي, خداع العين (لوحة مقدمة بتفاصيل دقيقة جداً لخداع المشاهد بشأن حقيقتها)",
 "だまし討ち": "مباغتة, هجوم مفاجئ (هجوم دون سابق إنذار)",
 "だまし込む": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "だます": "حِيلَة / تَمَلَّقَ",
 "だまりぼう": "أبكم, صامت (شخص لا يتكلم)",
 "だまりんぼう": "أبكم, صامت (شخص لا يتكلم)",
 "だまる": "صَمَتَ, سَكَتَ",
 "だみん": "بُطْء",
 "だめ": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة. / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه / عَجَزَ, لَا يَسْتَطِيع",
 "だめお": "بِلَا رَصِيد, مَرْفُوض ((عن الشيكات) مُعاد لعدم كفاية الرصيد) / عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "だめおとこ": "بِلَا رَصِيد, مَرْفُوض ((عن الشيكات) مُعاد لعدم كفاية الرصيد) / عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "だめおんな": "بِلَا رَصِيد, مَرْفُوض ((عن الشيكات) مُعاد لعدم كفاية الرصيد) / عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "だめだし": "اِنْتَقَدَ / نَقَدَ",
 "だめになる": "أَفْسَدَ / دَلَّلَ, غَنَّجَ (دلل: أَدَلَّ عَلَيْهِ وتَدَلَّلَ: انْبَسَطَ؛ قالَ ابْنُ دُرَيْدٍ: أَدَلَّ عَلَيْهِ وَثِق بِمَحَبَّتِهِ فأَفْرَط عَلَيْهِ) / فَسَدَ, نَتِنَ\nمثال: دلل سامي صديقته.",
 "だめにんげん": "فَشَل, قُصُور (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / فَشَل (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل) / عُطْل (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: فشل ياني مجددا.",
 "だめをおす": "تَأَكَّدَ",
 "だめん": "جنيح, سطح انسيابي (جهاز يوفر قوة رد فعل عند حركته بالنسبة للهواء المحيط؛ يمكنه رفع أو توجيه طائرة أثناء الطيران)",
 "だめんず": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "だも": "مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "だもの": "زُبَالَة, نُفَايَات / سَلُّة الْمُهْمَلَات",
 "だもので": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "だもんで": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "だゆう": "وكيل وزارة (وزير يتبع مباشرة رئيس قسم حكومي)",
 "だより": "أَخْبَار, أَنْبَاء (أنباء ما قد حدث؛ نشرة الأخبار أو عرض الأخبار: ما يعرضه التلفاز أو الراديو من أخبار سياسة واقتصادية ورياضية تهم عامة الناس)\nمثال: هذه أخبار طيبة.",
 "だら": "إِنْ (يفيد التوكيد) / لَوْ / إِذَا\nمثال: إن شاء الله ؛ / لِمَ لَا (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "だらく": "انحطاط أخلاقي, رذيلة (فعل أو ممارسة فاسدة أو منحطة أو منحلة) / انحطاط أخلاقي, انحلال (انحراف أخلاقي؛ إفساد للفضيلة والمبادئ الأخلاقية)\nمثال: مختلف أشكال الانحطاط في المجتمع الحديث",
 "だらくふはい": "انحطاط, تحقير (التغيير إلى حالة أدنى (حالة أقل احتراماً)) / تزييف, غش (الخلط بمادة غريبة؛ ناتج الغش)",
 "だらし": "عَقْل, حَنْك (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "だらしがない": "قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ) / ضَعِيف",
 "だらしない": "قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ) / ضَعِيف",
 "だらしのない": "قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ) / ضَعِيف",
 "だらず": "مُغَفَّل, أَحْمَق",
 "だらだら": "غارقاً في البلل, مبللاً تماماً (رطب للغاية) / تقاطر, خرير (صوت سقوط سائل قطرة بقطرة) / تقاطر, تنقيط (سائل (كالماء) يتدفق في قطرات (كما من طنف المنزل))\nمثال: مبلل تماماً / بخفة, برفق (بقليل من الوزن أو القوة) / بلطف, تدريجياً (بشكل تدريجي) / برفق, بلطف (بطريقة لطيفة)\nمثال: قبلته بخفة على جبينه / ببطء, بكسل (بطريقة بطيئة)\nمثال: تصاعد الدخان ببطء / على مهل, في وقت الفراغ (بطريقة غير متسرعة أو في الوقت المناسب) / مُسْتَرْسِل, هَادِئ (غير مُتعجّل ولا قسريّ)\nمثال: اقرأ الدليل في وقت فراغك",
 "だらに": "تَعْوِيذَة / هَجَّى, تَهَجَّى",
 "だらり": "بتراخٍ, بفتور (بطريقة فاترة وخاملة)\nمثال: ارتدى الرجال ستراتهم بتراخٍ",
 "だらん": "بتراخٍ, بفتور (بطريقة فاترة وخاملة)\nمثال: ارتدى الرجال ستراتهم بتراخٍ",
 "だり": "أَرْبَعَة, أَرْبَع (أَرْبِعَة؛ أربعَة)",
 "だりぃ": "بَلِيد, خَامِل (بطيء ولا مُبالٍ) / بَطِيء, رَاكِد ((عن الأعمال التجاريّة) غير نشط أو رائج) / خَامِل, كَسُول (بَطِيء أَوْ مُتَرَاخٍ فِي الحَرَكَة) / مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "だりつ": "مُعَدَّل الضَّرْب ((البيسبول) مقياس لأداء الضارب؛ عدد الضربات القاعدية مقسوماً على عدد المرات الرسمية في المضرب) / مُعَدَّل النَّجَاح ((امتداد لمصطلح البيسبول) نسبة المرات التي ينجح فيها جهد ما)\nمثال: كان لدى تيد ويليامز ذات مرة معدل ضرب أعلى من .400",
 "だりょく": "عَطَالَة",
 "だりん": "دَفَّة",
 "だるい": "بَلِيد, خَامِل (بطيء ولا مُبالٍ) / بَطِيء, رَاكِد ((عن الأعمال التجاريّة) غير نشط أو رائج) / خَامِل, كَسُول (بَطِيء أَوْ مُتَرَاخٍ فِي الحَرَكَة) / مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "だるま": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "だるまざめ": "مُتَشَابِه, نَمَطِيّ (ذو مظهر واحد كأنّه مُنتَج بشكل جماعيّ)",
 "だるましゅう": "زَن, زِن ((زَنَّ) عصبه زنا: يبس واسترخت مفاصله؛ (زَنَّ) فلانا بخير أو شر زنا: اتهمه به)\nمثال: هل خسرت وزن مؤخرا؟",
 "だるません": "صندل, طوافة (قارب مسطح القاع لحمل الأحمال الثقيلة (خاصة في القنوات))",
 "だるまストーブ": "مدفأة كرشية, موقد منتفخ (موقد منتفخ الشكل يتم فيه حرق الحطب أو الفحم)",
 "だれ": "صَلْصَة, مَرَق / مَن, مين (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / قطع تحتي (قطع يتم في الجانب السفلي لإزالة مادة) / ضربة مقطوعة, قص ((رياضة) ضربة تضع دوراناً عكسياً على الكرة) / حز التوجيه, قطع تحتي (حز يُقطع في جذع الشجرة لتحديد اتجاه سقوطها) / تندرلوين, فيليه الظهر (اللحم الطري لعضلة الخاصرة على جانبي العمود الفقري)\nمثال: الضربات المقطوعة لا تزعج لاعب التنس الجيد",
 "だれか": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "だれかさん": "تَعْرِفُ مَن, تَعْرِفِينَ مَن",
 "だれかれかまわず": "بشكل عشوائي, دون تمييز (بطريقة عشوائية) / بشكل عشوائي, دون تمييز (بطريقة غير مميزة)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "だれかれなしに": "مَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "だれしも": "الْجَمِيع, كُلّ شَخْص\nمثال: 誰しも礼儀正しい人が好きだ。 — كل الناس يحبون من يتعامل بلباقة. / أَحَد لَا (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "だれぞ": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "だれだって": "الْجَمِيع, كُلّ شَخْص",
 "だれだれ": "فُلَان, فُلَانَة (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو شخص لا يريد المتحدث ذكره)\nمثال: سمعنا ذلك من فلان و فلان.",
 "だれであれ": "مَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "だれでも": "الْجَمِيع, كُلّ شَخْص",
 "だれとく": "بدون جدوى",
 "だれなりと": "الْجَمِيع, كُلّ شَخْص",
 "だれにだって": "الْجَمِيع, كُلّ شَخْص",
 "だれにでも": "الْجَمِيع, كُلّ شَخْص",
 "だれにも": "الْجَمِيع, كُلّ شَخْص",
 "だれにもまして": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض",
 "だれひとり": "أَحَد لَا (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "だれひとりとして": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "だれも": "الْجَمِيع, كُلّ شَخْص / أَحَد لَا (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "だれもかも": "الْجَمِيع, كُلّ شَخْص",
 "だれもかれも": "الْجَمِيع, كُلّ شَخْص",
 "だれる": "جَرَّ (جَرَّ الحيوانَ وغيرَه: جذبه وسحبه؛ جَرَّ أذيالَه: تبختر، زها بنفسه، اختال)\nمثال: اضطررت إلى جر سامي.",
 "だれ一人": "أَحَد لَا (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "だれ一人として": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "だろ": "بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "だろう": "بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "だろうに": "مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "だん": "مِنَصَّة / رَصِيف, مِنَصَّة / بيشر, رامي (مركز في فريق البيسبول للاعب الذي يرمي الكرة للضارب ليحاول ضربها) / تل, رابية (هيكل يتكون من كومة صناعية أو ركام عادة من التراب أو الحجارة) / تل الرامي ((بيسبول) الارتفاع الطفيف الذي يقف عليه الرامي) / ركام, كدس (مجموعة من الأشياء مكدسة فوق بعضها البعض)\nمثال: لعب في كل مركز باستثناء الرامي / عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي. / ماندالا (أي من التصاميم الهندسية المختلفة (عادة دائرية) ترمز للكون؛ تستخدم بشكل رئيسي في الهندوسية والبوذية كأداة مساعدة للتأمل) / خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة / رَفّ (رَفَّتْ أَوْراقُ الشَّجَرِ: اِهْتَزَّتْ، تَحَرَّكَتْ؛ رَفَّتِ العَيْنُ: رَمَّشَتْ)\nمثال: وضع الكتاب على الرف. / دَرَجَة / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / قَرَار, تَصْمِيم / مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / مُدَفِّئ, مُسَخِّن (يُنتِج إحساساً بالحرارة عند وضعه على الجسم) / مُدْفِئ (يمنح الدفء والحرارة) / دفء, ذوبان الجليد (طقس دافئ يعقب التجمد؛ يذوب فيه الثلج والجليد) / تدفئة, تسخين (عملية التحول إلى الدفء؛ ارتفاع درجة الحرارة)\nمثال: رحبوا بذوبان الجليد الربيعي / تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / اِبْن (الولد الذكر)\nمثال: هو له ابن صغير. / بارون / إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق.",
 "だんあつ": "ظُلْم (الثَلَاثُ الظُلَم: الليلة التاسعة عشر، والعشرون، والحادية والعشرون من كل شهر قمري، وسميت بذلك لظلمتها. يسبقها الثلاث الدُرَع ويليها الثلاث الحنادس)\nمثال: نحن نرفض الظلم.",
 "だんあつせいじ": "قَهْر, قَسْر (غَلَبَ وانْتَصَرَ ولم يقدر عليه أحد) / إِكْرَاه",
 "だんあん": "نَتِيجَة",
 "だんいほうしょく": "حَسَن التَّغْذِيَة (يتلقى تغذية سليمة وكافية)",
 "だんおん": "رَفْرَف",
 "だんおんたい": "المنطقة شبه الاستوائية (المناطق المتاخمة للمناطق الاستوائية)",
 "だんか": "أبناء الرعية (عضو في رعية)",
 "だんかい": "مَرْحَلَة / مُنَصَّة, مَسْرَح / مُسْتَوًى / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / سَلَالِم / كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم) / قُدَّاس\nمثال: السحابة هي كتلة بخار في السماء. / عُقَيدَة (عقدة صغيرة) / عُقَيـْدَة ((في علم المعادن) كتلة معدنية صغيرة مستديرة (عادة ما تكون أصلب من الصخور أو الرواسب المحيطة)) / درينة, عقيدة (نتوء صغير مستدير يشبه الثالول على النبات) / جيل طفرة المواليد (الجيل الأكبر من المتوقع في الولايات المتحدة الذي ولد بعد وقت قصير من الحرب العالمية الثانية)",
 "だんかいてき": "تَدْرِيجِيّ, تَزَايُدِيّ (يزداد تدريجيًّا بمقادير منتظمة أو إضافات متتالية)",
 "だんかいのせだい": "جيل طفرة المواليد (الجيل الأكبر من المتوقع في الولايات المتحدة الذي ولد بعد وقت قصير من الحرب العالمية الثانية)",
 "だんかいわけ": "فصل المراحل (التخلص من مرحلة من مراحل صاروخ متعدد المراحل) / سفر بالعربات (السفر بواسطة عربة الخيول) / سقالات (نظام من السقالات) / إنتاج مسرحي, عمل مسرحي (إنتاج دراما على المسرح)",
 "だんがい": "طَعْن, سَحْب ثِقَة / استنكار, تنديد (فعل علني للتنديد) / جرف شديد الانحدار, هاوية (جرف شديد الانحدار جداً)",
 "だんがん": "رَصَاصَة, رَصَاص / جرف شديد الانحدار, هاوية (جرف شديد الانحدار جداً)",
 "だんがんどうろ": "أوتوستراد, طريق سريع (طريق سريع عريض مصمم لحركة المرور عالية السرعة)",
 "だんがんれっしゃ": "بسرعة فائقة, في لمح البصر (في وقت قصير نسبياً)\nمثال: أنهت المهمة في لمح البصر",
 "だんがんライナー": "ضربة خطية, لاين درايف ((بيسبول) ضربة تطير بشكل مستقيم من الضارب)\nمثال: ضرب الضارب كرة خطية إلى الشورت ستوب",
 "だんき": "دفاء / اِسْتَدْفَأَ / دَفَّأَ, أَدْفَأَ (دَفَّأَ الَجريحَ: أَدْفَأَهُ) / عَيْن, يَنْبُوع (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / يَاي, زُنْبُرُك\nمثال: كان عين ليلى مسودة.",
 "だんきゅう": "شرفة أرضية, فناء (منطقة خارجية مبلطة عادة مجاورة للمسكن) / شرفة, صف منازل (صف من المنازل مبني بنمط مماثل وله جدران فاصلة مشتركة (أو الشارع الذي تطل عليه)) / شرفة, مصطبة (رف مستوٍ من الأرض يقطع انحداراً (مع منحدرات حادة فوقه وتحته))",
 "だんぎ": "مُنَاقَشَة, بَحْث / تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / تَحْذِير, تَنْبِيه (نصيحة تحذيرية حول شيء وشيك (خاصة خطر وشيك أو أمر غير سار)) / إِنْذَار, تَحْذِير (توبيخ حازم)\nمثال: خطاب تحذير حول مخاطر الفسق / مَوْعِظَة, خُطْبَة",
 "だんぎく": "اَللِّحْيَة الزَّرْقَاء",
 "だんぎょう": "زُهْد (زَهَّدَ (زهده): قلله؛ زَهَّدَ فيه وعنه: جعله يزهد)",
 "だんけ": "أبناء الرعية (عضو في رعية)",
 "だんけつ": "وَحْدَة, اِتِّحَاد",
 "だんけつしん": "تضامن, روح الجماعة (روح الجماعة التي تجعل الأعضاء يرغبون في نجاح المجموعة)",
 "だんけつりょく": "وَحْدَة, اِتِّحَاد",
 "だんげん": "إقرار, تأكيد (إعلان يتم التأكيد عليه بقوة (كما لو لم تكن هناك حاجة إلى أدلة داعمة)) / إقرار, بيان (فعل تأكيد أو إقرار أو بيان شيء ما)",
 "だんげんてき": "غَيْرُ مَشْرُوط, قَاطِع (غير مقيّد بتحفّظات أو استثناءات) / تصنيفي, فئوي (يتعلق بـ أو مدرج في فئة أو فئات)",
 "だんこ": "بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم",
 "だんこう": "أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية / تَوَاطُؤ / مُشَاوَرَة, اِسْتِشَارَة / انقطاع, قطع مفاجئ (حالة من المقاطعة المفاجئة) / مفاوضة جماعية (تفاوض بين صاحب العمل والنقابة العمالية) / كَسْر, اِنْكِسَار / كَسْر / يكسر, ينكسر / عَبْر البِلَاد, عَبْر الرِّيف (عبر الريف) / اخْتِرَاقًا لِلضَّاحِيَة, عَبْر الحُقُول (عدم اتباع المسارات أو الطرق)\nمثال: النهر يجري عبر البلاد",
 "だんこうきょうそう": "عَبْر البِلَاد, عَبْر الرِّيف (عبر الريف) / اخْتِرَاقًا لِلضَّاحِيَة, عَبْر الحُقُول (عدم اتباع المسارات أو الطرق)\nمثال: النهر يجري عبر البلاد",
 "だんことして": "بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم",
 "だんこん": "ثقب رصاصة (ثقب أحدثته رصاصة مرت من خلاله) / قَضِيب, ذَكَر",
 "だんこんき": "المرحلة القضيبية ((التحليل النفسي) المرحلة الثالثة في نمو الطفل عندما يُفترض أن يكون الوعي بالأعضاء التناسلية والتلاعب بها مصدراً أساسياً للمتعة)",
 "だんご": "دَامْبْلِنْغ / كُرَوِيّ (ذو شكل الكرة أو المجال) / كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم)\nمثال: السحابة هي كتلة بخار في السماء. / مُنَاقَشَة, بَحْث",
 "だんごう": "تَوَاطُؤ / مُشَاوَرَة, اِسْتِشَارَة",
 "だんごうお": "سمكة الكتل (سمكة خرقاء ناعمة سميكة الجسم في شمال المحيط الأطلسي مع زعانف حوضية ملتحمة في ممص؛ يستخدم بطرخها الصالح للأكل للكافيار)",
 "だんごく": "اِعْتِقَاد, عَقِيدَة",
 "だんごじょう": "كُتْلَة (القطعة المجتمعة من الشيء؛ القطعة الواحدة من اللحم)\nمثال: السحابة هي كتلة بخار في السماء.",
 "だんごっぱな": "أنف أفطس (أنف قصير؛ مسطح ومقلوب في النهاية)",
 "だんごばな": "أنف أفطس (أنف قصير؛ مسطح ومقلوب في النهاية)",
 "だんごむし": "قملة الخشب المكورة (متماثل أرجل أرضي صغير ذو جسم مقسم محدب يمكنه الالتفاف على شكل كرة)",
 "だんご虫": "قملة الخشب المكورة (متماثل أرجل أرضي صغير ذو جسم مقسم محدب يمكنه الالتفاف على شكل كرة)",
 "だんさ": "منحدر (سطح مائل يربط بين مستويين) / سلم الطائرة, منحدر (درج متحرك يستخدمه الركاب للصعود إلى الطائرة أو النزول منها) / رامب, كراث بري (نبات معمر من أمريكا الشمالية له بصلة رفيعة وزهور بيضاء)",
 "だんさい": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة",
 "だんさいき": "قطاعة الورق, مقص الورق (أداة قطع لقطع أوراق الورق للحجم المطلوب)",
 "だんさん": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة.",
 "だんざい": "تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين / ضرب العنق, قطع الرأس (القتل بقطع الرأس) / قطع الرأس (الإعدام بقطع رأس الضحية)",
 "だんざいしゃ": "مُعَاقِب",
 "だんし": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى. / إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق. / عَزْم / لَحْظَة, دَقِيقَة / نَقْد, اِنْتِقَاد / خنفساء مطقطقة (أي من الخنافس المتنوعة واسعة الانتشار) / قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود.",
 "だんしせいと": "تِلْمِيذ",
 "だんしべん": "مِبْوَلَة",
 "だんしゃく": "بارون",
 "だんしゃくふじん": "بارونة (امرأة نبيلة تحمل رتبة بارون أو هي زوجة أو أرملة بارون)",
 "だんしゃり": "التبسيطية, الفن التقليلي (حركة فنية في النحت والرسم بدأت في الخمسينيات وأكدت على التبسيط الشديد للشكل واللون)",
 "だんしゅ": "تعقيم (إجراء جعل شيء ما خالياً من البكتيريا الحية أو الكائنات الحية الدقيقة الأخرى (عادةً عن طريق الحرارة أو الوسائل الكيميائية)) / تعقيم (فعل جعل الكائن الحي عقيماً أو غير قادر على الإنجاب)",
 "だんしょく": "لِوَاط",
 "だんじ": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى. / إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق. / عَزْم / لَحْظَة, دَقِيقَة / نَقْد, اِنْتِقَاد",
 "だんじき": "صَوْم, صِيَام",
 "だんじきづき": "رَمَضَان",
 "だんじて": "مطلقا, على الإطلاق",
 "だんじょう": "مَرْحَلَة / مُنَصَّة, مَسْرَح / قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "だんじょかんけい": "اتصال جنسي, جماع (نشاط جنسي بين الأفراد، خاصة إيلاج العضو الذكري في المهبل حتى حدوث النشوة والقذف)",
 "だんじょきょうよう": "أُحَادِيُّ الجِنْس (لا يُمَيَّز على أساس الجنس)",
 "だんじょけんよう": "أُحَادِيُّ الجِنْس (لا يُمَيَّز على أساس الجنس)",
 "だんじょさべつ": "تمييز جنسي (التمييز (عادة في التوظيف) الذي يستبعد جنساً واحداً (عادة النساء) لصالح الجنس الآخر)",
 "だんじる": "قَرَّرَ, صَمَّمَ / قَرَّرَ / قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / تَفَاوَضَ / لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس.",
 "だんずる": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / تَفَاوَضَ / لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / عَزَفَ, شَغَّلَ (والمعزف :الملاهي واحدها معزف ومعزفة) / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / مَسْرَحِيَّة / مَسْرَح, مَسْرَحِيَّة\nمثال: لعب زيري التنس. / قَرَّرَ, صَمَّمَ / قَرَّرَ / قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "だんせい": "مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته / إِنْسَان, نَاس (كَائِن بَشَرِيّ؛ سَوَاد العَيْن) / زود بالجند (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)\nمثال: أنا إنسان صادق.",
 "だんせいか": "استرجال, تذكر (التطور غير الطبيعي لخصائص جنسية ذكرية في الأنثى (عادة نتيجة للعلاجات الهرمونية أو خلل في الغدة الكظرية))",
 "だんせいがただつもうしょう": "صلع ذكوري (فقدان الشعر في مقدمة وأعلى الرأس)",
 "だんせいき": "أعضاء تناسلية ذكرية (أعضاء جنسية ذكرية خارجية)",
 "だんせいきょうふしょう": "رهاب الرجال (خوف مرضي من الرجال)",
 "だんせいじしん": "قَضِيب, ذَكَر",
 "だんせいせい": "ذكورة, رجولة (سمة التصرف بطرق تعتبر نموذجية للرجال) / ذكورة (الخصائص المميزة للجنس الذكري)",
 "だんせいてき": "رُجُولِيّ",
 "だんせいと": "تِلْمِيذ",
 "だんせいゆういろんしゃ": "شوفيني ذكوري (رجل لديه اعتقاد شوفيني بدونية المرأة)",
 "だんせいりつ": "مُعَامِل الْمُرُونَة, مِعْيَار الْمُرُونَة ((في الفيزياء) نسبة الإجهاد المطبق إلى التغير في شكل جسم مرن)",
 "だんせいゴム": "مطاط, مطاط طبيعي (مادة مرنة يتم الحصول عليها من عصارة اللاتكس للأشجار (خاصة أشجار جنس الهيفيا والفيكس) والتي يمكن معالجتها بالكبريت وتشطيبها في مجموعة متنوعة من…)",
 "だんせつ": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / تخفيف, مزج (عملية تخفيف شيء ما) / تقطيع, قطع (عملية قطع شيء ما إلى أجزاء) / قص, قطع (عملية الاختراق أو الفتح بحافة حادة)\nمثال: أعطاه الحلاق قصة جيدة",
 "だんせん": "فصل, قطع الاتصال (عملية قطع الاتصال) / فَجْوَة عَمِيقَة, هُوَّة (تفاوت لا يمكن جسره (بسبب فشل في الفهم مثلاً)) / انفصال, تفكك (حالة الانفصال)\nمثال: شعر بهوة بينه وبين أصدقائه السابقين",
 "だんぜつ": "اِنْقِرَاض / فصل, قطع (عملية الفصل أو القطع) / انشقاق, صدع (انفصال شخصي أو اجتماعي (كما بين الفصائل المتعارضة))\nمثال: كانوا يأملون في تجنب قطيعة في العلاقات",
 "だんぜん": "بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم / بالتأكيد, بشكل قاطع (بدون شك وخارج نطاق الشك)\nمثال: كان باهظ الثمن بلا شك / إلى حد بعيد, بكثير (بفارق كبير)\nمثال: كانت الطالبة الأذكى بمراحل",
 "だんそう": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة) / صَدْع, فَالِق ((صَدَعَ) النباتُ الأرضَ يَصْدَعَ صَدْعًا: شَقَّها وظَهَرَ منها؛ (صَدَعَ) الزجاجَ ونحوه: كسره)\nمثال: كان خطأ حاسوبي. / انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية / أَدَاء / مَسْرَحِيَّة / خَزَّان الْبُنْدُقِيَّة, مَخْزَن طَلَقَاتِ السِّلَاحِ",
 "だんそううんどう": "صدع, فالق ((جيولوجيا) شق في القشرة الأرضية ناتج عن إزاحة جانب واحد بالنسبة للآخر)\nمثال: بنوها فوق صدع جيولوجي مباشرة",
 "だんそうさつえい": "تصوير طبي, تصوير مقطعي ((طب) الحصول على صور لداخل الجسم)",
 "だんそうしゃしん": "صورة مقطعية (الصورة المقطعية هي صورة بالأشعة السينية تنتج عن طريق التصوير المقطعي)",
 "だんそうせん": "خط الصدع (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "だんそく": "سُرْعَة الفُوَّهَة (سرعة المقذوف لحظة خروجه من فوهة البندقية)",
 "だんそんじょひ": "شوفينية ذكورية, معاداة النسوية (نشاط يدل على الاعتقاد بتفوق الرجال على النساء)",
 "だんぞく": "تَقَطُّع (صفة كون الشيء متقطعاً؛ خاضعاً للانقطاع أو التوقف الدوري)",
 "だんぞくてき": "مُتَقَطِّع / مَوْسِمِيّ",
 "だんぞくへいこうせつ": "توازن متقطع, توازن نقطي (نظرية للتطور ترى أن التغيير التطوري في السجل الأحفوري جاء في نوبات وبدايات بدلاً من عملية ثابتة من التغيير البطيء)",
 "だんぞめ": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً)",
 "だんたい": "مَجْمُوعَة, جَمَاعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة. / تَرْتِيب, تَنْظِيم (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / مُنَظَّمَة, مُؤَسَّسَة / مُنَظَّمَة\nمثال: أعاد زيري ترتيب المطبخ كلية. / المنطقة شبه الاستوائية (المناطق المتاخمة للمناطق الاستوائية) / حزام ذخيرة, نطاق (حزام خراطيش عريض يرتديه الجنود فوق الكتف)",
 "だんたいきょうぎ": "رياضة جماعية (رياضة تتضمن المنافسة بين فرق من اللاعبين)\nمثال: البيسبول رياضة جماعية لكن الغولف ليس كذلك",
 "だんたいきょうやく": "اتفاقية جماعية, عقد عمل جماعي (عقد بين العمال والإدارة ينظم الأجور والمزايا وظروف العمل)",
 "だんたいこうしょう": "مفاوضة جماعية (تفاوض بين صاحب العمل والنقابة العمالية)",
 "だんたいせいしん": "تضامن, روح الجماعة (روح الجماعة التي تجعل الأعضاء يرغبون في نجاح المجموعة)",
 "だんたいほけん": "تأمين جماعي (تأمين تشتريه مجموعة (مثل موظفي شركة) عادة بسعر مخفض للأعضاء الأفراد في المجموعة)",
 "だんたん": "جُذْمُور, كُنَّاشَة",
 "だんだら": "تَفَاوُت, عَدَم اسْتِوَاء (صفة عدم التوازن) / تَبَايُن, تَفَاوُت (صفة كون الشيء غير مستوٍ وتنقصه الوحدة)",
 "だんだん": "شَيْئاً فَشَيْئاً, خُطْوةً فَخُطْوةً / درج, سلالم (شوط من السلالم أو مجموعة من الدرجات) / خطى (المسار الذي سار عليه شخص ما أو يسير فيه)\nمثال: اتبعت خطاه / شُكْرًا, تِسْلَم",
 "だんだんこ": "بإصرار, بثبات (بتصميم حازم) / رَاسِخ, مَتِين (قويّ وأكيد) / رَاسِخ, مُخْلِص (ثَابِت لَا يَتَزَعْزَع فِي الإِخْلَاص لِصَدِيق أَوْ عَهْد أَوْ قَضِيَّة) / جَامِد, رَاسِخ (مُثَبَّت بِإِحْكَام فِي مَكَانِه)\nمثال: صدقنا ذلك بحزم",
 "だんちがい": "غَيْرُ مُنْتَظِمٍ, مُتَفَاوِت (يَفْتَقِرُ إِلَى الِاتِّسَاقِ وَالِانْتِظَامِ) / غَيْرُ مُتَكَافِئ ((عن مسابقة أو متنافسين) غير متكافئ كخصوم) / غير مستوٍ, متفاوت (غير مستوٍ أو غير منتظم كما في الشكل أو الملمس) / فردي (لا يقبل القسمة على اثنين)\nمثال: لون غير منتظم",
 "だんちがいへいこうぼう": "المتوازي مختلف الارتفاع, عارضتان غير مستويتين (زوج من القضبان المتوازية مثبتة على ارتفاعات مختلفة؛ تستخدم في جمباز السيدات)",
 "だんちく": "غاب عملاق, قيصوب (أعشاب معمرة جذمورية كبيرة توجد بجانب الأنهار وفي الخنادق لها سيقان مفصلية وعناقيد ريشية رمادية بيضاء كبيرة)",
 "だんちぞく": "مساكن شعبية, مشروع إسكان عام (مجمع سكني ممول ومُدار حكومياً للأسر ذات الدخل المنخفض)",
 "だんちゃく": "أَصَابَ / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: تلقى مناد ضربة.",
 "だんちゃくきょり": "مدى, قدرة / مَدَى",
 "だんちょう": "حزن شديد, فجيعة (أسى شديد ناتج عن فقدان شخص محبوب (خاصة بالموت))",
 "だんつく": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة.",
 "だんてい": "نَتِيجَة / إِيجَابِيّ, تَوْكِيدِيّ (يؤكد أو يعطي الموافقة) / اسْتِحْسَانِيّ, مُوَافِق (يُعَبِّر عَنِ المَدْح أَوِ الاسْتِحْسَان أَوْ يُظْهِرُهُمَا) / تَفَاؤُلِيّ, مُتَفَائِل (يتوقع الأفضل من الأمور) / إيجاب, رد بالإيجاب (رد يفيد التأكيد أو الموافقة)\nمثال: قرار إيجابي",
 "だんとう": "رَأْس حَرْبِيّ (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ)\nمثال: قطع سامي رأس كلب. / ضرب العنق, قطع الرأس (القتل بقطع الرأس) / قطع الرأس (الإعدام بقطع رأس الضحية)",
 "だんとうだい": "طَابُوقَة",
 "だんどう": "مَسَار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة. / بَالِسْتِيّ",
 "だんどうがく": "باليستيات, علم القذائف (علم ديناميكيات الطيران للمقذوفات) / علم المقذوفات, مسار قذفي (مسار جسم في رحلة حرة)",
 "だんどうだん": "قَذِيفَة, صَارُوخ / صَارُوخ, قَذِيفَة (سهم له ساق من قصب و في أحد طرفيه أنبوبة صغيرة من المقوى تحشى بارودا و لها فتيل من فتحتها السفلى فإذا أُشعل الفتيل و احتُرق ما في مُؤخرتها من بارود…؛ سلاح حربي، و رُبما استُخدم في أمور غير حربية، وهو كناية على اسطوانة ضخمة مخروطية الشكل، ذات جناحين صغيرين يثبتانها في خط مجراها…)\nمثال: هبط الصاروخ بدون مشاكل.",
 "だんどうだんげいげきミサイル": "صاروخ مضاد للصواريخ الباليستية (صاروخ دفاعي مصمم لإسقاط الصواريخ الباليستية العابرة للقارات القادمة)\nمثال: محادثات الحد من الأسلحة الاستراتيجية وضعت حدوداً على نشر الصواريخ المضادة للصواريخ الباليستية",
 "だんどうだんげいげきミサイルせいげんじょうやく": "صاروخ مضاد للصواريخ الباليستية (صاروخ دفاعي مصمم لإسقاط الصواريخ الباليستية العابرة للقارات القادمة)\nمثال: محادثات الحد من الأسلحة الاستراتيجية وضعت حدوداً على نشر الصواريخ المضادة للصواريخ الباليستية",
 "だんどうミサイル": "صَارُوخ بَالِسْتِيّ, صَارُوخ قَذْفِيّ (سهم له ساق من قصب و في أحد طرفيه أنبوبة صغيرة من المقوى تحشى بارودا و لها فتيل من فتحتها السفلى فإذا أُشعل الفتيل و احتُرق ما في مُؤخرتها من بارود…؛ سلاح حربي، و رُبما استُخدم في أمور غير حربية، وهو كناية على اسطوانة ضخمة مخروطية الشكل، ذات جناحين صغيرين يثبتانها في خط مجراها…)\nمثال: هبط الصاروخ بدون مشاكل.",
 "だんどうミサイルぼうえい": "صَارُوخ بَالِسْتِيّ, صَارُوخ قَذْفِيّ (سهم له ساق من قصب و في أحد طرفيه أنبوبة صغيرة من المقوى تحشى بارودا و لها فتيل من فتحتها السفلى فإذا أُشعل الفتيل و احتُرق ما في مُؤخرتها من بارود…؛ سلاح حربي، و رُبما استُخدم في أمور غير حربية، وهو كناية على اسطوانة ضخمة مخروطية الشكل، ذات جناحين صغيرين يثبتانها في خط مجراها…)\nمثال: هبط الصاروخ بدون مشاكل.",
 "だんどぼろぎく": "إريكتيتس, عشب النار (نبات عشبي أمريكي ضار ذو أزهار بيضاء أو مخضرة صغيرة) / عشبة الصفصاف العملاقة, عشبة النار (نبات معمر طويل من أمريكا الشمالية ذو جذور زاحفة وأوراق ضيقة وسنابل من الزهور الوردية الأرجوانية توجد بكثرة كبيرة في المناطق المحترقة أو المناطق التي…)",
 "だんどり": "برنامج (أداء (أو سلسلة من العروض) في عرض عام) / برنامج, خطة (سلسلة من الخطوات التي يتعين تنفيذها أو الأهداف التي يتعين تحقيقها) / برنامج (نظام من المشاريع أو الخدمات يهدف إلى تلبية حاجة عامة) / برنامج, برنامج حاسوبي ((علم الحاسوب) تسلسل من التعليمات التي يمكن للحاسوب تفسيرها وتنفيذها)\nمثال: استمر البرنامج لأكثر من ساعتين",
 "だんどる": "جَدْوَل, جَدْوَل أَعْمَال",
 "だんな": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن. / زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة. / أُسْتَاذ, سَيِّد (الْمُعَلِّمُ العَالِمُ بِمَا يُعَلِّمُ وَيُدَرِّسُ العارِف لَهُ؛ لقب علميّ جامعيّ، وهو على درجات، أستاذ مساعد وأستاذ مشارك وأستاذ كرسيّ وأستاذ مُبَرِّز)\nمثال: الأستاذ على حق. / شوجر دادي (رجل ثري أكبر سناً يقدم هدايا باهظة لشخص شاب مقابل الصداقة أو العلاقة الحميمة)",
 "だんなげい": "الهواية, مبدأ الهواية (القناعة بوجوب ممارسة الرياضة كهواية (للمتعة) وليس من أجل المال)",
 "だんなさま": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة. / سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "だんなし": "زوج (رجل متزوج؛ شريك المرأة في الزواج)",
 "だんなしゅう": "رجل, رفيق (صبي أو رجل) / رجل محترم, سيد (اختصار غير رسمي لـ \"رجل نبيل\")\nمثال: ذلك الرجل هو مضيفك",
 "だんな様": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة. / سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "だんねつ": "عزل (فعل حماية شيء ما عن طريق إحاطته بمادة تقلل أو تمنع انتقال الصوت أو الحرارة أو الكهرباء) / انعزال, تقوقع (حالة العزلة أو الانفصال) / عازل, مادة عازلة (مادة عازلة تقلل أو تمنع انتقال الحرارة أو الصوت أو الكهرباء)\nمثال: حافظت القناة الإنجليزية على انعزال إنجلترا",
 "だんねつかてい": "عملية أديباتية, عملية كظمية ((في الديناميكا الحرارية) أي عملية تحدث دون اكتساب أو فقدان للحرارة)",
 "だんねつせい": "عزل (فعل حماية شيء ما عن طريق إحاطته بمادة تقلل أو تمنع انتقال الصوت أو الحرارة أو الكهرباء) / انعزال, تقوقع (حالة العزلة أو الانفصال) / عازل, مادة عازلة (مادة عازلة تقلل أو تمنع انتقال الحرارة أو الصوت أو الكهرباء)\nمثال: حافظت القناة الإنجليزية على انعزال إنجلترا",
 "だんねつてき": "أديباتي, كظيم للحرارة (يحدث دون فقدان أو اكتساب للحرارة)\nمثال: تمدد أديباتي",
 "だんねん": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "だんのせいしん": "تضامن, روح الجماعة (روح الجماعة التي تجعل الأعضاء يرغبون في نجاح المجموعة)",
 "だんはん": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة.",
 "だんばな": "أَنْف, خَشَم (أنف:اشْتَكَى أَنفه فَهُوَ مأنوف؛ أنف الشَّيْء: حدد طرفه)\nمثال: أنت لديك أنف كبير. / أَنْف مَعْقُوف (أنف:اشْتَكَى أَنفه فَهُوَ مأنوف؛ أنف الشَّيْء: حدد طرفه)\nمثال: أنت لديك أنف كبير.",
 "だんばら": "مدفأة كرشية, موقد منتفخ (موقد منتفخ الشكل يتم فيه حرق الحطب أو الفحم) / كرش (مصطلحات عامية للكرش أو البطن البارز)",
 "だんぱつ": "بُوب / مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته",
 "だんぱん": "مُفَاوَضَات, مُذَاكَرَات",
 "だんびら": "سيف عريض (سيف ذو نصل عريض و(عادة) حدين قاطعين؛ يستخدم للقطع بدلاً من الطعن)",
 "だんぶり": "يَعْسُوب",
 "だんぺん": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / شَظَايَا",
 "だんぺんか": "تذرية, تفتيت (فصل شيء ما إلى جزيئات دقيقة) / تشظي, تفتت (تناثر شظايا القنبلة بعد انفجارها) / تجزئة ((في علم الحاسوب) حالة الملف المقسم والمخزن في العديد من المواقع المختلفة على قرص ممغنط) / تفتت, شرذمة (تفكك المعايير الاجتماعية التي تحكم السلوك والفكر والعلاقات الاجتماعية)\nمثال: تؤدي التجزئة إلى إبطاء أداء النظام لأنه يستغرق وقتاً إضافياً لتحديد موقع أجزاء الملف المجزأ وتجميعها",
 "だんぺんてき": "شِظْوِيّ, مُتَشَظٍّ (يتألّف من أجزاء صغيرة غير مترابطة)",
 "だんぼう": "تَدْفِئَة",
 "だんぼうき": "مِدْفَأَة",
 "だんぼうそうち": "مِدْفَأَة",
 "だんまく": "قصف مركز, وابل (النار الكثيفة للمدفعية لإشباع منطقة بدلاً من ضرب هدف محدد) / تدفق, وابل (التدفق السريع والمستمر للتواصل اللغوي (المنطوق أو المكتوب))\nمثال: أطلقوا وابلاً من النيران أمام القوات المتقدمة",
 "だんまり": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "だんまりぼう": "أبكم, صامت (شخص لا يتكلم)",
 "だんめん": "قِسْم, جُزْء (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَقْطَع\nمثال: أنا أزين القسم.",
 "だんめんせき": "مَقْطَعِيّ (يُمَثِّل مُسْتَوًى ناتِجًا عَن القَطْع عَرْضِيًّا بِزاوِيَة قائِمَة) / عرضي, مقطعي (من أو يتعلق بمقطع عرضي)\nمثال: شريحة مقطعية",
 "だんやく": "ذُخِيرَة / اِنْسِحَاب",
 "だんやくこ": "مخزن البارود, مخزن الذخيرة (مستودع (كحجرة في سفينة حربية) حيث تُخزن الأسلحة والذخيرة)",
 "だんやくとう": "خَرْطُوش, خَرْطُوشَة",
 "だんゆう": "مُمَثِّل, مُمَثِّلَة",
 "だんらく": "فِقْرَة, بَنْد / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "だんらん": "اِنْسِجَام, تَوَافُق",
 "だんりょく": "مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته",
 "だんりょくせい": "مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته",
 "だんりょくてき": "مَرِن",
 "だんりん": "دَيْر (بيت يسكنه الرُهْبَان أو الرَاهِبَات ممن كان على دين المسيحية)\nمثال: سيداتي و سادتي ، رجاء قفوا للنشيد الوطني للاتحاد الروسي باداء جوقة دير سرتينسكي .",
 "だんろ": "مِدْفَأَة, مَوْقِد / فصل, قطع الاتصال (عملية قطع الاتصال) / فَجْوَة عَمِيقَة, هُوَّة (تفاوت لا يمكن جسره (بسبب فشل في الفهم مثلاً)) / انفصال, تفكك (حالة الانفصال)\nمثال: شعر بهوة بينه وبين أصدقائه السابقين",
 "だんろん": "مُنَاقَشَة, بَحْث",
 "だんわ": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب. / اِرْتِجَالِيّ, عَفْوِيّ (بقليل من الإعداد أو التفكير المسبق أو بدونهما)",
 "だんわかい": "حلقة نقاش, ندوة (خطاب في اجتماع أكاديمي أو ندوة) / حَلَقَة نِقَاشِيَّة, مُؤْتَمَر عِلْمِيّ (اجتماع أكاديمي أو ندوة يقودها عادة محاضر مختلف وتتناول موضوعاً مختلفاً في كل اجتماع)",
 "だんわしつ": "صَالَة, قَاعَة (مكان فسيح في وسط المسكن يُوصِلُ إلى سائر الحجرات، الرُدْهَة؛ غُرْفَةُ المَعِيْشَة سواء كانت توصل إلى سائر الحجرات أم لا وسواء كانت فسيحة أم لا)\nمثال: حجزت الصالة يوم الخميس.",
 "だんトツ": "إلى حد بعيد, بكثير (بفارق كبير)\nمثال: كانت الطالبة الأذكى بمراحل",
 "だんボール": "كَرْتُون, وَرَق مُقَوَّى / كَرْتُون, كَرْتُونَة / عَرُوسَة",
 "だんボールばこ": "كَرْتُون, كَرْتُونَة / عَرُوسَة",
 "だーめ": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة. / مَيْئُوس مِنْه ((غير رسمي للتأكيد) يتجاوز أي أمل في الإصلاح أو المعالجة) / فاقد للأمل, ميؤوس منه (بدون أمل لعدم وجود إمكانية للراحة أو النجاح) / بِلَا أَمَل, مَيْؤُوس مِنْه (محكوم عليه بالفشل حتماً) / عَاجِز, يَائِس ((عن شخص) غير قادر على فعل شيء بمهارة)\nمثال: في عذاب من الحزن الميؤوس منه / عَجَزَ, لَا يَسْتَطِيع",
 "だーれ": "مَن, مين (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "ち": "دَم, دم (فِي وَ: سائل أحمر في جسم الكائنات الحية يقوم بنقل المواد الغذائية والأكسجين إلى الخلايا والفضلات وثاني أكسيد الكربون منها)\nمثال: تبرع توم بالدم. / أَلْف, ١٠٠٠ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك. / تُرْبَة, تُرَاب / أَرْض, أرض (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون) / أَرْض, دُنْيَا (الكَوْكَب الذي نعيش عليه. لا جمع له؛ البَرّ، ضد البَحْر. يجمع على أرضون)\nمثال: أرض الله واسعة. / مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس / إِقْلِيم (مساحة مكانية معينة ومحددة تمثل الخطوط الحدودية لمنطقة جغرافية أو مناخية، أو كيان سياسي ما) / قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما. / حَلِيب (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ) / لَبَن (سَقَاهُ اللَبَن؛ أكل كثيرا) / حَلَبَ (الشاةَ أو البقرةَ أو الناقةَ: استخرج ما في ضرعها من لبن؛ فلانٌ للرجل: أي حَلَب ماشية الرجل نيابة عنه)\nمثال: كنت أشرب الحليب / ثَدْي, بز / صَدْر (الأمر: حدث ووقع وتقرّر؛ عن المكان: رجع وانصرف)\nمثال: تلقى ياني طلقة في الصدر. / عُرْوَة, عُقْدَة / حِكْمَة (مؤنث حَكَم)\nمثال: خذ الحكمة من أي وعاء خرجت. / حَمَاقَة (خطأ سخيف) / مُسْتَوًى / مَرْحَلَة / خوص, غصن الصفصاف (عمل مصنوع من أغصان رفيعة متشابكة (خاصة أغصان الصفصاف)) / طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / سِيَاسَة (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة. / سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام. / شِفَاء / شَفَى",
 "ちあい": "أحمر داكن (لون أحمر يعكس القليل من الضوء)",
 "ちあん": "أمن عام, سلم (الأمن العام للأماكن العامة)\nمثال: تم القبض عليه بتهمة إقلاق السلم العام",
 "ちあんしゅつどう": "أمن عام, سلم (الأمن العام للأماكن العامة)\nمثال: تم القبض عليه بتهمة إقلاق السلم العام",
 "ちあんぶたい": "أمن خاص, قوة أمنية (مجموعة موظفة بشكل خاص لحماية أمن شركة أو صناعة)",
 "ちい": "مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث. / أُشْنَة, حَزَاز / كارثة طبيعية",
 "ちいき": "مِسَاحَة / مِنْطَقَة, نَاحِيَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة. / مدى, قدرة / مَدَى",
 "ちいきか": "تحديد الموقع, تموضُع (تحديد المكان الذي يوجد فيه الشيء) / توطين الوظيفة, مبدأ التوطين ((فسيولوجيا) المبدأ القائل بأن وظائف محددة لها مواقع محددة نسبيًا في جزء أو عضو معين من الجسم)",
 "ちいきけんきゅう": "دراسات المناطق (مجال بحث متعدد التخصصات يتعلق بمنطقة جغرافية أو وطنية/فيدرالية أو ثقافية معينة)",
 "ちいきしゅぎ": "الجِهَوِيَّة",
 "ちいきじこく": "توقيت محلي, توقيت مدني (الوقت الرسمي في منطقة محلية (معدل حسب الموقع حول الأرض)؛ يحدد بالقانون أو العرف)",
 "ちいきてき": "إِقْلِيمِيّ, جِهَوِيّ",
 "ちいきばんごう": "رمز المنطقة (رقم يتكون عادة من 3 خانات يُخصص لمنطقة هاتفية كما هو الحال في الولايات المتحدة وكندا)",
 "ちいきょうてい": "أَرِيكَة, كَنَبَة (قطعة أثاث مُنَجَّدَة يُقْعَدُ عليها، مَقْعَد مُنَجَّد)\nمثال: إنها على الأريكة.",
 "ちいきコード": "رمز المنطقة (رقم يتكون عادة من 3 خانات يُخصص لمنطقة هاتفية كما هو الحال في الولايات المتحدة وكندا)",
 "ちいくへんちょう": "بإفراط, كثيراً جداً (أكثر مما يلزم)\nمثال: إنها تأكل كثيراً جداً",
 "ちいさ": "حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / حَبِيبِي, عَزِيزِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي",
 "ちいさい": "صَغِير, صغير / طَفِيف / حَزين / خافِت, مُنْخَفِض / تافه, غير مهم (ليس مهماً) / تافه, ضئيل الشأن (خالٍ من الأهمية أو المعنى أو القوة)\nمثال: ميزة غير مهمة نسبياً للنظام",
 "ちいさな": "صَغِير, صغير",
 "ちいさめ": "صَغِير نَوْعًا مَا (صغير إلى حدٍّ ما)",
 "ちいざい": "رمز المكانة (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "ちいしょくぶつ": "أُشْنَة, حَزَاز",
 "ちいちい": "خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "ちいちゃい": "صَغِير, صغير",
 "ちいっと": "قَلِيلًا",
 "ちいと": "قَلِيلًا",
 "ちいるい": "أُشْنَة, حَزَاز",
 "ちうし": "أبقار حلوب, ماشية الحليب (الماشية التي تُربى من أجل حليبها)",
 "ちうじ": "أبقار حلوب, ماشية الحليب (الماشية التي تُربى من أجل حليبها)",
 "ちうば": "ظِئْر, دَايَة (العاطفة على غير ولدها المرضعة له من الناس والإبل وغيرها. الذكر والأنثى في ذلك سواء)",
 "ちぇ": "صَوَّبَ (أحد جانبي المدينة التي يقسمها نهر، ومن ذلك صوب الكرخ وصوب الرصافة في بغداد؛ نُزول المَطَر) / صَوَّبَ, أَطْلَقَ النَّار (أحد جانبي المدينة التي يقسمها نهر، ومن ذلك صوب الكرخ وصوب الرصافة في بغداد؛ نُزول المَطَر)\nمثال: صوب الرجل مسدسا نحو المحققين.",
 "ちぇすと": "انشراح, بشاشة (صفة كون المرء مبتهجاً وطارداً للكآبة) / هتاف (صرخة أو صيحة استحسان)\nمثال: أضافت الزهور لمسة من البهجة للغرفة الكئيبة",
 "ちぇっ": "صَوَّبَ (أحد جانبي المدينة التي يقسمها نهر، ومن ذلك صوب الكرخ وصوب الرصافة في بغداد؛ نُزول المَطَر) / صَوَّبَ, أَطْلَقَ النَّار (أحد جانبي المدينة التي يقسمها نهر، ومن ذلك صوب الكرخ وصوب الرصافة في بغداد؛ نُزول المَطَر)\nمثال: صوب الرجل مسدسا نحو المحققين.",
