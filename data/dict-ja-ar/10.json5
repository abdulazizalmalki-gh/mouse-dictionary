 "だいのおとな": "بَالِغ",
 "だいのじ": "مُتَرَامِي الأَطْرَاف, مُتَنَاثِر (يَمْتَدُّ فِي اتِّجَاهَاتٍ مُخْتَلِفَةٍ أَوْ مُوَزَّعٌ بِشَكْلٍ غَيْرِ مُنْتَظِم) / انبطاح, تمدد (وضعية غير أنيقة مع تباعد الذراعين والساقين)",
 "だいのほう": "بِرَاز, سَلْح",
 "だいはち": "ثَامِن, ثَامِنَة / ثُمْن (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن.",
 "だいはちのうしんけい": "عصب دهليزي قوقعي, عصب سمعي (عصب حسي مركب يغذي الخلايا الشعرية للعضو الدهليزي والخلايا الشعرية للقوقعة)",
 "だいはっけん": "اِخْتِرَاق (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "だいはんきょう": "حَاسَّة, حِسّ",
 "だいはんじ": "رئيس القضاة (القاضي الذي يترأس المحكمة العليا)",
 "だいはんみんこく": "أُوسَاكَا",
 "だいば": "قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "だいばいしん": "هيئة محلفين كبرى (هيئة محلفين للتحقيق في اتهامات الجريمة وتقييم الأسس لتوجيه الاتهامات)",
 "だいひき": "الدَّفْع عِنْد الاسْتِلَام (تحصيل الرسوم عند التسليم)\nمثال: أرسل طرداً بالدفع عند الاستلام",
 "だいひつしゃ": "كاتب اختزال (شخص ماهر في نسخ الكلام (خاصة الإملاء))",
 "だいひょう": "تمثيل (نشاط يحل محل شيء ما أو يؤدي إلى معادل له) / تَمْثِيل, نِيَابَة (فعل التمثيل؛ الوقوف نيابة عن شخص أو مجموعة والتحدث بسلطة نيابة عنهم) / تجسيد, تمثيل (إبداع يمثل تجسيداً مرئياً أو ملموساً لشخص أو شيء ما) / تمثيل, تمثيل نيابي (الحق في أن يتم تمثيله بواسطة مندوبين لهم صوت في هيئة تشريعية ما) / تجسيد, تمثيل نمطي (شكل أو نموذج تمثيلي أو نمطي) / تمثيل, توضيح بالمثال (الإظهار عن طريق المثال) / قَائِد, زَعِيم",
 "だいひょうかく": "مُمَثِّل, مُمَثِّلَة",
 "だいひょうけん": "تمثيل (نشاط يحل محل شيء ما أو يؤدي إلى معادل له) / تَمْثِيل, نِيَابَة (فعل التمثيل؛ الوقوف نيابة عن شخص أو مجموعة والتحدث بسلطة نيابة عنهم) / تجسيد, تمثيل (إبداع يمثل تجسيداً مرئياً أو ملموساً لشخص أو شيء ما) / تمثيل, تمثيل نيابي (الحق في أن يتم تمثيله بواسطة مندوبين لهم صوت في هيئة تشريعية ما)",
 "だいひょうさく": "تُحْفَة, رَائِعَة",
 "だいひょうしゃ": "مُمَثِّل, مُمَثِّلَة",
 "だいひょうせい": "تمثيل (نشاط يحل محل شيء ما أو يؤدي إلى معادل له) / تَمْثِيل, نِيَابَة (فعل التمثيل؛ الوقوف نيابة عن شخص أو مجموعة والتحدث بسلطة نيابة عنهم) / تجسيد, تمثيل (إبداع يمثل تجسيداً مرئياً أو ملموساً لشخص أو شيء ما) / تمثيل, تمثيل نيابي (الحق في أن يتم تمثيله بواسطة مندوبين لهم صوت في هيئة تشريعية ما)",
 "だいひょうだん": "تَفْوِيض / بِعْثَة, وَفْد",
 "だいひょうてき": "مُمَثِّل, مُمَثِّلَة",
 "だいひょうでんわ": "لوحة مفاتيح, مقسم (مركز هاتف حيث يتم إكمال الدوائر بأسلاك التوصيل)",
 "だいひょうとりしまりやく": "مدير (شخص يتحكم في الموارد والنفقات)",
 "だいひょうばん": "حَاسَّة, حِسّ",
 "だいひょうぶ": "بعثة دبلوماسية (بعثة تخدم أهدافاً وغايات دبلوماسية)",
 "だいびき": "الدَّفْع عِنْد الاسْتِلَام (تحصيل الرسوم عند التسليم)\nمثال: أرسل طرداً بالدفع عند الاستلام",
 "だいふ": "عَرَّاب, إِشْبِين (عامل العَرَبَات؛ عند النصارى: كفيل الطفل المعتمد)\nمثال: العراب هو فيلمي المفضل. / أَب, وَالِد (الوَالِد و/أو المُرَبِّي، ويُطلق أيضًا على الجَدّ والعَمّ وإن علوا؛ أبو الشّيء هو من كان سببا في إيجاده أو ظهوره) / بَابَا\nمثال: الأب في الغرفة.",
 "だいふきょう": "الْكَسَاد الْعَظِيم",
 "だいふく": "بِالتَّوْفِيق!, حَظًّا سَعِيدًا!",
 "だいふくちょう": "دَفْتَر حِسَابَات",
 "だいふごう": "مِلْيَارْدِير",
 "だいふんか": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير)",
 "だいぶ": "مُتَطَاوِل, مُطَوَّل (طَويل نِسْبِيًّا في المُدَّة؛ مُمْتَدّ بِشَكْل مُمِلّ) / أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / إلى حد كبير, بشكل جوهري (إلى مدى أو درجة كبيرة)\nمثال: أخشى أن الفيلم تجاوز الميزانية بكثير",
 "だいぶたい": "كَتِيبَة (الجيش أو القطعة منه مجتمعة؛ جماعة الخيل إذا أغارت من المائة إلى الأَلف)",
 "だいぶつ": "اِسْتَبْدَلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "だいぶつべんさい": "إبراء واستيفاء, تسوية الرضا (تسوية دين عن طريق دفع أقل من المبلغ المطلوب مقابل إطفاء الدين)",
 "だいぶぶん": "غَالِبِيَّة, أَغْلَبِيّة",
 "だいぶん": "إلى حد كبير, بشكل جوهري (إلى مدى أو درجة كبيرة)\nمثال: أخشى أن الفيلم تجاوز الميزانية بكثير",
 "だいへんかく": "ثَوْرَة, اِنْقِلَاب / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "だいへんしん": "تجديد شامل, تغيير المظهر (إعادة بناء وتجديد كامل لشيء ما) / تجميل شامل, نيو لوك (علاج تجميلي شامل (يتضمن تسريحة شعر ومستحضرات تجميل وملابس) يهدف إلى تغيير أو تحسين مظهر الشخص)\nمثال: خضع الحي المتدهور لتجديد شامل",
 "だいべん": "مَثَّلَ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / أداء, تنفيذ (فعل الأداء؛ القيام بشيء بنجاح؛ استخدام المعرفة بدلاً من مجرد امتلاكها) / تطبيق, تنفيذ (عملية إنجاز هدف ما أو تنفيذ أمر ما)\nمثال: انتقدوا أداءه كرئيس للبلدية / بِرَاز, سَلْح",
 "だいべんしゃ": "نَاطِق رَسْمِيّ, مُتَحَدِّث رَسْمِيّ",
 "だいべんじょ": "مِرْحَاض, تواليت",
 "だいほうかん": "السيد المستشار, اللورد المستشار (أعلى ضابط للتاج يرأس القضاء ويترأس مجلس اللوردات)",
 "だいほうし": "بوغ كبير (أكبر نوعي الأبواغ المنتجة في النباتات متباينة الأبواغ؛ يتطور في البويضة إلى نبات مشيجي أنثوي)",
 "だいほうしのう": "محفظة بوغية كبيرة (بنية نباتية تنتج أبواغاً كبيرة)",
 "だいほっさ": "صرع كبير, نوبة معممة (نوبة يصبح خلالها المريض فاقداً للوعي ويعاني من تشنجات في جميع أنحاء الجسم) / صرع كبير, نوبة توترية رمعية (صرع تتضمن نوباته فقدان الوعي وتشنجات توترية في العضلات يتبعها ارتعاش عام)",
 "だいほん": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / سِينَارْيُو / خَطّ, حَرْف (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: تعبت من الكتابة.",
 "だいほんさっか": "كاتب نصوص (شخص يكتب نصوصاً للمسرحيات أو الأفلام أو الدراما الإذاعية)",
 "だいぼ": "عَرَّابَة, إِشْبِينَة",
 "だいぼうらく": "غوص, هبوط حاد (هبوط حاد بمقدمة الطائرة للأسفل) / سقوط مدو, هبوط حاد (انخفاض حاد ومفاجئ أو تدهور سريع)\nمثال: شهد السهم هبوطاً حاداً",
 "だいみょうりょこう": "رحلة رسمية (رحلة يقوم بها مسؤول على نفقة الدولة) / رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة) / جنكت, خثرة حليب (تحلية مصنوعة من الحليب المحلى المتخثر بالمنفحة)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "だいめ": "إِلَى أَقْصَى حَدٍّ, اَلنُّونِيّ (الأخير أو الأعظم في سلسلة كبيرة غير محددة)",
 "だいめい": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / عُنْوَان (عُنْوَان) / عِنْوَان (عُنْوَان) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "だいめいし": "ضَمِير, ضَمَائِرُ (بمعنى اسم الفاعل ضَامِر، يستخدم للمبالغة؛ العنب الذابل لأنه قد ضمر)\nمثال: وكان الضحايا من الرجال والنساء والأطفال الأبرياء. ورغم ذلك اختارت القاعدة بلا ضمير قتل هؤلاء الأبرياء وتباهت بالهجوم وأكدت إلى الآن عزمها على ارتكاب القتل مجددا وبأعداد ضخمة / مُرَادِف (اسم فاعل من الفعل \"رَادَفَ\"؛ (في علم دلالة الألفاظ) كلمة لها المعنى نفسه أو معنى قريب له لكلمة أخرى في اللغة)\nمثال: الانفصالي مرادف للعاهرة.",
 "だいめいなし": "بِلَا لَقَب, غَيْر نَبِيل (لا ينتمي إلى طبقة النبلاء)",
 "だいもう": "ثرب كبير (جزء من الصفاق متصل بالمعدة والقولون ويغطي الأمعاء)",
 "だいもうまく": "برقع, غشاء جنيني (الغشاء الداخلي للأجنة في الفقاريات العليا (خاصة عندما يغطي الرأس عند الولادة)) / ثرب كبير (جزء من الصفاق متصل بالمعدة والقولون ويغطي الأمعاء)",
 "だいもく": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / عُنْوَان (عُنْوَان) / عِنْوَان (عُنْوَان) / اِسْم (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة. / مَوْضُوع, مَوَاضِيع",
 "だいやく": "اِسْتَبْدَلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "だいよう": "إحلال, استبدال (عملية وضع شيء أو شخص مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر)\nمثال: استبدال الدم المفقود بنقل دم المتبرع / بِرَاز, سَلْح",
 "だいようご": "اِسْتَبْدَلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "だいようひん": "اِسْتَبْدَلَ (اتخذ شيئا بدلا من شيء)\nمثال: استبدل ياني حنفية المطبخ.",
 "だいよく": "طَمَع, شُحُّ",
 "だいよじちゅうとうせんそう": "حرب أكتوبر (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "だいよん": "رَابِع, رَابِعَة (رابعوا الحمِلَ مرابعة: أدخلوا المِربَعة تحتهُ)\nمثال: زيري هو الرابع.",
 "だいよんい": "إِنْفَحَة",
 "だいよんかいきゅう": "السلطة الرابعة, الصحافة (الصحافة، بما في ذلك الصحفيون وكتاب الصحف والمصورون)",
 "だいよんのうしつ": "بطين رابع (بطين غير منتظم بين البطين الثالث والقناة المركزية للحبل الشوكي)",
 "だいら": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "だいらんせん": "شجار, عراك (قتال صاخب ومشاغب)",
 "だいり": "تمثيل (نشاط يحل محل شيء ما أو يؤدي إلى معادل له) / تَمْثِيل, نِيَابَة (فعل التمثيل؛ الوقوف نيابة عن شخص أو مجموعة والتحدث بسلطة نيابة عنهم) / تجسيد, تمثيل (إبداع يمثل تجسيداً مرئياً أو ملموساً لشخص أو شيء ما) / تمثيل, تمثيل نيابي (الحق في أن يتم تمثيله بواسطة مندوبين لهم صوت في هيئة تشريعية ما) / إِنَابَة, اِسْتِنَابَة (عند السالكين: الرجوع عن الغَفْلَة إلى الذِّكْر)",
 "だいりいにんじょう": "توكيل رسمي, وكالة (صك قانوني يخول شخصاً ما بالتصرف كوكيل للمانح)",
 "だいりぎょう": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "だいりぎょうしゃ": "فَاعِل (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "だいりけん": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "だいりしゃ": "إِنَابَة, اِسْتِنَابَة (عند السالكين: الرجوع عن الغَفْلَة إلى الذِّكْر)",
 "だいりせき": "رُخَام / بِلْيَة",
 "だいりせんそう": "حَرْب بِالوِكَالَة (حَرَبَ (حربه) بالحربة حربا: طعنه بها؛ حَرَبَ (ه) حربا: سلبه جميع ما يملك)\nمثال: بوتين مجرم حرب.",
 "だいりてん": "فَاعِلِيَّة / وِكَالَة / وَكَالَة / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "だいりにん": "إِنَابَة, اِسْتِنَابَة (عند السالكين: الرجوع عن الغَفْلَة إلى الذِّكْر)",
 "だいりはは": "أُمّ بَدِيلَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "だいりぼ": "أُمّ بَدِيلَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "だいりぼくし": "نائب كاهن (كاهن كاثوليكي ينوب عن رجل دين آخر أعلى رتبة) / كاهن الرعية ((كنيسة إنجلترا) رجل دين يُعين للعمل ككاهن لرعية) / كاهن الكنيسة ((الكنيسة الأسقفية) رجل دين مسؤول عن كنيسة صغيرة)",
 "だいりゅうこう": "ذراع التطويل, عوارضة (أي من الصواري أو الأعمدة الأفقية المتنوعة المستخدمة لتمديد أسفل الشراع أو لمناولة البضائع أو في الإرساء) / بوم, ذراع الميكروفون (عمود يحمل ميكروفوناً علوياً مسلطاً فوق موقع تصوير فيلم أو تلفزيون) / دوي, رعد (ضجيج عميق طويل وعالٍ) / رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال))\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "だいりょうけいこつ": "عظم مربعي (عظم الرسغ على جانب الإبهام من اليد الذي يتمفصل مع العظم السنعي الأول والثاني)",
 "だいりょうじゅう": "طرائد كبيرة (حيوانات كبيرة يتم اصطيادها للرياضة)",
 "だいれん": "دَالْيَان",
 "だいろく": "سَادِس, سَادِسَة / سُدْس",
 "だいろっかん": "بصيرة, حاسة سادسة (إدراك الطبيعة الداخلية للأشياء بشكل حدسي)",
 "だいわ": "عارضة (الجزء السفلي من السطح المعمد؛ يرتكز مباشرة على تيجان الأعمدة) / إطار الباب (الإطار الزخرفي حول الباب أو النافذة)",
 "だいわくせい": "كَوْكَب ((علم الفلك) أي من الأجرام السماوية الكبيرة التسعة في النظام الشمسي التي تدور حول الشمس وتلمع بضوء منعكس) / عِمْلَاق غَازِيّ, كَوْكَب غَازِيّ (أي من الكواكب الأربعة الخارجية في النظام الشمسي؛ أكبر بكثير من الأرض وغازي الطبيعة (مثل المشتري))",
 "だいカッコ": "قوس مربع (إحدى علامتي الترقيم  المستخدمة لتطويق مادة نصية)",
 "だいスター": "بارع, جهبذ (شخص يتمتع بمهارة مذهلة في أي مجال)",
 "だいヒット": "بلوك باستر, عمل ضخم النجاح (نجاح غير عادي مع شعبية واسعة ومبيعات ضخمة (خاصة لفيلم أو مسرحية أو تسجيل أو رواية))",
 "だいピンチ": "ضائقة شديدة, ظروف يائسة (حالة من الضيق الشديد)",
 "だいブリテン": "بِرِيطَانِيَا الْعُظْمَى (اسم غير رسمي لِلْمَمْلَكَةِ الْمُتَّحِدَةِ؛ (منذ القرن السابع عشر) الإِمْبِرَاطُورِيَّة الْبِرِيطَانِيَّة)\nمثال: أنا من بريطانيا.",
 "だいブリテンとう": "بِرِيطَانِيَا الْعُظْمَى (اسم غير رسمي لِلْمَمْلَكَةِ الْمُتَّحِدَةِ؛ (منذ القرن السابع عشر) الإِمْبِرَاطُورِيَّة الْبِرِيطَانِيَّة)\nمثال: أنا من بريطانيا.",
 "だうま": "حصان حمل (حصان عمل يستخدم كحيوان حمل)",
 "だえき": "لُعَاب, رِيق",
 "だえきせん": "غُدّة لُعَابِيّة",
 "だえきぶんぴ": "إفراز اللعاب, إلعاب (إفراز اللعاب)",
 "だえきぶんぴつ": "إفراز اللعاب, إلعاب (إفراز اللعاب)",
 "だえん": "إِهْلِيلَج, قَطْعٌ نَاقِص",
 "だえんきかがく": "هندسة إهليلجية, هندسة ريمانية ((رياضيات) هندسة لا إقليدية تعتبر الفضاء مثل كرة والخط مثل دائرة عظمى)",
 "だえんぎんが": "مَجَرَة إِهْلِيجِيَّة (نجوم كثيرة لا تدرك بمجرد البصر، وعندما ينتشر ضوؤها فيُرى كأنه بقعة بيضاء (أي: مصادر ضوء كثيرة بحيث يبدو ضوئها كوهج بدلاً من أن يَبدو كل نجم واضحٍ…؛ باب السماء، وهي البياض الذي يَعبر السماء ويَقع بين النّسرَين (المقصود هنا هو مجرة دَرْب التّبانَة…)\nمثال: أنا بطل المجرة.",
 "だえんめん": "إِهْلِيلَجِيّ, شِبْهُ كُرَوِيّ (ذو طبيعة أو شكل القَطْع الناقص المجسَّم) / مجسم بيضوي, مجسم قطع ناقص (سطح مقاطعه المستوية كلها قطوع ناقصة أو دوائر)\nمثال: الأرض عبارة عن مجسم بيضوي",
 "だか": "كَمِّيَّة, مِقْدَار",
 "だから": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "だからって": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "だからといって": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "だからと言って": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "だからよ": "بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى.",
 "だかん": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / تحويل, نقطة إضافية (رمية حرة ناجحة أو محاولة لكسب نقطة بعد التاتش داون) / تحويل (عملية التغيير من استخدام أو وظيفة أو غرض إلى آخر) / تحويل (فعل استبدال نوع من المال أو الأوراق المالية بآخر) / مِلَفّ, وَشِيعَة / وَشِيعَة",
 "だが": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / لٰكِن, وَلٰكِنْ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / إِلَّا, سِوًى (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / إلَّا, غَيْرَ (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لكن لديك أطفال.",
 "だがしかし": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / لٰكِن, وَلٰكِنْ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / إِلَّا, سِوًى (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / إلَّا, غَيْرَ (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لكن لديك أطفال.",
 "だがしや": "ثَانَوِيّ, صَغِير (ذو أهمّيّة ضئيلة)",
 "だがっき": "آلة إيقاعية (آلة موسيقية يتم فيها إنتاج الصوت عن طريق ضرب شيء بآخر)",
 "だき": "بُطْء / اِزْدِرَاء",
 "だきあわせ": "رابط, وصلة (مثبت يعمل على ضم أو توصيل الأشياء)\nمثال: الجدران متماسكة بروابط معدنية توضع في الملاط الرطب أثناء البناء",
 "だきあわせはんばい": "رابط, وصلة (مثبت يعمل على ضم أو توصيل الأشياء)\nمثال: الجدران متماسكة بروابط معدنية توضع في الملاط الرطب أثناء البناء",
 "だきあわせる": "ضَمَّ, جَمَعَ (جَمَعَ، لَمَّ؛ وَصَلَ الشيءَ بالشيءِ)\nمثال: ضم سامي رأس ليلى إلى صدره.",
 "だきいぬ": "كلب حضن (كلب صغير وأليف بما يكفي ليحمل في الحضن)",
 "だきかかえる": "مَسَكَ, مسك",
 "だきしめる": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "だきすべき": "بَشِع, مَقِيت (مكروه بشكل لا لبس فيه) / بَشِع, مَقِيت (مسيء للعقل ومثير للنفور)",
 "だきつく": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "だきゅう": "صدم, ضرب (فعل ملامسة شيء لآخر)\nمثال: أدى الضرب المتكرر إلى ظهور كدمة كبيرة",
 "だきょう": "حَل وَسَط, تَسْوِيَة (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / يخترق\nمثال: حل زيري المشكل.",
 "だきょる": "أَذْعَنَ ((أَذْعَنَ): انْقَادَ وسلس وَيُقَال: أذعن بِالْحَقِّ: أقرّ بِهِ)",
 "だきよせる": "اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق",
 "だく": "خبب (مشية أسرع من المشي؛ تضرب الأرجل المتقابلة قطرياً الأرض معاً) / هرولة (وتيرة جري بطيئة) / ترجمة حرفية مساعدة (ترجمة حرفية تُستخدم في دراسة لغة أجنبية (غالباً ما تُستخدم بشكل غير مشروع للغش)) / تروتسكي (راديكاليون يدعمون نظرية تروتسكي بأن الاشتراكية يجب أن تتأسس في جميع أنحاء العالم من خلال الثورة المستمرة) / اِتِّفَاق, تَوَافُق / إِقْرَار / اِتِّفَاق, اِتِّفَاقِيَّة / النُّرْوِيج (دولة تغطي مساحتُها الشطرين الشمالي والغربي من شبه الجزيرة الإسكندنافية التي تقع في شمال قارة أوروبا؛ اسمها الرسمي مملكة النرويج، وعاصمتها أوسلو)\nمثال: أنا من النرويج. / اِحْتَضَنَ, عَانَقَ / اِحْتِضَان, عِنَاق / حِضْنَة, صغار (صغار حيوان يتم رعايتهم في وقت واحد)",
 "だくあし": "خبب (مشية أسرع من المشي؛ تضرب الأرجل المتقابلة قطرياً الأرض معاً) / هرولة (وتيرة جري بطيئة) / ترجمة حرفية مساعدة (ترجمة حرفية تُستخدم في دراسة لغة أجنبية (غالباً ما تُستخدم بشكل غير مشروع للغش)) / تروتسكي (راديكاليون يدعمون نظرية تروتسكي بأن الاشتراكية يجب أن تتأسس في جميع أنحاء العالم من خلال الثورة المستمرة)",
 "だくおん": "صوت مجهور (صوت كلامي مصحوب بصوت من الحبال الصوتية)",
 "だくさん": "كَافٍ (كِفَايَة، يَكْفِي، كَافِ؛ مَه، كَفَى) / تَمَامًا / مَه, كَفَى (اسم فعل بمعنى إنْكَفِفْ أو تَوَقَّفْ، ويقال مَهٍ أيضاً)\nمثال: خسر كافة ممتلكاته.",
 "だくだく": "مُطِيع, مُذْعِن / خفقاً, دقا (وصف لضربات إيقاعية (مثل القلب)) / بخطوات خفيفة, طقطقة (كما في صوت الخطوات الخفيفة)\nمثال: قلبه كان يخفق",
 "だくど": "عَكَارَة, كُدْرَة (كدرة ناتجة عن إثارة الرواسب أو وجود جسيمات غريبة معلقة)",
 "だくぼく": "تَفَاوُت, عَدَم اسْتِوَاء (صفة عدم التوازن) / تَبَايُن, تَفَاوُت (صفة كون الشيء غير مستوٍ وتنقصه الوحدة)",
 "だくやくしゃ": "واعد (شخص يقطع وعدًا)",
 "だく足": "خبب (مشية أسرع من المشي؛ تضرب الأرجل المتقابلة قطرياً الأرض معاً) / هرولة (وتيرة جري بطيئة) / ترجمة حرفية مساعدة (ترجمة حرفية تُستخدم في دراسة لغة أجنبية (غالباً ما تُستخدم بشكل غير مشروع للغش)) / تروتسكي (راديكاليون يدعمون نظرية تروتسكي بأن الاشتراكية يجب أن تتأسس في جميع أنحاء العالم من خلال الثورة المستمرة)",
 "だけ": "وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي.\nمثال: 来たのはメアリーだけだった。 — لم يأت أحد سوى ماري. / جَبَل (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين) / طُور\nمثال: منزلي في الجبل. / قمة جبل (ذروة الجبل)",
 "だけしか": "اِسْتَثْنَى (أن يشمل الكُلّ إلا جزء، ولا يكون إلا إذا كان الجزءُ جزءًا من الكل) / إِلَّا, بِاسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / مثال: لا أعرف إلا هذا.",
 "だけつ": "مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "だけでいい": "عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "だけでなく": "بِالْإِضَافَة إِلَى",
 "だけど": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / لٰكِن, وَلٰكِنْ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / إِلَّا, سِوًى (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / إلَّا, غَيْرَ (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لكن لديك أطفال.",
 "だけども": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / لٰكِن, وَلٰكِنْ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / إِلَّا, سِوًى (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / إلَّا, غَيْرَ (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لكن لديك أطفال.",
 "だけのことはある": "جَدِيرٌ بِالاهْتِمَامِ (ذُو قِيمَةٍ كَافِيَةٍ تُبَرِّرُ اسْتِثْمَارَ الوَقْتِ أَوِ الاهْتِمَامِ)",
 "だけの事はある": "جَدِيرٌ بِالاهْتِمَامِ (ذُو قِيمَةٍ كَافِيَةٍ تُبَرِّرُ اسْتِثْمَارَ الوَقْتِ أَوِ الاهْتِمَامِ)",
 "だけれども": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / لٰكِن, وَلٰكِنْ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / إِلَّا, سِوًى (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / إلَّا, غَيْرَ (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لكن لديك أطفال.",
 "だけん": "ضربة مفتاح (ضربة مفتاح؛ ضغطة واحدة على مفتاح في لوحة المفاتيح)\nمثال: تم استخدام عدد ضربات المفاتيح كمقياس للعمل / هَجِين",
 "だげき": "نَفَخَ (أَطْلَقَ الريح من فمه؛ زَفَرَ أو هَبَّ بشدة) / ضَرْبَة (المرة الواحدة من الضَرْب؛ اللطمو أو الدقة أو الصكّة؛ ضربة طبل: دقة واحدة منه)\nمثال: يداك أوكتا وفوك نفخ / ضرب الكرة ((بيسبول) محاولة الضارب للوصول إلى القاعدة) / حشوة قطنية, لباد (حشو مصنوع من لفات أو صفائح من الصوف القطني أو الألياف الصناعية)",
 "だげきりつ": "مُعَدَّل الضَّرْب ((البيسبول) مقياس لأداء الضارب؛ عدد الضربات القاعدية مقسوماً على عدد المرات الرسمية في المضرب) / مُعَدَّل النَّجَاح ((امتداد لمصطلح البيسبول) نسبة المرات التي ينجح فيها جهد ما)\nمثال: كان لدى تيد ويليامز ذات مرة معدل ضرب أعلى من .400",
 "だこ": "مبصقة (وعاء للبصق (عادة في مكان عام))",
 "だこう": "تَعَرَّجَ / سَاحِل, شَاطِئ",
 "だこく": "نَقْشْ (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان) / لَكْمَة / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة) / خَرَّامَة\nمثال: لكم اشتقت إليك!",
 "ださい": "غَيْر رَائِج, مُمِلّ ((عامية) غير عصري وممل)",
 "ださお": "أحمق, غبي (شخص غبي وبليد وسخيف)",
 "ださく": "تُرَّهَات, كَلَام تَافِه (حديث أو كتابة لا معنى لها) / قمامة, نفايات (مادة عديمة القيمة يجب التخلص منها)",
 "ださださ": "أَعْرَج / أَكْسَح / أَشَلّ ((أَشَلَّ) فلانٌ: أصَابه الشَّلَل؛ (أَشَلَّ) اللهُ فلانًا أَو يَدَهُ: أصابَها بالشَّلَل)",
 "ださん": "حَسْب, مُحَاسَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "ださんてき": "داهِيَة, مُتَآمِر (حاذِق في التَّدْبير والتَّخْطيط بِمَكْر وحِيلَة)",
 "ださ男": "أحمق, غبي (شخص غبي وبليد وسخيف)",
 "だしおくれ": "مُتَأَخِّر, مُتَلَكِّئ (بعد الوقت المتوقّع أو المعتاد؛ مُؤَجَّل)",
 "だしおしむ": "بُغْض, ضَغِينَة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "だしがら": "باحة, ساحة (الأرض المسيجة المحيطة بمنزل أو مبنى آخر) / أساس, بينة (أساس الاعتقاد أو عدم التصديق؛ المعرفة التي يبنى عليها الاعتقاد) / سبب, مبرر (مبرر لوجود أو حدوث شيء ما) / أرض, ساحة (قطعة أرض تم تنظيفها لأغراض خاصة (مثل الترفيه أو الدفن إلخ))\nمثال: كان منزلاً صغيراً بلا فناء تقريباً",
 "だししぶる": "بُغْض, ضَغِينَة (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "だしじる": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَقَة، وهي أخص من المرَق)",
 "だしてくれる": "أَخْرَجَ",
 "だしぬけ": "فَجْأَةً",
 "だしみせ": "كُشْك (هو الكِشْك في بعض اللهجات العربية؛ شبه رِوَاق بارز عن مساواة بقية البيت) / حُجَيْرَة, كَابِينَة",
 "だしもの": "بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / بَرْمَجَ, وَضَعَ بَرْنَامَجًا / بَرْمَجَ\nمثال: نشط البرنامج الآن. / قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "だしゃ": "عجين سائل (خليط سائل أو شبه سائل، مثل الدقيق والبيض والحليب، يستخدم في الطهي) / ضارب, ضارب الكرة ((في البيسبول) لاعب الكرة الذي يقوم بضرب الكرة بالمضرب)",
 "だしゅ": "ربان, موجه الدفة (رجل يوجه السفينة)",
 "だしわけ": "فَرَّقَ",
 "だしん": "آلَة إِيقَاعِيَّة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "だしんき": "مطرقة المنعكسات, مطرقة طبية ((طب) مطرقة صغيرة برأس مطاطي تستخدم في فحوصات الطرق على الصدر واختبار ردود الفعل)",
 "だしんづち": "مطرقة المنعكسات, مطرقة طبية ((طب) مطرقة صغيرة برأس مطاطي تستخدم في فحوصات الطرق على الصدر واختبار ردود الفعل)",
 "だし汁": "مَرَق, مَرَقَة (الطَعَام سائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَقَة، وهي أخص من المرَق)",
 "だじゃく": "لَا مُبَالٍ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة. / ضَعِيف",
 "だじゅう": "حيوان حمل, دابة حمل (حيوان (مثل البغل أو الحمار أو الحصان) يستخدم لحمل الأحمال)",
 "だじゅん": "ترتيب الضاربين ((بيسبول) قائمة بالضاربين بالترتيب الذي سيضربون به)\nمثال: قدم المديرون بطاقاتهم للحكم عند اللوحة الرئيسية",
 "だじょうかん": "وزارة الخارجية, وزارة الخارجية الأمريكية (الإدارة الفيدرالية في الولايات المتحدة التي تضع وتحافظ على السياسات الخارجية)\nمثال: تأسست وزارة الخارجية عام 1789",
 "だす": "أَخْرَجَ / أَنْتَجَ (أَنْشَأَ شَيْئَا من شَيْءٍ، وَلَّدَه؛ الفرس أو الناقة: وَلَدَت) / نَشَرَ, أَصْدَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل. / أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف) / منحرف (شخص ينحرف سلوكه عما هو مقبول خاصة في السلوك الجنسي)",
 "だする": "فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف) / منحرف (شخص ينحرف سلوكه عما هو مقبول خاصة في السلوك الجنسي)",
 "だせい": "عَطَالَة",
 "だせいてき": "مِيكَانِيكِيّ",
 "だせぇ": "غَيْر رَائِج, مُمِلّ ((عامية) غير عصري وممل)",
 "だせえ": "غَيْر رَائِج, مُمِلّ ((عامية) غير عصري وممل)",
 "だせき": "مربع الضارب (منطقة في ملعب البيسبول (على جانبي القاعدة الرئيسية) محددة بخطوط يجب أن يقف داخلها الضارب عند اللعب)",
 "だせん": "ترتيب الضاربين ((بيسبول) قائمة بالضاربين بالترتيب الذي سيضربون به)\nمثال: قدم المديرون بطاقاتهم للحكم عند اللوحة الرئيسية / غُدّة لُعَابِيّة",
 "だせー": "غَيْر رَائِج, مُمِلّ ((عامية) غير عصري وممل)",
 "だそく": "تكرار زائد, حشو (تكرار فعل ما بلا حاجة) / زيادة, فائض (سمة كون الشيء زائداً وغير مطلوب) / تكرار احتياطي ((إلكترونيات) تصميم نظام يكرر المكونات لتوفير بدائل في حالة فشل أحد المكونات) / تكرار زائد, حشو (تكرار الرسائل لتقليل احتمالية الأخطاء في الإرسال)\nمثال: خلق استخدام الروبوتات الصناعية فائضاً في العمالة",
 "だたい": "خِدَاج, إِجْهَاض",
 "だたいやく": "مُجْهِض (يتسبّب في الإجهاض) / دواء مجهض, مُجهض (دواء (أو عامل كيميائي آخر) يسبب الإجهاض)",
 "だたっぴろい": "مُتَرَامِي الأَطْرَاف, مُتَنَاثِر (يَمْتَدُّ فِي اتِّجَاهَاتٍ مُخْتَلِفَةٍ أَوْ مُوَزَّعٌ بِشَكْلٍ غَيْرِ مُنْتَظِم) / انبطاح, تمدد (وضعية غير أنيقة مع تباعد الذراعين والساقين)",
 "だだ": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة) / مُفْرِط, زَائِد",
 "だだこねる": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "だだっぴろい": "مُتَرَامِي الأَطْرَاف, مُتَنَاثِر (يَمْتَدُّ فِي اتِّجَاهَاتٍ مُخْتَلِفَةٍ أَوْ مُوَزَّعٌ بِشَكْلٍ غَيْرِ مُنْتَظِم) / انبطاح, تمدد (وضعية غير أنيقة مع تباعد الذراعين والساقين)",
 "だだっ広い": "مُتَرَامِي الأَطْرَاف, مُتَنَاثِر (يَمْتَدُّ فِي اتِّجَاهَاتٍ مُخْتَلِفَةٍ أَوْ مُوَزَّعٌ بِشَكْلٍ غَيْرِ مُنْتَظِم) / انبطاح, تمدد (وضعية غير أنيقة مع تباعد الذراعين والساقين)",
 "だだびろい": "مُتَرَامِي الأَطْرَاف, مُتَنَاثِر (يَمْتَدُّ فِي اتِّجَاهَاتٍ مُخْتَلِفَةٍ أَوْ مُوَزَّعٌ بِشَكْلٍ غَيْرِ مُنْتَظِم) / انبطاح, تمدد (وضعية غير أنيقة مع تباعد الذراعين والساقين)",
 "だだをこねる": "أنين, تباكي (شكوى يتم التلفظ بها بطريقة شاكية وحزينة)",
 "だだ広い": "مُتَرَامِي الأَطْرَاف, مُتَنَاثِر (يَمْتَدُّ فِي اتِّجَاهَاتٍ مُخْتَلِفَةٍ أَوْ مُوَزَّعٌ بِشَكْلٍ غَيْرِ مُنْتَظِم) / انبطاح, تمدد (وضعية غير أنيقة مع تباعد الذراعين والساقين)",
 "だち": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "だちとも": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "だちょう": "نَعَامَة / ظَلِيم\nمثال: ダチョウは空を飛べない。 — لا يمكن للنعام أن يطير.",
 "だちん": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "だっかい": "شِفَاء, تَعَافِي / اِنْسِحَاب / إزالة الكلس, نزع الكلس (فقدان الكالسيوم من العظام أو الأسنان)",
 "だっかく": "اسْتِئْصَالِيّ, سَلْخِيّ (يميل إلى الانسلاخ أو الاستئصال عند درجات حرارة عالية جدًّا) / أبليتيفي, خاص بحالة الجر (يتعلق بحالة الجر أو الإبعاد (في اللغات اللاتينية)) / حالة الأبلاتيف, حالة المصدرية (الحالة التي تشير إلى الفاعل في الجمل المبنية للمجهول أو الأداة أو الطريقة أو مكان الفعل الذي يصفه الفعل) / استئصال كامل (إزالة جراحية لشيء ما دون قطعه)\nمثال: استئصال الورم بالكامل",
 "だっかん": "استرداد, استعادة (فعل استعادة شيء ما) / استرداد الأرباح (استيلاء قانوني من قبل الحكومة على الأرباح التي تتجاوز مبلغاً ثابتاً)",
 "だっかんさ": "إزالة التحسس (عملية تقليل الحساسية)\nمثال: تتحسر على عدم اكتراث المجتمع التدريجي لفظائع كراهية الأجانب",
 "だっきゃく": "هَزَمَ, غَلَبَ",
 "だっきゅう": "اِنْخِلَاع, خَلْع",
 "だっこ": "إبقاء, احتفاظ (فعل الاحتفاظ بشيء ما) / أملاك, مقتنيات (شيء مملوك؛ أي حيازة ملموسة أو غير ملموسة يمتلكها شخص ما)\nمثال: تلك القبعة ملكي",
 "だっこく": "دِيَاسَة",
 "だっこくき": "آلة درس, دراسة (آلة زراعية لفصل البذور أو الحبوب عن القشور والقش)",
 "だっしにゅう": "حَلِيب خَالِي الدَسَم (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "だっしめん": "قطن طبي, قطن ماص (قطن أصبح ماصاً عن طريق إزالة الشمع الطبيعي)",
 "だっしゅ": "غَصْب",
 "だっしゅうざい": "مُزِيل اَلْعَرَق, مُزِيل اَلرَّائِحَة",
 "だっしゅつ": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف. / تدلي, هبوط (انزلاق أو سقوط عضو من مكانه (مثل الرحم))",
 "だっしゅつこう": "كوة نجاة, مخرج طوارئ (فتحة توفر وسيلة للهروب في حالات الطوارئ)",
 "だっしゅつそくど": "سرعة الإفلات",
 "だっしんき": "آلية الانفلات, ميزان الساعة (جهاز ميكانيكي ينظم الحركة)",
 "だっすい": "جَفاف, تَجْفاف / غزل (صنع الخيوط) / تدلي, هبوط (انزلاق أو سقوط عضو من مكانه (مثل الرحم))",
 "だっすいき": "مجفف (جهاز يقوم بإزالة الرطوبة)",
 "だっすいしょう": "جَفاف, تَجْفاف",
 "だっすいしょうじょう": "جَفاف, تَجْفاف",
 "だっせえ": "غَيْر رَائِج, مُمِلّ ((عامية) غير عصري وممل)",
 "だっせん": "انحراف القطار, خروج عن السكة (حادث يخرج فيه القطار عن مساره) / انحراف عن المسار, خروج عن الطريق (الابتعاد عن المسار الرئيسي للرحلة) / انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / اسْتِطْرَاد, جُمْلَة مُعْتَرِضَة (رسالة تخرج عن الموضوع الرئيسي)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "だっせんこうい": "اِنْزِيَاغ / زَيْغ (زَيَّغَ (زيغه): عوجه وأقام زيغه وأصلح عوجه)",
 "だっせー": "غَيْر رَائِج, مُمِلّ ((عامية) غير عصري وممل)",
 "だっそ": "آكِلَة, غَنْغْرِينَة",
 "だっそう": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف.",
 "だっそうしゃ": "فار (شخص يهرب)",
 "だっそうへい": "هَارِب",
 "だったい": "اِنْسِحَاب",
 "だったりして": "رُبَّمَا / مِن اَلْمُمْكِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / لَعَلَّ (يفيد التوقع مع الترجي؛ يفيد التوقع مع الإشفاق والخوف)\nمثال: يا لها من جملة!",
 "だっちゃく": "انتزاز, فصل الامتزاز (التحول من حالة الامتزاز على سطح ما إلى حالة غازية أو سائلة)",
 "だっちょうたい": "طنف, كابول ((في العمارة) دعامة مثلثة من الطوب أو الحجر (عادة ما تكون ذات امتداد بسيط)) / جملون, دعامة (هيكل من العوارض (العوارض الخشبية والأعمدة والدعامات) تشكل هيكلاً صلباً يدعم سقفاً أو جسراً أو هيكلاً آخر) / حزام الفتق ((طبياً) ضمادة تتكون من وسادة وحزام؛ ترتدى لتثبيت الفتق في مكانه عن طريق الضغط)",
 "だって": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / لٰكِن, وَلٰكِنْ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / إِلَّا, سِوًى (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / إلَّا, غَيْرَ (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لكن لديك أطفال. / مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس. / أَيْضًا, كَذٰلِكَ / أَكْثَرَ مِنَ اللّازِمِ, لِلْغايةِ",
 "だっぴ": "انسلاخ, طرح الريش (الانسلاخ الدوري للبشرة في المفصليات أو الجلد الخارجي في الزواحف)",
 "だっぷん": "تبرز, تغوط (إخراج الفضلات البرازية عبر فتحة الشرج)",
 "だっぽうドラッグ": "عقار مصمم (عقار ذو تأثير نفسي تم تصنيعه عمداً لتجنب قوانين مكافحة المخدرات؛ يحاكي تأثيرات عقار محظور؛ تم تعديل القانون في عام 1986 لحظر العقاقير المصممة)",
 "だつ": "قُضَاعَة / ثَعْلَب الْمَاء (أي فصيلة من فصائل الكلبيّات القارتة (أكلة للحوم والنبات) الصغيرة الحجم، والبالغ عددها 27 نوعاً. يقصد العامّة من كلمة ثعلب في العادة الثعلب الأحمر…؛ شخص ماكر)\nمثال: أردى الصياد الثعلب.",
 "だつい": "تَعَرَّى, اِنْجَرَدَ / تَعَرَّى",
 "だついしつ": "غُرْفَة الْمَلَابِس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "だついしょ": "مَنْزَع / غُرْفَة الْمَلَابِس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "だついじょ": "مَنْزَع / غُرْفَة الْمَلَابِس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
