 "そして": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "そしてちちになる": "الْوَلَدُ سُرّ أَبِيهِ",
 "そして父になる": "الْوَلَدُ سُرّ أَبِيهِ",
 "そしゃく": "عقد إيجار (عقد يمنح استخدام أو شغل الممتلكات خلال وقت محدد مقابل مبلغ محدد) / مضغ (عض وطحن الطعام في فمك ليصبح ناعماً بما يكفي للبلع) / هَضْم",
 "そしゃくうんどう": "مضغ (عض وطحن الطعام في فمك ليصبح ناعماً بما يكفي للبلع)",
 "そしゃくけん": "عقد إيجار (عقد يمنح استخدام أو شغل الممتلكات خلال وقت محدد مقابل مبلغ محدد)",
 "そしゅ": "غاية, غَرَض",
 "そしょう": "دَعْوَى (إدِّعَاء؛ دُعَاء)\nمثال: رفضت الضحية إقامة دعوى قضائية. / انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء))\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً / خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "そしょうきろく": "تَسْجِيل, مُدَوَّنَة\nمثال: سجل سامي وصوله.",
 "そしょうざた": "دَعْوَى (إدِّعَاء؛ دُعَاء)\nمثال: رفضت الضحية إقامة دعوى قضائية.",
 "そしょうじけん": "دَعْوَى (إدِّعَاء؛ دُعَاء)\nمثال: رفضت الضحية إقامة دعوى قضائية.",
 "そしょうてつづき": "إجراءات قانونية, دعوى ((قانون) بدء سلسلة من الخطوات التي يتم من خلالها استدعاء الأحكام القانونية)",
 "そしょうとうじしゃ": "خصم, متقاضٍ ((قانون) طرف في دعوى قضائية؛ شخص متورط في التقاضي)\nمثال: المدعون والمدعى عليهم كلاهما متقاضون",
 "そしょうにん": "خصم, متقاضٍ ((قانون) طرف في دعوى قضائية؛ شخص متورط في التقاضي)\nمثال: المدعون والمدعى عليهم كلاهما متقاضون",
 "そしょうひよう": "أتعاب التقاضي, تكاليف قانونية (تعويض مالي للطرف الرابح عن نفقات التقاضي)",
 "そしょうほう": "قَانُون إِجْرَائِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "そしょく": "تَرْتِيب, تَنْظِيم (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية. / هَيْكَل / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل. / مَنْدِيل, مِنْدِيل",
 "そしらぬ": "مُتَصَنَّع, مُصْطَنَع (غَيْر حَقِيقِيّ؛ مُفْتَعَل)",
 "そしり": "لَامَ, اِسْتَنْكَرَ (لامَ يَلوم ، لُمْ ، لَوْمًا ، فهو لائم والجمع : لُوَّمٌ ، ولُيَّمٌ وهو أَيضاً…)\nمثال: لام سامي معلمه على فشله هو.",
 "そしりょう": "ألياف, ألياف غذائية (طعام نباتي خشن عسر الهضم منخفض العناصر الغذائية؛ كتلته تحفز التمعج المعوي)",
 "そしる": "تَشْهِير, اِفْتِرَاء",
 "そじ": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات) / ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود)\nمثال: ابتكار الخطط / أساس, عمل تمهيدي (إعداد أولي كأساس أو قاعدة)\nمثال: نحن مستعدون اليوم بسبب العمل التمهيدي الذي تم قبل عشر سنوات",
 "そじほう": "بِنَاء جُمْلَة, نَحْو (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "そじゅ": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان…)\nمثال: اللعنة حولها ومعرفة",
 "そじょう": "عَرِيضَة, طَلَب",
 "そすい": "قَنَاة / رُهَابِيّ المَاء (خائف بشكل غير طبيعي من الماء)",
 "そすいせい": "رُهَابِيّ المَاء (خائف بشكل غير طبيعي من الماء)",
 "そすう": "عَدَد أَوَّلِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "そせい": "وِلَادَة, مَوْلِد\nمثال: أعرف ذلك الولد. / مُطَابَقَة / مسقط الرأس, منشأ (المكان الذي نشأ فيه شيء ما أو تمت رعايته في بداية وجوده)\nمثال: مهد الحضارة / مُؤَلَّف, مُصَنَّف / إحياء, انبعاث (إعادة الشيء إلى النشاط والشهرة مرة أخرى)\nمثال: انتعاش التجارة / طواعية, قابلية للطرق (خاصية القابلية للتشكيل مادياً؛ خاصية الشيء الذي يمكن تشغيله أو طرقه أو تشكيله…) / مِيزَة\nمثال: محاسبة النفس صفة حميدة.",
 "そせいじゅつ": "اِنْعَاش",
 "そせいらんぞう": "إنتاج بالجملة, إنتاج ضخم (إنتاج كميات كبيرة من مادة موحدة (غالباً باستخدام تقنيات خط التجميع))",
 "そせき": "حجر الأساس (حجر يوضع في حفل لتدشين تأسيس مبنى جديد)",
 "そせきぞう": "أعمال البناء, بناء (حرفة البناء)",
 "そせん": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "そせんすうはい": "عبادة الأسلاف (عبادة الأجداد)\nمثال: معظم ممارسات عبادة الأسلاف المعروفة تاريخياً في اليابان هي تعديلات لعادات صينية",
 "そせんでんらい": "أَبَوِيّ, مَوْرُوث (مُتوارَث وفق قواعد راسخة (عادة قانونية) للإرث)",
 "そぜい": "ضَرِيبَة",
 "そぜいかいひ": "تجنب ضريبي (تقليل المسؤولية الضريبية إلى الحد الأدنى بطرق قانونية)",
 "そぜいかいひち": "مَلَاذ ضَرِيبِيّ (مَلْجَأ، مَأْوَى)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "そぜいひなんち": "مَلَاذ ضَرِيبِيّ (مَلْجَأ، مَأْوَى)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "そそ": "رَشِيق, ظَرِيف / بل, نعم (ليس ذلك فحسب، بل)\nمثال: أنا بذلك أفرح، بل وسأفرح / أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية)",
 "そそう": "إحباط, انقباض (حالة من الاكتئاب السوداوي) / سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\") / إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "そそぎぐち": "فوهة, مصب (فتحة تسمح بمرور السوائل أو الحبوب)",
 "そそくさ": "بسرعة, بعجلة (بطريقة سريعة أو متسرعة)\nمثال: الطريقة التي دفنوه بها بسرعة كانت معيبة",
 "そそぐ": "شَطَفَ (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن…) / صَبَّ, سَكَبَ (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو…)\nمثال: صب الشاي لضيفك. / مِيَاه / سَقِيفَة / وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "そそけだつ": "ارتجاف, رعشة (اهتزاز لا إرادي (كما لو كان بسبب المرض أو الخوف))\nمثال: سرت فيه رعشة مفاجئة",
 "そそける": "شِجَار عَلَنِيّ, عِرَاك (قتال صاخب)",
 "そそけ立つ": "ارتجاف, رعشة (اهتزاز لا إرادي (كما لو كان بسبب المرض أو الخوف))\nمثال: سرت فيه رعشة مفاجئة",
 "そそっかしい": "غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "そそっかしや": "طائش, مشتت الذهن (شخص طائش وغير منظم)",
 "そそっかし屋": "طائش, مشتت الذهن (شخص طائش وغير منظم)",
 "そそのかし": "إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة))",
 "そそのかす": "حَرَّضَ, دَفَعَ (حرّضه على الأمر: حضّه ، شدّد الرّغبة فيه؛ حَرَّضَهُ تَحْرِيضاً: حَثَّه على…)\nمثال: هو حرض على الشغب.",
 "そそりたつ": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه. / بُرْج (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "そそり勃つ": "بُرْج (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "そそり立つ": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "そそる": "حَرَّضَ, حَضَّ (حرّضه على الأمر: حضّه ، شدّد الرّغبة فيه؛ حَرَّضَهُ تَحْرِيضاً: حَثَّه على…)\nمثال: هو حرض على الشغب.",
 "そぞう": "سبك, صب (فعل إنشاء شيء ما عن طريق صبه في قالب)",
 "そぞく": "لص متسلل (لص يسرق دون استخدام العنف) / قَارِض, قَوَارِض",
 "そぞろ": "غَيْرُ مُرْتَاح, قَلِق (مَشْغُول البَال وَغَيْر مُطْمَئِنّ)\nمثال: ليلة قلقة",
 "そぞろあるき": "تَجَوُّل, تَنَزُّه",
 "そぞろあるく": "تَجَوُّل, تَنَزُّه",
 "そぞろに": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "そぞろ歩き": "تَجَوُّل, تَنَزُّه",
 "そぞろ歩く": "تَجَوُّل, تَنَزُّه",
 "そたい": "بيبلو, تمثال صغير (تمثال صغير منحوت أو مقولب) / جَرِيمة مُنَظَّمة",
 "そだ": "يَعْنِي, أَي / أجمة, دغل (نمو كثيف للشجيرات)\nمثال: أشعلوا ناراً من الحطب",
 "そだい": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "そだち": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها. / تَرْبِيَة",
 "そだちがいい": "حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "そだちがよい": "حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "そだちがわるい": "سَيِّئُ التَّرْبِيَةِ, قَلِيلُ الْأَدَبِ ((عن الأشخاص) يفتقر إلى الرقة أو اللباقة)",
 "そだちのいい": "حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "そだちのよい": "حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "そだちゆく": "كَبُرَ, ْنَشَأ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "そだつ": "نَمَى\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "そだて": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "そだてあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "そだておや": "والِد حاضِن, وَلِيّ أَمْر بَدِيل (شخص يقوم بدور الوالد والوصي لطفل بدلاً من والديه الطبيعيين دون تبنيه قانونياً)",
 "そだてのおや": "والِد حاضِن, وَلِيّ أَمْر بَدِيل (شخص يقوم بدور الوالد والوصي لطفل بدلاً من والديه الطبيعيين دون تبنيه قانونياً)",
 "そだてる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو…)\nمثال: للبقرة ذيل طويل. / تنشئَة, تَرْبِيَة",
 "そち": "قِيَاس\nمثال: قاس طول السرير. / ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود)\nمثال: ابتكار الخطط / أساس, عمل تمهيدي (إعداد أولي كأساس أو قاعدة)\nمثال: نحن مستعدون اليوم بسبب العمل التمهيدي الذي تم قبل عشر سنوات",
 "そちのけ": "أَهْمَلَ",
 "そちゃ": "شَاي, فِنْجَان شَاي (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي…)\nمثال: صب الشاي لضيفك.",
 "そちゅう": "مُلَاحَظَة, مَلْحُوظَة",
 "そちら": "هُنَاكَ / لِكَيْ, أَنْ\nمثال: これとそちらとの違いは何だい。 — ما الفرق بين هذا و ذاك؟ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "そちらさま": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "そちら様": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "そっか": "تَحْت الأَقْدَام (تحت القدمين)\nمثال: داس الفاصوليا تحت الأقدام / أَنْتَ, أَنْتِ (أنْتَ ضَميرُ رَفْعٍ مُنْفَصِلٌ لِلْمُخاطَبِ وَالْمُخاطَبَةِ)\nمثال: أنت لست صديقنا. / وَا, يَا يَاه\nمثال: آه ، هناك فراشة!",
 "そっから": "مِن هُنَاكَ, ثَمَّ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "そっかんせい": "سَرِيع الجَفَاف (مادّة سائلة تجفّ بسرعة)",
 "そっき": "اخْتِزَالِيّ, مُخْتَزَل (مكتوب بشكل مختصر أو رمزيّ) / أداة قياس, جهاز قياس (أداة تظهر مدى أو كمية أو درجة شيء ما)",
 "そっきしゃ": "كاتب اختزال (شخص ماهر في نسخ الكلام (خاصة الإملاء))",
 "そっきじゅつ": "اخْتِزَالِيّ, مُخْتَزَل (مكتوب بشكل مختصر أو رمزيّ)",
 "そっきふごう": "آلة الاختزال (آلة لكتابة أحرف الاختزال)",
 "そっきもじ": "آلة الاختزال (آلة لكتابة أحرف الاختزال)",
 "そっきゅう": "كرة سريعة ((بيسبول) رمية ترمى بأقصى سرعة)\nمثال: تأخر في ضرب الكرة السريعة / فَوْرِيّ",
