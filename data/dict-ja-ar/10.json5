 "たねずみ": "جرذ أسود (آفة منزلية شائعة أصلها من آسيا وانتشرت في جميع أنحاء العالم) / فأر الحقل (أي فأر ليلي من العالم القديم من جنس أبوديموس يعيش في الغابات والحقول والحدائق)",
 "たねちがい": "رحمي (من أو يتعلق بالرحم)\nمثال: سرطان الرحم",
 "たねつけ": "اقتران, تزاوج (عملية اقتران الذكر والأنثى لأغراض التكاثر)\nمثال: الاقتران العرضي للمراهقين",
 "たねとり": "إنجاب, تكاثر (النشاط الجنسي للحمل وإنجاب النسل)",
 "たねどこ": "مشتل, مهاد البذور (حوض تُزرع فيه الشتلات قبل نقلها)",
 "たねなしパン": "خبز الفطير, ماتزو (خبز مسطح هش يؤكل في عيد الفصح اليهودي)",
 "たねび": "شعلة إرشادية, شعلة دليل (موقد غاز مساعد صغير يوفر لهباً لإشعال موقد غاز أكبر)",
 "たねぶた": "خِنْزِير",
 "たねほん": "كتاب مصادر (مجموعة من الوثائق المهمة تاريخياً منشورة معاً ككتاب)",
 "たねまきき": "أصيص مزخرف, حوض زرع (وعاء مزخرف للنباتات المنزلية)",
 "たねもしかけもない": "هُنَاك, يُوجَد",
 "たねもの": "بِذْرَة, زَرِّيعَة",
 "たねん": "آخَر, غَيْرُهُ (أيّ بديل من بدائل شتّى؛ شيء آخر)",
 "たねんせい": "تعمير (عملية العيش لعدد من السنوات (كنبات معمر)) / أَبَدِيّ, سَرْمَدِيّ",
 "たねんせいしょくぶつ": "أَبَدِيّ, سَرْمَدِيّ",
 "たねんなく": "بشوق, بلهفة\nمثال: كانت الأخبار منتظرة بلهفة",
 "たのう": "تعدد المهارات, موسوعية (امتلاك مجموعة واسعة من المهارات)",
 "たのうほうせいらんそうしょうこうぐん": "مُتَلَازِمَة تَكَيُّس الْمَبَايِض",
 "たのしい": "مُمْتِع",
 "たのしげ": "سَعِيد\nمثال: فرح فاضل كثيرا.",
 "たのしませる": "فُرْجَة",
 "たのしみ": "مُتْعَة, مِتْعَة / تنبؤ, توقع (فعل التنبؤ (عن طريق التفكير في المستقبل))\nمثال: كان لكل منهم توقعاته الخاصة",
 "たのしむ": "اِسْتَمْتَعَ, تَمَتَّعَ\nمثال: من حسن حظي أن صرت صديقه.",
 "たのついずいをゆるさない": "لَا يُمْكِن تَجَاوُزُهُ (لا يمكن تخطيه أو التفوق عليه)",
 "たのみ": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا. / اتكال, اعتماد (يقين مبني على الخبرة السابقة)\nمثال: كتب الورقة مع اعتماد كبير على عمل علماء آخرين",
 "たのみいる": "اِلْتَمَسَ, تَوَسَّلَ",
 "たのみがい": "اعتمادية, موثوقية (جودة كون الشخص أو الشيء جديراً بالاعتماد أو الثقة)",
 "たのみごと": "تفضل, خدمة (عمل يتسم باللطف والتفضل)\nمثال: كانت النتيجة في صالحه",
 "たのみすくない": "عَاجِز",
 "たのむ": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا. / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / أَرْضَى, أَعْجَبَ\nمثال: يا لها من جملة!",
 "たのむから": "لِوَجْهِ اللّٰهِ, مِنْ أَجْلِ اللّٰهِ",
 "たのもう": "عَفْوًا!, مَاذَا قُلْتَ؟",
 "たのもしい": "مَوْثُوق / مُشْرِق, وَاعِد (من المرجح أن يسير على نحو جيد في المستقبل)\nمثال: طابور من الناس يأملون في الحصول على تذاكر",
 "たは": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع)",
 "たはた": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "たはたけ": "حَقْل (ذهب أو حدث بسرعة أو دون توقف؛ في بعض اللهجات: تعني تحرك سريعاً أو اهتزّ)\nمثال: يعمل الفلاحون في الحقل.",
 "たはつせい": "متعدد",
 "たはつせいこうかしょう": "تَصَلُّب لُوَيْحِيّ",
 "たはつせいこつずいしゅ": "ورم نقوي متعدد (ورم نقوي يتطور في عدة أماكن في نفس الوقت)",
 "たはつせいしんけいえん": "التهاب الأعصاب المتعدد (التهاب العديد أو كل الأعصاب المحيطية (كما في الجذام))",
 "たば": "إِبَالَة, حُزْمَة",
 "たばかる": "مَكِيدَة / نَاقَشَ, بَحَثَ",
 "たばこを吸う": "دُخَان, دخان\nمثال: دخن زيري سيجارة.",
 "たばこ入れ": "كيس تبغ (جراب لحمل تبغ الغليون)",
 "たばこ屋": "محل تبغ (متجر يبيع الغليون وتبغ الغليون والسيجار والسجائر)",
 "たばね": "إِبَالَة, حُزْمَة",
 "たばねつむ": "صَدْمَة",
 "たばねる": "إِبَالَة, حُزْمَة / حَكَمَ, تَحَكَّمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "たひと": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "たひね": "اللعنة عليك",
 "たひんしゅちゅうしょうりょうせいさんシステム": "تضمين التردد (تضمين تردد الموجة الحاملة (للراديو))",
 "たび": "تابي (جورب بفاصل لإصبع القدم الكبير؛ يرتديه اليابانيون مع الصنادل) / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / سَافَرَ, سَارَ (السَّافِرُ : المُسافِرُ؛ سَافِرٌ : كَاتِبٌ ، أحَدُ الْمَلاَئِكَةُ الَّذِينَ…)\nمثال: سافر سامي وليلى.",
 "たびあきない": "بيع متجول (فعل بيع البضائع لكسب العيش)",
 "たびあきんど": "جَوَّال, بَائِع مُتَجَوِّل (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان…)\nمثال: اشتريت جوال مستعمل.",
 "たびかさなる": "كَرَّرَ, أَعَادَ (أَعَادَ)\nمثال: كرر الشهادة بعدي.",
 "たびかず": "تَرَدُّد (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي…)\nمثال: قبل ماثيو بتردد.",
 "たびがらす": "هَائِم / أجنبي, دخيل (شخص مستبعد أو ليس عضواً في مجموعة معينة)",
 "たびごと": "كُلَّمَا",
 "たびさき": "وِجْهَة, وُجْهَة",
 "たびしょうにん": "جَوَّال, بَائِع مُتَجَوِّل (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان…)\nمثال: اشتريت جوال مستعمل.",
 "たびじ": "رِحْلَة, سَفَر",
 "たびすがた": "حقيبة أدوات السفر, حقيبة مستلزمات (حقيبة لحمل أدوات النظافة أثناء السفر)",
 "たびする": "سَافَرَ, سَارَ (السَّافِرُ : المُسافِرُ؛ سَافِرٌ : كَاتِبٌ ، أحَدُ الْمَلاَئِكَةُ الَّذِينَ…)\nمثال: سافر سامي وليلى.",
 "たびたび": "كَثِيرًا, غَالِبًا",
 "たびだち": "رَحِيل, مُغَادَرَة",
 "たびだつ": "غَادَرَ, رَحَلَ (تَرَكَ)\nمثال: غادر سامي للتو. / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "たびと": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "たびに": "كُلَّمَا",
 "たびにん": "مُتَنَقِّل",
 "たびねずみ": "لاموس, ليمونغ (أي من القوارض قصيرة الذيل ومكسوة القدمين بالفراء، تنتشر في المناطق القطبية)",
 "たびのひと": "رحّالة, مسافر (شخص يغير موقعه)",
 "たびのもの": "رحّالة, مسافر (شخص يغير موقعه)",
 "たびびと": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "たびびとのき": "رافينالا, شجرة المسافر (نبات عملاق يشبه الشجرة له جوز صالح للأكل وأعناق أوراق تنتج مشروباً منعشاً من…)",
 "たびまわり": "رِحْلَة",
 "たびょう": "مِسْقَام",
 "たび人": "مُسَافِر, مُسَافِرَة (مَسَافِر: (اسم)؛ مُسَافَر: (اسم))\nمثال: أقل سامي مسافر أوتوستوب.",
 "たふ": "تَعَدُّد اَلْأَزْوَاج",
 "たふさ": "سروال تحتي, مئزر (رداء يوفر غطاءً لمنطقة العانة والوركين)",
 "たぶたぶ": "طَافِح, مَمْلُوء حَتَّى الحَافَة (مَمْلُوء إِلَى أَقْصَى حَدّ) / فَضْفَاض, واسِع",
 "たぶらかす": "حِيلَة",
 "たぶん": "علانية, عمومية (صفة كون الشيء مفتوحاً للأنظار العامة أو متاحاً للجمهور)\nمثال: علانية قاعة المحكمة / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "たぶんか": "متعدد الثقافات (متعلق بعدة ثقافات أو يشملها)\nمثال: حدث متعدد الثقافات",
 "たぶんかしゅぎ": "اَلتَّعَدُّدِيَّةُ اَلثَّقَافِيَّة",
 "たぶんに": "إلى حد كبير, بشكل جوهري (إلى مدى أو درجة كبيرة)\nمثال: أخشى أن الفيلم تجاوز الميزانية بكثير",
 "たぷたぷ": "مُتَرَهِّل",
 "たぷんたぷん": "رجفة, هز خفيف (حركة اهتزازية خفيفة غير منتظمة)",
 "たへんけい": "مُضَلَّع",
 "たへんりょうかいせき": "تحليل متعدد المتغيرات (مصطلح عام لأي تقنية إحصائية تستخدم لتحليل البيانات من أكثر من متغير واحد)",
 "たべあわせ": "تركيب, جمع (عملية دمج الأشياء لتكوين كلٍ جديد)",
 "たべかす": "الْبَقَايَا",
 "たべきれない": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو…)\nمثال: مزيد من الأرض",
 "たべくらべる": "حَسَبَ الرَغَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو…)\nمثال: حسب سامي المال.",
 "たべごたえ": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر)",
 "たべすぎ": "شراهة, نهم (الأكل بإفراط (تُشخص كإحدى الخطايا السبع المميتة))",
 "たべで": "جُسْمَانِيَّة, مَادِّيَّة (صفة كون الشيء مادياً أو له جوهر)",
 "たべどころ": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "たべにくい": "غير مستساغ, كريه (غير لطيف أو غير مقبول للطعم أو للعقل)\nمثال: وجبة غير مستساغة",
 "たべのこし": "الْبَقَايَا",
 "たべもの": "طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "たべものや": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "たべる": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)\nمثال: أحب أكل البطيخ.",
 "たべん": "ثرثرة (صفة الإطناب وكثرة الكلام) / مُنْفَصِل البَتَلَات (ذو تويج مكوَّن من بتلات متعدّدة منفصلة)",
 "たべカス": "الْبَقَايَا",
 "たほう": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول)\nمثال: رأيت واحدة مرة. / من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "たほうめん": "مُتَعَدِّد الأَطْرَاف, مُتَعَدِّد الجَوَانِب (لديه أجزاء أو جوانب متعددة)",
 "たぼ": "كَعْكَة الشَّعْر (لفة من الشعر توضع عند مؤخرة العنق)",
 "たぼう": "انشغال, دبيب (حالة الوجود أو الظهور بمظهر المنشغل بنشاط ما)\nمثال: أظهروا كل نشاط مجموعة من القنادس / مُشْرِق, وَاعِد (من المرجح أن يسير على نحو جيد في المستقبل)",
 "たぽたぽ": "مُتَوَرِّم, مُنْتَفِخ (مُتَمَدِّد بِشَكْل غَيْر طَبيعِيّ بِسَبَب السَّوائِل أو الغاز)",
 "たま": "ضَرَّة / خرزة (كرة صغيرة بها ثقب في المنتصف)\nمثال: حبات العرق على جبهته / كَوْم / رَصَاصَة, رَصَاص / رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة. / ضبط النفس (سمة التحكم الحازم في سلوك المرء) / حالة إدراكية, حالة معرفية (حالة العمليات المعرفية للشخص) / عَرَضِيّ",
 "たまいし": "حَصَاة",
 "たまう": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "たまうき": "عوامة صيد (عوامة صغيرة مصنوعة عادة من الفلين؛ تعلق بخيط الصيد)",
 "たまおしこがね": "جَعْل الرَوْث, جِعْرَان (صَيَّرَ؛ أَنْشَأَ)\nمثال: جعل الأمور أسوء.",
 "たまかけ": "رشق, قذف (الرمي بحركة واسعة (كما لو كان بمقلاع))",
 "たまかざり": "السَّنَة الْجَدِيدَة",
 "たまがい": "صدفة القمر (بطنيات قدم بحرية لها أصداف مستديرة ناعمة تشكل أبراجاً قصيرة)",
 "たまがけ": "رشق, قذف (الرمي بحركة واسعة (كما لو كان بمقلاع))",
 "たまがた": "مُسْتَدِير, مُدَوَّر (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
