 "そのいっぽう": "أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ)\nمثال: أما زلت تذكرني؟",
 "そのう": "بُسْتَان (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على…)\nمثال: أحب سقي البستان.",
 "そのうえ": "إِضَافَةً عَلى ذٰلِكَ / أَعْلَى (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى)\nمثال: خذها إلى الأعلى.",
 "そのうえで": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك",
 "そのうち": "قَرِيبًا, سَرْعَانَ مَا",
 "そのうちに": "قَرِيبًا, سَرْعَانَ مَا",
 "そのおり": "على ذلك, عليه (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: النص والتعليق عليه (يفيد الاستعلاء؛ يفيد التعليل)",
 "そのかみ": "كَان يَامَا كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "そのかわり": "بَدَلاً مِن",
 "そのくせ": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "そのけ": "مِثْلِيَّة, مِثْلِيَّة جِنْسِيَّة",
 "そのこと": "لِكَيْ, أَنْ",
 "そのころ": "آنَذَاكَ, حِينَئِذٍ\nمثال: ثم هناك مشكلة؛",
 "そのご": "أَخِير, بَعْدَ ذٰلِك\nمثال: その後の話はご存じでしょう。 — أنتَ تعرف بقية القصة.",
 "そのさい": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "そのじつ": "فِي الْحَقِيقَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "そのすじ": "حكومة, سلطة (المنظمة التي تمثل السلطة الحاكمة لوحدة سياسية)\nمثال: خفضت الحكومة الضرائب / يَاكُوزَا",
 "そのた": "رَاحَة, اِسْتِرَاحَة\nمثال: عليك أخذ استراحة. / إِضَافَةً عَلى ذٰلِكَ / وَهٰكَذَا, وَهَلُمَّ جَرًّا",
 "そのたおおぜい": "إِضَافِيّ, زَائِد (أكثر من اللازم أو مُضاف إلى ما هو موجود)\nمثال: سيارة سريعة بشكل استثنائي",
 "そのため": "وَعَلَيْهِ, وَمِنْ ثَمَّ",
 "そのたもろもろ": "إذن, ثم (لاحقاً أو بعد ذلك بقليل (تستخدم غالباً كروابط للجمل))",
 "そのつど": "أبداً",
 "そのてんで": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "そのとき": "آنَذَاكَ, حِينَئِذٍ\nمثال: ثم هناك مشكلة؛",
 "そのなか": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "そののち": "أَخِير, بَعْدَ ذٰلِك\nمثال: その後の話はご存じでしょう。 — أنتَ تعرف بقية القصة.",
 "そのはず": "طَبْعًا",
 "そのはんめん": "من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "そのば": "هُنَاكَ / فوراً, في الحال (دون تأخير أو حالاً)\nمثال: وظفناها في الحال",
 "そのばあいには": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "そのばかぎり": "مُؤَقَّت",
 "そのばしのぎ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة)",
 "そのばのがれ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة)",
 "そのひぐらし": "كفافاً, يوماً بيوم (بما يكفي بالكاد للاحتياجات الفورية)\nمثال: عاشوا يوماً بيوم",
 "そのひそのひ": "يَوْمِيّ (يتعلق بكل يوم أو يحدث كل يوم)\nمثال: その日その日で天気は変わる。 — يتغيّر الجوّ من يوم إلى آخر.",
 "そのぶん": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان / بناءً على ذلك, نتيجة لذلك ((روابط الجمل) بسبب السبب المذكور)\nمثال: نتيجة لذلك، لم يفعل ذلك",
 "そのへん": "تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة",
 "そのほう": "لِكَيْ, أَنْ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "そのほか": "رَاحَة, اِسْتِرَاحَة\nمثال: عليك أخذ استراحة. / إِضَافَةً عَلى ذٰلِكَ / وَهٰكَذَا, وَهَلُمَّ جَرًّا",
 "そのほかに": "غَيْر, آخَر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "そのまさかだ": "بِالتَّأْكِيد",
 "そのまま": "كَمَا هُوَ, كَمَا هِيَ / فَوْرًا, حَالًا",
 "そのまんま": "كَمَا هُوَ, كَمَا هِيَ / فَوْرًا, حَالًا",
 "そのみち": "عَلَاقَة غَرَامِيَّة",
 "そのもと": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "そのもの": "نَفْسُهُ, نَفْسُهَا",
 "そのよう": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "そのわりには": "بالصدفة, عرضياً (بدون تخطيط مسبق)\nمثال: التقيا بالصدفة",
