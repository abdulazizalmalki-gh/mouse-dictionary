 "たまきび": "غَلَّة / برونكل (بطني قدم بحري صالح للأكل)",
 "たまけり": "كُرَة اَلْقَدَم",
 "たまご": "بيض (جسم تناسلي بيضاوي للطير (خاصة الدجاج) يستخدم كطعام) / بَيْضَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد…)\nمثال: هذه بيضة مقلية. / مُسْتَقْبَل / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة.",
 "たまごがら": "قَشْر الْبَيْضِ",
 "たまごたて": "كأس البيض (إناء صغير لتقديم البيض المسلوق)",
 "たまごてんぐたけ": "أمانيت فالوسي, قبعة الموت (فطر سام للغاية عادة ما يكون أبيض اللون بقاعدة بارزة تشبه الكأس؛ يختلف عن…)",
 "たまごのから": "قَشْر الْبَيْضِ",
 "たまごめ": "تحميل (عمل وضع حمولة من شيء ما على أو في مركبة أو سفينة أو حاوية، إلخ)\nمثال: استغرق التحميل ساعتين",
 "たまごめん": "نودلز بالبيض (شريط ضيق من عجين المكرونة مصنوع بالبيض)",
 "たまごやき": "بَيْض مَقْلِيّ (الأيام البِيض: الأيام التي توافق اليوم الثالث عشر، والرابع عشر، والخامس عشر من…)\nمثال: ياني يحب البيض. / مِقْلَاة (وعاء قلي الطعام)",
 "たまごやきき": "مِقْلَاة (وعاء قلي الطعام)",
 "たまご麺": "نودلز بالبيض (شريط ضيق من عجين المكرونة مصنوع بالبيض)",
 "たまさか": "بالصدفة, تزامناً (الحدوث في نفس الوقت) / قَلِيلًا, قَلِيلًا مَا",
 "たましい": "رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة. / ضبط النفس (سمة التحكم الحازم في سلوك المرء) / حالة إدراكية, حالة معرفية (حالة العمليات المعرفية للشخص)",
 "たましいをいれかえる": "إِصْلَاح",
 "たましき": "جَمِيل (حَسَن)\nمثال: طقس اليوم جميل.",
 "たまじくうけ": "رمان بلي, محمل كروي (محامل تحتوي على كرات معدنية صغيرة)",
 "たまじゃくし": "مِغْرَفَة",
 "たまじゃり": "حَصَى, حَصْبَاء (الحَصَى: صِغارُ الْحِجَارَةِ، الواحدةُ مِنْهُ حَصَاة. ابْنُ سِيدَهْ: الحَصَاة…)",
 "たまじょう": "كُرَوِيّ (ذو شكل الكرة أو المجال)",
 "たまずさ": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
 "たまたま": "صُدْفَةً, بِصُدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون…)\nمثال: لا تدعها للصدفة. / أَحْيَانًا / بَيْضَة, خُصْيَة (ما تضعه أنثى الحيوان البَيُوض أو الطائر، يخرج منه صغير الطائر بعد فترة؛ قد يقصد…)\nمثال: هذه بيضة مقلية.",
 "たまだれ": "ستار خيزراني (حاجز أيديولوجي حول الصين الشيوعية خاصة في الخمسينيات والستينيات)",
 "たまちる": "بريق, تألق (صفة اللمعان بضوء منعكس ساطع)\nمثال: كان في عينيه بريق",
 "たまったものじゃない": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية / عَظِيم, هَائِل (كبير بشكل استثنائي في الحجم أو المدى أو الكمية أو القوة أو الدرجة)",
 "たまったものではない": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية / عَظِيم, هَائِل (كبير بشكل استثنائي في الحجم أو المدى أو الكمية أو القوة أو الدرجة)",
 "たまったもんじゃない": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية / عَظِيم, هَائِل (كبير بشكل استثنائي في الحجم أو المدى أو الكمية أو القوة أو الدرجة)",
 "たまったもんではない": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية / عَظِيم, هَائِل (كبير بشكل استثنائي في الحجم أو المدى أو الكمية أو القوة أو الدرجة)",
 "たまつき": "بِلْيَارْدُو",
 "たまつきだい": "طاولة بلياردو (معدات ألعاب تتكون من طاولة ثقيلة تلعب عليها البلياردو)",
 "たまどめ": "عقدة فرنسية (غرزة مصنوعة بلف الخيط عدة مرات حول الإبرة قبل إدخالها في القماش)",
 "たまな": "مَلْفُوف, كُرُنْب",
 "たまなし": "عَدِيم الأَشْوَاك (خالٍ من الأشواك أو الإبر)\nمثال: كان دودة صفراء عديمة الشجاعة / فَاسِد",
 "たまに": "أَحْيَانًا",
 "たまにきず": "شائبة, منغص (إزعاج ينتقص من فائدة شيء ما)",
 "たまにキズ": "شائبة, منغص (إزعاج ينتقص من فائدة شيء ما)",
 "たまねぎ": "بَصَل",
 "たまははき": "مِكْنَسَة, مِقْشَة / كُحُول, خَمْر (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ…)\nمثال: أكره ذوق الكحول.",
 "たまばえ": "بعوضة العفص (ذباب هش يشبه البعوض ينتج العفص على النباتات)",
 "たまばち": "دبور العفص (دبور منعزل صغير ينتج العفص على البلوط والنباتات الأخرى)",
 "たまばはき": "مِكْنَسَة, مِقْشَة / كُحُول, خَمْر (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ…)\nمثال: أكره ذوق الكحول.",
 "たまひろい": "جامع الكرات (صبي يجمع الكرات للاعبي التنس)",
 "たまぶくろ": "صَفَن, كِيس اَلصَّفَن",
 "たままゆ": "شَرْنَقَة (غشاء واق من خيوط دقيقة تنسجه بعض الحشرات حولها كدودة القز، لتحتمي به في طَوْر…)",
 "たまみず": "قَطْرَةُ مَطَر",
 "たまむしいろ": "غَامِض, مُلْتَبِس (غَيْرُ يَقِينِيٍّ كَعَلَامَةٍ أَوْ دَلَالَةٍ)\nمثال: بيان ملتبس",
 "たまも": "عُشْب بَحْرِيّ",
 "たまもの": "هَدِيَّة, هدية / تَسَبَّب",
 "たまや": "ضَرِيح, مَرْقَد / صَائِغ, صَائِغَة / فُقَّاعَةُ صَابُون",
 "たまよけ": "مُضَادّ لِلرَّصَاص, وَاقٍ مِن الرَّصَاص (لا تخترقه الرصاصات)",
 "たまらない": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية / لَا يُقَاوَم (بالغ الجاذبيّة إلى حدّ لا يمكن مقاومته)\nمثال: دوافع لا تقاوم",
 "たまらん": "غير محتمل, لا يطاق (لا يمكن تحمله أو الصبر عليه)\nمثال: درجة لا تطاق من العاطفية / لَا يُقَاوَم (بالغ الجاذبيّة إلى حدّ لا يمكن مقاومته)\nمثال: دوافع لا تقاوم",
 "たまり": "كَوْم",
 "たまりせき": "مَقْعَد الحَلْبَة (الصف الأول من المقاعد؛ يتمتع برؤية خالية من العوائق لحلبة الملاكمة أو المصارعة)",
 "たまりば": "مرتع, مزار (مكان يتردد عليه المرء كثيراً)",
 "たまり場": "مرتع, مزار (مكان يتردد عليه المرء كثيراً)",
 "たまり席": "مَقْعَد الحَلْبَة (الصف الأول من المقاعد؛ يتمتع برؤية خالية من العوائق لحلبة الملاكمة أو المصارعة)",
 "たまる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / دُبّ",
 "たまるか": "بجنون, بشدة ((عامية) بسرعة أو جهد أو شدة كبيرة؛ للمبالغة)\nمثال: قاد بجنون",
 "たまわりもの": "أَنِيس, رَفِيق (قريب جداً وأليف في العشرة)\nمثال: استمتع بنعم السلام",
 "たまわる": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته.",
 "たまウキ": "عوامة صيد (عوامة صغيرة مصنوعة عادة من الفلين؛ تعلق بخيط الصيد)",
 "たまレタス": "خس آيسبرغ, خس الرؤوس (خس ذو أوراق خضراء فاتحة مقرمشة ومعبأة بإحكام في رأس صلب)\nمثال: خس الآيسبرغ لا يزال هو الخس الأكثر شعبية",
 "たま蜂": "دبور العفص (دبور منعزل صغير ينتج العفص على البلوط والنباتات الأخرى)",
 "たま蝿": "بعوضة العفص (ذباب هش يشبه البعوض ينتج العفص على النباتات)",
