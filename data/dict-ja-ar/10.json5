 "その場凌ぎ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة)",
 "その場合には": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "その場逃れ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "その場限り": "مُؤَقَّت",
 "その外": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / إِضَافَةً عَلى ذٰلِكَ / وَهٰكَذَا, وَهَلُمَّ جَرًّا",
 "その実": "فِي الْحَقِيقَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "その後": "أَخِير, بَعْدَ ذٰلِك\nمثال: その後の話はご存じでしょう。 — أنتَ تعرف بقية القصة.",
 "その折": "على ذلك, عليه (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: النص والتعليق عليه (يفيد الاستعلاء؛ يفيد التعليل)",
 "その折り": "على ذلك, عليه (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: النص والتعليق عليه (يفيد الاستعلاء؛ يفيد التعليل)",
 "その方": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "その方達": "هُمَا / هُم / هُنَّ (أحد الأسماء الستة، بمعنى شيء، ويُستخدم كناية عن الشيء الذي يُستقبح ذكره) / هِيَ (في : مبني على السكون بمعنى نَعَم أو إيْ، وقد تحرك الياء فيقال هَيه؛ اسم فعل مبني على السكون يُقال للطفل بمعنى ها أناذا) / هما / هم",
 "その日その日": "يَوْمِيّ (يتعلق بكل يوم أو يحدث كل يوم)\nمثال: その日その日で天気は変わる。 — يتغيّر الجوّ من يوم إلى آخر.",
 "その日暮し": "كفافاً, يوماً بيوم (بما يكفي بالكاد للاحتياجات الفورية)\nمثال: عاشوا يوماً بيوم",
 "その日暮らし": "كفافاً, يوماً بيوم (بما يكفي بالكاد للاحتياجات الفورية)\nمثال: عاشوا يوماً بيوم",
 "その時": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "その様": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "その気": "مِثْلِيَّة, مِثْلِيَّة جِنْسِيَّة",
 "その点で": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "その為": "وَعَلَيْهِ, وَمِنْ ثَمَّ",
 "その物": "نَفْسُهُ, نَفْسُهَا",
 "その癖": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "その筈": "طَبْعًا",
 "その筋": "حكومة, سلطة (المنظمة التي تمثل السلطة الحاكمة لوحدة سياسية)\nمثال: خفضت الحكومة الضرائب / يَاكُوزَا",
 "その足で": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم.",
 "その辺": "تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة",
 "その辺り": "في ذلك الجوار, هناك تقريباً (بالقرب من ذلك المكان) / في ذلك الوقت تقريباً (بالقرب من ذلك الوقت أو التاريخ)\nمثال: أقام في لندن أو جوارها لعدة أسابيع",
 "その道": "عَلَاقَة غَرَامِيَّة",
 "その都度": "أبداً",
 "その際": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "その頃": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "そはい": "صغير, طفل (شخص صغير السن من أي من الجنسين) / إمّعة, تافه (شخص صغير وغير مهم)\nمثال: هي تكتب كتباً للأطفال",
 "そば": "جَانِب / صَفْحَة / مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "そばかす": "نَمَش",
 "そばから": "مَا أَن, حَالَمَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "そばきり": "سُوبَا",
 "そばだつ": "بُرْج (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "そばだてる": "سُلَالَة",
 "そばちかく": "بالقرب, في مكان قريب (ليس بعيداً بالمصطلحات النسبية) / قَرِيب, مُجَاوِر (على مقربة؛ في متناول اليد)\nمثال: هي تعمل في مكان قريب",
 "そばづかえ": "خادمَة",
 "そばにょうぼう": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "そばはら": "خَاصِرَة, كَشْح / جِنَاح / جَانِب",
 "そばみち": "طريق جانبي (طريق فرعي يتفرع من طريق رئيسي)",
 "そばむ": "عَارَض (فلانٌ: أخذ في ناحية من الطريق؛ فلانا: باراه وأتى بمثل ما أتى به) / اِعْتَرَضَ (سار عارضا بدون هدف وتخطيط كما تكون الخشبة الطافية في الماء؛ الشيءَ أو الشخصَ: حَالَ بينه وبين ما يريد، أو وقف في طريقه)\nمثال: جميع من حضر عارض تلك الخطة.",
 "そばむぎ": "حِنْطَة سَوْدَاء",
 "そばめ": "سَيِّدَة / خَلِيلَة, عَشِيقَة",
 "そば切り": "سُوبَا",
 "そば近く": "بالقرب, في مكان قريب (ليس بعيداً بالمصطلحات النسبية) / قَرِيب, مُجَاوِر (على مقربة؛ في متناول اليد)\nمثال: هي تعمل في مكان قريب",
 "そびえる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "そびやかす": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "そびょう": "رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: واصل زيري الرسم. / لَخَّصَ, اِخْتَصَرَ",
 "そびら": "خَلْفِيّ / ظَهْر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن) / ضهر / ظَهَر (مصدر للفعل ظَهَرَ؛ خلاف البَطْن، الجزء الظَاهِر من الشيئ وغير البَاطِن)\nمثال: عنده حقيبة ظهر.",
 "そふ": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم عن طريق الأب، فهو أبو الأب وأبو أبوه وهكذا)\nمثال: عليك العمل بجد.",
 "そふぼ": "جَدّ, جَدَّة (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم عن طريق الأب، فهو أبو الأب وأبو أبوه وهكذا)\nمثال: عليك العمل بجد.",
 "そぶ": "جَدّ (أبو الأَبّ وأبو الأُمّ. وفي العامية قد تُكسر الجِيم؛ أحد الذين يعود النسل إليهم عن طريق الأب، فهو أبو الأب وأبو أبوه وهكذا)\nمثال: عليك العمل بجد.",
 "そぶつ": "مَلَابِس, ثِيَاب",
 "そぶり": "سُلُوك, تَصَرُّف",
 "そへん": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية.",
 "そほう": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "そほうか": "ثري, غني (شخص يمتلك ثروة مادية كبيرة)",
 "そほん": "خَامّ (وَخُمَ أو وَبِئَ؛ أقام في المكان أو استقر فيه)\nمثال: تنقل السفن المواد الخام من أندونيسيا.",
 "そぼ": "جَدَّة (هي أم الأب أو أم الأم؛ مدينة في السُعُودِيَّة قرب مَكَّة، قيل أنها سميت هكذا لأن حواء دفنت فيها والله أعلم)\nمثال: كان لزيري جد و جدة.",
 "そぼう": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "そぼく": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "そぼくじつざいろん": "واقعية, واقعية ساذجة ((فلسفة) المذهب الفلسفي القائل بأن الأشياء المادية تستمر في الوجود عندما لا يتم إدراكها)",
 "そぼそぼ": "رَذَاذِيّ ((عن المَطَر) يَتَسَاقَطُ خَفِيفًا فِي قَطَرَاتٍ دَقِيقَةٍ جِدًّا)",
 "そぼふる": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "そぼろ": "مُحَطَّم, مُمَزَّق (خَرِبٌ أَوْ مُتَمَزِّق) / مُمَزَّق, مُهَلْهَل (بَالٍ حَتَّى صَارَ أَشْلَاءً؛ أَوْ يَرْتَدِي ثِيَابًا مُمَزَّقَةً) / غَرَامَة / غَرَّمَ (التزم بدفع شيء مقابل عمل أو خطأ أو ضرر؛ تحمل مسؤولية أو عقوبة نتيجة لفعل)",
 "そぼ降る": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "そまつ": "خَامّ (وَخُمَ أو وَبِئَ؛ أقام في المكان أو استقر فيه)\nمثال: تنقل السفن المواد الخام من أندونيسيا. / غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "そまつにあつかう": "بَهْدَلَ",
 "そまつにする": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "そまびと": "حَطَّاب",
 "そまむぎ": "حِنْطَة سَوْدَاء",
 "そまん": "غَيْر مُتْقَن, مُرْتَجَل (يَتَّسِم بِالإِهْمَال الشَّدِيد وعَدَم الدِّقَّة)",
 "そむく": "عَصَى",
 "そめ": "صباغة (استخدام الصبغة لتغيير لون شيء ما بشكل دائم)",
 "そめい": "تَفْسِير, شَرْح",
 "そめいだす": "صِبْغَة / صَبَغَ ((صَبَغَ) الثوبَ ونحوه يَصْبُغُ صَبْغًا: لَوَّنَهُ؛ فهو صابغ، وصَبَّاغٌ، والمفعولُ: مصبوغٌ، وصَبِيغٌ)\nمثال: صبغ ابي صندوق البريد بالاحمر.",
 "そめこ": "صِبْغَة / صَبَغَ ((صَبَغَ) الثوبَ ونحوه يَصْبُغُ صَبْغًا: لَوَّنَهُ؛ فهو صابغ، وصَبَّاغٌ، والمفعولُ: مصبوغٌ، وصَبِيغٌ)\nمثال: صبغ ابي صندوق البريد بالاحمر.",
 "そめこむ": "صِبْغَة / صَبَغَ ((صَبَغَ) الثوبَ ونحوه يَصْبُغُ صَبْغًا: لَوَّنَهُ؛ فهو صابغ، وصَبَّاغٌ، والمفعولُ: مصبوغٌ، وصَبِيغٌ)\nمثال: صبغ ابي صندوق البريد بالاحمر.",
 "そめし": "صَبَّاغ, صَبَّاغَة",
 "そめだす": "صِبْغَة / صَبَغَ ((صَبَغَ) الثوبَ ونحوه يَصْبُغُ صَبْغًا: لَوَّنَهُ؛ فهو صابغ، وصَبَّاغٌ، والمفعولُ: مصبوغٌ، وصَبِيغٌ)\nمثال: صبغ ابي صندوق البريد بالاحمر.",
 "そめつけ": "صباغة (استخدام الصبغة لتغيير لون شيء ما بشكل دائم)",
 "そめつける": "صِبْغَة / صَبَغَ ((صَبَغَ) الثوبَ ونحوه يَصْبُغُ صَبْغًا: لَوَّنَهُ؛ فهو صابغ، وصَبَّاغٌ، والمفعولُ: مصبوغٌ، وصَبِيغٌ)\nمثال: صبغ ابي صندوق البريد بالاحمر.",
 "そめもの": "صباغة (استخدام الصبغة لتغيير لون شيء ما بشكل دائم)",
 "そめものや": "صَبَّاغ, صَبَّاغَة",
 "そめる": "صِبْغَة / صَبَغَ ((صَبَغَ) الثوبَ ونحوه يَصْبُغُ صَبْغًا: لَوَّنَهُ؛ فهو صابغ، وصَبَّاغٌ، والمفعولُ: مصبوغٌ، وصَبِيغٌ)\nمثال: صبغ ابي صندوق البريد بالاحمر.",
 "そも": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "そもうし": "صوف ممشط, ورستد (قماش صوفي بسطح محكم صلب وبدون وبر؛ منسوج من خيوط صوفية ممشطة) / غزل صوفي ممشط (خيط صوفي مجدول بإحكام مغزول من الصوف طويل التيلة)\nمثال: ارتدى بدلة من الصوف الممشط",
 "そもじ": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そもそも": "أساساً, في المقام الأول (ذو أهمية أولية) / أصلاً, في المقام الأول (قبل الآن)\nمثال: هذه مسألة اقتصادية في المقام الأول / فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "そや": "رَيْفِيّ, قَرَوِيّ / سَهْم, سهم (سَهَمَ؛ سَهَّمَ)\nمثال: لم يصب السهم توم.",
 "そやから": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "そやす": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "そやつ": "هُوَ\nمثال: そいつをつかまえて！ — أمسكه!",
 "そゆ": "أَصْطَرَك, أَسْطَرَك",
 "そよう": "تأريض (توصيل المعدات الكهربائية بالأرض) / أساس, تأسيس (التعليم أو التوجيه في أساسيات مجال من مجالات المعرفة)\nمثال: يفتقر إلى التأسيس اللازم للدراسة المتقدمة",
 "そようちょう": "سُخْرَة (خدمة إجباريّة بغير أجر معلوم؛ تكليف عمل بلا أجر) / سُخْرَة, كُوج (خدمة إجباريّة بغير أجر معلوم؛ تكليف عمل بلا أجر)",
 "そよかぜ": "نسيم لطيف (رياح تتحرك بسرعة 8-12 عقدة؛ 3 على مقياس بوفورت)",
 "そよぐ": "حَفِيف",
 "そよそよ": "بخفة, برفق (بقليل من الوزن أو القوة) / بلطف, تدريجياً (بشكل تدريجي) / برفق, بلطف (بطريقة لطيفة)\nمثال: قبلته بخفة على جبينه",
 "そよ風": "نسيم لطيف (رياح تتحرك بسرعة 8-12 عقدة؛ 3 على مقياس بوفورت)",
 "そら": "سَمَاء, سما / سَمَاء, سَمَاوَات / سَمَاوَات / طَقْس, جَوّ / قَصِيّ, نَائٍ جِدًّا (بعيد جدّاً في المكان أو الزمان) / حالة إدراكية, حالة معرفية (حالة العمليات المعرفية للشخص) / حالة ذهنية, مزاج (حالة نفسية مؤقتة) / يَعْنِي, أَي",
 "そらあい": "طَقْس, جَوّ",
 "そらいろ": "سَمَاوِيّ, أَسْمَانْجُونِيّ",
 "そらおそろしい": "مُتَوَتِّر",
 "そらおぼえ": "حِفْظ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "そらきた": "فَهِمْتَ, فَهِمْتِ / فَهِمْتُ",
 "そらごと": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد. / مُزَيَّف",
 "そらす": "أَزْعَجَ / أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ. / ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "そらせる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "そらぞらしい": "زَائِف, بَاطِل / كَاذِب",
 "そらでおぼえる": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "そらで覚える": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "そらとぶえんばん": "طَبَق طَائِر (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ.",
 "そらなみだ": "دموع التماسيح (إظهار نفاق للحزن؛ بكاء كاذب أو غير صادق)\nمثال: ذرفت السكرتيرات دموع التماسيح على معضلة المدير",
 "そらにことば": "شِبْه نَظِير",
 "そらね": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "そらねんぶつ": "خِطَابَة جَوْفَاء, كَلَام مُنَمَّق (كلام صاخب ومشوش وفارغ)\nمثال: مجرد خطاب منمق",
 "そらのげんかん": "مَطَار (المَطارُ : اسمُ مكانٍ من طَارَ؛ المَطارُ :وهو مكان مُعَدُّ بالوسائل الفنِّيَّة لصعود الطائرات وهبوطها أي مركز طيران جوي، أو ميناء جوي)\nمثال: وصلت إلى المطار.",
 "そらのたび": "سفر جوي, طيران (السفر عبر الطائرات)\nمثال: السفر الجوي ينطوي على الكثير من الانتظار في المطارات",
 "そらのびん": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة) / تَحْلِيق / فِرَار, هُرُوب\nمثال: الطيران أسرع وسيلة سفر.",
 "そらびき": "مِنْسَج",
 "そらびきばた": "مِنْسَج",
 "そらまめ": "فُول, بَاقِلَّاء",
 "そらみみ": "صَمَم",
 "そらめ": "هَلْوَسَة, وَهْم / هَلْوَسَة",
 "そらもよう": "طَقْس, جَوّ\nمثال: 空模様から判断すると、雪が降りそうだ。 — يظهر من شكل السماء أن الثلج سيتساقط. / طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / مَسار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا الطبق لذيذ.",
 "そらをつかう": "ضَجَعَ, تَمَدَّدَ / كَذَبَ, كدب (مصدر للفعل كَذَبَ؛ نقيض الصِدْق، قَوْل ما يخالف ما يعلم القَائِل أنه حَقِيقَة) / كَذْبَة, كِذْبَة\nمثال: اتهمتني بالكذب.",
 "そらんじる": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "そらんずる": "حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "そら恐ろしい": "مُتَوَتِّر",
 "そら来た": "فَهِمْتَ, فَهِمْتِ / فَهِمْتُ",
 "そら涙": "دموع التماسيح (إظهار نفاق للحزن؛ بكاء كاذب أو غير صادق)\nمثال: ذرفت السكرتيرات دموع التماسيح على معضلة المدير",
 "そら覚え": "حِفْظ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "そら豆": "فُول, بَاقِلَّاء",
 "そり": "سدى (الخيط المرتب طولياً على النول ويقطعه اللحمة) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / اعوجاج, انبعاج (شكل مشوه باللي أو الطي) / انحراف (التواء أو شذوذ؛ خاصة طريقة منحرفة أو غير طبيعية في الحكم أو التصرف) / منحنى / زلاجة (مركبة مثبتة على زحافات وتجرها الخيول أو الكلاب؛ للنقل فوق الثلج)",
 "そりあと": "شُعَيْرَات اللِّحْيَة / قَشّ",
 "そりかえり": "سدى (الخيط المرتب طولياً على النول ويقطعه اللحمة) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / اعوجاج, انبعاج (شكل مشوه باللي أو الطي) / انحراف (التواء أو شذوذ؛ خاصة طريقة منحرفة أو غير طبيعية في الحكم أو التصرف)",
 "そりかえる": "سدى (الخيط المرتب طولياً على النول ويقطعه اللحمة) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / اعوجاج, انبعاج (شكل مشوه باللي أو الطي) / انحراف (التواء أو شذوذ؛ خاصة طريقة منحرفة أو غير طبيعية في الحكم أو التصرف)",
 "そりじたおん": "مُرْتَدّ",
 "そりすべり": "تقدم, سير الأمور (التقدم نحو هدف ما) / تزلج بالمزلاجة (رياضة ركوب الزلاجة)\nمثال: كان إقناعه أمراً سهلاً",
 "そりたつ": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "そりゃ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / يَعْنِي, أَي",
 "そりゃあ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / يَعْنِي, أَي",
 "そりゃく": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس) / ثَخِن (ثَخُنَ الشيءُ ثُخونةً وثَخانةً وثِخَنًا، فَهُوَ ثَخِينٌ: كثُفَ وغَلُظ وصَلُبَ)\nمثال: زيري خشن الخلق.",
 "そりゃそうだ": "طَبْعًا",
 "そりゅう": "خَشِنُ الْحُبَيْبَاتِ (ليس ذا قوام ناعم؛ كبير الحبيبات) / حُبَيْبِيّ, مُحَبَّب (مؤلّف من جزيئات تشبه الدقيق في القوام أو مغطّى بها)",
 "そりゅうし": "جُسَيْم أَوَّلِيّ (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى مستحدث))\nمثال: نحن نعيش بعض اللحظات الحزينة حقا لأن بلادنا عانت من خسارة جسيمة. وسوف يستغرق وقتا طويلا قبل أن تعود إلى مجدها السابق.",
 "そりゅうしかそくき": "مُعَجِّل جُسَيْمَات",
 "そりゅうしのそうごさよう": "تفاعل, تفاعل أساسي ((في الفيزياء) نقل الطاقة بين الجسيمات الأولية أو بين جسيم أولي ومجال أو بين المجالات؛ يتوسطه بوزونات قياس)",
 "そりゅうしぶつりがく": "فيزياء الجسيمات (علم الطَّبيعة أو علم الطَّبيعيَّات)\nمثال: تدرس الفيزياء النووية.",
 "そりゅうど": "خَشِنُ الْحُبَيْبَاتِ (ليس ذا قوام ناعم؛ كبير الحبيبات) / حُبَيْبِيّ, مُحَبَّب (مؤلّف من جزيئات تشبه الدقيق في القوام أو مغطّى بها)",
 "そり滑り": "تقدم, سير الأمور (التقدم نحو هدف ما) / تزلج بالمزلاجة (رياضة ركوب الزلاجة)\nمثال: كان إقناعه أمراً سهلاً",
 "そり立つ": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "そり舌音": "مُرْتَدّ",
 "そり跡": "شُعَيْرَات اللِّحْيَة / قَشّ",
 "そる": "سدى (الخيط المرتب طولياً على النول ويقطعه اللحمة) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / اعوجاج, انبعاج (شكل مشوه باللي أو الطي) / انحراف (التواء أو شذوذ؛ خاصة طريقة منحرفة أو غير طبيعية في الحكم أو التصرف) / حَلَقَ (أصاب حَلْقه أو ضربه في حلقه؛ أزال شعر رأسه أو ذقنه كله بالمُوسَى)\nمثال: حلق زيري لحيته.",
 "それ": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ\nمثال: 万一それが起これば、君はどうしますか。 — إن حصل هذا لأي سبب، فماذا ستفعل؟ / آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛ / هُنَاكَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "それいけ": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "それいじょう": "أَبْعَد, أَقْصَى (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني.",
 "それいらい": "مُنْذُ",
 "それかあらぬか": "لَا أَعْلَمُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / لَا أَعْرِف (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / لَسْتُ أَدْرِي / لَا أَدْرِي (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "それが": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ",
 "それがし": "أَحَد (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "それきた": "فَهِمْتَ, فَهِمْتِ / فَهِمْتُ",
 "それきり": "على ذلك, عليه (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: النص والتعليق عليه (يفيد الاستعلاء؛ يفيد التعليل)",
 "それぎり": "على ذلك, عليه (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: النص والتعليق عليه (يفيد الاستعلاء؛ يفيد التعليل)",
 "それこそ": "خُصُوصًا, خَاصَّةً / بِالتَّأْكِيد / كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "それしき": "تافِه",
 "それしゃ": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير. / غَيْشَا",
 "それじしん": "نَفْسُهُ, نَفْسُهَا",
 "それじたい": "لذاته وعينه",
 "それじゃ": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ / فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "それじゃあ": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ / فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "それそうおう": "مُنَاسِب / لَائِق",
 "それそれ": "بل, نعم (ليس ذلك فحسب، بل)\nمثال: أنا بذلك أفرح، بل وسأفرح",
 "それぞれ": "كُلّ",
 "それだから": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "それだけ": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "それだけのかちがある": "جَدِير, مُسْتَحِقّ ((يُسْتَخْدَمُ أَحْيَانًا بِسُخْرِيَةٍ) جَدِيرٌ بِأَنْ يُعَامَلَ بِطَرِيقَةٍ مُعَيَّنَةٍ)",
 "それだけの価値がある": "جَدِير, مُسْتَحِقّ ((يُسْتَخْدَمُ أَحْيَانًا بِسُخْرِيَةٍ) جَدِيرٌ بِأَنْ يُعَامَلَ بِطَرِيقَةٍ مُعَيَّنَةٍ)",
 "それっきり": "لم يعد (ليس الآن) / ليس, ليس أكثر (إشارة إلى الدرجة التي توجد بها صفة معينة)\nمثال: لم تعد موجودة",
 "それっぽい": "هَٰكَذَا, كَذَا / واقعي (مدرك أو يعبر عن إدراك للأشياء كما هي حقاً) / طَبِيعِيّ, وَاقِعِيّ (يمثل الواقع كما هو؛ ليس تجريدياً أو مثالياً) / واقعي (مكون من أو متعلق بالمذهب الفلسفي للواقعية)\nمثال: وصف واقعي",
 "それで": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "それでは": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ / فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "それでも": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / لٰكِن, وَلٰكِنْ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك) / إِلَّا, سِوًى (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / إلَّا, غَيْرَ (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى)\nمثال: لكن لديك أطفال.",
 "それでもって": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "それと": "إِضَافَةً عَلى ذٰلِكَ",
 "それとて": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "それとなく": "بشكل غير مباشر (ليس بطريقة صريحة)\nمثال: أجاب بشكل غير مباشر للغاية",
 "それとなしに": "بشكل غير مباشر (ليس بطريقة صريحة)\nمثال: أجاب بشكل غير مباشر للغاية",
 "それとはなしに": "بشكل غير مباشر (ليس بطريقة صريحة)\nمثال: أجاب بشكل غير مباشر للغاية",
 "それとも": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "それとわかる": "مَحْسُوس, مَكْشُوف (يسهل رؤيته أو اكتشافه) / قَابِلٌ لِلْكَشْف, مُلَاحَظ (يُمْكِنُ كَشْفُهُ أَوِ اكْتِشَافُه)",
 "それと分かる": "مَحْسُوس, مَكْشُوف (يسهل رؤيته أو اكتشافه) / قَابِلٌ لِلْكَشْف, مُلَاحَظ (يُمْكِنُ كَشْفُهُ أَوِ اكْتِشَافُه)",
 "それどころか": "عَلَى الْعَكْس, بِالْعَكْس (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "それな": "بِالضَّبْط, تَمَامًا / بِالْضَبْط",
 "それならそうと": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "それならそれで": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "それなり": "لذاته وعينه",
 "それなりに": "بِشَكْل مَنْطِقِيّ / بشكل معقول",
 "それに": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / عِلَاوَة عَلَى ذٰلِكَ\nمثال: لا أعرف إلا هذا.",
 "それにくわえて": "إِضَافَةً عَلى ذٰلِكَ",
 "それにしても": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "それにつけても": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "それにひきかえて": "عَلَى الْعَكْس, بِالْعَكْس (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "それにもかかわらず": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "それにも拘わらず": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "それにも関わらず": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "それに加えて": "إِضَافَةً عَلى ذٰلِكَ",
 "それに引き替えて": "عَلَى الْعَكْس, بِالْعَكْس (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "それは": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / يَعْنِي, أَي",
 "それはさておき": "بِغَضّ النَظَر عَن (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "それはそうと": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "それはそうとして": "عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "それはそれで": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "それはそれとして": "بِغَضّ النَظَر عَن (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "それはそれは": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "そればかり": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "そればかりか": "إِضَافَةً عَلى ذٰلِكَ",
 "それほど": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "それまで": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان / النِهاية",
 "それみたことか": "قُلْتُ لَكَ ذٰلِكَ, قُلْتُ لَكِ ذٰلِكَ",
 "それも": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك / رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "それもこれも": "كُلّ, جَمِيع",
 "それもそのはず": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "それゆえ": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "それゆえに": "إذن, ثم (لاحقاً أو بعد ذلك بقليل (تستخدم غالباً كروابط للجمل))",
 "それゆけ": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "それよか": "بَدَلًا مِن / أَكْثَر مِن, عَنّ",
 "それより": "بِغَضّ النَظَر عَن (البُغْض ضدّ الحبّ ، بغَض جَدُّك:كتعس جدّك،ونعِمَ الله بك عيناً وبغَض بعدوّك عيناً؛ بغَضَ فلانٌ الشّيءَ أو الشّخصَ:كَرِهَه ومَقَتَه وأعرض عنه)\nمثال: سأذهب بغض النظر عن مجيئه.",
 "それよりも": "بَدَلًا مِن / أَكْثَر مِن, عَنّ",
 "それら": "أُولَٰئِكَ, تِلْكَ",
 "それらしい": "هَٰكَذَا, كَذَا / واقعي (مدرك أو يعبر عن إدراك للأشياء كما هي حقاً) / طَبِيعِيّ, وَاقِعِيّ (يمثل الواقع كما هو؛ ليس تجريدياً أو مثالياً) / واقعي (مكون من أو متعلق بالمذهب الفلسفي للواقعية)\nمثال: وصف واقعي",
 "それる": "شَاذّ, مُنْحَرِف (يختلف اختلافًا واضحًا عن المعيار المقبول) / منحرف (شخص ينحرف سلوكه عما هو مقبول خاصة في السلوك الجنسي)",
 "それを": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "それ以上": "أَبْعَد, أَقْصَى (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني.",
 "それ以来": "مُنْذُ",
 "それ式": "تافِه",
 "それ故": "إِذَنْ, لِذٰلِكَ (و جزاء ينصب الفعل المضارع إذا كان متصدرا غير مفصول عنه)\nمثال: تحتاج لإذن خطي.",
 "それ故に": "إذن, ثم (لاحقاً أو بعد ذلك بقليل (تستخدم غالباً كروابط للجمل))",
 "それ来た": "فَهِمْتَ, فَهِمْتِ / فَهِمْتُ",
 "それ相応": "مُنَاسِب / لَائِق",
 "それ程": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "それ自体": "لذاته وعينه",
 "それ自身": "نَفْسُهُ, نَفْسُهَا",
 "それ行け": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "それ見たことか": "قُلْتُ لَكَ ذٰلِكَ, قُلْتُ لَكِ ذٰلِكَ",
 "それ見た事か": "قُلْتُ لَكَ ذٰلِكَ, قُلْتُ لَكِ ذٰلِكَ",
 "それ迄": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان / النِهاية",
 "そろ": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "そろい": "وَضَع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / غَرَبَ (الجِهَة التي تغرب نحوها الشَمس؛ ضد الشَرْق؛ الأَرَاضِي والبِلَاد التي تقع جهة الغرب في العَالم) / مَجْمُوعَة, طَقْم (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / مَجْمُوعَة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: لقد أزمت الوضع. / بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان مقتنعاً كلياً",
 "そろいぶみ": "تَشْكِيلَة",
 "そろい踏み": "تَشْكِيلَة",
 "そろう": "إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / إهمال, لا مبالاة (صفة عدم الحذر أو عدم بذل الجهد) / مُبَارَاة / شَحّاطَة, شَخَّاطَة / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "そろえ": "محاذاة, موازاة (فعل تعديل أو محاذاة أجزاء جهاز بالنسبة لبعضها البعض) / اِصْطِفَاف, مُحَاذَاة (الخاصية المكانية التي يمتلكها ترتيب أو وضع الأشياء في خط مستقيم أو في خطوط متوازية) / اقتران, محاذاة ((في علم الفلك) التقاء ظاهري أو مرور لجرمين سماويين أو أكثر في نفس الدرجة من البروج) / ائتلاف, تحالف (منظمة من الأشخاص (أو البلدان) المشاركين في ميثاق أو معاهدة)",
 "そろえる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة. / مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "そろそろ": "قَرِيبًا, سَرْعَانَ مَا / بِبُطْء / قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد\nمثال: قد أثلجت كثيرا.",
 "そろって": "كلهم معاً, معاً جميعاً (تستخدم لمجموعة تصرف أعضاؤها أو تم التصرف معهم بشكل جماعي) / في آن واحد, معاً (الجميع في نفس الوقت)\nمثال: تم تجميعهم كلهم معاً",
 "そろっと": "قَرِيبًا, سَرْعَانَ مَا",
 "そろばん": "مِعَد, مِعْدَاد / نَاصِيَة (منبت شعر الغرّة الذي يقع فوق الجبهة مباشرة؛ عن شعر الغرّة) / حَسْب, مُحَاسَبَة (عَدَّ مع الجَمْع والطَرْح وغيرها من العمليات الحِسَابية؛ عند أكثر العامة: هو العَدّ مطلقا)\nمثال: حسب سامي المال.",
 "そろばんがあう": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "そろばんが合う": "دَفَعَ, خَلَّصَ (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه) / معاش, أجر\nمثال: دفع زيري الثمن.",
 "そろばんずく": "مُرْتَزِق, مُؤْجِر",
 "そろばんだかい": "داهِيَة, مُتَآمِر (حاذِق في التَّدْبير والتَّخْطيط بِمَكْر وحِيلَة)",
 "そろばんづく": "مُرْتَزِق, مُؤْجِر",
 "そろばん高い": "داهِيَة, مُتَآمِر (حاذِق في التَّدْبير والتَّخْطيط بِمَكْر وحِيلَة)",
 "そろり": "بسلاسة (بدون مشاكل أو صعوبات) / بسلاسة, بنعومة (بطريقة سلسة ودبلوماسية)\nمثال: نفذ الخطط بسرعة وسلاسة",
 "そろりそろり": "بتسلل, خلسة (بطريقة خفية)\nمثال: تقدموا خلسة عكس التيار",
 "そろわない": "غَيْر كَافٍ, غَيْر مُلَائِم (لفتقار إلى الصفات أو الموارد اللازمة لتلبية مهمة ما) / غير متساوٍ, متفاوت (سيء التوازن أو التوافق في الكمية أو القيمة أو القياس)\nمثال: تدريب غير كافٍ",
 "そわか": "لَا فُضَّ فُوكَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "そわせる": "تَزَوَّجَ / زَوَّجَ (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "そわそわ": "بتململ, بقلق (بطريقة متململة)\nمثال: طقطق مفاصل أصابعه بتململ",
 "そん": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟ / خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة / سَيِّئَة / قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة. / سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ) / أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم) / أصل, سلالة (الاشتقاق الوراثي للفرد) / أجرة الكتابة, سعر السطر (معدل الدفع للمواد المكتوبة التي تقاس وفقاً لعدد الأسطر المقدمة) / عَدَد الأَسْطُر (عدد الأسطر في مادة مطبوعة)\nمثال: كل سلالته كانت محاربين / حَفِيد, حَفِيدَة",
 "そんい": "باتجاه الجنوب الشرقي (إلى أو نحو أو في الجنوب الشرقي) / جَنُوب شَرْقِيّ (يقع في الجنوب الشرقي أو موجَّه نحوه) / قَادِم مِنَ الجَنُوب الشَّرْقِيّ (قادم من اتجاه الجنوب الشرقي) / جنوب شرق (موقع في الجزء الجنوبي الشرقي من بلد أو منطقة أو مدينة)",
 "そんえい": "صُورَة / بُورْتْرِيَّة",
 "そんえき": "حساب الأرباح والخسائر (حساب يتم تجميعه في نهاية الفترة المحاسبية لإظهار الربح أو الخسارة الإجمالية والصافية)",
 "そんえきかんじょう": "حساب الأرباح والخسائر (حساب يتم تجميعه في نهاية الفترة المحاسبية لإظهار الربح أو الخسارة الإجمالية والصافية)",
 "そんえきけいさんしょ": "حساب الأرباح والخسائر (حساب يتم تجميعه في نهاية الفترة المحاسبية لإظهار الربح أو الخسارة الإجمالية والصافية)",
 "そんかい": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة.",
 "そんかん": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "そんがい": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة.",
 "そんがいばいしょう": "إعادة, استرداد (استعادة الشيء مرة أخرى) / إرجاع الحالة, رد الحقوق (فعل إعادة شيء إلى حالته الأصلية) / تعويضات, غرامة تعويضية (مبلغ من المال يُدفع كتعويض عن خسارة أو إصابة)\nمثال: عند إعادة الكتاب إلى صاحبه الشرعي تم توبيخ الطفل",
 "そんがいをあたえる": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة.",
 "そんがん": "مَلَامِح",
 "そんき": "نَبِيل, شريف (اَلذَّكِيُّ؛ اَلنَّجِيبُ) / كَرِيم, شَرِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: إنها امرأة نبيلة. / سَيِّئَة",
 "そんきょ": "انحناء, جثوم (عملية الانحناء المنخفض مع ضم الأطراف للجسم)",
 "そんきん": "خسارة مالية (خسارة المال أو انخفاض في القيمة المالية)",
 "そんけい": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "そんけいしん": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "そんげん": "كَرَامَة, وَقَار (الكرامة هي حق الفرد في أن يكون له قيمة وأن يُحترم لذاته، وأن يُعامل بطريقة أخلاقية)\nمثال: لا يعرض أي إنسان للتعذيب ولا للعقوبات أو المعاملات القاسية أو الوحشية أو الحاطة بالكرامة. / متناقص (يصبح أقل أو أصغر) / متخافت (موسيقى) ((موسيقى) يتناقص في السرعة و/أو الحجم)",
 "そんこう": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا.",
 "そんざい": "وُجُود, كَيْنُونَة (خِلاف العَدَم، وهي الحالة التي يكون الشيء أو الأمر أو الشخص فيها كَائِن ومَوْجُوْد؛ الوجود يقصد به كل ما هو كائن وموجود في الكَوْن)\nمثال: لا وجود للصدف !",
 "そんざいいぎ": "سَبَب الْوُجُود ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سامي كان السبب.",
 "そんざいかち": "سَبَب الْوُجُود ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سامي كان السبب.",
 "そんざいかん": "حُضُور (حُضُور)\nمثال: الحضور هام جدا.",
 "そんざいしゃ": "إِن (يفيد التوكيد)\nمثال: إن شاء الله ؛",
 "そんざいりゆう": "سَبَب الْوُجُود ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سامي كان السبب.",
 "そんざいりょう": "كَثْرَة, غَزَارَة / جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها) / مَخْزُون / مَرَقَة, حَسَاء (الطَعَام السائل الخفيف فيه ماء اللحم وقد يكون فيه خضار أو غير ذلك. يؤكل عادة مع الرز أو الخبز. يجوز قول مَرَق، والمَرَقَة أخص من المرَق) / مَنْثُور / قَنْدَاق\nمثال: كان سامي جرد طفل.",
 "そんざいろん": "أُنْطُولُوجِيَّا, عِلْم الْوُجُود",
 "そんし": "مُعَلِّم رُوحِيّ, جُورُو (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "そんしつ": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة",
 "そんしつがく": "خسائر, خسائر المقامرة (شيء مفقود (خاصة المال المفقود في المقامرة))",
 "そんしゃ": "جَلِيل, مُبَجَّل (محلّ احترام وتبجيل عميقين) / مَهِيب, وَقُور (مثير للإعجاب والتبجيل بسبب عراقته وقِدَمه)",
 "そんしょう": "عُطْل, ضَرَر (أوقف أو جعل شيء غير فعال لفترة معينة؛ إيقاف شيء عن العمل أو تركه بدون استخدام أو اهتمام)\nمثال: ذهب سامي في عطلة. / قَرْيَة, كَفْر (الضَيْعَة والمِصْر والبَلَد، كل مكان اتصلت به الأبنية وجمع الناس؛ المَدِينَة التي لا سور لها. ونادر)\nمثال: هذه القرية مملة.",
 "そんしょく": "جودة منخفضة, دونية (جودة متدنية) / دونية, وضع أدنى (صفة كون الشخص في وضع تنافسي أضعف) / دونية, مكانة أدنى (حالة كونه أدنى)",
 "そんしょくがない": "أَبَدًا",
 "そんしょくない": "أَبَدًا",
 "そんしょくのない": "أَبَدًا",
 "そんしん": "تبجيل, تعظيم (عمل يظهر الاحترام (خاصة الانحناء)) / إجلال, توقير (موقف ذهني يتسم بالتبجيل والإجلال) / خشية, هيبة (شعور بالاحترام العميق لشخص أو شيء ما)\nمثال: خشية الله",
 "そんじ": "اِنْزَلَقَ",
 "そんじゃ": "ضيف الشرف (الشخص الذي يُعقد التجمع تكريماً له) / فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ / فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "そんじゃあ": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ / فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "そんじょそこら": "أي مكان, في أي مكان (في أو عند أو إلى أي مكان)\nمثال: يمكنك العثور على هذا الطعام في أي مكان / شَائِع",
 "そんじる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / أَفْسَدَ / دَلَّلَ, غَنَّجَ (دلل: أَدَلَّ عَلَيْهِ وتَدَلَّلَ: انْبَسَطَ؛ قالَ ابْنُ دُرَيْدٍ: أَدَلَّ عَلَيْهِ وَثِق بِمَحَبَّتِهِ فأَفْرَط عَلَيْهِ) / فَسَدَ, نَتِنَ\nمثال: دلل سامي صديقته. / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "そんすう": "تبجيل, تعظيم (عمل يظهر الاحترام (خاصة الانحناء)) / إجلال, توقير (موقف ذهني يتسم بالتبجيل والإجلال) / خشية, هيبة (شعور بالاحترام العميق لشخص أو شيء ما)\nمثال: خشية الله",
 "そんする": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته. / إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر / ضَرَرٌ / ضَرَّ أَضَرَّ / وُجِدَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه. (يتعدى بعلى))\nمثال: وجد ياني هاتفه. / تَكَوَّنَ / تَأَلَّفَ (فعل مطاوعة من ألَّفَ؛ من كذا: تكّون من هذه الأجزاء، يستخدم للأجزاء الغير منفصلة والتي يكون مجموعها هو الشيء المتألف) / أَبْقَى / أَدَامَ / بَقَّى / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ) / رَعَى / صانَ\nمثال: حفظ رقم هاتفها.",
 "そんずる": "اِنْكَسَرَ (فعل مطاوعة لكَسَرَ، قام أحدهم بكَسْره أو قام هو بكَسْر نفسه؛ التاجر: خَسِرَ المال ونَقَصَ عنده المال، أفْلَسَ) / كَسَرَ / اِسْتِرَاحَة (مبنى خارج المدن يتوقف فيه المسافرون للراحة والتَزَوُّد يُجمع على اِسْتِرَاحَات)\nمثال: عليك أخذ استراحة. / أَفْسَدَ / دَلَّلَ, غَنَّجَ (دلل: أَدَلَّ عَلَيْهِ وتَدَلَّلَ: انْبَسَطَ؛ قالَ ابْنُ دُرَيْدٍ: أَدَلَّ عَلَيْهِ وَثِق بِمَحَبَّتِهِ فأَفْرَط عَلَيْهِ) / فَسَدَ, نَتِنَ\nمثال: دلل سامي صديقته. / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "そんそ": "طَرَف / حَفْلَة, اِحْتِفَال",
 "そんそせっしょう": "دبلوماسية, مفاوضات دبلوماسية (تفاوض بين الدول)",
 "そんぞく": "استمرار, مواصلة (فعل الاستمرار في نشاط ما دون انقطاع) / استمرار, مدة (خاصية البقاء أو الاستمرار في الزمن) / استمرارية, فترة بقاء (الفترة الزمنية التي يستمر خلالها شيء ما) / مُسَيْطِر, مُهَيْمِن (الأَكْثَر قُوَّةً أَوْ أَهَمِّيَّةً أَوْ تَأْثِيرًا) / صَاعِد, مُتَصَاعِد (يَمِيلُ أَوْ يَتَّجِهُ نَحْوَ الأَعْلَى) / جد, سلف (شخص تنحدر منه (لكنه عادة أبعد من الجد)) / صعود, هيمنة (موقف أو حالة الهيمنة أو السيطرة)\nمثال: تلك الفكرة كانت في صعود",
 "そんぞくさつ": "قتل أحد الوالدين (قتل الشخص لأبيه أو أمه) / قاتل أحد الوالدين (شخص يقتل والده أو والدته)",
 "そんぞくさつじん": "قتل أحد الوالدين (قتل الشخص لأبيه أو أمه) / قاتل أحد الوالدين (شخص يقتل والده أو والدته)",
 "そんたい": "صُورَة / اِنْطِبَاع, سُمْعَة",
 "そんたく": "افْتِرَاض, تَخْمِين (رسالة تعبر عن رأي يستند إلى أدلة غير كاملة) / احترام, توقير (تعبير مهذب (بالقول أو الفعل) عن التقدير) / إذعان, امتثال (استعداد أو ميل للخضوع لإرادة الآخرين) / احترام, توقير (مراعاة مهذبة لمشاعر الناس)\nمثال: كان توقيره لرغباتها ممتعاً للغاية",
 "そんだい": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / مُتَعَالٍ, الْمُتَعَالِي",
 "そんだけ": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان",
 "そんち": "حَافَظَ",
 "そんちょう": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "そんで": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "そんでもって": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "そんとくなし": "مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "そんな": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "そんなぐあいに": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
