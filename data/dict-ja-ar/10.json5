 "ちくじつ": "يوماً بعد يوم, يومياً (تدريجياً وبشكل تقدمي)\nمثال: ضعفت صحته يوماً بعد يوم",
 "ちくじてき": "مُتَتَالٍ, مُتَسَلْسِل (في تتابع منتظم دون فجوات)",
 "ちくじょう": "مَعْقِل (الملجأ والجبل المرتفع)\nمثال: رغم أن إيران مشهورة بأنها معقل الفكر الشيعي في عصرنا، إلا أن معظم أهلها كانوا من السنة حتى القرن الخامس عشر.",
 "ちくせき": "تجميع, تراكم (عملية التراكم)",
 "ちくぜんに": "يخنة دجاج (يخنة مصنوعة من الدجاج)",
 "ちくぞう": "بِنَاء, تَشْيِيد (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "ちくちく": "تنميل, وخز (إحساس جسدي يشبه العديد من اللسعات الصغيرة)",
 "ちくちくいたむ": "حسكة, شوكة (طرف صغير مدبب حاد يشبه السنبلة على ساق أو ورقة)",
 "ちくちく痛む": "حسكة, شوكة (طرف صغير مدبب حاد يشبه السنبلة على ساق أو ورقة)",
 "ちくっと": "وخز (فعل الثقب بنقطة صغيرة)\nمثال: أعطى البالون وخزة صغيرة / قَلِيلًا",
 "ちくてい": "جسر ترابي, ساتر ترابي (كومة اصطناعية طويلة من الحجر أو التراب؛ تبنى لحجز المياه أو لدعم طريق أو للحماية) / تنسيق الحدائق (العمل كبستاني مناظر طبيعية)",
 "ちくてん": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة)\nمثال: الطيران أسرع وسيلة سفر.",
 "ちくでん": "طَيَرَان (التَحْليِق والسِبَاحَة في الجَوّ؛ للطَيَّار: قيادة الطَائِرَة)\nمثال: الطيران أسرع وسيلة سفر.",
 "ちくでんき": "مُكَثِّف, مُكَثِّفَة",
 "ちくでんち": "بطارية تخزين, مركم (بطارية فولتية تخزن الشحنة الكهربائية)",
 "ちくと": "وخز (فعل الثقب بنقطة صغيرة)\nمثال: أعطى البالون وخزة صغيرة / قَلِيلًا",
 "ちくにく": "لَحْم, لحمة (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم…)\nمثال: أفضل لحم البقر.",
 "ちくねん": "سنوياً, كل سنة (دون تفويت سنة)\nمثال: يسافرون إلى الصين سنوياً",
 "ちくのうしょう": "تجمع قيحي, دبيلة (تجمع للقيح في تجويف الجسم (خاصة في تجويف الرئة))",
 "ちくはく": "تَارِيخ, تاريخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟ / ناجي, ناجيا (شجرة متوسطة الحجم ذات أوراق رمحية لامعة؛ جنوب الصين إلى تايوان وجنوب اليابان)",
 "ちくば": "كُرْسُوع, أَبُو الْمَغَازِل",
 "ちくび": "حَلَمَة",
 "ちくふん": "رَوْث",
 "ちくまはっか": "قَطْرَمْ",
 "ちくよう": "إنجاب, تكاثر (النشاط الجنسي للحمل وإنجاب النسل)",
 "ちくり": "تنميل, وخز (إحساس جسدي يشبه العديد من اللسعات الصغيرة) / إفشاء, وشاية (كشف معلومات أو تقديم أدلة عن شخص آخر)",
 "ちくりちくり": "تنميل, وخز (إحساس جسدي يشبه العديد من اللسعات الصغيرة)",
 "ちくりま": "نمّام, واشٍ (شخص يثرثر بشكل غير حكيم)",
 "ちくる": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ)\nمثال: أخبر سامي أباه.",
