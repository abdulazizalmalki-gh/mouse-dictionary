 "たみ": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه.",
 "たみくさ": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه.",
 "たみぐさ": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس)\nمثال: ضحك الناس عليه.",
 "たみんぞく": "مُتَعَدِّدُ الأَعْرَاق (يتكوّن من أعراق متعدّدة أو يمثّلها)",
 "たむかい": "مُقَاوَمَة",
 "たむける": "اِقْتِرَاح\nمثال: اقترح سامي المساعدة.",
 "たむし": "سَعْفَة, قَرَع",
 "たむら": "جمع, حصد (فعل جمع شيء ما)\nمثال: طالبوا بالحق في التجمع / مَرْكَز شُرْطَة, مَرْكِز شُرْطَة (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "たむろ": "جمع, حصد (فعل جمع شيء ما)\nمثال: طالبوا بالحق في التجمع / مَرْكَز شُرْطَة, مَرْكِز شُرْطَة (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "たむろう": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "たむろす": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "たむろする": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "ため": "حَسَن, جَيِّد (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة. / غاية, غَرَض / عَاقِبَة / مُؤَثِّر, مُبَكٍّ (يثير المشاعر والعواطف) / بِئْر تَسْرِيب, بَيَّارَة صَرْف / نَفْسَهُ, نَفْسَهَا",
 "ためいき": "تَنَهَّدَ",
 "ためいきをつく": "تَنَهَّدَ",
 "ためいけ": "حَوْض, جَابِيَة (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا.",
