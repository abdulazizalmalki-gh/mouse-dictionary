 "ほちょう": "خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة\nمثال: そんな速く歩かないでください。あなたと歩調をそろえることはできません。 — ارجوك لا تمشي بسرعة هكذا، لا استطيع مجاراة سرعتك في المشي.",
 "ほちょうき": "سَمَّاعَةُ أُذُن, مُسَاعَدَات سَمْع",
 "ほっかい": "بَحَر اَلشَّمَال (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر. / هُوكَايْدُو, هُكَّايْدُو",
 "ほっかいどう": "هُوكَايْدُو, هُكَّايْدُو",
 "ほっかいどういぬ": "هُوكَايْدُو, هُكَّايْدُو",
 "ほっかいどうけん": "هُوكَايْدُو, هُكَّايْدُو",
 "ほっかり": "فَجْأَةً / عَرِيض",
 "ほっかん": "كُورِيَا الشَّمَالِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "ほっき": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / عَزْم, عُزْم / دِقَّة",
 "ほっきにん": "مُرَوِّج",
 "ほっきょう": "كِيُوتُو",
 "ほっきょく": "اَلْقُطْب اَلشَّمَالِيّ\nمثال: 北極圏とは北極周辺の地域の事である。 — المنطقة القطبية هي تلك الواقعة حول القطب الشمالي. / قُطْبِيّ شَمَالِيّ",
 "ほっきょくかい": "الْمُحِيط الْمُتَجَمِّد الشَّمَالِيّ, الْمُحِيط الشَّمَالِيّ",
 "ほっきょくぐま": "دُبّ أَبْيَض, دُبَّة بَيْضَاء",
 "ほっきょくけん": "الدَّائِرَة الْقُطْبِيَّة الشَّمَالِيَّة\nمثال: 北極圏とは北極周辺の地域の事である。 — المنطقة القطبية هي تلك الواقعة حول القطب الشمالي.",
 "ほっきょくこう": "شفق قطبي ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "ほっきょくせい": "الجُدَيّ, نَجْم الشَمَال",
 "ほっきょくせん": "الدَّائِرَة الْقُطْبِيَّة الشَّمَالِيَّة",
 "ほっきょくちほう": "قُطْبِيّ شَمَالِيّ",
 "ほっきょくてん": "اَلْقُطْب اَلشَّمَالِيّ",
 "ほっきょくよう": "الْمُحِيط الْمُتَجَمِّد الشَّمَالِيّ, الْمُحِيط الشَّمَالِيّ",
 "ほっく": "هَايْكُو",
 "ほっこう": "شفق قطبي ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "ほっこり": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "ほっさ": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "ほっし": "أُقْنُوم / فَرْد",
 "ほっしん": "طَفْح, طَفْح جِلْدِيّ",
 "ほっする": "أَرَادَ, رَغِبَ (شَاءَ الشيءَ، رَغِبَ فيه؛ أَحَبَّ، شَهِيَ، اِشْتَهَى. (تخصيص))\nمثال: أراد مني الكذب.",
 "ほっそく": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "ほっそり": "نَحِيل / نَحِيف / أَهْيَف",
 "ほったてごや": "كُوخ, تَخْشِيبَة",
 "ほったて小屋": "كُوخ, تَخْشِيبَة",
 "ほったらかし": "أَهْمَلَ / إِهْمَال",
 "ほったらかしにする": "أَهْمَلَ / إِهْمَال",
 "ほったらかす": "أَهْمَلَ / إِهْمَال",
 "ほったん": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل",
 "ほっておく": "تَجَاهَلَ, طَنَّش",
 "ほっとう": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل / مُرَوِّج",
 "ほっとうにん": "مُرَوِّج",
 "ほっとく": "تَجَاهَلَ, طَنَّش",
 "ほっぴょうよう": "الْمُحِيط الْمُتَجَمِّد الشَّمَالِيّ, الْمُحِيط الشَّمَالِيّ",
 "ほっぺ": "خَدّ (شَقَّ أو حَفَرَ في الأرض خطاً طويلاً أو أثراً عميقاً؛ أثَّر على سطحٍ ما بترك علامات أو شقوق) / وَجْنَة\nمثال: قبلتني على الخد.",
 "ほっぺた": "خَدّ (شَقَّ أو حَفَرَ في الأرض خطاً طويلاً أو أثراً عميقاً؛ أثَّر على سطحٍ ما بترك علامات أو شقوق) / وَجْنَة\nمثال: قبلتني على الخد.",
 "ほっほう": "وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة!",
 "ほっぽう": "شَمَال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب) / شمال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "ほっぽうよんとう": "مُقَاطَعَة شَمَالِيَّة",
 "ほっぽうりょうど": "مُقَاطَعَة شَمَالِيَّة",
 "ほっぽうわ": "اَللُّغَة اَلصِّينِيَّة اَلشَّمَالِيَّة, مَنْدَرِينِيَّة",
 "ほっぽかす": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "ほっぽらかす": "أَهْمَلَ / إِهْمَال",
 "ほっぽりだす": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "ほっぽり出す": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "ほっぽる": "عَلَاقَة سَرِيعَة, علاقة طيارى / صَبَّ, رَمَّى (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون)\nمثال: صب الشاي لضيفك. / اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "ほつがん": "صَلَّى, دَعَا",
 "ほつぎ": "طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "ほつご": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "ほつす": "أَرْخَى, حَلَّ",
 "ほつねつ": "حُمَّة, حُمَّى",
 "ほてい": "أَصْلَحَ",
 "ほてつ": "أَصْلَحَ / بَدِيل اِصْطِنَاعِيّ, طَرَف اِصْطِنَاعِيّ",
 "ほてり": "أَشَعَّ ((أَشَعَّتِ) الشمسُ: نَشَرَتْ شْعاعها؛ أَشَعَّتِ النارُ: أَرسلت ضوءها وحرارتها)\nمثال: أشع الإسبرانتو!",
 "ほてる": "شطف (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن أن تعني إزالة ما علق بالشيء من أوساخ أو شوائب)",
 "ほてん": "غِطَاء / غِلَاف / غَطَّى",
 "ほとおりぼし": "كَوْكَبَة / قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "ほとおり星": "كَوْكَبَة / قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "ほとけ": "بُوذَا, بُدّ / مَيِّت",
 "ほとけごころ": "رَحْمَة, رَأْفَة / رَحْمَة, شَفَقَة",
 "ほとけさま": "بُوذَا, بُدّ",
 "ほとけさん": "بُوذَا, بُدّ",
 "ほとけしょう": "رَحْمَة / شَفَقَة (وشَفِقَ على؛ الرحمة والعَطْف والحَنَان والحُنُوّ)\nمثال: زيري مثير للشفقة.",
 "ほとけになる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "ほとばしり": "اِنْدِفَاق, اِنْصِبَاب / تَدَفُّق",
 "ほとほと": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا .",
 "ほとほりぼし": "كَوْكَبَة / قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "ほとめく": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "ほとり": "جَانِب / صَفْحَة",
 "ほとんど": "تَقْرِيبًا, عَلَى وَشْك / بِٱلْكَاد / أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "ほど": "اِتِّسَاع, مَدَّى / حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ) / نِهَايَة / حَدَّ, حَدَّدَ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما. / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "ほどあい": "اِعْتِدَال (الوَسَطِيَّة، يقابله التَطَرُّف؛ التَنَاسُب وأن يكون الأمر عَدْلا، يقابله الاِنْقِلاب) / إِشْرَاف\nمثال: الاعتدال هو اليوم الذي يتساوى به الليل و النهار بنفس المدة.",
 "ほどう": "مَمْشًى, مَسار الْشَاة",
 "ほどく": "فَكَّ",
 "ほどこし": "مُنَظَّمَة خَيْرِيَّة / صَدَقَة / إِحْسَان",
 "ほどこしもの": "صَدَقَة, خَيْر",
 "ほどこす": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟ / وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / طَبَّقَ (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: لقد أزمت الوضع. / خِنْزِيرَة / زَرَعَ, بَذَرَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت.",
 "ほどちかい": "قَرِيب / قَرِيبًا / بِٱلْقُرْب مِنَ, عِنْدَ / قَرُبَ (أَدْنَى؛ قدَّرَ)\nمثال: جلست بالقرب منها.",
 "ほどなく": "قَرِيبًا, سَرْعَانَ مَا",
 "ほどなくして": "قَرِيبًا, سَرْعَانَ مَا",
 "ほどに": "كَـ, مِثْل / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / لِأَنَّ / هكذا, بلا سبب",
 "ほどほど": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "ほどよい": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "ほどよく": "كَمَا يَجِب, كَمَا يَنْبَغِي",
 "ほど良く": "كَمَا يَجِب, كَمَا يَنْبَغِي",
 "ほど近い": "قَرِيب / قَرِيبًا / بِٱلْقُرْب مِنَ, عِنْدَ / قَرُبَ (أَدْنَى؛ قدَّرَ)\nمثال: جلست بالقرب منها.",
 "ほな": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "ほなら": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "ほにゅう": "رَضِيع",
 "ほにゅうどうぶつ": "ثَدْيِيّ",
 "ほにゅうるい": "ثَدْيِيّ\nمثال: イルカは哺乳類の一種です。 — الدلفين نوع من الثدييات.",
 "ほね": "عَظْم / عضم / عَظْمَة / عضمة / أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ) / وَرَّطَ / لَقْطَة\nمثال: دهنت أطر النافذة بالأصفر. / لَخَّصَ, اِخْتَصَرَ / عَمُود فَقْرِيّ / دِعَامَة / شَجَاعَة",
 "ほねおしみ": "كَسَل",
 "ほねおり": "أَلَمٌ (الوَجَع) / آلَمَ, يُؤْلِمُ (سبَّبَ أَلَمًا حسّيًّا أو وجعًا في الجسد؛ سَبَّبَ له الألَم)\nمثال: ألم أقل لك ذلك؟",
 "ほねぐみ": "هَيْكَل عَظْمِيّ, هَيْكَل / أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ) / وَرَّطَ / لَقْطَة\nمثال: دهنت أطر النافذة بالأصفر. / لَخَّصَ, اِخْتَصَرَ",
 "ほねっぷし": "مُشْتَرَك / مِفْصَل / عَمُود فَقْرِيّ / دِعَامَة / شَجَاعَة",
 "ほねっぽい": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "ほねつき": "هَيْكَل عَظْمِيّ, هَيْكَل",
 "ほねになる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "ほねぬき": "عَظْم / عضم / عَظْمَة / عضمة / تَخْفِيف",
 "ほねのおれる": "شَاق",
 "ほねぶし": "مُشْتَرَك / مِفْصَل",
 "ほねぶと": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / جَامِد\nمثال: هذا التخت جدا صلب.",
 "ほねぶとい": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / جَامِد\nمثال: هذا التخت جدا صلب.",
