{
 "そくりょうか": "مساح, مهندس مساحة (مهندس يحدد حدود وارتفاعات الأراضي أو الهياكل) / ماسح إحصائي (شخص يجري مسحًا إحصائيًا)",
 "そくりょうがく": "مساحة, مسح الأراضي (ممارسة قياس الزوايا والمسافات على الأرض بحيث يمكن رسمها بدقة على خريطة)\nمثال: درس المساحة في الكلية",
 "そくりょうき": "أداة مسح (أداة يستخدمها المساحون)",
 "そくりょうきかい": "أداة مسح (أداة يستخدمها المساحون)",
 "そくりょうぎし": "مساح, مهندس مساحة (مهندس يحدد حدود وارتفاعات الأراضي أو الهياكل) / ماسح إحصائي (شخص يجري مسحًا إحصائيًا)",
 "そくりょく": "سُرْعَة",
 "そくりょくど": "سُرْعَة",
 "そくろ": "طريق خدمات (طريق محلي يمتد بموازاة طريق سريع ويسمح لحركة المرور المحلية بالوصول إلى الممتلكات)",
 "そくろう": "ممر (ممر بين مناطق الجلوس كما في قاعة المحاضرات أو مركبة الركاب أو بين مناطق رفوف البضائع كما في المتاجر) / رواق كنيسة, ممر جانبي (جزء من الكنيسة مفصول جانبياً عن الصحن الرئيسي بصفوف من الأعمدة أو السواري) / ممر (ممر ضيق طويل (كما في كهف أو غابة))",
 "そくわんしょう": "جَنَف (مَالَ عَنِ الحَقِّ أَوِ العَدْلِ؛ عَدَلَ عَنْهُ وَابْتَعَدَ وَمَالَ)",
 "そくハメ": "إكستاسي سائل, غوب (أسماء دارجة لـ جاما هيدروكسي بيوتيريت)",
 "そぐ": "تفتيت, شطف (عملية شطف جزء من شيء ما) / شيب, ضربة قصيرة منخفضة ((غولف) ضربة اقتراب منخفضة ومتدحرجة) / رقاقة, رقاقة دقيقة (معدات إلكترونية تتكون من بلورة صغيرة من شبه موصل السيليكون مصنعة لتنفيذ عدد من الوظائف الإلكترونية في دائرة متكاملة) / رقاقة بوكر, فيشة (عداد صغير على شكل قرص يستخدم لتمثيل المال عند المقامرة) / شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو عاطفية لتحقيق هدف معين) / قَلَّلَ",
 "そぐう": "مُبَارَاة / شَحّاطَة, شَخَّاطَة",
 "そぐわない": "غَيْرُ لَائِق, غَيْرُ مَرْغُوب (غير جدير بالاختيار خاصة كشريك زواج) / غَيْرُ مُلَائِم (لَيْسَ مُعَدًّا أَوْ مُكَيَّفًا لِغَرَضٍ مُعَيَّنٍ) / غَيْر مُلَائِم (لا يُساعد على التنشئة الأخلاقية السليمة) / غَيْرُ قَابِلٍ لِلتَّطْبِيقِ (لا يمكن تطبيقه)",
 "そけい": "أصل, نموذج بدئي (شيء يعمل كنموذج أو أساس لعمل نسخ)\nمثال: هذه اللوحة نسخة من الأصل / أُرْبِيَّة, مَغْبَن",
 "そけいかん": "قناة أربية (ممر مائل عبر جدار البطن السفلي؛ في الذكور هو الممر الذي تنزل عبره الخصيتان إلى كيس الصفن ويحتوي على الحبل المنوي؛ وفي الإناث ينقل الرباط المستدير…)",
 "そけいぶ": "أُرْبِيَّة, مَغْبَن",
 "そけいヘルニア": "فتق إربي (فتق تدخل فيه حلقة من الأمعاء القناة الإربية؛ وهو النوع الأكثر شيوعاً من الفتق عند الذكور)",
 "そけいリンパにくがしゅ": "ورم حبيبي لمفي منقول جنسيا (مرض معد تسببه فصيلة من بكتيريا الكلاميديا؛ ينتقل عن طريق الاتصال الجنسي؛ يتميز بآفات تناسلية وتورم الغدد اللمفاوية في الفخذ)",
 "そけいリンパにくげしゅ": "ورم حبيبي لمفي منقول جنسيا (مرض معد تسببه فصيلة من بكتيريا الكلاميديا؛ ينتقل عن طريق الاتصال الجنسي؛ يتميز بآفات تناسلية وتورم الغدد اللمفاوية في الفخذ)",
 "そけい部": "أُرْبِيَّة, مَغْبَن",
 "そけん": "رعي, قضم الأوراق (فعل التغذية عن طريق القضم المستمر) / تصفح (القراءة بشكل سطحي أو عشوائي)",
 "そげおとす": "أَجَاص / عَوِينَة / عَوِينَة مُجَفَّفَة / خَوْخ مُجَفَّف / شَذَبَ, قَضَبَ",
 "そげき": "رِمَايَة",
 "そげきしゅ": "قَنَّاص (صيغة مبالغة من قَنَصَ. وقد تستخدم بمعنى قَانِص؛ الذي مهنته القَنْص، أي صيد الغِزْلان وغيرها من حيوان البَرِّيَّة)",
 "そげきじゅう": "قَنَّاصَة",
 "そげきへい": "قَنَّاص (صيغة مبالغة من قَنَصَ. وقد تستخدم بمعنى قَانِص؛ الذي مهنته القَنْص، أي صيد الغِزْلان وغيرها من حيوان البَرِّيَّة)",
 "そげな": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "そげる": "انفصل / تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "そげ落とす": "أَجَاص / عَوِينَة / عَوِينَة مُجَفَّفَة / خَوْخ مُجَفَّف / شَذَبَ, قَضَبَ",
 "そこ": "هُنَاكَ\nمثال: １時間以内にそこに着くでしょう。 — سنصل إلى هناك بعد ساعة. / هُنَاكَ / آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما.",
 "そこあげ": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع) / مُتَزَايِد, مُرْتَفِع (يزداد في الكمّيّة أو القيمة) / تنشئة, رعاية (الخصائص المكتسبة نتيجة للطريقة التي عوملت بها كطفل) / ارتفاع, رفع (حدث رفع شيء ما إلى الأعلى)\nمثال: ارتفاع في درجة الحرارة بعد الظهر",
 "そこいじがわるい": "خَبِيث, كَيْدِيّ (له طبيعة الخبث أو ناتج عنه)\nمثال: نميمة خبيثة",
 "そこいじわるい": "خَبِيث, كَيْدِيّ (له طبيعة الخبث أو ناتج عنه)\nمثال: نميمة خبيثة",
 "そこいら": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / في ذلك الجوار, هناك تقريباً (بالقرب من ذلك المكان) / في ذلك الوقت تقريباً (بالقرب من ذلك الوقت أو التاريخ)\nمثال: أقام في لندن أو جوارها لعدة أسابيع",
 "そこいらじゅう": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "そこいら中": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "そこう": "تصرف, سلوك (طريقة التصرف أو التحكم بالنفس) / سلوك ((علم النفس) مجموع الاستجابات أو ردود الفعل أو الحركات التي يقوم بها الكائن الحي في أي موقف) / تصرف, سلوك ((السمات السلوكية) الطريقة التي يتصرف بها الشخص تجاه الآخرين) / أداء, تصرف (فعل أو رد فعل شيء ما (مثل آلة أو مادة) تحت ظروف محددة)\nمثال: يمكن دراسة سلوك الجسيمات الصغيرة في التجارب / جد, سلف (مؤسس العائلة) / جَدّ, سَلَف (شخص من زمن سابق ساهم في التقاليد التي تشترك فيها مجموعة ما)\nمثال: حافظوا على إيمان أجدادنا",
 "そこうお": "قاعي المعيشة (من أو متعلق بالأسماك والحياة البحرية التي تعيش في قاع المسطح المائي)",
 "そこうがおさまらない": "فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف)",
 "そこうしょうがい": "سِي دِي",
 "そこうふりょう": "سوء تصرف, سوء سلوك (سلوك غير لائق أو شرير أو غير أخلاقي)",
 "そこかしこ": "هُنَا وَهُنَاكَ",
 "そこから": "مِن هُنَاكَ, ثَمَّ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "そこがわ": "وَحِيد / عَزْب / أَخْمُص, بَاطِن القَدَم / نَعْل / سَمَك مُوسَى (سَمَك جمع سَمَكَة، كما تجمع سمكة أسماك)\nمثال: سمكة ميناد ماتت",
 "そこきみわるい": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب",
 "そこく": "وَطَن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "そこくあい": "وَطَنِيَّة, مَحَبَّةْ وَطَن",
 "そこここ": "هُنَا وَهُنَاكَ",
 "そこしれず": "عَارِي النِّصْف السُّفْلِيّ (غير مكسوّ خاصة أسفل الخصر) / بِلَا قَاع, لَا قَعْرَ لَهُ (بَالِغُ العُمْقِ إِلَى أَقْصَى حَدٍّ) / لَا قَرَار لَهُ, لَا قَعْرَ لَهُ (عَميق إلى حَدّ لا نِهائِيّ؛ بِلا قاع) / بلا قاع (ليس له قاع)\nمثال: بيجاما بلا جزء سفلي تتكون ببساطة من قميص طويل يفتح من الأمام",
 "そこしれない": "عَارِي النِّصْف السُّفْلِيّ (غير مكسوّ خاصة أسفل الخصر) / بِلَا قَاع, لَا قَعْرَ لَهُ (بَالِغُ العُمْقِ إِلَى أَقْصَى حَدٍّ) / لَا قَرَار لَهُ, لَا قَعْرَ لَهُ (عَميق إلى حَدّ لا نِهائِيّ؛ بِلا قاع) / بلا قاع (ليس له قاع)\nمثال: بيجاما بلا جزء سفلي تتكون ببساطة من قميص طويل يفتح من الأمام",
 "そこしれぬ": "عَارِي النِّصْف السُّفْلِيّ (غير مكسوّ خاصة أسفل الخصر) / بِلَا قَاع, لَا قَعْرَ لَهُ (بَالِغُ العُمْقِ إِلَى أَقْصَى حَدٍّ) / لَا قَرَار لَهُ, لَا قَعْرَ لَهُ (عَميق إلى حَدّ لا نِهائِيّ؛ بِلا قاع) / بلا قاع (ليس له قاع)\nمثال: بيجاما بلا جزء سفلي تتكون ببساطة من قميص طويل يفتح من الأمام",
 "そこそこ": "بِشَكْل مَنْطِقِيّ / بشكل معقول / بسرعة, بعجلة (بطريقة سريعة أو متسرعة)\nمثال: الطريقة التي دفنوه بها بسرعة كانت معيبة / حَوَالَيْ, تَقْرِيبًا",
 "そこぢから": "إمكانية, قابلية (استعداد يمكن تطويره) / إمكانية, قدرة كامنة (القدرة الكامنة على التحقق في الوجود)",
 "そこつ": "غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "そこつち": "تربة تحتية, طبقة تحت التربة (طبقة التربة بين التربة السطحية والصخر الأساس)",
 "そこで": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ",
 "そこな": "هُنَاكَ",
 "そこなう": "ضَرَرٌ / ضَرَّ أَضَرَّ",
 "そこなし": "عَارِي النِّصْف السُّفْلِيّ (غير مكسوّ خاصة أسفل الخصر) / بِلَا قَاع, لَا قَعْرَ لَهُ (بَالِغُ العُمْقِ إِلَى أَقْصَى حَدٍّ) / لَا قَرَار لَهُ, لَا قَعْرَ لَهُ (عَميق إلى حَدّ لا نِهائِيّ؛ بِلا قاع) / بلا قاع (ليس له قاع)\nمثال: بيجاما بلا جزء سفلي تتكون ببساطة من قميص طويل يفتح من الأمام",
 "そこに": "ثقل الموازنة, صابورة (أي مادة ثقيلة تستخدم لتثبيت سفينة أو منطاد) / كابح, موازن ضوء (جهاز كهربائي لبدء وتنظيم مصابيح الفلورسنت والتفريغ) / كابح, مقاومة الموازنة (مقاومة تدرج في دائرة لتعويض التغييرات (مثل تلك الناشئة عن تقلبات درجات الحرارة)) / ثبات, رزانة (سمة تميل لإعطاء الاستقرار في الشخصية والأخلاق؛ شيء يثبت العقل أو المشاعر)",
 "そこぬけ": "عَارِي النِّصْف السُّفْلِيّ (غير مكسوّ خاصة أسفل الخصر) / بِلَا قَاع, لَا قَعْرَ لَهُ (بَالِغُ العُمْقِ إِلَى أَقْصَى حَدٍّ) / لَا قَرَار لَهُ, لَا قَعْرَ لَهُ (عَميق إلى حَدّ لا نِهائِيّ؛ بِلا قاع) / بلا قاع (ليس له قاع)\nمثال: بيجاما بلا جزء سفلي تتكون ببساطة من قميص طويل يفتح من الأمام / بِلَا حُدُود, لَامَحْدُود (يَبْدُو بِلَا حُدُودٍ فِي الكَمِّيَّةِ أَوِ العَدَدِ أَوِ الدَّرَجَةِ أَوِ المَدَى) / طَائِش, مُتَهَوِّر (يَفْتَقِر إِلَى ضَبْط النَّفْس الحَكِيم) / غير حكيم, متهور (ليس حكيماً أو عاقلاً)\nمثال: تهور كبير من والدتها أن تشجعها على مثل هذه الأفكار الرومانسية السخيفة",
 "そこねる": "ضَرَرٌ / ضَرَّ أَضَرَّ",
 "そこのくに": "سِجِّين, عَالَم سُفْلِيّ",
 "そこのけ": "أَهْمَلَ / إِهْمَال",
 "そこはかとない": "إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "そこはかとなく": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "そこびきあみ": "جرافة, شبكة الجر (شبكة صيد مخروطية تُسحب عبر الماء في أعماق كبيرة) / خيط الشباك, خيط الصيد بالجر (خيط صيد طويل ترتبط به العديد من الخيوط القصيرة والخطافات (عادة ما يكون معلقاً بين عوامات))",
 "そこへいくと": "من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "そこへ行くと": "من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "そこほん": "كتاب مصادر (مجموعة من الوثائق المهمة تاريخياً منشورة معاً ككتاب) / مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "そこぼん": "كتاب مصادر (مجموعة من الوثائق المهمة تاريخياً منشورة معاً ككتاب) / مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "そこまで": "حَتَّى الْآنَ (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "そこまめ": "بَطْبَاطَة, نَفْطَة",
 "そこもと": "هُنَاكَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そこもの": "قاعي المعيشة (من أو متعلق بالأسماك والحياة البحرية التي تعيش في قاع المسطح المائي)",
 "そこら": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / في ذلك الجوار, هناك تقريباً (بالقرب من ذلك المكان) / في ذلك الوقت تقريباً (بالقرب من ذلك الوقت أو التاريخ)\nمثال: أقام في لندن أو جوارها لعدة أسابيع",
 "そこらじゅう": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "そこらへん": "في هذا الجوار, في هذه الأنحاء (في هذا الجوار العام)\nمثال: الناس ودودون في هذه الأنحاء",
 "そこら中": "فِي كُلِّ مَكَانٍ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "そこら辺": "في هذا الجوار, في هذه الأنحاء (في هذا الجوار العام)\nمثال: الناس ودودون في هذه الأنحاء",
 "そこ退け": "أَهْمَلَ / إِهْمَال",
 "そご": "تَنَاقُض, عَدَم اتِّسَاق (صفة عدم الاتساق وافتقار الانسجام بين الأشياء أو الأجزاء) / تَعَارُض, تَنَافُر (العلاقة بين القضايا التي لا يمكن أن تكون صحيحة في نفس الوقت)",
 "そごうこう": "أَصْطَرَك, أَسْطَرَك",
 "そさ": "تصرف, سلوك (طريقة التصرف أو التحكم بالنفس) / تصرف, سلوك ((السمات السلوكية) الطريقة التي يتصرف بها الشخص تجاه الآخرين) / حَرَكَة / أَدَاء / مَسْرَحِيَّة / رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / شطيح / رَقَصَ, رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "そさい": "خضراوات ورقية (أي من النباتات الورقية المختلفة أو أوراقها وسيقانها التي تؤكل كخضروات)",
 "そさいききゅう": "منطاد حاجز (بالون أو منطاد ممدود ومربوط بحبال أو شبكة تتدلى منه لردع طائرات العدو التي تحلق على ارتفاع منخفض)",
 "そざい": "مُقَوِّم / الموضوع، مادة البحث",
 "そざつ": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس) / ثَخِن (ثَخُنَ الشيءُ ثُخونةً وثَخانةً وثِخَنًا، فَهُوَ ثَخِينٌ: كثُفَ وغَلُظ وصَلُبَ)\nمثال: زيري خشن الخلق.",
 "そし": "عُنْصُر كِيمِيَائِيّ, عُنْصُر (الْأَصْل؛ الجِنْس)\nمثال: المغنيزيوم عنصر كيميائي. / بَيَانَات, مَعْلُومَات / إعاقة (الوقوف في طريق شخص ما) / اعتراض, سد (فعل الاعتراض أو العرقلة) / عائق, مانع (أي هيكل يجعل التقدم صعباً) / عائق, عقبة (شيء غير مادي يقف في الطريق ويجب تجاوزه أو التغلب عليه)\nمثال: عرقلة سير العدالة / عَرِيق, قَدِيم العَهْد (مَوْجود مُنْذُ فَتْرَة طَويلَة)",
 "そしき": "تَرْتِيب, تَنْظِيم (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / مُنَظَّمَة, مُؤَسَّسَة / مُنَظَّمَة\nمثال: أعاد زيري ترتيب المطبخ كلية. / هَيْكَل / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق) / جِهَاز\nمثال: ليس بنظام كامل. / مَنْدِيل, مِنْدِيل / نَسِيج حَيَوِيّ",
 "そしきか": "تَرْتِيب, تَنْظِيم (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / مُنَظَّمَة, مُؤَسَّسَة / مُنَظَّمَة\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "そしきかいはつ": "عين يمنى (العين اليمنى) / دكتوراه في البصريات (درجة الدكتوراه في البصريات)",
 "そしきがく": "علم الأنسجة, هيستولوجيا (فرع علم الأحياء الذي يدرس البنية المجهرية للأنسجة الحيوانية أو النباتية)",
 "そしきがくしゃ": "عالم أنسجة (عالم تشريح يتخصص في الدراسة المجهرية للأنسجة الحيوانية)",
 "そしきがくてき": "نسيجي (من أو متعلق بعلم الأنسجة)",
 "そしききゅう": "خلية منسجة (بلعمية كبيرة توجد في النسيج الضام)",
 "そしきさいへん": "إعادة تنظيم, إعادة هيكلة (تغيير واسع النطاق لهيكل شركة أو حكومة) / إعادة تنظيم (فرض تنظيم جديد؛ التنظيم بشكل مختلف (غالباً ما ينطوي على تغييرات واسعة وجذرية))\nمثال: بعد الاستحواذ كان هناك إعادة تنظيم شاملة",
 "そしきしゃ": "مُنَظِّم",
 "そしきしゅうきょう": "ديانة, دين (مؤسسة للتعبير عن الإيمان بقوة إلهية)\nمثال: نشأ على الدين المعمداني",
 "そしきず": "هيكل تنظيمي (مخطط يوضح خطوط المسؤولية بين أقسام مؤسسة كبيرة)",
 "そしきたい": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "そしきてき": "مُمَنْهَج",
 "そしきてきごうせい": "توافق نسيجي (حالة يمكن فيها لخلايا نسيج ما البقاء على قيد الحياة في وجود خلايا نسيج آخر)\nمثال: يتطلب الطعم أو الزرع الناجح درجة عالية من التوافق النسيجي",
 "そしきてきはんざい": "جَرِيمة مُنَظَّمة",
 "そしきはんざい": "جَرِيمة مُنَظَّمة",
 "そしきはんざいたいさく": "جَرِيمة مُنَظَّمة",
 "そしきはんざいたいさくか": "جَرِيمة مُنَظَّمة",
 "そしきはんざいたいさくぶ": "جَرِيمة مُنَظَّمة",
 "そしきひょう": "تصويت الكتلة, تصويت جماعي (تصويت يتناسب حجمه مع عدد الأشخاص الذين يمثلهم المندوب)",
 "そしきふてきごうせい": "عدم التوافق النسيجي (عدم توافق لا يمكن معه زراعة نسيج شخص في شخص آخر)",
 "そしきぼうりょくだん": "جَرِيمة مُنَظَّمة",
 "そしきプラスミノーゲンかっせいかいんし": "أكتيفاز, منشط البلازمينوجين النسيجي (عامل حال للتخثر (الاسم التجاري أكتيفاز) يسبب انحلال الفيبرين في موقع الجلطة الدموية؛ يستخدم في علاج احتشاء عضلة القلب الحاد)",
 "そしぜん": "زِن ((زَنَّ) عصبه زنا: يبس واسترخت مفاصله؛ (زَنَّ) فلانا بخير أو شر زنا: اتهمه به)\nمثال: هل خسرت وزن مؤخرا؟",
 "そしたら": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "そしつ": "ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود) / مستلزمات, مقومات ((عادة بصيغة الجمع) المكونات اللازمة لصنع أو فعل شيء ما) / كَفَاءَة, مُؤَهِّل (سمة يجب الوفاء بها أو الامتثال لها وتجعل الشخص مناسباً لشيء ما)\nمثال: ابتكار الخطط / طَبِيعَة, طبيعة",
 "そして": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "そしてちちになる": "الْوَلَدُ سُرّ أَبِيهِ",
 "そして父になる": "الْوَلَدُ سُرّ أَبِيهِ",
 "そしゃく": "عقد إيجار (عقد يمنح استخدام أو شغل الممتلكات خلال وقت محدد مقابل مبلغ محدد) / عين مؤجرة, مأجور (الممتلكات التي يتم تأجيرها أو إكراؤها) / مدة الإيجار, مدة العقد (الفترة الزمنية التي يكون خلالها عقد نقل الممتلكات إلى شخص ما ساري المفعول) / مضغ (عض وطحن الطعام في فمك ليصبح ناعماً بما يكفي للبلع) / هَضْم",
 "そしゃくうんどう": "مضغ (عض وطحن الطعام في فمك ليصبح ناعماً بما يكفي للبلع)",
 "そしゃくけん": "عقد إيجار (عقد يمنح استخدام أو شغل الممتلكات خلال وقت محدد مقابل مبلغ محدد) / عين مؤجرة, مأجور (الممتلكات التي يتم تأجيرها أو إكراؤها) / مدة الإيجار, مدة العقد (الفترة الزمنية التي يكون خلالها عقد نقل الممتلكات إلى شخص ما ساري المفعول)",
 "そしゅ": "غاية, غَرَض",
 "そしょう": "دَعْوَى (إدِّعَاء؛ دُعَاء)\nمثال: رفضت الضحية إقامة دعوى قضائية. / انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء)) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / انتفاخ, تضخم (بروز غير طبيعي أو تضخم موضعي)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً / خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "そしょうきろく": "تَسْجِيل, مُدَوَّنَة / سِجِلّ, دَفْتَر (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / رَقْم قِيَاسِيّ (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "そしょうざた": "دَعْوَى (إدِّعَاء؛ دُعَاء)\nمثال: رفضت الضحية إقامة دعوى قضائية.",
 "そしょうじけん": "دَعْوَى (إدِّعَاء؛ دُعَاء)\nمثال: رفضت الضحية إقامة دعوى قضائية.",
 "そしょうてつづき": "إجراءات قانونية, دعوى ((قانون) بدء سلسلة من الخطوات التي يتم من خلالها استدعاء الأحكام القانونية)",
 "そしょうとうじしゃ": "خصم, متقاضٍ ((قانون) طرف في دعوى قضائية؛ شخص متورط في التقاضي)\nمثال: المدعون والمدعى عليهم كلاهما متقاضون",
 "そしょうにん": "خصم, متقاضٍ ((قانون) طرف في دعوى قضائية؛ شخص متورط في التقاضي)\nمثال: المدعون والمدعى عليهم كلاهما متقاضون",
 "そしょうひよう": "أتعاب التقاضي, تكاليف قانونية (تعويض مالي للطرف الرابح عن نفقات التقاضي)",
 "そしょうほう": "قَانُون إِجْرَائِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "そしょく": "تَرْتِيب, تَنْظِيم (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / مُنَظَّمَة, مُؤَسَّسَة / مُنَظَّمَة\nمثال: أعاد زيري ترتيب المطبخ كلية. / هَيْكَل / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق) / جِهَاز\nمثال: ليس بنظام كامل. / مَنْدِيل, مِنْدِيل / نَسِيج حَيَوِيّ",
 "そしらぬ": "مُتَصَنَّع, مُصْطَنَع (غَيْر حَقِيقِيّ؛ مُفْتَعَل)",
 "そしり": "لَامَ, اِسْتَنْكَرَ (لامَ يَلوم ، لُمْ ، لَوْمًا ، فهو لائم والجمع : لُوَّمٌ ، ولُيَّمٌ وهو أَيضاً لَوَّامٌ ، ولَوَّامةٌ ، ولْوَمةٌ وذاك مَلُومٌ ، ومَلِيمٌ…)\nمثال: لام سامي معلمه على فشله هو.",
 "そしりょう": "ألياف, ألياف غذائية (طعام نباتي خشن عسر الهضم منخفض العناصر الغذائية؛ كتلته تحفز التمعج المعوي)",
 "そしる": "تَشْهِير, اِفْتِرَاء",
 "そじ": "ألفاظ, صياغة (الطريقة التي يتم بها التعبير عن شيء ما بالكلمات) / ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود) / مستلزمات, مقومات ((عادة بصيغة الجمع) المكونات اللازمة لصنع أو فعل شيء ما) / كَفَاءَة, مُؤَهِّل (سمة يجب الوفاء بها أو الامتثال لها وتجعل الشخص مناسباً لشيء ما)\nمثال: ابتكار الخطط / أساس, عمل تمهيدي (إعداد أولي كأساس أو قاعدة) / أساس (أدنى دعامة لهيكل ما) / أساس, حجر الزاوية (الافتراضات الأساسية التي يبدأ منها شيء ما أو يتطور أو يُحسب أو يُشرح)\nمثال: نحن مستعدون اليوم بسبب العمل التمهيدي الذي تم قبل عشر سنوات",
 "そじほう": "بِنَاء جُمْلَة, نَحْو (ضد هَدْم. ؛ المَبْنَى أو البِنَاية)\nمثال: أنا وجدت البناء.",
 "そじゅ": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة",
 "そじょう": "عَرِيضَة, طَلَب",
 "そすい": "قَنَاة / رُهَابِيّ المَاء (خائف بشكل غير طبيعي من الماء) / كاره للماء, نافر من الماء (يفتقر إلى الألفة مع الماء؛ يميل إلى صد الماء وعدم امتصاصه؛ يميل لعدم الذوبان في الماء أو الاختلاط به)",
 "そすいせい": "رُهَابِيّ المَاء (خائف بشكل غير طبيعي من الماء) / كاره للماء, نافر من الماء (يفتقر إلى الألفة مع الماء؛ يميل إلى صد الماء وعدم امتصاصه؛ يميل لعدم الذوبان في الماء أو الاختلاط به)",
 "そすう": "عَدَد أَوَّلِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "そせい": "وِلَادَة, مَوْلِد / وِلَادَة, بدايَة / وَلَدَ, وَضَعَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / مُطَابَقَة / هُوِيَّة / مسقط الرأس, منشأ (المكان الذي نشأ فيه شيء ما أو تمت رعايته في بداية وجوده)\nمثال: مهد الحضارة / مُؤَلَّف, مُصَنَّف / إحياء, انبعاث (إعادة الشيء إلى النشاط والشهرة مرة أخرى) / إِحْيَاء دِينِيّ, اِجْتِمَاع نَهْضَة دِينِيَّة (اجتماع تبشيري يهدف إلى إيقاظ الاهتمام بالدين)\nمثال: انتعاش التجارة / إحياء, انبعاث (إعادة الشيء إلى النشاط والشهرة مرة أخرى)\nمثال: انتعاش التجارة / طواعية, قابلية للطرق (خاصية القابلية للتشكيل مادياً؛ خاصية الشيء الذي يمكن تشغيله أو طرقه أو تشكيله دون أن ينكسر) / مِيزَة / صِفَة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت)\nمثال: محاسبة النفس صفة حميدة.",
 "そせいじゅつ": "اِنْعَاش",
 "そせいらんぞう": "إنتاج بالجملة, إنتاج ضخم (إنتاج كميات كبيرة من مادة موحدة (غالباً باستخدام تقنيات خط التجميع))",
 "そせき": "حجر الأساس (حجر يوضع في حفل لتدشين تأسيس مبنى جديد)",
 "そせきぞう": "أعمال البناء, بناء (حرفة البناء) / أعمال البناء, بناء حجري (هيكل مبني من الحجر أو الطوب بواسطة بناء) / الماسونية (الماسونيون مجتمعين)",
 "そせん": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "そせんすうはい": "عبادة الأسلاف (عبادة الأجداد) / عبادة الأسلاف (عادة تبجيل الأسلاف المتوفين الذين يُعتبرون ما زالوا جزءاً من العائلة، ويُعتقد أن أرواحهم تمتلك القدرة على التدخل في شؤون الأحياء)\nمثال: معظم ممارسات عبادة الأسلاف المعروفة تاريخياً في اليابان هي تعديلات لعادات صينية",
 "そせんでんらい": "أَبَوِيّ, مَوْرُوث (مُتوارَث وفق قواعد راسخة (عادة قانونية) للإرث) / عَائِلِيّ, وِرَاثِيّ (يحدث بين أفراد الأسرة عادة عن طريق الوراثة)",
 "そぜい": "ضَرِيبَة",
 "そぜいかいひ": "تجنب ضريبي (تقليل المسؤولية الضريبية إلى الحد الأدنى بطرق قانونية)",
 "そぜいかいひち": "مَلَاذ ضَرِيبِيّ (مَلْجَأ، مَأْوَى)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "そぜいひなんち": "مَلَاذ ضَرِيبِيّ (مَلْجَأ، مَأْوَى)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين.",
 "そそ": "رَشِيق, ظَرِيف / بل, نعم (ليس ذلك فحسب، بل)\nمثال: أنا بذلك أفرح، بل وسأفرح / أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية)",
 "そそう": "إحباط, انقباض (حالة من الاكتئاب السوداوي) / براز, غائط (منتج إخراجي صلب يفرغ من الأمعاء) / سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\") / إهمال, تقصير (الفشل في التصرف بالحكمة التي يمارسها الشخص العاقل في نفس الظروف) / إهمال, لا مبالاة (صفة عدم الحذر أو عدم بذل الجهد) / خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "そそぎぐち": "فوهة, مصب (فتحة تسمح بمرور السوائل أو الحبوب)",
 "そそくさ": "بسرعة, بعجلة (بطريقة سريعة أو متسرعة)\nمثال: الطريقة التي دفنوه بها بسرعة كانت معيبة",
 "そそぐ": "شَطَفَ (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن أن تعني إزالة ما علق بالشيء من أوساخ أو شوائب) / مَضْمَضَ / صَبَّ, سَكَبَ (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون)\nمثال: صب الشاي لضيفك. / مِيَاه / سَقَى / أَسْقَى, سَقَى / سَقِيفَة / وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "そそけだつ": "ارتجاف, رعشة (اهتزاز لا إرادي (كما لو كان بسبب المرض أو الخوف)) / رجفة, رعشة (إحساس بالخوف يكاد يكون ممتعاً)\nمثال: سرت فيه رعشة مفاجئة",
 "そそける": "شِجَار عَلَنِيّ, عِرَاك (قتال صاخب)",
 "そそけ立つ": "ارتجاف, رعشة (اهتزاز لا إرادي (كما لو كان بسبب المرض أو الخوف)) / رجفة, رعشة (إحساس بالخوف يكاد يكون ممتعاً)\nمثال: سرت فيه رعشة مفاجئة",
 "そそっかしい": "غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "そそっかしや": "طائش, مشتت الذهن (شخص طائش وغير منظم)",
 "そそっかし屋": "طائش, مشتت الذهن (شخص طائش وغير منظم)",
 "そそのかし": "إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة)) / تحريض, حث (الفعل اللفظي للحث)",
 "そそのかす": "حَرَّضَ, دَفَعَ (حرّضه على الأمر: حضّه ، شدّد الرّغبة فيه؛ حَرَّضَهُ تَحْرِيضاً: حَثَّه على القِتَالِ وأَحْمَاهُ عَلَيْه)\nمثال: هو حرض على الشغب.",
 "そそりたつ": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه. / بُرْج (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "そそり勃つ": "بُرْج (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "そそり立つ": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "そそる": "حَرَّضَ, حَضَّ (حرّضه على الأمر: حضّه ، شدّد الرّغبة فيه؛ حَرَّضَهُ تَحْرِيضاً: حَثَّه على القِتَالِ وأَحْمَاهُ عَلَيْه)\nمثال: هو حرض على الشغب.",
 "そぞう": "سبك, صب (فعل إنشاء شيء ما عن طريق صبه في قالب) / تشكيل, نمذجة (نحت أولي من الشمع أو الطين يمكن نسخ العمل النهائي منه) / قولبة, نحت طيني (نحت يتم إنتاجه بالقولبة) / إفريز, قولبة (سطح زخرفي غائر أو بارز على الحافة)",
 "そぞく": "لص متسلل (لص يسرق دون استخدام العنف) / قَارِض, قَوَارِض",
 "そぞろ": "غَيْرُ مُرْتَاح, قَلِق (مَشْغُول البَال وَغَيْر مُطْمَئِنّ) / دَائِم الحَرَكَة, لَا يَهْدَأ (في حركة مستمرة لا تتوقف) / غير مريح, قلق (يفتقر أو لا يوفر راحة جسدية أو عقلية) / قَلِق, مُتَمَلْمِل (عَصَبِيٌّ وَغَيْرُ قَادِرٍ عَلَى الاسْتِرْخَاء)\nمثال: ليلة قلقة",
 "そぞろあるき": "تَجَوُّل, تَنَزُّه / تَجَوَّلَ, تَنَزَّهَ",
 "そぞろあるく": "تَجَوُّل, تَنَزُّه / تَجَوَّلَ, تَنَزَّهَ",
 "そぞろに": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "そぞろ歩き": "تَجَوُّل, تَنَزُّه / تَجَوَّلَ, تَنَزَّهَ",
 "そぞろ歩く": "تَجَوُّل, تَنَزُّه / تَجَوَّلَ, تَنَزَّهَ",
 "そたい": "بيبلو, تمثال صغير (تمثال صغير منحوت أو مقولب) / جَرِيمة مُنَظَّمة",
 "そだ": "يَعْنِي, أَي / أجمة, دغل (نمو كثيف للشجيرات) / حطب, خشب الغابة (الخشب من الشجيرات أو الفروع الصغيرة)\nمثال: أشعلوا ناراً من الحطب",
 "そだい": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس) / ثَخِن (ثَخُنَ الشيءُ ثُخونةً وثَخانةً وثِخَنًا، فَهُوَ ثَخِينٌ: كثُفَ وغَلُظ وصَلُبَ)\nمثال: زيري خشن الخلق.",
 "そだち": "تَنْمِيَة, نُمُو (الزيادة؛ النماء)\nمثال: الجزائر راغبة في تنمية اقتصادها. / تَرْبِيَة",
 "そだちがいい": "حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "そだちがよい": "حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "そだちがわるい": "سَيِّئُ التَّرْبِيَةِ, قَلِيلُ الْأَدَبِ ((عن الأشخاص) يفتقر إلى الرقة أو اللباقة)",
 "そだちのいい": "حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "そだちのよい": "حَسَنُ التَّرْبِيَةِ, مُؤَدَّبٌ (ذو تربية حسنة وتنشئة راقية)",
 "そだちゆく": "كَبُرَ, ْنَشَأ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "そだつ": "نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "そだて": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع)",
 "そだてあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "そだておや": "والِد حاضِن, وَلِيّ أَمْر بَدِيل (شخص يقوم بدور الوالد والوصي لطفل بدلاً من والديه الطبيعيين دون تبنيه قانونياً)",
 "そだてのおや": "والِد حاضِن, وَلِيّ أَمْر بَدِيل (شخص يقوم بدور الوالد والوصي لطفل بدلاً من والديه الطبيعيين دون تبنيه قانونياً)",
 "そだてる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / ذَيْل (ذَيَّلَ (ذيله): جعل له ذيلا؛ (ذَيَّلَ) أطال ذيله وطوله. ويقال ذيل كتابه أو كلامه: أردفه بكلام كالتتمة له) / قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / تَدَرَّبَ, تَمَرَّنَ / دَرَّبَ, درب (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ) / درب, أهل (الدَّرْبُ: كُلُّ طريقٍ يصلُ بين مكانَيْن. يقال: مَنْ سار على الدَّرب وصل : معناه أنّ المهارة تكتسبُ بالمِران؛ الدَّرْبُ: المَضيقُ في الجبال الْمَضْيَقُ فِي الجَبَلِ)\nمثال: للبقرة ذيل طويل. / تنشئَة, تَرْبِيَة",
 "そち": "قِيَاس / فَاصِلَة / إِجْرَاء / قَاسَ (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود) / مستلزمات, مقومات ((عادة بصيغة الجمع) المكونات اللازمة لصنع أو فعل شيء ما) / كَفَاءَة, مُؤَهِّل (سمة يجب الوفاء بها أو الامتثال لها وتجعل الشخص مناسباً لشيء ما)\nمثال: ابتكار الخطط / أساس, عمل تمهيدي (إعداد أولي كأساس أو قاعدة) / أساس (أدنى دعامة لهيكل ما) / أساس, حجر الزاوية (الافتراضات الأساسية التي يبدأ منها شيء ما أو يتطور أو يُحسب أو يُشرح)\nمثال: نحن مستعدون اليوم بسبب العمل التمهيدي الذي تم قبل عشر سنوات",
 "そちのけ": "أَهْمَلَ / إِهْمَال",
 "そちゃ": "شَاي, فِنْجَان شَاي (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة) / فِنْجَان شَاي (إناء صغير لشرب أو احتساء شراب ساخن عادة، مثل القهوة والشاي)\nمثال: صب الشاي لضيفك.",
 "そちゅう": "مُلَاحَظَة, مَلْحُوظَة / مُذَكَّرَة / دَرَجَة",
 "そちら": "هُنَاكَ / لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ\nمثال: これとそちらとの違いは何だい。 — ما الفرق بين هذا و ذاك؟ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そちらさま": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そちら様": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そっか": "تَحْت الأَقْدَام (تحت القدمين) / فِي الطَّرِيق (في الطريق ويعيق التقدم)\nمثال: داس الفاصوليا تحت الأقدام / أَنْتَ, أَنْتِ (أنْتَ ضَميرُ رَفْعٍ مُنْفَصِلٌ لِلْمُخاطَبِ وَالْمُخاطَبَةِ)\nمثال: أنت لست صديقنا. / وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة!",
 "そっから": "مِن هُنَاكَ, ثَمَّ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "そっかんせい": "سَرِيع الجَفَاف (مادّة سائلة تجفّ بسرعة)",
 "そっき": "اخْتِزَالِيّ, مُخْتَزَل (مكتوب بشكل مختصر أو رمزيّ) / اختزال, كتابة مختزلة (طريقة للكتابة بسرعة باستخدام نظام رمزي مختصر) / أداة قياس, جهاز قياس (أداة تظهر مدى أو كمية أو درجة شيء ما)",
 "そっきしゃ": "كاتب اختزال (شخص ماهر في نسخ الكلام (خاصة الإملاء))",
 "そっきじゅつ": "اخْتِزَالِيّ, مُخْتَزَل (مكتوب بشكل مختصر أو رمزيّ) / اختزال, كتابة مختزلة (طريقة للكتابة بسرعة باستخدام نظام رمزي مختصر)",
 "そっきふごう": "آلة الاختزال (آلة لكتابة أحرف الاختزال) / رمز اختزال, ستينوغراف (حرف من حروف الاختزال)",
 "そっきもじ": "آلة الاختزال (آلة لكتابة أحرف الاختزال) / رمز اختزال, ستينوغراف (حرف من حروف الاختزال)",
 "そっきゅう": "كرة سريعة ((بيسبول) رمية ترمى بأقصى سرعة)\nمثال: تأخر في ضرب الكرة السريعة / فَوْرِيّ",
 "そっきょ": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / جائل, طائف (يتجول بحرية)\nمثال: في الليل في السرير؛ واجهتها أفكاره الجائلة ببطء",
 "そっきょう": "ارتجال (أداء يُعطى بشكل مرتجل دون تخطيط أو إعداد) / ارتجال, حل مرتجل (وسيلة غير مخطط لها) / ارتجال (إبداع منطوق أو مكتوب أو مؤلف ارتجالياً (بدون إعداد مسبق)) / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "そっきょうえんそう": "ارتجال (أداء يُعطى بشكل مرتجل دون تخطيط أو إعداد) / ارتجال, حل مرتجل (وسيلة غير مخطط لها) / ارتجال (إبداع منطوق أو مكتوب أو مؤلف ارتجالياً (بدون إعداد مسبق))",
 "そっきょうきょく": "ارتجالياً, بشكل عفوي (بدون تحضير مسبق) / اِرْتِجَالِيّ, عَفْوِيّ (بقليل من الإعداد أو التفكير المسبق أو بدونهما) / ارتجال (خطاب أو ملاحظة مرتجلة) / إمبرومبتو, مرتجلة (مقطع موسيقي قصير يبدو وكأنه صُنع بعفوية دون تحضير مسبق)\nمثال: تحدث ارتجالياً",
 "そっきょうてき": "مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "そっきょぎ": "محدد المدى (أداة قياس (صوتية أو بصرية أو إلكترونية) للعثور على مسافة جسم ما)",
 "そっきん": "حَاشِيَة / دفع فوري, دفع نقدي (دفع فوري للسلع أو الخدمات بالعملة أو بشيك)",
 "そっきんせいじ": "حكومة الظل, مجموعة المستشارين (دائرة داخلية من المستشارين غير الرسميين لرئيس الحكومة)",
 "そっくび": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "そっくり": "كُلّ, جَمِيع / صُورَة طِبْق الأَصْل, نُسْخَة مُطَابِقَة (صورة مماثلة تماماً أو نظير مطابق)",
 "そっくりさん": "مُتَشَابِه المَظْهَر (يُشْبِه شَيْئًا آخَر في الشَّكْل الخارِجِيّ) / شَبِيه, نُسْخَة طِبْق الْأَصْل (شخص يشبه إلى حد كبير شخصية مشهورة (خاصة ممثل))\nمثال: يمكن أن يكون شبيه غينغريتش",
 "そっけつ": "حكم مستعجل, حكم موجز (حكم تصدره المحكمة قبل صدور الحكم النهائي لأنه لا توجد مسألة واقعية جوهرية ويحق لطرف أو لآخر الحصول على حكم كمسألة قانونية)",
 "そっけない": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "そっけん": "مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "そっこう": "مِزْراب (قناة صرف لمياه الأمطار والثلوج؛ نظام يحدّ من جريان المياه على الأسطح الخارجية للمبنى) / هجوم خاطف ((كرة السلة) اندفاع سريع للحصول على تسديدة في أقرب وقت ممكن بعد الاستحواذ على الكرة) / فَوْرًا, حَالًا / فوتومترية, قياس الضوء (قياس خصائص الضوء (خاصة الشدة الضوئية))",
 "そっこうき": "مقياس الارتفاع بالغليان (مقياس ارتفاع يستخدم نقطة غليان الماء لتحديد ارتفاع الأرض) / مقياس الضوء (معدات تصوير فوتوغرافي تقيس شدة الضوء) / فوتومتر, مقياس الضوء (أداة قياس لقياس الشدة الضوئية لمصدر بمقارنته (بصرياً أو كهروضوئياً) بمصدر قياسي)",
 "そっこく": "فَوْرًا, حَالًا",
 "そっこん": "حَالِيًّا, فِي هٰذِهِ اَللَّحْظَة / بتهور, رأساً على عقب (في عجلة مضطربة)\nمثال: ركضنا بتهور نحو الملجأ / من القلب, من صميم القلب (بصدق شديد)\nمثال: تحدث من القلب / رسغي (من أو متعلق بـ أو بالقرب من رسغ القدم) / عظم الرصغ, عظم رصغي (أي عظم من عظام الرصغ (في القدم))\nمثال: عظام رسغ القدم",
 "そっこんこつ": "رُصُغ",
 "そっす": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "そっする": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "そっち": "هُنَاكَ / لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ\nمثال: これとそちらとの違いは何だい。 — ما الفرق بين هذا و ذاك؟ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そっちのけ": "أَهْمَلَ / إِهْمَال",
 "そっちゅう": "جلطة, سكتة دماغية (فقدان مفاجئ للوعي ناتج عن تمزق أو انسداد الأوعية الدموية مما يؤدي إلى نقص الأكسجين في الدماغ)",
 "そっちょく": "إِفْرَنْجِيّ",
 "そっち系": "مِثْلِيّ / مِثْلِيَّة / جيى / جاى / ليزبيان / مثلي",
 "そって": "عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل) / بِالتَّوَازِي مَعَ\nمثال: أجب على السؤال.",
 "そっと": "بصوت خافت, بهدوء (بحجم صوت منخفض) / بخفة, برفق (بقليل من الوزن أو القوة) / بشكل خافت, بنعومة (توجيه في الموسيقى؛ للعزف بنعومة وهدوء نسبي) / برقة, بنعومة (بطريقة ترضي الحواس)\nمثال: تحدث بهدوء ولكن احمل عصا غليظة / بتسلل, خلسة (بطريقة خفية)\nمثال: تقدموا خلسة عكس التيار / تخوم, منطقة حدودية (منطقة تتكون من المساحة الموجودة على جانبي حدود دولة أو منطقة ما)\nمثال: التخوم الويلزية بين إنجلترا وويلز",
 "そっとう": "إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "そっぽをむく": "تَجَاهَلَ, طَنَّش",
 "そっぽを向く": "تَجَاهَلَ, طَنَّش",
 "そっ首": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "そつ": "زلة, هفوة (خطأ بسيط غير مقصود يُلاحظ عادة في الكلام أو الكتابة أو في الحوادث الصغيرة أو هفوات الذاكرة) / إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر / تَخَرُّج / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "そつい": "مُقَاضَاة, مُلَاحَقَة قَضَائِيَّة / طَعْن, سَحْب ثِقَة",
 "そついがわ": "مُقَاضَاة, مُلَاحَقَة قَضَائِيَّة",
 "そついしゃ": "مُدَّعٍ / الْمُدَّعِي",
 "そつう": "فَهْم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه) / رُؤْيَة / تَفَاهُم / فهم (فهم الأمر أو الكلام أو نحو ذلك، أدركه، علمه، أحسن تصوّره، استوعبه)\nمثال: لقد أسئت الفهم.",
 "そつがない": "وَرِع, حَذِر (تَحَرَّجَ من أن يأتي إِثْما وابتعد عن المعاصي)",
 "そつぎょう": "تَخَرُّج / ذهاب, رحيل (فعل المغادرة)",
 "そつぎょうけんてい": "مدرسة تعليم القيادة (مدرسة يتم فيها تعليم الناس قيادة السيارات)",
 "そつぎょうしき": "فاتِحَة (لفَاتِح؛ سُوْرَة الْفَاتِحَة : أعظم سورة في القرآن الكريم وسميت بذلك لأنها افتتح بها المصحف في الكتابة، ولأنها تفتتح بها الصلاة في القراءة)\nمثال: لدى نبات الخلنج هذا أزهار وردية فاتحة.",
 "そつぎょうしゃ": "خِرِّيج, خِرِّيجَة / دَرَّجَ, تَخَرَّجَ (دَرِجَ درجا دَامَ على أكل الدراج)\nمثال: حرارتي 38 درجة.",
 "そつぎょうしょうしょ": "شَهَادَة, دِبْلُوم",
 "そつぎょうしょうめいしょ": "شَهَادَة, دِبْلُوم",
 "そつぎょうせい": "خِرِّيج, خِرِّيجَة / دَرَّجَ, تَخَرَّجَ (دَرِجَ درجا دَامَ على أكل الدراج)\nمثال: حرارتي 38 درجة.",
 "そつぎょうアルバム": "كتاب سنوي (كتاب مرجعي ينشر بانتظام مرة كل عام) / كتاب سنوي (كتاب تنشره سنوياً دفعة التخرج في مدرسة ثانوية أو كلية يحتوي عادة على صور أعضاء هيئة التدريس والطلاب المتخرجين)",
 "そつご": "الأفراد, الجنود العاديون (الأعضاء العاديون في منظمة (مثل الجنود المجندين في الجيش)) / القواعد, عامة الأعضاء (الناس الذين يشكلون الجسم الرئيسي لأي مجموعة)\nمثال: تم دعم الإضراب من قبل أفراد النقابة",
 "そつしゃ": "خِرِّيج, خِرِّيجَة / دَرَّجَ, تَخَرَّجَ (دَرِجَ درجا دَامَ على أكل الدراج)\nمثال: حرارتي 38 درجة.",
 "そつじ": "مُبَاغِت, مُفَاجِئ",
 "そつじながら": "عَفْوًا!, مَاذَا قُلْتَ؟",
 "そつぜん": "مُبَاغِت, مُفَاجِئ",
 "そつど": "تخوم, منطقة حدودية (منطقة تتكون من المساحة الموجودة على جانبي حدود دولة أو منطقة ما)\nمثال: التخوم الويلزية بين إنجلترا وويلز",
 "そつどく": "احتكاك, كشط (فعل الاحتكاك بشيء أثناء المرور) / تهرب ضريبي بإخفاء الدخل (عدم التصريح عن الدخل لتجنب دفع الضرائب عليه) / قشط (عملية إزالة المواد الطافية من سطح سائل) / تصفح سريع, قراءة سريعة (القراءة أو إلقاء نظرة سريعة)",
 "そつなく": "بِدِقَّة مُتَنَاهِيَة, بِلَا عَيْب (بسلاسة وبدون صعوبة؛ بدقة وبراعة)\nمثال: هبط لاعب الجمباز بلا عيب",
 "そつにゅう": "فطام (عملية استبدال حليب الأم بطعام آخر في النظام الغذائي للطفل أو الثدييات الصغيرة)",
 "そつのない": "وَرِع, حَذِر (تَحَرَّجَ من أن يأتي إِثْما وابتعد عن المعاصي)",
 "そつゆう": "تَالٍ, التَّالِي ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "そつろん": "بَكَالُورِيَا",
 "そつアル": "كتاب سنوي (كتاب مرجعي ينشر بانتظام مرة كل عام) / كتاب سنوي (كتاب تنشره سنوياً دفعة التخرج في مدرسة ثانوية أو كلية يحتوي عادة على صور أعضاء هيئة التدريس والطلاب المتخرجين)",
 "そてい": "افتراض, تولي (فعل حيازة أو تولي السلطة على شيء ما) / افتراض (فعل الافتراض أو التسليم بجدلية أمر ما) / افتئات, تطاول (سلوك جريء (حتى متعجرف) ليس من حقك) / افتراض (فرضية تؤخذ كأمر مسلم به)\nمثال: تزامنت توليه المنصب مع الاضطرابات في كوبا",
 "そてつ": "سيكاس, نخيل الساغو (سيكاد قزم يشبه النخيل من اليابان ينتج الساغو) / نخيل الساغو (أي من أشجار نخيل آسيوية استوائية مختلفة تنتج جذوعها الساغو)",
 "そで": "كُمّ, رُدْن / جَنَاح / رَفْرَف",
 "そでぐち": "ثنية الكم, كُفّة (طية تتكون من حاشية مقلوبة للخلف تطوق نهاية الكم أو الساق) / أصفاد, كلبشات (قيد يتكون من حلقة معدنية يمكن قفلها حول المعصم؛ تستخدم عادة في أزواج)",
 "そでぐり": "فتحة الذراع, فتحة الكم (ثقب تضع ذراعك من خلاله وحيث يمكن ربط الكم)",
 "そでごい": "سَائِل / فَقِير",
 "そでした": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "そでしょう": "شيفرون / شارة الرتبة, شريط رتبة",
 "そでなし": "سُدًى, عَبَثِيّ (لا يؤدّي إلى نجاح أو نتيجة مرجوّة) / بلا أكمام (بدون أكمام)\nمثال: فساتين صيفية بلا أكمام",
 "そでにすがる": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك",
 "そでにする": "تَجَاهَلَ, طَنَّش",
 "そでのした": "رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "そでをとおす": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "そと": "خَارِج, بره / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "そといわし": "سمكة العظم (سمكة بحرية فضية نحيلة توجد في المسطحات الطينية الاستوائية وبحيرات المانغروف)",
 "そとうば": "سْتُوبَا",
 "そとうみ": "مُحِيط, قَامُوس (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "そとがき": "كتابة فوقية (نشاط الكتابة فوق شيء ما) / كتابة فوقية (نص مكتوب فوق شيء آخر)",
 "そとがこい": "إحاطة, تغليف (عملية إحاطة شيء داخل شيء آخر) / حظيرة, مسيَّج (هيكل يتكون من منطقة تم تطويقها لغرض ما) / طية, مرفق (شيء ما (عادة وثيقة داعمة) يتم إرفاقه في ظرف مع رسالة تغطية) / حيز طبيعي مغلق, مكان مغلق (مساحة مغلقة بشكل طبيعي)",
 "そとがまえ": "خارجي (يقع في أو مناسب للأماكن الخارجية أو خارج مبنى) / خارج, سطح خارجي (الجانب الخارجي أو السطح الخارجي لشيء ما) / خارج, محيط خارجي (المنطقة الموجودة خارج شيء ما)\nمثال: مشهد خارجي",
 "そとがわ": "خارجي (يقع في أو مناسب للأماكن الخارجية أو خارج مبنى) / خارج, سطح خارجي (الجانب الخارجي أو السطح الخارجي لشيء ما) / خارج, محيط خارجي (المنطقة الموجودة خارج شيء ما)\nمثال: مشهد خارجي",
 "そとぎらい": "حَبِيسُ المَنْزِلِ, مُلَازِمٌ لِلبَيْتِ (مَحْصُورٌ فِي البَيْتِ عَادَةً بِسَبَبِ المَرَضِ) / مَيَّالٌ لِلِانْطِوَاء (يميل إلى الانطواء بعض الشيء) / عاجِز, مُقْعَد (شخص أقعده مرض مزمن أو إصابة)",
 "そとぐに": "بَلَد أَجْنَبِيّ (فَتَرَ طبعه من المحاسن العَقْلِيَّة؛ ضد فَطُنَ؛ قل ذَكَاءه وانْتِبَاهه؛ ضد ذَكا)\nمثال: الصين بلد عظيم.",
 "そとごはん": "نُزْهَة / مَهَمَّة سَهْلَة",
 "そとづけ": "خَارِجِيّ (من بلاد الخارج؛ من الخوارج)\nمثال: بحث سامي عن مساعدة خارجية.",
 "そとづら": "خَارِج, بره / أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "そとで": "رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة) / رحلة خلوية, نزهة خلوية (يوم مخصص لتجمع اجتماعي في الهواء الطلق)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "そとなる": "خَارِجِيّ (يقع على السطح الخارجي للجسم أو باتجاهه) / خَارِجِيّ (يقع في الخارج ويتعلق بالواقع المادي)",
 "そとば": "سْتُوبَا",
 "そとばこ": "إطار (الإطار المحيط بفتحة باب أو نافذة) / غلاف الإطار (الغطاء الخارجي للإطار الهوائي) / غلاف, هيكل خارجي (المبيت أو الغطاء الخارجي لشيء ما)\nمثال: تعفنت الأطر وكان لا بد من استبدالها",
 "そとまわり": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط.",
 "そとみ": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "そとめ": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "そとゆ": "خلاء, عراء (حيث يكون الهواء غير محصور)\nمثال: أراد الخروج للهواء الطلق قليلاً",
 "そとわく": "حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "そと湯": "خلاء, عراء (حيث يكون الهواء غير محصور)\nمثال: أراد الخروج للهواء الطلق قليلاً",
 "そどく": "حمى عضة الجرذ, سودوكو (شكل من أشكال حمى عضة الجرذ يحدث في الشرق الأقصى)",
 "そない": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / هَٰكَذَا, كَذَا",
 "そなえ": "قُرْبَان / تَحْضِير, إِعْدَاد / دِفَاع, حِمَايَة / دِفاع / تشكيل عسكري (تشكيل من القوات)",
 "そなえつけ": "مُعَدَّات, تَجْهِيزَات",
 "そなえつける": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به)",
 "そなえもの": "قُرْبَان",
 "そなえる": "اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة. / زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "そなた": "هُنَاكَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そにどり": "سَلْدَج / قِرِلَّى / رَفْرَاف",
 "そにん": "خاطب, طالب الزواج (رجل يتودد لامرأة (بغرض الزواج))",
 "そに鳥": "سَلْدَج / قِرِلَّى / رَفْرَاف",
 "そねみ": "حَسَد, غَبْط (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "そねむ": "حَسَد (تمنيّ زوال نعمة الغير) / حَسَدَ (تمنيّ زوال نعمة الغير)\nمثال: الكره لا يظهر بكل بساطة من فراغ. إنه بالعادة يبدأ من الحسد أو الخوف.",
 "その": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟ / بُسْتَان (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على منتوجها من الفَاكِهَة والثَمَر. الجَنَّة) / حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط) / جنينة / بَخْشَة\nمثال: أحب سقي البستان. / مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس",
 "そのあしで": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم.",
 "そのあたり": "في ذلك الجوار, هناك تقريباً (بالقرب من ذلك المكان) / في ذلك الوقت تقريباً (بالقرب من ذلك الوقت أو التاريخ)\nمثال: أقام في لندن أو جوارها لعدة أسابيع",
 "そのあと": "أَخِير, بَعْدَ ذٰلِك\nمثال: その後の話はご存じでしょう。 — أنتَ تعرف بقية القصة.",
 "そのいっぽう": "أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ) / إِلَى حِينِ ذَلِكَ الوَقْتِ فِي الأَثْنَاءِ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / فِي حِينِ أَنَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: أما زلت تذكرني؟",
 "そのう": "بُسْتَان (أَرْض يحيطها سُوْر وفيها نخيل متفرقة وأعناب وأشجار، تستخدم في الأساس للحصول على منتوجها من الفَاكِهَة والثَمَر. الجَنَّة) / حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / جَنَّة (أرض محاطة بسُور فيها نخل وشجر وكروم، البُسْتَان؛ الحَدِيقَة أو الحَائِط) / جنينة / بَخْشَة\nمثال: أحب سقي البستان.",
 "そのうえ": "إِضَافَةً عَلى ذٰلِكَ / أَعْلَى (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / فَوقَ / شَمَالِيّ / على (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذها إلى الأعلى.",
 "そのうえで": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك",
 "そのうち": "قَرِيبًا, سَرْعَانَ مَا",
 "そのうちに": "قَرِيبًا, سَرْعَانَ مَا",
 "そのおり": "على ذلك, عليه (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: النص والتعليق عليه (يفيد الاستعلاء؛ يفيد التعليل)",
 "そのかみ": "كَان يَامَا كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "そのかわり": "بَدَلاً مِن",
 "そのくせ": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "そのけ": "مِثْلِيَّة, مِثْلِيَّة جِنْسِيَّة",
 "そのこと": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ",
 "そのころ": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "そのご": "أَخِير, بَعْدَ ذٰلِك\nمثال: その後の話はご存じでしょう。 — أنتَ تعرف بقية القصة.",
 "そのさい": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "そのじつ": "فِي الْحَقِيقَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "そのすじ": "حكومة, سلطة (المنظمة التي تمثل السلطة الحاكمة لوحدة سياسية)\nمثال: خفضت الحكومة الضرائب / يَاكُوزَا",
 "そのた": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / إِضَافَةً عَلى ذٰلِكَ / وَهٰكَذَا, وَهَلُمَّ جَرًّا",
 "そのたおおぜい": "إِضَافِيّ, زَائِد (أكثر من اللازم أو مُضاف إلى ما هو موجود) / بشكل إضافي, بشكل استثنائي (بشكل غير عادي أو استثنائي) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إِضَافِيّ, خَاصّ (مضاف إلى الجدول المنتظم)\nمثال: سيارة سريعة بشكل استثنائي",
 "そのため": "وَعَلَيْهِ, وَمِنْ ثَمَّ",
 "そのたもろもろ": "إذن, ثم (لاحقاً أو بعد ذلك بقليل (تستخدم غالباً كروابط للجمل))",
 "そのつど": "أبداً",
 "そのてんで": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "そのとき": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "そのなか": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "そののち": "أَخِير, بَعْدَ ذٰلِك\nمثال: その後の話はご存じでしょう。 — أنتَ تعرف بقية القصة.",
 "そのはず": "طَبْعًا",
 "そのはんめん": "من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "そのば": "هُنَاكَ / فوراً, في الحال (دون تأخير أو حالاً) / في الموقع, في عين المكان (في المكان المعني؛ هناك) / في مأزق, في موقف محرج (في موقف صعب)\nمثال: وظفناها في الحال",
 "そのばあいには": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "そのばかぎり": "مُؤَقَّت",
 "そのばしのぎ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة)",
 "そのばのがれ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "そのひぐらし": "كفافاً, يوماً بيوم (بما يكفي بالكاد للاحتياجات الفورية)\nمثال: عاشوا يوماً بيوم",
 "そのひそのひ": "يَوْمِيّ (يتعلق بكل يوم أو يحدث كل يوم)\nمثال: その日その日で天気は変わる。 — يتغيّر الجوّ من يوم إلى آخر.",
 "そのぶん": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان / بناءً على ذلك, نتيجة لذلك ((روابط الجمل) بسبب السبب المذكور) / وفقاً لذلك (بما يتوافق مع)\nمثال: نتيجة لذلك، لم يفعل ذلك",
 "そのへん": "تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة",
 "そのほう": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そのほか": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / إِضَافَةً عَلى ذٰلِكَ / وَهٰكَذَا, وَهَلُمَّ جَرًّا",
 "そのほかに": "غَيْر, آخَر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / وَإِلَا\nمثال: أنا غير متفاجئ.",
 "そのまさかだ": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ",
 "そのまま": "كَمَا هُوَ, كَمَا هِيَ / فَوْرًا, حَالًا",
 "そのまんま": "كَمَا هُوَ, كَمَا هِيَ / فَوْرًا, حَالًا",
 "そのみち": "عَلَاقَة غَرَامِيَّة",
 "そのもと": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "そのもの": "نَفْسُهُ, نَفْسُهَا",
 "そのよう": "مِثْل, هَكَذَا (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "そのわりには": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة",
 "そのケ": "مِثْلِيَّة, مِثْلِيَّة جِنْسِيَّة",
 "その一方": "أَمَّا (حَرْفُ اِسْتِفْتَاحٍ، وَيَكْثُرُ اِسْتِعْمَالُهُ قَبْلَ القَسَمِ) / إِلَى حِينِ ذَلِكَ الوَقْتِ فِي الأَثْنَاءِ (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / فِي حِينِ أَنَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: أما زلت تذكرني؟",
 "その上": "إِضَافَةً عَلى ذٰلِكَ / أَعْلَى (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / فَوقَ / شَمَالِيّ / على (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذها إلى الأعلى. / كَان يَامَا كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "その上で": "عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك",
 "その中": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "その事": "لِكَيْ, أَنْ / ذٰلِكَ, ذَاكَ / تِلْكَ / اَلَّذِي / اَلَّتِي / اَلَّذِينَ",
 "その他": "رَاحَة, اِسْتِرَاحَة / اِسْتَرَاحَ (اِرْتَاح؛ طلب الرَاحَة) / بَاقِيَّة / أَثَارَة\nمثال: عليك أخذ استراحة. / إِضَافَةً عَلى ذٰلِكَ / وَهٰكَذَا, وَهَلُمَّ جَرًّا",
 "その他に": "غَيْر, آخَر (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / وَإِلَا\nمثال: أنا غير متفاجئ.",
 "その他もろもろ": "إذن, ثم (لاحقاً أو بعد ذلك بقليل (تستخدم غالباً كروابط للجمل))",
 "その他大勢": "إِضَافِيّ, زَائِد (أكثر من اللازم أو مُضاف إلى ما هو موجود) / بشكل إضافي, بشكل استثنائي (بشكل غير عادي أو استثنائي) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إِضَافِيّ, خَاصّ (مضاف إلى الجدول المنتظم)\nمثال: سيارة سريعة بشكل استثنائي",
 "その他諸々": "إذن, ثم (لاحقاً أو بعد ذلك بقليل (تستخدم غالباً كروابط للجمل))",
 "その代り": "بَدَلاً مِن",
 "その代わり": "بَدَلاً مِن",
 "その儘": "كَمَا هُوَ, كَمَا هِيَ / فَوْرًا, حَالًا",
 "その内": "قَرِيبًا, سَرْعَانَ مَا",
 "その内に": "قَرِيبًا, سَرْعَانَ مَا",
 "その分": "إلى هذا الحد, بقدر ما (إلى الدرجة أو المدى الذي)\nمثال: بقدر ما يمكن التأكد، رئة الحصان قابلة للمقارنة برئة الإنسان / بناءً على ذلك, نتيجة لذلك ((روابط الجمل) بسبب السبب المذكور) / وفقاً لذلك (بما يتوافق مع)\nمثال: نتيجة لذلك، لم يفعل ذلك",
 "その割には": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة",
 "その割りには": "بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير متوقع, فجأة (بطريقة لم تكن متوقعة)\nمثال: التقيا بالصدفة",
 "その半面": "من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "その反面": "من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "その場": "هُنَاكَ / فوراً, في الحال (دون تأخير أو حالاً) / في الموقع, في عين المكان (في المكان المعني؛ هناك) / في مأزق, في موقف محرج (في موقف صعب)\nمثال: وظفناها في الحال",
 "その場かぎり": "مُؤَقَّت",
 "その場しのぎ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة)",
