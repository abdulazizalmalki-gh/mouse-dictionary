 "たんじゅんたんぱくしつ": "بروتين بسيط (بروتين ينتج أحماضاً أمينية فقط عند تحلله مائياً)",
 "たんじゅんほうしん": "الهربس البسيط, فيروس الهربس البسيط (فيروس هربس يصيب الجلد والجهاز العصبي)",
 "たんじゅんタンパクしつ": "بروتين بسيط (بروتين ينتج أحماضاً أمينية فقط عند تحلله مائياً)",
 "たんじゅんヘルペスウイルス": "الهربس البسيط, فيروس الهربس البسيط (فيروس هربس يصيب الجلد والجهاز العصبي)",
 "たんじょう": "وِلَادَة, مَوْلِد\nمثال: أعرف ذلك الولد. / خِلْقَة, خَلْق\nمثال: زيري سيء الخلق.",
 "たんじょうかい": "حَفْلَة عِيد مِيلَاد",
 "たんじょうし": "إجهاض تلقائي, إسقاط (فقدان طبيعي لنتاج الحمل)",
 "たんじょうせき": "حجر البخت (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها…)\nمثال: عوقب زيري بالحجر.",
 "たんじょうび": "عِيد مِيلَاد\nمثال: طقس اليوم جميل.",
 "たんじょうびおめでとうございます": "كُلُّ عَامٍ وَأَنْتُمْ بِخَيْرٍ, عِيد مِيلَاد سَعِيد",
 "たんじょうびかい": "حَفْلَة عِيد مِيلَاد",
 "たんじょうびケーキ": "كَعْكَة عِيد مِيلَاد (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز…)\nمثال: خبزت كعكة لتوم.",
 "たんじょうびパーティー": "حَفْلَة عِيد مِيلَاد",
 "たんじょうびプレゼント": "هدية عيد ميلاد (هدية تُقدم احتفالاً بعيد ميلاد شخص)",
 "たんじょうパーティー": "حَفْلَة عِيد مِيلَاد",
 "たんじる": "عَوِيل, رَثَاء\nمثال: بكى زيري كثيرا. / عَجَبَ",
 "たんす": "كُمُودِينُو, أَدْرَاجِيَّة",
 "たんすい": "مَاء عَذْب (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما…)\nمثال: أنا أشرب الماء. / علاج بالغمر, علاج بالفيضان (تقنية تستخدم في العلاج السلوكي؛ يتم إغراق العميل بتجارب من نوع معين حتى يصبح…)",
 "たんすいか": "تَقْطِير, إِعْذَاب",
 "たんすいかぶつ": "كَرْبُوهِيدْرَات",
 "たんすいぎょ": "سمك مياه عذبة (لحم السمك من المياه العذبة المستخدم كطعام)",
 "たんすいさん": "ماء عذب (ماء غير مالح)",
 "たんすいしゃ": "طَرِيّ, غَضّ ((عَنِ النَّبَاتَاتِ) غَيْرُ مُقَاوِم؛ يَسْهُلُ أَنْ يَمُوتَ بِظُرُوفِ…)",
 "たんすう": "أَحَادِيّ\nمثال: رأيت واحدة مرة. / مُفْرَد ((في النحو) يصف شيئًا أو شخصًا واحدًا فقط؛ كَلِمَة)",
 "たんすうけい": "صيغة المفرد, مفرد (صيغة الكلمة المستخدمة للدلالة على شيء واحد)",
 "たんすうたい": "أحادي الصيغة الصبغية (لخلية أو كائن حي يحتوي على مجموعة واحدة من الكروموسومات)",
 "たんずる": "عَوِيل, رَثَاء\nمثال: بكى زيري كثيرا. / عَجَبَ",
 "たんせい": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله…) / دِهَان\nمثال: ما هو لون شعرك؟ / لَوْحَة, صُورَة / أُحَادِيّ الجِنْس (يتعلّق بجنس واحد فقط أو له نوع واحد من الأعضاء الجنسية) / تَنَهَّدَ / جَمِيل (حَسَن)\nمثال: طقس اليوم جميل. / بشكل صحيح, كما ينبغي (بالطريقة الصحيحة؛ بشكل لائق)\nمثال: أرجوك قم بعملك كما ينبغي! / تَهْذِيب / سَمَاوِيّ, لَبَنِيّ",
 "たんせいおんがく": "أحادية الصوت, موسيقى أحادية الصوت (موسيقى تتكون من خط صوتي واحد (عادة مع مرافقة))",
 "たんせいしょく": "سَمَاوِيّ, لَبَنِيّ",
 "たんせいせいしょく": "توالد عذري (عملية تتطور فيها البويضة غير المخصبة إلى فرد جديد؛ شائعة بين الحشرات وبعض…)",
 "たんせいせつ": "طبيعة واحدة, مونوفيزية (هرطقة مسيحية من القرنين الخامس والسادس تحدت التعريف الأرثوذكسي للطبيعتين…)",
 "たんせいろん": "طبيعة واحدة, مونوفيزية (هرطقة مسيحية من القرنين الخامس والسادس تحدت التعريف الأرثوذكسي للطبيعتين…)",
 "たんせき": "حَصَاة مَرَارِيَّة / لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "たんせきしょう": "تحصي المرارة, حصى المرارة (وجود حصوات في المرارة)",
 "たんせん": "حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما)\nمثال: قام بتدوير حواف الصندوق",
 "たんせんぽう": "سلم صغير (سلم يعتمد على السلم الصغير)",
 "たんぜい": "لَوْحَة, صُورَة",
 "たんぜん": "سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته)\nمثال: علاج طبي مناسب / بَسِيط\nمثال: هذا الشعور سهل. / اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر)\nمثال: شعرت بالخجل و احمر وجهها.",
 "たんそ": "كَرْبُون / جَمْرَة خَبِيثَة",
 "たんそう": "طبقة فحم, عرق فحم (طبقة من الفحم)",
 "たんそうしゃ": "نَقَّالَة, مِحَفَّة",
 "たんそかいけい": "غازات دفيئة",
 "たんそきん": "عصوية الجمرة الخبيثة (نوع من العصويات يسبب الجمرة الخبيثة في البشر والحيوانات (الماشية والخنازير…)",
 "たんそく": "تَنَهَّدَ / سَبَّار, مُتَعَمِّق (دقيق وشامل في البحث أو التحقيق)",
 "たんそこう": "صلب كربوني, فولاذ كربوني (فولاذ تُحدد خصائصه بمقدار الكربون الذي يحتويه)",
 "たんそじゅうしほう": "تأريخ بالكربون المشع, تأريخ بالكربون-14 (تحليل كيميائي يستخدم لتحديد عمر المواد العضوية بناءً على محتواها من النظير…)",
 "たんそじゅんかん": "دورة الكربون (تفاعل نووي حراري في باطن النجوم)",
 "たんそびょう": "جَمْرَة خَبِيثَة",
 "たんぞう": "تطريق, حدادة (تشكيل المعدن عن طريق التسخين والطرق)",
 "たんたい": "نَاقِل\nمثال: يبدو أنني حامل.",
 "たんたん": "غَيْرُ مُكْتَرِث, غَيْرُ مُهْتَمّ (لا يبالي ولا يهتم بالمعرفة)\nمثال: متفرج غير مهتم / بَسِيط\nمثال: هذا الشعور سهل. / بِجَشَع, بِطَمَع (بطريقة جشعة)\nمثال: نظر إلى سيارة صديقه الجديدة بحسد / مُسْتَوًى / خالٍ من الأحداث, رتيب (يتميز بعدم وجود أحداث جديرة بالملاحظة أو هامة)\nمثال: حياة خالية من الأحداث",
 "たんだ": "ضربة آمنة, ضربة قاعدة ((في البيسبول) العمل الناجح لضرب الكرة بطريقة تمكن الضارب من الوصول إلى القاعدة…)",
 "たんだい": "كلية متوسطة, كلية مجتمع (كلية تقدم فقط السنتين الأوليين وتنتهي بدرجة مشارك)",
 "たんだいせい": "كلية متوسطة, كلية مجتمع (كلية تقدم فقط السنتين الأوليين وتنتهي بدرجة مشارك)",
 "たんち": "اكتشاف, رصد (فعل اكتشاف شيء ما؛ أو ملاحظة شيء ما)\nمثال: التحري صعب على القدمين (يتطلب مشياً كثيراً)",
 "たんちき": "حساس, كاشف (أي جهاز يستقبل إشارة أو محفزاً (مثل الحرارة أو الضغط أو الضوء أو الحركة)…)",
 "たんちょ": "نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "たんちょう": "رَتَابَة, وَتِيرَة وَاحِدَة (ثبات النغمة أو الطبقة الصوتية أو التصريف)\nمثال: لم يعتد أبداً على رتابة عمله / أُحَادِيُّ النَّغْمَة, رَتِيب (يُنْطَقُ أَوْ يُسْمَعُ بِنَغْمَةٍ ثَابِتَةٍ لَا تَتَفَاوَتُ فِي الطَّبَقَة) / سلم صغير (سلم يعتمد على السلم الصغير)",
 "たんちょうせい": "اِطِّرَادُ دَالَّةٍ",
 "たんつば": "بلغم (مادة مقشوعة (مبصوقة)؛ لعاب ممزوج بإفرازات من الممرات التنفسية)",
 "たんつぼ": "مبصقة (وعاء للبصق (عادة في مكان عام))",
 "たんづつ": "مُسَدَّس (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم…)\nمثال: كان عند زيري مسدس.",
 "たんてい": "مُحَقِّق (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ…)\nمثال: تحدث ياني مع محقق. / تحري, كشف الجرائم (تحقيق للشرطة لتحديد الجاني)\nمثال: التحري صعب على القدمين (يتطلب مشياً كثيراً) / قَارِب, مَرْكَب (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير",
 "たんていぎょう": "تحري, كشف الجرائم (تحقيق للشرطة لتحديد الجاني)\nمثال: التحري صعب على القدمين (يتطلب مشياً كثيراً)",
 "たんていしゃ": "مكتب تحقيقات خاص, وكالة تحريات (وكالة تقوم بإجراء استفسارات لعملائها)",
 "たんていしょうせつ": "قصة بوليسية (سرد عن شخص يحقق في الجرائم ويحصل على أدلة تؤدي إلى حلها)",
 "たんていじむしょ": "مكتب تحقيقات خاص, وكالة تحريات (وكالة تقوم بإجراء استفسارات لعملائها)",
 "たんていだん": "عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "たんてき": "إِفْرَنْجِيّ",
 "たんてつ": "حديد مطاوع (حديد يحتوي على نسبة منخفضة من الكربون وهو متين وقابل للطرق وبالتالي يمكن تشكيله…)",
 "たんてん": "مِرْسَاة, أَنْجَر / أسيد, حمض (اسم دارج لثنائي إيثيل أميد حمض الليسرجيك)\nمثال: صف من النقاط",
 "たんでき": "صَكّ غُفْرَان",
 "たんでん": "حقل فحم (منطقة يوجد فيها فحم تحت الأرض)",
 "たんと": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "たんとう": "سِكِّين, مُدْيَة (أَدَاةٌ حَادَةٌ تُسْتَخْدَمُ فِي تَقْطِيعِ مُخْتَلَفِ أَصْنَافِ الطَّعَامِ…)\nمثال: أحتاج الى سكين. / أحادي الماسورة (له ماسورة واحدة)\nمثال: معظم البنادق أحادية الماسورة / قصر الرأس (صفة قصر الجمجمة أو الرأس (عرض الرأس كبير بالنسبة لطوله)) / سكر أحادي, سكريات أحادية (سكر (مثل السكريات البسيطة) لا يتحلل مائياً ليعطي سكريات أخرى؛ وهو أبسط مجموعة…)",
 "たんとうかん": "ضابط حالة (عميل يعمل أيضًا كموظف رسمي في جهاز استخبارات)",
 "たんとうしゃ": "مُلَامَسَة, لَمْسَة",
 "たんとうだいじん": "منصب وزاري, وزير في الحكومة (وظيفة وزير كبير يكون عضواً في مجلس الوزراء)",
 "たんとうちょくにゅう": "بشكل مباشر, بصراحة تامة (بطريقة مباشرة ولا لبس فيها)\nمثال: سألته بصراحة تامة عما إذا كان يريد الوظيفة",
 "たんとうぶちょう": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير.",
 "たんとうるい": "سكر أحادي, سكريات أحادية (سكر (مثل السكريات البسيطة) لا يتحلل مائياً ليعطي سكريات أخرى؛ وهو أبسط مجموعة…)",
 "たんどく": "حمرة (عدوى عقدية حادة تتميز بالتهاب أحمر عميق في الجلد والأغشية المخاطية) / وَحِيد\nمثال: سمكة ميناد ماتت / اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع…)\nمثال: الصحراويون يريدون الاستقلال.",
 "たんどくこうどうしゅぎ": "أحادية الجانب (المذهب القائل بأن الأمم يجب أن تدير شؤونها الخارجية بشكل فردي دون مشورة أو…)",
 "たんどくしつ": "حَبْس اِنْفِرَادِيّ (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "たんどくしゅぎ": "أحادية الجانب (المذهب القائل بأن الأمم يجب أن تدير شؤونها الخارجية بشكل فردي دون مشورة أو…)",
 "たんどくで": "بشكل مستقل (بمفردك؛ دون مساعدة خارجية)\nمثال: عمل الأطفال على المشروع بشكل مستقل",
 "たんどくないかく": "أُحَادِيّ الحِزْب (يُحدَّد من قبل حزب واحد)",
 "たんなる": "بحيرة صغيرة, بركة (بركة صغيرة من المياه الراكدة)",
 "たんに": "بِكُلّ بَسَاطَة (بَكَلَه: خَلَطَه؛ بَكَلَ عَلَيْنَا حَديثَه وأَمْرَه: خَلَطَهُ وجاءَ بِهِ عَلَى…)\nمثال: غادرنا بكل بساطة.",
 "たんにんのせんせい": "غرفة الصف الرئيسي (فصل دراسي يجتمع فيه جميع الطلاب في صف معين (أو في قسم من صف) في أوقات معينة تحت…)",
 "たんぬ": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا. / طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا.",
 "たんねん": "مُجْتَهِد, وَرِع فِي عَمَلِه (يَتَّسِم بِعِنَايَة فَائِقَة وجُهْدٍ كَبِير)",
 "たんのう": "بَارِع, حَاذِق (يمتلك معرفة ومهارة وكفاءة ويُظهرها)\nمثال: كان ابتكاره الفني هو ضربات فرشاته / مرارة (كيس عضلي ملحق بالكبد يخزن الصفراء (التي يفرزها الكبد) حتى الحاجة إليها للهضم) / دماغ انتهائي (القسم الأمامي من الدماغ الأمامي؛ المخ والأجزاء ذات الصلة من الوطاء)",
 "たんのうえん": "التهاب المرارة (التهاب المرارة)",
 "たんはい": "رئة سوداء, سحار فحم (مرض رئوي ناجم عن استنشاق غبار الفحم)",
 "たんはんけい": "نصف المحور الأصغر (نصف المحور الأصغر للقطع الناقص)",
 "たんばん": "قِنَاع (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع. / زاج أزرق (شكل بلوري أزرق مائي لكبريتات النحاس)",
 "たんぱ": "موجة قصيرة (موجة راديوية بطول موجي أقل من 100 متر (تردد أكبر من 3 ميغا هرتز))",
 "たんぱく": "إِشَارَة مُرُور, إِشَارَة ضَوْئِيَّة\nمثال: نسي أن يطفئ النور. / إِفْرَنْجِيّ / بْرُوتِين (في جزيئات حيوية ضخمة تتكون من سلسلة أو أكثر من الأحماض الأمينية)\nمثال: يحتوي اللحم على البروتين. / غِرْقِل, آح البَيْض",
 "たんぱくしつ": "بْرُوتِين (في جزيئات حيوية ضخمة تتكون من سلسلة أو أكثر من الأحماض الأمينية)\nمثال: يحتوي اللحم على البروتين.",
 "たんぱくしつぶんかいこうそ": "بروتياز (أي إنزيم يحفز انقسام البروتينات إلى أجزاء ببتيد أصغر وأحماض أمينية بعملية تعرف…)",
 "たんぱくせき": "أُوبَال",
 "たんぱくどうかステロイド": "ستيرويد بنائي, منشط (أي من مجموعة الهرمونات الستيرويدية الاصطناعية التي تستخدم لتحفيز نمو العضلات…)",
 "たんぱくにょう": "بيلة ألبومينية, بيلة بروتينية (وجود بروتين مفرط (بشكل رئيسي الألبومين ولكن أيضاً الجلوبيولين) في البول؛ عادة…)",
 "たんぱく質": "بْرُوتِين (في جزيئات حيوية ضخمة تتكون من سلسلة أو أكثر من الأحماض الأمينية)\nمثال: يحتوي اللحم على البروتين.",
 "たんぱつ": "حدث لمرة واحدة (حدث يقع مرة واحدة فقط ولا يتكرر)",
 "たんぱつせい": "أَحَادِيّ\nمثال: رأيت واحدة مرة.",
 "たんぱら": "حَادّ المِزَاج, سَرِيع الغَضَب (يُستثار إلى الغضب بسرعة)",
 "たんぱん": "زاج أزرق (شكل بلوري أزرق مائي لكبريتات النحاس)",
 "たんび": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / إِعْجَاب",
 "たんびてき": "جَمَالِيّ, فَنِّيّ (يتعلق بـ أو يتميز بتقدير الجمال أو الذوق الرفيع)\nمثال: الملكات الجمالية",
 "たんびに": "كُلَّمَا",
 "たんびるい": "قصيرات الذيل (السرطانات النموذجية)",
 "たんぶん": "جملة بسيطة (جملة ليس لها جمل معطوفة أو تابعة)",
 "たんべつ": "رقعة أرض, مساحة أرض (مساحة من الأرض تستخدم لغرض معين (مثل البناء أو الزراعة))\nمثال: أراد بعض المساحة من الأرض للبناء عليها",
 "たんべん": "بطنيات القدم (طائفة من الرخويات لها عادة صدفة ملفوفة من قطعة واحدة وقدم عضلية مسطحة ورأس يحمل…)",
 "たんぺいきゅう": "تسرع, هوج (اندفاع طائش)",
 "たんぺん": "قِصَّة قَصِيرَة, أُقْصُوصَة",
 "たんぺんしょうせつ": "قِصَّة قَصِيرَة, أُقْصُوصَة",
 "たんほうがた": "أُحَادِيّ المِنْوَال (لديه منوال واحد)",
 "たんほうこう": "مُبَسَّط (دَرْسٌ مُبَسَّطٌ : سَهْلٌ، وَاضِحٌ)\nمثال: هذا الكتاب مؤلف بلغة إنجليزية مبسطة و هو سهل للقراءة.",
 "たんほんい": "نظام المعدن الواحد (استخدام معدن واحد فقط (مثل الذهب أو الفضة) في العملة القياسية للبلد، أو كمعيار…)",
 "たんほんいせい": "نظام المعدن الواحد (استخدام معدن واحد فقط (مثل الذهب أو الفضة) في العملة القياسية للبلد، أو كمعيار…)",
 "たんぼ": "حقل أرز (حقل مروي أو مغمور يُزرع فيه الأرز)",
 "たんぼいん": "حركة قصيرة, صائت قصير (في اللغات التي تميز طول الصائت، هو صائت يتم نطقه عادة أقصر من الصائت الطويل)",
 "たんぼう": "بَحْثِيّ, فَاحِص (يستكشف بشكل معمّق وشامل)",
 "たんぽ": "أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه)\nمثال: اتصل زيري بالأمن. / ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء. / وِسَادَة (الجانب السفلي اللحمي الشبيه بالوسادة لقدم الحيوان أو إصبع الإنسان) / قربة ماء ساخن (وعاء ذو سدادة (عادة من المطاط) يملأ بالماء الساخن لتدفئة السرير أو الجسم)",
 "たんぽうらくだ": "جمل عربي (جمل ذو سنام واحد من الصحاري الحارة في شمال أفريقيا وجنوب غرب آسيا)",
 "たんぽけん": "حق الضمان, مصلحة الضمان (أي مصلحة في ممتلكات تضمن سداد التزام)",
 "たんぽせきにん": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "たんぽぶっけん": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)\nمثال: أبناء العمومة هم أقارب جانبيون",
 "たんま": "هُدْنَة",
 "たんまつ": "فِي مَرْحَلَة مُتَأَخِّرَة, نِهَائِيّ (يُسَبِّب أَوْ يَنْتَهِي بِالمَوْت أَوْ يَقْتَرِب مِنْه)\nمثال: العمود الطرفي / نِهَايَة, غَايَة\nمثال: انتهى أمر زيري.",
 "たんまつかんあんごうか": "بالكامل, من البداية إلى النهاية (من الأول إلى الأخير)\nمثال: المسرحية كانت ممتازة من البداية إلى النهاية",
 "たんまつき": "فِي مَرْحَلَة مُتَأَخِّرَة, نِهَائِيّ (يُسَبِّب أَوْ يَنْتَهِي بِالمَوْت أَوْ يَقْتَرِب مِنْه)\nمثال: العمود الطرفي",
 "たんまつエミュレーション": "محاكاة الطرفية ((علم الحاسوب) جعل جهاز الكمبيوتر يتصرف تمامًا مثل المحطة الطرفية)",
 "たんみん": "سنة, غفوة (النوم لفترة قصيرة (عادة ليس في السرير))",
 "たんめん": "حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما)\nمثال: قام بتدوير حواف الصندوق",
 "たんもうしゅ": "قَصِير الشَّعْر (ذو شعر قصير)",
 "たんもの": "قُمَاش, نَسِيج (النسيج الذي لم يُقَصّ أو يُخَاط)\nمثال: الورق و القماش يمتصان الماء.",
 "たんや": "حَدَّاد, قَيْن",
 "たんよう": "ورقة بسيطة (ورقة غير مقسمة إلى أجزاء) / طائرة أحادية الجناح, طائرة أحادية السطح (طائرة بجناح واحد)",
 "たんようき": "طائرة أحادية الجناح, طائرة أحادية السطح (طائرة بجناح واحد)",
 "たんようひこうき": "طائرة أحادية الجناح, طائرة أحادية السطح (طائرة بجناح واحد)",
 "たんよく": "طَمَّاع, جَشِع\nمثال: كانت صوفيا شرهة.",
 "たんらく": "دائرة قصر, ماس كهربائي (تلامس عرضي بين نقطتين في دائرة كهربائية يوجد بينهما فرق جهد)",
 "たんらくてき": "تَبْسِيطِيّ, سَاذَج (يتَّسم بالبساطة المُفرطة والمُضلِّلة أحيانًا)",
 "たんらん": "طَمَع, شُحُّ",
 "たんり": "فائدة بسيطة (فائدة تُدفع على المبلغ الأصلي فقط) / تَوَحُّد",
 "たんりょ": "حماقة, سفاهة (نقص الحذر في الشؤون العملية) / حدة الطبع, سرعة الغضب (شعور بالغضب الممتزج بالاستياء)",
 "たんりょうたい": "أحادي الجزيء, مونومر (مركب بسيط يمكن لجزيئاته أن ترتبط معاً لتكوين بوليمرات)",
 "たんりょく": "شَجَاعَة, جَسَارَة\nمثال: 君は胆力を練る必要がある。 — يجب أن تُنَمِّيَ شجاعتك.",
 "たんれい": "حَسَن المَظْهَر, وَسِيم (ممتع المظهر خاصة بسبب التناسق مع مُثُل الشكل والتناسب)",
 "たんれん": "تطبيع, تلدين (تقسية شيء ما بالمعالجة الحرارية) / تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "たんろ": "دائرة قصر, ماس كهربائي (تلامس عرضي بين نقطتين في دائرة كهربائية يوجد بينهما فرق جهد)",
 "たんをきる": "تَنَحْنَحَ",
 "たんをはっする": "نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "たんカル": "كربونات الكالسيوم (ملح يوجد في الطبيعة كطباشير أو كالسيت أو أراجونيت أو حجر جيري)",
 "たんシロップ": "شراب السكر, شيرة (سكر وماء وأحياناً شراب الذرة يغلى معاً؛ يستخدم للتحلية خاصة في المشروبات)",
 "たんパン": "شُورْت",
 "たんプレ": "هدية عيد ميلاد (هدية تُقدم احتفالاً بعيد ميلاد شخص)",
 "たーけ": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "だ": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / فَقِير / حِمْل (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه. / حصان حمل (حصان عمل يستخدم كحيوان حمل) / جَاهِز, نَاضِج (مَطْهُوٌّ حَتَّى أَصْبَحَ جَاهِزًا لِلتَّقْدِيم) / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / ضرب الكرة ((بيسبول) محاولة الضارب للوصول إلى القاعدة) / فَرْع, غُصْن",
 "だあっ": "بغتة, فجأة (بشكل مفاجئ)\nمثال: فجأة، بدأ بالصراخ",
 "だあれ": "مَن, مين (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "だい": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / إعداد المسرح, ديكور المسرح (ترتيب المناظر والممتلكات لتمثيل المكان الذي تُمثل فيه مسرحية أو فيلم)\nمثال: كان الماس في مثبت ذهبي بسيط / جَرْد, خَزِين (جَرَدَ الشيءَ: أحصى ما فيه، ضبط قيمته؛ جَرَدَ البطاطسَ: قشّرها وأزال ما عليها)\nمثال: كان سامي جرد طفل. / مُسْتَوًى / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة. / تَمْرِين / تُهْمَة\nمثال: أقوم بشحن هاتفي / جِيل, نَسْل / حِقْبَة (مدة من الزمان تُقَدَّرُ بطولٍ غير محدد، وقد تكون قصيرة أو طويلة بحسب السياق…)\nمثال: لقد بدأت حقبة جديدة في الجزائر. / بِاسْم, بِالنِّيَابَة عَن / كَبِير, وَاسِع (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير. / رَائِع, عَظِيم\nمثال: الصين بلد عظيم. / جَامِعَة (مؤنث الجَامِع، اسم فاعل من جَمَعَ، التي تَجْمَع؛ الغُلّ يجمع اليدين إِلى العُنُق)\nمثال: هكذا دخل الجامعة. / بِرَاز, سَلْح / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "だいあく": "بِشَاعَة, قَسْوَة",
 "だいあくにん": "وَحْش (حَيْوَان غير مستأنس يعيش بعيدا عن الناس، وهي أصل الكلمة؛ حيوان مُفْتَرِس)\nمثال: ضرب زيري الوحش.",
 "だいい": "إحلال الدائن, حلول دائن ((قانون) عملية استبدال دائن بآخر) / طَيَّار, قُبْطَان (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "だいいち": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَفْضَل / الأهم, قبل كل شيء (فوق كل اعتبار آخر)\nمثال: قبل كل شيء، يجب أن تكون مستقلاً",
 "だいいちぎてき": "أَسَاسِيّ",
 "だいいちげんご": "اللغة الأصلية, اللغة الأم (اللغة الأصلية للفرد؛ اللغة التي يتعلمها الأطفال وتنتقل من جيل إلى جيل)",
 "だいいちげんり": "ألفباء, مبادئ أولية (المراحل الأولية لأي موضوع)\nمثال: أتقن فقط مبادئ الهندسة الأولية",
 "だいいちごう": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى)",
