 "たしゅたよう": "تَنَوُّع, تَعَدُّدِيَّة",
 "たしょ": "في مكان آخر (في أو إلى مكان آخر)\nمثال: ذهب إلى مكان آخر / مُتَحَرِّك",
 "たしょう": "غَائِب / تَنَاسُخ الْأَرْوَاح / قَلِيلًا / مَبْلَغ, مِقْدَار",
 "たしょうなりとも": "لَيْتَ, تَمَنَّى (يفيد التمني)\nمثال: ليت بحاجة لتعمل ساعات إضافية.",
 "たしん": "خصومة, ضغينة (طبع عدائي (غير ودود للغاية))\nمثال: لم يستطع إخفاء عدائه",
 "たしんきょう": "شِرْك, تَعَدُّد الْآلِهَة ((شَرِكَتِ) النَّعْلُ تَشْرَكُ شَرَكًا: انقطَعَ شِراكُها؛ (شَرِكَتْ) فُلانًا في…)\nمثال: هذه شركة صينية.",
 "たしんろん": "شِرْك, تَعَدُّد الْآلِهَة ((شَرِكَتِ) النَّعْلُ تَشْرَكُ شَرَكًا: انقطَعَ شِراكُها؛ (شَرِكَتْ) فُلانًا في…)\nمثال: هذه شركة صينية.",
 "たじげん": "متعدد الأبعاد, متعدد الجوانب (له أو ينطوي على أو يتميز بأبعاد أو جوانب عدة)\nمثال: مشاكل متعددة الأبعاد",
 "たじたじ": "بترنح, بشكل غير مستقر (بطريقة غير ثابتة)\nمثال: مشى مترنحاً نحو المخرج / بشدة, بشكل هائل (بدرجة كبيرة جداً)\nمثال: كان محبوباً بشكل هائل",
 "たじつ": "فيما بعد, من الآن فصاعداً (بعد هذا في الزمان أو الترتيب أو المكان؛ بعد هذا)\nمثال: من الآن فصاعداً لن تتلقى مصروفاً",
 "たじひ": "أفعى الحفر (أفاعي العالم الجديد ذات أنياب مجوفة وحفرة حساسة للحرارة على كل جانب من الرأس)",
 "たじゅう": "متعدد / عصارية (جاذبية شهية غنية بالعصارة)",
 "たじゅうか": "مُتَشَعِّب, مُتَعَدِّد (ذُو أَجْزَاء أَوْ جَوَانِب كَثِيرَة)",
 "たじゅうかそうち": "مجمع إشارات, ملتيبلكسر (جهاز يمكنه تداخل نشاطين أو أكثر)",
 "たじゅうしょり": "مُتَشَعِّب, مُتَعَدِّد (ذُو أَجْزَاء أَوْ جَوَانِب كَثِيرَة)",
 "たじゅうじんかく": "انفصام الشخصية, تعدد الشخصيات (اضطراب انشقاقي نادر نسبياً ينهار فيه التكامل المعتاد للشخصية وتظهر شخصيتان…)",
 "たじゅうじんかくしょう": "انفصام الشخصية, تعدد الشخصيات (اضطراب انشقاقي نادر نسبياً ينهار فيه التكامل المعتاد للشخصية وتظهر شخصيتان…)",
 "たじゅうじんかくしょうがい": "انفصام الشخصية, تعدد الشخصيات (اضطراب انشقاقي نادر نسبياً ينهار فيه التكامل المعتاد للشخصية وتظهر شخصيتان…)",
 "たじゅうとう": "بَاغُودٰ",
 "たじゅうプログラミング": "برمجة متعددة, تنفيذ متزامن (تنفيذ برنامجين أو أكثر بواسطة كمبيوتر واحد)",
 "たじゅうプロセッサ": "معالج متعدد (حاسوب يستخدم وحدتي معالجة أو أكثر تحت تحكم متكامل)",
 "たじゅうプロセッシング": "معالجة متعددة, معالجة متوازية (معالجة متزامنة بواسطة وحدتي معالجة أو أكثر)",
 "たじょう": "فَاسِق, مُسْتَهْتِر (مُتَحَرِّرٌ مِنَ القُيُودِ الأَخْلَاقِيَّةِ وَالأَعْرَاف) / مُثَار عَاطِفِيًّا, مُنْفَعِل ((للأشخاص) متأثر بشكل مفرط بالعاطفة)\nمثال: كان سلوكه عاطفياً للغاية",
 "たじょうたかん": "رَكِيكُ الحِسّ, مُبْتَذَلُ العَاطِفَة (مُفرِط في العاطفة بشكل مُتصنَّع أو غير صادق)",
 "たじょうたこん": "تحسس, حساسية ((علم وظائف الأعضاء) الاستجابة للمحفزات الخارجية؛ ملكة الإحساس)\nمثال: حساسية للألم",
 "たじろぐ": "تألم, جفل (استجابة انعكاسية لألم مفاجئ)",
 "たす": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول.",
 "たすう": "جموع, حشد (كمية كبيرة غير محددة)\nمثال: حشد من النمل / غَالِبِيَّة, أَغْلَبِيّة",
 "たすういけん": "رأي الأغلبية (الرأي الذي انضمت إليه أغلبية المحكمة)",
 "たすうけつ": "حكم الأغلبية, ديمقراطية (المذهب القائل بأن الأغلبية العددية لمجموعة منظمة يمكنها اتخاذ قرارات ملزمة…)",
 "たすうけつえんざん": "عملية أغلبية (عملية عتبة يكون فيها كل معامل 0 أو 1؛ والمخرجات تكون 1 إذا وفقط إذا كان أكثر من…)",
 "たすかる": "نَجَا",
 "たすき": "وِشَاح / أوبيا, سحر أوبيا (معتقد ديني من أصل أفريقي يتضمن السحر والشعوذة؛ يمارس في أجزاء من جزر الهند…)",
 "たすく": "مُسَاعَدَة, مَعُونَة\nمثال: علي مساعدة ماري.",
 "たすけ": "مُسَاعَدَة, إِمْدَاد",
 "たすけあい": "تَعَاوُن",
 "たすけあう": "تَعَاوَنَ",
 "たすけあげる": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ…)\nمثال: أحب قطف الورود.",
 "たすけだす": "أَنْقَذَ, خَلَّصَ",
 "たすけて": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد…)\nمثال: علي مساعدة ماري.",
 "たすけになる": "مُسَاعَدَة, مَعُونَة\nمثال: علي مساعدة ماري.",
 "たすけぶね": "قَارِب نَجَاةَ (الزَّورق؛ سفينة صغيرة)\nمثال: كان لسامي قارب صغير / مساعدة, يد العون (مساعدة جسدية)\nمثال: أعطني يد العون في الأعمال المنزلية",
 "たすけまもる": "حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "たすける": "أَنْقَذَ, أَنْجَى\nمثال: حفظ رقم هاتفها. / مُسَاعَدَة, مَعُونَة\nمثال: علي مساعدة ماري. / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة. / سَهَّلَ (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "たず": "كُرْكِيّ, غُرْنُوق\nمثال: رفع سامي نظارته.",
 "たずき": "حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "たずさえる": "دُبّ",
 "たずぬ": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا. / طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا.",
 "たずね": "سُؤَال, سؤال (سُؤَال)\nمثال: أجب على السؤال.",
 "たずねる": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا. / طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا. / زَارَ (قَصَدَ شخصًا للأنس أو للحاجة)\nمثال: زار سامي مسجدا.",
 "たせいおんがく": "بوليفونية, تعدد الأصوات (موسيقى مرتبة في أجزاء لعدة أصوات أو أدوات)",
 "たせき": "تبادل اللوم, تقاذف الاتهامات (اتهامات متبادلة بين أشخاص يرفضون قبول المسؤولية الفردية عن حدث غير مرغوب فيه)",
 "たせん": "تَوْصِيَة / ثروة, غنى (وفرة من الممتلكات والموارد المادية) / ثري, غني (شخص يمتلك ثروة مادية كبيرة)",
 "たそうとう": "بَاغُودٰ",
 "たそがる": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "たそがれどき": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء)\nمثال: هل العشاء جاهز؟",
 "たそがれる": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "たそくるい": "كثيرات الأرجل (مصطلح عام لأي مفصلي بري له جسم ممدود يتكون من العديد من الأجزاء المتشابهة: مثل…)",
 "たぞうきふぜん": "مودس (ثقافة فرعية شبابية بدأت في لندن في أوائل الستينيات؛ حركة للطبقة العاملة بملابس…)",
 "たた": "أكثر فأكثر, بشكل متزايد (يتقدم في الكمية أو الكثافة)\nمثال: أصبحت مكتئبة بشكل متزايد",
 "たたいせい": "تعدد الأشكال ((في علم الأحياء) وجود شكلين أو أكثر من الأفراد ضمن نفس النوع الحيواني (بشكل…)",
 "たたえみず": "علاج بالغمر, علاج بالفيضان (تقنية تستخدم في العلاج السلوكي؛ يتم إغراق العميل بتجارب من نوع معين حتى يصبح…)",
 "たたえる": "مِدْحَة, إِثْنَاء / مَلَأَ / عَبَّرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "たたかい": "مَعْرَكَة / عَارَكَ, قَاتَلَ\nمثال: لن يحل القتال أي شيء. / مُسَابَقَة",
 "たたかいのにわ": "سَاحَة حَرْب, سَاحَة مَعْرَكَة",
 "たたかう": "عَارَكَ, قَاتَلَ\nمثال: لن يحل القتال أي شيء. / تَنَافَسَ, تَبَارَى / كِفَاح, نِضَال",
 "たたかわす": "تَنَافَسَ, تَبَارَى / مُنَاظَرَة, مُنَاقَشَة (مصدر من ناظَرَ)",
 "たたき": "لَحْم مَفْرُوم (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم…)\nمثال: أفضل لحم البقر. / صدم, ضرب (فعل ملامسة شيء لآخر)\nمثال: أدى الضرب المتكرر إلى ظهور كدمة كبيرة / خبطة, ضربة قوية (ضربة قوية)\nمثال: الضربة المفاجئة طرحته أرضاً / سَرِقَة, لُصُوصِيَّة",
 "たたきあう": "عَارَكَ, قَاتَلَ\nمثال: لن يحل القتال أي شيء.",
 "たたきあげ": "عِصَامِيّ",
 "たたきおとす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "たたききる": "اِخْتَرَقَ",
 "たたきだい": "قرمة, لوح التقطيع (كتلة خشبية ثابتة يمكن تقطيع الطعام أو تقطيعه إلى مكعبات عليها أو شق الخشب عليها)",
 "たたきだす": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "たたきつける": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "たたきつぶす": "كَسَّرَ / هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "たたきのめす": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "たたきふせる": "صَرَعَ (طَرَحَه على الأرض؛ أَرْدَاهُ قَتِيلاً وأَهْلَكَهُ)",
 "たたきわる": "كَسَّرَ",
 "たたき上げ": "عِصَامِيّ",
 "たたき付ける": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته.",
 "たたき出す": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "たたき割る": "كَسَّرَ",
 "たたき台": "قرمة, لوح التقطيع (كتلة خشبية ثابتة يمكن تقطيع الطعام أو تقطيعه إلى مكعبات عليها أو شق الخشب عليها)",
 "たたく": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال)\nمثال: ضرب سامي زوجته. / حَمْلَة / بَاوْنْد / تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث)\nمثال: أخذت تكلم الكلب.",
 "たたす": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "たたずまい": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب.",
 "たたずみ": "مَعِيشَة, مَعَاش",
 "たたっきる": "اِخْتَرَقَ",
 "たたっ切る": "اِخْتَرَقَ",
 "たたっ斬る": "اِخْتَرَقَ",
 "たたみいす": "كرسي قابل للطي, كرسي منطوي (كرسي يمكن طيه بشكل مسطح للتخزين)",
 "たたみかける": "آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "たたみこみ": "التفاف, تلافيف (عملية اللف أو اللي أو الالتفاف معاً)",
 "たたみこむ": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "たたみじわ": "خنجر الكريس (خنجر ماليزي ذو نصل متموج)\nمثال: يحتوي وجهه على العديد من الخطوط",
 "たたみめ": "طَوَى",
 "たたみ椅子": "كرسي قابل للطي, كرسي منطوي (كرسي يمكن طيه بشكل مسطح للتخزين)",
 "たたみ皴": "خنجر الكريس (خنجر ماليزي ذو نصل متموج)\nمثال: يحتوي وجهه على العديد من الخطوط",
 "たたみ皺": "خنجر الكريس (خنجر ماليزي ذو نصل متموج)\nمثال: يحتوي وجهه على العديد من الخطوط",
 "たたみ込む": "ذَكَرَ, حَفِظَ (ذَكَرَ الشيءَ: نطق به أو أشار إليه بالكلام؛ ذَكَرَ شخصًا: استحضره في الذاكرة)\nمثال: قتله ذكر زرافة.",
 "たたむ": "طَوَى / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا…)\nمثال: أغلق الباب بغضب / أخْلَا\nمثال: لقد ترك لك هذا.",
 "たたり": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان…)\nمثال: اللعنة حولها ومعرفة",
 "たたりがみ": "كائن خارق للطبيعة, كيان روحي (كائن غير مادي يُعتقد أن له قوى تؤثر على مسار الأحداث البشرية)",
 "たたりめ": "بَلَاء, بُؤْس\nمثال: 弱り目に祟り目。 — لا تأتي المصائب فُرَادَى.",
 "たたり目": "بَلَاء, بُؤْس\nمثال: 弱り目に祟り目。 — لا تأتي المصائب فُرَادَى.",
 "たたる": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان…)\nمثال: اللعنة حولها ومعرفة",
 "ただ": "عَادِيّ, مَأْلُوف / مَجَّانِيّ, مَجَّانًا / غَيْر مُتَأَثِّر (لا يخضع لأي تغيير عند التأثير عليه)\nمثال: غير متأثر تماماً بكتابات بعضهم البعض / وَحِيد / مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج)\nمثال: إرسم خط مستقيم.",
 "ただい": "رَائِع, عَظِيم\nمثال: الصين بلد عظيم.",
 "ただいま": "الْآنَ, حَالًا (في هذا الوقت الحالي)\nمثال: نحن بمأمن الآن. / آنِفاً / حَالاً (مباشرةً، فوراً، دون تأخير؛ في هذه الأثناء، في الوضع الحالي)\nمثال: سأكون معك حالا.",
 "ただこと": "كَلَام مُبَاشِر, مُقْتَبَس",
 "ただごと": "كَلَام مُبَاشِر, مُقْتَبَس",
 "たださえ": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي))\nمثال: قد أثلجت كثيرا.",
 "ただし": "لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "ただしい": "يَمِين, يمين\nمثال: أجب على السؤال. / سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته)\nمثال: علاج طبي مناسب",
 "ただしがき": "بند, شرط (شرط منصوص عليه)\nمثال: قبل بشرط واحد",
 "ただしく": "يَمِين, يمين\nمثال: أجب على السؤال.",
 "ただしつき": "شَرْطِيّ (أحد المنتسبين إلى الشُرْطَة)\nمثال: تبدو وكأنك شرطي.",
 "ただしづき": "شَرْطِيّ (أحد المنتسبين إلى الشُرْطَة)\nمثال: تبدو وكأنك شرطي.",
 "ただし書": "بند, شرط (شرط منصوص عليه)\nمثال: قبل بشرط واحد",
 "ただし書き": "بند, شرط (شرط منصوص عليه)\nمثال: قبل بشرط واحد",
 "ただす": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا. / صَحِيح, صَوَاب\nمثال: صحح نطقي من فضلك. / اِسْتَقَامَ (أَقَامَ نفسه) / تَيَقَّنَ, تَثَبَّتَ",
 "ただただ": "مطلقا, على الإطلاق",
 "ただちに": "حَالاً (مباشرةً، فوراً، دون تأخير؛ في هذه الأثناء، في الوضع الحالي)\nمثال: سأكون معك حالا. / مُبَاشَرَةً",
 "ただでさえ": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي))\nمثال: قد أثلجت كثيرا.",
 "ただでは": "مَجَّانًا, بلاش",
 "ただなか": "مُنْتَصَف, وَسَط / فِي مُنْتَصَف, وَسْطَ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "ただならない": "غَيْر مَأْلُوف (لا يُصادف عادة)\nمثال: مشهد ذو جمال غير عادي / غير قابل للمقارنة, لا يضاهى (بحيث تكون المقارنة مستحيلة؛ غير مناسب للمقارنة أو يفتقر للميزات التي يمكن…)\nمثال: أسبوع لا يضاهى من الراحة والمتعة",
 "ただならぬ": "غَيْر مَأْلُوف (لا يُصادف عادة)\nمثال: مشهد ذو جمال غير عادي",
 "ただに": "بِالْكَاد",
 "ただのいちども": "يَوْمًا",
 "ただのひと": "فلان الفلاني, مواطن مجهول (رجل عادي افتراضي (يُستخدم للإشارة إلى شخص غير محدد))",
 "ただの一度も": "يَوْمًا",
 "ただの人": "فلان الفلاني, مواطن مجهول (رجل عادي افتراضي (يُستخدم للإشارة إلى شخص غير محدد))",
 "ただひとつ": "وَحِيد\nمثال: سمكة ميناد ماتت",
 "ただよう": "نفق أفقي (ممر أفقي (أو شبه أفقي) في منجم)\nمثال: حفروا نفقاً أفقياً موازياً للعرق المعدني / راية طويلة (علم طويل؛ غالباً ما يكون مستدق الطرف) / تَجَوَّلَ / تردد, تلكؤ (فعل التوقف بشكل غير مؤكد)\nمثال: كان هناك تردد في كلامه",
 "ただれ": "مُوجِع, مُؤْلِم",
 "ただれる": "تَقَيَّحَ",
 "ただん": "متعدد المراحل (يحدث في أكثر من مرحلة واحدة)",
 "ただんかい": "متعدد المراحل (يحدث في أكثر من مرحلة واحدة)",
 "ただんしきロケット": "صاروخ متعدد المراحل (صاروخ يحتوي على محركين صاروخيين أو أكثر (لكل منهما وقوده الخاص) يتم إشعالها…)",
 "ただ一つ": "وَحِيد\nمثال: سمكة ميناد ماتت",
