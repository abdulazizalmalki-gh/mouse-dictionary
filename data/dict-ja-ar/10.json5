 "だいげんにん": "مُحَامٍ, مُحَامِيَة",
 "だいこ": "فِجْل (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل…) / ممثل مبالغ, ممثل متصنع (ممثل غير ماهر يبالغ في الأداء التمثيلي)",
 "だいこう": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "だいこうきかん": "فَاعِلِيَّة\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "だいこうぎょう": "فَاعِلِيَّة\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "だいこうしゃ": "فَاعِل (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل.",
 "だいこうずい": "طُوفَان (عاصفة)",
 "だいこうとうこう": "الثقبة العظمى (الفتحة الكبيرة في قاعدة الجمجمة التي يمر من خلالها الحبل الشوكي)",
 "だいこくばしら": "الحبل الرئيسي للسارية (الحبل الأمامي الذي يثبت الصاري الرئيسي)\nمثال: الإيمان هو ركيزته",
 "だいこん": "فِجْل (فَجَّلَ الشيءَ تعني عرَّضَهُ، أي جعله مكشوفًا أو ظاهرًا. يمكن استخدام الفعل…) / ممثل مبالغ, ممثل متصنع (ممثل غير ماهر يبالغ في الأداء التمثيلي)",
 "だいこんやくしゃ": "ممثل مبالغ, ممثل متصنع (ممثل غير ماهر يبالغ في الأداء التمثيلي)",
 "だいこんらん": "فَوْضَى",
 "だいご": "خَامِس, خَامِسَة\nمثال: رأيت خمسة رجال. / تَنْوِير / سَمْن حَيَوَانِيّ (الدُهُون التي تؤكل، وتشمل الزُبْد والقِشْطَة وما يستخرج من الحَيْوَان والنبات…)",
 "だいごう": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "だいごし": "خنصر القدم (الإصبع الخامس الأصغر والأكثر تطرفاً في القدم)",
 "だいごみ": "حقيقة, صحة (المطابقة للواقع أو الفعليّة)\nمثال: ناقشوا صحة الاقتراح",
 "だいごれつ": "الطَّابُورُ الخَامِس",
 "だいご味": "حقيقة, صحة (المطابقة للواقع أو الفعليّة)\nمثال: ناقشوا صحة الاقتراح",
 "だいさ": "عَقِيد, زَعِيم",
 "だいさいし": "حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى)\nمثال: إنه الكاهن الأعظم لموسيقى الجاز المعاصرة",
 "だいさいなん": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق)",
 "だいさくせん": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق)",
 "だいさん": "ثَالِث, ثَالِثَة\nمثال: الساعة العاشرة والثلث.",
 "だいさんかいきゅう": "الطبقة الثالثة, عامة الشعب (عامة الناس)",
 "だいさんさいむしゃ": "محجوز لديه (كاسب أجر يتم إبلاغه بأمر حجز على الراتب)",
 "だいさんしゃ": "حزب ثالث (حزب سياسي منظم في معارضة للأحزاب الرئيسية في نظام الحزبين)",
 "だいさんしゃのためにするけいやく": "حزب ثالث (حزب سياسي منظم في معارضة للأحزاب الرئيسية في نظام الحزبين)",
 "だいさんしゅゆうびんぶつ": "بريد الدرجة الثالثة (بريد يتكون من مواد مطبوعة مؤهلة لأسعار بريدية مخفضة)",
 "だいさんじ": "ثَالِث, ثَالِثَة\nمثال: الساعة العاشرة والثلث. / كَارِثَة, فَاجِعَة",
 "だいさんじせかいたいせん": "اَلْحَرْبُ اَلْعَالَمِيَّةُ اَلثَّالِثَة",
 "だいさんせいとう": "حزب ثالث (حزب سياسي منظم في معارضة للأحزاب الرئيسية في نظام الحزبين)",
 "だいさんせかい": "الْعَالَم الثَّالِث",
 "だいさんそうしけん": "المرحلة الثالثة من التجارب السريرية (تجربة سريرية كبيرة لعلاج أو دواء ثبتت فعاليته في المرحلتين الأولى والثانية)",
 "だいさんていこく": "الرَّايْخ الثَّالِث",
 "だいさんどねっしょう": "استجواب قسري, الدرجة الثالثة (استجواب يصاحبه غالبًا تعذيب لانتزاع معلومات أو اعتراف)",
 "だいさんにんしょう": "غَائِب",
 "だいさんのうしつ": "بطين ثالث (بطين ضيق في المستوى المتوسط أسفل الجسم الثفني؛ يتصل بالبطين الرابع عبر قناة…)",
 "だいさんセクター": "شَرِكَة مُحَاصَّة",
 "だいざ": "عَمُود, حامِل",
 "だいざい": "فَاعِل, مُبْتَدَأ (الشيء :فعله)\nمثال: تظن الشرطة أن سامي يعلم من الفاعل. / خطيئة مميتة, كبيرة من الكبائر (خطيئة لا تغتفر تستوجب فقدان النعمة الإلهية تماماً)\nمثال: يدرج اللاهوتيون سبع خطايا مميتة",
 "だいし": "حَصِيرَة / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / تَعْلِيق, مَلْحُوظَة / تعبير اصطلاحي, مصطلح (تعبير لا يمكن استنتاج معانيه من معاني الكلمات التي يتكون منها) / أخت (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على…)\nمثال: ماري هي أخت توم / ابن بالمعمودية, ابنة بالمعمودية (رضيع يكفله شخص بالغ (العراب) عند المعمودية)",
 "だいしあい": "طرائد كبيرة (حيوانات كبيرة يتم اصطيادها للرياضة)",
 "だいしきゅう": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "だいしきょう": "أَرْشِي اِبِسْقُوبُس",
 "だいしきょうく": "أبرشية رئيسية (أبرشية رئيس الأساقفة)",
 "だいしぜん": "طَبِيعَة, طبيعة",
 "だいしっこう": "إحلال الدائن, حلول دائن ((قانون) عملية استبدال دائن بآخر)",
 "だいしっぱい": "فَشَل ذَرِيْع, كارِثة (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة…)\nمثال: فشل ياني مجددا.",
 "だいしはん": "سَيِّد\nمثال: يبدو زيري أحسن.",
 "だいしほん": "كبير رأس المال (لأسهم الشركات التي تبلغ قيمتها السوقية خمسة مليارات دولار أو أكثر)",
 "だいしゃ": "عربة نقل يدوية (عربة يدوية لها إطار بعجلتين منخفضتين وحافة في الأسفل ومقابض في الأعلى؛ تستخدم…) / شَاحِنَة, كَمْيُون (اسم فاعل مؤنث من الفعل \"شَحَنَ\"؛ أي عربة أو سيارة تُستخدم للشحن أو النقل)\nمثال: انقلبت الشاحنة.",
 "だいしゃりん": "شَامِل, كَامِلُ النِّطَاق (يستخدم جميع الموارد المتاحة)",
 "だいしゅうどういん": "دَيْر (بيت يسكنه الرُهْبَان أو الرَاهِبَات ممن كان على دين المسيحية)\nمثال: سيداتي و سادتي ، رجاء قفوا للنشيد الوطني للاتحاد الروسي باداء جوقة دير سرتينسكي .",
 "だいしゅうどういんちょう": "رَئِيس الدَّيْر, أَبَاتِي",
 "だいしゅきょう": "أَرْشِي اِبِسْقُوبُس",
 "だいしゅじゅつ": "جراحة كبرى (أي إجراء جراحي يتضمن التخدير أو المساعدة التنفسية)",
 "だいしょ": "كاتب اختزال (شخص ماهر في نسخ الكلام (خاصة الإملاء))",
 "だいしょう": "تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / ثَمَن, سِعْر (ثمَّنَ السِّلْعَةَ: قدّر ثَمنَها؛ ثمَّنَ الشيءَ: جعل له ثمانية أركان)\nمثال: دفع زيري الثمن. / عميد / مَقَاس, قِيَاس / عَامّ / رَئِيس, رَئِيسَة / صَدِيق (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / بُوذَا, بُدّ",
 "だいしょうがたセクハラ": "واحدة بواحدة",
 "だいしょうぐん": "رَئِيس أَرْكَان",
 "だいしょにん": "نَاسِخ\nمثال: لست بذاك الكاتب.",
 "だいしょや": "كاتب عدل, موثق (شخص مخول قانونياً ليشهد على التوقيعات ويصدق على صحة الوثائق ويأخذ الإفادات)",
 "だいしん": "بَدِيل مُؤَقَّت (شخص (طبيب أو رجل دين) ينوب مؤقتاً عن عضو آخر في نفس المهنة) / عراب المعمودية (شخص يكفل شخصاً (الطفل الروحي) عند المعمودية)",
 "だいしんいん": "مَحْكَمَة عُلْيَا (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة.",
 "だいしんていこく": "تشينغ, سلالة تشينغ (آخر سلالة إمبراطورية للصين (من 1644 إلى 1912) والتي أطاح بها الثوار؛ خلال سلالة…)",
 "だいしんゆう": "أَفْضَل صَدِيق, فُضْلَى صَدِيقَة",
 "だいじ": "مُهِمّ / قَيِّم, ثَمِين (صيغة مبالغة من الفعل قَامَ، أي الكثير القيام؛ القَيِّم على الأمر مُتَوَلِّيه…)\nمثال: إعطي قيمة لذاتك. / أَزْمَة, بُحْرَان / أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين. / نقش أثري (نقش محفور) / كلام, كلمات (اللغة التي يتم التحدث بها أو كتابتها)\nمثال: لديه موهبة في الكلام",
 "だいじぎょう": "الشركات الكبرى, مؤسسات تجارية كبرى (مؤسسات تجارية منظمة وممولة على نطاق واسع بما يكفي للتأثير على السياسات…)\nمثال: أصبحت الشركات الكبرى قوية جداً لدرجة يصعب معها تنظيمها بشكل فعال",
 "だいじだい": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "だいじてん": "قاموس شامل, قاموس غير موجز (قاموس لم يتم تقصيره بحذف المصطلحات أو التعريفات؛ قاموس شامل)",
 "だいじない": "بشكل حسن, على ما يرام (بطريقة مرضية أو كافية)\nمثال: ستبلي حسناً بمفردها",
 "だいじなところ": "أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)",
 "だいじにする": "كَنْز",
 "だいじゃ": "ثُعْبَان",
 "だいじゅう": "عَاشِر\nمثال: لدي عشرة أقلام.",
 "だいじゅんかん": "دَوْرَة دَمَوِيَّة كُبْرَى (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه…)\nمثال: خضع زيد لدورة مكثفة",
 "だいじょ": "يام أبيض, يام الماء (يزرع في أسترالاسيا وبولينيزيا لجذره الكبير ذو اللحم الأبيض الناعم الصالح للأكل) / بَالِغ / برولوج, فاتحة مسرحية (مقدمة لمسرحية)",
 "だいじょう": "بوذية الماهايانا, ماهايانا (واحدة من مدرستين عظيمتين للعقيدة البوذية تؤكدان على البحث المشترك عن الخلاص…)",
 "だいじょうかん": "وزارة الخارجية, وزارة الخارجية الأمريكية (الإدارة الفيدرالية في الولايات المتحدة التي تضع وتحافظ على السياسات الخارجية)\nمثال: تأسست وزارة الخارجية عام 1789",
 "だいじょうてき": "رَحْب الصَّدْر, مُتَسَامِح (يُظْهِر أَوْ يَتَّسِم بِسَعَة الأُفُق والتَّسَامُح)",
 "だいじょうぶ": "أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين. / بِالتَّأْكِيد",
 "だいじょうぶっきょう": "بوذية الماهايانا, ماهايانا (واحدة من مدرستين عظيمتين للعقيدة البوذية تؤكدان على البحث المشترك عن الخلاص…)",
 "だいじょうみゃく": "وريد أجوف (أي من وريدين كبيرين يعيدان الدم المستنفد للأكسجين إلى الأذين الأيمن للقلب)",
 "だいじょぶ": "أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين. / بِالتَّأْكِيد",
 "だいじょーぶ": "أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين. / بِالتَّأْكِيد",
 "だいじん": "منصب وزاري, وزير في الحكومة (وظيفة وزير كبير يكون عضواً في مجلس الوزراء) / ثري, غني (شخص يمتلك ثروة مادية كبيرة) / باذخ, منفق كبير (شخص ينفق ببذخ وتفاخر على الترفيه)\nمثال: آخر المنفقين الكبار / رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب.",
 "だいじんあそび": "مصروف الجيب (نقد للإنفاق اليومي على المصاريف العرضية)",
 "だいすう": "عِلْم الْجَبْر, جَبْر (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "だいすうがく": "عِلْم الْجَبْر, جَبْر (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "だいすうてき": "جبري (متعلق بالجبر)\nمثال: الهندسة الجبرية",
 "だいすうてきすう": "عَدَد جَبْرِيّ (جذر لمعادلة جبرية ذات معاملات نسبية)",
 "だいすき": "مُحِبّ, وَدُود",
 "だいすきになる": "وَقَعَ فِي حُبّ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "だいず": "صويا, فول الصويا (أكثر الخضراوات المعروفة احتواءً على البروتين؛ تستخدم ثمرة نبات الصويا في مجموعة…) / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "だいずあぶら": "زيت فول الصويا (زيت مستخرج من فول الصويا)",
 "だいずこ": "دقيق الصويا (دقيق مصنوع من فول الصويا)",
 "だいずゆ": "زيت فول الصويا (زيت مستخرج من فول الصويا)",
 "だいせいきょう": "مَشْغُول",
