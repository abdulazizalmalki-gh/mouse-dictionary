 "もったり": "بِبُطْء",
 "もって": "مَعَ (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع) / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)\nمثال: جئت مع أصدقائي. / بِسَبَب, بِحُكْم / عَلَى (يفيد الاستعلاء؛ يفيد التعليل) / فِي (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / عَلَى حِسَابِهِ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / إِضَافَةً عَلى ذٰلِكَ",
 "もっていく": "دُبّ / دُبَّة / اِحْتَمَلَ",
 "もってうまれた": "طَبِيعِيّ",
 "もってくる": "أَحْضَرَ, جَاءَ بِـ (أَتَى بالشيء، جَاءَ به)\nمثال: أحضر سامي كلبه.",
 "もってこい": "مِثَالِيّ",
 "もってゆく": "دُبّ / دُبَّة / اِحْتَمَلَ",
 "もっと": "أَكْثَر",
 "もっとも": "أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "もっともらしい": "جِدِّيّ / جَدِّيّ, جَادّ",
 "もっぱら": "غَالِبًا",
 "もっぺん": "مَرَّة أُخْرَى, ثَانِيَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "もつ": "مَسَكَ, مسك / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه. / حَافَظَ / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / آخر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / اِسْتَمَرَّ, دَامَ\nمثال: أرني مثالا آخر.",
 "もつやく": "مُرّ (فَاتَ ومَضَى؛ الحدثُ أو الأمرُ: حدث وانتهى)\nمثال: مر زيري بجانبي.",
 "もつれ": "تَعْقِيد / مُضَاعَفَة",
 "もて": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / طفا إلى السطح\nمثال: هناك ثقوب على السطح. / قِناع, كِمامة (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "もてあそびもの": "لُعْبَة, دُمْيَة (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "もてあそび物": "لُعْبَة, دُمْيَة (اللَعْبَة البَرْبَرية دواء عشبيّ)\nمثال: عنده لعبة يويو.",
 "もてあそぶ": "قَدَّرَ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / عَلِمَ (أَدْرَكَ حقيقة الشيء) / رَفَعَ قِيمَة, زَادَ فِي قِيمَة (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: خذ قدر ما تريد.",
 "もてなし": "كَرَم, إِكْرَام / ضِيَافَة / عَالَجَ",
 "もてなす": "عَالَجَ",
 "もてもて": "جَذَّاب, جِنْسِيّ",
 "もてる": "تَحَمَّلَ, صَبَرَ / اِسْتَمَرَّ / مجنون, مَلْبُوس / غَنِيّ",
 "もてるもの": "مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه.",
 "もと": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل / قَاعِدَة, أَسَاس / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية. / مَادِّيّ / مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "もとい": "قَاعِدَة, أَسَاس",
 "もといれきん": "رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "もとうし": "عِجْل (أسرع في إنجاز شيء أو القيام به؛ قدم شيئًا قبل وقته المعتاد) / دَغْفَل, حُوَار / بَطَّة, رَبْلَةُ (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق) / بَطْن اَلسَّاق (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: أنا في عجلة من أمري.",
 "もとかた": "تَاجِر جُمْلَة / مُسْتَثْمِر, مُسْتَثْمِرَة",
 "もとから": "أَصْلًا",
 "もときん": "رَئِيسِيّ / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء) / مُوَكِّل\nمثال: زيري هو المدير. / رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "もとじめ": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير. / رَئِيس, رَئِيسَة",
 "もとせん": "مِحْبَس",
 "もとだか": "رَئِيسِيّ / مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء) / مُوَكِّل\nمثال: زيري هو المدير.",
 "もとだち": "مِذْيَاع, رَادِيُو / سَمَّاعَة",
 "もとづく": "جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء",
 "もとで": "رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "もとにもどす": "اِسْتَعَادَ",
 "もとに戻す": "اِسْتَعَادَ",
 "もとね": "سَاوَى, كَلَّفَ / تَكْلِفَة, كُلْفَة",
 "もとねた": "أَصْلِيّ",
 "もとのさやにおさまる": "دَفَنَ الأَحْقَادَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "もとは": "أَصْلًا",
 "もとむ": "أَرَادَ, رَغِبَ (شَاءَ الشيءَ، رَغِبَ فيه؛ أَحَبَّ، شَهِيَ، اِشْتَهَى. (تخصيص))\nمثال: أراد مني الكذب. / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / بَحَثَ, طَلَبَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث. / شِرَاء, اِشْتِرَاء / مُشْتَرًى, مُشْتَرَيَات / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك.",
 "もとむる": "أَرَادَ, رَغِبَ (شَاءَ الشيءَ، رَغِبَ فيه؛ أَحَبَّ، شَهِيَ، اِشْتَهَى. (تخصيص))\nمثال: أراد مني الكذب.",
 "もとめ": "طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / شِرَاء, اِشْتِرَاء / مُشْتَرًى, مُشْتَرَيَات / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك.",
 "もとめる": "أَرَادَ, رَغِبَ (شَاءَ الشيءَ، رَغِبَ فيه؛ أَحَبَّ، شَهِيَ، اِشْتَهَى. (تخصيص))\nمثال: أراد مني الكذب. / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا. / بَحَثَ, طَلَبَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث. / شِرَاء, اِشْتِرَاء / مُشْتَرًى, مُشْتَرَيَات / اِشْتَرَى (أَخَذَ الشيءَ بِثَمَن؛ اشترى الشخصَ (الحرّ) أو رضاه: أراد إرضائه ومحبته بغض النظر عن الكلفة)\nمثال: اشترى زيري ذلك.",
 "もとも": "أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "もともと": "أَصْلًا / مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس.",
 "もとより": "أَصْلًا / طَبْعًا",
 "もとネタ": "أَصْلِيّ",
 "もどかしい": "فَشَّلَ (فَشَلَ الطالبُ في الامتحان: لم ينجح في الاختبار ولم يحقق النتيجة المطلوبة؛ فَشَلَ الشيءُ: انهار أو انكسر أو توقف عن العمل)\nمثال: فشل ياني مجددا.",
 "もどき": "كَـ / تَقْلِيد / نَقْد, اِنْتِقَاد",
 "もどく": "لَامَ, اِسْتَنْكَرَ (لامَ يَلوم ، لُمْ ، لَوْمًا ، فهو لائم والجمع : لُوَّمٌ ، ولُيَّمٌ وهو أَيضاً لَوَّامٌ ، ولَوَّامةٌ ، ولْوَمةٌ وذاك مَلُومٌ ، ومَلِيمٌ…)\nمثال: لام سامي معلمه على فشله هو. / قَلَّدَ",
 "もどし": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "もどす": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع. / تَقَيَّأَ, قَاءَ / تَقَيُّؤ / شُفِيَ, بَرِئَ",
 "もどってくる": "عَادَ, رَجَعَ (رَجَعَ)\nمثال: هل عاد توم حقا؟",
 "もどって来る": "عَادَ, رَجَعَ (رَجَعَ)\nمثال: هل عاد توم حقا؟",
 "もどり": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "もどる": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع. / شُفِيَ, بَرِئَ",
 "もどろ": "بُقْعَة",
 "もなかのつき": "بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ بالغُرُوب طُلُوع الشَّمْسِ…؛ البَدْرُ الغلامُ المكتمل أو الممتلئ)",
 "もにょる": "تَرَدَّدَ (الذهاب إلى المكان مرة أخرى إلى نفس المكان بصورة متكررة؛ عدم الاستقرار على رأي معين)\nمثال: قبل ماثيو بتردد.",
 "もぬけのから": "خَالِيّ / خَاوِي, فَارِغ / جُثَّة, جُثْمَان",
 "もぬけのカラ": "خَالِيّ / خَاوِي, فَارِغ / جُثَّة, جُثْمَان",
 "もぬけの殻": "خَالِيّ / خَاوِي, فَارِغ / جُثَّة, جُثْمَان",
 "もの": "أُقْنُوم / فَرْد",
 "ものあんじ": "قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "ものいい": "اِعْتَرَاض / اِعْتِرَاض / إِشَاعَة, شَائِعَة",
 "ものいう": "تَكَلَّمَ, تَحَدَّثَ (نُطْق؛ تَحَدُّث) / مُحَاضَرَة / خِطَاب / مُحَادَثَات, مُفَاوَضَات\nمثال: أخذت تكلم الكلب.",
 "ものいえばくちびるさむしあきのかぜ": "اَلسُّكُوتُ مِن ذَهَبٍ",
 "ものいり": "صَرْف, مَصْرُوف (بمعنى أبْعَدَ عن القَصْد أو الغَايَة أو محل الاهتمام؛ بمعنى اَنْفَقَ المَال وبمعنى الرَدّ والمَنْع)\nمثال: أيمكنك صرف خمسين؟ / غَالٍ, الْغَالِي",
 "ものいれ": "حَاوِيَة (وعاء ضخم جدًا من المعدن يستخدم في المستودعات والموانيء كمخازن للبضاعة. انظر الصورة؛ أي وعاء كبير يمكن أن تحتوي الكثير)\nمثال: أسقط توم الحاوية من الرافعة دون قصد.",
 "ものうい": "سَوْدَاوِيَّة",
 "ものうげ": "كَئِيب, مُوحِش",
 "ものうり": "جَوَّال, بَائِع مُتَجَوِّل (صيغة مبالغة على وزن فَعَّال من الفعل جَالَ؛ كثير التجوّل، دائم التنقُّل من مكان لآخر)\nمثال: اشتريت جوال مستعمل.",
 "ものおしみ": "بُخْل (بَخِلَ :ضَنَّ بما عنده،أمسك ومنع؛ البُخْل:ضِدُّ الْكَرَم والْجُود)",
 "ものおじ": "تَوَتُّر",
 "ものおそろしい": "مُخيف, مُخيفة",
 "ものおと": "ضَوْضَاء, ضَجِيج",
 "ものおぼえ": "ذَاكِرَة, حَافِظَة / ذِكْرَى / ذَاكِرَة",
 "ものおもい": "قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق, اِضْطِرَاب الْقَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "ものおもう": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "ものおもわしい": "مُفَكِّر, مُتَأَمِّل (اسم فاعل للفعل فَكَّرَ؛ اصطلاحا: هو شَخْص له عِلْم وفِكْر ودراية يعتد بها وقادر على التَنْظِير والتَحْلِيل، غالبا ما يؤخذ رأيه في أمور العامة وغالبا ما يؤلف كتبا)\nمثال: \"مفكرة الموت\" هو واحد من أفضل عشرة مسلسلات تلفزيونية عندي.",
 "ものか": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "ものかき": "كَاتِب, كَاتِبَة (كَتَبَ رِسَالَة أو مَكْتُوْب لأحد وهذا الآخر يكتب له؛ راسل؛ كَتَبَ عقدا مع أحد؛ عاقد)\nمثال: لست بذاك الكاتب.",
 "ものかげ": "غِطَاء / غِلَاف / غَطَّى",
 "ものかは": "رَغْمَ, بِالرَّغْمِ مِن ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: إنه سعيد رغم فقره.",
 "ものがたい": "نَزِيه, صَادِق",
 "ものがたり": "قِصَّة, حِكَايَة",
 "ものがたる": "أَخْبَرَ, قَالَ (أَنْبَأَ، أَعْلَمَ) / تَلّ (في الْمُرتَفَعِ مِنَ الأرْضِ قَليلا، وهو دون الجَبَل؛ رَابِيَة)\nمثال: أخبر سامي أباه. / ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه.",
 "ものがなしい": "حَزِين, زعلان / مُحْزِنٌ",
 "ものぐさ": "كَسَل",
 "ものぐるい": "جُنُون",
 "ものごい": "سَائِل / فَقِير",
 "ものごし": "أُسْلُوب, طَرِيقَة (الطَرِيْق والفنّ من القول؛ الطريقة بصورة عامة سواء كانت من القول أو الفعل أو الفكر)\nمثال: هو يحب أسلوب معطوب.",
 "ものごっつ": "جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "ものごと": "شَيْء, حاجة (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما.",
 "ものさし": "مِسْطَرَة (أداة تستخدم لقياس الأطوال أو رسم الخطوط المستقيمة؛ خط مستقيم تحدده مِسطَرة أو بُعد محدد) / حَاكِم (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر)\nمثال: استعارت المسطرة. / مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "ものさびしい": "وَحِيد, مُوحِش",
 "ものさわがしい": "صَارِخ, صاخِب",
 "ものしずか": "صَامِت, هَادِئ",
 "ものしらず": "غَبَاء, غَبَاوَة (بمعنى أن يخفى الأمر، يقال أيضا غَبَاءَة وغَبَاوَة والغباء أعمّ؛ بمعنى ضد الفِطْنة والذَكاء، يقال أيضا غَبَاوة)\nمثال: ما تقترحه غباء.",
 "ものじたい": "شَيْء فِي ذَاتِهِ (الموجود عرضاً كان أو جوهراً، ويصح أن يتصور ويخبر عنه؛ مَا أُخْبِرَ عَنْهُ: سواء كان ما له وجود ماديّ أو معنوي، أو كان صفة أو فكرَة أو أمرًا)\nمثال: في يدها شيء ما.",
 "ものすごい": "تَرَنُّح / تَرَنَّحَ / فَظِيع / مُرْعِب / فَظِيع, أَرْبَد",
 "ものすっごい": "تَرَنُّح / تَرَنَّحَ / فَظِيع / مُرْعِب / فَظِيع, أَرْبَد",
 "ものする": "أَلَّفَ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك.",
 "ものすんごい": "تَرَنُّح / تَرَنَّحَ / فَظِيع / مُرْعِب / فَظِيع, أَرْبَد",
 "ものずき": "فُضُول",
 "ものだから": "لِأَنَّ / هكذا, بلا سبب",
 "ものだね": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل"
}
