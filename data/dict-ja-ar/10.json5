 "ちゅうしんぐら": "سَبْعَة وَأَرْبَعُون",
 "ちゅうしんしがいち": "مركز المدينة, وسط المدينة (الجزء المركزي من المدينة)",
 "ちゅうしんしょうたい": "مريكز (إحدى زوج من عضيات خلوية أسطوانية صغيرة قرب النواة في الخلايا الحيوانية؛ تتكون من تسعة نبيبات دقيقة ثلاثية وتشكل الأشعة النجمية أثناء الانقسام الفتيلي)",
 "ちゅうしんじんぶつ": "قَائِد, زَعِيم",
 "ちゅうしんせん": "خط المركز, محور (خط ينصف شكلاً مستوياً)",
 "ちゅうしんたい": "جسيم مركزي (منطقة صغيرة من السيتوبلازم مجاورة للنواة؛ تحتوي على المريكزات وتعمل على تنظيم الأنابيب الدقيقة)",
 "ちゅうしんち": "مَرْكَز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "ちゅうしんちゅう": "لَوْحَة تِذْكَارِيَّة",
 "ちゅうしんてき": "مَرْكَزِيّ",
 "ちゅうしんてん": "مَرْكَز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟",
 "ちゅうしんとし": "مركز المدينة, وسط المدينة (الجزء المركزي من المدينة)",
 "ちゅうしんぶ": "قَلْب, فُؤَاد / قَلْب / كُبَّا",
 "ちゅうじ": "أذن وسطى, تجويف طبلي (التجويف الرئيسي للأذن؛ بين طبلة الأذن والأذن الداخلية)",
 "ちゅうじえん": "اِلْتِهَاب الأُذُن الوُسْطَى",
 "ちゅうじき": "غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: إنه وقت الغداء.",
 "ちゅうじく": "مِحْوَر",
 "ちゅうじつ": "وَفِيّ, مُخْلِص / أَمِين (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "ちゅうじつど": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…) / وَلَاء",
 "ちゅうじてん": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "ちゅうじゅん": "اِنْتِمَاء",
 "ちゅうじょう": "فريق (الطَائِفَة من الشيء المتفرق؛ الطَائِفَة من الناس، وهي أكثر من الفِرْقَة)\nمثال: لدينا فريق جيد. / طَاقَم, طَاقِم",
 "ちゅうじん": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف) / مِن الطَّبَقَة المُتَوَسِّطَة (يحتل مكانة اجتماعية واقتصادية متوسطة بين الطبقات الدنيا والأثرياء) / طَاهٍ, طَاهِي",
 "ちゅうすい": "مُلْحَق / علاج بالغمر, علاج بالفيضان (تقنية تستخدم في العلاج السلوكي؛ يتم إغراق العميل بتجارب من نوع معين حتى يصبح كارهاً لها أو مخدراً تجاهها)",
 "ちゅうすいえん": "الْتِهابُ الزَّائِدَةِ الدُّودِيَّة",
 "ちゅうすいせつじょじゅつ": "اِسْتِئْصَال الزَائِدَة الدُودِيَّة",
 "ちゅうすう": "عَنَى, قَصَدَ / لَئِيم, خَسِيس / مُتَوَسِّط / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / سنتر, لاعب وسط (مركز في فريق كرة السلة للاعب الذي يشارك في قفزة البداية التي تبدأ المباراة) / سنتر, لاعب وسط ((كرة قدم أمريكية) مركز اللاعب على خط الاشتباك الذي يضع الكرة في اللعب) / سنتر, لاعب وسط (مركز في فريق الهوكي للاعب الذي يشارك في مواجهة البداية عند بداية المباراة)\nمثال: مسؤولية السنتر هي إيصال الكرة إلى الكوارترباك / الجهاز العصبي المركزي (جزء الجهاز العصبي الفقاري المكون من الدماغ والحبل الشوكي)",
 "ちゅうすうしんけいけい": "الجهاز العصبي المركزي (جزء الجهاز العصبي الفقاري المكون من الدماغ والحبل الشوكي)",
 "ちゅうすうしんけいけいとう": "الجهاز العصبي المركزي (جزء الجهاز العصبي الفقاري المكون من الدماغ والحبل الشوكي)",
 "ちゅうすうせい": "مَرْكَزِيّ",
 "ちゅうせい": "الْعُصُور الْوُسْطَى, الْقُرُون الْوُسْطَى / حِيَاد / لا جنسية (عدم وجود جنس واضح أو أعضاء جنسية) / نَزَاهَة, حِيَاد / وَفَاء, إِخْلَاص",
 "ちゅうせいし": "نْيُوتْرُون, نُوتْرُون",
 "ちゅうせいしせい": "نَجْم نْيُوتْرُونِيّ (طَلَعَ وظَهَرَ؛ نَجَمَ عن الأمر: أي ظهر نَتِيجَة عنه أو نَتَجَ عنه)\nمثال: سميت السفينة \"النجم الفضي\".",
 "ちゅうせいしそく": "فَيْض نِيُوتْرُونِيّ (معدل تدفق النيوترونات؛ عدد النيوترونات المارة عبر وحدة المساحة في وحدة الزمن)",
 "ちゅうせいしばくだん": "قُنْبُلَة نْيُوتْرُونِيَّة",
 "ちゅうせいしぼう": "تريغليسريد, دهن ثلاثي (غليسريد يوجد طبيعياً في الأنسجة الحيوانية والنباتية؛ يتكون من ثلاثة أحماض دهنية فردية مرتبطة معاً في جزيء واحد كبير؛ وهو مصدر مهم للطاقة يشكل معظم…)",
 "ちゅうせいしん": "وَفَاء, إِخْلَاص",
 "ちゅうせいてき": "خناثي, خنثوي (لديه خصائص الذكور والإناث معاً) / خنثوي (يتعلق بـ أو يظهر أعضاء جنسية ذكرية وأنثوية معاً ولكن بمظهر أنثوي غالب)",
 "ちゅうせいびし": "نْيُتْرِينُو",
 "ちゅうせいをつくす": "عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "ちゅうせいラテンご": "لاتينية العصور الوسطى (اللاتينية المستخدمة للأغراض الدينية خلال العصور الوسطى)",
 "ちゅうせき": "رسوبي, طمي (من أو يتعلق بالطمي (الترسبات النهرية)) / عمود",
 "ちゅうせきそう": "طَمْي, إِبْلِيز",
 "ちゅうせきど": "تربة طميية (تربة خصبة ناعمة الحبيبات ترسبها المياه المتدفقة فوق سهول الفيضانات أو في قيعان الأنهار)",
 "ちゅうせきへいや": "سهل طمي (أرض منبسطة ناتجة عن رواسب متكررة من المواد الطميية بواسطة المياه الجارية)",
 "ちゅうせっきじだい": "حجري متوسط, ميزوليثي (من أو متعلق بفترة متوسطة من العصر الحجري (تلي العصر الحجري القديم))",
 "ちゅうせつ": "وَفَاء, إِخْلَاص",
 "ちゅうせん": "يَانَصِيب / وَسِيط",
 "ちゅうせんかい": "يَانَصِيب",
 "ちゅうぜつ": "خِدَاج, إِجْهَاض / إيقاف, انقطاع (فعل الإيقاف أو القطع؛ انقطاع (مؤقت أو دائم))",
 "ちゅうぜつせいこう": "الجماع المقطوع, العزل (طريقة لتحديد النسل يتم فيها بدء الجماع ولكن يتم سحب القضيب عمداً قبل القذف)",
 "ちゅうぜつやく": "حبوب الإجهاض, ميفيبريستون",
 "ちゅうそ": "تَعْلِيق / قاعدة (دعامة أو قاعدة معمارية (كما لعمود أو تمثال))",
 "ちゅうそう": "مُتَوَسِّطُ الْحَجْمِ (متوسط في الحجم) / مِدَكّ",
 "ちゅうそくこつ": "مُشْط اَلْقَدَم (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "ちゅうそっこつ": "مُشْط اَلْقَدَم (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "ちゅうぞう": "اختيار الممثلين, توزيع الأدوار (اختيار الممثلين للعب أدوار معينة في مسرحية أو فيلم) / رمي الصنارة (فعل رمي خيط الصيد فوق الماء بواسطة صنارة وبكرة) / سبك, صب (فعل إنشاء شيء ما عن طريق صبه في قالب) / قالب, مصبوب (شيء تم تشكيله بواسطة قالب)",
 "ちゅうぞうしょ": "مسبك, معمل صهر (مصنع يتم فيه إنتاج المسبوكات المعدنية)",
 "ちゅうたい": "سَرِيَّة / شَرِكَة / تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل. / وَتَر (خيط شديد أو سلك يربط بين طرفي القوس ليستخدم في إطلاق السهام. سمي كذلك لأنه واحد، مشتق من الوِتْر وهو الفرد؛ خيط شديد أو سلك يربط على الآلة الموسيقية لإطلاق الصوت. سمي كذلك تشبيها له بوَتَر القَوْس) / أُسْطُوَانَة",
 "ちゅうだい": "مِصْمَال",
 "ちゅうだいのうどうみゃく": "شريان مخي أوسط (أحد فرعي الشريان السباتي الباطن؛ ينقسم إلى ثلاثة فروع)",
 "ちゅうだん": "مُقَاطَعَة / هُبُوط / بَسْطَة / خط الوسط, وسط الملعب ((رياضة) الجزء الأوسط من ملعب اللعب (كما في كرة القدم))",
 "ちゅうち": "حشو, داخلة (زائدة يتم إدخالها داخل الكلمة)",
 "ちゅうちゅう": "صَرِير / صَرَّ ((صَرَّ) يَصْرِرِ صَريرًا: صوَّتَ. يقال: (صَرَّ) العصفورُ والجُندُبُ، و(صَرَّ) القلم، و(صَرَّ) البابُ؛ (صَرَّتِ) الأُذنُ: كان لها طنين)\nمثال: لدى مايوكو حاسة بصر حادة. / فَأْرَة, فَأْر",
 "ちゅうちょ": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / تثاقل, تردد (درجة معينة من عدم الرغبة) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: كان هناك تردد في كلامه",
 "ちゅうちょう": "الْعُصُور الْوُسْطَى, الْقُرُون الْوُسْطَى",
 "ちゅうっぱら": "غَضَب / أَغْضَبَ / غَضِبَ",
 "ちゅうづりぎかい": "برلمان معلق",
 "ちゅうていど": "مُتَوَسِّط",
 "ちゅうてつ": "حديد الزهر, حديد مسبوك (سبيكة من الحديد تحتوي على نسبة عالية من الكربون بحيث تكون هشة ولا يمكن طرقها بل يجب تشكيلها بالصب)",
 "ちゅうてつかん": "صَلْبٌ كَالحَدِيد (شديد المتانة والصلابة)",
 "ちゅうてつしょ": "مسبك حديد (مسبك يتم فيه إنتاج الحديد الزهر)",
 "ちゅうてん": "جَوّ",
 "ちゅうと": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط",
 "ちゅうとう": "الشَّرْق الْأَوْسَط, مَشْرِق / مُتَوَسِّط, مُعَدَّل / رَأْسْمَال, رَأْس مَال / تَاج العَمُود / مِيسَم / سَرِقَة, سَرَقَة / لِصّ, لِصَّة",
 "ちゅうとうがっこう": "مَدْرَسَة ثَانَوِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / ثَانَوِيَّة (مؤَنَّث الثانَويّ)\nمثال: لا أحب المدرسة.",
 "ちゅうとうきょういく": "تعليم ثانوي (التعليم بعد المراحل الابتدائية؛ تقدمه مدرسة ثانوية أو مدرسة تحضيرية للكلية)",
 "ちゅうとうこきゅうきしょうこうぐん": "إنفلونزا الإبل, فيروس كورونا المسبب لمتلازمة الشرق الأوسط التنفسية",
 "ちゅうとうし": "مستخرج الخرطوش (آلية في سلاح ناري تسحب غلاف القذيفة الفارغ من الغرفة وتمرره إلى اللافظ) / جهاز طرد مركزي, فراز (جهاز يستخدم قوة الطرد المركزي لفصل الجزيئات عن المعلق) / أداة استخراج (أداة لاستخراج المكونات المحكمة التثبيت)",
 "ちゅうとうぶ": "مدرسة ثانوية, مدرسة متوسطة (مدرسة للطلاب بين المدرسة الابتدائية والكلية؛ عادة الصفوف من 9 إلى 12)",
 "ちゅうとし": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "ちゅうとはんぱ": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط",
 "ちゅうとん": "إِذَاعَة, مَحَطَّة إِذَاعِيَّة",
 "ちゅうとんぐん": "حَامِيَة",
 "ちゅうとんじょ": "عَارِضَة, عَارْضَة / مَنْشوُر, بُوسْت / نَشَرَ, نشر (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات)\nمثال: نشر توم الغسيل.",
 "ちゅうとんち": "حَامِيَة",
 "ちゅうど": "اِتِّسَاق / مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "ちゅうどう": "وَسَطِيَّة / مُنْتَصَف, وَسَط / وَسَط, مُتَوَسْط",
 "ちゅうどうさは": "يَسَارِيّ (يؤمن بمبادئ اليسار السياسي أو يدعمها)",
 "ちゅうどうせいじ": "وَسَطِيَّة",
 "ちゅうどうせいとう": "وَسَطِيُّ الاتِّجَاه (لَيْسَ مُتَطَرِّفًا خَاصَّةً فِي الآرَاءِ السِّيَاسِيَّة) / مُعْتَدِل, وَسَطِيّ (يدعم أو ينتهج مساراً ليس ليبرالياً ولا محافظاً بشكل مفرط)",
 "ちゅうどうは": "مُحَايِد / نُقْطَة الْعَطَالَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "ちゅうどうろせん": "وَسَطِيُّ الاتِّجَاه (لَيْسَ مُتَطَرِّفًا خَاصَّةً فِي الآرَاءِ السِّيَاسِيَّة) / مُعْتَدِل, وَسَطِيّ (يدعم أو ينتهج مساراً ليس ليبرالياً ولا محافظاً بشكل مفرط)",
 "ちゅうどく": "تَسْمِيم / تَسَمُّم / إِدْمَان",
 "ちゅうどくがく": "عِلْم السُّمُوم (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "ちゅうどくしゃ": "مُدْمِن, مُدْمِنَة",
 "ちゅうどくせい": "سَامّ",
 "ちゅうどくせいひょうひえししょう": "عَشَرَة, عَشْرَة",
 "ちゅうどくせいひょうひえしゆうかいしょう": "عَشَرَة, عَشْرَة",
 "ちゅうなる": "مُخْلِص, وَفِيّ (شديد الإخلاص والمودّة والتفاني)",
 "ちゅうに": "فِي السَّنَةِ الثَّانِيَة (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الثَّانِيَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ أَوِ الجَامِعَةِ الأَمْرِيكِيَّةِ)",
 "ちゅうにかい": "طابق مسروق, ميزانين (طابق متوسط يقع فوق الطابق الأرضي مباشرة)",
 "ちゅうにゅう": "مُتَدَفِّق, مُنْهَمِر (يسيل بغزارة)",
 "ちゅうにん": "خَاطِب, خَاطِبَة / حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "ちゅうねん": "كهولة, منتصف العمر (الفترة العمرية بين الشباب والشيخوخة (مثلاً، بين 40 و 60 سنة))",
 "ちゅうねんおとこ": "رجل في منتصف العمر (رجل يتراوح عمره تقريباً بين 45 و 65 عاماً)",
 "ちゅうねんおんな": "كَهْل / كَهْلَة",
 "ちゅうねんぶとり": "كَهْل / كَهْلَة",
 "ちゅうねんもの": "كَهْل / كَهْلَة",
 "ちゅうのう": "دماغ متوسط (الجزء الأوسط من الدماغ) / مِن الطَّبَقَة المُتَوَسِّطَة (يحتل مكانة اجتماعية واقتصادية متوسطة بين الطبقات الدنيا والأثرياء)",
 "ちゅうは": "موجة متوسطة (موجة راديوية بطول موجي بين 100 و 1000 متر (تردد بين 300 كيلو هرتز و 3000 كيلو هرتز))",
 "ちゅうはいよう": "أديم متوسط, الأديم الأوسط (الطبقة المنتشة الوسطى التي تتطور لتشكل العضلات والعظام والغضاريف والدم والنسيج الضام)",
 "ちゅうはちょう": "موجة متوسطة (موجة راديوية بطول موجي بين 100 و 1000 متر (تردد بين 300 كيلو هرتز و 3000 كيلو هرتز))",
 "ちゅうはん": "مُنْتَصَف, وَسَط / وَسَط, مُتَوَسْط / غَدَاء (هو طَعَام الغُدْوَة، وهو الوقت بين الفَجْر وطلوع الشَمْس. استخدام قديم؛ طعام الظُهْر. استخدام حديث)\nمثال: إنه وقت الغداء.",
 "ちゅうばん": "مركز, منتصف (نقطة متساوية البعد عن نهايات خط أو أطراف شكل ما) / خط الوسط, وسط الملعب ((رياضة) الجزء الأوسط من ملعب اللعب (كما في كرة القدم))",
 "ちゅうひ": "ظهارة متوسطة (ظهارة تنشأ في الأديم المتوسط الجنيني؛ تبطن تجويف الجسم البدائي)",
 "ちゅうひしゅ": "ورم الظهارة المتوسطة (شكل من أشكال سرطانة الظهارة المتوسطة المبطنة للرئتين أو البطن أو القلب؛ يرتبط عادة بالتعرض لغبار الأسبستوس)",
 "ちゅうびゅう": "مُتَشَابِك, مُتَلَبِّد (مُلتَفّ ومتشابك في كتلة واحدة) / مُتَشَابِك, مُتَوَرِّط (مُنْغَمِس فِي صُعُوبَات وَمَشَاكِل) / مُتَشَابِك, مُتَوَرِّط (مُنْخَرِطٌ بِعُمْقٍ خَاصَّةً فِي أَمْرٍ مُعَقَّد) / مَأْلُوف",
 "ちゅうびん": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "ちゅうふ": "شَلَل, كَسَح / طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر.",
 "ちゅうふう": "شَلَل, كَسَح",
 "ちゅうふく": "سفح الجبل (جانب أو منحدر الجبل)\nمثال: تغطي غابات الصنوبريات السفح الشرقي",
 "ちゅうぶ": "مَرْكَز (موضع الاِرْتِكَاز عامة؛ موضع الشخص ومحلّه الذي يبقى فيه عادة)\nمثال: أين أقرب مركز شرطة؟ / شَلَل, كَسَح",
 "ちゅうぶう": "شَلَل, كَسَح",
 "ちゅうぶじかん": "توقيت المنطقة الوسطى (التوقيت القياسي في المنطقة الزمنية السادسة غرب غرينتش، يحسب عند خط الطول 90؛ يستخدم في وسط الولايات المتحدة)",
 "ちゅうぶとり": "بَدِين بِلُطْف, مُمْتَلِئ (سَمِين بِمَا يَكْفِي لِيَكُون مُمْتَلِئًا بِشَكْلٍ مُحَبَّب)",
 "ちゅうぶひょうじゅんじ": "توقيت المنطقة الوسطى (التوقيت القياسي في المنطقة الزمنية السادسة غرب غرينتش، يحسب عند خط الطول 90؛ يستخدم في وسط الولايات المتحدة)",
 "ちゅうぶらりん": "تعليق, دندلة (فعل تعليق شيء ما (تعليقه من الأعلى بحيث يتحرك بحرية))\nمثال: كان هناك حفل صغير لتعليق الصورة / قَيْدَ الِانْتِظَار, مُعَلَّق (فِي انْتِظَارِ الِاخْتِتَامِ أَوِ التَّأْكِيدِ)",
 "ちゅうぶる": "مُسْتَعْمَل (غير جَدِيد، لم يصل البَلَى بعد إلا أنه في الطريق إلى ذلك؛ مُسْتَخْدَم، أحد ما يستخدمه الآن)\nمثال: اشتريت جوال مستعمل.",
 "ちゅうぶん": "تذييل, تعليق (عملية إضافة ملاحظات) / حاشية, ملاحظة (تعليق أو تعليمات (تضاف عادة))\nمثال: أضيفت ملاحظاته في نهاية المقال",
 "ちゅうぶアメリカ": "أمريكا الوسطى (دول أمريكا الوسطى مجتمعة)",
 "ちゅうへん": "أقصوصة طويلة, رواية قصيرة (رواية قصيرة الحجم) / بَلَاط / مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "ちゅうへんしょうせつ": "أقصوصة طويلة, رواية قصيرة (رواية قصيرة الحجم)",
 "ちゅうべい": "أمريكا الوسطى (دول أمريكا الوسطى مجتمعة)",
 "ちゅうほ": "وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / وساطة (تفاوض لحل الخلافات يديره طرف محايد)",
 "ちゅうほしゃ": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "ちゅうぼう": "مَطْبَخ (المكان الذي يُطْبَخُ فيه، غُرْفَة أو مساحة في البناء مخصصة للطبخ؛ في : هو المَطْعَم)\nمثال: سامي في المطبخ. / طْرُول / مُتَصَيِّد, طْرُول",
 "ちゅうみせ": "مِن الطَّبَقَة المُتَوَسِّطَة (يحتل مكانة اجتماعية واقتصادية متوسطة بين الطبقات الدنيا والأثرياء)",
 "ちゅうみつ": "كَثِيف, غَلِيظ",
 "ちゅうもうしょう": "عشى, عمى نهاري (عدم القدرة على الرؤية بوضوح في الضوء الساطع)",
 "ちゅうもく": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "ちゅうもくかぶ": "أسهم ساخنة, إصدار ساخن (أسهم صادرة حديثاً عليها طلب عام كبير)",
 "ちゅうもくど": "حُدُود خَارِجِيَّة / صُورَة جَانِبِيَّة / سِيرَة / شُهْرَة / بُرُوز",
 "ちゅうもくのまと": "محور, مركز اهتمام (الشيء الذي يركز عليه الاهتمام والانتباه)\nمثال: قصصه جعلته محور الحفلة",
 "ちゅうもり": "مُتَوَسِّطُ ٱلْحَجْمِ",
 "ちゅうもん": "تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / طَلَب, مَسْأَلَة (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "ちゅうもんがおおい": "شاق, متطلب (يتطلب أكثر مما هو متوقع عادة أو يُعتقد أنه مستحق؛ خاصة صبراً وجهداً ومهارة كبيرة)\nمثال: وجد الوظيفة شاقة جداً",
 "ちゅうもんしゃ": "منظم, منهجي (منظم يضع الأشياء في ترتيب) / طالب بضاعة, مقدم الطلب (شخص يقدم طلباً للشراء)\nمثال: كان أرسطو منظماً عظيماً للأفكار",
 "ちゅうもんしょ": "نموذج طلب (نموذج يستخدم عند تقديم طلب شراء)",
 "ちゅうもんじゅうたく": "مَبْنِيٌّ حَسَبَ الطَّلَبِ (مُشيَّد خصيصاً لفرد معيَّن) / مَصْنُوع حَسَبَ الطَّلَب, مُفَصَّل (عنصر مصنوع وفقاً لمواصفات العميل)",
 "ちゅうもんせいさん": "مُفَصَّلٌ حَسَبَ الطَّلَبِ ((عن الملابس) مصنوع حسب المقاس والطلب) / مَبْنِيٌّ حَسَبَ الطَّلَبِ (مُشيَّد خصيصاً لفرد معيَّن)",
 "ちゅうもんでんぴょう": "نموذج طلب (نموذج يستخدم عند تقديم طلب شراء)",
 "ちゅうもんとり": "بَيَّاع, بَيَّاعَة",
 "ちゅうもんのおおい": "شاق, متطلب (يتطلب أكثر مما هو متوقع عادة أو يُعتقد أنه مستحق؛ خاصة صبراً وجهداً ومهارة كبيرة)\nمثال: وجد الوظيفة شاقة جداً",
 "ちゅうもんふく": "مخصص, مفصل حسب الطلب (مصنوع وفقاً لمواصفات الفرد) / مَصْنُوع حَسَبَ الطَّلَب, مُفَصَّل (عنصر مصنوع وفقاً لمواصفات العميل)",
 "ちゅうもんをつける": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب",
 "ちゅうや": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل. / انقلاب شتوي (22 ديسمبر، عندما تكون الشمس في أقصى نقطة جنوبية لها)",
 "ちゅうやく": "اَلطِّبّ اَلصِّينِيّ",
 "ちゅうやけんこう": "دُونَ تَوَقُّف, عَلَى مَدَارِ السَّاعَة (فِي جَمِيعِ الأَوْقَات؛ دُونَ انْقِطَاع)",
 "ちゅうやをとわず": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "ちゅうやをわかたず": "لَيْلَ نَهَارَ, صَبَاحَ مَسَاءَ (من مغرب الشمس إلى طلوعها)\nمثال: بكت طوال الليل.",
 "ちゅうゆ": "زَيْت, زيت (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن) / نَفْط, زَيْت (سَائِل أسود قابل للاحتراق يوجد في باطن الأرض تستخدم مشتقاته كوقود وفي الصناعة. يعتبر حاليا أهم مصادر الطاقة في العالم)\nمثال: خبأن ذلك الزيت.",
 "ちゅうよう": "عَنَى, قَصَدَ / لَئِيم, خَسِيس / مُتَوَسِّط",
 "ちゅうようすい": "مُلْحَق",
 "ちゅうようとっき": "زائدة, زائدة دودية (نتوء أثري يمتد من الطرف السفلي للمصران الأعور ويشبه جيباً صغيراً)",
 "ちゅうようとっきえん": "الْتِهابُ الزَّائِدَةِ الدُّودِيَّة",
 "ちゅうりきこ": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "ちゅうりく": "إِعْدَام, عُقُوبَة الْإِعْدَام (في القانون: هي عقوبة يحددها القضاء على جريمة كبرى اقترفها المتهم وتؤدي إلى قتل المتهم غالبا بالشنق)\nمثال: محكم عليه بالإعدام.",
 "ちゅうりつ": "حِيَاد",
 "ちゅうりつしゅぎ": "حياد (سياسة الحياد أو عدم الانحياز في الشؤون الدولية)",
 "ちゅうりつせい": "حِيَاد",
 "ちゅうりつちたい": "مِنْطَقَةُ مَنْزُوعَةُ السَلَاح (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "ちゅうりつてき": "مُحَايِد / نُقْطَة الْعَطَالَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "ちゅうりゃく": "إِغْفَال",
 "ちゅうりゅう": "طَبَقَة وُسْطَى / إِذَاعَة, مَحَطَّة إِذَاعِيَّة",
 "ちゅうりゅうかいきゅう": "طَبَقَة وُسْطَى",
 "ちゅうりゅうしゃかい": "طَبَقَة وُسْطَى",
 "ちゅうりん": "مَوْقِف, مَوْقِف سَيَّارَات / مُتَوَسِّطُ ٱلْحَجْمِ",
 "ちゅうる": "إبعاد, حظر (الرفض عن طريق فعل نفي أو حظر شخص ما) / إبعاد, نبذ (حالة النفي أو النبذ (الاستبعاد من المجتمع بموافقة عامة))\nمثال: يجب على الجمعية التخلص من أعضائها المسنين - ليس عن طريق القتل الرحيم بالطبع، ولكن عن طريق النبذ",
 "ちゅうろう": "كهولة, منتصف العمر (الفترة العمرية بين الشباب والشيخوخة (مثلاً، بين 40 و 60 سنة)) / وصيفة الشرف (سيدة تُعين لخدمة ملكة أو أميرة)",
 "ちゅうろく": "عرق وسطي (العرق الموجود في وسط الورقة)",
 "ちゅうわ": "إبطال المفعول, تحييد (إجراء يهدف إلى إبطال آثار إجراء سابق) / تحييد (إجراء يهدف إلى إبقاء دولة محايدة سياسياً أو استبعادها من حرب محتملة) / تحييد, قضاء على ((تعبير ملطف) إزالة تهديد عن طريق قتله أو تدميره (خاصة في العمليات العسكرية)) / تعادل, تفاعل التعادل (تفاعل كيميائي يتفاعل فيه حمض وقاعدة لتكوين ملح؛ ومع الأحماض والقواعد القوية يكون التفاعل الأساسي هو اتحاد أيونات الهيدروجين مع أيونات الهيدروكسيل…)\nمثال: تحييد بلجيكا",
 "ちゅうわざい": "مُحَايِد, مُضَادّ (يُعارِض أو يُحايِد أو يُخفِّف من أثرٍ بفعل مضادّ)",
 "ちゅうわはんのう": "تعادل, تفاعل التعادل (تفاعل كيميائي يتفاعل فيه حمض وقاعدة لتكوين ملح؛ ومع الأحماض والقواعد القوية يكون التفاعل الأساسي هو اتحاد أيونات الهيدروجين مع أيونات الهيدروكسيل…)",
 "ちゅうボス": "نائب الزعيم (مساعد أو الرجل الثاني لرئيس (خاصة في عصابات الجريمة))",
 "ちゅう事": "وَبِعِبَارَة أُخْرَى",
 "ちゅきぴ": "هَرَسَ (سَحَقَ أو دَكَّ شيئًا بقوة حتى يتفتت؛ طَحَنَ أو فَتَّتَ شيئًا)",
 "ちゅけいるい": "حَيَوَان عَنْكَبُوتِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "ちゅっぱら": "غَضَب / أَغْضَبَ / غَضِبَ",
 "ちゅら": "جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل.",
 "ちゅらさん": "جَمَال, زَيْن / حَسْنَاء, جَمِيلَة",
 "ちゅるちゅる": "نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح. / نُودَلْز, شَعْرِيَّة",
 "ちゅん": "تَغْرِيدَة, تَغْرِيد / غَرَّدَ",
 "ちゅんちゅん": "تَغْرِيدَة, تَغْرِيد / غَرَّدَ",
 "ちゅー": "قَبَّلَ, بَاسَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قُبْلَة, بَوْسَة\nمثال: كنت هنا من قبل. / صَرِير / صَرَّ ((صَرَّ) يَصْرِرِ صَريرًا: صوَّتَ. يقال: (صَرَّ) العصفورُ والجُندُبُ، و(صَرَّ) القلم، و(صَرَّ) البابُ؛ (صَرَّتِ) الأُذنُ: كان لها طنين)\nمثال: لدى مايوكو حاسة بصر حادة.",
 "ちゆ": "شِفَاء",
 "ちゆう": "صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة.",
 "ちょ": "عَمَل, شُغْل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / مُصَنَّف, مُؤَلَّف / سَارَ (مَشَى)\nمثال: المهم هو العمل. / بِجَانِب, جنب (بجانب) / عِنْدَ, فِي (يُفِيدُ الحضور أو وجود صلة أو علاقة مثل الانتماء والامتلاك. (ظرف مكان)؛ يُفِيدُ قُرْبَ الشيء. (ظرف مكان)) / مِن قِبَل, بِوَاسِطَّة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / بِوَاسِطَّة, لِـ\nمثال: زيري بجانب الحوض. / صَفَاء, نَقَاء (صفة الماء الصافي) / جَلَاء, صَفَاء (الخلو من الغموض وسهولة الفهم؛ قابلية التعبير الواضح للفهم)\nمثال: عندما استيقظت عاد الصفاء إلى عينيها / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة! / يَاه, اسمع / هَلَا",
 "ちょい": "قَلِيلًا / بِاِخْتِصَار / إلى حد ما, باعتدال (إلى حد أو درجة معينة) / إلى حد ما, قليلاً (بدرجة أو مدى صغير)\nمثال: كبير جداً",
 "ちょいちょい": "كَثِيرًا, غَالِبًا / باستخفاف, ببساطة (بلا مبالاة أو بدون اكتئاب) / باعتدال, بخفة (الانغماس باعتدال) / بشكل طفيف, خفيفاً (إلى درجة طفيفة) / بخفة, برفق (بقليل من الوزن أو القوة)\nمثال: أخذ الأمر باستخفاف / بِسُهُولَة",
 "ちょいと": "قَلِيلًا / بِاِخْتِصَار / إلى حد ما, باعتدال (إلى حد أو درجة معينة) / إلى حد ما, قليلاً (بدرجة أو مدى صغير)\nمثال: كبير جداً / بِسُهُولَة",
 "ちょいやく": "دور ثانوي, دور صغير (دور صغير)",
 "ちょい役": "دور ثانوي, دور صغير (دور صغير)",
 "ちょう": "عَدَد زَوْجِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟ / بِلْيُون (مَلْيُونُ مَلْيُونٍ (بريطانيا)؛ الف مِلْيون أي مِلْيار (الولايات المتحدة الأمريكية)) / تِرِيلِيُون / تِرِيلِْيُون\nمثال: الشركة عانت من خسارة واحد بليون ين السنة الماضية. / لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب. / كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد / مكتب حكومي (مكتب يعمل فيه موظفو الحكومة) / سُلَالَة / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / حِصَّةٌ / عَصْر (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: هذه هي نقطة ضعفه. / مَحْكَمَة (مقام الحاكم. وغلبت على مقام الحاكم الشرعي أي القاضي)\nمثال: عاد إلى المحكمة. / مِعًى / مَعْي / مِعَاء / أَمْصِرَة / مَصِير / مُصْرَان / فَرَاشَة, ابو دقيق (حشرة صغيرة رقيقة ذات أجنحة كبيرة قد تكون ملونة أو غير ملونة)\nمثال: آه ، هناك فراشة! / الْأُقْصَى, الْأَبْعَد / شَدِيد / غَيْر اِعْتِيَادِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / خَطِير / مُتَطَرِّف / أَخِير\nمثال: أنا غير متفاجئ. / بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً / طَبْعًا / فَوْقَ / عَلَى (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ / جَدَارَة / تَفَوُّق / رَائِد / زِرّ / وَضْع (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / مِنْوَال\nمثال: لقد أزمت الوضع. / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / مِقْيَاس / وَزْن / بَحْر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر. / مَعْرُوف / أَنْعَمَ / خراج, دمل (قرحة مؤلمة ذات لب صلب مملوء بالقيح) / لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب. / دَعَا, نَادَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتَّصَلَ بِـ / دَعَا, سَمَّى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه) / اِتِّصَال, مُكَالَمَة / زِيَارَة\nمثال: دعا ثلاميذه الاثني عشر / حراسة قضائية, مصادرة مؤقتة (الاستيلاء على ممتلكات تخص شخصاً آخر والاحتفاظ بها حتى تدفع الأرباح الطلب الذي تم الاستيلاء عليها من أجله) / طلب صرف, نموذج طلب رسمي (نموذج رسمي يتم فيه تقديم طلب (عادة لمواد أو إمدادات)) / اسْتِيلَاء, طَلَب رَسْمِيّ (طلب رسمي أو مطالبة، خاصة من قبل سلطة عسكرية أو عامة تستولي على شيء (عادة مؤقتاً) للاستخدام العسكري أو العام)\nمثال: أولاً عليك ملء طلب الصرف / مَدِينَة, قَرْيَة / شَارِع, زَنَقَة",
 "ちょうあい": "مَعْرُوف / أَنْعَمَ / جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع",
 "ちょうあくだま": "شرير خارق (شرير يتمتع بقوى خارقة)",
 "ちょうい": "تَأْسِيَة / تَعْزِيَة / رداء احتفالي, روب (ملابس خارجية تتكون من ثوب طويل منسدل يستخدم في المناسبات الرسمية أو الاحتفالية) / رداء طويل, روب (أي رداء فضفاض منسدل)",
 "ちょういき": "جوار, جيرة (أشخاص يعيشون بالقرب من بعضهم البعض) / جوار, منطقة مجاورة (منطقة محيطة أو قريبة)\nمثال: إنه حي ودود",
 "ちょういちりゅう": "بشكل ممتاز, على ما يرام (بشكل جيد جداً) / فَائِق, مُمْتَاز (من أعلى مستويات الجودة)\nمثال: إنها لا تشعر أنها على ما يرام اليوم",
 "ちょういん": "تَوْقِيع, إِمْضَاء (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ) / تَوْقِيع (أن يصيب المَطَر بعض الأَرْض ويخطيء بعضها؛ نوع من الخَطّ)\nمثال: أحتاج لتوقيع توم.",
 "ちょういんしゃ": "مُوقّع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "ちょうえきけい": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "ちょうえつ": "تسامي, تعالي (حالة التفوق أو التجاوز أو تخطي الحدود المعتادة) / تسام, تعال (حالة من الوجود فوق حدود التجربة المادية وخارجها)",
 "ちょうえつしゅぎ": "تسامي, فلسفة متعالية (أي نظام فلسفي يؤكد على الحدسي والروحي فوق التجريبي والمادي)",
 "ちょうえつすう": "عَدَد مُتَسَامٍ (عدد غير نسبي ليس جبرياً (لا يمكن أن يكون حلاً لمعادلة جبرية))",
 "ちょうえつてき": "متسام",
 "ちょうえつろんてき": "متسام",
 "ちょうえつろんてつがく": "تسامي, فلسفة متعالية (أي نظام فلسفي يؤكد على الحدسي والروحي فوق التجريبي والمادي)",
 "ちょうえん": "بَادِئَة مَعْنَاهَا مَعْي (فِي : لَاصِقَة تزاد قبل الكلمة لتحويل مبناها وتغيير معناها. وهي وسيلة اقتصادية لبناء المفردات في اللغة) / إِهْلِيلَج, قَطْعٌ نَاقِص",
 "ちょうえんしんき": "جهاز طرد مركزي فائق (جهاز طرد مركزي عالي السرعة يستخدم لتحديد الكتل الجزيئية النسبية للجزيئات الكبيرة في البوليمرات العالية والبروتينات)",
 "ちょうおおもの": "شخصية هامة جداً, كبار الشخصيات (شخص مهم أو مؤثر (وغالباً ما يكون متسلطاً))",
 "ちょうおん": "حركة طويلة, صائت طويل (صائت يتم نطقه عادة لفترة أطول نوعاً ما من الصوائت الأخرى (عادة حوالي 1.5 إلى ضعف الطول)) / تمفصل (عملية ربط الأشياء بطريقة تجعل الحركة ممكنة) / مفصل ((في التشريح) نقطة الاتصال بين عظمين أو عناصر هيكل عظمي (خاصة إذا كانت تسمح بالحركة)) / تعبير, نطق (التعبير بشكل لفظي متماسك) / تلفظ, نطق مخارج الحروف (جانب النطق الذي يتضمن جمع أعضاء النطق معاً لتشكيل أصوات الكلام)\nمثال: التعبير عن مشاعري / توليف, دوزنة ((موسيقى) معايرة شيء ما (آلة أو دائرة إلكترونية) لتردد قياسي) / سَمِيع (سَميع: (اسم)؛ سميع: (اسم)) / سَمْع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى)) / جَلْسَة\nمثال: سمع سامي صريرا.",
 "ちょうおんかい": "سلم الماجور, سلم كبير (سلم دياتوني تفصل بين نغماته نغمات كاملة باستثناء بين الثالثة والرابعة والسابعة والثامنة)",
 "ちょうおんきごう": "عَلَامَة اَلْمَدّ (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "ちょうおんてん": "مَخْرَج",
 "ちょうおんぱ": "الْمَوْجَات فَوْقَ الصَّوْتِيَّة",
 "ちょうおんぱけんさ": "تصوير بالموجات فوق الصوتية, سونار (استخدام انعكاسات الموجات الصوتية عالية التردد لبناء صورة لعضو من أعضاء الجسم؛ يُستخدم عادة لمراقبة نمو الجنين أو دراسة أعضاء الجسم)",
 "ちょうおんぱけんさほう": "تصوير بالموجات فوق الصوتية, سونار (استخدام انعكاسات الموجات الصوتية عالية التردد لبناء صورة لعضو من أعضاء الجسم؛ يُستخدم عادة لمراقبة نمو الجنين أو دراسة أعضاء الجسم)",
 "ちょうおんぱしんだん": "تصوير بالموجات فوق الصوتية, سونار (استخدام انعكاسات الموجات الصوتية عالية التردد لبناء صورة لعضو من أعضاء الجسم؛ يُستخدم عادة لمراقبة نمو الجنين أو دراسة أعضاء الجسم)",
 "ちょうおんふごう": "عَلَامَة اَلْمَدّ (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "ちょうおんぶい": "مَخْرَج",
 "ちょうおんぷ": "عَلَامَة اَلْمَدّ (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "ちょうか": "رِثَاء, مَرْثِيَة / إفراط في التدليل (التدليل المفرط) / زَائِد, فَائِض (أكثر مما هو مطلوب أو مرغوب فيه أو لازم) / إفراط, تجاوز (عدم الاعتدال نتيجة لتجاوز الحدود الكافية أو المسموح بها) / زيادة, فائض (كمية أكبر بكثير مما هو مطلوب)\nمثال: أفسد الطفل بسبب الإفراط في التدليل / لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / جزمة مطاطية (حذاء طويل مصنوع من المطاط)",
 "ちょうかい": "تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "ちょうかいきょう": "جسر قلاب, جسر متحرك (جسر يمكن رفعه لقطع الطريق أو للسماح للقوارب أو السفن بالمرور تحته)",
 "ちょうかいしょぶん": "عِقَاب, إِسْتِحْسَان (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "ちょうかいぞう": "زاوية مجسمة, ستيراديان (وحدة الزاوية المجسمة المعتمدة في النظام الدولي للوحدات) / سترونتيوم (عنصر فلزي ناعم فضي-أبيض أو مصفر من مجموعة الفلزات القلوية الترابية؛ يتحول لونه للأصفر في الهواء)",
 "ちょうかいふく": "تعويض مفرط (تعويض زائد عن الحد) / تعويض مفرط ((في الطب النفسي) محاولة للتغلب على عيب حقيقي أو متخيل أو سمة غير مرغوب فيها عن طريق المبالغة المفرطة في نقيضها)",
 "ちょうかがく": "فَائِض",
 "ちょうかきんむ": "وَقْت إِضَافِيّ (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب.",
 "ちょうかく": "سَمِيع (سَميع: (اسم)؛ سميع: (اسم)) / سَمْع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى)) / جَلْسَة\nمثال: سمع سامي صريرا. / زاوية رأسية, زاوية متقابلة بالرأس (إحدى زاويتين متساويتين ومتقابلتين ناتجتين عن تقاطع خطين مستقيمين) / تكساس لونغ هورن, لونغ هورن (ماشية لحم طويلة القرون كانت شائعة سابقاً في جنوب غرب الولايات المتحدة)",
 "ちょうかくか": "خَرْدَلَة, قَرْنَة (كبسولة بذور ضيقة ومستطيلة تميز الفصيلة الصليبية)",
 "ちょうかくかびん": "احتداد السمع (حدة سمع غير طبيعية بسبب زيادة تهيج الآلية العصبية الحسية)",
 "ちょうかくぎゅう": "تكساس لونغ هورن, لونغ هورن (ماشية لحم طويلة القرون كانت شائعة سابقاً في جنوب غرب الولايات المتحدة)",
 "ちょうかくけい": "الجهاز السمعي (الجهاز الحسي للسمع)",
 "ちょうかくし": "هَيْبِرُون (أي باريون ليس نيوكليوناً؛ جسيم غير مستقر ذو كتلة أكبر من النيوترون)",
 "ちょうかくしょうがい": "اضطراب السمع, ضعف السمع (قصور في حاسة السمع)",
 "ちょうかくしょうがいしゃ": "ثَقِيلُ السَّمْعِ, ضَعِيفُ السَّمْعِ (لديه فقدان جزئي في السمع)",
 "ちょうかくしんけい": "عصب دهليزي قوقعي, عصب سمعي (عصب حسي مركب يغذي الخلايا الشعرية للعضو الدهليزي والخلايا الشعرية للقوقعة)",
 "ちょうかくちゅうすう": "مركز سمعي (جزء الدماغ (في طية من القشرة المخية للفص الصدغي على جانبي الدماغ) الذي يستقبل النبضات من الأذن عن طريق العصب السمعي)",
 "ちょうかそうしん": "بَرْبَرَة, ثَرْثَرَة سَرِيعَة (كلام سريع وغير واضح)",
 "ちょうかぶん": "فَائِض",
 "ちょうかん": "سِكْرِتِير, سِكْرِتِيرَة / مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله) / قَنَاة هَضْمِيَّة",
 "ちょうかんかくてきちかく": "إدراك خارج الحواس, استبصار (قوة ظاهرية لإدراك أشياء غير موجودة للحواس)",
 "ちょうかんず": "مَنْظُور عَيْن الْطَائِر",
 "ちょうかんたい": "منطقة المد والجزر (منطقة خاضعة لتأثير المد والجزر)",
 "ちょうかんてき": "بَانُورَامِيّ, مِنْ عَلُوّ (كما يُرى من ارتفاع أو مسافة بعيدة)",
 "ちょうかんまく": "مِسْرَاق",
 "ちょうがい": "أَبْيَض الشَّفَتَيْن مِنَ الخَوْف (ابيضّت شفتاه من الخوف أو الرعب)",
 "ちょうがく": "عَلِمَ الطَائِر, عَلِم الطُيُور (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "ちょうがた": "فَرَاشِيّ الشَّكْل (على شكل فراشة)",
 "ちょうがたべん": "صمام فراشة (صمام في المكربن يتكون من قرص يدور ويعمل كخانق)",
 "ちょうがつく": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "ちょうき": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها) / منقاش, مِزمَل (إزميل من الفولاذ المقسى ذو طرف حاد؛ يستخدم للنقش)",
 "ちょうきか": "إطالة, تمديد (فعل إطالة مدة شيء ما)\nمثال: كان هناك تمديد غير محدد لمحادثات السلام",
 "ちょうきかしつけきん": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうききおく": "ذاكرة طويلة المدى (مخزونك العام من المعلومات المتذكرة)",
 "ちょうききんり": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきけいかく": "بَعِيد المَدَى (مُناسِب لِلوُصول إلى مَسافات بَعيدَة) / بَعِيد المَدَى (يَشْمَل فَتْرَة زَمَنِيَّة مُمْتَدَّة)",
 "ちょうきこくさい": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきさい": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきしゃっかん": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきしよう": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきしんようぎんこう": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきせん": "مُطَوَّل, مُمْتَدّ ((عَنِ الكَلَام) يُنْطَق بِبُطْء مَعَ مَدّ الحُرُوف المُتَحَرِّكَة) / مُتَطَاوِل, مُطَوَّل (طَويل نِسْبِيًّا في المُدَّة؛ مُمْتَدّ بِشَكْل مُمِلّ)",
 "ちょうきせんりゃく": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきそく": "قاعدة عليا, قاعدة وصفية (قاعدة تصف كيفية استخدام القواعد الأخرى (كما في الذكاء الاصطناعي))",
 "ちょうきたいさく": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきたいざい": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきたいざいしゃ": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきてがた": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきてき": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきにゅういん": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきふきょう": "مُنْخَفَض",
 "ちょうきほぞん": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうきゃくるい": "أورنيثوبود (ديناصور عشبي يسير على قدمين)",
 "ちょうきゅう": "دَوَام (دَوَام)\nمثال: أنا أعمل بدوام جزئي. / قوس طويل (قوس خشبي قوي يُسحب باليد؛ يبلغ طوله عادة 5-6 أقدام؛ استخدم في إنجلترا في العصور الوسطى) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / مُطَّلِب / طَلَبَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "ちょうきゆうりょうじゅうたく": "طَوِيل الصَّلَاحِيَة ((في السلع القابلة للتلف) مُعالَج لِيَبْقى طازَجًا لِفَتْرَة أَطْوَل)",
 "ちょうきょ": "تَصْرِيح, سَمَاح",
 "ちょうきょう": "تَدْرِيب, تَمْرِين (تزويدُ الدَّارسين بالدّراسات العلميَّة والعمليّة التي تؤدِّي إلى رفع درجة المهارة عندهم في أداء واجبات الوظيفة؛ إعداد شخص أو مجموعة لتأدية مهمة أو وظيفة معينة)\nمثال: واصل زيري التدريب.",
 "ちょうきょうし": "مدرب حيوانات (شخص يدرب الحيوانات أو يعرضها)",
 "ちょうきょせい": "عِمْلَاق عَظِيم (نجم شديد السطوع ذو قطر كبير جداً وكثافة منخفضة)",
 "ちょうきょり": "مكالمة بعيدة المدى, مكالمة دولية (مكالمة هاتفية تتم خارج منطقة الاتصال المحلية)\nمثال: تحدثت معها عبر مكالمة بعيدة المدى / بَعِيد المَدَى (يغطي مسافة طويلة) / بعيد المسافة, طويل المدى (مكون من أو متعلق بـ أو كونه مكالمة هاتفية بعيدة المسافة)\nمثال: مكالمة بعيدة المسافة",
 "ちょうきょりいぞん": "بَعِيد المَدَى (يغطي مسافة طويلة) / بعيد المسافة, طويل المدى (مكون من أو متعلق بـ أو كونه مكالمة هاتفية بعيدة المسافة)\nمثال: مكالمة بعيدة المسافة",
 "ちょうきょりきょうそう": "بَعِيد المَدَى (يغطي مسافة طويلة) / بعيد المسافة, طويل المدى (مكون من أو متعلق بـ أو كونه مكالمة هاتفية بعيدة المسافة)\nمثال: مكالمة بعيدة المسافة",
 "ちょうきょりしぜんほどう": "بَعِيد المَدَى (يغطي مسافة طويلة) / بعيد المسافة, طويل المدى (مكون من أو متعلق بـ أو كونه مكالمة هاتفية بعيدة المسافة)\nمثال: مكالمة بعيدة المسافة",
 "ちょうきょりそう": "بَعِيد المَدَى (يغطي مسافة طويلة) / بعيد المسافة, طويل المدى (مكون من أو متعلق بـ أو كونه مكالمة هاتفية بعيدة المسافة)\nمثال: مكالمة بعيدة المسافة",
 "ちょうきょりそうしゃ": "عداء ماراثون, عداء مسافات طويلة (شخص يشارك في سباقات المسافات الطويلة (خاصة في الماراثون))",
 "ちょうきょりだしゃ": "ضارب, ضارب الكرة ((في البيسبول) لاعب الكرة الذي يقوم بضرب الكرة بالمضرب) / ملاكم قوي اللكمات (ملاكم مشهور بقدرته على توجيه لكمات قوية)",
 "ちょうきょりでんしゃ": "بَعِيد المَدَى (يغطي مسافة طويلة) / بعيد المسافة, طويل المدى (مكون من أو متعلق بـ أو كونه مكالمة هاتفية بعيدة المسافة)\nمثال: مكالمة بعيدة المسافة",
 "ちょうきょりでんわ": "مكالمة بعيدة المدى, مكالمة دولية (مكالمة هاتفية تتم خارج منطقة الاتصال المحلية)\nمثال: تحدثت معها عبر مكالمة بعيدة المدى",
 "ちょうきょりでんわがいしゃ": "بَعِيد المَدَى (يغطي مسافة طويلة) / بعيد المسافة, طويل المدى (مكون من أو متعلق بـ أو كونه مكالمة هاتفية بعيدة المسافة)\nمثال: مكالمة بعيدة المسافة",
 "ちょうきょりほう": "بَعِيد المَدَى (يغطي مسافة طويلة) / بعيد المسافة, طويل المدى (مكون من أو متعلق بـ أو كونه مكالمة هاتفية بعيدة المسافة)\nمثال: مكالمة بعيدة المسافة",
 "ちょうきょりゆそう": "بَعِيد المَدَى (يغطي مسافة طويلة) / بعيد المسافة, طويل المدى (مكون من أو متعلق بـ أو كونه مكالمة هاتفية بعيدة المسافة)\nمثال: مكالمة بعيدة المسافة",
 "ちょうきょりれっしゃ": "بَعِيد المَدَى (يغطي مسافة طويلة) / بعيد المسافة, طويل المدى (مكون من أو متعلق بـ أو كونه مكالمة هاتفية بعيدة المسافة)\nمثال: مكالمة بعيدة المسافة",
 "ちょうきよほう": "بَعِيد المَدَى (مُناسِب لِلوُصول إلى مَسافات بَعيدَة) / بَعِيد المَدَى (يَشْمَل فَتْرَة زَمَنِيَّة مُمْتَدَّة)",
 "ちょうきん": "طَارَدَ / وَقْت إِضَافِيّ (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب.",
 "ちょうきんか": "مشروب تعقيب (مشروب يؤخذ مباشرة بعد مشروب آخر) / مُطارِد, مُلاحِق (شخص يطارد ويحاول اللحاق أو القبض على أحد)\nمثال: كان دائمًا قادرًا على خداع مطارديه من قبل",
 "ちょうきんし": "مشروب تعقيب (مشروب يؤخذ مباشرة بعد مشروب آخر) / مُطارِد, مُلاحِق (شخص يطارد ويحاول اللحاق أو القبض على أحد)\nمثال: كان دائمًا قادرًا على خداع مطارديه من قبل",
 "ちょうぎ": "المجلس الخاص (مجلس استشاري للحاكم (خاصة للتاج البريطاني))",
 "ちょうぎょ": "صَيْد سَمَك, صَيْد",
 "ちょうぎん": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうくうどう": "خَاوٍ, فَارِغ (لَا يَحْتَوِي عَلَى شَيْء) / بَاطِل, لَاغٍ (يَفْتَقِرُ إِلَى أَيِّ قُوَّةٍ قَانُونِيَّةٍ أَوْ إِلْزَامِيَّة) / خلاء, فراغ (منطقة أو مساحة فارغة) / عدم, لاشيء (حالة عدم الوجود)\nمثال: فراغات الصحراء الشاسعة",
 "ちょうぐみ": "ذُو سِيَادَة, مُسْتَقِلّ ((عَنِ الكِيَانَات السِّيَاسِيَّة) غَيْر خَاضِع لِسَيْطَرَة قُوًى خَارِجِيَّة)",
 "ちょうけい": "المحور الأكبر (أطول محور للقطع الناقص أو المجسم الإهليلجي؛ يمر عبر البؤرتين) / فَرَاشِيّ الشَّكْل (على شكل فراشة)",
 "ちょうけいこつ": "عظم وتدي (عظم على شكل فراشة عند قاعدة الجمجمة)",
 "ちょうけし": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما) / إبطال, إلغاء (الفعل الكلامي للإلغاء أو الفسخ أو الإبطال)",
 "ちょうけん": "تَكْوِين / دُسْتُور, نِظَام (قَاعِدَة) / دُسْتُور (قَاعِدَة)\nمثال: العدالة مضمونة في الدستور. / عَقْرَب دَقَائِق",
 "ちょうげん": "توليف, دوزنة ((موسيقى) معايرة شيء ما (آلة أو دائرة إلكترونية) لتردد قياسي)",
 "ちょうげんじつ": "سُرْيَالِيَّة",
 "ちょうげんじつしゅぎ": "سُرْيَالِيَّة",
 "ちょうげんじつてき": "سُرْيَالِيّ, فَانْتَاسْمَاغُورِيّ (يتّسم بصور خيالية غريبة وتجاورات غير متوقّعة)",
 "ちょうこう": "مُقطِّع اللحم (شخص يقوم بتقطيع اللحم) / مثّال, نحات (فنان يبدع المنحوتات) / حفار, نحات الخشب (يصنع ألواحاً خشبية مزخرفة) / اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر) / رُوج (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها. / تدقيق, مراجعة (فحص منهجي أو مراجعة لحالة أو وضع) / تدقيق, مراجعة حسابات (فحص للإجراءات والسجلات المحاسبية من قبل محاسب مدرب أو محاسب قانوني معتمد)\nمثال: أجرى تدقيقاً لجميع النباتات في ممتلكاته / سَحِيق, غَوْر (يَقَعُ فِي عُمْقٍ كَبِيرٍ أَوْ يَمْتَدُّ إِلَيْهِ؛ أَعْمَقُ مِنْ أَنْ يُسْبَرَ) / ثَقِيل, عَمِيق ((عَنِ النَّوْمِ) عَمِيقٌ وَتَامّ) / عَمِيقٌ مِنَ الأَعْمَاق (نَابِعٌ مِنْ أَعْمَاقِ النَّفْس) / بَالِغُ العُمْق, عَمِيقٌ جِدًّا (مِنْ أَشَدِّ دَرَجَاتِ الحِدَّةِ؛ تَامّ) / لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب. / تَأَمُّلِيّ, مُتَدَبِّر (مُسْتَغْرِقٌ فِي تَفْكِيرٍ عَمِيقٍ وَجِدِّيّ) / مَعْرُوف / أَنْعَمَ / مخفت الإضاءة (مقاومة متغيرة تغير التيار عبر مصباح كهربائي للتحكم في مستوى الإضاءة) / قَرَنْفُل / فَصّ / رَادِيكَالِيّ, مُتَطَرِّف ((لِلآرَاءِ وَالأَفْعَال) بَعِيدٌ جِدًّا عَنِ المِعْيَارِ المَقْبُول)",
 "ちょうこうき": "مخفت الإضاءة (مقاومة متغيرة تغير التيار عبر مصباح كهربائي للتحكم في مستوى الإضاءة)",
 "ちょうこうし": "عَطَّار, عَطَّارَة",
 "ちょうこうせい": "مدقق حسابات, مراجع حسابات (محاسب مؤهل يقوم بفحص السجلات والممارسات المحاسبية لشركة أو مؤسسة) / طالب مستمع (طالب يحضر دورة ولكنه لا يأخذها للحصول على درجات) / مستمع, منصت (شخص يستمع بانتباه)",
 "ちょうこうぜつ": "إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي)",
 "ちょうこうそう": "شاهق, ناطح للسحاب (تستخدم للمباني ذات الطوابق المتعددة المجهزة بمصاعد؛ طويل) / برج سكني, مبنى شاهق (برج يتكون من مبنى متعدد الطوابق للمكاتب أو الشقق)\nمثال: شوارع تصطف على جانبيها مبانٍ سكنية شاهقة",
 "ちょうこうそうけんちく": "نَاطِحَة سَحَاب",
 "ちょうこうそうビル": "نَاطِحَة سَحَاب",
 "ちょうこうそくどさつえい": "عَالِي السُّرْعَة (يَعْمَل بِسُرْعَة عَالِيَة)",
 "ちょうこかん": "مَتْحَف (مكان تُجمع وتُعْرَض فيه الآثار التاريخيَّة أو الفنيَّة أو العِلْميَّة وغيرها)\nمثال: عاد إلى المتحف.",
 "ちょうこく": "نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب. / هَزَمَ, غَلَبَ",
 "ちょうこくおうはん": "لوحة نحاسية (نقص يتكون من صفيحة ملساء من النحاس تم حفرها أو نقشها)",
 "ちょうこくか": "حفّار, نقاش (صانع طباعة يطبع من لوحة طباعة محفورة) / حفار, نقاش (عامل ماهر يمكنه نقش التصاميم أو الكتابة على سطح عن طريق النحت أو الحفر)",
 "ちょうこくぐざ": "إِزْمِيل",
 "ちょうこくし": "حفّار, نقاش (صانع طباعة يطبع من لوحة طباعة محفورة) / حفار, نقاش (عامل ماهر يمكنه نقش التصاميم أو الكتابة على سطح عن طريق النحت أو الحفر)",
 "ちょうこくしつざ": "نَحَّات, مَثَّال (من يمتهن النَّحْتَ، وهو فَنَّان يصنع التماثيل من الحجارة أو الخشب؛ كثير النَّحْتِ)",
 "ちょうこくじゅつ": "تِمْثَال, مَنْحُوتَة / نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب.",
 "ちょうこくとう": "إِزْمِيل",
 "ちょうこくばん": "نَقْشْ (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "ちょうこくぶつ": "نَقْشْ (لوّن بلونين أو أكثر؛ زيَّن بأشكال أو ألوان)",
 "ちょうこっかしゅぎ": "تَعَصُّب وَطَنِيّ, شُوفِينِيَّة (وطنية متعصبة)",
 "ちょうこっかてき": "شُوفِينِيّ, مُتَعَصِّبٌ وَطَنِيًّا (مُتَعَصِّبٌ لِلْوَطَنِيَّةِ تَعَصُّبًا مُفْرِطًا)",
 "ちょうこつ": "حرقفة (الجزء العلوي والأعرض من العظام الثلاثة المكونة لعظم الورك) / عظم طويل (في أطراف الفقاريات: عظم أسطواني طويل يحتوي على نخاع)",
 "ちょうこつどうみゃく": "شريان حرقفي (واحد من الشرايين الكبيرة التي تغذي الحوض والساقين بالدم)",
 "ちょうごう": "خلط, خليط (عملية خلط الأشياء معاً)\nمثال: عجينة مصنوعة من خليط الدقيق والماء / توقيع المفتاح, دليل المفتاح (علامات الرفع (الدييز) أو الخفض (البيمول) التي تتبع المفتاح وتشير إلى السلم الموسيقي)",
 "ちょうごうか": "بَاذِخ, مُسْرِف فِي العَطَاء (بالغ السخاء؛ يُعطي بإسراف ودون حساب) / بَاذِخ, سَخِيّ (يتميّز بالإسراف والوفرة)",
 "ちょうごうざい": "خَلِيط",
 "ちょうさ": "تَحْقِيق / تْشَانْغ شَا, تْشَانْغْشَا",
 "ちょうさいん": "مُحَقِّق, مُحَقِّقَة (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ الَّذِي يُحَقِّقُ مَعَ الْمُتَّهَمِ فِي قَضِيَّةٍ لِلْكَشْفِ عَنْ مَجْرَيَاتِهَا)\nمثال: تحدث ياني مع محقق.",
 "ちょうさかん": "فاحص, مفتش (محقّق يراقب ويدقق بعناية) / مختبِر, ممتحِن (شخص يدير اختبارًا لتحديد مؤهلاتك)\nمثال: بحث الفاحص عن أدلة",
 "ちょうさけっか": "تَسَبَّب / نَتِيجَة",
 "ちょうさしぼうさん": "طويل السلسلة (للجزيئات التي تحتوي على سلاسل طويلة نسبياً من الذرات)",
 "ちょうさしょ": "نُسْخَة",
 "ちょうさひょう": "اِسْتِبَانَة",
 "ちょうさぶんせき": "تَشْخِيص",
 "ちょうさほうこく": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "ちょうさやく": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "ちょうさんかぶつ": "أَنْيُون السُّوبَر أُوكْسِيد, فَوْق أُكْسِيد / سوبر أكسيد",
 "ちょうさんりし": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "ちょうざいし": "موزع (حاوية مصممة بحيث يمكن استخدام المحتويات بكميات محددة) / صارف, موزّع (شخص يقوم بالتوزيع أو الصرف)",
 "ちょうざいしさい": "المُعَرِّف, كاهن الاعتراف (كاهن يستمع إلى الاعتراف ويمنح الغفران) / معترف (شخص يعترف (يكشف معلومات تضر بنفسه))",
 "ちょうざいやっきょく": "مستوصف (عيادة يتم فيها صرف الأدوية والمستلزمات الطبية)",
 "ちょうざめ": "حَفْش (دخل في شيءٍ بسرعة أو اقتحمَه بطريقة مفاجئة؛ عمل شيئًا بسرعة أو دون تدقيق)",
 "ちょうざん": "خَرِب, مُنْتَهٍ (أُوصِلَ إِلَى الخَرَاب) / خَرِب, مُدَمَّر (مُدمَّر جسدياً أو أخلاقياً) / مُنْتَهٍ, هَالِك (محكوم عليه بالفناء والزوال)",
 "ちょうし": "تَأْبِين, أُمْدُوحَة / ثَنَاء, أُمْدُوحَة / لَحْن (وضع الألحان أو التأليف الموسيقي؛ قرأ النص بلحن أو أداء صوتي مميز)\nمثال: أنا أحب هذا اللحن. / وَرِيد, عِرْق / شَرْط (شَرِطَ فلانٌ يَشْرِطِ شَرْطًا: وقع في أَمر عظيمٍ)\nمثال: صرخ ليون: \"شرطة!\" / دفعة, قوة دافعة مفاجئة (فعل تطبيق قوة فجأة) / اندفاع, حافز (قوة تحرك شيئاً ما للأمام)\nمثال: الدفعة المفاجئة أسقطته أرضاً / دورق, قنينة (زجاجة ذات سدادة؛ لتقديم النبيذ أو الماء) / مِلْقَط صَغِير, مِلْقَط / رِثَاء, مَرْثِيَة",
 "ちょうしがいい": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري) / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً)",
 "ちょうしがよい": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري) / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً)",
 "ちょうししゃ": "مُشَاهِد, مَشَاهِدَة",
 "ちょうしぜん": "تَنْجِيمِيَّة",
 "ちょうしぜんしゅぎ": "خَوَارِقِيَّة, فَوْق طَبِيعِيَّة (صفة كون الشيء منسوباً لقوة تبدو وكأنها تنتهك أو تتجاوز القوى الطبيعية) / الإيمان بالخوارق, غيبية (اعتقاد بوجود قوى تتجاوز الفهم البشري العادي)",
 "ちょうしぜんしゅぎしゃ": "خارقي, فوق طبيعي (متعلق بالاعتقاد بالخوارق (ما وراء الطبيعة))\nمثال: معتقدات خارقة للطبيعة",
 "ちょうしぜんてき": "خَارِق, مِيتَافِيزِيقِيّ (الشيء) / اِسْتِثْنَائِيّ\nمثال: ذلك خارق للعادة.",
 "ちょうしぜんろんしゃ": "خارقي, فوق طبيعي (متعلق بالاعتقاد بالخوارق (ما وراء الطبيعة))\nمثال: معتقدات خارقة للطبيعة",
 "ちょうしっかん": "اعتلال معوي (مرض يصيب القناة المعوية)",
 "ちょうしっぱずれ": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / تضارب, تنافر (خليط حاد ومزعج من الأصوات) / تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / خلاف, شقاق (عدم الاتفاق أو الانسجام)",
 "ちょうしつざい": "عامل تجفيف, مادة مجففة (مادة تعزز الجفاف (مثل أكسيد الكالسيوم الذي يمتص الماء ويستخدم لإزالة الرطوبة))",
 "ちょうしのいい": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري) / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً)",
 "ちょうしのよい": "فَصِيح, لَبِق (بارع في الإقناع بسلاسة الكلام) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط) / طَلِق اللِّسَان سَطْحِيًّا (يتّسم بافتقار العمق الفكري) / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً)",
 "ちょうしはずれ": "خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / تضارب, تنافر (خليط حاد ومزعج من الأصوات) / تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / خلاف, شقاق (عدم الاتفاق أو الانسجام)",
 "ちょうしぶえ": "أنبوب النغمة (أنبوب صغير يصدر نغمة بتردد قياسي؛ يستخدم لتحديد نغمة البداية للغناء غير المصحوب بآلات)",
 "ちょうしゃ": "جَاسُوس / تَجَسَّسَ / مُسْتَمِع, مُسْتَمِعَة",
 "ちょうしゃく": "طَوِيل",
 "ちょうしゅ": "سَمِيع (سَميع: (اسم)؛ سميع: (اسم)) / سَمْع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى)) / جَلْسَة\nمثال: سمع سامي صريرا. / اِسْتِمَاع",
 "ちょうしゅう": "مَجْمُوعَة, جَمْع (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس) / جَمْع (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: شكرا لإضافتي للمجموعة. / جُمْهُور, نَظَّارَة / تجنيد عام, نفير عام (فعل التجنيد في الخدمة العسكرية) / جباية, رسم مفروض (رسم يفرض ويحصل)",
 "ちょうしゅしゃ": "مُسْتَمِع, مُسْتَمِعَة",
 "ちょうしゅりつ": "جمهور المستمعين, مستمعون (جميع المستمعين لبرنامج إذاعي أو محطة معينة أو هيئة إذاعية بشكل جماعي)\nمثال: في عام 2012، زادت حصة مستمعي الراديو عبر الهواتف المحمولة بنسبة 10٪ مقارنة بعام 2009",
 "ちょうしゅん": "كركديه صيني, ورد صيني (شجيرة آسيوية كبيرة مبهرجة أو شجرة صغيرة ذات زهور حمراء إلى حمراء داكنة كبيرة مفردة أو مزدوجة) / ورد بنغالي, ورد صيني (ورد صيني شجيري؛ سلف العديد من ورود الحدائق المزروعة) / تْشَانْج شُون, تْشَانْجْشُون",
 "ちょうしゅんか": "كركديه صيني, ورد صيني (شجيرة آسيوية كبيرة مبهرجة أو شجرة صغيرة ذات زهور حمراء إلى حمراء داكنة كبيرة مفردة أو مزدوجة) / ورد بنغالي, ورد صيني (ورد صيني شجيري؛ سلف العديد من ورود الحدائق المزروعة)",
 "ちょうしょ": "بْرُوتُوكُول / تَخَصُّص, مَوْطِن قُوَّة (ميزة ذات قيمة أو فائدة خاصة)\nمثال: الطبخ هو نقطة قوته",
 "ちょうしょう": "صُور / تَهَكَّمَ, سَخِرَ (تَهَكَّمَ بِزمِيلِهِ أمَامَ النَّاسِ: اِسْتَهْزَأَ بِهِ، سَخِرَ مِنْهُ، زَرَى عَلَيْهِ، عَبَثَ بِهِ. تَهَكَّمَ صَاحِبَهُ) / دَعْوَة, عزيمة / إِغْرَاء / لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "ちょうしょく": "إِفْطَار, فَطُور / فَطَرَ ( مَا تَفَطَّر مِنَ النَّبَاتِ، والفُطْر جِنْسٌ مِنَ الكَمْءِ أَبيض عِظَامٌ لأَن الأَرض تَنْفطر عَنْهُ؛  في هو اسم يطلق على طائفة من اللازهريات خالية من الكلوروفيل منها فصائل وأَجناس وأَنواع عديدة وتسمى أيضًا فُطْريّات، منها ما يُؤْكَلُ، وما هو سامٌ…)\nمثال: وجدت بعض الفطر. / نَغْمَة, نَغْم",
 "ちょうしょくばん": "باليتة, لوحة ألوان (لوح يوفر سطحاً مستوياً يخلط عليه الفنانون الطلاء ومجموعة الألوان المستخدمة) / واقي الإبط (واحدة من الصفائح الدرعية المستديرة عند الإبطين في بدلة الدرع) / لوحة ألوان (نطاق الألوان المميز لفنان معين أو لوحة أو مدرسة فنية)",
 "ちょうしりつ": "تقدير, تقييم (فعل التأكد من أو تحديد قيمة أو جدوى شيء ما) / تثمين, تقدير (تقدير لقيمة شيء ما) / تصنيف, تقييم (المكانة أو الموقع على مقياس) / رتبة عسكرية (الرتبة في منظمة عسكرية)\nمثال: وضع تقييماً عالياً للصداقة",
 "ちょうしん": "عَقْرَب دَقَائِق / رجل حاشية (مرافق في بلاط الحاكم) / تَحْضِير, إِعْدَاد / تَسَمُّع (تَكَلَّفَ السمع)\nمثال: هل تسمع أي صوت؟",
 "ちょうしんき": "سَمَّاعَةُ الطَّبِيب, سَمَّاعَة",
 "ちょうしんぎん": "شِبْه دَائِم, طَوِيل الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة طَويلَة نِسْبِيًّا أَوْ مُمْتَدّ عَلَيْها)",
 "ちょうしんけい": "عصب دهليزي قوقعي, عصب سمعي (عصب حسي مركب يغذي الخلايا الشعرية للعضو الدهليزي والخلايا الشعرية للقوقعة)",
 "ちょうしんせい": "مُسْتَعِر أَعْظَم",
 "ちょうしんりがく": "باراسيكولوجيا, ظواهر نفسية خارقة (ظواهر تبدو وكأنها تتناقض مع القوانين الفيزيائية وتشير إلى إمكانية السببية عن طريق العمليات العقلية)",
 "ちょうしんるこつ": "تفكير شاق, كدح ذهني (تفكير شاق ومجهد) / دراسة مضنية, مؤلف متكلف (عمل أدبي رصين نتاج تفكير وجهد شاق)",
 "ちょうじ": "قَرَنْفُل / فَصّ / تَأْبِين, أُمْدُوحَة / ثَنَاء, أُمْدُوحَة / إيقاف, توقف (فعل إيقاف شيء ما) / انسداد, سدادة (عائق في أنبوب أو مجرى) / توقف, كبح (حالة عدم النشاط بعد انقطاع)\nمثال: إيقافه للتدفق أدى إلى فيضان / زَالَ (زَالَ يَزُولُ زَوَالاً، وزَوَلاَنًا: تحوَّلَ وانتقل؛ يقال: زَالَ من مكانه وعنه)\nمثال: توم لا زال يبكي / يُعَلِّق / تَعْلِيق / حَبِيب, حَبِيبَة / جَنَازَة, دَفْن (مراسم تقام لتشييع وفاة شخص)\nمثال: \"أنا ذاهب إلى جنازة.\" \"من توفي؟\"",
 "ちょうじあぶら": "زيت القرنفل (زيت عطري يتم الحصول عليه من القرنفل ويُستخدم لتنكيه الأدوية)",
 "ちょうじかん": "دهر, سنوات (فترة زمنية طويلة)\nمثال: نحن نعرف بعضنا منذ دهر / إصْلاحِيّ, تَهْذيبِيّ (يَهْدِف إلى الإصْلاح والتَّهْذيب) / إصلاحية, دار رعاية الأحداث (مؤسسة إصلاحية لاحتجاز وتأديب وتدريب الأحداث أو المجرمين لأول مرة)",
 "ちょうじが": "الْأَنَا الْعُلْيَا, الْأَنَا الْأَعْلَى",
 "ちょうじく": "المحور الأكبر (أطول محور للقطع الناقص أو المجسم الإهليلجي؛ يمر عبر البؤرتين)",
 "ちょうじゃ": "مِلْيُونِير / جَاسُوس / تَجَسَّسَ",
 "ちょうじゃく": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: العالم يتغير باستمرار / طَوِيل",
 "ちょうじゅ": "أقدمية, طول العمر (خاصية العيش طويلاً) / تعمير, طول الخدمة (مدة الخدمة أو البقاء)\nمثال: طول بقائها كنجمة / دَائِم, طَوِيل الأَمَد (مَوْجود مُنْذُ فَتْرَة طَويلَة وَيَسْتَمِرّ)",
 "ちょうじゅう": "اَلْحَيَاة اَلْبَرِّيَّة",
 "ちょうじゅうげんそ": "عنصر ما بعد اليورانيوم (أي عنصر له عدد ذري أكبر من 92 (وهو العدد الذري لليورانيوم)؛ وجميعها مشعة)",
 "ちょうじゅうせき": "اندخال, نمو خلالي ((علم الأحياء) نمو في مساحة سطح الخلية عن طريق ترسيب جزيئات جديدة بين الجزيئات الموجودة في جدار الخلية) / انخساف, انغماد (انطواء طبقة خارجية لتكوين جيب في السطح)\nمثال: انغماد الأريمة",
 "ちょうじゅうせきしょう": "اندخال, نمو خلالي ((علم الأحياء) نمو في مساحة سطح الخلية عن طريق ترسيب جزيئات جديدة بين الجزيئات الموجودة في جدار الخلية) / انخساف, انغماد (انطواء طبقة خارجية لتكوين جيب في السطح)\nمثال: انغماد الأريمة",
 "ちょうじゆ": "زيت القرنفل (زيت عطري يتم الحصول عليه من القرنفل ويُستخدم لتنكيه الأدوية)",
 "ちょうじょう": "تراكب, تطابق (وضع شيء فوق شيء آخر) / تطابق هندسي ((هندسة) وضع كائن بشكل مثالي في موضع آخر لإظهار أن الاثنين يتطابقان) / مبدأ التراكب, مبدأ التعاقب الطبقي ((جيولوجيا) المبدأ القائل بأنه في سلسلة من الصخور الرسوبية الطبقية، تكون الطبقة السفلى هي الأقدم) / تراكب, تطابق الطبقات ((في الجيولوجيا) ترسب طبقة جيولوجية فوق أخرى) / مُمْتَاز, فَاخِر / قِمَّة / سُور اَلصِّين اَلْعَظِيم",
 "ちょうじょうてき": "خَارِق, مِيتَافِيزِيقِيّ (الشيء) / اِسْتِثْنَائِيّ\nمثال: ذلك خارق للعادة.",
 "ちょうじり": "اِتِّسَاق",
 "ちょうじりがあう": "رَصِيد",
 "ちょうじる": "نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "ちょうじん": "مُبِيد, مُدَمِّر (يَتَسَبَّبُ أَوْ يَقْدِرُ عَلَى التَّدْمِيرِ الكَامِلِ) / سَاحِقٌ, مَاحِقٌ (يستخف بالآخرين ويحقرهم) / ذبول, ضمور (أي ضعف أو تدهور (خاصة بسبب عدم الاستخدام)) / سُوبَرْمَان / رجل خارق, نصف إله (شخص ذو قوى وقدرات عظيمة) / طَيَّار (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "ちょうじんてき": "خارق للبشر, فائق للطبيعة البشرية (فوق أو أبعد من البشر أو يتطلب قوة أو قدرة تحمل أكثر من البشرية)\nمثال: كائنات خارقة للبشر",
 "ちょうすう": "عَدَد زَوْجِيّ (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "ちょうすうがく": "ما وراء الرياضيات (التحليل المنطقي للاستدلال الرياضي)",
 "ちょうする": "نَدَبَ / جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / بَحَثَ, طَلَبَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث. / تَفَقُّد / كِشّ مَلِك / فَاتُورَة, حِسَاب / اِسْتَأْنَى, دَقَّقَ ((مُتَعَدٍّ بِالْبَاءِ أَوْ بِـ\"فِي\" أو بِدُونِهِمَا) تَأَنَّى، انْتَظَرَ) / كَشَّ / يَسْتَحْضِر, يَسْتَدْعِي",
 "ちょうずば": "مَغْسَلَة, حَوْض (مكان الغسل، لا تخلط بينها وبين مِغْسَلَة؛ حانوت يقوم بغسل وكيّ الملابس وغيرها من الستائر والبُسُط مقابل أجر)\nمثال: كان في المغسلة. / مِرْحَاض, تواليت",
 "ちょうずばち": "مَغْسَلَة, حَوْض (مكان الغسل، لا تخلط بينها وبين مِغْسَلَة؛ حانوت يقوم بغسل وكيّ الملابس وغيرها من الستائر والبُسُط مقابل أجر)\nمثال: كان في المغسلة.",
 "ちょうずる": "نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "ちょうせい": "ضَبْط / ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود) / مستلزمات, مقومات ((عادة بصيغة الجمع) المكونات اللازمة لصنع أو فعل شيء ما) / كَفَاءَة, مُؤَهِّل (سمة يجب الوفاء بها أو الامتثال لها وتجعل الشخص مناسباً لشيء ما)\nمثال: ابتكار الخطط / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / أقدمية, طول العمر (خاصية العيش طويلاً) / تعمير, طول الخدمة (مدة الخدمة أو البقاء)\nمثال: طول بقائها كنجمة / حياة أبدية, خلود (حياة بلا بداية أو نهاية) / سلم, مفتاح (أي من 24 سلماً دياتونياً كبيراً أو صغيراً توفر الإطار النغمي لمقطوعة موسيقية)",
 "ちょうせいかのう": "قَابِل لِلتَّعْدِيل, قَابِل لِلضَّبْط (يمكن تنظيمه أو ضبطه) / قَابِلٌ لِلتَّعْدِيل, قَابِلٌ لِلضَّبْط (يُمْكِنُ تَغْيِيرُهُ لِيُلَائِمَ أَوْ يُنَاسِبَ)",
 "ちょうせいざい": "مُسوي مطالبات, وكيل مطالبات (شخص يحقق في مطالبات التأمين أو المطالبات عن الأضرار ويوصي بتسوية فعالة)",
 "ちょうせいじょう": "خَارِق لِلْعَادَة, فَوْق طَبِيعِيّ (يتجاوز نطاق ما هو طبيعي أو قابل للتفسير علميًّا)",
 "ちょうせいち": "حوض احتباس (موقع تخزين مشابه لحوض الاحتجاز لكن المياه المخزنة تُمنع بشكل دائم من التدفق باتجاه المصب)",
 "ちょうせいやく": "مُنَسِّق / مُنَظِّم",
 "ちょうせき": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: العالم يتغير باستمرار / مَدّ وَجَزْر (جذب ومطل حتى يصبح أطول او اوسع؛ بسط ووسع)\nمثال: مد سامي يده لليلى. / فلسبار / حَصَاة مِعَوِيَّة (حصاة تحدث في الأمعاء)",
 "ちょうせぞくてき": "غَيْرُ دُنْيَوِيّ, غَيْرُ مُتَحَضِّر (لا يعرف طرق العالم ولا يملك خبرة فيها) / زاهد, غير دنيوي (غير معني بالعالم الدنيوي أو لا يتأثر بالاعتبارات الدنيوية)\nمثال: كان زاهداً ولم يفتقد المكافآت الدنيوية كثيراً",
 "ちょうせつ": "تَنْظِيم",
 "ちょうせついでんし": "جين تنظيمي (جين ينتج مادة كابتة تمنع الجين المشغل)",
 "ちょうせつき": "مُنَظِّم",
 "ちょうせつしょうがい": "إزعاج, اضطراب (فعل إزعاج شيء أو شخص ما؛ تحريك شيء ما) / شِجَار عَلَنِيّ, عِرَاك (قتال صاخب) / إزعاج, اضطراب (نشاط يمثل خللاً أو تطفلاً أو انقطاعاً) / تداخل, تشويش (نشاط كهربائي أو صوتي يمكن أن يزعج الاتصالات)\nمثال: مصطلح 'كرب' يعني درجة ما من الاضطراب والانزعاج العاطفي",
 "ちょうせん": "تَحَدٍّ, التَّحَدِّي / كُورْيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة) / كُورِيَا (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا. / خيط معوي, وتر جراحي (حبل قوي مصنوع من أمعاء الأغنام ويستخدم في الجراحة) / بازلاء حلوة برية, سذاب الماعز (شجيرة معمرة من شرق أمريكا الشمالية لها أوراق زغبية وزهور مصفرة ووردية؛ ومصدر للروتينون)",
 "ちょうせんあさがお": "تفاح شائك, داتورا (أي من عدة نباتات من جنس داتورا)",
 "ちょうせんあざみ": "أرضي شوكي, خرشوف (رأس زهرة يشبه الشوك بأوراق وقلب لحمي صالح للأكل) / أرضي شوكي, خرشوف (نبات متوسطي يشبه الشوك يزرع على نطاق واسع لرأسه الزهري الكبير الصالح للأكل)",
 "ちょうせんご": "كُورِيّ",
 "ちょうせんしゃ": "خصم, غريم (المتسابق الذي تأمل في هزيمته)\nمثال: كان يحترم خصومه",
 "ちょうせんじょう": "تَحَدٍّ, التَّحَدِّي",
 "ちょうせんたまいれ": "باتشينكو (لعبة بينبول يابانية تُلعب على لوحة عمودية)",
 "ちょうせんてき": "تَحَدٍّ, طَمُوح (يَتَطَلَّب اسْتِخْدَام كَامِل القُدُرَات أَوِ المَوَارِد) / مُثِير لِلاِهْتِمَام, مُلْفِت (مستفزّ بطريقة مُقْلِقة ومُحَيِّرة) / مُثِير لِلاهْتِمَام, مُحَفِّز لِلتَّفْكِير (يحفز الاهتمام أو التفكير العميق)",
 "ちょうせんはんとう": "شِبْه الْجَزِيرَةِ الْكُورِيَّة",
 "ちょうせんみんしゅしゅぎじんみんきょうわこく": "جُمْهُورِيَّة كُورِيَا اَلدِّيمُقْرَاطِيَّة اَلشَّعْبِيَّة",
 "ちょうせんもじ": "هَانْغُول",
 "ちょうせんもんじ": "هَانْغُول",
 "ちょうぜい": "تحصيل الضرائب, جباية الضرائب (جمع الضرائب)",
 "ちょうぜいり": "جابي الضرائب, محصل ضرائب (شخص يجمع الضرائب للحكومة)",
 "ちょうぜつ": "تسامي, تعالي (حالة التفوق أو التجاوز أو تخطي الحدود المعتادة) / تسام, تعال (حالة من الوجود فوق حدود التجربة المادية وخارجها) / بشدة, جداً (لدرجة قصوى) / فَائِق, فَوْقِيّ (يتجاوز فئة محدّدة ليشمل ما هو أوسع) / عَمْلَاق, فَائِق (كبير للغاية) / فَائِق, مُمْتَاز (من أعلى مستويات الجودة)\nمثال: بارد جداً",
 "ちょうぜつしゅぎ": "تسامي, فلسفة متعالية (أي نظام فلسفي يؤكد على الحدسي والروحي فوق التجريبي والمادي)",
 "ちょうぜつてき": "متسام",
 "ちょうぜん": "مُسْتَقِلّ, مُنْفَصِل (يستخدم للمباني؛ قائمة بمعزل عن غيرها) / غَيْرُ مُنْخَرِطٍ, مُنْفَصِلٌ عَاطِفِيًّا (يُظْهِرُ عَدَمَ انْخِرَاطٍ عَاطِفِيٍّ) / مَفْصُول, مُنْفَصِل (لَمْ يَعُدْ مُتَّصِلًا أَوْ مُلْتَحِمًا) / طَلِيق, مُنْفَصِل (غَيْر مُثَبَّت فِي مَوْضِعِه)\nمثال: منازل منفصلة / خَائِب الأَمَل",
 "ちょうそ": "نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب. / فن تشكيلي (فنون التشكيل أو النمذجة؛ النحت والحفر)",
 "ちょうそう": "دفن سماوي (طقس جنائزي تيبتي تقليدي تُعرض فيه الجثة في الهواء الطلق لتأكلها النسور المقدسة) / بايك, سمك الكراكي (أي من عدة أسماك صيد وغذاء ممدودة طويلة الخطم تعيش في المياه العذبة وتنتشر على نطاق واسع في الأجزاء الباردة من نصف الكرة الشمالي) / أوتوستراد, طريق سريع (طريق سريع عريض مصمم لحركة المرور عالية السرعة) / رمح (سلاح من العصور الوسطى يتكون من رأس رمح مثبت على عمود طويل؛ حل محله الحربة) / سنان (نقطة حادة (كما في نهاية الرمح))",
 "ちょうそくき": "مُحَافِظ, حَاكِم",
 "ちょうそじゅつ": "فن تشكيلي (فنون التشكيل أو النمذجة؛ النحت والحفر)",
 "ちょうぞう": "تِمْثال, دُمْيَة / تَأْسِيس / مُؤَسَّسَة",
 "ちょうぞく": "انعزال, تحفظ (الميل لكون المرء بعيداً وغير متعاطف في أسلوبه) / انعزال, ترفع (اللامبالاة عن طريق الانسحاب الشخصي)\nمثال: مسافة عاطفية",
 "ちょうたい": "حِزَام, زُنَّار (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر) / سَيْر (أسَارَ، أي جعله يَسِير والفرق بين الإثنين أن سَيَّرَ فيها تكرار وأسارَ لا تكرار فيها؛ فلان من بَلَده أو مَوْطِنه: أخْرَجَه وأجْلاه)\nمثال: هذا حزام من الجلد.",
 "ちょうたいこく": "قُوَى عُظْمَى",
 "ちょうたいさく": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ) / اِسْتِعْرَاضِيّ, مُبْهِر (مِنْ سِمَات العُرُوض أَوِ الدِّرَامَا) / دْرَامَاتِيكِيّ, مُثِير (مُذهل في المظهر أو مُشوّق في الأثر) / عرض ضخم (أداء منتج بشكل فخم)\nمثال: قدموا عرضاً ضخماً في عيد الميلاد",
 "ちょうたいしょうせい": "تتناظر فائق ((فيزياء) نظرية تحاول الربط بين القوى الأساسية الأربع)",
 "ちょうたいしょうりろん": "تتناظر فائق ((فيزياء) نظرية تحاول الربط بين القوى الأساسية الأربع)",
 "ちょうたつ": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تَوْرِيد, تَزْوِيد / ذَخِيرَة / طلاقة, فصاحة (جودة السهولة في الكلام والكتابة) / طلاقة (المهارة في التحدث أو الكتابة) / بيان, طلاقة (لغة قوية وفعالة)\nمثال: جذبت فصاحته حشداً كبيراً",
 "ちょうたつさき": "مُزَوِّد, مُزَوِّدَة",
 "ちょうたん": "طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "ちょうたんぱ": "تَرَدُّد عَالٍ جِدّاً (30 إلى 300 ميجاهرتز)",
 "ちょうだい": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / أَكْل (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ. / أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة! / جَلِيل, فَخْم (يُوصَف بِهِ مَظْهَر الشَّخْص أَوْ سُلُوكه؛ يَلِيق بِشَخْصٍ بَارِز) / فَخْم, كَبِير (الأكثر أهمّيّة وفخامة في الزخرفة) / طَمُوح, وَاسِع النِّطَاق (من السلوك المُثير للإعجاب والطموح في الحجم أو النطاق) / عَظِيم, فَخْم (كبير ومثير للإعجاب في الحجم المادي أو الامتداد)",
 "ちょうだいもの": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "ちょうだつ": "تسامي, تعالي (حالة التفوق أو التجاوز أو تخطي الحدود المعتادة) / تسام, تعال (حالة من الوجود فوق حدود التجربة المادية وخارجها)",
 "ちょうだん": "ارتداد, وثبة (ارتداد جانبي)",
 "ちょうちゃく": "جلد, ضرب (فعل إيقاع العقاب البدني بضربات متكررة) / سحق, هزيمة نكراء (هزيمة قوية)",
 "ちょうちょ": "فَرَاشَة, ابو دقيق (حشرة صغيرة رقيقة ذات أجنحة كبيرة قد تكون ملونة أو غير ملونة)\nمثال: آه ، هناك فراشة!",
 "ちょうちょう": "سلم كبير (سلم يعتمد انسجامه على السلم الكبير) / فَرَاشَة, ابو دقيق (حشرة صغيرة رقيقة ذات أجنحة كبيرة قد تكون ملونة أو غير ملونة)\nمثال: آه ، هناك فراشة! / مُتَصَادِم, مُتَنَافِر (متنافر بشكل حادّ وقاسٍ) / بِتَمَلُّق, بِلَبَاقَة مُصْطَنَعَة (بمعقولية سطحية)\nمثال: تحدث بطلاقة سطحية",
 "ちょうちょうはっし": "بِشَرَاسَة, بِضَرَاوَة (بطريقة شرسة جسدياً) / بِحِدَّة, بِعُنْف (بطريقة عنيفة عاطفياً)\nمثال: صمت كسره نباح الكلاب بشراسة",
 "ちょうちょうむすび": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "ちょうちょむすび": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "ちょうちょ結び": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "ちょうちん": "فانوس صيني (فانوس ورقي قابل للطي بألوان زاهية؛ يستخدم لأغراض الزينة)",
 "ちょうちんもち": "مُتَمَلِّق, مُداهِن (شخص يستخدم الإطراء والتملق)",
 "ちょうつがい": "مِقْبَض / مُشْتَرَك / مِفْصَل",
 "ちょうつけ": "مسك الدفاتر (نشاط تسجيل المعاملات التجارية) / مُحَاسِب, مُحَاسِبَة",
 "ちょうづけ": "تَرْقِيم, تَرْقِيم الصَّفَحَات (نظام ترقيم الصفحات) / مناداة (النداء على اسم شخص (خاصة بواسطة نظام مكبر الصوت))\nمثال: استخدم نظام الخطابة في المستشفى للمناداة / مسك الدفاتر (نشاط تسجيل المعاملات التجارية) / مُحَاسِب, مُحَاسِبَة",
 "ちょうづめ": "سُجُق, نَقَانِق",
 "ちょうづめきん": "بكتيريا التسمم الوشيقي, مِطَثِّيَّة وشيقية (بكتيريا لاهوائية تنتج الوشيقان (البوتولين)، وهو السم الذي يسبب التسمم الوشيقي)",
 "ちょうてい": "وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / وساطة (تفاوض لحل الخلافات يديره طرف محايد) / ترضية, مصالحة (فعل الترضية والتغلب على عدم الثقة والعداء) / توفيق, مصالحة (أي من أشكال الوساطة المختلفة التي يمكن من خلالها تسوية النزاعات قبل الوصول للتحكيم) / توفيق, مصالحة (حالة إظهار النوايا الحسنة والتعاون بعد التصالح)\nمثال: كانت هناك فترة وجيزة من المصالحة لكن القتال سرعان ما استؤنف / سفينة صيد, قارب صيد (سفينة للصيد؛ غالباً ما تحتوي على حوض لإبقاء الصيد حياً)",
 "ちょうていしゃ": "حَكَم, مُحكِّم (شخص يتم اختياره للحكم والبت في قضية متنازع عليها)\nمثال: اعتُبر الناقد حكماً للأدب الحديث",
 "ちょうてつ": "صَفَاء, نَقَاء (صفة الماء الصافي) / جَلَاء, صَفَاء (الخلو من الغموض وسهولة الفهم؛ قابلية التعبير الواضح للفهم)\nمثال: عندما استيقظت عاد الصفاء إلى عينيها",
 "ちょうてん": "يَافُوخ / قِمَّة / أَوْجٌ, ذُرْوَةٌ / شَحْطَة / شَرْطَة",
 "ちょうでんどう": "موصلية فائقة (اختفاء المقاومة الكهربائية عند درجات حرارة منخفضة جداً)",
 "ちょうとう": "تطاول الرأس (صفة تطاول الجمجمة أو الرأس (طول الرأس كبير بالنسبة لعرضه))",
 "ちょうとうは": "ثُنَائِيُّ الحِزْبِيَّة (مَدْعُومٌ مِنْ كِلَا الجَانِبَيْن)",
 "ちょうとつ": "تَحْرِير",
 "ちょうど": "بِالضَّبْط, تَمَامًا / بِالْضَبْط\nمثال: 私達はちょうど食事を終えた所です。 — لقد أنهينا أكل طعام الفطور للتو. / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل / أَثَاث, مَفْرُوشَات (الرياش والمتاع وما يوضع للاستخدام للجلوس أو النوم أو حفظ المتاع أو غيره داخل البيت أو خارجه؛ الرياش والمتاع بما فيها المال والملابس)\nمثال: يصنع قطعة أثاث خشبية. / قَوْس وَسَهْم / اِتِّسَاق",
 "ちょうどいい": "بالحرف, تماماً (في كل تفصيل)\nمثال: المنزل الجديد ناسبهم تماماً",
 "ちょうどいま": "آنِفاً",
 "ちょうどかちさい": "فارق ملحوظ بالكاد ((في الفيزياء النفسية) الفرق بين محفزين الذي يتم اكتشافه بنفس قدر عدم اكتشافه (تحت ظروف تجريبية مضبوطة))",
 "ちょうどきゅう": "دَرَجَة فَائِقَة",
 "ちょうどひん": "تأثيث (عملية تزويد منزل أو غرفة بالأثاث وغيرها من العناصر القابلة للإزالة مثل الرفوف والسجاد والأجهزة، إلخ) / أثاث منزلي, تجهيزات منزلية (الوسائل (الأثاث والأجهزة والملحقات المنقولة الأخرى بما في ذلك الستائر والسجاد) التي تجعل المنزل (أو أي منطقة أخرى) صالحة للعيش) / توابع ملابس, لوازم زينة ((عادة بصيغة الجمع) ملحقات الملابس الثانوية)",
 "ちょうどよい": "بالحرف, تماماً (في كل تفصيل)\nمثال: المنزل الجديد ناسبهم تماماً",
 "ちょうど今": "آنِفاً",
 "ちょうど良い": "بالحرف, تماماً (في كل تفصيل)\nمثال: المنزل الجديد ناسبهم تماماً",
 "ちょうな": "بلطة, فأس صغيرة (فأس صغيرة بمقبض قصير تستخدم بيد واحدة (عادة لقطع الحطب)) / توماهوك, فأس صغيرة (سلاح يتكون من فأس قتال؛ استخدمه هنود أمريكا الشمالية) / قَدُوم (قُدُوْم؛ قَدُوْم)\nمثال: بإمكانك القدوم معي.",
 "ちょうない": "جِوَار, قُرْب / حَيّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جِوَار\nمثال: ينبح كلب في الحي. / مَعَوِيّ",
 "ちょうないさいきんそう": "فلورا معوية, نبيت معوي (كائنات دقيقة غير ضارة (مثل الإشريكية القولونية) تستوطن القناة الهضمية وتعد ضرورية لأداء وظائفها الطبيعية)",
 "ちょうないせんじょう": "غسيل القولون (حقنة شرجية مائية تعطى لتنظيف القولون)",
 "ちょうないフローラ": "فلورا معوية, نبيت معوي (كائنات دقيقة غير ضارة (مثل الإشريكية القولونية) تستوطن القناة الهضمية وتعد ضرورية لأداء وظائفها الطبيعية)",
 "ちょうなんもう": "زُغابَة, زَغْبَة",
 "ちょうにく": "دجاج داجن (طائر داجن من الدجاجيات يعتقد أنه ينحدر من دجاج الأدغال الأحمر) / لحم دجاج, لحم طير (لحم طائر أو دجاجة (برية أو داجنة) يستخدم كطعام)",
 "ちょうにん": "أهل البلدة, سكان البلدة (الناس الذين يعيشون في بلدية أصغر من المدينة)\nمثال: هتفت البلدة بأكملها للفريق",
 "ちょうねじ": "صامولة فراشة, صامولة مجنحة (صامولة مسننة ذات نتوءات تشبه الأجنحة لتدويرها بالإبهام والسبابة) / جوز مجنح (جَوَّز لَهُمْ إِبِلَهم إِذا قَادَهَا بَعِيرًا بَعِيرًا حَتَّى تَجُوزَ)\nمثال: نريد أن نأكل نبات جوز الهند.",
 "ちょうねんてん": "انفتال (التواء غير طبيعي للأمعاء (عادة في منطقة اللفائفي أو القولون السيني) مما يؤدي إلى انسداد معوي)",
 "ちょうのうりょく": "إدراك خارج الحواس, استبصار (قوة ظاهرية لإدراك أشياء غير موجودة للحواس) / تحريك عن بعد, تحريك نفسي (القدرة على تحريك شيء ما عن طريق التفكير فيه دون تطبيق قوة فيزيائية)",
 "ちょうのすけそう": "أفنس الجبل, درياس ثماني البتلات (شجيرة زاحفة دائمة الخضرة بزهور بيضاء كبيرة؛ واسعة الانتشار في الأجزاء الشمالية من أوراسيا وأمريكا الشمالية)",
 "ちょうのつく": "بشدة, جداً (لدرجة قصوى) / بشكل كبير, جداً (إلى درجة أو مدى عال؛ بشكل إيجابي أو باحترام كبير)\nمثال: بارد جداً",
 "ちょうは": "موجة طويلة (موجة راديوية بطول موجي أطول من كيلومتر واحد (تردد أقل من 300 كيلو هرتز)) / مُتَوافِق, مُنْسَجِم (مُتَناغِم ومُتَّسِق في التَّوْليفَة الصَّوْتِيَّة) / تَوافُقِيّ, رَنّانِيّ (يَتَعَلَّق بِالتَّوافُقِيّات أو الرَّنين المُتَعاطِف) / توافقي, هارموني (مكون من أو متعلق بالتوافق (الهارموني) كتميز عن اللحن والإيقاع) / توافقي (مكون من أو متعلق بفرع الصوتيات الذي يدرس تركيب الأصوات الموسيقية)\nمثال: دقة التغيير التوافقي والنغمية",
 "ちょうはつ": "إِثَارَة, اِسْتِفْزَاز (إِثَارَة: يُجمع على إثارات)\nمثال: كف عن إثارة غضبي. / حراسة قضائية, مصادرة مؤقتة (الاستيلاء على ممتلكات تخص شخصاً آخر والاحتفاظ بها حتى تدفع الأرباح الطلب الذي تم الاستيلاء عليها من أجله) / طلب صرف, نموذج طلب رسمي (نموذج رسمي يتم فيه تقديم طلب (عادة لمواد أو إمدادات)) / اسْتِيلَاء, طَلَب رَسْمِيّ (طلب رسمي أو مطالبة، خاصة من قبل سلطة عسكرية أو عامة تستولي على شيء (عادة مؤقتاً) للاستخدام العسكري أو العام)\nمثال: أولاً عليك ملء طلب الصرف / تَجْنِيد إِجْبَارِيّ / حَلَاقَة",
 "ちょうはつてき": "مُسْتَفِز / إِيحَائِيّ, مُوحٍ (يميل إلى الإيحاء بشيء غير لائق أو فاحش) / إِيحَائِيّ, تَلْمِيحِيّ (يَمِيلُ إِلَى التَّلْمِيحِ أَوِ الإِيحَاء) / دَالّ, كَاشِف (يشير بوضوح أو يكشف؛ يُستخدَم عادة مع 'على')",
 "ちょうはん": "جِنَايَة / جانٍ, مجرم (شخص ارتكب جريمة أو تمت إدانته قانونياً بجريمة) / داحس, ماحس (عدوى قيحية في طرف إصبع اليد أو القدم في المنطقة المحيطة بالظفر)",
 "ちょうば": "اِسْتِقْبَال / اِسْتِقْبَال, حَفْلَة اِسْتِقْبَال / حصان القفز, حصان طويل (حصان جمباز بدون مقابض وبطرف ممدود؛ يستخدم طولياً للقفز) / تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "ちょうばいたい": "وسائط فائقة, وسائط متعددة تفاعلية (نظام وسائط متعددة يتم فيه ربط عناصر المعلومات ذات الصلة ويمكن تقديمها معاً)",
 "ちょうばえ": "ذبابة الرمل (أي من الذباب الصغير ثنائي الأجنحة المتنوع؛ يمكن للإناث الماصة للدماء نقل حمى ذباب الرمل وداء الليشمانيات)",
 "ちょうばく": "سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة أو منع أشعة الشمس)",
 "ちょうばじょう": "بادوك, مضمار الاستعراض (حظيرة يتم فيها إسراج خيول السباق واستعراضها قبل السباق)",
 "ちょうばつ": "تَرْتِيب, اِنْضِبَاط (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / نِظَام (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "ちょうばつてき": "تأديبي, عقابي (يفرض عقوبة)\nمثال: عدالة عقابية",
 "ちょうばつてきそんがいばいしょう": "تعويضات رادعة, تعويضات عقابية ((قانون) تعويض يزيد عن الأضرار الفعلية (شكل من أشكال العقاب الممنوح في حالات سوء السلوك المتعمد أو الخبيث))",
 "ちょうばん": "مِقْبَض",
 "ちょうび": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / خُرْطُوم",
 "ちょうびさい": "فَائِقُ الدِّقَّة (بَالِغُ الدِّقَّةِ أَوِ الرِّقَّةِ فِي القِيَاس)",
 "ちょうびるい": "خرطوميات (ثدييات عاشبة ضخمة لها أنياب وخرطوم طويل)",
 "ちょうふ": "أَلْصَقَ",
 "ちょうふく": "استنساخ, مضاعفة (فعل نسخ أو عمل نسخة (أو نسخ) من شيء ما) / تكرار, نسخة طبق الأصل (نسخة تتوافق مع الأصل تماماً)\nمثال: هذا النوع من الازدواجية هو هدر",
 "ちょうふくかんせん": "عدوى إضافية (عدوى تحدث أثناء العلاج من عدوى أخرى)",
 "ちょうふざい": "لصقة جلدية (لبادة لاصقة طبية توضع على الجلد لامتصاص جرعة دواء محددة زمنياً في مجرى الدم)",
 "ちょうふんせき": "جوانو, ذرق الطيور (فضلات الطيور البحرية؛ تستخدم كسماد)",
 "ちょうぶ": "هِكْتَار",
 "ちょうぶく": "رُقْيَة",
 "ちょうぶつ": "فيل أبيض (فيل هندي أمهق؛ نادر ومقدس أحياناً في شرق آسيا) / الفيل الأبيض (ممتلكات قيمة تكون تكاليف صيانتها باهظة للغاية)",
 "ちょうぶん": "تَأْبِين, أُمْدُوحَة / ثَنَاء, أُمْدُوحَة",
 "ちょうぶんめん": "هَايْبَرْتِكْسْت",
 "ちょうへい": "تَجْنِيد إِجْبَارِيّ",
 "ちょうへいきひしゃ": "متهرب من التجنيد (شخص يتم استدعاؤه للتجنيد ويرفض الخدمة بشكل غير قانوني)",
 "ちょうへいけんさ": "فَحْص طِبِّيّ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض)\nمثال: فحص الطبيب بطني.",
 "ちょうへいせい": "تَجْنِيد إِجْبَارِيّ",
 "ちょうへいせいど": "تَجْنِيد إِجْبَارِيّ",
 "ちょうへいそく": "انسداد معوي (انسداد الأمعاء (خاصة اللفائفي) الذي يمنع محتويات الأمعاء من المرور إلى الأمعاء السفلية)",
 "ちょうへいれい": "مُسْوَدَّة / تَجْنِيد / سَوَّدَ / جَنَّدَ (جَنَّدَ الجنودَ: جَمَعَهَا؛ جَنَّدَ فلانًا: صيَّره جنديّاً)",
 "ちょうへん": "مُسْتَجِدّ / رِوَايَة",
 "ちょうへんえいが": "فيلم رئيسي, فيلم روائي طويل (الفيلم الرئيسي (طويل) في برنامج دار سينما)\nمثال: الفيلم الرئيسي الليلة هو 'كازابلانكا'",
