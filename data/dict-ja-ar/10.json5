 "ため池": "حَوْض, جَابِيَة (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا.",
 "ため込む": "مخزون, مخزون احتياطي (كومة تخزين متراكمة للاستخدام المستقبلي)",
 "たもう": "مُشَعَّر / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف.",
 "たもうるい": "كثيرات الأشواك (ديدان حلقية بحرية بشكل رئيسي تمتلك كلا الجنسين ولها زوائد مزدوجة (نظائر الأرجل)…)",
 "たもくてき": "مُتَعَدِّدُ الأَغْرَاض (ذُو اسْتِخْدَامَاتٍ مُتَعَدِّدَة)",
 "たもちあい": "انْتِظَام, ثَبَات (صفة كون الشيء ثابتاً - منتظماً وغير متغير)\nمثال: وثق بثباتها الواضح في أنها ستفعل ما قالت",
 "たもちつづける": "حَافَظَ",
 "たもつ": "اِحْتَفَظَ, أَبْقَى / آخِر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه)\nمثال: أرني مثالا آخر.",
 "たもと": "كُمّ, رُدْن / قُرْب, جِوَار (أَدْنَى؛ قدَّرَ)\nمثال: جلست بالقرب منها.",
 "たもとをしぼる": "بَكَى, يَبْكِي (دَمَعَتْ عَيناهُ حزنا؛ بكى الْمَيِّت: رثاه)\nمثال: بكى زيري كثيرا.",
 "たもとをわかつ": "جُزْء, جُزَء\nمثال: في أي دور تسكن؟",
 "たもん": "تاون هاوس, منزل متلاصق (منزل هو واحد من صف من المنازل المتطابقة الواقعة جنباً إلى جنب وتشترك في جدران…)",
 "たや": "نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "たやす": "أَطْفَأَ",
 "たやすい": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "たゆう": "عَالِيّ الرُتْبَة",
 "たゆうもと": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير.",
 "たゆまない": "كَادِح, لَا يَكِلّ (يَتَّصِف بِالعَمَل الشَّاقّ وَالمُثَابَرَة)",
 "たゆまぬ": "ثابت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة. / دَؤُوب, مُثَابِر (يَتَّسِم بِالعِنَايَة وَالجُهْد المُتَوَاصِل)",
 "たゆみ": "باعث على الاسترخاء, مريح (يوفر راحة جسدية أو عقلية)\nمثال: قضت ليلة مريحة في المنزل",
 "たゆみない": "دَائِم, لَا يَنْقَطِع (غَيْرُ مُنْقَطِعٍ فِي الزَّمَنِ وَمُسْتَمِرٌّ إِلَى أَجَلٍ غَيْرِ مُسَمًّى)",
 "たゆむ": "أَرْخَى, حَلَّ",
 "たゆんたゆん": "حَيَوِيّ, مِقْدَام (يتميّز بالحركة النشطة والحيوية)",
 "たよう": "مُتَنَوِّع / انشغال, دبيب (حالة الوجود أو الظهور بمظهر المنشغل بنشاط ما)\nمثال: أظهروا كل نشاط مجموعة من القنادس",
 "たようか": "تَنْوِيع",
 "たようせい": "تَنَوُّع, تَعَدُّدِيَّة",
 "たようそにんしょう": "ماجستير الفنون الجميلة (درجة الماجستير في الفنون الجميلة)",
 "たようたい": "مُتَنَوِّع",
 "たようと": "مُتَعَدِّدُ الأَغْرَاض (ذُو اسْتِخْدَامَاتٍ مُتَعَدِّدَة)",
 "たよく": "جَشَع, طَمَع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع.",
 "たより": "أَخْبَار, أَنْبَاء (أنباء ما قد حدث؛ نشرة الأخبار أو عرض الأخبار: ما يعرضه التلفاز أو الراديو من…)\nمثال: هذه أخبار طيبة. / اتكال, اعتماد (يقين مبني على الخبرة السابقة)\nمثال: كتب الورقة مع اعتماد كبير على عمل علماء آخرين",
 "たよりがい": "اعتمادية, موثوقية (جودة كون الشخص أو الشيء جديراً بالاعتماد أو الثقة)",
 "たよりない": "غير موثوق, لا يعول عليه (لا يستحق الاعتماد أو الثقة)\nمثال: في أوائل الخمسينيات كانت الحواسيب كبيرة ومكلفة وغير موثوقة / عَاجِز / قَلِق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "たら": "تُدْمُر, تَدْمُر / قد المحيط الهادئ (يرتبط ارتباطاً وثيقاً بالقد الأطلسي) / إِنْ (يفيد التوكيد)\nمثال: إن شاء الله ؛ / لِمَ لَا (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "たらい": "بانيو, حوض استحمام (حاوية مفتوحة كبيرة نسبياً تملأ بالماء وتستخدم لغسل الجسم)\nمثال: حوض من الماء",
 "たらし": "إغواء (إغراء شخص ما بالانحراف عن السلوك القويم) / قَوْس, قوس / غارقاً في البلل, مبللاً تماماً (رطب للغاية)\nمثال: مبلل تماماً",
 "たらしこむ": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "たらしむ": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "たらしめる": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "たらし込む": "خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "たらじゅ": "تُدْمُر, تَدْمُر",
 "たらす": "رَاوَغ / عَلَّقَ / تَمَلَّقَ / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: هذه خدعة قديمة.",
 "たらず": "أَصْغَر مِن, صُغْرَى مِن / غير كافٍ, قاصر (كمية غير قادرة على تلبية حاجة أو متطلب)\nمثال: أموال غير كافية",
 "たらずまえ": "عَجْز",
 "たらたら": "غارقاً في البلل, مبللاً تماماً (رطب للغاية)\nمثال: مبلل تماماً / باستمرار, بشكل متواصل (بشكل ثابت لا يتغير)\nمثال: العالم يتغير باستمرار / ببطء, بكسل (بطريقة بطيئة)\nمثال: تصاعد الدخان ببطء",
 "たらちね": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "たらちめ": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "たらない": "غير كافٍ, قاصر (كمية غير قادرة على تلبية حاجة أو متطلب)\nمثال: أموال غير كافية / بَسِيط, سَاذَج (يفتقر إلى القدرة العقلية والفطنة)",
 "たらのき": "شجرة أنجليكا الأمريكية, عصا الشيطان (شجرة أو شجيرة نفضية صغيرة تشكل كتلاً في شرق الولايات المتحدة)",
 "たらの木": "شجرة أنجليكا الأمريكية, عصا الشيطان (شجرة أو شجيرة نفضية صغيرة تشكل كتلاً في شرق الولايات المتحدة)",
 "たらり": "غارقاً في البلل, مبللاً تماماً (رطب للغاية)\nمثال: مبلل تماماً / بارتخاء, بشكل فضفاض (مفتوح هيكلياً وغير مدمج أو مغلق)\nمثال: نسيج منسوج برخاوة",
 "たり": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "たりぃ": "مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "たりけり": "فعل مساعد (فعل يندمج مع فعل آخر في عبارة فعلية للمساعدة في تشكيل الزمن أو الصيغة أو البناء…)",
 "たりとも": "مُسَطَّح, مُنبَسِط\nمثال: انتظر حتى أجلس.",
 "たりない": "غير كافٍ, قاصر (كمية غير قادرة على تلبية حاجة أو متطلب)\nمثال: أموال غير كافية / بَسِيط, سَاذَج (يفتقر إلى القدرة العقلية والفطنة)",
 "たりる": "اِسْتَحَقَّ / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "たる": "اِسْتَحَقَّ / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / برميل (حاوية أسطوانية تحفظ السوائل)",
 "たるい": "بَلِيد, خَامِل (بطيء ولا مُبالٍ) / مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق)",
 "たるき": "رافدة سقف (واحدة من عدة عوارض مائلة متوازية تدعم السقف)",
 "たるたる": "مُتَدَلٍّ, مُتَهَدِّل (مُتَدَلٍّ إِلَى الأَسْفَلِ كَمَا مِنَ الإِرْهَاقِ أَوِ الضَّعْف)",
 "たるみ": "مُتَرَاخٍ, مُتَسَاهِل (يَفْتَقِر إِلَى الصَّرَامَة أَوِ الدِّقَّة)\nمثال: قام بسحب الجزء المرتخي / ثلامة, كليل (انعدام الحدة أو وضوح الحافة أو الطرف)\nمثال: ثلامة القلم الرصاص جعلت كتابته غير مقروءة / شَلَّال",
 "たるむ": "أَرْخَى, حَلَّ",
 "たるめる": "أَرْخَى, حَلَّ",
 "たる木": "رافدة سقف (واحدة من عدة عوارض مائلة متوازية تدعم السقف)",
 "たれ": "صَلْصَة, مَرَق / شَنْق (قتله بربط حبل حول رقبته وإسقاطه)\nمثال: شنق زيري نفسه فوق شجرة. / اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "たれかざり": "عِقْد, قِلَادَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "たれぎぬ": "سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة…)",
 "たれこみ": "رمية البداية (فعل بدء لعبة كرة السلة بكرة قفز)",
 "たれこむ": "بَلَّغَ, أَبْلَغَ",
 "たれさがる": "عَلِقَ, عِلِق\nمثال: شنق زيري نفسه فوق شجرة.",
 "たれさげる": "عَلِقَ, عِلِق\nمثال: شنق زيري نفسه فوق شجرة.",
 "たれしも": "الْجَمِيع, كُلّ شَخْص\nمثال: 誰しも礼儀正しい人が好きだ。 — كل الناس يحبون من يتعامل بلباقة. / أَحَد لَا (العدد وَاحِد؛ الوَاحِد من الشيء)\nمثال: لم يساعدني أحد.",
 "たれながし": "سَلَس ((سَلُسَ) يَسْلُسُ سَلاسَةً: لانَ وسَهُلَ وانقادَ، فهو سَلِيسٌ) / إطلاق نار (فعل إطلاق النار من بندقية)",
 "たれながす": "تَسَرُّب\nمثال: سرب الطيور ذلك جميل جدا. / مَزْبَلَة, نُفَايَة (موضع تجميع الأَزْبَال والتِفَايَات لحين نقلها؛ حَاوِيَة نفايات؛ موضع خارج…)\nمثال: وضع فاضل جثة دانية في مزبلة.",
 "たれびと": "الْجَمِيع, كُلّ شَخْص",
 "たれまく": "سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة…)",
 "たれみみ": "مُتَدَلِّي الأُذُنَيْن (له أذنان مُنحنيتان أو متدلّيتان)",
 "たれる": "عَلِقَ, عِلِق\nمثال: شنق زيري نفسه فوق شجرة. / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / قَطَر (في الشرق الأوسط. وتعرف رسميا بدولة قطر)\nمثال: كنت أسكن في قطر. / قَالَ, قال (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "たれ流し": "سَلَس ((سَلُسَ) يَسْلُسُ سَلاسَةً: لانَ وسَهُلَ وانقادَ، فهو سَلِيسٌ) / إطلاق نار (فعل إطلاق النار من بندقية)",
 "たろうせい": "مَدْرَسَة ثَانَوِيَّة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح…)\nمثال: لا أحب المدرسة.",
 "たわい": "رشاد, سلامة العقل (القوى الطبيعية أو السليمة للعقل) / سُكْرٌ (مادة غذائية حلوة تستخدم لتَحْلِيَة الطعام)\nمثال: حرمني من السكر.",
 "たわいない": "سَخِيف",
 "たわいのない": "سَخِيف",
 "たわいもない": "سَخِيف",
 "たわい無い": "سَخِيف",
 "たわけ": "حماقة, طيش (سلوك أحمق أو لا معنى له) / مُغَفَّل, أَحْمَق",
 "たわけもの": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "たわける": "دعابة, مزاح (نشاط يتميز بالمرح والفكاهة)\nمثال: روى نكتة مضحكة جداً",
 "たわけ者": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "たわこと": "هُرَاء, لَغْو",
 "たわごと": "هُرَاء, لَغْو",
 "たわし": "فرشاة فرك, فرشاة كشط (فرشاة ذات شعيرات قصيرة صلبة للتنظيف الشاق)",
 "たわみ": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "たわむ": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / يَئِسَ, أُحْبِطَ",
 "たわむる": "لهو, مرح (نشاط ترفيهي مبهج أو خفيف الظل للتسلية)\nمثال: كل ذلك تم من باب المزاح",
 "たわむれ": "لَعِبَ, لعب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس.",
 "たわむれごと": "مَقْلَب / طُرْفَة, نُكْتَة",
 "たわむれる": "لهو, مرح (نشاط ترفيهي مبهج أو خفيف الظل للتسلية)\nمثال: كل ذلك تم من باب المزاح",
 "たわめる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "たわやか": "مَرِن",
 "たわやめ": "حورية الهواء, سيلف (كائن عنصري يعتقد أنه يسكن الهواء)",
 "たわら": "كِيس",
 "たわわ": "مُتَدَلٍّ, مُتَهَدِّل (مُتَدَلٍّ إِلَى الأَسْفَلِ كَمَا مِنَ الإِرْهَاقِ أَوِ الضَّعْف)",
 "たん": "كَبِد, كِبْد / شَجَاعَة, جَسَارَة / بَلْغَم / طَمُعَ, طَمِعَ / تَنَهَّدَ / غَمّ, حُزْن / أَحَادِيّ\nمثال: رأيت واحدة مرة. / فردي (التنس التي تُلعب بشخص واحد في كل جانب) / خَطَأ (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة…)\nمثال: كان خطأ حاسوبي. / صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة)\nمثال: حصة صغيرة من الأرباح / قَصِير, قصير (ضد الطويل)\nمثال: حبل الكذب قصير. / مَنْشَأ / طَرَف / قِصَّة, حِكَايَة / زِنْجَفْر / إِكْسِير / إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله…)",
 "たんい": "وَحْدَة / اِئْتِمَان / صريح, قاطع (لا يقبل الشك أو سوء الفهم؛ له معنى أو تفسير واحد فقط ويؤدي إلى استنتاج واحد فقط)\nمثال: دليل قاطع",
 "たんいぎょうれつ": "مصفوفة الوحدة, مصفوفة محايدة (مصفوفة سلمية تكون فيها جميع العناصر القطرية مساوية للواحد)",
 "たんいけっか": "إثمار عذري ((علم النبات) تطور الثمرة دون إخصاب أو بذور)",
 "たんいけつじつ": "إثمار عذري ((علم النبات) تطور الثمرة دون إخصاب أو بذور)",
 "たんいげん": "تَطَابُق, عُنْصُر مُحَايِد (مؤثر يترك العنصر الذي يعمل عليه دون تغيير)\nمثال: المحايد في الضرب العددي هو 1",
 "たんいせいしょく": "توالد عذري (عملية تتطور فيها البويضة غير المخصبة إلى فرد جديد؛ شائعة بين الحشرات وبعض…)",
 "たんいせいど": "نظام النقاط (نظام للتقييم يعتمد على منح النقاط وفقًا لقواعد محددة)",
 "たんいつ": "أَحَادِيّ\nمثال: رأيت واحدة مرة.",
 "たんいつか": "تبسيط, تقليل (عملية تقليل التعقيد)",
 "たんいつきかい": "آلة بَسِيطة (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "たんいつげんご": "أُحَادِي اَللُّغَة",
 "たんいつさいばい": "زراعة أحادية (زراعة محصول واحد (في مزرعة أو منطقة أو بلد))",
 "たんいつしんきょう": "هينوثية",
 "たんいつせい": "مركزي, موحد (يتميز بـأو يشكل شكلاً من أشكال الحكم تكون فيه السلطة بيد سلطة مركزية واحدة)\nمثال: شكل موحد للحكومة في مقابل الشكل الفيدرالي",
 "たんいつぶんか": "زراعة أحادية (زراعة محصول واحد (في مزرعة أو منطقة أو بلد))",
 "たんいつめいれいそうさ": "تَدْرِيجِيًّا, خُطْوَة بِخُطْوَة (شيء واحد في كل مرة؛ على مراحل صغيرة)",
 "たんいぼう": "خلية الوحدة, وحدة الخلية (أصغر مجموعة من الذرات أو الجزيئات التي ينتج عن تكرارها بانتظام في ثلاثة أبعاد…)",
 "たんいりょうきんくいき": "مَا (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "たんいろん": "مشيئة واحدة, مونوثيلية (العقيدة اللاهوتية القائلة بأن المسيح كانت له مشيئة واحدة فقط على الرغم من أن له…)",
 "たんお": "جَشَع, طَمَع (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: كان مارك يميل للجشع.",
 "たんおう": "صفار البيض, مح (الجزء الكروي الأصفر من البيضة الذي يحيط به الزلال)",
 "たんおうしょく": "أصفر شاحب, تِبنِي (صبغة صفراء متغيرة؛ أصفر باهت، غالباً ما يكون مخففاً بالأبيض)",
 "たんおうりょくしょく": "فُسْتُق, فُسْتُق حَلَبِيّ",
 "たんおん": "كلمة أحادية المقطع (كلمة أو لفظ يتكون من مقطع واحد) / أُحَادِيُّ النَّغْمَة, رَتِيب (يُنْطَقُ أَوْ يُسْمَعُ بِنَغْمَةٍ ثَابِتَةٍ لَا تَتَفَاوَتُ فِي الطَّبَقَة)",
 "たんおんかい": "سلم المينور, سلم صغير (سلم دياتوني تفصل بين نغماته نغمات كاملة باستثناء بين الثانية والثالثة والخامسة…)",
 "たんおんがく": "أحادية الصوت, موسيقى أحادية الصوت (موسيقى تتكون من خط صوتي واحد (عادة مع مرافقة))",
 "たんおんせつ": "أُحَادِيّ المَقْطَع",
 "たんおんせつご": "كلمة أحادية المقطع (كلمة أو لفظ يتكون من مقطع واحد)",
 "たんか": "تكلفة الوحدة (التكلفة المحسوبة لوحدة معينة من المنتج) / نَقَّالَة, مِحَفَّة / تفحيم, كربنة (التقطير الإتلافي للفحم (كما في أفران فحم الكوك)) / شعب تانكا (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه…)\nمثال: الجيش يوحد الشعب. / بَالَاد / ثمرة بسيطة, عنبة (فاكهة غير متفتحة مشتقة من مبيض واحد تحتوي على بذرة واحدة أو عدة بذور داخل جدار…)",
 "たんかい": "صراحة (سمة كون المرء صريحاً ومباشراً)",
 "たんかいとう": "كشاف ضوئي (مصدر ضوء بعاكسات يسقط شعاعاً من الضوء في اتجاه معين)",
 "たんかか": "ثمرة بسيطة, عنبة (فاكهة غير متفتحة مشتقة من مبيض واحد تحتوي على بذرة واحدة أو عدة بذور داخل جدار…)",
 "たんかきごう": "آت",
 "たんかくぎゅう": "دورهام, شورت هورن (سلالة إنجليزية من الماشية قصيرة القرون)",
 "たんかけいそ": "كربيد السيليكون",
 "たんかすいそ": "هيدروكربون (مركب عضوي يحتوي فقط على الكربون والهيدروجين)",
 "たんかっしょく": "بني فاتح (بني فاتح ولكنه غير مشبع)",
 "たんかぶつ": "كربيد (مركب ثنائي للكربون مع عنصر أكثر إيجابية كهربائية)",
 "たんかん": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق. / قَصِير الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة مَحْدودَة أَوْ مُمْتَدّ عَلَيْها) / مُسْتَقِل, حُرّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن. / قَنَاة صَفْرَاء / قَصِيرُ السَّاق (وَصْفٌ لِلنَّبَاتَاتِ ذَاتِ السِّيقَانِ القَصِيرَةِ نِسْبِيًّا)",
 "たんかんえん": "التهاب الأقنية الصفراوية (التهاب القنوات الصفراوية)",
 "たんかんがん": "قَنَاة صَفْرَاء",
 "たんかカルシウム": "كربيد الكالسيوم",
 "たんかケイそ": "كربيد السيليكون",
 "たんかチタン": "تشنج لاإرادي, عرة (ارتعاش موضعي ومعتاد خاصة في الوجه)",
 "たんが": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "たんがら": "جَمْرُ مُنْطَفِيّ ((جمر) الْفرس جمرا وثب فِي الْقَيْد وَفُلَانًا أعطَاهُ جمرا ونحاه؛ جَمَرَ:…)\nمثال: أنا أنتظر قرارك على أحر من الجمر.",
 "たんがん": "عين بسيطة, عيينة (عين لها عدسة واحدة) / استجداء, توسل (طلب جاد أو عاجل)\nمثال: مناشدة لوقف القتال / اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر)\nمثال: شعرت بالخجل و احمر وجهها.",
 "たんがんきょう": "نظارة أحادية (عدسة لتصحيح الرؤية المعيبة في عين واحدة؛ تثبت في مكانها بواسطة عضلات الوجه)",
 "たんがんしょ": "عَرِيضَة, طَلَب",
 "たんがんしょう": "أحادية العين, تصقلب (شذوذ في النمو يوجد فيه عين واحدة فقط)",
 "たんがんてき": "ضَيِّق الأُفُق (يفتقر إلى التسامح أو المرونة أو اتساع الرؤية)\nمثال: قاضٍ لامع ولكنه ضيق الأفق",
 "たんき": "قَصِير الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة مَحْدودَة أَوْ مُمْتَدّ عَلَيْها) / حدة الطبع, سرعة الغضب (شعور بالغضب الممتزج بالاستياء) / شَجَاعَة, جَسَارَة",
 "たんきかしつけ": "قَصِير الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة مَحْدودَة أَوْ مُمْتَدّ عَلَيْها)",
 "たんきかりいれきん": "قَصِير الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة مَحْدودَة أَوْ مُمْتَدّ عَلَيْها)",
 "たんきかんじゅう": "بندقية رشاشة, المسدس الرشاش (أنبوب لاطلاق الرصاص، وتعتبر من الأسلحة؛ الْبُنْدُقِيََة: فِي إِيطَالْيَا)\nمثال: البندقية مدينة جميلة.",
 "たんききおく": "ذاكرة فورية, ذاكرة قصيرة المدى (ما يمكنك تكراره فوراً بعد إدراكه)",
 "たんききんり": "قَصِير الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة مَحْدودَة أَوْ مُمْتَدّ عَلَيْها)",
 "たんきけいかく": "قَصِير الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة مَحْدودَة أَوْ مُمْتَدّ عَلَيْها)",
 "たんきこくさい": "أذونات الخزانة (التزام قصير الأجل لا يحمل فائدة (يتم شراؤه بخصم)؛ يمكن تداوله على أساس الخصم…)",
 "たんきしゅうちゅうこうざ": "حَلَقَة دِرَاسِيَّة مُكَثِّفَة",
 "たんきたいざい": "قَصِير الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة مَحْدودَة أَوْ مُمْتَدّ عَلَيْها)",
 "たんきだいがく": "كلية متوسطة, كلية مجتمع (كلية تقدم فقط السنتين الأوليين وتنتهي بدرجة مشارك)",
 "たんきだいがくぶ": "كلية متوسطة, كلية مجتمع (كلية تقدم فقط السنتين الأوليين وتنتهي بدرجة مشارك)",
 "たんきてがた": "قَصِير الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة مَحْدودَة أَوْ مُمْتَدّ عَلَيْها)",
 "たんきてき": "قَصِير الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة مَحْدودَة أَوْ مُمْتَدّ عَلَيْها)",
 "たんきてつどう": "قطار أحادي الخط, مونوريل (سكة حديد لها مسار واحد)",
 "たんきはそんき": "فِي الْعَجَلَة اَلنَّدَامَة, العجلة من الشيطان (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "たんきゃくるい": "مزدوجات الأرجل (نوع من القشريات لينة الدرقة)",
 "たんきゅう": "طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا. / بَحْث, تَحْقِيق (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: بدأ زيري البحث. / خلية وحيدة, كريّة وحيدة (نوع من خلايا الدم البيضاء المحببة تعمل على ابتلاع البكتيريا)",
 "たんきゅうしゃ": "خنفساء البحث (خنفساء كبيرة زرقاء مخضرة معدنية تفترس اليرقات؛ توجد في أمريكا الشمالية)\nمثال: إنهم باحثون عن الحقيقة / مُحَقِّق, مُحَقِّقَة (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ…)\nمثال: تحدث ياني مع محقق.",
 "たんきゅうるい": "مدموجة الأقواس (زاحف منقرض له زوج واحد من الفتحات الصدغية الجانبية في الجمجمة)",
 "たんきょく": "فِي مَرْحَلَة مُتَأَخِّرَة, نِهَائِيّ (يُسَبِّب أَوْ يَنْتَهِي بِالمَوْت أَوْ يَقْتَرِب مِنْه)\nمثال: العمود الطرفي",
 "たんきょくせい": "أحادي القطب (له قطب واحد)",
 "たんきょくせいうつびょう": "اكتئاب أحادي القطب (نوبة اكتئاب كبرى تحدث دون مرحلة الهوس التي تحدث في الشكل الكلاسيكي للاضطراب…)",
 "たんきょりきょうそう": "ركض سريع, عدو سريع (جري سريع)",
 "たんきょりそう": "ركض سريع, عدو سريع (جري سريع)",
 "たんきょりだんどうミサイル": "قَصِير المَدَى (مَحْدود بِمَسافات قَصيرَة)",
 "たんきよほう": "قَصِير المَدَى (مَحْدود بِمَسافات قَصيرَة)",
 "たんきん": "دك, طرق (فعل الطرق (توجيه ضربات ثقيلة متكررة))\nمثال: فاجأه طرق القبضات المفاجئ",
 "たんきローン": "قَصِير الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة مَحْدودَة أَوْ مُمْتَدّ عَلَيْها)",
 "たんくつ": "توقع, احتمال",
 "たんぐつ": "محل, مكان (وضع معين)\nمثال: لو كنت مكاني ماذا كنت ستفعل؟",
 "たんけい": "أحادي النمط (يتكون من نوع (نمط) واحد فقط)",
 "たんけん": "خَنْجَر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين) / عَقْرَب سَاعَات / اِسْتِكْشَاف",
 "たんけんか": "مُسْتَكْشِف",
 "たんけんしゃ": "مُسْتَكْشِف",
 "たんげい": "فَرَضِيَّة, اِفْتِرَاض (مؤنث الفَرَضِيّ، وهو المنسوب إلى الفَرَض؛ الفَرَض، ما يُفْتَرَض من الأمور، خلاف…)\nمثال: الحقائق تؤكد هذه الفرضية.",
 "たんげいすべからざる": "غامِض, غَلِق",
 "たんげん": "وَحْدَة",
 "たんこう": "مُبَسَّط (دَرْسٌ مُبَسَّطٌ : سَهْلٌ، وَاضِحٌ)\nمثال: هذا الكتاب مؤلف بلغة إنجليزية مبسطة و هو سهل للقراءة. / منجم فحم (منجم يُستخرج منه الفحم من الأرض) / أصفر شاحب, تِبنِي (صبغة صفراء متغيرة؛ أصفر باهت، غالباً ما يكون مخففاً بالأبيض) / صفار البيض, مح (الجزء الكروي الأصفر من البيضة الذي يحيط به الزلال) / وَرْدِيّ, زَهْرِيّ (هُو ما كان بِلَوْنِ الورد؛ ٌ إِلَىٰ ٱلْوَرْدِ)\nمثال: لا أظن أن توم سيشتري مظلة وردية. / أَحْمَر, حُمْرَة (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون…)\nمثال: أردت حذاء أحمر.",
 "たんこうえんざん": "عملية أحادية (عملية ذات معامل واحد بالضبط)",
 "たんこうしょ": "دراسة مفردة, مونوجراف (أطروحة مفصلة وموثقة حول موضوع معين)",
 "たんこうしょく": "أصفر شاحب, تِبنِي (صبغة صفراء متغيرة؛ أصفر باهت، غالباً ما يكون مخففاً بالأبيض) / وَرْدِيّ, زَهْرِيّ (هُو ما كان بِلَوْنِ الورد؛ ٌ إِلَىٰ ٱلْوَرْدِ)\nمثال: لا أظن أن توم سيشتري مظلة وردية.",
 "たんこうのうりょく": "صلاحية للإبحار (اللياقة لعبور البحار)",
 "たんこうふ": "عامل منجم فحم (شخص يعمل في منجم فحم)",
 "たんこうりょくしょく": "فُسْتُق, فُسْتُق حَلَبِيّ",
 "たんこうるい": "كظاميات (أكثر الثدييات بدائية وتضم الأعضاء الحية الوحيدة من طائفة الوحشيات الأولية)",
 "たんこうろうどうしゃ": "عامل منجم فحم (شخص يعمل في منجم فحم)",
 "たんこぶ": "خبطة, ضربة (ارتطام (كما هو الحال في التصادم))\nمثال: الخبطة ألقته عن الدراجة",
 "たんこん": "زواج أحادي (ممارسة أو حالة وجود زوج واحد فقط في المرة الواحدة)",
 "たんご": "كَلِمَة, كَلَام (الكلِمَةُ : اللفظةُ الدَّالةُ على معنًى مُفْرَد بالوضع، وتكون؛ الكلِمَةُ:…)\nمثال: كلمة السر طويلة. / تَانْغُو",
 "たんごへん": "مَسْرَد",
 "たんごもじ": "رمز لفظي, لوغوغراف (رمز مكتوب واحد يمثل كلمة أو عبارة كاملة دون الإشارة إلى نطقها)",
 "たんさ": "مِسْبَار",
 "たんさいが": "رسم بالغسل, غسل (لوحة مائية مصنوعة من خلال تطبيق سلسلة من الغسلات أحادية اللون واحدة فوق الأخرى)",
 "たんさいぼう": "بَسِيط, سَاذَج (يفتقر إلى القدرة العقلية والفطنة)",
 "たんさいぼうせいぶつ": "أُحَادِيّ الخَلِيَّة (ذو خليّة واحدة (وبالتالي غير منقسم إلى خلايا))",
 "たんさき": "مِسْبَار",
 "たんさく": "طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا.",
 "たんさくしゃ": "مُحَقِّق, مُحَقِّقَة (من يُجري تحقيق وتحرِّيات للكشف عن ملابسات قضيَّة غامضة؛ قَاضِي التَّحْقِيقِ…)\nمثال: تحدث ياني مع محقق.",
 "たんさくはんしゃ": "منعكس البحث عن الثدي, منعكس التجذير (منعكس يتكون من إدارة الرأس وحركات المص التي تثار عند الرضيع الطبيعي عن طريق لمس…)",
 "たんさん": "حمض الكربوتيك (حمض ضعيف يعرف فقط في المحلول؛ يتكون عندما يتحد ثاني أكسيد الكربون مع الماء) / مِيَّاه غَازِيَّة, مَاء اَلصُّودَا / صُودَا الْخَبْز / نقابة صناعية (نقابة عمالية تقبل جميع العمال في صناعة معينة بغض النظر عن حرفتهم)",
 "たんさんいんりょう": "صُودَا, كَرْبُونَات اَلصُّودْيُوم",
 "たんさんえん": "كربونات",
 "たんさんし": "ورق كربون (ورق رقيق مطلي من جانب واحد بمادة شمعية داكنة (تحتوي غالباً على الكربون)؛ يستخدم…)",
 "たんさんすい": "مِيَّاه غَازِيَّة, مَاء اَلصُّودَا",
 "たんさんすいそえん": "بيكربونات, كربونات الهيدروجين",
 "たんさんすいそナトリウム": "بيكربونات الصودا, صودا الخبز",
 "たんさんなまり": "أبيض الرصاص (خضاب أبيض سام يحتوي على الرصاص)",
 "たんさんアンモニウム": "كربونات الأمونيوم (كربونات الأمونيوم؛ تستخدم في تصنيع أملاح الشم ومسحوق الخبز ومركبات الأمونيوم)",
 "たんさんカリウム": "كربونات البوتاسيوم",
 "たんさんカルシウム": "كربونات الكالسيوم (ملح يوجد في الطبيعة كطباشير أو كالسيت أو أراجونيت أو حجر جيري)",
 "たんさんガス": "ثاني أكسيد الكربون (غاز ثقيل عديم الرائحة واللون يتكون أثناء التنفس وعن طريق تحلل المواد العضوية…)",
 "たんさんソーダ": "صودا الغسيل, كربونات الصوديوم (ملح صوديوم لحمض الكربوتيك؛ يستخدم في صناعة مساحيق الصابون والزجاج والورق)",
 "たんさんナトリウム": "صودا الغسيل, كربونات الصوديوم (ملح صوديوم لحمض الكربوتيك؛ يستخدم في صناعة مساحيق الصابون والزجاج والورق)",
 "たんさんマグネシウム": "كربونات المغنيسيوم (ملح بلوري ناصع البياض يوجد طبيعياً كمغنسيت أو كدولوميت)",
 "たんし": "فِي مَرْحَلَة مُتَأَخِّرَة, نِهَائِيّ (يُسَبِّب أَوْ يَنْتَهِي بِالمَوْت أَوْ يَقْتَرِب مِنْه)\nمثال: العمود الطرفي / دَبُّوس / مِينَاء, مينا / قَصِير الأَمَد (مُتَعَلِّق بِفَتْرَة زَمَنِيَّة مَحْدودَة أَوْ مُمْتَدّ عَلَيْها) / أحادي الخلية, مونا ((في الأحياء) كائن دقيق وحيد الخلية (خاصة الأوالي السوطية)) / بالاد, قصيدة ثلاثية المقاطع / عَزْم / نَقْد, اِنْتِقَاد",
 "たんしあい": "فردي (التنس التي تُلعب بشخص واحد في كل جانب)",
 "たんしき": "دعامة (بنية صغيرة على شكل هراوة تحمل عادةً أربعة أبواغ دعامية في نهايات نتوءات دقيقة…)",
 "たんしきぼき": "قيد مفرد (نظام مسك دفاتر بسيط؛ يتم إدخال المعاملات في حساب واحد فقط)",
 "たんしきょく": "بالاد, قصيدة ثلاثية المقاطع",
 "たんしきん": "دِعَامِيّ",
 "たんしきんるい": "دِعَامِيّ",
 "たんししょう": "قصر الأصابع (قصر غير طبيعي في أصابع اليدين والقدمين)",
 "たんししょく": "لَيْلَك",
 "たんしゃ": "زِنْجَفْر / حُقْنَة, حَقْن / ثنائي العجلات, ذو عجلتين (متعلق بالمركبات ذات العجلتين)\nمثال: عربة ذات عجلتين",
 "たんしゅ": "زِنْجَفْر",
 "たんしゅく": "تقصير (عملية الإنقاص في الطول)\nمثال: الفستان يحتاج إلى تقصير",
 "たんしゅくけい": "انكماش, تقلص (عملية إنقاص (شيء ما) في الحجم أو الكثافة أو الكمية أو النطاق)\nمثال: تقلص الغاز عند التبريد",
 "たんしょ": "خَلَل, عَيْب (أدخل شيئًا بين آخر؛ جعل شيئًا يتخلل شيئًا آخر) / نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم. / توطئة, ديباجة (مقال تمهيدي قصير يسبق نص كتاب) / إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية)",
 "たんしょう": "زِيَارَة مَعَالِم اَلْمَدِينَة, سِيَاحَة / إِعْجَاب / مُفْرَد ((في النحو) يصف شيئًا أو شخصًا واحدًا فقط؛ كَلِمَة)",
 "たんしょうとう": "كشاف ضوئي (مصدر ضوء بعاكسات يسقط شعاعاً من الضوء في اتجاه معين)",
 "たんしょく": "أُحَادِيّ اللَّوْن (ذو لون واحد فقط أو يبدو كذلك)",
 "たんしよう": "أحادي الفلقة, نبات ذو فلقة واحدة (نبات زهري أحادي الفلقة؛ ينمو الساق عن طريق تراكمات في داخله)",
 "たんしようしょくぶつ": "أحادي الفلقة, نبات ذو فلقة واحدة (نبات زهري أحادي الفلقة؛ ينمو الساق عن طريق تراكمات في داخله)",
 "たんしん": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله…) / وَحِيد, مُنْفَرِد / عَقْرَب سَاعَات / عِيد مِيلَاد\nمثال: طقس اليوم جميل. / مِسْبَار / أزيز, رنين (صوت رنان حاد عالي النبرة (كما في صدى السونار أو رصاصة تضرب المعدن))",
 "たんしんぎ": "سُونار",
 "たんしんしゃ": "أَعْزَب, عَازِب",
 "たんしんじゅう": "أحادي الماسورة (له ماسورة واحدة)\nمثال: معظم البنادق أحادية الماسورة",
 "たんしんどう": "حركة توافقية بسيطة (حركة دورية تتناسب فيها قوة الاستعادة مع الإزاحة)",
 "たんじ": "بحث عن الطعام (فعل البحث عن الطعام والمؤن) / دَعَمَ, دَعَّمَ (• دَعَمَهُ، كمنَعهُ: مالَ فأقامَهُ)\nمثال: ياني هنا لدعم ريمة. / عَزْم / نَقْد, اِنْتِقَاد",
 "たんじく": "المحور الأصغر (المحور الأقصر أو الأقصر للقطع الناقص أو المجسم الإهليلجي)",
 "たんじつ": "غَدًا, الْغَد (اليومُ الذي يأْتي بعدَ اليوم الحالي، اليوم التالي؛ قد يراد به القريب من الزمان)\nمثال: لربما تمطر غدا.",
 "たんじゅう": "مُسَدَّس (اسم مفعول من سَدَّسَ؛ في : شَكْل هندسي مُسَطَّح له سِتَّة أضلاع متساوية فإن لم…)\nمثال: كان عند زيري مسدس. / صَفْرَاء (مؤنث أَصْفَر؛ صفة ما كان لونها الصفار؛ الغُدّة الصفراء: غدة في الكبد، تسمى أيضا…)\nمثال: هذه وردة صفراء.",
 "たんじゅうさん": "حمض الصفراء (أي من الأحماض الستيرويدية التي تتولد في الكبد وتخزن مع الصفراء)",
 "たんじゅうじん": "خط القتال (خط تشكله القوات أو السفن المستعدة لشن هجوم أو تلقيه)",
 "たんじゅうれつ": "رتل, طابور فردي (خط من الأشخاص أو الأشياء مرتبة واحداً خلف الآخر)",
 "たんじゅん": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
