 "工員": "عامل مصنع (عامل في طاحونة أو مصنع)",
 "工場": "مَصْنَع, مَعْمَل (مكان أو مبنى تمارس فيه الصناعة)\nمثال: عاد إلى المصنع.",
 "工場労働者": "عامل مصنع (عامل في طاحونة أو مصنع)",
 "工場団地": "مجمع صناعي, منطقة صناعية (قطعة أرض بعيدة عن مركز المدينة مصممة لتضم مجموعة من الشركات والمصانع)",
 "工場実習": "قُنّ, خُمّ (تتبع الأخبار؛ تفقَّد بالبصر)",
 "工場式畜産": "تجارة زراعية, مزرعة صناعية (مؤسسة زراعية واسعة النطاق)",
 "工場式農場": "تجارة زراعية, مزرعة صناعية (مؤسسة زراعية واسعة النطاق)",
 "工場従業員": "عامل مصنع (عامل في طاحونة أو مصنع)",
 "工場閉鎖": "إغلاق (إجراء إداري لمقاومة مطالب الموظفين؛ بمنعهم من دخول مكان العمل حتى يوافقوا على الشروط)",
 "工場飼育": "تجارة زراعية, مزرعة صناعية (مؤسسة زراعية واسعة النطاق)",
 "工夫": "ابتكار, تشكيل (الفعل الذي ينتج عنه ظهور شيء ما إلى الوجود)\nمثال: ابتكار الخطط / أَدَاة, جِهَاز / شغيل, عامل يدوي (شخص يعمل بيديه؛ شخص يعمل في العمالة اليدوية)",
 "工学": "هَنْدَسَة (الحدُّ والقياس؛ في الرياضيات: هي العلم الذي يبحث في الأشكال وعلاقاتها من حيث الخطوط والأبعاد والسطوح وغيرها)\nمثال: هو ضليع في علم الهندسة .",
 "工学者": "مُهَنْدِس, مُهَنْدِسَة (الذي يمارس مهنة الهَنْدَسَة)\nمثال: أبي مهندس مدني.",
 "工廠": "تِرْسَانَة",
 "工房": "مَشْغَل, وَرْشَة",
 "工手": "عَامِل, شَغِّيل (الذي يَعْمَل أو الذي عَمِلَ؛ هو الذي وَلاه السُلْطَان على أمر من أمور الدولة. الجمع عمَال)\nمثال: توم عامل نفايات.",
 "工数": "حمل العمل, عبء العمل (العمل الذي يُتوقع من الشخص القيام به في وقت محدد)",
 "工料": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي",
 "工業": "صِنَاعَة (إيجاد الشيء وخَلْقُه؛ (استخدام حديث) قطاع اقتصادي)\nمثال: هذا البلد مدعوم بالصناعة.",
 "工業化": "تَصْنِيع, تَحَوُّل صِنَاعِيّ",
 "工業団地": "مجمع صناعي, منطقة صناعية (قطعة أرض بعيدة عن مركز المدينة مصممة لتضم مجموعة من الشركات والمصانع)",
 "工率": "قُوَّة, قُدْرَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / قُوَّة, طَاقَة (ضد الضُعْف، الشِدَّة والقُدْرَة الجِسْمَانِيَّة؛ ضد الضُعْف، المَقْدِرَة والحَوْل والتَمَكُّن، القدرة المعنوية) / طَاقَة كَهْرَبَائِيَّة, طَاقَة (القُدْرَة والشِدَّة؛ هي مقدار ما يمكن للإنسان أن يفعله بمشقة، كأن قدرته محددة بطَوْق)\nمثال: توم شعر بالقوة.",
 "工程": "عَمَلِيَّة / عِلْمِيَّة, مُعَالَجَة / جَهَّزَ (جَهاز العَرُوس وَالْمَيِّتِ وجِهازهما: مَا يَحْتَاجَانِ إِليه؛ جَهَّزَه فَتَجَهَّز وجَهَّزْتُ العروسَ تَجْهِيزاً، وَكَذَلِكَ جَهَّزت الْجَيْشَ)\nمثال: جهز زيري حقائبه.",
 "工程線": "خط إنتاج, خط تجميع (نظام ميكانيكي في مصنع يتم بموجبه نقل السلعة عبر مواقع يتم فيها إجراء عمليات متتالية عليها)",
 "工芸": "فنون صناعية (دورة في طرق استخدام الأدوات والآلات كما تُدرس في المدارس الثانوية والمدارس الفنية)",
 "工芸品": "حِرْفَة يَدَوِيَّة",
 "工芸家": "صَانِع (كل من يَصْنَعُ شيئا؛ من يَمْتَهِنُ الصِّنَاعَة) / حِرَفِيّ / حِرْفِيّ\nمثال: أحب أن أكون صانع محتوى.",
 "工藤": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "工賃": "تُهْمَة / اِتَّهَمَ / شَحَنَ (مَلَأَ الشيءَ أو حمله بكميات كبيرة؛ في : زوّد شيئًا بالطاقة الكهربائية أو الشحنة) / هَاجَمَ\nمثال: أقوم بشحن هاتفي",
 "工銭": "جزاء, عاقبة (تعويض عن أعمال جديرة بالتقدير أو عقاب على مخالفات)\nمثال: أجرة الخطيئة هي الموت",
 "工面": "ابتكار, اختلاق (فعل تدبير أو ابتكار شيء ما) / آلة مبتكرة, أداة (جهاز أو أداة تحكم مفيدة جداً لأداء عمل معين) / تجهيز مؤقت, تلفيق (أي ترتيب مرتجل للاستخدام المؤقت) / ابتكار, براعة (ملكة الابتكار؛ مهارة ابتكارية)\nمثال: براعته الماهرة في إجابات كل مشكلة",
 "工順": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "左": "يَسَار, شِمَال (السهولة والغنى في العيش؛ نقيض اليمين، جهة المَيْسِرَة) / يساري / يَسَارًا, شِمَالًا / إِلَى اَلْيَسَار, إِلَى اَلشِّمَال (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / بِقِي (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: ذهب سامي إلى اليسار. / شِمَال, يُسْرَى (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد. / شَارِب",
 "左うちわ": "بحبوحة, رغد العيش (أمان مالي)",
 "左ぎっちょ": "أعسرية, عسر (تفضيل استخدام اليد اليسرى) / زواج اليد اليسرى, زواج مورغاناتي (حالة الولادة من زواج مورغاناتي (زواج بين نبيل وامرأة من طبقة أدنى لا يرث فيه الأبناء ألقاب الأب))",
 "左ハンドル": "شِمَال, يُسْرَى (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "左バッター": "أَيْسَر, أَعْسَر (أصبح ذو يُسْر وسِعَة؛ أخذ جهة اليَسَار)\nمثال: لدي ندبتان على حاجبي الأيسر.",
 "左上手": "أَيْسَر, أَعْسَر (أصبح ذو يُسْر وسِعَة؛ أخذ جهة اليَسَار)\nمثال: لدي ندبتان على حاجبي الأيسر.",
 "左側": "قِمَّة",
 "左党": "شَارِب / يَسَارِيّ",
 "左利き": "أعسرية, عسر (تفضيل استخدام اليد اليسرى) / زواج اليد اليسرى, زواج مورغاناتي (حالة الولادة من زواج مورغاناتي (زواج بين نبيل وامرأة من طبقة أدنى لا يرث فيه الأبناء ألقاب الأب)) / شَارِب",
 "左前": "تراجع, ركود (تدهور في النشاط التجاري أو الاقتصادي)\nمثال: شهد السوق ركوداً",
 "左右": "سَيْطَرَ / تَحَكُّم, مُرَاقَبَة (\"تَحَكَّمَ فِي أُمُورِهِ الشَّخْصِيَّةِ\" : ضَبَطَهَا وَأَحْكَمَهَا؛ \"يَتَحَكَّمُ فِي أُمُورِ غَيْرِهِ\" : يَتَصَرَّفُ فِيهَا كَمَا يَشَاءُ وَيُرِيدُ)\nمثال: من أنت لتحكم علي؟ / جَانِب / صَفْحَة / مراوغة, مواربة (التزييف عن طريق لغة غامضة أو ملتبسة) / غموض متعمد, مراوغة (الغموض أو الإبهام المتعمد في الكلام) / تهرب, مراوغة (بيان ليس كاذباً حرفياً ولكنه يتجنب بذكاء حقيقة غير سارة) / بأي حال, على أي حال (تستخدم للإشارة إلى أن بياناً يشرح أو يدعم بياناً سابقاً) / على أي حال, على الأقل (إن لم يكن أي شيء آخر)\nمثال: على أي حال، هو ميت الآن / مُخْتَلِف, مُتَنَوَّع",
 "左右対称": "تناظر ثنائي, تناظر جانبي (خاصية التناظر حول مستوى عمودي)",
 "左右相称": "تَنَاظُر",
 "左右突出部": "بروز الحرف (جزء من الحرف المعدني الذي يبرز خارج جسمه)",
 "左回り": "دوران عكس عقارب الساعة, دوران يساري (دوران إلى اليسار)",
 "左団扇": "بحبوحة, رغد العيش (أمان مالي)",
 "左官": "جَصّاص, عامل جص (عامل ماهر في وضع الجص (الجبس) على الجدران)",
 "左官屋": "جَصّاص, عامل جص (عامل ماهر في وضع الجص (الجبس) على الجدران)",
 "左巻": "عَكْس عَقَارِب السَّاعَة (في اتجاه معاكس لاتجاه حركة عقارب الساعة) / عَكْس اتِّجَاه عَقَارِب السَّاعَة (في الاتجاه المعاكس لدوران عقارب الساعة)\nمثال: الرجاء التحرك عكس اتجاه عقارب الساعة في دائرة! / لامتراكز, منحرف المركز (ليس له مركز مشترك؛ غير متحد المركز) / شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر) / شخصية, غريب الأطوار (شخص من نوع محدد (عادة ما يكون لديه العديد من الغرابة)) / غَرِيب الْأَطْوَار (شخص ذو شخصية غير عادية أو غريبة)\nمثال: دوائر لامتراكزة",
 "左巻き": "عَكْس عَقَارِب السَّاعَة (في اتجاه معاكس لاتجاه حركة عقارب الساعة) / عَكْس اتِّجَاه عَقَارِب السَّاعَة (في الاتجاه المعاكس لدوران عقارب الساعة)\nمثال: الرجاء التحرك عكس اتجاه عقارب الساعة في دائرة! / لامتراكز, منحرف المركز (ليس له مركز مشترك؛ غير متحد المركز) / شَاذّ, عَجِيب (غَيْرُ تَقْلِيدِيٍّ أَوْ غَيْرُ مَأْلُوفٍ بِشَكْلٍ لَافِتٍ لِلنَّظَر) / شخصية, غريب الأطوار (شخص من نوع محدد (عادة ما يكون لديه العديد من الغرابة)) / غَرِيب الْأَطْوَار (شخص ذو شخصية غير عادية أو غريبة)\nمثال: دوائر لامتراكزة",
 "左心室": "بطين أيسر (الحجرة على الجانب الأيسر من القلب التي تتلقى الدم الشرياني من الأذين الأيسر وتضخه في الأبهر)",
 "左心房": "أذين أيسر (الحجرة العلوية اليسرى للقلب التي تتلقى الدم من الأوردة الرئوية)",
 "左房": "أذين أيسر (الحجرة العلوية اليسرى للقلب التي تتلقى الدم من الأوردة الرئوية)",
 "左手": "شِمَال, يُسْرَى (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد. / يَسَار, شِمَال (السهولة والغنى في العيش؛ نقيض اليمين، جهة المَيْسِرَة) / يساري / يَسَارًا, شِمَالًا / إِلَى اَلْيَسَار, إِلَى اَلشِّمَال (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / بِقِي (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: ذهب سامي إلى اليسار.",
 "左手座標系": "أَيْسَر, أَعْسَر (أصبح ذو يُسْر وسِعَة؛ أخذ جهة اليَسَار)\nمثال: لدي ندبتان على حاجبي الأيسر.",
 "左打者": "أَيْسَر, أَعْسَر (أصبح ذو يُسْر وسِعَة؛ أخذ جهة اليَسَار)\nمثال: لدي ندبتان على حاجبي الأيسر.",
 "左投げ": "أَيْسَر, أَعْسَر (أصبح ذو يُسْر وسِعَة؛ أخذ جهة اليَسَار)\nمثال: لدي ندبتان على حاجبي الأيسر.",
 "左投手": "رامٍ أعسر (رامي بيسبول يرمي الكرة باليد اليسرى)",
 "左方端": "شِمَال, يُسْرَى (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "左旋性": "يَسَارِيّ الدَّوَرَان (يدور عكس عقارب الساعة؛ يُقال عن المواد التي تحرف مستوى الضوء المستقطَب يساراً)",
 "左旋糖": "سكر الفاكهة, فركتوز (سكر بسيط يوجد في العسل وفي العديد من الفواكه الناضجة)",
 "左様": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ / بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك) / بالفعل, جداً (في الحقيقة (غالباً ما تميل إلى التوكيد))\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "左派": "الجناح اليساري, اليسار (أولئك الذين يدعمون درجات متفاوتة من التغيير الاجتماعي أو السياسي أو الاقتصادي المصمم لتعزيز الرفاهية العامة)",
 "左翼": "الجناح اليساري, اليسار (أولئك الذين يدعمون درجات متفاوتة من التغيير الاجتماعي أو السياسي أو الاقتصادي المصمم لتعزيز الرفاهية العامة) / الحقل الأيسر (مركز اللعب للاعب في فريق البيسبول المتوقع منه التقاط الكرات في الثلث الأيسر من الملعب الخارجي) / يسار الملعب (قطعة الأرض في المنطقة الخارجية على يسار الماسك)",
 "左翼党": "يَسَارِيّ",
 "左翼手": "لاعب الدفاع الأيسر (الشخص الذي يلعب في الجانب الأيسر من الملعب الخارجي)",
 "左翼系": "يَسَارِيّ",
 "左胃動脈": "شريان معدي أيسر (فرع من الشريان الزلاقي يغذي الانحناء الصغير للمعدة والجزء البطني من المريء)",
 "左脳": "الدماغ الأيسر, نصف الكرة الأيسر (نصف الكرة المخية إلى يسار الجسم الثفني الذي يتحكم في النصف الأيمن من الجسم)",
 "左腕": "أَيْسَر, أَعْسَر (أصبح ذو يُسْر وسِعَة؛ أخذ جهة اليَسَار)\nمثال: لدي ندبتان على حاجبي الأيسر.",
 "左腕投手": "أَيْسَر, أَعْسَر (أصبح ذو يُسْر وسِعَة؛ أخذ جهة اليَسَار)\nمثال: لدي ندبتان على حاجبي الأيسر.",
 "左舷": "مِينَاء, مينا / مَنْفَذ / كَيَّفَ, غَيَّرَ",
 "左衛門三郎": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "左袒": "صَدَاقَة (المَحَبَّة بالصِّدْق. هي العِلاقَة بين شخصين أو أكثر قائِمَة على المحبة والصدق فكل منهم يحب الآخر ويَصْدُقه ويُصَدِّقه، كل منهم هو صَدِيق للآخر)\nمثال: الغيرة عدوة الصداقة.",
 "左褄": "غَيْشَا",
 "左記": "التَّالِي ذِكْرُهُ, المَذْكُور أَدْنَاه (على وشك أن يُذكَر أو يُحدَّد فيما يلي)",
 "左辺": "الهرمون الملوتن (هرمون موجه للغدد التناسلية تفرزه الغدة النخامية الأمامية؛ يحفز التبويض في إناث الثدييات ويحفز إطلاق الأندروجين في ذكور الثدييات)",
 "左近の桜": "شجرة الكرز, كرز (أي من العديد من الأشجار والشجيرات التي تنتج فاكهة مستديرة لحمية صغيرة بنواة صلبة واحدة؛ ينتج الكثير منها أيضاً خشباً صلباً قيماً)",
 "左近允": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "左近司": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "左遷": "إنزال, تخفيض الرتبة (فعل التخفيض في الرتبة أو المنصب)",
 "左顧右眄": "تأرجح (تغيير الموقع عن طريق التحرك ذهاباً وإياباً) / تردد, تريث (تردد في الكلام أو العمل)",
 "巧": "براعة, مهارة (حالة كونه ماهراً معرفياً)",
 "巧い": "مَاهِر, حَاذِق / لَذِيذ / شَهِيّ / حَسَن, جَيِّد (جَمِيل؛ مُبْهِج) / صِحِّيّ (ما ينفع الصحة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / خَيْر ((خَيَّرَ)وخَيَّرَهُ: فَوَّضَ إليه الخِيارَ؛ (خَيَّرَ) بَين الْأَشْيَاء: فضل بَعْضهَا على بعض) / سِلْعَة\nمثال: إيمي فتاة حسنة.",
 "巧く": "ببراعة, بمهارة (بمهارة وحذق)\nمثال: شظايا إبريق شبه كامل، تم ترميمها بمهارة في معهد الآثار / بِنَجَاحٍ / بِشَكْل مُبْهِج, بِلَذَّة (بطريقة ممتعة للغاية) / بشكل شهي, بلذة (بطريقة تنتج طعماً لذيذاً)\nمثال: كانا يمشيان على الشاطئ ببطء ومتعة",
 "巧まざる": "طَبِيعِيّ",
 "巧まずして": "عَنْ غَفْلَةٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "巧まぬ": "طَبِيعِيّ",
 "巧み": "مَاهِر, حَاذِق / حِرْفَة, صَنْعَة / حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ",
 "巧む": "وصية عقارية ((قانون) هبة لممتلكات عقارية بموجب وصية) / وصية عقارية (وصية للتصرف في الممتلكات العقارية)",
 "巧妙": "عَبْقَرِيّ",
 "巧手": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير.",
 "巧技": "مَهَارَة",
 "巧拙": "مَهَارَة",
 "巧知": "مَهَارَة",
 "巧緻": "مُفَصَّل",
 "巧者": "براعة, ذكاء (خاصية كون الشخص بارعاً) / ذكاء, شطارة (الذكاء الذي يظهر في سرعة البديهة والفطنة) / إبداع, عبقرية (قوة الخيال الإبداعي)\nمثال: حبكة ذات براعة كبيرة",
 "巧言": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "巧言令色": "تملق, نفاق (ثناء مفرط أو غير صادق)",
 "巨かい": "رأس المدبرين, زعيم عصابة (شخص يقود الآخرين (خاصة في الأنشطة غير المشروعة))",
 "巨万": "ضَخْم, عِمْلَاق",
 "巨人": "عِمْلَاق",
 "巨人症": "داء العملقة, عملقة (كبر مفرط في القامة) / عملقة, فرط النمو (حجم مفرط؛ ناتج عادة عن إفراز مفرط لهرمون النمو من الغدة النخامية)",
 "巨人軍": "عِمْلَاق",
 "巨像": "جبار, عملاق (شخص ذو أهمية وسمعة استثنائية) / جبار, عملاق (شخص ضخم وقوي بشكل غير طبيعي)",
 "巨億": "مِلْيُون, ١٠٠٠٠٠٠",
 "巨匠": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "巨嘴鳥": "طُوقَان",
 "巨嘴鳥座": "الطُّوقَان",
 "巨大": "ضَخْم, عِمْلَاق",
 "巨大ガス惑星": "عِمْلَاق غَازِيّ, كَوْكَب غَازِيّ (أي من الكواكب الأربعة الخارجية في النظام الشمسي؛ أكبر بكثير من الأرض وغازي الطبيعة (مثل المشتري))",
 "巨大分子": "جزيء ضخم, جزيء كبير (أي جزيء معقد كبير جداً؛ يوجد فقط في النباتات والحيوانات)",
 "巨大症": "داء العملقة, عملقة (كبر مفرط في القامة) / عملقة, فرط النمو (حجم مفرط؛ ناتج عادة عن إفراز مفرط لهرمون النمو من الغدة النخامية)",
 "巨大都市": "مَديِنَةٌ ضَخْمَةٌ",
 "巨女": "عملاقة (أنثى عملاقة)",
 "巨岩": "جُرْفٌ (أخذ شيئًا وجرفه بعيدًا، أو سحب شيئًا بقوة؛ في : في بعض الحالات، قد تستخدم للإشارة إلى إزالة أو جرف شيء نحو مكان آخر)\nمثال: وقف على حافة الجرف.",
 "巨悪": "وَحْش (حَيْوَان غير مستأنس يعيش بعيدا عن الناس، وهي أصل الكلمة؛ حيوان مُفْتَرِس)\nمثال: ضرب زيري الوحش.",
 "巨擘": "سُلْطَة (هو طعام يصنع من الخُضَار الطَازَجَة تقطع وتخلط ويضاف إليها المِلْح وقد يضاف عصير اللَيْمُون أو الخَلّ أو الزَيْت. لا يطبخ)\nمثال: هو متعطش للسلطة.",
 "巨星": "عِمْلَاق, نَجْم عِمْلَاق (نجم شديد اللمعان ذو قطر كبير وكثافة منخفضة (نسبة للشمس)) / عِمْلَاق",
 "巨木": "سيكويا عملاقة (شجرة دائمة الخضرة شاهقة الارتفاع في الطرف الجنوبي من التلال الغربية لسييرا نيفادا في كاليفورنيا؛ أكبر كائن حي)",
 "巨核球": "خلية كبيرة النواة, خلية نواء (خلية نخاع عظم كبيرة؛ تعتبر مصدر الصفائح الدموية)",
 "巨波": "تلاطم, موجة عارمة (موجة بحرية كبيرة)",
 "巨漢": "عِمْلَاق",
 "巨石": "جندل",
 "巨石記念物": "جندل",
 "巨礫": "جُلْمُود, صَخْرَة كَبِيرَة (كتلة صخرية كبيرة ملساء منفصلة عن مكان نشأتها)",
 "巨神": "تَايْتَان",
 "巨篇": "مَلْحَمَة / مَلْحَمِيّ (متعلق بالكتب، أو الأفلام، أو الأشعار، أو بغيرها من الوسائط التي تصور دراما إنسانية على نطاق واسع، وتُعرف باسم الملحمات أو الملحميات)",
 "巨細": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "巨編": "مَلْحَمَة / مَلْحَمِيّ (متعلق بالكتب، أو الأفلام، أو الأشعار، أو بغيرها من الوسائط التي تصور دراما إنسانية على نطاق واسع، وتُعرف باسم الملحمات أو الملحميات)",
 "巨舶": "باخرة ركاب, سفينة رحلات (سفينة تجارية كبيرة (خاصة تلك التي تنقل الركاب وفق جدول منتظم))",
 "巨船": "باخرة ركاب, سفينة رحلات (سفينة تجارية كبيرة (خاصة تلك التي تنقل الركاب وفق جدول منتظم))",
 "巨艦店": "وَاسِع النِّطَاق (كبير بشكل غير معتاد في النطاق) / كَبِير المِقْيَاس (مبنيّ أو مرسوم بمقياس كبير)",
 "巨蟹宮": "سَرَطَان",
 "巨視的": "مَاكْرُوسْكُوبِيّ, مَرْئِيّ بِالعَيْن (كبير بما يكفي لرؤيته بالعين المجردة) / عِيَانِيّ, مَرْئِيٌّ بِالعَيْنِ المُجَرَّدَة (يُرَى بِالعَيْنِ المُجَرَّدَة؛ بِاسْتِخْدَامِ العَيْنِ المُجَرَّدَة) / شَامِل, شَامِلَة",
 "巨赤芽球": "أرومة ضخمة (خلية دم حمراء كبيرة بشكل غير طبيعي توجد في فقر الدم الخبيث ونقص حمض الفوليك)",
 "巨赤芽球性貧血": "فقر الدم الوبيل الضخم الأرومات (فقر دم يتميز بوجود العديد من خلايا الدم الحمراء الكبيرة غير الناضجة وغير الوظيفية (أرومات ضخمة) في نخاع العظم؛ يرتبط بفقر الدم الوبيل)",
 "巨頭": "قَائِد, زَعِيم",
 "巨魁": "رأس المدبرين, زعيم عصابة (شخص يقود الآخرين (خاصة في الأنشطة غير المشروعة))",
 "巫": "مُتَوَسِّط",
 "巫女": "صبية, فتاة (فتاة أو شابة غير متزوجة) / مُتَوَسِّط",
 "巫女寄せ": "روحانية (الاهتمام بأمور الروح)",
 "巫子": "سَاحِرَة",
 "巫者": "مُتَوَسِّط",
 "巫術": "شَامَانِيَّة",
 "巫覡": "شَامَان, كَاهِن",
 "巫鳥": "درسة (أي من الطيور المغردة آكلة البذور العديدة في أوروبا أو أمريكا الشمالية) / قماش الأعلام (قماش فضفاض النسج يستخدم للأعلام، إلخ)",
 "差": "فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ / بَيْنَ (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك. / إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم)",
 "差し": "بَيْنَ (ظرف مكان بمعنى وَسْط)\nمثال: مصيري بين يديك. / إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم) / مِسْطَرَة (أداة تستخدم لقياس الأطوال أو رسم الخطوط المستقيمة؛ خط مستقيم تحدده مِسطَرة أو بُعد محدد) / حَاكِم (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر)\nمثال: استعارت المسطرة.",
 "差しかけ": "سقيفة مائلة (مأوى بسيط له سقف منحدر واحد فقط)",
 "差しかけ小屋": "سقيفة مائلة (مأوى بسيط له سقف منحدر واحد فقط)",
 "差しさわり": "إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم) / إِزْعَاج",
 "差しつける": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "差しで": "وَجْهًا لِوَجْه",
 "差し上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "差し上る": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "差し交わす": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "差し付ける": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "差し伸べる": "تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ / دفع, قوة دافعة (فعل تطبيق قوة لدفع شيء ما) / نكز, وكز (إيماءة يد حادة (تشبه الضربة)) / طعنة (ضربة قوية بسكين أو أداة حادة أخرى مدببة) / طَعْنَة, نَقْد لَاذِع (نقد لفظي حاد)\nمثال: بعد الوصول إلى السرعة المطلوبة يتم قطع الدفع / اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة.",
 "差し傘": "مِظَلَّة, شَمْسِيَّة / وَاقٍ, الْوَاقِي",
 "差し入れ": "إدخال, إيلاج (عملية وضع شيء داخل شيء آخر) / إِدْرَاج, إِضَافَة (رسالة (منطوقة أو مكتوبة) يتم تقديمها أو إدراجها)\nمثال: بمساعدة إضافات صديقه تم سرد قصته في النهاية",
 "差し入れる": "أَدْخَلَ / نَقَلَ",
 "差し入れ口": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "差し出がましい": "صَاعِدًا / مُهَاجِم",
 "差し出し先": "خُطْبَة, نِدَاء / عُنْوَان, عِنْوَان (عُنْوَان) / عَنْوَنَ\nمثال: نسيت عنوان توم.",
 "差し出す": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / تَضْحِيَة, قُرْبَان / ضَحَّى / أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "差し出る": "حَشَرَ أَنْفَهُ (جَمَعَ الناسَ أو الأشياءَ في مكانٍ ضيّق؛ ساقهم إلى مكان معين، أو جمعهم قهرًا) / نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول)",
 "差し出口": "لَا مُبَرِّر لَه, مَجَّانِيّ (غير ضروري وغير مبرر) / غَيْر مَطْلُوب, لَا دَاعِيَ لَه (غير مطلوب وغير مُلتمَس)",
 "差し合い": "إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم)",
 "差し向い": "وَجْهًا لِوَجْه",
 "差し向かい": "وَجْهًا لِوَجْه",
 "差し向ける": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / مُبَاشِر / وَجَّه, قَاد (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس)\nمثال: تبدو شاحب الوجه.",
 "差し延べる": "تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ / دفع, قوة دافعة (فعل تطبيق قوة لدفع شيء ما) / نكز, وكز (إيماءة يد حادة (تشبه الضربة)) / طعنة (ضربة قوية بسكين أو أداة حادة أخرى مدببة) / طَعْنَة, نَقْد لَاذِع (نقد لفظي حاد)\nمثال: بعد الوصول إلى السرعة المطلوبة يتم قطع الدفع / اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة.",
 "差し引き": "اِسْتِنْتَاج (اِسْتِنْتَاج)\nمثال: المنطق هو طريقة نظامية للوصول إلى الاستنتاج الخاطئ مع الثقة.",
 "差し引き勘定": "رَصِيد",
 "差し引く": "ذيل قصير, ذيل مقصوص (ذيل قصير أو مقصر لبعض الحيوانات) / أصل الذيل, عسيب الذيل (الجزء العظمي الصلب من ذيل الحيوان تمييزاً له عن الشعر) / حوض السفن, رصيف الميناء (رصيف في الميناء بجوار رصيف بحري حيث يتم تحميل وتفريغ السفن أو إصلاحها؛ قد يكون له بوابات لدخول أو خروج المياه) / قفص الاتهام (مكان مسيج في قاعة المحكمة يجلس فيه المدعى عليه أثناء المحاكمة)\nمثال: وصلت السفينة إلى الرصيف متأخرة أكثر من يوم",
 "差し当たって": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي",
 "差し当たり": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم)",
 "差し当たる": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "差し押える": "إِسْتَوْلَى عَلَى",
 "差し押さえ": "حجز, مصادرة (الاستيلاء على شيء عن طريق الإجراءات القانونية) / أسر, سيطرة (فعل نزع ملكية المالك بالقوة) / أسر, احتجاز (فعل أخذ شخص بالقوة) / نوبة مرضية (حدوث مفاجئ (أو تكرار) لمرض)\nمثال: عانى من نوبة صرع",
 "差し押さえる": "إِسْتَوْلَى عَلَى",
 "差し招く": "أَشَارَ, أَوْمَأَ",
 "差し挟む": "أَدْخَلَ / قَاطَعَ / مَرْفَأ, مَرْسَى",
 "差し挾む": "أَدْخَلَ / قَاطَعَ / مَرْفَأ, مَرْسَى",
 "差し掛かる": "اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني. / بروز, تدلّ (نتوء يمتد إلى ما بعد شيء آخر أو يتدلى فوقه)",
 "差し掛け": "سقيفة مائلة (مأوى بسيط له سقف منحدر واحد فقط)",
 "差し掛け小屋": "سقيفة مائلة (مأوى بسيط له سقف منحدر واحد فقط)",
 "差し控える": "اِمْتَنَعَ (مَنَعَ نفسه؛ كان مَنِيْعًا يصعب الوصول إليه) / لَازِمَة, قَرَار",
 "差し換え": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر) / بديل (شخص أو شيء يأخذ أو يمكن أن يأخذ مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر) / خَلَف, خَلِيفَة (الشخص الذي يلي في الترتيب)\nمثال: استبدال النجم لن يكون سهلاً / صَحِيح, صَوَاب / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: صحح نطقي من فضلك.",
 "差し換える": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "差し支え": "إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم)",
 "差し支えない": "مَسْمُوحٌ بِخَصْمِهِ (قابل للخصم وفقاً لقوانين الضرائب) / جائز, مسموح (ما يمكن السماح به خاصة وفقاً للقواعد) / جَائِز, مُبَاح (يستحقّ أن يُسمَح به أو يُنظَر فيه)\nمثال: سلوك مسموح به في المدرسة",
 "差し支える": "عَاقَ, عَرْقَلَ / خَلْفِيّ / رِدْف, عَجِيزَة (رَدِفَهُ يَرْدَفُ رَدْفاً: رَدَفه؛ وفي التنزل العزيز)",
 "差し昇る": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "差し替え": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر) / بديل (شخص أو شيء يأخذ أو يمكن أن يأخذ مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر) / خَلَف, خَلِيفَة (الشخص الذي يلي في الترتيب)\nمثال: استبدال النجم لن يكون سهلاً / صَحِيح, صَوَاب / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: صحح نطقي من فضلك.",
 "差し替える": "تَغَيَّرَƒ / غَيَّرَ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / تَغْيِير, تَبْدِيل / فَكَّة / بَاقٍ (باقٍ ، الباقِيٌ جمع باقون ( للعاقل ) وبَواقٍ ، مؤ باقية ، جمع مؤ باقيات وبَواقٍ؛ باقٍ إلَى الأبَدِ : خالِدٌ) / تَغْيِير\nمثال: أنا غير متفاجئ.",
 "差し止め": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر) / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "差し止める": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "差し油": "زَيْت, زيت (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن) / نَفْط, زَيْت (سَائِل أسود قابل للاحتراق يوجد في باطن الأرض تستخدم مشتقاته كوقود وفي الصناعة. يعتبر حاليا أهم مصادر الطاقة في العالم)\nمثال: خبأن ذلك الزيت.",
 "差し渡し": "طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "差し湯": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "差し潮": "فيضان, مد صاعد (حدوث تدفق المياه للداخل (بين الجزر والمد العالي التالي))\nمثال: مد في شؤون البشر، إذا أُخذ في ذروته، يقود إلى الثروة",
 "差し物": "أعمال الموبيليا, صناعة الخزائن (حرفة صنع الأثاث (خاصة الأثاث عالي الجودة)) / صناعة الخزائن (أعمال خشبية منتهية يدوياً بواسطة صانع خزائن) / دَبُّوس / علم الدولة (علم يظهر جنسيته) / ألوان (شعار مميز)\nمثال: أعلنت ربطة عنقه عن ألوان مدرسته",
 "差し立て": "إرسال, إيفاد (فعل إرسال شيء ما) / إجهاز, قتل (قتل شخص أو حيوان (بسرعة)) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً) / برقية, بلاغ (تقرير رسمي (يرسل عادة على عجل))\nمثال: تم إنجازه بسرعة وكفاءة",
 "差し立てる": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "差し紙": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له.",
 "差し縄": "دبوس التوازن (أي من الأجنحة الخلفية الضامرة للحشرات ثنائية الأجنحة؛ تستخدم للحفاظ على التوازن أثناء الطيران) / بلوزة برباط عنق, هالتر توب (توب نسائي يربط خلف الظهر والرقبة ويترك الظهر والذراعين مكشوفين) / رسن, مقود (غطاء رأس من الحبل أو القماش للحصان، مع حبل للقيادة) / حبل المشنقة (حبل يستخدمه الجلاد لإعدام الأشخاص المحكوم عليهم بالموت شنقاً)",
 "差し繰る": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "差し置く": "نَاهِيك",
 "差し覗く": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "差し許す": "سَمَحَ, أَذِنَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)؛ سَهُلَ) / سَمَحَ بِـ, سَمَحَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)؛ سَهُلَ)\nمثال: سمح لسكورة بالسباحة.",
 "差し詰め": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي",
 "差し越す": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "差し込み": "إدخال, إيلاج (عملية وضع شيء داخل شيء آخر) / إِدْرَاج, إِضَافَة (رسالة (منطوقة أو مكتوبة) يتم تقديمها أو إدراجها)\nمثال: بمساعدة إضافات صديقه تم سرد قصته في النهاية / قَابِس / فِيشَة ((في العامية) قابس كهرباء) / بُوجِيه / دِسَام / سِدَاد / سِدَادَة / اِخْتِلَاج (الخَلْجُ: الجَذْبُ،واختلج شيء في صدري:احتكأ مع شك؛ أصل الاختلاج: الحركة والاضطراب)",
 "差し込み口": "قَابِس / فِيشَة ((في العامية) قابس كهرباء) / بُوجِيه / دِسَام / سِدَاد / سِدَادَة",
 "差し込む": "أَدْخَلَ",
 "差し遣す": "إرسال, إيفاد (فعل إرسال شيء ما) / إجهاز, قتل (قتل شخص أو حيوان (بسرعة)) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً) / برقية, بلاغ (تقرير رسمي (يرسل عادة على عجل))\nمثال: تم إنجازه بسرعة وكفاءة",
 "差し遣わす": "إرسال, إيفاد (فعل إرسال شيء ما) / إجهاز, قتل (قتل شخص أو حيوان (بسرعة)) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً) / برقية, بلاغ (تقرير رسمي (يرسل عادة على عجل))\nمثال: تم إنجازه بسرعة وكفاءة",
 "差し金": "زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية) / إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة)) / تحريض, حث (الفعل اللفظي للحث)",
 "差し障り": "إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم) / إِزْعَاج",
 "差し障りのない": "بَريء, غَيْر مُؤْذٍ (لا يَنْتُج عَنْه ضَرَر؛ بَريء وغَيْر خَطِر) / سليم, غير ضار (غير مؤذ للصحة الجسدية أو العقلية) / غَيْر مُسْتَهْجَن, مَقْبُول (لا يثير الاستنكار أو الاعتراض)",
 "差し障る": "عَاقَ, عَرْقَلَ / خَلْفِيّ / رِدْف, عَجِيزَة (رَدِفَهُ يَرْدَفُ رَدْفاً: رَدَفه؛ وفي التنزل العزيز)",
 "差し響く": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "差す": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه. / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / أَدْخَلَ",
 "差をつける": "مَيَّزَ",
 "差を付ける": "مَيَّزَ",
 "差上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "差上る": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "差交す": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "差交わす": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "差付ける": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "差伸べる": "تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ / دفع, قوة دافعة (فعل تطبيق قوة لدفع شيء ما) / نكز, وكز (إيماءة يد حادة (تشبه الضربة)) / طعنة (ضربة قوية بسكين أو أداة حادة أخرى مدببة) / طَعْنَة, نَقْد لَاذِع (نقد لفظي حاد)\nمثال: بعد الوصول إلى السرعة المطلوبة يتم قطع الدفع / اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة.",
 "差傘": "مِظَلَّة, شَمْسِيَّة / وَاقٍ, الْوَاقِي",
 "差入口": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / فتح (عملية فتح شيء ما) / فتح (أن يصبح الشيء مفتوحاً أو يتم فتحه) / افتتاحية, افتتاحية الشطرنج (تسلسل معترف به من النقلات في بداية لعبة الشطرنج)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "差出る": "حَشَرَ أَنْفَهُ (جَمَعَ الناسَ أو الأشياءَ في مكانٍ ضيّق؛ ساقهم إلى مكان معين، أو جمعهم قهرًا) / نَتَأَ / بَرَزَ (خَرَجَ؛ نَبُه بعد خُمول)",
 "差出人": "مُرْسِل, مُرْسِلَة",
 "差出口": "لَا مُبَرِّر لَه, مَجَّانِيّ (غير ضروري وغير مبرر) / غَيْر مَطْلُوب, لَا دَاعِيَ لَه (غير مطلوب وغير مُلتمَس)",
 "差分": "فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ",
 "差別": "تَمْيِيْز / تَفْرِيق / تَمْيِيز",
 "差別主義者": "مُتَعَصِّب",
 "差別化": "تفاضل (العملية الرياضية للحصول على مشتق دالة) / اختلاف, تمايز (التمييز بين الأشياء على أنها مختلفة ومتميزة بناءً على خصائصها أو سماتها) / تخصص, تمايز ((في الأحياء) التكيف الهيكلي لجزء من الجسم لوظيفة معينة)\nمثال: من الضروري التمييز بين الحب والافتتان",
 "差別的": "تَفْضِيلِيّ, تَمْيِيزِيّ (يُظهر تحيزاً أو محاباة) / مُتَحَامِل, مُتَحَيِّز (كونه متحيزاً أو لديه اعتقاد أو موقف متشكل مسبقاً) / تَفْرِيقِيّ, تَمْيِيزِيّ (قَادِر عَلَى إِجْرَاء تَمْيِيزَات دَقِيقَة) / تَمْيِيزِيّ, مُتَحَيِّز (يَنْطَوِي عَلَى انْتِقَاص أَوْ يُظْهِر تَحَيُّزًا)\nمثال: قاضٍ متحيز",
 "差動": "تفاضلي, فارقي (متعلق بـ أو يظهر فرقاً واختلافاً) / تفاضلي (ينطوي على أو يحتوي على مشتق واحد أو أكثر (في الرياضيات)) / ترس تفاضلي, دفرنس (ترس مخروطي يسمح بتدوير عمودين بسرعات مختلفة؛ يستخدم في المحور الخلفي للسيارات للسماح للعجلات بالدوران بسرعات مختلفة عند المنعطفات) / عَامِل تَفَاضُل, فَارِق (صفة تميز بين الأشياء المتشابهة)\nمثال: معاملة تفاضلية",
 "差動歯車": "ترس تفاضلي, دفرنس (ترس مخروطي يسمح بتدوير عمودين بسرعات مختلفة؛ يستخدم في المحور الخلفي للسيارات للسماح للعجلات بالدوران بسرعات مختلفة عند المنعطفات)",
 "差動歯車装置": "ترس تفاضلي, دفرنس (ترس مخروطي يسمح بتدوير عمودين بسرعات مختلفة؛ يستخدم في المحور الخلفي للسيارات للسماح للعجلات بالدوران بسرعات مختلفة عند المنعطفات)",
 "差動装置": "ترس تفاضلي, دفرنس (ترس مخروطي يسمح بتدوير عمودين بسرعات مختلفة؛ يستخدم في المحور الخلفي للسيارات للسماح للعجلات بالدوران بسرعات مختلفة عند المنعطفات)",
 "差口": "حنفية, صنبور (منظم للتحكم في تدفق السائل من خزان) / سدادة حنفية, صنبور (سدادة لفتحة البرميل في برميل خشبي)",
 "差向い": "وَجْهًا لِوَجْه",
 "差向ける": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / مُبَاشِر / وَجَّه, قَاد (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس)\nمثال: تبدو شاحب الوجه.",
 "差延べる": "تَمَدَّدَ / مَدَّدَ, اِمْتَدَّ / دفع, قوة دافعة (فعل تطبيق قوة لدفع شيء ما) / نكز, وكز (إيماءة يد حادة (تشبه الضربة)) / طعنة (ضربة قوية بسكين أو أداة حادة أخرى مدببة) / طَعْنَة, نَقْد لَاذِع (نقد لفظي حاد)\nمثال: بعد الوصول إلى السرعة المطلوبة يتم قطع الدفع / اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة.",
 "差引": "اِسْتِنْتَاج (اِسْتِنْتَاج)\nمثال: المنطق هو طريقة نظامية للوصول إلى الاستنتاج الخاطئ مع الثقة.",
 "差引き": "اِسْتِنْتَاج (اِسْتِنْتَاج)\nمثال: المنطق هو طريقة نظامية للوصول إلى الاستنتاج الخاطئ مع الثقة.",
 "差引く": "ذيل قصير, ذيل مقصوص (ذيل قصير أو مقصر لبعض الحيوانات) / أصل الذيل, عسيب الذيل (الجزء العظمي الصلب من ذيل الحيوان تمييزاً له عن الشعر) / حوض السفن, رصيف الميناء (رصيف في الميناء بجوار رصيف بحري حيث يتم تحميل وتفريغ السفن أو إصلاحها؛ قد يكون له بوابات لدخول أو خروج المياه) / قفص الاتهام (مكان مسيج في قاعة المحكمة يجلس فيه المدعى عليه أثناء المحاكمة)\nمثال: وصلت السفينة إلى الرصيف متأخرة أكثر من يوم",
 "差引勘定": "رَصِيد",
 "差当り": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم)",
 "差押": "حجز, مصادرة (الاستيلاء على شيء عن طريق الإجراءات القانونية) / أسر, سيطرة (فعل نزع ملكية المالك بالقوة) / أسر, احتجاز (فعل أخذ شخص بالقوة) / نوبة مرضية (حدوث مفاجئ (أو تكرار) لمرض)\nمثال: عانى من نوبة صرع",
 "差押え": "حجز, مصادرة (الاستيلاء على شيء عن طريق الإجراءات القانونية) / أسر, سيطرة (فعل نزع ملكية المالك بالقوة) / أسر, احتجاز (فعل أخذ شخص بالقوة) / نوبة مرضية (حدوث مفاجئ (أو تكرار) لمرض)\nمثال: عانى من نوبة صرع",
 "差押える": "إِسْتَوْلَى عَلَى",
 "差押さえる": "إِسْتَوْلَى عَلَى",
 "差掛け": "سقيفة مائلة (مأوى بسيط له سقف منحدر واحد فقط)",
 "差控える": "اِمْتَنَعَ (مَنَعَ نفسه؛ كان مَنِيْعًا يصعب الوصول إليه) / لَازِمَة, قَرَار",
 "差換え": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر) / بديل (شخص أو شيء يأخذ أو يمكن أن يأخذ مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر) / خَلَف, خَلِيفَة (الشخص الذي يلي في الترتيب)\nمثال: استبدال النجم لن يكون سهلاً / صَحِيح, صَوَاب / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: صحح نطقي من فضلك.",
 "差損": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة",
 "差支え": "إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / عائق, مانع (أي عائق يعرقل أو يكون مرهقاً) / عائق, عقبة (شيء غير مادي يتداخل مع أو يؤخر العمل أو التقدم)",
 "差支える": "عَاقَ, عَرْقَلَ / خَلْفِيّ / رِدْف, عَجِيزَة (رَدِفَهُ يَرْدَفُ رَدْفاً: رَدَفه؛ وفي التنزل العزيز)",
 "差支え無い": "مَسْمُوحٌ بِخَصْمِهِ (قابل للخصم وفقاً لقوانين الضرائب) / جائز, مسموح (ما يمكن السماح به خاصة وفقاً للقواعد) / جَائِز, مُبَاح (يستحقّ أن يُسمَح به أو يُنظَر فيه)\nمثال: سلوك مسموح به في المدرسة",
 "差替え": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر) / بديل (شخص أو شيء يأخذ أو يمكن أن يأخذ مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر) / خَلَف, خَلِيفَة (الشخص الذي يلي في الترتيب)\nمثال: استبدال النجم لن يكون سهلاً / صَحِيح, صَوَاب / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: صحح نطقي من فضلك.",
 "差止": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر) / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "差止め": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر) / حَظْر ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "差止める": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب.",
 "差物": "أعمال الموبيليا, صناعة الخزائن (حرفة صنع الأثاث (خاصة الأثاث عالي الجودة)) / صناعة الخزائن (أعمال خشبية منتهية يدوياً بواسطة صانع خزائن) / دَبُّوس / علم الدولة (علم يظهر جنسيته) / ألوان (شعار مميز)\nمثال: أعلنت ربطة عنقه عن ألوان مدرسته",
 "差略": "خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "差異": "فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ",
 "差異化": "تفاضل (العملية الرياضية للحصول على مشتق دالة) / اختلاف, تمايز (التمييز بين الأشياء على أنها مختلفة ومتميزة بناءً على خصائصها أو سماتها) / تخصص, تمايز ((في الأحياء) التكيف الهيكلي لجزء من الجسم لوظيفة معينة)\nمثال: من الضروري التمييز بين الحب والافتتان",
 "差立て": "إرسال, إيفاد (فعل إرسال شيء ما) / إجهاز, قتل (قتل شخص أو حيوان (بسرعة)) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً) / برقية, بلاغ (تقرير رسمي (يرسل عادة على عجل))\nمثال: تم إنجازه بسرعة وكفاءة",
 "差立てる": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "差等": "تَدَرُّج / تَدْرِيج",
 "差縄": "دبوس التوازن (أي من الأجنحة الخلفية الضامرة للحشرات ثنائية الأجنحة؛ تستخدم للحفاظ على التوازن أثناء الطيران) / بلوزة برباط عنق, هالتر توب (توب نسائي يربط خلف الظهر والرقبة ويترك الظهر والذراعين مكشوفين) / رسن, مقود (غطاء رأس من الحبل أو القماش للحصان، مع حبل للقيادة) / حبل المشنقة (حبل يستخدمه الجلاد لإعدام الأشخاص المحكوم عليهم بالموت شنقاً)",
 "差置く": "نَاهِيك",
 "差覗く": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "差込": "إدخال, إيلاج (عملية وضع شيء داخل شيء آخر) / إِدْرَاج, إِضَافَة (رسالة (منطوقة أو مكتوبة) يتم تقديمها أو إدراجها)\nمثال: بمساعدة إضافات صديقه تم سرد قصته في النهاية / قَابِس / فِيشَة ((في العامية) قابس كهرباء) / بُوجِيه / دِسَام / سِدَاد / سِدَادَة / اِخْتِلَاج (الخَلْجُ: الجَذْبُ،واختلج شيء في صدري:احتكأ مع شك؛ أصل الاختلاج: الحركة والاضطراب)",
 "差込み": "إدخال, إيلاج (عملية وضع شيء داخل شيء آخر) / إِدْرَاج, إِضَافَة (رسالة (منطوقة أو مكتوبة) يتم تقديمها أو إدراجها)\nمثال: بمساعدة إضافات صديقه تم سرد قصته في النهاية / قَابِس / فِيشَة ((في العامية) قابس كهرباء) / بُوجِيه / دِسَام / سِدَاد / سِدَادَة / اِخْتِلَاج (الخَلْجُ: الجَذْبُ،واختلج شيء في صدري:احتكأ مع شك؛ أصل الاختلاج: الحركة والاضطراب)",
 "差込む": "أَدْخَلَ",
 "差込口": "قَابِس / فِيشَة ((في العامية) قابس كهرباء) / بُوجِيه / دِسَام / سِدَاد / سِدَادَة",
 "差遣": "إرسال, إيفاد (فعل إرسال شيء ما) / إجهاز, قتل (قتل شخص أو حيوان (بسرعة)) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً) / برقية, بلاغ (تقرير رسمي (يرسل عادة على عجل))\nمثال: تم إنجازه بسرعة وكفاءة",
 "差遣す": "إرسال, إيفاد (فعل إرسال شيء ما) / إجهاز, قتل (قتل شخص أو حيوان (بسرعة)) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً) / برقية, بلاغ (تقرير رسمي (يرسل عادة على عجل))\nمثال: تم إنجازه بسرعة وكفاءة",
 "差遣わす": "إرسال, إيفاد (فعل إرسال شيء ما) / إجهاز, قتل (قتل شخص أو حيوان (بسرعة)) / سرعة الإنجاز, كفاءة (خاصية كونه سريعاً وفعالاً) / برقية, بلاغ (تقرير رسمي (يرسل عادة على عجل))\nمثال: تم إنجازه بسرعة وكفاءة",
 "差配": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "差配人": "وكيل أراضي (شخص يدير عقاراً من الأراضي) / سمسار عقارات, وسيط عقاري (شخص مخول للعمل كوكيل لبيع الأراضي والعقارات)",
 "差金": "فَرْق, اِخْتِلَاف / فَرْق, فُرُوق / خِلاف, خِلافات / فَرْق / مَيَّزَ / زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية) / إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة)) / تحريض, حث (الفعل اللفظي للحث)",
 "差響く": "نَفُوذ, تَأْثِير / تَأْثِير / أَثَّرَ (عَلَامَة؛ بَقِيَّة؛ رَسْم مُتَخَلَّف من شيء ما؛ تأثير؛ انطباع)\nمثال: اختفى فلم ير له أثر.",
 "差額": "رَصِيد",
 "差額ベッド": "سرير طبي, سرير مستشفى (سرير مفرد بإطار مقسم لثلاثة أقسام بحيث يمكن رفع الرأس أو الوسط أو القدمين حسب الحاجة)",
 "己": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / لوحد / لحال",
 "己が": "ـِي, ـي",
 "己がじし": "كُلّ",
 "己と": "بالطبع, بطبيعة الحال (كما هو متوقع) / طبيعياً (وفقاً للطبيعة؛ بوسائل طبيعية؛ دون مساعدة اصطناعية) / بشكل طبيعي, بطبيعية (بطريقة طبيعية أو عادية) / بالفطرة, بطبعه (من خلال الطبيعة المتأصلة)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "己ら": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "己れ": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / لوحد / لحال",
 "己等": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / ـنِي, ـنِيَ / ـِي, ـِيَ / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "己等達": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "已": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد",
 "已の事": "تَقْرِيبًا, عَلَى وَشْك",
 "已むを得ず": "بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: انزلق الوضع لا محالة نحو الكارثة",
 "已む得ず": "بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: انزلق الوضع لا محالة نحو الكارثة",
 "已む無い": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "已む無し": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "已める": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ) / أَوْقَفَ, وَقَفَ / تَوَقَّفَ, وَقَّف / مَوْقِف / وَقْفَة\nمثال: وقف وراء الباب. / أَلْغَى, أَبْطَلَ",
 "已午": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "已己巳己": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "已往": "قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قَبْلَ, أَمَامَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "已波": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "已里木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "巳": "ثُعْبَان, حَنَش / باتجاه الجنوب الجنوب الشرقي (إلى أو نحو أو في الجنوب الجنوب الشرقي)",
 "巴": "لغة بالي (لغة براكريتية قديمة (مشتقة من السنسكريتية) وهي اللغة الكتابية والطقسية لبوذية التيرافادا)",
 "巴丹": "كوكاتو (ببغاء ذو عرف أبيض أو فاتح اللون من المنطقة الأسترالية؛ غالباً ما يتم الاحتفاظ به كطيور أقفاص)",
 "巴人": "فلاح ساذج, قروي بسيط (شخص ليس ذكياً جداً أو غير مهتم بالثقافة)",
 "巴利語": "لغة بالي (لغة براكريتية قديمة (مشتقة من السنسكريتية) وهي اللغة الكتابية والطقسية لبوذية التيرافادا)",
 "巴戦": "قِتَال الكِلَاب (قتال عنيف بين الكلاب (ينظم أحياناً بشكل غير قانوني للترفيه والمقامرة)) / اشتباك جوي, معركة جوية قريبة (اشتباك جوي بين الطائرات المقاتلة) / تَشَابُك بِالأَيْدِي, عِرَاك (قتال غير منظم) / صراع عنيف, قتال شرس (منافسة متنازع عليها بضراوة)\nمثال: ضغينة تعود لقتال سياسي شرس بينهما",
 "巴旦杏": "بَرْقُوق",
 "巴豆油": "زيت كروتون (زيت لزج أصفر مائل للبني من بذور كروتون تيغليوم له تأثير مسهل عنيف)",
 "巵子": "غاردينيا, ياسمين الكاب (شجيرة دائمة الخضرة تزرع على نطاق واسع لزهورها البيضاء الشمعية العطرة الكبيرة وأوراقها اللامعة)",
 "巷": "عَلَنِيّ, عَامّ / عُمُومِيّ / عَامَّة, جُمْهُور / شَارِع, زَنَقَة / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَوْضِع\nمثال: هنا موقع الحادث. / قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما)\nمثال: أنا أزين القسم.",
 "巷説": "نَمِيمَة, إِشَاعَة / اِغْتَابَ",
 "巷談": "إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "巷間": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه) / عَالَم, دُنْيَا (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "巻": "دَحْرَجَ, تَدَحْرَجَ / ثَنَى, لَفَّ (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً / حَجْم (حجّم الشّيء:وضع حجماً محدّداً له ، قَلَّلَ دوره وهَمَّشَه، قلّل تأثيره؛ حجّم: نَظَرَ نظراً شديداً،ويُقال حجّم إليه) / جَهَارَة / مُجَلَّد, جُزْء\nمثال: ما حجم البالون؟ / عَقِب, كَعْب / كَعْب / حَجْم (حجّم الشّيء:وضع حجماً محدّداً له ، قَلَّلَ دوره وهَمَّشَه، قلّل تأثيره؛ حجّم: نَظَرَ نظراً شديداً،ويُقال حجّم إليه) / جَهَارَة / مُجَلَّد, جُزْء\nمثال: ما حجم البالون؟ / طُومَار",
 "巻き": "دَحْرَجَ, تَدَحْرَجَ / ثَنَى, لَفَّ (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً / حَجْم (حجّم الشّيء:وضع حجماً محدّداً له ، قَلَّلَ دوره وهَمَّشَه، قلّل تأثيره؛ حجّم: نَظَرَ نظراً شديداً،ويُقال حجّم إليه) / جَهَارَة / مُجَلَّد, جُزْء\nمثال: ما حجم البالون؟ / عَقِب, كَعْب / كَعْب",
 "巻きあげ": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رفع (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / شال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها) / مِصْعَد, أَصَنْصِير\nمثال: رفع سامي نظارته.",
 "巻きひげ": "مِحْلَاق",
 "巻きゲートル": "لفافة ساق (شريط من القماش يلف حول الساق لتشكيل غطاء للساق؛ استخدمه الجنود في الحرب العالمية الأولى)",
 "巻きタバコ": "سِيجَارَة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض التدخين)\nمثال: دخن زيري سيجارة.",
 "巻き上げ": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رفع (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / شال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها) / مِصْعَد, أَصَنْصِير\nمثال: رفع سامي نظارته.",
 "巻き上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رَافِعَة\nمثال: رفع سامي نظارته.",
 "巻き取り": "تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "巻き取る": "رِيح, ريح / لَفَّ",
 "巻き尺": "شَرْيِط قِيَاس",
 "巻き揚げ": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رفع (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / شال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها) / مِصْعَد, أَصَنْصِير\nمثال: رفع سامي نظارته.",
 "巻き毛": "جَعْدَة",
 "巻き添い": "اِنْخِرَاط, مُشَارَكَة (فعل المشاركة في أنشطة المجموعة) / انشغال, اهتمام (شعور بالاهتمام والفضول تجاه شخص أو شيء ما) / انْخِرَاط, تَوَرُّط (علاقة اشتمال أو احتواء) / انخراط, مشاركة (حالة المشاركة مع الآخرين (كزملاء أو شركاء وما إلى ذلك))\nمثال: حاول المعلم زيادة مشاركة طلابه في الأنشطة الصفية",
 "巻き添え": "اِنْخِرَاط, مُشَارَكَة (فعل المشاركة في أنشطة المجموعة) / انشغال, اهتمام (شعور بالاهتمام والفضول تجاه شخص أو شيء ما) / انْخِرَاط, تَوَرُّط (علاقة اشتمال أو احتواء) / انخراط, مشاركة (حالة المشاركة مع الآخرين (كزملاء أو شركاء وما إلى ذلك))\nمثال: حاول المعلم زيادة مشاركة طلابه في الأنشطة الصفية",
 "巻き添え被害": "أَضْرَار جَانِبِيَّة",
 "巻き爪": "ظفر غائر, ظفر ناشب (ظفر قدم تكون طرفه الحر أو حوافه مغروسة في اللحم المحيط)",
 "巻き物": "وِشَاح, لِفاع",
 "巻き狩り": "اِصْطَادَ, صَادَ / صَيْد, مُطارَدَة",
 "巻き癖": "جَعْدَة",
 "巻き立て": "بِطَانَة",
 "巻き脚絆": "لفافة ساق (شريط من القماش يلف حول الساق لتشكيل غطاء للساق؛ استخدمه الجنود في الحرب العالمية الأولى)",
 "巻き貝": "حَلَزُون",
 "巻き起こす": "خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق. / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "巻き起こる": "نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "巻き軸": "طُومَار",
 "巻き返し": "تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب. / تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "巻き返す": "تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب.",
 "巻き雲": "ذُؤَابَة / طَخَاء",
 "巻き鬚": "مِحْلَاق",
 "巻く": "رِيح, ريح / لَفَّ / مُغَلَّف, لِفَافَة / غِلَاف / تَنُّورَة, جُوب / وَصْلَة",
 "巻タバコ": "سِيجَارَة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض التدخين)\nمثال: دخن زيري سيجارة.",
 "巻取り": "تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "巻取る": "رِيح, ريح / لَفَّ",
 "巻子": "بَكَرَة",
 "巻子本": "دَحْرَجَ, تَدَحْرَجَ / ثَنَى, لَفَّ (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "巻尺": "شَرْيِط قِيَاس",
 "巻層雲": "سمحاق طبقي (طبقة رقيقة موحدة من السحب الضبابية على ارتفاع عالٍ)",
 "巻島": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "巻帙": "كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد / غِطَاء وَاقٍ (الغطاء الطبيعي الصلب لبعض الكائنات الحية) / حماية, غطاء واقٍ (غطاء يهدف إلى الحماية من التلف أو الإصابة)\nمثال: لم يكن لديهم حماية من الغبار الذري",
 "巻毛": "جَعْدَة",
 "巻添い": "اِنْخِرَاط, مُشَارَكَة (فعل المشاركة في أنشطة المجموعة) / انشغال, اهتمام (شعور بالاهتمام والفضول تجاه شخص أو شيء ما) / انْخِرَاط, تَوَرُّط (علاقة اشتمال أو احتواء) / انخراط, مشاركة (حالة المشاركة مع الآخرين (كزملاء أو شركاء وما إلى ذلك))\nمثال: حاول المعلم زيادة مشاركة طلابه في الأنشطة الصفية",
 "巻添え": "اِنْخِرَاط, مُشَارَكَة (فعل المشاركة في أنشطة المجموعة) / انشغال, اهتمام (شعور بالاهتمام والفضول تجاه شخص أو شيء ما) / انْخِرَاط, تَوَرُّط (علاقة اشتمال أو احتواء) / انخراط, مشاركة (حالة المشاركة مع الآخرين (كزملاء أو شركاء وما إلى ذلك))\nمثال: حاول المعلم زيادة مشاركة طلابه في الأنشطة الصفية",
 "巻物": "وِشَاح, لِفاع",
 "巻狩": "اِصْطَادَ, صَادَ / صَيْد, مُطارَدَة",
 "巻狩り": "اِصْطَادَ, صَادَ / صَيْد, مُطارَدَة",
 "巻積雲": "ركام سمحاقي, سحاب قزعي (سحابة على ارتفاع عالٍ تتكون من سلسلة من السحب الصغيرة المرتبة بانتظام تشبه التموجات)",
 "巻立て": "بِطَانَة",
 "巻線": "تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "巻縮": "تَجْعِيدَة (خصلة شعر تم تمويجها أو تجعيدها صناعياً) / مجند بالإكراه (شخص يخدع الرجال أو يجبرهم على الخدمة كبحارة أو جنود) / انثناء, ثنية (شكل زاوي أو مستدير ناتج عن الطي)\nمثال: طية في المنديل",
 "巻耳": "أرقطيون كبير, لزيق (أرقطيون بأوراق على شكل قلب يوجد في الغابات المفتوحة والأسيجة والمراعي الوعرة في أوروبا (باستثناء أقصى الشمال) وآسيا الصغرى؛ يزرع أحياناً للاستخدام…) / خراق البحر, شبيط",
 "巻脚絆": "لفافة ساق (شريط من القماش يلف حول الساق لتشكيل غطاء للساق؛ استخدمه الجنود في الحرب العالمية الأولى)",
 "巻貝": "حَلَزُون",
 "巻軸": "طُومَار",
 "巻返し": "تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب. / تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "巻返す": "تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب.",
 "巻雲": "ذُؤَابَة / طَخَاء",
 "巻頭": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "巻頭言": "توطئة, ديباجة (مقال تمهيدي قصير يسبق نص كتاب)",
 "巻首": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "巻鬚": "مِحْلَاق",
 "巽": "باتجاه الجنوب الشرقي (إلى أو نحو أو في الجنوب الشرقي) / جَنُوب شَرْقِيّ (يقع في الجنوب الشرقي أو موجَّه نحوه) / قَادِم مِنَ الجَنُوب الشَّرْقِيّ (قادم من اتجاه الجنوب الشرقي) / جنوب شرق (موقع في الجزء الجنوبي الشرقي من بلد أو منطقة أو مدينة)",
 "巽位": "باتجاه الجنوب الشرقي (إلى أو نحو أو في الجنوب الشرقي) / جَنُوب شَرْقِيّ (يقع في الجنوب الشرقي أو موجَّه نحوه) / قَادِم مِنَ الجَنُوب الشَّرْقِيّ (قادم من اتجاه الجنوب الشرقي) / جنوب شرق (موقع في الجزء الجنوبي الشرقي من بلد أو منطقة أو مدينة)",
