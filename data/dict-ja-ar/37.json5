{
 "寸法": "قياس (فعل أو عملية تعيين أرقام للظواهر وفقًا لقاعدة)\nمثال: تمت القياسات بعناية / خِطَّة, خُطَّة / خَطَّطَ (وضع خطة مُحكَمة لتحقيق هدف معين؛ رسم خطوط أو تقسيم مساحة بخطوط) / نَوَى, بلاني\nمثال: خطط زيري لهجومه.",
 "寸法記入": "تَبْعِيدِيّ, قِيَاسِيّ (يُشير إلى أو يُحدد الحجم والموضع في الفضاء)",
 "寸秒": "عَزْم / لَحْظَة, دَقِيقَة",
 "寸簡": "رسالة قصيرة, ملاحظة (رسالة شخصية قصيرة)\nمثال: اكتب لي رسالة قصيرة عندما تصل هناك / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "寸翰": "رسالة قصيرة, ملاحظة (رسالة شخصية قصيرة)\nمثال: اكتب لي رسالة قصيرة عندما تصل هناك / حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "寸胴": "أُسْطُوَانِيّ (ذو شكل الأسطوانة) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة)\nمثال: مصطلح غير محدد (مبهم) / قدر مرق (وعاء يستخدم لإعداد مرق الحساء)",
 "寸胴鍋": "قدر مرق (وعاء يستخدم لإعداد مرق الحساء)",
 "寸言": "دعابة, نكتة ذكية (ملاحظة بارعة)",
 "寸詰まり": "قَلِيلًا",
 "寸詰り": "قَلِيلًا",
 "寸足らず": "قَلِيلًا / بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)\nمثال: الجو دافئ قليلاً",
 "寸鉄": "إبيجرام, قول فطن (قول ذكي أو ظريف)",
 "寸陰": "عَزْم / لَحْظَة, دَقِيقَة",
 "寸隙": "وقت الفراغ, وقت حر (الوقت الخالي من الواجبات أو المسؤوليات) / وقت حر, وقت فراغ (الوقت المتاح للهوايات والأنشطة الأخرى التي تستمتع بها)",
 "寺": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع",
 "寺下": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
