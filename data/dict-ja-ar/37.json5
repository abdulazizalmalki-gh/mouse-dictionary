 "幸いにも": "لحسن الحظ (بواسطة الحظ الجيد)\nمثال: لحسن الحظ كان الطقس جيداً",
 "幸い茸": "فطر الرف, فطر قوسي (فطر خشبي يشكل حوامل بوغية تشبه الرف على جذوع الأشجار والهياكل الخشبية)",
 "幸せ": "سَعَادَة, فَرَح",
 "幸久保": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "幸先": "لافِتَة / وَقَّعَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "幸原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "幸平": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "幸有る": "سَعِيد, وَرْدِيّ (ينبئ بحظ جيد وطالع حسن) / ذَهَبِيّ, مَحْظُوظ (محظوظ بدرجة عُليا ومُفضَّل) / محظوظ (يتمتع بحظ جيد غير متوقع)\nمثال: أطفال آخرون، أقل حظاً، ماتوا",
 "幸有れ": "حَظًّا مُوَفَّقًاَ ((حَظَا) فلان حظوا: مشى رويدا)\nمثال: حظا سعيدا يا زيري.",
 "幸福": "سَعَادَة, فَرَح",
 "幸福主義": "مذهب السعادة (نظام أخلاقي يقيم الأفعال بالإشارة إلى الرفاهية الشخصية من خلال حياة قائمة على العقل)",
 "幸福感": "اِبْتِهَاج, نَشْوَة (البَهْجَةُ: الحُسْنُ يُقَال: رَجُلٌ ذُو بَهْجَةٍ؛ وَيُقَال: هُوَ حُسْنُ لَونِ الشيْءِ ونَضَارَتُه، وَقيل: هُوَ فِي النّباتِ النضَارَةُ…؛ (بَهُجَ، ككَرُمَ) بَهْجَةً و (بَهاجَةً) وبَهَجَاناً (فَهُوَ بَهِيجٌ، و) امرأَةٌ بَهِجَةٌ: مُبْتَهِجَةٌ، وَقد بَهُجَتْ بَهْجَةً، و (هِيَ مِبْهَاجٌ)…)",
 "幸福追求権": "حق السعي وراء السعادة (الحق في محاولة العثور على السعادة)",
 "幸茸": "فطر الرف, فطر قوسي (فطر خشبي يشكل حوامل بوغية تشبه الرف على جذوع الأشجار والهياكل الخشبية)",
 "幸薄": "غَيْر مُبَشِّر, مَشْؤُوم (غير مبشر؛ ينذر بالسوء) / غَيْر مُلَائِم, مُؤْسِف (غَيْر مُنَاسِب أَوْ مُؤْسِف الاخْتِيَار) / سيء الحظ, مؤسف (غير مفضل من قبل الحظ؛ يتسم أو يرافقه أو ينتج عنه سوء طالع) / بائِس, سَيِّئ الحَظّ (شخص يعاني من سوء الحظ أو المصائب)\nمثال: تحول مؤسف للأحداث",
 "幸薄い": "غَيْر مُبَشِّر, مَشْؤُوم (غير مبشر؛ ينذر بالسوء) / غَيْر مُلَائِم, مُؤْسِف (غَيْر مُنَاسِب أَوْ مُؤْسِف الاخْتِيَار) / سيء الحظ, مؤسف (غير مفضل من قبل الحظ؛ يتسم أو يرافقه أو ينتج عنه سوء طالع) / بائِس, سَيِّئ الحَظّ (شخص يعاني من سوء الحظ أو المصائب)\nمثال: تحول مؤسف للأحداث",
 "幸運": "بِالتَّوْفِيق!, حَظًّا سَعِيدًا!",
 "幹": "جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر) / عَمُود فَقْرِيّ / دِعَامَة / شَجَاعَة / جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر) / خُرْطُوم / صَنْدُوق, صُنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / حَقِيبَة أَمْتِعَة, صُنْدُوقُ السَّيَّارَةِ\nمثال: أين صندوق البريد؟ / قصبة الريشة (العمود الفقري المجوف للريشة) / عمود دوار, عمود نقل الحركة (قضيب دوار ينقل الطاقة أو الحركة) / سارية, عمود (قضيب أو عمود طويل (خاصة مقبض أداة أو جسم سلاح مثل الرمح أو السهم)) / بئر, عمود (ممر رأسي طويل محفور في الأرض، كما لمنجم أو نفق) / مِقْبَض",
 "幹事": "سكرتير تنفيذي (سكرتير لديه واجبات ومسؤوليات إدارية)",
 "幹事長": "أمين سر (عضو في مجلس الوزراء البريطاني)",
 "幹理": "إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة)",
 "幹竹": "خيزران الخشب العملاق, ماداكي (خيزران كبير له سيقان سميكة الجدران؛ موطنه الصين وربما اليابان؛ يُزرع على نطاق واسع في أماكن أخرى)",
 "幹細胞": "خَلِيَّة جِذْعِيَّة",
 "幹線": "خط رئيسي (المسار الرئيسي لنظام النقل)",
 "幹線道": "طَرِيق رَئِيسِيّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "幹線道路": "طَرِيق رَئِيسِيّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "幹部": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة شؤون الجهة، حكومية كانت أم خاصة)\nمثال: والدتي تنتظرني في الإدارة.",
 "幹部会": "مَجْلِس إِدَارَة",
 "幻": "سَرَاب, شَبَح / سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا)",
 "幻人": "سَاحِر",
 "幻像": "سَرَاب, شَبَح",
 "幻夢": "حُلْم, رُؤْيَا (رأى في نومه) / حُلْم, أَحْلام (رأى في نومه) / حَلَمَ (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "幻妖": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر.",
 "幻妻": "زَوْجَة, اِمْرَأَة / دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "幻姿": "شَبَح, شَبْح",
 "幻影": "سَرَاب, شَبَح",
 "幻影肢": "طرف وهمي (الوهم بأن طرفاً لا يزال موجوداً بعد بتره)",
 "幻惑": "انْبِهَار, سِحْر (القدرة على جذب اهتمام شديد) / افتتان, انبهار (شعور بإعجاب كبير بشيء رائع وغير عادي) / افتتان, انبهار (حالة الاهتمام الشديد بشيء ما (كما في الرهبة أو الإعجاب أو الرعب))\nمثال: سحر الأطفال بحيل سحرية وفتن أخرى",
 "幻惑的": "آسِر, سَاحِر (يأسر الاهتمام كأنّه يسحر سحرًا) / آسِر, شَائِق (قادر على جذب الانتباه والاستحواذ عليه)",
 "幻想": "خَيَال (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول) / فَنْتَازِيَا\nمثال: يحب الخيال العلمي.",
 "幻想曲": "خَيَال (الخَيَّالُ : صَاحبُ الخيول؛ الخَيَّالُ : فارس الخيول) / فَنْتَازِيَا\nمثال: يحب الخيال العلمي.",
 "幻想的": "رَائِع",
 "幻日": "شمس كاذبة, شمس وهمية (بقعة ساطعة على الدائرة الشمسية؛ ناتجة عن انكسار الضوء بواسطة بلورات الجليد)\nمثال: عادة ما تُرى شمسين وهميتين أو أكثر في وقت واحد",
 "幻日環": "حلقة شمسية, هالة شمسية (هالة مضيئة موازية للأفق عند ارتفاع الشمس؛ تسببها بلورات الجليد في الغلاف الجوي)",
 "幻滅": "تحرر من الوهم, زوال الوهم (التحرر من الاعتقاد الخاطئ أو الأوهام)",
 "幻灯": "اِنْزَلَقَ, تَزَحْلَقَ / زَحْلِيقَة, مَزْلَقَة / الفانوس السحري (شكل مبكر من أجهزة عرض الشرائح)",
 "幻灯機": "الفانوس السحري (شكل مبكر من أجهزة عرض الشرائح)",
 "幻燈": "اِنْزَلَقَ, تَزَحْلَقَ / زَحْلِيقَة, مَزْلَقَة / الفانوس السحري (شكل مبكر من أجهزة عرض الشرائح)",
 "幻聴": "هلوسة سمعية (إدراك سمعي وهمي لأصوات غريبة غير لفظية)",
 "幻肢": "طرف وهمي (الوهم بأن طرفاً لا يزال موجوداً بعد بتره)",
 "幻術": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر.",
 "幻視": "هلوسة بصرية (إدراك بصري وهمي)",
 "幻覚": "هَلْوَسَة, وَهْم / هَلْوَسَة",
 "幻覚作用": "مُهَلْوِس (قادر على إحداث هلوسات)",
 "幻覚剤": "عقار مهلوس, مهلوس (عقار ذو تأثير نفسي يحفز الهلاوس أو تجارب حسية متغيرة)",
 "幻覚症": "حالة هلوسة, هلاس (حالة عقلية يعاني فيها الشخص من هلوسات مستمرة)",
 "幻覚症状": "هَلْوَسَة, وَهْم / هَلْوَسَة",
 "幻覚薬": "عقار مهلوس, مهلوس (عقار ذو تأثير نفسي يحفز الهلاوس أو تجارب حسية متغيرة)",
 "幼": "صَغِير, حَدَث / رضاعة, طفولة مبكرة (أبكر مراحل عدم النضج) / طفولة مبكرة, مهد (المرحلة المبكرة من النمو أو التطور)",
 "幼い": "صَغِير, صغير / قَلِيلاً, قَلِيل / طُفُولِيّ / صَغِير, حَدَث",
 "幼き": "طُفُولِيّ",
 "幼けない": "صَغِير, حَدَث",
 "幼な妻": "عُرُوس طِفْلَة",
 "幼な子": "رَضِيع",
 "幼児": "رَضِيع / طِفْل دَارِج (الصَغِير السِنّ من الحَيْوَان أو الإنْسَان، وَلَد الإنسان أو الحيوان؛ الإنسان منذ أن تلده أمه حتى يَبْلُغ)\nمثال: هو طفل العائلة.",
 "幼児ポルノ": "استغلال الأطفال إباحيا, مواد إباحية للأطفال (الاستخدام غير القانوني للأطفال في الصور أو الأفلام الإباحية)",
 "幼児好き": "بيدوفيليا, ولع بالأطفال (الانجذاب الجنسي للأطفال)",
 "幼児性愛者": "بيدوفيل, متحرش بالأطفال (شخص بالغ ينجذب جنسياً للأطفال)",
 "幼児教育": "طفولة مبكرة, مهد (المرحلة المبكرة من النمو أو التطور)",
 "幼児期": "طفولة مبكرة, مهد (المرحلة المبكرة من النمو أو التطور)",
 "幼児死亡率": "مُعَدَّل وَفَيَات الرُّضَّع (معدل الوفيات خلال السنة الأولى من الحياة)",
 "幼児殺し": "قتل الرضيع, وأد (قتل طفل رضيع) / قاتل الرضيع (شخص يقتل رضيعاً)",
 "幼児突然死症候群": "متلازمة موت الرضيع المفاجئ (موت مفاجئ وغير متوقع لرضيع يبدو بصحة جيدة أثناء النوم)",
 "幼児虐待": "إِسَاءَة مُعَامَلَة لِلْأَطْفَال, إِسَاءَة مُعَامَلَة الْأَطْفَال",
 "幼児語": "كلام الأطفال (الكلام النامي للطفل الصغير) / محاكاة كلام الأطفال (تقليد شخص بالغ لكلام طفل صغير)",
 "幼卒": "جاهل, غير متعلم (شخص يفتقر للمعرفة)",
 "幼女": "طِفْلة",
 "幼妻": "عُرُوس طِفْلَة",
