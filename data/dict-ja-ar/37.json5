 "尚書省": "وزارة الخارجية, وزارة الخارجية الأمريكية (الإدارة الفيدرالية في الولايات المتحدة التي تضع وتحافظ على السياسات الخارجية)\nمثال: تأسست وزارة الخارجية عام 1789",
 "尚武": "عَسْكَرِيَّة",
 "尠からず": "إلى حد كبير, بشكل جوهري (إلى مدى أو درجة كبيرة)\nمثال: أخشى أن الفيلم تجاوز الميزانية بكثير",
 "尠くとも": "عَلَى اَلْأَقَلّ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "尠くも": "عَلَى اَلْأَقَلّ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "尤": "رَفِيع, فَائِق (فائق الجودة بشكل استثنائي)",
 "尤なる": "رَفِيع, فَائِق (فائق الجودة بشكل استثنائي)",
 "尤も": "أَكْثَر, أَغْلَب\nمثال: إنها غالية جدا!",
 "尤もらしい": "قابل للتصديق, معقول (يبدو معقولاً وموثوقاً، وبالتالي مقنعاً)\nمثال: عذر وجيه / جَادّ, صَادِق (يتّسم بإيمان ثابت وجادّ بأهمية الشيء ذاته)",
 "尤度": "إِمْكَانِيَّة, احْتِمَال (احتمالية نتيجة محددة)",
 "尨大": "ضَخْم, هَائِل",
 "尨毛": "نسيان النص, هفوة (خطأ (خاصة نسيان الممثل للسطور))",
 "尨犬": "أَشْعَث, كَثِيفُ الشَّعْر ((لِلشَّعْرِ) كَثِيفٌ وَسَيِّئُ التَّصْفِيف)",
 "尭々": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال",
 "尭尭": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه)\nمثال: بدأ يبكي بصوت عال",
 "尰": "مأزق, ورطة (موقف يصعب الخلاص منه، خاصة إذا كان مزعجاً أو شاقاً)",
 "就いては": "التَّالِي فِي التَّسَلْسُل, فِي الدَّوْر (يأتي تاليًا في تسلسل الخلافة أو التوالي)\nمثال: انتظروا في طابور للتذاكر",
 "就く": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي. / صَعِد / نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم. / ذَاكَرَ, دَرَسَ\nمثال: أراك بعد الدرس.",
 "就ける": "رَكَّبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا…)\nمثال: ركب ياني سفينة. / رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء…) / تعيين شخص لعمل ما",
 "就中": "خُصُوصًا, خَاصَّةً",
 "就任": "افتراض, تولي (فعل حيازة أو تولي السلطة على شيء ما)\nمثال: تزامنت توليه المنصب مع الاضطرابات في كوبا",
 "就任式": "تَنْصِيب",
 "就働": "تَشْغِيلِيّ, عَمَلِيّ (يُمكّن من العمل أو النشاط اللاحق أو يُسهّله)",
 "就労": "تَشْغِيلِيّ, عَمَلِيّ (يُمكّن من العمل أو النشاط اللاحق أو يُسهّله)",
 "就塒": "مجثم (مجثم تستريح عليه أو تنام عليه الطيور الداجنة)",
 "就学": "تَسْجِيل",
 "就寝": "مُتَكَتِّم, مُتَوَارٍ (يتجنّب لفت الانتباه إلى نفسه؛ متحفّظ ومنسحب)",
 "就寝時間": "وقت النوم (الوقت الذي تذهب فيه إلى الفراش)",
 "就巣": "تَأَمُّلِيّ, مُتَدَبِّر (مُسْتَغْرِقٌ فِي تَفْكِيرٍ عَمِيقٍ وَجِدِّيّ)",
 "就床": "مُتَكَتِّم, مُتَوَارٍ (يتجنّب لفت الانتباه إلى نفسه؛ متحفّظ ومنسحب)",
 "就業": "وَظِيفَة, تَوْظِيف (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟",
 "就業人口": "أيدي عاملة, قوة عاملة (قوة العمال المتاحة)",
 "就眠": "نوم (توقف الوعي وانخفاض معدل الأيض)",
 "就職口": "مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "就職指導": "إِرْشَاد مِهْنِيّ (الاستشارة حول الفرص الوظيفية)",
 "就蓐": "مُتَكَتِّم, مُتَوَارٍ (يتجنّب لفت الانتباه إلى نفسه؛ متحفّظ ومنسحب)",
 "就褥": "مُتَكَتِّم, مُتَوَارٍ (يتجنّب لفت الانتباه إلى نفسه؛ متحفّظ ومنسحب)",
 "尹": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير.",
 "尺": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون. / طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير. / مِسْطَرَة (أداة تستخدم لقياس الأطوال أو رسم الخطوط المستقيمة؛ خط مستقيم تحدده مِسطَرة أو…)\nمثال: استعارت المسطرة.",
 "尺を取る": "قِيَاس\nمثال: قاس طول السرير.",
 "尺八": "مَصّ قَضِيب, لَعْق قَضِيب (مَصَّ الرَّضِيعُ ثَدْيَ أُمِّهِ: رَضَعَ؛ مَصَّ العَصِيرَ: رَشَفَهُ رَشْفًا…)",
 "尺取": "دودة شبرية, دودة قياسة (يسروع صغير أملس له أرجل فقط في قطاعاته الأمامية والخلفية؛ معظمها يرقات لعث من…)",
 "尺取り虫": "دودة شبرية, دودة قياسة (يسروع صغير أملس له أرجل فقط في قطاعاته الأمامية والخلفية؛ معظمها يرقات لعث من…)",
 "尺取虫": "دودة شبرية, دودة قياسة (يسروع صغير أملس له أرجل فقط في قطاعاته الأمامية والخلفية؛ معظمها يرقات لعث من…)",
 "尺寸": "دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "尺度": "مقياس (أداة قياس لقياس وتوضيح كمية مثل سمك السلك أو كمية المطر وما إلى ذلك) / طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "尺拍子": "للسان الجرس, مصفق (مطرقة معدنية تتدلى داخل الجرس وتصدر صوتاً بضرب الجانب)",
 "尺牘": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء.",
 "尺蛾": "عثة هندسية (عثة نحيلة الجسم عريضة الأجنحة تسمى يرقاتها الديدان القياسية)",
 "尺骨": "زِنْد (زَنَّدَ: أوْرَى زَنْدُه؛ زَنَّدَ كذَبَ)",
 "尺骨動脈": "شريان زندي (شريان كبير يتفرع من الشريان العضدي لتغذية عضلات الساعد والرسغ واليد)",
 "尺鷸": "كَرَوَان",
 "尻": "حِمَار (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه…)\nمثال: هن بحاجة لحمار. / خَلْفِيّ / أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته / أسفل, جانب سفلي (الجانب السفلي من أي شيء) / نِهَايَة, غَايَة\nمثال: انتهى أمر زيري. / عَاقِبَة",
 "尻かっちん": "أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "尻がおもい": "كَسْلَان / أَخْرَق",
 "尻が軽い": "عميق\nمثال: صام ياني رمضان. / غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / دَاعِر, فَاجِر (متساهل وغير منضبط في السلوك الجنسيّ)",
 "尻が重い": "كَسْلَان / أَخْرَق",
 "尻が青い": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "尻こそばゆい": "قَلِق, قَلِقَة (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "尻すぼまり": "ضَعِيف, مُوَهَّن (مُنخفِض القوّة أو الشدّة)",
 "尻すぼみ": "تخفيض تدريجي, تدريج (عملية تقليل الحجم أو الكمية تدريجياً)\nمثال: وصف الطبيب تخفيضاً تدريجياً للجرعة",
 "尻たたき": "خَفِيفُ الحَرَكَة, نَشِيط (سريع ومفعم بالطاقة والحيوية)",
 "尻たぶ": "دُبْر, رِدْف (ضد القُبُل؛ من كل شيء عقبه ومؤخره؛ دُبُر الصلاة؛ بعدها مباشرة)\nمثال: دبر المحامي وسلية لهرب توم من السجن.",
 "尻っぺた": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "尻っぽ": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته / ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند…)\nمثال: عذر أقبح من ذنب.",
 "尻つぼみ": "تخفيض تدريجي, تدريج (عملية تقليل الحجم أو الكمية تدريجياً)\nمثال: وصف الطبيب تخفيضاً تدريجياً للجرعة",
 "尻にしく": "سَيْطَرَ",
 "尻に敷く": "سَيْطَرَ",
 "尻の穴": "اِسْت (فتحة الدُبُر أو مقعد الإنسان؛ الأصل والأساس)",
 "尻の穴が小さい": "تَافِه, ضَيِّق النَّظَر (مَحْدُود الأُفُق بِشَكْلٍ مُحْتَقَر)",
 "尻ぺた": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "尻ぺんぺん": "خَفِيفُ الحَرَكَة, نَشِيط (سريع ومفعم بالطاقة والحيوية)",
 "尻もち": "خطأ فادح, زلة (خطأ محرج)",
 "尻をあげる": "قَامَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه. / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "尻をたたく": "صَفَعَ, سَتَهَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين)\nمثال: صفع المدرس مؤخرتي.",
 "尻をまくる": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا…)\nمثال: ضوء القمر ضعيف.",
 "尻を上げる": "قَامَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه. / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "尻を叩く": "صَفَعَ, سَتَهَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين)\nمثال: صفع المدرس مؤخرتي.",
 "尻を据える": "جَلَسَ, قَعَدَ (قَعَدَ)\nمثال: جلس سامي مجددا.",
 "尻を捲る": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا…)\nمثال: ضوء القمر ضعيف.",
 "尻カッチン": "أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "尻上がり": "تَحْسِين",
 "尻上り": "تَحْسِين",
 "尻取": "لعبة كلمات (أي لعبة تنطوي على تكوين أو تغيير أو اكتشاف الكلمات)",
 "尻取り": "لعبة كلمات (أي لعبة تنطوي على تكوين أو تغيير أو اكتشاف الكلمات)",
 "尻叩き": "خَفِيفُ الحَرَكَة, نَشِيط (سريع ومفعم بالطاقة والحيوية)",
 "尻尾": "ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند…)\nمثال: عذر أقبح من ذنب. / أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "尻尾を振る": "تَمَلَّقَ, تَبَصْبَصَ",
 "尻座": "انحناء, جثوم (عملية الانحناء المنخفض مع ضم الأطراف للجسم)",
 "尻抜け": "كثرة النسيان, نسيان (الميل للنسيان)\nمثال: ازداد سهوه مع تقدمه في السن",
 "尻押し": "دعم, مؤازرة (فعل تقديم الموافقة والدعم)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين / إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة))",
 "尻癖": "سَلَس ((سَلُسَ) يَسْلُسُ سَلاسَةً: لانَ وسَهُلَ وانقادَ، فهو سَلِيسٌ)",
 "尻目": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "尻目にかける": "تَرَفَّعَ",
 "尻目に懸ける": "تَرَفَّعَ",
 "尻相撲": "مُتَتَالٍ, مُتَعَاقِب (واحد تلو الآخر دون انقطاع)",
 "尻穴": "اِسْت (فتحة الدُبُر أو مقعد الإنسان؛ الأصل والأساس) / فتحة الشرج (فِي اللُّغَةِ الْعَرَبِيَّةِ (إعراب) : الفَتْحَة أو الفَتْح هي إحدى الحركات…)\nمثال: انظر من الفتحة.",
 "尻窄まり": "ضَعِيف, مُوَهَّن (مُنخفِض القوّة أو الشدّة)",
 "尻窄み": "تخفيض تدريجي, تدريج (عملية تقليل الحجم أو الكمية تدريجياً)\nمثال: وصف الطبيب تخفيضاً تدريجياً للجرعة",
 "尻繋": "ثَفَر, قُوش ((ثَفَّرَ) الدَّابَّة: سَاقهَا من خلفهَا)",
 "尻肉": "ردف, كفل (جزء الحيوان الذي يقابل الأرداف البشرية)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "尻臀": "دُبْر, رِدْف (ضد القُبُل؛ من كل شيء عقبه ومؤخره؛ دُبُر الصلاة؛ بعدها مباشرة)\nمثال: دبر المحامي وسلية لهرب توم من السجن.",
 "尻軽": "فَضْفَاض, واسِع / سَرِيع\nمثال: ينبح كلب في الحي. / طَفْح, طَفْح جِلْدِيّ",
 "尻輪": "حافة السرج الخلفية, قادمة السرج (الجزء الخلفي من مقعد السرج)",
 "尻込み": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد)\nمثال: كان هناك تردد في كلامه",
 "尻重": "بطيء الحركة, بليد (شخص يتحرك ببطء)",
 "尻餅": "خطأ فادح, زلة (خطأ محرج)",
 "尼": "أخت (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على…)\nمثال: ماري هي أخت توم / ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع) / نَهْر الأمازون, الأَمَزونْ (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ…)\nمثال: عبر جوناس النهر. / إِنْدُونِيسِيَا",
 "尼っちょ": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع)",
 "尼っ子": "امرأة, فتاة (مصطلحات غير رسمية لامرأة (شابة))",
 "尼僧": "أخت (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على…)\nمثال: ماري هي أخت توم",
 "尼僧院": "دَيْر, رَهْبَنَة نِسْوِيّ (بيت يسكنه الرُهْبَان أو الرَاهِبَات ممن كان على دين المسيحية)\nمثال: سيداتي و سادتي ، رجاء قفوا للنشيد الوطني للاتحاد الروسي باداء جوقة دير سرتينسكي .",
 "尼国": "إِنْدُونِيسِيَا",
 "尼寺": "دَيْر, رَهْبَنَة نِسْوِيّ (بيت يسكنه الرُهْبَان أو الرَاهِبَات ممن كان على دين المسيحية)\nمثال: سيداتي و سادتي ، رجاء قفوا للنشيد الوطني للاتحاد الروسي باداء جوقة دير سرتينسكي .",
 "尼崎": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "尼法師": "رَاهِبَة",
 "尼港": "نِيكُولَايِفْسْك نَا أَمُور",
 "尽": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم) / نِهَايَة, غَايَة\nمثال: انتهى أمر زيري.",
 "尽かす": "اِسْتَهْلَكَ, اِسْتَنْفَدَ / تَنَازَلَ",
 "尽きせぬ": "أَبَدِيّ",
 "尽きない": "أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى)",
 "尽く": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً",
 "尽くした": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "尽くす": "اِسْتَهْلَكَ, اِسْتَنْفَدَ / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "尽くめ": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً",
 "尽れる": "صَعَقَ",
 "尽力": "جَهْد, جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ…)\nمثال: لا إنجاز بلا جهد .",
 "尽忠": "وَفَاء, إِخْلَاص",
 "尽日": "طِوَال اليَوْم, نَهَارًا (خلال اليوم بأكمله)\nمثال: الضوء يتدفق طوال اليوم في الغرفة / يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "尽未来": "أبدياً, إلى الأبد (لوقت غير محدود)\nمثال: لا أحد يستطيع العيش إلى الأبد",
 "尽滅": "إِفْنَاء, تَدْمِير",
