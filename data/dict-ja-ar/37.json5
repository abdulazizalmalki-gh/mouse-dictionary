 "少くとも": "عَلَى اَلْأَقَلّ (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى الأَقَلِّ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "少し": "قَلِيلًا",
 "少しく": "قَلِيلًا",
 "少しずつ": "بوصة بوصة, شيئاً فشيئاً (بمسافة قصيرة) / تدريجياً, شيئاً فشيئاً (جزءاً صغيراً في كل مرة)\nمثال: حركوه بوصة بوصة",
 "少しづつ": "بوصة بوصة, شيئاً فشيئاً (بمسافة قصيرة) / تدريجياً, شيئاً فشيئاً (جزءاً صغيراً في كل مرة)\nمثال: حركوه بوصة بوصة",
 "少しでも": "على الإطلاق, ولو قليلاً (إلى أي مدى كان)\nمثال: هل أنت مهتم ولو قليلاً؟",
 "少しでもはやく": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "少しでも早く": "فِي أَقْرَب وَقْت مُمْكِن, فِي أَسْرَع وَقْت مُمْكِن (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "少しも": "أبداً",
 "少し間をおいて": "قَلِيلًا",
 "少し間を置いて": "قَلِيلًا",
 "少ない": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "少なからず": "إلى حد كبير, بشكل جوهري (إلى مدى أو درجة كبيرة)\nمثال: أخشى أن الفيلم تجاوز الميزانية بكثير",
 "少なからぬ": "كبير, معتبر (كبير أو كبير نسبياً في العدد أو الكمية أو المدى أو الدرجة)\nمثال: كمية معتبرة",
 "少なくとも": "عَلَى اَلْأَقَلّ (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى الأَقَلِّ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "少なくなる": "تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "少なくも": "عَلَى اَلْأَقَلّ (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى الأَقَلِّ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "少なく成る": "تخفيض, تقليل (عملية إنقاص أو تقليل شيء ما) / انخفاض, تناقص (المقدار الذي ينخفض به شيء ما) / انخفاض, تراجع (تغير نحو الأسفل) / انخفاض, تناقص (عملية التحول إلى أصغر أو أقصر)\nمثال: كان هناك انخفاض في درجة حرارته مع هدوء الحمى",
 "少なげ": "شح, ندرة (كمية صغيرة وغير كافية)",
 "少佐": "رَائِد",
 "少壮": "شَبَاب / شَبَاب, صِبًا / شَابّ",
 "少壮有為": "نَشِيط",
 "少壮気鋭": "مُجْتَهِد, نَشِيط (يعمل بجدّ لتعزيز مشروع أو مؤسّسة)",
 "少女": "بِنْت / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة) / طِفْلة / بنت / فتاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "少女子": "بِنْت / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة) / طِفْلة / بنت / فتاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "少妹": "أخت صغرى (أخت أصغر سناً) / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "少将": "لواء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "少尉": "ملازم ثان (ضابط مفوض في الجيش أو القوات الجوية أو المارينز يحمل أدنى رتبة)",
 "少年": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى. / سَاذَج, صِبْيَانِيّ (يُظهر أو يوحي بافتقار إلى النضج) / شبابي, صبياني (متعلق بالأطفال أو الشباب أو مميز لهم أو مناسب لهم) / حدث, قاصر (شخص صغير السن لم يكتمل نموه بعد)\nمثال: سكري الأحداث",
 "少年労働": "عمالة الأطفال (مؤنث عَمَّال بمعنى صيغة مبالغة في العَمَل؛ في : هم العُمَّال؛ جمع عَامِل، وقد يكون جمع عَمَّال)",
 "少年団": "الكشافة, فتيان الكشافة (حركة دولية (لكنها لامركزية) بدأت في عام 1908 في إنجلترا بهدف تعليم المواطنة الصالحة للفتيان)",
 "少年審判所": "محكمة الأحداث (محكمة لها اختصاص على الأطفال المعالين والجانحين)",
 "少年愛": "اشتهاء الغلمان, لواط بالأطفال (العلاقات الجنسية بين رجل وصبي (عادة الجماع الشرجي مع الصبي كشريك سلبي))",
 "少年愛嗜好": "بيدوفيليا, ولع بالأطفال (الانجذاب الجنسي للأطفال)",
 "少年感化院": "إصلاحية, دار رعاية الأحداث (مؤسسة إصلاحية لاحتجاز وتأديب وتدريب الأحداث أو المجرمين لأول مرة)",
 "少年期": "مُرَاهَقَة",
 "少年犯罪": "انحراف الأحداث, جنوح (سلوك معاد للمجتمع ينتهك القانون يرتكبه قاصر)",
 "少年犯罪者": "جانح, حدث جانح (مذنب شاب)",
 "少年裁判所": "محكمة الأحداث (محكمة لها اختصاص على الأطفال المعالين والجانحين)",
 "少年院": "إصْلاحِيّ, تَهْذيبِيّ (يَهْدِف إلى الإصْلاح والتَّهْذيب) / إصلاحية, دار رعاية الأحداث (مؤسسة إصلاحية لاحتجاز وتأديب وتدريب الأحداث أو المجرمين لأول مرة)",
 "少弟": "أخ أصغر (أخ أصغر سناً)\nمثال: احتفل أخي الصغير للتو بعيد ميلاده الخمسين / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "少慰": "ملازم ثان (ضابط مفوض في الجيش أو القوات الجوية أو المارينز يحمل أدنى رتبة)",
 "少憩": "أنبوب التنفس, سنوركل (ممر هوائي يوفره جهاز قابل للسحب يحتوي على أنابيب سحب وعادم؛ يسمح للغواصة بالبقاء تحت الماء لفترات طويلة) / فترة التقاط الأنفاس, متنفس (استراحة قصيرة)",
 "少数": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
