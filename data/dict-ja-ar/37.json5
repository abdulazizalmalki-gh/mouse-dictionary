 "少数者": "أَقَلِّيَّة",
 "少欲": "قَلِيلًا",
 "少監": "مُفَتِّش, مُفَتِّشَة",
 "少童": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "少糖": "سكريات قليلة التعدد, قليل السكاريد (أي من الكربوهيدرات التي تنتج عددًا قليلًا فقط من جزيئات السكر الأحادي عند التحلل المائي الكامل)",
 "少糖類": "سكريات قليلة التعدد, قليل السكاريد (أي من الكربوهيدرات التي تنتج عددًا قليلًا فقط من جزيئات السكر الأحادي عند التحلل المائي الكامل)",
 "少者": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي))",
 "少許": "قَلِيلًا",
 "少資本": "حرف كبير مصغر (حرف له شكل الحرف الكبير ولكن بنفس ارتفاع الأحرف الصغيرة)",
 "少閑": "ركود, هدوء مؤقت (فترة من الطقس الهادئ) / فترة هدوء, هوداة (توقف تكون فيه الأمور هادئة أو الأنشطة متناقصة)\nمثال: كان هناك هدوء مؤقت في العاصفة",
 "少関": "ركود, هدوء مؤقت (فترة من الطقس الهادئ) / فترة هدوء, هوداة (توقف تكون فيه الأمور هادئة أو الأنشطة متناقصة)\nمثال: كان هناك هدوء مؤقت في العاصفة",
 "少領": "رَائِد",
 "尖がった": "لَاذِع, مَقْصُود (مُبَاشِر وَوَاضِح فِي المَعْنَى أَوِ الإِشَارَة؛ غَالِبًا غَيْر مُسْتَحَبّ) / حاد الرأس, مدبب (له رأس حاد أو نقطة) / حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة. / مُسْتَفِز / لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ) / بَارِز, عَظِيم (ذو أهمّيّة أو دلالة كُبرى) / غَيْرُ مُسَدَّد, مُسْتَحَقّ (مُسْتَحَقٌّ كَدَيْن) / بَارِع, مُتَمَيِّز (يتميز عن غيره بالتفوق)",
 "尖った": "لَاذِع, مَقْصُود (مُبَاشِر وَوَاضِح فِي المَعْنَى أَوِ الإِشَارَة؛ غَالِبًا غَيْر مُسْتَحَبّ) / حاد الرأس, مدبب (له رأس حاد أو نقطة) / حَادّ (مَالَ وَانْحَرَفَ عَنِ الطَّرِيقِ؛ تَجَنَّبَ شَيْئًا أَوِ الْاِلْتِزَامَ بِمَسَارٍ مَعَيَّنٍ)\nمثال: عندك ذاكرة حادة. / مُسْتَفِز / لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ) / بَارِز, عَظِيم (ذو أهمّيّة أو دلالة كُبرى) / غَيْرُ مُسَدَّد, مُسْتَحَقّ (مُسْتَحَقٌّ كَدَيْن) / بَارِع, مُتَمَيِّز (يتميز عن غيره بالتفوق)",
 "尖らす": "شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو عاطفية لتحقيق هدف معين) / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "尖らせる": "شَحَذَ (سنّ شيئًا ليصبح حادًا أو أكثر قدرة على القطع؛ استثار أو حفّز قوة ذهنية أو عاطفية لتحقيق هدف معين) / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "尖り": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "尖りアーチ": "قوس مدبب (قوس بقمة مدببة؛ سمة من سمات العمارة القوطية)",
 "尖り屋根": "برج مستدق, قمة البرج (برج طويل يشكل البنية الفوقية لمبنى (عادة كنيسة أو معبد) ويضيق حتى يصل إلى نقطة في الأعلى)",
 "尖んがり": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "尖兵": "طَلِيعَة",
 "尖圭": "لَاذِع, مَقْصُود (مُبَاشِر وَوَاضِح فِي المَعْنَى أَوِ الإِشَارَة؛ غَالِبًا غَيْر مُسْتَحَبّ) / حاد الرأس, مدبب (له رأس حاد أو نقطة)",
 "尖圭コンジローマ": "ثؤلول تناسلي (ثؤلول حميد صغير على أو حول الأعضاء التناسلية والشرج)",
 "尖圭コンジローム": "ثؤلول تناسلي (ثؤلول حميد صغير على أو حول الأعضاء التناسلية والشرج)",
 "尖塔": "برج مستدق, قمة البرج (برج طويل يشكل البنية الفوقية لمبنى (عادة كنيسة أو معبد) ويضيق حتى يصل إلى نقطة في الأعلى)",
 "尖屋根": "برج مستدق, قمة البرج (برج طويل يشكل البنية الفوقية لمبنى (عادة كنيسة أو معبد) ويضيق حتى يصل إلى نقطة في الأعلى)",
 "尖度": "تَفَرْطُح",
 "尖形": "لَاذِع, مَقْصُود (مُبَاشِر وَوَاضِح فِي المَعْنَى أَوِ الإِشَارَة؛ غَالِبًا غَيْر مُسْتَحَبّ) / حاد الرأس, مدبب (له رأس حاد أو نقطة)",
 "尖形コンジローマ": "ثؤلول تناسلي (ثؤلول حميد صغير على أو حول الأعضاء التناسلية والشرج)",
 "尖形コンジローム": "ثؤلول تناسلي (ثؤلول حميد صغير على أو حول الأعضاء التناسلية والشرج)",
 "尖晶石": "لَعْل, إِسْبِينِل (يفيد التوقع مع الترجي؛ يفيد التوقع مع الإشفاق والخوف)\nمثال: لعل المجتهد ينجح.",
 "尖点": "نقطة الالتقاء (نقطة تتشكل من قوسين متقاطعين (كما في القوس القوطي)) / حدبة الأسنان, شرفة (ارتفاع صغير على سطح طحن الأسنان) / شرفة, وريقة (سديلة مثلثة رقيقة لصمام القلب)",
 "尖足": "حنف القدم, قدم حنفاء (تشوه خلقي في القدم يتميز عادةً بشكل ملتوي أو وضعية ملتوية للكاحل والكعب وأصابع القدم)",
 "尖部": "ذروَة (أعلى كلِّ شيء؛ أعلى نقطة أو أرفع موضع)",
 "尖鋭": "جَذْريّ / رَادِيكَالِيّ",
 "尖頭": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "尖頭アーチ": "قوس مدبب (قوس بقمة مدببة؛ سمة من سمات العمارة القوطية)",
 "尖頭器": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "尖鼠": "زَبَابَة",
 "尚": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة. / أَكْثَر / عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك / كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "尚お": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة. / أَكْثَر / عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك / كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "尚も": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "尚一層": "أَبْعَد, أَقْصَى (جعله بَعيدًا؛ جَاوَزَ الحَدَّ)\nمثال: أبعد صورتها عني.",
 "尚且つ": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / عِلَاوَة عَلَى ذٰلِكَ\nمثال: لا أعرف إلا هذا. / لٰكِن, لٰكِنَّ (يفيد الاستدراك ويسبقه نفي أو نهي ويليه اسم مفرد؛ يفيد الاستدراك)\nمثال: لكن لديك أطفال.",
 "尚又": "إِلَّا, بِٱسْتِثْنَاء (حرف استثناء؛ في : للسؤال المنفي، مرادف لبَلَى في الفصحى) / عِلَاوَة عَلَى ذٰلِكَ\nمثال: لا أعرف إلا هذا.",
 "尚古主義": "كلاسيكية (حركة في الأدب والفن خلال القرنين السابع عشر والثامن عشر في أوروبا فضلت العقلانية وضبط النفس والأشكال الصارمة)\nمثال: غالباً ما استمدت الكلاسيكية نماذجها من اليونان والرومان القدماء",
 "尚可": "أَفْضَل, مُفَضَّل (أَكْثَرُ اسْتِحْبَابًا مِنْ غَيْرِه) / مُحَبَّذ, مُفَضَّل (يُفضَّل على جميع الآخرين ويُعامَل بمحاباة)",
 "尚早": "ابتسار, سابق لأوانه (حالة كون الشيء سابقاً لأوانه)",
 "尚書": "قِسِّيس, دَاعِيَة (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ) / وَزِير, وَزِيرَة",
 "尚書き": "بند, شرط (شرط منصوص عليه)\nمثال: قبل بشرط واحد",
 "尚書省": "وزارة الخارجية, وزارة الخارجية الأمريكية (الإدارة الفيدرالية في الولايات المتحدة التي تضع وتحافظ على السياسات الخارجية)\nمثال: تأسست وزارة الخارجية عام 1789",
 "尚武": "عَسْكَرِيَّة",
 "尠からず": "إلى حد كبير, بشكل جوهري (إلى مدى أو درجة كبيرة)\nمثال: أخشى أن الفيلم تجاوز الميزانية بكثير",
 "尠くとも": "عَلَى اَلْأَقَلّ (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى الأَقَلِّ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "尠くも": "عَلَى اَلْأَقَلّ (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى الأَقَلِّ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "尤": "رَفِيع, فَائِق (فائق الجودة بشكل استثنائي) / بَاهِر, رَائِع (ذو تميز يفوق الوصف)",
 "尤なる": "رَفِيع, فَائِق (فائق الجودة بشكل استثنائي) / بَاهِر, رَائِع (ذو تميز يفوق الوصف)",
 "尤も": "أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "尤もらしい": "قابل للتصديق, معقول (يبدو معقولاً وموثوقاً، وبالتالي مقنعاً) / مَعْسُول الكَلَام, مُقْنِع زَيْفًا (يَتَّسِم بِتَقْدِيم حُجَج خَادِعَة تَبْدُو مَقْبُولَة)\nمثال: عذر وجيه / جَادّ, صَادِق (يتّسم بإيمان ثابت وجادّ بأهمية الشيء ذاته) / رَزِين, وَقُور (يتّسم بالوقار والرصانة في الطبع والسلوك)",
 "尤度": "إِمْكَانِيَّة, احْتِمَال (احتمالية نتيجة محددة)",
 "尨大": "ضَخْم, هَائِل",
 "尨毛": "نسيان النص, هفوة (خطأ (خاصة نسيان الممثل للسطور)) / زينة رخيصة, شيء تافه (شيء قليل القيمة أو الأهمية) / زغب, وبر (أي مادة ريشية خفيفة)",
 "尨犬": "أَشْعَث, كَثِيفُ الشَّعْر ((لِلشَّعْرِ) كَثِيفٌ وَسَيِّئُ التَّصْفِيف)",
 "尭々": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه) / مَسْطُول\nمثال: بدأ يبكي بصوت عال",
 "尭尭": "عَالٍ, اَلْعَالِي (افتقر واحتاج إلى مساعدة غيره المادية؛ عاله الشيء: اعوزه واحتاجه) / مَسْطُول\nمثال: بدأ يبكي بصوت عال",
 "尰": "مأزق, ورطة (موقف يصعب الخلاص منه، خاصة إذا كان مزعجاً أو شاقاً)",
 "就いては": "التَّالِي فِي التَّسَلْسُل, فِي الدَّوْر (يأتي تاليًا في تسلسل الخلافة أو التوالي) / بالصف, في طابور (واحد خلف الآخر في خط أو طابور) / عَلَى قَائِمَةِ الِانْتِظَار, فِي الطَّابُور (في انتظار شيء ما؛ خاصة شيء مستحقّ)\nمثال: انتظروا في طابور للتذاكر",
 "就く": "أَخَذَ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / أَخَذَ بِـ (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء)) / اِتَّخَذَ / اِسْتَغْرَقَ / اِلْتَقَطَ\nمثال: أخذ الولد يبكي. / صَعِد / نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / ذَاكَرَ, دَرَسَ / دَرَسَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرَسَ, تَعَلَّمَ ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / تَعَلُّم, دِرَاسَة (اكتسب معرفة أو خبرة أو مهارة) / مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: أراك بعد الدرس.",
 "就ける": "رَكَّبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا من الدواب)\nمثال: ركب ياني سفينة. / رَقَّى ((رَقَى) المريضَ ونحوَهُ يَرْقِي رَقْيًا، ورُقِيًّا، ورُقْيَةً (بضم الراء وفتحها): عوَّذَه؛ يقال: باسم الله أَرقِيك واللهُ يَشفيك) / رَوَّجَ (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / تعيين شخص لعمل ما",
 "就中": "خُصُوصًا, خَاصَّةً",
 "就任": "افتراض, تولي (فعل حيازة أو تولي السلطة على شيء ما) / افتراض (فعل الافتراض أو التسليم بجدلية أمر ما) / افتئات, تطاول (سلوك جريء (حتى متعجرف) ليس من حقك) / افتراض (فرضية تؤخذ كأمر مسلم به)\nمثال: تزامنت توليه المنصب مع الاضطرابات في كوبا",
 "就任式": "تَنْصِيب",
 "就働": "تَشْغِيلِيّ, عَمَلِيّ (يُمكّن من العمل أو النشاط اللاحق أو يُسهّله) / كَافٍ لِلْعَمَل (ملائم للاستخدام العملي؛ كافٍ من حيث القوة أو العدد لإنجاز المطلوب) / أعمال تعدين, منجم عامل (منجم أو محجر يتم العمل فيه حالياً أو تم العمل فيه)",
 "就労": "تَشْغِيلِيّ, عَمَلِيّ (يُمكّن من العمل أو النشاط اللاحق أو يُسهّله) / كَافٍ لِلْعَمَل (ملائم للاستخدام العملي؛ كافٍ من حيث القوة أو العدد لإنجاز المطلوب) / أعمال تعدين, منجم عامل (منجم أو محجر يتم العمل فيه حالياً أو تم العمل فيه)",
 "就塒": "مجثم (مجثم تستريح عليه أو تنام عليه الطيور الداجنة) / مَجثَم (مأوى به عوارض لجلوس الدواجن أو الطيور الأخرى)",
 "就学": "تَسْجِيل",
 "就寝": "مُتَكَتِّم, مُتَوَارٍ (يتجنّب لفت الانتباه إلى نفسه؛ متحفّظ ومنسحب) / غَيْرُ مُتَكَبِّر, مُتَوَاضِع (لَيْسَ مُتَعَجْرِفًا وَلَا مُتَطَاوِلًا)",
 "就寝時間": "وقت النوم (الوقت الذي تذهب فيه إلى الفراش)",
 "就巣": "تَأَمُّلِيّ, مُتَدَبِّر (مُسْتَغْرِقٌ فِي تَفْكِيرٍ عَمِيقٍ وَجِدِّيّ) / استغراق في التفكير, وجوم (تأمل مرضي مستمر في مشكلة ما) / تحضين, حضن (الجلوس على البيض لفقسه بواسطة دفء الجسم)",
 "就床": "مُتَكَتِّم, مُتَوَارٍ (يتجنّب لفت الانتباه إلى نفسه؛ متحفّظ ومنسحب) / غَيْرُ مُتَكَبِّر, مُتَوَاضِع (لَيْسَ مُتَعَجْرِفًا وَلَا مُتَطَاوِلًا)",
 "就業": "وَظِيفَة, تَوْظِيف (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / اِسْتِخْدَام\nمثال: ما وظيفة زوجتك؟",
 "就業人口": "أيدي عاملة, قوة عاملة (قوة العمال المتاحة)",
 "就眠": "نوم (توقف الوعي وانخفاض معدل الأيض) / سكون, كمون (حالة من الراحة الهادئة وغير النشطة) / رَاقِد, نَائِم (مستلقٍ ورأسه على كفَّيه كأنَّه نائم) / استغراق في النوم (حالة كون الشخص نائماً)",
 "就職口": "مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث.",
 "就職指導": "إِرْشَاد مِهْنِيّ (الاستشارة حول الفرص الوظيفية)",
 "就蓐": "مُتَكَتِّم, مُتَوَارٍ (يتجنّب لفت الانتباه إلى نفسه؛ متحفّظ ومنسحب) / غَيْرُ مُتَكَبِّر, مُتَوَاضِع (لَيْسَ مُتَعَجْرِفًا وَلَا مُتَطَاوِلًا)",
 "就褥": "مُتَكَتِّم, مُتَوَارٍ (يتجنّب لفت الانتباه إلى نفسه؛ متحفّظ ومنسحب) / غَيْرُ مُتَكَبِّر, مُتَوَاضِع (لَيْسَ مُتَعَجْرِفًا وَلَا مُتَطَاوِلًا)",
 "尹": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "尺": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون. / طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير. / مِسْطَرَة (أداة تستخدم لقياس الأطوال أو رسم الخطوط المستقيمة؛ خط مستقيم تحدده مِسطَرة أو بُعد محدد) / حَاكِم (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر)\nمثال: استعارت المسطرة.",
 "尺を取る": "قِيَاس / فَاصِلَة / إِجْرَاء / قَاسَ (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "尺八": "مَصّ قَضِيب, لَعْق قَضِيب (مَصَّ الرَّضِيعُ ثَدْيَ أُمِّهِ: رَضَعَ؛ مَصَّ العَصِيرَ: رَشَفَهُ رَشْفًا رَقِيقًا، جَذَبَهُ بِنَفَسِهِ)",
 "尺取": "دودة شبرية, دودة قياسة (يسروع صغير أملس له أرجل فقط في قطاعاته الأمامية والخلفية؛ معظمها يرقات لعث من عائلة الأرفية)",
 "尺取り虫": "دودة شبرية, دودة قياسة (يسروع صغير أملس له أرجل فقط في قطاعاته الأمامية والخلفية؛ معظمها يرقات لعث من عائلة الأرفية)",
 "尺取虫": "دودة شبرية, دودة قياسة (يسروع صغير أملس له أرجل فقط في قطاعاته الأمامية والخلفية؛ معظمها يرقات لعث من عائلة الأرفية)",
 "尺寸": "دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "尺度": "مقياس (أداة قياس لقياس وتوضيح كمية مثل سمك السلك أو كمية المطر وما إلى ذلك) / عيار, قُطْر داخلي (قُطر أنبوب أو ماسورة سلاح ناري) / سُمك, عيار (سُمك السلك) / اتساع السكة (المسافة بين قضيبي السكة الحديدية أو بين عجلات القطار) / طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير. / قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "尺拍子": "للسان الجرس, مصفق (مطرقة معدنية تتدلى داخل الجرس وتصدر صوتاً بضرب الجانب) / لسان (كتلة متحركة من الأنسجة العضلية مغطاة بغشاء مخاطي وتقع في التجويف الفموي) / مصفق (شخص يصفق)",
 "尺牘": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "尺蛾": "عثة هندسية (عثة نحيلة الجسم عريضة الأجنحة تسمى يرقاتها الديدان القياسية)",
 "尺骨": "زِنْد (زَنَّدَ: أوْرَى زَنْدُه؛ زَنَّدَ كذَبَ)",
 "尺骨動脈": "شريان زندي (شريان كبير يتفرع من الشريان العضدي لتغذية عضلات الساعد والرسغ واليد)",
 "尺鷸": "كَرَوَان",
 "尻": "حِمَار (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة) / حُمار (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة) / عَجِيزَة, مُؤَخَّرَة\nمثال: هن بحاجة لحمار. / خَلْفِيّ / أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته / أسفل, جانب سفلي (الجانب السفلي من أي شيء) / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / عَاقِبَة / نَتِيجَة",
 "尻かっちん": "أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "尻がおもい": "كَسْلَان / أَخْرَق",
 "尻が軽い": "عميق / بِسُرْعَة, عَاجِلًا / صَامَ ((لَازِمٌ) اِمْتَنَعَ عن الطَّعَام والشَّرَاب؛ (مُتَعدٍّ بِعَنْ) امتنع عنه)\nمثال: صام ياني رمضان. / غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / دَاعِر, فَاجِر (متساهل وغير منضبط في السلوك الجنسيّ) / بِلَا دَافِع, عَابِث (يحدث دون دافع أو استفزاز) / امرأة خليعة, فاسقة (امرأة بذيئة أو فاسقة)",
 "尻が重い": "كَسْلَان / أَخْرَق",
 "尻が青い": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "尻こそばゆい": "قَلِق, قَلِقَة (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك.",
 "尻すぼまり": "ضَعِيف, مُوَهَّن (مُنخفِض القوّة أو الشدّة)",
 "尻すぼみ": "تخفيض تدريجي, تدريج (عملية تقليل الحجم أو الكمية تدريجياً) / آخِذ فِي التَّلَاشِي, مُتَضَائِل (يتناقص تدريجيًّا حتّى لا يبقى منه إلّا القليل) / مُتَدَرِّج الضِّيق, مُسْتَدَقّ (يضيق تدريجيًّا نحو أحد الأطراف)\nمثال: وصف الطبيب تخفيضاً تدريجياً للجرعة",
 "尻たたき": "خَفِيفُ الحَرَكَة, نَشِيط (سريع ومفعم بالطاقة والحيوية) / صفع على الأرداف (فعل الصفع على الأرداف)",
 "尻たぶ": "دُبْر, رِدْف (ضد القُبُل؛ من كل شيء عقبه ومؤخره؛ دُبُر الصلاة؛ بعدها مباشرة)\nمثال: دبر المحامي وسلية لهرب توم من السجن.",
 "尻っぺた": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه) / خلفية, مؤخرة (جانب الجسم الذي يعاكس مقدمته)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "尻っぽ": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه) / تذييل, ذيل (أي نتوء يشبه ذيل الحيوان) / أواخر, ذيل (وقت الجزء الأخير من شيء ما)\nمثال: يستحق ركلة جيدة في مؤخرته / ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب.",
 "尻つぼみ": "تخفيض تدريجي, تدريج (عملية تقليل الحجم أو الكمية تدريجياً) / آخِذ فِي التَّلَاشِي, مُتَضَائِل (يتناقص تدريجيًّا حتّى لا يبقى منه إلّا القليل) / مُتَدَرِّج الضِّيق, مُسْتَدَقّ (يضيق تدريجيًّا نحو أحد الأطراف)\nمثال: وصف الطبيب تخفيضاً تدريجياً للجرعة",
 "尻にしく": "سَيْطَرَ",
 "尻に敷く": "سَيْطَرَ",
 "尻の穴": "اِسْت (فتحة الدُبُر أو مقعد الإنسان؛ الأصل والأساس) / شَرْج",
 "尻の穴が小さい": "تَافِه, ضَيِّق النَّظَر (مَحْدُود الأُفُق بِشَكْلٍ مُحْتَقَر)",
 "尻ぺた": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه) / خلفية, مؤخرة (جانب الجسم الذي يعاكس مقدمته)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "尻ぺんぺん": "خَفِيفُ الحَرَكَة, نَشِيط (سريع ومفعم بالطاقة والحيوية) / صفع على الأرداف (فعل الصفع على الأرداف)",
 "尻もち": "خطأ فادح, زلة (خطأ محرج) / سقوط على المؤخرة (سقوط على الأرداف)",
 "尻をあげる": "قَامَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه. / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "尻をたたく": "صَفَعَ, سَتَهَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين)\nمثال: صفع المدرس مؤخرتي.",
 "尻をまくる": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "尻を上げる": "قَامَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه. / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "尻を叩く": "صَفَعَ, سَتَهَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين)\nمثال: صفع المدرس مؤخرتي.",
 "尻を据える": "جَلَسَ, قَعَدَ (قَعَدَ)\nمثال: جلس سامي مجددا.",
 "尻を捲る": "قَمَر, قمر (الكَوْكَب الذي يدور حول الأرْض ويظهر غالبا في الليل ويعكس ضوء الشَمْس. مذكر لا يؤنث؛ أي كوكب يدور حول كوكب آخر، لا يشمل ذلك الكواكب التي تدور حول شُمُوس. مذكر لا يؤنث)\nمثال: ضوء القمر ضعيف.",
 "尻カッチン": "أَجَل, مُهْلَة (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري.",
 "尻上がり": "تَحْسِين",
 "尻上り": "تَحْسِين",
 "尻取": "لعبة كلمات (أي لعبة تنطوي على تكوين أو تغيير أو اكتشاف الكلمات)",
 "尻取り": "لعبة كلمات (أي لعبة تنطوي على تكوين أو تغيير أو اكتشاف الكلمات)",
 "尻叩き": "خَفِيفُ الحَرَكَة, نَشِيط (سريع ومفعم بالطاقة والحيوية) / صفع على الأرداف (فعل الصفع على الأرداف)",
 "尻尾": "ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب. / أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه) / تذييل, ذيل (أي نتوء يشبه ذيل الحيوان) / أواخر, ذيل (وقت الجزء الأخير من شيء ما)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "尻尾を振る": "تَمَلَّقَ, تَبَصْبَصَ",
 "尻座": "انحناء, جثوم (عملية الانحناء المنخفض مع ضم الأطراف للجسم)",
 "尻抜け": "كثرة النسيان, نسيان (الميل للنسيان) / سهو, نسيان (عدم الوعي الناجم عن الإهمال أو الفشل في التذكر)\nمثال: ازداد سهوه مع تقدمه في السن",
 "尻押し": "دعم, مؤازرة (فعل تقديم الموافقة والدعم) / بطانة, دعامة خلفية (شيء يشكل ظهراً يضاف للتقوية) / تمويل, دعم مالي (الموارد المالية المقدمة لجعل مشروع ما ممكناً)\nمثال: دعمه القوي للمحافظين أوقعه في مشاكل مع التقدميين / إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة)) / تحريض, حث (الفعل اللفظي للحث)",
 "尻癖": "سَلَس ((سَلُسَ) يَسْلُسُ سَلاسَةً: لانَ وسَهُلَ وانقادَ، فهو سَلِيسٌ)",
 "尻目": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "尻目にかける": "تَرَفَّعَ",
 "尻目に懸ける": "تَرَفَّعَ",
 "尻相撲": "مُتَتَالٍ, مُتَعَاقِب (واحد تلو الآخر دون انقطاع)",
 "尻穴": "اِسْت (فتحة الدُبُر أو مقعد الإنسان؛ الأصل والأساس) / شَرْج / فتحة الشرج (فِي اللُّغَةِ الْعَرَبِيَّةِ (إعراب) : الفَتْحَة أو الفَتْح هي إحدى الحركات التشكيلية في اللغة العربية…؛ الثُّقْب و الْمَنْفَذ) / بَوْش\nمثال: انظر من الفتحة.",
 "尻窄まり": "ضَعِيف, مُوَهَّن (مُنخفِض القوّة أو الشدّة)",
 "尻窄み": "تخفيض تدريجي, تدريج (عملية تقليل الحجم أو الكمية تدريجياً) / آخِذ فِي التَّلَاشِي, مُتَضَائِل (يتناقص تدريجيًّا حتّى لا يبقى منه إلّا القليل) / مُتَدَرِّج الضِّيق, مُسْتَدَقّ (يضيق تدريجيًّا نحو أحد الأطراف)\nمثال: وصف الطبيب تخفيضاً تدريجياً للجرعة",
 "尻繋": "ثَفَر, قُوش ((ثَفَّرَ) الدَّابَّة: سَاقهَا من خلفهَا)",
 "尻肉": "ردف, كفل (جزء الحيوان الذي يقابل الأرداف البشرية) / أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه) / كفل, مؤخرة (الأرباع الخلفية المكتنزة باللحم؛ خلف الخاصرة وفوق الفخذة المدورة)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "尻臀": "دُبْر, رِدْف (ضد القُبُل؛ من كل شيء عقبه ومؤخره؛ دُبُر الصلاة؛ بعدها مباشرة)\nمثال: دبر المحامي وسلية لهرب توم من السجن.",
 "尻軽": "فَضْفَاض, واسِع / سَرِيع / سَرِيعٌ / حَيٌّ (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء) / جَارٍ (له استخدامات متعددة، تتراوح بين وصف المكان والعلاقة بين الناس، وبين وصف فعل الظلم أو الميل عن الطريق الصحيح؛ \"جار\" كلمةٌ مُشْعِبَةُ المعنى، تشيرُ إلى المكانِ، والعلاقة، والظلم) / سَرِيعًا, بِسُرْعَةٍ\nمثال: ينبح كلب في الحي. / طَفْح, طَفْح جِلْدِيّ",
 "尻輪": "حافة السرج الخلفية, قادمة السرج (الجزء الخلفي من مقعد السرج)",
 "尻込み": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / تثاقل, تردد (درجة معينة من عدم الرغبة) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: كان هناك تردد في كلامه",
 "尻重": "بطيء الحركة, بليد (شخص يتحرك ببطء)",
 "尻餅": "خطأ فادح, زلة (خطأ محرج) / سقوط على المؤخرة (سقوط على الأرداف)",
 "尼": "أخت (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على امرأة لا يعرفها تأدبا وإن كانت غريبة عنه)\nمثال: ماري هي أخت توم / ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع) / قَحْبَة, سَلِيطَة / نَهْر الأمازون, الأَمَزونْ (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ يَأْمُرُهُ)\nمثال: عبر جوناس النهر. / إِنْدُونِيسِيَا",
 "尼っちょ": "ثَعْلَبَة, كَلْبَة (مؤنث ثَعْلَب؛ اسم لمَرَض يصيب فروة الرأس ويسبب سقوط الشعر والصَلَع) / قَحْبَة, سَلِيطَة",
 "尼っ子": "امرأة, فتاة (مصطلحات غير رسمية لامرأة (شابة))",
 "尼僧": "أخت (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على امرأة لا يعرفها تأدبا وإن كانت غريبة عنه)\nمثال: ماري هي أخت توم",
 "尼僧院": "دَيْر, رَهْبَنَة نِسْوِيّ (بيت يسكنه الرُهْبَان أو الرَاهِبَات ممن كان على دين المسيحية)\nمثال: سيداتي و سادتي ، رجاء قفوا للنشيد الوطني للاتحاد الروسي باداء جوقة دير سرتينسكي .",
 "尼国": "إِنْدُونِيسِيَا",
 "尼寺": "دَيْر, رَهْبَنَة نِسْوِيّ (بيت يسكنه الرُهْبَان أو الرَاهِبَات ممن كان على دين المسيحية)\nمثال: سيداتي و سادتي ، رجاء قفوا للنشيد الوطني للاتحاد الروسي باداء جوقة دير سرتينسكي .",
 "尼崎": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "尼法師": "رَاهِبَة / نُون, ن",
 "尼港": "نِيكُولَايِفْسْك نَا أَمُور",
 "尽": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم) / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "尽かす": "اِسْتَهْلَكَ, اِسْتَنْفَدَ / تَنَازَلَ / تَخَلَّى / اِسْتَسْلَمَ",
 "尽きせぬ": "أَبَدِيّ",
 "尽きない": "أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى) / أزهار مجففة, زهرة الخلود (أي من النباتات المختلفة من أجناس مختلفة من الفصيلة النجمية ذات زهور يمكن تجفيفها دون فقدان الشكل أو اللون)",
 "尽く": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / إجمالاً, في المجموع (مع تضمين أو عد كل شيء) / بشكل عام, في الإجمال (مع أخذ كل شيء في الاعتبار) / كما ولدتني أمي (تعبيرات غير رسمية للعري)\nمثال: كان مقتنعاً كلياً",
 "尽くした": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "尽くす": "اِسْتَهْلَكَ, اِسْتَنْفَدَ / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "尽くめ": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان مقتنعاً كلياً",
 "尽れる": "صَعَقَ",
 "尽力": "جَهْد, جُهْد (بَذَلَ قُصَارَى جُهْدِهِ فِي أَمْرٍ مَا؛ أَتْعَبَ نَفْسَهُ أو غَيْرَهُ بِعَمَلٍ شَاقٍ)\nمثال: لا إنجاز بلا جهد .",
 "尽忠": "وَفَاء, إِخْلَاص",
 "尽日": "طِوَال اليَوْم, نَهَارًا (خلال اليوم بأكمله)\nمثال: الضوء يتدفق طوال اليوم في الغرفة / يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "尽未来": "أبدياً, إلى الأبد (لوقت غير محدود)\nمثال: لا أحد يستطيع العيش إلى الأبد",
 "尽滅": "إِفْنَاء, تَدْمِير / إِفْنَاء",
 "尽無し": "تَافِه",
 "尾": "ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب.",
 "尾ける": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "尾っぽ": "ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب.",
 "尾てい骨": "عُصُص, عُصْعُص",
 "尾ひれ": "تنميق, زخرفة (فعل إضافة زخارف خارجية لشيء ما) / تنميق, زخرفة زائدة (زينة فائضة عن الحاجة) / تنميق, زخرفة (توضيح تفسير باستخدام تفاصيل زخرفية (أحياناً خيالية))\nمثال: تم تعزيز الغموض بالعديد من الزخارف في الروايات اللاحقة",
 "尾ひれをつける": "بَالَغَ",
 "尾ひれを付ける": "بَالَغَ",
 "尾びれ": "زعنفة ذيلية (ذيل الأسماك وبعض الفقاريات المائية الأخرى)",
 "尾ろ": "ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)",
 "尾ヒレ": "تنميق, زخرفة (فعل إضافة زخارف خارجية لشيء ما) / تنميق, زخرفة زائدة (زينة فائضة عن الحاجة) / تنميق, زخرفة (توضيح تفسير باستخدام تفاصيل زخرفية (أحياناً خيالية))\nمثال: تم تعزيز الغموض بالعديد من الزخارف في الروايات اللاحقة",
