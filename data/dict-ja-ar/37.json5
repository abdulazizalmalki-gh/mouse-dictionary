 "尾久崎": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "尾宿": "ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)",
 "尾崎": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "尾形": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "尾後": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "尾根": "سلسلة جبال",
 "尾椎": "فقرة عصعصية (واحدة من 4 فقرات في العصعص البشري)",
 "尾流雲": "أذيال المطر, فيرجا (هطول خفيف يتبخر قبل وصوله إلى الأرض (خاصة عندما يكون الهواء السفلي منخفض الرطوبة))",
 "尾灯": "ضوء خلفي (مصباح (عادة أحمر) مثبت في مؤخرة مركبة آلية)",
 "尾燈": "ضوء خلفي (مصباح (عادة أحمر) مثبت في مؤخرة مركبة آلية)",
 "尾状": "ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب.",
 "尾状核": "نواة مذنبة (عقدة قاعدية على شكل ذيل تقع في بطين جانبي للدماغ)",
 "尾状花": "نورة هرية, هريرة (نورة أسطوانية تشبه السنبلة)",
 "尾状花序": "نورة هرية, هريرة (نورة أسطوانية تشبه السنبلة)",
 "尾田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "尾白鹿": "أيل أبيض الذيل, أيل فرجينيا (أيل شائع في أمريكا الشمالية؛ ذيله له جانب سفلي أبيض)",
 "尾端": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه) / تذييل, ذيل (أي نتوء يشبه ذيل الحيوان) / أواخر, ذيل (وقت الجزء الأخير من شيء ما)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "尾筒": "مِذْيَاع, رَادِيُو / سَمَّاعَة",
 "尾篭": "بذيء, غير لائق (مسيء للذوق العام خاصة في المسائل الجنسية) / فَاحِش, مُخِلٌّ بِالحَيَاء (يُسِيءُ إِلَى الآدَابِ الأَخْلَاقِيَّةِ فِي السُّلُوكِ أَوِ المَظْهَر) / غَيْر لَائِق, مُنَافٍ لِلآدَاب (لا يتوافق مع المعايير المقبولة للسلوك اللائق في المجتمع المهذّب)\nمثال: قصة واقعية لكنها ليست فاحشة",
 "尾籠": "بذيء, غير لائق (مسيء للذوق العام خاصة في المسائل الجنسية) / فَاحِش, مُخِلٌّ بِالحَيَاء (يُسِيءُ إِلَى الآدَابِ الأَخْلَاقِيَّةِ فِي السُّلُوكِ أَوِ المَظْهَر) / غَيْر لَائِق, مُنَافٍ لِلآدَاب (لا يتوافق مع المعايير المقبولة للسلوك اللائق في المجتمع المهذّب)\nمثال: قصة واقعية لكنها ليست فاحشة",
 "尾索類": "حبلي الذيل, غلالية (حيوان بحري بدائي له جسم يشبه الكيس غير مقسم وحبل ذيلي يكون واضحاً في اليرقة)",
 "尾羽": "رِيشَةُ الذَّيْل (ريش ينمو من ذيل (عصعص) الطائر)",
 "尾羽根": "رِيشَةُ الذَّيْل (ريش ينمو من ذيل (عصعص) الطائر)",
 "尾翼": "ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب.",
 "尾行": "ظِلّ, خَيَال (الإستمرار في العمل. أصله للنهار ثم أصبح يشمل النهار والليل)\nمثال: ظل الولد ساكنا.",
 "尾行る": "تَبِعَ, اِتَّبَعَ (تبِع الشيءَ: سار في إثرِه، تلاه؛ تبِعه تبَعًا: مرَّ به فمضى معه) / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع) / تَابَعَ, تَتَبَّعَ / تَابَعَ\nمثال: تبع المشتبه محققان.",
 "尾部": "ذَنَب, ذَيْل (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ) / ذَنَب (ذَنَّبَ: مدَّ ذَنَبَه؛ ذَنَّبَ الضَّبّ: أخرج ذَنَبَهُ من أدنى الجُحْر عند الحَرْشِ)\nمثال: عذر أقبح من ذنب.",
 "尾鉱": "تعقب سري, مراقبة (فعل اتباع شخص ما سراً)",
 "尾錠": "إِبْزِيم (حديدة الحزام)\nمثال: ذهبت لشراء إبزيم.",
 "尾長猿": "قرد العالم القديم (من أفريقيا أو الجزيرة العربية أو آسيا؛ له ذيول غير قابضة وفتحتا أنف متقاربتان)",
 "尾長鮫": "قرش دراس (قرش كبير يعيش في عرض البحار الدافئة ذو ذيل يشبه السوط يستخدمه لتجميع الأسماك الصغيرة ليتغذى عليها)",
 "尾長鴨": "بلبول شمالي",
 "尾関": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "尾類": "دَاعِرَة, بَغِيَّة / دَعِرَ, بَغَى (دَعِرَ الْعود دعرا دخن وَلم يتقد)",
 "尾骨": "عُصُص, عُصْعُص",
 "尾骶骨": "عُصُص, عُصْعُص",
 "尾鰭": "تنميق, زخرفة (فعل إضافة زخارف خارجية لشيء ما) / تنميق, زخرفة زائدة (زينة فائضة عن الحاجة) / تنميق, زخرفة (توضيح تفسير باستخدام تفاصيل زخرفية (أحياناً خيالية))\nمثال: تم تعزيز الغموض بالعديد من الزخارف في الروايات اللاحقة / زعنفة ذيلية (ذيل الأسماك وبعض الفقاريات المائية الأخرى)",
 "尾鰭を付ける": "بَالَغَ",
 "尿": "بَوْل",
 "尿の検査": "تحليل بول ((طب) التحليل الكيميائي للبول (للتشخيص الطبي))",
 "尿器": "مِبْوَلَة",
 "尿失禁": "بوال, سلس البول (عدم القدرة على التحكم في تدفق البول والتبول اللاإرادي)",
 "尿崩症": "بيلة تفهة, سكري كاذب (شكل نادر من السكري ناتج عن نقص في الفازوبريسين (هرمون الغدة النخامية الذي ينظم الكلى)؛ يتميز بإفراز مزمن لكميات كبيرة من البول المخفف الشاحب مما يؤدي…)",
 "尿検査": "تحليل بول ((طب) التحليل الكيميائي للبول (للتشخيص الطبي))",
 "尿毒症": "تبولن الدم, يوريميا (تراكم الفضلات النيتروجينية (اليوريا) في الدم والتي تفرز عادة في البول)",
 "尿漏れ": "بوال, سلس البول (عدم القدرة على التحكم في تدفق البول والتبول اللاإرادي)",
 "尿瓶": "قصرية, نونية سرير (وعاء ضحل يستخدمه المريض طريح الفراش للتغوط والتبول)",
 "尿石": "حَصَاةُ الكُلْيَة (حصاة تتكون في الكلية)",
 "尿管": "حَالِب",
 "尿糞": "إفرازات, فضلات الجسم (نفايات (مثل البول أو العرق ولكن خاصة البراز) يتم تصريفها من الجسم)",
 "尿素": "بولة, يوريا (المكون الصلب الرئيسي لبول الثدييات؛ يتم تصنيعه من الأمونيا وثاني أكسيد الكربون ويستخدم كسماد وفي علف الحيوانات والبلاستيك)",
 "尿細管": "كُلْيُون, نفرون (أي من النبيبات الصغيرة التي تشكل وحدات الإخراج في كلية الفقاريات)",
 "尿結石": "حَصَاةُ الكُلْيَة (حصاة تتكون في الكلية)",
 "尿膜": "سِقَاء",
 "尿膜管": "سَرَر مَثَانِيّ, مُرَيْطَاء ((سَرَّرَه) المَاء: بلَغَ سُرَّتَهُ)",
 "尿袋": "مَثَانَة, مَثَانَة بَوْلِيَّة ((في الأحياء) عضو مرن يشبه الكيس يتمدد وينقبض، وظيفته تخزين سائل أو غاز ما؛ تحديدًا، المثانة البولية، وهي العضو الذي يخزن البول في الإنسان وفي العديد من الحيوانات)",
 "尿路": "السبيل البولي, مسلك بولي (الأعضاء والأنابيب المشاركة في إنتاج وإخراج البول)",
 "尿路感染症": "عَدْوَى الجِهَاز البَوْلِيّ",
 "尿路結石": "حَصَاةُ الكُلْيَة (حصاة تتكون في الكلية)",
 "尿道": "إِحْلِيل (مجرى البول من ذكر الإنسان)",
 "尿道下裂": "إحليل تحتي (حالة غير طبيعية عند الذكور يفتح فيها مجرى البول على السطح السفلي للقضيب)",
 "尿道括約筋": "مصرة الإحليل (عضلة عاصرة مخططة تضيق الإحليل)",
 "尿道炎": "التهاب الإحليل (التهاب الإحليل؛ يؤدي إلى تبول مؤلم)",
 "尿道球腺": "غُدَّةُ بَصَلِيَّةُ إِحْليلِيَّة",
 "尿道球腺液": "مَذْي",
 "尿酸": "حمض البول, حمض اليوريك (ناتج بلوري أبيض عديم الطعم والرائحة لعملية التمثيل الغذائي للبروتين؛ يوجد في الدم والبول)",
 "尿酸値": "حمض البول, حمض اليوريك (ناتج بلوري أبيض عديم الطعم والرائحة لعملية التمثيل الغذائي للبروتين؛ يوجد في الدم والبول)",
 "尿酸塩": "يورات (ملح لحمض اليوريك)",
 "尿閉": "احتباس البول (احتجاز البول في المثانة البولية)\nمثال: لديه مشكلة في احتباس البول",
 "局": "مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب. / مَهَمَّة / شَأْن / عَلَاقَة غَرَامِيَّة / لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / لَعْب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / طَرِيدَة\nمثال: لعب زيري التنس. / وصيفة الشرف (سيدة تُعين لخدمة ملكة أو أميرة)",
 "局アナ": "مذيع تلفزيوني (مذيع على التلفزيون)",
 "局勢": "حَالَة, وَضْع",
 "局名": "رَمْز نِدَاء (رمز (جمعه رموز)؛ الرمز يعني الرسم الذي يعبر عن شيء معين وعموما فأن العلامة ينبغي نقل رسالتها بنظرة واحدة دون الحاجة للكلمات)\nمثال: تمثال الحرية رمز لأمريكا.",
 "局員": "مُوَظَّف / مُوَظَّفَة",
 "局在": "تحديد الموقع, تموضُع (تحديد المكان الذي يوجد فيه الشيء) / توطين الوظيفة, مبدأ التوطين ((فسيولوجيا) المبدأ القائل بأن وظائف محددة لها مواقع محددة نسبيًا في جزء أو عضو معين من الجسم)",
 "局地": "جوار, منطقة مجاورة (منطقة محيطة أو قريبة)\nمثال: تحطمت الطائرة في جوار آشفيل",
 "局地戦争": "حرب محدودة (حرب هدفها أقل من الهزيمة غير المشروطة للعدو)",
 "局地的": "مَحَلِّيّ",
 "局外": "خَارِج, بره",
 "局外中立": "حِيَاد",
 "局外中立主義": "حياد (سياسة الحياد أو عدم الانحياز في الشؤون الدولية)",
 "局外者": "أجنبي, دخيل (شخص مستبعد أو ليس عضواً في مجموعة معينة) / متسابق غير مرشح (متسابق (إنسان أو حيوان) لا يُعتقد أن لديه فرصة جيدة للفوز)",
 "局所": "جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟ / مَحَلِّيّ / أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)",
 "局所時": "توقيت محلي, توقيت مدني (الوقت الرسمي في منطقة محلية (معدل حسب الموقع حول الأرض)؛ يحدد بالقانون أو العرف)",
 "局所的": "مَحَلِّيّ",
 "局所麻酔": "تخدير موضعي (فقدان الإحساس في منطقة صغيرة من الجسم (كما هو الحال عند حقن مخدر موضعي لقلع الأسنان))",
 "局留": "بريد عام, تسليم في المكتب (جزء من مكتب البريد يتعامل مع البريد للأشخاص الذين يطلبونه)",
 "局留め": "بريد عام, تسليم في المكتب (جزء من مكتب البريد يتعامل مع البريد للأشخاص الذين يطلبونه)",
 "局番": "سنترال, مقسم هاتف (مكان عمل يعمل كمنشأة اتصالات حيث يمكن توصيل الخطوط من الهواتف معًا للسماح بالاتصال)",
 "局舎": "مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة، سواء كانت للمَكَاتِب أم لغيرها)\nمثال: عاد إلى المكتب.",
 "局部": "جُزْء, جُزَء / دَوْر (جَعَله يَدُور؛ جَعَلَه مُدَوَّر) / اِفْتَرَقَ, تَفَارَقَ\nمثال: في أي دور تسكن؟ / أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)",
 "局部床義歯": "طقم أسنان جزئي (طقم أسنان يحل محل سن واحد أو أكثر في قوس الأسنان)",
 "局部的": "مَحَلِّيّ, مُوَجَّه مَحَلِّيًّا (جُعِل محلياً أو وُجِّه نحو النطاق المحلي) / مَحَلِّيّ, مَوْضِعِيّ (مَحْصور أَوْ مُقْتَصِر عَلى مَوْضِع مُعَيَّن)",
 "局部麻酔": "تخدير موضعي (فقدان الإحساس في منطقة صغيرة من الجسم (كما هو الحال عند حقن مخدر موضعي لقلع الأسنان))",
 "局間回線": "جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر) / خُرْطُوم / صَنْدُوق, صُنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / حَقِيبَة أَمْتِعَة, صُنْدُوقُ السَّيَّارَةِ\nمثال: أين صندوق البريد؟",
 "局限": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ) / نِهَايَة / حَدَّ, حَدَّدَ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "局面": "حَالَة, وَضْع",
 "屁": "حَبَقَ, ضَرَطَ (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في النّاس : حَبَقَ يحبِق حبْقاً وحَبِقاً وحُباقاً؛ الحَبْق : ضُراط المَعِز ، وقد تستعمل في النّاس) / حَبْقَة, ضَرْطَة",
 "屁こき": "إخراج ريح, ريح (منعكس يطرد الغازات المعوية عبر الشرج)",
 "屁っぴり腰": "خَوَّارُ الْعَزِيمَةِ (يفتقر إلى قوة الإرادة والعزيمة)",
 "屁っ放り": "إخراج ريح, ريح (منعكس يطرد الغازات المعوية عبر الشرج)",
 "屁っ放り腰": "خَوَّارُ الْعَزِيمَةِ (يفتقر إلى قوة الإرادة والعزيمة)",
 "屁っ放り虫": "خنفساء قاذفة (خنفساء تطلق بخاراً لاذعاً بصوت مسموع عند إزعاجها)",
 "屁でもない": "لَا شَيْء (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "屁でも無い": "لَا شَيْء (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "屁と火事はもとから騒ぐ": "الْمُخْتَار, الْمُخْتَارَة",
 "屁のつっぱりにもならない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "屁のカッパ": "سينش (شكل من أشكال لعبة أول فورز يزايد فيه اللاعبون لامتياز تسمية الأوراق الرابحة) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به) / حزام البطن, حزام السرج (معدات اسطبل تتكون من حزام حول بطن الحصان يثبت السرج في مكانه)\nمثال: تسويق هذا المنتج لن يكون نزهة",
 "屁の河童": "سينش (شكل من أشكال لعبة أول فورز يزايد فيه اللاعبون لامتياز تسمية الأوراق الرابحة) / أمر سهل, لعب أطفال (أي مشروع يسهل القيام به) / حزام البطن, حزام السرج (معدات اسطبل تتكون من حزام حول بطن الحصان يثبت السرج في مكانه)\nمثال: تسويق هذا المنتج لن يكون نزهة",
 "屁の突っ張りにもならない": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "屁ひり虫": "خنفساء قاذفة (خنفساء تطلق بخاراً لاذعاً بصوت مسموع عند إزعاجها)",
 "屁をこく": "حَبَقَ, ضَرَطَ (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في النّاس : حَبَقَ يحبِق حبْقاً وحَبِقاً وحُباقاً؛ الحَبْق : ضُراط المَعِز ، وقد تستعمل في النّاس) / حَبْقَة, ضَرْطَة",
 "屁をひって尻すぼめ": "هُنَاكَ, يُوجَدُ",
 "屁をひって尻つぼめ": "هُنَاكَ, يُوجَدُ",
 "屁をひって尻窄め": "هُنَاكَ, يُوجَدُ",
 "屁をひる": "حَبَقَ, ضَرَطَ (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في النّاس : حَبَقَ يحبِق حبْقاً وحَبِقاً وحُباقاً؛ الحَبْق : ضُراط المَعِز ، وقد تستعمل في النّاس) / حَبْقَة, ضَرْطَة",
 "屁を放く": "حَبَقَ, ضَرَطَ (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في النّاس : حَبَقَ يحبِق حبْقاً وحَبِقاً وحُباقاً؛ الحَبْق : ضُراط المَعِز ، وقد تستعمل في النّاس) / حَبْقَة, ضَرْطَة",
 "屁を放る": "حَبَقَ, ضَرَطَ (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في النّاس : حَبَقَ يحبِق حبْقاً وحَبِقاً وحُباقاً؛ الحَبْق : ضُراط المَعِز ، وقد تستعمل في النّاس) / حَبْقَة, ضَرْطَة",
 "屁放き": "إخراج ريح, ريح (منعكس يطرد الغازات المعوية عبر الشرج)",
 "屁放り": "إخراج ريح, ريح (منعكس يطرد الغازات المعوية عبر الشرج)",
 "屁放虫": "خنفساء قاذفة (خنفساء تطلق بخاراً لاذعاً بصوت مسموع عند إزعاجها)",
 "屁理屈": "سَفْسَطَة, مُغَالَطَة",
 "屁理屈屋": "سَفْسَطِيّ, سَفْسَطَائِيّ",
 "居": "مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن / كَائِن, مَخْلُوق / كَيْنُونَة, كَوْن / جلوس (فعل اتخاذ أو الحفاظ على وضعية الجلوس) / جلوس للرسم ((تصوير) فعل اتخاذ وضعية معينة (كما في صورة فوتوغرافية أو لوحة)) / جالس ((للأشخاص) الجذع منتصب والأرجل مثنية مع ارتكاز الجسم على الأرداف) / جَالِس, سَهْل الاسْتِهْدَاف (لا يتحرك ولذلك سهل المهاجمة)\nمثال: قرأ الرواية البوليسية في جلسة واحدة",
 "居あき": "سَطْو / لُصُوصِيَّة",
 "居つく": "هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "居なくなる": "اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل.",
 "居もしない": "غَيْر مَرْئِيّ, خَفِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم) / خِيَّالِيّ",
 "居り所": "مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة",
 "居る": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "居丈高": "مُتَعَالٍ, مُتَعَجْرِف (يَتَّسِم بِتَجَاهُل مُتَعَالٍ لِلآخَرِين)",
 "居中調停": "وِسَاطَة (فعل التدخل بغرض التوصل إلى تسوية) / وساطة (تفاوض لحل الخلافات يديره طرف محايد)",
 "居付く": "هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "居住": "مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "居住スペース": "مَجَال حَيَوِيّ (المساحة التي تسعى أمة لاحتلالها لتوسع سكانها)",
 "居住区": "حي سكني, مجتمع سكني (حي يعيش فيه الناس؛ تشغله مساكن خاصة في المقام الأول)",
 "居住地区": "حي سكني, مجتمع سكني (حي يعيش فيه الناس؛ تشغله مساكن خاصة في المقام الأول)",
 "居住空間": "مَجَال حَيَوِيّ (المساحة التي تسعى أمة لاحتلالها لتوسع سكانها)",
 "居住者": "سَاكِن, سَاكِنَة",
 "居住許可": "إِقَامَة, تَصْرِيح إِقَامَة",
 "居住許可書": "إِقَامَة, تَصْرِيح إِقَامَة",
 "居候": "انتهازي, طفيلي (شخص يستغل كرم الآخرين)",
 "居処": "أرداف, ألية (الجزء اللحمي من جسم الإنسان الذي يجلس عليه)\nمثال: يستحق ركلة جيدة في مؤخرته",
 "居在": "مَكَثَ, بَقِيَ / إِقَامَة",
 "居場所": "مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة",
 "居宅": "مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "居室": "غُرْفَةْ الاِسْتِقْبَال, غُرْفَةْ جُلُوس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "居座り": "فَائِض, مُتَبَقٍّ (لم يُسْتَهْلَك بعد)",
 "居座る": "بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة كونه واجبَ الوجود لذاته ، فهو الأوّل بلا ابتداء ، والآخر بلا انتهاء؛ الباقي الثابتُ بعد غيره) / بَقِيَ, مَكَثَ (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: الباقي ليس مهم.",
 "居心地": "رَاحَة / جابر / وَاسَى, عَزَّى",
 "居心地いい": "مُرِيح, وَثِير / مُرْتَاح / مُرِيح",
 "居心地がいい": "مُرِيح, وَثِير / مُرْتَاح / مُرِيح",
 "居心地がよい": "مُرِيح, وَثِير / مُرْتَاح / مُرِيح",
