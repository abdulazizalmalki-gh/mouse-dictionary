 "庸愚": "تَوَسُّط, رَدَاءَة نِسْبِيَّة (العادية نتيجة لكون الشيء متوسطاً وغير متميز) / شَخْص مِنَ الدَّرَجَة الثَّانِيَة, مُتَوَسِّط الْمُسْتَوَى (شخص ذو قدرة أو قيمة من الدرجة الثانية)",
 "廃": "مَهْجُورّ, مَتْرُوك",
 "廃す": "أَبْطَلَ, أَلْغَى / دَمَر",
 "廃する": "أَبْطَلَ, أَلْغَى / دَمَر",
 "廃める": "أَلْغَى, أَبْطَلَ",
 "廃り": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "廃る": "اِنْقَرَضَ",
 "廃れる": "اِنْقَرَضَ / رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "廃人": "مُقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد. / مُدْمِن, مُدْمِنَة",
 "廃位": "خلع, عزل (فعل عزل شخص ما؛ إزالة شخص قوي من منصب أو وظيفة)",
 "廃却": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / إدارة, تصريف أمور (طريقة لرعاية أو إدارة شؤون مجموعة من الناس (خاصة الشؤون التجارية للمجموعة)) / طاحنة نفايات, فرامة مخلفات (جهاز مطبخ للتخلص من مخلفات الطعام) / تصرف (القدرة على استخدام شيء أو شخص (تحت التصرف))\nمثال: استخدم كل الموارد المتاحة تحت تصرفه",
 "廃合整理": "إعادة تنظيم, إعادة هيكلة (تغيير واسع النطاق لهيكل شركة أو حكومة) / إعادة تنظيم (فرض تنظيم جديد؛ التنظيم بشكل مختلف (غالباً ما ينطوي على تغييرات واسعة وجذرية))\nمثال: بعد الاستحواذ كان هناك إعادة تنظيم شاملة",
 "廃品": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "廃品回収": "إنقاذ السفن, انتشال (فعل إنقاذ سفينة أو طاقمها أو شحنتها من غرق أو حريق) / إنقاذ الممتلكات (فعل إنقاذ البضائع أو الممتلكات التي كانت معرضة لخطر التلف أو الدمار) / بضائع مستنقذة (ممتلكات أو بضائع تم إنقاذها من التلف أو الدمار)",
 "廃品回収業": "جمع القمامة, رفع النفايات (جمع وإزالة القمامة)",
 "廃品回収業者": "جامع قمامة, عامل نظافة (رجل موظف لجمع والتخلص من النفايات)",
 "廃址": "خَرَاب, خَرَابَة / دَمَّرَ",
 "廃墟": "خَرَاب, خَرَابَة / دَمَّرَ",
 "廃嫡": "حرمان من الميراث (فعل من قبل المورث ينهي حق الشخص في الميراث)",
 "廃川": "مُسْتَنْزَف الْمَاء, نَاضِب (نضب ماؤه واستُنزف) / ذَابِل, يَابِس ((يُوصف به النبات خاصّةً) فَقَد كلّ رطوبته وذبل)",
 "廃材": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "廃村": "مَدِينَة أَشْبَاح, مَدِينَة الْأَشْبَاح",
 "廃校": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب",
 "廃棄": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / إدارة, تصريف أمور (طريقة لرعاية أو إدارة شؤون مجموعة من الناس (خاصة الشؤون التجارية للمجموعة)) / طاحنة نفايات, فرامة مخلفات (جهاز مطبخ للتخلص من مخلفات الطعام) / تصرف (القدرة على استخدام شيء أو شخص (تحت التصرف))\nمثال: استخدم كل الموارد المتاحة تحت تصرفه / إلغاء, فسخ (فعل النسخ؛ إلغاء رسمي أو قانوني) / إبطال, فسخ ((في القانون) إنهاء رسمي (لعلاقة أو إجراء قضائي ونحوه)) / إبطال, إلغاء (حالة كونه ملغى أو مبطلاً)",
 "廃棄処分": "تخلص, تصريف (فعل أو وسيلة التخلص من شيء ما) / إدارة, تصريف أمور (طريقة لرعاية أو إدارة شؤون مجموعة من الناس (خاصة الشؤون التجارية للمجموعة)) / طاحنة نفايات, فرامة مخلفات (جهاز مطبخ للتخلص من مخلفات الطعام) / تصرف (القدرة على استخدام شيء أو شخص (تحت التصرف))\nمثال: استخدم كل الموارد المتاحة تحت تصرفه",
 "廃棄物": "مخلفات, نفايات (أي مواد غير مستخدمة ومرفوضة على أنها عديمة القيمة أو غير مرغوب فيها)\nمثال: يجمعون النفايات مرة واحدة في الأسبوع",
 "廃業": "إيقاف, انقطاع (فعل الإيقاف أو القطع؛ انقطاع (مؤقت أو دائم))",
