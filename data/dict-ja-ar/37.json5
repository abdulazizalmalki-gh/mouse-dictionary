 "差支え無い": "مَسْمُوحٌ بِخَصْمِهِ (قابل للخصم وفقاً لقوانين الضرائب)\nمثال: سلوك مسموح به في المدرسة",
 "差替え": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر)\nمثال: استبدال النجم لن يكون سهلاً / صَحِيح, صَوَاب\nمثال: صحح نطقي من فضلك.",
 "差止": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "差止め": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "差止める": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "差物": "أعمال الموبيليا, صناعة الخزائن (حرفة صنع الأثاث (خاصة الأثاث عالي الجودة)) / دَبُّوس / علم الدولة (علم يظهر جنسيته)\nمثال: أعلنت ربطة عنقه عن ألوان مدرسته",
 "差略": "خِطَّة, خُطَّة\nمثال: خطط زيري لهجومه.",
 "差異": "فَرْق, اِخْتِلَاف",
 "差異化": "تفاضل (العملية الرياضية للحصول على مشتق دالة)\nمثال: من الضروري التمييز بين الحب والافتتان",
 "差立て": "إرسال, إيفاد (فعل إرسال شيء ما)\nمثال: تم إنجازه بسرعة وكفاءة",
 "差立てる": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "差等": "تَدَرُّج",
 "差縄": "دبوس التوازن (أي من الأجنحة الخلفية الضامرة للحشرات ثنائية الأجنحة؛ تستخدم للحفاظ على التوازن…)",
 "差置く": "نَاهِيك",
 "差覗く": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "差込": "إدخال, إيلاج (عملية وضع شيء داخل شيء آخر)\nمثال: بمساعدة إضافات صديقه تم سرد قصته في النهاية / قَابِس / اِخْتِلَاج (الخَلْجُ: الجَذْبُ،واختلج شيء في صدري:احتكأ مع شك؛ أصل الاختلاج: الحركة…)",
 "差込み": "إدخال, إيلاج (عملية وضع شيء داخل شيء آخر)\nمثال: بمساعدة إضافات صديقه تم سرد قصته في النهاية / قَابِس / اِخْتِلَاج (الخَلْجُ: الجَذْبُ،واختلج شيء في صدري:احتكأ مع شك؛ أصل الاختلاج: الحركة…)",
 "差込む": "أَدْخَلَ",
 "差込口": "قَابِس",
 "差遣": "إرسال, إيفاد (فعل إرسال شيء ما)\nمثال: تم إنجازه بسرعة وكفاءة",
 "差遣す": "إرسال, إيفاد (فعل إرسال شيء ما)\nمثال: تم إنجازه بسرعة وكفاءة",
 "差遣わす": "إرسال, إيفاد (فعل إرسال شيء ما)\nمثال: تم إنجازه بسرعة وكفاءة",
 "差配": "إِدَارَة (هو عملية تولي تَصْرِيف شؤون العَمَل. لا جمع له؛ مجموع الناس الذين يقومون بإدارة…)\nمثال: والدتي تنتظرني في الإدارة.",
 "差配人": "وكيل أراضي (شخص يدير عقاراً من الأراضي)",
 "差金": "فَرْق, اِخْتِلَاف / زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية) / إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة))",
 "差響く": "نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر.",
 "差額": "رَصِيد",
 "差額ベッド": "سرير طبي, سرير مستشفى (سرير مفرد بإطار مقسم لثلاثة أقسام بحيث يمكن رفع الرأس أو الوسط أو القدمين حسب…)",
 "己": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / لوحد",
 "己が": "ـِي, ـي",
 "己がじし": "كُلّ",
 "己と": "بالطبع, بطبيعة الحال (كما هو متوقع)\nمثال: بطبيعة الحال، أرسل لنا المحامي فاتورة ضخمة",
 "己ら": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )…)\nمثال: نحن مهتمون جدا. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "己れ": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / لوحد",
 "己等": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / ـنِي, ـنِيَ / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )…)\nمثال: نحن مهتمون جدا. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "己等達": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )…)\nمثال: نحن مهتمون جدا.",
 "已": "قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي))",
 "已の事": "تَقْرِيبًا, عَلَى وَشْك",
 "已むを得ず": "بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: انزلق الوضع لا محالة نحو الكارثة",
 "已む得ず": "بشكل حتمي, لا محالة (بحكم الضرورة؛ بشكل لا مفر منه)\nمثال: انزلق الوضع لا محالة نحو الكارثة",
 "已む無い": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "已む無し": "وَاجِب (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "已める": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب. / أَلْغَى, أَبْطَلَ",
 "已午": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "已己巳己": "رغم ذلك, لكن (على الرغم من أي شيء مخالف (تسبق عادة التنازل))\nمثال: على الرغم من أنني خائف قليلاً، إلا أنني أود تجربتها مع ذلك",
 "已往": "قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل.",
 "已波": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "已里木": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "巳": "ثُعْبَان, حَنَش / باتجاه الجنوب الجنوب الشرقي (إلى أو نحو أو في الجنوب الجنوب الشرقي)",
 "巴": "لغة بالي (لغة براكريتية قديمة (مشتقة من السنسكريتية) وهي اللغة الكتابية والطقسية لبوذية…)",
 "巴丹": "كوكاتو (ببغاء ذو عرف أبيض أو فاتح اللون من المنطقة الأسترالية؛ غالباً ما يتم الاحتفاظ…)",
 "巴人": "فلاح ساذج, قروي بسيط (شخص ليس ذكياً جداً أو غير مهتم بالثقافة)",
 "巴利語": "لغة بالي (لغة براكريتية قديمة (مشتقة من السنسكريتية) وهي اللغة الكتابية والطقسية لبوذية…)",
 "巴戦": "قِتَال الكِلَاب (قتال عنيف بين الكلاب (ينظم أحياناً بشكل غير قانوني للترفيه والمقامرة))\nمثال: ضغينة تعود لقتال سياسي شرس بينهما",
 "巴旦杏": "بَرْقُوق",
 "巴豆油": "زيت كروتون (زيت لزج أصفر مائل للبني من بذور كروتون تيغليوم له تأثير مسهل عنيف)",
 "巵子": "غاردينيا, ياسمين الكاب (شجيرة دائمة الخضرة تزرع على نطاق واسع لزهورها البيضاء الشمعية العطرة الكبيرة…)",
 "巷": "عَلَنِيّ, عَامّ / شَارِع, زَنَقَة / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث. / قَسَّمَ (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ…)\nمثال: أنا أزين القسم.",
 "巷説": "نَمِيمَة, إِشَاعَة",
 "巷談": "إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "巷間": "عالم (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "巻": "دَحْرَجَ, تَدَحْرَجَ / تدوير, ملء (عملية التدوير أو اللف)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً / حَجْم (حجّم الشّيء:وضع حجماً محدّداً له ، قَلَّلَ دوره وهَمَّشَه، قلّل تأثيره؛ حجّم:…)\nمثال: ما حجم البالون؟ / عَقِب, كَعْب / حَجْم (حجّم الشّيء:وضع حجماً محدّداً له ، قَلَّلَ دوره وهَمَّشَه، قلّل تأثيره؛ حجّم:…)\nمثال: ما حجم البالون؟ / طُومَار",
 "巻き": "دَحْرَجَ, تَدَحْرَجَ / تدوير, ملء (عملية التدوير أو اللف)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً / حَجْم (حجّم الشّيء:وضع حجماً محدّداً له ، قَلَّلَ دوره وهَمَّشَه، قلّل تأثيره؛ حجّم:…)\nمثال: ما حجم البالون؟ / عَقِب, كَعْب",
 "巻きあげ": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "巻きひげ": "مِحْلَاق",
 "巻きゲートル": "لفافة ساق (شريط من القماش يلف حول الساق لتشكيل غطاء للساق؛ استخدمه الجنود في الحرب…)",
 "巻きタバコ": "سِيجَارَة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض…)\nمثال: دخن زيري سيجارة.",
 "巻き上げ": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "巻き上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "巻き取り": "تدوير, ملء (عملية التدوير أو اللف)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "巻き取る": "رِيح, ريح",
 "巻き尺": "شَرْيِط قِيَاس",
 "巻き揚げ": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "巻き毛": "جَعْدَة",
 "巻き添い": "اِنْخِرَاط, مُشَارَكَة (فعل المشاركة في أنشطة المجموعة)\nمثال: حاول المعلم زيادة مشاركة طلابه في الأنشطة الصفية",
 "巻き添え": "اِنْخِرَاط, مُشَارَكَة (فعل المشاركة في أنشطة المجموعة)\nمثال: حاول المعلم زيادة مشاركة طلابه في الأنشطة الصفية",
 "巻き添え被害": "أَضْرَار جَانِبِيَّة",
 "巻き爪": "ظفر غائر, ظفر ناشب (ظفر قدم تكون طرفه الحر أو حوافه مغروسة في اللحم المحيط)",
 "巻き物": "وِشَاح, لِفاع",
 "巻き狩り": "اِصْطَادَ, صَادَ",
 "巻き癖": "جَعْدَة",
 "巻き立て": "بِطَانَة",
 "巻き脚絆": "لفافة ساق (شريط من القماش يلف حول الساق لتشكيل غطاء للساق؛ استخدمه الجنود في الحرب…)",
 "巻き貝": "حَلَزُون",
 "巻き起こす": "خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق. / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "巻き起こる": "نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "巻き軸": "طُومَار",
 "巻き返し": "تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب. / تدوير, ملء (عملية التدوير أو اللف)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "巻き返す": "تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب.",
