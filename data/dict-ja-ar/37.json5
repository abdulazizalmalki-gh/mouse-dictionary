 "帳幕": "سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة أو منع أشعة الشمس)",
 "帳消し": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما) / إبطال, إلغاء (الفعل الكلامي للإلغاء أو الفسخ أو الإبطال)",
 "帳簿": "دَفْتَر حِسَابَات",
 "帳簿価格": "قيمة دفتريّة (القيمة التي يُسجل بها الأصل في الميزانية العمومية؛ تساوي التكلفة ناقص الاستهلاك المتراكم)",
 "帳面": "دَفْتَر, مُذَكِّرَة / كَمْبْيُوتَر مَحْمُول, حَاسُوب مَحْمُول",
 "帳面づら": "حِسَاب (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "帳面面": "حِسَاب (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "帷子": "كفن",
 "帷帳": "سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة أو منع أشعة الشمس)",
 "帷幄": "الْقِيَادَة الْعَامَّة / مَقَرّ",
 "帷幕": "سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة أو منع أشعة الشمس)",
 "常": "ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "常々": "دَائِمًا, أَبَدًا",
 "常しえ": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "常しなえ": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "常ならず": "بشكل غير عادي, بشكل لافت (لدرجة أو مدى ملحوظ)\nمثال: كانت طويلة بشكل غير عادي",
 "常に": "دَائِمًا, أَبَدًا\nمثال: 常に疲労感があります。 — أشعر دائما بالتعب.",
 "常にない": "غَيْر مَأْلُوف (لا يُصادف عادة) / استثنائي, غير عادي (غير معتاد أو غير شائع أو غير عادي) / شاذ, عجيب (خارج عن المألوف وغير متوقع بشكل قاطع؛ غريب قليلاً أو حتى شاذ)\nمثال: مشهد ذو جمال غير عادي",
 "常に無い": "غَيْر مَأْلُوف (لا يُصادف عادة) / استثنائي, غير عادي (غير معتاد أو غير شائع أو غير عادي) / شاذ, عجيب (خارج عن المألوف وغير متوقع بشكل قاطع؛ غريب قليلاً أو حتى شاذ)\nمثال: مشهد ذو جمال غير عادي",
 "常世の国": "الجحيم, العالم السفلي ((الأديان) عالم الموتى)\nمثال: لا أحد يذهب إلى هاديس بكل ثروته الهائلة",
 "常世国": "الجحيم, العالم السفلي ((الأديان) عالم الموتى)\nمثال: لا أحد يذهب إلى هاديس بكل ثروته الهائلة",
 "常人": "عَادِيّ, غَيْر مُمَيَّز (ليس مميزاً بأي شكل؛ يفتقر للتميز)",
 "常任": "مَنْزِلَة, مَكَانَة",
 "常任委員会": "لجنة دائمة (لجنة دائمة)",
 "常任理事": "مدير تنفيذي, مسؤول تنفيذي (شخص مسؤول عن إدارة عمل تجاري)",
 "常位胎盤早期剥離": "انفصال المشيمة المبكر (اضطراب في الحمل تنفصل فيه المشيمة قبل الأوان عن جدار الرحم)",
 "常住": "دَائِمًا, أَبَدًا / اسْتِقْرَار, ثَبَات (صفة الديمومة والخلو من التغيير أو التباين) / ثَبَات عَلَى العَهْد, وَفَاء (الإخلاص والاعتمادية في العلاقات الشخصية (خاصة الإخلاص الزوجي)) / ثبات إدراكي ((علم النفس) الميل لإدراك الأشياء بطريقة متشابهة جداً على الرغم من التباينات الواسعة في ظروف الملاحظة)\nمثال: اعتمد البحارة الأوائل على ثبات الرياح التجارية",
 "常住不断": "دَائِم, لَا يَنْقَطِع (غَيْرُ مُنْقَطِعٍ فِي الزَّمَنِ وَمُسْتَمِرٌّ إِلَى أَجَلٍ غَيْرِ مُسَمًّى)",
 "常住不滅": "أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى) / أزهار مجففة, زهرة الخلود (أي من النباتات المختلفة من أجناس مختلفة من الفصيلة النجمية ذات زهور يمكن تجفيفها دون فقدان الشكل أو اللون)",
 "常住坐臥": "أبداً",
 "常住座臥": "أبداً",
