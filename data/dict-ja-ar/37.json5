 "布団たたき": "مضرب السجاد, منفضة السجاد (أداة لضرب الغبار لإخراجه من السجاد)",
 "布団叩き": "مضرب السجاد, منفضة السجاد (أداة لضرب الغبار لإخراجه من السجاد)",
 "布団皮": "تضريب, قماش مبطن (مادة تستخدم لصنع لحاف، أو قماش مبطن) / تنجيد, خياطة اللحف (خياطة عبر طبقات من القماش والحشو لإنشاء تصميم)",
 "布地": "قُمَاش, نَسِيج (النسيج الذي لم يُقَصّ أو يُخَاط)\nمثال: الورق و القماش يمتصان الماء.",
 "布局": "مُؤَلَّف, مُصَنَّف / تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "布川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "布巻": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "布巾": "منشفة أطباق (منشفة لتجفيف الأطباق)",
 "布帛": "قُمَاش, نَسِيج (النسيج الذي لم يُقَصّ أو يُخَاط)\nمثال: الورق و القماش يمتصان الماء.",
 "布教": "توليد, مضاعفة (فعل إنتاج النسل أو المضاعفة من خلال هذا الإنتاج) / ترويج, نشر (نشر شيء (معتقد أو ممارسة) في مناطق جديدة) / انتشار (حركة موجة عبر وسط)",
 "布教師": "مُبَشِّر, مُنَصِّر",
 "布教者": "مُبَشِّر, مُنَصِّر",
 "布施": "إيتاء الصدقة, تصدق (تقديم مساهمات طوعية لمساعدة الفقراء)",
 "布村": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "布片": "قطعة قماش, قطعة مادة (جزء منفصل يتكون من القماش)",
 "布田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "布目": "مَلْمَس",
 "布石": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات) / تَحْضِير, إِعْدَاد",
 "布線": "تسليك, تمديد الأسلاك (عمل تركيب الأسلاك لنظام أو جهاز كهربائي) / أسلاك, تمديدات كهربائية (دائرة من الأسلاك لتوزيع الكهرباء)",
 "布置": "تَرْتِيب (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "布衣": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "布袋竹": "خيزران صنارة السمك (خيزران صغير من جنوب شرق الصين له سيقان رفيعة مرنة عندما تكون صغيرة)",
 "布袋腹": "مدفأة كرشية, موقد منتفخ (موقد منتفخ الشكل يتم فيه حرق الحطب أو الفحم) / كرش (مصطلحات عامية للكرش أو البطن البارز)",
 "布袋蘭": "خف الجنية, كاليبسو (أوركيد مستنقعات نادر في المنطقة المعتدلة الشمالية يحمل زهرة بيضاء إلى وردية وحيدة معلمة بالأرجواني عند طرف ساق محمر منتصب فوق ورقة قاعدية واحدة)",
 "布袴": "شِبْهُ رَسْمِيّ (رَسْمِيٌّ بِشَكْلٍ مُعْتَدِلٍ؛ يَسْتَلْزِمُ ارْتِدَاءَ بَدْلَةِ عَشَاءٍ)",
 "布設": "وضع البيض (إنتاج البيض (خاصة في الطيور))",
 "布谷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "布達": "إِشْعَار, إِخْطَار / تَنْبِيه, إِشْعَار",
 "布陣": "تَشْكِيلَة",
 "帆": "شِرَاع / أَبْحَرَ (غالبا ما يستخدم كجمع قلّة)\nمثال: أبحر زيري في الاتجاه المعاكس للنهر.",
 "帆かけ船": "قارب شراعي (سفينة شراعية صغيرة؛ عادة بصارية واحدة)",
 "帆世": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "帆前船": "قارب شراعي (سفينة شراعية صغيرة؛ عادة بصارية واحدة)",
 "帆布": "قماش الأشرعة (قماش قوي (مثل قماش القنب القطني) يستخدم لصنع الأشرعة والخيام)",
 "帆座": "الشراع",
 "帆掛け船": "قارب شراعي (سفينة شراعية صغيرة؛ عادة بصارية واحدة)",
 "帆掛船": "قارب شراعي (سفينة شراعية صغيرة؛ عادة بصارية واحدة)",
 "帆柱": "صَارٍ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما.",
 "帆桁": "حَدِيقَة (الحَديقَةُ، الرَّوْضَةُ ذاتُ الشجرِ؛ حديقة , العاطل عن العمل في اللهجة العراقية وأصل تولد المعنى أن بعض العاطلين يقضون أوقاتهم في العناية بحدائق بيوتهم, فإذا سألهم سائل عن عملهم, ما هو؟…) / يَارْدَة / يَارْد\nمثال: ليس لدينا حديقة.",
 "帆檣": "صَارٍ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما.",
 "帆綱": "حبل الرفع (حبل لرفع أو خفض شراع أو علم)",
 "帆翔": "طيران شراعي (نشاط الطيران بطائرة شراعية) / بَاسِق, سَامِق (ذو ارتفاع مهيب؛ خاصَّة يبرز فوق غيره) / صَاعِد, مُتَصَاعِد (يصعد إلى مستوى أعلى بكثير من المعتاد)",
 "帆船": "سَفِينَة شَرَاعِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "帆走": "إِبْحَار",
 "帆走船": "قارب شراعي (سفينة شراعية صغيرة؛ عادة بصارية واحدة)",
 "帆足": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "帆風": "رياح خلفية (رياح تهب في نفس اتجاه مسار سفينة أو طائرة)",
 "希": "نَادِر / خَفَّفَ (قلل شيئًا أو نقص من حدته؛ هون أو لطف من شدة أمر)\nمثال: خفف زيري السرعة. / نَادِر",
 "希う": "اِسْتَجْدَى, تَسَوَّلَ / تَسَوَّلَ, رَجَا / بيك",
 "希わくは": "لَيْتَ, تَمَنَّى (يفيد التمني)\nمثال: ليت بحاجة لتعمل ساعات إضافية.",
 "希わくば": "لَيْتَ, تَمَنَّى (يفيد التمني)\nمثال: ليت بحاجة لتعمل ساعات إضافية.",
 "希ガス": "غَازٌ خَامِل",
 "希ガス類": "غَازٌ خَامِل",
 "希世": "نَادِر",
 "希代": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو نوعه) / فَرِيد, نَادِر (يتميز بجودة غير مألوفة؛ خاصة من الدرجة العليا أو المتطرفة في نوعه)\nمثال: طيور غير شائعة",
 "希代未聞": "غَيْر مَسْبُوق, لَمْ يُسْمَع بِهِ (لم يكن معروفاً من قبل)",
 "希土": "عنصر أرضي نادر, لانثانيد (أي عنصر من سلسلة اللانثانيدات (الأعداد الذرية من 57 إلى 71))",
 "希土類": "عنصر أرضي نادر, لانثانيد (أي عنصر من سلسلة اللانثانيدات (الأعداد الذرية من 57 إلى 71))",
 "希土類元素": "عنصر أرضي نادر, لانثانيد (أي عنصر من سلسلة اللانثانيدات (الأعداد الذرية من 57 إلى 71))",
 "希少": "نَادِر",
 "希少価値": "تَأَنُّق مُتَكَلَّف, تَحَذْلُق (صفة التشدد أو الإفراط في التهذيب والتأنق) / قيمة لا تقدر بثمن, نفاسة (الجودة الإيجابية لكون الشيء ثميناً ويفوق القيمة) / تكلفة باهظة, نفاسة (الجودة التي يمتلكها شيء ذو سعر أو قيمة كبيرة)",
 "希少品": "تحفة, شيء نادر (شيء غير عادي - ربما يستحق الجمع) / رقة, ندرة (جودة التخلخل (قلة الكثافة)) / ندرة (ندرة ملحوظة)\nمثال: رقة الغلاف الجوي العلوي",
 "希少性": "شح, ندرة (كمية صغيرة وغير كافية)",
 "希有": "نَادِر",
 "希望": "أَمَلَ, رَجَا ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / أَمَل, رَجَاء ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل. / توقع, احتمال / تَنْقِيْب (نقّب إذا سار في البلاد طلباً للمهرب ، نقّب عن الأخبار وغيرها:بحث عنها،هو البحث عن كلّ شيء والتّفتيش مطلقاً؛ نقّب مبالغة في نَقَب ، نقّب عن الشيء :فحص عنه فحصاً بليغاً)",
 "希望の光": "بصيص الأمل",
 "希望の星": "حزمة ضوئية, شعاع (عمود من الضوء (كما من منارة))",
 "希望価格": "سِعْر طَلَب (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ)\nمثال: إتفقوا على سعر.",
 "希望的": "تَوَّاق, طَامِح (يرغب في الاعتراف والتقدم أو يسعى إليهما) / تواق, راغب (لديه أو يعبر عن رغبة في شيء ما)\nمثال: راغب في منصب رفيع",
 "希望的観測": "تَفْكِير رَغْبَوِيّ (عملية عقلية يتم من خلالها تحليل الأفكار أو المعلومات للوصول إلى فهم أو قرار؛ إعمال العقل في تأمل أو تخطيط لأمر معين)\nمثال: ابدأ في التفكير.",
 "希望者": "مُقَدِّم طَلَب (الذي قُدِّمَ؛ في : رتبة عسكرية هي خامس الرتب في الترتيب التصاعدي الرَائِد أدنى منه والعَقِيْد أعلى منه) / مُتَقَدِّم\nمثال: تزحلقت العربة المسرعة و اصطدمت مقدمة العربة ب مؤخرة الشاحنة بشكل مفاجئ جدا .",
 "希望語": "إِسْبِرَانْتُو",
 "希求": "شَوْق (نزوعُ النَّفْس إِلى الشيء، أو تَعَلُّقها به؛ مصدر الفعل شَاقَ)\nمثال: سأشعر بالشوق إليك.",
 "希求法": "صِيغَة التَّمَنِّي (صيغة تعبر عن رغبة أو أمل)",
 "希突起膠細胞": "خلية دبقية قليلة التغصن (خلية من خلايا الدبق العصبي قليلة التغصن)",
 "希臘陸亀": "سلحفاة أوروبية (سلحفاة برية صغيرة من جنوب أوروبا)",
 "希薄": "رَفِيع, رَقِيق / ضعيف, ضعيفة / غَائِب, مَفْقُود (غير موجود أو مفتقد)",
 "希語": "يُونَانِيّ, إِغْرِيقِيّ",
 "希釈": "تَخْفِيف",
 "希里": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "帙": "غِطَاء وَاقٍ (الغطاء الطبيعي الصلب لبعض الكائنات الحية) / حماية, غطاء واقٍ (غطاء يهدف إلى الحماية من التلف أو الإصابة)\nمثال: لم يكن لديهم حماية من الغبار الذري",
