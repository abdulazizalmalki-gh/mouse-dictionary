 "差しつける": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "差しで": "وَجْهًا لِوَجْه",
 "差し上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "差し上る": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "差し交わす": "صَلِيب\nمثال: عبر جرذ الطريق.",
 "差し付ける": "نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "差し伸べる": "تَمَدَّدَ / دفع, قوة دافعة (فعل تطبيق قوة لدفع شيء ما)\nمثال: بعد الوصول إلى السرعة المطلوبة يتم قطع الدفع / اِقْتِرَاح\nمثال: اقترح سامي المساعدة.",
 "差し傘": "مِظَلَّة, شَمْسِيَّة",
 "差し入れ": "إدخال, إيلاج (عملية وضع شيء داخل شيء آخر)\nمثال: بمساعدة إضافات صديقه تم سرد قصته في النهاية",
 "差し入れる": "أَدْخَلَ / نَقَلَ",
 "差し入れ口": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)\nمثال: كشف شعاع الضوء عن فتحه الحذر للباب",
 "差し出がましい": "صَاعِدًا",
 "差し出し先": "خُطْبَة, نِدَاء\nمثال: نسيت عنوان توم.",
 "差し出す": "حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي / تَضْحِيَة, قُرْبَان / أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "差し出る": "حَشَرَ أَنْفَهُ (جَمَعَ الناسَ أو الأشياءَ في مكانٍ ضيّق؛ ساقهم إلى مكان معين، أو جمعهم قهرًا) / نَتَأَ",
 "差し出口": "لَا مُبَرِّر لَه, مَجَّانِيّ (غير ضروري وغير مبرر)",
 "差し合い": "إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع)",
 "差し向い": "وَجْهًا لِوَجْه",
 "差し向かい": "وَجْهًا لِوَجْه",
 "差し向ける": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / مُبَاشِر\nمثال: تبدو شاحب الوجه.",
 "差し延べる": "تَمَدَّدَ / دفع, قوة دافعة (فعل تطبيق قوة لدفع شيء ما)\nمثال: بعد الوصول إلى السرعة المطلوبة يتم قطع الدفع / اِقْتِرَاح\nمثال: اقترح سامي المساعدة.",
 "差し引き": "اِسْتِنْتَاج (اِسْتِنْتَاج)\nمثال: المنطق هو طريقة نظامية للوصول إلى الاستنتاج الخاطئ مع الثقة.",
 "差し引き勘定": "رَصِيد",
 "差し引く": "ذيل قصير, ذيل مقصوص (ذيل قصير أو مقصر لبعض الحيوانات)\nمثال: وصلت السفينة إلى الرصيف متأخرة أكثر من يوم",
 "差し当たって": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي",
 "差し当たり": "في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي / إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع)",
 "差し当たる": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه.",
 "差し押える": "إِسْتَوْلَى عَلَى",
 "差し押さえ": "حجز, مصادرة (الاستيلاء على شيء عن طريق الإجراءات القانونية)\nمثال: عانى من نوبة صرع",
 "差し押さえる": "إِسْتَوْلَى عَلَى",
 "差し招く": "أَشَارَ, أَوْمَأَ",
 "差し挟む": "أَدْخَلَ / قَاطَعَ / مَرْفَأ, مَرْسَى",
 "差し挾む": "أَدْخَلَ / قَاطَعَ / مَرْفَأ, مَرْسَى",
 "差し掛かる": "اِقْتَرَبَ\nمثال: هو واصل الاقتراب مني. / بروز, تدلّ (نتوء يمتد إلى ما بعد شيء آخر أو يتدلى فوقه)",
 "差し掛け": "سقيفة مائلة (مأوى بسيط له سقف منحدر واحد فقط)",
 "差し掛け小屋": "سقيفة مائلة (مأوى بسيط له سقف منحدر واحد فقط)",
 "差し控える": "اِمْتَنَعَ (مَنَعَ نفسه؛ كان مَنِيْعًا يصعب الوصول إليه)",
 "差し換え": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر)\nمثال: استبدال النجم لن يكون سهلاً / صَحِيح, صَوَاب\nمثال: صحح نطقي من فضلك.",
 "差し換える": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "差し支え": "إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع)",
 "差し支えない": "مَسْمُوحٌ بِخَصْمِهِ (قابل للخصم وفقاً لقوانين الضرائب)\nمثال: سلوك مسموح به في المدرسة",
 "差し支える": "عَاقَ, عَرْقَلَ",
 "差し昇る": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "差し替え": "استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر)\nمثال: استبدال النجم لن يكون سهلاً / صَحِيح, صَوَاب\nمثال: صحح نطقي من فضلك.",
 "差し替える": "تَغَيَّرَƒ\nمثال: أنا غير متفاجئ.",
 "差し止め": "حَظْر, مَنْع ((حَظَّرَ): بالغ في الحظر)\nمثال: حظر تويتر توم لمدة خمسة عشرة يوما.",
 "差し止める": "وَقَفَ, تَوَقَّفَ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "差し油": "زَيْت, زيت (ما يعصر من الزَيْتُون؛ كل سائل لزج يستخرد من النبات يستخدم كما يستخدم السمن)\nمثال: خبأن ذلك الزيت.",
 "差し渡し": "طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "差し湯": "مشكلة عويصة, ورطة (مأزق خطير أو مؤلم)\nمثال: آراؤه حول العرق أوقعته في ورطة سياسية",
 "差し潮": "فيضان, مد صاعد (حدوث تدفق المياه للداخل (بين الجزر والمد العالي التالي))\nمثال: مد في شؤون البشر، إذا أُخذ في ذروته، يقود إلى الثروة",
 "差し物": "أعمال الموبيليا, صناعة الخزائن (حرفة صنع الأثاث (خاصة الأثاث عالي الجودة)) / دَبُّوس / علم الدولة (علم يظهر جنسيته)\nمثال: أعلنت ربطة عنقه عن ألوان مدرسته",
 "差し立て": "إرسال, إيفاد (فعل إرسال شيء ما)\nمثال: تم إنجازه بسرعة وكفاءة",
 "差し立てる": "وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "差し紙": "اِسْتِدْعَاء (دَعْوَةً؛ طَلَب الْمُثُولِ)\nمثال: أراد توم استدعاء الشرطة، ولكن ماري لم تسمح له.",
 "差し縄": "دبوس التوازن (أي من الأجنحة الخلفية الضامرة للحشرات ثنائية الأجنحة؛ تستخدم للحفاظ على التوازن…)",
 "差し繰る": "رَتَّبَ (رتَّبْته ترتيباً:ثَبَّتَه؛ رتّب الشّيء:نَسَّقَه ونَظَّمَه ووضعه في موضعه)\nمثال: رتب فاضل غرفتة.",
 "差し置く": "نَاهِيك",
 "差し覗く": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "差し許す": "سَمَحَ, أَذِنَ (يَسَّرَ وسَهَّلَ وهَيَّأَ لَهُ الأَمْرَ، جَعَلَه مُمْكِنًا. (يتعدى بالباء)…)\nمثال: سمح لسكورة بالسباحة.",
 "差し詰め": "فِي النِّهَايَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / في الوقت الحالي, مؤقتاً (بشكل مؤقت)\nمثال: سنتوقف في الوقت الحالي",
 "差し越す": "أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية.",
 "差し込み": "إدخال, إيلاج (عملية وضع شيء داخل شيء آخر)\nمثال: بمساعدة إضافات صديقه تم سرد قصته في النهاية / قَابِس / اِخْتِلَاج (الخَلْجُ: الجَذْبُ،واختلج شيء في صدري:احتكأ مع شك؛ أصل الاختلاج: الحركة…)",
 "差し込み口": "قَابِس",
 "差し込む": "أَدْخَلَ",
 "差し遣す": "إرسال, إيفاد (فعل إرسال شيء ما)\nمثال: تم إنجازه بسرعة وكفاءة",
 "差し遣わす": "إرسال, إيفاد (فعل إرسال شيء ما)\nمثال: تم إنجازه بسرعة وكفاءة",
 "差し金": "زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية) / إثارة, تحريض (الإشعال المتعمد والمقصود (للمشاكل أو الفتنة))",
 "差し障り": "إعاقة, عرقلة (فعل الإعاقة أو العرقلة أو المنع) / إِزْعَاج",
 "差し障りのない": "بَريء, غَيْر مُؤْذٍ (لا يَنْتُج عَنْه ضَرَر؛ بَريء وغَيْر خَطِر)",
 "差し障る": "عَاقَ, عَرْقَلَ",
 "差し響く": "نَفُوذ, تَأْثِير\nمثال: اختفى فلم ير له أثر.",
 "差す": "لَمَعَ, وَمَضَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه. / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / أَدْخَلَ",
 "差をつける": "مَيَّزَ",
 "差を付ける": "مَيَّزَ",
 "差上げる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته. / أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
