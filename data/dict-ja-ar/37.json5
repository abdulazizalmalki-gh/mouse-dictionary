 "差出口": "لَا مُبَرِّر لَه, مَجَّانِيّ (غير ضروري وغير مبرر)",
 "差分": "فَرْق, اِخْتِلَاف",
 "差別": "تَمْيِيْز / تَفْرِيق",
 "差別主義者": "مُتَعَصِّب",
 "差別化": "تفاضل (العملية الرياضية للحصول على مشتق دالة)\nمثال: من الضروري التمييز بين الحب والافتتان",
 "差別的": "تَفْضِيلِيّ, تَمْيِيزِيّ (يُظهر تحيزاً أو محاباة)\nمثال: قاضٍ متحيز",
 "差動": "تفاضلي, فارقي (متعلق بـ أو يظهر فرقاً واختلافاً)\nمثال: معاملة تفاضلية",
 "差動歯車": "ترس تفاضلي, دفرنس (ترس مخروطي يسمح بتدوير عمودين بسرعات مختلفة؛ يستخدم في المحور الخلفي للسيارات…)",
