 "平和国家": "مُحِبٌّ لِلسَّلَام (مَيَّالٌ لِلسَّلَامِ أَوْ رَاغِبٌ فِيه)",
 "平和思想": "سَلَامِيَّة, سِلْمِيَّة",
 "平和条約": "مُعَاهَدَة سَلَام (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو…)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "平和的": "سِلْمِيّ",
 "平和維持": "حِفْظ سَلَام (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ…)\nمثال: حفظ رقم هاتفها.",
 "平和裏": "سلمي, مسالم (غير مضطرب بالنزاع أو الاضطراب أو الحرب)\nمثال: أمة مسالمة",
 "平和論者": "مُسَالِم",
 "平和部隊": "فيلق السلام (منظمة مدنية ترعاها حكومة الولايات المتحدة تساعد الناس في البلدان النامية)",
