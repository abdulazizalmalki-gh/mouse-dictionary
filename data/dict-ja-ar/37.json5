 "小社": "سَرِيَّة / شَرِكَة",
 "小穂": "شويكة (هيكل مدبب صغير يعمل كعنصر هيكلي في مختلف اللافقاريات البحرية والمياه العذبة مثل الإسفنج والمرجان)",
 "小突き回す": "مُسْتَأْسِد, مُتَنَمِّر / تَنَمَّرَ (صار كالنمر شراسة؛ أذى وألحق الضرر الجسدي أو النفسي بمن هو أضعف منه)",
 "小突く": "خَزَّ (\"خَزَّهُ بسكِّينٍ\" : طَعَنَهُ بِهِ؛ \"خَزَّهُ بِبَصَرِهِ\" : أَصَابَتْهُ عَيْنُه)\nمثال: إذا كنت وخز لنا، هل نحن لا ينزف؟",
 "小窓": "قمرية, نافذة هلالية (فتحة بيضاوية أو دائرية؛ للسماح بدخول الضوء إلى قبة أو قبو)",
 "小童": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى. / شاب, يافع (شخص صغير السن (خاصة شاب أو صبي)) / براتوورست (سجق خنزير صغير) / طفل شقي (طفل مزعج جداً) / حَوَارِيّ, تِلْمِيذ",
 "小競り合い": "مُنَاوَشَة / شِجَار / شَاجَرَ",
 "小竹": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小笠原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小策": "حِيلَة",
 "小筥": "صندوق مجوهرات (صندوق صغير ومزخرف غالباً لحفظ المجوهرات أو الأشياء الثمينة الأخرى) / تابوت, نعش (صندوق يدفن فيه الميت أو يُحرق)",
 "小管": "قنية (قناة أو مجرى صغير كما في بعض العظام وأجزاء النباتات)",
 "小箱": "صندوق مجوهرات (صندوق صغير ومزخرف غالباً لحفظ المجوهرات أو الأشياء الثمينة الأخرى) / تابوت, نعش (صندوق يدفن فيه الميت أو يُحرق)",
 "小節": "حَانَة, بَار",
 "小篇": "قِصَّة قَصِيرَة, أُقْصُوصَة",
 "小米草": "عَرْقُون",
 "小粋": "أنيق, عصري (كائن أو متوافق مع الموضات الاجتماعية الحالية) / أنيق, عصري (لديه أناقة أو ذوق أو رقي في الأخلاق أو الملبس)\nمثال: ملابس عصرية / مَغْرُور, مُتَعَصِّب",
 "小粒": "صَغِير, صغير / مَحْدُود",
 "小糠雨": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة",
 "小紅書": "أَحْمَر, حُمْرَة (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا) / حَمْرَاء (مؤنث أَحْمَر؛ صفة لما كان لونها الحَمَار؛ ذوات الرايات الحمراء أو الحُمُر: عن المومسات) / أحمر (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا)\nمثال: أردت حذاء أحمر.",
 "小網": "ثرب صغير (جزء من الصفاق متصل بالمعدة والكبد ويدعم الأوعية الكبدية)",
 "小網座": "قَلَنْسُوَة (القُلُنْسُوَة: لباس داخلي للرأس يُلبس غالبا داخليا تحت العَمَامَة أو الكُوفِيَّة أو غيره من أغطية الرأس للرجال والنساء، يسمى أيضا الطَاقِيَّة؛ القُلُنْسُوَة: لباس للرأس يشبه الداخلي إلا أنه يلبس لوحده، قد يكون أبيضا وقد يكون مطرزا، يسمى أيضا الطَاقِيَّة)\nمثال: كان زيري يرتدي قلنسوة.",
 "小綺麗": "دَقِيق, مُتْقَن (خالٍ من الخَرَق؛ مُنفَّذ بدقة ومهارة) / صِرْف, غَيْر مَمْزُوج ((عَنِ المَشْرُوب الكُحُولِيّ) بِدُون مَاء) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / أَنِيق ظَاهِرِيًّا, بَرَّاق (يبدو مؤثّرًا من السطح لكنّه يفتقر إلى العمق والدقّة)",
 "小編": "قِصَّة قَصِيرَة, أُقْصُوصَة",
 "小罪": "خطيئة عرضية, صغيرة من الصغائر (خطيئة يمكن غفرانها وتعتبر مستوجبة لفقدان جزئي فقط للنعمة)",
 "小羊": "حَمَل, خَرُوف (رَفَعَ، أَقَلَّ) / لَحْم اَلضَّأْن, خَرُوف (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: حمل سامي سلاحه.",
 "小羊歯": "الْعَالَم الْقَدِيم",
 "小羽鵜": "قَصِير الأَجْنِحَة ((عن بعض الحشرات خاصّة) ذو أجنحة قصيرة جدًّا أو أثريّة)",
 "小翼羽": "الجَنَاحُ الكَاذِب, جُنَيْح (خصلة من الريش الصغير الصلب على الإصبع الأول لجناح الطائر) / جُنَيْح, مِقْرَنَة (هيكل يشبه الحرشفة يقع بين قاعدة الجناح والدبوس في الذباب ثنائي الجناحين)",
 "小者": "شاب, يافع (شخص صغير السن (خاصة شاب أو صبي)) / خَادِم, خَادِمَة",
 "小耳": "أُذُن (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / أُذْن (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / سُنْبُلَة / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)",
 "小職": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / براتوورست (سجق خنزير صغير) / طفل شقي (طفل مزعج جداً) / حَوَارِيّ, تِلْمِيذ",
 "小股": "أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي) / مفرق الساقين, منشعب (الزاوية التي تشكلها الجوانب الداخلية للساقين حيث تلتقي بجذع الإنسان) / شعبة, مفترق (منطقة الزاوية المتكونة من تقاطع فرعين)\nمثال: أخذوا المفترق الجنوبي",
 "小肥り": "سمين",
 "小胆": "تهيب, جبن (الخوف عند الخوض في أماكن أو أنشطة جديدة ومجهولة) / جبن, خجل (الخوف من المجهول أو غير المألوف أو الخوف من اتخاذ القرارات)",
 "小胞": "حويصلة, كيس (كيس صغير طبيعي تشريحياً أو بنية شبيهة بالمثانة (خاصة تلك التي تحتوي على سائل))",
 "小胞体": "شبكة إندوبلازمية",
 "小胞子": "بوغ دقيق, بوغ صغير (أصغر نوعي الأبواغ المنتجة في النباتات متباينة الأبواغ؛ يتطور في كيس اللقاح إلى نبات مشيجي ذكري)",
 "小胞子嚢": "محفظة بوغية صغيرة (بنية نباتية تنتج أبواغاً صغيرة)",
 "小胸筋": "صدرية صغرى (عضلة هيكلية تسحب لوح الكتف لأسفل أو ترفع الأضلاع)",
 "小脇": "إِبْط (ما تحت الذراع بين ال المتن والمنكب؛ إبط الحيوان: ما تحت منكبه، ما يعادل إبط الإنسان عنده)",
 "小脳": "مُخَيْخ",
 "小脳性": "مخيخي (يتعلق بـ أو مرتبط بالمخيخ)\nمثال: شريان مخيخي",
 "小腰": "خَصْر, وَسَط (خصره خصرا ضرب خاصرته)",
 "小腸": "الْأَمْعَاء الدَّقِيقَة",
 "小腹": "بَطْن (خلاف الظهر؛ الجزء الباطن من الشيء غير الظاهر؛ الجزء الداخلي من الشيء)\nمثال: عندي بطن الجعة.",
 "小膝": "رُكْبَة",
 "小膠細胞": "خلايا دبقية صغيرة (نسيج عصبي دبقي من أصل أديمي متوسط يمكن أن يصبح بلعمياً)",
 "小臼歯": "نَاجِذ, ضَاحِك",
 "小舅": "شَقِيق زَوْج, شَقِيق زَوْجَة (كل ما شُقَّ نصفين فكل من النصفين شقيق الآخر؛ الأخ من نفس الأم والأب)\nمثال: لا أحد هناك عرف أن توم هو شقيق ماري.",
 "小舞": "شريحة خشبية (شريط رفيع ضيق من الخشب يستخدم كدعم للجص أو لعمل الشبكات الخشبية)",
 "小舟": "قارب صغير (قارب صغير الحجم)",
 "小船": "قارب صغير (قارب صغير الحجم)",
 "小芝居": "عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / مَثَّلَ (الشَبَه؛ النَظِير) / تَصَرَّفَ\nمثال: المهم هو العمل.",
 "小花": "زهيرة (زهرة صغيرة (خاصة تلك التي تكون جزءًا من زهرة مركبة))",
 "小花柄": "تَعْرِيجَة, سَاق / سُوَيْق",
 "小花梗": "تَعْرِيجَة, سَاق / سُوَيْق",
 "小荳蔲": "هَال, هَيْل / حَبْهَان, هَال",
 "小荷物": "رِزْمَة, رُزْمَة",
 "小菅": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小菊": "وَرَقَة",
 "小菱形筋": "معينية صغرى (عضلة معينية تسحب لوح الكتف باتجاه العمود الفقري وإلى الأعلى قليلاً)",
 "小菱形骨": "عظم منحرف (عظم الرسغ الواقع بين العظم المربعي والعظم الكبير)",
 "小葉": "فص (نتوء مستدير يُعد جزءاً من هيكل أكبر) / فص ((في التشريح) قسم فرعي مستدير نوعاً ما لعضو أو جزء جسدي) / فص (الاستجابة المعززة لهوائي في اتجاه معين كما هو موضح بواسطة حلقة في نمط إشعاعه) / فَصّ ((في علم النبات) جزء تنقسم إليه الورقة)\nمثال: شحمة الأذن / شرفة, وريقة (سديلة مثلثة رقيقة لصمام القلب) / كتيب, كراسة (كتاب صغير عادة ما يكون له غطاء ورقي) / وريقة (جزء من ورقة مركبة)",
 "小蔭": "ركن, زاوية (زاوية داخلية تتشكل من التقاء جدارين) / ركن منعزل, زاوية (مكان محمي ومنعزل)\nمثال: كان البيانو في إحدى زوايا الغرفة",
 "小蘗": "باربيريس ياباني (شجيرة نفضية مدمجة لها توت أحمر دائم؛ واسعة الانتشار في الزراعة خاصة للأسوار الحية)",
 "小虎": "سِكِّير, سِكِّيرَة / سِكِّير, خِمِّير / رُوحِيّ, كُحُولِيّ",
 "小虫": "هاموش (ذبابة دقيقة ذات جناحين تشبه البعوض تفتقر إلى أجزاء الفم القارضة؛ تظهر في أسراب راقصة خاصة بالقرب من الماء)",
 "小蜂": "دبور كالسيد, ذبابة كالسيد (أي من الحشرات الدقيقة المتنوعة التي تتطفل يرقاتها على بيض ويرقات الحشرات الأخرى؛ والعديد منها مفيد في القضاء على الحشرات الضارة)",
 "小蝦": "رُوبِيَان / جَمْبَرِيّ / إِرْبِيَان / قُرَيْدِس",
 "小行列式": "صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة) / أصغر, أقلية (أقل في العدد أو الحجم أو المقدار) / بسيط, ثانوي (أقل في النطاق أو التأثير) / قاصر (لم يبلغ السن القانونية)\nمثال: حصة صغيرة من الأرباح",
 "小西": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小見": "رَأْي, نَظَر",
 "小見出し": "عنوان فرعي (عنوان لقسم فرعي من نص)",
 "小見川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小規模": "صَغِير المِقْيَاس (مبنيّ أو مرسوم على نطاق صغير) / صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة)",
 "小言": "تَعْنِيف, تَقْرِيع (توبيخ شخص ما بقسوة) / شِكَايَة, شَكْوَى",
 "小計": "مجموع فرعي (مجموع جزء من مجموعة من الأرقام)",
 "小話": "نَادِرَة / أُطْرُوفَة / أُفْكُوهَة / طُرْفَة / فُكَاهَة / لَطِيفَة (مؤنث لَطِيْف؛ ذات اللطف والطافة؛ يقصد بها أحيانا جميلة بدون أن تكون ملفتة للنظر)\nمثال: هي مدرسة لطيفة.",
 "小説": "مُسْتَجِدّ / رِوَايَة",
 "小説化": "تحويل إلى رواية, روينة (تحويل شيء ما إلى شكل رواية)",
 "小説家": "رِوَائِيّ, رِوَائِيَّة",
 "小論文": "مَنْشُور, كُرَّاسَة",
 "小谷": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小谷渡": "سرخس الشريط الفلوريدي, سرخس لسان البقر (سرخس هوائي أو أرضي أحياناً شائع ذو أوراق شريطية خضراء مصفرة شاحبة؛ من فلوريدا إلى جزر الهند الغربية والمكسيك وجنوباً إلى أوروغواي) / سرخس لسان الأيل, لسان الأيل (سرخس أوراسي بسعف رمحي بسيط) / أولفيرسيا, لسان الأيل (سرخس أرضي أمريكي استوائي بسعف رمحي جلدي؛ يوضع أحياناً في جنس بوليبوتريا)",
 "小谷渡り": "سرخس الشريط الفلوريدي, سرخس لسان البقر (سرخس هوائي أو أرضي أحياناً شائع ذو أوراق شريطية خضراء مصفرة شاحبة؛ من فلوريدا إلى جزر الهند الغربية والمكسيك وجنوباً إلى أوروغواي) / سرخس لسان الأيل, لسان الأيل (سرخس أوراسي بسعف رمحي بسيط) / أولفيرسيا, لسان الأيل (سرخس أرضي أمريكي استوائي بسعف رمحي جلدي؛ يوضع أحياناً في جنس بوليبوتريا)",
 "小谷野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小豆": "فاصولياء الأزوكي, لوبياء زاوية (نبات حولي كثيف يزرع على نطاق واسع في الصين واليابان للدقيق المصنوع من بذوره)",
 "小豆アイス": "بُوظَة, آيْس كِرِيم",
 "小豆色": "بُنِّيّ مُحْمَرّ (بني مع مسحة حمراء)",
 "小豆蔲": "هَال, هَيْل / حَبْهَان, هَال",
 "小豆象虫": "فاصولياء الأزوكي, لوبياء زاوية (نبات حولي كثيف يزرع على نطاق واسع في الصين واليابان للدقيق المصنوع من بذوره)",
 "小賢しい": "قَلِيل الأَدَب, وَقِح (جريء بشكل مسيء وبذيء) / مَاكِر",
 "小走り": "خبب (مشية أسرع من المشي؛ تضرب الأرجل المتقابلة قطرياً الأرض معاً) / هرولة (وتيرة جري بطيئة) / ترجمة حرفية مساعدة (ترجمة حرفية تُستخدم في دراسة لغة أجنبية (غالباً ما تُستخدم بشكل غير مشروع للغش)) / تروتسكي (راديكاليون يدعمون نظرية تروتسكي بأن الاشتراكية يجب أن تتأسس في جميع أنحاء العالم من خلال الثورة المستمرة)",
 "小路": "زُقَاق, ممر / مَسَار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا من شأنه أن يضع العاصفة في مسار تصادم افتراضي مع بركان كيلويا ، في الجزء الجنوبي من الجزيرة. / طَرِيق, صِرَاط (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / صِرَاط, مَسَار / مَحَجَّة\nمثال: أسأل عن الطريق.",
 "小車": "وَاسِطَة, وَسِيلَة",
 "小辞典": "قاموس جيب (قاموس صغير بما يكفي لحمله في جيبك)",
 "小農": "مزارع صغير (مزارع يعمل في مزرعة صغيرة المساحة)",
 "小返り": "المُسْتَوِي المائِل",
 "小道": "طَرِيق, صِرَاط (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / صِرَاط, مَسَار / مَحَجَّة\nمثال: أسأل عن الطريق.",
 "小道具": "جِهَاز / مُلْك, مَال (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / خَاصَّة / خَاصِّيَّة\nمثال: زيري ملك لنفسه.",
 "小道具方": "مسؤول الإكسسوارات المسرحية (عضو في طاقم المسرح مسؤول عن الممتلكات والإكسسوارات)",
 "小遣い": "مَصْرُوف جَيْب, مَصْرُوف",
 "小遣い銭": "مَصْرُوف جَيْب, مَصْرُوف",
 "小遣銭": "مَصْرُوف جَيْب, مَصْرُوف",
 "小選挙区比例代表並立制": "نظام التصويت, نظام انتخابي (نظام قانوني لاتخاذ خيارات ديمقراطية)",
 "小部": "قَصِير, قصير (ضد الطويل) / قَصِير (ضد الطويل)\nمثال: حبل الكذب قصير.",
 "小部屋": "عَرِين, حُجْرَة (اِسْمٌ لِمَاْوَى الأَسَد) / خِزَانَة (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "小酒": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小野": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "小野寺": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小野田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小金目梟": "بُومَة صَغِيرَة",
 "小鉤": "إمساك, قبضة (فعل الإمساك) / مشبك (أداة تثبيت (مثل إبزيم أو خطاف) تستخدم لربط شيئين معاً)\nمثال: أرخى قبضته عن ذراعي",
 "小銃": "بُنْدُقِيَّة (أنبوب لاطلاق الرصاص، وتعتبر من الأسلحة؛ الْبُنْدُقِيََة: فِي إِيطَالْيَا)\nمثال: البندقية مدينة جميلة.",
 "小銭": "فُرَاطَة",
 "小錐": "مخراز, مخراز المسامير (مخراز لعمل ثقوب صغيرة للمسامير الصغيرة أو البراغي الصغيرة)",
 "小長元坊": "يؤيؤ",
 "小門": "باب صغير, بويب (بوابة أو باب صغير (خاصة الذي يكون جزءاً من باب أكبر))",
 "小閑": "ركود, هدوء مؤقت (فترة من الطقس الهادئ) / فترة هدوء, هوداة (توقف تكون فيه الأمور هادئة أو الأنشطة متناقصة)\nمثال: كان هناك هدوء مؤقت في العاصفة",
 "小間使": "خَادِمَة, خَدامَة",
 "小間使い": "خَادِمَة, خَدامَة",
 "小間切れ": "قِطْعَة, شَقَفَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب)\nمثال: يصنع قطعة أثاث خشبية. / قمامة, نفايات الطعام (طعام يتم التخلص منه (كما هو الحال من المطبخ))",
 "小間物": "متفرقات (أشياء متنوعة عديدة جداً أو صغيرة جداً بحيث لا يمكن تحديدها)",
 "小間物屋": "متجر ملابس رجالية (متجر تباع فيه ملابس الرجال) / خردوات, مستلزمات ملابس رجالية (السلع الجافة (كالملابس الرجالية أو أدوات الخياطة) التي يبيعها الخردواتي)",
 "小間物屋を開く": "تَقَيَّأَ, قَاءَ / تَقَيُّؤ",
 "小間結び": "عقدة اليد, عقدة مربعة (عقدة مربعة تستخدم في حبل تقليص الشراع)",
 "小関": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小阪": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小降り": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة\nمثال: 我々は雨が小降りになったとき出発した。 — سوف ننطلق عندما يخفّ هطول المطر.",
 "小陪審": "هيئة محلفين صغرى (هيئة محلفين من 12 شخصاً لتحديد الوقائع والبت في القضية في الإجراءات المدنية أو الجنائية)",
 "小陰": "ركن, زاوية (زاوية داخلية تتشكل من التقاء جدارين) / ركن منعزل, زاوية (مكان محمي ومنعزل)\nمثال: كان البيانو في إحدى زوايا الغرفة",
 "小陰唇": "الشفران الصغيران (الطيتان الداخليتان للفرج)",
 "小隊": "فَصِيلَة عَسْكَرِيَّة, فَصِيلَة (ولد الناقة أو البقرة بعد أن يفصل عن أمه، الجمع فِصال وفصلان؛ فصيلة الرجل: المقرّبون إليه من عشيرته)\nمثال: يريد سامي أن يبيع كلبه من فصيلة الشيبا إينو.",
 "小難しい": "مُتْعِب, مُزْعِج (يُسَبِّب صُعُوبَةً أَوْ إِزْعَاجًا)",
 "小雨": "رَذَّ, بَغَشَ (رذ - يرذ ، رذاذا؛ رذت السماء : أمطرت الرذاذ) / تبول / رَذَاذ, بَغْشَة\nمثال: 昨日は小雨だった。 — أمطرت مطراً خفيفاً البارحة.",
 "小面": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / جَانِب\nمثال: هناك ثقوب على السطح.",
 "小面憎い": "قَلِيل الأَدَب, وَقِح (جريء بشكل مسيء وبذيء)",
 "小韮": "ثوم معمر صيني, كراث صيني (نبات من شرق آسيا؛ أكبر من الثوم المعمر)",
 "小頭症": "صغر الرأس (رأس صغير بشكل غير طبيعي ودماغ غير مكتمل النمو)",
 "小頭鼠海豚": "خنزير البحر الخليجي, فاكيتا (خنزير بحر قصير يعيش في خليج كاليفورنيا؛ نوع مهدد بالانقراض)",
 "小首": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "小馬": "فَرَس قَزَم (أقوام تسكن شرق العِرَاق، يقال أنهم أقوام آرِيَّة)\nمثال: الفرس هي أنثى الحصان / مُهْر, فِلْو",
 "小馬座": "مهر (ذكر حصان صغير يقل عمره عن أربع سنوات) / مسدس كولت (نوع من المسدسات الدوارة)",
 "小馬鹿": "مُغَفَّل, أَحْمَق",
 "小馬鹿にする": "تَرَفَّعَ",
 "小骨": "عظم صغير, عظيم (عظم صغير؛ خاصة في الأذن الوسطى)",
 "小高": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小高い丘": "أكمة, رابية (تل طبيعي صغير)",
 "小鬼": "بيكسي, عفريت ((فلكلور) جنيات تميل للمشاغبة) / شقي, عفريت (شخص مؤذٍ بمرح)",
 "小魚": "قَلَى",
 "小鯨": "حوت رمادي (حوت متوسط الحجم رمادي مسود يعيش في شمال المحيط الهادئ)",
 "小鰈": "تربيت, نقر (لمسة خفيفة أو ضربة خفيفة) / رشة, لطخة (كمية صغيرة من شيء رطب أو سائل) / حركة الداب, داب (حركة رقص يقوم فيها الراقص بإسقاط الرأس مع رفع الذراع والمرفق في إيماءة تشبه العطاس)\nمثال: لطخة من الطلاء",
 "小鰯鯨": "حوت المنك, حوت المنك الشمالي (حوت زعنفي صغير يعيش في المياه الساحلية للمحيط الأطلسي والهادئ)",
 "小鳥": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小鳥遊": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小鴨": "حذف أخضر الجناح (بط صغير شائع في أوراسيا وأمريكا الشمالية)",
 "小鷹": "صَقَارَة",
 "小鷹狩": "صَقَارَة",
 "小鷹狩り": "صَقَارَة",
 "小鷺": "بلشون أبيض صغير (بلشون من العالم القديم)",
 "小鹿": "شَادِن, رِيم / تَزَلَّفَ, تَمَلَّقَ",
 "小麦": "قَمْح, حِنْطَة",
 "小麦グルテン": "غلوتين القمح (غلوتين محضر من القمح)",
 "小麦畑": "حقل قمح (حقل مزروع بالقمح)",
 "小麦粉": "دقيق القمح, طحين القمح (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "小麦胚芽": "جنين القمح (جنين حبة القمح؛ يُزال قبل الطحن ويؤكل كمصدر للفيتامينات)",
 "小麦胚芽油": "جنين القمح (جنين حبة القمح؛ يُزال قبل الطحن ويؤكل كمصدر للفيتامينات)",
 "小麦色": "بني فاتح (بني فاتح ولكنه غير مشبع)",
