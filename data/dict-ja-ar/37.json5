 "小帯": "منطقة صغيرة, نطيقة (منطقة صغيرة تشبه الحزام)",
 "小幅": "صَغِير, صغير",
 "小幡": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小平": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小座倉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小康": "ركود, هدوء مؤقت (فترة من الطقس الهادئ) / فترة هدوء, هوداة (توقف تكون فيه الأمور هادئة أو الأنشطة متناقصة)\nمثال: كان هناك هدوء مؤقت في العاصفة / عَفْو, صَفْح",
 "小康状態": "ركود, هدوء مؤقت (فترة من الطقس الهادئ) / فترة هدوء, هوداة (توقف تكون فيه الأمور هادئة أو الأنشطة متناقصة)\nمثال: كان هناك هدوء مؤقت في العاصفة",
 "小弟": "أخ أصغر (أخ أصغر سناً)\nمثال: احتفل أخي الصغير للتو بعيد ميلاده الخمسين / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "小形": "صَغِير المِقْيَاس (مبنيّ أو مرسوم على نطاق صغير) / صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة) / صَغِير, صغير",
 "小径": "طَرِيق, صِرَاط (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / صِرَاط, مَسَار / مَحَجَّة\nمثال: أسأل عن الطريق.",
 "小循環": "دَوْرَة دَمَوِيَّة صُغْرَى (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "小心": "تهيب, جبن (الخوف عند الخوض في أماكن أو أنشطة جديدة ومجهولة) / جبن, خجل (الخوف من المجهول أو غير المألوف أو الخوف من اتخاذ القرارات) / عَقْل, حَنْك (أمسك بأطرافه وربطه، أصلها للشاة والإبل حيث تربط قوائمها كي تبقى باركة فلا تقوم؛ بلغ العَقْل، أصبح عاقلا فاهما راشدا)\nمثال: هي فتاة تسحر العقل.",
 "小心翼々": "خَجُول, مُتَرَدِّد (يَفْتَقِر إِلَى القَنَاعَة أَوِ الجُرْأَة أَوِ الشَّجَاعَة)",
 "小心翼翼": "خَجُول, مُتَرَدِّد (يَفْتَقِر إِلَى القَنَاعَة أَوِ الجُرْأَة أَوِ الشَّجَاعَة)",
 "小心者": "جَبَان (شديد الخوف ممتنع عن الإقدام؛ ضد الشجاع)\nمثال: إيدير مجرد جبان.",
 "小恥ずかしい": "قَلِيلًا",
 "小悪党": "ثَانَوِيّ, صَغِير (ذو أهمّيّة ضئيلة)",
 "小悪魔": "غَاوِيَة / بيكسي, عفريت ((فلكلور) جنيات تميل للمشاغبة) / شقي, عفريت (شخص مؤذٍ بمرح)",
 "小悪魔的": "مُتَدَلِّل, مُغَازِل (يتصرّف بدلال ومغازلة)",
 "小惑星": "كُوَيْكِب",
 "小惑星帯": "حِزَام كُوَيْكِبَات (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر)\nمثال: هذا حزام من الجلد.",
 "小憎らしい": "مُغِيظ, مُهَيِّج (يتسبّب في الغضب أو الاستياء أو يميل إلى ذلك) / حَبِيب, حَبِيبَة",
 "小憩": "أنبوب التنفس, سنوركل (ممر هوائي يوفره جهاز قابل للسحب يحتوي على أنابيب سحب وعادم؛ يسمح للغواصة بالبقاء تحت الماء لفترات طويلة) / فترة التقاط الأنفاس, متنفس (استراحة قصيرة)",
 "小我": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "小戦": "فُرْشَاة / فَرَشَ / مَشَّطَ (سرح الشعر باستخدام مشط؛ نظف أو مرر شيئًا باستخدام مشط أو أداة مشابهة)\nمثال: مشط شعرك قبل أن تخرج.",
 "小房": "زهيرة (زهرة صغيرة (خاصة تلك التي تكون جزءًا من زهرة مركبة))",
 "小手": "مشروب مقوي, منشط (مقوي أو منشط (خاصة مشروب كحولي)) / حامي الساعد, واقي الذراع (غطاء واقٍ للمعصم أو الذراع يستخدم في الرماية والمبارزة ورياضات أخرى) / عقاب الممر (شكل من أشكال العقاب يُجبر فيه الشخص على الركض بين صفين من الرجال يواجهون بعضهم البعض ومسلحين بهراوات أو سياط لضرب الضحية) / قفاز طويل (قفاز بكم طويل) / قفاز مدرع (قفاز من الجلد المدرع؛ يحمي اليد) / تحدي, قفاز التحدي (عرض أو قبول تحد)\nمثال: رمى قفاز التحدي / قُفَّاز, كَفّ / سَاعِد (عَاوَنَ، أَعَانَ)\nمثال: ساعد زيري ريمة.",
 "小手先": "رَخِيص",
 "小手川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小手術": "جراحة صغرى (أي إجراء جراحي لا يتضمن التخدير أو المساعدة التنفسية)",
 "小手調べ": "تجربة أداء (اختبار لمدى ملاءمة فنان أو مؤدٍ) / اختبار, تجربة (تجربة شيء ما لمعرفة المزيد عنه)\nمثال: عينة للتجربة المجانية لمدة عشرة أيام",
 "小才": "براعة, ذكاء (خاصية كون الشخص بارعاً) / ذكاء, شطارة (الذكاء الذي يظهر في سرعة البديهة والفطنة) / إبداع, عبقرية (قوة الخيال الإبداعي)\nمثال: حبكة ذات براعة كبيرة",
 "小抹香": "حوت العنبر القزم (حوت عنبر صغير يعيش في المياه الدافئة لكلا ساحلي أمريكا الشمالية)",
 "小括": "خُلَاصَة, مُلَخَّص",
 "小括弧": "حشو",
 "小指": "خِنْصِر\nمثال: 小指がはれました。 — اصبعي الصغير متورم / خنصر القدم (الإصبع الخامس الأصغر والأكثر تطرفاً في القدم)",
 "小振り": "صَغِير نَوْعًا مَا (صغير إلى حدٍّ ما)",
 "小数": "قِطْعَة (القِطْعَةُ: الْجُزْءَ أو الحِصَّة من الشيءِ؛ القِطْعَةُ: فقرة قصيرة عادة من مقالٍ أو كتاب) / كَسْر, كُسُور\nمثال: يصنع قطعة أثاث خشبية.",
 "小数点": "فَاصِل عَشْرِيّ",
 "小数賀": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小文字": "حرف صغير (الأحرف التي كانت تُحفظ سابقاً في النصف السفلي من صندوق حروف الطباعة)",
 "小斎": "امتناع, تعفف (فعل أو ممارسة الامتناع عن الانغماس في شهوة ما) / امتناع, عفة (سمة الامتناع (خاصة عن الكحول))",
 "小斑点": "بقعة, لطخة (جزء صغير مغاير في شيء ما)\nمثال: بقعة صلعاء",
 "小料理屋": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "小旅行": "جَوْلَة, نُزْهَة",
 "小日本": "ياباني (مصطلح مسيء) ((عامية مسيئة) مصطلح مسيء لشخص من أصل ياباني)",
 "小早川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小春日和": "صَيْف هِنْدِيّ (فصل من فصول السنة الأربعة، يلي الرَّبِيع ويأتي بعده الخَرِيف، يتميز بشدة الحَرّ)\nمثال: نأتي هنا كل صيف.",
 "小景": "بعض الشيء, قليلاً (بدرجة صغيرة؛ نوعاً ما)",
 "小暗い": "أَسْمَر البَشَرَة, دَاكِن البَشَرَة (ذو بشرة داكنة بطبيعتها) / شَفَقِيّ, مُتَلَأْلِئ بِنُور الغُرُوب (مُضَاء بِنُور الشَّفَق أَوْ كَأَنَّهُ كَذَلِك)",
 "小暗がり": "خُفُوت, عَتْمَة (صفة كون الشيء خافتاً أو يفتقر إلى التباين) / خفوت, عتمة (خاصية الأضواء أو الأصوات التي تفتقر إلى البريق أو منخفضة الشدة) / خفوت, عتمة (حالة ضعف الإضاءة)",
 "小杉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小村": "هَامْلِت",
 "小松": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小林": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小枝": "غُصَّيْن",
 "小柄": "دَقِيق, زَهِيد (صغير جداً) / صغير (مقاس ملابس للنساء القصيرات أو النحيلات)",
 "小柱": "عمود صغير, عُميد (عمود صغير (أو هيكل يشبه العمود) يمثل جزءاً من نبات أو حيوان)",
 "小柳": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小柴": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小栗": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小梅蕙草": "خربق أبيض, خربق أمريكي (نبات من أمريكا الشمالية له أوراق كبيرة وزهور خضراء مصفرة تنمو في عناقيد؛ ينتج قلويداً ساماً يستخدم طبياً)",
 "小森": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小椋": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小楊子": "عُود تَخْلِيل أَسْنَان, خِلَال (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "小楊枝": "عُود تَخْلِيل أَسْنَان, خِلَال (قطعة من الخشب كالعصا جمعه عيدان؛ ما يُتَبَخَّر به)\nمثال: أشعلت عود ثقاب.",
 "小楢": "بلوط الغار (بلوط كبير شبه دائم الخضرة تقريباً من جنوب شرق الولايات المتحدة؛ يزدهر في التربة الرطبة) / بلوط المستنقعات, بلوط دبوسي (شجرة متساقطة الأوراق هرمية سريعة النمو متوسطة إلى كبيرة من شمال شرق الولايات المتحدة وجنوب شرق كندا لها أوراق ريشية عميقة تتحول إلى الأحمر الساطع في…)",
 "小楯": "حِجَاب, سِتَارَة (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "小槌": "مدقة, مطرقة خشبية (أداة تشبه المطرقة ولكن برأس كبير (عادة خشبي)؛ تستخدم لدق الأوتاد أو رصف أحجار الرصف أو للتكسير أو الضرب أو التسطيح أو التنعيم) / عصا الإيقاع, مطرقة الطبل (عصا طبل خفيفة ذات رأس مستدير تستخدم لضرب الآلات الإيقاعية مثل الأجراس والطبول) / صولجان, مطرقة رياضية (أداة رياضية ذات مقبض طويل ورأس يشبه المطرقة؛ تستخدم في الألعاب الرياضية (البولو أو الكروكيت) لضرب الكرة)",
 "小橋川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小檀": "شجرة المغزل, غدب (نبات قائم على سَاق صلبة؛ مخطط له تفرعات)\nمثال: أنا تحت الشجرة.",
 "小欲": "قَلِيلًا",
 "小歌": "أغنية قصيرة, أهزوجة (أغنية قصيرة بسيطة (أو كلمات قصيدة مخصصة للغناء))",
 "小止み": "ركود, هدوء مؤقت (فترة من الطقس الهادئ) / فترة هدوء, هوداة (توقف تكون فيه الأمور هادئة أو الأنشطة متناقصة)\nمثال: كان هناك هدوء مؤقت في العاصفة",
 "小歩き": "ساعي, فتى المراسلات (صبي يكسب المال عن طريق توصيل الرسائل وقضاء المهمات)",
 "小歯朶": "الْعَالَم الْقَدِيم",
 "小母": "زوجة (زوجتك الخاصة (مصطلح عامي))\nمثال: قابل زوجتي",
 "小母さん": "زوجة (زوجتك الخاصة (مصطلح عامي))\nمثال: قابل زوجتي",
 "小母ちゃん": "خالة, عمة (أخت الأب أو الأم؛ زوجة العم أو الخال)",
 "小比類巻": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
