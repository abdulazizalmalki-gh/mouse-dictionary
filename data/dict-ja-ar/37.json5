 "幼齢": "طُفُولَة",
 "幽々": "عَمِيق, غَوِيط",
 "幽か": "إِغْمَاء / أُغْمِيَ, غُشِيَ / فَقِير / مِسْكِين / فُقَرَاء",
 "幽き": "إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "幽し": "إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "幽世": "آخِرَة",
 "幽体離脱": "تجربة الخروج من الجسد (التجربة الانفصالية لمراقبة الذات من منظور خارجي كما لو أن العقل أو الروح قد غادر الجسد ويقوم بمراقبته)",
 "幽冥": "شبه ظلام (ظلام جزئي)",
 "幽冥境を異にする": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "幽冥界": "هَادِيس",
 "幽冥界を異にする": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "幽凄": "مُقْفِر, مَهْجُور",
 "幽囚": "حَبْس, سَجْن (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "幽境": "عُزْلَة",
 "幽客": "أُورْكِيد, سَحْلَب / رَاهِب (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "幽寂": "صَامِت, هَادِئ",
 "幽寂味": "عُزْلَة",
 "幽居": "صومعة (مسكن الناسك)",
 "幽幽": "عَمِيق, غَوِيط",
 "幽微": "خَافِت, مُعْتَدِل الإِضَاءَة (ضَعِيف الضَّوْء؛ غَيْر سَاطِعٍ أَوْ قَاسٍ) / مُخْفَت, مُعْتِم (جُعل معتماً أو أقل سطوعاً) / بَطِيء الفَهْم, كَلِيل الذِّهْن (بطيء التعلّم والاستيعاب؛ يفتقر إلى الحدّة الذهنيّة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: أضواء القاعة المخفتة جلبت صمتاً من الترقب",
 "幽思": "اجترار",
 "幽怪": "شَبَح, خَيَال",
 "幽明": "شبه ظلام (ظلام جزئي)",
 "幽明境を異にする": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "幽明界を異にする": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "幽明相隔てる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "幽暗": "قتامة, كآبة (شعور بتوجس كئيب) / عتمة, قتامة (حالة من الظلام الجزئي أو الكلي) / تجهم, قتامة (جو من الاكتئاب والحزن)\nمثال: أشعل عود ثقاب ليبدد العتمة",
 "幽界": "هَادِيس",
 "幽谷": "وادٍ ضيق (وادٍ ضيق منعزل (في الجبال))",
 "幽邃": "مُنْتَبِذ, مُنْعَزِل (يُوفِّر الخصوصية أو العزلة) / خَفِيّ, مَسْتُور (مُخبَّأ عن الأنظار العامّة أو الاستخدام العامّ)",
 "幽門": "بَوَّاب",
 "幽門狭窄": "تضيق البواب (تضيق العضلة العاصرة البوابية مما يمنع مرور الطعام من المعدة إلى الاثني عشر)",
 "幽閉": "حبس, حجز (فعل تقييد حرية شخص ما عن طريق حبسه) / تقييد, حصر (فعل إبقاء شيء ما ضمن حدود محددة) / احتجاز, حبس (حالة كونه محتجزاً) / طلق, مخاض (المرحلة الختامية للحمل؛ من بداية الانقباضات حتى ولادة الطفل)\nمثال: حصر العدوى في منطقة بؤرية",
 "幽闇": "قتامة, كآبة (شعور بتوجس كئيب) / عتمة, قتامة (حالة من الظلام الجزئي أو الكلي) / تجهم, قتامة (جو من الاكتئاب والحزن)\nمثال: أشعل عود ثقاب ليبدد العتمة",
 "幽雅": "تَكْرِير",
 "幽霊": "شَبَح, خَيَال\nمثال: その家には幽霊が出るといわれる。 — يُقال أن ذاك المنزل مسكون.",
 "幽霊屋敷": "بَيْت أَشْبَاح (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "幽霊株": "أسهم مخففة, أسهم وهمية (أسهم تمثل ملكية أصول مبالغ في قيمتها؛ أسهم شركة تكون قيمتها الإجمالية أقل من رأس مالها المستثمر)",
 "幽霊蜘蛛": "أوبليون, حاصد (عنكبوتي يشبه العنكبوت بجسم مستدير صغير وأرجل رفيعة طويلة جداً)",
 "幽霊語": "كلمة وهمية (صيغة كلمة دخلت اللغة من خلال استدامة خطأ ما)",
 "幽静": "رَائِق, هَادِئ (صافٍ وجميل تماماً) / سَاكِن, هَادِئ (غير مضطرب؛ يحافظ على ضبط النفس)",
 "幽香": "أَرِيج, عَبِير",
 "幽鬼": "شَبَح, خَيَال",
 "幾": "بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مثال: لديك بعض الكتب. / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / كَم / كَمْ / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا! / إلى حد بعيد, تماماً (إلى أقصى حد؛ بالكامل) / إلى حد ما, تماماً (بدرجة ما (لا تستخدم مع النفي)) / حقاً, يا له من (من نوع ملحوظ أو استثنائي أو مميز بشكل غير عادي (لا تستخدم مع النفي)) / تماماً, حقاً (في الواقع أو بصدق أو إلى حد أقصى)\nمثال: أنت محق تماماً",
 "幾たび": "كَثِيرًا, غَالِبًا",
 "幾つ": "كَم / كَمْ",
 "幾つか": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "幾つでも": "جداً ((للتأكيد على الصفات) جداً)\nمثال: كانت ودودة جداً",
 "幾つも": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / بالكاد, قبل قليل (قبل وقت قصير جداً فقط) / بالكاد, قلّما (تقريباً لا؛ بصعوبة بالغة) / بالكاد, بصعوبة (ببطء وبصعوبة)\nمثال: بالكاد كنا نعرفهم",
 "幾ばく": "كَمْ",
 "幾ばくか": "بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مثال: لديك بعض الكتب.",
 "幾ばくもなく": "حالاً, خلال وقت قصير (في المستقبل القريب)\nمثال: سيكون الطبيب هنا قريباً",
 "幾ばくも無く": "حالاً, خلال وقت قصير (في المستقبل القريب)\nمثال: سيكون الطبيب هنا قريباً",
 "幾ほど": "كَم / كَمْ",
 "幾ら": "كَمْ / بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال",
 "幾らか": "بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مثال: لديك بعض الكتب. / إلى حد ما, باعتدال (إلى حد أو درجة معينة) / إلى حد ما, قليلاً (بدرجة أو مدى صغير)\nمثال: كبير جداً",
 "幾らでも": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير. / تَقْرِيبًا, عَلَى وَشْك / بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "幾らにもならない": "بَخْس (بَخَسَ؛ بَخِسَ)\nمثال: بيع المنزل بثمن بخس.",
 "幾らも": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِيرًا\nمثال: هذا أسهل بكثير.",
 "幾ら何でも": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "幾世": "جِيل, نَسْل / جِيل",
 "幾久": "كَم وَقْتًا, إِلَى مَتَى",
 "幾久しい": "أَبَدِيّ, أَزَلِيّ (مستمرّ إلى الأبد أو إلى أجل غير مُسمًّى) / أزهار مجففة, زهرة الخلود (أي من النباتات المختلفة من أجناس مختلفة من الفصيلة النجمية ذات زهور يمكن تجفيفها دون فقدان الشكل أو اللون)",
 "幾久しく": "إِلَى الْأَبَد (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "幾人": "كَم / كَمْ",
 "幾人か": "قَلِيل (ما كان عدده صغيرا؛ متبوعًا بمِنْ: عدد صغير أو كمية صغيرة من الشيء) / مثال: و بعد قليل أتى.",
 "幾代": "جِيل, نَسْل / جِيل",
 "幾何": "هَنْدَسَة, عِلْم اَلْهَنْدَسَة (الحدُّ والقياس؛ في الرياضيات: هي العلم الذي يبحث في الأشكال وعلاقاتها من حيث الخطوط والأبعاد والسطوح وغيرها)\nمثال: هو ضليع في علم الهندسة .",
 "幾何か": "بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مثال: لديك بعض الكتب.",
 "幾何もなく": "حالاً, خلال وقت قصير (في المستقبل القريب)\nمثال: سيكون الطبيب هنا قريباً",
 "幾何も無く": "حالاً, خلال وقت قصير (في المستقبل القريب)\nمثال: سيكون الطبيب هنا قريباً",
 "幾何学": "هَنْدَسَة, عِلْم اَلْهَنْدَسَة (الحدُّ والقياس؛ في الرياضيات: هي العلم الذي يبحث في الأشكال وعلاقاتها من حيث الخطوط والأبعاد والسطوح وغيرها)\nمثال: هو ضليع في علم الهندسة .",
 "幾何学的": "هَنْدَسِيّ (يتميز بأشكال هندسية بسيطة في التصميم والزخرفة) / هندسي (مكون من أو متعلق بـ أو محدد بواسطة الهندسة)",
 "幾何平均": "وسط هندسي",
 "幾何級数": "مُتَسَلْسِلَة هَنْدَسِيَّة (متتالية هندسية مكتوبة كمجموع)",
 "幾何級数的": "هَنْدَسِيّ (يتميز بأشكال هندسية بسيطة في التصميم والزخرفة) / هندسي (مكون من أو متعلق بـ أو محدد بواسطة الهندسة)",
 "幾分": "إلى حد ما, باعتدال (إلى حد أو درجة معينة) / إلى حد ما, قليلاً (بدرجة أو مدى صغير)\nمثال: كبير جداً / بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مثال: لديك بعض الكتب.",
 "幾分か": "بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مثال: لديك بعض الكتب. / إلى حد ما, باعتدال (إلى حد أو درجة معينة) / إلى حد ما, قليلاً (بدرجة أو مدى صغير)\nمثال: كبير جداً",
 "幾千": "أَلْف, ١٠٠٠ (العدد الذي يساوي عَشْر مِئَات. يُذَكَّر بإعتبار لفظه المذكر وإذا كان عن النُقُود يؤنث بإعتبار أن النقود مؤنثه)\nمثال: ألف شكر على لطفك.",
 "幾千代": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "幾原": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "幾多": "كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "幾夜": "كَم / كَمْ",
 "幾年": "كَم / كَمْ",
 "幾度": "كَثِيرًا, غَالِبًا",
 "幾日": "كَم / كَمْ",
 "幾日も幾日も": "يَوْمًا بَعْدَ يَوْم",
 "幾月": "كَم / كَمْ",
 "幾程": "كَم / كَمْ",
 "幾許": "كَمْ / بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مثال: لديك بعض الكتب. / إلى حد ما, باعتدال (إلى حد أو درجة معينة) / إلى حد ما, قليلاً (بدرجة أو مدى صغير)\nمثال: كبير جداً / كَثِير (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء) / كَثِير, متعدد (ما كان عدده كبيرا؛ متبوعًا بمِنْ: عدد كبير أو كمية كبيرة من الشيء)\nمثال: هذا أسهل بكثير.",
 "幾許か": "بَعْضٌ ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مثال: لديك بعض الكتب.",
 "幾許もない": "وَجِيز, قَصِير / وَجِيز, مُوجَز",
 "幾許もなく": "حالاً, خلال وقت قصير (في المستقبل القريب)\nمثال: سيكون الطبيب هنا قريباً",
 "幾許も無い": "وَجِيز, قَصِير / وَجِيز, مُوجَز",
 "幾許も無く": "حالاً, خلال وقت قصير (في المستقبل القريب)\nمثال: سيكون الطبيب هنا قريباً",
 "幾重にも": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "庁": "مكتب حكومي (مكتب يعمل فيه موظفو الحكومة)",
 "庁舎": "مكتب حكومي (مكتب يعمل فيه موظفو الحكومة)",
 "広": "عَرِيض",
 "広々": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة) / مُمْتَدّ, وَاسِع النِّطَاق (كبير في الامتداد المكاني أو النطاق أو الكمية) / توسعي, واسع النطاق (للزراعة؛ زيادة الإنتاجية باستخدام مناطق واسعة بحد أدنى من النفقات والعمالة)\nمثال: إنتاج القمح في ظل ظروف واسعة النطاق",
 "広々とした": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "広い": "وَاسِع, رَحْب (واسِع: (اسم)؛ واسع: (اسم))\nمثال: أرض الله واسعة.",
 "広い支持": "مُتَنَوِّع, وَاسِع النِّطَاق (مُخْتَلِف اخْتِلَافًا كَبِيرًا) / شَامِل, وَاسِع التَّنَوُّع (يتضمّن الكثير ومتنوّع)",
 "広がり": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "広がる": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "広く": "بعيداً, على نطاق واسع (إلى أو على مدى أو نطاق كبير؛ بعيداً) / بتباعد (بحيث تترك مساحة كبيرة أو مسافة بين الأشياء)\nمثال: تجول بعيداً عبر العديد من الأراضي",
 "広げる": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل. / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "広さ": "مِسَاحَة / مِنْطَقَة, نَاحِيَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة. / عَرْض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "広し": "وَاسِع, رَحْب (واسِع: (اسم)؛ واسع: (اسم))\nمثال: أرض الله واسعة.",
 "広まり": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "広まる": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "広め": "إِعْلَان, بَلَاغ",
 "広める": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل. / كَبَّرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "広井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "広口瓶": "مرطبان / جَرَّة (اسم للمَرَّة الواحدة من الجَرّ؛ إناء من خَزَف أو صُلْصَال له بطن كبير وعروتان وفمّ واسع)\nمثال: من ترك الجرة مفتوحة؟",
 "広告": "إِيذَان, إِعْلَان / إِعْلَان, بَلَاغ",
 "広告ビラ": "طَيَّار (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا) / نَشْرَة, نَشْرَة إعْلَانِيَّة\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "広告主": "معلن (شخص عمله هو الإعلان)",
 "広告代理店": "وكالة إعلانات, وكالة دعاية وإعلان (وكالة تصمم إعلانات لجذب انتباه الجمهور لعملائها)",
 "広告代理業": "وكالة إعلانات, وكالة دعاية وإعلان (وكالة تصمم إعلانات لجذب انتباه الجمهور لعملائها)",
 "広告取り": "معلن (شخص عمله هو الإعلان)",
 "広告塔": "أَفِيش / لَوْحَة / لَافِتَة / يَافِطَة / لَوْحَة إعْلَانِيَّة / لَوْحَة إِعْلَانَات / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "広告板": "أَفِيش / لَوْحَة / لَافِتَة / يَافِطَة / لَوْحَة إعْلَانِيَّة / لَوْحَة إِعْلَانَات",
 "広告欄": "إِعْلَان مُبَوَّب (إعلان قصير في صحيفة أو مجلة (عادة بخط صغير) ويظهر مع إعلانات أخرى من نفس النوع)",
 "広告社": "وكالة إعلانات, وكالة دعاية وإعلان (وكالة تصمم إعلانات لجذب انتباه الجمهور لعملائها)",
 "広域ネットワーク": "شبكة واسعة النطاق, وان (شبكة كمبيوتر تغطي مساحة أوسع مما تغطيه الشبكة المحلية)",
 "広域地図": "صَغِير المِقْيَاس (مبنيّ أو مرسوم على نطاق صغير) / صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة)",
 "広域網": "شبكة واسعة النطاق, وان (شبكة كمبيوتر تغطي مساحة أوسع مما تغطيه الشبكة المحلية)",
 "広報": "عَلَاقَات عَامَّة / إعلان, دعاية (العمل التجاري لجذب انتباه الجمهور إلى السلع والخدمات)",
 "広報官": "عَلَاقَات عَامَّة",
 "広報室": "عَلَاقَات عَامَّة",
 "広報局": "عَلَاقَات عَامَّة",
 "広報広聴": "جمع المعلومات (فعل جمع المعلومات)",
 "広報情報": "عَلَاقَات عَامَّة",
 "広報担当官": "عَلَاقَات عَامَّة",
 "広報活動": "عَلَاقَات عَامَّة",
 "広報誌": "عَلَاقَات عَامَّة",
 "広報課": "عَلَاقَات عَامَّة",
 "広報部": "عَلَاقَات عَامَّة",
 "広場": "أغورا, ساحة عامة (مكان للتجمع للناس في اليونان القديمة) / ساحة, ميدان عام (منطقة مفتوحة عند التقاء شارعين أو أكثر) / ترويق, تصفية (فعل إزالة الجزيئات الصلبة من سائل) / تبرئة (فعل التحرير من الشكوك) / فُرْجَة, فُسْحَة (قطعة أرض بها عدد قليل من الأشجار أو خالية منها تقع وسط منطقة حرجية)",
 "広場恐怖症": "رَهَاب الخَلَاء",
 "広壮": "جَلِيل, فَخْم (يُوصَف بِهِ مَظْهَر الشَّخْص أَوْ سُلُوكه؛ يَلِيق بِشَخْصٍ بَارِز) / فَخْم, كَبِير (الأكثر أهمّيّة وفخامة في الزخرفة) / طَمُوح, وَاسِع النِّطَاق (من السلوك المُثير للإعجاب والطموح في الحجم أو النطاق) / عَظِيم, فَخْم (كبير ومثير للإعجاب في الحجم المادي أو الامتداد)",
 "広大": "شَاسِع, وَاسِع",
 "広大無辺": "بِلَا حُدُود, لَامَحْدُود (يَبْدُو بِلَا حُدُودٍ فِي الكَمِّيَّةِ أَوِ العَدَدِ أَوِ الدَّرَجَةِ أَوِ المَدَى)",
 "広小路": "جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم الذي يجمع الطُّرق أو الطريق الكبير الذي يجمع كل الطريق)\nمثال: كانت ماري جادة.",
 "広山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "広岡": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "広島": "هِيرُوشِيمَا",
 "広島へ行く": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)",
 "広州": "قْوَانْغْتْشُو, غْوَانْغْجُو",
 "広布": "إِعْلَان, بَلَاغ",
 "広帯域": "النِطَاق اَلْعَرِيض, الحُزْمة العَرِيضة",
 "広広": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة) / مُمْتَدّ, وَاسِع النِّطَاق (كبير في الامتداد المكاني أو النطاق أو الكمية) / توسعي, واسع النطاق (للزراعة؛ زيادة الإنتاجية باستخدام مناطق واسعة بحد أدنى من النفقات والعمالة)\nمثال: إنتاج القمح في ظل ظروف واسعة النطاق",
 "広末": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "広東": "كْوَنْغْدُنْغ, غْوَانْغْدُونْغ / قْوَانْغْتْشُو, غْوَانْغْجُو",
 "広東省": "كانتون, مقاطعة (تقسيم إداري صغير في دولة ما (كما في سويسرا))",
 "広東語": "كَانْتُونِيّ, كَنْتُونِيّ / كَانْتُونِيَّة, كَنْتُونِيَّة",
 "広永": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "広汎": "عَرِيض",
 "広漠": "شَاسِع, وَاسِع",
 "広濶": "رُحْب, رَحَب (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: رحب فاضل بليلى.",
 "広瀬": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "広狭": "عَرْض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض)\nمثال: قبل كلاي العرض.",
 "広田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "広範": "عَرِيض",
 "広範囲": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة) / مُمْتَدّ, وَاسِع النِّطَاق (كبير في الامتداد المكاني أو النطاق أو الكمية) / توسعي, واسع النطاق (للزراعة؛ زيادة الإنتاجية باستخدام مناطق واسعة بحد أدنى من النفقات والعمالة)\nمثال: إنتاج القمح في ظل ظروف واسعة النطاق",
 "広縁": "طُنْف",
 "広背筋": "ظَهْرِيَّة عَرِيضَة",
 "広葉樹": "عَرِيض الأَوْرَاق (ذو أوراق عريضة نسبياً بدلاً من الإبرية أو الحرشفية)",
 "広葉樹林": "عَرِيض الأَوْرَاق (ذو أوراق عريضة نسبياً بدلاً من الإبرية أو الحرشفية)",
 "広袤": "مِسَاحَة / مِنْطَقَة, نَاحِيَة (المِنْطَقةُ: المَنْطِقَةُ؛ مِنْطَقَةُ: مُقَاطَعَةٌ)\nمثال: غزة منطقة مكشوفة.",
 "広西": "قْوَانْغْشِي, غْوَانْغْشِي",
 "広角": "عين السمكة, واسع الزاوية (مكون من أو متعلق بعدسة عين السمكة)",
 "広角レンズ": "عدسة واسعة الزاوية (عدسة كاميرا ذات زاوية رؤية أوسع من المعتاد (وعادةً بعد بؤري قصير))",
 "広言": "تباهي, تفاخر (الحديث عن النفس بصيغ التفخيم)",
 "広軌": "سكة عريضة, قياس عريض للسكة (سكة حديدية (أو عرضها) أوسع من القياس القياسي البالغ 56.5 بوصة)",
 "広野": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "広量": "كَرِيم (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: يا لك من رجل كريم!",
 "広長舌": "إِطْنَابِيّ, ثَرْثَار (يَسْتَخْدِمُ أَوْ يَحْتَوِي عَلَى كَلِمَاتٍ أَكْثَرَ مِمَّا يَنْبَغِي)",
 "広間": "قَاعَة, صَالَة / مَهْجَع",
 "広闊": "رُحْب, رَحَب (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: رحب فاضل بليلى.",
 "広頭小蛾": "عثة الملابس, عثة تينيد (عثث صفراء صغيرة تتغذى يرقاتها على الصوف أو الفراء)",
 "広頸筋": "عضلة مبطحة (إحدى عضلتين عريضتين تقعان على جانبي الرقبة ويعصبهما العصب الوجهي؛ تمتد من الفك السفلي إلى الترقوة وتشارك في تحريك الفم والفك)",
 "広鼻猿類": "عريض الأنف (من أو يتعلق بقرود العالم الجديد التي لها فتحات أنف متباعدة أو لأشخاص ذوي أنوف عريضة) / قرد العالم الجديد (قرود شجرية ذات وجوه مشعرة ولها فتحتا أنف متباعدتان وذيول طويلة عادة ما تكون قابضة)",
 "庄": "قصر ريفي, مانور (قصر لورد أو شخص ثري) / عزبة السيد, قصر ريفي (الضيعة المملوكة لسيد إقطاعي (بما في ذلك المنزل الموجود عليها))",
 "庄司": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "庄園": "قصر ريفي, مانور (قصر لورد أو شخص ثري) / عزبة السيد, قصر ريفي (الضيعة المملوكة لسيد إقطاعي (بما في ذلك المنزل الموجود عليها))",
 "庇": "تنده, مظلة قماشية (ظلة مصنوعة من قماش القنب لحماية الناس أو الأشياء من المطر أو الشمس) / حافة أمامية, قناع (حافة تبرز إلى الأمام لتظليل العينين) / قناع الخوذة (قطعة من الدرع الصفيحي (ذات شقوق للعين) مثبتة أو مفصلية بخوذة من العصور الوسطى لحماية الوجه)\nمثال: سحب حافة قبعته لأسفل ومشى بجهد للأمام",
 "庇い立て": "حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "庇う": "حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى.",
 "庇蔭": "حِمَايَة",
 "庇護": "إقبال الزبائن, تجارة (الأعمال التي يقدمها العملاء لمؤسسة تجارية) / رعاية, نظام المحسوبية ((سياسة) منح خدمات أو إعطاء عقود أو إجراء تعيينات في مناصب مقابل الدعم السياسي) / دعم, مؤازرة (فعل تقديم الموافقة والدعم) / ازْدِرَاء, تَعَالٍ (تواصل يشير إلى عدم الاحترام من خلال معاملة المتلقي بفوقية)\nمثال: حتى قبل الظهر كان هناك إقبال كبير",
 "庇護権": "حَقُّ اللُّجُوءِ (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له)\nمثال: الأستاذ على حق.",
 "庇護者": "وَلِي أَمْر, حَافِظ (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ) / حَارِس\nمثال: ولي العهد هو من يرث العرش.",
 "庇陰": "حِمَايَة",
 "庇面": "قُبَّة",
 "床": "قَاع, حَوْض (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / مَشَارَة, حَوْض\nمثال: نمت في قاعة السينما. / سرير المريض, فراش المرض (السرير الذي يرقد عليه المريض) / ركن, مقصورة (تجويف صغير يفتح على غرفة أكبر) / قاع النهر (قناة يشغلها (أو كان يشغلها) نهر) / أَرْضِيَّة, أَرْض (ما يقابل السَقْف من الغرفة؛ قاع الشيء) / طَابِق\nمثال: انهارت الأرضية. / مَرْحَلَة / مُنَصَّة, مَسْرَح",
 "床あしらい": "خِدْمَة",
 "床しい": "جَدِير بِالْإِعْجَاب / حَنِين, نُوسْتَالْجِيّ (حزين لبُعده عن الأماكن المألوفة ويشتاق إليها) / فُضُولِيّ",
 "床ずれ": "قرحة الفراش (قرحة مزمنة في الجلد ناتجة عن الضغط المطول عليه)",
 "床屋": "مَحَلّ لِلْحِلَاقَة (الهدي: الوقت الذي ينحر فيه؛ الدين: أجله والوقت الذي يوفى فيه)\nمثال: أغلق دان المحل.",
 "床山": "مُزَيِّن, كْوَافِير",
 "床店": "كُشْك (هو الكِشْك في بعض اللهجات العربية؛ شبه رِوَاق بارز عن مساواة بقية البيت) / حُجَيْرَة, كَابِينَة",
 "床擦れ": "قرحة الفراش (قرحة مزمنة في الجلد ناتجة عن الضغط المطول عليه)",
 "床材": "أَرْضِيَّة (ما يقابل السَقْف من الغرفة؛ قاع الشيء)\nمثال: انهارت الأرضية.",
 "床板": "لوح أرضية (لوح في الأرضية) / أرضية السيارة (أرضية السيارة) / إزار الحائط, وزرة (إطار يغطي المفصل المكون من الجدار والأرضية)",
 "床榻": "قَاع, حَوْض (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / مَشَارَة, حَوْض\nمثال: نمت في قاعة السينما.",
 "床虫": "بَقّ ((بَقَّ) الرجل بقا: أَكثر القَوْل فِي صَوَاب أَو خطأ؛ (بَقَّ) الْمَرْأَة: كثر وَلَدهَا)",
 "床虱": "بق الفراش (بق المناطق المعتدلة الذي يغزو الأسرة بشكل خاص ويتغذى على دم الإنسان)",
 "床見世": "كُشْك (هو الكِشْك في بعض اللهجات العربية؛ شبه رِوَاق بارز عن مساواة بقية البيت) / حُجَيْرَة, كَابِينَة",
 "床面": "أَرْضِيَّة, أَرْض (ما يقابل السَقْف من الغرفة؛ قاع الشيء) / طَابِق\nمثال: انهارت الأرضية.",
 "床頭": "جانب السرير (المساحة بجانب السرير (خاصة سرير المريض أو المحتضر))\nمثال: وقف الطبيب بجانب سريرها",
 "床飾り": "تحفة فنية, قطعة فنية (عمل فني ذو قيمة فنية ما)\nمثال: يبيع هذا المتجر التحف الفنية فقط",
 "序": "فُرْصَة / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / خَلِيف / وَارِث, وَارِثَة (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى) / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / توطئة, ديباجة (مقال تمهيدي قصير يسبق نص كتاب)",
 "序で": "فُرْصَة / تَرْتِيب, نِظَام (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / أَمْر, حُكْم (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَب (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / جَمَاعَة (العَدَد الكثير من النَاس أو الحَيْوَان أو النَبَات أو غيره. المَجْمُوعَة؛ طَائِفَة من الناس التي يجمعها مكان و بيئة واحدة أو تتشارك اهداف و غايات واحدة) / وِسَام / رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء) / أَمَرَ (ضد نَهَى، كَلَّفَ أحد ما أن يفعل شيئا ما؛ أصبح أَمِيرا على إِمَارَة) / طَلَبَ, حَجَزَ (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: أعاد زيري ترتيب المطبخ كلية. / خَلِيف / وَارِث, وَارِثَة (اسم فاعل من الفعل وَرَثَ؛ الوَارِث: اسم من الأسماء الحسنى)",
 "序でながら": "بِالْمُنَاسَبَةِ, عَلَى فِكْرَةٍ",
 "序の口": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "序列": "رُتْبَة (رُتْبَة، بضم الراء؛ رَتْبَة، بفتح الراء)",
