 "幕を下ろす": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "幕を切って落とす": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "幕を切る": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "幕を引く": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "幕を閉じる": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "幕を降ろす": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "幕下": "مَحَلَّة, مُخَيَّم (ما دون الحَيّ وفوق المَنْزِل. قيل قرابة مئة بيت ومجلس ومسجد؛ تقسيم إداري للمناطق السكنية في المدن. أصغر من الحيّ وأكبر من الزُقَاق) / تابعة, فرعية ((عن الجملة النحوية) غير قادرة على الوقوف وحدها نحوياً كجملة تامة) / تابع, مرؤوس (أدنى في الرتبة أو الأهمية) / تابع, خاضع (خاضع أو مستسلم للسلطة أو لسيطرة شخص آخر) / اسم مندرج, لفظ أخص (كلمة أكثر تحديداً وخصوصية من كلمة أخرى)\nمثال: الجملة التابعة (أو الفرعية) تعمل كاسم أو صفة أو ظرف داخل الجملة / شُوغُون",
 "幕僚": "طَاقَم, طَاقِم",
 "幕僚長": "رئيس أركان الجيش",
 "幕切れ": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "幕営": "مُخَيِّم",
 "幕屋": "خَيْمَة (هو البَيْت الذي يقام من أعواد الشَجَر يُلقى عليه نَبَات يستطل به في الحَرّ ويكون مُؤَقَّتا؛ البيت الذي يتخذ من صوف أو قطن أو غيره من النسيج يقوم على عِمَاد أو أكثر. يطلق على الخِبَاء أيضا)\nمثال: سرقت خيمة كارل. / كنيس, معبد يهودي ((اليهودية) مكان العبادة لجماعة يهودية) / المسكن, خيمة الاجتماع ((اليهودية) مزار محمول حمل فيه اليهود تابوت العهد أثناء خروجهم)",
 "幕府": "استبدادية, دكتاتورية (شكل من أشكال الحكم يكون فيه الحاكم دكتاتوراً مطلقاً (غير مقيد بدستور أو قوانين أو معارضة وما إلى ذلك))",
 "幕政": "استبدادية, دكتاتورية (شكل من أشكال الحكم يكون فيه الحاكم دكتاتوراً مطلقاً (غير مقيد بدستور أو قوانين أو معارضة وما إلى ذلك))",
 "幕田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "幕舎": "مُخَيِّم",
 "幕藩体制": "إقطاعية, نظام إقطاعي (النظام الاجتماعي الذي تطور في أوروبا في القرن الثامن عشر؛ حيث كان الأتباع محميين من قبل اللوردات الذين كان عليهم خدمتهم في الحرب)",
 "幕開": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "幕開き": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "幕開け": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "幕間": "فاصِل",
 "幕電": "برق صفائحي (برق يظهر كصحيفة عريضة؛ بسبب انعكاسات البرق البعيد وانتشاره بواسطة السحب)",
 "幡": "عَلَم, رَايَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "幡司": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "幡宮": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "幡幢": "ذُو مِقْبَض طَوِيل (لَهُ مِقْبَض أَوْ يَد طَويلَة) / رَايَة, عَلَم / لَافِتَة / مُلْصَق / إِعْلَان / مُمْتَاز",
 "幢": "ذُو مِقْبَض طَوِيل (لَهُ مِقْبَض أَوْ يَد طَويلَة) / رَايَة, عَلَم / لَافِتَة / مُلْصَق / إِعْلَان / مُمْتَاز",
 "幣": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "幣制": "نظام نقدي, وسيط تبادل (أي شيء مقبول عموماً كمعيار للقيمة ومقياس للثروة في بلد أو منطقة معينة)",
 "幣帛": "هَدِيَّة, هدية / قَرِيحَة / أَهْدَى",
 "幣貢": "قُرْبَان",
 "干": "جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما.",
 "干からびる": "صَعَقَ",
 "干し": "جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما.",
 "干しぶどう": "زَبِيب, زَبِيبَة (ما قدد أو جفف من العِنَب وقد يقال لغيره من النبات المقدد إذا كان صغير الحجم؛ السم في فَمّ الحَيَّة)\nمثال: الزبيب هو عنب مجفف.",
 "干し李": "أَجَاص / عَوِينَة / عَوِينَة مُجَفَّفَة / خَوْخ مُجَفَّف / شَذَبَ, قَضَبَ",
 "干し果物": "فَوَاكِه مُجَفَّفَة",
 "干し肉": "قَدِيد",
 "干し草": "تِبْن, جَفِيف (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "干し草の山": "بيدر, كومة قش (كدس من القش)",
 "干し葡萄": "زَبِيب, زَبِيبَة (ما قدد أو جفف من العِنَب وقد يقال لغيره من النبات المقدد إذا كان صغير الحجم؛ السم في فَمّ الحَيَّة)\nمثال: الزبيب هو عنب مجفف.",
 "干し魚": "سمك مجفف (سمك محفوظ بشقه وتجفيفه بالهواء دون ملح)",
 "干す": "هَوَاء (خَلِيط من الغَازَات يغلف الكرة الأرضية؛ فَارِغ) / جَوّ / نَغَم\nمثال: أخرجي الهواء من فمك. / بَالُوعَة",
 "干ばつ": "جَفَاف",
 "干ぼし": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "干る": "جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما. / انحسار, جزر (التدفق الخارجي للمد) / انحسار, تضاؤل (انخفاض تدريجي (في الحجم أو القوة أو السلطة أو العدد))",
 "干上がる": "انحسار, جزر (التدفق الخارجي للمد) / انحسار, تضاؤل (انخفاض تدريجي (في الحجم أو القوة أو السلطة أو العدد))",
 "干乾し": "جُوع شَدِيد (جَوَّعَ: أجاع (جوعه) أجاعه، أي مَنعه الطَّعَام وَالشرَاب واضطره إِلَى الْجُوع)\nمثال: بدأت أحس بالجوع.",
 "干割れ": "تتجفاف, تجفيف (عملية استخلاص الرطوبة)",
 "干場": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "干天": "جَفَاف",
 "干戈": "سِلَاح, أَسْلِحَة / صِرَاع",
 "干渉": "تَدَاخُل",
 "干渉性": "اتِّسَاق, تَرَابُط (العلاقة المنطقية والمنظمة والمتسقة بين الأجزاء) / تلاحم, تماسك (حالة التماسك أو الالتصاق معاً)",
 "干渉的": "مُلْتَحِم, مُتَرَابِط / فُضُولِيّ, مُتَدَخِّل (يتدخل في شؤون الآخرين بطريقة مزعجة)",
 "干渉縞": "هدب, هدب التداخل (أحد النطاقات المضيئة أو المظلمة الناتجة عن تداخل وحيود الضوء)",
 "干渉計": "مقياس التداخل (أي أداة قياس تستخدم أنماط التداخل لإجراء قياسات دقيقة للموجات)",
 "干潟": "أرض المد (أرض بالقرب من البحر يغمرها المد)",
 "干潮": "انحسار الماء, جزر (أدنى (أبعد) انحسار للمد)",
 "干潮線": "علامة الجزر, علامة المد المنخفض (خط يحدد أدنى مستوى تم الوصول إليه) / أسوأ حالات, حضيض (حالة قصوى من الشدائد؛ أدنى نقطة لأي شيء)",
 "干物女": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "干犯": "مِسَاس",
 "干肉": "قَدِيد",
 "干草": "تِبْن, جَفِيف (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "干魃": "جَفَاف",
 "干魚": "سمك مجفف (سمك محفوظ بشقه وتجفيفه بالهواء دون ملح)",
 "平": "شَائِع / فِي السَّنَةِ الأُولَى, مُسْتَجِدّ (يُوصَفُ بِهِ الشَّخْصُ فِي سَنَتِهِ الأُولَى مِنْ تَجْرِبَةٍ (خَاصَّةً فِي المَدْرَسَةِ أَوِ الجَامِعَةِ)) / طالب سنة أولى (طالب جامعي في السنة الأولى) / قادم جديد, مستجد (أي مشارك جديد في نشاط ما) / بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "平々": "مُسْتَوًى / مَرْحَلَة",
 "平々凡々": "مُتَوَسِّط",
 "平か": "مُسْتَوًى / مَرْحَلَة",
 "平し": "مُتَوَسِّط, مُعَدَّل",
 "平たい": "مُسَطَّح / بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "平ちゃら": "غير مبالٍ, غير مكترث (يفتقر إلى الاهتمام أو الرعاية أو الشعور) / غَيْرُ مُنْشَغِل, غَيْرُ مُهْتَمّ (لَيْسَ مُنْشَغِلًا أَوْ مُنْخَرِطًا فِي أَمْرٍ مَا) / غَيْرُ مُبَالٍ, غَيْرُ مُكْتَرِث (مرتاح النفس؛ غير قلق) / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "平ったい": "مُسَطَّح / بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "平に": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "平べったい": "مُسَطَّح",
 "平ら": "مُسَطَّح / هَادِئ / طَمْأَنَ / مسترخٍ, هادئ (بدون إجهاد أو قلق)\nمثال: أعطى انطباعاً بأنه مسترخٍ تماماً / هَضْبَة / بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "平らか": "مُسْتَوًى / مَرْحَلَة",
 "平らげる": "اِسْتَعْبَدَ, قَهَرَ",
 "平井": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "平仄": "مِقْيَاس / وَزْن / بَحْر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "平仮名": "هِيرَاغَانَا (الأحرف الرئيسية للغة اليابانية، تستخدم لتمثيل الكلمات اليابانية الأصلية، بما في ذلك الجسيمات، وعندما يستخدم الكانجي، يمثل نهايات الفعل والصفة؛ حرف من هذه الأحرف)",
 "平伏": "سَجَدَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)",
 "平価": "بَار, مُعَدَّل ((في الغولف) العدد القياسي للضربات المحدد لكل حفرة أو للملعب بأكمله) / تكافؤ, مساواة (حالة من التساوي أو التكافؤ الجوهري؛ التوازن المتساوي)\nمثال: حفرة بمعدل 5 ضربات",
 "平価切り上げ": "إعادة تقييم, مراجعة (تقييم جديد أو تقدير جديد)",
 "平価切り下げ": "بخس, تقليل القيمة (تخفيض قيمة شيء ما أو أهميته) / تخفيض القيمة (تخفيض رسمي لعملة وطنية؛ انخفاض في قيمة عملة بلد ما بالنسبة لعملات الدول الأجنبية)",
 "平価切下げ": "بخس, تقليل القيمة (تخفيض قيمة شيء ما أو أهميته) / تخفيض القيمة (تخفيض رسمي لعملة وطنية؛ انخفاض في قيمة عملة بلد ما بالنسبة لعملات الدول الأجنبية)",
 "平俗": "رَتِيب, عَادِيّ (غير مُلهِم ولا يُشكِّل تحدياً؛ باهت وخالٍ من الإثارة) / عَادِيّ تَمَامًا, مُبْتَذَل (عادي تماماً ولا يستحق الملاحظة) / مُبْتَذَل, مُسْتَهْلَك (مُكرَّر أكثر من اللازم؛ مألوف بشكل مفرط بسبب كثرة الاستخدام) / عبارة مبتذلة, قول مأثور مبتذل (ملاحظة مبتذلة أو واضحة بشكل مفرط)",
 "平信徒": "شخص عادي, علماني (رجل ليس رجل دين أو شخصاً محترفاً)",
 "平凡": "عَادِيّ, مَأْلُوف",
 "平分": "تنصيف (التقسيم إلى جزأين متساويين)",
 "平削り": "مِسْحَاج, مِنْجَرَة / سَحَجَ (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / طَائِرَة, طَيَّارَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر) / دُلْب, صِنَار\nمثال: لقد وصلت الطائرة.",
 "平削り盤": "فارة, مسحاج (أداة كهربائية لتنعيم أو تشكيل الخشب)",
 "平原": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "平叙文": "جملة تقريرية, جملة خبرية (جملة (في صيغة الإخبار) تقوم بإعلان أو تصريح)",
 "平台型貨車": "مَصْطَبَة",
 "平和": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام.",
 "平和主義": "سَلَامِيَّة, سِلْمِيَّة",
 "平和主義者": "مُسَالِم / مُسَالِمَة",
 "平和共存": "تَعَايُش سِلْمِيّ",
 "平和国家": "مُحِبٌّ لِلسَّلَام (مَيَّالٌ لِلسَّلَامِ أَوْ رَاغِبٌ فِيه)",
 "平和思想": "سَلَامِيَّة, سِلْمِيَّة",
 "平和条約": "مُعَاهَدَة سَلَام (مؤنث مُعَاهَد، وهو اسم مفعول من عَاهَدَ؛ اتِّفَاق مُقَرّر بين دَوْلَتَيْن أو أكثر على أمور معينة)\nمثال: أمضيت المعاهدة يوم 18 نوفمبر 1903.",
 "平和的": "سِلْمِيّ / مُسَالِم",
 "平和維持": "حِفْظ سَلَام (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ)\nمثال: حفظ رقم هاتفها.",
 "平和裏": "سلمي, مسالم (غير مضطرب بالنزاع أو الاضطراب أو الحرب) / مَيَّالٌ لِلسَّلَام, مُسَالِم (يَمِيلُ إِلَى السَّلَامِ أَوْ ذُو طَبِيعَةٍ سِلْمِيَّة) / مُحِبٌّ لِلسَّلَام (مَيَّالٌ لِلسَّلَامِ أَوْ رَاغِبٌ فِيه)\nمثال: أمة مسالمة",
 "平和論者": "مُسَالِم / مُسَالِمَة",
 "平和部隊": "فيلق السلام (منظمة مدنية ترعاها حكومة الولايات المتحدة تساعد الناس في البلدان النامية)",
 "平土間": "حُفْرَة",
 "平地": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "平均": "مُتَوَسِّط, مُعَدَّل / رَصِيد",
 "平均への回帰": "انحدار, انحدار إحصائي",
 "平均余命": "مَأْمُول اَلْحَيَاة, مُتَوَسِّط العُمْر المُتَوَقَّع",
 "平均修復時間": "التوقيت الشمسي المتوسط, الوقت المتوسط ((علم الفلك) وقت يعتمد على حركة الشمس المتوسطة (شمس وهمية تتحرك بانتظام على طول خط الاستواء السماوي))",
 "平均修理時間": "التوقيت الشمسي المتوسط, الوقت المتوسط ((علم الفلك) وقت يعتمد على حركة الشمس المتوسطة (شمس وهمية تتحرك بانتظام على طول خط الاستواء السماوي))",
 "平均値": "متوسط, وسط",
 "平均値の定理": "متوسط, وسط",
 "平均偏差": "انحراف متوسط, انحراف متوسط عن المتوسط (المتوسط الحسابي للقيم المطلقة للانحرافات عن متوسط التوزيع)",
 "平均化": "مُتَوَسِّط, مُعَدَّل",
 "平均台": "عارضة, عارضة التوازن (جهاز جمباز تستخدمه لاعبات الجمباز)\nمثال: ارتدت الكرة عن العارضة",
 "平均太陽": "الشمس المتوسطة (شمس نظرية تتحرك على طول خط الاستواء السماوي بسرعة ثابتة وتكمل دورتها السنوية في نفس الوقت الذي تستغرقه الشمس الحقيقية بسرعات متغيرة)",
 "平均太陽日": "أربع وعشرون ساعة, يوم (الوقت الذي تستغرقه الأرض للقيام بدورة كاملة حول محورها)\nمثال: غادروا بعد يومين",
 "平均太陽時": "التوقيت الشمسي المتوسط, الوقت المتوسط ((علم الفلك) وقت يعتمد على حركة الشمس المتوسطة (شمس وهمية تتحرك بانتظام على طول خط الاستواء السماوي))",
 "平均寿命": "مَأْمُول اَلْحَيَاة, مُتَوَسِّط العُمْر المُتَوَقَّع",
 "平均律": "دوزنة متساوية (تقسيم السلم الموسيقي بناءً على أوكتاف مقسم إلى اثني عشر نصف نغمة متساوية تماماً)",
 "平均情報量": "إنتروبيا, اعتلاج (كمية ديناميكية حرارية تمثل مقدار الطاقة في النظام التي لم تعد متاحة للقيام بعمل ميكانيكي) / إنتروبيا, اعتلاج ((نظرية الاتصال) مقياس رقمي لعدم اليقين في نتيجة ما)\nمثال: تزداد الإنتروبيا مع تحلل المادة والطاقة في الكون إلى حالة نهائية من التماثل الخامل",
 "平均故障時間": "التوقيت الشمسي المتوسط, الوقت المتوسط ((علم الفلك) وقت يعتمد على حركة الشمس المتوسطة (شمس وهمية تتحرك بانتظام على طول خط الاستواء السماوي))",
 "平均故障間隔": "التوقيت الشمسي المتوسط, الوقت المتوسط ((علم الفلك) وقت يعتمد على حركة الشمس المتوسطة (شمس وهمية تتحرك بانتظام على طول خط الاستواء السماوي))",
 "平均棍": "دبوس التوازن (أي من الأجنحة الخلفية الضامرة للحشرات ثنائية الأجنحة؛ تستخدم للحفاظ على التوازن أثناء الطيران) / بلوزة برباط عنق, هالتر توب (توب نسائي يربط خلف الظهر والرقبة ويترك الظهر والذراعين مكشوفين) / رسن, مقود (غطاء رأس من الحبل أو القماش للحصان، مع حبل للقيادة) / حبل المشنقة (حبل يستخدمه الجلاد لإعدام الأشخاص المحكوم عليهم بالموت شنقاً)",
 "平均的": "مُتَوَسِّط, مُعَدَّل",
 "平均費用": "متوسط التكلفة (إجمالي تكلفة جميع الوحدات المشتراة (أو المنتجة) مقسوماً على عدد الوحدات)",
 "平坦": "مُسَطَّح, مُنبَسِط / أَمْلَس, سَوِيّ / زَوْجِيّ / حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس. / هَادِئ / طَمْأَنَ",
 "平塚": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "平壌": "بْيُونْيَانْغ",
 "平壌時間": "توقيت محلي, توقيت مدني (الوقت الرسمي في منطقة محلية (معدل حسب الموقع حول الأرض)؛ يحدد بالقانون أو العرف)",
 "平安": "سَلَام, هُدُوء (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: هن يردن السلام.",
 "平定": "كبت, كبح ((علم النفس) الاستبعاد الواعي للأفكار أو الرغبات غير المقبولة) / إخماد, قمع (منع بالقوة؛ القضاء على الشيء بالسلطة أو القوة) / حظر, منع (فعل حجب أو سحب كتاب أو كتابة من النشر أو التداول) / قمع, كبت (فشل نمو جزء أو عضو ما)\nمثال: قمع الهرطقة",
 "平家": "بنغالو, كوخ (منزل صغير من طابق واحد)",
 "平家星": "مَنْكِب اَلْجَوْزَاء",
 "平尾": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "平屋": "بنغالو, كوخ (منزل صغير من طابق واحد)",
 "平山": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
