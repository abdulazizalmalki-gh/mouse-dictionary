 "座": "مَقْعَد, مَقْعَدَة (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد. / مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث. / جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع / وَقَفَ, وقف (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: وقف وراء الباب.",
 "座す": "جَلَسَ, جلس (قَعَدَ)\nمثال: جلس سامي مجددا.",
 "座する": "جَلَسَ, جلس (قَعَدَ)\nمثال: جلس سامي مجددا.",
 "座り": "جلوس (فعل اتخاذ أو الحفاظ على وضعية الجلوس) / جلوس للرسم ((تصوير) فعل اتخاذ وضعية معينة (كما في صورة فوتوغرافية أو لوحة)) / جالس ((للأشخاص) الجذع منتصب والأرجل مثنية مع ارتكاز الجسم على الأرداف) / جَالِس, سَهْل الاسْتِهْدَاف (لا يتحرك ولذلك سهل المهاجمة)\nمثال: قرأ الرواية البوليسية في جلسة واحدة / اِسْتِقْرَار",
 "座り込み": "اِعْتِصَام",
 "座り込む": "جَلَسَ, قَعَدَ (قَعَدَ)\nمثال: جلس سامي مجددا.",
 "座る": "جَلَسَ, جلس (قَعَدَ)\nمثال: جلس سامي مجددا. / اِفْتَرَضَ",
 "座を占める": "جَلَسَ, جلس (قَعَدَ)\nمثال: جلس سامي مجددا.",
 "座下": "بالقرب, في مكان قريب (ليس بعيداً بالمصطلحات النسبية) / قَرِيب, مُجَاوِر (على مقربة؛ في متناول اليد)\nمثال: هي تعمل في مكان قريب / عَزِيز, عَزِيْزَة (القوي المنيع، ضد الذليل؛ القليل النادر العالي القيمة) / غَالِي, غَالِيَّة\nمثال: هذه رسالة من شخص عزيز.",
 "座中": "جمع, حصد (فعل جمع شيء ما) / اِحْتِشَاد, تَجَمُّع (الفعل الاجتماعي المتمثل في التجمع) / زم, كشكشة (خياطة تتكون من طيات صغيرة أو تجاعيد مصنوعة بسحب خيط بإحكام في خط خياطة) / تجمع, تجمهر (مجموعة من الأشخاص مجتمعين معاً في مكان واحد)\nمثال: طالبوا بالحق في التجمع",
 "座位": "مَقْعَد, مَقْعَدَة (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)",
 "座位分娩": "وضع, ولادة (عملية الولادة)",
 "座作進退": "تصرف, سلوك ((السمات السلوكية) الطريقة التي يتصرف بها الشخص تجاه الآخرين)",
 "座元": "مُنْتِج",
 "座剤": "تَحْمِيلَة, لَبُوس",
 "座屈": "إِبْزِيم (حديدة الحزام)\nمثال: ذهبت لشراء إبزيم.",
 "座州": "خيط, سلسلة (قلادة مصنوعة من ربط أشياء ببعضها) / جديلة, خصلة (خيط يتكون من مجموعة معقدة من الألياف أو الشعيرات المجدولة معاً لتشكيل خيط أو حبل أو كابل) / خيط (نمط يشكل وحدة داخل كل هيكلي أكبر) / ساحل, شاطئ (مصطلح شعري للشاطئ (كمنطقة تغطيها وتكشفها المد والجزر بشكل دوري))\nمثال: خيط من الخرز",
 "座席": "مَقْعَد, مَقْعَدَة (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "座席数": "سعة المقاعد (عدد الأشخاص الذين يمكن جلوسهم في مركبة أو قاعة أو ملعب وما إلى ذلك)",
 "座所": "عَرْش, كُرْسِيّ (هو كُرْسِيّ المَلِك تحديدا؛ العَرْش: هو عَرش الرَحْمَان فوق سِدْرَة المنتهى)\nمثال: ولي العهد هو من يرث العرش.",
 "座敷": "حفل عشاء, عزومة عشاء (حفلة يجتمع فيها الناس لتناول العشاء معاً)\nمثال: يجب ألا يتأخر الضيوف عن حفل العشاء أبداً",
 "座板": "مَقْعَد, مَقْعَدَة (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد. / لوح أرضية (لوح في الأرضية) / أرضية السيارة (أرضية السيارة)",
 "座標": "تَنْسِيق, إِحْدَاثِيّ (ترتيب وتنظيم الأشياء أو العناصر بشكل متناسق ومتناسب؛ العمل على توحيد الجهود بين جهات متعددة لتحقيق هدف مشترك)",
 "座標幾何学": "هندسة إحداثية, هندسة تحليلية (استخدام الجبر لدراسة الخصائص الهندسية)",
 "座標系": "نِظَامُ إِحْدَاثِيَّاتٍ (مَنْهَج، طَرِيقَة؛ تَرْتِيب واتِّسَاق)\nمثال: ليس بنظام كامل.",
 "座標軸": "محور إحداثي (أحد الخطوط المرجعية الثابتة لنظام الإحداثيات)",
 "座洲": "خيط, سلسلة (قلادة مصنوعة من ربط أشياء ببعضها) / جديلة, خصلة (خيط يتكون من مجموعة معقدة من الألياف أو الشعيرات المجدولة معاً لتشكيل خيط أو حبل أو كابل) / خيط (نمط يشكل وحدة داخل كل هيكلي أكبر) / ساحل, شاطئ (مصطلح شعري للشاطئ (كمنطقة تغطيها وتكشفها المد والجزر بشكل دوري))\nمثال: خيط من الخرز",
 "座浴": "مغطس مقعدي (حوض استحمام تُغمر فيه الأرداف والوركين كما لو كنت جالساً على كرسي وتستحم في وضعية الجلوس)",
 "座礁": "تأريض (توصيل المعدات الكهربائية بالأرض) / أساس, تأسيس (التعليم أو التوجيه في أساسيات مجال من مجالات المعرفة)\nمثال: يفتقر إلى التأسيس اللازم للدراسة المتقدمة",
