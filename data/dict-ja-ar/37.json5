 "帝権": "سلطة عليا, سيادة مطلقة (السلطة العليا أو الحكم المطلق) / إمبراطورية (المجال الذي يحكمه إمبراطور أو إمبراطورة؛ المنطقة التي تمارس عليها السيادة الإمبراطورية)",
 "帝王": "مُسْتَقِلّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره) / عَاهِل, مَلِك\nمثال: الجزائر مستقلة الآن.",
 "帝王切開": "وِلَادَة قَيْصَرِيَّة",
 "帝王切開術": "وِلَادَة قَيْصَرِيَّة",
 "師": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة. / زعيم ديني (قائد نظام ديني) / مُتَخَصِّص, مُتَخَصِّصَة",
 "師事": "تدريب مهني, تلمذة مهنية (منصب المتدرب المهني)",
 "師儒": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "師匠": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن.",
 "師団": "تَقْسِيم / قِسْمَة (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / قِسْمَةٌ (في : هو أن أحد العمليات الحسابية الرئيسية، ضد الضَرْب) / فِرْقَة / فُرْقَة\nمثال: الزواج قسمة و نصيب.",
 "師管": "أنبوب غربالي (أنبوب يتكون من خلايا متصلة من طرف لآخر تتدفق من خلالها العناصر الغذائية في النباتات الزهرية والطحالب البنية)",
 "師範": "مُعَلِّم, مُعَلِّمَة (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة. / نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به) / دار المعلمين, مدرسة إعداد المعلمين (مدرسة مدتها سنتان لتدريب معلمي المدارس الابتدائية)",
 "師範学校": "دار المعلمين, مدرسة إعداد المعلمين (مدرسة مدتها سنتان لتدريب معلمي المدارس الابتدائية)",
 "師表": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "師走": "دِيسِمْبِر, دِيسَمْبِر (الشهر الثاني عشر في السنة الروميّة)\nمثال: أنا في إضراب من 8 إلى 12 ديسمبر.",
 "師部": "لحاء ((علم النبات) نسيج يوصل المواد الغذائية المصنعة (مثل من الأوراق) إلى الأجزاء التي تحتاج إليها؛ يتكون أساسًا من الأنابيب الغربالية)",
 "師門": "حضانة, رعاية (الاهتمام والإدارة بما ينطوي على مسؤولية السلامة) / دروس خصوصية, وصاية تعليمية (تدريس التلاميذ بشكل فردي (عادة بواسطة معلم خاص))\nمثال: هو في رعاية حارس شخصي",
 "席": "مَقْعَد, مَقْعَدَة (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد. / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَوْضِع\nمثال: هنا موقع الحادث. / مَوْقِع, مَكَان (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / مَنْصِب / مَكَانَة, رُتْبَة / رَأْي, مَوْقِف / جِلْسَة, وَقْفَة\nمثال: هنا موقع الحادث.",
 "席亭": "قاعة موسيقى, مسرح فودفيل (مسرح يتم فيه تقديم عروض الفودفيل)",
 "席代": "رسم الدخول, رسم خدمة المطعم (رسم ثابت يفرضه مطعم أو ملهى ليلي بالإضافة إلى رسوم الطعام والشراب)",
 "席巻": "كنس (فعل التنظيف بالمكنسة) / شَامِل, عَشْوَائِيّ (يَتَجَاهَل الفُرُوقَات وَالتَّمَايُزَات) / شَامِل, وَاسِع النِّطَاق (يشمل مساحة واسعة أو يتحرّك عبرها)",
 "席捲": "كنس (فعل التنظيف بالمكنسة) / شَامِل, عَشْوَائِيّ (يَتَجَاهَل الفُرُوقَات وَالتَّمَايُزَات) / شَامِل, وَاسِع النِّطَاق (يشمل مساحة واسعة أو يتحرّك عبرها)",
 "席数": "سعة المقاعد (عدد الأشخاص الذين يمكن جلوسهم في مركبة أو قاعة أو ملعب وما إلى ذلك)",
 "席料": "رسم الدخول, رسم خدمة المطعم (رسم ثابت يفرضه مطعم أو ملهى ليلي بالإضافة إلى رسوم الطعام والشراب)",
 "席次": "أسبقية, تقدم (فعل التقدم في الوقت أو الترتيب أو الرتبة (كما في المراسم)) / أسبقية, أولوية (السبق في الزمن) / أسبقية, أولوية (مكانة محددة بترتيب الأهمية أو الإلحاح)\nمثال: أسبقيتها كشركة رائدة عالمياً في تصنيع الأدوية / ترتيب, تصنيف (الموقع على مقياس بالنسبة للآخرين في المكانة أو الرتبة أو الإنجاز)",
 "帯": "أوبيا, سحر أوبيا (معتقد ديني من أصل أفريقي يتضمن السحر والشعوذة؛ يمارس في أجزاء من جزر الهند الغربية والأمريكتين الاستوائيتين) / أوبيا ((جزر الهند الغربية) أتباع نظام ديني يتضمن السحر والشعوذة) / فِرْقَة, فرقة / فِرْقَة / حِزَام, طَوْق ((في التشريح) بنية مطوّقة (مثل الحافة حول قاعدة السن))",
 "帯のこ": "منشار شريطي (منشار لا نهائي يتكون من شريط معدني مسنن يُدار حول عجلتين)",
 "帯のこ盤": "منشار شريطي (منشار لا نهائي يتكون من شريط معدني مسنن يُدار حول عجلتين)",
 "帯びる": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا. / مَلَكَ, اِمْتَلَكَ (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد) / تَنَاوَلَ (فعل مطاوعة من نَاوَلَ، ناولته فتناول؛ أخذ الشيء الذي ناولته إياه؛ الطعام والدواء: أكَلَه)\nمثال: زيري ملك لنفسه.",
 "帯グラフ": "رسم بياني بالأعمدة, مخطط شريطي (مخطط بأشرطة تتناسب أطوالها مع الكميات)",
 "帯下": "ثر أبيض, سيلان مهبلي أبيض (إفرازات مخاطية بيضاء من المهبل؛ غالباً ما تكون مؤشراً على وجود عدوى)",
 "帯出": "نَقَلَ / أَزَالَ (أَزَاحَ ونَحَّى وأَبْعَدَ؛ خَلَعَ) / أَخْرَجَ / جَذَبَ (شَدَّ الشيءَ نحوه بقوة؛ لفَتَ الانتباه أو أثارَ الاهتمام)\nمثال: لا أزال عطشانا.",
 "帯分数": "عَدَد مُرَكَّب الْوَحَدَات, كَمِّيَّة مُرَكَّبَة (كمية يُعَبَّر عنها بوحدتين مختلفتين)\nمثال: كمية مركبة مثل 'ساعة وعشر دقائق'",
 "帯剣": "سَيْف, حُسَام (مصدر للفعل سَافَ؛ سِلاح ذو حَدّ واحد طويل يعتبر من الأسْلِحَة البيضاء لأنها مصنوعة من حَدِيد أبيض حاد. كان أهم أنواع الأسلحة قبل اخْتِرَاع الأسلحة النَارِيَّة) / سَيَّافٌ\nمثال: القلم أقوى من السيف.",
 "帯域": "فِرْقَة, فرقة / فِرْقَة / عرض النطاق الترددي (معدل نقل البيانات؛ أقصى قدر من المعلومات (بايت/ثانية) يمكن نقلها عبر قناة)",
 "帯域幅": "عرض النطاق الترددي (معدل نقل البيانات؛ أقصى قدر من المعلومات (بايت/ثانية) يمكن نقلها عبر قناة)",
 "帯気音": "صوت مهموس, هاء (صامت يُنطق مع نَفَس مسموع) / تفخيم, صوت مصحوب بنفخ (صوت كلامي يرافقه نفخة مسموعة من النفس، مثل الصوامت الوقفية الأولية)",
 "帯水層": "طَبَقَة ٱلْمِيَاهِ ٱلْجَوْفِيَّةِ",
 "帯状": "حِزَامِيّ الشَّكْل (على شكل حزام)",
 "帯状回": "تلفيف حزامي (بنية منحنية طويلة على السطح الإنسي لنصفي الكرة المخية؛ الجزء القشري من الجهاز الحوفي)",
 "帯状疱疹": "اَلْهِرْبِس اَلْعَصَبِيّ",
 "帯皮": "حِزَام, زُنَّار (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر) / سَيْر (أسَارَ، أي جعله يَسِير والفرق بين الإثنين أن سَيَّرَ فيها تكرار وأسارَ لا تكرار فيها؛ فلان من بَلَده أو مَوْطِنه: أخْرَجَه وأجْلاه)\nمثال: هذا حزام من الجلد.",
 "帯筋": "طَارَة (في و: هو اسم آخر للمِقْوَد، وخصوصاً مقوَد السَيَّارَة؛ في و: الشخص الماهر في قيادة السيارات)",
 "帯緑": "أَخْضَر (بلون بين الأزرق والأصفر في الطيف اللوني؛ مشابه للون العشب الطازج)",
 "帯鋸": "منشار شريطي (منشار لا نهائي يتكون من شريط معدني مسنن يُدار حول عجلتين)",
 "帯鋸盤": "منشار شريطي (منشار لا نهائي يتكون من شريط معدني مسنن يُدار حول عجلتين)",
 "帯電": "إمداد بالكهرباء, كهربة (فعل توفير الكهرباء) / إثارة, تهييج (نشاط إثارة أو تحميس شخص أو مجموعة بشكل ملحوظ)\nمثال: كهربة ريف تينيسي",
 "帯革": "حِزَام, زُنَّار (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر) / سَيْر (أسَارَ، أي جعله يَسِير والفرق بين الإثنين أن سَيَّرَ فيها تكرار وأسارَ لا تكرار فيها؛ فلان من بَلَده أو مَوْطِنه: أخْرَجَه وأجْلاه)\nمثال: هذا حزام من الجلد.",
 "帯黄色": "أَصْفَر (بلون متوسط بين الأخضر والبرتقالي في الطيف اللوني؛ يشبه لون صفار البيض)",
 "帰す": "صِفَة, خُصُوصِيَّة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت) / نَسَبَ\nمثال: محاسبة النفس صفة حميدة.",
 "帰する": "صِفَة, خُصُوصِيَّة (صُفَّة المَسْجِد هي موضع مُظَلَّل منه بين جدران ثلاثة؛ هي غُرْفَة ذات ثلاث جُدْرَان وسَقْف والإتجاه الرابع مَفْتُوح بلا بِنَاء. تستخدم غالبا للجلوس وتواجه صَحْن البَيْت) / نَسَبَ\nمثال: محاسبة النفس صفة حميدة.",
 "帰ってくる": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "帰って来る": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "帰らぬ人": "راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "帰り": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "帰りがけ": "فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "帰りしな": "فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "帰り掛け": "فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "帰り着く": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع.",
 "帰り際": "وقت المغادرة (الوقت المقرر لمغادرة وسيلة نقل عامة من نقطة انطلاق معينة)",
 "帰る": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع. / تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "帰伏": "اِسْتِسْلَام, خُضُوع (فعل الخضوع؛ عادة تسليم السلطة لآخر) / رأي قانوني, طرح ((قانون) حجة يقدمها محامٍ لقاضٍ أو هيئة محلفين كجزء من القضية التي يرافعون فيها) / إحالة للتحكيم, خضوع للتحكيم (اتفاق بين أطراف النزاع للالتزام بقرار المحكم) / اتفاق تحكيم (وثيقة قانونية تلخص اتفاقاً بين أطراف في نزاع للالتزام بقرار محكم)",
 "帰休": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "帰依": "اعتناق, هداية (استنارة روحية تدفع الشخص لعيش حياة جديدة) / تحويل, نقطة إضافية (رمية حرة ناجحة أو محاولة لكسب نقطة بعد التاتش داون) / تحويل (عملية التغيير من استخدام أو وظيفة أو غرض إلى آخر) / تحويل (فعل استبدال نوع من المال أو الأوراق المالية بآخر)",
 "帰依者": "حَوَّلَ (جَعَلَ الشيءَ غير ما كان؛ نقل الشيء من موضع إلى آخر)\nمثال: رقصنا حول النار.",
 "帰先遺伝": "انتكاس, تراجع (فشل في الحفاظ على حالة أعلى) / ارتداد, تراجع (العودة إلى حالة سابقة) / ارتداد, انعكاس (التحول في الاتجاه المعاكس) / ارتداد وراثي, رجعة (عودة ظهور صفة وراثية قديمة)",
 "帰化": "تعريب, توطين (تغيير نطق كلمة مستعارة لتتوافق مع صوتيات المقترضين) / أقلمة, توطين (إدخال الحيوانات أو النباتات إلى أماكن تزدهر فيها ولكنها ليست موطناً أصلياً لها) / تجنيس (الإجراء الذي يتم بموجبه منح الأجنبي الجنسية) / تَأَقْلُم, تَطْبِيع (صفة الجلب إلى التوافق مع الطبيعة)\nمثال: توطين العديد من الكلمات الإيطالية في اللغة الإنجليزية",
 "帰参": "رَاجِع, عَائِد (يميل إلى العودة إلى حالة سابقة)",
 "帰属": "انتماء (السعادة التي تشعر بها في علاقة آمنة)\nمثال: مع زملائه في الفصل شعر بإحساس بالانتماء / انتكاس, تراجع (فشل في الحفاظ على حالة أعلى) / ارتداد, تراجع (العودة إلى حالة سابقة) / ارتداد, انعكاس (التحول في الاتجاه المعاكس) / ارتداد وراثي, رجعة (عودة ظهور صفة وراثية قديمة)",
 "帰属意識": "بِطَاقَة هُوِيَّة",
 "帰巣": "مُوَجِّه ذَاتِيًّا (يوجه أو يقود نحو المنزل أو الوجهة)",
 "帰幽": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "帰心": "حَنِين, اِشْتِيَاق",
 "帰服": "اِسْتِسْلَام, خُضُوع (فعل الخضوع؛ عادة تسليم السلطة لآخر) / رأي قانوني, طرح ((قانون) حجة يقدمها محامٍ لقاضٍ أو هيئة محلفين كجزء من القضية التي يرافعون فيها) / إحالة للتحكيم, خضوع للتحكيم (اتفاق بين أطراف النزاع للالتزام بقرار المحكم) / اتفاق تحكيم (وثيقة قانونية تلخص اتفاقاً بين أطراف في نزاع للالتزام بقرار محكم)",
 "帰朝": "رجوع, عودة (حدوث تغيير في الاتجاه للرجوع في الاتجاه المعاكس)",
 "帰来": "رَاجِع, عَائِد (يميل إلى العودة إلى حالة سابقة)",
 "帰省": "إياب, رجوع (المجيء أو العودة إلى الوطن) / لقاء الخريجين (لقاء سنوي في المدرسة أو الجامعة للخريجين)\nمثال: عند عودته من أستراليا أقمنا له حفلة ترحيب",
 "帰真": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "帰着": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع. / نَتِيجَة / نَقْص",
 "帰納": "إطلاق, استحثاث (فعل يحرك سلسلة من الأحداث) / استحثاث, تحريض (فعل التسبب في حدوث شيء ما (خاصة في وقت مبكر)) / استدلال استقرائي, استقراء (الاستدلال من الحقائق التفصيلية إلى المبادئ العامة) / استثارة, استحثاث (تحفيز يستدعي (يستخرج) فئة معينة من السلوكيات)\nمثال: استحثاث حالة التخدير",
 "帰納法": "إطلاق, استحثاث (فعل يحرك سلسلة من الأحداث) / استحثاث, تحريض (فعل التسبب في حدوث شيء ما (خاصة في وقت مبكر)) / استدلال استقرائي, استقراء (الاستدلال من الحقائق التفصيلية إلى المبادئ العامة) / استثارة, استحثاث (تحفيز يستدعي (يستخرج) فئة معينة من السلوكيات)\nمثال: استحثاث حالة التخدير",
 "帰納的": "اسْتِقْرَائِيّ, تَحْرِيضِيّ (يحثّ أو يؤثّر؛ يقود إلى فعلٍ ما) / استقرائي (للاستدلال؛ الانتقال من حقائق جزئية إلى استنتاج عام) / حثي (ناشئ عن الحث (الكهربائي))\nمثال: تفكير استقرائي",
 "帰結": "عَاقِبَة / نَتِيجَة / جَوَابُ الشَّرْط (الجَوَاب : ما يكون رَدًّا على سؤالٍ أَو دعاءٍ أَو دَعْوَى، أَو رسالةٍ أَو اعتراضٍ ونحو ذلك والجمع : أَجوبة الأعراف - 82؛ الجَوَاب: صوت جَوْبِ الطير وفي حديث بناءِ الكعبة: حديث شريف فسمعنا جواباً من السماءِ، فإِذا بطائر أَعظم من النَّسر)\nمثال: لقد وجدتم الجواب.",
 "帰西": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)",
 "帰謬法": "الإثبات بالخلف, برهان الخلف (دحض عن طريق إظهار أن عواقب الاقتراح سخيفة؛ أو إثبات اقتراح عن طريق إظهار أن نفيها يؤدي إلى تناقض)",
 "帰趣": "نَتِيجَة",
 "帰趨": "نَتِيجَة",
 "帰還": "رَجَعَ, عَادَ (جَاءَ بعدما ذَهَبَ) / أَرْجَعَ, أَعَادَ (أَعَادَ، رَدَّ؛ صَرَفَ، رَدَّ) / عَوْدَة\nمثال: إياك والتحرك حتى أرجع. / تَلْقِيم اِسْتِرْجَاعِيّ, تَقْيِيم",
 "帰還不能限界点": "نُقْطَةُ اللَّاعَوْدَةِ, حُصِّلَ مَا فِي الصُّدُورِ (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "帰郷": "إياب, رجوع (المجيء أو العودة إلى الوطن) / لقاء الخريجين (لقاء سنوي في المدرسة أو الجامعة للخريجين)\nمثال: عند عودته من أستراليا أقمنا له حفلة ترحيب",
 "帰阪": "رجوع, عودة (حدوث تغيير في الاتجاه للرجوع في الاتجاه المعاكس)",
 "帰順": "اِسْتِسْلَام, خُضُوع (فعل الخضوع؛ عادة تسليم السلطة لآخر) / رأي قانوني, طرح ((قانون) حجة يقدمها محامٍ لقاضٍ أو هيئة محلفين كجزء من القضية التي يرافعون فيها) / إحالة للتحكيم, خضوع للتحكيم (اتفاق بين أطراف النزاع للالتزام بقرار المحكم) / اتفاق تحكيم (وثيقة قانونية تلخص اتفاقاً بين أطراف في نزاع للالتزام بقرار محكم)",
 "帳": "كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد / سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة أو منع أشعة الشمس) / حِجَاب, خِمَار (الغطاء أو الساتر؛ يُطلق مجازا على لباس المرأة الذي يستر جميع جسمها)\nمثال: ارتدت أمها الحجاب.",
 "帳つけ": "مسك الدفاتر (نشاط تسجيل المعاملات التجارية) / مُحَاسِب, مُحَاسِبَة",
 "帳付": "مسك الدفاتر (نشاط تسجيل المعاملات التجارية) / مُحَاسِب, مُحَاسِبَة",
 "帳元": "مُدِير, مُدِيرَة (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير. / مُؤَلِّف, كَتَّاب / مُرَاهِن",
 "帳場": "اِسْتِقْبَال / اِسْتِقْبَال, حَفْلَة اِسْتِقْبَال",
