 "屈性": "انتحاء",
 "屈折": "ثني, حني (عملية ثني شيء ما) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / انحراف, انكسار (المقدار الذي تنحني به موجة منتشرة) / تنغيم, عروض (أنماط الضغط والتنغيم في اللغة)",
 "屈折望遠鏡": "تلسكوب كاسر (تلسكوب بصري يحتوي على عدسة محدبة كبيرة تنتج صورة يتم مشاهدتها من خلال العدسة…)",
 "屈折率": "مُؤَشِّر الِانْكِسَار, مُعَامِل الِانْكِسَار (نسبة سرعة الضوء في الفراغ إلى سرعته في وسط ما)",
 "屈折異常": "سوء الانكسار (خطأ في انكسار أشعة الضوء في العين كما في اللابؤرية أو قصر النظر)",
 "屈折角": "زاوية الانكسار (الزاوية بين شعاع منكسر وخط عمودي على السطح بين الوسطين عند نقطة الانكسار)",
 "屈折計": "مقياس الانكسار (أداة قياس لقياس معامل انكسار مادة ما)",
 "屈折語": "لغة اندماجية (نوع من اللغات التركيبية حيث يمكن للمورفيمات الفردية أن تنقل أجزاء متعددة من…)",
 "屈指": "رَائِد, قِيَادِيّ (يذهب أو يتقدم في المقدمة؛ يظهر الطريق)\nمثال: ركبنا في السيارة المتقدمة",
 "屈撓": "ثني, حني (عملية ثني شيء ما)",
 "屈曲": "زَوَر, عِوَج (زَوَّرَ الطائرُ: أَكَلَ حتى امتلأَت حوصَلتُه وارتفعت؛ زَوَّرَ الشىءَ: أَصلَحَه…)",
 "屈曲部": "كُوع, مِرْفَق",
