 "射翳": "كَمين / كَمِين",
 "射芸": "رِمَايَة",
 "射落す": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "射落とす": "رَبِحَ (رَبَحَ التَّاجِرُ: نَالَ فَائِدَةً مَالِيَّةً فِي تِجَارَتِهِ؛ رَبَحَ السَّبَاقَ: فَازَ، تَفَوَّقَ)\nمثال: ربح زيري المال.",
 "射藝": "رِمَايَة",
 "射術": "رِمَايَة",
 "射込み": "حشو (حشوة توضع في المراتب والوسائد والأثاث المنجد) / تتبيلة الحشو, حشوة (خليط من المكونات المتبلة يستخدم لحشو اللحوم والخضروات)",
 "射通す": "ثَقَبَ (فَجَّرَ أو خَرَقَ شيئًا بفتح فيه؛ نَفَذَ أو مرَّ عبر شيء)\nمثال: انه ثقب الاسود.",
 "将": "آمِر, مُقَدَّم / أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟ / عِلَاوَة عَلَى ذٰلِكَ, أَضِف إِلَى ذٰلِك / رُبَّمَا / مِن اَلْمُمْكِن (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / لَعَلَّ (يفيد التوقع مع الترجي؛ يفيد التوقع مع الإشفاق والخوف)\nمثال: يا لها من جملة! / بِأَيَّةِ طَرِيقَة, عَلَى كُلِّ حَال",
 "将に": "عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "将る": "رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه) / حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "将官": "عَامّ / عُمُومِيّ, عَامّ / جِنِرال, فريق أوّل",
 "将帥": "آمِر, مُقَدَّم",
 "将星": "آمِر, مُقَدَّم",
 "将来": "مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل / تسليم, توصيل (عملية تسليم أو توزيع شيء ما (كالبضائع أو البريد))\nمثال: تسليمه المتردد للأخبار السيئة / إحداث, تسبيب (فعل التسبب في حدوث شيء ما)",
 "将来性": "وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها.",
 "将来的": "مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل",
 "将校": "ضابط مفوض, ضابط نظامي (ضابط عسكري يحمل تكليفاً رسمياً (مرسوماً))",
 "将棋": "شُوغِي",
 "将補": "لواء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "将軍": "عَامّ / عُمُومِيّ, عَامّ / جِنِرال, فريق أوّل / شُوغُون",
 "将軍職": "استبدادية, دكتاتورية (شكل من أشكال الحكم يكون فيه الحاكم دكتاتوراً مطلقاً (غير مقيد بدستور أو قوانين أو معارضة وما إلى ذلك))",
 "将領": "آمِر, مُقَدَّم",
 "尉": "مُفَتِّش, مُفَتِّشَة / شَيْخ, عَجُوز / مُرَّان أَمْرِيكِيّ",
 "尊": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / قِيمَة",
 "尊い": "ثَمِين / نَبِيل, شريف (اَلذَّكِيُّ؛ اَلنَّجِيبُ) / كَرِيم, شَرِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: إنها امرأة نبيلة.",
 "尊き": "ثَمِين / نَبِيل, شريف (اَلذَّكِيُّ؛ اَلنَّجِيبُ) / كَرِيم, شَرِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: إنها امرأة نبيلة.",
 "尊ぶ": "قِيمَة / اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "尊む": "قِيمَة / اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "尊体": "صُورَة / اِنْطِبَاع, سُمْعَة",
 "尊信": "تبجيل, تعظيم (عمل يظهر الاحترام (خاصة الانحناء)) / إجلال, توقير (موقف ذهني يتسم بالتبجيل والإجلال) / خشية, هيبة (شعور بالاحترام العميق لشخص أو شيء ما)\nمثال: خشية الله",
 "尊公": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "尊卑": "في كل حدب وصوب, في كل مكان (في كل مكان (عالياً ومنخفضاً))\nمثال: بحث في كل مكان",
 "尊厳": "كَرَامَة, وَقَار (الكرامة هي حق الفرد في أن يكون له قيمة وأن يُحترم لذاته، وأن يُعامل بطريقة أخلاقية)\nمثال: لا يعرض أي إنسان للتعذيب ولا للعقوبات أو المعاملات القاسية أو الوحشية أو الحاطة بالكرامة.",
 "尊台": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "尊大": "مُتَعَالٍ, الْمُتَعَالِي",
 "尊属": "مُسَيْطِر, مُهَيْمِن (الأَكْثَر قُوَّةً أَوْ أَهَمِّيَّةً أَوْ تَأْثِيرًا) / صَاعِد, مُتَصَاعِد (يَمِيلُ أَوْ يَتَّجِهُ نَحْوَ الأَعْلَى) / جد, سلف (شخص تنحدر منه (لكنه عادة أبعد من الجد)) / صعود, هيمنة (موقف أو حالة الهيمنة أو السيطرة)\nمثال: تلك الفكرة كانت في صعود",
 "尊属殺": "قتل أحد الوالدين (قتل الشخص لأبيه أو أمه) / قاتل أحد الوالدين (شخص يقتل والده أو والدته)",
 "尊属殺人": "قتل أحد الوالدين (قتل الشخص لأبيه أو أمه) / قاتل أحد الوالدين (شخص يقتل والده أو والدته)",
 "尊崇": "تبجيل, تعظيم (عمل يظهر الاحترام (خاصة الانحناء)) / إجلال, توقير (موقف ذهني يتسم بالتبجيل والإجلال) / خشية, هيبة (شعور بالاحترام العميق لشخص أو شيء ما)\nمثال: خشية الله",
 "尊師": "مُعَلِّم رُوحِيّ, جُورُو (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "尊影": "صُورَة / بُورْتْرِيَّة",
 "尊敬": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "尊敬心": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "尊王党": "إِمْبَرِيَالِيّ / إِمْبَرِيَالِيّ, إِمْبِرْيالِيَّة",
 "尊王家": "فارس ملكي (مؤيد ملكي لتشارلز الأول خلال الحرب الأهلية الإنجليزية) / ملكي (مدافع عن مبادئ الملكية)",
 "尊簡": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "尊翰": "حَرْف, حرف (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / رِسَالَة, مَكْتُوب\nمثال: ألف هو الحرف الأول للألف باء.",
 "尊者": "ضيف الشرف (الشخص الذي يُعقد التجمع تكريماً له) / جَلِيل, مُبَجَّل (محلّ احترام وتبجيل عميقين) / مَهِيب, وَقُور (مثير للإعجاب والتبجيل بسبب عراقته وقِدَمه)",
 "尊貴": "نَبِيل, شريف (اَلذَّكِيُّ؛ اَلنَّجِيبُ) / كَرِيم, شَرِيف (نبيل النفس عزيزها ذو الخلق العالي والخير الكثير والعطاء السخي. الكَرَم يشمل مجموعة من الأخلاق أهمها العطاء؛ الجَوَاد السخيّ تحديدا)\nمثال: إنها امرأة نبيلة.",
 "尊重": "اِحْتِرَام (احترام الذَّات: احترام النَّفس والشعور بالكرامة؛ احترامًا له: بدافع ال احترام) / اِعْتِبَار, صَدَد (اعتبر منه:تعجّب،وقيل:الْعِبْرة بالكسر هو الاسم من الاعتبار؛ اعتبر بالموت اعتباراً:تدبّر،اتّعظ به) / اِحْتَرَمَ\nمثال: تعامل معها باحترام.",
 "尊顔": "مَلَامِح",
 "尋": "قامة",
 "尋ぬ": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا. / طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا.",
 "尋ね": "سُؤَال, سؤال (سُؤَال) / مَسْأَلَة / استفهم\nمثال: أجب على السؤال.",
 "尋ねる": "سَأَلَ, سأل (اِسْتَعْلَمَ، اسْتَخْبَرَ؛ طَلَبَ، اِلْتَمَسَ)\nمثال: سأل توم عن هذا. / طَلَب, بَحْث (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى)) / بَحَثَ, فَتَّشَ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه) / بَحَثَ عَنْ (طَلَب الشيء في التُرَاب؛ طلب الشيء في أي مكان والتَفْتِيش والتَقَصِّي عنه)\nمثال: طلب زيري ورودا.",
 "尋問": "اسْتِفْهَامِيّ, مُتَسَائِل (يُظهِر الفضول والتساؤل) / مُتَسَائِل, مُسْتَفْهِم (في حيرة كأنّه يُتوقَّع منه معرفة ما لا يعرفه) / شَكَّاك, مُتَشَكِّك (يتسم بالشك أو يميل إليه) / استعلام, استفسار (طلب معلومات)",
 "尋常": "شَائِع / أَشْقَر (هو لون الشُقْرَة، وأصله اللون الأحمر المائل إلى الصُفرة ثم أصبح يطلق على ما كان لونه أصفر أيضا؛ صفة ما كان لونه الشُقرة) / حَقَّانِيّ, عادِل / مَأْذُون, مُبَاح\nمثال: أنا لديها شعر بني كستنائي, ولكن ماجدالينا لديها شعر أشقر. / إِفْرَنْجِيّ / غَيْرُ مُتَكَلَّف, مُتَحَفِّظ (يُظْهِرُ ذَوْقًا رَفِيعًا بِتَحَفُّظٍ وَاعْتِدَال)",
 "尋常ならざる": "غَيْر مَأْلُوف (لا يُصادف عادة) / استثنائي, غير عادي (غير معتاد أو غير شائع أو غير عادي) / شاذ, عجيب (خارج عن المألوف وغير متوقع بشكل قاطع؛ غريب قليلاً أو حتى شاذ)\nمثال: مشهد ذو جمال غير عادي",
 "尋常一様": "عَادِيّ, مَأْلُوف",
 "尋常小学校": "مدرسة ابتدائية (مدرسة للأطفال الصغار؛ عادة ما تكون الصفوف الستة أو الثمانية الأولى)",
 "尋常性ざ瘡": "حب الشباب الشائع (أكثر أشكال حب الشباب شيوعًا؛ يصيب عادة الأشخاص من سن البلوغ إلى مرحلة الشباب)",
 "尋常性狼瘡": "ذئبة شائعة (سل الجلد؛ يظهر أولاً على الوجه ويشفى ببطء تاركًا ندوبًا عميقة)",
 "尋常性痤瘡": "حب الشباب الشائع (أكثر أشكال حب الشباب شيوعًا؛ يصيب عادة الأشخاص من سن البلوغ إلى مرحلة الشباب)",
 "尋常性白斑": "بُهَاق",
 "對": "فِي مُقَابِل, ضِِدَّ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / عَلَى اَلْعَكْس, ضِِدَّ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: جون في عمر أخي. / أَنّ (يفيد التوكيد) / إِلَى, عَلَى (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: كيف لي أن أعرف؟ / ضِدّ / آخَر (ضد الأوَّل؛ وهو من يكون ترتيبه بعد الجميع؛ الشيء: مؤخرّه، الجزء الآخير منه) / عَلَى العَكْس (يفيد الاستعلاء؛ يفيد التعليل) / فِي مُوَاجَهَة, أَمَام (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة) / أَمَام\nمثال: أرني مثالا آخر.",
 "對して": "لِأَنَّ / لِـ (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي) / لِأَجْل / لِـ, بِالنِّسْبَة لِـ (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي)",
 "導": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد",
 "導き": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد",
 "導きだす": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
 "導き出す": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
 "導き手": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "導く": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي. / استمد / استنتج",
 "導体": "قَائِدُ فِرْقَاتٍ مُوسِيقِيَّةٍ / كُمْسَرِيّ, كُمْسَارِيّ / مُوَصِّل كَهْرَبَائِيّ, مُوَصِّل",
 "導入": "مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "導入部": "مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف) / رَصَاص / قَادَ / أَرْشَدَ, هَدَى (أَرشَدَهُ: هدَاه ودَلَّهُ؛ يقال: أَرشَدَهُ الله، وأَرشدَهُ إِلى الأَمر، وله، وعليه)",
 "導出": "استمداد, اشتقاق (فعل اشتقاق شيء أو الحصول عليه من مصدر أو أصل) / تحويل المسار, سحب (سحب المياه من قناتها الرئيسية كما للري) / اشتقاق, سحب (سحب السوائل أو الالتهاب بعيداً عن جزء مريض من الجسم) / أصل, سلالة (الخصائص الموروثة المشتركة مع الآخرين من نفس سلالة الدم)",
 "導因": "تشجيع, حافز (تأثير تحفيزي إيجابي) / حافز, مكافأة (دفعة إضافية (أو مكافأة أخرى) للموظفين كوسيلة لزيادة الإنتاج)",
 "導師": "مُعَلِّم رُوحِيّ, جُورُو (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "導引": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد / تَدْلِيك, تَمْسِيد / دَلَّكَ, مَسَّدَ (دَلَكَ جِسْمَهُ: حَكَّهُ؛ يَدْلُكُ وَجْهَهُ بِالطِّيبِ: يَطْليهِ، يُضَمِّخُهُ)",
 "導手": "قَائِدُ فِرْقَاتٍ مُوسِيقِيَّةٍ / كُمْسَرِيّ, كُمْسَارِيّ / مُوَصِّل كَهْرَبَائِيّ, مُوَصِّل",
 "導水管": "شِيشَة, أرجيلة",
 "導波管": "موجه موجي (موصل معدني مجوف يوفر مساراً لتوجيه الموجات الدقيقة؛ يستخدم في الرادار)",
 "導波路": "موجه موجي (موصل معدني مجوف يوفر مساراً لتوجيه الموجات الدقيقة؛ يستخدم في الرادار)",
 "導火線": "فَتِيل / مُنْصَهِرَة, مصهر",
 "導管": "أنبوب, قناة (ممر (أنبوب أو نفق) يمكن أن تمر عبره المياه أو الأسلاك الكهربائية)\nمثال: تم توصيل الحواسيب من خلال نظام من القنوات / وِعَاء (الوِعَاءُ : الظَّرْفُ يوعَى فيه الشيءُ، ما يُجْمَعُ فيه الشّيءُ ويُحْفظ؛ الوِعَاءُ : إناء منزليّ يُصنع من الخزف أو المعدن أو الزُّجاج كوعاء الطَّبخ الذي له يد وغطاء أو وعاء دائريّ لتقديم الطَّعام أو إناء حفظ القهوة والشَّاي)\nمثال: وعاء السکر فارغ.",
 "導管実体": "نافذة مناولة (فتحة تشبه النافذة بين غرفتين (خاصة فتحة بأرفف بين المطبخ وغرفة الطعام تستخدم لتمرير الأطباق))",
 "導線": "سلك, سلك موصل (موصل معدني يحمل الكهرباء لمسافة)",
 "導通": "توصيل, موصلية (انتقال الحرارة أو الكهرباء أو الصوت)",
 "導通抵抗": "مُقَاوَمَة",
 "導関数": "مشتقّ",
 "導電": "توصيل, موصلية (انتقال الحرارة أو الكهرباء أو الصوت)",
 "導電体": "قَائِدُ فِرْقَاتٍ مُوسِيقِيَّةٍ / كُمْسَرِيّ, كُمْسَارِيّ / مُوَصِّل كَهْرَبَائِيّ, مُوَصِّل",
 "導電度": "توصيل, موصلية (انتقال الحرارة أو الكهرباء أو الصوت)",
 "導電性": "توصيل, موصلية (انتقال الحرارة أو الكهرباء أو الصوت)",
 "導電率": "توصيل, موصلية (انتقال الحرارة أو الكهرباء أو الصوت)",
 "小": "صِغَر (جعل الشيء أصغر حجمًا أو أقل قيمة؛ قلل من أهمية شخص أو شيء أو استهان به)\nمثال: الصغر أسرع من النسر / بَوْل / مدرسة ابتدائية (مدرسة للأطفال الصغار؛ عادة ما تكون الصفوف الستة أو الثمانية الأولى) / أَصْغَر (صغير نسبةً إلى شيء آخر) / صَغِير, صغير / تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب)\nمثال: استمر حوالي ساعة / إلى حد ما, باعتدال (إلى حد أو درجة معينة) / إلى حد ما, قليلاً (بدرجة أو مدى صغير)\nمثال: كبير جداً / صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة) / أصغر, أقلية (أقل في العدد أو الحجم أو المقدار) / بسيط, ثانوي (أقل في النطاق أو التأثير) / قاصر (لم يبلغ السن القانونية)\nمثال: حصة صغيرة من الأرباح / صَغِير, صغير / قَلِيلًا / ضَيِّق",
 "小うるさい": "خاص (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "小かっこ": "حشو",
 "小がら": "دَقِيق, زَهِيد (صغير جداً) / صغير (مقاس ملابس للنساء القصيرات أو النحيلات)",
 "小ぎれい": "دَقِيق, مُتْقَن (خالٍ من الخَرَق؛ مُنفَّذ بدقة ومهارة) / صِرْف, غَيْر مَمْزُوج ((عَنِ المَشْرُوب الكُحُولِيّ) بِدُون مَاء) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / أَنِيق ظَاهِرِيًّا, بَرَّاق (يبدو مؤثّرًا من السطح لكنّه يفتقر إلى العمق والدقّة)",
 "小さ": "حَبِيبِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / حَبِيبِي, عَزِيزِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض)\nمثال: ماذا تفعل حبيبي",
 "小さい": "صَغِير, صغير / طَفِيف / حَزين / خافِت, مُنْخَفِض / تافه, غير مهم (ليس مهماً) / تافه, ضئيل الشأن (خالٍ من الأهمية أو المعنى أو القوة)\nمثال: ميزة غير مهمة نسبياً للنظام",
 "小さじ": "مِلْعَقَة شَاي, مِلْعَقَة صَغِيرَة (أداة للأكل والاحتساء والطبخ وتقديم الطعام)",
 "小さっぱりした": "دَقِيق, مُتْقَن (خالٍ من الخَرَق؛ مُنفَّذ بدقة ومهارة) / صِرْف, غَيْر مَمْزُوج ((عَنِ المَشْرُوب الكُحُولِيّ) بِدُون مَاء) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / أَنِيق ظَاهِرِيًّا, بَرَّاق (يبدو مؤثّرًا من السطح لكنّه يفتقر إلى العمق والدقّة)",
 "小さな": "صَغِير, صغير",
 "小さめ": "صَغِير نَوْعًا مَا (صغير إلى حدٍّ ما)",
 "小さ目": "صَغِير نَوْعًا مَا (صغير إلى حدٍّ ما)",
 "小ざかしい": "قَلِيل الأَدَب, وَقِح (جريء بشكل مسيء وبذيء) / مَاكِر",
 "小じゃれた": "قَلِيلًا",
 "小じゃれる": "طُرْفَة, نُكْتَة / نُكْتَة, هَزْل / مَزَحَ",
 "小じわ": "تجاعيد الضحك, قدم الغراب (تجعد في الجلد عند الزاوية الخارجية للعينين)",
 "小じんまり": "بإحكام (بشكل ملائم تماماً (للملابس)) / بأمان (محمي بأمان) / بدفء وراحة (محمي بشكل دافئ ومريح)\nمثال: ناسقت السترة بإحكام",
 "小ちゃい": "صَغِير, صغير",
 "小ぢんまり": "بإحكام (بشكل ملائم تماماً (للملابس)) / بأمان (محمي بأمان) / بدفء وراحة (محمي بشكل دافئ ومريح)\nمثال: ناسقت السترة بإحكام",
 "小っさい": "صَغِير, صغير / حَزين / خافِت, مُنْخَفِض",
 "小っさな": "صَغِير, صغير",
 "小っちゃい": "دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "小っちゃこい": "صَغِير, صغير",
 "小っちゃな": "دَقِيق (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "小っ恥ずかしい": "قَلِيلًا",
 "小なり": "أَصْغَر مِن, صُغْرَى مِن",
 "小なりイコール": "أَصْغَر مِن, صُغْرَى مِن",
 "小ばか": "مُغَفَّل, أَحْمَق",
 "小ばかにする": "تَرَفَّعَ",
 "小ぶり": "صَغِير نَوْعًا مَا (صغير إلى حدٍّ ما)",
 "小まめ": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "小わき": "إِبْط (ما تحت الذراع بين ال المتن والمنكب؛ إبط الحيوان: ما تحت منكبه، ما يعادل إبط الإنسان عنده)",
 "小わっぱ": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى.",
 "小アジア": "آسِيَا الصُّغْرَى (إحدى القارات السبع؛ أكبرها مساحةً، وأكثرها سكانًا)\nمثال: على شعوب آسيا أن تتعاون.",
 "小エビ": "رُوبِيَان / جَمْبَرِيّ / إِرْبِيَان / قُرَيْدِس",
 "小カッコ": "حشو",
 "小ギツネ": "جَرْو ثَعْلَب (الصَغير من كل نَبَات أو حَيَوَان؛ الصغير من الثَمَر كالبَطِّيخ والرُمَّان وغيره)\nمثال: كان الجرو يلحس خدها.",
 "小グループ": "زمرة جزئية (مجموعة جزئية (غير خالية) من زمرة رياضية) / مجموعة فرعية (مجموعة مميزة وغالباً ما تكون تابعة داخل مجموعة)",
 "小ジョッキ": "تفاهة, شيء تافه (شيء قليل الأهمية)",
 "小テスト": "اِخْتِبَار (اختبر الشّيء:خبره)\nمثال: تم اختبار زيري.",
 "小ブル": "البرجوازية الصغيرة (الطبقة المتوسطة الدنيا (مثل أصحاب المتاجر والموظفين الكتابيين)) / برجوازي صغير (عضو في الطبقة المتوسطة الدنيا)",
 "小ブルジョア": "البرجوازية الصغيرة (الطبقة المتوسطة الدنيا (مثل أصحاب المتاجر والموظفين الكتابيين)) / برجوازي صغير (عضو في الطبقة المتوسطة الدنيا)",
 "小ロシア": "أُوكْرَانِيَا (دولة تقع في شرق قارة أوروبا، وتحد الساحل الشمالي من البحر الأسود؛ أُسِّسَت كدولة مستقلة بعد سقوط الاتحاد السوفياتي عام ١٩٩١…)\nمثال: المجد لأوكرانيا",
 "小一": "فِي السَّنَةِ الأُولَى, مُسْتَجِدّ (يُوصَفُ بِهِ الشَّخْصُ فِي سَنَتِهِ الأُولَى مِنْ تَجْرِبَةٍ (خَاصَّةً فِي المَدْرَسَةِ أَوِ الجَامِعَةِ))",
 "小世界": "مُنَمْنَمَة",
 "小丘": "أكمة, رابية (تل طبيعي صغير)",
 "小久保": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小乗": "بوذية الهينايانا, هينايانا (اسم مسيء لبوذية التيرافادا المحافظة المبكرة؛ انقرضت في الهند لكنها بقيت في سريلانكا ونقلت من هناك إلى مناطق أخرى من جنوب غرب آسيا) / هينايانا (مدرسة رئيسية في البوذية تُعَلِّم الخلاص الشخصي من خلال الجهود الذاتية)",
 "小乗仏教": "بوذية الهينايانا, هينايانا (اسم مسيء لبوذية التيرافادا المحافظة المبكرة؛ انقرضت في الهند لكنها بقيت في سريلانكا ونقلت من هناك إلى مناطق أخرى من جنوب غرب آسيا) / بوذية التيرافادا, تيرافادا (واحدة من مدرستين عظيمتين للعقيدة البوذية تؤكدان على الخلاص الشخصي من خلال الجهود الذاتية؛ شكل محافظ من البوذية يلتزم بنصوص بالي والمثل غير الإلهي…)",
 "小乗的": "ضَيِّق الأُفُق (يفتقر إلى التسامح أو المرونة أو اتساع الرؤية) / ضيق الأفق, متعصب (يلتزم بجمود بطائفة معينة أو عقائدها) / سريع التأثر, قابل للصدمة (يمكن أن يصاب بالصدمة (الاجتماعية أو الأخلاقية))\nمثال: قاضٍ لامع ولكنه ضيق الأفق",
 "小事": "تفاهة, شيء تافه (شيء قليل الأهمية) / أمر تافه, تفاهة (تفصيل يعتبر غير مهم) / ترافل (بودينغ بارد مصنوع من طبقات من الكعك الاسفنجي المدهون بالفاكهة أو الجيلي؛ وقد يُزين بالمكسرات أو الكريمة أو الشوكولاتة)",
 "小事件": "عرض جانبي (عرض صغير يكون جزءاً من عرض أكبر (كما في السيرك)) / حدث جانبي, عرض جانبي (حادثة ثانوية قليلة الأهمية مقارنة بالحدث الرئيسي)\nمثال: التعليم ليس حدثاً جانبياً تربوياً",
 "小井川": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小京都": "بلدة صغيرة, قرية (مجتمع من الناس أصغر من بلدة)",
 "小人": "وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / قَزَم / حَنْدَل, حِنْتَار / قَزَمِيّ / ضَيِّق الأُفُق (يفتقر إلى التسامح أو المرونة أو اتساع الرؤية) / ضيق الأفق, متعصب (يلتزم بجمود بطائفة معينة أو عقائدها) / سريع التأثر, قابل للصدمة (يمكن أن يصاب بالصدمة (الاجتماعية أو الأخلاقية))\nمثال: قاضٍ لامع ولكنه ضيق الأفق / وَلَد, اِبْن (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد. / قَزَم / حَنْدَل, حِنْتَار / قَزَمِيّ",
 "小人物": "تَافِه, ضَيِّق النَّظَر (مَحْدُود الأُفُق بِشَكْلٍ مُحْتَقَر)",
 "小人症": "تقزم (خلل جيني يؤدي إلى قصر القامة)",
 "小伏": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小休憩": "أنبوب التنفس, سنوركل (ممر هوائي يوفره جهاز قابل للسحب يحتوي على أنابيب سحب وعادم؛ يسمح للغواصة بالبقاء تحت الماء لفترات طويلة) / فترة التقاط الأنفاس, متنفس (استراحة قصيرة)",
 "小休止": "أنبوب التنفس, سنوركل (ممر هوائي يوفره جهاز قابل للسحب يحتوي على أنابيب سحب وعادم؛ يسمح للغواصة بالبقاء تحت الماء لفترات طويلة) / فترة التقاط الأنفاس, متنفس (استراحة قصيرة)",
 "小低木": "جنبة, شجيرة فرعية (شجيرة خشبية منخفضة النمو أو نبات معمر بقاعدة خشبية)",
 "小体": "دَافِئ, مُرِيح (يوفر دفئاً مريحاً ومأوى خاصة في مكان صغير) / مُحْكَم البِنَاء (مبنيّ بإحكام ومتانة) / مُحْكَم, مُلائِم (ضَيِّق وَمُلائِم لِلجِسْم بِشَكْل مُريح) / آمِن, مُحْتَمٍ (يوفّر الأمان؛ محميّ أو مخبَّأ بشكل جيّد)",
 "小作人": "إِرِّيس",
 "小使": "بَوَّاب",
 "小使い": "بَوَّاب",
 "小使いさん": "بَوَّاب",
 "小便": "بَوْل",
 "小便をする": "تَبَوَّلَ, بَالَ",
 "小便を垂れる": "بَوْل / بَوَّلَ / بِيه, پِي",
 "小便器": "مِبْوَلَة",
 "小便所": "مِبْوَلَة",
 "小便臭い": "طُفُولِيّ",
 "小便袋": "مَثَانَة, مَثَانَة بَوْلِيَّة ((في الأحياء) عضو مرن يشبه الكيس يتمدد وينقبض، وظيفته تخزين سائل أو غاز ما؛ تحديدًا، المثانة البولية، وهي العضو الذي يخزن البول في الإنسان وفي العديد من الحيوانات)",
 "小保方": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小俣": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小倅": "بَانْك",
 "小倉": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اسم مكان (الاسم الذي يُعرف به مكان جغرافي)",
 "小倉アイス": "بُوظَة, آيْس كِرِيم",
 "小像": "بيبلو, تمثال صغير (تمثال صغير منحوت أو مقولب)",
 "小僧": "صغير, طفل (شخص صغير السن من أي من الجنسين)\nمثال: هي تكتب كتباً للأطفال / ساعي, فتى المراسلات (صبي يكسب المال عن طريق توصيل الرسائل وقضاء المهمات)",
 "小僧っ子": "براتوورست (سجق خنزير صغير) / طفل شقي (طفل مزعج جداً)",
 "小僧子": "براتوورست (سجق خنزير صغير) / طفل شقي (طفل مزعج جداً)",
 "小児": "رَضِيع",
 "小児マヒ": "شَلَل الْأَطْفَال / شلل دماغي",
 "小児性愛": "بيدوفيليا, ولع بالأطفال (الانجذاب الجنسي للأطفال)",
 "小児性愛者": "بيدوفيل, متحرش بالأطفال (شخص بالغ ينجذب جنسياً للأطفال)",
 "小児愛者": "بيدوفيل, متحرش بالأطفال (شخص بالغ ينجذب جنسياً للأطفال)",
 "小児科": "طِبُّ الأَطْفَال (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "小児科医": "طبيب أطفال (أخصائي في رعاية الأطفال)",
 "小児脂肪便症": "الداء البطني, حساسية القمح (اضطراب يصيب الأطفال والبالغين؛ عدم القدرة على تحمل بروتين القمح (الغلوتين)؛ تشمل الأعراض إسهالاً كريه الرائحة وهزالاً؛ غالباً ما يكون مصحوباً بعدم…)",
 "小児麻痺": "شَلَل الْأَطْفَال / شلل دماغي",
 "小公女": "قَلِيلًا",
 "小公子": "طفل مدلل (صبي مهذب ومتأنق بشكل مفرط)",
 "小兵": "شخص صغير الحجم, ضئيل الجسم (شخص حجمه أقل من المتوسط)",
 "小円筋": "مدورة صغرى (عضلة مدورة تقرب الذراع وتديرها وحشياً)",
 "小冊": "مَنْشُور, كُرَّاسَة",
 "小冊子": "كُتَيِّب, كُرَّاسَة (كِتَاب صَغِير؛ دَلِيل)",
 "小冠者": "شاب (مراهق أو شاب بالغ ذكر)",
 "小出": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小刀": "سِكِّين, مُدْيَة (أَدَاةٌ حَادَةٌ تُسْتَخْدَمُ فِي تَقْطِيعِ مُخْتَلَفِ أَصْنَافِ الطَّعَامِ كَاللَّحْمِ وَالْخُضَرِ، وَلِذَبْحِ الْحَيَوَانَاتِ؛ أَدَاةٌ حَادَةٌ تُصْنَعُ غَالِباً مِنَ الْمَعْدِنِ، لِلدِّفَاعِ عَنِ النَّفْسِ وَاسْتِخْدَامِهَا أَثْنَاءَ الْقِتَالِ) / خَنْجَر, خنجر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين) / نَصْل, شَفْرَة (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة الحادّة الجارحة)\nمثال: أحتاج الى سكين.",
 "小分け": "تقسيم فرعي (عملية التقسيم الفرعي؛ تقسيم شيء مقسم سابقاً) / شعبة, قسم فرعي (قسم من قسم؛ جزء من جزء؛ أي جزء من شيء مقسم بالفعل) / جزء, فرع (جزء قائم بذاته من عمل أكبر (مكتوب أو موسيقي)) / شُعبة, فرع (قسم من منظمة أكبر أو أكثر تعقيدًا)\nمثال: يتجه دائماً أولاً إلى قسم الأعمال",
 "小切手": "شِيك",
 "小切手帳": "دفتر شيكات (دفتر يصدر لأصحاب الحسابات الجارية)",
 "小判": "إِهْلِيلَج / إِهْلِيلَجِيّ, بَيْضَوِيّ",
 "小判型": "إِهْلِيلَج / إِهْلِيلَجِيّ, بَيْضَوِيّ",
 "小判形": "إِهْلِيلَج / إِهْلِيلَجِيّ, بَيْضَوِيّ",
 "小判鮫": "ريمورا, سمكة مصاصة (أسماك بحرية ذات جسم ممدود مسطح وقرص ماص على الرأس للالتصاق بالأسماك الكبيرة أو الأجسام المتحركة) / مُتَطَفِّل, مُلْحَق (شخص يتبع باستمرار (وبشكل مزعج))",
 "小利口": "حَاذِق (اسم فاعل للفعل حَذِقَ أي المَاهِرِ المُتقِنِ لعَمَلِهِ) / نَاصِح, نَبِيه\nمثال: إنها حاذقة الذكاء.",
 "小刻み": "مُتَصَنِّعٌ, مُتَكَلِّفٌ (مُتَصَنِّع في الرقة والتهذيب) / تَدْرِيجِيّ",
 "小前提": "مقدمة صغرى (مقدمة القياس المنطقي التي تحتوي على الحد الأصغر (الذي هو موضوع النتيجة))",
 "小劇場": "مسرح صغير (مسرح صغير للدراما التجريبية أو المجموعات الجامعية أو المجتمعية)",
 "小包": "رِزْمَة, رُزْمَة",
 "小包爆弾": "رسالة مفخخة, طرد مفخخ (جهاز متفجر رقيق داخل ظرف أو طرد وينفجر عند فتحه)",
 "小包郵便物": "رِزْمَة, رُزْمَة",
 "小匙": "مِلْعَقَة شَاي, مِلْعَقَة صَغِيرَة (أداة للأكل والاحتساء والطبخ وتقديم الطعام)",
 "小匣": "صندوق مجوهرات (صندوق صغير ومزخرف غالباً لحفظ المجوهرات أو الأشياء الثمينة الأخرى) / تابوت, نعش (صندوق يدفن فيه الميت أو يُحرق)",
 "小卒": "مدرسة ابتدائية (مدرسة للأطفال الصغار؛ عادة ما تكون الصفوف الستة أو الثمانية الأولى)",
 "小卵": "بويضة صغيرة (بويضة صغيرة أو غير ناضجة) / بويضة (جسم صغير يحتوي على الخلية الجرثومية الأنثوية للنبات؛ يتطور إلى بذرة بعد الإخصاب)",
 "小原": "اسم مكان (الاسم الذي يُعرف به مكان جغرافي) / لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小口": "حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما) / حافة, طرف (الحد الخارجي لجسم أو منطقة أو سطح؛ مكان أبعد ما يكون عن مركز الشيء) / أَفْضَلِيَّة نِسْبِيَّة, تَفَوُّق بَسِيط (ميزة تنافسية طفيفة) / حدة (سمة الإلحاح في نبرة الصوت)\nمثال: قام بتدوير حواف الصندوق / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "小口バス": "قاروص صغير الفم (نوع من القاروص الأسود؛ تقع زاوية الفك أسفل العين) / باس صغير الفم (لحم سمكة الباس صغير الفم)",
 "小口切り": "تقطيع لشرائح (عملية التقطيع إلى شرائح) / ضربة مقوسة لليمين (ضربة غولف تنحني لليمين للاعب الغولف الأيمن)\nمثال: أخذ دروساً لعلاج ضرباته المقوسة",
 "小口現金": "مصروفات نثرية (صندوق نقدي صغير تحتفظ به الشركة لدفع المصاريف العرضية)",
 "小向": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "小味": "خفاء, دقة (صفة الصعوبة في الكشف أو التحليل) / تَفَاوُت دَقِيق, فَارِق بَسِيط (اختلاف دقيق في المعنى أو الرأي أو الموقف)\nمثال: عليك أن تعجب بدقة الفروق التي رسمها",
 "小咄": "نَادِرَة / أُطْرُوفَة / أُفْكُوهَة / طُرْفَة / فُكَاهَة / لَطِيفَة (مؤنث لَطِيْف؛ ذات اللطف والطافة؛ يقصد بها أحيانا جميلة بدون أن تكون ملفتة للنظر)\nمثال: هي مدرسة لطيفة.",
 "小品": "مَقَالَة, بَحْث",
 "小唄": "بَالَاد",
