 "居心地よい": "مُرِيح, وَثِير / مُرْتَاح / مُرِيح",
 "居心地良い": "مُرِيح, وَثِير / مُرْتَاح / مُرِيح",
 "居所": "مكان التواجد (الموقع العام الذي يوجد فيه شيء ما)\nمثال: سألته عن مكان تواجده ليلة الجريمة",
 "居木": "المتوازي, قضيبان متوازيان (جهاز جمباز يتكون من قضيبين خشبيين متوازيين مثبتين على قوائم)",
 "居残り": "تَوْقِيف",
 "居残る": "بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة كونه واجبَ الوجود لذاته ، فهو الأوّل بلا ابتداء ، والآخر بلا انتهاء؛ الباقي الثابتُ بعد غيره) / بَقِيَ, مَكَثَ (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: الباقي ليس مهم.",
 "居然": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "居留": "مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "居留地": "امتياز (عقد يمنح الحق في تشغيل عمل فرعي) / إذعان, تنازل (فعل التنازل أو الإذعان) / تنازل (نقطة يتم التنازل عنها أو التسليم بها)\nمثال: حصل على امتياز البيرة في ملعب الكرة / حَجْز (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "居留民": "سَاكِن, سَاكِنَة",
 "居眠り": "غفوة, نعاس (نوم خفيف متقطع)",
 "居眠る": "نَامَ عَلَى نَفْسِهِ (الإنسان أو الحيوان: رَقَدَ وغَفَا؛ الإنسان أو الحيوان: رَقَدَ وإن لم يغفو)\nمثال: نام في الحافلة.",
 "居着く": "هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "居石": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "居空き": "سَطْو / لُصُوصِيَّة",
 "居続ける": "بَاقِي (الباقي : اسم من أسماء الله تعالى ومعناه : المستأثر بالبقاء والدّوام ، وهو نتيجة كونه واجبَ الوجود لذاته ، فهو الأوّل بلا ابتداء ، والآخر بلا انتهاء؛ الباقي الثابتُ بعد غيره) / بَقِيَ, مَكَثَ (أَقَامَ أو ثَبَتَ في مكانه أو حاله زمنا قصيرا أو طويلا؛ فَضَلَ)\nمثال: الباقي ليس مهم.",
 "居間": "غُرْفَةْ الاِسْتِقْبَال, غُرْفَةْ جُلُوس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "居間兼寝室": "غُرْفَةْ الاِسْتِقْبَال, غُرْفَةْ جُلُوس (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "居食屋": "مطعم, مكان للأكل (مبنى يذهب الناس إليه لتناول الطعام)",
 "居館": "مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "居高": "مُتَكَبِّر, مَغْرُور (شعب مُتكبِّر : مُتعجرف ، شامخ الرأس؛ مُتكَبِّر : فاعل من تَكَبَّر)\nمثال: هو متكبر للغاية.",
 "屆ける": "نَقَلَ / وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "屈す": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله. / ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / طَوَّعَ, تَغَلَّبَ عَلَى",
 "屈する": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله. / ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / طَوَّعَ, تَغَلَّبَ عَلَى",
 "屈まる": "قَوْس, قوس / اَنْشُوطَة, فيونكة / اِنْحَنَى / اِنْحَنَى لِلتَّحِيَّة, اِنْحَنَى / اِنْحِنَاءَة, اِلْتِوَاءَة / قَيْدُوم",
 "屈む": "انحناء (انحناء النصف العلوي من الجسم للأمام وللأسفل) / بسطة المدخل, عتبة (شرفة صغيرة أو مجموعة من الدرجات عند المدخل الأمامي للمنزل) / حوض الماء المقدس (حوض للماء المقدس) / انحناء, جثوم (عملية الانحناء المنخفض مع ضم الأطراف للجسم)",
 "屈める": "انحناء (انحناء النصف العلوي من الجسم للأمام وللأسفل) / بسطة المدخل, عتبة (شرفة صغيرة أو مجموعة من الدرجات عند المدخل الأمامي للمنزل) / حوض الماء المقدس (حوض للماء المقدس)",
 "屈伏": "رَضُوخ, مُذْعِن (يَمِيلُ إِلَى الِاسْتِسْلَامِ أَوِ التَّنَازُلِ أَوِ المُوَافَقَةِ) / طَيِّع, لَدِن (يَسْتَجيب لِلضَّغْط بِسُهولَة؛ قابِل لِلتَّشَكُّل) / لَيِّن, مُسْتَسْلِم (يميل إلى الاستسلام للحجة أو التأثير أو السيطرة) / إذعان, تنازل (فعل التنازل أو الإذعان)",
 "屈伸性": "مرونة (ميل الجسم للعودة إلى شكله الأصلي بعد تمدده أو ضغطه)\nمثال: فقد حزام الخصر مرونته",
 "屈光性": "انتحاء ضوئي (استجابة توجيهية للضوء)",
 "屈地性": "انتحاء أرضي (استجابة توجيهية للجاذبية)",
 "屈強": "قَوِيّ (اسم من أسماء الله الحسنى؛ الشَدِيْد ذو الحَوْل)\nمثال: كانت صدمة قوية.",
 "屈従": "تذلل, تملق (خضوع ذليل أو مهين) / تذلل, خنوع (في حالة خنوع) / انقياد, تبعية (حالة كون الشيء مفيداً في تحقيق غاية أو تنفيذ خطة)\nمثال: كانت جميع أفعاله تابعة للخطة العامة",
 "屈性": "انتحاء",
 "屈折": "ثني, حني (عملية ثني شيء ما) / انحراف, انحناء (خاصية الانحناء أو الانحراف) / انحناء, تقوس (حركة تسبب تشكل منحنى) / اعوجاج, انحراف (تشويه أخلاقي أو عقلي) / انحراف, انكسار (المقدار الذي تنحني به موجة منتشرة) / انكسار (التغير في اتجاه موجة منتشرة (ضوء أو صوت) عند مرورها من وسط إلى آخر) / تنغيم, عروض (أنماط الضغط والتنغيم في اللغة) / تعديل الصوت (طريقة في التحدث يتم فيها تعديل جهارة أو حدة أو نبرة الصوت) / انثناء, انعطاف (انحراف عن مسار مستقيم أو طبيعي) / إِعْرَاب, تَصْرِيف (تغيير في شكل الكلمة (عادة بإضافة لاحقة) للإشارة إلى تغيير في وظيفتها النحوية)",
 "屈折望遠鏡": "تلسكوب كاسر (تلسكوب بصري يحتوي على عدسة محدبة كبيرة تنتج صورة يتم مشاهدتها من خلال العدسة العينية)",
 "屈折率": "مُؤَشِّر الِانْكِسَار, مُعَامِل الِانْكِسَار (نسبة سرعة الضوء في الفراغ إلى سرعته في وسط ما)",
 "屈折異常": "سوء الانكسار (خطأ في انكسار أشعة الضوء في العين كما في اللابؤرية أو قصر النظر)",
 "屈折角": "زاوية الانكسار (الزاوية بين شعاع منكسر وخط عمودي على السطح بين الوسطين عند نقطة الانكسار)",
 "屈折計": "مقياس الانكسار (أداة قياس لقياس معامل انكسار مادة ما)",
 "屈折語": "لغة اندماجية (نوع من اللغات التركيبية حيث يمكن للمورفيمات الفردية أن تنقل أجزاء متعددة من المعلومات)",
 "屈指": "رَائِد, قِيَادِيّ (يذهب أو يتقدم في المقدمة؛ يظهر الطريق) / قيادة (نشاط القيادة) / فِي المُقَدِّمَة, مُتَصَدِّر (يَحْتَلُّ المَرْكَزَ الأَوَّلَ أَوْ لَدَيْهِ النَّتِيجَةُ الأَعْلَى فِي مُنَافَسَة) / شريحة رصاص, فاصد (شريط رفيع من المعدن يستخدم لفصل خطوط الحروف في الطباعة)\nمثال: ركبنا في السيارة المتقدمة",
 "屈撓": "ثني, حني (عملية ثني شيء ما) / انحراف, انحناء (خاصية الانحناء أو الانحراف) / انحناء, تقوس (حركة تسبب تشكل منحنى)",
 "屈曲": "زَوَر, عِوَج (زَوَّرَ الطائرُ: أَكَلَ حتى امتلأَت حوصَلتُه وارتفعت؛ زَوَّرَ الشىءَ: أَصلَحَه وقوَّمَه وأَتقنه)",
 "屈曲部": "كُوع, مِرْفَق / كُوعٌ",
 "屈服": "رَضُوخ, مُذْعِن (يَمِيلُ إِلَى الِاسْتِسْلَامِ أَوِ التَّنَازُلِ أَوِ المُوَافَقَةِ) / طَيِّع, لَدِن (يَسْتَجيب لِلضَّغْط بِسُهولَة؛ قابِل لِلتَّشَكُّل) / لَيِّن, مُسْتَسْلِم (يميل إلى الاستسلام للحجة أو التأثير أو السيطرة) / إذعان, تنازل (فعل التنازل أو الإذعان)",
 "屈狸": "شَرِه, وُلْفِيرِين ((شَرِهَ) إلى الطعام وغيره، وشَرِهَ عليه يَشْرَهَ شَرَهًا: اشتد حرصُه عليه واشتِهاؤه له؛ فهو شَرِهٌ وشَرْهَانُ، وهي شَرِهة وشَرْهَى)\nمثال: كانت صوفيا شرهة.",
 "屈筋": "عضلة قابضة (عضلة هيكلية يثني انقباضها مفصلاً)",
 "屈託": "قَلِقَ (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء) / قَلَق (شاعر بالقَلَق؛ تَحَرّك/اهتزاز/اضطراب في الوضع الطبيعي للشيء)\nمثال: ليلى قلقة بشأنك. / سأم, ضجر (الشعور بالملل من شيء مضجر)",
 "屈託ない": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ",
 "屈託のない": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ",
 "屈託の無い": "مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ",
 "屈起": "مُتَجَبِّر, مُتَسَلِّط (مُعْتَدّ بِنَفْسِهِ بِشَكْلٍ مُسِيء أَوْ يُمَارِس سُلْطَةً غَيْر مُبَرَّرَة) / مُسَيْطِر, مُهَيْمِن (الأَكْثَر قُوَّةً أَوْ أَهَمِّيَّةً أَوْ تَأْثِيرًا) / مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله)",
 "屈辱": "عَار, خِزْي",
 "屈辱的": "مُذِلّ, مُهِين (يُثِير الشُّعُور بِالنَّقْص أَوِ القُصُور)",
 "届": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "届く": "بَلَغَ / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر.",
 "届け": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "届ける": "نَقَلَ / وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "届け先": "وِجْهَة, وُجْهَة",
 "届け出": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "届け出で": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "届け出る": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "届け出伝染病": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "届け書": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "届け済み": "مُبَلَّغ عَنْه, مُقَرَّر (تم جعله معروفاً أو التحدث عنه؛ خاصة تقديمه في حساب رسمي)\nمثال: رأيه المبلغ عنه (المنقول)",
 "届け物": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي",
 "届出": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "届出伝染病": "مَرَض مُعْدٍ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي.",
 "届書": "وَصَفَ, أَبْلَغَ / أَبْلَغَ (أَكْثَرُ بَلَاغَة) / تَقْرِير, بَلَاغ\nمثال: أبلغ توم تحياتي.",
 "届済み": "مُبَلَّغ عَنْه, مُقَرَّر (تم جعله معروفاً أو التحدث عنه؛ خاصة تقديمه في حساب رسمي)\nمثال: رأيه المبلغ عنه (المنقول)",
 "屋": "دُكَّان, مَتْجَر (حانوت أو محل بيع؛ مصطبة يُقعد عليها) / تَسَوَّقَ, تَبَضَّعَ\nمثال: ذهب إلى الدكان. / مَجْلِس / سَقْف, سَطْح ((سَقَفَ) البيت ونحوه سقفا: عمل له سقفا)\nمثال: نظرت إلى السقف.",
 "屋上": "سطح, سطح المنزل (الجزء العلوي من سطح (عادة ما يكون مسطحاً))",
 "屋内": "بالداخل, في الداخل (داخل مبنى)\nمثال: في الشتاء نلعب في الداخل",
 "屋台": "عَرَبَةُ نَقْل, عَرَبَة / إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما) / إطار, نسيج (الهيكل الأساسي) / إطار نظري, نموذج (وصف افتراضي لكيان أو عملية معقدة)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي / مَجْلِس",
 "屋台店": "مَعْلِف, مُرَاح / بَسْطة",
 "屋台料理": "أَكْلُ الشَّارِع (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)\nمثال: أحب أكل البطيخ.",
 "屋台骨": "إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما) / إطار, نسيج (الهيكل الأساسي) / إطار نظري, نموذج (وصف افتراضي لكيان أو عملية معقدة)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي / الحبل الرئيسي للسارية (الحبل الأمامي الذي يثبت الصاري الرئيسي) / دعامة أساسية, ركيزة (مصدر دعم واستقرار مركزي ومتماسك) / دعامة, ركن أساسي (مؤيد بارز)\nمثال: الإيمان هو ركيزته",
 "屋号": "اسم تجاري, علامة تجارية (اسم يُعطى لمنتج أو خدمة) / اسم فني (الاسم المستعار لممثل)",
 "屋外": "بالخارج, في الخارج (خارج مبنى) / خلاء, عراء (حيث يكون الهواء غير محصور)\nمثال: في الصيف نلعب في الخارج",
 "屋宇": "مَجْلِس",
 "屋宜": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "屋形": "قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب. / نَبِيل (اَلذَّكِيُّ؛ اَلنَّجِيبُ)\nمثال: إنها امرأة نبيلة. / زِمْلِك, خُصّ / قَمَرَة, قَمْرَة",
 "屋形船": "عوامة, منزل عائم (صندل مصمم ومجهز للاستخدام كمسكن)",
 "屋戸": "أَبْوَاب, بَاب",
 "屋敷": "مَسْكَن (الموضع الذي يسكن فيه الإنسان بمعنى يُقيم؛ البَيْت أو الدار)\nمثال: كان دوري كي أنظف المسكن",
 "屋敷町": "حي سكني, مجتمع سكني (حي يعيش فيه الناس؛ تشغله مساكن خاصة في المقام الأول)",
 "屋根": "سَقْف, سَطْح ((سَقَفَ) البيت ونحوه سقفا: عمل له سقفا)\nمثال: نظرت إلى السقف.",
 "屋根屋": "سقّاف, صانع الأسقف (حرفي يركب أو يصلح الأسقف)",
 "屋根板": "لافتة مهنية (لافتة صغيرة خارج مكتب محامٍ أو طبيب مثلاً) / حصى الشاطئ, شينغل (حصى شاطئ خشن من أحجار صغيرة وحصى مصقولة بالماء (أو امتداد من الشاطئ مغطى بهذا الحصى)) / ألواح تسقيف خشبية (مادة بناء تستخدم ككساء أو تسقيف)",
 "屋根窓": "نافذة سقفية (امتداد جملوني مبني من سقف مائل لاستيعاب نافذة عمودية)",
 "屋根裏": "عِلِّيَّة (الغُرْفَة إذا كانت في الطابق الأعلى. استخدام قديم؛ غُرْفَة في أعلى المَنْزِل غالبا ما يكون سقفها منخفضا وتشرف على السَطْح)\nمثال: عادوا إلى العلية.",
 "屋根裏部屋": "عِلِّيَّة (الغُرْفَة إذا كانت في الطابق الأعلى. استخدام قديم؛ غُرْفَة في أعلى المَنْزِل غالبا ما يكون سقفها منخفضا وتشرف على السَطْح)\nمثال: عادوا إلى العلية.",
 "屋比久": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "屋舎": "بِنَاء (ضد هَدْم. ؛ المَبْنَى أو البِنَاية) / مَبْنَى, بِنَاء (كل ما بُنِيَ؛ ما يُبْنى على أرضٍ محاطا بالجُدْرَان ومغطى بسَقْف. (تخصيص))\nمثال: أنا وجدت البناء.",
 "屋部": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "屋鋪": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "屍": "جُثَّة, جُثْمَان",
 "屍体愛好": "اشتهاء الموتى, نيكروفيليا (انجذاب جنسي لا يقاوم نحو الجثث)",
 "屍喰鬼": "غُول",
 "屍姦": "اشتهاء الموتى, نيكروفيليا (انجذاب جنسي لا يقاوم نحو الجثث)",
 "屍毒": "تسمم بتوماين (مصطلح للتسمم الغذائي لم يعد مستخدماً علمياً)",
 "屍肉": "جِيفة, فَطِيسَة",
 "屍食": "أكل الجيف (التغذية على الجثث أو الجيف)",
 "屍食鬼": "غُول",
 "屍鬼": "غُول",
 "屎": "خَرَاء, خِرَاء / خَرِئَ / بَرَّزَ, تَغَوَّطَ (خَرَجَ؛ نَبُه بعد خُمول) / بُرَاز, كَاكَا",
 "屎尿": "إفرازات, فضلات الجسم (نفايات (مثل البول أو العرق ولكن خاصة البراز) يتم تصريفها من الجسم)",
 "屎尿処理": "تصريف مياه الصرف الصحي (التخلص من مياه الصرف الصحي)",
 "屏": "حَائِط, جِدَار / سُور, سور / جِدَار, حيط / سُور / سِيَاج",
 "屏禁": "حَبْس اِنْفِرَادِيّ (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "屏風": "سَاتِر",
 "屑": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر / رغوة شوائب, زَبَد (طبقة من الشوائب أو النباتات التي يمكن أن تتشكل على سطح السائل) / أراذل, حثالة (أشخاص عديمو القيمة)",
 "屑入れ": "سلة أوراق, سلة مهملات (حاوية مفتوحة من الأعلى؛ للأوراق المرمية وغيرها من القمامة)",
 "屑屋": "جامع قمامة, عامل نظافة (رجل موظف لجمع والتخلص من النفايات)",
 "屑屋さん": "جامع قمامة, عامل نظافة (رجل موظف لجمع والتخلص من النفايات)",
 "屑拾い": "جامع القمامة, نبّاش (شخص غير ماهر يجمع الخرق من القمامة العامة كوسيلة للعيش)",
 "屑物": "زُبَالَة, نُفَايَات / سَلُّة الْمُهْمَلَات",
 "屑穴子": "بَطِّيّ المِنْقَار (ذو منقار يشبه منقار البطة)",
 "屑篭": "سلة أوراق, سلة مهملات (حاوية مفتوحة من الأعلى؛ للأوراق المرمية وغيرها من القمامة)",
 "屑籠": "سلة أوراق, سلة مهملات (حاوية مفتوحة من الأعلى؛ للأوراق المرمية وغيرها من القمامة)",
 "屑肉": "سقط, فضلات الذبيحة (الأحشاء والأجزاء المتبقية من الحيوان المذبوح التي غالباً ما تعتبر غير صالحة للأكل للبشر)",
 "屑鉄": "خردة الحديد (حديد يتم صهره مرة أخرى وإعادة تشكيله)",
 "展": "مَعْرِض",
 "展く": "مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "展べる": "فَعَلَ, صَنَعَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / جَعَلَ (صَيَّرَ؛ أَنْشَأَ)\nمثال: ماذا فعل للحمي؟",
 "展延": "تَمَدُّد / تَوَسُّع",
 "展性": "طواعية, قابلية للطرق (خاصية القابلية للتشكيل مادياً؛ خاصية الشيء الذي يمكن تشغيله أو طرقه أو تشكيله دون أن ينكسر)",
 "展望": "مَنْظَر, مَشْهَد\nمثال: あのビルの屋上からの展望はすばらしかった。 — كان المنظر من قمة هذا المبنى رائعا.",
 "展望塔": "برج القيادة (جسر مرتفع على غواصة؛ غالباً ما يستخدم للدخول والخروج) / برج القيادة (غرفة قيادة مدرعة على سفينة حربية)",
