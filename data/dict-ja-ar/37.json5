 "平底船": "مُسَطَّح القَاع (ذو قاع مُسَطَّح ومُسْتَوٍ)",
 "平庸": "مُتَوَسِّط, مُعَدَّل",
 "平手": "رَاحَة, كَفّ",
 "平手うち": "صَفْعَة, لَطْمَة / صَفَعَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين) / لَطَمَ (ضربَ بباطن الكفّ على الوجه أو على شيءٍ آخر؛ أصابَ الشيءَ بقوة أو صدمه)\nمثال: صفع المدرس مؤخرتي.",
 "平手打ち": "صَفْعَة, لَطْمَة / صَفَعَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين) / لَطَمَ (ضربَ بباطن الكفّ على الوجه أو على شيءٍ آخر؛ أصابَ الشيءَ بقوة أو صدمه)\nمثال: صفع المدرس مؤخرتي.",
 "平打": "صَفْعَة, لَطْمَة / صَفَعَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين) / لَطَمَ (ضربَ بباطن الكفّ على الوجه أو على شيءٍ آخر؛ أصابَ الشيءَ بقوة أو صدمه)\nمثال: صفع المدرس مؤخرتي. / شَرِيط",
 "平打ち": "صَفْعَة, لَطْمَة / صَفَعَ (ضرب بشدة على الوجه أو الجفن؛ في السياق المجازي: أوقع الشخص في موقف محرج أو مهين) / لَطَمَ (ضربَ بباطن الكفّ على الوجه أو على شيءٍ آخر؛ أصابَ الشيءَ بقوة أو صدمه)\nمثال: صفع المدرس مؤخرتي. / شَرِيط",
 "平方": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "平方キロメートル": "كيلومتر مربع (مضاعف عشري لوحدة مساحة السطح، المتر المربع، ويساوي 1,000,000 متر مربع)\nمثال: كانت المساحة التي تحيط بها أسوار العديد من المدن الأوروبية في العصور الوسطى حوالي كيلومتر مربع واحد",
 "平方センチメートル": "سنتيمتر مربع (وحدة قياس للمساحة تعادل 1 سنتيمتر طولاً مضروبًا في 1 سنتيمتر عرضًا)",
 "平方ミリメートル": "مليمتر مربع (وحدة قياس للمساحة تعادل 1 مليمتر طولاً مضروبًا في 1 مليمتر عرضًا)",
 "平方メートル": "مِتْرٌ مُرَبَّعٌ (فِي : مُسْتَعْمَلٌ لِتَحْدِيدِ طُولِ مُخْتَلِفِ الأَشْيَاءِ، قَدْرُهُ ذِرَاعٌ وَنِصْفٌ تَقْرِيباً…؛ فِي : هوَ النَادل أو موَظف خدْمة الزَّبائن في المطْعم، يقَال أيْضاً \"مِيتْر\")\nمثال: أنا أقل بقليل من 150 سنتي متر.",
 "平方形": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "平方根": "جَذْر تَرْبِيعِيّ (جِذْرُ ٱلشَّيْءِ هُوَ: أَصْلُهُ؛ في : جذر العدد النوني هو عدد ما إذا رفعناه لقوة ما أعطانا العدد الأصلي)\nمثال: أحسب جذر خمسة بالآلة الحاسبة.",
 "平日": "يَوْم عَمَل (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "平明": "شَفَّاف / وَاضِح",
 "平明達意": "تَلَفَّظَ",
 "平易": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "平易化": "تبسيط, تقليل (عملية تقليل التعقيد) / تبسيط (إزالة التفاصيل الزائدة) / تبسيط (شرح يحذف التفاصيل الزائدة ويقلل من التعقيد)",
 "平時": "وَقْت السَّلَامِ, وَقْت السِّلْمِ (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ)\nمثال: حان وقت الذهاب.",
 "平更": "بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "平服": "زي مدني, ملابس مدنية (الملابس العادية تمييزاً لها عن الزي الرسمي أو ملابس العمل أو الزي الديني)",
 "平松": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "平板": "بَلَاط / مُمِلّ (ما يسبب الضجر والضيقة، غير مثير للاهتمام)\nمثال: نهار اليوم ممل!",
 "平板化": "نبر نغمي (تأكيد ينتج عن الحدة بدلاً من الجهارة)",
 "平林": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "平歯車": "ترس أسطواني, ترس عدل (عجلات تروس تتعشق في نفس المستوى)",
 "平民": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "平民主義": "دِيمُقْرَاطِيَّة (الدِّيْمُقْراطيَّة : شَكْلٌ مِنْ أَشْكالِ السُّلْطَةِ والحُكْمِ يَعودُ فيهِ القَرارُ إلى الشَّعْبِ…؛ المشاركة الجماعيَّة في الحكم عن طريق التمثيل وإِبداء الرأي والمعارضة وغيرها بصورة رسميَّة)\nمثال: عاشت الديمقراطية!",
 "平民的": "شَائِع",
 "平気": "بَارِد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / يُبَرِّد\nمثال: الماء بارد حقا. / جَيِّد (بَيِّن الجَوْدَة) / حَسَنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / مثال: إنها فكرة جيدة.",
 "平気で": "بِبُرُود, بِرَبَاطَة جَأْش (بطريقة هادئة وغير مبالية)\nمثال: دون مزيد من اللغط، استعار باركر سكيناً من رائد لوائه وشحذها على حجر الكاربورندم ببرود كجزار",
 "平気の平左": "غَيْر مُكْتَرِث, لَامُبَالٍ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "平沢": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "平沼": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "平泳ぎ": "سباحة الصدر (طريقة سباحة؛ تُمد الذراعان معاً أمام الرأس وتُسحبان للخلف على الجانبين مصحوبة بركلة الضفدع)",
 "平淡": "أَبْلَه (أَحْمَق؛ غَبِيّ)\nمثال: لا تضحك على الأبله و المعوق.",
 "平準": "مُسْتَوًى / مَرْحَلَة",
 "平準化": "تسوية, مساواة (فعل جعل الأشياء متساوية أو موحدة) / تسوية بالأرض, دك (التدمير الكامل لمبنى) / تسوية الأرض, تمهيد (تغيير مستوى الأرض إلى سطح أفقي أملس أو منحدر بلطف)",
 "平滑化": "نَاعِم, أَمْلَس (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "平滑筋": "عضلة ملساء (نسيج عضلي لا يبدو مخططاً تحت المجهر؛ يتخذ شكل طبقات رقيقة أو صفائح) / عضلة لا إرادية, عضلة ملساء (عضلة تنقبض دون تحكم واعي وتوجد في جدران الأعضاء الداخلية مثل المعدة والأمعاء والمثانة والأوعية الدموية (باستثناء القلب))",
 "平瀬": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "平炉": "فرن المجمرة المكشوفة (فرن لصنع الصلب يوضع فيه الصلب على مجمرة ضحلة وتمر فوقه ألسنة لهب الغاز المحترق والهواء الساخن)",
 "平炉法": "طريقة الموقد المفتوح (عملية لصنع الصلب باستخدام فرن الموقد المفتوح)",
 "平然": "هَادِئ / طَمْأَنَ",
 "平爪": "ظُفْر, ضفر (الجزء المتقرن الميت على طرف الأصبع من الإنْسَان وبعض الحَيْوَانَات) / مِسْمَار, مسمار (وتد صغير من حَدِيد أحد طرفيه مسنون والآخر له رأس يدق في الخشب والجدران وغيرها للتثبيت؛ غِلْظ صغير مخروطي الشكل قد يحدث في أصابع القدم أو في أخْمَص القدم)\nمثال: نبت ظفر أصبع رجلي الكبير.",
 "平爪蟹": "سرطان سابح (سرطان بحري بعض أرجله مفلطحة ومزينة بأهداب للسباحة)",
 "平版": "بلانوغرافيا, طباعة مستوية (عملية الطباعة من سطح لا تكون فيه مناطق الطباعة بارزة ولكنها مستقبلة للحبر (على عكس طاردة الحبر))",
 "平版印刷": "بلانوغرافيا, طباعة مستوية (عملية الطباعة من سطح لا تكون فيه مناطق الطباعة بارزة ولكنها مستقبلة للحبر (على عكس طاردة الحبر))",
 "平生": "عَادِيّ",
 "平田": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اسم مكان (الاسم الذي يُعرف به مكان جغرافي)",
 "平癒": "شِفَاء, تَعَافِي",
 "平目": "فلاوندر (أي من الأسماك المفلطحة البحرية الأوروبية وغير الأوروبية المختلفة) / سمك الهلبوت (لحم أي من الأسماك المفلطحة الأمريكية والأوروبية المختلفة) / ذَيْل, ماسِح الجُوخ (شخص يحاول إرضاء شخص ما من أجل الحصول على ميزة شخصية)",
 "平社員": "مُنْخَفِض الدَّرَجَة",
 "平穏": "رَاكِد, سَاجٍ ((عَنْ جِسْمٍ مَائِيّ) خَالٍ مِنَ الاضْطِرَاب بِسَبَب الأَمْوَاج الكَبِيرَة) / سَاكِن, هَادِئ (غير مضطرب؛ يحافظ على ضبط النفس)",
 "平穏無事": "سِلْمِيّ / مُسَالِم",
 "平等": "مُسَاوَاة / تَسَاوٍ",
 "平等主義": "مساواتية",
 "平米": "مِتْرٌ مُرَبَّعٌ (فِي : مُسْتَعْمَلٌ لِتَحْدِيدِ طُولِ مُخْتَلِفِ الأَشْيَاءِ، قَدْرُهُ ذِرَاعٌ وَنِصْفٌ تَقْرِيباً…؛ فِي : هوَ النَادل أو موَظف خدْمة الزَّبائن في المطْعم، يقَال أيْضاً \"مِيتْر\")\nمثال: أنا أقل بقليل من 150 سنتي متر.",
 "平糠": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "平素": "عَادِيّ / بشكل طبيعي, عادة (في ظل الظروف العادية)\nمثال: عادة كانت تتأخر",
 "平素は": "عَادَةً, الاَكْثِرْ",
 "平素より": "دَائِمًا, أَبَدًا",
 "平織": "نسيج سادة (نمط أساسي للنسيج تتشابك فيه خيوط اللحمة والسدى بالتناوب لإنتاج تأثير رقعة الشطرنج)",
 "平織り": "نسيج سادة (نمط أساسي للنسيج تتشابك فيه خيوط اللحمة والسدى بالتناوب لإنتاج تأثير رقعة الشطرنج)",
 "平胸類": "طيور مسطحة الصدر, نعاميات (طيور لا تطير لها عظام صدر مسطحة تفتقر إلى الجؤجؤ لربط عضلات الطيران: النعام، الشبنم، الإيمو، الموا، الريا، الكيوي، طيور الفيل)",
 "平良": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "平芝": "طبقة عشبية, عشب (طبقة سطحية من الأرض تحتوي على حصير من العشب وجذوره) / رجل, شاب (مصطلح غير رسمي لشاب أو رجل) / لوطي (شخص يمارس اللواط) / ديسموتاز الفائق (إنزيم يحفز تحويل الأكسيد الفائق إلى بيروكسيد الهيدروجين والأكسجين)\nمثال: شاب لطيف",
 "平茸": "فطر المحار (غاريقون صالح للأكل بقبعة رمادية ناعمة ينمو في كتل رفية على الخشب الميت)",
 "平落": "فَطِيرَة",
 "平虫": "دُودَة مُسَطَّحَة",
 "平行": "تَنَاظُر, تَوَازٍ (التشابه بحكم التوافق أو التناظر)",
 "平行世界": "عَالَم مُوَازِي (الذي يعلم؛ متخصص في عِلْم ما وباحث فيه)\nمثال: هو عالم أحيائي.",
 "平行六面体": "متوازي السطوح (منشور قاعدتاه متوازيات أضلاع)",
 "平行四辺形": "مُتَوَازِي أَضْلَاع",
 "平行棒": "المتوازي, قضيبان متوازيان (جهاز جمباز يتكون من قضيبين خشبيين متوازيين مثبتين على قوائم)",
 "平行移動": "تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة.",
 "平衡": "رَصِيد",
 "平衡定数": "ثَابِت التَّوَازُن ((في الكيمياء) نسبة التركيزات عند الوصول إلى التوازن في تفاعل عكسي (عندما يتساوى معدل التفاعل الأمامي مع معدل التفاعل العكسي))",
 "平衡感覚": "توازن, حاسة التوازن (نظام حسي يقع في هياكل الأذن الداخلية يسجل اتجاه الرأس)",
 "平衡錘": "ثقل موازن (وزن يوازن وزناً آخر)",
 "平角": "زَاوِيَة مُسْتَقِيمَة",
 "平賀": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "平身低頭": "سَجَدَ, تَمَلَّقَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: سجد دان نفسه في فندق طريق محلي.",
 "平野": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "平野部": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "平鍋": "مِقْلَاة (وعاء قلي الطعام) / ينتقد بشدَة",
 "平間": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "平静": "هَادِئ / طَمْأَنَ / اتزان, رباطة جأش (ثبات العقل تحت الضغط)\nمثال: تقبل مشاكلهم برباطة جأش وهي باتزان",
 "平面": "مِسْحَاج, مِنْجَرَة / سَحَجَ (سَحَجَهُ يَسْحَجَ سَحْجًا: خَدَشهُ وقَشَرَهُ؛ فهو مَسحُوجٌ، وسَحِيجٌ) / طَائِرَة, طَيَّارَة (مَرْكَبَة كبيرة لها جناحان وتنقل الرُكَّاب والبَضَائِع بالجَوّ. ؛ كل من تَطِير، مؤنث طائر) / دُلْب, صِنَار\nمثال: لقد وصلت الطائرة.",
 "平面交差": "تقاطع سكة حديد, مزلقان (تقاطع سكة حديد وطريق على نفس المستوى؛ تغلق الحواجز الطريق عند مرور القطارات)",
 "平面充填": "تبليط, ترصيع بالفسيفساء (فعل التزيين بالفسيفساء) / رصف فسيفسائي (المجاورة الدقيقة للأشكال في نمط)\nمثال: رصف من الأشكال السداسية",
 "平面図": "مخطط الطابق الأرضي (مسقط أفقي للمستوى الأرضي لمبنى)",
 "平面図形": "شكل ثنائي الأبعاد, شكل مستو (شكل ثنائي الأبعاد)",
 "平面幾何学": "هندسة مستوية (هندسة الأشكال ثنائية الأبعاد)",
 "平面形": "شكل ثنائي الأبعاد, شكل مستو (شكل ثنائي الأبعاد)",
 "平面的": "مُسَطَّح / سَطْحِيّ",
 "平面角": "زاوية مستوية (زاوية مشكلة من خطين مستقيمين (في نفس المستوى))",
 "平飼い": "حُرُّ المَرْعَى, طَلِيق ((عَنِ المَوَاشِي وَالدَّوَاجِنِ) مَسْمُوحٌ لَهُ بِالرَّعْيِ الحُرِّ بَدَلًا مِنَ الحَبْسِ)",
 "年": "صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎. / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي. / شَيْخُوخَة, عُجُوز",
 "年々": "سنوياً, كل سنة (دون تفويت سنة) / سَنَوِيًّا (في السنة؛ كل سنة (عادة مع الإشارة إلى مبلغ من المال يدفع أو يُستلم))\nمثال: يسافرون إلى الصين سنوياً",
 "年々歳々": "سنوياً, كل سنة (دون تفويت سنة) / سَنَوِيًّا (في السنة؛ كل سنة (عادة مع الإشارة إلى مبلغ من المال يدفع أو يُستلم))\nمثال: يسافرون إلى الصين سنوياً",
 "年かさ": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / أرفع مقاماً, أقدم (أكبر سنًا؛ أعلى رتبة؛ أطول في مدة الولاية أو الخدمة) / أَكْبَر سِنّاً, مُسِنّ (شخص أكبر منك سناً) / طالب سنة نهائية (طالب جامعي خلال السنة التي تسبق التخرج)\nمثال: ضابط كبير",
 "年がいく": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي. / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "年がいもない": "غَيْر لَائِق, مُنَافٍ لِلآدَاب (لا يتوافق مع المعايير المقبولة للسلوك اللائق في المجتمع المهذّب)",
 "年がら年中": "على مدار الوقت (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "年が明ける": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "年が行く": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي. / مَرَّرَ, مَرَّ / اِحْتَازَ (بنفس معنى حَازَ، إلا أن احتاز تميل إلى أن الفاعل أراد الحوز) / اِنْقَضَى, مَرَّ / أَهمَلَ / تَغَاضَى / تَخَلَّى / طَريق (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / جَوَاز\nمثال: أسأل عن الطريق.",
 "年ごと": "سنوياً, كل سنة (دون تفويت سنة)\nمثال: يسافرون إلى الصين سنوياً",
 "年ごとに": "سنوياً, كل سنة (دون تفويت سنة) / سَنَوِيًّا (في السنة؛ كل سنة (عادة مع الإشارة إلى مبلغ من المال يدفع أو يُستلم))\nمثال: يسافرون إلى الصين سنوياً",
 "年ごろ": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "年とった": "قَدِيم (شيء مر عليه زمن طويل) / قديم (شيء مر عليه زمن طويل) / كَبِير اَلسِّنّ (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ) / مُسِنّ\nمثال: هذه خدعة قديمة.",
 "年とる": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "年のいった": "قَدِيم, مُخَضْرَم (ماهر من خلال خبرة طويلة) / طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / الأَبّ, الأَكْبَر (يُستخدم للأكبر سنًّا من شخصين يحملان الاسم ذاته؛ خاصة لتمييز الأب عن ابنه)",
 "年の取り方": "شَيْخُوخَة, هَرَم",
 "年の市": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "年の行った": "قَدِيم, مُخَضْرَم (ماهر من خلال خبرة طويلة) / طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / الأَبّ, الأَكْبَر (يُستخدم للأكبر سنًّا من شخصين يحملان الاسم ذاته؛ خاصة لتمييز الأب عن ابنه)",
 "年より": "عجوز, كبير السن (شخص متقدم في السن)",
 "年をとる": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "年を取る": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "年を重ねる": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "年上": "قَدِيم, مُخَضْرَم (ماهر من خلال خبرة طويلة) / طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / الأَبّ, الأَكْبَر (يُستخدم للأكبر سنًّا من شخصين يحملان الاسم ذاته؛ خاصة لتمييز الأب عن ابنه)",
 "年下": "الأَصْغَر, الاِبْن (يُستخدم للأصغر سنًّا من شخصين يحملان الاسم ذاته؛ خاصة لتمييز الابن عن أبيه)",
 "年中": "دَائِمًا, أَبَدًا / فِي السَّنَةِ الثَّانِيَة (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الثَّانِيَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ أَوِ الجَامِعَةِ الأَمْرِيكِيَّةِ)",
 "年中発情期": "على مدار السنة (يعمل أو يستمر طوال العام)\nمثال: منتجع يعمل على مدار السنة",
 "年中組": "طَبَقَة وُسْطَى",
 "年久しく": "في العصور القديمة, قديماً (في الأزمنة القديمة؛ منذ زمن بعيد)\nمثال: اهتمام بما قد حدث قديماً",
 "年代": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "年代測定": "تأريخ (تَسْجِيْل التَارِيْخ)",
 "年代物": "عَتِيق, قَدِيم (قَدِيم، أَثَرِيّ؛ مُحَرَّر، حُرّ)\nمثال: هذا سوق عتيق للبعير.",
 "年代記": "حَوْلِيَّات",
 "年会": "مُؤْتَمَر",
 "年余": "أكثر, مزيد من ((صيغة المقارنة من 'كثير' للمعدود وغير المعدود) محدد كمية يعني أكبر في الحجم أو الكمية أو المدى أو الدرجة)\nمثال: مزيد من الأرض",
 "年別": "سَنَوِيّ",
 "年取った": "قَدِيم (شيء مر عليه زمن طويل) / قديم (شيء مر عليه زمن طويل) / كَبِير اَلسِّنّ (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ) / مُسِنّ\nمثال: هذه خدعة قديمة.",
 "年取る": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "年周視差": "تزيح سنوي, تزيح شمسي المركز (تزيح جرم سماوي باستخدام نقطتين في مدار الأرض حول الشمس كخط أساس)",
 "年型": "نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "年報": "كتاب سنوي (كتاب مرجعي ينشر بانتظام مرة كل عام) / كتاب سنوي (كتاب تنشره سنوياً دفعة التخرج في مدرسة ثانوية أو كلية يحتوي عادة على صور أعضاء هيئة التدريس والطلاب المتخرجين)",
 "年増": "كَهْل / كَهْلَة",
 "年始": "السَّنَة الْجَدِيدَة / أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "年始回り": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "年始状": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "年始着": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "年季": "تدريب مهني, تلمذة مهنية (منصب المتدرب المهني)",
 "年季奉公": "تدريب مهني, تلمذة مهنية (منصب المتدرب المهني)",
 "年寄": "عجوز, كبير السن (شخص متقدم في السن)",
 "年寄り": "عجوز, كبير السن (شخص متقدم في السن)",
 "年寄りくさい": "هَٰكَذَا, كَذَا",
 "年寄り臭い": "هَٰكَذَا, كَذَا",
 "年少": "صَغِير, حَدَث",
 "年少組": "السنة الثالثة جامعية, الصف قبل النهائي (الصف قبل الأخير في المدرسة الثانوية أو الكلية)",
 "年少者": "شَبَاب / شَبَاب, صِبًا / شَابّ",
 "年層": "شريحة عمرية, فئة عمرية (مجموعة من الناس لديهم نفس العمر تقريباً)",
 "年嵩": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / أرفع مقاماً, أقدم (أكبر سنًا؛ أعلى رتبة؛ أطول في مدة الولاية أو الخدمة) / أَكْبَر سِنّاً, مُسِنّ (شخص أكبر منك سناً) / طالب سنة نهائية (طالب جامعي خلال السنة التي تسبق التخرج)\nمثال: ضابط كبير",
 "年年": "سنوياً, كل سنة (دون تفويت سنة) / سَنَوِيًّا (في السنة؛ كل سنة (عادة مع الإشارة إلى مبلغ من المال يدفع أو يُستلم))\nمثال: يسافرون إلى الصين سنوياً",
 "年年歳歳": "سنوياً, كل سنة (دون تفويت سنة) / سَنَوِيًّا (في السنة؛ كل سنة (عادة مع الإشارة إلى مبلغ من المال يدفع أو يُستلم))\nمثال: يسافرون إلى الصين سنوياً",
 "年度": "سَنَة مَالِيَّة (مقدارُ قطع الشمس البروجَ الاثني عشر ، وهي السنة الشمسيَّة، و السَّنَةُ تمامُ اثنتَيْ عشرةَ دَورةً للقمر ، وهي السنة القمرية…)\nمثال: في عمره 24 سنة. / سنة دراسية, عام أكاديمي (الفترة الزمنية من كل عام التي تكون فيها المدرسة مفتوحة والناس يدرسون)",
 "年忘れ": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "年月日": "تَمْرَة, تَمْر / تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت) / مُوَاعَدَة, مَوْعِد / لِقَاء الْحُبّ, مَوْعِد (وجود اثنين أو أكثر معًا، صدفةً أو تدبيرًا) / أَرَّخَ (أَرَخَّ الشيءَ: بالغ فيه؛ وأَرَخَّ العجينَ: أكثر ماءه)\nمثال: ما تاريخ اليوم؟",
 "年期": "تدريب مهني, تلمذة مهنية (منصب المتدرب المهني) / حولي, سنوي (يكمل دورة حياته في غضون عام)\nمثال: حدود من النباتات المزهرة الحولية",
 "年期奉公": "تدريب مهني, تلمذة مهنية (منصب المتدرب المهني)",
 "年期者": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "年末": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "年末商戦": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "年末年始": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "年末調整": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "年末賞与": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "年次": "سَنَوِيّ / صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎.",
 "年歯": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "年毎": "سنوياً, كل سنة (دون تفويت سنة)\nمثال: يسافرون إلى الصين سنوياً",
 "年毎に": "سنوياً, كل سنة (دون تفويت سنة) / سَنَوِيًّا (في السنة؛ كل سنة (عادة مع الإشارة إلى مبلغ من المال يدفع أو يُستلم))\nمثال: يسافرون إلى الصين سنوياً",
 "年波": "شَيْخُوخَة, عُجُوز",
 "年玉": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "年甲斐もない": "غَيْر لَائِق, مُنَافٍ لِلآدَاب (لا يتوافق مع المعايير المقبولة للسلوك اللائق في المجتمع المهذّب)",
 "年甲斐も無い": "غَيْر لَائِق, مُنَافٍ لِلآدَاب (لا يتوافق مع المعايير المقبولة للسلوك اللائق في المجتمع المهذّب)",
 "年百年中": "دَائِمًا, أَبَدًا",
 "年盛り": "أوج العمر, ريعان (وقت النضج عندما تكون القوة والحيوية في ذروتها)",
 "年礼": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "年祭": "عِيد سَنَوِيّ / يُوبِيل",
 "年端": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "年紀": "صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎. / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "年老": "عجوز, كبير السن (شخص متقدم في السن)",
 "年老い": "عجوز, كبير السن (شخص متقدم في السن)",
 "年若": "صَغِير, حَدَث",
 "年若い": "صَغِير, حَدَث",
 "年表": "تَارِيخ (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)",
 "年記": "صَفّ (سَطْر مستقيم؛ مستوى تعليمي)\nمثال: صف كليتي وقلبي‎. / عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "年譜": "حوليات, سجل كرونولوجي (وصف زمني للأحداث في سنوات متتالية)",
 "年貢": "ضريبة الأراضي, ضريبة الأملاك (ضريبة رأسمالية تفرضها البلديات على الممتلكات؛ وتعتمد على القيمة المقدرة للعقار)",
 "年賀": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "年賀状": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "年賀葉書": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "年賀郵便": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "年越し": "31 ديسمبر, ليلة رأس السنة (اليوم الأخير من السنة)",
 "年輩": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي. / مُسِنّ, مُسِنَّة / قَدِيم, مُخَضْرَم (ماهر من خلال خبرة طويلة) / طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / الأَبّ, الأَكْبَر (يُستخدم للأكبر سنًّا من شخصين يحملان الاسم ذاته؛ خاصة لتمييز الأب عن ابنه)",
 "年輪": "حلقة النمو, حلقة سنوية (تشكل سنوي للخشب في النباتات أثناء نموها)",
 "年輪年代学": "علم تحديد أعمار الأشجار (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "年輪年代法": "علم تحديد أعمار الأشجار (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "年配": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي. / مُسِنّ, مُسِنَّة / قَدِيم, مُخَضْرَم (ماهر من خلال خبرة طويلة) / طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / الأَبّ, الأَكْبَر (يُستخدم للأكبر سنًّا من شخصين يحملان الاسم ذاته؛ خاصة لتمييز الأب عن ابنه)",
 "年金": "دخل سنوي, دفعات سنوية (دخل من الاستثمار الرأسمالي يُدفع في سلسلة من المدفوعات المنتظمة)\nمثال: تم إنشاء صندوق تقاعده ليُدفع كدخل سنوي",
 "年金保険料": "قسط التأمين (الدفع مقابل التأمين)",
 "年金受給者": "مُتَقَاعِد",
 "年金基金": "صندوق تقاعد, صندوق معاشات (مؤسسة مالية تجمع مساهمات منتظمة من أصحاب العمل لتوفير دخل التقاعد للموظفين) / صندوق تقاعد (صندوق مخصص لدفع رواتب التقاعد للعمال عند تقاعدهم من الخدمة)",
 "年金生活": "مَعَاش / بَنْسِيُون",
 "年金生活者": "مُتَقَاعِد",
 "年金額": "دخل سنوي, دفعات سنوية (دخل من الاستثمار الرأسمالي يُدفع في سلسلة من المدفوعات المنتظمة)\nمثال: تم إنشاء صندوق تقاعده ليُدفع كدخل سنوي",
 "年鑑": "كتاب سنوي (كتاب مرجعي ينشر بانتظام مرة كل عام) / كتاب سنوي (كتاب تنشره سنوياً دفعة التخرج في مدرسة ثانوية أو كلية يحتوي عادة على صور أعضاء هيئة التدريس والطلاب المتخرجين)",
 "年長": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / أرفع مقاماً, أقدم (أكبر سنًا؛ أعلى رتبة؛ أطول في مدة الولاية أو الخدمة) / أَكْبَر سِنّاً, مُسِنّ (شخص أكبر منك سناً) / طالب سنة نهائية (طالب جامعي خلال السنة التي تسبق التخرج)\nمثال: ضابط كبير / فِي السَّنَةِ الثَّالِثَة (يُسْتَخْدَمُ لِوَصْفِ السَّنَةِ الثَّالِثَةِ أَوْ مَا قَبْلَ الأَخِيرَةِ فِي المَدْرَسَةِ الثَّانَوِيَّةِ أَوِ الجَامِعَةِ الأَمْرِيكِيَّةِ)",
 "年長組": "السنة الأخيرة, الصف النهائي (الصف أو السنة النهائية في المدرسة الثانوية أو الكلية)",
 "年長者": "طَاعِن فِي السِّنّ, مُسِنّ (متقدّم في العمر) / أرفع مقاماً, أقدم (أكبر سنًا؛ أعلى رتبة؛ أطول في مدة الولاية أو الخدمة) / أَكْبَر سِنّاً, مُسِنّ (شخص أكبر منك سناً) / طالب سنة نهائية (طالب جامعي خلال السنة التي تسبق التخرج)\nمثال: ضابط كبير",
