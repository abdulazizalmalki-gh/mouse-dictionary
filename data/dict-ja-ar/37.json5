 "局所時": "توقيت محلي, توقيت مدني (الوقت الرسمي في منطقة محلية (معدل حسب الموقع حول الأرض)؛ يحدد بالقانون أو العرف)",
 "局所的": "مَحَلِّيّ",
 "局所麻酔": "تخدير موضعي (فقدان الإحساس في منطقة صغيرة من الجسم (كما هو الحال عند حقن مخدر موضعي لقلع…)",
 "局留": "بريد عام, تسليم في المكتب (جزء من مكتب البريد يتعامل مع البريد للأشخاص الذين يطلبونه)",
 "局留め": "بريد عام, تسليم في المكتب (جزء من مكتب البريد يتعامل مع البريد للأشخاص الذين يطلبونه)",
 "局番": "سنترال, مقسم هاتف (مكان عمل يعمل كمنشأة اتصالات حيث يمكن توصيل الخطوط من الهواتف معًا للسماح…)",
 "局舎": "مَكْتَب (الموضع الذي يُكتَب عليه. بعكس المَكْتَب الذي يكتب فيه؛ مِنْضَدَة مخصصة للكتابة…)\nمثال: عاد إلى المكتب.",
 "局部": "جُزْء, جُزَء\nمثال: في أي دور تسكن؟ / أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي)",
 "局部床義歯": "طقم أسنان جزئي (طقم أسنان يحل محل سن واحد أو أكثر في قوس الأسنان)",
 "局部的": "مَحَلِّيّ, مُوَجَّه مَحَلِّيًّا (جُعِل محلياً أو وُجِّه نحو النطاق المحلي)",
 "局部麻酔": "تخدير موضعي (فقدان الإحساس في منطقة صغيرة من الجسم (كما هو الحال عند حقن مخدر موضعي لقلع…)",
 "局間回線": "جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر)\nمثال: أين صندوق البريد؟",
 "局限": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "局面": "حَالَة, وَضْع",
 "屁": "حَبَقَ, ضَرَطَ (الحَبِق : ضراط المَعز ، تقول : حبَقت تحْبِق حَبْقاً وحَبِقاً ، وقد تستعمل في…)",
 "屁こき": "إخراج ريح, ريح (منعكس يطرد الغازات المعوية عبر الشرج)",
