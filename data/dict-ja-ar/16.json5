 "ほさき": "لَهَب, شُعْلَة / طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة",
 "ほさつ": "تمريرة حاسمة, مساعدة ((رياضة) فعل تمكين لاعب آخر من القيام بلعبة جيدة) / إعانة, عون (نشاط المساهمة في تلبية حاجة أو تعزيز جهد أو غرض ما)\nمثال: قدم لي مساعدة في الأعمال المنزلية",
 "ほさてき": "داعم, مؤازر (يقدم الدعم أو المساعدة)\nمثال: شبكة عائلية داعمة",
 "ほさにん": "قَيِّم, وصي (شخص تعينه المحكمة لتولي مسؤولية مصالح قاصر أو شخص فاقد للأهلية) / أَمِين المَتْحَف, أَمِين المَكْتَبَة (الوصي على مجموعة مقتنيات (كما في متحف أو مكتبة)) / مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "ほさやく": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
 "ほざ": "الشراع",
 "ほざく": "قَالَ, قال (نَطَقَ بالكلام) / يَتْلُو / قَالَ, يَقُول (نَطَقَ بالكلام)\nمثال: قال زيري وداعا.",
 "ほし": "جَافّ, ناشف (خالٍ من الرطوبة أو الماء؛ قاسٍ أو شديد) / جَفَّ, جَفّ (يَبِسَ)\nمثال: السجق جاف نوعا ما. / إِجَّامَة / نَجْمَة / أسيد, حمض (اسم دارج لثنائي إيثيل أميد حمض الليسرجيك) / نقطة (أقصر الإشارتين التلغرافيتين المستخدمتين في شفرة مورس) / وزارة النقل (الإدارة الفيدرالية الأمريكية التي تؤسس وتنسق برامج النقل الوطنية؛ أنشئت عام 1966) / نقطة (شكل دائري صغير جداً)\nمثال: صف من النقاط / إصابة دقيقة للهدف (إِلحاق الأَذى بالجسم، الجُرْح؛ مَرَضٌ أو عَدْوَى)\nمثال: تعرض زيري لإصابة. / مذنب, مرتكب الجريمة (شخص يرتكب مخالفة)",
 "ほしあかり": "ضوء النجوم (ضوء النجوم)",
 "ほしい": "غَائِب, مَفْقُود (غير موجود أو مفتقد)",
 "ほしいお": "سمك مجفف (سمك محفوظ بشقه وتجفيفه بالهواء دون ملح)",
 "ほしいし": "حَجَر نَيْزَكِيّ (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "ほしいまま": "أَنَانِيّ",
 "ほしいままにする": "تَعَسُّف, طُغْيَان / مَسَبَّة, شَتِيمَة / إِيذَاء جَسَدِيّ / اِنْتِهَاك جَسَدِيّ / أَسَاءَ اِسْتِعْمَالَ / آذَى / أَهَانَ, سَبَّ (شخص يكون لئيم لآخر بالكلام) / اِغْتَصَبَ, اِنْتَهَكَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا) / خَدَعَ, غَشَّ (غَشَّ، مَكَرَ؛ خَادَعَ شخصًا: خدعه بشكل مستمر أو بطريقة خفية)\nمثال: أهان سامي ليلى بقص شعرها.",
 "ほしうお": "سمك مجفف (سمك محفوظ بشقه وتجفيفه بالهواء دون ملح)",
 "ほしうらない": "تَنْجِيم",
 "ほしうらないし": "مُنَجِّم, مُنَجِّمَة",
 "ほしかげ": "ضوء النجوم (ضوء النجوم)",
 "ほしがた": "شكل خماسي, نجمة خماسية (نجمة لها 5 رؤوس؛ تتكون من 5 خطوط مستقيمة بين رؤوس مخمس وتحيط بمخمس آخر)",
 "ほしがたろっかくけい": "نجمة سداسية (مضلع منتظم يتكون من مد كل ضلع من أضلاع مسدس منتظم لتشكيل مثلثين متساويي الأضلاع)",
 "ほしくさ": "تِبْن, جَفِيف (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم. / عشبة الغليون (نبات مائي معمر في أمريكا الشمالية وأيرلندا وجزر هبريدس له أوراق خضراء شفافة في لولب قاعدي وعناقيد كثيفة تشبه الأزرار من الزهور البيضاء الدقيقة)",
 "ほしくさのやま": "بيدر, كومة قش (كدس من القش)",
 "ほしくず": "خيال حالم, سحر رومانسي (صفة رومانسية حالمة أو عاطفية)",
 "ほしくそ": "حَجَر نَيْزَكِيّ (حَجَرَ عليه الأمرَ:مَنَعَه منه ، حجر الشّيء على نفسه:خَصَّها به وقصره عليها؛ الحجْرُ: المَنْعُ مِن التَّصَرُّفِ ، وحَجَرَ عَلَيْهِ القاضِي يَحْجُرُ حَجْراً، إِذا مَنَعَه مِن التَّصَرُّفِ فِي مالِه)\nمثال: عوقب زيري بالحجر.",
 "ほしぐさ": "تِبْن, جَفِيف (تبَنَ الدابة: عَلَفها تبنًا)\nمثال: لم تبن روما في يوم.",
 "ほしぐちどうぶつ": "دودة الفول السوداني, دودة رشفية (دودة بحرية صغيرة غير مقسمة تسحب جزأها الأمامي إلى الجسم عند إزعاجها مما يعطيها مظهر الفول السوداني)",
 "ほしさ": "رَغِبَ ((رَغُبَ) رُغْبًا، ورَغابةً: اتَّسَع وعظُم؛ يقال: (رَغُبَ) الوادي) / رَغْبَة\nمثال: يمكن لتوم البقاء إن رغب.",
 "ほしさま": "إِجَّامَة / نَجْمَة",
 "ほしし": "قَدِيد",
 "ほしじるし": "إِجَّامَة / نَجْمَة / إِجَّامَة, نُجَيْمَة",
 "ほしすもも": "أَجَاص / عَوِينَة / عَوِينَة مُجَفَّفَة / خَوْخ مُجَفَّف / شَذَبَ, قَضَبَ",
 "ほしたら": "فَـ, لِذَا (الحرف العشرون في حروف الهجاء العربية؛ يفيد الترتيب والتعقيب) / إِذًا, فَ / فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "ほしだからがい": "ودعة النمر (ودعة تستخدم صدفتها للزينة)",
 "ほしつ": "رَطَّبَ (يحتوي على الماء أو الرطوبة، غير جاف؛ لين أو طري الملمس بسبب وجود الرطوبة)\nمثال: ملابسي رطبة ومليئة في التراب علي تبديلها.",
 "ほしつざい": "حافظ للرطوبة, مادة مرطبة (أي مادة تضاف إلى مادة أخرى للحفاظ على رطوبتها)",
 "ほしづき": "إِجَّامَة / نَجْمَة",
 "ほしにく": "قَدِيد",
 "ほしになる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "ほしはじろ": "حمرواي",
 "ほしばなもぐら": "خلد نجمي الأنف (خلد برمائي من شرق أمريكا الشمالية له مجسات لحمية وردية حول الأنف)",
 "ほしぶどう": "زَبِيب, زَبِيبَة (ما قدد أو جفف من العِنَب وقد يقال لغيره من النبات المقدد إذا كان صغير الحجم؛ السم في فَمّ الحَيَّة)\nمثال: الزبيب هو عنب مجفف.",
 "ほしぼし": "سورة النجم",
 "ほしむくどり": "زرزور شائع (طائر اجتماعي ذو ريش بلمعان معدني داكن؛ يبني أعشاشاً حول المساكن والهياكل الأخرى؛ متوطن في جميع أنحاء العالم)",
 "ほしむし": "دودة الفول السوداني, دودة رشفية (دودة بحرية صغيرة غير مقسمة تسحب جزأها الأمامي إلى الجسم عند إزعاجها مما يعطيها مظهر الفول السوداني)",
 "ほしゃく": "كَفَالَة",
 "ほしゃくきん": "كَفَالَة",
 "ほしゅ": "صِيَانَة / سِيَاسَة مُحَافِظَة, فِكْر مُحَافِظ (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة. / ملتقط (مركز في فريق البيسبول للاعب الذي يتمركز خلف القاعدة الرئيسية ويلتقط الكرات التي يرميها الرامي) / ماسك, ملتقط ((في البيسبول) الشخص الذي يلعب في مركز الماسك خلف الضارب)",
 "ほしゅう": "أَصْلَحَ / تَصْلِيح / إِصْلَاح / تَرْمِيم (التَّرْميم :إِصْلَاح البناء المتصدِّع أو المتداعي؛ عملية الإصلاح نفسها) / مَرَمَّة / أَسْر, سَبْي (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: إن توم لا يملك أسرة. / صِيَانَة",
 "ほしゅうごう": "عُمْدَة",
 "ほしゅけい": "مُحَافِظ",
 "ほしゅしゅぎ": "سِيَاسَة مُحَافِظَة, فِكْر مُحَافِظ (بمعنى رعى الغنم وقادها؛ بمعنى قاد الناس وحَكَمَهم باللين والحكمة لا بالغصب والقهر)\nمثال: عاد إلى السياسة.",
 "ほしゅせい": "صَلَاحِيَّة الخِدْمَة, قَابِلِيَّة الاسْتِخْدَام (صفة القدرة على تقديم خدمة جيدة)",
 "ほしゅてき": "مُحَافِظ",
 "ほしゅとう": "حزب المحافظين (حزب سياسي (خاصة في بريطانيا العظمى أو أستراليا) يؤمن بأهمية الاقتصاد الرأسمالي مع الملكية الخاصة بدلاً من سيطرة الدولة)",
 "ほしゅは": "مُحَافِظ",
 "ほしょう": "تعويض (فعل التعويض عن خدمة أو خسارة أو إصابة) / تعويض (شيء (مثل المال) يُعطى أو يُستلم كدفعة أو تعويض (كما هو الحال عن خدمة أو خسارة أو إصابة)) / تعويض ((في الطب النفسي) آلية دفاع تخفي عيوبك غير المرغوب فيها عن طريق المبالغة في السلوكيات المرغوبة) / حاجز مرجاني (شعاب مرجانية طويلة بالقرب من الشاطئ وموازية له) / ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء. / ضَمَان (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء. / حارِس, خَفِير (شخص يتم توظيفه للمراقبة تحسباً لحدث متوقع)",
 "ほしょうがいしゃ": "كَافِل",
 "ほしょうきん": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي. / إصلاح الضرر, تعويض (شيء يتم فعله أو دفعه تكفيراً عن خطأ) / إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / تعويضات الحرب ((عادة بصيغة الجمع) تعويض يفرضه المنتصرون على دولة مهزومة) / إصلاح, جبر الضرر (تعويض (مُعطى أو مُستلم) عن إهانة أو إصابة)\nمثال: كيف يمكنني التكفير عن خطئي",
 "ほしょうぎゅうにゅう": "حليب معتمد (حليب من مصانع ألبان تخضع لرقابة لجنة طبية معتمدة للحليب)",
 "ほしょうこぎって": "شيك مصدق (شيك يحتوي على تصديق بأن الشخص الذي أصدر الشيك لديه أموال كافية في الوديعة لتغطية الدفع)",
 "ほしょうしょ": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمَان (مَصْدَرُ ضَمِنَ؛ كَفَالَة)\nمثال: لا أستطيع ضمان أي شيء.",
 "ほしょうそち": "احتراز, تدبير وقائي (إجراء وقائي لدرء خطر وشيك أو ضرر أو إصابة) / أمان, تصريح مرور آمن (وثيقة أو مرافقة توفر ممراً آمناً عبر منطقة خاصة في وقت الحرب)\nمثال: وضع كيس ثلج على الإصابة كإجراء وقائي",
 "ほしょうつき": "ضَمَان, ضَمَانَة (مَصْدَرُ ضَمِنَ؛ كَفَالَة) / ضَمِنَ\nمثال: لا أستطيع ضمان أي شيء.",
 "ほしょうにん": "كَافِل",
 "ほしょく": "افتراس (فعل الافتراس من قبل مفترس يقتل الفريسة ويأكلها) / إغارة, نهب (فعل النهب والسلب والإغارة) / لون مكمل (أحد لونين لونيين يعطيان عند مزجهما معاً اللون الأبيض (في حالة الأضواء) أو الرمادي (في حالة الأصباغ))\nمثال: الأصفر والأزرق لونان مكملان / تسمية, تعيين (فعل وضع شخص في منصب غير انتخابي) / تخصيص, تعيين (فعل توزيع شيء ما على أماكن أو أشخاص معينين) / تكليف, مهمة (واجب تكلف بأدائه (خاصة في القوات المسلحة)) / تكليف, واجب منزلي (مشروع تم تكليفك بالقيام به (كما من قبل مدرب أو معلم))\nمثال: كان يجب الموافقة على التعيين من قبل اللجنة بأكملها",
 "ほしょくしゃ": "مُفْتَرِس, ضَارٍ",
 "ほしをおとす": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته.",
 "ほしん": "دفاع عن النفس (فعل الدفاع عن نفسك)",
 "ほしんだいいち": "دفاع عن النفس (فعل الدفاع عن نفسك)",
 "ほじ": "حِفْظ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ) / ذَاكِرَة / أُسْر (الأَسْر : شدة الخَلْق؛ الأَسْر : القيدُ)\nمثال: حفظ رقم هاتفها.",
 "ほじくりかえす": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "ほじくりだす": "عتلة, مِخْل (رافعة حديدية ثقيلة أحد طرفيها مُشَكَّل كإسفين)",
 "ほじくり出す": "عتلة, مِخْل (رافعة حديدية ثقيلة أحد طرفيها مُشَكَّل كإسفين)",
 "ほじくり返す": "فضح, كشف القناع (فضح محتال أو مخادع)\nمثال: نشر فضيحة عن الرشوة والفساد في حكومة المدينة",
 "ほじくる": "مِعْوَل, فَأْس (الفأس الكبيرة العظيمة، تستخدم في الزراعة والصناعة)",
 "ほじし": "قَدِيد",
 "ほじしゃ": "حامل (جهاز حمل) / حامل (الشخص الذي بحوزته شيك أو كمبيالة أو سند أو وثيقة ملكية مظهرة له أو لمن يحملها) / حائز, حامل (شخص يحمل أو يحوز شيئاً ما)\nمثال: حامل مناشف",
 "ほじゅう": "تجديد موارد",
 "ほじゅうしょ": "وَجِيز, قَصِير / وَجِيز, مُوجَز",
 "ほじゅうへい": "جندي احتياط (عضو في قوات الاحتياط العسكرية)",
 "ほじょ": "مُسَاعَدَة, إِمْدَاد / إِعَانَة مَالِيَّة / اكتشاف, رصد (فعل اكتشاف شيء ما؛ أو ملاحظة شيء ما) / تبقيع, تلطيخ (فعل تبقيع أو تلطيخ شيء ما)",
 "ほじょいん": "مُسَاعِد, مُسَاعِدَة (مُعَاوِن، مُسَانِد، من يقوم بالمُسَاعَدَة؛ بمعنى مُفِيد، يقال هذا عامل مساعد وهذه مادة مساعدة)\nمثال: علي مساعدة ماري.",
