 "まねっこ": "قَلَّدَ",
 "まねる": "تَقْلِيدِيّ (يُشكِّل تقليداً أو محاكاة)",
 "まのあたり": "شَخْصِيًّا",
 "まのいい": "مَحْظُوظ, جَالِب للحَظّ",
 "まのて": "إمساك, قبضة (فعل الإمساك)\nمثال: أرخى قبضته عن ذراعي",
 "まのぬけた": "عَبِيط",
 "まのび": "بطء, تأنٍ (معدل يظهر غياب العجلة أو التسرع) / انحلال, فجور (انغماس منحل في الملذات الحسية)\nمثال: كان هناك الكثير من التخلخل في عجلة القيادة",
 "まのびした": "بَطِيء",
 "まのよい": "مَحْظُوظ, جَالِب للحَظّ",
 "まばしら": "فحل",
 "まばたき": "رَمَشَ (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء…)",
 "まばたく": "لَأْلَأَ (لَمَعَ، أَشْرَقَ؛ (استخدام مجازي) اغْرَوْرَقَتْ الدُّمُوع) / رَمَشَ (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء…)",
 "まばゆい": "مُبْهِر, وَهَّاج (يَلْمَع بِشِدَّة وقُوَّة)",
 "まばら": "ضَئِيل",
 "まばん": "قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين…)\nمثال: الكلاب تنبح، والقافلة تسير.",
 "まひ": "شَلَل, فَالَج / فتور, لامبالاة (سمة الافتقار للحماس أو الاهتمام بالأشياء عموماً) / توقف, جمود (انقطاع النشاط الطبيعي)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "まひがし": "الشَّرْق (نقطة البوصلة الأصلية التي تكون عند 90 درجة)",
 "まひょ": "لِـ, هَيَّا (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد…) / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "まひる": "ظهر, ظهيرة (منتصف اليوم)",
 "まひるのゆめ": "حُلْم يَقَظَة (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "まび": "يَوْم عُطْلَة (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل…)\nمثال: طقس اليوم جميل.",
 "まびき": "تقليم (عملية تشذيب النبات) / قتل الرضيع, وأد (قتل طفل رضيع)",
 "まびく": "مرفوض, منبوذ (الشخص أو الشيء الذي يتم رفضه أو تنحيته جانباً لكونه أقل جودة) / قَلَّلَ",
 "まびさし": "حافة أمامية, قناع (حافة تبرز إلى الأمام لتظليل العينين)\nمثال: سحب حافة قبعته لأسفل ومشى بجهد للأمام",
 "まふ": "كَتَّان",
 "まふつのかがみ": "مِرْآة, مراية (أداة لها القابلية على عكس الضوء بطريقة تحافظ على الكثير من صفاتهما الأصلية قبل…)\nمثال: أنظر في المرآة!",
 "まふゆ": "عز الشتاء, منتصف الشتاء (وسط فصل الشتاء)",
 "まぶ": "عَاشِق, عَاشِقَة / نَفَق",
 "まぶい": "فَاتِن, قَشِيب / رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة.",
 "まぶし": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا. / كَمين",
 "まぶしい": "مُبْهِر, وَهَّاج (يَلْمَع بِشِدَّة وقُوَّة)",
 "まぶす": "غِطَاء",
 "まぶた": "جَفْن (مَنَعَ نَفْسَهُ عَنْ كُلِّ مَكْرُوهٍ؛ وَضَعَ الطَّعَامَ فِي الجَفْنَةِ)",
 "まぶる": "غِطَاء",
 "まぶれ": "مُبَقَّع, مُلَطَّخ (موسوم أو مصبوغ أو متغير اللون بمادة غريبة)\nمثال: مفرش طاولة ملطخ بشدة",
 "まほ": "مع الريح (مع الريح؛ في اتجاه هبوب الريح)\nمثال: طاروا مع الريح / مُمْتَاز, فَاخِر / سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته)\nمثال: علاج طبي مناسب / صَرِيح, مُسْتَقِيم",
 "まほう": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو…)\nمثال: هذا هو سحر الجزائر.",
 "まほうし": "سَاحِر",
 "まほうじん": "مربع سحري (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ)\nمثال: لا توجد مثلثات مربعة.",
 "まほうじんぎょうれつ": "مربع سحري (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ)\nمثال: لا توجد مثلثات مربعة.",
 "まほうすう": "عَدَد سِحْرِيّ (العدد الذري لنواة ذرية مستقرة للغاية ومترابطة بقوة: 2، 8، 20، 28، 50، 82 أو 126)",
 "まほうつかい": "سَاحِر",
 "まほうづえ": "عَصًا, مِخْصَرَة (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "まほうてき": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو…)\nمثال: هذا هو سحر الجزائر.",
 "まほうのじゅうたん": "بِسَاط سِحْرِيّ, بِسَاط الرِّيح",
 "まほうのつえ": "عَصًا, مِخْصَرَة (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "まほうびん": "ترمس (قارورة مفرغة تحفظ درجة حرارة المشروبات الساخنة أو الباردة)",
 "まぼ": "مع الريح (مع الريح؛ في اتجاه هبوب الريح)\nمثال: طاروا مع الريح",
 "まぼしい": "مُبْهِر, وَهَّاج (يَلْمَع بِشِدَّة وقُوَّة)",
 "まぼる": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء…)",
 "まぼろし": "سَرَاب, شَبَح / سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا)",
 "まま": "كَـ, مِثْل\nمثال: قصدته مثل نكتة. / مَعَ (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي. / أَحْيَانًا / طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "ままいも": "أخت غير شقيقة (أخت تشترك معك في أحد الوالدين فقط)",
 "ままこ": "ابن الزوج, ابن الزوجة (طفل زوجك من زواج سابق)",
 "ままちち": "زَوْجُ ٱلْأُمّ, أَب رَبِيب (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)\nمثال: زوجة ماري طبيبة.",
 "ままっこ": "ابن الزوج, ابن الزوجة (طفل زوجك من زواج سابق)",
 "ままに": "كَـ, مِثْل\nمثال: قصدته مثل نكتة.",
 "ままねえ": "أخت غير شقيقة (أخت تشترك معك في أحد الوالدين فقط)",
 "ままはは": "زَوْجَةُ الْأَب",
 "ままむすこ": "رَبِيب",
 "ままむすめ": "رَبِيبَة",
 "ままよ": "أَيّ, أَيَّمَا (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "まま娘": "رَبِيبَة",
 "まま息子": "رَبِيب",
 "まみ": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا. / غُرَيْر / كلب الراكون (كلب بري صغير من شرق آسيا له علامات وجه تشبه علامات الراكون)",
 "まみえ": "حَاجِب",
 "まみえる": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ)\nمثال: لقد التقى بماري. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه. / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان…)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "まみず": "مَاء عَذْب (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما…)\nمثال: أنا أشرب الماء.",
 "まみずくらげ": "زَهْرَة خَوْخ",
 "まみちゃじない": "أَشْيَب, شَائِب (يُظهِر علامات الشيخوخة خاصّة الشعر الأبيض أو الرماديّ)",
 "まみなみ": "الجَنُوب (نقطة البوصلة الأصلية التي تكون عند 180 درجة)",
 "まみれ": "مُبَقَّع, مُلَطَّخ (موسوم أو مصبوغ أو متغير اللون بمادة غريبة)\nمثال: مفرش طاولة ملطخ بشدة",
 "まむかい": "وَجْهًا لِوَجْه",
 "まむき": "جَدِّي, جَادّ",
 "まむぎ": "قَمْح, حِنْطَة",
 "まむこう": "وَجْهًا لِوَجْه",
 "まむし": "أفعى الحفر (أفاعي العالم الجديد ذات أنياب مجوفة وحفرة حساسة للحرارة على كل جانب من الرأس)",
 "まめ": "بقول, قرن (قرن البذور لنبات بقولي (مثل البازلاء أو الفاصولياء أو العدس)) / صويا, فول الصويا (أكثر الخضراوات المعروفة احتواءً على البروتين؛ تستخدم ثمرة نبات الصويا في مجموعة…) / أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية) / كُلْيَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: في أي كلية تدرس؟ / بَطْبَاطَة, نَفْطَة / مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح. / صَحِيح, سَلِيم\nمثال: لازمك تعمل حجر صحي. / وَفِيّ, مُخْلِص\nمثال: هو غبي وغير أمين.",
 "まめあぶら": "زيت فول الصويا (زيت مستخرج من فول الصويا)",
 "まめがらちゃ": "أَزْرَق رَمَادِيّ (أزرق مع مسحة رمادية)",
 "まめこがね": "خنفساء يابانية (خنفساء صغيرة خضراء وبنية معدنية موطنها شرق آسيا؛ آفة نباتية خطيرة في أمريكا…)",
 "まめざくら": "كرز فوجي (شجرة كرز يابانية شجيرية لها أزهار وردية شاحبة)",
 "まめじか": "طرغولية",
 "まめぞうむし": "سوسة الفاصوليا (تعيش اليرقات وتتغذى في الفاصوليا النامية أو المخزنة)",
 "まめちしき": "تفاهة, شيء تافه (شيء قليل الأهمية)",
 "まめつ": "تشويه, طمس المعالم (عملية إتلاف مظهر أو سطح شيء ما)\nمثال: تشويه فسيفساء إيطالية أثناء الغزو التركي",
 "まめつぶ": "فَاصُولِيَا, لُوبِيَا",
 "まめまめしい": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "まめやか": "مُخْلِص (الشخص الذي يفي ولا يخون)\nمثال: الغيرة لا تجعل أحد مخلص",
 "まめりょう": "بقول, قرن (قرن البذور لنبات بقولي (مثل البازلاء أو الفاصولياء أو العدس))",
 "まめるい": "نَبْض, نَبْضَة",
 "まめん": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ)\nمثال: هناك ثقوب على السطح.",
 "まめテスト": "اِخْتِبَار (اختبر الشّيء:خبره)\nمثال: تم اختبار زيري.",
 "まもう": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "まもない": "عَدْل (عَدْل)\nمثال: هل يعاملون بالعدل",
 "まもなく": "قَرِيبًا, سَرْعَانَ مَا",
 "まもの": "شَيْطَان, شيطان ((في الأديان الإبراهيمية) الرُّوح الشِّرِّير الَّذِي يَرْمِي بِكَ لِلتَّهْلُكَةِ…)\nمثال: العجلة من الشيطان.",
 "まもり": "حِمَايَة / بروفيدنس / تَمِيمَة, أُخْذَة",
 "まもりて": "وَلِي أَمْر, حَافِظ (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش. / سَاعَة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا…)\nمثال: درست لمدة ساعة.",
 "まもりびと": "حَارِس\nمثال: كان لدى سامي حرس شخصي.",
 "まもりふだ": "طِلَسْم, طِلَّسْم",
 "まもる": "حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى. / اِحْتَفَظَ, أَبْقَى",
 "まや": "حَظِيرَة, اِسْطَبْل\nمثال: الشاحنة غير ثابتة.",
 "まやかし": "خِدَاع, خَدْع",
 "まやかす": "غَشَّ",
 "まやく": "مُخَدِّر",
 "まやくおう": "بارون مخدرات, زعيم عصابة مخدرات (شخص يسيطر على منظمة تتعامل في المخدرات غير المشروعة)",
 "まやくかんじゃ": "مُدْمِن, حَشَّاش",
 "まやくこっか": "دولة مخدرات (منطقة استولت عليها وسيطرت عليها وأفسدتها عصابات المخدرات وحيث يكون إنفاذ…)",
 "まやくじょうしゅう": "إدمان المخدرات (إدمان على مخدر (خاصة المخدرات الأفيونية))",
 "まやくじょうようしゃ": "متعاطي مخدرات (شخص يتعاطى المخدرات)",
 "まやくそしき": "عصابة مخدرات, كارتل مخدرات (كارتل غير مشروع تم تشكيله للسيطرة على إنتاج وتوزيع المخدرات)\nمثال: تقوم عصابات المخدرات أحياناً بتمويل المنظمات الإرهابية",
 "まやくちゅうどく": "إدمان المخدرات (إدمان على مخدر (خاصة المخدرات الأفيونية))",
 "まやくちゅうどくしゃ": "مُدْمِن, حَشَّاش",
 "まやくとりしまりきょく": "إدارة مكافحة المخدرات (وكالة فيدرالية مسؤولة عن تطبيق القوانين واللوائح التي تحكم المخدرات والمواد…)",
 "まやくとりひき": "اتجار بالمخدرات (الاتجار في المخدرات غير القانونية)",
 "まやくみつばい": "اتجار بالمخدرات (الاتجار في المخدرات غير القانونية)",
 "まやくみつゆ": "اتجار بالمخدرات (الاتجار في المخدرات غير القانونية)",
 "まやくカルテル": "عصابة مخدرات, كارتل مخدرات (كارتل غير مشروع تم تشكيله للسيطرة على إنتاج وتوزيع المخدرات)\nمثال: تقوم عصابات المخدرات أحياناً بتمويل المنظمات الإرهابية",
 "まやくテロ": "إرهاب المخدرات (تمويل الأنشطة الإرهابية عن طريق المشاركة في تجارة المخدرات)",
 "まゆ": "حَاجِب / شَرْنَقَة (غشاء واق من خيوط دقيقة تنسجه بعض الحشرات حولها كدودة القز، لتحتمي به في طَوْر…)",
 "まゆげ": "حَاجِب",
 "まゆずみ": "قلم حواجب (مكياج يوفره قلم تجميلي يستخدم لتغميق الحواجب)",
 "まゆだま": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "まゆつば": "قصة خيالية, قصة ملفقة (قصة مثيرة للاهتمام ولكنها غير قابلة للتصديق إلى حد كبير؛ تُروى غالباً كعذر)",
 "まゆつばもの": "قصة خيالية, قصة ملفقة (قصة مثيرة للاهتمام ولكنها غير قابلة للتصديق إلى حد كبير؛ تُروى غالباً كعذر)",
 "まゆづき": "هِلَال",
 "まゆねをよせる": "عُبُوسة, عُبُوس",
 "まゆひとつうごかさない": "الحصى الحية, ليثوبس",
 "まゆをくもらす": "عَبَسَ",
 "まゆをしかめる": "عَبَسَ",
 "まゆをひそめる": "عَبَسَ",
 "まゆをよせる": "عُبُوسة, عُبُوس",
 "まゆペンシル": "قلم حواجب (مكياج يوفره قلم تجميلي يستخدم لتغميق الحواجب)",
 "まゆ毛": "حَاجِب",
 "まよい": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد)\nمثال: كان هناك تردد في كلامه / هَلْوَسَة, وَهْم",
 "まよいぼし": "كَوْكَب سَيَّار, كَوْكَب ((قديمًا) جرم سماوي من البلازما مضيئ بذاته متماسك بفعل الجاذبية؛ جرم سماوي يدور…)\nمثال: كوكب الأرض جميل.",
 "まよう": "اُغْرُب عَن وَجْهِي!, إِبْتَعِد عَنِّي! / تمايل, رفرفة (فعل التحرك ذهاباً وإياباً)\nمثال: كان هناك تردد في كلامه",
 "まよえる": "ضَائِع",
 "まよけ": "طِلَسْم, طِلَّسْم",
 "まよこ": "جَانِب",
 "まよなか": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل\nمثال: 私たちは真夜中にロンドンに着いた。 — وصلنا إلى لندن عند منتصف الليل.",
 "まよわす": "لُغْز, مُعْضِلَة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة…)\nمثال: لم يحل أبدا لغز وفاتها.",
 "まら": "مارا (قارض يشبه الأرنب يعيش في سهول البامبا في الأرجنتين) / قَضِيب, ذَكَر",
 "まり": "ضَرَّة",
 "まりょく": "قدرة سحرية (القدرة على أداء السحر)",
 "まる": "دَوَائِر تَحْتَ ٱلْعَيْنَيْن (بمعنى الشكل الذي لا بداية له ولا نهاية بشكل قوس مستمر؛ بمعنى الهيئة أو الجهة…) / نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه. / دَوَائِر تَحْتَ ٱلْعَيْنَيْن (بمعنى الشكل الذي لا بداية له ولا نهاية بشكل قوس مستمر؛ بمعنى الهيئة أو الجهة…) / كَافَّة, تَمَام / نُقُود, مَال\nمثال: أريد بعض المال. / سلحفاة لينة الصدفة (سلحفاة مائية شرهة ذات صدفة مرنة مسطحة مغطاة بجلد جلدي؛ يمكن أن تسبب عضات مؤلمة) / أَفْرَزَ",
 "まるあんき": "تلقين, حفظ عن ظهر قلب (الحفظ عن طريق التكرار)",
 "まるい": "مُسْتَدِير, مُدَوَّر (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ)\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / مُنْثَنٍ / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين)",
 "まるいし": "جُلْمُود, صَخْرَة كَبِيرَة (كتلة صخرية كبيرة ملساء منفصلة عن مكان نشأتها)",
 "まるいす": "مِقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "まるおあまがさ": "كرايت مخطط (كرايت بطيء الحركة مخطط بالأسود والأصفر)",
 "まるおび": "قطعة واحدة ((للملابس) يتكون من أو مصمم كقطعة واحدة كاملة)\nمثال: رداء من قطعة واحدة",
 "まるかっこ": "أَقْوَاس, قَوْس",
 "まるがかえ": "رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر.",
 "まるがた": "شكل مستدير (شكل منحني وبدون زوايا حادة)",
 "まるがっこ": "أَقْوَاس, قَوْس",
 "まるき": "خَشَبَة",
 "まるきぶね": "بيروج, زورق محفور (كانو مصنوع عن طريق حفر وتشكيل جذع شجرة كبير)",
 "まるきり": "تَمَامًا",
 "まるく": "وُدِّيًّا (بطريقة ودية)\nمثال: انفصلا ودياً",
 "まるくなる": "برخامة, بنعومة (بطريقة رخيمة) / تشاور سريع ((غير رسمي) مؤتمر خاص سريع)\nمثال: تجمهر لنساء خائفات",
 "まるごし": "أَعْزَل",
 "まるごと": "بِرُمَّتِهِ, بِكُلِّيَّتِهِ",
 "まるざい": "خَشَبَة",
 "まるぞこ": "مُسْتَدِير القَاع (له قاع مستدير الشكل)",
 "まるた": "خَشَبَة / ديس (سمكة مياه عذبة أوروبية صغيرة ذات جسم نحيل أزرق مخضر)",
 "まるたあしば": "سِقَالَات, سِقَالَة",
 "まるたごや": "كوخ جذعي (كوخ مبني من جذوع الأشجار)",
 "まるたて": "تُرْس ((تَرَّسَ): توقى بالترس)",
 "まるたんぼう": "خَشَبَة",
 "まるだし": "مَكْشُوف, مُعَرَّض",
 "まるっきし": "تَمَامًا",
 "まるっきり": "تَمَامًا",
 "まるっこい": "مُسْتَدِير, مُدَوَّر (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "まるっと": "بِرُمَّتِهِ, بِكُلِّيَّتِهِ",
 "まるつぶれ": "اِنْهَار\nمثال: يوشك الجسر على الانهيار.",
 "まるで": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له. / أبداً / حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه…)\nمثال: هو اغضبني حقا .",
 "まるといし": "مِجْلَخَة, جَلَّاخَة",
 "まるどり": "اِحْتَكَرَ",
 "まるのこ": "مِنْشَار دَائِرِيّ",
 "まるのまま": "بِرُمَّتِهِ, بِكُلِّيَّتِهِ",
 "まるのみ": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / تجويف, نقر (فعل النقر أو التجويف بأداة)",
 "まるはなばち": "طَنَّانَة, نَحْلَة",
 "まるばあさがお": "أثمان أرجواني, مجد الصباح الشائع (عشب متسلق حولي استوائي شامل بزهور قمعية الشكل زرقاء أو أرجوانية أو وردية أو…)",
 "まるばしら": "عَمُود",
 "まるばつ": "صح أو خطأ (يقدم سلسلة من العبارات التي يجب الحكم على كل منها بأنها صحيحة أو خاطئة)\nمثال: اختبار صح أو خطأ",
 "まるばつゲーム": "إكس أو, تيك تاك تو (لعبة يضع فيها لاعبان بالتناوب صلباناً ودوائر في أحد أقسام شبكة مربعة من تسع…)",
 "まるばつテスト": "صح أو خطأ (يقدم سلسلة من العبارات التي يجب الحكم على كل منها بأنها صحيحة أو خاطئة)\nمثال: اختبار صح أو خطأ",
 "まるひ": "سَرِّيّ, خُصُوصِيّ",
 "まるひしりょう": "بَالِغ السِّرِّيَّة (ذو أعلى درجات التصنيف السرّيّ)",
 "まるぶしゅかん": "تُرُنْج",
 "まるぼう": "جَرِيمة مُنَظَّمة",
 "まるぽちゃ": "سمين",
 "まるまっちい": "سمين",
 "まるまど": "نافذة مدورة (نافذة تؤدي إلى القوقعة)",
 "まるまま": "بِرُمَّتِهِ, بِكُلِّيَّتِهِ",
 "まるまる": "سمين / بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً / أَكِيد\nمثال: لديك بعض الكتب.",
 "まるまるとふとった": "بَدِين جِدًّا, سَمِين مُفْرِطًا (مُفْرِط فِي السِّمْنَة والبَدَانَة)",
 "まるまるふとった": "بَدِين جِدًّا, سَمِين مُفْرِطًا (مُفْرِط فِي السِّمْنَة والبَدَانَة)",
 "まるみ": "استدارة, امتلاء (الخاصية الجسدية المتمثلة في الامتلاء والاستدارة)\nمثال: أعطانا النتائج بأرقام تقريبية / انتشاء, نشوة (المرح واللطف، كما من خلال تأثيرات الكحول أو الماريجوانا)\nمثال: رقة الضوء والظلال التي لا يمكن تحقيقها في الرخام",
 "まるみをおびた": "شِبْهُ مُسْتَدِير (مستدير إلى حدٍّ ما في المظهر أو الشكل)",
 "まるめ": "تَقْرِيب",
 "まるめこむ": "تَمَلَّقَ",
 "まるめごさ": "تقريب, خطأ التقريب ((رياضيات) خطأ في الحساب ينتج عن تقريب الأرقام إلى عدد مناسب من الخانات العشرية)\nمثال: كان الخطأ في الحساب يعزى إلى التقريب",
 "まるめる": "أَغْرَى, أَغْوَى / حَلَقَ (أصاب حَلْقه أو ضربه في حلقه؛ أزال شعر رأسه أو ذقنه كله بالمُوسَى)\nمثال: حلق زيري لحيته.",
 "まるやね": "قُبَّة",
 "まるゆう": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب)",
 "まるカッコ": "أَقْوَاس, قَوْس",
 "まるシー": "حُقُوقُ النَّشْر, حُقُوقُ التَّأْلِيفِ وَٱلنَّشْر (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حق)\nمثال: الحقوق إنسانية.",
 "まるノコ": "مِنْشَار دَائِرِيّ",
 "まれ": "نَادِر",
 "まれにみる": "نَادِر",
 "まれに見る": "نَادِر",
 "まろ": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "まろい": "مُسْتَدِير, مُدَوَّر (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ)\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / مُنْثَنٍ / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين)",
 "まろうと": "ضَيْف, زَائِر",
 "まろうど": "ضَيْف, زَائِر",
 "まろびでる": "نَشَرَ, وَزَّعَ (وزّع بشكل منهجي أو استراتيجي (مثل القوات أو المنتجات))\nمثال: تنشر الولايات المتحدة أسلحتها في الشرق الأوسط",
 "まろび出る": "نَشَرَ, وَزَّعَ (وزّع بشكل منهجي أو استراتيجي (مثل القوات أو المنتجات))\nمثال: تنشر الولايات المتحدة أسلحتها في الشرق الأوسط",
 "まろぶ": "دَحْرَجَ, تَدَحْرَجَ",
 "まろやか": "مُسْتَدِير, مُدَوَّر (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ)\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / برخامة, بنعومة (بطريقة رخيمة)",
 "まわし": "حِزَام, زُنَّار (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة…)\nمثال: هذا حزام من الجلد. / وِشَاح / اِغْتِصَاب جَمَاعِيّ (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ…)\nمثال: تعرض زيري للاغتصاب.",
 "まわしぐるま": "عَجَلَة",
 "まわしびきのこぎり": "منشار ترددي, منشار صابر (منشار آلي محمول بشفرة ترددية؛ يمكن استخدامه مع مجموعة متنوعة من الشفرات حسب…)",
 "まわしぶみ": "دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل.",
 "まわしもの": "جَاسُوس / طُعم, مروّج مخادع (طُعم يتصرف كزبون متحمس من أجل تحفيز مشاركة الآخرين)",
 "まわし者": "جَاسُوس / طُعم, مروّج مخادع (طُعم يتصرف كزبون متحمس من أجل تحفيز مشاركة الآخرين)",
 "まわす": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع…)\nمثال: إذهب إلى الدار. / حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ…)\nمثال: لقد أوقفنا حركة المرور. / شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ…)\nمثال: شغل بيل التلفاز. / وَضَعَ, حَطَّ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "まわり": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو…)\nمثال: أسبح في المحيط. / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه…)\nمثال: خضع زيد لدورة مكثفة / انتشار, نشر (عملية الامتداد على نطاق أوسع أو مساحة من المكان أو الزمان) / تَأْثِير, أَثَر / بِوَاسِطَة, عَن طَرِيق",
 "まわりあわせ": "ثَرْوَة",
 "まわりえん": "إفريز, كرنيش (الجزء البارز العلوي من السطح المعمد)",
 "まわりくどい": "غَيْر مُبَاشِر, مُلْتَوٍ (يَنْحَرِف عَنِ المَسَار المُسْتَقِيم)",
 "まわりこみ": "رداء ملفوف (رداء (مثل فستان أو معطف) بفتحة كاملة الطول؛ يُضبط على الجسم بلفه حوله)",
 "まわりどおい": "دَوَّار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "まわりぶち": "إفريز, كرنيش (الجزء البارز العلوي من السطح المعمد)",
 "まわりまわって": "أَخِيرًا, فِي اَلْآخِرْ",
 "まわりみち": "تحويلة, طريق التفافي (طريق غير مباشر (خاصة الذي يستخدم مؤقتاً أثناء إغلاق الطريق الرئيسي))",
 "まわり道": "تحويلة, طريق التفافي (طريق غير مباشر (خاصة الذي يستخدم مؤقتاً أثناء إغلاق الطريق الرئيسي))",
 "まわる": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع…)\nمثال: إذهب إلى الدار. / دَوَائِر تَحْتَ ٱلْعَيْنَيْن (بمعنى الشكل الذي لا بداية له ولا نهاية بشكل قوس مستمر؛ بمعنى الهيئة أو الجهة…) / وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟ / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "まゐらす": "حَالِيّ, حَاضِر\nمثال: أنا موجود لوحدي / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟",
 "まをおいて": "بشكل متقطع, على فترات (بطريقة متقطعة)\nمثال: استجوبنا البارومتر بشكل متقطع",
 "まをおく": "تَوَقَّفَ",
 "まをとる": "تَوَقَّفَ",
 "まをもたす": "مَعْلِف, مُرَاح",
 "まをもたせる": "مَعْلِف, مُرَاح",
 "まん": "عَشَرَة آلَاف / لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)\nمثال: واجه عدداً لا يحصى من التفاصيل / مُمْتَلِئ, مَلِيء / مَنْشُورِيَا / كَامِل",
 "まんいち": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "まんいちのため": "تَحَسُبًا",
 "まんいつ": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "まんいん": "بيت كامل, فل هاوس (يد بوكر تحتوي على ثلاث بطاقات من نوع واحد وزوج من نوع آخر)\nمثال: バスは満員だった。 — مُلئت الحافلة.",
 "まんいんおんれい": "بيت كامل, فل هاوس (يد بوكر تحتوي على ثلاث بطاقات من نوع واحد وزوج من نوع آخر)",
 "まんえつ": "طَرَب, نَشْوَة (طَرَّبَ الْمُغَنِّي: تَغَنَّى؛ طَرَّبَهُ بِغِنَاءٍ عَذْبٍ: هَزَّهُ، أَطْرَبَهُ…)",
 "まんえん": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "まんえんぼうしとうじゅうてんそち": "كوفيد-19, كوڤيد-19",
 "まんかんぐうすうかんせい": "تشينغ, سلالة تشينغ (آخر سلالة إمبراطورية للصين (من 1644 إلى 1912) والتي أطاح بها الثوار؛ خلال سلالة…)",
 "まんかんしょくのふね": "كَامِل, وَافٍ (كامل من كلّ جهة ووجه)",
 "まんが": "كَارِيكَاتِير, كَارِيكَاتُور / جَرّافَة, كَاسِحَة",
 "まんがいち": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "まんがいつ": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "まんがえいが": "كَارِيكَاتِير, كَارِيكَاتُور",
 "まんがか": "رسام كاريكاتير, رسام كرتون (شخص يرسم الرسوم الكاريكاتورية أو الكرتونية) / كَارِيكَاتِير, كَارِيكَاتُور",
 "まんがきっさ": "مقهى (مطعم صغير تباع فيه المشروبات والوجبات الخفيفة)",
 "まんがざっし": "قصص مصورة, كوميكس (مجلة مخصصة للقصص المصورة)",
 "まんがほん": "قصص مصورة, كوميكس (مجلة مخصصة للقصص المصورة)",
 "まんがぼん": "قصص مصورة, كوميكس (مجلة مخصصة للقصص المصورة)",
 "まんが喫茶": "مقهى (مطعم صغير تباع فيه المشروبات والوجبات الخفيفة)",
 "まんが家": "رسام كاريكاتير, رسام كرتون (شخص يرسم الرسوم الكاريكاتورية أو الكرتونية)",
 "まんき": "إخراج النفس, زفير (فعل إخراج الهواء من الرئتين)\nمثال: نعى الآلاف رحيله",
 "まんきじつ": "مَوْعِد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "まんきつ": "مقهى (مطعم صغير تباع فيه المشروبات والوجبات الخفيفة)",
 "まんきび": "مَوْعِد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "まんきゃくるい": "بَرْنَقِيل",
 "まんきん": "عَشَرَة آلَاف",
 "まんくう": "حَارّ, صَمِيمِيّ (صَادِق وَجَادّ فِي المَشَاعِر)",
 "まんげ": "شَعْر اَلْعَانَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام…)\nمثال: شعر ماريا طويل.",
 "まんげきょう": "مِشْكَال, مِنْظَارُ التَّهَاوِيل",
 "まんげつ": "بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ…)",
 "まんこ": "كِس, كُس (الشيءَ: دقّه دقَّا شديدا أو ضغطه أو دعكه) / اللعين, جداً (أداة توكيد، عامية جداً وغير مهذبة)\nمثال: لماذا تأخرت وقتاً طويلاً؟",
 "まんこう": "حَارّ, صَمِيمِيّ (صَادِق وَجَادّ فِي المَشَاعِر)",
 "まんごう": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ…)\nمثال: سأحبك إلى الأبد.",
 "まんごうまつだい": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ…)\nمثال: سأحبك إلى الأبد.",
 "まんごすちん": "مَانْغُوسْتِين\nمثال: نريد أن نأكل نبات جوز الهند.",
 "まんさいきっすい": "مقياس (أداة قياس لقياس وتوضيح كمية مثل سمك السلك أو كمية المطر وما إلى ذلك)",
 "まんさいきっすいせん": "خط التحميل, علامة بليمسول (خطوط مائية لإظهار المستوى الذي يجب أن يصل إليه الماء عندما تكون السفينة محملة…)",
 "まんさん": "مُدْهِش, مُذْهِل (مُثير للإعجاب بشكل مُفاجئ لدرجة الذهول أو الإرباك) / اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "まんざ": "بيت كامل, فل هاوس (يد بوكر تحتوي على ثلاث بطاقات من نوع واحد وزوج من نوع آخر)",
 "まんざい": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت)",
 "まんざら": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل)\nمثال: كان مقتنعاً كلياً",
 "まんしゅう": "مَنْشُورِيَا",
 "まんしゅうご": "لغة المانشو (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل…)\nمثال: الأمازيغية لغة.",
 "まんしゅうじん": "منشوريا",
 "まんしゅうぞく": "لغة المانشو (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل…)\nمثال: الأمازيغية لغة.",
 "まんしん": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق)\nمثال: أنا شديدة الفخر بأبي.",
 "まんじ": "صَلِيب مَعْقُوف / عَجَبًا\nمثال: سبحان الله عما يشركون.",
 "まんじゅぎく": "قطيفة فرنسية (نبات سنوي كثيف قوي الرائحة برؤوس زهور برتقالية أو صفراء معلمة باللون الأحمر…)",
 "まんじゅしゃげ": "سوس العنكبوت الأحمر, عنكبوت أحمر (سوس صغير يغزل الشباك؛ آفة خطيرة في البساتين)",
 "まんじょう": "كُلّ, جَمِيع",
 "まんじょういっち": "إجماع تام (أن يكون الجميع على رأي واحد)",
 "まんじょうそうだち": "تَصْفِيقٌ مَعَ الوُقُوف, تَصْفِيقٌ حَارّ",
 "まんじり": "تَقَيَّلَ, أَخَذَ قَيْلُولَة / بتركيز, بثبات (بطريقة ثابتة ومركزة)\nمثال: حدق بي بثبات",
 "まんずり": "عَادَة سِرِّيَّة",
 "まんせい": "عَوِيص / زحف (طريقة تنقل بطيئة على اليدين والركبتين أو بجر الجسم)\nمثال: كان الزحف هو كل ما استطاع الرجل المصاب القيام به",
 "まんせいかんせつリウマチ": "الدَّاء الرَثَيَانِيّ, اِلْتِهَاب المَفَاصِل الرُّومَاتُويِدِيّ",
 "まんせいきかんしえん": "التهاب الشعب الهوائية المزمن (شكل من أشكال التهاب الشعب الهوائية يتميز بإنتاج مفرط للبلغم مما يؤدي إلى سعال…)",
 "まんせいこうじょうせんえん": "داء هاشيموتو (اضطراب مناعي ذاتي في الغدة الدرقية)",
 "まんせいしょうもうびょう": "مرض الهزال المزمن (مرض يصيب الحياة البرية (شبيه بمرض جنون البقر) ويؤثر على الغزلان والأيائل)",
 "まんせいしょくぶつ": "دابة الشجر, متسلق (أي من الطيور الصغيرة المتنوعة آكلة الحشرات في نصف الكرة الشمالي التي تتسلق جذوع…)",
 "まんせいてき": "عَوِيص",
 "まんせいひろうしょうこうぐん": "قارن (انظر للمقارنة)",
 "まんせいへいそくせいはいしっかん": "دَاء الاِنْسِدَاد الرِئَوِيّ المُزْمِن",
 "まんせき": "بيت كامل, فل هاوس (يد بوكر تحتوي على ثلاث بطاقات من نوع واحد وزوج من نوع آخر)",
 "まんぜん": "تَائِه, هَائِم (يسير بلا وجهة ولا اتّجاه محدّد)",
 "まんぞく": "رِضَا, إِشْبَاع (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا. / كافٍ, وافٍ (كمية يمكن أن تلبي حاجة أو متطلبًا ولكن دون أن تكون وفيرة)\nمثال: طعام كافٍ / مُرِيح, مُطَمْئِن (يبعث على الراحة ويحرّر من القلق)",
 "まんぞくど": "رِضَا, إِشْبَاع (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "まんぞくのいく": "مُرِيح, مُطَمْئِن (يبعث على الراحة ويحرّر من القلق)",
 "まんたく": "بيت كامل, فل هاوس (يد بوكر تحتوي على ثلاث بطاقات من نوع واحد وزوج من نوع آخر)",
 "まんだい": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ…)\nمثال: سأحبك إلى الأبد.",
 "まんだら": "ماندالا (أي من التصاميم الهندسية المختلفة (عادة دائرية) ترمز للكون؛ تستخدم بشكل رئيسي في…)",
 "まんだん": "دَرْدَشَ",
 "まんちゃく": "خِدَاع, خَدْع",
 "まんちゃくしゅだん": "حِيلَة",
 "まんちょう": "ذروة المد, مد عالي (المد عندما يكون الماء في أعلى مستوياته)",
 "まんちょうせん": "علامة المد العالي (خط يحدد أعلى مستوى تم الوصول إليه)",
 "まんてん": "كَامِل / رَقِيع, سماء",
 "まんてんか": "جَمِيع أَنْحَاء, كُلّ",
 "まんどく": "رعي, قضم الأوراق (فعل التغذية عن طريق القضم المستمر)",
 "まんどころ": "مكتب حكومي (مكتب يعمل فيه موظفو الحكومة)",
 "まんな": "كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك.",
 "まんなか": "مُنْتَصَف, وَسَط",
 "まんなかわけ": "سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة…)",
 "まんにょう": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ…)\nمثال: سأحبك إلى الأبد.",
 "まんにん": "اَلْجَمِيع, كُلّ شَخْص",
 "まんにんむき": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "まんねん": "عَشَرَة آلَاف / أَبَدِيّ, سَرْمَدِيّ",
 "まんねんぐさ": "حَيّ الْعَالَم (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "まんねんごよみ": "تقويم دائم (مخطط أو جهاز ميكانيكي يشير إلى أيام الأسبوع المقابلة لأي تاريخ معين على مدى…)",
 "まんねんたけ": "فطر الرف, فطر قوسي (فطر خشبي يشكل حوامل بوغية تشبه الرف على جذوع الأشجار والهياكل الخشبية)",
 "まんねんひつ": "قَلَم مِدَاد, قَلَم حِبْر سَائِل (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "まんねんぴつ": "قَلَم مِدَاد, قَلَم حِبْر سَائِل (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "まんねんふで": "قَلَم مِدَاد, قَلَم حِبْر سَائِل (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "まんねんれい": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في…)\nمثال: جون في عمر أخي.",
 "まんねんろう": "إِكْلِيل الْغَار, إِكْلِيل الْجَبَل",
 "まんのう": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة) / قَدِير, كُلِّيّ القُدْرَة (يمتلك قدرة غير محدودة)",
 "まんば": "إِهَانَة, سَبّ (تعبير وقح يهدف إلى الإساءة أو الأذى)\nمثال: عندما ارتكب الطالب خطأ غبياً لم يوفر له أي شتيمة",
 "まんぱい": "مُمْتَلِئ, مَلِيء / مَضْغُوط, مَكْبُوس (مضغوط معًا أو مكبوس بإحكام)",
 "まんびき": "سَرَقَةُ السِلَعَ مِنَ الـمَتَاجِر",
 "まんびきかぞく": "سارق متاجر (لص يسرق البضائع الموجودة في متجر)",
 "まんびょうやく": "ترياق عام, دواء لكل داء (علاج افتراضي لجميع العلل أو الأمراض؛ كان يسعى إليه الخيميائيون)",
 "まんぴょう": "بالإجماع (برأي واحد؛ بدون معارضة)\nمثال: وافق مجلس الشيوخ بالإجماع على مشروع القانون",
 "まんぷく": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / مُمْتَلِئ, مَلِيء",
 "まんぷくど": "رَغْبَة, تَعَطُّش\nمثال: جاع الرجل العجوز حتى الموت.",
 "まんべん": "كَافَّة, تَمَام / رَصِيد",
 "まんべんなく": "بِالتَّسَاوِي",
 "まんぼう": "سمكة شمس المحيط, مولا (من بين أكبر الأسماك العظمية؛ سمكة تعيش في عرض البحر ذات جسم بيضاوي مضغوط وزعانف…)",
 "まんぽ": "مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات)",
 "まんぽけい": "مقياس الخطوات (أداة قياس لتسجيل عدد الخطوات المقطوعة في المشي)",
 "まんま": "كَـ, مِثْل\nمثال: قصدته مثل نكتة. / مَعَ (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي. / طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "まんまく": "سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة…)",
 "まんまと": "بِنَجَاحٍ",
 "まんまる": "فَاتِن, قَشِيب",
 "まんまん": "بالكامل, تماماً (إلى أقصى درجة أو مدى؛ بشكل كامل أو كلي)\nمثال: نمى بالكامل / أَبَدًا / شَاسِع, وَاسِع",
 "まんまんしゃん": "بُوذَا, بُدّ",
 "まんまんなか": "النُّقْطَة المَيِّتَة (موضع المرفق عندما يكون على خط واحد مع ذراع التوصيل ولا يبذل عزم دوران)",
 "まんまんねん": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ…)\nمثال: سأحبك إلى الأبد.",
 "まんめん": "جَمِيع أَنْحَاء, كُلّ",
 "まんもく": "على مَد البَصَر (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "まんゆう": "رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "まんゆうきゃく": "متجول سياحي, متنزه (سائح يزور المعالم السياحية)",
 "まんよう": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ…)\nمثال: سأحبك إلى الأبد.",
 "まんらん": "غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "まんりき": "مِنْجَلَة, مِلْزَمَة / رحوية, ملفاف (رافعة تدور في مستوى أفقي حول محور عمودي؛ تستخدم على السفن لرفع المرساة أو…)",
 "まんりょう": "إخراج النفس, زفير (فعل إخراج الهواء من الرئتين)\nمثال: نعى الآلاف رحيله / توت التوابل, توت المرجان (شجيرة ذات توت أحمر مرجاني؛ اليابان إلى شمال الهند)",
 "まんりょうび": "تاريخ انهاء الصلاحية (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما…)\nمثال: ما تاريخ اليوم؟",
 "まんるいホームラン": "اكتساح كامل, جراند سلام (الفوز بجميع الحيل في يد البريدج)",
 "まん丸": "فَاتِن, قَشِيب",
 "まん延": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "まん延防止等重点措置": "كوفيد-19, كوڤيد-19",
 "まん毛": "شَعْر اَلْعَانَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام…)\nمثال: شعر ماريا طويل.",
 "まダニ": "قراد صلب (قراد له درع صلب على الظهر وأجزاء فم تبرز من الرأس)",
 "まー": "عَدْل (عَدْل)\nمثال: هل يعاملون بالعدل / بشكل محتمل, بشكل مقبول (بطريقة مقبولة (ولكن ليست متميزة))\nمثال: تلعب التنس بشكل مقبول",
 "まーさん": "لَذِيذ",
 "まーじゃん": "مَا جُونْغ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "ま四角": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ)",
 "み": "بَحْر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر. / فَاكِهَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها)\nمثال: التفاح فاكهة لذيذة. / بِذْرَة, زَرِّيعَة / رَاضٍ, مُرْتَاح (رَاضَ (راضه)روضا ورياضا ورياضة: ذلله. يقال راض المهر وراض نفسه بالتقوى وراض…)\nمثال: سامي غير راض بوظيفته. / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن. / لَحْم, لحمة (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم…)\nمثال: أفضل لحم البقر. / ثُعْبَان, حَنَش / باتجاه الجنوب الجنوب الشرقي (إلى أو نحو أو في الجنوب الجنوب الشرقي) / ثَلَاثَة, ثَلَاث (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب. / لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد. / مشاهدة, نظر (فعل توجيه العينين نحو شيء ما وإدراكه بصرياً)\nمثال: خرج ليلقي نظرة / حَاوَلَ, سَعَى (طَلَبَ، رَامَ)\nمثال: حاول توم قتلنا! / ـِيَّة / مَيْدَان\nمثال: هذا المكان مقدس / ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ…)\nمثال: أكره ذوق الكحول. / أَغُسْطُس, آب (الشهر الثامن في السنة الروميّة)\nمثال: غادر فاضل البلد في الثالث و العشرين من أغسطس. / جَمِيل (حَسَن)\nمثال: طقس اليوم جميل. / رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة. / ذَرَّى, نَسَفَ (ذَرَتِ الريحُ التُّرابَ: فَرَّقَتْهُ وَأَطَارَتْهُ؛ ذَرَى القمحَ: نَقَّاهُ فِي…)",
 "みあい": "مُرَاسَلَة",
 "みあいけっこん": "زَوَاج مُدَبَّر",
 "みあう": "مَاثَلَ",
 "みあげた": "جَدِير بِالْإِعْجَاب",
 "みあげる": "عَجَبَ",
 "みあげるよう": "شَاهِق",
 "みあやまる": "أَسَاء اَلْفَهْم, أَخْطَأَ\nمثال: كان خطأ حاسوبي.",
 "みあわす": "أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري. / تباين, مقابلة (فعل التمييز عن طريق مقارنة الاختلافات)\nمثال: هناك خط رفيع بين العقل والجنون",
 "みあわせ": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً",
 "みあわせる": "أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري. / تباين, مقابلة (فعل التمييز عن طريق مقارنة الاختلافات)\nمثال: هناك خط رفيع بين العقل والجنون",
 "みいだす": "اِكْتَشَفَ / اِخْتَارَ / حا َسـِب",
 "みいちゃんはあちゃん": "مُتَّبِع لِلصَّرْعَات, مُقَلِّد لِلْمُوضَة (شخص يتبع مجموعة متنوعة من البدع أو الصرعات)",
 "みいり": "مَحْصُول / دَخْل, إِيرَاد (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى. / مُحَمَّل, مُوَجَّه ((عَنِ العِبَارَات أَوِ الأَسْئِلَة) مَشْحُون بِدَلَالَات إِيحَائِيَّة وغَالِبًا…)\nمثال: مسدس ملقم",
 "みいる": "رَنَا ((رَنَا) رنوا ورنوا: أدام النظر في سكون طرف. ويقال رناه ورنا إليه ورنا له…) / فَتَنَ",
 "みうける": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا.",
 "みうごき": "حَرَكَة",
 "みうしなう": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "みうた": "قَصِيدَة, شِعْر",
 "みうち": "نِسْبِيّ\nمثال: いつくしみは、身内から始めよう。 — الأقربون أولى بالمعروف. / صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / أتباع, أنصار (مجموعة من المتابعين أو المتحمسين)",
 "みうちびいき": "محسوبية الأقارب (المحاباة التي يظهرها من هم في السلطة للأقارب أو الأصدقاء المقربين (كإعطائهم…)",
 "みうちネタ": "نُكْتَة خَاصَّة, نُكْتَة دَاخِلِيَّة (نكتة لا يقدرها سوى أفراد مجموعة معينة من الناس)",
 "みうめ": "مشمش ياباني (شجرة زينة يابانية بزهور بيضاء أو وردية عطرة وثمار صفراء صغيرة)",
 "みえ": "ثُلَاثِيّ / ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ…)\nمثال: ثبت مناد مكانه. / جِلْسَة, جَلْسَة / مِيِه",
 "みえい": "صُورَة",
 "みえっぱり": "استعراضي, محب للظهور (شخص يتصرف عمداً بطريقة تجذب الانتباه)",
 "みえづらい": "غير مميز, غير واضح (غير محدد بوضوح أو ليس من السهل إدراكه أو فهمه)\nمثال: أشكال غير واضحة في الظلام",
 "みえにくい": "مُظْلِم",
 "みえぼう": "متأنق (رجل يهتم كثيراً بملابسه ومظهره)",
 "みえみえ": "بَدِيهِيّ, بَدَهِيّ",
 "みえる": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا. / جَاءَ (أَتَى؛ حَدَثَ)\nمثال: تقريبا الكل جاء",
 "みえるか": "تصور بصري, صورة بصرية (صورة ذهنية تشبه الإدراك البصري)",
 "みお": "مَمَرّ مَائِيّ (على مَمَرّ العصور: على طولها ومداها؛ على مَمَرّ الفصول: على تواليها وتعاقبها)\nمثال: الباب في نهاية الممر. / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "みおくり": "تَوْدِيع, حَفْل وَدَاع (تعبير منظم عن حسن النية عند بدء رحلة أو مشروع جديد)\nمثال: كنت هناك مع والدي عند الانطلاق / إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق)",
 "みおくる": "مُرَافَقَة / أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري. / دَفَنَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "みおとし": "سهو, غفلة (خطأ ناتج عن عدم الانتباه)",
 "みおとす": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "みおどり": "غطاس صغير (غطاس أوروبي صغير)",
 "みおぼえ": "ذَاكِرَة, حَافِظَة",
 "みおぼえがある": "تَعَرَّفَ",
 "みおぼえのある": "مَأْلُوف",
 "みおぼえのない": "غَيْر مَأْلُوف (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "みおぼえる": "تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ:…)\nمثال: ليلى تذكر سامي.",
 "みおも": "حَامِل (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن…)\nمثال: يبدو أنني حامل. / أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة…)\nمثال: هل ستأتي أم لا؟",
 "みおや": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "みおろしがた": "من أعلى لأسفل (لنهج في حل المشكلات يبدأ من أعلى مستوى مفاهيمي ويعمل نزولاً إلى التفاصيل)\nمثال: تحليل من أعلى لأسفل قد يبدأ بالنظر في اتجاهات الاقتصاد الكلي",
 "みおろす": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة. / اِحْتَقَرَ, أَهَانَ",
 "みか": "صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)",
 "みかい": "هَمَجِيّ / غير متطور, غير نامٍ (لم يتطور أو ينضج أو يكتمل صياغته)\nمثال: كانت دورات التصميم الداخلي نادرة وغير متطورة",
 "みかいけつ": "عالق, غير محلول (لم يتم حله)\nمثال: العديد من الجرائم تبقى غير محلولة",
 "みかいこん": "سَطْحِيّ, غَيْرُ مُثَقَّف (يتصف بعدم التهذيب الثقافي أو افتقار الذوق الفكري)",
 "みかいじん": "هَمَجِيّ, مُتَوَحِّش",
 "みかいたく": "غير متطور, غير نامٍ (لم يتطور أو ينضج أو يكتمل صياغته)\nمثال: كانت دورات التصميم الداخلي نادرة وغير متطورة",
 "みかいとう": "بِلَا مُقَابِلٍ, غَيْرُ مَرْدُودٍ (لا يُرَدُّ بالمثل)",
 "みかいはつ": "غير متطور, غير نامٍ (لم يتطور أو ينضج أو يكتمل صياغته)\nمثال: كانت دورات التصميم الداخلي نادرة وغير متطورة",
 "みかいふう": "غَيْرُ مَفْتُوح, مُغْلَق (لم يُفتَح بعد ولم يُفَكّ ختمه)",
 "みかいめい": "غَيْر مُوَضَّح (لم يتم توضيح سببه أو علته)",
 "みかえし": "تبطين, تغليف (تزويد شيء بسطح من مادة مختلفة)",
 "みかえす": "أَعَادَ الفحص, رَاجَعَ (نظر مرة أخرى؛ فحص مرة أخرى)\nمثال: لنراجع وضعك / اِلْتَفَتَ, اِسْتَدَارَ",
 "みかえり": "مُكَافَأَة, ثَوَاب / مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)\nمثال: أبناء العمومة هم أقارب جانبيون",
 "みかえりしきん": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)\nمثال: أبناء العمومة هم أقارب جانبيون",
 "みかえりぶっし": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له)\nمثال: أبناء العمومة هم أقارب جانبيون",
 "みかえる": "اِلْتَفَتَ, اِسْتَدَارَ",
 "みかぎる": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا!",
 "みかく": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ…)\nمثال: أكره ذوق الكحول.",
 "みかくてい": "غير مؤكد (لم يتم إقراره أو تسويته نهائياً)\nمثال: خطاب اعتماد غير مؤكد",
 "みかくにん": "غير مؤكد (لم يتم إقراره أو تسويته نهائياً)\nمثال: خطاب اعتماد غير مؤكد",
 "みかくにんひこうぶったい": "صَحْن طَائِر (ساحة وسط الدَار. الجمع صحون؛ المستوي من الأرض)\nمثال: توم يلعب الصحن الطائر.",
 "みかぐら": "كاغورا (رقصة فخمة من ديانة الشنتو تشكل الآن جزءاً من مهرجانات القرى اليابانية)\nمثال: تُعد الكاغورا، وخاصة تلك الأشكال التي تتضمن سرد القصص أو إعادة تمثيل الخرافات، أحد التأثيرات الأساسية على مسرح نو",
 "みかけ": "بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "みかけじょう": "بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "みかける": "لَاحَظَ",
 "みかげいし": "صَوَّان, غْرَانِيت",
 "みかげ石": "صَوَّان, غْرَانِيت",
 "みかこう": "خَام, غَيْر مُعَالَج (لَمْ يُعَالَج أَوْ يُحَضَّر بِعَمَلِيَّة خَاصَّة)\nمثال: سلع أولية (غير مصنعة)",
 "みかし": "مَالِح",
 "みかじめ": "إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة)",
 "みかずき": "هِلَال",
 "みかた": "زاوية نظر, منظور (موقف ذهني يتم من خلاله النظر إلى الأشياء)\nمثال: يجب أن ننظر في هذه المشكلة من وجهة نظر الروس / صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / إسناد, دعم (فعل تحمل وزن أو تقوية شيء ما)\nمثال: استند على الحائط للدعم",
 "みかづき": "هِلَال",
 "みかづきこ": "بحيرة متروكة, بحيرة هلالية (بحيرة على شكل هلال (مؤقتة غالباً) تتشكل عندما ينفصل تعرج للنهر عن القناة…)",
 "みかど": "قَيْصَر, إِمْبْرَاطُور",
 "みかりばば": "عَجُوز",
 "みかん": "غَيْر مَنْشُور (غير منشور)\nمثال: رسائل ومذكرات غير منشورة / غير مكتمل, ناقص (غير كامل أو غير كلي؛ لم يتم إنجازه)\nمثال: سرد غير مكتمل لحياته / يُوسُفِيّ, يُوسُف أَفَنْدِي / حمضيات (أي من الفواكه العديدة لجنس الحمضيات ذات القشرة السميكة واللب العصيري؛ تزرع في…)",
 "みかんこう": "غَيْر مَنْشُور (غير منشور)\nمثال: رسائل ومذكرات غير منشورة",
 "みかんせい": "غير مكتمل, ناقص (غير كامل أو غير كلي؛ لم يتم إنجازه)\nمثال: سرد غير مكتمل لحياته",
 "みかんりょう": "غير مكتمل, ناقص (غير كامل أو غير كلي؛ لم يتم إنجازه)\nمثال: سرد غير مكتمل لحياته / ناقص-غير كامل",
 "みがき": "بُولَنْدِيّ / تَحْسِين",
 "みがきえき": "بُولَنْدِيّ",
 "みがきがみ": "ورق صنفرة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى…)\nمثال: هات ورقة بيضاء.",
 "みがきこむ": "بُولَنْدِيّ",
 "みがきたてる": "بُولَنْدِيّ",
 "みがきをかける": "مسن دقيق (حجر شحذ مصنوع من الحجر الرملي الدقيق؛ يستخدم لشحذ شفرات الحلاقة) / بُولَنْدِيّ",
 "みがく": "بُولَنْدِيّ / حَسَّنَ (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "みがって": "أَنَانِيّ",
 "みがはいる": "يَنَعَ, نَضَجَ (أَيْنَعَ؛ نَضَجَ)",
 "みがひきしまる": "دَاعٍ إِلَى الجِدِّيَّة, مُنَبِّه (يميل إلى جعل المرء أكثر جدّية ورصانة)",
 "みがほそる": "فَقَدَ وَزْن",
 "みがまえ": "وَضْعِيَّة",
 "みがらかくほ": "اعتقال, قبض (فعل القبض (خاصة القبض على مجرم))\nمثال: حصل الشرطي المناوب على التقدير للقبض على المجرم",
 "みがらこうそく": "حَبْس (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ)\nمثال: هو,البارحة حرر من الحبس.",
 "みがらをこうそくする": "اِعْتَقَلَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "みがる": "رَشِيق, خَفِيف اَلْحَرَكَة / سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ",
 "みがるい": "خَفِيف الحَرَكَة, رَشِيق (يتحرّك بسرعة وخفّة)",
 "みがわり": "إحلال, استبدال (عملية وضع شيء أو شخص مكان آخر)\nمثال: استبدال الدم المفقود بنقل دم المتبرع",
 "みき": "جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر) / عَمُود فَقْرِيّ",
 "みきき": "مَعْلُومَات, مَعْلُومَة",
 "みきく": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "みきてい": "غير محدد (غير مذكور بصراحة أو بالتفصيل)\nمثال: هدد بـأعمال انتقامية غير محددة",
 "みきにゅう": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه…)\nمثال: عندي ابنا خالة.",
 "みきょういく": "غير مدرب (غير منضبط أو مكيف أو ماهر بسبب التدريب)\nمثال: صوت غير مدرب",
 "みきり": "هِجْرَان, هُجْرَان / حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما)\nمثال: قام بتدوير حواف الصندوق",
 "みきりうり": "بيع تصفية, تصفية (بيع لتقليل المخزون)",
 "みきりせん": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "みきりをつける": "غَسَلَ يَدَيْهِ مِنَ الْأَمْرِ (معنى غَسَّلَ، بِالتَّشْدِيدِ، اغْتَسَلَ بعدَ الجِمَاع، ثمّ اغْتسلَ…)\nمثال: سأذهب لغسل يدي.",
 "みきる": "تَنَازَلَ",
 "みきわめる": "تَيَقَّنَ, تَثَبَّتَ",
 "みぎ": "يَمِين, يمين\nمثال: أجب على السؤال. / يَمِين, يُمْنَى / أَعْلَى (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى)\nمثال: خذها إلى الأعلى. / أَفْضَل, أَحْسَن\nمثال: إيمي فتاة حسنة.",
 "みぎあがり": "زراعي, نمو (متعلق أو مناسب للنمو)\nمثال: موسم زراعة الذرة",
 "みぎうで": "مساعد أيمن (المساعد الذكر الأكثر فائدة)",
 "みぎうわて": "أَيْمَن (صفة لما كان يقع على جهة اليمين؛ ضد أَيْسَر؛ صفة لمن كان كثير اليُمن والبركة)\nمثال: لدى توم وشم في ذراعه الأيمن.",
 "みぎおく": "يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "みぎかたあがり": "زراعي, نمو (متعلق أو مناسب للنمو)\nمثال: موسم زراعة الذرة",
 "みぎかたさがり": "متناقص (يصبح أقل أو أصغر)",
 "みぎからひだりへ": "بأذن واحدة (بطريقة تستخدم أذناً واحدة)\nمثال: تم تقديم المحفزات بأذن واحدة",
 "みぎがわ": "يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "みぎきき": "أيمنية, تيامن (تفضيل استخدام اليد اليمنى)",
 "みぎさがり": "متناقص (يصبح أقل أو أصغر)",
 "みぎだしゃ": "أَيْمَن (صفة لما كان يقع على جهة اليمين؛ ضد أَيْسَر؛ صفة لمن كان كثير اليُمن والبركة)\nمثال: لدى توم وشم في ذراعه الأيمن.",
 "みぎっかわ": "يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "みぎて": "يَمِين, يُمْنَى / يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "みぎてざひょうけい": "أَيْمَن (صفة لما كان يقع على جهة اليمين؛ ضد أَيْسَر؛ صفة لمن كان كثير اليُمن والبركة)\nمثال: لدى توم وشم في ذراعه الأيمن.",
 "みぎてのほうそく": "يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "みぎにおなじ": "أيضاً, علامة التكرار (علامة تُستخدم للإشارة إلى تكرار الكلمة الموجودة أعلاها)",
 "みぎにでる": "فَاقَ, تَجَاوَزَ",
 "みぎのみみからひだりのみみ": "بأذن واحدة (بطريقة تستخدم أذناً واحدة)\nمثال: تم تقديم المحفزات بأذن واحدة",
 "みぎへならえ": "تَقْلِيد",
 "みぎまき": "بِإِتِّجَاه عَقَارِب السَّاعَة",
 "みぎまわり": "دوران باتجاه عقارب الساعة, دوران يميني (دوران إلى اليمين)",
 "みぎり": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب.",
 "みぎれい": "دَقِيق, مُتْقَن (خالٍ من الخَرَق؛ مُنفَّذ بدقة ومهارة)",
 "みぎわ": "شَاطِئ, سَاحِل (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة)…)\nمثال: عاد إلى الشاطئ.",
 "みぎわせん": "خط الساحل, شاطئ (خط الحدود بين اليابسة والماء)",
 "みぎん": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب.",
 "みぎハンドル": "يَمِين, يُمْنَى",
 "みぎバッター": "أَيْمَن (صفة لما كان يقع على جهة اليمين؛ ضد أَيْسَر؛ صفة لمن كان كثير اليُمن والبركة)\nمثال: لدى توم وشم في ذراعه الأيمن.",
 "みくだりはん": "تَفْرِقَة",
 "みくに": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من…)\nمثال: لبنان دولة صغيرة. / الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "みくにことば": "يَابَانِيّ",
 "みくびる": "صَغَّرَ, اِحْتَقَرَ (جعل الشيء أصغر حجمًا أو أقل قيمة؛ قلل من أهمية شخص أو شيء أو استهان به)\nمثال: الصغر أسرع من النسر",
 "みくらべる": "أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء…)\nمثال: أخذ الولد يبكي.",
 "みぐし": "شَعْرَة\nمثال: شعر ماريا طويل.",
 "みぐるしい": "كَرِيه المَنْظَر (غير سار للنظر)",
 "みけ": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً)\nمثال: فساتين كاليكو / قط ذبل, قط كاليكو (قط ذو علامات سوداء وكريمية وصفراء)",
 "みけいか": "سارٍ, غير منتهي الصلاحية (لم ينتهِ أو يُلغَ بمرور الوقت)\nمثال: انتخب لملء فترة السيناتور غير المنتهية",
 "みけいけん": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "みけいけんしゃ": "بريء, قليل الخبرة (شخص يفتقر إلى معرفة الشر)",
 "みけっさい": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ)",
 "みけっさん": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ)",
 "みけってい": "غَيْر مَحْسُوم (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "みけつ": "قَيْدَ الِانْتِظَار, مُعَلَّق (فِي انْتِظَارِ الِاخْتِتَامِ أَوِ التَّأْكِيدِ)",
 "みけねこ": "قط ذبل, قط كاليكو (قط ذو علامات سوداء وكريمية وصفراء)",
 "みけん": "حَاجِب (قوس الشعر فوق كل عين)\nمثال: غربت الشمس خلف قمة التلال البعيدة / لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "みこ": "اِبْن اللَّٰه (الولد الذكر)\nمثال: هو له ابن صغير.",
 "みこあいさ": "بلقشة بيضاء (أصغر أنواع البلقشة وأكثرها مهارة في الغوص؛ توجد في شمال أوراسيا)",
 "みこうかい": "غَيْر مَنْشُور (غير منشور)\nمثال: رسائل ومذكرات غير منشورة",
 "みこうかいかぶ": "سهم خارج المقصورة, سهم غير مدرج (سهم غير مدرج ومتداول في بورصة منظمة)",
 "みこうひょう": "غَيْر مَنْشُور (غير منشور)\nمثال: رسائل ومذكرات غير منشورة",
 "みこころ": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم:…)\nمثال: كان سامي هو روح الحفلة.",
 "みこし": "حَمَّالَة, مِحَفَّة / مُسْتَدَقّ الظَّهْر / تنبؤ, توقع (فعل التنبؤ (عن طريق التفكير في المستقبل))\nمثال: كان لكل منهم توقعاته الخاصة",
 "みこしをあげる": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "みこしを上げる": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "みこす": "تَوَقَّعَ, اِرْتَقَبَ",
 "みこすりはん": "سرعة القذف, قذف مبكر (القذف خلال المراحل المبكرة من الإثارة الجنسية أو بعد فترة وجيزة من إيلاج القضيب…)",
 "みこすり半": "سرعة القذف, قذف مبكر (القذف خلال المراحل المبكرة من الإثارة الجنسية أو بعد فترة وجيزة من إيلاج القضيب…)",
 "みこと": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل:…)\nمثال: اعتني بي يا رب. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "みことのり": "مرسوم إمبراطوري (مرسوم يصدره حاكم ذو سيادة)",
 "みことば": "كَلَام اللّٰهِ",
 "みこのみこと": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "みこみ": "أَمَلَ, رَجَا ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل. / أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له))",
 "みこみちがい": "حساب خاطئ, سوء تقدير (خطأ في الحساب)",
 "みこむ": "تَوَقَّعَ, اِرْتَقَبَ / ثِقَة\nمثال: وثق سامي بليلى ثقة عمياء. / دَرَجَة\nمثال: الصهاينة أشر من النازيين.",
 "みこよせ": "روحانية (الاهتمام بأمور الروح)",
 "みこん": "سَطْحِيّ, غَيْرُ مُثَقَّف (يتصف بعدم التهذيب الثقافي أو افتقار الذوق الفكري) / أعزب, غير متزوج (غير متزوج أو يتعلق بحالة العزوبية)\nمثال: رجال ونساء غير متزوجين",
 "みごしらえ": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "みごたえ": "بَلِيغ, مُؤَثِّر (يُنتج أثراً قويّاً)\nمثال: احتفال مثير للإعجاب",
 "みごと": "بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين) / نَطَقَ بِ (بمعنى الحزام؛ تحريف نُطْق. )\nمثال: يسهل نطق اسم توم / مَشْهَد",
 "みごなし": "خفة الحركة, مرونة (رشاقة شخص أو حيوان سريع وخفيف الحركة)",
 "みごろ": "صدرية الفستان (جزء من الفستان فوق الخصر)",
 "みさい": "غير مكتمل, غير منتهٍ (لم يتم الانتهاء منه أو اختتامه)\nمثال: أعمال غير منتهية / بلا أجر, غير مدفوع (لم يتم الدفع له)\nمثال: أجور غير مدفوعة",
 "みさお": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله…) / عِفَّة, طَهَارَة",
 "みさかい": "تَمْيِيْز",
 "みさかいない": "اعتباطي, عشوائي (لا يتميز بتمييزات دقيقة (يخلط الحابل بالنابل))\nمثال: عادات قراءة عشوائية",
 "みさかいなく": "بشكل عشوائي, دون تمييز (بطريقة عشوائية)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "みさき": "رَأْس (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن…)\nمثال: قطع سامي رأس كلب.",
 "みさげはてた": "حقير, دنيء (يستحق الازدراء أو الاحتقار)",
 "みさげはてる": "اِحْتَقَرَ, أَهَانَ",
 "みさげる": "تَرَفَّعَ",
 "みさご": "عُقَاب نُسَارِيّ, عُقَاب نُسَارِيَّة (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة…)\nمثال: هو من تلقى العقاب الأكبر.",
 "みさだめる": "تَيَقَّنَ, تَثَبَّتَ",
 "みさらし": "غَيْر مَصْبُوغ, غَيْر مُبَيَّض (لم يُلوَّن أو يُبيَّض صناعيًّا)",
 "みざくら": "شجرة الكرز, كرز (أي من العديد من الأشجار والشجيرات التي تنتج فاكهة مستديرة لحمية صغيرة بنواة…)",
 "みざらし": "غَيْر مَصْبُوغ, غَيْر مُبَيَّض (لم يُلوَّن أو يُبيَّض صناعيًّا)",
 "みしみし": "بِأَزِيز, بِصَرِير (بطريقة تصدر صريراً)\nمثال: كان القارب القديم يتحرك بصرير",
 "みしゅう": "مُتَرَاكِم, مُسْتَحَقّ (يتراكم دورياً مع مرور الوقت)",
 "みしゅうがく": "روضة أطفال, مرحلة ما قبل المدرسة (مؤسسة تعليمية للأطفال الصغار جداً على المدرسة الابتدائية)",
 "みしゅうさい": "غير مُدرج (غير موجود في قائمة)\nمثال: رقم هاتف غير مدرج",
 "みしゅうにゅうきん": "حِسَاب مَدِين (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن…)\nمثال: الحساب لو سمحت.",
 "みしゅつ": "غَيْر مَنْشُور (غير منشور)\nمثال: رسائل ومذكرات غير منشورة",
 "みしょう": "مَجْهُول, مُبْهَم / شَتْلَة / جنيني, غير مولود (لم يولد بعد)\nمثال: أجيال لم تولد بعد",
 "みしょうか": "غَيْر مَهْضوم (لَمْ يَتِمّ هَضْمُه بَعْد) / غَيْر مُتَحَقِّق, غَيْر مُنْجَز ((للأشخاص) يتميز بالفشل في تحقيق كامل إمكاناته)",
 "みしょち": "غَيْر مُعَالَج (لم يُعالَج بمادّة كيميائيّة أو فيزيائيّة أو بيولوجيّة)\nمثال: نسيج غير معالج",
 "みしょぶん": "غَيْرُ مُسْتَوْطَن (لم يُسْتَوطَن بعد)\nمثال: نمط حياة غير مستقر",
 "みしょり": "غَيْر مُعَالَج (لم يُعالَج بمادّة كيميائيّة أو فيزيائيّة أو بيولوجيّة)\nمثال: نسيج غير معالج",
 "みしよう": "عَاطِل, غَيْر مُسْتَخْدَم (ليس قيد الاستخدام الفعليّ)",
 "みしらぬ": "غَرِيب, عَجِيب",
 "みしり": "إذن بالكلام (تعيين من قبل رئيس الجلسة يمنح الشخص الحق في التحدث في هيئة تداولية)\nمثال: لم يتمكن من تقديم اقتراحه لأنه لم يحصل على إذن بالكلام من الرئيس / بِأَزِيز, بِصَرِير (بطريقة تصدر صريراً)\nمثال: كان القارب القديم يتحرك بصرير",
 "みしりみしり": "بِأَزِيز, بِصَرِير (بطريقة تصدر صريراً)\nمثال: كان القارب القديم يتحرك بصرير",
 "みしる": "تَعَرَّفَ",
 "みしんこく": "غير معلن (غير مصرح به أو معترف به علانية)\nمثال: خوض حرب غير معلنة",
 "みしんじゃ": "وَثَنِيّ",
 "みじか": "قَصِير, قصير (ضد الطويل)\nمثال: حبل الكذب قصير.",
 "みじかい": "قَصِير, قصير (ضد الطويل)\nمثال: حبل الكذب قصير. / وَجِيز, قَصِير",
 "みじかうた": "شعب تانكا (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه…)\nمثال: الجيش يوحد الشعب.",
 "みじかさ": "إيجاز, زوال (سمة كونه وجيزاً أو عابراً)",
 "みじかぼいん": "حركة قصيرة, صائت قصير (في اللغات التي تميز طول الصائت، هو صائت يتم نطقه عادة أقصر من الصائت الطويل)",
 "みじかめ": "قَصِير نَوْعًا مَا (أَقْصَر بِقَليل مِنَ المُعْتاد)",
 "みじけー": "قَصِير, قصير (ضد الطويل)\nمثال: حبل الكذب قصير. / وَجِيز, قَصِير",
 "みじたく": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "みじめ": "بَائِس",
 "みじめったらしい": "بَائِس",
 "みじゅく": "غير ناضج, فج (غير مكتمل النمو أو النضج؛ غير يانع)\nمثال: فاكهة غير ناضجة / غير مكسو بالريش, غير ناضج ((عن الطيور) لم تطور ريشاً بعد)\nمثال: عصفور صغير غير مكسو بالريش على حافة النافذة",
 "みじゅくじ": "طفل خديج, طفل مبتسر (رضيع يولد قبل 37 أسبوعاً من الحمل)",
 "みじゅくもの": "بريء, قليل الخبرة (شخص يفتقر إلى معرفة الشر)",
 "みじゅくれん": "عَدِيم المَهَارَة, غَيْر كُفْء (لا يؤدي العمل بشكل جيد؛ يفتقر إلى الكفاءة)\nمثال: غير ماهر في فن البلاغة",
 "みじょうじょう": "غير مُدرج (غير موجود في قائمة)\nمثال: رقم هاتف غير مدرج",
 "みじろぎ": "تحريك, تقليب (تحريك سائل باستخدام أداة)\nمثال: التحريك المستمر يمنعه من الاحتراق في قاع المقلاة",
 "みじろぐ": "تَحَرَّكَ (حَرُكَ)\nمثال: لا أستطيع التحرك.",
 "みじん": "جُسَيْم, ذَرَّة (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى…)\nمثال: نحن نعيش بعض اللحظات الحزينة حقا لأن بلادنا عانت من خسارة جسيمة. وسوف يستغرق وقتا طويلا قبل أن تعود إلى مجدها السابق. / عَفْوًا, عَلَى الرُحْب وَالسَّعَة",
 "みじんこ": "دافنيا (قشريات مياه عذبة دقيقة لها جسم مستدير محاط بصدفة شفافة؛ تتحرك مثل البرغوث…)",
 "みす": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا.",
 "みすかす": "قَرَأَ (نَطَقَ بما هو مكتوب؛ تَتَبَّعَ ما هو مكتوب وفَهِمَه)\nمثال: قرأ سامي الرسالة.",
 "みすごす": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "みすじ": "شَامِيسِين",
 "みすてる": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا!",
 "みすぼらしい": "بَالٍ",
 "みすます": "تَأَكَّدَ",
 "みすみそう": "ماركانتيا بوليمورفا, هيباتيكا (حشيشة كبد شائعة)",
 "みする": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "みず": "مِيَاه / سَائِل, مَائِع / طُوفَان, فَيَضَان (عاصفة)",
 "みずあか": "فَرْو",
 "みずあげ": "هُبُوط / لُقْطَة\nمثال: كنت أمسك بالكرة. / إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة) / تَصَرُّف",
 "みずあさぎ": "أَزْرَق فَاتِح (بدرجة فاتحة من الأزرق)",
 "みずあび": "استحمام, اغتسال (فعل غسل النفس (أو شخص آخر)) / سِبَاحَة",
 "みずあぶら": "زيت شعر, مستحضر للشعر (مستحضر تجميلي للعناية بالشعر) / كِيرُوسِين",
 "みずあめ": "شراب الذرة (شراب محضر من الذرة)",
 "みずいぼ": "مليساء معدية (مرض فيروسي يصيب الجلد يتميز بتورمات بيضاء مستديرة؛ ينتقل من شخص لآخر (غالبًا…)",
 "みずいらず": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله)\nمثال: كل الخضار الخاص بك.",
 "みずいらずで": "بشكل خاص, سراً (محتفظ به كسر أو مقتصر على المعنيين بالأمر)\nمثال: نوقش الأمر سراً",
 "みずいろ": "سَمَاوِيّ, لَبَنِيّ",
 "みずうみ": "بُحَيْرَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب)\nمثال: سبحنا في البحيرة.",
 "みずうら": "عرافة الماء (التنجيم بواسطة الماء)",
 "みずうらない": "عرافة الماء (التنجيم بواسطة الماء)",
 "みずおけ": "دلو, سطل (وعاء أسطواني الشكل مفتوح من الأعلى) / صِهْرِيج, فِنْطَاس (حوض تجتمع فيه الماء؛ وسيلة النقل التي تنقل الماء)\nمثال: الصهريج مملوء بالماء.",
 "みずかき": "ويب / مِضْرَب / سُور",
 "みずかまきり": "عقرب الماء (حشرة مائية طويلة الأرجل لها أرجل أمامية مهيأة للإمساك بالفريسة وبطن ممتد بأنبوب…)",
 "みずかみしも": "سَمَاوِيّ, لَبَنِيّ",
 "みずから": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على…)\nمثال: هم في نفس السن.",
 "みずからすすんで": "بتعمد, عمداً (بنية؛ بطريقة متعمدة)\nمثال: استخدم تلك الكلمة عمداً",
 "みずがき": "سُور",
 "みずがし": "فَاكِهَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها)\nمثال: التفاح فاكهة لذيذة.",
 "みずがめ": "إبريق ماء, جرة ماء (إبريق يحفظ الماء)",
 "みずがめざ": "بُرْج اَلدَّلْو, الدَّلْو (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "みずがめ座": "بُرْج اَلدَّلْو, الدَّلْو (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "みずがれ": "جَفَاف",
 "みずき": "شجرة القرانيا, قرانيا (شجرة أو شجيرة من جنس قرانيا غالباً ما يكون لها قنابات مبهرجة تشبه الزهور)",
 "みずききん": "جَفَاف",
 "みずきょうふしょう": "رهاب الغرق, رهاب الماء (خوف مرضي من الغرق)",
 "みずきり": "إجهاد, توتر (مجهود مكثف أو عنيف) / مِصْفَاة / قدم أمامية (قدم أمامية لذوات الأربع) / وثب الحجارة (لعبة يتم فيها نط حجر مسطح على سطح ماء هادئ)",
 "みずきりだい": "لوح تجفيف (لوح بجانب حوض المطبخ ومائل لتصريف المياه في الحوض)",
 "みずきりだな": "لوح تجفيف (لوح بجانب حوض المطبخ ومائل لتصريف المياه في الحوض)",
 "みずきん": "رَشْوَة, رِشْوَة\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "みずぎ": "مايوه, ملابس سباحة (رداء ضيق يلبس للسباحة)",
 "みずぎせる": "شِيشَة, نَارْجِيلَة",
 "みずぎわ": "جانب الماء (أرض متاخمة لجسم مائي)\nمثال: 彼らは水際でキャンプをした。 — خيموا على حافة الماء. / حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما.",
 "みずくき": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما)\nمثال: تعبت من الكتابة.",
 "みずくさ": "نبات مائي (نبات ينمو جزئياً أو كلياً في الماء سواء كان متجذراً في الطين، مثل اللوتس، أو…)",
 "みずくさい": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا. / رَقِيق, مَائِيّ (مُخَفَّف أَكْثَر مِنَ اللَّازِم؛ ضَعِيف وَبِلَا طَعْم)",
 "みずぐき": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما)\nمثال: تعبت من الكتابة.",
 "みずぐすり": "جُرْعَة",
 "みずぐち": "فوهة, مصب (فتحة تسمح بمرور السوائل أو الحبوب)",
 "みずぐるま": "توربين مائي, عجلة مائية (عجلة تدور بفعل التأثير المباشر للماء؛ توربين بسيط) / عنفة مائية",
 "みずけ": "رُطُوبَة",
 "みずけむり": "مرذاذ (موزع يحول السائل (مثل العطر) إلى رذاذ ناعم)\nمثال: رشقة من الرصاص",
 "みずこし": "مرشح مياه (مرشح لإزالة الشوائب من إمدادات المياه)",
 "みずこぼし": "دلو الفضلات السائلة (دلو كبير يستخدم لاستقبال مياه الصرف من حوض الغسيل)",
 "みずごけ": "سفاغنوم, طحلب الخث (أي من الحزازيات الشاحبة أو الرمادية المختلفة من جنس سفاغنوم التي تشكل بقاياها…)",
 "みずさいばい": "زراعة مائية (تقنية زراعة النباتات (بدون تربة) في ماء يحتوي على مغذيات مذابة)",
 "みずさきあんない": "إرشاد, قيادة (مهنة الطيار أو المرشد البحري)",
 "みずさきあんないせん": "قارب المرشد (قارب لنقل المرشدين من وإلى السفن الكبيرة)",
 "みずさきあんないにん": "طَيَّار, طَيَّارَة (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "みずさきにん": "طَيَّار, طَيَّارَة (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "みずさし": "إِبْرِيق, زِير",
 "みずさわ": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر…)",
 "みずし": "أَعْمَال مَنْزِل, أَعْمَال الْمَنْزِل (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما…)\nمثال: أنا في رحلة أعمال. / خادم المطبخ (خادم مطبخ يعمل للقيام بمهام وضيعة (خاصة الغسيل))",
 "みずしぶき": "رش, طرطشة (فعل نثر الماء بشكل عشوائي)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "みずしも": "سائل أمينوسي, سائل سلوي (السائل المصلي الذي يعلق فيه الجنين داخل السلى)",
 "みずしょう": "انْسِيَابِيَّة, سُيُولَة (صفة متغيرة)\nمثال: انسيابية شرقية ساحرة في الأسلوب",
 "みずしらず": "غَرِيب, عَجِيب\nمثال: どうして見ず知らずの男が自分の名前を知っているんだろう？ — كيف يعرف شخص أجنبيّ تماما اسمه؟ / عَدَم أُلْفَة, غَرَابَة (الغرابة نتيجة لعدم كون الشيء معروفاً جيداً)",
 "みずじも": "سائل أمينوسي, سائل سلوي (السائل المصلي الذي يعلق فيه الجنين داخل السلى)",
 "みずすまし": "دُوَّامَة, جِرِنُوسِيَّة / بق الماء المتزحلق (بق طويل الأرجل ينزلق على سطح الماء)",
 "みずせっけん": "صابون سائل (صابون في شكل سائل)",
 "みずぜめ": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه)\nمثال: أعطاه الحلاق قصة جيدة",
 "みずそこ": "قاع النهر (قناة يشغلها (أو كان يشغلها) نهر)",
 "みずた": "حقل أرز (حقل مروي أو مغمور يُزرع فيه الأرز)",
 "みずたいほう": "مِدْفَع مَاء (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض…)",
 "みずたま": "بولكا دوت, منقط (تصميم يتكون من نمط من البقع الدائرية المتباعدة بانتظام)",
 "みずたまもよう": "بولكا دوت, منقط (تصميم يتكون من نمط من البقع الدائرية المتباعدة بانتظام)",
 "みずたまり": "غَدِير, بِرْكَة",
 "みずだめ": "بالوعة, بيارة (صهريج مغطى؛ تتدفق إليه مياه الصرف الصحي والمجاري)",
 "みずっぱな": "رَشْح (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى)",
 "みずっぽい": "رَقِيق, مَائِيّ (مُخَفَّف أَكْثَر مِنَ اللَّازِم؛ ضَعِيف وَبِلَا طَعْم) / سِبَاقِيّ (مُصَمَّمٌ أَوْ مُنَاسِبٌ لِلتَّنَافُسِ فِي سِبَاق)",
 "みずでうすめる": "خَفَّفَ (قلل شيئًا أو نقص من حدته؛ هون أو لطف من شدة أمر)\nمثال: خفف زيري السرعة.",
 "みずでっぽう": "رشاش ماء, مسدس مائي (لعبة تتكون من مسدس لعبة يرش الماء)",
 "みずとり": "طائر مائي (طائر مائي يعيش في المياه العذبة)",
 "みずどけい": "سَاعَةٌ مَائِيَّة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا…)\nمثال: درست لمدة ساعة.",
 "みずどり": "طائر مائي (طائر مائي يعيش في المياه العذبة)",
 "みずなぎどり": "نوء (طائر صغير نسبياً طويل الجناحين أنبوبي الأنف يطير بعيداً عن اليابسة)",
 "みずなしがわ": "وادي (أخدود أو قاع سيل في شمال أفريقيا والشرق الأوسط يظل جافاً إلا خلال موسم الأمطار)",
 "みずにながす": "غَفَرَ وَنَسِيَ",
 "みずぬき": "مُرْهِق, مُنْهِك (له أثر مُوهِن ومُنهِك للقوى) / بَالُوعَة",
 "みずぬれ": "تبليل, ترطيب (فعل جعل الشيء مبللاً)",
 "みずのあわ": "لَا شَيْء (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "みずのえいぬ": "كلب الماء (كلب معتاد على الماء وعادة ما يتم تدريبه لاسترداد الطيور المائية)",
 "みずのえたつ": "آذريون المستنقع, قطيفة المستنقع (نبات مستنقعات من أوروبا وأمريكا الشمالية ذو أزهار صفراء زاهية تشبه الحوذان)",
 "みずのえね": "جرذ الماء (أي نوع من الجرذان البرمائية المختلفة)",
 "みずのせい": "جنية الماء (جنية تسكن الماء)",
 "みずのとうし": "جاموس الماء (جاموس آسيوي غالباً ما يتم استئناسه لاستخدامه كحيوان جر)",
 "みずのとみ": "ثعبان الماء (أي من ثعابين متنوعة غير ضارة في الغالب تعيش في الماء أو بالقرب منه)",
 "みずのみ": "مَاء شُرْب, مَاء صَالِح لِلشُّرْبِ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما…)\nمثال: أنا أشرب الماء. / زُجَاج, قزاز\nمثال: هل لي بكأس ماء؟ / فَلَّاح, فَلَّاحَة",
 "みずのみば": "سبيل ماء, نافورة شرب (نافورة عامة لتوفير تيار من مياه الشرب)",
 "みずはけ": "تَصْرِيف",
 "みずはな": "منطقة ساحلية, واجهة بحرية (منطقة في المدينة (مثل الميناء أو حوض السفن) تقع بمحاذاة مسطح مائي) / نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "みずはみがき": "غَسُولُ فَمّ",
 "みずば": "حمامات معدنية, منتجع صحي (منتجع صحي يقع بالقرب من نبع أو عند شاطئ البحر)",
 "みずばかり": "مقياس مستوى الماء, ميزان ماء\nمثال: أمطار الربيع رفعت منسوب المياه الجوفية",
 "みずばな": "رَشْح (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى) / منطقة ساحلية, واجهة بحرية (منطقة في المدينة (مثل الميناء أو حوض السفن) تقع بمحاذاة مسطح مائي) / نَجْمَة, اِبْتِدَاء\nمثال: بدأ سامي يتكلم.",
 "みずびたし": "تغطيس, غمر (فعل تبليل شيء بغمره)",
 "みずぶか": "قرش أزرق, قرش أزرق كبير (قرش نحيل عالمي الانتشار يعيش في عرض البحر؛ يتدرج لون جسمه الأزرق إلى بطن أبيض…)",
 "みずぶくれ": "بَطْبَاطَة, نَفْطَة",
 "みずぶとり": "مُتَرَهِّل",
 "みずぶね": "صِهْرِيج, فِنْطَاس (حوض تجتمع فيه الماء؛ وسيلة النقل التي تنقل الماء)\nمثال: الصهريج مملوء بالماء. / تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل)",
 "みずへびざ": "ثعبان الماء (أي من ثعابين متنوعة غير ضارة في الغالب تعيش في الماء أو بالقرب منه)",
 "みずへび座": "ثعبان الماء (أي من ثعابين متنوعة غير ضارة في الغالب تعيش في الماء أو بالقرب منه)",
 "みずべ": "جانب الماء (أرض متاخمة لجسم مائي)",
 "みずほのくに": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "みずぼうそう": "جدري الماء, حماق (مرض معدٍ حاد يسببه فيروس الهربس النطاقي الحماقي؛ يسبب طفحًا من الحويصلات على…)",
 "みずまき": "ري, سقي (التبليل بالماء)\nمثال: العشب يحتاج إلى الكثير من الري",
 "みずまし": "تَخْفِيف / تَضَخُّم (الزِّيادة المُفرِطة في الحجم؛ الزِّيادة المُفرِطة في الوسائل والأَشخاص)\nمثال: الجزائر تعاني من التضخم.",
 "みずましかぶ": "أسهم مخففة, أسهم وهمية (أسهم تمثل ملكية أصول مبالغ في قيمتها؛ أسهم شركة تكون قيمتها الإجمالية أقل من…)",
 "みずみずしい": "دَجِر",
 "みずむし": "سِعْفَة القَدَم, القَدَم الرِيَاضِي / بق الماء المجدف (بق مائي آكل للحوم له أرجل خلفية تشبه المجداف)",
 "みずめ": "كرز شرقي, كرز ياباني (شجرة زينة بفاكهة غير صالحة للأكل تزرع على نطاق واسع في العديد من الأصناف…)",
 "みずもの": "سَائِل, مَائِع / قِمَار",
 "みずもり": "مُسْتَوًى / تَسَرُّب\nمثال: سرب الطيور ذلك جميل جدا.",
 "みずもれ": "تَسَرُّب\nمثال: سرب الطيور ذلك جميل جدا.",
 "みずや": "مَطْبَخ (المكان الذي يُطْبَخُ فيه، غُرْفَة أو مساحة في البناء مخصصة للطبخ؛ في : هو…)\nمثال: سامي في المطبخ. / خِزَانَة (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "みずやり": "ري, سقي (التبليل بالماء)\nمثال: العشب يحتاج إلى الكثير من الري",
 "みずわらび": "جنية الماء (جنية تسكن الماء)",
 "みずをうったよう": "صَامِت, هَادِئ",
 "みずをかける": "عَاقَ, عَرْقَلَ",
 "みずをさす": "عَاقَ, عَرْقَلَ",
 "みずをやる": "مِيَاه",
 "みずイボ": "مليساء معدية (مرض فيروسي يصيب الجلد يتميز بتورمات بيضاء مستديرة؛ ينتقل من شخص لآخر (غالبًا…)",
 "みずガラス": "ساعة مائية, كليبسيدرا (ساعة تقيس الوقت عن طريق تدفق الماء)",
 "みずギセル": "شِيشَة, نَارْجِيلَة",
 "みずタバコ": "شِيشَة, نَارْجِيلَة",
 "みずパイプ": "شِيشَة, أرجيلة",
 "みせ": "خَزَنَ (حفظ، إدخر، أودع في مخزن)",
 "みせい": "غَيْرُ مُلْتَقَط, غَيْرُ مُنْجَز (لم يُلتقَط أو لم يُلتقَط داخل الحدود المسموحة)",
 "みせいじゅく": "عدم نضج (عدم الوصول إلى النضج)",
 "みせいせい": "خَامّ (وَخُمَ أو وَبِئَ؛ أقام في المكان أو استقر فيه)\nمثال: تنقل السفن المواد الخام من أندونيسيا.",
 "みせいた": "طَبَقَة",
 "みせいねん": "أَقَلِّيَّة\nمثال: 君は未成年だから入れません。 — ليس بإمكانك الدخول لأنك قاصر.",
 "みせいねんしゃ": "صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة)\nمثال: حصة صغيرة من الأرباح",
 "みせいり": "قَيْدَ الِانْتِظَار, مُعَلَّق (فِي انْتِظَارِ الِاخْتِتَامِ أَوِ التَّأْكِيدِ)",
 "みせかけ": "بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "みせかける": "اِدَّعَى\nمثال: تظاهر بأنه طبيب.",
 "みせぎょく": "طَبَقَة",
 "みせさき": "واجهة المتجر (الجانب الأمامي لمتجر يواجه الشارع؛ يحتوي عادة على نوافذ عرض)",
 "みせしめ": "دَرْس, حِصَّة ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: أراك بعد الدرس.",
 "みせじょろう": "مِن الطَّبَقَة الدُّنْيَا (يحتل أدنى مكانة اجتماعية واقتصادية في المجتمع)",
 "みせだな": "خَزَنَ (حفظ، إدخر، أودع في مخزن)",
 "みせっしゅ": "غَيْر مُطَعَّم, غَيْر مُلَقَّح (لم يتلقَّ التطعيم)",
 "みせつ": "بَارِز, مُمْتَدّ (يمتد للخارج فوق سطح أو حدّ أو ما وراءهما)",
 "みせつける": "استعراض, تباهي (فعل عرض شيء ما بتفاخر)\nمثال: كان سلوكه استعراضاً شائناً",
 "みせどころ": "معلم سياحي, مكان للعرض (مكان يتم عرضه وزيارته بشكل متكرر لاهتمامه التاريخي أو جماله الطبيعي)",
 "みせば": "إبراز ضوئي, منطقة مضيئة (منطقة من السطوع في الصورة)\nمثال: كان الجزء الأبرز في الجولة زيارتنا للفاتيكان / استعراضي, محب للظهور (شخص يتصرف عمداً بطريقة تجذب الانتباه)",
 "みせばん": "بَيَّاع, بَيَّاعَة",
 "みせびらかす": "استعراض, تباهي (فعل عرض شيء ما بتفاخر)\nمثال: كان سلوكه استعراضاً شائناً",
 "みせもの": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ…)\nمثال: ثبت مناد مكانه.",
 "みせものごや": "خيمة السيرك (خيمة قماشية لإيواء الجمهور في عرض السيرك)\nمثال: كان خائفاً من حريق في خيمة السيرك",
 "みせや": "خَزَنَ (حفظ، إدخر، أودع في مخزن)",
 "みせやぐら": "برج مراقبة, مرصد (هيكل يطل على مشهد واسع لمحيطه)",
 "みせる": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ…)\nمثال: ثبت مناد مكانه. / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "みせブラ": "استعراضي, محب للظهور (شخص يتصرف عمداً بطريقة تجذب الانتباه)",
 "みぜん": "سلفاً, مسبقاً (قبل الوقت؛ تحسباً)\nمثال: عندما تدفع مقدماً تحصل على خصم",
 "みぜんぼうし": "مَنْع (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "みそ": "مِيسُو / نقطة قوة (مكان ذو قوة خاصة)\nمثال: この電子辞書は携帯しやすいところが味噌です。 — من محاسن القاموس الإلكتروني أنه سهل الحمل. / ضعيف, واهن (شخص ضعيف جسدياً وغير فعال) / حَاوَلَ, سَعَى (طَلَبَ، رَامَ)\nمثال: حاول توم قتلنا! / يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم) / ثَلَاثِينَ, ثَلَاثُونَ",
 "みそか": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "みそかごと": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا. / وَصْل (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى)…)\nمثال: وصل السيد باكر.",
 "みそかす": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "みそかづき": "مُحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة…)",
 "みそぎ": "وُضُوء, غُسْل",
 "みそくそ": "بشدة, بشكل بالغ (لدرجة شديدة أو خطيرة)\nمثال: أصابع متجمدة بشدة لدرجة أنه كان لا بد من بترها",
 "みそぐ": "تَابَ (تَابَ: عادَ إِلى اللَّهِ ورَجَعَ وأَنَابَ؛ تابَ اللهُ عَلَيْهِ: أَي عادَ…)",
 "みそこなう": "أَسَاء اَلْفَهْم, أَخْطَأَ\nمثال: كان خطأ حاسوبي. / تقدير مفرط, مغالاة في التقدير (حساب ينتج عنه تقدير مرتفع جداً) / صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "みそしき": "غير منظم (لا يملك أو ينتمي إلى كل منظم)\nمثال: الأقاليم غير المنظمة تفتقر لحكومة رسمية",
 "みそじ": "ثَلَاثِينَ, ثَلَاثُونَ",
 "みそじひともじ": "شعب تانكا (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه…)\nمثال: الجيش يوحد الشعب.",
 "みそすり": "تملق, نفاق (ثناء مفرط أو غير صادق) / رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس…)",
 "みそすりぼうず": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس…)",
 "みそち": "ثَلَاثِينَ, ثَلَاثُونَ",
 "みそっかす": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "みそひともじ": "شعب تانكا (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه…)\nمثال: الجيش يوحد الشعب.",
 "みそまめ": "فُول اَلصُّويَا",
 "みそら": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ…)",
 "みそれる": "اِسْتَخَفَّ, اِسْتَهَانَ",
 "みそをする": "تَمَلَّقَ, تَبَصْبَصَ",
 "みぞ": "خَنْدَق, أُخْدُود / روتين ممل (روتين ثابت ورتيب يصعب الهروب منه)\nمثال: وقعوا في روتين محادثة ممل / انقطاع, توقف (فعل تأخير أو قطع الاستمرارية)\nمثال: تم عرضه بدون فواصل إعلانية",
 "みぞう": "غَيْر مَسْبُوق (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "みぞがたこう": "قَنَاة",
 "みぞけずり": "تحزيز, تخديد (أخدود أو شق في قماش وغيره (وخاصة أخدود مقعر ضحل في بدن العمود))",
 "みぞほりき": "لوح تقديم خشبي (لوح خشبي أو طبق يتم عليه تقديم الطعام أو تقطيعه)",
 "みぞれ": "صقيع, مطر متجمد (ثلج ذائب جزئياً (أو خليط من المطر والثلج))",
 "みたい": "كَـ",
 "みたいだ": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "みたいです": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "みたいな": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "みたく": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "みたけ": "طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "みたざる": "أَصْغَر مِن, صُغْرَى مِن",
 "みたす": "رَضَّى / مَلَأَ",
 "みたて": "اِخْتِيَار, خِيَار / تَشْخِيص / تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث)\nمثال: انتقدوا حكمي على المتسابقين / مُقَارَنَة",
 "みたてる": "اِخْتَارَ / شَخَّصَ (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد…)\nمثال: هذا الشخص فنان. / قَاضٍ, قَاضِيَة\nمثال: حكم علي بالموت. / شَبَّهَ",
 "みたところ": "عَلَى مَا يَبْدُوْ, لِأَوَّلِ وَهْلَةٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "みたない": "أَصْغَر مِن, صُغْرَى مِن",
 "みたび": "ثلاثة أضعاف (بمعامل ثلاثة)\nمثال: زاد إيجارنا ثلاثة أضعاف في السنوات الخمس الماضية / مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "みたま": "الرُّوح الْقُدُس",
 "みたまや": "ضَرِيح, مَرْقَد",
 "みため": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب.",
 "みだし": "عُنْوَان (عُنْوَان)\nمثال: نسيت عنوان توم. / دَلِيل, فِهْرِس / كلمة بادئة (كلمة توضع في بداية سطر أو فقرة (كما في مدخل القاموس))",
 "みだしご": "كلمة بادئة (كلمة توضع في بداية سطر أو فقرة (كما في مدخل القاموس))",
 "みだしなみ": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب.",
 "みだす": "اِكْتَشَفَ / اِخْتَارَ / حا َسـِب / مُرْتَشٍ, فَاسِد",
 "みだら": "فَاحِش, قَذِر",
 "みだり": "أَنَانِيّ / مُتَهَوِّر / فَضْفَاض, واسِع / غير عقلاني, غير منطقي (غير متسق مع العقل أو لا يستخدمه)\nمثال: مخاوف غير عقلانية",
 "みだりかぜ": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك…)\nمثال: الماء بارد حقا.",
 "みだりがわしい": "قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ)",
 "みだりに": "دون داع (بدون أي ضرورة)\nمثال: هذا الماراثون سيرهقه دون داع / باستهتار, بتهور (بطريقة متهورة)",
 "みだれ": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل)",
 "みち": "فقمة ذات أذنين (ثديي زعنفي الأقدام له سديلات أذن خارجية وأطراف خلفية تُستخدم للحركة على الأرض…) / طَرِيق, سِكَّة (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق. / طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق. / بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق. / لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد. / رَحِيق / عَسَل, شَهْد (عَسَل)\nمثال: يصنع النحل العسل. / مغثر\nمثال: يا لها من جملة! / ابتذال عاطفي (كتابة أو موسيقى حلوة وعاطفية بشكل مفرط)",
 "みちあんない": "إِرْشَاد, هِدَايَة / دليل إرشادي, قاعدة عامة (قاعدة أو مبدأ يوفر توجيهاً للسلوك المناسب)",
 "みちいと": "خيط الصيد, سنارة (طول من الحبل يُربط به القائد والعوامة والثقالة والخطاف)",
 "みちおしえ": "خُنْفُسَاء نَمِرِيَّة",
 "みちがう": "أَسَاء اَلْفَهْم, أَخْطَأَ\nمثال: كان خطأ حاسوبي.",
 "みちがえる": "أَسَاء اَلْفَهْم, أَخْطَأَ\nمثال: كان خطأ حاسوبي.",
 "みちくさをくう": "ضَيَّعَ اَلْوَقْت",
 "みちしお": "ذروة المد, مد عالي (المد عندما يكون الماء في أعلى مستوياته)",
 "みちしば": "إِرْشَاد, هِدَايَة",
 "みちしるべ": "دليل إرشادي, قاعدة عامة (قاعدة أو مبدأ يوفر توجيهاً للسلوك المناسب) / مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته…)\nمثال: كيف استطيع الحصول على مرشد سياحي. / خُنْفُسَاء نَمِرِيَّة",
 "みちじゅん": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق.",
 "みちすう": "مَجْهُول, مُبْهَم / كمية مجهولة, مجهول (متغير تكون قيمه حلولاً لمعادلة)\nمثال: لا أعرف ماذا سيفعل الرجل الجديد؛ لا يزال عاملاً مجهولاً",
 "みちすじ": "طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: هذا الطبق لذيذ. / استدلال, تفكير منطقي (تفكير متماسك ومنطقي)",
 "みちずれ": "رفيق, رفيق السفر (مسافر يرافقك)",
 "みちたりる": "نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "みちづれ": "رفيق, رفيق السفر (مسافر يرافقك)",
 "みちなか": "على الطريق, في جولة (التجوال في الأرجاء)\nمثال: أخذوا العرض في جولة / فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "みちなかば": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف)\nمثال: كان في منتصف السلم عندما سقط",
 "みちならぬ": "فاسد, لا أخلاقي (ينتهك عمداً المبادئ المقبولة للصواب والخطأ)",
 "みちにまよう": "اُغْرُب عَن وَجْهِي!, إِبْتَعِد عَنِّي!",
 "みちのり": "بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / طَرِيق, صِرَاط (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق.",
 "みちばしり": "جواب (الجَوَاب : ما يكون رَدًّا على سؤالٍ أَو دعاءٍ أَو دَعْوَى، أَو رسالةٍ أَو…)\nمثال: لقد وجدتم الجواب.",
 "みちばた": "جانب الطريق (حافة طريق أو مسار)\nمثال: زهور على جانب الطريق",
 "みちびき": "إِرْشَاد, هِدَايَة",
 "みちびきだす": "دَلَجَ, غَرَفَ\nمثال: واصل زيري الرسم.",
 "みちびきて": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته…)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "みちびく": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته…)\nمثال: كيف استطيع الحصول على مرشد سياحي. / استمد",
 "みちぶしん": "إنشاء الطرق, رصف الطرق (عملية بناء الطرق وتشييدها)",
 "みちべ": "جانب الطريق (حافة طريق أو مسار)\nمثال: زهور على جانب الطريق",
 "みちゃく": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "みちゃくしゅ": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "みちやなぎ": "عشب العقدة (عشب ضار منخفض النمو بسنيبلات على طول سيقان الأوراق)",
 "みちゆき": "ترحال, سفر (فعل الذهاب من مكان إلى آخر)\nمثال: استمتع بالبيع لكنه كره السفر",
 "みちゆくひと": "عابر سبيل, مار (شخص يمر بشكل عارض أو بالصدفة)",
 "みちる": "مَلَأَ / شَمْع, شَمَع ((شَمَعَ) يَشْمُعُ شَمْعًا، وشُمُوعًا: مَزَحَ وطَرِبَ)\nمثال: أشعل كين الشمع. / نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه. / نَاضِج, رَاشِد",
 "みちわき": "جانب الطريق (حافة طريق أو مسار)\nمثال: زهور على جانب الطريق",
 "みちをふみはずす": "ضَلَّ",
 "みちをゆずる": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث)\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "みぢか": "مَأْلُوف",
 "みぢかい": "مَأْلُوف",
 "みっかてんか": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا)",
 "みっかでんか": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا)",
 "みっかとあげず": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير)\nمثال: العالم يتغير باستمرار",
 "みっかにあげず": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير)\nمثال: العالم يتغير باستمرار",
 "みっかはしか": "حصبة ألمانية (مرض فيروسي معدٍ هو شكل أخف من الحصبة يستمر ثلاثة أو أربعة أيام؛ يمكن أن يضر…)",
 "みっかばしか": "حصبة ألمانية (مرض فيروسي معدٍ هو شكل أخف من الحصبة يستمر ثلاثة أو أربعة أيام؛ يمكن أن يضر…)",
 "みっかコロリ": "كُولِيرَا, هَيْضَة",
 "みっけい": "خطة سرية, لعبة (مخطط سري للقيام بشيء ما (خاصة شيء مخادع أو غير قانوني))\nمثال: دبروا مؤامرة لتشويه سمعة الحاكم",
 "みっける": "وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه…)\nمثال: وجد ياني هاتفه.",
 "みっこう": "تجوال خلسة, تسلل (فعل التجوال خلسة)",
 "みっこうしゃ": "مسافر خلسة (شخص يختبئ على متن سفينة أو طائرة أملاً في الحصول على رحلة مجانية)",
 "みっこく": "مَعْلُومَات, مَعْلُومَة",
 "みっこくしゃ": "مخبر, واشٍ (من يكشف معلومات سرية للشرطة أو سلطة أخرى)",
 "みっしつのぼうりょく": "عُنْف مَنْزَلِيّ, عُنْف أُسْرِيّ",
 "みっしゅう": "ثَوْل (بدا فيه الجنون) / تانترا, تانتريّة (عقيدة التنوير كإدراك لوحدانية الذات والعالم المرئي؛ تجمع بين عناصر الهندوسية…)",
 "みっしゅうほうじん": "سُلَامَى, سُلَامِيَّة",
 "みっしり": "بحتة, بشكل صارم (مقتصر على شيء ما)\nمثال: تحدثنا في العمل فقط (بشكل صارم) / بالكامل, تماماً (إلى أقصى درجة أو مدى؛ بشكل كامل أو كلي)\nمثال: نمى بالكامل / بتقارب, عن كثب (في علاقة أو موقع قريب في الزمان أو المكان)\nمثال: كانت البدايات متقاربة زمنياً",
 "みっせつ": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا…)\nمثال: أغلق الباب بغضب",
 "みっせん": "غدة رحيقية (غدة (غالباً ما تكون نتوءاً أو انخفاضاً) تفرز الرحيق)",
 "みっそ": "رمية البداية (فعل بدء لعبة كرة السلة بكرة قفز)",
 "みっちゃく": "طباعة بالتلامس (مطبوعة مصنوعة عن طريق تعريض سطح حساس للضوء للتلامس المباشر مع سلبية فوتوغرافية)",
 "みっちゃくいんが": "طباعة بالتلامس (مطبوعة مصنوعة عن طريق تعريض سطح حساس للضوء للتلامس المباشر مع سلبية فوتوغرافية)",
 "みっちり": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً)\nمثال: شعروا بالخسارة بعمق / بإحكام (مثبت أو مربوط بإحكام)\nمثال: النافذة كانت مغلقة بإحكام",
 "みっつ": "ثَلَاثَة, ثَلَاث (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "みっつう": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن",
 "みってい": "جَاسُوس / اكتشاف, رصد (فعل اكتشاف شيء ما؛ أو ملاحظة شيء ما)",
 "みっともいい": "بشكل صحيح, كما ينبغي (بالطريقة الصحيحة؛ بشكل لائق)\nمثال: أرجوك قم بعملك كما ينبغي!",
 "みっともない": "فَاضِح, مُخْزٍ ((للسلوك أو الشخصيَّة) يستحقّ العار أو يجلبه)",
 "みっぷ": "عَاشِق, عَاشِقَة",
 "みっぷう": "عزل الماء (فعل معالجة شيء ما لجعله طاردا للماء)",
 "みっぺいがた": "محاط, مرفق (مقفول عليه أو محاط أو متضمن في الداخل)\nمثال: شرفة مغلقة",
 "みつ": "ثَلَاثَة, ثَلَاث (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب. / رَحِيق / عَسَل, شَهْد (عَسَل)\nمثال: يصنع النحل العسل. / مغثر\nمثال: يا لها من جملة! / ابتذال عاطفي (كتابة أو موسيقى حلوة وعاطفية بشكل مفرط) / كَثِيف, غَلِيظ / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا…)\nمثال: أغلق الباب بغضب / دَقِيقَة, دِقيقة (وِحْدَة زَمَنِيَّة تساوي ستين ثَانِيَة، وجزءًا من ستّين جزءًا من السَّاعَة؛ في…)\nمثال: استأذنت لدقيقة. / سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا. / شَمْع, شَمَع ((شَمَعَ) يَشْمُعُ شَمْعًا، وشُمُوعًا: مَزَحَ وطَرِبَ)\nمثال: أشعل كين الشمع. / نَهَضَ, اِرْتَفْعَ (قَامَ)\nمثال: نهض توم على قدميه. / نَاضِج, رَاشِد",
 "みつあなぐま": "غُرَيْر العَسَل",
 "みつあみ": "ضَفَّرَ, ضَفَرَ",
 "みついろ": "عَسَلِيّ اللَّوْن (ذو لون العسل)",
 "みつうん": "رمية مفرطة (رمية تسقط أبعد من المكان المقصود)",
 "みつおり": "ثلاثة أضعاف (بمعامل ثلاثة)\nمثال: زاد إيجارنا ثلاثة أضعاف في السنوات الخمس الماضية",
 "みつかい": "مَلَاك\nمثال: زيري ملك لنفسه.",
 "みつかど": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "みつき": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب.",
 "みつぎ": "جِزْيَة / ضَرِيبَة / سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "みつぎもの": "جِزْيَة",
 "みつくち": "شفة أرنبية, شفة مشقوقة (شق خلقي في منتصف الشفة العليا)",
 "みつぐ": "تَمْوِيل, مَالِيَّة",
 "みつけ": "اِقْتَرَبَ\nمثال: هو واصل الاقتراب مني.",
 "みつけだす": "اِكْتَشَفَ",
 "みつける": "وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه…)\nمثال: وجد ياني هاتفه.",
 "みつげつ": "شَهْر عَسَل (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر…)\nمثال: رمضان شهر حرام.",
 "みつげんしょくぶつ": "نبات عسلي (نبات يوفر رحيقاً مناسباً لصنع العسل)",
 "みつご": "بِعُمُر ثَلَاث سَنَوَات (في عامه الثالث من العمر) / ثلاثي (مجموعة من ثلاثة أشياء متشابهة تُعتبر كوحدة واحدة) / كلمات معسولة, همسات الحب (تعبيرات عاطفية غير مهمة المضمون)\nمثال: همس بكلمات معسولة في أذنها",
 "みつごのたましいひゃくまで": "الطَّبْعُ يَغْلِبُ التَّطَبُّعَ",
 "みつざとう": "ابتذال عاطفي (كتابة أو موسيقى حلوة وعاطفية بشكل مفرط)",
 "みつじ": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ)\nمثال: السر سيبقى سرا.",
 "みつじん": "مُومِيَاء",
 "みつせん": "غدة رحيقية (غدة (غالباً ما تكون نتوءاً أو انخفاضاً) تفرز الرحيق)",
 "みつぞう": "خمر مهرب, مون شاين (ويسكي مقطر بشكل غير قانوني من هريس الذرة)\nمثال: ضوء القمر هو عدو المهرب",
 "みつぞうしゅ": "خمر مهرب, مون شاين (ويسكي مقطر بشكل غير قانوني من هريس الذرة)\nمثال: ضوء القمر هو عدو المهرب",
 "みつぞろい": "بدلة ثلاثية القطع (بدلة عمل تتكون من سترة وصدرية وبنطال)",
 "みつだえ": "لَوْحَة زَيْتِيَة",
 "みつつぼ": "أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية)",
 "みつど": "كَثَافَة (مصدر لكَثَفَ؛ اللغلظ والثخانة)\nمثال: هذه منطقة من الغابة أقل كثافة",
 "みつどもえ": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "みつどもえのあらそい": "ثُلَاثِيّ (يشمل مجموعة أو ثلاثة أطراف)",
 "みつにく": "أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية)",
 "みつば": "نَفَل (الثَلَاثُ النُفَل: الليلة الرابعة والخامسة والسادسة من كل شهر قمري…)",
 "みつばあおい": "زنجبيل بري (عشب معمر منخفض النمو ذو أوراق زنجبيلية حريفة وجذامير)",
 "みつばい": "تَهْرِيب",
 "みつばいにん": "مُهَرِّب",
 "みつばいばい": "تَهْرِيب",
 "みつばいひん": "تَهْرِيب",
 "みつばち": "نحل العسل (نحل اجتماعي يتم تدجينه غالباً من أجل العسل الذي ينتجه)",
 "みつぼう": "دَسِيسَة",
 "みつぼうえき": "تَهْرِيب",
 "みつぼし": "نِطَاق الجَبَّار (الحزام المصنوع من القماش ليس له إبزيم ولا ما أشبه؛ قطعة من القماش تُلفّ على وسط…)\nمثال: هل تمثل الزراعة على نطاق واسع النظام البيئي في الجزائر؟",
 "みつまた": "ثُلَاثِيُّ الشُّعَب (ذُو ثَلَاثِ شُعَب)",
 "みつみつ": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه…)\nمثال: أبقو حبهما سرا.",
 "みつめなおす": "حَلَّلَ (بالمكان: جعله يحل به؛ الشيء: جعله حلالا بعد أن كان حراما)\nمثال: حلل زيري ذلك الفيديو.",
 "みつめる": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ…)\nمثال: حدق الجميع في وجهي.",
 "みつもり": "تثمين, تقدير (حكم على صفات شيء أو شخص ما)\nمثال: في تقديري الصبي بريء",
 "みつもりかかく": "اِقْتِبَاس, اِسْتِشْهَاد (مصدر : اقتبس؛ واقْتَبَسَهَا: أَخَذَهَا . واقْتَبَسَ العِلْمَ وَمن العِلْم:…)\nمثال: تحصلت على علامة أ.",
 "みつもりしょ": "اقتباس (ممارسة الاقتباس من الكتب أو المسرحيات وغيرها)\nمثال: بما أنه يفتقر إلى الأصالة، يجب عليه الاعتماد على الاقتباس",
 "みつもる": "تثمين, تقدير (حكم على صفات شيء أو شخص ما)\nمثال: في تقديري الصبي بريء",
 "みつゆ": "تَهْرِيب",
 "みつゆせん": "مُهَرِّب",
 "みつゆにん": "مُهَرِّب",
 "みつりょう": "صَيْد جَائِر",
 "みつりょうしゃ": "صَيَّاد غَيْر قَانُونِيّ (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "みつりん": "أَجَمَة, أَدْغَال / نَهْر الأمازون, الأَمَزونْ (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ…)\nمثال: عبر جوناس النهر.",
 "みつろう": "شَمْع الْعَسَل ((شَمَعَ) يَشْمُعُ شَمْعًا، وشُمُوعًا: مَزَحَ وطَرِبَ)\nمثال: أشعل كين الشمع.",
 "みづらい": "غير مميز, غير واضح (غير محدد بوضوح أو ليس من السهل إدراكه أو فهمه)\nمثال: أشكال غير واضحة في الظلام",
 "みてい": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "みていぎ": "غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة)\nمثال: مصطلح غير محدد (مبهم)",
 "みてくれ": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب.",
 "みてとる": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد…)\nمثال: لم أدرك أبدا أنه يحبني.",
 "みてまわる": "تَلَفَّتَ",
 "みてもらう": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ)\nمثال: رأى ياني منزلا. / نَصَحَ (نصحه: أَرْشَدَه وأَشَارَ عليه)\nمثال: نصح مناد بباية.",
 "みと": "أَعْضَاء تَنَاسُلِيَّة / مِيتُو",
 "みとう": "بِلَا مَسَالِك, وَعْر (يفتقر إلى الممرّات والطرق المعبَّدة) / بَعِيد المَنَال, لَا يُمكِن الوُصُول إِلَيْه (يقع في مكان يتعذّر الوصول إليه)",
 "みとうき": "غَيْر مُسَجَّل ((عَنِ القَارِب أَوِ السَّفِينَة) غَيْر مُزَوَّد بِالوَثَائِق الرَّسْمِيَّة)\nمثال: مواطن غير مسجل",
 "みとうさ": "غَيْر مُكْتَشَف (لم يُكتشَف بعد)",
 "みとうろく": "غَيْر مُسَجَّل ((عَنِ القَارِب أَوِ السَّفِينَة) غَيْر مُزَوَّد بِالوَثَائِق الرَّسْمِيَّة)\nمثال: مواطن غير مسجل",
 "みとおし": "مَنْظُور, نَظْرَة / تَنَبَّأَ / نظرة ثاقبة",
 "みとおす": "قَرَأَ (نَطَقَ بما هو مكتوب؛ تَتَبَّعَ ما هو مكتوب وفَهِمَه)\nمثال: قرأ سامي الرسالة. / تَوَقَّعَ",
 "みとがめる": "سُؤَال, سؤال (سُؤَال)\nمثال: أجب على السؤال.",
 "みとし": "حَبَة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة)\nمثال: أكلت حبة طماطم.",
 "みとどけ": "غَيْر مُبَلَّغ عَنْه (لم يتم الإبلاغ عنه)\nمثال: نتائج غير مبلغ عنها",
 "みとどける": "تَيَقَّنَ, تَثَبَّتَ",
 "みとめ": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم…)\nمثال: أميل إلى قبول العرض. / ختم توقيع (ختم (خاصة الذي يستخدم لتمييز الوثائق رسمياً))",
 "みとめあう": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "みとめいんつきゆびわ": "خاتم الختم (خاتم يحمل ختماً)",
 "みとめる": "تَعَرَّفَ / حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت. / صَدَّقَ, وَافَقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع)\nمثال: صدق سامي كل شيء. / أَعْتَرَفَ",
 "みとり": "اِدْرََاك حَسِّيّ / تَمْرِيض (تَمْرِيض: اعتنى بالمَرِيض أثناء مرضه؛ التَمْرِيض: المهنة التي يقوم أصحابها…) / خنفساء ساعة الموت (تحفر في الخشب وتصدر صوتاً يشبه دقات الساعة يعتقد شعبياً أنه ينذر بالموت)",
 "みとりず": "مُخَطَّط أَرْضِيَّة الدَّوْر",
 "みとる": "مُمَرِّض\nمثال: هذا المرض قلبي. / أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد…)\nمثال: لم أدرك أبدا أنه يحبني.",
 "みどう": "مَعْبَد / كَاتِدْرَائِيَّة",
 "みどく": "غَيْرُ قَارِئ (لم يكتسب معرفة عن طريق القراءة) / تذوق (أخذ كمية صغيرة في الفم لاختبار جودتها)\nمثال: كان الطهي جيدًا ولكن التذوق هو ما استمتع به أكثر",
 "みどころ": "إبراز ضوئي, منطقة مضيئة (منطقة من السطوع في الصورة)\nمثال: كان الجزء الأبرز في الجولة زيارتنا للفاتيكان / وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به)\nمثال: وعد بأن يتزوجها.",
 "みども": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "みどり": "أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات…)\nمثال: ذلك الضوء أخضر. / خضرة (أوراق خضراء)",
 "みどりいろ": "أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات…)\nمثال: ذلك الضوء أخضر.",
 "みどりがかった": "أَخْضَر (بلون بين الأزرق والأصفر في الطيف اللوني؛ مشابه للون العشب الطازج)",
 "みどりご": "رَضِيع",
 "みどりざる": "سعدان أخضر (قرد سافانا شائع ذو ظهر رمادي مخضر وذيل أصفر)",
 "みどりつばめ": "سنونو الشجر (من أستراليا وبولينيزيا؛ يعشش في تجاويف الأشجار)",
 "みどりのおばさん": "حارِس عُبُور (شخص يساعد الناس (خاصة الأطفال) عند معبر المرور)",
 "みどりのかくめい": "ثورة خضراء (إدخال المبيدات الحشرية والحبوب عالية الغلة والإدارة الأفضل خلال الستينيات…)",
 "みどりのとう": "حزب الخضر (حزب سياسي بيئي)",
 "みどりのゆび": "مَهَارَة زِرَاعِيَّة, يَد خَضْرَاء (قدرة خاصة على جعل النباتات تنمو)",
 "みどりむし": "يوجلينا (كائن دقيق أخضر وحيد الخلية يعيش في المياه العذبة وله سوط واحد؛ يصنف غالباً…)",
 "みどりゆたか": "أَخْضَر, مُخْضَرّ (يتّسم بوَفْرة الخُضْرة والنبات)",
 "みどり児": "رَضِيع",
 "みどり色": "أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات…)\nمثال: ذلك الضوء أخضر.",
 "みどろ": "مُبَقَّع, مُلَطَّخ (موسوم أو مصبوغ أو متغير اللون بمادة غريبة)\nمثال: مفرش طاولة ملطخ بشدة",
 "みな": "الْجَمِيع, كُلّ شَخْص / كُلّ شَيْء",
 "みなうら": "عرافة الماء (التنجيم بواسطة الماء)",
 "みなおし": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق)\nمثال: وقفت الفصيلة جاهزة للتفتيش",
 "みなおす": "أَعَادَ الفحص, رَاجَعَ (نظر مرة أخرى؛ فحص مرة أخرى)\nمثال: لنراجع وضعك / حَسَّنَ (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "みなかみ": "أعالي النهر, منبع النهر (مصدر النهر)\nمثال: منابع النيل",
 "みながみな": "اَلْجَمِيع, كُلّ شَخْص",
 "みなぎる": "فَيَضَان",
 "みなごろし": "مَذْبَحَة, مَجْزَرَة (الحَادِثَة أو المَعْرَكَة التي يقتل فيها ناس كثيرون)\nمثال: قتل الصياد دبا.",
 "みなさま": "الْجَمِيع, كُلّ شَخْص",
 "みなさまがた": "الْجَمِيع, كُلّ شَخْص",
 "みなさん": "كُلّ, جَمِيع",
 "みなし": "حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام…)\nمثال: حكم علي بالموت.",
 "みなしがわ": "وادي (أخدود أو قاع سيل في شمال أفريقيا والشرق الأوسط يظل جافاً إلا خلال موسم الأمطار)",
 "みなす": "تحديق, نظرة ثابتة (نظرة ثابتة وطويلة)\nمثال: ثبت نظرته الأبوية علي",
 "みなそこ": "قاع النهر (قناة يشغلها (أو كان يشغلها) نهر)",
 "みなつき": "يُونِيُو, حَزِيرَان (الشهر السادس في السنة الميلادية الغربية المعرّبة)\nمثال: ستتزوج ابنتي في يونيو",
 "みなづき": "يُونِيُو, حَزِيرَان (الشهر السادس في السنة الميلادية الغربية المعرّبة)\nمثال: ستتزوج ابنتي في يونيو",
 "みなと": "مرفأ, ملاذ (مكان للملجأ والراحة والأمان)",
 "みなのしゅう": "اَلْجَمِيع, كُلّ شَخْص",
 "みなのもの": "اَلْجَمِيع, كُلّ شَخْص",
 "みなまたびょう": "داء ميناماتا (شكل من أشكال التسمم بالزئبق بين الأشخاص الذين أكلوا الأسماك من مياه خليج…)",
 "みなまで": "النِهاية",
 "みなみ": "جَنُوب (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "みなみいる": "تَحْتَ (أَقَلَّ)\nمثال: أنا تحت الشجرة.",
 "みなみかいきせん": "مَدَار الْجَدْي (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير)\nمثال: انتشرت الشائعة على مدار الدولة.",
 "みなみかぜ": "رياح جنوبية (رياح تهب من الجنوب) / صَيْف, صيف (فصل من فصول السنة الأربعة، يلي الرَّبِيع ويأتي بعده الخَرِيف، يتميز بشدة الحَرّ)\nمثال: نأتي هنا كل صيف.",
 "みなみがわ": "الجانب الجنوبي (الجانب الذي يقع في الجنوب)",
 "みなみごち": "رياح شرقية (رياح تهب من الشرق)",
 "みなみしなかい": "بَحْر الصِّين الْجَنُوبِيّ (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "みなみじゅうじ": "صَلِيب اَلْجَنُوب",
 "みなみじゅうじざ": "مَرْبِط الْفَرَس",
 "みなみじゅうじせい": "صَلِيب اَلْجَنُوب",
 "みなみじゅうじ座": "مَرْبِط الْفَرَس",
 "みなみたいへいよう": "جنوب المحيط الهادئ (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "みなみちょうせん": "كُورِيَا الْجَنُوبِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة…)\nمثال: أريد أن أزور كوريا.",
 "みなみな": "كُلّ, جَمِيع / كُلّ شَيْء",
 "みなみなさま": "الْجَمِيع, كُلّ شَخْص",
 "みなみにし": "باتجاه الجنوب الغربي (إلى أو نحو أو في الجنوب الغربي)",
 "みなみのさんかくざ": "الْمُثَلَّث الْجَنُوبِيّ",
 "みなみのさんかく座": "الْمُثَلَّث الْجَنُوبِيّ",
 "みなみはんきゅう": "نِصْف اَلْكُرَة الْأَرْضِيَّة الجَنُوبِيّ",
 "みなみひがし": "باتجاه الجنوب الشرقي (إلى أو نحو أو في الجنوب الشرقي)",
 "みなみより": "جنوبياً, من الجنوب (قادماً من الجنوب)\nمثال: هبت رياح جنوبية",
 "みなみア": "جَنُوب أَفْرِيقْيَا, أَفْرِيقِيَا الْجَنُوبِيَّة (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "みなみアジア": "جَنُوب آسِيَا (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "みなみアジアごぞく": "اللغات الأسترو آسيوية (عائلة من اللغات يتم التحدث بها في جنوب وجنوب شرق آسيا)",
 "みなみアフリカ": "جَنُوب أَفْرِيقْيَا, أَفْرِيقِيَا الْجَنُوبِيَّة (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "みなみアフリカきょうわこく": "جُمْهُورِيَّة جَنُوب أَفْرِيقْيَا",
 "みなみアフリカこうくう": "جنوب أفريقي (متعلق بجنوب أفريقيا أو شعبها أو مميز لها)",
 "みなみアフリカじゅんびぎんこう": "جنوب أفريقي (متعلق بجنوب أفريقيا أو شعبها أو مميز لها)",
 "みなみアフリカじん": "جنوب أفريقي (متعلق بجنوب أفريقيا أو شعبها أو مميز لها)",
 "みなみアフリカてんもんだい": "جنوب أفريقي (متعلق بجنوب أفريقيا أو شعبها أو مميز لها)",
 "みなみアフリカほうそうきょうかい": "جنوب أفريقي (متعلق بجنوب أفريقيا أو شعبها أو مميز لها)",
 "みなみアメリカ": "أَمْرِيكَا الْجَنُوبِيَّة, أَمِيرِكَا الْجَنُوبِيَّة",
 "みなみオポッサム": "أبوسوم شائع (أبوسوم قارت من شرق الولايات المتحدة؛ يشتهر بالتظاهر بالموت عند الخطر؛ يُقدر…)",
 "みなみオーストラリアしゅう": "جُنُوب أُسْتْرَالِيَا, أستراليا الجنوبية (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "みなみシナかい": "بَحْر الصِّين الْجَنُوبِيّ (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "みなみスーダン": "جَنُوب السُّودَان (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "みなみスーダンきょうわこく": "جمهورية جنوب السودان",
 "みなみヨーロッパ": "أُورُوبَّا اَلْجَنُوبِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته…)\nمثال: ذهبت إلى أوروبا مرة.",
 "みなもと": "مَصْدَر, مَصَادِر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "みならい": "تدريب مهني, تلمذة مهنية (منصب المتدرب المهني) / مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "みならいこう": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "みならう": "قَلَّدَ / تَعَلَّمَ (اكتسب معرفة أو خبرة أو مهارة)\nمثال: هو سريع التعلم.",
 "みなり": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "みなわ": "رَغْوَة\nمثال: اشترت رطلي زبدة. / لَا شَيْء (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "みにいく": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة)\nمثال: زار سامي مسجدا.",
 "みにおぼえのある": "مَأْلُوف",
 "みにくい": "قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح. / كَرِيه المَنْظَر (غير سار للنظر) / مُظْلِم",
 "みにくいあひるのこ": "بَطَّة قَبِيحَة (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة…)\nمثال: إني أصوب على تلك البطة.",
 "みにくいあひるの子": "بَطَّة قَبِيحَة (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة…)\nمثال: إني أصوب على تلك البطة.",
 "みにくいアヒルの子": "بَطَّة قَبِيحَة (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة…)\nمثال: إني أصوب على تلك البطة.",
 "みにくる": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة)\nمثال: زار سامي مسجدا.",
 "みにつく": "سَيِّد\nمثال: يبدو زيري أحسن. / أَبْقَى\nمثال: حفظ رقم هاتفها.",
 "みにつける": "تَعَلَّمَ (اكتسب معرفة أو خبرة أو مهارة)\nمثال: هو سريع التعلم. / حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "みにでかける": "حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً…)\nمثال: حضر كل شيئ لرحلتي.",
 "みにまとう": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "みにゅうりょく": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه…)\nمثال: عندي ابنا خالة.",
 "みぬく": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد…)\nمثال: لم أدرك أبدا أنه يحبني.",
 "みぬぐい": "منشفة وجه, منشفة يد (منشفة صغيرة تستخدم لتجفيف اليدين أو الوجه)",
 "みね": "أَوْجٌ, ذُرْوَةٌ",
 "みねずおう": "أزاليا ألبية, أزاليا جبلية (شجيرة دائمة الخضرة زاحفة تشكل حصيرة من المناطق الجبلية العالية في نصف الكرة…)",
 "みねみね": "أَوْجٌ, ذُرْوَةٌ",
 "みのある": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "みのうえばなし": "ترجمة حياة, سيرة ذاتية (سرد لسلسلة الأحداث التي تشكل حياة شخص ما)",
 "みのうしゃ": "متخلف عن الحضور, منسحب (متسابق يخسر المباراة لعدم الحضور)",
 "みのがし": "مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله)",
 "みのがす": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ. / صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "みのけ": "شَعْرُ الجِسْم (شعر قصير ينمو على جسم الإنسان)",
 "みのけのよだつ": "كَابُوسِيّ, مُقْشَعِرّ (مخيف إلى أقصى حد؛ يُجمِّد الدماء في العروق)",
 "みのこなし": "عَرَبَة",
 "みのごい": "منشفة وجه, منشفة يد (منشفة صغيرة تستخدم لتجفيف اليدين أو الوجه)",
 "みのしろきん": "فِدْيَة",
 "みのたけ": "طول, قامة ((لشخص واقف) المسافة من الرأس إلى القدم)\nمثال: رجل ذو قامة عظيمة",
 "みのたけにあう": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ)",
 "みのない": "غير جوهري, غير مادي (يفتقر إلى الشكل المادي أو المادة؛ غير حقيقي)\nمثال: غير جوهري مثل حلم",
 "みのほどしらず": "مُتَعَجْرِف, مُتَغَطْرِس (مُتَكَبِّرٌ بِشَكْلٍ وَقِحٍ وَمُتَجَاوِزٍ لِلْحُدُود)",
 "みのまわりひん": "أغراض شخصية, متعلقات شخصية (ممتلكات ذات طابع شخصي قابلة للحمل ولا تستخدم في الأعمال التجارية)\nمثال: تركت بعض متعلقاتها الشخصية في المنزل",
 "みのむしクリップ": "مشبك تمساح (مشبك بزمبرك يغلق الفكين المعدنيين)",
 "みのり": "إيناع, نضج (الوصول إلى التطور الكامل؛ أن يصبح ناضجًا) / مَحْصُول",
 "みのりある": "مجز, مرض (يوفر الرضا الشخصي)\nمثال: مهنة مجزية كمسعف",
 "みのりおおい": "مثمر",
 "みのる": "يَنَعَ, نَضَجَ (أَيْنَعَ؛ نَضَجَ)",
 "みの虫クリップ": "مشبك تمساح (مشبك بزمبرك يغلق الفكين المعدنيين)",
 "みはいとう": "غَيْرُ مُقَسَّم, مُوَحَّد (غير مُجزَّأ إلى أقسام أو حصص؛ يشكّل وحدة غير مقسّمة)",
 "みはからう": "تثمين, تقدير (حكم على صفات شيء أو شخص ما)\nمثال: في تقديري الصبي بريء",
 "みはしらもん": "خَوْخَة",
 "みはた": "عَلَم, رَايَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "みはっけん": "غَيْر مُكْتَشَف (لم يُكتشَف بعد)",
 "みはっこう": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "みはったつ": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "みはっぴょう": "غَيْر مَنْشُور (غير منشور)\nمثال: رسائل ومذكرات غير منشورة",
 "みはつ": "غَيْر مُكْتَشَف (لم يُكتشَف بعد)",
 "みはつばい": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "みはてぬ": "غير مكتمل, غير منتهٍ (لم يتم الانتهاء منه أو اختتامه)\nمثال: أعمال غير منتهية",
 "みはなす": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا!",
 "みはらい": "بلا أجر, غير مدفوع (لم يتم الدفع له)\nمثال: أجور غير مدفوعة",
 "みはらいきん": "متأخرات (دين غير مدفوع تجاوز موعد استحقاقه)\nمثال: حساب عليه متأخرات",
 "みはらし": "مَنْظَر, مَشْهَد / صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "みはらしだい": "برج مراقبة, مرصد (هيكل يطل على مشهد واسع لمحيطه)",
 "みはらす": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "みはり": "سَاعَة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا…)\nمثال: درست لمدة ساعة.",
 "みはりしょ": "نَاطُور",
 "みはりだい": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "みはりばん": "حَارِس\nمثال: كان لدى سامي حرس شخصي.",
 "みはりやく": "واجب الحراسة (واجب الخدمة كحارس)\nمثال: كان في واجب الحراسة تلك الليلة",
 "みはる": "حا َسـِب",
 "みば": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي)\nمثال: لا أحد لاحظ ظهور الدب.",
 "みばえ": "ذبابة الفاكهة (أي من الحشرات الصغيرة المتعددة التي تتغذى يرقاتها على الفواكه)",
 "みばしょう": "مَوْزَة\nمثال: هن بحاجة للموز.",
 "みばらい": "بلا أجر, غير مدفوع (لم يتم الدفع له)\nمثال: أجور غير مدفوعة",
 "みひらき": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب…)\nمثال: نشر توم الغسيل.",
 "みびいき": "تمييز, محاباة (المعاملة غير العادلة لشخص أو مجموعة على أساس التحيز)",
 "みびょう": "اعتلال الصحة, توعك (حالة تعجز فيها عن العمل بشكل طبيعي وبدون ألم) / قبل الأعراض, ما قبل السريري (مكون من أو متعلق بالمراحل المبكرة من المرض عندما لا يكون التشخيص الدقيق ممكناً…)",
 "みふたつになる": "وَلَدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه)\nمثال: أعرف ذلك الولد.",
 "みぶり": "لَفْتَة, إِشَارَة",
 "みぶりげんご": "لُغَةُ الْجَسَدِ (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل…)\nمثال: الأمازيغية لغة.",
 "みぶりてぶり": "لَفْتَة, إِشَارَة",
 "みぶるい": "مُرْتَجِف, مُرْتَعِش (يهتز بشكل طفيف وغير منتظم كما من الخوف أو البرد)",
 "みぶん": "مَنْزِلَة, مَكَانَة / مُطَابَقَة",
 "みぶんか": "غير متمايز, متجانس (غير متمايز)",
 "みぶんがら": "تَرْتِيب, دَرَجَة (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء…)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "みぶんしょう": "هُوَ",
 "みぶんしょうめい": "بِطَاقَة هُوِيَّة",
 "みぶんしょうめいしょ": "هُوَ",
 "みぶんじこう": "وَثَائِق",
 "みぶんのたかい": "مُهِمّ",
 "みへんにゅう": "غَيْر مُسَجَّل كَشَرِكَة (غير منظم أو مُدار ككيان قانوني مؤسسي)",
 "みほそう": "ترابي, غير معبد (ليس له سطح معبد)",
 "みほとけ": "بُوذَا, بُدّ",
 "みほん": "عَيِّنَة / نَمُوذَج",
 "みぼうじん": "أَرْمَلَة",
 "みまい": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة)\nمثال: زار سامي مسجدا. / هَدِيَّة, هدية",
 "みまいきゃく": "سائل, مستفسر (شخص يطرح سؤالاً)",
 "みまいじょう": "بطاقة تمنيات بالشفاء (بطاقة تعبر عن تمنيات بالشفاء)",
 "みまう": "حَمْلَة",
 "みまえ": "حُضُور (حُضُور)\nمثال: الحضور هام جدا. / راكِب الطَّلِيعَة, مُرافِق مُتَقَدِّم (مرافق يركب (عادة دراجة أو حصاناً) في مقدمة الموكب)",
 "みまかる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "みまがう": "أَسَاء اَلْفَهْم, أَخْطَأَ\nمثال: كان خطأ حاسوبي.",
 "みまごう": "أَسَاء اَلْفَهْم, أَخْطَأَ\nمثال: كان خطأ حاسوبي.",
 "みまし": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "みまもる": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ…)\nمثال: حدق الجميع في وجهي.",
 "みまわす": "تَلَفَّتَ",
 "みまわり": "حَارِس",
 "みまわる": "دَوْرِيَّة, خَفْر",
 "みまわれる": "تَأَلَّمَ, عَانَى\nمثال: لقد عانى جمال كثيرا.",
 "みまん": "أَصْغَر مِن, صُغْرَى مِن",
 "みみ": "أُذُن (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً)\nمثال: من أذن لتوم باستعارة سيارتي? / سَمِيع (سَميع: (اسم)؛ سميع: (اسم))\nمثال: سمع سامي صريرا. / حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما)\nمثال: قام بتدوير حواف الصندوق",
 "みみあか": "صِمْلَاخ, شَمْع اَلْأُذْن",
 "みみあたらしい": "مُسْتَجِدّ",
 "みみあて": "غطاء للأذنين (زوج من أغطية الأذن (عادة ما تكون متصلة بطوق رأس) يتم ارتداؤها للحفاظ على دفء…)",
 "みみうどん": "أُذُنِيُّ الشَّكْلِ, أُذُنِيّ (ذو شكل يشبه الأذن)",
 "みみおおい": "غطاء الأذن (أحد لسانين متصلين بقبعة للحفاظ على دفء الأذنين)",
 "みみおち": "نَصْل (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة…)\nمثال: لن نصل إلى أي مكان.",
 "みみかざり": "قُرْط, حَلَق",
 "みみかす": "صِمْلَاخ, شَمْع اَلْأُذْن",
 "みみがくもん": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً)",
 "みみがね": "دودة الرمل (ديدان بحرية لها صف من الخياشيم المعنقدة على طول كل جانب من الظهر؛ تستخدم غالباً…)",
 "みみきり": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه)\nمثال: أعطاه الحلاق قصة جيدة",
 "みみくそ": "صِمْلَاخ, شَمْع اَلْأُذْن",
 "みみこすり": "تزلّف, تودد (فعل كسب القبول أو المودة عن طريق التملق المقنع والدقيق)\nمثال: رفضت استخدام التزلف لكسب الحظوة",
 "みみざとい": "حَادُّ السَّمْعِ, مُرْهَفُ الأُذُنِ (ذو سمع حادّ ومُرهَف)",
 "みみざわり": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار)\nمثال: هذا التخت جدا صلب.",
 "みみしい": "صَمَم",
 "みみずくがに": "سرطان العنكبوت (أي من السرطانات العديدة ذات الأرجل الطويلة جداً والأجسام المثلثة الصغيرة)",
 "みみずとかげ": "سحلية دودية (سحلية من جنس أمفيسباينا؛ سحلية غير ضارة تشبه الدودة وعديمة الأطراف من المناطق…)",
 "みみずばれ": "لوح جانبي (لوح سميك يشكل حافة على طول جانب سفينة خشبية)",
