 "ほだ": "إشعال, إضرام (عملية إضرام النار في شيء ما) / صوفان, قشاشة (مادة لبدء إشعال النار)",
 "ほだい": "سُدَّة, لِيمَّا",
 "ほだえる": "اِسْتَغَلَّ",
 "ほだぎ": "إشعال, إضرام (عملية إضرام النار في شيء ما) / صوفان, قشاشة (مادة لبدء إشعال النار)",
 "ほだす": "غُلّ, أَغْلال",
 "ほちょう": "خطوة, خطوة واسعة (خطوة في المشي أو الجري) / معدل, وتيرة (السرعة النسبية للتقدم أو التغيير) / ياردة (وحدة للطول تساوي 3 أقدام؛ محددة بـ 91.44 سنتيمتر) / خطوة (المسافة التي تغطيها خطوة)\nمثال: عاش بوتيرة سريعة",
 "ほちょうき": "سَمَّاعَةُ أُذُن, مُسَاعَدَات سَمْع",
 "ほっかい": "بَحَر اَلشَّمَال (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر. / هُوكَايْدُو, هُكَّايْدُو / كَوْن, الْكَوْن",
 "ほっかいどう": "هُوكَايْدُو, هُكَّايْدُو",
 "ほっかいどういぬ": "هُوكَايْدُو, هُكَّايْدُو",
 "ほっかいどうかいはつちょうちょうかん": "مُدِير عَامّ (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "ほっかいどうけん": "هُوكَايْدُو, هُكَّايْدُو",
 "ほっかいむえん": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)",
 "ほっかいゆでん": "بَحَر اَلشَّمَال (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "ほっかり": "بشكل ممتع, بلطف (بطريقة ممتعة) / بشكل لطيف, بمرح (بطريقة مرحة ولطيفة)\nمثال: قضينا ظهيرة كسولة بشكل ممتع / بشكل خافت, بضعف (بدرجة خافتة أو مدركة بضعف)\nمثال: بينه وبين الضوء الخافت تم تحديد شكل بشكل خافت / فَجْأَةً / بالصدفة, عرضياً (بدون تخطيط مسبق) / بشكل غير مقصود, دون قصد (بدون نية؛ بطريقة غير مقصودة) / بالصدفة, بشكل عرضي (ذو طبيعة ثانوية أو فرعية)\nمثال: التقيا بالصدفة",
 "ほっかん": "كُورِيَا الشَّمَالِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "ほっき": "بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية)) / ابْتِدَائِيّ, انْطِلَاقِيّ (مُنَاسِبٌ لِبِدَايَةِ حَدَثٍ أَوِ انْطِلَاقَتِهِ) / جَاحِظ ((خاصة العيون) منتفخ أو بارز كما في حالة الخوف)\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى / عَزْم, عُزْم / دِقَّة",
 "ほっきしょ": "دليل المقررات (كتالوج يسرد الدورات التي تقدمها كلية أو جامعة) / نَشْرَة إِصْدَار, نَشْرَة اكْتِتَاب (عرض مكتوب رسمي لبيع الأوراق المالية يحدد خطة لمؤسسة تجارية (مقترحة))\nمثال: يجب أن تحتوي نشرة الاكتتاب على الحقائق التي يحتاجها المستثمر لاتخاذ قرار مستنير",
 "ほっきにん": "العقل المدبر, مُبْتَكِر (شخص يبتكر أو ينشئ أشياء جديدة)",
 "ほっきょう": "كِيُوتُو",
 "ほっきょく": "اَلْقُطْب اَلشَّمَالِيّ\nمثال: 北極圏とは北極周辺の地域の事である。 — المنطقة القطبية هي تلك الواقعة حول القطب الشمالي. / قُطْبِيّ شَمَالِيّ",
 "ほっきょくいわな": "شار قطبي (ترويت صغير في المياه الشمالية؛ توجد مجموعات حبيسة في كيبيك وشمال نيو إنجلاند)",
 "ほっきょくおおかみ": "ذئب أبيض, ذئب قطبي (ذئب من القطب الشمالي لأمريكا الشمالية ذو فرو أبيض وذيل أسود الطرف)",
 "ほっきょくかい": "الْمُحِيط الْمُتَجَمِّد الشَّمَالِيّ, الْمُحِيط الشَّمَالِيّ",
 "ほっきょくぎつね": "ثعلب أبيض, ثعلب قطبي (ثعلب كثيف الفرو من المناطق القطبية؛ بني في الصيف وأبيض في الشتاء)",
 "ほっきょくくじら": "حوت مقوس الرأس (حوت قطبي كبير الفم)",
 "ほっきょくぐま": "دُبّ أَبْيَض, دُبَّة بَيْضَاء",
 "ほっきょくけん": "الدَّائِرَة الْقُطْبِيَّة الشَّمَالِيَّة\nمثال: 北極圏とは北極周辺の地域の事である。 — المنطقة القطبية هي تلك الواقعة حول القطب الشمالي.",
 "ほっきょくこう": "شفق قطبي ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "ほっきょくせい": "الجُدَيّ, نَجْم الشَمَال",
 "ほっきょくせん": "الدَّائِرَة الْقُطْبِيَّة الشَّمَالِيَّة",
 "ほっきょくちほう": "قُطْبِيّ شَمَالِيّ",
 "ほっきょくてん": "اَلْقُطْب اَلشَّمَالِيّ",
 "ほっきょくのうさぎ": "أرنب قطبي (أرنب بري كبير من شمال أمريكا الشمالية؛ يكون أبيض بالكامل تقريباً في الشتاء)",
 "ほっきょくよう": "الْمُحِيط الْمُتَجَمِّد الشَّمَالِيّ, الْمُحِيط الشَّمَالِيّ",
 "ほっく": "هَايْكُو",
 "ほっこう": "شفق قطبي ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه: رَقَّ له وعطف عليه؛ فهو شَفِيقٌ)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "ほっこく": "الأراضي الشمالية, الشمال (أي منطقة تقع في الشمال أو باتجاهه)",
 "ほっこくじん": "شمالي (أحد سكان الشمال) / شمالي, يانكي (أمريكي يعيش في الشمال (خاصة خلال الحرب الأهلية الأمريكية))",
 "ほっこり": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "ほっさ": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "ほっさせい": "انتيابي, نوبي (مصحوب بـ أو ذو طبيعة نوبات مفاجئة (انتياب))",
 "ほっさてき": "تَشَنُّجِيّ, نَوْبِيّ (يَحْدُثُ عَلَى شَكْلِ نَوْبَاتٍ وَغَالِبًا بِشَكْلٍ مُفَاجِئ) / تَشَنُّجِيّ, تَقَلُّصِيّ (يتأثر بتقلصات عضلية لاإرادية مفاجئة؛ يشبه التشنج)",
 "ほっし": "أُقْنُوم / فَرْد",
 "ほっしゅ": "حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى) / زعيم روحي, كاهن أعظم (سلطة بارزة أو مؤيد رئيسي لحركة أو مذهب ما)\nمثال: إنه الكاهن الأعظم لموسيقى الجاز المعاصرة",
 "ほっしん": "طَفْح, طَفْح جِلْدِيّ / عَزْم, عُزْم / دِقَّة",
 "ほっしんねつ": "تيفوس الفئران, تيفوس متوطن (عدوى حادة تسببها الريكتسيا وتنتقل عن طريق لدغة برغوث مصاب؛ تتميز بالحمى والقشعريرة وآلام العضلات والطفح الجلدي)",
 "ほっす": "حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى) / زعيم روحي, كاهن أعظم (سلطة بارزة أو مؤيد رئيسي لحركة أو مذهب ما)\nمثال: إنه الكاهن الأعظم لموسيقى الجاز المعاصرة",
 "ほっする": "أَرَادَ, رَغِبَ (شَاءَ الشيءَ، رَغِبَ فيه؛ أَحَبَّ، شَهِيَ، اِشْتَهَى. (تخصيص))\nمثال: أراد مني الكذب.",
 "ほっそく": "بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية)) / ابْتِدَائِيّ, انْطِلَاقِيّ (مُنَاسِبٌ لِبِدَايَةِ حَدَثٍ أَوِ انْطِلَاقَتِهِ) / جَاحِظ ((خاصة العيون) منتفخ أو بارز كما في حالة الخوف)\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى",
 "ほっそり": "نَحِيل / نَحِيف / أَهْيَف",
 "ほったてごや": "كُوخ, تَخْشِيبَة",
 "ほったて小屋": "كُوخ, تَخْشِيبَة",
 "ほったらかし": "أَهْمَلَ / إِهْمَال",
 "ほったらかしにする": "أَهْمَلَ / إِهْمَال",
 "ほったらかす": "أَهْمَلَ / إِهْمَال",
 "ほったん": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل",
 "ほっつきあるく": "تَجَوَّلَ",
 "ほっておく": "تَجَاهَلَ, طَنَّش",
 "ほっと": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً) / بِعُمْق (إلى عمق كبير؛ بعيداً للأسفل أو للداخل)\nمثال: شعروا بالخسارة بعمق",
 "ほっとう": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل / العقل المدبر, مُبْتَكِر (شخص يبتكر أو ينشئ أشياء جديدة)",
 "ほっとうにん": "العقل المدبر, مُبْتَكِر (شخص يبتكر أو ينشئ أشياء جديدة)",
 "ほっとく": "تَجَاهَلَ, طَنَّش",
 "ほっぴょうよう": "الْمُحِيط الْمُتَجَمِّد الشَّمَالِيّ, الْمُحِيط الشَّمَالِيّ",
 "ほっぺ": "خَدّ (شَقَّ أو حَفَرَ في الأرض خطاً طويلاً أو أثراً عميقاً؛ أثَّر على سطحٍ ما بترك علامات أو شقوق) / وَجْنَة\nمثال: قبلتني على الخد.",
 "ほっぺた": "خَدّ (شَقَّ أو حَفَرَ في الأرض خطاً طويلاً أو أثراً عميقاً؛ أثَّر على سطحٍ ما بترك علامات أو شقوق) / وَجْنَة\nمثال: قبلتني على الخد.",
 "ほっほう": "وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة!",
 "ほっぽう": "شَمَال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب) / شمال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "ほっぽうげんかいせん": "خَطُّ تَرْسِيم, خَطُّ التَّرْسِيم (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "ほっぽうよんとう": "مُقَاطَعَة شَمَالِيَّة",
 "ほっぽうりょうど": "مُقَاطَعَة شَمَالِيَّة",
 "ほっぽうりょうどもんだい": "جُزُر اَلْكُورِيل (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ البَحْرُ والنَّهْرُ: انْحسرَ ماؤُهُ)\nمثال: ضع الجزر في القدر.",
 "ほっぽうわ": "اَللُّغَة اَلصِّينِيَّة اَلشَّمَالِيَّة, مَنْدَرِينِيَّة",
 "ほっぽかす": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "ほっぽらかす": "أَهْمَلَ / إِهْمَال",
 "ほっぽりだす": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "ほっぽり出す": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ إِلَيْهَا، تَأَمَّلَهَا) / حَرِيق, حريجة (النَار المشتعلة في شيء كالدَار او الغَابَة) / طَرَدَ\nمثال: سمعن طلقات نار.",
 "ほっぽる": "عَلَاقَة سَرِيعَة, علاقة طيارى / صَبَّ, رَمَّى (سَكَبَ، الفرق بين صَبَّ وسَكَب أن الصَبّ يكون متعمدا والسكب قد يكون متعمدا أو خطأ؛ صَبَّ الطعام، أي سكبه في الإناء أو الصحون)\nمثال: صب الشاي لضيفك. / اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "ほつがん": "صَلَّى, دَعَا",
 "ほつぎ": "طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى بإلى))\nمثال: طلب زيري ورودا.",
 "ほつご": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "ほつす": "أَرْخَى, حَلَّ",
 "ほつねつ": "حُمَّة, حُمَّى",
 "ほつれ": "شِجَار عَلَنِيّ, عِرَاك (قتال صاخب)",
 "ほづな": "حبل الرفع (حبل لرفع أو خفض شراع أو علم)",
 "ほてい": "إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / ملابس للرتق (الملابس التي يجب إصلاحها) / إعادة كتابة, مراجعة (تحرير يتضمن كتابة الشيء مرة أخرى)",
 "ほていちく": "خيزران صنارة السمك (خيزران صغير من جنوب شرق الصين له سيقان رفيعة مرنة عندما تكون صغيرة)",
 "ほていばら": "مدفأة كرشية, موقد منتفخ (موقد منتفخ الشكل يتم فيه حرق الحطب أو الفحم) / كرش (مصطلحات عامية للكرش أو البطن البارز)",
 "ほてい腹": "مدفأة كرشية, موقد منتفخ (موقد منتفخ الشكل يتم فيه حرق الحطب أو الفحم) / كرش (مصطلحات عامية للكرش أو البطن البارز)",
 "ほてつ": "إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / ملابس للرتق (الملابس التي يجب إصلاحها) / بَدِيل اِصْطِنَاعِيّ, طَرَف اِصْطِنَاعِيّ",
 "ほてり": "أَشَعَّ ((أَشَعَّتِ) الشمسُ: نَشَرَتْ شْعاعها؛ أَشَعَّتِ النارُ: أَرسلت ضوءها وحرارتها)\nمثال: أشع الإسبرانتو! / هبة ساخنة (إحساس مفاجئ وقصير بالحرارة (يرتبط بانقطاع الطمث وبعض الاضطرابات العقلية))",
 "ほてる": "شطف (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن أن تعني إزالة ما علق بالشيء من أوساخ أو شوائب)",
 "ほてん": "تطبيق, طلاء (عمل وضع شيء (على سطح)) / تغطية (فعل حماية شيء ما بتغطيته) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / غِطَاء (مصنوعة تُغطّي شيئًا آخر عادةً لحمايته أو إيوائه أو إخفائه)\nمثال: وصف الطبيب وضعاً موضعياً لليود",
 "ほと": "أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية)",
 "ほとおりぼし": "كَوْكَبَة / قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "ほとおり星": "كَوْكَبَة / قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "ほとけ": "بُوذَا, بُدّ / مَيِّت",
 "ほとけくさい": "مَا وَرَائِيّ, مُتَعَالٍ (يوجد خارج نطاق الطبيعة أو لا يتوافق معها)",
 "ほとけごころ": "رَحْمَة, رَأْفَة / رَحْمَة, شَفَقَة",
 "ほとけさま": "بُوذَا, بُدّ / راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "ほとけさん": "بُوذَا, بُدّ / راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "ほとけしょう": "رأفة, رحمة (التساهل والرحمة التي يظهرها تجاه المخالفين شخص أو وكالة مكلفة بإقامة العدل) / رَأْفَة, رَحْمَة (الميل ليكون لطيفاً ومتسامحاً) / رحمة (الشعور الذي يحفز الشفقة)",
 "ほとけになる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "ほとけのざ": "أذن القسيس, لاميون متموج (نبات أوراسي له أوراق مسننة وزهور صغيرة ثنائية الشفة بيضاء أو حمراء أرجوانية)",
 "ほととぎす": "زنبق الضفدع (خس هندي طافٍ أو زاحف ذو عناقيد طرفية من الزهور الوردية الباهتة؛ المناطق الرطبة في المرتفعات بغرب أمريكا الشمالية)",
 "ほととぎすそう": "زنبق الضفدع (خس هندي طافٍ أو زاحف ذو عناقيد طرفية من الزهور الوردية الباهتة؛ المناطق الرطبة في المرتفعات بغرب أمريكا الشمالية)",
 "ほとばしり": "بئر دافق (بئر نفط بتدفق طبيعي قوي بحيث لا يكون الضخ ضرورياً)",
 "ほとばしる": "طفرة, فورة (زيادة قوية مفاجئة) / تلاطم, موجة عارمة (موجة بحرية كبيرة) / اندفاع, فورة (تدفق قوي مفاجئ)\nمثال: حفزت طفرة من المضاربة",
 "ほとほと": "إلى حد بعيد, تماماً (إلى أقصى حد؛ بالكامل) / إلى حد ما, تماماً (بدرجة ما (لا تستخدم مع النفي)) / حقاً, يا له من (من نوع ملحوظ أو استثنائي أو مميز بشكل غير عادي (لا تستخدم مع النفي)) / تماماً, حقاً (في الواقع أو بصدق أو إلى حد أقصى)\nمثال: أنت محق تماماً",
 "ほとほりぼし": "كَوْكَبَة / قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "ほとぼり": "جلبة, صخب (فعل إحداث اضطراب صاخب) / جلبة, دوامة (حركة مضطربة) / اضطراب, قلاقل (ثوران أو صخب غير منظم)\nمثال: كان عالقاً في دوامة من العمل",
 "ほとめく": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "ほとり": "جَانِب / صَفْحَة",
 "ほとんど": "تَقْرِيبًا, عَلَى وَشْك / بالكاد, قبل قليل (قبل وقت قصير جداً فقط) / بالكاد, قلّما (تقريباً لا؛ بصعوبة بالغة) / بالكاد, بصعوبة (ببطء وبصعوبة)\nمثال: بالكاد كنا نعرفهم / أَكْثَر, أَغْلَب / جِدًّا (كلمة \"جدا\" لها معانٍ متعددة؛ يرتبط المعنى بالعطاء والكرم، سواء بالمنح أو طلبه)\nمثال: إنها غالية جدا!",
 "ほど": "اِتِّسَاع, مَدَّى / حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ) / نِهَايَة / حَدَّ, حَدَّدَ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما. / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "ほどあい": "اِعْتِدَال (الوَسَطِيَّة، يقابله التَطَرُّف؛ التَنَاسُب وأن يكون الأمر عَدْلا، يقابله الاِنْقِلاب) / إِشْرَاف\nمثال: الاعتدال هو اليوم الذي يتساوى به الليل و النهار بنفس المدة.",
 "ほどいも": "فستق عبيد, فول سوداني (قرن كرمة الفول السوداني يحتوي عادة على حبتين أو بذرتين) / فول سوداني (درنة تشبه الجوز؛ طعام مهم للأمريكيين الأصليين) / أبيوس, بطاطس هندية (كرمة من أمريكا الشمالية ذات أزهار عطرة ودرنات صالحة للأكل؛ محصول غذائي مهم للأمريكيين الأصليين)",
 "ほどう": "مَمْشًى, مَسار الْشَاة / إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد / اعتقال, قبض (فعل القبض (خاصة القبض على مجرم))\nمثال: حصل الشرطي المناوب على التقدير للقبض على المجرم / فعل مساعد (فعل يندمج مع فعل آخر في عبارة فعلية للمساعدة في تشكيل الزمن أو الصيغة أو البناء أو الشرط للفعل الذي يندمج معه)",
 "ほどうきょう": "جسر مشاة (جسر مصمم لعبور المشاة)",
 "ほどく": "فَكَّ",
 "ほどこし": "مُنَظَّمَة خَيْرِيَّة / صَدَقَة / إِحْسَان",
 "ほどこしもの": "صَدَقَة, خَيْر",
 "ほどこす": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟ / وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه) / طَبَّقَ (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً)\nمثال: لقد أزمت الوضع. / خِنْزِيرَة / زَرَعَ, بَذَرَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت.",
 "ほどちかい": "قَرِيب / قَرِيبًا / بِٱلْقُرْب مِنَ, عِنْدَ / قَرُبَ (أَدْنَى؛ قدَّرَ)\nمثال: جلست بالقرب منها.",
 "ほどとおい": "بَوْن شَاسِع, فَرْق شَاسِع (تفاوت مخيب للآمال؛ تفاوت ضخم؛ عالم من الاختلاف) / بَوْن شَاسِع, مَسَافَة بَعِيدَة (مسافة تُقدّر بمدى مسموعية الصرخة (تعبير مجازي عن البعد الكبير))\nمثال: كان هناك فرق شاسع عما توقعه",
 "ほどなく": "قَرِيبًا, سَرْعَانَ مَا",
 "ほどなくして": "قَرِيبًا, سَرْعَانَ مَا",
 "ほどに": "كَـ, مِثْل / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / مُدَّة / فَتْرَة / فِي حِين, بَيْنَمَا (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي. / لِأَنَّ / هكذا, بلا سبب",
 "ほどほど": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا.",
 "ほどほどに": "إلى حد ما, باعتدال (إلى حد أو درجة معينة) / باعتدال (مع الاعتدال)\nمثال: كبير جداً",
 "ほどよい": "مُعْتَدِل (الأمر الوسط بين الطَرَفْيَن، نقيض المُتَطَرِّف)\nمثال: الجو معتدل هنا. / سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب",
 "ほどよく": "بشكل محق, عن حق (بصدق؛ كما هو مبرر)\nمثال: اعتبر عن حق أعظم مغني في عصره",
 "ほど良く": "بشكل محق, عن حق (بصدق؛ كما هو مبرر)\nمثال: اعتبر عن حق أعظم مغني في عصره",
 "ほど近い": "قَرِيب / قَرِيبًا / بِٱلْقُرْب مِنَ, عِنْدَ / قَرُبَ (أَدْنَى؛ قدَّرَ)\nمثال: جلست بالقرب منها.",
 "ほど遠い": "بَوْن شَاسِع, فَرْق شَاسِع (تفاوت مخيب للآمال؛ تفاوت ضخم؛ عالم من الاختلاف) / بَوْن شَاسِع, مَسَافَة بَعِيدَة (مسافة تُقدّر بمدى مسموعية الصرخة (تعبير مجازي عن البعد الكبير))\nمثال: كان هناك فرق شاسع عما توقعه",
 "ほな": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "ほなけん": "لِأَنَّ / هكذا, بلا سبب",
 "ほなら": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "ほにゅう": "رَضِيع",
 "ほにゅうきかん": "غدة ثديية (عضو مفرز للحليب في إناث الثدييات) / أمي, ماما (مصطلحات غير رسمية للأم)",
 "ほにゅうどうぶつ": "ثَدْيِيّ",
 "ほにゅうびん": "زجاجة رضاعة (وعاء مزود بحلمة مرنة ومملوء بالحليب؛ يستخدم كبديل للرضاعة الطبيعية)",
 "ほにゅうるい": "ثَدْيِيّ\nمثال: イルカは哺乳類の一種です。 — الدلفين نوع من الثدييات.",
 "ほにゅうるいがく": "علم الثدييات (فرع علم الحيوان الذي يدرس الثدييات)",
 "ほぬの": "قماش الأشرعة (قماش قوي (مثل قماش القنب القطني) يستخدم لصنع الأشرعة والخيام)",
 "ほね": "عَظْم / عضم / عَظْمَة / عضمة / أَطَّرَ ((أَطَّرَ) الشَّيْء: أَطَرَهُ) / وَرَّطَ / لَقْطَة\nمثال: دهنت أطر النافذة بالأصفر. / لَخَّصَ, اِخْتَصَرَ / عَمُود فَقْرِيّ / دِعَامَة / شَجَاعَة",
 "ほねあぶら": "زيت العظام (زيت داكن اللون كريه الرائحة يتم الحصول عليه بتفحيم العظام؛ يُستخدم خاصة في محاليل تغطيس الأغنام وفي تغيير طبيعة الكحول) / زيت العظام (الجزء السائل من دهن العظام؛ يُستخدم كمواد تشحيم وفي صناعة الجلود)",
 "ほねおしみ": "كَسَل",
 "ほねおり": "سعي, كفاح (محاولة جاهدة لتحقيق هدف)",
 "ほねきり": "قطع العظم (قطع جراحي للعظم)",
 "ほねぐみ": "هيكل, هيكل عظمي (هيكل الدعم الداخلي الذي يعطي القطعة الأثرية شكلها)\nمثال: المبنى له هيكل فولاذي / إطار, هيكل (هيكل يدعم أو يحتوي على شيء ما) / إطار, نسيج (الهيكل الأساسي) / إطار نظري, نموذج (وصف افتراضي لكيان أو عملية معقدة)\nمثال: توفير إطار عمل واقعي للبحث المستقبلي / لَخَّصَ, اِخْتَصَرَ",
 "ほねっぷし": "مُشْتَرَك / مِفْصَل / عَمُود فَقْرِيّ / دِعَامَة / شَجَاعَة",
 "ほねっぽい": "عَظْمِيّ, كَثِير العِظَام (لديه عظام خاصة عظام كثيرة أو بارزة) / نَاقِص الوَزْن, هَزِيل (شَدِيد النُّحُول والهُزَال) / عظمي (مكون من أو يحتوي على عظم)\nمثال: فيليه شاد (نوع سمك) مليء بالعظام",
 "ほねつき": "الجهاز الهيكلي, هيكل عظمي (الهيكل الصلب (العظام والغضاريف) الذي يوفر إطارًا لجسم الحيوان)",
 "ほねとかわ": "نحيل, هزيل (شخص نحيف وهزيل بشكل غير عادي)",
 "ほねなし": "بِلَا عِظَام, رَخْو (بدون عظم أو عظام)\nمثال: قنديل البحر بلا عظام / عَدِيم الأَشْوَاك (خالٍ من الأشواك أو الإبر) / جَبَان, ضَعِيف الشَّخْصِيَّة (يفتقر إلى الشجاعة أو الحيوية) / أملس, غير شوكي (يفتقر إلى النتوءات الشوكية) / لافقاري (يفتقر إلى عمود فقري)\nمثال: كان دودة صفراء عديمة الشجاعة",
 "ほねになる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "ほねぬき": "عَظْم / عضم / عَظْمَة / عضمة / تَخْفِيف / إضعاف (عملية تقليل قوة شيء ما) / مُضَعِّف, مُوَهِّن (يُخفّف عن طريق إضعاف حدة الألم أو الحزن) / مُضْعِف, مُوهِن (يسبب الوهن والضعف) / إضعاف, وهن (أن يصبح الشيء أضعف)",
 "ほねのある": "رَاسِخ, صَامِد (ثَابِتٌ وَمَوْثُوقٌ خَاصَّةً فِي الوَلَاءِ)",
 "ほねのおれる": "شَاقّ, مُضْنٍ (يتّسم بجهد يصل إلى حدّ الإنهاك؛ خاصة الجهد البدني)",
 "ほねぶし": "مُشْتَرَك / مِفْصَل",
 "ほねぶと": "عَرِيضُ العِظَام (ذو هيكل عظمي ضخم مقارنة بالجسم) / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / جَامِد\nمثال: هذا التخت جدا صلب.",
 "ほねぶとい": "عَرِيضُ العِظَام (ذو هيكل عظمي ضخم مقارنة بالجسم) / صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / جَامِد\nمثال: هذا التخت جدا صلب.",
 "ほねぶとのほうしん": "عَرِيضُ العِظَام (ذو هيكل عظمي ضخم مقارنة بالجسم)",
 "ほねぼそ": "نَحِيف, أَهْيَف",
 "ほねみをおしまず": "صَارِم, لَا يَرْحَم (عديم الشفقة والرحمة؛ قاسٍ لا يتساهل) / بَاذِخ, مُسْرِف فِي العَطَاء (بالغ السخاء؛ يُعطي بإسراف ودون حساب)",
 "ほねみをおしまない": "صَارِم, لَا يَرْحَم (عديم الشفقة والرحمة؛ قاسٍ لا يتساهل) / بَاذِخ, مُسْرِف فِي العَطَاء (بالغ السخاء؛ يُعطي بإسراف ودون حساب)",
 "ほねやすめ": "اِسْتِرْخَاءْ",
 "ほの": "بشكل خافت, بضعف (بدرجة خافتة أو مدركة بضعف)\nمثال: بينه وبين الضوء الخافت تم تحديد شكل بشكل خافت",
 "ほのお": "لَهَب, شُعْلَة",
 "ほのか": "إِغْمَاء / أُغْمِيَ, غُشِيَ",
 "ほのぐらい": "خَافِت, مُعْتَدِل الإِضَاءَة (ضَعِيف الضَّوْء؛ غَيْر سَاطِعٍ أَوْ قَاسٍ) / مُخْفَت, مُعْتِم (جُعل معتماً أو أقل سطوعاً) / بَطِيء الفَهْم, كَلِيل الذِّهْن (بطيء التعلّم والاستيعاب؛ يفتقر إلى الحدّة الذهنيّة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: أضواء القاعة المخفتة جلبت صمتاً من الترقب",
 "ほのけ": "حَرَارَة (السخونة والحماوة؛ شدة العَطَش) / حَرَارَة, سُخُونَة (السخونة والحماوة؛ شدة العَطَش) / سَخَّنَ, أَحَرَّ (حمي وأصبح حارا)\nمثال: حرارة الطقس تتزايد.",
 "ほのこ": "شَرَارَة",
 "ほのぼの": "بشكل خافت, بشكل غامض (بطريقة خافتة غير واضحة) / بشكل خافت (بضوء خافت) / بشحوب, بضعف (بطريقة تفتقر إلى الاهتمام أو الحيوية)\nمثال: أدركنا التغيير بشكل غامض فقط / بحرارة, بقلب خالص (بطريقة قلبية) / بشكل ثقيل (للملابس), بشكل دافئ (بطريقة دافئة (غالباً للملابس))\nمثال: رحبنا بها بحرارة",
 "ほのめかし": "تَلْمِيح / لَمَّحَ (لمح اليه؛يلمح لمحا واللمح:اختلس النظر وقال بعضهم:لمح نظر ولمحه)\nمثال: لمح سامي منزلا.",
 "ほのめかす": "أَلِيف, وَدُود (ذو مصالح أو مودة مشتركة؛ على صداقة راسخة) / حَمِيم, وَثِيق (يتميز بالمعرفة أو الصحبة أو الألفة الوثيقة) / ضَلِيع, مُطَّلِع (على دراية تامة عبر الدراسة أو التجربة) / أَلِيف, حَمِيمِيّ (يُوَفِّرُ جَوًّا دَافِئًا وَوُدِّيًّا وَغَيْر رَسْمِيّ)",
 "ほのめく": "إحساس مبهم, تلميح (اقتراح طفيف أو فهم غامض) / بريق خافت, بصيص (وميض من الضوء (خاصة الضوء المنعكس))\nمثال: لم يكن لديه أي فكرة عما كان على وشك الحدوث",
 "ほの暗い": "خَافِت, مُعْتَدِل الإِضَاءَة (ضَعِيف الضَّوْء؛ غَيْر سَاطِعٍ أَوْ قَاسٍ) / مُخْفَت, مُعْتِم (جُعل معتماً أو أقل سطوعاً) / بَطِيء الفَهْم, كَلِيل الذِّهْن (بطيء التعلّم والاستيعاب؛ يفتقر إلى الحدّة الذهنيّة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: أضواء القاعة المخفتة جلبت صمتاً من الترقب",
 "ほはば": "خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة",
 "ほはら": "نَفَّاخَة الْعَوْم, مَثَانَة الْعَوْم",
 "ほばく": "تَوْقِيف, اِعْتِقَال / اِعْتَقَلَ, قَبَضَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "ほばしら": "صَارٍ (انتقل من حال إلى أخرى. (فعل ناقص))\nمثال: صار \"توم\" منعزلا تماما.",
 "ほばら": "نَفَّاخَة الْعَوْم, مَثَانَة الْعَوْم",
 "ほひつ": "مُسَاعَدَة, إِمْدَاد / تَصْحِيح",
 "ほふく": "زحف (طريقة تنقل بطيئة على اليدين والركبتين أو بجر الجسم)\nمثال: كان الزحف هو كل ما استطاع الرجل المصاب القيام به",
 "ほふくけい": "رئد, ساق جارية (فرع أفقي من قاعدة النبات ينتج نباتات جديدة من براعم في أطرافه)",
 "ほふる": "ذَبْح (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول) / ذَبَحَ (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول)\nمثال: وعندما يتم ذبح الأبرياء في دارفور والبوسنة يسبب ذلك وصمة في ضميرنا المشترك. / اِسْتَبَدَّ (حزم ولم يتردد في اتخاذ القرار وتنفيذه؛ (في السياسة) حكم بنظام استبدادي)",
 "ほぶ": "خُطْوَة, خَطْوَة / خَطْوَة / قِيَافَة, مِشْيَة",
 "ほぶね": "سَفِينَة شَرَاعِيَّة (مَرْكَبٌ بَحْرِيٌّ لِنَقْلِ الْمُسَافِرِينَ وَالبَضَائِعِ)\nمثال: غادروا السفينة.",
 "ほぶる": "ذَبْح (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول) / ذَبَحَ (قتل بآلة حادة كالسيف أو السكين بقطع الوريد أو الشريان في الرقبة؛ عن القتل بدون مقاومة المقتول)\nمثال: وعندما يتم ذبح الأبرياء في دارفور والبوسنة يسبب ذلك وصمة في ضميرنا المشترك. / اِسْتَبَدَّ (حزم ولم يتردد في اتخاذ القرار وتنفيذه؛ (في السياسة) حكم بنظام استبدادي)",
 "ほへい": "مُشَاة, بِيَادَة",
 "ほへいせんとうしゃりょう": "مَرْكَبَةُ مُشَاةِ قِتَالِيَّة",
 "ほほ": "خَدّ (شَقَّ أو حَفَرَ في الأرض خطاً طويلاً أو أثراً عميقاً؛ أثَّر على سطحٍ ما بترك علامات أو شقوق) / وَجْنَة\nمثال: قبلتني على الخد.",
 "ほほぅ": "وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة!",
 "ほほう": "وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة!",
 "ほほえましい": "دَافِئ, مُفْرِح (يبعث على السرور والبهجة في القلب)",
 "ほほえみ": "اِبْتِسَامَة, بَسْمَة / اِبْتَسَمَ",
 "ほほえみかける": "اِبْتِسَامَة, بَسْمَة / اِبْتَسَمَ",
 "ほほえむ": "اِبْتِسَامَة, بَسْمَة / اِبْتَسَمَ",
 "ほほがゆるむ": "ابتسامة (تعبير وجهي يتميز برفع زوايا الفم؛ يظهر عادة السعادة أو التسلية)",
 "ほほじろ": "قِرْش أَبْيَض عَظِيم",
 "ほほじろざめ": "قِرْش أَبْيَض عَظِيم",
 "ほほそめる": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر) / رُوج (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها.",
 "ほほぼね": "وَجْنَة, عَظْم وَجْنِيّ",
 "ほほをそめる": "اِحْمِرَار (تغيُّر لون الشيء إلى الأحمر) / رُوج (رَوَّج الغُبارُ: دام؛ رَوَّج السِّلعةَ: جعلها تَرُوجُ) / اِحْمَرَّ (أصبح لونه أَحْمَرا بعد أن كان بلون ثان؛ تَضَرَّجَ؛ ازداد حَمَارُهُ)\nمثال: شعرت بالخجل و احمر وجهها.",
 "ほほー": "وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة!",
 "ほほーう": "وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة!",
 "ほほ笑み": "اِبْتِسَامَة, بَسْمَة / اِبْتَسَمَ",
 "ほぼ": "تَقْرِيبًا, عَلَى وَشْك / تقريباً, حوالي ((للكميات) غير دقيق ولكنه قريب جداً من الصواب) / بخشونة, بعنف (بحركة خشنة كما لو كان فوق سطح خشن) / بخشونة, بعنف (بخشونة أو عنف)\nمثال: استمر حوالي ساعة / حَضَانَة, رَوْضَة",
 "ほぼほぼ": "تَقْرِيبًا, عَلَى وَشْك",
 "ほまえせん": "قارب شراعي (سفينة شراعية صغيرة؛ عادة بصارية واحدة)",
 "ほまれ": "شرف, عفة (فضيلة المرأة أو عفتها) / شرف, كرامة (صفة كون الشخص شريفاً وذا سمعة طيبة) / تكريم, جائزة (رمز ملموس يدل على الاستحسان أو التميز) / تكريم, شرف (حالة كونه مكرماً)\nمثال: رجل شريف",
 "ほまれたかい": "شَهِير, لَامِع (معروف على نطاق واسع ومُقدَّر)",
 "ほむ": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "ほむべき": "مُحَمَّد (مُفَعَّل من حَمَّدَ؛ الذي يُحْمَدُ كثيرا)\nمثال: محمد رسول الله.",
 "ほむら": "لَهَب, شُعْلَة",
 "ほめことば": "تَأْبِين, أُمْدُوحَة / ثَنَاء, أُمْدُوحَة",
 "ほめじょうず": "جَذَّاب, سَاحِر (شخص يسحر الآخرين (عادة بجاذبيته الشخصية)) / ساحر, متملق (شخص ذو أسلوب واثق ومتملق)",
 "ほめたたえる": "صَفَّقَ",
 "ほめたてる": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "ほめちぎる": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "ほめぱげ": "مَوْقِع وِيب (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث)\nمثال: هنا موقع الحادث.",
 "ほめまつる": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "ほめる": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "ほめ上手": "جَذَّاب, سَاحِر (شخص يسحر الآخرين (عادة بجاذبيته الشخصية)) / ساحر, متملق (شخص ذو أسلوب واثق ومتملق)",
 "ほめ立てる": "مِدْحَة, إِثْنَاء / عِبَادَة, حَمْد / مَدَحَ, أَثْنَى",
 "ほめ言葉": "تَأْبِين, أُمْدُوحَة / ثَنَاء, أُمْدُوحَة",
 "ほや": "زجاجة المصباح (أنبوب زجاجي يحيط بفتيل مصباح الزيت) / بخاخ البحر (زقاقية يمكنها تقليص جسمها وقذف تيارات من الماء)",
 "ほやく": "مُساعِد, مُعَزِّز (يُعَزِّز فِعْل العِلاج الطِّبِّيّ) / إِضَافِيّ, مُسَاعِد (يقدم دعمًا إضافيًا) / عامل مساعد, مادة مساعدة (مادة مضافة تعزز فعالية العلاج الطبي)",
 "ほやほや": "حَارّ, سَاخِن (ساخن من نفسه بدون تسخين)\nمثال: الجو حار اليوم. / طَازَج, طَازَة / عَذْب",
 "ほゆう": "مَسّ, تَلَبُّس / مُمْتَلَك / حَوْزَة, مُلْكِيّة / اِسْتِحْوَاذ / حِيَازَة",
 "ほゆうしゃ": "مَالِك, مَالِكَة (اسم شخصي معطًى للذكور من العرب)\nمثال: من مالك هذا البيت؟",
 "ほよう": "تعافي, فترة النقاهة (الشفاء التدريجي (من خلال الراحة) بعد المرض أو الإصابة) / مشية (طريقة المشي)\nمثال: كان لديه مشية مضحكة / مشية (طريقة مشي الشخص) / مشية الحصان (طريقة تحرك الحصان) / سُرْعَة المَشْي, مِشْيَة (معدل الحركة (خاصة المشي أو الجري)) / استبدال (عملية توفير شخص أو شيء مكافئ مكان آخر) / بديل (شخص أو شيء يأخذ أو يمكن أن يأخذ مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر) / خَلَف, خَلِيفَة (الشخص الذي يلي في الترتيب)\nمثال: استبدال النجم لن يكون سهلاً",
 "ほよういん": "مَصَحَّة",
 "ほようしょ": "منشأة ترفيهية (منشأة عامة للترفيه)",
 "ほようじょ": "منشأة ترفيهية (منشأة عامة للترفيه)",
 "ほよく": "مُسَاعَدَة",
 "ほら": "أَجْوَف / تباهي, تفاخر (الحديث عن النفس بصيغ التفخيم) / كونش, محار الملك",
 "ほらあな": "كَهْف, غَار",
 "ほらいもり": "أولم, سمندل الكهوف (سمندل مائي أوروبي بخياشيم خارجية دائمة يعيش في الكهوف)",
 "ほらがい": "كونش, محار الملك",
 "ほらね": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "ほらばなし": "خُرَافَة, قِصَّة مُبَالَغ فِيهَا (قصة غير محتملة (غير عادية أو لا تصدق أو خيالية))",
