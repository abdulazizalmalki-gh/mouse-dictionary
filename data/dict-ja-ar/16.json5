 "ほらをふく": "تَبَاهَى",
 "ほら吹き": "متباهٍ, متفاخر (شخص كثير التفاخر والحديث عن نفسه)",
 "ほら穴": "كَهْف, غَار",
 "ほら話": "خُرَافَة, قِصَّة مُبَالَغ فِيهَا (قصة غير محتملة (غير عادية أو لا تصدق أو خيالية))",
 "ほら貝": "كونش, محار الملك",
 "ほり": "خَنْدَق / قَنَاة / شُرْطِيّ, كُونْسَتابِل (رجل قانون يتمتع بسلطة واختصاص أقل من المأمور (الشريف)) / شُرْطِيّ, كُونْسَتابِل (ضابط شرطة من أدنى رتبة) / نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب.",
 "ほりあてる": "ضَرَبَ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / إِضْرَاب\nمثال: ضرب سامي زوجته.",
 "ほりいど": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / طيّب / حسنًا (تقال عند استحسان الفعل أو القول، هَذَا حَسَن) / بِئْر, بير / عَيْن, بِئْر (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: حسنا. أنا موافق.",
 "ほりえ": "قَنَاة",
 "ほりかわ": "قَنَاة",
 "ほりきざむ": "نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب.",
 "ほりきり": "تَرْكِيبِيّ, مَصْنُوع (ليس من أصل طبيعي؛ أُعِدّ أو صُنِع صناعيًّا)",
 "ほりくずす": "أضعف, قّوض",
 "ほりし": "حفّار, نقاش (صانع طباعة يطبع من لوحة طباعة محفورة) / حفار, نقاش (عامل ماهر يمكنه نقش التصاميم أو الكتابة على سطح عن طريق النحت أو الحفر)",
 "ほりす": "أَرَادَ, رَغِبَ (شَاءَ الشيءَ، رَغِبَ فيه؛ أَحَبَّ، شَهِيَ، اِشْتَهَى. (تخصيص))\nمثال: أراد مني الكذب.",
 "ほりだしもの": "وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه. (يتعدى بعلى)) / لَقِيَّة\nمثال: وجد ياني هاتفه.",
 "ほりだしもん": "وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه. (يتعدى بعلى)) / لَقِيَّة\nمثال: وجد ياني هاتفه.",
 "ほりだす": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود.",
 "ほりつくす": "اِسْتَهْلَكَ, اِسْتَنْفَدَ",
 "ほりつける": "نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب.",
 "ほりぬきいど": "بِئْرٌ إِرْتِوَازِيَّة, بِئْرٌ إِرْتِوَازِيّ",
 "ほりねずみ": "غوفر, غوفر جيبي (قارض حفار من فصيلة الغوفرية له جيوب خدية خارجية كبيرة؛ من أمريكا الوسطى وجنوب غرب أمريكا الشمالية)",
 "ほりもの": "نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب. / وَشْم / وَشَمَ, وَشَّمَ",
 "ほりものし": "حفّار, نقاش (صانع طباعة يطبع من لوحة طباعة محفورة) / حفار, نقاش (عامل ماهر يمكنه نقش التصاميم أو الكتابة على سطح عن طريق النحت أو الحفر)",
 "ほりゅう": "صفصاف أحمر, صفصاف أرجواني (صفصاف أوراسي له غصينات محمرة أو أرجوانية ولحاء غني بالعفص) / ضعف, عجز (حالة الضعف في الصحة أو الجسم (خاصة بسبب الشيخوخة)) / حَجْز (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "ほりゅうち": "حَجْز (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "ほりょ": "سَجِين, سَجِينَة",
 "ほりょしゅうようじょ": "مخيم اعتقال, معسكر أسرى الحرب (معسكر لأسرى الحرب)",
 "ほりわり": "قَنَاة",
 "ほる": "حَفَرَ, اِحْتَفَرَ ((حَفَرَ الشَّيْءَ يَحْفِرُه) ، من حَدِّ ضَرَبَ، حَفْراً، (واحْتَفَرَه: نَقَّاه، كَمَا تُحْفَرُ الأَرضُ بالحَدِيدَةِ)؛ حفر: حَفَرَ الشيءَ يَحْفِرُه حَفْراً واحْتَفَرَهُ: نَقَّاهُ كَمَا تُحْفَرُ الأَرض بِالْحَدِيدَةِ)\nمثال: هم يحفرون حفرة. / لِي, لي / مَنْجَم, لَغَم / لَغْم, لَغَم / لَغَمَ / قِمَّة / نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي نُحِتَ، النقش أو التمثال أو غيره مما كان ناتج النحت)\nمثال: من علمك نحت الخشب. / وَشْم / وَشَمَ, وَشَّمَ / رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / أَهْمَلَ / إِهْمَال",
 "ほるい": "قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "ほるほる": "رضا عن الذات, غرور (الشعور الذي ينتابك عندما تكون راضياً عن نفسك)\nمثال: كان رضاه عن نفسه مثيراً للاشمئزاز تماماً",
 "ほれいざい": "تَبْرِيدِيّ, مُبَرِّد (يُسبِّب التبريد أو التجميد) / مادة تبريد, وسيط تبريد (أي مادة تستخدم للتبريد (كما في الثلاجة))",
 "ほれぐすり": "ترياق الحب, شراب الحب (شراب يُعتقد أن له قوة سحرية؛ يمكن أن يجعل من يتناوله يقع في حب من أعطاه إياه)",
 "ほれたがいんが": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "ほれたはれた": "بتهور, رأساً على عقب (في عجلة مضطربة)\nمثال: ركضنا بتهور نحو الملجأ",
 "ほれほれ": "بِحَنَان, بِحُبّ (بمودة وحب)\nمثال: تحدثت إلى أطفالها بحنان",
 "ほれぼれ": "بِحَنَان, بِحُبّ (بمودة وحب)\nمثال: تحدثت إلى أطفالها بحنان",
 "ほれる": "وَقَعَ فِي حُبّ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "ほろ": "سقفية, ظلة (غطاء (عادة من القماش) يعمل كسقف لحماية منطقة ما من الطقس) / مظلة (الجزء الذي يشبه المظلة في الباراشوت والذي يمتلئ بالهواء) / قبة الطائرة (الغطاء الشفاف لمقصورة الطائرة)",
 "ほろう": "رِوَاق, دِهْلِيز (مَمَرّ خارج المَبْنَى وملاصق له يمتد عليه السَقْف ويُصفّ على الجانب الآخر الأعمدة؛ في العصر الحديث يُطلق على الممر عامة) / مَمَرّ جَوِّيّ, مُـخـتَرَق جَوِّيّ (على مَمَرّ العصور: على طولها ومداها؛ على مَمَرّ الفصول: على تواليها وتعاقبها)\nمثال: ذهب إلى الرواق.",
 "ほろし": "طَفْح, طَفْح جِلْدِيّ",
 "ほろせ": "طَفْح, طَفْح جِلْدِيّ",
 "ほろっと": "مُؤَثِّر / لَمْس (اتصل بشيء أو شخص بشكل مباشر بواسطة جزء من الجسم مثل اليد، التواصل الحسي أو المعنوي مع شيء ما؛ يدل على التواصل، سواء كان ماديًا أو معنويًا، مع شيء ما)\nمثال: إياك ولمس شطيرتي!",
 "ほろにがい": "حُلْو وَمُرّ, حُلْوَة وَمُرَّة (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به)\nمثال: الكعكة حلوة جدا",
 "ほろばしゃ": "عربة كونستوجا, عربة مغطاة (عربة كبيرة بعجلات عريضة وسقف قماشي مقوس؛ استخدمها الرواد الأمريكيون لعبور البراري في القرن التاسع عشر)",
 "ほろびゆく": "اختفاء, تواري (فعل المغادرة سراً أو دون تفسير)",
 "ほろびる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "ほろぶ": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم) / سَقَطَ (تَحَرَّكَ من أعلى إلى أسفل بتأثير الجاذبية، وَقَعَ؛ في كلامه: أخْطَأَ، أو قال قولا لا ينبغي أو لا يريد قوله) / سُقُوط, هُوِيّ (يحمل كافة معاني الفعل بصيغة المصدر)\nمثال: توم وقع و أصيب.",
 "ほろほろ": "اِنْصِهَار, ذَوَبَان (صَهَرَ (الشَّيْءَ) ، كالشّحْمِ ونَحْوِه، يَصْهَرُه صَهْراً: (أَذابَه، فانْصَهَرَ، فَهُوَ صَهِيرٌ)…؛ انصهر المعدن ينصهر انصهاراً:ذاب بفعل الحرارة،تحوّل من حالة صلبة إلى حالة سائلة)",
 "ほろぼす": "دَمَّرَ",
 "ほろむいいちご": "توت السحاب, توت الغيم (توت شوكي زاحف من المناطق المعتدلة الشمالية بتوت أصفر أو برتقالي)",
 "ほろよい": "انتشاء, نشوة (المرح واللطف، كما من خلال تأثيرات الكحول أو الماريجوانا) / رقة لونية, نعومة (درجة ناعمة من اللون) / امتلاء, رقة (خاصية الإحساس الغني والممتع) / طراوة, نضج النكهة (طعم (خاصة للفاكهة) ناضج وكامل النكهة)\nمثال: رقة الضوء والظلال التي لا يمكن تحقيقها في الرخام",
 "ほろり": "بصوت خافت, بهدوء (بحجم صوت منخفض) / بخفة, برفق (بقليل من الوزن أو القوة) / بشكل خافت, بنعومة (توجيه في الموسيقى؛ للعزف بنعومة وهدوء نسبي) / برقة, بنعومة (بطريقة ترضي الحواس)\nمثال: تحدث بهدوء ولكن احمل عصا غليظة",
 "ほろん": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية)",
 "ほろ子": "طَفْح, طَفْح جِلْدِيّ",
 "ほろ苦い": "حُلْو وَمُرّ, حُلْوَة وَمُرَّة (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية بالسكر، ويرتبط بشكل عام باللذة، إلا عندما يتم التفريط به)\nمثال: الكعكة حلوة جدا",
 "ほろ酔い": "انتشاء, نشوة (المرح واللطف، كما من خلال تأثيرات الكحول أو الماريجوانا) / رقة لونية, نعومة (درجة ناعمة من اللون) / امتلاء, رقة (خاصية الإحساس الغني والممتع) / طراوة, نضج النكهة (طعم (خاصة للفاكهة) ناضج وكامل النكهة)\nمثال: رقة الضوء والظلال التي لا يمكن تحقيقها في الرخام",
 "ほわほわ": "مُتَلَاطِم, مُتَمَوِّج (يَتَّسِم بِأَمْوَاجٍ عَالِيَة مُتَدَافِعَة) / بحنان, برفق (مع الحنان؛ بطريقة حنونة)\nمثال: وضعت ذراعيها حوله بحنان",
 "ほをすすめる": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص)) / تمشّى / مَسِير, سِيرَة / مِشْيَة\nمثال: مشى ياني مع سكورا.",
 "ほん": "كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد / هَٰذَا, هَٰذِهِ / هٰذَا, هٰذِهِ / رَئِيسِيّ / حَقِيقِيّ / وَاقِعِيّ / رِيَال (العُمْلَة الرسمية لدى) / مُسْتَوًى / مَرْحَلَة / فَصْل (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه) / بَاب (ما يُسَدُّ به مَدْخَل المَبْنَى أو الغُرْفَة أو المَرْكَبَة؛ (تعميم) مَدْخَل أي شيء؛ فُتْحَة)\nمثال: اقرأ هذا الفصل.",
 "ほんあん": "جَدَارَة / تأقلم, تكيف ((فسيولوجيا) التعديل المستجيب لعضو حسي (كالعين) لظروف متغيرة (كالضوء)) / اقتباس, نسخة معدلة (عمل مكتوب (كرواية) تمت إعادة صياغته في شكل جديد) / تأقلم, تعديل (عملية التكيف مع شيء ما (مثل الظروف البيئية))\nمثال: المسرحية هي اقتباس لرواية قصيرة",
 "ほんい": "مِعْيَارِيّ / مُسْتَوَى, مِعْيَار / لِوَاء (على غير قياس؛ الرَايَة تُلوَى على العَلَم لتدلّ على شيء)",
 "ほんいかへい": "عملة قانونية, وسيلة دفع (شيء يمكن استخدامه كوسيلة رسمية للدفع)",
 "ほんいきごう": "طَبِيعِيّ",
 "ほんいつ": "هَرَبَ, فَرَّ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "ほんいん": "إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "ほんいんぼう": "أستاذ كبير (لاعب ذو مهارة استثنائية أو عالمية في الشطرنج أو البريدج)",
 "ほんえい": "الْقِيَادَة الْعَامَّة / مَقَرّ / منطقة الظل التام (منطقة من الظل الكامل ناتجة عن الانسداد الكلي للضوء)",
 "ほんおん": "كَرْشَنَة, نَقْصَوَة",
 "ほんかい": "جَلْسَة / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة",
 "ほんかいどう": "طَرِيق رَئِيسِيّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "ほんかくか": "تسوية, تنظيم (فعل تحقيق التوحيد؛ جعله منتظماً) / تسوية, تنظيم (حالة ما تم جعله نظامياً (أو أكثر انتظاماً))",
 "ほんかくてき": "أَصْلِيّ / شَامِل, كَامِلُ النِّطَاق (يستخدم جميع الموارد المتاحة)",
 "ほんかくは": "صفائي, متشدد في القواعد (شخص يصر على الدقة الكبيرة والصحة (خاصة في استخدام الكلمات))",
 "ほんかん": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَسْقَط اَلرَّأْس, وَطَن الأُمّ (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "ほんがん": "مَسْقَط اَلرَّأْس, وَطَن الأُمّ (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد بها الدولة أو المدينة لا المبنى)\nمثال: دفنت في مسقط رأسها.",
 "ほんき": "جِدِّيَّة",
 "ほんきで": "بِجِدِّيَّة, بجد",
 "ほんきど": "جِدِّيَّة",
 "ほんきにする": "أَخَذَهُ عَلَى مَحْمَلِ الجِدِّ, أَخَذَهُ بِالجِدِّيَّة",
 "ほんきょ": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "ほんきょく": "مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "ほんきょち": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "ほんきん": "ذهب خالص, ذهب عيار 24 (ذهب بنسبة 100 في المائة) / رأس مال الأسهم (القيمة الدفترية للأسهم القائمة لشركة ما) / أسهم مصرح بها, رأس المال المصرح به (الحد الأقصى لعدد الأسهم المصرح بها بموجب شروط عقد تأسيس الشركة)",
 "ほんぎまり": "حكم نهائي (حكم يفصل في القضية المعروضة على المحكمة؛ بعد صدور الحكم (أو الاستئناف منه) كل ما تبقى هو إنفاذ الحكم)",
 "ほんぐみ": "مَاكْيَاج, بُنْيَة",
 "ほんけ": "مُؤَسِّس, مُؤَسِّسَة",
 "ほんけいやく": "عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين) / أَغْدَمَ, اِدَّغَمَ\nمثال: أمضى زيري العقد.",
 "ほんけがえり": "خرف, هرم (الضعف العقلي نتيجة لكبر السن)",
 "ほんけほんもと": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "ほんけん": "حَقّ المِلْكِيَّة (الحق القانوني في الملكية) / سهم, شهادة سهم (شهادة توثق ملكية المساهم في الشركة)\nمثال: تضاعفت قيمة أسهمه خلال العام الماضي",
 "ほんげん": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل",
 "ほんこく": "إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "ほんこんかぎだいがく": "هُونْغ كُونْغ / هُونْج كُونْج / هُونْق كُونْق",
 "ほんこんこうくう": "هُونْغ كُونْغ / هُونْج كُونْج / هُونْق كُونْق",
 "ほんこんこっかあんぜんいじほう": "هُونْغ كُونْغ / هُونْج كُونْج / هُونْق كُونْق",
 "ほんこんじょうしだいがく": "جامعة المدينة (جامعة حضرية في مدينة كبيرة)",
 "ほんこんだい": "هُونْغ كُونْغ / هُونْج كُونْج / هُونْق كُونْق",
 "ほんこんてんもんだい": "هُونْغ كُونْغ / هُونْج كُونْج / هُونْق كُونْق",
 "ほんこんりこうだいがく": "هُونْغ كُونْغ / هُونْج كُونْج / هُونْق كُونْق",
 "ほんこんテレコム": "هُونْغ كُونْغ / هُونْج كُونْج / هُونْق كُونْق",
 "ほんご": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "ほんごく": "وَطَن, مَوْطِن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "ほんごくじん": "أَصْلِيّ",
 "ほんごし": "جدية, رزانة (سمة كون المرء جاداً) / إخلاص, جدية (شعور جاد وصادق)\nمثال: نقص الوقار ليس بالضرورة نقصاً في الجدية",
 "ほんさば": "ماكريل تشوب (ماكريل صغير يوجد في جميع أنحاء العالم تقريباً)",
 "ほんしき": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير) / رَسْمِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي. / بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "ほんしけん": "امتحان نهائي (امتحان يجرى في نهاية الفصل الدراسي)",
 "ほんしつ": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "ほんしつしゅぎ": "اَلْجَوْهَرَانِيَّة",
 "ほんしつてき": "جَوْهَرِيّ, مَوْضُوعِيّ (يحدد الحقوق والواجبات بدلاً من إعطاء القواعد التي يتم بموجبها تأسيس الحقوق والواجبات) / أساسي, جوهري (أساسي وجوهري) / بَالِغ الأَهَمِّيَّة, جَوْهَرِيّ (من الأهمّيّة القُصوى) / جَوْهَرِيّ, لَا غِنَى عَنْه (ضروري حتمًا؛ لازم لزومًا حيويًّا)\nمثال: القانون الموضوعي",
 "ほんしゃ": "مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "ほんしゅう": "هُونْشُو",
 "ほんしゅす": "أَطْلَس / صَقِيل",
 "ほんしょ": "قسم شرطة, مركز شرطة (محطة تعمل كمقر للشرطة في منطقة معينة؛ وتخدم كمكان يتم منه إرسال رجال الشرطة وإحضار الأشخاص المقبوض عليهم إليه) / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "ほんしょう": "مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما) / وزارة الداخلية (الإدارة الحكومية المسؤولة عن الشؤون الداخلية (خاصة في بريطانيا))\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "ほんしょく": "مُحْتَرِف, مُحْتَرِفَة / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "ほんしょしごせん": "خَطّ الزَّوَال, خَطّ الطُّول الرَّئِيسِيّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "ほんしんさ": "فحص تحري, فرز (اختبار الأشياء أو الأشخاص لتحديد أولئك الذين لديهم خصائص معينة) / تغطية, حجب (فعل إخفاء وجود شيء ما عن طريق حجب رؤيته) / شبكة غربلة, قماش شبكي (قماش من شبكة معدنية أو بلاستيكية) / عرض, عرض سينمائي (عرض صورة متحركة (فيلم))\nمثال: أخفى الغطاء بنادقهم عن طائرات العدو",
 "ほんじ": "كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك. / حَرْف صِينِيّ, طَابِع صِينِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى)\nمثال: ألف هو الحرف الأول للألف باء. / نَقْحَرَة, كَرْشَنَة (مصدر للفعل \"نَقْحَرَ\"؛ (في اللسانيات) كتابة لغة ما بحروفٍ تُستعمل لكتابة غيرها)",
 "ほんじつ": "الْيَوْمَ, النهارده / حَاضِر, الأيام دي / النهرده / اليوم / هاد النهار",
 "ほんじょう": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "ほんじょうし": "فكرة رئيسية, محور (فكرة أساسية أو مركزية) / قرار, نغمة الأساس ((موسيقى) النغمة الأولى في سلم دياتوني) / فِكْرَة رَئِيسِيَّة, مِحْوَر أَسَاسِيّ (الموضوع الرئيسي في خطاب أو عمل أدبي)",
 "ほんじん": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "ほんすう": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ) / عَدَد, رَقْم (مِقْدَار مَا يُعَدّ) / عَدَد (مِقْدَار مَا يُعَدّ) / رَقْم (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقَّمَ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: كم عدد سكان الجزائر؟",
 "ほんずき": "محب للكتب, مولع بالكتب (شخص يحب الكتب (ويجمعها عادة))",
 "ほんせん": "خط رئيسي (المسار الرئيسي لنظام النقل)",
 "ほんせんわたし": "سلسلة الساعة (سلسلة قصيرة أو شريط يربط ساعة الجيب بصدرية الرجل) / دلاية الساعة, سلسلة الساعة (زينة تتدلى من سلسلة الساعة) / جيب ساعة (جيب في الصدرية مخصص لحمل ساعة الجيب)",
 "ほんぜん": "طَبِيعِيّ / شراع رئيسي مربع (شراع رئيسي مربع الشكل) / الطبق الرئيسي (الطبق الأساسي في الوجبة) / فَجْأَةً / طيران (حالة السفر جواً) / خَاطِف, عَابِر (سريع وقصير؛ على عجل) / سَرِيع الحَرَكَة, طَائِر (يتحرك بسرعة كبيرة)\nمثال: كان الطيران لا يزال مغامرة مثيرة بالنسبة له",
 "ほんそく": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "ほんぞう": "نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره) / زَرَعَ, غَرَسَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: هذا النبات مهدد بالانقراض.",
 "ほんぞん": "صَنَم, وَثَن (الصَّنَم: نَحْتٌ من خَشَبٍ ويُصَاغُ من نُحاسٍ، وغيره يُصنع لعبادته. ويُسمى أيضًا وَثَنًا) / آيْدُول",
 "ほんたい": "مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ)) / نُومِينُون",
 "ほんたいせいこうけつあつ": "ارتفاع ضغط الدم الأساسي, فرط ضغط الدم الأولي (ارتفاع مستمر ومرضي في ضغط الدم لا يمكن العثور على سبب محدد له)",
 "ほんたいせいしんせん": "رعاش مجهول السبب (رعاش غير معروف السبب (عادة في اليدين والرأس) يتطور لدى كبار السن؛ غالباً ما يخلط بينه وبين مرض باركنسون لكنه لا يهدد الحياة ويمكن عادة السيطرة عليه)",
 "ほんたいぶ": "عُضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "ほんたいぶあんごうかひょうじ": "عُضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "ほんたいろん": "أُنْطُولُوجِيَّا, عِلْم الْوُجُود",
 "ほんたて": "مسند كتب (دعامة توضع في نهاية صف من الكتب لإبقائها منتصبة (على رف أو طاولة))",
 "ほんだて": "مسند كتب (دعامة توضع في نهاية صف من الكتب لإبقائها منتصبة (على رف أو طاولة))",
 "ほんだな": "رَفّ كُتُب, رَفُّ الْكُتُب (رَفَّتْ أَوْراقُ الشَّجَرِ: اِهْتَزَّتْ، تَحَرَّكَتْ؛ رَفَّتِ العَيْنُ: رَمَّشَتْ)\nمثال: وضع الكتاب على الرف. / مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "ほんだら": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "ほんちょうし": "فكرة رئيسية, محور (فكرة أساسية أو مركزية) / قرار, نغمة الأساس ((موسيقى) النغمة الأولى في سلم دياتوني) / فِكْرَة رَئِيسِيَّة, مِحْوَر أَسَاسِيّ (الموضوع الرئيسي في خطاب أو عمل أدبي)",
 "ほんて": "ورقة حكم, ورقة رابحة (ورقة لعب من النقش الذي تم إعلانه كحكم)\nمثال: آس الحكم هو فائز مؤكد / خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير.",
 "ほんてん": "مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "ほんで": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "ほんでん": "حقل أرز (حقل مروي أو مغمور يُزرع فيه الأرز)",
 "ほんと": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة. / سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب / أَصْلِيّ",
 "ほんとう": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة. / سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب / أَصْلِيّ / تحليق لأعلى, صعود سريع (فعل الارتفاع لأعلى في الهواء)",
 "ほんとうに": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا .",
 "ほんとうのところ": "بصدق, حقاً (في الواقع (تستخدم للتوكيد أو تعديل الجملة))\nمثال: في الحقيقة، عجل الانحلال الأخلاقي بسقوط الإمبراطورية الرومانية / حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "ほんとそれ": "هَٰذَا, هَٰذِهِ / هٰذَا, هٰذِهِ",
 "ほんとに": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا .",
 "ほんど": "يَابِسَة, بَرّ",
 "ほんどう": "طَرِيق, طَرِيق عَامّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / طب باطني, طب عام (فرع الطب الذي يتعامل مع تشخيص وعلاج (غير جراحي) لأمراض الأعضاء الداخلية (خاصة عند البالغين))",
 "ほんどおり": "جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم الذي يجمع الطُّرق أو الطريق الكبير الذي يجمع كل الطريق)\nمثال: كانت ماري جادة.",
 "ほんなら": "آنَذَاكَ, حِينَئِذٍ / ثُمَّ (يفيد الترتيب والتراخي) / إِذًا, إِذَنْ\nمثال: ثم هناك مشكلة؛",
 "ほんに": "بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك) / بالفعل, جداً (في الحقيقة (غالباً ما تميل إلى التوكيد))\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "ほんにんかくにん": "التحقق من الهوية, القياسات الحيوية (التعرف التلقائي على الأفراد الأحياء باستخدام خصائصهم الفسيولوجية والسلوكية)",
 "ほんね": "حَافِز",
 "ほんねをいう": "صَدَقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع)\nمثال: صدق سامي كل شيء.",
 "ほんねん": "طَبِيعِيّ",
 "ほんの": "بحيرة صغيرة, بركة (بركة صغيرة من المياه الراكدة)",
 "ほんのう": "غَرِيزَة, سَلِيقَة",
 "ほんのうてき": "غَرِيزِيّ, فِطْرِيّ (نابع من الغريزة أو كأنّه منها؛ بلا تفكير واعٍ)",
 "ほんのむし": "دودة كتب (شخص يقضي وقتاً طويلاً في القراءة) / متحذلق, متفيهق (شخص يولي اهتماماً مفرطاً للقواعد الرسمية والمعرفة الكتبية أكثر مما تستحق)",
 "ほんのり": "قَلِيلًا",
 "ほんのわずか": "تدوين سريع, خربشة (ملاحظة موجزة (ومكتوبة بخط اليد على عجلة)) / ذرة, رشة (كمية طفيفة ولكن محسوسة)\nمثال: هذا الطبق يحتاج لمسة من الثوم",
 "ほんの僅か": "تدوين سريع, خربشة (ملاحظة موجزة (ومكتوبة بخط اليد على عجلة)) / ذرة, رشة (كمية طفيفة ولكن محسوسة)\nمثال: هذا الطبق يحتاج لمسة من الثوم",
 "ほんば": "وَطَن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن. / مسقط الرأس, منشأ (المكان الذي نشأ فيه شيء ما أو تمت رعايته في بداية وجوده)\nمثال: مهد الحضارة",
 "ほんばこ": "مَكْتَبَة, خِزَانَةُ الْكُتُب",
 "ほんばふう": "أَصِيل, مَوْثُوق (غير مُزيَّف أو منسوخ؛ حقيقي لا شك فيه) / صَحِيح, مَوْثُوق (مطابق للحقائق وبالتالي جدير بالتصديق)",
 "ほんばら": "قَانُونِيّ",
 "ほんばん": "أَدَاء / مَسْرَحِيَّة / لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / لَعْب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / طَرِيدَة\nمثال: لعب زيري التنس. / اِرْتِفَاع",
 "ほんばんこうい": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "ほんびのすがい": "كواهوج (محار أمريكي صالح للأكل؛ استخدمت أصدافه الثقيلة كنقود من قبل بعض الهنود الأمريكيين) / بطلينوس صلب (بطلينوس دائري ذو قشرة صلبة من الساحل الأطلسي؛ بطلينوس كبير يستخدم عادة للحساء أو أطباق البطلينوس الأخرى)",
 "ほんぶ": "الْقِيَادَة الْعَامَّة / مَقَرّ",
 "ほんぶし": "عَالِي الجَوْدَة, مُمْتَاز (يتفوق في الجودة)",
 "ほんぶちょう": "مدير عام (المدير الأعلى رتبة)",
 "ほんぶり": "وَابِل, مَطَر غَزِير",
 "ほんぶん": "رِسَالَة, مِيسِيج",
 "ほんぷく": "قَانُونِيّ",
 "ほんぺん": "فِلْم (شريط من السِّلِيلُوز تعلوه قشرة من الجلاتين ومن برومور الفِضَّة يستعمل للتصوير الفوتوغرافي والسينمائي؛ قصة سينمائية، نتاج سينمائي: «فلم تاريخي») / شَرِيط / فِيلْم سِينَمَائِيّ / تَصْوِير مُتَحَرِّك\nمثال: استمر الفلم ساعتين.",
 "ほんぽう": "مُتَوَحِّش / بَرِّيّ / دستور, قانون أساسي (قانون يحدد المبادئ السياسية الأساسية للحكومة)",
 "ほんぽうじざい": "طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة) / حُرّ, مُنْطَلِق (خالٍ من القيود أو القواعد)",
 "ほんま": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "ほんまもん": "الشَّيْء الأَصْلِيّ (استخدام غير رسمي ينسب الأصالة)",
 "ほんまる": "نِوَاة",
 "ほんむ": "وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب.",
 "ほんむすび": "عقدة مربعة (عقدة مزدوجة مصنوعة من عقدتين نصفيتين وتستخدم لربط نهايات حبلين)",
 "ほんめい": "مَحْبُوب, مُفَضَّل (يروق لعامة الناس ويستهويهم) / مفضل (شيء يحظى بتفضيل أو إعجاب خاص) / حبيب, مفضل (شخص محبوب مميز) / مرشح للفوز, مفضل (منافس يُعتقد أنه من المرجح أن يفوز)\nمثال: هذا الكتاب هو أحد مفضلاتي",
 "ほんもう": "رِضَا, إِشْبَاع (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "ほんもと": "مَنْشَأ / مَنْبَع, مَنْشَأ / اَصْل",
 "ほんもの": "الشَّيْء الأَصْلِيّ (استخدام غير رسمي ينسب الأصالة)",
 "ほんもん": "رِسَالَة, مِيسِيج",
 "ほんもんひひょう": "نقد نصي (مقارنة نص معين بمواد ذات صلة من أجل إثبات أصالته)",
 "ほんや": "متجر كتب, مكتبة (متجر تباع فيه الكتب) / دَار نَشْر, نَاشِر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور)\nمثال: إذهب إلى الدار.",
 "ほんやく": "تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة. / فَكَّ تَّعْمِيَة, فَكَّ مُعَمَّى",
 "ほんやくか": "مُتَرْجِم / مُتَرْجِمَة / تُرْجُمَان",
 "ほんやくがく": "دِرَاسَات اَلتَّرْجَمَة",
 "ほんやくき": "مُتَرْجِم / مُتَرْجِمَة / تُرْجُمَان",
 "ほんやくけんきゅう": "دِرَاسَات اَلتَّرْجَمَة",
 "ほんやくさきげんご": "اللغة المترجم إليها, اللغة الهدف (اللغة التي يتم ترجمة نص مكتوب بلغة أخرى إليها) / لغة الكائن, لغة الهدف (لغة حاسوبية يتم ترجمة شيء مكتوب بلغة حاسوبية أخرى إليها)",
 "ほんやくしゃ": "مُتَرْجِم / مُتَرْجِمَة / تُرْجُمَان",
 "ほんやくしゃくよう": "استعارة مترجمة, محاكاة لغوية (تعبير أُدخل إلى لغة ما عن طريق ترجمته من لغة أخرى)",
 "ほんやくしょ": "تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة.",
 "ほんやくぶん": "تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة.",
 "ほんやくもとげんご": "لغة المصدر (لغة يراد ترجمتها إلى لغة أخرى)",
 "ほんやくプログラム": "مُتَرْجِم / مُتَرْجِمَة / تُرْجُمَان",
 "ほんやくルーチン": "مترجم, مترجم برمجي ((علم الحاسوب) برنامج يفك شيفرة التعليمات المكتوبة بلغة عالية المستوى وينتج برنامجاً بلغة التجميع) / جامع, مجمع (شخص يجمع المعلومات (لأغراض مرجعية مثلاً))",
 "ほんゆう": "أَصَالَة, فِطْرِيَّة (صفة كون الشيء فطرياً)",
 "ほんゆうてき": "فِطْرِيّ",
 "ほんよみ": "دودة كتب (شخص يقضي وقتاً طويلاً في القراءة) / متحذلق, متفيهق (شخص يولي اهتماماً مفرطاً للقواعد الرسمية والمعرفة الكتبية أكثر مما تستحق)",
 "ほんらい": "أَصْلًا / أساساً, جوهرياً (في الجوهر؛ في الأصل أو بحكم الطبيعة)\nمثال: هو في الأساس غير صادق / سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب",
 "ほんらいからいえば": "حقاً, فعلياً (في واقع الأمر)\nمثال: لا أحد رأى القرش فعلياً",
 "ほんらいであれば": "حقاً, فعلياً (في واقع الأمر)\nمثال: لا أحد رأى القرش فعلياً",
 "ほんらいなら": "حقاً, فعلياً (في واقع الأمر)\nمثال: لا أحد رأى القرش فعلياً",
 "ほんりゅう": "تيار جارف, سيل (تيار مائي سريع وعنيف (أو سائل آخر)) / طوفان, هطول غزير (مطر غزير) / سيل, طوفان (عدد أو كمية هائلة)\nمثال: جرفت المنازل في السيل / شراع رئيسي مربع (شراع رئيسي مربع الشكل) / الطبق الرئيسي (الطبق الأساسي في الوجبة) / الاتجاه العام, التيار السائد (تيار الفكر السائد)\nمثال: كان تفكيره ضمن التيار السائد الأمريكي",
 "ほんりょう": "إقْطَاعَة",
 "ほんるい": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء / مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما) / قاعدة المنزل ((بيسبول) قاعدة تتكون من لوح مطاطي حيث يقف الضارب؛ يجب أن يلمسها عداء القاعدة من أجل التسجيل)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "ほんるいだ": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه) / ركضة كاملة, هوم ران (ضربة تتيح للضارب الدوران حول القواعد وتسجيل نقطة (ركضة))\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "ほんるいだおう": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه) / ركضة كاملة, هوم ران (ضربة تتيح للضارب الدوران حول القواعد وتسجيل نقطة (ركضة))\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "ほんわか": "دَافِئ / دَفِيء",
 "ほんガス": "غاز المدينة (غاز فحم مصنع للاستخدام المنزلي والصناعي)",
 "ほんチャン": "أَدَاء / مَسْرَحِيَّة / لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / لَعْب (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة) / طَرِيدَة\nمثال: لعب زيري التنس. / اِرْتِفَاع / اِخْتِرَاقْ (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "ほー": "وَا, يَا يَاه / آه (صوت يستخدم للدلالة على الشعور بالألم العاطفي أو الجسدي؛ ألم، إما عاطفي أم جسدي) / يَا, أَيْ (يستعمل لنِدَاء البعيد والقريب)\nمثال: آه ، هناك فراشة! / حفل سُكْر, معاقرة الخمر (الاحتفال الصاخب بشرب الكحول؛ حفلة شرب مرحة) / زمير (نفخة بوق)",
 "ほーい": "حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "ほーん": "هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد) / هَمْهَمَ, دَنْدَنَ\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل .",
 "ほ場": "أرض زراعية, أرض محروثة (أرض صالحة للزراعة يتم حرثها وزرعها وإنتاج المحاصيل منها)",
 "ほ座": "الشراع",
 "ぼ": "سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ, مُسَجِّل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سَجَّلَ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "ぼいん": "بصمة الإبهام (بصمة إصبع مأخوذة من الإبهام (خاصة من باطن الإبهام)) / صَائِت, مُصَوِّت / حَرَكَة, حَرْفُ مَدّ / حَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ)\nمثال: لقد أوقفنا حركة المرور. / أَسِير حَرْب (شخص يستسلم للعدو (أو يأخذه العدو) في وقت الحرب)",
 "ぼいんこうたい": "إبدال صوتي (حركة يتغير نوعها أو طولها للإشارة إلى تمييز لغوي)",
 "ぼいんせい": "حركي, صائت (كونه أو يحتوي على أو يتميز بحروف العلة) / حركي, صائتي (متعلق بحروف العلة (الصوائت) أو مرتبط بها أو يحتوي عليها)\nمثال: أصوات صائتة",
 "ぼいんせつぞく": "فُرْجَة",
 "ぼいんちょうわ": "اِنْسِجَام مُصَوَّتٍ, تَوَافُق صَوْتِيّ",
 "ぼう": "أَكِيد / مُتَأَكِّد / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مُحَدَّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: لديك بعض الكتب. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / عَمُود, قُطْب / زَانَة / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / الثُّرَيَّا / أَرْنَب (حيوان من فصيلة الثدييات مستأنس يربيه الناس من أجل لحومه وفرائه الناعم، ويربى أحيانًا كحيوان أليف)\nمثال: زيري لديه أرنب. / شَرْق (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت) / مَشْرِق / شَرْقِيٌّ\nمثال: تشرق الشمس من الشرق. / حُجْرَة (الغُرْفَة أو القَاعَة. تطلق على القَبْر والحَضِيرَة من باب التشبيه؛ ما يشبه الغرفة من الأرض، المكان المحمي أو المحاط بما يجعله شبيها بالمنعى الأول. استخدام مجازي وقديم) / غُرْفَة, غُرْفَةُ نَوْم (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات) / مَجْلِس\nمثال: قعدنا في وسط الحجرة. / رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة) / بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ بالغُرُوب طُلُوع الشَّمْسِ…؛ البَدْرُ الغلامُ المكتمل أو الممتلئ) / رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة) / فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / صَغِير, صغير / قَلِيلاً, قَلِيل / قُبَّعَة, بُرْنَيْطَة (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس العَمَامَة التي لا يكون فيها خِيَاطَة. قُلُنْسُوَة)\nمثال: لقد اشترى قبعة. / شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة) / مُمْتَدّ, وَاسِع النِّطَاق (كبير في الامتداد المكاني أو النطاق أو الكمية) / توسعي, واسع النطاق (للزراعة؛ زيادة الإنتاجية باستخدام مناطق واسعة بحد أدنى من النفقات والعمالة)\nمثال: إنتاج القمح في ظل ظروف واسعة النطاق / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم) / عُنْف, عَنْف / عُنْف / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / مُتَأَخِّر / مَرْحُوم / مُتَأَخِّرًا",
 "ぼうあく": "عُنْف, عَنْف / عُنْف",
 "ぼうあくむるい": "شَيْطَانِيّ",
 "ぼうあつ": "مَنْع (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "ぼうい": "طُغْيَان, اِسْتِبْدَاد",
 "ぼうう": "كَتِيم لِلْمَاء, مُقَاوِم لِلْمَاء (لا يسمح بمرور الماء)",
 "ぼうえい": "دِفَاع, حِمَايَة / دِفاع",
 "ぼうえいきこう": "آلية دفاع, آلية دفاعية ((في الطب النفسي) عملية لاواعية تحاول تقليل القلق المرتبط بالرغبات الغريزية)",
 "ぼうえいきせい": "آلية دفاع, آلية دفاعية ((في الطب النفسي) عملية لاواعية تحاول تقليل القلق المرتبط بالرغبات الغريزية)",
 "ぼうえいぐん": "دفاع, قوة دفاع (منظمة من المدافعين توفر المقاومة ضد الهجوم)\nمثال: انضم إلى الدفاع ضد الغزو",
 "ぼうえいけいかく": "برنامج دفاعي, سياسة دفاعية (برنامج للدفاع عن دولة ضد أعدائها)",
 "ぼうえいさく": "إجراء دفاعي, دفاع (عمل عسكري أو موارد تحمي دولة ضد أعداء محتملين)\nمثال: ماتوا في الدفاع عن ستالينغراد",
 "ぼうえいしゃ": "مُدَافِع, مُنَاصِر (هو سيِّد قومِه غير مُدَافَعٍ: لا ينافسه أحد، غير مزاحَم؛ هو مدَفَّعٌ: فقير يَدْفَعُهُ كلُّ أحدٍ عن نفسه) / مُدَافِع (هو سيِّد قومِه غير مُدَافَعٍ: لا ينافسه أحد، غير مزاحَم؛ هو مدَفَّعٌ: فقير يَدْفَعُهُ كلُّ أحدٍ عن نفسه)",
 "ぼうえいせん": "خط دفاع (هيكل دفاعي يتكون من حاجز يمكن استخدامه للدفاع ضد الهجوم) / خط دفاع (أي منظمة تكون مسؤوليتها الدفاع ضد شيء ما)\nمثال: الشرطة هي خط الدفاع الرئيسي ضد الجريمة",
 "ぼうえいちょうちょうかん": "مُدِير عَامّ (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة ما. جمعه مُدَرَاء)\nمثال: زيري هو المدير.",
 "ぼうえいてき": "دفاعي (مخصص أو مناسب للدفاع ضد العدوان أو الهجوم أو لردعه) / تَبْرِيرِيّ, دِفَاعِيّ (يسعى إلى التبرير أو الدفاع قولاً أو كتابةً) / موقف دفاعي (موقف يتسم بالدفاع عن النفس)\nمثال: أسلحة دفاعية",
 "ぼうえき": "تِجَارَة / مرض سار, مرض معد (مرض يمكن أن ينتقل من شخص لآخر)",
 "ぼうえきあかじ": "عجز الميزان التجاري, عجز تجاري (زيادة الواردات على الصادرات)",
 "ぼうえきくろじ": "فائض تجاري (زيادة في الصادرات عن الواردات)\nمثال: تعتبر الفوائض التجارية السنوية إضافات فورية ومباشرة للناتج المحلي الإجمالي للدول",
 "ぼうえきしゅうし": "مِيزَان التِّجَارَة, مِيزَان تِجَارِيّ (الفرق في القيمة خلال فترة زمنية بين واردات وصادرات بلد ما من البضائع)\nمثال: يكون الميزان التجاري للأمة مواتياً عندما تتجاوز صادراتها وارداتها",
 "ぼうえきしょう": "بَائِع, تَاجِر",
 "ぼうえきしょうへき": "حاجز تجاري (أي تنظيم أو سياسة تقيد التجارة الدولية)",
 "ぼうえきふう": "رياح تجارية (رياح ثابتة تهب من الشرق إلى الغرب فوق وتحت خط الاستواء)\nمثال: ركبوا الرياح التجارية متجهين غرباً",
 "ぼうえんきょう": "تِلِسْكُوب, مِقْرَاب",
 "ぼうえんきょうざ": "الْمِقْرَاب",
 "ぼうえんきょう座": "الْمِقْرَاب",
 "ぼうえんレンズ": "عدسة زوم, عدسة مقربة (عدسة كاميرا تقوم بتكبير الصورة)",
 "ぼうおく": "عشة, كوخ (مأوى صغير بدائي يستخدم كمسكن)",
 "ぼうおとりょう": "طلاء مانع للحشف (طلاء يستخدم للحماية من تراكم البرنقيل وما إلى ذلك على الأسطح المغمورة تحت الماء)",
 "ぼうおん": "جحود, نكران الجميل (الافتقار إلى الامتنان) / عَازِل لِلصَّوْت (لا ينفذ منه الصوت)",
 "ぼうおんせつび": "عَازِل لِلصَّوْت (لا ينفذ منه الصوت)",
 "ぼうおんそうち": "عَازِل لِلصَّوْت (لا ينفذ منه الصوت)",
 "ぼうおんへき": "حاجز الصوت (الزيادة في الكبح الديناميكي الهوائي (مقاومة الهواء) عندما تقترب الطائرة من سرعة الصوت)",
 "ぼうか": "إدارة النيران, التحكم في الرمي (التحضير لإيصال القذائف إلى الهدف) / انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء)) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / انتفاخ, تضخم (بروز غير طبيعي أو تضخم موضعي)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "ぼうかくんれん": "تدريب إخلاء, مناورة حريق (تمرين يهدف إلى تدريب الناس على الواجبات وإجراءات الهروب الواجب اتباعها في حالة نشوب حريق)",
 "ぼうかせん": "خط النار, مانع النار (حقل ضيق تم تنظيفه للحد من انتشار حرائق البراري أو الغابات)",
 "ぼうかとびら": "باب حريق (باب مقاوم للحريق يمكن إغلاقه لوقف انتشار الحريق)",
 "ぼうかとりょう": "مُثَبِّط لِلْحَرِيق, مُقَاوِم لِلنَّار (صعب الاحتراق)",
 "ぼうかど": "باب حريق (باب مقاوم للحريق يمكن إغلاقه لوقف انتشار الحريق)",
 "ぼうかへき": "جِدَار ناريّ, فَايْرْوُول",
 "ぼうかろう": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "ぼうかん": "جَمِيع أَنْحَاء, كُلّ / بلطجي, سفاح (مجرم شاب عدواني وعنيف) / رَصْد, مُشَاهَدَة (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس)",
 "ぼうかんしゃ": "متفرج (شخص ينظر ويراقب)",
 "ぼうかんてき": "غَيْر مُتَدَخِّل (لا ينطوي على مشاركة أو تدخّل)",
 "ぼうかんぼう": "قبعة بحرية صوفية (قبعة صوفية زرقاء داكنة محبوكة يرتديها البحارة في الطقس البارد أو العاصف)",
 "ぼうが": "ترانس",
 "ぼうがい": "إعاقة (الوقوف في طريق شخص ما) / اعتراض, سد (فعل الاعتراض أو العرقلة) / عائق, مانع (أي هيكل يجعل التقدم صعباً) / عائق, عقبة (شيء غير مادي يقف في الطريق ويجب تجاوزه أو التغلب عليه)\nمثال: عرقلة سير العدالة / مُفَاجِئ",
 "ぼうがいき": "جهاز تشويش (جهاز إرسال يستخدم لبث التشويش الإلكتروني) / طائرة اعتراضية, معترضة (طائرة مقاتلة سريعة وقادرة على المناورة مصممة لاعتراض طائرات العدو)",
 "ぼうがいこうい": "تَدَاخُل",
 "ぼうがいこうさく": "أَعْمَال تَخْرِيبِيَّة, تَخْرِيب (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما أشبه)\nمثال: أنا في رحلة أعمال.",
 "ぼうがいこうさくいん": "مُخَرِّب",
 "ぼうがいざい": "إعاقة (الوقوف في طريق شخص ما) / اعتراض, سد (فعل الاعتراض أو العرقلة) / عائق, مانع (أي هيكل يجعل التقدم صعباً) / عائق, عقبة (شيء غير مادي يقف في الطريق ويجب تجاوزه أو التغلب عليه)\nمثال: عرقلة سير العدالة",
 "ぼうがいぶつ": "عَقَبَة, حَاجِز",
 "ぼうがこうしん": "أجمة, دغل (نمو كثيف للشجيرات)",
 "ぼうき": "آلة غزل (آلة نسيج لغزل الخيوط والخيوط)",
 "ぼうきゃく": "نِسْيَان",
 "ぼうきゃくのかなた": "إِبْهَام, خَفاء (الإِصْبَعُ الغليظةُ الخامسةُ من أَصابع اليد والرِّجل، وهي ذات سُلامَيَيْن (مؤنثة وقد تذكَّر) والجمع: أباهيم، وإبهامات)",
 "ぼうきょ": "عُنْف, عَنْف / عُنْف",
 "ぼうきょう": "حَنِين, اِشْتِيَاق",
 "ぼうきれ": "غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط.",
 "ぼうきん": "مبيد فطريات, مضاد للفطريات (أي عامل يقضي على الفطريات أو يمنع نموها) / مبيد للفطريات, مضاد للفطريات (قادر على تدمير الفطريات)",
 "ぼうぎ": "حَبْكَة / مُؤَامَرَة / مَكِيدَة / كَادَ",
 "ぼうぎゃく": "طُغْيَان, اِسْتِبْدَاد",
 "ぼうぎゅう": "الياك (ثور بري كبير طويل الشعر من التبت غالباً ما يتم استئناسه) / ثرثرة صاخبة, لغو (حديث صاخب)",
 "ぼうぎょ": "دِفَاع, حِمَايَة / دِفاع",
 "ぼうぎょう": "أَعْمَال تَخْرِيبِيَّة, تَخْرِيب (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما أشبه)\nمثال: أنا في رحلة أعمال.",
 "ぼうぎょういん": "مُخَرِّب",
 "ぼうぎょりつ": "معدل الركض المكتسب ((بيسبول) مقياس لفعالية الرامي)",
 "ぼうぎれ": "غُصَيْن / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان) / لَصَّقَ, لَصِقَ\nمثال: لا تمسك العصا من الوسط.",
 "ぼうくう": "الدِّفَاع الجَوِّيّ, دِفَاع جَوِّيّ",
 "ぼうくうききゅう": "منطاد حاجز (بالون أو منطاد ممدود ومربوط بحبال أو شبكة تتدلى منه لردع طائرات العدو التي تحلق على ارتفاع منخفض)",
 "ぼうくうごう": "مَلْجَأ مِنَ الْقَنَابِل",
 "ぼうくうしきべつけん": "الدِّفَاع الجَوِّيّ, دِفَاع جَوِّيّ",
 "ぼうくうほう": "الدِّفَاع الجَوِّيّ, دِفَاع جَوِّيّ",
 "ぼうくん": "مُلَاحَظَة هَامِشِيَّة / طَاغِيَة",
 "ぼうくんりゅう": "تيرانوصور, تيرانوصور ريكس (ديناصور لاحم كبير ثنائي الأرجل له أسنان ضخمة ذات حواف مسننة تشبه السكاكين؛ ربما كان قمّاماً (آكل جيف) بدلاً من مفترس نشط؛ من أواخر العصر الطباشيري في…)",
 "ぼうぐ": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "ぼうぐい": "وَتِد, خَازُوق (العصا تثبت في الأرض لتثبيت شيء ما بربطه إليها) / مِحْرَقَة / حِصَّة / رِهَان",
 "ぼうぐみ": "حبيب, صديق حميم (رجل هو عشيق لرجل أو امرأة) / رجل, رفيق (صبي أو رجل) / زَمِيل (شخص عضو في نفس مهنة أو طبقة الشخص الآخر) / رفيق, زميل (صديق يتواجد كثيراً بصحبة آخر)\nمثال: لو علمت أنه حبيبها لما سألت",
 "ぼうけい": "جهة منتسبة, فرع (منظمة فرعية أو ثانوية تابعة لمنظمة أخرى) / عُضْو مُنْتَسِب, مُنْتَسِب (زميل مرؤوس أو فرعي؛ شخص ينتسب لآخر أو لمنظمة)\nمثال: الجهات التابعة للشبكة / دَسِيسَة / مُؤَامِرَة, مُوَاطَأَة",
 "ぼうけん": "تَشْرِيح / مُخَاطَرَة, مُغَامَرَة / مُغَامَرَة / مُجَازَفَة, مُغَامَرَة / مُجَازَفَة / خَطَر (خطر في مشيه: اهتز وتبختر؛ خطر بذنبه: رفعه مرة وخفضه أخرى، أو حركه يمينا وشمالا)\nمثال: أنا ذاهب للخطر.",
 "ぼうけんか": "مُغَامِر, مُغَامِرَة",
 "ぼうけんしほん": "رأس مال جريء, رأس مال مخاطر (ثروة متاحة للاستثمار في مشاريع جديدة أو مضاربة)",
 "ぼうけんしゃ": "مُغَامِر, مُغَامِرَة",
 "ぼうけんしょうせつ": "حكاية بطولية, قصة مغامرة (قصة تدور حول مغامرة)",
 "ぼうけんてき": "مُغَامِر",
 "ぼうげつ": "بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ بالغُرُوب طُلُوع الشَّمْسِ…؛ البَدْرُ الغلامُ المكتمل أو الممتلئ)",
 "ぼうげん": "بَاطِل, أَبَاطِيل (نقيض الحَقّ)\nمثال: ومن كلام الباطل فابعد.",
 "ぼうげんざい": "مِصَدّ",
 "ぼうげんぶつ": "مِصَدّ",
 "ぼうこう": "اِعْتِدَاء, حَمْلَة / اِغْتِصَاب (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن) / اِغْتَصَبَ, غَصَبَ (غَصَبَ؛ زَنَى (بِفُلَانَةٍ) قَهْرًا/غَصْبًا)\nمثال: تعرض زيري للاغتصاب. / مَثَانَة, مَثَانَة بَوْلِيَّة ((في الأحياء) عضو مرن يشبه الكيس يتمدد وينقبض، وظيفته تخزين سائل أو غاز ما؛ تحديدًا، المثانة البولية، وهي العضو الذي يخزن البول في الإنسان وفي العديد من الحيوانات)",
 "ぼうこうえん": "التهاب المثانة (التهاب المثانة البولية والحالبين)",
 "ぼうこうかつやくきん": "عضلة عاصرة, مصرة (حلقة من العضلات تنقبض لإغلاق فتحة)",
 "ぼうこうけっせき": "حَصَاةُ المَثَانَة (حصاة تتكون في المثانة)",
 "ぼうこうざい": "اِعْتِدَاء, حَمْلَة",
 "ぼうこん": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "ぼうご": "حِمَايَة",
 "ぼうごさく": "احتراز, تدبير وقائي (إجراء وقائي لدرء خطر وشيك أو ضرر أو إصابة) / أمان, تصريح مرور آمن (وثيقة أو مرافقة توفر ممراً آمناً عبر منطقة خاصة في وقت الحرب)\nمثال: وضع كيس ثلج على الإصابة كإجراء وقائي",
 "ぼうさい": "قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "ぼうさき": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "ぼうさつ": "حمل زائد (عبء مفرط) / حمل زائد (حمل كهربائي يتجاوز الطاقة الكهربائية المتاحة)",
 "ぼうさん": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة) / فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى.",
 "ぼうざい": "ذراع التطويل, عوارضة (أي من الصواري أو الأعمدة الأفقية المتنوعة المستخدمة لتمديد أسفل الشراع أو لمناولة البضائع أو في الإرساء) / بوم, ذراع الميكروفون (عمود يحمل ميكروفوناً علوياً مسلطاً فوق موقع تصوير فيلم أو تلفزيون) / دوي, رعد (ضجيج عميق طويل وعالٍ) / رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال))\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم",
 "ぼうざとう": "قالب سكر (رغيف مخروطي كبير من السكر المكرر المركز)",
 "ぼうし": "قُبَّعَة, بُرْنَيْطَة (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس العَمَامَة التي لا يكون فيها خِيَاطَة. قُلُنْسُوَة)\nمثال: لقد اشترى قبعة. / قُبَّعَة, قُبَّعة (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس العَمَامَة التي لا يكون فيها خِيَاطَة. قُلُنْسُوَة)\nمثال: لقد اشترى قبعة. / غزل (صنع الخيوط) / مَنْع (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة. / تِلْمِيذ, تِلْمِيذَة / حَدَقَة, بُؤْبُؤ / سقف معروش, سقف من القش (سقف منزل مصنوع من مادة نباتية (كالقش))",
 "ぼうしざい": "مانع, مثبط (مادة تؤخر أو توقف نشاطاً ما)",
 "ぼうしつ": "خَسَارَة, فِقْدَان / ضَرَر / خَسَارَة / فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته. / فَضاء (فَضَاء) / غُرْفَة, حُجْرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الفضاء مليئ بالغموض. / مَخْدَع, غُرْفَةُ نَوْم / حجيرة, مسكن (تجويف صغير أو فراغ داخل عضو أو في نبات أو حيوان)",
 "ぼうしつけっせつ": "عقدة أذينية بطينية (عقدة من عضلة القلب المتخصصة تقع في الجدار الحاجز للأذين الأيمن؛ تستقبل النبضات من العقدة الجيبية الأذينية وتنقلها إلى الحزمة الأذينية البطينية)",
 "ぼうしつざい": "عامل تجفيف, مادة مجففة (مادة تعزز الجفاف (مثل أكسيد الكالسيوم الذي يمتص الماء ويستخدم لإزالة الرطوبة))",
 "ぼうしつべん": "صمام أذيني بطيني (أي من صمامي القلب اللذين يتدفق الدم من خلالهما من الأذينين إلى البطينين؛ يمنع عودة الدم إلى الأذين)",
 "ぼうしゃ": "عشة, كوخ (مأوى صغير بدائي يستخدم كمسكن) / عَجَلَة الْمِغْزَل",
 "ぼうしや": "متجر قبعات نسائية (متجر يبيع القبعات النسائية)",
 "ぼうしゅう": "مَطْلِيّ ضِدَّ الصَّدَأ, مُقَاوَمٌ لِلصَّدَأ (مُعالَج بمادّة واقية ضدّ الصدأ)",
 "ぼうしゅうざい": "مُزِيل اَلْعَرَق, مُزِيل اَلرَّائِحَة",
 "ぼうしゅく": "الثُّرَيَّا",
 "ぼうしょう": "إثبات, تأييد (تأكيد صحة حقيقة أو بيان من خلال استخدام الأدلة الوثائقية) / كبريتات الصوديوم (ملح أبيض مر صلب يستخدم في تصنيع الزجاج والورق والأصباغ والمستحضرات الصيدلانية)",
 "ぼうしょうせん": "يُنْبُوع حَارّ, مِيَاه حارَّة (ينبوع: عَيْنُ المَاءِ أو جَدْوَلٌ كَثِيرُ المَاءِ)\nمثال: ماء هذا الينبوع صافي.",
 "ぼうしょく": "شراهة, نهم (الأكل بإفراط (تُشخص كإحدى الخطايا السبع المميتة))",
 "ぼうしょくか": "أَكَّال, شَرَه",
 "ぼうしん": "استراتيجي, خبير استراتيجي (خبير في الاستراتيجية (خاصة في الحرب)) / سذاجة, سرعة التصديق (الميل للتصديق بسهولة) / رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب) / مَانِع لِلْمَاء (لا يسمح بمرور الماء دخولاً أو خروجاً)",
 "ぼうしんねんかい": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "ぼうじ": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "ぼうじしゃく": "قضيب مغناطيسي (مغناطيس على شكل قضيب بقطبين مغناطيسيين في كل طرف)",
 "ぼうじま": "شارة الرتبة, شريط رتبة",
 "ぼうじゃくぶじん": "تَكَبُّر, غُرُور",
 "ぼうじゅ": "اعتراض الكرة ((كرة القدم الأمريكية) فعل التقاط كرة القدم من قبل لاعب في الفريق المنافس) / اعتراض (فعل الاعتراض؛ منع شيء ما من المضي قدماً أو الوصول)\nمثال: لجأ إلى اعتراض رسائل ابنته",
 "ぼうじゅん": "انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء)) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / انتفاخ, تضخم (بروز غير طبيعي أو تضخم موضعي)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "ぼうじょ": "مَنْع (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة. / حِمَايَة",
 "ぼうじょう": "إساءة, فظاظة (نقص في التهذيب؛ الفشل في إظهار الاحترام للآخرين؛ جرح مشاعر الآخرين) / فجاجة, قلة أدب (أسلوب وقح ومهين) / قِلَّة احْتِرَام, وَقَاحَة (تعبير عن عدم الاحترام)",
 "ぼうじん": "مُتَفَرِّج",
 "ぼうすい": "مِغْزَل / عزل الماء (فعل معالجة شيء ما لجعله طاردا للماء) / عزل مائي (طلاء قادر على جعل السطح مقاوماً للماء) / خلط مائي, سائل مائي (السائل الصافي داخل مقلة العين بين القرنية والعدسة)",
 "ぼうすいかこう": "عزل الماء (فعل معالجة شيء ما لجعله طاردا للماء) / عزل مائي (طلاء قادر على جعل السطح مقاوماً للماء)",
 "ぼうすいけい": "سِيجَارِيّ الشَّكْل, مِغْزَلِيّ (مستدق من كلا الطرفين)",
 "ぼうすいたい": "مِغْزَل",
 "ぼうすいながぐつ": "حذاء الخوض, خوّاضة (أحذية طويلة تصل للفخذ مقاومة للماء (تمتد أحياناً إلى الصدر) يرتديها الصيادون)",
 "ぼうすいはんぷ": "قماش القنب المشمع, مشمع (قماش قنب معالج ليكون مقاوماً للماء)",
 "ぼうすいシート": "قماش القنب المشمع, مشمع (قماش قنب معالج ليكون مقاوماً للماء)",
 "ぼうすいズボン": "حذاء الخوض, خوّاضة (أحذية طويلة تصل للفخذ مقاومة للماء (تمتد أحياناً إلى الصدر) يرتديها الصيادون)",
 "ぼうず": "قَصَّة قَصِيرَة جِدّاً (قصة شعر قصيرة جداً؛ عادة للرجال أو الأولاد) / فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى.",
 "ぼうずくさい": "مُتَظَاهِر بِالتَّقْوَى, مُرَائِي (مُفرِط في إظهار التقوى بشكل نفاقيّ)",
 "ぼうせい": "طُغْيَان, اِسْتِبْدَاد / مَطْلِيّ ضِدَّ الصَّدَأ, مُقَاوَمٌ لِلصَّدَأ (مُعالَج بمادّة واقية ضدّ الصدأ) / الثُّرَيَّا",
 "ぼうせいししょう": "قلة الحيوانات المنوية, قلة النطاف (عدم كفاية الحيوانات المنوية في السائل المنوي)",
 "ぼうせき": "غزل (صنع الخيوط) / خيط مغزول ((مصطلح بحري) حبال صغيرة تتكون من حبل خفيف الوزن مصنوع من عدة خيوط حبال ملفوفة معاً برخاوة)",
 "ぼうせきいと": "خيط مغزول ((مصطلح بحري) حبال صغيرة تتكون من حبل خفيف الوزن مصنوع من عدة خيوط حبال ملفوفة معاً برخاوة)",
 "ぼうせきき": "آلة غزل (آلة نسيج لغزل الخيوط والخيوط)",
 "ぼうせききかい": "آلة غزل (آلة نسيج لغزل الخيوط والخيوط)",
 "ぼうせきけんし": "حرير مغزول (خيط مصنوع من نفايات الحرير)\nمثال: عمل الغازل هو تقويم هذه الألياف بمساعدة الآلات، ثم ضمها معاً لتصبح خيطاً يُعرف بالحرير المغزول",
 "ぼうせきこう": "طعم دوار (طعم للصياد؛ يدور عند سحبه عبر الماء) / دوارة, قرص دوار (من معدات ألعاب الطاولة تتكون من قرص وسهم يتم تدويره لتحديد الحركة التالية في اللعبة) / غزّال (شخص يغزل (يبرم الألياف لتصبح خيوطاً))",
 "ぼうせきこうじょう": "محلج قطن, مصنع قطن (مصنع نسيج لصنع المنسوجات القطنية)",
 "ぼうせきし": "خيط مغزول ((مصطلح بحري) حبال صغيرة تتكون من حبل خفيف الوزن مصنوع من عدة خيوط حبال ملفوفة معاً برخاوة)",
 "ぼうせつ": "مُغَالَطَة (أما من حيث الصورة فكقولنا لصورة الفرس المنقوش على الجدار: إنها فرس، وكل فرس صهال، ينتج أن تلك الصورة صهالة؛ وأما من حيث المعنى فلعدم رعاية وجود الموضوع في الموجبة)",
 "ぼうせん": "تسطير, خط تحتي (خط مرسوم بالأسفل (خاصة تحت مادة مكتوبة)) / خط مستقيم (خط ترسمه نقطة تتحرك في اتجاه ثابت؛ خط انحناؤه صفر)\nمثال: أقصر مسافة بين نقطتين هي خط مستقيم",
 "ぼうせんのり": "طَارِد, مُقَاوِم (غير قادر على الامتصاص أو الاختلاط) / عَاصٍ, مُقَاوِم (مَيَّالٌ إِلَى تَحَدِّي السُّلْطَةِ القَائِمَةِ أَوْ مُنْخَرِطٌ فِيه) / مُقَاوِم (لا يتأثّر بسهولة؛ محصَّن ضدّ التأثير) / مَنِيع, مُقَاوِم (يتعلق بالمناعة أو يمنحها (ضد المرض أو العدوى))",
 "ぼうぜん": "مَبْهُوت, مَصْعُوق (كأنه أُصيب بالخرس من شدة الذهول والمفاجأة) / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "ぼうぜんじしつ": "ترنح, ذهول (وعي هامشي) / ذهول, صدمة (شعور بالضيق وعدم التصديق الذي ينتابك عند حدوث شيء سيء بشكل عرضي)\nمثال: كان ترنحه بسبب الإرهاق بقدر ما كان بسبب الضربات",
 "ぼうぜん自失": "ترنح, ذهول (وعي هامشي) / ذهول, صدمة (شعور بالضيق وعدم التصديق الذي ينتابك عند حدوث شيء سيء بشكل عرضي)\nمثال: كان ترنحه بسبب الإرهاق بقدر ما كان بسبب الضربات",
 "ぼうそう": "عربدة, هيجان (سلوك عنيف غاضب ومدمر) / آبِق / خِدَاع, ضَلَالَة / غَرُور",
 "ぼうそうしょう": "البنتاغون, وزارة الدفاع (الإدارة الفيدرالية المسؤولة عن حماية الأمن القومي للولايات المتحدة؛ أنشئت عام 1947)",
 "ぼうそつ": "هَارِب / مُحْتَضَر, يَمُوت (في عملية الانتقال من الحياة أو التوقف عن الوجود) / اندثار, زوال (الوقت الذي ينتهي فيه شيء ما)\nمثال: رجل يحتضر",
 "ぼうたかとび": "القفز بالزانة (مسابقة تتضمن القفز فوق عارضة عالية بمساعدة عصا طويلة)",
 "ぼうだ": "تَدَفُّقِيّ, مُتَدَفِّقٌ ((في علوم الحاسوب) يستخدم أو يتعلق بنقل البيانات المستمر؛ يُنقل ويُحمَّل باستمرار) / مدرار, مسيل (يفرز سائلاً جسدياً بكميات غزيرة) / انسياب سيتوبلازمي, حركة دائرية سيتوبلازمية (دوران السيتوبلازم داخل الخلية)\nمثال: وجهه المتصبب عرقاً / مُتَدَفِّق, مُنْهَمِر (يسيل بغزارة)",
 "ぼうだい": "ضَخْم, عِمْلَاق / انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء)) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / انتفاخ, تضخم (بروز غير طبيعي أو تضخم موضعي)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً / عَنَاوِين فَرْعِيَّة, عُنْوَان فَرْعِيّ / تَرْجَمَة, سَتْرَجَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون) / مثال: أنا مدرس للترجمة.",
 "ぼうだいぶ": "أمبولا, قنينة رومانية (قارورة لها مقبضان؛ استخدمها الرومان للنبيذ أو الزيوت) / أمبولة, انتفاخ قاروري (الجزء المتوسع من قناة أو مجرى خاصة القنوات الهلالية للأذن)",
 "ぼうだち": "تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع) / مُتَنَمِّر, نَاهِض (واقف على الرِّجل الخلفيَّة اليسرى مع رفع القوائم الأماميَّة والرأس جانبيّاً) / تنشئة, رعاية (الخصائص المكتسبة نتيجة للطريقة التي عوملت بها كطفل)",
 "ぼうだん": "مُضَادّ لِلرَّصَاص, وَاقٍ مِن الرَّصَاص (لا تخترقه الرصاصات) / رَاسِخ, مَنِيع (خَالٍ مِنَ الثَّغَرَاتِ أَوِ العُيُوب)",
 "ぼうだんチョッキ": "صَدْرِيَّة ضِدَّ الرَّصَاص, سُتْرَة وَاقِيَة (المنسوبة إلى الصدر، غالبا ما يقصد بالصدر معنى الجزء من جسم الإنسان؛ في : هي المَرْيُول، ثوب يُغطي الجزء الأمامي من الجسم ويُربط من خلف يُرتدى فوق الملابس لحمايتها أثناء الطبخ أو العمل. الجمع صداري)",
 "ぼうだんベスト": "صَدْرِيَّة ضِدَّ الرَّصَاص, سُتْرَة وَاقِيَة (المنسوبة إلى الصدر، غالبا ما يقصد بالصدر معنى الجزء من جسم الإنسان؛ في : هي المَرْيُول، ثوب يُغطي الجزء الأمامي من الجسم ويُربط من خلف يُرتدى فوق الملابس لحمايتها أثناء الطبخ أو العمل. الجمع صداري)",
 "ぼうちゅう": "مُلَاحَظَة هَامِشِيَّة / فِي المُنْتَصَف تَمَامًا (الجزء أو النقطة الوسطى أو المركزية)\nمثال: في وسط الغابة",
 "ぼうちゅうかこう": "مُقَاوِم لِلْعُثّ (مقاوم لأضرار العُثّ)",
 "ぼうちゅうかんあり": "هُنَاك, يُوجَد",
 "ぼうちゅうざい": "طارد الحشرات (مادة كيميائية تطرد الحشرات)",
 "ぼうちゅうもう": "نَامُوسِيَّة",
 "ぼうちょう": "اِسْتِمَاع / تَمَدُّد / تَوَسُّع / مكافحة التجسس (أنشطة استخباراتية معنية بتحديد ومواجهة التهديد للأمن الذي تشكله منظمات الاستخبارات المعادية أو الأفراد المنخرطون في التجسس أو التخريب أو التخريب…)",
 "ぼうちょうけいすう": "قَابِلِيَّة التَّمَدُّد, مُعَامِل التَّمَدُّد (التغير النسبي في الطول أو المساحة أو الحجم لكل وحدة تغير في درجة الحرارة عند ضغط ثابت معين)",
 "ぼうちょうざい": "خميرة, مادة رافعة (مادة تضاف إلى العجين لجعله أخف وأكثر طراوة (مثل الخميرة أو مساحيق الخبز))\nمثال: أعلم أنه يمكنني استخدام مواد رافعة كيميائية، لكنني أعتقد أن استخدام الخميرة كمادة رافعة أكثر صحة",
 "ぼうちょうしき": "قَابِل لِلنَّفْخ (مُصَمَّم ليُملأ بالهواء أو الغاز)",
 "ぼうちょうしゃ": "متفرج",
 "ぼうちょうてい": "كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ)",
 "ぼうちょうど": "تمدد, توسع (عملية توسيع فتحة) / إطناب, توسع (مناقشة مطولة (منطوقة أو مكتوبة) حول موضوع معين)\nمثال: توسع حدقة العين",
 "ぼうちょうにん": "متفرج",
 "ぼうちょうりょう": "تذكرة الدخول, رسم الدخول (الرسم المفروض للدخول)",
 "ぼうっと": "بذهول, بفراغ (بطريقة خالية من التعبير)\nمثال: كانت تحدق بذهول في الغرفة / بشكل خافت, بشكل غامض (بطريقة خافتة غير واضحة) / بشكل خافت (بضوء خافت) / بشحوب, بضعف (بطريقة تفتقر إلى الاهتمام أو الحيوية)\nمثال: أدركنا التغيير بشكل غامض فقط",
 "ぼうつきキャンディ": "مصاصة",
 "ぼうつきキャンディー": "مصاصة",
 "ぼうつきキャンデー": "مصاصة",
 "ぼうてい": "طَاغِيَة",
 "ぼうと": "مثير للشغب, مشاغب (مثير للمتاعب يشارك في اضطرابات عنيفة تخل بالأمن؛ شخص يتمرد على السلطة القائمة) / بذهول, بفراغ (بطريقة خالية من التعبير)\nمثال: كانت تحدق بذهول في الغرفة / بشكل خافت, بشكل غامض (بطريقة خافتة غير واضحة) / بشكل خافت (بضوء خافت) / بشحوب, بضعف (بطريقة تفتقر إلى الاهتمام أو الحيوية)\nمثال: أدركنا التغيير بشكل غامض فقط",
 "ぼうとう": "ذراع التطويل, عوارضة (أي من الصواري أو الأعمدة الأفقية المتنوعة المستخدمة لتمديد أسفل الشراع أو لمناولة البضائع أو في الإرساء) / بوم, ذراع الميكروفون (عمود يحمل ميكروفوناً علوياً مسلطاً فوق موقع تصوير فيلم أو تلفزيون) / دوي, رعد (ضجيج عميق طويل وعالٍ) / رزق ساقه الله, رواج (حدث مفاجئ يجلب الحظ السعيد (مثل فرصة مفاجئة لكسب المال))\nمثال: خلق الطلب على الاختبار طفرة لتلك المختبرات غير الخاضعة للتنظيم / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة. / رمية طائشة (رمية شاردة لا يُتوقع من الماسك التقاطها وتسمح لعداء القاعدة بالتقدم)",
 "ぼうとうざい": "دعك, مادة مقوية (مادة تستخدم لتصلب شيء ما) / دعامة تقوية, مقوي (عضو متصل بقلب العارضة لمنع فقدان القوة بسبب انبعاج القلب)",
 "ぼうとか": "شغب (حالة من الاضطراب تنطوي على عنف جماعي)",
 "ぼうとく": "تَجْدِيف",
 "ぼうとくてき": "سَابّ, كُفْرِيّ (يتّسم بالتجديف أو السبّ والشتم) / كَافِر, مُجَدِّف (شديد الاستخفاف بما يُعتبَر مقدّساً)",
 "ぼうどう": "انتفاضة",
 "ぼうどうちんあつ": "مكافحة الشغب (التدابير المتخذة للسيطرة على أعمال الشغب)",
 "ぼうどくめん": "قِنَاع غَاز (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "ぼうどくマスク": "قِنَاع غَاز (غطاء يوضع على الوجه للحماية أو التنكر؛ طبق يوضع فيه الطعام. )\nمثال: نزع زيري القناع.",
 "ぼうにふる": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "ぼうにょう": "قلة البول (إنتاج كمية صغيرة بشكل غير طبيعي من البول) / شح البول, قلة البول (انتاج كمية صغيرة بشكل غير طبيعي من البول؛ يمكن أن يكون عرضاً لمرض الكلى أو انسداد المسالك البولية أو الوذمة أو عدم توازن السوائل والإلكتروليتات في…)",
 "ぼうにんげん": "رسم عود (رسم لإنسان أو حيوان يمثل الرأس بدائرة وبقية الجسم بخطوط مستقيمة)",
 "ぼうねん": "مُقَاوِم لِلْحَرِيق (لا تؤثر فيه النار)",
 "ぼうねんかい": "فِي نِهَايَةِ العَام (يَجْرِي فِي خِتَامِ السَّنَةِ المَالِيَّةِ) / نهاية العام (نهاية السنة التقويمية)\nمثال: اضطر لتفريغ البضائع قبل نهاية العام",
 "ぼうはく": "بصرف النظر, جانباً (غير مأخوذ في الاعتبار أو مستبعد) / ادِّخَارًا, جَانِبًا (في الاحتياط؛ ليس للاستخدام الفوري) / جَانِبًا (على أو إلى جانب واحد) / بَعِيدًا, جَانِبًا (بعيداً عن الطريق (خاصة بعيداً عن أفكار المرء))\nمثال: بصرف النظر عن هذه المشاكل، البلاد تبلي بلاءً حسناً",
 "ぼうはち": "يُوحَنَّا, يَحْيَى ((في المسيحية) أي من شخصيات الكتاب المقدس الذين تسموا بهذا الاسم، وأشهرهم: \"يُوحَنَّا الْمَعْمَدَان\"، و\"يُوحَنَّا الْإِنْجِيلِيّ\"…؛ (في المسيحية) إنجيل يوحنا، آخر الأناجيل القانونية الأربع) / إِنْجِيل يُوحَنَّا\nمثال: توم وماريا قالو ليوحنا, أنهم لا يعتقدون أن تكون ايلكا في الأسفل. / بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "ぼうはてい": "كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ) / حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "ぼうはへき": "كاسر الأمواج (هيكل واقي من الحجر أو الخرسانة؛ يمتد من الشاطئ إلى الماء لمنع جرف الشاطئ)",
 "ぼうはん": "ثَوْرَة, تَمَرُّد / أَمْن, أَمَان (وَثِقَ به وأرْكَنَ إليه) / حِمَايَة / ضَمَانَة, كَفَالَة (وَثِيقَةٌ يَضْمَنُ بِهَا شَخْصٌ شَخْصاً آخَرَ فِي غَرَضٍ مِنْ أَغْرَاضِ البَيْعِ وَقَضَايَا التَّعَامُلِ؛ وَثِيقَةٌ يَضْمَنُ بِهَا ٱلْبَائِعُ سَلاَمَةَ الْمَبِيعِ مِنْ كُلِّ عَيْبٍ وَبَقَاءَهُ صَالِحاً لِلاِسْتِعْمَالِ مُدَّةً مُعَيَّنَةً حَسَبَ…)\nمثال: اتصل زيري بالأمن.",
 "ぼうはんシステム": "نظام أمان (جهاز كهربائي يطلق إنذاراً عندما يحاول شخص ما الاقتحام) / نظام أمني ((في الحوسبة) نظام يفرض حدوداً بين شبكات الكمبيوتر)",
 "ぼうはんベル": "إنذار سرقة (جهاز تحذير ينطلق عند حدوث عملية سطو) / إنذار السرقة (إشارة تحذير عالية يصدرها جهاز إنذار السرقة)\nمثال: كان بإمكانهم سماع إنذار السرقة من مسافة ميل",
 "ぼうばく": "شَاسِع, وَاسِع / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "ぼうばり": "إبرة حياكة, سنارة تريكو (إبرة تتكون من قضيب رفيع ذي نهايات مدببة؛ تستخدم عادة في أزواج)",
 "ぼうび": "دِفَاع, حِمَايَة / دِفاع",
 "ぼうびき": "إلغاء (فعل الإلغاء؛ إلغاء ترتيب ما) / إبطال, إلغاء (الفعل الكلامي للإلغاء أو الفسخ أو الإبطال) / شَدّ اَلْحَبْل",
 "ぼうふ": "تحنيط (حفظ (الجثة) عن طريق المعالجة بالبلسم والأدوية ومواد كيميائية أخرى) / مُحْدَث اَلنَّعْمَة",
 "ぼうふう": "عَاصِفَة / طُوفَان (عاصفة) / عَاصْفة",
 "ぼうふうう": "عاصفة مطرية (عاصفة مصحوبة بمطر)",
 "ぼうふうせつ": "عَاصِفَة ثَلْجِيَّة, دَمَق",
 "ぼうふうりん": "مصد رياح (سياج من الأشجار مصمم لتخفيف قوة الرياح وتقليل التعرية)",
 "ぼうふざい": "مُعَقِّمٌ / مَادَّة حَافِظَة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم.",
 "ぼうふら": "يرقة البعوض (يرقة البعوض) / كَثِير الْحَرَكَة, مُتَمَلْمِل (شخص لا يستطيع البقاء ساكناً (خاصة الطفل))\nمثال: كان الطفل الصغير كثير الحركة حقاً في رحلات الطائرة",
 "ぼうふり": "قَائِدُ فِرْقَاتٍ مُوسِيقِيَّةٍ / كُمْسَرِيّ, كُمْسَارِيّ / مُوَصِّل كَهْرَبَائِيّ, مُوَصِّل",
 "ぼうふん": "احتفال بهيج, حفل (احتفال مبهج أو مناسبة اجتماعية كبيرة) / انفجار, عطل مفاجئ (عطل مفاجئ في جزء أو جهاز) / اكتساح, فوز سهل (انتصار سهل)\nمثال: انفجر الإطار الأمامي الأيمن",
 "ぼうぶら": "قَرْع, يَقْطِين (ضرب بشدة على شيء يَصْدُرُ منه صوت قوي؛ في سياق مجازي: أوقع الضربة أو وقع الصوت المفاجئ أو الحاد)\nمثال: توقف ذلك القرع.",
 "ぼうへき": "حَاجِز / عَقَبَة, حَاجِز",
 "ぼうべに": "أَحْمَر شِفَاه (أحد الألوان الرئيسية الثلاث (الأَحْمَر والأَصْفَر والأَزْرَق) وهو ما كان بلون الدَم أو النَار؛ صفة ما كان لونه أحمرا)\nمثال: أردت حذاء أحمر.",
 "ぼうぼう": "فُلَان, فُلَانَة (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو شخص لا يريد المتحدث ذكره)\nمثال: سمعنا ذلك من فلان و فلان. / مُسَطَّح / شَاسِع, وَاسِع / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم) / جَامِح, هَائِج / غَيْرُ مَصُون, مُهْمَل (لَا يُعْتَنَى بِهِ أَوْ يُصَانُ بِشَكْلٍ صَحِيح) / أَشْعَث (لَمْ يُمَشَّطْ بِعِنَايَة) / بقوة, بنشاط (بنشاط وحيوية)\nمثال: دافع عن أفكاره بقوة",
 "ぼうまん": "انتفاخ, تَمَدُّد (عملية التوسع عن طريق الضغط من الداخل) / تمدد, توسع (حالة التمدد إلى ما وراء الأبعاد الطبيعية) / سَيِّئُ الأَدَبِ, وَقِح (غير صحيح السلوك اجتماعياً)",
 "ぼうみん": "رعاع, غوغاء (حشد غير منظم من الناس) / عصابة (رابطة من المجرمين) / عصابة, نقابة الجريمة (تحالف فضفاض من رجال العصابات المسؤولين عن الأنشطة الإجرامية المنظمة)\nمثال: حاولت الشرطة تفكيك العصابة",
 "ぼうめい": "انشقاق, خذلان (سحب الدعم أو المساعدة رغم الولاء أو المسؤولية) / انشقاق, تخلي (حالة نبذ المعتقدات الدينية أو الحزب السياسي أو قضية ما (غالباً لصالح معتقدات أو قضايا معارضة))\nمثال: تخليه عن زوجته وأطفاله تركهم مفلسين",
 "ぼうめいきぼうしゃ": "طَالِب لُجُوء, طَالِبَة لُجُوء",
 "ぼうめいしゃ": "لَاجِئ, لَاجِئَة",
 "ぼうや": "فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى. / مراهق, يافع (حدث في المرحلة بين بداية البلوغ والنضج)",
 "ぼうよう": "إساءة استعمال, سوء استخدام (استخدام غير لائق أو مفرط)\nمثال: إساءة استعمال الكحول / شَاسِع, وَاسِع",
 "ぼうらく": "تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة) / أزمة اقتصادية, كساد (حالة اقتصادية طويلة الأمد تتميز بالبطالة وانخفاض الأسعار ومستويات منخفضة من التجارة والاستثمار)\nمثال: دخل الفريق في حالة ركود",
 "ぼうり": "رِبَا (في : طلب مَالٍ أكثر من الذي حدده القانون)",
 "ぼうりゃく": "مَكِيدَة",
 "ぼうりゃくか": "متآمر, مُدَبِّر (مخطط يضع خطة عمل شخصية)",
 "ぼうりゃくろん": "نَظَرِيَّة مُؤَامَرَة (مؤنث نَظَرْيّ، أي يفحض بالنظر لا بالإختبار؛ قضية غير مثبتة ولا مبرهنة لتفسير أمر ما)\nمثال: إنها مجرد نظرية.",
 "ぼうりゅう": "فَرْع, غُصْن",
 "ぼうりょく": "عُنْف, عَنْف / عُنْف",
 "ぼうりょくだん": "عصابة, نقابة الجريمة (تحالف فضفاض من رجال العصابات المسؤولين عن الأنشطة الإجرامية المنظمة)\nمثال: 暴力団は強盗を計画していた。 — خططت العصابة لسرقة.",
 "ぼうりょくだんいん": "سَارِق, عُضْو فِي عِصَابَة (اسم فاعل من سَرَقَ، الذي قام بالسرقة؛ لصّ، حرامي)\nمثال: ياني سارق بنوك.",
 "ぼうりょくだんくみいん": "يَاكُوزَا",
 "ぼうりょくてき": "عَنِيف",
 "ぼうるい": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما يُتَحصَّن به وإن لم يكن موضعا أو مكانا كالسلاح مثلا)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "ぼうれい": "شَبَح, خَيَال / طُغْيَان, اِسْتِبْدَاد",
 "ぼうろ": "بولو, سكين بولو (سكين ثقيل طويل بحافة واحدة؛ من أصل فلبيني) / ربطة بولو (حبل يثبت حول الرقبة بمشبك زينة ويُرتدى كربطة عنق)",
 "ぼうろう": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "ぼうろん": "انحراف عن المسار, خروج عن الطريق (الابتعاد عن المسار الرئيسي للرحلة) / انحراف, تحويل (التحول جانباً (عن مسارك أو انتباهك أو اهتمامك)) / اسْتِطْرَاد, جُمْلَة مُعْتَرِضَة (رسالة تخرج عن الموضوع الرئيسي)\nمثال: تحويل عن الطريق السريع الرئيسي",
 "ぼうキャンディ": "مصاصة",
 "ぼうキャンディー": "مصاصة",
 "ぼうキャンデー": "مصاصة",
 "ぼうグラフ": "رسم بياني بالأعمدة, مخطط شريطي (مخطط بأشرطة تتناسب أطوالها مع الكميات)",
 "ぼう然": "غَامِض, مُبْهَم (غير واضح التعبير أو المعنى) / غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة) / بَاهِت, خَافِت (يَفْتَقِر إِلَى الوُضُوح أَوِ التَّمَيُّز)\nمثال: مصطلح غير محدد (مبهم)",
 "ぼえん": "جبانة, مدفن (قطعة أرض تستخدم للدفن)",
 "ぼおっと": "بذهول, بفراغ (بطريقة خالية من التعبير)\nمثال: كانت تحدق بذهول في الغرفة / بشكل خافت, بشكل غامض (بطريقة خافتة غير واضحة) / بشكل خافت (بضوء خافت) / بشحوب, بضعف (بطريقة تفتقر إلى الاهتمام أو الحيوية)\nمثال: أدركنا التغيير بشكل غامض فقط",
 "ぼおん": "صَائِت, مُصَوِّت / حَرَكَة, حَرْفُ مَدّ / حَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ)\nمثال: لقد أوقفنا حركة المرور.",
 "ぼか": "قيمة دفتريّة (القيمة التي يُسجل بها الأصل في الميزانية العمومية؛ تساوي التكلفة ناقص الاستهلاك المتراكم)",
 "ぼかし": "غَشَّى, غَبَّش / لَطَّخَ, بَقَّعَ (لوَّثَ الشيءَ بسائل أو مادة لزجة؛ أصابه بشيء من العيب أو السوء)",
 "ぼかす": "غَشَّى, غَبَّش / لَطَّخَ, بَقَّعَ (لوَّثَ الشيءَ بسائل أو مادة لزجة؛ أصابه بشيء من العيب أو السوء) / مُظْلِم",
 "ぼかすか": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "ぼがい": "محار اللؤلؤ (ذوات صدفتين بحرية استوائية توجد بشكل رئيسي قبالة شرق آسيا وساحل المحيط الهادئ لأمريكا الشمالية وأمريكا الوسطى؛ مصدر رئيسي للؤلؤ)",
 "ぼがん": "غَثّ, شَوْب (الحيوان والإنسان: عجف وهزل، ضد سمن؛ غَثَّت الشاة، ق)",
 "ぼき": "مسك الدفاتر (نشاط تسجيل المعاملات التجارية)",
 "ぼきがかり": "مُحَاسِب, مُحَاسِبَة",
 "ぼきん": "تَبَرَّعَ",
 "ぼく": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / خادم رجل (خادم من الرجال) / إِلٰهِيّ / رَجُلُ دِينٍ, رِجالُ دِينٍ (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر. / اِخْتَارَ / الْمَكْسِيك, الميكسيك (دولة في الشطر الجنوبي من قارة أمريكا الشمالية؛ اسمها الرسمي الولايات المتحدة المكسيكية، وعاصمتها مدينة مكسيكو)\nمثال: قامت ثورة في المكسيك. / حِبْر, مِدَاد ((حَبَرَه): سَرَّه ونَعَّمَه؛ (حَبَرَ) الْبُرْدَ: وَشّاه وزَيَّنَه)\nمثال: لا تكتب بالحبر. / وَشْم / وَشَمَ, وَشَّمَ",
 "ぼくえき": "حبر صيني, حبر هندي (حبر سائل أسود يستخدم للطباعة أو الكتابة أو الرسم)",
 "ぼくぎょ": "حَبَّار",
 "ぼくけい": "وَشْم / وَشَمَ, وَشَّمَ",
 "ぼくし": "قِسِّيس (الذي يُقَسِّس الإبل أو الماشية أو الغنم، أي يحسن رعايتها، الراعي؛ عند المَسِيْحِيِّيْن هو لقب فوق الشَمَّاس ودون الأُسْقُف وهو القَسّ)",
 "ぼくしかん": "بيت القسيس, سكن الكاهن (مقر إقامة رسمي توفره الكنيسة لقسيسها أو كاهنها)",
 "ぼくしゃ": "عَرَّاف, عَرَّافَة / رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر. / حَظِيرَة, زَرِيبَة",
 "ぼくしゅ": "التزام, تمسك (الدعم المخلص لقضية أو حزب سياسي أو دين) / التصاق, تلاصق (خاصية الالتصاق معاً (كالغراء والخشب) أو انضمام أسطح مختلفة التكوين)\nمثال: الالتزام بأجندة رسمية",
 "ぼくしょう": "نَجَّار (صاحب مهنة النِجَارَة أو العامل فيها)",
 "ぼくしん": "مِقْلَاة (وعاء قلي الطعام) / ينتقد بشدَة",
 "ぼくじゅう": "حبر صيني, حبر هندي (حبر سائل أسود يستخدم للطباعة أو الكتابة أو الرسم) / حِبْر, مِدَاد ((حَبَرَه): سَرَّه ونَعَّمَه؛ (حَبَرَ) الْبُرْدَ: وَشّاه وزَيَّنَه)\nمثال: لا تكتب بالحبر.",
 "ぼくじゅつ": "عَرَافَة",
 "ぼくじょう": "مَزْرَعَة / مَرْعًى, مَسْرَح\nمثال: 牛が牧場で草を食べている。 — الأبقار يأكلون الأعشاب في البريّة. / مكان اجتماع, منتدى (منشأة عامة للاجتماع للمناقشة المفتوحة) / عَصًا (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "ぼくじょうしゅ": "صاحب مزرعة مواشي, مربي الماشية (شخص يملك أو يدير مزرعة كبيرة لتربية المواشي)",
 "ぼくじょうぬし": "صاحب مزرعة مواشي, مربي الماشية (شخص يملك أو يدير مزرعة كبيرة لتربية المواشي)",
 "ぼくじん": "رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر. / عَرَّاف, عَرَّافَة",
 "ぼくする": "إِلٰهِيّ / رَجُلُ دِينٍ, رِجالُ دِينٍ (العُضْو في جسد الإنسان يتكون من القَدَم والسَاق والفُخْذ. الجمع أرجُل، وقد تقول العامّة رِجْلين ورجْلينات؛ القَدَم من باب اطلاق اسم الكل على الجزء)\nمثال: هذا الرجل تاجر. / اِخْتَارَ / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "ぼくせき": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "ぼくせん": "عَرَافَة",
 "ぼくぜい": "عرافة, قراءة الطالع (ممارسة التنبؤ بمستقبل الناس (عادة مقابل أجر))",
 "ぼくそう": "مَرْعًى, مَسْرَح",
 "ぼくそうち": "مَرْعًى, مَسْرَح",
 "ぼくたく": "قَائِد, زَعِيم",
 "ぼくたち": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "ぼくち": "زجاجة حبر (زجاجة حبر)",
 "ぼくちく": "تربية الماشية (تربية الأبقار والمواشي)",
 "ぼくちくぎょう": "تربية الماشية (تربية الأبقار والمواشي)",
 "ぼくちょく": "بَسَاطَة",
 "ぼくちん": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "ぼくっこ": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "ぼくとつ": "بَسِيطٌ سَاذَج, رِيفِيّ (بَسِيطٌ بِطَرِيقَةٍ فَجَّةٍ وَقَرَوِيّ) / بَسِيط, غَيْر مُعَقَّد (يفتقر إلى التعقيد) / غَيْرُ دُنْيَوِيّ, غَيْرُ مُتَحَضِّر (لا يعرف طرق العالم ولا يملك خبرة فيها)",
 "ぼくどう": "رَاعِي بَقَر, رَعَوِيّ الْبَقَر",
 "ぼくねんじん": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "ぼくのプレミアライフ": "ذروة الإثارة (حالة من الإثارة الشديدة)\nمثال: كان الحشد في ذروة الإثارة",
 "ぼくはん": "جابونيكا, كاميليا يابانية (شجيرة دفيئة ذات أوراق خضراء لامعة وزهور مبهرجة عطرة تشبه الورد؛ تزرع في العديد من الأصناف)",
 "ぼくふ": "رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر.",
 "ぼくみん": "حَاكِم (مَسْؤُول عَنْ وَضْع القَوَانِين وَإِنْفَاذِهَا) / إدارة, حكم (فعل الحكم؛ ممارسة السلطة)\nمثال: لوائح لحكم سجون الولاية",
 "ぼくめつ": "استئصال, طمس (التدمير الكامل لكل أثر لشيء ما)",
 "ぼくや": "أرض رعي, مرعى (حقل مغطى بالعشب أو النباتات وصالح لرعي الماشية)",
 "ぼくようけん": "كلب راعي (أي من سلالات الكلاب المختلفة عادة ما تكون طويلة الشعر تربى لرعي وحراسة الأغنام)",
 "ぼくようしゃ": "راعي غنم (رجل يربي (أو يرعى) الأغنام) / راعي غنم (راعي أغنام ذكر (في المراعي المفتوحة)؛ شخص يبقي الأغنام معاً في قطيع)",
 "ぼくようしん": "مِقْلَاة (وعاء قلي الطعام) / ينتقد بشدَة",
 "ぼくら": "نحن (ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُثَنَّى وَالْجَمْعِ ( مُذَكَّراً وَمُؤَنَّثاً )؛ ضَمِيرُ رَفْعٍ مُنْفَصِلٌ لِلْمُتَكَلِّمِ فِي حَالَةِ التَّعْظِيمِ)\nمثال: نحن مهتمون جدا.",
 "ぼくり": "قُبْقَاب, قَبْقَاب (الجمل الهدّار ذو الصوت العالي؛ الكذاب الكثير الكلام والكذب والهذر)",
 "ぼけ": "مُغَفَّل, أَحْمَق / خرف, هرم (الضعف العقلي نتيجة لكبر السن) / خَارِج السِّيَاق, غَيْر مُلِمّ (غافل نتيجة عدم الاطلاع على المعلومات) / فَاقِدُ الإِحْسَاسِ, مُغْمًى عَلَيْهِ (لَا يَسْتَجِيبُ لِلتَّنْبِيهِ أَوِ المُؤَثِّرَاتِ) / مُسْتَبْعَد, مُهَمَّش (مُقصًى من نشاط أو مجموعة اجتماعية) / غَشَّى, غَبَّش / لَطَّخَ, بَقَّعَ (لوَّثَ الشيءَ بسائل أو مادة لزجة؛ أصابه بشيء من العيب أو السوء)",
 "ぼけあじ": "بوكيه",
 "ぼけい": "مَصْفُوفَة",
 "ぼけいせい": "الأمومية",
 "ぼけっと": "باسترخاء, بكسل (بطريقة خاملة)\nمثال: هذا ما كنت أتخيل نفسي أفعله دائماً في جنوب فرنسا، الجلوس باسترخاء، وشرب القهوة، ومراقبة الناس",
 "ぼけつ": "قَبْر, ضَرِيح (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: زار توم قبر ماري.",
 "ぼけなす": "بَطِيء الفَهْم, ضَعِيف العَقْل (متأخر في التطور العقلي والذهني)",
 "ぼけ味": "بوكيه",
 "ぼこう": "الجامعة الأم / الميناء الأم, ميناء التسجيل (الميناء الذي تنطلق منه السفينة أو المسجلة فيه) / إِمْبِرَاطُورَة الأُمّ",
 "ぼこくご": "لُغَة أُمّ, لُغَة قَوْمِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "ぼこっ": "خبطة, ضربة قوية (ضربة ثقيلة باليد) / خبط, دبدبة (صوت مكتوم ثقيل (كما ينتج عن ارتطام أشياء ثقيلة)) / بشكل بارز, بوضوح (بطريقة بارزة) / بشكل لافت, بوضوح تام (بطريقة تميل إلى جذب الانتباه)\nمثال: عُرضت السيارة الجديدة بشكل بارز في الممر",
 "ぼこぼこ": "أَجْوَف / مُثَقَّب, مُسَامِيّ (يسمح بالمرور دخولاً وخروجاً)",
 "ぼご": "لُغَة أُمّ, لُغَة قَوْمِيَّة (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "ぼごわしゃ": "نَاطِق أَصْلِيّ",
 "ぼさいぼう": "خلية أم (خلية تتطور منها خلية أخرى للكائن الحي (عادة من نوع مختلف))\nمثال: تتطور الخلية المنوية من خلية أم منوية",
 "ぼさち": "بُودِيسَاتْفَا",
 "ぼさっと": "بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود",
 "ぼさつ": "بُودِيسَاتْفَا / كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة والقِرَاءَة ومباديء الحِسَاب وبعض القُرَآن…) / سِفْر (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد) / سِجِل (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ) / حَجَزَ (حجَزهُ: مَنَعَهُ)\nمثال: هذا الكتاب جديد",
 "ぼさぼさ": "ذُو كَشَاكِش, مُكَشْكَش (ذو كشاكش أو حواشٍ زخرفية) / مُتَمَوِّج (مُهتزّ على شكل موجات أو تموّجات بفعل الرياح) / تضييع الوقت, عبث (الفعل المتعمد للتأخير واللعب بدلاً من العمل)",
 "ぼし": "شاهد القبر, نص القبر (نص منقوش على شاهد قبر أو نصب تذكاري لذكرى الشخص المدفون هناك) / مرثية, نقش ضريحي (بيان موجز لإحياء ذكرى شخص ميت) / إِبْهَام (الإِصْبَعُ الغليظةُ الخامسةُ من أَصابع اليد والرِّجل، وهي ذات سُلامَيَيْن (مؤنثة وقد تذكَّر) والجمع: أباهيم، وإبهامات) / إبهام القدم (الإصبع الأول الأكبر والأكثر تداخلًا في القدم)",
 "ぼしがいはんしょう": "إبهام أفحج, وكعة (تضخم مؤلم في الجراب الزلالي للمفصل الأول لإبهام القدم)",
 "ぼしつ": "حجرة الدفن, ضريح (حجرة تُستخدم كقبر)",
 "ぼしゅう": "تَعْبِئَة / تربية, تنشئة (مساعدة شخص ما على النمو ليكون عضواً مقبولاً في المجتمع) / مُتَزَايِد, مُرْتَفِع (يزداد في الكمّيّة أو القيمة) / تنشئة, رعاية (الخصائص المكتسبة نتيجة للطريقة التي عوملت بها كطفل) / ارتفاع, رفع (حدث رفع شيء ما إلى الأعلى)\nمثال: ارتفاع في درجة الحرارة بعد الظهر / تعويم, طرح أسهم (تمويل مؤسسة تجارية عن طريق السندات أو حصص الأسهم) / طفو (ظاهرة الطفو (البقاء على سطح السائل دون الغرق))",
 "ぼしゅうだん": "سُكَّان / سُكَّانِيَّة",
 "ぼしゅうにん": "المنجد",
 "ぼしょ": "مَقْبَرَة, مَقْبُرَة",
 "ぼしょく": "عِشَاء, غَسَق (طَعَام العَشِيّ. وهو الطعام الذي يؤكل في المَسَاء) / يَغْسِق, يَعْتِم\nمثال: هل العشاء جاهز؟",
 "ぼしょくそうぜん": "أَسْمَر البَشَرَة, دَاكِن البَشَرَة (ذو بشرة داكنة بطبيعتها) / شَفَقِيّ, مُتَلَأْلِئ بِنُور الغُرُوب (مُضَاء بِنُور الشَّفَق أَوْ كَأَنَّهُ كَذَلِك)",
 "ぼじょう": "شَوْق (نزوعُ النَّفْس إِلى الشيء، أو تَعَلُّقها به؛ مصدر الفعل شَاقَ)\nمثال: سأشعر بالشوق إليك.",
 "ぼすう": "وَسِيط, بَارَامِتِر / مَعْلَم, وَسِيط (من يمتهن التعليم، مُدَرِّس)\nمثال: هي أصبحت معلمة.",
 "ぼせい": "أُمُومَة",
 "ぼせいてき": "أُمِّيّ, أُمُومِيّ",
 "ぼせき": "شاهد القبر (حجر يستخدم لتحديد مكان القبر)",
 "ぼせん": "حَافِلَة, بَاص (وسيلة نَقْل للركاب) / نَاقِل\nمثال: لنذهب بالحافلة.",
 "ぼぜん": "أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا",
 "ぼそっと": "بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود",
 "ぼそぼそ": "بائت, فاسد (يفتقر إلى النضارة أو الطعم المستساغ، أو يظهر عليه التدهور بسبب القدم) / بَالٍ, قَدِيم (يفتقر للأصالة أو العفوية؛ لم يعد جديداً)\nمثال: خبز بائت",
 "ぼたい": "قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء / رَحِم, بَيْت الْوَلِد (رَحِم: عضو تناسلي أنثوي داخلي مستجيب للهرمون الأنثوي في الجهاز التناسلي لدى البشر ومعظم الثدييات الأخرى؛ الجمع: أرحام) / مَنشَأ, رَحِم\nمثال: رحمة الله عليه. / قَاعِدَة / قَاعِدَة, مَرْكَز / يُبْنَى عَلَى, يَسْتَنِدُ إِلَى / شائع / منخفض, فاسق / دنيء",
 "ぼたぼた": "غارقاً في البلل, مبللاً تماماً (رطب للغاية) / تقاطر, خرير (صوت سقوط سائل قطرة بقطرة) / تقاطر, تنقيط (سائل (كالماء) يتدفق في قطرات (كما من طنف المنزل))\nمثال: مبلل تماماً / بِبُطْء",
 "ぼたやま": "كومة الخبث, كومة ركام المعادن (كومة من مواد النفايات الناتجة عن تعدين الفحم وما شابه)",
 "ぼたり": "رَاشِح, نَازِّ (يتسرّب ببطء) / رشح, نزيز (عملية التسرب ببطء)",
 "ぼたん": "خَنْزِير بَرِيّ",
 "ぼたんいんこ": "طائر الحب (ببغاء أفريقي صغير يشتهر بإظهار المودة لرفيقه) / بادجي, ببغاء الدرة (ببغاء أسترالي صغير عادة ما يكون لونه أخضر فاتح مع علامات سوداء وصفراء في البرية ولكن يتم تربيته بألوان عديدة)",
 "ぼたんづる": "ظَيَّان",
 "ぼた山": "كومة الخبث, كومة ركام المعادن (كومة من مواد النفايات الناتجة عن تعدين الفحم وما شابه)",
 "ぼだい": "تَنْوِير",
 "ぼだいさった": "بُودِيسَاتْفَا",
 "ぼだいじゅ": "بيبال, تين مقدس (شجرة تين من الهند تشتهر بحجمها الكبير وطول عمرها؛ تفتقر إلى الجذور الداعمة للبانيان؛ تعتبر مقدسة لدى البوذيين)",
 "ぼち": "جبانة, مدفن (قطعة أرض تستخدم للدفن)",
 "ぼちぼち": "على مهل, في وقت الفراغ (بطريقة غير متسرعة أو في الوقت المناسب) / مُسْتَرْسِل, هَادِئ (غير مُتعجّل ولا قسريّ)\nمثال: اقرأ الدليل في وقت فراغك / قَرِيبًا, سَرْعَانَ مَا / هُنَا وَهُنَاكَ / سالك, قابل للمرور (يمكن اجتيازه أو عبوره) / لَا بَأْسَ بِهِ, مَقْبُول (متوسّط المستوى تقريبًا؛ يمكن القبول به)\nمثال: الطريق سالك",
 "ぼちゃぼちゃ": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح)",
 "ぼっか": "سفرجل ياباني (شجيرة شائكة متساقطة الأوراق موطنها الصين لها أزهار حمراء أو بيضاء) / بُكُولِيّ, رَعَوِيّ (يتّسم بطابع الحياة الريفيّة المثاليّة والبساطة الشاعريّة) / رعوي, كهنوتي (متعلق بالقس أو الراعي الكنسي) / رعوي, ريفي (متعلق بالرعاة أو تربية الأغنام والماشية) / أدب رعوي, رعوية (عمل أدبي يضفي المثالية على الحياة الريفية (خاصة حياة الرعاة))\nمثال: عمل رعوي",
 "ぼっかく": "فَنَّان, فَنَّانَة (من يصنع الفَنَّ، من يمتهنه؛ مَوْهُوب)\nمثال: إنه فنان مشهور.",
 "ぼっかてき": "بُكُولِيّ, رَعَوِيّ (يتّسم بطابع الحياة الريفيّة المثاليّة والبساطة الشاعريّة) / رعوي, كهنوتي (متعلق بالقس أو الراعي الكنسي) / رعوي, ريفي (متعلق بالرعاة أو تربية الأغنام والماشية) / أدب رعوي, رعوية (عمل أدبي يضفي المثالية على الحياة الريفية (خاصة حياة الرعاة))\nمثال: عمل رعوي",
 "ぼっき": "نُعُوظ, اِنْتِصَاب",
 "ぼっきしょうがい": "خلل الانتصاب, ضعف الانتصاب (عجز ناتج عن عدم قدرة الرجل على الحصول على انتصاب للقضيب أو الحفاظ عليه)",
 "ぼっきふぜん": "خلل الانتصاب, ضعف الانتصاب (عجز ناتج عن عدم قدرة الرجل على الحصول على انتصاب للقضيب أو الحفاظ عليه)",
 "ぼっきゃく": "فَنَّان, فَنَّانَة (من يصنع الفَنَّ، من يمتهنه؛ مَوْهُوب)\nمثال: إنه فنان مشهور. / تَجَاهَلَ, طَنَّش",
 "ぼっくり": "قُبْقَاب, قَبْقَاب (الجمل الهدّار ذو الصوت العالي؛ الكذاب الكثير الكلام والكذب والهذر)",
 "ぼっけい": "وَشْم / وَشَمَ, وَشَّمَ",
 "ぼっこうしょう": "اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع بالاكتفاء الذاتي والقدرة على اتخاذ القرارات دون تدخل خارجي)\nمثال: الصحراويون يريدون الاستقلال.",
 "ぼっこつ": "عَرَافَة",
 "ぼっこん": "خَطّ يَد, خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "ぼっしゅ": "فقدان كعقوبة, مصادرة (فعل فقدان أو تسليم شيء ما كعقوبة لخطأ أو فشل في الأداء) / شرط جزائي, مصادرة (عقوبة لخطأ أو هفوة تتضمن خسارة أو التخلي عن شيء ما) / فقدان الحق, مصادرة (شيء يتم فقده أو التنازل عنه كعقوبة)\nمثال: حدد العقد مصادرات إذا لم يكتمل العمل في الوقت المحدد",
 "ぼっしゅう": "حجز, مصادرة (الاستيلاء على شيء عن طريق الإجراءات القانونية) / أسر, سيطرة (فعل نزع ملكية المالك بالقوة) / أسر, احتجاز (فعل أخذ شخص بالقوة) / نوبة مرضية (حدوث مفاجئ (أو تكرار) لمرض)\nمثال: عانى من نوبة صرع",
 "ぼっしゅみ": "انْعِدَام الذَّوْق (عدم الأناقة الذي يدل عليه الافتقار إلى الذوق الرفيع) / انعدام النكهة, تفاهة (خاصية عدم امتلاك أي نكهة)",
 "ぼっする": "غَطَسَ / مَجْلَى, مَغْسَلَة / مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات. / اِخْتَفَى (تعمّد وتكلف إخفاء نفسه عنه الأنظار فلا يُرى؛ خَفِيَ بعد أن كان مرئيًّا) / أَخْفَى\nمثال: لقد اختفى فاضل. / صَادَرَ",
 "ぼったくり": "زيادة في السعر, سعر مبالغ فيه (سعر مرتفع جداً)",
 "ぼったくる": "زيادة في السعر, سعر مبالغ فيه (سعر مرتفع جداً)",
 "ぼったり": "رَاشِح, نَازِّ (يتسرّب ببطء) / رشح, نزيز (عملية التسرب ببطء)",
 "ぼっち": "عُقدة, مقبض دائري (مقبض مستدير الشكل) / عقدة, مقبض (نتوء أو بروز دائري مستدير) / مقبض مزخرف (زخرفة على شكل كرة على مقبض السيف أو الخنجر) / تغلظ, عقدة (أي تضخم سميك) / انطواء, عزلة (ميل نحو البقاء وحيداً)",
 "ぼっちゃま": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير. / شاب (مراهق أو شاب بالغ ذكر)",
 "ぼっちゃん": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير. / شاب (مراهق أو شاب بالغ ذكر)",
 "ぼってり": "زَائِد الوَزْن, ضَخْم البِنْيَة (يَصِف عَادَةً شَخْصًا كَبِيرًا بَدِينًا لَكِنْ لَه هَيْكَل كَبِير يَحْمِل وَزْنَه) / لحمي (مكون من أو متعلق بـ أو يشبه اللحم) / بثقل, بشكل كبير (بدرجة كبيرة) / بإفراط, بشراهة (الانغماس بإفراط) / بثقل, بصعوبة (بطريقة مجهدة) / بثقل (ببطء كما لو كان مثقلاً بوزن كبير)\nمثال: اعتمد بشكل كبير على بيانات الآخرين",
 "ぼっと": "بذهول, بفراغ (بطريقة خالية من التعبير)\nمثال: كانت تحدق بذهول في الغرفة / بشكل خافت, بشكل غامض (بطريقة خافتة غير واضحة) / بشكل خافت (بضوء خافت) / بشحوب, بضعف (بطريقة تفتقر إلى الاهتمام أو الحيوية)\nمثال: أدركنا التغيير بشكل غامض فقط",
 "ぼっとんべんじょ": "مِرْحَاض خَارِجِيّ",
 "ぼっとん便所": "مِرْحَاض خَارِجِيّ",
 "ぼっぱつ": "تَفَشٍّ",
 "ぼっ発": "تَفَشٍّ",
 "ぼつ": "مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي) / وَفَاة / هَلَاك / مَنِيَّة / حِمَام (قضاء الموت وقدره؛ جمع حُمَّة وهو قدر الفراق) / موت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / رَفْض, إِبَاء (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟ / غَائِب, مَفْقُود (غير موجود أو مفتقد) / مُفْعَم بِالحَيَاة, مُنْتَعِش (أُضفِيَت عليه الحيويّة والنشاط) / جَرِيء, ذُو هِمَّة (مُسْتَعِدّ لِمُوَاجَهَة الخَطَر) / حَيَوِيّ, مِقْدَام (يتميّز بالحركة النشطة والحيوية) / حيوي, مفعم بالحيوية (يظهر حيوية أو نشاطًا أو حماسًا) / مُبَاغِت, مُفَاجِئ",
 "ぼつが": "إِيثَار, غَيْرِيَّة",
 "ぼつがてき": "مُتَكَتِّم, مُتَوَارٍ (يتجنّب لفت الانتباه إلى نفسه؛ متحفّظ ومنسحب)",
 "ぼつぎどう": "وحشية",
 "ぼつこうしょう": "اِسْتِقْلَال (التحرر من السيطرة أو الاعتماد على الغير، سواء كان ذلك فرديًا أو جماعيًا؛ التمتع بالاكتفاء الذاتي والقدرة على اتخاذ القرارات دون تدخل خارجي)\nمثال: الصحراويون يريدون الاستقلال.",
 "ぼつこせいてき": "غَيْر شَخْصِيّ, مُحَايِد (لا تفضيل شخصيّ لديه) / عام, غير شخصي (لا يتعلق بالأشخاص الفرديين أو لا يستجيب لهم)\nمثال: شركة غير شخصية",
 "ぼつご": "بعد الوفاة (بعد الموت)\nمثال: نُشرت مقطوعات البيانو هذه بعد الوفاة",
 "ぼつしゅみ": "انْعِدَام الذَّوْق (عدم الأناقة الذي يدل عليه الافتقار إلى الذوق الرفيع) / انعدام النكهة, تفاهة (خاصية عدم امتلاك أي نكهة)",
 "ぼつぜん": "فَجْأَةً",
 "ぼつにする": "رَفَضَ (رَمَى، تَرَكَ لم يقبل؛ طَرَدَ، لَفَظَ، صَدَّ)\nمثال: لقد رفض أن يدفع؟",
 "ぼつにゅう": "تغطيس, غمر (فعل تبليل شيء بغمره) / تغطيس (شكل من أشكال المعمودية يغمر فيه جزء أو كل جسم الشخص) / استغراق, انهماك (انتباه كامل؛ جهد عقلي مكثف) / احتجاب, دخول ((في علم الفلك) اختفاء جرم سماوي قبل الكسوف) / غَرَق",
 "ぼつにゅうかん": "تغطيس, غمر (فعل تبليل شيء بغمره) / تغطيس (شكل من أشكال المعمودية يغمر فيه جزء أو كل جسم الشخص) / استغراق, انهماك (انتباه كامل؛ جهد عقلي مكثف) / احتجاب, دخول ((في علم الفلك) اختفاء جرم سماوي قبل الكسوف)",
 "ぼつふうりゅう": "خشن, غير مهذب ((للأشخاص وسلوكهم) غير مهذب؛ فظ) / خام, غير مكرر (غير مكرر أو معالج)\nمثال: كيف يمكن لفتاة مهذبة أن تنجذب لرجل خشن كهذا؟",
 "ぼつふうりゅうかん": "فلستيون",
 "ぼつぶんぎょうかん": "أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "ぼつぼつ": "شَيْئاً فَشَيْئاً, خُطْوةً فَخُطْوةً / قَرِيبًا, سَرْعَانَ مَا / هُنَا وَهُنَاكَ / أجسام طافية, ذباب طائر (بقع أمام العينين تسببها شظايا خلايا معتمة في الجسم الزجاجي والعدسة)\nمثال: تبدو الأجسام الطافية وكأنها تنجرف عبر مجال الرؤية / مُفْعَم بِالحَيَاة, مُنْتَعِش (أُضفِيَت عليه الحيويّة والنشاط) / جَرِيء, ذُو هِمَّة (مُسْتَعِدّ لِمُوَاجَهَة الخَطَر) / حَيَوِيّ, مِقْدَام (يتميّز بالحركة النشطة والحيوية) / حيوي, مفعم بالحيوية (يظهر حيوية أو نشاطًا أو حماسًا)",
 "ぼつらく": "خَرَاب, خَرَابَة / دَمَّرَ",
 "ぼつりそう": "بَرَاغْمَاتِيَّة, وَاقِعِيَّة (سمة قبول حقائق الحياة وتفضيل العملية والحقيقة الحرفية) / أفلاطونية, واقعية ((فلسفة) المذهب الفلسفي القائل بأن المفاهيم المجردة توجد مستقلة عن أسمائها) / واقعية, واقعية ساذجة ((فلسفة) المذهب الفلسفي القائل بأن الأشياء المادية تستمر في الوجود عندما لا يتم إدراكها) / الطبيعية, الواقعية (حركة فنية في فرنسا في القرن التاسع عشر؛ سعى الفنانون والكتاب للحصول على وصف واقعي وواقعي مفصل)",
 "ぼてっと": "بِاكْتِظَاظ, بِكَثَافَة (بطريقة مركزة) / بتتابع سريع, بكثافة (في تتابع سريع) / بلسان ثقيل (التحدث بلفظ ضعيف كما لو كان اللسان ثقيلاً) / بطبقة سميكة, بكثافة (بسمك؛ بطريقة سميكة)\nمثال: المنازل القديمة غالباً ما تكون مكتظة بكثافة لدرجة أنه ربما يجب هدم ثلاثة أو أربعة مقابل كل منزل جديد يبنى",
 "ぼてぼて": "ضَخْم / ضَعِيف",
 "ぼとぼと": "غارقاً في البلل, مبللاً تماماً (رطب للغاية) / تقاطر, خرير (صوت سقوط سائل قطرة بقطرة) / تقاطر, تنقيط (سائل (كالماء) يتدفق في قطرات (كما من طنف المنزل))\nمثال: مبلل تماماً",
 "ぼどう": "أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "ぼにゅう": "حليب الأم (حليب تفرزه المرأة التي وضعت مولوداً حديثاً) / تخصيص, تقسيم (فعل التوزيع عن طريق التخصيص أو التقسيم؛ التوزيع وفقاً لخطة) / تخصيص, مخصص (حصة مخصصة لغرض محدد)\nمثال: يعتمد توزيع المقاعد في مجلس النواب على الكثافة السكانية لكل ولاية",
 "ぼにゅうえいよう": "رضاعة طبيعية (التغذية من الثدي)",
 "ぼはん": "وحمة (شائبة على الجلد تتكون قبل الولادة)",
 "ぼば": "حصان (الواحد الذكر من الخَيْل؛ يطلق مجازًا على الواحد من الخيل الذي لا يُعرف ذكر كان أم أنثى)\nمثال: لم يشفى الحصان.",
 "ぼひ": "شاهد القبر (حجر يستخدم لتحديد مكان القبر)",
 "ぼひめい": "شاهد القبر, نص القبر (نص منقوش على شاهد قبر أو نصب تذكاري لذكرى الشخص المدفون هناك) / مرثية, نقش ضريحي (بيان موجز لإحياء ذكرى شخص ميت)",
 "ぼひょう": "شاهد القبر (حجر يستخدم لتحديد مكان القبر)",
 "ぼへい": "متطوع, مُجنّد (أي عضو أو مؤيد جديد (كما في القوات المسلحة)) / مجند جديد, مستجد (جندي تم تجنيده حديثاً)",
 "ぼぼ": "كِس, كُس (الشيءَ: دقّه دقَّا شديدا أو ضغطه أو دعكه) / جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "ぼや": "لَيْلَة, لَيْل (واحِدَة اللَيْل، وهو الزمن في اليوم من مَغْرِب الشمس حتى طلوع الفَجْر. قيل الليل والليلة واحد وقيل الليل ضد النهار والليلة ضد اليوم وقيل الليلة مفرد…؛ أحيانا تستخدم بمعنى اليَوْم كما يستخدم اليوم بمعنى النَهَار) / عشية, ليلة / مَغْرِب, مغْرب (مَكَان غُرُوب الشَمْس، ويقصد به الغَرْب مجَازًا؛ زَمَان غروب الشمس)\nمثال: كانت ليلة رائعة.",
 "ぼやき": "شِكَايَة, شَكْوَى",
 "ぼやく": "قَمْقَمَ",
 "ぼやっと": "بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود",
 "ぼやぼや": "اِنْتِفَاضَة, تَمَرُّد (معارضة منظمة للسلطة؛ صراع يحاول فيه فصيل انتزاع السيطرة من آخر) / بَازِغ, صَاعِد (برز حديثاً إلى الواجهة) / صَاعِد, نَاشِئ (يَبْلُغُ مَرْحَلَةَ النُّضْج) / طَالِع, مُنْحَدِرٌ صُعُودًا (مَائِلٌ نَحْوَ الأَعْلَى)",
 "ぼら": "بوري مخطط (أهم أنواع البوري التجارية في شرق الولايات المتحدة)",
 "ぼらぼら": "وَاحِدًا تِلْوَ الآخَرِ",
 "ぼりぼり": "قضم, مضغ (قضمة كبيرة)\nمثال: حاول التحدث بين قضمات الشطيرة / خدش, كشط (ضجيج خشن ناتج عن الكشط)\nمثال: شتت انتباهها كشط أقواس الكمان",
 "ぼる": "زيادة في السعر, سعر مبالغ فيه (سعر مرتفع جداً)",
 "ぼれい": "مَحَار",
 "ぼろ": "عَظِيم, هَائِل (كبير بشكل استثنائي في الحجم أو المدى أو الكمية أو القوة أو الدرجة) / رَائِع, عَظِيم (جيد أو عظيم بشكل استثنائي؛ يُستخدم خاصة كمكثف) / شَدِيد, مَهُول (بالغ في الدرجة أو المدى أو المقدار أو التأثير)",
 "ぼろい": "مُدِرّ لِلْأَرْبَاح, مُرْبِح جِدًّا (ينتج ربحًا كبيرًا ووافرًا) / بَالٍ",
 "ぼろいち": "سوق البراغيث, سوق السلع المستعملة (سوق شوارع مفتوح للسلع الرخيصة أو المستعملة)",
 "ぼろきれ": "خِرْقَة",
 "ぼろくそ": "لَا قِيمَةَ لَهُ, حَقِير (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة. / ازْدِرَائِيّ, انْتِقَاصِيّ (يُعَبِّر عن رأي مُتَدَنٍّ)",
 "ぼろくそにいう": "زُبَالَة, نُفَايَات / سَلُّة الْمُهْمَلَات",
 "ぼろくそに言う": "زُبَالَة, نُفَايَات / سَلُّة الْمُهْمَلَات",
 "ぼろぞうきん": "مُحَطَّم, مُهَشَّم (متضرر من الضربات أو الاستعمال القاسي)",
 "ぼろっちい": "بَالٍ",
 "ぼろにんぎょう": "دمية قماشية (دمية من القماش محشوة و(عادة) مرسومة)",
 "ぼろぬの": "خِرْقَة",
 "ぼろぼろ": "بَالٍ / سَاقِط, مُتَسَاقِط (يَنْزِلُ بِحُرِّيَّةٍ تَحْتَ تَأْثِيرِ الجَاذِبِيَّة) / منخفض, هابط (يصبح أقل أو أصغر في الدرجة أو القيمة) / مُتَرَاجِع, هَابِط (يتناقص في الكمّيّة أو الدرجة)\nمثال: سوق هابطة / وَاحِدًا تِلْوَ الآخَرِ",
 "ぼろまけ": "دحر, هزيمة منكرة (هزيمة ساحقة) / رعاع, غوغاء (حشد غير منظم من الناس)",
 "ぼろもうけ": "كسب يسير, مال سهل (دخل يتم الحصول عليه بحد أدنى من الجهد) / المال السهل (الحالة الاقتصادية التي يكون فيها الحصول على الائتمان سهلاً)",
 "ぼろや": "مُتَهَالِك, مُنْتَهِي الطَّاقَة (نَفِدَت طَاقَة نَابِضِه) / مُتَدَاعٍ, مُتَهَالِك (بَالٍ وَمُتَحَطِّمٌ بِسَبَبِ الاسْتِعْمَالِ الشَّدِيدِ)",
 "ぼろ人形": "دمية قماشية (دمية من القماش محشوة و(عادة) مرسومة)",
 "ぼろ儲け": "كسب يسير, مال سهل (دخل يتم الحصول عليه بحد أدنى من الجهد) / المال السهل (الحالة الاقتصادية التي يكون فيها الحصول على الائتمان سهلاً)",
 "ぼろ切れ": "خِرْقَة",
 "ぼろ市": "سوق البراغيث, سوق السلع المستعملة (سوق شوارع مفتوح للسلع الرخيصة أو المستعملة)",
 "ぼろ布": "خِرْقَة",
 "ぼろ負け": "دحر, هزيمة منكرة (هزيمة ساحقة) / رعاع, غوغاء (حشد غير منظم من الناس)",
 "ぼん": "صِينِيَّة (نوع من آنية المطبخ تستخدم لوضع الآواني عليها حين تنقل تكون مسطحة وواسعة؛ القُصْعَة؛ آنية واسعة يُصَّب فيها طعام يكفي عصبة من الناس)\nمثال: هذه شركة صينية. / فَصِيلَة (ولد الناقة أو البقرة بعد أن يفصل عن أمه، الجمع فِصال وفصلان؛ فصيلة الرجل: المقرّبون إليه من عشيرته) / أُسْرَة\nمثال: يريد سامي أن يبيع كلبه من فصيلة الشيبا إينو. / بُون / عَادِيّ, مَأْلُوف / رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة) / فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى. / براهمان (أي من عدة سلالات من الماشية الهندية؛ خاصة سلالة أمريكية كبيرة رمادية اللون ذات سنام مقاومة للحرارة والقراد تطورت في ولايات الخليج عن طريق تزاوج…) / براهمة (أعلى الطبقات الأربع: الفئة الكهنوتية) / براهمي (عضو في أعلى الطبقات الأربع الهندوسية (فارنا)) / براهمان (عضو في نخبة اجتماعية وثقافية (خاصة سليل عائلة عريقة من نيو إنجلاند))\nمثال: في الأصل كان جميع البراهمة كهنة / سَنْسْكْرِيتِيّ",
 "ぼんくら": "غَبِيّ / غَبِيّ, أَحْمَق / أحمق, بليد (شخص غبي؛ تستخدم هذه الكلمات للتعبير عن رأي متدنٍ في ذكاء شخص ما)",
 "ぼんぐ": "شخص من العامة, عامّي (شخص لا يحمل أي لقب نبيل)",
 "ぼんご": "سَنْسْكْرِيتِيّ",
 "ぼんさい": "تَوَسُّط, رَدَاءَة نِسْبِيَّة (العادية نتيجة لكون الشيء متوسطاً وغير متميز) / شَخْص مِنَ الدَّرَجَة الثَّانِيَة, مُتَوَسِّط الْمُسْتَوَى (شخص ذو قدرة أو قيمة من الدرجة الثانية) / بُونْسَاي",
 "ぼんさつ": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع",
 "ぼんさま": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة) / فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى.",
 "ぼんしょ": "عامة الناس, قوم (الناس بشكل عام (وغالباً ما تستخدم بصيغة الجمع))\nمثال: إنهم مجرد ناس ريفيين",
 "ぼんじょう": "عَادِيّ, مَأْلُوف",
 "ぼんじり": "ذيل الطائر (ذيل الطائر المجهز للأكل)",
 "ぼんず": "قَصَّة قَصِيرَة جِدّاً (قصة شعر قصيرة جداً؛ عادة للرجال أو الأولاد) / فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى.",
 "ぼんせつ": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع",
 "ぼんそう": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "ぼんぞく": "تَوَسُّط, رَدَاءَة نِسْبِيَّة (العادية نتيجة لكون الشيء متوسطاً وغير متميز) / شَخْص مِنَ الدَّرَجَة الثَّانِيَة, مُتَوَسِّط الْمُسْتَوَى (شخص ذو قدرة أو قيمة من الدرجة الثانية)",
 "ぼんたい": "تَوَسُّط, رَدَاءَة نِسْبِيَّة (العادية نتيجة لكون الشيء متوسطاً وغير متميز) / شَخْص مِنَ الدَّرَجَة الثَّانِيَة, مُتَوَسِّط الْمُسْتَوَى (شخص ذو قدرة أو قيمة من الدرجة الثانية)",
 "ぼんたん": "زَنْبُوع, بُومَلِيّ",
 "ぼんち": "طَشْت / حوض (حَوَّضَ: عمِل حوضًا؛ حَوَّضَ (الماءَ): حاضَه)\nمثال: ملأت الحوض ماءا. / فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم) / صَبِيّ, فَتًى / ياه\nمثال: ترى الفتاة الفتى.",
 "ぼんてん": "براهمان (أي من عدة سلالات من الماشية الهندية؛ خاصة سلالة أمريكية كبيرة رمادية اللون ذات سنام مقاومة للحرارة والقراد تطورت في ولايات الخليج عن طريق تزاوج…) / شَمَنْدُورَة / عَوَّامَة",
 "ぼんてんおう": "براهمان (أي من عدة سلالات من الماشية الهندية؛ خاصة سلالة أمريكية كبيرة رمادية اللون ذات سنام مقاومة للحرارة والقراد تطورت في ولايات الخليج عن طريق تزاوج…)",
 "ぼんてんのう": "براهمان (أي من عدة سلالات من الماشية الهندية؛ خاصة سلالة أمريكية كبيرة رمادية اللون ذات سنام مقاومة للحرارة والقراد تطورت في ولايات الخليج عن طريق تزاوج…)",
 "ぼんてんまるもかくありたい": "لَيْتَ, تَمَنَّى (يفيد التمني)\nمثال: ليت بحاجة لتعمل ساعات إضافية.",
 "ぼんでん": "براهمان (أي من عدة سلالات من الماشية الهندية؛ خاصة سلالة أمريكية كبيرة رمادية اللون ذات سنام مقاومة للحرارة والقراد تطورت في ولايات الخليج عن طريق تزاوج…) / شَمَنْدُورَة / عَوَّامَة",
 "ぼんとしょうがつがいっしょにきたよう": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "ぼんならざる": "غير شائع, غير مألوف (غير شائع أو لا يصادف عادة؛ عظيم المقدار بشكل غير عادي أو لافت للنظر في طابعه أو نوعه) / فَرِيد, نَادِر (يتميز بجودة غير مألوفة؛ خاصة من الدرجة العليا أو المتطرفة في نوعه)\nمثال: طيور غير شائعة",
 "ぼんひゃく": "مُخْتَلِف, مُتَنَوَّع",
 "ぼんびゃく": "مُخْتَلِف, مُتَنَوَّع",
 "ぼんびー": "فَقِير / مِسْكِين / فُقَرَاء",
 "ぼんぴゃく": "مُخْتَلِف, مُتَنَوَّع",
 "ぼんぼん": "عَادِيّ, مَأْلُوف / بِشَرَاسَة, بِضَرَاوَة (بطريقة شرسة جسدياً) / بِحِدَّة, بِعُنْف (بطريقة عنيفة عاطفياً)\nمثال: صمت كسره نباح الكلاب بشراسة",
 "ぼんぼんどけい": "ساعة حائط (ساعة مثبتة على الحائط)",
 "ぼんぼん時計": "ساعة حائط (ساعة مثبتة على الحائط)",
 "ぼんやり": "بشكل خافت, بشكل غامض (بطريقة خافتة غير واضحة) / بشكل خافت (بضوء خافت) / بشحوب, بضعف (بطريقة تفتقر إلى الاهتمام أو الحيوية)\nمثال: أدركنا التغيير بشكل غامض فقط / بذهول, بشرود (بطريقة شاردة الذهن أو مشغولة البال)\nمثال: قرأ الرسالة بشرود / باسترخاء, بكسل (بطريقة خاملة)\nمثال: هذا ما كنت أتخيل نفسي أفعله دائماً في جنوب فرنسا، الجلوس باسترخاء، وشرب القهوة، ومراقبة الناس / شرود الذهن (انشغال كبير لدرجة تجاهل متطلبات الانتباه العادية)",
 "ぼんよう": "مُتَوَسِّط",
 "ぼーっと": "بذهول, بفراغ (بطريقة خالية من التعبير)\nمثال: كانت تحدق بذهول في الغرفة / بشكل خافت, بشكل غامض (بطريقة خافتة غير واضحة) / بشكل خافت (بضوء خافت) / بشحوب, بضعف (بطريقة تفتقر إلى الاهتمام أو الحيوية)\nمثال: أدركنا التغيير بشكل غامض فقط",
 "ぼーと": "بذهول, بفراغ (بطريقة خالية من التعبير)\nمثال: كانت تحدق بذهول في الغرفة / بشكل خافت, بشكل غامض (بطريقة خافتة غير واضحة) / بشكل خافت (بضوء خافت) / بشحوب, بضعف (بطريقة تفتقر إلى الاهتمام أو الحيوية)\nمثال: أدركنا التغيير بشكل غامض فقط",
 "ぼーぼー": "بقوة, بنشاط (بنشاط وحيوية)\nمثال: دافع عن أفكاره بقوة",
 "ぽ": "الْبُرْتُغَال, البرتغال (دولة في جنوب غرب أوروبا، تقع في الجزء الغربي من شبه الجزيرة الأيبيرية؛ اسمها الرسمي الجمهورية البرتغالية، وعاصمتها لشبونة)\nمثال: أنا من البرتغال. / بُولَنْدَا, بُولُونِيَا (دولة تقع في وسط أوروبا. اسمها الرسمي: جمهورية بولندا. عاصمتها وأكبر مدينة فيها: وارسو)\nمثال: أظن أننا ما زلنا في بولندا.",
 "ぽい": "ـِيّ / بإهمال, بلا مبالاة (دون عناية أو اهتمام) / بأناقة متمردة, باستهتار (بطريقة مستهترة أو مائلة) / بِتَهَوُّر, دُونَ حَذَر (بدون حذر أو حكمة)\nمثال: رفع آمال الأطفال بإهمال",
 "ぽいすて": "مِحَفَّة / بَعْثَرَ",
 "ぽいっ": "بإهمال, بلا مبالاة (دون عناية أو اهتمام) / بأناقة متمردة, باستهتار (بطريقة مستهترة أو مائلة) / بِتَهَوُّر, دُونَ حَذَر (بدون حذر أو حكمة)\nمثال: رفع آمال الأطفال بإهمال",
 "ぽいぽい": "تمرير, رمي ((رياضة) فعل رمي الكرة لعضو آخر في فريقك) / رمي, هز (حركة مفاجئة) / رمي العملة, قرعة (فعل تقليب العملة)\nمثال: تم إهدار التمريرة",
 "ぽい捨て": "مِحَفَّة / بَعْثَرَ",
 "ぽおん": "تمرير, رمي ((رياضة) فعل رمي الكرة لعضو آخر في فريقك) / رمي, هز (حركة مفاجئة) / رمي العملة, قرعة (فعل تقليب العملة)\nمثال: تم إهدار التمريرة",
 "ぽか": "خطأ فادح, زلة (خطأ محرج)",
 "ぽかぽか": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "ぽかよけ": "ذَاتِيُّ الأَمَان (يزيل الخطر بالتعويض التلقائيّ عن أيّ عطل أو خلل) / مَأْمُون الفَشَل, مَضْمُون النَّتِيجَة (مضمون عدم فشله؛ آمن من الإخفاق) / آلية أمان ضد الفشل (آلية قادرة على العودة إلى حالة آمنة في حالة حدوث فشل أو عطل)",
 "ぽかり": "جَاحِظ العَيْنَيْن, فَاغِر الفَم (مفتوح العينين أو الفم من شدة الدهشة) / بذهول, بفراغ (بطريقة خالية من التعبير)\nمثال: كانت تحدق بذهول في الغرفة / فَاغِر الفَم, مَفْتُوح الفَم (مفتوح الفم على وسعه كما في حالة الدهشة أو الذهول)",
 "ぽかん": "بذهول, بفراغ (بطريقة خالية من التعبير)\nمثال: كانت تحدق بذهول في الغرفة / جَاحِظ العَيْنَيْن, فَاغِر الفَم (مفتوح العينين أو الفم من شدة الدهشة)",
 "ぽくぽく": "بإيقاع, بشكل إيقاعي (بطريقة إيقاعية)\nمثال: تأرجح الكرسي بشكل إيقاعي ذهاباً وإياباً / رِخْو, مُتَفَتِّت (يَسْهُلُ تَفَتُّتُهُ إِلَى قِطَعٍ صَغِيرَةٍ أَوْ تَحَوُّلُهُ إِلَى مَسْحُوق) / تجوال, تنزة (مشي متمهل (عادة في مكان عام)) / غفوة, نعاس (نوم خفيف متقطع)",
 "ぽくり": "قُبْقَاب, قَبْقَاب (الجمل الهدّار ذو الصوت العالي؛ الكذاب الكثير الكلام والكذب والهذر)",
 "ぽこちん": "قَضِيب, ذَكَر",
 "ぽこっと": "عَرِيض",
 "ぽこぽこ": "أَجْوَف / مُثَقَّب, مُسَامِيّ (يسمح بالمرور دخولاً وخروجاً) / هُنَا وَهُنَاكَ",
 "ぽご": "بُرْتُغَالِيّ / اَلْبُرْتُغَالِيَّة",
 "ぽしゃる": "أَخْفَقَ, فَشِلَ ((أَخْفَقَ): اضطرب وتحرك؛ (أَخْفَقَ)الطائر: ضرب بجناحيه.بجناحيه) / رَسَبَ (جعل مادة ما تترسب أو تنفصل عن سائل، خاصة في العمليات الكيميائية؛ أعلن فشل شخص في اختبار أو تقييم أكاديمي)\nمثال: برشاقة القط، قفز نحو الرف لكنه أخفق و سقط إلى الأرض.",
 "ぽそっと": "خَرِير, هَامِس (يُصدر صوتاً مستمراً منخفضاً غير واضح) / همس, وشوشة (التحدث بنعومة دون اهتزاز الحبال الصوتية) / حفيف, همس (ضجيج خفيف، مثل ضجيج الملابس الحريرية أو أوراق الشجر التي تهب عليها الرياح)",
 "ぽたぽた": "غارقاً في البلل, مبللاً تماماً (رطب للغاية) / تقاطر, خرير (صوت سقوط سائل قطرة بقطرة) / تقاطر, تنقيط (سائل (كالماء) يتدفق في قطرات (كما من طنف المنزل))\nمثال: مبلل تماماً",
 "ぽたり": "قَطَر (في الشرق الأوسط. وتعرف رسميا بدولة قطر)\nمثال: كنت أسكن في قطر. / فَجْأَةً",
 "ぽち": "أسيد, حمض (اسم دارج لثنائي إيثيل أميد حمض الليسرجيك) / نقطة (أقصر الإشارتين التلغرافيتين المستخدمتين في شفرة مورس) / وزارة النقل (الإدارة الفيدرالية الأمريكية التي تؤسس وتنسق برامج النقل الوطنية؛ أنشئت عام 1966) / نقطة (شكل دائري صغير جداً)\nمثال: صف من النقاط / طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة / قَلِيلًا",
 "ぽちっ": "وَاحِد, وَاحِدَة (في وَ: العدد واحد العدد الاول) / اَلْمَرْء\nمثال: رأيت واحدة مرة.",
 "ぽちぽち": "رش, طرطشة (فعل رش مادة (سائلة) على سطح) / تطاير, طرطشة (ضجيج شيء يتناثر أو يطرطش بشكل انفجاري)\nمثال: سمع طرطشة نيران / تَدْرِيجِيًّا, خُطْوَة بِخُطْوَة (شيء واحد في كل مرة؛ على مراحل صغيرة) / قَرِيبًا, سَرْعَانَ مَا / نَقْرَة / نَقَرَ",
 "ぽちゃ": "سمين",
 "ぽちゃぽちゃ": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / بَدِين بِلُطْف, مُمْتَلِئ (سَمِين بِمَا يَكْفِي لِيَكُون مُمْتَلِئًا بِشَكْلٍ مُحَبَّب)",
 "ぽちゃり": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "ぽちゃる": "اِزْدَادَ وَزْنًا, اِكْتَسَبَ وَزْنًا",
 "ぽっかぽか": "مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "ぽっかり": "باستخفاف, ببساطة (بلا مبالاة أو بدون اكتئاب) / باعتدال, بخفة (الانغماس باعتدال) / بشكل طفيف, خفيفاً (إلى درجة طفيفة) / بخفة, برفق (بقليل من الوزن أو القوة)\nمثال: أخذ الأمر باستخفاف / عَرِيض / فَجْأَةً",
 "ぽっきり": "لم يعد (ليس الآن) / ليس, ليس أكثر (إشارة إلى الدرجة التي توجد بها صفة معينة)\nمثال: لم تعد موجودة",
 "ぽっくり": "قُبْقَاب, قَبْقَاب (الجمل الهدّار ذو الصوت العالي؛ الكذاب الكثير الكلام والكذب والهذر) / فَجْأَةً",
 "ぽっくりびょう": "مَوْت الفَجْأَة (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "ぽっくり病": "مَوْت الفَجْأَة (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت .",
 "ぽっこり": "محدب, ناتئ (منحنٍ أو بارز إلى الخارج) / مُحَدَّب, مُنْتَفِخ (منحنٍ نحو الخارج؛ ذو شكل بصلي بارز)",
 "ぽっち": "بَخْس (بَخَسَ؛ بَخِسَ)\nمثال: بيع المنزل بثمن بخس. / فحل",
 "ぽっちり": "قَلِيلًا",
 "ぽっつり": "مَعْزُول, مُنْعَزِل (بَعِيدٌ وَمُنْفَصِلٌ مَادِّيًّا أَوِ اجْتِمَاعِيًّا) / شَارِد, مُنْعَزِل (غَيْرُ مُتَقَارِبٍ فِي الزَّمَن) / مَحْجُور, مَعْزُول (خاضع للعزل الإجباري لا سيما لأسباب صحية) / مُنْعَزِل, مُنْفَرِد (بعيد أو منفصل عن الآخرين؛ يشعر بالانفصال عنهم)",
 "ぽってり": "سمين",
 "ぽっと": "قَلِيلًا / فَجْأَةً / بِتَشَتُّت, بِشُرُود (بطريقة مشتتة)\nمثال: 'تفضل بالدخول'، قال بشرود",
 "ぽっとで": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "ぽっと出": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "ぽっぽ": "نخير, نفخ (فعل الزفير بقوة) / نفث الدخان (نفخ دخان التبغ في الهواء)\nمثال: لقد ملأوا الغرفة بالدخان بنفثهم المستمر / بشكل حار جداً, بغلليان ((تستخدم للحرارة) للغاية) / بُخَارِيّ, مُتَصَاعِد البُخَار (مملوء بالبخار أو ينبعث منه رطوبة على شكل بخار أو ضباب)\nمثال: كان الطبق ساخناً جداً / تُوت تُوت / حَمَامَة / جِزْدَان, جُزْدَان",
 "ぽっぽと": "نخير, نفخ (فعل الزفير بقوة) / نفث الدخان (نفخ دخان التبغ في الهواء)\nمثال: لقد ملأوا الغرفة بالدخان بنفثهم المستمر / بشكل حار جداً, بغلليان ((تستخدم للحرارة) للغاية) / بُخَارِيّ, مُتَصَاعِد البُخَار (مملوء بالبخار أو ينبعث منه رطوبة على شكل بخار أو ضباب)\nمثال: كان الطبق ساخناً جداً",
 "ぽつ": "أسيد, حمض (اسم دارج لثنائي إيثيل أميد حمض الليسرجيك) / نقطة (أقصر الإشارتين التلغرافيتين المستخدمتين في شفرة مورس) / وزارة النقل (الإدارة الفيدرالية الأمريكية التي تؤسس وتنسق برامج النقل الوطنية؛ أنشئت عام 1966) / نقطة (شكل دائري صغير جداً)\nمثال: صف من النقاط",
 "ぽつねんと": "بانفراد, بعزلة\nمثال: يختار الناسك أن يعيش بعزلة",
 "ぽつぽつ": "أسيد, حمض (اسم دارج لثنائي إيثيل أميد حمض الليسرجيك) / نقطة (أقصر الإشارتين التلغرافيتين المستخدمتين في شفرة مورس) / وزارة النقل (الإدارة الفيدرالية الأمريكية التي تؤسس وتنسق برامج النقل الوطنية؛ أنشئت عام 1966) / نقطة (شكل دائري صغير جداً)\nمثال: صف من النقاط / تدريجياً, خطوة بخطوة (بطريقة تدريجية) / تدريجياً, شيئاً فشيئاً (جزءاً صغيراً في كل مرة)\nمثال: تحرك الثعبان تدريجياً نحو ضحيته / هُنَا وَهُنَاكَ / باستخفاف, ببساطة (بلا مبالاة أو بدون اكتئاب) / باعتدال, بخفة (الانغماس باعتدال) / بشكل طفيف, خفيفاً (إلى درجة طفيفة) / بخفة, برفق (بقليل من الوزن أو القوة)\nمثال: أخذ الأمر باستخفاف",
 "ぽつり": "مَعْزُول, مُنْعَزِل (بَعِيدٌ وَمُنْفَصِلٌ مَادِّيًّا أَوِ اجْتِمَاعِيًّا) / شَارِد, مُنْعَزِل (غَيْرُ مُتَقَارِبٍ فِي الزَّمَن) / مَحْجُور, مَعْزُول (خاضع للعزل الإجباري لا سيما لأسباب صحية) / مُنْعَزِل, مُنْفَرِد (بعيد أو منفصل عن الآخرين؛ يشعر بالانفصال عنهم)",
 "ぽつりぽつり": "بشكل متقطع, على فترات (بطريقة متقطعة)\nمثال: استجوبنا البارومتر بشكل متقطع",
 "ぽつん": "مَعْزُول, مُنْعَزِل (بَعِيدٌ وَمُنْفَصِلٌ مَادِّيًّا أَوِ اجْتِمَاعِيًّا) / شَارِد, مُنْعَزِل (غَيْرُ مُتَقَارِبٍ فِي الزَّمَن) / مَحْجُور, مَعْزُول (خاضع للعزل الإجباري لا سيما لأسباب صحية) / مُنْعَزِل, مُنْفَرِد (بعيد أو منفصل عن الآخرين؛ يشعر بالانفصال عنهم)",
 "ぽてぽて": "سمين / بِبُطْء",
 "ぽとぽと": "غارقاً في البلل, مبللاً تماماً (رطب للغاية) / تقاطر, خرير (صوت سقوط سائل قطرة بقطرة) / تقاطر, تنقيط (سائل (كالماء) يتدفق في قطرات (كما من طنف المنزل))\nمثال: مبلل تماماً",
 "ぽまいら": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "ぽまえら": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "ぽやしみ": "تُصْبِح عَلَى خَيْر, لَيْلَة سَعِيدَة",
 "ぽよぽよ": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت) / نَاعِم (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "ぽりぽり": "قضم, مضغ (قضمة كبيرة)\nمثال: حاول التحدث بين قضمات الشطيرة / خدش, كشط (ضجيج خشن ناتج عن الكشط)\nمثال: شتت انتباهها كشط أقواس الكمان",
 "ぽろっと": "سَاقِط, مُتَسَاقِط (يَنْزِلُ بِحُرِّيَّةٍ تَحْتَ تَأْثِيرِ الجَاذِبِيَّة) / تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة)\nمثال: دخل الفريق في حالة ركود / عَنْ غَيْرِ قَصْدٍ, بِدُونِ قَصْدٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "ぽろり": "سَاقِط, مُتَسَاقِط (يَنْزِلُ بِحُرِّيَّةٍ تَحْتَ تَأْثِيرِ الجَاذِبِيَّة) / تراجع, ركود (تدهور ملحوظ في الأداء أو الجودة)\nمثال: دخل الفريق في حالة ركود / عَنْ غَيْرِ قَصْدٍ, بِدُونِ قَصْدٍ (يُفِيدُ المُجَاوَزَة؛ يُفِيدُ الاستعلاء، عَلَى)\nمثال: سألتني عن عمري.",
 "ぽろろん": "إسقاط الكرة ((بيسبول) ضرب كرة البيسبول بحيث تسقط فجأة) / بصوت ارتطام, طشّ (بصوت ارتطام قصير ومجوف) / رنة, طنة (صوت رنين أجوف)\nمثال: سقطت الكرة بصوت ارتطام في زاوية الملعب",
 "ぽん": "بإتقان, تماماً (بشكل كامل أو متقن) / تربيت, نقر (لمسة خفيفة أو ضربة خفيفة) / فِي مَحَلِّه, مُوَافِق تَمَامًا (يلائم المناسبة أو الموقف تمام الملاءمة) / بَرَّاق, سَطْحِيّ (ذو معقولية سطحية فقط)\nمثال: حفظ الدرس عن ظهر قلب / بُوب, مُوسِيقَى شَعْبِيَّة",
 "ぽんこつ": "بَالٍ / أَخْرَق / صدم, ضرب (فعل ملامسة شيء لآخر)\nمثال: أدى الضرب المتكرر إلى ظهور كدمة كبيرة",
 "ぽんじり": "ذيل الطائر (ذيل الطائر المجهز للأكل)",
 "ぽんたろう": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "ぽんっと": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية) / بِشَكْل عَرَضِيّ, غَيْر مَنْهَجِيّ (ليس بشكل منهجي أو وفقاً لخطة)\nمثال: ألقى نظرة غير مبالية على العناوين / بسخاء (بطريقة كريمة)\nمثال: تبرع بسخاء لعدة جمعيات خيرية",
 "ぽんつく": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "ぽんと": "بِعَفَوِيَّة, بِلَا مُبَالَاة (بطريقة غير مبالية) / بِشَكْل عَرَضِيّ, غَيْر مَنْهَجِيّ (ليس بشكل منهجي أو وفقاً لخطة)\nمثال: ألقى نظرة غير مبالية على العناوين / بسخاء (بطريقة كريمة)\nمثال: تبرع بسخاء لعدة جمعيات خيرية",
 "ぽんびき": "مُخبر المراهنات (شخص يبيع النصائح حول المقامرة أو المضاربة (خاصة في سباق الخيل)) / دلال, سمسار (شخص يعلن للزبائن بطريقة وقحة بشكل خاص) / بائع تذاكر في السوق السوداء (شخص يشتري تذاكر لحدث ما لإعادة بيعها بربح) / قَوَّاد, عرص / قَادَ, قَوَّدَ",
 "ぽんぴき": "مُخبر المراهنات (شخص يبيع النصائح حول المقامرة أو المضاربة (خاصة في سباق الخيل)) / دلال, سمسار (شخص يعلن للزبائن بطريقة وقحة بشكل خاص) / بائع تذاكر في السوق السوداء (شخص يشتري تذاكر لحدث ما لإعادة بيعها بربح) / قَوَّاد, عرص / قَادَ, قَوَّدَ",
 "ぽんぺ": "ألم المعدة, مغص (وجع موضعي في المعدة أو منطقة البطن)",
 "ぽんぺい": "ألم المعدة, مغص (وجع موضعي في المعدة أو منطقة البطن)",
 "ぽんぽこ": "مُمْتَلِئ, مَلِيء / شِبَع, شبعان",
 "ぽんぽん": "بومبون (سمكة غذائية رمادية داكنة توجد من لويزيانا وفلوريدا جنوباً) / بوم بوم, كرة صوفية (زينة تتكون من كرة من خيوط الصوف أو الحرير؛ توضع عادة على القبعة) / معدة (عضو كيسي عضلي متضخم في القناة الهضمية؛ العضو الرئيسي للهضم) / كرش (مصطلحات عامية للكرش أو البطن البارز) / بلا تحفظ, تماماً (بدون تحفظ)\nمثال: أستطيع أن أوصي بهذا المطعم بلا تحفظ! / وَاحِدًا تِلْوَ الآخَرِ",
 "ぽんぽんぺいん": "ألم المعدة, مغص (وجع موضعي في المعدة أو منطقة البطن)",
 "ぽんぽんペイン": "ألم المعدة, مغص (وجع موضعي في المعدة أو منطقة البطن)",
 "ぽん太郎": "أَحْمَق, غَبِيّ (مُغَفَّل، أَبْلَه، طَائِش)\nمثال: قبلني ايها الأحمق.",
 "ぽん引き": "مُخبر المراهنات (شخص يبيع النصائح حول المقامرة أو المضاربة (خاصة في سباق الخيل)) / دلال, سمسار (شخص يعلن للزبائن بطريقة وقحة بشكل خاص) / بائع تذاكر في السوق السوداء (شخص يشتري تذاكر لحدث ما لإعادة بيعها بربح) / قَوَّاد, عرص / قَادَ, قَوَّدَ",
 "ぽーん": "تمرير, رمي ((رياضة) فعل رمي الكرة لعضو آخر في فريقك) / رمي, هز (حركة مفاجئة) / رمي العملة, قرعة (فعل تقليب العملة)\nمثال: تم إهدار التمريرة",
 "ま": "عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل / بشكل محتمل, بشكل مقبول (بطريقة مقبولة (ولكن ليست متميزة))\nمثال: تلعب التنس بشكل مقبول / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب. / فَرَاغ, مَكَان / فَضَاء (فَضَاء) / مَسَافَة\nمثال: الفضاء مليئ بالغموض. / فَضاء (فَضَاء) / غُرْفَة, حُجْرَة (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الفضاء مليئ بالغموض. / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل / صَافٍ, اَلصَّافِي / حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة. / شَيْطَان, شيطان ((في الأديان الإبراهيمية) الرُّوح الشِّرِّير الَّذِي يَرْمِي بِكَ لِلتَّهْلُكَةِ لِبُعْدِهِ عَنِ الْخَيْرِ وَطَرِيقِ الْحَقِّ؛ (استعمال مجازي) كُلّ وَلَدٍ مُشَاكِسٍ أَوْ مُتَمَرِّدٍ)\nمثال: العجلة من الشيطان. / الْأَلَدُّ الْخَصِم / مَهْوُوْس / رَهِيب, مَهُول (يسبب الخوف أو الرعب أو الهلع)",
 "まぁ": "عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل / بشكل محتمل, بشكل مقبول (بطريقة مقبولة (ولكن ليست متميزة))\nمثال: تلعب التنس بشكل مقبول",
 "まあ": "عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل / بشكل محتمل, بشكل مقبول (بطريقة مقبولة (ولكن ليست متميزة))\nمثال: تلعب التنس بشكل مقبول",
 "まあい": "تَوَقَّفَ / تَوَقُّف, وَقْف / بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "まあか": "قرمزي, ياقوتي (لون أحمر عميق وزاهٍ)",
 "まあじゃん": "مَا جُونْغ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "まあまあ": "بَيْنَ بَيْنَ (ظرف مكان بمعنى وَسْط) / نِصْف نِصْف, نُصّ نُصّ\nمثال: مصيري بين يديك.",
 "まあるい": "مُسْتَدِير, مُدَوَّر (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / مُسْتَدِير, كُرَوِيّ (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما) / جَوْلَة, مَرْحَلَة / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "まい": "كُلّ / رقص (القيام بسلسلة من الخطوات (والحركات) الإيقاعية المتناغمة مع الموسيقى) / لَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة. / مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "まいあがる": "تحليق لأعلى, صعود سريع (فعل الارتفاع لأعلى في الهواء)",
 "まいう": "لَذِيذ / شَهِيّ",
 "まいうど": "رَاقِص, رَاقِصَة",
 "まいうー": "لَذِيذ / شَهِيّ",
 "まいおどる": "رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / شطيح / رَقَصَ, رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "まいかい": "كُلَّمَا",
 "まいかぜ": "زَوْبَعَة",
 "まいきゃく": "دَفْن, تَدْفِين (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته.",
 "まいきょ": "إحصاء, عد (فعل العد؛ تلاوة الأرقام بترتيب تصاعدي) / ترقيم, قائمة مرقمة (قائمة مرقمة)\nمثال: استمر العد لعدة ساعات",
 "まいくん": "أخت (الأُخْت : المرأة التي تشترك معك في الأب أو الأم؛ الأُخْت  لقب يطلقه الشخص على امرأة لا يعرفها تأدبا وإن كانت غريبة عنه)\nمثال: ماري هي أخت توم",
 "まいげつ": "شَهْرِيّ / شَهْرِيًّا",
 "まいごになる": "اُغْرُب عَن وَجْهِي!, إِبْتَعِد عَنِّي! / ضَلَّ الطَّرِيق",
 "まいしゅう": "أسبوعياً, كل أسبوع (دون تفويت أسبوع)\nمثال: زارت عمتها أسبوعياً",
 "まいしん": "سعي, كفاح (محاولة جاهدة لتحقيق هدف)",
 "まいじ": "بالساعة, كل ساعة (كل ساعة؛ حسب الساعة) / سَاعِيّ (يحدث كل ساعة أو يُدفع بالساعة)\nمثال: يومياً، بل كل ساعة، كنت أزداد قوة / كُلَّمَا",
 "まいす": "كَذَّاب, كَذَّابَة",
 "まいせつ": "دفن (إخفاء شيء تحت الأرض)",
 "まいそう": "دَفْن, تَدْفِين (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه)\nمثال: دفن القط فضلاته. / فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "まいそうち": "جبانة, مدفن (قطعة أرض تستخدم للدفن)",
 "まいぞうぶつ": "كنز مكتشف (أي مجموعة من الأشياء الثمينة التي يتم اكتشافها) / كنز دفين (كنز مجهول المالك وجد مخبأ (عادة في الأرض))\nمثال: كان كتابها كنزاً من الأفكار الجديدة",
 "まいぞうりょう": "وَدِيعَة / أَوْدَعَ (الثَوْب أو ما أشبه: صانه بأن وضعه في صِوَان أو مكان لا يؤْذَى فيه؛ فلانًا مالًا: دفعه إليه ليكون عنده وديعة. ويكون أيضا بمعنى قبل الوديعة)\nمثال: غادرت المنزل دون أن أودع أهلي.",
 "まいたけ": "دجاجة الغابة, فطر دجاجة الغابة (فطر كبير صالح للأكل بني رمادي يشكل كتلة من القبعات المتداخلة تشبه الدجاجة إلى حد ما عند قاعدة الأشجار)",
 "まいたつ": "تحليق لأعلى, صعود سريع (فعل الارتفاع لأعلى في الهواء)",
 "まいたん": "فَجْر (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / فَجْر, فَلَق (هو آخر اللَيْل أو أول النَهَار حين تنصدع الظُلْمَة من النُور) / شُرُوق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس) / شُرُوق, مَشْرِق (البُزُوغ، الطُلُوع؛ الوَقْت الذي تَشْرُق فيه الشَمْس)\nمثال: فجر توم البالونة.",
 "まいちもんじ": "خط مستقيم (خط ترسمه نقطة تتحرك في اتجاه ثابت؛ خط انحناؤه صفر)\nمثال: أقصر مسافة بين نقطتين هي خط مستقيم",
 "まいった": "مَلْمُوس",
 "まいつき": "شَهْرِيّ / شَهْرِيًّا",
 "まいづるそう": "أكتيا حمراء, توت سام أحمر (عشب معمر في أمريكا الشمالية بأوراق مركبة وعناقيد من الزهور البيضاء الصغيرة تليها ثمار لبية بيضاوية حمراء زاهية وسامة)",
 "まいて": "رَاقِص, رَاقِصَة",
 "まいとし": "سنوياً, كل سنة (دون تفويت سنة)\nمثال: يسافرون إلى الصين سنوياً",
 "まいど": "كُلَّمَا / شُكْرًا, تِسْلَم\nمثال: 毎度、またいらっしゃい。 — شكراً ، من فضلك أعد الزيارة. / آلُو, آلُوْ / هَل مِن أَحَدٍ هُنَا؟",
 "まいどあり": "شُكْرًا, تِسْلَم",
 "まいどありがとうございます": "شُكْرًا, تِسْلَم",
 "まいどおなじみ": "عَادِيّ",
 "まいどのごとく": "كَالْعَادَة, كَالْمُعْتَاد",
 "まいどまいど": "على مدار الوقت (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / شُكْرًا, تِسْلَم",
 "まいない": "رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا. / قُرْبَان",
 "まいに": "بِالرَغْم مِن",
 "まいにち": "يَوْمِيّ / يَوْمِيًّا, كُلَّ يَوْمٍ",
 "まいにちまいにち": "يَوْمًا بَعْدَ يَوْم",
 "まいにん": "رَاقِص, رَاقِصَة",
 "まいねん": "سنوياً, كل سنة (دون تفويت سنة)\nمثال: يسافرون إلى الصين سنوياً",
 "まいはぎ": "نبات التلغراف, نبات الراقص (شجيرة آسيوية استوائية منتصبة تدور وريقاتها الجانبية الصغيرة على محاورها وتهتز صعوداً وهبوطاً تحت تأثير أشعة الشمس)",
 "まいはだ": "جلفطة, مادة سد الشقوق (حشو ومانع تسرب مقاوم للماء يستخدم في البناء والإصلاح لجعله غير منفذ للماء)",
 "まいばん": "كل ليلة, ليلياً (في نهاية كل يوم)\nمثال: تتفقد ورودها ليلياً",
 "まいひめ": "راقصة باليه (أنثى ترقص الباليه)",
 "まいびと": "رَاقِص, رَاقِصَة",
 "まいふく": "ارتطام, اصطدام (اصطدام حاد ناتج عن الضرب أو الاندفاع ضد شيء ما) / انحشار السن, سن منطمر (اضطراب يكون فيه السن مزدحماً جداً في تجويفه بحيث لا يمكنه البزوغ بشكل طبيعي) / انحشار البراز (اضطراب ينحشر فيه البراز في القولون السفلي) / انحشار, انضغاط (حالة الانضغاط والالتصاق الوثيق والثبات بقوة)",
 "まいふくし": "انحشار السن, سن منطمر (اضطراب يكون فيه السن مزدحماً جداً في تجويفه بحيث لا يمكنه البزوغ بشكل طبيعي)",
 "まいぺんらい": "عَفْوًا, الْعَفْو",
 "まいぼつげんか": "تَكْلِفَة غارِقَة",
 "まいぼつひよう": "تَكْلِفَة غارِقَة",
 "まいぼつもう": "شعر غائر (شعرة لا تخرج من الجريب ولكنها تظل مغروسة في الجلد (مما يسبب عادة التهاباً))",
 "まいまい": "غالباً, كثيراً (مرات عديدة على فترات قصيرة)\nمثال: غالباً ما التقينا لتناول فنجان من القهوة / حَلَزُون",
 "まいまいが": "عثة الغجر (عثة أوروبية أُدخلت إلى أمريكا الشمالية؛ آفة خطيرة لأشجار الظل)",
 "まいまいつぶり": "حَلَزُون",
 "まいまいつぶろ": "حَلَزُون",
 "まいもどる": "عَادَ, رَجَعَ (رَجَعَ)\nمثال: هل عاد توم حقا؟",
 "まいや": "كل ليلة, ليلياً (في نهاية كل يوم)\nمثال: تتفقد ورودها ليلياً",
 "まいゆ": "لَذِيذ / شَهِيّ / مَاهِر, حَاذِق / سَعِيد, وَرْدِيّ (ينبئ بحظ جيد وطالع حسن) / ذَهَبِيّ, مَحْظُوظ (محظوظ بدرجة عُليا ومُفضَّل) / محظوظ (يتمتع بحظ جيد غير متوقع)\nمثال: أطفال آخرون، أقل حظاً، ماتوا",
 "まいゆう": "لَذِيذ / شَهِيّ / مَاهِر, حَاذِق / سَعِيد, وَرْدِيّ (ينبئ بحظ جيد وطالع حسن) / ذَهَبِيّ, مَحْظُوظ (محظوظ بدرجة عُليا ومُفضَّل) / محظوظ (يتمتع بحظ جيد غير متوقع)\nمثال: أطفال آخرون، أقل حظاً، ماتوا",
 "まいよ": "كل ليلة, ليلياً (في نهاية كل يوم)\nمثال: تتفقد ورودها ليلياً",
 "まいらす": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "まいらせる": "نَبْض / ضَرَبَ, دَقَّ (معروف، وهو اللطم أو الدق أو الصكّ و ما أشبه؛ النَوْع أو الصنف أو المثال) / وَجَفَ / هَزَمَ, غَلَبَ / خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل)\nمثال: ضرب سامي زوجته.",
 "まいり": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "まいる": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان. / فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته. / زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا. / أَذْعَنَ ((أَذْعَنَ): انْقَادَ وسلس وَيُقَال: أذعن بِالْحَقِّ: أقرّ بِهِ)",
 "まいるか": "قَصِير المِنْقَار (ذو منقار قصير)",
 "まいをまう": "رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / شطيح / رَقَصَ, رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "まう": "رَقْص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية) / شطيح / رَقَصَ, رقص (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص. / برم, دوران سريع (عملية الدوران بسرعة) / تجربة, محاولة سريعة (محاولة عادة ما تكون قصيرة) / جلبة, دوامة (حركة مضطربة) / تلفيف, دوامة (شكل شيء يدور بسرعة)\nمثال: أدار الكرنك بقوة",
 "まうと": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "まえ": "أماماً, في المقدمة (في أو في المقدمة)\nمثال: أرى أضواء مدينة أمامنا / قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قَبْلَ, أَمَامَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل. / جَبْهَة / أَمَامِيّ / صَاعِدًا / مُهَاجِم\nمثال: まっすぐ前を見てください。 — انظر امامك مباشره.",
 "まえあし": "قدم أمامية (قدم أمامية لذوات الأربع)",
 "まえいた": "لَوْحَةُ التَّعْلِيمَات",
 "まえうで": "سَاعِد (عَاوَنَ، أَعَانَ)\nمثال: ساعد زيري ريمة.",
 "まえうり": "حَجْز (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "まえおき": "مُقَدِّمَة",
 "まえかいけい": "دفع مسبق (الدفع مقدماً)",
 "まえかがみ": "انحناء, ترهل (انحناء القامة عند الوقوف والمشي) / شخص غير كفء, متكاسل (شخص غير كفء؛ تستخدم عادة في صيغ النفي)\nمثال: إنه ليس متكاسلاً عندما يتعلق الأمر بالبيسبول",
 "まえかがみになる": "انحناء, ترهل (انحناء القامة عند الوقوف والمشي) / شخص غير كفء, متكاسل (شخص غير كفء؛ تستخدم عادة في صيغ النفي)\nمثال: إنه ليس متكاسلاً عندما يتعلق الأمر بالبيسبول",
 "まえかけ": "مِرْيَلَة, مِئْزَر",
 "まえかた": "قَبْلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / قَبْلَ, أَمَامَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل. / جَبْهَة / أَمَامِيّ / غير مكسو بالريش, غير ناضج ((عن الطيور) لم تطور ريشاً بعد) / غير ناضج (لم ينضج بعد) / طفولي, غير ناضج (من سمات الافتقار إلى النضج) / غير ناضج, فج (غير مكتمل النمو أو النضج؛ غير يانع)\nمثال: عصفور صغير غير مكسو بالريش على حافة النافذة",
 "まえかぶ": "اسم الشركة (الاسم الذي تُعرف به الشركة)",
 "まえかれ": "حبيب سابق (رجل لم يعد حبيباً لامرأة ما)",
 "まえがき": "مُقَدِّمَة",
 "まえがし": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "まえがみ": "نَاصِيَة (خصلة من شعر عرف الحصان تنمو للأمام بين الأذنين) / خُصْلَة أَمَامِيَّة, نَاصِيَة (خصلة شعر تنمو (أو تتدلى) فوق الجبهة)",
 "まえがわ": "أَمَامِيّ",
 "まえきん": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "まえげいき": "توقع, احتمال / تَنْقِيْب (نقّب إذا سار في البلاد طلباً للمهرب ، نقّب عن الأخبار وغيرها:بحث عنها،هو البحث عن كلّ شيء والتّفتيش مطلقاً؛ نقّب مبالغة في نَقَب ، نقّب عن الشيء :فحص عنه فحصاً بليغاً)",
 "まえこぐち": "الحافة الأمامية (جزء الكتاب الذي يواجه الداخل عند وضع الكتاب على الرف؛ الجزء المقابل للكعب)",
 "まえして": "بَطَل, بَطَلَة / مُتَصَدِّر",
 "まえしょり": "تَحْضِير, إِعْدَاد",
 "まえじて": "بَطَل, بَطَلَة / مُتَصَدِّر",
 "まえじらせ": "فَأل, نَذِيْر",
 "まえせつ": "إحماء, تحضير (ممارسة التمارين استعداداً لنشاط شاق) / برولوج, فاتحة مسرحية (مقدمة لمسرحية)",
 "まえぞなえ": "طَلِيعَة",
 "まえたて": "فتحة الثوب (قطعة قماش مخيطة تحت فتحة)",
 "まえだおし": "تَسَارُع (عَجَلَة، تزايُد السرعة بالنسبة إلى الزمن في جسم من الأَجسام المتحرِّكة؛ إِسْرَاعٍ وَتَسَابُقٍ فِي الجَرْيِ)\nمثال: تسارع السائق بسيارته.",
 "まえだて": "عرف (نمو لافت للنظر من الريش أو الجلد على رأس طائر أو حيوان آخر) / عرف الخوذة ((شعارات النبالة) في العصور الوسطى، شعار يستخدم لتزيين الخوذة) / تحدب الطريق, ظهر الطريق (منتصف طريق محدب) / ذروة, قمة (الخط العلوي لتل أو جبل أو موجة) / تمثال مقدمة السفينة (تمثال على مقدمة بعض السفن الشراعية) / واجهة (شخص يستخدم كغطاء لنشاط مشكوك فيه)",
 "まえだれ": "مِرْيَلَة, مِئْزَر",
 "まえだんかい": "حركة افتتاحية, خطوة أولى (الأولى في سلسلة من الإجراءات)",
 "まえづけ": "المواد التمهيدية, مقدمات الكتاب (مادة مكتوبة تسبق المتن الرئيسي لكتاب)",
 "まえとびら": "باب أمامي, مدخل أمامي (باب خارجي (عند المدخل) في واجهة المبنى) / العنوان الموجز (صفحة أولى في بعض الكتب تعرض فقط عنوان الكتاب)",
 "まえにわ": "حديقة أمامية, فناء أمامي (الفناء الموجود أمام المنزل؛ بين المنزل والشارع)",
 "まえのめり": "وِقَائِيّ, استباق الْأَحْدَاث / مُتَسَرِّع",
 "まえはま": "شاطئ أمامي (جزء الشاطئ الواقع بين علامة المد العالي وعلامة الجزر المنخفض)",
 "まえば": "سن أمامية (سن تقع في مقدمة الفم)\nمثال: كان سوء الإطباق لديه بسبب الأسنان الأمامية الموضوعة بشكل خاطئ",
 "まえばし": "مَايْبَاشِي",
 "まえばらい": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "まえばらいきん": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "まえび": "حَوَّاء / حَوَّاء, أِيف",
 "まえびろ": "سَابِق",
 "まえふり": "مُقَدِّمَة",
 "まえぶれ": "بَشِير, مُبَشِّر",
 "まえまえから": "دَائِمًا, أَبَدًا",
 "まえみごろ": "جَبْهَة / أَمَامِيّ",
 "まえむき": "حَدَاثِيّ, مُبْتَكِر (سابق لعصره ومتطوّر)",
 "まえもって": "سلفاً, مسبقاً (قبل الوقت؛ تحسباً)\nمثال: عندما تدفع مقدماً تحصل على خصم",
 "まえわたし": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "まえわたしきん": "دَفْع مُسْبَق (لزّه ونحاه وأبعده؛ صرفه قبل وروده، أي منعه وأبعده قبل مجيئه أو حدوثه، وعكسه أن يرفعه، اي أن يصرفه بعد حدوثه)\nمثال: دفع زيري الثمن.",
 "まえをしつれいします": "عَفْوًا!, مَاذَا قُلْتَ؟",
 "まえカレ": "حبيب سابق (رجل لم يعد حبيباً لامرأة ما)",
 "まえピン": "بؤرة, تركيز (تركيز الانتباه أو الطاقة على شيء ما) / بؤرة, نقطة التجمع (نقطة التقاء الضوء (أو أي إشعاع آخر) أو النقطة التي ينبعث منها) / بؤرة, بؤرة الإصابة (نقطة مركزية أو موضع العدوى في كائن حي)\nمثال: تحول محور النشاط إلى البيولوجيا الجزيئية",
 "まお": "قُنَّبُ سِيَام",
 "まおう": "الشَّيْطَان, إِبْلِيس / إيفيدرا صينية, ماهوانغ (إيفيدرا صينية تنتج الإيفيدرين)",
 "まおとこ": "تحايل, غش (خداع من أجل الربح الشخصي) / خَلِيل, خَلِيلَة",
 "まか": "عَظَمَة, كِبَر",
 "まかじき": "مارلين مخطط (سمكة طعام وصيد في المحيط الهادئ معلمة بخطوط عمودية زرقاء داكنة)",
 "まかす": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا. / غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة",
 "まかせる": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "まかつきゅう": "بُرْج اَلْجَدْي (ظهر وارتفع) / اَلْجَدْي\nمثال: وصل كارل إلى برج آخر.",
 "まかない": "ركوب, صعود (فعل صعود الركاب والطاقم على متن سفينة أو طائرة) / ألواح خشبية, كسوة خشبية (هيكل من الألواح) / لَوْحَة, خَشَبَة / لَوْحَة, لَوْح / مَجْلِس, لَجْنَة / اِسْتَقَلَّ, صَعِدَ / طَبَّاخ, طَبَّاخَة (من طَبَخَ، بمعنى اسم الفاعل الطَابِخ؛ من طَبَخَ، بمعنى الكثير الطَبْخ) / طَبَخَ, طيب (أَنْضَجَ الطعام بتسخينه) / طاب (حَسُنَ واصبح طَيِّب؛ نفسُه: ارتاحت ورضيت واطمأنت)\nمثال: زوجي طباخ ماهر.",
 "まかないかた": "طَاهٍ, طَاهِي",
 "まかなう": "زَوَّدَ (زَوَّدَ (زوده): أزاده. ويقال زودته كتابا إلى فلان؛ زَوَّدَ(هـ) بكذا: أمده به) / تَوْرِيد, تَزْوِيد / ذَخِيرَة",
 "まかみ": "ذِئْب (حيوان مفترس من فصيلة الكلاب يعيش في جماعات وأكثر ما يصطاد في الليل؛ صفة تطلق على الرجل الذي يخدع النساء ليحصل على مراده منهن بالدهاء) / ديب / ذيب / اِلْتَهَمَ بِشَرَاهَة\nمثال: نظرة الذئب للشاة.",
 "まかりこす": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "まかりでる": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "まかりまちがう": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "まかりまちがっても": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "まかり出る": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / تَرَكَ, غَادَرَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض) / إِجَازَة, عُطْلَة\nمثال: لقد ترك لك هذا.",
 "まかり越す": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "まかり間違う": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ.",
 "まかり間違っても": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "まが": "شر, فجور (سلوك مرفوض أخلاقياً) / بَشَاعَة, خِسَّة (صفة كون الشيء مقرفاً للحواس أو المشاعر) / إثم, خطيئة (الابتعاد عن الله) / خباثة, دناءة (صفة الشر والفساد الأخلاقي)\nمثال: فاجأتنا بشاعة لغته",
 "まがい": "تَقْلِيد / بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "まがいい": "مَحْظُوظ, جَالِب للحَظّ",
 "まがいもない": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "まがいもの": "تَقْلِيد",
 "まがい物": "تَقْلِيد",
 "まがうかたなき": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "まがうかたなく": "بلا شك, من دون شك (بدون شك؛ بالتأكيد)\nمثال: إنه بلا شك جميل جداً",
 "まがうことなき": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "まがえる": "قَلَّدَ",
 "まがお": "وجه جاد (تعبير وجهي جاد لا يعطي أي دليل على الاهتمام أو التسلية)",
 "まがこと": "حادث مؤسف, نحس (حالة من سوء الحظ) / سوء حظ, نحس (نتيجة غير متوقعة ومؤسفة)\nمثال: لو لم يكن لدي سوء حظ، لما كان لدي أي حظ على الإطلاق / سَيِّئُ الطَّالِع, مَنْحُوس (يَتَّسِمُ بِسُوءِ الحَظِّ أَوْ يُنْذِرُ بِهِ)",
 "まがごと": "حادث مؤسف, نحس (حالة من سوء الحظ) / سوء حظ, نحس (نتيجة غير متوقعة ومؤسفة)\nمثال: لو لم يكن لدي سوء حظ، لما كان لدي أي حظ على الإطلاق / سَيِّئُ الطَّالِع, مَنْحُوس (يَتَّسِمُ بِسُوءِ الحَظِّ أَوْ يُنْذِرُ بِهِ)",
 "まがった": "مُجَعَّد, مُنْبَعِج (عن المعدن مثلاً؛ مُحنٍ أو مُنبعِج) / مُقَوَّس, مُنْحَنٍ (يُوصَف للظهر والرُّكبتين؛ في وضع انحناء) / عَاقِدُ الْعَزْمِ, مُصَمِّمٌ عَلَى (ثابت في هدفه وعزمه) / براعة, مهارة خاصة (طريقة خاصة أو مهارة فطرية للقيام بشيء ما)\nمثال: كان لديه ميل لذلك / عَلَى نَحْو خَاطِئ, مُنْحَرِفًا (بعيداً عن المسار الصحيح أو المتوقع) / مَائِلًا, مُنْحَرِفًا (مقلوب أو ملتو إلى جانب واحد)\nمثال: شيء ما انحرف في خططنا",
 "まがまがしい": "مَشْؤُوم, نَذِير شُؤْم (ينذر بسوء الحظ والطالع) / مُتَوَعِّد, مُنْذِر بِالشَّرّ (يهدد أو ينذر بتطورات شريرة أو مأساوية) / مُزْعِج / قابل للتصديق, معقول (يبدو معقولاً وموثوقاً، وبالتالي مقنعاً) / مَعْسُول الكَلَام, مُقْنِع زَيْفًا (يَتَّسِم بِتَقْدِيم حُجَج خَادِعَة تَبْدُو مَقْبُولَة)\nمثال: عذر وجيه",
 "まがみ": "ذِئْب (حيوان مفترس من فصيلة الكلاب يعيش في جماعات وأكثر ما يصطاد في الليل؛ صفة تطلق على الرجل الذي يخدع النساء ليحصل على مراده منهن بالدهاء) / ديب / ذيب / اِلْتَهَمَ بِشَرَاهَة\nمثال: نظرة الذئب للشاة.",
 "まがも": "بركة, بط بري (بط بري مخوض ينحدر منه البط المنزلي؛ واسع الانتشار)",
 "まがよい": "مَحْظُوظ, جَالِب للحَظّ",
 "まがり": "انحناء",
 "まがりかど": "زَاوِيَة, رُكْن / نقطة تحوّل (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "まがりがね": "زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية)",
 "まがりくねる": "بشكل متعرج (في مسار متعرج أو على طريق متعرج) / زِيكْزَاكِيّ, مُتَعَرِّج (ذو منعطفات حادة وقصيرة أو زوايا متتالية) / زجزاج, متعرج (شكل زاوي يتميز بمنعطفات حادة في اتجاهات متبادلة)\nمثال: طارت الطيور بشكل متعرج عبر السماء الزرقاء",
 "まがりじゃく": "زاوية النجار (زاوية فولاذية يستخدمها النجارون؛ أكبر من الزاوية القائمة العادية)",
 "まがりなりにも": "بشكل ما, بطريقة أو بأخرى (بطريقة أو أسلوب غير محدد؛ أو بوسيلة غير محددة) / بطريقة ما, لسبب ما (لسبب غير محدد)\nمثال: لقد تدبروا الأمر بطريقة ما",
 "まがりにん": "مُسْتَأجِر",
 "まがりめ": "زَاوِيَة, رُكْن",
 "まがりや": "مرهن",
 "まがる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار.",
 "まがわるい": "غَيْر مُرْتَاح, مُرْتَبِك (يشعر بعدم الارتياح الاجتماعي؛ غير واثق ومتحفظ) / غَيْرُ مُنَاسِب, مُحْرِج (يُسَبِّبُ الإِزْعَاجَ أَوْ عَدَمَ الارْتِيَاح) / حَرِج, مُحْرِج (صَعْب التَّعَامُل مَعَهُ؛ يُسَبِّب أَلَمًا أَوْ إِحْرَاجًا) / ثَقِيل الأُسْلُوب, رَكِيك (يَفْتَقِر إِلَى الأَنَاقَة أَوِ الرَّشَاقَة فِي التَّعْبِير) / غير ملائم, مزدحم (غير مناسب لراحتك أو غرضك أو احتياجاتك) / غَيْر مُرِيح, غَيْر مُلَائِم (ذو توقيت غير مريح أو مناسب)\nمثال: من غير الملائم عدم وجود هاتف في المطبخ",
 "まがん": "عَيْن اَلْحَسُود, عين حارّة (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: كان عين ليلى مسودة.",
 "まき": "دَحْرَجَ, تَدَحْرَجَ / ثَنَى, لَفَّ (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً / حَجْم (حجّم الشّيء:وضع حجماً محدّداً له ، قَلَّلَ دوره وهَمَّشَه، قلّل تأثيره؛ حجّم: نَظَرَ نظراً شديداً،ويُقال حجّم إليه) / جَهَارَة / مُجَلَّد, جُزْء\nمثال: ما حجم البالون؟ / عَقِب, كَعْب / كَعْب / مَرْعًى, مَسْرَح",
 "まきあげ": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رفع (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / شال (قطعة مربعة كبيرة من القماش الصوفي يستخدمه الرجال كغطاء للرأس يكون عادة غير منقوش ولا مطرز؛ قطعة مستطيلة أو ممثلثة من القماش سواء كان خفيفا أم سميكا من الصوف أو القطن أو الحرير يكون عادة مطرز أو مشغول تضعه النساء على أكتافها) / مِصْعَد, أَصَنْصِير\nمثال: رفع سامي نظارته.",
 "まきあげる": "رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ) / رَافِعَة\nمثال: رفع سامي نظارته.",
 "まきえ": "طعم قاعي (طعم ينثر على الماء لجذب الأسماك)",
 "まきおこす": "خَلَقَ (أَنْشَأَ، أَوْجَدَ)\nمثال: زيري سيء الخلق. / رَفَعَ (أَعْلَى، عَلَّى؛ حَمَلَ، أَقَلَّ)\nمثال: رفع سامي نظارته.",
 "まきおこる": "نَهَضَ (قَامَ)\nمثال: نهض توم على قدميه.",
 "まきかえし": "تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب. / تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "まきかえす": "تَجَمُّع, مُظَاهَرَة (صيغة مطاوعة من جَمَّعَ، جَمَّعته فتجمّع؛ جُمِّعَ لوحده بدون أن يُجَمِّعه أحد)\nمثال: هي تجمع الحواسيب.",
 "まきがい": "حَلَزُون",
 "まきがり": "اِصْطَادَ, صَادَ / صَيْد, مُطارَدَة",
 "まききゃはん": "لفافة ساق (شريط من القماش يلف حول الساق لتشكيل غطاء للساق؛ استخدمه الجنود في الحرب العالمية الأولى)",
 "まきくせ": "جَعْدَة",
 "まきぐも": "ذُؤَابَة / طَخَاء",
 "まきげ": "جَعْدَة",
 "まきごや": "سقيفة الحطب (سقيفة لتخزين حطب الوقود أو أدوات الحديقة)",
 "まきざっぽ": "مسكن عسكري (سكن للأفراد العسكريين (خاصة في منزل خاص)) / رسالة قصيرة, ملاحظة (رسالة شخصية قصيرة)\nمثال: اكتب لي رسالة قصيرة عندما تصل هناك",
 "まきざっぽう": "مسكن عسكري (سكن للأفراد العسكريين (خاصة في منزل خاص)) / رسالة قصيرة, ملاحظة (رسالة شخصية قصيرة)\nمثال: اكتب لي رسالة قصيرة عندما تصل هناك",
 "まきじく": "طُومَار",
 "まきじゃく": "شَرْيِط قِيَاس",
 "まきせん": "تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "まきぞい": "اِنْخِرَاط, مُشَارَكَة (فعل المشاركة في أنشطة المجموعة) / انشغال, اهتمام (شعور بالاهتمام والفضول تجاه شخص أو شيء ما) / انْخِرَاط, تَوَرُّط (علاقة اشتمال أو احتواء) / انخراط, مشاركة (حالة المشاركة مع الآخرين (كزملاء أو شركاء وما إلى ذلك))\nمثال: حاول المعلم زيادة مشاركة طلابه في الأنشطة الصفية",
 "まきぞえ": "اِنْخِرَاط, مُشَارَكَة (فعل المشاركة في أنشطة المجموعة) / انشغال, اهتمام (شعور بالاهتمام والفضول تجاه شخص أو شيء ما) / انْخِرَاط, تَوَرُّط (علاقة اشتمال أو احتواء) / انخراط, مشاركة (حالة المشاركة مع الآخرين (كزملاء أو شركاء وما إلى ذلك))\nمثال: حاول المعلم زيادة مشاركة طلابه في الأنشطة الصفية",
 "まきぞえひがい": "أَضْرَار جَانِبِيَّة",
 "まきた": "الشَّمَال (نقطة البوصلة الأصلية التي تكون عند 0 أو 360 درجة)",
 "まきたて": "بِطَانَة",
 "まきちらす": "نَثَرَ, تَفَرَّقَ",
 "まきつけ": "خِنْزِيرَة / زَرَعَ, بَذَرَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت.",
 "まきつける": "خِنْزِيرَة / زَرَعَ, بَذَرَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت.",
 "まきづめ": "ظفر غائر, ظفر ناشب (ظفر قدم تكون طرفه الحر أو حوافه مغروسة في اللحم المحيط)",
 "まきとり": "تدوير, ملء (عملية التدوير أو اللف) / مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / مُتَعَرِّج, مُلْتَوٍ (يتميز بمنعطفات وانحناءات متكررة)\nمثال: وضع المفتاح في الساعة القديمة وأعطاها تدويراً جيداً",
 "まきとる": "رِيح, ريح / لَفَّ",
 "まきはだ": "جلفطة, مادة سد الشقوق (حشو ومانع تسرب مقاوم للماء يستخدم في البناء والإصلاح لجعله غير منفذ للماء)",
 "まきば": "مَزْرَعَة / مَرْعًى, مَسْرَح\nمثال: 牛が牧場で草を食べている。 — الأبقار يأكلون الأعشاب في البريّة.",
 "まきばたひばり": "جشنة المروج (جشنة شائعة بنية من الأعلى وبيضاء من الأسفل؛ واسعة الانتشار في شمال ووسط أوروبا وآسيا)",
 "まきばどり": "قبرة المروج (طيور مغردة من أمريكا الشمالية ذات صدر أصفر)",
 "まきひげ": "مِحْلَاق",
 "まきびし": "حَسَك ((حَسِكَ) الْمَكَان حسكا: كثر حسكه؛ (حَسِكَ) رَأسه: اشتدت جعودته)",
 "まきびと": "رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر.",
 "まきもの": "وِشَاح, لِفاع",
 "まきわり": "بلطة, فأس صغيرة (فأس صغيرة بمقبض قصير تستخدم بيد واحدة (عادة لقطع الحطب)) / توماهوك, فأس صغيرة (سلاح يتكون من فأس قتال؛ استخدمه هنود أمريكا الشمالية)",
 "まきゲートル": "لفافة ساق (شريط من القماش يلف حول الساق لتشكيل غطاء للساق؛ استخدمه الجنود في الحرب العالمية الأولى)",
 "まきストーブ": "يَعْمَل بِالحَطَب (يُشغَّل بحرق الخشب)",
 "まきタバコ": "سِيجَارَة (منتج مصنوع من أوراق التبغ، تلف أو تحشى بداخل غلاف ورقي على شكل أسطوانة لغرض التدخين)\nمثال: دخن زيري سيجارة.",
 "まき散らす": "نَثَرَ, تَفَرَّقَ",
 "まぎらす": "أَلْهَى / أَخْفَى",
 "まぎらせる": "أَلْهَى / أَخْفَى",
 "まぎらわしい": "مُرْبِك",
 "まぎらわす": "أَلْهَى / أَخْفَى",
 "まぎり": "سِكِّين, مُدْيَة (أَدَاةٌ حَادَةٌ تُسْتَخْدَمُ فِي تَقْطِيعِ مُخْتَلَفِ أَصْنَافِ الطَّعَامِ كَاللَّحْمِ وَالْخُضَرِ، وَلِذَبْحِ الْحَيَوَانَاتِ؛ أَدَاةٌ حَادَةٌ تُصْنَعُ غَالِباً مِنَ الْمَعْدِنِ، لِلدِّفَاعِ عَنِ النَّفْسِ وَاسْتِخْدَامِهَا أَثْنَاءَ الْقِتَالِ) / خَنْجَر, خنجر (السِكِّين الكبيرة لا تستخدم للطعام بل للحَرْب، وقيل هي السكين ذات الحدين) / نَصْل, شَفْرَة (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة الحادّة الجارحة)",
 "まぎる": "تغيير الوجهة (الإبحار في مسار متعرج) / تغيير الوجهة ((ملاحة) عملية تغيير وجهة الشراع) / حبل الشراع ((مصطلح بحري) حبل (أو سلسلة) ينظم الزاوية التي يتم ضبط الشراع بها بالنسبة للرياح) / سروج, عدة الخيل (تجهيزات للحصان)",
 "まぎれ": "اِلْتِبَاس / اِرْتِبَاك (ارتبك الأمر:اختلط عليه ، وفي الوحْل :نَشَبَ فيه وعَلِق ،وفي الأمر:وقع فيه ولم يكد يتخلّص منه؛ ارتبك في كلامه:إذا تَتَعْتَعَ، وارتبك الصّيد في الْحِبَالَة:اِضْطَرَب)\nمثال: لا داعي لارتباك. / لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "まぎれもない": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "まぎわ": "حافة الطريق, قارعة الطريق (حدود عشبية على طول الطريق) / حافة, شفا (الحد الذي يحدث أو يتغير بعده شيء ما) / صولجان, عصا سحرية (عصا احتفالية أو رمزية) / حافة, عتبة (منطقة تحدد حداً فاصلاً)\nمثال: على شفا البكاء / حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما) / حافة, طرف (الحد الخارجي لجسم أو منطقة أو سطح؛ مكان أبعد ما يكون عن مركز الشيء) / أَفْضَلِيَّة نِسْبِيَّة, تَفَوُّق بَسِيط (ميزة تنافسية طفيفة) / حدة (سمة الإلحاح في نبرة الصوت)\nمثال: قام بتدوير حواف الصندوق",
 "まく": "رِيح, ريح / لَفَّ / مُغَلَّف, لِفَافَة / غِلَاف / تَنُّورَة, جُوب / وَصْلَة / نَثَرَ, تَفَرَّقَ\nمثال: まいた種は刈らねばならない。 — من زرع حصد / وَزَّعَ (كَفَّ ومَنَعَ وحَبَسَ؛ به: أَغْرَى)\nمثال: وزع علينا الورق. / اِنْتَفَضَ / سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة أو منع أشعة الشمس) / عَمَل (فِعْل، صُنْع؛ وسيلة للكسب، مِهْنَة، حِرْفَة) / قَانُون (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / مَثَّلَ (الشَبَه؛ النَظِير) / تَصَرَّفَ\nمثال: المهم هو العمل. / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / عُلْبَة / حَالَات / دَعْوَى (إدِّعَاء؛ دُعَاء) / عُلَب\nمثال: سأرفع عليك قضية. / غِشَاء / خِنْزِيرَة / زَرَعَ, بَذَرَ (بَذَرَ الحَبَّ؛ أَنْبَتَ، نَمَّى)\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت. / رش, نثر (فعل رش أو طرطشة الماء) / رشراش, زخات خفيفة متفرقة (زخة خفيفة تسقط في بعض المواقع دون غيرها القريبة)",
 "まくあい": "فاصِل",
 "まくあき": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "まくあけ": "بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية: المبتدأ والمنتهى)\nمثال: هذه بداية جيدة.",
 "まくがあく": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "まくぎれ": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "まくこつ": "عظم غشائي (أي عظم ينمو داخل الأنسجة الغشائية دون تكوين غضروفي مسبق؛ مثل الترقوة وعظام الجمجمة)",
 "まくしあげる": "سيف ذو حدين (سيف مستقيم بنصل ضيق وحدين) / ثنية مخيطة (طية ضيقة مسطحة مثبتة بالخياطة) / انثناء, تكور ((في الرياضة) وضعية جسدية تُتخذ في بعض الرياضات (مثل الغوص أو التزلج) حيث يتم ثني الركبتين وسحب الفخذين بالقرب من الصدر) / تسالي, حلويات (مأكولات (خاصة الحلويات))",
 "まくしるい": "غشائيات الأجنحة (حشرات لها زوجان من الأجنحة الغشائية ومسرأ متخصص للسع أو الثقب)",
 "まくし上げる": "سيف ذو حدين (سيف مستقيم بنصل ضيق وحدين) / ثنية مخيطة (طية ضيقة مسطحة مثبتة بالخياطة) / انثناء, تكور ((في الرياضة) وضعية جسدية تُتخذ في بعض الرياضات (مثل الغوص أو التزلج) حيث يتم ثني الركبتين وسحب الفخذين بالقرب من الصدر) / تسالي, حلويات (مأكولات (خاصة الحلويات))",
 "まくじゃく": "طاووس أخضر (طاووس جنوب شرق آسيا)",
 "まくじょう": "غِشائِيّ (يَتَّسِم بِتَكْوين غِشاء أو ما يُشبِهُه) / غشائي (متعلق بـ أو مصنوع من أو مشابه لغشاء)\nمثال: بطانة غشائية",
 "まくせい": "غِشائِيّ (يَتَّسِم بِتَكْوين غِشاء أو ما يُشبِهُه) / غشائي (متعلق بـ أو مصنوع من أو مشابه لغشاء)\nمثال: بطانة غشائية",
 "まくせいめいろ": "تِيه غِشَائِيّ (الهياكل الحسية للأذن الداخلية بما في ذلك المستقبلات التيهية والقوقعة؛ وتوجد داخل التيه العظمي)",
 "まくつ": "بَيْت دَعَارَة, مَبْغًى (بمعنى قضى الليل؛ الخَيْمَة من الشَعْر يَبِيت فيها البَدَوي أو المُسافر. الجمع بُيُوت)\nمثال: لنعد إلى البيت.",
 "まくでん": "برق صفائحي (برق يظهر كصحيفة عريضة؛ بسبب انعكاسات البرق البعيد وانتشاره بواسطة السحب)",
 "まくのうち": "فاصِل",
 "まくま": "فاصِل",
 "まくめいがっき": "طبل (آلة إيقاعية موسيقية؛ تتكون عادة من أسطوانة مجوفة مع غشاء مشدود عبر كل طرف)",
 "まくめいろ": "تِيه غِشَائِيّ (الهياكل الحسية للأذن الداخلية بما في ذلك المستقبلات التيهية والقوقعة؛ وتوجد داخل التيه العظمي)",
 "まくや": "خَيْمَة (هو البَيْت الذي يقام من أعواد الشَجَر يُلقى عليه نَبَات يستطل به في الحَرّ ويكون مُؤَقَّتا؛ البيت الذي يتخذ من صوف أو قطن أو غيره من النسيج يقوم على عِمَاد أو أكثر. يطلق على الخِبَاء أيضا)\nمثال: سرقت خيمة كارل. / كنيس, معبد يهودي ((اليهودية) مكان العبادة لجماعة يهودية) / المسكن, خيمة الاجتماع ((اليهودية) مزار محمول حمل فيه اليهود تابوت العهد أثناء خروجهم)",
 "まくら": "وِسَادَة, مِخَدَّة (ما يوضع تحت الرأس عند النوم أو الاستلقاء)\nمثال: غطى توم رأسه بوسادة. / مُقَدَّمَة / تَعْرِيف (الإعلام؛ الشيء أو الكلمة: التوضيح بالمعنى بصورة مختصرة ليعرف الناس ما هي) / مُقَدَّمَة, مَدْخَل\nمثال: هل لديه بطاقة شخصية (هوية شخصية - بطاقة تعريف)",
 "まくらぎ": "نجاح مفاجئ (عمل يحقق نجاحاً غير متوقع) / قوبيون نائم (سمكة استوائية تشبه القوبيون وتستقر بهدوء في القاع في المياه الضحلة) / أثاث للنوم (قطعة أثاث يمكن فتحها لتصبح سريراً) / بيجامة أطفال (بيجامة بأقدام؛ يرتديها الأطفال)\nمثال: كان ذلك الفيلم هو النجاح المفاجئ لهذا الصيف",
 "まくらことば": "مُقَدِّمَة",
 "まくらじょうようがん": "لابة وسادية (حمم تصلبت في أشكال مستديرة توحي بالوسائد؛ يعتقد أنها ناتجة عن ثورات تحت الماء)",
 "まくらたたき": "حرب الوسائد (لعبة للأطفال تتضمن القتال بالوسائد)",
 "まくらなげ": "حرب الوسائد (لعبة للأطفال تتضمن القتال بالوسائد)",
 "まくらべ": "جانب السرير (المساحة بجانب السرير (خاصة سرير المريض أو المحتضر))\nمثال: وقف الطبيب بجانب سريرها",
 "まくらもと": "جانب السرير (المساحة بجانب السرير (خاصة سرير المريض أو المحتضر))\nمثال: وقف الطبيب بجانب سريرها",
 "まくらをかわす": "ضَاجَعَ, جَامَعَ",
 "まくらカバー": "غطاء وسادة, كيس وسادة (بياضات سرير تتكون من غطاء للوسادة)\nمثال: حمل اللص مسروقاته في كيس وسادة",
 "まくら叩き": "حرب الوسائد (لعبة للأطفال تتضمن القتال بالوسائد)",
 "まくら投げ": "حرب الوسائد (لعبة للأطفال تتضمن القتال بالوسائد)",
 "まくりあげる": "سيف ذو حدين (سيف مستقيم بنصل ضيق وحدين) / ثنية مخيطة (طية ضيقة مسطحة مثبتة بالخياطة) / انثناء, تكور ((في الرياضة) وضعية جسدية تُتخذ في بعض الرياضات (مثل الغوص أو التزلج) حيث يتم ثني الركبتين وسحب الفخذين بالقرب من الصدر) / تسالي, حلويات (مأكولات (خاصة الحلويات))",
 "まくり上げる": "سيف ذو حدين (سيف مستقيم بنصل ضيق وحدين) / ثنية مخيطة (طية ضيقة مسطحة مثبتة بالخياطة) / انثناء, تكور ((في الرياضة) وضعية جسدية تُتخذ في بعض الرياضات (مثل الغوص أو التزلج) حيث يتم ثني الركبتين وسحب الفخذين بالقرب من الصدر) / تسالي, حلويات (مأكولات (خاصة الحلويات))",
 "まくをおろす": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "まくをきっておとす": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "まくをきる": "نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم. / نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "まくをとじる": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "まくをひく": "فَرَغَ, أَنْهَى / اِنْتَهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "まぐさ": "عتبة علوية (عارضة أفقية تستخدم كقطعة تشطيب فوق باب أو نافذة) / عَلَف",
 "まぐさおけ": "مذود, معلف (حاوية (عادة في الحظيرة أو الإسطبل) تتغذى منها الماشية أو الخيول)",
 "まぐさ桶": "مذود, معلف (حاوية (عادة في الحظيرة أو الإسطبل) تتغذى منها الماشية أو الخيول)",
 "まぐち": "واجهة المبنى (وجه أو مقدمة مبنى) / واجهة (امتداد الأرض المحاذية لشارع أو ماء) / وَاجِهَة (الاتجاه الذي يواجهه شيء ما (مثل مبنى)) / اتساع, عَرْض (مدى الشيء من جانب إلى آخر) / سعة أفق, شمولية (القدرة على فهم مجموعة واسعة من المواضيع)\nمثال: يجب أن يكون لدى المعلم شمولية في المعرفة بالمادة",
 "まぐれ": "تريماتودا, مثقوبات (ديدان مفلطحة طفيلية لها ممصات خارجية للالتصاق بالمضيف) / فلق (أي من فصي ذيل الحيتان) / سن المرساة, مخلب المرساة (نتوء مسطح يشبه النصل على ذراع المرساة) / سن الخطاف (شوكة في حربة أو سهم)",
 "まぐれあたり": "تريماتودا, مثقوبات (ديدان مفلطحة طفيلية لها ممصات خارجية للالتصاق بالمضيف) / فلق (أي من فصي ذيل الحيتان) / سن المرساة, مخلب المرساة (نتوء مسطح يشبه النصل على ذراع المرساة) / سن الخطاف (شوكة في حربة أو سهم)",
 "まぐれ当たり": "تريماتودا, مثقوبات (ديدان مفلطحة طفيلية لها ممصات خارجية للالتصاق بالمضيف) / فلق (أي من فصي ذيل الحيتان) / سن المرساة, مخلب المرساة (نتوء مسطح يشبه النصل على ذراع المرساة) / سن الخطاف (شوكة في حربة أو سهم)",
 "まぐろ": "تُونَة, تُنّ / نَجْمَةُ اَلْبَحْرِ",
 "まぐろおんな": "نَجْمَةُ اَلْبَحْرِ",
 "まぐろつり": "تونة (سمكة مياه دافئة دهنية هامة من جنس التونة من فصيلة الإسقمريات؛ تقدم عادة كشرائح)",
 "まぐわ": "جَرّافَة, كَاسِحَة",
 "まぐわい": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "まけ": "غَلَبَ, هَزَمَ (قَهَرَ واِعْتَزَّ عليه واِمْتَنَع) / هَزِيمَة, مَغْلُوبِيَّة / خَصْم, تَخْفِيض (الخَصْمُ :مُجَادِل، مُنَازِع، مُخَاصِم، عكسه حَلِيف أو صَدِيْق، وقد يستوي فيه المفرد والمثنى والجمع؛ والخَصْمُ (في ) : حَطِيطَة)",
 "まけいぬ": "خَاسِر / فَاشِل",
 "まけおしみ": "حِصْرِم",
 "まけぎらい": "عَنِيد, لا يَلِين (لا يَتَراخى ولا يَنْثَنِي تَحْت الضَّغْط) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)",
 "まけぐみ": "خَاسِر / فَاشِل",
 "まけしらず": "لَا يُغْلَب, لَا يُقْهَر (لَا يُمْكِنُ هَزِيمَتُهُ أَوْ إِخْضَاعُهُ) / عَصِيٌّ عَلَى الهَزِيمَة, لَا يُقْهَر (يصعب التغلّب عليه أو هزيمته)",
 "まけじと": "بِإِصْرَار, بِعَزْم (إظهار تصميم أو هدف حازم) / بِتَصْمِيم, بِحَزْم (بثبات الهدف)\nمثال: رفضت بحزم النظر إليه أو التحدث معه",
 "まけずおとらず": "بِالتَّسَاوِي",
 "まけずぎらい": "عَنِيد, لا يَلِين (لا يَتَراخى ولا يَنْثَنِي تَحْت الضَّغْط) / عَنُود, مُثَابِر (ثابت بإصرار لا يلين ولا يتراجع)",
 "まけないくらい": "قَدْر اَلْمُسْتَطَاع, قَدْر اَلْإِمْكَان (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "まけないぐらい": "قَدْر اَلْمُسْتَطَاع, قَدْر اَلْإِمْكَان (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر)\nمثال: خذ قدر ما تريد.",
 "まけにふしぎのまけなし": "هُنَاك, يُوجَد",
 "まける": "فَقَدَ / خَسِرَ (كلمة \"خسر\" تعني فقدان شيء ما، سواء كان مالا أو شيئا آخر. وتشمل معانيها: فقد المال، الهلاك، الضياع…؛ فعل متعدٍّ ومُتعدٍّ لِمَعْنَى، ومعناها الأساسي فقدان شيء ما. وتتعدد معانيه لتشمل)\nمثال: خسر توم وظيفته. / أَذْعَنَ ((أَذْعَنَ): انْقَادَ وسلس وَيُقَال: أذعن بِالْحَقِّ: أقرّ بِهِ)",
 "まけんし": "ورق صنفرة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "まげ": "كَعْكَة (واحدة الكَعْك؛ حَلْوَى تُصْنع من الدَقِيق والحَلِيب والسُكَّر والزَيت ويخبز طريًا وقد يوضع عليه القِشْطَة. يُسمى عند البعض كَيْك وعند البعض تُورْتَة)\nمثال: خبزت كعكة لتوم. / انثناء, ثني (فعل ثني مفصل؛ خاصة المفصل بين عظام طرف بحيث تقل الزاوية بينهما) / انثناء, ثنية (شكل زاوي أو مستدير ناتج عن الطي) / انثناء, ثني (حالة الانثناء (كما في المفصل))\nمثال: طية في المنديل",
 "まげものや": "مرهن",
 "まげやすい": "طَيِّع, قَابِلٌ لِلثَّنْي (يُمْكِنُ ثَنْيُهُ أَوْ لَيُّهُ دُونَ أَنْ يَنْكَسِرَ) / طَيِّع, مَرِن (قَادِرٌ عَلَى التَّكَيُّفِ بِسُهُولَةٍ مَعَ ظُرُوفٍ مُخْتَلِفَةٍ) / طَيِّع, قَابِل لِلتَّشْكِيل (قابل للتشكيل أو الثني أو السحب) / قَابِل لِلتَّشْكِيل, مَرِن (قابل للتأثير أو التشكيل)",
 "まげる": "ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)\nمثال: 少年は考えを曲げなかった。 — لم يغير الولد رأيه. / مَالَ (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا) / اِسْتَنَدَ, اِتَّكَأَ\nمثال: أريد بعض المال. / ثَنَى (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه) / أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "まこ": "حكاكة ظهر (أداة حك ذات مقبض طويل لحك ظهرك) / متبادل المصالح, نفعي (شخص مستعد لتبادل الخدمات أو المعروف لتحقيق مصلحة متبادلة)",
 "まこころ": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "まこと": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة. / إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…) / بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك) / بالفعل, جداً (في الحقيقة (غالباً ما تميل إلى التوكيد))\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "まことしやか": "قابل للتصديق, معقول (يبدو معقولاً وموثوقاً، وبالتالي مقنعاً) / مَعْسُول الكَلَام, مُقْنِع زَيْفًا (يَتَّسِم بِتَقْدِيم حُجَج خَادِعَة تَبْدُو مَقْبُولَة)\nمثال: عذر وجيه",
 "まことに": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا .",
 "まことにありがとうございます": "شُكْرًا جَزِيلًا, أَلْف شُكْر",
 "まことにもって": "إجمالاً, في المجموع (مع تضمين أو عد كل شيء)\nمثال: إجمالاً يكسب ما يقرب من مليون دولار",
 "まころん": "ماكارون (حلوى تعتمد على الميرانغ وتُصنع من بياض البيض والسكر البودرة والسكر الحبيبي ومسحوق اللوز أو اللوز المطحون وملونات الطعام)",
 "まご": "حَفِيد, حَفِيدَة / حكاكة ظهر (أداة حك ذات مقبض طويل لحك ظهرك) / متبادل المصالح, نفعي (شخص مستعد لتبادل الخدمات أو المعروف لتحقيق مصلحة متبادلة)",
 "まごうかたなき": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "まごうかたなく": "بلا شك, من دون شك (بدون شك؛ بالتأكيد)\nمثال: إنه بلا شك جميل جداً",
 "まごうことなき": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "まごう事なき": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "まごう事無き": "لَا لَبْسَ فِيه (بيّن للعقل بشكل لا يقبل الخطأ أو اللبس) / بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "まごこ": "الأجيال القادمة, الخَلَف (جميع الأجيال المستقبلية) / أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا",
 "まごころ": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…)",
 "まごころをこめて": "قَلْبًا وَقَالَبًا",
 "まごころを込めて": "قَلْبًا وَقَالَبًا",
 "まごさん": "حَفِيد, حَفِيدَة",
 "まごたろうむし": "هيلغراميت (يرقة مائية بنية كبيرة لذبابة دوبسون؛ تستخدم كطعم للصيد)",
 "まごち": "مسطحة الرأس (سمكة شاحبة تعيش في القاع مسطحة الرأس ذات عيون كبيرة وخطم يشبه البط) / مسطحة الرأس (سمكة غذائية في المنطقة الإندونيسية من المحيط الهادئ؛ تشبه الغرنار)",
 "まごつく": "تجوال خلسة, تسلل (فعل التجوال خلسة)",
 "まごのて": "حكاكة ظهر (أداة حك ذات مقبض طويل لحك ظهرك) / متبادل المصالح, نفعي (شخص مستعد لتبادل الخدمات أو المعروف لتحقيق مصلحة متبادلة)",
 "まごびき": "عَقْرَب ثَوَانِي",
 "まごまご": "اِحْتَارَ / تَشَوَّش / اِرْتَبَكَ, تَشَوَّش",
 "まごむすこ": "حَفِيد",
 "まごむすめ": "حَفِيدَة",
 "まごやし": "نفل أبيض, نفل زاحف (نفل أوروبي زاحف ذو أزهار بيضاء إلى وردية وأوراق خضراء زاهية؛ متوطن في الولايات المتحدة؛ يزرع على نطاق واسع كعلف)",
 "まさ": "مَضْبُوط, دَقِيق",
 "まさい": "صرير, طحن (صوت خشن وحاد (مثل صوت طحن التروس)) / سحالة, نحاتة (المادة الناتجة عن عملية الطحن) / تآكل, سحج (تآكل جزيئات الصخور عن طريق الاحتكاك بسبب الماء أو الرياح أو الجليد)\nمثال: سحالة الخضروات سدت المصرف",
 "まさか": "أَبَدًا / بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ / طَوَارِئ, حَالَةْ اَلطَّوَارِئ / بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك) / بالفعل, جداً (في الحقيقة (غالباً ما تميل إلى التوكيد))\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "まさかき": "دائم الخضرة ((عن النباتات والشجيرات) تحمل أوراق الشجر طوال العام) / نبات دائم الخضرة (نبات له أوراق تدوم وتظل خضراء طوال العام)",
 "まさかさま": "رَأْسًا عَلَى عَقِب, مُنْدَفِع (بالرأس أولاً نحو الأمام) / برأسه أولاً, مندفعاً (بالرأس قبل الجسم) / باندفاع, بتهور (بطريقة متسرعة ومتهورة) / باندفاع, بسرعة جنونية (بسرعة خطرة جداً)\nمثال: انزلق العداء برأسه أولاً نحو القاعدة الثالثة",
 "まさかのとき": "مَعَ الْوَقْت (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "まさかの時": "مَعَ الْوَقْت (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع)\nمثال: جئت مع أصدقائي.",
 "まさかり": "فأس عريضة (فأس كبيرة ذات شفرة قطع عريضة)",
 "まさき": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "まさぐる": "تحسس, تلمس (فعل التلمس (في الظلام عادة))",
 "まさご": "رَمْل (ذرات دقيقة من الصخور أو المعادن، تتكون طبيعياً بفعل الرياح أو الماء؛ تربة رخوة تتكوّن غالباً على الشاطئ أو في الصحارى)\nمثال: وصلت شاحنة الرمل.",
 "まさしく": "بِالتَّأْكِيد / بِالتَّأْكِيد, بِدُون شَكّ / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "まさつ": "اِحْتِكَاك / احتكاك, فرك (الجهد المبذول في تحريك جسم فوق آخر مع الضغط) / طبع بالفرك (تمثيل يتكون من نسخة (كما لنقش) مصنوعة بوضع ورقة فوق شيء ما وفركها بالفحم) / احتكاك (المقاومة التي يتم مواجهتها عند تحريك جسم متلامس مع آخر) / خِلَاف, شِقَاق (نزاع ناتج عن عدم الاتفاق) / تضارب, تنافر (خليط حاد ومزعج من الأصوات) / تنافر, شقاق (خلاف بين أولئك المتوقع منهم التعاون) / خلاف, شقاق (عدم الاتفاق أو الانسجام)",
 "まさつおん": "اِحْتِكَاكِي, رَخْو",
 "まさつき": "مَطْحَنَة, رحى / طَحَن (طَحَنَ؛ طِحْنٌ)",
 "まさつけいすう": "معامل الاحتكاك (في : هو قِيمَة تبيّن دَرَجَة وجود صِفَة أو علاقة في موقف معلوم؛ في : هو العَدَد الذي يسبق المُتَغَيِّر (الحَرْف) في ذات الحد)\nمثال: أساء توم معاملة ماري.",
 "まさつクラッチ": "قابض احتكاكي (قابض يقوم فيه جزء بتدوير الجزء الآخر عن طريق الاحتكاك بينهما)",
 "まさに": "بِالضَّبْط, تَمَامًا / بِالْضَبْط / يَمِين, يمين / صَحِيح, صَوَاب / قَائِم / عَلَى اَلْيَمِين (يفيد الاستعلاء؛ يفيد التعليل) / إِلَى اَلْيَمِين (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / صحيح, تمام / حَقّ, حُقُوق (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له) / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: أجب على السؤال. / عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل / حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا .",
 "まさば": "ماكريل تشوب (ماكريل صغير يوجد في جميع أنحاء العالم تقريباً)",
 "まさむね": "غاية, غَرَض",
 "まさる": "تَفَوَّقَ, بَزَّ / بَرَعَ (تفوق أو تميز في مجال معين أو عمل معين؛ أجاد وأتقن أداء مهمة أو عمل) / ثَقَلَ (ثَقَلَ الشيءَ يَثْقُلُه بِيَدِهِ ثَقْلًا: رَازَ ثِقَلَه؛ ثَقَلَ الشَّيْء بِيَدِهِ ثقلا قدّر ثِقْلَه)\nمثال: ان ثقل ما تحمل، فضع بعضا منه. / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا. / سَعْدَان, قِرْد",
 "まさるともおとらない": "عَفْوًا, عَلَى الرُحْب وَالسَّعَة",
 "まさるともおとらぬ": "عَفْوًا, عَلَى الرُحْب وَالسَّعَة",
 "まざい": "مَشْرُوب الطَّاقَة",
 "まざまざ": "بِشَكْل حَيّ, بِوُضُوح (بطريقة حية)\nمثال: وصف مغامراته بشكل حي",
 "まざりあう": "خَلَط (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "まざりもの": "شوائب, عدم نقاء (حالة كونه غير نقي) / خبث, شائب (مادة عديمة القيمة أو خطرة يجب إزالتها)\nمثال: كانت هناك شوائب في الماء",
 "まし": "أَفْضَل, أَحْسَن / حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة. / أَكْثَر / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة! / أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "ましかく": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "ましこ": "جَزَم, تُنْجِيّ (قطع أو حسم الشيء بدقة وثبات؛ في : جعل الكلمة في حالة الجزم، وذلك بحذف الحرف الأخير أو حركته) / سَعْدَان, قِرْد",
 "ましこどり": "جَزَم, تُنْجِيّ (قطع أو حسم الشيء بدقة وثبات؛ في : جعل الكلمة في حالة الجزم، وذلك بحذف الحرف الأخير أو حركته)",
 "ましじめ": "تَضْيِيق",
 "ましずり": "إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "ました": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)",
 "まして": "نَاهِيكَ عَن, هٰذَا عَدَا عَنْ",
 "ましてや": "نَاهِيكَ عَن",
 "ましにん": "بذور القنب (بذرة نبات القنب؛ يمكن أن تؤكل نيئة أو مطحونة أو منبتة أو تحول إلى مسحوق براعم مجفف)",
 "ましにんがん": "اَلطِّبّ اَلصِّينِيّ",
 "まします": "كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "ましゃく": "قياس (فعل أو عملية تعيين أرقام للظواهر وفقًا لقاعدة)\nمثال: تمت القياسات بعناية",
 "ましょ": "لِـ, هَيَّا (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي) / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / غريموار, كتاب تعاويذ (دليل للسحر الأسود (لاستحضار الأرواح والشياطين))",
 "ましょう": "بِشَيْطَنَة, بِمَكْر شَدِيد (بطريقة شيطانية لعوبة) / إِبْلِيسِيّ, مَاكِر (يُظهر الدهاء أو الخبث أو الشر المميز للشيطان) / شَيْطَانِيّ, مَاكِر بِلُطْف (مرح بجرأة جذّابة ومحبّبة)\nمثال: الاشتراكيون يواجهون عائقاً إضافياً إذا اعتقدوا أن الرأسماليين ليسوا أشراراً فحسب بل أذكياء بشيطنة أيضاً / لِـ, هَيَّا (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي) / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "ましょうじき": "صَرِيح, مُسْتَقِيم",
 "ましら": "سَعْدَان, قِرْد",
 "ましろ": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "ましん": "اَلشَّيْطَان, إِبْلِيس / شَيْطَان, إِبْلِيس ((في الأديان الإبراهيمية) الرُّوح الشِّرِّير الَّذِي يَرْمِي بِكَ لِلتَّهْلُكَةِ لِبُعْدِهِ عَنِ الْخَيْرِ وَطَرِيقِ الْحَقِّ؛ (استعمال مجازي) كُلّ وَلَدٍ مُشَاكِسٍ أَوْ مُتَمَرِّدٍ)\nمثال: العجلة من الشيطان. / النُّقْطَة المَيِّتَة (موضع المرفق عندما يكون على خط واحد مع ذراع التوصيل ولا يبذل عزم دوران) / حَصْبَة",
 "まじ": "جِدِّيّ / جَدِّيّ, جَادّ / عَجَزَ, لَا يَسْتَطِيع",
 "まじうる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح. / تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ / صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "まじえる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح. / تَبْدِيل, تَبَادُل / بُورْصَة, تَدَاوُل / تَبَادَلَ, صَرَفَ / صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق.",
 "まじか": "قَرِيب / قَرِيبًا / بِٱلْقُرْب مِنَ, عِنْدَ / قَرُبَ (أَدْنَى؛ قدَّرَ)\nمثال: جلست بالقرب منها.",
 "まじない": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "まじなう": "لَعْنَة (أي رغبة صريحة في أن تصيب المحن أو أي شكل من أشكال سوء الحظ كيانًا ما، سواء كان شخصًا، أو مكانًا، أو كائنًا) / نِقْمَة / لَعَنَ ((في الدين) طَرَدَهُ اللَّٰهُ مِنْ رَحْمَتِهِ؛ سَبَّ، شَتَمَ) / شَتَمَ, سَبَّ\nمثال: اللعنة حولها ومعرفة / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "まじまじ": "بتركيز, بثبات (بطريقة ثابتة ومركزة)\nمثال: حدق بي بثبات",
 "まじまんじ": "عَجَبًا / سُبْحَانَ الله (مصدر للفعل سَبَحَ؛ تُقال حصرًا للَّٰه، كما في العبارة \"سُبْحَانَ اللَّٰهِ\")\nمثال: سبحان الله عما يشركون.",
 "まじめ": "جِدِّيّ / جَدِّيّ, جَادّ / نَزِيه, صَادِق",
 "まじゅつ": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر. / ألعاب خفة, خدعة سحرية (عمل وهمي؛ يعتبره المراقبون السذج سحراً)",
 "まじゅつし": "سَاحِر",
 "まじゅつてき": "سِحْرِيّ",
 "まじょ": "سَاحِرَة",
 "まじょのいちげき": "مُسْتَدَقّ الظَّهْر",
 "まじりあう": "خَلَط (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "まじりけ": "خَلِيط",
 "まじりっけ": "خَلِيط",
 "まじりもの": "خَلِيط",
 "まじる": "فَائِدَة",
 "まじろぐ": "غَمَزَ / غَمْزَة",
 "まじわり": "مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب. / جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس. / مُفْتَرَق, تَقَاطُع / تَقَاطُع",
 "まじわる": "صَلِيب / عَبْر, خِلَال (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات) / عَبَرَ (الشيء: اجتازه وقطعه من طرف إلى الطرف الآخر كاملا؛ الشخص: مات)\nمثال: عبر جرذ الطريق. / جَامَعَ, ضَاجَعَ (اسم فاعل من الفعل جَمَعَ، الذي قام بالجَمع؛ قِدرٌ جامع: عظيمة. الجمع جُمْع)\nمثال: في أي جامعة تدرس؟",
 "まじん": "اَلشَّيْطَان, إِبْلِيس / شَيْطَان, إِبْلِيس ((في الأديان الإبراهيمية) الرُّوح الشِّرِّير الَّذِي يَرْمِي بِكَ لِلتَّهْلُكَةِ لِبُعْدِهِ عَنِ الْخَيْرِ وَطَرِيقِ الْحَقِّ؛ (استعمال مجازي) كُلّ وَلَدٍ مُشَاكِسٍ أَوْ مُتَمَرِّدٍ)\nمثال: العجلة من الشيطان. / سَاحِر",
 "まじ卍": "عَجَبًا / سُبْحَانَ الله (مصدر للفعل سَبَحَ؛ تُقال حصرًا للَّٰه، كما في العبارة \"سُبْحَانَ اللَّٰهِ\")\nمثال: سبحان الله عما يشركون.",
 "ます": "قِيَاس / فَاصِلَة / إِجْرَاء / قَاسَ (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / صُنْدُوق, صَنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / شَمْشَاد / شَمْشِير / شَمْشَار / عَثَق / بُقْس / لَكْمَة, بُكس / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة)\nمثال: أين صندوق البريد؟ / زَاد (زَادَ يَزِيدُ زَيْدًا، وزِيادَةً: نما وكَثُرَ؛ زَادَ الشيءَ: جعله يزيد) / زِيَادَة / اِرْتِفَاع, اِزْدِيَاد\nمثال: زاد السياح عددا. / تَرُوتَة, أُطْرُوط / كَانَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ) / كَانَ هُوَ, هِيَ (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا. / ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / ذَهَبَ, زَالَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ المَالِيّ وَيُسْتَخْدَمُ أَيْضاً فِي صِنَاعَةِ الْحُلِيّ وَالْمُجَوْهَرَات؛ هَذَا رَجُل ذَهَبا: أَيْ رَجُلٌ يُسَاوِي ذَهَباً فِي قِيمَتِهِ وَقدره) / غُو\nمثال: ذهب إلى الدكان.",
 "ますい": "تخدير (فقدان الإحساس الجسدي مع أو بدون فقدان الوعي) / اِمْتِصَاص / إِنْتِشاء",
 "ますいい": "أخصائي تخدير, طبيب تخدير (أخصائي يقوم بإعطاء المخدر للمريض قبل العلاج)",
 "ますいか": "علم التخدير (فرع العلوم الطبية الذي يدرس ويطبق مواد التخدير)",
 "ますいかい": "أخصائي تخدير, طبيب تخدير (أخصائي يقوم بإعطاء المخدر للمريض قبل العلاج)",
 "ますいかがく": "علم التخدير (فرع العلوم الطبية الذي يدرس ويطبق مواد التخدير)",
 "ますいがく": "علم التخدير (فرع العلوم الطبية الذي يدرس ويطبق مواد التخدير)",
 "ますいざい": "مُخَدِّر, بَنْج",
 "ますいやく": "مُخَدِّر, بَنْج",
 "ますかき": "عَادَة سِرِّيَّة / اِسْتِمْنَاء",
 "ますがた": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "ますぐ": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم. / صَرِيح, مُسْتَقِيم",
 "ますげ": "سعد, عشبة السعد (نبات يشبه العشب أو الأسل ينمو في الأماكن الرطبة وله سيقان صلبة وأوراق ضيقة تشبه العشب وسنيبلات من الزهور غير الواضحة)",
 "ますのすけ": "سلمون شينوك, سلمون ملكي (سلمون كبير من المحيط الهادئ يُقدر كطعام؛ يموت البالغون بعد وضع البيض) / تشينوك, سلمون الملك (لحم وردي أو أبيض لسلمون المحيط الهادئ الكبير)",
 "ますひと": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "ますます": "أكثر فأكثر, بشكل متزايد (يتقدم في الكمية أو الكثافة)\nمثال: أصبحت مكتئبة بشكل متزايد",
 "ますますもって": "أكثر فأكثر, بشكل متزايد (يتقدم في الكمية أو الكثافة)\nمثال: أصبحت مكتئبة بشكل متزايد",
 "ますめ": "قِيَاس / فَاصِلَة / إِجْرَاء / قَاسَ (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة. / صُنْدُوق, صَنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / شَمْشَاد / شَمْشِير / شَمْشَار / عَثَق / بُقْس / لَكْمَة, بُكس / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة)\nمثال: أين صندوق البريد؟",
 "ますらお": "بَطَل, بَطَلَة",
 "まする": "حَكَّ, فَرَكَ (مَرَّرَ شَيْئًا عَلَى شَيْءٍ آخَرَ بِقُوَّةٍ لِيُزِيلَ مَا عَلَيْهِ؛ حَكَّ جلدَه : فركه بأظفاره)\nمثال: لقد حك سامي كعبه حتى بدأ ينزف. / آلَةُ طِبَاعَة, آلَةُ الطِّبَاعَة (الفارسية: ماشين؛ الأوردية: مشين) / صِحَافَة, صَحَافَة (هي مهنة من يكتب في الصُحُف والمَجَلات وغيرها من الدَوْريَّات؛ هي مجموعة المؤسسات التي تصدر أو تنشر الصُحُف والمَجَلات وغيرها من الدَوْريَّات) / ضَغَطَ\nمثال: نسى زيري الآلة.",
 "ます目": "قِيَاس / فَاصِلَة / إِجْرَاء / قَاسَ (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة. / صُنْدُوق, صَنْدُوق (وعاء كبيرة من الخشب غالبا وقد يكون حديدًا يستخدم لوضع الاشياء داخله، ويكون لها عادة جهة قابلة للفتح سواء بمفاصل او بالازالة الكاملة؛ صُنْدُوْقُ السَيَّارَة قمرة تشبه الصندوق في الجزء الخلفي من السيارة يستخدم كالصندوق) / شَمْشَاد / شَمْشِير / شَمْشَار / عَثَق / بُقْس / لَكْمَة, بُكس / لَكَمَ (معناه: ضرب بقبضة اليد أو اللكم؛ معنى آخر: الضرب بشدة)\nمثال: أين صندوق البريد؟",
 "まず": "أَوَّل, أُولَى (الذي يكون ترتيبه وَاحِد، الذي كان قبل الآخرين؛ الأوَّل اسم من الأسماء الحسنى) / أَوَّلاً / مثال: لم تكن أول مرة. / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / حَوَالِي / عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال. / خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "まずしい": "فَقِير / مِسْكِين / فُقَرَاء / غَائِب, مَفْقُود (غير موجود أو مفتقد)",
 "まずだいいちに": "أَوَّلًا, قَبْلَ كُلِّ شَيْءٍ",
 "まずない": "بالكاد, قبل قليل (قبل وقت قصير جداً فقط) / بالكاد, قلّما (تقريباً لا؛ بصعوبة بالغة)\nمثال: بالكاد كنا نعرفهم",
 "まずは": "أَوَّلًا, قَبْلَ كُلِّ شَيْءٍ / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / حَوَالِي / عَلَى كُلِّ حَال, على كل حال (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى أَيُّ حَالٍ, على كل حال (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "まずまず": "لَا بَأْسَ بِهِ, مَقْبُول (متوسّط المستوى تقريبًا؛ يمكن القبول به) / محتمل, مقبول (يمكن تحمله أو الصبر عليه)\nمثال: المناخ محتمل على الأقل",
 "まずもって": "أَوَّلًا, قَبْلَ كُلِّ شَيْءٍ",
 "まずる": "خطأ فادح, زلة (خطأ محرج)",
 "まず無い": "بالكاد, قبل قليل (قبل وقت قصير جداً فقط) / بالكاد, قلّما (تقريباً لا؛ بصعوبة بالغة)\nمثال: بالكاد كنا نعرفهم",
 "まず第一に": "أَوَّلًا, قَبْلَ كُلِّ شَيْءٍ",
 "ませ": "أَرْضَى, أَعْجَبَ / مِن فَضْلِك (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / رَجَاءً / لَو سَمَحْت / لُطْفًا / أَرْجُوك\nمثال: يا لها من جملة!",
 "ません": "لَا, مَا (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / مثال: لا أحب المدرسة.",
 "まぜあわす": "توليف, مزج (عملية مزج المكونات معاً بدقة) / كلمة منحوتة, نحت (كلمة جديدة تتشكل من خلال ضم كلمتين أخريين والجمع بين معانيهما) / امتزاج, تمازج (حدوث خلط شامل)\nمثال: 'الزمكان' هي نحت من 'الزمان' و 'المكان'",
 "まぜあわせる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "まぜかえす": "قَاطَعَ",
 "まぜこぜ": "خليط, مزيج غير متجانس (نظرية أو حجة مكونة من أفكار متنوعة أو غير متناغمة) / كعكة جامبل (كعكة أو بسكويت صغير مسطح على شكل حلقة) / خليط, ركام (مجموعة مشوشة من الأشياء)",
 "まぜっかえす": "قَاطَعَ",
 "まぜもの": "خَلِيط",
 "まぜる": "خَلَطَ, مَزَجَ (اختلط)\nمثال: خلط توم بين السكر و الملح.",
 "まそ": "أَثِير",
 "まそん": "إهلاك, استهلاك (انخفاض في قيمة أصل ما بسبب التقادم أو الاستخدام)",
 "また": "أُرْبِيَّة, مَغْبَن / شَوْكَة, مِذْرَاة (أداة لتناول الطعام تتكون عادةً من مقبض وعدة أسنان حادة، وتُستعمل لغرز الطعام وحمله إلى الفم) / تَفَرَّعَ / تَشَعَّبَ\nمثال: هناك شوكة ناقصة. / مَرَّة أُخْرَى, ثَانِيَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟ / أَيْضًا, كَذٰلِكَ / من ناحية أخرى, من جهة أخرى (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / وَ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك) / صَائِت, مُصَوِّت / حَرَكَة, حَرْفُ مَدّ / حَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ)\nمثال: لقد أوقفنا حركة المرور.",
 "またあした": "أَرَاكَ غَدًا\nمثال: それじゃまた明日。 — أراك غداً.",
 "またい": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري. / أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ) / خَزْنَة حَدِيدِيَّة, خَزْنَة\nمثال: هو غبي وغير أمين.",
 "またいとこ": "قريب من الدرجة الثانية (ابن ابن عم أو ابن خال أحد الوالدين)",
 "またうけ": "عقد من الباطن (عقد يسند إلى طرف آخر بعض التزامات عقد سابق)",
 "またうけおい": "عقد من الباطن (عقد يسند إلى طرف آخر بعض التزامات عقد سابق)",
 "またおい": "ابن ابن الأخ, ابن ابن الأخت (ابن ابنة أخيك أو ابن أخيك)",
 "またがし": "تأجير من الباطن (إيجار من مستأجر إلى مستأجر آخر)",
 "またがみ": "خَصْر, وَسَط (خصره خصرا ضرب خاصرته)",
 "またがる": "رَكِبَ (عَلَى أو أعْتَلَى شيئا؛ السَيَّارَة أو وسيلة نقل أخرى، استخدمها في تنقله بدلا من الدواب)\nمثال: ركب ياني سفينة. / شِبْر\nمثال: 台風の被害は数県にまたがっていた。 — طالت الخسائر التي خلفها الإعصار الكثير من المحافظات.",
 "またぎき": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً) / إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "またくぎ": "أَسَاسِيّ, رَئِيسِيّ (ضروريّ أو مهمّ خاصة فيما يتعلّق بالأغذية أو السلع) / سلع أساسية (سلعة ضرورية يكون الطلب عليها ثابتاً) / دبوس دباسة / مسمار مشبك (وتد صغير من حَدِيد أحد طرفيه مسنون والآخر له رأس يدق في الخشب والجدران وغيرها للتثبيت؛ غِلْظ صغير مخروطي الشكل قد يحدث في أصابع القدم أو في أخْمَص القدم)",
 "またぐ": "شِبْر",
 "またぐら": "أعضاء تناسلية, أعضاء جنسية (عضو جنسي خارجي) / مفرق الساقين, منشعب (الزاوية التي تشكلها الجوانب الداخلية للساقين حيث تلتقي بجذع الإنسان) / شعبة, مفترق (منطقة الزاوية المتكونة من تقاطع فرعين)\nمثال: أخذوا المفترق الجنوبي",
 "またぐらこうやく": "خائن, غادر (شخص يقول شيئاً ويفعل شيئاً آخر)",
 "またぐらごうやく": "خائن, غادر (شخص يقول شيئاً ويفعل شيئاً آخر)",
 "またこさく": "تأجير من الباطن (إيجار من مستأجر إلى مستأجر آخر)",
 "またこんど": "آخَر, غَيْرُهُ (أيّ بديل من بدائل شتّى؛ شيء آخر)",
 "またしても": "مَرَّة أُخْرَى, ثَانِيَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "またぞろ": "مَرَّة أُخْرَى, ثَانِيَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "またたき": "رَمَشَ (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء وعين رمشاء وقد ارمش؛ وبه رمش اي برش:- وارمش الشجر:- اورق كأربش وقال ابن الاعرابي أرمش أخرج ثمره كالحمص، وارض رمشاء: كثيرة العشب كرسماء) / رَمْشَة / طرفة عين, لمح البصر (وقت قصير جداً (مثل الوقت الذي تستغرقه العين لتطرف))\nمثال: سأفعل ذلك في لمح البصر",
 "またたく": "لَأْلَأَ (لَمَعَ، أَشْرَقَ؛ (استخدام مجازي) اغْرَوْرَقَتْ الدُّمُوع) / رَمَشَ (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء وعين رمشاء وقد ارمش؛ وبه رمش اي برش:- وارمش الشجر:- اورق كأربش وقال ابن الاعرابي أرمش أخرج ثمره كالحمص، وارض رمشاء: كثيرة العشب كرسماء) / رَمْشَة",
 "またたくま": "طرفة عين, لمح البصر (وقت قصير جداً (مثل الوقت الذي تستغرقه العين لتطرف))\nمثال: سأفعل ذلك في لمح البصر",
 "またたくまに": "حالاً, على الفور (بدون أي تأخير)\nمثال: قُتل على الفور",
 "またたく間に": "حالاً, على الفور (بدون أي تأخير)\nمثال: قُتل على الفور",
 "まただのみ": "تمني, رغبة (تعبير عن رغبة أو ميل ما)\nمثال: استطعت أن أدرك أنها كانت رغبته في أن يغادر الضيوف",
 "またと": "مَرَّة أُخْرَى, ثَانِيَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "またとない": "فَرِيد, فَذّ",
 "またと無い": "فَرِيد, فَذّ",
 "またな": "إِلَى اللِّقَاء (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / مَعَ السَّلَامَة (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: تعال إلى منزلي.",
 "またない": "فَرِيد, فَذّ",
 "またぬき": "جِسْرٌ صَغِير (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "またぬの": "سَرْج, سرج ((سَرَجَ) فلان سرجا: كذب. ويقال سرج فلان الكذب؛ (سَرَجَ)ت المرأة شعرها: ضفرته)",
 "またね": "إِلَى اللِّقَاء (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / مَعَ السَّلَامَة (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع) / سَلَام (أمان، سِلم، صُلْح؛ السلامةُ والبراءة من العيوبِ)\nمثال: تعال إلى منزلي.",
 "またのな": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "またのなを": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "またの名": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر) / اسم مستعار (اسم تم انتحاله)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "またの名を": "المَعْرُوف بِـ, بِاسْم مُسْتَعَار (كما هو معروف أو مسمى في وقت أو مكان آخر)\nمثال: السيد سميث، المعروف بالسيد لافاييت",
 "または": "أَو, أَم (يفيد الشك؛ يفيد التقسيم)\nمثال: أكون أو لا أكون؟",
 "またまた": "مَرَّة أُخْرَى (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "まためい": "ابنة ابن الأخ, ابنة ابن الأخت (ابنة ابنة أخيك أو ابن أخيك)",
 "またも": "مَرَّة أُخْرَى, ثَانِيَةً (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "またもや": "مَرَّة أُخْرَى (مؤنث مُرّ، صفة ما كان بها مرارة)\nمثال: كم من مرة ذهبت؟",
 "またらいしゅう": "أراكَ قَريبًا, سَلَام",
 "またーり": "غَنِيّ / رَائِق, هَادِئُ الطَّبْع (غَيْرُ مُسْتَعْجِلٍ وَمُسْتَرْخٍ)",
 "また上": "خَصْر, وَسَط (خصره خصرا ضرب خاصرته)",
 "また今度": "آخَر, غَيْرُهُ (أيّ بديل من بدائل شتّى؛ شيء آخر)",
 "また抜き": "جِسْرٌ صَغِير (شَجُعَ، جرُؤ؛ أقدم على الخطر واجترأ)\nمثال: اذهب إلى الجسر.",
 "また明日": "أَرَاكَ غَدًا\nمثال: それじゃまた明日。 — أراك غداً.",
 "また来週": "أراكَ قَريبًا, سَلَام",
 "また聞き": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً) / إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "また貸し": "تأجير من الباطن (إيجار من مستأجر إلى مستأجر آخر)",
 "また釘": "أَسَاسِيّ, رَئِيسِيّ (ضروريّ أو مهمّ خاصة فيما يتعلّق بالأغذية أو السلع) / سلع أساسية (سلعة ضرورية يكون الطلب عليها ثابتاً) / دبوس دباسة / مسمار مشبك (وتد صغير من حَدِيد أحد طرفيه مسنون والآخر له رأس يدق في الخشب والجدران وغيرها للتثبيت؛ غِلْظ صغير مخروطي الشكل قد يحدث في أصابع القدم أو في أخْمَص القدم)",
 "まだ": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة. / بَعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / أَكْثَر / عَلَى اَلْأَقَلّ (يفيد الاستعلاء؛ يفيد التعليل) / عَلَى الأَقَلِّ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "まだい": "البَحْرُ الأَحْمَر, بَحْرُ القُلْزُم",
 "まだき": "بَاكِر (صيعة الأمر المفرد المذكر من الفعل بَاكَرَ) / مُبَكِّرًا, بَاكِرًا / قَد, مِنْ قَبْلُ (يفيد التحقيق. (مع الماضي والمضارع)؛ يفيد التقريب. (مع الماضي)) / لقد",
 "まだけ": "خيزران الخشب العملاق, ماداكي (خيزران كبير له سيقان سميكة الجدران؛ موطنه الصين وربما اليابان؛ يُزرع على نطاق واسع في أماكن أخرى)",
 "まだしも": "بِالْأَحْرَى",
 "まだたき": "رَمَشَ (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء وعين رمشاء وقد ارمش؛ وبه رمش اي برش:- وارمش الشجر:- اورق كأربش وقال ابن الاعرابي أرمش أخرج ثمره كالحمص، وارض رمشاء: كثيرة العشب كرسماء) / رَمْشَة / طرفة عين, لمح البصر (وقت قصير جداً (مثل الوقت الذي تستغرقه العين لتطرف))\nمثال: سأفعل ذلك في لمح البصر",
 "まだたく": "لَأْلَأَ (لَمَعَ، أَشْرَقَ؛ (استخدام مجازي) اغْرَوْرَقَتْ الدُّمُوع) / رَمَشَ (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء وعين رمشاء وقد ارمش؛ وبه رمش اي برش:- وارمش الشجر:- اورق كأربش وقال ابن الاعرابي أرمش أخرج ثمره كالحمص، وارض رمشاء: كثيرة العشب كرسماء) / رَمْشَة",
 "まだに": "قراد صلب (قراد له درع صلب على الظهر وأجزاء فم تبرز من الرأس)",
 "まだまだ": "سَاكِن, ثَابِت / سَاكِنًا / لَا يَزَال, مَا زَالَ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها) / رَغِم ذٰلِك, مَعَ ذٰلِك ((رَغَمَ) رَغْمًا، ومَرْغَمًا، ومَرْغَمَةً: ذَلَّ؛ (رَغَمَ) ذل عن كَرْه. يقال (رغَمَ) أَنْفُه)\nمثال: لا أحب المدرسة.",
 "まだら": "ماندالا (أي من التصاميم الهندسية المختلفة (عادة دائرية) ترمز للكون؛ تستخدم بشكل رئيسي في الهندوسية والبوذية كأداة مساعدة للتأمل) / قد المحيط الهادئ (يرتبط ارتباطاً وثيقاً بالقد الأطلسي) / أجسام طافية, ذباب طائر (بقع أمام العينين تسببها شظايا خلايا معتمة في الجسم الزجاجي والعدسة)\nمثال: تبدو الأجسام الطافية وكأنها تنجرف عبر مجال الرؤية / مُرَشَّش, مُنَقَّط (ذو نقش من النقاط)",
 "まだらうま": "حِمَار وَحْشِيّ, حِمَار وَحْشِيّ مُخَطَّط (حَيْوَان مُسْتَأْنَس من الجِنْس الذي ينتمي اليه الحِصَان (انظر الصورة). مؤنثه أَتَان؛ صفة تَحْقِيْر تطلق على الغَبِيّ أو الأَحْمَق. مؤنثه حِمَارَة)\nمثال: هن بحاجة لحمار.",
 "まだらしみ": "سمكة النار (تعيش في المناطق الرطبة الدافئة مثل حول الأفران)",
 "まだらたるみ": "صورة أبيض وأسود, صورة أحادية اللون (صورة فوتوغرافية أو شريحة بالأبيض والأسود) / تَوَاصُل كِتَابِيّ, لُغَة مَكْتُوبَة (التواصل بوساطة رموز مكتوبة، سواء أكانت مطبوعة أم مخطوطة)",
 "まだらとびえい": "لخمة النسر المرقطة (لخمة ظهرها مغطى ببقع بيضاء أو صفراء؛ واسعة الانتشار في البحار الدافئة)",
 "まだらとびエイ": "لخمة النسر المرقطة (لخمة ظهرها مغطى ببقع بيضاء أو صفراء؛ واسعة الانتشار في البحار الدافئة)",
 "まだるい": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "まだるっこい": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "まだるっこしい": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "まだん": "دواء ناجع, رصاصة سحرية (علاج (دواء أو علاج أو وقائي) يشفي أو يمنع المرض)\nمثال: لا توجد رصاصة سحرية ضد السرطان",
 "まち": "مَدِينَة, قَرْيَة / وَسَطُ البَلَد / شَارِع, زَنَقَة / انتظار, تَرَقُّب (فعل الانتظار (البقاء دون نشاط في مكان واحد توقعاً لشيء ما)) / رَهْنَ الإِشَارَة, مُنْتَظِر (جاهز ومتاح للاستخدام في أيّ وقت)\nمثال: كان الانتظار محنة بالنسبة له / رقعة, وصلة تقوية (قطعة من المادة تستخدم لتقوية أو توسيع الثوب) / صفيحة تقوية (صفيحة معدنية تستخدم لتقوية الرافدة) / رقعة زردية, وصلة درعية (قطعة من الزرد تغطي مكاناً غير محمي بالدرع الصفائحي)",
 "まちあい": "لِقَاء مُحَدَّد, مَوْعِد (اجتماع مخطط له في وقت ومكان معينين) / لقاء, موعد غرامي (موعد؛ عادة مع شخص من الجنس الآخر) / مكان اللقاء, ملتقى (مكان يلتقي فيه الناس)\nمثال: كان ينتظرهم في مكان اللقاء / غُرْفَةُ الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة. / مكان اجتماع, منتدى (منشأة عامة للاجتماع للمناقشة المفتوحة)",
 "まちあいしつ": "غُرْفَةُ الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "まちあいじょ": "مَلَاذ (مَلْجَأ، مَأْوَى) / مَخْلَص (الشخص الذي يفي ولا يخون)\nمثال: كان الغطاء النباتي الكثيف لمستنقعات المنغروف يوفر ملاذ آمنا للحيوانات الصغيرة التي تفر من المفترسين. / غُرْفَةُ الاِنْتِظَار (اسم مفعول لما غُرِفَ من الماء وغيره باليد، الجمع غِرَاف؛ اسم؛ المكان في الدار أو المبنى محاط بأربع جدران وسقف، حُجْرَة، عِلِّيَّة. الجمع وغُرَف وغُرُفَات)\nمثال: الأب في الغرفة.",
 "まちあいぢゃや": "مكان اجتماع, منتدى (منشأة عامة للاجتماع للمناقشة المفتوحة)",
 "まちあわせ": "مَوْعِد, مِيعَاد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "まちあわせばしょ": "مكان اجتماع, منتدى (منشأة عامة للاجتماع للمناقشة المفتوحة)",
 "まちあわせる": "لِقَاء مُحَدَّد, مَوْعِد (اجتماع مخطط له في وقت ومكان معينين) / لقاء, موعد غرامي (موعد؛ عادة مع شخص من الجنس الآخر) / مكان اللقاء, ملتقى (مكان يلتقي فيه الناس)\nمثال: كان ينتظرهم في مكان اللقاء",
 "まちうけ": "انتظار, تَرَقُّب (فعل الانتظار (البقاء دون نشاط في مكان واحد توقعاً لشيء ما)) / رَهْنَ الإِشَارَة, مُنْتَظِر (جاهز ومتاح للاستخدام في أيّ وقت)\nمثال: كان الانتظار محنة بالنسبة له / وَرَق حَائِط, خَلْفِيَّة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "まちうけがぞう": "وَرَق حَائِط, خَلْفِيَّة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "まちうけがめん": "وَرَق حَائِط, خَلْفِيَّة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "まちうける": "اِنْتَظَرَ, اِسْتَأْنَى (تَرَقَّبَ؛ تَوَقَّعَ)\nمثال: انتظر حتى أجلس.",
 "まちかご": "حَمَّالَة, مِحَفَّة",
 "まちかた": "مَدِينَة, قَرْيَة",
 "まちかど": "زاوِيَةِ, نَاصِيَة",
 "まちかまえる": "اِنْتَظَرَ (تَرَقَّبَ؛ تَوَقَّعَ)\nمثال: انتظر حتى أجلس.",
 "まちが": "وَرَق حَائِط, خَلْفِيَّة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "まちがい": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي. / حَادِث / مُصَادَفَة, صُدْفَة / صُدْفَة, صِدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة. / زلة, هفوة (إساءة بسيطة) / رعونة, طيش (سمة الافتقار للحصافة)",
 "まちがいでんわ": "رَقْم غَيْر صَحِيح (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقْم خَاطِئ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: سجلت رقم هاتفه.",
 "まちがいない": "أَكِيد / مُتَأَكِّد / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مُحَدَّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: لديك بعض الكتب. / مَوْثُوق",
 "まちがいなく": "بوضوح (بدون شك أو تساؤل) / بشكل متميز, بوضوح (واضح للعقل؛ بتمييز عقلي واضح) / بشكل مفهوم, بوضوح (بطريقة يمكن فهمها) / بِوُضُوح (بطريقة يسهل إدراكها)\nمثال: كانوا تائهين بوضوح",
 "まちがいなし": "أَكِيد / مُتَأَكِّد / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مُحَدَّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: لديك بعض الكتب.",
 "まちがう": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ. / أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "まちがえ": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي. / حَادِث / مُصَادَفَة, صُدْفَة / صُدْفَة, صِدْفَة (الصدفة. جمع: صُدُفات و صُدْفات و صُدَف٬ هي تزامن غير متوقع لحدوث فعلين بدون تخطيط مسبق، رآه صُدْفةً…)\nمثال: لا تدعها للصدفة. / زلة, هفوة (إساءة بسيطة) / رعونة, طيش (سمة الافتقار للحصافة)",
 "まちがえでんわ": "رَقْم غَيْر صَحِيح (وضع أرقامًا على شيء ما للتنظيم أو التمييز) / رَقْم خَاطِئ (وضع أرقامًا على شيء ما للتنظيم أو التمييز)\nمثال: سجلت رقم هاتفه.",
 "まちがえる": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب))\nمثال: اعترف أنه أخطأ. / أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "まちがっても": "مَهْمَا",
 "まちきん": "مرابٍ (شخص يقرض المال بأسعار فائدة مفرطة)",
 "まちぎ": "ملابس خروج (ملابس عادية مناسبة للظهور العام (بخلاف الأزياء التنكرية أو الملابس الرياضية أو ملابس العمل وما إلى ذلك))",
 "まちぎょうれつ": "طابُور, صَفّ (وَحْدة عسكريَّة تضمّ عِدَّة سَرايا) / وَقَفَ فِي الصَّفّ (قَامَ، اِنْتَصَبَ، نَهَضَ؛ ثَبَتَ)\nمثال: كانا واقفين في طابور.",
 "まちぐみ": "ذُو سِيَادَة, مُسْتَقِلّ ((عَنِ الكِيَانَات السِّيَاسِيَّة) غَيْر خَاضِع لِسَيْطَرَة قُوًى خَارِجِيَّة)",
 "まちこがれる": "اِشْتَاقَ",
 "まちじかん": "كمون (حالة كونه غير ظاهر أو نشط بعد) / كمون, وقت الاستجابة (الوقت الذي ينقضي بين المثير والاستجابة له) / كمون الدوران ((في علم الحاسوب) الوقت الذي يستغرقه كتلة بيانات محددة على مسار البيانات للدوران نحو رأس القراءة/الكتابة)",
 "まちじゅう": "جَمِيع أَنْحَاء, كُلّ",
 "まちすじ": "شَارِع, زَنَقَة",
 "まちちゅうか": "دكان صغير, مكان صغير منعزل (مكان صغير متواضع وبعيد عن الأنظار)\nمثال: كان مكتبه عبارة عن مكان صغير منعزل",
 "まちづくり": "تخطيط حضري, تخطيط مدن (تحديد ووضع خطط للترتيب المادي المستقبلي وحالة المجتمع السكني)",
 "まちどうしい": "مُتَوَقّ إِلَيْه, مُشْتَاق إِلَيْه (مرغوب فيه بشدّة وشوق عظيم)",
 "まちどおしい": "مُتَوَقّ إِلَيْه, مُشْتَاق إِلَيْه (مرغوب فيه بشدّة وشوق عظيم)",
 "まちどしより": "عضو مجلس بلدي (عضو ذكر في هيئة تشريعية بلدية (مثل مجلس المدينة))",
 "まちなか": "وَسَطُ البَلَد",
 "まちなみ": "شَارِع, زَنَقَة",
 "まちにん": "أهل البلدة, سكان البلدة (الناس الذين يعيشون في بلدية أصغر من المدينة)\nمثال: هتفت البلدة بأكملها للفريق",
 "まちのおんな": "عاهرة شوارع (عاهرة تجذب الزبائن بالمشي في الشوارع)",
 "まちはずれ": "أطراف, ضواحي (المناطق الخارجية (كما في مدينة أو بلدة))\nمثال: عاشوا في ضواحي هيوستن",
 "まちぶせ": "كَمين / كَمِين",
 "まちぶせる": "كَمين / كَمِين",
 "まちまち": "مُخْتَلِف, مُتَنَوَّع / شَارِع, زَنَقَة",
 "まちもうける": "تَوَقَّعَ",
 "まちやくば": "بَلَدِيَّة",
 "まぢ": "جِدِّيّ / جَدِّيّ, جَادّ",
 "まぢか": "قَرِيب / قَرِيبًا / بِٱلْقُرْب مِنَ, عِنْدَ / قَرُبَ (أَدْنَى؛ قدَّرَ)\nمثال: جلست بالقرب منها.",
 "まっか": "قرمزي, ياقوتي (لون أحمر عميق وزاهٍ) / تماماً, كلياً / صِرْف, مَحْض (تامّ بلا تحفّظ أو تقييد؛ يُستخدم أحيانًا مُكثِّفًا غير رسميّ) / صَرِيح, مُبَاشِر (يتَّسم بالصراحة الواضحة والمباشرة)\nمثال: هو غير صادق تماماً",
 "まっかっか": "قرمزي, ياقوتي (لون أحمر عميق وزاهٍ) / تماماً, كلياً / صِرْف, مَحْض (تامّ بلا تحفّظ أو تقييد؛ يُستخدم أحيانًا مُكثِّفًا غير رسميّ) / صَرِيح, مُبَاشِر (يتَّسم بالصراحة الواضحة والمباشرة)\nمثال: هو غير صادق تماماً",
 "まっき": "اَلْعَامَ اَلْمَاضِيَ, اَلسَّنَةَ ٱلْمَاضِيَةَ",
 "まっきてき": "فِي مَرْحَلَة مُتَأَخِّرَة, نِهَائِيّ (يُسَبِّب أَوْ يَنْتَهِي بِالمَوْت أَوْ يَقْتَرِب مِنْه) / أَخِير, خِتَامِيّ (يَقَعُ فِي نِهَايَةِ شَيْءٍ أَوْ يُشَكِّلُ خَاتِمَتَهُ) / طرفي, نهائي (كائن أو واقع في النهاية أو الطرف) / دوري, فصلي (متعلق بـ أو يحدث في فصل دراسي أو فترة زمنية محددة)\nمثال: العمود الطرفي",
 "まっくら": "حَالِك, دَامِس (شَدِيد الظُّلْمَة لِأَقْصَى دَرَجَة)",
 "まっくらやみ": "حلكة, سواد (الغياب التام للضوء)\nمثال: تحسسوا طريقهم في ظلام دامس",
 "まっくろ": "حَالِك, دَامِس (شَدِيد الظُّلْمَة لِأَقْصَى دَرَجَة) / أَسْوَد حَالِك, أَسْوَد فَاحِم (بأشد درجات السواد؛ كلون الفحم الحجري أو القار) / مُسَخَّم, مُغَطًّى بِالسُّخَام (مُغطّى بالسُّخام أو ما يشبهه)",
 "まっくろい": "أبنوسي, أسود حالك (أسود داكن جداً)",
 "まっくろけ": "أبنوسي, أسود حالك (أسود داكن جداً)",
 "まっこう": "بَخُور (البَخُور : ما يتبخَّر به من عُودٍ ونحوه؛ الدخان أو الرائحة الناتجة من احتراق مادة عطرية) / بُخُور (البَخُور : ما يتبخَّر به من عُودٍ ونحوه؛ الدخان أو الرائحة الناتجة من احتراق مادة عطرية)",
 "まっこうから": "جَبْهِيّ, مُوَاجِه (يلتقي وجهاً لوجه بشكل مباشر) / بمقدمته, وجهاً لوجه (مع المقدمة أولاً) / بشكل مباشر, بمواجهة (في معارضة مباشرة؛ مباشرة) / مُبَاشِر, مُوَاجِه (يتَّسم بالمعارضة المباشرة وجهاً لوجه)\nمثال: اصطدمت السيارات وجهاً لوجه",
 "まっこうくじら": "حُوتُ الْعَنْبَر (سمكة صَغيرة كانت أو كبيرة؛ حوت كبير: صاحب مال وسَطْوَة ونفوذ)\nمثال: هل الحوت من الثدييات؟",
 "まっこうしょうぶ": "جَبْهِيّ, مُوَاجِه (يلتقي وجهاً لوجه بشكل مباشر) / بمقدمته, وجهاً لوجه (مع المقدمة أولاً) / بشكل مباشر, بمواجهة (في معارضة مباشرة؛ مباشرة) / مُبَاشِر, مُوَاجِه (يتَّسم بالمعارضة المباشرة وجهاً لوجه)\nمثال: اصطدمت السيارات وجهاً لوجه",
 "まっこと": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا .",
 "まっさいちゅう": "فِي مُنْتَصَف, وَسْطَ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "まっさお": "أَزْرَق سَمَاوِيّ, لَازَوَرْدِيّ (ذو لون أزرق عميق مائل إلى البنفسجيّ كسماء أكتوبر الصافية) / بَاهِت, ذَابِل (خفيف اللون وضعيفه؛ يفتقر إلى الحيويّة) / بَاهِت, شَاحِب (ذو لون خفيف وضعيف يفتقر إلى العمق) / خَافِت, شَاحِب ((للضوء) ضعيف الشدة أو السطوع؛ خافت وباهت)",
 "まっさかさま": "بتهور, رأساً على عقب (في عجلة مضطربة)\nمثال: ركضنا بتهور نحو الملجأ",
 "まっさき": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "まっさきに": "أَوَّلًا, قَبْلَ كُلِّ شَيْءٍ",
 "まっさつ": "حذف (حَذَفَ الشّيء:قطعه وأَسْقَطَه. حَذَفَ الْمُرَاجِعُ عِبَارَةً منَ الْخِطَابِ؛ حَذَفَهُ بِالعَصَا: ضَرَبَهُ ، ورَمَاهُ بِها)\nمثال: حذف ياني حسابه. / رَدّ (صَرَفَ، أَرْجَعَ؛ أَعَادَ، أَرْجَعَ. (يتعدى بإلى)) / نَفْي / إِنْكَار, رَفْض\nمثال: اليوم هناك برد. / شطب, محو (الحذف عن طريق الشطب أو المسح) / كشط, محو (منطقة سطح تم محو شيء منها) / شطب, محو (تصحيح يتم عن طريق المسح)\nمثال: تمت كتابة كلمة أخرى فوق المحو",
 "まっさなか": "فِي مُنْتَصَف, وَسْطَ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "まっさら": "طَازَج, طَازَة / عَذْب",
 "まっしかく": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "まっしぐら": "رَأْسًا عَلَى عَقِب, مُنْدَفِع (بالرأس أولاً نحو الأمام) / برأسه أولاً, مندفعاً (بالرأس قبل الجسم) / باندفاع, بتهور (بطريقة متسرعة ومتهورة) / باندفاع, بسرعة جنونية (بسرعة خطرة جداً)\nمثال: انزلق العداء برأسه أولاً نحو القاعدة الثالثة",
 "まっしょう": "شطب, محو (الحذف عن طريق الشطب أو المسح) / كشط, محو (منطقة سطح تم محو شيء منها) / شطب, محو (تصحيح يتم عن طريق المسح)\nمثال: تمت كتابة كلمة أخرى فوق المحو / طَرَف / بَقْشِيش / بَقْشِيش, بَخْشِيش / إِخْبَارِيَّة / نَصِيحَة / تفاهة, شيء تافه (شيء قليل الأهمية) / أمر تافه, تفاهة (تفصيل يعتبر غير مهم) / ترافل (بودينغ بارد مصنوع من طبقات من الكعك الاسفنجي المدهون بالفاكهة أو الجيلي؛ وقد يُزين بالمكسرات أو الكريمة أو الشوكولاتة)",
 "まっしょうしんけいけい": "الجهاز العصبي المحيطي (قسم الجهاز العصبي الذي يقع خارج الدماغ والحبل الشوكي)",
 "まっしょうじき": "صَرِيح, مُسْتَقِيم",
 "まっしょうせい": "طَرَفِيّ, مُحِيطِيّ (على أو بالقرب من حافة أو يشكل حداً خارجياً؛ المنطقة الخارجية) / طَرَفِيّ, هَامِشِيّ (مرتبط بالقضية الرئيسية لكنّه ليس ذا أهمية محورية) / جهاز طرفي, ملحق حاسوبي (معدات إلكترونية خارجية عن لوحة الدائرة التي تحتوي على وحدة المعالجة المركزية للكمبيوتر)\nمثال: المقاطعات الطرفية لروسيا",
 "まっしょうてき": "تافِه",
 "まっしろ": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "まっしん": "النُّقْطَة المَيِّتَة (موضع المرفق عندما يكون على خط واحد مع ذراع التوصيل ولا يبذل عزم دوران)",
 "まっすぐ": "مُسْتَقِيم (ما جُعِلَ قَائِمًا غير مُنْحَنٍ؛ ما ليس به عِوَج) / عَلَى طُول (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: إرسم خط مستقيم. / صَرِيح, مُسْتَقِيم",
 "まっせき": "قَاع (أَرْض مستوية سهلة تنصب إِليها مياه الأمطار فتمسكها ثم تُنبت العشب؛ القَعْر) / قَعْر / سَالِب\nمثال: نمت في قاعة السينما.",
 "まっせつ": "عَرَضِيّ, هَامِشِيّ (ليس ذا أهمية مركزية أو أوّلية) / شيء ثانوي, غير ضروري (أي شيء ليس أساسياً)\nمثال: تخلصوا من جميع الأشياء غير الضرورية",
 "まっそん": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "まったい": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري. / أَمِين, سَالِم (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ) / خَزْنَة حَدِيدِيَّة, خَزْنَة\nمثال: هو غبي وغير أمين.",
 "まったき": "كَمَال, إتقان",
 "まったく": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا . / بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك) / بالفعل, جداً (في الحقيقة (غالباً ما تميل إلى التوكيد))\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "まったくする": "أَدَّى",
 "まったくといっていいほど": "أبداً",
 "まったくのところ": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان مقتنعاً كلياً",
 "まったくもって": "فِي الْحَقِيقَة (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "まっただなか": "النُّقْطَة المَيِّتَة (موضع المرفق عندما يكون على خط واحد مع ذراع التوصيل ولا يبذل عزم دوران) / فِي مُنْتَصَف, وَسْطَ (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "まったなし": "لم يعد (ليس الآن)",
 "まったり": "غَنِيّ / رَائِق, هَادِئُ الطَّبْع (غَيْرُ مُسْتَعْجِلٍ وَمُسْتَرْخٍ)",
 "まったん": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / الأفراد, الجنود العاديون (الأعضاء العاديون في منظمة (مثل الجنود المجندين في الجيش)) / القواعد, عامة الأعضاء (الناس الذين يشكلون الجسم الرئيسي لأي مجموعة)\nمثال: تم دعم الإضراب من قبل أفراد النقابة",
 "まったんかかく": "سعر التجزئة (السعر الإجمالي المفروض على منتج يُباع للعميل، ويشمل تكلفة المصنع بالإضافة إلى هامش ربح التجزئة)",
 "まったんきょだいしょう": "ضخامة النهايات (تضخم عظام اليدين والقدمين والوجه؛ غالباً ما يكون مصحوباً بصداع وآلام في العضلات واضطرابات عاطفية؛ ناتج عن الإفراط في إنتاج هرمون النمو من الفص…)",
 "まったんしょうひしゃ": "مستخدم نهائي",
 "まったんひだいしょう": "ضخامة النهايات (تضخم عظام اليدين والقدمين والوجه؛ غالباً ما يكون مصحوباً بصداع وآلام في العضلات واضطرابات عاطفية؛ ناتج عن الإفراط في إنتاج هرمون النمو من الفص…)",
 "まっちゃ": "مَاتْشَا",
 "まっちゃアイスクリーム": "شَايْ أَخْضَر (شَجَرَة خَضْرَاء من فَصِيلَة الكَامِيلِيات لها أزْهَار بَيْضَاء، وتُعْطِي أوراقاً يصنع منها شَرَاب مُنَبِّه؛ أوراق الشجرة المجففة)\nمثال: صب الشاي لضيفك.",
 "まっとう": "سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب / بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان مقتنعاً كلياً",
 "まっとうする": "أَدَّى",
 "まっぱ": "فِرْقَة / مَذْهَب (المَذْهَب : بمعنى الذَهْاب، السَيْر، المَسْلَك، الإزَالَة؛ المَذْهَب: المُعْتَقَد الديني الذي يُذهب إليه) / طائِفَة (مؤنث طَائِف؛ التي تطوفُ؛ القطعة أو الجزء من الشيء أو الواحدة منه) / نِحْلَة\nمثال: الوجودية مذهب إنساني. / عُرْي / عَارٍ تَمَاماً ((غير رسمي) عارٍ تماماً بلا أي ملابس)",
 "まっぱい": "تابع, مرؤوس (مساعد خاضع لسلطة أو سيطرة آخر)",
 "まっぱだか": "عُرْي / عَارٍ تَمَاماً ((غير رسمي) عارٍ تماماً بلا أي ملابس)",
 "まっぴつながら": "أخيراً وليس آخراً",
 "まっぴら": "بأي حال, تحت أي ظرف (تحت أي ظرف من الظروف)\nمثال: لن تتخلى عن حيواناتها الأليفة بأي حال",
 "まっぽ": "شُرْطِيّ (أحد المنتسبين إلى الشُرْطَة) / اِسْت (فتحة الدُبُر أو مقعد الإنسان؛ الأصل والأساس) / شَرْج",
 "まっ先": "رَئِيس, رَئِيسَة / رَئِيس / اِتَّجَهَ",
 "まっ先に": "أَوَّلًا, قَبْلَ كُلِّ شَيْءٍ",
 "まっ四角": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "まっ白": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "まっ裸": "عُرْي / عَارٍ تَمَاماً ((غير رسمي) عارٍ تماماً بلا أي ملابس)",
 "まっ赤": "قرمزي, ياقوتي (لون أحمر عميق وزاهٍ) / تماماً, كلياً / صِرْف, مَحْض (تامّ بلا تحفّظ أو تقييد؛ يُستخدم أحيانًا مُكثِّفًا غير رسميّ) / صَرِيح, مُبَاشِر (يتَّسم بالصراحة الواضحة والمباشرة)\nمثال: هو غير صادق تماماً",
 "まっ赤っ赤": "قرمزي, ياقوتي (لون أحمر عميق وزاهٍ) / تماماً, كلياً / صِرْف, مَحْض (تامّ بلا تحفّظ أو تقييد؛ يُستخدم أحيانًا مُكثِّفًا غير رسميّ) / صَرِيح, مُبَاشِر (يتَّسم بالصراحة الواضحة والمباشرة)\nمثال: هو غير صادق تماماً",
 "まつ": "شجرة الصنوبر, صنوبر (شجرة صنوبرية) / اِنْتَظَرَ (تَرَقَّبَ؛ تَوَقَّعَ)\nمثال: انتظر حتى أجلس. / اِنْتَظَرَ, اِسْتَأْنَى (تَرَقَّبَ؛ تَوَقَّعَ)\nمثال: انتظر حتى أجلس. / حَاجَة, ضَرُورَة / اِحْتَاجَ / النِهاية / بُودْرَة",
 "まつえ": "مَاتْسُوي",
 "まつえい": "سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "まつかえ": "شجرة مخروطية, صنوبريات (أي شجرة أو شجيرة عارية البذور تحمل مخاريط) / وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد) / رَسْم (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ)\nمثال: لا شكر على واجب.",
 "まつかさ": "كُوز الصَنَوْبَر (إناء شرب بعُرْوَة)",
 "まつかざり": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "まつげ": "رِمْش, هُدْب (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء وعين رمشاء وقد ارمش؛ وبه رمش اي برش:- وارمش الشجر:- اورق كأربش وقال ابن الاعرابي أرمش أخرج ثمره كالحمص، وارض رمشاء: كثيرة العشب كرسماء)",
 "まつじつ": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "まつじつせいと": "قديس الأيام الأخيرة, مورموني (عضو في كنيسة يسوع المسيح لقديسي الأيام الأخيرة)",
 "まつじつせいとイエスキリストきょうかい": "كنيسة المورمون, كنيسة يسوع المسيح لقديسي الأيام الأخيرة (كنيسة أسسها جوزيف سميث عام 1830 ومقرها الرئيسي في سولت ليك سيتي، يوتا)",
 "まつぞう": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "まつだい": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد. / ثلاثية الذيل (سمكة غذائية كبيرة في المياه الدافئة حول العالم لها زعانف شرجية وظهرية طويلة توحي مع الزعنفة الذيلية بذيل ثلاثي الفصوص)",
 "まつだいまで": "إِلَى الْأَبَد (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: تعال إلى منزلي.",
 "まつだん": "النِهاية",
 "まつのうち": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "まつのき": "شجرة الصنوبر, صنوبر (شجرة صنوبرية)",
 "まつのきひわ": "حسون الصنوبر (عصفور صغير يعيش في الغابات الصنوبرية بأمريكا الشمالية)",
 "まつのは": "تَذْكار",
 "まつのみ": "حَبّ صَنَوْبَر (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع)\nمثال: زيري بحب المال.",
 "まつばづえ": "عُكَّاز, عُكَّازَة",
 "まつばらん": "سرخس الخفاقة (نباتات تشكل كتلاً استوائية بشكل رئيسي ذات مظهر هيكلي يشبه مكانس الخفق؛ تفتقر إلى الجذور)",
 "まつび": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري.",
 "まつぼっくり": "كُوز الصَنَوْبَر (إناء شرب بعُرْوَة)",
 "まつぽっくり": "كُوز الصَنَوْبَر (إناء شرب بعُرْوَة)",
 "まつむしそう": "جربن, سكابيوسا (أي من نباتات متنوعة من جنس سكابيوسا)",
 "まつやに": "رَاتِينَج, صُرْع",
 "まつやま": "مَاتْسُويَامَا",
 "まつゆきそう": "شقائق النعمان الحرجية, قطرة الثلج (شقائق نعمان شائعة في شرق أمريكا الشمالية بزهور بيضاء وحيدة مشوبة بالوردي)",
 "まつよいぐさ": "أخدرية, زهرة الربيع المسائية",
 "まつよう": "نِهَايَة, غَايَة / غَايَة / اِنْتَهَى, أَنْهَى (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات)\nمثال: انتهى أمر زيري. / سَلِيل (صِفَة ثابتة للمفعول من الفعل سلَّ؛ يَنْحَدِرُ مِنْ نَسْلٍ شَرِيفٍ)",
 "まつり": "عِيد, مَهْرَجَان / مُتَّقِد, مُلْتَهِب (عاطفيّ أو سريع الغضب) / اشتعال, حريق (عملية احتراق المواد القابلة للاشتعال منتجة حرارة وضوءاً ودخاناً (غالباً))\nمثال: كانت النار واحدة من أولى اكتشافات أسلافنا / نوبة جنون, هياج (حالة من الهياج العقلي العنيف) / فُلّ (فَلُّ السَّيْفِ: كَسْرٌ فِي حَدِّهِ؛ فَلُّ الْحَدِيدِ أَوِ الفِضَّةِ أَوِ الذَّهَبِ أَوِ النَّارِ : مَا تَنَاثَرَ مِنْ ذَلِكَ)",
 "まつりあげる": "عِبَادَة / عَبَدَ, سَجَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / سَجَدَ (وَضَعَ جَبْهَتَهُ عَلَى ٱلْأَرْضِ)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟ / تَمَلَّقَ, تَبَصْبَصَ",
 "まつりか": "فُلّ (فَلُّ السَّيْفِ: كَسْرٌ فِي حَدِّهِ؛ فَلُّ الْحَدِيدِ أَوِ الفِضَّةِ أَوِ الذَّهَبِ أَوِ النَّارِ : مَا تَنَاثَرَ مِنْ ذَلِكَ)",
 "まつりごと": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه) / حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: ذكرني بالقانون.",
 "まつりごとどころ": "مكتب حكومي (مكتب يعمل فيه موظفو الحكومة)",
 "まつりさわぎ": "احتفال, مهرجان (أي نشاط ترفيهي بهيج)",
 "まつりぬい": "غرزة لقط, غرزة مخفية (غرزة فضفاضة تلتقط خيطاً أو خيطين فقط من القماش؛ مصممة لتكون غير مرئية من الجانب الصحيح)",
 "まつりゅう": "أحفاد, ذُرِّيَّة (كل نسل سلف معين)\nمثال: علينا تأمين فوائد الحرية لأنفسنا ولذريتنا",
 "まつり縫い": "غرزة لقط, غرزة مخفية (غرزة فضفاضة تلتقط خيطاً أو خيطين فقط من القماش؛ مصممة لتكون غير مرئية من الجانب الصحيح)",
 "まつる": "أَلَّهَ (أَلِهَ فلانٌ يَأْلَهُ إِلاَهَةً، وأُلُوهَةً، وألوهِيّةً: تحيَّر؛ أَلِهَ أَلَهًا: تَحيَّرَ) / صَلَّى, دَعَا / اِقْتِرَاح / اِقْتَرَحَ, قَدَّمَ (اِبْتَدَعَ ٱلشَّيْءَ مِنْ ذَاتِ نَفْسِهِ مِنْ غَيْرِ أَنْ يَسْمَعَهُ؛ اِخْتَارَ) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: اقترح سامي المساعدة.",
 "まつろ": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "まつろわぬ": "أبي, غير خاضع (غير خانع أو خاضع)",
 "まつわりつく": "تَمَسَّكَ",
 "まつわる": "خَصَّ (رمى شيئًا صغيرًا، مثل الحصى، بدقة وبسرعة؛ قذف شيئًا بعيدًا بحركة سريعة) / هَمَّ\nمثال: لخص التقرير في صفحة.",
 "まつ毛": "رِمْش, هُدْب (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء وعين رمشاء وقد ارمش؛ وبه رمش اي برش:- وارمش الشجر:- اورق كأربش وقال ابن الاعرابي أرمش أخرج ثمره كالحمص، وارض رمشاء: كثيرة العشب كرسماء)",
 "まてがい": "محار الموس (محار بحري له صدفة رقيقة منحنية ضيقة طويلة)",
 "まてき": "آسِر, سَاحِر (يأسر الاهتمام كأنّه يسحر سحرًا) / جَهَنَّمِيّ, شَيْطَانِيّ (بالغ الشر أو القسوة؛ يُعبِّر عن الوحشية أو يليق بالجحيم)",
 "まてどくらせど": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "まてんろう": "نَاطِحَة سَحَاب",
 "まで": "حَتَّى (يفيد انتهاء الغاية؛ يفيد الغاية) / حَتَّى, إِلَى أَنْ (يفيد انتهاء الغاية؛ يفيد الغاية)\nمثال: انتظر حتى أجلس. / أَنّ (يفيد التوكيد) / إِلَى, عَلَى (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: كيف لي أن أعرف؟ / وَحِيد / فَقَط (لا أكثر، لا غير) / مثال: فقط تنفس طبيعي.",
 "までに": "بِجَانِب, جنب (بجانب) / عِنْدَ, فِي (يُفِيدُ الحضور أو وجود صلة أو علاقة مثل الانتماء والامتلاك. (ظرف مكان)؛ يُفِيدُ قُرْبَ الشيء. (ظرف مكان)) / مِن قِبَل, بِوَاسِطَّة (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / بِوَاسِطَّة, لِـ\nمثال: زيري بجانب الحوض.",
 "までも": "أَنّ (يفيد التوكيد) / إِلَى, عَلَى (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية)\nمثال: كيف لي أن أعرف؟ / هُنَاكَ, يُوجَدُ",
 "までもない": "هُنَاكَ, يُوجَدُ",
 "まと": "دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين. / عُرْضَة, شَيْء / هَدَف (جاء إلى الهَدَف؛ ارتفع عن الأرض) / مَفْعُول بِهِ, مَفْعُول (كناية عن الذي فُعِلَ به فاحشة اللواط. المَلُوطُ به) / كَائِن\nمثال: لقد أخطأ الهدف. / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه.",
 "まとう": "لَبِسَ, اِرْتَدَى (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب)\nمثال: لبس سروالا نظيفا.",
 "まとうだい": "ضوري مذهب",
 "まとだま": "الكرة المستهدفة (كرة البلياردو التي يقصد أن تكون أول كرة تضربها الكرة البيضاء)",
 "まとはずれ": "عَرَضِيّ",
 "まとば": "منطقة الهدف (موقع الهدف المراد إصابته)",
 "まとまった": "كَبِير, وَاسِع (ضد الصغير؛ العظيم الحَجْم؛ ضد الصغير؛ المتقدم في السِنّ)\nمثال: ذاك البيت كبير. / مَعْرِفَة (مصدر من الفعل عَرَفَ؛ ضد الجهل؛ إدراك الشيء بحقيقته والوعي، ضد الجهل بالشيء)\nمثال: نريد معرفة السبب.",
 "まとまり": "وَحْدَة, اِتِّحَاد / مُسْتَعْمَرَة, مُسْتَوْطَنَة",
 "まとめ": "خُلَاصَة, مُلَخَّص",
 "まとめあげる": "تجميع (مصدر جَمَّعَ)",
 "まとめて": "بغتة, فجأة (بشكل مفاجئ) / في آن واحد, معاً (الجميع في نفس الوقت)\nمثال: فجأة، بدأ بالصراخ",
 "まとめやく": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "まとめる": "جَمَعَ (ضَمَّ، لَمَّ، حَشَدَ؛ في : أَضَافَ أعدادا إلى غيرها)\nمثال: جمع خيل هو خيول. / لَخَّصَ, اِخْتَصَرَ / أَنْهَى / قَرَّرَ, صَمَّمَ / قَرَّرَ",
 "まとめ上げる": "تجميع (مصدر جَمَّعَ)",
 "まとめ役": "حلقة وصل, وسيط (مفاوض يعمل كحلقة وصل بين الأطراف)",
 "まとも": "جَبْهَة / أَمَامِيّ / نَزِيه, صَادِق",
 "まともに": "يَمِين, يمين / صَحِيح, صَوَاب / قَائِم / عَلَى اَلْيَمِين (يفيد الاستعلاء؛ يفيد التعليل) / إِلَى اَلْيَمِين (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / صحيح, تمام / حَقّ, حُقُوق (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له) / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: أجب على السؤال. / كَمَا يَجِب, كَمَا يَنْبَغِي / بِصَراحة",
 "まとわりつく": "تَمَسَّكَ",
 "まとをしぼる": "بُؤْرَة",
 "まど": "نَافِذَة, شُبَّاك / نَافِذَة, ويندو",
 "まどい": "خِدَاع, ضَلَالَة / غَرُور",
 "まどう": "هَرْطَقَة, بِدْعَة / سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية)\nمثال: هذا هو سحر الجزائر. / الجحيم, العالم السفلي ((الأديان) عالم الموتى)\nمثال: لا أحد يذهب إلى هاديس بكل ثروته الهائلة / اُغْرُب عَن وَجْهِي!, إِبْتَعِد عَنِّي! / ضَلَّ الطَّرِيق",
 "まどうし": "سَاحِر",
 "まどうしょ": "غريموار, كتاب تعاويذ (دليل للسحر الأسود (لاستحضار الأرواح والشياطين))",
 "まどか": "مُسْتَدِير, مُدَوَّر (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / مُسْتَدِير, كُرَوِيّ (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما) / جَوْلَة, مَرْحَلَة / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / رَاكِد, سَاجٍ ((عَنْ جِسْمٍ مَائِيّ) خَالٍ مِنَ الاضْطِرَاب بِسَبَب الأَمْوَاج الكَبِيرَة) / سَاكِن, هَادِئ (غير مضطرب؛ يحافظ على ضبط النفس)",
 "まどかけ": "سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة أو منع أشعة الشمس)",
 "まどがい": "محار النافذة (ذوات صدفتين بحرية شائعة في المياه الساحلية الفلبينية تتميز بصدفة شفافة مسطحة رقيقة كبيرة)",
 "まどがわ": "نَافِذَة, شُبَّاك / نَافِذَة, ويندو",
 "まどがわせき": "مقعد النافذة (مقعد أو مجلس مشابه مبني داخل تجويف النافذة)",
 "まどぐち": "عَدَّاد",
 "まどころ": "مكتب حكومي (مكتب يعمل فيه موظفو الحكومة)",
 "まどつき": "نَافِذَة, شُبَّاك / نَافِذَة, ويندو",
 "まどつきふうとう": "ظرف بنافذة (ظرف به لوحة شفافة تكشف العنوان الموجود على المرفق)",
 "まどのさん": "إِطَار النَافِذَة",
 "まどひょうじいきへんかん": "نَافِذَة, شُبَّاك / نَافِذَة, ويندو",
 "まどり": "تخطيط, تصميم (فعل التخطيط (مثل وضع خطط لشيء ما)) / تخطيط, تصميم (خطة أو تصميم لشيء مرتب)",
 "まどりず": "مُخَطَّط أَرْضِيَّة الدَّوْر",
 "まどろこい": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "まどろこしい": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "まどろっこい": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "まどろっこしい": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "まどわく": "إِطَار النَافِذَة",
 "まどわす": "يُربك, يُحيّر / أَغْوَى, أَغْرَى / أَغْرَى",
 "まどガラス": "لوح الزجاج, ويندوبين (سمكة مفلطحة شفافة رقيقة جداً في ساحل المحيط الأطلسي لأمريكا الشمالية) / زجاج النافذة, لوح النافذة (لوح من الزجاج في نافذة)\nمثال: حطمت الكرة زجاج النافذة",
 "まな": "كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك. / مَحْبُوب / حَبِيب",
 "まないた": "لوح تقطيع (لوح خشبي يمكن تقطيع اللحوم أو الخضروات عليه)",
 "まなお": "غيرية جنسية (انجذاب جنسي (أو علاقات جنسية) لأشخاص من الجنس الآخر) / استقامة, حسن نية (امتلاك نوايا صادقة) / استقامة, مباشرة (صحة المسار نحو الهدف) / استقامة (الخلو من الانحناءات أو المنعطفات أو الزوايا)\nمثال: تصرف بحسن نية",
 "まなか": "مُنْتَصَف, وَسَط / وَسَط, مُتَوَسْط",
 "まながつお": "جوني الصخر (سمكة طعام زلقة بلا حراشف في المياه الساحلية لشمال المحيط الأطلسي) / سمكة الزبدة (سمكة بحرية صغيرة ذات جسم مضغوط قصير وأشواك ضعيفة) / سمك الزبدة (أي من العديد من أسماك الطعام الصغيرة المفلطحة الأطلسية ذات الجلد الناعم)",
 "まなこ": "عَيْن, عين (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / سُمّ, خُرْبَة (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط)\nمثال: كان عين ليلى مسودة. / نظرة ثاقبة / بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / نِوَاة",
 "まなざし": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا.",
 "まなつ": "قيظ",
 "まなでし": "تلميذ المعلم المدلل (الطالب المفضل لدى المعلم)",
 "まなばしら": "ذُعْرَة, هَزَّاز الذَّنَب",
 "まなび": "تَعَلُّم (اكتسب معرفة أو خبرة أو مهارة) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم)\nمثال: هو سريع التعلم.",
 "まなびのその": "مُؤَسَّسَة تَعْلِيمِيَّة",
 "まなびのにわ": "مُؤَسَّسَة تَعْلِيمِيَّة",
 "まなびや": "مَدْرَسَة, مَكْتَب (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس) / كُلِّيَّة, جَامِعَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر) / قِسِم (فَرَّقَ أو قَسَّمَ الشَّيءَ إلى أجزاء أو أجزاء مختلفة؛ أَحْلَفَ، أَي جَعَلَ يَحْلِفُ على أمرٍ ما) / مَدْرَسَة (الموضع الذي تُدَرَّس فيه العلوم؛ البناء فيه عدة غرف تُدَرَّسُ فيها العلوم وتمنح شهادة رسمية بعد إكمال الدروس)\nمثال: لا أحب المدرسة.",
 "まなぶ": "تَعَلَّمَ (اكتسب معرفة أو خبرة أو مهارة) / اِعْتَبَرَ, اِتَّعَظَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين)\nمثال: هو سريع التعلم.",
 "まなぶた": "جَفْن (مَنَعَ نَفْسَهُ عَنْ كُلِّ مَكْرُوهٍ؛ وَضَعَ الطَّعَامَ فِي الجَفْنَةِ)",
 "まな板": "لوح تقطيع (لوح خشبي يمكن تقطيع اللحوم أو الخضروات عليه)",
 "まに": "جَوْهَر, جَوْهَرَة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "まにあい": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "まにあう": "أَدَارَ (دَارَ نصف دورة فقط؛ الشيء: جعله يدور؛ فعل تعدّي من دَارَ)\nمثال: أدار فاضل مقبض الباب بهدوء و دخل إلى المنزل.",
 "まにあわせ": "بديل مؤقت, حل مؤقت (شيء يتم تدبيره لتلبية حاجة ملحة أو طارئة) / مُؤَقَّت الصُّنْع, مُرْتَجَل (مصنوع أو مُنجَز بما هو متاح من موادّ)",
 "まにうける": "أَخَذَهُ عَلَى مَحْمَلِ الجِدِّ, أَخَذَهُ بِالجِدِّيَّة",
 "まにし": "الغَرْب (نقطة البوصلة الأصلية التي تكون عند 270 درجة)",
 "まにしゅ": "جَوْهَر, جَوْهَرَة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "まにじゅ": "جَوْهَر, جَوْهَرَة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "まにほうじゅ": "جَوْهَر, جَوْهَرَة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "まにまに": "تَحْتَ رَحْمَةِ (أَقَلَّ)\nمثال: أنا تحت الشجرة.",
 "まにんげん": "رجل شريف (رجل تزوج من امرأة كان يقيم معها علاقة جنسية بالفعل)",
 "まぬかれる": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف. / تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "まぬがれる": "هَرَبَ (الفِرارُ) / فِرَار, هُرُوب\nمثال: هرب كأرنب خائف. / تَجَنَّبَ (امتنع عن التعامل مع شخص أو موقف معين؛ ابتعد عن شيء أو تجنبه عمدًا لتفاديه)\nمثال: تجنب الازدحام المروري",
 "まぬけ": "غَبِيّ / غَبِيّ, أَحْمَق / مُغَفَّل, أَحْمَق",
 "まね": "قَلَّدَ / سُلُوك, تَصَرُّف",
 "まねき": "دَعْوَة, عزيمة / إِغْرَاء",
 "まねきよせる": "أَشَارَ, أَوْمَأَ",
 "まねく": "دَعَا, عَزَمَ (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / أَشَارَ, أَوْمَأَ / يَسْتَحْضِر, يَسْتَدْعِي / قَضِيَّة (الأمر أو الشيء المُعَقَّد؛ في : ما يقضي فيه القاضي) / سَبَّبَ ((سَبَّبَه): أَكثر سَبَّه؛ (سَبَّبَ) الأسبَاب: أوجدها)\nمثال: سأرفع عليك قضية.",
 "まねごと": "تَقْلِيد",
 "まねし": "عَدِيد, كَثِير",
 "まねしつぐみ": "المُحاكِي",
 "まねしんぼ": "مُقَلِّد",
 "まねしんぼう": "مُقَلِّد",
 "まねっこ": "قَلَّدَ",
 "まねる": "تَقْلِيدِيّ (يُشكِّل تقليداً أو محاكاة) / مقلد (شخص يقلد (خاصة ممثل أو ممثلة))",
 "まのあたり": "شَخْصِيًّا",
 "まのいい": "مَحْظُوظ, جَالِب للحَظّ",
 "まのて": "إمساك, قبضة (فعل الإمساك)\nمثال: أرخى قبضته عن ذراعي",
 "まのぬけた": "عَبِيط",
 "まのび": "بطء, تأنٍ (معدل يظهر غياب العجلة أو التسرع) / تأخر, تخلف عقلي (نقص في التطور الطبيعي للقدرات الفكرية) / خرق, عدم براعة (عدم المهارة الناتج عن نقص التدريب) / انحلال, فجور (انغماس منحل في الملذات الحسية) / تَخَلْخُل, حَرَكَة حُرَّة (حركة أو مساحة للحركة (خاصة في الأجزاء الميكانيكية)) / انْفِلَات, تَحَرُّر (صفة قابلية الحركة بحكم التحرر من الارتباط أو القيود الأخرى) / تَرَاخٍ, تَسَيُّب (نقص الدقة الصارمة؛ التساهل في الممارسة)\nمثال: كان هناك الكثير من التخلخل في عجلة القيادة",
 "まのびした": "بَطِيء / أَبْطَأَ, بَطَّأَ",
 "まのよい": "مَحْظُوظ, جَالِب للحَظّ",
 "まばしら": "فحل",
 "まばたき": "رَمَشَ (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء وعين رمشاء وقد ارمش؛ وبه رمش اي برش:- وارمش الشجر:- اورق كأربش وقال ابن الاعرابي أرمش أخرج ثمره كالحمص، وارض رمشاء: كثيرة العشب كرسماء) / رَمْشَة",
 "まばたく": "لَأْلَأَ (لَمَعَ، أَشْرَقَ؛ (استخدام مجازي) اغْرَوْرَقَتْ الدُّمُوع) / رَمَشَ (رمش: المش:- تقتل في الشفر وحمرة في الجفن مع ماء يسيل، رجل ارمش وامراءة رمشاء وعين رمشاء وقد ارمش؛ وبه رمش اي برش:- وارمش الشجر:- اورق كأربش وقال ابن الاعرابي أرمش أخرج ثمره كالحمص، وارض رمشاء: كثيرة العشب كرسماء) / رَمْشَة",
 "まばゆい": "مُبْهِر, وَهَّاج (يَلْمَع بِشِدَّة وقُوَّة) / بَاهِر, خَاطِف لِلْأَبْصَار (مُثير للإعجاب بشكل مُبهر؛ يُوحي بومضات البرق)",
 "まばら": "ضَئِيل",
 "まばん": "قَافِلَة (مؤنث القافل؛ الراجعة؛ جماعة من الناس تسير معًا مع أمتعتها وركوبها في سفر قافلين كانوا أو خارجين. سميّت كذلك تفائلا برجوعها) / مَقْطُورَة\nمثال: الكلاب تنبح، والقافلة تسير.",
 "まひ": "شَلَل, فَالَج / فتور, لامبالاة (سمة الافتقار للحماس أو الاهتمام بالأشياء عموماً) / تنميل, خدر (فقدان جزئي أو كلي للإحساس في جزء من الجسم؛ عَرَض لتلف الأعصاب أو خلل وظيفي) / توقف, جمود (انقطاع النشاط الطبيعي) / جمود, طريق مسدود (وضع لا يمكن فيه إحراز تقدم أو لا يمكن فيه أي تقدم)\nمثال: وصلوا إلى طريق مسدود في المفاوضات",
 "まひがし": "الشَّرْق (نقطة البوصلة الأصلية التي تكون عند 90 درجة)",
 "まひょ": "لِـ, هَيَّا (اللَّامُ هو الحرف الثالث والعشرون من حروف ٱلْهِجَاءِ، وهو مجهور متوسط…؛ يفيد التعليل الغرضي) / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "まひる": "ظهر, ظهيرة (منتصف اليوم)",
 "まひるのゆめ": "حُلْم يَقَظَة (رأى في نومه)\nمثال: هذا الحلم سيتحقق.",
 "まび": "يَوْم عُطْلَة (فترة من الزمان تبدأ عند غُرُوب الشمس وتنتهي عند غُرُوب شمس النهار التالي ويشمل اللَيْلَة ونَهَارا. طوله أربع وعشرين سَاعَة؛ النَهَار، يبدأ من طلوع الفَجْر إلى غُرُوب الشَمس، على المجاز)\nمثال: طقس اليوم جميل.",
 "まびき": "تقليم (عملية تشذيب النبات) / قُلامَة (ما تم تقليمه وقصه من النبات) / قتل الرضيع, وأد (قتل طفل رضيع) / قاتل الرضيع (شخص يقتل رضيعاً)",
 "まびく": "مرفوض, منبوذ (الشخص أو الشيء الذي يتم رفضه أو تنحيته جانباً لكونه أقل جودة) / قَلَّلَ",
 "まびさし": "حافة أمامية, قناع (حافة تبرز إلى الأمام لتظليل العينين) / قناع الخوذة (قطعة من الدرع الصفيحي (ذات شقوق للعين) مثبتة أو مفصلية بخوذة من العصور الوسطى لحماية الوجه)\nمثال: سحب حافة قبعته لأسفل ومشى بجهد للأمام",
 "まふ": "كَتَّان",
 "まふつのかがみ": "مِرْآة, مراية (أداة لها القابلية على عكس الضوء بطريقة تحافظ على الكثير من صفاتهما الأصلية قبل ملامسة سطح المرآة)\nمثال: أنظر في المرآة!",
 "まふゆ": "عز الشتاء, منتصف الشتاء (وسط فصل الشتاء)",
 "まぶ": "عَاشِق, عَاشِقَة / مُغْرَم / نَفَق",
 "まぶい": "فَاتِن, قَشِيب / رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "まぶし": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / كَمين / كَمِين",
 "まぶしい": "مُبْهِر, وَهَّاج (يَلْمَع بِشِدَّة وقُوَّة) / بَاهِر, خَاطِف لِلْأَبْصَار (مُثير للإعجاب بشكل مُبهر؛ يُوحي بومضات البرق)",
 "まぶす": "غِطَاء / غِلَاف / غَطَّى",
 "まぶた": "جَفْن (مَنَعَ نَفْسَهُ عَنْ كُلِّ مَكْرُوهٍ؛ وَضَعَ الطَّعَامَ فِي الجَفْنَةِ)",
 "まぶる": "غِطَاء / غِلَاف / غَطَّى",
 "まぶれ": "مُبَقَّع, مُلَطَّخ (موسوم أو مصبوغ أو متغير اللون بمادة غريبة) / مَصْبُوغ, مُلَمَّع (مُغَطًّى بِطَبَقَةٍ مِنَ الصَّبْغِ أَوِ الوَرْنِيش)\nمثال: مفرش طاولة ملطخ بشدة",
 "まほ": "مع الريح (مع الريح؛ في اتجاه هبوب الريح) / باتجاه الريح (نحو الريح) / مَعَ اتِّجَاه الرِّيح (نحو الجانب البعيد عن مصدر الرياح)\nمثال: طاروا مع الريح / مُمْتَاز, فَاخِر / سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته) / صحيح, لائق (يتميز بالملائمة أو الصواب أو المناسبة)\nمثال: علاج طبي مناسب / صَرِيح, مُسْتَقِيم",
 "まほう": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر.",
 "まほうし": "سَاحِر",
 "まほうじん": "مربع سحري (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ)\nمثال: لا توجد مثلثات مربعة.",
 "まほうじんぎょうれつ": "مربع سحري (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ)\nمثال: لا توجد مثلثات مربعة.",
 "まほうすう": "عَدَد سِحْرِيّ (العدد الذري لنواة ذرية مستقرة للغاية ومترابطة بقوة: 2، 8، 20، 28، 50، 82 أو 126)",
 "まほうつかい": "سَاحِر",
 "まほうづえ": "عَصًا, مِخْصَرَة (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "まほうてき": "سِحْر (ألقى السحر على شخص أو شيء، بمعنى جعله تحت تأثير السحر؛ أدهش أو أبهر بجمال أو جاذبية غير عادية) / سِحْرِيّ\nمثال: هذا هو سحر الجزائر.",
 "まほうのじゅうたん": "بِسَاط سِحْرِيّ, بِسَاط الرِّيح",
 "まほうのつえ": "عَصًا, مِخْصَرَة (ما يتخذ من خَشَب للتوكؤ أو الضرب؛ تطلق مجازا على عَظْم السَاق وعلى اللِسَان)\nمثال: لا تمسك العصا من الوسط.",
 "まほうびん": "ترمس (قارورة مفرغة تحفظ درجة حرارة المشروبات الساخنة أو الباردة)",
 "まぼ": "مع الريح (مع الريح؛ في اتجاه هبوب الريح) / باتجاه الريح (نحو الريح) / مَعَ اتِّجَاه الرِّيح (نحو الجانب البعيد عن مصدر الرياح)\nمثال: طاروا مع الريح",
 "まぼしい": "مُبْهِر, وَهَّاج (يَلْمَع بِشِدَّة وقُوَّة) / بَاهِر, خَاطِف لِلْأَبْصَار (مُثير للإعجاب بشكل مُبهر؛ يُوحي بومضات البرق)",
 "まぼる": "أَكَلَ : يَأْكُلُ, كَلْ (تَنَاوَلَ الطَّعَام، وَضَعَه في فمِه ثُم مَضَغَه ثُم بَلَعَه؛ أَفْنَى الشيء ولَم يبقِ منه)",
 "まぼろし": "سَرَاب, شَبَح / سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا)",
 "まま": "كَـ, مِثْل / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / مَعَ (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع) / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)\nمثال: جئت مع أصدقائي. / أَحْيَانًا / طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "ままいも": "أخت غير شقيقة (أخت تشترك معك في أحد الوالدين فقط)",
 "ままこ": "ابن الزوج, ابن الزوجة (طفل زوجك من زواج سابق)",
 "ままちち": "زَوْجُ ٱلْأُمّ, أَب رَبِيب (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "ままっこ": "ابن الزوج, ابن الزوجة (طفل زوجك من زواج سابق)",
 "ままに": "كَـ, مِثْل / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة.",
 "ままねえ": "أخت غير شقيقة (أخت تشترك معك في أحد الوالدين فقط)",
 "ままはは": "زَوْجَةُ الْأَب / رَابَّة",
 "ままむすこ": "رَبِيب",
 "ままむすめ": "رَبِيبَة",
 "ままよ": "أَيّ, أَيَّمَا (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير) / مَهْمَا مَا / طُز\nمثال: لم تقصد أي أذى.",
 "まま娘": "رَبِيبَة",
 "まま息子": "رَبِيب",
 "まみ": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / غُرَيْر / كلب الراكون (كلب بري صغير من شرق آسيا له علامات وجه تشبه علامات الراكون)",
 "まみえ": "حَاجِب",
 "まみえる": "لَاقَى, لَقِيَ (لَقِيَ، صَادَفَ) / اِلْتَقَى, تَقَابَلَ ((لَازِمٌ) فِعْلُ مُشَارَكَةٍ فِي اللِّقَاءِ؛ (مُتَعَدٍّ بِنَفْسِهِ) لَقِيَهُ) / تَعَرَّفَ\nمثال: لقد التقى بماري. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / عَبَدَ (خلاف الحُرّ، المَمْلُوْك، من له مالك يملكه. الجمع عبيد وأعبد وعِبدان وعُبدان؛ الإنسان حرا كان أم لا مؤمنا كان أن ملحدا من حيث أنه مملوك لله) / خَدَمَ (عَمِلَ أو سَاعَدَ شخصًا أو جهة؛ أَدَارَ خدمة أو مهمة) / قَدَّمَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف) / أَرْسَلَ (بَعَثَ؛ أَطْلَقَ) / إِرْسَال (الإرْسال : الإطلاق؛ النقل والبَعْث من مكان إلى آخر)\nمثال: ماذا أنجز عبد العزيز بوتفليقة؟",
 "まみず": "مَاء عَذْب (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "まみずくらげ": "زَهْرَة خَوْخ",
 "まみちゃじない": "أَشْيَب, شَائِب (يُظهِر علامات الشيخوخة خاصّة الشعر الأبيض أو الرماديّ)",
 "まみなみ": "الجَنُوب (نقطة البوصلة الأصلية التي تكون عند 180 درجة)",
 "まみれ": "مُبَقَّع, مُلَطَّخ (موسوم أو مصبوغ أو متغير اللون بمادة غريبة) / مَصْبُوغ, مُلَمَّع (مُغَطًّى بِطَبَقَةٍ مِنَ الصَّبْغِ أَوِ الوَرْنِيش)\nمثال: مفرش طاولة ملطخ بشدة",
 "まむかい": "وَجْهًا لِوَجْه",
 "まむき": "جَدِّي, جَادّ / عَرْبُون",
 "まむぎ": "قَمْح, حِنْطَة",
 "まむこう": "وَجْهًا لِوَجْه",
 "まむし": "أفعى الحفر (أفاعي العالم الجديد ذات أنياب مجوفة وحفرة حساسة للحرارة على كل جانب من الرأس)",
 "まめ": "بقول, قرن (قرن البذور لنبات بقولي (مثل البازلاء أو الفاصولياء أو العدس)) / بقول, قرنية (نبات فول أو بازلاء قائم أو متسلق من الفصيلة البقولية) / بقل, ثمرة قرنية (فاكهة أو بذرة أي من نباتات الفاصوليا أو البازلاء المختلفة تتكون من علبة تنشق على طول كلا الجانبين عند النضج وتكون البذور ملتصقة بجانب واحد من العلبة) / صويا, فول الصويا (أكثر الخضراوات المعروفة احتواءً على البروتين؛ تستخدم ثمرة نبات الصويا في مجموعة متنوعة من الأطعمة وكعلف (خاصة كبديل للبروتين الحيواني)) / صويا, فول الصويا (عشب حولي منتصب كثيف الشعر له أوراق ثلاثية وزهور أرجوانية إلى وردية؛ يزرع على نطاق واسع للغذاء والعلف ولتحسين التربة، وخاصة لبذوره المغذية الغنية…) / فول الصويا (مصدر للزيت؛ يستخدم للعلف وتحسين التربة وكغذاء) / أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية) / كُلْيَة (مصدر صناعيّ من كُلّ؛ شمول، مجموع من الأوّل إلى الآخر)\nمثال: في أي كلية تدرس؟ / بَطْبَاطَة, نَفْطَة / مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح. / صَحِيح, سَلِيم / صِحِّيّ (ما ينفع الصحة)\nمثال: لازمك تعمل حجر صحي. / وَفِيّ, مُخْلِص / أَمِين (من يتولى رقابة شيء أو المحافظة عليه؛ مُطْمَئِنّ)\nمثال: هو غبي وغير أمين.",
 "まめあぶら": "زيت فول الصويا (زيت مستخرج من فول الصويا)",
 "まめがらちゃ": "أَزْرَق رَمَادِيّ (أزرق مع مسحة رمادية)",
 "まめこがね": "خنفساء يابانية (خنفساء صغيرة خضراء وبنية معدنية موطنها شرق آسيا؛ آفة نباتية خطيرة في أمريكا الشمالية)",
 "まめざくら": "كرز فوجي (شجرة كرز يابانية شجيرية لها أزهار وردية شاحبة)",
 "まめじか": "طرغولية",
 "まめぞうむし": "سوسة الفاصوليا (تعيش اليرقات وتتغذى في الفاصوليا النامية أو المخزنة)",
 "まめちしき": "تفاهة, شيء تافه (شيء قليل الأهمية)",
 "まめつ": "تشويه, طمس المعالم (عملية إتلاف مظهر أو سطح شيء ما)\nمثال: تشويه فسيفساء إيطالية أثناء الغزو التركي",
 "まめつぶ": "فَاصُولِيَا, لُوبِيَا",
 "まめまめしい": "مُجْتَهِد (مشتق من إجتهد)\nمثال: لعل المجتهد ينجح.",
 "まめやか": "مُخْلِص (الشخص الذي يفي ولا يخون)\nمثال: الغيرة لا تجعل أحد مخلص",
 "まめりょう": "بقول, قرن (قرن البذور لنبات بقولي (مثل البازلاء أو الفاصولياء أو العدس)) / بقول, قرنية (نبات فول أو بازلاء قائم أو متسلق من الفصيلة البقولية) / بقل, ثمرة قرنية (فاكهة أو بذرة أي من نباتات الفاصوليا أو البازلاء المختلفة تتكون من علبة تنشق على طول كلا الجانبين عند النضج وتكون البذور ملتصقة بجانب واحد من العلبة)",
 "まめるい": "نَبْض, نَبْضَة",
 "まめん": "سَطْح (سَطحَهُ يَسْطَحَ سَطْحًا: بَسَطَهُ وسَوّاه؛ فهو مَسْطُوحٌ، وسَطِيحٌ) / جَانِب\nمثال: هناك ثقوب على السطح.",
 "まめテスト": "اِخْتِبَار (اختبر الشّيء:خبره)\nمثال: تم اختبار زيري.",
 "まもう": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا.",
 "まもない": "عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل",
 "まもなく": "قَرِيبًا, سَرْعَانَ مَا",
 "まもの": "شَيْطَان, شيطان ((في الأديان الإبراهيمية) الرُّوح الشِّرِّير الَّذِي يَرْمِي بِكَ لِلتَّهْلُكَةِ لِبُعْدِهِ عَنِ الْخَيْرِ وَطَرِيقِ الْحَقِّ؛ (استعمال مجازي) كُلّ وَلَدٍ مُشَاكِسٍ أَوْ مُتَمَرِّدٍ)\nمثال: العجلة من الشيطان.",
 "まもり": "حِمَايَة / بروفيدنس / تَمِيمَة, أُخْذَة",
 "まもりて": "وَلِي أَمْر, حَافِظ (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ) / حَارِس\nمثال: ولي العهد هو من يرث العرش. / سَاعَة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن) / حَارِس / رَصَدَ (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس) / حَذِرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: درست لمدة ساعة.",
 "まもりびと": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "まもりふだ": "طِلَسْم, طِلَّسْم",
 "まもる": "حَمَى (حمَى الشيءُ فلانًا: منَعه ودفع عنه؛ حمى المريضَ: منعه ما يضره)\nمثال: ليس لديك أي حمى. / اِحْتَفَظَ, أَبْقَى",
 "まや": "حَظِيرَة, اِسْطَبْل / زَرِيبَة / ثَابِت (اسم فاعل من ثَبَتَ؛ المُسْتَقِرّ الذي لا يتحرك، ضد المُتَحَرِّك)\nمثال: الشاحنة غير ثابتة.",
 "まやかし": "خِدَاع, خَدْع",
 "まやかす": "غَشَّ",
 "まやく": "مُخَدِّر",
 "まやくおう": "بارون مخدرات, زعيم عصابة مخدرات (شخص يسيطر على منظمة تتعامل في المخدرات غير المشروعة)",
 "まやくかんじゃ": "مُدْمِن, حَشَّاش",
 "まやくこっか": "دولة مخدرات (منطقة استولت عليها وسيطرت عليها وأفسدتها عصابات المخدرات وحيث يكون إنفاذ القانون غير موجود فعلياً)",
 "まやくじょうしゅう": "إدمان المخدرات (إدمان على مخدر (خاصة المخدرات الأفيونية))",
 "まやくじょうようしゃ": "متعاطي مخدرات (شخص يتعاطى المخدرات)",
 "まやくそしき": "عصابة مخدرات, كارتل مخدرات (كارتل غير مشروع تم تشكيله للسيطرة على إنتاج وتوزيع المخدرات)\nمثال: تقوم عصابات المخدرات أحياناً بتمويل المنظمات الإرهابية",
 "まやくちゅうどく": "إدمان المخدرات (إدمان على مخدر (خاصة المخدرات الأفيونية))",
 "まやくちゅうどくしゃ": "مُدْمِن, حَشَّاش",
 "まやくとりしまりきょく": "إدارة مكافحة المخدرات (وكالة فيدرالية مسؤولة عن تطبيق القوانين واللوائح التي تحكم المخدرات والمواد الخاضعة للرقابة؛ هدفها هو شل حركة منظمات تهريب المخدرات)",
 "まやくとりひき": "اتجار بالمخدرات (الاتجار في المخدرات غير القانونية)",
 "まやくみつばい": "اتجار بالمخدرات (الاتجار في المخدرات غير القانونية)",
 "まやくみつゆ": "اتجار بالمخدرات (الاتجار في المخدرات غير القانونية)",
 "まやくカルテル": "عصابة مخدرات, كارتل مخدرات (كارتل غير مشروع تم تشكيله للسيطرة على إنتاج وتوزيع المخدرات)\nمثال: تقوم عصابات المخدرات أحياناً بتمويل المنظمات الإرهابية",
 "まやくテロ": "إرهاب المخدرات (تمويل الأنشطة الإرهابية عن طريق المشاركة في تجارة المخدرات)",
 "まゆ": "حَاجِب / شَرْنَقَة (غشاء واق من خيوط دقيقة تنسجه بعض الحشرات حولها كدودة القز، لتحتمي به في طَوْر من أطوار حياتها)",
 "まゆげ": "حَاجِب",
 "まゆずみ": "قلم حواجب (مكياج يوفره قلم تجميلي يستخدم لتغميق الحواجب)",
 "まゆだま": "أول أيام السنة, يوم رأس السنة (اليوم الأول من السنة)",
 "まゆつば": "قصة خيالية, قصة ملفقة (قصة مثيرة للاهتمام ولكنها غير قابلة للتصديق إلى حد كبير؛ تُروى غالباً كعذر)",
 "まゆつばもの": "قصة خيالية, قصة ملفقة (قصة مثيرة للاهتمام ولكنها غير قابلة للتصديق إلى حد كبير؛ تُروى غالباً كعذر)",
 "まゆづき": "هِلَال",
 "まゆねをよせる": "عُبُوسة, عُبُوس / عَبَسَ, عَقَدَ حَاجِبَيْهُ",
 "まゆひとつうごかさない": "الحصى الحية, ليثوبس",
 "まゆをくもらす": "عَبَسَ",
 "まゆをしかめる": "عَبَسَ",
 "まゆをひそめる": "عَبَسَ",
 "まゆをよせる": "عُبُوسة, عُبُوس / عَبَسَ, عَقَدَ حَاجِبَيْهُ",
 "まゆペンシル": "قلم حواجب (مكياج يوفره قلم تجميلي يستخدم لتغميق الحواجب)",
 "まゆ毛": "حَاجِب",
 "まよい": "تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / تثاقل, تردد (درجة معينة من عدم الرغبة) / تردد, تريث (تردد في الكلام أو العمل)\nمثال: كان هناك تردد في كلامه / هَلْوَسَة, وَهْم",
 "まよいぼし": "كَوْكَب سَيَّار, كَوْكَب ((قديمًا) جرم سماوي من البلازما مضيئ بذاته متماسك بفعل الجاذبية؛ جرم سماوي يدور حول الشمس) / كَوْكَب ((قديمًا) جرم سماوي من البلازما مضيئ بذاته متماسك بفعل الجاذبية؛ جرم سماوي يدور حول الشمس)\nمثال: كوكب الأرض جميل.",
 "まよう": "اُغْرُب عَن وَجْهِي!, إِبْتَعِد عَنِّي! / ضَلَّ الطَّرِيق / تمايل, رفرفة (فعل التحرك ذهاباً وإياباً) / تردد, تلكؤ (فعل التوقف بشكل غير مؤكد) / ملوِّح (شخص يتواصل عن طريق التلويح)\nمثال: كان هناك تردد في كلامه",
 "まよえる": "ضَائِع / مَفْقود",
 "まよけ": "طِلَسْم, طِلَّسْم",
 "まよこ": "جَانِب / صَفْحَة",
 "まよなか": "مُنْتَصَف لَيْل, مُنْتَصَف اللَّيْل / مُنْتَصَف اَللَّيْل\nمثال: 私たちは真夜中にロンドンに着いた。 — وصلنا إلى لندن عند منتصف الليل.",
 "まよわす": "لُغْز, مُعْضِلَة (قالَ كلامًا خفيًا أو غير واضح، أو استخدم التورية والإشارة؛ عبّرَ عن شيء بطريقة رمزية أو غير مباشرة) / بَازْل, لُغْز / حَيَّرَ ((حَيَّرَه): أَوْقَعَه فِي حيرة)\nمثال: لم يحل أبدا لغز وفاتها.",
 "まら": "مارا (قارض يشبه الأرنب يعيش في سهول البامبا في الأرجنتين) / قَضِيب, ذَكَر",
 "まり": "ضَرَّة",
 "まりょく": "قدرة سحرية (القدرة على أداء السحر)",
 "まる": "دَوَائِر تَحْتَ ٱلْعَيْنَيْن (بمعنى الشكل الذي لا بداية له ولا نهاية بشكل قوس مستمر؛ بمعنى الهيئة أو الجهة الحكومية التي تدير أمرا ما) / نُقْطَة, عَلَامَة فَصْلِيَّة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / حِصَّةٌ / عَصْر (مصدر للفعل \"عَصَرَ\"؛ أي مدة زمنية، دهر من الوقت)\nمثال: هذه هي نقطة ضعفه. / دَوَائِر تَحْتَ ٱلْعَيْنَيْن (بمعنى الشكل الذي لا بداية له ولا نهاية بشكل قوس مستمر؛ بمعنى الهيئة أو الجهة الحكومية التي تدير أمرا ما) / كَافَّة, تَمَام / نُقُود, مَال / نُقُود, عُمْلَة / نَقْد, نقود / مَال (ما يملك الإنسان من كل شيء ويشمل النقد والعَيْن؛ عند البدو: هي النعم والإبل تحديدا)\nمثال: أريد بعض المال. / سلحفاة لينة الصدفة (سلحفاة مائية شرهة ذات صدفة مرنة مسطحة مغطاة بجلد جلدي؛ يمكن أن تسبب عضات مؤلمة) / أَفْرَزَ",
 "まるあんき": "تلقين, حفظ عن ظهر قلب (الحفظ عن طريق التكرار)",
 "まるい": "مُسْتَدِير, مُدَوَّر (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / مُسْتَدِير, كُرَوِيّ (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما) / جَوْلَة, مَرْحَلَة / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / مُنْثَنٍ / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً)",
 "まるいし": "جُلْمُود, صَخْرَة كَبِيرَة (كتلة صخرية كبيرة ملساء منفصلة عن مكان نشأتها)",
 "まるいす": "مِقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَقْعَدَة / بِرَاز\nمثال: نام ياني على مقعد.",
 "まるおあまがさ": "كرايت مخطط (كرايت بطيء الحركة مخطط بالأسود والأصفر)",
 "まるおび": "قطعة واحدة ((للملابس) يتكون من أو مصمم كقطعة واحدة كاملة)\nمثال: رداء من قطعة واحدة",
 "まるかっこ": "أَقْوَاس, قَوْس",
 "まるがかえ": "رَاعٍ ((رَاعَ) يَرُوعُ رَوْعًا: فَزِعَ؛ يُقال: (راع) منه)\nمثال: سلم إيغور القطيع لراع آخر.",
 "まるがた": "شكل مستدير (شكل منحني وبدون زوايا حادة)",
 "まるがっこ": "أَقْوَاس, قَوْس",
 "まるき": "خَشَبَة",
 "まるきぶね": "بيروج, زورق محفور (كانو مصنوع عن طريق حفر وتشكيل جذع شجرة كبير)",
 "まるきり": "تَمَامًا",
 "まるく": "وُدِّيًّا (بطريقة ودية)\nمثال: انفصلا ودياً",
 "まるくなる": "برخامة, بنعومة (بطريقة رخيمة) / ثَمِل قَلِيلًا, مُنْتَشٍ (فِي حَالَة نَشْوَة خَفِيفَة مِنَ الكُحُول أَوِ المُخَدِّرَات) / هادِئ, وَديع (لَطيف وهادِئ؛ نَضِج واعْتَدَل بِمُرور الوَقْت) / مُعَتَّق, نَاعِم (ذو نكهة ممتلئة ومُسْتَحَبّة بفضل التعتيق المناسب) / تشاور سريع ((غير رسمي) مؤتمر خاص سريع) / تجمهر, لمة (حشد غير منظم ومكتظ)\nمثال: تجمهر لنساء خائفات",
 "まるごし": "أَعْزَل",
 "まるごと": "بِرُمَّتِهِ, بِكُلِّيَّتِهِ",
 "まるざい": "خَشَبَة",
 "まるぞこ": "مُسْتَدِير القَاع (له قاع مستدير الشكل)",
 "まるた": "خَشَبَة / ديس (سمكة مياه عذبة أوروبية صغيرة ذات جسم نحيل أزرق مخضر)",
 "まるたあしば": "سِقَالَات, سِقَالَة",
 "まるたごや": "كوخ جذعي (كوخ مبني من جذوع الأشجار)",
 "まるたて": "تُرْس ((تَرَّسَ): توقى بالترس)",
 "まるたんぼう": "خَشَبَة",
 "まるだし": "مَكْشُوف, مُعَرَّض",
 "まるっきし": "تَمَامًا",
 "まるっきり": "تَمَامًا",
 "まるっこい": "مُسْتَدِير, مُدَوَّر (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / مُسْتَدِير, كُرَوِيّ (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما) / جَوْلَة, مَرْحَلَة / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: رجاء ضع دائرة حول الجواب الصحيح.",
 "まるっと": "بِرُمَّتِهِ, بِكُلِّيَّتِهِ",
 "まるつぶれ": "اِنْهَار / اِنْهِيَار (سقوط شيء أو تهاويه بشكل مفاجئ نتيجة ضعف أو خلل؛ تدهور نفسي أو عاطفي يؤدي إلى فقدان القدرة على التحمل)\nمثال: يوشك الجسر على الانهيار.",
 "まるで": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له. / أبداً / حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه، يقال نزل في الماء حتى حقاه فهو محقو ومحقي) / وَٱللّٰه؟ / لَيْسَ مَعْقُل!\nمثال: هو اغضبني حقا .",
 "まるといし": "مِجْلَخَة, جَلَّاخَة",
 "まるどり": "اِحْتَكَرَ",
 "まるのこ": "مِنْشَار دَائِرِيّ",
 "まるのまま": "بِرُمَّتِهِ, بِكُلِّيَّتِهِ",
 "まるのみ": "جَرَعَ, بَلَعَ ((جَرَعَ) المَاء وَنَحْوه جرعا: بَلِعَه) / جَرْعَة, شَرْبَة / سُنُونُو / تجويف, نقر (فعل النقر أو التجويف بأداة) / إزميل مقعر, مِنْقَار (أداة ذات حد بشفرة تشبه الميزاب لقطع القنوات أو الأخاديد) / انبعاج, حز (أثر غائر في سطح (كما ينتج عن ضربة))",
 "まるはなばち": "طَنَّانَة, نَحْلَة",
 "まるばあさがお": "أثمان أرجواني, مجد الصباح الشائع (عشب متسلق حولي استوائي شامل بزهور قمعية الشكل زرقاء أو أرجوانية أو وردية أو بيضاء) / أثمان ثلاثي الألوان, مجد الصباح الشائع (عشب متسلق حولي أو معمر من أمريكا الوسطى له زهور زرقاء سماوية؛ أكثر أنواع مجد الصباح زراعة)",
 "まるばしら": "عَمُود / خَانَة",
 "まるばつ": "صح أو خطأ (يقدم سلسلة من العبارات التي يجب الحكم على كل منها بأنها صحيحة أو خاطئة)\nمثال: اختبار صح أو خطأ",
 "まるばつゲーム": "إكس أو, تيك تاك تو (لعبة يضع فيها لاعبان بالتناوب صلباناً ودوائر في أحد أقسام شبكة مربعة من تسع مساحات؛ الهدف هو الحصول على صف من ثلاثة صلبان أو ثلاث دوائر قبل الخصم)",
 "まるばつテスト": "صح أو خطأ (يقدم سلسلة من العبارات التي يجب الحكم على كل منها بأنها صحيحة أو خاطئة)\nمثال: اختبار صح أو خطأ",
 "まるひ": "سَرِّيّ, خُصُوصِيّ",
 "まるひしりょう": "بَالِغ السِّرِّيَّة (ذو أعلى درجات التصنيف السرّيّ)",
 "まるぶしゅかん": "تُرُنْج",
 "まるぼう": "جَرِيمة مُنَظَّمة",
 "まるぽちゃ": "سمين",
 "まるまっちい": "سمين",
 "まるまど": "نافذة مدورة (نافذة تؤدي إلى القوقعة)",
 "まるまま": "بِرُمَّتِهِ, بِكُلِّيَّتِهِ",
 "まるまる": "سمين / بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / حصرياً, فقط (دون تضمين أو إشراك أي آخرين)\nمثال: كان مقتنعاً كلياً / أَكِيد / مُتَأَكِّد / بَعْض ((بَعَضَه) البعوض بَعْضًا: لسعه وآذاه؛ (بَعَضَ) الشَّيْء: جعله أقساما) / مُحَدَّد (من الفعل حَدَّدَ؛ (في الرياضيات) مصطلح يستعمل في الجبر الخطي، ويتم تحديد محدد مصفوفة باستعمال صيغة لايبنتس أو صيغة لابلاس)\nمثال: لديك بعض الكتب.",
 "まるまるとふとった": "بَدِين جِدًّا, سَمِين مُفْرِطًا (مُفْرِط فِي السِّمْنَة والبَدَانَة) / فَخْم, مُسْتَدِير ((للأصوات) ممتلئ وغني) / كُرَوِيّ, مُكَوَّر (كرويّ الشكل؛ مستدير تمامًا)",
 "まるまるふとった": "بَدِين جِدًّا, سَمِين مُفْرِطًا (مُفْرِط فِي السِّمْنَة والبَدَانَة) / فَخْم, مُسْتَدِير ((للأصوات) ممتلئ وغني) / كُرَوِيّ, مُكَوَّر (كرويّ الشكل؛ مستدير تمامًا)",
 "まるみ": "استدارة, امتلاء (الخاصية الجسدية المتمثلة في الامتلاء والاستدارة) / استدارة (الخاصية التي يمتلكها خط أو سطح منحنٍ وغير ذي زوايا) / تقريب (صفة كون الأرقام مقربة (أعداد صحيحة)) / استدارة, رخامة (امتلاء نبرة الصوت)\nمثال: أعطانا النتائج بأرقام تقريبية / انتشاء, نشوة (المرح واللطف، كما من خلال تأثيرات الكحول أو الماريجوانا) / رقة لونية, نعومة (درجة ناعمة من اللون) / امتلاء, رقة (خاصية الإحساس الغني والممتع) / طراوة, نضج النكهة (طعم (خاصة للفاكهة) ناضج وكامل النكهة)\nمثال: رقة الضوء والظلال التي لا يمكن تحقيقها في الرخام",
 "まるみをおびた": "شِبْهُ مُسْتَدِير (مستدير إلى حدٍّ ما في المظهر أو الشكل)",
 "まるめ": "تَقْرِيب",
 "まるめこむ": "تَمَلَّقَ",
 "まるめごさ": "تقريب, خطأ التقريب ((رياضيات) خطأ في الحساب ينتج عن تقريب الأرقام إلى عدد مناسب من الخانات العشرية)\nمثال: كان الخطأ في الحساب يعزى إلى التقريب",
 "まるめる": "أَغْرَى, أَغْوَى / حَلَقَ (أصاب حَلْقه أو ضربه في حلقه؛ أزال شعر رأسه أو ذقنه كله بالمُوسَى)\nمثال: حلق زيري لحيته.",
 "まるやね": "قُبَّة",
 "まるゆう": "غَيْرُ مُضَرَّب, مُعْفًى مِنَ الضَّرِيبَة ((لِلسِّلَعِ أَوِ الأَمْوَالِ) لَا تُفْرَضُ عَلَيْهِ ضَرَائِب)",
 "まるカッコ": "أَقْوَاس, قَوْس",
 "まるシー": "حُقُوقُ النَّشْر, حُقُوقُ التَّأْلِيفِ وَٱلنَّشْر (صِيْغَةُ جَمْعٍ مُفْرَدُهَا: حق)\nمثال: الحقوق إنسانية.",
 "まるノコ": "مِنْشَار دَائِرِيّ",
 "まれ": "نَادِر",
 "まれにみる": "نَادِر",
 "まれに見る": "نَادِر",
 "まろ": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "まろい": "مُسْتَدِير, مُدَوَّر (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / مُسْتَدِير, كُرَوِيّ (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما) / جَوْلَة, مَرْحَلَة / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / مُنْثَنٍ / مُتَنَاغِم, مُنْسَجِم (يعيش في وئام وانسجام مع الآخرين) / مُنَاسِب, مُنْسَجِم (مُلَائِمٌ وَمُتَوَافِقٌ) / مُتَمَاثِل, مُتَنَاسِب (يُظهِر تكافؤاً أو تناسباً بين مكوّناته) / متناغم, منسجم (ممتع موسيقياً)",
 "まろうと": "ضَيْف, زَائِر / زَبُون",
 "まろうど": "ضَيْف, زَائِر / زَبُون",
 "まろびでる": "نَشَرَ, وَزَّعَ (وزّع بشكل منهجي أو استراتيجي (مثل القوات أو المنتجات)) / إطلاق, طرح (عملية التوزيع الرسمي لمنتج أو خدمة جديدة للجمهور) / أطلق, طرح (توزيع منتج أو خدمة جديدة رسمياً للجمهور)\nمثال: تنشر الولايات المتحدة أسلحتها في الشرق الأوسط",
 "まろび出る": "نَشَرَ, وَزَّعَ (وزّع بشكل منهجي أو استراتيجي (مثل القوات أو المنتجات)) / إطلاق, طرح (عملية التوزيع الرسمي لمنتج أو خدمة جديدة للجمهور) / أطلق, طرح (توزيع منتج أو خدمة جديدة رسمياً للجمهور)\nمثال: تنشر الولايات المتحدة أسلحتها في الشرق الأوسط",
 "まろぶ": "دَحْرَجَ, تَدَحْرَجَ / ثَنَى, لَفَّ (طوى شيئًا وجعله على شكل مزدوج؛ أعاد النظر أو غير مسار قراره أو تصرفه)",
 "まろやか": "مُسْتَدِير, مُدَوَّر (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / مُسْتَدِير, كُرَوِيّ (أدار جسمه باتجاه آخر؛ له شكل دَائِرِيّ) / دَائِرَة (في : الشكل الهندسي الذي ليس له نقطة بداية ولا نهاية ويتكون من قَوْس مستمر؛ الهيئة أو الجهة التي تدير امرا ما) / جَوْلَة, مَرْحَلَة / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: رجاء ضع دائرة حول الجواب الصحيح. / برخامة, بنعومة (بطريقة رخيمة) / ثَمِل قَلِيلًا, مُنْتَشٍ (فِي حَالَة نَشْوَة خَفِيفَة مِنَ الكُحُول أَوِ المُخَدِّرَات) / هادِئ, وَديع (لَطيف وهادِئ؛ نَضِج واعْتَدَل بِمُرور الوَقْت) / مُعَتَّق, نَاعِم (ذو نكهة ممتلئة ومُسْتَحَبّة بفضل التعتيق المناسب)",
 "まわし": "حِزَام, زُنَّار (خيط أو قطعة من جلد تستخدم لحَزْم النَبَات أو العِيدَان أو غيرها لتكوين حُزْمَة؛ النِطَاق، قطعة من الجِلْد الطَوِيل يلف حول الخَصْر إما ليمسك المَلابِس أو ليظهر الخصر) / سَيْر (أسَارَ، أي جعله يَسِير والفرق بين الإثنين أن سَيَّرَ فيها تكرار وأسارَ لا تكرار فيها؛ فلان من بَلَده أو مَوْطِنه: أخْرَجَه وأجْلاه)\nمثال: هذا حزام من الجلد. / وِشَاح / اِغْتِصَاب جَمَاعِيّ (أَخْذُ الشيء قَهْراً وَظُلْماً؛ اِسْتِخْدَامُ العُنْفِ مَعَ النساء لِنَيْلِ الحَاجَةِ مِنْهَن بِالرَّغْمِ عَنْهَن)\nمثال: تعرض زيري للاغتصاب.",
 "まわしぐるま": "عَجَلَة / عجلة / رويضة",
 "まわしびきのこぎり": "منشار ترددي, منشار صابر (منشار آلي محمول بشفرة ترددية؛ يمكن استخدامه مع مجموعة متنوعة من الشفرات حسب التطبيق ونوع القطع؛ يحتوي عموماً على لوحة تركب على السطح الذي يتم قطعه)",
 "まわしぶみ": "دَائِرِيّ (المنسوب إلى الدَائِرَة بمعنى الشكل الهندسي، ويقصد به ما كان شكله كالدائرة)\nمثال: التفاحة دائرية الشكل.",
 "まわしもの": "جَاسُوس / تَجَسَّسَ / طُعم, مروّج مخادع (طُعم يتصرف كزبون متحمس من أجل تحفيز مشاركة الآخرين)",
 "まわし者": "جَاسُوس / تَجَسَّسَ / طُعم, مروّج مخادع (طُعم يتصرف كزبون متحمس من أجل تحفيز مشاركة الآخرين)",
 "まわす": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار. / حَرُكَ, تَحَرَّكَ (غَيَّرَ مَوْضِعَهُ أو مَكَانَهُ أو حَالَه؛ حَرُكَ الوَلَدُ : تَحَرَّكَ، أَوْ خَرَجَ عَنْ سُكُونِهِ) / اِنْتَقَلَ, تَحَلْحَلَ\nمثال: لقد أوقفنا حركة المرور. / شَغَّلَ ((شَغَلَ) الدارَ يَشْغَلَ شَغْلًا: سكنها؛ شَغَلَ فلانًا عن الشيء: لَهَّاهُ وصرَفَه) / اِنْقَلَبَ عَلَى\nمثال: شغل بيل التلفاز. / وَضَعَ, حَطَّ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع.",
 "まわり": "مُحِيط (في : هو الخط المستدير الذي يُحيط بالشكل الهندسي؛ في : البَحْر المُحِيْط هو البحر الكبير الذي يحيط بالقارات. الاستخدام الحديث يحذف كلمة بَحْر؛ القَامُوْس)\nمثال: أسبح في المحيط. / دَوْرَة (في غرب العراق على نهر الفرات قرب الحدود السورية؛ حَيّ في جنوب بغداد تقع فيه محطة تكرير للنفط تسمّى بإسمه)\nمثال: خضع زيد لدورة مكثفة / انتشار, نشر (عملية الامتداد على نطاق أوسع أو مساحة من المكان أو الزمان) / إذاعة, نشر (فتح موضوع لمناقشة واسعة وجدل) / انتشار, تفشي (عملية أو نتيجة التوزيع أو الامتداد على مساحة واسعة من الفضاء) / تَأْثِير, أَثَر / بِوَاسِطَة, عَن طَرِيق / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)",
 "まわりあわせ": "ثَرْوَة",
 "まわりえん": "إفريز, كرنيش (الجزء البارز العلوي من السطح المعمد) / كورنيش (إطار زخرفي في الزاوية بين السقف وأعلى الجدار) / ستارة, كورنيش (هيكل زخرفي لإخفاء تركيبات الستائر في الجزء العلوي من غلاف النافذة)",
 "まわりくどい": "غَيْر مُبَاشِر, مُلْتَوٍ (يَنْحَرِف عَنِ المَسَار المُسْتَقِيم) / غَيْر مُبَاشِر, مُلْتَوٍ (يَتَّسِم بِالمُوَارَبَة أَوْ عَدَم المُبَاشَرَة فِي الكَلَام أَوِ السُّلُوك)",
 "まわりこみ": "رداء ملفوف (رداء (مثل فستان أو معطف) بفتحة كاملة الطول؛ يُضبط على الجسم بلفه حوله)",
 "まわりどおい": "دَوَّار (في : هي الدَار الكبيرة الفاخرة أو دار العُمْدَة. الجمع دُوَّارَات)\nمثال: كان لديها دوار.",
 "まわりぶち": "إفريز, كرنيش (الجزء البارز العلوي من السطح المعمد) / كورنيش (إطار زخرفي في الزاوية بين السقف وأعلى الجدار) / ستارة, كورنيش (هيكل زخرفي لإخفاء تركيبات الستائر في الجزء العلوي من غلاف النافذة)",
 "まわりまわって": "أَخِيرًا, فِي اَلْآخِرْ",
 "まわりみち": "تحويلة, طريق التفافي (طريق غير مباشر (خاصة الذي يستخدم مؤقتاً أثناء إغلاق الطريق الرئيسي))",
 "まわり道": "تحويلة, طريق التفافي (طريق غير مباشر (خاصة الذي يستخدم مؤقتاً أثناء إغلاق الطريق الرئيسي))",
 "まわる": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار. / دَوَائِر تَحْتَ ٱلْعَيْنَيْن (بمعنى الشكل الذي لا بداية له ولا نهاية بشكل قوس مستمر؛ بمعنى الهيئة أو الجهة الحكومية التي تدير أمرا ما) / وَظِيفَة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب) / مَهَمَّة / دَالَّة, تَابِع / وَظِيفَة, دَالَّة (ما يُقَدَّر من الشيء في زمن مُعَيَّن؛ مَنْصِب)\nمثال: ما وظيفة زوجتك؟ / نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "まゐらす": "حَالِيّ, حَاضِر / مَوْجُود, حَاضِر (الذي له وجود) / الزَّمَان, الْحَال / قَدَّمَ, طَرَحَ (ما يطأُ الأَرضَ من رجل الإِنسان؛ وفوقها السّاق، وبينهما المفصل المُسَمَّى الرُّسْغَ؛ أنّ لهم سابقةً وفضلاً له عند فلان قَدَمٌ : معروف)\nمثال: أنا موجود لوحدي / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد) / دُو\nمثال: ماذا فعل للحمي؟",
 "まをおいて": "بشكل متقطع, على فترات (بطريقة متقطعة)\nمثال: استجوبنا البارومتر بشكل متقطع",
 "まをおく": "تَوَقَّفَ / تَوَقُّف, وَقْف",
 "まをとる": "تَوَقَّفَ / تَوَقُّف, وَقْف",
 "まをもたす": "مَعْلِف, مُرَاح / بَسْطة",
 "まをもたせる": "مَعْلِف, مُرَاح / بَسْطة",
 "まん": "عَشَرَة آلَاف / لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ) / عَشَرَة آلَاف (العدد الأصلي الذي هو حاصل ضرب عشرة في ألف) / عدد لا يحصى, كثرة كاثرة (عدد كبير غير محدد)\nمثال: واجه عدداً لا يحصى من التفاصيل / مُمْتَلِئ, مَلِيء / شِبَع, شبعان / مَنْشُورِيَا / كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه)",
 "まんいち": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "まんいちのため": "تَحَسُبًا",
 "まんいつ": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "まんいん": "بيت كامل, فل هاوس (يد بوكر تحتوي على ثلاث بطاقات من نوع واحد وزوج من نوع آخر)\nمثال: バスは満員だった。 — مُلئت الحافلة.",
 "まんいんおんれい": "بيت كامل, فل هاوس (يد بوكر تحتوي على ثلاث بطاقات من نوع واحد وزوج من نوع آخر)",
 "まんえつ": "طَرَب, نَشْوَة (طَرَّبَ الْمُغَنِّي: تَغَنَّى؛ طَرَّبَهُ بِغِنَاءٍ عَذْبٍ: هَزَّهُ، أَطْرَبَهُ، حَمَلَهُ عَلَى الطَّرَبِ)",
 "まんえん": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "まんえんぼうしとうじゅうてんそち": "كوفيد-19, كوڤيد-19",
 "まんかんぐうすうかんせい": "تشينغ, سلالة تشينغ (آخر سلالة إمبراطورية للصين (من 1644 إلى 1912) والتي أطاح بها الثوار؛ خلال سلالة تشينغ حكم المانشو الصين)",
 "まんかんしょくのふね": "كَامِل, وَافٍ (كامل من كلّ جهة ووجه) / بِلِبَاسٍ رَسْمِيّ ((عَنِ المُنَاسَبَاتِ) يَسْتَلْزِمُ ارْتِدَاءَ مَلَابِسَ رَسْمِيَّةٍ) / لِلْمُنَاسَبَاتِ الرَّسْمِيَّة (مُنَاسِبٌ لِلمُنَاسَبَاتِ الرَّسْمِيَّةِ)",
 "まんが": "كَارِيكَاتِير, كَارِيكَاتُور / جَرّافَة, كَاسِحَة",
 "まんがいち": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "まんがいつ": "طَوَارِئ, حَالَةْ اَلطَّوَارِئ",
 "まんがえいが": "كَارِيكَاتِير, كَارِيكَاتُور",
 "まんがか": "رسام كاريكاتير, رسام كرتون (شخص يرسم الرسوم الكاريكاتورية أو الكرتونية) / كَارِيكَاتِير, كَارِيكَاتُور",
 "まんがきっさ": "مقهى (مطعم صغير تباع فيه المشروبات والوجبات الخفيفة)",
 "まんがざっし": "قصص مصورة, كوميكس (مجلة مخصصة للقصص المصورة)",
 "まんがほん": "قصص مصورة, كوميكس (مجلة مخصصة للقصص المصورة)",
 "まんがぼん": "قصص مصورة, كوميكس (مجلة مخصصة للقصص المصورة)",
 "まんが喫茶": "مقهى (مطعم صغير تباع فيه المشروبات والوجبات الخفيفة)",
 "まんが家": "رسام كاريكاتير, رسام كرتون (شخص يرسم الرسوم الكاريكاتورية أو الكرتونية)",
 "まんき": "إخراج النفس, زفير (فعل إخراج الهواء من الرئتين) / رحيل, فقدان (تعبيرات ملطفة للموت) / انتهاء, انقضاء (وصول فترة العقد إلى نهايتها)\nمثال: نعى الآلاف رحيله",
 "まんきじつ": "مَوْعِد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "まんきつ": "مقهى (مطعم صغير تباع فيه المشروبات والوجبات الخفيفة)",
 "まんきび": "مَوْعِد (مَوْعِد الإفطار،أي وقت الإفطار؛ لديه مَوْعِد مع صديق)\nمثال: مناد عنده موعد.",
 "まんきゃくるい": "بَرْنَقِيل",
 "まんきん": "عَشَرَة آلَاف",
 "まんくう": "حَارّ, صَمِيمِيّ (صَادِق وَجَادّ فِي المَشَاعِر)",
 "まんげ": "شَعْر اَلْعَانَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "まんげきょう": "مِشْكَال, مِنْظَارُ التَّهَاوِيل",
 "まんげつ": "بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ بالغُرُوب طُلُوع الشَّمْسِ…؛ البَدْرُ الغلامُ المكتمل أو الممتلئ)",
 "まんこ": "كِس, كُس (الشيءَ: دقّه دقَّا شديدا أو ضغطه أو دعكه) / اللعين, جداً (أداة توكيد، عامية جداً وغير مهذبة) / مضاجعة, نكاح (مصطلحات عامية للجماع الجنسي)\nمثال: لماذا تأخرت وقتاً طويلاً؟",
 "まんこう": "حَارّ, صَمِيمِيّ (صَادِق وَجَادّ فِي المَشَاعِر)",
 "まんごう": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "まんごうまつだい": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "まんごすちん": "مَانْغُوسْتِين / مَانْجُوسْتِين / جَوْز جَنْدَم (جَوَّز لَهُمْ إِبِلَهم إِذا قَادَهَا بَعِيرًا بَعِيرًا حَتَّى تَجُوزَ)\nمثال: نريد أن نأكل نبات جوز الهند.",
 "まんさいきっすい": "مقياس (أداة قياس لقياس وتوضيح كمية مثل سمك السلك أو كمية المطر وما إلى ذلك) / عيار, قُطْر داخلي (قُطر أنبوب أو ماسورة سلاح ناري) / سُمك, عيار (سُمك السلك) / اتساع السكة (المسافة بين قضيبي السكة الحديدية أو بين عجلات القطار)",
 "まんさいきっすいせん": "خط التحميل, علامة بليمسول (خطوط مائية لإظهار المستوى الذي يجب أن يصل إليه الماء عندما تكون السفينة محملة بشكل صحيح)",
 "まんさん": "مُدْهِش, مُذْهِل (مُثير للإعجاب بشكل مُفاجئ لدرجة الذهول أو الإرباك) / اِمْرَأَة (أُنْثَى الْإِنْسَانِ الْبَالِغَةُ؛ زَوْجَةٌ)\nمثال: أنا امرأة قوية.",
 "まんざ": "بيت كامل, فل هاوس (يد بوكر تحتوي على ثلاث بطاقات من نوع واحد وزوج من نوع آخر)",
 "まんざい": "مِنْ بَابٍ إِلَى بَاب (لا يُغفِل أحدًا؛ يتنقّل من بيت إلى بيت) / مِنْ بَابٍ لِبَاب ((عَنِ الرِّحْلَات أَوِ التَّوْصِيلَات) مُبَاشَرَة مِنْ نُقْطَة الأَصْل إِلَى الوِجْهَة)",
 "まんざら": "بالكامل, بشكل تام (إلى درجة كاملة أو إلى الحد الأقصى؛ بالكامل) / إجمالاً, في المجموع (مع تضمين أو عد كل شيء) / بشكل عام, في الإجمال (مع أخذ كل شيء في الاعتبار) / كما ولدتني أمي (تعبيرات غير رسمية للعري)\nمثال: كان مقتنعاً كلياً",
 "まんしゅう": "مَنْشُورِيَا",
 "まんしゅうご": "لغة المانشو (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "まんしゅうじん": "منشوريا",
 "まんしゅうぞく": "لغة المانشو (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "まんしん": "فَخْر (اعتزَّ أو تباهى بشيء يملكه أو بعمل قام به؛ زها على الآخرين وأبدى شعوره بالتفوق) / زُمْرَة\nمثال: أنا شديدة الفخر بأبي.",
 "まんじ": "صَلِيب مَعْقُوف / عَجَبًا / سُبْحَانَ الله (مصدر للفعل سَبَحَ؛ تُقال حصرًا للَّٰه، كما في العبارة \"سُبْحَانَ اللَّٰهِ\")\nمثال: سبحان الله عما يشركون.",
 "まんじゅぎく": "قطيفة فرنسية (نبات سنوي كثيف قوي الرائحة برؤوس زهور برتقالية أو صفراء معلمة باللون الأحمر؛ المكسيك وغواتيمالا)",
 "まんじゅしゃげ": "سوس العنكبوت الأحمر, عنكبوت أحمر (سوس صغير يغزل الشباك؛ آفة خطيرة في البساتين)",
 "まんじょう": "كُلّ, جَمِيع",
 "まんじょういっち": "إجماع تام (أن يكون الجميع على رأي واحد)",
 "まんじょうそうだち": "تَصْفِيقٌ مَعَ الوُقُوف, تَصْفِيقٌ حَارّ",
 "まんじり": "تَقَيَّلَ, أَخَذَ قَيْلُولَة / قَيْلولة, سِنَة / بتركيز, بثبات (بطريقة ثابتة ومركزة)\nمثال: حدق بي بثبات",
 "まんずり": "عَادَة سِرِّيَّة / اِسْتِمْنَاء",
 "まんせい": "عَوِيص / مُزْمِن / زحف (طريقة تنقل بطيئة على اليدين والركبتين أو بجر الجسم)\nمثال: كان الزحف هو كل ما استطاع الرجل المصاب القيام به",
 "まんせいかんせつリウマチ": "الدَّاء الرَثَيَانِيّ, اِلْتِهَاب المَفَاصِل الرُّومَاتُويِدِيّ",
 "まんせいきかんしえん": "التهاب الشعب الهوائية المزمن (شكل من أشكال التهاب الشعب الهوائية يتميز بإنتاج مفرط للبلغم مما يؤدي إلى سعال مزمن وانسداد تدفق الهواء)",
 "まんせいこうじょうせんえん": "داء هاشيموتو (اضطراب مناعي ذاتي في الغدة الدرقية)",
 "まんせいしょうもうびょう": "مرض الهزال المزمن (مرض يصيب الحياة البرية (شبيه بمرض جنون البقر) ويؤثر على الغزلان والأيائل)",
 "まんせいしょくぶつ": "دابة الشجر, متسلق (أي من الطيور الصغيرة المتنوعة آكلة الحشرات في نصف الكرة الشمالي التي تتسلق جذوع الأشجار مستندة على ريش ذيل صلب وأقدامها) / زَاحِف (شخص يزحف أو يدب على الأرض) / مدادة, نبات زاحف (أي نبات (مثل اللبلاب أو العناقية) ينمو عن طريق الزحف)",
 "まんせいてき": "عَوِيص / مُزْمِن",
 "まんせいひろうしょうこうぐん": "قارن (انظر للمقارنة) / تليف كيسي (أكثر الأمراض الوراثية شيوعاً؛ تنسد رئتا الطفل وأمعاؤه وبنكرياسه بمخاط سميك؛ يسببه خلل في جين واحد؛ لا يوجد علاج معروف) / كاليفورنيوم (عنصر مشع ما بعد اليورانيوم؛ اكتشف بقصف الكوريوم بجسيمات ألفا)",
 "まんせいへいそくせいはいしっかん": "دَاء الاِنْسِدَاد الرِئَوِيّ المُزْمِن",
 "まんせき": "بيت كامل, فل هاوس (يد بوكر تحتوي على ثلاث بطاقات من نوع واحد وزوج من نوع آخر)",
 "まんぜん": "تَائِه, هَائِم (يسير بلا وجهة ولا اتّجاه محدّد) / تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر)",
 "まんぞく": "رِضَا, إِشْبَاع (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا. / كافٍ, وافٍ (كمية يمكن أن تلبي حاجة أو متطلبًا ولكن دون أن تكون وفيرة)\nمثال: طعام كافٍ / مُرِيح, مُطَمْئِن (يبعث على الراحة ويحرّر من القلق) / دَسِم, مُشْبِع (يوفّر غذاءً وافرًا ومُشبِعًا)",
 "まんぞくど": "رِضَا, إِشْبَاع (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "まんぞくのいく": "مُرِيح, مُطَمْئِن (يبعث على الراحة ويحرّر من القلق) / دَسِم, مُشْبِع (يوفّر غذاءً وافرًا ومُشبِعًا)",
 "まんたく": "بيت كامل, فل هاوس (يد بوكر تحتوي على ثلاث بطاقات من نوع واحد وزوج من نوع آخر)",
 "まんだい": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "まんだら": "ماندالا (أي من التصاميم الهندسية المختلفة (عادة دائرية) ترمز للكون؛ تستخدم بشكل رئيسي في الهندوسية والبوذية كأداة مساعدة للتأمل)",
 "まんだん": "دَرْدَشَ / مُحَادَثَّة / دَرْدَشَة",
 "まんちゃく": "خِدَاع, خَدْع",
 "まんちゃくしゅだん": "حِيلَة",
 "まんちょう": "ذروة المد, مد عالي (المد عندما يكون الماء في أعلى مستوياته)",
 "まんちょうせん": "علامة المد العالي (خط يحدد أعلى مستوى تم الوصول إليه)",
 "まんてん": "كَامِل / أَتْقَنَ ((أَتْقَنَه): أحكمه) / رَقِيع, سماء",
 "まんてんか": "جَمِيع أَنْحَاء, كُلّ",
 "まんどく": "رعي, قضم الأوراق (فعل التغذية عن طريق القضم المستمر) / تصفح (القراءة بشكل سطحي أو عشوائي)",
 "まんどころ": "مكتب حكومي (مكتب يعمل فيه موظفو الحكومة)",
 "まんな": "كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك.",
 "まんなか": "مُنْتَصَف, وَسَط / وَسَط, مُتَوَسْط",
 "まんなかわけ": "سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة أو منع أشعة الشمس)",
 "まんにょう": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "まんにん": "اَلْجَمِيع, كُلّ شَخْص",
 "まんにんむき": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة)",
 "まんねん": "عَشَرَة آلَاف / أَبَدِيّ, سَرْمَدِيّ / مُعَمِّر",
 "まんねんぐさ": "حَيّ الْعَالَم (ضد المَيِّت، على قيد الحَيَاة؛ جمع حَيَاء)\nمثال: ينبح كلب في الحي.",
 "まんねんごよみ": "تقويم دائم (مخطط أو جهاز ميكانيكي يشير إلى أيام الأسبوع المقابلة لأي تاريخ معين على مدى فترة طويلة من السنوات)",
 "まんねんたけ": "فطر الرف, فطر قوسي (فطر خشبي يشكل حوامل بوغية تشبه الرف على جذوع الأشجار والهياكل الخشبية)",
 "まんねんひつ": "قَلَم مِدَاد, قَلَم حِبْر سَائِل (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "まんねんぴつ": "قَلَم مِدَاد, قَلَم حِبْر سَائِل (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "まんねんふで": "قَلَم مِدَاد, قَلَم حِبْر سَائِل (قَطَعَ جزءا من شيء لتزيينه وتحسينه)\nمثال: ارسم بقلم رصاص.",
 "まんねんれい": "عُمْر ((في الإسلام) أبو حفص عمر بن الخطاب العدوي القرشي، ثاني الخلفاء الراشدين في المذهب السني) / سِنّ ((سَنَّ) السِّكِّينَ و نحْوَهُ يَسُنُّ سَنًّا: أَحَدَّهُ؛ فهو مسنون وسَنِين)\nمثال: جون في عمر أخي.",
 "まんねんろう": "إِكْلِيل الْغَار, إِكْلِيل الْجَبَل",
 "まんのう": "لِكُلّ الاسْتِخْدَامَات, مُتَعَدِّد الأَغْرَاض (غير مقيد في الاستخدام أو الوظيفة) / قَدِير, كُلِّيّ القُدْرَة (يمتلك قدرة غير محدودة)",
 "まんば": "إِهَانَة, سَبّ (تعبير وقح يهدف إلى الإساءة أو الأذى)\nمثال: عندما ارتكب الطالب خطأ غبياً لم يوفر له أي شتيمة",
 "まんぱい": "مُمْتَلِئ, مَلِيء / شِبَع, شبعان / مَضْغُوط, مَكْبُوس (مضغوط معًا أو مكبوس بإحكام) / مَحْشُوّ, مُكْتَظّ (مُزْدَحِمٌ لِلغَايَةِ أَوْ مَمْلُوءٌ حَتَّى أَقْصَى طَاقَتِهِ)",
 "まんびき": "سَرَقَةُ السِلَعَ مِنَ الـمَتَاجِر",
 "まんびきかぞく": "سارق متاجر (لص يسرق البضائع الموجودة في متجر)",
 "まんびょうやく": "ترياق عام, دواء لكل داء (علاج افتراضي لجميع العلل أو الأمراض؛ كان يسعى إليه الخيميائيون)",
 "まんぴょう": "بالإجماع (برأي واحد؛ بدون معارضة)\nمثال: وافق مجلس الشيوخ بالإجماع على مشروع القانون",
 "まんぷく": "اِنْتَهَى, أَكْمَلَ (بَلغ النهاية؛ اِنْتَهَى عُمرُهُ : مات) / كَامِل / ذَرِيع\nمثال: انتهى أمر زيري. / مُمْتَلِئ, مَلِيء / شِبَع, شبعان",
 "まんぷくど": "رَغْبَة, تَعَطُّش / جَاعَ (أَصَابَهُ الجُوعُ؛ أَصَابَهُ الفَقْرُ الشَّديدُ)\nمثال: جاع الرجل العجوز حتى الموت.",
 "まんべん": "كَافَّة, تَمَام / رَصِيد",
 "まんべんなく": "بِالتَّسَاوِي",
 "まんぼう": "سمكة شمس المحيط, مولا (من بين أكبر الأسماك العظمية؛ سمكة تعيش في عرض البحر ذات جسم بيضاوي مضغوط وزعانف ظهرية وشرجية عالية وزعنفة ذيلية مختزلة إلى فص يشبه الدفة؛ توجد…)",
 "まんぽ": "مُتَعَرِّج, مُتَلَوٍّ ((عَنِ الطَّرِيق) كَثِير المُنْعَطَفَات وَالِالْتِوَاءَات) / اِسْتِطْرَادِيّ, مُتَشَعِّب ((عَنِ الكَلَام وَالكِتَابَة) يَمِيل إِلَى الخُرُوج عَنِ المَوْضُوع الرَّئِيسِيّ) / مُتَرَامِي الأَطْرَاف, مُتَنَاثِر (يَمْتَدُّ فِي اتِّجَاهَاتٍ مُخْتَلِفَةٍ أَوْ مُوَزَّعٌ بِشَكْلٍ غَيْرِ مُنْتَظِم)",
 "まんぽけい": "مقياس الخطوات (أداة قياس لتسجيل عدد الخطوات المقطوعة في المشي)",
 "まんま": "كَـ, مِثْل / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: قصدته مثل نكتة. / مَعَ (يفيد الاجتماع والمصاحبة؛ مكان الاجتماع) / بِـ (الإلصاق: أمسكت بالشيء؛ الاستعانة: كتبت بالقلم)\nمثال: جئت مع أصدقائي. / طَعَام, أَكْل (كُلُّ مَا يُؤْكَلُ. مُرادفه أَكْل)\nمثال: ليس لدينا طعام.",
 "まんまく": "سِتَارَة (ما يُسدل على أبواب ونوافذ المباني والمَرْكَبَات وغيرها رغبةً في الخُصُوصِيَّة أو منع أشعة الشمس)",
 "まんまと": "بِنَجَاحٍ",
 "まんまる": "فَاتِن, قَشِيب",
 "まんまん": "بالكامل, تماماً (إلى أقصى درجة أو مدى؛ بشكل كامل أو كلي) / بشكل واف, تماماً (بشكل كاف؛ أكثر من ملائم) / بالكامل (في إشارة إلى كمية)\nمثال: نمى بالكامل / أَبَدًا / شَاسِع, وَاسِع",
 "まんまんしゃん": "بُوذَا, بُدّ",
 "まんまんなか": "النُّقْطَة المَيِّتَة (موضع المرفق عندما يكون على خط واحد مع ذراع التوصيل ولا يبذل عزم دوران)",
 "まんまんねん": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "まんめん": "جَمِيع أَنْحَاء, كُلّ",
 "まんもく": "على مَد البَصَر (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "まんゆう": "رحلة ترفيهية, نزهة (رحلة تُتخذ للمتعة)\nمثال: العديد من النزهات الصيفية إلى الشاطئ",
 "まんゆうきゃく": "متجول سياحي, متنزه (سائح يزور المعالم السياحية)",
 "まんよう": "أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "まんらん": "غَيْر مُبَالِي (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "まんりき": "مِنْجَلَة, مِلْزَمَة / رحوية, ملفاف (رافعة تدور في مستوى أفقي حول محور عمودي؛ تستخدم على السفن لرفع المرساة أو الأشرعة الثقيلة)",
 "まんりょう": "إخراج النفس, زفير (فعل إخراج الهواء من الرئتين) / رحيل, فقدان (تعبيرات ملطفة للموت) / انتهاء, انقضاء (وصول فترة العقد إلى نهايتها)\nمثال: نعى الآلاف رحيله / توت التوابل, توت المرجان (شجيرة ذات توت أحمر مرجاني؛ اليابان إلى شمال الهند) / توت المرجان, كشمش هندي (شجيرة نفضية من أمريكا الشمالية تزرع لعناقيدها الغزيرة من الثمار الحمراء المرجانية الشبيهة بالتوت)",
 "まんりょうび": "تاريخ انهاء الصلاحية (جملة الأَحوال والأحداث التي يمر بها كائن ما، ويَصْدق على الفرد والمجتمع، كما يَصْدق على الظواهر الطبيعية والإنسانية؛ هو تحديد الزمن باليَوْم والشَهْر والسَنَة أو ببعضهما. الأجَل أو الوَقْت)\nمثال: ما تاريخ اليوم؟",
 "まんるいホームラン": "اكتساح كامل, جراند سلام (الفوز بجميع الحيل في يد البريدج)",
 "まん丸": "فَاتِن, قَشِيب",
 "まん延": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "まん延防止等重点措置": "كوفيد-19, كوڤيد-19",
 "まん毛": "شَعْر اَلْعَانَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "まダニ": "قراد صلب (قراد له درع صلب على الظهر وأجزاء فم تبرز من الرأس)",
 "まー": "عَدْل (عَدْل) / فَقَط (لا أكثر، لا غير)\nمثال: هل يعاملون بالعدل / بشكل محتمل, بشكل مقبول (بطريقة مقبولة (ولكن ليست متميزة))\nمثال: تلعب التنس بشكل مقبول",
 "まーさん": "لَذِيذ / شَهِيّ",
 "まーじゃん": "مَا جُونْغ (انظر مَا)\nمثال: هلا! ما الجديد؟",
 "ま四角": "مُرَبَّع (كُلُّ ما يُرَبَّعُ؛ كُلُّ ما له أربعة أركانٍٍ) / مثال: لا توجد مثلثات مربعة.",
 "み": "بَحْر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا) / يَمّ (البَحْر) / بَحَر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا) / بحر (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر. / فَاكِهَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها) / ثَمَرَة, شَاذّ جِنْسِيًّا / أَثْمَرَ (أثمر الشجر: صار فيه الثمر؛ أثمر الشجر: طلع ثمره قبل أن ينضج)\nمثال: التفاح فاكهة لذيذة. / بِذْرَة, زَرِّيعَة / مَنْي / رَاضٍ, مُرْتَاح (رَاضَ (راضه)روضا ورياضا ورياضة: ذلله. يقال راض المهر وراض نفسه بالتقوى وراض القوافي الصعبة؛ (رَاضَ) الدر: ثقبه. فهو مروض وهي مروضة) / رَضَّى / مُحْتَوًى, مَضْمُون / كَمِّيَّة, نِسْبَة\nمثال: سامي غير راض بوظيفته. / نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن. / لَحْم, لحمة (ما يبقى من جسم الحيوان أو الإنسان بعد إزالة الجلد الأحشاء والعظم والشحم والدم والأعصاب. يتكون أساسا من العَضَلَات؛ ما يؤكل من لحم من الحيوان والطير والسمك عامة)\nمثال: أفضل لحم البقر. / ثُعْبَان, حَنَش / باتجاه الجنوب الجنوب الشرقي (إلى أو نحو أو في الجنوب الجنوب الشرقي) / ثَلَاثَة, ثَلَاث (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب. / لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد. / مشاهدة, نظر (فعل توجيه العينين نحو شيء ما وإدراكه بصرياً) / بحث بصري, نظر (فعل البحث بصرياً) / ذُو صَوْت, ذُو مَظْهَر (يبدو كما يُوصَف؛ يُستخدَم عادةً في التراكيب المركّبة)\nمثال: خرج ليلقي نظرة / حَاوَلَ, سَعَى (طَلَبَ، رَامَ) / حَاكَمَ (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر) / مُحَاوَلَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: حاول توم قتلنا! / ـِيَّة / مَيْدَان / مَكَان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / مَقْعَد (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود) / مَكَان, مكان (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة) / وَضَعَ, حط (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: هذا المكان مقدس / ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول. / أَغُسْطُس, آب (الشهر الثامن في السنة الروميّة)\nمثال: غادر فاضل البلد في الثالث و العشرين من أغسطس. / جَمِيل (حَسَن) / مَلِيح\nمثال: طقس اليوم جميل. / رُوح, نَفْس (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / سول\nمثال: كان سامي هو روح الحفلة. / ذَرَّى, نَسَفَ (ذَرَتِ الريحُ التُّرابَ: فَرَّقَتْهُ وَأَطَارَتْهُ؛ ذَرَى القمحَ: نَقَّاهُ فِي الرِّيحِ) / ذَرَّايَة, مِذْرَاة",
 "みあい": "مُرَاسَلَة",
 "みあいけっこん": "زَوَاج مُدَبَّر",
 "みあう": "مَاثَلَ / راسَلَ",
 "みあげた": "جَدِير بِالْإِعْجَاب",
 "みあげる": "عَجَبَ",
 "みあげるよう": "شَاهِق",
 "みあやまる": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "みあわす": "أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري. / تباين, مقابلة (فعل التمييز عن طريق مقارنة الاختلافات) / تباين (نطاق الكثافة البصرية واللون في صورة سلبية أو مطبوعة (أو المدى الذي تختلف فيه المناطق المتجاورة على شاشة التلفزيون في السطوع)) / تباين (التأثير الإدراكي الناتج عن تجاور ألوان مختلفة جداً) / حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي)\nمثال: هناك خط رفيع بين العقل والجنون",
 "みあわせ": "إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق) / انتظار, تأجيل (الوقت الذي يتم فيه انتظار إجراء ما)\nمثال: تسببت الإعادة الفورية في تأخير طويل جداً",
 "みあわせる": "أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري. / تباين, مقابلة (فعل التمييز عن طريق مقارنة الاختلافات) / تباين (نطاق الكثافة البصرية واللون في صورة سلبية أو مطبوعة (أو المدى الذي تختلف فيه المناطق المتجاورة على شاشة التلفزيون في السطوع)) / تباين (التأثير الإدراكي الناتج عن تجاور ألوان مختلفة جداً) / حد فاصل, خط فاصل (فصل أو تمييز مفاهيمي)\nمثال: هناك خط رفيع بين العقل والجنون",
 "みいだす": "اِكْتَشَفَ / اِخْتَارَ / حا َسـِب",
 "みいちゃんはあちゃん": "مُتَّبِع لِلصَّرْعَات, مُقَلِّد لِلْمُوضَة (شخص يتبع مجموعة متنوعة من البدع أو الصرعات)",
 "みいり": "مَحْصُول / حَوْصَلة / دَخْل, إِيرَاد (وَلَجَ؛ أَدْخَلَ. (تعدية خاصة بالباء))\nمثال: دخل توم المبنى. / مُحَمَّل, مُوَجَّه ((عَنِ العِبَارَات أَوِ الأَسْئِلَة) مَشْحُون بِدَلَالَات إِيحَائِيَّة وغَالِبًا مُضَلِّل) / ثَمِل تَمَامًا, سَكْرَان طَافِح (فِي حَالَة سُكْرٍ شَدِيد) / مُحَمَّل, مُكَدَّس (مَمْلُوء بِكَمِّيَّة كَبِيرَة) / محشو, مُلقَّم ((للأسلحة) معبأة بالذخيرة)\nمثال: مسدس ملقم",
 "みいる": "رَنَا ((رَنَا) رنوا ورنوا: أدام النظر في سكون طرف. ويقال رناه ورنا إليه ورنا له؛ (رَنَا) إلى حديثه: أصغى) / فَتَنَ",
 "みうける": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "みうごき": "حَرَكَة",
 "みうしなう": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ.",
 "みうた": "قَصِيدَة, شِعْر",
 "みうち": "نِسْبِيّ / قَرِيب, قَرِيبَة\nمثال: いつくしみは、身内から始めよう。 — الأقربون أولى بالمعروف. / صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / أتباع, أنصار (مجموعة من المتابعين أو المتحمسين)",
 "みうちびいき": "محسوبية الأقارب (المحاباة التي يظهرها من هم في السلطة للأقارب أو الأصدقاء المقربين (كإعطائهم وظائف))",
 "みうちネタ": "نُكْتَة خَاصَّة, نُكْتَة دَاخِلِيَّة (نكتة لا يقدرها سوى أفراد مجموعة معينة من الناس)",
 "みうめ": "مشمش ياباني (شجرة زينة يابانية بزهور بيضاء أو وردية عطرة وثمار صفراء صغيرة)",
 "みえ": "ثُلَاثِيّ / ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه. / جِلْسَة, جَلْسَة / تَكَلُّف / مِيِه",
 "みえい": "صُورَة / اِنْطِبَاع, سُمْعَة",
 "みえっぱり": "استعراضي, محب للظهور (شخص يتصرف عمداً بطريقة تجذب الانتباه)",
 "みえづらい": "غير مميز, غير واضح (غير محدد بوضوح أو ليس من السهل إدراكه أو فهمه)\nمثال: أشكال غير واضحة في الظلام",
 "みえにくい": "مُظْلِم",
 "みえぼう": "متأنق (رجل يهتم كثيراً بملابسه ومظهره)",
 "みえみえ": "بَدِيهِيّ, بَدَهِيّ",
 "みえる": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء",
 "みえるか": "تصور بصري, صورة بصرية (صورة ذهنية تشبه الإدراك البصري)",
 "みお": "مَمَرّ مَائِيّ (على مَمَرّ العصور: على طولها ومداها؛ على مَمَرّ الفصول: على تواليها وتعاقبها)\nمثال: الباب في نهاية الممر. / أَيْقَظَ (نبَّهه، ضد نَوَّمَه؛ الغبارَ: أثاره)\nمثال: أيقظ زيري السائق",
 "みおくり": "تَوْدِيع, حَفْل وَدَاع (تعبير منظم عن حسن النية عند بدء رحلة أو مشروع جديد) / انطلاق, ضربة البداية (بداية تعطى للمتسابقين)\nمثال: كنت هناك مع والدي عند الانطلاق / إرجاء, تأجيل (فعل التأجيل إلى وقت لاحق)",
 "みおくる": "مُرَافَقَة / أَجَّلَ (مُدَّة الشيء، وَقْت أو مَوْعِد انتهاء الشيء أو حلوله)\nمثال: اقترب أجل زيري. / دَفَنَ (دَفَنَهُ يَدْفِنُهُ: سَتَرَهُ، وواراه) / قَبَرَ (مَدْفَنُ الإِنسان، وَجَمْعُهُ قُبُور، والمَقْبَرُ الْمَصْدَرُ)\nمثال: دفن القط فضلاته.",
 "みおとし": "سهو, غفلة (خطأ ناتج عن عدم الانتباه) / إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة) / سهو, غفلة غير مقصودة (إغفال غير مقصود ناتج عن الفشل في ملاحظة شيء ما)",
 "みおとす": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "みおどり": "غطاس صغير (غطاس أوروبي صغير)",
 "みおぼえ": "ذَاكِرَة, حَافِظَة / ذِكْرَى / ذَاكِرَة",
 "みおぼえがある": "تَعَرَّفَ",
 "みおぼえのある": "مَأْلُوف",
 "みおぼえのない": "غَيْر مَأْلُوف (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "みおぼえる": "تَذَكَّرَ (تذكَّر الشَّيءَ: ذكره، استحضره بعد نسيان، وفطِن له؛ تذكَّرتِ المرأةُ: تَشَبَّهَتْ بِالرَّجُلِ) / اِسْتَذْكَرَ\nمثال: ليلى تذكر سامي.",
 "みおも": "حَامِل (اسم فاعل من حَمَلَ، أي الذي يحمل شيئا؛ امرأة حَامِل: حُبْلَى، في بطنها جَنْيِن، وإذا أريد اسم الفاعل يقال للمرأة حَامِلَة) / حَوامِلُ / حُبْلَى\nمثال: يبدو أنني حامل. / أُمّ, وَالِدَة (الوَالِدَة أو الجَدَّة، وقد يطلق على والدة الزوج مجازا؛ أمّ بالرضاعة: المرأة التي أرضعت الطِفْل صغيرا فتصبح كوالدته)\nمثال: هل ستأتي أم لا؟",
 "みおや": "سَلَف (مضى أو سبق في الزمن؛ تسوية الأرض للمزارعة باستخدام أداة تسمى \"المِسْلَفَة\")",
 "みおろしがた": "من أعلى لأسفل (لنهج في حل المشكلات يبدأ من أعلى مستوى مفاهيمي ويعمل نزولاً إلى التفاصيل)\nمثال: تحليل من أعلى لأسفل قد يبدأ بالنظر في اتجاهات الاقتصاد الكلي",
 "みおろす": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة. / اِحْتَقَرَ, أَهَانَ",
 "みか": "صَيَّاد, صَيَّادَة (اِسْمٌ وَصِفَةٌ لِلْأَسَد)",
 "みかい": "هَمَجِيّ / غير متطور, غير نامٍ (لم يتطور أو ينضج أو يكتمل صياغته) / غير مستغل, غير مطور (لم يتم تطويره أو تحسينه أو استغلاله أو استخدامه)\nمثال: كانت دورات التصميم الداخلي نادرة وغير متطورة",
 "みかいけつ": "عالق, غير محلول (لم يتم حله)\nمثال: العديد من الجرائم تبقى غير محلولة",
 "みかいこん": "سَطْحِيّ, غَيْرُ مُثَقَّف (يتصف بعدم التهذيب الثقافي أو افتقار الذوق الفكري) / بور, غير مزروع ((للأرض أو الحقول) غير معدة لزراعة المحاصيل) / سَاذَجٌ, غَيْرُ مُثَقَّفٍ ((عن الأشخاص) يفتقر إلى الثقافة أو المعرفة)",
 "みかいじん": "هَمَجِيّ, مُتَوَحِّش / هَمَجِيّ, بَرْبَرِيّ",
 "みかいたく": "غير متطور, غير نامٍ (لم يتطور أو ينضج أو يكتمل صياغته) / غير مستغل, غير مطور (لم يتم تطويره أو تحسينه أو استغلاله أو استخدامه)\nمثال: كانت دورات التصميم الداخلي نادرة وغير متطورة",
 "みかいとう": "بِلَا مُقَابِلٍ, غَيْرُ مَرْدُودٍ (لا يُرَدُّ بالمثل)",
 "みかいはつ": "غير متطور, غير نامٍ (لم يتطور أو ينضج أو يكتمل صياغته) / غير مستغل, غير مطور (لم يتم تطويره أو تحسينه أو استغلاله أو استخدامه)\nمثال: كانت دورات التصميم الداخلي نادرة وغير متطورة",
 "みかいふう": "غَيْرُ مَفْتُوح, مُغْلَق (لم يُفتَح بعد ولم يُفَكّ ختمه)",
 "みかいめい": "غَيْر مُوَضَّح (لم يتم توضيح سببه أو علته) / غَيْر مُفَسَّر (لم يُفسَّر أو يُوضَّح)",
 "みかえし": "تبطين, تغليف (تزويد شيء بسطح من مادة مختلفة) / تكسية خارجية, كسوة (غطاء واقٍ يحمي الجزء الخارجي من المبنى) / بطانة الحافة, سجاف (بطانة تطبق على حافة الملابس للزينة أو التقوية) / تكسية, قشرة خارجية (طلاء زخرفي لمبنى)",
 "みかえす": "أَعَادَ الفحص, رَاجَعَ (نظر مرة أخرى؛ فحص مرة أخرى)\nمثال: لنراجع وضعك / اِلْتَفَتَ, اِسْتَدَارَ",
 "みかえり": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ / مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / جانبي, غير مباشر (منحدر من جد مشترك ولكن عبر خطوط مختلفة) / مُتَجَاوِر, مُتَوَازٍ جَنْبًا إِلَى جَنْب (يَقَعُ أَوْ يَمْتَدُّ جَنْبًا إِلَى جَنْب) / إِضَافِيّ ثَانَوِيّ, مُلْحَق (إضافيّ لكنّه ثانويّ؛ مساعد)\nمثال: أبناء العمومة هم أقارب جانبيون",
 "みかえりしきん": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / جانبي, غير مباشر (منحدر من جد مشترك ولكن عبر خطوط مختلفة) / مُتَجَاوِر, مُتَوَازٍ جَنْبًا إِلَى جَنْب (يَقَعُ أَوْ يَمْتَدُّ جَنْبًا إِلَى جَنْب) / إِضَافِيّ ثَانَوِيّ, مُلْحَق (إضافيّ لكنّه ثانويّ؛ مساعد)\nمثال: أبناء العمومة هم أقارب جانبيون",
 "みかえりぶっし": "مُتَرَتِّب, مُصَاحِب (يحدث بالتزامن مع شيء آخر أو نتيجةً له) / جانبي, غير مباشر (منحدر من جد مشترك ولكن عبر خطوط مختلفة) / مُتَجَاوِر, مُتَوَازٍ جَنْبًا إِلَى جَنْب (يَقَعُ أَوْ يَمْتَدُّ جَنْبًا إِلَى جَنْب) / إِضَافِيّ ثَانَوِيّ, مُلْحَق (إضافيّ لكنّه ثانويّ؛ مساعد)\nمثال: أبناء العمومة هم أقارب جانبيون",
 "みかえる": "اِلْتَفَتَ, اِسْتَدَارَ",
 "みかぎる": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "みかく": "ذَوْق, طَعْم (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَوْق (الذَّوْقُ : حَاسَّةُ اللِّسَانِ وَبِهَا قُوَّةٌ تُدْرِكُ خَوَاصَّ الأَجْسَامِ الطَّعْمِيَّةَ؛ الذَّوْقُ : آدابُ السلوك التي تقتضي معرفة ما هو لائق أو مناسب في موقف اجتماعيّ معيّن) / ذَاقَ, تَذَوَّقَ (تناول شيئا من الطعام أو الشراب ليختبر طَعْمَه؛ جَرَّبَ، اِخْتًبَرَ، أَحَسَّ)\nمثال: أكره ذوق الكحول.",
 "みかくてい": "غير مؤكد (لم يتم إقراره أو تسويته نهائياً)\nمثال: خطاب اعتماد غير مؤكد",
 "みかくにん": "غير مؤكد (لم يتم إقراره أو تسويته نهائياً)\nمثال: خطاب اعتماد غير مؤكد",
 "みかくにんひこうぶったい": "صَحْن طَائِر (ساحة وسط الدَار. الجمع صحون؛ المستوي من الأرض)\nمثال: توم يلعب الصحن الطائر.",
 "みかぐら": "كاغورا (رقصة فخمة من ديانة الشنتو تشكل الآن جزءاً من مهرجانات القرى اليابانية)\nمثال: تُعد الكاغورا، وخاصة تلك الأشكال التي تتضمن سرد القصص أو إعادة تمثيل الخرافات، أحد التأثيرات الأساسية على مسرح نو",
 "みかけ": "بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "みかけじょう": "بَيِّن, جَلِيّ (مكشوف بوضوح للعقل أو الحواسّ أو الحكم)",
 "みかける": "لَاحَظَ / لَاحَظَ, اِنْتَبَهَ",
 "みかげいし": "صَوَّان, غْرَانِيت",
 "みかげ石": "صَوَّان, غْرَانِيت",
 "みかこう": "خَام, غَيْر مُعَالَج (لَمْ يُعَالَج أَوْ يُحَضَّر بِعَمَلِيَّة خَاصَّة) / خام, غير معالج (غير مغير عن حالته الأصلية أو الطبيعية) / خام, غير مكرر (غير مكرر أو معالج)\nمثال: سلع أولية (غير مصنعة)",
 "みかし": "مَالِح / مِلْحِيّ",
 "みかじめ": "إشراف, رقابة (الإدارة من خلال الإشراف على أداء أو تشغيل شخص أو مجموعة)",
 "みかずき": "هِلَال",
 "みかた": "زاوية نظر, منظور (موقف ذهني يتم من خلاله النظر إلى الأشياء) / مطل, نقطة مراقبة (مكان يمكن رؤية شيء ما منه)\nمثال: يجب أن ننظر في هذه المشكلة من وجهة نظر الروس / صَدِيق, صَدِيقَة (هو الصَاحِب والخّل الذي بينك وبينه صَدَاقَة)\nمثال: ليس لديه صديقة. / إسناد, دعم (فعل تحمل وزن أو تقوية شيء ما) / مُسَانِد, مُشَجِّع (يقدم الدعم والتشجيع)\nمثال: استند على الحائط للدعم",
 "みかづき": "هِلَال",
 "みかづきこ": "بحيرة متروكة, بحيرة هلالية (بحيرة على شكل هلال (مؤقتة غالباً) تتشكل عندما ينفصل تعرج للنهر عن القناة الرئيسية)",
 "みかど": "قَيْصَر, إِمْبْرَاطُور",
 "みかりばば": "عَجُوز",
 "みかん": "غَيْر مَنْشُور (غير منشور)\nمثال: رسائل ومذكرات غير منشورة / غير مكتمل, ناقص (غير كامل أو غير كلي؛ لم يتم إنجازه) / غَيْرُ مُكْتَمِل, نَاقِص (لَمْ يَكْتَمِلْ بَعْدُ)\nمثال: سرد غير مكتمل لحياته / يُوسُفِيّ, يُوسُف أَفَنْدِي / حمضيات (أي من الفواكه العديدة لجنس الحمضيات ذات القشرة السميكة واللب العصيري؛ تزرع في المناطق الدافئة) / حمضيات, شجرة حمضيات",
 "みかんこう": "غَيْر مَنْشُور (غير منشور)\nمثال: رسائل ومذكرات غير منشورة",
 "みかんせい": "غير مكتمل, ناقص (غير كامل أو غير كلي؛ لم يتم إنجازه) / غَيْرُ مُكْتَمِل, نَاقِص (لَمْ يَكْتَمِلْ بَعْدُ)\nمثال: سرد غير مكتمل لحياته",
 "みかんりょう": "غير مكتمل, ناقص (غير كامل أو غير كلي؛ لم يتم إنجازه) / غَيْرُ مُكْتَمِل, نَاقِص (لَمْ يَكْتَمِلْ بَعْدُ)\nمثال: سرد غير مكتمل لحياته / ناقص-غير كامل",
 "みがき": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل / تَحْسِين",
 "みがきえき": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل",
 "みがきがみ": "ورق صنفرة (ما ينمو على النبات من الأعلى والجوانب بشكل صفائح ذات لون أخضر أو مائل إلى الخضرة. انظر الصورة؛ جلود رقاق يُكتَبُ عليها)\nمثال: هات ورقة بيضاء.",
 "みがきこむ": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل",
 "みがきたてる": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل",
 "みがきをかける": "مسن دقيق (حجر شحذ مصنوع من الحجر الرملي الدقيق؛ يستخدم لشحذ شفرات الحلاقة) / أداة شحذ دقيق, مِصْقَلَة (أداة تتكون من عدد من الشرائح الكاشطة الدقيقة المثبتة في رأس آلة، تدور وتتردد لإعطاء لمسة ناعمة لثقوب الأسطوانات، إلخ) / بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل",
 "みがく": "بُولَنْدِيّ / لَمَّعَ (لمع أي أصدر ضَوْءً أو عَكَسَهُ) / صَقَل / حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "みがって": "أَنَانِيّ",
 "みがはいる": "يَنَعَ, نَضَجَ (أَيْنَعَ؛ نَضَجَ)",
 "みがひきしまる": "دَاعٍ إِلَى الجِدِّيَّة, مُنَبِّه (يميل إلى جعل المرء أكثر جدّية ورصانة)",
 "みがほそる": "فَقَدَ وَزْن",
 "みがまえ": "وَضْعِيَّة",
 "みがらかくほ": "اعتقال, قبض (فعل القبض (خاصة القبض على مجرم)) / إدراك, استيعاب (الحالة المعرفية لشخص يفهم) / تخوف, توجس (توقع مؤلم أو شعور بالقلق من المستقبل) / توجس, خشية (توقع أو تحسب خائف)\nمثال: حصل الشرطي المناوب على التقدير للقبض على المجرم",
 "みがらこうそく": "حَبْس (مَنَعَ الشيءَ عن الفعلِ؛ أَمْسَكَ الشيءَ، قَبَضَ عَلَيْهِ) / حِرَاسَة نَظَرِيَّة\nمثال: هو,البارحة حرر من الحبس.",
 "みがらをこうそくする": "اِعْتَقَلَ (أمسك الأطراف وربطها، بمعنى عَقَلَ؛ أمسك ووضع في السجن أو المَعْقَل)\nمثال: اعتقل لقيادته و هو سكران.",
 "みがる": "رَشِيق, خَفِيف اَلْحَرَكَة / سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / عَابِث, لَامُبَالٍ (يَتَّسِمُ بِعَدَمِ الِاكْتِرَاثِ وَالِاسْتِهْتَارِ) / بِلَا جُهْد, يَسِير (لَا يُظْهِر جُهْدًا أَوْ إِجْهَادًا) / عَادِيّ, يَوْمِيّ (مُنَاسِبٌ لِلْمُنَاسَبَاتِ العَادِيَّةِ أَوِ الرُّوتِينِيَّةِ) / مُرْتَاحُ اَلْبَالِ, خَالِي اَلْقَلْبِ",
 "みがるい": "خَفِيف الحَرَكَة, رَشِيق (يتحرّك بسرعة وخفّة) / رَشِيق الذِّهْن, سَرِيعُ الْبَدِيهَة (سريع الفهم والاستيعاب ذهنيًّا)",
 "みがわり": "إحلال, استبدال (عملية وضع شيء أو شخص مكان آخر) / إحلال, استبدال (حدث يتم فيه استبدال شيء بشيء آخر)\nمثال: استبدال الدم المفقود بنقل دم المتبرع",
 "みき": "جِذْع (في علم النبات: أحد أجزاء النبات الذي يحمل الأغصان ويتصل في أسفله بالجذر) / عَمُود فَقْرِيّ / دِعَامَة / شَجَاعَة",
 "みきき": "مَعْلُومَات, مَعْلُومَة",
 "みきく": "خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "みきてい": "غير محدد (غير مذكور بصراحة أو بالتفصيل)\nمثال: هدد بـأعمال انتقامية غير محددة",
 "みきにゅう": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "みきょういく": "غير مدرب (غير منضبط أو مكيف أو ماهر بسبب التدريب)\nمثال: صوت غير مدرب",
 "みきり": "هِجْرَان, هُجْرَان / حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما) / حافة, طرف (الحد الخارجي لجسم أو منطقة أو سطح؛ مكان أبعد ما يكون عن مركز الشيء) / أَفْضَلِيَّة نِسْبِيَّة, تَفَوُّق بَسِيط (ميزة تنافسية طفيفة) / حدة (سمة الإلحاح في نبرة الصوت)\nمثال: قام بتدوير حواف الصندوق",
 "みきりうり": "بيع تصفية, تصفية (بيع لتقليل المخزون)",
 "みきりせん": "حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "みきりをつける": "غَسَلَ يَدَيْهِ مِنَ الْأَمْرِ (معنى غَسَّلَ، بِالتَّشْدِيدِ، اغْتَسَلَ بعدَ الجِمَاع، ثمّ اغْتسلَ للجُمُعَة،التَّغْسيل: المُبَالَغةُ فِي غَسْلِ الأعْضاءِ؛ غسّل الأعضاء:بالغ في غسلها أو تنظيفها،غسّل الميّت:غسل جسمه بالماء،طَهَّرَه ونقّاه)\nمثال: سأذهب لغسل يدي.",
 "みきる": "تَنَازَلَ / تَخَلَّى / اِسْتَسْلَمَ",
 "みきわめる": "تَيَقَّنَ, تَثَبَّتَ",
 "みぎ": "يَمِين, يمين / صَحِيح, صَوَاب / قَائِم / عَلَى اَلْيَمِين (يفيد الاستعلاء؛ يفيد التعليل) / إِلَى اَلْيَمِين (حرف جر يُفيد الغاية الزمنية؛ حرف جر يُفيد الغاية المكانية) / صحيح, تمام / حَقّ, حُقُوق (اسم من الأسماء الحسنى وهو من صفات الله. لا جمع له؛ ضد البَاطِل، العَدْل والحَقِيْقَة والوُجُوْد الثَابِت والصِدْق والذي لا جدال فيه. لا جمع له) / صَحَّحَ (جعل الشيء صحيحًا أو خاليًا من الأخطاء؛ أظهر صحة معلومة أو حقيقة)\nمثال: أجب على السؤال. / يَمِين, يُمْنَى / أَعْلَى (اسم تفضيل من عَلَا/ علا في؛ أكثر ارتفاعًا، عكْسه أسفل سقط من أعلى المبنى) / فَوقَ / شَمَالِيّ / على (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: خذها إلى الأعلى. / أَفْضَل, أَحْسَن / حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "みぎあがり": "زراعي, نمو (متعلق أو مناسب للنمو) / تنمية البلورات ((إلكترونيات) إنتاج بلورات (شبه موصلة) عن طريق التبلور البطيء من الحالة المنصهرة) / تطور, نشوء ((علم الأحياء) عملية نمو الكائن الفردي عضويًا؛ تكشف بيولوجي بحت للأحداث المتضمنة في تغير الكائن الحي تدريجيًا من مستوى بسيط إلى مستوى أكثر تعقيدًا)\nمثال: موسم زراعة الذرة",
 "みぎうで": "مساعد أيمن (المساعد الذكر الأكثر فائدة)",
 "みぎうわて": "أَيْمَن (صفة لما كان يقع على جهة اليمين؛ ضد أَيْسَر؛ صفة لمن كان كثير اليُمن والبركة)\nمثال: لدى توم وشم في ذراعه الأيمن.",
 "みぎおく": "يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "みぎかたあがり": "زراعي, نمو (متعلق أو مناسب للنمو) / تنمية البلورات ((إلكترونيات) إنتاج بلورات (شبه موصلة) عن طريق التبلور البطيء من الحالة المنصهرة) / تطور, نشوء ((علم الأحياء) عملية نمو الكائن الفردي عضويًا؛ تكشف بيولوجي بحت للأحداث المتضمنة في تغير الكائن الحي تدريجيًا من مستوى بسيط إلى مستوى أكثر تعقيدًا)\nمثال: موسم زراعة الذرة",
 "みぎかたさがり": "متناقص (يصبح أقل أو أصغر) / متخافت (موسيقى) ((موسيقى) يتناقص في السرعة و/أو الحجم)",
 "みぎからひだりへ": "بأذن واحدة (بطريقة تستخدم أذناً واحدة)\nمثال: تم تقديم المحفزات بأذن واحدة",
 "みぎがわ": "يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "みぎきき": "أيمنية, تيامن (تفضيل استخدام اليد اليمنى)",
 "みぎさがり": "متناقص (يصبح أقل أو أصغر) / متخافت (موسيقى) ((موسيقى) يتناقص في السرعة و/أو الحجم)",
 "みぎだしゃ": "أَيْمَن (صفة لما كان يقع على جهة اليمين؛ ضد أَيْسَر؛ صفة لمن كان كثير اليُمن والبركة)\nمثال: لدى توم وشم في ذراعه الأيمن.",
 "みぎっかわ": "يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "みぎて": "يَمِين, يُمْنَى / يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "みぎてざひょうけい": "أَيْمَن (صفة لما كان يقع على جهة اليمين؛ ضد أَيْسَر؛ صفة لمن كان كثير اليُمن والبركة)\nمثال: لدى توم وشم في ذراعه الأيمن.",
 "みぎてのほうそく": "يَدٌ يُمْنى (الأكْثَر عَوْنًا وَمَوْثوقِيَّة)",
 "みぎにおなじ": "أيضاً, علامة التكرار (علامة تُستخدم للإشارة إلى تكرار الكلمة الموجودة أعلاها)",
 "みぎにでる": "فَاقَ, تَجَاوَزَ",
 "みぎのみみからひだりのみみ": "بأذن واحدة (بطريقة تستخدم أذناً واحدة)\nمثال: تم تقديم المحفزات بأذن واحدة",
 "みぎへならえ": "تَقْلِيد",
 "みぎまき": "بِإِتِّجَاه عَقَارِب السَّاعَة",
 "みぎまわり": "دوران باتجاه عقارب الساعة, دوران يميني (دوران إلى اليمين)",
 "みぎり": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "みぎれい": "دَقِيق, مُتْقَن (خالٍ من الخَرَق؛ مُنفَّذ بدقة ومهارة) / صِرْف, غَيْر مَمْزُوج ((عَنِ المَشْرُوب الكُحُولِيّ) بِدُون مَاء) / رَائِع, مُمْتَاز (ممتاز؛ بالغ الجودة) / أَنِيق ظَاهِرِيًّا, بَرَّاق (يبدو مؤثّرًا من السطح لكنّه يفتقر إلى العمق والدقّة)",
 "みぎわ": "شَاطِئ, سَاحِل (المنطقة اليابسة على طول حافة البحر والمحيط. شَطّ، سَاحِل، جَانِب؛ (غير شائعة) المنطقة اليابسة على طول حافة النهر. ضِفَّة، جَانِب، شَطّ)\nمثال: عاد إلى الشاطئ.",
 "みぎわせん": "خط الساحل, شاطئ (خط الحدود بين اليابسة والماء)",
 "みぎん": "وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي الوَقْتِ الْمُنَاسِبِ \" : فِي اللَّحْظَةِ الْمُنَاسِبَةِ) / مَرَّة, مرة (مؤنث مُرّ، صفة ما كان بها مرارة) / حِين, وَقْت ((حَيَّنَه): جعل لَهُ حينا؛ (حَيَّنَ) الله فلَانا: لم يوفقه للرشاد)\nمثال: حان وقت الذهاب.",
 "みぎハンドル": "يَمِين, يُمْنَى",
 "みぎバッター": "أَيْمَن (صفة لما كان يقع على جهة اليمين؛ ضد أَيْسَر؛ صفة لمن كان كثير اليُمن والبركة)\nمثال: لدى توم وشم في ذراعه الأيمن.",
 "みくだりはん": "تَفْرِقَة",
 "みくに": "دَوْلَة, بَلَد (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة) / رِيف, ريف (أرْض فيها زَرْع وخِصْب، بعكس الصَحْرَاء؛ أرْض يَزْرعها الناس، ضَيْعَة) / كونتري, كنتري / رِيفِيّ, نِسْبَة إِلَى الرِّيف\nمثال: لبنان دولة صغيرة. / الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "みくにことば": "يَابَانِيّ",
 "みくびる": "صَغَّرَ, اِحْتَقَرَ (جعل الشيء أصغر حجمًا أو أقل قيمة؛ قلل من أهمية شخص أو شيء أو استهان به)\nمثال: الصغر أسرع من النسر",
 "みくらべる": "أخذ بعين الاعتبار (تَنَاوَلَ الشيء بيده، تملكه أو تحكم فيه، بالقوة أو بدونها؛ أمْسَكَ بِالشيء. (يتعدى بالباء))\nمثال: أخذ الولد يبكي.",
 "みぐし": "شَعْرَة / شَعْر, شَعْرَة (العِلْم؛ في : هو كلام مُقَفَّى ومُوَازَن على أوزان معروفة يُقصد به إظهار الكلام بصيغة فنية)\nمثال: شعر ماريا طويل.",
 "みぐるしい": "كَرِيه المَنْظَر (غير سار للنظر)",
 "みけ": "أَبْلَق, مُتَعَدِّد الأَلْوَان (ذو أجزاء أو بقع ملوّنة بألوان مختلفة وزاهية عادةً) / كاليكو, منقط (مصنوع من الكاليكو (قماش قطني) أو يشبه الكاليكو في كونه منقوشاً) / كاليكو (قماش خشن ذو طباعة زاهية)\nمثال: فساتين كاليكو / قط ذبل, قط كاليكو (قط ذو علامات سوداء وكريمية وصفراء)",
 "みけいか": "سارٍ, غير منتهي الصلاحية (لم ينتهِ أو يُلغَ بمرور الوقت)\nمثال: انتخب لملء فترة السيناتور غير المنتهية",
 "みけいけん": "عديم الخبرة, غشيم (يفتقر إلى الخبرة العملية أو التدريب)",
 "みけいけんしゃ": "بريء, قليل الخبرة (شخص يفتقر إلى معرفة الشر)",
 "みけっさい": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ) / بَارِز, عَظِيم (ذو أهمّيّة أو دلالة كُبرى) / غَيْرُ مُسَدَّد, مُسْتَحَقّ (مُسْتَحَقٌّ كَدَيْن) / بَارِع, مُتَمَيِّز (يتميز عن غيره بالتفوق)",
 "みけっさん": "لَافِت, مُلْفِتٌ لِلنَّظَرِ (لَهُ صِفَةٌ تَفْرِضُ نَفْسَهَا عَلَى الِانْتِبَاهِ) / بَارِز, عَظِيم (ذو أهمّيّة أو دلالة كُبرى) / غَيْرُ مُسَدَّد, مُسْتَحَقّ (مُسْتَحَقٌّ كَدَيْن) / بَارِع, مُتَمَيِّز (يتميز عن غيره بالتفوق)",
 "みけってい": "غَيْر مَحْسُوم (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به) / مُتَرَدِّد\nمثال: أنا غير متفاجئ.",
 "みけつ": "قَيْدَ الِانْتِظَار, مُعَلَّق (فِي انْتِظَارِ الِاخْتِتَامِ أَوِ التَّأْكِيدِ)",
 "みけねこ": "قط ذبل, قط كاليكو (قط ذو علامات سوداء وكريمية وصفراء)",
 "みけん": "حَاجِب (قوس الشعر فوق كل عين) / جبهة, جبين (جزء الوجه فوق العينين) / قمة التلة (قمة التل)\nمثال: غربت الشمس خلف قمة التلال البعيدة / لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "みこ": "اِبْن اللَّٰه (الولد الذكر)\nمثال: هو له ابن صغير.",
 "みこあいさ": "بلقشة بيضاء (أصغر أنواع البلقشة وأكثرها مهارة في الغوص؛ توجد في شمال أوراسيا)",
 "みこうかい": "غَيْر مَنْشُور (غير منشور)\nمثال: رسائل ومذكرات غير منشورة",
 "みこうかいかぶ": "سهم خارج المقصورة, سهم غير مدرج (سهم غير مدرج ومتداول في بورصة منظمة)",
 "みこうひょう": "غَيْر مَنْشُور (غير منشور)\nمثال: رسائل ومذكرات غير منشورة",
 "みこころ": "رُوح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / رُوَح (رَوَّحَ عليه بالمِرْوحَة: حَرَّكَها ليجلبَ إِليه نسيمَ الهواء؛ رَوَّحَ بالقوم: صلَّى بهم التراويح) / كُحُول (سَائِلٌ لاَ لَوْنَ لَهُ، لاَذِعُ الطَّعْمِ، يُسْتَخْرَجُ مِنْ تَخْمِيرِ بَعْضِ الْمَوَادِّ، يُمْزَجُ بِالْمَشْرُوبَاتِ الرُّوحِيَّةِ…)\nمثال: كان سامي هو روح الحفلة.",
 "みこし": "حَمَّالَة, مِحَفَّة / مُسْتَدَقّ الظَّهْر / تنبؤ, توقع (فعل التنبؤ (عن طريق التفكير في المستقبل)) / ترقب, توقع (شيء متوقع حدوثه (بناءً على معيار معين)) / ترقب, توقع (توقع حدوث شيء) / ترقب, توقع (الترقب مع الثقة بالتحقق)\nمثال: كان لكل منهم توقعاته الخاصة",
 "みこしをあげる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "みこしを上げる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "みこす": "تَوَقَّعَ, اِرْتَقَبَ",
 "みこすりはん": "سرعة القذف, قذف مبكر (القذف خلال المراحل المبكرة من الإثارة الجنسية أو بعد فترة وجيزة من إيلاج القضيب في المهبل)",
 "みこすり半": "سرعة القذف, قذف مبكر (القذف خلال المراحل المبكرة من الإثارة الجنسية أو بعد فترة وجيزة من إيلاج القضيب في المهبل)",
 "みこと": "رَبّ (رَبَّ الولدَ يَرُبُّ رَبًّا: ولِيَه وتعهده بما يغذيه وينميه ويؤدّبه؛ الفاعل: رَابٌّ، والمفعول: مَرْبوبٌ، وربيبٌ)\nمثال: اعتني بي يا رب. / مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "みことのり": "مرسوم إمبراطوري (مرسوم يصدره حاكم ذو سيادة)",
 "みことば": "كَلَام اللّٰهِ",
 "みこのみこと": "وَلِيّ عَهْد (مَلَكَ الأمر وقَامَ به وسيطر عليه وولي عليه ولايةَ)\nمثال: ولي العهد هو من يرث العرش.",
 "みこみ": "أَمَلَ, رَجَا ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / أَمَل, رَجَاء ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل. / أفق, استشراف (اعتقاد بشأن المستقبل (أو تصور ذهني له)) / توقع رياضي, قيمة متوقعة (مجموع قيم متغير عشوائي مقسوماً على عدد القيم) / توقع (الشعور بأن شيئاً ما على وشك الحدوث) / ترقب, توقع (الترقب مع الثقة بالتحقق)",
 "みこみちがい": "حساب خاطئ, سوء تقدير (خطأ في الحساب)",
 "みこむ": "تَوَقَّعَ, اِرْتَقَبَ / ثِقَة / تْرَسْت, اِئْتِمَان / وَثِقَ (أمن له ولم يظن انه يخون)\nمثال: وثق سامي بليلى ثقة عمياء. / دَرَجَة / أَشَّرَ (مَرِحٌ؛ نَشِط)\nمثال: الصهاينة أشر من النازيين.",
 "みこよせ": "روحانية (الاهتمام بأمور الروح)",
 "みこん": "سَطْحِيّ, غَيْرُ مُثَقَّف (يتصف بعدم التهذيب الثقافي أو افتقار الذوق الفكري) / بور, غير مزروع ((للأرض أو الحقول) غير معدة لزراعة المحاصيل) / سَاذَجٌ, غَيْرُ مُثَقَّفٍ ((عن الأشخاص) يفتقر إلى الثقافة أو المعرفة) / أعزب, غير متزوج (غير متزوج أو يتعلق بحالة العزوبية)\nمثال: رجال ونساء غير متزوجين",
 "みごしらえ": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / ثَوْب, لِبَاس (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء) / كَسْوَة, مَلْبَس\nمثال: لبس سروالا نظيفا.",
 "みごたえ": "بَلِيغ, مُؤَثِّر (يُنتج أثراً قويّاً) / مؤثر, مثير للإعجاب (يترك انطباعاً قوياً أو حياً)\nمثال: احتفال مثير للإعجاب",
 "みごと": "بَاهِر, رَائِع (يتمتع بجمال وروعة عظيمين) / بَهِيّ, رَائِع (يتّسم بالعظمة والفخامة) / رَفِيع, مُتَأَلِّق (جيد جدًا؛ من أرقى مستويات الجودة) / نَطَقَ بِ (بمعنى الحزام؛ تحريف نُطْق. )\nمثال: يسهل نطق اسم توم / مَشْهَد / مَنْظَر",
 "みごなし": "خفة الحركة, مرونة (رشاقة شخص أو حيوان سريع وخفيف الحركة)",
 "みごろ": "صدرية الفستان (جزء من الفستان فوق الخصر)",
 "みさい": "غير مكتمل, غير منتهٍ (لم يتم الانتهاء منه أو اختتامه) / غير تام الصنع, غير جاهز (لم يتم إيصاله للحالة النهائية المطلوبة) / خَامّ, غَيْرُ مَطْلِيّ (يَفْتَقِرُ إِلَى تَشْطِيبٍ سَطْحِيٍّ كَالطِّلَاء)\nمثال: أعمال غير منتهية / بلا أجر, غير مدفوع (لم يتم الدفع له) / تَرْفِيهِيّ, هَاوٍ (يُمارَس كهواية أو تسلية) / تَطَوُّعِيّ, غَيْرُ مَأْجُور (بِدُونِ مُقَابِلٍ مَادِّيّ)\nمثال: أجور غير مدفوعة",
 "みさお": "إِخْلَاص (وقيل: الإخلاص تصفية الأعمال من الكدورات؛ وقيل: الإخلاص: ستر بين العبد وبين الله تعالى لا يعلمه ملك فيكتبه، ولا شيطان فيفسده، ولا هوًى فيميله. والفرق بين الإخلاص والصدق: أن الصدق أصل…) / وَلَاء / عِفَّة, طَهَارَة",
 "みさかい": "تَمْيِيْز",
 "みさかいない": "اعتباطي, عشوائي (لا يتميز بتمييزات دقيقة (يخلط الحابل بالنابل)) / عَشْوَائِيّ, غَيْر مُمَيِّز (يُخْفِق فِي التَّمْيِيز بَيْنَ الأَشْيَاء)\nمثال: عادات قراءة عشوائية",
 "みさかいなく": "بشكل عشوائي, دون تمييز (بطريقة عشوائية) / بشكل عشوائي, دون تمييز (بطريقة غير مميزة)\nمثال: كانت المنازل مبعثرة عشوائياً",
 "みさき": "رَأْس (عُضْو مِنَ ٱلْجَسَدِ يَحْوِي الدِّمَاغ والفَم والأَنْف والعَيْنَيْن والأُذُنَيْن؛ أَعْلَى ٱلشَّيْءِ)\nمثال: قطع سامي رأس كلب.",
 "みさげはてた": "حقير, دنيء (يستحق الازدراء أو الاحتقار)",
 "みさげはてる": "اِحْتَقَرَ, أَهَانَ",
 "みさげる": "تَرَفَّعَ",
 "みさご": "عُقَاب نُسَارِيّ, عُقَاب نُسَارِيَّة (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "みさだめる": "تَيَقَّنَ, تَثَبَّتَ",
 "みさらし": "غَيْر مَصْبُوغ, غَيْر مُبَيَّض (لم يُلوَّن أو يُبيَّض صناعيًّا)",
 "みざくら": "شجرة الكرز, كرز (أي من العديد من الأشجار والشجيرات التي تنتج فاكهة مستديرة لحمية صغيرة بنواة صلبة واحدة؛ ينتج الكثير منها أيضاً خشباً صلباً قيماً)",
 "みざらし": "غَيْر مَصْبُوغ, غَيْر مُبَيَّض (لم يُلوَّن أو يُبيَّض صناعيًّا)",
 "みしみし": "بِأَزِيز, بِصَرِير (بطريقة تصدر صريراً)\nمثال: كان القارب القديم يتحرك بصرير",
 "みしゅう": "مُتَرَاكِم, مُسْتَحَقّ (يتراكم دورياً مع مرور الوقت)",
 "みしゅうがく": "روضة أطفال, مرحلة ما قبل المدرسة (مؤسسة تعليمية للأطفال الصغار جداً على المدرسة الابتدائية)",
 "みしゅうさい": "غير مُدرج (غير موجود في قائمة) / غَيْرُ مُدْرَجٍ (لم يُدرج اسمه في قائمة الناخبين)\nمثال: رقم هاتف غير مدرج",
 "みしゅうにゅうきん": "حِسَاب مَدِين (بمعنى عَدَّ وجَمَعَ وطَرَحَ كلها معا. جمعه حُسْبَان؛ الاسم من المُحَاسَبَة، لأن فيه تُحسب المحاسن والأخطاء)\nمثال: الحساب لو سمحت.",
 "みしゅつ": "غَيْر مَنْشُور (غير منشور)\nمثال: رسائل ومذكرات غير منشورة",
 "みしょう": "مَجْهُول, مُبْهَم / مُتَغَيِّر / غَامِض, غَوَامِض / شَتْلَة / جنيني, غير مولود (لم يولد بعد)\nمثال: أجيال لم تولد بعد",
 "みしょうか": "غَيْر مَهْضوم (لَمْ يَتِمّ هَضْمُه بَعْد) / غَيْر مَهْضُوم ذِهْنِيًّا (لم يُفكَّر فيه ويُرتَّب بشكل منهجي في العقل؛ لم يُستوعَب ذهنياً) / غَيْر مُتَحَقِّق, غَيْر مُنْجَز ((للأشخاص) يتميز بالفشل في تحقيق كامل إمكاناته)",
 "みしょち": "غَيْر مُعَالَج (لم يُعالَج بمادّة كيميائيّة أو فيزيائيّة أو بيولوجيّة) / غير معالج (لم يخضع لمعالجة كيميائية أو فيزيائية) / غير معالج (لم يتلق رعاية أو علاجاً طبياً)\nمثال: نسيج غير معالج",
 "みしょぶん": "غَيْرُ مُسْتَوْطَن (لم يُسْتَوطَن بعد) / غير مستقر (غير مستقر أو مؤسس) / غير محسوم, معلق (لا يزال موضع شك) / غَيْرُ مُسْتَقِرّ, مُتَحَوِّل (عُرْضَةٌ لِلتَّغَيُّر)\nمثال: نمط حياة غير مستقر",
 "みしょり": "غَيْر مُعَالَج (لم يُعالَج بمادّة كيميائيّة أو فيزيائيّة أو بيولوجيّة) / غير معالج (لم يخضع لمعالجة كيميائية أو فيزيائية) / غير معالج (لم يتلق رعاية أو علاجاً طبياً)\nمثال: نسيج غير معالج",
 "みしよう": "عَاطِل, غَيْر مُسْتَخْدَم (ليس قيد الاستخدام الفعليّ) / جَدِيد, غَيْر مُسْتَعْمَل (نظيف لأنّه لم يُستخدَم من قبل) / غَيْر مُسْتَخْدَم (لم يُوضَع قيد الاستعمال بعد)",
 "みしらぬ": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب",
 "みしり": "إذن بالكلام (تعيين من قبل رئيس الجلسة يمنح الشخص الحق في التحدث في هيئة تداولية) / تحديد الهوية, تعرف (عملية التعرف على شيء ما أو شخص ما عن طريق التذكر) / إدراك, اعتراف (الوصول إلى فهم شيء ما بوضوح وتميز) / إقرار, اعتراف (قبول (مثل قبول ادعاء) على أنه حقيقي وصالح)\nمثال: لم يتمكن من تقديم اقتراحه لأنه لم يحصل على إذن بالكلام من الرئيس / بِأَزِيز, بِصَرِير (بطريقة تصدر صريراً)\nمثال: كان القارب القديم يتحرك بصرير",
 "みしりみしり": "بِأَزِيز, بِصَرِير (بطريقة تصدر صريراً)\nمثال: كان القارب القديم يتحرك بصرير",
 "みしる": "تَعَرَّفَ",
 "みしんこく": "غير معلن (غير مصرح به أو معترف به علانية)\nمثال: خوض حرب غير معلنة",
 "みしんじゃ": "وَثَنِيّ / وَثَنِيّ, وَثَنِيَّة",
 "みじか": "قَصِير, قصير (ضد الطويل) / قَصِير (ضد الطويل)\nمثال: حبل الكذب قصير.",
 "みじかい": "قَصِير, قصير (ضد الطويل) / قَصِير (ضد الطويل)\nمثال: حبل الكذب قصير. / وَجِيز, قَصِير / وَجِيز, مُوجَز",
 "みじかうた": "شعب تانكا (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: الجيش يوحد الشعب.",
 "みじかさ": "إيجاز, زوال (سمة كونه وجيزاً أو عابراً) / اختصار (استخدام تعبيرات موجزة)",
 "みじかぼいん": "حركة قصيرة, صائت قصير (في اللغات التي تميز طول الصائت، هو صائت يتم نطقه عادة أقصر من الصائت الطويل)",
 "みじかめ": "قَصِير نَوْعًا مَا (أَقْصَر بِقَليل مِنَ المُعْتاد)",
 "みじけー": "قَصِير, قصير (ضد الطويل) / قَصِير (ضد الطويل)\nمثال: حبل الكذب قصير. / وَجِيز, قَصِير / وَجِيز, مُوجَز",
 "みじたく": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / ثَوْب, لِبَاس (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء) / كَسْوَة, مَلْبَس\nمثال: لبس سروالا نظيفا.",
 "みじめ": "بَائِس",
 "みじめったらしい": "بَائِس",
 "みじゅく": "غير ناضج, فج (غير مكتمل النمو أو النضج؛ غير يانع) / غَيْرُ جَاهِز, غَيْرُ نَاضِج (لم يكتمل استعداده بعد)\nمثال: فاكهة غير ناضجة / غير مكسو بالريش, غير ناضج ((عن الطيور) لم تطور ريشاً بعد) / غير ناضج (لم ينضج بعد) / طفولي, غير ناضج (من سمات الافتقار إلى النضج) / غير ناضج, فج (غير مكتمل النمو أو النضج؛ غير يانع)\nمثال: عصفور صغير غير مكسو بالريش على حافة النافذة",
 "みじゅくじ": "طفل خديج, طفل مبتسر (رضيع يولد قبل 37 أسبوعاً من الحمل)",
 "みじゅくもの": "بريء, قليل الخبرة (شخص يفتقر إلى معرفة الشر)",
 "みじゅくれん": "عَدِيم المَهَارَة, غَيْر كُفْء (لا يؤدي العمل بشكل جيد؛ يفتقر إلى الكفاءة) / غَيْر مَاهِر, هَاوٍ (يفتقر إلى المهارة أو الخبرة المهنية) / غير ماهر (لا يمتلك أو يظهر أو يتطلب مهارة خاصة أو كفاءة)\nمثال: غير ماهر في فن البلاغة",
 "みじょうじょう": "غير مُدرج (غير موجود في قائمة) / غَيْرُ مُدْرَجٍ (لم يُدرج اسمه في قائمة الناخبين)\nمثال: رقم هاتف غير مدرج",
 "みじろぎ": "تحريك, تقليب (تحريك سائل باستخدام أداة) / إلهام, تحريك المشاعر (الاستنهاض لعاطفة أو فعل معين) / مُثِير, مُحَرِّك لِلْمَشَاعِر (يثير مشاعر قوية لكنها غير مزعجة) / حَمَاسِيّ, مُلْهِم (قادر على إثارة الحماس أو الإثارة)\nمثال: التحريك المستمر يمنعه من الاحتراق في قاع المقلاة",
 "みじろぐ": "تَحَرَّكَ (حَرُكَ)\nمثال: لا أستطيع التحرك.",
 "みじん": "جُسَيْم, ذَرَّة (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى مستحدث)) / جُسَيْم (في الفيزياء: الجُسيْمات التحت ذريّة، أي الجُسيْمات الأوليّة والمركّبة (معنى مستحدث))\nمثال: نحن نعيش بعض اللحظات الحزينة حقا لأن بلادنا عانت من خسارة جسيمة. وسوف يستغرق وقتا طويلا قبل أن تعود إلى مجدها السابق. / عَفْوًا, عَلَى الرُحْب وَالسَّعَة",
 "みじんこ": "دافنيا (قشريات مياه عذبة دقيقة لها جسم مستدير محاط بصدفة شفافة؛ تتحرك مثل البرغوث بواسطة قرون استشعار متفرعة مشعرة) / سيكلوبس (مجدافية أرجل مياه عذبة حرة السباحة دقيقة لها عين وسطية كبيرة وجسم كمثري الشكل وقرون استشعار طويلة تستخدم في السباحة؛ مهمة في بعض السلاسل الغذائية…)",
 "みす": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "みすかす": "قَرَأَ (نَطَقَ بما هو مكتوب؛ تَتَبَّعَ ما هو مكتوب وفَهِمَه)\nمثال: قرأ سامي الرسالة.",
 "みすごす": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "みすじ": "شَامِيسِين",
 "みすてる": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "みすぼらしい": "بَالٍ",
 "みすます": "تَأَكَّدَ",
 "みすみそう": "ماركانتيا بوليمورفا, هيباتيكا (حشيشة كبد شائعة) / حشيشة الكبد, هيباتيكا (أي من عدة نباتات من جنس هيباتيكا ذات أوراق ثلاثية الفصوص وأزهار بيضاء أو وردية في أوائل الربيع؛ توجد في مناطق الغابات الرطبة والمغطاة بالطحالب في…)",
 "みする": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "みず": "مِيَاه / سَقَى / أَسْقَى, سَقَى / سَائِل, مَائِع / طُوفَان, فَيَضَان (عاصفة)",
 "みずあか": "فَرْو / مِعْطَف, ثَوْبٌ مُفَرًّى / فَرَّى",
 "みずあげ": "هُبُوط / بَسْطَة / لُقْطَة / أَمْسَكَ (حَبَسَ الشيءَ، قَبَضَ عَلَيْهِ. و (يتعدى بالباء)؛ اِمْتَنَعَ بالشيءِ، اِعْتَصَمَ بِه. (يتعدى بالباء)) / مَسَكَ\nمثال: كنت أمسك بالكرة. / إجمالي الإيرادات, إجمالي المبيعات (الدخل (بقيم الفواتير) المستلم للبضائع والخدمات خلال فترة معينة) / تَصَرُّف",
 "みずあさぎ": "أَزْرَق فَاتِح (بدرجة فاتحة من الأزرق)",
 "みずあび": "استحمام, اغتسال (فعل غسل النفس (أو شخص آخر)) / استجمام, اغتسال (غمر الجسم في الماء أو تعريضه للشمس بغرض الاستجمام) / سِبَاحَة",
 "みずあぶら": "زيت شعر, مستحضر للشعر (مستحضر تجميلي للعناية بالشعر) / كِيرُوسِين",
 "みずあめ": "شراب الذرة (شراب محضر من الذرة)",
 "みずいぼ": "مليساء معدية (مرض فيروسي يصيب الجلد يتميز بتورمات بيضاء مستديرة؛ ينتقل من شخص لآخر (غالبًا عند الأطفال أو البالغين الذين يعانون من ضعف في وظائف المناعة))",
 "みずいらず": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك.",
 "みずいらずで": "بشكل خاص, سراً (محتفظ به كسر أو مقتصر على المعنيين بالأمر) / بشكل خاص (بواسطة شخص أو مصلحة خاصة)\nمثال: نوقش الأمر سراً",
 "みずいろ": "سَمَاوِيّ, لَبَنِيّ",
 "みずうみ": "بُحَيْرَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / بحيرة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / بُحيرَة (مسطح مائي واسع كالبحر المغلق فيه ماء حلو أو شبه حلو صالح للشرب) / ضاية / لَكّ\nمثال: سبحنا في البحيرة.",
 "みずうら": "عرافة الماء (التنجيم بواسطة الماء)",
 "みずうらない": "عرافة الماء (التنجيم بواسطة الماء)",
 "みずおけ": "دلو, سطل (وعاء أسطواني الشكل مفتوح من الأعلى) / ملء دلو (الكمية المحتواة في دلو) / صِهْرِيج, فِنْطَاس (حوض تجتمع فيه الماء؛ وسيلة النقل التي تنقل الماء)\nمثال: الصهريج مملوء بالماء.",
 "みずかき": "ويب / مِضْرَب / جَدَّفَ (معنى الفعل في سياقات متعددة تتراوح بين الطيران والسير، وحتى في الدلالات المجازية كالرمي والقطع؛ الفعل له معانٍ متعددة: رمي (كالسماء بالبرد)، الإسراع في المشي، كفر بالنعم وعدم الرضا بها، ودفع السفينة بالمجاديف) / سُور / سِيَاج",
 "みずかまきり": "عقرب الماء (حشرة مائية طويلة الأرجل لها أرجل أمامية مهيأة للإمساك بالفريسة وبطن ممتد بأنبوب تنفس طويل)",
 "みずかみしも": "سَمَاوِيّ, لَبَنِيّ",
 "みずから": "نَفْس (النَّفْسُ : الرُّوحُ؛ النَّفْسُ :الدَّمُ، فشاهده قول السموأَل: تَسِيلُ على حَدِّ الظُّبَّاتِ نُفُوسُنَا…)\nمثال: هم في نفس السن.",
 "みずからすすんで": "بتعمد, عمداً (بنية؛ بطريقة متعمدة)\nمثال: استخدم تلك الكلمة عمداً",
 "みずがき": "سُور / سِيَاج",
 "みずがし": "فَاكِهَة (الثمار كلها؛ ما يتنعم بأكله رطبا كان أم يابسا كالتين واللوز والرمان ونحوها) / ثَمَرَة, شَاذّ جِنْسِيًّا / أَثْمَرَ (أثمر الشجر: صار فيه الثمر؛ أثمر الشجر: طلع ثمره قبل أن ينضج)\nمثال: التفاح فاكهة لذيذة.",
 "みずがめ": "إبريق ماء, جرة ماء (إبريق يحفظ الماء)",
 "みずがめざ": "بُرْج اَلدَّلْو, الدَّلْو (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "みずがめ座": "بُرْج اَلدَّلْو, الدَّلْو (ظهر وارتفع)\nمثال: وصل كارل إلى برج آخر.",
 "みずがれ": "جَفَاف",
 "みずき": "شجرة القرانيا, قرانيا (شجرة أو شجيرة من جنس قرانيا غالباً ما يكون لها قنابات مبهرجة تشبه الزهور) / خشب القرانيا (خشب صلب قوي لأي قرانيا من جنس كورنوس؛ يشبه خشب البقس)",
 "みずききん": "جَفَاف",
 "みずきょうふしょう": "رهاب الغرق, رهاب الماء (خوف مرضي من الغرق)",
 "みずきり": "إجهاد, توتر (مجهود مكثف أو عنيف) / تشويه, لوي الحقائق (فعل تشويه الشيء ليبدو وكأنه يعني شيئاً لم يكن يقصده) / شَاقّ, مُجْهِد (يُرهق إلى أقصى حدّ؛ يختبر قدرات التحمّل) / مِصْفَاة / قدم أمامية (قدم أمامية لذوات الأربع) / وثب الحجارة (لعبة يتم فيها نط حجر مسطح على سطح ماء هادئ)",
 "みずきりだい": "لوح تجفيف (لوح بجانب حوض المطبخ ومائل لتصريف المياه في الحوض)",
 "みずきりだな": "لوح تجفيف (لوح بجانب حوض المطبخ ومائل لتصريف المياه في الحوض)",
 "みずきん": "رَشْوَة, رِشْوَة / رَشَا (رَشا الفرخُ رَشا رَشواً، مَدَّ رأْسَهُ إِلى أُمِّهِ لتَزُقَّهُ؛ رَشا فلاناً: أَعطاه رشوة)\nمثال: عندي برشا أسئلة على الكتاب هذا.",
 "みずぎ": "مايوه, ملابس سباحة (رداء ضيق يلبس للسباحة)",
 "みずぎせる": "شِيشَة, نَارْجِيلَة",
 "みずぎわ": "جانب الماء (أرض متاخمة لجسم مائي)\nمثال: 彼らは水際でキャンプをした。 — خيموا على حافة الماء. / حَدّ, حُدُود (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما بِالْآخَرِ أَو لِئَلَّا يَتَعَدَّى أَحدهما عَلَى الْآخَرِ)\nمثال: أعرفها إلى حد ما.",
 "みずくき": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "みずくさ": "نبات مائي (نبات ينمو جزئياً أو كلياً في الماء سواء كان متجذراً في الطين، مثل اللوتس، أو عائماً دون تثبيت، مثل ورد النيل)",
 "みずくさい": "بَعِيد (ضد القَرِيب، الذي يفصل بينك وبينه مسافة أو زمان)\nمثال: إنها بعيدة جدا. / رَقِيق, مَائِيّ (مُخَفَّف أَكْثَر مِنَ اللَّازِم؛ ضَعِيف وَبِلَا طَعْم) / مَائِيّ (متعلّق بالماء أو شبيه به أو مؤلَّف منه) / دَامِع, رَاشِح (مبلَّل بإفرازات رطبة كالعَرَق أو الدموع) / مَمْلُوء بِالْمَاء (مملوء بالماء)",
 "みずぐき": "كِتَابَة (الخَطّ أو ما كُتِبَ؛ ما يُكْتَبُ عموما) / كتبة (الكِتْبَةُ : الحالةُ؛ الكِتْبَةُ :الإكتتاب في الفَرْض والرزق)\nمثال: تعبت من الكتابة.",
 "みずぐすり": "جُرْعَة",
 "みずぐち": "فوهة, مصب (فتحة تسمح بمرور السوائل أو الحبوب)",
 "みずぐるま": "توربين مائي, عجلة مائية (عجلة تدور بفعل التأثير المباشر للماء؛ توربين بسيط) / ساقية, عجلة مائية (عجلة ذات دلاء متصلة بحافتها؛ ترفع الماء من تيار مائي أو بركة) / عنفة مائية",
 "みずけ": "رُطُوبَة",
 "みずけむり": "مرذاذ (موزع يحول السائل (مثل العطر) إلى رذاذ ناعم) / غصن مزهر (تنسيق زهور يتكون من غصن واحد أو فرع يحمل أزهاراً وأوراقاً) / رذاذ (دفق من البخار أو قطرات السائل) / رذاذ, رشقة (كمية من الأجسام الصغيرة تتطاير في الهواء)\nمثال: رشقة من الرصاص",
 "みずこし": "مرشح مياه (مرشح لإزالة الشوائب من إمدادات المياه)",
 "みずこぼし": "دلو الفضلات السائلة (دلو كبير يستخدم لاستقبال مياه الصرف من حوض الغسيل)",
 "みずごけ": "سفاغنوم, طحلب الخث (أي من الحزازيات الشاحبة أو الرمادية المختلفة من جنس سفاغنوم التي تشكل بقاياها المتحللة الخث)",
 "みずさいばい": "زراعة مائية (تقنية زراعة النباتات (بدون تربة) في ماء يحتوي على مغذيات مذابة)",
 "みずさきあんない": "إرشاد, قيادة (مهنة الطيار أو المرشد البحري) / توجيه, ملاحة (توجيه السفن أو الطائرات من مكان إلى آخر)",
 "みずさきあんないせん": "قارب المرشد (قارب لنقل المرشدين من وإلى السفن الكبيرة)",
 "みずさきあんないにん": "طَيَّار, طَيَّارَة (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "みずさきにん": "طَيَّار, طَيَّارَة (اسم فاعل للمبالغة على وزن فَعَّال؛ الذي يقود الطَائِرَة سواء كانت مهنته أم لا)\nمثال: لم توجه أبدا تهمة القيادة غير المسؤولة للطيار.",
 "みずさし": "إِبْرِيق, زِير",
 "みずさわ": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)",
 "みずし": "أَعْمَال مَنْزِل, أَعْمَال الْمَنْزِل (في يطلق على أي عمل حرّ يحتاج إلى رأس مال مثل الصناعة والتجارة وقطاع المال وما أشبه)\nمثال: أنا في رحلة أعمال. / خادم المطبخ (خادم مطبخ يعمل للقيام بمهام وضيعة (خاصة الغسيل))",
 "みずしぶき": "رش, طرطشة (فعل نثر الماء بشكل عشوائي) / رش, طرطشة (فعل رش مادة (سائلة) على سطح) / لطخة لونية (رقعة ذات لون ساطع) / رشق, طرطشة (الصوت الذي يشبه طرطشة الماء)\nمثال: أعطت قبعتها الحمراء ملابسها لطخة من الألوان",
 "みずしも": "سائل أمينوسي, سائل سلوي (السائل المصلي الذي يعلق فيه الجنين داخل السلى)",
 "みずしょう": "انْسِيَابِيَّة, سُيُولَة (صفة متغيرة) / سيولة (خاصية التدفق بسهولة)\nمثال: انسيابية شرقية ساحرة في الأسلوب",
 "みずしらず": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب\nمثال: どうして見ず知らずの男が自分の名前を知っているんだろう？ — كيف يعرف شخص أجنبيّ تماما اسمه؟ / عَدَم أُلْفَة, غَرَابَة (الغرابة نتيجة لعدم كون الشيء معروفاً جيداً)",
 "みずじも": "سائل أمينوسي, سائل سلوي (السائل المصلي الذي يعلق فيه الجنين داخل السلى)",
 "みずすまし": "دُوَّامَة, جِرِنُوسِيَّة / بق الماء المتزحلق (بق طويل الأرجل ينزلق على سطح الماء)",
 "みずせっけん": "صابون سائل (صابون في شكل سائل)",
 "みずぜめ": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / استئصال, بتر (عملية قطع شيء ما)\nمثال: أعطاه الحلاق قصة جيدة",
 "みずそこ": "قاع النهر (قناة يشغلها (أو كان يشغلها) نهر)",
 "みずた": "حقل أرز (حقل مروي أو مغمور يُزرع فيه الأرز)",
 "みずたいほう": "مِدْفَع مَاء (آلة حربية تَقْذِف الكتل الحَدِيدِيَّة أو النَارِيَّة مثل المَنْجَنِيق. بعض العامة تقول مَدْفَع وهذا خطأ. يُجمع جَمْع تَكْسِير على مَدَافِع)",
 "みずたま": "بولكا دوت, منقط (تصميم يتكون من نمط من البقع الدائرية المتباعدة بانتظام)",
 "みずたまもよう": "بولكا دوت, منقط (تصميم يتكون من نمط من البقع الدائرية المتباعدة بانتظام)",
 "みずたまり": "غَدِير, بِرْكَة",
 "みずだめ": "بالوعة, بيارة (صهريج مغطى؛ تتدفق إليه مياه الصرف الصحي والمجاري) / بالوعة, حفرة تجميع (بئر أو حفرة أخرى تجمعت فيها المياه) / حوض الزيت, كارتير الزيت (خزان الزيت في محرك الاحتراق الداخلي)",
 "みずっぱな": "رَشْح (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى)",
 "みずっぽい": "رَقِيق, مَائِيّ (مُخَفَّف أَكْثَر مِنَ اللَّازِم؛ ضَعِيف وَبِلَا طَعْم) / مَائِيّ (متعلّق بالماء أو شبيه به أو مؤلَّف منه) / دَامِع, رَاشِح (مبلَّل بإفرازات رطبة كالعَرَق أو الدموع) / مَمْلُوء بِالْمَاء (مملوء بالماء) / سِبَاقِيّ (مُصَمَّمٌ أَوْ مُنَاسِبٌ لِلتَّنَافُسِ فِي سِبَاق) / فَاحِش, مُوحٍ بِالبَذَاءَة (يُلمّح إلى سلوك جنسيّ غير لائق) / حَيَوِيّ, نَابِض (مليء بالحيويّة والنَّشاط والقوّة) / غَنِيّ, مُكْتَنِزُ النَّكْهَة (يَتَّسِمُ بِالثَّرَاءِ وَالامْتِلَاءِ فِي النَّكْهَة)",
 "みずでうすめる": "خَفَّفَ (قلل شيئًا أو نقص من حدته؛ هون أو لطف من شدة أمر)\nمثال: خفف زيري السرعة.",
 "みずでっぽう": "رشاش ماء, مسدس مائي (لعبة تتكون من مسدس لعبة يرش الماء)",
 "みずとり": "طائر مائي (طائر مائي يعيش في المياه العذبة)",
 "みずどけい": "سَاعَةٌ مَائِيَّة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن)\nمثال: درست لمدة ساعة.",
 "みずどり": "طائر مائي (طائر مائي يعيش في المياه العذبة)",
 "みずなぎどり": "نوء (طائر صغير نسبياً طويل الجناحين أنبوبي الأنف يطير بعيداً عن اليابسة)",
 "みずなしがわ": "وادي (أخدود أو قاع سيل في شمال أفريقيا والشرق الأوسط يظل جافاً إلا خلال موسم الأمطار)",
 "みずにながす": "غَفَرَ وَنَسِيَ",
 "みずぬき": "مُرْهِق, مُنْهِك (له أثر مُوهِن ومُنهِك للقوى) / بَالُوعَة",
 "みずぬれ": "تبليل, ترطيب (فعل جعل الشيء مبللاً) / تبول (تعبير مخفف للتبول)",
 "みずのあわ": "لَا شَيْء (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "みずのえいぬ": "كلب الماء (كلب معتاد على الماء وعادة ما يتم تدريبه لاسترداد الطيور المائية) / محب الماء (شخص يستمتع بالتواجد في الماء أو عليه)",
 "みずのえたつ": "آذريون المستنقع, قطيفة المستنقع (نبات مستنقعات من أوروبا وأمريكا الشمالية ذو أزهار صفراء زاهية تشبه الحوذان) / ذيل السحلية, زنبق المستنقع (نبات معمر عشبي من أمريكا الشمالية في الأماكن الرطبة له عناقيد رفيعة مجعدة من الزهور البيضاء الصغيرة)",
 "みずのえね": "جرذ الماء (أي نوع من الجرذان البرمائية المختلفة) / جرذ الماء (فأر حقل أوراسي كبير شائع) / محب الماء (شخص يستمتع بالتواجد في الماء أو عليه)",
 "みずのせい": "جنية الماء (جنية تسكن الماء)",
 "みずのとうし": "جاموس الماء (جاموس آسيوي غالباً ما يتم استئناسه لاستخدامه كحيوان جر)",
 "みずのとみ": "ثعبان الماء (أي من ثعابين متنوعة غير ضارة في الغالب تعيش في الماء أو بالقرب منه)",
 "みずのみ": "مَاء شُرْب, مَاء صَالِح لِلشُّرْبِ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء. / زُجَاج, قزاز / كَأْس, كُوب (إناء الشرب إذا كان فيه شراب؛ الشراب الذي في الإناء)\nمثال: هل لي بكأس ماء؟ / فَلَّاح, فَلَّاحَة",
 "みずのみば": "سبيل ماء, نافورة شرب (نافورة عامة لتوفير تيار من مياه الشرب)",
 "みずはけ": "تَصْرِيف",
 "みずはな": "منطقة ساحلية, واجهة بحرية (منطقة في المدينة (مثل الميناء أو حوض السفن) تقع بمحاذاة مسطح مائي) / نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "みずはみがき": "غَسُولُ فَمّ",
 "みずば": "حمامات معدنية, منتجع صحي (منتجع صحي يقع بالقرب من نبع أو عند شاطئ البحر)",
 "みずばかり": "مقياس مستوى الماء, ميزان ماء / مَنْسُوب المِيَاه, مُسْتَوَى المَاء (مستوى سطح جسم مائي) / خط الماء (خط يقابل سطح الماء عندما تكون السفينة طافية بتوازن؛ غالباً ما يُرسم على بدن السفينة) / مستوى الماء, منسوب المياه الجوفية (السطح تحت الأرضي الذي تكون الأرض تحته مشبعة بالكامل بالماء)\nمثال: أمطار الربيع رفعت منسوب المياه الجوفية",
 "みずばな": "رَشْح (اقتَرَح شخصًا أو جهةً ليكون مرشَّحًا لمنصب أو مهمة؛ جعَل شيئًا يرشُح أو يُصفّى) / منطقة ساحلية, واجهة بحرية (منطقة في المدينة (مثل الميناء أو حوض السفن) تقع بمحاذاة مسطح مائي) / نَجْمَة, اِبْتِدَاء / نَجْمَة / بَدَأَ (حَدَثَ ونَشَأَ وحَصَلَ؛ أَخَذَ، شَرَعَ)\nمثال: بدأ سامي يتكلم.",
 "みずびたし": "تغطيس, غمر (فعل تبليل شيء بغمره) / انغمار, غمر (الغرق حتى التغطية بالماء تماماً)",
 "みずぶか": "قرش أزرق, قرش أزرق كبير (قرش نحيل عالمي الانتشار يعيش في عرض البحر؛ يتدرج لون جسمه الأزرق إلى بطن أبيض؛ خطير خاصة أثناء الكوارث البحرية)",
 "みずぶくれ": "بَطْبَاطَة, نَفْطَة",
 "みずぶとり": "مُتَرَهِّل",
 "みずぶね": "صِهْرِيج, فِنْطَاس (حوض تجتمع فيه الماء؛ وسيلة النقل التي تنقل الماء)\nمثال: الصهريج مملوء بالماء. / تَابُوت (تَّابُوت: هو الصُّنْدُوق الذي توضع به الجثة؛ صندوق خشبيّ يكون مستطيل)",
 "みずへびざ": "ثعبان الماء (أي من ثعابين متنوعة غير ضارة في الغالب تعيش في الماء أو بالقرب منه)",
 "みずへび座": "ثعبان الماء (أي من ثعابين متنوعة غير ضارة في الغالب تعيش في الماء أو بالقرب منه)",
 "みずべ": "جانب الماء (أرض متاخمة لجسم مائي)",
 "みずほのくに": "الْيَابَان (دولة جزرية في شرق قارة آسيا، عاصمتها طوكيو)\nمثال: أنا من اليابان.",
 "みずぼうそう": "جدري الماء, حماق (مرض معدٍ حاد يسببه فيروس الهربس النطاقي الحماقي؛ يسبب طفحًا من الحويصلات على الوجه والجسم)",
 "みずまき": "ري, سقي (التبليل بالماء) / إدماع, تدميع (ذرف الدموع)\nمثال: العشب يحتاج إلى الكثير من الري",
 "みずまし": "تَخْفِيف / تَضَخُّم (الزِّيادة المُفرِطة في الحجم؛ الزِّيادة المُفرِطة في الوسائل والأَشخاص) / تَضَخُّم, زِيَادَة (الزِّيادة المُفرِطة في الحجم؛ الزِّيادة المُفرِطة في الوسائل والأَشخاص)\nمثال: الجزائر تعاني من التضخم.",
 "みずましかぶ": "أسهم مخففة, أسهم وهمية (أسهم تمثل ملكية أصول مبالغ في قيمتها؛ أسهم شركة تكون قيمتها الإجمالية أقل من رأس مالها المستثمر)",
 "みずみずしい": "دَجِر",
 "みずむし": "سِعْفَة القَدَم, القَدَم الرِيَاضِي / بق الماء المجدف (بق مائي آكل للحوم له أرجل خلفية تشبه المجداف)",
 "みずめ": "كرز شرقي, كرز ياباني (شجرة زينة بفاكهة غير صالحة للأكل تزرع على نطاق واسع في العديد من الأصناف لأزهارها البيضاء)",
 "みずもの": "سَائِل, مَائِع / قِمَار / قَامَرَ",
 "みずもり": "مُسْتَوًى / مَرْحَلَة / تَسَرُّب / تَسْرِيب / سَرَّبَ ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا.",
 "みずもれ": "تَسَرُّب / تَسْرِيب / سَرَّبَ ((سَرِبَ) المَاء سَرَباً: سَالَ فَهُوَ سَرِب)\nمثال: سرب الطيور ذلك جميل جدا.",
 "みずや": "مَطْبَخ (المكان الذي يُطْبَخُ فيه، غُرْفَة أو مساحة في البناء مخصصة للطبخ؛ في : هو المَطْعَم)\nمثال: سامي في المطبخ. / خِزَانَة (مكان الخَزْن؛ قطعة أثاث للخَزْن)\nمثال: اقترب من الخزانة.",
 "みずやり": "ري, سقي (التبليل بالماء) / إدماع, تدميع (ذرف الدموع)\nمثال: العشب يحتاج إلى الكثير من الري",
 "みずわらび": "جنية الماء (جنية تسكن الماء) / سرخس عائم, عفريت الماء (سرخس مائي في أمريكا الاستوائية يستخدم غالباً في أحواض السمك)",
 "みずをうったよう": "صَامِت, هَادِئ",
 "みずをかける": "عَاقَ, عَرْقَلَ / خَلْفِيّ / رِدْف, عَجِيزَة (رَدِفَهُ يَرْدَفُ رَدْفاً: رَدَفه؛ وفي التنزل العزيز)",
 "みずをさす": "عَاقَ, عَرْقَلَ / خَلْفِيّ / رِدْف, عَجِيزَة (رَدِفَهُ يَرْدَفُ رَدْفاً: رَدَفه؛ وفي التنزل العزيز)",
 "みずをやる": "مِيَاه / سَقَى / أَسْقَى, سَقَى",
 "みずイボ": "مليساء معدية (مرض فيروسي يصيب الجلد يتميز بتورمات بيضاء مستديرة؛ ينتقل من شخص لآخر (غالبًا عند الأطفال أو البالغين الذين يعانون من ضعف في وظائف المناعة))",
 "みずガラス": "ساعة مائية, كليبسيدرا (ساعة تقيس الوقت عن طريق تدفق الماء) / مقياس مستوى الماء (مقياس للإشارة إلى مستوى الماء في خزان أو مرجل أو مستودع) / كوب ماء (كوب لشرب الماء) / زجاج مائي, سيليكات الصوديوم (زجاج لزج يتكون من سيليكات الصوديوم في محلول؛ يستخدم كمادة لاصقة أو طلاء واقي وحفظ البيض)",
 "みずギセル": "شِيشَة, نَارْجِيلَة",
 "みずタバコ": "شِيشَة, نَارْجِيلَة",
 "みずパイプ": "شِيشَة, أرجيلة",
 "みせ": "خَزَنَ (حفظ، إدخر، أودع في مخزن)",
 "みせい": "غَيْرُ مُلْتَقَط, غَيْرُ مُنْجَز (لم يُلتقَط أو لم يُلتقَط داخل الحدود المسموحة) / غَيْرُ مُكْتَمِل, نَاقِص (لَمْ يَكْتَمِلْ بَعْدُ)",
 "みせいじゅく": "عدم نضج (عدم الوصول إلى النضج)",
 "みせいせい": "خَامّ (وَخُمَ أو وَبِئَ؛ أقام في المكان أو استقر فيه)\nمثال: تنقل السفن المواد الخام من أندونيسيا.",
 "みせいた": "طَبَقَة",
 "みせいねん": "أَقَلِّيَّة\nمثال: 君は未成年だから入れません。 — ليس بإمكانك الدخول لأنك قاصر.",
 "みせいねんしゃ": "صَغِير, مَحْدُود النِّطَاق (صَغير الحَجْم أَوْ مَحْدود في النِّطاق أَوْ الأَهَمِّيَّة) / أصغر, أقلية (أقل في العدد أو الحجم أو المقدار) / بسيط, ثانوي (أقل في النطاق أو التأثير) / قاصر (لم يبلغ السن القانونية)\nمثال: حصة صغيرة من الأرباح",
 "みせいり": "قَيْدَ الِانْتِظَار, مُعَلَّق (فِي انْتِظَارِ الِاخْتِتَامِ أَوِ التَّأْكِيدِ)",
 "みせかけ": "بَدَا, ظَهَرَ (ظَهَرَ)\nمثال: بدا سامي مريضا.",
 "みせかける": "اِدَّعَى / زَعَمَ / تَظَاهَرَ (فعل مطاوعة لظَاهَرَ، ظاهرته فتظاهر، يكون بمعنى تعاون فكان كل طرف كظهر الآخر؛ القوم: ولّى كل منهم ظهره للآخر)\nمثال: تظاهر بأنه طبيب.",
 "みせぎょく": "طَبَقَة",
 "みせさき": "واجهة المتجر (الجانب الأمامي لمتجر يواجه الشارع؛ يحتوي عادة على نوافذ عرض)",
 "みせしめ": "دَرْس, حِصَّة ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / دَرْس ((متعدٍّ بنفسه) عَلَّمَ، لَقَّنَ؛ اِمْتَهَنَ التَّعْلِيم) / عِبْرَة (الدَمْعَة قبل أن تفيض؛ المَشَاعِر العميقة الحزينة)\nمثال: أراك بعد الدرس.",
 "みせじょろう": "مِن الطَّبَقَة الدُّنْيَا (يحتل أدنى مكانة اجتماعية واقتصادية في المجتمع)",
 "みせだな": "خَزَنَ (حفظ، إدخر، أودع في مخزن)",
 "みせっしゅ": "غَيْر مُطَعَّم, غَيْر مُلَقَّح (لم يتلقَّ التطعيم)",
 "みせつ": "بَارِز, مُمْتَدّ (يمتد للخارج فوق سطح أو حدّ أو ما وراءهما)",
 "みせつける": "استعراض, تباهي (فعل عرض شيء ما بتفاخر)\nمثال: كان سلوكه استعراضاً شائناً",
 "みせどころ": "معلم سياحي, مكان للعرض (مكان يتم عرضه وزيارته بشكل متكرر لاهتمامه التاريخي أو جماله الطبيعي)",
 "みせば": "إبراز ضوئي, منطقة مضيئة (منطقة من السطوع في الصورة) / الجزء الأبرز, علامة مميزة (الجزء الأكثر إثارة للاهتمام أو الذي لا يُنسى)\nمثال: كان الجزء الأبرز في الجولة زيارتنا للفاتيكان / استعراضي, محب للظهور (شخص يتصرف عمداً بطريقة تجذب الانتباه)",
 "みせばん": "بَيَّاع, بَيَّاعَة",
 "みせびらかす": "استعراض, تباهي (فعل عرض شيء ما بتفاخر)\nمثال: كان سلوكه استعراضاً شائناً",
 "みせもの": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه.",
 "みせものごや": "خيمة السيرك (خيمة قماشية لإيواء الجمهور في عرض السيرك)\nمثال: كان خائفاً من حريق في خيمة السيرك",
 "みせや": "خَزَنَ (حفظ، إدخر، أودع في مخزن)",
 "みせやぐら": "برج مراقبة, مرصد (هيكل يطل على مشهد واسع لمحيطه)",
 "みせる": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه. / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "みせブラ": "استعراضي, محب للظهور (شخص يتصرف عمداً بطريقة تجذب الانتباه)",
 "みぜん": "سلفاً, مسبقاً (قبل الوقت؛ تحسباً)\nمثال: عندما تدفع مقدماً تحصل على خصم",
 "みぜんぼうし": "مَنْع (حَرَمَ، ضد أَعْطَى؛ كَفَّ عنه وحَمَاه)\nمثال: تساهم جذور أشجار المنغروف في منع حدوث انجراف التربة.",
 "みそ": "مِيسُو / نقطة قوة (مكان ذو قوة خاصة)\nمثال: この電子辞書は携帯しやすいところが味噌です。 — من محاسن القاموس الإلكتروني أنه سهل الحمل. / ضعيف, واهن (شخص ضعيف جسدياً وغير فعال) / حَاوَلَ, سَعَى (طَلَبَ، رَامَ) / حَاكَمَ (حَاكَمَ القاضي فلانا: أقام عليه محكمة ليرى ما إذا كان مجرما أم لا؛ حَاكَمَ فلانٌ فلانا: رفع عليه قضية؛ اشتكى عليه عند القضاء فأقاموا محكمة للحكم في الأمر) / مُحَاوَلَة (بذل الجهد أو السعي لتحقيق هدف أو الوصول إلى نتيجة معينة؛ التجربة أو القيام بشيء ما للحصول على نتيجة مرغوبة)\nمثال: حاول توم قتلنا! / يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم) / ثَلَاثِينَ, ثَلَاثُونَ",
 "みそか": "يوم الحساب, يوم الدين (اليوم في نهاية الزمان الذي سيقضي فيه الله بمصير جميع البشر وفقاً لأعمالهم)",
 "みそかごと": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا. / وَصْل (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول))\nمثال: وصل السيد باكر.",
 "みそかす": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "みそかづき": "مُحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…) / مَحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…) / مِحَاق (الثَلَاثُ المُِحَاق: آخر ثلاث ليالٍ من كل شهر قمري وفيها السِّرَار وقيل ليلة خمس وست وسبع وقيل غير ذلك وقد تكون ليلتان في الأشهر ذَات التسع والعشرون…)",
 "みそぎ": "وُضُوء, غُسْل / وَضُوء",
 "みそくそ": "بشدة, بشكل بالغ (لدرجة شديدة أو خطيرة) / بشدة, بقسوة (مسبباً ضرراً كبيراً أو معاناة) / بِحَزْم, بِصَرَامَة (بصرامة؛ بطريقة شديدة)\nمثال: أصابع متجمدة بشدة لدرجة أنه كان لا بد من بترها",
 "みそぐ": "تَابَ (تَابَ: عادَ إِلى اللَّهِ ورَجَعَ وأَنَابَ؛ تابَ اللهُ عَلَيْهِ: أَي عادَ عَلَيْهِ بالمَغْفِرة)",
 "みそこなう": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي. / تقدير مفرط, مغالاة في التقدير (حساب ينتج عنه تقدير مرتفع جداً) / تقدير مبالغ فيه, مغالاة في التثمين (تقييم مرتفع للغاية) / صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "みそしき": "غير منظم (لا يملك أو ينتمي إلى كل منظم) / غَيْرُ مُنَظَّم نِقَابِيًّا (غير منتسب إلى نقابة عمالية)\nمثال: الأقاليم غير المنظمة تفتقر لحكومة رسمية",
 "みそじ": "ثَلَاثِينَ, ثَلَاثُونَ",
 "みそじひともじ": "شعب تانكا (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: الجيش يوحد الشعب.",
 "みそすり": "تملق, نفاق (ثناء مفرط أو غير صادق) / رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "みそすりぼうず": "رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس إلى بعض الأدْيِرَة طلبا للعِبَادَة)",
 "みそち": "ثَلَاثِينَ, ثَلَاثُونَ",
 "みそっかす": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "みそひともじ": "شعب تانكا (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: الجيش يوحد الشعب.",
 "みそまめ": "فُول اَلصُّويَا",
 "みそら": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "みそれる": "اِسْتَخَفَّ, اِسْتَهَانَ",
 "みそをする": "تَمَلَّقَ, تَبَصْبَصَ",
 "みぞ": "خَنْدَق, أُخْدُود / روتين ممل (روتين ثابت ورتيب يصعب الهروب منه) / أخدود, ميزابة ((في التشريح) أي شق أو قناة على هيكل أو جزء جسدي) / أخدود, شطب (شق ضيق وطويل تم حفره بعملية طبيعية (مثل التآكل) أو بأداة (مثل أخدود في أسطوانة فونوغراف))\nمثال: وقعوا في روتين محادثة ممل / انقطاع, توقف (فعل تأخير أو قطع الاستمرارية) / شق, فجوة (فتحة ضيقة) / فَارِق, فَجْوَة (تفاوت أو اختلاف واضح كما بين رقمين) / فجوة, هوة (اختلاف (خاصة اختلاف مؤسف) بين رأيين أو وجهتي نظر أو موقفين)\nمثال: تم عرضه بدون فواصل إعلانية",
 "みぞう": "غَيْر مَسْبُوق (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "みぞがたこう": "قَنَاة",
 "みぞけずり": "تحزيز, تخديد (أخدود أو شق في قماش وغيره (وخاصة أخدود مقعر ضحل في بدن العمود))",
 "みぞほりき": "لوح تقديم خشبي (لوح خشبي أو طبق يتم عليه تقديم الطعام أو تقطيعه) / حافر خنادق (شخص يحفر الخنادق)",
 "みぞれ": "صقيع, مطر متجمد (ثلج ذائب جزئياً (أو خليط من المطر والثلج))",
 "みたい": "كَـ",
 "みたいだ": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "みたいです": "كَأَنَّ, كَأَنَّمَا (يفيد التشبيه)\nمثال: كأن هذه السيارة له.",
 "みたいな": "فِي ذَلِك, فِي ذَلِك المَكَان ((رسمي) في أو داخل ذلك الشيء أو المكان)\nمثال: يمكنهم أن يقرؤوا في ذلك ما هي خططنا",
 "みたく": "حَبَّ (الزرع، كبيرا كان أم صغيرا؛ بَذْرُ الزرع) / أَحَبَّ (مَالَ إلى الشيء أو الشخص، وَدَّه؛ للزَّرع: بَدا حَبُّه) / اِسْتَمْطَعَ / أَعْجَبَ (سُرَّ بالشيءِ) / مِثْل (الشَبَه؛ النَظِير) / مِثْل, شِبْه (الشَبَه؛ النَظِير) / مِثْل, كَـ (الشَبَه؛ النَظِير)\nمثال: زيري بحب المال.",
 "みたけ": "طُول (قُدرة؛ غنى أو فضل)\nمثال: قاس طول السرير.",
 "みたざる": "أَصْغَر مِن, صُغْرَى مِن",
 "みたす": "رَضَّى / مَلَأَ",
 "みたて": "اِخْتِيَار, خِيَار / تَشْخِيص / تقييم, حكم (فعل الحكم على أو تقييم شخص أو موقف أو حدث) / حكم, قرار قضائي ((قانون) القرار الصادر عن محكمة مختصة بشأن المسائل المعروضة عليها) / تقدير, حكم (القدرة على تقييم المواقف أو الظروف بذكاء واستخلاص استنتاجات سليمة) / تمييز, حصافة (القدرة العقلية على الفهم والتمييز بين العلاقات)\nمثال: انتقدوا حكمي على المتسابقين / مُقَارَنَة / مُقَابَلَة / تَشْبِيه / مُقَايَسَة",
 "みたてる": "اِخْتَارَ / شَخَّصَ (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان. / قَاضٍ, قَاضِيَة / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / شَبَّهَ",
 "みたところ": "عَلَى مَا يَبْدُوْ, لِأَوَّلِ وَهْلَةٍ (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "みたない": "أَصْغَر مِن, صُغْرَى مِن",
 "みたび": "ثلاثة أضعاف (بمعامل ثلاثة)\nمثال: زاد إيجارنا ثلاثة أضعاف في السنوات الخمس الماضية / مراراً وتكراراً (بشكل متكرر)\nمثال: ظهرت الكلمة غير المعروفة مراراً وتكراراً",
 "みたま": "الرُّوح الْقُدُس",
 "みたまや": "ضَرِيح, مَرْقَد",
 "みため": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "みだし": "عُنْوَان (عُنْوَان)\nمثال: نسيت عنوان توم. / دَلِيل, فِهْرِس / فِهْرِس (كِتَاب تجمع فيه أسماء الكتب بترتيب يسهل منه إجاد العنوان المراد البحث عنه؛ فَصْل أو بَاب في أول أو آخر الكتاب ترتب فيه الأبواب والفصول ومواضعها ليسهل منه إيجاد المطلوب) / كلمة بادئة (كلمة توضع في بداية سطر أو فقرة (كما في مدخل القاموس)) / كلمة رئيسية (كلمة محتوى يمكن تقييدها بواسطة مُعدِّل (صفة أو غيرها))",
 "みだしご": "كلمة بادئة (كلمة توضع في بداية سطر أو فقرة (كما في مدخل القاموس)) / كلمة رئيسية (كلمة محتوى يمكن تقييدها بواسطة مُعدِّل (صفة أو غيرها))",
 "みだしなみ": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "みだす": "اِكْتَشَفَ / اِخْتَارَ / حا َسـِب / مُرْتَشٍ, فَاسِد / أَفْسَدَ",
 "みだら": "فَاحِش, قَذِر",
 "みだり": "أَنَانِيّ / مُتَهَوِّر / فَضْفَاض, واسِع / غير عقلاني, غير منطقي (غير متسق مع العقل أو لا يستخدمه) / أصم, غير نسبي (حقيقي ولكن لا يمكن التعبير عنه كحاصل قسمة عددين صحيحين) / عَدَد غَيْر نِسْبِيّ (عدد حقيقي لا يمكن التعبير عنه كعدد نسبي (كسر))\nمثال: مخاوف غير عقلانية",
 "みだりかぜ": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "みだりがわしい": "قَذِر, مُهْمَل (مُهْمِلٌ لِلنَّظَافَةِ خَاصَّةً فِي المَلْبَسِ وَالمَظْهَرِ الشَّخْصِيّ)",
 "みだりに": "دون داع (بدون أي ضرورة) / بلا ضرورة (بطريقة غير ضرورية)\nمثال: هذا الماراثون سيرهقه دون داع / باستهتار, بتهور (بطريقة متهورة)",
 "みだれ": "اِخْتِلال, اِضْطِراب (الاِخْتِلال : اتّخاذ الخلّ من العصير؛ اختلّ الأمر : وقع فيه الخلل) / اِضْطِرَاب",
 "みち": "فقمة ذات أذنين (ثديي زعنفي الأقدام له سديلات أذن خارجية وأطراف خلفية تُستخدم للحركة على الأرض؛ يُقدر لفروه السفلي الناعم) / طَرِيق, سِكَّة (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / طَرِيق, سَبِيل (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق. / لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد. / رَحِيق / عَسَل, شَهْد (عَسَل) / حَبِيبِي, عَزِيزَتِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / عَسَل, عَسُّولَة (عَسَل) / عَسَلِيّ\nمثال: يصنع النحل العسل. / مغثر / مَنّ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / ابتذال عاطفي (كتابة أو موسيقى حلوة وعاطفية بشكل مفرط) / تريكل, شراب ذهبي (شراب قصب شاحب اللون)",
 "みちあんない": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد / دليل إرشادي, قاعدة عامة (قاعدة أو مبدأ يوفر توجيهاً للسلوك المناسب) / عمود إرشادي (عمود يحمل لافتة تعطي الاتجاهات أو تظهر الطريق)",
 "みちいと": "خيط الصيد, سنارة (طول من الحبل يُربط به القائد والعوامة والثقالة والخطاف)",
 "みちおしえ": "خُنْفُسَاء نَمِرِيَّة",
 "みちがう": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "みちがえる": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "みちくさをくう": "ضَيَّعَ اَلْوَقْت",
 "みちしお": "ذروة المد, مد عالي (المد عندما يكون الماء في أعلى مستوياته)",
 "みちしば": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد",
 "みちしるべ": "دليل إرشادي, قاعدة عامة (قاعدة أو مبدأ يوفر توجيهاً للسلوك المناسب) / عمود إرشادي (عمود يحمل لافتة تعطي الاتجاهات أو تظهر الطريق) / مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي. / خُنْفُسَاء نَمِرِيَّة",
 "みちじゅん": "طَرِيق, مَسار (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل)\nمثال: أسأل عن الطريق.",
 "みちすう": "مَجْهُول, مُبْهَم / مُتَغَيِّر / غَامِض, غَوَامِض / كمية مجهولة, مجهول (متغير تكون قيمه حلولاً لمعادلة) / عامل مجهول, كمية مجهولة (عامل في موقف معين لا يكون تأثيره وأهميته واضحين)\nمثال: لا أعرف ماذا سيفعل الرجل الجديد؛ لا يزال عاملاً مجهولاً",
 "みちすじ": "طَبَق, وَجْبَة (جَعَلَ شيئًا يغطي شيئًا آخر بشكل كامل؛ نفَّذَ أمرًا أو خطةً عمليةً) / مَسار (المَسَار: اسم مكان من سارَ : مسلك ، طريق ؛ خَطُّ السَّيْر؛ مَسَار كوكب حول الشَّمس : مدار)\nمثال: هذا الطبق لذيذ. / استدلال, تفكير منطقي (تفكير متماسك ومنطقي)",
 "みちずれ": "رفيق, رفيق السفر (مسافر يرافقك) / رفيق الدرب (متعاطف مع الشيوعية (ولكن ليس عضوًا في الحزب الشيوعي))",
 "みちたりる": "نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه.",
 "みちづれ": "رفيق, رفيق السفر (مسافر يرافقك) / رفيق الدرب (متعاطف مع الشيوعية (ولكن ليس عضوًا في الحزب الشيوعي))",
 "みちなか": "على الطريق, في جولة (التجوال في الأرجاء)\nمثال: أخذوا العرض في جولة / فِي الطَّرِيق (حَرْف جَرّ يَدُلّ على؛ الظَّرْفيَّة المكانيَّة أو الزَّمانيَّة)\nمثال: جون في عمر أخي.",
 "みちなかば": "فِي مُنْتَصَف الطَّرِيق (في نصف المسافة؛ في المنتصف) / مُنْتَصَف, وَسَط (على مسافة متساوية من الأطراف) / جُزْئِيّ, نِصْفِيّ (لا يشمل إلّا النصف أو جزءًا فقط) / فِي مُنْتَصَفِ الطَّرِيق (عِنْدَ نُقْطَةٍ وَسَطٍ بَيْنَ طَرَفَيْنِ)\nمثال: كان في منتصف السلم عندما سقط",
 "みちならぬ": "فاسد, لا أخلاقي (ينتهك عمداً المبادئ المقبولة للصواب والخطأ) / فَاسِد, لَا أَخْلَاقِيّ (لا يلتزم بالمبادئ الأخلاقية أو القِيَمية)",
 "みちにまよう": "اُغْرُب عَن وَجْهِي!, إِبْتَعِد عَنِّي! / ضَلَّ الطَّرِيق",
 "みちのり": "بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مَسَافَة / بَعَّدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى. / طَرِيق, صِرَاط (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من ٱلشَّارِعِ، سَبِيل) / صِرَاط, مَسَار / مَحَجَّة\nمثال: أسأل عن الطريق.",
 "みちばしり": "جواب (الجَوَاب : ما يكون رَدًّا على سؤالٍ أَو دعاءٍ أَو دَعْوَى، أَو رسالةٍ أَو اعتراضٍ ونحو ذلك والجمع : أَجوبة الأعراف - 82؛ الجَوَاب: صوت جَوْبِ الطير وفي حديث بناءِ الكعبة: حديث شريف فسمعنا جواباً من السماءِ، فإِذا بطائر أَعظم من النَّسر)\nمثال: لقد وجدتم الجواب.",
 "みちばた": "جانب الطريق (حافة طريق أو مسار)\nمثال: زهور على جانب الطريق",
 "みちびき": "إِرْشَاد, هِدَايَة / هِدَايَة, إِرْشَاد",
 "みちびきだす": "دَلَجَ, غَرَفَ / رَسَمَ (سَم الشَّيءَ :خطّه رسَم مُربَّعًا/ صورةً/ شكلاً؛ رسَم : كَتَبَ) / قُرْعَة\nمثال: واصل زيري الرسم.",
 "みちびきて": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي.",
 "みちびく": "مُرْشِد, مُرْشِد سِيَاحِيّ (المُرْشِد : من يقوم بدور التَّوجيه والإرشاد؛ من يُساعد السُّفن بتعليماته لاجتياز القنوات أو للإرساء في المرافئ) / دَلِيل / دَلَّ, هَدَى (مَعِدَة، بَطْن؛ قَلْب)\nمثال: كيف استطيع الحصول على مرشد سياحي. / استمد / استنتج",
 "みちぶしん": "إنشاء الطرق, رصف الطرق (عملية بناء الطرق وتشييدها)",
 "みちべ": "جانب الطريق (حافة طريق أو مسار)\nمثال: زهور على جانب الطريق",
 "みちゃく": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "みちゃくしゅ": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "みちやなぎ": "عشب العقدة (عشب ضار منخفض النمو بسنيبلات على طول سيقان الأوراق)",
 "みちゆき": "ترحال, سفر (فعل الذهاب من مكان إلى آخر)\nمثال: استمتع بالبيع لكنه كره السفر",
 "みちゆくひと": "عابر سبيل, مار (شخص يمر بشكل عارض أو بالصدفة)",
 "みちる": "مَلَأَ / شَمْع, شَمَع ((شَمَعَ) يَشْمُعُ شَمْعًا، وشُمُوعًا: مَزَحَ وطَرِبَ)\nمثال: أشعل كين الشمع. / نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه. / نَاضِج, رَاشِد",
 "みちわき": "جانب الطريق (حافة طريق أو مسار)\nمثال: زهور على جانب الطريق",
 "みちをふみはずす": "ضَلَّ",
 "みちをゆずる": "أَجْزَأَ (أَجْزَأَ القومُ: جَزَأَتْ إِبِلُهُمْ؛ أَجْزَأَ المرأَةُ: ولدت الإِنَاث) / أَجْزَى / أَدَرَّ ((أَدِرَ) أدرا وأدرة وأدرة: انتفخت خصيته لتسرب سائل في غلافها فهو آدر وأدرت الخصية فهي أدراء (ج) أدر) / أَغَلَّ / أَكْسَبَ / أَمَّنَ (وَثِقَ به وأرْكَنَ إليه) / إِفَادَة / إِفَادَةٌ مِنْ / إِنْتاج / إِيراد / اِسْتِفَادَة / جَدَاء\nمثال: لا أدر لماذا بكيت هذا القدر كله.",
 "みぢか": "مَأْلُوف",
 "みぢかい": "مَأْلُوف",
 "みっかてんか": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا)",
 "みっかでんか": "سَرِيع الزَّوَال, عَابِر (لا يدوم إلّا وقتًا قصيرًا جدًّا)",
 "みっかとあげず": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: العالم يتغير باستمرار",
 "みっかにあげず": "باستمرار, بشكل متواصل (بشكل ثابت لا يتغير) / باستمرار, دائماً (بدون تنوع أو تغيير، في كل حالة)\nمثال: العالم يتغير باستمرار",
 "みっかはしか": "حصبة ألمانية (مرض فيروسي معدٍ هو شكل أخف من الحصبة يستمر ثلاثة أو أربعة أيام؛ يمكن أن يضر بالجنين خلال الأشهر الثلاثة الأولى)",
 "みっかばしか": "حصبة ألمانية (مرض فيروسي معدٍ هو شكل أخف من الحصبة يستمر ثلاثة أو أربعة أيام؛ يمكن أن يضر بالجنين خلال الأشهر الثلاثة الأولى)",
 "みっかコロリ": "كُولِيرَا, هَيْضَة",
 "みっけい": "خطة سرية, لعبة (مخطط سري للقيام بشيء ما (خاصة شيء مخادع أو غير قانوني))\nمثال: دبروا مؤامرة لتشويه سمعة الحاكم",
 "みっける": "وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه. (يتعدى بعلى)) / لَقِيَّة\nمثال: وجد ياني هاتفه.",
 "みっこう": "تجوال خلسة, تسلل (فعل التجوال خلسة)",
 "みっこうしゃ": "مسافر خلسة (شخص يختبئ على متن سفينة أو طائرة أملاً في الحصول على رحلة مجانية)",
 "みっこく": "مَعْلُومَات, مَعْلُومَة",
 "みっこくしゃ": "مخبر, واشٍ (من يكشف معلومات سرية للشرطة أو سلطة أخرى)",
 "みっしつのぼうりょく": "عُنْف مَنْزَلِيّ, عُنْف أُسْرِيّ",
 "みっしゅう": "ثَوْل (بدا فيه الجنون) / اِزْدِحَام / تانترا, تانتريّة (عقيدة التنوير كإدراك لوحدانية الذات والعالم المرئي؛ تجمع بين عناصر الهندوسية والوثنية بما في ذلك العناصر السحرية والصوفية مثل المنترا والمودرا…) / تانترا, تانتريزم (حركة داخل البوذية تجمع بين عناصر الهندوسية والوثنية)",
 "みっしゅうほうじん": "سُلَامَى, سُلَامِيَّة",
 "みっしり": "بحتة, بشكل صارم (مقتصر على شيء ما) / بِحَزْم, بِدِقَّة (بطريقة تتسم بالشدة والدقة) / بشدة, بصرامة (بطريقة صارمة)\nمثال: تحدثنا في العمل فقط (بشكل صارم) / بالكامل, تماماً (إلى أقصى درجة أو مدى؛ بشكل كامل أو كلي) / بشكل واف, تماماً (بشكل كاف؛ أكثر من ملائم) / بالكامل (في إشارة إلى كمية)\nمثال: نمى بالكامل / بتقارب, عن كثب (في علاقة أو موقع قريب في الزمان أو المكان) / بشكل وثيق, حميمياً (بطريقة وثيقة) / بدقة, عن كثب (بطريقة منتبهة)\nمثال: كانت البدايات متقاربة زمنياً",
 "みっせつ": "أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب",
 "みっせん": "غدة رحيقية (غدة (غالباً ما تكون نتوءاً أو انخفاضاً) تفرز الرحيق)",
 "みっそ": "رمية البداية (فعل بدء لعبة كرة السلة بكرة قفز) / إخبارية, معلومة سرية (معلومات داخلية بأن شيئاً ما سيحدث)",
 "みっちゃく": "طباعة بالتلامس (مطبوعة مصنوعة عن طريق تعريض سطح حساس للضوء للتلامس المباشر مع سلبية فوتوغرافية)",
 "みっちゃくいんが": "طباعة بالتلامس (مطبوعة مصنوعة عن طريق تعريض سطح حساس للضوء للتلامس المباشر مع سلبية فوتوغرافية)",
 "みっちり": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً) / بشدة, مكثفاً (إلى درجة عالية؛ بتركيز عال)\nمثال: شعروا بالخسارة بعمق / بإحكام (مثبت أو مربوط بإحكام) / بِإِحْكَام, بِشِدَّة (بطريقة محكمة أو ضيقة)\nمثال: النافذة كانت مغلقة بإحكام",
 "みっつ": "ثَلَاثَة, ثَلَاث (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب.",
 "みっつう": "خِيانة زَوْجِيَّة, زِنَا المُحْصَنَيْن / زِنىً, زِنَاء (مَارَسَ الزِّنَى)",
 "みってい": "جَاسُوس / تَجَسَّسَ / اكتشاف, رصد (فعل اكتشاف شيء ما؛ أو ملاحظة شيء ما) / تجسس, عمل سري (فعل المراقبة السرية لأغراض استخباراتية) / تجسس (الحفاظ على مراقبة سرية أو خفية)",
 "みっともいい": "بشكل صحيح, كما ينبغي (بالطريقة الصحيحة؛ بشكل لائق) / عفيف, لائق (مطابق لأعراف السلوك الجنسي (الأخلاقي)) / لَائِق, مَقْبُول (يفي بالمتطلبات والمعايير المطلوبة) / لَائِق, مُحْتَشِم (يُرَاعِي الآدَابَ الأَخْلَاقِيَّةَ فِي الكَلَامِ وَالسُّلُوكِ وَالمَلْبَس)\nمثال: أرجوك قم بعملك كما ينبغي!",
 "みっともない": "فَاضِح, مُخْزٍ ((للسلوك أو الشخصيَّة) يستحقّ العار أو يجلبه) / فَاضِح, مُخْزٍ (يُسِيءُ إِلَى الحِسِّ الأَخْلَاقِيِّ وَيَضُرُّ بِالسُّمْعَة)",
 "みっぷ": "عَاشِق, عَاشِقَة / مُغْرَم",
 "みっぷう": "عزل الماء (فعل معالجة شيء ما لجعله طاردا للماء)",
 "みっぺいがた": "محاط, مرفق (مقفول عليه أو محاط أو متضمن في الداخل)\nمثال: شرفة مغلقة",
 "みつ": "ثَلَاثَة, ثَلَاث (في هو أحد الأعداد الرياضية، وهو أصغر عدد فردي أولي)\nمثال: حملت ثلاثة كتب. / رَحِيق / عَسَل, شَهْد (عَسَل) / حَبِيبِي, عَزِيزَتِي (الحَبِيْب الذي يُنسب إلى المتكلم؛ كلمة يطلقها المُتَحَابِّيْن على بعضهم البعض) / عَسَل, عَسُّولَة (عَسَل) / عَسَلِيّ\nمثال: يصنع النحل العسل. / مغثر / مَنّ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / ابتذال عاطفي (كتابة أو موسيقى حلوة وعاطفية بشكل مفرط) / تريكل, شراب ذهبي (شراب قصب شاحب اللون) / كَثِيف, غَلِيظ / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب / دَقِيقَة, دِقيقة (وِحْدَة زَمَنِيَّة تساوي ستين ثَانِيَة، وجزءًا من ستّين جزءًا من السَّاعَة؛ في : وحدة لقياس خطوط الطول والعرض) / لَحْظَة / دَقِيقٌ, تَافِهٌ (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: استأذنت لدقيقة. / سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا. / شَمْع, شَمَع ((شَمَعَ) يَشْمُعُ شَمْعًا، وشُمُوعًا: مَزَحَ وطَرِبَ)\nمثال: أشعل كين الشمع. / نَهَضَ, اِرْتَفْعَ (قَامَ) / أَشْرَقَ, شَرَقَ ((أَشْرَقَتِ) الشمسُ: طلعت وأضاءَت على الأرضِ؛ يقال: أَشرقتِ الأَرضِ: أنارت بإشراقِ الشمس)\nمثال: نهض توم على قدميه. / نَاضِج, رَاشِد",
 "みつあなぐま": "غُرَيْر العَسَل",
 "みつあみ": "ضَفَّرَ, ضَفَرَ / جَدِيلَة, ضَفِيرَة",
 "みついろ": "عَسَلِيّ اللَّوْن (ذو لون العسل)",
 "みつうん": "رمية مفرطة (رمية تسقط أبعد من المكان المقصود) / مُكْفَهِرّ, مُلَبَّد بِالغُيُوم (ممتلئ أو مغطى بالغيوم) / حبكة, سرفلة (غرزة ملفقة طويلة أو غرزة علوية تغطي الحافة لمنع التنسيل) / تلبد الغيوم, غائم (شبه ظلام كئيب ناتج عن غطاء سحابي)",
 "みつおり": "ثلاثة أضعاف (بمعامل ثلاثة) / ذُو وَجْهَيْنِ, مُتَعَدِّدُ الْأَوْجُهِ (له أكثر من جانب أو صفة مختلفة بوضوح) / ثَلَاثَةُ أَضْعَافٍ (ثلاثة أمثال الكمية أو العدد)\nمثال: زاد إيجارنا ثلاثة أضعاف في السنوات الخمس الماضية",
 "みつかい": "مَلَاك / مَلْأَك / مَلَك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "みつかど": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "みつき": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "みつぎ": "جِزْيَة / خَرَاج / ضَرِيبَة / سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "みつぎもの": "جِزْيَة / خَرَاج",
 "みつくち": "شفة أرنبية, شفة مشقوقة (شق خلقي في منتصف الشفة العليا)",
 "みつぐ": "تَمْوِيل, مَالِيَّة / مَوَّل",
 "みつけ": "اِقْتَرَبَ / اِقْتِرَاب, مُقَارَبَة (اقتراب) / كَيْفِيَّة, طَرِيقَة\nمثال: هو واصل الاقتراب مني.",
 "みつけだす": "اِكْتَشَفَ",
 "みつける": "وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه. (يتعدى بعلى)) / لَقِيَّة\nمثال: وجد ياني هاتفه.",
 "みつげつ": "شَهْر عَسَل (اسم مفرد: مدة زمنية قدرها 28 أو 29 أو 30 أو 31 يوما، والشَّهرُ جزءٌ من اثني عشر جزئا من السَنَة…)\nمثال: رمضان شهر حرام.",
 "みつげんしょくぶつ": "نبات عسلي (نبات يوفر رحيقاً مناسباً لصنع العسل)",
 "みつご": "بِعُمُر ثَلَاث سَنَوَات (في عامه الثالث من العمر) / ثلاثي (مجموعة من ثلاثة أشياء متشابهة تُعتبر كوحدة واحدة) / توأم ثلاثي (واحد من ثلاثة أبناء ولدوا في نفس الوقت من نفس الحمل) / ثَلَاثَة, ثُلَاثِيّ (العدد الأصلي الذي هو مجموع واحد وواحد وواحد) / كلمات معسولة, همسات الحب (تعبيرات عاطفية غير مهمة المضمون)\nمثال: همس بكلمات معسولة في أذنها",
 "みつごのたましいひゃくまで": "الطَّبْعُ يَغْلِبُ التَّطَبُّعَ",
 "みつざとう": "ابتذال عاطفي (كتابة أو موسيقى حلوة وعاطفية بشكل مفرط) / تريكل, شراب ذهبي (شراب قصب شاحب اللون)",
 "みつじ": "سِرّ, خَفِيَّة (شَعَرَ بِالسُّرُورِ) / سِرِّيّ\nمثال: السر سيبقى سرا.",
 "みつじん": "مُومِيَاء / مَامَا, مَامَان",
 "みつせん": "غدة رحيقية (غدة (غالباً ما تكون نتوءاً أو انخفاضاً) تفرز الرحيق)",
 "みつぞう": "خمر مهرب, مون شاين (ويسكي مقطر بشكل غير قانوني من هريس الذرة) / ضوء القمر (ضوء القمر)\nمثال: ضوء القمر هو عدو المهرب",
 "みつぞうしゅ": "خمر مهرب, مون شاين (ويسكي مقطر بشكل غير قانوني من هريس الذرة) / ضوء القمر (ضوء القمر)\nمثال: ضوء القمر هو عدو المهرب",
 "みつぞろい": "بدلة ثلاثية القطع (بدلة عمل تتكون من سترة وصدرية وبنطال)",
 "みつだえ": "لَوْحَة زَيْتِيَة",
 "みつつぼ": "أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية)",
 "みつど": "كَثَافَة (مصدر لكَثَفَ؛ اللغلظ والثخانة)\nمثال: هذه منطقة من الغابة أقل كثافة",
 "みつどもえ": "ثُلَاثِيّ الأَطْرَاف (يشمل ثلاثة أطراف أو عناصر)",
 "みつどもえのあらそい": "ثُلَاثِيّ (يشمل مجموعة أو ثلاثة أطراف) / ثُلَاثِيُّ الأَرْكَانِ (ذو ثلاثة أركان أو زوايا)",
 "みつにく": "أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية)",
 "みつば": "نَفَل (الثَلَاثُ النُفَل: الليلة الرابعة والخامسة والسادسة من كل شهر قمري…)",
 "みつばあおい": "زنجبيل بري (عشب معمر منخفض النمو ذو أوراق زنجبيلية حريفة وجذامير)",
 "みつばい": "تَهْرِيب",
 "みつばいにん": "مُهَرِّب",
 "みつばいばい": "تَهْرِيب",
 "みつばいひん": "تَهْرِيب",
 "みつばち": "نحل العسل (نحل اجتماعي يتم تدجينه غالباً من أجل العسل الذي ينتجه)",
 "みつぼう": "دَسِيسَة / مُؤَامِرَة, مُوَاطَأَة",
 "みつぼうえき": "تَهْرِيب",
 "みつぼし": "نِطَاق الجَبَّار (الحزام المصنوع من القماش ليس له إبزيم ولا ما أشبه؛ قطعة من القماش تُلفّ على وسط الإنسان. الجمع نُطُق؛ في : هو جزء الدائرة كسطح (ليس قوس)؛ يقال أيضا قطاع. الجمع نطاقات)\nمثال: هل تمثل الزراعة على نطاق واسع النظام البيئي في الجزائر؟",
 "みつまた": "ثُلَاثِيُّ الشُّعَب (ذُو ثَلَاثِ شُعَب)",
 "みつみつ": "سِرًّا ((سَرَا) فلان سروا وسراوة: شرف وسخا في مروءة؛ (سَرَا) الشيء عنه سروا: نزعه وألقاه. يقال سرا عنه ثوبه ودرعه)\nمثال: أبقو حبهما سرا.",
 "みつめなおす": "حَلَّلَ (بالمكان: جعله يحل به؛ الشيء: جعله حلالا بعد أن كان حراما)\nمثال: حلل زيري ذلك الفيديو.",
 "みつめる": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ فُلاناً: إِذا أَصَابَ حَدَقَتَه؛ حدَق به:أَحَاطَ به من كلّ جهة (حدَقت قوات الأمن بالقرية))\nمثال: حدق الجميع في وجهي.",
 "みつもり": "تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء",
 "みつもりかかく": "اِقْتِبَاس, اِسْتِشْهَاد (مصدر : اقتبس؛ واقْتَبَسَهَا: أَخَذَهَا . واقْتَبَسَ العِلْمَ وَمن العِلْم: اسْتَفادَه) / عَلَامَة اِقْتِبَاس, عَلَامَة تَنْصِيص (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز) / سَعَر (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ) / سِعْرُ ٱلْأَسْهُم (سَعِرَ يَسْعَرَ سَعَراً، وسُعْرَةً: ضرب لونه إِلى السواد فُوَيْقَ الأُدْمة؛ فهو أَسْعَرُ، وهي سَعْراءُ. والجمع: سُعْرٌ) / اِسْتَشْهَدَ, اِقْتَبَسَ\nمثال: تحصلت على علامة أ.",
 "みつもりしょ": "اقتباس (ممارسة الاقتباس من الكتب أو المسرحيات وغيرها) / اقتباس (مقطع أو تعبير مقتبس أو مستشهد به) / تسعيرة, سعر السوق (بيان لسعر السوق الحالي لورقة مالية أو سلعة) / إشارة مرجعية, استشهاد (ملاحظة قصيرة تعترف بمصدر المعلومات أو فقرة مقتبسة)\nمثال: بما أنه يفتقر إلى الأصالة، يجب عليه الاعتماد على الاقتباس",
 "みつもる": "تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء",
 "みつゆ": "تَهْرِيب",
 "みつゆせん": "مُهَرِّب",
 "みつゆにん": "مُهَرِّب",
 "みつりょう": "صَيْد جَائِر",
 "みつりょうしゃ": "صَيَّاد غَيْر قَانُونِيّ (اِسْمٌ وَصِفَةٌ لِلْأَسَد)\nمثال: قتل الصياد دبا.",
 "みつりん": "أَجَمَة, أَدْغَال / نَهْر الأمازون, الأَمَزونْ (صَارَ عَصَبِيًّا وغَضِبَ؛ أَصَابَ الشَّيْءَ أو الكَائِنَ بِغَضَبٍ أو صَارَ يَأْمُرُهُ)\nمثال: عبر جوناس النهر.",
 "みつろう": "شَمْع الْعَسَل ((شَمَعَ) يَشْمُعُ شَمْعًا، وشُمُوعًا: مَزَحَ وطَرِبَ)\nمثال: أشعل كين الشمع.",
 "みづらい": "غير مميز, غير واضح (غير محدد بوضوح أو ليس من السهل إدراكه أو فهمه)\nمثال: أشكال غير واضحة في الظلام",
 "みてい": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "みていぎ": "غامض, غير محدد (غير محدود أو مقرر أو مميز بدقة)\nمثال: مصطلح غير محدد (مبهم)",
 "みてくれ": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "みてとる": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد أن سَبَقَه)\nمثال: لم أدرك أبدا أنه يحبني.",
 "みてまわる": "تَلَفَّتَ",
 "みてもらう": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا. / نَصَحَ (نصحه: أَرْشَدَه وأَشَارَ عليه) / اِسْتَشَارَ\nمثال: نصح مناد بباية.",
 "みと": "أَعْضَاء تَنَاسُلِيَّة / مِيتُو",
 "みとう": "بِلَا مَسَالِك, وَعْر (يفتقر إلى الممرّات والطرق المعبَّدة) / بَعِيد المَنَال, لَا يُمكِن الوُصُول إِلَيْه (يقع في مكان يتعذّر الوصول إليه)",
 "みとうき": "غَيْر مُسَجَّل ((عَنِ القَارِب أَوِ السَّفِينَة) غَيْر مُزَوَّد بِالوَثَائِق الرَّسْمِيَّة) / غير مسجل (غير مسجل) / غير مسجل ((للحيوانات) غير مسجل أو معتمد لدى جمعية سلالة رسمية)\nمثال: مواطن غير مسجل",
 "みとうさ": "غَيْر مُكْتَشَف (لم يُكتشَف بعد)",
 "みとうろく": "غَيْر مُسَجَّل ((عَنِ القَارِب أَوِ السَّفِينَة) غَيْر مُزَوَّد بِالوَثَائِق الرَّسْمِيَّة) / غير مسجل (غير مسجل) / غير مسجل ((للحيوانات) غير مسجل أو معتمد لدى جمعية سلالة رسمية)\nمثال: مواطن غير مسجل",
 "みとおし": "مَنْظُور, نَظْرَة / تَنَبَّأَ / تَوَقُّع / نظرة ثاقبة",
 "みとおす": "قَرَأَ (نَطَقَ بما هو مكتوب؛ تَتَبَّعَ ما هو مكتوب وفَهِمَه)\nمثال: قرأ سامي الرسالة. / تَوَقَّعَ",
 "みとがめる": "سُؤَال, سؤال (سُؤَال) / مَسْأَلَة / استفهم\nمثال: أجب على السؤال.",
 "みとし": "حَبَة (واحدة الحَبّ؛ البَذْرَة، لأنها صغيرة مثل الحبة) / حُبُوب / تَجْزِيع, تَعْرِيق\nمثال: أكلت حبة طماطم.",
 "みとどけ": "غَيْر مُبَلَّغ عَنْه (لم يتم الإبلاغ عنه)\nمثال: نتائج غير مبلغ عنها",
 "みとどける": "تَيَقَّنَ, تَثَبَّتَ",
 "みとめ": "قُبُول, قَبُول (القبول: الرِّضَا بالشيء وميل النفس إليه والحسن والشارة وريح الصبا؛ (المعجم الوسيط)؛ ريح شرقية)\nمثال: أميل إلى قبول العرض. / ختم توقيع (ختم (خاصة الذي يستخدم لتمييز الوثائق رسمياً))",
 "みとめあう": "وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: وافق ماثيو بتردد.",
 "みとめいんつきゆびわ": "خاتم الختم (خاتم يحمل ختماً)",
 "みとめる": "تَعَرَّفَ / حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت. / صَدَّقَ, وَافَقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع) / اِسْتَحَسَنَ, وَافَقَ (عَدَّه حَسَنا بمعنى جميل؛ عدَّه حسنًا بمعنى جَيِّد) / وَافَقَ (صَادَفَ؛ صَادَقَ)\nمثال: صدق سامي كل شيء. / أَعْتَرَفَ",
 "みとり": "اِدْرََاك حَسِّيّ / تَمْرِيض (تَمْرِيض: اعتنى بالمَرِيض أثناء مرضه؛ التَمْرِيض: المهنة التي يقوم أصحابها بالعناية بالمَرْضَى أثناء مرضهم) / مثال: كانت ليلى طالبة تمريض جميلة. / خنفساء ساعة الموت (تحفر في الخشب وتصدر صوتاً يشبه دقات الساعة يعتقد شعبياً أنه ينذر بالموت) / قمل الكتب (حشرات دقيقة غير مجنحة من رتبة سوكوبترا ضارة بالكتب والأوراق)",
 "みとりず": "مُخَطَّط أَرْضِيَّة الدَّوْر",
 "みとる": "مُمَرِّض / مُمَرِّضَة / ممرض / أَرْضَعَ ((أَرْضَعَت) الْأُم: كَانَ لَهَا ولد تُرْضِعه؛ (أَرْضَعَت) الْولد: جعلته يرضع فَهِيَ مرضع ومرضعة (ج) مراضع) / مَرَّضَ (أصابه مرضٌ أو علّة أو سَقَم)\nمثال: هذا المرض قلبي. / أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد أن سَبَقَه)\nمثال: لم أدرك أبدا أنه يحبني.",
 "みどう": "مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع / كَاتِدْرَائِيَّة",
 "みどく": "غَيْرُ قَارِئ (لم يكتسب معرفة عن طريق القراءة) / تذوق (أخذ كمية صغيرة في الفم لاختبار جودتها)\nمثال: كان الطهي جيدًا ولكن التذوق هو ما استمتع به أكثر",
 "みどころ": "إبراز ضوئي, منطقة مضيئة (منطقة من السطوع في الصورة) / الجزء الأبرز, علامة مميزة (الجزء الأكثر إثارة للاهتمام أو الذي لا يُنسى)\nمثال: كان الجزء الأبرز في الجولة زيارتنا للفاتيكان / وَعْد, وَعْدَة (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / وَعَدَ, تَعَهَّدَ (التزم قولًا بفعل شيء في المستقبل؛ وعد بشيء: بشر به أو أغراه به) / بَشَّرَ (بَشَرَ؛ بُشِرَ)\nمثال: وعد بأن يتزوجها.",
 "みども": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك، يستخدم حين يكون المنادى نَكِرَة؛ حرف تَفْسِير بمعنى \"يعني\"، يفيد بأن المُفسَّر مطابق للتفسير)\nمثال: لم تقصد أي أذى.",
 "みどり": "أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات؛ صفة ما كان لونه أخضرا) / خُضْر (خَضَر الرجلُ النَّخْلَ خَضَر ُ خَضْرًا: قطعه)\nمثال: ذلك الضوء أخضر. / خضرة (أوراق خضراء)",
 "みどりいろ": "أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات؛ صفة ما كان لونه أخضرا) / خُضْر (خَضَر الرجلُ النَّخْلَ خَضَر ُ خَضْرًا: قطعه)\nمثال: ذلك الضوء أخضر.",
 "みどりがかった": "أَخْضَر (بلون بين الأزرق والأصفر في الطيف اللوني؛ مشابه للون العشب الطازج)",
 "みどりご": "رَضِيع",
 "みどりざる": "سعدان أخضر (قرد سافانا شائع ذو ظهر رمادي مخضر وذيل أصفر)",
 "みどりつばめ": "سنونو الشجر (من أستراليا وبولينيزيا؛ يعشش في تجاويف الأشجار) / سنونو أبيض البطن (سنونو أخضر مزرق وأبيض من أمريكا الشمالية؛ يعشش في تجاويف الأشجار)",
 "みどりのおばさん": "حارِس عُبُور (شخص يساعد الناس (خاصة الأطفال) عند معبر المرور)",
 "みどりのかくめい": "ثورة خضراء (إدخال المبيدات الحشرية والحبوب عالية الغلة والإدارة الأفضل خلال الستينيات والسبعينيات مما زاد بشكل كبير من الإنتاجية الزراعية)",
 "みどりのとう": "حزب الخضر (حزب سياسي بيئي)",
 "みどりのゆび": "مَهَارَة زِرَاعِيَّة, يَد خَضْرَاء (قدرة خاصة على جعل النباتات تنمو)",
 "みどりむし": "يوجلينا (كائن دقيق أخضر وحيد الخلية يعيش في المياه العذبة وله سوط واحد؛ يصنف غالباً كطحالب)",
 "みどりゆたか": "أَخْضَر, مُخْضَرّ (يتّسم بوَفْرة الخُضْرة والنبات)",
 "みどり児": "رَضِيع",
 "みどり色": "أَخْضَر, خَضْرَاء (أحد الألوان الثانوية يتكون من خلط الأَصْفَر والأَزْرَق وهو لون وَرَق النَبَات؛ صفة ما كان لونه أخضرا) / خُضْر (خَضَر الرجلُ النَّخْلَ خَضَر ُ خَضْرًا: قطعه)\nمثال: ذلك الضوء أخضر.",
 "みどろ": "مُبَقَّع, مُلَطَّخ (موسوم أو مصبوغ أو متغير اللون بمادة غريبة) / مَصْبُوغ, مُلَمَّع (مُغَطًّى بِطَبَقَةٍ مِنَ الصَّبْغِ أَوِ الوَرْنِيش)\nمثال: مفرش طاولة ملطخ بشدة",
 "みな": "الْجَمِيع, كُلّ شَخْص / كُلّ شَيْء",
 "みなうら": "عرافة الماء (التنجيم بواسطة الماء)",
 "みなおし": "فحص لاحق, متابعة (فحص لاحق للمريض لغرض مراقبة العلاج السابق) / تفتيش, معاينة (فحص رسمي أو حكومي) / تنشيط, مراجعة (ممارسة تهدف إلى صقل الأداء أو إنعاش الذاكرة) / مراجعة ((قانون) إعادة فحص قضائي لإجراءات محكمة (خاصة من قبل محكمة استئناف))\nمثال: وقفت الفصيلة جاهزة للتفتيش",
 "みなおす": "أَعَادَ الفحص, رَاجَعَ (نظر مرة أخرى؛ فحص مرة أخرى)\nمثال: لنراجع وضعك / حَسَّنَ (جَمِيل؛ مُبْهِج) / تَحَسَّنَ\nمثال: إيمي فتاة حسنة.",
 "みなかみ": "أعالي النهر, منبع النهر (مصدر النهر)\nمثال: منابع النيل",
 "みながみな": "اَلْجَمِيع, كُلّ شَخْص",
 "みなぎる": "فَيَضَان / فَاضَ",
 "みなごろし": "مَذْبَحَة, مَجْزَرَة (الحَادِثَة أو المَعْرَكَة التي يقتل فيها ناس كثيرون) / قَتَّلَ, ذَبَّحَ (تعمّد جعله يَمُوتُ، أزهق روحه، أمَاتَه متعمدا؛ الوقتَ: ضيعه بشيء غير ذي فائدة وهو ينتظر أمرا آخر)\nمثال: قتل الصياد دبا.",
 "みなさま": "الْجَمِيع, كُلّ شَخْص",
 "みなさまがた": "الْجَمِيع, كُلّ شَخْص",
 "みなさん": "كُلّ, جَمِيع",
 "みなし": "حَكَم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "みなしがわ": "وادي (أخدود أو قاع سيل في شمال أفريقيا والشرق الأوسط يظل جافاً إلا خلال موسم الأمطار)",
 "みなす": "تحديق, نظرة ثابتة (نظرة ثابتة وطويلة) / اكتراث, اهتمام (إيلاء اهتمام خاص (كما هو الحال مع الأطفال أو العاجزين)) / جانب, صدد ((عادة تسبقها 'في') تفصيل أو نقطة معينة) / احترام, تقدير (موقف يتسم بالإعجاب والتقدير)\nمثال: ثبت نظرته الأبوية علي",
 "みなそこ": "قاع النهر (قناة يشغلها (أو كان يشغلها) نهر)",
 "みなつき": "يُونِيُو, حَزِيرَان (الشهر السادس في السنة الميلادية الغربية المعرّبة)\nمثال: ستتزوج ابنتي في يونيو",
 "みなづき": "يُونِيُو, حَزِيرَان (الشهر السادس في السنة الميلادية الغربية المعرّبة)\nمثال: ستتزوج ابنتي في يونيو",
 "みなと": "مرفأ, ملاذ (مكان للملجأ والراحة والأمان) / مرفأ, ميناء بحري (ميناء محمي حيث يمكن للسفن شحن أو تفريغ البضائع)",
 "みなのしゅう": "اَلْجَمِيع, كُلّ شَخْص",
 "みなのもの": "اَلْجَمِيع, كُلّ شَخْص",
 "みなまたびょう": "داء ميناماتا (شكل من أشكال التسمم بالزئبق بين الأشخاص الذين أكلوا الأسماك من مياه خليج ميناماتا الملوثة بالزئبق قبالة اليابان في الخمسينيات؛ يتميز بتدهور عصبي حاد)",
 "みなまで": "النِهاية",
 "みなみ": "جَنُوب (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب) / جنوب (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب) / جَنوب (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "みなみいる": "تَحْتَ (أَقَلَّ) / جَنُوبِيّ\nمثال: أنا تحت الشجرة.",
 "みなみかいきせん": "مَدَار الْجَدْي (اسم مَفْعُول من أدَارَ، الشيء أو الشخص الذي أُدِير)\nمثال: انتشرت الشائعة على مدار الدولة.",
 "みなみかぜ": "رياح جنوبية (رياح تهب من الجنوب) / صَيْف, صيف (فصل من فصول السنة الأربعة، يلي الرَّبِيع ويأتي بعده الخَرِيف، يتميز بشدة الحَرّ)\nمثال: نأتي هنا كل صيف.",
 "みなみがわ": "الجانب الجنوبي (الجانب الذي يقع في الجنوب)",
 "みなみごち": "رياح شرقية (رياح تهب من الشرق)",
 "みなみしなかい": "بَحْر الصِّين الْجَنُوبِيّ (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "みなみじゅうじ": "صَلِيب اَلْجَنُوب",
 "みなみじゅうじざ": "مَرْبِط الْفَرَس",
 "みなみじゅうじせい": "صَلِيب اَلْجَنُوب",
 "みなみじゅうじ座": "مَرْبِط الْفَرَس",
 "みなみたいへいよう": "جنوب المحيط الهادئ (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "みなみちょうせん": "كُورِيَا الْجَنُوبِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة؛ دولتان تقعان في جنوب شرق آسيا تسميان كُوْرِيَا الشَمَالِيَّة وكُوْرِيَا الجَنُوْبِيَّة)\nمثال: أريد أن أزور كوريا.",
 "みなみな": "كُلّ, جَمِيع / كُلّ شَيْء",
 "みなみなさま": "الْجَمِيع, كُلّ شَخْص",
 "みなみにし": "باتجاه الجنوب الغربي (إلى أو نحو أو في الجنوب الغربي) / جَنُوب غَرْبِيّ (يقع في الجنوب الغربي أو موجَّه نحوه) / قَادِم مِنَ الجَنُوب الغَرْبِيّ (قادم من اتجاه الجنوب الغربي) / جنوب غرب (موقع في الجزء الجنوبي الغربي من بلد أو منطقة أو مدينة)",
 "みなみのさんかくざ": "الْمُثَلَّث الْجَنُوبِيّ",
 "みなみのさんかく座": "الْمُثَلَّث الْجَنُوبِيّ",
 "みなみはんきゅう": "نِصْف اَلْكُرَة الْأَرْضِيَّة الجَنُوبِيّ",
 "みなみひがし": "باتجاه الجنوب الشرقي (إلى أو نحو أو في الجنوب الشرقي) / جَنُوب شَرْقِيّ (يقع في الجنوب الشرقي أو موجَّه نحوه) / قَادِم مِنَ الجَنُوب الشَّرْقِيّ (قادم من اتجاه الجنوب الشرقي) / جنوب شرق (موقع في الجزء الجنوبي الشرقي من بلد أو منطقة أو مدينة)",
 "みなみより": "جنوبياً, من الجنوب (قادماً من الجنوب) / جنوباً, نحو الجنوب (باتجاه الجنوب) / جَنُوبِيّ المَصْدَر (قادم من الجنوب؛ يوصف به خاصة الرياح) / جَنُوبِيّ الاتِّجَاه (يقع في الجنوب أو موجَّه نحوه)\nمثال: هبت رياح جنوبية",
 "みなみア": "جَنُوب أَفْرِيقْيَا, أَفْرِيقِيَا الْجَنُوبِيَّة (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "みなみアジア": "جَنُوب آسِيَا (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "みなみアジアごぞく": "اللغات الأسترو آسيوية (عائلة من اللغات يتم التحدث بها في جنوب وجنوب شرق آسيا)",
 "みなみアフリカ": "جَنُوب أَفْرِيقْيَا, أَفْرِيقِيَا الْجَنُوبِيَّة (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "みなみアフリカきょうわこく": "جُمْهُورِيَّة جَنُوب أَفْرِيقْيَا",
 "みなみアフリカこうくう": "جنوب أفريقي (متعلق بجنوب أفريقيا أو شعبها أو مميز لها) / جَنُوب أَفْرِيقِيّ (مواطن أو ساكن في جنوب أفريقيا)",
 "みなみアフリカじゅんびぎんこう": "جنوب أفريقي (متعلق بجنوب أفريقيا أو شعبها أو مميز لها) / جَنُوب أَفْرِيقِيّ (مواطن أو ساكن في جنوب أفريقيا)",
 "みなみアフリカじん": "جنوب أفريقي (متعلق بجنوب أفريقيا أو شعبها أو مميز لها) / جَنُوب أَفْرِيقِيّ (مواطن أو ساكن في جنوب أفريقيا)",
 "みなみアフリカてんもんだい": "جنوب أفريقي (متعلق بجنوب أفريقيا أو شعبها أو مميز لها) / جَنُوب أَفْرِيقِيّ (مواطن أو ساكن في جنوب أفريقيا)",
 "みなみアフリカほうそうきょうかい": "جنوب أفريقي (متعلق بجنوب أفريقيا أو شعبها أو مميز لها) / جَنُوب أَفْرِيقِيّ (مواطن أو ساكن في جنوب أفريقيا)",
 "みなみアメリカ": "أَمْرِيكَا الْجَنُوبِيَّة, أَمِيرِكَا الْجَنُوبِيَّة",
 "みなみオポッサム": "أبوسوم شائع (أبوسوم قارت من شرق الولايات المتحدة؛ يشتهر بالتظاهر بالموت عند الخطر؛ يُقدر كطعام في بعض المناطق)",
 "みなみオーストラリアしゅう": "جُنُوب أُسْتْرَالِيَا, أستراليا الجنوبية (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "みなみシナかい": "بَحْر الصِّين الْجَنُوبِيّ (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "みなみスーダン": "جَنُوب السُّودَان (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "みなみスーダンきょうわこく": "جمهورية جنوب السودان",
 "みなみヨーロッパ": "أُورُوبَّا اَلْجَنُوبِيَّة (الجزء من يوراسيا الذي يقع غرب جبال الأورال، والمعتبر تقليديًّا قارة بحد ذاته، كما يقع شمال قارة إفريقيا، وغرب قارة آسيا، وشرق المحيط الأطلسي؛ كيان سياسي؛ الاتحاد الأوروبي)\nمثال: ذهبت إلى أوروبا مرة.",
 "みなもと": "مَصْدَر, مَصَادِر (مَصْدَر) / عَيْن (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / مَصْدَر (مَصْدَر)\nمثال: ما مصدر هذا الخوف؟",
 "みならい": "تدريب مهني, تلمذة مهنية (منصب المتدرب المهني) / مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "みならいこう": "مُبْتَدِئ, مُبْتَدِئَة (من يبتدئ في تعلّم علم أو فنّ، شخص قليل الخبرة)\nمثال: إنك محترف وأنا مبتدئ.",
 "みならう": "قَلَّدَ / تَعَلَّمَ (اكتسب معرفة أو خبرة أو مهارة) / اِعْتَبَرَ, اِتَّعَظَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين)\nمثال: هو سريع التعلم.",
 "みなり": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / ثَوْب, لِبَاس (ما يُلْبَسُ من اللِبَاس، أي جزء ويطلق للرجال والنساء؛ الجزء الرئيس من الملابس، غالبا ما يكون طويلا وواسعا وذو أكمام، تحته الملابس الداخلية وفوقه الخارجية. يستخدم للرجال والنساء) / كَسْوَة, مَلْبَس\nمثال: لبس سروالا نظيفا.",
 "みなわ": "رَغْوَة / زَبَد (هو السَمْن الموجود في الحَلِيب يستخرج بأن يُخَضّ الحليب خَضا مستمرا حتى يتكتل بداخله) / زَبَد البَحْر (هو السَمْن الموجود في الحَلِيب يستخرج بأن يُخَضّ الحليب خَضا مستمرا حتى يتكتل بداخله)\nمثال: اشترت رطلي زبدة. / لَا شَيْء (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "みにいく": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "みにおぼえのある": "مَأْلُوف",
 "みにくい": "قَبِيح, بَشِع (ضد الحَسَن، وهو ما نَفَرَ منه الذوق السليم ويشمل القول والفعل والصورة؛ القَبَاح)\nمثال: نادتني بالقبيح. / كَرِيه المَنْظَر (غير سار للنظر) / مُظْلِم",
 "みにくいあひるのこ": "بَطَّة قَبِيحَة (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق)\nمثال: إني أصوب على تلك البطة.",
 "みにくいあひるの子": "بَطَّة قَبِيحَة (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق)\nمثال: إني أصوب على تلك البطة.",
 "みにくいアヒルの子": "بَطَّة قَبِيحَة (نوع من الطيور يسبح في الماء والأنواع البرية منه تهاجر إلى إفريقيا شتاءً؛ العضلة الخلفية في الساق)\nمثال: إني أصوب على تلك البطة.",
 "みにくる": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا.",
 "みにつく": "سَيِّد / أُصُولِيّ, أُصُولِيَّة / أحسن, أتقن ((أَحْسَنَ): فعل مَا هُوَ حسن؛ (أَحْسَنَ) الشَّيْء: أَجَاد صنعه وأتقنه)\nمثال: يبدو زيري أحسن. / أَبْقَى / أَدَامَ / بَقَّى / حَفِظَ (الحِفْظُ نَقِيضُ النِّسْيَان، وهو التَّعَاهُدُ وقِلَّةُ الغَفْلَةِ؛ قِلَّةُ الغَفْلَةِ) / رَعَى / صانَ\nمثال: حفظ رقم هاتفها.",
 "みにつける": "تَعَلَّمَ (اكتسب معرفة أو خبرة أو مهارة) / اِعْتَبَرَ, اِتَّعَظَ (الشيءَ: اختبره وامتحنه ونظر فيه؛ الشيءَ شيءًا: عَدُّه كذلك وتصرف على ذلك الأساس. بمفعولين)\nمثال: هو سريع التعلم. / حَمَلَ (رَفَعَ، أَقَلَّ)\nمثال: حمل سامي سلاحه.",
 "みにでかける": "حَضَرَ (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً؛ ويُعَدَّى فَيُقَالُ: حَضَرَه وحَضِرَه؛ حَضَرَ، كنَصَرَ وعلِمَ، حُضُورًا وحضارَةً: ضِدُّ غابَ)\nمثال: حضر كل شيئ لرحلتي.",
 "みにまとう": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا.",
 "みにゅうりょく": "خَالٍ, اَلْخَالِي (بمعنى ظَنَّ، استخدام نادر والأغلب استخدام خَيْل أو مَخَالَة؛ أخو الأم. جمعه أخوال للمذكر وخالات للمؤنث)\nمثال: عندي ابنا خالة.",
 "みぬく": "أَدْرَكَ, وَعَى (وَصَلَ إلى الشَّيءِ، بَلَغَهُ (مَكَان، قِيمَة، حَال، هَدَف)؛ لَحِقَ الشيءَ بعد أن سَبَقَه)\nمثال: لم أدرك أبدا أنه يحبني.",
 "みぬぐい": "منشفة وجه, منشفة يد (منشفة صغيرة تستخدم لتجفيف اليدين أو الوجه)",
 "みね": "أَوْجٌ, ذُرْوَةٌ",
 "みねずおう": "أزاليا ألبية, أزاليا جبلية (شجيرة دائمة الخضرة زاحفة تشكل حصيرة من المناطق الجبلية العالية في نصف الكرة الشمالي تزرع لأزهارها الوردية)",
 "みねみね": "أَوْجٌ, ذُرْوَةٌ",
 "みのある": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / جَامِد\nمثال: هذا التخت جدا صلب.",
 "みのうえばなし": "ترجمة حياة, سيرة ذاتية (سرد لسلسلة الأحداث التي تشكل حياة شخص ما)",
 "みのうしゃ": "متخلف عن الحضور, منسحب (متسابق يخسر المباراة لعدم الحضور) / مماطل, مُتَخَلِّف عن الدفع (شخص يفشل في الوفاء بالتزام مالي) / متخلف عن الحضور (شخص يفشل في المثول المطلوب أمام المحكمة)",
 "みのがし": "مُشْرِف, مُطِلّ (يُستخدَم لوصف ارتفاع أو موقع مُطِلّ على ما حوله)",
 "みのがす": "أَخْطَأَ ((أخْطَأَ): خَطِئَ؛ (أخْطَأَ) غَلِظَ (حاد عن الصواب)) / فَاتَ / اِفْتَقَدَ, اِشْتَاقَ / آنِسَة\nمثال: اعترف أنه أخطأ. / صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "みのけ": "شَعْرُ الجِسْم (شعر قصير ينمو على جسم الإنسان)",
 "みのけのよだつ": "كَابُوسِيّ, مُقْشَعِرّ (مخيف إلى أقصى حد؛ يُجمِّد الدماء في العروق)",
 "みのこなし": "عَرَبَة",
 "みのごい": "منشفة وجه, منشفة يد (منشفة صغيرة تستخدم لتجفيف اليدين أو الوجه)",
 "みのしろきん": "فِدْيَة / اِفْتَدَى, فَدَى",
 "みのたけ": "طول, قامة ((لشخص واقف) المسافة من الرأس إلى القدم) / قامة, منزلة رفيعة (مستوى عالٍ من الاحترام يتم اكتسابه من خلال التطور أو الإنجاز المثير للإعجاب)\nمثال: رجل ذو قامة عظيمة",
 "みのたけにあう": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ) / نَاسَبَ, لَاقَ / نَاسَبَ",
 "みのない": "غير جوهري, غير مادي (يفتقر إلى الشكل المادي أو المادة؛ غير حقيقي) / رَقِيق, هَشّ (يفتقر إلى الصلابة أو المتانة) / فَقِير غِذَائِيًّا (يفتقر إلى القيمة الغذائيّة)\nمثال: غير جوهري مثل حلم",
 "みのほどしらず": "مُتَعَجْرِف, مُتَغَطْرِس (مُتَكَبِّرٌ بِشَكْلٍ وَقِحٍ وَمُتَجَاوِزٍ لِلْحُدُود) / مُبَالَغٌ فِيه, مُفْرِط (بلا قيود، خاصة فيما يتعلق بالمشاعر)",
 "みのまわりひん": "أغراض شخصية, متعلقات شخصية (ممتلكات ذات طابع شخصي قابلة للحمل ولا تستخدم في الأعمال التجارية)\nمثال: تركت بعض متعلقاتها الشخصية في المنزل",
 "みのむしクリップ": "مشبك تمساح (مشبك بزمبرك يغلق الفكين المعدنيين)",
 "みのり": "إيناع, نضج (الوصول إلى التطور الكامل؛ أن يصبح ناضجًا) / تعتق, نضج (اكتساب صفات مرغوبة عن طريق ترك الشيء دون إزعاج لبعض الوقت) / مَحْصُول / حَوْصَلة",
 "みのりある": "مجز, مرض (يوفر الرضا الشخصي)\nمثال: مهنة مجزية كمسعف",
 "みのりおおい": "مثمر",
 "みのる": "يَنَعَ, نَضَجَ (أَيْنَعَ؛ نَضَجَ)",
 "みの虫クリップ": "مشبك تمساح (مشبك بزمبرك يغلق الفكين المعدنيين)",
 "みはいとう": "غَيْرُ مُقَسَّم, مُوَحَّد (غير مُجزَّأ إلى أقسام أو حصص؛ يشكّل وحدة غير مقسّمة) / حَصْرِيّ, مُوَحَّد (غَيْرُ مُقَسَّمٍ بَيْنَ أَكْثَرَ مِنْ هَدَفٍ أَوْ غَرَضٍ وَاحِدٍ) / غَيْر مُقَسَّم, غَيْر مُوَزَّع (غير مشترك مع الآخرين أو موزَّع بينهم) / غَيْرُ مُنْقَسِم (لم يُفرِّقه خلاف في الرأي)",
 "みはからう": "تثمين, تقدير (حكم على صفات شيء أو شخص ما) / تخمين, تقدير (حساب تقريبي للكمية أو الدرجة أو القيمة) / تقدير (الاحترام الذي يحظى به شخص ما) / تثمين, تقدير (وثيقة تقدر قيمة شيء ما (مثل التأمين أو الضرائب))\nمثال: في تقديري الصبي بريء",
 "みはしらもん": "خَوْخَة",
 "みはた": "عَلَم, رَايَة (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "みはっけん": "غَيْر مُكْتَشَف (لم يُكتشَف بعد) / غَيْر مُكْتَشَف (لم يُكتَشَف بعد)",
 "みはっこう": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "みはったつ": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "みはっぴょう": "غَيْر مَنْشُور (غير منشور)\nمثال: رسائل ومذكرات غير منشورة",
 "みはつ": "غَيْر مُكْتَشَف (لم يُكتشَف بعد) / غَيْر مُكْتَشَف (لم يُكتَشَف بعد)",
 "みはつばい": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "みはてぬ": "غير مكتمل, غير منتهٍ (لم يتم الانتهاء منه أو اختتامه) / غير تام الصنع, غير جاهز (لم يتم إيصاله للحالة النهائية المطلوبة) / خَامّ, غَيْرُ مَطْلِيّ (يَفْتَقِرُ إِلَى تَشْطِيبٍ سَطْحِيٍّ كَالطِّلَاء)\nمثال: أعمال غير منتهية",
 "みはなす": "اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر) / تَرَكَ, يترك (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد تطلق على الأَتْرَاك من باب إطلاق اسم الكل على البعض)\nمثال: انصرف من ملكيتنا!",
 "みはらい": "بلا أجر, غير مدفوع (لم يتم الدفع له) / تَرْفِيهِيّ, هَاوٍ (يُمارَس كهواية أو تسلية) / تَطَوُّعِيّ, غَيْرُ مَأْجُور (بِدُونِ مُقَابِلٍ مَادِّيّ)\nمثال: أجور غير مدفوعة",
 "みはらいきん": "متأخرات (دين غير مدفوع تجاوز موعد استحقاقه) / متأخرات (حالة التأخر في الدفع)\nمثال: حساب عليه متأخرات",
 "みはらし": "مَنْظَر, مَشْهَد / صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "みはらしだい": "برج مراقبة, مرصد (هيكل يطل على مشهد واسع لمحيطه)",
 "みはらす": "صَفَحَ (الصَّفْحُ : العفو؛ صَفْحُ الإِنْسَانِ : جَنْبُهُ)\nمثال: كل صفحة مغامرة.",
 "みはり": "سَاعَة (ثُلْث ثُمْن اليَوْم بمعنى مجموع النَهَار واللَيْل، أي جزء من أربعة وعشرين جزءا من مجموع النهار والليل وتتكون من ستين دَقِيقَة؛ الوَقْت الحاضر، الآن) / حَارِس / رَصَدَ (الرَّصْد : المُراقبة؛ الرَّصد الجوّي: دراسة الأَحوال الجوّيَّة لمعرفة تقلُّبات الطقس) / حَذِرَ (حذِر الشّخصُ: تيقّظ واستعدّ وتأهّب وتنبّه؛ حذِر الأمرَ: كَتَمَه وأخفاه) / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: درست لمدة ساعة.",
 "みはりしょ": "نَاطُور",
 "みはりだい": "مَرْقَب, بُرْج الْمُرَاقَبَة",
 "みはりばん": "حَارِس / حَرَسَ (حَفِظَ الشيء أو الشخص أو مكاناً من المخاطر أو الأضرار؛ راقب شيئاً أو شخصاً بعناية لضمان الأمان)\nمثال: كان لدى سامي حرس شخصي.",
 "みはりやく": "واجب الحراسة (واجب الخدمة كحارس)\nمثال: كان في واجب الحراسة تلك الليلة",
 "みはる": "حا َسـِب",
 "みば": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "みばえ": "ذبابة الفاكهة (أي من الحشرات الصغيرة المتعددة التي تتغذى يرقاتها على الفواكه)",
 "みばしょう": "مَوْزَة / مَوْز (نبات فاكهة استوائية من الفصيلة الموزية؛ ثمر نبات الموز) / موزة / موز (نبات فاكهة استوائية من الفصيلة الموزية؛ ثمر نبات الموز)\nمثال: هن بحاجة للموز.",
 "みばらい": "بلا أجر, غير مدفوع (لم يتم الدفع له) / تَرْفِيهِيّ, هَاوٍ (يُمارَس كهواية أو تسلية) / تَطَوُّعِيّ, غَيْرُ مَأْجُور (بِدُونِ مُقَابِلٍ مَادِّيّ)\nمثال: أجور غير مدفوعة",
 "みひらき": "نَشَرَ (بَسَطَ، فَرَّقَ، نَشَرَ الشيءَ: جعله منتشراً، مثل نشر الأخبار أو نشر كتاب؛ نَشَرَ: وزع أو عمم شيئًا بين الناس، مثل نشر المقالات) / اِنْتِشَار (مصدر الفعل \"انْتَشَرَ\"؛ (في الفيزياء) عملية توزيع جزيئات أو ذرات أو حبيبات بشكل متساوٍ في فراغ أو في حيز متاح أو تخللها خلال حاجز غشائي)\nمثال: نشر توم الغسيل.",
 "みびいき": "تمييز, محاباة (المعاملة غير العادلة لشخص أو مجموعة على أساس التحيز) / محاباة, محسوبية (الميل لتفضيل شخص أو مجموعة على حساب الآخرين)",
 "みびょう": "اعتلال الصحة, توعك (حالة تعجز فيها عن العمل بشكل طبيعي وبدون ألم) / قبل الأعراض, ما قبل السريري (مكون من أو متعلق بالمراحل المبكرة من المرض عندما لا يكون التشخيص الدقيق ممكناً لأن أعراض المرض لم تظهر بعد)",
 "みふたつになる": "وَلَدَ (الرجلُ و المرأةُ ومثلهما الانسان: أنجب؛ الرجلُ و المرأةُ وَلَدًا: أنجبه) / أَنْجَبَ\nمثال: أعرف ذلك الولد.",
 "みぶり": "لَفْتَة, إِشَارَة",
 "みぶりげんご": "لُغَةُ الْجَسَدِ (هِيَ مجموعة من الأصوات التي يصدرها الإنسان على شكل كلمات منظمة بقواعد، ليتواصل به الناس وينقلون به الافكار والمعاني، اللسان؛ يقصد بها أحيانا اللهجة)\nمثال: الأمازيغية لغة.",
 "みぶりてぶり": "لَفْتَة, إِشَارَة",
 "みぶるい": "مُرْتَجِف, مُرْتَعِش (يهتز بشكل طفيف وغير منتظم كما من الخوف أو البرد) / رجفة, قشعريرة (إحساس بالبرد غالباً ما يشير إلى بداية عدوى وتطور حمى)",
 "みぶん": "مَنْزِلَة, مَكَانَة / مُطَابَقَة / هُوِيَّة",
 "みぶんか": "غير متمايز, متجانس (غير متمايز)",
 "みぶんがら": "تَرْتِيب, دَرَجَة (تنظيم الأشياء أو الأحداث في تسلسل معين أو وضعها في نظام؛ إعداد أو تجهيز شيء لتحقيق غاية معينة) / حَال, حَالَة (تحول أو تغيّر من حالٍ إلى حالٍ؛ اعترض أو فصل بين شيئين)\nمثال: أعاد زيري ترتيب المطبخ كلية.",
 "みぶんしょう": "هُوَ",
 "みぶんしょうめい": "بِطَاقَة هُوِيَّة",
 "みぶんしょうめいしょ": "هُوَ",
 "みぶんじこう": "وَثَائِق",
 "みぶんのたかい": "مُهِمّ",
 "みへんにゅう": "غَيْر مُسَجَّل كَشَرِكَة (غير منظم أو مُدار ككيان قانوني مؤسسي)",
 "みほそう": "ترابي, غير معبد (ليس له سطح معبد)",
 "みほとけ": "بُوذَا, بُدّ",
 "みほん": "عَيِّنَة / عَيِّنَةٌ, عَيِّناتٌ / نَمُوذَج / نَمُوذَج مُصَغَّر / قَدْوَة (من يُقتدى به)",
 "みぼうじん": "أَرْمَلَة",
 "みまい": "زَارَ (قَصَدَ شخصًا للأنس أو للحاجة) / زِيَارَة\nمثال: زار سامي مسجدا. / هَدِيَّة, هدية / قَرِيحَة / أَهْدَى",
 "みまいきゃく": "سائل, مستفسر (شخص يطرح سؤالاً)",
 "みまいじょう": "بطاقة تمنيات بالشفاء (بطاقة تعبر عن تمنيات بالشفاء)",
 "みまう": "حَمْلَة / هَاجَمَ",
 "みまえ": "حُضُور (حُضُور)\nمثال: الحضور هام جدا. / راكِب الطَّلِيعَة, مُرافِق مُتَقَدِّم (مرافق يركب (عادة دراجة أو حصاناً) في مقدمة الموكب)",
 "みまかる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات أو الحيوان أو الإنسان. مصدره مَوَات) / تُوُفِّيَ / زَهْر اَلطَّاوِلَة, زَهْر اَلنَّرْد ((زَهَرَ) الوجهُ والسراجُ والقمرُ يَزْهُرُ زَهْرًا، وزُهُوراً: تلألأ وأشْرق؛ (زَهَرَ) الشيءُ: صَفا لونُه)\nمثال: إعتقدت أنه مات.",
 "みまがう": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "みまごう": "أَسَاء اَلْفَهْم, أَخْطَأَ / خَطَأ, غَلْطَة (تعني ضدّ الصواب. يشمل ذلك الفعل، القول، والرأي. يُستخدم الفعل \"أخطأ\" للدلالة على عدم الإصابة…؛ قام بعمل بعيد عن الصواب أو مخالف للحق سواء كان ذلك في السلوك أو القول أو الكتابة)\nمثال: كان خطأ حاسوبي.",
 "みまし": "مَن, اَلْمَرْء (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / ـكُم, ـكُنَّ\nمثال: يا لها من جملة!",
 "みまもる": "حَدَّقَ (حَدَقَ فلَان الشَّيْءَ بعَيْنِه يَحْدِقُه حَدْقاً: إِذا نَظَرَ إلَيهِ، وحدَقَ فُلاناً: إِذا أَصَابَ حَدَقَتَه؛ حدَق به:أَحَاطَ به من كلّ جهة (حدَقت قوات الأمن بالقرية))\nمثال: حدق الجميع في وجهي.",
 "みまわす": "تَلَفَّتَ",
 "みまわり": "حَارِس",
 "みまわる": "دَوْرِيَّة, خَفْر / دَوْرِيَّة",
 "みまわれる": "تَأَلَّمَ, عَانَى / عَانَى (قَاسَى وكابد؛ الشيءَ: ملابسته ومباشرته)\nمثال: لقد عانى جمال كثيرا.",
 "みまん": "أَصْغَر مِن, صُغْرَى مِن",
 "みみ": "أُذُن (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / أُذْن (أَذَن؛ أَذَنَ: ( فعل ) أَذَنَ أَذْناً) / سُنْبُلَة / حَرَثَ (حرث الأرض: شقها بالمحراث ليزرعها؛ حرث النار: حركها وأثارها)\nمثال: من أذن لتوم باستعارة سيارتي? / سَمِيع (سَميع: (اسم)؛ سميع: (اسم)) / سَمْع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى)) / جَلْسَة\nمثال: سمع سامي صريرا. / حافة (جانب حاد يتكون من تقاطع سطحين لجسم ما) / حافة, طرف (الحد الخارجي لجسم أو منطقة أو سطح؛ مكان أبعد ما يكون عن مركز الشيء) / أَفْضَلِيَّة نِسْبِيَّة, تَفَوُّق بَسِيط (ميزة تنافسية طفيفة) / حدة (سمة الإلحاح في نبرة الصوت)\nمثال: قام بتدوير حواف الصندوق",
 "みみあか": "صِمْلَاخ, شَمْع اَلْأُذْن",
 "みみあたらしい": "مُسْتَجِدّ / رِوَايَة",
 "みみあて": "غطاء للأذنين (زوج من أغطية الأذن (عادة ما تكون متصلة بطوق رأس) يتم ارتداؤها للحفاظ على دفء الأذنين في الطقس البارد)",
 "みみうどん": "أُذُنِيُّ الشَّكْلِ, أُذُنِيّ (ذو شكل يشبه الأذن)",
 "みみおおい": "غطاء الأذن (أحد لسانين متصلين بقبعة للحفاظ على دفء الأذنين)",
 "みみおち": "نَصْل (مصدر من الفعل نَصَلَ؛ حديدة السهم والرمح والسيف والسكين وغيرها من الأسلحة الحادّة الجارحة)\nمثال: لن نصل إلى أي مكان.",
 "みみかざり": "قُرْط, حَلَق",
 "みみかす": "صِمْلَاخ, شَمْع اَلْأُذْن",
 "みみがくもん": "بِالتَّنَاقُل, سَمَاعِيّ (مَسْمُوع عَنْ طَرِيق آخَرِين وَلَيْسَ مُبَاشَرَةً) / إشاعة, شائعة (قيل وقال (عادة مزيج من الحقيقة والأكاذيب) ينتقل عبر الكلام الشفهي)",
 "みみがね": "دودة الرمل (ديدان بحرية لها صف من الخياشيم المعنقدة على طول كل جانب من الظهر؛ تستخدم غالباً كطعم للصيد) / عروة, مقبض ناتئ (قطعة بارزة تستخدم لرفع أو دعم أو تدوير شيء ما) / شراع عارضة, شراع لوغ (شراع بأربعة أركان يُرفع من عارضة تكون مائلة بالنسبة للصارية)",
 "みみきり": "قص, قطع (عملية تقصير شيء ما بقطع أطرافه) / استئصال, بتر (عملية قطع شيء ما)\nمثال: أعطاه الحلاق قصة جيدة",
 "みみくそ": "صِمْلَاخ, شَمْع اَلْأُذْن",
 "みみこすり": "تزلّف, تودد (فعل كسب القبول أو المودة عن طريق التملق المقنع والدقيق) / تعريض, تلميح (توريط أو إشارة غير مباشرة (وغالباً ما تكون خبيثة))\nمثال: رفضت استخدام التزلف لكسب الحظوة",
 "みみざとい": "حَادُّ السَّمْعِ, مُرْهَفُ الأُذُنِ (ذو سمع حادّ ومُرهَف)",
 "みみざわり": "صُلْب (قوي وصلب الملمس، لا ينحني بسهولة؛ متماسك وثابت، غير قابل للتغيير أو الانكسار) / صَعْب / لَا يُدْحَضُ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: هذا التخت جدا صلب.",
 "みみしい": "صَمَم",
 "みみずくがに": "سرطان العنكبوت (أي من السرطانات العديدة ذات الأرجل الطويلة جداً والأجسام المثلثة الصغيرة)",
 "みみずとかげ": "سحلية دودية (سحلية من جنس أمفيسباينا؛ سحلية غير ضارة تشبه الدودة وعديمة الأطراف من المناطق الدافئة أو الاستوائية لها عيون وآذان مخفية وذيل قصير غير حاد)",
 "みみずばれ": "لوح جانبي (لوح سميك يشكل حافة على طول جانب سفينة خشبية) / أثر ضربة, انتبار (علامة بارزة على الجلد (تنتج عن ضربة سوط مثلاً)؛ سمة مميزة للعديد من ردود الفعل التحسسية)",
 "みみず腫れ": "لوح جانبي (لوح سميك يشكل حافة على طول جانب سفينة خشبية) / أثر ضربة, انتبار (علامة بارزة على الجلد (تنتج عن ضربة سوط مثلاً)؛ سمة مميزة للعديد من ردود الفعل التحسسية)",
 "みみせん": "سدادة أذن (سدادة من القطن أو الشمع أو المطاط يتم تركيبها في قناة الأذن للحماية من دخول الماء أو الضوضاء العالية) / سدادة أذن (سماعة) (سماعة أذن يتم إدخالها في قناة الأذن)",
 "みみそろえて": "بغتة, فجأة (بشكل مفاجئ) / في آن واحد, معاً (الجميع في نفس الوقت)\nمثال: فجأة، بدأ بالصراخ",
 "みみたぶ": "شحمة الأذن (الجزء اللحمي المتدلي من الأذن الخارجية للإنسان)",
 "みみだれ": "عَلَامَة اِسْتِفْهَام, ؟ (سِمَةٌ أو أمارة أو شِعَار تُعرف به الأشياء؛ رَمْز)\nمثال: تحصلت على علامة أ.",
 "みみっちい": "قَابِض اليَد, مُمْسِك (غير راغب في التخلي عن المال)",
 "みみつき": "خَشِن الحَوَافّ (ذو حافة خشنة غير مستوية؛ يوصف به الورق اليدوي أو ما يشبهه) / ذو أذنين, مؤذن (له أذنان (أو زوائد تشبه الأذنين) أو له أذنان من نوع معين؛ غالباً ما يستخدم في التركيبات اللفظية) / رَثّ, مُثَنَّى الزَّوَايَا (بَالٍ أَوْ رَثٌّ مِنْ كَثْرَةِ الاسْتِعْمَالِ أَوْ (لِلصَّفَحَاتِ) مَطْوِيُّ الزَّوَايَا)",
 "みみづか": "تل مدفني, رابية الدفن ((في علم الآثار) كومة من التراب توضع فوق مقابر ما قبل التاريخ)",
 "みみづく": "بومة قرناء (بوم كبير له خصلات أذن بارزة)",
 "みみどおい": "غَيْر مَأْلُوف (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "みみどしま": "آنسة, شابة (أنثى شابة)\nمثال: شابة في الثامنة عشرة من عمرها",
 "みみなじみ": "تبسط غير لائق, تطاول (فعل ينطوي على حميمية غير لائقة) / ألفة, حميمية (صداقة وثيقة أو دافئة) / أُلْفَة, دِرَايَة (الاعتيادية بحكم كون الشيء مألوفاً أو معروفاً جيداً) / تلقائية, عفوية (أسلوب عفوي)\nمثال: خلق غياب الأسوار حميمية غامضة لم يعرف فيها أحد الخصوصية",
 "みみなり": "طَنِين",
 "みみにする": "سَمِع (أَدْرَكَ الصوت بأذنه؛ أَصْغَى، أَنْصَتَ. (يتعدى باللام وإلى))\nمثال: سمع سامي صريرا.",
 "みみのはやい": "حَادُّ السَّمْعِ, مُرْهَفُ الأُذُنِ (ذو سمع حادّ ومُرهَف)",
 "みみのふじゆう": "صَمَم",
 "みみぶくろ": "غطاء للأذنين (زوج من أغطية الأذن (عادة ما تكون متصلة بطوق رأس) يتم ارتداؤها للحفاظ على دفء الأذنين في الطقس البارد)",
 "みみょう": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة. / رَفِيع, سَامٍ (مَرْفُوعُ الشَّأْنِ؛ فِي حَالَةِ سُمُوٍّ رُوحِيّ) / جَلِيل, سَامٍ (يبعث على الرهبة والإجلال؛ عُلْوِيّ) / أَسْمَى, سَامٍ (في أعلى درجة أو أقصاها؛ بالغ الشدة) / رَفِيع, سَامٍ (ذو قيمة أخلاقية أو فكرية عالية؛ سامٍ في طبيعته أو أسلوبه)",
 "みみより": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة) / تَرْحِيب / رَحَّبَ, اِسْتَقْبِل (بنو رَحَب: اسم؛ بطن من همذان)\nمثال: أهلا يا أصدقاء.",
 "みみわ": "قُرْط, حَلَق",
 "みみをそろえて": "بالكامل (في إشارة إلى كمية)\nمثال: دُفع المبلغ بالكامل",
 "みみピ": "قُرْط, حَلَق",
 "みみピアス": "قُرْط, حَلَق",
 "みむく": "تَلَفَّتَ",
 "みむね": "إرادة إلهية, مشيئة الله (القدرة المطلقة لكائن إلهي)",
 "みめ": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "みめうるわしい": "حَسَنُ الْمَظْهَرِ, وَسِيم (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "みめかたち": "ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب.",
 "みめよい": "حَسَنُ الْمَظْهَرِ, وَسِيم (جَمِيل؛ مُبْهِج)\nمثال: إيمي فتاة حسنة.",
 "みもこころも": "قلباً وقالباً (بإيمان كامل)\nمثال: كانت معه قلباً وقالباً",
 "みもしらぬ": "غَيْر مَأْلُوف (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "みもだえ": "مُتَعَرِّج, مُتَلَوٍّ (يتحرك بطريقة ملتوية كحركة الأفعى أو الدودة)",
 "みもち": "تصرف, سلوك (طريقة التصرف أو التحكم بالنفس) / تصرف, سلوك ((السمات السلوكية) الطريقة التي يتصرف بها الشخص تجاه الآخرين)",
 "みもと": "مُطَابَقَة / هُوِيَّة / شَخْصِيَّة / خُلْق (أَنْشَأَ، أَوْجَدَ) / حَرْف, رَمْز (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو معنى) / مِحْرَف\nمثال: زيري سيء الخلق. / جَانِب / صَفْحَة",
 "みもとかくにん": "بِطَاقَة هُوِيَّة",
 "みもとしょうかいさき": "مَرْجِع",
 "みもとひきうけにん": "كَافِل",
 "みもとふめい": "غير قابل للتعرف عليه, مجهول الهوية (يستحيل التعرف عليه أو تحديده)",
 "みもとふめいしゃ": "فُلان, فُلان الْفُلانِيّ (كلمة تستخدم لوصف شخص ما بدون ذكر من هو، غالبًا يقصد به \"أي شخص من الناس\"، أو شخص لا يريد المتحدث ذكره)\nمثال: سمعنا ذلك من فلان و فلان.",
 "みもとほしょうにん": "كَافِل",
 "みもない": "فَارِغ / فَرَغَ",
 "みもの": "مَشْهَد / مَنْظَر",
 "みもふたもない": "كَلِيل",
 "みもよもあらぬ": "مُحْزِن, مُفْجِع (يسبب أو يتسم بالحزن الشديد أو الكرب)",
 "みもよもない": "مُحْزِن, مُفْجِع (يسبب أو يتسم بالحزن الشديد أو الكرب)",
 "みもん": "غَيْر مَسْمُوع (ليس بالضرورة خافتاً لكنه لم يُسمع)",
 "みゃく": "نَبْض, نَبْضَة / وَرِيد, عِرْق / سِلْسِلَة / أَمَلَ, رَجَا ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل) / أَمَل, رَجَاء ((أَمَّلَه): أَمَلَهُ يُقَال: فلَان بَحر المؤمل)\nمثال: أشعر بخيبة أمل.",
 "みゃくうつ": "بَاوْنْد / رَطْل ((رَطَلَ) يَرْطُلُ رَطْلاً: عَدَا؛ (رَطَلَ) الشيءَ: رازَهُ بيدِهِ ليعرِفَ وزْنَهُ) / جُنَيْه",
 "みゃくかん": "وِعَاء (الوِعَاءُ : الظَّرْفُ يوعَى فيه الشيءُ، ما يُجْمَعُ فيه الشّيءُ ويُحْفظ؛ الوِعَاءُ : إناء منزليّ يُصنع من الخزف أو المعدن أو الزُّجاج كوعاء الطَّبخ الذي له يد وغطاء أو وعاء دائريّ لتقديم الطَّعام أو إناء حفظ القهوة والشَّاي)\nمثال: وعاء السکر فارغ.",
 "みゃくかんけい": "الجهاز الوعائي (الأوعية والأنسجة التي تحمل أو تدور السوائل مثل الدم أو الليمف أو النسغ عبر جسم الحيوان أو النبات)",
 "みゃくしるい": "عصبيات الأجنحة (حشرة لها أجزاء فم قارضة وأربعة أجنحة غشائية كبيرة بعروق تشبه الشبكة)",
 "みゃくしん": "تشخيص طبي (التعرف على المرض من أعراضه)",
 "みゃくせき": "غَثّ, شَوْب (الحيوان والإنسان: عجف وهزل، ضد سمن؛ غَثَّت الشاة، ق)",
 "みゃくどう": "نَبْض, نَبْضُ القَلْب",
 "みゃくなしびょう": "التهاب الشرايين تاكاياسو, مرض انعدام النبض (اضطراب يتميز بغياب النبض في كلا الذراعين وفي الشرايين السباتية)",
 "みゃくはく": "نَبْض, نَبْضَة",
 "みゃくはくすう": "مُعَدَّل النَّبْض, مُعَدَّل ضَرَبَات القَلْب (المعدل الذي ينبض به القلب؛ يقاس عادة للحصول على تقييم سريع لصحة الشخص)",
 "みゃくみゃく": "مُتَوَاصِل, مُتَّصِل",
 "みゃくらく": "اتِّسَاق, تَرَابُط (العلاقة المنطقية والمنظمة والمتسقة بين الأجزاء) / تلاحم, تماسك (حالة التماسك أو الالتصاق معاً) / وِعَاء دَمَوِيّ (الوِعَاءُ : الظَّرْفُ يوعَى فيه الشيءُ، ما يُجْمَعُ فيه الشّيءُ ويُحْفظ؛ الوِعَاءُ : إناء منزليّ يُصنع من الخزف أو المعدن أو الزُّجاج كوعاء الطَّبخ الذي له يد وغطاء أو وعاء دائريّ لتقديم الطَّعام أو إناء حفظ القهوة والشَّاي)\nمثال: وعاء السکر فارغ.",
 "みゃくらくそう": "ضَفِيرَة مَشِيمَوِيَّة",
 "みゃくらくまく": "مَشِيمِيَّة",
 "みゃくらくもうまくえん": "التهاب المشيمية والشبكية (التهاب طبقة المشيمية خلف الشبكية)",
 "みゃくり": "خَيْط, حَبْل ((خَيَّطَ) الشَّيْبُ في رأسِهِ تَخْييطًا: بَدَا، أو صارَ كالخُيُوطِ فَتَخَيَّطَ رأسُهُ بالشَّيْبِ؛ (خَيَّطَ) الثَّوْب: خاطه)\nمثال: حل الصرة تلقى خيط.",
 "みゃくをうつ": "خَفَقَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَ, نَبَضَ (الجذر يعبر عن الحركة والاضطراب الخفيف الذي ينشأ عن الرياح أو القلوب أو الرايات، ويستخدم لوصف الطبيعة والأحاسيس والجوانب الحسية المختلفة؛ عبّر عن حركة سريعة، سواء كانت اضطراباً أو ضرباً خفيفاً أو صوتاً، بالإضافة إلى صفةٍ تُوصف بها الخيل) / خَفَقَان",
 "みゃっかん": "وِعَاء (الوِعَاءُ : الظَّرْفُ يوعَى فيه الشيءُ، ما يُجْمَعُ فيه الشّيءُ ويُحْفظ؛ الوِعَاءُ : إناء منزليّ يُصنع من الخزف أو المعدن أو الزُّجاج كوعاء الطَّبخ الذي له يد وغطاء أو وعاء دائريّ لتقديم الطَّعام أو إناء حفظ القهوة والشَّاي)\nمثال: وعاء السکر فارغ.",
 "みゃっかんえん": "التهاب الأوعية الدموية (التهاب وعاء دموي)",
 "みゃっかんがく": "علم الأوعية الدموية (فرع العلوم الطبية الذي يدرس الأوعية الدموية والليمفاوية واضطراباتها)",
 "みゃー": "مُوَاء (صَوْت القِطّ) / مَاءَ, تَمَوَّأَ (السائل الشفاف المعروف الذي تنشأ به الحياة، عديم اللون والرائحة والطعم عندما يكون نقيا؛ علميا فِي : جزيئة متكونة من ذرتي هيدروجين مرتبطين بذرة واحدة من الأوكسيجين)\nمثال: أنا أشرب الماء.",
 "みや": "ضَرِيح / قَصْر, بَلَاط (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب. / مَعْبَد / هَيْكَل / صَدْغ / ذِرَاع",
 "みやい": "ضَرِيح / أَقَامَ, سَكَنَ (فعل تعدي من قَامَ بمعنى جَعَلَه يقوم؛ ضد أجْلَسَ؛ الشيءَ: جعله يقوم أو جعله قائما مع معنى الثبات)\nمثال: أقام سامي مع بعض الأصدقاء.",
 "みやぎ": "مْيَاغِي",
 "みやげひん": "تَذْكار",
 "みやげもの": "تَذْكار",
 "みやげものや": "متجر هدايا (متجر يبيع سلعاً متنوعة مناسبة كهدايا)",
 "みやげもの屋": "متجر هدايا (متجر يبيع سلعاً متنوعة مناسبة كهدايا)",
 "みやげ品": "تَذْكار",
 "みやげ物屋": "متجر هدايا (متجر يبيع سلعاً متنوعة مناسبة كهدايا)",
 "みやこ": "رَأْسْمَال, رَأْس مَال / تَاج العَمُود",
 "みやこじょうふ": "تفوق, جودة عالية (جودة كون الشيء متفوقاً)",
 "みやこそだち": "حَضَرِيُّ الطِّبَاع, مُتَمَدِّن (ذو عادات أو سلوكيّات أو مظهر أهل المدينة)",
 "みやこどり": "نورس اسود الرأس",
 "みやこびと": "حَضَر (حضر: الحُضورُ: نَقِيضُ المَغيب والغَيْبةِ؛ حَضَرَ يَحْضُرُ حُضُورًا وحِضَارَةً؛ ويُعَدَّى فَيُقَالُ: حَضَرَه وحَضِرَه؛ حَضَرَ، كنَصَرَ وعلِمَ، حُضُورًا وحضارَةً: ضِدُّ غابَ)\nمثال: حضر كل شيئ لرحلتي.",
 "みやこふう": "مُطْرَان, مِطْرَان",
 "みやさま": "أَمِير",
 "みやざき": "مِيَازَاكِي",
 "みやすい": "جَذَّاب",
 "みやび": "تَكْرِير",
 "みやびた": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "みやびと": "رجل حاشية (مرافق في بلاط الحاكم)",
 "みやびやか": "ظَرِيف, أَنِيق (الذي فيه ظُرْف، أي فيه كياسة وحسن العبارة)\nمثال: هذه الفتاة ظريفة.",
 "みやぶる": "اِكْتَشَفَ",
 "みやま": "جَبَل (كلمة \"جبل\" لها معانٍ متعددة؛ طبع أو خلق شيئًا أو شخصًا على طبيعة أو سلوك معين) / طُور\nمثال: منزلي في الجبل.",
 "みやまあきのきりんそう": "قَسْطَرَان",
 "みやまおうま": "كيا (ببغاء نيوزيلندي كبير بني مخضر)",
 "みやまがらす": "غُدَاف / قَلْعَة, رُخّ (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "みやまきんばい": "زخرفة خماسية الفصوص (نحت زخرفي يتكون من خمسة أقواس مرتبة في دائرة) / حشيشة الخمس ورقات, عشبة القوى (أي من النباتات العديدة التي تزرع لزهورها خماسية البتلات؛ وفيرة في المناطق المعتدلة؛ ويزعم أن لها خصائص طبية)",
 "みやまきんぽうげ": "حوذان المروج, حوذان طويل (حوذان أوروبي معمر ذو أزهار ربيعية صفراء، متوطن بشكل واسع خاصة في شرق أمريكا الشمالية)",
 "みやまはなしのぶ": "سلم يعقوب, ناردين يوناني (نبات معمر أوروبي ذو أوراق ريشية له زهور زرقاء زاهية أو بيضاء)",
 "みやる": "نَظَرَ (اِسْتَعْمَلَ عينه ليَرَى الشيءَ، ليُدْرِكَه ويُبْصِرَه. (مَصْدَرُهُ نَظَر)؛ (يتعدى تعدية عامة بإلى))\nمثال: نظر إلى السماء.",
 "みゆ": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / جَاءَ (أَتَى؛ حَدَثَ) / أَتَى (جَاءَ؛ فَعَلَ الأمرَ) / جا / جه\nمثال: تقريبا الكل جاء",
 "みゆき": "ثَلْج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / تلج / ثلج (ثلَجتنا السماء: مطَرَتنا، ألقت علينا الثلج؛ ثلَجت نفسي: اشتَفَت به، واطمأنت إليه) / أَثْلَجَ (أثلج يومُنا: دخل في الثلج؛ أثلجت الأرض: أصابها الثلج)\nمثال: سامي يحب الثلج.",
 "みゆびなまけもの": "كسلان ثلاثي الأصابع (حيوان الكسلان الذي يمتلك ثلاثة مخالب طويلة في كل قدم أمامية وخلفية)",
 "みょう": "غَرِيب, عَجِيب / أَجْنَبِيّ, غَرِيب / عَجَب / تَسَاءَلَ (القوم: سَألوأ بعضهم بعضا؛ المرء: سَألَ نفسه مرة بعد مرة)\nمثال: قطة؟ تساءل الرجل العجوز. / براعة, ذكاء (خاصية كون الشخص بارعاً) / ذكاء, شطارة (الذكاء الذي يظهر في سرعة البديهة والفطنة) / إبداع, عبقرية (قوة الخيال الإبداعي)\nمثال: حبكة ذات براعة كبيرة / تعويذة, مانترا ((سنسكريتية) تعني حرفياً 'قول مقدس' في الفيدية؛ واحدة من مجموعة ترانيم شعرية منقولة شفهياً) / تعويذة متكررة, مانترا (كلمة أو عبارة مكررة بشكل شائع)\nمثال: كررت 'مسرورة جداً بسير الأمور' على فترات مثل المانترا / إتْيَان, أَتْي",
 "みょうが": "بروفيدنس / مُبَارَك",
 "みょうごにち": "بَعْدَ غَدٍ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر) / مثال: و بعد قليل أتى.",
 "みょうしゅ": "خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه) / مُتَخَصِّص, مُتَخَصِّصَة\nمثال: درب على يد خبير.",
 "みょうじ": "لَقَب (اسم يُسمى به الإنسان غير اسمه الأول، للتعريف، أو التشريف، أو التحقير، والآخر منهي عنه؛ اسم العائلة) / كُنْيَة / اِسْم الْعَائِلَة (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر)\nمثال: في حقيقة الأمر، كان زيري يعرف لقب ريمة.",
 "みょうじゅ": "تعويذة, مانترا ((سنسكريتية) تعني حرفياً 'قول مقدس' في الفيدية؛ واحدة من مجموعة ترانيم شعرية منقولة شفهياً) / تعويذة متكررة, مانترا (كلمة أو عبارة مكررة بشكل شائع)\nمثال: كررت 'مسرورة جداً بسير الأمور' على فترات مثل المانترا",
 "みょうじょ": "بروفيدنس",
 "みょうじょう": "نَجْمَة الصَّبَاح / إِجَّامَة / نَجْمَة",
 "みょうせき": "اسم العائلة, لقب (الاسم المستخدم لتعريف أفراد الأسرة (لتمييزه عن الاسم الأول لكل فرد))",
 "みょうたい": "زِرّ",
 "みょうだい": "إِنَابَة, اِسْتِنَابَة (عند السالكين: الرجوع عن الغَفْلَة إلى الذِّكْر)",
 "みょうちきりん": "عَجِيب, غَرِيب",
 "みょうちくりん": "عَجِيب, غَرِيب",
 "みょうてい": "زِرّ",
 "みょうと": "رجل وزوجته, زواج (شخصان متزوجان من بعضهما البعض)\nمثال: كان زواجه الثاني أكثر سعادة من الأول / زَوْج (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "みょうとづれ": "زَوْجَانِ",
 "みょうにち": "غَدًا, الْغَد (اليومُ الذي يأْتي بعدَ اليوم الحالي، اليوم التالي؛ قد يراد به القريب من الزمان) / غَد, بُكرة (اليوم الذي يأتي بعد اليوم الذي أنت فيه؛ أي يوم يأتي في المستقبل، قرب أو بعد، على ال)\nمثال: لربما تمطر غدا.",
 "みょうねん": "السَّنَة الْقادِمَة",
 "みょうばつ": "عِقَاب, اِنْتِقَام (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "みょうばん": "شَبّ",
 "みょうほう": "سِرّ (شَعَرَ بِالسُّرُورِ) / غُمُوض\nمثال: السر سيبقى سرا.",
 "みょうみ": "إتقان, جمال فائق (جمال فائق من نوع دقيق) / أَفْضَلِيَّة, فَائِدَة",
 "みょうもく": "اِسْم, أَسْمَاء (هو اللَفْظ الذي يطلق على الشيء لتمييزه وتعريفه؛ في : هو ما دل على معنى في نفسه غير مقترن بأحد من الأزمنه الثلاثة؛ خلاف الفِعْل والحَرْف والضَمِيْر) / اِشْتِهَار / سَمَّى, سمى / اِخْتَارَ / عَيَّنَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / عَيَّنَ, نَصَبَ (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…)\nمثال: ما اسم حصان توم؟ / ذَرِيعَة, عُذْر",
 "みょうもん": "سُمْعَة, شُهْرَة",
 "みょうやく": "إِكْسِير",
 "みょうり": "بروفيدنس",
 "みょうれい": "صَغِير, حَدَث",
 "みよ": "حُكْم, حُكُومَة (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حُكْم (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ) / حَكَمَ (الذي يحكم بين اثنين أو أكثر، مثل القاضي إذا كان نِزاعا بين طرفين لا حدَّا يقام؛ في : هو رجل يراقب الفريقين في اللعب ويقرر من الذي فاز ومن الذي أخطأ؛ الخ)\nمثال: حكم علي بالموت.",
 "みよう": "وِجْهَة نَظَر, حَيْثِيَّة / وِجْهَة نَظَر",
 "みより": "نِسْبِيّ / قَرِيب, قَرِيبَة",
 "みら": "ثوم معمر صيني (أوراق مسطحة كبيرة تستخدم كما يستخدم الثوم المعمر) / ثوم معمر صيني, كراث صيني (نبات من شرق آسيا؛ أكبر من الثوم المعمر)",
 "みらい": "مُسْتَقْبَل / مُسْتَقْبَلِيّ, مُسْتَقْبَل / برعم ذوقي (عضو حسي بيضاوي نهائي على سطح اللسان)",
 "みらいえいごう": "إلى الأبد, دائماً وأبداً (في أي وقت في المستقبل؛ مستقبلاً وبشكل دائم)\nمثال: عش حياة خالية من اللوم إلى الأبد",
 "みらいかんりょう": "مستقبل تام (زمن تام يُستخدم لوصف حدث سيكتمل في المستقبل)",
 "みらいがく": "استشراف المستقبل, علم المستقبليات (دراسة أو التنبؤ بالتطورات المستقبلية بناءً على الظروف الحالية)",
 "みらいがくしゃ": "مستقبلي (من أو يتعلق بالمستقبلية (حركة فنية)) / متنبئ, مستقبلي (شخص يتنبأ بالمستقبل) / مستقبلي (لاهوتي يعتقد أن نبوءات الكتاب المقدس عن نهاية العالم ستتحقق في المستقبل)\nمثال: فن مستقبلي",
 "みらいがた": "مستقبلي (من أو يتعلق بالمستقبلية (حركة فنية))\nمثال: فن مستقبلي",
 "みらいけい": "مُسْتَقْبَل",
 "みらいしんこうけい": "مستقبل مستمر (زمن مستمر يُستخدم للتعبير عن حدث سيكون مستمراً في المستقبل)",
 "みらいてき": "مستقبلي (من أو يتعلق بالمستقبلية (حركة فنية))\nمثال: فن مستقبلي",
 "みらいは": "مستقبلية (الموقف القائل بأن معنى الحياة يجب أن يُلتمس في المستقبل) / المستقبلية (حركة فنية في إيطاليا حوالي عام 1910 حاولت التعبير عن طاقة وقيم عصر الآلة)",
 "みらいようごう": "إلى الأبد, دائماً وأبداً (في أي وقت في المستقبل؛ مستقبلاً وبشكل دائم)\nمثال: عش حياة خالية من اللوم إلى الأبد",
 "みらいよち": "تنبؤ, معرفة مسبقة (معرفة حدث قبل وقوعه)",
 "みられたものじゃない": "مُذْهِل, مُفْزِع (يسبب الذعر والفزع) / أمر مروع, فاجعة (تجربة تثير الفزع أو الروعة)\nمثال: هل من الأفضل رؤية الأمر المروع أم مجرد السماع عنه؟",
 "みられたものではない": "مُذْهِل, مُفْزِع (يسبب الذعر والفزع) / أمر مروع, فاجعة (تجربة تثير الفزع أو الروعة)\nمثال: هل من الأفضل رؤية الأمر المروع أم مجرد السماع عنه؟",
 "みられる": "رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا.",
 "みりょう": "غير مكتمل, غير منتهٍ (لم يتم الانتهاء منه أو اختتامه) / غير تام الصنع, غير جاهز (لم يتم إيصاله للحالة النهائية المطلوبة) / خَامّ, غَيْرُ مَطْلِيّ (يَفْتَقِرُ إِلَى تَشْطِيبٍ سَطْحِيٍّ كَالطِّلَاء)\nمثال: أعمال غير منتهية / تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "みりょく": "تميمة الحظ, جالب للحظ (شيء يُعتقد أنه يجلب الحظ السعيد) / جاذبية, سحر (الجاذبية التي تثير الاهتمام أو تسعد أو تحفز) / كوارك ساحر, نكهة السحر ((فيزياء) إحدى نكهات الكوارك الست، وهو الثالث من حيث الكتلة بين جميع الكواركات) / تعويذة, رقى (صيغة لفظية يُعتقد أن لها قوة سحرية)\nمثال: كانت ابتسامته جزءاً من جاذبيته لها",
 "みりょくてき": "سِحْرِيّ, شَعْوَذِيّ (يمتلك أو يستخدم قوى خارقة للطبيعة أو يتسم بها) / سَاحِر, فَاتِن (يُسعد أو يَسحر من حوله)",
 "みる": "اِهْتَمَّ, اِعْتَنَى / رَأَى (أدرك أو لاحظ شيئًا أو شخصًا بالعينين؛ اعْتَقَدَ، تَأَمَّلَ) / عَايَنَ / شاف\nمثال: رأى ياني منزلا. / فَحَصَ, اِمْتَحَنَ (مصدر للفعل فَحَصَ بمعنى حفر الأرض أو كشف الشيء أو الاستقصاء عن الشيء؛ في : استقصاء ما بالمريض من علة أو مرض)\nمثال: فحص الطبيب بطني. / اِهْتَمَّ, اِعْتَنَى / خِبْرَة, تَجْرِبَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك) / اِخْتِبَار (اختبر الشّيء:خبره) / خِبْرَة (مصدر للفعل خَبَرَ؛ القاعُ يُنبت السِّدْر والأراك)\nمثال: زيري عنده خبرة.",
 "みるい": "صَغِير, حَدَث",
 "みるかげもない": "لَا يُمْكِن التَّعَرُّف عَلَيْه (يستعصي على التعرّف، كأن يكون بسبب تلف أو تغيير)",
 "みるから": "بُوضُوح",
 "みるときくとはおおちがい": "هُنَاكَ, يُوجَدُ",
 "みるべき": "شيء لا يُفَوَّت, ما يجب رؤيته (شيء يُعَد الاطلاع عليه أو رؤيته أمراً ضرورياً)",
 "みるみる": "بسرعة فائقة, في لمح البصر (في وقت قصير نسبياً)\nمثال: أنهت المهمة في لمح البصر",
 "みるめ": "عَيْن, عين (المُعَايَنَة والمشاهدة؛ العين : حاسة البصر والرؤية - مؤنث - تكون للإنسان وغيره من الحيوان . قال ابن السكيت : العين التي يبصر بها الناظر…) / سُمّ, خُرْبَة (في : حرف جواب بمعنى مُرْ يأتي بعد النداء فقط)\nمثال: كان عين ليلى مسودة. / أضواء الشهرة, محط الأنظار (بؤرة اهتمام الجمهور)\nمثال: استمتع بكونه تحت الأضواء / ظُهُور (عِيْدُ الظُّهُوْر: عيد للنَصَارَى يُسَمَّى أيضا عيد التَجَلِّي) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / مَظْهَر, شَكْل (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / شَكْل ((شَكَلَ) الأمْرُ يَشْكُلُ شُكُولاً: الْتَبَسَ؛ (شَكَلَ) المريضُ: تماثَلَ)\nمثال: لا أحد لاحظ ظهور الدب. / وِجْهَة نَظَر, حَيْثِيَّة / وِجْهَة نَظَر",
 "みるも": "بوضوح, جلياً (بشكل لا لبس فيه)\nمثال: الإجابة خاطئة بوضوح",
 "みるもむざん": "بَائِس",
 "みれん": "نَدِمَ / تَأَسَّفَ (تأسُّف) / أَسَف (مصدر أسِفَ على / أسِفَ لـ / أسِفَ من؛ أَسَفِي شَدِيدٌ على ما بَدَرَ مِنِّي : نَدَمِي) / تَأَسُّف (تأسُّف)\nمثال: للأسف ذلك صحيح.",
 "みれんがましい": "آسف, نادم (الشعور بـأو التعبير عن الأسف أو الحزن أو الشعور بالخسارة لشيء تم فعله أو تركه)\nمثال: شعر بالندم على شبابه الضائع",
 "みれんたらしい": "آسف, نادم (الشعور بـأو التعبير عن الأسف أو الحزن أو الشعور بالخسارة لشيء تم فعله أو تركه)\nمثال: شعر بالندم على شبابه الضائع",
 "みれんたらたら": "آسف, نادم (الشعور بـأو التعبير عن الأسف أو الحزن أو الشعور بالخسارة لشيء تم فعله أو تركه)\nمثال: شعر بالندم على شبابه الضائع",
 "みれんみしゃくがない": "بارد المشاعر, قاسي القلب (يفتقر إلى التعاطف أو الشعور)",
 "みわく": "انْبِهَار, سِحْر (القدرة على جذب اهتمام شديد) / افتتان, انبهار (شعور بإعجاب كبير بشيء رائع وغير عادي) / افتتان, انبهار (حالة الاهتمام الشديد بشيء ما (كما في الرهبة أو الإعجاب أو الرعب))\nمثال: سحر الأطفال بحيل سحرية وفتن أخرى",
 "みわくてき": "سِحْرِيّ, شَعْوَذِيّ (يمتلك أو يستخدم قوى خارقة للطبيعة أو يتسم بها) / سَاحِر, فَاتِن (يُسعد أو يَسحر من حوله)",
 "みわけ": "تَمْيِيْز",
 "みわけがつく": "تَعَرَّفَ",
 "みわける": "تَعَرَّفَ",
 "みわざ": "أعمال, أفعال (أداء الأعمال الأخلاقية أو الدينية) / مصنع, منشأة صناعية (مباني لممارسة العمل الصناعي) / آلية داخلية (الآلية الداخلية لجهاز ما) / الشلة كلها, العدة والعتاد (كل شيء متاح)\nمثال: الخلاص بالأعمال",
 "みわすれる": "نَسِيَ (لَمْ يَتَذَكَّرْ؛ غَابَ عَنْ الذِهْن)\nمثال: لقد نسي صديقتك.",
 "みわたし": "سهر عند الجثمان (وقفة صلاة تعقد فوق جثة في الليلة التي تسبق الدفن) / عرض, عرض سينمائي (عرض صورة متحركة (فيلم))",
 "みわたす": "اِسْتِبَانَة, اِسْتِطْلَاع",
 "みわたすかぎり": "على مَد البَصَر (يفيد الاستعلاء؛ يفيد التعليل)\nمثال: أجب على السؤال.",
 "みをあやまる": "غَلِطَ, أَخْطَأَ",
 "みをおこす": "قَامَ, نَهَضَ (اِنْتَصَبَ، نَهَضَ، وَقَفَ؛ ثَبَتَ، وَقَفَ، حَبَسَ)\nمثال: لقد قام بواجبه.",
 "みをおさめる": "حسب الطلب (حسب المواصفات)\nمثال: صنع الأحذية حسب الطلب",
 "みをおとす": "نَزَلَ (ضد صَعَدَ، اِنْحَدَرَ أو اِنْخَفَضَ؛ القوم: حَلُّوا في مكان ما)\nمثال: نزل علينا الخوف.",
 "みをおどらせる": "قَفَزَ (وَثَبَ أو طَفَرَ. الفرق بينهم أن الوَثْب يكون من وضع الرَكْض أو الحركة، والطفْرُ يكون من وضع السكون، بَينما ٱلقَفْز يكون من أي وضع كان) / قَفْزَة\nمثال: قفز من النافذة.",
 "みをかがめる": "انحناء (انحناء النصف العلوي من الجسم للأمام وللأسفل) / بسطة المدخل, عتبة (شرفة صغيرة أو مجموعة من الدرجات عند المدخل الأمامي للمنزل) / حوض الماء المقدس (حوض للماء المقدس)",
 "みをかたくする": "جَمَدَ (صَارَ صُلْبًا أو قَاسِيًا بَعْدَ السَّيُولَةِ؛ تَوَقَّفَ عَنِ الحَرَكَةِ أو النَّمُوِّ)",
 "みをかためる": "هَدَأَ / اِسْتَقَرَّ (فعل مطاوعة لأَقَرَّ بمعنى جعله يثبت ويسكن، أَقْرَرْتُهُ فاسْتَقَرَّ؛ ثبت وقرّ)\nمثال: استقر زيري في خيمته.",
 "みをかわす": "تفادي, مراوغة (حركة مراوغة سريعة) / حيلة, خديعة (مخطط مفصل أو خادع تم تدبيره للخداع أو التهرب) / تملص, مراوغة (بيان يتهرب من السؤال بذكاء أو حيلة)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "みをきるよう": "طَاعِن, لَاذِع (مؤلم كما لو كان ناتجاً عن أداة حادّة) / ثَاقِب, حَادّ (لَدَيْهِ القُدْرَةُ عَلَى التَّمْيِيزِ الدَّقِيقِ وَالإِدْرَاكِ العَمِيق)",
 "みをしずめる": "غَطَسَ / مَجْلَى, مَغْسَلَة",
 "みをつつしむ": "اِمْتَنَعَ (مَنَعَ نفسه؛ كان مَنِيْعًا يصعب الوصول إليه)",
 "みをつつむ": "لَبِسَ (خَلَطَ بحيث يصعب التمييز والفصل؛ الأمر: خلطه فاشتبه واضطرب) / اِرْتَدَى / اِهْتِراء\nمثال: لبس سروالا نظيفا.",
 "みをのりだす": "تَسَكَّعَ",
 "みをひく": "اِسْتَقَالَ",
 "みをひるがえす": "تفادي, مراوغة (حركة مراوغة سريعة) / حيلة, خديعة (مخطط مفصل أو خادع تم تدبيره للخداع أو التهرب) / تملص, مراوغة (بيان يتهرب من السؤال بذكاء أو حيلة)\nمثال: كانت شهادته مجرد حيلة لإبعادنا عن المسار",
 "みをもって": "شَخْصِيًّا / بِٱلْكَاد",
 "みをやく": "حَرْق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / سَفْعَة / حُرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / أَحْرَقَ (أحرقت النار الشيءَ: حرقته؛ أحرقَ الشيءَ: أهلكه) / حَرَقَ (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / ضَرِمَ / حرق (الفعل له عدة معانٍ تتعلق بالتأثير والتلف، منها: برد الحديد، حكّ الأنياب، إتلاف الثوب بالدق، وحرق الشيء بالنار؛ إتلاف شيء ما بالنار أو بأداة حادة، كما يشمل المعنى المجازي للألم الشديد والحزن الذي يُؤثر في القلب) / وَلَّع\nمثال: قامت ليلى بحرق كل كتب آرت المتعلقة بالأدب العنصري.",
 "みをよじる": "لَوَى, بَرَمَ",
 "みん": "سلالة مينغ, مينغ (السلالة الإمبراطورية للصين من 1368 إلى 1644) / مُوَاطِن, مُوَاطِنَة (مَدَنِيّ؛ مُقِيم) / سَاكِن, سَاكِنَة / مَدَنِيّ, مَدَنِيَّة\nمثال: أنا مواطن لبناني / مُسْتَعْمِل, مُسْتَخْدِم (غير جَدِيد، لم يصل البَلَى بعد إلا أنه في الطريق إلى ذلك؛ مُسْتَخْدَم، أحد ما يستخدمه الآن)\nمثال: اشتريت جوال مستعمل.",
 "みんえいか": "خَصْخَصَة, خَوْصَصَة",
 "みんおく": "مَجْلِس",
 "みんかん": "خَاصّ, شَخْصِيّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / خَاصّ (قلَّ أو أصبح أقل؛ خَاصَ العَطَاءَ خَاصَ خَوْصًا: قلَّله) / جُنْدِيّ (لقب عسكري يُطلق على من يلتحق بالجَيْش ويعمل فيه، مقاتل، محارب، عسكري؛ (في الشطرنج) اسم آخر للبيدق)\nمثال: كل الخضار الخاص بك. / شَعْبِيّ",
 "みんかんかいしゃ": "شركة مساهمة خاصة, شركة مغلقة (شركة مملوكة لعدد قليل من الأشخاص؛ ليس لأسهمها سوق عام)",
 "みんかんきぎょう": "اقتصاد السوق, مشروع حر (اقتصاد يعتمد بشكل رئيسي على قوى السوق لتخصيص السلع والموارد وتحديد الأسعار)",
 "みんかんごげん": "تأثيل شعبي (تأثيل شائع ولكنه خاطئ)",
 "みんかんじん": "مواطن عادي (مواطن لا يشغل أي منصب رسمي أو عام)",
 "みんかんせつわ": "حِكَايَة شَعْبِيَّة, فُولْكُلُور (حكاية تتداول شفهياً بين عامة الناس)",
 "みんかんだんたい": "مُنَظَّمَة غَيْر حُكُومِيَّة",
 "みんかんでんしょう": "فُولْكْلُور, فُولْكُلُور",
 "みんかんぼうえい": "دِفَاع مَدَنِيّ, حِمَايَة مَدَنِيَّة",
 "みんかんやく": "طب تقليدي (العِلْم؛ دراسة أسباب وتَشْخِيْص ومُعَاْلَجَة الأمراض)\nمثال: اختص في طب القلب.",
 "みんが": "فن شعبي (نوع فني مجهول الأصل يعكس القيم التقليدية للمجتمع)",
 "みんきょ": "مَجْلِس",
 "みんぎょう": "اقتصاد السوق, مشروع حر (اقتصاد يعتمد بشكل رئيسي على قوى السوق لتخصيص السلع والموارد وتحديد الأسعار)",
 "みんけん": "حق مدني (حق أو حقوق تخص الشخص بحكم المواطنة، بما في ذلك الحريات والامتيازات الأساسية التي يكفلها القانون (مثل التعديلات 13 و 14 في الدستور الأمريكي)، بما في…)",
 "みんけんしゅぎ": "دِيمُقْرَاطِيَّة (الدِّيْمُقْراطيَّة : شَكْلٌ مِنْ أَشْكالِ السُّلْطَةِ والحُكْمِ يَعودُ فيهِ القَرارُ إلى الشَّعْبِ…؛ المشاركة الجماعيَّة في الحكم عن طريق التمثيل وإِبداء الرأي والمعارضة وغيرها بصورة رسميَّة)\nمثال: عاشت الديمقراطية!",
 "みんげい": "فن شعبي (نوع فني مجهول الأصل يعكس القيم التقليدية للمجتمع)",
 "みんこう": "عامل مهاجر, متشرد (عامل يتنقل ويعمل مؤقتاً في أماكن مختلفة)",
 "みんこく": "جُمْهُورِيَّة الصِّين",
 "みんざい": "مُنَوِّم",
 "みんしゅ": "دِيمُقْرَاطِيَّة (الدِّيْمُقْراطيَّة : شَكْلٌ مِنْ أَشْكالِ السُّلْطَةِ والحُكْمِ يَعودُ فيهِ القَرارُ إلى الشَّعْبِ…؛ المشاركة الجماعيَّة في الحكم عن طريق التمثيل وإِبداء الرأي والمعارضة وغيرها بصورة رسميَّة)\nمثال: عاشت الديمقراطية! / الحزب الديمقراطي (الأقدم من بين الحزبين السياسيين الرئيسيين في الولايات المتحدة)",
 "みんしゅう": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "みんしゅうえき": "مَحَطَّة السِّكَك الْحَدِيدِيَّة, مَحَطَّة",
 "みんしゅうか": "ابتذال, تعميم (فعل جعل الشيء جذاباً للجمهور العام) / تبسيط, تعميم (تفسير يسهل فهمه وقبوله)",
 "みんしゅうせんどう": "ديماغوجية, غوغائية (نداءات حماسية تخاطب تحيزات وعواطف الجماهير)",
 "みんしゅうてき": "مَحْبُوب",
 "みんしゅうもじ": "شَعْبِيّ, دَارِج",
 "みんしゅか": "دَمَقْرَطَة",
 "みんしゅく": "مبيت وإفطار (نزل للمبيت مع تقديم الإفطار)",
 "みんしゅこっか": "دِيمُقْرَاطِيَّة (الدِّيْمُقْراطيَّة : شَكْلٌ مِنْ أَشْكالِ السُّلْطَةِ والحُكْمِ يَعودُ فيهِ القَرارُ إلى الشَّعْبِ…؛ المشاركة الجماعيَّة في الحكم عن طريق التمثيل وإِبداء الرأي والمعارضة وغيرها بصورة رسميَّة)\nمثال: عاشت الديمقراطية!",
 "みんしゅしゃかいしゅぎ": "اِشْتِرَاكِيَّة دِيمُقْرَاطِيَّة",
 "みんしゅしゅぎ": "دِيمُقْرَاطِيَّة (الدِّيْمُقْراطيَّة : شَكْلٌ مِنْ أَشْكالِ السُّلْطَةِ والحُكْمِ يَعودُ فيهِ القَرارُ إلى الشَّعْبِ…؛ المشاركة الجماعيَّة في الحكم عن طريق التمثيل وإِبداء الرأي والمعارضة وغيرها بصورة رسميَّة)\nمثال: عاشت الديمقراطية!",
 "みんしゅしゅぎこく": "دِيمُقْرَاطِيَّة (الدِّيْمُقْراطيَّة : شَكْلٌ مِنْ أَشْكالِ السُّلْطَةِ والحُكْمِ يَعودُ فيهِ القَرارُ إلى الشَّعْبِ…؛ المشاركة الجماعيَّة في الحكم عن طريق التمثيل وإِبداء الرأي والمعارضة وغيرها بصورة رسميَّة)\nمثال: عاشت الديمقراطية!",
 "みんしゅしゅぎしゃ": "دِيمُقْرَاطِيّ, دِيمُقْرَاطِيَّة",
 "みんしゅせい": "دِيمُقْرَاطِيَّة (الدِّيْمُقْراطيَّة : شَكْلٌ مِنْ أَشْكالِ السُّلْطَةِ والحُكْمِ يَعودُ فيهِ القَرارُ إلى الشَّعْبِ…؛ المشاركة الجماعيَّة في الحكم عن طريق التمثيل وإِبداء الرأي والمعارضة وغيرها بصورة رسميَّة)\nمثال: عاشت الديمقراطية!",
 "みんしゅてき": "دِيمُقْرَاطِيّ",
 "みんしゅとう": "الحزب الديمقراطي (الأقدم من بين الحزبين السياسيين الرئيسيين في الولايات المتحدة)",
 "みんしんとう": "الحزب الديمقراطي (الأقدم من بين الحزبين السياسيين الرئيسيين في الولايات المتحدة)",
 "みんじじょう": "مَدَنِيّ, أَهْلِيّ",
 "みんじそしょう": "دعوى مدنية (إجراء قانوني لحماية حق مدني خاص أو لفرض تعويض مدني (متميز عن الملاحقة الجنائية))",
 "みんじてき": "مَدَنِيّ, أَهْلِيّ",
 "みんじゅひん": "بضائع استهلاكية, سلع استهلاكية (بضائع (مثل الطعام أو الملابس) مخصصة للاستخدام أو الاستهلاك المباشر)",
 "みんじん": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "みんすうき": "سِفْر العَدَد (السَّفَرُ : قَطْعُ المسافة؛ هو مِنِّي سفَرٌ : بعيد)\nمثال: صاحبته في السفر.",
 "みんせいよう": "مُسْتَهْلِك / مُسْتَنْفِد",
 "みんそ": "دعوى مدنية (إجراء قانوني لحماية حق مدني خاص أو لفرض تعويض مدني (متميز عن الملاحقة الجنائية))",
 "みんぞく": "نَاس, خَلْق (اسم للجمع من بني آدم واحده إِنْسَان أو إِنْس) / خَلْق, شَعْب (أَنْشَأَ، أَوْجَدَ) / أَهْل (أَهِلَ به يَأْهَلُ أَهَلاً: أنِس، فهو أَهِلٌ) / شَعْب (ما فوق القَبِيلَة ودون الأُمَّة؛ وهو أول طبقات الأنساب إلا أن البعض يضع فوقه الجَذْم والجُمْهُور؛ الناس الذين يسكنون دولة ما وإن لم يكن يربط بينهم نسب. . والعامة قد تقول شَعَب)\nمثال: ضحك الناس عليه.",
 "みんぞくおんがく": "مُوسِيقَى فُلْكْلُورِيَّة (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف؛ علم الموسيقى : علمٌ يُبحَثُ فيه عن أُصَول النغم من حيث تأَتلف أَو تتنافر، وأَحوال الأَزمنة المتخللة بينها، ليُعلَمَ كيف يؤلَّف اللَّحْن)\nمثال: أتعلم الموسيقى. / فولك, موسيقى تراثية (الموسيقى التقليدية وعادة مجهولة المؤلف التي تعبر عن حياة الناس في مجتمع ما)",
 "みんぞくがく": "إِتْنُولُوجِيَة",
 "みんぞくがくしゃ": "إثنولوجي, عالم أعراق (عالم أنثروبولوجيا يدرس الإثنولوجيا (علم الأعراق))",
 "みんぞくきょうわこく": "الْجُمْهُورِيَّة الشَّعْبِيَّة",
 "みんぞくこっか": "دَوْلَة قَوْمِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من الناس مستقلين متحدين معا لتكوين مجتمع لحماية حقوقهم و وضع قوانينهم الخاصة)\nمثال: لبنان دولة صغيرة.",
 "みんぞくし": "عِلْم الإِنْسََان التَطْبِيقِيّ, إِثْنُوغْرَافِيَّا (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "みんぞくしがく": "عِلْم الإِنْسََان التَطْبِيقِيّ, إِثْنُوغْرَافِيَّا (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "みんぞくしほん": "عاصمة وطنية (العاصمة لبلد ما)",
 "みんぞくしゃかいしゅぎ": "نَازِيَّة",
 "みんぞくしゅうだん": "مَجْمُوعَة إثْنِيَّة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "みんぞくしゅぎ": "قَوْمِيَّة (ما يجمع أمة ذات تاريخ وأمانٍ مشتركة)\nمثال: اللغة اليابانية لغتي القومية.",
 "みんぞくしゅぎしゃ": "قَوْمِيّ, قَوْمِيَّة",
 "みんぞくじけつ": "تَقْرِيرُ المَصِير",
 "みんぞくじょう": "عِرْقِيّ",
 "みんぞくじょうか": "تَطْهِير عِرْقِيّ (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير.",
 "みんぞくてき": "عِرْقِيّ",
 "みんぞくとういつしゅぎ": "وَحْدَوِيّة",
 "みんぞくぶよう": "رَقْص شَعْبِيّ (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "みんだん": "حِكَايَة شَعْبِيَّة, فُولْكُلُور (حكاية تتداول شفهياً بين عامة الناس)",
 "みんちょう": "سلالة مينغ, مينغ (السلالة الإمبراطورية للصين من 1368 إلى 1644)",
 "みんちょうたい": "سلالة مينغ, مينغ (السلالة الإمبراطورية للصين من 1368 إلى 1644)",
 "みんど": "مُسْتَوَى اَلْمَعِيشَة",
 "みんな": "الْجَمِيع, كُلّ شَخْص / كُلّ شَيْء",
 "みんながみんな": "اَلْجَمِيع, كُلّ شَخْص",
 "みんなさん": "كُلّ, جَمِيع",
 "みんなみ": "جَنُوب (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب) / جنوب (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب) / جَنوب (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "みんぺい": "تَنْظِيم مُسَلَّح, جَمَاعَة مُسَلَّحَة",
 "みんぺいそしき": "تَنْظِيم مُسَلَّح, جَمَاعَة مُسَلَّحَة",
 "みんぽう": "قَانُون مَدَنِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "みんぽうてん": "قَانُون مَدَنِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "みんゆうか": "خَصْخَصَة, خَوْصَصَة",
 "みんよう": "أُغْنِيَّةٌ شَعْبِيَّة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة ذات لفظ مجانس متعلِّق بالكورال في القرن التَّاسع عشر)\nمثال: أنا أغني أغنية. / رَقْص شَعْبِيّ (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع الموسيقى أو أنغام معينة؛ نشاط جسدي يتم على عادة أو تقليد، حيث يشارك الأفراد في الاحتفالات أو الفعاليات الاجتماعية)\nمثال: كنت تجيد الرقص.",
 "みんろん": "رَأْي عَامّ",
 "みんわ": "حِكَايَة شَعْبِيَّة, فُولْكُلُور (حكاية تتداول شفهياً بين عامة الناس)",
 "みセク": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "みチェック": "جَامِح, مُنْفَلِت (غير مكبوح أو غير مسيطَر عليه)",
 "みーちゃんはーちゃん": "مُتَّبِع لِلصَّرْعَات, مُقَلِّد لِلْمُوضَة (شخص يتبع مجموعة متنوعة من البدع أو الصرعات)",
 "みーはー": "مُتَّبِع لِلصَّرْعَات, مُقَلِّد لِلْمُوضَة (شخص يتبع مجموعة متنوعة من البدع أو الصرعات)",
 "み使い": "مَلَاك / مَلْأَك / مَلَك (لغة في المَالِك، وهو الذي يَمْلِكُ؛ السُلْطَان الحَاكِم الذي يملك الأَرْض والبِلاد)\nمثال: زيري ملك لنفسه.",
 "み子": "اِبْن اللَّٰه (الولد الذكر)\nمثال: هو له ابن صغير.",
 "み言葉": "كَلَام اللّٰهِ",
 "む": "سِتَّة\nمثال: 私は毎朝六時に起きます。 — أستيقظ في السادسة كل صباح. / لَا شَيْء (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة. / عَجَبًا / سُبْحَانَ الله (مصدر للفعل سَبَحَ؛ تُقال حصرًا للَّٰه، كما في العبارة \"سُبْحَانَ اللَّٰهِ\")\nمثال: سبحان الله عما يشركون. / بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات الشام، في بعض اللهجات الشامية الأخرى يقال مبَلَى…) / نَعَم, نَعَمَانِ (الإبِل والبَقَر والغَنَم. وتسمى نَعَم فقط إذا كان فيها إبل، فالإبل لوحدها نَعَم…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / إرَادَة / رَغْبَة, إرَادَة / وَدَّ (تمنى ورجا؛ أراد شيئا)\nمثال: السيدة وود طباخة جيدة.",
 "むい": "بطالة, تسكع (عدم القيام بعمل أو وظيفة) / بطالة, تراخ (سمة كون المرء عاطلاً بسبب العزوف عن العمل) / بُطْلَان, لَا أَسَاس (صفة الافتقار إلى الجوهر أو القيمة)\nمثال: تم التعرف بسرعة على بطلان تقريرهم / انتفاء الخوف, جسارة (سمة عدم الشعور بالخوف) / جسارة, عدم الخوف (عدم الشعور بالخوف)",
 "むいぎ": "بلا معنى, عبثي (ليس له معنى أو اتجاه أو غرض) / عَبَثِيّ, عَقِيم (لَا يُنْتِجُ أَيَّ نَتِيجَةٍ أَوْ أَثَر)\nمثال: مسعى بلا معنى",
 "むいし": "قسري, لا إرادي (غير خاضع لسيطرة الإرادة) / لا إرادي (يتم التحكم فيه بواسطة الجهاز العصبي اللاإرادي؛ دون تحكم واعي)\nمثال: قتل غير عمد (لا إرادي)",
 "むいしき": "فِقْدَان اَلْوَعْي, إِغْمَاء / فاقد الوعي, لاواعٍ (غير واعٍ؛ يفتقر إلى الوعي والقدرة على الإدراك الحسي كما لو كان نائماً أو ميتاً) / لَا وَاعٍ (بِدُونِ إِرَادَةٍ وَاعِيَة) / عقل لاواعي, لاوعي (ذلك الجزء من العقل الذي يحدث فيه النشاط النفسي الذي لا يدركه الشخص)\nمثال: مستلقٍ فاقداً للوعي على الأرض",
 "むいしきてき": "فاقد الوعي, لاواعٍ (غير واعٍ؛ يفتقر إلى الوعي والقدرة على الإدراك الحسي كما لو كان نائماً أو ميتاً) / لَا وَاعٍ (بِدُونِ إِرَادَةٍ وَاعِيَة) / عقل لاواعي, لاوعي (ذلك الجزء من العقل الذي يحدث فيه النشاط النفسي الذي لا يدركه الشخص)\nمثال: مستلقٍ فاقداً للوعي على الأرض",
 "むいちもん": "فقير",
 "むいぶりょう": "مَلَل, ضَجَر",
 "むいみ": "هُرَاء, لَغْو",
 "むいむりょう": "مَلَل, ضَجَر",
 "むいんし": "شعر مرسل (شعر غير مقفى (عادة في البحر الخماسي اليامبي))",
 "むう": "سِتَّة\nمثال: 私は毎朝六時に起きます。 — أستيقظ في السادسة كل صباح.",
 "むうっと": "بإصرار, بثبات (بتصميم حازم) / بإحكام, بقوة / بِأَمَان, بِإِحْكَام (بطريقة آمنة؛ بطريقة خالية من الخطر)\nمثال: صدقنا ذلك بحزم",
 "むえき": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "むえん": "لا تربطه قرابة, ليس قريباً (غير متصل بقرابة) / غير ذي صلة, غير مرتبط (يفتقر لعلاقة منطقية أو سببية) / غَيْرُ مُتَبَّل, غَيْرُ مُمَلَّح (بِدُونِ مِلْحٍ أَوْ تَوَابِل) / خالٍ من الرصاص (غير معالج بالرصاص) / غَيْر مُرَصَّص (لا يحتوي على شرائح رصاص بين السطور)\nمثال: بنزين خالٍ من الرصاص / عَاجِز / بلا دخان, غير مدخن (ينبعث منه القليل من الدخان أو لا ينبعث منه على الإطلاق)\nمثال: مداخن مصانع بلا دخان",
 "むえんかやく": "بارود عديم الدخان, باليستيت (مادة متفجرة (الاسم التجاري باليستيت) تحترق بدخان قليل نسبيًا؛ تحتوي على البايروسليلوز وتستخدم كوقود دافع)",
 "むえんしょく": "حمية خالية من الملح, حمية قليلة الصوديوم (نظام غذائي يحد من تناول الملح (كلوريد الصوديوم)؛ يستخدم غالباً في علاج ارتفاع ضغط الدم أو الوذمة أو اضطرابات أخرى)",
 "むえんたん": "أنتراسيت, فحم حجري صلب (فحم طبيعي صلب يحترق ببطء ويعطي حرارة شديدة)",
 "むえんぼち": "مقبرة الغرباء (مقبرة للأشخاص المجهولين أو المعوزين)",
 "むおん": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "むか": "لَا يُقَدَّرُ بِثَمَن, نَفِيس (ذُو قِيمَةٍ مَادِّيَّةٍ أَوْ فِكْرِيَّةٍ أَوْ رُوحِيَّةٍ لَا تُحْصَى) / إبطال, إلغاء المفعول (فعل الإبطال؛ جعل الشيء لاغياً وباطلاً؛ أو تجاوز تأثير أو قوة شيء ما) / إبطال (مذهب حقوق الولايات القائل بأن الولاية يمكنها رفض الاعتراف بقانون فيدرالي صادر عن الكونغرس الأمريكي أو رفض تنفيذه) / تحويل إلى ذرات, تذرية (الإفناء عن طريق تحويل الشيء إلى ذرات) / تذرية, تفتيت (فصل شيء ما إلى جزيئات دقيقة)",
 "むかい": "تبطين, تغليف (تزويد شيء بسطح من مادة مختلفة) / تكسية خارجية, كسوة (غطاء واقٍ يحمي الجزء الخارجي من المبنى) / بطانة الحافة, سجاف (بطانة تطبق على حافة الملابس للزينة أو التقوية) / تكسية, قشرة خارجية (طلاء زخرفي لمبنى) / اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم.",
 "むかいあわせ": "وجهاً لوجه (في حضور بعضهما البعض) / متقابلين, وجهاً لوجه (يواجهان بعضهما البعض مباشرة) / مُبَاشِر, وَجْهًا لِوَجْه (في حضور بعضهم بعضًا مباشرة)\nمثال: قابلت الرئيس وجهاً لوجه",
 "むかいあわせる": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "むかいかぜ": "كَوْس, رِيَاح مُضَادَّة",
 "むかいなみ": "بحر معاكس (بحر تجري فيه الأمواج مباشرة عكس مسار السفينة)",
 "むかいび": "نتيجة عكسية (سوء تقدير يرتد على صاحبه) / حريق مضاد (حريق يتم إشعاله عمداً لإبطاء حريق غابة أو حشائش مقبل عن طريق إخلاء منطقة محترقة في مساره) / اشتعال خلفي, فرقعة عكسية (ضجيج عالٍ صادر عن انفجار الوقود في متشعب أو عادم محرك الاحتراق الداخلي) / ارتداد غازي, نفث خلفي (الهروب العكسي للغازات والبارود غير المحترق بعد إطلاق النار)",
 "むかう": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه.",
 "むかうところてきなし": "لَا يُغْلَب, لَا يُقْهَر (لَا يُمْكِنُ هَزِيمَتُهُ أَوْ إِخْضَاعُهُ) / عَصِيٌّ عَلَى الهَزِيمَة, لَا يُقْهَر (يصعب التغلّب عليه أو هزيمته)",
 "むかうのさと": "طُوبَائِيَّة, مَدِينَةٌ فَاضِلَة",
 "むかえ": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا) / مُلَاقَاة, مُقَابَلَة (لِقَاء) / مُلَاقَاة, لِقَاء (لِقَاء)\nمثال: هذا اجتماع مهم.",
 "むかえうつ": "وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: واجه سامي ليلى.",
 "むかえかく": "زاوية الهجوم (الزاوية الحادة بين اتجاه الرياح النسبية غير المضطربة ووتر الجنيح)",
 "むかえざけ": "ترياق الخمار, علاج الدوار (مشروب كحولي يعتقد أنه يعالج آثار الشرب السابق)",
 "むかえぬし": "مُحَافِظ",
 "むかえる": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه) / اِسْتَقْبَلَ, يَسْتَقْبِل (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / دَعَا إِلَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ) / اِعْتَرَفَ\nمثال: كنت هنا من قبل. / بَلَغَ",
 "むかか": "تين, تين شائع (شجرة متوسطية تُزرع على نطاق واسع لثمارها الصالحة للأكل) / تِين, بَلَس",
 "むかく": "أَجْلَح",
 "むかくるい": "حَيَوَان عَنْكَبُوتِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي يأكل وينمو ويتحرك بالإرادة وبه حِسّ بخلاف ما به حياة فقط دون الحس مثل النَبَات. بعض العامة تقول حَيْوَان وهو غلط)\nمثال: هذا حيوان أليف.",
 "むかし": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "むかしかたぎ": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "むかしがたり": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني)) / استحضار الماضي, ذكريات (انطباع ذهني محفوظ ومستعاد من الماضي)\nمثال: لديه استدعاء كامل للحلقة",
 "むかししき": "أولد فاشن (كوكتيل مصنوع من الويسكي والبيترز والسكر مع شرائح الفاكهة)",
 "むかしつ": "تنزه عن الخطأ, عصمة (صفة الإعفاء من الخطيئة أو عدم القدرة على ارتكابها) / خلو من العيب, عصمة (جودة كون الشيء بلا خطأ أو عيب)",
 "むかしとかげ": "تواتارا (العضو الوحيد الباقي من رتبة منقاريات الرأس من الزواحف الكبيرة الشائكة الشبيهة بالسحالي ثنائية الثقوب في الجزر الساحلية قبالة نيوزيلندا)",
 "むかしながら": "غَيْر مُغَيَّر (باقٍ في حالة أصلية) / ثَابِت, غَيْر مُتَغَيِّر (لم يُصنع أو يصبح مختلفاً)\nمثال: استمر غير متغير عبر الزمن",
 "むかしにんげん": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "むかしばなし": "حِكَايَة شَعْبِيَّة, فُولْكُلُور (حكاية تتداول شفهياً بين عامة الناس) / استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني)) / استحضار الماضي, ذكريات (انطباع ذهني محفوظ ومستعاد من الماضي)\nمثال: لديه استدعاء كامل للحلقة",
 "むかしびと": "الأسلاف, قدماء (الناس الذين عاشوا في أزمنة غابرة (خاصة خلال الفترة التاريخية قبل سقوط الإمبراطورية الرومانية في أوروبا الغربية))",
 "むかしふう": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "むかしむかし": "قَدِيماً",
 "むかしむかしあるところに": "كَان يَامَا كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "むかしもの": "عجوز, كبير السن (شخص متقدم في السن)",
 "むかち": "انْعِدَام القِيمَة, لَا جَدْوَى (عدم امتلاك أي صفات تجعل الشيء قيماً أو مفيداً) / انْعِدَام القِيمَة (صفة كون الشيء بلا فائدة عملية)\nمثال: كان هدف رقيب التدريب إقناع المجندين بانعدام قيمتهم",
 "むかっぱら": "غَضَب / أَغْضَبَ / غَضِبَ",
 "むかっ腹": "غَضَب / أَغْضَبَ / غَضِبَ",
 "むかばら": "غَضَب / أَغْضَبَ / غَضِبَ",
 "むかりゅうきゅうしょう": "ندرة المحببات (اضطراب دموي حاد يتميز بانخفاض حاد في الخلايا المحببة)",
 "むかん": "بلا تاج, غير متوج (غير مزود (خاصة ليس بعد) بتاج) / غير متوج (ليس لديه تاج (اصطناعي) على السن؛ يستخدم بشكل خاص للأضراس والضواحك)\nمثال: الملك غير المتوج",
 "むかんかく": "خَدِر (استتر؛ خدر بالمكان: أقام) / خَدَّرَ (استتر؛ خدر بالمكان: أقام) / خَفَّفَ (قلل شيئًا أو نقص من حدته؛ هون أو لطف من شدة أمر)\nمثال: خفف زيري السرعة. / لَا مُبَالٍ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "むかんがえ": "غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين) / أرعن, طائش (يظهر نقصًا في التفكير المتأني)\nمثال: تحول النقاش إلى مشاحنات طائشة",
 "むかんきゃく": "خلف الأبواب المغلقة (بَدَلَ، أَعْقَبَ؛ أَتَى بعده أو جاء مكانه)\nمثال: دار زيري للخلف.",
 "むかんけい": "لا تربطه قرابة, ليس قريباً (غير متصل بقرابة) / غير ذي صلة, غير مرتبط (يفتقر لعلاقة منطقية أو سببية)",
 "むかんしょう": "عدم التدخل (سياسة خارجية للبقاء خارج نزاعات الدول الأخرى) / انحباس العرق, لا تعرق (فشل الغدد العرقية في العمل)",
 "むかんしん": "لَا مُبَالٍ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "むかんじょう": "لَامُبَالَاة, عَدَم اِكْتِرَاث",
 "むかんどう": "عادي, غير مثير للإعجاب (غير قادر على إثارة الإعجاب)",
 "むかんのていおう": "صَحَفِيّ, صَحَفِيَّة / مُرَاسِل, مُرَاسِلَة (الكاتب)\nمثال: لن أنس مراسلة أمي.",
 "むかーし": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما) / بَعْدَ (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "むかーしむかし": "قَدِيماً",
 "むかーしむかーし": "قَدِيماً",
 "むが": "إِيثَار, غَيْرِيَّة",
 "むがい": "غير ضار, مسالم (لا يسبب أو غير قادر على التسبب في ضرر)\nمثال: بكتيريا غير ضارة / مَفْتُوح / فَتَحَ (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / فتح (ضد أغْلَقَ وسَدَّ؛ تركه بلا شيء يسده؛ الطريق: جعلها سالكة للطارقين) / حل (للعقدة: ضد عَقْدها؛ للجامد في السائل: إذابته) / اِنْفَتَحَ (فعل مطاوعة لفَتَحَ، فَتَحْتُهُ فانْفَتَح؛ يستخدم عوضا عن المبنى للمجهول فُتِحَ. )\nمثال: فتح الباب آليا.",
 "むがいか": "إزالة السموم (علاج للتسمم عن طريق تحييد الخصائص السامة (عادة وظيفة الكبد)) / تخلص من السموم, علاج الإدمان (علاج لإدمان المخدرات أو الكحول يهدف إلى إزالة الآثار الفسيولوجية للمواد المسببة للإدمان) / تَعْقِيم ((وعَقَّمَهُ تَعْقيمًا: أسْكَتَه)؛ عقّم يعقِّم تعقيماً،فهو معقِّم،والمفعول مُعقَّم ، عَقَّمَ حجرة العمليات :أباد ما فيها من جراثيم ضارّة و ميكروبات لمنع تطوّر المرض الناقل لل جراثيم)",
 "むがく": "جاهل, غير متعلم (لا يمتلك تعليماً جيداً) / بوذا (الشخص الذي حقق حالة من الاستنارة الكاملة)",
 "むがくめんかぶ": "أسهم بدون قيمة اسمية (أسهم ليس لها قيمة اسمية محددة في ميثاق الشركة أو على شهادة الأسهم)",
 "むがくめんかぶしき": "أسهم بدون قيمة اسمية (أسهم ليس لها قيمة اسمية محددة في ميثاق الشركة أو على شهادة الأسهم)",
 "むがくるい": "لا فكيات (فقاري يشبه الثعبان بدون فكوك أو زوائد مزدوجة بما في ذلك دائريات الفم وبعض الأشكال المنقرضة)",
 "むがのきょう": "ترانس",
 "むき": "اِتِّجَاه / إِخْرَاج (إخراج؛ أَخْرَجَ: (فعل) أخرجَ يُخرج ، إخراجًا ، فهو مخرِج ، والمفعول مخرَج)\nمثال: لا تنس إخراج القمامة. / مَيْل, نَزَعَة / طَبِيعَة, طبيعة / أُقْنُوم / فَرْد / غير عضوي (متعلق أو منتمي لفئة المركبات التي ليس أساسها الكربون) / جامد, غير عضوي (يفتقر لخصائص الكائنات الحية)\nمثال: أحماض الهيدروكلوريك والكبريتيك تسمى مواد غير عضوية / كيمياء اللاعضوية (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما إلى الذهب؛ علم من علوم الطبيعة يتناول خواص العناصر والمركبات والقوانين التي تحكم تفاعلاتها)\nمثال: هو يحب الكيمياء. / مركب غير عضوي (أي مركب لا يحتوي على الكربون) / نَكِرَة / سَجْن مُؤَبَّد (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن. / وَقِح, صَفِيق",
 "むきあう": "وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: واجه سامي ليلى.",
 "むきかがく": "كيمياء اللاعضوية (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما إلى الذهب؛ علم من علوم الطبيعة يتناول خواص العناصر والمركبات والقوانين التي تحكم تفاعلاتها)\nمثال: هو يحب الكيمياء.",
 "むきかごうぶつ": "مركب غير عضوي (أي مركب لا يحتوي على الكربون)",
 "むききんこ": "سَجْن مُؤَبَّد (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "むきけい": "سَجْن مُؤَبَّد (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "むきげん": "نَكِرَة",
 "むきしつ": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك بلا حماوة، غير محميّ على النَّار) / بَرْدَان / بُرُودَة, بَرْد / زُكَام, رَشْح\nمثال: الماء بارد حقا.",
 "むきしつひりょう": "سماد معدني (سماد غير عضوي يحتوي على معادن نادرة)",
 "むきず": "سَالِم, مُعَافًى (لم يُصَب بأذى أو ضرر) / سَالِمٌ مُعَافًى (سليم من الخطر أو الأذى) / بِلَا عَيْب, خَالٍ مِنَ العُيُوب (خالٍ من أيّ عيب أو شائبة) / بِلَا شَائِبَة, نَاصِع (بالغ النظافة وخالٍ من أيّ بقعة أو لطخة)",
 "むきだし": "عُرْيَان, عَارٍ / إِفْرَنْجِيّ",
 "むきだす": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه.",
 "むきちょうえき": "سَجْن مُؤَبَّد (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "むきてき": "غير عضوي (متعلق أو منتمي لفئة المركبات التي ليس أساسها الكربون) / جامد, غير عضوي (يفتقر لخصائص الكائنات الحية)\nمثال: أحماض الهيدروكلوريك والكبريتيك تسمى مواد غير عضوية",
 "むきどう": "بِلَا مَسَالِك, وَعْر (يفتقر إلى الممرّات والطرق المعبَّدة) / بلا أثر, غير مطروق (ليس به آثار)\nمثال: حافلة ترولي بلا مسار (سكة) / مُتَهَوِّر",
 "むきはい": "انخماص الرئة (انهيار رئة متمددة (خاصة عند الرضع)؛ أو فشل الحويصلات الهوائية الرئوية في التوسع عند الولادة)",
 "むきぶつ": "مركب غير عضوي (أي مركب لا يحتوي على الكربون)",
 "むきむき": "مُلَاءَمَة, مُنَاسَبَة (صفة امتلاك الخصائص الصحيحة لغرض معين)\nمثال: مطلب مهم هو الملاءمة للرحلات الطويلة / عَضَلِيّ",
 "むきめい": "غير موقع (يفتقر إلى التوقيع)\nمثال: الرسالة كانت مطبوعة وغير موقعة",
 "むきめいかぶ": "سهم لحامله (سهم لا يحتوي على معلومات الملكية ويفترض أن حامله المادي هو المالك)\nمثال: الأسهم لحاملها محظورة في بعض البلدان بسبب احتمال إساءة استخدامها",
 "むきめいとうひょう": "اقتراع سري (تصويت يكون فيه اختيار كل شخص سريًا ولكن إجمالي الأصوات علني)",
 "むきゃく": "عَدِيمُ القَوَائِم ((عَنِ الأَفَاعِي وَالأَنْقَلَيْسِ) بِلَا أَقْدَامٍ بِطَبِيعَتِهِ)",
 "むきゅう": "رحلة بدون توقف (رحلة تتم دون توقفات وسيطة بين المصدر والوجهة) / بلا توقف (بدون توقف) / دُونَ تَوَقُّف, عَلَى مَدَارِ السَّاعَة (فِي جَمِيعِ الأَوْقَات؛ دُونَ انْقِطَاع) / بِدُون تَوَقُّف ((عَنِ الرِّحْلَات خَاصَّةً الجَوِّيَّة) تَتِمّ بِدُون تَوَقُّفَات)\nمثال: كم عدد الرحلات بدون توقف إلى دالاس؟ / بلا أجر, غير مدفوع (لم يتم الدفع له) / تَرْفِيهِيّ, هَاوٍ (يُمارَس كهواية أو تسلية) / تَطَوُّعِيّ, غَيْرُ مَأْجُور (بِدُونِ مُقَابِلٍ مَادِّيّ)\nمثال: أجور غير مدفوعة / أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ؛ ما يَنْفُر القَلْب عن تقدير نهايته) / أبَدِيَّة\nمثال: سأحبك إلى الأبد.",
 "むきゅうか": "ختمية سورية, ورد شارون (شجيرة آسيوية أو شجرة شجيرية صغيرة ذات زهور وردية أو أرجوانية أو بيضاء مبهرجة على شكل جرس وأوراق ثلاثية الفصوص عادة؛ تزرع على نطاق واسع في أمريكا…)",
 "むきゅうかく": "خشم, فقد الشم (غياب حاسة الشم)",
 "むきゅうかくしょう": "خشم, فقد الشم (غياب حاسة الشم)",
 "むきゅうどう": "حركة أبدية (حركة تستمر إلى أجل غير مسمى دون أي مصدر خارجي للطاقة؛ مستحيلة عملياً بسبب الاحتكاك)",
 "むきゅうるい": "لا ثقوبيات (زاحف بدائي ليس له فتحة في المنطقة الصدغية من الجمجمة؛ جميعها منقرضة باستثناء السلاحف)",
 "むきょういく": "جاهل, غير متعلم (لا يمتلك تعليماً جيداً)",
 "むきょうかい": "احتشاد, تجمهر (تجمع الناس معاً) / التقاء, تلاق (التدفق معاً في مجرى واحد) / ملتقى النهرين, نقطة التقاء (مكان تندمج فيه الأشياء أو تتدفق معًا (خاصة الأنهار))\nمثال: تقع بيتسبرغ عند نقطة التقاء نهري أليغيني ومونونغاهيلا",
 "むきょうしつ": "غرفة عديمة الصدى (غرفة ذات صدى ضئيل جداً)",
 "むきょうよう": "جاهل, غير متعلم (لا يمتلك تعليماً جيداً)",
 "むきょか": "غَيْر مُخَوَّل, غَيْر مُصَرَّح بِه (غير ممنوح السلطة) / غَيْر مَأْذُون, غَيْر مُصَرَّح بِه (بدون تصريح أو إذن رسميّ)",
 "むきょく": "بِلَا حُدُود, لَامَحْدُود (يَبْدُو بِلَا حُدُودٍ فِي الكَمِّيَّةِ أَوِ العَدَدِ أَوِ الدَّرَجَةِ أَوِ المَدَى) / بلا حدود, غير محدود (ليس له حدود في المدى أو النطاق) / لَا حَدَّ لَه, لَا مَحْدُود (بلا حدود في المدى أو الحجم أو الكمية)\nمثال: البدء بنظرية الحرية غير المحدودة هو الانتهاء باستبداد غير محدود",
 "むきりつ": "غَيْرُ مُنْضَبِط, فَاقِدُ الانْضِبَاط (يَفْتَقِرُ إِلَى الانْضِبَاطِ أَوِ السَّيْطَرَة) / غَيْرُ مُؤَدَّب, غَيْرُ مُصَحَّح (لم يخضع للتأديب أو التصحيح) / غَيْرُ مُنْضَبِط (لم يخضع للانضباط أو التأديب)",
 "むきりょく": "لَامُبَالَاة, عَدَم اِكْتِرَاث",
 "むきりょくじょうたい": "لَامُبَالَاة, عَدَم اِكْتِرَاث",
 "むきん": "مُعَقَّم (جُعِلَ عَقِيمًا بِإِجْرَاء طِبِّيّ)",
 "むきんせい": "خَالٍ مِنَ الجَرَاثِيم, مُعَقَّم (خالٍ من الكائنات الدقيقة المُمرضة أو يستخدم طرقًا لمنعها)",
 "むきんほう": "تطهير, تعقيم (عملية تثبيط نمو وتكاثر الكائنات الحية الدقيقة) / تعقيم, خلو من الجراثيم ((للأشياء غير الحية) حالة الخلو من الكائنات الحية المسببة للأمراض)",
 "むき出し": "عُرْيَان, عَارٍ / إِفْرَنْجِيّ",
 "むき出す": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ وتَأكَّدَ حصوله) / عَرْض, اِسْتِعْرَاض (أتى العروض، أي مكّة والمدينة وما حولهما؛ الفَرَسَ: سار به بالعُرض) / بَرْنَامَج (عَرْضٌ (تلْفَزِيٌّ،…)؛ مُفَكَّرَةٌ يَوْمِيَّةٌ) / مَعْرِض / إِظْهَار, عَرْض\nمثال: ثبت مناد مكانه.",
 "むぎ": "قَمْح, حِنْطَة / وَقِح, صَفِيق",
 "むぎこ": "دقيق القمح, طحين القمح (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "むぎこう": "بَسِيط, سَاذَج (بسيط وطبيعي؛ بدون مكر أو خداع) / بسيط, ساذج (يتميز بعدم القدرة على إخفاء المشاعر؛ غير ماكر) / سَاذَجٌ, غَيْرُ مُثَقَّفٍ ((عن الأشخاص) يفتقر إلى الثقافة أو المعرفة) / خَالٍ مِنَ الْبَرَاعَةِ, سَاذَج (يُظهر افتقارًا إلى الحرفية والفنّ)\nمثال: أسلوب بسيط",
 "むぎはんにゃ": "بِيرَة, جِعَة",
 "むぎばたけ": "حقل قمح (حقل مزروع بالقمح)",
 "むぎゅむぎゅ": "خَفِيف, مَرِن ((عن الحركات) خفيف ونشط بثقة) / مَرِنٌ مُرْتَدّ, نَابِض (مرن ويرتدّ بسهولة)",
 "むぎわらぎく": "ذهب الشمس, زهرة القش (نبات أسترالي متوطن في إسبانيا له زهور صفراء ليمونية إلى ذهبية عميقة؛ الخيار المتكرر لمحبي الزهور المجففة) / زهرة القش / أوفولاريا كبيرة الأزهار, زهرة القش (نبات من جنوب وجنوب شرق الولايات المتحدة يزرع لزهوره الصفراء التي يمكن تجفيفها)",
 "むぎわらとんぼ": "يَعْسُوب",
 "むぎわらぼう": "قبعة بنما, قبعة قش (قبعة صلبة مصنوعة من القش ذات تاج مسطح)",
 "むぎわらぼうし": "قبعة بنما, قبعة قش (قبعة صلبة مصنوعة من القش ذات تاج مسطح)",
 "むく": "بَدَا (ظَهَرَ) / نَظْرَة, شوفة / مَرْأىً, مَرْآة\nمثال: بدا سامي مريضا. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في المقدمة أو ما يوَجَه إلى الناس) / مَظْهَر (مَظْهَر هاذا الرجل مضحكٌ٠؛ مَظاهََرُ هذه الفتاة حسناءَ٠) / وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: تبدو شاحب الوجه. / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه) / مَوْقِع (موضع الوُقُوع؛ الموضع الذي حَدَثَ أو يحدث فيه حادث) / أَشَارَ\nمثال: هذه هي نقطة ضعفه. / قَشَّرَ / قِشْرَة, قِشْر / خَالٍ مِنَ الزَّخْرَفَة, سَادَة (يفتقر إلى التزيين أو الزخرفة) / عَارِي الجَسَد, عُرْيَان (لا يرتدي أي ملابس على الجسد) / عَارٍ, مُجَرَّد (أُزِيلَ مِنْهُ كُلّ شَيْء زَائِد بِمَا فِي ذَلِكَ المُحْتَوَيَات) / جَرْدَاء, قَاحِلَة (لا توفِّر مأوى ولا قوتاً) / صَافٍ, اَلصَّافِي",
 "むくい": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ / عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر) / عُقُوبَة / عِقَاب (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة البصر؛ حَجَر ناتئ في جَوْف البِئْر يخرق الدَلُو. ونادر)\nمثال: هو من تلقى العقاب الأكبر.",
 "むくいる": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "むくう": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "むくげ": "نسيان النص, هفوة (خطأ (خاصة نسيان الممثل للسطور)) / زينة رخيصة, شيء تافه (شيء قليل القيمة أو الأهمية) / زغب, وبر (أي مادة ريشية خفيفة) / ختمية سورية, ورد شارون (شجيرة آسيوية أو شجرة شجيرية صغيرة ذات زهور وردية أو أرجوانية أو بيضاء مبهرجة على شكل جرس وأوراق ثلاثية الفصوص عادة؛ تزرع على نطاق واسع في أمريكا…)",
 "むくせいじょう": "مُنَزَّه",
 "むくち": "قليل الكلام, كتوم (متحفظ عادة وغير متحدث)",
 "むくっと": "بغتة, على حين غرة (بسرعة وبدون سابق إنذار)\nمثال: توقف فجأة / بِبُطْء",
 "むくつけき": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس) / ثَخِن (ثَخُنَ الشيءُ ثُخونةً وثَخانةً وثِخَنًا، فَهُوَ ثَخِينٌ: كثُفَ وغَلُظ وصَلُبَ)\nمثال: زيري خشن الخلق.",
 "むくと": "بغتة, على حين غرة (بسرعة وبدون سابق إنذار)\nمثال: توقف فجأة / بِبُطْء",
 "むくどり": "زُرْزُور / فلاح ساذج, قروي بسيط (شخص ليس ذكياً جداً أو غير مهتم بالثقافة) / تِسْعَة وَسِتُّون",
 "むくどりもどき": "سوادية (شحرور أمريكي طويل الذيل ذو ريش أسود قزحي الألوان)",
 "むくみ": "انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء)) / انتفاخ, بروز (شيء ينتفخ للخارج أو يبرز عن محيطه) / انتفاخ, تضخم (بروز غير طبيعي أو تضخم موضعي)\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "むくむ": "اِنْتَفَخَ, وَرِمَ\nمثال: 手足がむくんでいます。 — تورمت قدميّ و يديّ.",
 "むくむく": "شَاهِق / سمين / تحريك, تقليب (تحريك سائل باستخدام أداة) / إلهام, تحريك المشاعر (الاستنهاض لعاطفة أو فعل معين) / مُثِير, مُحَرِّك لِلْمَشَاعِر (يثير مشاعر قوية لكنها غير مزعجة) / حَمَاسِيّ, مُلْهِم (قادر على إثارة الحماس أو الإثارة)\nمثال: التحريك المستمر يمنعه من الاحتراق في قاع المقلاة / أَشْعَث",
 "むくゆ": "مُكَافَأَة, ثَوَاب / جَائِزَة / جَزَاء / مَنَحَ",
 "むくり": "بغتة, على حين غرة (بسرعة وبدون سابق إنذار)\nمثال: توقف فجأة / بِبُطْء / حدبة, ميل العجلات (محاذاة عجلات السيارة لتكون أقرب لبعضها في الأسفل منها في الأعلى) / ميل جانبي (ميل في منعطف طريق أو مسار؛ يكون الجانب الخارجي أعلى من الداخلي لتقليل تأثيرات قوة الطرد المركزي) / تحدب طفيف, تقوس (تحدب طفيف (كما في سطح الطريق))",
 "むくれる": "بوز, حرد (مزاج أو إظهار للترفع العبوس أو الانسحاب)\nمثال: بقي في المنزل في حالة حرد / قَشَّرَ / قِشْرَة, قِشْر",
 "むくろ": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ سَمِنَ وَضَخُمَ فَهُوَ (بَادِنٌ))",
 "むく毛": "نسيان النص, هفوة (خطأ (خاصة نسيان الممثل للسطور)) / زينة رخيصة, شيء تافه (شيء قليل القيمة أو الأهمية) / زغب, وبر (أي مادة ريشية خفيفة)",
 "むぐら": "دابة الشجر, متسلق (أي من الطيور الصغيرة المتنوعة آكلة الحشرات في نصف الكرة الشمالي التي تتسلق جذوع الأشجار مستندة على ريش ذيل صلب وأقدامها) / زَاحِف (شخص يزحف أو يدب على الأرض) / مدادة, نبات زاحف (أي نبات (مثل اللبلاب أو العناقية) ينمو عن طريق الزحف)",
 "むぐる": "غَاصَ / غَطْسَ, يقفز الى الماء",
 "むけい": "عَدِيمُ الشَّكْل (لَيْسَ لَهُ شَكْلٌ مَادِّيٌّ مُحَدَّد) / غَيْر مُتَبَلْوِر, لَا شَكْلِيّ (ليس له شكل محدَّد أو هيئة واضحة) / لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "むけいかく": "غَيْر مُتْقَن, مُرْتَجَل (يَتَّسِم بِالإِهْمَال الشَّدِيد وعَدَم الدِّقَّة) / جزافاً, خبط عشواء (بدون عناية؛ بطريقة مرتجلة وسريعة) / اِعْتِبَاطِيّ, عَشْوَائِيّ (يعتمد على الصدفة أو يتّسم بها)\nمثال: كان رئيس الوزراء يرتدي بدلة رمادية وقميصاً أبيض بياقة ناعمة، لكن رقبته أصبحت أنحف والياقة تبتعد عنها كما لو تم شراؤها عشوائياً",
 "むけいさつ": "فَوْضَى, فَوْضَوِيَّة",
 "むけいざいさん": "أصل غير ملموس, أصول معنوية (أصول قابلة للبيع وإن لم كانت مادية أو فيزيائية)",
 "むけいぶんかいさん": "تراث ثقافي غير مادي",
 "むけつ": "بِلَا عَيْب, خَالٍ مِنَ العُيُوب (خالٍ من أيّ عيب أو شائبة) / أَبْيَض كَالمَوْت, فَاقِد الدَّم (خالٍ من الدم أو يبدو كذلك) / بِلَا إِرَاقَة دِمَاء, غَيْر دَمَوِيّ (خالٍ من الدم أو سفك الدماء) / شَاحِب, مُمْتَقَع (شاحب اللون كأنّه فاقد الدم؛ ذو مظهر مريض) / جَامِد, خَالٍ مِنَ الإِحْسَاس (خالٍ من العاطفة الإنسانية أو الشعور)\nمثال: جراحة غير دموية",
 "むける": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع على دُور؛ المنزل المَبْني. يجمع على دُور) / لَفَّ / قَلَبَ / اِنْقَلَبَ, صَارَ / اِنْعِطَاف / دَوْر, نَوْبَة (جَعَله يَدُور؛ جَعَلَه مُدَوَّر)\nمثال: إذهب إلى الدار. / خَصَّصَ (خَصَّصَ الشيءَ: جعله خاصًّا؛ خَصَّصَ فلانًا بالشيءِ: خَصَّهُ به)\nمثال: حاول توفير بعض المال من ما خصص للسفر. / أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / لَاحَقَ / اِتَّبَعَ (تَكَلَّفَ وبذل الجُهْد في أن يَتْبَع)\nمثال: اتبع قلبك فحسب.",
 "むけん": "استمرارية, تواصل (صفة الشيء الذي يستمر بلا نهاية أو انقطاع)",
 "むげ": "تَمَامًا / شَقَاوَة, تَعَاسَة",
 "むげっけい": "انقطاع الطمث (غياب أو قمع تدفق الطمث الطبيعي)",
 "むげに": "بِصَرَاحَة فَجَّة, بِفَظَاظَة (بطريقة مباشرة فظة)\nمثال: تحدث بفظاظة",
 "むげにする": "إِهْمال",
 "むげん": "حُلْم, رُؤْيَا (رأى في نومه) / حُلْم, أَحْلام (رأى في نومه) / حَلَمَ (رأى في نومه)\nمثال: هذا الحلم سيتحقق. / أبدية, خلود (زمن بلا نهاية) / لَا مُتَنَاهٍ (كلّيّ وشامل لكلّ شيء) / فراغ, فضاء (المدى غير المحدود الذي يقع فيه كل شيء) / لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ) / غير محدود, لانهائي (ليس له حدود أو قيود في الزمان أو المكان أو المدى أو الحجم)\nمثال: اختبروا قدرته على تحديد مواقع الأشياء في الفضاء / استمرارية, تواصل (صفة الشيء الذي يستمر بلا نهاية أو انقطاع)",
 "むげんきどう": "جنزير, مسار كاتربيلر (حزام معدني لا نهائي تتحرك عليه المركبات المجنزرة فوق الأرض)",
 "むげんざい": "خلو من العيب, طهارة (سمة عدم وجود وصمة أو شائبة؛ كونه نظيفاً، غير مدنس، صافياً، نقياً)\nمثال: للأسف لم يحافظ على نقائه بل استسلم لشهواته",
 "むげんざいのおんやどり": "الحَمْل بِلَا دَنَس",
 "むげんざいのやどり": "الحَمْل بِلَا دَنَس",
 "むげんしょう": "مُتَنَاهٍ فِي الصِّغَر (صغير بشكل لا نهائي أو لا يُقاس) / متناهي الصغر ((رياضيات) متغير حده هو الصفر)",
 "むげんすうれつ": "متتالية لا نهائية (تتابع غير محدود لعناصر مرتبة بترتيب معين)",
 "むげんだい": "أبدية, خلود (زمن بلا نهاية)",
 "むげんてい": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)",
 "むげんてき": "حُلُمِيّ, سُرْيَالِيّ (يشبه الحلم في غرابته وإيحائه)",
 "むげんほうまつ": "مُؤَقَّت, سَريع الزوال",
 "むげんれんさこう": "مخطط هرمي (مخطط احتيالي يتم فيه تجنيد أشخاص لدفع مدفوعات للشخص الذي جندهم بينما يتوقعون تلقي مدفوعات من الأشخاص الذين يقومون بتجنيدهم؛ عندما يفشل عدد المجندين…)",
 "むげんループ": "حلقة مغلقة, نظام الحلقة المغلقة (نظام تحكم ذو حلقة تغذية مرتدة نشطة)",
 "むこ": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها) / مثال: زوجة ماري طبيبة. / زَوْج اَلاِبْنَة, صِهْر (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة. / بَرِيء, بَرِيئَة / بَرِيء",
 "むこう": "هُنَاك, هُنَالِك / وِجْهَة, وُجْهَة / قَادِم / تَالٍ ((تَالَ): عالَجَ التِّوَلةَ: (السِّحْر)؛ (تَالَ) بِه: دُهِيَ ومُنِيَ) / بِجَانِب (بجانب)\nمثال: زيري بجانب الحوض. / بَاطِل, غَيْر صَالِح (لم يعد ساري المفعول) / باطل, غير سارٍ (ليس له قوة إقناع أو قوة قانونية) / عاجِز, مُقْعَد (شخص أقعده مرض مزمن أو إصابة)\nمثال: استدلال باطل / لا فموي (ليس له فم أو فتحة تشبه الفم) / بِلَا إِضَاءَة, غَيْر مُنَار (بِدُون إِنَارَة أَوْ إِضَاءَة) / غَيْر مُضَاء, مُطْفَأ (غير مضرم فيه النار أو غير محترق)\nمثال: كانت الطاولة عارية، والشموع غير مضاءة",
 "むこういき": "عدوانية, ولع بالقتال (ميل طبيعي للعداء) / إقدام, هجومية (صفة كون المرء جريئاً ومبادراً) / عدوانية (شعور بالعداء يثير أفكار الهجوم)",
 "むこうか": "مُعَطِّل, مُقْعِد (يُسَبِّب عَجْزًا أو إعاقَة جَسَدِيَّة) / مُبطل للأهلية, مُعجِز (الحرمان من الحق القانوني؛ جعل الشخص غير مؤهل قانونياً)\nمثال: بعض القيود المبطلة للأهلية حرمته من الجنسية / إبطال, إفساد (الإبطال عن طريق تدمير القوة القانونية)\nمثال: إبطال العقد",
 "むこうがい": "نَظِيف / نضيف / نَظَّفَ",
 "むこうき": "عدوانية, ولع بالقتال (ميل طبيعي للعداء) / إقدام, هجومية (صفة كون المرء جريئاً ومبادراً) / عدوانية (شعور بالعداء يثير أفكار الهجوم)",
 "むこうぎ": "عدوانية, ولع بالقتال (ميل طبيعي للعداء) / إقدام, هجومية (صفة كون المرء جريئاً ومبادراً) / عدوانية (شعور بالعداء يثير أفكار الهجوم)",
 "むこうじょうめん": "إسطبل (مبنى مزرعة لإيواء الخيول أو غيرها من الماشية) / الجانب الجنوبي (الجانب الذي يقع في الجنوب)",
 "むこうすい": "جَفَاف",
 "むこうずね": "قَصَبَة / شِين",
 "むこうたく": "غَيْر لَامِع, مَطْفِيّ (لَا يَعْكِس الضَّوْء؛ غَيْر بَرَّاق) / انطفاء, عدم اللمعان (خاصية وجود تباين ضئيل أو معدوم؛ الافتقار إلى الإبرازات الضوئية أو اللمعان)",
 "むこうっき": "عدوانية, ولع بالقتال (ميل طبيعي للعداء) / إقدام, هجومية (صفة كون المرء جريئاً ومبادراً) / عدوانية (شعور بالعداء يثير أفكار الهجوم)",
 "むこうにする": "إبطال, إلغاء المفعول (فعل الإبطال؛ جعل الشيء لاغياً وباطلاً؛ أو تجاوز تأثير أو قوة شيء ما) / تجاوز يدوي, جهاز تجاوز (جهاز يعمل يدوياً لتصحيح تشغيل جهاز أوتوماتيكي)",
 "むこうみず": "مُتَهَوِّر",
 "むこうりょう": "غَيْرُ مُنَكَّه (بِدُونِ إِضَافَةِ مُنَكِّهَات)",
 "むこうグラフ": "رسم بياني غير موجه (في الرياضيات، رسم بياني لا يكون للحواف فيه اتجاه)",
 "むこきゅう": "اِنْقِطَاع النَّفَس أَثْنَاء النَّوْم",
 "むこく": "عَاجِز",
 "むこくせきしゃ": "شخص بلا جنسية, نازح (شخص أجبر على الفرار من منزله أو بلده)",
 "むこせい": "انْعِدَام المَلَامِح, بَهْتَان (حالة أو شرط الخلو من الميزات المميزة)",
 "むこようし": "زَوْج اَلاِبْنَة, صِهْر (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "むこん": "لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "むこんきょ": "لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "むごい": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / مَأْسَاوِيّ, تْرَاجِيدِيّ",
 "むごし": "أَعْزَل",
 "むごたらしい": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير.",
 "むごん": "صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ!",
 "むごんげき": "بانتوميم, تمثيل صامت (أداء يستخدم الإيماءات وحركات الجسم بدون كلمات) / إيمائي, ممثل صامت (ممثل يتواصل كلياً عن طريق الإيماءات وتعابير الوجه)",
 "むごんしょう": "بكم, خرس (حالة عدم القدرة أو عدم الرغبة في التحدث)\nمثال: كان خرسه نتيجة لصممه",
 "むさい": "عَجْز, عَدَم كَفَاءَة (نقص في القدرة الجسدية أو الفكرية أو المؤهلات) / عجز, قصور (عدم قدرة جزء أو عضو على العمل بشكل صحيح) / قَذِر جِدًّا, مُقْرِف (بالغ القذارة بشكل مثير للاشمئزاز؛ ملطّخ بمواد كريهة) / بَذِيء, سَافِل (يتّسم بالفحش وخدش الحياء) / حَقِير, وَضِيع (خسيس ومحتقر؛ دنيء) / أعزب (رجل لم يتزوج قط)",
 "むさいしょく": "لَالَوْنِيّ, مُحَايِد (ليس له تدرج لوني)\nمثال: ألوان محايدة مثل الأسود أو الأبيض",
 "むさくい": "عَشْوَائِيّ",
 "むさくいか": "تعشية, عشوائية (ترتيب عشوائي متعمد للملاحظات لمحاكاة الصدفة)",
 "むさくいちゅうしゅつ": "أخذ عينات عشوائي (اختيار عينة عشوائية؛ حيث يكون لكل عنصر من عناصر المجتمع فرصة متساوية في الاختيار)",
 "むさくじょ": "غَيْر مُختَصَر, كَامِل (كامل بلا حذف أو اختصار) / سليم, غير مقطوع (لم يتم قطعه) / غير مفصول الصفحات, غير مقصوص ((عن صفحات كتاب) تكون الأوراق المتجاورة لا تزال متصلة عند الحافة الأمامية) / خام, غير مصقول (لم يتم تشكيله عن طريق القطع أو التشذيب)\nمثال: كتاب أوراقه لا تزال غير مفصولة",
 "むさくるしい": "فَوْضَوِيّ, وَسِخ (قَذِرٌ وَغَيْرُ مُنَظَّم)",
 "むさしのびじゅつたんきだいがく": "كلية متوسطة, كلية مجتمع (كلية تقدم فقط السنتين الأوليين وتنتهي بدرجة مشارك)",
 "むさべつ": "اعتباطي, عشوائي (لا يتميز بتمييزات دقيقة (يخلط الحابل بالنابل)) / عَشْوَائِيّ, غَيْر مُمَيِّز (يُخْفِق فِي التَّمْيِيز بَيْنَ الأَشْيَاء)\nمثال: عادات قراءة عشوائية",
 "むさべつきょくせん": "منحنى السواء (في نظرية الاقتصاد الجزئي، رسم بياني يوضح مجموعات مختلفة من السلع التي يكون المستهلك غير مبالٍ بينها)",
 "むさぼりくう": "اِلْتَهَمَ",
 "むさぼり食う": "اِلْتَهَمَ",
 "むさぼる": "طَمُعَ, طَمِعَ / اِلْتَهَمَ",
 "むさん": "اختفاء مفاجئ, تلاشي (اختفاء مفاجئ عن الأنظار) / اختفاء مفاجئ, تلاشي (اختفاء مفاجئ أو غامض)",
 "むさんしゃ": "بْرُولِيتَارِيّ / بْرُولِيتَارِيّ, بْرُولِيتَارِيَّة",
 "むさんそ": "لَا هَوَائِيّ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "むさんそうんどう": "بناء العضلات, تمرين لاهوائي (تمرين يبني العضلات من خلال التوتر والمقاومة)",
 "むさ苦しい": "فَوْضَوِيّ, وَسِخ (قَذِرٌ وَغَيْرُ مُنَظَّم)",
 "むざい": "بَرَاءَة",
 "むざいほうめん": "تَبْرِئَة",
 "むざつ": "صَافٍ, اَلصَّافِي",
 "むざね": "الشَّيْء الأَصْلِيّ (استخدام غير رسمي ينسب الأصالة)",
 "むざむざ": "بعجز, بقلة حيلة (بطريقة عاجزة)\nمثال: راقبه الحشد بقلة حيلة",
 "むざん": "قَاسٍ, الْقَاسِي (شديد وصلب، غير لين؛ جافٍ أو يابس في الملمس أو التعامل)\nمثال: قاس طول السرير. / مُثِير لِلشَّفَقَة, مُزْرٍ (يُثِير مَزيجاً مِن الاحتقار والشَّفَقة) / بَائِس, مُثِيرٌ لِلشَّفَقَة (يَسْتَحِقُّ الشَّفَقَةَ أَوْ يَسْتَدْعِيهَا) / مُؤْسِف, مُحْزِن (سيء ومؤسف؛ يبعث على الأسى)",
 "むし": "حَشَرَة (صغار دواب الأرض؛ الهامة من هوام الأرض كالخنافس)\nمثال: ما زالت الحشرة حية. / شَخْص دَنِيء (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان. / فاقد الوعي, لاواعٍ (غير واعٍ؛ يفتقر إلى الوعي والقدرة على الإدراك الحسي كما لو كان نائماً أو ميتاً) / لَا وَاعٍ (بِدُونِ إِرَادَةٍ وَاعِيَة) / عقل لاواعي, لاوعي (ذلك الجزء من العقل الذي يحدث فيه النشاط النفسي الذي لا يدركه الشخص)\nمثال: مستلقٍ فاقداً للوعي على الأرض / تَوَتُّر / بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات / غَيْر أَنَانِيّ, نَزِيه (ليس جشعاً أو طمّاعاً) / غير أناني, مؤثر (للغير) (يتجاهل مصالحه ورفاهيته الخاصة لصالح الآخرين) / بشكل حار جداً, بغلليان ((تستخدم للحرارة) للغاية) / بُخَارِيّ, مُتَصَاعِد البُخَار (مملوء بالبخار أو ينبعث منه رطوبة على شكل بخار أو ضباب)\nمثال: كان الطبق ساخناً جداً / قُنَّبُ سِيَام",
 "むしあつい": "رَطْب, رَطِب (يحتوي على الماء أو الرطوبة، غير جاف؛ لين أو طري الملمس بسبب وجود الرطوبة)\nمثال: ملابسي رطبة ومليئة في التراب علي تبديلها.",
 "むしかえす": "اجترار, تكرار (مادة قديمة تم إعادة صياغتها قليلاً واستخدامها مرة أخرى)\nمثال: مجرد اجترار ممل لروايته الأولى",
 "むしかく": "غير مؤهل, غير مختص قانونياً (غير مؤهل أو غير كافٍ قانونياً) / بِلَا حَقّ, غَيْرُ مُسْتَحِقّ (لا يملك حقاً أو استحقاقاً) / غير مؤهل (غير مستوف للمعايير والمتطلبات والتدريب المناسب) / غير مشروط, مطلق (غير محدود أو مقيد)\nمثال: تعتبر الزوجة عادة غير مؤهلة للشهادة ضد زوجها",
 "むしかくしゃ": "عَاجِز, غَيْر مُؤَهَّل (لا يستوفي المتطلّبات اللازمة) / عاجز, غير كفء (غير مؤهل أو غير مناسب لغرض ما) / غير مؤهل, غير مختص قانونياً (غير مؤهل أو غير كافٍ قانونياً) / عَدِيم المَهَارَة, غَيْر كُفْء (لا يؤدي العمل بشكل جيد؛ يفتقر إلى الكفاءة)\nمثال: جهاز مخابرات غير كفء",
 "むしかり": "أُفلُوس, رِبَاط",
 "むしがいい": "أَنَانِيّ",
 "むしがすかない": "كَرِهَ (لم يُحِبّ، لم يَسْتطِع تحمُّلَ شَخْص أو أمرٍ، لم يُطِقْه، مقَته وكان عنده نُفورٌ منه؛ كره الشّخص فعل السّوء)\nمثال: هتلر كره اليهود.",
 "むしがよい": "أَنَانِيّ",
 "むしき": "بَاخِرَة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار) / قِدْر بُخَارِيّ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / بَاخِرَة, سَفِينَة بُخَارِيَّة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار)\nمثال: الباخرة الآن في الميناء.",
 "むしくい": "مَسُوس, مُتَأَكِّلٌ بِالدُّودِ (مُصَابٌ أَوْ مُتَضَرِّرٌ بِفِعْلِ الدِّيدَانِ)",
 "むしくだし": "طارِد لِلدِّيدان, مُبيد لِلطُّفَيْلِيّات (يَقْتُل الدِّيدان والطُّفَيْلِيّات المِعَوِيَّة) / طارد للديدان (دواء قادر على التسبب في إخلاء الديدان المعوية الطفيلية)",
 "むしけら": "شَخْص دَنِيء (سواد الإنسان حين يرى من بعيد فلا يُعرَف؛ واحد الإنسان بصورة عامة بدون تحديد لسنه وجنسه وقومه وغير ذلك)\nمثال: هذا الشخص فنان.",
 "むしこうごう": "زمن سحيق, قديم الزمان (الماضي البعيد وراء الذاكرة)",
 "むしこぶ": "صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / صفراء, عصارة صفراوية (عصارة هضمية يفرزها الكبد وتخزن في المرارة؛ تساعد في هضم الدهون) / استياء, حقد (شعور بالغضب العميق والمرارة وسوء النية) / عفصة (تورم غير طبيعي في أنسجة النبات ناتج عن الحشرات أو الكائنات الحية الدقيقة أو الإصابة)",
 "むしさされ": "لدغة, لسعة (جرح مؤلم ناتج عن غرز حشرة لإبرتها في الجلد)",
 "むしなべ": "بَاخِرَة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار) / قِدْر بُخَارِيّ (قضاء الله وحكمه وما قَدَّرَه؛ مبلغ الشيء وكميتّه، بنفس معنى قَدْر) / بَاخِرَة, سَفِينَة بُخَارِيَّة (الشيء الذي يَبْخُر؛ سَفِينَة ضخمة تسير بالبُخَار)\nمثال: الباخرة الآن في الميناء.",
 "むしに": "سلق, غلي (الطهي في سائل تم غليه)",
 "むしのいい": "أَنَانِيّ",
 "むしのいどころがわるい": "سَرِيع التَّأَفُّف, عَصَبِيّ (يتهيج أو ينزعج بسهولة) / سَرِيع الاسْتِثَارَة, قَابِل لِلتَّهَيُّج (قادر على الاستجابة للمحفّزات) / شَدِيد التَّهَيُّج (حسّاس بشكل غير طبيعي لمؤثّر ما)",
 "むしのしらせ": "توجس, نذير شؤم (فأل غير مواتٍ) / بشيرة سوء, نذير شؤم (شعور بقدوم شر)\nمثال: شعور متزايد بنذير شؤم",
 "むしのよい": "أَنَانِيّ",
 "むしば": "تسوس, تسوس الأسنان (منطقة لينة متآكلة في السن؛ ويمكن أن يؤدي التسوس التدريجي إلى موت السن)",
 "むしばむ": "أَفْسَدَ / دَلَّلَ, غَنَّجَ (دلل: أَدَلَّ عَلَيْهِ وتَدَلَّلَ: انْبَسَطَ؛ قالَ ابْنُ دُرَيْدٍ: أَدَلَّ عَلَيْهِ وَثِق بِمَحَبَّتِهِ فأَفْرَط عَلَيْهِ) / فَسَدَ, نَتِنَ\nمثال: دلل سامي صديقته.",
 "むしひきあぶ": "ذبابة سارقة (ذبابة مفترسة سريعة لها جسم قوي يشبه النحلة مع خرطوم صلب لامتصاص عصارة الحشرات الأخرى التي يتم اصطيادها أثناء الطيران)",
 "むしぶろ": "حمام بخار, حمام تركي (التعرق في غرفة بخار قبل الحصول على تدليك ودش بارد) / حمام بخار, غرفة بخار (غرفة يمكن ملؤها بالبخار يستحم فيها الناس)",
 "むしぶんれつ": "انقسام مباشر, لا تفتلي (الطريقة المباشرة لانقسام الخلية التي تتميز بالانقسام البسيط للنواة دون تكوين كروموسومات)",
 "むしぼう": "خالٍ من الدسم, منزوع الدسم (بدون دهون أو مواد صلبة دهنية)\nمثال: حليب خالٍ من الدسم",
 "むしぼうぎゅうにゅう": "حَلِيب خَالِي الدَسَم (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "むしぼうにゅう": "حَلِيب خَالِي الدَسَم (هو اللَبَن المَحْلُوْب، أو ما لم يتغير طعمه. أصل التسمية؛ هو ما لم يَرُوْب واللَبَن هو ما رَابَ)\nمثال: كنت أشرب الحليب",
 "むしむし": "حَارّ وَرَطْب, خَانِق (حارّ أو دافئ ورطب بشكل مزعج)",
 "むしむしゅう": "أبدية, بقاء (خاصية الاستمرار إلى الأبد)",
 "むしむじゅう": "أبدية, بقاء (خاصية الاستمرار إلى الأبد)",
 "むしむよく": "إِيثَار, غَيْرِيَّة",
 "むしめがね": "عَدَسَةٌ مُكَبِّرَة",
 "むしゃ": "مُحَارِب, مُقَاتِل",
 "むしゃくしゃ": "زَعْلَان / أَشْعَث",
 "むしゃしゅぎょう": "دُونْكِيشُوتِيَّة, فُرُوسِيَّة مُتَجَوِّلَة (سلوك دونكيشوتي (رومانسي وغير عملي)) / فروسية جوالة ((العصور الوسطى) قواعد السلوك التي يراعيها الفارس الجوال الذي يتجول بحثاً عن مآثر الفروسية)",
 "むしゃぶり": "براعة, فن (مهارة فائقة يمكنك تعلمها بالدراسة والممارسة والملاحظة)\nمثال: فن المحادثة",
 "むしゃぶりつく": "إمساك, قبضة (فعل الإمساك) / دبرياج, قابض (قارنة تربط أو تفصل الأجزاء الدافعة والمدفوعة لآلية القيادة) / دواسة الدبرياج, دواسة القابض (دواسة أو رافعة تعشق أو تفصل عمود الدوران وآلية القيادة) / حقيبة يد صغيرة, كلاتش (حقيبة نسائية بدون حمالات تُحمل في اليد)\nمثال: أرخى قبضته عن ذراعي",
 "むしゃむしゃ": "قضم, مضغ (قضمة كبيرة)\nمثال: حاول التحدث بين قضمات الشطيرة / أَشْعَث",
 "むしゅ": "سَائِب, غَيْر مَمْلُوك (ليس لديه مالك)",
 "むしゅう": "عديم الرائحة (ليس له رائحة)\nمثال: غاز عديم الرائحة / ديمومة, لا نهائية (خاصية كونه (أو يبدو أنه) بلا نهاية)",
 "むしゅうきょう": "لَادِينِيَّة",
 "むしゅうせい": "غَيْر مُغَيَّر (باقٍ في حالة أصلية)\nمثال: استمر غير متغير عبر الزمن",
 "むしゅく": "تشرد (حالة أو وضع عدم امتلاك منزل (خاصة حالة العيش في الشوارع))",
 "むしゅくもの": "بِلا مَأْوَى, مُشَرَّد (شخص سيء الحظ بدون سكن)\nمثال: عُثر على مشرد مقتولاً في سنترال بارك",
 "むしゅみ": "رَتِيب, مُمِلّ (مكرّر بشكل مملّ أو يفتقر إلى التنوّع) / رَتِيب, عَادِيّ (غير مُلهِم ولا يُشكِّل تحدياً؛ باهت وخالٍ من الإثارة) / رَتَابَة, مَلَل (صفة الثبات المرهق والروتين ونقص التنوع)\nمثال: لم يعتد أبداً على رتابة عمله / عديم الذوق, مبتذل (يفتقر إلى الذوق الجمالي أو الاجتماعي) / عديم النكهة, لا طعم له (يفتقر إلى النكهة)",
 "むしょ": "سِجْن (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "むしょう": "حُرّ (ضد البَرْد) / شَاغِر, فَاضٍ / بِغَيْرِ, بِدُونِ / مَجَّانًا / حَرَّرَ (يُصَغَّرُ عَلَى حُرَيْحٍ وَيُجْمَعُ عَلَى أَحْرَاحٍ؛ ضد الْعَبْدِ)\nمثال: أنا حر كالطائر.",
 "むしょうこう": "دون السريري (متعلق بمرحلة تطور المرض قبل ظهور الأعراض)",
 "むしょうこうい": "مُتَطَوِّع, مُتَطَوِّعَة / مُتَطَوِّع",
 "むしょうじょう": "دون السريري (متعلق بمرحلة تطور المرض قبل ظهور الأعراض)",
 "むしょうに": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً) / بشدة, مكثفاً (إلى درجة عالية؛ بتركيز عال)\nمثال: شعروا بالخسارة بعمق",
 "むしょく": "مُتَبَطِّل, مُتَبَطِّلَة / بَاهِت, عَدِيم اللَّوْن (ضعيف في اللون؛ غير زاهي الألوان) / بَاهِت, مُمِلّ (يفتقر إلى التنوع والاهتمام)\nمثال: شخص باهت وغير خيالي / مُحَايِد / نُقْطَة الْعَطَالَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه.",
 "むしょくしゃ": "عاطل عن العمل (شخص بلا وظيفة)",
 "むしょくよく": "قَهَم",
 "むしょぞく": "مُسْتَقِل, حُرّ (اسم فاعل مِن اِسْتَقَلَّ؛ من لا يعتمد على غيره)\nمثال: الجزائر مستقلة الآن.",
 "むしょめい": "غير موقع (يفتقر إلى التوقيع)\nمثال: الرسالة كانت مطبوعة وغير موقعة",
 "むしよけ": "مبيد حشري (مادة كيميائية تستخدم لقتل الحشرات)",
 "むしりょ": "طيش, عدم اكتراث (سمة عدم التفكير بعناية قبل التصرف) / اسْتِهْتَار, طَيْش (صفة الفشل في مراعاة شعور الآخرين)",
 "むしる": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ الزّهرةَ: قطعها، قَطَفَ الثّمرَ: جناه وجمعه)\nمثال: أحب قطف الورود.",
 "むしろ": "بِالْأَحْرَى\nمثال: 今日はむしろ外出したくない。 — أفضل ألا أخرج اليوم. / مَقْعَد, مَقْعَدَة (كل ما يُقْعَدُ ويُجْلَسُ عليه؛ مَكَان القُعُود)\nمثال: نام ياني على مقعد.",
 "むしん": "بَرَاءَة / فصل, فك الارتباط (عملية التحرير من مرفق أو اتصال) / انفصال, تفكك (التفرق أو الانقسام) / انسحاب, تجرد (تجنب التورط العاطفي) / مفرزة (وحدة صغيرة من القوات ذات تكوين خاص) / بِلَا شُعُور, جَامِد (خالٍ من الشعور والوعي والحيوية)\nمثال: حجر جامد / مُزْعِج, مُضَايِق (يسبب الانزعاج أو الضيق) / لَادِينِيَّة",
 "むしんけい": "غير حساس, متبلد الحس (غير مستجيب للمحفزات الجسدية) / عديم الإحساس, غليظ (يفتقر إلى المشاعر الإنسانية؛ غير حساس عقليًا أو أخلاقيًا)\nمثال: غير حساس للإشعاع",
 "むしんこう": "لَادِينِيَّة",
 "むしんさ": "غَيْر مُجَرَّب, غَيْر مُخْتَبَر (لم يُخْتَبَر أو يُجَرَّب بالتجربة العملية) / غَيْر مُجَرَّب, غَيْر مُخْتَبَر (لم يُثبَت أو يُخضَع للاختبار بعد)",
 "むしんじゃ": "مُلْحِد, مُلْحِدَة",
 "むしんじん": "لَادِينِيَّة",
 "むしんろん": "إِلْحَاد / زَنْدَقَة",
 "むしんろんしゃ": "مُلْحِد, مُلْحِدَة",
 "むしコブ": "صفاقة, وقاحة (سمة كون المرء وقحاً وسليطاً؛ يميل لأخذ حريات غير مستحقة) / صفراء, عصارة صفراوية (عصارة هضمية يفرزها الكبد وتخزن في المرارة؛ تساعد في هضم الدهون) / استياء, حقد (شعور بالغضب العميق والمرارة وسوء النية) / عفصة (تورم غير طبيعي في أنسجة النبات ناتج عن الحشرات أو الكائنات الحية الدقيقة أو الإصابة)",
 "むしピン": "دَبُّوس",
 "むしメガネ": "عَدَسَةٌ مُكَبِّرَة",
 "むし暑い": "رَطْب, رَطِب (يحتوي على الماء أو الرطوبة، غير جاف؛ لين أو طري الملمس بسبب وجود الرطوبة)\nمثال: ملابسي رطبة ومليئة في التراب علي تبديلها.",
 "むし歯": "تسوس, تسوس الأسنان (منطقة لينة متآكلة في السن؛ ويمكن أن يؤدي التسوس التدريجي إلى موت السن)",
 "むじ": "بَسِيط / سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل.",
 "むじかく": "غَافِل, غَيْر مُدْرِك ((غالباً يتبعه 'بـ') غير مدرك)\nمثال: بدا غافلاً عن التدقيق",
 "むじき": "تعذر البلع, لا بلع (فقدان القدرة على البلع)",
 "むじつ": "بَرَاءَة / لَا جَوْهَرِيَّة, وَهْن (الافتقار إلى الجوهر أو الواقع) / انعدام الجوهر, وهمية (نقص الجوهر الصلب والقوة) / رياء, زيف (صفة عدم الصراحة أو الصدق؛ الخداع أو النفاق)",
 "むじな": "غُرَيْر / كلب الراكون (كلب بري صغير من شرق آسيا له علامات وجه تشبه علامات الراكون)",
 "むじなも": "الدرواندة, نبات طاحونة الماء (نبات مائي آكل للحوم معمر وطافٍ من وسط وجنوب أوروبا وإفريقيا وآسيا وأستراليا، له دوارات من 6 إلى 9 أوراق تنتهي بفصوص مفصلية لاصطياد براغيث الماء مثلاً)",
 "むじひ": "عديم الرحمة, قاسٍ (ليس لديه أو لا يظهر أي رحمة)\nمثال: العدو عديم الرحمة",
 "むじゃき": "بَرِيء, بَرِيئَة / بَرِيء / بَرِيء, شَفَّاف (خالٍ من المكر والخداع) / غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين) / أرعن, طائش (يظهر نقصًا في التفكير المتأني)\nمثال: تحول النقاش إلى مشاحنات طائشة",
 "むじゅう": "ديمومة, لا نهائية (خاصية كونه (أو يبدو أنه) بلا نهاية)",
 "むじゅうりょう": "انعدام الوزن, خفة (خاصية كون الشيء صغير الوزن نسبياً)\nمثال: خفة خشب البالسا",
 "むじゅうりょく": "انعدام الوزن, خفة (خاصية كون الشيء صغير الوزن نسبياً)\nمثال: خفة خشب البالسا",
 "むじゅうりょくじょうたい": "انعدام الوزن, خفة (خاصية كون الشيء صغير الوزن نسبياً)\nمثال: خفة خشب البالسا",
 "むじゅん": "تَنَاقُضٌ\nمثال: それは矛盾だらけだ。 — انها مجموعة من التناقضات",
 "むじゅんごほう": "أوكسيمورون, تضاد ظاهري (الجمع بين مصطلحات متناقضة)",
 "むじゅんせい": "تَنَاقُضٌ",
 "むじゅんどうちゃく": "تناقض ذاتي (مناقضة النفس)",
 "むじょう": "أَعْلَى, سَيِّد (الأَعْظَم مَكَانَةً أَوْ سُلْطَةً أَوْ قُوَّةً) / أَسْمَى, سَامٍ (في أعلى درجة أو أقصاها؛ بالغ الشدة) / أَسْمَى, أَعْلَى (نهائي أو أخير في الحياة أو مسيرة التقدم) / أَسْمَى, أَعْلَى (الأعلى في التميز أو الإنجاز) / زوال, عدم الدوام (خاصية عدم الوجود لمدد طويلة غير محددة) / قَابِل لِلطَّفْرَة (يميل إلى الخضوع لطفرة جينيّة) / قَابِل لِلتَّحَوُّل, مُتَغَيِّر (قادر على أو يميل إلى التغيير في الشكل أو الجودة أو الطبيعة) / غَيْرُ ثَابِتٍ, مُتَحَوِّل (مَيَّالٌ إِلَى التَّغَيُّرِ المُتَكَرِّرِ؛ غَيْرُ ثَابِتٍ)\nمثال: مادة قابلة للتحول / غلظة, قسوة القلب (غياب الاهتمام برفاهية الآخرين) / بِلَا شُعُور, جَامِد (خالٍ من الشعور والوعي والحيوية)\nمثال: حجر جامد",
 "むじょうけん": "غَيْر مَشْرُوط (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "むじょうけんこうふく": "استسلام غير مشروط",
 "むじょうけんはんしゃ": "رد فعل منعكس, منعكس (رد فعل تلقائي غريزي غير متعلم لمحفز)",
 "むじょうめいほう": "أَمْر مُطْلَق, وَاجِب قَطْعِيّ (المبدأ الأخلاقي القائل بأن السلوك يجب أن يتحدد بالواجب)",
 "むじるし": "غير معنون, غير موسوم (يفتقر إلى ملصق أو وسم)\nمثال: الأمتعة غير المعنونة معرضة للضياع",
 "むじん": "غير مأهول, مُسير عن بعد (يفتقر إلى طاقم)\nمثال: قمر صناعي غير مأهول إلى المريخ / ديمومة, عدم القابلية للنفاذ (حالة أو شرط استحالة الاستنفاد أو النفاذ؛ كون الشيء غير محدود)\nمثال: يجب على الاقتصاديين التصالح مع عدم قابلية المعرفة للنفاذ، وحقيقة أن استخدام المعرفة لا يستنزفها",
 "むじんがいしゃ": "دعم لوجستي دولي, عون متبادل (ترتيبات بين الدول لمساعدة بعضها البعض)",
 "むじんき": "يَعْسُوب, يَمْخُور / مُسَيَّرَة, طَائِرَة بِدُونِ طَيَّار",
 "むじんこうくうき": "يَعْسُوب, يَمْخُور / مُسَيَّرَة, طَائِرَة بِدُونِ طَيَّار",
 "むじんしつ": "غرفة معقمة, غرفة نظيفة (غرفة خالية تقريباً من الغبار أو البكتيريا؛ تستخدم في العمل المخبري وفي تجميع أو إصلاح المعدات الدقيقة)",
 "むじんはんばいじょ": "آلَة بَيْع, آلَة بَيْع ذَاتِيّ (الفارسية: ماشين؛ الأوردية: مشين)\nمثال: نسى زيري الآلة.",
 "むじんばくげきき": "يَعْسُوب, يَمْخُور / مُسَيَّرَة, طَائِرَة بِدُونِ طَيَّار",
 "むじんひこうき": "يَعْسُوب, يَمْخُور / مُسَيَّرَة, طَائِرَة بِدُونِ طَيَّار",
 "むす": "بُخَار (كلُّ رَائِحَةٍ سَطَعَتْ مِنْ نَتْنٍ أَو غَيْرِهِ؛ كل مَا يصعد كالدخان من السوائل الحارة والرائحة)\nمثال: السحابة هي كتلة بخار في السماء. / نَمَى / كَبُرَ (قَوْلُ 'الله أكْبَر'؛ أَحَدَ أَرْكَان الصَلاَة: كَبَّرَ المُصَلِّي)\nمثال: ما مدى كبر المسافة بين هنا وهناك؟",
 "むすい": "لامائي (بدون ماء؛ خاصة بدون ماء التبلور) / جَدْب, قَاحِل (يفتقر إلى ما يكفي من الماء أو الأمطار)",
 "むすいあひさん": "ثلاثي أكسيد الزرنيخ, زرنيخ (مسحوق أبيض سام من ثلاثي أكسيد الزرنيخ؛ يستخدم في صناعة الزجاج وكمبيد للآفات (سم الفئران) ومبيد للأعشاب)",
 "むすいあヒさん": "ثلاثي أكسيد الزرنيخ, زرنيخ (مسحوق أبيض سام من ثلاثي أكسيد الزرنيخ؛ يستخدم في صناعة الزجاج وكمبيد للآفات (سم الفئران) ومبيد للأعشاب)",
 "むすいけいさん": "ثاني أكسيد السيليكون, سيليكا",
 "むすいさくさん": "أنهيدريد الأسيتيك (مركب ضروري لتكرير الأفيون وتحويله إلى هيروين)",
 "むすいぶつ": "أنهيدريد (مركب يتكون من مركب آخر أو أكثر في تفاعل يؤدي إلى إزالة الماء)",
 "むすいアルコール": "كحول مطلق (كحول إيثيلي نقي (يحتوي على ما لا يزيد عن 1% ماء))",
 "むすいフタルさん": "أنهيدريد الفثاليك (أنهيدريد حلقي أبيض)",
 "むすう": "لَا يُحْصَى, لَا يُعَدّ (أَكْثَر مِنْ أَنْ يُحْصَى أَوْ يُعَدّ)",
 "むすこ": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير. / قَضِيب, ذَكَر",
 "むすこさん": "اِبْن (الولد الذكر)\nمثال: هو له ابن صغير.",
 "むすっと": "بِتَجَهُّم, بِعُبُوس (بطريقة عابسة)\nمثال: جلس على كرسيه بتجهم",
 "むすひのかみ": "خَالِق (الخالق : اسم من أسماء الله الحسنى ، ومعناه : الذي يُخرج من العدم إلى الوجود ، ويصنِّف المُبدَعات…؛ خَالِقُ الْكَوْنِ : مُنْشِؤُهُ ، مُكَوِّنُهُ ، اللهُ سُبْحَانَهُ) / مُبْدِع\nمثال: القرآن منزل من الخالق.",
 "むすび": "إنهاء, خاتمة (فعل إنهاء شيء ما) / خاتمة, نهاية (نهاية الكلمة (لاحقة أو نهاية تصريفية أو مورفيم نهائي)) / خاتمة, نهاية (القسم الأخير من اتصال ما) / إنهاء, ختام (حدث ينهي وقوعه شيئاً ما)\nمثال: إنهاء الاتفاقية / وَصَلَ (ضَمَّ وَلَأَمَ. (مصدره وَصْل وصِلَة)؛ بَلَغَ الشيءَ، أَدْرَكَه. (يتعدى بإلى) (مصدره وُصُول)) / اِتَّصَلَ / اِلْتَحَقَ بِـ, اِنْضَمَّ إِلَى\nمثال: وصل السيد باكر. / عُقْدَة / عَقَدَ (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد. / أُونِيجِيرِي",
 "むすびあわす": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل.",
 "むすびあわせる": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل.",
 "むすびいと": "عُقْدَة / عَقَدَ (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)",
 "むすびつき": "صِلَة, صُلَة / عَلَاقَة, صِلَة",
 "むすびつける": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل. / رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
 "むすびのかみ": "كْيُوبِيد / خَالِق (الخالق : اسم من أسماء الله الحسنى ، ومعناه : الذي يُخرج من العدم إلى الوجود ، ويصنِّف المُبدَعات…؛ خَالِقُ الْكَوْنِ : مُنْشِؤُهُ ، مُكَوِّنُهُ ، اللهُ سُبْحَانَهُ) / مُبْدِع\nمثال: القرآن منزل من الخالق.",
 "むすびめ": "عُقْدَة / عَقَدَ (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "むすぶ": "تَعَادُل (تَسَاوَى؛ تَمَاثَلَ) / رَبَطَ, أَسَرَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: انتهت المباراة بالتعادل. / دُبّ / دُبَّة / اِحْتَمَلَ / أَغْلَقَ, سَكَّر (ضد فَتَحَ؛ سَدَّ وسَكَّرَ؛ قد تستخدم بمعنى أَقْفَلَ؛ أغلقه بحيث لا يفتح إلا بمفتاح) / قَرِيب\nمثال: أغلق الباب بغضب / رَبَطَ (رَبَطَ الشيءَ يَرَبُطَ رَبْطًا: شَدَّهُ. فهو مربوط، ورَبيط؛ يقال: رَبَطَ نفسَه عن كذا: منعها)\nمثال: ربط يديه و قدميه.",
 "むすぶびん": "رحلة ترانزيت, رحلة مواصلة (رحلة مع توقف وسيط وتغيير الطائرة (وربما تغيير شركة الطيران))",
 "むすめ": "اِبْنَة, بِنْت / بِنْت / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة) / طِفْلة / بنت / فتاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "むすめご": "اِبْنَة, بِنْت",
 "むすめさいぼう": "خلية ابنة, خلية وليدة (خلية تتكون عن طريق انقسام أو تبرعم خلية أخرى)\nمثال: تنمو الجمرة الخبيثة عن طريق الانقسام إلى خليتين وليدتين متطابقتين عموماً",
 "むすめさん": "اِبْنَة, بِنْت",
 "むすめざかり": "ريعان الشباب, زهرة الشباب (أفضل أوقات الشباب)",
 "むすめっこ": "بِنْت / فَتَاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة) / طِفْلة / بنت / فتاة (شابَّة في رَيْعان الصِّبا؛ جارية حدثة)\nمثال: أنا أري الفتاة.",
 "むすめむこ": "زَوْج اَلاِبْنَة, صِهْر (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً، وبها: جعله يتزوَجَها)\nمثال: زوجة ماري طبيبة.",
 "むず": "إرَادَة / رَغْبَة, إرَادَة / تَعَمَّدَ, نَوَى / يَنْبَغِي أَنْ / مِنْ اَلْمَفْرُوض أَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية) / مِنْ اَلْمُفْتَرَض أَنْ (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة!",
 "むずい": "صَعْب",
 "むずかしい": "صَعْب / مُسْتَحِيل / دَقِيق, مُتَطَلِّب (شَدِيد التَّدْقِيق خَاصَّةً فِي التَّفَاصِيل) / عَبُوس, مُتَذَمِّر (مُنزعج وسريع الانفعال) / مُزْدَحِم بِالتَّفَاصِيل (مكتظّ بالتفاصيل والزخارف بشكل مفرط) / كَئِيب, مُوحِش",
 "むずかしいかおをする": "عُبُوسة, عُبُوس / عَبَسَ, عَقَدَ حَاجِبَيْهُ",
 "むずかしげ": "صَعْب",
 "むずかしさ": "صُعُوبَة",
 "むずかしや": "سيء المزاج, عبوس (شخص سيء الطباع)",
 "むずかし屋": "سيء المزاج, عبوس (شخص سيء الطباع)",
 "むずかる": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة عند الضغط على الوتر) / تعشيق هندسي, مفتاح إغريقي (نمط زخرفي يتكون من خطوط عمودية وأفقية متكررة (غالباً بشكل بارز)) / موضع تآكل (بقعة تآكلت بفعل الاحتكاك أو التعرية) / غمة, قلق (هياج ناتج عن قلق نشط)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران",
 "むずがゆい": "مُثِيرٌ لِلْحَكَّة, مُحِكّ (يُسَبِّبُ إِحْسَاسًا جِلْدِيًّا بِالحَكَّة) / قَلِق, مُتَمَلْمِل (عَصَبِيٌّ وَغَيْرُ قَادِرٍ عَلَى الاسْتِرْخَاء) / مخيف",
 "むずがる": "دستان, عتبة (قضيب صغير من المعدن عبر لوحة أصابع الآلة الموسيقية؛ لإنتاج نغمة ذات حدة مطلوبة عند الضغط على الوتر) / تعشيق هندسي, مفتاح إغريقي (نمط زخرفي يتكون من خطوط عمودية وأفقية متكررة (غالباً بشكل بارز)) / موضع تآكل (بقعة تآكلت بفعل الاحتكاك أو التعرية) / غمة, قلق (هياج ناتج عن قلق نشط)\nمثال: كان هناك تعشيق هندسي بسيط في أعلى الجدران",
 "むずつく": "حِكَّة / أَحَكَّ (أَحَكَّ (فلانًا جسمَه): حكَّه؛ ويقال: أَحَكَّ الأمرَ في صدره: حكَّه)",
 "むずと": "بشدة, بقوة (بقوة أو بطريقة قوية) / بشدة, بقوة (بطريقة قوية)\nمثال: يجادل بقوة لاقتراحه",
 "むずむず": "حِكَّة / أَحَكَّ (أَحَكَّ (فلانًا جسمَه): حكَّه؛ ويقال: أَحَكَّ الأمرَ في صدره: حكَّه)",
 "むず痒い": "مُثِيرٌ لِلْحَكَّة, مُحِكّ (يُسَبِّبُ إِحْسَاسًا جِلْدِيًّا بِالحَكَّة) / قَلِق, مُتَمَلْمِل (عَصَبِيٌّ وَغَيْرُ قَادِرٍ عَلَى الاسْتِرْخَاء) / مخيف",
 "むせい": "احتلام (حلم جنسي (عادة في الليل) مصحوب بقذف (ليلي) للمني) / صَمْت, سُكُوت / صَمَّتَ / صَمْتًا!, صَهٍ! / افْتِقَار لِلصَّوْت, تَهْمِيش (عدم وجود صوت أو رأي في إدارة أو السيطرة على الشؤون) / همس, وشوشة (التحدث بنعومة دون اهتزاز الحبال الصوتية) / بحة, خرس (اضطراب في أعضاء الصوت يؤدي إلى فقدان الصوت) / لاجهرية, همسية / بِلَا جَاذِبِيَّة جِنْسِيَّة (غير جذّاب جنسيًّا) / عَدِيم الرَّغْبَة الجِنْسِيَّة (لا يشعر بأيّ رغبة جنسية) / خُنْثَوِيّ, عَقِيم (بلا أعضاء جنسية أو ذو أعضاء ناقصة النموّ أو غير فاعلة) / لَاجِنْسِيّ, لَاجِنْسِيَّة / لاجِنْسِيّ / لاجنسي",
 "むせいあい": "لَاجِنْسِيَّة",
 "むせいえいが": "سِينِمَا صَامِتَة (مصطلح يشير إلى التصوير المتحرك الذي يعرض للجمهور و يعتبر التصوير السينمائي من توابعه التمثيل و الإخراج و الإنتاج و كل مايتعلق بذلك و يعتبر من الفنون…؛ فن إنتاج و إخراج الأفلام التي تعرض على الشاشة التلفاز أمام المشاهدين و يطلق عليه الفن السابع أو التصوير السينمائي)\nمثال: كان في السينما.",
 "むせいが": "برعم تكاثري, جيمة (بنية تكاثرية لا جنسية صغيرة في حشيشة الكبد والحزازيات تنفصل عن الأصل وتتطور إلى فرد جديد)",
 "むせいげん": "لَا يَنْضَب, لَا يُسْتَنْفَد (لَا يُمْكِنُ اسْتِهْلَاكُهُ أَوِ اسْتِنْفَادُهُ بِالكَامِلِ) / بلا حدود, غير محدود (ليس له حدود في المدى أو النطاق) / صَرِيح, مُطْلَق (بلا تحفّظ أو استثناء)\nمثال: البدء بنظرية الحرية غير المحدودة هو الانتهاء باستبداد غير محدود",
 "むせいしいん": "صوت مهموس (صامت يُنتج بدون صوت من الحبال الصوتية)",
 "むせいせいしょく": "تَكَاثُر لَاجِنْسِيّ",
 "むせいはんしょく": "تَكَاثُر لَاجِنْسِيّ",
 "むせいふ": "فَوْضَى, فَوْضَوِيَّة",
 "むせいふきょうさんしゅぎ": "شيوعية لاسلطوية (نظرية لاسلطوية تدعو إلى إلغاء الدولة والرأسمالية والأجور والملكية الخاصة، وتؤيد الملكية المشتركة لوسائل الإنتاج والديمقراطية المباشرة)\nمثال: في الوقت نفسه، كان يتطور من اللاسلطوية الجماعية لباكونين إلى مذهب الشيوعية اللاسلطوية",
 "むせいふしほんしゅぎ": "لاسلطوية رأسمالية",
 "むせいふしゅぎ": "لَاسُلْطَوِيَّة",
 "むせいふしゅぎしゃ": "فَوْضَوِيّ, فَوْضَوِيَّة",
 "むせいふじょうたい": "فَوْضَى, فَوْضَوِيَّة",
 "むせかえる": "اِخْتَنَقَ / خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته.",
 "むせきついどうぶつ": "لَا فَقَارِيّ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر وجوبا إلا في الدعاء؛ نافية تدخل على الخَبَر أو الحَال أو الصِفَة المفردة، وجب تكرارها)\nمثال: لا أحب المدرسة.",
 "むせきにん": "اِنْعِدام مَسْؤُولِيَّة",
 "むせきもの": "تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر) / متشرد, هائم (متجول ليس لديه إقامة ثابتة أو وسيلة عيش ظاهرة)",
 "むせっそう": "عَدِيم المَبَادِئ (يفتقر إلى النزاهة أو المبادئ الأخلاقيَّة) / غير مبدئي, مجرد من المبادئ (يفتقر للمبادئ أو الوازع الأخلاقي)\nمثال: التحرر من الافتراء الفظ غير المبدئي",
 "むせっぽい": "خنق (فعل خنق (شخص ما) عن طريق الضغط على القصبة الهوائية) / خَنَّاق, كَاتِم لِلْأَنْفَاس (يُسَبِّب صُعُوبَة فِي التَّنَفُّس خَاصَّةً بِسَبَب نَقْص الهَوَاء النَّقِيّ) / اختناق, غصة (حالة ناتجة عن انسداد الممرات الهوائية المؤدية إلى الرئتين (كما هو الحال مع الطعام أو تورم الحنجرة))\nمثال: لا يوجد دليل على أن الخنق تم بواسطة المتهم",
 "むせびなき": "شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "むせびなく": "شهيق, شهقة / شَهِقَ (تنفس بصوت عالٍ وبشكل مفاجئ نتيجة التعب أو الخوف أو الضيق؛ في لغة الطيور: أصدرت صوتًا عاليًا يشبه الشهيق)",
 "むせび泣き": "شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "むせび泣く": "شهيق, شهقة / شَهِقَ (تنفس بصوت عالٍ وبشكل مفاجئ نتيجة التعب أو الخوف أو الضيق؛ في لغة الطيور: أصدرت صوتًا عاليًا يشبه الشهيق)",
 "むせる": "اِخْتَنَقَ / خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته.",
 "むせん": "رَادْيُو, رَادِيُو / لَاسِلْكِيّ",
 "むせんか": "عامل لاسلكي, مشغل راديو (شخص يقوم بتشغيل جهاز إرسال لاسلكي)",
 "むせんき": "رَادْيُو, رَادِيُو",
 "むせんきょく": "مَحَطَّة إِذَاعِيَّة",
 "むせんしゅうは": "تَرَدُّد رَادْيَوِيّ (تردد موجة كهرومغناطيسية بين الصوتية والأشعة تحت الحمراء)",
 "むせんしゅうはすう": "تَرَدُّد رَادْيَوِيّ (تردد موجة كهرومغناطيسية بين الصوتية والأشعة تحت الحمراء)",
 "むせんでんわ": "هاتف راديوي, هاتف لاسلكي (هاتف يتصل عبر موجات الراديو بدلاً من الكابلات) / راديو تليفون, هاتف لاسلكي (المهاتفة التي تستخدم الإرسال عن طريق الراديو بدلاً من الأسلاك)",
 "むせんひょうしき": "منارة لاسلكية (محطة إذاعية تبث إشارة توجيهية لأغراض الملاحة) / منارة لاسلكية (إشارة مميزة يبعثها جهاز إرسال يستخدم للملاحة)",
 "むせんラン": "شبكة محلية لاسلكية, واي فاي (شبكة محلية تستخدم إشارات راديو عالية التردد لإرسال واستقبال البيانات عبر مسافات تصل إلى بضع مئات من الأقدام؛ تستخدم بروتوكول إيثرنت)",
 "むせ返る": "اِخْتَنَقَ / خَنَقَ (خَنَقَ (خنقه) خنقا: عصر حلقه حتى مات؛ خَنَقَ الوقت: أخره وضيقه)\nمثال: خنق زيري وليد بعمامته.",
 "むぜい": "مُعْفًى مِنَ الرُّسُوم (مُعْفًى مِنَ الرُّسُومِ الجُمْرُكِيَّة)",
 "むぜいひん": "مُعْفًى مِنَ الرُّسُوم (مُعْفًى مِنَ الرُّسُومِ الجُمْرُكِيَّة)",
 "むぜん": "أَمْرَد",
 "むそ": "سِتِّين, سِتُّون",
 "むそう": "حُلْم, رُؤْيَا (رأى في نومه) / حُلْم, أَحْلام (رأى في نومه) / حَلَمَ (رأى في نومه)\nمثال: هذا الحلم سيتحقق. / لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "むそうか": "حَالِم / حَالِم, حَالِمَة",
 "むそくるい": "ضفدع ثعباني (أي من البرمائيات الصغيرة النحيلة عديمة الأطراف الحفارة التي تشبه الديدان؛ تعيش في التربة الرطبة في المناطق الاستوائية) / ضفدعي ثعباني (من أو متعلق بـ أو ينتمي إلى فصيلة الضفادع الثعبانية)",
 "むぞうさ": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل) / عَابِث, لَامُبَالٍ (يَتَّسِمُ بِعَدَمِ الِاكْتِرَاثِ وَالِاسْتِهْتَارِ) / بِلَا جُهْد, يَسِير (لَا يُظْهِر جُهْدًا أَوْ إِجْهَادًا) / عَادِيّ, يَوْمِيّ (مُنَاسِبٌ لِلْمُنَاسَبَاتِ العَادِيَّةِ أَوِ الرُّوتِينِيَّةِ)",
 "むたい": "غَيْر مَلْمُوس, مَعْنَوِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة) / غير معقول, غير منطقي (غير معقول؛ لا يظهر حكماً صائباً)",
 "むたいざいさんけん": "مِلْكِيَّة فِكْرِيَّة",
 "むたいしさん": "أصل غير ملموس, أصول معنوية (أصول قابلة للبيع وإن لم كانت مادية أو فيزيائية)",
 "むたいぶつ": "غَيْر مَلْمُوس, مَعْنَوِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "むたんぽ": "بِلَا ضَمَان, غَيْر مَضْمُون (بدون ضمان ماليّ) / غَيْر مُقْفَل, مَحْلُول (غير مثبّت أو مؤمّن بإحكام)",
 "むだ": "عَبَث, لَا طَائِل (عدم الجدوى كنتيجة لعدم وجود نتيجة عملية)",
 "むだい": "بِلَا لَقَب, غَيْر نَبِيل (لا ينتمي إلى طبقة النبلاء) / مَجَّانِيّ, مَجَّانًا",
 "むだぐち": "هَذَى",
 "むだごと": "هَذَى",
 "むだづかい": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "むだにする": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال) / قَفْر, مَهْجُور (في منطقة نائية وموحشة؛ خَرِبة) / إضرار بالمال, تبديد الممتلكات ((قانون) انخفاض في قيمة العقار ناتج عن فعل أو إهمال) / إتلاف, إهدار (سمة إهدار الموارد)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "むだのない": "اقْتِصَادِيّ, مُوَفِّر (يستخدم الحدّ الأدنى من الوقت أو الموارد اللازمة للفاعلية) / زَاهِد, مُقْتَصِد (يَتَجَنَّبُ الإِسْرَافَ وَالهَدْر) / اقتصادي (مكون من أو متعلق بالاقتصاد، نظام الإنتاج وإدارة الثروة المادية)\nمثال: نمو اقتصادي",
 "むだばなし": "ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة)",
 "むだめしぐい": "شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "むだめしぐらい": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة) / شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "むだん": "غَيْر مُدَرَّج, غَيْر مُرَتَّب (غير منظَّم ترتيباً هرميّاً) / مُتَوَاصِل, مُتَّصِل",
 "むだんかい": "مُتَوَاصِل, مُتَّصِل",
 "むだんきょじゅうしゃ": "محتل للمكان, واضع اليد (شخص يستقر في أرض أو مسكن دون حق أو سند قانوني) / مستوطن, واضع اليد (شخص يستقر بشكل قانوني على أرض حكومية بقصد الحصول على حق ملكيتها)",
 "むだんけっせき": "تَمَلُّص, هُرُوب مِن المَدْرَسَة (الفشل في الحضور (خاصة المدرسة))",
 "むだんしゃくよう": "اختلاس, سوء استخدام (استعارة غير مشروعة) / اختلاس, استيلاء (الاستيلاء الاحتيالي على أموال أو ممتلكات معهود بها لرعايتك ولكنها مملوكة فعلياً لشخص آخر)\nمثال: كان تفسيره سوء استخدام للنظرية الاجتماعية",
 "むだ話": "ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة)"
}
