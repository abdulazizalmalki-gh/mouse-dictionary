 "みんぞくおんがく": "مُوسِيقَى فُلْكْلُورِيَّة (مُوسِيقى، فنُّ تأليف الألحان وتوزيعها وإيقاعها والغناء والتطريب بضروب المعازف…)\nمثال: أتعلم الموسيقى. / فولك, موسيقى تراثية (الموسيقى التقليدية وعادة مجهولة المؤلف التي تعبر عن حياة الناس في مجتمع ما)",
 "みんぞくがく": "إِتْنُولُوجِيَة",
 "みんぞくがくしゃ": "إثنولوجي, عالم أعراق (عالم أنثروبولوجيا يدرس الإثنولوجيا (علم الأعراق))",
 "みんぞくきょうわこく": "الْجُمْهُورِيَّة الشَّعْبِيَّة",
 "みんぞくこっか": "دَوْلَة قَوْمِيَّة (بَلَد يتميز بحُدُود معروفة وشَعْب وحُكُومَة ومُؤَسَسَات مُنَظَّمَة؛ مجموعة من…)\nمثال: لبنان دولة صغيرة.",
 "みんぞくし": "عِلْم الإِنْسََان التَطْبِيقِيّ, إِثْنُوغْرَافِيَّا (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "みんぞくしがく": "عِلْم الإِنْسََان التَطْبِيقِيّ, إِثْنُوغْرَافِيَّا (أَدْرَكَ حقيقة الشيء)\nمثال: أدرس علم النفس.",
 "みんぞくしほん": "عاصمة وطنية (العاصمة لبلد ما)",
 "みんぞくしゃかいしゅぎ": "نَازِيَّة",
 "みんぞくしゅうだん": "مَجْمُوعَة إثْنِيَّة (مؤنث مَجْمُوع وهو اسم مفعول من جَمَعَ؛ الطَائِفَة أو الجَمَاعَة من الناس)\nمثال: شكرا لإضافتي للمجموعة.",
 "みんぞくしゅぎ": "قَوْمِيَّة (ما يجمع أمة ذات تاريخ وأمانٍ مشتركة)\nمثال: اللغة اليابانية لغتي القومية.",
 "みんぞくしゅぎしゃ": "قَوْمِيّ, قَوْمِيَّة",
 "みんぞくじけつ": "تَقْرِيرُ المَصِير",
 "みんぞくじょう": "عِرْقِيّ",
 "みんぞくじょうか": "تَطْهِير عِرْقِيّ (إِزالة التَلَوُّث؛ تَنْقية النَّفْس من الدَّنس)\nمثال: مهمتها هي متابعة أداء محطات التطهير.",
 "みんぞくてき": "عِرْقِيّ",
 "みんぞくとういつしゅぎ": "وَحْدَوِيّة",
 "みんぞくぶよう": "رَقْص شَعْبِيّ (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع…)\nمثال: كنت تجيد الرقص.",
 "みんだん": "حِكَايَة شَعْبِيَّة, فُولْكُلُور (حكاية تتداول شفهياً بين عامة الناس)",
 "みんちょう": "سلالة مينغ, مينغ (السلالة الإمبراطورية للصين من 1368 إلى 1644)",
 "みんちょうたい": "سلالة مينغ, مينغ (السلالة الإمبراطورية للصين من 1368 إلى 1644)",
 "みんど": "مُسْتَوَى اَلْمَعِيشَة",
 "みんな": "الْجَمِيع, كُلّ شَخْص / كُلّ شَيْء",
 "みんながみんな": "اَلْجَمِيع, كُلّ شَخْص",
 "みんなさん": "كُلّ, جَمِيع",
 "みんなみ": "جَنُوب (الْجِهَةُ الْمُقَابِلَةُ لِلشَّمَال؛ رِيحٌ تَهُبُّ مِنَ الْجَنُوب)\nمثال: لا بد أنه من الجنوب.",
 "みんぺい": "تَنْظِيم مُسَلَّح, جَمَاعَة مُسَلَّحَة",
 "みんぺいそしき": "تَنْظِيم مُسَلَّح, جَمَاعَة مُسَلَّحَة",
 "みんぽう": "قَانُون مَدَنِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "みんぽうてん": "قَانُون مَدَنِيّ (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "みんゆうか": "خَصْخَصَة, خَوْصَصَة",
 "みんよう": "أُغْنِيَّةٌ شَعْبِيَّة (الجمع : أُغْنِيَات و أغانٍ؛ الأُغنيَة المقتسمة : ( الموسيقى ) قطعة موسيقيَّة…)\nمثال: أنا أغني أغنية. / رَقْص شَعْبِيّ (حركة الجسم بتنسيق موسيقي أو لحن، حيث يتحرك الشخص بشكل إيقاعي أو متناسق مع…)\nمثال: كنت تجيد الرقص.",
 "みんろん": "رَأْي عَامّ",
 "みんわ": "حِكَايَة شَعْبِيَّة, فُولْكُلُور (حكاية تتداول شفهياً بين عامة الناس)",
 "みセク": "لَمْ ؛ حَتَّى الْآنَ, لَمْ ؛ بَعْدُ (جَمَعَ، ضَمَّ)\nمثال: لم يساعدني أحد.",
 "みチェック": "جَامِح, مُنْفَلِت (غير مكبوح أو غير مسيطَر عليه)",
 "みーちゃんはーちゃん": "مُتَّبِع لِلصَّرْعَات, مُقَلِّد لِلْمُوضَة (شخص يتبع مجموعة متنوعة من البدع أو الصرعات)",
 "みーはー": "مُتَّبِع لِلصَّرْعَات, مُقَلِّد لِلْمُوضَة (شخص يتبع مجموعة متنوعة من البدع أو الصرعات)",
 "み使い": "مَلَاك\nمثال: زيري ملك لنفسه.",
 "み子": "اِبْن اللَّٰه (الولد الذكر)\nمثال: هو له ابن صغير.",
 "み言葉": "كَلَام اللّٰهِ",
 "む": "سِتَّة\nمثال: 私は毎朝六時に起きます。 — أستيقظ في السادسة كل صباح. / لَا شَيْء (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة. / عَجَبًا\nمثال: سبحان الله عما يشركون. / بَلَى, مبلا (يفيد إبطال النفي؛ في : نَعَمْ في كل حالاتها عدا جواب النِدَاء في بعض لهجات…)\nمثال: هذه ليست جملة, بل مجموعة من الكلمات بلى معنى. / مِن اَلْمُحْتَمَل, رُبَّمَا (يفيد ابتداء الغاية؛ ابتداء الغاية المكانية)\nمثال: يا لها من جملة! / إرَادَة / وَدَّ (تمنى ورجا؛ أراد شيئا)\nمثال: السيدة وود طباخة جيدة.",
 "むい": "بطالة, تسكع (عدم القيام بعمل أو وظيفة)\nمثال: تم التعرف بسرعة على بطلان تقريرهم / انتفاء الخوف, جسارة (سمة عدم الشعور بالخوف)",
 "むいぎ": "بلا معنى, عبثي (ليس له معنى أو اتجاه أو غرض)\nمثال: مسعى بلا معنى",
 "むいし": "قسري, لا إرادي (غير خاضع لسيطرة الإرادة)\nمثال: قتل غير عمد (لا إرادي)",
 "むいしき": "فِقْدَان اَلْوَعْي, إِغْمَاء / فاقد الوعي, لاواعٍ (غير واعٍ؛ يفتقر إلى الوعي والقدرة على الإدراك الحسي كما لو كان نائماً أو ميتاً)\nمثال: مستلقٍ فاقداً للوعي على الأرض",
 "むいしきてき": "فاقد الوعي, لاواعٍ (غير واعٍ؛ يفتقر إلى الوعي والقدرة على الإدراك الحسي كما لو كان نائماً أو ميتاً)\nمثال: مستلقٍ فاقداً للوعي على الأرض",
 "むいちもん": "فقير",
 "むいぶりょう": "مَلَل, ضَجَر",
 "むいみ": "هُرَاء, لَغْو",
 "むいむりょう": "مَلَل, ضَجَر",
 "むいんし": "شعر مرسل (شعر غير مقفى (عادة في البحر الخماسي اليامبي))",
 "むう": "سِتَّة\nمثال: 私は毎朝六時に起きます。 — أستيقظ في السادسة كل صباح.",
 "むうっと": "بإصرار, بثبات (بتصميم حازم)\nمثال: صدقنا ذلك بحزم",
 "むえき": "عَدِيمُ الْفَائِدَةِ (عديم: فقير؛ عديم: أحمق، غبي)\nمثال: كن عديم الرحمة.",
 "むえん": "لا تربطه قرابة, ليس قريباً (غير متصل بقرابة) / غَيْرُ مُتَبَّل, غَيْرُ مُمَلَّح (بِدُونِ مِلْحٍ أَوْ تَوَابِل) / خالٍ من الرصاص (غير معالج بالرصاص)\nمثال: بنزين خالٍ من الرصاص / عَاجِز / بلا دخان, غير مدخن (ينبعث منه القليل من الدخان أو لا ينبعث منه على الإطلاق)\nمثال: مداخن مصانع بلا دخان",
 "むえんかやく": "بارود عديم الدخان, باليستيت (مادة متفجرة (الاسم التجاري باليستيت) تحترق بدخان قليل نسبيًا؛ تحتوي على…)",
 "むえんしょく": "حمية خالية من الملح, حمية قليلة الصوديوم (نظام غذائي يحد من تناول الملح (كلوريد الصوديوم)؛ يستخدم غالباً في علاج ارتفاع…)",
 "むえんたん": "أنتراسيت, فحم حجري صلب (فحم طبيعي صلب يحترق ببطء ويعطي حرارة شديدة)",
 "むえんぼち": "مقبرة الغرباء (مقبرة للأشخاص المجهولين أو المعوزين)",
 "むおん": "صَمْت, سُكُوت",
 "むか": "لَا يُقَدَّرُ بِثَمَن, نَفِيس (ذُو قِيمَةٍ مَادِّيَّةٍ أَوْ فِكْرِيَّةٍ أَوْ رُوحِيَّةٍ لَا تُحْصَى) / إبطال, إلغاء المفعول (فعل الإبطال؛ جعل الشيء لاغياً وباطلاً؛ أو تجاوز تأثير أو قوة شيء ما) / تحويل إلى ذرات, تذرية (الإفناء عن طريق تحويل الشيء إلى ذرات)",
 "むかい": "تبطين, تغليف (تزويد شيء بسطح من مادة مختلفة) / اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم.",
 "むかいあわせ": "وجهاً لوجه (في حضور بعضهما البعض)\nمثال: قابلت الرئيس وجهاً لوجه",
 "むかいあわせる": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه.",
 "むかいかぜ": "كَوْس, رِيَاح مُضَادَّة",
 "むかいなみ": "بحر معاكس (بحر تجري فيه الأمواج مباشرة عكس مسار السفينة)",
 "むかいび": "نتيجة عكسية (سوء تقدير يرتد على صاحبه)",
 "むかう": "وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه.",
 "むかうところてきなし": "لَا يُغْلَب, لَا يُقْهَر (لَا يُمْكِنُ هَزِيمَتُهُ أَوْ إِخْضَاعُهُ)",
 "むかうのさと": "طُوبَائِيَّة, مَدِينَةٌ فَاضِلَة",
 "むかえ": "اِجْتِمَاع, مَجْلِس (جمعوا انفسهم؛ اسم يطلق على عملية جَمْع بعض الناس في مكان واحد ليتباحثوا أمرا)\nمثال: هذا اجتماع مهم.",
 "むかえうつ": "وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: واجه سامي ليلى.",
 "むかえかく": "زاوية الهجوم (الزاوية الحادة بين اتجاه الرياح النسبية غير المضطربة ووتر الجنيح)",
 "むかえざけ": "ترياق الخمار, علاج الدوار (مشروب كحولي يعتقد أنه يعالج آثار الشرب السابق)",
 "むかえぬし": "مُحَافِظ",
 "むかえる": "اِسْتَقْبَلَ, اِسْتَلَمَ (المكان أو الجهة: وجّه وجهه نحوها؛ الضيف: خرج إليه وقابله وضيَّفَه)\nمثال: استقبل توم الضيوف. / دَعَا إِلَى (حَثَّ على قَصْدِ الشيء؛ طَلَبَ الشخصَ لتناول الطعام عنده، أو لحضور حفل ونحوه)\nمثال: دعا ثلاميذه الاثني عشر / قَبِلَ (وضع فمه على الشخص أو الشيء علامة الحب والاحترام. في العاميّة يُقال بَاسَ)\nمثال: كنت هنا من قبل. / بَلَغَ",
 "むかか": "تين, تين شائع (شجرة متوسطية تُزرع على نطاق واسع لثمارها الصالحة للأكل) / تِين, بَلَس",
 "むかく": "أَجْلَح",
 "むかくるい": "حَيَوَان عَنْكَبُوتِيّ (بمعنى أصبح له حياة؛ الحَيَاة. والحَيَوَان أبلغ من الحَيَاة؛ جنس الحَيّ الذي…)\nمثال: هذا حيوان أليف.",
 "むかし": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)\nمثال: و بعد قليل أتى.",
 "むかしかたぎ": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "むかしがたり": "استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني))\nمثال: لديه استدعاء كامل للحلقة",
 "むかししき": "أولد فاشن (كوكتيل مصنوع من الويسكي والبيترز والسكر مع شرائح الفاكهة)",
 "むかしつ": "تنزه عن الخطأ, عصمة (صفة الإعفاء من الخطيئة أو عدم القدرة على ارتكابها)",
 "むかしとかげ": "تواتارا (العضو الوحيد الباقي من رتبة منقاريات الرأس من الزواحف الكبيرة الشائكة الشبيهة…)",
 "むかしながら": "غَيْر مُغَيَّر (باقٍ في حالة أصلية)\nمثال: استمر غير متغير عبر الزمن",
 "むかしにんげん": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "むかしばなし": "حِكَايَة شَعْبِيَّة, فُولْكُلُور (حكاية تتداول شفهياً بين عامة الناس) / استدعاء, تذكر (عملية التذكر (وخاصة عملية استعادة المعلومات بجهد ذهني))\nمثال: لديه استدعاء كامل للحلقة",
 "むかしびと": "الأسلاف, قدماء (الناس الذين عاشوا في أزمنة غابرة (خاصة خلال الفترة التاريخية قبل سقوط…)",
 "むかしふう": "عَفَا عَلَيْه الزَّمَن, قَدِيم الطِّرَاز (خَارِج المُوضَة وَلَمْ يَعُدْ رَائِجًا)",
 "むかしむかし": "قَدِيماً",
 "むかしむかしあるところに": "كَان يَامَا كَان (اِتَّصَفَ. (فعل ناقص)؛ حَدَثَ)\nمثال: كان الكلب ميتا.",
 "むかしもの": "عجوز, كبير السن (شخص متقدم في السن)",
 "むかち": "انْعِدَام القِيمَة, لَا جَدْوَى (عدم امتلاك أي صفات تجعل الشيء قيماً أو مفيداً)\nمثال: كان هدف رقيب التدريب إقناع المجندين بانعدام قيمتهم",
 "むかっぱら": "غَضَب",
 "むかっ腹": "غَضَب",
 "むかばら": "غَضَب",
 "むかりゅうきゅうしょう": "ندرة المحببات (اضطراب دموي حاد يتميز بانخفاض حاد في الخلايا المحببة)",
 "むかん": "بلا تاج, غير متوج (غير مزود (خاصة ليس بعد) بتاج)\nمثال: الملك غير المتوج",
 "むかんかく": "خَدِر (استتر؛ خدر بالمكان: أقام)\nمثال: خفف زيري السرعة. / لَا مُبَالٍ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "むかんがえ": "غَافِل, لَامُبَالٍ (بلا اكتراث أو اهتمام بالآخرين)\nمثال: تحول النقاش إلى مشاحنات طائشة",
 "むかんきゃく": "خلف الأبواب المغلقة (بَدَلَ، أَعْقَبَ؛ أَتَى بعده أو جاء مكانه)\nمثال: دار زيري للخلف.",
 "むかんけい": "لا تربطه قرابة, ليس قريباً (غير متصل بقرابة)",
 "むかんしょう": "عدم التدخل (سياسة خارجية للبقاء خارج نزاعات الدول الأخرى) / انحباس العرق, لا تعرق (فشل الغدد العرقية في العمل)",
 "むかんしん": "لَا مُبَالٍ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "むかんじょう": "لَامُبَالَاة, عَدَم اِكْتِرَاث",
 "むかんどう": "عادي, غير مثير للإعجاب (غير قادر على إثارة الإعجاب)",
 "むかんのていおう": "صَحَفِيّ, صَحَفِيَّة\nمثال: لن أنس مراسلة أمي.",
 "むかーし": "مَاضٍ, الْمَاضِي ((في النحو) زمن نحوي يدل على حدث قد وقع، أو وُجِد قبل الآن بوقت ما)\nمثال: و بعد قليل أتى.",
 "むかーしむかし": "قَدِيماً",
 "むかーしむかーし": "قَدِيماً",
 "むが": "إِيثَار, غَيْرِيَّة",
 "むがい": "غير ضار, مسالم (لا يسبب أو غير قادر على التسبب في ضرر)\nمثال: بكتيريا غير ضارة / مَفْتُوح\nمثال: فتح الباب آليا.",
 "むがいか": "إزالة السموم (علاج للتسمم عن طريق تحييد الخصائص السامة (عادة وظيفة الكبد)) / تَعْقِيم ((وعَقَّمَهُ تَعْقيمًا: أسْكَتَه)؛ عقّم يعقِّم تعقيماً،فهو معقِّم،والمفعول…)",
 "むがく": "جاهل, غير متعلم (لا يمتلك تعليماً جيداً) / بوذا (الشخص الذي حقق حالة من الاستنارة الكاملة)",
 "むがくめんかぶ": "أسهم بدون قيمة اسمية (أسهم ليس لها قيمة اسمية محددة في ميثاق الشركة أو على شهادة الأسهم)",
 "むがくめんかぶしき": "أسهم بدون قيمة اسمية (أسهم ليس لها قيمة اسمية محددة في ميثاق الشركة أو على شهادة الأسهم)",
 "むがくるい": "لا فكيات (فقاري يشبه الثعبان بدون فكوك أو زوائد مزدوجة بما في ذلك دائريات الفم وبعض…)",
 "むがのきょう": "ترانس",
 "むき": "اِتِّجَاه\nمثال: لا تنس إخراج القمامة. / مَيْل, نَزَعَة / طَبِيعَة, طبيعة / أُقْنُوم / غير عضوي (متعلق أو منتمي لفئة المركبات التي ليس أساسها الكربون)\nمثال: أحماض الهيدروكلوريك والكبريتيك تسمى مواد غير عضوية / كيمياء اللاعضوية (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما…)\nمثال: هو يحب الكيمياء. / مركب غير عضوي (أي مركب لا يحتوي على الكربون) / نَكِرَة / سَجْن مُؤَبَّد (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن. / وَقِح, صَفِيق",
 "むきあう": "وَاجَهَ (تَقَابَلَ معه وَجها لوجه؛ الجندي العدو: استقبله مواجهة ليقاتله أو يناضل ضده)\nمثال: واجه سامي ليلى.",
 "むきかがく": "كيمياء اللاعضوية (الحيلة والحِذق، وكان يراد بها عند القدماء: تحويل بعض المعادن إلى بعض، ولا يسما…)\nمثال: هو يحب الكيمياء.",
 "むきかごうぶつ": "مركب غير عضوي (أي مركب لا يحتوي على الكربون)",
 "むききんこ": "سَجْن مُؤَبَّد (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "むきけい": "سَجْن مُؤَبَّد (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "むきげん": "نَكِرَة",
 "むきしつ": "بَارِد, برد (مُنْخَفِض الحَرارة أو حَرارتُه أقلّ من حَرارة جسْم الإنسان؛ غير حامٍ، أو متروك…)\nمثال: الماء بارد حقا.",
 "むきしつひりょう": "سماد معدني (سماد غير عضوي يحتوي على معادن نادرة)",
 "むきず": "سَالِم, مُعَافًى (لم يُصَب بأذى أو ضرر) / بِلَا عَيْب, خَالٍ مِنَ العُيُوب (خالٍ من أيّ عيب أو شائبة) / بِلَا شَائِبَة, نَاصِع (بالغ النظافة وخالٍ من أيّ بقعة أو لطخة)",
 "むきだし": "عُرْيَان, عَارٍ / إِفْرَنْجِيّ",
 "むきだす": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ…)\nمثال: ثبت مناد مكانه.",
 "むきちょうえき": "سَجْن مُؤَبَّد (وضع شخصًا أو شيئًا في السجن أو الحبس؛ قيّد حرية شخص أو حركة شيء)\nمثال: دخل سامي السجن.",
 "むきてき": "غير عضوي (متعلق أو منتمي لفئة المركبات التي ليس أساسها الكربون)\nمثال: أحماض الهيدروكلوريك والكبريتيك تسمى مواد غير عضوية",
 "むきどう": "بِلَا مَسَالِك, وَعْر (يفتقر إلى الممرّات والطرق المعبَّدة)\nمثال: حافلة ترولي بلا مسار (سكة) / مُتَهَوِّر",
 "むきはい": "انخماص الرئة (انهيار رئة متمددة (خاصة عند الرضع)؛ أو فشل الحويصلات الهوائية الرئوية في التوسع…)",
 "むきぶつ": "مركب غير عضوي (أي مركب لا يحتوي على الكربون)",
 "むきむき": "مُلَاءَمَة, مُنَاسَبَة (صفة امتلاك الخصائص الصحيحة لغرض معين)\nمثال: مطلب مهم هو الملاءمة للرحلات الطويلة / عَضَلِيّ",
 "むきめい": "غير موقع (يفتقر إلى التوقيع)\nمثال: الرسالة كانت مطبوعة وغير موقعة",
 "むきめいかぶ": "سهم لحامله (سهم لا يحتوي على معلومات الملكية ويفترض أن حامله المادي هو المالك)\nمثال: الأسهم لحاملها محظورة في بعض البلدان بسبب احتمال إساءة استخدامها",
 "むきめいとうひょう": "اقتراع سري (تصويت يكون فيه اختيار كل شخص سريًا ولكن إجمالي الأصوات علني)",
 "むきゃく": "عَدِيمُ القَوَائِم ((عَنِ الأَفَاعِي وَالأَنْقَلَيْسِ) بِلَا أَقْدَامٍ بِطَبِيعَتِهِ)",
 "むきゅう": "رحلة بدون توقف (رحلة تتم دون توقفات وسيطة بين المصدر والوجهة)\nمثال: كم عدد الرحلات بدون توقف إلى دالاس؟ / بلا أجر, غير مدفوع (لم يتم الدفع له)\nمثال: أجور غير مدفوعة / أَبَد (الأبَد : الدَّهْرُ وَيُقَالُ الدَّهْرُ الطَّوِيلُ الَّذِي لَيْسَ بِمَحْدُودٍ…)\nمثال: سأحبك إلى الأبد.",
 "むきゅうか": "ختمية سورية, ورد شارون (شجيرة آسيوية أو شجرة شجيرية صغيرة ذات زهور وردية أو أرجوانية أو بيضاء مبهرجة…)",
 "むきゅうかく": "خشم, فقد الشم (غياب حاسة الشم)",
 "むきゅうかくしょう": "خشم, فقد الشم (غياب حاسة الشم)",
 "むきゅうどう": "حركة أبدية (حركة تستمر إلى أجل غير مسمى دون أي مصدر خارجي للطاقة؛ مستحيلة عملياً بسبب…)",
 "むきゅうるい": "لا ثقوبيات (زاحف بدائي ليس له فتحة في المنطقة الصدغية من الجمجمة؛ جميعها منقرضة باستثناء…)",
 "むきょういく": "جاهل, غير متعلم (لا يمتلك تعليماً جيداً)",
 "むきょうかい": "احتشاد, تجمهر (تجمع الناس معاً)\nمثال: تقع بيتسبرغ عند نقطة التقاء نهري أليغيني ومونونغاهيلا",
 "むきょうしつ": "غرفة عديمة الصدى (غرفة ذات صدى ضئيل جداً)",
 "むきょうよう": "جاهل, غير متعلم (لا يمتلك تعليماً جيداً)",
 "むきょか": "غَيْر مُخَوَّل, غَيْر مُصَرَّح بِه (غير ممنوح السلطة)",
 "むきょく": "بِلَا حُدُود, لَامَحْدُود (يَبْدُو بِلَا حُدُودٍ فِي الكَمِّيَّةِ أَوِ العَدَدِ أَوِ الدَّرَجَةِ أَوِ…)\nمثال: البدء بنظرية الحرية غير المحدودة هو الانتهاء باستبداد غير محدود",
 "むきりつ": "غَيْرُ مُنْضَبِط, فَاقِدُ الانْضِبَاط (يَفْتَقِرُ إِلَى الانْضِبَاطِ أَوِ السَّيْطَرَة)",
 "むきりょく": "لَامُبَالَاة, عَدَم اِكْتِرَاث",
 "むきりょくじょうたい": "لَامُبَالَاة, عَدَم اِكْتِرَاث",
 "むきん": "مُعَقَّم (جُعِلَ عَقِيمًا بِإِجْرَاء طِبِّيّ)",
 "むきんせい": "خَالٍ مِنَ الجَرَاثِيم, مُعَقَّم (خالٍ من الكائنات الدقيقة المُمرضة أو يستخدم طرقًا لمنعها)",
 "むきんほう": "تطهير, تعقيم (عملية تثبيط نمو وتكاثر الكائنات الحية الدقيقة)",
 "むき出し": "عُرْيَان, عَارٍ / إِفْرَنْجِيّ",
 "むき出す": "ثَبَتَ, وَضَحَ (اسْتَقَرَّ ودَامَ ولم يتحرك برغم المغريات أو الدوافع؛ الأمر: تَحَقَّقَ…)\nمثال: ثبت مناد مكانه.",
 "むぎ": "قَمْح, حِنْطَة / وَقِح, صَفِيق",
 "むぎこ": "دقيق القمح, طحين القمح (ضد الغَلِيْظ، الرَفِيْع الرَقِيْق؛ صغير الحجم جدا)\nمثال: ساعتي غير دقيقة.",
 "むぎこう": "بَسِيط, سَاذَج (بسيط وطبيعي؛ بدون مكر أو خداع)\nمثال: أسلوب بسيط",
 "むぎはんにゃ": "بِيرَة, جِعَة",
 "むぎばたけ": "حقل قمح (حقل مزروع بالقمح)",
 "むぎゅむぎゅ": "خَفِيف, مَرِن ((عن الحركات) خفيف ونشط بثقة)",
 "むぎわらぎく": "ذهب الشمس, زهرة القش (نبات أسترالي متوطن في إسبانيا له زهور صفراء ليمونية إلى ذهبية عميقة؛ الخيار…)",
 "むぎわらとんぼ": "يَعْسُوب",
 "むぎわらぼう": "قبعة بنما, قبعة قش (قبعة صلبة مصنوعة من القش ذات تاج مسطح)",
 "むぎわらぼうし": "قبعة بنما, قبعة قش (قبعة صلبة مصنوعة من القش ذات تاج مسطح)",
 "むく": "بَدَا (ظَهَرَ)\nمثال: بدا سامي مريضا. / وَجْه, مُحَيًّا (الإِنْسَان: هو مقدم رأسه الذي يُوَجِهَهُ إلى الناس؛ ضد الظَهْر، ما يقع في…)\nمثال: تبدو شاحب الوجه. / نُقْطَة (عَلَامَة مُسْتَدِيرَة صَغِيرَة؛ عَلَامَة لتَمْيِيز الحَرْف أو شَكْلِه)\nمثال: هذه هي نقطة ضعفه. / قَشَّرَ / خَالٍ مِنَ الزَّخْرَفَة, سَادَة (يفتقر إلى التزيين أو الزخرفة) / صَافٍ, اَلصَّافِي",
 "むくい": "مُكَافَأَة, ثَوَاب / عِقَاب, جَزَاء (طَيْر من الجَوَارِح، أكبر التي تصيد منها يكنى بأبي الهَيْثَم ومعروف بحِدَّة…)\nمثال: هو من تلقى العقاب الأكبر.",
 "むくいる": "مُكَافَأَة, ثَوَاب",
 "むくう": "مُكَافَأَة, ثَوَاب",
 "むくげ": "نسيان النص, هفوة (خطأ (خاصة نسيان الممثل للسطور)) / ختمية سورية, ورد شارون (شجيرة آسيوية أو شجرة شجيرية صغيرة ذات زهور وردية أو أرجوانية أو بيضاء مبهرجة…)",
 "むくせいじょう": "مُنَزَّه",
 "むくち": "قليل الكلام, كتوم (متحفظ عادة وغير متحدث)",
 "むくっと": "بغتة, على حين غرة (بسرعة وبدون سابق إنذار)\nمثال: توقف فجأة / بِبُطْء",
 "むくつけき": "خَشِن (صار خشناً أو غير ناعم؛ أصبح صلباً أو غليظ الملمس)\nمثال: زيري خشن الخلق.",
 "むくと": "بغتة, على حين غرة (بسرعة وبدون سابق إنذار)\nمثال: توقف فجأة / بِبُطْء",
 "むくどり": "زُرْزُور / فلاح ساذج, قروي بسيط (شخص ليس ذكياً جداً أو غير مهتم بالثقافة) / تِسْعَة وَسِتُّون",
 "むくどりもどき": "سوادية (شحرور أمريكي طويل الذيل ذو ريش أسود قزحي الألوان)",
 "むくみ": "انتفاخ (الزيادة في حجم بعض المواد عند تسخينها (غالباً ما تكون مصحوبة بإطلاق الماء))\nمثال: أحدث المسدس في جيبه انتفاخاً واضحاً",
 "むくむ": "اِنْتَفَخَ, وَرِمَ\nمثال: 手足がむくんでいます。 — تورمت قدميّ و يديّ.",
 "むくむく": "شَاهِق / سمين / تحريك, تقليب (تحريك سائل باستخدام أداة)\nمثال: التحريك المستمر يمنعه من الاحتراق في قاع المقلاة / أَشْعَث",
 "むくゆ": "مُكَافَأَة, ثَوَاب",
 "むくり": "بغتة, على حين غرة (بسرعة وبدون سابق إنذار)\nمثال: توقف فجأة / بِبُطْء / حدبة, ميل العجلات (محاذاة عجلات السيارة لتكون أقرب لبعضها في الأسفل منها في الأعلى)",
 "むくれる": "بوز, حرد (مزاج أو إظهار للترفع العبوس أو الانسحاب)\nمثال: بقي في المنزل في حالة حرد / قَشَّرَ",
 "むくろ": "بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ…)",
 "むく毛": "نسيان النص, هفوة (خطأ (خاصة نسيان الممثل للسطور))",
 "むぐら": "دابة الشجر, متسلق (أي من الطيور الصغيرة المتنوعة آكلة الحشرات في نصف الكرة الشمالي التي تتسلق جذوع…)",
 "むぐる": "غَاصَ",
 "むけい": "عَدِيمُ الشَّكْل (لَيْسَ لَهُ شَكْلٌ مَادِّيٌّ مُحَدَّد) / لَا أَسَاس لَه, وَاهٍ (بدون أساس في العقل أو الواقع)",
 "むけいかく": "غَيْر مُتْقَن, مُرْتَجَل (يَتَّسِم بِالإِهْمَال الشَّدِيد وعَدَم الدِّقَّة)\nمثال: كان رئيس الوزراء يرتدي بدلة رمادية وقميصاً أبيض بياقة ناعمة، لكن رقبته أصبحت أنحف والياقة تبتعد عنها كما لو تم شراؤها عشوائياً",
 "むけいさつ": "فَوْضَى, فَوْضَوِيَّة",
 "むけいざいさん": "أصل غير ملموس, أصول معنوية (أصول قابلة للبيع وإن لم كانت مادية أو فيزيائية)",
 "むけいぶんかいさん": "تراث ثقافي غير مادي",
 "むけつ": "بِلَا عَيْب, خَالٍ مِنَ العُيُوب (خالٍ من أيّ عيب أو شائبة) / أَبْيَض كَالمَوْت, فَاقِد الدَّم (خالٍ من الدم أو يبدو كذلك)\nمثال: جراحة غير دموية",
 "むける": "دَارَ, أَدَارَ (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع…)\nمثال: إذهب إلى الدار. / خَصَّصَ (خَصَّصَ الشيءَ: جعله خاصًّا؛ خَصَّصَ فلانًا بالشيءِ: خَصَّهُ به)\nمثال: حاول توفير بعض المال من ما خصص للسفر. / أَرْسَلَ, بَعَثَ (بَعَثَ؛ أَطْلَقَ)\nمثال: هو أرسل لي هدية. / لَاحَقَ\nمثال: اتبع قلبك فحسب.",
 "むけん": "استمرارية, تواصل (صفة الشيء الذي يستمر بلا نهاية أو انقطاع)",
 "むげ": "تَمَامًا / شَقَاوَة, تَعَاسَة",
 "むげっけい": "انقطاع الطمث (غياب أو قمع تدفق الطمث الطبيعي)",
 "むげに": "بِصَرَاحَة فَجَّة, بِفَظَاظَة (بطريقة مباشرة فظة)\nمثال: تحدث بفظاظة",
 "むげにする": "إِهْمال",
 "むげん": "حُلْم, رُؤْيَا (رأى في نومه)\nمثال: هذا الحلم سيتحقق. / أبدية, خلود (زمن بلا نهاية) / لَا مُتَنَاهٍ (كلّيّ وشامل لكلّ شيء)\nمثال: اختبروا قدرته على تحديد مواقع الأشياء في الفضاء / استمرارية, تواصل (صفة الشيء الذي يستمر بلا نهاية أو انقطاع)",
 "むげんきどう": "جنزير, مسار كاتربيلر (حزام معدني لا نهائي تتحرك عليه المركبات المجنزرة فوق الأرض)",
 "むげんざい": "خلو من العيب, طهارة (سمة عدم وجود وصمة أو شائبة؛ كونه نظيفاً، غير مدنس، صافياً، نقياً)\nمثال: للأسف لم يحافظ على نقائه بل استسلم لشهواته",
 "むげんざいのおんやどり": "الحَمْل بِلَا دَنَس",
 "むげんざいのやどり": "الحَمْل بِلَا دَنَس",
 "むげんしょう": "مُتَنَاهٍ فِي الصِّغَر (صغير بشكل لا نهائي أو لا يُقاس)",
 "むげんすうれつ": "متتالية لا نهائية (تتابع غير محدود لعناصر مرتبة بترتيب معين)",
 "むげんだい": "أبدية, خلود (زمن بلا نهاية)",
 "むげんてい": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)",
 "むげんてき": "حُلُمِيّ, سُرْيَالِيّ (يشبه الحلم في غرابته وإيحائه)",
 "むげんほうまつ": "مُؤَقَّت, سَريع الزوال",
 "むげんれんさこう": "مخطط هرمي (مخطط احتيالي يتم فيه تجنيد أشخاص لدفع مدفوعات للشخص الذي جندهم بينما يتوقعون…)",
 "むげんループ": "حلقة مغلقة, نظام الحلقة المغلقة (نظام تحكم ذو حلقة تغذية مرتدة نشطة)",
 "むこ": "زَوْج, بَعْل (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…) / زَوْج اَلاِبْنَة, صِهْر (زَوَّجَ الأَشياءَ تَزْويجًا، وزَواجًا: قرن بعضَها ببعض؛ زَوَّجَ فلانًا امرأةً…)\nمثال: زوجة ماري طبيبة. / بَرِيء, بَرِيئَة",
 "むこう": "هُنَاك, هُنَالِك / وِجْهَة, وُجْهَة / قَادِم\nمثال: زيري بجانب الحوض. / بَاطِل, غَيْر صَالِح (لم يعد ساري المفعول)\nمثال: استدلال باطل / لا فموي (ليس له فم أو فتحة تشبه الفم) / بِلَا إِضَاءَة, غَيْر مُنَار (بِدُون إِنَارَة أَوْ إِضَاءَة)\nمثال: كانت الطاولة عارية، والشموع غير مضاءة",
 "むこういき": "عدوانية, ولع بالقتال (ميل طبيعي للعداء)",
 "むこうか": "مُعَطِّل, مُقْعِد (يُسَبِّب عَجْزًا أو إعاقَة جَسَدِيَّة)\nمثال: بعض القيود المبطلة للأهلية حرمته من الجنسية / إبطال, إفساد (الإبطال عن طريق تدمير القوة القانونية)\nمثال: إبطال العقد",
 "むこうがい": "نَظِيف",
 "むこうき": "عدوانية, ولع بالقتال (ميل طبيعي للعداء)",
