 "ほりいど": "حَسَنًا, بِخَيْر (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "ほりえ": "قَنَاة",
 "ほりかわ": "قَنَاة",
 "ほりきざむ": "نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي…)\nمثال: من علمك نحت الخشب.",
 "ほりきり": "تَرْكِيبِيّ, مَصْنُوع (ليس من أصل طبيعي؛ أُعِدّ أو صُنِع صناعيًّا)",
 "ほりくずす": "أضعف, قّوض",
 "ほりし": "حفّار, نقاش (صانع طباعة يطبع من لوحة طباعة محفورة)",
 "ほりす": "أَرَادَ, رَغِبَ (شَاءَ الشيءَ، رَغِبَ فيه؛ أَحَبَّ، شَهِيَ، اِشْتَهَى. (تخصيص))\nمثال: أراد مني الكذب.",
 "ほりだしもの": "وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه…)\nمثال: وجد ياني هاتفه.",
 "ほりだしもん": "وَجَدَ, لَقِيَ (أَدْرَكَ المطلوب، أَدْرَكَ الشيء الذي أَرَادَهُ وبَحَثَ عنه؛ غَضِبَ عليه…)\nمثال: وجد ياني هاتفه.",
 "ほりだす": "قَطَفَ (قطفت الدّابّة قِطَافاً: أَبْطَأَتْ، في أمثالهم: (أَقْطَفُ من أرنب)؛ قَطَفَ…)\nمثال: أحب قطف الورود.",
 "ほりつくす": "اِسْتَهْلَكَ, اِسْتَنْفَدَ",
 "ほりつける": "نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي…)\nمثال: من علمك نحت الخشب.",
 "ほりぬきいど": "بِئْرٌ إِرْتِوَازِيَّة, بِئْرٌ إِرْتِوَازِيّ",
 "ほりねずみ": "غوفر, غوفر جيبي (قارض حفار من فصيلة الغوفرية له جيوب خدية خارجية كبيرة؛ من أمريكا الوسطى وجنوب…)",
 "ほりもの": "نَحْت (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي…)\nمثال: من علمك نحت الخشب. / وَشْم",
 "ほりものし": "حفّار, نقاش (صانع طباعة يطبع من لوحة طباعة محفورة)",
 "ほりゅう": "صفصاف أحمر, صفصاف أرجواني (صفصاف أوراسي له غصينات محمرة أو أرجوانية ولحاء غني بالعفص) / ضعف, عجز (حالة الضعف في الصحة أو الجسم (خاصة بسبب الشيخوخة)) / حَجْز (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "ほりゅうち": "حَجْز (حجَزهُ: مَنَعَهُ)\nمثال: حجز مناد موعدا.",
 "ほりょ": "سَجِين, سَجِينَة",
 "ほりょしゅうようじょ": "مخيم اعتقال, معسكر أسرى الحرب (معسكر لأسرى الحرب)",
 "ほりわり": "قَنَاة",
 "ほる": "حَفَرَ, اِحْتَفَرَ ((حَفَرَ الشَّيْءَ يَحْفِرُه) ، من حَدِّ ضَرَبَ، حَفْراً، (واحْتَفَرَه: نَقَّاه…)\nمثال: هم يحفرون حفرة. / لِي, لي / قِمَّة / نَحَتَ (وهو القَطْع والبَري والنشر والقشر وتشكيل الخشب أو الحجر أو غيره؛ الشيء الذي…)\nمثال: من علمك نحت الخشب. / وَشْم / رَمَى, صَبَّ ((مُتَعَدٍّ بِنَفْسِهِ) جَعَلَهُ يَتَحَرَّكُ فِي الهَوَاءِ)\nمثال: رمى تلك الموزة. / أَهْمَلَ",
 "ほるい": "قَلْعَة, حِصْن (المرة الواحدة من القَلْع؛ حِصْن منيع غالبا يبنى على تلّ أو جبل أو مكان عالٍ منيع)\nمثال: هو يعيش في قلعة.",
 "ほるほる": "رضا عن الذات, غرور (الشعور الذي ينتابك عندما تكون راضياً عن نفسك)\nمثال: كان رضاه عن نفسه مثيراً للاشمئزاز تماماً",
 "ほれいざい": "تَبْرِيدِيّ, مُبَرِّد (يُسبِّب التبريد أو التجميد)",
 "ほれぐすり": "ترياق الحب, شراب الحب (شراب يُعتقد أن له قوة سحرية؛ يمكن أن يجعل من يتناوله يقع في حب من أعطاه إياه)",
 "ほれたがいんが": "بصرف النظر, بغض النظر (على الرغم من كل شيء؛ دون اعتبار للعوائق)\nمثال: واصل العمل بغض النظر عن الصعوبات",
 "ほれたはれた": "بتهور, رأساً على عقب (في عجلة مضطربة)\nمثال: ركضنا بتهور نحو الملجأ",
 "ほれほれ": "بِحَنَان, بِحُبّ (بمودة وحب)\nمثال: تحدثت إلى أطفالها بحنان",
 "ほれぼれ": "بِحَنَان, بِحُبّ (بمودة وحب)\nمثال: تحدثت إلى أطفالها بحنان",
 "ほれる": "وَقَعَ فِي حُبّ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "ほろ": "سقفية, ظلة (غطاء (عادة من القماش) يعمل كسقف لحماية منطقة ما من الطقس)",
 "ほろう": "رِوَاق, دِهْلِيز (مَمَرّ خارج المَبْنَى وملاصق له يمتد عليه السَقْف ويُصفّ على الجانب الآخر…)\nمثال: ذهب إلى الرواق.",
 "ほろし": "طَفْح, طَفْح جِلْدِيّ",
 "ほろせ": "طَفْح, طَفْح جِلْدِيّ",
 "ほろっと": "مُؤَثِّر\nمثال: إياك ولمس شطيرتي!",
 "ほろにがい": "حُلْو وَمُرّ, حُلْوَة وَمُرَّة (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية…)\nمثال: الكعكة حلوة جدا",
 "ほろばしゃ": "عربة كونستوجا, عربة مغطاة (عربة كبيرة بعجلات عريضة وسقف قماشي مقوس؛ استخدمها الرواد الأمريكيون لعبور…)",
 "ほろびゆく": "اختفاء, تواري (فعل المغادرة سراً أو دون تفسير)",
 "ほろびる": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "ほろぶ": "وَقَعَ, سَقَطَ (الشيء: سَقَطَ، انحدر من مكان عال؛ الأمر: حَدَثَ، وأكثر ما يقال للأمر العظيم)\nمثال: توم وقع و أصيب.",
 "ほろほろ": "اِنْصِهَار, ذَوَبَان (صَهَرَ (الشَّيْءَ) ، كالشّحْمِ ونَحْوِه، يَصْهَرُه صَهْراً: (أَذابَه…)",
 "ほろぼす": "دَمَّرَ",
 "ほろむいいちご": "توت السحاب, توت الغيم (توت شوكي زاحف من المناطق المعتدلة الشمالية بتوت أصفر أو برتقالي)",
 "ほろよい": "انتشاء, نشوة (المرح واللطف، كما من خلال تأثيرات الكحول أو الماريجوانا)\nمثال: رقة الضوء والظلال التي لا يمكن تحقيقها في الرخام",
 "ほろり": "بصوت خافت, بهدوء (بحجم صوت منخفض)\nمثال: تحدث بهدوء ولكن احمل عصا غليظة",
 "ほろん": "إضافة, ملحق (مادة نصية تضاف إلى منشور؛ عادة في النهاية)",
 "ほろ子": "طَفْح, طَفْح جِلْدِيّ",
 "ほろ苦い": "حُلْو وَمُرّ, حُلْوَة وَمُرَّة (متَّصِف بالحلاوة، وهي ذوق أساسي يُشعر به غالبًا عند تناول الأكلات الغنية…)\nمثال: الكعكة حلوة جدا",
 "ほろ酔い": "انتشاء, نشوة (المرح واللطف، كما من خلال تأثيرات الكحول أو الماريجوانا)\nمثال: رقة الضوء والظلال التي لا يمكن تحقيقها في الرخام",
 "ほわほわ": "مُتَلَاطِم, مُتَمَوِّج (يَتَّسِم بِأَمْوَاجٍ عَالِيَة مُتَدَافِعَة) / بحنان, برفق (مع الحنان؛ بطريقة حنونة)\nمثال: وضعت ذراعيها حوله بحنان",
 "ほをすすめる": "مَشَى, تَمَشَّى (اِنْتَقَلَ من مكان إلى آخر؛ اِنْتَقَلَ من مكان إلى آخر على الأقدام. (تخصيص))\nمثال: مشى ياني مع سكورا.",
 "ほん": "كِتَاب, سِفْر (موضع تعليم الكتابة. الاستخدام الأصلي؛ مدرسة شبه رسمية لتعليم الأطفال الكِتَابَة…)\nمثال: هذا الكتاب جديد / هَٰذَا, هَٰذِهِ / رَئِيسِيّ / حَقِيقِيّ / مُسْتَوًى / فَصْل (التقطيع؛ تقسيم الشيء أجزاءً؛ جزء، باب في كِتَاب أو ماشابهه)\nمثال: اقرأ هذا الفصل.",
 "ほんあん": "جَدَارَة / تأقلم, تكيف ((فسيولوجيا) التعديل المستجيب لعضو حسي (كالعين) لظروف متغيرة (كالضوء))\nمثال: المسرحية هي اقتباس لرواية قصيرة",
 "ほんい": "مِعْيَارِيّ",
 "ほんいかへい": "عملة قانونية, وسيلة دفع (شيء يمكن استخدامه كوسيلة رسمية للدفع)",
 "ほんいきごう": "طَبِيعِيّ",
 "ほんいつ": "هَرَبَ, فَرَّ (الفِرارُ)\nمثال: هرب كأرنب خائف.",
 "ほんいん": "إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "ほんいんぼう": "أستاذ كبير (لاعب ذو مهارة استثنائية أو عالمية في الشطرنج أو البريدج)",
 "ほんえい": "الْقِيَادَة الْعَامَّة / منطقة الظل التام (منطقة من الظل الكامل ناتجة عن الانسداد الكلي للضوء)",
 "ほんおん": "كَرْشَنَة, نَقْصَوَة",
 "ほんかい": "جَلْسَة\nمثال: خضع زيد لدورة مكثفة",
 "ほんかいどう": "طَرِيق رَئِيسِيّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق.",
 "ほんかくか": "تسوية, تنظيم (فعل تحقيق التوحيد؛ جعله منتظماً)",
 "ほんかくてき": "أَصْلِيّ / شَامِل, كَامِلُ النِّطَاق (يستخدم جميع الموارد المتاحة)",
 "ほんかくは": "صفائي, متشدد في القواعد (شخص يصر على الدقة الكبيرة والصحة (خاصة في استخدام الكلمات))",
 "ほんかん": "أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / مَسْقَط اَلرَّأْس, وَطَن الأُمّ (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد…)\nمثال: دفنت في مسقط رأسها.",
 "ほんがん": "مَسْقَط اَلرَّأْس, وَطَن الأُمّ (اسم مكان من السقوط؛ موضع السقوط عامّة؛ رأسه: عن المكان الذي وُلِد فيه. يُقصد…)\nمثال: دفنت في مسقط رأسها.",
 "ほんき": "جِدِّيَّة",
 "ほんきで": "بِجِدِّيَّة, بجد",
 "ほんきど": "جِدِّيَّة",
 "ほんきにする": "أَخَذَهُ عَلَى مَحْمَلِ الجِدِّ, أَخَذَهُ بِالجِدِّيَّة",
 "ほんきょ": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما…)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "ほんきょく": "مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "ほんきょち": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما…)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "ほんきん": "ذهب خالص, ذهب عيار 24 (ذهب بنسبة 100 في المائة) / رأس مال الأسهم (القيمة الدفترية للأسهم القائمة لشركة ما)",
 "ほんぎまり": "حكم نهائي (حكم يفصل في القضية المعروضة على المحكمة؛ بعد صدور الحكم (أو الاستئناف منه) كل…)",
 "ほんぐみ": "مَاكْيَاج, بُنْيَة",
 "ほんけ": "مُؤَسِّس, مُؤَسِّسَة",
 "ほんけいやく": "عَقْد, مُعَاهَدَة (العَشْر من السَنَوَات؛ الاتِّفَاق والعَهْد بين طرفين)\nمثال: أمضى زيري العقد.",
 "ほんけがえり": "خرف, هرم (الضعف العقلي نتيجة لكبر السن)",
 "ほんけほんもと": "مَكَان الْمِيلَاد, مَسْقَط الرَّأْس (مَوْضِع؛ المنزلة والشأن، يقال أيضا مكانة)\nمثال: هذا المكان مقدس",
 "ほんけん": "حَقّ المِلْكِيَّة (الحق القانوني في الملكية) / سهم, شهادة سهم (شهادة توثق ملكية المساهم في الشركة)\nمثال: تضاعفت قيمة أسهمه خلال العام الماضي",
 "ほんげん": "مَنْشَأ",
 "ほんこく": "إعادة إصدار, طبعة جديدة (منشور (مثل كتاب) يُعاد طبعه دون تغييرات أو تحرير ويُعرض للبيع مرة أخرى)",
 "ほんこんかぎだいがく": "هُونْغ كُونْغ",
 "ほんこんこうくう": "هُونْغ كُونْغ",
 "ほんこんこっかあんぜんいじほう": "هُونْغ كُونْغ",
 "ほんこんじょうしだいがく": "جامعة المدينة (جامعة حضرية في مدينة كبيرة)",
 "ほんこんだい": "هُونْغ كُونْغ",
 "ほんこんてんもんだい": "هُونْغ كُونْغ",
 "ほんこんりこうだいがく": "هُونْغ كُونْغ",
 "ほんこんテレコム": "هُونْغ كُونْغ",
 "ほんご": "ذَهَبَ, رَاحَ (في : التِبْر، مَعْدِن ثَمِين أصْفَر اللَّوْنِ، هُوَ أَسَاسُ التَعَامُلِ…)\nمثال: ذهب إلى الدكان.",
 "ほんごく": "وَطَن, مَوْطِن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن.",
 "ほんごくじん": "أَصْلِيّ",
 "ほんごし": "جدية, رزانة (سمة كون المرء جاداً)\nمثال: نقص الوقار ليس بالضرورة نقصاً في الجدية",
 "ほんさば": "ماكريل تشوب (ماكريل صغير يوجد في جميع أنحاء العالم تقريباً)",
 "ほんしき": "رَسْمِيّ, صُورِيّ (منسوب للسُّلْطَة أو الحُكُومَة أو الدَّوْلَة أو القَانُون؛ مُلَائِم للمَعَايِير)\nمثال: لقد انتهى الدرس بشكل رسمي. / بجدية (بطريقة جادة)\nمثال: تحدث بجدية مع ابنه",
 "ほんしけん": "امتحان نهائي (امتحان يجرى في نهاية الفصل الدراسي)",
 "ほんしつ": "جَوْهَر, مَاهِيَّة (جَوْهَر)\nمثال: الجمال في الجوهر لا المظهر",
 "ほんしつしゅぎ": "اَلْجَوْهَرَانِيَّة",
 "ほんしつてき": "جَوْهَرِيّ, مَوْضُوعِيّ (يحدد الحقوق والواجبات بدلاً من إعطاء القواعد التي يتم بموجبها تأسيس الحقوق…)\nمثال: القانون الموضوعي",
 "ほんしゃ": "مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "ほんしゅう": "هُونْشُو",
 "ほんしゅす": "أَطْلَس",
 "ほんしょ": "قسم شرطة, مركز شرطة (محطة تعمل كمقر للشرطة في منطقة معينة؛ وتخدم كمكان يتم منه إرسال رجال الشرطة…) / بِدَايَة (في بِدَايَة الأمْرِ كانَ مُهَذَّباً : فِي أوّلِهِ؛ البِدَايَة والنِّهاية:…)\nمثال: هذه بداية جيدة. / مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "ほんしょう": "مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "ほんしょく": "مُحْتَرِف, مُحْتَرِفَة / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى.",
 "ほんしょしごせん": "خَطّ الزَّوَال, خَطّ الطُّول الرَّئِيسِيّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "ほんしんさ": "فحص تحري, فرز (اختبار الأشياء أو الأشخاص لتحديد أولئك الذين لديهم خصائص معينة)\nمثال: أخفى الغطاء بنادقهم عن طائرات العدو",
 "ほんじ": "كَانْجِي, طَابِع يَابَانِيّ ((حرفيا) (الـ)حروف (الـ)صينية؛ نظام كتابة اللغة اليابانية باستخدام الأحرف الصينية)\nمثال: علمني بعض الكانجي من فضلك. / حَرْف صِينِيّ, طَابِع صِينِيّ (طَرَف وَجَانِب وَحَدّ؛ رَمْز مخطوط أو مطبوع يقوم مقام صوت أو كلمة أو عبارة أو…)\nمثال: ألف هو الحرف الأول للألف باء. / نَقْحَرَة, كَرْشَنَة (مصدر للفعل \"نَقْحَرَ\"؛ (في اللسانيات) كتابة لغة ما بحروفٍ تُستعمل لكتابة غيرها)",
 "ほんじつ": "الْيَوْمَ, النهارده",
 "ほんじょう": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما…)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "ほんじょうし": "فكرة رئيسية, محور (فكرة أساسية أو مركزية)",
 "ほんじん": "حِصْن (ما يُتَحَصَّنُ به ويُمْنَع؛ كل مكان محميّ مُحرَز لا يُوصَل إليه؛ عن ما…)\nمثال: كان هناك حصن على تلك الهضبة في يوم من الأيام.",
 "ほんすう": "عَدَد, نمرة (مِقْدَار مَا يُعَدّ)\nمثال: كم عدد سكان الجزائر؟",
 "ほんずき": "محب للكتب, مولع بالكتب (شخص يحب الكتب (ويجمعها عادة))",
 "ほんせん": "خط رئيسي (المسار الرئيسي لنظام النقل)",
 "ほんせんわたし": "سلسلة الساعة (سلسلة قصيرة أو شريط يربط ساعة الجيب بصدرية الرجل)",
 "ほんぜん": "طَبِيعِيّ / شراع رئيسي مربع (شراع رئيسي مربع الشكل) / فَجْأَةً / طيران (حالة السفر جواً)\nمثال: كان الطيران لا يزال مغامرة مثيرة بالنسبة له",
 "ほんそく": "قَانُون, قَاعِدَة (مقياس كل شيء وطريقه؛ أمر كليّ ينطبق على جميع جزئياته التي تعرف أحكامها منه)\nمثال: ذكرني بالقانون.",
 "ほんぞう": "نَبَات (مصدر للفعل نَبَتَ؛ اسم جنس شامل لكل ما تنبته الأرض من شجر أو بقل أو عشب أو غيره)\nمثال: هذا النبات مهدد بالانقراض.",
 "ほんぞん": "صَنَم, وَثَن (الصَّنَم: نَحْتٌ من خَشَبٍ ويُصَاغُ من نُحاسٍ، وغيره يُصنع لعبادته. ويُسمى…)",
 "ほんたい": "مَادَّة (مؤنث مَادّ، اسم فاعل من مَدَّ. الجمع مَادَّات؛ ما كان مَدَدًا لغيره)\nمثال: لا أحب مادة العلوم. / بَدَن, جِسْم ((بَدُنَ) الرَّجُلُ مِنْ بَابِ ظَرُفَ وَ (بُدْنًا) أَيْضًا بِوَزْنِ قُفْلٍ أَيْ…) / نُومِينُون",
 "ほんたいせいこうけつあつ": "ارتفاع ضغط الدم الأساسي, فرط ضغط الدم الأولي (ارتفاع مستمر ومرضي في ضغط الدم لا يمكن العثور على سبب محدد له)",
 "ほんたいせいしんせん": "رعاش مجهول السبب (رعاش غير معروف السبب (عادة في اليدين والرأس) يتطور لدى كبار السن؛ غالباً ما…)",
 "ほんたいぶ": "عُضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "ほんたいぶあんごうかひょうじ": "عُضْو (جُزْء من الجَسَد؛ مُشْتَرِك فِي جَمْعِيَّة أو شَرِكَة أو حِزْب أو نَادٍ)\nمثال: اذكر كل عضو باسمه.",
 "ほんたいろん": "أُنْطُولُوجِيَّا, عِلْم الْوُجُود",
 "ほんたて": "مسند كتب (دعامة توضع في نهاية صف من الكتب لإبقائها منتصبة (على رف أو طاولة))",
 "ほんだて": "مسند كتب (دعامة توضع في نهاية صف من الكتب لإبقائها منتصبة (على رف أو طاولة))",
 "ほんだな": "رَفّ كُتُب, رَفُّ الْكُتُب (رَفَّتْ أَوْراقُ الشَّجَرِ: اِهْتَزَّتْ، تَحَرَّكَتْ؛ رَفَّتِ العَيْنُ:…)\nمثال: وضع الكتاب على الرف. / مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "ほんだら": "آنَذَاكَ, حِينَئِذٍ\nمثال: ثم هناك مشكلة؛",
 "ほんちょうし": "فكرة رئيسية, محور (فكرة أساسية أو مركزية)",
 "ほんて": "ورقة حكم, ورقة رابحة (ورقة لعب من النقش الذي تم إعلانه كحكم)\nمثال: آس الحكم هو فائز مؤكد / خَبِير, مَاهِر (الخَابِر الذي يعرف خَبَر الشيء؛ المُخْتَصّ بالشيء ويعرف كل شيء عنه)\nمثال: درب على يد خبير.",
 "ほんてん": "مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "ほんで": "وَـ (الحرف السابع والعشرون من حروف الهجاء؛ يفيد الجمع والإشراك)",
 "ほんでん": "حقل أرز (حقل مروي أو مغمور يُزرع فيه الأرز)",
 "ほんと": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة. / سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته)\nمثال: علاج طبي مناسب / أَصْلِيّ",
 "ほんとう": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة. / سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته)\nمثال: علاج طبي مناسب / أَصْلِيّ / تحليق لأعلى, صعود سريع (فعل الارتفاع لأعلى في الهواء)",
 "ほんとうに": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه…)\nمثال: هو اغضبني حقا .",
 "ほんとうのところ": "بصدق, حقاً (في الواقع (تستخدم للتوكيد أو تعديل الجملة))\nمثال: في الحقيقة، عجل الانحلال الأخلاقي بسقوط الإمبراطورية الرومانية / حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "ほんとそれ": "هَٰذَا, هَٰذِهِ",
 "ほんとに": "حَقًّا (حَقَا (حقاه) حقوا: أصاب حقوه، يقال ضربه فحقاه؛ (حَقَا)الشيء فلانا: بلغ حقوه…)\nمثال: هو اغضبني حقا .",
 "ほんど": "يَابِسَة, بَرّ",
 "ほんどう": "طَرِيق, طَرِيق عَامّ (الطّرِيقُ: ٱلْمَطْرُوقُ ؛ الطّرِيقُ: ٱلْمَمَرُّ الواسعُ الممتد أَوسع من…)\nمثال: أسأل عن الطريق. / طب باطني, طب عام (فرع الطب الذي يتعامل مع تشخيص وعلاج (غير جراحي) لأمراض الأعضاء الداخلية (خاصة…)",
 "ほんどおり": "جَادَّة (الجادّة : وَسَطُ الطَرِيق —حديث؛ جادة : شارع أو طَرِيق رئيس أو الطريق الأعظم…)\nمثال: كانت ماري جادة.",
 "ほんなら": "آنَذَاكَ, حِينَئِذٍ\nمثال: ثم هناك مشكلة؛",
 "ほんに": "بالفعل, حقاً ((تستخدم كصيغة تعجب) تعبير عن الدهشة أو الشك أو السخرية وما إلى ذلك)\nمثال: يريد الزواج من رئيس الخدم؟ حقاً!",
 "ほんにんかくにん": "التحقق من الهوية, القياسات الحيوية (التعرف التلقائي على الأفراد الأحياء باستخدام خصائصهم الفسيولوجية والسلوكية)",
 "ほんね": "حَافِز",
 "ほんねをいう": "صَدَقَ (نقيض الْكِذْب والكَذِب؛ قول ما يعتقدهُ القائل مطابقا للوَاقِع)\nمثال: صدق سامي كل شيء.",
 "ほんねん": "طَبِيعِيّ",
 "ほんの": "بحيرة صغيرة, بركة (بركة صغيرة من المياه الراكدة)",
 "ほんのう": "غَرِيزَة, سَلِيقَة",
 "ほんのうてき": "غَرِيزِيّ, فِطْرِيّ (نابع من الغريزة أو كأنّه منها؛ بلا تفكير واعٍ)",
 "ほんのむし": "دودة كتب (شخص يقضي وقتاً طويلاً في القراءة)",
 "ほんのり": "قَلِيلًا",
 "ほんのわずか": "تدوين سريع, خربشة (ملاحظة موجزة (ومكتوبة بخط اليد على عجلة))\nمثال: هذا الطبق يحتاج لمسة من الثوم",
 "ほんの僅か": "تدوين سريع, خربشة (ملاحظة موجزة (ومكتوبة بخط اليد على عجلة))\nمثال: هذا الطبق يحتاج لمسة من الثوم",
 "ほんば": "وَطَن (أقام بالمكان وكان وَطَنا له)\nمثال: دعاها لحفلة العودة للوطن. / مسقط الرأس, منشأ (المكان الذي نشأ فيه شيء ما أو تمت رعايته في بداية وجوده)\nمثال: مهد الحضارة",
 "ほんばこ": "مَكْتَبَة, خِزَانَةُ الْكُتُب",
 "ほんばふう": "أَصِيل, مَوْثُوق (غير مُزيَّف أو منسوخ؛ حقيقي لا شك فيه)",
 "ほんばら": "قَانُونِيّ",
 "ほんばん": "أَدَاء / لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس. / اِرْتِفَاع",
 "ほんばんこうい": "جِمَاع, مُجَامَعَة (الموافقة والمساعدة في أي شيء كان؛ الشيء: جمعه)\nمثال: توم قائد جماعة أنونيموس.",
 "ほんびのすがい": "كواهوج (محار أمريكي صالح للأكل؛ استخدمت أصدافه الثقيلة كنقود من قبل بعض الهنود…)",
 "ほんぶ": "الْقِيَادَة الْعَامَّة",
 "ほんぶし": "عَالِي الجَوْدَة, مُمْتَاز (يتفوق في الجودة)",
 "ほんぶちょう": "مدير عام (المدير الأعلى رتبة)",
 "ほんぶり": "وَابِل, مَطَر غَزِير",
 "ほんぶん": "رِسَالَة, مِيسِيج",
 "ほんぷく": "قَانُونِيّ",
 "ほんぺん": "فِلْم (شريط من السِّلِيلُوز تعلوه قشرة من الجلاتين ومن برومور الفِضَّة يستعمل للتصوير…)\nمثال: استمر الفلم ساعتين.",
 "ほんぽう": "مُتَوَحِّش / دستور, قانون أساسي (قانون يحدد المبادئ السياسية الأساسية للحكومة)",
 "ほんぽうじざい": "طَائِش, لَا مُبَالٍ (غير مسؤول بمرح وخِفّة)",
 "ほんま": "حَقِيقَة (الحَقّ، نقيض البَاطِل؛ نقيض المَجَاز)\nمثال: هي صديقة حقيقة.",
 "ほんまもん": "الشَّيْء الأَصْلِيّ (استخدام غير رسمي ينسب الأصالة)",
 "ほんまる": "نِوَاة",
 "ほんむ": "وَاجِب, وَظِيفَة (اسم لما يُوجَبُ فعله؛ اسم لما صار حدوثه أكيد)\nمثال: لا شكر على واجب.",
 "ほんむすび": "عقدة مربعة (عقدة مزدوجة مصنوعة من عقدتين نصفيتين وتستخدم لربط نهايات حبلين)",
 "ほんめい": "مَحْبُوب, مُفَضَّل (يروق لعامة الناس ويستهويهم)\nمثال: هذا الكتاب هو أحد مفضلاتي",
 "ほんもう": "رِضَا, إِشْبَاع (مصدر الفعل \"رَضِيَ\")\nمثال: السكوت علامة الرضا.",
 "ほんもと": "مَنْشَأ",
 "ほんもの": "الشَّيْء الأَصْلِيّ (استخدام غير رسمي ينسب الأصالة)",
 "ほんもん": "رِسَالَة, مِيسِيج",
 "ほんもんひひょう": "نقد نصي (مقارنة نص معين بمواد ذات صلة من أجل إثبات أصالته)",
 "ほんや": "متجر كتب, مكتبة (متجر تباع فيه الكتب) / دَار نَشْر, نَاشِر (المحل يجمع البِنَاء والعَرَصَة. قيل سمي كذلك لدوران الناس به وعليه وحوله. يجمع…)\nمثال: إذهب إلى الدار.",
 "ほんやく": "تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة. / فَكَّ تَّعْمِيَة, فَكَّ مُعَمَّى",
 "ほんやくか": "مُتَرْجِم",
 "ほんやくがく": "دِرَاسَات اَلتَّرْجَمَة",
 "ほんやくき": "مُتَرْجِم",
 "ほんやくけんきゅう": "دِرَاسَات اَلتَّرْجَمَة",
 "ほんやくさきげんご": "اللغة المترجم إليها, اللغة الهدف (اللغة التي يتم ترجمة نص مكتوب بلغة أخرى إليها)",
 "ほんやくしゃ": "مُتَرْجِم",
 "ほんやくしゃくよう": "استعارة مترجمة, محاكاة لغوية (تعبير أُدخل إلى لغة ما عن طريق ترجمته من لغة أخرى)",
 "ほんやくしょ": "تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة.",
 "ほんやくぶん": "تَرْجَمَة (شرح الكِتَاب أو توضيحه؛ تحويل الكلام من لغة إلى أخرى كي يفهمه قوم آخرون)\nمثال: أنا مدرس للترجمة.",
 "ほんやくもとげんご": "لغة المصدر (لغة يراد ترجمتها إلى لغة أخرى)",
 "ほんやくプログラム": "مُتَرْجِم",
 "ほんやくルーチン": "مترجم, مترجم برمجي ((علم الحاسوب) برنامج يفك شيفرة التعليمات المكتوبة بلغة عالية المستوى وينتج…)",
 "ほんゆう": "أَصَالَة, فِطْرِيَّة (صفة كون الشيء فطرياً)",
 "ほんゆうてき": "فِطْرِيّ",
 "ほんよみ": "دودة كتب (شخص يقضي وقتاً طويلاً في القراءة)",
 "ほんらい": "أَصْلًا / أساساً, جوهرياً (في الجوهر؛ في الأصل أو بحكم الطبيعة)\nمثال: هو في الأساس غير صادق / سَلِيم, صَحِيح (ملائم لحالة أو غرض أو مناسبة أو لطبيعة الشخص واحتياجاته)\nمثال: علاج طبي مناسب",
 "ほんらいからいえば": "حقاً, فعلياً (في واقع الأمر)\nمثال: لا أحد رأى القرش فعلياً",
 "ほんらいであれば": "حقاً, فعلياً (في واقع الأمر)\nمثال: لا أحد رأى القرش فعلياً",
 "ほんらいなら": "حقاً, فعلياً (في واقع الأمر)\nمثال: لا أحد رأى القرش فعلياً",
 "ほんりゅう": "تيار جارف, سيل (تيار مائي سريع وعنيف (أو سائل آخر))\nمثال: جرفت المنازل في السيل / شراع رئيسي مربع (شراع رئيسي مربع الشكل) / الاتجاه العام, التيار السائد (تيار الفكر السائد)\nمثال: كان تفكيره ضمن التيار السائد الأمريكي",
 "ほんりょう": "إقْطَاعَة",
 "ほんるい": "قَاعِدَة / مركز قيادة, مقر رئيسي ((عادة بصيغة الجمع) المكتب الذي يعمل كمركز إداري لمؤسسة ما)\nمثال: لدى العديد من الشركات مقراتها الرئيسية في نيويورك",
 "ほんるいだ": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه)\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "ほんるいだおう": "إصابة الهدف, نجاح تام (شيء ينجح تماماً في تحقيق هدفه)\nمثال: كانت الحملة الإعلانية الجديدة نجاحاً تاماً",
 "ほんわか": "دَافِئ",
 "ほんガス": "غاز المدينة (غاز فحم مصنع للاستخدام المنزلي والصناعي)",
 "ほんチャン": "أَدَاء / لَعْب, لَعْبَة (فعل شيئا للتسلية والترفيه، شَارَكَ في لعبة)\nمثال: لعب زيري التنس. / اِرْتِفَاع / اِخْتِرَاقْ (اختراق الرياح مرورها؛ اخترقت الخيل ما بين القرى والشجر:تخلّلتها)",
 "ほー": "وَا, يَا يَاه\nمثال: آه ، هناك فراشة! / حفل سُكْر, معاقرة الخمر (الاحتفال الصاخب بشرب الكحول؛ حفلة شرب مرحة)",
 "ほーい": "حَسَنًا, أُوكِي (تقال عند استحسان الفعل أو القول، هَذَا حَسَن)\nمثال: حسنا. أنا موافق.",
 "ほーん": "هَمْهَمَة (اِسْمٌ لِصَوْتِ الأَسَد)\nمثال: انا اسمع ضجيج المروحة و صوت نزول قطرات الماء من الصنبور و همهمة الثلاجة و تكتكة الساعة و هبوب الهواء عند مرور السيارات بالقرب من المنزل .",
 "ほ場": "أرض زراعية, أرض محروثة (أرض صالحة للزراعة يتم حرثها وزرعها وإنتاج المحاصيل منها)",
 "ほ座": "الشراع",
 "ぼ": "سِجِلّ (كتاب أو صحيفة تُسَجَّلُ فيها الأمور؛ الكاتب الذي يحفظ تلك الصحيفة أو السِجِلّ)\nمثال: سجل سامي وصوله.",
 "ぼいん": "بصمة الإبهام (بصمة إصبع مأخوذة من الإبهام (خاصة من باطن الإبهام)) / صَائِت, مُصَوِّت\nمثال: لقد أوقفنا حركة المرور. / أَسِير حَرْب (شخص يستسلم للعدو (أو يأخذه العدو) في وقت الحرب)",
 "ぼいんこうたい": "إبدال صوتي (حركة يتغير نوعها أو طولها للإشارة إلى تمييز لغوي)",
 "ぼいんせい": "حركي, صائت (كونه أو يحتوي على أو يتميز بحروف العلة)\nمثال: أصوات صائتة",
 "ぼいんせつぞく": "فُرْجَة",
 "ぼいんちょうわ": "اِنْسِجَام مُصَوَّتٍ, تَوَافُق صَوْتِيّ",
 "ぼう": "أَكِيد\nمثال: لديك بعض الكتب. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / عَمُود, قُطْب / خَطّ (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم. / الثُّرَيَّا / أَرْنَب (حيوان من فصيلة الثدييات مستأنس يربيه الناس من أجل لحومه وفرائه الناعم، ويربى…)\nمثال: زيري لديه أرنب. / شَرْق (شَرَقَتِ الشَّمْسُ تَشْرِقُ شَرْقًا؛ وشُرُوقًا: طلعت)\nمثال: تشرق الشمس من الشرق. / حُجْرَة (الغُرْفَة أو القَاعَة. تطلق على القَبْر والحَضِيرَة من باب التشبيه؛ ما يشبه…)\nمثال: قعدنا في وسط الحجرة. / رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس…) / بَدْر (البَدْرُ : القَمَرُ إِذا امْتَلأَ، وإِنما سُمِّيَ بَدْراً لأَنه يُبَادِرُ…) / رَاهِب, نَاسِك (اسم فاعل للفعل رَهَبَ؛ عند المَسِيحِيّين هو من تَبَتَّلَ لله واعْتَزَلَ الناس…) / فَتًى, غُلَام (شَابٌّ أوَّلَ شبابه بين المراهقة والرُّجولة؛ عبد، خادم)\nمثال: ترى الفتاة الفتى. / أَي, إِي (حرف نداء: لنداء القَرِيب أو البَعِيد أو المُتَوَسِّط، اختلف اللغويين في ذلك…)\nمثال: لم تقصد أي أذى. / صَغِير, صغير / قُبَّعَة, بُرْنَيْطَة (خرقة تخاطُ كالبُرْنس يلبسها الصِّبيان؛ غطاء للرأس يكون مُخّيَّط على عكس…)\nمثال: لقد اشترى قبعة. / شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)\nمثال: إنتاج القمح في ظل ظروف واسعة النطاق / غَامِض, مُبْهَم (غير واضح التعبير أو المعنى)\nمثال: مصطلح غير محدد (مبهم) / عُنْف, عَنْف / مَوْت (مصدر للفعل \"مَاتَ\"؛ زوال الحياة عن الكائن الحي)\nمثال: لا اخاف الموت . / مُتَأَخِّر",
 "ぼうあく": "عُنْف, عَنْف",
