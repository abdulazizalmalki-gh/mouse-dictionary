 "むせい": "احتلام (حلم جنسي (عادة في الليل) مصحوب بقذف (ليلي) للمني) / صَمْت, سُكُوت / افْتِقَار لِلصَّوْت, تَهْمِيش (عدم وجود صوت أو رأي في إدارة أو السيطرة على الشؤون) / بِلَا جَاذِبِيَّة جِنْسِيَّة (غير جذّاب جنسيًّا) / لَاجِنْسِيّ, لَاجِنْسِيَّة",
 "むせいあい": "لَاجِنْسِيَّة",
 "むせいえいが": "سِينِمَا صَامِتَة (مصطلح يشير إلى التصوير المتحرك الذي يعرض للجمهور و يعتبر التصوير السينمائي من…)\nمثال: كان في السينما.",
 "むせいが": "برعم تكاثري, جيمة (بنية تكاثرية لا جنسية صغيرة في حشيشة الكبد والحزازيات تنفصل عن الأصل وتتطور إلى…)",
 "むせいげん": "لَا يَنْضَب, لَا يُسْتَنْفَد (لَا يُمْكِنُ اسْتِهْلَاكُهُ أَوِ اسْتِنْفَادُهُ بِالكَامِلِ)\nمثال: البدء بنظرية الحرية غير المحدودة هو الانتهاء باستبداد غير محدود",
 "むせいしいん": "صوت مهموس (صامت يُنتج بدون صوت من الحبال الصوتية)",
 "むせいせいしょく": "تَكَاثُر لَاجِنْسِيّ",
 "むせいはんしょく": "تَكَاثُر لَاجِنْسِيّ",
 "むせいふ": "فَوْضَى, فَوْضَوِيَّة",
 "むせいふきょうさんしゅぎ": "شيوعية لاسلطوية (نظرية لاسلطوية تدعو إلى إلغاء الدولة والرأسمالية والأجور والملكية الخاصة، وتؤيد…)\nمثال: في الوقت نفسه، كان يتطور من اللاسلطوية الجماعية لباكونين إلى مذهب الشيوعية اللاسلطوية",
 "むせいふしほんしゅぎ": "لاسلطوية رأسمالية",
 "むせいふしゅぎ": "لَاسُلْطَوِيَّة",
 "むせいふしゅぎしゃ": "فَوْضَوِيّ, فَوْضَوِيَّة",
 "むせいふじょうたい": "فَوْضَى, فَوْضَوِيَّة",
 "むせかえる": "اِخْتَنَقَ\nمثال: خنق زيري وليد بعمامته.",
 "むせきついどうぶつ": "لَا فَقَارِيّ (نافية للفعل: تنفي الفعل بعدها وتدخل على على المضارع فلا تكرر والماضي وتكرر…)\nمثال: لا أحب المدرسة.",
 "むせきにん": "اِنْعِدام مَسْؤُولِيَّة",
 "むせきもの": "تَائِه, مُتَشَرِّد (يتنقّل باستمرار خاصّة من مسكن أو عمل لآخر)",
 "むせっそう": "عَدِيم المَبَادِئ (يفتقر إلى النزاهة أو المبادئ الأخلاقيَّة)\nمثال: التحرر من الافتراء الفظ غير المبدئي",
 "むせっぽい": "خنق (فعل خنق (شخص ما) عن طريق الضغط على القصبة الهوائية)\nمثال: لا يوجد دليل على أن الخنق تم بواسطة المتهم",
 "むせびなき": "شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "むせびなく": "شهيق, شهقة",
 "むせび泣き": "شهيق البكاء, نشيج (شهقة تشنجية تحدث أثناء البكاء)",
 "むせび泣く": "شهيق, شهقة",
 "むせる": "اِخْتَنَقَ\nمثال: خنق زيري وليد بعمامته.",
 "むせん": "رَادْيُو, رَادِيُو / لَاسِلْكِيّ",
 "むせんか": "عامل لاسلكي, مشغل راديو (شخص يقوم بتشغيل جهاز إرسال لاسلكي)",
 "むせんき": "رَادْيُو, رَادِيُو",
 "むせんきょく": "مَحَطَّة إِذَاعِيَّة",
 "むせんしゅうは": "تَرَدُّد رَادْيَوِيّ (تردد موجة كهرومغناطيسية بين الصوتية والأشعة تحت الحمراء)",
 "むせんしゅうはすう": "تَرَدُّد رَادْيَوِيّ (تردد موجة كهرومغناطيسية بين الصوتية والأشعة تحت الحمراء)",
 "むせんでんわ": "هاتف راديوي, هاتف لاسلكي (هاتف يتصل عبر موجات الراديو بدلاً من الكابلات)",
 "むせんひょうしき": "منارة لاسلكية (محطة إذاعية تبث إشارة توجيهية لأغراض الملاحة)",
 "むせんラン": "شبكة محلية لاسلكية, واي فاي (شبكة محلية تستخدم إشارات راديو عالية التردد لإرسال واستقبال البيانات عبر مسافات…)",
 "むせ返る": "اِخْتَنَقَ\nمثال: خنق زيري وليد بعمامته.",
 "むぜい": "مُعْفًى مِنَ الرُّسُوم (مُعْفًى مِنَ الرُّسُومِ الجُمْرُكِيَّة)",
 "むぜいひん": "مُعْفًى مِنَ الرُّسُوم (مُعْفًى مِنَ الرُّسُومِ الجُمْرُكِيَّة)",
 "むぜん": "أَمْرَد",
 "むそ": "سِتِّين, سِتُّون",
 "むそう": "حُلْم, رُؤْيَا (رأى في نومه)\nمثال: هذا الحلم سيتحقق. / لَا مَثِيلَ لَهُ, لَا نَظِيرَ لَهُ (بارز يفوق أيّ مقارنة؛ فريد لا يُضاهى)",
 "むそうか": "حَالِم",
 "むそくるい": "ضفدع ثعباني (أي من البرمائيات الصغيرة النحيلة عديمة الأطراف الحفارة التي تشبه الديدان؛ تعيش…)",
 "むぞうさ": "سَهْل (ضد الصَعْب، اليَسِير. لا جمع له؛ الشيء المُمَهَّد اللَيِّن. لا جمع له)\nمثال: هذا الشعور سهل. / سَطْحِيّ, عَابِر (مُسْتَعْجِل وبِدُون اهْتِمَام بِالتَّفَاصِيل؛ غَيْر شَامِل)",
 "むたい": "غَيْر مَلْمُوس, مَعْنَوِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ. / غَيْرُ مَعْقُول, مُفْرِط (يَتَجَاوَزُ الحُدُودَ الطَّبِيعِيَّة)",
 "むたいざいさんけん": "مِلْكِيَّة فِكْرِيَّة",
 "むたいしさん": "أصل غير ملموس, أصول معنوية (أصول قابلة للبيع وإن لم كانت مادية أو فيزيائية)",
 "むたいぶつ": "غَيْر مَلْمُوس, مَعْنَوِيّ (جَعَلَ الشيءَ غَيْر ما كان؛ اتخذ شيئا بدلا من شيء، استبدله به)\nمثال: أنا غير متفاجئ.",
 "むたんぽ": "بِلَا ضَمَان, غَيْر مَضْمُون (بدون ضمان ماليّ)",
 "むだ": "عَبَث, لَا طَائِل (عدم الجدوى كنتيجة لعدم وجود نتيجة عملية)",
 "むだい": "بِلَا لَقَب, غَيْر نَبِيل (لا ينتمي إلى طبقة النبلاء) / مَجَّانِيّ, مَجَّانًا",
 "むだぐち": "هَذَى",
 "むだごと": "هَذَى",
 "むだづかい": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "むだにする": "إسراف, تبديد (نشاط غير مجدٍ أو غير مربح؛ استخدام أو إنفاق أو استهلاك بلا تفكير أو بإهمال)\nمثال: إذا لم يحقق الجهد أي مكسب تعويضي فهو هدر",
 "むだのない": "اقْتِصَادِيّ, مُوَفِّر (يستخدم الحدّ الأدنى من الوقت أو الموارد اللازمة للفاعلية)\nمثال: نمو اقتصادي",
 "むだばなし": "ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة)",
 "むだめしぐい": "شخص عديم الفائدة, عاطل (شخص خامل لا قيمة له)",
 "むだめしぐらい": "عَدِيمُ الجَدْوَى, لَا خَيْرَ فِيه (بِلَا اسْتِحْقَاق؛ ذُو قِيمَةٍ أَوْ فَائِدَةٍ ضَئِيلَةٍ أَوْ مُنْعَدِمَة)",
 "むだん": "غَيْر مُدَرَّج, غَيْر مُرَتَّب (غير منظَّم ترتيباً هرميّاً) / مُتَوَاصِل, مُتَّصِل",
 "むだんかい": "مُتَوَاصِل, مُتَّصِل",
 "むだんきょじゅうしゃ": "محتل للمكان, واضع اليد (شخص يستقر في أرض أو مسكن دون حق أو سند قانوني)",
 "むだんけっせき": "تَمَلُّص, هُرُوب مِن المَدْرَسَة (الفشل في الحضور (خاصة المدرسة))",
 "むだんしゃくよう": "اختلاس, سوء استخدام (استعارة غير مشروعة)\nمثال: كان تفسيره سوء استخدام للنظرية الاجتماعية",
 "むだ話": "ثرثرة, كلام تافه (حديث عاطل أو أحمق وغير ذي صلة)"
}
