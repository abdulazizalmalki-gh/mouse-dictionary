 "ほっかいどうかいはつちょうちょうかん": "مُدِير عَامّ (الشخص الذي أدار، جمعه مُدِيرُون ومُدِيرِين؛ مهنة يتولى صاحبها إدَارَة شؤون جهة…)\nمثال: زيري هو المدير.",
 "ほっかいどうけん": "هُوكَايْدُو, هُكَّايْدُو",
 "ほっかいむえん": "شَامِل, وَاسِعُ النِّطَاق (واسع في نطاقه أو محتواه؛ يغطّي مجالات عديدة)",
 "ほっかいゆでん": "بَحَر اَلشَّمَال (شَقّ الأرض؛ التَحَيُّر والبَهْت من الفزع أو من شدة العَطَش فنظر لا يقصد شيئا)\nمثال: هبطت على البحر.",
 "ほっかり": "بشكل ممتع, بلطف (بطريقة ممتعة)\nمثال: قضينا ظهيرة كسولة بشكل ممتع / بشكل خافت, بضعف (بدرجة خافتة أو مدركة بضعف)\nمثال: بينه وبين الضوء الخافت تم تحديد شكل بشكل خافت / فَجْأَةً / بالصدفة, عرضياً (بدون تخطيط مسبق)\nمثال: التقيا بالصدفة",
 "ほっかん": "كُورِيَا الشَّمَالِيَّة (بلاد في جنوب شرق آسيا، يطلق عليها جغرافيا شِبْهُ الجَزِيْرَةِ الكُوْرِيَّة…)\nمثال: أريد أن أزور كوريا.",
 "ほっき": "بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية))\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى / عَزْم, عُزْم",
 "ほっきしょ": "دليل المقررات (كتالوج يسرد الدورات التي تقدمها كلية أو جامعة)\nمثال: يجب أن تحتوي نشرة الاكتتاب على الحقائق التي يحتاجها المستثمر لاتخاذ قرار مستنير",
 "ほっきにん": "العقل المدبر, مُبْتَكِر (شخص يبتكر أو ينشئ أشياء جديدة)",
 "ほっきょう": "كِيُوتُو",
 "ほっきょく": "اَلْقُطْب اَلشَّمَالِيّ\nمثال: 北極圏とは北極周辺の地域の事である。 — المنطقة القطبية هي تلك الواقعة حول القطب الشمالي. / قُطْبِيّ شَمَالِيّ",
 "ほっきょくいわな": "شار قطبي (ترويت صغير في المياه الشمالية؛ توجد مجموعات حبيسة في كيبيك وشمال نيو إنجلاند)",
 "ほっきょくおおかみ": "ذئب أبيض, ذئب قطبي (ذئب من القطب الشمالي لأمريكا الشمالية ذو فرو أبيض وذيل أسود الطرف)",
 "ほっきょくかい": "الْمُحِيط الْمُتَجَمِّد الشَّمَالِيّ, الْمُحِيط الشَّمَالِيّ",
 "ほっきょくぎつね": "ثعلب أبيض, ثعلب قطبي (ثعلب كثيف الفرو من المناطق القطبية؛ بني في الصيف وأبيض في الشتاء)",
 "ほっきょくくじら": "حوت مقوس الرأس (حوت قطبي كبير الفم)",
 "ほっきょくぐま": "دُبّ أَبْيَض, دُبَّة بَيْضَاء",
 "ほっきょくけん": "الدَّائِرَة الْقُطْبِيَّة الشَّمَالِيَّة\nمثال: 北極圏とは北極周辺の地域の事である。 — المنطقة القطبية هي تلك الواقعة حول القطب الشمالي.",
 "ほっきょくこう": "شفق قطبي ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه:…)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "ほっきょくせい": "الجُدَيّ, نَجْم الشَمَال",
 "ほっきょくせん": "الدَّائِرَة الْقُطْبِيَّة الشَّمَالِيَّة",
 "ほっきょくちほう": "قُطْبِيّ شَمَالِيّ",
 "ほっきょくてん": "اَلْقُطْب اَلشَّمَالِيّ",
 "ほっきょくのうさぎ": "أرنب قطبي (أرنب بري كبير من شمال أمريكا الشمالية؛ يكون أبيض بالكامل تقريباً في الشتاء)",
 "ほっきょくよう": "الْمُحِيط الْمُتَجَمِّد الشَّمَالِيّ, الْمُحِيط الشَّمَالِيّ",
 "ほっく": "هَايْكُو",
 "ほっこう": "شفق قطبي ((شَفِقَ) منه، وعليه يَشْفَقَ شَفَقًا: خاف وحَذِرَ، فهو شَفِقٌ؛ (شَفِقَ) عليه:…)\nمثال: أثارت تلك السلحفاة شفقة زيري.",
 "ほっこく": "الأراضي الشمالية, الشمال (أي منطقة تقع في الشمال أو باتجاهه)",
 "ほっこくじん": "شمالي (أحد سكان الشمال)",
 "ほっこり": "نَاعِم, لَيِّن (لطيف الملمس، غير خشن؛ رقيقٌ أو ملساء في الهيئة أو الصوت)\nمثال: صوتها ناعم و واضح.",
 "ほっさ": "لَاقَ (مَنْ يَلْقَى غَيْرَهُ)",
 "ほっさせい": "انتيابي, نوبي (مصحوب بـ أو ذو طبيعة نوبات مفاجئة (انتياب))",
 "ほっさてき": "تَشَنُّجِيّ, نَوْبِيّ (يَحْدُثُ عَلَى شَكْلِ نَوْبَاتٍ وَغَالِبًا بِشَكْلٍ مُفَاجِئ)",
 "ほっし": "أُقْنُوم",
 "ほっしゅ": "حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى)\nمثال: إنه الكاهن الأعظم لموسيقى الجاز المعاصرة",
 "ほっしん": "طَفْح, طَفْح جِلْدِيّ / عَزْم, عُزْم",
 "ほっしんねつ": "تيفوس الفئران, تيفوس متوطن (عدوى حادة تسببها الريكتسيا وتنتقل عن طريق لدغة برغوث مصاب؛ تتميز بالحمى…)",
 "ほっす": "حبر, رئيس كهنة (رجل دين كبير وشخصية رفيعة المستوى)\nمثال: إنه الكاهن الأعظم لموسيقى الجاز المعاصرة",
 "ほっする": "أَرَادَ, رَغِبَ (شَاءَ الشيءَ، رَغِبَ فيه؛ أَحَبَّ، شَهِيَ، اِشْتَهَى. (تخصيص))\nمثال: أراد مني الكذب.",
 "ほっそく": "بدء, مشاركة أساسية (دور للبدء (في لعبة في البداية))\nمثال: حصل على بدايته لأن أحد الرماة الأساسيين كان في المستشفى",
 "ほっそり": "نَحِيل",
 "ほったてごや": "كُوخ, تَخْشِيبَة",
 "ほったて小屋": "كُوخ, تَخْشِيبَة",
 "ほったらかし": "أَهْمَلَ",
 "ほったらかしにする": "أَهْمَلَ",
 "ほったらかす": "أَهْمَلَ",
 "ほったん": "مَنْشَأ",
 "ほっつきあるく": "تَجَوَّلَ",
 "ほっておく": "تَجَاهَلَ, طَنَّش",
 "ほっと": "بشدة, بعمق (إلى عمق كبير نفسياً أو عاطفياً)\nمثال: شعروا بالخسارة بعمق",
 "ほっとう": "مَنْشَأ / العقل المدبر, مُبْتَكِر (شخص يبتكر أو ينشئ أشياء جديدة)",
 "ほっとうにん": "العقل المدبر, مُبْتَكِر (شخص يبتكر أو ينشئ أشياء جديدة)",
 "ほっとく": "تَجَاهَلَ, طَنَّش",
 "ほっぴょうよう": "الْمُحِيط الْمُتَجَمِّد الشَّمَالِيّ, الْمُحِيط الشَّمَالِيّ",
 "ほっぺ": "خَدّ (شَقَّ أو حَفَرَ في الأرض خطاً طويلاً أو أثراً عميقاً؛ أثَّر على سطحٍ ما بترك…)\nمثال: قبلتني على الخد.",
 "ほっぺた": "خَدّ (شَقَّ أو حَفَرَ في الأرض خطاً طويلاً أو أثراً عميقاً؛ أثَّر على سطحٍ ما بترك…)\nمثال: قبلتني على الخد.",
 "ほっほう": "وَا, يَا يَاه\nمثال: آه ، هناك فراشة!",
 "ほっぽう": "شَمَال (الْجِهَةُ الْمُقَابِلَةُ لِلجَنُوب؛ رَأْسُ الْبَوْصَلَةِ الْمُقَابِلُ لِلجَنُوب)\nمثال: أعيش في شمال السويد.",
 "ほっぽうげんかいせん": "خَطُّ تَرْسِيم, خَطُّ التَّرْسِيم (كِتَابَة؛ ما يَصِل نقطتين أو أكثر)\nمثال: إرسم خط مستقيم.",
 "ほっぽうよんとう": "مُقَاطَعَة شَمَالِيَّة",
 "ほっぽうりょうど": "مُقَاطَعَة شَمَالِيَّة",
 "ほっぽうりょうどもんだい": "جُزُر اَلْكُورِيل (جَزَرَ الماءُ عن الأَرضِ يَجْزُرُ جَزْراً: نَضَبَ وحَسَرَ؛ ويقال: جَزَرَ…)\nمثال: ضع الجزر في القدر.",
 "ほっぽうわ": "اَللُّغَة اَلصِّينِيَّة اَلشَّمَالِيَّة, مَنْدَرِينِيَّة",
 "ほっぽかす": "تَرَكَ (أقوام يسكنون آسِيَا الوسطى ومنهم التَتَر والأُزْبَك والمَغْوُل والأَتْرَاك؛ قد…)\nمثال: لقد ترك لك هذا.",
 "ほっぽらかす": "أَهْمَلَ",
 "ほっぽりだす": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "ほっぽり出す": "نَار, نار (نارَتِ النارُ: أضاءَت؛ نَارَ النَّارَ مَنْ بَعِيدٍ : أَبْصَرَهَا، نَظَرَ…)\nمثال: سمعن طلقات نار.",
 "ほっぽる": "عَلَاقَة سَرِيعَة, علاقة طيارى\nمثال: صب الشاي لضيفك. / اِنْصَرَفَ, يَنْصَرِفُ (فعل مطاوعة لصَرَفَ: صَرَفْتُهُ فَاَنْصَرَف؛ ذهب إلى مكان آخر)\nمثال: انصرف من ملكيتنا!",
 "ほつがん": "صَلَّى, دَعَا",
 "ほつぎ": "طَلَب الزَّوَاج (حَاوَلَ أن يجد الشيء ويأخذه؛ رَغِبَ إِلَى الشخص شيئا، سَأَلَهُ إِيَّاه. (يتعدى…)\nمثال: طلب زيري ورودا.",
 "ほつご": "حَدِيث, خُطْبَة (جَدِيد؛ الخبر عن ما حدث)\nمثال: توقف عن الحديث.",
 "ほつす": "أَرْخَى, حَلَّ",
 "ほつねつ": "حُمَّة, حُمَّى",
 "ほつれ": "شِجَار عَلَنِيّ, عِرَاك (قتال صاخب)",
 "ほづな": "حبل الرفع (حبل لرفع أو خفض شراع أو علم)",
 "ほてい": "إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / إعادة كتابة, مراجعة (تحرير يتضمن كتابة الشيء مرة أخرى)",
 "ほていちく": "خيزران صنارة السمك (خيزران صغير من جنوب شرق الصين له سيقان رفيعة مرنة عندما تكون صغيرة)",
 "ほていばら": "مدفأة كرشية, موقد منتفخ (موقد منتفخ الشكل يتم فيه حرق الحطب أو الفحم)",
 "ほてい腹": "مدفأة كرشية, موقد منتفخ (موقد منتفخ الشكل يتم فيه حرق الحطب أو الفحم)",
 "ほてつ": "إصلاح, ترميم (فعل إعادة الشيء إلى حالة العمل) / بَدِيل اِصْطِنَاعِيّ, طَرَف اِصْطِنَاعِيّ",
 "ほてり": "أَشَعَّ ((أَشَعَّتِ) الشمسُ: نَشَرَتْ شْعاعها؛ أَشَعَّتِ النارُ: أَرسلت ضوءها وحرارتها)\nمثال: أشع الإسبرانتو! / هبة ساخنة (إحساس مفاجئ وقصير بالحرارة (يرتبط بانقطاع الطمث وبعض الاضطرابات العقلية))",
 "ほてる": "شطف (غسل أو نظف الشيء بالماء، غالبًا بمعنى التنظيف العميق؛ في بعض الاستخدامات، يمكن…)",
 "ほてん": "تطبيق, طلاء (عمل وضع شيء (على سطح))\nمثال: وصف الطبيب وضعاً موضعياً لليود",
 "ほと": "أعضاء تناسلية أنثوية (أعضاء جنسية أنثوية خارجية)",
 "ほとおりぼし": "كَوْكَبَة / قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "ほとおり星": "كَوْكَبَة / قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "ほとけ": "بُوذَا, بُدّ / مَيِّت",
 "ほとけくさい": "مَا وَرَائِيّ, مُتَعَالٍ (يوجد خارج نطاق الطبيعة أو لا يتوافق معها)",
 "ほとけごころ": "رَحْمَة, رَأْفَة",
 "ほとけさま": "بُوذَا, بُدّ / راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "ほとけさん": "بُوذَا, بُدّ / راحل, فقيد (شخص فارق الحياة ولم يعد حياً)\nمثال: أتساءل عما كان سيفعله الميت",
 "ほとけしょう": "رأفة, رحمة (التساهل والرحمة التي يظهرها تجاه المخالفين شخص أو وكالة مكلفة بإقامة العدل)",
 "ほとけになる": "مَاتَ (للحَيّ: فقد الحَيَاة. مصدره مَوتَا ومِيتَة؛ للأرض: ليس فيها شيء حَيّ من النبات…)\nمثال: إعتقدت أنه مات.",
 "ほとけのざ": "أذن القسيس, لاميون متموج (نبات أوراسي له أوراق مسننة وزهور صغيرة ثنائية الشفة بيضاء أو حمراء أرجوانية)",
 "ほととぎす": "زنبق الضفدع (خس هندي طافٍ أو زاحف ذو عناقيد طرفية من الزهور الوردية الباهتة؛ المناطق الرطبة…)",
 "ほととぎすそう": "زنبق الضفدع (خس هندي طافٍ أو زاحف ذو عناقيد طرفية من الزهور الوردية الباهتة؛ المناطق الرطبة…)",
 "ほとばしり": "بئر دافق (بئر نفط بتدفق طبيعي قوي بحيث لا يكون الضخ ضرورياً)",
 "ほとばしる": "طفرة, فورة (زيادة قوية مفاجئة)\nمثال: حفزت طفرة من المضاربة",
 "ほとほと": "إلى حد بعيد, تماماً (إلى أقصى حد؛ بالكامل)\nمثال: أنت محق تماماً",
 "ほとほりぼし": "كَوْكَبَة / قَصْر (ضد الطول؛ غير تام، غير كامل)\nمثال: لقد قصر الخطاب.",
 "ほとぼり": "جلبة, صخب (فعل إحداث اضطراب صاخب)\nمثال: كان عالقاً في دوامة من العمل",
 "ほとめく": "أَهْلًا وَسَهْلًا, مَرْحَبًا (تحية ترحيب بالضيف؛ تحية عند اللقاء أو لبدء المحادثة)\nمثال: أهلا يا أصدقاء.",
 "ほとり": "جَانِب",
 "ほとんど": "تَقْرِيبًا, عَلَى وَشْك / بالكاد, قبل قليل (قبل وقت قصير جداً فقط)\nمثال: بالكاد كنا نعرفهم / أَكْثَر, أَغْلَب\nمثال: إنها غالية جدا!",
 "ほど": "اِتِّسَاع, مَدَّى / حَدّ (مُنْتَهى الشيءِ؛ الْفَصْلُ بَيْنَ الشَّيْئَيْنِ لِئَلَّا يَخْتَلِطَ أَحدهما…)\nمثال: أعرفها إلى حد ما. / وَقْت (\"بَقِيَ وَقْتاً عِنْدَهُ \" : أَيْ مِقْدَاراً مِنَ الزَّمَنِ؛ \"جَاءَ فِي…)\nمثال: حان وقت الذهاب. / بُعْد (يدل على اللحاق في الزمان؛ يكون مضافا، وينصب أو يجر)\nمثال: و بعد قليل أتى.",
 "ほどあい": "اِعْتِدَال (الوَسَطِيَّة، يقابله التَطَرُّف؛ التَنَاسُب وأن يكون الأمر عَدْلا، يقابله…)\nمثال: الاعتدال هو اليوم الذي يتساوى به الليل و النهار بنفس المدة.",
 "ほどいも": "فستق عبيد, فول سوداني (قرن كرمة الفول السوداني يحتوي عادة على حبتين أو بذرتين)",
 "ほどう": "مَمْشًى, مَسار الْشَاة / إِرْشَاد, هِدَايَة / اعتقال, قبض (فعل القبض (خاصة القبض على مجرم))\nمثال: حصل الشرطي المناوب على التقدير للقبض على المجرم / فعل مساعد (فعل يندمج مع فعل آخر في عبارة فعلية للمساعدة في تشكيل الزمن أو الصيغة أو البناء…)",
 "ほどうきょう": "جسر مشاة (جسر مصمم لعبور المشاة)",
 "ほどく": "فَكَّ",
 "ほどこし": "مُنَظَّمَة خَيْرِيَّة",
 "ほどこしもの": "صَدَقَة, خَيْر",
 "ほどこす": "أَعْطَى, وَهَبَ (مَنَحَ، نَوَّلَ)\nمثال: أعطى بلده حياته. / فَعَلَ, عَمِلَ (عَمِلَ وصَنَعَ، بعلم أو بدون علم، عن قصد أو دون قصد)\nمثال: ماذا فعل للحمي؟ / وَضَعَ (جَعَلَ الشيء في مكان ما، أَثْبَتَه فيه)\nمثال: لقد أزمت الوضع. / خِنْزِيرَة\nمثال: يريد الإنفصاليون زرع رايتهم بمواقع الأنترنت.",
 "ほどちかい": "قَرِيب\nمثال: جلست بالقرب منها.",
